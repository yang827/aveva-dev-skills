-- Last Modified:
-- Description:
-- Presenter style object for the pipeSlopeForm
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applySlopes()                    -                   Applies the pre-calculated slope to the whole pipe
--  back()                           -                   Restores the last saved state
--  canApply()                       BOOLEAN             Tests whether an apply operation can be performed
--  canGoBack()                      BOOLEAN             Tests whether an back operation can be performed
--  canSlopeCurrentBranchLeg()       BOOLEAN             Tests whether the slope for the current branch leg can be modified
--  checkPipeIsWriteable()           STRING              Checks whether the current pipe is writeable
--  convertSlopeToAngle(STRING,STRING) REAL                Converts a slope into an angle
--  findBranchLegIndex(DBREF)        REAL                Given a database reference, finds the branch leg index
--  getAnchorNumber()                REAL                Returns the active anchor number
--  getAngle()                       REAL                Returns the slope angle
--  getBranchLeg(REAL)               PIPESLOPEBRANCHLEG  Returns a particular branch leg
--  getBranchLegCount()              REAL                Returns the number of branch legs in the pipe
--  getBranchLegs()                  ARRAY               Returns all the branch legs in all branches of the pipe
--  getBranches()                    ARRAY               Returns all the PIPESLOPEBRANCHES for the pipe
--  getComponentName(DBREF)          STRING              Returns a suitable name for a component
--  getCurrentAnchorPoint()          PIPESLOPEANCHORPOINT Returns the current anchor point
--  getCurrentBranchLeg()            PIPESLOPEBRANCHLEG  Returns the current branch leg
--  getCurrentBranchLegAngle()       REAL                Returns the angle for the current branch leg
--  getCurrentBranchLegSlope()       STRING              Returns the slope for the current branch leg
--  getCurrentLegAnchorComponents(ARRAY,ARRAY) -                   Returns the names and indices of the components in the current branch leg
--  getCurrentLegIndex()             REAL                Get index to the current leg
--  getCurrentPipe()                 DBREF               Get the current pipe
--  getCurrentPipeName()             STRING              Get the name of the current pipe
--  getElementName(DBREF)            STRING              Returns the name of an element or an empty string if the
--  getForwardsMode()                BOOLEAN             Returns the calculation direction
--  getSlope()                       REAL                Returns the current nominal slope
--  getSlope(REAL)                   REAL                Converts an angle into a slope
--  getSlopeAsString()               STRING              Converts the current slope into a string
--  getSlopeAsString(REAL)           STRING              Converts an angle into a slope in the form of a string
--  isAngleHorizontal(REAL)          BOOLEAN             Evaluates whether the specified angle is nominally horizontal
--  isSlopeHorizontal()              BOOLEAN             Evaluates whether the slope is nominally horizontal
--  pipeSlopePresenter()             -                   Constructor
--  quit()                           -                   Used to tidy up when the owning form is closed or hidden
--  saveState()                      -                   Save the current state
--  setAnchorNumber(REAL)            -                   Sets the active anchor number
--  setAngle(REAL,BOOLEAN)           STRING              Converts the current slope into a string
--  setCurrentBranchLegAnchorComponent(REAL) -                   Sets the component being anchored
--  setCurrentBranchLegAnchorDistance(REAL) -                   Sets the anchor distance along the current branch leg
--  setCurrentBranchLegAnchorFromElement(DBREF) -                   Sets the element to anchor relative to
--  setCurrentBranchLegAnchorFromMethod(STRING) -                   Sets the 'from' anchor method
--  setCurrentBranchLegAnchorOffset(REAL) -                   Sets the anchor offset
--  setCurrentBranchLegAnchorPoint(STRING) -                   Sets the anchor point
--  setCurrentBranchLegAnchorType(STRING) -                   Sets one of the anchor types for the current branch leg
--  setCurrentBranchLegAngle(REAL,BOOLEAN) -                   Sets the angle for the current branch leg
--  setCurrentBranchLegSlope(STRING,BOOLEAN) STRING              Sets the slope for the current branch leg
--  setCurrentLegFixedHorizontal(BOOLEAN) -                   Forces the current leg to be horizontal or sloped
--  setCurrentLegIndex(REAL)         REAL                Set the current leg index
--  setCurrentPipe(DBREF)            STRING              Sets the current pipe (if possible)
--  setForwardsMode(BOOLEAN)         -                   Sets the calculation mode
--  setSlope(STRING,BOOLEAN)         STRING              Sets the slope
--  updateBranches()                 -                   After one branch leg is modified, updates all the connected legs and branches
--
------------------------------------------------------------------------

define object PIPESLOPEPRESENTER

  member .anchorNumber is REAL
  member .angle is REAL
  member .currentLegIndex is REAL
  member .currentBranchLeg is PIPESLOPEBRANCHLEG
  member .forwards is BOOLEAN
  member .pipe is DBREF
  member .pipeSlope is PIPESLOPE
  member .savedStates is ARRAY
  member .canApply is BOOLEAN
  member .minAllowedSlope is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:   pipeSlopePresenter
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pipeSlopePresenter()

  !this.angle = atan(1 / 50)
  !this.currentLegIndex = 1
  !this.forwards = true
  !this.anchorNumber = 1
  !this.canApply = false
  !this.minAllowedSlope = 1

endmethod
-- End of method .pipeSlopePresenter

------------------------------------------------------------------------
--
-- Method:   getAngle
--
-- Description: Returns the slope angle
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Angle
--
------------------------------------------------------------------------
define method .getAngle() is REAL

  return !this.angle

endmethod
-- End of method .getAngle

------------------------------------------------------------------------
--
-- Method:   getSlope()
--
-- Description: Returns the current nominal slope
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Slope
--
------------------------------------------------------------------------
define method .getSlope() is REAL

  return !this.getSlope(!this.angle)

endmethod
-- End of method .getSlope

------------------------------------------------------------------------
--
-- Method:   getForwardsMode()
--
-- Description: Returns the calculation direction
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True for forwards, false for backwards
--
------------------------------------------------------------------------
define method .getForwardsMode() is BOOLEAN

  return !this.forwards

endmethod
-- End of method .getForwardsMode

------------------------------------------------------------------------
--
-- Method:   getSlope()
--
-- Description: Converts an angle into a slope
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Angle
-- Return:
-- [Data Type] [Description]
--  REAL        Slope
--
------------------------------------------------------------------------
define method .getSlope(!angle is REAL) is REAL

  !slope = REAL()
  if (!this.isAngleHorizontal(!angle).not()) then
      !slope = 1 / tan(!angle)
  endif

  return !slope
endmethod
-- End of method .getSlope

------------------------------------------------------------------------
--
-- Method:   isSlopeHorizontal()
--
-- Description: Evaluates whether the slope is nominally horizontal
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if horizontal
--
------------------------------------------------------------------------
define method .isSlopeHorizontal() is BOOLEAN

  return !this.isAngleHorizontal(!this.angle)

endmethod
-- End of method .isSlopeHorizontal

------------------------------------------------------------------------
--
-- Method:   isAngleHorizontal(!angle is REAl)
--
-- Description: Evaluates whether the specified angle is nominally horizontal
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Angle
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if horizontal
--
------------------------------------------------------------------------
define method .isAngleHorizontal(!angle is REAL) is BOOLEAN

  if (!angle.abs() le !!pipeSlopeUtilities.angleTolerance) then
    return true
  else
    return false
  endif
endmethod
-- End of method .isAngleHorizontal

------------------------------------------------------------------------
--
-- Method:   getSlopeAsString()
--
-- Description: Converts the current slope into a string
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING     The current slope as a string
--
------------------------------------------------------------------------
define method .getSlopeAsString() is STRING
  return !this.getSlopeAsString(!this.angle)
endmethod
-- End of method .getSlopeAsString

------------------------------------------------------------------------
--
-- Method:   getSlopeAsString()
--
-- Description: Converts an angle into a slope in the form of a string
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING     The current slope as a string
--
------------------------------------------------------------------------
define method .getSlopeAsString(!angle is REAL) is STRING

  if (!this.isAngleHorizontal(!angle)) then
    return 'Horizontal'
  else
    return !this.getSlope(!angle).abs().string(!!realFmt)
  endif

endmethod
-- End of method .getSlopeAsString(REAL)

------------------------------------------------------------------------
--
-- Method:   getCurrentBranchLegSlope()
--
-- Description: Returns the slope for the current branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  STRING                Slope
--
------------------------------------------------------------------------
define method .getCurrentBranchLegSlope() is STRING
  return !this.getSlopeAsString(!this.getCurrentBranchLegAngle())
endmethod
-- End of method .getCurrentBranchLegSlope

------------------------------------------------------------------------
--
-- Method:   getCurrentBranchLegAngle
--
-- Description: Returns the angle for the current branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  REAL                   Angle
--
------------------------------------------------------------------------
define method .getCurrentBranchLegAngle() is REAL
    return !this.getCurrentBranchLeg().getAdjustedAngle()
endmethod
-- End of method .getCurrentBranchLegAngle

------------------------------------------------------------------------
--
-- Method:   setAngle()
--
-- Description: Converts the current slope into a string
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING     The current slope as a string
--
------------------------------------------------------------------------
define method .setAngle(!angle is REAL, !slopeUp is BOOLEAN) is STRING

  !errorMessage = ''
  if (!angle.abs() gt atan(1.0 / !this.minAllowedSlope)) then
    !errorMessage = 'Slope must be greater than ' + !this.minAllowedSlope.string()
  elseif (!this.isAngleHorizontal(!angle)) then
    !this.angle = 0
  elseif (!slopeUp) then
    !this.angle = -!angle.abs()
  else
    !this.angle = !angle.abs()
  endif

  return !errorMessage
endmethod
-- End of method .setAngle

------------------------------------------------------------------------
--
-- Method:   setSlope()
--
-- Description: Sets the slope
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Slope
--  2   R      BOOLEAN     Direction of slope, true denotes up
-- Return:
-- [Data Type] [Description]
--  REAL        Slope as a string
--
------------------------------------------------------------------------
define method .setSlope(!slope is STRING, !slopeUp is BOOLEAN) is STRING

  !errorMessage = ''
  !angle = !this.convertSlopeToAngle(!slope, !errorMessage)

  if (!errorMessage.empty()) then
    !errorMessage = !this.setAngle(!angle, !slopeUp)
  endif

  return !errorMessage

endmethod
-- End of method .setSlope

------------------------------------------------------------------------
--
-- Method:   convertSlopeToAngle()
--
-- Description: Converts a slope into an angle
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Slope as a string
--  2   RW     STRING      Error message
-- Return:
-- [Data Type] [Description]
--  REAL        Angle
--
------------------------------------------------------------------------
define method .convertSlopeToAngle(!slope is STRING, !errorMessage is STRING) is REAL

  -- As a special case, check whether the slope matches the string |H/ORIZONTAL|
  -- and if it does set the angle to zero
  !horiz = 'HORIZONTAL'
  !horiz = !horiz.substring(1, !slope.length())
  if (!slope.upCase().match(!horiz) ne 0) then
    return 0.0
  endif

  -- Check slope is valid
  !value = !slope.real()
  handle (2, 441) $* Cannot convert string to number
    !errorMessage = |Slope '| + !slope + |' cannot be converted to a number|
    return 0.0
  endhandle

  -- Check that the slope is a number without units
  if (!value.dimension().string() ne 'NONE') then
    !errorMessage = |The slope must be a real number with no units|
    return 0.0
  endif

  !angle = atan (1.0 / !value)
  handle (2, 430) $* Division by zero
    !errorMessage = 'Slope value must be greater than ' + !this.minAllowedSlope.string()
    return 0.0
  endhandle

  return !angle

endmethod
-- End of method .convertSlopeToAngle

------------------------------------------------------------------------
--
-- Method:   setForwardsMode()
--
-- Description: Sets the calculation mode
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      Mode        Calculation direction, true for forwards
-- Return:
-- [Data Type] [Description]
--  STRING     The current slope as a string
--
------------------------------------------------------------------------
define method .setForwardsMode(!forwards is BOOLEAN)
  !this.forwards = !forwards
  !this.pipeSlope.setForwardsMode(!forwards)
endmethod
-- End of method .setForwardsMode

------------------------------------------------------------------------
--
-- Method:   setCurrentPipe()
--
-- Description: Sets the current pipe (if possible)
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DBREF       Member of the pipe to be modified
-- Return:
-- [Data Type] [Description]
--  STRING      Error message
---
------------------------------------------------------------------------
define method .setCurrentPipe(!element is DBREF) is STRING

  if (undefined(!!pipeSlopeUtilities)) then
     !!pipeSlopeUtilities = object PIPESLOPEUTILITIES()
   endif

  if (!element.badref()) then
    !value = object STRING()
    return !value
  endif

  !findPipe = object EXPRESSION('PIPE')
  !pipe = !findPipe.evaluate(!element)
  if (!pipe.unset()) then
    return 'The selected element is not a valid pipe, branch or piping component'
  endif

  if (!!collectAllFor('PIPCA', '', !element).size() gt 0 ) then
    return 'The slope pipe form slope cannot used for pipes that contain PIPCA elements.'
  endif

  -- Clear global message list
  if (undefined(!!pipeSlopeMessages)) then
    !!pipeSlopeMessages = object PIPESLOPEMESSAGES()
  else
    !!pipeSlopeMessages.clear()
  endif
  !!pipeSlopeMessages.addMessage('Pipe slope calculated')

  !this.currentLegIndex = 0

  !this.pipeSlope = object PIPESLOPE(!pipe, !this.angle, !this.forwards, !pipe ne !this.pipe)
  !this.pipe = !pipe
  !this.savedStates.clear()

  -- Check pipe can be written
  return !this.checkPipeIsWriteable()

endmethod
-- End of method .setCurrentPipe

------------------------------------------------------------------------
--
-- Method:   checkPipeIsWriteable()
--
-- Description: Checks whether the current pipe is writeable
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING      Error message
--
--
------------------------------------------------------------------------
define method .checkPipeIsWriteable() is STRING

  -- Check for database write access
  !this.canApply = false
  if (!this.pipe.dbwrite eq false) then
    return 'The pipe cannot be modified - the database is read only'
  endif

  -- Check for locked members
  !lockedMembers = !!collectAllFor('', 'LOCK EQ TRUE AND TYPE NE |PIPE|', !this.pipe)
  if (!lockedMembers.size() gt 0) then
    return |The pipe's slope cannot be modified as one or more branch members are locked|
  endif

  -- Check for user claim on all branches
  !branchRefs = !this.pipeSlope.getBranchRefs()
   do !branch values !branchRefs
    if (!branch.okClaim.not() and !branch.lclm.not()) then
      return 'The pipe slope cannot be modified as one or more branches are claimed'
    endif
  enddo

  !this.canApply = true

  return STRING()

endmethod
-- End of method .checkPipeIsWriteable

------------------------------------------------------------------------
--
-- Method:   getCurrentPipe()
--
-- Description: Get the current pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  DBREF       The current pipe
--
------------------------------------------------------------------------
define method .getCurrentPipe() is DBREF
  return !this.pipe
endmethod
-- End method .getCurrentPipe

------------------------------------------------------------------------
--
-- Method:   getCurrentPipeName()
--
-- Description: Get the name of the current pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  STRING      Name of the current  pipe
------------------------------------------------------------------------
define method .getCurrentPipeName() is STRING
  return !this.pipe.name
endmethod
-- End method .getCurrentPipeName

------------------------------------------------------------------------
--
-- Method:   setCurrentLegIndex()
--
-- Description: Set the current leg index
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Index to current leg
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentLegIndex(!currentLegIndex is REAL) is REAL

  !this.currentLegIndex = !currentLegIndex
  !this.currentBranchLeg = !this.pipeSlope.getBranchLeg(!currentLegIndex)

  return !this.currentLegIndex

endmethod
-- End of method .setCurrentLegIndex

------------------------------------------------------------------------
--
-- Method:   getCurrentLegIndex()
--
-- Description: Get index to the current leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  REAL        Index to current leg
--
------------------------------------------------------------------------
define method .getCurrentLegIndex() is REAL
  if (!this.currentLegIndex le !this.pipeSlope.getNumberOfBranchLegs()) then
    return !this.currentLegIndex
  else
    return 1
  endif
endmethod
-- End of method .getCurrentLegIndex

------------------------------------------------------------------------
--
-- Method:   getBranches
--
-- Description: Returns all the PIPESLOPEBRANCHES for the pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--  ARRAY       Array of PIPESLOPEBRANCHES
--
------------------------------------------------------------------------
define method .getBranches() is ARRAY

  return !this.pipeSlope.getBranches()

endmethod
-- End of method .getBranches

------------------------------------------------------------------------
--
-- Method:   getBranchLeg
--
-- Description: Returns a particular branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   R      REAL        Index to branch leg
-- Return:
-- [Data Type]            [Description]
--  PIPESLOPEBRANCHLEG     Branch leg
--
------------------------------------------------------------------------
define method .getBranchLeg(!branchLegIndex is REAL) is PIPESLOPEBRANCHLEG

  return !this.pipeSlope.branchLegs[!branchLegIndex]

endmethod
-- End of method .getBranchLeg

------------------------------------------------------------------------
--
-- Method:   getCurrentBranchLeg
--
-- Description: Returns the current branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type]            [Description]
--  PIPESLOPEBRANCHLEG     Branch leg
--
------------------------------------------------------------------------
define method .getCurrentBranchLeg() is PIPESLOPEBRANCHLEG

  return !this.currentBranchLeg

endmethod
-- End of method .getCurrentBranchLeg

------------------------------------------------------------------------
--
-- Method:      getBranchLegs
--
-- Description: Returns all the branch legs in all branches of the pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
-- ARRAY       Array of all branch legs
------------------------------------------------------------------------
define method .getBranchLegs() is ARRAY

  !branchLegs = !this.pipeSlope.getBranchLegs()
  if (!this.currentLegIndex gt 0 and !this.currentLegIndex le !branchLegs.size()) then
    !branchLegs[!this.currentLegIndex] = !this.currentBranchLeg
  endif
  return !branchLegs

endmethod
-- End of method .getBranchLegs

------------------------------------------------------------------------
--
-- Method:      getBranchLegCount
--
-- Description: Returns the number of branch legs in the pipe
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
-- ARRAY       Array of all branch legs
------------------------------------------------------------------------
define method .getBranchLegCount() is REAL

  return !this.pipeSlope.branchLegs.size()

endmethod
-- End of method .getBranchLegCount

------------------------------------------------------------------------
--
-- Method:      applySlopes
--
-- Description: Applies the pre-calculated slope to the whole pipe
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .applySlopes()

  if (defined(!this.pipeSlope)) then
    !!pipeSlopeMessages.clear()
    !!pipeSlopeMessages.addMessage('Pipe slope applied')
    !this.pipeSlope.applySlopes()
    !this.savedStates.clear()
  else
    !!alert.error('No slopes defined')
  endif

endmethod
-- End of method .applySlopes

------------------------------------------------------------------------
--
-- Method:      getComponentName
--
-- Description: Returns a suitable name for a component
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]           [Description]
--  1   R      PIPESLOPECOMPONENT    Component
-- Return:
-- [Data Type] [Description]
-- STRING       Name
------------------------------------------------------------------------
define method .getComponentName(!component is DBREF) is STRING

  !name = !component.name
  if (!name.substring(1,1) eq '=') then
    !name = !component.attribute('TYPE') + ' ' + !component.attribute('TYSEQ').string()
  endif

  return !name
endmethod
-- End of method .getComponentName

------------------------------------------------------------------------
--
-- Method:      .getElementName
--
-- Description: Returns the name of an element or an empty string if the
--              element is not valid
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]           [Description]
-- Return:
-- [Data Type] [Description]
--  STRING       Name
------------------------------------------------------------------------

define method .getElementName(!element is DBREF) is STRING

  !name = !element.name
  handle any
    !name = !element.string()
  endhandle
  return !name

endmethod
-- End of method .getElementName

------------------------------------------------------------------------
--
-- Method:      .getCurrentLegAnchorComponents
--
-- Description: Returns the names and indices of the components in the current branch leg
--              which are suitable for anchoring
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type] [Description]
--  1   RW     ARRAY       Returns the array of component names
--  2   RW     ARRAY       Returns the array of indices (as strings)
-- Return:
-- [Data Type]            [Description]
--
------------------------------------------------------------------------

define method .getCurrentLegAnchorComponents(!names is ARRAY, !componentIndices is ARRAY)

  !anchorInfo = object PIPESLOPEANCHORINFO()

  !names = ARRAY()
  !index = 1
  do !component values !this.currentBranchLeg.getComponents()
    if (!anchorInfo.canAnchor(!component.dbRef())) then
      !names.append(!this.getComponentName(!component.dbRef()))
      !componentIndices.append(!index.string())
    endif
    !index = !index + 1
  enddo

  if (!this.anchorNumber eq 1) then

    -- Stop the first anchor point being the last component
    !names.removeLast()
    !componentIndices.removeLast()
  else
    -- Stop the second anchor point being the first component
    !names.removeFirst()
    !componentIndices.removeFirst()
  endif
endmethod
-- End of method .getCurrentLegAnchorComponents

------------------------------------------------------------------------
--
-- Method:      .getCurrentAnchorPoint
--
-- Description: Returns the current anchor point
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]           [Description]
-- Return:
-- [Data Type]           [Description]
--  PIPESLOPEANCHORPOINT  Anchor point
------------------------------------------------------------------------

define method .getCurrentAnchorPoint() is PIPESLOPEANCHORPOINT

  return !this.currentBranchLeg.getAnchorPoint(!this.anchorNumber)

endmethod
-- End of method .getCurrentAnchorPoint

------------------------------------------------------------------------
--
-- Method:      .setCurrentLegFixedHorizontal
--
-- Description: Forces the current leg to be horizontal or sloped
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type]           [Description]
--  1   R      BOOLEAN               True for horizontal
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentLegFixedHorizontal(!fixedHorizontal is BOOLEAN)

  !this.pipeSlope.setBranchLegFixedHorizontal(!this.currentBranchLeg, !fixedHorizontal)

endmethod
-- End of method .setCurrentLegFixedHorizontal

------------------------------------------------------------------------
--
-- Method:      .setCurrentBranchLegAnchorType
--
-- Description: Sets one of the anchor types for the current branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]           [Description]
--  1   R      STRING                Anchor type
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentBranchLegAnchorType(!anchorType is STRING)

  !this.pipeSlope.setBranchLegAnchorType(!this.currentBranchLeg, !this.currentLegIndex, !this.anchorNumber , !anchorType)

endmethod
-- End of method setCurrentBranchLegAnchorType

------------------------------------------------------------------------
--
-- Method:      .updateBranches
--
-- Description: After one branch leg is modified, updates all the connected legs and branches
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .updateBranches()

  !this.saveState()
  !this.pipeSlope.updateBranches(!this.currentBranchLeg, !this.currentLegIndex)
  !!pipeSlopeMessages.addMessage('Checking pipe after modifying leg ' + !this.currentLegIndex.string())
  !this.pipeSlope.checkPipe()

endmethod
-- End of method .updateBranches

------------------------------------------------------------------------
--
-- Method:   setCurrentBranchLegAngle
--
-- Description: Sets the angle for the current branch leg
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type]           [Description]
--  1   R      REAL                  Angle
--  2   R      BOOLEAN               True if sloping upwards
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentBranchLegAngle(!angle is REAL, !slopeUp is BOOLEAN)

  if (!this.isAngleHorizontal(!angle)) then
    !branchLegAngle = 0
  elseif (!slopeUp) then
    !branchLegAngle = -!angle.abs()
  else
    !branchLegAngle = !angle.abs()
  endif

  !this.pipeSlope.setBranchLegAngle(!this.currentBranchLeg, !branchLegAngle)

endmethod
-- End of method .setCurrentBranchLegAngle

------------------------------------------------------------------------
--
-- Method:   setCurrentBranchLegSlope
--
-- Description: Sets the slope for the current branch leg
--
-- Method Type: Procedure
-- Arguments:
-- [#] [R/RW] [Data Type]           [Description]
--  1   R      REAL                  Slope
--  2   R      BOOLEAN               True if sloping upwards
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrentBranchLegSlope(!slope is STRING, !slopeUp is BOOLEAN) is STRING

  !errorMessage = ''
  !angle = !this.convertSlopeToAngle(!slope, !errorMessage)
  if (!errorMessage.empty()) then
    !this.setCurrentBranchLegAngle(!angle, !slopeUp)
  endif

  return !errorMessage

endmethod
-- End of method .setCurrentBranchLegSlope

------------------------------------------------------------------------
