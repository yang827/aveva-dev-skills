-- Last Modified:
-- Description:
-- Utility object implementing miscellaneous functionality and storing
-- some useful values. Intended for use as a global object so members
-- can be accessed directly.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angleToHorizontal(POSITION,POSITION) REAL                Given two positions, find the angle the resultant vector makes with
--  isDirectionVertical(DIRECTION)   BOOLEAN             Finds whether a direction is vertical
--  pipeSlopeUtilities()             -                   Constructor
--  roundDistanceToZero(REAL)        -                   If a distance value is less than the distance tolerance,
--
------------------------------------------------------------------------

define object PIPESLOPEUTILITIES

  -- Members should be considered as read only properties - to be read but not modified
  -- from outside the object
  member .distanceTolerance is REAL
  member .angleTolerance is REAL
  member .verticalTolerance is REAL

endobject

------------------------------------------------------------------------
--
-- Method:   pipeSlopeUtilities
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pipeSlopeUtilities()

  var !tolerance tol angle
  !this.angleTolerance = !tolerance.real()

  var !tolerance tol offset
  !this.distanceTolerance = !tolerance.real() * tan (!this.angleTolerance)

  !this.verticalTolerance = sine(60.0deg)

endmethod
-- End of method .pipeSlopeUtilities

------------------------------------------------------------------------
--
-- Method:      .isDirectionVertical
--
-- Description: Finds whether a direction is vertical
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      DIRECTION   Direction
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the direction is vertical
--
------------------------------------------------------------------------
define method .isDirectionVertical(!direction is DIRECTION) is BOOLEAN

  !up = object DIRECTION('UP WRT /*')
  !angleToVertical = !direction.angle(!up)

  if (!angleToVertical.sine().abs() lt !this.verticalTolerance) then
    return true
  else
    return false
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .roundDistanceToZero
--
-- Description: If a distance value is less than the distance tolerance,
--              set it to zero.
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   RW     REAL        Value Direction
--
-- Return:
-- [Data Type] [Description]
--  BOOLEAN     True if the direction is vertical
--
------------------------------------------------------------------------
define method .roundDistanceToZero(!value is REAL)
  if (!value.abs() lt !this.distanceTolerance) then
    !value = 0
  endif
endmethod

-- End of method .roundDistanceToZero

------------------------------------------------------------------------
--
-- Method:      .angleToHorizontal
--
-- Description: Given two positions, find the angle the resultant vector makes with
--              the horizontal
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   RW     Position    Start position
--  2   RW     Position    End position
--
-- Return:
-- [Data Type] [Description]
--  REAL        Angle, positive if below zero
--
------------------------------------------------------------------------
define method .angleToHorizontal(!start is POSITION, !end is POSITION) is REAL

  !down = object DIRECTION('D')
  !dir = !start.direction(!end)
  !angle = 90deg - !dir.angle(!down)

  return !angle

endmethod
-- End of method .angleToHorizontal
