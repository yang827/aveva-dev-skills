define object PIPEASSEMBLY


  member .name                  is STRING
  member .varid                 is STRING
  member .assemblyItems         is ARRAY
  member .designItems           is ARRAY
  member .primaryOrigin         is DBREF
  member .primaryPoint          is REAL
  member .secondaryOrigin       is DBREF
  member .secondaryPoint        is REAL
  member .extraItems            is ARRAY
  member .appdataWorld          is DBREF
  member .appdataArea           is DBREF
  member .applData              is DBREF
  member .dataSet               is DBREF
  member .zone                  is DBREF
  member .pipe                  is DBREF
  member .componentGroup        is ARRAY
  member .groupArrive           is POINTVECTOR
  member .groupLeave            is POINTVECTOR
  member .groupParallel         is BOOLEAN
  member .groupConcentric       is BOOLEAN
  member .description           is STRING
  -- Tolerances (private members)
  member .distanceTolerance     is REAL
  member .angleTolerance        is REAL
  member .selection             is SELECTION
  member .form                  is STRING
  member .func                  is STRING
  member .type                  is STRING
  member .tees                  is ARRAY
  member .key                   is BOOLEAN
  member .keyElement            is DBREF
  member .backwardsList         is ARRAY
  member .forwardsList          is ARRAY
  member .builtItems            is ARRAY
  member .insertElement         is DBREF
  member .mainBranch            is DBREF
  member .commandString         is ARRAY
  member .branches              is ARRAY
  member .insertPosition        is POSITION
  member .originOffset          is REAL
  member .assemblyLength        is REAL
  member .components            is ARRAY
  member .undo                  is UNDOABLE
  member .originOffset2         is REAL
  member .secondaryOffset       is REAL
  member .undoSwitch            is BOOLEAN
  member .savedComponent        is DBREF
  member .savedOriginal         is DBREF
  member .assemblyComponent     is PIPEASSEMBLYCOMPONENT
  member .modDate               is DATETIME
  member .moved                 is BOOLEAN
  member .buildMode             is BOOLEAN
  member .branchCount           is REAL
  member .connected             is BOOLEAN
  member .movedDistance         is REAL
  member .newPrimary            is DBREF
  member .newSecondary          is DBREF
  member .readOnly              is BOOLEAN
  member .locked                is BOOLEAN

endobject
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Basic constructor for a pipeassembly must be at an APPLDA element
define method .pipeassembly(!current is DBREF)

  !!save = !!ce
  !!ce = !current
  !this.locked = FALSE
  !this.readOnly = FALSE
  if !!ce.dbwrite.not() then
    !this.readOnly = TRUE
  endif
  if !!ce.lock then
    !this.locked = TRUE
  endif
  if !current.type.neq('APPLDA') then
     !!alert.error('Item is not an assembly')
     return
  else
     !this.branchCount = !this.countbranches()
  endif

  if !this.buildMode.unset() then
    !this.buildMode = TRUE
  endif
  !this.build()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .countbranches()is REAL

  var !bran coll all bran for ce
  if !bran.unset() then
    return 0
  else
    return !bran.size()
  endif

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- continuation method from the constructor to allow rebuilds if the assembly
-- has been modified during the design session.
define method .build()

  -- get the modified time so that we get the latest version
  !this.modDate = object DATETIME(!!ce.lastmod.hier)

  !this.key = FALSE
  !this.applData = !!ce
  !this.appdataArea = !!ce.owner
  !this.settolerances()
  !this.undoSwitch = TRUE

  -- get all of the items in the assembly
  !this.getitems()

  do !a values !this.designItems
    if !a.type.eq('DDSE') then
      if !this.dataSet.unset() then
        !this.dataSet = !a
      endif
    elseif !a.type.eq('ZONE') then
      if !this.zone.unset() then
        !this.zone = !a
      endif
    elseif !a.type.eq('PIPE') then
      if !this.pipe.unset() then
        !this.pipe = !a
      endif
    endif
  enddo

  !this.description = !this.applData.description
  if !this.dataSet.set() then
    !this.getdatavalues()
  endif


  -- now we need to make a list of elements in sequence if we are using a key
  if !this.key then
     !this.getbuildlist()
  elseif !this.buildMode.not() then
     -- build backwards
     !this.components  = !this.getActiveComps(!this.designItems)
     !this.backwardsList  = !this.components.invert()
  endif

   !!ce = !this.applData

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to check if the assembly has been modified
define method .update()

   !!ce = !this.applData

   !currentModDate = object DATETIME(!!ce.lastmod.hier)
   if !currentModDate.gt(!this.modDate) then
      !this.build()
   endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to sort out the build order if a key element is involved.
define method .getbuildlist()

 !this.components  = !this.getActiveComps(!this.designItems)
 !tempComp1 = !this.components
 !mid = !this.components.findFirst(!this.keyElement)
 if undefined(!mid) then
    !!alert.error('cannot find key element')
    return
 endif
 if !mid.eq(1) then
   !backList = ARRAY()
 else
    !backList   = !this.components.removeto(!mid - 1)
    !backList.invert()
 endif
 if !mid.eq(!tempComp1.size()) then
   !forwList = ARRAY()
 else
   !forwList   = !this.components.removeFrom(2)
 endif

 !this.backwardsList  = !backList
 !this.forwardsList   = !forwList

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getdatavalues()

  !save = !!ce
  -- go to dataset to be able to evaluate parameters
  !!ce = !this.dataSet
  -- get the list of properties because the property search does not work without showing the error
  !prls = !!ce.depl

  var !coll coll all ddat for CE
  if !coll.size().eq(0) then
     return
  else
    do !a values !coll
       !item = !a.dbref()
       !!ce = !item
       if !item.dkey.eq('FUNC') then
          vvalue1
          handle any
             !func = 'Not Set'
          elsehandle NONE
             !text = !!ce.validvalue
             !func = !text.replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
             !this.type = 'FUNC'
             !this.func = '!!' & !func & '()'
          endhandle
       endif
       if !item.dkey.eq('FORM') then
          vvalue1
          handle any
             !form = 'Not Set'
          elsehandle NONE
             !text = !!ce.validvalue
             !form = !text.replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
             !this.type = 'FORM'
             !this.form = '!!' & !form
          endhandle
       endif
       if !item.dkey.eq('ORIP') then
          !orig = !this.dataSet.lfdp.orip
          handle any
            !this.primaryOrigin = object DBREF()
            !this.primaryPoint  = object REAL()
          elsehandle NONE
            !this.primaryOrigin = !orig
            !this.primaryPoint  = !item.number
          endhandle
       endif
       if !item.dkey.eq('ORIS') then
          !orig = !this.dataSet.lfdp.oris
          handle any
            !this.secondaryOrigin = object DBREF()
            !this.secondaryPoint  = object REAL()
          elsehandle NONE
            !this.secondaryOrigin = !orig
            !this.secondaryPoint  = !item.number
          endhandle
       endif
     enddo
     --CW fix 78886 assemblies with only a primary origin
       if !this.secondaryOrigin.unset() then
        !this.secondaryOrigin = !this.primaryOrigin
        !this.secondaryPoint  = !this.primaryPoint
       endif
      --CW End of fix 78886
   endif

  if !prls.findFirst('KEY').set() then
     -- we have a key element which needs to be replaced
     !key = !this.dataSet.lfdp.key
     handle any
       !key = object DBREF()
       !this.key = FALSE
     elsehandle NONE
         !this.key = TRUE
         !this.keyElement = !key
         if !this.keyElement.unset() then
            !this.key = FALSE
         endif
     endhandle
  endif

  if !this.type.unset() then
    !this.type = 'copy'
  endif

  !!ce = !save

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- method to collect all of the assembly pipe members
define method .getitems()

   var !all coll all for $!this.applData
   !this.components = ARRAY()
   do !a values !all
     !this.components.append(!a.dbref())
   enddo
   !this.designItems = !this.components

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to build a new assembly from a piping selection
define method .buildfromselection(!pipe is DBREF, !components is ARRAY, !branch is DBREF, !branches is ARRAY, !owners is ARRAY)


   !!ce = !pipe
   !this.designItems = !components
   --  get branches and design order
   --  !branch is the owner of the main components
   --  loop through and get the branches
   !ownerSeq = !owners
   -- modify the owner array so that the main branch is first
   !ownerSeq.insert(1,!ownerSeq.remove(!ownerSeq.findFirst(!branch)))
   do !bran index !ownerSeq
     !comps[!bran] = ARRAY()
     do !a values !this.designItems
       skip if(!a.type eq 'TUBI' or !a.type eq 'BRAN')
       if !a.owner.eq(!ownerSeq[!bran]) then $* its the current branch
          !comps[!bran].append(!a)
       endif
     enddo
     !comps[!bran] = !this.setorder(!comps[!bran])
   enddo


  -- at this point, we have the components of the separate branches and another array of actual branches
  -- we now need to insert something at the start of each array to indicate the branch status
  -- this can be:
  -- complete (head and tail and all components)
  -- nothing  (no head and tail)
  -- head
  -- tail

  do !a index !comps
     !comps[!a] = !this.setbranchstatus(!comps[!a], !branches)
  enddo

  -- now we need to concatenate the arrays and process them
  !final = ARRAY()
  do !a values !comps
     !final.append(!a)
  enddo

  !this.designItems = !final

  -- we need to look at what happened in the error situation

  -- !this.display()
  !this.copyDesignItems()
  -- need to fix up the heads and tails to suit

  -- now go and resolve any connection references
  !this.resolverefs()

  !this.moveorigin()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to reorder the list of components as the graphical selection
-- has them in database order rather than sequence
define method .setorder(!comps is ARRAY) is ARRAY

!order = ARRAY()
do !a values !comps
  !order.append(!a.order)
enddo

!index = !order.sortedindices()
!return = !comps.reindex(!index)

return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to set the copying status of components in the list
define method .setbranchstatus(!compList is ARRAY, !branchList is ARRAY)is ARRAY

!branch = !compList[1].owner
!find = !branchList.find(!branch)
 !compList.insert(1,!branch)
if !find.size().eq(0) then
  !compList.insert(2,'none')
elseif !find.size().eq(2) then
  !compList.insert(2,'complete')
else $* we have one branch in the list so its a head or tail
   -- find if the head or tail is part of the setup
   if !this.components.findFirst(!branch.href).set() then
       !compList.insert(2,'head')
   elseif !this.components.findFirst(!branch.tref).set() then
       !compList.insert(2,'tail')
   elseif !compList[2].order.eq(1) then
       !compList.insert(2,'head')
   else
       !compList.insert(2,'tail')
   endif
endif

return !compList

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to loop through the connected components and resolve the
-- connection references
define method .resolverefs()

   -- loop through the assembly items and set hRefs tRefs
   do !a values !this.assemblyItems
     if !a.type.eq('BRAN') then
         !this.connectBranch(!a)
         -- now loop through the rest of the components and see if we
         -- can find anything which was previously connected
     elseif !a.cref.set() then
         !this.connectComponent(!a)
     elseif !a.crfa.set() then
         !this.connectComponent(!a)
     endif
   enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to connect the new branches
define method .connectBranch(!current is BASECOMPONENT)

   -- find what the old head and tail settings were
   !href = !current.href
   !tref = !current.tref
   !branch = !current.newComp
   do !b values !this.assemblyItems
    if !b.origin.eq(!href) then
      !branch.href = !b.newComp
      -- 183381 (SI 85969) - To connect the Branch head to tee and restore connections
      if (!b.newComp.hardtype.eq(|TEE|)) then
        !currRef = !!ce
        !!ce = !branch
        conn PH to $!b.newComp
        conn PT to LAST MEM
        !!ce = !currRef
      endif
    elseif !b.origin.eq(!tref) then
      !branch.tref = !b.newComp
      -- 183381 (SI 85969) - To connect the Branch tail to tee and restore connections
      if (!b.newComp.hardtype.eq(|TEE|)) then
        !currRef = !!ce
        !!ce = !branch
        conn PT to $!b.newComp
        conn PH to FIRST MEM
        !!ce = !currRef
      endif
    endif
   enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to connect tees
define method .connectComponent(!current is BASECOMPONENT)

         -- find what the old head and tail settings were
         -- !cref = !current.cref
         !component = !current.newComp
         --$P in connectComponent

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .display()
-- method to show the results of the current group selection

  do !a values !this.designItems
     mark $!<a>
  enddo


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- main method to copy the design into a new assembly
define method .copyDesignItems()

   !!ce = !this.pipe
   !this.assemblyItems = ARRAY()

   -- !this.designItems consists of one or more arrays
   do !aType index !this.designItems
     !branch   = !this.designItems[!aType][1]
     !branType = !this.designItems[!aType][2]
     !remainingComps = !this.designItems[!aType].removeFrom(3)

     -- its a new array so we need to build a branch
     !this.createBran(!branch, !branType)

     do !a index !remainingComps
         if !a.eq(1) then
           if !aType.eq(1) then
               -- the assembly starts with a branch
               !this.assemblyItems.append(object BASECOMPONENT(!remainingComps[!a] , !branch ))
               bran
               conn ph to first mem
               conn pt to last mem
               1
               skip
           else
             !this.assemblyItems.append(object BASECOMPONENT(!remainingComps[!a] , !branch ))
             skip
           endif
         endif
         -- build the component
         !this.assemblyItems.append(object BASECOMPONENT(!remainingComps[!a] , !branch ))
         if !a.eq( !remainingComps.size()) then
          --$P at a branch
               -- the next item is a different branch, so we need to end the current one
               bran
               if !branType.eq('none') then
                   conn ph to first mem
                   conn pt to last mem
               else
                  !this.copyheadtail(!!ce,!branch,!branType)
               endif
         endif
    enddo
 enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to extract head and tail information from the old branch
define method .copyheadtail(!target is DBREF, !source is DBREF, !type is STRING)

if !type inset('head','complete')  then
 !hpos = !source.hpos
 !hp = !hpos.string().before('WRT')
 !target.hpos = !hp.position()
 !hdir = !source.hdir
 !hd = !hdir.string().before('WRT')
 !target.hdir = !hd.direction()
 !target.hcon = !source.hcon
 !target.hbor = !source.hbor
 !target.hstu = !source.hstu
else
  conn ph to first mem
endif

if !type inset('tail','complete')  then
 !tpos = !source.tpos
 !tp = !tpos.string().before('WRT')
 !target.tpos = !tp.position()
 !tdir = !source.tdir
 !td = !tdir.string().before('WRT')
 !target.tdir = !td.direction()
 -- !target.tdir = !source.tdir
 !target.tcon = !source.tcon
 !target.tbor = !source.tbor
else
  conn pt to last mem
endif

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- method to deal with the first component in an assembly and create the branch
define method .endassembly(!a is DBREF)

        if !a.type.neq('BRAN') then
           !this.assemblyItems.append(object BASECOMPONENT( !a, !!ce.owner ))
        endif
        tail
        conn pt to last mem

endmethod
------------------------------------------------------------------------

$(
------------------------------------------------------------------------
define method .trimbranmem(!seq is DBREF)
-- method to unset any items which may be duplicated after a copy branch


return

  !bran = !seq

  do !a from !seq + 1 to !this.designItems.size()
      if !this.designItems[!a].eq(!bran).or(!this.designItems[!a].owner.eq(!bran)) then
          !this.designItems[!a] = object DBREF()
      endif
  enddo

endmethod
------------------------------------------------------------------------
$)
------------------------------------------------------------------------
-- method to create a branch as part of an assembly.
-- can be a complete copy or a new branch or can be the last action to set the tail
define method .createBran(!designItem is DBREF ,!action is STRING)

  if !action.eq('complete') then
       new bran copy like $!designItem
  elseif !action.eq('none') then
      new bran
  elseif !action.eq('head') or !action.eq('tail') then
      new bran copy like $!designItem
  endif

  !this.assemblyItems.append(object BASECOMPONENT(!designItem, !!ce ))

endmethod
------------------------------------------------------------------------



------------------------------------------------------------------------
--
-- Method:      componentGroup
--
-- Description: Derives the component group information from the current
--              components in the "components" member of the object. Data
--              written to the object.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid list of components is returned
--
------------------------------------------------------------------------

define method .componentGroup() is BOOLEAN

  -- Initialise Variables
  !this.components       = ARRAY()

  -- Remove any implied tube
  do !component values !this.designItems

    skip if(!component.type eq 'TUBI' or !component.owner.type ne 'BRAN')
    if(!!dbrefUpdatable(!component).not()) then
      return false
    endif
    !this.components.append(!component)
  enddo

  -- No components to derive group from
  if(!this.components.empty()) then
    !!error.text = 'No component(s) selected.'
    return false
  endif

  -- Define data table
  !table            = object TABLE()
  !table.primarykey(!this.components)

  -- Define columns
  !columns[1]       = object COLUMN(object EXPRESSION('SEQUENCE'), true, true, 'Sequence')
  !columns[2]       = object COLUMN(object EXPRESSION('OWNER'), true, true, 'Owner')

  -- Build Table
  !table.columns(!columns)
  !table.evaluate()

  -- Check that all components are contiguous
  !sequence         = !table.column('Sequence')

  -- Empty component group list
  !this.componentGroup.clear()

  -- Group components
  !this.componentGroup      = !table.primarykey()

  -- Start/End component of group
  !first                    = !this.componentGroup.first()
  !last                     = !this.componentGroup.last()

  -- Arrive/Leave information of group
  !aposition                = !first.aposition
  !adirection               = !first.apirection
  !lposition                = !last.lposition
  !ldirection               = !last.ldirection
  !this.groupArrive         = object POINTVECTOR(!aposition, !adirection)
  !this.groupLeave          = object POINTVECTOR(!lposition, !ldirection)

  -- Basic characteristics of group
  !this.groupParallel       = !adirection.isparallel(!ldirection)
  !this.groupConcentric     = !this.groupArrive.line(1000mm).distance(!this.groupLeave.line(1000mm)) le !this.distanceTolerance

  -- Return
  return true

endmethod
-- End of method definition
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .settolerances()

  -- Initialise Variables
  var !tolAngle  TOL ANGLE
  var !tolOffset TOL OFFSET

  -- Handle imperial values
  !pos    = object POSITION('N' & !tolOffset)
  !offset = !pos.north

  !this.angleTolerance    = !tolAngle.real()
  !this.distanceTolerance = !offset

endmethod
-- End of method definition
------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to move the head of the first branch to n0u0e0
define method .moveorigin()

  !!ce = !this.pipe
  bran 1
  handle any
      return
  endhandle
  -- !wpos = n0 wrt /*

  !position   = !!ce.hpos.wrt(/* )
  !e = !position.east
  !u = !position.up
  !n = !position.north

  --!offset     = !position.distance(!wpos)
  --!direction  = !position.direction(!wpos).wrt(/* )

  !!ce = !this.pipe
  var !bran coll all bran for $!this.pipe
  do !a values !bran
    $!a
    by n (-1 * $!n)
    by e (-1 * $!e)
    by u (-1 * $!u)
    -- $P offset is $!offset
    -- !dir = !direction.string().before('WRT')
    -- $P direction is $!dir
    -- by $!dir $!offset
    --pos $!element.ppoi[$!point] at n0 wrt /*
    -- of $!element by $!direction  $!offset
  enddo


endmethod
------------------------------------------------------------------------------
$(
------------------------------------------------------------------------------
define method .createStringData(!pkey is STRING, !stringData is STRING)

  !!ce = !this.dataSet
  handle any
    !!alert.error('Assembly is incorrectly defined')
    return
  endhandle
  !newName =  !!ce.name.before('DDSE') & !pkey
  !!ce = !newName.dbref()
  handle any
     new ddat $!newName
  endhandle
  dkey $!pkey
  ddprop (|$!stringData|)
   !this.getDataValues()


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .deletestringdata(!type is STRING)

 !!ce = !this.dataSet
  handle any
    !!alert.error('Assembly is incorrectly defined')
    return
  endhandle
  !newName =  !!ce.name.before('DDSE') & !type

  !!ce = !newName.dbref()
  handle any
    !!alert.error('No File Defined')
    return
  endhandle
  delete ddat

  !this.getDataValues()

endmethod
------------------------------------------------------------------------------
$)
------------------------------------------------------------------------
define method .buildnewassembly(!pickType is STRING, !mode is BOOLEAN)
  Forwards

  !this.buildMode = !mode
  !this.update()

  if !this.type.eq('FUNC') then
    !func = !this.getpmlname(!this.func,1)
    $!func
    handle any
       !!alert.error('function $!func does not exist')
       return
    endhandle

  elseif !this.type.eq('FORM') then
    !form = !this.getpmlname(!this.form,2)
    show $!form
    handle any
       !!alert.error('form $!form does not exist')
       return
    endhandle
  else
    --This is the bit which builds the assembly by inserting it in a straight tube
    if !pickType.eq('intube') then
       !this.connected = FALSE
       if !this.key then
         !!alert.error('Please use the Connect Button to build a KEY Assembly')
         return
       endif
       -- go and build the assembly after picking the appropriate insert point
       if !this.assemblySelection().not() then
         -- undo
       endif
    elseif !pickType.eq('connected') then
        !this.connected = TRUE
        if !this.assemblyConnect().not() then
         -- undo
        endif
    endif
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to get the file or function name from the passed string
define method .getpmlname(!name is STRING,!type is REAL)is STRING

!return = !name.replace(' ','')
if !return.match('!').eq(0) then
   !return = '!!' & !return
endif

if !type.eq(1) then
  if !return.match('()').eq(0) then
     !return = !return  & '()'
  endif
endif

return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      AssemblySelection
--
-- Description: List the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Components to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .assemblySelection(!components is ARRAY) is BOOLEAN

  -- Initialise Variables
  !this.components  = !components
  if !this.assemblyCompile() then
        return TRUE
  endif

  return FALSE

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- originally copied from pipingActions
define method .assemblyCompile()is BOOLEAN

  if(defined(!!testTemplate)) then
    !!testTemplate.delete()
  endif
  !sequence         = ARRAY()
  -- Derive Group information
  if(!this.componentGroup()) then

    -- Copy component group
    do !i indices !this.componentGroup
      !component    = !this.componentGroup[!i]
      !type         = !component.type
      !stype        = !component.stype
      !shop         = !component.shop
      if !type.eq('REDU') then
        !sequence.append('NEW REDU CHOOSE ALL')
        if(!component.arrive.neq(1)) then
           !sequence.append('FLIP')
        endif
         if(!i.eq(1)) then
           !p3dir = !component.pdir[3]
           handle(2,201)
              !sequence.append('ORI')
           elsehandle NONE
              !sequence.append('ORI AND P3 IS ' & !p3dir)
           endhandle
         else
           !sequence.append('ORI')
         endif
      else
         !sequence.append('NEW ' & !component.type & ' SELECT WITH STYP ' & !stype)
         if(!component.arrive.neq(1)) then
           !sequence.append('FLIP')
         endif
         !sequence.append('ORI')
      endif
      if(!i.eq(1)) then
        !sequence.append('AT $$!<position>')
      endif
      !sequence.append('!selection.add(!!ce)')

      -- Bend
      if(!component.type.eq('BEND')) then
        !ratio      = int(!component.radius / !component.aod)
        !sequence.append('RADIUS (' & !ratio & ' * AOD)')
        !angle      = !component.angle
        !sequence.append('ANGLE ' & !angle)
      endif

      -- Ignore first component
      if(!i.neq(1)) then

        !previous   = !this.componentGroup[!i - 1]

        -- Connected to previous
        if(!component.aposition.near(!previous.lposition, 1mm)) then
          !sequence.append('CONNECT')
        else
          !distance = !component.position.distance(!previous.position)
          !sequence.append('DISTANCE ' & !distance)
        endif

        -- Orientation with respect to previous component
        !ori        = !component.orientation.wrt(!previous).string().before('WRT').trim()
        !sequence.append('ORIENTATE AND ' & !ori & ' WRT PREVIOUS')
      endif

    enddo

    !!testTemplate = !sequence

  endif

  -- Derive Group information
  if(defined(!!testTemplate)) then

    -- Copy component group
    return !this.assemblySelection()

  endif

  -- Return
  return false

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      AssemblySelection
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .assemblySelection() is BOOLEAN

  -- Initialise Variables
  !result = true

  -- Define EDG packet
    -- Define Packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Identify an Insertion Point in Tube')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  =  '!!' & !this.varid & '.assemblySelection(!this.return[1])'
  !packet.remove  = true
  !!edgcntrl.add(!packet)
  handle any

  endhandle
  -- Return
  return !result


endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      AssemblySelection
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .assemblySelection(!data is  EDGPICKDATA)


  -- Initialise Variables
  !tubing         = object EDGTUBING()
  !position       = !tubing.exact(!data.item, !data.pickLine)
  !element        = !data.item

  !this.undo           = object UNDOABLE()
  !this.undo.description('Create selection copy')
  !this.undo.add()

  !this.buildintube(!position,!element,1,true)
  handle 111
     !!fmSys.setProgress(0)
     !!alert.message('Assembly Cancelled. All components have been removed')
     !this.undo.endUndoable()
     undodb 1
  elsehandle (61,164)
     !!fmSys.setProgress(0)
     !!alert.warning('No suitable components can be found in the Specification - Assembly Cancelled. All components have been removed')
     !this.undo.endUndoable()
     undodb 1
  elsehandle NONE
      !this.undo.endUndoable()
  endhandle

endmethod

------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      assemblyConnect
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .assemblyConnect() is BOOLEAN

  -- Initialise Variables
  !result = true

   -- Define EDG packet
    -- Define Packet

  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Identify Component')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  if !this.key then
     !packet.pickPacket.picks[1].stdElement('Identify Key Component')
     !packet.action  =  '!!' & !this.varid & '.assemblykey(!this.return[1])'
  else
     !packet.action  =  '!!' & !this.varid & '.assemblyConnect(!this.return[1])'
  endif
  !packet.remove  = true
  !!edgcntrl.add(!packet)

  -- Return
  return !result

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      AssemblyKey
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .assemblykey(!data is  EDGPICKDATA)


  -- Initialise Variables
  !tubing         = object EDGTUBING()
  !line           = !tubing.line(!data.item)
  !element        = !data.item
  !this.insertElement = !element
  !this.buildwithkey(!element)
  -- delete the variable to say we are in an assembly
  !!inassembly.delete()
  handle any
  endhandle

endmethod

------------------------------------------------------------------------

--------------------------------------------------------------------------
--
-- Method:      AssemblyConnect
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .assemblyConnect(!data is  EDGPICKDATA)

  -- Initialise Variables
  !tubing         = object EDGTUBING()
  !line           = !tubing.line(!data.item)
  handle any
    !!alert.error(|Picked component has unset specification! Cannot find position to build assembly.|)
    return
  endhandle

  !position       = !line.startposition
  !element        = !data.item

  if !this.buildMode.not() then
     !position = !element.aposition.wrt(World)
     -- need to change this if its a branch
  endif
  !this.buildintube(!position,!element,0,true)
  handle 111
     !!fmSys.setProgress(0)
     !!alert.message('Assembly Cancelled. All components have been removed')
     !this.undo.endUndoable()
     undodb 1
  elsehandle NONE

      !this.undo.endUndoable()
      handle any
      endhandle
  endhandle

  !!inassembly.delete()
  handle any
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      buildDummy
--
-- Description: build the components at element and position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
-- This is the a building routine which gets the length
define method  .buildDummy(!position is POSITION,!insertItem is DBREF,!oType is REAL)is ARRAY

!this.undo = object UNDOABLE()
!this.undo.description('Create dummy assembly')
!this.undo.add()
!this.assemblyLength = 0
!this.originOffset   = 0
!this.originOffset2  = 0

!this.undoSwitch = FALSE
!this.buildintube(!position, !insertItem, !oType, FALSE)

-- variable to stop the component creation form from navigating whilst in assemblies
!!inassembly.delete()
handle any
endhandle

!return[1] = !this.assemblyLength
!return[2] = !this.originOffset
!return[3] = !this.secondaryOffset

!this.undo.endUndoable()
undodb 1

return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .buildsplitassembly(!position is POSITION,!insertItem is DBREF,!origin is REAL,!feedback is BOOLEAN)

  !this.undoSwitch = FALSE
  !this.buildintube(!position,!insertItem, !origin,!feedback)
  handle ANY
  endhandle
  !this.undoSwitch = TRUE

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      buildInTube
--
-- Description: build the components at element and position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

-- This is the main building routine
define method  .buildintube(!position is POSITION, !insertItem is DBREF, !origin is REAL, !feedback is BOOLEAN)

  !!inassembly = TRUE

  if !this.undoSwitch then
    !this.undo           = object UNDOABLE()
    !this.undo.description('Create selection copy')
    !this.undo.add()
  endif

  !this.commandString = ARRAY()


  if !this.buildMode.not() then
     if !this.connected then
       !this.insertElement = !insertItem
     elseif !insertItem.type.eq('BRAN') then
          !this.insertElement = !insertItem.members[1]
          handle any
             !this.insertElement = !insertItem
          endhandle
     elseif !insertItem.order.eq(!insertItem.owner.members.size()) then
         !this.insertElement = !insertItem.owner
     else
        !this.insertElement = !insertItem.owner.members[!insertItem.order + 1]
     endif
  else
     !this.insertElement = !insertItem
  endif
  !this.insertPosition = !position
  -- New components
  !this.components = ARRAY()
  !this.components     = !this.getActiveComps(!this.designItems)
  !this.selection      = object SELECTION()
  -- !referencePoint = !this.components.first().position
  -- !refDistance    = !referencePoint.distance(!position)
  -- !refDirection   = !referencePoint.direction(!position)
  !!ce            = !insertItem
  if !!ce.type.eq('BRAN') then
    !spec  = !!ce.pspe.name
  else
     !spec = !!ce.spow.name
     -- p-34398 problem inserting after an invalid component
     handle ANY
       !!alert.error('Insert component has an invalid Specification Reference - Assembly aborted.')
       return
     endhandle
  endif

  !this.tees = ARRAY()
  !this.branches = ARRAY()
  !this.builtItems = ARRAY()
    -- Copy component group

  !this.savedComponent  = object DBREF()
  do !a values !this.components
     if !a.type.neq('BRAN') then
        !this.savedOriginal   = !a
     endif
     break
  enddo

  !this.selection = object SELECTION()
  -- main build loop

 -- build the components
 -- also used by buildForwards
 if !this.buildMode.not() then
    -- this is backwards mode so we need to do something different
    !this.backwardsList = !this.components.invert()
    --!this.buildBackwards(!this.selection,1,!spec,'all')
    !this.buildBackwards(!this.selection,1,!spec,!origin)
 else
 	
   -- Negative situation handle (Test team scenario)
   if (!this.components.size() eq 0) then
     !!alert.error('No components in this assembly')
     return
   endif

    -- we are building in normal forwards mode no problem
   !this.buildFromList(!this.components,!spec,!origin,!feedback,!position)
 endif

  !!componentCreation.component = !!ce.owner
  handle any
  endhandle
--  !!componentCreation.componentPosition = !!ce.position
  !!componentCreation.componentPosition =  n1
  handle any
  endhandle

  !!ce = !this.builtItems[!this.builtItems.size()]

  !this.selection.setCurrent()
  !!fmSys.setProgress(0)

  if !this.undoSwitch then
    !this.undo.endUndoable()
  endif
endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to build an array of components
-- used by build in tube and buildForwards
------------------------------------------------------------------------
define method .buildFromList(!components is ARRAY, !spec is STRING, !origin is REAL, !feedback is BOOLEAN, !position is POSITION)

  !move = FALSE
  !this.moved = FALSE

  !increment = 100 / !this.components.size()

  if !origin.eq(1).or(!origin.eq(2)) then

       if !origin.eq(1) then
        !originElement        = !this.primaryOrigin
        !originPoint          = !this.primaryPoint
        !secondaryElement     = !this.secondaryOrigin
        !secondaryPoint       = !this.secondaryPoint
       else
        !originElement        = !this.secondaryOrigin
        !originPoint          = !this.secondaryPoint
        !secondaryElement     = !this.primaryOrigin
        !secondaryPoint       = !this.primaryPoint
      endif
      if !originElement.set() then
       !move = TRUE
      else
       !move = FALSE
      endif
  endif

   do !i indices !components

      !component = !components[!i]
      -- go and get the rules for the component template
      !this.assemblyComponent = object PIPEASSEMBLYCOMPONENT(!component)

      if !i.neq(1) then
         !this.branches.append(!component.owner)
         !previous  = !components[!i - 1]
      else
         !previous = object DBREF()
      endif

      if !feedback then
        !this.updatetags(!component)
        !this.refreshDisplay()
        !currentProgress  = !i * !increment
        !!fmSys.setProgress(!currentProgress)
      endif

      -- go and create the component
      !this.createComponent(!component,!spec,!previous,!i)
      handle 111
         -- if there is an error in selection we need to sort out what to do from here
         return error 111 noalert
      endhandle

      if !component.eq(!this.primaryOrigin) then
         !this.newPrimary = !!ce
      elseif !component.eq(!this.secondaryOrigin) then
         !this.newSecondary = !!ce
      endif

     -- orientate
     ori
     handle any
     endhandle
      -- originally this orientate component code came before the positioning
      -- but you should always orientate before positioning to ensure that the position
      -- is along the correct axis and the position point is in the correct relative position
      -- Unfortunately you cannot use the direction commands for orientation until the object
      -- is positioned so now we do a basic ori, the position then re-orientate to capture the
      -- direction commands

       -- position
       !this.positioncomponent(!component, !i, !previous, !spec )
       handle 112
          return error 111
       endhandle

       --reapply the orientation including the rules
        !this.orientatecomponent(!component, !i, !previous)
       handle 111
         -- if there is an error in selection we need to sort out what to do from here
         return error 111
       endhandle

      if !component eq !this.savedOriginal then
         !this.savedComponent  = !!ce
      endif


      -- add the new item to the graphical selection
      if !!ce.type.neq('BRAN') then
         !this.selection.add(!!ce)
      endif
      --$P just built $!!ce.type
      --$P index is $!i
      !this.builtItems[!i] = !!ce

      if !move then
        if !component.eq(!originElement) then
           !this.movetonewposition(!originPoint,!position)
        endif
      endif
       if !feedback then
        !this.refreshDisplay()
       endif

    enddo

    !this.settail(!component)
    !this.calculatelengths(!this.builtItems)


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .movetonewposition(!originPoint is REAL, !position is POSITION)

    !line = object LINE()
    !line.startposition = !!ce.pposition[!originPoint].wrt(/* )
    !line.endposition  = !position
    if !line.length().neq(0) then
       !vector = !line.pointvector()
       !this.movedDistance = !line.length()
    else
--CW fix to allow single items ie field welds to be used to split pipes
       !vector = object POINTVECTOR()
       !vector.direction = N wrt /*
       !this.movedDistance = 0
--end of fix
    endif
    !this.originOffset = !this.movedDistance
    do !comp values !this.builtItems
       !this.commandString.append('$!comp')
       !!ce = !comp
       !this.commandString.append('move $!vector.direction distance $!this.movedDistance')
       move $!vector.direction distance $!this.movedDistance
    enddo
    !this.moved = TRUE
    !this.originOffset = !this.movedDistance

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .calculatelengths(!items is ARRAY)

!startPos          = !items[1].apos
!owner             = !items[1].owner
!endPos = object POSITION()

 !this.originOffset    = 0
 !this.secondaryOffset = 0

do !a from 1 to !items.size()
   if !items[!a].eq(!this.newPrimary) then
       !primaryPos = !items[!a].pposition[!this.primaryPoint]
       handle any
       endhandle
       !this.originOffset = !startPos.distance(!primaryPos)
   elseif  !items[!a].eq(!this.newSecondary) then
       !secondaryPos = !items[!a].pposition[!this.secondaryPoint]
       handle any
       endhandle
       !this.secondaryOffset = !startPos.distance(!secondaryPos)
   endif

   if !items[!a].owner.neq(!owner) then
      -- we have reached the end of the items in the first branch
      break
   endif
   !endPos = !items[!a].lpos
enddo

if !endPos.set() then
   !this.assemblyLength = !startPos.distance(!endPos)
else
   !this.assemblyLength = object REAL()
endif

$(
!return = ARRAY()
!return[1] = !this.assemblyLength
!return[2] = !this.originOffset
!return[3] = !this.secondaryOffset
$)

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method for creating and selecting the design component
define method .createComponent(!component is DBREF, !spec is STRING,!previous is DBREF,!i is REAL )

      !type         = !component.type
      if !type.eq('BRAN') then
        !this.inlinebranch(!component,!previous)
         return
      endif


      !stype        = '|' + !component.stype + '|'
      -- !stype        = !component.stype
      !shop         = !component.shop

      if !type inset('TEE' ,'OLET', 'VTWA') then
        !this.buildtee(!component,!type,!i)
        handle 111
          return error 111
        endhandle
        return
      elseif !type.eq('REDU') then
        !this.buildreducer(!component,!i)
        handle 111
           return error 111
        endhandle
        return
      endif

      !this.commandString.append('NEW $!type copy like $!component')
      NEW $!type copy like $!component
      spref =0
      !this.commandString.append('ispe ispe of owner')
      ispe ispe of owner
      -- check if the component is a forced selection
      do !try values !this.assemblyComponent.styperules
          -- fixed means that you want to force a component to use the spec given
              !test = !try.split(',')[3]
              !fixed = $!test
             if !fixed then
                !altSpec = !try.split(',')[1]
                !stype = !try.split(',')[2]
                !this.commandString.append('SELECT WITH SPEC $!altSpec STYP $!stype')
                SELECT WITH SPEC $!altSpec STYP $!stype
                handle ANY
              	     !this.commandString.append('choose spec $!altSpec ALL')
                    choose spec $!altSpec ALL
                    handle any
                      !!alert.error('$!!error.text')
                      return error 111
                    elsehandle NONE
                      !this.setLstu()
                      return
                    endhandle
                elsehandle NONE
                   if !!ce.spref.unset() then
                      return error 111
                   endif
                   return
                endhandle
             endif
         enddo
      -- if there is no forced selection
      -- try to select normally
      !this.commandString.append('SELECT WITH STYP $!stype')
      SELECT WITH STYP $!stype
--      handle (42,55)(42,501)(42,64) $* no answers provided for
      handle ANY
        !selectError = !!error.text
        -- go to get choice to do the bits with shop flags etc
        !this.getChoice(!component,!stype)
          -- if it returns from the getChoice with an error then try harder
          handle any
           -- go and find if there are any additional stype rules
           !testChoice = !this.getAlternatives(!component,!type,!spec)
           if !testChoice.not() then
             -- test to see if there is only 1 item
             -- first test to see if there is only one alternative
             !this.commandString.append('!choice = select')
             !choice = select
             handle (61,162)
               -- cannot find component of given type
               !choice = ARRAY()
             endhandle
             if !choice.size().eq(1) then
               -- Check introduced for the user to confirm if he want to go ahead with alternative STYPE element.
               !selectionArray = !this.getChoiceSelector(!selectError, !component)
               !typeOfComp  = !choice[1].catref.gtype
              if( !selectionArray.empty() ) then
                 !confirmMess = |SPEC does not contain a | + !typeOfComp + | with STYP | + !component.stype + |. Alternative component found, would you like to use this instead?|
               else
                 !confirmMess = |SPEC does not contain a | + !typeOfComp + | with STYP | + !component.stype + | and | + !selectionArray[1] + | |  + !selectionArray[2] + |. Alternative component found, would you like to use this instead?|
               endif
               -- stop component creation tracking from firing when question is asked
               !!inassembly = TRUE
               !confirmVal = !!alert.confirm(!confirmMess)
               !!inassembly.delete()
               if (!confirmVal.eq(|YES|)) then
                   !!ce.spref = !choice[1]
                   handle ANY
                   elsehandle NONE
                     !this.setLstu()
                     if( !type eq 'BEND') then
                       !this.bendRadius(!component)
                     endif
                     return
                   endhandle
               else
                   return error 111
               endif
             endif
             -- if it gets here its still not been found
             !name = !!ce.flnn
             !!alert.message('$!name cannot be selected, please choose one from the list.')
              --!!alert.error('Error in Selecting $!name $!!error.text')
              !this.commandString.append('choose all')
             CHOOSE ALL
             handle (61, 164) (61, 162)
               -- protect against spec containing no elements matching the criteria
                delete $!!ce.type
                return error 111 noalert
             endhandle
             if !!ce.spref.unset() then
                delete $!!ce.type
                return error 111 noalert
             endif
           endif
          endhandle
      endhandle
      -- consider any design parameters that may need to be set from elsewhere
      -- also consider any design parameters such height and radius
      !this.setdespars(!component)
      !this.setLstu()

      -- Bend
      if  !type.eq('BEND') then
        !this.bendRadius(!component)
      endif

endmethod

------------------------------------------------------------------------
-- set bend radius.    CE must be a BEND
------------------------------------------------------------------------
define method .bendRadius(!component is DBREF)

  !!ce.radius = dfbrad
  handle any
    -- try to match the radius with the copied element
    !ratio      = int(!component.radius / !component.aod)
    !this.commandString.append('RADIUS ($!ratio * AOD)')
    RADIUS ($!ratio * AOD)
  elsehandle none
    -- dfbrad was successful
    !this.commandString.append('!!ce.radius = dfbrad')
  endhandle

  !angle      = !component.angle
  !this.commandString.append('ANGLE $!angle')
  ANGLE $!angle

endmethod

------------------------------------------------------------------------
-- method for setting the lstu and trying to maintain its STYPE
define method .setLstu()

!tube = !this.insertElement.lstu
handle any
  !tube = !this.insertElement.hstu
  handle any
    SEL LSTU
    return
  endhandle
endhandle
!stype = !tube.stype
handle any
   SEL LSTU
   return
elsehandle none
  sel LSTU with stype $!stype
  handle any
   SEL LSTU
   return
  endhandle
endhandle

endmethod


-------------------------------------------------------------------------
-- method for getting alternative stypes
define method .getAlternatives(!source is DBREF, !type is STRING, !spec is STRING ) is BOOLEAN

  if !this.assemblyComponent.styperules.set() then
    do !d values !this.assemblyComponent.styperules
       !stype = !d.split(',')[2]
       !this.commandString.append('SELECT WITH STYP $!stype')
       SELECT WITH STYP $!stype
       handle (42,55)
         !this.commandString.append('SELECT WITH STYP $!stype SHOP TRUE')
         SELECT WITH STYP $!stype SHOP TRUE
         handle (42,55) (42,64) (42,501)
           -- no answers provided for xxx
           !this.commandString.append('SELECT WITH STYP $!stype SHOP FALS')
           SELECT WITH STYP $!stype SHOP FALS
            handle any
              return FALSE
            elsehandle NONE
              return TRUE
            endhandle
         elsehandle NONE
            return TRUE
         endhandle
       elsehandle any
          !this.getChoice(!component,!stype)
          handle any
            skip
            return FALSE
          elsehandle NONE
            return TRUE
          endhandle
       elsehandle NONE
          return TRUE
       endhandle
    enddo
  endif

  return FALSE

endmethod

-------------------------------------------------------------------------
-- method to get the component answers and try and select again
------------------------------------------------------------------------
define method .getChoice(!component is DBREF, !stype is STRING)

  !errorText = !!error.text
  !selector  = !this.getChoiceSelector(!errorText, !component)
  if( !selector.empty() ) then
    return error 6
  endif
  !question = !selector[1]
  !answer   = !selector[2]

  select with stype $!stype $!question $!answer
  handle ANY
    return error 7
  endhandle

endmethod

-------------------------------------------------------------------------
-- method to get the component question from selection error string
-- return array contains selector in !return[1] and required answer
-- in !return[2]
------------------------------------------------------------------------
define method .getChoiceSelector(!selectionErrorText is STRING, !component is DBREF) is ARRAY

  !return   = ARRAY()
  !selector = !selectionErrorText.after('Answer ').before(')')
  handle ANY
    return !return
  endhandle
  -- get value for selector
  !value = !component.$!<selector>
  handle ANY
    return !return
  endhandle

  -- get selection and answer
  if !value.objecttype().neq('STRING') then
    !answer = !value.string()
    if !answer.upcase().eq('FALSE') then
       !answer = 'FALS'
    endif
  else
    !answer = !value
  endif
  !return[1] = !selector
  !return[2] = !answer

  return !return

endmethod
------------------------------------------------------------------------



------------------------------------------------------------------------
define method .orientatecomponent(!component is DBREF, !i is REAL, !previous is DBREF )

     if !component.type.eq('BRAN') then
       return
     endif

     !this.commandString.append('ORI')
     ori

     -- if we have any ori commands then they override the normal mechanism
     !test = !this.getoricommands(!component)
     handle any
       return error 111
     endhandle
     if !test then
       return
     endif

     if !i eq 1 then
       -- we are at the first component

        !this.orientatefirst(!component, !i, !previous)
     elseif !previous.type.eq('BRAN')  then
       !ori = !component.orientation.wrt(!component.owner).string().before('WRT').trim()
       !this.commandString.append('ORIENTATE AND $!ori WRT owner')
       ORIENTATE AND $!ori WRT owner
       handle any
         ori
       endhandle
     elseif !component.type inset('TEE' ,'OLET', 'VTWA') then
              !leave = 6 - !component.arrive - !component.leave
              !default = !component.pdir[!leave].wrt(/* ).string().before('WRT').trim()
              !dir = !!alert.input('Please Enter a direction for P$!leave','$!default')
             -- we have found a component which needs to be orientated relative to something else
             !this.commandString.append('ori and p$!leave is $!dir')
             ori and p$!leave is $!dir
             handle any
                !!alert.error('could not complete command ori and p$!leave is $!dir - assembly aborted')
             endhandle
     else
       -- Orientation with respect to previous component
       !ori        = !component.orientation.wrt(!previous).string().before('WRT').trim()
        !this.commandString.append('ORIENTATE AND $!ori WRT PREVIOUS')
        ORIENTATE AND $!ori WRT PREVIOUS
        handle any
          !this.commandString.append('ORIENTATE AND $!ori WRT PREVIOUS')
          ORIENTATE $!ori WRT PREVIOUS
        endhandle
     endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to orientate the first component. if its got an offset the user is asked.
define method .orientatefirst(!component is DBREF, !i is REAL, !previous is DBREF )

       if !this.buildMode.not() then
        -- we are building backwards
        !ldir = 'adir'
        !adir = 'ldir'
       else
        !ldir = 'ldir'
        !adir = 'adir'
       endif
       if !component.$!<adir>.wrt(/* ).neq(!component.$!<ldir>.wrt(/* ).opposite()) then
              !default = !component.$!<ldir>.wrt( /* ).string().before('WRT').trim()
              !dir = !!alert.input('Please Enter a direction for PL','$!default')
             -- we have found a component which needs to be orientated relative to something else
              !this.commandString.append('ori and pl is $!dir')
              ori and pl is $!dir
       elseif !component.type inset('TEE' ,'OLET', 'VTWA') then
              !leave = 6 - !component.arrive - !component.leave
              !default = !component.pdir[!leave].wrt(/* ).string().before('WRT').trim()
              !dir = !!alert.input('Please Enter a direction for P$!leave','$!default')
             -- we have found a component which needs to be orientated relative to something else
               !this.commandString.append('ori and p$!leave is $!dir')
              ORI and p$!leave is $!dir
              handle any
                !!alert.error('could not complete command ori and p$!leave is $!dir - assembly aborted')
              endhandle
       else
              ORI
       endif

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
define method .positioncomponent(!component is DBREF, !i is REAL, !previous is DBREF, !spec is STRING)

     if(!i.eq(1)) then
          if !this.buildMode then
             !this.commandString.append(| POS PA AT $!<this.insertPosition> |)
             POS PA AT $!<this.insertPosition>
          else
             !this.commandString.append(| POS PL AT $!<this.insertPosition> |)
              POS PL AT $!<this.insertPosition>
          endif
     elseif !component.type.eq('BRAN') then
         return
     else
    -- see if we have a stored command for positioning
    -- if there is it gets executed and we
    --- need to apply to the first component as well
       if !this.getpositioncommand(!component,!component.type,!spec).not() then

         if !previous.type.eq('BRAN') then
           if(!component.aposition.near(!previous.hposition, 1mm)) then
             !this.commandString.append('CONNECT')
             pos pa at ph
             CONNECT
             handle (7,3) $* incompatible connection types
                !!alert.error('Component has incompatible connection types - Assembly Creation Aborted')
                return error 112
             endhandle
           else
             !distance = !component.position.distance(!previous.hposition)
             !this.commandString.append('DISTANCE $!distance')
             DISTANCE $!distance
           endif
         -- Connected to previous

         elseif(!component.aposition.near(!previous.lposition, 1mm)) then
             !this.commandString.append('CONNECT')
             -- CONNECT
             pos pa at pl of prev
             handle (7,3) $* incompatible connection types
                !!alert.error('Component has incompatible connection types - Assembly Creation Aborted')
                return error 112
             endhandle
         else
           !distance = !component.position.distance(!previous.position)
             !this.commandString.append('DISTANCE $!distance')
             DISTANCE $!distance
         endif

       endif
     endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      BuildReducer
--
-- Description: build reducers
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define method  .buildreducer(!component is DBREF,!i is REAL)

        --new redu copy like $!component
        !addItem = object BASECOMPONENT(!component, !!ce )
        !this.assemblyItems.append(!addItem)
        !this.commandString.appendArray(!addItem.commandString)
        !this.commandString.append('SPREF = 0')
        SPREF =0
        !this.commandString.append('ispe ispe of owner')
        ispe ispe of owner
        if !this.assemblyComponent.lBoreRules.set() then
          -- to be used later
          --!point     = !this.assemblyComponent.lBoreRules[1].split(',')[1]
          !copyPoint = !this.assemblyComponent.lBoreRules[1].split(',')[2]
          !eleRule   = !this.assemblyComponent.lBoreRules[1].split(',')[3].dbref().valrule
          !element   = $!eleRule

        if !element.type.eq('TEE') then
          do !b index !this.tees
            if !this.tees[!b + 1].eq(!element) then
              !newElement = !this.tees[!b]
              break
            endif
          enddo
        else
          do !b values !this.assemblyItems
            if !b.origin.eq(!element) then
              !newElement = !b.newComp
            endif
          enddo
        endif

         if !element.type.eq('TEE') then
           !bore = !newElement.p$!copyPoint
            handle ANY
              !this.commandString.append(!!error.txt)
              return
            endhandle
         else
             !a = !newElement.arrive
             handle ANY
              !this.commandString.append(!!error.txt)
               return
             endhandle
             !this.commandString.append('var !pbore p$!a of $!newElement')
             var !pbore p$!a of $!newElement
             !bore = !pbore.split(' ')[4]
          endif
          !stype = !component.stype

          !this.commandString.append('select with stype $!stype lbore $!bore')
          select with stype $!stype lbore $!bore
          handle ANY
            !this.commandString.append('$!!error.txt')
          elsehandle NONE
          return
          endhandle

        endif


        !this.commandString.append(' CHOOSE ALL')
        CHOOSE ALL
        if !!ce.spref.unset() then
           !this.commandString.append('Error: Spref unset')
           return error 111
        endif
        if(!i.eq(1)) then
           !p3dir = !component.pdir[3]
           handle(2,201)
               !this.commandString.append('$!!error.txt')
               !this.commandString.append('ORI')
               ORI
           elsehandle NONE
               !this.commandString.append('ORI AND P3 IS $!p3dir')
               ORI AND P3 IS $!p3dir
           endhandle
        else
               !this.commandString.append('ORI')
               ORI
        endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      buildTee
--
-- Description: build tees and olets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define method  .buildtee(!component is DBREF,!gtype is STRING, !i is REAL)

  -- first get the spare end
  !this.commandString.append('NEW $!gtype')
  NEW $!gtype
  !this.commandString.append('SPREF = 0')
  spref =0
  !this.commandString.append('ispe ispe of owner')
  ispe ispe of owner
  !this.commandString.append('ARRIV $!component.arrive')
  ARRIV $!component.arrive
  !this.commandString.append('LEAVE $!component.leave')
  LEAVE $!component.leave

  -- Check to see if we have any bore selection rules for the current tee
  if !this.assemblyComponent.lBoreRules.set() then

    -- Get the bore selection rule e.g. 'LEAV,PBORE[3],=23399/92'
    !eleRule   = !this.assemblyComponent.lBoreRules[1].split(',')[3].dbref().valrule
    -- DBREF of element that the rule is based on (TEE 1 of BRANCH 1 of PIPE /controlSets-1-PIPE)
    !element   = $!eleRule
    --
    !destinationType = !this.assemblyComponent.lBoreRules[1].split(',')[2].string().trim()
     -- Get the source bore type e.g. LEAV, ARRI,PP3
    !sourceType  = !this.assemblyComponent.lBoreRules[1].split(',')[1].string().trim()

      -- Find if tee in the rule has already been built
      !index = !this.tees.findFirst(!element)

      -- Tee in rule exists, get BORE and STYPE
      if !index.set() then

        -- Get the tee that has been already built rather than the one in reference assembly
        !tee = !this.tees[!index - 1]

        -- Get the bore of the reference assembly tee
        if !sourceType.eq('ARRI') then
          var !pbore abore of $!tee
        elseif !sourceType.eq('LEAV') then
          var !pbore lbore of $!tee
        elseif !sourceType.eq('PP3') then
          var !pbore p3 of $!tee
          !bore = !pbore.split(' ')[4]
        endif

        -- Get the STYPE
        !stype = !tee.stype

         -- Select tee
        if !destinationType.eq('ABORE') then
          !this.commandString.append('select with stype $!stype abore $!pbore')
          select with stype $!stype abore $!pbore
        elseif !destinationType.eq('LBORE') then
          !this.commandString.append('select with stype $!stype lbore $!pbore')
          select with stype $!stype lbore $!pbore
        elseif !destinationType.eq('PBORE[3]') then
          !this.commandString.append('select with stype $!stype pbor3 $!bore')
          select with stype $!stype pbor3 $!bore
        endif

        handle ANY
           !this.commandString.append('$!!error.txt')
        elsehandle NONE
         -- Append new tee and tee out of reference assembly
         !this.tees.append(!!ce)
         !this.tees.append(!component)
         return
        endhandle

      endif

  endif

  !this.commandString.append('CHOOSE ALL')
  CHOOSE ALL
  handle (61, 164) (61, 162)
    -- protect against spec containing no elements matching the criteria
    !this.commandString.append('Error: Spref unset')
    return error 111
  endhandle
  if !!ce.spref.unset() then
    !this.commandString.append('Error: Spref unset')
    return error 111
  endif
  !this.tees.append(!!ce)
  !this.tees.append(!component)
  -- need to do more work

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      InLineBranch
--
-- Description: build inline branches
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define method .inlinebranch(!branch is DBREF, !prev is DBREF)

!conn = FALSE

!this.commandString.append('New bran copy like $!branch')

!lastcomp = !!ce
  !spec = !!ce.owner.pspe
New bran copy like $!branch
  !!ce.pspe = !spec

!href = !branch.href
!x = !this.tees.findFirst(!href)
if !x.set() then
  !tee = !this.tees[!x - 1]
  !this.commandString.append('conn ph to $!tee')
  conn ph to $!tee
  !conn = TRUE
endif

!tref = !branch.tref
!x = !this.tees.findFirst(!tref)
if !x.set() then
  !tee = !this.tees[!x - 1]
  !this.commandString.append('conn pt to $!tee')
  conn pt to $!tee
  !conn = TRUE
endif

if !conn then
  return
endif
-- if it gets here then we need to connect the tail of the previous branch
if !prev.unset() then
  return
endif

--  we have unexpectedly come across the start of a new branch
--  the previous component's leave point is the current position
!newBranch = !!ce
!!ce = !lastcomp
!currentBranch = !!ce.owner
-- first end the current branch
!tubeLength = !prev.ltlen
!currentComponent = !!ce
tail
!!ce.tpos  = !currentComponent.lposition
!!ce.tdir  = !currentComponent.ldirection.opposite()
!!ce.tbore = !currentComponent.lbore
!this.commandString.append('move pt dist $!tubeLength')
move pt dist $!tubeLength

!!ce = !newBranch
if !branch.href.eq(!prev.owner) then
   -- the head is connected
   !!ce.href  = !currentBranch
   !!ce.hpos  = !currentBranch.tpos
   !!ce.hdir  = !currentBranch.tdir.opposite()
   !!ce.hbore = !currentBranch.tbore
endif

endmethod
------------------------------------------------------------------------

-- method to get the bare bones of what to create in the new assembly
-------------------------------------------------------------------------
define method .getActiveComps(!items is ARRAY )is ARRAY

!branches = 0
!return = ARRAY()

do !a values !items
    -- fix for items being deleted in the assembly master.
    if !a.badref() then
      skip
    endif
  skip if !a.type inset('APPLDA','DDSE','DDAT','VVALUE','ZONE','PIPE','TUBI','PSLIST','PSPOOL','PPLIST','PPIECE')
  if !a.type.eq('BRAN') then
    !branches = !branches + 1
    if !branches.eq(1) then
      skip
    endif
  endif
  !return.append(!a)
enddo

return !return

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .getoricommands(!source is DBREF ) is BOOLEAN

   !error = FALSE
   do !a values !this.assemblyComponent.orirules
      !command = !a.split(',')[2]
      if !command.upcase().match('PROMPT').gt(0) then
            var !coord coord
            if(!coord eq 'ENU')then
            !dir = !!alert.input('Please Enter a direction for P3','N')
            else
              !dir = !!alert.input('Please Enter a direction for P3','Y')
            endif
            !this.commandString.append('ori and p3 is $!dir')
            ori and p3 is $!dir
            handle any
               !!alert.error('error in Orientation command line')
                return FALSE
            elsehandle NONE
                return TRUE
            endhandle
  else
           $!command
           handle any
             !!alert.error('error in Orientation command line -($!command)')
           elsehandle NONE
                     !error = TRUE
           endhandle
       endif
   enddo

   return !error

endmethod

-------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to get any positioning commands for the current seed component
define method .getpositioncommand(!source is DBREF, !type is STRING, !spec is STRING ) is BOOLEAN

   !error = FALSE
   do !a values !this.assemblyComponent.posrules
      !command = !a.split(',')[2]
      !this.commandString.append('$!command')
      $!command
      handle any
        !!alert.error('error in Position command line -($!command)')
      elsehandle NONE
               !error =  TRUE
      endhandle
   enddo

   return !error

endmethod
-------------------------------------------------------------------------


-------------------------------------------------------------------------
-- method to get parameters for the current component.
define method .setdespars(!component is DBREF)

  !height = !component.height
  handle any
  elsehandle NONE
    height $!height
  endhandle
  !radius = !component.radius
  handle any
  elsehandle NONE
     radius $!radius
  endhandle

endmethod
-------------------------------------------------------------------------


-------------------------------------------------------------------------
-- method to build elements in both directions
define method .buildwithkey(!element is DBREF )


   -- Navigate to target item and create component
  !this.undo           = object UNDOABLE()
  !this.undo.description('Create selection copy')
  !this.undo.add()

  -- start at the


  !this.selection      = object SELECTION()
  !this.commandString = ARRAY()


  !!ce            = !this.insertElement
  if !!ce.type.eq('BRAN') then
    !spec  = !!ce.pspe.name
  else
     !spec = !!ce.spow.name
  endif

    !this.tees = ARRAY()
    !this.builtItems = ARRAY()
    -- Copy component group

   !increment = 100 / (!this.forwardsList.size() + !this.backwardsList.size())
   handle ANY
     !increment = 1
   endhandle

  -- New components
  -- !this.components     = !this.getActiveComps(!this.designItems)
  -- we have two arrays of components to copy
  -- a forwards list to be built from the key component
  -- !this.forwardsList

  -- a backwards list of components to be built first
   !!ce = !this.insertElement
   --!this.buildBackwards(!this.selection, !increment,!spec,'part')
   !this.buildMode = FALSE
   !this.buildBackwards(!this.selection, !increment,!spec,1)
    handle any
      Forwards
      return
   endhandle
   forwards
   !!ce = !this.insertElement
   !this.insertPosition = !!ce.lposition
   !this.buildMode = TRUE
   !this.buildForwards(!this.selection, !increment,!spec )

endmethod
-------------------------------------------------------------------------


-------------------------------------------------------------------------
define method .buildBackwards(!selection is SELECTION, !increment is REAL, !spec is STRING, !origin is REAL ) is REAL

  !move = FALSE
  !this.moved = FALSE

  if !origin.eq(1).or(!origin.eq(2)) then

       if !origin.eq(1) then
        !originElement        = !this.primaryOrigin
        !originPoint          = !this.primaryPoint
        !secondaryElement     = !this.secondaryOrigin
        !secondaryPoint       = !this.secondaryPoint
       else
        !originElement        = !this.secondaryOrigin
        !originPoint          = !this.secondaryPoint
        !secondaryElement     = !this.primaryOrigin
        !secondaryPoint       = !this.primaryPoint
      endif
      if !originElement.set() then
       !move = TRUE
      else
       !move = FALSE
      endif
  endif

   !!ce = !this.insertElement
    if !this.key then
        !previous = !this.backwardsList[1].owner.members[!this.backwardsList[1].order + 1]
        handle any
        	forwards
        	return
        endhandle
        !this.insertPosition = !this.insertElement.apos
    else
        !previous = object DBREF()
    endif

   !feedback = TRUE

   do !i indices !this.backwardsList
      back
      !component    = !this.backwardsList[!i]

      !this.assemblyComponent = object PIPEASSEMBLYCOMPONENT(!component)

      -- set the progress bar
      !currentProgress  = !i * !increment
      !!fmSys.setProgress(!currentProgress)

      if !i eq 1 then
        !!ce = !this.insertElement
      endif

      if !feedback then
        !this.updatetags(!component)
        !this.refreshDisplay()
      endif

      !type         = !component.type
      if !type.eq('BRAN') then
           !this.inlinebranch(!component,!previous)
           skip
      endif
      !stype        = !component.stype
      !shop         = !component.shop
      if !type.eq('REDU') then
        !this.buildreducer(!component,!i)
        handle 111
           forwards
           return error 111
        endhandle
      elseif !type inset('TEE' ,'OLET', 'VTWA') then
        !this.buildtee(!component,!type,!i)
          handle 111
          forwards
           return error 111
        endhandle
      else
         -- go and create the component
         !this.createComponent(!component,!spec,!previous,!i)
         handle 111
            -- if there is an error in selection we need to sort out what to do from here
            forwards
            return error 111
         endhandle

      endif

         if !component.eq(!this.primaryOrigin) then
            !this.newPrimary = !!ce
         elseif !component.eq(!this.secondaryOrigin) then
            !this.newSecondary = !!ce
         endif


-- orientate
        !this.orientatecomponent(!component, !i, !previous)
        handle 111
           -- if there is an error in selection we need to sort out what to do from here
           forwards
           return error 111
         endhandle

-- position
         !this.positioncomponent(!component, !i, !previous, !spec )
         handle 112
            forwards
            return error 111
         endhandle

      !this.selection.add(!!ce)
      !this.builtItems[!i] = !!ce

      if !move then
       if !component.eq(!originElement) then
          !this.movetonewposition(!originPoint,!this.insertPosition)
       endif
      endif
      if !feedback then
        !this.refreshDisplay()
      endif

      !previous = !this.backwardsList[!i]
      Forwards
    enddo
------------------------------**********************************
  !!componentCreation.component = !!ce.owner
  handle any
  endhandle
--  !!componentCreation.componentPosition = !!ce.position
  !!componentCreation.componentPosition =  n1
  handle any
  endhandle

  return 0

endmethod
-------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      buildForwards
--
-- Description: build the components at element and position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
-- This is the main building routine
define method  .buildForwards(!selection is SELECTION, !increment is REAL, !spec is STRING)

  !this.undo           = object UNDOABLE()
  !this.undo.description('Create selection copy')
  !this.undo.add()

  !feedback = TRUE
 -- we are already positioned at the insertElement
  !position = object POSITION()
  if !this.buildMode.not()then
    !this.insertPosition = !this.insertElement.lpos
    !position = !this.insertPosition
  endif

  -- Negative situation handle (Test team scenario)
  if (!this.forwardsList.size() eq 0) then
    !!alert.error('No components in this assembly')
    return
  endif

  !this.buildFromList(!this.forwardsList,!spec,0,!feedback,!position)

------------------------------**********************************
  !!componentCreation.component = !!ce.owner
  handle any
  endhandle
--  !!componentCreation.componentPosition = !!ce.position
  !!componentCreation.componentPosition =  n1
  handle any
  endhandle
  !tagItem = object DBREF()
  !this.updatetags(!tagItem)
  !this.selection.setCurrent()
  !!fmSys.setProgress(0)
  !this.undo.endUndoable()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- connect the final tail if required
define method .settail(!component is DBREF)

if !this.builtItems[!this.builtItems.size()].owner.tref.set() then
   return
endif
   -- we
-- we are at the last mem of the branch
!tcon = !component.owner.tcon
if !tcon inset ('OPEN','CLOS','VENT','DRAN') then
  tail
  conn pt to last mem
  handle any
    !!ce.tpos =  !!ce.members(!!ce.members.size()).lpos
    !!ce.tdir =  !!ce.members(!!ce.members.size()).ldir.opposite()
    !!ce.tbor =  !!ce.members(!!ce.members.size()).lbor
  endhandle
endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .markelements()

!this.markorigin()
!this.markkey()

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- place a text
define method .markorigin()

aid clear text 34567
handle any
endhandle
aid clear text 34568
handle any
endhandle
!this.refreshDisplay()

!type[1] = 'Primary'
!type[2] = 'Secondary'
do !a values !type
   if !a.eq('Primary') then
      !number = 34567
   else
      !number = 34568
   endif

   if !this.$!<a>origin.set() then
      !position = !this.$!<a>origin.pposition[!this.$!<a>point]
      handle any
        skip
      endhandle
      -- $P aid text  number $!number '$!a Origin' at $!position
      aid text  number $!number '$!a Origin' at $!position
      handle any
      endhandle
      !this.refreshDisplay()
   endif
enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- place a text
define method .markkey()

if !this.keyElement.set() then
   aid clear text 34567
   handle any
   endhandle
   !position = !this.keyElement.position
   handle any
      aid clear text 34567
   handle any
   endhandle
      return
   endhandle
   aid text  number 34567 'Key' at $!position
   handle any
   endhandle
else
    aid clear text 34567
    handle any
    endhandle
endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .updatetags(!comp is DBREF)

aid clear text 34567
handle any
endhandle
!type = !comp.type
  handle any
    aid clear text 34567
  handle any
  endhandle
  return
endhandle
if !type.eq('BRAN') then
  return
endif
!position = !comp.position
handle any
 return
endhandle
aid text  number 34567 '$!type' at $!position
handle any
endhandle

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
define method .setoriginpoints(!origin is REAL)

$(
       -- componentData method
       !this.assemblyComponent = object PIPEASSEMBLYCOMPONENT(!this.applda)
       if !this.assemblyComponent.primaryrules.set() then
          !this.primaryPoint  = !this.assemblyComponent.primaryrules[1].split(',')[2]
          !this.primaryOrigin = !this.assemblyComponent.primaryrules[1].split(',')[1].dbref()
       else
           !this.primaryPoint  =  REAL()
           !this.primaryOrigin =  object DBREF()
       endif
       if !this.assemblyComponent.secondaryrules.set() then
          !this.secondaryPoint  = !this.assemblyComponent.secondaryrules[1].split(',')[2]
          !this.secondaryOrigin = !this.assemblyComponent.secondaryrules[1].split(',')[1].dbref()
       else
          !this.secondaryPoint  = REAL()
          !this.secondaryOrigin = object DBREF()
       endif
  $)

       -- get the primary or secondary origins
       var !a coll all ddat with dkey eq 'ORIP' for $!this.dataSet
       if !a.set() then
           !this.primaryPoint = !a[1].dbref().number
           !this.primaryOrigin = !this.dataSet.lfdp.orip
       else
            !this.primaryPoint  =  REAL()
            !this.primaryOrigin =  object DBREF()
       endif

       var !b coll all ddat with dkey eq 'ORIS' for $!this.dataSet
       if !b.set() then
           !this.secondaryPoint  = !b[1].dbref().number
           !this.secondaryOrigin = !this.dataSet.lfdp.oris
       else
          !this.secondaryPoint  = REAL()
          !this.secondaryOrigin = object DBREF()
       endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .refreshDisplay
--
-- Description: Refresh display without invoking component create tracking
--
------------------------------------------------------------------------
define method .refreshDisplay()

  -- !!inassembly is a global variable used by the component creation form to suspend tracking
  !!inassembly = TRUE
  refresh
  !!inassembly.delete()

endmethod
