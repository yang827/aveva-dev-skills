--
-- Description:
--    assembly component object for handling piping assemblies in branches
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getassemblyrules()               -
--  getrules()                       -
--  initialise()                     -
--  pipeassemblycomponent(DBREF)     -
--
define object PIPEASSEMBLYCOMPONENT

  member .component             is DBREF
  member .componettype          is STRING
  member .appdataarea           is DBREF
  member .appldata              is DBREF
  member .zone                  is DBREF
  member .dataset               is DBREF
  member .styperules            is ARRAY
  member .posrules              is ARRAY
  member .orirules              is ARRAY
  member .namerules             is ARRAY
  member .selectiorules         is ARRAY
  member .specrestrictions      is ARRAY
  member .borerestrictions      is ARRAY
  member .formrules             is ARRAY
  member .funcrules             is ARRAY
  member .primaryrules          is ARRAY
  member .secondaryrules        is ARRAY
  member .selectionrules        is ARRAY
  member .lborerules            is ARRAY
  member .key                   is DBREF

endobject
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .pipeassemblycomponent(!current is DBREF)

  --!!ce = !current
  !this.component = !current
  !this.initialise()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .initialise()

  !save = !!ce

  !!ce = !this.component

   !this.appdataarea    = APPDAR
   !this.appldata       = APPLDA
   !this.zone           = ZONE
   handle any
     var !zones coll all zone for $!this.appldata
     if !zones.set() then
       !this.zone = !zones[1].dbref()
     endif
   endhandle
   !this.dataset        = DDSE1 of $!this.appldata
   handle any
     !!alert.error('Assembly Has No Design Data Set')
   endhandle
   if !this.component.type.eq('APPLDA') then
     !this.getassemblyrules()
   else
     !this.getrules()
   endif

  !!ce = !save

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
define method .getassemblyrules()

   --!specrestrictions  = ARRAY()
   --!borerestrictions  = ARRAY()
   !formrules         = ARRAY()
   !funcrules         = ARRAY()
   !primaryrules   = ARRAY()
   !secondaryrules    = ARRAY()


   var !ddats coll all ddat with match ('FUNCFORMSPECBOREORIPORIS' ,Dkey ) gt  0 for $!this.appldata


   do !a values !ddats
      !item = !a.dbref()
      var !vvals coll all vvalue for $!a
      var !texts eval validvalue for all from !vvals
      if !item.dkey.eq('FUNC') then
         do !b index !vvals
            !func = !texts[!b].replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
            break
         enddo
         !funcrules.append('FUNC' & ',' & !func & ',' & !vvals[!b])
      elseif !item.dkey.eq('FORM') then
         do !b index !vvals
            !form = !texts[!b].replace(|'|,||).replace(|(|,||,1).replace(|)|,||,-1)
            break
         enddo
         !formrules.append('FORM' & ',' & !form & ',' & !vvals[!b])
      elseif !item.dkey.eq('ORIP') then
            !porig  = !item.lfdp.orip
            !number = !item.number
            !primaryrules.append(!porig & ',' & !number & ',' & !item)
      elseif !item.dkey.eq('ORIS') then
            !sorig  = !item.lfdp.oris
            !number = !item.number
            !secondaryrules.append(!sorig & ',' & !number & ',' & !item)
     endif
   enddo

   !this.formrules         = !formrules
   !this.funcrules         = !funcrules
   !this.primaryrules      = !primaryrules
   !this.secondaryrules    = !secondaryrules
   -- !this.specrestrictions  = !specrestrictions
   --  !this.borerestrictions  = !borerestrictions

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- method to get the rules on from a dataset
define method .getrules()


   !ddats = ARRAY()
   var !tempddats coll all ddat for $!this.appldata
   if !tempddats.size().neq(0) then

     do !ddatnum from 1 to !tempddats.size()
     	
       !ddatstring = !tempddats[!ddatnum].dbref().ddpro.string()
       handle ANY
         skip
       endhandle

      !element = !ddatstring.after('ID ').before(' )')
      handle any
        skip
      endhandle
      --!dataelement = $!element
      !dataelement = !element.dbref()
      handle any
        skip
      endhandle
       if !dataelement.eq(!this.component) then
         !ddats.append(!tempddats[!ddatnum])
       endif
     enddo
   endif

   if !ddats.size().eq(0) then
     return
   endif

   !texts = ARRAY()

   !styperules        = ARRAY()
   !posrules          = ARRAY()
   !orirules          = ARRAY()
   !namerules         = ARRAY()
   !selectionrules    = ARRAY()
   !lborerules        = ARRAY()

   do !a values !ddats

      var !vvals coll all vvalue for $!a
      var !texts eval validvalue for all from !vvals
      --var !rules eval validrule for all from !vvals
      !item = !a.dbref()
      if !item.dkey.eq('STYP') then
        -- its a set of validvalues for spec and stype
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
          !stype = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
          !rule = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[3]
          handle any
            !rule = 'FALSE'
          endhandle
          !styperules.append(!spec & ',' & !stype & ',' & !rule & ',' & !vvals[!b])
        enddo
      elseif !item.dkey.eq('POSI') then
        -- its a distance command
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||)
          !posrules.append('POSI,' & !spec & ',' & !vvals[!b])
        enddo
      elseif !item.dkey .eq('ORIE') then
        --its an ori command
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||)
          !orirules.append('ORIE,' & !spec & ',' & !vvals[!b])
        enddo
      elseif !item.dkey .eq('NAME') then
        -- its a name command
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
          !stype = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
          !namerules.append(!spec& ',' & !stype & ',' & !vvals[!b])
        enddo
      elseif !item.dkey .eq('SELE') then
        -- its a name command
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
          !stype = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
          !selectionrules.append(!spec& ',' & !stype & ',' & !vvals[!b])
        enddo
      elseif !item.dkey .eq('LBOR') then
        -- its a leav bore
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
          !stype = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
          !lborerules.append(!spec & ',' & !stype & ',' & !vvals[!b])
        enddo
      elseif !item.dkey .eq('KEY') then
        -- its a key element and we need to add it in a different colour or tag it
        $(
        do !b index !vvals
          !spec  = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[1]
          !stype = !texts[!b].replace(|'|,||).replace(|(|,||).replace(|)|,||).split('%')[2]
          !lborerules.append(!spec& ',' & !stype & ',' & !vvals[!b])
        enddo
        $)
      elseif !item.dkey inset('ORIG','ORIP','ORIS') then

      else
         !!alert.error('Badly defined Data Element in Design Dataset')
         skip
      endif
   enddo

   !this.styperules        = !styperules
   !this.posrules          = !posrules
   !this.orirules          = !orirules
   !this.namerules         = !namerules
   !this.selectionrules    = !selectionrules
   !this.lborerules        = !lborerules


endmethod
------------------------------------------------------------------------
