--
--
-- Description:
--    Pipe branch information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branchID(DBREF)                  STRING              Derive the branch identifier
--  briefDescription(STRING)         STRING              Brief description of head/tail
--  detailDescription(STRING)        ARRAY               Detail description of head/tail
--  pipeBranch()                     -                   Constructor
--  pipeBranch(DBREF)                -                   Constructor
--  updateProcessData()              -                   Update process data for element
--
------------------------------------------------------------------------

define object PIPEBRANCH

  -- Branch
  member .branch          is DBREF

  -- Identifier
  member .identifier      is STRING

  -- Identifier rule
  member .idRule          is STRING
  member .idSeparator     is STRING

  -- Process information
  member .processData     is PIPINGPROCESSDATA

  -- Head information
  member .head            is BRANCHCONNECTION

  -- Tail information
  member .tail            is BRANCHCONNECTION

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipeBranch
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeBranch()

  -- Initialise Variables
  -- Rule for name -B01, -B02, etc.
  --!this.idRule      = |'B' & substring('000' & !index,-1,-2)|
  !this.idRule      = |'B' & !index|
  !this.idSeparator = '/'

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipeBranch
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element, either branch or below or only branch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeBranch(!element is DBREF)

  -- Initialise Variables
  !this.pipeBranch()
  !branch         = object DBREF()

  -- Check if element is a branch or one of its parents is a branch
  !ownerTypes     = !element.ahlist
  !ownerTypes.append(!element.type)

  -- Check for branch
  !index          = !ownerTypes.findFirst('BRAN')

  -- Get owning branch
  if(!index.set()) then
    !owners       = !element.ownLst
    !owners.append(!element)
    !branch       = !owners[!index]

  -- See if there is a branch directly beneath we can use
  else
    return
  endif

  -- Set object information
  !this.branch        = !branch

  -- Derive Branch identifier
  !this.identifier    = !this.branchID(!this.branch)

  -- Process Data
  !this.processData   = object PIPINGPROCESSDATA(!branch)

  -- Head information
  !this.head          = object BRANCHCONNECTION(!branch, 'Head')

  -- Tail information
  !this.tail          = object BRANCHCONNECTION(!branch, 'Tail')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      branchID
--
-- Description: Derive the branch identifier
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to derive identifier from
-- Return:
--   [Data Type] [Description]
--    STRING      Identifier
--
------------------------------------------------------------------------

define method .branchID(!element is DBREF) is STRING

  -- Initialise Variables
  !identifier         = STRING()

  -- If element is named, try and get identifier
  if(!element.isNamed) then
    !elementName      = !element.flnn

    -- If parent is named, try and derive identifier using this as a base
    if(!element.owner.isNamed) then
      !parentName     = !element.owner.flnn

      -- See if parents names exist in branch name
      !nIndex         = !elementName.match(!parentName)

      -- If name index > 0, then work on the assumption id is after common name
      if(!nIndex gt 0) then
        !identifier  = !elementName.substring(!nIndex + !parentName.length())
      endif

    endif

    -- If the identifier is set, derive separator and remove it
    if(!identifier.set()) then

     -- Check separator against idSeparator
      if(!identifier.substring(1,!this.idSeparator.length()) eq !this.idSeparator) then
        !identifier   = !identifier.after(!this.idSeparator)

      -- Try and derive separator and reset the definitions
     -- for speed, well assume a single character - / \ _
      else
        !chr                = !identifier.substring(1,1)
        if(!chr eq '-') then
          !this.idSeparator = '-'
        elseif (!chr eq '/') then
          !this.idSeparator = '/'
        elseif (!chr eq '_') then
          !this.idSeparator = '_'
        elseif (!chr eq '\') then
          !this.idSeparator = '\'
        endif
        !identifier         = !identifier.substring(2)
      endif

    endif

  -- End of extracting identifier
  endif

  -- Return
  return !identifier
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      briefDescription
--
-- Description: Brief description of head/tail
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Head or Tail
-- Return:
--   [Data Type] [Description]
--    STRING      Description
--
------------------------------------------------------------------------

define method .briefDescription(!end is STRING) is STRING
  return !this.attribute(!end.upcase()).briefDescription()
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      detailDescription
--
-- Description: Detail description of head/tail
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Head or Tail
-- Return:
--   [Data Type] [Description]
--    STRING      Description
--
------------------------------------------------------------------------

define method .detailDescription(!end is STRING) is ARRAY
  return !this.attribute(!end.upcase()).detailDescription()
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      updateProcessData
--
-- Description: Update process data for element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Description
--
------------------------------------------------------------------------

define method .updateProcessData()
  !this.processData.updateElement()
endmethod
-- End of object definition
