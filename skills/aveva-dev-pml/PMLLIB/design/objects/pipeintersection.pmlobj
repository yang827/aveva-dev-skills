--
-- File:            pipeintersection.pmlobj
--   Type:          Object Definition
--   Group:         Marine pack
--     Keyword:    STL
--   Module:        common
--
-- Description:
-- Find intersection of point vector with pipe geometry
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define object
define object PIPEINTERSECTION

  -- All point vector intersections: array of POINTVECTOR
  member .hitArray            is ARRAY

  -- nearest hit point vector
  member .nearestIntersection is POINTVECTOR

  -- point vector positioned at nearest hit and pointing in direction of input vector
  member .pvFromIntersection is POINTVECTOR

  -- Aid Tag
  member .aidTag              is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipeIntersection
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipeIntersection()

  -- Aid Tags
  !this.aidTag      = !!aidNumbers.add('pipeIntersection')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      intersection
--
-- Description: find intersection between point vector derived from
--              arrive/head or leave/tail of rayElement and the specified element
--              where the rayElement and element must be a piping component
--              or a branch.
--              If a hit is not found an unset point vector is returned.
--              This function will not find a hit on implied tube.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Target element
--    2   R      DBREF       Element which fires a ray at the target element
--    3   R      STRING      HEAD/ARRIVE or TAIL/LEAVE (default LEAVE)
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR   Represents the target p-point on the surface to the target element
--                  It is positioned at the intersection of the ray to the target surface
--                  It points in the direction that a P-point should point
--                  for the boss connection
--
------------------------------------------------------------------------

define method .intersection(!element is DBREF, !rayElement is DBREF, !directionOption is STRING) is POINTVECTOR

  if( badref(!rayElement) or badref(!element) ) then
    return object POINTVECTOR()
  endif

  !option = !directionOption
  if( !option inset('ARRIVE', 'HEAD') ) then
    !option = 'ARRIVE'
  else
    -- default to leave or branch tail
    !option = 'LEAVE'
  endif

  if( !rayElement.type eq 'BRAN' ) then
    -- Branch head or tail
    if( !option eq 'LEAVE' ) then
      !pv   = object POINTVECTOR(!rayElement.tPos, !rayElement.tDir)
    else
      !pv   = object POINTVECTOR(!rayElement.hPos, !rayElement.hDir)
    endif
  elseif( !rayElement.owner.type eq 'BRAN' ) then
    -- piping component arrive or leave
    if( !option eq 'LEAVE' ) then
      !pv   = object POINTVECTOR(!rayElement.pPos[!rayElement.leave], !rayElement.pDir[!rayElement.leave])
    else
      !pv   = object POINTVECTOR(!rayElement.pPos[!rayElement.arrive], !rayElement.pDir[!rayElement.arrive])
    endif
  else
    -- not a piping item
    return object POINTVECTOR()
  endif

  return !this.intersection(!element, !pv)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      intersection
--
-- Description: find intersection between given point vector and the specified
--              element which should be a piping component or a branch.
--              If a hit is not found an unset point vector is returned.
--              This function will not find a hit on implied tube.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Target element
--    2   R      POINTVECTOR  Ray fired at the target element
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR   Represents the target p-point on the surface to the target element
--                  It is positioned at the intersection of the ray to the target surface
--                  It points in the direction that a P-point should point
--                  for the boss connection
--
------------------------------------------------------------------------

define method .intersection(!element is DBREF, !pv is POINTVECTOR) is POINTVECTOR

  !return = object POINTVECTOR()
  !this.hitArray            = object ARRAY()
  !this.nearestIntersection = object POINTVECTOR()
  !this.pvFromIntersection  = object POINTVECTOR()

  if( badref(!element) or !pv.unset() ) then
    return !return
  endif

  -- find all hits on selected object
  !this.hitArray = !pv.intersections(!element, true)

  if( !this.hitArray.empty() ) then
    !this.nearestIntersection = object POINTVECTOR()
    --!!alert.warning('Ray misses pipe or hits implied tube')
  else
    -- get first hit in direction of input point vector
    !this.pvFromIntersection = !this.hitArray[1]
  endif

  return !this.pvFromIntersection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      impliedTubeIntersection
--
-- Description: find intersection between a point vector and leave tube of
--              the given piping element.
--              If a hit is not found an unset point vector is returned.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Target piping element with leave tube
--    2   R      POINTVECTOR  Ray fired at the target element leave tube
-- Return:
--   [Data Type] [Description]
--    POINTVECTOR   Represents the target p-point on the surface to the implied tube
--                  It is positioned at the intersection of the ray to the target surface
--                  It points in the direction that a P-point should point
--                  for the boss connection
--
------------------------------------------------------------------------

define method .impliedTubeIntersection(!element is DBREF, !pv is POINTVECTOR) is POINTVECTOR

  if( badref(!element) or !pv.unset() ) then
    return object POINTVECTOR()
  endif
  if( !element.owner.type neq 'BRAN' ) then
    if !element.type.eq('BRAN') then
      -- we need to deal with the hstube
     !leavePosition  = !element.hPos
     !leaveDirection = !element.hDir
     !tubingLength   = !element.ltle + 1mm
    else
     return object POINTVECTOR()
    endif
  elseif( !element.owner.type eq 'BRAN' ) then
    !leavePosition  = !element.pPos[!element.leave]
    !leaveDirection = !element.pDir[!element.leave]
    !tubingLength   = !element.ltle + 1mm
  endif

  !leaveVector = object POINTVECTOR(!leavePosition, !leaveDirection)
  if( !leaveDirection.isParallel(!pv.direction) ) then
    return object POINTVECTOR()
  endif


  -- construct plane at leave
  if !element.type.eq('BRAN') then
     !radius     = !element.phod * 0.5
  else
     !radius     = !element.pod[!element.leave] * 0.5
  endif

  if !radius.eq(0) then
     -- if the radius is zero it has no tube
     return object POINTVECTOR()
  endif

  !semiCircle = object ARC(!leavePosition, !leaveVector.plane().orientation, 0, 180, !radius, true)

  !circle     = !semiCircle.circle()
  -- map point vector onto circle plane and find intersection
  !intersectionAngles = !circle.intersections(!pv.line(1000mm))

  -- check if vector misses tube
  if( !intersectionAngles.empty() ) then
    return object POINTVECTOR()
  endif

  -- get nearest intersection to point vector start
  !intersections[1] = !circle.anglePosition(!intersectionAngles[1])
  !intersections[2] = !circle.anglePosition(!intersectionAngles[2])
  !line             = object LINE(!intersections[1], !intersections[2])
  if( !line.length() gt 0 ) then
    if( !line.direction().angle(!pv.direction.projected(!leaveVector.plane())) lt 0.01 ) then
      -- use first intersection
      !useIntersection = 1
    else
      -- use second intersection
      !useIntersection = 2
    endif
  else
    -- tangent hit on tube - use first point
    !useIntersection   = 1
  endif

  !pvTubeIntersection  = object POINTVECTOR(!intersections[!useIntersection], !leaveDirection)
  !intersectionNormal  = !circle.angleDirection(!intersectionAngles[!useIntersection])

  -- intersection on tube should be at intersection of tube intersection line and input vector
  !intersectionPos     = !pvTubeIntersection.intersection(!pv)
  handle any
    return object POINTVECTOR()
  endhandle

  -- line representing implied tube
  !leaveLine = !leaveVector.line(!tubingLength)
  -- check that intersection is with bounds of tube
  if( !leaveLine.onProjected(!intersectionPos).not() ) then
    return object POINTVECTOR()
  endif

  -- set point vector for position and direction of connection on tube surface
  !this.pvFromIntersection = object POINTVECTOR(!intersectionPos,!intersectionNormal)

  return !this.pvFromIntersection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Draw aids for the point vector representing the P-point
--              and the normal to the target element surface if set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  !!aidNumbers.hide(!this.aidTag)

  -- normal to pipe at intersection
  if( !this.nearestIntersection.set() ) then
    !pvAid = object GPHPOINTVECTOR(!this.nearestIntersection)
    !pvAid.draw(!this.aidTag, true)
  endif
  -- line from intersection to intersecting vector
  if( !this.pvFromIntersection.set() ) then
    !pvAid = object GPHPOINTVECTOR(!this.pvFromIntersection)
    !pvAid.draw(!this.aidTag, false)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !!aidNumbers.hide(!this.aidTag)

endmethod
-- End of method
