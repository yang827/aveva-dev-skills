-------------------------------------------------------------------
--
-- Method:      getRowState
--
-- Description: Return array of status words, one per row
-- Status words are as follows.
-- Before data processed:
--     VALID     New element - no errors found in input data
--     EXISTS    Existing element - no errors found in input data
--     ERROR     Error found in input data
-- After data processed:
--     SUCCESS   Row processed successfully
--     FAIL      Error occurred during processing
--              INTERFACE METHOD - used by spreadsheetImport form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array (STRING) of row status
--
------------------------------------------------------------------------

define method .getRowState() is ARRAY

  return !this.state

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: Set attribute values and catch errors
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Item name - used for error string
--    2   R      STRING      Attribute name
--    3   R      STRING      Attribute value
--    4   R      BOOLEAN     True if this is a string type attribute
-- Return:
--   [Data Type] [Description]
--    STRING      Empty if no errors. Error message if error found
--
------------------------------------------------------------------------

define method .setAttribute(!name is STRING, !attribute is STRING, !attributeValue is STRING, !stringAttribute is BOOLEAN) is STRING

  !errorReturn = ''

  -- If attribute value is empty - use existing or default value
  if(!attributeValue.empty()) then
    return ''
  endif

  -- If attribute value is 'unset' - use existing or default value
  if(!attributeValue eq 'unset') then
    return ''
  endif

  -- if attribute is Lock - ignore it - all new data is loaded unlocked - existing locked records will not be modified
  if(!attribute eq 'LOCK') then
    return ''
  endif

  -- if attribute is head or tail reference check reference given and connect
  if(!attribute eq 'TREF' or !attribute eq 'HREF') then
   !errorReturn = !this.branConnect(!name, !attributeValue, !attribute)
   return !errorReturn
  endif

  -- if bore is given check it is valid against the system bore table
  if(!attribute eq 'BORE' or !attribute eq 'HBORE' or !attribute eq 'TBORE') then
    !errorReturn = !this.boreCheck(!name, !attribute, !attributeValue)
    return !errorReturn
  endif

  if(!stringAttribute) then
--$P    $!<attribute> '$!<attributeValue>'
    $!<attribute> '$!<attributeValue>'
    handle (47,15)
      -- handle syntax error
      !errorReturn = !name + ' ( ' + !attribute + ' ) : Invalid attribute value: ' + !attributeValue
    elsehandle any
      !errorReturn = !name + ' ( ' + !attribute + ' ) : ' + !!error.text
    endhandle
  else
--$P    $!<attribute> $!<attributeValue>
    $!<attribute> $!<attributeValue>
    handle (47,15)
      -- handle syntax error
      !errorReturn = !name + ' ( ' + !attribute + ' ) : Invalid attribute value: ' + !attributeValue
    elsehandle any
      !errorReturn = !name + ' ( ' + !attribute + ' ) : ' + !!error.text
    endhandle
  endif

  return !errorReturn

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      nameCheck
--
-- Description: Normalise the name to valid string preceded by '/'
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element name with or without preceding /
-- Return:
--   [Data Type] [Description]
--    STRING      Normalise name or empty if name is invalid
--
------------------------------------------------------------------------

define method .nameCheck(!name is STRING) is STRING

  if(!name.trim().empty()) then
    return ''
  endif

  if( !name.subString(1,1) ne '/' ) then
    -- add a / for PDMS name
    !name     =  '/' + !name
  endif
  -- Check to see if name converts to a dbref
  !unusedDbRef      = !name.dbRef()
  handle(2,813)
    -- bad name
    return ''
  elsehandle any
    -- continue with new name
  endhandle

  return !name

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      ownerCheck
--
-- Description: Return data source headings as an array of strings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Owner name with or without preceding /
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of owner, or unset DBREF if owner not valid
--
------------------------------------------------------------------------

define method .ownerCheck(!ownerName is STRING) is DBREF

  -- Use CE if owner string is empty
  if( !ownerName.trim().empty() ) then
    return !!ce
  endif

  -- Find and validate owner
  !ownerName = !this.nameCheck(!ownerName)
  if( !ownerName.empty() ) then
    -- name invalid
    !ownerRef = object DBREF()
  else
    !ownerRef = object DBREF(!ownerName)
    handle any
      -- owner element not found
      !ownerRef  = object DBREF()
    endhandle
  endif

  return !ownerRef

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      typeCheck
--
-- Description: Check if given owner is valid
--              Error and status set if error found
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of owner
--    2   R      STRING      Element type
--    3   R      REAL        Index for error and status arrays
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if type check is OK
--
------------------------------------------------------------------------

define method .typeCheck(!owner is DBREF, !type is STRING, !index is REAL) is BOOLEAN

  -- owner should have been verified before this - just return and catch errors elsewhere
  if( badref(!owner) ) then
    return true
  endif

  !saveRef = !!ce
  !!ce = !owner
  !typeOK = false
  -- Have to use old syntax to test validity using DAC check
  VAR !dacOKString DACCRE $!<type>
  handle (99,532)
    -- undefined UDET
    !this.errors[!index] = 'Invalid User Defined Element Type : ' + !type
    !this.state[!index] = 'ERROR'
  elsehandle (47,15)
    -- Syntax error, which means that the type name is invalid
    !this.errors[!index] = 'Invalid element type : ' + !type
    !this.state[!index] = 'ERROR'
  elsehandle (2,220)
    -- Can't create an element of this type here
    !this.errors[!index] = 'Cannot create element of type ' + !type + ' under element ' + !owner.name
    !this.state[!index] = 'ERROR'
  elsehandle any
    -- To handle any other errors
    !this.errors[!index] = 'Cannot create element of type ' + !type + ' under element ' + !owner.name
    !this.state[!index] = 'ERROR'
  elsehandle none
    -- no error
    !dacOK = !dacOKString.boolean()
    if(!dacOK) then
      -- creation if OK
      !typeOK = true
    else
      -- creation denied by DAC
      !typeOK = false
      VAR !dacError DACERR $!<type>
      handle any
        !dacError = 'Unknown Data Access Control Error'
      endhandle
      !this.errors[!index] = 'Data access control prevents creation of element type ' + !type + ' under element ' + !owner.name + '  DAC error: ' + !dacError
      !this.state[!index] = 'ERROR'
    endif
  endhandle

  !!ce = !saveRef
  return !typeOK

endmethod
-- End of method
-------------------------------------------------------------------
--
-- Method:      boreCheck
--
-- Description: Check if given bore is valid
--              error message returned if found
--              blank string returned if bore valid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Name of current element
--    2    R      STRING     Name of attribute to set
--    3    R      STRING     Value of the attribute required
-- Return:
--   [Data Type] [Description]
--    STRING      Any error messages that are created
--
------------------------------------------------------------------------
define method .boreCheck(!name is STRING, !attribute is STRING, !attributeValue is STRING) is STRING

  !errorReturn = ''

  -- If the bore is 0 then ignore
  if(!attributeValue.real().eq(0)) then
    return ''
  endif

  !attributeValue.bore()
  handle(2,808)
    -- Error given if the value is not a valid bore, !!error.text gives details of the nearest valid bore
    !errorReturn = !name + ' ( ' + !attribute + ' ) ' + !attributeValue + '  ' + !!error.text
  endhandle

  -- Return any errors found
  return !errorReturn

endmethod
--End of Method
-------------------------------------------------------------------
--
-- Method:      branConnect
--
-- Description: connect bore to head or tail reference given
--              validation is performed before connection attempted
--              error returned if invalid, blank string returned if valid
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Name of current branch
--    2    R      STRING     Name of connection nozzle
--    3    R      STRING     Name of attribute to set
-- Return:
--   [Data Type] [Description]
--     STRING     Any error message produced
--
------------------------------------------------------------------------
define method .branConnect(!bran is STRING, !nozzle is STRING, !end is STRING) is STRING

  !errorReturn = ''

  !nozzRef = !nozzle.dbRef()
  handle(2,109)
    -- Error shows stated element doesn't exist
    !errorReturn = ' Nozzle: ' + !nozzle + ' Does not exist '
    return !errorReturn
  endhandle

  -- Checks element is valid for connection
  if(!nozzRef.type.eq(|NOZZ|)) then
    -- Checks element is not connected, unless to the given branch
    if(!nozzRef.cref.unset() or !nozzRef.cref.eq(!bran.dbRef())) then
     -- Connect the required end of the branch
     if(!end.eq('HREF')) then
       !conn = 'PHEAD'
     elseif(!end.eq('TREF')) then
       !conn = 'PTAIL'
     endif
       CONNECT $!conn TO P1 of $!nozzle
       handle any
         -- Error handler to catch anything unexpected
         !errorReturn = ' Error in connecting to: ' + !nozzle + ' Branch was not connected '
         return !errorReturn
       endhandle
    else
      !errorReturn = ' Specified Nozzle: ' + !nozzle + ' is already connected to ' + !nozzRef.cref.name
    endif
  else
    !errorReturn = ' Specified Element: '  + !nozzle + ' is not a nozzle '
  endif

  -- Return any errors found
  return !errorReturn

endmethod
--End of Method
