--
--  Description:     Object used to create pipe or pipe spool dimension on 3D view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearDimension()                 -
--  createDetailDimension(ARRAY)     -                   create detail dimension
--  drawDimension(DBREF)             -                   draw dimension
--  getDimSourceData(ARRAY)          -                   get source data for creating dimension
--  getTargetElements(DBREF)         ARRAY               get target element for creating dimension
--  pipemodeldimension()             -
--
------------------------------------------------------------------------

define object PIPEMODELDIMENSION
  member .dimSourceData     is ARRAY
  member .offsetValue       is REAL

  member .aidNumber         is REAL
  --member .isSpool           is BOOLEAN
endobject
-- End of object definition for pipemodeldimension

define method .pipemodeldimension()
  if(undefined(!!aidNumbers)) then
    !aidNumber = object AIDNUMBERS()
    !aidNumber.globalInstance()
  endif
  !this.aidNumber = !!aidNumbers.add('PipeModelDimension')
endmethod
------------------------------------------------------------------------
--
-- Method:      drawDimension
--
-- Description: draw dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawDimension(!element is DBREF)
  -- tidy aids
  aid clear all

  -- draw dimension by element type
  if (!element.type ne 'PSPOOL') then
    !branList = !!collectAllFor('BRAN','', !element)

    --collect the drawlist elements so we can check that collected items are shown
    var !drawListArray collect all from drawlist
    if !drawListArray.size().eq(0) then
      --if !drawList.eq('None') then
      !!alert.error('Drawlist is empty - No dimensions drawn')
      return
    endif
    --!drawListArray = !drawList.split()
    !drawListRefs = object ARRAY()
    do !i from 1 to !drawListArray.size()
      !drawListRefs.append(!drawListArray[!i].dbref())
    enddo

    --    !this.isSpool = true
    do !branRef values !branList

      --check that branref is in the drawList. if not then don't process
      !foundRef = !drawListRefs.find(!branRef)
      skip if !foundRef.unset()

      skip if (!branRef.owner.type ne 'PIPE')
      !dimCompList = !!collectAllFor('','', !branRef)

      !branIndex   = !dimCompList.findfirst(!branRef)
      !dimCompList.remove(!branIndex)

      !this.createDetailDimension(!dimCompList)
    enddo

  else
    !pipeSpoolManager = object PIPESPOOLMANAGER()
    !spoolComponents  = !pipeSpoolManager.getBranchElements(!element)

    !branchList  = object ARRAY()

    do !entry values !spoolComponents
      !branRef = !entry.owner

      !index = !branchList.findfirst(!branRef)
      if (!index.unset()) then
        !branchList.append(!branRef)

        !index = !branchList.size()
        !dimCompList[!index] = object ARRAY()
      endif

      !dimCompList[!index].append(!entry)
    enddo

    do !compList values !dimCompList
      !this.createDetailDimension(!compList)
    enddo

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTargetElements
--
-- Description: get target element for creating dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTargetElements(!element is DBREF) is ARRAY

  !dimComponents = object ARRAY()

  -- get components for making dimension
  if (!element.type eq 'PSPOOL') then
    -- define pipe spool manager
    !pipeSpoolManager = object PIPESPOOLMANAGER()
    !dimComponents = !pipeSpoolManager.getBranchElements(!element)
  else
    -- collect branch members
    !dimComponents = !element.members
  endif

  return !dimComponents

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDimSourceData
--
-- Description: get source data for creating dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDimSourceData(!componentList is ARRAY)
  -- clear dimension source data
  !this.dimSourceData.clear()
  !this.offsetValue = object REAL()

  !mem = !!ce

  -- change coordinate
  var !coord coord
  if(!coord eq 'XYZ')then
    coord ENU
  endif

  do !i indices !componentList
    !entry = !componentList[!i]
    !!ce = !entry

    if (!entry.type eq 'TUBI') then
      !tubeOwnerRef = !entry.name.after('tube of').dbref()

      -- get direction of tube
      !tubeLine = object LINE(!entry.apos.wrt( /* ), !entry.lpos.wrt( /* ))
      !tubeDir  = !tubeLine.direction()
      handle any
        skip
      endhandle

      !table[1] = !entry.ori.wrt( /* )
      !table[2] = !tubeDir

      -- check location of tube
      if (!tubeOwnerRef.type eq 'BRAN') then
        !table[3] = !entry.apos.wrt( /* )
        if (!tubeOwnerRef.mcount eq 0 or !componentList.size() eq 1) then
          !this.dimSourceData.append(!table)
          !table[3] = !entry.lpos.wrt( /* )
        endif

      else
        !branRef  = !entry.owner

        -- there is only tube on component list
        if (!componentList.size() eq 1 or !i eq 1) then
          !table[3] = !entry.apos.wrt( /* )
          !this.dimSourceData.append(!table)
          !table[3] = !entry.lpos.wrt( /* )
        elseif (!componentList.size() eq !i) then
          !table[3] = !entry.lpos.wrt( /* )
        endif

        -- skip if location of tube is not at last
        if (!branRef.mcount eq !tubeOwnerRef.sequ) then
          !table[3] = !entry.lpos.wrt( /* )
        endif

      endif
    else
      -- fixed 96346
      skip if (!entry.hardType inset ('PIPCA'))

      !table[1] = !entry.ori.wrt( /* )
      !table[2] = !entry.adir.wrt( /* )

      if (!componentList.size() eq 1) then
        !branRef  = !entry.owner
        !table[3] = !branRef.hpos.wrt( /* )
        !this.dimSourceData.append(!table)
        --!table[3] = !branRef.tpos.wrt( /* )
      endif

      var !p0pos p0 pos wrt /* for $!entry
      !table[3] = $!p0pos

      -- bending located on last position
      if (!entry.type inset ('BEND', 'ELBO')) then
        if (!i eq 1) then
          var !papos pa pos wrt /* for $!entry
          !table[3] = $!papos

          !this.dimSourceData.append(!table)

          !table[3] = $!p0pos

        elseif (!i eq !componentList.size()) then
          !this.dimSourceData.append(!table)

          var !plpos pl pos wrt /* for $!entry
          !table[2] = !entry.ldir.wrt( /* )
          !table[3] = $!plpos

        endif
      elseif (!entry.type inset ('REDU')) then
        --      var !papos pa pos wrt /* for $!entry
        --      !table[3] = $!papos
        --      !this.dimSourceData.append(!table)
        --
        var !plpos pl pos wrt /* for $!entry

        !this.dimSourceData.append(!table)
        !table[3] = $!plpos

      elseif (!entry.type inset ('OLET')) then
        var !papos pa pos wrt /* for $!entry

        !table[3] = $!papos

      endif
    endif
    !table[4] = !entry


    -- append dimension source data
    !this.dimSourceData.append(!table)

    -- get offset value for creating assistance line of dimension
    if (!this.offsetValue.unset()) then
      if (!entry.owner.hbore.set()) then
        !this.offsetValue = !entry.owner.hbore.real()
      else
        !this.offsetValue = !entry.lod
      endif
    endif
  enddo

  coord $!coord
  $!mem
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createDetailDimension
--
-- Description: create detail dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDetailDimension(!componentList is ARRAY)
  -- check target list
  if (!componentList.unset()) then
    return
  endif

  -- collect source data for creating dimension
  !this.getDimSourceData(!componentList)

  if (!this.dimSourceData.unset()) then
    return
  endif

  -- define aid number
--  !this.aidNumber = !!aidNumbers.add('pipeModelDimension')

  -- change coordinate
  var !coord coord
  if(!coord eq 'XYZ')then
    coord ENU
  endif

  !prevDir = ''
  !prevOrthDir = ''

  do !i from 1 to !this.dimSourceData.size() - 1
    -- get limit position for creating one dimension

    !firstPos  = !this.dimSourceData[!i][3]
    !secondPos = !this.dimSourceData[!i + 1][3]
    !firstEntry = !this.dimSourceData[!i][4]
    handle any
      skip
    endhandle

    -- get distance between limit position
    --var !distance const dist $!firstPos to $!secondPos
    !distance = !firstPos.distance(!secondPos)
    !distStr = !distance.string(!!distanceFmt)

    skip if (!distStr eq '0')

    !refDir = object DIRECTION()
    !nexEntry = nex of $!firstEntry
    handle any
      !nexEntry = object DBREF()
    endhandle


    if (!nexEntry.badref().not()) then
      if (!nexEntry.type eq 'REDU' and !nexEntry.stype eq 'ECC') then
        !refDir = !nexEntry.adir.wrt( /* )
        !epara  = !nexEntry.attribute('Prop').epar.real()
      endif
    endif

    if (!refDir.set()) then
      !tanDistance = !firstPos.distance(!secondPos)
      !distance    = sqrt(( !tanDistance * !tanDistance) - (!epara * !epara))
      handle any
      elsehandle none
        !secondPos = !firstPos.offset(!refDir.opposite(),!distance)
      endhandle
    endif

    -- define plane
    !plane = object PLANE(!firstPos,!this.dimSourceData[!i][1])
    !orthDir = !plane.direction()

    !flowLine  = object LINE(!firstPos, !secondPos)
    skip if !flowLine.length().leq(1mm)

    !flowDir   = !flowLine.direction()

    -- compare with previous direction
    if (!prevDir eq '') then
      !prevDir = !flowDir.string().before('WRT')
      !prevOrthDir = !orthDir.string().before('WRT')
    else
      if (!prevDir eq !flowDir.string().before('WRT')) then
        !orthDir = $!prevOrthDir
        handle (2,779)
          !orthDir = axis $!prevOrthDir
        endhandle
      else
        !prevOrthDir = !orthDir.string().before('WRT')
        !prevDir     = !flowDir.string().before('WRT')
      endif
    endif

    !horArrowGap   = 50mm
    !verArrowGap   = 80mm
    !aidSphereSize = 20mm

    -- define dimension position
    !dimStartPos = !firstPos.offset(!orthDir, !this.offsetValue  + !horArrowGap)
    !dimEndPos   = !secondPos.offset(!orthDir, !this.offsetValue + !horArrowGap)

    !verArrowStartPos = !firstPos.offset(!orthDir, !this.offsetValue + !verArrowGap )
    !verArrowEndPos   = !secondPos.offset(!orthDir, !this.offsetValue + !verArrowGap)

    -- define arrow direction
    !fromArrowDir = !flowDir.opposite()
    !toArrowDir   = !flowDir

    -- define horizontal arrow position
    !fromArrowPos = !dimStartPos.offset(!fromArrowDir, !horArrowGap * (-1))
    !toArrowPos   = !dimEndPos.offset(!toArrowDir, !horArrowGap * (-1))

    -- calculate mid position
    !midPoint  = !fromArrowPos.midPoint(!toArrowPos)

    --!midPoint  = !midPoint.offset(!orthDir, !aidTextLineGap)

    -- create aid arrow
    aid arrow number $!this.aidNumber at $!fromArrowPos dir $!fromArrowDir height 50mm prop 0.5
    aid arrow number $!this.aidNumber at $!toArrowPos   dir $!toArrowDir   height 50mm prop 0.5

    -- draw vertical dimension line
    aid Line num $!this.aidNumber $!firstPos  to $!verArrowStartPos
    aid Line num $!this.aidNumber $!secondPos to $!verArrowEndPos

    -- draw horizontal dimension line
    aid Line num $!this.aidNumber $!dimStartPos to $!dimEndPos

    -- draw centre dimension line & sphere at intersection position
    aid Line   num $!this.aidNumber $!firstPos to $!secondPos
    aid sphere num $!this.aidNumber $!secondPos  diam $!aidSphereSize

    -- draw dimension value
    aid text num $!this.aidNumber |$!distStr| at $!midPoint
  enddo

  coord $!coord
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createDetailDimension
--
-- Description: create detail dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearDimension()
  AID CLEAR ALL $!<this.aidNumber>
endmethod
-- End of method
