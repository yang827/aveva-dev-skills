define object PIPESETTINGS
	 member .filename is STRING
endobject

define method .pipeSettings()

  -- set file name
  !module = !!module()
  !project     = CURRENT PROJECT
  !projName    = !project.code()
  !user = '%PDMSUSER%'
	!this.filename = !user + '/'  + !module.appKey + '-' + !projName+ '-pipesettings.pmldat'

endmethod

define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

	-- store the current units
  !currentUnits = object COMUNITS()
  !distUnit     = !currentUnits.getCurrentUnitsByPtype('DIST')
  !boreUnit     = !currentUnits.getCurrentUnitsByPtype('BORE')

  -- check for tube tolerance
	var !tol tol tube
	if !tol.set() then
		!tubeSettings = !tol.split()
		if(!tubeSettings.size() gt 0) then
		  !saveContents.append('tol tube ' + !tubeSettings[1])
		
		  do !i from 2 to (!tubeSettings.size() - 2) by 3
		  	!saveContents.append('tol tube bore ' + !tubeSettings[!i + 2]  + ' ' + !tubeSettings[!i + 1] +  ' ' + !tubeSettings[!i] )
			enddo
		endif
	endif
	
  -- check for offset tolerance
	var !tol tol angle
	if !tol.set() then
		  !saveContents.append('tol angle ' + !tol)
	endif
	
  -- check for offset tolerance
	var !tol tol offset
	if !tol.set() then
		  !saveContents.append('tol offset ' + !tol )
	endif
	
  -- check for maximum angle tolerance
	var !tol tol maxangle
	if !tol.set() then
		  !saveContents.append('tol maxangle ' + !tol)
	endif
	
  -- check for maximum ratio tolerance
	var !tol tol ratio
	if !tol.set() then
		  !saveContents.append('tol ratio ' + !tol)
	endif
	
  -- check for maximum atta checking
	var !tol tol attac
	if !tol.set() then
		  if (!tol.occurs(' ON') gt 0) then
		  	!saveContents.append('tol attac on')
			else
				!saveContents.append('tol attac on')
			endif
	endif

	if !saveContents.set() then
		!!writeFile(!this.filename, 'OVERWRITE', !saveContents)
	endif
endmethod

define method .load()

  !!runMacro(!this.filename, '')

	handle ANY
	endhandle
	
endmethod
