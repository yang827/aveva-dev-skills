--  Description:     Object used to pipe easy editor
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoRoute(ARRAY)                 -                   simple auto route
--  checkBranConnection(DBREF,DBREF) -                   check branch connection
--  copyBranch(DBREF,DBREF,STRING,REAL) -                   copy an existing branch
--  createComponent(STRING,STRING,BOOLEAN,ANY) BOOLEAN             create component
--  createNewBranch()                -                   create new branch
--  drawBranch(ARRAY,BOOLEAN,BOOLEAN) -                   draw branch
--  getAdjacentElement(DBREF)        DBREF               get adjacent element
--  getConnectedEqui(DBREF,STRING)   DBREF               get connected equipment
--  getConnectionType(STRING)        ARRAY               get connection type
--  getNewBranchName(PIPEBRANCH)     STRING              get branch name for new branch
--  getPipeBranList()                -                   get pipe branch list
--  insertExpansion(ARRAY,ARRAY,BOOLEAN,BOOLEAN) -                   insert selection
--  insertFittingSet(POSITION,STRING) -                   insert flange set
--  insertSelection(ARRAY,DBREF,STRING,REAL) -                   insert selection
--  pipesimpleeditor()               -                   Constructor
--  selectionMirror(ARRAY,STRING,POSITION) -                   selection mirror
--  setDefault()                     -                   initialise member variables
--  updateBranchConnection(STRING,STRING,DBREF) -                   update branch connection
--

------------------------------------------------------------------------
define object PIPESIMPLEEDITOR
  -- stypes for fitting
  member .flgStyp      is STRING
  member .gskStyp      is STRING
  member .valveStyp    is STRING
  member .elboStyp     is STRING
  member .teeStyp      is STRING
  member .reduStyp     is STRING

  -- start / end position of branch
  member .branStartPos is POSITION
  member .branEndPos   is POSITION

  -- head / tail direction of branch
  member .branHeadDir  is DIRECTION
  member .branTailDir  is DIRECTION

  member .connHeadType is STRING
  member .connTailType is STRING

  -- existBranList below specified pipe
  member .existBranList is ARRAY

  -- head / tail reference of branch
  member .branHeadRef   is DBREF
  member .branTailRef   is DBREF

  -- Pipe Process Information
  member .branchData    is PIPEBRANCH

  -- coco table list
  member .cocoList      is ARRAY

  -- mode for quick routing
  member .isQuickRoute  is BOOLEAN
endobject
-- End of object definition for PIPESIMPLEMODIFY

------------------------------------------------------------------------
--
-- Method:      PIPESIMPLEEDITOR
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipesimpleeditor()
  -- load coco table for checking head and tail connection of a new branch
  var !cocos collect all COCO
  !this.cocoList.clear()

  do !coco values !cocos
    !this.cocoList.appendArray(!coco.dbref().ctype)
  enddo

  -- initialise default setting.
  !this.setDefault()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDefault
--
-- Description: initialise member variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefault()
  --  initialize fitting stype
  !this.flgStyp     = ''
  !this.gskStyp     = ''
  !this.valveStyp   = ''
  !this.elboStyp    = ''
  !this.teeStyp     = ''
  !this.reduStyp    = ''

  !this.connHeadType = ''
  !this.connTailType = ''

  -- initialise head / tail reference of branch
  !this.branHeadRef        = object DBREF()
  !this.branTailRef        = object DBREF()

--  -- load pipe creation form for autonaming one branch
--  if (undefined(!!pipeCreation)) then
--    pml reload form !!pipeCreation
--  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertFlangeSet
--
-- Description: insert flange set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    POSITION    insert position
--    2     R    POSITION    inserting assembly type
--                           * Flange Set. : Flange + Gasket + Flange
--                           * Valve  Set. : Flange + Gasket + Valve + Gasket + Flange
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertFittingSet(!insertPos is POSITION, !type is STRING)
  if (!this.createComponent('FLAN', !this.flgStyp, true, !insertPos).not()) then
    return
  endif

  if (!this.createComponent('GASK', !this.gskStyp, true, false).not()) then
    return
  endif

  if (!type eq 'VALVE_SET') then
     if (!this.createComponent('VALVE', !this.valveStyp, true, false).not()) then
      return
    endif

    if (!this.createComponent('GASK', !this.gskStyp, true, false).not()) then
      return
    endif
  endif

  if (!this.createComponent('FLAN', !this.flgStyp, true,false).not()) then
    return
  endif

  select lstu
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createComponent
--
-- Description: create component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     component type
--    2     R    STRING     component stype
--    3     R    BOOLEAN    connect flag ( if it's true, created component will be connected with previous element)
--    4     R    ANY        reference for inserting position
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return creating component status
--
------------------------------------------------------------------------
define method .createComponent(!compType is STRING, !styp is STRING, !isConnect is BOOLEAN, !insertPosRef is ANY) is BOOLEAN

  --store the previous component details for error handling purposes
  !currentComponent = !!ce

  -- set condition for creation new component
  if (!styp.unset() or !styp eq '') then
    !condition = ||
  else
    !condition = |with styp '$!styp'|
  endif

  new $!compType choose all $!condition
  handle (61,164)
    delete $!compType

    --prepare the error string
    if !compType.eq('FLAN') then
      !errorText = 'flange'
    elseif !compType.eq('ELBO') then
      !errorText = 'elbow'
    elseif !compType.eq('BEND') then
      !errorText = 'bend'
    elseif !compType.eq('REDU') then
      !errorText = 'reducer'
    elseif !compType.eq('TEE') then
      !errorText = 'tee'
    elseif !compType.eq('VALV') then
      !errorText = 'valve'
    elseif !compType.eq('GASK') then
      !errorText = 'gasket'
    endif
    !previousComp = !currentComponent.flnm
    !!alert.error('Specification does not contain a valid $!errorText with styp $!styp that will connect to $!previousComp' )
    return false

  elsehandle any
    delete $!compType
    handle any
      !!alert.error(!!error.text)
    endhandle
    return false
  endhandle

  -- stype will be defined if it is unset
  if (!styp eq '') then
    !styp = stype
  endif

  if !compType.eq('BEND') then
   !rad = !!ce.radius
   if !rad.eq( 0 ) then
     !rad = !!ce.dfbrad
     handle ANY
       !od = !!ce.plod
       !rad = 3 * !od
     endhandle
   endif
   radius $!rad
  endif

  !result = true

  if (!isConnect) then
    conn
    handle (7,3)
      if (!!alert.confirm('Cannot connect component. Do you want to force connect?').boolean())then
        fconn
      else
        !result = false
      endif
    elsehandle any
      !result = false
    endhandle
  endif

  -- move component to insert position
  if (!insertPosRef.objectType() eq |POSITION| and !result eq TRUE) then
    thro $!insertPosRef
  endif

  -- it will be deleted new component if user want to skip.
  if (!result.not()) then
    delete $!compType
    handle any
    endhandle
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawBranch
--
-- Description: draw branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      vertex list
--    2     R    BOOLEAN    insert flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawBranch(!vertexList is ARRAY, !isInsert is BOOLEAN, !bendChoice is BOOLEAN)

  !vertexPointList = !vertexList[1]
  !vertexDirList   = !vertexList[2]

  -- remove waste data
  !vertexPointList.remove(1)
  !vertexDirList.remove(1)

  var !mode mode

  forward
  if !bendChoice then
     !elboType = 'BEND'
  else
     !elboType = 'ELBO'
  endif


  -- Tee will be created if insert mode
  -- it means that there is intersection position between aid line and selected tube)
  if (!isInsert) then
    if (!this.createComponent('TEE', !this.teeStyp, true, !this.branStartPos).not()) then
      !this.setDefault()
      $!mode
      return
    endif

    -- adjust dir and p3 of tee
    dir and p3 is $!this.branHeadDir
    handle ANY
      !!alert.error('Cannot Orientate TEE correctly with passed positions - Branch aborted.')
      $!mode
      delete tee
      return
    endhandle

    !tee = !!ce

    -- p3 pos will be used to start position of a new branch
    var !p3pos pos p3 of $!tee wrt /*
    !this.branStartPos = object POSITION(!p3pos)

    -- p3 bore will be used to bore size of a new branch
    var !p3bore p3 bore of $!tee
  endif

  !this.createNewBranch()


  -- head reference set if there is tee connection.
  if (!isInsert) then
    !tee.cref = !!ce
    href $!tee
  endif

  -- change bore size
  if (defined(!p3bore)) then
    !bore = object BORE(!p3bore)
    hbore $!bore
    tbore $!bore
  endif


  SELECT HSTU
  handle ANY
    bran delete bran
    return
  endhandle



  -- change head connection type of branch with temporary.
  hconn open

  !firstMember = object DBREF()
  !lastMember  = object DBREF()

  -- A flange will be created if there is no intersection point between aid line and selected tube
  if (!isInsert.not()) then
    if (!this.createComponent('FLAN', !this.flgStyp, true, !this.branStartPos).not()) then
      !this.setDefault()
      $!mode
      bran delete bran
      return
    endif

    !firstMember = !!ce

    !this.flgStyp = styp

    -- adjust flange origin
    var !pa pos pa wrt /* for ce
    var !p2 pos p2 wrt /* for ce

    if (!pa eq !p2) then
      flip ori
    endif
  endif

  !prevDir = object DIRECTION()

  -- make other components using by vertex point and directions
  do !i indices !vertexPointList
    !insertPos = !vertexPointList[!i]
    !insertDir = !vertexDirList[!i]

    if (!i gt 1) then
      skip if (!prevDir eq !insertDir)
    endif

    if (!i lt !vertexPointList.size()) then
      if (!this.createComponent(!elboType, !this.elboStyp, true, !insertPos).not()) then
        !this.setDefault()
        $!mode
        return
      endif

      if (!firstMember.unset()) then
        !firstMember = !!ce
      endif

    else

      -- check bore size between head and tail bore of source branch
      -- Reducer will be created if it's different.
      if (!this.branchData.branch.hbore ne !this.branchData.branch.tbore) then
        if (!this.createComponent('REDU', !this.reduStyp, true, false).not()) then
          !this.setDefault()
          $!mode
          return
        endif
      endif

      if (!this.createComponent('FLAN', !this.flgStyp, true, !insertPos).not()) then
        !this.setDefault()
        $!mode
        return
      endif

      !lastMember = !!ce
    endif

    !prevDir = !vertexDirList[!i]

    dir   $!insertDir
    handle any
    endhandle

    SELECT LSTU
  enddo

  -- check and fix the head and tail connection of branch
  !this.checkBranConnection(!firstMember, !lastMember)

  -- hconn be changed if inserting mode
  -- * insert mode : there is intersection point between source branch and aid line
  if (!isInsert) then
    bran
    hconn BWD
    same
  endif

  -- The tail direction of branch will be changed if current is quick route mode.
  if (!this.isQuickRoute) then
    !!ce = !lastMember
    delete flan

    bran
    tdir $!this.branHeadDir

    !modelEditor = object STATE()
    !modelEditor.modifymode(true)
    return
  endif

  !this.setDefault()

  $!mode


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkBranConnection
--
-- Description: check branch connection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF      first component on created branch
--    2     R    DBREF      last  component on created branch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkBranConnection(!firstComponent is DBREF, !lastComponent is DBREF)
  -- move to branch element
  BRAN
  conn pt to last mem

  var !branMembers  coll all bran mem for ce

  !startElement = object DBREF(!branMembers[1])
  !endElement   = object DBREF(!branMembers.last())

  if (!firstComponent.badref()) then
    !firstComponent = !lastComponent
  endif

  if (!firstComponent.badref().not()) then
    !this.updateBranchConnection('HEAD', !firstComponent.aconn, !startElement)
  endif

  if (!lastComponent.badref().not()) then
    !this.updateBranchConnection('TAIL', !lastComponent.lconn,  !endElement)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBranchConnection
--
-- Description: update branch connection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     checking part type between head and tail
--    2     R    STRING     connection type on component
--    2     R    DBREF      source element

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateBranchConnection(!partType is STRING, !connectionType is STRING, !sourceElement is DBREF)
  !connectionTypes = !this.getConnectionType(!connectionType)

  do !connType values !connectionTypes
    if (!partType.upcase() eq 'HEAD') then
      hconn $!connType
    else
      tconn $!connType
    endif

    CHECK ce !unusedElementList !errorList
    do !i indices !errorList
      !error        = !errorList[!i].split()
      !errorNumbers = object ARRAY()
      do !j indices !error
        !errorNumbers.append(!error[!j])
      enddo

      !errorNumbers.unique()

      if (!partType.upcase() eq 'HEAD') then
        !inValidConnection = !errorList inset ('80', '41','72')
      else
        !inValidConnection = !errorList inset ('53', '49','72')
      endif

      break if (!inValidConnection.not())

    enddo

    break if (!connType ne 'unset')
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getConnectionType
--
-- Description: get connection type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     source connection type
-- Return:
--   [Data Type] [Description]
--    1     R    ARRAY      return reference coco table which be related to source connection type
--
------------------------------------------------------------------------
define method .getConnectionType(!sourceConnectionType is STRING) is ARRAY
  if (!sourceConnectionType.empty()) then
    return
  endif

  !result[1] = 'unset'
  if (!this.cocoList.unset()) then
    return !result
  endif

  -- compare source connection type with coco table
  !connectionIndexList  = !this.cocoList.find(!sourceConnectionType)
  do !index values !connectionIndexList
    -- fixed SI #57314 (TFS defect 96677)
    !connectionType = !this.cocoList[!index + 1]
    handle (2,752)
      skip
    endhandle

    skip if(!connectionType eq 'ATT')

    !result.append(!connectionType)
  enddo

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertSelection
--
-- Description: insert selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      selected element list
--    2     R    DBREF      destination element
--    3     R    STRING     direction for moving after copying selected element
--    4     R    REAL       distance for moving after copying selected element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertSelection(!selectedElementList is ARRAY,!insertElement is DBREF, !moveDir is STRING, !moveDist is REAL)
  !branchList  = object ARRAY()
  !newBranchList = object ARRAY()
  var !mode mode
  forward
  !newComponents = ARRAY()
  !oldComponents = ARRAY()
  !hRefs = ARRAY()
  !tRefs  = ARRAY()
  -- selectedElementList looks like this
  --  '/MAIN_01-/B1 0028 =24170/1092'
  --  '/MAIN_01/B4 0001 =24170/1137'
  --  '/MAIN_01/B4 0002 =24170/1138'

  !!ce = !insertElement
  !branchList.append(!insertElement.owner)
  do !i indices !selectedElementList
    !branch      = !selectedElementList[!i].part(1).dbref()
    if !i eq(1) then
       !branchList.append(!branch)
    endif
    !entry     = !selectedElementList[!i].part(3).dbref()
    !oldComponents.append(!entry)
    !entryType = !entry.type

    !teeConnRef = object DBREF()
    !teeRef     = object DBREF()

 -- when do we need to create another branch?
 if (!branchList.findfirst(!branch).unset()) then
   -- if we cant find the owning branch in the list of branches so we need to create a new one
   !hRefs.append(!branch.href)
   !tRefs.append(!branch.tref)

   !hpos = !branch.hpos.wrt( /* )
   !tpos = !branch.tpos.wrt( /* )

   !offsetDir = object DIRECTION(!moveDir)

   !newHpos = !hpos.offset(!offsetDir, !moveDist)
   !newTpos = !tpos.offset(!offsetDir, !moveDist)

   new bran copy like $!branch

   hpos $!newHpos
   tpos $!newTpos
   hdir $!branch.hdir
   handle ANY
   endhandle
   tdir $!branch.tdir
   handle ANY
   endhandle

   -- change name with auto naming rule
   !this.getPipeBranList()

   !branchName = !this.getNewBranchName(!this.existBranList.last())
   if(!branchName.set()) then
     NAME $!<branchName>
   endif

   !branchList.append(!branch)
   !newBranchList.append(!!ce)

   hconn $!branch.hconn
   tconn $!branch.tconn
 endif


    -- create component
    new $!entryType copy $!entry
    !newComponents.append(!!ce)

    move $!moveDir dist $!moveDist

    if (!entryType inset ('TEE','OLET')) then
      !teeConnRef = !entry
      !teeRef     = !!ce
      ori and p3 is p3 of $!entry
      handle ANY
       ori
      endhandle
    endif

  enddo

  -- we have now got a list of new components and new branches
  -- currently the new branch has its href and tref set to what was before
  !this.resetHeadTail(!newComponents,!oldComponents,!newBranchList,!hRefs,!tRefs)
  !mem = !!ce
  !this.setDefault()

  $!mem
  $!mode
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetHeadTail
--
-- Description: check and fix head or tail reference on new branch if there's missing connection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      compare new list
--    2     R    ARRAY      compare old list
--    3     R    ARRAY      old branch list
--    4     R    ARRAY      old hRefs
--    5     R    ARRAY      old tRefs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method to reset the head and tail of copied components
 define method .resetHeadTail(!newComponents is ARRAY ,!oldComponents is ARRAY ,!branchList is ARRAY,!hRefs is ARRAY ,!tRefs is ARRAY )

 do !a index !branchList
   !index = !oldComponents.findfirst(!hRefs[!a])
   if !index.set() then
     !branchList[!a].href = !newComponents[!index]
     !newComponents[!index].cref = !branchList[!a]
     !branchList[!a].hdir = !newComponents[!index].pdir[3].wrt(/* )
   endif
   !index = !oldComponents.findfirst(!tRefs[!a])
   if !index.set() then
     !branchList[!a].tref = !newComponents[!index]
     !newComponents[!index].cref = !branchList[!a]
     !branchList[!a].tdir = !newComponents[!index].pdir[3].wrt(/* )
   endif
 enddo

 endmethod

------------------------------------------------------------------------
--
-- Method:      insertExpansion
--
-- Description: insert selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      vertex point list
--    2     R    ARRAY      vertex direction list
--    3     R    BOOLEAN    flag for inserting bypass line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertExpansion(!vertexPointList is ARRAY, !vertexDirs is ARRAY, !insertByPassFlag is BOOLEAN,!bendChoice is BOOLEAN)

  var !mode mode

  forward
  if !bendChoice then
     !elboType = 'BEND'
  else
     !elboType = 'ELBO'
  endif

  -- create by-pass line
  if (!insertByPassFlag) then
    !firstTeePos = !vertexPointList[1]
    !lastTeePos  = !vertexPointList.last()

    !firstTeeDir  = !vertexDirs[1]
    !tmpVertexDir = object DIRECTION(!vertexDirs[!vertexDirs.size() - 1])
    !lastTeeDir  = !tmpVertexDir.opposite()

    if (!this.createComponent('TEE', !this.teeStyp, true, !firstTeePos).not()) then
      !this.setDefault()
      $!mode
      return
    endif

    dir and p3 is $!firstTeeDir
    handle any
      !!alert.error('Please check Tee Spec.')
      delete tee
      $!mode
      return
    endhandle
    !firstTeeEntry = !!ce

    --!this.createComponent('TEE', !teeStyp, true)
    new tee copy prev
    thro $!lastTeePos
    dir and p3 is $!lastTeeDir
    !lastTeeEntry = !!ce

    !this.getPipeBranList()

    new bran copy like $!this.branchData.branch

    !branchName = !this.getNewBranchName(!this.existBranList.last())
    if(!branchName.set()) then
      NAME $!<branchName>
    endif

    href $!firstTeeEntry
    tref $!lastTeeEntry

    conn ph to href
    handle(42,64)
      -- No Tubing in Spec
      !!alert.warning('Unable to select tubing from the Pipe Specification')
    elsehandle ANY
      !!alert.warning(!!error.text.after(') '))
    endhandle
    conn pt to tref

    !vertexPointList.remove(1)
    !vertexDirs.remove(1)

    !vertexPointList.remove(!vertexPointList.size())
    !vertexDirs.remove(!vertexDirs.size())
  endif


 -- create loop-line
 do !i indices !vertexPointList

    if (!i eq 1) then
      if (!this.createComponent(!elboType, !this.elboStyp, true, !vertexPointList[!i]).not()) then
        !this.setDefault()
        $!mode
        return
      endif
    else
      new $!elboType copy prev
      thro $!vertexPointList[$!i]


    endif

    dir $!vertexDirs[$!i]
    handle any
      !!alert.error('Please check Aid Line')
      $!mode
      undodb
      !this.setDefault()
      return
    endhandle
  enddo

  !this.setDefault()
  $!mode
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoRoute
--
-- Description: simple auto route
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      position list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoRoute(!posList is ARRAY)
  !this.createNewBranch()

  !!ss = !posList
  !!pipeSimpleAutoRoute(!!ce, !posList)
  !this.setDefault()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectionMirror
--
-- Description: selection mirror
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       selected element list
--    2     R    STRING      mirror direction
--    3     R    POSITION    mirror position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectionMirror(!selectedEntryList is ARRAY, !mirrorDir is STRING, !throughPosition is POSITION)

  !branches = ARRAY()
  !htdist = ARRAY()
  !htelem = ARRAY()
  !pct = !selectedEntryList.size()

  !same = !!ce

  -- loop through selected component to store head/tail relative position to first/last component
  do !c indices !selectedEntryList
    !entry = !selectedEntryList[!c]
    !type = !entry.type
    !mtbe = !entry.mtbe
    !mten = !entry.mten
    if !type.eq('TUBI') then
      !selectedEntryList[!c].delete()
      if !mtbe.type.eq('BRAN') then
      -- implied tube from HEAD
        if !branches.find(!mtbe).unset() then
          !branches.append(!mtbe)
        endif
        !index = !branches.findfirst(!mtbe)
        !htdist[!index][1] = !entry.itle
        !htelem[!index][1] = !mten
      elseif !mten.type.eq('BRAN') then
      -- implied tube from last component to TAIL
        if !branches.find(!mten).unset() then
          !branches.append(!mten)
        endif
        !index = !branches.findfirst(!mten)
        !htdist[!index][2] = !entry.itle
        !htelem[!index][2] = !mtbe
      endif
    endif
  enddo

  -- loop through selected components to mirror them
  do !c indices !selectedEntryList
    !!fmsys.setProgress(!c / !pct * 100)
    !entry = !selectedEntryList[!c]
    !type = !entry.type
    !owne = !entry.owne
    if  !entry.sequ.eq(1).and(!owne.texist.not()) then
    -- first component is connected to HEAD
      if !branches.find(!owne).unset() then
        !branches.append(!owne)
      endif
      !index = !branches.findfirst(!owne)
      !htdist[!index][1] = 0
      !htelem[!index][1] = !entry
    elseif !entry.sequ.eq(!owne.mcoun).and(!entry.texist.not()) then
    -- last component is connected to TAIL
      if !branches.find(!owne).unset() then
        !branches.append(!owne)
      endif
      !index = !branches.findfirst(!owne)
      !htdist[!index][2] = 0
      !htelem[!index][2] = !entry
    endif

    !!ce = !entry
    mirror plane $!mirrorDir wrt worl through $!throughPosition
    if !entry.apos.distance(!entry.lpos).eq(0) then
      skip
    endif
    if (!type inset ('TEE','OLET')) then
      !adjacent  = !this.getAdjacentElement(!entry)
      if !adjacent.type.neq('BRAN') then
        if !adjacent.ldir.wrt(world).neq(!entry.ldir.wrt(world)) then
          flip
        endif
      endif
    endif
  enddo
!!htdist = !htdist
!!htelem = !htelem

  !!fmsys.setProgress(0)

  -- mirror HEAD/TAIL properties
  do !c indices !branches
    !bran = !branches[!c]
    if defined(!htelem[!c][1]) then
    -- HEAD
      !elem = !htelem[!c][1]
      !dist = !htdist[!c][1]
      !bran.hpos = !elem.apos.offset(!elem.adir,!dist)
      !bran.hdir = !elem.adir.opposite()
    endif
    if defined(!htelem[!c][2]) then
    -- TAIL
      !elem = !htelem[!c][2]
      !dist = !htdist[!c][2]
      !bran.tpos = !elem.lpos.offset(!elem.ldir,!dist)
      !bran.tdir = !elem.ldir.opposite()
    endif
  enddo

  -- mirror connected equipment if any
  do !c indices !branches
    !bran = !branches[!c]
    if defined(!htelem[!c][1]) then
      !equi = !this.getConnectedEqui(!bran,'head')
      if !equi.set() then
        !!ce = !equi
        mirror plane $!mirrorDir wrt worl through $!throughPosition
        handle ANY
          !!alert.error(!!error.text)
        endhandle
      endif
    endif
    if defined(!htelem[!c][2]) then
      !equi = !this.getConnectedEqui(!bran,'tail')
      if !equi.set() then
        !!ce = !equi
        mirror plane $!mirrorDir wrt worl through $!throughPosition
        handle ANY
          !!alert.error(!!error.text)
        endhandle
      endif
    endif
  enddo

  !!ce = !same

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getConnectedEqui
--
-- Description: get connected equipment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF       source branch element
--    2     R    STRING      head or tail
-- Return:
--   [Data Type] [Description]
--    1     R    DBREF       connected equipment
--
------------------------------------------------------------------------
define method .getConnectedEqui(!bran is DBREF,!end is STRING) is DBREF

  !nozz = !bran.attribute(!end)
  if !nozz.badref() then
    return nulref
  endif

  if !nozz.type.neq('NOZZ') then
    return nulref
  endif

  !equi = object DBREF('EQUI of ' & !nozz)
  !col = !!gphColOpt.highlight.name
  add $!equi
  enhance $!equi colour $!col
  if !!alert.confirm('Do you want to mirror connected ' & !equi.namety & ' highlighted in ' & !col & '?').boolean().not() then
    unenhance $!equi
    !equi = nulref
  else
    unenhance $!equi
  endif

  return !equi

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getAdjacentElement
--
-- Description: get adjacent element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF       source element
-- Return:
--   [Data Type] [Description]
--    1     R    DBREF       return adjacent element from source element
--
------------------------------------------------------------------------
define method .getAdjacentElement(!sourceElement is DBREF) is DBREF
  -- get adjacent element
  !adjacentElement = prev of $!sourceElement
  handle any
    !adjacentElement = nex of $!sourceElement
    handle any
      !adjacentElement = !sourceElement.owner
    endhandle
  endhandle

  return !adjacentElement
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createNewBranch
--
-- Description: create new branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewBranch()
  -- get pipe branch list for auto naming
  !this.getPipeBranList()

  new bran copy like $!this.branchData.branch

  !branchName = !this.getNewBranchName(!this.existBranList.last())
  if(!branchName.set()) then
    NAME $!<branchName>
  endif

  hdir $!this.branHeadDir
  tdir $!this.branTailDir

  -- tail direction will be changed if current is quick route mode
  if (!this.isQuickRoute) then
    tdir $!this.branHeadDir
  else
    tdir $!this.branTailDir
  endif

  if (!this.branHeadRef.badref().not()) then
    if (!this.connHeadType.empty().not()) then
      CONNECT PH TO $!this.connHeadType of $!this.branHeadRef
    else
      CONNECT PH TO $!this.branHeadRef
    endif
  else
    hpos $!this.branStartPos
  endif

  if (!this.branTailRef.badref().not()) then
    if (!this.connTailType.empty().not()) then
      CONNECT PT TO $!this.connTailType of $!this.branTailRef
    else
      CONNECT PT TO $!this.branTailRef
    endif
  else
    tpos $!this.branEndPos
  endif

  hbore $!this.branchData.branch.hbore
  tbore $!this.branchData.branch.hbore

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPipeBranList
--
-- Description: get pipe branch list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPipeBranList()
  pipe

  var !branchList coll all BRAN for ce
  !this.existBranList.clear()

  do !branch values !branchList
    !this.existBranList.append(object PIPEBRANCH(!branch.dbref()))
  enddo

  same
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getNewBranchName
--
-- Description: get branch name for new branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PIPEBRANCH  Pipe branch data
-- Return:
--   [Data Type] [Description]
--    STRING      Name of branch
--
------------------------------------------------------------------------
define method .getNewBranchName(!branchData is PIPEBRANCH) is STRING

  -- Initialise Variables
  !name       = STRING()
  !separator  = !branchData.idSeparator
  !rule       = !branchData.idRule

  -- If pipe is named
  if(!branchData.branch.owner.isNamed) then
    !nameRoot = !branchData.branch.owner.name

    do !index from 1 to !branchData.branch.owner.mCount + 1
      !name   = !nameRoot & !separator & $!<rule>

      -- Check to see if names exists
      !unusedX = (ID $!<name> )
      handle ANY
        break
      endhandle
    enddo
  endif

  return !name

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyBranch()
--
-- Description: copy an existing branch
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Name of branch
--
------------------------------------------------------------------------
define method .copyBranch(!branchName is DBREF,!insertElement is DBREF, !moveDirection is STRING, !moveDistance is REAL)

   !!ce = !insertElement
   -- change name with auto naming rule
   !this.getPipeBranList()

   NEW BRAN COPY $!branchName

   !newName = !this.getNewBranchName(!this.existBranList.last())
   if(!newName.set()) then
     NAME $!<newName>
   endif

   DELETE BRAN MEM
   move ph $!moveDirection dist $!moveDistance
   move pt $!moveDirection dist $!moveDistance

endmethod
