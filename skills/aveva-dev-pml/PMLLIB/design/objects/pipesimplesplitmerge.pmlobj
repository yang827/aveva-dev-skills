------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getBranchElement(DBREF)          DBREF               get branch element
--  getTargetElements(DBREF)         -                   get target elements for splitting
--  merge(EDGPICKDATA,EDGPICKDATA)   -                   merge elements on pipe / branch level
--  pickStart(STRING,STRING)         -                   pick start for splitting or merging elements on pipe / branch level
--  split(EDGPICKDATA)               -                   split elements on pipe / branch level
--
------------------------------------------------------------------------

define object PIPESIMPLESPLITMERGE
  member .level         is STRING
  member .sourceList    is ARRAY
endobject
-- End of object definition for PIPESPLITMERGE

------------------------------------------------------------------------
--
-- Method:      pickStart
--
-- Description: pick start for splitting or merging elements on pipe / branch level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickStart(!level is STRING, !mode is STRING)
  !this.level = !level.upcase()

  -- Define event packet
  !packet           = object EDGPACKET()
  !packet.priority  = 2
  !packet.remove    = true

  if (!mode.upcase() eq 'SPLIT') then
    !prompt        = 'Pick Base Element For Splitting'
    !packet.action = '!!pipeSimpleSplitMerge.split(!this.return[1])'
    !packet.pickpacket.stdElement(!prompt)
  else
    !packet.pickpacket.picks[1] = object EDGPICKTYPE()
    !packet.pickpacket.picks[1].pick.input[3]   = '((type of owner) eq |BRAN|)'
    !packet.pickpacket.picks[1].stdElement('Pick source element')
    !packet.pickpacket.picks[1].pick.modifiable = false

    !packet.pickpacket.picks[2] = object EDGPICKTYPE()
    !packet.pickpacket.picks[2].pick.input[3]   = '((type of owner) eq |BRAN|)'
    !packet.pickpacket.picks[2].stdElement('Pick target element')
    !packet.pickpacket.picks[2].pick.modifiable = false

    !packet.action = '!!pipeSimpleSplitMerge.merge(!this.return[1][1],!this.return[1][2])'
  endif

  !!edgcntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      split
--
-- Description: split elements on pipe / branch level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .split(!data is  EDGPICKDATA)
  !sourceElement = !data.item

  !mem = !!ce
  var !mode mode

  forward

  bran
  !sourceBran = !!ce

  -- get target elements
  !this.getTargetElements(!sourceElement)

  -- make a new branch
  new bran copy prev
  delete bran mem
  !newBran = !!ce

  do !entry values !this.sourceList
    incl $!entry
  enddo

  conn ph to first mem

  $!sourceBran
  conn pt to ph of $!newBran
  if (!sourceElement inset ('TEE','OLET')) then
    tref $!sourceElement
  endif

  -- make a new pipe
  if (!this.level eq 'PIPE') then
    pipe
    new pipe copy prev
    delete pipe mem
    handle (41,369)
    endhandle

    incl $!newBran
  endif

  $!mem

  enhance $!sourceBran col green
  enhance $!newBran    col blue

  $!mode

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTargetElements
--
-- Description: get target elements for splitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTargetElements(!sourceElement is DBREF)
  !this.sourceList.clear()

  !fromIndex = !sourceElement.sequ
  !toIndex   = !sourceElement.owner.member.size()

  do !index from $!fromIndex to $!toIndex
    if (!index eq !fromIndex) then
      $!index
    else
      next
    endif

    !this.sourceList.append(!!ce)
  enddo
endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getBranchElement
--
-- Description: get branch element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBranchElement(!element is DBREF) is DBREF
  !result = object DBREF()
  if (!element.type NEQ 'BRAN') then
    !result = !element.owner
  else
    !result = !element
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge elements on pipe / branch level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .merge(!firstPick is EDGPICKDATA, !secondPick is EDGPICKDATA)
  !firstElement   = !firstPick.item
  !secondElement  = !secondPick.item

  !sourceBran = !this.getBranchElement(!firstElement)
  !targetBran = !this.getBranchElement(!secondElement)

  if (!sourceBran.type neq 'BRAN' OR !targetBran.type neq 'BRAN') then
    !!alert.error('This function can only be used to merge pipe elements')
    return
  endif

  if (!sourceBran.hpos.wrt( /* ) eq !targetBran.tpos.wrt( /* )) then
    !fromIndex = 1
    !toIndex   = !sourceBran.mcount
    !baseLoc   = 'after last mem'
    !step      = 1
  elseif (!sourceBran.tpos.wrt( /* ) eq !targetBran.hpos.wrt( /* )) then
    !fromIndex = !sourceBran.mcount
    !toIndex   = 1
    !baseLoc   = 'before first mem'
    !step      = -1
  else
    !!alert.error('Branches cannot be merged. Please check position of branches')
    return
  endif

  $!targetBran
  !sourceMembers = !sourceBran.members
  do !i from $!fromIndex to $!toIndex by $!step
    include $!sourceMembers[$!i] $!baseLoc
    handle any
      !!alert.error('Branches cannot be merged ' & !!error.text.after(')'))
      handle any
        !!alert.error(!!error.text)
      endhandle
      unenhance all
      return
    endhandle
  enddo

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Merged Pipe Branches')
  !undo.undoAction('')
  !undo.redoAction('')
  !undo.add()

  !sourceBranHref = !sourceBran.href
  if (!sourceBranHref.unset()) then
    !reconnectHFlag = false
  elseif (!sourceBranHref.type eq 'BRAN') then
    !reconnectHFlag = true
    !reconnectLoc  = 'PT OF'
  elseif (!sourceBranHref.type eq 'NOZZ') then
    !reconnectHFlag = true
    !reconnectLoc  = ''
  else
    !reconnectHFlag = true
    !reconnectLoc  = 'P3 OF'
  endif

  !sourceBranTref = !sourceBran.tref
  if (!sourceBranTref.unset()) then
    !reconnectTFlag = false
  elseif (!sourceBranTref.type eq 'BRAN') then
    !reconnectTFlag = true
    !reconnectLoc  = 'PH OF'
  elseif (!sourceBranTref.type eq 'NOZZ') then
    !reconnectTFlag = true
    !reconnectLoc  = ''
  else
    !reconnectTFlag = true
    !reconnectLoc  = 'P3 OF'
  endif

  if (!sourceBran.href eq !targetBran) then
    if (!reconnectHFlag) then
      FCONN PT TO $!reconnectLoc $!sourceBran
      handle any
      endhandle
    endif
  elseif (!sourceBran.tref eq !targetBran) then
    if (!reconnectTFlag) then
      FCONN PH to $!reconnectLoc $!sourceBran
      handle any
      endhandle
    endif
  else
    conn ph to first mem
    conn pt to last mem
  endif
--
--  var !auxiliaryList    coll all (TEE OLET) for $!sourceList
--  var !auxiliaryPosList eval pos wrt /* for all from !auxiliaryList
--
--  do !i indices !auxiliaryList
--    !checkPos = !auxiliaryPosList[!i]
--    var !findRefElem coll all for $!auxiliaryList with pos wrt /* eq $!checkPos
--
--    !auxiliaryList[!i].cref = !findRefElem[1]
----    handle any
----    endhandle
--  enddo

  $!sourceBran
  delete bran

  if (!this.level eq 'PIPE') then
    delete PIPE
  endif

  $!secondElement
  handle any
  endhandle

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

endmethod
-- End of method
