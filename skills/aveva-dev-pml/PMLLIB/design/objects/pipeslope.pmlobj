--
------------------------------------------------------------------------
define method .setBranchLegAnchorPoint(!branchLeg is PIPESLOPEBRANCHLEG, !anchorNumber is REAL, !method is STRING)

  !branchLeg.setAnchorPoint(!anchorNumber, !method)

endmethod
-- End of method .setBranchLegAnchorPoint

------------------------------------------------------------------------
--
-- Method:      .setBranchLegAnchorFromMethod
--
-- Description: Anchor relative to the specified part of the anchor element
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      PIPESLOPEBRANCHLEG   The branch leg to act upon
--  2   R      REAL                 Index to the anchor number
