------------------------------------------------------------------------
define method .setBranchLegAnchorFromMethod(!branchLeg is PIPESLOPEBRANCHLEG, !anchorNumber is REAL, !method is STRING)

  !branchLeg.setAnchorFromMethod(!anchorNumber, !method)

endmethod
-- End of method .setBranchLegAnchorFromMethod

------------------------------------------------------------------------
--
-- Method:      .updateBranches
--
-- Description: After a branch leg is modified, update the rest of the
--              pipe to match
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R      PIPESLOPEBRANCHLEG   The branch leg that has changed
--  2   R      REAL        Index to the branch leg
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBranches(!branchLeg is PIPESLOPEBRANCHLEG, !legIndex is REAL)
  -- Update the current branch
  !branchIndex = !this.branchIndices[!legIndex]
  !branchLegIndex = !this.legIndices[!legIndex]
  !this.branches[!branchIndex].updateBranchLegs(!branchLeg, !branchLegIndex)

  -- Update connected branches, ensuring each branch is only altered once.
  -- First create a list of branches that haven't been updated yet
  !branchList = ARRAY()
  do !branch values !this.branches
    !branchList.append(!branch.getBranch())
  enddo

  -- Remove the current branch from the list and then update connected branches
  !branchList[!branchIndex] = object DBREF()
  !this.updateConnectedBranches(!branchList, !this.branches[!branchIndex])

endmethod
-- End of method .updateBranches

------------------------------------------------------------------------
--
-- Method:      .updateConnectedBranches
--
-- Description: After a branch is modified, update the rest of the
--              pipe to match
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type]       [Description]
--  1   R      ARRAY            List of branches available for modification
--  2   R      PIPESLOPEBRANCH
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateConnectedBranches(!branchList is ARRAY, !modifiedBranch is PIPESLOPEBRANCH)

  -- Loop through the branches on the list, looking for those connected to
  -- the modified branch. An unset entry in the list indicates that branch has
  -- already been updated.

  !modifiedBranchRef = !modifiedBranch.getBranch()

  -- Find connections between this branch and other branches (on this pipe only)
  !connectionsFrom = ARRAY()
  !connectionsTo = ARRAY()
  !components = !!collectAllFor('', 'CREF ne NULREF and PIPE of CREF eq $!this.pipe', !modifiedBranchRef)
  do !component value !components
    !connectionsFrom.append(object PIPESLOPECOMPONENT(!component, false))
    !connectionsTo.append(!component.cref)
  enddo

  if (!modifiedBranchRef.href.set()) then
    !connectionsFrom.insert(1, object PIPESLOPECOMPONENT(!modifiedBranchRef, true))
    !connectionsTo.insert(1, !modifiedBranchRef.href)
  endif
  if (!modifiedBranchRef.tref.set()) then

    !connectionsFrom.insert(1, object PIPESLOPECOMPONENT(!modifiedBranchRef, false))
    !connectionsTo.insert(1, !modifiedBranchRef.tref)
  endif

  if (!this.calculateForwards.not()) then
    !connectionsFrom.invert()
    !connectionsTo.invert()
  endif

  do !connectionIndex indices !connectionsTo

    -- Find owning branch
    !toBranchRef = object DBREF()
    !connectedTo = !connectionsTo[!connectionIndex]
    if (!connectedTo.type eq 'BRAN') then
      !toBranchRef = !connectedTo
    elseif (!connectedTo.owner.type eq 'BRAN') then
      !toBranchRef = !connectedTo.owner
    endif

    -- Update the owning branch only if it is in the branch list
    skip if (!toBranchRef.unset())
    !toBranchIndex = !branchList.findFirst(!toBranchRef)
    if (!toBranchIndex.set()) then

      -- Find !componentOffset

      !componentOffset = !modifiedBranch.getComponentOffset(!connectionsFrom[!connectionIndex], !this.calculateForwards)

      !end = STRING()
      if (!connectedTo.type eq 'BRAN') then
        -- Find whether connection is to the head or tail of this branch
        !connectedFrom = !connectionsFrom[!connectionIndex]
        if (!connectedFrom.isBranch()) then
          if (!connectedFrom.isHead()) then
            !end = !connectedFrom.dbRef().hend
          else
            !end = !connectedFrom.dbRef().tend
          endif
        else
          !end = !connectedFrom.dbRef.cend
        endif
      endif

      !branchComponent = object PIPESLOPECOMPONENT(!connectedTo, !end eq 'HEAD')
      !this.branches[!toBranchIndex].repositionBranch(!branchComponent, !componentOffset, !this.calculateForwards)

      !branchList[!toBranchIndex] = object DBREF()
      !this.updateConnectedBranches(!branchList, !this.branches[!toBranchIndex])
    endif

  enddo

endmethod
-- End of method .updateConnectedBranches

------------------------------------------------------------------------
--
-- Method:      .setBranchLegAngle
--
-- Description: Set the angle for the branch slope
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
--  1   R      PIPESLOPEBRANCHLEG   The branch leg
--  2   R      REAL                 The angle
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setBranchLegAngle(!branchLeg is PIPESLOPEBRANCHLEG, !angle is REAL)

  --  First just store the angle on the leg
  !branchLeg.setAngle(!angle)

  --  Recalculate the leg offset and drop
  !branchLeg.setAngle(!angle, !this.calculateForwards)

endmethod
-- End of method .setBranchLegAngle
------------------------------------------------------------------------
--
-- Method:      .calculateTeeRotationOffset
--
-- Description: For a tee with p3 vertical, calculate how much the arrive or leave
--              points move when the tee is rotated.
--
-- Method Type: Procedure
--
-- [#] [R/RW] [Data Type] [Description]
--  1   R      PIPESLOPEBRANCHLEG   The branch leg
--  2   R      REAL                 The angle
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calculateTeeRotationOffset(!component is PIPESLOPECOMPONENT, !branch is PIPESLOPEBRANCH) is REAL

  -- Adjustment is only necessary for tees where p3 is vertical and is the arrive or leave
  !componentRef = !component.dbRef()

  if (!componentRef.type ne 'TEE' or (!componentRef.arrive ne 3 and !componentRef.leave ne 3)) then
    return 0
  endif

  if (not !!pipeSlopeUtilities.isDirectionVertical(!componentRef.pDirection[3])) then
    return 0
  endif

  -- Find which ppoint the branch is connected to
  !connection = 6 - !componentRef.arrive - !componentRef.leave

  -- Find distance between p0 and connection point
  !position = !componentRef.pos.wrt( /* )
  !connectedPos = !componentRef.ppos[!connection].wrt( /* )

  -- Find the current angle and distance
  !currentAngle = !!pipeSlopeUtilities.angleToHorizontal(!position, !connectedPos)
  !dist = !position.distance(!connectedPos)

  !branchLeg = !branch.findHorizontalLeg(!componentRef)
  !newAngle = !branchLeg.getAdjustedAngle()

  -- Find the offset (using the sine rule)
  !angleChange  = !newAngle - !currentAngle
  !offset = !dist * !angleChange.sine() / !newAngle.cosine()

  return !offset

endmethod
-- End of method .calculateTeeRotationOffset
