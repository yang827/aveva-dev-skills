--
--  Description:     Object used to pipe spool drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrangeLabelTask(DBREF)          -
--  checkForIsoAndBoss()             -                   checks for the existence of a boss and isometric view
--  checkLooseData(DBREF)            -                   check loose information
--  createResultFile()               -                   create result file
--  displayDrawingInformation(STRING) -                   display drawing information
--  displayExtraInformation(STRING)  -
--  getAssemblyTable()               ARRAY               get assembly table
--  getBendingTable()                ARRAY               get bending table
--  getDrawingInfoTable()            ARRAY               get drawing information table
--  getEndpointTable()               ARRAY               get end-point table
--  getFlangeAngle(DBREF,REAL)       REAL                calculate the angle of a flange component
--  getMtoTable()                    ARRAY               get mto table
--  getPartNo(DBREF)                 REAL                get part-no on component
--  getTaskParameter(DBREF)          ARRAY
--  getWeldingTable()                ARRAY               get welding table
--  initializeDrawing()              BOOLEAN             initialize drawing
--  makeUnderlyingDrwg(DBREF,STRING) STRING              make underlying drawing
--  markAdditionalSpoolInfo(DBREF)   -                   mark additional spool information
--  markAssemblyInfo(DBREF)          -                   mark assembly information
--  markBendingTable(ARRAY)          -                   mark bending table
--  markEndPointConnection(DBREF,DBREF) -                   mark end point connection
--  markPartNo(DBREF)                -                   mark part no
--  markShipPositionOnComponent(DBREF) -                   mark ship position on component for iso-drawing
--  markSpoolDim(DBREF,DBREF,DBREF)  -                   mark spool dimension on a view
--  markWeldingTable(ARRAY)          -                   mark welding table
--  pipespooldwg()                   -                   constructor
--  pipespooldwg(STRING)             -                   constructor using explicit unique ID of calling process when run in a background
--  updateLooseInfo(DBREF,REAL)      -                   update loose information
--  updateSpoolInformation(ARRAY)    -                   update spool information
--  writeErrorMessage(ANY,STRING)    -                   write error message
--  writeTableData(ARRAY)            -                   write table data
--

--
------------------------------------------------------------------------

define object PIPESPOOLDWG
  member .spoolElement        is DBREF

  -- it used to be referenced when define dept,regi name and overlay for iso picture
  member .isoOptionFile       is FILE

  -- it used to be checked if create spool drawing is complete or not
  -- because, there is only this method to check it on outfitting design module on current version.
  -- it'll be removed if command of outfitting draft can use on outfitting design like isodraft mode in future
  member .resultList         is FILE

  member .regiName            is STRING
  member .deptName            is STRING
  member .dwgTmplName         is STRING

  member .pltFileDir          is STRING
  member .pipeSpoolType       is STRING

  member .outputUnits         is STRING

  member .invalidShopElement  is ARRAY

  member .mtoElements         is ARRAY
  member .queryElements       is ARRAY

  member .noteRef             is DBREF

  member .errorList           is ARRAY
  member .errorLogFile        is FILE

  -- it used to be evaluate a expression
  member .evaluateExpression  is COMEVALUATEEXPRESSION
  member .pipeSpoolManager    is PIPESPOOLMANAGER

endobject
-- End of object definition for PIPESPOOLDWG

------------------------------------------------------------------------
--
-- Method:      pipespooldwg
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipespooldwg()

  var !uniqueId unique
  !this.pipespooldwg(!uniqueId)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pipespooldwg
--
-- Description: constructor using explicit unique ID of calling process when run in a background
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Unique id of calling process
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipespooldwg(!uniqueId is STRING)

  !this.resultList = object FILE('%pdmsuser%/' & !uniqueId & 'pspooldwgresult.log')
  !this.errorLogFile = object FILE('%pdmsuser%/' & !uniqueId & 'pspooldwgerror.log')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initializeDrawing
--
-- Description: initialize drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Current Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initializeDrawing() is BOOLEAN
  -- read option file to get drawing type
  !readData = !this.isoOptionFile.readFile()
  handle (41,319)
    !this.writeErrorMessage(!this.isoOptionFile,'Error creating underlying drawing  - failure of loading iso option file')
    return false
  endhandle

  do !data values !readData
    if (!data.upcase().occurs('DWGTYPE') gt 0) then
      !this.dwgTmplName  = !data.part(2,',')

    elseif (!data.upcase().occurs('DWGDEPTNAME') gt 0) then
      !loadDeptName = !data.part(2,',')
      if (substring(!loadDeptName,1,1) ne '/') then
        !loadDeptName = '/' & !loadDeptName
      endif

      !this.deptName = !loadDeptName

    elseif (!data.upcase().occurs('DWGREGINAME') gt 0) then
      !loadRegiName = !data.part(2,',')
      if (substring(!loadRegiName,1,1) ne '/') then
        !loadRegiName = '/' & !loadRegiName
      endif

      !this.regiName = !loadRegiName

    elseif (!data.upcase().occurs('ISOFILEPATH') gt 0) then
      !this.pltFileDir = !data.part(2,',')

    elseif (!data.upcase().occurs('OUTPUTUNITS') gt 0) then
      !this.outputUnits = !data.part(2,',').upcase()
      break

    endif
  enddo

  -- checking drawing template
  !checkDwgTmpl = !this.dwgTmplName.dbref()
  handle any
    !this.writeErrorMessage(!this.dwgTmplName, 'Error creating underlying drawing - Invalid Reference.')
    return false
  elsehandle none
    if (!checkDwgTmpl.badref()) then
      !this.writeErrorMessage(!this.dwgTmplName, 'Error creating underlying drawing - Invalid Reference.')
      return false
    endif
  endhandle

  if !this.pltFileDir eq |%pdmsuser%| then
    var !pdmsuser evar pdmsuser
    !this.pltFileDir = !pdmsuser.replace(';','')
  endif

  -- define directory that export plot file
  if (!this.pltFileDir.unset()) then
    !this.pltFileDir = |%pdmsuser%\| & substring(!loadRegiName,2)
  else
    !this.pltFileDir = |$!this.pltFileDir\| & substring(!loadRegiName,2)
  endif

  -- check plt file directory
  !checkPltDir = object FILE(!this.pltFileDir)
  if (!checkPltDir.exists().not()) then
    syscom 'MD "$!checkPltDir"'
  endif

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      makeUnderlyingDrwg
--
-- Description: make underlying drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makeUnderlyingDrwg(!element is DBREF, !isoOptionFilePath is STRING) is STRING

  warning off
  trace off
  !this.errorList.clear()
  !resultPath = STRING()
  !dept = nulref
  !regi = nulref
  !dwg = nulref

  -- set spool element
  !this.spoolElement = !element
  !this.isoOptionFile = object FILE(!isoOptionFilePath)
  !dwgName = !this.spoolElement.name & '_Spool'

  -- set pipeSpoolType
  !this.pipeSpoolType = !this.spoolElement.pstyp.upcase()
  if (!this.pipeSpoolType.empty()) then
    !this.pipeSpoolType = 'SHOP'
  endif

  --set up format objects
  !!setGlobalFormats()

  -- Initialise Drawing
  if (!this.initializeDrawing().not()) then
    !this.createResultFile()
    return !resultPath
  endif

  -- check DEPT if exists
  !dept = !this.deptName.dbref()
  handle ANY
  endhandle
  if !dept.badref() then
    context draw
    new DEPT $!this.deptName
    handle ANY
      !this.writeErrorMessage(!this.deptName, 'Error creating underlying drawing - Cannot Create Department.')
      !this.createResultFile()
      return !resultPath
    endhandle
    !dept = !!ce
  endif

  -- check REGI if exists
  !regi = !this.regiName.dbref()
  handle ANY
  endhandle
  if !regi.badref() then
    !!ce = !dept
    new REGI $!this.regiName
    handle ANY
      !this.writeErrorMessage(!this.regiName, 'Error creating underlying drawing - Cannot Create Registry.')
      !this.createResultFile()
      return !resultPath
    endhandle
    !regi = !!ce
  else
    if !regi.owner.neq(!dept) then
      !this.writeErrorMessage(!this.regiName, 'Error creating underlying drawing - Registry $!this.regiName appears under different Department than $!this.deptName.')
      !this.createResultFile()
      return !resultPath
    endif
  endif

  -- check DRWG if exists
  !dwg = !dwgName.dbref()
  handle ANY
  endhandle
  if !dwg.badref() then
    !!ce = !regi
    new DRWG $!dwgName
    !dwg = !!ce
  else
    -- check if read-write
    !!ce = !dwg
    delete DRWG memb
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modify underlying drawing.')
      !this.createResultFile()
      return !resultPath
    endhandle
    if !dwg.owner.neq(!regi) then
      !!ce = !regi
      include $!dwg
      handle ANY
        !!ce = !regi
        new DRWG
        handle ANY
          !this.writeErrorMessage(!dwg, 'Error modify underlying drawing - cannot move existing ' & !dwg.namtyp & ' to Registry ' & !this.regiName & '.')
          !this.createResultFile()
          return !resultPath
        endhandle
        !deleteDwg = !dwg
        !dwg = !!ce
        !!ce = !deleteDwg
        delete DRWG
        !dwg.name = !dwgName
      endhandle
      !!ce = !dwg
    endif
  endif

  !!ce.linkref = !this.dwgTmplName.dbref()

  -- copy DRWG from template
  copy $!this.dwgTmplName rename $!this.dwgTmplName $!dwgName

  !drawingType = !!ce.func
  if (!drawingType.upcase().occurs('2D SKETCH') gt 0) then
    !isSketchType = true
  else
    !isSketchType = false
  endif

  !sheetRef = sheet 1

-- CW - P-40137 - Fix to Add date and Loginname to pipesketch

  !session = current session
  !n = !session.name
  !!ce.author = !n

  !a = object DATETIME()
  !b = !a.date() & ' ' & !a.monthstring().substring(1,3) & ' ' & !a.year()
  !!ce.date = !b

  !name = !!ce.name
  !title = !name.after('/').before('_Spool')
  !!ce.title = ('Pipe Sketch - Spool') & (' ') & !title
--navigate to sheet level
  1
  !!ce.title = !title
--navigate back to drg level

  end


   update anno
-- CW - end of fix

  -- view update
  var !viewList coll all view for drwg

  -- set draw-list on view
  do !i indices !viewList
    !view     = !viewList[!i].dbref()

    !!ce  = !view

    if (!view.func ne 'ISO_VIEW') then
      -- add item on drawlist
      goto idlname
      delete idli mem
      new adde

      !!ce.idna = !this.spoolElement

      !!ce = !view
      auto
      handle any
      endhandle
    else
      !userLabelLayer = object DBREF(!view.name & '/USER_Labs')
      handle (2,109)
      -- there is no user label layer for the view
      elsehandle none
        !userLabelLayer.lvis = false
      endhandle
    endif

    if (!isSketchType) then
      lvis true
      lframe false

      !this.markAdditionalSpoolInfo(!view)
    else
      -- invisible overlay area
      !overlayAreaLayer = object DBREF(!view.name & '/Overlay')
      handle (2,109)
      -- there is no overlay element for displaying iso plot file
      elsehandle none
        !overlayAreaLayer.lvis = false
      endhandle
    endif

    !!ce = !view
    update all
    handle any
    endhandle
  enddo

  !!ce = !sheetRef

  if (!isSketchType.not()) then
    -- create olay for displaying iso drawing if current drawing type is iso spool drawing
    !olayName = !dwgName & '/Overlay'

    new olay $!olayName
    -- assemble plot file name U files are the final underlay files
    -- rename the spool name if it is unnamed
    !newSpoolName = !this.spoolElement.namn
    !invalidStr = substring(!this.spoolElement.namn,1,1)
    if !invalidStr.eq('=') then
      !newSpoolName = substring(!this.spoolElement.namn,2)
    endif
    !spoolName = |U-| & !newSpoolName & |.iso.plt|
    !fileName = !!generateFileName(!spoolName)
    !olayPath = !this.pltFileDir & |\iso\| & !fileName
    Osfname /$!olayPath
    handle any
      !this.writeErrorMessage(!olayPath, 'Error creating underlying drawing - Failure of loading overlay file')
    endhandle
  endif

  -- update mto and other list on the drawing
  !sourceNoteList = !!collectAllFor('NOTE',|sppurp eq 'CELLS' and func ne ''|, !sheetRef.bsrf)

  !displayList = object ARRAY()
  do !entry values !sourceNoteList
    !tmpList    = !entry.name.split(|/|)
    !newNote    = |/| & !dwgName & |/| & !tmpList.last()
    !sourceNote = !entry.name
    new note $!newNote copy $!sourceNote ren $!sourceNote $!newNote

    -- add display detail list (Material list, etc..)
    !table[1] = !!ce.function.upcase()
    !table[2] = !!ce
    !displayList.append(!table)
  enddo

  !noteFunctions = 'MTO,OTHERDATA,BENDING,ASSEMBLY,ENDPOINT,WELDING'
  !functionList  = !noteFunctions.split(',')

  do !item values !displayList
    !this.noteRef = !item[2]
    !index = !functionList.findFirst(!item[1])
    skip if (!index.unset())

    !this.displayDrawingInformation(!functionList[!index])
  enddo


  if (!isSketchType) then
    !this.markBendingTable(!this.getBendingTable())
  endif


  -- Generate the plot file, but only if the sheet doesn't use TrueType fonts - they are
  -- not supported by the plot format
  if (!sheetRef.ttfEnabled) then
    !this.writeErrorMessage(!dwgName, 'Warning: plot could not be created because the sheet uses TrueType fonts')
  else
    !plotFileName = !this.pltFileDir & '\' & !!generateFileName(!sheetRef.namn) & '.plt'
    plot ce "$!plotFileName" over
    !resultPath = !plotFileName
  endif

-- Test if drawing template contains an isometric view and spool contains a boss connection.
  !this.checkForIsoAndBoss()
  !this.createResultFile()

  !mem = !!ce
  !!ce = drwg
  !drwgName = name
  !regiNameOfDrwg = name of regi
  !regiNameOfPspool = '/' & !this.spoolElement.:SKTCHREGI

  if !regiNameOfDrwg neq !regiNameOfPspool then
    !!ce = !regiNameOfPspool.dbref()
    include $!drwgName
    handle any
      !errorMessage = 'Error occurred while including the old DRWG to the new REGI.'
      !this.writeErrorMessage(!this.spoolElement.name, !errorMessage)
      !this.createResultFile()
      return
    endhandle
  endif
  !!ce = !mem

  return !resultPath

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createResultFile
--
-- Description: create result file
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createResultFile()

  -- append error list to error file
  !this.errorLogFile.writeFile('append',!this.errorList)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTaskParameter
--
-- Description: getTaskParameter
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTaskParameter(!taskRef is DBREF) is ARRAY
  !parameter = object ARRAY()

  do !tkpara value !taskRef.mem
    !index = !parameter.size() + 1
    !parameter[!index] = object ARRAY()
    !parameter[!index].append(!tkpara.function)
    !parameter[!index].append(!tkpara.pType)
    !parameter[!index].append(!tkpara.tpValue)
  enddo

  return !parameter
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markSpoolDim
--
-- Description: mark spool dimension on a view
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markSpoolDim(!taskRef is DBREF, !spoolRef is DBREF, !viewRef is DBREF)

  !spoolDim = object PIPESPOOLDIMENSION()
  !spoolDim.dimOptions = !this.getTaskParameter(!taskRef)
  !spoolDim.spoolRef   = !spoolRef

  !spoolDim.createDimension(!viewRef)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markEndPointConnection
--
-- Description: mark end point connection
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markEndPointConnection(!spoolRef is DBREF, !viewRef is DBREF)
  !labelLayerRef = !!collectAllFor('LAYE',|purp eq 'LABA'|, !viewRef)
  if (!labelLayerRef.unset()) then
    return
  endif

  !endPosData = object ARRAY()

  !arriveRef = !this.spoolElement.psarfa
  !leaveRef  = !this.spoolElement.pslrfa

  do !entry values !arriveRef
    if (!entry.type eq 'BRAN') then
      !href = !entry.href
      if unset(!href) eq false then
        if !href.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !endPos = 'PH of ' & !entry.name
    else
      !endPos = 'PL of ' & !entry.name
    endif
    !endPosData.append(!endPos)
  enddo

  do !entry values !leaveRef
    if (!entry.type eq 'BRAN') then
      !tref = !entry.tref
      if unset(!tref) eq false then
        if !tref.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !endPos = 'PT of ' & !entry.name
    else
      !endPos = 'PA of ' & !entry.name
    endif
    !endPosData.append(!endPos)
  enddo


  !!ce = !labelLayerRef[1]
  do !i indices !endPosData
    !tagName = 'C' & !i
    !tagPos  = !endPosData[!i]

    new glab on $!tagPos
    btext |$!tagName|
    cheight 2
    lframe false
    CPOFFSET 0 -1.25
  enddo

  !!ce = !labelLayerRef[1]
  UPDATE ANNO


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markAdditionalSpoolInfo
--
-- Description: mark additional spool information
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markAdditionalSpoolInfo(!viewRef is DBREF)
  -- mark spool dimension
  !drwgRef = DRWG

  !dimTask = !!collectAllFor('TASK', |func eq 'Spool Dimension'|, !drwgRef)
  if (!dimTask.set()) then
    !this.markSpoolDim(!dimTask[1], !this.spoolElement, !viewRef)
  endif


  !this.markEndPointConnection(!this.spoolElement, !viewRef)

  !this.markAssemblyInfo(!viewRef)
  !this.markPartNo(!viewRef)

  !this.arrangeLabelTask(!drwgRef)


--  !!pipeSpoolDim(!parameter, !this.spoolElement, !viewRef)

endmethod
-- End of method

define method .arrangeLabelTask(!drwgRef is DBREF)
  !arrangeLabelTask = !!collectAllFor('TASK', |SPPURP eq 'ARRLAB'|, !drwgRef)

  -- Get arrange label task and read parameters
  VAR !allTaskParameters COLL ALL TKPARA FOR $!arrangeLabelTask[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  update anno
  -- Arrange the labels

  !!pipeSketchesArrangeLabels($!parameters)

  update anno
endmethod

------------------------------------------------------------------------
--
-- Method:      markAssemblyInfo
--
-- Description: mark assembly information
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markAssemblyInfo(!viewRef is DBREF)
  !labelLayerRef = !!collectAllFor('LAYE',|purp eq 'LABA'|, !viewRef)
  if (!labelLayerRef.unset()) then
    return
  endif

  !assemblyTables = !this.pipeSpoolManager.getActivityTables(!this.spoolElement)

  !refPlane = ARRAY()

  do !i indices !assemblyTables

    !activity[!i] = !assemblyTables[!i]
    !refPlane[!i] = !activity[!i].referencePlaneComponent()
    handle ANY
      -- Because not all activities have this method
    endhandle
  enddo

  -- Make list of components unique and re-indexed
  !components = !refPlane.unique()

  if (!components.unset()) then
    return
  endif

  -- Go to each View's label layer
  !!ce = !labelLayerRef[1]

-- Build the local tags
  do !i indices !components
    !entryType = !components[!i].type
    handle any
      skip
    endhandle

    if (!entryType eq 'BEND') then
      !prefix = 'BP'
    elseif (!entryType eq 'ELBO') then
      !prefix = 'EP'
    elseif (!entryType inset('TEE','CROS')) then
      !prefix = 'TP'
    else
      -- Could be a flange
      !prefix = 'FP'
    endif
    -- Read position number
    !posNumber = !prefix & !components[!i].tyseq

    if !entryType.neq('OLET') then
      -- Create new
      NEW GLAB ON $!components[$!i] BTEX |$!posNumber|
      CHEIGHT 2
      CPOFFSET 0 -1.25
    endif
  enddo

  !!ce = !labelLayerRef[1]
  UPDATE ANNO
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markPartNo
--
-- Description: mark part no
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markPartNo(!viewRef is DBREF)
  !labelLayerRef = !!collectAllFor('LAYE',|purp eq 'LABA'|, !viewRef)
  if (!labelLayerRef.unset()) then
    return
  endif

  !!ce = !labelLayerRef[1]

  !drwgRef = DRWG
  !labelDefTask = !!collectAllFor('TASK', |func eq 'Tag Defaults'|, !drwgRef)
  !labelOptions = !this.getTaskParameter(!labelDefTask[1])

  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -start
  !mtoElements = !this.pipeSpoolManager.getMtoElements(!this.spoolElement)
  !mtoCol = object ARRAY()
  do !i from 1 to !mtoElements.size()
    !item = !mtoElements[!i]
    !dtxrtext = !item.dtxrtext
    if !dtxrtext.neq(|TEE SET ON|) then
      !mtoCol.append(!item)
    endif
  enddo
  !this.mtoElements = !mtoCol
  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -end

  do !i indices !this.mtoElements
    !entry = !this.mtoElements[!i]
    !mtoTag = !i
    NEW SLAB ON $!entry ATEX |$!mtoTag|

    if (!entry.type eq 'PPIECE') then
      -- Tag at centre of tube
      !pipePiecePosition = !!positionAlongPipePiece(!entry, 0.5)
      POS $!pipePiecePosition
    endif

    do !para values !labelOptions
      !func    = !para[1]
--      !pType   = !para[2]
      !tpValue = !para[3]

      $!func $!tpValue
    enddo
  enddo

  !!ce = !labelLayerRef[1]

  !drwgRef = DRWG
  !arrangeLabelTask = !!collectAllFor('TASK', |SPPURP eq 'ARRLAB'|, !drwgRef)

  -- Get arrange label task and read parameters
  VAR !allTaskParameters COLL ALL TKPARA FOR $!arrangeLabelTask[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  !!ce = !labelLayerRef[1]
  update anno
  -- Arrange the labels

  !!pipeSketchesArrangeLabels($!parameters)

  !!ce = !labelLayerRef[1]
  update anno

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      markWeldingTable
--
-- Description: mark Welding Table
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markWeldingTable(!tableData is ARRAY)

  !this.noteRef.lvis = true
  !mem = !!ce

  -- Navigate to sheet
  !!ce = !this.noteRef.owner
  setstar
  tail
  --!sheet = !this.noteRef.owner.name
  !backingSheet = !!ce.bsrf.name
  !tableType = 'WELDING'

  -- Collect the table entry notes from the backing sheet

  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet
  -- Get the name of the note
  !tableName = !table[1].dbref().name

  !!ce = !this.noteRef

  -- Copy the table notes from the backing sheet
  new note */$!tableType$n.table copy $!tableName rename $!tableName */$!tableType$n.table
  setstar
  !newTableName = !!ce.name

  --Adjust each length of the rows
  !firstStraElement = !newTableName & '/ColumnLine1'
  !secondStraElement = !newTableName & '/ColumnLine2'
  !cellSpacing = !firstStraElement.dbref().length
  !firstStraElement.dbref().length = !cellSpacing + (!cellSpacing * !tableData.size())
  !secondStraElement.dbref().length = !cellSpacing + (!cellSpacing * !tableData.size())

  --Adjust the size of the area for the welding table
  var !rect collect all rect for $!this.noteRef
  !sizeOfEndPoint = !this.getEndpointTable().size() + 2
  !rect[1].dbref().nlcolour = 1
  !defaultLength = !cellSpacing * 4
  !rect[1].dbref().ylength = !defaultLength

  --Adjust the contents of the welding table
  var !cells collect all textp for $!this.noteRef
  do !i indices !cells
    do !j indices !tableData
      if !j eq 1 then
        !!ce = !cells[!i].dbref()
        !newName = !this.noteRef.name & '/cell'& !j & '.'& !i
        rename $!newName
        !!ce.btext = !tableData[!j][!i]
      else
        !!ce = !cells[!i].dbref()
        new textp  copy prev
        by y $!cellSpacing
        !newName = !this.noteRef.name & '/cell'& !j & '.'& !i
        rename $!newName
        !!ce.btext = !tableData[!j][!i]
      endif
    enddo
  enddo
  !!ce = !this.noteRef
  update all

  !!ce = !mem

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      markBendingTable
--
-- Description: mark bending Table
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markBendingTable(!tableData is ARRAY)

  !this.noteRef.lvis = true
  !mem = !!ce

  -- Navigate to sheet
  !!ce = !this.noteRef.owner
  setstar
  --!sheet = !this.noteRef.owner.name
  !backingSheet = !!ce.bsrf.name
  !tableType = 'BENDING'

  -- Collect the table entry notes from the backing sheet
  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet

  -- Initialise the text elements for the bending table
  var !allNotes collect all note with (FUNC eq !tableType) for sheet
  if (!allNotes.size().neq(0)) then
    var !allText collect all textp for $!allNotes[1]
    !!ce = !allNotes[1].dbref()
    !allText[1].dbref().btext = ''
    !allText[2].dbref().btext  = ''
    !allText[3].dbref().btext  = ''
    !allText[4].dbref().btext  = ''
    update all
  endif

  -- Get the name of the note
  !tableName = !table[1].dbref().name
  !!ce = !this.noteRef

  -- Copy the table notes from the backing sheet
  new note */$!tableType$n.table copy $!tableName rename $!tableName */$!tableType$n.table
--  setstar
  !newTableName = !!ce.name

  --Adjust each length of the rows
  !firstStraElement = !newTableName & '/ColumnLine1'
  !secondStraElement = !newTableName & '/ColumnLine2'
  !thirdStraElement = !newTableName & '/ColumnLine3'

  !cellSpacing = !firstStraElement.dbref().length
  !firstStraElement.dbref().length = !cellSpacing + !cellSpacing
  !secondStraElement.dbref().length = !cellSpacing + !cellSpacing
  !thirdStraElement.dbref().length = !cellSpacing + !cellSpacing

  -- Initialise Variables
  !result = ARRAY()
  !pipePieceIndex = ''
  !bendingMachine = ''
  !bendingMachineClutch = ''
  !bendingMachineCheckSum = ''

  -- Bending Table
  !bendingTables = !this.pipeSpoolManager.getBendingTables(!this.spoolElement)
  -- Welding Table
  !weldingTables = !this.pipeSpoolManager.getWeldingTables(!this.spoolElement)
  !pipePieces = !this.pipeSpoolManager.getPipePieces(!this.spoolElement)
  !index = !tableData[1].split(',')[1].real()
  -- If there is no  data for the bending table, skip.
  handle any
    return
  endhandle

  -- Find the bending and welding table for this pipe piece
  !bendingTable = !bendingTables[!index]
  !weldingTable = !weldingTables[!index]

  -- Get the pipe Piece index for the MTO Elements array .findFirst method
--  !pipePieceIndex = !this.mtoElements.findFirst(!pipePieces[!bendingIndex]).string()
  !pipePieceIndex = !index.string()
  -- Get the bending machine directly from the object
  !bendingMachine = !bendingTable.bendingMachine().namn
  handle any
  endhandle

  -- Get the bending machine check sum directly from the object
  !bendingMachineCheckSum = !bendingTable.checkSum().string(!!distanceFMT)
  handle any
  endhandle

  if (!bendingTable.clutchArriveTube()) then
    if (!weldingTable.arriveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoElements.findFirst(!weldingTable.arriveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'Start'
    endif
  else
    if (!weldingTable.leaveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoElements.findFirst(!weldingTable.leaveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'End'
    endif
  endif

  !allText[1].dbref().btext = !pipePieceIndex
  !allText[2].dbref().btext = !bendingMachine
  !allText[3].dbref().btext = !bendingMachineClutch
  !allText[4].dbref().btext = !bendingMachineCheckSum

  !!ce = !mem

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      displayDrawingInformation
--
-- Description: display drawing information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayDrawingInformation(!funcType is STRING)
  !tableData = object ARRAY()

  if (!funcType eq 'MTO') then
    !tableData = !this.getMtoTable()

  elseif (!funcType eq 'OTHERDATA') then
    !tableData = !this.getDrawingInfoTable()

  elseif (!funcType eq 'BENDING') then
    !tableData = !this.getBendingTable()

  elseif (!funcType eq 'ASSEMBLY') then
    !tableData = !this.getAssemblyTable()
    !this.displayExtraInformation('ASSEMBLY')

  elseif (!funcType eq 'ENDPOINT') then
    !tableData = !this.getEndpointTable()
    !this.displayExtraInformation('ENDPOINT')

  elseif (!funcType eq 'WELDING') then
    !tableData = !this.getWeldingTable()
    !this.markWeldingTable(!tableData)
  endif

  if (!tableData.unset()) then
    !!ce = !this.noteRef
    delete note
    return
  endif
  --Welding table is created using a different method.
  if (!funcType neq 'WELDING') then
    if (!tableData.neq('') or !tableData.set()) then
      !this.writeTableData(!tableData)
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayExtraInformation
--
-- Description: display extra information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayExtraInformation(!infoType is STRING)

  !drwgRef  = drwg
  if (!drwgRef.func.upcase().trim().occurs('2D SKETCH') gt 0) then
    return
  endif
  !viewList = !!collectAllFor('VIEW','', !drwgRef)
  do !viewRef values !viewList
    if (!infoType eq 'SPOOL_DIM') then
      !dimTask = !!collectAllFor('TASK', |func eq 'Spool Dimension'|, !drwgRef)
      if (!dimTask.set()) then
        !this.markSpoolDim(!dimTask[1], !this.spoolElement, !viewRef)
      endif
    elseif (!infoType eq 'ENDPOINT') then
      !this.markEndPointConnection(!this.spoolElement, !viewRef)
    elseif (!infoType eq 'ASSEMBLY') then
      !this.markAssemblyInfo(!viewRef)
    elseif (!infoType eq 'PARTNO') then
      !this.markPartNo(!viewRef)
    endif
  enddo

  !this.arrangeLabelTask(!drwgRef)
  handle any
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      writeErrorMessage
--
-- Description: write error message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeErrorMessage(!element is ANY, !message is STRING)

  !datatype = !element.objectType()
  if !datatype.eq('DBREF') then
    if !element.isNamed then
      !name = !element.name
    else
      !name = !element.namtyp
    endif
  elseif !datatype.eq('STRING') then
    !name = !element
  elseif !datatype.eq('FILE') then
    !name = !element.string()
  endif
  !this.errorList.append(!name & '@'  & !message)

endmethod

------------------------------------------------------------------------
--
-- Method:      updateSpoolInformation
--
-- Description: update spool information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateSpoolInformation(!spoolList is ARRAY)
  !this.errorList.clear()
  !this.invalidShopElement.clear()

  !spoolFabManager = object PIPEFABRICATIONMANAGER()
  !pipeList = object ARRAY()

  do !spoolRef values !spoolList

    !this.pipeSpoolType = !spoolRef.pstyp
    !pipeRef  = !spoolRef.owner.owner

    if (!pipeRef.dbwrite.not()) then
      !this.writeErrorMessage(!pipeRef, 'Error creating underlying drawing - Cannot Modify.')
      skip
    endif

    if (!pipeList.findFirst(!pipeRef).unset()) then
      partno create $!pipeRef
      handle any
        exit
        handle any
        elsehandle none
          partno create $!pipeRef
        endhandle
      endhandle
      !pipeList.append(!pipeRef)
    endif

    !spoolFabManager.updatePartNo(!spoolRef)

    !mtoElements = !this.pipeSpoolManager.getMtoElements(!spoolRef)

    -- insert component position with ship coordinates format
    do !element values !mtoElements
      skip if (!element.type inset ('WELD','ATTA','PPIECE'))

      if (!element.type eq 'FLAN') then
        !element.:isoShipCoord = ''
        handle any
          !this.writeErrorMessage(!element, !!error.text)
          skip
        endhandle
        !element.:isoLoose = ''
        handle any
          !this.writeErrorMessage(!element, !!error.text)
          skip
        endhandle
      endif

      -- check shop status
      if (!element.type inset ('ELBO', 'BEND', 'TEE','OLET', 'REDU', 'FLAN') AND !element.shop.not()) then
        !this.writeErrorMessage(!element, 'Error creating underlying drawing - Invalid shop status')
        !element.shop = true
        handle any
        endhandle

        !this.invalidShopElement.append(!element)
      elseif (!element.type inset ('GASK', 'VALV', 'INST') AND !element.shop) then
        !this.writeErrorMessage(!element, 'Error creating underlying drawing - Invalid shop status.')
        !element.shop = false
        handle any
        endhandle

        !this.invalidShopElement.append(!element)
      endif

       -- TM commented out for 12.1 because 12.1 can output ship coordinates.
      --!this.markShipPositionOnComponent(!element)

    enddo

    -- check loose part
    !pipePieces = !this.pipeSpoolManager.getPipePieces(!spoolRef)
    do !piece values !pipePieces
      !this.checkLooseData(!piece)
    enddo
  enddo

endmethod


------------------------------------------------------------------------
--
-- Method:      markShipPositionOnComponent
--
-- Description: mark ship position on component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markShipPositionOnComponent(!component is DBREF)
  !shipPositions = !!comTranslateShipPosition(!component.pos.wrt( /* ))
  if (!shipPositions.unset()) then
    return
  endif

  !shipPos = 'X:' & !shipPositions[1] & $
             ' $Y:' & !shipPositions[2] & $
             ' $Z:' & !shipPositions[3]
  handle any
    return
  endhandle
  !shipPos = !shipPos.replace('mm','')
  !component.:isoShipCoord = '$!shipPos'
  handle any
    !this.writeErrorMessage(!component, !!error.text)
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      checkLooseData
--
-- Description: check loose information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkLooseData(!element is DBREF)
  -- get excess data from ppiece
  --<RM> P-33078 choose the greatest value from machine and user excess for leave and arrive (agreed with AH) -start
  !userArriveExcess = !element.uaexss
  !machineArriveExcess = !element.baexss
  if !machineArriveExcess.gt(!userArriveExcess) then
    !arriveExcess = !machineArriveExcess
  else
    !arriveExcess = !userArriveExcess
  endif

  !userLeaveExcess = !element.ueexss
  !machineLeaveExcess = !element.blexss
  if !machineLeaveExcess.gt(!userLeaveExcess) then
    !leaveExcess = !machineLeaveExcess
  else
    !leaveExcess = !userLeaveExcess
  endif
  --<RM> P-33078 choose the greatest value from machine and user excess for leave and arrive (agreed with AH) -end

  -- check excess values
  var !mode mode
  if (!mode.upcase() neq 'FORWARDS') then
    forward
  endif

  -- update loose information
  if (!element.pparef.type inset('FLAN','FBLI')) then
    !this.updateLooseInfo(!element.pparef, !arriveExcess)
  endif

  if (!element.pplref.type inset ('FLAN','FBLI')) then
    !this.updateLooseInfo(!element.pplref, !leaveExcess)
  endif

  $!mode

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLooseInfo
--
-- Description: update loose information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateLooseInfo(!component is DBREF, !excess is REAL)

  !loose = !this.pipeSpoolType.eq('FITT').and(!excess.neq(0))

  if !loose then
    !inputData = 'LOOSE +$!excess'
    if !excess.lt(0) then
      !inputData = 'LOOSE -$!excess'
    endif
  else
    !inputData = ''
  endif

  -- mark component position with ship coordinates format
  -- TM commented out for 12.1 because 12.1 can output ship coordinates.
  -- !this.markShipPositionOnComponent(!component)
  !component.:ISOLOOSE = !inputData
  handle any
    !this.writeErrorMessage(!component, 'Error creating underlying drawing - Failure of updating loose information')
  endhandle

  !component.loose = !loose
  handle any
    !this.writeErrorMessage(!component, 'Error creating underlying drawing - Failure of updating loose information')
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeTableData
--
-- Description: write table data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeTableData(!tableData is ARRAY)

  !this.noteRef.lvis = true
  !firstRowLine = !this.noteRef.name & '/FirstLine'
  !checkRowLine = object DBREF(!firstRowLine)
  handle any
    !checkRowLine = object DBREF()
  endhandle

  !yOffset = 0
  !yStep   = 0


  -- Get the direction of the build from the STRA element in the table note.
  !firstColumnLine = !this.noteRef.name & '/ColumnLine1'
  !checkColumnLine = object DBREF(!firstColumnLine)
  handle any
    !checkColumnLine = object DBREF()
  elsehandle none
    if (!firstColumnLine.dbref().adeg.nint() eq 90) then
      !buildDirection = 'Y'
    else
      !buildDirection = 'Y -'
    endif

    !yStep = !firstColumnLine.dbref().length
  endhandle

  !i = 1
  do !entry values !tableData
    !rowData = !entry.split(',')

    if (!rowData.size() gt 1) then
      do !j indices !this.queryElements
        !!ce = !this.queryElements[!j]
        unname

        !textPosition = xypos of ptrf
        if (!i gt 1) then
          !xPos         = !textPosition.east

          new texp copy prev
          xyPos $!xPos $!yPos
--          handle any
--            !yPos = 0
--          endhandle
        endif

        !newText = !rowData[!j]
        handle any
          !newText = ''
        endhandle

        !btext   = btext
        -- change btext
        edt |$!btext| |$!newText|
      enddo
    else
      !!ce = !this.queryElements[!i]
      handle any
        skip
      endhandle
      unname

      !newText = !tableData[!i]
      !btext   = btext
      -- change btext
      edt |$!btext| |$!newText|
    endif

    if (!checkRowLine.badref().not()) then
      !yOffset = !yStep * !i

      if (defined(!buildDirection)) then
        if (!buildDirection.occurs('-') gt 0) then
          !yPos    = !textPosition.north - !yOffset
        else
          !yPos    = !textPosition.north + !yOffset
        endif
      endif

      new stra copy $!firstRowLine
      by $!buildDirection$!yOffset
    endif

    !i = !i + 1
  enddo

  -- extension column line
  !columnLineExtension = !yStep * !tableData.size()
  var !columnLines coll all STRA with occurs(name, '/ColumnLine') gt 0 for $!this.noteRef
  do !i indices !columnLines
    !entry = !columnLines[!i].dbref()
    !entry.length = !columnLineExtension
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      getDrawingInfoTable
--
-- Description: get drawing information table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDrawingInfoTable() is ARRAY
  -- Collect all the pipe pieces for the pipe spool
  !refSpoolData = object ARRAY()

  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  !entry = !this.spoolElement
  do !i indices !this.queryElements
    !item    = !this.queryElements[!i]
    !table   = object ARRAY()

    !evalStr = !item.etext

    if (!evalStr.unset() or !evalStr.empty()) then
      !result = ''
    else
      !result = !this.evaluateExpression.getEvaluateResult(!entry, !evalStr, '.')
    endif

    !refSpoolData.append(!result)
  enddo

  return !refSpoolData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPartNo
--
-- Description: get part-no on component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPartNo(!element is DBREF) is REAL
  if (!element.type eq 'PPIECE') then
    if (!element.aelrfa[1].type eq 'BRAN') then
      !partNo = !element.aelrfa[1].ptnhead
    else
      !partNo = !element.aelrfa[1].ptntube
    endif

    handle any
      !partNo = -1
    endhandle
  else
    !partNo = !element.ptno
    handle any
      !partNo = -1
    endhandle
  endif

  return !partNo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getMtoTable
--
-- Description: get mto table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMtoTable() is ARRAY

  -- get mto elements on spool
  !this.mtoElements = !this.pipeSpoolManager.getMtoElements(!this.spoolElement)

  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  --Sort out the array for the mto table depending on the type of a component
  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -start
  !mtoElements = !this.pipeSpoolManager.getMtoElements(!this.spoolElement)
  !mtoCol = object ARRAY()
  do !i from 1 to !mtoElements.size()
    !item = !mtoElements[!i]
    !dtxrtext = !item.dtxrtext
    if !dtxrtext.neq(|TEE SET ON|) then
      !mtoCol.append(!item)
    endif
  enddo
  !this.mtoElements = !mtoCol
  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -end

  !mtoData  = object ARRAY()

  -- replacement comunit
  !currUnit = object COMUNITS(TRUE)
  --var !currUnit unit
  --!unit = !currUnit.split()[3]
  !unit = !currUnit.getcurrentunitsbyptype('DIST')

  do !i indices !this.mtoElements
    !entry = !this.mtoElements[!i]
    !type  = !entry.type

    skip if (!type inset ('WELD','ATTA'))

    if (!type eq 'PPIECE') then
      if (!entry.aelrfa[1].type eq 'BRAN') then
        !partNo = !entry.aelrfa[1].ptnhead
      else
        !partNo = !entry.aelrfa[1].ptntube
      endif
    else
      !partNo = !entry.ptno
      !unit   = 'EA'
    endif

    !table = object ARRAY()
    !table.append(!i)

    !findIndex = 0
    do !j indices !this.queryElements
      !item = !this.queryElements[!j]
      if (defined(!evalResult)) then
        !evalResult.delete()
      endif

      if (!item.btext.upcase().occurs('UNIT') gt 0) then
        !table.append(!unit)
        skip
      endif

      !evalStr = !item.etext
      if (!evalStr.empty()) then
        skip
      endif

      !evalResult = !this.evaluateExpression.getEvaluateResult(!entry, !evalStr, '.')

      if (!evalStr.upcase().occurs('QTY') gt 0) then
        !findIndex = !j
      elseif (!evalStr.upcase().occurs('AC') gt 0) then
        !findIndex = !j
      else
        !findIndex = -1
      endif
      if (!type eq 'PPIECE') then
        !findIndex = 0
      endif

      if (!this.outputUnits.unset()) then
        !this.outputUnits = 'METER'
      endif

      if (!evalStr.upcase().occurs('QTY') gt 0 or !evalStr.upcase().occurs('AC') gt 0) then
        if (!this.outputUnits.occurs('IMPERIAL') gt 0 and !unit ne 'EA') then
          !transResult = !evalResult.real() / 25.4
          !evalResult = !transResult.nint().string()
        endif
      endif

      if (!mtoData.size() gt 0 AND !findIndex gt 0) then
        !groupData  = !mtoData[!i].split(',')
        handle any
        elsehandle none
          !groupResult = !groupData[!findIndex].real() + !evalResult.real()
          handle any
            if (defined(!groupResult)) then
              !groupResult.delete()
            endif
            !groupResult = ''
          endhandle
          !evalResult   = !groupResult.string()
        endhandle
      endif

      !table.append(!evalResult)
    enddo

    !insertStr = ''
    do !j indices !table
      if (!j ne !table.size()) then
        !insertStr = !insertStr + !table[!j].string() + ','
      else
        !insertStr = !insertStr + !table[!j].string()
      endif
    enddo
    !mtoData[!i] = !insertStr
    handle any
    endhandle
  enddo

  return !mtoData
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getAssemblyTable
--
-- Description: get assembly table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAssemblyTable() is ARRAY

  -- get assembly activity table
  !assemblyTables = !this.pipeSpoolManager.getActivityTables(!this.spoolElement)
  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)

  !result = object ARRAY()

  do !i indices !assemblyTables
    !incline  = '---'
    !turn     = '---'
    !rotate   = '---'
    !planeRef = '---'

    -- ** Flange **
    if (!assemblyTables[!i].objectType() eq 'FLANGEASSEMBLYACTIVITY') then
      !flangeActivity = !assemblyTables[!i]

      -- Get the rotate directly from the object
      !rotate = !flangeActivity.offsetAngle().string(!!angleFMT)

      -- Get the angle and direction from a component
      -- If the angle of a component is 180 / 90 degree, make it as 0.
      !zAngle = !flangeActivity.component().orientation.zDir().string().part(2)
      if !zAngle.neq('WRT') then
        !rotate = !flangeActivity.component().orientation.zDir().string().part(2).real().string('D2')
      else
        !rotate = '0'
      endif
      -- Calculate the angle of a flange component depending on the number of its bolt holes
      !rotate = !this.getFlangeAngle(!flangeActivity.component(),!rotate.real()).string()

      !zDir = !flangeActivity.component().orientation.zDir()
      if !zDir.string().substring(1,1).eq('-') then
         !rotate = '-' & !rotate
         if !zAngle.eq('WRT')  then
           !rotate = substring(!rotate, 2)
         endif
      endif



      if (!rotate.match('9999').eq(1)) then
        !rotate = '?'
      endif

      -- Get the remarks directly from the object
      if (!flangeActivity.referencePlaneComponent().set() and !flangeActivity.referencePlaneComponent().badref().not()) then
        if (!flangeActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!flangeActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!flangeActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif

        -- Read position number
        !remarks = !prefix & !flangeActivity.referencePlaneComponent().tyseq
        if (!flangeActivity.referencePlaneComponent().type eq 'OLET') then
          !remarks = '---'
        endif
      else
        !remarks = '---'
      endif

    -- ** Branch Piece **
    elseif (!assemblyTables[!i].objectType() eq 'BRANCHPIECEASSEMBLYACTIVITY') then

      !branchActivity = !assemblyTables[!i]

      -- Get the rotate directly from the object
      !rotate  = !branchActivity.rotationAngle().string('D2')
      -- Get the incline directly from the object
      !incline = !branchActivity.inclinationAngle().string('D2')
      -- Get the turn directly from the object
      !turn    = !branchActivity.offsetAngle().string('D2')

      if !branchActivity.component().type.eq('TEE') then
        --<RM> P-38179 skip if the tee doesn't not have a cref set as we will not know which pipe piece the tee is associated with - start
        if !branchActivity.component().cref.unset() then
        skip
        endif
        --<RM> P-38179 skip if the tee doesn't not have a cref set as we will not know which pipe piece the tee is associated with - end
        --<RM> P-38179 skip only if the tee does not appear in the AELRFA attribute in one of the mto pipe pieces - start
        !skip = TRUE
        do !k from 1 to !this.mtoElements.size()
          !aelrfa = !this.mtoElements[!k].aelrfa
          handle ANY
            skip
          endhandle
          do !l from 1 to !aelrfa.size()
            if !aelrfa[!l].eq(!branchActivity.component()) then
              !skip = FALSE
            endif
          enddo
        enddo
        if !skip then
          skip
        endif
        --<RM> P-38179 skip only if the tee does not appear in the AELRFA attribute in one of the mto pipe pieces - end
      endif

      -- Get the remarks directly from the object
      if (!branchActivity.referencePlaneComponent().set() and !branchActivity.referencePlaneComponent().badref().not()) then
        if (!branchActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!branchActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!branchActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif

        -- Read position number
        !planeRef = !prefix & !branchActivity.referencePlaneComponent().tyseq
        !remarks = !planeRef & ' : ' & !branchActivity.branchConnection().string()
        if (!branchActivity.referencePlaneComponent().type eq 'OLET') then
          !remarks = '---'
        endif
      else
        !remarks = '---'
      endif


    -- ** Elbow **
    elseif (!assemblyTables[!i].objectType() eq 'ELBOWASSEMBLYACTIVITY') then

      !elbowActivity = !assemblyTables[!i]

      -- Get the turn directly from the object
      !turn = !elbowActivity.offsetAngle().nint().string()
      -- Get the remarks directly from the object
      if (!elbowActivity.referencePlaneComponent().set() and !elbowActivity.referencePlaneComponent().badref().not()) then
        if (!elbowActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!elbowActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!elbowActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif

        -- Read position number
        !remarks = !prefix & !elbowActivity.referencePlaneComponent().tyseq
        if (!elbowActivity.referencePlaneComponent().type eq 'OLET') then
          !remarks = '---'
        endif
      else
        !remarks = '---'
      endif


    -- ** Mitre **
    elseif (!assemblyTables[!i].objectType() eq 'MITREASSEMBLYACTIVITY') then

      !mitreActivity = !assemblyTables[!i]
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = !mitreActivity.cutAngle().string('D2')
      -- Get the turn directly from the object
      !turn = !mitreActivity.offsetAngle().string('D2')

      -- Get the remarks directly from the object
      if (!mitreActivity.referencePlaneComponent().set() and !mitreActivity.referencePlaneComponent().badref().not()) then
        if (!mitreActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!mitreActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!mitreActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !mitreActivity.referencePlaneComponent().tyseq
        !remarks = 'MITRE :' & !planeRef
        if (!mitreActivity.referencePlaneComponent().type eq 'OLET') then
          !remarks = '---'
        endif
      else
        !remarks = '---'
      endif

    -- ** Cut **
    elseif (!assemblyTables[!i].objectType() eq 'CUTASSEMBLYACTIVITY') then
      !cutActivity = !assemblyTables[!i]

      -- Get the incline from the object
      if (!cutActivity.arriveEnd()) then
        !incline = 'Start'
      else
        !incline = 'End'
      endif

      if (!cutActivity.referenceComponent().set() and !cutActivity.referenceComponent().badref().not()) then
        -- Read position number
        !refComponent = !this.mtoElements.findFirst(!cutActivity.referenceComponent()).string()
      else
        !refComponent = '---'
      endif

      !remarks = 'CUT :' & !refComponent & ' : ' & !cutActivity.finalLength().nint().string()

    -- ** Split **
    elseif (!assemblyTables[!i].objectType() eq 'SPLITASSEMBLYACTIVITY') then

      !splitActivity = !assemblyTables[!i]
      !remarks = 'SPLIT'
      !splitActivity = !assemblyTables[!i]

      -- Get the remarks directly from the object
      if (!splitActivity.referenceComponent().set() and !splitActivity.referenceComponent().badref().not()) then
        -- Read position number
        --<RM> 26/08/11 fix for P-40139 -start
        !refComponent = !this.getPartNo(!splitActivity.referenceComponent()).string()
        --<RM> 26/08/11 fix for P-40139 -end
      else
        !refComponent = '---'
      endif
      !remarks = 'SPLIT :' & !refComponent & ' : ' & !splitActivity.feedExcess().string(!!distanceFMT)

    -- ** Thread **
    elseif (!assemblyTables[!i].objectType() eq 'THREADASSEMBLYACTIVITY') then

      !threadActivity = !assemblyTables[!i]

      -- Get the incline from the object
      if (!threadActivity.arriveEnd()) then
        !incline = 'Start'
      else
        !incline = 'End'
      endif

      -- Get the remarks directly from the object
      !remarks = 'THREAD :' & !threadActivity.thread().string(!!distanceFMT) & ' : ' & !threadActivity.threadLength().string(!!distanceFMT)

    -- ** Insert **
    elseif (!assemblyTables[!i].objectType() eq 'INSERTASSEMBLYACTIVITY') then
      !insertActivity = !assemblyTables[!i]
      !remarks = 'INSERT :' & !insertActivity.insertLength().string(!!distanceFMT)

    -- ** Any other component **
    elseif (!assemblyTables[!i].objectType() eq 'COMPONENTASSEMBLYACTIVITY') then

      !componentActivity = !assemblyTables[!i]
        -- Get the rotate directly from the object
      !rotate = !componentActivity.rotationAngle().string(!!angleFMT)

      -- Get the remarks directly from the object
      if (!componentActivity.referencePlaneComponent().set() and !componentActivity.referencePlaneComponent().badref().not()) then
        if (!componentActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!componentActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!componentActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif

        -- Read position number
        !planeRef = !prefix & !componentActivity.referencePlaneComponent().tyseq
        !remarks = 'Ref Plane :' & !planeRef
        if (!componentActivity.referencePlaneComponent().type eq 'OLET') then
          !remarks = '---'
        endif
      else
        !remarks = '---'
      endif



    else
      -- ** Unexpected Activity **
      -- Get the remarks directly from the object
      !remarks = 'Unrecognised Activity'

    endif

    var !queryElements eval etext for all texp for $!this.noteRef

    !table = object ARRAY()

    do !query values !queryElements
      if (!query.empty() or !query eq 'unset') then
        !table.append('')
        skip
      endif

      if (!query.upcase() eq 'INDEX') then
        --<RM> P-38179 if this is a tee then we need to match its connection ref to a pipe piece. this is because the pipe piece
        --is appended to the mto list and the tee is not - start
        if !assemblyTables[!i].component().type.eq('TEE') then
          --find the pipe piece associated with this tee
          !ppieceItemFound = FALSE
          do !k from 1 to !this.mtoElements.size()
            !currComponent = !this.mtoElements[!k]
            !aelrfa = !this.mtoElements[!k].aelrfa
            handle ANY
              skip
            endhandle
            do !l from 1 to !aelrfa.size()
              if !aelrfa[!l].eq(!assemblyTables[!i].component().cref) then
                !ppieceItemFound = TRUE
                !ppieceItem = !currComponent
                break
              endif
            enddo
            if !ppieceItemFound then
              break
            endif
          enddo
          if !ppieceItemFound then
            !partNo = !this.mtoElements.findFirst(!ppieceItem).string()
          else
        !partNo = !this.mtoElements.findFirst(!assemblyTables[!i].component()).string()
          endif
        else
          !partNo = !this.mtoElements.findFirst(!assemblyTables[!i].component()).string()
        endif
        --<RM> P-38179 if this is a tee then we need to match it's connection ref to a pipe piece. this is because the pipe piece
        --is appended to the mto list and the tee is not - end
        !table.append(!partNo)

      elseif (!query.upcase() eq 'ROTATE') then
        !table.append(!rotate)

      elseif (!query.upcase() eq 'INCLINE') then
        !table.append(!incline)

      elseif (!query.upcase() eq 'TURN') then
        !table.append(!turn)

      elseif (!query.upcase() eq 'REMARKS') then
        !table.append(!remarks)

      endif
    enddo

    !insertStr = ''
    do !j indices !table
      if (!j eq !table.size()) then
        !insertStr = !insertStr & !table[!j]
      else
        !insertStr = !insertStr & !table[!j] & ','
      endif

    enddo
    !result.append(!insertStr)
  enddo
  --<RM> P-38179 reorder the results list so that we get it in ascending part number order - start
  !partNumArray = object ARRAY()
  !errIndex = 1000
  do !i from 1 to !result.size()
    !index = !result[!i].split(',')[1].real()
    handle ANY
      !partNumArray[!errIndex] = !result[!i]
      !errIndex = !errIndex + 1
    elsehandle NONE
      if !index.unset() then
        !partNumArray[!errIndex] = !result[!i]
        !errIndex = !errIndex + 1
      else
        !partNumArray[!index] = !result[!i]
      endif
    endhandle
  enddo
  !partNumArray.compress()
  !result = !partNumArray
  --<RM> P-38179 reorder the results list so that we get it in ascending part number order - end

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: get bending table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBendingTable() is ARRAY

  -- get bending elements
  !bendElements = object ARRAY()
  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)
  !queryElements = !this.queryElements.evaluate(object BLOCK('!this.queryElements[!evalindex].etex'))

  -- get bend element
  do !entry values !this.mtoElements
    skip if (!entry.type ne 'PPIECE')

    !ppieceComps = !entry.cmprfa
    do !comp values !ppieceComps
      skip if (!comp.type ne 'BEND')
      !bendElements.append(!comp)
    enddo
  enddo

  -- get bending tables & pipe pieces
  !this.pipeSpoolManager = object PIPESPOOLMANAGER()
  !bendingTables    = !this.pipeSpoolManager.getBendingTables(!this.spoolElement)
  !pipePieces       = !this.pipeSpoolManager.getPipePieces(!this.spoolElement)

  !result = object ARRAY()

  -- find index of bending table
  do !entry values !pipePieces
    !index = -1
    do !i indices !bendingTables

      if (!bendingTables[!i].pipePiece() eq !entry) then
        !index = !i
        break
      endif
    enddo
    skip if (!index eq -1)

    -- get bending table
    !bendingTable = !bendingTables[!index]
    handle any
      skip
    endhandle

    -- get bending information
    !tableArray = ARRAY()

    !a = !bendingTable.activities()
    if !a.size()lt(!bendElements.size()) then
      !size = !a.size()
    else
      !size = !bendElements.size()
    endif

    do !i from 1 to !size

     !bendActivities = !bendingTable.activities()[!i]

      !bendShipPos  = !!comTranslateShipPosition(!bendElements[!i].pos.wrt( /* ))
      !bendWorldPos = !bendElements[!i].pos.wrt( /* )

      !table = object ARRAY()
      do !query values !queryElements

        if (!query.empty() or !query eq 'unset') then
          !table.append('')
          skip
        endif

        if (!query.upcase() eq 'INDEX') then
          if (!entry.aelrfa[1].type eq 'BRAN') then
            !table.append(!entry.aelrfa[1].ptnhead)
          else
            !table.append(!entry.aelrfa[1].ptntube)
          endif

        elseif (!query.upcase() eq 'FEED') then
          !table.append(!bendActivities.feed().nint().string())

        elseif (!query.upcase() eq 'ROTATE') then
          !table.append(!bendActivities.rotate().nint().string())

        elseif (!query.upcase() eq 'BEND') then
          !table.append(!bendActivities.bend().nint().string())

        elseif (!query.upcase() eq 'BENDRAD') then
          !table.append(!bendElements[!i].radius.nint().string())

        elseif (!query.upcase() eq 'BENDPOINT') then
          -- Bend point is not set anywhere above ??? TO DO
          !table.append('---')
        elseif (!query.upcase() eq 'BENDMACH') then
          !table.append(!bendingTable.bendingMachine().namn)

        elseif (!query.upcase() eq 'SHIPPOSX') then
          !table.append(!bendShipPos[1])

        elseif (!query.upcase() eq 'SHIPPOSY') then
          !table.append(!bendShipPos[2])

        elseif (!query.upcase() eq 'SHIPPOSZ') then
          !table.append(!bendShipPos[3])

        elseif (!query.upcase() eq 'BENDPOSX') then
          !table.append(!bendWorldPos.east.nint())

        elseif (!query.upcase() eq 'BENDPOSY') then
          !table.append(!bendWorldPos.north.nint())

        elseif (!query.upcase() eq 'BENDPOSZ') then
          !table.append(!bendWorldPos.up.nint())

        else
          !table.append('')
        endif

      enddo

      !tableArray.append(!table)
    enddo

    do !k indices !tableArray
      !insertStr = ''
      do !j indices !tableArray[!k]

        skip if (!tableArray[!k][!j].empty())
        handle any
        endhandle

        if (!j eq !tableArray[!k].size()) then
          !insertStr = !insertStr & !tableArray[!k][!j]
        else
          !insertStr = !insertStr & !tableArray[!k][!j] & ','
        endif

      enddo
      !result.append(!insertStr)
    enddo
  enddo

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getEndpointTable
--
-- Description: get end-point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getEndpointTable() is ARRAY

  !arriveRef = !this.spoolElement.psarfa
  !leaveRef  = !this.spoolElement.pslrfa

  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)
  !posList = object ARRAY()

  -- Get the Start Positions
  do !entry values !arriveRef
    if (!entry.type eq 'BRAN') then
      !href = !entry.href
      if unset(!href) eq false then
        if !href.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !posList.append(!entry.hpos.wrt(/* ))
    else
      !posList.append(!entry.lpos.wrt(/* ))
    endif
  enddo


  -- Get the End Positions
  do !entry values !leaveRef
    if (!entry.type eq 'BRAN') then
      !tref = !entry.tref
      if unset(!tref) eq false then
        if !tref.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !posList.append(!entry.tpos.wrt(/* ))
    else
      !posList.append(!entry.apos.wrt(/* ))
    endif
  enddo


  !result = object ARRAY()
  !posList.unique()

  var !queryElements eval etext for all texp for $!this.noteRef

  do !i indices !posList

    !table = object ARRAY()

    !shipPositions = !posList[!i]

    do !query values !queryElements
      if (!query.empty() or !query eq 'unset') then
        !table.append('')
        skip
      endif

      if (!query.upcase().occurs('INDEX') gt 0) then
        !table.append('C' & !i)
      elseif (!query.upcase() eq 'SHIPXPOS') then
        !table.append(!shipPositions.east.nint())

      elseif (!query.upcase() eq 'SHIPYPOS') then
        !table.append(!shipPositions.north.nint())

      elseif (!query.upcase() eq 'SHIPZPOS') then
        !table.append(!shipPositions.up.nint())

      else
        !table.append('')

      endif

    enddo

    !insertStr = ''
    do !j indices !table
      if (!j eq !table.size()) then
        !insertStr = !insertStr & !table[!j]
      else
        !insertStr = !insertStr & !table[!j] & ','
      endif
    enddo
    !result.append(!insertStr)
  enddo

  --Adjust the size of the area for the endpoint table
  !drawingType = func of drwg
  if (!drawingType.upcase().occurs('2D SKETCH') gt 0) then
    !isSketchType = true
  else
    !isSketchType = false
  endif

  if (!isSketchType) then
    var !rect collect all rect for $!this.noteRef
    !sizeOfEndPoint = !result.size() + 2
    !rect[1].dbref().nlcolour = 1
    !rect[1].dbref().nlstyle = 8001
    !defaultLength = 4 * !sizeOfEndPoint
    !rect[1].dbref().ylength = !defaultLength
  endif

  return !result
endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getWeldingTable
--
-- Description: get welding table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWeldingTable() is ARRAY
  -- Core returns a weldingMachine dbref but this is not on sketch


  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()

  -- Welding Table
  -- Get the pipe piece data for the pspool
  !weldingTables = !this.spoolElement.pprfa

  -- Initialise variable
  !result = ARRAY()
  !newResult = ARRAY()

  do !i indices !weldingTables
    --Get the data for the weld arrive / leave flange from the pipe piece
    !pipePiece =  !weldingTables[!i]
    !weldArrive = !pipePiece.awdarr
    !weldLeave = !pipePiece.awdlev
    !pieceComponent = !this.spoolElement.belrfa

    -- Which welding Table
    !arriveFlangeTag = ''
    !leaveFlangeTag  = ''
    !relativeAngle   = ''

    -- Get the connection 1
    if (!weldArrive) then
      -- Get the flange tag index for the MTO Elements array .findFirst method
      !arriveFlangeTag = !this.mtoElements.findFirst(!pieceComponent.first()).string()
      handle ANY
        !!pipeSketchesLog('Welding Table Arrive Flange error')
      endhandle
    endif

    -- Get the connection 2
    if (!weldLeave) then
      -- Get the flange tag index for the MTO Elements array .findFirst method
      !leaveFlangeTag = !this.mtoElements.findFirst(!pieceComponent.last()).string()
      handle ANY
        !!pipeSketchesLog('Welding Table Leave Flange error')
      endhandle
    endif

    -- Get the relative angle directly from the object
    !weldingTableForAngle = !pipeSpoolManager.getWeldingTables(!this.spoolElement)
    !relativeAngle = !weldingTableForAngle[!i].angle().string('D2')
    handle ANY
      !!pipeSketchesLog('Welding Table relative angle error')
    endhandle

    -- Only record result if relevant
    if (!arriveFlangeTag.eq('') and !leaveFlangeTag.eq('') and !relativeAngle eq '0') then
      skip
    elseif !weldArrive.eq(false) and !weldLeave.eq(false) then
    -- Skip if there is no welding table available.
      skip
    else
      !result[!i] = ARRAY()
      !result[!i][1] = !arriveFlangeTag
      !result[!i][2] = !leaveFlangeTag
      !result[!i][3] = !relativeAngle
    endif

    !insertStr = ''

    do !j indices !result[!i]
      if (!j eq !result[!i].size()) then
        !insertStr = !insertStr & !result[!i][!j]
      else
        !insertStr = !insertStr & !result[!i][!j] & ','
      endif
    enddo
    !newResult.append(!insertStr)

  enddo

  -- Compress the result array
  !result.compress()
  !result.unique()

--if the result is null, create a minimum array for the welding table.
--Otherwise there will no line for the table.
  if !result.size().eq(0)then
    !result = ARRAY()
    !result[1] = ARRAY()
    !result[1][1] = ''
    !result[1][2] = ''
    !result[1][3] = ''
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  elseif !result.size().eq(1)then
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  endif

  return !result
endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      checkForIsoAndBoss
--
-- Description: get end-point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkForIsoAndBoss()

-- This method will check for the existence of a boss connection and
-- that the template being used contains an isometric detail view (Isodraft)
-- If so it will add a warning to the error list
-- This check is being made because Isodraft does not support boss connections.

-- Check for isometric view
  !isoExists = false
  var !isoViewCheck coll all vnot with func eq 'OLAY_POS' for $!this.dwgTmplName
  if !isoViewCheck.size().gt(0) then
    !isoExists = true
  endif
-- Check for boss
  !bossExists = false

  do !testForBoss values !this.mtoElements
    if !testForBoss.type.eq('OLET') and !testForBoss.catref.compType inset('STUH','STUT','BOSH','BOST','TAPH','TAPT','SSUH','SSUT','SEXH','SEXT','SSAH','SSAT') then
      !bossExists = True
    endif
  enddo

  if (!isoExists) and (!bossExists) then
    !this.writeErrorMessage(!this.spoolElement,'Warning - Boss connection found in spool. Please check dimensions.')
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getFlangeAngle
--
-- Description: calculate the angle of a flange component
-- depending on the number of its bolt holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R            DBREF         Flange component
--    2     R            REAL            Angle of the Z direction of a component
-- Return:
--   [Data Type] [Description]
--    REAL            Get the actual angle of a component
--
------------------------------------------------------------------------
define method .getFlangeAngle(!component is DBREF, !rotate is REAL) is REAL

  --Get the number of bolt holes from a component
  !boltRef = !component.spref.bltref
  if !boltRef.unset() then
    return !rotate
  else
    !numBoltHole = !boltRef.noff
    if !numBoltHole.eq(0) then
      return !rotate
    endif
  endif

  --Calculate the maximum angle of a component
  !maxAng = (360 / !numBoltHole) / 2
  !flangeAngle = REAL()
  if !rotate gt !maxAng  then
    !flangeAngle = !rotate - (INT(!rotate / !maxAng) * !maxAng)
  elseif !rotate eq !maxAng  then
    !flangeAngle = 0
  else
    return !rotate
  endif
  return !flangeAngle

endmethod
