--
--  Description:     Object for storing and managing tapping connections
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCoupling()                    -                   if we are dealing with a tapping we need to add a
--  adjustPlaneToCentreline()        -                   in order to work out the offset radius we need accurately position the
--  applyRotation(PLANE,ARRAY,ARC)   PLANE
--  between()                        BOOLEAN             checks to see if the opposite end head/tail is between the current position
--  branchName(PIPEBRANCH)           STRING              Work out a new branch name
--  calculateAngle()                 -                   method to work out the insert angle from centreline
--  calculateCentreline()            -                   Draw the arc representing the rotation angle from the plane
--  calculateInsertPosition(STRING)  -
--  calculateRotationDirection()     REAL                method to work out the angle projected onto the plane
--  calculateRotationPlane()         -                   create an arc object representing the direction from plane
--  clearAids()                      -                   Draw the arc representing the rotation angle from the plane
--  clearPins()                      -
--  connect()                        -                   callback for the connect/reconnect button
--  connectBranch(STRING)            -                   new pipca method for connecting to !this.ptap
--  createCouplingInLine(DBREF)      -
--  createNewBranch()                -                   create a new branch for inserting into the pipe
--  createPtapConnection(BOOLEAN)    -
--  createSubComponent(BOOLEAN)      -                   method for creating new pipca elements for branch connections
--  drawArc(ARC)                     -                   Draw the arc representing the rotation angle from the plane
--  drawFitting(BOOLEAN,REAL,REAL)   -
--  drawLine(LINE)                   -                   Draw the arc representing the rotation angle from the plane
--  drawNewBranch(BOOLEAN,POSITION)  -
--  drawPlane(BOOLEAN,PLANE)         -
--  getAidNumbers()                  -                   get a set of aid numbers for drawing graphics
--  getBasicPosition(REAL,PLANE,STRING) ARRAY               method to provide orthogonal options for the rough pick
--  getBendArc(DBREF)                ARC
--  getBendPosition(POSITION,DBREF)  PLANE
--  getBendPosition(POSITION,DBREF,ARRAY) PLANE
--  getBestFit(ARRAY)                POINTVECTOR
--  getBranchHeadAndTail(DBREF)      -                   get branch href tref
--  getBranchList()                  -                   Get a list of existing branches
--  getComponent()                   -                   Go and work out the branch connection position and
--  getConnectedEnd()                -                   get the connection details this.ptap this.pipca
--  getConnectionProperties(DBREF)   -
--  getConnectionProperties(DBREF,BOOLEAN) -                   method to setup the graphical aid cylinder representing the
--  getCouplingSpref()               -                   Constructor for use with existing connections
--  getDefaultPositions()            -                   method to work out a simple insert depth and branch positions
--  getExistingInsert()              -                   method to get the insert depth of an existing component
--  getExistingInsertDepth(DBREF)    REAL
--  getInsertComponentAndPosition(POINTVECTOR) ARRAY
--  getInsertComponentDetails()      -                   method called by update branch - purpose to set cdia and
--  getMaxBore()                     BORE
--  getNewBranchName()               STRING
--  getNewDirection(REAL)            DIRECTION
--  getNewSurfacePosition(DIRECTION) ARRAY
--  getNewSurfacePositionFromVector(ARRAY,DIRECTION) -                   method to set the new surface position and direction
--  getPTAPLeaveTube()               DBREF               make sure we get the same lstu as the prev component
--  getPlaneSize()                   REAL
--  getRadius(DBREF)                 REAL
--  getTubePosition(POSITION,DBREF)  PLANE
--  getp3Bore(STRING)                -                   method to get the p3 Bore because this needs to be in mm as we check the catalogue parameters
--  initialiseForResetDirection()    -                   sets up the object for the specialbranchdirection form
--  makePlane(POSITION,DIRECTION)    PLANE               makes a plane object from a position and a direction
--  moveBranch(DBREF)                -                   moves the branch head/tail to the calculated position
--  nearestEnd()                     BOOLEAN             checks to see if the opposite end head/tail is between the current position
--  nudgeAlong(ARRAY)                -
--  pipeTappingConnection()          -
--  pipeTappingConnection(DBREF,DBREF) -
--  pipeTappingConnection(DBREF,DBREF,STRING,STRING,POINTVECTOR,DBREF,STRING) -
--  pipeTappingConnection(DBREF,STRING,STRING) -
--  planeTags()                      -                   Works out a set of direction tags to add to the drawn plane
--  repositionBranch(POINTVECTOR)    -                   method to move the new branch to a new position
--  rotateAroundPlane(REAL)          -                   method to fire a vector down the plane at the passed angle
--  set()                            BOOLEAN
--  setArcTol(BOOLEAN)               -                   set the graphics arctol to speed up the pipeintersections call
--  setBranchBores(DBREF,REAL)       -
--  setConnectionTypes()             -                   sets the branch head/tail connection
--  setInsert(REAL)                  -                   method called to work out the insert depth for each fitting
--  setNote(STRING)                  -                   method called to set connection note
--  setShop(DBREF)                   -                   Sets shop attribute to from specification
--  showPositions(BOOLEAN)           -
--  testConnection()                 -
--  testCouplingType(STRING)         BOOLEAN             We need to make sure that the
--  testForExistingCoupling(DBREF)   BOOLEAN             if there is an existing coupling and it is the right compType
--  testForNegative(REAL)            REAL                check if the existing connection insert is negative
--  updateBranch(EDGPICKDATA)        -
--  updateParameters(STRING,BOOLEAN) BOOLEAN
--
define object PIPETAPPINGCONNECTION

   --point in the main branch where the ptap should be inserted
   member .insertComponent is DBREF
   -- save the wall thickness for calculating insert depth
   member .wallThickness is REAL
   -- type COMPONENT or TUBE
   member .componentOrTube is STRING
   -- each tapping point relies on a pipca
   member .pipca is DBREF
   -- spec to get ptaps from
   member .ptapSpec is DBREF
   -- save the ptap if it is already connected.
   member .ptap is DBREF
   --save the stype if it exists
   member .stype is STRING
   -- if there is a problem with the branch connection set status to false
   member .status is BOOLEAN
   -- member to say if the connection is still being modified
   member .built is BOOLEAN
   --head or tail

   member .headOrTail is STRING
   -- componentType passed from the form
   member .componentType  is STRING
   -- store the values of the current component height
   member .chei is REAL
   -- store the current component diameter
   member .cdia is REAL
   -- store the current component fitting length
   member .flen is REAL
   -- position of intersection on tube
   member .surfacePosition is POSITION
   --- current surfaceposiion
   member .currentSurfacePosition       is POSITION

   member .newSurfacePosition           is POSITION
   -- direction of tube intersection
   member .branchDirection is DIRECTION
   -- current branch direction
   member .currentBranchDirection       is DIRECTION

   member .newBranchDirection           is DIRECTION
   -- hold the actual head/tail position of the connected branch

   member .currentRotationAngle         is REAL
   member .newRotationAngle             is REAL

   member .branchPosition is POSITION
   -- hold the inserted position of the branch
   member .insertPosition is POSITION
   -- angle from centreline
   member .insertAngle is REAL
   -- store the insertDepth of the picked component
   member .insertDepth is REAL
   -- store the actual insert depth
   member .actualInsertDepth is REAL
   -- store the default insert depth for the current component
   member .defaultInsertDepth is REAL
   -- design param for pbor1
   member .designParam is REAL
   -- hold the connection note (pipca description)
   member .connectionNote is STRING
   --
   -- the spref of the selected ptap is saved prior to the actual connection
   -- save the existing head tail POSITION for a connected branch
   member .existingPosition is POSITION
   -- interim position
   member .newIntersectPos is POSITION
   -- spref of selected ptap
   member .teeSpref is DBREF
   -- main branch
   member .mainBranch is DBREF
   -- connected branch
   member .connectedBranch is DBREF
   --existing element reference
   member .existingElement is DBREF
   --Stub in Tube Od
   member .stubInTubeOD is REAL
   -- Main Tube OD
   member .mainTubeOD is REAL
   --main component lBore
   member .mainBore is BORE
   -- p3Bore
   member .p3Bore is BORE
   -- plane
   member .plane is PLANE
  -- actual coupling
   member .coupling is DBREF
   -- spref of the current coupling type
   member .couplingSpref is DBREF
   -- mode new or existing
   member .mode is STRING
   -- new branch
   member .newBranch is DBREF
   -- new branch name to be used for the current new branch
   member .newBranchName is STRING
   -- list of branches for testing existing names
   member .branchList is ARRAY
    -- store the current pipe to be able to add branches to it
   member .pipe is DBREF
   -- type of connection already in place
   member .existingType is STRING
   -- head reference
   member .href is DBREF
   -- tail reference
   member .tref is DBREF
   member .mainVector is POINTVECTOR
   -- arc defining the ben extents
   member .bendArc is ARC
   -- member to return if the object is a base object or has been modified.
   member .objectSet is BOOLEAN
   -- centreline
   member .centreLine is LINE
   -- current bend arc
   member .rotationArc                  is ARC
   -- another pipeintersection (needs to be rationalised
   member .intersect is PIPEINTERSECTION
   -- starting angle from control
   member .initialAngle is REAL
   -- direction of the 0 line on the plane
   member .majorDirection is POINTVECTOR
   -- aid tag numbers
   member .tagAids                      is REAL
   -- arctol for performance issues
   member .arctol                       is REAL

endobject
--End of object definition
------------------------------------------------------------------------
--
-- Method:     .pipeTappingConnection (0)
-- default constructor
--
--------------------------------------------------------------------------
define method .pipeTappingConnection()

!this.objectSet = FALSE

endmethod

------------------------------------------------------------------------
--
-- Method:     .set
-- returns if the object is set or not
--
--------------------------------------------------------------------------
define method .set() is BOOLEAN

return !this.objectSet

endmethod

------------------------------------------------------------------------
--
-- Method:     .pipeTappingConnection (1)
--
-- Description: Constructor
-- This is the new branch constructor, called by the main form after identifying the following:
-- !insertComp - component which owns the connection or the component before an ptap
-- !type - 'COMPONENT' or 'TUBE' Where the branch connection is in the main branch
-- !end - 'HEAD' or 'TAIL' The connected end of the branch
-- !vector - a POINTVECTOR at the actual surface intersection of the branches
-- !branch - The connected branch
-- !componentType -  as below
-- 'STU' 'Insert Connection'
-- 'SSU' 'Surface Connection'
-- 'SSA' 'Saddle Connection'
-- 'SEX' 'Extruded Connection
-- 'TAP' 'Boss Connection'
-- Note: Boss Connection is generic and needs a specific component
------------------------------------------------------------------------
define method .pipeTappingConnection(!mainBranch is DBREF,!insertComp is DBREF,!type is STRING,!end is STRING,!vector is POINTVECTOR,!branch is DBREF,!componentType is STRING )
   !this.objectSet = TRUE
   !this.getAidNumbers()

   !this.getBranchHeadAndTail(!branch)

   !this.mainBranch = !mainBranch


   !this.mode = 'EXISTING'
   -- default built attribute
   !this.built = TRUE
   !this.insertComponent   = !insertComp
   !this.branchDirection   = !vector.direction
    -- position of intersection on tube
   !this.surfacePosition   = !vector.position
   !this.branchPosition    = !this.surfacePosition
   !this.componentOrTube   = !type
   !this.componentType     = !componentType
   !this.connectedBranch   = !branch
   !this.branchDirection   = !vector.direction
   !this.wallThickness     = !insertComp.ltwall
   handle ANY
    !this.wallThickness     = !comp.hwallth
    handle ANY
      !this.wallThickness = 7mm
    endhandle
  endhandle
  if !this.insertComponent.type.eq('BRAN') then
    !this.mainTubeOD = !this.insertComponent.phod
    !this.wallThickness     = !this.insertComponent.hwallth
    handle ANY
      !this.wallThickness = 7mm
    endhandle
  else
   !this.mainTubeOD = !this.insertComponent.lod
   !this.wallThickness     = !this.insertComponent.ltwall
   handle ANY
     !this.wallThickness = 7mm
   endhandle
  endif
    !this.mainBore   = !this.insertComponent.lBore
  handle ANY
    !this.mainBore   = !this.insertComponent.hBore
  endhandle
  !this.ptapSpec = pspe of bran of $!this.insertComponent

  !this.componentOrTube = !type
  !this.headOrTail = !end
  !this.getp3Bore(!end)
  -- go and get the connection references if already connected
  !this.updateParameters(!componentType,FALSE)
  handle (2,434)
    --error in updateParameters
    --this handles the error which is produced if we have a stub in branch that is larger than the main branch
    --we return an empty object which does not contain any connections
    !this = object PIPETAPPINGCONNECTION()
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:     .pipeTappingConnection (2)
--
-- Description: Constructor for use with existing connections
-- called after apply to update existing components
-- and presumably if we select an existing branch
-- !existingComp is the href/tref of the connected branch
-- !branch is the connected branch
--
------------------------------------------------------------------------
define method .pipeTappingConnection(!existingComp is DBREF,!branch is DBREF )

  !this.mainBranch = !!pipeTappings.mainBranch

  -- validate the object
  !this.objectSet = TRUE
  !this.getAidNumbers()

  -- get the head and tail references
  !this.getBranchHeadAndTail(!branch)
  !this.built = TRUE
  if !existingComp.type inset ('PTAP','PIPCA') then
    !this.existingType = !existingComp.type
    !this.existingElement    = !existingComp
    !this.mode = 'UPDATE'
  else
    !!alert.error('This application is unsuitable for connecting $!existingComp.type elements')
    return
  endif

  -- get the pipca/ptap data
  !this.getConnectedEnd()
  if !this.existingType.eq('PIPCA') then
    !this.ptap = !existingComp.owner
    !this.pipca = !existingComp
  else
    -- its a pipca
    !this.ptap = !existingComp
    !this.pipca = !existingComp.members[1]
  endif
  !vector = object POINTVECTOR()
  if !this.headOrTail.eq('HEAD') then
    !vector.position = !branch.hPos
    !vector.direction = !branch.hDir.wrt(/* ).opposite()
  else
    !vector.position = !branch.tPos
    !vector.direction = !branch.tDir.wrt(/* ).opposite()
  endif

  --go and find the surfaceposition
  !s =  !this.getInsertComponentAndPosition(!vector )
  !this.surfacePosition = !s[1][4].position

  !this.insertComponent = !this.ptap
  -- this is where we need to differentiate between a straight pipca connection and an ptap with a pipca
  -- set the connected branch to the passed branch
  !this.connectedBranch   = !branch
  -- set the Connection type to be 'STU' 'SSU' 'SSA' 'SEX' 'TAP'  !dtext[1] = 'Insert Connection'
  !this.componentType = !this.pipca.purpose
  if !this.componentType.unset() then
    !this.componentType = 'STU'
  endif
  -- need to sort out variable names ptap/pipca
  !this.designParam  = !this.pipca.bore.real()
  !this.actualInsertDepth = !this.pipca.depth
  !this.connectionNote = !this.pipca.description
  if !this.headOrTail.eq( 'HEAD' ) then
    !this.p3Bore = !this.connectedBranch.hBore
    !this.stubInTubeOD = !this.connectedBranch.phod
    handle ANY
      !this.stubInTubeOD = !this.connectedBranch.hBore
    endhandle
    !this.branchPosition = !this.connectedBranch.hPosition.wrt(/* )
    !this.branchDirection = !this.connectedBranch.hDirection.wrt(/* )
  else
    !this.headOrTail        = 'TAIL'
    !this.p3Bore = !this.connectedBranch.tBore
     !this.stubInTubeOD = !this.connectedBranch.ptod
     handle ANY
       !this.stubInTubeOD = .connectedBranch.tBore
     endhandle
     !this.branchPosition = !this.connectedBranch.tPosition.wrt(/* )
     !this.branchDirection = !this.connectedBranch.tDirection.wrt(/* )
  endif
  !this.wallThickness     = !existingComp.ltwall
  handle ANY
    !this.wallThickness = 7mm
  endhandle

  !this.mainTubeOD  = !this.ptap.lod
  !this.mainBore    = !this.ptap.lBore
  !this.ptapSpec   = !this.ptap.spown

  -- has the existing branch got a coupling?
  -- if so
  -- go and get the properties of the connection catref

  -- check to see if we already have a coupling
  !this.getCouplingSpref()

  -- method to get the standard chei flen cdia
  -- not sure if this is needed ???????????????????????????
  !this.getConnectionProperties(!this.coupling)

  -- this works out another insert
  --!this.getExistingInsert()
  -- get the default insert
  !this.getDefaultPositions()

-- we need to do something here to get the currentlist values
  !this.calculateAngle()
  handle ANY
   !this.insertAngle = 90
  endhandle

   if !existingComp.type.eq('PIPCA') then
      !this.componentOrTube = 'COMP'
   else
      !this.componentOrTube = 'TUBE'
   endif

  !this.testConnection()

endmethod
--End of method

------------------------------------------------------------------------
--
-- Method:     .pipeTappingConnection (3)
--
-- Description: Constructor for use with new branches
-- sets up the object with an initial name and anything else it can derive
-- from the main branch
--
------------------------------------------------------------------------
define method .pipeTappingConnection(!branch is DBREF,!componentType is STRING,!bore is STRING)

-- validate the object
  !this.objectSet = TRUE
  !this.getAidNumbers()

!this.getBranchHeadAndTail(!branch)
-- set the mainBranch
!this.mainBranch = !branch
!this.mainBore = !this.getMaxBore()
 -- store the current pipe to be able to add branches to it
!this.pipe =  !this.mainBranch.owner

-- get a list of branches
!this.getBranchList()

-- now set up the new branch name
!this.newBranchName = !this.getNewBranchName()

!this.componentType = !componentType

!this.p3Bore = object BORE(!bore)

  !this.mode = 'NEW'
  !this.built = FALSE

-- at this point we only need to populate the branch name gadget
--and the object is done

endmethod

------------------------------------------------------------------------
--
-- Method:     .getAidNumbers()
--
-- Description: get a set of aid numbers for drawing graphics
--
------------------------------------------------------------------------
define method .getAidNumbers()

 -- Aid Tags
  !this.tagAids      =   !!pipeTappings.objecttags

endmethod

------------------------------------------------------------------------
--
-- Method:     .createNewBranch()
--
-- Description: create a new branch for inserting into the pipe
--
------------------------------------------------------------------------
define method .createNewBranch()

-- Initialise Variables
  !reference    = !!ce

  -- Move to pipe
  !!ce          = !this.mainBranch
  pipe
  handle ANY
    return
  endhandle
  !this.pipe = !!ce

  -- ge a list
  !this.getBranchList()

  -- Create new branch
  if(!this.pipe.mCount('BRAN') gt 0) then
    var !mode MODE
    FORWARDS
    !!ce        = !this.pipe.members[!this.pipe.mCount('BRAN')]
    $!<mode>
  endif

  NEW BRANCH
  name $!!pipeTappings.branchName
  handle ANY
  endhandle
  !this.newBranch  = !!ce
  !this.connectedBranch = !!ce

  -- set the Bore according to the current Bore gadget
  !this.setBranchBores(!!ce, 0)

  -- If there are no branches defined, then define a temporary pipe branch
  -- object to derive the name
  !newBranch    = object PIPEBRANCH(!this.newBranch)
  if(!this.branchList.size() ge 1) then
    !lastBranch = !this.branchList.last()
    !newBranch.idRule       = !lastBranch.idRule
    !newBranch.idSeparator  = !lastBranch.idSeparator
  endif

  -- we need to update the branch to reflect what has just happened.
  !this.mode = 'NEW'
  -- update the form gadgets
  !!pipeTappings.setConstructionStage(2)
  !!ce = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      .getInsertComponentAndPosition
--
-- Description: sorts through a multiple list of head and tail components
-- to find the best match
--
--
------------------------------------------------------------------------
define method .getInsertComponentAndPosition(!inputVector is POINTVECTOR )is ARRAY

 !allHits = ARRAY()
 !distance = 1000000

 !list = !this.mainBranch.members
 !list.insert(1,!this.mainBranch)
 -- set the arctol to speed multiple intersects
 !this.setArcTol(TRUE)

 do !a values !list
     !vector = object POINTVECTOR()
     !element = !a
     -- type is 'ELEMENT'
     !vector = !this.intersect.intersection(!a,!inputVector)
     if !vector.set() then
        -- try to get the smallest distance between head/tail and insert position
        !test = !inputVector.position.distance(!vector.position)
        !return[1] = 'COMPONENT'
        !return[2] = !inputVector.direction.opposite()
        !return[3] = !a
        !return[4] = !vector
        if !test.leq(!distance) then
          !distance = !test
          !allHits[1] = (!return)
        endif
     endif
     -- type is 'TUBE'
     !vector = !this.intersect.impliedTubeIntersection(!a,!inputVector)
     if !vector.set() then
         !test = !inputVector.position.distance(!vector.position)
         !return[1] = 'TUBE'
         !return[2] = !inputVector.direction.opposite()
         !return[3] = !a
         !return[4] = !vector
         if !test.leq(!distance) then
          !distance = !test
          !allHits[1] = (!return)
        endif
     endif
enddo

-- set the arctol back to what it was
!this.setArcTol(FALSE)

return  !allHits

endmethod


------------------------------------------------------------------------
--
-- Method:     updateBranch()
--
-- Description: method called from picking the point on a pipe at which
-- it is to be placed

-- this now needs be modified to work out orthogonal projections
--
------------------------------------------------------------------------
define method .updateBranch(!data is  EDGPICKDATA )


  !this.mode = 'NEW'
  !this.newBranch.hPos = n0
  !this.newBranch.tPos = n0
  !this.newBranch.hstu = nulref

  !type       = !data.item.type
  if !type.eq('BRAN') then
     !element  = !data.item
     if !data.tubing.eq( 'HEAD' ) then
       !insertComp = !element
     endif
  else
     if !data.item.owner.neq(!this.mainBranch) then
       -- reject it
          !!alert.error('The branch you have selected is not the Main Branch')
          !!pipeTappings.pickPoint.active = TRUE
          !!pipeTappings.adjust.active = FALSE
       return
     else
       !element  = !data.item.owner
       !this.insertComponent = !data.item
     endif
  endif

   -- Process element
  if(undefined(!element)) then
    !element = object DBREF()
  endif

  if !this.intersect.aidTag.set() then
    !this.intersect.tidy()
  endif
  --set the arctolerance to speed up picking
  !this.setArcTol(TRUE)

 !t = !data.pickLine
 !e = !data.item
   if !data.tubing.eq( 'LEAVE').or(!data.tubing.eq('HEAD')) then
     --!insert = 'TUBE'
     !vector = object POINTVECTOR()
     !vector = !this.intersect.impliedTubeIntersection(!e,!t)
   else
     !vector = object POINTVECTOR()
     --!insert = 'COMPONENT'
     !vector = !this.intersect.intersection(!e,!t)
   endif

   --set the arctol back
   !this.setArcTol(FALSE)

   !this.branchDirection = !vector.direction
   !this.surfacePosition = !vector.position


   -- go via a long tortuous route to make picks orthogonal - not yet implemented
    --!vector = !this.intersect.impliedTubeIntersection(!e,!vector)

     -- run a new method for getting the insert position
   !insertData = !this.getInsertComponentAndPosition(!t)
   --!insertData = !this.getInsertComponentAndPosition(!vector)
   -- this returns an array of intersections in the form
   -- !return[1] = 'COMPONENT'  or 'TUBE'
   -- !return[2] = !inputVector.direction.opposite()  a vector for the h/tdir
   -- !return[3] = !a The element which is to be used as the insert element
   if !insertData.unset() then
     !!alert.error('Unable to calculate an insert position from the picked point')
     !!pipeTappings.pickPoint.active = TRUE
     !!pipeTappings.adjust.active = FALSE
     return
   endif
   !this.componentOrTube = !insertData[1][1]
   !this.insertComponent = !insertData[1][3]
   -- get the tubeData

  -- !this.branchDirection = !insertData[1][2]

  !this.mainBore   = !this.insertComponent.lBore
  handle ANY
    !this.mainBore   = !this.insertComponent.hBore
  endhandle

   !this.branchPosition    = !this.surfacePosition
   -- get the insert angle
   !this.calculateAngle()

   !this.repositionBranch(!vector)

endmethod

------------------------------------------------------------------------
--
-- Method:     .repositionBranch
--
-- Description: method to move the new branch to a new position
--
------------------------------------------------------------------------
define method .repositionBranch(!vector is POINTVECTOR)

   !this.surfacePosition = !vector.position
   !this.newBranch.hBore = !this.p3Bore
   handle ANY
    !this.newBranch = !this.connectedBranch
    !this.newBranch.hBore = !this.p3Bore
   endhandle
   !this.newBranch.tBore = !this.p3Bore

 !this.headOrTail = !!pipeTappings.connectedEndOption.selection('rtext')
 !!ce = !this.newBranch
 if !this.headOrTail.eq('HEAD') then
   !this.newBranch.hPos = !vector.position
   !this.newBranch.tPos = !vector.position
   !this.newBranch.hDir = !vector.direction
   !this.newBranch.tDir = !vector.direction.opposite()
   move pt dist -500mm from ph
else
   !this.newBranch.tPos = !vector.position
   !this.newBranch.hPos = !vector.position
   !this.newBranch.tDir = !vector.direction
   !this.newBranch.hDir = !vector.direction.opposite()
   move ph dist -500mm from pt
endif

   !!ce = !this.newBranch
   sel hstu
    -- set the chei cdia and flen
   !this.cdia = !this.newBranch.phod
   !this.chei = 150mm
   !this.flen = 0

   --!headVector = !vector.direction
   --!tailVector = !vector.direction.opposite()
   --!head = 'HEAD'
   !this.getInsertComponentDetails()

   -- set the branch head and tail
  !this.built = FALSE
  !this.mode = 'PICKED'

  !this.connectedBranch = !this.newBranch
  !this.mainVector = !vector

  -- !this.intersect.display()

endmethod

------------------------------------------------------------------------
--
-- Method:     .getInsertComponentDetails()
--
-- Description: method called by update branch - purpose to set cdia and
-- other object variables
--
------------------------------------------------------------------------
define method .getInsertComponentDetails()



    -- position of intersection on tube



   --!this.connectedBranch   = !branch
   --!this.branchDirection   = !vector.direction
   !this.wallThickness     = !this.insertComponent.ltwall
   handle ANY
    !this.wallThickness     = !this.insertComponent.hwallth
    handle ANY
      !this.wallThickness = 7mm
    endhandle
  endhandle
  if !this.insertComponent.type.eq('BRAN') then
    !this.mainTubeOD = !this.insertComponent.phod
    !this.wallThickness     = !this.insertComponent.hwallth
    handle ANY
      !this.wallThickness = 7mm
    endhandle
  else
   !this.mainTubeOD = !this.insertComponent.lod
   !this.wallThickness     = !this.insertComponent.ltwall
   handle ANY
     !this.wallThickness = 7mm
   endhandle
  endif
    !this.mainBore   = !this.insertComponent.lBore
  handle ANY
    !this.mainBore   = !this.insertComponent.hBore
  endhandle
  !this.ptapSpec = pspe of bran of $!this.insertComponent
$(
  !this.componentOrTube = !type
  !this.headOrTail = !end
  !this.getp3Bore(!end)
  -- go and get the connection references if already connected
  !this.updateParameters(!componentType,FALSE)
  handle (2,434)
    --error in updateParameters
    --this handles the error which is produced if we have a stub in branch that is larger than the main branch
    --we return an empty object which does not contain any connections
    !this = object .pipeTappingConnection()
  endhandle
$)

endmethod

-- End of method definition
------------------------------------------------------------------------
--
-- Method:     .getConnectedEnd()
--
-- Description: get the connection details this.ptap this.pipca
--
------------------------------------------------------------------------
define method .getNewBranchName()is STRING

-- If there are no branches defined, then define a temporary pipe branch
  -- object to derive the name
  !newBranch    = object PIPEBRANCH(!this.mainBranch)
  if(!this.branchList.size() ge 1) then
    !lastBranch = !this.branchList.last()
    !newBranch.idRule       = !lastBranch.idRule
    !newBranch.idSeparator  = !lastBranch.idSeparator
  endif
  --!this.branchList.append(!newBranch)

  -- Name branch
  !branchName = !this.branchName(!this.branchList.last())
  if(!branchName.set()) then
    return !branchName
  else
    return 'unset'
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      branchName
--
-- Description: Work out a new branch name
--
--
------------------------------------------------------------------------
define method .branchName(!branchData is PIPEBRANCH) is STRING

  -- Initialise Variables
  !name       = STRING()
  !separator  = !branchData.idSeparator
  !rule       = !branchData.idRule

  -- If pipe is named
  if(!branchData.branch.owner.isNamed) then
    !nameRoot = !branchData.branch.owner.name

    do !index from 1 to !branchData.branch.owner.mCount + 1
      !name   = !nameRoot & !separator & $!<rule>
      -- Check to see if names exists
      !unusedX = (ID $!<name> )
      handle ANY
        break
      endhandle
    enddo
  endif

  return !name

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      getBranchList
--
-- Description: Get a list of existing branches
--
--
------------------------------------------------------------------------
define method .getBranchList()

 !this.branchList = ARRAY()
 -- Get branch information for active pipe
  if(!this.pipe.members.empty().not()) then

    -- Loop through pipe members
    do !element values !this.pipe.members

      skip if(!element.type ne 'BRAN')

      -- Branch
      !branch = object PIPEBRANCH(!element)

      -- Add branch to list of branches
      if(!branch.set()) then
        !this.branchList.append(!branch)
      endif

    enddo
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      .setBranchBores
--
-- Description: set the passed branch hBor/tBore or both
--
--
------------------------------------------------------------------------
define method .setBranchBores(!branch is DBREF ,!option is REAL )

-- if !option = 0 set both head and tail
-- if !option = 1 set the head
-- if !option = 2 set the tail
!save = !!ce
!!ce = !branch
 !bore = object BORE($!!pipeTappings.boreSize)
 handle ANY
  !bore = object BORE(15mm)
 endhandle

 -- If the pipe has a Bore set then use it
 if(!option inset (0,1)) then
   !branch.hBore      = !bore
   sel hstu
 endif
 if !option inset (0,2) then
   !branch.tBore      = !bore
 endif

 !!ce !save

endmethod
------------------------------------------------------------------------
--
-- Method:     .getConnectedEnd()
--
-- Description: get the connection details this.ptap this.pipca
--
------------------------------------------------------------------------
define method .getConnectedEnd()

  !this.headOrTail = !this.existingElement.cend
  -- get the insert depth from the existing pipca
  !this.actualInsertDepth = !this.getExistingInsertDepth(!this.existingElement )
  !this.insertDepth = !this.actualInsertDepth

endmethod

------------------------------------------------------------------------
--
-- Method:     .getCouplingSpref()
--
-- Description: Constructor for use with existing connections
-- called after apply to update existing components
-- and presumably if we select an existing branch
-- !existingComp is the href/tref of the connected branch
-- !branch is the connected branch
--
------------------------------------------------------------------------
define method .getCouplingSpref()

!return = object DBREF()
if !this.connectedBranch.members.set() then
  if !this.headOrTail.eq('HEAD') then
    if !this.connectedBranch.members[1].type.eq('COUP').and(!this.connectedBranch.members[1].compType.eq('PTAP')) then
       !this.coupling = !this.connectedBranch.members[1]
       !this.couplingSpref = !this.connectedBranch.members[1].spref
    endif
  else
   if !this.connectedBranch.members[!this.connectedBranch.members.size()].type.eq('COUP').and(!this.connectedBranch.members[!this.connectedBranch.members.size()].compType.eq('PTAP')) then
       !this.coupling = !this.connectedBranch.members[!this.connectedBranch.members.size()]
       !this.couplingSpref = !this.connectedBranch.members[!this.connectedBranch.members.size()].spref
    endif
  endif
endif


endmethod
------------------------------------------------------------------------
--
-- Method:    .getExistingInsertDepth
--
-- Description: get insert depth called from getConnectedEnd of the
-- existing connection constructor
--
--
------------------------------------------------------------------------
define method .getExistingInsertDepth(!element is DBREF )is REAL

if !element.type.eq('PTAP') then
  !this.ptap = !element
  !this.pipca = pipca 1 of $!element
  handle ANY
   !insertDepth = 0
  endhandle
  !insertDepth = !this.pipca.depth
  !this.insertComponent = !element
else
-- its a pipca
   !this.pipca = !element
   !insertDepth = !element.depth
   handle ANY
     !insertDepth = 0
   endhandle
endif

return !insertDepth

endmethod
------------------------------------------------------------------------
--
-- Method:    .getp3Bore(!end is STRING)
--
-- Description: method to get the p3 Bore because this needs to be in mm as we check the catalogue parameters
--
--
------------------------------------------------------------------------
define method .getp3Bore(!end is STRING)

   if !end.eq('HEAD') then
     !this.p3Bore = !this.connectedBranch.hBore
     !this.stubInTubeOD = !this.connectedBranch.phod
     handle ANY
       !this.stubInTubeOD = !this.connectedBranch.hBore
     endhandle
   else
     !this.p3Bore = !this.connectedBranch.tBore
     !this.stubInTubeOD = !this.connectedBranch.ptod
     handle ANY
       !this.stubInTubeOD = .connectedBranch.tBore
     endhandle
   endif

endmethod

------------------------------------------------------------------------
-- Method:      .nearestEnd()
-- Description: checks to see if the opposite end head/tail is between the current position
--              added to fix P-32657
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN true if the opposite end is between the current end
------------------------------------------------------------------------
define method .nearestEnd() is BOOLEAN


-- nearestEnd is the wrong description because we are trying to validate the current object
if !this.headOrTail.eq ('HEAD') then
     !direction1 = !this.connectedBranch.hDir.wrt(/* )
     !direction2 = !this.connectedBranch.tDir.wrt(/* )
     !position1  = !this.connectedBranch.hPos
     !position2  = !this.connectedBranch.tPos
else
     !direction1 = !this.connectedBranch.tDir.wrt(/* )
     !direction2 = !this.connectedBranch.hDir.wrt(/* )
     !position1  = !this.connectedBranch.tPos
     !position2  = !this.connectedBranch.hPos
endif


  -- if the branch head/tail is the same as the insert direction
  if !direction1.eq(!this.branchDirection).and(!direction2.neq(!this.branchDirection)) then
     --its ok
     return FALSE
  elseif !direction1.eq(!this.branchDirection).and(!direction2.eq(!this.branchDirection)) then
     -- get the closest
     !distance1 = !this.surfacePosition.distance(!position1)
     !distance2 = !this.surfacePosition.distance(!position2)
     if !distance1.leq(!distance2) then
        -- the current end is nearest
        return FALSE
     else
        return TRUE
     endif
  endif

  return FALSE

endmethod

------------------------------------------------------------------------
-- Method:      .between()
-- Description: checks to see if the opposite end head/tail is between the current position
--              added to fix P-32657
-- returns true if the opposite end is between the current end
------------------------------------------------------------------------
define method .between() is BOOLEAN

if !this.headOrTail.eq ('HEAD') then
  -- check to see if the tail is between the component and the head
  !line = object LINE()
  !line .startPosition = !this.connectedBranch.hPosition.wrt(/* )
  !line .endPosition = !this.surfacePosition
  if !line.length().lt(1mm) then
     !vector = object POINTVECTOR()
     !vector.position = !this.connectedBranch.hPosition.wrt(/* )
     !vector.direction = !this.branchDirection
     !newVector = !vector.offset(2mm)
     !line.endPosition = !newVector.position
  endif
  if !line.onProjected(!this.connectedBranch.tPosition.wrt(/* )) then
    return TRUE
  else
    return FALSE
  endif
else
   -- check to see if the head is between the component and the head
  !line = object LINE()
  !line .startPosition = !this.connectedBranch.tPosition.wrt(/* )
  !line .endPosition = !this.surfacePosition
   if !line.length().lt(1mm) then
     !vector = object POINTVECTOR()
     !vector.position = !this.connectedBranch.tPosition.wrt(/* )
     !vector.direction = !this.branchDirection
     !newVector = !vector.offset(2mm)
     !line.endPosition = !newVector.position
  endif
  if !line.onProjected(!this.connectedBranch.hPosition.wrt(/* )) then
    return TRUE
  else
    return FALSE
  endif
endif

endmethod
------------------------------------------------------------------------
-- Method:      .updateParameters()
-- Description: method called to set up the appropriate componentType
--
--
------------------------------------------------------------------------
define method .updateParameters(!componentType is STRING,!override is BOOLEAN )is BOOLEAN

    -- set the current component type to whatever is passed
    !this.componentType = !componentType
    -- go and find a component based on the current selections
    --!this.getComponent()
    --handle 765
    --  return
   -- endhandle
    -- go and find out if the current end is already connected and we have a valid insert depth
    !this.testConnection()
    -- if we have an existing connection then we need to get the actual insert
    -- depth from the head/tail position
    if !this.status.and(!override.not()) then
       !this.componentType = !componentType
       !this.getComponent()
       handle 765
         return error 345
       endhandle
       -- the componentType
       if !this.existingPosition.unset() then
         return error 543 noalert
       endif
       --
       !this.calculateInsertPosition('existing')


    else
       -- now we calculate actual and default parameters so get default positions
       -- needs to reflect this
      !this.getComponent()
        handle 765
      return
   endhandle


      !this.getDefaultPositions()
    endif

endmethod
-- thought to be not used at present but called by changing the insert value on the form
------------------------------------------------------------------------
-- Method:      .setInsert()
-- Description: method called to work out the insert depth for each fitting
-- This is called from manually setting the insert but needs to be called
-- as part of the component selection process
--
------------------------------------------------------------------------
define method .setInsert(!value is REAL)

  -- this is a method for setting the insert but needs completing
  -- the passed value is the setting for the modified insert depth
  -- and we need to modify the appropriate position values and redraw the
  -- component
 !this.insertDepth = !value
 !vector = object POINTVECTOR()
 !vector.position = !this.surfacePosition
 !vector.direction = !this.branchDirection
 !pv = !vector.offset(-1 * !value)
 !this.insertPosition = !pv.position
 !this.branchPosition = !pv.position

endmethod

------------------------------------------------------------------------
-- Method:      .setNote()
-- Description: method called to set connection note
--
------------------------------------------------------------------------
define method .setNote(!value is STRING)

  !this.connectionNote = !value

endmethod
------------------------------------------------------------------------
-- Method:      drawFitting()
-- Description: method called to draw a fitting representation
--
-- this will be called by several routines
--
--
------------------------------------------------------------------------
define method .drawFitting(!mode is BOOLEAN, !number is REAL,!insert is REAL  )

  if !this.chei.unset() then
    !this.getComponent()
  endif
  aid CLEAR ALL $!<number>
  handle ANY
  endhandle

   if !mode then
     !pv = object POINTVECTOR()
     !pv.position  = !this.surfacePosition
     !pv.direction = !this.branchDirection
     !pv = !pv.offset(-1 * !insert)
     !height = !this.chei.value()
     !dist = !this.chei.value() / 2
     !newPv = !pv.offset($!<dist> mm)
     !diameter = !this.cdia.value() + 1
     --pin 9 at  $!<newPv.position>
     AID CYLINDER NUMBER $!<number>  AT $!<newPv.position>  ORI Z IS $!<this.branchDirection>   HEIGH $!<height>mm DIAM $!<diameter>mm FILLED ON
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      !connect()
--
-- Description: callback for the connect/reconnect button
--
--
------------------------------------------------------------------------
define method .connect()
 -- when we have selected a component and worked out the intersection then we need to
 -- create the ptap in the appropriate position and set its attributes.
 -- in case the branch is already connected, the button is reset to be a reconnect
 -- and the tee needs to be reselected and the attributes reset for branch POSITION
 --  we are using:
 -- !this.insertType = 'TUBE'
 -- !this.headOrTail = 'HEAD'
 -- !this.p3Bore = !pickedBranch.hBore

 -- if the branch is already connected we need to get rid of the old connection
 -- or stop anything happening if the user wants to keep it

 !save = !!ce
 !!ce = !this.insertComponent
 handle ANY
  !!pipeTappings.pickStubInBranch(!this.connectedBranch,TRUE )
  !!alert.error('There is a problem with the connection attributes - please try again')
  return
 endhandle
   FORWARDS
   if !this.componentOrTube.eq('TUBE') then
     -- we are using a ptap
     !this.createPtapConnection(!this.ptap.set())
     -- if we are creating a coupling we need to do it here
   else
     !this.createSubComponent(!this.pipca.set())
   endif

   if !!pipeTappings.stubInType.selection('rtext').eq('TAP') then
       !this.addCoupling()
   endif

   -- move the branch head/tail to the insertPosition
   !this.moveBranch(!this.ptap)
   !!ce = !this.ptap

   -- Set the connection type of the branch head/tail
   !this.setConnectionTypes()

 -- if we are creating a coupling we need to do it here
 if !!pipeTappings.stubInType.selection('rtext').eq('TAP') then
   !this.addCoupling()
 elseif !this.coupling.set() then
    !!ce = !this.coupling
    delete coup
 endif

 -- problem with graphics not updating
 rem ce add ce
 !!ce = !save
 handle ANY
 endhandle

endmethod
-- End of method definition for .connect()
------------------------------------------------------------------------
--
-- Method:      .createSubComponent()
--
-- Description: method for creating new pipca elements for branch connections
-- on components
--
--
------------------------------------------------------------------------
define method .createSubComponent(!update is BOOLEAN)

   -- we need a pipca below the current element
   if !update.not() then
     !!ce = !this.insertComponent
     NEW pipca
     !this.ptap = !!ce
     !this.pipca = !!ce
   else
     !!ce = !this.pipca
   endif
   ddirection $!this.branchDirection
   handle ANY
   endhandle
   at $!this.branchPosition
   cref $!this.connectedBranch
   DCONNECT BWD
   depth $!!pipeTappings.branchinsert
   !!ce.description = !!pipeTappings.connectionNote.val
   handle ANY
    -- unset data
   endhandle
   !!ce.function = !!pipeTappings.stubInType.selection('dtext')
   !!ce.purp = !!pipeTappings.stubInType.selection('rtext')
   !this.componentType = !!ce.purp
   Bore $!this.p3Bore

endmethod
------------------------------------------------------------------------
--
-- Method:      .createPtapConnection()
--
-- Description: method for creating new ptaps for branch connections in tube
-- if its not in tube and on a component then a pipca is created below the
-- component
--
--
------------------------------------------------------------------------
define method .createPtapConnection(!update is BOOLEAN)

   if !update.not() then
     !!ce = !this.insertComponent
     FORWARDS
     NEW PTAP
   else
     !!ce = !this.ptap
   endif
  desp n1 $!this.p3Bore
  sel with  spec /General-Tappings STYPE ptap pbor0 $!this.mainBore pbor3 $!this.mainBore
  !this.ptap = !!ce
  through $!this.surfacePosition
  ori
  ori and p4 is from ce to $!this.surfacePosition
  !!ce.lstu = !this.getPTAPLeaveTube()
  handle ANY
  elsehandle NONE
   !lstuStype = !!ce.lstu.stype
   handle ANY
     !lstuStype = 'A'
   endhandle
  endhandle
  cref $!this.connectedBranch
  if !this.pipca.badref() then
    NEW pipca  at p4 of owner
    !this.pipca = !!ce
    at $!this.surfacePosition
  else
    !!ce = !this.pipca
    at $!this.surfacePosition
  endif
  !!ce.depth = !this.insertDepth
  handle ANY
  endhandle
  if !this.headOrTail.eq('HEAD')then
    ddirection hdir of $!this.connectedBranch
    !!ce.bore = hBore of $!this.connectedBranch
  else
  -- if !this.headOrTail.eq('TAIL')  then
     ddirection tdir of $!this.connectedBranch
    !!ce.bore = tBore of $!this.connectedBranch
  endif

  -- now set the insert direction
  --MOVE ALONG DDIR dist - $!this.insertDepth
  at $!this.insertPosition
  !!ce.function = !!pipeTappings.stubInType.selection('dtext')

  !!ce.purp = !!pipeTappings.stubInType.selection('rtext')
  if !this.connectionNote.set() then
    !!ce.description = !this.connectionNote
  endif
  !this.componentType = !!ce.purp
  -- now go and connect the branch
  !this.connectBranch(!lstuStype)

endmethod


------------------------------------------------------------------------
--
-- Method:     .getPTAPLeaveTube()
--
-- Description: make sure we get the same lstu as the prev component
-- we are currently at a PTAP and we should be in Forwards mode
------------------------------------------------------------------------
define method .getPTAPLeaveTube() is DBREF

!order = !!ce.order
if !order.eq(1) then
  return !!ce.owner.hstu
else
  return !!ce.owner.members[!order - 1].lstu
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .addCoupling()
--
-- Description: if we are dealing with a tapping we need to add a
-- new coupling at the head or tail
--
--
------------------------------------------------------------------------
define method .addCoupling()

-- first get the spref
!coupling = !!pipeTappings.boreSize.selection('rtext').dbref()
handle ANY
  return
endhandle

-- check to see if the coupling is of the correct type
if !this.testForExistingCoupling(!coupling) then
   --we have a valid coupling now we need to know if there is one there already
   -- if there is, it is deleted
endif
if !this.headOrTail.eq('HEAD') then
     --its a straightforward create/connect
     !this.createCouplingInLine(!coupling)
else
   -- we need to work in backwards mode
     backwards
     !this.createCouplingInLine(!coupling)
     forwards
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .createCouplingInLine
--
-- Description: create a new coupling and connect it
--
--
------------------------------------------------------------------------
define method .createCouplingInLine(!coupling is DBREF )

   !!ce = !this.connectedBranch
   if !this.headOrTail.eq('TAIL') then
     back
     tail
   endif
   new coup before first
   handle ANY
   new coup
   endhandle
   !!ce.spref = !coupling
   conn
   handle ANY
    fconn
   endhandle
   sel lstu
   !this.setShop(!!ce)

endmethod

------------------------------------------------------------------------
--
-- Method:      setShop
--
-- Description: Sets shop attribute to from specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setShop(!component is DBREF)

  -- Initialise Variables
  !reference  = !!ce
  !!ce        = !component

  -- collect all attributes for a design element
  !attributes = ARRAY()

  !attributes[1] = 'SHOP'

  !questions = ARRAY()
  !answers = ARRAY()

  var !choices choice number
  do !a from 1 to !choices.real()
    var !question Choice question $!a
    !questions.append(!question)
    var !answer Choice answer $!a
    !answers.append(!answer)
  enddo

  do !i from 1 to !questions.size()
    !index = !attributes.findFirst(!questions[!i])
    if (!index.set()) then
      !answer = !answers[!i]
      if(!attributes[!index] eq 'SHOP') then
      	-- SHOP / SITE can be shop / true or site / false
      	if(!answer.eq('TRUE') or !answer.eq('SHOP')) then
      		!component.shop = TRUE
      	elseif(!answer.eq('FALS') or !answer.eq('SITE')) then
      		!component.shop = FALSE
      	endif
      endif
  	endif
	enddo
	
	-- I am not sure if this is needed any more
	-- Reselect component
  --RESELECT WITH SPEC $!<component.spow>
  --handle ANY
  --endhandle

  -- Return to original component
  !!ce        = !reference

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      .testForExistingCoupling
--
-- Description: if there is an existing coupling and it is the right compType
-- we need to reset it. Otherwise return false so that one can be created
--
--
------------------------------------------------------------------------
define method .testForExistingCoupling(!coupling is DBREF) is BOOLEAN

if !this.headOrTail.eq('HEAD') then
  !element = !this.connectedBranch.members[1]
  handle ANY
    return FALSE
  endhandle
else
  !element = !this.connectedBranch.members[!this.connectedBranch.members.size()]
  handle ANY
    backwards
    return FALSE
  endhandle
  backwards
endif

if !element.type.eq('COUP').and(!element.catref.compType.eq('PTAP')) then
   -- modify the existing coupling
   !!ce = !element
   delete coupling


   return TRUE
else
   forwards
   return FALSE
endif

endmethod


------------------------------------------------------------------------
--
-- Method:      .testCouplingType()
--
-- Description: We need to make sure that the
-- new coupling is at the head or tail
--
--
------------------------------------------------------------------------
define method .testCouplingType(!coupling is STRING)is BOOLEAN

return TRUE


endmethod

------------------------------------------------------------------------
--
-- Method:      .connectBranch()
-- Description:  new pipca method for connecting to !this.ptap
--
--
------------------------------------------------------------------------
define method .connectBranch(!stype is STRING)

   !!ce = !this.connectedBranch
   if !this.headOrTail.eq('HEAD')then
     conn ph to $!this.ptap
   else
     conn pt to $!this.ptap
   endif

   -- set the hstu if its a new branch
   if !!ce.mCount.eq(0) then
       sel hstu with stype $!stype
       handle ANY
         sel hstu
   endhandle
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      testForConnection()
-- return       true or false to allow a stop in the process if the branch is already connected.
--
-- Description: checks for existing ptap connections
--
--
------------------------------------------------------------------------
define method .testConnection()

   !comp = object DBREF()
   !this.status = FALSE
   if !this.headOrTail.eq('HEAD').and(!this.connectedBranch.href.set()) then
      !comp = !this.connectedBranch.href
      !this.existingPosition = !this.connectedBranch.hPos.wrt(/* )
   elseif !this.headOrTail.eq('TAIL') and (!this.connectedBranch.tref.set()) then
      -- the branch tail is already set
      !comp = !this.connectedBranch.tref
      !this.existingPosition = !this.connectedBranch.tPos.wrt(/* )
   endif
   if !comp.set() then
     -- we need to write a validation routine
   else
      return
   endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setConnectionTypes()
--
-- Description: sets the branch head/tail connection
--
--
------------------------------------------------------------------------
define method .setConnectionTypes()

    if !this.ptap.type.eq('PTAP') then
      -- its an olet
      !branchConnection = !this.ptap.pPconn[3]
    else
      -- its a pipca
      !branchConnection = !this.pipca.dconn
    endif
    --!branchConnection = !this.ptap.DCconn
    if !this.headOrTail.eq('HEAD') then
       !this.connectedBranch.hconn = !branchConnection
    else
       !this.connectedBranch.tconn = !branchConnection
    endif

endmethod
------------------------------------------------------------------------
--
-- Method:      moveBranch()
--
-- Description: moves the branch head/tail to the calculated position
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .moveBranch(!ptap is DBREF)

  if !ptap.type.eq('PTAP') then
     !element = !ptap
  else
     !element = !this.pipca
  endif
    if !this.headOrTail.eq('HEAD') then
      !this.connectedBranch.hPos = !this.branchPosition
      !this.connectedBranch.href = !element
    else
      !this.connectedBranch.tPos = !this.branchPosition
      !this.connectedBranch.tref = !element
    endif

endmethod
------------------------------------------------------------------------
--
-- Method:      moveBranch()
--
-- Description: moves the branch head/tail to the calculated position
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .getComponent()

!this.cdia = !this.stubInTubeOD
--!this.cdia = !this.stubInTubeOD + 10mm
!this.chei = 150mm
!this.flen = 0

endmethod
------------------------------------------------------------------------
-- Method:      .testForNegative(!insert is REAL)
-- Description: check if the existing connection insert is negative
-- and return the correct insert depth from the branch position
--
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .testForNegative(!insert is REAL) is REAL

if !insert.eq(0) then
  return !insert
endif
!line = object LINE()
!line.startPosition = !this.insertPosition
!line.endPosition = !this.surfacePosition
!vector = object POINTVECTOR()
!vector.direction  = !this.branchDirection
!vector.position = !this.insertPosition
!newVector = !vector.offset(1mm)
!newLine = !line
!newLine.startPosition = !newVector.position

if !newLine.length().lt(!line.length()) then
   return !insert
else
   return -1 * !insert
endif

endmethod

------------------------------------------------------------------------
-- Method:      .getDefaultPositions()
-- Description: method to work out a simple insert depth and branch positions
--
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .getDefaultPositions()

   -- get the insert angle
   !this.calculateAngle()

   -- work out the insert depth. Probably should include the wall thickness
   -- but for now use the outside surface + 10
   !mainTubeRadius = !this.mainTubeOD / 2

   !branchTubeRadius = !this.stubInTubeOD / 2
   if !this.mainTubeOD.eq(!this.stubInTubeOD) then
      !insertDepth =  !branchTubeRadius
   else
      !insertDepth = !mainTubeRadius - sqrt((!mainTubeRadius.power(2) - !branchTubeRadius.power(2)))
   endif

   if !this.componentType.eq('STU') then
     -- standard stub in or insert in TRIBON sense
     !insertDepth = 0.5 * (!this.cdia / tan(!this.insertAngle)) + !this.wallThickness
     -- old calculation!insertDepth = !insertDepth + !this.wallThickness
     -- need bit in here to deal with equal tees
   elseif !this.componentType.eq('SSU') then
      if !this.insertAngle.eq(90) then
          !insertDepth = 0
      else
          !insertDepth = 0.5 * (!this.cdia / tan(!this.insertAngle))
      endif
   elseif !this.componentType.eq('SSA') then
     -- saddle insert
     if !this.mainTubeOD.eq( !this.cdia ) then
        if !this.insertAngle.eq(90) then
          !insertDepth = !mainTubeRadius
        else
          !insertDepth = !mainTubeRadius / sin(!this.insertAngle)
        endif
     else
       if !this.insertAngle.eq(90) then
         !insertDepth = (-0.5 * (sqrt(!this.mainTubeOD.power(2) - !this.cdia.power(2)) - !this.mainTubeOD))
       else
         --RM this is the calculation provided by Katarina Ahlgren which mimics the existing TRIBON calculations
         --first calculate !jDist which is the segment height of the chord formed by the extents of the connecting tube with the main tube
         --                        |__|
         --                       /    \
         --                       |    |
         --                       \____/
         !chordLength = !this.cdia
         !halfChordLength = !chordLength / 2
         !mainTubeRadius = !this.mainTubeOD / 2
         !squaredDistanceToChord = (!mainTubeRadius.power(2)) - (!halfChordLength.power(2))
         !jDist = (!mainTubeRadius) - !squaredDistanceToChord.sqrt()
         --now calculate a) distance from furthest point away from the connecting branch to the surface of the main branch
         --              b) distance to extend through the surface so that the connecting branch is fully embedded in the main branch
         !alpha = !this.insertAngle
         if !alpha.gt(180) then
           !alpha = !alpha - 180
         endif
         if !alpha.gt(90) then
           !alpha = 180 - !alpha
         endif
         !sinAlpha = !alpha.sine()
         !complAlpha = 90 - !alpha
         !sinComplAlpha = !complAlpha.sine()
         --a)
         !extensionToSurface = !this.cdia * 0.5 * !sinComplAlpha / !sinAlpha
         --b)
         !insertDepth = !extensionToSurface + (!jDist / !sinAlpha)

       endif
     endif
   elseif !this.componentType.eq('SEX') then
     !insertDepth = 0.074 * !this.cdia + 2mm
     if !insertDepth gt( 16mm ) then
        !insertDepth = 16mm
     endif
     !insertDepth = -1 * !insertDepth
   elseif !this.componentType.eq('TAP').or(!this.componentType.eq('BOS')) then
      if !this.insertAngle.eq(90) then
          -- use standard insert
      else
          !insertDepth = 0.5 * (!this.cdia / tan(!this.insertAngle))
      endif
   else
     !insertDepth = !insertDepth
   endif

   !this.defaultInsertDepth = !insertDepth

   --!this.insertDepth = !insertDepth
   -- now calculate the insert position - use standard method
   !this.calculateInsertPosition('default')

endmethod

------------------------------------------------------------------------
-- Method:      .calculateAngle()
-- Description: method to work out the insert angle from centreline
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .calculateAngle()

   -- the following code works out the insert angle as part of the process
   if !this.componentOrTube.eq('COMPONENT') and !this.insertComponent.type inset('BEND','ELBO') then
      !this.plane = !this.getBendPosition(!this.surfacePosition, !this.insertComponent)
   else
      -- Define the cutting plane
      !this.plane = !this.getTubePosition(!this.surfacePosition, !this.insertComponent)
   endif

   if !this.insertAngle.lt(1) then
     !this.insertAngle = 90
   endif

endmethod

------------------------------------------------------------------------
-- Method:      .calculateInsertPosition()
-- Description: method to work set the insert position
--
-- Method Type: Function/Procedure
------------------------------------------------------------------------
define method .calculateInsertPosition(!type is STRING )

  !vector = object POINTVECTOR()
  !vector.position  = !this.surfacePosition
  !vector.direction = !this.branchDirection


if !type.eq('default') then
  !insertVector = !vector.offset(-1 * !this.defaultInsertDepth)
  !this.insertPosition = !insertVector.position.wrt(/* )
  !this.branchPosition = !this.insertPosition
elseif !type.eq('existing') then
   !newVector           = !vector.through(!this.existingPosition)
   !this.branchPosition = !newVector.position.wrt(/* )
   -- if the fitting length is greater than zero then we need to adjust the insert position to suit
   -- so we pull back to suit
   !this.insertPosition = !newVector.offset(-1 * !this.flen).position.wrt(/* )
   !insert              = !this.surfacePosition.distance(!this.insertPosition)
   -- need to add something to allow for a negative insert value
   !this.insertDepth     = !this.testForNegative(!insert)
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .calculateCentreline
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .calculateCentreline()

  !this.centreLine = object LINE()
  --q var !this.currentConnection
  if !this.insertComponent.type inset('ELBO','BEND') and !this.componentOrTube.neq('TUBE') then
     !this.getBendArc(!this.insertComponent)
     --!this.drawArc(!this.bendArc)
  else
     -- if we are on a component not tube
     if !this.componentOrTube.eq('COMPONENT') then
     -- calculate the centreline
       !aDir = !this.insertComponent.aDir.wrt(/* )
       !lDir = !this.insertComponent.lDir.wrt(/* )
     elseif !this.componentOrTube.eq('TUBE') then
       if !this.insertComponent.type.eq('BRAN') then
         !lDir = !this.insertComponent.hDir.wrt(/* )
         !lPosition = !this.insertComponent.hPos
       else
         !lDir = !this.insertComponent.lDir.wrt(/* )
         !lPosition = !this.insertComponent.lPos.wrt(/* )
       endif
       !aDir =  !lDir.opposite()
       !vector = object POINTVECTOR()
       !vector.position  = !lPosition
       !vector.direction = !lDir
       !newVector = !vector.through(!this.branchPosition)
       !this.centreLine = !newVector.line(500mm)
       !this.centreLine = !this.centreLine.extendStart(500mm)
     endif
     if !aDir.opposite().eq(!lDir).and(!this.componentOrTube.neq('TUBE')) then
      -- its an inline component
      !this.centreLine.startPosition = !this.insertComponent.aPos.wrt(/* )
      !this.centreLine.endPosition   = !this.insertComponent.lPos.wrt(/* )
      if !this.centreLine.length().eq(0) then
         !this.centreLine = object LINE()
      endif
    endif
  endif

  if !this.centreLine.set() then
    !this.drawLine(!this.centreLine)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .adjustPlaneToCentreline()
--
-- Description: in order to work out the offset radius we need accurately position the
-- plane on the centreline for tube and in line components a centreline is
-- generated based on arrive/leave positions
-- For bends and elbows there is an arc
-- This does not cover mitred bends or tees which turn through 90 degrees
--
------------------------------------------------------------------------
define method .adjustPlaneToCentreline()

-- we know the passed direction is correct about the centreline providing we are on the centreline

      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        --$p plane needs to be moved by $!dist
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane)
      elseif !this.bendArc.set() then
        !intersections = !this.plane.intersections(!this.bendArc)
        do !a values !intersections
           if !this.bendArc.on(!a) then
              !intersection = !a
              break
           endif
        enddo
        if undefined(!intersection) then
          --$p no intersection
         !this.drawPlane(TRUE,!this.plane)
          return
        endif
        !dist = !intersection.distance(!this.plane.position)
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane)
      endif

      -- add the plane labels
      !this.planeTags()

endmethod

------------------------------------------------------------------------
--
-- Method:      .netOnNudgeChanged
--
-- Description: called when the nudge button is pressed on the control
-- !a[0] is either left or right
-- !a[1] is a real
--
------------------------------------------------------------------------
define method .nudgeAlong(!a is ARRAY)

    !savedPlane = !this.plane
    if !this.insertComponent.type inset('ELBO','BEND') and !this.componentOrTube.eq('COMPONENT') then
     -- we need another way of defining !this.currentConnection.plane
     !this.plane = !this.getBendPosition(!this.newSurfacePosition, !this.insertComponent,!a)
     !this.drawPlane(TRUE,!this.plane)
     !this.calculateRotationPlane()
    else
      !pv = !this.plane.pointVector()
      if !a[0].eq('Right') then
        !pvNew = !pv.offset(!a[1])
      else
         !pvNew = !pv.offset(-!a[1])
      endif
      !this.plane = !pvNew.plane()
      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane)
        !this.calculateRotationPlane()
      endif

      -- need a routine to check if the plane has moved
      !vector = object POINTVECTOR()
      !vector.position = !this.plane.position
      !vector.direction = !this.majorDirection.direction
      !points = !this.getInsertComponentAndPosition(!vector)
      if !points.unset() then
      -- this is for going off the end of the branch
        !!alert.warning('New position is off the end of the component')
        !this.plane = !savedPlane
        !this.drawPlane(TRUE,!this.plane)
      else
        !testComponent = !points[1][3]
        !type = !points[1][1]
        if !this.insertComponent.neq(!testComponent).or(!type.neq(!this.componentOrTube)) then
          !!alert.warning('New position is off the end of the component')
          this.plane = !savedPlane
          !this.drawPlane(TRUE,!this.plane)
       endif
     endif
  endif


  !this.rotateAroundPlane(!!specialbranchdirection.connectionPositionControl.rotation())

  --!this.copyPlane()
  !this.drawPlane(TRUE,!this.plane)

  -- add the plane tags
   !this.planeTags()

  !this.calculateRotationPlane()


endmethod

------------------------------------------------------------------------
--
-- Method:      .rotateAroundPlane()
--
-- Description: method to fire a vector down the plane at the passed angle
-- the vector is parallel to the plane but the return vector may not be on
-- items like reducers or bends
--
------------------------------------------------------------------------
define method .rotateAroundPlane(!newAngle is REAL)


   -- get the direction flat to the plane
   !direction = !this.getNewDirection(!newAngle)
   -- pass the flat plane direction to get an array
   --q var !direction
   !newSurfacePositions = !this.getNewSurfacePosition(!direction)
   if !newSurfacePositions.unset() then
     return
   endif

     --!newSurfacePositions looks like this
     --[1]  <STRING> 'COMPONENT'
     --[2]  <DIRECTION> Y 42 Z WRT /*
     --[3]  <DBREF> =24104/2785
     --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*
    --q var !newSurfacePositions[1]

   -- now get the new surface POSITION from the ARRAY
   !this.getNewSurfacePositionFromVector(!newSurfacePositions,!direction)

  -- now we need to update the gadgets


endmethod

------------------------------------------------------------------------
--
-- Method:    .getExistingInsert
--
-- Description: method to get the insert depth of an existing component
--
--
------------------------------------------------------------------------
define method .getExistingInsert()


  -- now calculate the insertion surface position
  !vector = object POINTVECTOR()
  !vector.position = !this.branchPosition

  !vector.direction = !this.branchDirection

  !insert =  !this.flen - !this.insertDepth


  !this.surfacePosition = !vector.offset(-1 * !insert).position


endmethod

------------------------------------------------------------------------
--
-- Method:      makePlane
--
-- Description: makes a plane object from a position and a direction
-- used several times.
--
------------------------------------------------------------------------
define method .makePlane(!passedPosition is POSITION,!direction is DIRECTION)is PLANE

   !plane = object PLANE()
   !plane.position = !passedPosition
   !plane.orientation = z is $!direction
   return !plane

endmethod
-----------------------------------------------------------------------
--
-- Method:      method .getTubePosition
--
-- Description: method to orientate the plane according to the pick direction
--
--
------------------------------------------------------------------------
define method .getTubePosition(!passedPosition is POSITION, !element is DBREF) is PLANE

-- now used to calculate the insert angle
    if !element.badref() then
      -- we could have pressed undo
      !!pipeTappings.pickStubInBranch(!this.connectedBranch, TRUE )
      return object plane()
   endif

   !finalPlane = object PLANE()
   -- need to handle branch tube
   if !element .type.eq('BRAN') then
      !lPos = !element.hPos.wrt( /* )
      !lDir = !element.hDir.wrt( /* )
   else
      !lPos = !element.lPos.wrt( /* )
      !lDir = !element.lDir.wrt( /* )
   endif
   !leavePV = object POINTVECTOR()
   !leavePV.position  = !lPos
   !leavePV.direction = !lDir
   !testAngle = !lDir.angle(!this.branchDirection)
   if !testAngle.gt(90) then
     !this.insertAngle = 180 - !testAngle
   else
     !this.insertAngle = !testAngle
   endif

   -- get a new POINTVECTOR through the picked position
   !centreLinePV = !leavePV.through(!passedPosition)
   !finalPlane = !centreLinePV.plane()
   --!this.getBasicPosition(45,!finalPlane,'tube')

   return !finalPlane

endmethod

------------------------------------------------------------------------
--
-- Method:      .getBasicPosition()
--
-- Description: method to provide orthogonal options for the rough pick
-- when locating branches.
-- parameters are nearest angle and string indicating tube or component
-- tube is easiest
--
------------------------------------------------------------------------
define method .getBasicPosition(!dummyToleranceAngle is REAL, !plane is PLANE,!component is STRING)is ARRAY

-- to be completed
!return = ARRAY()
--!ori = !plane.orientation

-- we have a direction and a plane we now need to work out the best orthogonal fit within the plane
!ang[1] = !plane.orientation.xDir().wrt(/* )
!ang[2] = !plane.orientation.yDir().wrt(/* )
!ang[3] = !plane.orientation.zDir().wrt(/* )
!ang[4] = !plane.orientation.xDir().wrt(/* ).opposite()
!ang[5] = !plane.orientation.yDir().wrt(/* ).opposite()
!ang[6] = !plane.orientation.zDir().wrt(/* ).opposite()

!angles = ARRAY()

do !a from 1 to 6
   !angles[!a] = !this.branchDirection.angle(!ang[!a])
enddo

!index = !angles.sortedindices()
!this.branchDirection = !ang[!index[1]]
!vector = object POINTVECTOR()
!vector.position = !this.plane.position
!vector.direction = !this.branchDirection.opposite()
!this.mainVector = !vector
-- !this.newIntersect(!vector)

endmethod

------------------------------------------------------------------------
--
-- Method:      method .getBendPosition
--
-- Description: method to get a new position based on a nudge distance
--              from the current position on elbows and bends
--
------------------------------------------------------------------------
define method .getBendPosition(!passedPosition is POSITION, !element is DBREF,!move is ARRAY ) is PLANE

   !savedPlane = !this.plane
   -- this duplicates some of the code above
   !this.bendArc = !this.getBendArc(!element)
   !positions = !this.bendArc.intersections(!this.plane)
   --!positions = !bendArc.intersections(!finalPlane)
   !p = ARRAY()
   !q = ARRAY()
   do !a values !positions
     !p.append(!this.bendArc.anglePosition(!a))
     !q.append(!this.bendArc.angleDirection(!a))
   enddo

   if !p[1].distance(!this.plane.position).lt(!p[2].distance(!this.plane.position)) then
      !index = 1
   else
      !index = 2
   endif

   !this.plane.position = !this.bendArc.anglePosition(!this.bendArc.intersections(!this.plane)[!index])

   -- now we need to rotate the plane around the arc by a given position
   !newFinalPlane = !this.applyRotation(!this.plane,!move,!this.bendArc)

    !intersections = !newFinalPlane.intersections(!this.bendArc)
    do !a values !intersections
      -- test if the plane is on the bend radius
      if !this.bendArc.on(!a) then
        !intersection = !a
        break
      endif
     enddo

     !dist = !intersection.distance(!this.plane.position)
     handle ANY
      !!alert.error('You cannot move outside the selected component')
      -- reset the plane
      !this.plane = !savedPlane
      !this.drawPlane(TRUE,!this.plane)
      return !this.plane
     endhandle

   return !newFinalPlane

endmethod
------------------------------------------------------------------------
--
-- Method:      method .getBendPosition
--
-- Description: method to orientate the plane according to the pick direction
--              for elbows and bends
--
------------------------------------------------------------------------
define method .getBendPosition(!passedPosition is POSITION, !element is DBREF) is PLANE

   -- clear all the temporary pins
   -- !this.clearPins()

   !this.bendArc = !this.getBendArc(!element)

   !planePoint = !this.bendArc.near(!this.surfacePosition)
   !planePosition = !this.bendArc.anglePosition(!planePoint)
   !planeDirection = !this.bendArc.angleTangent(!planePoint)
   !majorDirection = !this.bendArc.angleDirection(!planePoint)
   !pv = object POINTVECTOR()
   !pv.position = !planePosition
   !pv.direction = !planeDirection
   !insertAngle = !pv.direction.angle(!this.branchDirection)
   if !insertAngle.gt(90) then
     !this.insertAngle = 180 - !insertAngle
   else
     !this.insertAngle = !insertAngle
   endif
   !plane = !pv.plane()
   !ori = !plane.orientation.zDir()

   !newOri = x is $!majorDirection and z is $!ori

   !plane.orientation = !newOri
   return !plane

endmethod

------------------------------------------------------------------------
--
-- Method .getBendArc
--
-- Description: get the radius of a bend or elbow
--
--------------------------------------------------------------------------
-- method to get radius of the current bend
define method .getRadius(!element is DBREF ) is REAL

  !aDir = !element.aDir
  !lDir = !element.lDir
  !angle = !aDir.angle(!lDir) / 2
  !adj = !element.aPos.distance(!element.pos)
  if !adj.eq(0) then
      !bendRadius = 0
  else
      !bendRadius = tan( !angle ) * !adj
  endif

  return !bendRadius

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      method .getBendArc
--
-- Description: method to create an arc between the arrive and
-- leave positions of the passed element
-- used for elbows and bends
--
------------------------------------------------------------------------

define method .getBendArc(!element is DBREF ) is ARC

--find the centre of radius for the bend or elbow
   !aPosition = !element.aPos.wrt( /* )
   !lPosition = !element.lPos.wrt( /* )
   !aDir = !element.aDir.wrt( /* )
   --!lDir = !element.lDir.wrt( /* )

   -- make a flat plane which passes through p1 and p2 and the elbow centre point
   --!elbowDir = !aDir.cross(!lDir)
   !elbowDir = !element.orientation.zDir()
   !bendArc = object ARC()
   !radius = !this.getRadius(!this.insertComponent)

   !bendArc = !aPosition.arcRadius( !lPosition, !element.position.wrt(/* ), !elbowDir, !radius,false)
   if !bendArc.starttangent().neq (!aDir) then
    !bendArc = !aPosition.arcRadius( !lPosition, !element.position.wrt(/* ), !elbowDir.opposite(), !radius,false)
   endif

   --!this.drawArc(!bendArc)

return !bendArc

endmethod

------------------------------------------------------------------------
--
-- Method:      .drawNewBranch
--
-- Description:
--
--
------------------------------------------------------------------------
define method .drawNewBranch(!mode is BOOLEAN, !dPosition is POSITION)

 if !this.headOrTail.eq('HEAD') then
   !diameter = !this.connectedBranch.phod.value()
 --Hold end to be connected head or tail (true False)
 else
   !diameter = !this.connectedBranch.ptod.value()
 endif

 !height = 500
  aid CLEAR CYLI $!<this.tagAids>
  handle ANY
  --q var !!error
  endhandle
   if !mode then
   --q var !insert
     !pv = object POINTVECTOR()
     !pv.position  = !dPosition
     !pv.direction = !this.newBranchDirection
     !newPv = !pv.offset(!height / 2)
     !diameter = !diameter + 1
     --pin 9 at  $!<newPv.position>
     !posString = !newPv.position.string().before('WRT')

     AID CYLINDER NUMBER $!<this.tagAids>  AT $!<posString>  ORI Z IS $!<pv.direction>   HEIGH $!<height>mm DIAM $!<diameter>mm FILLED ON
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .drawArc
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .drawArc(!arc is ARC)

  aid clear arc $!<this.tagAids>
  handle ANY
  endhandle
  !midPoint = !arc.anglePosition(!arc.angle() / 2)
  !arcStart = !arc.anglePosition(!arc.startAngle)
  !arcEnd   = !arc.anglePosition(!arc.endAngle)

  AID ARC NUMBER  $!<this.tagAids> $!<arcStart> TO $!<arcEnd> thru $!<midPoint>

endmethod

------------------------------------------------------------------------
--
-- Method:     .drawPlane
--
-- Description: method to orientate the plane according to the pick direction
--
--
------------------------------------------------------------------------
define method .drawPlane(!mode is BOOLEAN,!plane is PLANE)

  if !plane.unset() then
    return
  endif

  if !mode then
       -- get the size of the plane

       !psize   =   !this.getPlaneSize()
       !planePos  = !plane.position
       !planeDrn  = !plane.orientation.zDir()

       -- draw the plane box
       aid translucency 35
         --$P $M /%PDMSUI%\des\clib\gplane $!psize $<plane $!planeDrn through $!planePos$> $<$> true $<$> $<$> 999 $<on$>
         $M /%PDMSUI%\des\clib\gplane $!<psize> $<plane $!<planeDrn> through $!<planePos> $> $<$> true $<$> $<$> $!<this.tagAids> $<on$>
       aid translucency 0
 else
       --AID CLEAR TEXT $!this.tagId
       AID CLEAR TEXT $!this.tagAids
       handle ANY
       endhandle
       AID CLEAR sphere $!this.tagAids
       -- AID CLEAR cylinder $!this.tagId
       handle ANY
       endhandle
       --AID CLEAR arrow $!this.tagId
       AID CLEAR arrow $!this.tagAids
       handle ANY
       endhandle
       AID CLEAR BOX $!this.tagAids
       handle ANY
       endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: .getPlaneSize()is REAL
--
-- Description: adjust the plane size according to the pipe size.
-- the plane should nominally be a metre but if the distance between the
-- pipe od and the plane edge gets below 250mm we increase the plane
-- to be 1000mm + the tube od
--
------------------------------------------------------------------------
define method .getPlaneSize()is REAL

 !diameter = !this.mainTubeOD
 handle ANY
   return 1000mm
 endhandle
 -- the plane size will only change if the pipe od is gt 1000
 !test = 1000mm - !diameter
 if !test.lt(500) then
     return !diameter + 1000mm
 else
     return 1000mm
 endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .calculateRotationPlane()
--
-- Description: create an arc object representing the direction from plane
-- this method is called once to setup the arc but may need to be re-evaluated
-- when the other parameters change
--
--
------------------------------------------------------------------------
define method .calculateRotationPlane()

  -- get the plane between the plane direction and the current branch direction

  !dir = !this.majorDirection.direction
  !this.newRotationAngle = !this.currentRotationAngle

  !ortho = !dir.orthogonal(!this.currentBranchDirection)
  handle(2,890)(2,869)
  -- the current branch direction is already on the plane
   !ortho = !this.currentBranchDirection
  endhandle

  -- construct an arc on the plane between the two directions
  !this.rotationArc= object ARC()
  !this.rotationArc.position = !this.plane.position
  !this.rotationArc.orientation = !this.plane.orientation
  !zDir = !this.plane.orientation.zDir()
  !xDir = !this.majorDirection.direction.string().before('WRT')
  !string = 'X IS ' & !xDir & 'AND Z IS ' & !zDir
  !this.rotationArc.orientation = $!string
  --New orientation

  !this.rotationArc.radius = 500mm
  !this.rotationArc.startAngle = 0
  !this.rotationArc.endAngle = 370
  !this.rotationArc.sense = FALSE
  !this.rotationArc= !this.rotationArc.circle()

  -- calculate the major direction angle
  !newLabels[1] = !this.rotationArc.anglePosition(0)
  !newLabels[2] = !this.rotationArc.anglePosition(90)
  !newLabels[3] = !this.rotationArc.anglePosition(180)
  !newLabels[4] = !this.rotationArc.anglePosition(270)

    do !a index !newLabels
     !textpos = !newLabels[!a]
     !atext = (!a - 1) * 90
     AID text number  $!this.tagAids '$!atext' at $!textpos
   enddo


  -- draw the arc
  !this.drawArc(!this.rotationArc)


endmethod

------------------------------------------------------------------------
--
-- Method:     .calculateRotationDirection()
--
-- Description: method to work out the angle projected onto the plane
--
------------------------------------------------------------------------
define method .calculateRotationDirection() is REAL

  !angle  =  !this.rotationArc.near(!this.newSurfacePosition)
  !s = !angle.string(!!realFmt).real()
  -- set the control value
  !this.currentRotationAngle = !angle

  return !s

endmethod

------------------------------------------------------------------------
--
-- Method:      method .applyRotation
--
-- Description: method to rotate a plane around an arc and return a plane
--              for elbows and bends
--
------------------------------------------------------------------------
--
define method .applyRotation(!plane is PLANE, !move is ARRAY, !arc is ARC)is PLANE

  -- calculate the distance
  if !move[1].lt(1) then
    !moveAngle = 0
  else
    !moveAngle = (!move[1] / (PI * (!arc.radius * 2)) * 180)
  endif

  !currentAngle = !arc.near(!plane.position)

  if !move[0].eq('Right')then
    !newAngle = !currentAngle + !moveAngle.value()
  else
    !newAngle = !currentAngle - !moveAngle.value()
  endif

  !newPlane = !plane

  !newPlane.position = !arc.anglePosition(!newAngle)
  !newPlaneDirection = !arc.angleTangent(!newAngle)
  !newPlaneXDirection = !plane.orientation.xDir()
  !ori = Z is $!newPlaneDirection and x is $!newPlaneXDirection
  !newPlane.orientation =!ori

  return !newPlane


endmethod

------------------------------------------------------------------------
--
-- Method:      .getNewDirection
--
-- Description: gets and returns the new branch direction from the passed
-- rotation angle
--
--
------------------------------------------------------------------------
define method .getNewDirection(!angle is REAL ) is DIRECTION

 -- this is scary
 !this.calculateRotationPlane()

  --!d1 = !this.rotationArc.angleDirection(0)
  --$p arc direction = $!d1 major = $!this.majorDirection
  !d2 = !this.rotationArc.angleDirection(!angle)

  --!pos = !this.plane.position
  --pin3 at $!pos
  --pin 3 direction $!d2
 return !d2

endmethod

------------------------------------------------------------------------
--
-- Method:      .initialiseForResetDirection()
--
-- Description: sets up the object for the specialbranchdirection form
--
--
------------------------------------------------------------------------
define method .initialiseForResetDirection()

  !this.currentBranchDirection = !this.branchDirection
  !this.currentSurfacePosition = !this.surfacePosition
  !this.newIntersectPos        = !this.currentSurfacePosition
  !this.newSurfacePosition     = !this.currentSurfacePosition
  !this.newBranchDirection     = !this.branchDirection

  -- calculate the bendarc or centreline
  !this.calculateCentreline()

  -- move the plane to the centreline
  !this.adjustPlaneToCentreline()

endmethod

------------------------------------------------------------------------
--
-- Method:      planeTags
--
-- Description: Works out a set of direction tags to add to the drawn plane
-- this method need to be simplified
--
------------------------------------------------------------------------
define method .planeTags()

   !directionArray = ARRAY()
   aid clear text $!this.tagAids
   handle ANY
   endhandle
   !orientation = !this.plane.orientation
   !planePosition = !this.plane.position

   !directionE = object POINTVECTOR()
   !directionE.position = !planePosition
   !directionE.direction = !orientation.xDir().wrt(/* )
   !textpos = !directionE.offset(503mm).position

   -- now get the north
   !directionN = object POINTVECTOR()
   !directionN.position = !planePosition
   !directionN.direction = !orientation.yDir().wrt(/* )

   -- now the west
   !directionW = !directionE
   !directionW.direction = !directionW.direction.opposite()
   !textpos = !directionW.offset(503mm).position

   -- now the south
   !directions = !directionN
   !directions.direction = !directions.direction.opposite()

   !directionArray[1] = !directionE
   !directionArray[2] = !directionN
   !directionArray[3] = !directionW
   !directionArray[4] = !directions

   !this.majorDirection  = !this.getBestFit(!directionArray)

   !line = !this.majorDirection.line(500mm)
   !this.drawLine(!line)

endmethod

------------------------------------------------------------------------
--
-- Method:      getNewSurfacePosition
--
-- Description: gets and returns an array of values relating to the
-- new branch positions
--
--
------------------------------------------------------------------------
define method .getNewSurfacePosition(!direction is DIRECTION ) is ARRAY

      !savedPlane = !this.plane
  -- we know the passed direction is correct about the centreline providing we are on the centreline
      if !this.centreLine.set() then
        !intersection = !this.plane.intersection(!this.centreLine)
        !dist = !intersection.distance(!this.plane.position)
        --$p plane needs to be moved by $!dist
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane)
      elseif !this.bendArc.set() then
        !intersections = !this.plane.intersections(!this.bendArc)
        do !a values !intersections
           if !this.bendArc.on(!a) then
              !intersection = !a
              break
           endif
        enddo
        !dist = !intersection.distance(!this.plane.position)
        handle ANY
          !!alert.error('You cannot move outside the selected component')
          return object ARRAY()
        endhandle
        !this.plane.position = !intersection
        !this.drawPlane(TRUE,!this.plane)
      endif

      -- add the plane tags
      !this.planeTags()
   -- construct a vector in the opposite direction to the passed direction
   !pv = object POINTVECTOR()
   !pv.position = !this.plane.position
   !pv.direction = !direction
   --!pv = !pv.offset(1000)

   !pv.direction = !direction.opposite()
   --pin6 at $!pv.position
   --pin 6 direction $!pv.direction
   --q var !pv
   !points = !this.getInsertComponentAndPosition(!pv)
   return !points
   --!points looks like this
   --[1]  <STRING> 'COMPONENT'
   --[2]  <DIRECTION> Y 42 Z WRT /*
   --[3]  <DBREF> =24104/2785
   --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*


endmethod
------------------------------------------------------------------------
--
-- Method:      .getNewSurfacePositionFromVector()
--
-- Description: method to set the new surface position and direction
-- based on the passed array details
--
--
------------------------------------------------------------------------
define method .getNewSurfacePositionFromVector(!a is ARRAY,!direction is DIRECTION)

   !inter = !a[1]
   do !b values !a
     if !b[3].eq(!this.insertComponent) then
       !inter = !b
       break
     endif
   enddo

   --passed array looks like this
   --[1]  <STRING> 'COMPONENT'
   --[2]  <DIRECTION> Y 42 Z WRT /*
   --[3]  <DBREF> =24104/2785
   --[4]  <POINTVECTOR> POINTVECTOR  POSITION X 3815.228mm Y -21910.567mm Z 35.506mm WRT /*  DIRECTION -X 41.379 Y 44.6921 Z WRT /*
   !type = !inter[1]
   !component = !inter[3]
   !passedVector = !inter[4]
   --!passedVector.direction = !inter[2].opposite()
   --!passedVector.direction = !passedVector.direction.opposite()
    --set the arctolerance to speed up picking
    !this.setArcTol(TRUE)

  if !type.eq('COMPONENT') then
    !vector = object POINTVECTOR()
    --!insert = 'COMPONENT'

    !vector = !this.intersect.intersection(!component,!passedVector)
    !copyPlane = !this.plane
    !copyPlaneDirection = !copyPlane.direction().cross(!direction)
    !copyPlaneXDirection = !copyPlane.direction()
    !ori = Z is $!copyPlaneDirection and x is $!copyPlaneXDirection
    !copyPlane.orientation =!ori
    !passedVector.direction = !direction
    !line = !inter[4].line(1000mm)
    !newLine = !line.projected(!copyPlane)
    !vector = !newLine.pointVector()

    !direction = !this.getNewDirection(!this.initialAngle)
    -- pass the flat plane direction to get an array
    !newSurfacePositions = !this.getNewSurfacePosition(!direction)

    !newInter = !newSurfacePositions[1]
    do !c values !newSurfacePositions
      if !c[3].eq(!this.insertComponent) then
        !newInter = !c
        break
      endif
    enddo
    !this.newIntersectPos = !newInter[4].position
  else
  	!passedVector.direction = !passedVector.direction.opposite()
    !vector = !this.intersect.impliedTubeIntersection(!component,!passedVector)
  endif

  --set the arctolerance to speed up picking
  !this.setArcTol(FALSE)

  -- set the new virtual branch direction and position
  !this.newBranchDirection = !vector.direction
  !this.newSurfacePosition = !vector.position

  -- redraw the branch
  !this.drawNewBranch(FALSE,!this.newSurfacePosition )
  !this.drawNewBranch(TRUE,!this.newSurfacePosition )

  -- redraw rotation plane aids
  !this.calculateRotationPlane()

endmethod
------------------------------------------------------------------------
--
-- Method:      .getBestFit
--
-- Description: calculates the best and get the major direction
--
--
------------------------------------------------------------------------

define method .getBestFit(!directions is ARRAY ) is POINTVECTOR

!angles = ARRAY()
do !a index !directions
  !b = !directions[!a].towards(!this.newIntersectPos)
  !angles.append(!directions[!a].direction.angle(!b.direction))
enddo

!index = !angles.sortedindices()


return !directions[!index[1]]
-- return the major direction

endmethod
------------------------------------------------------------------------
--
-- Method:      .clearPins()
--
-- Description: method used for debugging only to get rid of design pins
-- if used
--
------------------------------------------------------------------------
define method .clearPins()

do !a from 1 to 10
  pin $!a off
  handle ANY
  endhandle
enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      .getConnectionProperties
--
-- Description: method to setup the graphical aid cylinder representing the
-- joint
--
--
------------------------------------------------------------------------
define method .getConnectionProperties(!component is DBREF)

  !this.getConnectionProperties(!component,TRUE)
endmethod
------------------------------------------------------------------------
--
-- Method:      .getConnectionProperties
--
-- Description: method to setup the graphical aid cylinder representing the
-- joint
--
--
------------------------------------------------------------------------
define method .getConnectionProperties(!component is DBREF,!getFlen is BOOLEAN)

  -- if we are dealing
  if !getFlen then
  !this.flen = rprop fLen of $!component
    handle ANY
      !this.flen = 0
    endhandle
  endif
  !this.cdia = rprop cDia of $!component
  handle ANY
    !this.cdia = !this.stubInTubeOD
  endhandle
  !this.chei = rprop cHei of $!component
  handle ANY
    !this.chei = 150mm
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      .getBranchHeadAndTail
-- Description:  get branch href tref
--
--
------------------------------------------------------------------------
define method .getBranchHeadAndTail(!branch is DBREF)

!this.href = !branch.href
!this.tref = !branch.tref


endmethod

------------------------------------------------------------------------
--
-- Method:      .showPositions
--
-- Description: debug method to put pins at the current object positions
--
--
------------------------------------------------------------------------

define method .showPositions(!onOff is BOOLEAN)

do !a from 1 to 10
  pin $!a off
enddo

if !onOff.not() then
  return
endif

pin 1 at $!this.branchPosition
pin 1 direction $!this.branchDirection
pin 2 at $!this.existingPosition
pin 3 at $!this.insertPosition
pin 4 at $!this.surfacePosition

endmethod

------------------------------------------------------------------------
--
-- Method:      .drawLine
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .drawLine(!line is LINE)

  aid clear line $!this.tagAids
  handle ANY
  endhandle
  aid line number $!this.tagAids  $!line.startPosition to $!line.endPosition lines dashed

endmethod

------------------------------------------------------------------------
--
-- Method:      .clearAids()
--
-- Description: Draw the arc representing the rotation angle from the plane
--
--
------------------------------------------------------------------------
define method .clearAids()

   aid clear all $!this.tagAids

endmethod
------------------------------------------------------------------------
--
-- Method:      getmaxBore()
--
-- Description: get the maximum bore of the main branch
--
--
------------------------------------------------------------------------
define method .getMaxBore()is BORE

 !bore = !this.mainBranch.hBore

 if !this.mainBranch.members.size().gt(0) then
   do !a values !this.mainBranch.members
     !testBore = !a.aBore
     handle ANY
       skip
     endhandle
     if !testBore.gt(!bore) then
       !bore = !testBore
     endif
      !testBore = !a.lBore
     handle ANY
       skip
     endhandle
     if !testBore.gt(!bore) then
       !bore = !testBore
     endif
   enddo
 endif

return !bore

endmethod
------------------------------------------------------------------------
--
-- Method:      .setArcTol(!mode is BOOLEAN)
--
-- Description: set the graphics arctol to speed up the pipeintersections call
--
--
------------------------------------------------------------------------
define method .setArcTol(!mode is BOOLEAN)

 if !mode then
   var !arctol repre darc
   !this.arctol = !arctol.real()
   repre darctol 10
   --clock init
 else
   --clock read
   repre darc $!this.arctol
 endif

endmethod
