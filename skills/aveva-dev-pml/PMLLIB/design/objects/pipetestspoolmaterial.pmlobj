--
--  File:            pipetestspoolmaterial.pmlobj
--    Type:          Function Definition
--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        draft
--  Author:          T.Martin
--  Created:
--
--  Description:    Tests isometric plotfiles against material files to find spool names
--
define object PIPETESTSPOOLMATERIAL

  member .detailedSpoolList is ARRAY
  member .spoolList         is ARRAY
  member .isoList           is ARRAY
  member .textFiles         is ARRAY
  member .sourceDirectory   is FILE


endobject

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  findFiles(REAL)                  -
--  findSpools()                     -
--  pipeTestSpoolMaterial(ARRAY,FILE) -
--  readSpoolFiles()                 -
--  removeOldPlotFile(STRING)        BOOLEAN
--  searchForName(FILE,DBREF)        BOOLEAN
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipeTestSpoolMaterial(!spoolList is ARRAY,!sourceDirectory is FILE )
-- We should get a list of isometric plot files and a corresponding list of material files
-- We need to read the contents of the material files and match them with iso files

!this.detailedSpoolList = !spoolList
!this.sourceDirectory = !sourceDirectory

-- go and get the list of iso files
!this.findFiles(1)

-- go and get the list text files
!this.findFiles(2)

-- now we have a list of the files we need to go and find each spool
!this.readSpoolFiles()

endmethod
------------------------------------------------------------------------
--
-- Method  readSpoolFiles
-- Description: reads through the Isodraft text files and finds the spool
-- the text file relates to when it finds a file it renames the iso plot file
-- to suit.
--
------------------------------------------------------------------------
define method .readSpoolFiles()

  !isoFile = object FILE()
  do !spool values !this.detailedSpoolList
     !pipeRef = !spool.ownlst[3]
     !pipeName = !pipeRef.namn
    do !a index !this.textFiles
      -- try and remove excessive searching
      if !this.textFiles[!a].entry().match(!pipeName).neq(1) then
         skip
      endif

      !spoolTest = !this.searchForName(!this.textFiles[!a],!spool)
         -- if spool test is TRUE then te  !this.textFiles[!a] contains the spool
         -- and this must equate to is0
      if !spoolTest then

        !index = !this.textFiles[!a].string().after('matl')
        -- find the matching iso index
        do !b values !this.isoList

          if !b.entry().match(!pipeName & '.iso' & !index).eq(1) then
             !isoFile = !b
             break
          endif
        enddo

        if !isoFile.unset() then
          skip
        else
          --$p found file is $!isoFile
          --!newName = !this.isoList[!a].before(!this.pipeName) &  !searchName & '.plt'
          --$p filename $!this.isoList[$!a] is spool $!searchName
          !shortName = |U-| & !spool.namn  & |.iso.plt|
          -- if it exists, go and remove the old underlay file
          !this.removeOldPlotFile(!shortName)
          syscom 'ren $!isoFile $!shortName'
          break
        endif
      endif
    enddo

  enddo

endmethod

------------------------------------------------------------------------
--
-- Method  findSpools
-- Description: Gets an array of all the material text files in the source directory
--
------------------------------------------------------------------------
define method .findSpools()

  !pipeRef    = !this.detailedSpoolList[1].ownlst[3]
  -- collect all the spools for the current pipe
  !childSpools  = !!collectAllFor('PSPOOL','', !pipeRef)
  !this.spoolList = !childSpools

endmethod
------------------------------------------------------------------------
--
-- Method  findFiles
-- Description: Gets an array of all the iso files in the source directory
--
------------------------------------------------------------------------
define method .findFiles(!type is REAL )

   do !i indices !this.detailedSpoolList
         !pipeRef    = !this.detailedSpoolList[!i].ownlst[3]
         -- get a possible filename for the current index !i
        if !type.eq(1) then
          -- we are collecting the plot files
          do !count from 1 to !this.detailedSpoolList[!i].owner.members.size()
              !spoolIndex = substring('00' & !count, -3, 3)
              !tmpPltPath = !this.sourceDirectory.string() & |\| & !pipeRef.namn & |.iso| & !spoolIndex
              -- create a file object to test if the file exists
              !checkSpoolFile = object FILE(!tmpPltPath)
              if (!checkSpoolFile.exists()) then
                 !this.isoList.append(!checkSpoolFile)
              else
                 --$p could not find $!checkSpoolFile
              endif
          enddo
        else
         do !count from 1 to !this.detailedSpoolList[!i].owner.members.size()
             !spoolIndex = substring('00' & !count, -3, 3)
             -- we are collecting the text files
             !tmpPltPath = !this.sourceDirectory.string() & |\| & !pipeRef.namn & |-matl| & !spoolIndex
             -- create a file object to test if the file exists
             !checkSpoolFile = object FILE(!tmpPltPath)
             if (!checkSpoolFile.exists()) then
                !this.textFiles.append(!checkSpoolFile)
             else
             endif
          enddo
        endif
   enddo

endmethod

------------------------------------------------------------------------
--
-- Method  searchForName
-- Description: Search through the text files to find the current searchName
-- if the searchName index matches the current spool index then we are ok
-- if its different we need to some file renaming
--
------------------------------------------------------------------------
define method .searchForName(!searchName is FILE, !spool is DBREF )is BOOLEAN

   !pipeRef    = !spool.ownlst[3]
   !spoolName = ' ' & !spool.namn
   --$p pipeName is $!pipeName in searchForName and spool name is $!spool.namn and file is $!searchName
   !lines = !searchName.readFile()
   -- take out the first 8 lines to avoid finding the file name
   !lines = !lines.from(8)
   handle ANY
     return 'unset'
   endhandle
   do !a values !lines
     if !a.match(!spoolName).neq(0) then
        !spoolIndex = !a.split()[!a.split().size()]
        return TRUE
     endif
   enddo

   return FALSE
endmethod

------------------------------------------------------------------------
--
-- Method  removeOldPlotFile
--
-- Description: Before we can change the name of the resultant plot file
-- we need to delete any existing copies. this routine deletes an existing
-- File

------------------------------------------------------------------------
define method .removeOldPlotFile(!file is STRING )is BOOLEAN

!fileName = !this.sourceDirectory & '\' & !file
!testFile = object FILE(!fileName)
if !testFile.exists() then
  !testFile.deletefile()
  handle ANY
    --q var !!error
  endhandle
endif

endmethod
-- End of object definition
