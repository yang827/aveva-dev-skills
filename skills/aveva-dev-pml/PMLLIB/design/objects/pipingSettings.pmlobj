--
-- Author:          Richard Martin
-- Created:         04/07/2012 14:16:16
--
--
-- Description:     Object for obtaining and saving user defaults that will be used with piping application forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  loadDefaultValues()              -
--  loadFileDefaults()               -
--  parseFileLines(ARRAY)            -
--  pipingSettings()                 -
--  saveDefaults()                   -
--
define object PIPINGSETTINGS

  --component creation members
  member .snapDist is STRING
  member .minTube is STRING
  member .autoAlign is BOOLEAN
  member .autoCreate is BOOLEAN
  member .useAlternateSpec is BOOLEAN
  member .skipConnected is BOOLEAN

  -- Pipe Editor settings
  member .sortSpecification is BOOLEAN

  --generic option members
  member .descriptions is STRING

  -- Non standard Branch Connections
  member .nonStandardBranchTable is STRING
  member .nonStandardBranchNoTube is BOOLEAN

  --internal object members
  member .fileName is STRING

endobject

--constructor
define method .pipingSettings()

  -- First check to see if the PIPINGADMIN team exists
  !unusedPipingAdminTeam = object TEAM('PIPINGADMIN')
  handle ANY
    -- Try and get the defaults from the user file as the PIPINGADMIN team does not exist
    var !user login
    !this.fileName = '%AVEVA_DESIGN_USER%/piping_settings_' & !user
  elsehandle NONE
    -- Try and get the defaults from the general settings file as the PIPINGADMIN team exists
    !this.fileName = '%PDMSDFLTS%/piping_settings_General'
  endhandle

  !file = object FILE(!this.fileName)
  if (!file.exists().not()) then
    !this.loadDefaultValues()
  else
    --first load the default values, this ensures that if any changes to the defined defaults file format have been made
    --i.e. we are supporting more defaults than a previous version, all of the members in the object will be set irrespective of whether
    --or not we have a file value for the member. the file values will be set after the defaults are set
    !this.loadDefaultValues()
    --now load any file values that have been set
    !this.loadFileDefaults()
  endif

endmethod

--load the user settings file
define method .loadFileDefaults()

  !file = object FILE(!this.fileName)
  !fileLines = !file.readfile()
  !this.parseFileLines(!fileLines)

endmethod

--parse the file lines array read in from file
define method .parseFileLines(!lines is ARRAY)

  do !i from 1 to !lines.size()

    --each line of the lines array will set one of the objects settings members thus setting up the
    --defaults for the piping application
    !this.$!lines[$!i]
    handle ANY
      skip
    endhandle

  enddo

endmethod

--these are the default piping settings that get loaded if a user defaults file is not found
define method .loadDefaultValues()

  --component creation members
  !this.snapDist =          '2 * OD'
  !this.minTube =           '100mm'
  !this.autoAlign =         TRUE
  !this.autoCreate =        TRUE
  !this.useAlternateSpec =  TRUE
  !this.skipConnected =     TRUE

  !this.sortSpecification = TRUE
  !this.nonStandardBranchTable = '3'
  !this.nonStandardBranchNoTube = FALSE

  --generic option members
  !this.descriptions =      'CATTEX'

endmethod

--save the object defaults to file
define method .saveDefaults()

  --setup a file in the aveva_design_user area
  !file = object FILE(!this.fileName)

  --get a list of object members that need to be written out to file
  !membersList = !this.attributes()
  !fileLines = object ARRAY()
  do !i from 1 to !membersList.size()

    --skip any unused or object specific members
    if (!membersList[!i] inset ('FILENAME')) then
      skip
    else
      --else build a filelines array of items to write out
      !memberVal.delete()
      handle (2,751)
      endhandle
      !memberVal = !this.$!membersList[$!i]
      !memberString = !memberVal.string()
      !memberType = !memberVal.objecttype()

      --if the member object type is string then we need to add enclosing ||'s
      if (!memberType.eq('STRING')) then
        !memberString = '|' + !memberString + '|'
      endif

      !lineString = !membersList[!i] + ' = ' + !memberString
      !fileLines.append(!lineString)
    endif

  enddo

  --write out the file
  !file.writefile('OVERWRITE', !fileLines)

endmethod
