-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rangeSelect()

  -- Initialise Variables
  !this.rangePrompt       = 'Select'
  !this.rangeDescription  = 'Select Component Range'
  !this.rangeAction       = 'showRange()'
  !this.rangeStartSelect()

endmethod
-- End of method definition


------------------------------------------------------------------------
