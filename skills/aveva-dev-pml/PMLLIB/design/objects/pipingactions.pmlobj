--
--
-- Description:
--    General object for handling common piping actions not specific
--    to any one particular form or utility
--
-- Problems:
--
--    Marking DB on multiple items should not mark per change, but
--    for the overall change.
--
--    Check update of components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignComponent(DBREF)            BOOLEAN             Align a single component
--  alignComponents()                BOOLEAN             Align the passed components
--  alignComponents(ARRAY)           BOOLEAN             Align the passed components
--  alignToEccentric(DBREF,BOOLEAN)  BOOLEAN             Check for ECC Reducers next to component to be orientated
--  componentGroup()                 BOOLEAN             Derives the component group information from the current
--  componentGroup(ARRAY)            BOOLEAN             Derives the component group from the passed elements,
--  copySelection()                  BOOLEAN             Instigate EDG for picking
--  copySelection(EDGPICKDATA)       -                   Instigate EDG for picking
--  copySelection(SELECTION)         BOOLEAN             Copy the passed components
--  deleteComponentRange()           -                   Define event for deleting a range of piping components
--  deleteRange()                    -                   Delete components in the defined range
--  directComponent(DBREF)           BOOLEAN             Direct a single component
--  directComponent(DBREF,BOOLEAN)   BOOLEAN             Direct a single component
--  directComponents()               BOOLEAN             Direct the passed components
--  directComponents(ARRAY)          BOOLEAN             Direct the passed components
--  directComponents(ARRAY,BOOLEAN)  BOOLEAN             Direct the passed components
--  directTubing(DBREF)              BOOLEAN             Direct components at end of piece of tubing (only if they
--  directTubing(DBREF,BOOLEAN)      BOOLEAN             Direct components at end of piece of tubing (only if they
--  fixedAngleLeg(REAL,REAL,DBREF)   BOOLEAN
--  isEccentric(DBREF)               BOOLEAN
--  lineSegment()                    BOOLEAN             Derives the line segment information from the current
--  pipingActions()                  -                   Constructor
--  pipingActions(STRING)            -                   Constructor
--  rangeBranch()                    -                   Determine range of items
--  rangeDefine(ARRAY)               -                   Determine range of items
--  rangeEndSelect()                 -                   Instigate an event for identifying the end of a range select
--  rangeSelect()                    -                   Define event for selecting a range of piping components
--  rangeStart(EDGPICKDATA)          EDGPICKDATA         Define start of range
--  rangeStartSelect()               -                   Instigate an event for defining a range of piping components
--  setTolerances()                  -                   Set tolerances to datacon tolerances
--  showRange()                      -
--
------------------------------------------------------------------------

define object PIPINGACTIONS

  -- Variable name (this is because we can't determine the object name
  -- name from the object itself once we are inside it)
  member .varID                 is STRING

  -- Active component
  member .component             is DBREF

  -- Active components
  member .components            is ARRAY

  -- Range Selection
  member .rangeBranch           is DBREF
  member .rangeStart            is DBREF
  member .rangeFrom             is EDGPICKDATA
  member .rangeEnd              is DBREF
  member .rangeTo               is EDGPICKDATA
  member .range                 is ARRAY
  member .fromelementtube       is BOOLEAN
  member .toelementtube         is BOOLEAN
  member .hstube                is BOOLEAN
  member .pickmode              is STRING

  -- EDG Description for range select
  member .rangeDescription      is STRING

  -- Additional prompt string for range select
 member .rangePrompt            is STRING

  -- Action carried out on range selection
  member .rangeAction           is STRING

  -- Component Group information
  member .groupArrive           is POINTVECTOR
  member .groupLeave            is POINTVECTOR
  member .componentGroup        is ARRAY
  member .groupParallel         is BOOLEAN
  member .groupConcentric       is BOOLEAN

  -- Line segment information
  member .lineSegmentArrive     is POINTVECTOR
  member .lineSegmentLeave      is POINTVECTOR
  member .lineSegmentParallel   is BOOLEAN
  member .lineSegmentConcentric is BOOLEAN

  -- Tolerances (private members)
  member .distanceTolerance     is REAL
  member .angleTolerance        is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipingActions
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipingActions()

  -- Initialise Variables
  !this.varID = 'pipingActions'
  !this.setTolerances()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setTolerances
--
-- Description: Set tolerances to datacon tolerances
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTolerances()

  -- Initialise Variables
  var !tolAngle  TOL ANGLE
  var !tolOffset TOL OFFSET

  -- Handle imperial values
  !pos    = object POSITION('N' & !tolOffset)
  !offset = !pos.north

  !this.angleTolerance    = !tolAngle.real()
  !this.distanceTolerance = !offset

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pipingActions
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipingActions(!varID is STRING)

  -- Initialise Variables
  !this.pipingActions()
  !this.varID = !varID

endmethod
-- End of method definition

------------------------------------------------------------------------
