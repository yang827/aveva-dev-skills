  !this.rangeDescription  = 'Delete Pipe Range'
  !this.rangeAction       = 'deleteRange()'
  !this.rangeStartSelect()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rangeStartSelect
--
-- Description: Instigate an event for defining a range of piping components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rangeStartSelect()

  -- Initialise Variables
  !this.rangeBranch = object DBREF()
  !this.rangeStart  = object DBREF()
  !this.rangeFrom   = object EDGPICKDATA()
  !this.rangeEnd    = object DBREF()
  !this.rangeTo     = object EDGPICKDATA()
  !this.range.clear()

  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.description     = !this.rangeDescription

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.action          = '!!' & !this.varID & '.rangeDefine(!this.return[1])'
  !packet.escape          = '!!' & !this.varID & '.rangeBranch()'

  -- Define first pick definition
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Identify start of range selection to ' & !this.rangePrompt )
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE eq |BRAN| or TYPE of OWNER eq |BRAN|'
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE eq |BRAN| or TYPE of OWNER eq |BRAN|'
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.pickPacket.picks[1].action          = '!!' & !this.varID & '.rangeStart(!this.return[1])'

  -- Define first pick definition
  !packet.pickPacket.picks[2]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdElement('Identify end of range selection to ' & !this.rangePrompt )
  !packet.pickPacket.picks[2].pick.input[3]   = 'OWNER eq !!' & !this.varID & '.rangeBranch'
  !packet.pickPacket.picks[2].pick.input[5]   = 'OWNER eq !!' & !this.varID & '.rangeBranch'

  !packet.pickPacket.picks[2].pick.modifiable = false

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rangeEndSelect
--
-- Description: Instigate an event for identifying the end of a range select
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rangeEndSelect()

  -- Initialise Variables

  -- Define EDG Packet
  !packet                 = object EDGPACKET()
  !packet.description     = !this.rangeDescription

  -- When the component has been created successfully
  !packet.remove          = true
  !packet.action          = '!!' & !this.varID & '.rangeDefine(!this.return[1])'

  -- Define first pick definition
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Identify end of range selection to ' & !this.rangePrompt )
  !packet.pickPacket.picks[1].pick.input[3]   = 'OWNER eq ' & !this.rangeBranch
  !packet.pickPacket.picks[1].pick.input[5]   = 'OWNER eq ' & !this.rangeBranch
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to event system
  if(!!edgCntrl.add(!packet)) then
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rangeStart
--
-- Description: Define start of range
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Pick information
-- Return:
--   [Data Type] [Description]
--    EDGPICKDATA Same data as passed, as EDG system expects a return
--
------------------------------------------------------------------------

define method .rangeStart(!data is  EDGPICKDATA) is EDGPICKDATA

  if(!!dbrefUpdatable(!data.item).not()) then
     !!alert.warning('Unable to Modify range of components. "' & !!error.text & '".')
     return
  endif
  -- Get Branch Info
  if(!data.item.type eq 'BRAN') then
    !branch = !data.item
  elseif (!data.item.owner.type eq 'BRAN') then
    !branch =  !data.item.owner
  endif

  -- Set first pick info
  !this.rangeBranch = !branch
  !this.rangeStart  = !data.item
  !this.rangeFrom   = !data

  -- Return the initial data
  return !data

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rangeBranch
--
-- Description: Determine range of items
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- the user has pressed escape which defines that the whole branch should be split or he wants to stop
define method .rangeBranch()


  if !this.rangeFrom.unset() then
    return
  endif
  if !!alert.confirm('Do You want to continue splitting the whole branch?').neq('YES') then
      return
  endif

  if(!this.rangeFrom.tubing.upcase() eq 'HEAD') then
    -- its the start of the branch to the end
    !branch = !this.rangeFrom.item
  else
    !branch = !this.rangeFrom.item.owner
  endif
  if !this.rangeFrom.item.order.geq(!branch.members.size() / 2) then
    -- we are splitting from tail to head
    !this.rangeFrom.item   = !branch.members[!branch.members.size()]
    !this.rangeFrom.tubing = 'TUBE'
    !this.rangeFrom.type    = 'ELEMENT'
    !this.rangeTo.item     = !branch
    !this.rangeTo.tubing   = 'TUBE'
    !this.rangeTo.type     = 'HEAD'
  else
    !this.rangeFrom.item   = !branch
    !this.rangeFrom.type    = ''
    !this.rangeFrom.tubing = 'HEAD'
    !this.rangeTo.item     = !branch.members[!branch.members.size()]
    !this.rangeTo.tubing   = 'TUBE'
    !this.rangeTo.type     = 'ELEMENT'
  endif

  !data[1] = !this.rangeFrom
  !data[2] = !this.rangeTo
  !this.rangeDefine(!data)


endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      rangeDefine
--
-- Description: Determine range of items
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rangeDefine(!data is  ARRAY)

  -- Initialise Variables



  !this.fromelementtube = FALSE
  !this.toelementtube   = FALSE
  !this.hstube          = FALSE

  -- Determine components
  !this.rangeTo   = !data[2]
  !fromType       = !this.rangeFrom.type.upcase()
  !toType         = !this.rangeTo.type.upcase()

  -- Get from index within the list
  if(!fromType eq 'ELEMENT') then
    !fromIndex    = !this.rangeFrom.item.sequence
  else
    if(!this.rangeFrom.tubing.upcase() eq 'HEAD') then
      !this.hstube = TRUE      $* the user has picked the head tube
      !fromIndex  = 0.5
    else
      !this.fromelementtube = TRUE  $* the user has picked the leave tube of the
      !fromIndex  = !this.rangeFrom.item.sequence + 0.5
    endif
  endif

  -- Get to index within the list
  if(!toType eq 'ELEMENT') then
    !toIndex      = !this.rangeTo.item.sequence
  else
    if(!this.rangeTo.tubing.upcase() eq 'HEAD') then
      !toIndex    = 0.5
      !this.hstube = TRUE
    else
      !toIndex    = !this.rangeTo.item.sequence + 0.5
      !this.toelementtube = TRUE
    endif
  endif

  -- Check if we have only implied tubing
  if((!fromIndex - !toIndex eq 0) and (!fromIndex - int(!fromIndex) eq 0.5)) then
    return
  endif

  -- Switch order about
  if(!fromIndex gt !toIndex) then
    !temp         = !fromIndex
    !fromIndex    = !toIndex
    !toIndex      = !temp
    !this.pickmode = 'back'
  else
    !this.pickmode = 'forw'
  endif

  !from           = int(!fromIndex + 0.5)
  !to             = int(!toIndex   + 0.4)

  -- Components
  !this.range     = !this.rangeBranch.members.from(!from, !to - !from + 1)

  -- Check we can modify/delete the elements in the range
  do !i indices !this.range
    if(!!dbrefUpdatable(!this.range[!i]).not()) then
      !!alert.warning('Unable to process range of components. "' & !!error.text & '".')

    -- Initialise Variables
      !this.rangeBranch = object DBREF()
      !this.rangeStart  = object DBREF()
      !this.rangeFrom   = object EDGPICKDATA()
      !this.rangeEnd    = object DBREF()
      !this.rangeTo     = object EDGPICKDATA()
      !this.range.clear()

      return
    endif
  enddo

  -- Evaluate action on Range
  !block          = object BLOCK('!this.' & !this.rangeAction)
  !block.evaluate()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteRange
--
-- Description: Delete components in the defined range
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteRange()

  -- Initialise Variables
  !first = !this.range.first().sequence

  -- Handle No Elements
  if(!this.range.unset()) then
    !!alert.warning('No components to delete.')
    return
  endif

  -- Highlight items to delete
  do !component values !this.range
    ENHANCE $!<component> COLOUR RED
  enddo

  -- Check if we want to delete items
  if(!!alert.confirm('OK to delete highlighted components?').boolean().not()) then

    do !component values !this.range
      UNENHANCE $!<component>
    enddo

    -- Initialise Variables
    !this.rangeBranch = object DBREF()
    !this.rangeStart  = object DBREF()
    !this.rangeFrom   = object EDGPICKDATA()
    !this.rangeEnd    = object DBREF()
    !this.rangeTo     = object EDGPICKDATA()
    !this.range.clear()
    return
  endif

  -- Mark the database
  !undo = object UNDOABLE()
  !undo.description('Range of components delete')
  !undo.add()

  -- Delete items
  do !component values !this.range
    !!ce  = !component
    !type = !component.type
    DELETE $!<type>

    -- Need to check on errors?
    handle ANY
    endhandle

  enddo

  -- Navigate to the previous element in the list
  if(!first gt 1) then
    !!ce = !this.rangeBranch.members[!first - 1]
  -- Move to the "first" element in the new list
  elseif (!this.rangeBranch.mcount gt 0) then
    !!ce = !this.rangeBranch.members[!first]
  else
    !!ce = !this.rangeBranch
  endif

  -- End undo
  !undo.endUndoable()

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      ShowRange
--
-- Description: show components in the defined range
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showRange()

  -- Initialise Variables
  !first = !this.range.first().sequence

  -- Handle No Elements
  if(!this.range.unset()) then
    !!alert.warning('No components selected.')
    return
  endif

  -- Highlight items to delete
  do !component values !this.range
    ENHANCE $!<component> COLOUR RED
  enddo

  -- this calls the splitting object with the selected range of components
  !unusedSplitSegment = object SPLITSEGMENT(!!segmentactions)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentGroup
--
-- Description: Derives the component group from the passed elements,
--              returns components via argument.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       Array of components
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid list of components is returned
--
------------------------------------------------------------------------

define method .componentGroup(!components is ARRAY) is BOOLEAN

  -- Initialise Variables


  -- Return
  return false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentGroup
--
-- Description: Derives the component group information from the current
--              components in the "components" member of the object. Data
--              written to the object.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid list of components is returned
--
------------------------------------------------------------------------

define method .componentGroup() is BOOLEAN

  -- Initialise Variables
  !components       = ARRAY()

  -- Remove any implied tube
  do !component values !this.components

    skip if(!component.type eq 'TUBI' or !component.owner.type ne 'BRAN')
    if(!!dbrefUpdatable(!component).not()) then
      return false
    endif
    !components.append(!component)
  enddo

  -- No components to derive group from
  if(!components.empty()) then
    !!error.text = 'No component(s) selected.'
    return false
  endif

  -- Define data table
  !table            = object TABLE()
  !table.primaryKey(!components)

  -- Define columns
  !columns[1]       = object COLUMN(object EXPRESSION('SEQUENCE'), true, true, 'Sequence')
  !columns[2]       = object COLUMN(object EXPRESSION('OWNER'), true, true, 'Owner')

  -- Build Table
  !table.columns(!columns)
  !table.evaluate()

  -- Check we have the same parent for all elements
  !parents          = !table.column('Owner').unique()
  if(!parents.size() gt 1) then
    !!error.text    = 'A component group can only contain components which have the same parent.'
    return false
  endif

  -- Check that all components are contiguous
  !sequence         = !table.column('Sequence')
  !firstIndex       = !sequence.first()
  !lastIndex        = !sequence.last()
  !range            = !lastIndex - !firstIndex + 1
  if(!range ne !sequence.size()) then
    !!error.text    = 'Selected components are not contiguous.'
    return false
  endif

  -- Empty component group list
  !this.componentGroup.clear()

  -- Group components
  !this.componentGroup      = !table.primaryKey()

  -- Start/End component of group
  !first                    = !this.componentGroup.first()
  !last                     = !this.componentGroup.last()

  -- Arrive/Leave information of group
  !aPosition                = !first.aPosition
  !aDirection               = !first.aDirection
  !lPosition                = !last.lPosition
  !ldirection               = !last.ldirection
  !this.groupArrive         = object POINTVECTOR(!aPosition, !aDirection)
  !this.groupLeave          = object POINTVECTOR(!lPosition, !ldirection)

  -- Basic characteristics of group
  !this.groupParallel       = !aDirection.isParallel(!ldirection)
  !this.groupConcentric     = !this.groupArrive.line(1000mm).distance(!this.groupLeave.line(1000mm)) le !this.distanceTolerance

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      lineSegment
--
-- Description: Derives the line segment information from the current
--              component group information. Data written to relevant
--              object members.
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid list of components is returned
--
------------------------------------------------------------------------

define method .lineSegment() is BOOLEAN

  -- Initialise Variables

  -- Check there the component group has entries
  if(!this.componentGroup.empty()) then
    !!error.text              = 'No components to derive line segments from.'
    return false
  endif

  -- Start/End component of group
  !first                      = !this.componentGroup.first()
  !last                       = !this.componentGroup.last()

  -- Arrive/Leave information of segment of line
  var !prevDir  PREVPP DIRECTION of $!<first> wrt World
  !pDirection                 = !prevDir.direction()
  var !prevPos  PREVPP POSITION of $!<first> wrt World
  !pPosition                  = !prevPos.position()
  var !nextDir  NEXTPP DIRECTION of $!<last> wrt World
  !nDirection                 = !nextDir.direction()
  var !nextPos  NEXTPP POSITION of $!<last> wrt World
  !nPosition                  = !nextPos.position()

  -- Line segment information
  !this.lineSegmentArrive     = object POINTVECTOR(!pPosition, !pDirection)
  !this.lineSegmentLeave      = object POINTVECTOR(!nPosition, !nDirection)

  -- Basic characteristics of line segment
  !this.lineSegmentParallel   = !pDirection.isParallel(!nDirection)
  !this.lineSegmentConcentric = !this.lineSegmentArrive.line(1000mm).distance(!this.lineSegmentLeave.line(1000mm)) le !this.distanceTolerance

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      alignComponent
--
-- Description: Align a single component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
--
--  Non-parallel component will align at intersection between adjacent components
--  Parallel component will align on common centre line
--

define method .alignComponent(!component is DBREF) is BOOLEAN

  -- Check component is beneath a branch
  if(!component.owner.type ne 'BRAN') then
    !!error.text  = 'Component ' & !component.flnn & ' is not a member of a branch.'
    return false
  endif

  -- Check for passed implied tube
  if(!component.type eq 'TUBI') then
    !!error.text  = 'Unable to align implied tube.'
    return false
  endif

  -- Handle component without a specification reference
  if(!component.spref.unset()) then
    !!error.text  = 'Component has no specification reference.'
    return false
  endif

  -- Initialise variables
  !components[1]  = !component

  -- Align components
  return !this.alignComponents(!components)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      alignComponents
--
-- Description: Align the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Components to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .alignComponents(!components is ARRAY) is BOOLEAN

  -- Initialise Variables
  !this.components  = !components

  -- Derive Group information
  if(!this.componentGroup()) then

    -- Derive line segment information
    if(!this.lineSegment()) then

      -- Align component group
      return !this.alignComponents()

    endif

  endif

  -- Return
  return false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      alignComponents
--
-- Description: Align the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .alignComponents() is BOOLEAN

  -- Initialise Variables
  !result             = false
  !!error.text        = 'Unresolved.'

  -- Start/End component of group
  !first              = !this.componentGroup.first()
  !last               = !this.componentGroup.last()

  -- Group arrive/leave
  !aLine              = !this.groupArrive.line(1000mm)
  !lLine              = !this.groupLeave.line(1000mm)

  -- Previous/Next line
  !pLine              = !this.lineSegmentArrive.line(1000mm)
  !nLine              = !this.lineSegmentLeave.line(1000mm)

  -- Group Arrive/Leave information
  !aPosition          = !this.groupArrive.position
  !aDirection         = !this.groupArrive.direction
  !lPosition          = !this.groupLeave.position
  !ldirection         = !this.groupLeave.direction

  -- Line Segment Arrive/Leave information
  !pPosition          = !this.lineSegmentArrive.position
  !pDirection         = !this.lineSegmentArrive.direction
  !nPosition          = !this.lineSegmentLeave.position
  !nDirection         = !this.lineSegmentLeave.direction

  -- Basic characteristics of component(s)
  !parallelGroup      = !this.groupParallel

  -- Basic characteristics of previous and next legs
  !parallelLegs       = !this.lineSegmentParallel
  !intersectingLegs   = !parallelLegs.not()  and !pLine.distance(!nLine) le !this.distanceTolerance
  !intersectingGroup  = !parallelGroup.not() and !aLine.distance(!lLine) le !this.distanceTolerance

  -- Basic characteristics about relationship between component group and legs
  !aAligned           = !first.aQAngle.leq(!this.angleTolerance) and !first.aQOffset.leq(!this.distanceTolerance)
  !lAligned           = !last.lQAngle.leq(!this.angleTolerance)  and !last.lQOffset.leq(!this.distanceTolerance)

  -- Any alignment
  !anyAligned         = !aAligned.or(!lAligned)

    -- Angle between group arrive/leave and previous/next legs
    !aAngle           = !pDirection.angle(!aDirection.opposite())
    !lAngle           = !nDirection.angle(!ldirection.opposite())

    -- Offset from group arrive/leave to previous/next legs
    !aOffset          = !first.aQOffset
    !lOffset          = !last.lQOffset

  -- Non-parallel group and non-parallel legs
  if(!parallelGroup.not() and !parallelLegs.not()) then

    -- Align a non-parallel group at an intersection point
    if(!intersectingGroup and !intersectingLegs) then
      !iPosition      = !pLine.intersection(!nLine)
      !gPosition      = !aLine.intersection(!lLine)

    -- Non-parallel group and non-parallel legs
    else

      -- Intersection points
      !pIntersect     = !pLine.intersection(!nLine)
      !nIntersect     = !nLine.intersection(!pLine)
      !aIntersect     = !aLine.intersection(!lLine)
      !lIntersect     = !lLine.intersection(!aLine)

      -- If the component is aligned, but not at the intersection
      -- point, we will move the component along the aligned leg
      if(!aAligned) then
        if(!aIntersect.near(!pIntersect, !this.distanceTolerance).not()) then
          !iPosition  = !pIntersect
          !gPosition  = !aIntersect
        else
          !iPosition  = !nIntersect
          !gPosition  = !lIntersect
        endif
      elseif (!lAligned) then
        if(!lIntersect.near(!nIntersect, !this.distanceTolerance).not()) then
          !iPosition  = !nIntersect
          !gPosition  = !lIntersect
        else
          !iPosition  = !pIntersect
          !gPosition  = !aIntersect
        endif

      -- If we are aligned, then flip between the previous/next vectors
      else

        -- Offset of intersection from previous/next legs
        !pOffset      = !pLine.distance(!aIntersect)
        !nOffset      = !nLine.distance(!lIntersect)

        if(!pOffset le !nOffset) then
          !iPosition  = !pIntersect
          !gPosition  = !aIntersect
        else
          !iPosition  = !nIntersect
          !gPosition  = !lIntersect
        endif

      endif

    endif

  -- Non-parallel group and parallel legs
  elseif (!parallelGroup.not() and !parallelLegs) then

    -- Intersection points
    !aIntersect       = !aLine.intersection(!lLine)
    !lIntersect       = !lLine.intersection(!aLine)

    -- Offset of intersection from previous/next legs
    !pOffset          = !pLine.distance(!aIntersect)
    !nOffset          = !nLine.distance(!lIntersect)

    -- Offset is closer to previous line
    if(!pOffset le !nOffset) then

      -- Offset is greater than align distance tolerance
      if(!pOffset le !this.distanceTolerance) then
        !iPosition    = !nLine.near(!lIntersect)
        !gPosition    = !lIntersect
      else
        !iPosition    = !pLine.near(!aIntersect)
        !gPosition    = !aIntersect
      endif

    -- Offset if closer to next line
    else

      -- Offset is greater than align distance tolerance
      if(!nOffset le !this.distanceTolerance) then
        !iPosition    = !pLine.near(!aIntersect)
        !gPosition    = !aIntersect
      else
        !iPosition    = !nLine.near(!lIntersect)
        !gPosition    = !lIntersect
      endif

    endif

  -- Parallel group and non-parallel legs
  elseif (!parallelGroup and !parallelLegs.not()) then

    -- Intersection points
    !pIntersect       = !pLine.intersection(!nLine)
    !nIntersect       = !nLine.intersection(!pLine)

    -- If arrive of the group is aligned with the previous line
    if(!aAligned or (!aAngle le !this.angleTolerance and !aOffset le !this.distanceTolerance)) then
      !iPosition      = !lLine.intersection(!nLine)
      !gPosition      = !lPosition

    -- If leave is of group is aligned with the next line
    elseif (!lAligned or (!lAngle le !this.angleTolerance and !lOffset le !this.distanceTolerance)) then
      !iPosition      = !aLine.intersection(!pLine)
      !gPosition      = !aPosition

    -- Non-aligned arrive/leave
    else

      -- Determine the most appropriate alignment
      if(!aAngle le !this.angleTolerance or !aAngle le !lAngle) then
        !iPosition    = !pLine.near(!aPosition)
        !gPosition    = !aPosition
      elseif (!lAngle le !this.angleTolerance or !aAngle gt !lAngle) then
        !iPosition    = !nLine.near(!lPosition)
        !gPosition    = !lPosition
      endif

    endif

  -- Parallel group and parallel legs
  elseif (!parallelGroup and !parallelLegs) then

    -- Concentric legs and group
    if(!this.lineSegmentConcentric and !this.groupConcentric) then
      if(!anyAligned.not()) then
        !gPosition    = !first.position.wrt(World)
        !iPosition    = !pLine.near(!gPosition)
      else
        return true
      endif

    -- Either the legs or component group or both are eccentric
    else
      !maOffset       = !pLine.distance(!aPosition)
      !mlOffset       = !nLine.distance(!lPosition)

      -- Use shortest distance
      if(!lAligned or (!maOffset le !mlOffset and !aAligned.not())) then
        !gPosition    = !aPosition
        !iPosition    = !pLine.near(!aPosition)
      else
        !gPosition    = !lPosition
        !iPosition    = !nLine.near(!lPosition)
      endif

    endif

  -- End of determining alignment
  endif

  -- Move component
  if(defined(!iPosition)) then

    -- Component already aligned
    if(!iPosition.near(!gPosition, !this.distanceTolerance)) then
      return true
    endif

    !result           = true

    -- Difference between intersection and group position
    !iPosition        = !iPosition.wrt(World )
    !gPosition        = !gPosition.wrt(World )
    !offset           = !iPosition
    !offset.east      = !iPosition.east  - !gPosition.east
    !offset.north     = !iPosition.north - !gPosition.north
    !offset.up        = !iPosition.up    - !gPosition.up

    -- Only move if the position and component are different
    if(!offset.near(N0, !this.distanceTolerance).not()) then
      !undo = object UNDOABLE()
      !undo.description('Align component')
      !undo.add()

      !reference      = !!ce
      do !i indices !this.componentGroup
        !!ce          = !this.componentGroup[!i]
        BY $!<offset>
      enddo
      !!ce            = !reference

      -- End undo
      !undo.endUndoable()

    endif

  endif

  -- Return
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directComponent
--
-- Description: Direct a single component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to direct
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directComponent(!component is DBREF) is BOOLEAN
  return !this.directComponent(!component, true)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directComponent
--
-- Description: Direct a single component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to direct
--    2   R      BOOLEAN     Mark database
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directComponent(!component is DBREF, !mark is BOOLEAN) is BOOLEAN

  -- Initialise Variables

  -- Special case of directing components at either end of implied tube,
  -- must be done before the other tests
  if(!component.type eq 'TUBI') then
    return !this.directTubing(!component)
  endif

  -- Check we have access to modify component
  if(!!dbrefUpdatable(!component).not()) then
    return false
  endif

  -- Check component is a piping component
  !pcomponent       = object PIPINGCOMPONENT(!component)

  -- If there is no component, then we can't process direct anything.
  if(!pcomponent.unset()) then
    !!error.text    = 'Invalid component.'
    return false
  endif

  -- Initialise Variables
  var !mode MODE
  !reference        = !!ce

  -- Check alignment of component
  !arriveAligned    = !component.aQAngle.leq(!this.angleTolerance) and !component.aQOffset.leq(!this.distanceTolerance)
  !leaveAligned     = !component.lQAngle.leq(!this.angleTolerance) and !component.lQOffset.leq(!this.distanceTolerance)

  -- Re-alignment required - one or both arrive/leave directions are miss-aligned
  if(!arriveAligned.not() or !leaveAligned.not()) then

    -- Check if component is variable angle
    !variableAngle  = !pcomponent.isVariableAngle()

    -- Check if component has an angle range
    !range          = !pcomponent.range('ANGL')

    -- If variable angle component and the spec has a restricted range, check that the angle
    -- is within the range
    if(!variableAngle and !range.set()) then

      -- Get angle of
      if(!component.sequence eq 1) then
        !fromPosition = !component.owner.hPosition.wrt(World)
      else
        !fromPosition = !component.owner.members[!component.sequence - 1].position.wrt(World)
      endif

      if(!component.sequence eq !component.owner.mcount) then
        !toPosition   = !component.owner.tPosition.wrt(World)
      else
        !toPosition   = !component.owner.members[!component.sequence + 1].position.wrt(World)
      endif

      !position       = !component.position.wrt(World)
      !angle          = !position.angle(!fromPosition, !toPosition)

      -- Set derived angle of elbow
      !elbowAngle     = (180 - !angle)

      -- Change angle
      if(!elbowAngle.between(!range[1] - !this.angleTolerance, !range[2] + !this.angleTolerance).not()) then
        if(!range[1] eq !range[2]) then
          !text       = 'Warning - ' & !component.flnn & ' has a fixed angle of ' & !range[1] & ' degrees. Derived bend angle is ' & !elbowAngle
        else
          !text       =  'Warning - ' & !component.flnn & ' can only be within the range of ' & !range[1] & ' to ' & !range[2] & ' degrees. Derived bend angle is ' & !elbowAngle
        endif

        -- Move to component (currently at ptaxi of ptset)
        !!ce          = !component

        !!error.text  = !text
        return false
      endif

    endif

    -- Move to component
    !!ce            = !component

    -- Mark database
    if(!mark) then
      !undo = object UNDOABLE()
      !undo.description('Direct component')
      !undo.add()
    endif

-- CW - Fix P-36777 --- connecting to ecc reducers --
       !previnvalid = false
       !nextinvalid = false
      !currentElement = !!ce
      if !!ce.order.eq(1) then
      	 -- we are at the first element
        if !mode.eq('Forwards') then
          !previnvalid = true
        else
        	!nextinvalid = true
        endif
      elseif !!ce.order.eq(!!ce.owner.members.size()) then
      	-- we are at the last member
      if !mode.eq('Forwards') then
          !nextinvalid = true
        else
        	!previnvalid = true
        endif
      endif

      !prevIsEccentric  = false
      !nextIsEccentric =  false

     if !previnvalid.not() then
       prev
       !prevComp = !!ce
        if !prevComp.type.eq('REDU') then
     	   !prevIsEccentric = !this.isEccentric(!prevComp)
        endif
     else
     	   !prevIsEccentric = false
     endif	

     !!ce = !currentElement
      if !nextinvalid.not() then
        nex
        !nextComp = !!ce
         if !nextComp.type.eq('REDU')  then
     	   !nextIsEccentric = !this.isEccentric(!nextComp)
     	  else   	
     	  	 !nextIsEccentric = false
       endif
      endif

      !!ce = !currentElement



    -- Direct to next
    if(!arriveAligned and !leaveAligned.not()) then
      FORWARDS
      if(!component.sequence lt !component.owner.mcount) then
        DIRECT TO NEXT
        handle ANY
          ORI AND DIRECT IS TO NEXT
          handle ANY
          endhandle
        endhandle
      else
        DIRECT TO PT
        handle ANY
          ORI AND DIRECT IS TO PT
          handle ANY
          endhandle
        endhandle
      endif

    -- Direct to previous
    elseif(!arriveAligned.not() and !leaveAligned) then
      BACKWARDS
      if(!component.sequence eq 1) then
        DIRECT TO PH
        handle ANY
          ORI AND DIRECT IS TO PH
          handle ANY
          endhandle
        endhandle
      else
        DIRECT TO  NEXT
        handle ANY
          ORI AND DIRECT IS TO NEXT
          handle ANY
          endhandle
        endhandle
      endif

    -- Bad alignment at both sides
    elseif(!arriveAligned.not() and !leaveAligned.not()) then
      FORWARDS
      if(!component.sequence eq !component.owner.mcount) then
        DIRECT TO PT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      else
        DIRECT TO NEXT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      endif
      BACKWARDS
      if(!component.sequence eq 1) then
        DIRECT TO PH
        handle ANY
          QUERY VAR !!error.text
        endhandle
      else
        DIRECT TO NEXT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      endif

    endif
    $!<mode>

--CW P-29623 - eccentric reducer check moved to after 'normal' component check
  if !prevIsEccentric.or(!nextIsEccentric) then
       	!this.alignToEccentric(!currentElement, true)
    endif



    -- End undo
    if(!mark) then
      !undo.endUndoable()
    endif

    -- Return to original element
    !!ce  = !reference

  -- End of re-alignment
  endif

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directTubing
--
-- Description: Direct components at end of piece of tubing (only if they
--              are angled)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to direct
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directTubing(!tubing is DBREF) is BOOLEAN
  return !this.directTubing(!tubing, true)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directTubing
--
-- Description: Direct components at end of piece of tubing (only if they
--              are angled)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component to direct
--    2   R      BOOLEAN     Mark database
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directTubing(!tubing is DBREF, !mark is BOOLEAN) is BOOLEAN

  -- Initialise Variables
  var !mode MODE
  !reference          = !!ce

  -- Check we have been passed to tubing
  if(!tubing.type ne 'TUBI') then
    !!error.text      = 'No tubing to process.'
    return false
  endif

  -- Get elements at end of tubing
  !fromElement        = !tubing.ref

  var !nextPP split NEXTPP of $!<fromElement>
  !toElement          = !nextPP[3].dbref()

  -- Check we have access to modify component
  !fromModify         = !!dbrefUpdatable(!fromElement)
  !fromError          = !!error.text
  !toModify           = !!dbrefUpdatable(!toElement)
  !toError            = !!error.text
  if(!fromModify.not() or !toModify.not()) then
    if(!fromModify.not()) then
      !!error.text    = !fromError
      if(!toModify.not()) then
        !!error.text  = !!error.text & ' & ' & !toError
      endif
    elseif (!toModify.not()) then
      !!error.text    = !toError
    endif
    return false
  endif

  -- Mark database
  if(!mark) then
    !undo = object UNDOABLE()
    !undo.description('Direct components at ends of tube')
    !undo.add()
  endif

  -- Direct from component to next one
  if(!fromElement.type ne 'BRAN') then
    !this.directComponent(!fromElement, false)
  endif

  -- Direct from component
  if(!toElement.type ne 'BRAN') then
    !this.directComponent(!toElement, false)
  endif

  -- Revert to original mode
  $!<mode>
  !!ce  = !reference

  -- Mark database
  if(!mark) then
    !undo.endUndoable()
  endif

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directComponents
--
-- Description: Direct the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Components to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directComponents(!components is ARRAY) is BOOLEAN
  return !this.directComponents(!components, true)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directComponents
--
-- Description: Direct the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Components to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directComponents(!components is ARRAY, !mark is BOOLEAN) is BOOLEAN

  -- Initialise Variables
  !this.components  = !components

  -- Derive Group information
  if(!this.componentGroup()) then

    -- Derive line segment information
    if(!this.lineSegment()) then

      -- Align component group
      return !this.directComponents()

    endif

  endif

  -- Return
  return false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      directComponents
--
-- Description: Direct the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .directComponents() is BOOLEAN

  -- Initialise Variables
  !!error.text = 'Incomplete.'
  return false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      fit2x45elbows
--
-- Description: Create 2 * 45 degree elbows in the passed implied tube
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle from vectors
--    2   R      REAL        Angle from finish vector
--    3   R      DBREF       Implied tube
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .fixedAngleLeg(!sAngle is REAL, !fAngle is REAL, !tube is DBREF) is BOOLEAN

  -- Check component is beneath a branch

  -- Implied tube
  if(!tube.type ne 'TUBI') then
    !!error.text  = 'Implied tube not passed.'
    return false
  endif

  -- Get component
  !component      = !tube.reference

  -- Start vector
  !start          = object POINTVECTOR(!component.lPosition, !component.ldirection)
  !startLine      = !start.line(2000mm)

  -- Finish vector
  var !nextPos NEXTPP POSITION of $!<component> wrt World
  var !nextDir NEXTPP DIRECTION of $!<component> wrt World
  !finish         = object POINTVECTOR(!nextPos.position(), !nextDir.direction())
  !finishLine     = !finish.line(2000mm)

  -- Intersection points
  !aPosition      = !startLine.intersection(!finishLine)
  !bPosition      = !finishLine.intersection(!startLine)
  !startLine.endPosition  = !aPosition
  !finishLine.endPosition = !bPosition
  !line                   = !aPosition.line(!bPosition)

  aid clear all 1
  aid clear all 2
  aid clear all 3
  !startLine.draw(1,1,1)
  !finishLine.draw(1,1,1)
  !line.draw(1,1,1)

  -- Arc axes
  !startDirection = !startLine.direction()
  !xDirection     = !line.direction().opposite()
  !zDirection     = !finishLine.direction().opposite()

  -- Define an arc
  !orientation    = object ORIENTATION('X is ' & !xDirection & ' and Z is ' & !zDirection)
  !arc            = object ARC(!bPosition, !orientation, -10, 90, !line.length(), true)
  !arc.draw(2,1,3)

  -- Point on finish line where angle acts through
  !distance       = !line.length() / tan(!fAngle)
  !conePoint      = !bPosition.offset(!zDirection, !distance)

  do !arcAngle from 0 to 90
    !arcPosition  = !arc.anglePosition(!arcAngle)
    !coneLine     = !arcPosition.direction(!conePoint)
    !startAngle   = !startDirection.angle(!coneLine)
    break if(!startAngle lt !sAngle)
  enddo

  !prevAngle      = !startAngle
  !rangeMinimum   = !arcAngle - 1
  !testAngle      = !rangeMinimum
  do
    break if(!testAngle gt !arcAngle)
    !arcPosition  = !arc.anglePosition(!testAngle)
    !coneLine     = !arcPosition.direction(!conePoint)
    !startAngle   = !startDirection.angle(!coneLine)
    if(!startAngle le !sAngle) then
      !coneEdge   = !arcPosition.line(!conePoint)
      !vector     = object POINTVECTOR(!arcPosition, !startDirection)
      !projLine   = !vector.line(500mm)
      !coneEdge.draw(3,2,5)
      !projLine.draw(3,2,5)
      break
    endif
    !testAngle    = !testAngle + 0.001
    !prevAngle    = !startAngle
  enddo

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copySelection
--
-- Description: Copy the passed components
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Components to align
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .copySelection(!selected is SELECTION) is BOOLEAN

  -- Determine if there is a valid selection or component
  !components       = !selected.getSelection()

  -- Initialise Variables
  !this.components  = !components

  -- Derive Group information
  if(!this.componentGroup()) then

    -- Copy component group
    return !this.copySelection()

  endif

  -- Return
  return false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copySelection
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .copySelection() is BOOLEAN

  -- Initialise Variables
  !result = true

  -- Define EDG packet
    -- Define Packet
  !packet = object EDGPACKET()
  !packet.pickPacket.picks[1]                 = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('Identify type in insert selection')
  !packet.pickPacket.picks[1].pick.input[3]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.input[5]   = 'TYPE of OWNER eq ''BRAN'''
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.action  = '!!' & !this.varID & '.copySelection(!this.return[1])'
  !packet.remove  = true
  !unusedReturn = !!edgCntrl.add(!packet)

  -- Return
  return !result

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      copySelection
--
-- Description: Instigate EDG for picking
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .copySelection(!data is  EDGPICKDATA)

  -- Initialise Variables
  !tubing         = object EDGTUBING()
  !position       = !tubing.exact(!data.item, !data.pickLine)
  !element        = !data.item

  -- Navigate to target item and create component
  !undo           = object UNDOABLE()
  !undo.description('Create selection copy')
  !undo.add()

  -- New components
  !components     = !this.componentGroup
  !newComponents  = ARRAY()
  !selection      = object SELECTION()
  !referencePoint = !components.first().position
  !refDistance    = !referencePoint.distance(!position)
  !refDirection   = !referencePoint.direction(!position)
  !!ce            = !element
  !last           = !!ce

  -- Get axis of component
  !angle          = !element.ldirection.angle(!components.first().ldirection)

  if(!angle.neq(0)) then

    -- Plane of rotation
    if(!angle.eq(180)) then
      !rotationLine = !element.ldirection.orthogonal(!data.pickLine.direction).opposite()
    else
      !rotationLine = !element.ldirection.orthogonal(!components.first().ldirection).opposite()
    endif
  endif
  do !i indices !components
    !component    = !components[!i]
    !type         = !component.type
    !!ce          = !last
    NEW $!<type> copy $!<component>
    !newPosition  = !!ce.position.offset(!refDirection, !refDistance)
    !!ce.position = !newPosition
    !newComponents.append(!!ce)
    !selection.add(!!ce)
    !last         = !!ce

    -- Perform rotation
    if(!angle.neq(0)) then
      rotate by $!<angle> about $!<rotationLine> through  $!<position>
    endif
  enddo



  !selection.setCurrent()
  !undo.endUndoable()
endmethod
-- End of method definition


--  --------------------------------------------------------------------------
--
--  ---- Method: checkEccReducer
--
--  ---- Description: Check for ECC Reducers next to component to be orientated
--
--
--  --------------------------------------------------------------------------

define method .isEccentric(!redu is DBREF) is BOOLEAN
       !xPrev = object POINTVECTOR(!redu.ppos[2],!redu.pdir[1])
       !yPrev = !xPrev.towards(!redu.ppos[1])
       if  !xPrev.direction neq !yPrev.direction then
       	return true
       else
       	return false
       endif

endmethod

------------------------------------------------------------------------
--
-- Method: alignToEccentric
--
-- Description: Check for ECC Reducers next to component to be orientated
--
--
------------------------------------------------------------------------

define method .alignToEccentric(!component is DBREF, !mark is BOOLEAN) is BOOLEAN
  -- Initialise Variables

  -- Special case of directing components at either end of implied tube,
  -- must be done before the other tests
  if(!component.type eq 'TUBI') then
    return !this.directTubing(!component)
  endif

  -- Check we have access to modify component
  if(!!DBREFUpdatable(!component).not()) then
    return false
  endif

  -- Check component is a piping component
  !pcomponent       = object PIPINGCOMPONENT(!component)

  -- If there is no component, then we can't process direct anything.
  if(!pcomponent.unset()) then
    !!error.text    = 'Invalid component.'
    return false
  endif

  -- Initialise Variables
  var !mode MODE
  !reference        = !!ce

  -- Check alignment of component
  !arriveAligned    = !component.aQAngle.leq(!this.angleTolerance) and !component.aQOffset.leq(!this.distanceTolerance)
  !leaveAligned     = !component.lQAngle.leq(!this.angleTolerance) and !component.lQOffset.leq(!this.distanceTolerance)

  -- Re-alignment required - one or both arrive/leave directions are miss-aligned

  if(!arriveAligned.not() or !leaveAligned.not()) then

    -- Check if component is variable angle
    !variableAngle  = !pcomponent.isVariableAngle()

    -- Check if component has an angle range
    !range          = !pcomponent.range('ANGL')

    -- If variable angle component and the spec has a restricted range, check that the angle
    -- is within the range
    if(!variableAngle and !range.set()) then

      -- Get angle of
      if(!component.sequence eq 1) then
        !fromPosition = !component.owner.hPosition.wrt(World)
      else
        !fromPosition = !component.owner.members[!component.sequence - 1].position.wrt(World)
      endif

      if(!component.sequence eq !component.owner.mcount) then
        !toPosition   = !component.owner.tPosition.wrt(World)
      else
        !toPosition   = !component.owner.members[!component.sequence + 1].position.wrt(World)
      endif

      !position       = !component.position.wrt(World)
      !angle          = !position.angle(!fromPosition, !toPosition)

      -- Set derived angle of elbow
      !elbowAngle     = (180 - !angle)

      -- Change angle
      if(!elbowAngle.between(!range[1] - !this.angleTolerance, !range[2] + !this.angleTolerance).not()) then
        if(!range[1] eq !range[2]) then
          !text       = 'Warning - ' & !component.flnn & ' has a fixed angle of ' & !range[1] & ' degrees. Derived bend angle is ' & !elbowAngle
        else
          !text       =  'Warning - ' & !component.flnn & ' can only be within the range of ' & !range[1] & ' to ' & !range[2] & ' degrees. Derived bend angle is ' & !elbowAngle
        endif

        -- Move to component (currently at ptaxi of ptset)
        !!ce          = !component

        !!error.text  = !text
        return false
      endif

    endif

    -- Move to component
    !!ce            = !component

    -- Mark database
    if(!mark) then
      !undo = object UNDOABLE()
      !undo.description('Direct component')
      !undo.add()
    endif

    -- Direct to next
    if(!arriveAligned and !leaveAligned.not()) then
      FORWARDS
      if(!component.sequence lt !component.owner.mcount) then
        DIR TO PA OF NEXT
        handle ANY
          ORI AND DIRECT IS TO PA OF NEXT
          handle ANY
          endhandle
        endhandle
      else
        DIRECT TO PT
        handle ANY
          ORI AND DIRECT IS TO PT
          handle ANY
          endhandle
        endhandle
      endif

    -- Direct to previous
    elseif(!arriveAligned.not() and !leaveAligned) then
      BACKWARDS
      if(!component.sequence eq 1) then
        DIRECT TO PH
        handle ANY
          ORI AND DIRECT IS TO PH
          handle ANY
          endhandle
        endhandle
      else
        DIRECT TO PA OF NEXT
        handle ANY
          ORI AND DIRECT IS TO PA OF NEXT
          handle ANY
          endhandle
        endhandle
      endif

    -- Bad alignment at both sides
    elseif(!arriveAligned.not() and !leaveAligned.not()) then
      FORWARDS
      if(!component.sequence eq !component.owner.mcount) then
        DIRECT TO PT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      else
        DIRECT TO PA OF NEXT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      endif
      BACKWARDS
      if(!component.sequence eq 1) then
        DIRECT TO PH
        handle ANY
          QUERY VAR !!error.text
        endhandle
      else
        DIRECT TO PA OF NEXT
        handle ANY
          QUERY VAR !!error.text
        endhandle
      endif

    endif
   $!<mode>

   -- End undo
   if(!mark) then
     !undo.endUndoable()
   endif

   -- Return to original element
   !!ce  = !reference

 -- End of re-alignment
 endif

  --Return

return true

-- End of method definition

endmethod
