-- Created:         14/08/2006 10:25
--
--
-- Description:
--    assembly object for handling piping assemblies in branches
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  build()                          -
--  findpipe(DBREF)                  PIPEASSEMBLY
--  getarealist(GADGET)              -
--  getareamembers(DBREF,GADGET)     -
--  getassemblies(DBREF,GADGET)      -
--  pipingassemblymgr(BOOLEAN)       -
--
define object PIPINGASSEMBLYMGR

   member .assemblies     is ARRAY
   member .arealist       is ARRAY

endobject
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .pipingassemblymgr(!build is BOOLEAN)

  !save = !!ce
  !this.build()
  !!ce = !save


endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
define method .build()

!this.assemblies = ARRAY()

  -- collect all of the piping assemblies and make a set of objects
  var !assemblies collect all APPLDA with purp eq 'PASY'
  -- a piping assembly can never be more that a single pipe so this represents the whole list
  do !a values !assemblies
     !this.assemblies.append(object PIPEASSEMBLY(!a.dbref() ))
     !this.arealist.append(!a.dbref().owner)
  enddo

  !this.arealist.unique()

endmethod
------------------------------------------------------------------------



------------------------------------------------------------------------
define method .getarealist(!list is GADGET)

!dtext = ARRAY()
!rtext = ARRAY()

  do !a index !this.arealist
    !dtext.append(!this.arealist[!a].description)
    !rtext.append(!this.arealist[!a].refno.string())
  enddo

 !list.dtext = !dtext
 !list.rtext = !rtext

endmethod

------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getareamembers(!area is DBREF, !list is GADGET)

 !dtext = ARRAY()
 !rtext = ARRAY()

  do !a index !this.assemblies
    if !this.assemblies[!a].appldata.owner.eq(!area) then
      !dtext.append(!this.assemblies[!a].description)
      !rtext.append(!this.assemblies[!a].appldata.refno.string())
    endif
  enddo


 !list.dtext = !dtext
 !list.rtext = !rtext

endmethod
------------------------------------------------------------------------

define method .getassemblies(!owner is DBREF, !list is GADGET)

!dtext = ARRAY()
!rtext = ARRAY()

do !a index !this.assemblies
  !dtext.append(!this.assemblies[!a].description)
  !rtext.append(!this.assemblies[!a].pipe.string())
enddo

endmethod



------------------------------------------------------------------------
define method .findpipe(!pipe is DBREF)is PIPEASSEMBLY

   !return = object PIPEASSEMBLY()
   do !a values !this.assemblies
      if !a.appldata.eq(!pipe) then
        return !a
      endif
   enddo

  return !return

endmethod
------------------------------------------------------------------------
