--
--
--
-- Description:
--    General object for handling common piping actions not specific
--    to any one particular form or utility
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  component()                      DBREF               Returns current component
--  isVariableAngle()                BOOLEAN             Tests if component is a variable angle
--  isVariableRadius()               BOOLEAN             Tests if component is a variable radius
--  pipingComponent(DBREF)           -                   Constructor
--  pointDefinitions(ARRAY)          ARRAY               Tests if component is a variable angle
--  range(STRING)                    ARRAY               Returns range (max min) for spec question
--

define object PIPINGCOMPONENT

  -- Component
  member .component     is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipingComponent
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipingComponent(!component is DBREF)

  -- Check component is a piping component
  if(!component.owner.hardType eq 'BRAN' or !component.hardType eq 'SPCO') then
    if(!component.spref.set()) then
      !this.component = !component
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      component
--
-- Description: Returns current component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Current component
--
------------------------------------------------------------------------

define method .component() is DBREF
  return !this.component
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      range
--
-- Description: Returns range (max min) for spec question
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Current component
--
------------------------------------------------------------------------

define method .range(!passedQuestion is STRING) is ARRAY

  -- Initialise Variables
  !question = !passedQuestion.upcase()
  !spref    = !this.component.spref
  !range    = ARRAY()

  -- If there is no spec ref, return
  if(!spref.unset()) then
    return !range
  endif

  -- Check if component has the passed question
  var !choice SPLIT CHOICE WITH $!<this.component.spref>
  !index    = !choice.findFirst(!question)
  if(!index.unset()) then
    return !range
  endif

  -- Get max min for component
  !index    = (!index + 1) / 2
  !indices  = !choice.size() / 2
  !qIndex   = !indices - !index + 1
  !owners   = !spref.ownLst
  !owners.append(!this.component.spref)
  !owners.invert()

  !range[1] = !owners[!qIndex].answer
  !range[2] = !owners[!qIndex].maxAnswer

  -- Return
  return !range

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isVariableAngle
--
-- Description: Tests if component is a variable angle
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component reference
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if variable angle
--
------------------------------------------------------------------------

define method .isVariableAngle() is BOOLEAN

  -- Initialise Variables
  !variableAngle    = false
  !points           = ARRAY()
  !pointPoints      = !this.component.ptref.members

  -- Get Arrive/Leave ppoints
  if(!this.component.type eq 'SPCO') then
    !points.append(1)
    !points.append(2)
  else
    !points.append(!this.component.arrive)
    !points.append(!this.component.leave)
  endif

  -- Get Ppoints for component
  !definitions      = !this.pointDefinitions(!points)

  -- Check definitions have a parametric definition for angle
  do !i indices !definitions

    -- Check PAXIS of PTAX/PTMI
    if(!definitions[!i].type inset('PTAX','PTMI')) then
      var !expression PAXIS of $!<definitions[$!<i>]>
    elseif (!definitions[!i].type eq 'PTCA') then
      var !expression PTCDIR of $!<definitions[$!<i>]>
    else
      !expression   = ''
    endif

    -- Check if expression has any parameterisation
    !expression     = !expression.upcase()
    !variableAngle  = !expression.matchWild('*ANGL*') or !expression.matchWild('*DESP*') or !expression.matchWild('*PROP*')
    break if(!variableAngle)

  enddo

  -- Return
  return !variableAngle

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isVariableRadius
--
-- Description: Tests if component is a variable radius
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component reference
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if variable angle
--
------------------------------------------------------------------------

define method .isVariableRadius() is BOOLEAN

  -- Initialise Variables
  !variableRadius   = false
  !points           = ARRAY()
  !pointPoints      = !this.component.ptref.members

  -- Get Arrive/Leave ppoints
  if(!this.component.type eq 'SPCO') then
    !points.append(1)
    !points.append(2)
  else
    !points.append(!this.component.arrive)
    !points.append(!this.component.leave)
  endif

  -- Get Ppoints for component
  !definitions      = !this.pointDefinitions(!points)

  -- Check definitions have a parametric definition for angle
  do !i indices !definitions

    -- Check PAXIS of PTAX/PTMI
    if(!definitions[!i].type eq 'PTAX') then
      var !expression PDIST of $!<definitions[$!<i>]>
    elseif (!definitions[!i].type  inset('PTCA','PTMI')) then
      var !expX       PX of $!<definitions[$!<i>]>
      var !expY       PY of $!<definitions[$!<i>]>
      var !expZ       PZ of $!<definitions[$!<i>]>
      !expression   = !expX & !expY & !expZ
    else
      !expression   = ''
    endif

    -- Check if expression has any parameterisation
    !expression     = !expression.upcase()
    !variableRadius  = !expression.matchWild('*RAD*') or !expression.matchWild('*DESP*') or !expression.matchWild('*PROP*')
    break if(!variableRadius)

  enddo

  -- Return
  return !variableRadius

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pointDefinitions
--
-- Description: Tests if component is a variable angle
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of pPoints to return
-- Return:
--   [Data Type] [Description]
--    ARRAY       Point definitions (Array of DBREF, matching passed array)
--
------------------------------------------------------------------------

define method .pointDefinitions(!points is ARRAY) is ARRAY

  -- Initialise Variables
  !definitions        = ARRAY()
  !pointPoints        = !this.component.ptref.members

  -- Get All Ppoint definitions
  !table              = object TABLE()
  !table.primaryKey(!pointPoints)
  !columns[1]         = object COLUMN(object EXPRESSION('NUMB'), true, true, 'Number')
  !table.columns(!columns)
  !table.evaluate()

  -- Ppoint Definitions
  !pPoints            = !table.primaryKey()

  -- Get pPoint definitions for Arrive/Leave
  do !i indices !points
    !index            = !table.column(1).findFirst(!points[!i])
    !definitions[!i]  = !pPoints[!index]
  enddo

  -- Return
  return !definitions

endmethod
-- End of method definition
