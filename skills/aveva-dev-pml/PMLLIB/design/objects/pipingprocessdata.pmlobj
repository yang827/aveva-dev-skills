--
-- File:            pipingprocessdata.pmlobj
--   Type:          Object Definition
--   Group:         Specification
--     Keyword:     Component Information Branch
--   Module:        Design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Tue July 13 12:00:00 GMT 2004
--
--
-- Description:
--    basic piping process data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bore(STRING)                     -                   Assign bore
--  element(DBREF)                   -                   Assign element, but not the data
--  insulation(STRING)               -                   Assign insulation specification
--  pipingProcessData(DBREF)         -                   Constructor
--  pressure(REAL)                   -                   Assign pressure
--  sloRef(DBREF)                    -
--  specification(STRING)            -                   Assign specification
--  systemReference(STRING)          -                   Assign bore
--  temperature(REAL)                -                   Assign temperature
--  tracing(STRING)                  -                   Assign tracing specification
--  updateElement()                  -                   Update element with data
--
------------------------------------------------------------------------

define object PIPINGPROCESSDATA

  -- Element
  member .element         is DBREF

  -- Specification
  member .specification   is DBREF

  -- Insulation Specification
  member .insulation      is DBREF

  -- Tracing Specification
  member .tracing         is DBREF

  -- Bore
  member .bore            is BORE

  -- System Reference
  member .systemReference is DBREF

  -- Temperature
  member .temperature     is REAL

  -- Pressure
  member .pressure        is REAL

  -- slope reference
  member .sloRef         is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pipingProcessData
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get data from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pipingProcessData(!element is DBREF)

  -- Initialise Variables
  !this.element         = !element
  !this.specification   = !element.pspec
  !this.insulation      = !element.ispec
  !this.tracing         = !element.tspec
  if(!element.type eq 'PIPE') then
    !this.bore          = !element.bore
  endif
  !this.temperature     = !element.temperature
  !this.pressure        = !element.pressure
  !this.sloRef          = !element.sloRef

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      element
--
-- Description: Assign element, but not the data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .element(!element is DBREF)
  !this.element = !element
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      specification
--
-- Description: Assign specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Specification as a string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specification(!specification is STRING)

  -- Unset specification
  if(!specification.unset()) then
    !this.specification = object DBREF()
  else
    !specReference      = !specification.dbref()
    handle ANY
      return
    endhandle
    !this.specification = !specReference
  endif

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      insulation
--
-- Description: Assign insulation specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Insulation specification as a string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insulation(!insulation is STRING)

  -- Unset specification
  if(!insulation.unset()) then
    !this.insulation  = object DBREF()
  else
    !specReference    = !insulation.dbref()
    handle ANY
      return
    endhandle
    !this.insulation  = !specReference
  endif

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      tracing
--
-- Description: Assign tracing specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tracing specification as a string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tracing(!tracing is STRING)

  -- Unset specification
  if(!tracing.unset()) then
    !this.tracing   = object DBREF()
  else
    !specReference  = !tracing.dbref()
    handle ANY
      return
    endhandle
      !this.tracing = !specReference
  endif

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      bore
--
-- Description: Assign bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Bore as a STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bore(!bore is STRING)

  -- Initialise Variables
  !this.bore = !bore.bore()
  handle ANY
    -- Non standard bore?
    !this.bore = !bore.real().bore()
    handle ANY
    endhandle
  endhandle

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      systemReference
--
-- Description: Assign bore
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      systemReference as a STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemReference(!systemReference is STRING)

  -- Unset system reference
  if(!systemReference.unset() or !systemReference.eq('Nulref')) then
    !this.systemReference   = object DBREF()
  else
    !specReference  = !systemReference.dbref()
    handle ANY
      return
    endhandle
      !this.systemReference = !specReference
  endif

endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      temperature
--
-- Description: Assign temperature
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Temperature
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .temperature(!temperature is REAL)
  !this.temperature = !temperature
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pressure
--
-- Description: Assign pressure
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Pressure
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pressure(!pressure is REAL)
  !this.pressure = !pressure
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      sloRef
--
-- Description: Assign pressure
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Pressure
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sloRef(!sloRef is DBREF )
  !this.sloRef = !sloRef
endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      updateElement
--
-- Description: Update element with data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

  -- Initialise Variables
  !reference    = !!ce
  !!ce          = !this.element

  -- Pipe Specification
  if(!this.specification ne !this.element.pspec) then
    if(!this.specification.unset()) then
      !specString = 'nulref'
    else
      !specString = !this.specification.string()
    endif
    PSPEC $!<specString>

    -- If element is a branch, then re-select head tube
    if(!this.element.type eq 'BRAN') then
      SELECT HSTU
      handle ANY
      endhandle
    endif

  endif

  -- Insulation Specification
  if(!this.insulation ne !this.element.ispec) then
    if(!this.insulation.unset()) then
      !specString = 'nulref'
    else
      !specString = !this.insulation.string()
    endif

    -- Get all items beneath element with same ISPEC and change it
    -- to the new value
    if(!this.element.ispec.unset()) then
      var !components collect all with (unset(ISPEC)) for $!<this.element>
    else
      !prevIspec  = !this.element.ispec
      var !components collect all with (ISPEC eq $!<prevIspec> ) for $!<this.element>
    endif

    -- Loop through the elements and change their insulation spec
    do !i indices !components
      !!ce = !components[!i].dbref()
      ISPEC $!<specString>
      handle ANY
      endhandle
    enddo
		
		!!ce = !this.element
		
  endif

  -- Tracing Specification
  if(!this.tracing ne !this.element.tspec) then
    if(!this.tracing.unset()) then
      !specString = 'nulref'
    else
      !specString = !this.tracing.string()
    endif

    -- Get all items beneath element with same ISPEC and change it
    -- to the new value
    if(!this.element.tspec.unset()) then
      var !components collect all with (unset(TSPEC)) for $!<this.element>
    else
      -- P10178 ispec changed to tspec to set it properly
      !prevTspec  = !this.element.tspec
      var !components collect all with (TSPEC eq $!<prevTspec> ) for $!<this.element>
    endif

    -- Loop through the elements and change their insulation spec
    do !i indices !components
      !!ce = !components[!i].dbref()
      TSPEC $!<specString>
      handle ANY
      endhandle
    enddo

		!!ce = !this.element

  endif

  -- Bore
  if(!this.element.type eq 'PIPE') then
    -- Only update if there is a difference
    if(!this.bore ne !this.element.bore) then
      if(!this.bore.unset()) then
        !boreString = '0'
      else
        !boreString = !this.bore.string()
      endif
      BORE $!<boreString>
    endif
  endif

  -- System Reference
  if(!this.element.type eq 'PIPE') then
    -- Only update if there is a difference
    if(not !this.systemReference.unset()) then
      !this.element.mdsysf[1] = !this.systemReference
      handle ANY
        !errors.append('Mdsysf  + $!!error.text')
      endhandle
    else
      Mdsysf Unset
      handle ANY
        !errors.append('Mdsysf  + $!!error.text')
      endhandle

    endif
  endif

  -- Temperature
  if(!this.temperature ne !this.element.temperature) then
    if(!this.temperature.unset()) then
      !this.element.temperature = -10000degC
    else
      !this.element.temperature = !this.temperature
    endif
  endif

  -- Pressure
  if(!this.pressure ne !this.element.pressure) then
    if(!this.pressure.unset()) then
      !this.element.pressure  = 0pascal
    else
      !this.element.pressure  = !this.pressure
    endif
  endif

  -- Slope Reference

  if(!this.sloRef ne !this.element.sloRef) then
    if(!this.sloRef.unset()) then
      !!ce = !this.element
      sloRef NULREF
    else
      !this.element.sloRef = !this.sloRef
    endif
  endif

  -- Return to reference
  !!ce  = !reference

endmethod
-- End of object definition
