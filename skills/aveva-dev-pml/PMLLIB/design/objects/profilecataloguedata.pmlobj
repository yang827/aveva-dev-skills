--     Keyword:     Profile catalogue data
--   Module:        design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Mon Sept 3 10:00:00 BST 2007
--
--
-- Description:
--   Object for holding catalogue information of a profile
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catalogueReference(DBREF)        -                   Sets catalogue reference
--  profileCatalogueData(DBREF)      -
--

define object PROFILECATALOGUEDATA

  -- Catalogue Reference
  member .catalogueReference    is DBREF

  -- Owning Gtype element
  member .gTypeOwner            is DBREF

  -- Generic Type
  member .genericType           is STRING

  -- Justification Line
  member .justificationLine     is STRING

  -- Member Line
  member .memberLine            is STRING

  -- Joint Line
  member .jointLine             is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      profilecataloguedata
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileCatalogueData(!element is DBREF)

  -- Initialise Variables
  -- If design element passed, then extract design info from the element
  if(!element.dbType.eq('DESI')) then
    !this.catalogueReference(!element.spref)
    !this.justificationLine = !element.jusl
    !this.memberLine        = !element.memLine
    !this.jointLine         = !element.jline
    handle ANY
      !this.jointLine       = !element.jlnStart
    endhandle

  elseif (!element.type.eq('SPCO')) then
    !this.catalogueReference(!element)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      catalogueReference
--
-- Description: Sets catalogue reference
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .catalogueReference(!reference is DBREF)

  -- Assuming SPCO is passed
  !this.catalogueReference  = !reference

  -- Assuming GTYP has been set somewhere in the path
  !this.genericType         = !this.catalogueReference.icoTyp

  -- Might need something that finds the right owning SELE with correct question/answer
  !this.gTypeOwner          = !reference.owner

endmethod
-- End of method definition
