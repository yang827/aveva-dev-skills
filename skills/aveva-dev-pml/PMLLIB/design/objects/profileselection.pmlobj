-- Created:         Mon Sept 3 10:00:00 BST 2007
--
--
-- Description:
--   Object for holding catalogue information of a profile
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  defaultPlines(ARRAY)             -                   Set default plines
--  profileData(PROFILECATALOGUEDATA) -
--  profileselection(STRING,STRING)  -                   Constructor
--  show()                           -                   Show selection form
--

define object PROFILESELECTION

  -- Title of selection form
  member .title           is STRING

  -- Action to be carried out on Apply
  member .action          is STRING

  -- Profile catalogue data
  member .profileData     is PROFILECATALOGUEDATA

  -- Default pline list for Jusline
  member .defaultPlines   is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      profileselection
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Title to be shown on form
--    2   R      STRING      Action to be carried out on "Apply"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileselection(!title is STRING, !action is STRING)
  !this.title   = !title
  !this.action  = !action
endmethod

------------------------------------------------------------------------
--
-- Method:      profileselection
--
-- Description: Set profile data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type]             [Description]
--    1   R      PROFILECATALOGUEDATA    Catalogue profile data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileData(!profileData is PROFILECATALOGUEDATA)
  !this.profileData = !profileData
endmethod

------------------------------------------------------------------------
--
-- Method:      defaultPlines
--
-- Description: Set default plines
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of default plines
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultPlines(!plines is ARRAY)
  !this.defaultPlines = !plines
endmethod

------------------------------------------------------------------------
--
-- Method:      show
--
-- Description: Show selection form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .show()

  -- Load section profile selection form if required
  if(undefined(!!sectionProfileSelection)) then
    pml reload form !!sectionProfileSelection
  endif

  -- Load default plines
  !!sectionProfileSelection.defaultJusLine(!this.defaultPlines)

  -- Setup form
  !!sectionProfileSelection.setup(!this.title, !this.action, !this.profileData)

  -- Show form
  show !!sectionProfileSelection
  !!sectionProfileSelection.selectGtype()
  !!sectionProfileSelection.selectProfile()

endmethod
-- End of method definition
