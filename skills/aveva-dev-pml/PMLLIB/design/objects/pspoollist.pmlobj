--
-- Description:
--    core information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignAttributes(ANY)             -                   copy the planu psty and desc attributes
--  cleanup()                        -                   restore variables to default because the object persists
--  compareAll(REAL,REAL)            -
--  compareComponents(REAL,REAL)     BOOLEAN
--  compareEndComponents(REAL,REAL)  REAL                compare the end components with the passed spool.
--  compareEnds(REAL,REAL)           BOOLEAN             compare the spool ends with the passed spool.
--  compareNames(REAL,REAL)          BOOLEAN             compare the end components with the passed spool.
--  compareSpools(REAL)              -
--  compareStartComponents(REAL,REAL) REAL                compare the starting components with the passed spool.
--  compareVolume(REAL,REAL)         BOOLEAN             compare spool volumes.
--  getNewNames()                    ARRAY
--  getNewSpools()                   -
--  getNewspoolName(DBREF)           STRING
--  getSpools(DBREF)                 -
--  listSpools()                     -                   gets all the pipe spools in the current pipe and returns a set of objects
--  pspoolList()                     -                   Constructor
--  pspoolList(DBREF)                -                   Constructor
--  restoreSpoolNames()              -
--  unnamespools()                   -
--
------------------------------------------------------------------------
-- this object is used in two operations:
-- 1)Just before the auto process regenerates the pspools
--   this object saves the current state in a global variable
--
-- !!plist = object pspooLlist(pipename)
--
-- 2)After the regeneratespools object has completed the original object
--   is called again to compare and rename the regenerated spools
--
-- !!plist.compareSpools(1)
--
------------------------------------------------------------------------

define object PSPOOLLIST

    -- object members
  member .pipe            is DBREF
  member .pspoolList      is DBREF
  member .compareList     is ARRAY
  member .oldSpools       is ARRAY
  member .newSpools       is ARRAY
  member .oldNameList     is ARRAY
  member .newnamelist     is ARRAY
  member .option          is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pspoolList
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .pspoolList()

  IMPORT 'pipeCheckAddin'
  handle ANY
    -- !!alert.error('Failed to import pipeCheckAddin.dll')
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      pspoolList(pipe name)
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .pspoolList(!pipe is DBREF)

  !this.getSpools(!pipe)

endmethod

------------------------------------------------------------------------
--
-- Method:      cleanup
--
-- Description: restore variables to default because the object persists
--
------------------------------------------------------------------------
define method .cleanup()

  !this.pipe        = object DBREF()
  !this.pspoolList  = object DBREF()
  !this.oldNameList = ARRAY()
  !this.newnamelist = ARRAY()
  !this.compareList = ARRAY()
  !this.oldSpools   = ARRAY()
  !this.newnamelist = ARRAY()
  !this.newSpools   = ARRAY()
  !this.option      = REAL()

  endmethod

------------------------------------------------------------------------
--
-- Method:      getSpools(!pipe is DBREF)
--
-- Description: gets all the pipe spools in the current pipe and returns a set of objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpools(!pipe is DBREF)

  !this.cleanup()
  --$p 'getSpools in'
  !this.oldNameList.clear()
  !this.oldSpools.clear()

  if !pipe.type.neq('PIPE') then
    !!alert.error('Passed item is not a pipe')
    return
  endif
  !this.pipe = !pipe

  !this.pspoolList = PSLIST 1 of $!this.pipe
  handle ANY
    !!alert.error('Pipe does not contain any PSPOOLS')
    return
  endhandle

  do !a values !this.pspoolList.members

    !this.oldNameList.append(!a.name)
    !this.oldSpools.append(object COMPONENTPSPOOL(!a))

  enddo

  using namespace 'aveva.pdms.presentation.pipeCheckAddin'
  --this disables the first callback
  -- return
  -- $p 'Attempting to load object PIPECHECKPMCALLBACK'
  !!a = object PIPECHECKPMCALLBACK()
  handle ANY
    -- $p 'Failed to load object PIPECHECKPMCALLBACK'
    -- !!alert.error('Failed to load object PIPECHECKPMCALLBACK')
  endhandle
  -- $p 'calling PIPECHECKPMCALLBACK.handleOldSpoolNamesStored(!this.oldNameList)'
  !!a.handleOldSpoolNamesStored(!this.oldNameList)
  handle ANY
    -- $p 'Failed to call object PIPECHECKPMCALLBACK'
    --  !!alert.error('Failed to call object PIPECHECKPMCALLBACK')
  endhandle
  -- $p 'getSpools out'

endmethod


------------------------------------------------------------------------
--
-- Method:      getNewSpools()
--
-- Description: gets all the pipe spools in the current pipe and returns a set of objects
--
--
------------------------------------------------------------------------
define method .getNewSpools()

  -- $p 'getNewSpools 1'
  !this.newSpools.clear()
  !this.newnamelist.clear()
  -- $p 'getNewSpools 2'
  !this.pspoolList = PSLIST 1 of $!this.pipe
  -- $p 'getNewSpools 3'
  handle ANY
    !!alert.error('Pipe does not contain any PSPOOLS')
    return
  endhandle

  do !a values !this.pspoolList.members

    !this.newnamelist.append(!a.name)
    !this.newSpools.append(object COMPONENTPSPOOL(!a))

  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      compareSpools(!option is real)
--
-- Description: gets all the pipe spools in the current pipe and returns a set of objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--   !option     REAL        Determines how the spools are dealt with
--   1 means that existing spools are renamed where possible even if they have changed
--   2 means that existing spools and any with identical components are maintained even if the geometry has changed
--   3 means that all changed spools are given new names
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .compareSpools(!option is REAL)
  -- $p 'compareSpools in'


  !this.option = !option
  -- get a list of the new spools for comparison
  !this.getNewSpools()
  -- !this.listSpools()
  !this.compareList.clear()

  do !new index !this.newSpools
    !noMatchFound = TRUE
    do !orig index !this.oldSpools
      !this.compareAll(!new,!orig)
      handle ANY
      endhandle
      -- $p compare all returned $!this.newSpools[$!new].match
      if !this.newSpools[!new].match inset('FULL','START','END','COMPS') then
        !string = !this.oldSpools[!orig].spoolName & ',' & !this.newSpools[!new].spoolName & ',' & !this.newSpools[$!new].match
        !this.compareList.append(!string)
        -- we have found a suitable match
        -- $p $!string
        !noMatchFound = FALSE

        break
      endif
    enddo
    if (!noMatchFound eq TRUE) then
      !string = 'NONE,' & !this.newSpools[!new].spoolName & ',' & !this.newSpools[$!new].match
      !this.compareList.append(!string)
    endif

  enddo

  -- complete the re-naming ---------------------- this is my addition to complete the renaming process
  !this.restoreSpoolNames()

  -- call the constructor to clear everything out
  if undefined (!!spooldebug) then
    -- setting global variable !!spooldebug stops the global object !!spoolComparator from being cleaned out
    --!this.cleanup()
  endif


  -- the next line disables oggy's callback
  return
  using namespace 'aveva.pdms.presentation.pipeCheckAddin'

  -- $p 'calling PIPECHECKPMCALLBACK.handleSpoolComparisonTable(!this.compareList)'
  !!a.handleSpoolComparisonTable(!this.compareList)
  handle ANY
    !!alert.error('Failed to call object PIPECHECKPMCALLBACK 2')
  endhandle
  -- $p 'called PIPECHECKPMCALLBACK.handleSpoolComparisonTable(!this.compareList)'
  -- $p 'compareSpools out'

endmethod

-----------------------------------------------------------------------
--
-- Method:      listSpools()
--
-- Description: gets all the pipe spools in the current pipe and returns a set of objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listSpools()

  do !a index !this.oldSpools
    -- $p old spool $!a is $!this.oldSpools[$!a].component
  enddo

  do !a index !this.newSpools
    -- $p new spool $!a is $!this.newSpools[$!a].component
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      compareSpools
--
-- Description: runs tests to check if a spool is the same as the passed spool
-- if it is the same
--
--
--
------------------------------------------------------------------------
define method .compareAll(!new is REAL, !orig is REAL)

  !this.newSpools[!new].match = 'NONE'

  if !this.compareComponents(!new,!orig) then
    !this.newSpools[!new].match = 'FULL'

    if  !this.compareVolume(!new,!orig).not() then
      -- if something has changed position the volume will have changed but the list should still be the same
      !this.newSpools[!new].match = 'COMPS'
    endif
    !this.newSpools[!new].newspoolName = !this.oldSpools[!orig].spoolName
    return
  endif

  if !this.compareStartComponents(!new,!orig).gt(0) then
    !this.newSpools[!new].match = 'START'
    --!this.newSpools[!new].newspoolName = !this.oldSpools[!orig].spoolName
    return
  endif

  if !this.compareEndComponents(!new,!orig).gt(0) then
    !this.newSpools[!new].match = 'END'
    -- uncomment these lines if we want old modified spools to inherit the old name
    --!this.newSpools[!new].newspoolName = !this.oldSpools[!orig].spoolName
    return
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      compareComponents
--
-- Description: test to see if all the components are the same
--
--
--
------------------------------------------------------------------------
define method .compareComponents(!new is REAL, !orig is REAL) is BOOLEAN

  -- for some reason the production checks utility can get a different order when it regenerates a pspool
  -- so we need to sort the array
  !this.newSpools[!new].componentList.sort()
  !this.oldSpools[!orig].componentList.sort()
  if !this.newSpools[!new].componentList.eq(!this.oldSpools[!orig].componentList) then
    return TRUE
  else
    return FALSE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      compareStartComponents
--
-- Description: compare the starting components with the passed spool.
--
--
------------------------------------------------------------------------
define method .compareStartComponents(!new is REAL, !orig is REAL) is REAL

  if !this.newSpools[!new].PSARFA.eq(!this.oldSpools[!orig].PSARFA) then
     return 1
  else
     return 0
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      compareEndComponents
--
-- Description: compare the end components with the passed spool.
--
--
------------------------------------------------------------------------
define method .compareEndComponents(!new is REAL, !orig is REAL) is REAL

  if !this.newSpools[!new].PSLRFA.eq(!this.oldSpools[!orig].PSLRFA) then
     return 1
  else
     return 0
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      compareEnds
--
-- Description: compare the spool ends with the passed spool.
--
--
------------------------------------------------------------------------
define method .compareEnds(!new is REAL, !orig is REAL) is BOOLEAN

  if !this.newSpools[!new].startpoints.eq(!this.oldSpools[!orig].startpoints).and(!this.newSpools[!new].endpoints.eq(!this.oldSpools[!orig].endpoints)) then
    return TRUE
  else
    return FALSE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      compareVolume
--
-- Description: compare spool volumes.
--
--
------------------------------------------------------------------------
define method .compareVolume(!new is REAL, !orig is REAL) is BOOLEAN

  if !this.newSpools[!new].volume.eq(!this.oldSpools[!orig].volume) then
    return TRUE
  else
    return FALSE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      compareNames
--
-- Description: compare the end components with the passed spool.
--
--
------------------------------------------------------------------------
define method .compareNames(!new is REAL, !orig is REAL) is BOOLEAN

  if !this.newSpools[!new].spoolName.eq(!this.oldSpools[!orig].spoolName) then
    return TRUE
  else
    return FALSE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      restorespoolNames
--
-- Description: loop through the new spools and if
--
--
------------------------------------------------------------------------
define method .restoreSpoolNames()


  -- if we have new spools to deal with they probably have new names which we want to use so first of all
  -- we want to isolate these so that we can use them in the new spools
  -- As a result of the compare process we should have a list of spools which are named and some which have a new name.
  -- now we need to get names for the rest.

  -- first remove all the spool names to avoid duplicates
  !this.unnamespools()

  -- loop through the new spools and reset their names
  do !a values !this.newSpools
    if !a.newspoolName.set() then
      -- check if this element is in old spools and copy its attributes
      !a.component.name = !a.newspoolName
      handle ANY
        --$p error in spool renaming
        !a.unsetAttributeValues()
      endhandle
      -- now go and reset their attributes
      !this.alignAttributes(!a)
    else
    -- this is a new spool so we need to unset its attributes
      !a.unsetAttributeValues()
    endif
    --- option for drawing aid text to show the changed names
    -- !a.drawNewVolume()

  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      .alignAttributes(!newSpool is COMPONENTSPOOL)
--
-- Description: copy the planu psty and desc attributes
--
--
------------------------------------------------------------------------
define method .alignAttributes(!newSpool is ANY)

  do !oldSpool values !this.oldSpools

    if !oldSpool.spoolName.eq(!newSpool.component.name) then
     --$p resetting attributes on $!newSpool.component.name using $!oldSpool.spoolName
       -- we have found the old spool so now we need to grab its attributes
       !oldSpool.reSetAttributeValues(!newSpool.component)
    endif
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      .unnamespool
--
-- Description: loop through the new spools un-name them
--
--
------------------------------------------------------------------------

define method .unnamespools()

  !current = !!ce

  do !a values !this.newSpools

    !!ce = !a.component
    unname

  enddo

  !!ce = !current

endmethod

------------------------------------------------------------------------
--
-- Method:      getNewspoolName
--
-- Description: call the autonaming routine to rename spools
--
--
------------------------------------------------------------------------
define method .getNewspoolName(!spool is DBREF ) is STRING

  !name = ''

  !name = '/' & !!namOpt.nameString(!spool, '', false, false)
  handle ANY
  endhandle

  return !name


endmethod

------------------------------------------------------------------------
--
-- Method:      getNewspoolName
--
-- Description: return the list of new spool names in this regeneration
--
--
------------------------------------------------------------------------

define method .getNewNames()is ARRAY

  !new = !this.newnamelist
  !old = !this.oldNameList
  !new.sort()
  !old.sort()
  if !new.size().lt(!old.size()) then
    return object ARRAY()
  endif

  return !new.difference(!old)


endmethod


-- End of object definition
