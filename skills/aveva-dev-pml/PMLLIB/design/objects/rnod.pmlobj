define object RNOD

  member .dbref           is DBREF
  member .description     is STRING
  member .position        is POSITION
  member .cablesRefs      is ARRAY
  member .attachmentRefs  is ARRAY
  member .name            is STRING
  member .function        is STRING
  member .purpose         is STRING
  member .assos           is ARRAY
  member .assElements     is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      Rnod
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rnod()


endmethod
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      Rnod
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Rnod elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rnod(!element is DBREF)

  -- Initialise Variables
  !this.rnod()

  !this.dbref          = !element
  !this.position       = !element.position.wrt( /* )
  handle any
  endhandle
  --!this.cablesRefs     = !element.
  --!this.attachmentRefs = !element.
  !this.name           = !element.name
  !this.description    = !element.description
  !this.function       = !element.function
  !this.purpose        = !element.purpose
  !this.assos          = !element.assos

  if !this.assos.size().gt(0) then
      -- Get Association Members
    !colAssmbr = object COLLECTION()
    !colAssmbr.type('ASSMBR')
    !colAssmbr.scope(!element.assos)
    !results = !colAssmbr.results()


    !evamemRefs = object BLOCK('!results[!evalIndex].amemrf')
    !amemRefs = !results.evaluate(!evamemRefs)

    !amemRefs.sortunique()
    !amemRefs.remove(!amemRefs.findFirst(!element))
    !this.assElements = !amemRefs
  else
    !this.assElements.empty()
  endif

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      Create
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Rnod elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create() is ARRAY

     !message = ARRAY()

     new RNODE
     handle any
       -- Define error message to be displayed
       !message[1] = 0
       !message[2] = !!error.text
     elsehandle NONE
       !this.dbref = !!ce
       !message[1] = 1
       !message[2] = ''
    endhandle

  return !message


endmethod
-- End of method definition


-- End of object definition


------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Rnod elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update() is ARRAY

  !message = ARRAY()
  !message[1] = 1

  if !this.name.neq('') and !this.name.unset().not() then
    !this.dbref.name          = !this.name
    handle ANY
      !message[1] = 0
      !error = !!error.text
      !message.append('Name, $!error')
    endhandle
  endif
  if !this.description.neq('') and !this.description.unset().not() then
    !this.dbref.description   = !this.description
    handle ANY
      !message[1] = 0
      !error = !!error.text
      !message.append('Description, $!error')
    endhandle
  endif
  if !this.function.neq('') and !this.function.unset().not() then
    !this.dbref.function      = !this.function
    handle ANY
      !message[1] = 0
      !error = !!error.text
      !message.append('Function, $!error')
    endhandle
  endif
  if !this.purpose.neq('') and !this.purpose.unset().not() then
    !this.dbref.purpose       = !this.purpose
    handle ANY
      !message[1] = 0
      !error = !!error.text
      !message.append('Purpose, $!error')
    endhandle
  endif

  !this.dbref.position = !this.position
  handle ANY
    !message[1] = 0
    !error = !!error.text
    !message.append('Position, $!error')
  endhandle


  return !message

endmethod
-- End of method definition
