--
-- Author:          P.Mooney
-- Created:         Mon Aug 11 17:16:34 BST 1997
--
--
-- Description:
-- Subobject of rptProperties. Basically an array will hold 1 or more of this
-- object to define each column
--
--   MEMBER  DESCRIPTION
--
--  .expr    The column expression e.g. 'name', 'pos in site'
--  .value   On, Off, 1st, Sub. See column layout
--  .sort    How to sort the column e.g. 'A to Z', '0 to 9'
--
------------------------------------------------------------------------

define object RPTCOLUMN

  member .expr   is STRING
  member .value  is STRING
  member .sort   is STRING

endobject
-- End of object definition for RPTCOLUMN
