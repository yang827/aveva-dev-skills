-- File:            rptproperties.pmlobj
--   Type:          Object Definition
--   Group:         Reports
--     Keyword:     RPT
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Aug 11 13:50:30 BST 1997
--
--
-- Description:
--
-- Holds the values needed to produce a report. Replaces many global variables.
-- Quick Reports & normal Reports both may use the same functions in the future.
-- This objects allows them to store different reports at the same time.
--
--   MEMBER     DESCRIPTION
--
--  .macName    Name of the Macro to be created
--  .filename   Name of the *report* to be created *by* the macro
--  .term       TRUE if output goes to command line
--  .types      bran mem, elbo etc...
--  .with       name eq 'PIPE1', hbore gt 50
--  .hierarchy  /PIPES, WORLD......
--  .columns    Details of the columns. An array holding expression
--              sort order etc (array of rptColumn objects)
--  .saveMac    TRUE if the macro is not to be deleted after it has run.
--
------------------------------------------------------------------------

define object RPTPROPERTIES

  member .macName   is STRING
  member .filename  is STRING
  member .term      is BOOLEAN
  member .types     is STRING
  member .with      is STRING
  member .hierarchy is STRING
  member .columns   is ARRAY
  member .saveMac   is BOOLEAN

endobject
-- End of object definition for RPTPROPERTIES
