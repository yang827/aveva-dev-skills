-- Define object
define object SCTNSPEC

     member .spec is DBREF
     member .gtyp is DBREF
     member .just is STRING
     member .meml is STRING
     member .jlin is STRING
     member .spre is DBREF
     member .desp is ARRAY

endobject
-- End of object definition for SCTNSPEC
