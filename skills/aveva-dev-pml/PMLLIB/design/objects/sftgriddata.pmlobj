--   Group:
--     Keyword:
--   Module:        design
--   Replaces:
--
-- Author:          Sun.You
-- Created:         Thu Aug 24 10:41:56 BST 2007
--
--
-- Description:
-- Getting each items data in order to show the grid control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getArea(STRING)                  REAL                In Branch member case, Getting Inside or Outside Area
--  getGroup()                       STRING              Getting the purpose of TABITEM
--  getPipeOrHvac(DBREF)             -                   Getting and Setting PIPE or HVAC element from parent of current element
--  getPunchCode()                   STRING              Getting Punch Code value
--  getSurface()                     STRING              Getting Surface Treatment Code Value
--  getSymbolCode()                  STRING              Getting Symbol Code value
--  getZone(DBREF)                   -                   Getting and Setting ZONE element from parent of current element
--  getZoneMem(DBREF)                ARRAY               Getting all zone members and Setting to Grid Array
--  setArray(STRING)                 ARRAY               Setting grid data value to Array
--  setBranData(DBREF)               ARRAY               In Branch member case, Setting grid data to array for populate in GRID
--  setBranch(DBREF)                 -                   Setting element to !this.branch
--  setEquiStruData(DBREF)           ARRAY               In EQUI or STRU case,Setting grid data to array for populate in GRID
--  setOwnerOFOwner(DBREF)           -                   Setting element to !this.ownerOfOwner
--  setPipeHvacBran(DBREF)           ARRAY               In PIPE,HVAC or BRAN case,Setting grid data to array for populate in GRID
--  setZone(DBREF)                   -                   Setting ZONE element to !this.zone member
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

define object SFTGRIDDATA

-- setting zone element
  member .zone          is DBREF

-- setting pipe,hvac,equi or stru element
  member .ownerOfOwner  is DBREF

-- setting bran element
  member .branch        is DBREF

-- setting bran member or equi or stru element
  member .item          is DBREF

-- setting purpose of tabitem element
  member .group         is STRING

-- setting inside or outside
  member .inout         is STRING

-- setting STINRF or STOURF attribute
  member .surface       is DBREF

-- setting STINCD OR STOUCD attribute
  member .symbolcd      is STRING

-- setting PUINCD OR PUOUCD attribute
  member .punchcd       is STRING

-- setting briare,breare OR desp[81],[82]
  member .area          is REAL

endobject
-- End of object definition for SFTGRIDDATA

------------------------------------------------------------------------
--
-- Method:      .getZone()
--
-- Description: Getting the ZONE element from parent of current element and setting to !this.zone
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getZone(!element is DBREF)
    !type = object ARRAY()
    !type[1] = 'ZONE'

    !this.zone = !!firstParent( !type, !element)

endmethod
-- End of method definition for .getZone()

------------------------------------------------------------------------
--
-- Method:      .setZone()
--
-- Description: Setting the ZONE element to !this.zone
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setZone(!element is DBREF)
    !this.zone = !element
endmethod
-- End of method definition for .setZone()

------------------------------------------------------------------------
--
-- Method:      .getPipeOrHvac()
--
-- Description: Getting PIPE or HVAC element from parent of current element and setting it to !this.ownerOfOwner
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPipeOrHvac(!element is DBREF)
    !type = object ARRAY()
    !type[1] = 'PIPE'
    !type[2] = 'HVAC'
    !this.ownerOfOwner = !!firstParent( !type, !element)

endmethod
-- End of method definition for .getPipeOrHvac()

------------------------------------------------------------------------
--
-- Method:      .setOwnerOFOwner()
--
-- Description: Setting element to !this.ownerOfOwner
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOwnerOFOwner(!element is DBREF)
    !this.ownerOfOwner = !element
endmethod
-- End of method definition for .setOwnerOFOwner()

------------------------------------------------------------------------
--
-- Method:      .setBranch()
--
-- Description: Setting element to !this.branch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBranch(!element is DBREF)
    !this.branch = !element
endmethod
-- End of method definition for .setBranch()

------------------------------------------------------------------------
--
-- Method:      .setBranData()
--
-- Description: In Branch member case, Setting grid data to array for populate in GRID
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBranData(!element is DBREF) is ARRAY

    -- collecting all branch members
    !memberList = !!collectAllFor('','',!element)

    !arrayData = object ARRAY()
    do !item values !memberList

       if (!item.type eq 'BRAN' ) then
            -- Current element is same as branch
            skip
       endif

       !this.item = !item

       -- inside surface treatment area calculation and setting
       !rtnarray = !this.setArray('IN')
       !arrayData.append(!rtnarray)

       -- outside surface treatment area calculation and setting
       !rtnarray = !this.setArray('OUT')
       !arrayData.append(!rtnarray)

    enddo
    return !arrayData

endmethod
-- End of method definition for .setBranData()

------------------------------------------------------------------------
--
-- Method:      .setArray()
--
-- Description: Setting grid data value to Array
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setArray(!inout is STRING) is ARRAY

   !rowData = object ARRAY()
   !this.inout = !inout

   -- Index column
   !rowData[1] = ''

   -- set zone
   !rowData[1 + 1] = !this.zone.name
   -- set pipe,hvac,equi or stru
   !rowData[2 + 1] = !this.ownerOfOwner.name

   -- set branch
   if (!this.branch.set()) then
       !rowData[3 + 1] = !this.branch.name
   else
       !rowData[3 + 1] = ''
   endif

   -- set branch member
   !rowData[4 + 1] = !this.item.name
   !rowData[5 + 1] = !this.item.type

   -- getting the purpose of TABITEM
   !rowData[6 + 1] = !this.getGroup()
   !rowData[7 + 1] = !this.inout

   -- getting the STINRF or STOURF
   !rowData[8 + 1] = !this.getSurface()

   -- getting the STINCD or STOUCD
   !rowData[9 + 1] = !this.getSymbolCode()

   -- getting the PUINCD or PUOUCD
   !rowData[10 + 1] = !this.getPunchCode()

   -- getting the BRIARE,BREARE or DESPARA[81],[82]
   !rowData[11 + 1] = !this.getArea(!this.ownerOfOwner.type).string(!!areaFmt)

   return !rowData

endmethod
-- End of method definition for .setArray()

------------------------------------------------------------------------
--
-- Method:      .getGroup()
--
-- Description: Getting the purpose of TABITEM
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGroup() is STRING

    !tabitem = object DBREF()
    !element = !this.item

    if (!this.inout eq 'IN') then
        !attr = |'INPRTR'|
    else
        !attr = |'OUPRTR'|
    endif

    -- looping until zone element
    do
      if (!element.type eq 'ZONE') then
          break
      endif

      !surfaceRef = !element.attribute($!attr)
      handle (2,201)
          -- Element does not exists IBPRTR or OUPRTR attribute
          !element = !element.owner
          skip
      elsehandle NONE

          if (!surfaceRef.set()) then
             -- check whether reference is bad or not
             if (NOT BADREF(!surfaceRef)) then
                 if (!surfaceRef.type eq 'TABITE') then
                     !tabitem = !surfaceRef
                 elseif (!surfaceRef.type eq 'GPART') then
                    -- if INPRTR is point out to GPART by directly, null value will be return
                    -- it should be amended in the future.
                    !tabitem = object DBREF()
                 endif
             else
                 !tabitem = object DBREF()
             endif
             break
          else
              !element = !element.owner
          endif
      endhandle
   enddo

   if (!tabitem.unset()) then
       return ''
   else
       return !tabitem.owner.owner.purpose
   endif

endmethod
-- End of method definition for .getGroup()

------------------------------------------------------------------------
--
-- Method:      .getSurface()
--
-- Description: Getting Surface Treatment Code Value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSurface() is STRING
    if (!this.inout eq 'IN') then
       !this.surface = !this.item.stinrf
    else
       !this.surface = !this.item.stourf
    endif
    if (!this.surface.unset()) then
       return ''
    else
       return !this.surface.name
    endif
endmethod
-- End of method definition for .getSurface()

------------------------------------------------------------------------
--
-- Method:      .getSymbolCode()
--
-- Description: Getting Symbol Code value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSymbolCode() is STRING
    if (!this.inout eq 'IN') then
       !this.symbolcd = !this.item.stincd
    else
       !this.symbolcd = !this.item.stoucd
    endif

    return !this.symbolcd
endmethod
-- End of method definition for .getSymbolCode()

------------------------------------------------------------------------
--
-- Method:      .getPunchCode()
--
-- Description: Getting Punch Code value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPunchCode() is STRING
    if (!this.inout eq 'IN') then
       !this.punchcd = !this.item.puincd
    else
       !this.punchcd = !this.item.puoucd
    endif
    return !this.punchcd
endmethod
-- End of method definition for .getPunchCode()

------------------------------------------------------------------------
--
-- Method:      .getArea()
--
-- Description: In Branch member case, Getting Inside or Outside Area
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getArea(!type is STRING) is REAL

  if( !this.item.type eq 'GASK') then
    -- A gasket is not surface treated
    !this.area = 0mm2
  elseif (!this.item.type eq 'TUBI' and !type eq 'HVAC') then
    !this.area = (!this.item.nsrf - (2 * (!this.item.nvol / !this.item.itle)))
  else
    if (!this.inout eq 'IN') then
       if (!type eq 'PIPE') then
         !this.area = !this.item.briare
       elseif (!type eq 'HVAC') then
        !value = !this.item.despara[81]
        !oldStoredUnit = !this.item.wdespara[88]
         if (!value.string().upcase().match('M').gt(0) or !value.string().upcase().match('F').gt(0) or !value.string().upcase().match('I').gt(0)) then
           !this.area = ( !value )
         else
           if (!oldStoredUnit eq 'SQFT') then
             !this.area = ( !value * 1FT2 )
           else
             !this.area = ( !value * 1M2 )
           endif
         endif
       endif
    else
       if (!type eq 'PIPE') then
         !this.area = !this.item.nsrf
       elseif (!type eq 'HVAC') then
        !value = !this.item.despara[82]
        !oldStoredUnit = !this.item.wdespara[88]
         if (!value.string().upcase().match('M').gt(0) or !value.string().upcase().match('F').gt(0) or !value.string().upcase().match('I').gt(0)) then
           !this.area = ( !value )
         else
           if (!oldStoredUnit eq 'SQFT') then
             !this.area = ( !value * 1FT2 )
           else
             !this.area = ( !value * 1M2 )
           endif
         endif
       endif
    endif
  endif

    -- Use number of decimal places in area format to round the result
    !roundedArea = !this.area.string(!!areaFmt).real()
    return !roundedArea

endmethod
-- End of method definition for .getArea()


------------------------------------------------------------------------
--
-- Method:      .setEquiStruData()
--
-- Description: In EQUI,STRU case,Setting grid data to array for populate in GRID
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setEquiStruData(!element is DBREF) is ARRAY

       !this.item = !element

       !rowData = object ARRAY()
       !this.inout = 'OUT'

   -- Index column
        !rowData[1] = ''

       !rowData[1 + 1] = !this.zone.name
       !rowData[2 + 1] = ''
       !rowData[3 + 1] = ''
       !rowData[4 + 1] = !this.item.name
       !rowData[5 + 1] = !this.item.type
       !rowData[6 + 1] = !this.getGroup()
       !rowData[7 + 1] = !this.inout
       !rowData[8 + 1] = !this.getSurface()
       !rowData[9 + 1] = !this.getSymbolCode()
       !rowData[10 + 1] = !this.getPunchCode()

       !area = !this.item.nsrf
       handle (2,78)
          !rowData[11 + 1] = 0
       elsehandle none
          !roundedArea = !area.string(!!areaFmt).real()
          !rowData[11 + 1] = !roundedArea
       endhandle

       !arrayData = object ARRAY()
       !arrayData.append(!rowData)

       return !arrayData

endmethod
-- End of method definition for .setEquiStruData()

------------------------------------------------------------------------
--
-- Method:      .setPipeHvacBran()
--
-- Description: Getting all branch and Setting to Grid Array
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPipeHvacBran(!ele is DBREF) is ARRAY

  -- element type is BRAN
  if (!ele.type eq 'BRAN') then

      -- finding first parent such as type is PIPE or HVAC
      -- if find it, set it to !this.ownerOfOwner variable
      !this.getPipeOrHvac(!ele)

      -- can not find PIPE or HVAC element at ancestor elements
      if (!this.ownerOfOwner.unset()) then
         -- Error expecting.
         !this.ownerOfOwner = object DBREF()
      endif

  -- element type is PIPE or HVAC
  else
      !this.setOwnerOFOwner(!ele)
  endif

  var !allBran collect ALL BRAN for $!ele

  !arrayData = object ARRAY()

  do !bran values !allBran

     !currentBran = !bran.dbref()

     -- setting branch element
     !this.setBranch(!currentBran)

     -- twice setting branch members as inside and outside
     !rtnData = !this.setBranData(!currentBran)

     !arrayData.appendArray(!rtnData)

  enddo

  return !arrayData

endmethod
-- End of method definition for .setPipeHvacBran()

------------------------------------------------------------------------
--
-- Method:      .getZoneMem()
--
-- Description: Getting all zone members and Setting to Grid Array
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getZoneMem(!ele is DBREF) is ARRAY

  -- setting zone(!ele is ZONE element)
  !this.setZone(!ele)

  -- getting all zone member of zone
  !memberList = !!collectMembersOf(!ele,'')

  !arrayData = object ARRAY()

  do !item values !memberList

      -- zone member is PIPE or HVAC element
      if ((!item.type eq 'PIPE') or (!item.type eq 'HVAC')) then
         !rtnData = !this.setPipeHvacBran(!item)
         !arrayData.appendArray(!rtnData)

      -- zone member is EQUI or STRU element
      elseif ((!item.type eq 'EQUI') or (!item.type eq 'STRU')) then
         !rtnData = !this.setEquiStruData(!item)
         !arrayData.appendArray(!rtnData)

      -- zone member is others
      else
               -- Other elements does not implemented at this moment
      endif

  enddo

  return !arrayData

endmethod
-- End of method definition for .getZoneMem()
