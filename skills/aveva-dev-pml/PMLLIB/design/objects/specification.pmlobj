--
--
-- Description:
--    Specification Component Object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  answers(STRING,DBREF)            ARRAY               Returns the answers for the passed component
--  availableBores()                 ARRAY               Returns the list of available bores within the spec
--  bores()                          ARRAY               Return the available bore for the specification
--  changeTypes(STRING)              ARRAY               Return change types for passed component type
--  componentData(STRING,STRING,ARRAY,ARRAY) ARRAY               Extracts the available sub-types for the passed element type
--  components(STRING,ARRAY,ARRAY)   ARRAY               Extracts the components for the passed questions and answers
--  deriveChangeTypes()              -                   Determine the change types for the specification
--  lastStype(STRING)                STRING              Sets the last stype of passed component to passed value
--  lastStype(STRING,STRING)         -                   Sets the last sub-type of passed component to passed value
--  loadBores()                      -                   Load the available bores for the specification
--  loadComponents()                 -                   Load the available components for the spec, ignores TUBE and BOLT
--  loadTable(STRING)                BOOLEAN             Build table for component
--  maxAnswers(STRING,DBREF)         ARRAY               Returns the maximum answers for the passed component
--  questions(STRING)                ARRAY               Returns the questions for the passed component type
--  setSpecification(DBREF)          -                   Load specification, but not the tables
--  specification(DBREF)             -                   Constructor
--  subTypes(STRING,REAL,BORE)       ARRAY               Extracts the available Stypes for the passed element type
--  typeIndex(STRING)                REAL                Returns index for passed type
--
------------------------------------------------------------------------

define object SPECIFICATION

  -- Specification
  member .dbElement           is DBREF

  -- Specification Type
  member .type                is STRING

  -- Available Component Types
  member .types               is ARRAY

  -- Verbose description of available types
  member .descriptions        is ARRAY

  -- Spec selector containing component types
  member .selectors           is ARRAY

  -- Component Table
  member .tables              is ARRAY

  -- Component Type Defaults
  member .defaults            is ARRAY

  -- Last Stype selected of component
  member .lastStype           is ARRAY

  -- Tubing Selector
  member .tubing              is DBREF

  -- Available bores for the pipe (Array of bores)
  member .bores               is ARRAY

  -- Possible change types for component type (Indices of types associated)
  member .changeTypes         is ARRAY

  -- Boolean Member to allow/disable tubes
  member .allowTubes 					is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      specification
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specification(!specification is DBREF)

  -- Initialise Variables
  !this.types.clear()
  !this.changeTypes.clear()
  !this.descriptions.clear()
  !this.selectors.clear()
  !this.tables.clear()
  !this.tubing      = object DBREF()
	
	!this.allowTubes = FALSE
	
  -- Set Spec DB reference
  !this.dbElement   = !specification

  -- Set Spec Type
  !this.type        = !specification.purpose

  -- Load List of available component types in the spec
  !this.loadComponents()

  -- Load available bores
  !this.loadBores()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Load specification, but not the tables
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpecification(!specification is DBREF)

  -- Initialise Variables
  !this.types.clear()
  !this.changeTypes.clear()
  !this.descriptions.clear()
  !this.selectors.clear()
  !this.tables.clear()
  !this.tubing      = object DBREF()

  -- Set Spec DB reference
  !this.dbElement   = !specification

  -- Set Spec Type
  !this.type        = !specification.purpose

  -- Load bores
  !this.loadBores()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .bores
--
-- Description: Return the available bore for the specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bores() is ARRAY
  return !this.bores
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .loadBores
--
-- Description: Load the available bores for the specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBores()

  -- Initialise Variables
  !bores          = ARRAY()

  -- If there is no tubing selector set and the component table is
  -- empty then we'll try and load the bores without loading the components
  if(!this.tubing.unset() and !this.tables.unset()) then

    -- Loop through spec selectors
    do !selector values !this.dbElement.members
      skip if(!selector.type ne 'SELE')
      skip if(!selector.tanswer.upcase() ne 'TUBE')
      !this.tubing = !selector
      break
    enddo

  endif

  -- Load the bores from beneath the tubing selector
  if(!this.tubing.set()) then

    -- Get selector which has PBOR as the QUES
    if(!this.tubing.question eq 'PBOR') then
      !tubeSelector = !this.tubing
    else
      var !selectors coll all SELE with (QUESTION eq 'PBOR') for $!<this.tubing>
      if(!selectors.empty()) then
        return
      endif
      -- Use first selector
      !tubeSelector = !selectors[1].dbref()
    endif

    -- Get selectors beneath the "Pbore" selector
    do !selector values !tubeSelector.members
      skip if(!selector.answer.unset())
      !bores.append(!selector.answer)
    enddo
    !bores.sort()
    !this.bores = !bores

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .loadComponents
--
-- Description: Load the available components for the spec, ignores TUBE and BOLT
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadComponents()

  -- Initialise Variables
  !descriptions = ARRAY()
  !types        = ARRAY()
  !selectors    = ARRAY()

  -- Check we are at a piping specification
  if(!this.dbElement .unset()) then
    !!error.text = 'No specification set.'
    return
  endif

  -- Get available component types of specification
  !members = !this.dbElement.members

  -- Loop through and get the type
  do !i indices !members

    -- Ignore no selectors
    skip if(!members[!i].type ne 'SELE')

    -- Get Text answer
    !type = !members[!i].tanswer

    -- Get noun definition of type
    var !data nounDef $!<type> rptx
    handle ANY
      !name = !type
    elsehandle NONE
      !name = !data[1]
    endhandle
    !types.append(!type)

    -- Special Case Names
    if(!type eq 'ATTA') then
      !descriptions.append('Attachment Point')
    elseif (!type eq 'PCOM') then
      !descriptions.append('Piping Component')
    elseif (!type eq 'FTUB') then
      !descriptions.append('Fixed Length Tube')
    elseif (!type eq 'LJSE') then
      !descriptions.append('Lap-Joint with Stub End')
    elseif (!type eq 'SHU') then
      !descriptions.append('Standard Hook-up')
    else
      !descriptions.append(!name.substring(1,1) & !name.substring(2).lowcase())
    endif
    !selectors.append(!members[!i])

  enddo

  -- If there are no components, then return
  if(!types.empty()) then
    return
  endif

  -- Remove Tubing from list
  !index      = !types.findFirst('TUBE')
  if(!index.set()) then
    !this.tubing  = !selectors[!index]
    if !this.allowTubes.not() then
    	!types.remove(!index)
   	 	!descriptions.remove(!index)
   		!selectors.remove(!index)
  	endif
  endif

  -- Remove bolting from the component list
  !index      = !types.findFirst('BOLT')
  if(!index.set()) then
    !types.remove(!index)
    !descriptions.remove(!index)
    !selectors.remove(!index)
  endif

  -- Sort components into order
  !order              = !descriptions.sortedIndices()
  !types.reIndex(!order)
  !descriptions.reIndex(!order)
  !selectors.reIndex(!order)

  -- Set object members
  !this.types         = !types
  !this.descriptions  = !descriptions
  !this.selectors     = !selectors

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      typeIndex
--
-- Description: Returns index for passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
-- Return:
--   [Data Type] [Description]
--    REAL        Index in list
--
------------------------------------------------------------------------

define method .typeIndex(!type is STRING) is REAL
  return !this.types.findFirst(!type.upcase())
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      subTypes
--
-- Description: Extracts the available Stypes for the passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      REAL        Ppoint number for Arrive
--    3   R      BORE        Nominal Bore of component
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of Stypes for component type
--
------------------------------------------------------------------------

define method .subTypes(!type is STRING, !arrive is REAL, !nominalBore is BORE) is ARRAY

  -- Check type index
  !index = !this.typeIndex(!type)
  if(!index.unset()) then
    !sTypes = ARRAY()
  else
    !sTypes = !this.tables[!index].subTypes(!arrive, !nominalBore)
  endif

  -- Return
  return !sTypes

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      lastStype
--
-- Description: Sets the last sub-type of passed component to passed value
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      STRING      Stype Value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lastStype(!type is STRING, !stype is STRING)
  !this.lastStype[!this.typeIndex(!type)] = !stype
endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      lastStype
--
-- Description: Sets the last stype of passed component to passed value
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
-- Return:
--   [Data Type] [Description]
--    STRING      Stype Value
--
------------------------------------------------------------------------

define method .lastStype(!type is STRING) is STRING

  -- Check is stype has been defined
  !index      = !this.typeIndex(!type)
  if(defined(!this.lastStype[!index])) then
    !return = !this.lastStype[!index]
  else
    !return = STRING()
  endif

  return !return
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      componentData
--
-- Description: Extracts the available sub-types for the passed element type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      STRING      Question to return
--    3   R      ARRAY       Questions to check for
--    4   R      ARRAY       Answers to questions
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of Answers to question for component type
--
------------------------------------------------------------------------

define method .componentData(!type is STRING, !question is STRING, !questions is ARRAY, !answers is ARRAY) is ARRAY

  -- Get Type Index
  !index  = !this.typeIndex(!type)
  if(!index.unset()) then
    !data = ARRAY()
  else
    !data = !this.tables[!this.typeIndex(!type)].componentData(!question, !questions, !answers)
  endif

  -- Return
  return !data

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      components
--
-- Description: Extracts the components for the passed questions and answers
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      ARRAY       Questions to check for
--    3   R      ARRAY       Answers to questions
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of components
--
------------------------------------------------------------------------

define method .components(!type is STRING, !questions is ARRAY, !answers is ARRAY) is ARRAY

  -- Get Type Index
  !index        = !this.typeIndex(!type)
  if(!index.unset()) then
    !components = ARRAY()
  else
    !components = !this.tables[!index].components(!questions, !answers)
  endif

  -- Return
  return !components

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      questions
--
-- Description: Returns the questions for the passed component type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
-- Return:
--   [Data Type] [Description]
--    ARRAY       Questions for component type
--
------------------------------------------------------------------------

define method .questions(!type is STRING) is ARRAY

  -- Get Type Index
  !index  = !this.typeIndex(!type)
  if(!index.unset()) then
    !data = ARRAY()
  else
    !data = !this.tables[!this.typeIndex(!type)].questions()
  endif

  -- Return
  return !data

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      answers
--
-- Description: Returns the answers for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    ARRAY       Answers for passed component
--
------------------------------------------------------------------------

define method .answers(!type is STRING, !component is DBREF) is ARRAY

  -- Get Type Index
  !index  = !this.typeIndex(!type)
  if(!index.unset()) then
    !data = ARRAY()
  else
    !data = !this.tables[!this.typeIndex(!type)].answers(!component)
  endif

  -- Return
  return !data

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      maxAnswers
--
-- Description: Returns the answers for the passed component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
--    2   R      DBREF       Component
-- Return:
--   [Data Type] [Description]
--    ARRAY       Answers for passed component
--
------------------------------------------------------------------------

define method .maxAnswers(!type is STRING, !component is DBREF) is ARRAY

  -- Get Type Index
  !index  = !this.typeIndex(!type)
  if(!index.unset()) then
    !data = ARRAY()
  else
    !data = !this.tables[!this.typeIndex(!type)].maxAnswers(!component)
  endif

  -- Return
  return !data

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      loadTable
--
-- Description: Build table for component
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if table loaded, false if component not found in spec
--
------------------------------------------------------------------------

define method .loadTable(!type is STRING) is BOOLEAN

  -- Initialise Variables
  !loaded                 = false
  -- Check if component Table has been loaded
  !index                  = !this.typeIndex(!type)

  -- Load table
  if(!index.set()) then
    if(undefined(!this.tables[!index])) then
      !this.tables[!index]  = object COMPONENTTABLE(!this.selectors[!index])
    endif
    !loaded                 = true
  endif

  -- Return
  return !loaded

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      changeTypes
--
-- Description: Return change types for passed component type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Component type to get change types for
-- Return:
--   [Data Type] [Description]
--    ARRAY       Paired array of description and Type of possible change types
--
------------------------------------------------------------------------

define method .changeTypes(!type is STRING) is ARRAY

  -- Initialise Variables
  !results        = ARRAY()

  -- Get Component index
  !index          = !this.typeIndex(!type)

  -- Get possible change types
  if(!index.set()) then
    !possibleTypes  = !this.changeTypes.find(!this.changeTypes[!index])

    -- Move passed item to beginning of list
    !possibleTypes.remove(!possibleTypes.findFirst(!index))
    !possibleTypes.insert(1, !index)

    -- Get Type and Description for components
    do !i indices !possibleTypes
      !results[1][!i] = !this.descriptions[!possibleTypes[!i]]
      !results[2][!i] = !this.types[!possibleTypes[!i]]
    enddo
  endif

  -- Return
  return !results

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deriveChangeTypes
--
-- Description: Determine the change types for the specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveChangeTypes()

  -- Initialise Variables
  !changeGroups   = ARRAY()

  !this.changeTypes.clear()

  -- Loop through the available components in the specification
  do !i indices !this.types

    !type     = !this.types[!i]
    var !nounDef NOUNDEF $!<type> CHANGE RPTX
    handle ANY
      skip
    endhandle
    !hashCode     = !nounDef[1]

    var !changeType UNHASH($!hashCode)

    -- Special cases until UNHASH can handle 6 characters
    handle ANY
      if(!hashCode eq '79902432') then
        !changeType = 'INLINE'
      elseif (!hashCode eq '259452084') then
        !changeType = 'LINEAR'
      elseif (!hashCode eq '8258209') then
        !changeType = 'PCONN'
      elseif (!hashCode eq '2528752') then
        !changeType = 'MULTC'
      else
        !changeType = !hashCode
      endif
    endhandle

    -- Check for a group
    !groupIndex = !changeGroups.findFirst(!changeType)

    -- Add change type to group
    if(!groupIndex.unset()) then
      !changeGroups.append(!changeType)
      !groupIndex = !changeGroups.size()
    endif

    -- Save change type against component type
    !this.changeTypes[!i] = !changeType

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      availableBores
--
-- Description: Returns the list of available bores within the spec
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of bores
--
------------------------------------------------------------------------

define method .availableBores() is ARRAY

  -- Initialise Variables
  !bores    = ARRAY()

  --

  -- Return
  return !bores

endmethod
-- End of method definition
