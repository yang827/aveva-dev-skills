--   Module:        Design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Mon Jan 19 11:00:00 GMT 2004
--
--
-- Description:
--    Object for extracting and holding available specifications within
--    the system.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cabl()                           BOOLEAN
--  cwma()                           BOOLEAN
--  cwpa()                           BOOLEAN
--  elco()                           BOOLEAN
--  epen()                           BOOLEAN
--  insulation()                     BOOLEAN             Loads the object with all the tracing specifications
--  isItAPipe(DBREF)                 BOOLEAN             Set passed specification data
--  piping()                         BOOLEAN             Loads the object with all the piping specifications
--  purposeOrStext(STRING,STRING)    BOOLEAN             Loads the object with all the specifications of passed
--  setData(STRING,ARRAY)            -                   Set passed specification data
--  specIndex(DBREF)                 REAL                Returns the specification index for the passed specification
--  specifications(STRING)           -                   Loads the available list of specs for the passed type
--  tracing()                        BOOLEAN             Loads the object with all the tracing specifications
--

define object SPECIFICATIONS

  -- Specification information
  member .names           is ARRAY
  member .references      is ARRAY
  member .refStrings      is ARRAY
  member .descriptions    is ARRAY

  -- Specification Type
  member .type            is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      specifications
--
-- Description: Loads the available list of specs for the passed type
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Specification type PIPE TRACE or INSU
--
------------------------------------------------------------------------
define method .specifications(!spectype is STRING)

if !spectype.upcase().eq('PIPE') then
   !this.piping()
elseif !spectype.upcase().eq('TRACE') then
   !this.tracing()
elseif !spectype.upcase().eq('INSU') then
   !this.insulation()
else
   !!alert.error('Invalid option in Specification Search')
   return
endif

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      specIndex
--
-- Description: Returns the specification index for the passed specification
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification
-- Return:
--   [Data Type] [Description]
--    REAL        Index in list of spec
--
------------------------------------------------------------------------

define method .specIndex(!spec is DBREF) is REAL
  return !this.references.findfirst(!spec)
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      piping
--
-- Description: Loads the object with all the piping specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if pipe specifications have been found
--
------------------------------------------------------------------------

define method .piping() is BOOLEAN

  -- Initialise Variables
  return !this.purposeOrStext('Piping', 'PIP')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      tracing
--
-- Description: Loads the object with all the tracing specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if tracing specifications have been found
--
------------------------------------------------------------------------

define method .tracing() is BOOLEAN

  -- Initialise Variables
  return !this.purposeOrStext('Tracing', 'TRAC')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      insulation
--
-- Description: Loads the object with all the tracing specifications
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if insulation specifications have been found
