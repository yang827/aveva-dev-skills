------------------------------------------------------------------------

define method .insulation() is BOOLEAN

  -- Initialise Variables
  return !this.purposeOrStext('Insulation', 'INSU')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      purposeOrStext
--
-- Description: Loads the object with all the specifications of passed
--              purpose or STEXT of TEXT 1
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if pipe specifications have been found
--
------------------------------------------------------------------------

define method .purposeOrStext(!key is STRING, !checkString is STRING) is BOOLEAN

  -- Initialise Variables
  !testString = !checkString.upcase()

  -- Get All Specs with either PURP eq 'PIPI' and/or the STEXT of TEXT eq 'PIPING'
  -- Defect 10250 'gt 0' added before the last ')'
  -- Do not want HVAC Specs
  var !specList  collect all SPEC with ((NOT(PURP eq 'HVAC' or PURP OF OWNER eq 'HVAC')) and (match(upcase(PURPOSE), !testString)gt 0 or match(upcase(STEXT of TEXT 1 ), !testString)gt 0))

  -- No piping specifications found
  if(!specList.empty()) then
    return false
  endif

  -- Convert all spec in to DBREFs
  do !i indices !specList
    !specs[!i] = !specList[!i].dbref()
  enddo

  -- Set current specifications
  !this.setData(!key, !specs)

  -- Return
  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Set passed specification data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Specification Type
--    2   R      ARRAY       List of specifications to get data from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setData(!type is STRING, !specs is ARRAY)

  -- Initialise Variables
  !this.names.clear()
  !this.references.clear()
  !this.descriptions.clear()

  -- Set Data
  !this.type          = !type
  !this.references    = !specs

  -- Extract Info
  do !i indices !this.references
    !spec                     = !this.references[!i]
    !this.names[!i]           = !spec.flnn
    !this.refStrings[!i]      = !spec.refe.string()
    if(!spec.description.unset()) then
      !this.descriptions[!i]  = !this.names[!i] & ' - ' & !spec.description
    else
      !this.descriptions[!i]  = !this.names[!i]
    endif

  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      isItAPipe
--
-- Description: Set passed specification data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      component to be checked
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     TRUE if the component is in the current spec type FALSE if not
--
------------------------------------------------------------------------

define method .isItAPipe(!comp is DBREF)is BOOLEAN

if !comp.owner.type.eq('BRAN') then
   !ans = !this.references.findfirst(!comp.lstu.spown)
   handle any
     !ans = !this.references.findfirst(!comp.spown)
     handle any
     endhandle
   endhandle
elseif !comp.type.eq('BRAN') then
   !ans = !this.references.findfirst(!comp.pspec)
else
   return FALSE
endif

if !ans.set() then
   return TRUE
else
   return FALSE
endif

endmethod
-- End of method definition
