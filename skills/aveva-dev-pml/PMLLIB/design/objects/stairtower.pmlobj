--   Type:          Object Definition
--   Group:
--
--     Keyword:     Stairtower
--   Module:        Design
--   Replaces:
--
-- Author:          Neil.Holmes
-- Created:         Friday Jul 6 13:00:00 GMT 2007
--
-- Description:
--    Object for handling stairtower definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accessLevel(REAL,REAL)           BOOLEAN             Set the elevation of the access point to elevation of the passed landing level (maintains XY offset)
--  accessType(REAL,STRING)          BOOLEAN
--  aidNumbers(REAL,REAL,REAL,REAL)  -                   Set aid numbers
--  beamDefinition(DBREF,STRING)     -                   Set beam definition information, SPREF, JUSL
--  beamLevels(ARRAY)                -                   Define beam levels from passed array
--  beamLevelsFromLandings(REAL)     -                   Define beam levels from landings and apply and offset (by default down)
--  beamStore(REAL)                  DBREF               Get beam store for specific level
--  beamStores()                     ARRAY               Get all beam stores
--  beams(REAL)                      ARRAY               Return array of beam information
--  columnBase(REAL)                 -                   Set base of columns relative to the stair tower plane
--  columnDefinition(DBREF,STRING,REAL) -                   Set column definition information, SPREF, JUSL, BANG
--  columnSpacings(ARRAY,ARRAY)      -                   Set column spacings
--  columnStore()                    DBREF               Get column store (only returns first if there are more than one)
--  columns()                        ARRAY               Return array of column information
--  createSections()                 BOOLEAN             Create steelwork for stair tower
--  createStore(STRING,REAL)         DBREF               Create steelwork storage area
--  direction(DIRECTION)             -                   Set primary direction of stair tower position (normalised on plane)
--  draw()                           -                   Draw ceiling grid
--  grid()                           BOOLEAN             Define grid
--  landingLevels(ARRAY)             -                   Define landing levels from passed array
--  landingsFromBeamLevels(REAL)     -                   Define landing levels from beam levels and apply and offset (by default up)
--  modifyAccessDefinition()         BOOLEAN             Modify STRTWR definition
--  modifySection(DBREF,REAL,LINE)   BOOLEAN             Modify the passed section
--  newSection(LINE,DBREF,STRING,REAL,DIRECTION,REAL) BOOLEAN             Create a new section
--  position(POSITION)               -                   Set position of stair tower
--  query()                          -                   Display query data
--  resolveAccesses()                -                   Resolve the access into the STRTWR so they are on the boundary
--  stairTower()                     -                   Constructor
--  stairTower(DBREF)                BOOLEAN             Constructor
--  test()                           -                   Test
--  tidy()                           -                   Tidy up aid graphics
--  updateDBElement()                BOOLEAN             Update STRTWR database element
--  updateSections()                 BOOLEAN             Update steelwork for stair tower
--  updateSections(DBREF,ARRAY)      BOOLEAN             Update sections in the passed store with the new definitions
--
------------------------------------------------------------------------

define object STAIRTOWER

  -- DB Element referenced
  member .dbElement       is DBREF

  -- New stair tower
  member .new             is BOOLEAN

  -- Ceiling Grid
  member .grid            is PLANTGRID

  -- Stair tower plane (position and orientation)
  member .plane           is PLANE

  -- Column spacing
  member .columnXSpacings is ARRAY
  member .columnYSpacings is ARRAY

  -- Flight centre line
  member .fltclXSpacings  is ARRAY
  member .fltclYSpacings  is ARRAY

  -- Landing levels
  member .landingLevels   is ARRAY

  -- Beam levels
  member .beamLevels      is ARRAY

  -- Column base level
  member .columnBase      is REAL

  -- Structural data
  member .columnSpref     is DBREF
  member .columnJusline   is STRING
  member .columnBangle    is REAL
  member .beamSpref       is DBREF
  member .beamJusline     is STRING

  -- Access information (Array of access objects)
  member .accessPoints    is ARRAY

  -- Non-geometrical information
  member .description     is STRING
  member .function        is STRING
  member .purpose         is STRING
  member .area            is REAL
  member .number          is REAL
  member .materialRef     is DBREF
  member .configuration   is STRING
  member .standard        is STRING
  member .sense           is BOOLEAN
  member .fireRating      is STRING
  member .fireResistance  is REAL

  -- Reference data
  member .thickness       is REAL
  member .treadWidth      is REAL
  member .headroom        is REAL
  member .headClearance   is REAL
  member .flightThickness is REAL
  member .height          is REAL
  member .width           is REAL
  member .length          is REAL
  member .criteriaRefs    is ARRAY
  member .labelOffset     is ARRAY

  -- Error state, where a method doesn't return a boolean but a null object is returned
  member .errorState      is BOOLEAN
  member .errorText       is STRING
  member .errorList       is ARRAY

  -- Aid graphics
  member .aidSteel        is REAL
  member .aidAccess       is REAL
  member .aidNumber       is REAL
  member .aidLanding      is REAL

  -- Tag flags
  member .tagLandings     is BOOLEAN
  member .tagSteel        is BOOLEAN
  member .tagAccess       is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     stairTower
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stairTower()

  -- Initialise Variables
  !this.new             = true
  !this.errorState      = false
  !this.errorText       = STRING()
  !this.errorList.clear()
  !this.accessPoints.clear()

  -- Defaults
  !this.plane           = object PLANE(N0, Y is N)
  !this.columnBangle    = 0

  -- Tag info
  !this.tagLandings     = false
  !this.tagSteel        = false
  !this.tagAccess       = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     stairTower
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair tower
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     If correct
--
------------------------------------------------------------------------

define method .stairTower(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.stairTower()
  !this.test()

  -- Check that STRTWR has bee passed
  if(!element.type.neq('STRTWR')) then
    !this.errorState    = true
    !this.errorText     = 'Element :' & !element.namn & ' is not a stair tower.'
    return false
  endif

  -- Set object using passed grid
  !this.new             = false
  !this.dbElement       = !element
  !this.plane           = object PLANE(!element.position, !element.orientation)

  -- Set column spacings
  !this.columnXSpacings = !element.colXSpacing
  !this.columnYSpacings = !element.colYSpacing

  -- Set landing levels
  !this.landingLevels   = !element.lndLevels
  !this.beamLevels      = !element.bmLevels

  -- Set column base
  !this.columnBase      = !element.clBaseOffset

  -- Non-geometrical information
  !this.description     = !element.description
  !this.function        = !element.function
  !this.purpose         = !element.purpose
  !this.area            = !element.area
  !this.number          = !element.number
  !this.materialRef     = !element.matref
  !this.configuration   = !element.strcon
  !this.standard        = !element.strstd
  !this.sense           = !element.intsen
  !this.fireRating      = !element.fireRating
  !this.fireResistance  = !element.firesistance

  -- Reference data
  !this.thickness       = !element.thickness
  !this.treadWidth      = !element.tWidth
  !this.headroom        = !element.headroom
  !this.headClearance   = !element.headClearance
  !this.flightThickness = !element.fThickness
  !this.height          = !element.opHeight
  !this.width           = !element.opWidth
  !this.length          = !element.opLength
  !this.criteriaRefs    = !element.dcrfarray
  !this.labelOffset     = !element.laboffset

  -- Get column & beam information
  !columnStore          = !this.columnStore()
  if(!columnStore.set()) then
    if(!columnStore.mCount.gt(0)) then
      !spref            = !columnStore.members[1].spref
      !jusLine          = !columnStore.members[1].jusLine
      !bAngle           = !columnStore.members[1].bAngle
      !this.columnDefinition(!spref, !jusLine, !bAngle)
    endif
  endif

  !beamStore            = !this.beamStore(1)
  if(!beamStore.set()) then
    if(!beamStore.mCount.gt(0)) then
      !spref            = !beamStore.members[1].spref
      !jusLine          = !beamStore.members[1].jusLine
      !this.beamDefinition(!spref, !jusLine)
    endif
  endif

  -- Get the access information
  !collection           = object COLLECTION()
  !collection.scope(!element)
  !collection.type('ACCPNT')
  !accessPoints         = !collection.results()

  do !i indices !accessPoints
    !accessPoint        = object ENTRYEXITACCESS(!accessPoints[!i])
    !accessPoint.aidNumber(!this.aidAccess)
    !accessPoint.tag    = !this.tagAccess
    !this.accessPoints.append(!accessPoint)
  enddo

  -- Define grid
  !this.grid()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  AID CLEAR ALL $!<this.aidSteel>
  AID CLEAR ALL $!<this.aidAccess>
  AID CLEAR ALL $!<this.aidLanding>
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidNumbers(!number is REAL, !steel is REAL, !access is REAL, !landing is REAL)
  !this.aidNumber   = !number
  !this.aidSteel    = !steel
  !this.aidAccess   = !access
  !this.aidLanding  = !landing
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     position
--
-- Description: Set position of stair tower
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position of tower
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Get offset from old position to new
  if(!this.plane.position.near(!position, 0.1mm).not()) then
    !offset     = !this.plane.position.distance(!position)
    !direction  = !this.plane.position.direction(!position)

    -- Offset any access points for the stair tower
    do !i indices !this.accessPoints
      !this.accessPoints[!i].offset(!direction, !offset)
    enddo

  endif

  -- Set new position
  !this.plane.position  = !position

  -- Redraw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     direction
--
-- Description: Set primary direction of stair tower position (normalised on plane)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position of tower
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)
  !this.plane.orientation  = object ORIENTATION('Y is ' & !direction)
  !this.draw()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     columnBase
--
-- Description: Set base of columns relative to the stair tower plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Elevations
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .columnBase(!offset is REAL)
  !this.columnBase  = !offset
  !this.draw()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     columnDefinition
--
-- Description: Set column definition information, SPREF, JUSL, BANG
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Catalogue Reference
--    2   R      STRING      Justification line
--    3   R      REAL        Beta Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .columnDefinition(!spref is DBREF, !jusLine is STRING, !bAngle is REAL)
  !this.columnSpref   = !spref
  !this.columnJusline = !jusLine
  !this.columnBangle  = !bAngle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beamDefinition
--
-- Description: Set beam definition information, SPREF, JUSL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Catalogue Reference
--    2   R      STRING      Justification line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .beamDefinition(!spref is DBREF, !jusLine is STRING)
  !this.beamSpref   = !spref
  !this.beamJusline = !jusLine
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beamLevels
--
-- Description: Define beam levels from passed array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Elevations
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .beamLevels(!elevations is ARRAY)

  -- Initialise Variables
  !levels = !elevations
  !levels.sort()

  -- Save levels
  !this.beamLevels  = !levels

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beamLevelsFromLandings
--
-- Description: Define beam levels from landings and apply and offset (by default down)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset from landing levels
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .beamLevelsFromLandings(!offset is REAL)

  -- Initialise Variables
  !levels           = !this.landingLevels

  -- Offset levels
  do !i indices !levels
    !levels[!i]     = !levels[!i] - !offset
  enddo

  -- Save levels
  !this.beamLevels  = !levels

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     landingLevels
--
-- Description: Define landing levels from passed array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Elevations
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .landingLevels(!elevations is ARRAY)

  -- Initialise Variables
  !levels = !elevations
  !levels.sort()

  -- Save levels
  !this.landingLevels  = !levels

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     landingsFromBeamLevels
--
-- Description: Define landing levels from beam levels and apply and offset (by default up)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset from beam levels
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .landingsFromBeamLevels(!offset is REAL)

  -- Initialise Variables
  !levels             = !this.beamLevels

  -- Offset levels
  do !i indices !levels
    !levels[!i]       = !levels[!i] + !offset
  enddo

  -- Save levels
  !this.landingLevels = !levels

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     columnSpacings
--
-- Description: Set column spacings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       X Spacings
--    2   R      ARRAY       Y Spacings
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .columnSpacings(!xSpacings is ARRAY, !ySpacings is ARRAY)

  -- Save spacings
  !this.columnXSpacings = !xSpacings
  !this.columnYSpacings = !ySpacings

  -- Define grid
  !this.grid()

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     grid
--
-- Description: Define grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if grid has been defined.
--
------------------------------------------------------------------------

define method .grid() is BOOLEAN

  -- Only update grid if there are spacings
  if(!this.columnXSpacings.empty().or(!this.columnYSpacings.empty())) then
    return false
  endif

  -- Initialise Variables
  !grid             = object PLANTGRID()
  !grid.position    = !this.plane.position
  !grid.orientation = !this.plane.orientation
  !grid.xSpacings   = !this.columnXSpacings
  !grid.ySpacings   = !this.columnYSpacings

  -- Add a 1mm spacing offset to the XY grid lines to handle the underlying
  -- bug in the PLANTGRID object when only having single spacings
  !grid.xSpacings.append(100mm)
  !grid.ySpacings.append(100mm)

  -- Assign grid to object
  !this.grid        = !grid

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     draw
--
-- Description: Draw ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if(!this.aidNumber.unset())then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Define Grid
  if(!this.grid.set()) then

    -- Origin
    !position   = !this.plane.position
    !position   = !this.grid.snapToCentre(!position)

    -- Draw XY axis
    !xDirection = !this.plane.orientation.xDir()
    !yDirection = !this.plane.orientation.yDir()

    -- XY offsets
    !xOffset    = 500mm
    !xPosition  = !position.offset(!xDirection, !xOffset)
    !yOffset    = 1000mm
    !yPosition  = !position.offset(!yDirection, !yOffset)

    -- Tag information
    AID ARROW NUMBER $!<this.aidNumber> AT $!<position> DIRECTION $!<xDirection> HEIGHT $!<xOffset>
    AID ARROW NUMBER $!<this.aidNumber> AT $!<position> DIRECTION $!<yDirection> HEIGHT $!<yOffset>

    AID TEXT NUMBER $!<this.aidNumber> 'X' AT $!<xPosition>
    AID TEXT NUMBER $!<this.aidNumber> 'Y' AT $!<yPosition>

    -- Mark origin
    AID SPHERE NUMBER $!<this.aidNumber> $!<this.plane.position> diameter 100mm


    -- Get Column information (lines)
    !columns        = !this.columns()

    -- Draw columns
    do !x indices !columns
      do !y indices !columns[!x]
        !position = !this.grid.gridPoint(!x - 1, !y - 1)
        !columns[!x][!y].draw(!this.aidSteel, 4, 4)
      enddo
    enddo

    -- Get Beam information (lines)
    do !l indices !this.beamLevels
      !beams  = !this.beams(!this.beamLevels[!l])

      -- Draw beams
      do !i indices !beams
        do !x indices !beams[!i]
          do !y indices !beams[!i][!x]
            !line = !beams[!i][!x][!y]
            !unusedmpos = !line.proportion(0.5)
            !line.draw(!this.aidSteel, 4, 4)
          enddo
        enddo
      enddo
    enddo

    -- Tag beam elevations
    if(!this.tagSteel) then

      -- Loop through beam levels
      do !l indices !this.beamLevels
        !elevation    = !this.beamLevels[!l]
        !tagPos       = !this.plane.position.offset(U, !elevation)
        !tagPos       = !tagPos.offset(!this.plane.orientation.yDir(), 100mm)
        !tag          = !this.beamJusline & ': ' & !elevation.string(!!distanceFmt)
        AID TEXT NUMBER $!<this.aidSteel> '$!tag' AT $!<tagPos>
      enddo
    endif

    -- Tag landing elevations
    if(!this.tagLandings) then

      -- Loop through beam levels
      do !l indices !this.landingLevels
        !elevation    = !this.landingLevels[!l]
        !tagPos       = !this.plane.position.offset(U, !elevation)
        !tagPos       = !tagPos.offset(!this.plane.orientation.xDir(), !this.columnXSpacings.first())
        !tagPos       = !tagPos.offset(!this.plane.orientation.yDir(), !this.columnYSpacings.first())
        !tag          = 'Landing: ' & !elevation.string(!!distanceFmt)
        AID TEXT NUMBER $!<this.aidSteel> '$!tag' AT $!<tagPos>
      enddo
    endif


  endif

  -- Draw access points
  do !i indices !this.accessPoints
    !this.accessPoints[!i].tag  = !this.tagAccess
    !this.accessPoints[!i].draw(false)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     columns
--
-- Description: Return array of column information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array of Line definition of columns
--
------------------------------------------------------------------------

define method .columns() is ARRAY

  -- Initialise Variables
  !lines      = ARRAY()

  -- Get top/bottom beam levels
  if(!this.beamLevels.empty()) then
    !topLevel  = 0
  else
    !topLevel = !this.beamLevels.last()
  endif

  -- Get columns lines
  do !x from 0 to !this.columnXSpacings.size()
    !xID    = !x + 1
    do !y from 0 to !this.columnYSpacings.size()
      !yID  = !y + 1
      !position           = !this.grid.gridPoint(!x, !y)
      !start              = !position.offset(U, !this.columnBase)
      !end                = !position.offset(U, !topLevel)
      !lines[!xID][!yID]  = object LINE(!start, !end)
    enddo
  enddo

  -- Return
  return !lines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beams
--
-- Description: Return array of beam information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Elevation for beams
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array of X lines and Y lines
--
------------------------------------------------------------------------

define method .beams(!elevation is REAL) is ARRAY

  -- Initialise Variables
  !xLines         = ARRAY()
  !yLines         = ARRAY()
  !grid           = !this.grid
  !grid.position  = !grid.position.offset(U, !elevation)

  !xMax           = !this.columnXSpacings.size()
  !yMax           = !this.columnYSpacings.size()

  -- Get X/Y beam lines
  do !x from 0 to !xMax
    !xID    = !x + 1
    do !y from 0 to !yMax
      !yID  = !y + 1
      !start                = !grid.gridPoint(!x, !y)
      if(!y.lt(!yMax)) then
        !end                = !grid.gridPoint(!x, !yID)
        !xLines[!xID][!yID] = object LINE(!start, !end)
      endif
      if(!x.lt(!xMax)) then
        !end                = !grid.gridPoint(!xID, !y)
        !yLines[!yID][!xID] = object LINE(!start, !end)
      endif
    enddo
  enddo

  -- Return
  !lines[1] = !xLines
  !lines[2] = !yLines
  !!lines   = !lines
  return !lines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     resolveAccesses
--
-- Description: Resolve the access into the STRTWR so they are on the boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resolveAccesses()

  -- Initialise Variables
  !xMax       = !this.columnXSpacings.size()
  !yMax       = !this.columnYSpacings.size()

  -- Determine the outer faces of the stair tower
  !pos[1]     = !this.grid.gridPoint(0, 0)
  !pos[2]     = !this.grid.gridPoint(!xMax, 0)
  !pos[3]     = !this.grid.gridPoint(!xMax, !yMax)
  !pos[4]     = !this.grid.gridPoint(0, !yMax)

  !pv[1]      = object POINTVECTOR(!pos[1], !this.plane.orientation.yDir())
  !pv[2]      = object POINTVECTOR(!pos[2], !this.plane.orientation.xDir().opposite())
  !pv[3]      = object POINTVECTOR(!pos[3], !this.plane.orientation.yDir().opposite())
  !pv[4]      = object POINTVECTOR(!pos[4], !this.plane.orientation.xDir())

  -- Loop through the access and move to the outer most faces
  do !i indices !this.accessPoints
    !direction    = !this.accessPoints[!i].direction()

    -- Get direction (Entry/Both Y into STRTWR, Exit Y out of STRTWR)
    if(!this.accessPoints[!i].accessType.eq('EXIT')) then
      !direction  = !direction.opposite()
    endif

    do !j indices !pv
      -- Check if access point is in the same direction as one of the tower faces
      if(!pv[!j].direction.angle(!direction).lt(1)) then
        !plane    = !pv[!j].plane()
        !position = !pv[!j].plane().near(!this.accessPoints[!i].position)
        !distance = !position.distance(!this.accessPoints[!i].position)

        -- Modify access point
        if(!distance.neq(0)) then
          !offDir = !position.direction(!this.accessPoints[!i].position)
          !this.accessPoints[!i].offset(!offDir.opposite(), !distance)
          break
        endif
      endif
    enddo

    -- Set the elevation of the access point (if reference level is set)
    if(!this.accessPoints[!i].refLevel.set()) then
      !this.accessLevel(!i, !this.accessPoints[!i].refLevel)
    endif
  enddo

  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     updateDBElement
--
-- Description: Update STRTWR database element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if updated successfully
--
------------------------------------------------------------------------

define method .updateDBElement() is BOOLEAN

  -- Initialise Variables

  -- Check element defined
  if(!this.new) then
    !this.errorState  = true
    !this.errorText   = 'No element to modify.'
    !this.errorList.clear()
    return false
  endif

  -- Modify Element
  !this.dbElement.position        = !this.plane.position
  !this.dbElement.orientation     = !this.plane.orientation
  if(!this.columnXSpacings.set()) then
    !this.dbElement.colXSpacing   = !this.columnXSpacings
  endif
  if(!this.columnYSpacings.set()) then
    !this.dbElement.colYSpacing   = !this.columnYSpacings
  endif
  if(!this.fltclXSpacings.set()) then
    !this.dbElement.fclXSpacing   = !this.fltclXSpacings
  endif
  if(!this.fltclYSpacings.set()) then
    !this.dbElement.fclYSpacing   = !this.fltclYSpacings
  endif
  if(!this.landingLevels.set()) then
    !this.dbElement.lndLevels     = !this.landingLevels
  endif
  if(!this.beamLevels.set()) then
    !this.dbElement.bmLevels      = !this.beamLevels
  endif
  !this.dbElement.clBaseOffset    = !this.columnBase

  -- Non-geometrical information
  !this.dbElement.description     = !this.description
  !this.dbElement.function        = !this.function
  !this.dbElement.purpose         = !this.purpose
  !this.dbElement.area            = !this.area
  !this.dbElement.number          = !this.number
  if(!this.materialRef.set()) then
    !this.dbElement.matref        = !this.materialRef
  endif
  !this.dbElement.strcon          = !this.configuration
  !this.dbElement.strstd          = !this.standard
  !this.dbElement.intsen          = !this.sense
  --!this.dbElement.fireRating      = '$!this.fireRating'
  !this.dbElement.firesistance    = !this.fireResistance

  -- Reference data
  !this.dbElement.thickness       = !this.thickness
  !this.dbElement.tWidth          = !this.treadWidth
  !this.dbElement.headroom        = !this.headroom
  !this.dbElement.headClearance   = !this.headClearance
  !this.dbElement.fThickness      = !this.flightThickness
  !this.dbElement.opHeight        = !this.height
  !this.dbElement.opWidth         = !this.width
  !this.dbElement.opLength        = !this.length
  if(!this.criteriaRefs.set()) then
    !this.dbElement.dcrfarray     = !this.criteriaRefs
  endif
  !this.dbElement.laboffset       = !this.labelOffset

  -- Modify access points for the stair tower
  !this.modifyAccessDefinition()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     modifyAccessDefinition
--
-- Description: Modify STRTWR definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if updated successfully
--
------------------------------------------------------------------------

define method .modifyAccessDefinition() is BOOLEAN

  -- Initialise Variables


  -- Need to handle addition and deletions of access points for the element

  -- Update any access points
  do !i indices !this.accessPoints
    !this.accessPoints[!i].modifyDefinition()
  enddo

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     columnStore
--
-- Description: Get column store (only returns first if there are more than one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Column store
--
------------------------------------------------------------------------

define method .columnStore() is DBREF

  -- Check if DB Element define
  if(!this.dbElement.unset()) then
    return object DBREF()
  endif

  -- Get column storage areas
  !collection = object COLLECTION()
  !collection.type('TWRSTL')
  !collection.scope(!this.dbElement)
  !collection.filter(object EXPRESSION('PURP eq ''ASLA'' and FUNC eq ''Columns'''))
  !columns    = !collection.results()

  -- Column store found
  if(!columns.set()) then
    !store    = !columns[1]
  else
    !store    = object DBREF()
  endif

  -- Return
  return !store

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beamStore
--
-- Description: Get beam store for specific level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Beam store
--
------------------------------------------------------------------------

define method .beamStore(!level is REAL) is DBREF

  -- Check if DB Element define
  if(!this.dbElement.unset()) then
    return object DBREF()
  endif

  -- Get column storage areas
  !collection = object COLLECTION()
  !collection.type('TWRSTL')
  !collection.scope(!this.dbElement)
  !collection.filter(object EXPRESSION('PURP eq ''ASLA'' and FUNC eq ''Beams'' and NUMB eq ' & !level))
  !beams      = !collection.results()

  -- Column store found
  if(!beams.set()) then
    !store    = !beams[1]
  else
    !store    = object DBREF()
  endif

  -- Return
  return !store

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     beamStores
--
-- Description: Get all beam stores
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of all stores
--
------------------------------------------------------------------------

define method .beamStores() is ARRAY

  -- Check if DB Element define
  if(!this.dbElement.unset()) then
    return object DBREF()
  endif

  -- Get column storage areas
  !collection = object COLLECTION()
  !collection.type('TWRSTL')
  !collection.scope(!this.dbElement)
  !collection.filter(object EXPRESSION('PURP eq ''ASLA'' and FUNC eq ''Beams'''))
  !beams      = !collection.results()

  -- Column store found
  if(!beams.set()) then
    !stores   = !beams
  else
    !stores   = ARRAY()
  endif

  -- Return
  return !stores

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createStore
--
-- Description: Create steelwork storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of storage area
--    2   R      REAL        Level (0 for columns)
-- Return:
--   [Data Type] [Description]
--    DBREF       TWRSTL created
--
------------------------------------------------------------------------

define method .createStore(!type is STRING, !level is REAL) is DBREF

  -- Initialise Variables
  !reference  = !!ce

  -- Capitalise type
  !function   = !type.substring(1,1).upcase() & !type.substring(2).lowcase()

  -- Navigate to stair tower
  !!ce        = !this.dbElement
  last member
  handle ANY
  endhandle

  -- Create TWRSTL
  NEW TWRSTL
  !element          = !!ce
  !element.purpose  = 'ASLA'
  !element.function = !function
  !element.number   = !level

  -- Name element
  if(!this.dbElement.isNamed) then
    call !!autoNameCe(false)
  endif

  -- Return
  !!ce        = !reference
  return !element

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     updateSections
--
-- Description: Update steelwork for stair tower
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if completed
--
------------------------------------------------------------------------

define method .updateSections() is BOOLEAN

  -- Initialise Variables
  !reference          = !!ce
  !this.errorState    = false
  !this.errorText     = STRING()
  !this.errorList.clear()

  -- Check there is a dbElement to create the sections beneath
  if(!this.dbElement.unset()) then
    !this.errorText   = 'No stair tower element defined.'
    !this.errorState  = true
    return false
  endif

  -- Get current storage areas
  !columnStore        = !this.columnStore()

  -- If there is no storage area, then create one
  if(!columnStore.unset()) then
    !columnStore      = !this.createStore('Columns', 0)
  endif

  -- Update column definitions
  !columnList = !this.columns()

  -- Check columns against held columns
  !columns    = ARRAY()
  !index      = 0
  do !x indices !columnList
    do !y indices !columnList[!x]
      !index  = !index + 1
      !columns[!index]  = !columnList[!x][!y]
    enddo
  enddo

  -- Update columns with new definitions
  !this.updateSections(!columnStore, !columns)

  -- Update beam definitions
  !beamLevels = !this.beamStores()

  -- Beam levels not the same as the beam stores
  if(!beamLevels.size().neq(!this.beamLevels.size())) then
    !this.errorList.append('Number of beam store levels (' & !beamLevels.size() & ') and defined levels (' & !this.beamLevels.size() & ') are different.')
    !this.errorState      = true
  endif

  -- Loop through the levels
  do !l indices !this.beamLevels

    -- Get beam store
    !beamStore  = !this.beamStore(!l)
    !beamList   = !this.beams(!this.beamLevels[!l])

    -- Update beam level
    if(!beamStore.set()) then
      !beams      = ARRAY()
      !index      = 0

      do !i indices !beamList
        do !x indices !beamList [!i]
          do !y indices !beamList [!i][!x]
            !index  = !index + 1
            !beams[!index]  = !beamList[!i][!x][!y]
          enddo
        enddo
      enddo

      -- Update beams with new definitions
      !this.updateSections(!beamStore, !beams)

    -- No store area found for level
    else
      !beamY  = !this.plane.orientation.zDir()
      !store  = !this.createStore('Beams', !l)
      !!ce    = !store

      do !i indices !beamList
        do !x indices !beamList[!i]
          do !y indices !beamList[!i][!x]
            !index  = !index + 1
            !this.newSection(!beamList[!i][!x][!y], !this.beamSpref, !this.beamJusline, 0, !beamY, !index)
          enddo
        enddo
      enddo

      !this.errorList.append('No storage are for beam level ' & !l & '.')
      !this.errorState  = true
    endif

  enddo


  -- Return
  return !this.errorState.not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     updateSections
--
-- Description: Update sections in the passed store with the new definitions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Store area
--    2   R      ARRAY       Array of lines defining sections
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if completed
--
------------------------------------------------------------------------

define method .updateSections(!store is DBREF, !sections is ARRAY) is BOOLEAN

  -- Initialise Variables
  !state  = true

  -- Derived sections and number of stored are the same, then update them
  if(!sections.size().eq(!store.mCount)) then

    -- Modify the section within the store (index is held by the NUMB attribute)
    do !i indices !sections
      if(!this.modifySection(!store, !i, !sections[!i]).not()) then
        !this.errorList.append('Unable to modify section ' & !i & ' of stair tower (' & !this.errorText & ')')
        !this.errorState  = true
        !state            = false
      endif
    enddo

  -- Derived sections and number of stored are different.
  else
    !this.errorList.append('Number of derived section (' & !sections.size() & ') and stored (' & !store.mCount & ') are different.')
    !this.errorState      = true
    !state                = false
  endif

  -- Return
  return !state

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createSections
--
-- Description: Create steelwork for stair tower
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if completed
--
------------------------------------------------------------------------

define method .createSections() is BOOLEAN

  -- Initialise Variables
  !reference          = !!ce
  !this.errorState    = false
  !this.errorText     = STRING()
  !this.errorList.clear()

  -- Check there is a dbElement to create the sections beneath
  if(!this.dbElement.unset()) then
    !this.errorText   = 'No stair tower element defined.'
    !this.errorState  = true
    return false
  endif

  -- Navigate to storage area
  !!ce        = !this.dbElement

  -- Remove any existing TWRSTL elements created by the application previously
  !collection = object COLLECTION()
  !collection.scope(!this.dbElement)
  !collection.type('TWRSTL')
  !collection.filter(object EXPRESSION('PURP eq ''ASLA'''))
  !storageAreas = !collection.results()

  -- Delete any existing TWRSTL areas for the stair tower
  do !i indices !storageAreas
    !!ce      = !storageAreas[!i]
    DELETE TWRSTL
    handle ANY
      !this.errorList.append('Unable to delete ' & !storageAreas[!i] & '(' & !!error.text & ').')
      !this.errorState  = true
      skip
    endhandle
  enddo

  -- Y direction
  !columnY    = !this.plane.orientation.yDir()
  !beamY      = !this.plane.orientation.zDir()

  -- Create columns
  !index      = 0
  !store      = !this.createStore('Columns', 0)
  !!ce        = !store

  !columns    = !this.columns()

  do !x indices !columns
    do !y indices !columns[!x]
      !index  = !index + 1
      !this.newSection(!columns[!x][!y], !this.columnSpref, !this.columnJusline, !this.columnBangle, !columnY, !index)
    enddo
  enddo

  -- Create Beams
  do !l indices !this.beamLevels
    !index  = 0
    !beams  = !this.beams(!this.beamLevels[!l])

    !store  = !this.createStore('Beams', !l)
    !!ce    = !store

    do !i indices !beams
      do !x indices !beams[!i]
        do !y indices !beams[!i][!x]
          !index  = !index + 1
          !this.newSection(!beams[!i][!x][!y], !this.beamSpref, !this.beamJusline, 0, !beamY, !index)
        enddo
      enddo
    enddo
  enddo

  -- Return to origin place
  !!ce        = !reference
  handle ANY
    !!ce      = !this.dbElement
  endhandle

  -- Return
  return !this.errorState.not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     newSection
--
-- Description: Create a new section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Line definition of section
--    2   R      DBREF       Catalogue profile
--    3   R      STRING      Justification
--    4   R      REAL        Beta Angle
--    5   R      DIRECTION   Y direction of profile
--    6   R      REAL        Identifier index (number)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created
--
------------------------------------------------------------------------

define method .newSection(!line is LINE, !spref is DBREF, !jusLine is STRING, !bAngle is REAL, !yDirection is DIRECTION, !identifier is REAL) is BOOLEAN

  -- Define section
  NEW GENSEC
  if(!spref.set()) then
    !!ce.spref      = !spref
    !!ce.gtype      = !!ce.icoTyp
    if(!jusLine.set()) then
      !!ce.jusLine  = !jusLine
    endif
  endif
  !!ce.bAngle       = !bAngle
  !!ce.position     = !line.startPosition
  !!ce.number       = !identifier

  -- Define spine
  NEW SPINE
  !!ce.yDirection   = !yDirection
  NEW POINSP
  NEW POINSP
  !!ce.position     = !line.endPosition

  -- Set end cutplanes
  GENSEC
  DRNS PERP DRNE PERP

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     modifySection
--
-- Description: Modify the passed section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Store to look for section
--    2   R      REAL        Index (NUMB)
--    3   R      LINE        New definition of section
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modified
--
------------------------------------------------------------------------

define method .modifySection(!store is DBREF, !index is REAL, !line is LINE) is BOOLEAN

  -- Initialise Variables
  !reference        = !!ce

  -- Find section
  !collection       = object COLLECTION()
  !collection.scope(!store)
  !collection.filter(object EXPRESSION('TYPE eq ''GENSEC'' and NUMB eq ' & !index))
  !sections         = !collection.results()

  -- Check for selection
  if(!sections.empty()) then
    !this.errorText = 'No section found of passed index [' & !index & ']'
    return false
  endif

  -- Modify section
  !section          = !sections.first()
  !!ce              = !section
  !section.position = !line.startPosition

  SPINE 1
  POINSP 1
  AT N0
  POINSP 2
  !!ce.position     = !line.endPosition

  -- Return
  !!ce              = !reference
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessLevel
--
-- Description: Change access level to passed floor level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Access point index
--    2   R      STRING      Access type, ENTRY, EXIT or BOTH
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True of updated
--
------------------------------------------------------------------------

define method .accessType(!index is REAL, !type is STRING) is BOOLEAN

  -- Change access type
  !updated = !this.accessPoints[!index].accessTypeFlip(!type)

  -- Redraw
  if(!updated) then
    !this.draw()
  endif

  -- Return
  return !updated

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     accessLevel
--
-- Description: Set the elevation of the access point to elevation of the passed landing level (maintains XY offset)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Access point index
--    2   R      REAL        Landing level
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if elevation changed
--
------------------------------------------------------------------------

define method .accessLevel(!index is REAL, !level is REAL) is BOOLEAN

  -- Initialise Variables

  -- Check landing level exists
  if(undefined(!this.landingLevels[!level])) then
    !!error.text  = 'Landing level ' & !level.string('I') & ' does not exist.'
    return false
  endif

  !elevation      = !this.landingLevels[!level]

  -- Get plane for landing
  !plane          = !this.plane
  !plane.position = !plane.position.offset(U, !elevation)
  !position       = !plane.near(!this.accessPoints[!index].position)

  -- Update access point position
  !this.accessPoints[!index].position(!position)
  !this.accessPoints[!index].refLevel(!level)

  -- Redraw
  !this.draw()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     test
--
-- Description: Test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .test()

  -- Load aid numbers (numbers should be derived from AIDNUMBRS global object)
  !number   = 1
  !steel    = 2
  !access   = 3
  !landing  = 4
  !this.aidNumbers(!number, !steel, !access, !landing)

  -- Section profiles
  -- /BS-SPEC/610x229x101kg/m
  !this.columnDefinition(/BS-SPEC/305x305x118kg/m , 'NA', 0)
  !this.beamDefinition(/BS-SPEC/406x178x74kg/m , 'TOS')

 return
  -- Set position
  !this.position(N0)

  -- Set direction
  !this.direction(N)

  -- Define beam elevations
  !elevations   = ARRAY()
  !elevations.append(0)
  !elevations.append(3000)
  !elevations.append(6000)
  !elevations.append(9000)
  !elevations.append(12000)
  !elevations.append(15000)
  !this.beamLevels(!elevations)

  -- Define spacings
  !xSpacings    = ARRAY()
  !xSpacings.append(4000)
  !ySpacings    = ARRAY()
  !ySpacings.append(6000)
  !this.columnSpacings(!xSpacings, !ySpacings)

  -- Column base offset
  !this.columnBase(-500)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     query
--
-- Description: Display query data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .query()


  write '------------------------------------------'
  write 'attributes()'
  QUERY VAR !this

endmethod
-- End of method
