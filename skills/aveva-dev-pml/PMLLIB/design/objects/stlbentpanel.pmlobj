------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Highlight bent planel edges as a series of aid boxes
--              to give a thick line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

	if( !this.debug)then
		write '+Enter .display()'
	endif

  !!aidNumbers.hide(!this.aidTag)
  !profile  = !this.calculateExtrusion()
  if(!profile.unset()) then
  	if( !this.debug)then
		  write '-Leave .display() - !profile.unset()'
	  endif
    return
  endif
  -- draw one edge of bent panel
  !this.display(!profile)

  -- display arrow normal to profile at its origin
  !arrow             = object GPHAXES(!profile.position, !profile.orientation)
  !arrow.height      = min( 20mm, !this.thickness * 3 )
  !arrow.draw(!this.aidTag, false)
  !endPlane          = !this.plane()
  !endPlane.position = !this.bendLine.endPosition

  !edges             = !profile.edges()
  do !index indices !edges
    skip if(!edges[!index].objectType() neq 'LINE')
    !line = object LINE(!edges[!index].startPosition, !endPlane.near(!edges[!index].startPosition))
    !line.draw(!this.aidTag, !this.style, !this.colour)
    !line = object LINE(!edges[!index].endPosition, !endPlane.near(!edges[!index].endPosition))
    !line.draw(!this.aidTag, !this.style, !this.colour)
  enddo

  -- draw other edge of bent panel
  -- project profile origin onto end plane
  !profile.position = !endPlane.near(!profile.position)
  !this.display(!profile)

  -- draw aids indicating current trailing edge
  -- middle of panel
  if( !this.vertexPosition.size() gt 1 ) then
    !aidSize = !this.thickness * 3
    !pos     = !this.vertexPosition.last()
    !posAlt  = !endPlane.near(!this.vertexPosition.last())
    AID TRANSL 50	
    AID SPHERE NUMBER $!<this.aidTag> $!<pos>    DIAM $!<aidSize>
    AID SPHERE NUMBER $!<this.aidTag> $!<posAlt> DIAM $!<aidSize>
    AID TRANSL 0
  endif

  if( !this.debug)then
		write '-Leave .display()'
	endif
	
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Highlight selected profile as a series of aid boxes
--              to give a thick line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     Profile to draw
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!drawProfile is PROFILE)

  -- get chordal approximation to profile
  !profile         = !drawProfile.mergePoints().mergeLines().polyline()
  handle(2,785)
    -- Invalid profile cannot be drawn
    return
  endhandle
  !boxSize         = !this.thickness / 6
  !boxSize         = !boxSize.min(6mm)
  !profileZDir     = !profile.orientation.zDir()

  -- for each chords edge show an aid box
  !gBox            = object GMFBOX()
  !gBox.xLength    = !boxSize
  !gBox.yLength    = !boxSize
  do !edge values !profile.edges()
    !length        = !edge.length()
    skip if(!length lt 0.1mm)
    !midPoint      = !edge.proportion(0.5)
    !boxDir        = !edge.direction()
    !orientation   = object ORIENTATION('Y IS $!<profileZDir> AND Z IS $!<boxDir>')
    !gBox.zLength  = !length
    !gBox.position = !midPoint
    !gBox.orientation = !orientation
    !graphBox      = object GPHBOX(!gBox)
    !graphBox.filled(!this.fill)
    !graphBox.draw(!this.aidTag, false)
  enddo

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getGeneratorObjects
--
-- Description: Return array of objects (Planes & Panels) used
