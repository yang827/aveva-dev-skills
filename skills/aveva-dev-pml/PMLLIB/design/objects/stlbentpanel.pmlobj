--
------------------------------------------------------------------------

define method .getGeneratorObjects() is ARRAY

  return !this.originalData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isTrimmed
--
-- Description: True if last object used to trim curve.
--              False if last object used as part of curve.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True = trimmed   False = included
--
------------------------------------------------------------------------

define method .isTrimmed() is BOOLEAN

  return !this.lastLegTrimmed

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !!aidNumbers.hide(!this.aidTag)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isBPanelType
--
-- Description: Check if bent plate should be represented as BPANEL object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String representation of plate data type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Is BPANEL type
------------------------------------------------------------------------

define method .isBPanelType(!type is STRING) is BOOLEAN

	!bBPanelType = false
	if( !type eq 'BPANEL' ) then
		!bBPanelType = true
	endif
	
	return !bBPanelType
	
endmethod
-- End of method
