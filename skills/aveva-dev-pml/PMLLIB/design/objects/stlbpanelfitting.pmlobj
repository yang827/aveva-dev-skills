------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copyAttsFromPfit(DBREF,DBREF)    BOOLEAN             Copy attributes from a PFIT to a BPFITT
--  copyAttsToPfit(DBREF,DBREF)      BOOLEAN             Copy attributes from a BPFITT to a PFIT
--  copyFromPfit(DBREF,DBREF)        DBREF               Create a new BPFITT from a PFIT
--  copyToPfit(DBREF,DBREF)          DBREF               Create a new PFIT from a BPFITT
--  getOwner(DBREF)                  DBREF               Get or create a BPFEAT given a BPANEL
--  getSjust(STRING)                 STRING              Translate BPFITT.wjusline to PFIT.sjust
--  getWjusline(STRING)              STRING              Translate PFIT.sjust to BPFITT.wjusline
--  setPos(DBREF,POSITION)           BOOLEAN             Set position on a BPFITT
--  stlbpanelfitting()               -
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
-- Define object
define object STLBPANELFITTING

  -- Debug flag
  member .debug            is BOOLEAN

endobject
-- End of object definition for stlBpanelFitting

------------------------------------------------------------------------
--
-- Method:      stlBpanelFitting
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlbpanelfitting()

  !this.debug = false
  if (defined(!!debug) ) then
    !this.debug = true
  endif

endmethod
-- End of method definition for .stlBentPanel()

------------------------------------------------------------------------
--
-- Method:      copyFromPfit
--
-- Description: Copies PFIT to a new BPFITT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       PFIT to be copied
--    2   R      DBREF       Target BPANEL or BPFEAT

-- Return:
--   [Data Type] [Description]
--    DBREF       Resulting BPFITT
--
------------------------------------------------------------------------
define method .copyFromPfit(!pfit is DBREF, !target is DBREF) is DBREF

   if(!this.debug)then
		write |+Enter .copyFromPfit()|
	 endif
	
	 !result = object DBREF()
	 !owner  = object DBREF()
	
	 -- Check if PFIT exists
	 if( badref(!pfit) ) then
	   return !result
	 -- Check type
	 elseif( !pfit.type neq 'PFIT') then
	 	 return !result
	 endif
	
	 -- Check target BPANEL
	 if( badref(!target)) then
	 	 return !result
	 elseif( (!target.type neq 'BPANEL') and (!target.type neq 'BPFEAT') ) then
	 	 return !result
	 endif
	
	 -- Find out owner
	 if( !target.type eq 'BPFEAT') then
	 	 !owner = !target
	 else
	 	 -- Get BPFEAT of BPANEL
	 	 !owner = !this.getOwner( !target)
	 endif
	 if( badref(!owner)) then
	 	 return !result
	 endif
	
	 -- Create new BPFITT
	 !!ce = !owner
	 NEW BPFITT
	 !result = !!ce

	 -- Copy attributes from PFIT
	 !bRes = !this.copyAttsFromPfit( !pfit, !result)
	 if( !bRes.not() ) then
	 	 !result = object DBREF()
	 endif
	
	 if(!this.debug)then
		write '-Leave .copyFromPfit() - $!result'
	 endif
	
	 return !result
	
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyToPfit
--
-- Description: Copies BPFITT to a new PFIT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BPFITT to be copied
--    2   R      DBREF       Target PANEL

-- Return:
--   [Data Type] [Description]
--    DBREF       Resulting BPFITT
--
------------------------------------------------------------------------
define method .copyToPfit(!bpfitt is DBREF, !target is DBREF) is DBREF

  if(!this.debug)then
		write |+Enter .copyToPfit()|
	endif
	
	!result = object DBREF()
	!owner  = object DBREF()
	
	-- Check if BPFITT exists
	if( badref(!bpfitt) ) then
	  return !result
	-- Check type
	elseif( !bpfitt.type neq 'BPFITT') then
	  return !result
	endif
	
	-- Check target PANE
	if( badref(!target)) then
	  return !result
	elseif( !target.type neq 'PANE' ) then
	  return !result
	else
	  !owner = !target
	endif
	
	-- Create new PFIT
	!!ce = !owner
	NEW PFIT
	!result = !!ce
	
	-- Copy attributes from BPFITT
	!bRes = !this.copyAttsToPfit( !bpfitt, !result)
	if( !bRes.not() ) then
	  !result = object DBREF()
	endif
	
	if(!this.debug)then
		write '-Leave .copyToPfit() - $!result'
	endif
	
	return !result
	
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOwner
--
-- Description: Get first available BPFEAT element in a BPANEL.
-- If no BPFEAT is available, create a new.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BPANEL reference

-- Return:
--   [Data Type] [Description]
--    DBREF       Resulting BPFEAT
--
------------------------------------------------------------------------
define method .getOwner(!bpanel is DBREF) is DBREF

  !result = object DBREF()

  -- Check if BPANEL exists
  if( badref(!bpanel)) then
  	return !result
  endif
  -- Check type
  if( !bpanel.type neq 'BPANEL') then
    return !result
  endif

  -- Look for existing BPFEAT
  !collect = object COLLECTION()
  !collect.scope(!bpanel)
  !collect.type('BPFEAT')
  if(!collect.results().size() gt 0) then
  	-- Found existing BPFEAT
  	!result = !collect.results()[1]	
  else
  	-- Create a new BPFEAT
  	!!ce = !bpanel
    NEW BPFEAT
    !result = !!ce
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getWjusline
--
-- Description: Translate PFIT sjust to BPFITT wjusline
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       SJUST from PFIT

-- Return:
--   [Data Type] [Description]
--    STRING     WJUSLIN
--
------------------------------------------------------------------------
define method .getWjusline(!sjust is STRING) is STRING

	!wjusline = 'CENT'
	
	if( !sjust eq 'UTOP' or !sjust eq 'DTOP') then
    !wjusline = 'RIGH'
  elseif( !sjust eq 'DBOT' or !sjust eq 'UBOT' ) then
    !wjusline = 'LEFT'
  endif

  return ( !wjusline )

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSjust
--
-- Description: Translate BPFITT wjusline to PFIT sjust
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       WJUSLINE from BPFITT

-- Return:
--   [Data Type] [Description]
--    STRING     SJUST
--
------------------------------------------------------------------------
define method .getSjust(!wjusline is STRING) is STRING
	
	!sjust = 'UCENT'
	
	if(!wjusline eq 'RIGH') then
		!sjust = 'UTOP'
	elseif(!wjusline eq 'LEFT') then
		!sjust = 'DBOT'
	endif
	
	return !sjust
	
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPos
--
-- Description: Set position on BPFITT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BPFITT
--    2   R      DBREF       POSITION

-- Return:
--   [Data Type] [Description]
--    BOOLEAN     No errors
--
------------------------------------------------------------------------
define method .setPos(!bpfitt is DBREF, !pos is POSITION) is BOOLEAN
  if(!this.debug)then
		write |+Enter .setPos()|
	endif
	
	--Check
	if( badref(!bpfitt)) then
		return false
  -- Check type
	elseif( !bpfitt.type neq 'BPFITT') then
	 	 return false
	endif
	
	-- Calculate position on bentplate
	!plane = object PLANE()
	-- This will load the BPANEL into !owner
  !owner  = !!dtbOwnerOfType(!bpfitt, 'BPFEAT')
  !plane.position = !owner.position.wrt(World)
  !plane.orientation = !owner.orientation.wrt(World)

  !path = RPATH 1 of $!owner
  if( badref(!path)) then
  	return false
  endif
  !rPath = object RPATHPOSITIONING( !path)
  !position = !plane.near( !pos)
  !rPath.setPositionNear(!position, false)

  !bpfitt.zdist = !rPath.zDistance
  !bpfitt.vdist = !position.distance(!pos )
  !bpfitt.posref = !rPath.referencePoint
	
	if(!this.debug)then
		write '-Leave .setPos()'
	endif
	
	return true
	
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyAttsFromPfit
--
-- Description: Copy PFIT attributes to BPFITT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       PFIT
--    2   R      DBREF       BPFITT

-- Return:
--   [Data Type] [Description]
--    BOOLEAN     No errors
--
------------------------------------------------------------------------
define method .copyAttsFromPfit(!pfit is DBREF, !bpfitt is DBREF) is BOOLEAN

  if(!this.debug)then
		write |+Enter .copyAttsFromPfit()|
	endif
	
	-- Check pfit
	if( badref(!pfit)) then
		return false
	endif
	-- Check bpfitt
	if( badref(!bpfitt)) then
		return false
	endif
	
	!bpfitt.spref  = !pfit.spref
	!bpfitt.desp   = !pfit.desp
	!bpfitt.wjusl  = !this.getWjusline( !pfit.sjust)
	!bpfitt.purp   = !pfit.purp
	!bpfitt.desc   = !pfit.desc
	!bpfitt.func   = !pfit.func

  if( !this.setPos( !bpfitt, !pfit.pos).not()) then
  	return false
  endif
	
	if(!this.debug)then
		write '-Leave .copyAttsFromPfit()'
	endif
	
	return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyAttsToPfit
--
-- Description: Copy BPFITT attributes to PFIT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BPFITT
--    2   R      DBREF       PFIT

-- Return:
--   [Data Type] [Description]
--    BOOLEAN     No errors
--
------------------------------------------------------------------------
define method .copyAttsToPfit(!bpfitt is DBREF, !pfit is DBREF) is BOOLEAN

  if(!this.debug)then
		write |+Enter .copyAttsToPfit()|
	endif
	
	-- Check bpfitt
	if( badref(!bpfitt)) then
		return false
	endif
	-- Check pfit
	if( badref(!pfit)) then
		return false
	endif
	
	!pfit.spref  = !bpfitt.spref
	!pfit.desp   = !bpfitt.desp
	!pfit.sjust  = !this.getSjust( !bpfitt.wjusl)
	!pfit.purp   = !bpfitt.purp
	!pfit.desc   = !bpfitt.desc
	!pfit.func   = !bpfitt.func
	!pfit.pos    = !bpfitt.pos
	
	if(!this.debug)then
		write '-Leave .copyAttsToPfit()'
	endif
	
	return true
endmethod
-- End of method
