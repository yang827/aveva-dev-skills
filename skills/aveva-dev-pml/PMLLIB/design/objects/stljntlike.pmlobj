--   Group:         Design structures
--     Keyword:     Section connection
--   Module:        Design
--   Replaces:
--
-- Author:          jenni.hennings
-- Created:
--
-- Description:
--    Steelwork joint like object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copyPick(ANY)                    BOOLEAN             Pick the joint to be copied
--  likePick(ANY)                    BOOLEAN             Pick the joint to be modified like the previous joint
--  likePickUndo(ANY)                BOOLEAN             Implement UNDO for LIKE PICK
--  resetPick()                      -                   Start again with the joint identification pick
--  setup(BOOLEAN)                   -                   Load the EDG Pick for the Dominant section
--  stlJntLike()                     -                   Object constructor
--

define object STLJNTLIKE

  -- Dominant or subordinate
  member .state is STRING

  -- Connection manager
  member .manager is SECTIONCONNECTIONMANAGER

  -- Packets for selection
  member .copyPacket is EDGPACKET
  member .likePacket is EDGPACKET

  -- Arrays of selections
  member .ends is ARRAY

  -- Arguments
  member .mode is BOOLEAN
  member .end is STRING

  -- Section and joint data
  member .osctn is DBREF
  member .tsctn is DBREF
  member .posctn is DBREF
  member .ptsctn is DBREF
  member .oend is STRING
  member .tend is STRING
  member .ojoin is DBREF
  member .tjoin is DBREF
  member .ojlin is STRING
  member .tjlin is STRING
  member .bang is REAL
  member .asctn is DBREF
  member .attsctn is STRING

  member .poss is POSITION
  member .pose is POSITION
  member .ipos is POSITION

  member .asflg is BOOLEAN

  -- Reference element
  member .refe is DBREF

endobject
-- End of object definition

--------------------------------------------------------------------
--
-- Method:      stlJntLike
--
-- Description: Object constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--------------------------------------------------------------------
define method .stlJntLike()

  !this.osctn = object DBREF()
  !this.tsctn = object DBREF()
  !this.posctn =  object DBREF()
  !this.ptsctn =  object DBREF()
  !this.oend = ''
  !this.tend = ''
  !this.ojoin = object DBREF()
  !this.tjoin = object DBREF()
  !this.ojlin = ''
  !this.tjlin = ''
  !this.bang = 0.00
  !this.asctn = object DBREF()
  !this.attsctn = ''

  !this.poss = object POSITION()
  !this.pose = object POSITION()
  !this.ipos = object POSITION()

  !this.asflg = false

  !this.refe = !!ce

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Load the EDG Pick for the Dominant section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Maintain pline?
--
--------------------------------------------------------------------
define method .setup(!mode is BOOLEAN)

   !this.mode = !mode
   !this.refe = !!ce

   !this.osctn = object DBREF()
   !this.tsctn = object DBREF()

   !this.posctn = !this.osctn

   !prompt = 'Identify end of section to be copied like.'
   !this.copyPacket.pickpacket.stdGraphic(!prompt)
   !this.copyPacket.description  = 'Pick section end'
   !this.copyPacket.action       = '!!stlJLike.copyPick(!this.return)'
   !this.copyPacket.remove       = false
   !this.copyPacket.priority     = 0

   !!edgCntrl.add(!this.copyPacket)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      copyPick
--
-- Description: Pick the joint to be copied
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ANY         EDG Data
--
--------------------------------------------------------------------
define method .copyPick(!data is ANY) is BOOLEAN

  !pickData     = !data.last()
  !positionData = !pickData.positionData()
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
  endif

  -- Find appropriate end and check connected
  !chkArray = !this.manager.checkConnected(!position, !pickData.item)
  !bool     = !chkArray[1]
  !end      = !chkArray[2]

  !this.osctn = !pickData.item
  !this.oend  = !end

  if (!bool.not()) then
    !!alert.warning('Section $!end is not connected')
    return false
  endif

  if (!end.eq('START')) then
    !this.ojoin = !this.osctn.joistart
  elseif (!end.eq('END')) then
    !this.ojoin = !this.osctn.joiend
  endif

  !this.ojlin = !this.osctn.jusline

  !this.bang = !this.ojoin.bang
  handle any
  -- Fixings don't have bangs
  endhandle

  !this.asflg = true

  !softTypes = !!dtbSoftTypes.stringStypesFor('SCTN')
  !softTypes = !softTypes & !!dtbSoftTypes.stringStypesFor('GENSEC')

  !this.asctn = !!dtbgetownertype(!this.ojoin, !softTypes)
  handle ANY
     !this.asctn = NULREF
     !this.asflg = false
  endhandle
  -- if !this.asflg is false the system will create a primary joint (PNOD & PJOI)
  !this.asflg = !this.asctn.set()
  !this.ptsctn = !this.tsctn

  !prompt = 'Identify end of section to be modified.'
  !this.likePacket.pickpacket.stdGraphic(!prompt)
  !this.likePacket.description  = 'Pick section end'
  !this.likePacket.action       = '!!stlJLike.likePickUndo(!this.return)'
  !this.likePacket.escape       = '!!stlJLike.resetPick()'
  !this.likePacket.remove       = false
  !this.likePacket.priority     = 1

  !!edgCntrl.add(!this.likePacket)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      likePickUndo
--
-- Description: Implement UNDO for LIKE PICK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ANY         EDG Data
--
--------------------------------------------------------------------
define method .likePickUndo(!data is ANY) is BOOLEAN

  !undoLikePick = object UNDOABLE()
  !undoLikePick.description('Joint Like')
  !undoLikePick.add()

  !result = !this.likePick(!data)
  handle any
    !result = false
    !!alert.error(!!error.text)
  endhandle

  !undoLikePick.endUndoable()

  return !result

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      likePick
--
-- Description: Pick the joint to be modified like the previous joint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ANY         EDG Data
--
--------------------------------------------------------------------
define method .likePick(!data is ANY) is BOOLEAN

  !pickData     = !data.last()
  !positionData = !pickData.positionData()
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
  endif

  -- Find appropriate end and check connected
  !chkArray = !this.manager.checkConnected(!position, !pickData.item)
  !bool     = !chkArray[1]
  !end      = !chkArray[2]

  if( not !pickData.item.hardtype inset('SCTN','GENSEC') ) then
    !!alert.warning('Selected item is not a SCTN or GENSEC element')
    return false
  endif

  !this.tsctn = !pickData.item
  !this.tend  = !end

  if (!end.eq('START')) then
    !this.tjoin = !this.tsctn.joistart
  elseif (!end.eq('END')) then
    !this.tjoin = !this.tsctn.joiend
  endif

  !this.tjlin = !this.tsctn.jusline

  if (!this.osctn.eq(!this.tsctn) AND !this.oend.eq(!this.tend)) then
    !!alert.warning('Object and Target section ends can not be the same')
    return false
  endif

  if (!this.tjoin.set().not()) then
    if (!this.asflg) then
      !!runSynonym('CALLSTL DCLADAT SET')
      !this.attsctn = !this.asctn.string()
      var !!cdpapass delete
      !!cdpapass[1] = !this.attsctn
      !!runSynonym('CALLSTL DCLADAT OBST !!cdpapass')

      !!runSynonym('DESCLASH CHECK $!!stlJLike.tsctn EXIT')

      var !ccnt clash count all
      var !ccnt ($!ccnt A A A)
      if($!ccnt gt 0) then
        !this.poss = !this.attsctn.poss.wrt(world)
        !this.pose = !this.attsctn.pose.wrt(world)

        !curved = FALSE
        -- Check to see if we're at a straight section or not
        if (!this.attsctn.hardtype.eq(|GENSEC|)) then
          !!ce = !this.attsctn
          SPINE 1
          !spine = !!ce
          if (!spine.members.size().gt(2)) then
            !profile = object PROFILE(!spine)
            !curved = TRUE
          endif
        endif

        !line = object LINE(!this.poss, !this.pose)

        -- Intersection on profile if curved section
        if (!curved) then
          !this.ipos = !profile.intersections(!this.tjlin)[1]
        else
          !this.ipos = !line.intersection(!this.tjlin)
        endif

        !this.tjoin = !this.manager.newNode(!this.attsctn, !this.ipos, !this.attsctn.jusline)
        !!ce = !this.tjoin
        CREF $!this.tsctn $!this.tend
      else
        !!alert.warning('Section does not intersect the original section.')
        !!runSynonym('CALLSTL DCLADAT LOAD')
        return false
      endif
      !!runSynonym('CALLSTL DCLADAT LOAD')
    else
      !!runSynonym('CALLSTL MCRTPNOD $!<this.tsctn> $!<this.tend>')
      handle ANY
        !!alert.error(!!error.text)
        !this.tjoin = object DBREF()
        return false
      elsehandle NONE
        !this.tjoin = !!cdpnjoi.dbref()
        handle any
          !this.tjoin = object DBREF()
          return false
        endhandle
      endhandle
    endif
  endif

  if (!this.asflg) then
    !tposl = !this.tjoin.posl
    handle any
      !tposl = !this.tjoin.owner.posl
    endhandle
    if (!tposl eq '') then
      !tposl = !this.ojoin.posl
      handle any
        !tposl = !this.ojoin.owner.posl
      endhandle
    endif
    !this.tsctn.jusline = !this.ojlin
  endif

  !!ce = !this.tjoin

  -- COPY LIKE owner joint
  if( !this.ojoin.desparam.empty() ) then
    DESPAR UNSET
  else
    !this.tjoin.desparam = !this.ojoin.desparam
  endif
  if( badref(!this.ojoin.spref) ) then
    SPREF UNSET
  else
    !this.tjoin.spref = !this.ojoin.spref
  endif

  if (!this.asflg) then
    !this.tjoin.bang = !this.bang
    handle any
    -- Fixings don't have bangs
    endhandle
    !this.tjoin.jlin = !this.ojoin.jlin
    handle ANY
      !this.tjoin.jlin = 'NA'
    endhandle
    if (!this.tend.eq('START')) then
      !cutp = !this.tsctn.drns
    elseif (!this.tend.eq('END')) then
      !cutp = !this.tsctn.drne
    endif
    !this.tjoin.cutp = !cutp

    if (!this.mode) then
      if (!!ce.type.eq('SUBJ') or !!ce.type.eq('FIXING')) then
        !!ce = !!ce.owner
        !!ce.posl = !tposl
        handle any
          !!ce.posl = 'NA'
        endhandle
      else
        !this.tjoin.posl = !tposl
        handle any
          !this.tjoin.posl = 'NA'
        endhandle
      endif
    endif
  else
    if (!this.tend.eq('START')) then
      !cutp = !this.tsctn.drns
    elseif (!this.tend.eq('END')) then
      !cutp = !this.tsctn.drne
    endif
    !this.tjoin.cutp = !cutp
    !this.tjoin.opdir = !cutp
    handle ANY
    endhandle
  endif

  !!ce = !this.tjoin

  RECONN RECALC

  !!ce = !this.refe

  return true

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      resetPick
--
-- Description: Start again with the joint identification pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--------------------------------------------------------------------
define method .resetPick()

   !!edgCntrl.remove(!this.copyPacket)
   !mode = !this.mode
   !this.setup(!mode)

endmethod
-- End of method definition
