--   Module:        Design
--   Replaces:
--
-- Author:          jenni.hennings
-- Created:
--
-- Description:
--    Steelwork joint priority object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  endPick(ANY)                     BOOLEAN             Action on picking the end of a SCTN or GENSEC
--  setJoints()                      -                   Alter the JFREE attribute of the joint accordingly
--  setup(BOOLEAN,STRING)            -                   Setup the object and EDG pick
--  stlJointPriority()               -
--

define object STLJOINTPRIORITY

  -- Dominant or subordinate
  member .state is STRING

  -- Connection manager
  member .manager is SECTIONCONNECTIONMANAGER

  -- Packets for selection
  member .endPacket is EDGPACKET

  -- Arrays of selections
  member .ends is ARRAY

  -- Arguments
  member .mode is BOOLEAN
  member .end is STRING

  -- Feedback text
  member .fText is STRING

  -- Reference element
  member .refe is DBREF

  -- Jfree value
  member .jCheck is BOOLEAN

  -- aid number for this object
  member .aidNumber is REAL

  -- keep track of enhanced elements
  member .enhance is COMENHANCE

endobject
-- End of object definition

--------------------------------------------------------------------
--
-- Method:      stlJointPriority
--
-- Description: Object constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--------------------------------------------------------------------
define method .stlJointPriority()

  !this.end = ''
  !this.fText = ''
  !this.refe = !!ce
  !this.jCheck = false
  !this.aidNumber = !!aidNumbers.add('Steel joint priority')
  -- initialise enhance colour for this object
  !this.enhance.setColour(27)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup the object and EDG pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Dominant or subordinate
--    2   R      STRING      End of the section
--
--------------------------------------------------------------------
define method .setup(!mode is BOOLEAN, !end is STRING)

   !this.mode = !mode
   !this.end = !end

   if (!this.mode) then
    !endPrompt = 'Identify end of section, joint is to be made Dominant.'
    !this.fText = 'dominant.'
    !this.jCheck = FALSE
   else
    !endPrompt = 'Identify end of section to be made Subordinate.'
    !this.fText = 'subordinate.'
    !this.jCheck = TRUE
   endif

   !this.refe = !!ce

   if (!this.refe.type inset('GENSEC','SCTN') AND !this.end.neq('')) then

     if (!this.end.eq('START')) then
       !pos = !this.refe.posstart
     elseif (!this.end.eq('END')) then
       !pos = !this.refe.posend
     endif

     !jointDetails = !this.manager.checkConnected(!pos, !this.refe)
     -- true if section end is connected
     !bool = !jointDetails[1]

     if (!bool) then
       !jflg = false
       if (!this.end.eq('START')) then
        !joint = !this.refe.joistart
        !posend = !this.refe.posstart.wrt(world)
       elseif (!this.end.eq('END')) then
        !joint = !this.refe.joiend
        !posend = !this.refe.posend.wrt(world)
       endif
       -- check for bad joint reference
       if( badref(!joint) ) then
         !!alert.warning('Section $!end has a connection to a deleted or deferred joint')
       else
         !jflg = !joint.jfree
         if (!jflg.set().not()) then
          !joint.jfree = false
         endif
         if (!joint.jfree.neq(!this.jCheck)) then
          !!alert.warning('Joint is already ' & !this.fText)
         endif
       endif
     else
       !!alert.warning('Section $!end is not connected')
     endif

     -- Save section details
     !endDetails = ARRAY()
     !endDetails.append(!this.refe)
     !endDetails.append(!this.end)
     !endDetails.append(!joint)
     !endDetails.append(!posend)

     !this.ends.append(!endDetails)

     !this.setJoints()

   else

     !this.endPacket.pickpacket.stdGraphic(!endPrompt)
     !this.endPacket.description      = 'Pick section end'
     !this.endPacket.action           = '!!stlDomSub.endPick(!this.return)'
     !this.endPacket.escape           = '!!stlDomSub.setJoints()'
     !this.endPacket.remove           = false

     !!edgCntrl.add(!this.endPacket)

   endif

endmethod
-- End of method definition


--------------------------------------------------------------------
--
-- Method:      endPick
--
-- Description: Action on picking the end of a SCTN or GENSEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         EDG Data
--
--------------------------------------------------------------------
define method .endPick(!data is ANY) is BOOLEAN

  !pickData     = !data.last()
  !positionData = !pickData.positionData()
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
  endif

  -- Find appropriate end and check connected
  !chkArray = !this.manager.checkConnected(!position, !pickData.item)
  !bool     = !chkArray[1]
  !end      = !chkArray[2]

   if (!bool) then

     if (!end.eq(|START|)) then
      !joint = !pickData.item.joistart
      !posend = !pickData.item.posstart.wrt(world)
     elseif (!end.eq(|END|)) then
      !joint = !pickData.item.joiend
      !posend = !pickData.item.posend.wrt(world)
     endif

     !jflg = !joint.jfree
     -- Do not add joint to list if jfree already set to required
     if (!joint.jfree.set().not()) then
      !joint.jfree = false
     endif
     if (!joint.jfree.neq(!this.jCheck)) then
      !!alert.warning('Joint is already ' & !this.fText)
     else

      !this.enhance.addItem(!pickData.item)
      aid text number $!this.aidNumber '$!end' at $!<posend>

      !pickArray     = ARRAY()
      !pickArray.append(!pickData.item)
      !pickArray.append(!end)
      !pickArray.append(!joint)
      !pickArray.append(!posend)

      -- Check if section end has already been picked
      if (!this.ends.findFirst(!pickArray).set().not()) then
        !this.ends.append(!pickArray)
      else

        -- Unenhance all currently picked sections
        !this.enhance.clear()
        AID CLEAR TEXT $!this.aidNumber

        -- Remove section from array
        !this.ends.remove(!this.ends.findFirst(!pickArray))

        -- Re-enhance remaining sections in array
        do !end values !this.ends
          !this.enhance.addItem(!end[1])
          aid text number $!this.aidNumber '$!end[2]' at $!<end[4]>
        enddo

      endif
    endif

  elseif (!bool.not()) then
    !!alert.warning('Section $!end is not connected')
  endif
endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      setJoints
--
-- Description: Alter the JFREE attribute of the joint accordingly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setJoints()

  !undoJointFree = object UNDOABLE()
  !undoJointFree.description('Set Joint Dominance')
  !undoJointFree.add()

  do !end values !this.ends

     !joint = !end[3]
     !joint.jfree = !this.mode
     handle any
      -- handle case where joint has been deleted before this callback
     endhandle

  enddo

  !undoJointFree.endUndoable()

  !this.enhance.clear()
  !!aidNumbers.hide(!this.aidNumber)

  !this.ends = ARRAY()

endmethod
-- End of method definition
