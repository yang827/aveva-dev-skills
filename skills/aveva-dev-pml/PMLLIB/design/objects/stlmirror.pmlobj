--    Group:         Steelwork Application
--      Keyword:     STEEL
--    Module:        design
--  Author:          Daniel(Jaehun Choi)
--  Created:         23 July 2010
--
--  Description:     Object used to mirror element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  calcBetaAngle(DBREF)             REAL                calculate beta angle for section
--  elementMirror(DBREF)             -                   mirror element by type
--  mirrorPanel(DBREF)               -                   mirror plane
--  mirrorSctn(DBREF)                -                   mirror section
--
------------------------------------------------------------------------

define object STLMIRROR
  member .mirrorPosition  is POSITION
  member .mirrorDirection is STRING
endobject
-- End of object definition for STLMIRROR

------------------------------------------------------------------------
--
-- Method:      elementMirror
--
-- Description: mirror element by type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elementMirror(!element is DBREF)

  !!ce = !element

  if (!element.hardType eq 'SCTN') then

    -- special case code for SCTN
    if (!element.gtype inset ('BEAM')) then
      !this.mirrorPanel(!element)
    else
      !newBetaAngle = !this.calcBetaAngle(!element)
      -- adjust fittings that core does not mirror
      !this.mirrorSctn(!element)
      handle any
        !!alert.error(!!error.text)
      endhandle
      !element.bang = !newBetaAngle
    endif

  else

    -- simple core mirror
    !this.mirrorPanel(!element)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      calcBetaAngle
--
-- Description: calculate beta angle for section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calcBetaAngle(!element is DBREF) is REAL

  !bang    = !element.bang
  -- find NA direction before and after mirror
  !preDir  = !element.plor.attribute('NA').zdir().wrt( /* )
  mirror plane $!this.mirrorDirection wrt /* thro $!this.mirrorPosition
  !postDir = !element.plor.attribute('NA').zdir().wrt( /* )
  -- put element back yo original state
  mirror plane $!this.mirrorDirection wrt /* thro $!this.mirrorPosition

  -- calculate BANG to compensate for core mirror
  !angle   = !preDir.angle(!postDir)

  if (!angle eq 0) then
    !bang = !bang * -1

  elseif (!angle eq 180) then

    !mFlag = false
    if (!bang lt 0) then
      !mFlag = true
      !bang  = abs(!bang)
    endif

    !bang = !bang + 180

    if (!bang gt 180) then
      !bang = 360 - !bang
    endif

    if (!mFlag) then
      !bang = !bang * -1
    endif

  endif

  return !bang

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorPanel
--
-- Description: mirror plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mirrorPanel(!element is DBREF)
  mirror plane $!this.mirrorDirection wrt /* thro $!this.mirrorPosition
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorSctn
--
-- Description: mirror section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mirrorSctn(!element is DBREF)

  mirror plane $!this.mirrorDirection wrt /* thro $!this.mirrorPosition
  flip

  -- fix mirror of template fittings
  !members = !!ce.members
  do !index indices !members
    !!ce = !members[!index]
    VAR !numberTemplate MCOUNT TMPL
    skip if( !numberTemplate.real() eq 0 )
    !bang = !members[!index].bang
    handle any
    skip
    endhandle
    !angle = 180 + !bang
    if( !angle gt 180 ) then
      !angle = !bang - 180
    endif
    !members[!index].bang = !angle
    handle any
    skip
    endhandle
  enddo

  !!ce = !element

endmethod
-- End of method
