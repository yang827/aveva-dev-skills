--      Keyword:     STEEL
--    Module:        design
--  Author:          Daniel(Jaehun Choi)
--  Created:         23 July 2010
--
--  Description:     Create Structure Model Dimension ( SECTION , PANEL )
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createDetailDimension()          -                   making model dimension
--  drawDimension(DBREF)             -                   create model dimension with current structure element
--  getGENSECDimPos(DBREF)           -                   get dimension position for gensec element
--  getPanelDimPos(DBREF)            -                   get dimension position for panel element
--  getRefPosition(DIRECTION,POSITION) POINTVECTOR         get position for making dimension lead line
--  getSCTNDimPos(DBREF)             -                   get dimension position for sctn element
--  getTargetElements(DBREF)         ARRAY               get target elements for making model dimension
--  stlModelDimension()              -                   Constructor
--  tidy()                           -                   tidy aid graphics
--
------------------------------------------------------------------------

define object STLMODELDIMENSION
  member .refDimInformation is ARRAY
  -- aid number used for aids belonging to this object
  member .refDimAidNumber   is REAL
endobject
-- End of object definition for STLMODELDIMENSION

------------------------------------------------------------------------
--
-- Method:      stlModelDimension
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stlModelDimension()

  !this.refDimAidNumber = !!aidNumbers.add('stlModelDimension')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTargetElements
--
-- Description: get target elements for making model dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Scope of search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTargetElements(!element is DBREF) is ARRAY
  !collection = object COLLECTION()
  !collection.addType('SCTN')
  !collection.addType('PANE')
  !collection.addType('GENSEC')
  !collection.scope(!element)
  !results = !collection.results()
  return !results
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawDimension
--
-- Description: create model dimension with current structure element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawDimension(!element is DBREF)

  !targetList = !this.getTargetElements(!element)
  if (!targetList.unset()) then
    return error 1 |No SCTN, PANEL or GENSEC elements to dimension|
  endif

  !this.refDimInformation.clear()

  do !entry values !targetList

    -- get dimension position
    if (!entry.type eq 'SCTN') then
      !this.getSCTNDimPos(!entry)
    elseif (!entry.type eq 'GENSEC') then
      !this.getGENSECDimPos(!entry)
    elseif (!entry.type eq 'PANE') then
      !this.getPanelDimPos(!entry)
    endif

    if (!this.refDimInformation.unset()) then
      skip
    endif

    !this.createDetailDimension()

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSCTNDimPos
--
-- Description: get dimension position for sctn element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSCTNDimPos(!element is DBREF)

  if (!element.poss eq !element.pose) then
    return
  endif

  !pathDir = !element.orientation.zdir()
  !topDir  = !element.orientation.yDir().cross(!pathDir).opposite()

  -- get array of dimension POINTVECTOR for SCTN start and end
  !dimensionRecord[1] = !this.getRefPosition(!topDir, !element.poss)
  !dimensionRecord[2] = !this.getRefPosition(!topDir, !element.pose)
  !dimensionRecord[3] = !pathDir

  !this.refDimInformation.append(!dimensionRecord)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGENSECDimPos
--
-- Description: get dimension position for gensec element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGENSECDimPos(!element is DBREF)

  !block   = object BLOCK('SPINE 1')
  !spine   = !element.evaluate(!block)
  handle any
    return
  endhandle

  !posList = !spine.members
  if( !posList.size() lt 2 ) then
    return
  endif
  !yDir    = !spine.yDir

  -- loop through GENSEC points and curves
  do !i from 1 to !posList.size() - 1
    !fromIndex = !i
    !toIndex   = !i + 1

    if( !posList[!fromIndex].type eq 'POINSP' ) then
      !fromPos = !posList[!fromIndex].pos
    elseif( !posList[!fromIndex].type eq 'CURVE' ) then
      -- next tangent point on curve
      !fromPos = !posList[!fromIndex].ppos[4]
    else
      skip
    endif
    if( !posList[!toIndex].type eq 'POINSP' ) then
      !toPos = !posList[!toIndex].pos
    elseif( !posList[!toIndex].type eq 'CURVE' ) then
      -- next tangent point on curve
      !toPos = !posList[!toIndex].ppos[3]
    else
      skip
    endif

    !line    = object LINE(!fromPos, !toPos)
    !pathDir = !line.direction()
    handle any
      skip
    endhandle
    !topDir  = !pathDir.orthogonal(!yDir)
    handle any
      -- should only get here if spine YDIR parallel to edge
      -- try X
      !topDir    = !pathDir.orthogonal(object DIRECTION('X WRT WORLD'))
      handle any
        -- try Y
        !topDir  = !pathDir.orthogonal(object DIRECTION('Y WRT WORLD'))
        handle any
          skip
        endhandle
      endhandle
    endhandle

    !dimensionRecord[1] = !this.getRefPosition(!topDir, !fromPos)
    !dimensionRecord[2] = !this.getRefPosition(!topDir, !toPos)
    !dimensionRecord[3] = !pathDir
    !this.refDimInformation.append(!dimensionRecord)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPanelDimPos
--
-- Description: get dimension position for panel element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPanelDimPos(!element is DBREF)

  !block   = object BLOCK('PLOOP 1')
  !loop    = !element.evaluate(!block)
  handle any
    return
  endhandle

  -- get profile of loop
  !profile = object PROFILE(!loop)
  !profile = !profile.mergePoints().mergeLines().projectArcs(0.1)
  !edges   = !profile.edges()

  if( !edges.empty() ) then
    return
  endif

  -- find up direction from first vertex
  !block   = object BLOCK('PAVE 1')
  !vertex  = !loop.evaluate(!block)
  !topDir  = !vertex.pDir[3]

  do !line values !edges

    !pathDir  = !line.direction()
    handle any
      -- zero length edge
      skip
    endhandle

    !dimensionRecord[1] = !this.getRefPosition(!topDir, !line.startPosition)
    !dimensionRecord[2] = !this.getRefPosition(!topDir, !line.endPosition)
    !dimensionRecord[3] = !pathDir

    !this.refDimInformation.append(!dimensionRecord)

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRefPosition
--
-- Description: get position for making dimension lead line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRefPosition(!direction is DIRECTION, !position is POSITION) is POINTVECTOR

  !pointVector           = object POINTVECTOR()
  !pointVector.direction = !direction
  !pointVector.position  = !position

  return !pointVector

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createDetailDimension
--
-- Description: making model dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDetailDimension()

  !numberOfDimensions = !this.refDimInformation.size()
  if( !numberOfDimensions eq 0 ) then
    return
  endif
  -- do a pass through the dimensions to tune the arrow size for small objects
  !distance    = 0mm
  do !entry values !this.refDimInformation
    !distance  = !distance + !entry[1].position.distance(!entry[2].position)
  enddo
  !averageDimension = !distance / !numberOfDimensions
  !arrowSize   = min( 50mm, !averageDimension / 3)

  do !entry values !this.refDimInformation

    -- !entry[1] and [2] are leader line point vectors and !entry[3] is the dimension line direction
    !leader1   = !entry[1].position
    !leader2   = !entry[2].position
    !distance  = !leader1.distance(!leader2)

    !arrowDir1 = !entry[3].opposite()
    !arrowDir2 = !entry[3]

    !dimLine1  = !entry[1].offset(100mm - !arrowSize / 3).position
    !dimLine2  = !entry[2].offset(100mm - !arrowSize / 3).position
    !arrowPos1 = !dimLine1.offset(!arrowDir1, -1 * !arrowSize)
    !arrowPos2 = !dimLine2.offset(!arrowDir2, -1 * !arrowSize)

    !midPoint  = !arrowPos1.midPoint(!arrowPos2)

    aid arrow number $!this.refDimAidNumber at $!arrowPos1 dir $!arrowDir1 height $!arrowSize prop 0.5
    aid arrow number $!this.refDimAidNumber at $!arrowPos2 dir $!arrowDir2 height $!arrowSize prop 0.5

    -- draw vertical dimension line
    !end       = !entry[1].offset(100mm).position
    aid Line num $!this.refDimAidNumber $!leader1 to $!end
    !end       = !entry[2].offset(100mm).position
    aid Line num $!this.refDimAidNumber $!leader2 to $!end

    -- draw horizontal dimension line
    aid Line num $!this.refDimAidNumber $!dimLine1 to $!dimLine2

    -- draw dimension value
    !strDistance = !distance.string(!!distanceFmt)
    aid text num $!this.refDimAidNumber |$!strDistance| at $!midPoint

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !!aidNumbers.hide(!this.refDimAidNumber)

endmethod
-- End of method
