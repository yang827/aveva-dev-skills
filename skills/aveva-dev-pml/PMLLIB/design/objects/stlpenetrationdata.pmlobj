--
--  Description:     -- Raw penetration data--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createGENSECFixing()             BOOLEAN             Constructor
--  getHoleData()                    ARRAY               Return hole data in a form suitable for hmDefinition
--  getHoleType()                    STRING
--  getNormalisedPosition()          POSITION            Return hole position (already mapped to penetrating centre line)
--  getSectionHoleType()             STRING              Returns the type of hole required for this Section penetration
--  processData()                    BOOLEAN             Constructor
--  processGENSECData()              BOOLEAN             Constructor
--  processSCTNData()                BOOLEAN             Constructor
--  setPenetrated(DBREF)             -                   Set the penetrated item (could be higher in hierarchy than
--  setSpecification(STRING)         -                   Constructor
--  stlPenetrationData()             -                   Constructor
--  stlPenetrationData(DBREF,DBREF,POSITION,BOOLEAN) -                   Constructor
--
------------------------------------------------------------------------
--

define object STLPENETRATIONDATA

  -- Penetrated item (Actual Item)
  member .penetrated           is DBREF
  -- Penetrated item (selected item - possibly higher level object than penetrated)
  member .penetratedObject     is DBREF
  -- Penetrating item
  member .penetrating          is DBREF
  -- Penetrating object (= item or owner of item depending on type)
  member .penetratingObject    is DBREF
  -- DBREF of element created at the penetration (e.g. ATTA)
  member .penetratingMarker    is DBREF
  -- Penetrating type is the 'significant' type for this penetration
  member .penetratingType      is STRING
  -- Valid penetrating type list
  member .penetratingTypes     is ARRAY
  -- penetrating position
  member .position             is POSITION
  -- true if tube penetration
  member .tube                 is BOOLEAN
  -- Specification
  member .specification        is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      stlPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stlPenetrationData()

  -- Initialise Variables
  !this.penetratingTypes[1] = 'SCTN'
  !this.penetratingTypes[2] = 'GENSEC'

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      stlPenetrationData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference to the penetrating item
--    2   R      DBREF       Reference to the penetrated item
--    3   R      POSITION    Position of penetration
--    4   R      BOOLEAN     True if this is implied tube
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stlPenetrationData(!penetrating is DBREF, !penetrated is DBREF, !position is POSITION, !tube is BOOLEAN)

  -- Initialise Variables
  !this.stlPenetrationData()
  !this.penetrating = !penetrating
  !this.penetrated  = !penetrated
  !this.position    = !position
  !this.tube        = !tube
  !this.penetratedObject = !penetrated

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setPenetrated
--
-- Description: Set the penetrated item (could be higher in hierarchy than
--              clashed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Penetrated item reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPenetrated(!penetrated is DBREF)

  -- Initialise Variables
  !this.penetratedObject = !penetrated

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setSpecification
--
-- Description: Set specification - MUST BE maintained although not used
--              This object must support a setSpecification method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpecification(!specification is STRING)

  -- Initialise Variables
  !this.specification = !specification

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      processData
--
-- Description: Create the penetration elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processData() is BOOLEAN

  -- Find out type of penetration being created
  !ownerItems = !this.penetrating.ownlst
  !ownerItems.append(!this.penetrating)
  !ownerItems.invert()
  !this.penetratingType = ''
  do !item values !ownerItems
    !type  = !item.type
    !index = !this.penetratingTypes.findFirst(!type )
    skip if( !index.unset() )
    !this.penetratingType = !type
    break
  enddo

  if( !this.penetratingType eq 'SCTN' ) then
    !result = !this.processSCTNData()
  elseif( !this.penetratingType eq 'GENSEC' ) then
    !result = !this.processGENSECData()
  else
    -- invalid penetrating object
    return false
  endif

  return !result

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      processSCTNData
--
-- Description: Create FITT penetration marker for SCTN
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processSCTNData() is BOOLEAN

  -- Determine the penetrating object from the penetrating item
  !penetrating = !this.penetrating
  !this.penetratingObject = !this.penetrating

  -- Create SCTN FITT
  !!ce = !penetrating
  handle ANY
    return false
  endhandle
  NEW FITT
  handle (2,500) (2,501) (2,502) (2,503) (2,504)
    -- DAC errors
    !!alert.error(!!error.text)
    return false
  elsehandle NONE
    -- add the atta reference to hole management if necessary
    !this.penetratingMarker =!!ce
    GTYP PENI
    POSL CGEO
    handle any
      POSL NA
      handle any
        !!alert.error('Neither the Centre of Geometry nor Neutral Axis PLINEs are defined for this SCTN')
        return false
      endhandle
    endhandle
    ZDIST THRO $!<this.position> wrt worl
    -- adjust penetration position to ATTA position
    !this.position = !!ce.position.wrt( world )

  endhandle

  return true

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      processGENSECData
--
-- Description: Create FIXING penetration marker for GENSEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .processGENSECData() is BOOLEAN

  !result = !this.createGENSECFixing()
  handle any
    !!alert.error(!!error.text)
    return false
  endhandle

  return !result

endmethod
-- End of function definition

-----------------------------------------------------------------------
--
-- Method:      createGENSECFixing
--
-- Description: Create GENSEC fixing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------
define method .createGENSECFixing() is BOOLEAN

  -- Determine the penetrating object from the penetrating item
  !penetrating = !this.penetrating

  -- Create GENSEC FIXING
  !!ce = !penetrating
  handle ANY
    return false
  endhandle

  !penPos = !this.position.wrt( world )
  VAR !seg ID SEGMENT PPLINE CGEO THROUGH  $!penPos VIA PLINE BOUND
  handle any
    VAR !seg ID SEGMENT PPLINE NA THROUGH  $!penPos VIA PLINE BOUND
    handle any
      VAR !seg ID SEGMENT PPLINE any THROUGH  $!penPos VIA PLINE BOUND
    endhandle
  endhandle

  VAR !z PLDIST PPLINE NA      THROUGH  $!penPos VIA PLINE BOUND
  handle any
    VAR !z PLDIST PPLINE any       THROUGH  $!penPos VIA PLINE BOUND
  endhandle

  -- Attach penetration marker to centre of geometry (CGEO) P-line if it exists
  -- Otherwise use NA. CGEO only needed for profiles not symmetrical about X and Y axes
  if( !penetrating.plName.findFirst('CGEO').set() ) then
    !pLine = 'CGEO'
  elseif( !penetrating.plName.findFirst('NA').set() ) then
    !pLine = 'NA'
  else
    -- Cannot create penetration for section without NA or CGEO P-line
    return false
  endif
  NEW JLDATUM
  HPREF $!seg
  ZDIST $!z
  NEW PLDATU
  POSL $!<pLine>
  !po = !!ce.position.wrt(world)
  NEW FIXING AT $!po
  GTYP PENI
  NEW FIXING
  GTYP PENI
  !this.penetratingMarker =!!ce

  return true

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getNormalisedPosition
--
-- Description: Return hole position (already mapped to penetrating centre line)
--              Standard interface to all discipline penetration data objects.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    position mapped to vector through first vertex
--
------------------------------------------------------------------------
define method .getNormalisedPosition() is POSITION

  return !this.position

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getHoleData
--
-- Description: Return hole data in a form suitable for hmDefinition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Hole data
--
------------------------------------------------------------------------
define method .getHoleData() is ARRAY

 if (!this.penetratedObject.hardType eq 'HPANEL' or !this.penetratedObject.hardType eq 'CPANEL') then
    !holeDataElement[1] = !this.penetrated
  else
    !holeDataElement[1] = !this.penetratedObject
  endif
  !holeDataElement[2] = !this.penetrating
  !holeDataElement[3] = !this.position
  !holeDataElement[4] = !this.penetratingMarker
  return !holeDataElement

endmethod
-- End of function definition

----------------------------------------------------------------------
--
-- Method:      getHoleType
--
-- Description: Return hole type in a form suitable for hmDefinition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING       Hole type
--
------------------------------------------------------------------------
define method .getHoleType() is STRING

--  return !this.penetratingType
  return 'SCTN'

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      getSectionHoleType(!sctn is dbref)
--
-- Description: Returns the type of hole required for this Section penetration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     dbref      sctn under consideration
-- Return:
--   [Data Type]      [Description]
--    STRING           type of hole required - CIRC or RECT
--
------------------------------------------------------------------------
define method .getSectionHoleType() is STRING

  !section = !this.penetrating
  !return  = 'RECT'

  -- find the shape and parameters from the GTYP
  if( not !section.hardtype inset('SCTN', 'GENSEC') ) then
    return !return
  endif

  !gType = !section.gtype
  if( !gType.empty() ) then
    -- get the GTYP from the catalogue if it is unset on the element
    !gType = !section.catref.gtype
    handle any
      !gType = ''
    endhandle
  endif

  if ( !gType inset('TUBE', 'CTUB') ) then
    -- return circle for tubular
    !return = 'CIRC'
  endif

  return !return

endmethod
-- End of method definition
