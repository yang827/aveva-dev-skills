--   Module:        Design
--   Replaces:
--
-- Author:          jenni.hennings
-- Created:
--
-- Description:
--    Steelwork pline control object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Alter the defined attribute according to the pick
--  clearFeedback()                  -                   Wraps old PML 1 to clear aids for selected P-Line
--  elementPick(ANY)                 BOOLEAN             Action on picking a SCTN, GENSEC, or STWALL
--  formState(BOOLEAN)               -                   Activate/Deactivate the form controls
--  loadPick(STRING)                 -                   Setup the element pick
--  pLineFeedback(STRING,DBREF)      -                   Wraps old PML 1 aids for selected P-Line
--  plinPick(ANY)                    BOOLEAN             Action on picking a Pline from the attached section
--  setup(STRING,STRING,STRING,ANY,STRING) -                   Setup the form and attributes
--  stlPlineCntrl()                  -
--

define object STLPLINECNTRL

  -- Connection manager
  member .manager is SECTIONCONNECTIONMANAGER

  -- Packets for selection
  member .sctnPacket is EDGPACKET
  member .plinPacket is EDGPACKET

  -- Selected section
  member .section is DBREF

  -- Arguments
  member .gtype   is STRING
  member .gtypes  is ARRAY
  member .targets is ARRAY
  member .attr    is STRING
  member .rule    is STRING
  member .iflg    is BOOLEAN
  member .prompt  is STRING

  member .item    is DBREF
  member .joint   is DBREF

  member .refe    is DBREF

endobject
-- End of object definition


--------------------------------------------------------------------
--
-- Method:      stlPlineCntrl
--
-- Description: Object constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--------------------------------------------------------------------
define method .stlPlineCntrl()

  !this.gtype = ''
  !this.gtypes = ARRAY()
  !this.targets = ARRAY()
  !this.attr = ''
  !this.rule = ''
  !this.iflg = FALSE
  !this.prompt = ''
  !this.item = object DBREF()
  !this.refe = !!ce

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup the form and attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute to be queried
--    2   R      STRING      Array of element types
--    3   R      STRING      Array of element types
--    4   R      STRING      Rule to be used for finding plines
--    5   R      STRING      Prompt for EDG pick
--
--------------------------------------------------------------------
define method .setup(!attr is STRING, !gtype is STRING, !targets is STRING, !rule is ANY, !prompt is STRING)

   !this.refe = !!ce
   !this.attr = !attr
   !this.gtype = !gtype
   !this.gtypes = !gtype.split()
   !this.targets = !targets.split()
   !this.rule = !rule
   !this.prompt = !prompt
   !!setpline.ceName.val = ''

   if (!this.gtype.match('WALL') ne 0) then
    !!setpline.rflgpara.val = 'Re-trim attached wall.'
   else
    !!setpline.rflgpara.val = 'Re-trim attached section.'
   endif

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      loadPick
--
-- Description: Setup the element pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of pick required
--
--------------------------------------------------------------------
define method .loadPick(!pickType is STRING)

   !this.clearFeedback()

   if (!pickType.eq('CE')) then

      !element = !!dtbOwnerOfTypes(!!ce, !this.gtypes)

      if (!element.unset()) then

         !this.sctnPacket.pickpacket.stdGraphic(!this.prompt)
         !this.sctnPacket.description     = 'Pick section'
         !this.sctnPacket.action          = '!!stlPlines.elementPick(!this.return)'
         !this.sctnPacket.remove          = false

         !!edgCntrl.add(!this.sctnPacket)
      else
         !this.item = !element

         !this.elementPick(!this.item)
         !this.pLineFeedback(!!setpline.just.selection(), !this.item)
         -- Re-activate the form controls
         !this.formState(TRUE)
      endif

   elseif (!pickType.eq('list')) then

      !numb = !!cdclist.name.pickedfield

      -- if no lists available return with warning
      if(!numb eq 0) then
         !list = 'None Defined'
      else
         !list = !!cdlist[!numb]
      endif

      !!setpline.ceName.val = !list
      !this.iflg = TRUE

   elseif (!pickType.eq('Pick')) then

      !!setpline.ceName.val = |$!<this.gtype>(s) using Cursor|
      !this.iflg = TRUE

   elseif (!pickType.eq('IDPL')) then

      !this.plinPacket.plinePick(|Identify Pline to justify to.|)
      !this.plinPacket.description = 'Pick pline'
      !this.plinPacket.action = '!!stlPlines.plinPick(!this.return)'
      !this.plinPacket.remove = true

      !!edgCntrl.add(!this.plinPacket)

   endif

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      elementPick
--
-- Description: Action on picking a SCTN, GENSEC, or STWALL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         EDG Data
--
--------------------------------------------------------------------
define method .elementPick(!data is ANY) is BOOLEAN

   if (!this.gtypes.findFirst('SJOI').set()) then
      if (!!appcntrl.currentApp() eq 'CIVIL') then
         !idlist = 'STWALL ' + !this.gtype
      else
         !idlist = 'SCTN GENSEC ' + !this.gtype
      endif
   else
      !idlist = !this.gtype
   endif

   if (!data.objecttype().eq('DBREF')) then
   	 if (!data.hardType inset('GENSEC','SCTN')) then
   	 	!pickedSection = !data
   	 else
      !pickedSection = !data.cref
     endif
     !this.item = !data
     !bool = true

     if (!this.gtypes.findFirst('SJOI').set()) then
       if (!this.item.eq(!pickedSection.joistart)) then
       	!end = 'START'
       elseif (!this.item.eq(!pickedSection.joiend)) then
       	!end = 'END'
       endif
     endif

   else

     !pickData     = !data.last()
     !positionData = !pickData.positionData()
     if(!positionData.line.set()) then
       !position = !positionData.line.intersection(!positionData.pointVector)
     elseif (!positionData.plane.set()) then
       !position = !positionData.pointVector.intersection(!positionData.plane)
     elseif (!positionData.position.set()) then
       !position = !positionData.position.wrt( /* )
     endif

     !itemType = !pickData.item.hardType
     if (!idlist.match(!itemType) eq 0) then
       !this.loadPick('CE')
     endif

     !pickedSection = !pickData.item

     !chkArray = !this.manager.checkConnected(!position, !pickedSection)
     !bool     = !chkArray[1]
     !end      = !chkArray[2]
     !this.item = !pickedSection
   endif

   !!ce = !this.item

   -- Are we looking for joints rather than sections?
   if (!this.gtypes.findFirst('SJOI').set() ) then
     if (!bool.not()) then
       !!alert.warning('End of section not connected!')
       return false
     endif

     if (!end.eq('START')) then
       !this.item = !pickedSection.joistart
     elseif (!end.eq('END')) then
       !this.item = !pickedSection.joiend
     endif

   endif

   !info = !this.item.attribute(!this.attr)
   handle any
     !info = !this.item.owner.attribute(!this.attr)
     handle any
       if (!this.item.hardType.eq('GENSEC')) then
       	 !info = !this.item.jlnstart
       	 !this.attr = 'JLNSTART'
         handle any
           !!alert.warning('Cannot find required attribute.')
           return false
         endhandle
       endif
     endhandle
   endhandle

   -- If JUST is not specified, then give error
   !types[1] = 'SCTN'
   !types[2] = 'GENSEC'
   !types[3] = 'STWALL'
   !types[4] = 'WALL'

   !element = !!dtbOwnerOfTypes(!this.item, !types)
   if (!element.unset()) then
      return
   else
      !spre = !element.spre
      if(!spre eq Nulref ) then
        !flnn = !this.item.flnn
        !!ce = !this.item
        return error 1 |$!flnn does not have a profile.|
      endif
   endif

   -- If the HPOS is a SJOI (secondary joint) then we may need
   -- to handle other types of secondary joints SCOJ and SUBJ
   !gid = !this.item
   !element = !!dtbOwnerOfTypes(!this.item, !this.targets)
   if (!element.set()) then
      !gid = !element
   endif

   -- Load list of available plines from section
   !!runSynonym('CALLSTL DSETPLINE !!setpline.just $!gid $!this.rule')

   -- Currently set pline
   !!setpline.just.select('dtext', !info)
   handle ANY
      !!setpline.just.select('dtext', 'NA')
      handle ANY
         !!setpline.just.select('dtext', !!setpline.just.dtext[1])
         handle ANY
         endhandle
      endhandle
   endhandle

   !!setpline.ceName.val = !this.item.namn
   !this.iflg = false

   -- Re-activate the form controls
   !this.formState(TRUE)
   !!edgCntrl.remove(!this.sctnPacket)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      plinPick
--
-- Description: Action on picking a Pline from the attached section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         EDG Data
--
--------------------------------------------------------------------
define method .plinPick(!data is ANY) is BOOLEAN

   !plin = !data[1].pLine

   !!setpline.just.select('dtext', !plin)
   handle ANY
     return error 1 |Current section does not have the identified pline.|
   endhandle

   !this.iflg = true
   !this.pLineFeedback(!plin, !this.item)

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      pLineFeedback
--
-- Description: Wraps old PML 1 aids for selected P-Line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      P-Lines name
--    2   R      DBREF       SCTN reference
--
--------------------------------------------------------------------
define method .pLineFeedback(!pLine is STRING, !item is DBREF)

  if( !!setpline.pickType.selection() eq 'CE' ) then
    !!runSynonym('CALLIBD GPLINE ' + !pLine + ' ' + !item.string())
  endif

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      clearFeedback
--
-- Description: Wraps old PML 1 to clear aids for selected P-Line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      P-Lines name
--    2   R      DBREF       SCTN reference
--
--------------------------------------------------------------------
define method .clearFeedback()

  !!runSynonym('CALLIBD GPLINE DELETE')

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Alter the defined attribute according to the pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--------------------------------------------------------------------
define method .apply()

   !mode = !!setpline.pickType.selection()
   !just = !!setpline.just.selection()
   !gtypeList = !this.gtype
   !attr = !this.attr
   --!item = !this.joint
   !item = !this.item
   !refe = !!ce

   if (!mode.eq(|list|)) then
     !numb = !!cdclist.name.pickedfield.string()
     !list = '!!cdlist' + !numb
     var !coll coll all ($!gtypeList) from $!list
     if(arraysize(!coll) eq 0) then
       return error 1 |List does not contain any $!gtype elements.|
     endif

   elseif (!mode.eq(|Pick|)) then

     !!runMacro('/%PDMSUI%/clib/files/rpickloop', '$<Identify $!gtypeList$> $<$> $<$!gtypeList$>')

     !coll = ARRAY()

     var !coll coll all from !!cdpartn
     handle any
     endhandle

   elseif (!mode.eq(|CE|)) then
      !coll[1] = !item
   endif

   !max = !coll.size()

   do !i indices !coll

     prompt |Setting Pline $!i of $!max|

     if (!coll[!i].objecttype().eq(|DBREF|)) then
       !!ce = !coll[!i]
     elseif (!coll[!i].objecttype().eq(|STRING|)) then
       !!ce = !coll[!i].dbref()
     endif

     -- GENSECs have 2 joint lines
     if (!attr.eq('JLNSTART')) then
     	 JLNSTART $!just
     	 JLNEND $!just
     else
       $!attr $!just
       handle any
         OWNER
         $!attr $!just
       endhandle
     endif

     if (!!setpline.rflg.val) then
       call !!stlWrkTrim(false, true, true, !coll[!i].string())
     endif

     prompt dismiss
     prompt on
     unenhance all from !coll
     handle any
     endhandle
   enddo

   !this.pLineFeedback(!just, !item)

   !!ce = !refe

endmethod
-- End of method definition

--------------------------------------------------------------------
--
-- Method:      formState
--
-- Description: Activate/Deactivate the form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Active/Inactive
--
--------------------------------------------------------------------
define method .formState(!mode is BOOLEAN)

  !!setpline.pickType.active = !mode
  !!setpline.pick.active     = !mode
  !!setpline.just.active     = !mode
  !!setpline.rflg.active     = !mode
  !!setpline.dismiss.active  = !mode
  !!setpline.apply.active    = !mode

endmethod
-- End of method definition
