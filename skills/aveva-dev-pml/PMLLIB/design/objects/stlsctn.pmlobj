--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Jul 2 11:45:44 BST 1998
--
--
-- Description:
--  Structural section definition object.
--
--   NOTE : This object eventually should be used to define, create, modify
--   the basic positioning and connectivity of a SCTN based element.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         BOOLEAN             Create section
--  modify()                         BOOLEAN             Modify section
--  setType(STRING)                  -                   Constructor
--  stlSctn()                        -                   Constructor
--  stlSctn(DBREF)                   -                   Constructor
--
------------------------------------------------------------------------

define object STLSCTN

  -- References
    -- Reference section (i.e. what it was derived from)
    member .reference       is DBREF

    -- Start Connection
    member .startConnection is DBREF

    -- End Connection
    member .endConnection   is DBREF

  -- Positions
    -- Start Position
    member .startPosition   is POSITION

    -- End Position
    member .endPosition     is POSITION

  -- Creation Data
    -- SCTN Element soft type
    member .type            is STRING

    -- Store
    member .store           is DBREF
    -- Storage Group
    member .storeGroup      is STRING
    -- Store Area
    member .storeArea       is STRING

   -- Create connection
    -- Connect to sections, etc
    member .attachConnect   is BOOLEAN

    -- Connect to primary nodes
    member .freeConnect     is BOOLEAN

endobject
-- End of object definition for STLSCTN

------------------------------------------------------------------------
--
-- Method:      stlSctn
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlSctn()

  -- Initialise Variables
  !this.type            = 'SCTN'
  !this.attachConnect   = true
  !this.freeConnect     = false

endmethod
-- End of method definition for .stlSctn()

------------------------------------------------------------------------
--
-- Method:      stlSctn
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlSctn(!reference is DBREF)

  -- Check element type
  if(!reference.hardType neq 'SCTN') then
    return
  endif

  -- Initialise Variables
  !this.reference       = !reference
  !this.startConnection = !reference.joiStart
  !this.endConnection   = !reference.joiEnd
  !this.startPosition   = !reference.posStart
  !this.endPosition     = !reference.posEnd
  !this.type            = !reference.type
  !this.attachConnect   = true
  !this.freeConnect     = true

endmethod
-- End of method definition for .stlSctn(DBREF)

------------------------------------------------------------------------
--
-- Method:      setType
--
-- Description: Set hardtype to be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Hard type to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setType(!elementType is STRING)

  -- Initialise Variables
  !this.type            = !elementType
  !this.attachConnect   = true
  !this.freeConnect     = false

endmethod
-- End of method definition for .setType()

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if create was successful
--
------------------------------------------------------------------------

define method .create() is BOOLEAN

  -- Initialise Variables
  !reference = !!ce

  -- Move to creation area
  !!ce       = !this.store

  -- Create Element
  NEW $!<this.type>
  !reference = !!ce
  if (!reference.hardType.eq(|GENSEC|)) then
    NEW SPINE
    !sectionLine = object LINE(!this.startPosition, !this.endPosition)
    if (!sectionLine.direction().up.eq(1) OR !sectionLine.direction().up.eq(-1)) then
       !!ce.ydir = !reference.ori.ydir()
    endif
    NEW POINSP
    POSITION $!<this.startPosition>
    NEW POINSP
    POSITION $!<this.endPosition>
  elseif (!reference.hardType.eq(|SCTN|)) then
    POSSTART $!<this.startPosition> POSEND $!<this.endPosition>
    DRNSTART PERPENDICULAR
    DRNEND   PERPENDICULAR
  endif

  -- Return
  !!ce       = !reference

  !this.reference = !reference
  return true

endmethod
-- End of method definition for .create() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modify was successful
--
------------------------------------------------------------------------

define method .modify() is BOOLEAN

  -- Initialise Variables
  !reference = !!ce

  -- Move to creation area
  !!ce       = !this.reference

  -- Create Element
  POSSTART $!<this.startPosition> POSEND $!<this.endPosition>

  -- Return
  !!ce       = !reference

  return true

endmethod
-- End of method definition for .modify() BOOLEAN

