-- Created:         Wed Jul 1 11:49:41 BST 1998
--
--
-- Description:
--   Section tolerance settings object
--
--   >>>>>>>> Reverse Calls <<<<<<<<
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STLTOLERANCES)             -                   Apply settings to object and OLD form
--  default()                        -                   Default settings
--  edit()                           -                   Edit object
--  globalInstance()                 -                   Create global instance of object
--  length(REAL)                     BOOLEAN             Check passed length
--
------------------------------------------------------------------------

define object STLTOLERANCES

  -- Merge Radius
  -- Primary Nodes
  member .primaryMerge   is REAL
  -- Secondary Nodes
  member .secondaryMerge is REAL

  -- Nodes allowed off end of section
  member .nodesOfEnd     is BOOLEAN

  -- Intersection Settings
  member .offset         is REAL
  member .offsetLock     is BOOLEAN
  member .overhang       is REAL
  member .overhangLock   is BOOLEAN
  member .angle          is REAL
  member .angleLock      is BOOLEAN

  -- Section length
  member .minLength      is REAL
  member .minLengthLock  is BOOLEAN
  member .maxLength      is REAL
  member .maxLengthLock  is BOOLEAN

  -- Reconnection Settings
  member .reposition     is BOOLEAN
  member .trim           is BOOLEAN
--  member .mitreEnds      is BOOLEAN
  member .mitreOffset    is REAL

  -- Joint settings
  member .jointDominant  is BOOLEAN

endobject
-- End of object definition for STLTOLERANCES

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!stlTolerances = !this
  !!stlTolerances.default()

  -- So that the old steelwork appware works correctly, this has
  -- to build the form and apply it to update the old system
  -- Check if form is loaded (could move code into here from form)
  if(undefined(!!stlTolEdit)) then
    pml load form !!stlTolEdit
    !!stlTolEdit.initialise()
    !!stlTolEdit.apply()
  endif



endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      default
--
-- Description:
--   Default settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default()

  -- Flag Settings
  !this.nodesOfEnd     = false
  !this.offsetLock     = true
  !this.overhangLock   = true
  !this.angleLock      = true
  !this.minLengthLock  = true
  !this.maxLengthLock  = false
  !this.reposition     = true
  !this.trim           = true
--  !this.mitreEnds      = true
  !this.jointDominant  = false
  !this.angle          = 45 degrees

  -- Unit dependent
  if(!!isImperialLength('DIST').not()) then
    !this.primaryMerge   = 1mm
    !this.secondaryMerge = 1mm
    !this.offset         = 200mm
    !this.overhang       = 50mm
    !this.minLength      = 30mm
    !this.maxLength      = 20000mm
    !this.mitreOffset    = 100mm
  else
    !this.primaryMerge   = 1/16in
    !this.secondaryMerge = 1/16in
    !this.offset         = 8in
    !this.overhang       = 2in
    !this.minLength      = 1.181in
    !this.maxLength      = 787.5in
    !this.mitreOffset    = 4in
  endif

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Show edit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Check if form is loaded
  if(undefined(!!stlTolEdit)) then
    pml load form !!stlTolEdit
  endif

  !!stlTolEdit.edit()

endmethod
-- End of method definition for .edit()

------------------------------------------------------------------------
--
-- Method:      length
--
-- Description:
--   Check length against settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Length to be check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is conforms to settings
--
------------------------------------------------------------------------

define method .length(!length is REAL) is BOOLEAN

  -- Initialise Variables
  !return = true

  -- Less than minimum length
  if(!length lt !this.minLength and !this.minLengthLock) then
    !return      = false
    !!error.text = 'Length (' & !length & ') is less than the minimum [' & !this.minLength & '].'

  -- Longer than the maximum length
  elseif (!length gt !this.maxLength and !this.maxLengthLock) then
    !return      = false
    !!error.text = 'Length (' & !length & ') is greater than the maximum [' & !this.maxLength & '].'
  endif

  return !return

endmethod
-- End of method definition for .length(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Apply data to object and OLD form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!data is STLTOLERANCES)

  !this = !data

  -- >>>>>>>>>>>>>> Update OLD Tolerance form  <<<<<<<<<<<<<<<<
  !primary               = !this.primaryMerge.string(!!distanceFmt)
  !!cdsRefTol.pnode.val  = !primary
  !secondary             = !this.secondaryMerge.string(!!distanceFmt)
  !!cdsRefTol.snode.val  = !secondary
  !!cdsRefTol.snodo.val  = !this.nodesOfEnd

  !offset                = !this.offset.string(!!distanceFmt)
  !!cdsRefTol.offs.val   = !offset
  !overhang              = !this.overhang.string(!!distanceFmt)
  !!cdsRefTol.over.val   = !overhang
  !angle                 = !this.angle.string()
  !!cdsRefTol.plang.val  = !angle
  !!cdsRefTol.offso.val  = !this.offsetLock
  !!cdsRefTol.overo.val  = !this.overhangLock
  !!cdsRefTol.plango.val = !this.angleLock

  !minimum               = !this.minLength.string(!!distanceFmt)
  !!cdsRefTol.sMin.val   = !minimum
  !maximum               = !this.maxLength.string(!!distanceFmt)
  !!cdsRefTol.sMax.val   = !maximum
  !!cdsRefTol.sMino.val  = !this.minLengthLock
  !!cdsRefTol.sMaxo.val  = !this.maxLengthLock

  !!cdsRefTol.rconno.val = !this.reposition
  !!cdsRefTol.trim.val   = !this.trim
  !!cdsRefTol.jfree.val  = !this.jointDominant

endmethod
-- End of method definition for .apply(STLTOLERANCES)
