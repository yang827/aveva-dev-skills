--
-- Description:
--    Steelwork connection control object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  elementPick(DBREF,BOOLEAN)       BOOLEAN
--  elmntPick(ARRAY)                 BOOLEAN
--  elmntPick(STRING)                BOOLEAN
--  endPick(ARRAY)                   BOOLEAN
--  forcedEndPick(ARRAY)             BOOLEAN
--  forcedPlineTrim(ARRAY)           BOOLEAN
--  plineForceTidy()                 -
--  plineForceTidyUndo()             -                   Implements UNDO for Force tidy P-line
--  setup(BOOLEAN,BOOLEAN,STRING)    -
--  setupForce()                     -
--  stlTrimCntrl()                   -
--  trimSections()                   -
--  trimSectionsUndo()               -
--

define object STLTRIMCNTRL

  -- Dominant or subordinate
  member .state   is STRING

  -- Connection manager
  member .manager is SECTIONCONNECTIONMANAGER

  -- Packets for selection
  member .elmntPacket  is EDGPACKET
  member .endPacket    is EDGPACKET
  member .fElmntPacket is EDGPACKET
  member .fPlinePacket is EDGPACKET

  -- Arrays of selections
  member .elmnts  is ARRAY
  member .ends    is ARRAY
  member .forceData is ARRAY

  -- Arguments
  --     trim to section if true, trim to P-Line if false
  member .rflg    is BOOLEAN
  --     all attached if true, single if false
  member .aflg    is BOOLEAN
  member .pgid    is STRING

  member .oSctn   is DBREF
  member .tSctn   is DBREF
  member .sctnEnd is STRING
  member .joint   is DBREF
  member .tang    is STRING

  -- highlight control
  member .enhanceAttached is COMENHANCE
  member .enhanceOwner    is COMENHANCE
  member .enhanceTrim     is COMENHANCE
  member .enhanceEnds     is COMENHANCE

  -- aid number for this object
  member .aidNumber is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      stlTrimCntrl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stlTrimCntrl()

  !this.elmnts = ARRAY()
  !this.ends   = ARRAY()
  !this.forceData = ARRAY()
  !this.rflg = false
  !this.aflg = false
  !this.pgid = ''

  !this.oSctn   = object DBREF()
  !this.tSctn   = object DBREF()
  !this.sctnEnd = ''
  !this.joint   = object DBREF()
  !this.tang    = ''
  -- initialise enhance colour for this object
  !this.enhanceAttached.setColour(27)
  !this.enhanceEnds.setColour(27)
  !this.enhanceTrim.setColour(2)
  -- enhance Owner colour is current highlight colour

  !this.aidNumber = !!aidNumbers.add('Steel trim aid')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup object according to trim type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!rFlag is BOOLEAN, !aFlag is BOOLEAN, !sReference is STRING)

   !this.rflg = !rFlag
   !this.aflg = !aFlag
   !this.pgid = !sReference

   !this.elmnts = ARRAY()
   !this.ends   = ARRAY()

   -- Trim to section, all attached
   if (!rFlag AND !aFlag) then

      if (!this.pgid.eq('')) then
         !elmntPrompt = 'Identify element attached ends are to be trimmed to.'
         !this.elmntPacket.pickpacket.stdElement(!elmntPrompt)
         !this.elmntPacket.description     = 'Pick section'
         !this.elmntPacket.action          = '!!stlTrim.elmntPick(!this.return)'
         !this.elmntPacket.escape          = '!!stlTrim.trimSectionsUndo()'
         !this.elmntPacket.remove          = false

         !!edgCntrl.add(!this.elmntPacket)
      else
         !this.elmntPick(!this.pgid)
      endif

   -- Trim to section
   elseif (!rFlag AND !aFlag.not()) then

      !endPrompt = 'Identify end to be trimmed'
      !this.endPacket.pickpacket.stdGraphic(!endPrompt)
      !this.endPacket.description      = 'Pick section end'
      !this.endPacket.action           = '!!stlTrim.endPick(!this.return)'
      !this.endPacket.escape           = '!!stlTrim.trimSectionsUndo()'
      !this.endPacket.remove           = false

      !!edgCntrl.add(!this.endPacket)

   -- Trim to pline, all attached
   elseif (!rFlag.not() AND !aFlag) then

    if (!this.pgid.eq('')) then
      !elmntPrompt = 'Identify element attached ends are to be trimmed to.'
      !this.elmntPacket.pickpacket.stdElement(!elmntPrompt)
      !this.elmntPacket.description = 'Pick section'
      !this.elmntPacket.action = '!!stlTrim.elmntPick(!this.return)'
      !this.elmntPacket.escape = '!!stlTrim.trimSectionsUndo()'
      !this.elmntPacket.remove = false

      !!edgCntrl.add(!this.elmntPacket)
    else
      !this.elmntPick(!this.pgid)
    endif

   -- Trim to pline
   elseif (!rFlag.not() AND !aFlag.not()) then

      !endPrompt = 'Identify end to be trimmed'
      !this.endPacket.pickpacket.stdGraphic(!endPrompt)
      !this.endPacket.description      = 'Pick section end'
      !this.endPacket.action           = '!!stlTrim.endPick(!this.return)'
      !this.endPacket.escape           = '!!stlTrim.trimSectionsUndo()'
      !this.endPacket.remove           = false

      !!edgCntrl.add(!this.endPacket)

   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupForce
--
-- Description: Force connection setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setupForce()

   !!edgCntrl.remove(!this.fElmntPacket)

   !this.aflg = !!cdsreftol.plango.val
   !this.tang = !!cdsreftol.plang.val

   !elmntPrompt = 'Identify section end to be trimmed.'
   !this.fElmntPacket.pickpacket.stdGraphic(!elmntPrompt)
   !this.fElmntPacket.description     = 'Pick section'
   !this.fElmntPacket.action          = '!!stlTrim.forcedEndPick(!this.return)'
   !this.fElmntPacket.escape          = '!!stlTrim.plineForceTidyUndo()'
   !this.fElmntPacket.priority        = 0
   !this.fElmntPacket.remove          = false

   !!edgCntrl.add(!this.fElmntPacket)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      forcedEndPick
--
-- Description: Force connection pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       EDG Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .forcedEndPick(!data is ARRAY) is BOOLEAN

  !pickData     = !data.last()
  !positionData = !pickData.positionData()
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
  endif

  if (!pickData.item.badref() ) then
      !!alert.error('No element picked')
      return false
  endif
  -- If a GENSEC or SCTN has not been picked, pick again
  if (!pickData.item.type.neq('GENSEC') or !pickData.item.type.neq('SCTN')) then
    !this.setupForce()
  endif

  !this.oSctn   = !pickData.item

  -- Find appropriate end and check connected
  !chkArray     = !this.manager.checkConnected(!position, !this.oSctn)
  !bool         = !chkArray[1]
  !this.sctnEnd = !chkArray[2]

  -- If not connected, pick again
  if (!bool.not()) then
    !this.setupForce()
  endif

  -- Choose joint reference, according to which end was picked
  if (!this.sctnEnd.eq('START')) then
    !this.joint = !pickData.item.joistart
  elseif (!this.sctnEnd.eq('END')) then
    !this.joint = !pickData.item.joiend
  endif

  if (!this.joint.badref() ) then
      return false
  endif

  !softTypes  = !!dtbSoftTypes.stringStypesFor('SCTN')
  !softTypes  = !softTypes & !!dtbSoftTypes.stringStypesFor('GENSEC')

  !sctnDbref  = !!dtbGetOwnerType( !this.joint, !softTypes)
  !actualType = !sctnDbref.type

  !this.tSctn = $!actualType OF $!this.joint

  -- highlight elements
  !this.enhanceTrim.addItem(!this.tSctn)
  !this.enhanceOwner.addItem(!this.oSctn)

  !prompt = 'Identify pline to be trimmed to'
  !this.fPlinePacket.plinePick(!prompt)
  !this.fPlinePacket.description     = 'Pick pline'
  !this.fPlinePacket.action          = '!!stlTrim.forcedPlineTrim(!this.return)'
  !this.fPlinePacket.priority        = 1
  !this.fPlinePacket.remove = false

  !!edgCntrl.add(!this.fPlinePacket)

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      forcedPlineTrim
--
-- Description: Force trim to P-Line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       EDG Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .forcedPlineTrim(!data is ARRAY) is BOOLEAN

   if (!data[1].item.neq(!this.tSctn)) then
     !!edgCntrl.add(!this.fPlinePacket)
     return false
   endif

   -- Rebuild the string returned by the PML 1 ID@ pick
   !plin = 'PPline ' & !data[1].pline & ' of ' & $!this.tSctn

   if (!this.sctnEnd.eq('START')) then
     !poss = !this.oSctn.posstart.wrt(world)
     !pose = !this.oSctn.posend.wrt(world)
     !ownerEndDir = !this.oSctn.drns
   elseif (!this.sctnEnd.eq('END')) then
     !poss = !this.oSctn.posend.wrt(world)
     !pose = !this.oSctn.posstart.wrt(world)
     !ownerEndDir = !this.oSctn.drne
   endif

   !oCutp = !this.joint.cutp
   !oPosl = !this.joint.posline
   handle any
     !oPosl = !this.joint.owner.posline
   endhandle

   var !oLine const line join $!poss to $!pose
   var !tLin const line $!plin start
   var !tDir const dir orth $!tLin and $!oLine
   var !cutp const dir orth $!tDir and $!tLin
   var !pDir $!plin leave dir

   var !angle const angle $!cutp and $!pDir
   if(!this.aflg) then
     if($!angle gt $!this.tang) then
       error |Angle between pline and cutplane of section $!this.sctnEnd ($!angle ), is greater than permissible ($!this.tang ).|
       return false
     endif
   endif

   -- Array of data required for forcing the pline
   !forceArr = ARRAY()
   !forceArr.append(!this.oSctn)
   !forceArr.append(!this.tSctn)
   !forceArr.append(!this.joint)
   !forceArr.append(!oLine)
   !forceArr.append(!tLin)
   !forceArr.append(!tDir)
   !forceArr.append(!cutp)
   !forceArr.append(!pDir)
   !forceArr.append(!this.sctnEnd)
   !forceArr.append(!ownerEndDir)
   !forceArr.append(!oCutp)
   !forceArr.append(!oPosl)
   !forceArr.append(!plin)

   !this.forceData.append(!forceArr)

   -- remove element highlight
   !this.enhanceTrim.removeItem(!this.tSctn)
   !this.enhanceOwner.removeItem(!this.oSctn)

   !!edgCntrl.remove(!this.fPlinePacket)

   return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      endPick
--
-- Description: Pick end of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       EDG Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .endPick(!data is ARRAY) is BOOLEAN

  !pickData     = !data.last()
  !positionData = !pickData.positionData()
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
  endif

  if (!pickData.item.badref() ) then
      !!alert.error('No element picked')
      return false
  endif
  -- Find appropriate end and check connected
  !chkArray = !this.manager.checkConnected(!position, !pickData.item)
  !bool     = !chkArray[1]
  !end      = !chkArray[2]

  if (!bool) then

    -- Item and end of item array
    !pickArray = ARRAY()
    !pickArray.append(!pickData.item)
    !pickArray.append(!end)

    if (!this.ends.findFirst(!pickArray).set()) then
      !!aidNumbers.hide(!this.aidNumber)
      !this.enhanceEnds.clear()
      !this.ends.remove(!this.ends.findFirst(!pickArray))
      do !endArray values !this.ends
        !this.enhanceEnds.addItem(!endArray[1])
        if (!endArray[2].eq('START')) then
          AID TEXT number $!this.aidNumber 'START' AT $!<endArray[1].posstart>
        elseif (!endArray[2].eq('END')) then
          AID TEXT number $!this.aidNumber 'END' AT $!<endArray[1].posend>
        endif
      enddo
      return false
    endif

    !this.enhanceEnds.addItem(!pickData.item)

    if (!end.eq(|START|)) then
      AID TEXT number $!this.aidNumber 'START' AT $!<pickData.item.posstart>
    elseif (!end.eq(|END|)) then
      AID TEXT number $!this.aidNumber 'END' AT $!<pickData.item.posend>
    endif

    !this.ends.append(!pickArray)
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method:      elmntPick
--
-- Description: EDG pick handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elmntPick(!data is ARRAY) is BOOLEAN
  -- EDG pick
  !pickData      = !data.last()
  !pickedSection = !pickData.item
  if (!pickedSection.badref() ) then
    !!alert.error('No element picked')
    return false
  else
    !this.elementPick(!pickedSection, false)
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method:      elmntPick
--
-- Description: Element pick interface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elmntPick(!dummy is STRING) is BOOLEAN
  -- Passed by string
  !pickedSection = !this.pgid.dbref()
  !this.elementPick(!pickedSection, true)
  return true
endmethod

------------------------------------------------------------------------
--
-- Method:      elementPick
--
-- Description: Pick handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementPick(!pickedSection is DBREF, !pflg is BOOLEAN) is BOOLEAN

  if (!this.elmnts.findFirst(!pickedSection).set().not()) then

    !this.elmnts.append(!pickedSection)

    !jointCollection = object COLLECTION()
    !jointCollection.scope(!pickedSection)
    !jointCollection.addType('FIXING')
    !jointCollection.addType('SJOI')

    !joints = !jointCollection.results()

    --!this.ends = ARRAY()
    do !join values !joints
      !jointArr = ARRAY()
      skip if(badref(!join.cref))
      !jointArr.append(!join.cref)
      if (!join.cref.joistart.eq(!join)) then
        !end = 'START'
        !pos = !join.cref.posstart
      elseif (!join.cref.joiend.eq(!join)) then
        !end = 'END'
        !pos = !join.cref.posend
      endif
      !jointArr.append(!end)
      !jointArr.append(!pos)
      !this.ends.append(!jointArr)
    enddo

    !this.enhanceOwner.addItem(!pickedSection)
    do !attached values !this.ends
      !this.enhanceAttached.addItem(!attached[1])
      AID TEXT number $!this.aidNumber '$!attached[2]' AT $!attached[3]
    enddo

    if (!pflg) then
      !this.trimSections()
    endif

  else

    !elementIndex = !this.elmnts.findFirst(!pickedSection)
    !this.elmnts.remove(!elementIndex)
    !this.enhanceOwner.removeItem(!pickedSection)

    !!aidNumbers.hide(!this.aidNumber)
    !this.enhanceAttached.clear()

    !jointCollection = object COLLECTION()
    !jointCollection.scope(!pickedSection)
    !jointCollection.addType('FIXING')
    !jointCollection.addType('SJOI')
    !joints = !jointCollection.results()

    do !join values !joints
      !jointArr = ARRAY()
      !jointArr.append(!join.cref)
      if (!join.cref.joistart.eq(!join)) then
        !end = 'START'
        !pos = !join.cref.posstart
      elseif (!join.cref.joiend.eq(!join)) then
        !end = 'END'
        !pos = !join.cref.posend
      endif
      !jointArr.append(!end)
      !jointArr.append(!pos)
      !endIndx = !this.ends.findFirst(!jointArr)
      !this.ends.remove(!endIndx)
    enddo

    do !attached values !this.ends
      !this.enhanceAttached.addItem(!attached[1])
      AID TEXT number $!this.aidNumber '$!attached[2]' AT $!attached[3]
    enddo

  endif

  return true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      trimSections
--
-- Description: Implements UNDO for Trim sections
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trimSectionsUndo()

  !undoTrimSections = object UNDOABLE()
  !undoTrimSections.description('Trim Sections')
  !undoTrimSections.add()

  !this.trimSections()
  handle any
    !!alert.error(!!error.text)
  endhandle

  !this.undoTrimSections.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      trimSections
--
-- Description: Trim sections
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .trimSections()

-- Set current pline selection rule
if (defined(!!edgPlineFilter)) then
  !this.manager.setPlineRule(!!edgPlineFilter.rule())
endif

  do !end values !this.ends
    if (!this.rflg) then
      if (!end[2].eq('START')) then
         if (!end[1].joistart.type.eq('FIXING')) then
           !!ce = !end[1].joistart
--           var !atSctn (GENSEC of CE)
         elseif (!end[1].joistart.type.eq('SJOI')) then
           !!ce = !end[1].joistart
--           var !atSctn (SCTN of CE)
         endif
         !join = !end[1].joistart
      elseif (!end[2].eq('END')) then
         if (!end[1].joiend.type.eq('FIXING')) then
           !!ce = !end[1].joiend
--           var !atSctn (GENSEC of CE)
         elseif (!end[1].joiend.type.eq('SJOI')) then
           !!ce = !end[1].joiend
--           var !atSctn (SCTN of CE)
         endif
         !join = !end[1].joiend
      endif

      if( !join.hardtype eq 'PJOI' ) then
        !pline = ''
      else
        !pline = !join.posline
        handle any
           !pline = !join.owner.posline
           handle any
             !pline = ''
          endhandle
        endhandle
      endif

      !cutDirection = !join.cutp

      --     **** CIVILS SPECIFIC CODE ****
      if (!!appcntrl.currentApp().eq(|CIVIL|)) then
        var !seveList COLLECT ALL SEVE WITH ZDIST eq 0 for CE
      endif
      --     **** END OF CIVILS SPECIFIC CODE ****

      if( !pline.empty() ) then
        !this.manager.reconnect(!join)
      else
        !this.manager.reconnect(!join, !pline, !cutDirection)
      endif

      --     **** CIVILS SPECIFIC CODE ****
      if (!!appcntrl.currentApp().eq(|CIVIL|)) then
        -- Set any wall/floor connections
        do !seve values !seveList
          $!seve
          zdist 0
        enddo
      endif
      --     **** END OF CIVILS SPECIFIC CODE ****

    else

      !name = !end[1]
      !tempEnd = !end[2]

      if (!!appcntrl.currentApp() eq 'CIVIL') then
        !elementDesc = 'wall'
      else
        !elementDesc = 'section'
      endif

      !!ce  = !name
      !jois = !!ce.joistart
      !joie = !!ce.joiend

      !poss = !!ce.posstart.wrt(World)
      !pose = !!ce.posend.wrt(World)
      !dir  = ARRAY()
      !dir[1] = !!ce.drns
      !dir[2] = !!ce.drne

      if (!tempEnd.eq('START')) then
        !joint = !jois
--        !uDir = !dir[1]
      elseif (!tempEnd.eq('END')) then
        !joint = !joie
--        !uDir = !dir[2]
      endif

      if (!joint.badref()) then
        return
      endif

      skip if( !joint.hardtype eq 'PJOI' )

      -- Get the owner of the joint
      !softTypes  = !!dtbSoftTypes.stringStypesFor('SCTN')
      !softTypes  = !softTypes & !!dtbSoftTypes.stringStypesFor('GENSEC')

      !sctnDbref  = !!dtbGetOwnerType(!joint, !softTypes)
      !actualType = !sctnDbref.type

      !primarySection = $!actualType of $!joint

      !this.manager.primarySection(!primarySection)
      !this.manager.secondarySection(!name)
      !this.manager.derivedConnection = false
      if (!tempEnd.eq('START')) then
        !this.manager.startConnection()
      else
        !this.manager.endConnection()
      endif

      -- Works out the correct line for the section
      !connLin = !this.manager.getConnectionLine()
      !this.manager.connectionPoint(!connLin)

      !pplin = !this.manager.connectionPline

      !cutp  = !this.manager.connectionDirection

      !joint.posl = !pplin
      handle any
        !joint.owner.posl = !pplin
      endhandle

      !!ce = !joint
      !cpString = !cutp.string()
      !cpString = !cpString.replace('WRT /*', '').trim()
      CUTP $!cpString wrt World

      RECONNECT RECALCULATE
      handle ANY
        if (!end[1].hardtype.eq('SCTN')) then
          write 'Cannot reconnect $!end[2] of $!end[1], attached to a GENSEC'
        elseif (!end[1].hardtype.eq('GENSEC')) then
          write 'Cannot reconnect $!end[2] of $!end[1], attached to a SCTN'
        endif
      endhandle

      !!ce = !name

    endif

    if (!!appcntrl.currentApp().eq(|CIVIL|)) then
      -- Special Code to handle mitres
      !thisItem = !end[1]
      call !!sctlMitreBoth(!thisItem)
    endif
  enddo

  !this.enhanceEnds.clear()
  !this.enhanceOwner.clear()
  !this.enhanceAttached.clear()
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      plineForceTidyUndo
--
-- Description: Implements UNDO for Force tidy P-line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .plineForceTidyUndo()

  !undoPLineForceTidy = object UNDOABLE()
  !undoPLineForceTidy.description('Force tidy P-line')
  !undoPLineForceTidy.add()

  !this.plineForceTidy()
  handle any
    !!alert.error(!!error.text)
  endhandle

  !this.undoPLineForceTidy.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      plineForceTidy
--
-- Description: Force tidy P-line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .plineForceTidy()

  -- Loop through the saved force picks
  do !fEnd values !this.forceData

     !oSctn = !fEnd[1]
--     !tSctn = !fEnd[2]
     !joint = !fEnd[3]
     !oLine = !fEnd[4]
--     !tLine = !fEnd[5]
     !tDir  = !fEnd[6]
     !cutp  = !fEnd[7]
     !pDir  = !fEnd[8]
     !sEnd  = !fEnd[9]
     !ownerEndDir = !fEnd[10]
     !oCutp = !fEnd[11]
     !oPosl = !fEnd[12]
     !plin  = !fEnd[13]

     !!ce = !oSctn
     if (!sEnd.eq('START')) then
       !drns = object DIRECTION(!pDir)
       !oSctn.drns = !drns
     elseif (!sEnd.eq('END')) then
       !drne = object DIRECTION(!pDir)
       !oSctn.drne = !drne
     endif
     var !posl (part(|$!plin|,2))
     !!ce = !joint
     !joint.posl = !posl
     handle any
       !joint.owner.posl = !posl
     endhandle
     !joint.cutp = object DIRECTION(!pDir)
     RECONNECT RECALCULATE
     handle ANY
       !!ce = !oSctn
       if (!sEnd.eq('START')) then
         !drns = object DIRECTION(!ownerEndDir)
         !oSctn.drns = !drns
       elseif (!sEnd.eq('END')) then
         !drne = object DIRECTION(!ownerEndDir)
         !oSctn.drne = !drne
       endif
       !!ce = !joint
       POSL $!oPosl
       CUTP $!oCutp
       !!alert.warning('Pline $!posl gives invalid cut plane, try again.')
     endhandle

  enddo

  !this.enhanceOwner.removeItem(!this.oSctn)
  !this.enhanceTrim.removeItem(!this.tSctn)

  !this.oSctn     = object DBREF()
  !this.tSctn     = object DBREF()
  !this.forceData = ARRAY()

endmethod
-- End of method definition
