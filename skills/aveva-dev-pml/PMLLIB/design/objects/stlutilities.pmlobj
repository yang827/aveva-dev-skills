------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  modifyForm()                     -                   Initialise object
--  toolbars()                       -                   Creates toolbars for this application
--
------------------------------------------------------------------------

define object STLUTILITIES
endobject
-- End of object definition for STLUTILITIES

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  -- these functions only available in Marine
  if(!!module().productfamily.upcase().eq('MARINE')) then
    !this.toolbars()
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  frame .utilitiesForSteelwork toolbar 'SteelWork Utilities'
    !iconSize = !!comSysOpt.iconSize()

    !panelDefaultSpec           = !!pml.getPathName('panelspec' & !iconSize & '.png')
    !mirrorStructure            = !!pml.getPathName('mirrora16.png')
    !trimToModel                = !!pml.getPathName('aslinstallationsituation01-16.png')
    !endcutToModel              = !!pml.getPathName('attachmodel16.png')
    !endcutToModelWithOffset    = !!pml.getPathName('attachmodelwithoffset16.png')
    !deleteEndcut               = !!pml.getPathName('deleteendcut16.png')
    !attachToModel              = !!pml.getPathName('insertsteelfitting16.png')
    !attachToModelWithNeighbour = !!pml.getPathName('insertsteelfittingneighbour16.png')
    !deleteJoint                = !!pml.getPathName('insertsteelfittingdelete16.png')
    !mitreSctn                  = !!pml.getPathName('mitresctn16.png')
    !copyFromOtherSctn          = !!pml.getPathName('copyfromothersctn16.png')
    !insertOtherSctn            = !!pml.getPathName('insertothersctn16.png')
    !deleteSelection            = !!pml.getPathName('deleteselection16.png')
    !changeSpec                 = !!pml.getPathName('changesctnspec16.png')
    !makeModelDimension         = !!pml.getPathName('distancedirection24.png')
    !delModelDimension          = !!pml.getPathName('delmodeldim16.png')
    !createSctnUsingPanel       = !!pml.getPathName('createsctnusingpanel16.png')
    !createPanelUsingSctn       = !!pml.getPathName('createpanelusingsctn16.png')
    !createBentPanel            = !!pml.getPathName('merge16.png')
    !splitBentPanel             = !!pml.getPathName('split16.png')

    button .btnPanelDefaultSpec           tooltip 'Set Selected Panels to Default Spec'           pixmap "$!<panelDefaultSpec>"           width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('PANEL_DEFAULT_SPEC', false)|
    button .btnMirrorStructure            tooltip 'Copy / Mirror structures'                      pixmap "$!<mirrorStructure>"            width $!<iconSize> height $!<iconSize> callback |!!stlMirror()|
    button .btnTrimToModel                tooltip 'Trim to Panel'                                 pixmap "$!<trimToModel>"                width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('TRIMTO', false)|
    button .btnEndcutToModel              tooltip 'Trim selected sections'                        pixmap "$!<endcutToModel>"              width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('ENDCUT', false)|
    button .btnEndcutToModelWithOffset    tooltip 'Trim selected sections with offset'            pixmap "$!<endcutToModelWithOffset>"    width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('ENDCUT', true)|
    button .btnAttachToModel              tooltip 'Trim and connect selected sections'            pixmap "$!<attachToModel>"              width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('JOINT', false)|
    button .btnAttachToModelWithNeighbour tooltip 'Connect adjacent sections'                     pixmap "$!<attachToModelWithNeighbour>" width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('JOINT_NEIGHBOUR', false)|
    button .btnDeleteJoints               tooltip 'Delete Joint'                                  pixmap "$!<deleteJoint>"                width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('DELETE_JOINT', false)|
    button .btnMitreSctn                  tooltip 'Mitre selected sections'                       pixmap "$!<mitreSctn>"                  width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('SCTN_MITRE', false)|
    button .btnDeleteEndcut               tooltip 'Delete Endcut'                                 pixmap "$!<deleteEndcut>"               width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('ENDCUT_DELETE', true)|
    button .btnCopyFromOtherSctn          tooltip 'Copy selected to another structure'            pixmap "$!<copyFromOtherSctn>"          width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('COPY_OTHER_PARTS', false)|
    button .btnInsertOtherSctn            tooltip 'Include Structure'                             pixmap "$!<insertOtherSctn>"            width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('INSERT_OTHER_PARTS', false)|
    button .btnDeleteSelection            tooltip 'Delete Selection'                              pixmap "$!<deleteSelection>"             width $!<iconSize> height $!<iconSize> callback |!!deleteSelection()|
    button .btnChangeSpec                 tooltip 'Modify specification of selection with picked' pixmap "$!<changeSpec>"                 width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('CHANGE_SPEC',false)|
    button .btnMakeModelDimension         tooltip 'Model dimensions'                              pixmap "$!<makeModelDimension>"         width $!<iconSize> height $!<iconSize> callback |!!stlModelDimension(true)|
    button .btnDelModelDimension          tooltip 'Delete Model Dimension'                        pixmap "$!<delModelDimension>"          width $!<iconSize> height $!<iconSize> callback |!!stlModelDimension(false)|
    button .btnCreateSctnUsingPanel       tooltip 'Trace panel with sections'                     pixmap "$!<createSctnUsingPanel>"       width $!<iconSize> height $!<iconSize> callback |!!stlEasyModify('CREATE_SCTN_USING_PANEL',false)|
    button .btnCreatePanelUsingSctn       tooltip 'Trace section with panel'                      pixmap "$!<createPanelUsingSctn>"       width $!<iconSize> height $!<iconSize> callback |show !!stlCreatePanelUsingSCTN|
    button .btnCreateBentPanel            tooltip 'Create bent panel'                             pixmap "$!<createBentPanel>"            width $!<iconSize> height $!<iconSize> callback |show !!stlBentPanelCreate|
    button .btnSplitBentPanel             tooltip 'Divide bent panel'                             pixmap "$!<splitBentPanel>"             width $!<iconSize> height $!<iconSize> callback |show !!stlDivideBentPanel|
  exit

  -- register this toolbar with all three structures applications
  !!appTbarCntrl.addToolbar('utilitiesForSteelwork', 'STLWRK')
  !!appTbarCntrl.addToolbar('utilitiesForSteelwork', 'PANEL')

endmethod
-- End of method
