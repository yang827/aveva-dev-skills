--
--
-- Description:
-- Structural generic section object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         BOOLEAN             Create section
--  modify()                         BOOLEAN             Modify section
--  strGensec()                      -                   Constructor
--  strGensec(DBREF)                 -                   Constructor
--  strGensec(GMFSPINE)              -                   Constructor
--
------------------------------------------------------------------------


define object STRGENSEC


  -- References
  member .genericSection    is DBREF

    -- Reference section (i.e. what it was derived from)
    member .spine           is DBREF

    -- Start Connection
    member .startConnection is DBREF

    -- End Connection
    member .endConnection   is DBREF

  -- Positions
    -- Start
    member .startPosition   is POSITION
    -- End
    member .endPosition     is POSITION

    -- Definition
    member .definition      is GMFSPINE

  -- Creation Data
    -- SCTN Element soft type
    member .type            is STRING

    -- Store
    member .store           is DBREF
    -- Storage Group
    member .storeGroup      is STRING
    -- Store Area
    member .storeArea       is STRING

   -- Create connection
    -- Connect to sections, etc
    member .attachConnect   is BOOLEAN

    -- Connect to primary nodes
    member .freeConnect     is BOOLEAN

endobject
-- End of object definition for STRGENSEC

------------------------------------------------------------------------
--
-- Method:      strGensec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strGensec()

  -- Initialise Variables
  !this.type            = 'GENSEC'
  !this.attachConnect   = true
  !this.freeConnect     = false

endmethod
-- End of method definition for .strGensec()

------------------------------------------------------------------------
--
-- Method:      strGensec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Definition in terms of lines and arc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strGensec(!definition is GMFSPINE)

  -- Initialise Variables
  !this.definition      = !definition

  !this.type            = 'GENSEC'
  !this.attachConnect   = true
  !this.freeConnect     = false

endmethod
-- End of method definition for .strGensec(GMFSPINE)

------------------------------------------------------------------------
--
-- Method:      strGensec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strGensec(!reference is DBREF)

  -- Check element type
  if(!reference.hardType neq 'GENSEC') then
    return
  endif

  -- Initialise Variables
  !this.genericSection  = !reference
  !this.startConnection = !reference.joiStart
  !this.endConnection   = !reference.joiEnd
  !this.startPosition   = !reference.posStart
  !this.endPosition     = !reference.posEnd
  !this.type            = !reference.type
  !this.attachConnect   = true
  !this.freeConnect     = true

endmethod
-- End of method definition for .strGensec(DBREF)

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create section (spine must always be defined in terms of point,arc,point,arc,point,........,point)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if create was successful
--
------------------------------------------------------------------------

define method .create() is BOOLEAN

  -- Initialise Variables
  !reference = !!ce

  -- Move to creation area
  !!ce       = !this.store

  -- Create Element
  NEW $!<this.type> AT $!<this.definition.points[1].position> ORIENTATION $!<this.definition.points[2].arc.orientation>

  !this.genericSection = !!ce
  NEW SPINE
  !this.spine          = !!ce

  do !i indices !this.definition.points

    -- Control point
    if(not !this.definition.points[!i].type inset('CENTRE','FILLET')) then
      NEW POINSP AT $!<this.definition.points[$!<i>].position>

    -- Arc
    else

      NEW CURVE  AT $!<this.definition.points[$!<i>].arc.position>
      RADIUS $!<this.definition.points[$!<i>].arc.radius>

      -- Fillet curve
      if(!this.definition.points[!i].type eq 'FILLET') then

        -- Workout polar point
        !polarPoint = !this.definition.points[!i].arc.pole()

        AT $!<polarPoint>
        CURTYPE FILLET

      -- Centre Curve
      elseif(!this.definition.points[!i].type eq 'CENTRE') then

        AT $!<this.definition.points[$!<i>].arc.position>

        -- Derive the control point
        !angle     = !this.definition.points[$!i].arc.angle()
        if(!this.definition.points[$!i].arc.sense.not()) then
          !cPosition = !this.definition.points[$!i].arc.anglePosition(!this.definition.points[$!i].arc.startAngle - !angle / 2)
        else
          !cPosition = !this.definition.points[$!i].arc.anglePosition(!this.definition.points[$!i].arc.startAngle + !angle / 2)
        endif

        CURTYPE CENTRE
        CPOSITION $!<cPosition>

      endif

    endif

  enddo

  -- Return
  !!ce       = !reference
  return true

endmethod
-- End of method definition for .create() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modify was successful
--
------------------------------------------------------------------------

define method .modify() is BOOLEAN

  -- Initialise Variables
  !reference = !!ce

  -- Move to creation area
  !!ce       = !this.genericSection

  -- Modify

  -- Return
  !!ce       = !reference

  return true

endmethod
-- End of method definition for .modify() BOOLEAN

