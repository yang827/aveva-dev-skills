--   Group:
--     Keyword:     Surface Treatment
--   Module:        All
-- Author:          Sun You
--  Created:        <date/time>
--
--
-- Description:
--   Object getting information which related to surface treatment
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getCeMemberWithOuprtr(DBREF,STRING) -                   Getting All Elements with OUPRTR attribute is existed
--  getCoatingList(DBREF)            -                   Getting All Coating List of selected surface treatment
--  getMatchingFromCondition(ARRAY,STRING,STRING) -                   Getting matched table item with selected spec or face code
--  getTableGroup(STRING)            -                   Getting all TABGRO with PURPOSE
--  getTableItems(ARRAY)             -                   Getting all Table Items below Table group
--  querySelection(DBREF)            ARRAY               Selection table query for getting all table items
--
------------------------------------------------------------------------

define object SURFACETREATMENT
   member .coatingList   is ARRAY
   member .tableGroup    is ARRAY
   member .tableItems    is ARRAY
   member .modelList     is ARRAY
   member .matchingItems  is ARRAY
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .getCoatingList()
--
-- Description: Getting All Coating List of selected surface treatment
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCoatingList(!element is DBREF)

  !this.coatingList = object ARRAY()

-- Setup controls for PML containers
  !allCoatings = !element.members
  if (!allCoatings.size().eq(0) ) then
      !!alert.warning('Selected element has no coatings defined')
  else

-- Setup a format object
  !thicknessFmt = object FORMAT()
  !thicknessFmt.dp            = 2
  !thicknessFmt.dimension     = 'L'
  !thicknessFmt.label         = ||
  !thicknessFmt.trailZeros    = false

  if (!!isImperialLength('DIST')) then
    !thicknessFmt.units = 'THOU'
  else
    !thicknessFmt.units = 'MICRONS'
  endif

-- Generate data for rows
      do !item values !allCoatings
        !rowData = object ARRAY()
        if (!item.pairef.set() ) then
           if (NOT BADREF(!item.pairef)) then
               !rowData[1] = !item.pairef.desc
               !rowData[2] = !item.pairef.maker
           else
               -- if paint ref is Badref, skip
               skip
           endif
        else
          -- if paint ref is Null, skip
           skip
        endif

-- This part currently assumes MM DIST and converts to MICRONS for display
        !rowData[3] = !item.cthick.string(!thicknessFmt)
        !this.coatingList.append(!rowData)
      enddo
  endif

endmethod
-- End of method definition for .getCoatingList()

------------------------------------------------------------------------
--
-- Method:      .getTableGroup()
--
-- Description: Getting all TABGRO with PURPOSE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTableGroup(!parameter is STRING)
   !this.tableGroup = object ARRAY()

   var !tabGro collect all TABGRO with PURP eq $!parameter
   !this.tableGroup = !tabGro

endmethod
-- End of method definition for .getTableGroup()

------------------------------------------------------------------------
--
-- Method:      .getTableItems()
--
-- Description: Getting all Table Items below Table group
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTableItems(!allTabGroups is ARRAY)

   !this.tableItems = object ARRAY()

   do !idx index !allTabGroups
      !tableGroup = !allTabGroups[!idx].dbref()
      !tableItem = !this.querySelection(!tableGroup)

      if (!tableItem.set()) then
          !this.tableItems.appendArray(!tableItem)
      endif

   enddo

endmethod
-- End of method definition for .getTableItems()


------------------------------------------------------------------------
--
-- Method:      .querySelection()
--
-- Description: Selection table query for getting all table items
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .querySelection(!scope is DBREF) is ARRAY

    !selection = object SELECTIONTABLE(!scope)
    !tabItems = !selection.choose('RAW',FALSE)
    return !tabItems
endmethod
-- End of method definition for .querySelection()

------------------------------------------------------------------------
--
-- Method:      .getCeMemberWithOuprtr()
--
-- Description: Getting All Elements with OUPRTR attribute is existed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCeMemberWithOuprtr(!dbele is DBREF, !filter is STRING)

  !this.modelList = object ARRAY()

  !memberList = object COLLECTION()
  !memberList.scope(!dbele)
  if (!filter eq 'ALL') then
  else
     !memberList.addtype(!filter)
  endif
  !memberList.filter(object Expression('UNSET(OUPRTR) OR NOT UNSET(OUPRTR)'))

  !this.modelList = !memberList.results()

endmethod
-- End of method SelectCeMember()

------------------------------------------------------------------------
--
-- Method:      .getMatchingFromCondition()
--
-- Description: Getting matched table item with selected spec or face code
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMatchingFromCondition(!dbele is ARRAY, !ques is STRING, !ans is STRING)

  !this.matchingItems = object ARRAY()

  do !idx index !dbele
      !selectionTable = object SELECTIONTABLE(!dbele[!idx].dbref())

      !questions = object ARRAY()
      !answers = object ARRAY()

      !questions[1] = !ques
      !answers[1] = !ans

      do !cTables index !selectionTable.getTypes()
         !selectionTable.settype(!cTables)

         !choiceItems = !selectionTable.choose(!questions, !answers, |TEXT|, TRUE)

         if (!choiceItems.unset()) then
            skip
         else
            if ( !choiceItems.size() neq 1 ) then
               -- at this moment, matched item for question must have to unique.
               -- We will be implemented for multiple answer.
               return
            else
            !this.matchingItems.appendArray(!choiceItems[1])
         endif

         endif
      enddo

  enddo

endmethod
-- End of method definition for .getMatchingFromCondition()
