--
-- Description:
-- Repeat definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the attached view
--  createTemplateView()             -                   Create form to display the selected Design Template
--  showTemplate()                   -
--  showTemplate(DBREF)              -                   Display the given Design Template
--  tmplView()                       -                   Constructor
--

define object TMPLVIEW

  -- Have active graph view?
  member .graphView           is BOOLEAN
  -- Form linked to this object
  member .linkedForm          is FORM
  -- view token of linked view
  member .viewToken           is REAL
  -- displayed Design Template
  member .currentTemplate   is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      tmplView
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tmplView()

  -- Initialise Variables
  !this.graphView = false

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the attached view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Initialise Variables
  !this.graphView = false
  if(!this.linkedForm.set()) then
    !this.linkedForm.hide()
  endif

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      setTemplate
--
-- Description: Display the current selected Design Template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showTemplate()

  -- Get current template
  !temp = !!tmpGetCurrentTemplate()
  if(badref(!temp)) then
    !!alert.warning('No Design Template Selected')
    return
  else
    !this.currentTemplate = !temp
  endif

  !this.showTemplate(!temp)

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      showTemplate
--
-- Description: Display the given Design Template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showTemplate(!templateElement is DBREF)

  -- Check for valid template
  if( badref(!templateElement) ) then
    !vol = object VOLUME()
  else
    !vol = object VOLUME(!templateElement)
  endif

  -- set a default view size for a Template with no geometry
  if( !vol.unset() ) then
    !begin = object POSITION('E2000mm N2000mm U2000mm wrt world')
    !end   = object POSITION('W2000mm S2000mm D2000mm wrt world')
    !vol = object VOLUME(!begin,!end)
  endif

  -- extend the view a bit - to allow for zero dimension
  !box = !vol.box()
  !box.xlength = !box.xlength + 100mm
  !box.ylength = !box.ylength + 100mm
  !box.zlength = !box.zlength + 100mm
  !vol = object VOLUME(!box)

  -- Create the next available view if none already created
  if (!this.graphView.not()) then
    !this.createTemplateView()
    handle any
      REM ALL ADD $!templateElement
      AUTO $!templateElement
      return
    endhandle
    -- Create the next valid drawlist
    !this.viewToken  = !!gphDrawlists.createDrawlist()
  endif

  !this.linkedForm.show()
  handle (61,113)
    -- user has manually deleted the view
    !this.createTemplateView()
    handle any
      REM ALL ADD $!templateElement
      AUTO $!templateElement
      return
    endhandle
  endhandle

  !!gphDrawlists.attachView(!this.viewToken,!this.linkedForm.view)
  handle (61,113)
    -- user has manually deleted the view
    REM ALL ADD $!templateElement
    AUTO $!templateElement
    return
  endhandle

  --Create a new drawlist
  !drawlist = !!gphDrawlists.drawlist(!this.viewToken)
  !drawlist.removeAll()
  !drawlist.add(!templateElement)
  !!gphViews.limits(!this.linkedForm.view, !vol)
  !this.linkedForm.show()

endmethod
-- End of function definition

------------------------------------------------------------------------
--
-- Method:      createTemplateView
--
-- Description: Create form to display the selected Design Template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createTemplateView()

  !linkedForm      = !!gphViews.addDesignform()
  !this.linkedForm = !linkedForm
  !this.linkedForm.formTitle = 'Design Template View'
  !apps[1]         = 'DTMP'
  !!appFormCntrl.registerForm(!this.linkedForm, !apps, ARRAY(), false, false)
  !this.graphView  = true

endmethod
-- End of function definition
