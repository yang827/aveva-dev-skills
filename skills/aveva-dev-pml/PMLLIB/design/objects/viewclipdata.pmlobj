--
--
-- Description:
-- Stores the clip data for a 3D View. It is a member of each form definition
-- for Design Views. This object replaces the forms (one for each view) that
-- stored the clipping data.
--
------------------------------------------------------------------------

define object VIEWCLIPDATA

  member .pos   is POSITION
  member .xLen  is REAL
  member .yLen  is REAL
  member .zLen  is REAL
  member .ori   is ORIENTATION

endobject
-- End of object definition for VIEWCLIPDATA
