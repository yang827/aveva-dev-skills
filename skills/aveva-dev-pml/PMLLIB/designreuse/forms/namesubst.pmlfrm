-- Created:         Mon Jan 12    11:01:36  2011
--
-- Description:
-- Form to display Name map values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addEntry()                       -                   Add to grid
--  apply()                          -
--  beforeCellUpdateHandler(ARRAY)   -                   Callback on grid control before cell update
--  browserOpen()                    -                   Show standard open browser
--  browserSave()                    -                   Show standard save browser
--  clear()                          -                   Clear grid
--  editData(STRING,STRING,REAL)     -                   Edit workspace
--  findData(STRING,REAL)            BOOLEAN             Find in workspace
--  init()                           -                   Initialisation of the form
--  loadFile(FILE)                   -                   Load from file
--  loadFrom(ARRAY)                  -                   Load by array
--  loadFromMap()                    -                   Load from map object
--  namesubst()                      -                   Constructor
--  ok()                             -                   Ok
--  reload()                         -                   Reload map object and refresh grid
--  removeData(STRING)               -                   Remove from workspace
--  removeEntry()                    -                   Remove from grid
--  storeFile(FILE)                  -                   Save to file
--  storeToMap()                     -                   Save to map object
--  update()                         -                   Update/refresh grid
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!namesubst dialog

  button .saveToFile at xmin ymax+0.2  tooltip 'Save to File' pixmap width 16 height 16
  button .openFromFile at xmin+3 tooltip 'Open File' pixmap width 16 height 16
  button .createEntry at xmin+3 tooltip 'Create' pixmap width 16 height 16
  button .deleteEntry at xmin+3 tooltip 'Delete' pixmap width 16 height 16
  button .refreshEntry at xmin+3 tooltip 'Refresh' pixmap width 16 height 16

  frame .matFrame 'Name Map' at x0 ymax+0.2

    -- Container gadget for the Grid Control
    container .netFrame PMLNetCONTROL 'NET' at x1 ymax width 40 height 14

  exit

  path left
  button .apply   ' Apply' at xmax form-size ymax form Apply
  button .cancel  'Cancel'                             Cancel
  button .ok      '  OK  '                             Ok

  -- Members
  member .headings     is ARRAY
  member .rowSet       is ARRAY
  member .totalNumber  is REAL

  -- Map object
  member .nameMap      is NAMESUBSTMAP

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .displayCtrl  is NETGRIDCONTROL

  -- Grid input/output
  member .saveFile     is FILE
  member .openFile     is FILE

exit
-- End of form definition for !!namesubst
------------------------------------------------------------------------
--
-- Method: namesubst()
--
------------------------------------------------------------------------
define method .namesubst()

  -- form setup
  !this.formTitle    = 'Name Map Summary'
  !this.iconTitle    = 'map'
  !this.cancelCall   = ''
  !this.callback     = '!this.init()'
  !this.formRevision = '$Revision: 1.0 $ '

  -- Pixmaps
  !this.saveToFile.addPixmap(!!pml.getPathName('savework16.png'))
  !this.openFromFile.addPixmap(!!pml.getPathName('openbrowser.png'))
  !this.createEntry.addPixmap(!!pml.getPathName('create12.png'))
  !this.deleteEntry.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.refreshEntry.addPixmap(!!pml.getPathName('refresh16.png'))

  -- Callbacks
  !this.saveToFile.callback   = '!this.browserSave()'
  !this.openFromFile.callback = '!this.browserOpen()'
  !this.createEntry.callback  = '!this.addEntry()'
  !this.deleteEntry.callback  = '!this.removeEntry()'
  !this.refreshEntry.callback = '!this.reload()'
  !this.ok.callback           = '!this.ok()'
  !this.apply.callback        = '!this.apply()'

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl = object NETGRIDCONTROL()

  -- Add .net control to PML container
  !this.netFrame.control = !this.displayCtrl.handle()

  -- Add PML event handlers to .net control
  !this.displayCtrl.addeventhandler('BeforeCellUpdate', !this, 'beforeCellUpdateHandler')

  -- Add grid control style
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.outlookGroupStyle(false)
  !this.displayCtrl.fixedHeaders(true)
  !this.displayCtrl.fixedRows(true)
  !this.displayCtrl.gridHeight(2000.0)
  !this.displayCtrl.editableGrid(true)
  !this.displayCtrl.columnSummaries(true)

  -- Name map
  !this.nameMap = object nameSubstMap()

endmethod
-- End of method definition for .namesubst()
------------------------------------------------------------------------
--
-- Method: init()
--
------------------------------------------------------------------------
define method .init()

  -- Set default save directory and file
  !this.saveFile = object FILE('%PDMSUSER%\namemap.xml')
  !this.openFile = object FILE('%PDMSUSER%\namemap.xml')

  -- Clear the grid and data object
  !this.clear()

  -- Set grid control headings
  !this.headings.append('Old Name')
  !this.headings.append('New Name')

  -- Get data
  !this.loadFromMap()

  -- Update
  !this.update()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method: update()
--
------------------------------------------------------------------------
define method .update()

  -- Set grid
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Name Map', !this.headings, !this.rowSet, '^Old Name'))

endmethod
-- End of method .update()


-----------------------------------------------------------------------
--
-- Method: reload()
--
------------------------------------------------------------------------
define method .reload()

  !this.loadFromMap()
  !this.update()

endmethod
-- End of method .reload()

-----------------------------------------------------------------------
--
-- Method: browserSave(GADGET)
--
------------------------------------------------------------------------
define method .browserSave()

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !browser         = object PMLFILEBROWSER('SAVE')
  !directory       = !this.saveFile.directory().fullName()
  !seedFile        = !this.saveFile.entry()
  !title           = 'Save Name Map'
  !extensionString = 'xml files (*.xml)|*.xml'

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Write the output file
    !this.storeFile(object FILE(!browser.file()))

  endif

endmethod
-- End of method .browserSave(GADGET)

-----------------------------------------------------------------------
--
-- Method: browserOpen(GADGET)
--
------------------------------------------------------------------------
define method .browserOpen()

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !browser         = object PMLFILEBROWSER('OPEN')
  !directory       = !this.openFile.directory().fullName()
  !seedFile        = !this.openFile.entry()
  !title           = 'Open Name Map'
  !extensionString = 'xml files (*.xml)|*.xml'

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Write the output file
    !this.loadFile(object FILE(!browser.file()))

  endif

endmethod
-- End of method .browserOpen(GADGET)

------------------------------------------------------------------------
--
-- Method: addEntry()
--
------------------------------------------------------------------------
define method .addEntry()

  -- Add entry to the grid

  !rowData = ARRAY()
  !rowData.append('OLD')
  !rowData.append('NEW')
  !this.displayCtrl.addRow(!rowData)
  !this.rowSet.append(!rowData)
  !count = !this.displayCtrl.getNumberRows()
  !this.displayCtrl.selectRow(!count)

endmethod
-- End of method definition for .addEntry()

------------------------------------------------------------------------
--
-- Method: removeEntry()
--
------------------------------------------------------------------------
define method .removeEntry()

  -- Remove selected entries from the grid
  !rows  = !this.displayCtrl.getSelectedRows()
  if (!rows.empty()) then
    !!alert.error('No item selected')
    return
  endif

  do !index ind !rows
    !rowData = !rows[!index]
    !name = !rowData[1]
    !this.removeData(!name)
  enddo

  !this.displayCtrl.deleteSelectedRows()

endmethod
-- End of method definition for .removeEntry()

------------------------------------------------------------------------
--
-- Method: clear()
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.displayCtrl.clearGrid()

  -- Clear the headings
  !this.headings.clear()

  -- Clear the data
  !this.rowSet.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method: loadFromMap()
--
------------------------------------------------------------------------
define method .loadFromMap()

  -- Initialise variables

  !this.totalNumber = !this.nameMap.count()
  !oldNames = !this.nameMap.keys()
  !newNames = !this.nameMap.values()

  -- Clear the data
  !this.rowSet.clear()

  do !index ind !oldNames
    !rowData = ARRAY()
    !rowData.append(!oldNames[!index])
    !rowData.append(!newNames[!index])
    !this.rowSet.append(!rowData)
  enddo

endmethod
-- End of method definition for .loadFromMap()

------------------------------------------------------------------------
--
-- Method: loadFrom(!arg is ARRAY)
--
------------------------------------------------------------------------
define method .loadFrom(!arg is ARRAY)

  !this.rowSet.clear()
  !this.rowSet = !arg

endmethod
-- End of method definition for .loadFrom(!arg is ARRAY)

------------------------------------------------------------------------
--
-- Method: storeToMap()
--
------------------------------------------------------------------------
define method .storeToMap()

  !this.nameMap.clear()

  do !index ind !this.rowSet
    !rowData = !this.rowSet[!index]
    !oldName = !rowData[1]
    !newName = !rowData[2]
    !this.nameMap.add(!oldName, !newName)
  enddo

endmethod
-- End of method definition for .storeToMap()

------------------------------------------------------------------------
--
-- Method: findData()
--
------------------------------------------------------------------------
define method .findData(!data is STRING, !column is REAL) is BOOLEAN

  do !index ind !this.rowSet
    !rowData = !this.rowSet[!index]
    !name = !rowData[!column]
    if (!name.eq(!data)) then
      return true
    endif
  enddo
  return false

endmethod
-- End of method definition for .findData()

------------------------------------------------------------------------
--
-- Method: editData()
--
------------------------------------------------------------------------
define method .editData(!key is STRING, !data is STRING, !column is REAL)

  do !index ind !this.rowSet
    !rowData = !this.rowSet[!index]
    !oldName = !rowData[1]
    if (!oldName.eq(!key)) then
      !rowData[!column] = !data
      !this.rowSet[!index] = !rowData
      break
    endif
  enddo

endmethod
-- End of method definition for .editData()

------------------------------------------------------------------------
--
-- Method: removeData()
--
------------------------------------------------------------------------
define method .removeData(!delName is STRING)

  do !index ind !this.rowSet
    !rowData = !this.rowSet[!index]
    !name = !rowData[1]
    if (!name.eq(!delName)) then
      !this.rowSet.remove(!index)
      break
    endif
  enddo

endmethod
-- End of method definition for .removeData()

------------------------------------------------------------------------
--
-- Method: storeFile(FILE)
--
-- Description: The current rowset displayed is stored to file through the map object.
--              In case a file is stored but the dialog later on is left with Cancel
--              the map object should remain unchanged.
--              Thereby,
--              1. Remember current row set
--              2. Remember current map object
--              3. Update map object by current row set
--              4. Save map object to file
--              5. Ensure map object is restored
--              6. Ensure current rowset is restored
--
------------------------------------------------------------------------
define method .storeFile(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveFile = !fileObj

  -- Original workspace
  !origWorkspace = !this.rowSet

  -- Original map
  !this.loadFromMap()
  !origMap = !this.rowSet

  -- Store workspace to file through map object
  !this.loadFrom(!origWorkspace)
  !this.storeToMap()
  !this.nameMap.savetofile(!this.saveFile.directory().fullName() & '\' & !this.saveFile.entry())

  -- Restore original map
  !this.loadFrom(!origMap)
  !this.storeToMap()

  -- Restore workspace
  !this.loadFrom(!origWorkspace)

endmethod
-- End of method definition for .storeFile(FILE)

------------------------------------------------------------------------
--
-- Method: loadFile(FILE)
--
-- Description: The current rowset displayed is loaded from file through the map object.
--              In case a file is loaded but the dialog later on is left with Cancel
--              the map object should remain unchanged.
--              Thereby,
--              1. Remember current map object
--              2. Load map object from file
--              3. Update current row set by map object
--              4. Ensure map object is restored
--
------------------------------------------------------------------------
define method .loadFile(!fileObj is FILE)

  -- Store browser settings on this form
  !this.openFile = !fileObj

  -- Original map
  !this.loadFromMap()
  !origMap = !this.rowSet

  -- Load workspace from file through map object
  -- Loadfrom file appends to map object, thereby first clear it
  !this.nameMap.clear()
  !this.nameMap.loadfromfile(!this.openFile.directory().fullName() & '\' & !this.openFile.entry())
  !this.loadFromMap()
  !workspace = !this.rowSet

  -- Restore original map
  !this.loadFrom(!origMap)
  !this.storeToMap()

  -- Restore workspace
  !this.loadFrom(!workspace)

  -- Expose data
  !this.update()

endmethod
-- End of method definition for .loadFile(FILE)

------------------------------------------------------------------------
--
-- Method: ok()
--
------------------------------------------------------------------------
define method .ok()

  !this.storeToMap()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method: apply()
--
------------------------------------------------------------------------
define method .apply()

  !this.storeToMap()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method: beforeCellUpdateHandler()
--
-- Description: Callback on grid control before cell update
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      STRING      New value
--    1   R      STRING      Row tag
--    2   R      STRING      Column tag
--    3   R      BOOLEAN     A return argument to confirm valid field - false aborts the update
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .beforeCellUpdateHandler(!eArgs is ARRAY)

  !data = !eArgs[0]
  !rowTag = !eArgs[1]
  !columnTag = !eArgs[2]

  !row = !this.displayCtrl.getRow( !rowTag)
  !key = !row[1]
  !value = !row[2]

  !eArgs[3] = true
  !column = 0
  !changed = false
  if(!columnTag.eq('Old Name')) then
    !column = 1
    !changed = !key.neq(!data)
  elseif (!columnTag.eq('New Name')) then
    !column = 2
    !changed = !value.neq(!data)
  else
    !eArgs[3] = false
  endif

  -- Do the change if not already in map
  if (!changed) then
    if (!this.findData(!data, !column)) then
      !eArgs[3] = false
      !!alert.error('Duplicates')
    else
      !this.editData(!key, !data, !column)
    endif
  endif

endmethod
-- End of method definition for .beforeCellUpdateHandler()
