--
--  File:            buildasmblyname.pmlfnc
--    Type:          Function Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Undefined
--  Author:          Undefined
--  Created:         Tue May 24 16:48:38 2011
--
--  Description:     Analyze the assembly path and request new name of nodes with numerals in name
--
----------------------------------------------------------------------
define function !!buildASMBLYName(!namn is STRING, !asName is STRING) is STRING

  VAR !device DEVICE

  -- Get the map object
  !MCopyMap = object nameSubstMap()

  !newName = STRING()
  !oldName = STRING()

  !oldName = !namn

  -- Check if this name already is mapped
  if (!MCopyMap.tryGetValue(!oldName, !newName)) then
     return !newName
  endif

  !newName = !oldName

  -- get name of owner
  !owner = STRING()
  !newOwner = STRING()
  !owner = ''
  !newOwner = !owner
  !localNames = !oldName.split('/')
  !localNames.RemoveLast()

  -- not top level assembly,
  if (!localNames.size() neq 0) then
     !asNameOwner = !localNames.Last()
     !first = TRUE
     do !index ind !localNames
        if (!first) then
           !first = FALSE
        else
           !owner = !owner + '/'
        endif
        !owner = !owner + !localNames[!index]
     enddo

     -- Check if owner name already is mapped
     if (not !MCopyMap.tryGetValue(!owner, !newOwner)) then
        !newOwner = !!buildASMBLYName(!owner, !asNameOwner)
     endif
     !newOwner = !newOwner + '/'
  endif
  !oldName2 = !newOwner + !asName
  !newName = !oldName2

  -- If numerals in local name, consider name change, otherwise keep the same name
  !nameChange = false
  if(!asName.occurs('0').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('1').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('2').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('3').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('4').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('5').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('6').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('7').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('8').gt(0)) then
    !nameChange = true
  elseif (!asName.occurs('9').gt(0)) then
    !nameChange = true
  endif

  if (!nameChange) then
     if (!device.upCase().eq('GRAPHICS')) then
        !str = 'Specify local assembly name to map to for ' + !oldName2
        !newName = !!alert.Input( !str, !asName)
        !newName = !newOwner + !newName
     endif
  endif

  -- Add the new name to the mapping object
  !MCopyMap.add(!oldName, !newName)

  return !newName

endfunction
