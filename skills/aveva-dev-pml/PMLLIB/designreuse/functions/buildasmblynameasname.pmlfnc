define function !!buildASMBLYNameASNAME(!namn is STRING, !asName is STRING) is STRING

  !newAsName = STRING()
  !newAsName = !asName

  !newName = !!buildASMBLYName(!namn, !asName)
  !localNames = !newName.split('/')

  !newAsName = !localNames.Last()

  return !newAsName

endfunction
