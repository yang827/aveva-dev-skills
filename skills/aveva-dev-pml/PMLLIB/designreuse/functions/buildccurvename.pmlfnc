define function !!buildCCURVEName(!namn is STRING, !curveType is STRING) is STRING

  VAR !device DEVICE

  -- Get the map object
  !MCopyMap = object nameSubstMap()

  !newName = STRING()
  !oldName = STRING()
  !surfname = STRING()
  !groupname = STRING()
  !testIndex = 0.0

  !oldName = !namn

  -- Check if this name already is mapped

  if (!MCopyMap.tryGetValue(!oldName, !newName)) then
     return !newName
  endif

  --Get the transferset object
  !tset = object TransferSet()
  !newName = !oldName
  -- No change so lets check the groupname
  !surfaces = !tset.SOURCESURFACES()

  -- Check for groupname
  DO !surf VALUES !surfaces
     if (!curveType.eq('FRAM')) then
       !groupname = !tset.SOURCEGROUPFRAME(!surf)
     elseif (!curveType.eq('WTRL')) then
       !groupname = !tset.SOURCEGROUPWATER(!surf)
     elseif (!curveType.eq('BUTT')) then
       !groupname = !tset.SOURCEGROUPBUTT(!surf)
     endif

     !testIndex = !oldName.Match(!groupname)
     if ( !testIndex.eq(1)) then
         !surfname = !surf
         BREAK
     endif
  ENDDO

  if ( !testIndex.eq(1)) then
     -- Find name of surface to map to
     !sourceSurface = !!buildCSURFName(!surfname)

     if (!curveType.eq('FRAM')) then
        !sourceGroupName = !tset.CURRENTGROUPFRAME(!sourceSurface)
     elseif (!curveType.eq('WTRL')) then
        !sourceGroupName = !tset.CURRENTGROUPWATER(!sourceSurface)
     elseif (!curveType.eq('BUTT')) then
        !sourceGroupName = !tset.CURRENTGROUPBUTT(!sourceSurface)
     endif

     !newName = !oldName.replace(!groupname, !sourceGroupName)
  endif

  if ( !newName.eq(!oldName)) then
     -- Try to change ship letters.
     !fromStr = !tset.SOURCESHIPLETTERS()
     !toStr = !tset.CURRENTSHIPLETTERS()
     if ( !fromStr neq !toStr ) then
        !newName = !oldName.replace( !fromStr, !toStr )
     endif
  endif

  if ( !newName.eq(!oldName)) then
     -- No automatic change of name, ask user for mapping.
     if (!device.upCase().eq('GRAPHICS')) then
        !str = 'Specify name to map to for shell curve ' + !oldName
        !newName = !!alert.Input( !str, !newName)
     endif
  endif

  -- Add the new map to the mapping object
  !MCopyMap.add(!oldName, !newName)

  return !newName

endfunction
