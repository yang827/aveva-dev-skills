define function !!buildCSEAMName(!namn is STRING) is STRING

  VAR !device DEVICE

  -- Get the map object
  !MCopyMap = object nameSubstMap()

  !newName = STRING()
  !oldName = STRING()

  !oldName = !namn

  -- Check if this name already is mapped
  if (!MCopyMap.tryGetValue(!oldName, !newName)) then
     return !newName
  endif
  --Get the transferset object
  !tset = object TransferSet()
  !newName = !oldName
  -- No change so lets check the groupname
  !surfaces = !tset.SOURCESURFACES()
  DO !surf VALUES !surfaces
     !groupname = !tset.SOURCEGROUPSEAM(!surf)
     !testIndex = !oldName.Match(!groupname)
     if ( !testIndex.eq(1)) then
        -- Find name of surface to map to
        !sourceSurface = !!buildCSURFName(!surf)
        !sourceGroupName = !tset.CURRENTGROUPSEAM(!sourceSurface)
        !newName = !oldName.replace(!groupname, !sourceGroupName)
        BREAK
     endif
  ENDDO

  if ( !newName.eq(!oldName)) then
     -- Try to change ship letters.
     !fromStr = !tset.SOURCESHIPLETTERS()
     !toStr = !tset.CURRENTSHIPLETTERS()
     if ( !fromStr neq !toStr ) then
        !newName = !oldName.replace( !fromStr, !toStr )
     endif
  endif

  if ( !newName.eq(!oldName)) then
     -- No automatic change of name, ask user for mapping.
     if (!device.upCase().eq('GRAPHICS')) then
        !str = 'Specify name to map to for shell seam ' + !oldName
        !newName = !!alert.Input( !str, !newName)
     endif
  endif

  -- Add the new map to the mapping object
  !MCopyMap.add(!oldName, !newName)

  return !newName


endfunction
