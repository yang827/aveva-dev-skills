define function !!builddrwgname(!drwgNameCE is STRING ) is STRING
--
-- If the drawing name starts with old ship letters exchange to new ship letters
--
   !tset = object TransferSet()
   !prefix = !tset.SOURCESHIPLETTERS()
   !newprefix = !tset.CURRENTSHIPLETTERS()
   !newDrwgName = !drwgNameCE
   !pos = !newDrwgName.Match(!prefix)
   if !pos.eq(1) then
      !newDrwgName = !newDrwgName.replace(!prefix,!newprefix)
   endif
   return !newDrwgName
endfunction
