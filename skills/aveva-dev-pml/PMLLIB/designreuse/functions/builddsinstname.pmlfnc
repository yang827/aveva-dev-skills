define function !!buildDSINSTName(!namn is STRING) is STRING

  -- Get the map object
  !MCopyMap = object nameSubstMap()

  !newName = STRING()
  !oldName = STRING()

  !oldName = !namn

  -- Check if this name already is mapped
  if (!MCopyMap.tryGetValue(!oldName, !newName)) then
     return !newName
  endif

  -- Add suffix to name
  !newName = !oldName + |_copy|

  -- Add the new map to the mapping object
  !MCopyMap.add(!oldName, !newName)

  return !newName

endfunction
