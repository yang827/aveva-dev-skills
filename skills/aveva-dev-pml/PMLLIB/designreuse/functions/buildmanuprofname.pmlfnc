define function !!buildManuProfName(!namn is STRING, !block is STRING) is STRING

  VAR !device DEVICE

  -- Get the map object
  !MCopyMap = object nameSubstMap()

  !newName = STRING()
  !oldName = STRING()
  !changed = false

  !oldName = !namn

  -- Check if this name already is mapped
  if (!MCopyMap.tryGetValue(!oldName, !newName)) then
     return !newName
  endif

  -- Get the transferset object
  !tset = object TransferSet()

  !newName = !oldName

  -- Try to see if the manu prof name begins with a block name.
  !testIndex = !oldName.Match(!block)
  if ( !testIndex.eq(1)) then
     -- Find name of block to map to
     !sourceBlock = !!buildBLOCKName(!block)
     if (!sourceBlock.neq('')) then
        !newName = !oldName.replace(!block, !sourceBlock)
        !changed = true
     endif
  endif

  if ( !newName.eq(!oldName)) then
     -- Try to change ship letters.
     !fromStr = !tset.SOURCESHIPLETTERS()
     !toStr = !tset.CURRENTSHIPLETTERS()
     if ( !fromStr neq !toStr ) then
        !newName = !oldName.replace( !fromStr, !toStr )
     endif
  endif

  if (not !changed) then
     if ( !newName.eq(!oldName)) then
        -- No automatic change of name, ask user for mapping.
        if (!device.upCase().eq('GRAPHICS')) then
           !str = 'Specify name to map to for manufacturing profile ' + !oldName
           !newName = !!alert.Input( !str, !newName)
        endif
     endif
  endif

  -- Add the new map to the mapping object
  !MCopyMap.add(!oldName, !newName)

  return !newName

endfunction
