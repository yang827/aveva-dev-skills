-- Define object
define object NAMESUBSTMAP
  import 'MCopyTools'
  handle any
  endhandle

endobject
-- End of object definition for NAMESUBSTMAP

-- Define method
define method .nameSubstMap()
  using namespace 'Aveva.Marine.MCopy.Tools'
  -- Get the map object
  !!map = object StrStrMap()

endmethod
-- End of method definition for .nameSubstMap()

-- Define method
define method .add(!key is STRING, !value is STRING) is BOOLEAN

  return !!map.Add(!key, !value)

endmethod
-- End of method definition for .add(!key is STRING, !value is STRING) is BOOLEAN

-- Define method
define method .clear()

  !!map.Clear()

endmethod
-- End of method definition for .clear

-- Define method
define method .containsKey(!key is STRING) is BOOLEAN

  return !!map.ContainsKey(!key)

endmethod
-- End of method definition for .containsKey(!key is STRING) is BOOLEAN

-- Define method
define method .containsValue(!value is STRING) is BOOLEAN

  return !!map.ContainsValue(!value)

endmethod
-- End of method definition for .containsValue(!value is STRING) is BOOLEAN

-- Define method
define method .count() is REAL

  return !!map.Count()

endmethod
-- End of method definition for .count() is REAL

-- Define method
define method .remove(!key is STRING)

  return !!map.Remove(!key)

endmethod
-- End of method definition for .remove(!key is STRING)

-- Define method
define method .tryGetValue(!key is STRING, !value is STRING) is BOOLEAN

  return !!map.TryGetValue(!key,!value)

endmethod
-- End of method definition for .tryGetValue(!key is STRING, !value is STRING) is BOOLEAN

-- Define method
define method .saveToFile(!fileName is STRING)

  return !!map.SaveToFile(!fileName)

endmethod
-- End of method definition for .saveToFile(!fileName is STRING)

-- Define method
define method .loadFromFile(!fileName is STRING)

  return !!map.LoadFromFile(!fileName)

endmethod
-- End of method definition for .loadFromFile(!fileName is STRING)

-- Define method
define method .keys() is ARRAY

  return !!map.Keys()

endmethod
-- End of method definition for .keys() is ARRAY

-- Define method
define method .values() is ARRAY

  return !!map.Values()

endmethod
-- End of method definition for .values() is ARRAY
