--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appDiagMain()                    -                   Constructor method
--  initialise()                     -                   takes the place of the DES\GEN\ISYSTEM macro
--
------------------------------------------------------------------------
setup form !!appDiagMain at xr 0 yr 0 main

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size is now 16 because we can't change the size of icons on toolbars
  !iconSize = 16
  var !projectCode PROJECT CODE

  title     |AVEVA Diagrams (Project - $!projectCode) - Pipe|
  iconTitle |AVEVA Diagrams|
  revision  | $$Revision: 1.1 $ |
  !this.quitCall = |CALLIB XEXIT|

  -- Main bar Menu
  bar
  --  add |Design|    _sysDes
  --  add |Display|   _sysView
  --  add |Query|     _sysQry
  --  add |Utilities| _sysUtil
  --  add window
  --  add help
  exit

  -- define toolbar icons
  -- hdist 0
  -- valign centre
  -------------------------------------------
  -- Main toolbar
  -------------------------------------------
  -- get work
  -- button .mtbGetWork 'Get Work' tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |GETWORK|

  -- save work
  -- button .mtbSaveWork 'Save Work' tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- set pixmaps for above buttons
  -- !this.mtbGetWork.addPixmap(!!pml.getPathName('getwork' & !iconSize & '.png'))
  -- !this.mtbSaveWork.addPixmap(!!pml.getPathName('savework' & !iconSize & '.png'))

exit

------------------------------------------------------------------------
--
-- Method:      .appDiagMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDiagMain()

  -- set initialisation callback
  !this.initcall = '!this.initialise()'

  -- find current project and global status
  !project = current project
  !isGlobal = !project.isGlobal()

endmethod
-- End of method definition for .appDesMain()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: takes the place of the DES\GEN\ISYSTEM macro
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

endmethod
-- End of method definition for .initialise()
