-- Define function

import 'Aveva.Diagrams'
handle any
endhandle

define function !!autoNameElements()

  --using namespace 'Aveva.Diagrams'
  using namespace 'Aveva.Diagrams'

  --create PMLDiagramsNaming object
  !tool = object PMLDiagramsNaming()

  --create array that will be passed to c# object
  !coll = ARRAY()
  !errors = ARRAY()

  --get database elements references that require autoname
  !tool.GetItemsToAutoname(!coll)

  -- Autoname elements

  PROMPT DISMISS
  PROMPT OFF

  if (!coll.empty().not()) then
    do !i indices !coll
      !cancel = !tool.Notify()
      break if(!cancel)
      !dbElem = object DBREF(!coll[!i])
      !!ce = !dbElem
      !name = !!namOpt.nameString(!dbElem, '', false, false)
	  handle ANY
          !errors[!i] = !!Error.Text
          skip
      endhandle
      if (!name.unset().not()) then
        if(!name.occurs(' ').gt(0) ) then
          !errors[!i] = 'Name should not contain spaces. Evaluated name "$!name" contains spaces.'
          skip
        endif
        !dbElem.Name = '/' & !name
        handle (41,12)
          !errors[!i] = 'Name already exists.'
          skip
        elsehandle ANY
          !errors[!i] = !!Error.Text
          skip
        endhandle
      endif
    enddo
  endif

  -- Set name errors
  !tool.SetNameErrors(!errors)

endfunction
-- End of function definition for !!autoNameElements
