--   Group:         Export
--   Keyword:       SVG
--   Module:        Diagrams
--   Replaces:
--
-- Description:		Exports a diagram with given name to .svg files. Requires MS Visio to be installed.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
--
------------------------------------------------------------------------

import 'Aveva.Diagrams'
handle any
endhandle

define function !!exporttosvg(!docName is STRING) is BOOLEAN

	using namespace 'Aveva.Diagrams'
	!retVal = true
	
	!PMLDiagrams = object PMLDiagrams()
	!PMLDiagrams.ExportToSVG(!docName)
	handle any
		!retVal = false
		!msg = !!error.text
		write('$!msg')
	endhandle
	
	return !retVal
	
endfunction
