--
--  Description:     Function returning value of Diagrams option with given key. The value is given as text.
--
----------------------------------------------------------------------
import 'Aveva.Diagrams'
handle any
endhandle

define function !!getDiagramsOption(!key is STRING) is STRING

using namespace 'Aveva.Diagrams.PMLTools'

!manager = object PMLSETTINGSMANAGER()
return !manager.getSetting(!key)

endfunction
