--
--  Description:     Function to update Diagrams option with given key with value passed as string
--
----------------------------------------------------------------------
import 'Aveva.Diagrams'
handle any
endhandle

define function !!setDiagramsOption(!key is STRING, !value is STRING)

using namespace 'Aveva.Diagrams.PMLTools'

!manager = object PMLSETTINGSMANAGER()
!manager.setSetting(!key, !value)

endfunction
