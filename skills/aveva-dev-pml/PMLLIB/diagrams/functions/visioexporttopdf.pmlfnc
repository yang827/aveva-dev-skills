--   Type:          Function Definition
--   Group:         Export
--   Keyword:       PDF
--   Module:        Diagrams
--   Replaces:
--
-- Description:     Exports a diagram with given name to .pdf files. Requires MS Visio to be installed.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
--
------------------------------------------------------------------------

import 'Aveva.Diagrams'
handle any
endhandle

define function !!visioexporttopdf(!docName is STRING) is BOOLEAN

	using namespace 'Aveva.Diagrams'
	!retVal = true
	
	!pmlDiagrams = object PMLDIAGRAMS()
	!pmlDiagrams.visioExportToPDF(!docName)
	handle any
		!retVal = false
		!msg = !!error.text
		write('$!msg')
	endhandle
	
	return !retVal
	
endfunction
