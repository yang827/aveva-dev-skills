--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!adpDef4

-- Define form
setup form !!adpDef4

  -- define form members

  member .frameWidth is REAL
  !!adpDef4.frameWidth = 70

  !!adpDef4.formTitle     = 'Type 4 Defaults'
  !!adpDef4.iconTitle     = 'Type 4 Defaults'
----  !!adpDef4.callback      = '!!adpDef4Init()'
  !!adpDef4.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  path down
  vdist 0.2

  toggle .display ' Generate Type 4 Annotation ' at x0 ymax+0.2 call '!!cdNewFile = false'
  ---------------
  frame .genFrame 'General Settings' at xmin+1 ymax+0.2 width $!!adpDef4.frameWidth

    text   .offset   'Dimension Offset ' at xmin+1 ymax+0.2 call '!!cdNewFile = false' width 12 numeric
    text   .dimCopy  'Copy Dim Points from Type(s) ' call '!!cdNewFile = false' width 12 string

    option .dimFlag   call '!!cdNewFile = false' width 30

    toggle .endSymbols ' Display Cut End Symbols' call '!!cdNewFile = false'

    option .elev 'Steelwork Elevations ' call '!!cdNewFile = false'  width 14

    text   .tosPline 'TOS Pline ' width 6 scroll 6 string
    text   .naPline  'NA  Pline ' width 6 scroll 6 string
    toggle .coords   'Coordinates' call '!!cdNewFile = false'
    toggle .elevFmt  'Elevation Output Format +/- Notation' at xmin ymax+0.2 call '!!cdNewFile = false'

  exit
  ---------------
  frame .purpFrame  'Layer Purposes' at xmin.genFrame ymax+0.5 width $!!adpDef4.frameWidth

    text .dimPurpose    'Dimensions       ' at xmin+2 ymax+0.2 call '!!cdNewFile = false' width 3 scr 3 string
    text .labelPurpose  'Member Labels    ' call '!!cdNewFile = false' width 3 scr 3 string
    text .symbolPurpose 'Cut End Symbols  ' call '!!cdNewFile = false' width 3 scr 3 string

  exit
  ---------------
  frame .dimFrame 'Dimension Rules' at xmin.genFrame ymax+0.5 width $!!adpDef4.frameWidth

    text   .dimTypes 'Type ' at xmin.offset ymax+0.2 width 40 string
    text   .dimRule  'Rule ' at xmin.offset ymax+0.2 width 60 string
    list   .dimRules ''      at xmin.dimRule+6 ymax+0.2 call |!!adpDef4Rules('SELECT')| width 58 length 4

    option .dimEdit at xmax form-size ymin.dimTypes call |!!adpDef4Rules('EDIT')| width 13
  exit
  ---------------
  frame .pltxFrame 'Projection Line Text Settings' at xmin.genFrame ymax+0.5 width $!!adpDef4.frameWidth

    text .pltxEntry 'Pltx Entry ' at xmin.offset  ymax+0.2 call '!!cdNewFile = false' width 20 string
    text .pltxTos   'TOS Prefix ' at xmin ymax+0.2 call '!!cdNewFile = false' width 20 string
    text .pltxNa    'NA  Prefix ' at xmin ymax+0.2 call '!!cdNewFile = false' width 20 string

  exit
  ---------------
  button .ok     ' OK '   at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel


exit
-- End of form definition for !!adpDef4

-- define option gadget Dtext and Rtext arrays

  !dText[1] = 'Dimension & Projection Lines'
  !dText[2] = 'Projection Lines Only'
  !rText[1] = 'Dim&Proj'
  !rText[2] = 'DimOnly'
  !!adpDef4.dimFlag.dText = !dText
  !!adpDef4.dimFlag.rText = !rText

  !dText.clear()
  !dText[1] = 'Top of Steel'
  !dText[2] = 'Neutral Axis'
  !rText[1] = 'TOS'
  !rText[2] = 'NA'
  !!adpDef4.elev.dText = !dText
  !!adpDef4.elev.rText = !rText

  !dText.clear()
  !dText[1] = 'Insert After'
  !dText[2] = 'Insert Before'
  !dText[3] = 'Copy'
  !dText[4] = 'Replace'
  !dText[5] = 'Cut'
  !rText[1] = 'IA'
  !rText[2] = 'IB'
  !rText[3] = 'CP'
  !rText[4] = 'RP'
  !rText[5] = 'CT'
  !!adpDef4.dimEdit.dText = !dText
  !!adpDef4.dimEdit.rText = !rText

-- initial values used during development

  !dText.clear()
  !dText[1] = |MatchWild(FUNCTION of ZONE,'*Structural*')|
  !!adpDef4.dimRules.dText = !dText
  !!adpDef4.dimTypes.val = 'SCTN'
