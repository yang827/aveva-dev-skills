-- Kill existing form definition
kill !!adpDeveloper

-- Define form
setup form !!adpDeveloper

  -- setup members
  member .trackedView is DBREF $* View form is associated with using PADDCE tracking

  !!adpDeveloper.formTitle     = 'ADP Developer - keep smiling ;-) '
  !!adpDeveloper.iconTitle     = 'Developer'
  --!!adpDeveloper.autocall      = ''
  track 'PADDCE' call |!!adpDeveloperAct('TRACK')|
  !!adpDeveloper.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  path down
  vdist 0.2

  para   .view  width 15 Lines 1
  button .reload 'Reload Adp Forms' call 'call !!draftForms()'
  button .type4 'Update Type 4... ' call 'call !!adpAnno4(!!adpDeveloper.trackedView)'

exit
-- End of form definition for !!adpDeveloper
