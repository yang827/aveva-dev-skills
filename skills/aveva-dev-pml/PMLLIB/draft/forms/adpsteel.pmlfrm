------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCommand()                     -
--  adpSteel()                       -
--  changedFilter()                  -
--  cleanSelection()                 -
--  closeForm()                      -
--  deleteSheet(BOOLEAN)             -
--  editOptions()                    -
--  exec()                           -
--  filterSheets()                   -
--  init()                           -
--  initOpt()                        -
--  listSheets()                     -
--  regenerate()                     -
--  selectSheet()                    -
--  selectSheet(DBREF)               -
