--------------------------------------------------------------------------
setup form !!adpSteel

  !!adpSteel.formTitle     = 'Steelwork Detailing'
  !!adpSteel.iconTitle     = 'Steel ADP'
  !!adpSteel.initCall = '!!adpSteel.init()'
   member .sheets         is ARRAY
   member .sheetsFiltered is ARRAY

-- Bar Menu
  bar
  exit

-- standard menu object contains logic for add/remove menus
  member .stanMenu is LSTSTANDARDMENU

-- Body of form definition

  paragraph .adpLbLab  at x0 ymax+0.2 text 'Options: ' lines 1
  option    .adpLbName at xmax ymin width 27

  button    .adpLbEdit 'Edit...' at xmax ymin    call '!this.editOptions()'

  frame .selFrm 'Design Selection' at x0 ymax.adpLbName+0.3
      list   .selList   at x1 ymax multi width 43 height 10
      paragraph .selPara at xmin ymax text 'Selection expression' lines 1
      text   .selTxt    at xmin ymax   call '!this.addCommand()'  width 40 STRING
      button .selAdd    at xmax.selTxt  ymax-0.9  'Add'    call '!this.addCommand()'
  exit

  button .exec     'Generate Sheets'    at xcen-8   ymax+0.5    call '!this.exec()'

    frame  .sheetFrm 'Sheets' at x0 ymax.exec+0.3
    list   .sheetList at x1 ymax  call '!this.selectSheet()' width 43 len 10

    toggle .filterSel  'Only design selection sheets' at xmin ymax   call '!this.changedFilter()'
    toggle .filterUpd  'Only outdated sheets' at xmin ymax  call '!this.changedFilter()'

  exit

  button .refresh 'Refresh' at xmin.sheetFrm ymax+0.3 call '!this.init()'
  button .cancel   'Dismiss' at xmax form-size ymin cancel

  menu .listPopUp
    add |Regenerate|  |!this.regenerate()|
    add separator
    add |Delete|      |!this.deleteSheet(true)|
  exit

 !this.sheetList.setPopup(!this.listPopUp)

exit

----------------------------
-- Default constructor
--    sets up menu bar
----------------------------
define method .adpSteel()
  !this.stanMenu = object LSTSTANDARDMENU(!this,!this.selList)

  !bar = !!adpSteel.bar
  !bar.add('Control','ControlMenu')
  !bar.add('Add','addMenu')
  !bar.add('Remove','removeMenu')

  !menu = !!adpSteel.newMenu('ControlMenu')
    !menu.add('CALLBACK','Close','!this.closeForm()')

  !this.stanMenu.standardAdd('Add','addMenu')
  !this.stanMenu.standardRemove('Remove','removeMenu')

endmethod
-- End of method definition for .adpSteel()

define method .init()
-- -----------------------------------------
-- initialise options gadget
  !this.initOpt()

-- clean the design selection list of deleted items
  !this.cleanSelection()

-- used for initialisation and re-initialisation of form.

    !this.sheets.clear()
    !this.sheetsFiltered.clear()

-- list sheets

  PROMPT 'Collecting Steelwork Detailing Sheets ...'

  var !adpS TSEARCH SPPURP SDADP SHEET
--  append those with SPPURP = SDA for time being
  var !adpS APPEND TSEARCH SPPURP SDA SHEET

  if (undefined(!adpS)) then
    !adpS = object ARRAY()
  endif

  !this.sheets = !adpS

  !this.changedFilter()
  !this.filterSheets()

  !this.stanMenu.updateAddListMenu()
  !this.stanMenu.updateRemoveListMenu()

  if (defined(!!adpSteelOpt)) then
    !this.adpLbEdit.active = not !!adpSteelOpt.shown()
  else
    !this.adpLbEdit.active = true
  endif

endmethod
-- End of method definition for .init()

define method .initOpt()
-- list all SDAOPT

--  Don't want to change current chosen SDAOPT if that SDAOPT
--  still exists.  So keep note of the old setting.
    !oldSelection = object DBREF()
    !oldSelection = object DBREF(!this.adpLbName.selection())
     handle any
     endhandle
--
  var !adpLbx COLLECT ALL SDAOPT
  !dt = object ARRAY()
  !rt = object ARRAY()
  !jsel = 0
  !j = 0
  do !a values !adpLbx
    !rt.append(!a)
    !dt.append(!a.dbref().fullname)

-- check if old setting is in the new list
    !j = !j + 1
     if (not !oldSelection.badref()) then
     if (!a.dbref() eq !oldSelection) then
       !jsel = !j
    endif
    endif
  enddo

  !this.adpLbName.dtext = !dt
  !this.adpLbName.rtext = !rt

-- reset selected SDAOPT to the old value. If possible.
   if (!jsel gt 0) then
    !this.adpLbName.val = !jsel
   endif

endmethod
-- End of method definition for .initOpt()
----------------------------------
define method .closeForm()
  !this.hide()
endmethod
-- End of method definition for .closeForm()
--------------------------------------------
define method .editOptions()
  !sel =  !this.adpLbName.selection('Dtext')
  !errTxt = 'ADP Error: SDAOPT element '& !sel & ' is not defined.'
  !unusedSelRef = !sel.dbref()
  handle any
    !this.initOpt()
    return error 2 |$!errTxt|
  endhandle

 show !!adpSteelOpt
 !this.adpLbEdit.active = not !!adpSteelOpt.shown()
endmethod
-- End of method definition for .editOptions()
--------------------------------------------
define method .changedFilter()
  !this.sheets.clear()
  !this.sheetsFiltered.clear()
  PROMPT 'Collecting Steelwork Detailing Sheets ...'
  var !adpS TSEARCH SPPURP SDADP SHEET
-- append those with SPPURP = SDA for time being
  var !adpS APPEND TSEARCH SPPURP SDA SHEET


  -- If in Outfitting Draft, SHEETs with MarPType neq 0 should not be listed
  !module = object MODULE()
  if(!module.modkey.upcase().eq('MARODRA')) then
	  DO !s INDEX !adpS
		$!adpS[$!s]
		var !mpt $!!ce.marptype
		
		if(!mpt.NEQ('0')) then	
			!adpS[$!s].DELETE()
		endif
	  enddo
	  !temp = object ARRAY()
	  DO !s INDEX !adpS
		!temp.append(!adps[$!s])
	  enddo
	  !adps = !temp
	  !temp.delete()
  endif
  if (undefined(!adpS)) then
    !adpS = object ARRAY()
  endif
  !this.sheets = !adpS

  !this.filterSheets()
endmethod
-- End of method definition for .changedFilter()
----------------------------------------------------
define method .filterSheets()

!this.cleanSelection()

!selRefNos = !this.selList.rtext
!selRefs = object ARRAY()
do !r values !selRefNos
  !selRefs.append(!r.dbref())
enddo

!selDefined = !selRefs.size() gt 0 and !this.filterSel.val
!prevPc = 0

if( not !this.filterUpd.val and not !selDefined ) then
  !this.sheetsFiltered = !this.sheets
else
  !n = !this.sheets.size()

  !sheetsString = object ARRAY()
  do !i from 1 to !n
   !sheetsString[$!i] = !this.sheets[$!i].string()
  enddo

  if( !this.filterUpd.val ) then
    var !revisions EVALUATE REVT OF REVI 1 FOR ALL FROM !sheetsString IGNORE ANY ''
  endif

  do !i from 1 to !n
    !s = !this.sheets[$!i]

    if( EMPTY(ADPRFA OF $!s) ) then
      !this.sheetsFiltered.append(!s)
      skip
    else
      !de = REF OF ADPRFA NUM 1 OF $!s
    endif

    !pc = INT( !i * 100 / !n )

    if( !pc ne !prevPc ) then
      PROMPT 'Filtering Sheets ($!pc%) ...'
     !prevPc = !pc
    endif

    if(!selDefined) then
      skip if(!selRefs.intersect(!de.ownLst).empty() and !selRefs.findFirst(!de).unset() )
    endif

    if( !this.filterUpd.val ) then
--     12:48 17 Feb 1999 format
      skip if(!revisions[!i].empty())
      !rtObj = object DATETIME( !revisions[!i] )

      !include = false

      if( object DATETIME(!de.lastMod.hier) gt !rtObj ) then
        !include = true
      else
        if(!de.type eq 'SCTN' or !de.type eq 'GENSEC') then
          if( not !de.joiS.badref() ) then
             if( object DATETIME(!de.joiS.lastMod.hier) gt !rtObj ) then
               !include = true
             endif
          endif
          if( not !de.joiE.badref() ) then
            if( object DATETIME(!de.joiE.lastMod.hier) gt !rtObj ) then
              !include = true
            endif
          endif
        endif
      endif

      skip if( not !include )
    endif

    !this.sheetsFiltered.append(!s)
  enddo
endif
!this.listSheets()
endmethod
-- End of method definition for .filterSheets()
-- ------------------------------

define method .listSheets()
  !n = !this.sheetsFiltered.size()
  !sheetListText = object ARRAY()

  PROMPT 'Building List of $!n Sheets ...'

  !sheetsFilteredString = object ARRAY()
  do !i from 1 to !n
    !sheetsFilteredString[$!i] = !this.sheetsFiltered[$!i].string()
  enddo
  var !names EVALUATE NAME FOR ALL FROM  !sheetsFilteredString

  PROMPT 'Building List of $!n Sheets (20%)...'
  do !index ind !sheetsFilteredString
    !sheetRefe = !sheetsFilteredString[!index].dbref()
    !name = !names[!index]
    if (!sheetRefe.adpRfa[1].badref()) then
      !sheetListText.append(!names[!index] & ' -> ** Bad Reference **')
    else
      PROMPT 'Building List of $!n Sheets (80%)...'
      !sheetListText.append(!names[!index] & ' -> ' & !sheetRefe.adpRfa[1])
    endif

  enddo

  PROMPT 'Updating Steelwork Detailing Form ...'

 !this.sheetList.dtext = !sheetListText
 !this.sheetList.rtext = !sheetsFilteredString

PROMPT ' '

endmethod
-- End of method definition for .listSheets()
--------------------------------------------
define method .selectSheet(!sheetRef is DBREF)
  !this.sheetList.select('Rtext',!sheetRef.string())
  handle any
  endhandle
  !this.selectSheet()
endmethod
-- End of method definition for .selectSheet(!sheetRef is DBREF)
--------------------------------------------
define method .selectSheet()
  !s = !this.sheetList.selection('Rtext')
  !sRef = !s.dbref()
  handle any
   return
  endhandle

 if (defined(!sRef)) then
 if (!sRef.set())    then
  $!sRef

  -- Module specific
!module = object MODULE()
if(!module.modkey.upcase().eq('MARDRA')) then
  --!!openmarinesheet('', !!ce)

else

	-- make sure we come out of modify mode
	!!exitModifyMode()

	  edit _CDRCADCGA1_N1 AREA PUT $!s exit
		handle any
		endhandle

	  -- Test for bad reference
	  if (!this.sheetList.selection().dbref().adprfa[1].badref()) then
		!response = !!alert.confirm('This Sheet has a bad ADPRFA reference to the Design Model, probably caused by the element having been deleted. You should delete this sheet. Do you want to delete it now?')
		if (!response.upCase().eq('YES')) then
		  !this.deleteSheet(false)
		  return
		endif
	  endif

	  !title = |Main Display SHEE | & name

	  if( not dbwrite )then
		 !title = !title & '   (Read Only)'
		 !!enableModify(!!cdrCadcGa1, 'OFF')
	  elseif( lclm )then
	--      claimed by current user - make sure modify enabled
		 !!enableModify(!!cdrCadcGa1, 'ON')
	  elseif(  not !!dbRefUpdatable(!sRef) ) then
		!title = !title & '   (Read Only)'
		 !!enableModify(!!cdrCadcGa1, 'OFF')
	  else
		 !!enableModify(!!cdrCadcGa1, 'ON')
	  endif

	  edit _CDRCADCGA1 TITLE |$!title|
	 endif
	 endif
endif
return
endmethod
-- End of method definition for .selectSheet()
--------------------------------------------
define method .exec()
  !this.cleanSelection()
  !rt = !this.selList.rtext

  if( !rt.size() eq 0 ) then
    return error 6 'ADP Error: selection is not defined.'
  endif

  !d = object DBREF(!this.adpLbName.selection())
  handle any
    !sel = !this.adpLbName.selection('Dtext')
    !errTxt = 'ADP Error: SDAOPT element '& !sel & ' is not defined.'
    !this.initOpt()
    return error 2 |$!errTxt|
  endhandle

  if( !d.badref() or (!d.attribute('TYPE') ne 'SDAOPT') ) then
    return error 4 'ADP Error: Invalid SDAOPT Options element specified.'
  endif

  !this.sheets = ADP $!d.name all from !rt
  !genSheets = object ARRAY()

  !genSheets = !this.sheets

  do !newsheet values !genSheets
      !!setmarptype(!newsheet, 31)
  enddo

  if (!genSheets.size() GE 1 ) then
    !firstSheet = !this.sheets[1]
  endif
-- record the previously selected sheet.  May want to reset sheetList
-- selection to be this sheet.
  !n = !this.sheetList.val
  if (!n GE 1) then
    !selSheet = !this.sheetList.rtext[!n]
  endif

  !this.changedFilter()

-- Now try to pick a sensible SHEE to select and display
  if (!genSheets.size() GE 1 ) then
-- On the sheets list we shall highlight the first sheet generated by the
-- execution of the ADP system, and update the 2D graphics.
   !this.selectSheet(!firstSheet)

  elseif (!n GE 1) then

-- no sheets have been generated.  Reset sheetlist selection
-- to be the sheet previously selected.  No need to update graphics

   !this.sheetList.select('Rtext',!selSheet.string())
   handle any
-- this sheet obviously no longer exists in the sheet list.

    if (!this.sheetList.rtext.size() GE 1) then
--     Previously selected sheet is no longer available.
--     Highlight the first SHEE in the sheet list.
--     Update 2D Graphics
       !this.sheetList.val = 1
       !this.selectSheet()
    endif
   endhandle

  endif
endmethod
-- End of method definition for .exec()
--------------------------------------------
define method .regenerate()

  !s = !this.sheetList.selection()
  if( !s.trim().empty() ) then
    return
  endif

  -- Check for bad reference to design elements
  if (!this.sheetList.selection().dbref().adprfa[1].badref()) then
    !response = !!alert.confirm('This Sheet has a bad ADPRFA reference to the Design Model, probably caused by the element having been deleted. You should delete this sheet. Do you want to delete it now?')
    if (!response.upCase().eq('YES')) then
      !this.deleteSheet(false)
    endif
    return
  endif

  !d = object DBREF(!this.adpLbName.selection())
  handle any
    !sel = !this.adpLbName.selection('Dtext')
    !errTxt = 'ADP Error: SDAOPT element '& !sel & ' is not defined.'
    !this.initOpt()
    return error 2 |$!errTxt|
  endhandle
  if (undefined(!d)) then
    return
  endif
  if (!d.unset()) then
    return
  endif

  !sheets = ADP $!d.name ( $!s )
  if (!sheets.size() gt 0) then
    $!sheets[1]
    !this.selectSheet()
  else
    return error 3 'ADP Error: Sheet is not defined.'
  endif

  return

endmethod
-- End of method definition for .regenerate()
--------------------------------------------
define method .addCommand()
  if( !this.selTxt.val.trim().empty() ) then
    return
  endif
  !inputText = !this.selTxt.val
  var !newList COLLECT $!inputText
  handle any
  endhandle

  if (defined(!newList)) then
  if (!newList.size() gt 0) then
   !this.stanMenu.addItems(!newList)
  endif
  else
   return error 2 |ADP Error: Invalid expression.|
  endif
endmethod
-- End of method definition for .addCommand()

define method .cleanSelection()

  !selRefNos = !this.selList.rtext
  !newList = object ARRAY()

  do !r values !selRefNos
    if ( !!exists(!r, string(), string()) ) then
      !newList.append(!r)
    endif
  enddo
  !this.stanMenu.removeAll()
  !this.stanMenu.addItems(!newList)

endmethod
-- End of method definition for .cleanSelection()
--------------------------------------------
define method .deleteSheet(!confirm is BOOLEAN)

  -- Check for nothing selected
  if (!this.sheetList.selection().trim().empty()) then
    return
  endif

  -- Confirm delete
  if (!confirm) then
    !response = !!alert.confirm('Are you sure you want to delete sheet ' & !this.sheetList.selection().dbref().flnn & '?')
    if (!response.upCase().eq('NO')) then
      return
    endif
  endif

  -- Store location
  !ce = !!ce

  -- Access the sheet and delete it
  !!ce = !this.sheetList.selection().dbref()
  DELETE SHEET

  -- Refresh the form
  !this.init()

  -- Attempt to return to original location
  if (!ce.badref().not()) then
    !!ce = !ce
  endif

endmethod
-- End of method definition for .deleteSheet(BOOLEAN)
