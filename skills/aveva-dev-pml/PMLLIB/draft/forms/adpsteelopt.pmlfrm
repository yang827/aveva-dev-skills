setup form !!adpSteelOpt
Import 'pmlfilebrowser'
handle any
endhandle
-- bar menu
   bar
   exit

-- standard menu object contains logic for add/remove menus
  member .stanMenu is LSTSTANDARDMENU
  member .desLevels is ARRAY
  member .draLevels is ARRAY

  member .mScaleDefDtext  is ARRAY
  member .mScaleDefRtext  is ARRAY
  member .dScaleDefDtext  is ARRAY
  member .dScaleDefRtext  is ARRAY

  member .assocDef        is ARRAY
  member .scaleValue      is ARRAY
  member .scaleText       is ARRAY
  member .uScaleText      is STRING
  member .scaleOptHeader  is STRING


  !this.desLevels.clear()
  !this.draLevels.clear()
  !this.desLevels.append(|SITE|)
  !this.desLevels.append(|ZONE|)
  !this.desLevels.append(|STRU|)
  !this.desLevels.append(|FRMW|)
  !this.desLevels.append(|SBFR|)

  !this.draLevels.append(|DEPT|)
  !this.draLevels.append(|REGI|)
  !this.draLevels.append(|DRWG|)

  !this.assocDef[1] = 'SBFR - DRWG'
  !this.assocDef[2] = 'FRMW - DRWG'
  !this.assocDef[3] = 'ZONE - REGI'
  !this.assocDef[4] = 'SITE - DEPT'

  !width[1] = 37
  !width[2] = 10
  !width[3] = 12

  !len[1] = 8
  !len[2] = 3
  !len[3] = 5


  title  'Steelwork Detailing Options'
  iconti 'SteelADP Opts'
 -- !!adpSteelOpt.initCall = '!!adpSteelOpt.init()'

  paragraph .adpLbLab   at x0 ymax+0.2 text 'Options: ' lines 1
  paragraph .adpLbName  at xmax.adpLbLab ymin text 'unset' width 30 lines 1

  frame       .bsFrm   'Backing Sheets: priority ordered list' at x0 ymax.adpLbName
    list      .bsList  at x1   ymax  multi width $!width[1] len $!len[1]
--    paragraph .selPara at xmin ymax  text 'Selection expression' lines 1
--    text      .bsName  at xmin ymax  call '!this.addCommand()' width 39 STRING
    button    .bsUp    at xmax.bsList+0.2 ymin.bsList call |!this.stanMenu.shift('UP')| pixmap width 16 height 16
    button    .bsDown  at xmax.bsList+0.2 ymax  call |!this.stanMenu.shift('DOWN')|  pixmap width 16 height 16
--    button    .bsAdd   at xmax.bsName ymax.bsName-0.9 'Add' call '!this.addCommand()'
  exit

  frame .scaleFrm 'Permitted View Scales' at x0 ymax+0.5

-- main view scale gadgets
    paragraph .mScalePara   at x1 ymax text 'Main View Scales:'
    option    .mScaleOption at x1 ymax call |!this.addScale(!this.mScaleOption , !this.mScaleList, !this.dScaleList)| width 19
    list      .mScaleList   at x1 ymax call |!this.selectScale(!this.mScaleList,!this.dScaleList)| multi width 19 len 4

    paragraph .dScalePara   at xmax.mScaleOption+1.5 ymin.mScalePara text 'Detail View Scales:'
    option    .dScaleOption at xmax.mScaleOption+1.5 ymin.mScaleOption call |!this.addScale(!this.dScaleOption , !this.dScaleList, !this.mScaleList)| width 19
    list      .dScaleList   at xmax.mScaleOption+1.5 ymin.mScaleList call |!this.selectScale(!this.dScaleList,!this.mScaleList)| multi width 19 len 4

    button    .scaleRemove |Remove selected| at  x16 ymax  call |!this.removeSelected()|

  exit

  frame .atFrm 'Association Table' at x0 ymax+0.5
    option .desiType at x1 ymax width 4
    option .paddType at xmax ymin width 4

    list   .atList   at x1 y2.1  width $!width[3] len $!len[3]
    button .atAdd    at xmax.atList ymax.desiType ' Add  ' call |!this.assocAdd()|
    button .atDel    at xmin ymax 'Remove'                 call |!this.assocRemove()|

    !this.desiType.dtext = !this.desLevels
    !this.paddType.dtext = !this.draLevels
  exit

  frame .mrgFrm 'Merging' at xmax.atFrm ymin.atFrm
    paragraph .mrgTogText at x1 ymax+0.2 text 'On ' lines 1
    toggle    .mrgTog at xmax.mrgTogText ymin.mrgTogText
    option .mgLev 'Level ' at xmax.mrgTog+4 ymin.mrgTog width 4
    !this.mgLev.dtext = !this.desLevels
  exit

  frame .dvFrm 'Detail Views' at xmax.atFrm ymax.mrgFrm+0.2
    paragraph .dvTogText at x1 ymax+0.2 text 'On ' lines 1
    toggle    .dvTog at xmax.dvTogText ymin.dvTogText
    paragraph .dvThLab    at xmax.dvTog+1 ymin.dvTog text 'Threshold ' lines 1
    text      .dvThVal    at xmax ymin call '!this.validateThreshold()' width 5 num
  exit

   paragraph  .picFilesText  at xmax.atFrm+1 ymax.dvFrm+0.2 text 'Picture Files'
   toggle     .picFilesTog   at xmax.picFilesText+1 ymin.picFilesText

   paragraph .rrsfLab     at x0 ymax.atFrm+0.5 text 'Ruleset reference   ' lines 1
   text      .rrsfName    at xmax ymin       call |!this.setRulesetInput()| width 24 STRING
   button    .rrsfCE 'CE' at xmax ymin  call |!this.setRulesetCe()|

   paragraph .anSymLab     at x0 ymax.rrsfCE+0.5 text 'Annotation symbols  ' lines 1
   text      .anSymName    at xmax ymin      call '!this.setAnSymInput()' width 24 name
   button    .anSymCE 'CE' at xmax ymin call '!this.setAnSymCe()'

   paragraph .cbLab at x0 ymax.anSymCE+0.5       text 'Customisation macro ' lines 1
   text      .cbName at xmax.anSymLab ymin call '!this.setMacro()' width 17 STRING
   button    .browser 'Browse...' at xmax ymin call |!!fileBrowser('%PDMSUSER%', '', 'Steelwork Detailing Customisation Macro', false, '!!adpSteelOpt.cbName.val = !!fileBrowser.file.name()')|

   button .save     |Save|       at x0 ymax+0.5 call |!this.saveOptions('SAVE')|
   button .saveAs   |Save As...| at xmax.save+1 ymin call |!this.saveOptions('SAVEAS')|
   button .cancel   |Dismiss|    at xmax form-size ymin call '!!adpSteel.adpLbEdit.active = true' cancel

exit

define method .adpSteelOpt()
 !!adpSteelOpt.initCall = '!!adpSteelOpt.init()'
  !this.stanMenu = object LSTSTANDARDMENU(!this,!this.bsList)

  !allowedTypes[1] = 'BACK'
  !this.stanMenu.allowedTypes = !allowedTypes
  !this.stanMenu.allowedTypesError = 'ADP Error: Backing Sheet element expected.'

  !bar = !!adpSteelOpt.bar
  !bar.add('Control','ControlMenu')
  !bar.add('Add','addMenu')
  !bar.add('Remove','removeMenu')

  !menu = !!adpSteelOpt.newMenu('ControlMenu')
    !menu.add('CALLBACK','Save',|!this.saveOptions('SAVE')|)
    !menu.add('CALLBACK','Save As...',|!this.saveOptions('SAVEAS')|)
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK','Defaults', '!this.setDefaults()')
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK','Close','!this.closeForm()')

  !this.stanMenu.standardAdd('Add','addMenu')
  !this.stanMenu.standardRemove('Remove','removeMenu')

-- set pixmaps
  !this.bsUp.addPixmap(!!pml.getPathName('uparrow16.png'))
  !this.bsDown.addPixmap(!!pml.getPathName('downarrow16.png'))
endmethod
-- End of method definition for .adpSteelOpt()

define method .init()
   !sel =  !!adpSteel.adpLbName.selection('Dtext')
   !this.initScaleLists()

   if (!sel.empty() or !sel.lowcase() eq 'unset') then
     !this.adpLbName.val = 'unset'
   else
     !this.adpLbName.val = !sel

     $!sel

     !this.readAssoc()
     !this.readBSList()
     !this.readMergeFlag()
     !this.readMergeLevel()
     !this.readScaleList( !this.mScaleList , 'scalist' )
     !this.readScaleList( !this.dScaleList , 'dvsclist')
     !this.readDVFlag()
     !this.readThreshold()
     !this.readPicFiles()
     !this.readRuleset()
     !this.readAsym()
     !this.readMacro()
   endif
 !this.setActive(true)

 !this.stanMenu.updateAddListMenu()
 !this.stanMenu.updateRemoveListMenu()
endmethod
-- End of method definition for .init()

define method .initScaleLists()

-- clear all arrays in case user has swapped units
  !this.scaleText.clear()
  !this.scaleValue.clear()
  !this.mScaleDefDtext.clear()
  !this.mScaleDefRtext.clear()
  !this.dScaleDefDtext.clear()
  !this.dScaleDefRtext.clear()

  if (!!isImperialLength('DIST').not()) then
--  metric scales
   !this.scaleText[1]  = |1 to 1|
   !this.scaleText[2]  = |1 to 2|
   !this.scaleText[3]  = |1 to 3|
   !this.scaleText[4]  = |1 to 5|
   !this.scaleText[5]  = |1 to 10|
   !this.scaleText[6]  = |1 to 20|
   !this.scaleText[7]  = |1 to 25|
   !this.scaleText[8]  = |1 to 33.33|
   !this.scaleText[9]  = |1 to 50|
   !this.scaleText[10] = |1 to 75|
   !this.scaleText[11] = |1 to 100|
   !this.scaleText[12] = |1 to 150|
   !this.scaleText[13] = |1 to 200|
   !this.scaleText[14] = |1 to 250|
   !this.scaleText[15] = |1 to 500|
   !this.scaleText[16] = |1 to 1000|
   !this.scaleText[17] = |1 to 1250|
   !this.scaleText[18] = |1 to 2500|

   !this.scaleValue[1]  = |1|
   !this.scaleValue[2]  = |2|
   !this.scaleValue[3]  = |3|
   !this.scaleValue[4]  = |5|
   !this.scaleValue[5]  = |10|
   !this.scaleValue[6]  = |20|
   !this.scaleValue[7]  = |25|
   !this.scaleValue[8]  = |33.33|
   !this.scaleValue[9]  = |50|
   !this.scaleValue[10] = |75|
   !this.scaleValue[11] = |100|
   !this.scaleValue[12] = |150|
   !this.scaleValue[13] = |200|
   !this.scaleValue[14] = |250|
   !this.scaleValue[15] = |500|
   !this.scaleValue[16] = |1000|
   !this.scaleValue[17] = |1250|
   !this.scaleValue[18] = |2500|

-- metric defaults
   !this.mScaleDefDtext[1] = !this.scaleText[1]
   !this.mScaleDefDtext[2] = !this.scaleText[4]
   !this.mScaleDefDtext[3] = !this.scaleText[5]
   !this.mScaleDefDtext[4] = !this.scaleText[6]
   !this.mScaleDefDtext[5] = !this.scaleText[9]
   !this.mScaleDefDtext[6] = !this.scaleText[10]

   !this.mScaleDefRtext[1] = !this.scaleValue[1]
   !this.mScaleDefRtext[2] = !this.scaleValue[4]
   !this.mScaleDefRtext[3] = !this.scaleValue[5]
   !this.mScaleDefRtext[4] = !this.scaleValue[6]
   !this.mScaleDefRtext[5] = !this.scaleValue[9]
   !this.mScaleDefRtext[6] = !this.scaleValue[10]

   !this.dScaleDefDtext =  !this.mScaleDefDtext
   !this.dScaleDefRtext =  !this.mScaleDefRtext

  else
--  Imperial  scales
   !this.scaleText[1]  = |3" to 1'-0"|
   !this.scaleText[2]  = |1 1/2" to 1'-0"|
   !this.scaleText[3]  = |1" to 1'-0"|
   !this.scaleText[4]  = |3/4" to 1'-0"|
   !this.scaleText[5]  = |1/2" to 1'-0"|
   !this.scaleText[6]  = |3/8" to 1'-0"|
   !this.scaleText[7]  = |1/4" to 1'-0"|
   !this.scaleText[8]  = |3/16" to 1'-0"|
   !this.scaleText[9]  = |1/8" to 1'-0"|
   !this.scaleText[10]  = |1/16" to 1'-0"|
   !this.scaleText[11]  = |1" to 10'-0"|
   !this.scaleText[12] = |1" to 20'-0"|
   !this.scaleText[13] = |1" to 30'-0"|
   !this.scaleText[14] = |1" to 40'-0"|
   !this.scaleText[15] = |1" to 50'-0"|
   !this.scaleText[16] = |1" to 60'-0"|
   !this.scaleText[17] = |1" to 75'-0"|
   !this.scaleText[18] = |1" to 100'-0"|

   !this.scaleValue[1]  = |4|
   !this.scaleValue[2]  = |8|
   !this.scaleValue[3]  = |12|
   !this.scaleValue[4]  = |16|
   !this.scaleValue[5]  = |24|
   !this.scaleValue[6]  = |32|
   !this.scaleValue[7]  = |48|
   !this.scaleValue[8]  = |64|
   !this.scaleValue[9]  = |96|
   !this.scaleValue[10] = |192|
   !this.scaleValue[11] = |120|
   !this.scaleValue[12] = |240|
   !this.scaleValue[13] = |360|
   !this.scaleValue[14] = |480|
   !this.scaleValue[15] = |600|
   !this.scaleValue[16] = |720|
   !this.scaleValue[17] = |900|
   !this.scaleValue[18] = |1200|

-- imperial defaults
   !this.mScaleDefDtext[1] = !this.scaleText[2]
   !this.mScaleDefDtext[2] = !this.scaleText[3]
   !this.mScaleDefDtext[3] = !this.scaleText[4]
   !this.mScaleDefDtext[4] = !this.scaleText[5]
   !this.mScaleDefDtext[5] = !this.scaleText[6]
   !this.mScaleDefDtext[6] = !this.scaleText[7]
   !this.mScaleDefDtext[7] = !this.scaleText[8]
   !this.mScaleDefDtext[8] = !this.scaleText[9]

   !this.mScaleDefRtext[1] = !this.scaleValue[2]
   !this.mScaleDefRtext[2] = !this.scaleValue[3]
   !this.mScaleDefRtext[3] = !this.scaleValue[4]
   !this.mScaleDefRtext[4] = !this.scaleValue[5]
   !this.mScaleDefRtext[5] = !this.scaleValue[6]
   !this.mScaleDefRtext[6] = !this.scaleValue[7]
   !this.mScaleDefRtext[7] = !this.scaleValue[8]
   !this.mScaleDefRtext[8] = !this.scaleValue[9]

   !this.dScaleDefDtext =  !this.mScaleDefDtext
   !this.dScaleDefRtext =  !this.mScaleDefRtext
endif

!dt = !this.scaleText
!rt = !this.scaleValue

!this.uScaleText     = 'User defined...'
!this.scaleOptHeader = '-- Add a scale --'

!dt.append(!this.uScaleText)
!rt.append('')

!dt.insert(1,!this.scaleOptHeader)
!rt.insert(1,'')

!this.mScaleOption.dtext = !dt
!this.mScaleOption.rtext = !rt

!this.dScaleOption.dtext = !dt
!this.dScaleOption.rtext = !rt


endmethod


define method .setDefaults()

 if ( !!alert.confirm('Set all default options?').boolean() ) then

  !this.mScaleList.dtext   = !this.mScaleDefDtext
  !this.mScaleList.rtext   = !this.mScaleDefRtext

  !this.dScaleList.dtext   = !this.dScaleDefDtext
  !this.dScaleList.rtext   = !this.dScaleDefRtext

  !this.atList.dtext      = !this.assocDef

  !this.mrgTog.val = TRUE
  !this.mgLev.select('Dtext','SBFR')

  !this.dvTog.val   = TRUE
  !this.dvThVal.val = '0.4'

  !this.picFilesTog.val = TRUE

  !this.anSymName.val = '/DRA/MAS/SDADP/SYMBOLS'
  !this.cbName.val = '%PDMSDFLTS%\DRA-SDADP-MACRO'
 endif
endmethod

-- End of method definition for .setDefaults()
define method .addCommand()
  if( !this.bsName.val.trim().empty() ) then
    return
  endif
  !inputText = !this.bsName.val
  var !newList COLLECT $!inputText
  handle any
  endhandle

  if (defined(!newList)) then
  if (!newList.size() gt 0) then
   !this.stanMenu.addItems(!newList)
  endif
  else
   return error 2 |ADP Error: Invalid expression.|
  endif

endmethod
-- End of method definition for .addCommand()

---------------------------------------------------------
-- method to add an association to the Association Table
---------------------------------------------------------
define method .assocAdd()
  !desiArray = object ARRAY()
  !paddArray  = object ARRAY()
  !this.getAssocArrays(!desiArray, !paddArray)

  !desi = !this.desiType.selection()
  !padd = !this.paddType.selection()

  !i = !desiArray.findFirst(!desi)

  !s = !desi & ' - ' & !padd

  !dt = !this.atList.dtext
  !dtOriginal = !this.atList.dtext

  if( !dt.findFirst(!s).set() ) then
    return error 2 |$!s  association already exists.|
  elseif (!i.set()) then
    !dt[!i] = !s
    !this.atList.val = !i
  else
    !dt.append(!s)
  endif

  !this.atList.dtext = !dt
  !this.sortAssocDesi()

  if (NOT !this.validAssocPadd()) then
    !this.atList.dtext = !dtOriginal
    return error 2 |$!s  association invalid.  Elements must be in ascending hierarchical order.|
  endif

  !dt = !this.atList.dtext
  !i = !dt.findFirst(!s)
  !this.atList.val = !i


endmethod
-- End of method definition for .assocAdd()

define method .sortAssocDesi()
-- -------------------------
-- sort the association list DTEXT into
-- ascending order of design element hierarchy
-- -------------------------
  !desiArray = object ARRAY()
  !paddArray = object ARRAY()
  !this.getAssocArrays(!desiArray, !paddArray)

  !x = object ARRAY()
  do !desi values !desiArray
   if (!desi eq 'SITE') then
     !x.append(5)
   elseif (!desi eq 'ZONE') then
     !x.append(4)
   elseif (!desi eq 'STRU') then
     !x.append(3)
   elseif (!desi eq 'FRMW') then
     !x.append(2)
   elseif (!desi eq 'SBFR') then
     !x.append(1)
   endif
  enddo

  !sorted = !x.sortedIndices()

  !dt = !this.atList.dtext
  !dt.reindex(!sorted)
  !this.atList.dtext = !dt

endmethod
-- End of method definition for .sortAssocDesi()

define method .validAssocPadd() is BOOLEAN
-------------------------------------
-- Method to check whether the padd elements in the
-- association table are in ascending hierarchical order
-------------------------------------
  !desiArray = object ARRAY()
  !paddArray = object ARRAY()
  !this.getAssocArrays(!desiArray, !paddArray)

  !xPrev = -999
  do !desi values !paddArray
   if (!desi eq 'DEPT') then
     !x = 3
   elseif (!desi eq 'REGI') then
     !x = 2
   elseif (!desi eq 'DRWG') then
     !x = 1
   endif

   if (!x lt !xPrev) then
     return false
   endif
   !xPrev = !x
  enddo

  return true
endmethod
-- End of method definition for .validAssocPadd() BOOLEAN
---------------------------------------------------------
-- methods to set ruleset reference field from CE and text input
---------------------------------------------------------
define method .setRulesetCe()
   !this.rrsfName.val = !!ce.fullname
   !!namegadget(!this.rrsfName, 'old')

   if ( !this.validType(!this.rrsfName, 'RRST' )) then
     return
   else
    !this.rrsfName.val = 'unset'
    !this.rrsfName.setFocus()
    return error 2 |ADP Error: Ruleset Reference must be of type RRST.|
   endif
endmethod
-- End of method definition for .setRulesetCe()

define method .setRulesetInput()
   !!namegadget(!this.rrsfName, 'old')

   if (!this.rrsfName.val eq 'unset') then
      return
   endif

   if (!this.validType(!this.rrsfName, 'RRST')) then
--   input is a RRST
     return
   else
      !this.rrsfName.val = 'unset'
      !this.rrsfName.setFocus()
      return error 2 |ADP Error: Ruleset Reference must be of type RRST.|
   endif
endmethod
-- End of method definition for .setRulesetInput()

---------------------------------------------------------
-- methods to set ANNOTATION SYMBOL field from CE and text input
---------------------------------------------------------
define method .setAnSymCe()
   !this.anSymName.val = !!ce.fullname
   !!namegadget(!this.anSymName, 'old')

   if ( !this.validType(!this.anSymName, 'SYLB' )) then
     return
   else
    !this.anSymName.val = 'unset'
    !this.anSymName.setFocus()
    return error 2 |ADP Error: Annotation Symbol must be of type SYLB.|
   endif
endmethod
-- End of method definition for .setAnSymCe()

define method .setMacro()
  if (NOT !this.validMacro()) then
       return error 2 |Customisation Macro file not found.  Please enter the full path and name of an existing customisation macro file.|
    !this.cbName.setFocus()
  endif
endmethod
-- End of method definition for .setMacro()

define method .setAnSymInput()
     !!namegadget(!this.anSymName, 'old')
     if (!this.anSymName.val eq 'unset' ) then
       return
     endif

   if (!this.validType(!this.anSymName, 'SYLB')) then
--   input is a SYLB
     return
   else
      !this.anSymName.val = 'unset'
      !this.anSymName.setFocus()
      return error 2 |ADP Error: Annotation Symbol must be of type SYLB.|
   endif
endmethod
-- End of method definition for .setAnSymInput()

---------------------------------------------------------
-- method to remove an association from the Association Table
---------------------------------------------------------
define method .assocRemove()
  !i = !this.atList.val
  if (!i.unset()) then
    return
  endif

  !dt = !this.atList.dtext
  if (!dt.size() eq 0) then
    return
  endif
  !dt.remove(!i)
  !this.atList.dtext = !dt
endmethod
-- End of method definition for .assocRemove()


------------------------------------------------------------
-- method to validate threshold value
-------------------------------------------------------------
define method .validateThreshold()
  if (!this.validThreshold()) then
    return
  else
    return error 2 |ADP Error: Threshold value must be positive.|
  endif
endmethod
-- End of method definition for .validateThreshold()
------------------------------------------------
-- methods to check valid data in all form fields
-----------------------------------------------
define method .validThreshold() is BOOLEAN

-- invalid if unset
 if (!this.dvThVal.val.unset() or !this.dvThVal.val eq '' ) then
   return false
 endif

-- invalid if out of range

!t = !this.dvThVal.val.real()
 if ( !t gt 0 ) then
  return true
 else
  return false
 endif

endmethod
-- End of method definition for .validThreshold() BOOLEAN
-------------------------------------------------
define method .validScaleList(!scList is GADGET) is BOOLEAN
 return (!scList.dtext.size() gt 0 )
endmethod
-- End of method definition for .validScaleList(GADGET) BOOLEAN
--------------------------------------------------
define method .validBSList() is BOOLEAN
 return (!this.bsList.dtext.size() gt 0 )
endmethod
-- End of method definition for .validBSList() BOOLEAN
--------------------------------------------------
define method .getAssocArrays(!desi is ARRAY, !padd is ARRAY)
  !desi = object ARRAY()
  !padd = object ARRAY()

  !dt = !this.atList.dtext
   if (!dt.size() eq 0) then
     return
   endif
  do !s values !dt
   !desi.append( !s.part(1,'-').trim())
   !padd.append( !s.part(2,'-').trim())
  enddo
endmethod
-- End of method definition for .getAssocArrays(ARRAY, ARRAY)
----------------------------------------------------------
define method .validAssoc() is STRING
  !dt = !this.atList.dtext
   if (!dt.size() LE 0) then
     return |Association table is empty.|
   endif

  !this.sortAssocDesi()

  if (NOT !this.validAssocPadd()) then
    return |Association table unresolvable.  Elements must be in ascending hierarchical order.|
  endif

  return ''

endmethod
-- End of method definition for .validAssoc() STRING
--------------------------------------------------
define method .validType(!textGadget is GADGET, !vType is STRING) is BOOLEAN
 !ele = !textGadget.val
 handle any
  return false
 endhandle

 !eleType = TYPE OF $!ele
 handle any
  return false
 endhandle

 if( !eleType ne !vType ) then
   return false
 endif
 return true
endmethod

define method .validAnSym() is BOOLEAN
   if (!this.validType(!this.anSymName, 'SYLB')) then
     return TRUE
   elseif (!this.anSymName.val.trim() EQ '' OR !this.anSymName.val.trim().upCase() EQ 'UNSET') then
     return TRUE
   else
     return FALSE
   endif
endmethod

-- End of method definition for .validType(GADGET, STRING) BOOLEAN
--------------------------------------------------
define method .validMacro() is BOOLEAN
  !m = !this.cbName.val
  if( !m.empty() or !m.lowcase() eq 'unset' or !m eq '') then
    return true
  else
    !mFile = object FILE(!m)
    !ex = !mFile.exists()
    handle any
     return false
    endhandle
    if (NOT !ex) then
       return FALSE
    endif
  endif

  return true
endmethod
-- End of method definition for .validMacro() BOOLEAN

-------------------------------------------------
define method .validOptions() is STRING

-- check contents of form for invalid data
-- Return an error message string if invalid data is found
 !assocErr =!this.validAssoc()
 if ( NOT !this.validBSList() ) then
   return  |ADP Error: Backing Sheet list is empty.|
 elseif (!assocErr NE '' ) then
   return |$!assocErr|
 elseif (NOT !this.validScaleList(!this.mScaleList) ) then
   return |ADP Error: Main Scale Range List is empty.|
 elseif (NOT !this.validScaleList(!this.dScaleList) ) then
   return |ADP Error: Detail Scale Range List is empty.|
 elseif (NOT !this.validMacro()) then
   !this.cbName.setFocus()
   return |ADP Error: Customisation Macro file not found.|
 elseif (NOT !this.validThreshold()) then
   !this.dvThVal.setFocus()
    return |ADP Error: Threshold value must be positive.|
 elseif (NOT !this.validType(!this.rrsfName, 'RRST')) then
   !this.rrsfName.setFocus()
    return |ADP Error: Ruleset Reference must be of type RRST.|
 elseif (NOT !this.validAnSym()) then
   !this.anSymName.setFocus()
   return |ADP Error: Annotation Symbol must be of type SYLB.|
 endif

 return ''
endmethod
-- End of method definition for .validOptions() STRING

define method .saveOptions(!saveMode is STRING)

-- valid the form contents

  !errText = !this.validOptions()

  if (!errText eq '') then
-- Looking Good
   !saveEle = !this.adpLbName.val

-- Are we in saveAs mode?
-- Need to show the saveAs form if SDAOPT element name has
-- not been set yet.

   if (!saveMode eq 'SAVEAS' or !saveEle.lowcase() eq 'unset' or !saveEle.empty() ) then
     show !!adpSteelSaveAs
     !this.setActive(not !!adpSteelSaveAs.shown())
     return

-- Are we in SAVE mode?
   elseif (!saveMode eq 'SAVE') then
--
   !saveEle = !this.adpLbName.val
   !unusedSaveEleRef = !saveEle.dbref()
   handle any
--   Element name does not exist
--   so we will create an SDAOPT under the first LIBY in
--   owner list of CE
--   Or create a LIBY if one not found.
     !type = object ARRAY()
     !type.append('LIBY')
     !item = !!ce
     !parentLiby = !!firstparent(!type, !item)

     if (!parentLiby.set()) then
      $!parentLiby
      NEW SDAOPT $!saveEle
     else
--    navigate to padd world
     !!ce = !!ce.frstw.padd
      NEW LIBY
      NEW SDAOPT $!saveEle
     endif
     !!adpSteel.initOpt()
   endhandle


   endif

-- navigate to the SDAOPT element
   $!saveEle
   !this.writeAssoc()
   !this.writeBSList()
   !this.writeMergeFlag()
   !this.writeMergeLevel()
   !this.writeScaleList(!this.mScaleList, 'Scalist'   )
   !this.writeScaleList(!this.dScaleList, 'Dvsclist')
   !this.writeDVFlag()
   !this.writeThreshold()
   !this.writePicFiles()
   !this.writeRuleset()
   !this.writeAsym()
   !this.writeMacro()

  else
    !errText = !errText & |  Options cannot be saved.|
    return error 2 |$!errText|
  endif

endmethod
-- End of method definition for .saveOptions(STRING)
--------------------------------------
define method .writeBSList()
----------------------------
-- write contents of Backing Sheet list to the current element
-- CE must be an SDAOPT
-----------------------------

BSRFARRAY UNSET

!i = 1
do !s values !this.bsList.dtext
  BSRFA NUM $!i $!s
  handle any
-- skip any backing sheets that may have been deleted
   skip
  endhandle
  !i = !i + 1
enddo

endmethod
-- End of method definition for .writeBSList()

define method .writeAssoc()
----------------------------
-- write contents of Association table to the current element
-- CE must be an SDAOPT
-----------------------------
  !desi = object ARRAY()
  !padd = object ARRAY()

  !this.getAssocArrays(!desi, !padd)

  ASTABLE UNSET
  !x = object ARRAY()

  do !i indices !desi
   !s = !desi[!i] & ' ' & !padd[!i]
   ASTABLE ADD  $!s
  enddo
endmethod
-- End of method definition for .writeAssoc()

define method .writeMergeFlag()
  MRGFLAG $!this.mrgTog.val
endmethod
-- End of method definition for .writeMergeFlag()

define method .writeMergeLevel()
 !ml = !this.mgLev.selection('Dtext')
 MRGLEVEL $!ml
endmethod
-- End of method definition for .writeMergeLevel()

define method .writeDVFlag()
  DVFLAG $!this.dvTog.val
endmethod
-- End of method definition for .writeDVFlag()

define method .writePicFiles()
 PFREQ $!this.picFilesTog.val
endmethod
-- End of method definition for .writePicFiles()

define method .writeThreshold()
 !t = !this.dvThVal.val
  if (!t.unset() or !t.empty()) then
    DVTHRESHOLD 0.4
  else
    DVTHRESHOLD $!t
  endif
endmethod
-- End of method definition for .writeThreshold()

define method .writeRuleset()
  !r = !this.rrsfName.val
  if( !r.empty() or !r.lowcase() eq 'unset' ) then
    RRSF UNSET
  else
    RRSF $!r
  endif
endmethod
-- End of method definition for .writeRuleset()

define method .writeAsym()
  !a = !this.anSymName.val
  if( !a.empty() or !a.lowcase() eq 'unset' ) then
    ANSYMREF UNSET
  else
    ANSYMREF $!a
  endif
endmethod
-- End of method definition for .writeAsym()

define method .writeMacro()
!m  = !this.cbName.val
  if( !m.empty() or !m.lowcase() eq 'unset' ) then
    UPDCB UNSET
  else
    !m = |/| & |$!m|
    UPDCB $!m
  endif
endmethod
-- End of method definition for .writeMacro()
--------------------------------------------------------
-- Methods to read attributes from the CE
-- and populate this options form.
--
-- NB   CE must(!) be an SDAOPT element.
--
--------------------------------------------------------
define method .readAssoc()
-- read association table from  CE (an SDAOPT element)
    !a = !!ce.asTable
    if (!a.size() eq 0 ) then
      return
    endif

    !dt = object ARRAY()

     do !pi from 2 to !a.size() by 2
      !di = !pi - 1
      !desi = !a[!di]
      !padd = !a[!pi]
      !s = !desi & ' - ' & !padd

      !dt.append(!s)
     enddo

     !this.atList.dtext = !dt
endmethod
-- End of method definition for .readAssoc()
-- --------------------------------------
define method .readBSList()
-- read backing sheet list from  CE (an SDAOPT element)
   !this.stanMenu.removeAll()
    !a = !!ce.bsrfArray
    if (!a.size() eq 0 ) then
      return
    endif

    !ele = object ARRAY()

    do !x values !a
     !ele.append(!x.string())
    enddo

   !this.stanMenu.addItems(!ele)

endmethod
-- End of method definition for .readBSList()
-- --------------------------------------
define method .readMergeFlag()
-- read merge flag list from  CE (an SDAOPT element)
     !this.mrgTog.val =  !!ce.mrgFlag
endmethod
-- End of method definition for .readMergeFlag()
-- --------------------------------------
 define method .readMergeLevel()
-- read merge level list from  CE (an SDAOPT element)
     !a =  !!ce.mrgLevel
     !i = !this.desLevels.findFirst(!a)

--  If the merge level has been set to something weird
--  then put it to SBFR and write to DB.  The user need not know.
     if ( !i.unset() ) then
        !a = 'SBFR'
        !i = !this.desLevels.findFirst(!a)
        !this.mgLev.val = !i
        !this.writeMergeLevel()
        return
     endif

     !this.mgLev.val = !i
endmethod
-- End of method definition for .readMergeLevel()
-- --------------------------------------
define method .readDVFlag()
-- read the DV flag from  CE (an SDAOPT element)
     !this.dvTog.val =  !!ce.dvFlag
endmethod
-- End of method definition for .readDVFlag()
-- --------------------------------------
define method .readThreshold()
-- read the threshold value from  CE (an SDAOPT element)
  !a = !!ce.dvThreshold
   !this.dvThVal.val = !a.string()

   if (!this.validThreshold()) then
     return
   else
     !this.dvThVal.val = '0.4'
     !this.writeThreshold()
   endif

endmethod
-- End of method definition for .readThreshold()
-- --------------------------------------
define method .readPicFiles()
-- read the DV flag from  CE (an SDAOPT element)
     !this.picFilesTog.val =  !!ce.pfreq
endmethod
-- --------------------------------------
define method .readRuleset()
-- read the ruleset reference from  CE (an SDAOPT element)
 !a = RRSF

 if (!a.unset() ) then
   !this.rrsfName.val = 'unset'
 else
   !this.rrsfName.val = !a.fullname
   handle any
     !this.rrsfName.val = 'unset'
     !this.writeRuleset()
   endhandle
 endif
endmethod
-- End of method definition for .readRuleset()
-- --------------------------------------
define method .readAsym()
-- read the annotation symbols reference from  CE (an SDAOPT element)
 !a = ANSYMREF

 if (!a.unset() ) then
   !this.anSymName.val = 'unset'
 else
   !this.anSymName.val = !a.fullname
   handle any
     !this.anSymName.val = 'unset'
     !this.writeAsym()
   endhandle
 endif
endmethod
-- End of method definition for .readAsym()
-- --------------------------------------
define method .readMacro()
-- read the callback string from  CE (an SDAOPT element)
 !a = UPDCB
 if (!a.unset() or !a.empty()) then
   !this.cbName.val = 'unset'
 else
   !firstChar = !a.subString(1,1)
   if (!firstChar EQ |/|) then
     !a = !a.subString(2)
   endif
   !this.cbName.val = !a
 endif
endmethod
-- End of method definition for .readMacro()

define method .closeForm()
  !this.hide()
  !!adpSteel.adpLbEdit.active = true
endmethod
-- End of method definition for .closeForm()

define method .addScale(!scaleOption is GADGET, !scaleList is GADGET,!otherScaleList is GADGET)
  !dtOpt = !scaleOption.dtext
  !rtOpt = !scaleOption.rtext

  !dtList = !scaleList.dtext
  !rtList = !scaleList.rtext

  !i = !scaleOption.val

  if ( !dtOpt[!i] EQ !this.scaleOptHeader) then
   return
  elseif ( !dtOpt[!i] EQ !this.uScaleText) then
-- USER DEFINED
    !this.setActive( FALSE )
    show !!adpSteelUScale
    !!adpSteelUScale.scaleList = !scaleList
    if (!scaleList EQ !this.mScaleList) then
     !!adpSteelUScale.uScaleHead.val = 'Enter required Main View scale   '
    else
     !!adpSteelUScale.uScaleHead.val = 'Enter required Detail View scale '
    endif
  else
-- ADD FROM OPTION GADGET
    !dtList.append(!dtOpt[!i])
    !rtList.append(!rtOpt[!i])

    !scaleList.dtext = !dtList
    !scaleList.rtext = !rtList

    !this.sortScales(!scaleList)
    !this.removeDuplicateScales(!scaleList)
    !scaleList.select('dtext',!dtOpt[!i])
 endif

 !otherScaleList.clearSelection()
 !scaleOption.select('dtext',!this.scaleOptHeader)

endmethod

define method .selectScale(!dummyThisList is GADGET, !otherList is GADGET)

  --!thisList.clearSelection()

  --!thisList.val = !thisList.pickedField

  !otherList.clearSelection()

endmethod

define method .removeSelected()

  if     (!this.mScaleList.val.size() GT 0 ) then
   !scaleList = !this.mScaleList
  elseif (!this.dScaleList.val.size() GT 0 ) then
   !scaleList = !this.dScaleList
  else
     return
  endif

   !selected = !scaleList.val
   !i = !selected[1]

   !dt = !scaleList.dtext
   !rt = !scaleList.rtext

   !dt[!i].delete()
   !rt[!i].delete()

   !scaleList.dtext = !dt
   !scaleList.rtext = !rt

   !selected = object ARRAY()
   if (!i LE !scaleList.dtext.size()) then
     !selected[1] = !i
   else
     !selected[1] = !scaleList.dtext.size()
   endif
   !scaleList.val = !selected
endmethod


define method .sortScales( !scaleList is GADGET)

 !rt = !scaleList.rtext
 !dt = !scaleList.dtext

 if (!rt.size() LE 1 ) then
   return
 endif

 !rtNum = object ARRAY()
 do !r values !rt
  !x = !r.real()
  !rtNum.append(!x)
 enddo

 !rtSort    = !rtNum.sortedIndices()

 !rt.reindex(!rtSort)
 !dt.reindex(!rtSort)

 !scaleList.dtext = !dt
 !scaleList.rtext = !rt

endmethod

define method .removeDuplicateScales(!scaleList is GADGET)

  !dt = !scaleList.dtext
  !rt = !scaleList.rtext

  !duplicates = object ARRAY()
  !dtTemp  = !dt

  do !i indices !dt
    !dtTemp[!i].delete()
    !text = !dt[!i]
    !iDup = !dtTemp.findFirst(!text)
    if ( !iDup.set()) then
      if (!iDup GT !i) then
        !duplicates.append(!iDup)
      endif
    endif
  enddo

 if (!duplicates.size() EQ 0) then
  return
 endif

 do !iDup values !duplicates
   !dt[!iDup].delete()
   !rt[!iDup].delete()
 enddo

 !dt.compress()
 !rt.compress()

 !scaleList.dtext = !dt
 !scaleList.rtext = !rt

endmethod

define method .readScaleList(!scaleList is GADGET, !att is STRING)
--  read a scale list from CE (an SDAOPT element)
    !scales = !!ce.$!att
    if (!scales.size() eq 0) then
      return
    endif

    !dt = object ARRAY()
    !rt = object ARRAY()

    do !scale values !scales
       !scale = !scale.abs()
       if (!scale GT 0.0000001 ) then
         !scale = 1 / !scale
       else
          !scale = 10000000
       endif

-- round scale to 2dp as a string
    !scaleText = !scale.string('D2')
-- get whole number and decimal parts
    !scaleTextComponents = !scaleText.split(|.|)
    if (!scaleTextComponents[2] EQ '00') then
      !scaleText = !scaleTextComponents[1]
    endif

    !displayScale = !this.getDisplayText(!scaleText)

      !dt.append(!displayScale)
      !rt.append(!scale.string())
    enddo

 !scaleList.dtext = !dt
 !scaleList.rtext = !rt

endmethod

define method .getDisplayText(!scale is STRING) is STRING


  if (!!isImperialLength('DIST')) then
     !i = !this.scaleValue.findFirst(!scale)
     if (!i.set()) then
       !displayText = !this.scaleText[!i]
     else
       !displayText = '1 to ' + !scale
     endif
  else
       !displayText = '1 to ' + !scale
  endif

  return !displayText
endmethod

define method .writeScaleList(!scaleList is GADGET, !att is STRING)

  !rt = !scaleList.rtext

  $!att UNSET

  !i = 1
  do !scaleText values !rt
    !scale = !scaleText.real()
    !scale = !scale.abs()
    if (!scale GT 0.0000001 ) then
      !scale = 1 / !scale
    else
       !scale = 10000000
    endif

     !command = !att & ' num '  & !i.string() & ' ' & !scale.string()
     $!command
     !i = !i + 1
  enddo

endmethod
