--  adpSteelOpt()                    -
--  assocAdd()                       -
--  assocRemove()                    -
--  closeForm()                      -
--  getAssocArrays(ARRAY,ARRAY)      -
--  getDisplayText(STRING)           STRING
--  init()                           -
--  initScaleLists()                 -
--  readAssoc()                      -
--  readAsym()                       -
--  readBSList()                     -
--  readDVFlag()                     -
--  readMacro()                      -
--  readMergeFlag()                  -
--  readPicFiles()                   -
--  readRuleset()                    -
--  readScaleList(GADGET,STRING)     -
--  readThreshold()                  -
--  removeDuplicateScales(GADGET)    -
--  removeSelected()                 -
--  saveOptions(STRING)              -
--  selectScale(GADGET,GADGET)       -
--  setAnSymCe()                     -
--  setAnSymInput()                  -
--  setDefaults()                    -
--  setMacro()                       -
--  setRulesetCe()                   -
--  setRulesetInput()                -
--  sortAssocDesi()                  -
--  sortScales(GADGET)               -
--  validAnSym()                     BOOLEAN
--  validAssoc()                     STRING
--  validAssocPadd()                 BOOLEAN
--  validBSList()                    BOOLEAN
--  validMacro()                     BOOLEAN
--  validOptions()                   STRING
--  validScaleList(GADGET)           BOOLEAN
--  validThreshold()                 BOOLEAN
--  validType(GADGET,STRING)         BOOLEAN
--  validateThreshold()              -
--  writeAssoc()                     -
--  writeAsym()                      -
--  writeBSList()                    -
--  writeDVFlag()                    -
--  writeMacro()                     -
--  writeMergeFlag()                 -
--  writeMergeLevel()                -
--  writePicFiles()                  -
--  writeRuleset()                   -
--  writeScaleList(GADGET,STRING)    -
--  writeThreshold()                 -
