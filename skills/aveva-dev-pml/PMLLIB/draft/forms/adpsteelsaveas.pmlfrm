--
--
-- Description:
-- steelwork adp options Save As form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  saveName()                       -
--  setName()                        -
--  setNameFromOpt()                 -
--
setup form !!adpSteelSaveAs
  !!adpSteelSaveAs.formTitle     = 'SDAOPT Save As ...'
  !!adpSteelSaveAs.iconTitle     = 'SDAOPT Save As'
  !!adpSteelSaveAs.initCall      = '!!adpSteelSaveAs.init()'

  paragraph .oldText  at x0   ymax+0.2 text 'select ' lines 1
  option    .oldOpts  at xmax ymin call '!this.setNameFromOpt()' width 25
  paragraph .newText  at x0   ymax+0.2 text 'name ' lines 1
  text      .newName  at xmin.oldOpts ymin call '!this.setName()' width 27 string

  button .save     |Save|       at x0 ymax+0.5 call |!this.saveName()|
  button .cancel   |Dismiss|    at xmax form-size ymin call '!!adpSteelOpt.setActive(true)' cancel

exit

define method .init()
  var !adpLbx COLLECT ALL SDAOPT
  !dt = object ARRAY()
  !rt = object ARRAY()
  do !a values !adpLbx
    !rt.append(!a)
    !dt.append(!a.dbref().fullname)
  enddo

  !this.oldOpts.dtext = !dt
  !this.oldOpts.rtext = !rt

  !this.newName.val = |unset|
endmethod
-- End of method definition for .init()

define method .setNameFromOpt()
  !this.newName.val = !this.oldOpts.selection('Dtext')
endmethod
-- End of method definition for .setNameFromOpt()

define method .setName()

-- CASE A : already existing SDAOPT name?
  !na = !this.newName.val
  !a = !!exists(!na, 'SDAOPT' ,string())
  handle any
   !a = false
  endhandle

-- CASE C: already existing SDAOPT FULLNAME?
  !c = false
  !nc = STRING()
  if (NOT !a) then
    !n = !this.newName.val
    !nref = !n.dbref()
    handle any
      !c = false
    endhandle
     if (defined(!nref) and !nref.set()) then
       !nc = !nref.name
       !c = !!exists(!nc, 'SDAOPT' ,string())
     endif
  endif

  if     (!a) then
   !this.newName.val = !!namtopdmsname(!na)
   return
  elseif (!c) then
   return
  endif

  !!namegadget(!this.newName,'NEW')

  if (!this.newName.val EQ '/*') then
   !this.newName.val = 'unset'
  endif
endmethod
-- End of method definition for .setName()

define method .saveName()
 !n = !this.newName.val

 if (!n.unset() or !n.empty() or !n.lowcase() EQ 'unset') then
   return error 2 |ADP Error: No name has been specified.|
 else
  !!adpSteelOpt.adpLbName.val = !this.newName.val
  !!adpSteelOpt.saveOptions('SAVE')
  !this.hide()
  !!adpSteelOpt.setActive(true)
  !!adpSteel.adpLbName.select('dtext',!this.newName.val)
 endif

endmethod
-- End of method definition for .saveName()
