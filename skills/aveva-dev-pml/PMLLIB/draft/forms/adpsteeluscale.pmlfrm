--
--
-- Description:
-- steelwork adp scale entry form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -
--  dismiss()                        -
--
setup form !!adpsteeluscale
   member .scaleList is GADGET

  !!adpsteeluscale.formTitle     = 'SDAOPT User defined scale'
  !!adpsteeluscale.iconTitle     = 'SDAOPT User defined scale'

  paragraph .uScaleHead at xmin ymax text |Enter required Detail View scale | lines 1
  paragraph .uScaleEg at xmin ymax text |E.g.  1 to  64|
  paragraph .oneTo   at xmin ymax text   |1 to | lines 1
  text      .uScale  at  xmax.oneTo ymin.oneTo  call |!this.add()| width 10 num

  button .addScale |Add|       at xmax.uScale ymin.uScale call |!this.add()|
  button .cancel   |Dismiss|  at xmax.addScale+3 ymin.addScale call |!this.dismiss()| cancel

exit


define method .dismiss()
  !!adpsteelopt.setActive( TRUE )
  !this.hide()
endmethod

define method .add()
  if (!this.uScale.val.unset() or !this.uScale.val eq '' ) then
     return
  endif
-- invalid if out of range
  !t = !this.uScale.val.real()
  if ( !t LE 0.1 OR !t GT 10000000) then
      return error 2 |ADP Error:  Scale value must lie between 0.1 and 1EX+07|
  endif

  !dtList = !this.scaleList.dText
  !rtList = !this.scaleList.rText

  !rVal = !this.uScale.val
  !rVal = !rVal.real().string()
  !dVal = !!adpsteelopt.getDisplayText(!rVal)

  !dtList.append(!dVal)
  !rtList.append(!rVal)

  !this.scaleList.dText = !dtList
  !this.scaleList.rText = !rtList

  !!adpsteelopt.sortScales(!this.scaleList)
  !!adpsteelopt.removeDuplicateScales(!this.scaleList)
  !this.scaleList.select('dText',!dVal)
  !this.uScale.setFocus()
endmethod
