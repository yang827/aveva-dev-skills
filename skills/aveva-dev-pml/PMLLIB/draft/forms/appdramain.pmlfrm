--
--
-- Description:     Main form for Draft module
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addLink()                        -                   Callback to display the AddLink Dialog (LinkDocuments)
--  adminMenuEntries()               -                   Creates extra menu entries visible in Admin apps
--  alignTemplateGadget()            -                   Assures that template toolbar toggle gadget is aligned template form
--  appDraMain()                     -                   Constructor method
--  switchAdminState(BOOLEAN)        -                   Switches between User and Administrative applications
--  switchApplication(STRING,BOOLEAN) -                   Switches between applications
--  updateGadgets()                  -                   Updates the gadgets on the main form for current application
--  updateGadgets(APPDEFN)           -                   Updates the gadgets on the main form for the application specified
--
------------------------------------------------------------------------
setup form !!appDraMain main
  -- get list of applications
  if (undefined(!!appCntrl)) then
    !!appreadappdefns('DRA')
  endif

  -- check for undefined AutoDraft switch
  if (undefined(!!cdAutoDraft)) then
    var !!cdAutoDraft |ON|
  endif
  var !!cdAutoDraft (upcase(|$!!cdAutoDraft|))

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size now 16 because size of toolbar buttons can't be changed
  !iconSize = 16

  title     |Draft - AVEVA PDMS|
  iconTitle |Draft - AVEVA PDMS|
  revision  | $$Revision: 1.34 $ |
  !this.quitCall = 'CALLIB XEXIT'

  -- Main bar Menu
  bar
  exit
  !bar = !this.bar
  !bar.add('Draft', 'MBDRAFT')
  !bar.add('Display', 'MBDISPLAY')
  !bar.add('Graphics', 'MBGRAPHICS')
  !bar.add('3D View', 'coreViewMenu')
  !bar.add('Selection', 'coreSelectMenu')
  !bar.add('Query', 'MBQUERY')
  !bar.add('Settings', 'MBSETTINGS')
  !bar.add('Utilities', 'MBUTILS')
  !bar.add('Window', 'WINDOW')
  !bar.add('Help', 'HELP')

  -------------------------------------------
  -- Main toolbar
  -------------------------------------------
  -- get work
  -- frame .draftMainToolbar toolbar 'Draft Main Toolbar'
  button .mtbGetWork 'Get Work' tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |!!exitModifyMode()
  GETWORK|

  -- save work
  button .mtbSaveWork 'Save Work' tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- List Creation/modification
  button .mtbCreateList 'Create/Modify Lists' tooltip 'Create/Modify Lists' pixmap width $!iconSize height $!iconSize callback |CALLIB SHOWFORM _CDCLIST|

  -- Active List/Collection
  option .list tooltip 'Active List' callback |CALLIB ILIST $$_LIST| width 10

  -- Delete CE
  button .mtbDeleteCe 'Delete CE' tooltip 'Delete CE' pixmap width $!iconSize height $!iconSize callback |CALLDRG MDELCE|

  -- Print CE
  button .mtbPrintCe 'Print CE' tooltip 'Print CE' pixmap width $!iconSize height $!iconSize callback |show !!utilPrintOptions|

  !this.mtbGetWork.addPixmap(!!pml.getPathName('getwork' & !iconSize & '.png'))
  !this.mtbSaveWork.addPixmap(!!pml.getPathName('savework' & !iconSize & '.png'))
  !this.mtbDeleteCe.addPixmap(!!pml.getPathName('deletece' & !iconSize & '.png'))
  !this.mtbCreateList.addPixmap(!!pml.getPathName('createlist' & !iconSize & '.png'))
--  !this.mtbPrintCe.addPixmap(!!pml.getPathName('print' & !iconSize & '.png'))
  !this.mtbPrintCe.addPixmap(!!pml.getPathName('ad_t_008.png'))

  -- --------------------------------------------------------------------------------------------------------------------------------
  --  DO NOT ATTEMPT TO MODIFY THE NAMES OR DEFINITIONS OF ANY .core BUTTONS.  THESE ARE CONTROLLED BY PDMS DRAFT CORE.
  -- --------------------------------------------------------------------------------------------------------------------------------
  -- -- undo & redo buttons
   !undoIcon     = !!pml.getPathName('activeundo' & !iconSize & '.png')
   !redoIcon     = !!pml.getPathName('activeredo' & !iconSize & '.png')
   frame .undoToolbar toolbar 'Undo-Redo'
     button .coreUndoButton          'Undo'         tooltip 'Undo'          pixmap "$!<undoIcon>" width $!iconSize height $!iconSize
     button .coreRedoButton          'Redo'         tooltip 'Redo'          pixmap "$!<redoIcon>" width $!iconSize height $!iconSize
   exit
  !this.coreUndoButton.active = false
  !this.coreRedoButton.active = false
  !!appTbarCntrl.addToolbar('undoToolbar')

  -- -----------------------------------------
  -- Application toolbar
  -- -----------------------------------------

  -- hide these toolbars by default, by not registering them with the toolbar controlling object

  frame .workingSheetToolbar toolbar 'Working Sheet'
    button .cycle  'Close Sheet' tooltip 'Close Sheet' call |CALLIBM UPURGESHEE|  pixmap $!!cdrPmDrop width 16 height 16
    button .select 'Open Sheet' tooltip 'Open Sheet' call |CALLIBM XELEMSEL| pixmap $!!cdrPmCheck width 16 height 16
    option .sheet  tooltip 'Current working sheet' call |CALLIBM UELEMSEL $<$$_SHEET$>| width $!!cdSheeWidth
  exit

  frame .layerToolbar toolbar 'Layers'

    option .notesViews  tooltip 'Current Note or View ' call |!this.layerControl.selectNoteView()|            zerosel       width 6
    option .layeNam     tooltip 'Current Layer '        call |CALLIBM XLAYESEL _$!this $<$$_LAYENAM$>|                      width $!!cdNoteWidth
    option .layerFilter tooltip 'Filter Layers '        call |call !!draFilterLayers(!this.layerFilter.selection(), false)| width 8
    option .lvis        tooltip 'Layer visibility '     call |CALLIBM XLAYESEL _$!this $<$$_LAYENAM$> LVIS|                 width 2

    !dtext[1] = 'All'
    !dtext[2] = 'Dimensions'
    !dtext[3] = 'Labels'
    !dtext[4] = '2D Draughting'
    !rtext[1] = 'ALL'
    !rtext[2] = 'DIM'
    !rtext[3] = 'LAB'
    !rtext[4] = 'DRA'
    !this.layerFilter.dtext = !dtext
    !this.layerFilter.rtext = !rtext

    !dtext = ARRAY()
    !rtext = ARRAY()
    !dtext[1] = 'On'
    !dtext[2] = 'Off'
    !rtext[1] = 'true'
    !rtext[2] = 'false'
    !this.lvis.dtext = !dtext
    !this.lvis.rtext = !rtext

  exit

  -- is the form currently in Admin state?
  member .admin           is BOOLEAN

  -- members to store the current Admin and User apps so we can switch to them when we change between Admin and User modes
  member .currentAdminApp is STRING
  member .currentUserApp  is STRING

  -- Layer data object
  member .layerControl    is APPDRALAYERCTRL

  -- now set up toolbars and menus for the applications
  -- toolbars
  !!appCntrl.modifyForm()


exit

------------------------------------------------------------------------
--
-- Method:      .appDraMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDraMain()
  -- find current project and global status
  !project = current project
  !isGlobal = !project.isGlobal()

  -- Design Menu
  !menu = !this.newMenu('mbDraft')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Save Work',          'CALLG MSAVEW',             'savework')
  !menu.add('CALLBACK', 'Get Work',           'GETWORK',                  'getwork')
  !menu.add('CALLBACK', 'Extract Control...', 'call !!admExtractCntrl()', 'extractControl')
  !menu.add('FORM',     'Session Comment...', 'msgsavework',              'sessionComment')
  !menu.add('SEPARATOR')
  if (!!cdAdmin.boolean()) then
    !menu.add('FORM',     'Select Working Library...', 'CDRLIBYSEL',        'selWorkingLibrary')
    !menu.add('SEPARATOR')

    -- Application Definitions
    !!appCntrl.appMenu(!menu, |!this.switchApplication('APPNAME', false)|, true)

    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', 'User Application...', '!this.switchAdminState(false)', 'userApplication')
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', 'Administration...',   '!this.switchAdminState(true)', 'administration')
  else
    -- Application Definitions
    !!appCntrl.appMenu(!menu, |!this.switchApplication('APPNAME', false)|, false)
  endif
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Modules', 'modules', 'modules')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Exit', 'CALLIB XEXIT', 'exit')

  -- menu _MBDISPLAY
  !menu = !this.newMenu('mbDisplay')
  !menu.add('CALLBACK', |Main...|, |!!exitModifyMode()
  CALLDRG MSINGLEV $<$> MAIN|, 'Main')
  !menu.add('CALLBACK', |Reference...|, |!!exitModifyMode()
  CALLDRG MSINGLEV|, 'Reference')
  !menu.add('CALLBACK', |3D View...|, |!!draShowView3dInDraft()|, '3DView')
  -- added for PDMS 11.6 core-controlled menu items
  !menu.add('separator')

  !explorersMenu = !this.newMenu('explorersMenu')
  !menu.add('MENU', 'Explorers', 'explorersMenu')
  !moduleManager = object AvevaModuleManager()
  if (!moduleManager.currentModule().name().upcase() eq 'DRAFT') then
     !explorersMenu.add('TOGGLE',   'Draft Explorer',     '',            'Draft Explorer')
     !explorersMenu.add('TOGGLE',   'Design Explorer',     '',           'Design Explorer')
     !explorersMenu.add('TOGGLE',   'Fabrication Explorer',     '',      'Fabrication Explorer')
  elseif (!moduleManager.currentModule().name().upcase() eq 'OUTFITTINGDRAFT') then
     !explorersMenu.add('TOGGLE',   'Draft Explorer',     '',            'Draft Explorer')
     !explorersMenu.add('TOGGLE',   'Design Explorer',     '',           'Design Explorer')
     !explorersMenu.add('TOGGLE',   'Fabrication Explorer',     '',      'Fabrication Explorer')
     !explorersMenu.add('TOGGLE',   'Manufacturing Explorer',     '',    'Manufacturing Explorer')
  endif

  !menu.add('TOGGLE', 'My Data',         '', 'My Data')
  !menu.add('TOGGLE', 'Reference List',  '', 'Reference List')
  !menu.add('TOGGLE', 'Attributes...',  '', 'Attributes Utility')
  !menu.add('TOGGLE', 'Search...',  '', 'Find Utility')
  !menu.add('TOGGLE', 'Search Results...',  '', 'Output Utility')
  !linksMenu = !this.newMenu('linksMenu')
  !menu.add('MENU',   'Link Documents',  'linksMenu')
  !linksMenu.add('CALLBACK', 'Add Link...',    '!this.addLink()')
  !linksMenu.add('TOGGLE',   'Links',  '',      'Links List')
  -- Make sure this command does not appear in PDMS Draft
  if( !!appCntrl.modKey.neq('DRA') ) then
    !linksMenu.add('CALLBACK',  |Open Sheet from Link Documents...|,  |!!openfromlinkdoc()|, 'OpenSheetFromLinkDocuments')
  endif
-- end of additions
  !menu.add('separator')
  !menu.add('FORM', |Plot...|, 'plotView', 'plot')
  !menu.add('TOGGLE',   'Status Controller',  '',  'Status Controller')
  !menu.add('CALLBACK', |Members...|, |show _CDC$$!!cdMemNam free|, 'Members')
  !menu.add('separator')
  !menu.add('CALLBACK', |Command Window...|, |show _CADCBTH free|, 'CommandLine')
  !menu.add('separator')
  !menu.add('FORM', |Appware Load Errors...|, 'CDRERRDISP', 'AppwareLoadErrors')

  !menu = !this.newMenu('MBGRAPHICS')
  !menu.add('MENU', 'Update', 'MBUPDATE', 'Update')
  !menu.add('MENU', 'System Update', 'MBSUPDATE', 'SystemUpdate')
  !menu.add('MENU', 'Background Process', 'MBUPDATEBG', 'BackgroundProcess')

  !menu = !this.newMenu('MBUPDATE')
  !menu.add('CALLBACK', |Design|,             |!!exitModifyMode()
  CALLIBM UUPDATE DESIGN|, 'Design')
  !menu.add('CALLBACK', |Design Changes|,     |!!draRunCompdate('MENU','DESIGN')|, 'DesignChanges')
  !menu.add('CALLBACK', |Annotation|,         |!!exitModifyMode()
  CALLIBM UUPDATE  ANNO|, 'Annotation')
  !menu.add('CALLBACK', |Annotation Changes|, |!!draRunCompdate('MENU','ANNO')|, 'AnnotationChanges')
  !menu.add('CALLBACK', |Tagging|,            |!!exitModifyMode()
  CALLDRG MTAGREGEN FALSE|, 'Tagging')
  !menu.add('CALLBACK', |Tagging Regenerate|, |!!exitModifyMode()
  CALLDRG MTAGREGEN TRUE|, 'TaggingRegenerate')
  !menu.add('CALLBACK', |Backing Sheets|,     |!!exitModifyMode()
  CALLIBM UUPDATE  BSHEETS|, 'BackingSheets')
  !menu.add('CALLBACK', |All|,                |!!exitModifyMode()
  CALLIBM UUPDATE ALL|, 'All')
  !menu.add('CALLBACK', |All Changes|,        |!!draRunCompdate('MENU','ALL')|, 'AllChanges')

  !menu = !this.newMenu('MBSUPDATE')
  !menu.add('CALLBACK', |Picture|,     |!!exitModifyMode()
  CALLIBM UUPDATE PICTURE|, 'Picture')
  !menu.add('CALLBACK', |Instances|,   |!!exitModifyMode()
  CALLIBM UUPDATE INSTANCES|, 'Instances')
  !menu.add('CALLBACK', |Refs|,        |!!exitModifyMode()
  CALLIBM UUPDATE REFS|, 'Refs')
  !menu.add('CALLBACK', |Names|,       |!!exitModifyMode()
  CALLIBM UUPDATE NAMES|, 'Names')

  !menu = !this.newMenu('MBUPDATEBG')
  !menu.add('MENU', 'Update', 'MBBGUPDATE', 'BGUpdate')
  !menu.add('CALLBACK', |Refresh|,             |!!exitModifyMode()
  call !!draBackgroundProcessGet('ce')|, 'Refresh')

  !menu = !this.newMenu('MBBGUPDATE')
  !menu.add('CALLBACK', |Design|,             |!!exitModifyMode()
  CALLIBM UUPDATE DESIGN IGNORE NOWAIT|, 'DesignNoWait')
  !menu.add('CALLBACK', |Design Changes|,     |!!draRunCompdate('MENU','DESIGN IGNORE NOWAIT')|, 'DesignChangesNoWait')
  !menu.add('CALLBACK', |All|,                |!!exitModifyMode()
  CALLIBM UUPDATE ALL IGNORE NOWAIT|, 'AllNoWait')
  !menu.add('CALLBACK', |All Changes|,        |!!draRunCompdate('MENU','ALL IGNORE NOWAIT')|, 'AllChangesNoWait')

  !menu = !this.newMenu('MBQUERY')
  !menu.add('CALLBACK', 'Attributes...', '!!attributesTracking()', 'Attributes')
  !menu.add('CALLBACK', '2D...', 'show _CDR2DQUERY free', '2D')
  !menu.add('CALLBACK', 'Design General...', 'CALLIBQ XATTFORM _CDGENQ FREE', 'DesignGeneral')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Project...', 'qryProject', 'Project')
  !menu.add('FORM', 'User Status...', 'userStatus', 'UserStatus')
  !menu.add('FORM', 'Data Access Control...', 'qrydac', 'DataAccessControl')
  !menu.add('CALLBACK', 'DB Changes...    ', |call !!displayOutput('Change')|, 'DBChanges')
  -- Added Global state menu included with communications form and (project lock & isolation) form.
  if (!isGlobal) then
    !menu.add('SEPARATOR')
    !menu.add('menu', 'Global Status',            'glbStates')

     ----------------------------- Global State Menu -----------------------------
    !glbStates      = !this.newMenu('glbStates')
    if(undefined(!!admControl)) then
      call !!comDefineGlobal(object ADMCONTROL())
    endif
    if(!!admControl.isValid('Locking and Isolation')) then
      !glbStates.add('callback',  'Locking & Isolation...',  'show !!glbQryLockIsol')
    endif

    -- None off line working
    if(!!admControl.isValid('Communications')) then
      !glbStates.add('callback',  'Communications...',       'show !!glbModulesPing')
    endif
  endif

  -- main bar settings menu
  !menu = !this.newMenu('MBSETTINGS')
  --!menu.add('CALLBACK', 'System...', '!!comSysOpt.edit()', 'System')
--  !menu.add('FORM', 'Global...', 'CDRSETDEF', 'Global')
  !menu.add('FORM', 'User Defaults...', 'CDRUDFLTS', 'UserDefaults')
--  !menu.add('FORM', 'Point Construction...', 'CDRPOINTCON', 'PointConstruction')
  !menu.add('FORM', 'Units...', 'comFormatsSelect', 'Units')
--  !menu.add('FORM', 'Enhance Colour...', 'CDRGROUPCOL', 'EnhanceColour')
--  !menu.add('FORM', 'Feedback Colour...', 'CDRRBANDCOL', 'FeedbackColour')
  !menu.add('FORM', 'General Settings...', 'draSettings', 'GeneralSettings')
--  !menu.add('FORM', 'Ppoint Display...', 'CDRPPSET', 'PpointDisplay')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', '3D Representation...', '!!gphRepOpt.edit()', '3DRepresentation')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Comparison Date...', |!!compdate('MENU','SET')|, 'ComparisonDate')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Explorer...', '', 'Explorer Settings')
  !menu.add('CALLBACK', 'Reset Window Layout', '', 'RESET LAYOUT')


  -- main bar utilities menu
  !menu = !this.newMenu('MBUTILS')
  !menu.add('CALLBACK', 'Data Checker...', 'show !!chkStoreView', 'DataChecker')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Print CE...', 'utilPrintOptions', 'PrintCE')
  !menu.add('CALLBACK', 'Plot CE...', 'CALLDRG XPLOTIT', 'PlotCE')
  !menu.add('CALLBACK', 'Standard DXF CE...', 'CALLDRG XDXFIT', 'StandardDXF')
  !menu.add('CALLBACK', 'Configurable DXF/DWG CE...', 'show !!dxfUser free', 'ConfigurableDXF')
  --!menu.add('MENU', 'DXF  CE', 'MBDXFOUTPUT', 'DXFCE')
  !menu.add('CALLBACK', 'DGN  CE...', 'show !!dgnUser free', 'DGNCE')

  -- Add menu entry for the Final Designer product functionality. This entry is a place
  -- holder and will be permanently greyed out.
  -- when Final Designer is installed, it will replace this menu entry with a fully
  -- functioning entry using a PML add-in
  --!menu.add('CALLBACK', |Export to Final Designer...|, '!!draExportFdItem()', 'sheetToFinalDesign')

  !menu.add('FORM', 'Clash Plotting...', 'CDRCLASHPLOT', 'ClashPlotting')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Lists...', 'CALLIB SHOWFORM _CDCLIST', 'Lists')
  !menu.add('CALLBACK', 'Claimlists...', 'show !!lstClaim ', 'Claimlists')
  !menu.add('CALLBACK', 'DB Listing...', |call !!displayOutput('Datal')|, 'DBListing')
  if (!isGlobal) then
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', 'Transactions...', 'show !!glbTransactions', 'Transactions')
  endif
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Reporting', 'sysExpReporting', 'expreporting')
  !menu.add('MENU', 'Standard Reporting', 'sysStdReporting', 'stdreporting')

  -- (AK) add general utilities to DRAFT
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'General Utilities...', 'CALLG XUTILITIES $$<$$> $$<GEN$$> $$<DRA$$>', 'GeneralUtilities')

  !menu = !this.newMenu('MBSYSREP')
  !menu.add('CALLBACK', 'Run...', 'CALLIBR XREPSEL RUN', 'Run')
  !menu.add('CALLBACK', 'Create...', 'CALLIBR XREPDEF', 'Create')
  !menu.add('CALLBACK', 'Modify...', 'CALLIBR XREPSEL MODIFY', 'Modify')
  !menu.add('CALLBACK', 'Delete...', 'CALLIBR XREPSEL DELETE', 'Delete')

  -- Reporting menu
  !menu = !this.newMenu('sysStdReporting')
  !menu.add('MENU', 'Reports', 'MBSYSREP', 'reports')
  !menu.add('CALLBACK', 'Quick Reports...', 'show !!rptQuick', 'quickReports')

   -- Dev Xpress Reporting menu
  !menu = !this.newMenu('sysExpReporting')
  !menu.add('CALLBACK', 'Run Report...', '', 'Run Report')
  !menu.add('CALLBACK', 'Designer...', '', 'Reporting Designer')

  var !user user
  !u=object user(!user)
  !teamList = !u.teamList()
  do !teamName values !teamList
    if (!teamName.name eq 'AVEVANETADMIN') then
      !menu.add('SEPARATOR')
      !menu.add('CALLBACK', 'Publish To AVEVA Net Configuration', '', 'AVEVA NET Configuration')
      break
    endif
  enddo

--  !menu = !this.newMenu('MBDXFOUTPUT')
--  !menu.add('CALLBACK', 'Standard...', 'CALLDRG XDXFIT', 'Standard')
--  !menu.add('CALLBACK', 'Configurable...', 'show !!dxfUser free', 'Configurable')$* form !!dxfUser

    -------------------------------------------
    -- Add core callbacks for 3d view menus
    -------------------------------------------
    -- View menu
    !coreViewMenu = !this.newMenu('coreViewMenu')
    !coreMiddleButtonDrag = !this.newMenu('coreMiddleButtonDrag')
    !coreViewMenu.add('MENU', 'Middle Button Drag', 'coreMiddleButtonDrag')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Zoom Rectangle', '','V_ZOOR')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Zoom In/Out','', 'V_ZOOM')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Rotate','', 'V_ROTE')
    !coreMiddleButtonDrag.add('CORETOGGLE', 'Pan', '','V_PANN')
    !coreViewMenu.add('SEPARATOR')

    !coreViewMenu.add('CORECALLBACK', 'Print Graphics...', '', 'V_PRNG')

    !coreCopyImage = !this.newMenu('coreCopyImage')
    !coreViewMenu.add('MENU', 'Copy Image', 'coreCopyImage')
    !coreCopyImage.add('CORECALLBACK', '640x480','', 'V_CPY1')
    !coreCopyImage.add('CORECALLBACK', '800x600', '','V_CPY2')
    !coreCopyImage.add('CORECALLBACK', '1024x768', '','V_CPY3')
    !coreCopyImage.add('CORECALLBACK', '1600x1200','', 'V_CPY4')
    !coreViewMenu.add('SEPARATOR')

    !coreZoomTo = !this.newMenu('coreZoomTo')
    !coreViewMenu.add('MENU', 'Zoom To', 'coreZoomTo')
    !coreZoomTo.add('CORECALLBACK', 'Selection', '','V_ZSEL')
    !coreZoomTo.add('CORECALLBACK', 'Identify Element...','', 'V_ZELE')
    !coreZoomTo.add('CORECALLBACK', 'Entire Draw List', '','V_ZDRW')

    !coreSaveView = !this.newMenu('coreSaveView')
    !coreViewMenu.add('MENU', 'Save View', 'coreSaveView')
    !coreSaveView.add('CORECALLBACK', 'View 1', '','V_SAV1')
    !coreSaveView.add('CORECALLBACK', 'View 2', '','V_SAV2')
    !coreSaveView.add('CORECALLBACK', 'View 3', '','V_SAV3')
    !coreSaveView.add('CORECALLBACK', 'View 4', '','V_SAV4')

    !coreRestoreView = !this.newMenu('coreRestoreView')
    !coreViewMenu.add('MENU', 'Restore View', 'coreRestoreView')
    !coreRestoreView.add('CORECALLBACK', 'View 1', '','V_REV1')
    !coreRestoreView.add('CORECALLBACK', 'View 2', '','V_REV2')
    !coreRestoreView.add('CORECALLBACK', 'View 3', '','V_REV3')
    !coreRestoreView.add('CORECALLBACK', 'View 4', '','V_REV4')
    !coreViewMenu.add('SEPARATOR')

    !coreLook = !this.newMenu('coreLook')
    !coreViewMenu.add('MENU', 'Look', 'coreLook')
    --  !coreLook.add('CORECALLBACK', 'Through View Finder', '','V_VWFI')
    !coreLook.add('CORECALLBACK', 'North', '','V_LNOR')
    !coreLook.add('CORECALLBACK', 'South', '','V_LSOU')
    !coreLook.add('CORECALLBACK', 'East', '','V_LEAS')
    !coreLook.add('CORECALLBACK', 'West', '','V_LWES')
    !coreLook.add('CORECALLBACK', 'Up', '','V_LUPP')
    !coreLook.add('CORECALLBACK', 'Down', '','V_LDOW')

    !corePlan = !this.newMenu('corePlan')
    !coreViewMenu.add('MENU', 'Plan', 'corePlan')
    !corePlan.add('CORECALLBACK', 'North', '','V_PNOR')
    !corePlan.add('CORECALLBACK', 'South', '','V_PSOU')
    !corePlan.add('CORECALLBACK', 'East', '','V_PEAS')
    !corePlan.add('CORECALLBACK', 'West', '','V_PWES')

    !coreIsometric = !this.newMenu('coreIsometric')
    !coreViewMenu.add('MENU', 'Isometric', 'coreIsometric')
    !coreIsometric.add('CORECALLBACK', 'ISO 1', '','V_ISO1')
    !coreIsometric.add('CORECALLBACK', 'ISO 2', '','V_ISO2')
    !coreIsometric.add('CORECALLBACK', 'ISO 3', '','V_ISO3')
    !coreIsometric.add('CORECALLBACK', 'ISO 4', '','V_ISO4')
    !coreViewMenu.add('SEPARATOR')

    !coreSetCentreofView = !this.newMenu('coreSetCentreofView')
    !coreViewMenu.add('MENU', 'Set Centre of View', 'coreSetCentreofView')
    !coreSetCentreofView.add('CORECALLBACK', 'Selection', '','V_CSEL')
    !coreSetCentreofView.add('CORECALLBACK', 'Identify Element...', '','V_CELE')
    !coreSetCentreofView.add('CORECALLBACK', 'Screen Pick...','', 'V_CPIK')
    !coreViewMenu.add('SEPARATOR')

    !coreViewSettings = !this.newMenu('coreViewSettings')
    !coreViewMenu.add('MENU', 'Settings', 'coreViewSettings')
    !coreViewSettings.add('CORETOGGLE', 'Eye', '','V_EYEM')
    !coreViewSettings.add('CORETOGGLE', 'Shaded','','V_SHAD')
    !coreViewSettings.add('CORETOGGLE', 'Borders','', 'V_BORD')
    !coreViewSettings.add('CORETOGGLE', 'Perspective','','V_PERS')
    !coreViewSettings.add('SEPARATOR')
    !coreViewSettings.add('CORETOGGLE', 'Black Background','', 'V_BLKB')
    !coreViewSettings.add('CORETOGGLE', 'White Background', '','V_WHIB')
    !coreViewSettings.add('SEPARATOR')
    !coreViewSettings.add('CORETOGGLE', 'Draft Pick Mode','','V_PICK')

 -- Selection Menu
    !coreSelectMenu = !this.newMenu('coreSelectMenu')
    !coreSelectMenu.add('CORETOGGLE', 'Feature Highlighting', '','S_FHMO')
    !coreSelectMenu.add('SEPARATOR')
    !coreSelectMenu.add('CORECALLBACK', 'Set Increments...', '','S_SINC')
    !coreSelectMenu.add('SEPARATOR')

    !coreSetHandleColour = !this.newMenu('coreSetHandleColour')
    !coreSelectMenu.add('MENU', 'Set Handle Colour','coreSetHandleColour')
    !coreSetHandleColour.add('CORETOGGLE', 'White', '','S_HCWH')
    !coreSetHandleColour.add('CORETOGGLE', 'Orange', '','S_HCOR')
    !coreSetHandleColour.add('CORETOGGLE', 'Blue', '','S_HCBL')
    !coreSetHandleColour.add('CORETOGGLE', 'Green', '','S_HCGR')
    !coreSetHandleColour.add('CORETOGGLE', 'Cyan', '','S_HCCY')
    !coreSetHandleColour.add('CORETOGGLE', 'Magenta', '','S_HCMA')
    !coreSetHandleColour.add('CORETOGGLE', 'Yellow', '','S_HCYE')

    !coreSelectRectangle = !this.newMenu('coreSelectRectangle')
    !coreSelectMenu.add('MENU', 'Select Box', 'coreSelectRectangle')
    !coreSelectRectangle.add('CORETOGGLE', 'Wholly Within', '','S_WHWM')
    !coreSelectRectangle.add('CORETOGGLE', 'Wholly and Partially Within','', 'S_WPWM')
  -------------------------------------------

  -- build module menus
  !!moduleMenus(!this)

  -- get round problem of parts of the appware referring to the main form directly by name, by setting !!cdrGenApp to this form
  !!cdrGenApp = !!appDraMain

  -- set !!cdapplic to the name of this form
  !!cdapplic = '_APPDRAMAIN'

  -- and !!cdMainForm
  !!cdMainForm = '_APPDRAMAIN'

  -- initially not in admin mode
  !this.admin = false

  -- set default Admin and User applications
  !this.currentUserApp = 'GEN'
  !this.currentAdminApp = 'LIBMGEN'

  -- add Admin menu entries if we're in Admin mode
  if (!!cdAdmin.boolean()) then
    !this.adminMenuEntries()
    !this.switchAdminState(false)
  endif


  -- add application-specific fields and those added by add-ins
  !!appCntrl.modifyMenus()

endmethod
-- End of method definition for .appDraMain()

------------------------------------------------------------------------
--
-- Method:      .adminMenuEntries()
--
-- Description: adds menu entries to be visible in administrative applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .adminMenuEntries()
  !menu = object APPMENU(!this.mbSettings)
  !menu.add('SEPARATOR', 'adminSettingsSep')
  !menu.add('FORM', 'System Defaults...', 'CDRDFLTS', 'SystemDefaults')
  !menu.add('FORM', 'User-defined Pen Settings...', 'CDRPENSET', 'UserDefinedPenSettings')
  !menu.add('FORM', 'Plotting Defaults...', 'CDCPLOT4A', 'PlottingDefaults')
  !menu.add('CALLBACK', 'DXF Configuration Settings...', 'show !!dxfASet free', 'DXFConfigurationSettings')
  !menu.add('CALLBACK', 'DGN Configuration Settings...', 'show !!dgnASet free', 'DGNConfigurationSettings')
  !menu.add('SEPARATOR', 'loadDataFilesSep')
  !menu.add('FORM', 'Load Data Files...', 'CDRLOADDATA', 'LoadDataFiles')
  !!appMenuCntrl.addMenu(!menu, 'ADMINAPPS')

  !menu = object APPMENU(!this.mbUtils)
  !menu.add('SEPARATOR', 'adminUtilsSep')
  !menu.add('FORM', 'Set View Scale Ratios...', 'CDRSETVRAT', 'SetViewScaleRatios')
  !menu.add('FORM', 'Load Data File...', 'CDRLOADDATA', 'LoadDataFile')
  !!appMenuCntrl.addMenu(!menu, 'ADMINAPPS')

  -- put a separator above the General Admin app
  !this.mbDraft.insertBefore('LIBMGEN', 'SEPARATOR')
endmethod
-- End of method definition for .adminMenuEntries()

------------------------------------------------------------------------
--
-- Method:      .switchAdminState()
--
-- Description: run when switching between Administrative and User applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchAdminState(!isAdmin is BOOLEAN)
  -- activate the menu entries for the applications that have admin state !admin
  -- grey out the menu entries for the applications that have admin state !admin.not()

  !property = 'VISIBLE'

  do !app values !!appCntrl.apps
    !title = !app.menu()
    skip if (!title.empty() or !app.showOnMenu.not())
    if (!app.admin) then
      !this.mbDraft.setFieldProperty(!app.name, !property, !isAdmin)
    else
      !this.mbDraft.setFieldProperty(!app.name, !property, !isAdmin.not())
    endif
  enddo

  -- activate the menu entry that switches the Admin state
  -- grey out the menu entry corresponding to the state we're in
  !this.mbDraft.setFieldProperty('userApplication', !property, !isAdmin)
  !this.mbDraft.setFieldProperty('selWorkingLibrary', !property, !isAdmin)
  !this.mbDraft.setFieldProperty('administration', !property, !isAdmin.not())

  -- grey out/activate other menus
  !!appMenuCntrl.activateMenus('ADMINAPPS', !isAdmin)

  -- return if we're already in the required state
  if (!isAdmin eq !this.admin) then
    return
  endif

  -- otherwise switch mode
  if (!isAdmin) then
    !appName = !this.currentAdminApp
    !this.currentUserApp = !!appCntrl.currentApp()
  else
    !appName = !this.currentUserApp
    !this.currentAdminApp = !!appCntrl.currentApp()
  endif
  !!appxload('DRA', !appName, false)

  !this.updateGadgets()

  !this.admin = !isAdmin
endmethod
-- End of method definition for .switchAdminState(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .switchApplication()
--
-- Description: switches between applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchApplication(!appName is STRING, !clear is BOOLEAN)
  !app = !!appCntrl.getApplic(!appName)
  if (!app.admin) then
    !this.currentAdminApp = !app.name
  else
    !this.currentUserApp = !app.name
  endif

  -- if we're switching from Admin app to user app, or vice versa, then set menu options accordingly
  if (!app.admin ne !this.admin) then
    !this.switchAdminState(!app.admin)
  endif

  !this.updateGadgets(!app)

  !!appxload('DRA', !appName, !clear)

endmethod
-- End of method definition for .switchApplication(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .updateGadgets()
--
-- Description: Updates the gadgets on the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGadgets()
  !this.updateGadgets(!!appCntrl.currentAppObj())
endmethod
-- End of method definition for .updateGadgets()

-- run when application loaded: used to be the last part of XAPPLIC
------------------------------------------------------------------------
--
-- Method:      .updateGadgets()
--
-- Description: Updates the gadgets on the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      APPDEFN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGadgets(!app is APPDEFN)

  -- Does the form contain sheet option gadget
  !gadgets  = !app.gadgets
  if (!gadgets gt 1) then

    !eleTypes = ARRAY()

    if (!app.admin) then
      -- get library types used by this application
      if (!app.types.set()) then
        !eleTypes = !app.types.split()
      endif
      -- make sure element types are upper case
      do !ele values !eleTypes
        !ele = !ele.trim().upcase()
      enddo

      -- get current library
      !current = !!cdrApplic.curLiby.val
    else
      !eleTypes[1] = 'SHEE'
      !eleTypes[2] = 'OVER'

      -- get current sheet
      !current = !!cdrApplic.curShee.val
    endif

    -- Populate _SHEET gadget with all valid elements but truncate display
    -- text to fit - on RH end of constructed names else LH end. Mark
    -- truncation with an ellipsis.
    -- get elements from _CDRAPPLIC_<element type>
    -- display only the elements specified in the
    -- DRA/DFLTS/APPLICATIONS file or (SHEE & OVER) if it has USER status
    !dtext = ARRAY()
    !rtext = ARRAY()

    do !eleType values !eleTypes
      !eleRtext = !!cdrApplic.attribute(!eleType).dtext
      !eleDtext = !eleRtext
      -- truncate text to fit option gadget
      do !val values !eleDtext
        if(!val.length() gt !!cdSheeWidth.real()) then
          if (!val.match('/') eq 1) then
            !index = !val.length() - !!cdSheeWidth.real() + 4
            !val = '...' + !val.substring(!index)
          else
            !val = !val.substring( 1, !!cdSheeWidth.real() - 3 ) + '...'
          endif
        endif
      enddo
      !dtext.appendArray(!eleDtext)
      !rtext.appendArray(!eleRtext)
    enddo

    -- set dtext and rtext for sheet gadget on this form
    !this.sheet.dtext = !dtext
    !this.sheet.rtext = !rtext

    -- attempt to select current element
    !this.sheet.select('RTEXT', !current)
    handle any
      !gadget = !!cdrApplic.attribute(!eleTypes[1]).selection()
      !this.sheet.select('RTEXT', !gadget)
      handle any
        !noShee = true
      elsehandle none
        !noShee = false
      endhandle
    elsehandle none
      !noShee = false
    endhandle

    if (!noShee.not()) then
      !gadget = !this.sheet.selection()
      !!runsynonym('CALLIBM UELEMSEL $!gadget')
    else
      !!cdrCADCGA1.n1.clear()
      handle any
      elsehandle none
        !!cdrCADCGA1.formTitle = !!cdrCADCGA1.n1formTitle
      endhandle

      !this.sheet.clear()

      -- Clear this form layer control object
      !this.layerControl.clearAll()

      -- Clear the layer toolbar gadgets
      !this.layerControl.toolbarClear()

      -- defect 4276 not reinitialising the hidden form correctly
      !!cdrApplic.curShee.val = ''

    endif
  endif

  -- make sure we switch out of modify mode
  !!exitModifyMode()

endmethod
-- End of method definition for .updateGadgets(APPDEFN)

------------------------------------------------------------------------
--
-- Method:      .alignTemplateGadget()
--
-- Description: Assures that template toolbar toggle gadget is aligned template form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .alignTemplateGadget()

  if (defined(!!draTemplateSheets)) then
    !!draTemplateSheets.defaultName.val = !!appDraMain.defaultName.val
  endif

endmethod
------------------------------------------------------------------------
