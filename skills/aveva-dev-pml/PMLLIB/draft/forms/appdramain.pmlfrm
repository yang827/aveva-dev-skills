--Method: .addLink()
--
-- Description: Callback to display the AddLink Dialog (LinkDocuments)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addLink()

  import 'linksaddin'
  handle(1000,0)
  endhandle
  using namespace 'Aveva.Pdms.LinksAddin'
  !aa = object PMLENTRY()
  !aa.addLink()

endmethod
-- End of method definition for .addLink()
