--
-- File:            dgnadvset.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Feb 16 10:16:33 2001
--
--
-- Description:
-- form to allow user to change dgn advanced config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  choices(STRING)                  -                   toggles to inactivate switch choices
--  dgnAdvSet()                      -                   Constructor
--  getOwnerObject()                 DGNOUT              Get Owner's DGN Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DGNOUT)           -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnAdvSet

-- Define form
setup form !!dgnAdvSet

  !!dgnAdvSet.formTitle     = 'DGN - Advanced'
  !!dgnAdvSet.iconTitle     = 'Advanced'
  !!dgnAdvSet.callback      = '!!dgnAdvSet.init()'
  !!dgnAdvSet.formRevision  = ' $Revision: 1.2 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .advanced 'Advanced Settings'
    frame .filling 'Advanced Filling Options'  at x1 y1
      toggle .excludeFill      'Exclude Hatch Fill ' at x1 ymax+0.5 states 'OFF' 'ON'
      toggle .excludeSolidFill 'Exclude Solid Fill ' at xmax ymin states 'OFF' 'ON'
      toggle .excludeArrowFill 'Exclude Arrow Fill ' at xmax ymin states 'OFF' 'ON'
    exit
    toggle .logFile   '' callback '!this.choices(|log|)' at x1 ymax+1 states 'OFF' 'ON'
    text   .logFileName        'Log File Name         ' at xmax ymin width 40 string
    toggle .regressionFile   '' callback '!this.choices(|regression|)' at x1 ymax+0.5 states 'OFF' 'ON'
    text   .regressionFileName 'Regression File Name  ' at xmax ymin width 40 string
  exit

  button .ok      ' OK '     at x0 ymax+0.5    OK
  button .cancel  'Cancel'   at xmax Form-size  ymin CANCEL

exit
-- End of form definition for !!dgnAdvSet

------------------------------------------------------------------------
--
-- Method:      !dgnAdvSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnAdvSet()

  -- define tooltip
  !this.logFile.setToolTip(|Switches Log File On|)
  !this.logFileName.setToolTip(|Log File Name e.g. %PDMSUSER%/draft_dgn_log.txt|)
  !this.regressionFile.setToolTip(|Switches regression File On|)
  !this.regressionFileName.setToolTip(|Regression File Name e.g. %PDMSUSER%/draft_dgn_regression.txt|)
  !this.excludeFill.setToolTip('Exclude Hatch Filling')
  !this.excludeSolidFill.setToolTip('Exclude Solid Filling')
  !this.excludeArrowFill.setToolTip('Exclude Arrowhead/Dot Filling')

  -- define callbacks
  !this.ok.callback         = '!!dgnAdvSet.ok()'
  !this.cancel.callback     = '!!dgnAdvSet.cancel()'
  !this.cancelCall          = '!!dgnAdvSet.cancel()'

endmethod
-- End of method definition for .dgnAdvSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DGNOUT()
    !configData.default()
  endif

  !this.logFile.val     = !configData.logFile()
  !this.logFileName.val = !configData.logFileName()
  !this.choices('log')
  !this.regressionFile.val     = !configData.regressionFile()
  !this.regressionFileName.val = !configData.regressionFileName()
  !this.choices('regression')
  !this.excludeFill.val      = !configData.excludeFill()
  !this.excludeSolidFill.val = !configData.excludeSolidFill()
  !this.excludeArrowFill.val = !configData.excludeArrowFill()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    -- Apply settings to DGN Object
    !configData.logFile( !this.logFile.val )
    !configData.logFileName( !this.logFileName.val )
    !configData.regressionFile( !this.regressionFile.val )
    !configData.regressionFileName( !this.regressionFileName.val )
    !configData.excludeFill( !this.excludeFill.val )
    !configData.excludeSolidFill( !this.excludeSolidFill.val )
    !configData.excludeArrowFill( !this.excludeArrowFill.val )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Update display on Owner and any shown forms
  -- This also de-activates Grouping form/button if appropriate
  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
    !this.main.childFormAccess()
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DGNOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
      return !this.main.getDgnObject()
  else
      return object DGNOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dgnObject is DGNOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
      !this.main.setDgnObject( !dgnObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DGNOUT )

------------------------------------------------------------------------
--
-- Method:      choices
--
-- Description:  toggles to inactivate switch choices
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Choice
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .choices(!switch is STRING)

  if (!switch.upcase() eq 'LOG') then
    !this.logFileName.active = !this.logFile.val.boolean()
  elseif (!switch.upcase() eq 'REGRESSION') then
    !this.regressionFileName.active = !this.regressionFile.val.boolean()
  endif

endmethod
-- End of method definition for .choices()
