--
--
-- Description:
-- form to allow the administrator to change dgn config settings and to save to file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  as()                             -                   Save As specified file name
--  checkSaved()                     -                   Check that changes have been saved and save if necessary
--  checkSeed()                      -                   Check Seed Filename
--  childFormAccess()                -                   Controls access to  Child forms
--  close()                          -                   Close form
--  dgnAset()                        -                   Constructor
--  from()                           -
--  getDgnObject()                   DGNOUT              Returns DGNOUT object
--  init()                           -
--  load(FILE)                       -                   Load from given file
--  save(FILE)                       -                   Save given settings to a file
--  seedFileOption(STRING)           -                   Reset or switch seed file off
--  setDgnObject(DGNOUT)             -
--  setFile(FILE)                    -                   Set Filename
--  setLocalGadgets()                -                   Initialises Gadgets on Form
--  setModified()                    -                   Set Modified flag
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnAset

-- Define form
setup form !!dgnAset
Import 'pmlfilebrowser'
handle any
endhandle

  !!dgnAset.formTitle     = 'DGN Configuration Settings - Administrator'
  !!dgnAset.iconTitle     = 'Administrator'
  !!dgnAset.callback      = '!!dgnAset.init()'
  !!dgnAset.formRevision  = ' $Revision: 1.2 $ '

  -- Modified flag
  member .modified is BOOLEAN

  -- local form Configdata store
  member .data is DGNOUT
  member .children is ARRAY
  member .seedMember is STRING
  member .unitsOriginal is STRING
  -- Body of form definition

  bar
  exit

  path down

  text   .description   at x2 'Description ' tagwidth 9 width 32 string

  para .dirP  at x3 text 'Directory :' width 7
  para .fileP at x6.4 text 'File :' width 4

  para .directory at x11 ymin.dirP width 32 lines 1
  para .file  width 34 lines 1

  text   .seedFileName 'Seed File Name' tagwidth 11 at x0 ymax+0.2 width 32 string
  path down
  frame .settings ' Settings ' at x6 ymax+0.2 width 30

    button .general  ' General...  '
    button .mapping  ' Mapping...  '
    button .level    ' Levels...   '
    button .group    ' Grouping... '
    button .advanced ' Advanced... '

    para   .userAccess at xmax_general+3 ymin_general-1 text ' User Access ' width 9
    toggle .userGeneral  '' at xmax_general+7 ymin_general
    toggle .userMapping  '' at ymin_mapping
    toggle .userLeveling '' at ymin_level
    toggle .userGrouping '' at ymin_group
    toggle .userAdvanced '' at ymin_advanced
  exit

exit

-- End of form definition for !!dgnAset
------------------------------------------------------------------------
--
-- Method:      !dgnAset()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnAset()

  -- build menu bar
  !this.bar.add( 'Control', 'ControlMenu' )
  !this.bar.add( 'File', 'FileMenu' )

  !this.newMenu('ControlMenu')
  !this.controlMenu.add('callback', 'Close', |!!dgnAset.close()| )

  !this.newMenu('FileMenu')
  !this.fileMenu.add('callback', 'Save', |!!dgnAset.save( !!file( $
            !!dgnAset.directory.val + '/' + !!dgnAset.file.val + '.pmldat') )| )
  !this.fileMenu.add('callback', 'Save As...',  '!!dgnAset.as()')
  !this.fileMenu.add('separator')
  !this.fileMenu.add('callback', 'Load', |!!dgnAset.load( !!file( $
            !!dgnAset.directory.val + '/' + !!dgnAset.file.val + '.pmldat') )| )
  !this.fileMenu.add('callback', 'Load from...', '!!dgnAset.from()' )

  -- define callbacks
  !this.seedFileName.callback   = '!!dgnAset.checkSeed()'  $* Validate name
  !this.description.callback    = '!!dgnAset.setModified()'
  !this.cancelCall              = '!!dgnAset.close()'

  !this.general.callback      = |show !!dgnGSet|
  !this.mapping.callback      = |show !!dgnMSet|
  !this.group.callback        = |Show !!dgnGrSet|
  !this.level.callback        = |Show !!dgnLSet|
  !this.advanced.callback     = |Show !!dgnAdvSet|
  -- !this.access.callback       = |Show !!dgnAccSet|

  -- define tooltip
  !this.general.setToolTip('Show General Configurations')
  !this.mapping.setToolTip('Show Mapping Configurations')
  !this.level.setToolTip('Show Levels Configurations')
  !this.group.setToolTip('Show Grouping Configurations')
  !this.advanced.setToolTip('Show Advanced Configurations')
  !this.userGeneral.setToolTip('Allow user modification of General Configurations')
  !this.userMapping.setToolTip('Allow user modification of Mapping Configurations')
  !this.userLeveling.setToolTip('Allow user modification of Levels Configurations')
  !this.userGrouping.setToolTip('Allow user modification of Grouping Configurations')
  !this.userAdvanced.setToolTip('Allow user modification of Advanced Configurations')

  -- Pop up menus
  !menu = !this.newMenu('seedFileMenu')
  !menu.clear()
  !menu.add('callback', |Default File|, '!this.seedFileOption(|DEFAULT|)')
  !menu.add('callback', |Reset|, '!this.seedFileOption(|RESET|)')
  !menu.add('callback', |OFF|,   '!this.seedFileOption(|OFF|)')
  !menu.add('callback', |Browse...|, |!!fileBrowser('%PDMSUSER%', '', 'Seed File', false, '!!dgnAset.seedFileName.val = !!fileBrowser.file.name()')|)
  !this.seedFileName.setPopup(!this.seedFileMenu)

endmethod
-- End of method definition for .dgnAset()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !!dgnUSet.hide()
  handle (2,751)
  -- Form not defined
  endhandle

  !this.modified = FALSE

  -- Initialise Config.file gadgets
  !fileObject = !!file('%PDMSUSER%/dra-dgn-myconfig.pmldat')

  if( !fileObject.exists() ) then
    !this.load( !fileObject )

  else
    -- File does not exist - Initialise settings
    !this.setFile( !fileObject )

    !this.data.default()
    !this.description.val = |Configuration settings|

    -- Record the units setting to assist in resetting
    !this.unitsOriginal = !this.data.units()

    -- Allow all settings to be modifiable
    !this.data.userGeneral( TRUE )
    !this.data.userMapping( TRUE )
    !this.data.userGrouping( TRUE )
    !this.data.userLeveling( TRUE )
    !this.data.userAdvanced( TRUE )

    !this.setLocalGadgets()
  endif

  !this.userGeneral.val  = !this.data.userGeneral()
  !this.userMapping.val  = !this.data.userMapping()
  !this.userGrouping.val = !this.data.userGrouping()
  !this.userLeveling.val = !this.data.userLeveling()
  !this.userAdvanced.val = !this.data.userAdvanced()

  -- Record the seed file setting to assist in resetting
  !this.seedMember = !this.data.seedFileName()

  -- Access to Child forms
  -- Update data on Shown Child forms
  !this.children = ARRAY()

  !this.modified = FALSE

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  !this.checkSaved()
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      setModified
--
-- Description:  Set Modified flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setModified()

  !this.modified = TRUE

endmethod
-- End of method definition for .setModified()

------------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load from given file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .load(!fileObject is FILE)

  -- Verify that changes have been saved if required
  !this.checkSaved()

  !this.setFile( !fileObject )

  !this.data.load( !fileObject )

  !this.setLocalGadgets()

  !this.childFormAccess()

  -- Record the units setting to assist in resetting
  !this.unitsOriginal = !this.data.units()

  -- Ensure Modified flag unset
  !this.modified = FALSE

endmethod
-- End of method definition for .load(FILE)
-------------------------------------------------------------------
--
-- Method:      from
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .from()

  -- Verify that changes have been saved if required
  !this.checkSaved()

 !filename =  !this.file.val + '.pmldat'
 call !!fileBrowser( !this.directory.val, !filename,  $
                     'Load Config Settings', true,    $
                     '!!dgnAset.load(!!fileBrowser.file) ' )

endmethod
-- End of method definition for .from()

------------------------------------------------------------------------
--
-- Method:      checkSaved
-- Description: Check that changes have been saved and save if necessary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkSaved()

  if( !this.modified ) then
    !string = !!messageFile.messageString( 144, 509 )
    !answer = !!alert.confirm( !string )
    if( !answer.boolean() ) then
      -- Save Data to File
      !fileObject = !!file( !this.directory.val + '/' + $
                            !this.file.val + '.pmldat' )
      !this.save( !fileObject )
    else
      !this.modified = false
    endif
  endif

endmethod
-- End of method definition for .checkSaved()

------------------------------------------------------------------------
--
-- Method:      save
-- Description: Save given settings to a file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE      File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .save(!fileObject is FILE)

  !this.setFile( !fileObject )

  -- Add data from Form
  !this.data.name( !this.file.val )

  !session = CURRENT SESSION
  !this.data.createdBy( !session.name )
  -- *** COMMAND-LINE SYNTAX
  var !date CLOCK DATE
  !this.data.createdDate( !date )

  !this.data.description( !this.description.val )
  !this.data.seedFileName( !this.seedFileName.val )

  !this.data.function( 'General Configuration' )

  !this.data.userGeneral( !this.userGeneral.val )
  !this.data.userMapping( !this.userMapping.val )
  !this.data.userLeveling( !this.userLeveling.val )
  !this.data.userGrouping( !this.userGrouping.val )
  !this.data.userAdvanced( !this.userAdvanced.val )

  !this.data.save( !fileObject )

  -- Unset Modified flag
  !this.modified = FALSE

endmethod
-- End of method definition for .save(FILE)
------------------------------------------------------------------------
--
-- Method:      as
--
-- Description: Save As specified file name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .as()

 Using Namespace 'Aveva.Pdms.Presentation'
 !browser = object PMLFILEBROWSER('save')

 !filename = !this.file.val + '.pmldat'
 !browser.show(!this.directory.val, !filename, 'Save Config Settings', false, 'PMLDAT Files (*.pmldat)|*.pmldat',1)
 !file = !!file(!browser.file())
 if(!file.set()) then
   !!dgnAset.save(!!file(!browser.file()))
 endif

endmethod
-- End of method definition for .as()

------------------------------------------------------------------------
--
-- Method:      setFile
--
-- Description: Set Filename
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE      File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setFile(!fileObject is FILE)

  !entry = !fileObject.entry()
  !path  = !fileObject.pathName()

  !this.directory.val   = !path

  !string = !entry.before( '.pmldat' )
  if( !string.length() gt 0 ) then
    !this.file.val = !string
  else
    !this.file.val = !entry
  endif

  -- !this.checkFile()
  !filename = !this.file.val
  if( !filename.match( 'dra-dgn-' ) ne 1 ) then
    -- Warning 'Filename should start with dra-dgn-' )
    !!alert.warning('Configuration file should start with dra-dgn-')
  endif

endmethod
-- End of method definition for .setFile(FILE)

------------------------------------------------------------------------
--
-- Method:      checkSeed
--
-- Description: Check Seed Filename
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkSeed()

  -- Ignore if the value is 'OFF'
  if (!this.seedFileName.val.trim().upcase() eq 'OFF') then
    return
  endif

  !filename = !this.seedFileName.val
  if( !filename.match('.dgn') ne (!filename.length() - 3) ) then
    -- Warning 'Seed FileName does not end in .dgn'
    --!!messageFile.warning( 144, 504 )
    !!alert.warning('Seed File does not end in .dgn')
  endif

  !fileObject = !!file( !filename )
  if( not !fileObject.exists() ) then
    -- Error 'File does not exist'
    !!messageFile.error( 146, 9, !fileObject.name() )
    return error
  endif

  !this.modified = TRUE

endmethod
-- End of method definition for .checkSeed()
------------------------------------------------------------------------
--
-- Method:      setLocalGadgets
--
-- Description: Initialises Gadgets on Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLocalGadgets()

  !this.seedFileName.val = !this.data.seedFileName()
  -- !this.outputFileName.val = !this.data.outputFileName()

  !this.description.val = !this.data.description()

  !this.userGeneral.val      = !this.data.userGeneral()
  !this.userMapping.val      = !this.data.userMapping()
  !this.userGrouping.val     = !this.data.userGrouping()
  !this.userLeveling.val     = !this.data.userLeveling()
  !this.userAdvanced.val     = !this.data.userAdvanced()

  -- !this.modified = TRUE
endmethod
-- End of method definition for .setLocalGadgets()

------------------------------------------------------------------------
--
-- Method:      getDgnObject
--
-- Description: Returns DGNOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDgnObject() is DGNOUT
  return !this.data

endmethod
-- End of method definition for .getDgnObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setDgnObject
--
-- Description: Sets DGNOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDgnObject( !dgnObject is DGNOUT )

  !this.data = !dgnObject

  -- Form data has been modified
  !this.modified = TRUE

endmethod
-- End of method definition for .setDgnObject( DGNOUT )

------------------------------------------------------------------------
--
-- Method:      childFormAccess
--
-- Description:  Controls access to  Child forms
--               Initialise child-forms by passing in DGN object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .childFormAccess()

  -- Other child forms are always accessible to the administrator

  -- Hide shown Child forms which are now longer accessible
  -- Re-initialise any forms which are still shown
  do !form values !this.children
    if( !form.shown() ) then
      !showFlag = TRUE

      -- Check that Administrator still has access to this form
      if( !form.name() eq 'DGNGRSET' ) then
        !showFlag = !this.group.active

        -- Hide form if not accessible
        if( not !showFlag ) then
          !form.hide()
          -- Remove form from array
          !index = !this.children.findFirst( !form )
          !this.children.deleteFrom( !index, 1 )
        endif
      endif

      if( !showFlag ) then
        -- Re-initialise Child form
        !form.init()
      endif

    else
        -- Hidden form - Remove form from array
        !index = !this.children.findFirst( !form )
        !this.children.deleteFrom( !index, 1 )
    endif
  enddo
  !this.children.compress()

endmethod
-- End of method definition for .childFormAccess()
------------------------------------------------------------------------
--
-- Method:      seedFileOption
--
-- Description:
--   Reset or switch seed file off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .seedFileOption(!option is STRING)

  if (!option eq 'OFF') then
    !this.seedFileName.val = 'OFF'
  elseif (!option eq 'RESET') then
    !this.seedFileName.val = !this.seedMember
  elseif (!option eq 'DEFAULT') then
    !this.seedFileName.val = '%PDMSEXE%/DGNDATA/pdmsSeed2d.dgn'
  endif

  !this.checkSeed()

endmethod
-- End of method definition for .seedFileOption()
