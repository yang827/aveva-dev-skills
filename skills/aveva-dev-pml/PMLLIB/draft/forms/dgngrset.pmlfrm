-- Created:         Fri Feb 16 10:16:33 2001
--
--
-- Description:
-- form to allow user to change dgn group config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  checkRule(STRING)                -                   Validate Group,With,Include syntax (element types)
--  clearRules(STRING)               -                   Clear and reset rules gadget
--  constructRule()                  STRING              Construct Rule text from Group,With,Include gadget text
--  copy()                           -                   Copy rule from Rules list gadget,
--  copyRule()                       -                   Update Group, With and Include gadgets with current selection
--  cut()                            -                   Cut rule from Rules list gadget,
--  dgnGrSet()                       -                   Constructor
--  getOwnerObject()                 DGNOUT              Get Owner's DGN Object
--  init()                           -
--  insert()                         -                   Insert rule in Rules gadget,
--  ok()                             -
--  replace()                        -                   Replace rule in Rules gadget,
--  setOwnerObject(DGNOUT)           -
--
------------------------------------------------------------------------
--

-- Kill existing form definition
kill !!dgnGrSet

-- Define form
setup form !!dgnGrSet

  !!dgnGrSet.formTitle     = 'DGN - Grouping'
  !!dgnGrSet.iconTitle     = 'Grouping'
  !!dgnGrSet.callback      = '!!dgnGrSet.init()'
  !!dgnGrSet.formRevision  = ' $Revision: 1.2 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .anno 'Draft Elements' width52
    toggle .groupFill  'Hatch/Fill ' at x1 ymax states 'OFF' 'ON'
    toggle .groupSymb  'Symbols '    at xmax+2 ymin states 'OFF' 'ON'
    toggle .groupFrame 'Frames '     at xmax+2 ymin states 'OFF' 'ON'
  exit

  frame .groupRules 'Group Rules' at x0 ymax+0.5 width 52
    path down
    frame .bwi ''
      text   .group   'Group   ' width 44 string
      text   .with    'With    ' width 44 string
      text   .include 'Include ' width 44 string
    exit

    -- frame .Edit ''
      button .cut     ' Cut  '
      path right
      hdist 2
      button .copy    ' Copy '
      button .replace 'Replace'
      button .insert  'Insert'
      hdist 0
      option .insertOpt width 6
    -- exit

    path down
    frame .fRules '' at x1 ymax
      list   .rules  width 52 length 6
    exit
  exit

  button .ok      ' OK '   at x0 ymax+0.5 OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

  -- Form Members
  member .initialRules is ARRAY
  member .latestRules  is ARRAY

exit
-- End of form definition for !!dgnGrSet

------------------------------------------------------------------------
--
-- Method:      !dgnGrSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnGrSet()

  -- Define Option/List data
  !options = ARRAY()
  !options[1] = 'After'
  !options[2] = 'Before'
  !this.insertOpt.dText = !options

  -- define callbacks
  !this.cut.callback              = '!!dgnGrSet.cut()'
  !this.copy.callback             = '!!dgnGrSet.copy()'
  !this.replace.callback          = '!!dgnGrSet.replace()'
  !this.insert.callback           = '!!dgnGrSet.insert()'
  !this.group.callback            = '!!dgnGrSet.checkRule(|Group|)'
  !this.with.callback             = '!!dgnGrSet.checkRule(|With|)'
  !this.include.callback          = '!!dgnGrSet.checkRule(|Include|)'
  !this.ok.callback               = '!!dgnGrSet.ok()'
  !this.cancel.callback           = '!!dgnGrSet.cancel()'
  !this.cancelCall                = '!!dgnGrSet.cancel()'

  -- define tooltip

  !this.groupFill.setToolTip('Group PDMS Hatchings')
  !this.groupSymb.setToolTip('Group PDMS Symbols')
  !this.groupFrame.setToolTip('Group PDMS View Frames')

  !this.group.setToolTip('PDMS Draft/Design Elements e.g. ALL (LAYE NOTE OLAY ZONE STRU EQUI) or (/Name )')
  !this.with.setToolTip(|PDMS expression e.g.(PURP eq 'HVAC')|)
  !this.include.setToolTip('PDMS Attributes e.g. NAME DESC SPREF')

  !this.cut.setToolTip('Remove the line from the panel below')
  !this.copy.setToolTip('Copy the line from the panel below to the field above')
  !this.replace.setToolTip('Replace the highlighted line with the data from the above fields')
  !this.insert.setToolTip('Insert the data from the above fields into the panel below')
  !this.insertOpt.setToolTip('Insert before or after the highlighted line')
  !this.rules.setToolTip('List of Rules')

  -- Pop up menus
  !menu = !this.newMenu('rulesMenu')
  !menu.clear()
  !menu.add('callback', |Clear|,   '!this.clearRules(|CLEAR|)')
  !menu.add('callback', |Reset Initial|,  '!this.clearRules(|INITIAL|)')
  !menu.add('callback', |Reset Latest|,   '!this.clearRules(|LATEST|)')
  !this.rules.setPopup(!this.rulesMenu)

endmethod
-- End of method definition for .dgnGrSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DGNOUT()
    !configData.default()
  endif

  -- Annotation Grouping
  !this.groupSymb.val        = !configData.groupSymb()
  !this.groupFill.val        = !configData.groupFill()
  !this.groupFrame.val       = !configData.groupFrame()

  -- Need to populate Rules list
  !dText = ARRAY()
  do !rule values !configData.groupRules()
    !dText.append( !rule )
  enddo
  !this.rules.dText = !dText
  !this.initialRules = !this.rules.dText
  !this.latestRules  = !this.rules.dText

  -- Need to initialise Group, With, Include
  !this.copyRule()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    -- Annotation Grouping
    !configData.groupSymb( !this.groupSymb.val )
    !configData.groupFill( !this.groupFill.val )
    !configData.groupFrame( !this.groupFrame.val )

    --  Set up group rules
    !configData.groupRules = !this.rules.dText

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      cut
--
-- Description:  Cut rule from Rules list gadget,
--               apply to Group,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cut()
  !pos = !this.rules.val
  !dText = !this.rules.dText

  if( !pos gt 0 ) then

    -- Update Group,With,Include gadgets before cutting selected line
    !this.copyRule()

    -- Cut selected line
    !rule = !dText.remove( !pos )
    !pos = Min( !dText.size(), !pos )

    !this.rules.dText = !dText
    if( !pos gt 0 ) then
      !this.rules.val   = !pos
    endif
    !this.latestRules = !this.rules.dText

  endif

endmethod
-- End of method definition for .cut()

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description:  Copy rule from Rules list gadget,
--               apply to Group,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .copy()
    -- Update Group,With,Include gadgets
    !this.copyRule()

endmethod
-- End of method definition for .copy()

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description:  Replace rule in Rules gadget,
--               applying Group,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replace()
  !rule = !this.constructRule()

  !pos = Max( !this.rules.val, 1 )
  !dText = !this.rules.dText

  -- Replace rule in list gadget by rule constructed from gadgets
  !dText[!pos] = !rule

  !this.rules.dText = !dText
  !this.rules.val   = !pos
  !this.latestRules = !this.rules.dText

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      insert
--
-- Description:  Insert rule in Rules gadget,
--               applying Group,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .insert()
  !rule = !this.constructRule()

  !pos = !this.rules.val
  !dText = !this.rules.dText

  -- Replace rule in list gadget by rule constructed from gadgets
  !selection = !this.insertOpt.selection()
  if( !selection eq 'After' ) then
    !pos = !pos + 1
  endif
  !pos = Max( !pos, 1 )
  !dText.insert( !pos, !rule )

  !this.rules.dText = !dText
  !this.rules.val   = !pos
  !this.latestRules = !this.rules.dText

endmethod
-- End of method definition for .insert()

------------------------------------------------------------------------
--
-- Method:      copyRule
--
-- Description:  Update Group, With and Include gadgets with current selection
--               **** Do we want this to be automatic callback!! ***
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .copyRule()
  -- Find Index for each component of String
  !string = !this.rules.selection()
  !uString = !string.upcase()

  !withIndex = !uString.match( 'WITH' )
  !commaIndex = !uString.match( ',' )

  if( !commaIndex eq 0 ) then
    !commaIndex = !uString.length() + 1
  endif
  !incIndex = !uString.match( 'INCLUDE' )
  if( !incIndex gt 0 ) then
    !this.include.val = !string.subString( !incIndex + 8 ).trim()
  else
    !this.include.val = ''
  endif

  -- What is the position of the last ','
  !lastCom = !uString.split(',')
  !count = 0
  do !i indices !lastCom
    skip if (!i eq !lastCom.size())
    !count = !count + !lastCom[!i].length() + 1
  enddo
  !commaIndex = !count

  if( !withIndex gt 0 ) then
    !length = !commaIndex - (!withIndex + 5)
    !this.with.val = !string.subString( !withIndex + 5, !length ).trim()
  else
    !this.with.val = ''
    !withIndex = !commaIndex
  endif

  if( !withIndex gt 0 ) then
    !this.group.val = !string.subString( 1, !withIndex - 1 ).trim()
  else
    !this.group.val = !string.trim()
  endif
  if( !this.group.val eq '' ) then
    !this.group.val = 'ALL'
  endif

endmethod
-- End of method definition for .copyRule()

------------------------------------------------------------------------
--
-- Method:      checkRule
--
-- Description:  Validate Group,With,Include syntax (element types)
--               eg ALL (noun noun noun ...)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-- *** COMMAND-LINE SYNTAX
--
------------------------------------------------------------------------

-- Define method
define method .checkRule(!dummyGadgetName is STRING)
  !rule = 'GROUP ' + !this.constructRule()

  -- Use a junk DLICON to validate syntax
  DLICON /__dgn_check_rule_
  $!rule
  handle any
    EXIT
    -- Error - !!error.text in !gadgetName syntax
    !errorText = !!error.text.after(') ')
    !!messageFile.warning( 144, 505, !errorText, 'Group, With or Include' )
    return
  endhandle
  EXIT

endmethod
-- End of method definition for .checkRule(STRING)

------------------------------------------------------------------------
--
-- Method:      constructRule
--
-- Description:  Construct Rule text from Group,With,Include gadget text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .constructRule() is STRING

  !rule = !this.group.val
  if( !this.with.val ne '' ) then
     !rule = !rule + ' WITH '     + !this.with.val
   endif
   if( !this.include.val ne '' ) then
     !rule = !rule +  ' , INCLUDE ' + !this.include.val
   endif
   return !rule

endmethod
-- End of method definition for .constructRule() STRING

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DGNOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
      return !this.main.getDgnObject()
  else
      return object DGNOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dgnObject is DGNOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
      !this.main.setDgnObject( !dgnObject )
  endif


endmethod
-- End of method definition for .setOwnerObject( DGNOUT )
------------------------------------------------------------------------
--
-- Method:      clearRules
--
-- Description:
--   Clear and reset rules gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearRules(!option is STRING)

  if (!option eq 'CLEAR') then
    !this.latestRules = !this.rules.dText
    !this.rules.clear()
  elseif (!option eq 'INITIAL') then
    !this.rules.dText =!this.initialRules
  elseif (!option eq 'LATEST') then
    !this.rules.dText =!this.latestRules
  endif

endmethod
-- End of method definition for .clearRules()
