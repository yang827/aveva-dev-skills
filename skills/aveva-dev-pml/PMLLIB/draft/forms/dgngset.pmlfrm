-- Created:         Fri Feb 16 10:16:33 2001
--
--
-- Description:
-- form to allow user to change general dgn config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  dgnGSet()                        -                   Constructor
--  getOwnerObject()                 DGNOUT              Get Owner's DGN Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DGNOUT)           -
--  unitsOption(STRING)              -                   Example input for Units gadget
--  validMarkerSize(GADGET,STRING)   -                   Validate input to gadgets
--  validName(GADGET,STRING)         -                   Validate input to gadgets
--  validNumber(GADGET,STRING)       -                   Validate input to gadgets
--  validPositiveNumber(GADGET,STRING) -                   Validate input to gadgets
--  validUnits()                     STRING              Validate input to gadgets
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnGSet

-- Define form
setup form !!dgnGSet

  !!dgnGSet.formTitle     = 'DGN - General'
  !!dgnGSet.iconTitle     = 'General'
  !!dgnGSet.callback      = '!!dgnGSet.init()'
  !!dgnGSet.formRevision  = ' $Revision: 1.3 $ '

  -- Name of Owning form
  member .main is FORM
  -- Other form Members
  member .unitsMember      is STRING
  member .unitsOriginal    is STRING
  member .unitsInitialised is STRING
  member .error            is BOOLEAN

  -- Body of form definition

  path down
  vdist 0.2

  frame .general ' General Settings ' anchor RIGHT
    text   .scaleFactor  'Scale Factor' tagwidth 16 width 8 is REAL
    text   .shiftX       'X Shift in Master Units' tagwidth 16 width 8 is REAL
    text   .shiftY       'Y Shift in Master Units' tagwidth 16 width 8 is REAL
    toggle .excludeBack  'Exclude Backing Sheet' states 'OFF' 'ON'
    toggle .excludeOver  'Exclude Overlay Sheets' states 'OFF' 'ON'
    toggle .excludeSheetFrame 'Exclude Sheet Frame' states 'OFF' 'ON'
    text   .markerSize   'Marker Size(mm)' tagwidth 16 width 8 is REAL
  exit
  frame .unitsFrame ' Units '
    text   .unitMasterName 'Master DGN Unit Name' tagwidth 16 width 3 is STRING
    option .umnOptions at xmax+0.2 ymin-0.05 $
      callback '!this.unitsOption(!this.umnOptions.Selection())' width 2.9
    text   .unitSubName    'DGN Sub Unit Name' tagwidth 16 at xmin.unitMasterName width 3 is STRING
    text   .unitSize       'Master Unit in millimetres' tagwidth 20 at ymax+0.6 width 5 is REAL
    text   .unitSubMaster  'Sub Units per Master Unit' tagwidth 20 width 5 is REAL
    text   .unitSubSub     'Number of units per Sub Unit' tagwidth 20 width 5 is REAL
  exit

  button .ok      'OK'     at x0 ymax+0.5         width 6
  button .cancel  'Cancel' at xmax Form-size ymin width 6 CANCEL

exit
-- End of form definition for !!dgnGSet

------------------------------------------------------------------------
--
-- Method:      !dgnGSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnGSet()

  -- Initialise variables
  !this.error = false

  -- define callbacks
  !this.ok.callback     = '!this.ok()'
  !this.cancelCall      = '!this.cancel()'

  -- define tooltips
  !this.scaleFactor.setToolTip('Scale Factor applied to the entire DGN file')
  !this.shiftX.setToolTip('Horizontal Shift in Master Units applied to the entire DGN file')
  !this.shiftY.setToolTip('Vertical Shift in Master Units applied to the entire DGN file')
  !this.markerSize.setToolTip('Size of a scale 1 marker in millimetres')
  !this.excludeBack.setToolTip('Exclude Backing Sheet from DGN transfer')
  !this.excludeOver.setToolTip('Exclude Overlay Sheets from DGN transfer')
  !this.excludeSheetFrame.setToolTip('Exclude Sheet Frame from DGN transfer')

  !this.unitSize.setToolTip('Size of DGN Master Unit in millimetres')
  !this.unitMasterName.setToolTip('Master Unit Name')
  !this.unitSubName.setToolTip('Sub Unit Name')
  !this.unitSubMaster.setToolTip('Number of Sub Units per Master Unit')
  !this.unitSubSub.setToolTip('Number of units of resolution per Sub Unit')

  -- unit Master Name options
  !opt[1] = ''
  !opt[2] = 'Metric example'
  !opt[3] = 'Imperial example'
  !opt[4] = 'Reset to Original'
  !opt[5] = 'Reset to Initialised'
  !this.umnOptions.Dtext = !opt
  !opt2[1] = ''
  !opt2[2] = 'METRIC'
  !opt2[3] = 'IMPERIAL'
  !opt2[4] = 'ORIGINAL'
  !opt2[5] = 'INITIALISED'
  !this.umnOptions.Rtext = !opt2

  -- Validation calls
  !this.unitMasterName.validateCall = '!this.validName('
  !this.unitSubName.validateCall    = '!this.validName('
  !this.scaleFactor.validateCall    = '!this.validPositiveNumber('
  !this.shiftX.validateCall         = '!this.validNumber('
  !this.shiftY.validateCall         = '!this.validNumber('
  !this.unitSize.validateCall       = '!this.validNumber('
  !this.unitSubMaster.validateCall  = '!this.validNumber('
  !this.unitSubSub.validateCall     = '!this.validNumber('
  !this.markerSize.validateCall     = '!this.validMarkerSize('

endmethod
-- End of method definition for .dgnGSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DGNOUT()
    !configData.default()
  endif

  -- Set the members to the actual config value
  !this.unitsMember      = !configData.units()
  if( !this.main.name() eq 'DGNUSET' ) then
    !this.unitsOriginal  = !this.main.main.getDgnObject().units()
  elseif( !this.main.name() eq 'DGNASET' ) then
    !this.unitsOriginal = !this.main.unitsOriginal
  else
    !this.unitsOriginal  = !this.unitsMember
  endif
  !this.unitsInitialised = !this.unitsMember
  !this.scaleFactor.val  = !configData.scaleFactor()
  !this.shiftX.val       = !configData.shiftX()
  !this.shiftY.val       = !configData.shiftY()
  !this.markerSize.val   = !configData.markerSize()
  !this.excludeBack.val  = !configData.excludeBack()
  !this.excludeOver.val  = !configData.excludeOver()
  !this.excludeSheetFrame.val = !configData.excludeSheetFrame()

  -- build an array of the object strings breaking on the ','
  if (!this.unitsMember.set()) then
    !units = ARRAY()
    !units = !this.unitsMember.split(',')
    do !value values !units
      if (!value.match(|MASTMM:|).eq(1)) then
        !this.unitSize.val = !value.after(|MASTMM:|).real()
      elseif (!value.match(|MASTNAME:|).eq(1)) then
        !this.unitMasterName.val = !value.after(|MASTNAME:|)
      elseif (!value.match(|SUBNAME:|).eq(1)) then
        !this.unitSubName.val = !value.after(|SUBNAME:|)
      elseif (!value.match(|SU:|).eq(1)) then
        !this.unitSubMaster.val = !value.after(|SU:|).real()
      elseif (!value.match(|PU:|).eq(1)) then
        !this.unitSubSub.val = !value.after(|PU:|).real()
      endif
    enddo
  endif

  --!this.umnOptions.val = 1
  -- Grey out units if necessary
  !this.unitsOption(|SEEDFILE|)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    !configData.excludeBack( !this.excludeBack.val )
    !configData.excludeOver( !this.excludeOver.val )
    !configData.excludeSheetFrame( !this.excludeSheetFrame.val )
    !configData.scaleFactor( !this.scaleFactor.val )
    !configData.shiftX( !this.shiftX.val )
    !configData.shiftY( !this.shiftY.val )
    !configData.markerSize( !this.markerSize.val )

    !string = !this.validUnits().after(||||).before(||||)
    !configData.units( !string )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  if (!this.error.not()) then
    -- Hide this form (Not done automatically)
    !this.hide()
    -- Remove this form from Parent form's list of shown children
    !this.cancel()
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DGNOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
    return !this.main.getDgnObject()
  else
    return object DGNOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DGN Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dgnObject is DGNOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DGNUSET' or !ownerName eq 'DGNASET' ) then
      !this.main.setDgnObject( !dgnObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DGNOUT )
------------------------------------------------------------------------
--
-- Method:      validUnits
--
-- Description:
--   Validate input to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validUnits() is STRING

  -- Initialise variables
  !this.error = false
  !string = ''

  -- Join the unit values of the text panel
  !string = !string + 'MASTNAME:' + !this.unitMasterName.val
  !string = !string + ',SUBNAME:' + !this.unitSubName.val
  !string = !string + ',MASTMM:'  + !this.unitSize.val.string()
  !string = !string + ',SU:'      + !this.unitSubMaster.val.string()
  !string = !string + ',PU:'      + !this.unitSubSub.val.string()

  if (!string.length().eq(0)) then
    !!alert.error('Invalid input in Units.')
    !this.error = true
  else
    !string = |SWITCH UNITS ||| + !string + ||||
    -- Use a junk DLICON to validate syntax
    DLICON /__dgn_check_
      $!string
      handle any
        EXIT
        !!alert.error('Invalid input in Units.')
        !this.error = true
      endhandle
    EXIT
  endif

  return !string

endmethod
-- End of method definition for .validUnits()

------------------------------------------------------------------------
--
-- Method:      validNumber
--
-- Description:
--   Validate input to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validNumber(!gadget is GADGET, !dummyString is STRING)

  -- !gadget.val is either Unset, or it is a Real number
  if (unset(!gadget.val)) then
    return error 1 'Invalid input. A number expected'
  endif

endmethod
-- End of method definition for .validNumber()

------------------------------------------------------------------------
--
-- Method:      validPositiveNumber
--
-- Description:
--   Validate input to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validPositiveNumber(!gadget is GADGET, !dummyString is STRING)

  -- !gadget.val is either Unset, or it is a Real number
  if (unset(!gadget.val) or !gadget.val.leq(0.0)) then
    return error 1 'Invalid input. Positive number expected'
  endif

endmethod
-- End of method definition for .validPositiveNumber()

------------------------------------------------------------------------
--
-- Method:      validMarkerSize
--
-- Description:
--   Validate input to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validMarkerSize(!gadget is GADGET, !dummyString is STRING)

  -- !gadget.val is either Unset, or it is a Real number
  if (unset(!gadget.val) or !gadget.val.between(0,200).not()) then
    return error 1 'Invalid input. Real Number from 0 to 200 expected'
  endif

endmethod
-- End of method definition for .validMarkerSize()
------------------------------------------------------------------------
--
-- Method:      validName
--
-- Description:
--   Validate input to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validName(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.length().gt(2) ) then
    return error 1 'Invalid input. Maximum name length is 2 characters'
  endif

endmethod
-- End of method definition for .validName()
------------------------------------------------------------------------
--
-- Method:      unitsOption
--
-- Description:
--   Example input for Units gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unitsOption(!option is STRING)

  if (!option eq 'METRIC') then
    !this.unitsMember = |MASTNAME:mm,SUBNAME:mm,SU:1,PU:100,MASTMM:1.0|
  elseif (!option eq 'IMPERIAL') then
    !this.unitsMember = |MASTNAME:',SUBNAME:",SU:12,PU:1024,MASTMM:304.8|
  elseif (!option eq 'ORIGINAL') then
    !this.unitsMember = !this.unitsOriginal
  elseif (!option eq 'INITIALISED') then
    !this.unitsMember = !this.unitsInitialised
  endif

  -- build an array of the object strings breaking on the ','
  if (!this.unitsMember.set()) then
    !units = ARRAY()
    !units = !this.unitsMember.split(',')
    do !value values !units
      if (!value.match(|MASTMM:|).eq(1)) then
        !this.unitSize.val = !value.after(|MASTMM:|).real()
      elseif (!value.match(|MASTNAME:|).eq(1)) then
        !this.unitMasterName.val = !value.after(|MASTNAME:|)
      elseif (!value.match(|SUBNAME:|).eq(1)) then
        !this.unitSubName.val = !value.after(|SUBNAME:|)
      elseif (!value.match(|SU:|).eq(1)) then
        !this.unitSubMaster.val = !value.after(|SU:|).real()
      elseif (!value.match(|PU:|).eq(1)) then
        !this.unitSubSub.val = !value.after(|PU:|).real()
      endif
    enddo
  endif
  !this.umnOptions.ClearSelection()

endmethod
-- End of method definition for .unitsOption()
