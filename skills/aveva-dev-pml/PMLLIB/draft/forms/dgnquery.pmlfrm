--
--
-- Description:
--   form to allow user to query dgn mapping config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dgnQuery()                       -                   Constructor
--  init()                           -
--  search(BOOLEAN)                  -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnQuery

-- Define form
setup form !!dgnQuery

  !!dgnQuery.formTitle     = 'DGN Configuration'
  !!dgnQuery.iconTitle     = 'Config'
  !!dgnQuery.callback      = '!!dgnQuery.init()'
  !!dgnQuery.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition

  path down
  vdist 0.2

  para .nameP  text 'Configuration: '
  para .name   at xmax ymin width 32

  para .descP  at x0 ymax text 'Description:   '
  para .desc   at xmax ymin width 44

  frame .settings 'Settings' at x0 ymax width 60
    text .search 'Search  '  width 32 string
    button .again 'Repeat Search' at xmax+5 ymin

    textpane .query  at x1 ymax+0.2 width 60 length 15
  exit

  button .dismiss  'Dismiss' at xmax Form-size ymax+1 OK

  !!dgnQuery.keyboardFocus = _query

exit
-- End of form definition for !!dgnQuery

------------------------------------------------------------------------
--
-- Method:      !dgnQuery()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnQuery()

  !this.query.setEditable( FALSE )
  !this.keyboardFocus = !this.query

  -- define callbacks
  !this.search.callback = '!!dgnQuery.search(FALSE)'
  !this.again.callback  = '!!dgnQuery.search(TRUE)'
  !this.cancelCall      = ''

endmethod
-- End of method definition for .dgnQuery()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !main = !this.owner()

  !array = ARRAY()
  if( !main.name() eq 'DGNUSER' ) then
    !configData = !main.getDgnObject()

    !array = !configData.querySwitch()
    !array.append( '' )
    !array.appendArray( !configData.queryRules() )
  else
    !configData = object DGNOUT()
  endif

  !this.name.val = !configData.name()
  !this.desc.val = !configData.description()

  !this.query.val = !array

  !pos[1] = 1
  !pos[2] = 1
  !this.query.setCurPos( !pos )

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search for specified string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     TRUE for Repeat search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .search( !repeat is BOOLEAN )

  !this.keyboardFocus = !this.query
  !array = !this.query.val

  !string = !this.search.val
  !string = !string.upcase()

  if( !string.length() eq 0 ) then
    return
  endif

  if( !repeat ) then
    -- Start search from current position in window
    !start = !this.query.curPos()[1]
  else
    !start = 0
  endif

  !size = !array.size()
  !endPos[1] = !size
  !endPos[2] = 1

  !found = FALSE
  do !i indices !array
    -- Modify index if repeating search
    !j = !i + !start
    if( !j gt !size ) then
      !j = !j - !size
    endif

    !char = !array[!j].upcase().match(!string)
    if( !char gt 0 ) then
      !found = TRUE
      !pos[1] = !j
      !pos[2] = !char - 1
      ---- !this.query.setCurPos( !endPos )
      !this.query.setCurPos( !pos )
      break
    endif
  enddo

  if( !found.not() ) then
    !!messageFile.warning( 144, 510 )
  endif

endmethod
-- End of method definition for .search( BOOLEAN )
