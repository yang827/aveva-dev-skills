-- Created:         Fri Feb 16 10:12:16 2001
--
--
-- Description:
-- form to allow user to generate dgn output file using new enhanced dgn output options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  buildConfig()                    -                   Load ConfigData from File to initialise !!dgnUSet.data
--  ce()                             -                   New Current element - build Sheet option gadget
--  checkConfig()                    -                   Check Selected Configuration to see whether user-modifiable
--  checkDir()                       -                   Validation routine for the directory
--  dgnUser()                        -                   Constructor
--  editConfigDesc()                 -                   Edits Config to update Description
--  getDgnObject()                   DGNOUT              Returns DGNOUT object selected in Config gadget
--  init()                           -
--  initFirst()                      -                   First initialisation callback
--  modifiedConfig()                 -                   Edits Config to flag as modified
--  modify()                         -                   Load current ConfigData from File to initialise !!dgnUSet.data
--  queryConfig()                    -                   Show query form for selected configuration
--  readConfig()                     REAL                Get ConfigData DGNOUT object, loading from file if necessary
--  setDgnObject(DGNOUT)             -
--  sheet()                          -                   Generate output File name from Sheet name
--  writeConfig()                    -                   Writes DGN Object to file
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnUser

-- Define form
setup form !!dgnUser

  !!dgnUser.formTitle     = 'Configurable DGN Output'
  !!dgnUser.iconTitle     = 'DGN Output'
  !!dgnUser.formRevision  = ' $Revision: 1.5 $ '

  -- Current selection
  member .index     is REAL
  -- Index into array of ConfigData
  member .listPos   is ARRAY

  -- local ConfigData store
  member .dataArray is ARRAY

  -- Body of form definition

  path down
  vdist 0.2

  button .ce ' CE ' at x0 y0.2
  -- option .sheet 'Sheet ' at xmax+1 ymin width - was 24
  para .desc at xmax+0.5 ymin width 6 lines 1
  option .sheet '' at xmax ymin width 38

  frame .output 'Output file' at x0 ymax+0.2
    text   .directory   'Directory' tagwidth 10 width 41 string
    text   .file        'File' tagwidth 10 width 41 string
    para   .verPara text 'DGN version' width 9
    path right
    rtoggle .ver7       'DGN ver. 7' tagwidth 7
    rtoggle .ver8       'DGN ver. 8'
    path down
  exit

  frame .frame  'Configuration' at x0 ymax+0.2
    list  .config '' at x1 y1  width 50 height 10

    path right
    hdist 2
    button .query  'Query...'  at xmin ymax
    button .modify 'Modify...'
    button .buildConfig 'Re-build' at xmax_config - 9 ymin
  exit

  button .apply   'Apply' at x0 ymax_frame+1     APPLY
  button .dismiss 'Dismiss' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dgnUser

------------------------------------------------------------------------
--
-- Method:      !dgnUser()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnUser()

  -- define callbacks
  !this.config.callback      = '!!dgnUser.checkConfig()'
  !this.initCall             = '!!dgnUser.init()'
  !this.firstShownCall       = '!!dgnUser.initFirst()'
  !this.modify.callback      = '!!dgnUser.modify()'
  !this.query.callback       = '!!dgnUser.queryConfig()'
  !this.buildConfig.callback = '!!dgnUser.buildConfig()'
  !this.ce.callback          = '!!dgnUser.ce()'
  !this.sheet.callback       = '!!dgnUser.sheet()'
  !this.apply.callback       = '!!dgnUser.apply()'
  !this.directory.validateCall = '!this.checkDir()'
  !this.cancelCall           = ''

endmethod
-- End of method definition for .dgnUser()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.directory.val      = |%PDMSUSER%|
  -- Derive Filename from Sheet name
  !this.file.val           = |my.dgn|

  -- Populate Sheet gadget
  !this.ce()
  --!this.sheet()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      initFirst
--
-- Description: First initialisation callback
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .initFirst()
  !this.buildConfig()
  -- DGN version 8 by default (changed 9 Mar 20 by RAB - was DGN 7)
  !this.output.val = 2
endmethod
-- End of method definition for .initFirst()

------------------------------------------------------------------------
--
-- Method:      checkDir
--
-- Description: Validation routine for the directory
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .checkDir()
  !dir = !this.directory.val.trim()
  if( !dir.empty() ) then
    return error 1 'Empty directory name!'
  endif
  !f = object FILE(!dir)
  if( not !f.exists() ) then
    return error 1 'Directory $!dir does not exist!'
  elseif( !f.type().neq('DIRECTORY') ) then
    return error 1 'Path $!dir does not represent a directory!'
  endif
endmethod
-- End of method definition for .checkDir()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
--  modified 02/02/00 by GEWJ - fixed to navigate correctly to selected sheet
--                              (PUR35348)
--  modified 14/07/00 by GEWJ - don't lose the user's filename when we navigate
------------------------------------------------------------------------
--
-- Define method
define method .apply()

  -- Save Current DB Position and navigate to Selected Sheet
  !x = REF
  !y = !this.file.val
  !newSheet = !this.sheet.selection()
  $!newSheet
  !this.ce()
-- restore filename
  !this.file.val = !y

  -- Ensure that this configuration has been loaded from File
  !dataIndex = !this.readConfig()
  handle ANY
    !!alert.error('Error in Configuration')
    return
  endhandle

  !configName = !this.dataArray[!dataIndex].name()

  -- Load Configuration into DRAFT
  !this.dataArray[!dataIndex].config()

  !fileName = !this.directory.val.trim() + '/' + !this.file.val.trim()
  !f = object FILE(!fileName)
  if( !f.exists() ) then
    !res = !!alert.confirm('The file $!fileName already exists! Overwrite?')
    !doIt = !res.eq('YES')
  else
    !doIt = true
  endif

  if( !doIt ) then
    if( !this.output.val.eq(1) ) then
      !version = 'DGN7'
    elseif( !this.output.val.eq(2) ) then
      !version = 'DGN8'
    else
      -- just a fallback solution if some new versions are defined
      !version = 'DGNOUT'
    endif
    -- ***** Command-line Syntax *****
    LIEXEC /Draft_DGN_LI '$!version' CONFIGDATA '$!configName' OUTPUTFILENAME '$!fileName'
    handle ANY
      !!alert.error(!!error.text)
    endhandle
  endif

  $!x
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      ce
--
-- Description:  New Current element - build Sheet option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ce()

  !mainElement = LIBY
  handle any
     !mainElement = DRWG
     handle any
       -- we are above a DRWG or LIBY
       !!messageFile.error( 144, 4 )
       return error
     endhandle
  endhandle

  !mainTypes = 'DRWG LIBY'
  if( !mainTypes.match( !!ce.type ) gt 0 ) then
       -- we are at a DRWG or LIBY
       !!messageFile.error( 144, 4 )
       return error
  endif

  -- Find owning Picture element
  !pictureTypes = 'SHEE LALB SYLB BACK OVER ISOLB SHTMPL'
  !!ce = !!dtbGetOwnerType(!!ce, !pictureTypes)

  if( !pictureTypes.match( !!ce.type ) gt 0 ) then
    -- Already at a Picture element
    !picture = !!ce
  endif

  !sheets = !!collectAllFor( !pictureTypes, '', !mainElement )

  -- Build Sheet gadget (option gadget .sheet is 38 chars wide)
  --!dTextEval = object BLOCK('!sheets[!evalIndex].namn')
  --!dTextEval = object BLOCK('cutnmn 38 of $$!sheets[$$!evalIndex]')
  !dTextEval = object BLOCK('!sheets[!evalIndex].cutnmn[38]')
  !dText = !sheets.evaluate(!dTextEval)
  !this.sheet.dText = !dText

  !rTextEval = object BLOCK('!sheets[!evalIndex].name')
  !rText = !sheets.evaluate(!rTextEval)
  !this.sheet.rText = !rText

  if( defined(!picture) ) then
    -- !this.sheet.select( 'dText', !picture.namn )
    !this.sheet.select( 'rText', !picture.name )
    -- callback doesn't seem to be automatic !
    !this.sheet()
  endif

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      sheet
--
-- Description:  Generate output File name from Sheet name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .sheet()

  -- Generate File gadget text from Sheet name
  !name = !this.sheet.selection()
  if( !name.empty() )then
    !this.file.val           = |my.dgn|
    !this.apply.active = TRUE
  else
    !desc = !name.dbref().type
    if( !desc eq 'SHEE' ) then
      !this.desc.val = 'Sheet'
    else
      !this.desc.val = !desc.subString(1,1) + !desc.subString(2).lowcase()
    endif

    --!name = !this.sheet.selection('dText')
    !name = !this.sheet.selection('rText')
    !!ce = !name.dbref()

    -- Re-use of FD check for Draft+ -- note 'ON'/'OFF' are both Draft, Draft+ is 'ONLY' and possibly newer values
    if (!desc eq 'SHEE' or !desc eq 'OVER') then
      if (!name.dbref().acPicture.upcase() eq 'OFF' or !name.dbref().acPicture.upcase() eq 'ON' ) then
        -- OK we can continue
        !this.apply.active = TRUE
      else
        !!alert.error(!name & ' has been modified by AVEVA E3D Draw')
        !this.apply.active = FALSE
      endif
    elseif (!desc eq 'VIEW') then
      -- Special case; a view with an owner converted to Final Designer
      !ownerType = !name.dbref().owner.type
      if (!ownerType eq 'SHEE' or !ownerType eq 'OVER') then
        if ( !name.dbref().owner.acPicture.upcase() eq 'OFF' or !name.dbref().owner.acPicture.upcase() eq 'ON' ) then
          -- OK we can continue
          !this.apply.active = TRUE
        else
          !!alert.error(!name & ' has been modified by AVEVA E3D Draw')
          !this.apply.active = FALSE
        endif
      else
        !this.apply.active = TRUE
      endif
    else
      !this.apply.active = TRUE
    endif

    if( !name.subString(1,1) eq '/' ) then
       !name = !name.subString(2)
    endif
    !name = !name.replace( '/', '.' ) + '.dgn'

    !this.file.val = !name

  endif

endmethod
-- End of method definition for .sheet()

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description:  Load current ConfigData from File to initialise !!dgnUSet.data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .modify()

  -- Establish Configuration
  !dataIndex = !this.readConfig()
  handle ANY
    !!alert.error('Error in Configuration')
    return
  endhandle

  if( not !this.dataArray[!dataIndex].userAccess() ) then
    -- Newly loaded Configuration file is not modifiable
    !this.modify.active = FALSE
    -- Error 'Configuration is not modifiable by Users'
    !!messageFile.error( 144, 501, !this.config.selection() )
    return error
  endif

  -- Config not saved - use Administration>Settings>DGN Config
  !!messageFile.warning( 144, 506, !this.config.selection() )

  show !!dgnUSet
endmethod
-- End of method definition for .modify()

------------------------------------------------------------------------
--
-- Method:      buildConfig
--
-- Description:  Load ConfigData from File to initialise !!dgnUSet.data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--  *** PML1 CODE ***
------------------------------------------------------------------------

-- Define method
define method .buildConfig()
  -- Generate list of File objects
  !fileArray = !!uniquePath( 'dra-dgn-*.pmldat', 'USER PROJ PDMS', '' )

  !dText = ARRAY()
  !rText = ARRAY()
--  --         12345678901234567890123456789012
--  !spaces = '                                '

  !eval = object BLOCK( '!fileArray[!evalIndex].entry().before( |.pmldat| )' )
  !s = !fileArray.evaluate( !eval )
  !width = !s.width() + 3

  -- At least one entry always exists with default settings!
  !this.index = 1
  !this.listPos.clear()
  !this.listPos[1] = 1

  !this.dataArray.clear()
  !this.dataArray[1] = object DGNOUT()
  !this.dataArray[1].default()

  !dText[1] = !this.dataArray[1].name()
  -- !dText[1] = !dText[1] + !spaces.subString( !dText[1].length() + 1 ) + $
  --             !this.dataArray[1].description()
  !description = !this.dataArray[1].description()
  -- *** PML1 CODE ***
  var !a COMPOSE |$!dText[1]| WIDTH $!width |$!description|
  !dText[1] = !a[1]
  !rText[1] = ''

  do !file values !fileArray
    !description = 'not loaded'
    ---- Read Description from file
    ---- !description = !this.dataArray[1].readDescription( !file )
    !name = !file.entry().before( '.pmldat' )
    -- !string = !name + !spaces.subString( !name.length() + 1 ) + $
    --           !description
    -- !dText.append( !string )
    -- *** PML1 CODE ***
    var !a COMPOSE |$!name| WIDTH $!width |$!description|
    !dText.append( !a[1] )
    !rText.append( !file.fullName() )
    !this.listPos.append(0)
  enddo
  !this.config.dText = !dText
  !this.config.rText = !rText

  -- Set MODIFY gadget status
  !this.checkConfig()

endmethod
-- End of method definition for .buildConfig()

------------------------------------------------------------------------
--
-- Method:      checkConfig
--
-- Description:  Check Selected Configuration to see whether user-modifiable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkConfig()

  -- First check that we're not currently Modifying configuration
  if ( defined( !!dgnUSet ) ) then
    if( !!dgnUSet.shown() ) then
      !this.config.val = !this.index
      -- Error - Currently modifying configuration. Retain current selection
      !!messageFile.error( 144, 508 )
      return error
    endif
  endif

  -- !!dgnQuery.hide()
  -- handle (2,751)
  --   -- Form not defined
  -- endhandle

  !this.index = !this.config.val

  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex eq 0 ) then
    -- Config not yet loaded - assume modifiable
    !this.modify.active = TRUE
  else
    !this.modify.active = !this.dataArray[!dataIndex].userAccess()
    handle ANY
      !!alert.error('Error in Configuration')
      return
    endhandle
  endif

endmethod
-- End of method definition for .checkConfig()

------------------------------------------------------------------------
--
-- Method:      queryConfig
--
-- Description:  Show query form for selected configuration
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .queryConfig()

  -- Check that Config is loaded
  !this.readConfig()
  handle ANY
    !!alert.error('Error in Configuration')
    return
  endhandle

  if( defined( !!dgnQuery ) and !!dgnQuery.shown() ) then
    !!dgnQuery.init()
  endif
  -- Still need to show it in order to Raise it if hidden by other forms
  show !!dgnQuery

endmethod
-- End of method definition for .queryConfig()

------------------------------------------------------------------------
--
-- Method:      readConfig
--
-- Description:  Get ConfigData DGNOUT object, loading from file if necessary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .readConfig() is REAL

  -- Find ConfigData selection - is it loaded?
  -- !index = !this.config.val
  !selection = !this.config.selection()

  if( !this.listPos[!this.index] gt 0 ) then
    -- File has been loaded
    !dataIndex = !this.listPos[!this.index]
    !alreadyLoaded = TRUE

  else
    -- Need to load file
    !this.dataArray.append( object DGNOUT() )
    !this.listPos[!this.index] = !this.dataArray.size()

    !dataIndex = !this.listPos[!this.index]
    !configFile = !!file( !selection )
    !this.dataArray[!dataIndex].load( !configFile )
    handle(146,9)
      -- Failed to load file
      !this.listPos[!this.index] = 0
      !this.dataArray.removeLast()
      !this.modify.active = FALSE
      return error
    endhandle

    !alreadyLoaded = FALSE
  endif

  -- Set Active status of Modify button
  !this.modify.active = !this.dataArray[!dataIndex].userAccess()

  if( !alreadyLoaded.not() ) then
    !this.editConfigDesc()
  endif

  -- Return the position of the DGN Object
  return !dataIndex

endmethod
-- End of method definition for .readConfig() REAL

------------------------------------------------------------------------
--
-- Method:      editConfigDesc
--
-- Description: Edits Config to update Description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .editConfigDesc()
  -- Update Description in .config gadget
  !dataIndex = !this.listPos[!this.index]

  -- ?? What if Config Filename doesn't match internal name ?? (should not get)
  !dText = !this.config.dText
  !rText = !this.config.rText

  !a = !dText[!this.index].split()
  !width = !dText[!this.index].match(!a[2]) - 1
  !description = !this.dataArray[!dataIndex].description()
    -- --         12345678901234567890123456789012
    -- !spaces = '                                '
    -- !dText[!this.index] = !a[1] + !spaces.subString( !a[1].length() + 1 ) + $
    --                       !this.dataArray[!dataIndex].description()
  -- *** PML1 CODE ***
  var !aa COMPOSE |$!a[1]| WIDTH $!width |$!description|
  !dText[!this.index] = !aa[1]

  !this.config.dText = !dText
  !this.config.rText = !rText
  !this.config.val   = !this.index
endmethod
-- End of method definition for .editConfigDesc()

------------------------------------------------------------------------
--
-- Method:      modifiedConfig
--
-- Description: Edits Config to flag as modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .modifiedConfig()
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]

  -- Add * to dText in .config gadget to show that it is modified
  !dText = !this.config.dText
  !rText = !this.config.rText

  !a = !dText[!this.index].split()
  !width = !dText[!this.index].match(!a[2]) - 3
  !description = !this.dataArray[!dataIndex].description()

  -- *** PML1 CODE ***
  -- Insert '*' between name and description
  var !aa COMPOSE |$!a[1]| WIDTH $!width |*| WIDTH 2 |$!description|
  !dText[!this.index] = !aa[1]

  !this.config.dText = !dText
  !this.config.rText = !rText
  !this.config.val = !this.index
endmethod
-- End of method definition for .modifiedConfig()

------------------------------------------------------------------------
--
-- Method:      writeConfig
--
-- Description: Writes DGN Object to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .writeConfig()
  -- !index = !this.config.val
  !selection = !this.config.selection()
  if( !selection eq '' ) then
    -- Error 'No Configuration file selected'
    !!messageFile.error( 144, 502 )
     return error
  endif

  -- Only write to file if file in USER area
  -- *** PML1 code ***
  var !evar EVAR PDMSUSER
  !dirName = !selection.before( '/' + !selection.part( -1, '/' ) )

  if( !evar.match( !dirName ) eq 0 ) then
    -- File not saved - use Administration>Settings>DGN Config
    !!messageFile.warning( 144, 506, !selection )
    return
  endif

  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex gt 0 ) then
    !this.dataArray[!dataIndex].save( !!file(!selection) )
  endif
endmethod
-- End of method definition for .writeConfig()

------------------------------------------------------------------------
--
-- Method:      getDgnObject
--
-- Description: Returns DGNOUT object selected in Config gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDgnObject() is DGNOUT
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex eq 0 ) then
    return object DGNOUT()
  else
    return !this.dataArray[!dataIndex]
  endif
endmethod
-- End of method definition for .getDgnObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setDgnObject
--
-- Description: Sets DGNOUT object selected in Config gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDgnObject( !dgnObject is DGNOUT )
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]
  if( !this.dataArray[!dataIndex].userAccess() ) then
    !this.dataArray[!dataIndex] = !dgnObject
  else
    -- Error 'Configuration is not modifiable by Users'
    !!messageFile.error( 144, 501, !this.config.selection() )
     return error
  endif

endmethod
-- End of method definition for .setDgnObject( DGNOUT )
