-- Created:         Fri Feb 16 10:16:33 2001
--
--
-- Description:
-- form to allow user to change dgn configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkSeed()                      -                   Check Seed Filename
--  childFormAccess()                -                   Controls access to other gadgets on form
--  dgnUset()                        -                   Constructor
--  getDgnObject()                   DGNOUT              Returns DGNOUT object
--  init()                           -
--  ok()                             -
--  seedFileOption(STRING)           -                   Reset or switch seed file off
--  setDgnObject(DGNOUT)             -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dgnUset

-- Define form
setup form !!dgnUset
Import 'pmlfilebrowser'
handle any
endhandle

  !!dgnUset.formTitle     = 'DGN Configuration Settings'
  !!dgnUset.iconTitle     = 'DGN Settings'
  !!dgnUset.callback      = '!!dgnUset.init()'
  !!dgnUset.formRevision  = ' $Revision: 1.2 $ '

  -- local form ConfigData store
  member .data is DGNOUT

  member .main is FORM
  member .children is ARRAY

  member .seedMember is STRING

  -- Body of form definition

  path down
  vdist 0.2

  para .configP at x0 y0.2 text   'Configuration : '
  para .config  at xmax ymin width 40 lines 1

  para .descP at x0 ymax+0.2 text 'Description   : '
  para .description  at xmax ymin width 40 lines 1

  text   .seedFileName 'Seed File Name  ' at x0 ymax+0.2 width 32 string

  frame .settings 'Settings' at x1 ymax+0.5

    button .general  ' General...  '   at x+1 y+1
    button .mapping  ' Mapping...  '   at xmin ymax+0.5

    button .level    ' Levels...   '   at xmax_general+4 ymin_general
    button .group    ' Grouping... '   at xmin ymax+0.5

    button .advanced ' Advanced... '   at xmax+4 ymin

  exit

  button .ok      ' OK '   at x0 ymax+1  OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dgnUset

------------------------------------------------------------------------
--
-- Method:      !dgnUset()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dgnUset()

  -- define callbacks
  !this.general.callback      = |show !!dgnGSet|
  !this.mapping.callback      = |show !!dgnMSet|
  !this.group.callback        = |Show !!dgnGrSet|
  !this.level.callback        = |Show !!dgnLSet|
  !this.advanced.callback     = |Show !!dgnAdvSet|
  !this.ok.callback           = '!!dgnUset.ok()'
  !this.cancelCall            = ''
  !this.seedFileName.callback = '!!dgnUset.checkSeed()'  $* Validate name

  -- define tooltip
  !this.general.setToolTip('Modify General Configurations')
  !this.mapping.setToolTip('Modify Mapping Configurations')
  !this.level.setToolTip('Modify Levels Configurations')
  !this.group.setToolTip('Modify Grouping Configurations')
  !this.advanced.setToolTip('Modify Advanced Configurations')

  -- Pop up menus
  !menu = !this.newMenu('seedFileMenu')
  !menu.clear()
  !menu.add('callback', |Default|, '!this.seedFileOption(|DEFAULT|)')
  !menu.add('callback', |Reset|, '!this.seedFileOption(|RESET|)')
  !menu.add('callback', |OFF|,   '!this.seedFileOption(|OFF|)')
  !menu.add('callback', |Browse...|, |!!fileBrowser('%PDMSUSER%', '', 'Seed File', false, '!!dgnUset.seedFileName.val = !!fileBrowser.file.name()')|)

  !this.seedFileName.setPopup(!this.seedFileMenu)

endmethod
-- End of method definition for .dgnUset()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !!dgnASet.hide()
  handle (2,751)
  -- Form not defined
  endhandle

  !this.main = !this.owner()

  if( !this.main.name().match( 'DGNUSER' ) gt 0 ) then
    !this.setDgnObject( !this.main.getDgnObject() )
    if( !this.data.unset() ) then
      -- Error in getting object from Main form
      !this.data.default()
    endif

    !this.config.val      = !this.data.name()
    !this.description.val = !this.data.description()

  else
    !this.data.default()
    !this.config.val = 'unset'
  endif

  !this.seedFileName.val = !this.data.seedFileName()
  !this.seedMember = !this.data.seedFileName()

  -- Access to Child forms
  -- Update data on Shown Child forms
  !this.children = ARRAY()
  !this.childFormAccess()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !this.data.seedFileName( !this.seedFileName.val )

  -- Return data to parent
  if( !this.main.name() eq 'DGNUSER' ) then
    !this.main.setDgnObject( !this.getDgnObject() )

    -- Mark configuration as modified
    !this.main.modifiedConfig()
  endif

endmethod
-- End of method definition for .ok()
------------------------------------------------------------------------
--
-- Method:      getDgnObject
--
-- Description: Returns DGNOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDgnObject() is DGNOUT
  return !this.data

endmethod
-- End of method definition for .getDgnObject() DGNOUT

------------------------------------------------------------------------
--
-- Method:      setDgnObject
--
-- Description: Sets DGNOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDgnObject( !dgnObject is DGNOUT )
  !this.data = !dgnObject

endmethod
-- End of method definition for .setDgnObject( DGNOUT )

------------------------------------------------------------------------
--
-- Method:      childFormAccess
--
-- Description:  Controls access to other gadgets on form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .childFormAccess()

  -- Update Active status for gadgets which access child forms
  !this.general.active  = !this.data.userGeneral()
  !this.mapping.active  = !this.data.userMapping()
  !this.level.active    = !this.data.userLeveling()
  !this.group.active    = !this.data.userGrouping()
  !this.advanced.active = !this.data.userAdvanced()

  -- Hide shown Child forms which are now longer accessible
  -- Re-initialise any forms which are still shown
  do !form values !this.children
    if( !form.shown() ) then
      !showFlag = TRUE

      -- Check that User still has access to this form
      -- (We probably only need to check DGNGRSET here)
      if( !form.name() eq 'DGNGRSET' ) then
        !showFlag = !this.group.active

        -- Hide form if not accessible
        if( not !showFlag ) then
          !form.hide()
          -- Remove form from array
          !index = !this.children.findFirst( !form )
          !this.children.deleteFrom( !index, 1 )
        endif
      endif

      if( !showFlag ) then
        -- Re-initialise Child form
        !form.init()
      endif

     else
      -- Remove Hidden forms
      !index = !this.children.findFirst( !form )
      !this.children.deleteFrom( !index, 1 )
    endif
  enddo
  !this.children.compress()

endmethod
-- End of method definition for .childFormAccess()
------------------------------------------------------------------------
--
-- Method:      seedFileOption
--
-- Description:
--   Reset or switch seed file off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .seedFileOption(!option is STRING)

  if (!option eq 'OFF') then
    !this.seedFileName.val = 'OFF'
  elseif (!option eq 'RESET') then
    !this.seedFileName.val = !this.seedMember
  elseif (!option eq 'DEFAULT') then
    !this.seedFileName.val = '%PDMSEXE%/DGNDATA/pdmsSeed2d.dgn'
  endif

  !this.checkSeed()

endmethod
-- End of method definition for .seedFileOption()

------------------------------------------------------------------------
--
-- Method:      checkSeed
--
-- Description: Check Seed Filename
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkSeed()

  -- Ignore if the value is 'OFF'
  if (!this.seedFileName.val.trim().upcase() eq 'OFF') then
    return
  endif

  !filename = !this.seedFileName.val
  if( !filename.match('.dgn') ne (!filename.length() - 3) ) then
    -- Warning 'Seed FileName does not end in .dgn'
    --!!messageFile.warning( 144, 504 )
    !!alert.warning('Seed File does not end in .dgn')
  endif

  !fileObject = !!file( !filename )
  if( not !fileObject.exists() ) then
    -- Error 'File does not exist'
    !!messageFile.error( 146, 9, !fileObject.name() )
    return error
  endif

endmethod
-- End of method definition for .checkSeed()
