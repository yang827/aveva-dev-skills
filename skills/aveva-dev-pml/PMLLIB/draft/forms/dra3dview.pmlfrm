------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateGadgets(BOOLEAN,BOOLEAN) -                   method to activate Gadgets or not, based on write-ability of view or sheet
--  addRemScan(DBREF)                -                   function to find out if the passed ADDE or REME is a valid DESI one
--  associateView()                  -                   Pick a new view to associate with this 3D view
--  buildLocalIdList(DBREF)          -                   Get the idList of the selected view
--  captureDraftView(DBREF,STRING)   -                   Get given view content, and make it the selected view
--  checkValidState(STRING)          BOOLEAN             Method to check for a valid Sheet and View
--  close()                          -                   Callback on cancel
--  dra3dView()                      -                   Constructor
--  draScanIdli(DBREF)               -                   Scan the ID list and add to member
--  drawViewFrame(REAL)              -                   Draw frame in 3D view representing view boundary
--  getViewType()                    -                   Get the view type to wireline of hidden line
--  initOnShow()                     -
--  initialise()                     -                   Determine current view from ce, and make it the selected view
--  resetScale()                     -                   Set the scale gadget to current value in database (Used by Undo)
--  scale()                          -                   Set the scale
--  setScale(BOOLEAN)                -                   Set the 2D view scale
--  setScaleGadget(REAL)             -                   Select the form scale option
--  setViewType()                    -                   Set the view type to wireline of hidden line
--  showIdListEditor()               -                   Show the ID list editor form
--  showSectionPlanes()              -                   Callback on the appwareSP toggle
--  transfer3Dto2D()                 -                   Update the 2D view with the 3D contents
--  undoIdListAction()               -                   action to do on undo IDLIST
--  updateAndRefresh(BOOLEAN)        BOOLEAN             Update design, update anno and refresh
--  updateIdListEditor()             -                   Update the ID list editor form
--  updateOption()                   -                   Callback on the updateOption toggle
--  viewAdd()                        -                   Add element to the 3D view
--  viewAdd(ARRAY)                   -                   Add array elements to the 3D view
--  viewAdd(DBREF,STRING,BOOLEAN)    BOOLEAN             Add element to the 3D view
--  viewRem()                        -                   Remove element from the 3D view
--  viewRem(ARRAY)                   -
--  viewRem(DBREF,IDLIST)            BOOLEAN             Remove element from the 3D view
--  viewUpdateIdList(IDLIST)         -                   Update the 2D view ID list
--
------------------------------------------------------------------------

-- Get the icons for standard 3D view buttons
!autoCeIcon           = !!pml.getPathName('autoce16.png')
!rotateCeIcon         = !!pml.getPathName('rotatece16.png')
!mouseZoomRectIcon    = !!pml.getPathName('ng_zoomrectangle.png')
!mouseZoomInOutIcon   = !!pml.getPathName('ng_zoominout.png')
!mouseRotateIcon      = !!pml.getPathName('ng_rotatemode.png')
!mousePanIcon         = !!pml.getPathName('ng_panmode.png')

!restoreOneIcon       = !!pml.getPathName('ng_restoreview1.png')
!restoreTwoIcon       = !!pml.getPathName('ng_restoreview2.png')
!restoreThreeIcon     = !!pml.getPathName('ng_restoreview3.png')
!restoreFourIcon      = !!pml.getPathName('ng_restoreview4.png')

!walkToDrawlistIcon   = !!pml.getPathName('ng_zoomtodrawlist.png')
!zoomToSelectionIcon  = !!pml.getPathName('ng_zoomtoselection.png')

!pick                 = !!pml.getPathName('pickview16.png')
!twoD3D               = !!pml.getPathName('2d-3d16.png')
!threeD2D             = !!pml.getPathName('3d-2d16.png')

setup form !!dra3dView document Varchars NoAlign

  !this.formTitle     = '3D View'

  path right
  hdist 0.0
  button .appwareSP toggle callback |!this.listPopup.select('Show Section Planes', !this.appwareSP.val)
!this.showSectionPlanes()|  tooltip 'Show Section Planes'  pixmap width 16 height 16
  button .idList toggle tooltip 'Show 2D View List...'  pixmap width 16 height 16 callback  |!this.showIdListEditor()|
  button .desAdd at xmax+1.5 tooltip 'Add to View'  pixmap width 16 height 16 callback  |!this.viewAdd()|
  button .desRem tooltip 'Remove from View'  pixmap width 16 height 16 callback  |!this.viewRem()|
  button .explorer toggle tooltip 'Update 2D View List...'  pixmap width 16 height 16 callback |!this.listPopup.select('Update 2D View List', !this.explorer.val)
!this.explorerAddIdlist = !this.explorer.val|
  button .scaleSelect at xmax+1.5 tooltip 'Select Scale...' pixmap width 16 height 16 callback |show !!dra3dViewScale|
  text .scale '' callback |!this.setScale(TRUE)| width 8 is STRING
  button .draftView  '2D>3D'  at xmax+1.5 tooltip 'Update 3D View from 2D View' pixmap "$!<twoD3D>" width 16 height 16 callback |!this.initialise()|
  button .associate tooltip 'Pick a 2D View to associate to this 3D View content' pixmap "$!<pick>" width 16 height 16 callback |!this.associateView()|
  button .drawlist tooltip 'Update 2D View from 3D View (i.e Update Design)' pixmap "$!<threeD2D>" width 16 height 16 callback  |!this.transfer3Dto2D()|
  toggle .viewDir 'Direction' at xmax+0.5 ymin tooltip 'Set 2D View Direction'
  option .updateOption '' tooltip 'Update Options' callback |!this.updateOption()| width 8
  option .viewType '' tooltip '2D View Type' callback |!this.setViewType()| width 9

  -- define view control buttons
  path down
  vdist 0.0
  button .autoCE at xmin.appwareSP ymax.appwareSP+0.2 tooltip 'Limits CE'  pixmap "$!<autoCeIcon>" width 16 height 16 callback |!!gphViews.limits(!this.view, !!ce)|
  button .coreZoomToSelectionButton tooltip 'Zoom to Selection'   pixmap "$!<zoomToSelectionIcon>" width 16 height 16
  button .coreWalkToDrawlistButton  tooltip 'Walk to Draw List'   pixmap "$!<walkToDrawlistIcon>"  width 16 height 16
  button .coreCentreButton          tooltip 'Centre on Selection' pixmap "$!<rotateCeIcon>"        width 16 height 16 callback |!!gphAlwaysRotate(!this.view, !!ce)|

  -- Middle mouse button view manipulation modes
  button .coreZoomRectButton at ymax+0.3 toggle tooltip 'Middle mouse button: Zoom Rectangle'  pixmap "$!<mouseZoomRectIcon>"   "$!<mouseZoomRectIcon>" width 16 height 16
  button .coreZoomInOutButton toggle tooltip 'Middle mouse button: Zoom In/Out'     pixmap "$!<mouseZoomInOutIcon>"  "$!<mouseZoomInOutIcon>"           width 16 height 16
  button .coreRotateButton    toggle tooltip 'Middle mouse button: Rotate'          pixmap "$!<mouseRotateIcon>"     "$!<mouseRotateIcon>"              width 16 height 16
  button .corePanButton       toggle tooltip 'Middle mouse button: Pan'             pixmap "$!<mousePanIcon>"        "$!<mousePanIcon>"                 width 16 height 16

  -- View save and restore commands
  button .coreRestoreView1Button at ymax+0.3 tooltip 'Restore View 1'  pixmap "$!<restoreOneIcon>"   width 16 height 16
  button .coreRestoreView2Button             tooltip 'Restore View 2'  pixmap "$!<restoreTwoIcon>"   width 16 height 16
  button .coreRestoreView3Button             tooltip 'Restore View 3'  pixmap "$!<restoreThreeIcon>" width 16 height 16
  button .coreRestoreView4Button             tooltip 'Restore View 4'  pixmap "$!<restoreFourIcon>"  width 16 height 16

  -- View save and restore commands
  view .view at xmax ymax.viewType+0.2 prompt .prompt GIVolume
    width to max.viewType
    height to max.coreRestoreView4Button
    --statusline off
  exit
   -- not relevant in DRAFT [AK DFN4471]
   -- !this.newMenu('limitsMenu')
   -- !this.limitsMenu.add('CALLBACK', 'Obstruction',   '!!gphViews.limitsList(')
   -- !this.limitsMenu.add('CALLBACK', 'Clipbox',       '!!gphViews.limitsBox(')
   -- !this.limitsMenu.add('separator')
   -- !this.limitsMenu.add('CALLBACK', 'Restore',       '!!gphViews.limitsRestore(')
   -- !this.limitsMenu.add('separator')
   -- !this.limitsMenu.add('CALLBACK', 'Explicit...',   '!!gphViews.limitsExplicit(')

  -- Associate limits menu with limits button
  -- !this.autoCE.setPopup(!this.limitsMenu)

  -- Form Members
  member .currentDraftView  is DBREF

  -- Local copy of Draft View idList
  member .opList            is ARRAY
  member .refList           is ARRAY
  member .originList        is ARRAY

  -- Scale members
  member .scales            is ARRAY
  member .scaleFactors      is ARRAY
  member .activeScale       is REAL

  -- View finder member
  member .viewFinder        is VIEWFINDER

  -- explorer add member
  member .explorerAddIdlist is BOOLEAN

  -- Undoable members
  member .undoScale         is UNDOABLE

  member .originalIdlist    is IDLIST

  !!appFormCntrl.registerForm(!!dra3dView)


exit
------------------------------------------------------------------------
--
-- Method:      dra3dView
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dra3dView()

  -- Make sure if this form is shown then the scale form is also loaded
  pml load form !!dra3dViewScale

  !this.explorer.settooltip('Update 2D View List')

  !!gphViews   = object GPHVIEWS()
  !!gphViewOpt = object GPHVIEWOPT()

  !this.initcall   = '!this.initOnShow()'
  !this.cancelCall = '!this.close()'

  desrem all

  -- populate the update option gadget
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append('On Demand')
  !dtext.append('Background')
  !dtext.append('Auto Update')
  !rtext.append('On Demand')
  !rtext.append('Background Process')
  !rtext.append('Dynamic')
  !this.updateOption.dtext = !dtext
  !this.updateOption.rtext = !rtext

  -- populate the view type option gadget
  !dtext = ARRAY()
  !rtext = ARRAY()

  !dtext.append('Universal Hidden Line')
  !dtext.append('Global Hidden Line')
  !dtext.append('Local Hidden Line')
  !dtext.append('Modelled Wireline')
  !dtext.append('Wireline Hidden Line')
  !dtext.append('Wireline')

  !rtext.append('universal')
  !rtext.append('global')
  !rtext.append('local')
  !rtext.append('mwireline')
  !rtext.append('wirehline')
  !rtext.append('wireline')

  !this.viewType.dtext = !dtext
  !this.viewType.rtext = !rtext

  !dtext = ARRAY()
  !rtext = ARRAY()

  !dtext.append(' ')
  !dtext.append('Use Direction')

  !rtext.append('false')
  !rtext.append('true')

  !this.viewDir.val = false

  !this.appwareSP.addPixmap(!!pml.getPathName('sectshow16.png'))
  !this.idList.addPixmap(!!pml.getPathName('idlist16.png'))
  !this.explorer.addPixmap(!!pml.getPathName('updateidlist16.png'))
  !this.desAdd.addPixmap(!!pml.getPathName('addce16.png'))
  !this.desRem.addPixmap(!!pml.getPathName('removece16.png'))
  !this.scaleSelect.addPixmap(!!pml.getPathName('rulers16.png'))

  -- Set view defaults
  !this.view.background = 'black'
  !this.view.shaded = TRUE

  -- Make a pop-up menu of options
  !menu = !this.newMenu('listPopup')
  !menu.add(|callback|, |Show 2D View List...|,   |!this.idList.val = TRUE
!this.showIdListEditor()|, |Show 2D View List...|)
  !menu.add(|toggle|,   |Update 2D View List|,    |!this.explorerAddIdlist = !this.listPopup.selected('Update 2D View List')
!this.explorer.val = !this.listPopup.selected('Update 2D View List')|, |Update 2D View List|)
  !menu.add(|separator|)
  !menu.add(|callback|, |Add to View...|,           |!this.viewAdd()|, |Add to View...|)
  !menu.add(|callback|, |Remove from View...|,      |!this.viewRem()|, |Remove from View...|)
  !menu.add(|callback|, |Select Scale...|,          |show !!dra3dViewScale|, |Select Scale...|)
  !menu.add(|separator|)
  !menu.add(|callback|, |2D to 3D...|,                 |!this.initialise()|, |2D to 3D...|)
  !menu.add(|callback|, |Pick a 2D View...|,           |!this.associateView()|, |Pick a 2D View...|)
  !menu.add(|callback|, |3D to 2D (Update Design)...|, |!this.transfer3Dto2D()|, |3D to 2D (Update Design)...|)
  !menu.add(|separator|)
  !menu.add(|toggle|,   |Show Section Planes|,        |!this.appwareSP.val = !this.listPopup.selected('Show Section Planes')
!this.showSectionPlanes()|, |Show Section Planes|)

  -- Set the view pop-up menu
  !this.setPopup(!this.listPopup)

  -- initialise member to be false
  !this.explorer.val = TRUE
  !this.explorerAddIdlist = TRUE
  !this.listPopup.select('Update 2D View List', TRUE)

  -- Now we want to register the form with the controlling object

  -- Create a list of the applications we want the form to be visible in.
  !visibleInApps[1] = 'GEN'

  -- List of applications that must have been loaded in order for this form to
  -- be shown. Leave empty if no applications are needed.
  !requiredApps = ARRAY()

  -- Do we want to reshow the form when switching back into an application in which it was
  -- previously visible?
  !reshowOnSwitch = true

  -- Do we want to reshow the form when entering PDMS if it was shown when we left?
  -- Setting to true means the form serialisation mechanism can put the form back where it was before.
  !reShowOnStartUp = FALSE

  -- Finally, call a method on the !!appFormCntrl object to register the form
  -- In this case, the form will be visible in the General application
  -- re-shown when switching between applications and when starting PDMS.
  !!appFormCntrl.registerForm(!this, !visibleInApps, !requiredApps, !reshowOnSwitch, !reShowOnStartUp)

  -- Undoable gadgets (This has been moved out of constructor until PDMS12 when Binary Restore is deprecated so will remove need)
--  !this.undoScale.description('Scale')
--  !this.undoScale.undoAction('!!dra3dView.resetScale()')
--  !this.undoScale.redoAction('!!dra3dView.resetScale()')
--  !this.scale.setUndoable(!this.undoScale)

endmethod
-- End of method definition for .dra3dView()

define method .initOnShow()
  --$P***initOnShow method
  !this.keyboardFocus = !this.view
endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Determine current view from ce, and make it the selected view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Undoable gadgets has to go in initialise because Restore can lose undoable (Change to be in Constructor at PDMS12)
  !this.undoScale.description('Scale input')
  !this.undoScale.undoAction('!!dra3dView.resetScale()')
  !this.undoScale.redoAction('!!dra3dView.resetScale()')
  !this.scale.setUndoable(!this.undoScale)

  -- First check we are in the correct DB
  if (dbtype neq 'PADD') then
    switch
  endif

--  !this.associatedView.val = 'No associated view'
  !this.formTitle = '3D View - No associated view'

  -- Empty local copy of Draft View idList
  !this.opList =  ARRAY()
  !this.refList =  ARRAY()
  !this.originList =  ARRAY()

  aid clear all
  aid transl 50

  desrem all

  !memory = !!ce
  !viewFound = true

  VIEW
  handle ANY
    !viewFound = FALSE
  elsehandle NONE
    !view = !!ce
  endhandle

  if( !viewFound.not() ) then
    SHEET
    handle ANY
      OVER
      handle ANY
      endhandle
    endhandle

    -- Find first view on current sheet
    -- Get all VIEWs
    !collection = ARRAY()
    -- First check that the current 3D view is associated to a view on the current 2D sheet
    if (!this.checkValidState('sheet').not()) then
      --  Should not return but just grey out gadgets
      --  return
    endif
    !currentSheet = !!ce
    if (  defined(!!appDraMain) ) then
       !currentSheet = !!appDraMain.sheet.selection().dbref()
    endif

    if (!currentSheet.unset() or !currentSheet.type.lowcase() ne 'shee') then
      -- Don't do anything
    else
      var !allViews COLLECT ALL VIEWS FOR $!currentSheet
    endif

    if(defined(!allViews[1])) then
      $!allViews[1]
      !view = !!ce
      !viewFound = true
    endif
  endif

  if( !viewFound ) then
    !this.captureDraftView(!view, '')
  else
    -- keep the current view if a new one not found
    if(not badref(!this.currentDraftView)) then
      !this.captureDraftView(!this.currentDraftView, '')
    endif
  endif

-- make sure it is shown
  !this.viewFinder.show()

  !!ce = !memory

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      captureDraftView
--
-- Description: Get given view content, and make it the selected view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       View element
--    2    R     STRING      Key word for generate model COLOUR or ALL or NONE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .captureDraftView(!view is DBREF, !colour is STRING)

  !this.refList.clear()
  !this.opList.clear()
  !this.originList.clear()

  -- set as current selected view
  !this.currentDraftView = !view
  !this.activeScale = !view.vscale

  -- Need to do this to possibly activate inactive gadgets from previously invalid state.
  !this.checkValidState('view')

  -- set up 3D view properties
--  !this.associatedView.val   = !view.name
  !this.formTitle = '3D View - ' & !view.name

  -- Build drawlist
  !this.buildLocalIdList(!view)
  !lcColour = !colour.lowcase()
  if (!lcColour eq 'all' or !lcColour eq '') then
    !this.updateIdListEditor()
  endif

  -- populate 3D graphics
  if( !this.refList.empty() ) then
    !this.view.radius = 10000
    -- This first bit is just to square it up. We do not want it skewed
    !temp[1] = 0
    !temp[2] = 1
    !temp[3] = 0
    !this.view.direction = !temp
    !viewDirection = object DIRECTION(|$!this.currentDraftView.direction|)
    !temp[1] = !viewDirection.east
    !temp[2] = !viewDirection.north
    !temp[3] = !viewDirection.up
    !this.view.direction = !temp
-- ?????????? temporary until core view finder done
    !viewThrough = object POSITION(|$!this.currentDraftView.thposition|)
    !temp[1] = !viewThrough.east
    !temp[2] = !viewThrough.north
    !temp[3] = !viewThrough.up
    !this.view.through = !temp

    -- Do this even though reflist is empty because Undo calls this method
    !memory = !!ce
    !!ce = !view
    generate model
    handle any
    endhandle
  else
    if (!lcColour neq 'none') then
      !memory = !!ce
      !!ce = !view
      if (!lcColour eq 'colour') then
        generate model colour
        handle any
        endhandle
      else
        generate model
        handle any
        endhandle
        -- This first bit is just to square it up. We do not want it skewed
        !temp[1] = 0
        !temp[2] = 1
        !temp[3] = 0
        !this.view.direction = !temp
        -- Why can't this be done in 1 action without temp stuff
        !viewDirection = object DIRECTION(|$!this.currentDraftView.direction|)
        !temp[1] = !viewDirection.east
        !temp[2] = !viewDirection.north
        !temp[3] = !viewDirection.up
        !this.view.direction = !temp
      endif
        !!ce = !memory
      endif
  endif

  -- Get the view type
  !this.getViewType()

  -- get view scale
  !this.setScaleGadget(!view.vscale)
  handle ANY
    !this.scale.val = !this.currentDraftView.vscale.string().substring(1,6)
    !!alert.error('Not a standard view definition')
    return
  endhandle

  -- draw view boundary in model space
  !this.drawViewFrame(!view.vscale)

  -- draw sections (Only if toggle on form is true)
  if (defined(!!dra3dViewSections)) then
    if (!!dra3dViewSections.shown()) then
      !this.showSectionPlanes()
    endif
  endif

  -- Set the modified star
  !!comModifyStar(!this, FALSE)

endmethod
-- End of method definition for .captureDraftView()
------------------------------------------------------------------------
--
-- Method:      buildLocalIdList
--
-- Description: Get the idList of the selected view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       View element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildLocalIdList(!view is DBREF)

  -- Get all VIEWs
  !collection = ARRAY()

  -- Build drawlist
  !this.refList.clear()
  !this.opList.clear()
  !this.originList.clear()

  !this.currentDraftView = !view
--  !this.associatedView.val = !this.currentDraftView.name
  !this.formTitle = '3D View - ' & !this.currentDraftView.name

  -- Get drawlist from the view
  !locIDLN = !this.currentDraftView.idln
--  if (!this.currentDraftView.idln.unset()or (!this.currentDraftView.idln.set() and !this.currentDraftView.idln.badref())) then
  if (!locIDLN.unset() or (!locIDLN.set() and !locIDLN.badref())) then
    !!alert.warning('No idList')
    return
  endif
--  !idliRefe = !this.currentDraftView.idln
--  !this.draScanIdli(!idliRefe)
  !this.draScanIdli(!locIDLN)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      draScanIdli
--
-- Description: Scan the ID list and add to member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       ID list element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draScanIdli(!idliRefe is DBREF)


  -- This will give us ADDE's and REME's of the IDLI pointed to by the View's IDLN attribute.
  !idList = !idliRefe.members

  -- Loop through each idList member, adding its elements to the return list
  do !item values !idList
    !this.addRemScan(!item)
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      drawViewFrame
--
-- Description: Draw frame in 3D view representing view boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL       Scale (Not used now)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drawViewFrame(!dummyScale is REAL)

  -- Use core view finder object
  !this.viewFinder.view(!this.currentDraftView)
  !this.viewFinder.update3d()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Add array elements to the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREFs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewAdd(!elements is ARRAY)

  !memory = !!ce

  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Add array to view content')
  !undo.undoAction('!!dra3dView.undoIdListAction()')
  !undo.redoAction('!!dra3dView.undoIdListAction()')
  !undo.add()

  -- Capture the idList of the current drawing
  !idli = object IDLIST(!this.currentDraftView.idln)
  handle ANY
    !!alert.error('Not a standard view definition')
    return
  endhandle

  -- Add the selection
  !idli.add(!elements)
  -- Call this same method for each element
  do !obj values !elements
    !this.viewAdd(!obj.dbref(), 'none', TRUE)
  enddo
  -- Capture the colours
  !this.captureDraftView(!this.currentDraftView, 'colour')
  -- Set the modified star
  !!comModifyStar(!this, TRUE)

  !this.updateIdListEditor()

  if (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
  endif

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Add element to the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewAdd()

  !memory = !!ce

  -- This block is to only add to 3D view (NOT IDLIST)
  -- If the explorer add to idlist member is off then we just want to add to 3D view gadget only
  if (!!dra3dView.explorerAddIdlist.not()) then
    -- Let's find out if there is a selection selected, if so we will add that.
    !s = object SELECTION()
    !s.getCurrent()
    !sSelection = !s.getSelection()
    if (!sSelection.size() gt 0) then
      -- Call this same method for each element
      do !obj values !sSelection
        !element = !obj.string()
        DESADD $!element
      enddo
    else
      if (TYPE eq 'WORL' or TYPE eq 'TPWL' ) then
        !!alert.error('Cannot add world')
        return
      endif
      -- Make sure we are adding the design element
      if (dbtype neq 'DESI') then
        switch
      endif
      DESADD CE
    endif
    -- Clear the selection
    !s.clear()
    !s.setCurrent()
    return
  endif
  -- End of block is to only add to 3D view (NOT IDLIST)

  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Addition to view content')
  !undo.undoAction('!!dra3dView.undoIdListAction()')
  !undo.redoAction('!!dra3dView.undoIdListAction()')
  !undo.add()

  -- Capture the idList of the current drawing
  !idli = object IDLIST(!this.currentDraftView.idln)
  handle ANY
    !!alert.error('Not a standard view definition')
    return
  endhandle

  -- Let's find out if there is a selection selected, if so we will add that.
  !s = object SELECTION()
  !s.getCurrent()
  !sSelection = !s.getSelection()
  if (!sSelection.size() gt 0) then
    !idli.add(!s)
    -- Call this same method for each element
    do !obj values !sSelection
      !this.viewAdd(!obj, 'none', TRUE)
    enddo
    -- Capture the colours
    !this.captureDraftView(!this.currentDraftView, 'colour')
    -- Set the modified star
    !!comModifyStar(!this, TRUE)
  else
    if (TYPE eq 'WORL' or TYPE eq 'TPWL' ) then
      !!alert.error('Cannot add world to idList')
      return
    endif
    -- Make sure we are adding the design element
    if (dbtype neq 'DESI') then
      switch
    endif
    !idli.add(!!ce)
    !test = !this.viewAdd(!!ce, 'colour', FALSE)
    -- Only want to do this if viewAdd(!!ce, 'colour', false) was completed
    if (!test.not()) then
      !idli.remove(!!ce)
    endif
  endif
  -- Clear the selection
  !s.clear()
  !s.setCurrent()

  !this.updateIdListEditor()

  if (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
  endif

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory
  handle ANY
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Add element to the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF     Element to be added
--    2    R     STRING      Key word for generate model COLOUR or ALL or NONE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewAdd(!addItem is DBREF, !colour is STRING, !partOfSelection is BOOLEAN) is BOOLEAN

  -- First check we are in the correct DB
  if (!addItem.dbtype neq 'DESI') then
    switch
  endif

  -- Capture the passed dbref or it could be change owing to pass by reference
  !element = !addItem

  -- first thing to be added?
  if (!partOfSelection.not()) then
    !firstAdd = !this.refList.empty()

    -- Don't add the world
    if (TYPE  eq 'TPWL' ) then
      !!alert.error('Cannot add template world to idList')
      return FALSE
    endif

    if (!element.type eq 'WORL') then
      !answer = !!alert.confirm('Are you sure you want to add the world?')
      if (!answer.boolean().not()) then
        return FALSE
      endif
    endif
  endif

  -- first test for piping component by climbing to branch
  !memory = !!ce
  !!ce = !element
  BRAN
  handle any
  elsehandle NONE
    if (!partOfSelection.not()) then
      DESREM CE
      DESADD CE COLOUR RED
    endif
    !this.opList.append('ADD')
    !this.refList.append(!!ce)
    !this.originList.append('3D')
    !!ce = !memory
    if (!partOfSelection.not()) then
      !this.captureDraftView(!this.currentDraftView, !colour)
    endif
    !!ce = !memory
    return TRUE
  endhandle

  -- A typical add
  if (!partOfSelection.not()) then
    DESREM $!element
    DESADD $!element  COLOUR RED
    handle any
      !!ce = !memory
      return FALSE
    elsehandle NONE
      !this.captureDraftView(!this.currentDraftView, !colour)
    endhandle
  endif
  !this.opList.append('ADD')
  !this.refList.append(!!ce)
  !this.originList.append('3D')

  if (!partOfSelection.not()) then
    -- Set the modified star
    !!comModifyStar(!this, TRUE)

    if (!firstAdd) then
      !memory = !!ce
      !!ce = !this.currentDraftView
      -- Attempt to put the frame in a central position
      !vscale = !!ce.vscale
      -- Try and auto the view
      !this.scale()
      if (!vscale neq 1) then
        -- Set scale back to what it was because it is probably a template setting of 1/50 say.
        !!ce.vscale = !vscale
      endif
      -- Set scale gadget to actual view scale
      !this.setScaleGadget(!!ce.vscale)
      -- Limits the added element
      if (!partOfSelection.not()) then
        !!gphViews.limits(!this.view, !element)
      endif
      !viewFinder = object VIEWFINDER()
      !viewFinder.redraw()
      !viewFinder.show()
      !!ce = !memory
    elseif (!this.updateOption.selection('rtext') eq 'Dynamic') then
      -- Do we need to update
      !this.updateAndRefresh(FALSE)
    endif
  endif

  !!ce = !memory
  return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Remove array elements from the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREFs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewRem(!elements is ARRAY)

  !memory = !!ce


  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Remove array from view content')
  !undo.undoAction('!!dra3dView.undoIdListAction()')
  !undo.redoAction('!!dra3dView.undoIdListAction()')
  !undo.add()

  -- Capture the idList of the current drawing
  !idli = object IDLIST(!this.currentDraftView.idln)
  handle ANY
    !!alert.error('Not a standard view definition')
    return
  endhandle

  -- Add the selection
  !idli.remove(!elements)
  -- Call this same method for each element
  do !obj values !elements
    !this.viewRem(!obj.dbref(), !idli)
    handle any
    endhandle
  enddo
  -- Capture the colours
  !this.captureDraftView(!this.currentDraftView, 'colour')
  -- Set the modified star
  !!comModifyStar(!this, TRUE)

  !this.updateIdListEditor()

  if (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
  endif

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      viewRem
--
-- Description: Remove element from the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewRem()
  !memory = !!ce

  -- This block is to only remove from 3D view (NOT IDLIST)
  -- If the explorer add to idlist member is off then we just want to remove from 3D view gadget only
  if (!!dra3dView.explorerAddIdlist.not()) then
    -- Let's find out if there is a selection selected, if so we will remove that.
    !s = object SELECTION()
    !s.getCurrent()
    !sSelection = !s.getSelection()
    if (!sSelection.size() gt 0) then
      -- Call this same method for each element
      do !obj values !sSelection
        !element = !obj.string()
        DESREMOVE $!element
      enddo
    else
      -- Make sure we are removing the design element
      if (dbtype neq 'DESI') then
        switch
      endif
      DESREMOVE CE
    endif
    -- Clear the selection
    !s.clear()
    !s.setCurrent()
    return
  endif
  -- End of block is to only remove from 3D view (NOT IDLIST)

  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Removal from view content')
  !undo.undoAction('!!dra3dView.undoIdListAction()')
  !undo.redoAction('!!dra3dView.undoIdListAction()')
  !undo.add()

  -- flow control variable to avoid labels and golabel statements
  !cont = TRUE
  -- Capture the idList of the current drawing
  !idli = object IDLIST(!this.currentDraftView.idln)
  handle ANY
    !!alert.error('Not a standard view definition')
    -- return was NOT right - UNDOABLE needed the cleanup
    !cont = FALSE
  endhandle

  if (!cont) then
    -- Let's find out if there is a selection selected, if so we will remove that.
    !s = object SELECTION()
    !s.getCurrent()
    !sSelection = !s.getSelection()
    if (!sSelection.size() gt 0) then
      -- Call this same method for each element
      do !obj values !sSelection
        !this.viewRem(!obj, !idli)
    enddo
    !idli.remove(!s)
    else $* !cont and selection is empty
    if (TYPE  eq 'TPWL' ) then
      !!alert.error('Cannot remove template world from idList')
        !cont = FALSE
      elseif (TYPE eq 'WORL') then
        !answer = !!alert.confirm('Remove all from this idList?')
        if (!answer.boolean()) then
          !idli.clear()
          DESREM ALL
        else
          !cont = FALSE
        endif
      else $* not a TPWL nor a WORL element
        -- Make sure we are removing the design element
        if (dbtype neq 'DESI') then
          switch
        endif
        !idli.remove(!!ce)
        !test = !this.viewRem(!!ce, !idli)
    -- Only want to do this if viewRem(!!ce) was completed
    if (!test.not()) then
      !idli.add(!!ce)
    endif
  endif
    endif
  endif

  if (!cont) then
  -- Clear the selection
  !s.clear()
  !s.setCurrent()

  !this.updateIdListEditor()

  if (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
    endif
  endif

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory
  handle ANY
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      viewRem
--
-- Description: Remove element from the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to be removed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewRem(!remItem is DBREF, !idList is IDLIST) is BOOLEAN

  -- First check we are in the correct DB
  if (!remItem.dbtype neq 'DESI') then
    switch
  endif

  -- Capture the passed dbref or it could be change owing to pass by reference
  !element = !remItem

  -- Remove the world
 if (TYPE eq 'WORL') then
   !answer = !!alert.confirm('Remove all from this Idlist?').boolean()
   if (!answer) then
     !idList.clear()
   endif
   return !answer
 endif

  -- first test for piping component by climbing to branch
  !memory = !!ce
  !!ce = !element
  BRAN
  handle any
  elsehandle NONE
    DESREM CE
    !this.opList.append('REM')
    !this.refList.append(!!ce)
    !this.originList.append('3D')
    !!ce = !memory
    return TRUE
  endhandle
  !!ce = !memory

  if(!element.signif) then
    DESREM $!element
    handle any
      return FALSE
    endhandle
    !this.opList.append('REM')
    !this.refList.append(!!ce)
    !this.originList.append('3D')
  else
    if(!element.owner.type eq 'WORL') then
      return FALSE
    endif
    !this.viewRem(!element.owner, !idList)
    handle any
    endhandle
  endif

  !!ce = !memory

  -- Set the modified star
  !!comModifyStar(!this, TRUE)

  return TRUE

endmethod
----------------------------------------------------------------------
--
-- Method:      transfer3Dto2D
--
-- Description: Update the 2D view with the 3D contents
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .transfer3Dto2D()

  -- First check we are in the correct DB
  if (dbtype neq 'PADD') then
    switch
  endif

  !memory = !!ce
  !flag = FALSE

  -- First check that the current 3D view is associated to a view on the current 2D sheet
    if (!this.checkValidState('sheet').not()) then
      -- This does not get run because button is greyed out anyhow.
      return
    endif

  -- Check through the views of the current sheet to see if any match the current View
    !currentSheet = !!ce
    if (  defined(!!appDraMain) ) then
       !currentSheet = !!appDraMain.sheet.selection().dbref()
    endif

  !!ce = !currentSheet
  var !views collect all views for ce
  do !i indices !views
    if (!this.currentDraftView.refe.string() eq !views[!i].dbref().refe.string()) then
      !flag = TRUE
      break
    endif
  enddo
  if (!flag.not()) then
    !!ce = !memory
    !!alert.error('The Current 3D view is not associated to a view on the current 2D sheet or overlay')
    return
  endif

  !!ce = !this.currentDraftView
  -- Set the scale (do not consider update at this point, done later in this method)
  !this.setScale(FALSE)

  -- do an update and refresh and DO ask for confirmation
  !this.updateAndRefresh(TRUE)

  !!ce = !memory

endmethod
----------------------------------------------------------------------
--
-- Method:      viewUpdateIdList
--
-- Description: Update the 2D view ID list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     IDLIST      Idlist that could be copied
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewUpdateIdList(!originalIdList is IDLIST)

  -- This method is only used when associating another view to the displayed 3D

   -- Empty the form idList members
  !this.refList.clear()
  !this.opList.clear()
  !this.originList.clear()

  -- Empty any existing adde and reme elements
  !idli = object IDLIST(!this.currentDraftView.idln)
  !idli.clear()

  -- Copy th originalIdList to the current element
  !idli.copy(!originalIdList)

endmethod
----------------------------------------------------------------------
--
-- Method:      showIdListEditor
--
-- Description: Show the ID list editor form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showIdListEditor()

  if( not defined(!!dra3dViewidList)) then
    pml load form !!dra3dViewidList
  endif
  if (!this.idList.val) then
    if(!!dra3dViewidList.shown().not()) then
      !!dra3dViewidList.show()
      !this.updateIdListEditor()
    endif
  else
    !!dra3dViewidList.hide()
  endif

endmethod
----------------------------------------------------------------------
--
-- Method:      updateIdListEditor
--
-- Description: Update the ID list editor form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateIdListEditor()

  if( not defined(!!dra3dViewidList)) then
    return
  endif
  if(!!dra3dViewidList.shown().not()) then
    return
  endif
  !!dra3dViewidList.update()

endmethod
----------------------------------------------------------------------
--
-- Method:      resetScale
--
-- Description: Set the scale gadget to current value in database (Used by Undo)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .resetScale()

  !!runMacro('%PDMSUI%/DRA/CLIB/uscale', 'GETSCALE _DRA3DVIEWSCALE')
  !!dra3dViewScale.ok(TRUE)

endmethod
----------------------------------------------------------------------
--
-- Method:      scale
--
-- Description: Set the scale
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .scale()

  !memory = !!ce

  !!ce = !this.currentDraftView

  -- Auto the current view idList to fit the view size
  auto
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !!ce = !memory

endmethod
----------------------------------------------------------------------
--
-- Method:      setScale
--
-- Description: Set the 2D view scale
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Should we even consider doing and update design
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setScale(!considerUpdate is BOOLEAN)

  var !scale ( $!this.scale.val )
  !scaleValue = !scale.real()
  !this.activeScale = !scaleValue
  !this.scale.settooltip(!scaleValue.string('D5'))

  !memory = !!ce
  !!ce = !this.currentDraftView
  -- See if can set
  -- Only try if gadget is active
  if (!this.scale.active and !considerUpdate) then
    -- The direct assignment does not evaluate e.g. '1 / 50' to '0.02'
    -- as the var evaluation command does
    !scale = !this.scale.val
    if( !scale.match(' / ').gt(0) ) then
      !command = 'VRAT ' & !scale.replace(' / ', ' ')
    else
      !command = 'VSCAL ' & !scale
    endif
    $!command
    handle ANY
      !!alert.error(!!error.text)
      return
    elsehandle NONE
      !!comModifyStar(!this, TRUE)
    endhandle
  else
    return
  endif

  -- If dynamic update then update design.
  if (!this.updateOption.selection('rtext') eq 'Dynamic' and !considerUpdate) then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
  endif

  -- Redraw the view frame. New scale should be picked up
  !this.drawViewFrame(!scaleValue)

  !!ce = !memory

  refresh

endmethod
----------------------------------------------------------------------
--
-- Method:      setScaleGadget
--
-- Description: Select the form scale option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL       Scale
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setScaleGadget(!scale is REAL)

  -- Make sure the scale form is available

  if (not defined(!!dra3dViewScale)) then
    pml load form !!dra3dViewScale

  endif
  -- Set the scale on the scale setting form
  !!dra3dViewScale.initialise()
  -- Run the OK call back of the scale setting form (false means don't update db scale)
  !!dra3dViewScale.ok(FALSE)

endmethod
----------------------------------------------------------------------
--
-- Method:      associateView
--
-- Description: Pick a new view to associate with this 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .associateView()

  -- Turn off section planes (Only draw if toggle on form is true)
  if (defined(!!dra3dViewSections)) then
    !this.appwareSP.val = FALSE
    !this.showSectionPlanes()
  endif

  -- Record the current View IDLIST
  !originalView = !this.currentDraftView
  !this.originalIdList = object IDLIST(!this.currentDraftView.idln)
  !originalIdListName = !this.currentDraftView.idln

  -- edg pick a view
  prompt off
  prompt load escape |Identify any element in a 2D VIEW to be associated to this 3D view|
  ID VIEW @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on

  !viewElement = !!ce
  !idli = object IDLIST(!viewElement.idln)
  handle ANY
    !!alert.error('Invalid Idlist, Check it out then try again.')
    !!ce = !originalView
    return
  endhandle
--  !this.associatedView.val = !viewElement.name
  !this.formTitle = '3D View - ' & !viewElement.name
  !this.currentDraftView = !viewElement

  -- Need to do this to possibly activate inactive gadgets from previously invalid state.
  !this.checkValidState('view')

  -- At this point we want to know if the idList is empty
  -- Capture the idList of the current drawing
  !idli = object IDLIST(!this.currentDraftView.idln)
  !idliName = !this.currentDraftView.idln
  if (!idliName eq !originalIdListName) then
    !!alert.warning('These views reference the same Idlist')
  else

    if (!idli.query().size() neq 0) then

      show !!draAssociationConfirm

    else
      -- Update the idList for this view
      !this.viewUpdateIdList(!originalIdList)

      -- Get the view type
      !this.getViewType()

      -- ????????????? Could be temporary just to centre the volume using auto
      !recordScale = !this.currentDraftView.vscale
      !this.scale()
      -- However use the template scale, unless it is equal to 1
      if (!recordScale neq 1) then
        !this.currentDraftView.vscale = !recordScale
      endif
      !this.setScaleGadget(!this.currentDraftView.vscale)

      -- Update the 3D view
      -- This first bit is just to square it up. We do not want it skewed
      !temp[1] = 0
      !temp[2] = 1
      !temp[3] = 0
      !this.view.direction = !temp
      !viewDirection = object DIRECTION(|$!this.currentDraftView.direction|)
      !temp[1] = !viewDirection.east
      !temp[2] = !viewDirection.north
      !temp[3] = !viewDirection.up
      !this.view.direction = !temp

      -- If dynamic update then update design.
      if (!this.updateOption.selection('rtext') eq 'Dynamic') then
        -- Do we need to update
        !this.updateAndRefresh(FALSE)
      endif

      -- Draw the new view frame
      !this.drawViewFrame(!this.currentDraftView.vscale)

      !!ce = !this.currentDraftView

      -- Set the modified star
      !!comModifyStar(!this, TRUE)
    endif

  endif



endmethod

----------------------------------------------------------------------
--
-- Method:      checkValidState
--
-- Description: Method to check for a valid Sheet and View
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Sheet or view
-- Return:
--   [Data Type] [Description]
--    Boolean     Valid or not
--
------------------------------------------------------------------------
define method .checkValidState(!type is STRING) is BOOLEAN

  -- Extract claim latest to update the OkCLAIM status
  EXTRACT CLAIM LATEST
  !testOK = FALSE

  !currentSheet = !!ce
   if (!type.lowcase() eq 'sheet') then
    --For Marine drafting to determine activity of buttons by whether there is a current view.
    if !this.currentDraftView.unset() then
      !currentSheet = object DBREF()
    endif

    if (  defined(!!appDraMain) ) then
      !currentSheet = !!appDraMain.sheet.selection().dbref()
    endif

    if (!currentSheet.unset() or !currentSheet.badref() ) then
--      !!alert.warning('No sheet selected')
      -- Inactivate gadgets
      !this.activateGadgets(FALSE, FALSE)
      return FALSE
    else
     -- Need to check that user is going to be able to edit the sheet
     var !user USER
     !testDbwrite         = (!currentSheet.dbwrite)
     !testUpdate          = (!currentSheet.dbaccess.lowcase() eq 'update')
     !testLocked          = (!currentSheet.lock)
     -- So what's good?   ????? Still need to know if have to claim explicit A sort of
     if (!testUpdate) then
       -- Update database
       if (!testDbwrite and !testLocked.not()) then
         -- Can write to and it's not locked
         !testOK = TRUE
       else
         !testOK = FALSE
       endif
     else
       -- Multiwrite database
       !testExplicit        = (!currentSheet.dbclaim.lowcase() eq 'explicit')
       !testOwnerImplicit   = (!currentSheet.dbref.extown.claimdb.lowcase() eq 'implicit')
       handle ANY
        !testOwnerImplicit = TRUE
       endhandle
       !testOkClaim         = (!currentSheet.okClaim)
       !testUserClaimed     = (!currentSheet.userc.lowcase() eq !user.lowcase())
       !testExtrUserClaimed = (!currentSheet.prmown.exclto)
       if (!currentSheet.dbref.extals.size() gt 1) then
         !testExtrUserClaimed = (!currentSheet.prmown.exclto)
       else
        !testExtrUserClaimed = TRUE
       endif
       !testNotClaimed      = (!currentSheet.userc.trim() eq '')
       !testNotExtrClaimed  = (!currentSheet.extrc.trim() eq '')
       !testImplicit        = (!currentSheet.dbclaim.lowcase() eq 'implicit')
       if ((!testNotExtrClaimed and !testOkClaim and !testOwnerImplicit) or !testExtrUserClaimed) then
         -- That means nobody else has this extract claimed and we could implicitly or we have already have it claimed
         if (!testDbwrite and !testImplicit and (!testNotClaimed or !testUserClaimed) and !testLocked.not()) then
           -- RW, Implicit claim, not claimed by other or we already have, and not locked.
           !testOK = TRUE
         elseif (!testDbwrite and !testExplicit and !testUserClaimed and !testLocked.not()) then
           -- RW, Explicit claim, already claimed by us, and not locked.
           !testOK = TRUE
         else
           !testOK = FALSE
         endif
       else
         !testOK = FALSE
       endif
     endif
     if (!testOK) then
        -- Activate gadgets
        !this.activateGadgets(TRUE, TRUE)
        return TRUE
      else
        -- Inactivate gadgets
        !this.activateGadgets(FALSE, TRUE)
        return FALSE
      endif
    endif
  elseif (!type.lowcase() eq 'view') then
    !currentView = !this.currentDraftView
    if (!currentView.unset() or !currentView.badref()) then
      !!alert.warning('No associated view')
      -- Inactivate gadgets
      !this.activateGadgets(FALSE, FALSE)
      return FALSE
    else
     -- Need to check that user is going to be able to edit the sheet
     var !user USER
     !testDbwrite         = (!currentView.dbwrite)
     !testUpdate          = (!currentView.dbaccess.lowcase() eq 'update')
     !testLocked          = (!currentView.lock)
     -- So what's good?
     if (!testUpdate) then
       -- Update database
       if (!testDbwrite and !testLocked.not()) then
         -- Can write to and it's not locked
         !testOK = TRUE
       else
         !testOK = FALSE
       endif
     else
       -- Multiwrite database
       !testExplicit        = (!currentView.dbclaim.lowcase() eq 'explicit')
       !testOwnerImplicit   = (!currentView.dbref.extown.claimdb.lowcase() eq 'implicit')
       handle ANY
        !testOwnerImplicit = TRUE
       endhandle
       !testOkClaim         = (!currentView.okClaim)
       !testUserClaimed     = (!currentView.userc.lowcase() eq !user.lowcase())
       if (!currentView.dbref.extals.size() gt 1) then
         !testExtrUserClaimed = (!currentView.prmown.exclto)
       else
        !testExtrUserClaimed = TRUE
       endif
       !testNotClaimed      = (!currentView.userc.trim() eq '')
       !testNotExtrClaimed  = (!currentView.extrc.trim() eq '')
       !testImplicit        = (!currentView.dbclaim.lowcase() eq 'implicit')
       -- ($!testNotExtrClaimed and $!testOkClaim and $!testOwnerImplicit) or $!testExtrUserClaimed)
       if ((!testNotExtrClaimed and !testOkClaim and !testOwnerImplicit) or !testExtrUserClaimed) then
         -- That means nobody else has this extract claimed and we could implicitly or we have already have it claimed
         if (!testDbwrite and !testImplicit and (!testNotClaimed or !testUserClaimed) and !testLocked.not()) then
           -- RW, Implicit claim, not claimed by other or we already have, and not locked.
           !testOK = TRUE
         elseif (!testDbwrite and !testExplicit and !testUserClaimed and !testLocked.not()) then
           -- RW, Explicit claim, already claimed by us, and not locked.
           !testOK = TRUE
         else
           !testOK = FALSE
         endif
       else
         !testOK = FALSE
       endif
     endif
     if (!testOK) then
        -- Activate gadgets
        !this.activateGadgets(TRUE, TRUE)
        return TRUE
      else
        -- Inactivate gadgets
        !this.activateGadgets(FALSE, TRUE)
        return FALSE
      endif
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      activateGadgets
--
-- Description: method to activate Gadgets or not, based on write-ability of view or sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     Boolean    activate general gadgets
--    2    R     Boolean    activate idlist gadgets
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activateGadgets(!activate is BOOLEAN, !idList is BOOLEAN)

  !mod = object MODULE()
  if (!activate) then
    -- Activate gadgets
    !this.idList.active = TRUE
    !this.desAdd.active = TRUE
    !this.desRem.active = TRUE
    !this.appwareSP.active = TRUE
    !this.drawlist.active = TRUE
    !this.updateOption.active = TRUE
    !this.viewType.active = TRUE
    !this.scaleSelect.active = TRUE
    !this.scale.active = TRUE
    !this.associate.active = TRUE
    if (!mod.product eq 'Hull' or !mod.product eq 'Marine') then
        !this.associate.active = FALSE
    endif
    !this.explorer.active = TRUE
    !this.listPopup.setActive(|Show 2D View List...|,TRUE)
    !this.listPopup.setActive(|Update 2D View List|, TRUE)
    !this.listPopup.setActive(|Add to View...|, TRUE)
    !this.listPopup.setActive(|Remove from View...|, TRUE)
    !this.listPopup.setActive(|Select Scale...|, TRUE)
    !this.listPopup.setActive(|2D to 3D...|, TRUE)
    !this.listPopup.setActive(|Pick a 2D View...|, TRUE)
    !this.listPopup.setActive(|3D to 2D (Update Design)...|, TRUE)
    !this.listPopup.setActive(|Show Section Planes|, TRUE)

  else
    -- Inactivate gadgets
    if (!idList) then
      !this.idList.active = TRUE
      !this.appwareSP.active = TRUE
      !this.listPopup.setActive(|Show 2D View List...|,TRUE)
      !this.listPopup.setActive(|Show Section Planes|, TRUE)
    else
      !this.idList.active = FALSE
      !this.appwareSP.active = FALSE
      !this.listPopup.setActive(|Show 2D View List...|,FALSE)
      !this.listPopup.setActive(|Show Section Planes|, FALSE)
    endif
    !this.desAdd.active = FALSE
    !this.desRem.active = FALSE
    !this.drawlist.active = FALSE
    !this.updateOption.active = FALSE
    !this.viewType.active = FALSE
    !this.scaleSelect.active = FALSE
    !this.scale.active = FALSE
    !this.associate.active = FALSE
    !this.explorer.active = FALSE
    !this.explorer.val = FALSE
    !this.explorerAddIdlist = FALSE
    !this.listPopup.setActive(|Update 2D View List|, FALSE)
    !this.listPopup.setActive(|Add to View...|, FALSE)
    !this.listPopup.setActive(|Remove from View...|, FALSE)
    !this.listPopup.setActive(|Select Scale...|, FALSE)
    !this.listPopup.setActive(|2D to 3D...|, FALSE)
    !this.listPopup.setActive(|Pick a 2D View...|, FALSE)
    !this.listPopup.setActive(|3D to 2D (Update Design)...|, FALSE)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      addRemScan
--
-- Description: function to find out if the passed ADDE or REME is a valid DESI one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      ADDE or REME element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addRemScan(!element is DBREF)

  -- Do this to avoid passing by reference
  !itemRef  = !element

  -- The itemRef may not be the expected IDLI
  if (!itemRef.set() and !itemRef.badref().not() and !itemRef.type neq 'IDLI') then
    -- Added elements
    if(!itemRef.type.upcase().eq('ADDE')) then
      !operation = 'ADD '
    -- Removed elements
    elseif(!itemRef.type.upcase().eq('REME')) then
      !operation = 'REM '
    -- Design elements added without an idlist
    else
      !operation = 'ADD '
    endif
    !this.refList.append(!itemRef)
    !this.opList.append(!operation)
    !this.originList.append('2D')
    return
  endif

  if (!itemRef.idname.set() and !itemRef.idname.badref()) then
    -- This is possible if the design extract contents has not been issued by other user
    var !name idname of $!itemRef
  elseif (!itemRef.idname.set() and !itemRef.idname.dbtype eq 'PADD') then
    -- Must be an idList
    -- Commented out good code because it is probably not what is required. (Was nested idList)
    --    !!ce = !itemRef.idname
    --    var !addRems collect all (ADDE REME) for ce
    --    do !i indices !addRems
    --      !this.addRemScan(!addRems[!i].dbref())
    --      return
    --    enddo
    -- Replaced with:
    !name = !itemRef.idname.fullname
  elseif (!itemRef.idname.unset()) then
    --!name = !itemRef.criteria
    var !name criteria of $!itemRef
  else
    !name = !itemRef.idname.fullname
  endif

  -- Added elements
  if(!itemRef.type.upcase().eq('ADDE')) then
    !operation = 'ADD '
  -- Removed elements
  else
    !operation = 'REM '
  endif

  !this.refList.append(!itemRef)
  !this.opList.append(!operation)
  !this.originList.append('2D')

endmethod
------------------------------------------------------------------------
--
-- Method:      updateAndRefresh
--
-- Description: Update design, update anno and refresh
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Ask for confirmation or not
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateAndRefresh(!ask is BOOLEAN)is BOOLEAN

  !save = 'NO'
  -- Make sure we are at the Draft element
  !!ce = !this.currentDraftView

  -- Ask is only false when a the updateOption is 'Dynamic'
  if (!ask) then
    if (!this.updateOption.selection('rtext') eq 'On Demand') then
      -- initialise confirm form for this question
--      !question = 'Do you wish to Update Design at this time? This can take a while for large data.'
--      !answer   = object BOOLEAN()
--      !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateAndRefreshOnDemand')
-- [SB] !answer = !!alert.confirm('Do you wish to Update Design at this time? This can take a while for large data.')
--[PJEB]!answer = !!alert.confirm('Update Design on demand will stop other work while in progress.  Please confirm.')
-- [AK] version
--        !answer = !!alert.confirm('Do you wish to Update Design at this time?  A large drawing will stop you working while in progress.')
!answer = 'YES'
    elseif (!this.updateOption.selection('rtext') eq 'Background Process') then
      -- initialise confirm form for this question
--      !question = 'Do you wish to Update Design using a Background Process at this time? This can take a while for large data.'
--      !answer   = object BOOLEAN()
--      !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateAndRefreshLDP')
      !session = current session
      if (!session.modified()) then
        !save = !!alert.confirm('The Background Process will use the latest saved session data. Do you wish to Savework?')
      endif
      !answer = !!alert.confirm('Update Design using a Background Process?')
    elseif (!this.updateOption.selection('rtext') eq 'Dynamic') then
      -- initialise confirm form for this question
--      !question = 'Update Design? This can take a while for large data.'
--      !answer   = object BOOLEAN()
--      !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateAndRefreshDynamic')
      --!answer = !!alert.confirm(|Update Design? This can take a while for large data.|)
      !answer = 'YES'
    endif
  else
    !answer = 'YES'
  endif

  if (!answer.boolean()) then
    if (!this.updateOption.selection('rtext') eq 'Background Process') then
      if (!save.boolean()) then
        SAVEWORK
      endif
      update design ignore nowait
      handle ANY
      endhandle
    else

      -- Use view direction
      if (!this.viewDir.val.boolean()) then

        !elevation = !!dra3dview.view.elevation
        !direction = object DIRECTION('N wrt world')
        !data = ARRAY()

        do !component values !!dra3dview.view.direction
          !data.append(!component)
        enddo

        !direction.east   = !data[1]
        !direction.north  = !data[2]
        !direction.up     = !data[3]
        !direction.origin = /*

        -- Calculate the from pos using the throughpos and the direction
        !data = ARRAY()

        do !component values !!dra3dview.view.through
          !data.append(!component)
        enddo

        --!thpos   = 'E' & !data[1] & ' N' & !data[2] & ' U' & !data[3]
        --!through = object POSITION(!thpos)
        --!from    = !through.offset(!direction.opposite(),1000)
        --!frpos   = !from.string()

        !vdir = !direction.string().before('WRT')

        DIR $!vdir

        -- For testing
        -- FRPOS $!frpos
        -- THPOS $!thpos

        -- Set adeg if necessary
        if (!elevation.gt(90) or !elevation.lt(-90)) then
          ADEG 180
        else
          ADEG 0
        endif

--        !this.drawViewFrame(!!ce.vscale)

      endif

      UPDATE DESIGN
      handle ANY
        -- An error is output if idList is empty
        -- Try update All
        update all
        handle ANY
        elsehandle NONE
          -- Set the modified star
          !!comModifyStar(!this, FALSE)
        endhandle
      elsehandle NONE
        -- Set the modified star
        !!comModifyStar(!this, FALSE)
        update anno
        handle ANY
        endhandle
      endhandle
    endif
    refresh
  endif

  return !answer.boolean()

endmethod
------------------------------------------------------------------------
--
-- Method:      updateOption
--
-- Description: Callback on the updateOption toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateOption()

  !viewFinder = object VIEWFINDER()

  if (!this.updateOption.selection('rtext') eq 'On Demand') then
    -- initialise confirm form for this question
--    !question = 'Update Design can take a while for large data. Update will occur when the 3D>2D button is used'
--    !answer   = FALSE
--    !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateOption', 'message')
    !viewFinder.dynamic(FALSE)
  elseif (!this.updateOption.selection('rtext') eq 'Background Process') then
    -- initialise confirm form for this question
--    !question = 'Update Design can take a while for large data. Update will use a Background Process mechanism when the 3D>2D button is used'
--    !answer   = FALSE
--    !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateOption', 'message')
    !viewFinder.dynamic(FALSE)
    !this.updateOption.select('rtext', 'Background Process')
  elseif (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- initialise confirm form for this question
--    !question = 'Update Design can take a while for large data. Update will dynamically occur whenever idList is changed'
--    !answer   = FALSE
--    !!comAlertOnce(!question, !answer, '!!dra3dViewUpdateOption', 'message')
    !viewFinder.dynamic(TRUE)
    handle ANY
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      showSectionPlanes
--
-- Description: Callback on the appwareSP toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSectionPlanes()

  if (!this.appwareSP.val) then
    if (!this.shown()) then
      show !!dra3dViewSections
      !!dra3dViewSections.initialise(TRUE)
    endif
  else
    if (defined(!!dra3dViewSections)) then
        !!dra3dViewSections.hide()
        !!dra3dViewSections.initialise(FALSE)
        ERASE PLANE IN $!!dra3dView.currentDraftView
    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Callback on cancel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  if (defined(!!dra3dViewSections)) then
    !!dra3dViewSections.close()
  endif
  if (defined(!!dra3dViewScale)) then
    kill !!dra3dViewScale
  endif
  if (defined(!!dra3dViewIdlist)) then
    kill !!dra3dViewIdlist
  endif

  -- Kill this form
  kill !!dra3dView

endmethod
------------------------------------------------------------------------
--
-- Method:      undoIdListAction
--
-- Description: action to do on undo IDLIST
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoIdListAction()

  !!dra3dView.updateAndRefresh(false)
  !!dra3dView.captureDraftView(!!dra3dView.currentDraftView, |all|)

endmethod
------------------------------------------------------------------------
--
-- Method:      setViewType
--
-- Description: Set the view type to wireline of hidden line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setViewType()

  !viewType = !this.viewType.selection('rtext')

  !memory = !!ce
  !!ce = !this.currentDraftView
  -- See if can set
  vtype $!viewType
  handle ANY
    !!alert.error(!!error.text)
    !actualViewType = !!ce.vtype.part(1).lowcase()
    !this.viewType.select('rtext', !actualViewType)
    !!ce = !memory
    return
  elsehandle NONE
    !!comModifyStar(!this, TRUE)
  endhandle

  -- If dynamic update then update design.
  if (!this.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.updateAndRefresh(FALSE)
  endif

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      getViewType
--
-- Description: Get the view type to wireline of hidden line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getViewType()

  !memory = !!ce
  !!ce = !this.currentDraftView
  !actualViewType = !!ce.vtype.part(1).lowcase()
  !this.viewType.select('rtext', !actualViewType)
  !!ce = !memory

endmethod
