--
--
-- Description:
-- Scale setting form for 3D View in Draft
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoScale()                      -                   auto Scale
--  dra3dViewScale()                 -                   Constructor
--  initialise()                     -                   initialise the form with the scale of the associated view
--  ok(BOOLEAN)                      -                   method run on OK
--
------------------------------------------------------------------------

setup form !!dra3dViewScale dialog

  !this.formTitle = 'Scale'
  !this.iconTitle = 'Scale'
  !this.initcall  = '!this.initialise()'

  -- define standard scale gadgets
  call !!runMacro('%PDMSUI%/DRA/CLIB/USCALE', 'STD_GADGETS _dra3dViewScale')

  button _ok | Apply | at x0 ymax+0.5  call |!this.ok(TRUE)|
  button _cancel |Dismiss| at xmax form-size ymin call |!this.hide()| ok

  -- Undoable members
  member .undoOk is UNDOABLE

exit

------------------------------------------------------------------------
--
-- Method:      dra3dViewScale
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dra3dViewScale()

  -- Change the callback on the autoScale gadget
  !this.autoScale.callback = '!this.autoScale()'

  -- Undoable gadgets (Moved to initialise() till PDMS12 deprecates Binary Restore)
--  !this.undoOk.description('Scale')
--  !this.undoOk.undoAction('!!dra3dView.resetScale()')
--  !this.undoOk.redoAction('!!dra3dView.resetScale()')
--  !this.ok.setUndoable(!this.undoOk)

endmethod
-- End of method definition for .dra3dViewScale()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise the form with the scale of the associated view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Undoable gadgets has to go in initialise because Restore can lose undoable (Till PDMS12)
  !this.undoOk.description('Scale')
  !this.undoOk.undoAction('!!dra3dView.resetScale()')
  !this.undoOk.redoAction('!!dra3dView.resetScale()')
  !this.ok.setUndoable(!this.undoOk)

  -- Make sure we are at the correct view
  !!ce = !!dra3dView.currentDraftView

  var user _dra3dViewScale clear
  -- Userdata  1 - View - Reference
  var user _dra3dViewScale REF
  -- Userdata  2 - View Region
  var user _dra3dViewScale add VREG
  var user _dra3dViewScale select 1

  -- initialise the form for the current views scale settings
  call !!runMacro('%PDMSUI%/DRA/CLIB/USCALE', 'GETSCALE _dra3dViewScale')

  -- Inactivate the autoScale gadget if there is an empty IDlist
  !idli = object IDLIST(!!dra3dView.currentDraftView.idln)
  handle ANY
    !this.autoScale.active = TRUE
  endhandle
  if (!idli.query().size() eq 0) then
    !this.autoScale.active = FALSE
  else
    !this.autoScale.active = TRUE
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: method run on OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Update the database scale
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ok(!updateDb is BOOLEAN)

  -- Transfer the selected scale to the owning form scale gadgets
  if (!this.scaleTog1.val or !this.scaleVal.val.trim() eq '') then
    !!dra3dView.scale.val = !this.scaleStd.selection('rtext').replace(' ',' / ')
    -- this is a pair of numbers '1 50' '1 100' '1 33.1/3' . Changed the ' ' to a ' / ' to guarantee real() conversion.
  else
    !!dra3dView.scale.val   = !this.scaleVal.val
  endif

  -- Do the actual scale change immediately
  if (!updateDb) then
    !!dra3dView.setScale(TRUE)
  else
    !!dra3dView.setScale(FALSE)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoScale
--
-- Description: auto Scale
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoScale()

  !view = !!dra3dView.currentDraftView
  !!ce = !view

  -- save the view atts
  var !memoryVDIR (DIR)
  var !memoryVSCA (VSCA)
  var !memoryVRAT (VRAT)

--  if(!!dra3dView.viewDir.val.boolean()) then
--
--    -- Capture the 3D view direction
--    !d = !!dra3dView.view.direction
--    !viewDirection = object DIRECTION('D')
--    !viewDirection.east = !d[1]
--    !viewDirection.north = !d[2]
--    !viewDirection.up = !d[3]
--    !viewDir = !viewDirection.string().before(' WRT')
--
--    -- set the view dir to the forms dir
--    DIR $!viewDir
--
--  endif

  -- perform the auto limits
  ONPOS 0 0
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle
  AUTO
  handle any
    DIR $!memoryVDIR
    !!alert.error(!!error.text)
    return
  endhandle
  -- reset the views dir
  DIR $!memoryVDIR
  !this.scaleVal.val = !view.vscale.string()
  !this.scaleTog2.val = TRUE
  -- reset the views scale
  VRATIO $!memoryVRAT
  handle any
    -- VRATIO is unset or invalid (use VSCA)
    VSCA $!memoryVSCA
  endhandle

--  if(!!dra3dView.viewDir.val.boolean()) then
--    !!alert.message('Auto Scaled for the displayed 3D view direction of ' & !viewDir)
--  endif

endmethod
-- End of method
