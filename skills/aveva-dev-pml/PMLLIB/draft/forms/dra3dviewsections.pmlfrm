--
-- Description:
-- Browser for 3d View Section Planes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateIdListGadgets()          -                   Activate the IdList Gadgets
--  addRemScan(DBREF)                -                   function to find out if the passed ADDE or REME is a valid DESI one
--  buildLocalidList(DBREF)          -                   Get the idList of the selected view section
--  chosenCol()                      -                   Chosen Colour
--  clipChosenCol()                  -                   Chosen Clip Colour
--  clipColours()                    -                   Highlighting colours
--  clipSectionPlanes()              -                   Callback on the appwareSP toggle
--  close()                          -                   close the form
--  collectSections()                -                   Initialise the form
--  colours()                        -                   Highlighting colours
--  create()                         -                   show a create form
--  dra3dViewSections()              -                   Constructor
--  draScanIdli(DBREF)               -                   Scan the ID list and add to member
--  getVSEC(DBREF)                   ARRAY               get the vsec for the section planes list selection
--  initialise(BOOLEAN)              -                   Initialise the form
--  listPopupCallback()              -                   Initialise the form
--  modify(DBREF)                    -                   show a modify form
--  refresh()                        -                   Refresh the clip list Gadgets
--  setActives()                     -                   Check to right gadget are active dependent on section planes list selection
--  setClipList()                    -                   call back if clip list option gadget selected
--  setColour()                      -                   Set colour of section plane
--  showIdlist()                     -                   call back if clip list option gadget selected
--  undoAction()                     -                   undo/redo callback of UNDOABLE objects
--  viewAdd()                        -                   Add element to the clip idlist
--  viewAdd(DBREF)                   BOOLEAN             Add element to the 3D view
--  viewRem()                        -                   Remove element from the 3D view
--  viewRem(DBREF)                   BOOLEAN             Remove element from the 3D view
--
setup form !!dra3dViewSections dialog dock t

  track |PADDCE| call |call !!dra3dviewsectionstrack()|

  !this.formTitle     = 'Section Planes - No associated view'
  !this.callback      = ''

  button .createButton at x0 ymax tooltip 'New Section Plane' pixmap width 16 height 16 callback '!this.create()'
  button .clipSP toggle at xmax ymin callback |!this.formPopup.select('Section Plane Clipping', !this.clipSP.val)
!this.clipSectionPlanes()|  tooltip 'Indicate Section Plane Clipping'  pixmap width 16 height 16
  button .idList at xmax ymin tooltip 'Clipping List...'  pixmap width 16 height 16 callback  |!this.showIdlist()|
  button .desAdd at xmax ymin tooltip 'Add to Clipping List'  pixmap width 16 height 16 callback  |!this.viewAdd()|
  button .desRem at xmax ymin tooltip 'Remove from Clipping List'  pixmap width 16 height 16 callback  |!this.viewRem()|
  option .idli '' at xmax ymin tooltip 'Clipping List' callback |!this.setClipList()| width 24

  list   .list   'Section Planes' anchor top + bottom + left + right at x0 ymax call '!this.setActives()' columns MULTI width 120 length 6

  !menu = !this.newMenu('listPopup')
  !menu.add(|callback|, |Modify...|,           |!this.listPopupCallback()|, |Modify...|)
  !menu.add(|callback|, |Redefine Points...|,  |!this.listPopupCallback()|, |Redefine Points...|)
  !menu.add(|callback|, |Highlight...|,        |!this.listPopupCallback()|, |Highlight...|)
  !menu.add(|callback|, |Delete...|,           |!this.listPopupCallback()|, |Delete...|)
  !menu.add(|callback|, |Flip...|,             |!this.listPopupCallback()|, |Flip...|)
  !menu.add(|callback|, |Colour...|,           |!this.colours()|,           |Colour...|)
  !menu.add(|separator|)
  !menu.add(|toggle|,   |Translucency|,        |!this.listPopupCallback()|, |Translucency|)
  !menu.add(|toggle|,   |Visibility|,          |!this.listPopupCallback()|, |Visibility|)
  !menu.add(|toggle|,   |Clipping|,            |!this.listPopupCallback()|, |Clipping|)
  !menu.add(|toggle|,   |Highlight Clip List|, |!this.listPopupCallback()|, |Highlight Clip List|)
  !menu.add(|separator|)
  !menu.add(|callback|, |Refresh...|,          |!this.listPopupCallback()|, |Refresh...|)

  -- Form Members
  member .currentSection   is DBREF
  member .clipList         is DBREF

  -- Local copy of Section idList
  member .opList           is ARRAY
  member .refList          is ARRAY
  member .originList       is ARRAY

  -- Section Plane Colours
  member .colourMember     is REAL
  member .clipColourMember is REAL

  -- Undoable members
  member .undoCreateButton   is UNDOABLE
  member .undoRedefinePoints is UNDOABLE
  member .undoFlip           is UNDOABLE

  -- Answer for confirmation question in viewRem() to stop multiple confirmation messages.
  member .viewRemAnswer      is BOOLEAN

exit
------------------------------------------------------------------------
--
-- Method:      dra3dViewSections
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dra3dViewSections()

  -- Set the cancel call
  !this.cancelCall = '!this.close()'

  -- Set the view pop-up menu
  !this.list.setPopup(!this.listPopup)

  !this.createButton.addPixmap(!!pml.getPathName('sectnew16.png'))
  !this.idList.addPixmap(!!pml.getPathName('idlist16.png'))
  !this.desAdd.addPixmap(!!pml.getPathName('idlistadd16.png'))
  !this.desRem.addPixmap(!!pml.getPathName('idlistrem16.png'))
  !this.clipSP.addPixmap(!!pml.getPathName('sectplane16.png'),!!pml.getPathName('sectplaneon16.png'))

  -- Heading For list gadget
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Colour')
  !headings.append('Translucency')
  !headings.append('Visibility')
  !headings.append('Clipping')
  !this.list.setHeadings(!headings)

  -- Set a default colour for section plane
  if (!this.colourMember.unset() ) then
    !this.colourMember = 5
  endif
  if (!this.clipColourMember.unset() ) then
    !this.clipColourMember = 246
  endif

    -- Undoable gadgets
--  !this.undoCreateButton.description('Section Plane creation')
--  !this.undoCreateButton.undoAction(|!!dra3dView.appwareSP.val = !!dra3dView.listPopup.selected('Show Section Planes')
--!!dra3dView.showSectionPlanes()|)
--  !this.undoCreateButton.redoAction(|!!dra3dView.appwareSP.val = !!dra3dView.listPopup.selected('Show Section Planes')
--!!dra3dView.showSectionPlanes()|)
--  !this.createButton.setUndoable(!this.undoCreateButton)

--  !this.undoFlip.description('Section Plane flip')
--  !this.undoFlip.undoAction(|!!dra3dView.appwareSP.val = !!dra3dView.listPopup.selected('Show Section Planes')
--!!dra3dView.showSectionPlanes()|)
--  !this.undoFlip.redoAction(|!!dra3dView.appwareSP.val = !!dra3dView.listPopup.selected('Show Section Planes')
--!!dra3dView.showSectionPlanes()|)
--  !this.listPopup.setUndoable('Flip...', !this.undoFlip)

  -- Make a pop-up menu of options
  !menu = !this.newMenu('formPopup')
  !menu.add(|callback|, |New Section Plane|,          |!this.create()|,     |New Section Plane|)
  !menu.add(|callback|, |Clipping List...|,           |!this.showIdlist()|, |Clipping List...|)
  !menu.add(|callback|, |Add to Clipping List|,       |!this.viewAdd()|,    |Add to Clipping List|)
  !menu.add(|callback|, |Remove from Clipping List|,  |!this.viewRem()|,    |Remove from Clipping List|)
  !menu.add(|toggle|,   |Section Plane Clipping|,     |!this.clipSP.val = !this.formPopup.selected('Section Plane Clipping')
!this.clipSectionPlanes()|, |Section Plane Clipping|)

  -- Set the view pop-up menu
  !this.setPopup(!this.formPopup)

endmethod
-- End of method definition for .dra3dViewSections()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!showPlanes is BOOLEAN)

    -- Undoable gadgets has to go in initialise because Restore can lose undoable
  !this.undoCreateButton.description('Section Plane creation')
  !this.undoCreateButton.undoAction('!!dra3dViewSections.undoAction()')
  !this.undoCreateButton.redoAction('!!dra3dViewSections.undoAction()')
  !this.createButton.setUndoable(!this.undoCreateButton)

  !this.undoFlip.description('Section Plane flip')
  !this.undoFlip.undoAction('!!dra3dViewSections.undoAction()')
  !this.undoFlip.redoAction('!!dra3dViewSections.undoAction()')
  !this.listPopup.setUndoable('Flip...', !this.undoFlip)

  !this.formTitle = 'Section Planes - ' & !!dra3dView.formTitle.after('3D View - ').before('*')

  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
    -- ???????? may wish to also hide form or similar.
  endhandle

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  if (!showPlanes) then
    !sectionPlanes.clear()
    !sectionPlanes.add(!view)

    -- Populate the list gadget
    !this.collectSections()
  else
    !sectionPlanes.clear()
    -- Clear the list gadget
    !this.list.dtext = ARRAY()
  endif

  -- Populate the idli gadget with /* and all idli of this drawing
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append('World (/*)')
  !rtext.append('/*')
  !drawingName = !!dra3DView.currentDraftView.owner.owner
  var !collection collect all (IDLI) for $!drawingName
  do !i indices !collection
    !element = object DBREF(!collection[!i])
    !dtext.append(!element.name)
    !rtext.append(!collection[!i])
  enddo
  !this.idli.dtext = !dtext
  !this.idli.rtext = !rtext

  !this.setClipList()

  !this.setActives()

  -- Show clipping teeth or not
  !this.clipSectionPlanes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undoAction
--
-- Description: undo/redo callback of UNDOABLE objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoAction()

  -- exit if 3D view doesn't exists or not displayed
  if undefined(!!dra3dView) then
    return
  endif
  if !!dra3dView.shown().not() then
    return
  endif

  !!dra3dView.appwareSP.val = !!dra3dView.listPopup.selected('Show Section Planes')
  !!dra3dView.showSectionPlanes()

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      collectSections
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .collectSections()

  -- Initialise variables
  !rowsArray      = ARRAY()
  !rtext          = ARRAY()
  !reference      = ARRAY()

  !unusedView = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
    -- ???????? may wish to also hide form or similar.
  endhandle

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !elements = !sectionPlanes.query()

  do !i indices !elements

      -- Reference
      !reference.append(!elements[!i].queryDbref().reference.string())
      handle ANY
        -- Invalid Section
        !!alert.warning('There is an invalid section plane in this view')
        skip
      endhandle

      -- Type
      if (!elements[!i].queryDbref().type eq 'SPLA') then
        !type = 'Section Plane'
      elseif (!elements[!i].queryDbref().type eq 'FPLA') then
        !type = 'Flat Plane   '
      elseif (!elements[!i].queryDbref().type eq 'PPLA') then
        !type = 'Perpendicular'
      endif

      -- Colour
      !colour = object COLOUR(!elements[!i].queryColour())
      !colourCapitalised = 'Unset'
      if (!colour.code neq 0) then
        !colourName = !colour.name
        !colourCapitalised = !colourName.substring(1,1).upcase() & !colourName.substring(2).lowcase()
      endif

      -- Translucency
      if (!elements[!i].queryTranslucency() eq 0) then
        !translucency = 'Opaque'
      else
        !translucency = 'Translucent'
      endif

      -- Shown
      if (!elements[!i].queryShow()) then
        !show = 'Shown'
      else
        !show = 'Hidden'
      endif

      -- Clipping
      if (!elements[!i].queryClip(!!dra3dView.currentDraftView)) then
        !clip = 'Clipped'
      else
        !clip = 'Unclipped'
      endif
      -- Display the elements
      !rtext.append(!reference[!i])

      !rowsArray[!i][1] = !elements[!i].queryDbref().name
      !rowsArray[!i][2] = !type
      !rowsArray[!i][3] = !colourCapitalised
      !rowsArray[!i][4] = !translucency
      !rowsArray[!i][5] = !show
      !rowsArray[!i][6] = !clip

  enddo

  !this.list.setRows(!rowsArray)

  !this.list.rtext = !rtext

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      listPopupCallback
--
-- Description: Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .listPopupCallback()

  -- Initialise variables
  -- Array of selected section planes
  !selectedSectionPlanes = !this.list.val
  !selectedSectionPlanes = !selectedSectionPlanes.sort().invert()

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !elements = !sectionPlanes.query()

  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
    -- ???????? may wish to also hide form or similar.
  endhandle
  if (!this.listPopup.pickedField eq 'Modify...') then
    -- Only 1 selection allowed
    if (!selectedSectionPlanes.size() gt 1) then
      !!alert.error('One selection allowed only for this option')
      return
    endif
    do !value values !selectedSectionPlanes
      !this.modify(!elements[!value].queryDbref())
    enddo
  elseif (!this.listPopup.pickedField eq 'Redefine Points...') then
    -- Only 1 selection allowed
    if (!selectedSectionPlanes.size() gt 1) then
      !!alert.error('One selection allowed only for this option')
      return
    endif
    do !value values !selectedSectionPlanes
      --!this.definePoints(!elements[!value].queryDbref())
      if (!elements[!value].queryDbref().type neq 'SPLA') then
        !!alert.error('Only allowed on stepped section planes')
        return
      endif
      !temp = !!dra3dView.view.direction
      !viewDirection = object DIRECTION()
      if (dbtype neq 'DESI') then
        switch
        world
      endif
      !viewDirection.origin = ce
      !viewDirection.east  = !temp[1]
      !viewDirection.north = !temp[2]
      !viewDirection.up    = !temp[3]
      if (dbtype neq 'PADD') then
        switch
      endif
      -- erase the 2d sketch
      ERASE PLANE IN $!!dra3dView.currentDraftView
      -- Introduce prompts while doing the redefinition
      !elements[!value].redefinePoints(!viewDirection)
    enddo
  elseif (!this.listPopup.pickedField eq 'Highlight...') then
    do !value values !selectedSectionPlanes
      !elements[!value].highlight()
      !elements[!value].show(TRUE)
    enddo
  elseif (!this.listPopup.pickedField eq 'Visibility') then
    if (!this.listPopup.selected('Visibility')) then
      do !value values !selectedSectionPlanes
        !elements[!value].show(TRUE)
      enddo
    else
      do !value values !selectedSectionPlanes
        !elements[!value].show(FALSE)
      enddo
    endif
  elseif (!this.listPopup.pickedField eq 'Delete...') then
    !memory = !!ce
    do !value values !selectedSectionPlanes

      !oneToOne = FALSE
      -- First of all we want to see if we have a matching pair (1 to 1 relationship) of VSEC and SPLA
      -- because if we have we want to delete the pair together. This should be the default situation.
      !vsec = !this.getVSEC(!elements[!value].queryDbref())
      if (!vsec.size() eq 1) then
        -- OK we at least know there is only 1 VSEC referencing the section plane
        if (!elements[!value].queryDbref().name eq !vsec[1].dbref().name.before('/VSEC')) then
          !oneToOne = TRUE
        endif
      endif

      -- Use the one to one information to refine the questions...
      if (!oneToOne) then
        !question = 'OK to delete the section plane ' & !elements[!value].queryDbref().name & ' ?'
      else
        !question = 'OK to delete the VSEC referencing section plane ' & !elements[!value].queryDbref().name & ' ?'
      endif

      !answer = !!alert.confirm(!question)
      if (!answer.boolean().not()) then
        skip
      endif
      -- First delete the VSEC referencing this Section plane
      !vsec = !this.getVSEC(!elements[!value].queryDbref())
      !!ce = !vsec[1].dbref()
      DELETE VSEC
      handle ANY
        !!alert.error(!!error.text)
      endhandle

      -- Actual section plane deletion
      !!ce = !elements[!value].queryDbref()
      var !type TYPE
      if (!type eq 'SPLA') then
        !fullType = 'Section Plane'
      elseif (!type eq 'FPLA') then
        !fullType = 'Flat Section Plane'
      elseif (!type eq 'PPLA') then
        !fullType = 'Perpendicular Section Plane'
      endif
      if (!oneToOne.not()) then
        !answer = !!alert.confirm('OK to delete the actual section plane ' & !elements[!value].queryDbref().name & ' ?')
        if (!answer.boolean().not()) then
          !sectionPlanes.remove(!elements[!value])
          skip
        endif
      endif
 --remove from the list before deleting from database
     !sectionPlanes.remove(!elements[!value])
     DELETE $!type
     handle ANY
       !!alert.error(!!error.text)
     endhandle
    enddo
    !!ce = !memory
    handle ANY
    endhandle
  elseif (!this.listPopup.pickedField eq 'Clipping') then
    if (!this.listPopup.selected('Clipping')) then
      do !value values !selectedSectionPlanes
        !elements[!value].setClipping(TRUE, !!dra3dView.currentDraftView)
      enddo
      !this.listPopup.setActive('Flip...', TRUE)
    else
      do !value values !selectedSectionPlanes
        !elements[!value].setClipping(FALSE, !!dra3dView.currentDraftView)
      enddo
      !this.listPopup.setActive('Flip...', FALSE)
    endif
  elseif (!this.listPopup.pickedField eq 'Flip...') then
    do !value values !selectedSectionPlanes
    !!test = !elements[!value]
      !elements[!value].switchClipSide(!!dra3dView.currentDraftView)
    enddo
  elseif (!this.listPopup.pickedField eq 'Highlight Clip List') then
    -- Only 1 selection allowed
    if (!selectedSectionPlanes.size() gt 1) then
      !!alert.error('One selection allowed only for this option')
      return
    endif
    if (!this.listPopup.selected('Highlight Clip List')) then
      -- Unenhance all
      -- DESUNENHANCE ALL
      !this.clipColours()
      !colour = object COLOUR(!this.clipColourMember)
      do !value values !selectedSectionPlanes
        !elements[!value].showClipItems(!!dra3dView.currentDraftView, !colour)
      enddo
    else
      do !value values !selectedSectionPlanes
        !elements[!value].unShowClipItems(!!dra3dView.currentDraftView)
      enddo
    endif
  elseif (!this.listPopup.pickedField eq 'Translucency') then
    if (!this.listPopup.selected('Translucency')) then
      do !value values !selectedSectionPlanes
        !elements[!value].translucency(50)
      enddo
    else
      do !value values !selectedSectionPlanes
        !elements[!value].translucency(0)
      enddo
    endif
  elseif (!this.listPopup.pickedField eq 'Refresh...') then
    do !value values !selectedSectionPlanes
      !elements[!value].redraw(!!dra3dView.currentDraftView)
    enddo
  endif

  -- Refresh the collection/gadget
  !this.collectSections()

  -- Try to select same again
  !this.list.clearSelection()
  !this.list.val = !selectedSectionPlanes
  handle ANY
  endhandle

  -- Do a refresh because buttons active may need updating
  !this.refresh()

endmethod
-- End of method
---------------------------------------------------------------------------------
--
-- Method:      colours
--
-- Description:    Highlighting colours
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .colours()

  -- Type of Colour to be changed
  !command   = '!!dra3dViewSections.chosenCol()'
  !title     = 'Section Plane Colour'

  -- Current Background colour
  !refColour = !this.colourMember

  -- Display colour selection form
  call !!colourSelectLoad(!command, !title, !refColour)

endmethod
-- End of method definition for .colours()
------------------------------------------------------------------------
--
-- Method:      chosenCol
--
-- Description:  Chosen Colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .chosenCol()

    !this.colourMember = !!colourSelect.setColour

    !this.setColour()

endmethod
-- End of method definition for .chosenCol()
------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description:    Set colour of section plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .setColour()

  -- Initialise variables
  --Array of selected section
  !selectedSectionPlanes = !this.list.val
  !selectedSectionPlanes = !selectedSectionPlanes.sort().invert()

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !elements = !sectionPlanes.query()

  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
    -- ???????? may wish to also hide form or similar.
  endhandle

  do !value values !selectedSectionPlanes
    !elements[!value].colour(!this.colourMember)
  enddo

  -- Refresh the collection/gadget
  !this.collectSections()

  -- Try to select same again
  !this.list.clearSelection()
  !this.list.val = !selectedSectionPlanes
  handle ANY
  endhandle

endmethod
-- End of method definition for .setColour()
------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: show a modify form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modify(!element is DBREF)

  if (!element.type eq 'FPLA') then
    -- Flat plane form
    -- was CALLDRG XPLANE _CDRMFPLANE
   !file = object FILE('%PDMSUI%/DRA/GEN/XPLANE')
   !!runMacro(!file.fullname() , '_CDRMFPLANE')
  elseif (!element.type eq 'PPLA') then
    -- Stepped plane form
    -- was CALLDRG XPLANE _CDRMPPLANE
   !file = object FILE('%PDMSUI%/DRA/GEN/XPLANE')
   !!runMacro(!file.fullname() , '_CDRMPPLANE')
  else
    -- Stepped plane form
    -- was CALLDRG XPLANE _CDRMSPLANE
   !file = object FILE('%PDMSUI%/DRA/GEN/XPLANE')
   !!runMacro(!file.fullname() , '_CDRMSPLANE')
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: show a create form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

  !memory = !!ce

  -- Create a standard plane at view through position
  --  !spm = object SECTIONPLANEMANAGER()
  -- Gather argument details to pass to create method
  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    !!alert.error('View not available.')
    return
  endhandle

  !libraryName = !!dra3dView.formTitle.after('3D View - ').before('*') & '/PLANES'
  !standardLibrary = object DBREF(!libraryName)
  handle ANY
    -- Go to view owner and collect all pllb for CE and use first PLLB found.
    -- if none then create a new PLLB to use.
    !!ce = !view
    end
    var !planeLibraries COLLECT ALL (PLLB) FOR CE
    if (!planeLibraries.size() gt 0) then
      !standardLibrary = !planeLibraries[1].dbref()
    else
      !!ce = !view
      NEW PLLB $!libraryName
      !standardLibrary = !!ce
    endif
  endhandle

  -- New name
  do !i from 1 to 10
    !newName = !!dra3dView.formTitle.after('3D View - ').before('*') & '/SP' & !i.string()
    !unusedTestName = object DBREF(!newName)
    handle (2,109)
      -- undefined name error - OK use it
      break
    elsehandle ANY
      !!alert.error(!!error.text)
      return
      break
    elsehandle NONE
      -- Name already used loop round again
    endhandle
  enddo

  !scale = !view.vscale
  !size = !view.size[1]
  !position1 = !view.thpos
  !position1.east = (!position1.east - ((!size / 2) / !scale) - ((!size * 0.05) / !scale))
  !position2 = !view.thpos
  !position2.east = (!position2.east + ((!size / 2) / !scale) + ((!size * 0.05) / !scale))
--  !direction = object DIRECTION('U')
--  !spm.createSPLA(!newName, !libraryName, !position1,  !position2, !direction)
  -- ------------------------------------------------------------------------------------
  -- Above line did not work on demo laptop so use this instead
  !!ce = !standardLibrary
  new spla $!newName
  direction u
  new wpos
  !pos1string = !position1.wrt(/* )
  pos $!pos1string
  new wpos
  !pos2string = !position2.wrt(/* )
  pos $!pos2string
  -- ------------------------------------------------------------------------------------

  -- This bit is needed because .createSPLA is not naming the element as it should???????
--  !!ce = !libraryName.dbref()
--  1 SPLA
--  if (!!ce.isnamed.not()) then
--    NAME $!newName
--  endif

  -- Go to the view and create a VSEC
  !!ce = !view
  !vsecName = !newName & '/VSEC'
  NEW VSEC $!vsecName
  PLRF $!newName
--  PLRF $!PLRF
--  IDLN $_IDLI
--  PMODE $_PMODE
  !reference = !!ce.plrf.reference.string()
  !newSectionPlane = object SECTIONPLANE(!!ce.plrf.reference)
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !sectionPlanes.add(!newSectionPlane)

  -- Refresh the form
  !this.collectSections()

  -- Select the newly created section Plane
  !this.list.clearSelection()
  !this.list.select('rtext', !reference)
  !this.setActives()

  -- Show clipping teeth or not
  !this.clipSectionPlanes()

  -- Highlight the new element
  !element = object SECTIONPLANE(!reference.dbref())
  !element.highlight()

  !!ce = !memory

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !sectionPlanes.clear()

  -- Erase from 2d sketch
   ERASE PLANE IN $!!dra3dView.currentDraftView

  if (!!dra3dview.shown()) then
    !!dra3dview.appwareSP.val = FALSE
  endif

  -- hide form
  !!dra3dViewSections.hide()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setClipList
--
-- Description: call back if clip list option gadget selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setClipList()

  !this.activateIdListGadgets()

  if (!this.idli.selection('rtext') eq 'Refresh') then

    -- Populate the idli gadget with /* and all idli of drawing element
    !dtext = ARRAY()
    !rtext = ARRAY()
    !dtext.append('World (/*)')
    !rtext.append('/*')
    !drawingName = !!dra3DView.currentDraftView.owner.owner
    var !collection collect all (IDLI) for $!drawingName
    do !i indices !collection
      !element = object DBREF(!collection[!i])
      !dtext.append(!element.name)
      !rtext.append(!collection[!i])
    enddo
    !this.idli.dtext = !dtext
    !this.idli.rtext = !rtext

    !this.activateIdListGadgets()

  else
    -- Set the drawlist ref

    --Array of selected section
  !selectedSectionPlanes = !this.list.val
  !selectedSectionPlanes = !selectedSectionPlanes.sort().invert()

    -- Set up the section planes object
    !sectionPlanes = object SECTIONPLANEMANAGER()
    !elements = !sectionPlanes.query()

    !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
    handle ANY
      return
      -- ???????? may wish to also hide form or similar.
    endhandle
    -- Only 1 selection allowed
    if (!selectedSectionPlanes.size() gt 1) then
      !!alert.error('One selection allowed only for this option')
      return
    endif
    do !value values !selectedSectionPlanes
      -- try to get the VSEC for the SPLA
      !vsec = !this.getVSEC(!elements[!value].queryDbref())
      !!ce = !vsec[1].dbref()
      handle ANY
        !!alert.warning('This section plane has no VSEC')
        return
      endhandle
      !idln = !this.idli.selection('rtext')
      if (!this.idli.selection('rtext').dbref().type eq 'IDLI') then
        !this.clipList = !this.idli.selection('rtext').dbref()
      else
        !this.clipList = object DBREF()
      endif
      IDLN $!idln
      handle ANY
        !!alert.error(!!error.text)
      endhandle
    enddo

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showIdlist
--
-- Description: call back if clip list option gadget selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showIdlist()

    !drawingName = !!dra3DView.currentDraftView.owner.owner
    -- get the first DLLB and create in there
    var !drawlist collect all DLLB for $!drawingName
    !!ce = !drawlist[1].dbref()
    handle ANY
      !!alert.error('No library available to for creation of new idlist.')
      return
    endhandle
     -- Drawlist create form
     -- was CALLDRG XDRAWLIST CREATE
    !file = object FILE('%PDMSUI%/DRA/GEN/XDRAWLIST')
    !element = !this.idli.selection('rtext')
    if (!element.dbref().type eq 'IDLI') then
      !!runMacro(!file.fullname() , 'MODIFY $!element')
    else
      !!runMacro(!file.fullname() , 'MODIFY')
    endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Add element to the clip idlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewAdd()

  !memory = !!ce

  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Addition to section clipping list')
  !undo.undoAction('')
  !undo.redoAction('')
  !undo.add()

  -- Capture the idList of the current view VSEC
  if (!this.clipList.set() and !this.clipList.type eq 'IDLI') then
    !idli = object IDLIST(!this.clipList)
  endif

  -- Let's find out if there is a selection selected, if so we will add that.
  !s = object SELECTION()
  !s.getCurrent()
  if (!s.getSelection().size() gt 0) then
    !idli.add(!s)
    -- Call this same method for each element
    do !i indices !s.getSelection()
      !this.viewAdd(!s.getSelection()[!i])
    enddo
  else
    if (TYPE eq 'WORL') then
      --!!alert.error('Cannot add world to idList')
      --return
    endif
    -- Make sure we are adding the design element
    if (dbtype neq 'DESI') then
      switch
    endif
    !idli.add(!!ce)
    handle any
      !!alert.message('Please Reselect the Drawlist in the Clipping List Option and try Again.')
      return
    endhandle
    !test = !this.viewAdd(!!ce)
    -- Only want to do this if viewAdd(!!ce) was completed
    if (!test.not()) then
      !idli.remove(!!ce)
    endif
  endif
  -- Clear the selection
  !s.clear()
  !s.setCurrent()

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      viewAdd
--
-- Description: Add element to the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF     Element to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewAdd(!addItem is DBREF) is BOOLEAN

  -- First check we are in the correct DB
  if (!addItem.dbtype neq 'DESI') then
    switch
  endif

  -- Capture the passed dbref or it could be change owing to pass by reference
  !element = !addItem

  -- Don't add the world
  if (!element.type eq 'WORL') then
    !answer = !!alert.confirm('Are you sure you want to add the world?')
    if (!answer.boolean().not()) then
      return FALSE
    endif
  endif

  if(!element.signif) then
    !this.opList.append('ADD')
    !this.refList.append(!!ce)
    !this.originList.append('3D')
  else
    if(!element.owner.type eq 'WORL') then
      return FALSE
    endif
    -- Looks like this will loop round this method until a significant element is found and added.
    !this.viewAdd(!element.owner)
    handle any
    endhandle
  endif

  return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      viewRem
--
-- Description: Remove element from the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewRem()

  !memory = !!ce

  -- First check we are in the correct DB
  if (dbtype neq 'DESI') then
    switch
  endif

  -- Mark the database for Undo functionality.
  !undo = object UNDOABLE()
  !undo.description('Removal from section clipping list')
  !undo.undoAction('')
  !undo.redoAction('')
  !undo.add()

  -- Capture the idList of the current view VSEC
  if (!this.clipList.set() and !this.clipList.type eq 'IDLI') then
    !idli = object IDLIST(!this.clipList)
  endif

  -- Let's find out if there is a selection selected, if so we will remove that.
  !s = object SELECTION()
  !s.getCurrent()
  if (!s.getSelection().size() gt 0) then
    -- Call this same method for each element
    do !i indices !s.getSelection()
      !this.viewRem(!s.getSelection()[!i])
    enddo
    !idli.remove(!s)
  else
    if (TYPE eq 'WORL') then
      !this.viewRemAnswer = !!alert.confirm('Remove all from this Idlist?').boolean()
      if (!this.viewRemAnswer.boolean()) then
        !idli.clear()
        handle any
          return
        endhandle
      else
        return
      endif
    endif
    -- Make sure we are adding the design element
    if (dbtype neq 'DESI') then
      switch
    endif
    !idli.remove(!!ce)
    !test = !this.viewRem(!!ce)
    -- Only want to do this if viewRem(!!ce) was completed
    if (!test.not()) then
      !idli.add(!!ce)
    endif
  endif
  -- Clear the selection
  !s.clear()
  !s.setCurrent()

  -- Mark the database for End of the Undo function.
  !undo.endUndoable()
  handle ANY
  endhandle

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      viewRem
--
-- Description: Remove element from the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      Element to be removed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewRem(!remItem is DBREF) is BOOLEAN

  -- First check we are in the correct DB
  if (!remItem.dbtype neq 'DESI') then
    switch
  endif

  -- Capture the passed dbref or it could be change owing to pass by reference
  !element = !remItem

  -- Remove the world
 if (TYPE eq 'WORL') then
   if !this.viewRemAnswer.unset() then
     !answer = !!alert.confirm('Remove all from this Idlist?')
     if (!answer.boolean()) then
       !idli = object IDLIST(!this.clipList)
       !idli.clear()
     else
       return FALSE
     endif
   else
     !this.viewRemAnswer = object BOOLEAN()
     return FALSE
   endif
 endif

  if(!element.signif) then
    !this.opList.append('REM')
    !this.refList.append(!!ce)
    !this.originList.append('3D')
  else
    if(!element.owner.type eq 'WORL') then
      return FALSE
    endif
    !this.viewRem(!element.owner)
    handle any
    endhandle
  endif

  return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      buildLocalidList
--
-- Description: Get the idList of the selected view section
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Section element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildLocalidList(!section is DBREF)

  if (!section.unset()) then
    return
  endif

  -- Get all VIEWs
  !collection = ARRAY()
  !vsec = object DBREF()

  -- Build drawlist
  !this.refList.clear()
  !this.opList.clear()
  !this.originList.clear()

  !this.currentSection = !section
  !vsecArray = !this.getVSEC(!section)
  !vsec = !vsecArray[1].dbref()
  handle ANY
  endhandle

  -- Get drawlist from the view
  if (!vsec.idln.unset() or (!vsec.idln.set() and !vsec.idln.badref())) then
    !!alert.warning('No idList')
    return
  endif
  !idliRefe = !vsec.idln
  !this.draScanIdli(!idliRefe)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      draScanIdli
--
-- Description: Scan the ID list and add to member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       ID list element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draScanIdli(!idliRefe is DBREF)

  if (!idliRefe.type eq 'WORL') then
    return
  endif

  -- This will give us ADDE's and REME's of the IDLI pointed to by the View's IDLN attribute.
  !idList = !idliRefe.members

  -- Loop through each idList member, adding its elements to the return list
  do !item values !idList
    !this.addRemScan(!item)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      addRemScan
--
-- Description: function to find out if the passed ADDE or REME is a valid DESI one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF      ADDE or REME element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addRemScan(!element is DBREF)

  -- Do this to avoid passing by reference
  !itemRef  = !element

  if (!itemRef.idname.set() and !itemRef.idname.badref()) then
    -- This is possible if the design extract contents has not been issued by other user
    var !name idname of $!itemRef
  elseif (!itemRef.idname.set() and !itemRef.idname.dbtype eq 'PADD') then
    -- Must be an idList
    -- Commented out good code because it is probably not what is required. (Was nested idList)
    --    !!ce = !itemRef.idname
    --    var !addRems collect all (ADDE REME) for ce
    --    do !i indices !addRems
    --      !this.addRemScan(!addRems[!i].dbref())
    --      return
    --    enddo
    -- Replaced with:
    !name = !itemRef.idname.fullname
  elseif (!itemRef.idname.unset()) then
    --!name = !itemRef.criteria
    var !name criteria of $!itemRef
  else
    !name = !itemRef.idname.fullname
  endif

  -- Added elements
  if(!itemRef.type.upcase().eq('ADDE')) then
    !operation = 'ADD '
  -- Removed elements
  else
    !operation = 'REM '
  endif

  !this.refList.append(!itemRef)
  !this.opList.append(!operation)
  !this.originList.append('2D')

endmethod
----------------------------------------------------------------------
--
-- Method:      setActives
--
-- Description: Check to right gadget are active dependent on section planes list selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActives()

  -- Got to select the idln of the current section plane
  --Array of selected section planes
  !selectedSectionPlanes = !this.list.val
  !selectedSectionPlanes = !selectedSectionPlanes.sort().invert()

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !elements = !sectionPlanes.query()

  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
  endhandle

  do !value values !selectedSectionPlanes
    -- try to get the VSEC for the SPLA
    !vsec = !this.getVSEC(!elements[!value].queryDbref())
    !!ce = !vsec[1].dbref()
    handle ANY
      !this.idli.select('rtext', '/*')
    endhandle
    if (!!ce.idln.type eq 'WORL') then
      !this.idli.select('rtext', '/*')
    else
      !this.idli.select('rtext', !vsec[1].dbref().idln.string())
      handle ANY
      endhandle
    endif
  enddo

  !this.activateIdListGadgets()

  -- Update the status of the pop-up menu
  if ((!this.list.val.size() eq 0) or (!this.list.rtext.size() eq 0)) then
    -- inactivate all menu options
    !this.listPopup.setActive('Modify...', FALSE)
    !this.listPopup.setActive('Redefine Points...', FALSE)
    !this.listPopup.setActive('Highlight...', FALSE)
    !this.listPopup.setActive('Visibility', FALSE)
    !this.listPopup.setActive('Delete...', FALSE)
    !this.listPopup.setActive('Clipping', FALSE)
    !this.listPopup.setActive('Flip...', FALSE)
    !this.listPopup.setActive('Highlight Clip List', FALSE)
    !this.listPopup.setActive('Colour...', FALSE)
    !this.listPopup.setActive('Translucency', FALSE)
  else
    -- activate all menu options
    if (!this.list.val.size() gt 1) then
      !this.listPopup.setActive('Modify...', FALSE)
      !this.listPopup.setActive('Redefine Points...', FALSE)
      !this.listPopup.setActive('Highlight...', FALSE)
      !this.listPopup.setActive('Highlight Clip List', FALSE)
    else
      !this.listPopup.setActive('Modify...', TRUE)
      !this.listPopup.setActive('Redefine Points...', TRUE)
      !this.listPopup.setActive('Highlight...', TRUE)
      !this.listPopup.setActive('Highlight Clip List', TRUE)
    endif
    !this.listPopup.setActive('Visibility', TRUE)
    !this.listPopup.setActive('Delete...', TRUE)
    !this.listPopup.setActive('Clipping', TRUE)
    !this.listPopup.setActive('Flip...', TRUE)
    !this.listPopup.setActive('Colour...', TRUE)
    !this.listPopup.setActive('Translucency', TRUE)
    -- get the clip value of the first selected plane
    !this.listPopup.select('Clipping', !elements[!selectedSectionPlanes[!selectedSectionPlanes.size()]].queryClip(!!dra3dView.currentDraftView))
    if (!elements[!selectedSectionPlanes[!selectedSectionPlanes.size()]].queryClip(!!dra3dView.currentDraftView).not()) then
      !this.listPopup.setActive('Flip...', FALSE)
    endif
    !this.listPopup.select('Visibility', !elements[!selectedSectionPlanes[!selectedSectionPlanes.size()]].queryShow())
    !this.listPopup.select('Translucency', !elements[!selectedSectionPlanes[!selectedSectionPlanes.size()]].queryTranslucency().boolean())
    !this.listPopup.select('Highlight Clip List', !elements[!selectedSectionPlanes[!selectedSectionPlanes.size()]].queryClipShown().boolean())
  endif

  -- Update the 2 d section plane form if shown
  call !!draUpdate2dSectionSketch()

endmethod
----------------------------------------------------------------------
--
-- Method:      getVSEC
--
-- Description: get the vsec for the section planes list selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--     ARRAY      Array of dbrefs strings referencing passed dbref for current view
--
------------------------------------------------------------------------
define method .getVSEC(!section is DBREF) is ARRAY

  !memory = !!ce
  !result = ARRAY()
  !this.formTitle = 'Section Planes - ' & !!dra3dView.formTitle.after('3D View - ').before('*')

  !view = object DBREF(!!dra3dView.formTitle.after('3D View - ').before('*'))
  handle ANY
    return
  endhandle

  !!ce = !view
  var !collection collect all (VSEC) for ce
  do !i indices !collection
    -- Check if the collection element references the section plane
    if (!collection[!i].dbref().plrf eq !section) then
      !result.append(!collection[!i])
    endif
  enddo

  !!ce = !memory
  return !result

endmethod
----------------------------------------------------------------------
--
-- Method:      activateIdListGadgets
--
-- Description: Activate the IdList Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activateIdListGadgets()

  if (!this.list.val.size() eq 1) then
    !this.idList.active    = TRUE
    !this.desAdd.active    = TRUE
    !this.desRem.active    = TRUE
    !this.idli.active      = TRUE
    !this.currentSection = !this.list.selection('rtext')[1].dbref()
    !this.formPopup.setActive('Clipping List...', TRUE)
    !this.formPopup.setActive('Add to Clipping List', TRUE)
    !this.formPopup.setActive('Remove from Clipping List', TRUE)
  else
    !this.idList.active    = FALSE
    !this.desAdd.active    = FALSE
    !this.desRem.active    = FALSE
    !this.idli.active      = FALSE
    !this.currentSection = object DBREF()
    !this.formPopup.setActive('Clipping List...', FALSE)
    !this.formPopup.setActive('Add to Clipping List', FALSE)
    !this.formPopup.setActive('Remove from Clipping List', FALSE)
  endif
  if (!this.idli.selection('rtext') eq '/*') then
    !this.desAdd.active = FALSE
    !this.desRem.active = FALSE
    !this.currentSection = object DBREF()
    !this.formPopup.setActive('Add to Clipping List', FALSE)
    !this.formPopup.setActive('Remove from Clipping List', FALSE)
  endif

endmethod
----------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh the clip list Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

    -- Populate the idli gadget with /* and all idli of drawing element
    !dtext = ARRAY()
    !rtext = ARRAY()
    !dtext.append('World (/*)')
    !rtext.append('/*')
    !drawingName = !!dra3DView.currentDraftView.owner.owner
    var !collection collect all (IDLI) for $!drawingName
    do !i indices !collection
      !element = object DBREF(!collection[!i])
      !dtext.append(!element.name)
      !rtext.append(!collection[!i])
    enddo
    !this.idli.dtext = !dtext
    !this.idli.rtext = !rtext

    !this.setActives()

endmethod
------------------------------------------------------------------------
--
-- Method:      clipSectionPlanes
--
-- Description: Callback on the appwareSP toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clipSectionPlanes()

  !sectionPlanes = object SECTIONPLANEMANAGER()
  if (!this.clipSP.val) then
    !sectionPlanes.showClipping(TRUE, !!dra3dView.currentDraftView)
  else
    !sectionPlanes.showClipping(FALSE, !!dra3dView.currentDraftView)
  endif

endmethod
---------------------------------------------------------------------------------
--
-- Method:      clipColours
--
-- Description:    Highlighting colours
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .clipColours()

  -- Type of Colour to be changed
  !command   = '!!dra3dViewSections.clipChosenCol()'
  !title     = 'Highlight Clipping Colour'

  -- Current Background colour
  !refColour = !this.clipColourMember

  -- Display colour selection form
  call !!colourSelectLoad(!command, !title, !refColour)

endmethod
---------------------------------------------------------------------------------
--
-- Method:      clipChosenCol
--
-- Description:  Chosen Clip Colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .clipChosenCol()

  -- Unenhance all
  -- DESUNENHANCE ALL

  --Array of selected section
  !selectedSectionPlanes = !this.list.val
  !selectedSectionPlanes = !selectedSectionPlanes.sort().invert()

  -- Set up the section planes object
  !sectionPlanes = object SECTIONPLANEMANAGER()
  !elements = !sectionPlanes.query()

  !this.clipColourMember = !!colourSelect.setColour
  !colour = object COLOUR(!this.clipColourMember)
  do !value values !selectedSectionPlanes
    !elements[!value].showClipItems(!!dra3dView.currentDraftView, !colour)
  enddo

  -- Now check we are in the correct DB
  if (dbtype neq 'PADD') then
    switch
  endif

endmethod
