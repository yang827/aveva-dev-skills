--
--
-- Description:
-- Form to view the clipping contents
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  chosenCol()                      -                   Chosen Colour
--  close()                          -                   close the form
--  colours()                        -                   Highlighting colours
--  dra3dViewSectionsIdList()        -                   Constructor
--  highlight()                      -                   Enhance elements
--  removeElement()                  -                   Remove selected ADDE or REME from list
--  update()                         -                   Update the view of the idList
--
setup form !!dra3dViewSectionsIdList dialog dock top

  !this.formTitle = 'Section Plane Clipping List'

  button .highlightButton '  '   at x0 y0   tooltip 'Highlight List Colour'  callback '!this.colours()'
  toggle .highlight 'Highlight' at xmax+1 ymin callback '!this.highlight()'

  list .idList anchor all at x0 ymax+0.3 multi width 45 length 16

  menu .poppy
    add |Remove Selected|    |!this.removeElement()|
  exit

  member .currentSection is DBREF
  member .form           is FORM

  -- Local copy of Section idList
  member .opList                is ARRAY
  member .refList               is ARRAY
  member .originList            is ARRAY

   -- Highlight Colours
  member .colourMember          is REAL

exit
------------------------------------------------------------------------
--
-- Method:      dra3dViewSectionsIdList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dra3dViewSectionsIdList()

  -- Set a default colour for highlighting
  if (!this.colourMember.unset() ) then
    !this.colourMember = 246
    !this.highlightButton.background = 246
  endif

  !this.currentSection = object DBREF()
  !this.form = !!dra3dViewSections

  !this.idList.setPopUp(!this.poppy)

  !this.cancelCall = '!this.close()'

endmethod
-- End of method
------------------------------------------------
--
-- Method:      colours
--
-- Description:    Highlighting colours
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .colours()

  -- Type of Colour to be changed
  !command   = '!!dra3dViewSectionsIdList.chosenCol()'
  !title     = 'Highlight Colour'

  -- Current Background colour
  !refColour = !this.colourMember

  -- Display colour selection form
  call !!colourSelectLoad(!command, !title, !refColour)

endmethod
-- End of method definition for .colours()
------------------------------------------------------------------------
--
-- Method:      chosenCol
--
-- Description:  Chosen Colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .chosenCol()

    !this.colourMember = !!colourSelect.setColour
    !this.highlightButton.background = !this.colourMember

    !this.highlight()

endmethod
-- End of method definition for .chosenCol()
------------------------------------------------------------------------
--
-- Method:      highlight
--
-- Description:    Enhance elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .highlight()

  if (!this.form.idli.selection('rtext') eq '/*') then

    if (!this.highlight.val) then
      desenhance all from drawlist colour $!this.colourMember
    else
      desunenhance all from drawlist
    endif

  else

    if (!this.highlight.val) then
      desunenhance all from drawlist
      do !i indices !this.form.refList
        if (!this.form.refList[!i].type eq 'ADDE') then
          !name = !this.form.refList[!i].idna
          desenhance $!name colour $!this.colourMember
          handle ANY
            -- Yes but what about points to idlist or rules
          endhandle
        endif
        if (!this.form.refList[!i].type eq 'REME') then
          !name = !this.form.refList[!i].idna
          desunenhance $!name
          handle ANY
          endhandle
        endif
      enddo
    else
      desunenhance all from drawlist
    endif

  endif

endmethod
-- End of method definition for .highlight()
------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update the view of the idList
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update()

  -- Initialise variables
  !this.idList.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()

  if (!this.form.idli.selection('rtext') neq '/*') then
    !this.setActive(TRUE)
  else
    !this.idList.clear()
    !dtext[1] = 'World'
    !this.idList.dtext = !dtext
    !this.setActive(FALSE)
    desunenhance all
    return
  endif

 -- Call the form build local idList method
 !this.form.buildLocalIdList(!this.form.currentSection)

  -- Loop through each idList member, adding its elements to the return list
  do !index indices !this.form.refList

    !itemRef  = !this.form.refList[!index]
    -- This could be a 3D origin or a 2D origin
    if (!this.form.originList[!index] eq '2D') then
      !test = !itemRef.idname.badref()
      handle ANY
        !test = TRUE
      endhandle
      if (!itemRef.idname.set()) then
        if (!test or !itemRef.idname.badref()) then
          !name = 'UNSET'
        else
          !name = !itemRef.idname.fullname
        endif
      elseif (!itemRef.criteria.set()) then
        -- This must be criteria based
        -- ?????????????? !!ce.criteria is an ARRAY? core bug DFN3686
        --!name = !itemRef.criteria
        var !name criteria of $!itemRef
      else
        -- Both idname and criteria must be unset
        !name = 'UNSET'
      endif
    elseif (!this.form.originList[!index] eq '3D') then
      !test = !itemRef.badref()
      handle ANY
        !test = TRUE
      endhandle
      if (!itemRef.set()) then
        if (!test or !itemRef.badref()) then
          !name = 'UNKNOWN'
        else
          !name = !itemRef.fullname
        endif
      endif
    endif
    --!dtext.append(!this.form.originList[!index] & ' - ' & !this.form.opList[!index] + ' ' + !name)!dtext.append(!this.form.originList[!index] & ' - ' & !this.form.opList[!index] + ' ' + !name)
    !dtext.append(!this.form.opList[!index] + ' ' + !name)
    !rtext.append(!itemRef.string())

  enddo

  !this.idList.dtext = !dtext
  !this.idList.rtext = !rtext

endmethod
------------------------------------------------------------------------
--
-- Method:      removeElement
--
-- Description: Remove selected ADDE or REME from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeElement()

  !memory = !!ce

  -- Simply delete the selected elements

  -- Get the elements to be deleted in sorted, inverted eg 3,2,1
  !toBeDeleted = !this.idList.val.sort().invert()
  !errorCount = 0
  !maxErrors = 3

  do !index values !toBeDeleted

    -- original element in DB to be deleted
    !item = !this.form.refList[!index]
    !!ce = !item
    handle ANY
      -- What if it is already deleted
    elsehandle NONE
      !type = !!ce.type
      -- Before we delete it capture its IDNA attribute
      !referencedElement = !!ce.idna
      if (!referencedElement.unset()) then
        -- Cannot delete a Criteria based element
        if (!errorCount le maxErrors) then
          !!alert.error('Cannot remove a criteria based element')
        else
          !!alert.error('More than ' & !maxErrors.string() & ' errors')
        endif
        !errorCount = !errorCount + 1
        skip
      else
        -- If this was a remove REME action we should add the referenced element back into the 3D view
        if (!type eq 'REME') then
          !!ce = !item
          delete $!type
          handle ANY
            if (!errorCount le maxErrors) then
              !!alert.error(!!error.text)
            else
              !!alert.error('More than ' & !maxErrors.string() & ' errors')
            endif
            !errorCount = !errorCount + 1
            skip
          elsehandle NONE
            !!ce = !referencedElement
          endhandle
        elseif (!type eq 'ADDE') then
          !!ce = !item
          delete $!type
          handle ANY
            if (!errorCount le maxErrors) then
              !!alert.error(!!error.text)
            else
              !!alert.error('More than ' & !maxErrors.string() & ' errors')
            endif
            !errorCount = !errorCount + 1
            skip
          elsehandle NONE
            !!ce = !referencedElement
          endhandle
        endif
      endif
    endhandle
  enddo

  -- Update this form ID list view
  !this.update()

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  if (!!dra3dViewSections.shown()) then
    !!dra3dViewSections.idList.val = FALSE
  endif

  -- hide the form
  !this.hide()

endmethod
-- End of method
