--
-- File:            draAssociationConfirm.pmlfrm
--   Type:          Form Definition
--
--   Module:        Draft
--
-- Author:          Katie Hannaford
-- Created:         23/08/2016
--
--
-- Description:     Confirmation dialog when associating a 2D View with a 3D or vice versa.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Callback on cancel button
--  draAssociationConfirm()          -                   Constructor method
--  init()                           -                   Form initialisation before showing
--  ok()                             -                   Callback on ok button
--
------------------------------------------------------------------------
setup form !!draAssociationConfirm dialog

  !this.formTitle  = 'Associate 2D View'
  !this.initCall   = '!this.init()'
  !this.cancelCall = '!this.cancel()'

  paragraph .text at x1 ymin+0.2 lines 2 width 38

  frame .frToggle '' at xmin ymax

    rtoggle .overwrite2D 'Overwrite the existing 2D content with the current 3D content' tagwidth 30 at x2 ymax
    rtoggle .overwrite3D 'Set the 3D content to display the existing 2D content'        tagwidth 30 at x2 ymax+0.5

  exit

  button    .ok  'Ok'  at xmin           ymax+0.5
  button    .cancel 'Cancel' at xmax form-size ymin

  member .form   is FORM

exit

------------------------------------------------------------------------
--
-- Method:      .draAssociationConfirm()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draAssociationConfirm()

  -- Form callbacks
  !this.ok.callback  = |!this.ok()|
  !this.cancel.callback = |!this.cancel()|

  -- Paragraph
  !this.text.val = 'The identified 2D view already has some existing content. Please select the action you wish to take;'

endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation before showing
--
-- Method Type: Procedure
-- Arguments:
--  1  R  BOOLEAN  True, if this is the first time the form is shown, otherwise False
-- Return:
--
------------------------------------------------------------------------
define method .init()

  -- Set the default choice
  !this.overwrite2D.val = true
  --!this.change = false

  !this.form = !!dra3dview
endmethod

------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: Callback on ok
--
-- Method Type: Function/Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------
define method .ok()

  --!originalIdList = object IDLIST(!this.form.currentDraftView.idln)
  if (!this.overwrite2D.val) then
     -- Empty the current idList +
     -- Update the idList for this view
     !this.form.viewUpdateIdList(!this.form.originalIdList)
  else
     -- capture the current view
     !this.form.initialise()
     -- If dynamic update then update design.
     if (!this.form.updateOption.selection('rtext') eq 'Dynamic') then
       -- Do we need to update
       !this.form.updateAndRefresh(FALSE)
     endif

     !this.hide()
     return
  endif

    -- Get the view type
  !this.form.getViewType()

  -- ????????????? Could be temporary just to centre the volume using auto
  !recordScale = !this.form.currentDraftView.vscale
  !this.form.scale()
  -- However use the template scale, unless it is equal to 1
  if (!recordScale neq 1) then
    !this.form.currentDraftView.vscale = !recordScale
  endif
  !this.form.setScaleGadget(!this.form.currentDraftView.vscale)

  -- Update the 3D view
  -- This first bit is just to square it up. We do not want it skewed
  !temp[1] = 0
  !temp[2] = 1
  !temp[3] = 0
  !this.form.view.direction = !temp
  !viewDirection = object DIRECTION(|$!this.form.currentDraftView.direction|)
  !temp[1] = !viewDirection.east
  !temp[2] = !viewDirection.north
  !temp[3] = !viewDirection.up
  !this.form.view.direction = !temp

  -- If dynamic update then update design.
  if (!this.form.updateOption.selection('rtext') eq 'Dynamic') then
    -- Do we need to update
    !this.form.updateAndRefresh(FALSE)
  endif

  -- Draw the new view frame
  !this.form.drawViewFrame(!this.form.currentDraftView.vscale)

  !!ce = !this.form.currentDraftView

  -- Set the modified star
  !!comModifyStar(!this.form, TRUE)

  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Callback on ok
--
-- Method Type: Function/Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------
define method .cancel()

  !this.hide()

endmethod
