--
-- File:            drachangerule.pmlfrm
--   Type:          Form Definition
--   Group:         Change Representation
--     Keyword:     CHANGE
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Change Ruleset Creation and Modification
--
------------------------------------------------------------------------
setup form !!draChangeRule at xr0 yr0

  !this.formTitle = 'Change Representation Rules'
  !this.initCall = '!this.formMethods.init()'
  !this.cancelCall = '!this.formMethods.dismiss()'

  -- Reset form for current element
  button .ce |CE| tooltip 'Current Element' call |!this.formMethods.ce()|

  -- Element name
  para .rplb at xmax+1 width 32 lines 1

  -- Rule sets
  para .crstPara at x0 ymax text |Rule Sets |
  option .crst at xmax ymin tooltip 'Select a Ruleset' call |!this.formMethods.ruleDisplay()| width 40

  -- Rules
  list .crul |Rules | at xmin ymax call |!this.formMethods.criteria()| single width 40 length 5
  para .createRule at x0 ymin+1 text |Create|
  option .createType at xmin ymax tooltip 'Create New Rule' call |!this.formMethods.createRule()| width 5
  button .deleteRule |Delete| at xmin ymax+0.2 tooltip 'Delete Selected Rule' call |!this.formMethods.deleteRule()|

  -- Criteria
  para .forPara at x0 ymax.crul+0.2 text |For|
  option .menu at xmax+3 ymin tooltip 'Choose an Element Type' call |!this.formMethods.newMenu()| width 21
  option .anno at xmax+1 ymin tooltip 'Annotation Code' width 19
  list .output || at xmin.crul ymax.menu+0.3 single width 40 length 3
  button .add |Add| at x0 ymin tooltip 'Add "For" Type to the List' call |!this.formMethods.modify('ADD')|
  button .rem |Remove| at xmin ymax+0.2 tooltip 'Remove List Entry' call |!this.formMethods.modify('REM')|
  button .clr |Clear| at xmin ymax+0.2 tooltip 'Clear the List' call |!this.output.clear()|

  -- With restriction
  para .withPara at x0 ymax text |With|
  text .with at xmin.crul ymin tooltip 'Set the "Selective" Rule(s)' call |!this.formMethods.checkWith()| width 42 STRING

  -- Style
  para .styleText at x0 ymax+0.2 text |Style    |
  para .style at xmin.crul ymin width 46 lines 1
  para .stylePara at x0 ymax+0.2 text |Styles|
  option .styLib at xmin.crul ymin tooltip 'Select a Style Library' call |!this.formMethods.stylDisplay()| width 40
  list .styles at xmin.crul ymax+0.25 call |!this.formMethods.setStyle()| single width 40 length 7

  -- Style display mode
  para .modText at x0 ymin text |Display|
  option .styMode at xmin ymax tooltip 'Style Display Mode' call |!this.formMethods.stylDisplay()| width 5

  -- Hatching display
  view .hatch at xmin+0.2 ymax+0.2 area
    height 3 aspect 1
    borders OFF
    cursor POINTER
    -- Set default view attributes
    $M "%PDMSUI%/DRA/CLIB/USETVIEW" $<AREA$> $<PENS$>
  exit

  -- Action
  button .apply |Apply| at xmin ymax.styles+0.5 tooltip 'Set the Attributes' call |!this.formMethods.apply()|
  button .dismiss |Dismiss| at xmax form-size ymin tooltip 'Close' call |!this.formMethods.dismiss()| cancel

  -- Members
  member .formMethods is DRACHANGERULE
  member .rplbRefe is DBREF
  member .crstRefe is DBREF
  member .crulRefe is DBREF
  member .ruleType is STRING
  member .formType is STRING

  -- Set form in object
  !this.formMethods.form = !this

  -- Populate create mode
  !dtext[1] = |Anno|
  !dtext[2] = |Desi|
  !rtext[1] = |ACRULE|
  !rtext[2] = |DCRULE|
  !this.createType.dtext = !dtext
  !this.createType.rtext = !rtext

-- End of form definition
exit
