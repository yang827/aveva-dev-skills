-- File:            dracolourpalette.pmlfrm
--   Type:          Form Definition
--   Group:         common
--     Keyword:     Colours and Styles
--   Module:        DRAFT
--
-- Author:          T.Lisowski
--  Created:         Tue Apr 24 18:05:44 2007
--
-- Description:
-- Colour palette presenting a set of standard PDMS colours to pick from
-- Works together with other forms containing the colour OPTION gadget
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buttonClick(GADGET,STRING)       -                   Open callback for selecting the button
--  draColourPalette()               -                   Constructor method
--  init()                           -                   INIT callback
--  quit()                           -                   QUIT callback
--
kill !!draColourPalette

setup form !!draColourPalette BLOCKINGDIALOG
  member .selectedColour is REAL $* ID of the selected colour, or -1 if not selected
  member .gadget is GADGET       $* colour OPTION gadget on the cooperating form
  member .para is GADGET         $* PARAGRAPH gadget on the cooperating form
  member .unsetGadget is GADGET  $* unassigned GADGET object

  hdist 0.2
  vdist 0.2
  path right
  !at = ''
  do !ind from 1 to 16
    var !colName colour $!ind
    button .btn$!ind | | $!at width 2 height 1 background $!ind callback '!this.buttonClick(' tooltip '$!colName ($!ind)'
  enddo
  line .sep at xmin_btn1 ymax anchor left+right HORIZONTAL height 1 width 51
  !col = 16
  do !ind from 17 to 271
    if( !col.eq(16) ) then
      !at = 'at xmin_btn1 ymax+0.2'
      !col = 0
    else
      !at = ''
    endif
    var !colName colour $!ind
    button .btn$!ind | | $!at width 2 height 1 background $!ind callback '!this.buttonClick(' tooltip '$!colName ($!ind)'
    !col = !col + 1
  enddo
exit
-- End of form definition for !!draColourPalette

------------------------------------------------------------------------
--
-- Method:      draColourPalette
--
-- Description: Constructor method
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draColourPalette()
  !this.formTitle = 'Colour palette'
  !this.initcall = '!this.init()'
  !this.quitcall = '!this.quit()'
  -- Unset GADGET object to unset the .gadget member, when needed
  !this.unsetGadget = object GADGET()
  -- Clear the form and gadget members (no cooperation with other forms!)
  !this.gadget = !this.unsetGadget
endmethod
-- End of method definition for .draColourPalette()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: INIT callback
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  !this.selectedColour = -1 $* colour has not been selected
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      buttonClick
--
-- Description: Open callback for selecting the button
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The button, that has been clicked
--   2  R  STRING  The action string
-- Return:
--
------------------------------------------------------------------------
define method .buttonClick(!gadget is GADGET, !dummyAction is STRING)
  -- Derive the selected colour from the button name
  !this.selectedColour = !gadget.name().substring(4).real()
  !sel = !this.selectedColour
  !colourOptionGadget = !this.gadget
  !this.hide()
  -- Clear gadget, forcing it to be redefined on the next use
  !this.gadget = !this.unsetGadget

  -- Return, if no cooperating form has been defined or no selection has been made
  if( unset(!colourOptionGadget) or !sel.lt(0) ) then
    return
  endif

  -- Update the cooperating form's selection of the colour
  !!draColStyle.selectColour(!colourOptionGadget, !this.para, !sel)
endmethod

------------------------------------------------------------------------
--
-- Method:      quit
--
-- Description: QUIT callback
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .quit()
  -- Clear gadget, forcing it to be redefined on the next use
  !this.gadget = !this.unsetGadget
endmethod
