--
--
-- Description:
-- New Dimensioning Toolbar
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel
--  draCrDims3()                     -
--  setFromTo(GADGET)                -                   Set the picking selection for the gadget clicked
--  whatIsSelected(GADGET)           ARRAY               Find out what is selected for picking
--
------------------------------------------------------------------------
-- Define form
setup form !!draCrDims3 dialog    dock

-- members on the form
   member .iconSize is REAL

-- initialise variables
   !bs    = 8  $* buttonSize
   !space = 1.4

-- create a tabbed frame
   path down
   !framePos = 'at xmin ymin width 22 height 5'
   frame .tabSet tabset at xmin ymax+0.2
    frame .linear  'Linear' $!framePos
      button .hlDim1   at ymin+0.5 pix   width $!bs height $!bs
      button .hlDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .hlDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .hlDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .hlDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      button .vlDim1   at xmin_hldim1 ymin+1 pix   width $!bs height $!bs
      button .vlDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .vlDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .vlDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .vlDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      button .tlDim1   at xmin_hldim1 ymin+1 pix   width $!bs height $!bs
      button .tlDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .tlDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .tlDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .tlDim5   at xmax+$!space ymin pix   width $!bs height $!bs
    exit

    frame .angular  'Angular'    $!framePos
      --if(defined(!!cdDimCreate) and !!cdDimCreate.empty().not()) then
      button .aDim1   at xmin_hlDim1 ymin+0.5 pix   width $!bs height $!bs
      button .aDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .aDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .aDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .aDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      --endif
    exit

    frame .radial   'Radial' $!framePos
      --if(defined(!!cdDimCreate) and !!cdDimCreate.empty().not()) then
      button .dDim1   at xmin_aDim1 ymin+0.5 pix   width $!bs height $!bs
      button .dDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .dDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .dDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .dDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      button .popup1  at xmax+$!space ymin pix   width 4 height $!bs
      button .rDim1   at xmin_dDim1 ymax_dDim5+0.5 pix       width $!bs height $!bs
      button .rDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      para .pickTypeR   at   xmin_dDim1 ymax+0.5 width 12
      --endif
    exit

    frame .pitchCircle   'P.C.D' $!framePos
      --if(defined(!!cdDimCreate) and !!cdDimCreate.empty().not()) then
      button .pdDim1   at xmin_rDim1 ymin+0.5 pix   width $!bs height $!bs
      button .pdDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .pdDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .pdDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .pdDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      button .popup3   at xmax+$!space ymin pix   width 4 height $!bs
      button .rdDim1   at xmin_dDim1 ymax_pdDim5+0.5 pix       width $!bs height $!bs
      button .rdDim2   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rdDim3   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rdDim4   at xmax+$!space ymin pix   width $!bs height $!bs
      button .rdDim5   at xmax+$!space ymin pix   width $!bs height $!bs
      para .pickTypeP   at  xmin_dDim1 ymax+0.5 width 16
      --endif
    exit
   exit
exit
-- End of form definition for !!draCrDims3
------------------------------------------------------------------------
--
-- Method:      dracrdims3()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draCrDims3()

-- form setup
   !this.formTitle       = 'Dimensions'
   !this.iconTitle       = 'DIMS'
   !this.cancelCall      = '!this.cancel()'
   !this.formRevision    = ' $Revision: 1.4 $ '
   !iconSize             = 16
   !this.iconSize        = 16

-- define all buttons with icons
   do !i to 5
     !this.hlDim$!i$n.addpixmap(!!dimensionDefinitions.horizontals[!i].icon & !iconSize & '.png')
     !this.hlDim$!i$n.callback = !!dimensionDefinitions.horizontals[!i].callback
     !this.hlDim$!i$n.setToolTip(!!dimensionDefinitions.horizontals[!i].description)
   enddo

   do !i to 5
     !this.vlDim$!i$n.addpixmap(!!dimensionDefinitions.verticals[!i].icon & !iconSize & '.png')
     !this.vlDim$!i$n.callback = !!dimensionDefinitions.verticals[!i].callback
     !this.vlDim$!i$n.setToolTip(!!dimensionDefinitions.verticals[!i].description)
   enddo

   do !i to 5
     !this.tlDim$!i$n.addpixmap(!!dimensionDefinitions.slopes[!i].icon & !iconSize & '.png')
     !this.tlDim$!i$n.callback = !!dimensionDefinitions.slopes[!i].callback
     !this.tlDim$!i$n.setToolTip(!!dimensionDefinitions.slopes[!i].description)
   enddo

   do !i to 5
     !this.aDim$!i$n.addpixmap (!!dimensionDefinitions.angles[!i].icon & !iconSize & '.png')
     !this.aDim$!i$n.callback  = !!dimensionDefinitions.angles[!i].callback
     !this.aDim$!i$n.setToolTip (!!dimensionDefinitions.angles[!i].description)
   enddo

   do !i to 5
     !this.dDim$!i$n.addpixmap (!!dimensionDefinitions.diameters[!i].icon & !iconSize & '.png')
     !this.dDim$!i$n.callback  = !!dimensionDefinitions.diameters[!i].callback & ' ' & '!!draCrDims3.popup1'
     !this.dDim$!i$n.setToolTip (!!dimensionDefinitions.diameters[!i].description)
   enddo
     !this.popup1.addpixmap('%PDMSUI%\icons\zzz\popup' & !iconSize & '.png')

   do !i to 5
     !this.rDim$!i$n.addpixmap (!!dimensionDefinitions.radii[!i].icon & !iconSize & '.png')
     !this.rDim$!i$n.callback  = !!dimensionDefinitions.radii[!i].callback & ' '  & '!!draCrDims3.popup1'
     !this.rDim$!i$n.setToolTip (!!dimensionDefinitions.radii[!i].description)
   enddo

   do !i to 5
     !this.pdDim$!i$n.addpixmap(!!dimensionDefinitions.pcds[!i].icon & !iconSize & '.png')
     !this.pdDim$!i$n.callback = !!dimensionDefinitions.pcds[!i].callback & ' ' & '!!draCrDims3.popup3'
     !this.pdDim$!i$n.setToolTip(!!dimensionDefinitions.pcds[!i].description)
   enddo
     !this.popup3.addpixmap('%PDMSUI%\icons\zzz\popup' & !iconSize & '.png')

   do !i to 5
     !this.rdDim$!i$n.addpixmap(!!dimensionDefinitions.pcrs[!i].icon & !iconSize & '.png')
     !this.rdDim$!i$n.callback = !!dimensionDefinitions.pcrs[!i].callback & ' '& '!!draCrDims3.popup3'
     !this.rdDim$!i$n.setToolTip(!!dimensionDefinitions.pcrs[!i].description)
   enddo

-- define popup menu for ddim/rdim button for selecting form ITEM or POINT
   !menu1 = !this.newMenu('PickOnR1')
   !menu1.add('toggle', 'On Item',    '!this.setFromTo(!this.popup1)')
   !menu1.add('toggle', 'On Point',   '!this.setFromTo(!this.popup1)')
   !this.popup1.popup = !menu1
   !this.popup1.popup.select('On Item', TRUE)
-- define popup menu for pddim/rddim button for selecting from and to ITEM, POINT or POS
   !menu3 = !this.newMenu('PickFromRD1')
   !menu3.add('toggle', 'From Item',    '!this.setFromTo(!this.popup3)')
   !menu3.add('toggle', 'From Point',  '!this.setFromTo(!this.popup3)')
   !menu3.add('toggle', 'From 3D Pos',  '!this.setFromTo(!this.popup3)')
   !menu3.add('SEPARATOR')
   !menu3.add('toggle', 'To Item',    '!this.setFromTo(!this.popup3)')
   !menu3.add('toggle', 'To Point',  '!this.setFromTo(!this.popup3)')
   !menu3.add('toggle', 'To 3D Pos',  '!this.setFromTo(!this.popup3)')
   !this.popup3.popup = !menu3
   !this.popup3.popup.select('From Item', TRUE)
   !this.popup3.popup.select('To Item', TRUE)
-- setup what is selected in the popup
   !whatPicked1 = !this.whatIsSelected(!this.popup1)
   !whatPicked3 = !this.whatIsSelected(!this.popup3)
   !this.popup1.setToolTip(!whatPicked1[1])
   !this.popup3.setToolTip(!whatPicked3[1].after('From ') + ' ' + !whatPicked3[2])
   !this.pickTypeR.val = !whatPicked1[1]
   !this.pickTypeP.val = !whatPicked3[1].after('From ') + ' ' + !whatPicked3[2]

  endmethod
-- End of method definition for .draCrDims3()
------------------------------------------------------------------------
--
-- Method:      setFromTo(STRING)
--
-- Description: Set the picking selection for the gadget clicked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [passed gadget the user has picked]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFromTo(!gadget is GADGET)

-- get the popup information
!picked = !gadget.popup.pickedField

-- switch off those already selected
if(!picked.upcase().match('FROM').neq(0)) then
   !menus    = 'From Item\From Point\From 3D Pos'
   !menuList = !menus.split('\')
elseif(!picked.upcase().match('TO').neq(0)) then
   !menus    = 'To Item\To Point\To 3D Pos'
   !menuList = !menus.split('\')
else
   !menus    = 'On Item\On Point'
   !menuList = !menus.split('\')
endif

do !i values !menuList
  if(!i.match(!picked).eq(0)) then
     !gadget.popup.select(!i, FALSE)
  endif
enddo

-- display what the popup is set to
!whatPicked = !this.whatIsSelected(!gadget)
if(!whatPicked.size().eq(1)) then
  !gadget.setToolTip(!whatPicked[1])
  !this.pickTypeR.val = !whatPicked[1]
else
  -- only do this if the alternative is picked [AK]
  if(!whatPicked.empty().not()) then
    !gadget.setToolTip(!whatPicked[1].after('From ') + ' ' + !whatPicked[2])
    !this.pickTypeP.val = !whatPicked[1].after('From ') + ' ' + !whatPicked[2]
  endif
endif

endmethod
-- End of method definition for .setFromTo(GADGET)
------------------------------------------------------------------------
--
-- Method:      whatIsSelected(GADGET)
--
-- Description: Find out what is selected for picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [passed gadget popup clicked]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [More than one can be selected return those selected]
--
------------------------------------------------------------------------
define method .whatIsSelected(!gadget is GADGET) is ARRAY

!selected = ARRAY()
-- get the list on the popup
  if(!gadget.name().match('POPUP3').neq(0)) then
     !string = 'From Item\From Point\From 3D Pos\To Item\To Point\To 3D Pos'
     !list   = !string.split('\')
  elseif(!gadget.name().match('POPUP1').neq(0)) then
     !string = 'On Item\On Point'
     !list   = !string.split('\')
  endif
-- find out what is selected
  do !i values !list
    if(!gadget.popup.selected(!i)) then
       !selected.append(!i)
    endif
  enddo

return !selected

endmethod
-- End of method definition for .whatIsSelected(GADGET)
------------------------------------------------------------------------
--
-- Method:      cancel()
--
-- Description: Cancel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

hide !!draCrDims3

endmethod
-- End of method definition for .cancel()
