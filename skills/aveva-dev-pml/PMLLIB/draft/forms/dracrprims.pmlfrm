--
-- File:            dracrprims.pmlfrm
--   Type:          Form Definition
--   Group:         2D Draughting
--     Keyword:     2DPRIMS
--   Module:        DRAFT
--   Replaces:
--
-- Author:          andy.kirkland
-- Created:         Wed Feb 04    10:56:14  2004
--
--
-- Description:
-- Form to replace the 2D primitives form with a new docking form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel the form and remove form COMSYSOPT
--  draCrPrims()                     -                   Constructor
--  init()                           -                   Initialises the form - navigates to the DRA layer if necessary
--
------------------------------------------------------------------------
-- Define form
setup form !!draCrPrims   dialog dock

-- members on the form
   !buttonSpace = 8
   !space       = 1.4

  path down
  !framePos = 'at xmin ymin  width 23 height 4'
  frame .tabSet tabset at xmin ymax+0.2
    frame .lines 'Lines' $!framePos
    --if(defined(!!cd2dCreate) and !!cd2dCreate.empty().not()) then
      button .sLine1   at ymin+0.5 pix   width $!buttonSpace height $!buttonSpace
      button .sLine2   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .sLine3   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .sLine4   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .cLine1   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .cLine2   at xmin.sLine1 ymin+1 pix   width $!buttonSpace height $!buttonSpace
      button .cLine3   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .cLine4   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .cLine5   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .cLine6   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
    --endif
    exit

    frame .shapes 'Shapes'    $!framePos
    --if(defined(!!cd2dCreate) and !!cd2dCreate.empty().not()) then
      button .shape1   at xmin.sLine1 ymin+0.5 pix   width $!buttonSpace height $!buttonSpace
      button .shape2   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .shape3   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .shape4   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .shape5   at xmin.sLine1 ymin+1  pix   width $!buttonSpace height $!buttonSpace
      button .shape6   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .shape7   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .shape8   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
    --endif
    exit

    frame .symbols 'Symbols' $!framePos
    --if(defined(!!cd2dCreate) and !!cd2dCreate.empty().not()) then
      button .symb1   at xmin.sLine1 ymin+0.5 pix   width $!buttonSpace height $!buttonSpace
      button .symb2   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .symb3   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
    --endif
    exit

    frame .texts 'Text' $!framePos
    --if(defined(!!cd2dCreate) and !!cd2dCreate.empty().not()) then
      button .text1   at xmin_sLine1 ymin+0.5 pix   width $!buttonSpace height $!buttonSpace
      button .text2   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .text3   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
      button .text4   at xmax+$!space ymin pix   width $!buttonSpace height $!buttonSpace
    --endif
    exit
  exit
exit
-- End of form definition for !!draCrPrims
------------------------------------------------------------------------
--
-- Method:      draCrPrims()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draCrPrims()

-- form setup
   !this.formTitle       = '2d Draughting'
   !this.iconTitle       = 'E2D'
   !this.cancelCall      = '!this.cancel()'
   !this.initCall        = '!this.init()'
   !this.formRevision    = ' $Revision: 1.1 $ '

-- Lines
 do !i to 4
   !this.sLine$!i$n.addpixmap(!!drawing2dDefinitions.straights[!i].icon)
   !this.sLine$!i$n.setToolTip(!!drawing2dDefinitions.straights[!i].description)
   !this.sLine$!i$n.callback = !!drawing2dDefinitions.straights[!i].callback
 enddo
 do !i to 4
   !this.cLine$!i$n.addpixmap(!!drawing2dDefinitions.outlines[!i].icon)
   !this.cLine$!i$n.setToolTip(!!drawing2dDefinitions.outlines[!i].description)
   !this.cLine$!i$n.callback = !!drawing2dDefinitions.outlines[!i].callback
 enddo
 !count = 0
 do !i from 5 to 6
   !count = !count + 1
   !this.cLine$!i$n.addpixmap(!!drawing2dDefinitions.arcs[!count].icon)
   !this.cLine$!i$n.setToolTip(!!drawing2dDefinitions.arcs[!count].description)
   !this.cLine$!i$n.callback = !!drawing2dDefinitions.arcs[!count].callback
 enddo

-- Shapes
 do !i to 3
   !this.shape$!i$n.addpixmap(!!drawing2dDefinitions.circles[!i].icon)
   !this.shape$!i$n.setToolTip(!!drawing2dDefinitions.circles[!i].description)
   !this.shape$!i$n.callback = !!drawing2dDefinitions.circles[!i].callback
 enddo
 !count = 0
 do !i from  4 to 7
   !count = !count + 1
   !this.shape$!i$n.addpixmap(!!drawing2dDefinitions.shapes[!count].icon)
   !this.shape$!i$n.setToolTip(!!drawing2dDefinitions.shapes[!count].description)
   !this.shape$!i$n.callback = !!drawing2dDefinitions.shapes[!count].callback
 enddo

   !this.shape8.addpixmap(!!drawing2dDefinitions.rectangles[1].icon)
   !this.shape8.setToolTip(!!drawing2dDefinitions.rectangles[1].description)
   !this.shape8.callback = !!drawing2dDefinitions.rectangles[1].callback

-- Symbols
 !geoms[1] = 'symbols[1]'
 !geoms[2] = 'rectangles[2]'
 !geoms[3] = 'shapes[5]'

 do !i to 3
   !this.symb$!i$n.addpixmap(!!drawing2dDefinitions.$!geoms[$!i]$n.icon)
   !this.symb$!i$n.setToolTip(!!drawing2dDefinitions.$!geoms[$!i]$n.description)
   !this.symb$!i$n.callback  = !!drawing2dDefinitions.$!geoms[$!i]$n.callback
 enddo

-- Text
 do !i to 4
   !this.text$!i$n.addpixmap(!!drawing2dDefinitions.text[!i].icon)
   !this.text$!i$n.setToolTip(!!drawing2dDefinitions.text[!i].description)
   !this.text$!i$n.callback  = !!drawing2dDefinitions.text[!i].callback
 enddo

endmethod
-- End of method definition for .draCrPrims()

------------------------------------------------------------------------
--
-- Method:      cancel()
--
-- Description: Cancel the form and remove form COMSYSOPT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

hide !!draCrPrims

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialises the form - navigates to the DRA layer if necessary
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  !ref = REF
  !ownerCheck = !!dtbGetOwnerType(!ref, 'VNOT SYTM ISOTM')
  if( !ownerCheck.unset() ) then
    if( not !!draSetLayer('', 'DRA') ) then
      return error 1 noalert
    endif
  endif
endmethod
-- End of method definition for .init()
