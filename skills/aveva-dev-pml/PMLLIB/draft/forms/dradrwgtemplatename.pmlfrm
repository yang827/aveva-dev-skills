--
-- File:            dradrwgtemplatename.pmlfrm
--   Type:          Form Definition
--   Group:         draft
--     Keyword:       template
--   Module:        DRAFT
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Mon Mar 22 9:27:03 "GMT 2004
--
--
-- Description:
-- Blocking form used to name new drawings from template in Draft
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draDrwgTemplateName()            -
--  initialise()                     -                   Set the name gadget to /
--  onApply()                        -                   Having set the names continue with creation
--  validateName(GADGET,STRING)      -
--
------------------------------------------------------------------------
  setup form !!draDrwgTemplateName blocking

  !this.formTitle     = 'Name'
  !this.callback      = '!this.initialise()'

  text .nameGadget   at x1 ymax |Name| call || width 20 is STRING

  button .ok at x0 ymax 'OK' callback '!this.onApply()' ok
  button .cancel at xmax form-size ymin 'Cancel' callback '' cancel

exit
------------------------------------------------------------------------
--
-- Method:      dradDrwgTemplateName
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draDrwgTemplateName()

  !this.nameGadget.validateCall = '!this.validateName('

endmethod
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Set the name gadget to /
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.nameGadget.val          = '/'

endmethod
------------------------------------------------------------------------
--
-- Method:      onApply
--
-- Description: Having set the names continue with creation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------
define method .onApply()

  !this.validateName(!this.nameGadget, '')
  !!draTemplateSheets.onApply()

endmethod
------------------------------------------------------------------------
--
-- Method:      validatename
--
-- Description: New name needs validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------
define method .validateName(!gadget is GADGET, !dummyString is STRING)

  -- Check the name has a slash
  if (!gadget.val.trim().substring(1,1) neq '/') then
    -- Add a slash
    !gadget.val = '/' & !gadget.val.trim()
  else
    !gadget.val = !gadget.val.trim()
  endif

  -- Test if name is too short
  if (!gadget.val.trim().length() leq 1) then
    return error 1 'Invalid input. (No Name input)'
  endif

  -- Test if name is too long
  if (!gadget.val.trim().length() geq 35) then
    return error 1 'Invalid input. (Name input too long)'
  endif

  -- Test if name is spaces in name
  if (!gadget.val.trim().replace(' ', '').length() neq !gadget.val.trim().length()) then
    return error 1 'Invalid input. (Spaces in Name input)'
  endif

  -- Test if name already exists
  !unusedTest = object DBREF(!gadget.val)
  handle NONE
    return error 1 'Name already exists'
  elsehandle ANY
    -- Find out specific error number
  endhandle

endmethod
