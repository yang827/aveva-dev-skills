setup form !!draFontSel

  !this.formTitle = 'Text Font Selector'
  !this.initCall = '!this.formMethods.init()'
  !this.cancelCall = '!this.formMethods.dismiss()'

  path down

  -- Feedback view
  -- *** OLD PML SYNTAX
  var !exist exist $_cdRDraftAids_fontSel
   if (!exist.upCase().eq('TRUEA')) then

     view .feedback at x0.5 y0.2 AREA
       width 40 aspect 1
       setcolour 15
       cursor nocursor
       borders off
     exit

   endif

  option .fontName call |!this.formMethods.view()| width 12


  path right

  option .fontThk call |!this.formMethods.view()| width 4


  option .fontSlant call |!this.formMethods.view()| width 7

  button .ok at xmin.fontName ymax.fontThk |  OK  | call |!this.formMethods.ok()|  OK
  button .cancel at xmin.fontSlant         |Cancel| CANCEL

  -- Members
  member .formMethods is DRAFONTSEL
  member .select is REAL
  member .form is FORM
  member .setForm is FORM

  -- Set form in object
  !this.formMethods.form = !this

  -- Read AVEVA fonts
  -- *** OLD PML SYNTAX
  do !count index !!cdFonts
    !countTen = !count * 10
    !dtext[!count] = !!cdFonts[!count]
    !rtext[!count] = !countTen.string()
  enddo
  !this.fontName.dtext = !dtext
  !this.fontName.rtext = !rtext

  -- Set thickness
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = |Thin|
  !dtext[2] = |Bold|
  !rtext[1] = |1|
  !rtext[2] = |4|
  !this.fontThk.dtext = !dtext
  !this.fontThk.rtext = !rtext

  -- Set slant
  !dtext[1] = |Upright|
  !dtext[2] = |Forward|
  !dtext[3] = |Reverse|
  !rtext[1] = |0|
  !rtext[2] = |1|
  !rtext[3] = |2|
  !this.fontSlant.dtext = !dtext
  !this.fontSlant.rtext = !rtext

-- End of form definition
exit
