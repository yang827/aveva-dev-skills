--
-- Description:
-- Select User-defined Fill Pen
--
------------------------------------------------------------------------
setup form !!draFpenSel

  !this.formTitle = 'Select User-Defined Hatch Pen'
  !this.initCall = '!this.formMethods.init()'
  !this.cancelCall = '!this.formMethods.dismiss()'

  view .pens area
    width 40
    height 7
    borders off
    -- Set default view attributes
    CALLIBM USETVIEW AREA PENS
  exit

  button .scrup at xmax+2 ymin+2 |Up| call |!this.formMethods.page('UP')|
  para .scroll at xmin ymax+0.2 text |Page|
  button .scrdn at xmin ymax |Down| call |!this.formMethods.page('DOWN')|

  button .curs at xmin.pens ymax.pens+1 |Cursor Select| call |!this.formMethods.curSel()|
  text .penNo at xmax+18 ymin |Pen Number | call |!this.formMethods.checkNumb()| width 4 is REAL
  button .oK at xmin.pens ymax+0.5  |  OK  | call |!this.formMethods.oK()|
  button .reset at  xmax+37 ymin    |Cancel| cancel

  -- Members
  member .formMethods is DRAFPENSEL
  member .select is REAL
  member .form is FORM

  -- Set form in object
  !this.formMethods.form = !this

-- End of form definition
exit
