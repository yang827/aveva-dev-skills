--   Type:          Form Definition
--   Group:         GAPS
--
--     Keyword:     LABELS
--   Module:        DRAFT
--   Replaces:
--
-- Author:          andy.kirkland
-- Created:         Thu Jun 03    09:56:37  2004
--
--
-- Description:
-- form to create gaps in SLABS, GLABS DIMS and (maybe) 2d lines
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the form
--  createGap(STRING)                -                   Create  gaps Labels, Dimensions and Straights
--  deleteGap(STRING)                -                   Delete gaps Labels, Dimensions and Straights
--  draGapManager()                  -                   Constructor
--  init()                           -                   Initialisation
--  pick()                           -                   Pick an element to create/delete gaps
--
------------------------------------------------------------------------
setup form !!draGapManager size 20 5 dialog docking

  track 'PADDCE' call '!this.init()'

-- button size
   !bs = 16
   !sp = 1.4

      button .pick 'Pick'   at x0 y0.2  pix width $!bs height $!bs
      --  text .name at xmax ymax  width 42 string

    frame .create  'Create Gaps' at xmax+1 ymin-0.2
      button .single   at     ymin+0.7 pix   width $!bs height  $!bs
      button .multi    at xmax+$!sp ymin pix   width $!bs height $!bs
      button .twoPts   at xmax+$!sp ymin pix   width $!bs height $!bs
      button .multiTwo at xmax+$!sp ymin pix   width $!bs height $!bs
    exit

    frame .delete  'Delete Gaps' at xmin ymax+0.5
      button .delSingle   at xmin.single ymin+0.7 pix   width $!bs height $!bs
      button .delMulti    at xmax+$!sp ymin pix   width $!bs height $!bs
      button .delAll      at xmax+$!sp ymin pix   width $!bs height $!bs

      para .dummy at   xmax+1 ymin width 3
    exit

member .ref is DBREF

exit
-- End of form definition for !!draGapManager

------------------------------------------------------------------------
--
-- Method:      draGapManager()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draGapManager()

-- form setup
   !this.formTitle       = 'Gap Manager'
   !this.iconTitle       = 'Gaps'
   !this.callback        = '!this.init()'
   !this.cancelCall      = '!this.close()'
   !this.formRevision    = '$Revision: 1.2 $ '

   !this.pick.setToolTip('Pick either a Label, Dimension or 2D Line')
   !this.pick.callback = |!this.pick()|
   !this.pick.addpixmap(!!pml.getpathname('navigate16.png'))

   !this.single.addpixmap(!!pml.getpathname('singlegap16.png'))
   !this.single.callback = |!this.createGap('SINGLE')|
   !this.single.setToolTip('Create Single Default Gap')

   !this.multi.addpixmap(!!pml.getpathname('multigap16.png') )
   !this.multi.callback = |!this.createGap('MULTI')|
   !this.multi.setToolTip('Create Many Default Gaps')

   !this.twoPts.addpixmap(!!pml.getpathname('2ptgap16.png'))
   !this.twoPts.callback = |!this.createGap('2POINTS')|
   !this.twoPts.setToolTip('Create a Gap selecting 2 Points')

   !this.multiTwo.addpixmap(!!pml.getpathname('multi2ptgap16.png')  )
   !this.multiTwo.callback = |!this.createGap('MULTI2POINTS')|
   !this.multiTwo.setToolTip('Create Many Gaps selecting 2 Points')

   !this.delSingle.addpixmap(!!pml.getpathname('singledelete16.png'))
   !this.delSingle.callback = |!this.deleteGap('SINGLE')|
   !this.delSingle.setToolTip('Identify Gap to Delete')

   !this.delMulti.addpixmap(!!pml.getpathname('multidelete16.png'))
   !this.delMulti.callback = |!this.deleteGap('MULTI')|
   !this.delMulti.setToolTip('Identify Gaps to Delete')

   !this.delAll.addpixmap(!!pml.getpathname('alldelete16.png'))
   !this.delAll.callback = |!this.deleteGap('ALL')|
   !this.delAll.setToolTip('Delete All Gaps')

endmethod
-- End of method definition for .draGapManager()
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

!type = !!ce.type
!valid = 'SLAB GLAB DPOI DPPT DPBA RDIM APPT ADIR PDIM'
!check = !valid.match(!type).eq(0)
if(!check) then
  !this.create.active   = FALSE
  !this.delete.active   = FALSE
else
  !this.create.active   = TRUE
  !this.delete.active   = TRUE
  !this.ref = !!ce
   unenhance all (SLAB GLAB DPOI DPPT DPBA) for shee
   enhance  ce

endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      pick()
--
-- Description: Pick an element to create/delete gaps
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick()

    prompt off
    prompt load escape |Identify Element to modify...|
    ID SLAB GLAB DPOI DPPT DPBA @
    handle(61,528)
      prompt on
      return
    endhandle
    prompt on

 !this.ref = !!ce

endmethod
-- End of method definition for .pick()
------------------------------------------------------------------------
--
-- Method:      createGap(STRING)
--
-- Description: Create  gaps Labels, Dimensions and Straights
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Action to carry out]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createGap(!action is STRING)

-- Can only put gaps in on SLABs
!type = !!ce.type
!labels = 'SLAB GLAB RDIM PDIM DPOI DPPT DPBA'
if(!labels.match(!type).eq(0)) then
   prompt off
   prompt load escape |Identify label/Dimension to be modified|
   id SLAB GLAB RDIM DPOI PDIM DPPT DPBA @
   handle (61,528)
      prompt dismiss
      prompt on
      return
   endhandle
endif

-- can only put gaps in if it has a leader line
!labels = 'SLAB GLAB'

if(!labels.match(!type).neq(0)) then
  !llea = !!ce.llea
  if(!llea.not()) then
     return error 1 |Current Label has no leader line|
  endif
endif

if(!action.eq('SINGLE'))then
-- position default GAP
   prompt off
   prompt load escape |Position the Gap with the cursors|
   gap at @
   handle (61,528)
      prompt dismiss
      prompt on
      return
   endhandle
   prompt dismiss
   prompt on
elseif(!action.eq('MULTI'))then
-- position default GAPs
   prompt off
   prompt load escape |Position the Gap with the cursors|
   do
     gap at @
     handle (61,528)
       prompt dismiss
       prompt on
       return
     endhandle
   enddo
   prompt dismiss
   prompt on
elseif(!action.eq('2POINTS')) then
-- position GAP with 2 points
   prompt off
   prompt load escape |Position the Gap Start and Finish with the cursors|
   gap @
   handle (61,528)
      prompt dismiss
      prompt on
      return
   endhandle
   prompt dismiss
   prompt on
elseif(!action.eq('MULTI2POINTS')) then
-- position GAP with 2 points
  prompt off
  prompt load escape |Position the Gaps Start and Finish with the cursors|
  do
    gap @
    handle (61,528)
      prompt dismiss
      prompt on
      return
    endhandle
  enddo
  prompt dismiss
  prompt on
endif
endmethod
-- End of method definition for .createGap(STRING)
------------------------------------------------------------------------
--
-- Method:      deleteGap(STRING)
--
-- Description: Delete gaps Labels, Dimensions and Straights
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Action to carry out]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteGap(!action is STRING)

if(!action.eq('SINGLE')) then
-- delete an Id'd GAP
  prompt off
  prompt load escape |Identify the gap to be deleted with the cursors|
  gap delete @
  handle (61,528)
     prompt dismiss
     prompt on
     return
  endhandle
  prompt dismiss
  prompt on
elseif(!action.eq('MULTI')) then
-- delete Id'd GAPs
  prompt off
  prompt load escape |Identify the gap to be deleted with the cursors|
  do
     gap delete @
     handle (61,528)
        prompt dismiss
        prompt on
        return
     endhandle
  enddo
  prompt dismiss
  prompt on
elseif(!action.eq('ALL')) then
  gap delete all
endif
endmethod
-- End of method definition for .deleteGap(STRING)
------------------------------------------------------------------------
--
-- Method:      close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

hide !this

endmethod
-- End of method definition for .close()
