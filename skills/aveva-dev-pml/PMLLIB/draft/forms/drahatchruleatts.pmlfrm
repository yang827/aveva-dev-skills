--
-- File:            drahatchruleatts.pmlfrm
--   Type:          Form Definition
--   Group:         Hatching
--     Keyword:     DRA
--   Module:        draft
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Wed Sep 15 10:12:01 BST 1999
--
--
-- Description:
-- Form for setting hatch rule attributes
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form
--  checkDir()                       -                   Check the gadget input is a direction
--  draHatchRuleAtts()               -                   Constructor
--  init()                           -                   Initialise Form
--  update()                         -                   update the form
--

setup form !!draHatchRuleAtts

  !this.formTitle     = 'Hatching Rule Attributes'
  !this.iconTitle     = 'HRUL Atts'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Form Members -------------------------------------------------

  -- Element
  member .hatchElement   is DBREF
  -- Parent Form
  member .parentForm     is FORM

  -- Body of form definition -------------------------------------------------

  -- Paragraph showing hatch rule element / CE name
  para .ceName  at x0.5 y0.5 width 55 lines 2

  -- Frame
  frame .hatchFrame at x0.5 ymax 'Hatching Rules'

    option .faceCode 'Consider' at x1 ymax+0.2   callback | !this.update()| width 25

    button .picture      |Plot...|  at xmax  ymin  callback 'show !!draHatchRulePlot'


    -- Direction Codes
    frame .directionCodes at x1 ymax+0.5 'Hatching'
      rgroup .directionCode at x1 y1 callback '!this.update()' vertical
        add tag 'All surfaces in all directions'                  select 'ALLDIRECTIONS'
        add tag 'Only surfaces perpendicular to view direction'   select 'PERPENDICULARDIRECTION'
        add tag 'Only surfaces facing in the specified direction' select 'SPECIFIEDDIRECTION'
      exit
    exit

    path down

    -- Direction of Surface (normal)
    frame .normal at x1 ymax+0.5 'Surface Normal'
      -- Standard draft direction gadgets
      CALLDRG UDIRECTION CREATEGADGETS _draHatchRuleAtts
    exit

  exit

  -- Bottom Line
  button .ok      |  OK  |  at x1              ymax+0.5  callback '!this.apply()'  OK
  button .cancel  |Cancel| at xmax form-size  ymin    callback '' CANCEL

-- End of form definition for !!draHatchRuleAtts
exit

------------------------------------------------------------------------
--
-- Method:      draHatchRuleAtts
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draHatchRuleAtts()

  -- Set the face code option gadget
  !detailText[1] = 'only sectioned surfaces'
  !detailText[2] = 'all primitive surfaces'
  !returnText[1] = 'SECTIONEDFACES'
  !returnText[2] = 'PRIMITIVEFACES'
  !this.faceCode.dText = !detailText
  !this.faceCode.rText = !returnText

  -- Change the callback on the direction gadget
  !this.dir.callback = ''
  !this.dir.validateCall = '!this.checkDir()'

endmethod
-- End of method definition for .draHatchRuleAtts()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:  Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Record old form
  !form = !!cdrLibMreph
  !hatchRule = !form.hrul.selection('rText')
  -- Make the calling form inactive
  if (!this.owner().set()) then
    !this.owner().setActive(false)
    !this.parentForm = !this.owner()
    !this.cancelCall = '!this.parentForm.setActive(true)'
  endif

  -- Set the current element gadget
  !this.hatchElement = !hatchRule.dbref()
  !this.ceName.val = 'HRUL ' & !this.hatchElement.fullname

    -- Navigate to the hatch rule
  !!ce = !this.hatchElement

  -- Set the PDMS attributes
  !faceCode      = !!ce.fcode
  !this.faceCode.select('rText', !faceCode.upcase())

  !directionCode = !!ce.dcode
  !this.directionCode.select(!directionCode.upcase())

  var !normal NORMAL
  !this.dir.val = !normal
  var !coordinate coordinate

  if (!normal eq 'unset') then
    if (!coordinate eq 'XYZ') then
        !this.dir.val = 'Y'
        !this.iso.select('RTEXT', 'Y')
    else
    !this.dir.val = 'N'
    !this.iso.select('RTEXT', 'N')
  endif
  endif

  -- Update the Surface Normal gadgets
  !this.update()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Navigate to the hatch rule
  !!ce = !this.hatchElement

  -- Set the PDMS attributes
  !faceCode      = !this.faceCode.selection()
  FCODE $!faceCode

  !directionCode = !this.directionCode.selection()
  DCODE $!directionCode

  if (!this.normal.active) then
    !normal = !this.dir.val
    NORMAL $!normal
  endif

  -- Make the calling form active
  if (!this.parentForm.set()) then
    !this.parentForm.setActive(true)
    !this.parentForm = object FORM()
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: update the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Update gadgets
  if (!this.directionCode.selection() eq 'SPECIFIEDDIRECTION') then
    !this.normal.active  = true
    !this.dir.active     = true
    !this.iso.active     = true
    !this.derived.active = true
  else
    !this.normal.active  = false
    !this.dir.active     = false
    !this.iso.active     = false
    !this.derived.active = false
  endif


endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      checkDir
--
-- Description: Check the gadget input is a direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkDir()

  -- Update gadgets
  var !coordinate coordinate
  !direction = !this.dir.val.direction()
  handle any
    return error 1 'Invalid Direction'
  endhandle

if (!coordinate eq 'XYZ') then

  !east  = object DIRECTION('X')   $* !X
  !estr  = 'X'
  !west  = object DIRECTION('-X')  $* !-X
  !wstr  = '-X'
  !north = object DIRECTION('Y')   $* !Y
  !nstr  = 'Y'
  !south = object DIRECTION('-Y')  $* !-Y
  !sstr  = '-Y'
  !up    = object DIRECTION('Z')   $* !Z
  !ustr  = 'Z'
  !down  = object DIRECTION('-Z')  $* !-Z
  !dstr  = '-Z'
  !iso1  = object DIRECTION('-X45-Y35.26-Z')
  !iso2  = object DIRECTION('-X45Y35.26-Z')
  !iso3  = object DIRECTION('X45Y35.26-Z')
  !iso4  = object DIRECTION('-Y45X35.26-Z')

else

  !east  = object DIRECTION('E')
  !estr  = 'E'
  !west  = object DIRECTION('W')
  !wstr  = 'W'
  !north = object DIRECTION('N')
  !nstr  = 'N'
  !south = object DIRECTION('S')
  !sstr  = 'S'
  !up    = object DIRECTION('U')
  !ustr  = 'U'
  !down  = object DIRECTION('D')
  !dstr  = 'D'
  !iso1  = object DIRECTION('W45S35.26D')
  !iso2  = object DIRECTION('W45N35.26D')
  !iso3  = object DIRECTION('E45N35.26D')
  !iso4  = object DIRECTION('S45E35.26D')

endif

  -- Update the adjacent gadget
  if (!direction.eq(!north) ) then     $* or !Y
    !this.iso.select('rtext',!nstr)
  elseif (!direction.eq(!south) ) then $* or !-Y
    !this.iso.select('rtext',!sstr)
  elseif (!direction.eq(!east) ) then  $* or !X
    !this.iso.select('rtext',!estr)
  elseif (!direction.eq(!west) ) then  $* or !-X
    !this.iso.select('rtext',!wstr)
  elseif (!direction.eq(!up) ) then    $* or !Z
    !this.iso.select('rtext',!ustr)
  elseif (!direction.eq(!down) ) then  $* or !-Z
    !this.iso.select('rtext',!dstr)
  elseif (!direction.eq(!iso1)) then
    !this.iso.select('dtext','ISO 1')
  elseif (!direction.eq(!iso2)) then
    !this.iso.select('dtext','ISO 2')
  elseif (!direction.eq(!iso3)) then
    !this.iso.select('dtext','ISO 3')
  elseif (!direction.eq(!iso4)) then
    !this.iso.select('dtext','ISO 4')
  else
    !this.iso.select('rtext','')
  endif

endmethod
-- End of method definition for .checkDir()
