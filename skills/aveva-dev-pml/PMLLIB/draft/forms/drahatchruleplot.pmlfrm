--
-- Define form

setup form !!draHatchRulePlot

  !this.formTitle     = 'Hatching Rule Attributes Plot'
  !this.iconTitle     = 'HRUL Plot'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- View gadget for plot file
  view .view at x0 y0 plot
    height 20 aspect .7071
    add "%PDMSPLOTS%/DRAFT/StandardHatchingDrwg.S1.plt"
    handle any
      exit
      exit
      !!alert.warning ('There is no picture available or the %PDMSPLOTS% directory is not set')
      return
    endhandle
  exit

-- Bottom Line
--  button .Dismiss  |Dismiss| at xmax form-size  ymax+0.5   callback '' CANCEL

exit

-- End of form definition for !!draHatchRulePlot
