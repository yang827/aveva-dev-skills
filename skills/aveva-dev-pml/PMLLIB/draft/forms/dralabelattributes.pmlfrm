--
-- File:            dralabelattributes.pmlfrm
--   Type:          Form Definition
--   Group:         Labels
--     Keyword:     LABEL
--   Module:        Draft
--   Replaces:
--
-- Author:          Tomasz Lisowski
-- Created:         Wed May 19    10:55:43  2008
--
-- Description:
-- General form for modification of label attributes (SLAB and GLAB)
-- Works as a companion to the !!draLabelsFast form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING,STRING)             -                   Initialisation
--  applyAttributes()                STRING              Does the common part of setting the attributes of a label from the form's gadgets
--  cbUpdatePkey()                   -                   Callback for the .pkey gadget - resets .nppt if necessary
--  draLabelAttributes()             -                   Constructor
--  init()                           -                   Initialisation
--  reShape(STRING)                  -                   Callback for the .lshape and .llreshape gadgets
--  runMacro(STRING)                 -                   run an old macro
--  setAttribute(STRING,STRING)      -                   set an attribute on the glab/slab
--  setLabType(STRING)               -                   Set the working mode of the form (GLAB/SLAB)
--  setMainPlines(STRING)            -                   Establishes the Plines, whose names should come first in the list
--  setPkey()                        -                   Determines the list of the valid P-line names, including MEML and selects the current setting
--  showForm()                       -                   show form for gaps even if not defined
--  showForm(FORM)                   -                   show form relating to attributes list gadget
--  showForm(STRING)                 -                   show form relating to attributes list gadget
--  validNPPT()                      -                   Validating routine for the NPPT gadget
--  validNum(GADGET,REAL,REAL)       -                   Validating routine guarding from the unset or out-of-range values
--  validScale(GADGET)               -                   Validating routine guarding from the unset or zero scale values
--  validStrNum(GADGET,REAL,REAL)    -                   Validating routine guarding from the unset or out-of-range values
--
------------------------------------------------------------------------

setup form !!draLabelAttributes size 62.8 17.5 dialog docking
  text .name 'Label:' tagwidth 12 width 49 is STRING
  !this.name.setEditable(false)
  path right
  frame .tabset TABSET at xmin_name ymax+0.2 | |
    frame .frTextAttr 'Text attributes' dock fill
      para   .textFont text 'Font:' width 9
      hdist 0
      !!runSynonym('CALLDRG FFONTS _draLabelAttributes')
      hdist 0.5
      text   .chei width 6 is REAL format !!realFmt
      toggle .cheiTemplate 'Template' tagwidth 7
      option .just  at xmin_textFont ymax+0.2 'Justification:' tagwidth 9 width 6
      text   .lspa  at xmax+2 'Line Spacing:' tagwidth 13 width 5 is REAL format !!realFmt
      text   .angle at xmax+2 'Rotation angle:' tagwidth 11 width 5 is STRING
      option .align at xmin_textFont ymax+0.2 'Alignment:' tagwidth 9 width 6
      text   .cspa  at xmin_lspa 'Character Spacing:' tagwidth 13 width 5 is REAL format !!realFmt
      option .adegpline at xmin_angle 'Along Pline Axis:' tagwidth 11 width 3
      !options = 'NROWS=1\TAGWIDTH=9\FIRSTAT=at xmin_textFont ymax+0.3'
      !!draColStyle.setup('TPEN', !options)
    exit
    frame .frFrameAttr |Frame attributes| at 0 0 dock fill
      -- setting up the gadgets for the Label Frame PEN
      !!draColStyle.setup('LFPN', 3, '')
      option .lframe at xmin_LFPN ymax+0.2 'Frame:' tagwidth 5 width 3
      text .gbox 'Clearance:' tagwidth 8 width 5 is REAL format !!distanceFmtForm
      toggle .blnk at xmin_LFPNTH ymin_LFPN 'Blanking' tagwidth 6
      text   .bmar at ymin+0.1 'Blank Margin' tagwidth 9 width 5 is REAL
      para   .xScalePara at x0.5 ymin_lframe text 'Scale X:'
      text   .xScale at x6 width 5 is REAL
      text   .yScale 'Y:' tagwidth 2 width 5 is REAL
      option .oset at xmax_gbox ymin_gbox 'Offset' tagwidth 5 width 7
    exit
    frame .frLeaderAttr |Leader line attributes| at 0 0 dock fill
      -- setting up the frame gadgets for the PEN
      !!draColStyle.setup('LLPN', 3, '')
      option .llead at xmin_LLPN ymax+0.2 |Leader| tagwidth 5 width 3
      option .lterm |Terminator| tagwidth 8 width 8
      !!runSynonym('CALLIBM XTERM SET LTERM')
      text .llcl  |Clearance| tagwidth 7 width 5 is REAL format !!distanceFmtForm
      text .tsize |Size| tagwidth 4 width 5 is REAL format !!distanceFmtForm
    exit
  exit

  frame .frRef at x0.5 ymax+0.2 ' Reference '
    text   .ddnm at xmin_textFont width 58 is STRING
    !this.ddnm.setEditable(false)
    text   .nppt at xmin_textFont ymax+0.2 'P-point:' tagwidth 6 width 6 is STRING
    option .pkey  'P-line:' tagwidth 6 width 10
    text   .pkdi 'Proportion:' tagwidth 8 width 4 is REAL format !!realFmt
  exit

  frame .frLL at x0.5 ymax+0.2 ' Leader line geometry ' width_frRef
    option .lshape at xmin_textFont |Shape:| tagwidth 7 width 12
    text   .llangle |Angle:| tagwidth 5 width 4 num
    button .llreshape |Re-shape| width 7
    para   .clearPara at xmin_textFont ymax+0.2 text 'Offset at:' width 6
    button .llConn |Connection...| width 9
    button .llAtta |Attachment...| width 9
  exit

  button .apply   'Apply' at xmin_name ymax+1 width 6
    button .gaps at xcen form-6 'Manage Gaps...' width 12
  button .dismiss 'Dismiss' at xmax form-8 ymin width 6 CANCEL

  member .labType is STRING
  member .mainPlines is ARRAY
  member .savedPData is STRING

exit
-- End of form definition for !!draLabelAttributes()

------------------------------------------------------------------------
--
-- Method:      draLabelAttributes
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draLabelAttributes()

  -- form setup
  !this.formTitle       = 'Label attributes'
  !this.iconTitle       = 'Labs'
  !this.callback        = |!this.init()|
  !this.formRevision    = '$Revision: '

  !this.labType = 'XXX'
  !s = '+X/+Y/+Z/-X/-Y/-Z'
  !this.adegpline.dText = !s.split('/')
  !tab[1] = 'unset'
  !this.pkey.dText = !tab
  !s = 'Left/Right/Centre'
  !this.just.dText = !s.split('/')
  !s = 'Centre/Top/Bottom/Base'
  !this.align.dText = !s.split('/')
  !s = 'Hbody/Tbody/Bbody/Base'
  !this.align.rText = !s.split('/')
  !s = 'On/Off'
  !this.lframe.dText = !s.split('/')
  !this.llead.dText = !s.split('/')
  !s = 'TRUE/FALSE'
  !this.lframe.rText = !s.split('/')
  !this.llead.rText = !s.split('/')
  !s = 'Default/Straight/Free (1 bend)/Free (2 bends)/Horizontal Angled/Vertical Angled/Angled Horizontal/Angled Vertical'
  !this.lshape.dText = !s.split('/')
  !this.lshape.rText = !s.split('/')

  -- Define the names of the MAIN p-lines, whose names should come first in the P-line
  -- selection dialog
  !s = 'NA TOS BOS'
  !this.setMainPlines(!s)

  !dText = ARRAY()
  !dText[1] = 'Relative'
  !rText[1] = 'TRUE'
  !dText[2] = 'Absolute'
  !rText[2] = 'FALSE'
  !this.oset.dText   = !dText
  !this.oset.rText   = !rText

  -- Callbacks  for GLABs
  !this.adegpline.callback  = |!this.apply('ALIGN',!!draLabelAttributes.adegpline.selection())|
  !this.chei.validateCall   = |!this.validNum(!this.chei, 0.01, 10000.0)|
  !this.cspa.validateCall   = |!this.validNum(!this.cspa, -0.5, 10.0)|
  !this.lspa.validateCall   = |!this.validNum(!this.lspa, -10.0, 10.0)|
  !this.gbox.validateCall   = |!this.validNum(!this.gbox, -10000.0, 10000.0)|
  !this.llcl.validateCall   = |!this.validNum(!this.llcl, -10000.0, 10000.0)|
  !this.tsize.validateCall  = |!this.validNum(!this.tsize, 0.01, 10000.0)|
  !this.angle.validateCall  = |!this.validStrNum(!this.angle, -361.0, 361.0)|
  !this.nppt.validateCall   = |!this.validNPPT()|
  !this.xScale.validateCall = |!this.validScale(!this.xScale)|
  !this.yScale.validateCall = |!this.validScale(!this.yScale)|

  -- Callbacks for SLABs
  !this.cheiTemplate.callback = |!this.chei.active = not !this.cheiTemplate.val|
  -- General callbacks
  !this.pkey.callback       = |!this.cbUpdatePkey()|
  !this.apply.callback      = |!this.apply('APPLY','')|
  !this.gaps.callback       = |!this.showForm()|
  !this.lshape.callback     = |!this.reShape('CHANGE')|
  !this.llreshape.callback  = |!this.reShape('APPLY')|
  !this.llreshape.setToolTip('Rebuilds the leader line according to the currently selected shape')
  !this.llConn.callback     = |!this.reShape('CONN')|
  !this.llConn.setToolTip('Repositions the connection point of the leader line')
  !this.llAtta.callback     = |!this.reShape('ATTA')|
  !this.llAtta.setToolTip('Repositions the attachment point of the leader line')

endmethod
-- End of method definition for .draLabelAttributes()

------------------------------------------------------------------------
--
-- Method:      validScale
--
-- Description: Validating routine guarding from the unset or zero scale values
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The gadget being validated
-- Return:
--
------------------------------------------------------------------------
define method .validScale(!gadget is GADGET)
  if( !gadget.val.empty() ) then
    return error 1 |The Scale factor must be given for a SLAB!|
  elseif( !gadget.val.eq('0') ) then
    return error 1 |The Scale factor cannot be ZERO!|
  endif
endmethod
-- End of method definition for .validScale(GADGET)

------------------------------------------------------------------------
--
-- Method:      validNum
--
-- Description: Validating routine guarding from the unset or out-of-range values
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The gadget being validated
--   2  R  REAL    Minimum allowed value
--   3  R  REAL    Maximum allowed value
-- Return:
--
------------------------------------------------------------------------
define method .validNum(!gadget is GADGET, !min is REAL, !max is REAL)
  !gTag = !gadget.tag
  if( !gadget.val.unset() ) then
    return error 1 |The $!gTag value is not set!|
  elseif( !gadget.val.lt(!min) ) then
    return error 1 |The $!gTag value is below the allowed minimum!|
  elseif( !gadget.val.gt(!max) ) then
    return error 1 |The $!gTag value is above the allowed maximum!|
  endif
endmethod
-- End of method definition for .validNum(GADGET, REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      validNPPT
--
-- Description: Validating routine for the NPPT gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .validNPPT()
  !value = !this.nppt.val
  if( !value.empty() or !value.eq('unset') ) then
    -- OK
  else
    !unusedValue = !value.real()
    handle (2,441)
      return error 1 |Invalid NPPT value '$!value'|
    endhandle
  endif
endmethod
-- End of method definition for .validNPPT()

------------------------------------------------------------------------
--
-- Method:      validStrNum
--
-- Description: Validating routine guarding from the unset or out-of-range values
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The gadget being validated
--   2  R  REAL    Minimum allowed value
--   3  R  REAL    Maximum allowed value
-- Return:
--
------------------------------------------------------------------------
define method .validStrNum(!gadget is GADGET, !min is REAL, !max is REAL)
  !gTag = !gadget.tag
  !value = !gadget.val.real()
  handle (2,441)
    return error 1 |The $!gTag value is not a valid number!|
  endhandle
  if( !value.unset() ) then
    return error 1 |The $!gTag value is not set!|
  elseif( !value.lt(!min) ) then
    return error 1 |The $!gTag value is below the allowed minimum!|
  elseif( !value.gt(!max) ) then
    return error 1 |The $!gTag value is above the allowed maximum!|
  endif
endmethod
-- End of method definition for .validStrNum(GADGET, REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  !target = !!draLabelsFast.ref
  -- If !!draLabelsFast form has a label's reference set, use it
  -- otherwise disable the form
  !enable = !target.set()
  if( !enable ) then
    $!target
    handle ANY
      -- If the Label's reference is no longer accessible, disable the form
      !enable = false
    endhandle
  endif
  !this.setActive(!enable)
  if( not !enable ) then
    return
  endif

  -- Now we are at the label
  !type = TYPE
  !newType = !type.neq(!this.labType)
  !this.setLabType(!type)
  !this.name.val = FULLNAME of $!target

  -- determine the label type: GLAB or SLAB
  !isSLAB = !type.eq('SLAB')
  if( !isSLAB ) then
    var !xyScale xyScale
    !array = !xyScale.split()
    !this.xScale.val = !array[1]
    !this.yScale.val = !array[2]
  endif

  -- set the gadgets to the attribute values of the label.
  !num = NPPT
  !active = !num.neq(-1)
  if( !active ) then
    !this.nppt.val = !num.string()
  else
    !this.nppt.val = 'unset'
  endif
  !this.nppt.active = !active

  !this.pkdi.val = PKDI
  !this.setPkey()
  !num = ADEG
  !this.angle.val = !num.string('D3').trim('R', '0').trim('R', '.')

  !oset = OSET
  !this.oset.select('rText',!oset.string())
  !this.reShape('GET')
  !!runSynonym('CALLDRG IFONTS FONT')

  !formName = !!draColStyle.formName
  if( !newType ) then
    !!draColStyle.onInit()
    !!draColStyle.setFormName('_draLabelAttributes')
    !!draColStyle.updateGadgets('TPEN')
    !!draColStyle.updateGadgets('LFPN')
    !!draColStyle.updateGadgets('LLPN')
    !!draColStyle.loadUserStyles()
  else
    !!draColStyle.setFormName('_draLabelAttributes')
  endif

  !tpenColour = TXCONUMBER
  !!draColStyle.setColour('TPEN' , !tpenColour)

  !lfColour = LFCONUMBER
  !!draColStyle.setColour('LFPN', !lfColour)
  !lfStyle = LFSTYLE
  !!draColStyle.setStyle('LFPN', !lfStyle)

  !llColour = LLCONUMBER
  !!draColStyle.setColour('LLPN', !llColour)
  !llStyle = LLSTYLE
  !!draColStyle.setStyle('LLPN', !llStyle)
  !!draColStyle.formName = !formName

  !just = JUST
  !this.just.select('Rtext', !just)
  !align = ALIGN
  !this.align.select('Rtext', !align)

  !llead = LLEAD
  !this.llead.select('Rtext', !llead.string())
  !lterm = LTERM
  !this.lterm.select('Rtext', !lterm.upCase())
  !this.llcl.val  = LLCL
  !this.tsize.val = TSIZE

  !this.blnk.val = BLNK
  !this.bmar.val = BMAR
  !ddnmType = FULLTYPE of DDNM
  handle ANY
    !this.ddnm.val = 'unset'
  elsehandle None
    !ddnmName = FULLNAME of DDNM
    !this.ddnm.val = '$!ddnmName ($!ddnmType)'
  endhandle
  if( !isSLAB ) then
    !chei = $!!cdCharHeight
    !this.cheiTemplate.visible = true
    !isNumber = !chei.objectType().eq('REAL')
    !this.chei.active = !isNumber
    !this.cheiTemplate.val = not !isNumber
    if( !isNumber ) then
      !this.chei.val = !chei
    else $* TEMPLATE
      !this.chei.val = $!!cdCharHeight of OWNER
    endif
  else
    !this.cspa.val = CSPA
    !this.lspa.val = LSPA
    !this.gbox.val = GBOX
    !lframe = LFRAME
    !this.lframe.select('Rtext', !lframe.string())
    !this.chei.val = $!!cdCharHeight
    !this.chei.active = true
    !this.cheiTemplate.val = false
    !this.cheiTemplate.visible = false
  endif
  !this.savedPData = '$!this.nppt.val ' & !this.pkey.selection() & ' $!this.pkdi.val'

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      applyAttributes
--
-- Description: Does the common part of setting the attributes of a label from the form's gadgets
--
-- If !savedCommand is not empty, it is just re-used, otherwise it is determined. It is always returned.
-- An empty string is returned, if the current element was not a GLAB or SLAB.
--
-- Method Type: Function
-- Arguments:
-- Return:
--   STRING  Final command string or status string (*LOCKED)
--
------------------------------------------------------------------------
define method .applyAttributes() is STRING
  -- We are at a label now!
  !type = TYPE
  !isSLAB = !type.eq('SLAB')

  -- check for autotagging template GLAB
  !name = NAME
  !purpose = PURP of LAYER
  !template = !name.match('/GLAB').neq(0) and !purpose.subString(1, 3).eq('TAG')
  !lock = LOCK
  if( !lock ) then
    if( !template ) then
      !answer = 'YES' $* don't ask for autotagging template GLABs (existing behaviour)
    else
      !answer = !!alert.question('The label $!name is locked! Do you still want to modify it?')
    endif
    if( !answer.eq('YES') ) then
      UNLOCK
    else
      return '*LOCKED' $* Special return value to indicate a locked label
    endif
  endif

  if( !this.cheiTemplate.val ) then
    !chei = 'Template'
  else
    !chei = '$_chei'
  endif
  !command = 'JUST $_just ALIGN $_align $!!cdCharHeight $!chei OSET $_oset BLNK $_blnk BMAR $_bmar LLEAD $_llead LTERM $_lterm LLCL $_llcl TSIZE $_tsize '
  if( !isSLAB ) then
    !command = !command & 'XYSCALE $_xScale $_yScale '
  else $* GLAB
    !command = !command & 'CSPA $_cspa LSPA $_lspa LFRAME $_lframe GBOX $_gbox '
  endif

  !resTPEN = !!draColStyle.getData('TPEN')
  !resLFPN = !!draColStyle.getData('LFPN')
  !resLLPN = !!draColStyle.getData('LLPN')
  if( !resTPEN[1] and !resLFPN[1] and !resLLPN[1] ) then
    !command = !command & 'TXCOLOUR $!resTPEN[2] LFCOLOUR $!resLFPN[2] LFSTYLE $!resLFPN[3] LLCOLOUR $!resLLPN[2] LLSTYLE $!resLLPN[3] '
  endif
  !!runSynonym('CALLDRG MFONTSEL SET FONT')

  !angle = !this.angle.val
  if( !angle.neq('') ) then
    !command = !command & 'ANGLE $!angle '
  endif

  -- Take PKEY and PKDI into account
  !pkey = !this.pkey.selection()
  if( !pkey.eq('unset') ) then
    !command = !command & 'PKEY UNSET '
  else
    !command = !command & 'PKEY $!pkey '
  endif

  !pkdi = !this.pkdi.val
  if( !pkdi.set() ) then
    !command = !command & 'PKDI $!pkdi '
  endif

  $!command
  handle (64,382) $* data not accessible for code word...
  endhandle

  -- See, if we need this NPPT setting code - this may be reserved for the main form!
  !nppt = !this.nppt.val
  if( !nppt.unset() ) then
    !num = -1
  elseif( !nppt.empty() or !nppt.eq('unset') or !nppt.eq('-1') ) then
    !num = -1
  else
    !num = !nppt.real()
    handle (2,441)
      !num = -999
    endhandle
  endif
  if( !num.neq(-999) ) then
    NPPT $!num
    handle (64,382) $* data not accessible for code word...
    elsehandle (2,21) (64,277)
      !num = NPPT
      if( !num.eq(-1) ) then
        !this.nppt.val = 'unset'
      else
        !this.nppt.val = !num
        handle any
        endhandle
      endif
      error |Ppoint $!nppt does not exist|
    endhandle
  endif

  !savedPData = '$!this.nppt.val ' & !this.pkey.selection() & ' $!this.pkdi.val'
  if( !savedPData.neq(!this.savedPData) ) then
    if( !!draLabelsFast.shown() ) then
      !!draLabelsFast.collectTree()
    endif
    !this.savedPData = !savedPData
  endif

  if( !lock ) then
    LOCK
  endif
  return !command
endmethod
-- End of method definition for .applyAttributes()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   1   R   STRING  the mode of operation
--   2   R   STRING  optional argument to perform the operation
-- Return:
--
------------------------------------------------------------------------
define method .apply(!mode is STRING, !opt is STRING)

  -- If the form is active, the reference in the !!draLabelsFast form must
  -- be still correct and set!
  !ref = !!draLabelsFast.ref
  $!ref
  handle ANY $* Just in case the user deleted without refreshing the !!draLabelsFast form
    !this.setActive(false)
    return
  endhandle

  --
  --------------------->>> Align label ADEG to a pline <<<--------------------------
  --
  if( !mode.eq('ALIGN') ) then

    !pkey  = PKEY
    !ddnm  = DDNM

    -- check that user is attached to a PLINE
    if( !pkey.empty() ) then
      return error 1 |This label is NOT attached to a Pline|
    endif

    ANGLE PPLINE $!pkey OF $!ddnm $!opt
    !num = ADEG
    !numStr = !num.string('D3').trim('R', '0').trim('R', '.')
    ADEG $!numStr $* adjust the angle
    !this.angle.val = !numStr
    return

  --
  --------------------->>> Apply <<<--------------------------
  --
  elseif( !mode.eq('APPLY') ) then

    !command = !this.applyAttributes()
    -- If the applyAttributes failed, or the CE was locked
    -- then nothing has changed
    if( !command.neq('') and !command.neq('*LOCKED') ) then
      -- It should not be necessary to initialise the form
      -- The gadgets already have the values being applied
     !this.init()
    endif
    return

  endif

endmethod
-- End of method definition for .apply(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: set an attribute on the glab/slab
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING  Attribute name
--   2  R  STRING  Value to be set
-- Return:
--
------------------------------------------------------------------------
define method .setAttribute(!attribute is STRING, !value is STRING)
-- TODO: Is this method necessary? Maybe move it to !!draLabelsFast

  -- If the form is active, the reference in the !!draLabelsFast form must
  -- be still correct and set!
  !ref = !!draLabelsFast.ref
  $!ref
  handle ANY $* Just in case the user deleted without refreshing the !!draLabelsFast form
    return
  endhandle
  $!attribute $!value

endmethod
-- End of method definition for .setAttribute(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      runMacro
--
-- Description: run an old macro
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING    string of synonym and macro to call
-- Return:
--
------------------------------------------------------------------------
define method .runMacro(!macroCall is STRING)
-- TODO: Is this method necessary? Maybe move it to !!draLabelsFast

  -- If the form is active, the reference in the !!draLabelsFast form must
  -- be still correct and set!
  !ref = !!draLabelsFast.ref
  $!ref
  handle ANY $* Just in case the user deleted without refreshing the !!draLabelsFast form
    return
  endhandle
  !!runSynonym(!macroCall)

endmethod
-- End of method definition for .runMacro(STRING)

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description: show form for gaps even if not defined
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .showForm()

  if(undefined(!!draGapManager)) then
    pml load form !!draGapManager
  endif

  !this.showForm(!!draGapManager)

endmethod
-- End of method definition for .showForm()

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description: show form relating to attributes list gadget
--
-- Method Type: Procedure
-- Arguments:
--   1  R   FORM   The form to show
-- Return:
--
------------------------------------------------------------------------
define method .showForm(!form is FORM)

  -- If the form is active, the reference in the !!draLabelsFast form must
  -- be still correct and set!
  !!draGapManager.ref = !!draLabelsFast.ref
  show !!$!form

endmethod
-- End of method definition for .showForm(FORM)

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description: show form relating to attributes list gadget
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING   Name of the form to show
-- Return:
--
------------------------------------------------------------------------
define method .showForm(!text is STRING)

  !ref = !!draLabelsFast.ref
  $!ref
  handle ANY $* Just in case the user deleted without refreshing the !!draLabelsFast form
    return
  endhandle
  show !!cdr$!text

endmethod
-- End of method definition for .showForm(STRING)

------------------------------------------------------------------------
--
-- Method:      setLabType
--
-- Description: Set the working mode of the form (GLAB/SLAB)
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   The type of the label (either GLAB or SLAB)
-- Return:
--
------------------------------------------------------------------------
define method .setLabType(!lType is STRING)

  if( !this.labType.eq(!lType) ) then
     return
  endif

  !this.labType = !lType
  if( !lType.eq('SLAB') ) then
    !this.xScale.visible = true
    !this.yScale.visible = true
    !this.lspa.visible = false
    !this.cspa.visible = false
    !this.lframe.visible = false
    !this.gbox.visible = false
    !this.cheiTemplate.visible = true
    !this.name.tag = 'SYMBOLIC Label:'
  else
    !this.xScale.visible = false
    !this.yScale.visible = false
    !this.lspa.visible = true
    !this.cspa.visible = true
    !this.lframe.visible = true
    !this.gbox.visible = true
    !this.cheiTemplate.visible = false
    !this.name.tag = 'GENERAL Label:'
 endif

endmethod
-- End of method definition for .setLabType(STRING)

------------------------------------------------------------------------
--
-- Method:      setMainPlines
--
-- Description: Establishes the Plines, whose names should come first in the list
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING   A string containing the space-separated names of the main P-lines
-- Return:
--
------------------------------------------------------------------------
define method .setMainPlines(!names is STRING)

  if( !names.empty() ) then
    !this.mainPlines = ARRAY()
  else
    !this.mainPlines = !names.split()
  endif

endmethod
-- End of method definition for .setMainPlines(STRING)

------------------------------------------------------------------------
--
-- Method:      setPkey
--
-- Description: Determines the list of the valid P-line names, including MEML and selects the current setting
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .setPkey()

  !temp = PLNAMES of DDNM
  handle ANY
    !plnames = ARRAY()
  elsehandle None
    !temp.sort()
    !plnames = !this.mainPlines.intersect(!temp)
    !plnames.appendArray(!temp.difference(!this.mainPlines))
  endhandle
  !plnames.insert(1, 'unset')
  !meml = MEML OF DDNM
  handle ANY
    !meml = STRING()
  endhandle
  if( !meml.unset() ) then
    !this.pkey.dText = !plnames
  else
    !dText = !plnames
    !dText.insert(2, 'MEML ($!meml)')
    !plnames.insert(2, 'MEML')
    !this.pkey.dText = !dText
  endif
  !this.pkey.rText = !plnames

  !pkey = PKEY
  handle ANY
    !pkey = 'unset'
  elsehandle None
    if( !pkey.unset() ) then
      !pkey = 'unset'
    elseif( !pkey.empty() ) then
      !pkey = 'unset'
    endif
  endhandle
  !this.pkey.select('Rtext', !pkey)
  !active = !pkey.neq('unset')
  !this.pkey.active = !active
  !this.pkdi.active = !active

endmethod
-- End of method definition for .setPkey()

------------------------------------------------------------------------
--
-- Method:      cbUpdatePkey
--
-- Description: Callback for the .pkey gadget - resets .nppt if necessary
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .cbUpdatePkey()
  !pkey = !this.pkey.selection()
  if( !pkey.neq('unset') ) then
    !this.nppt.val = 'unset'
  endif
endmethod
-- End of method definition for .cbUpdatePkey()

------------------------------------------------------------------------
--
-- Method:      reShape
--
-- Description: Callback for the .lshape and .llreshape gadgets
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   Operation mode (APPLY, GET, CHANGE, CONN, ATTA)
-- Return:
--
------------------------------------------------------------------------
define method .reShape(!mode is STRING)
  if( !mode.eq('GET') ) then

    -- Read the label's settings and populate the gadgets
    !lshape = LSHAPE
    !num = 1
    !angle = '0'
    if( !lshape.eq('Straight') ) then
      !num = 2
    else
      var !details LABEL LEAD SHAPE
      !allDetails = !details.split()
      if( !lshape.eq('Horizontal Angled') ) then
        !num = 5
        !angle = !allDetails[3]
      elseif( !lshape.eq('Vertical Angled') ) then
        !num = 6
        !angle = !allDetails[3]
      elseif( !lshape.eq('Angled Horizontal') ) then
        !num = 7
        !angle = !allDetails[2]
      elseif( !lshape.eq('Angled Vertical') ) then
        !num = 8
        !angle = !allDetails[2]
      elseif( !lshape.eq('Bent') ) then
        !offset = BPOF
        !size = !offset.size()
        if( !size.eq(2) ) then
          !num = 3
        elseif( !size.eq(4) ) then
          !num = 4
        endif
      endif
    endif
    !this.lshape.val = !num
    !this.llangle.val = !angle
    !this.llangle.active = !num.gt(4)

  elseif( !mode.eq('CHANGE') ) then

    !num = !this.lshape.val
    !this.llangle.active = !num.gt(4)

  elseif( !mode.eq('APPLY') ) then

    !num = !this.lshape.val
    if( !num.eq(1) ) then
      var !bpoffset BPOFFSET of OWNER
      !shape = LSHAPE of OWNER
      LSHAPE $!shape BPOFFSET $!bpoffset
    elseif( !num.eq(2) ) then
      LEAD STRAIGHT
    elseif( !num.eq(3) ) then
      prompt off
      prompt load escape |Indicate the position of the leader line's bend point|
      LEAD BENT @
      handle (61,528)
      endhandle
      prompt on
      prompt dismiss
    elseif( !num.eq(4) ) then
      prompt off
      prompt load escape |Indicate the positions of two leader line's bend points|
      LEAD BENT @ @
      handle (61,528)
      endhandle
      prompt on
      prompt dismiss
    else
      !angle = !this.llangle.val
      if( !num.eq(5) ) then
        LEAD HORIZONTAL $!angle DEG
      elseif( !num.eq(6) ) then
        LEAD VERTICAL $!angle DEG
      elseif( !num.eq(7) ) then
        LEAD $!angle DEG HORIZONTAL
      elseif( !num.eq(8) ) then
        LEAD $!angle DEG VERTICAL
      endif
    endif

  elseif( !mode.eq('CONN') or !mode.eq('ATTA') ) then

    if( undefined(!!draLabelOffset) ) then
      pml load form !!draLabelOffset
    endif
    !!draLabelOffset.mode = !mode
    show !!draLabelOffset

  endif

endmethod
-- End of method definition for .reShape(STRING)
