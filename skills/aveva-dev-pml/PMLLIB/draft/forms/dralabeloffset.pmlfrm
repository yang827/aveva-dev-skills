--
--  Description:     Undefined
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  atCursor()                       -                   Callback for setting the offset by cursor
--  draLabelOffset()                 -                   Constructor
--  explicitPosition()               -                   Callback for setting the offset explicitly
--  getData()                        -                   Loads the current values of the offsets
--  init()                           -                   Initialisation
--  validOffset(GADGET,STRING)       -                   Validation callback
--
setup form !!draLabelOffset dialog resize
  text .xOffset |Offset X:| tagwidth 7 width 8 is STRING
  path right
  hdist 1
  text .yOffset |Y:| tagwidth 3 width 8 is STRING
  button .cursor at xmin_xOffset ymax+0.2 |Indicate| width 8
  button .explicit |Explicit| width 8
  button .standard |Standard| width 8
  button .origin |Origin| width 8
  button .dismiss at xcen form-4 ymax+0.5 |Dismiss| width 8 OK

  member .mode is STRING
exit
-- End of form definition for !!draLabelOffset

------------------------------------------------------------------------
--
-- Method:      draLabelOffset
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
--
define method .draLabelOffset()

  !this.xOffset.val = '0'
  !this.yOffset.val = '0'
  !this.xOffset.validateCall = |!this.validOffset(|
  !this.yOffset.validateCall = |!this.validOffset(|
  !this.initCall        = |!this.init()|
  !this.cursor.callback = |!this.atCursor()|
  !this.explicit.callback = |!this.explicitPosition()|
  !this.mode = 'CONN'

endmethod
-- End of method definition for .draLabelOffset()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()

  if( !this.mode.eq('CONN') ) then
    !this.formTitle = 'Label''s connection point'
    !this.standard.callback = |CPOF STANDARD
                               !this.getData()|
    !this.origin.callback   = |CPOF ORIGIN
                               !this.getData()|
    !this.origin.active = true
  elseif( !this.mode.eq('ATTA') ) then
    !this.formTitle = 'Label''s attachment point'
    !this.standard.callback = |APOF 0 0
                               !this.getData()|
    !this.origin.active = false
  else
    return error 1 |Unsupported mode for !!draLabelOffset form|
  endif
  !this.getData()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      getData
--
-- Description: Loads the current values of the offsets
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .getData()
  if( !this.mode.eq('CONN') ) then
    var !value CPOF
    if( !value.eq('Standard') ) then
      !this.xOffset.val = 'STANDARD'
      !this.yOffset.val = 'STANDARD'
    else
      !parts = !value.split()
      !this.xOffset.val = !parts[1]
      !this.yOffset.val = !parts[2]
    endif
  elseif( !this.mode.eq('ATTA') ) then
    var !value APOF
    if( !value.eq('unset') ) then
      !this.xOffset.val = 'UNSET'
      !this.yOffset.val = 'UNSET'
    else
      !parts = !value.split()
      !this.xOffset.val = !parts[1]
      !this.yOffset.val = !parts[2]
    endif
  endif
endmethod
-- End of method definition for .getData()

------------------------------------------------------------------------
--
-- Method:      validOffset
--
-- Description: Validation callback
--
-- Method Type: Procedure
-- Arguments:
--   1   R   GADGET  The gadget being validated
--   2   R   STRING  The action string (dummy)
-- Return:
--
------------------------------------------------------------------------
define method .validOffset(!gadget is GADGET, !dummyAction is STRING)
  !valStr = !gadget.val
  !value = !valStr.real()
  handle (2,441)
    !err = false
    if( !this.mode.eq('CONN') ) then
      !err = !valStr.neq('STANDARD')
    elseif( !this.mode.eq('ATTA') ) then
      !err = !valStr.neq('UNSET')
    else
      !err = true
    endif
    if( !err ) then
      return error 1 |Offset value '$!valStr' is not supported!|
    endif
  endhandle
endmethod
-- End of method definition for .validOffset(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      atCursor
--
-- Description: Callback for setting the offset by cursor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .atCursor()
  prompt off
  if( !this.mode.eq('CONN') ) then
    prompt load escape |Indicate the connection point with the cursor|
    LEAD CONN @
    handle (61,528)
    endhandle
  elseif( !this.mode.eq('ATTA') ) then
    prompt load escape |Indicate the attachment point with the cursor|
    LEAD ATTACH @
    handle (61,528)
    endhandle
  endif
  prompt on
  prompt dismiss
  !this.getData()
endmethod
-- End of method definition for .atCursor()

------------------------------------------------------------------------
--
-- Method:      explicitPosition
--
-- Description: Callback for setting the offset explicitly
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .explicitPosition()
  !xOffset = !this.xOffset.val
  !yOffset = !this.yOffset.val
  if( !this.mode.eq('CONN') ) then
    !strValue = 'STANDARD'
    !keyword  = 'CPOF'
  else
    !strValue = 'UNSET'
    !keyword  = 'APOF'
  endif
  !value = !xOffset.real()
  handle (2,441)
    !value = !yOffset.real()
    handle (2,441)
      $!keyword $!strValue
    elsehandle None
      !!alert.warning(|Both X and Y offsets should be numerical or both set to '$!strValue'|)
    endhandle
  elsehandle None
    !value = !yOffset.real()
    handle (2,441)
      !!alert.warning(|Both X and Y offsets should be numerical or both set to '$!strValue'|)
    elsehandle None
      $!keyword $!xOffset $!yOffset
      handle any
      	!this.xOffset.val = 'UNSET'
        !this.yOffset.val = 'UNSET'
      endhandle
    endhandle
  endhandle
endmethod
-- End of method definition for .explicitPosition()
