--
------------------------------------------------------------------------
define method .active(!option is BOOLEAN)
     !this.name.active = !option
     --!this.elemopt.active = !option
     !this.reattach.active = !option
     !this.nppt.active = !option
     !this.idpl1.active = !option
     !this.pkey.active = !option
     !this.pkdi.active = !option
     !this.idpl2.active = !option
     !this.angle.active = !option
     !this.adegpline.active = !option
     !this.blnktext.active = !option
     !this.blnk.active = !option
     !this.bmar.active = !option
     !this.atts.active = !option
     !this.oset.active = !option
     !this.sName.active = !option
     --!this.sCreate.active = !option
     --!this.sCopy.active = !option
     --!this.sShowLib.active = !option
     --!this.sElemopt.active = !option
     !this.sReattach.active = !option
     !this.sNppt.active = !option
     !this.sIdpl1.active = !option
     !this.sPkey.active = !option
     !this.sPkdi.active = !option
     !this.sIdpl2.active = !option
     !this.sAngle.active = !option
     !this.sAdegpline.active = !option
     !this.sBlnktext.active = !option
     !this.sBlnk.active = !option
     !this.sBmar.active = !option
     !this.xScale.active = !option
     !this.yScale.active = !option
     !this.sOset.active = !option
     !this.resel.active = !option
     !this.sAtts.active = !option


     !this.apply.active   = !option
     !this.gaps.active    = !option
     !this.dismiss.active = !option

endmethod
-- End of method definition for .active(BOOLEAN)
------------------------------------------------------------------------
--
-- Method:      close()
--
-- Description: close the form and tidy up
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

if(!this.ref.set()) then
  unenhance $!this.ref
endif

endmethod
-- End of method definition for .close()
------------------------------------------------------------------------
--
-- Method:      openCall()
--
-- Description: show the slab library
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .openCall(!gadget is GADGET, !event is STRING)

  -- This is needed to prevent initialisation clicking back to General label if tracking ce as a GLAB
  if (!!ce.type eq 'GLAB' or !!ce.type eq 'SLAB') then
    end
  endif

 if(!gadget.name().eq('SLABEL') and !event.eq('SHOWN')) then
  !this.showLibrary()
 else
  !this.hideLibrary()
 endif
endmethod
-- End of method definition for .openCall(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      idMemberOf(STRING)
--
-- Description: Identifies a direct member of an element having the given type
--
-- Method Type: Function
-- Arguments:
--   1  R STRING  The type of the owner
--   2  R STRING  The prompt string
-- Return:
--   DBREF   The reference found (unset if cancelled)
--
------------------------------------------------------------------------
define method .idMemberOf(!type is STRING, !prompt is STRING) is DBREF
  do
    prompt off
    prompt load escape |$!prompt|
    -- Identify Any Design element
    !ref = REF of IDEN DESEL @
    handle (61,528)
      !ref = object DBREF() $* cancelled
      return !ref
    endhandle
    do
      !owner = !ref.owner
      break if( !owner.unset() )        $* WORLD reached, no owner of the given type found
      if( !owner.type.eq(!type) ) then  $* required owner found!
        return !ref
      endif
      !ref = !owner                     $* continue search upwards the hierarchy
    enddo
  enddo
endmethod
-- End of method definition for .idMemberOf(STRING)
