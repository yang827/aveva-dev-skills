-- File:            dralabels.pmlfrm
--   Type:          Form Definition
--   Group:         Labels
--
--     Keyword:     LABEL
--   Module:        Draft
--   Replaces:
--
-- Author:          Andy.Kirkland
-- Created:         Wed May 19    07:55:43  2004
--
--
-- Description:
-- General form for creating and modification of labels (SLAB and GLAB)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -                   grey out most of the form if not at a SLAB,GLAB
--  apply(STRING,STRING)             -                   Initialisation
--  close()                          -                   close the form and tidy up
--  draLabels()                      -                   Constructor
--  hideLibrary()                    -                   hide library form
--  idMemberOf(STRING,STRING)        DBREF               Identifies a direct member of an element having the given type
--  init(BOOLEAN)                    -                   Initialisation
--  openCall(GADGET,STRING)          -                   show the slab library
--  runMacro(STRING)                 -                   run an old macro
--  setAttribute(STRING,STRING)      -                   set an attribute on the glab/slab
--  showForm()                       -                   show form for gaps even if not defined
--  showForm(FORM)                   -                   show form relating to attributes list gadget
--  showForm(STRING)                 -                   show form relating to attributes list gadget
--  showLibrary()                    -                   show library form
--
------------------------------------------------------------------------

setup form !!draLabels at xr 0 yr 0 dialog docking

  track 'PADDCE' call '!this.init(FALSE)'

  path down
  vdist 0.5
  !framePos = 'at xmin ymin width 35 height 8'
 frame .tabset tabset at x0 y0
   frame .gLabel   'General Labels' $!framePos
    text .name at x0.1 ymin+0.3  width 42 string
    !this.name.setEditable(false)

    button .create    'Create NEW'  at xmin_name ymax+0.2
    button .copy      'Create COPY' at xmax+1    ymin
    option .elemopt   'Attach to'   at x0        ymax+0.2  width 18
    button .reattach  'Re-Attach'   at xmax+1    ymin
    path right hdist 0.2
    text .nppt        ' PPoint  '   at x0     ymax+0.2 width 3 int
    button .idpl1      'Cursor'     at xmax+1 ymin
    path right hdist 0.2
    text .pkey         ' Pline   '  at x0     ymax+0.2 width 6 string
    text .pkdi         'Proportion'                    width 6 is REAL format !!realFmt
    button .idpl2      'Cursor'
    text .angle        ' Rotate  '  at x0     ymax+0.2 width 10 is REAL format !!angleFmt
    option   .adegpline 'Along Pline Axis' at xmax+0.2 ymin width 2

    para .blnktext              at x0       ymax+0.5 text 'Blanking'
    toggle .blnk                at xmax+0.5 ymin
    text .bmar   'Blank Margin' at xmax+3   ymin      width 5 is REAL format !!distanceFmtForm
    option .atts ' Attributes'  at x0       ymax+0.5  width 16
    path down
    option .oset ' Offset'      at x0 ymax+0.5 width 8

   exit
   frame .sLabel 'Symbolic Labels' $!framePos
    text .sName at x0.1 ymin+0.3 width 42 string
    !this.sName.setEditable(false)

    button .sCreate   'Create NEW'   at xmin.sName ymax+0.2
    button .sCopy     'Create COPY'  at xmax+1     ymin
    button .sShowLib  'Show Library' at xmax+1     ymin
    option .sElemopt  'Attach to'    at x0         ymax+0.2   width 18
    button .sReattach 'Re-Attach'    at xmax+1     ymin
    path right hdist 0.2
    text   .sNppt       ' PPoint  '  at x0         ymax+0.2   width 3 int
    button .sIdpl1     'Cursor'      at xmax+1     ymin
    path right hdist 0.2
    text   .sPkey       ' Pline   '  at x0         ymax+0.2 width 6 string
    text   .sPkdi       'Proportion' width 6 is REAL
    button .sIdpl2     'Cursor'
    text   .sAngle      ' Rotate  '  at x0         ymax+0.2  width 10 is REAL format !!angleFmt
    option .sAdegpline 'Along Pline Axis' at       xmax+0.2  ymin  width 2
    para   .sBlnktext                     at x0       ymax+0.5 text 'Blanking'
    toggle .sBlnk                         at xmax+0.5 ymin
    text   .sBmar 'Blank Margin '         at xmax+3   ymin width 5 is REAL format !!realFmt
    path right
    hdist 1
    text   .xScale     'Scale  X '         at x0       ymax+0.5  width 8 is REAL format !!realFmt
    text   .yScale     'Y '                                     width 8 is REAL format !!realFmt
    option .sOset 'Offset '                at x0       ymax+0.5  width 8

    button .resel 'Reselect Library label' at x0       ymax+0.2
    button .sAtts 'Attributes...'          at xmax     ymin

   exit

  exit


    button .apply   'Apply'                at x1             ymax+0.5
    button .gaps    'Create Gaps...'          at xmax+0.2 ymin
    button .dismiss 'Dismiss'              at xmax form-size ymin cancel

  member .ref is DBREF

exit
-- End of form definition for !!draLabels
------------------------------------------------------------------------
--
-- Method:      draLabels()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draLabels()

-- form setup
   !this.formTitle       = 'Labels'
   !this.iconTitle       = 'Labs'
   !this.callback        = '!this.init(TRUE)'
   !this.cancelCall      = ''
   !this.formRevision    = '$Revision: '
   !this.gLabel.callback = '!this.openCall('
   !this.sLabel.callback = '!this.openCall('

   !dText[1] = '+X'
   !dText[2] = '+Y'
   !dText[3] = '+Z'
   !dText[4] = '-X'
   !dText[5] = '-Y'
   !dText[6] = '-Z'

   !this.adegpline.dText = !dText
   !this.sAdegpline.dText = !dText

   !dText = ARRAY()
   !dText[1] = 'Relative'
   !rText[1] = 'TRUE'
   !dText[2] = 'Absolute'
   !rText[2] = 'FALSE'

   !this.oset.dText   = !dText
   !this.oset.rText   = !rText
   !this.sOset.dText  = !dText
   !this.sOset.rText  = !rText

   !dText = ARRAY()
   !rText = ARRAY()

   !dText[1] = 'text Settings...'
   !dText[2] = 'text Contents...'
   !dText[3] = 'Frame...'
   !dText[4] = 'Leader Line...'
   !rText[1] = 'GLTXATT'
   !rText[2] = 'Qtext'
   !rText[3] = 'GLLFATT'
   !rText[4] = 'GLLLATT'

   !this.atts.dText          = !dText
   !this.atts.rText          = !rText

-- Callbacks  for GLABs
   !this.copy.callback       = |!this.apply('COPY','')|
   !this.create.callback     = |!this.apply('CREATE','')|
   !this.elemopt.callback    = |CALLIBM MELEMTAB SELECT _draLabels $<$$_ELEMOPT$> _ELEMOPT|
   !this.reattach.callback   = |!this.apply('ATTACH','')|
   !this.idpl1.callback      = |!this.apply('POINT','')|
   !this.idpl2.callback      = |!this.apply('CURS','')|
   !this.adegpline.callback  = |!this.apply('ALIGN',!!draLabels.adegpline.selection())|
   !this.atts.callback       = |!this.showForm(!this.atts.selection())|

-- Callbacks for SLABs
   !this.sCopy.callback      = |!this.apply('COPY','')|
   !this.sCreate.callback    = |!this.apply('CREATE','')|
   !this.sShowLib.callback   = |!this.showLibrary()|
   !this.sElemopt.callback   = |CALLIBM MELEMTAB SELECT _draLabels $<$$_SELEMOPT$> _SELEMOPT|
   !this.sReattach.callback  = |!this.apply('ATTACH','')|
   !this.sIdpl1.callback     = |!this.apply('POINT','')|
   !this.sIdpl2.callback     = |!this.apply('CURS','')|
   !this.sAdegpline.callback = |!this.apply('ALIGN',!!draLabels.sAdegpline.selection())|
   !this.resel.callback      = |!this.apply('RESEL','')|
   !this.sAtts.callback      = |!this.showForm('SLABATT')|

-- general callbacks
   !this.apply.callback      = |!this.apply('APPLY','')|
   !this.gaps.callback       = |!this.showForm()|
   !this.dismiss.callback    = |!this.close()|
   !this.cancelCall          = |!this.close()|

endmethod
-- End of method definition for .draLabels()
------------------------------------------------------------------------
--
-- Method:      init(BOOLEAN)
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!apply is BOOLEAN)
  !isShown = !!cdrSylalib.shown()
  handle ANY
    !isShown = false
  endhandle
  if( !isShown ) then
    !this.sShowLib.tag = 'Hide Library'
  else
    !this.sShowLib.tag = 'Show Library'
  endif
-- don't want the navigation of the SetLayer Function
  !ref = !!ce
    call !!draSetLayer('','LAB')
    !layer = !!ce

  !!ce = !ref

-- which label type GLAB or SLAB
  !type = !!ce.type
  if(!type.eq('GLAB')) then
    !this.active(TRUE)
    !labType = ''
    !this.gLabel.visible = TRUE
  elseif(!type.eq('SLAB')) then
    !this.active(TRUE)
    !labType = 'S'
    !this.sLabel.visible = TRUE
  else
    !this.active(FALSE)
  endif
  !this.ref = !!ce

if(!type.eq('GLAB') or !type.eq('SLAB')) then

  !this.attribute(!labType + 'name').val = (FULLNAME of DDNM)
  handle ANY
    !this.attribute(!labType + 'name').val = FULLNAME
    -- initialise default type list
    !!runSynonym('CALLIBM MELEMTAB DEFAULT _draLabels _elemeOpt')
    !!runSynonym('CALLIBM MELEMTAB DEFAULT _draLabels _sElemeOpt')
  elsehandle NONE
    var !ddnmtype (FULLTYPE of DDNM)
    -- select the element type in list
    !!runSynonym('CALLIBM MELEMTAB INIT _draLabels $!ddnmtype _elemOpt')
    !!runSynonym('CALLIBM MELEMTAB INIT _draLabels $!ddnmtype _sElemOpt')
  endhandle

if(!type.eq('SLAB')) then
  !xyScale = !!ce.xyScale
  !this.xScale.val = !xyScale[1]
  !this.yScale.val = !xyScale[2]
endif

-- set the gadgets to the attribute values of the label.
   !this.attribute(!labType + 'name').setTooltip(!this.name.val)
   var !pkdi PKDI
   !this.pkdi.val    = !pkdi.real()
   handle any
     !this.pkdi.val  = 0
   endhandle
   !this.sPkdi.val   = !pkdi.real()
   handle any
     !this.sPkdi.val = 0
   endhandle
   var !pkey PKEY
   !this.pkey.val    = !pkey
   handle any
     !this.pkey.val  = 'unset'
   endhandle
   !this.sPkey.val   = !pkey
   handle any
     !this.sPkey.val = 'unset'
   endhandle
   !this.nppt.val    = !!ce.nppt.string()
   handle any
     !this.nppt.val  = ''
   endhandle
   !this.sNppt.val   = !!ce.nppt.string()
   handle any
     !this.sNppt.val = ''
   endhandle
   !this.angle.val   = !!ce.adeg
   handle any
     !this.angle.val   = 0
   endhandle
   !this.sAngle.val  = !!ce.adeg
   handle any
     !this.sAngle.val  = 0
   endhandle

   !oset = !!ce.oset
   handle NONE
     -- (AK) I don't think this will ever fail??
     !this.oset.select('rText',!oset.string())
     !this.sOset.select('rText',!oset.string())
   elsehandle any
     !this.oset.val  = 1
     !this.sOset.val = 1
   endhandle

   !blnk = !!ce.blnk
   handle NONE
     if (!blnk) then
       !this.blnk.val  = TRUE
       !this.sBlnk.val = TRUE
     else
       !this.blnk.val  = FALSE
       !this.sBlnk.val = FALSE
     endif
   elsehandle ANY
     !this.blnk.val  = FALSE
     !this.sBlnk.val = FALSE
   endhandle

   !this.bmar.val = !!ce.bmar
   handle any
     !this.bmar.val = 0
   endhandle
   !this.sBmar.val = !!ce.bmar
   handle any
     !this.sBmar.val = 0
   endhandle

   unenhance all (slab glab) for shee
   enhance  ce

else

  !this.name.val = FULLNAME
  !this.sName.val = FULLNAME

  -- initialise default type list
  --!!runSynonym('CALLIBM MELEMTAB DEFAULT _draLabels _sElemOpt')
  --!!runSynonym('CALLIBM MELEMTAB DEFAULT _draLabels _elemOpt')
 if(!apply) then
   !!runSynonym('CALLIBM MELEMTAB INIT _draLabels All _elemOpt')
   !!runSynonym('CALLIBM MELEMTAB INIT _draLabels All _sElemOpt')
 endif

endif

endmethod
-- End of method definition for .init(BOOLEAN)
------------------------------------------------------------------------
--
-- Method:      apply()
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply(!mode is STRING, !opt is STRING)

-- make sure the correct layer is set
   call !!draSetLayer('','LAB')
   !layer = !!ce

$(-- check for valid call (not required any more (AK))
if(!mode.eq(||)) then
  return error 1 |Invalid call to method Apply|
endif

!valid =  '_CREATE_COPY_ATTACH_APPLY_CURS_POINT_ALIGN_'
!check = !valid.match(!mode).eq(0)
if (!check) then
  return error 1 |Invalid call to method Apply|
endif
$)

-- ref and validate...
!!ce = !this.ref
handle (2,822)
  !this.init(FALSE)
  return
endhandle

!valid = 'COPY ATTACH RESEL CURS POINT'
!check = !valid.match(!mode).neq(0)
if(!check) then
  !udtype = !!ce.type
  !ceChanged = false
  if(!udtype.neq(|GLAB|) and !this.gLabel.visible) then
    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify general label required...|
    ID GLAB @
    handle(61,528)
      prompt on
      return
    endhandle
    PROMPT ON
    !ceChanged = !!ce.neq(!this.ref)
  elseif(!udtype.neq(|SLAB|) and !this.sLabel.visible) then
    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify symbolic label required...|
    ID SLAB @
    handle (61,528)
      prompt on
      return
    endhandle
    PROMPT ON
    !ceChanged = !!ce.neq(!this.ref)
  endif
  if( !mode.eq('COPY') ) then
    if( !ceChanged ) then
      if( !this.gLabel.visible ) then
        !attName = 'elemopt'
      else
        !attName = 'selemopt'
      endif
      !curSelection = !this.$!attName$n.selection()
      !this.init(TRUE)
      !!runSynonym('CALLIBM MELEMTAB INIT _draLabels $!curSelection _elemOpt')
      !!runSynonym('CALLIBM MELEMTAB INIT _draLabels $!curSelection _sElemOpt')
    endif
  else
    !this.init(TRUE)
  endif

endif

--
--------------------->>> attach label to a ppoint <<<--------------------------
--
if(!mode.eq('POINT')) then

    ON IDP @
    handle (61,528)
      return
    endhandle
    !this.init(TRUE)
    return

--
--------------------->>> Align label ADEG to a pline <<<--------------------------
--
elseif(!mode.eq('ALIGN')) then

    !pkey  = !!ce.pkey
    !ddnm  = !!ce.ddnm

    -- check that user is attached to a PLINE
    if(!pkey.eq(||)) then
      return error 1 |This label is NOT attached to a Pline|
    endif

    ANGLE PPLINE $!pkey OF $!ddnm $!opt
    !this.angle.val  = !!ce.adeg.string()
    !this.sAngle.val = !!ce.adeg.string()
    !this.init(TRUE)
    return


------------------->>> Reselect SLAB TMRF <<<--------------------------

elseif(!mode.eq('RESEL')) then

   -- Set the TMRF of the SYMB
   if(undefined(!!cdrSylalib) or defined(!!cdrSylalib) and !!cdrSylalib.shown().not()) then
     !!runSynonym('CALLDRS USHOWLIB SLAB')
     !!alert.warning('Symbol Library form must be displayed before creating a new symbol. Continue by pressing the "Create NEW" button again...')
     return
   endif
   !!ce = !this.ref
    prompt off
    prompt load escape |Identify library label required|
    TMRF ID SYTM TXTM @
    handle (61,528)
      prompt on
      return
    endhandle
    prompt on

    return

--
--------------------->>> attach label to a pline <<<--------------------------
--

elseif(!mode.eq('CURS')) then

    ON IDPD @
    handle (61,528)
      return
    endhandle
    if(!!ce.pkdi.lt(0)) then
      var !pkdi neg(PKDI)
      PKDI $!pkdi
    endif
    !this.init(TRUE)
    return

--
--------------------->>> Apply <<<--------------------------
--
elseif(!mode.eq('APPLY')) then
  !!ce = !this.ref
  !type = !!ce.type
  if(!type.eq(|GLAB|) or !type.eq(|SLAB|)) then
    if(!type.eq(|SLAB|)) then
      XYSCALE $!this.xScale.val $!this.yScale.val
      !labType = 's'
    else
      !labType = ''
    endif
      !angle = !this.attribute(!labType + 'angle').val
      ANGLE $!angle
      handle (64,382) $* data not accessible for code word...
      endhandle
    if(!this.attribute(!labType + 'pkey').val.neq(||) and !this.attribute(!labType + 'pkey').val.neq(|unset|)) then
      !pkey = !this.attribute(!labType + 'pkey').val
      PKEY $!pkey
      handle (64,382) $* data not accessible for code word...
      endhandle
    endif
    if(!this.attribute(!labType + 'nppt').val.neq(||) and !this.attribute(!labType + 'nppt').val.neq(|-1|)) then
      !nppt = !this.attribute(!labType + 'nppt').val
      NPPT $!nppt
      handle (64,382) $* data not accessible for code word...
      elsehandle (2,21)
        error |Ppoint $!nppt does not exist|
        !this.attribute(!labType + 'nppt').val = !!ce.nppt
      endhandle
     endif
    if(!this.attribute(!labType + 'pkdi').val.set()) then
      !pkdi = !this.attribute(!labType + 'pkdi').val
      PKDI $!pkdi
      handle (64,382)  $* data not accessible for code word...
      endhandle
    endif
    !oset = !this.attribute(!labType + 'oset').selection()
    OSET $!oset
    if(!this.attribute(!labType + 'blnk').val) then
      BLNK true
    else
      BLNK false
    endif
    !bmar = !this.attribute(!labType + 'bmar').val
    BMAR $!bmar
    !this.init(TRUE)
  endif
return

--
--------------------->>> Create COPY of GLAB <<<--------------------------
--
elseif(!mode.eq('COPY')) then
  !type = !this.ref.type
    -- move to layer
    --!!runSynonym('CALLIBM UGETLAYE LAYE')
    !!ce = !layer

    if(!type.eq(|SLAB|)) then
      !labType = 's'
      !gType = 'SLAB'
    else
      !labType = ''
      !gType   = 'GLAB'
    endif

    !idType = !this.attribute(!labType + 'elemopt').selection()

    !!ce = !this.ref

    -- determine if label is attached to a pline
    -- if so, set ID to IDPL (to obtain proportional distance)
    if(!!ce.pkey.neq(|unset|)) then
      if(!!ce.pkdi.eq(0) or !!ce.pkdi.eq(1)) then
        !id =  'IDPD'
        !idt = 'ON'
        !logend = TRUE
      else
        !id  = 'ID'
        !idt = 'DDNM'
        !logend = FALSE
      endif
    else
        !id  = 'ID'
        !idt = 'DDNM'
        !logend = FALSE
    endif

--
--------------------->>> Create NEW GLAB <<<--------------------------
--
elseif(!mode.eq('CREATE') and !this.gLabel.visible) then

    !labType = ''
    !elemType = !this.attribute(!labType + 'elemopt').selection()

   do
    -- move to layer
    --!!runSynonym('CALLIBM UGETLAYE LAYE')
    !!ce = !layer
    !idType = !elemType
    if (!idType.eq(|ALL|) or !idType.eq(|DESEL|)) then
      prompt off
      prompt load escape |Identify Any Design element for NEW label...|
      var !idType |DESEL|
    elseif( !idType.eq(|BRANCH MEMBERS|) ) then
      var !idType |*BM*|
    else
      prompt off
      prompt load escape |Identify $!idType Design element for NEW label...|
    endif

    if( !idType.eq('*BM*') ) then
      !atRef = !this.idMemberOf('BRAN', 'Identify any Design element being a Branch Member for a NEW label...')
    else
      !atRef = REF of IDEN $!idType @
      handle (61,528)
        !atRef = object DBREF() $* simulate a cancellation
      endhandle
    endif
    prompt on
    -- TL: Should not be necessary, but apparently after the ID command, the dbtype
    -- TL: is set to DESI, whereas it should remain at PADD.
    -- TL: Observed cases, where multiple switch commands were needed to return from
    -- TL: DESI to PADD - that's why there is a do loop.
    do
      !dbt = !!ce.dbtype
      break if (!dbt.eq('PADD'))
      switch
    enddo
    if( !atRef.unset() ) then
      -- re-init form
      !!ce = !this.ref
      !this.init(FALSE)
      return
    endif
--    !obj = !atRef.name
--    new GLAB BTEX |#NAME(C2:)| ON $!obj
$* P-42498 use !atRef not !atRef.name in case of duplication
    new GLAB BTEX |#NAME(C2:)| ON $!atRef
    prompt dismiss
    enhance sole ce
    !this.ref = !!ce
   enddo

--
--------------------->>> Create NEW SLAB <<<--------------------------
--
elseif(!mode.eq('CREATE') and !this.sLabel.visible) then

  !labType = 's'
  !elemType = !this.attribute(!labType + 'elemopt').selection()

  -- Set the TMRF of the SYMB
  --var !DISP form _CDRSYLALIB disp
  if(undefined(!!cdrSylalib) or defined(!!cdrSylalib) and !!cdrSylalib.shown().not()) then
     !!runSynonym('CALLDRS USHOWLIB SLAB')
     !!alert.warning('Symbol Library form must be displayed before creating a new symbol. Continue by pressing the "Create NEW" button again...')
     return
  endif
  prompt off
  prompt load escape |Identify library label required|
  ID SYTM TXTM @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on
  var !template REF

  -- move to layer
  --!!runSynonym('CALLIBM UGETLAYE LAYE')
  !!ce = !layer
  do
    !idType = !elemType
    if (match (|$!idType| , |#|) gt 0) then
      return error 1 |You must select an element type for Attach|
    elseif (|$!idType| eq |ALL| or |$!idType| eq |DESEL| ) then
      prompt off
      prompt load escape |Identify Any Design element for NEW label...|
      !idType = 'DESEL'
    elseif( !idType.eq(|BRANCH MEMBERS|) ) then
      !idType = |*BM*|
    else
      prompt off
      prompt load escape |Identify $!idType Design element for NEW label...|
    endif

    if( !idType.eq('*BM*') ) then
      !atRef = !this.idMemberOf('BRAN', 'Identify any Design element being a Branch Member for a NEW label...')
    else
      !atRef = REF of IDEN $!idType @
      handle (61,528)
        !atRef = object DBREF() $* simulate a cancellation
      endhandle
    endif

    prompt on
    -- TL: Should not be necessary, but apparently after the ID command, the dbtype
    -- TL: is set to DESI, whereas it should remain at PADD.
    -- TL: Observed cases, where multiple switch commands were needed to return from
    -- TL: DESI to PADD - that's why there is a do loop.
    do
      !dbt = !!ce.dbtype
      break if (!dbt.eq('PADD'))
      switch
    enddo
    if( !atRef.unset() ) then
      -- re-init form
      !!ce = !this.ref
      !this.init(FALSE)
      return
    endif
--    !obj = !atRef.name
--    new SLAB TMRF $!template ON $!obj
$* P-42498 use !atRef not !atRef.name in case of duplication
    new SLAB TMRF $!template ON $!atRef
    prompt on
    prompt dismiss

    !this.ref = !!ce

  enddo

--
--------------------->>> Attach to new design item <<<--------------------------
--
elseif(!mode.eq('ATTACH')) then

    !!ce = !this.ref

    !idType = !this.elemopt.selection()

    if(!idType.eq('ALL')) then
      prompt off
      prompt load escape |Identify NEW Design element for label...|
      !idType = 'DESEL'
    elseif( !idType.eq(|BRANCH MEMBERS|) ) then
      !idType = |*BM*|
    else
      prompt off
      prompt load escape |Identify NEW $!idType Design element for label...|
    endif

    if( !idType.eq(|*BM*|) ) then
      !atRef = !this.idMemberOf('BRAN', 'Identify NEW Design element being a Branch Member for label...')
    else
      !atRef = REF of ID $!idType @
      handle (61,528)
        !atRef = object DBREF()
      endhandle
    endif
    prompt on
    if( !atRef.set() ) then
      ON $!atRef
      -- re-init form
      !this.init(FALSE)
    endif
    return

  endif

  --  label /CPAGAIN
  do
      if(!idType.match('#').gt(0)) then
        return error 1 |You must select an element type for Attach|
      elseif (!idType.eq('ALL') or !logend) then
        prompt off
        prompt load escape |Identify Any Design element for NEW label...|
        -- substitute from var for local var (Bug workaround)
        new $!gType copy $!this.ref
        handle (64,382) $* data inaccessible for codeword...
        endhandle
        $!idt $!id @
        handle (61,528)
          DELETE $!gType
          prompt on
          prompt dismiss
          break
        elsehandle (64,382) $* data inaccessible for codeword...
        endhandle
        prompt on
        prompt dismiss
      elseif( !idType.eq('BRANCH MEMBERS') ) then
        -- substitute from var for local var (Bug workaround)
        !logend = false
        new $!gType copy $!this.ref
        handle (64,382) $* data inaccessible for codeword...
        endhandle
        !atRef = !this.idMemberOf('BRAN', 'Identify any Design element being a Branch Member for a NEW label...')
        if( !atRef.unset() ) then
          DELETE $!gType
          prompt on
          prompt dismiss
          break
        else
          $!idt $!atRef
          handle( 64,382) $* data inaccessible for codeword...
          endhandle
          prompt on
          prompt dismiss
        endif

      else
        prompt off
        prompt load escape |Identify $!idType Design element for NEW label...|
        -- substitute from var for local var (Bug workaround)
        new $!gType copy $!this.ref
        handle (64,382) $* data inaccessible for codeword...
        endhandle
        $!idt $!id $!idType @
        handle (61,528)
          DELETE $!gType
          prompt on
          prompt dismiss
          break
        elsehandle (64,382) $* data inaccessible for codeword...
        endhandle
        prompt on
        prompt dismiss
      endif

      -- adjust start/end positioned PKDI values
      if(!logend) then
        if(!!ce.pkdi.lt(0.5)) then
          PKDI 0
        else
          PKDI 1
        endif
        -- reset PKEY from form setting
        !pkey = !this.attribute(!labType + 'pkey').val
        PKEY  $!pkey
        handle (64,285) $* PPLINE does not exist for element
          -- warn user and attempt to attach to NA
          error |Pline $!this.pkey.val does not exist for identified element|
          PKEY NA
          handle (64,285)
            PKEY 0
          endhandle
        endhandle
      endif

      !this.ref =!!ce

      refresh

  enddo
  --  golabel /CPAGAIN

    -- re-init form
    !!ce = !this.ref
    !this.init(FALSE)

    refresh

    return

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      setAttribute(STRING, STRING)
--
-- Description: set an attribute on the glab/slab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Attribute to set]
--   [2] [R]    [STRING]    [Value to set it to]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAttribute(!attribute is STRING, !value is STRING)

!!ce = !this.ref
$!attribute $!value

endmethod
-- End of method definition for .setAttribute()
------------------------------------------------------------------------
--
-- Method:      runMacro(STRING)
--
-- Description: run an old macro
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [string of synonym and macro to call]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runMacro(!macroCall is STRING)

!!ce = !this.ref

!!runSynonym(!macroCall)

endmethod
-- End of method definition for .runMacro(STRING)
------------------------------------------------------------------------
--
-- Method:      showForm()
--
-- Description: show form for gaps even if not defined
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Form to show]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showForm()

if(undefined(!!draGapManager)) then
  pml load form !!draGapManager
endif

 !this.showForm(!!draGapManager)

endmethod
-- End of method definition for .showForm()
------------------------------------------------------------------------
--
-- Method:      showForm(FORM)
--
-- Description: show form relating to attributes list gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Form to show]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showForm(!form is FORM)

  !!ce = !this.ref

  !!draGapManager.ref = !this.ref

  show !!$!form

endmethod
-- End of method definition for .showForm(FORM)
------------------------------------------------------------------------
--
-- Method:      showForm(STRING)
--
-- Description: show form relating to attributes list gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Form to show]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showForm(!text is STRING)

  !!ce = !this.ref

  show !!cdr$!text

endmethod
-- End of method definition for .showForm(STRING)
------------------------------------------------------------------------
--
-- Method:      showLibrary()
--
-- Description: show library form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showLibrary()
!!runSynonym('CALLDRS USHOWLIB SLAB')
if(!!cdrSylalib.shown()) then
  !this.sShowLib.tag = 'Hide Library'
else
 !this.sShowLib.tag = 'Show Library'
endif
endmethod
-- End of method definition for .showLibrary()
------------------------------------------------------------------------
--
-- Method:      hideLibrary()
--
-- Description: hide library form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hideLibrary()

!!cdrSylalib.hide()
!this.sShowLib.tag = 'Show Library'

endmethod
-- End of method definition for .hideLibrary()
------------------------------------------------------------------------
