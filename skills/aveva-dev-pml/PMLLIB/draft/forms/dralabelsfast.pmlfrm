--
--  File:            dralabelsfast.pmlfrm
--    Type:          Form Definition
--    Group:         Labels
--      Keyword:     Labels
--    Module:        Draft
--  Author:          T.Lisowski/Karl Martin-Chambers
--  Created:         Fri Feb 29 17:43:05 2008
--
--  Description:     The form handling the creation of General or Symbolic Labels
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyLLTypeAngle(BOOLEAN)        -                   Update the leader line type and attribute
--  applyTemplate(DBREF)             -                   Update the symbol template
--  applyText()                      -                   Update the text
--  attach(BOOLEAN)                  -
--  chooseFromTree()                 -                   Re-attaches the label after a selection in the .tree gadget
--  close()                          -                   close the form and tidy up
--  collectTree()                    -                   Collects the elements for the owner's list for DDNM
--  copyText()                       -                   Copies the text from another drawing's element
--  draLabelsFast()                  -                   Constructor
--  getStringForLabel()              STRING              Returns a string to be set as ATEX or BTEX
--  init()                           -                   Initialisation routine
--  initText()                       -                   Initialisation of the Label's text pane
--  initText(STRING)                 -                   Initialisation of the Label's text pane (text string given!)
--  libraryForm(REAL)                -
--  loadAttaTypeOptions()            -                   Populate the attachment type options gadget
--  loadCE()                         -                   Loads the current label information into the form
--  loadLLShapeOptions()             -                   Loads the leader line pixmap's into the shape option gadget.
--  loadLabelTypeOptions()           -                   Loads the label type options into the option gadget
--  repositionText(STRING)           -                   Updates the position of the label's text (AT or BY cursor)
--  setFormTitle(STRING)             -
--  setIdMethod(STRING)              -
--  setLabelType(STRING)             -
--  setMode(STRING,STRING,STRING)    -                   Sets the form's working mode (to be called before SHOW)
--  setName(STRING)                  -                   Sets the label name, and updates the active status of the gadgets
--  setStatus(REAL)                  -                   Updates the local status bar text.
--  switchMode(STRING)               -                   Switches from between create and modify mode.
--  tracking()                       -                   Loads the current label data automatically if enabled
--  validNum(GADGET,REAL,REAL)       -                   Validating routine guarding from the unset or out-of-range values
--
------------------------------------------------------------------------
--
setup form !!draLabelsFast size 30 15 dialog docking Right

  !this.formTitle = 'General Label'
  !this.iconTitle = 'GLAB'
  !this.formRevision = '$Revision: '
  !this.initCall     = '!this.init()'
  !this.cancelCall   = '!this.close()'
  track 'PADDCE' call |!this.tracking()|

  frame .mode 'Mode:'
    rtoggle .createMode tagWid 8 'Creation' callback '!this.switchMode(|Creation|)' states '' 'Create' $
              tooltip 'Enter Creation Mode'
    rtoggle .modifyMode tagWid 8 'Modification' at xmin ymax callback '!this.switchMode(|Modify|)' states '' 'Modify' $
              tooltip 'Enter Modify Mode'
  exit

  frame .optionsBar 'Options:'  at xmax.mode+1 ymin
    option .optLabType  'Type:     ' at xmin+1 ymin+1 tagwidth 7 callback |!this.setLabelType(!this.optLabType.selection())
            !!appDraMain.optLabType.select('RTEXT', !this.optLabType.selection())
            !this.createMode.val = TRUE
            !this.switchMode('Creation')| $
            tooltip |Choose between the General and Symbolic Label's| width 7
    option .optAttaType 'Attach to:' at xmin ymax  tagwidth 7 callback |!this.setIdMethod(!this.optAttaType.selection())
            !!appDraMain.optAttaType.select('RTEXT', !this.optAttaType.selection())| $
            tooltip |Choose the method of picking the referred element| width 7
  exit

  text .labelName 'Name:' tagwidth 5 at xmin.mode ymax.mode+0.2  width 35 is STRING

  frame .textFrame 'Text:' at xmin ymax_labelName
    textpane .text at xmin+1 ymax width 40 height 6
    button .showHashCodes 'Intelligent Text...' at xmin   ymax+0.3 width 12 callback '!!intTextPane = !!draLabelsFast.text show _CDRINTTEXT'
    button .refreshLabel  'Refresh the label'   at xmax+3 ymin     width 12 callback '!this.applyText()'
    button .copyText      'Copy Text'           at xmax+3 ymin     width 7  callback '!this.copyText()'
  exit

  frame .leaderLineFrame 'Leader Line:' at xmin ymax_textFrame
    option   .lLShape 'Shape:' tagwidth 5 at xmin+0.5 ymin+0.8 callback |!this.setMode(!this.labelType, !this.lLShape.selection(), !this.idMethod)
                  !this.applyLLTypeAngle(!this.createMode.val) | pixmap width 15 height 10 tooltip |Select the Leader Line Shape|
    text     .angle at ymin_lLShape ' Angle:' tagwidth 5 callback '!this.applyLLTypeAngle(TRUE)' width 5 is REAL format !!realFmt
  exit

  button   .move at xmax+1 ymin+0.6 pixmap callback |!this.repositionText('AT')| width 60 height 21 $
              tooltip 'Move the Label'
    !this.move.addPixmap(!!pml.getPathName('draft_lab_10.png'))

  button   .attributes 'Attributes...' at xmax+0.5 ymin callback 'show !!draLabelAttributes' width 7.5 $
              tooltip 'Show Advanced Label Attributes'

  text     .template at xmin_labelName ymax+0.7 'Template:' tagwidth 8 callback '!this.applyTemplate(!this.ref)' width 21.5 is STRING $
              tooltip 'Currently Selected Symbolic Template'
  button   .showLib 'Show Library' callback '!this.libraryForm(-1)' width 9 $
              tooltip 'Show the Symbolic Template Library'

  option   .tree at xmin_labelName ymax+0.2 'Reference:' tagwidth 8 callback '!this.chooseFromTree()' width 19.5 $
              tooltip 'Choose Referenced Element'
  button   .reattach at xmin_showLib pixmap callback '!this.attach(false)' width 78 height 21 $
              tooltip 'Change the Referenced Design Element'
    !this.reattach.addPixmap(!!pml.getPathName('draft_lab_09.png'))

  button   .create at xmin_tree ymax+0.2 'Create' callback '!this.attach(true)' width 7 $
              tooltip |Create New Label's|

  line     .lineA 'H-Line' at xmin.mode ymax Horiz wid.textFrame hei 1
  para     .statusBar at xmin.mode ymax-0.4 width.lineA
  line     .lineB 'H-Line' at xmin.mode ymax-0.4 Horiz wid.textFrame hei 1

  -- Leader line mode: 1 - STRA, 2 - HA, 3 - AH, 4 - VA, 5 - AV 6 - NO
  member .modeIndex is REAL

  -- Reference indication mode: ID, IDP, or IDPD
  member .idMethod is STRING

  -- List of default (last recently used) angles for the inclined leader lines
  member .defAngle is ARRAY

  -- The reference to the currently handled label
  member .ref is DBREF

  -- Label type: either GLAB or SLAB
  member .labelType is STRING

  -- Corresponding text attribute name: either BTEX or ATEX
  member .textAttribute is STRING

  -- Auxiliary: array of leader line modes
  member .llModes is ARRAY

  -- Configuration flag: Tree collection mode (ignore site and zone?)
  member .ignoreSiteZone is BOOLEAN

exit

------------------------------------------------------------------------
--
-- Method:      draLabelsFast
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draLabelsFast()

  -- Reset this to false, if you want SITE and ZONE elements being considered
  -- as candidates for design references of a label
  !this.ignoreSiteZone = true

  -- 'XXXX' will force the reselection of the label type on the first use
  !this.labelType     = 'XXXX'
  !this.textAttribute = 'BTEX'

  -- Initially: no current label
  !this.ref = =0/0
  !this.labelName.setEditable(false)
  !this.labelName.val = 'New Label'

  !this.modeIndex = 1
  !this.idMethod = 'ID'

  do !n from 1 to 5
    !this.defAngle[!n] = 45.0
  enddo

  -- TODO: TL - implement the DEFAULT setting:
  --    var !bpoffset BPOFFSET of OWNER
  --    !shape = LSHAPE of OWNER
  --    LSHAPE $!shape BPOFFSET $!bpoffset

  !s = 'STRA/HA/AH/VA/AV/NO'
  !this.llModes = !s.split('/')

  --Call method to load label type options.
  !this.loadLabelTypeOptions()

  --Call method to load attachment type options.
  !this.loadAttaTypeOptions()

  --Call method to load pixmap's into leader line shapes gadget.
  !this.loadLLShapeOptions()

  -- Other settings
  !this.angle.validateCall = '!this.validNum(!this.angle, -360.0, 360.0)'
  !this.angle.clear()

  -- Default label's text
  !text[1] = '#NAME(C2:)'
  !this.text.val = !text

endmethod
-- End of method definition for .draLabelsFast()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Form initialisation routine
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()

  -- don't want the navigation of the SetLayer Function
  !ref = REF
  !status = !!draSetLayer('','LAB')
  $!ref
  -- Do not continue, if !!draSetLayer reports problems
  if( not !status ) then
    return error 1 || noalert
  endif

  if( undefined(!!draLabelAttributes) ) then
    pml load form !!draLabelAttributes
  endif
  !this.tree.clear()
  !this.setName('unset')

  if( undefined(!!draSylaLib) ) then
    pml load form !!draSylaLib
    !this.showLib.tag = 'Show Library'
  elseif( !!draSylaLib.shown() ) then
    -- If the Library form is shown, hide it for the GLAB mode
    if( !this.labelType.eq('GLAB') ) then
      !this.libraryForm(0)
    else
      !this.showLib.tag = 'Hide Library'
    endif
  else
    !this.showLib.tag = 'Show Library'
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      tracking
--
-- Description: Loads the current label data automatically if enabled
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .tracking()

  if( !this.modifyMode.val ) then
    if !!ce.type.eq('GLAB').or(!!ce.type.eq('SLAB')) then
      !this.loadCE()
    else
      !this.createMode.val = true
      !this.switchMode('Creation')
      !this.init()
    endif
  endif

endmethod
-- End of method definition for .tracking()

------------------------------------------------------------------------
--
-- Method:      setName
--
-- Description: Sets the label name, and updates the active status of the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   Name of the label ('unset' disables the gadgets!)
-- Return:
--
------------------------------------------------------------------------
define method .setName(!name is STRING)

  !this.labelName.val = !name
  !status = !name.neq('unset')
  if( !status ) then
    !this.ref = REF of $!name
  else
    !this.labelName.val = 'New Label'
    !this.ref = =0/0
  endif
  if( !!draLabelAttributes.shown() ) then
    !!draLabelAttributes.init()
  endif

endmethod
-- End of method definition for .setName(STRING)

------------------------------------------------------------------------
--
-- Method:      setMode
--
-- Description: Sets the form's working mode (to be called before SHOW)
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   Label type (GLAB, SLAB)
--   2   R   STRING   The string representing the form's working mode
--   3   R   STRING   Identification method (ID, IDP, IDPD)
-- Return:
--
------------------------------------------------------------------------
define method .setMode(!labelType is STRING, !mode is STRING, !idMethod is STRING)

  if !this.shown().not() then
    !this.createMode.val = TRUE
    !this.switchMode('Creation')
  endif

  !ind = !this.llModes.findFirst(!mode.upCase())
  if( !ind.unset() ) then
    return error 1 |!!draLabelsFast: Unknown mode '$!mode'|
  endif
  !this.modeIndex = !ind
  -- This depends on the naming of the PNG files for the icons!!!
  !this.lLShape.select('RTEXT', !mode)
  !isAngleSet = !ind.between(2,5)
  if( !isAngleSet ) then
    !this.angle.val = !this.defAngle[!ind]
  else
    !this.angle.clear()
  endif
  -- Deactivate the Angle gadget for the STRA and NO mode
  !this.angle.active = !isAngleSet
  -- Update also the .idMethod and .labelType attributes
  -- but only if the form is not shown yet. If shown, these attributes will not
  -- be changed, allowing for an easy update of the leader line shape on the
  -- existing label
  if( !this.shown().not() ) then
    if( undefined(!!draLabelAttributes) ) then
      pml load form !!draLabelAttributes
    endif
    !this.setIdMethod(!idMethod)
    !this.setLabelType(!labelType)
  endif

endmethod
-- End of method definition for .setMode(STRING,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      loadCE
--
-- Description: Loads the current label information into the form
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .loadCE()

  !type = TYPE
  !isSlab = !type.eq('SLAB')
  if( !isSlab or !type.eq('GLAB') ) then
    if( !isSlab ) then
      !ref = TMRF
      if( !ref.set() ) then
        !this.template.val = FULLNAME of TMRF
      else
        !this.template.val = 'unset'
      endif
    endif
    !this.setLabelType(!type)
    !!appDraMain.optLabType.select('Rtext', !type)
    !this.optLabType.select('Rtext', !type)
    !name = FULLNAME
    !this.setName(!name)
    !this.initText()
    !this.create.active = true
    -- Read the label's settings and populate the gadgets
    !lshape = LSHAPE
    !lLeader = Lleader
    if !lLeader then
      if( !lshape.eq('Straight') ) then
        !mInd = 1
        !angleStr = ''
      else
        var !details LABEL LEAD SHAPE
        !allDetails = !details.split()
        if( !lshape.eq('Horizontal Angled') ) then
          !mInd = 2
          !angleStr = !allDetails[3]
        elseif( !lshape.eq('Angled Horizontal') ) then
          !mInd = 3
          !angleStr = !allDetails[2]
        elseif( !lshape.eq('Vertical Angled') ) then
          !mInd = 4
          !angleStr = !allDetails[3]
        elseif( !lshape.eq('Angled Vertical') ) then
          !mInd = 5
          !angleStr = !allDetails[2]
        else
          !mInd = 1
          !angleStr = ''
        endif
      endif
    else
      !mInd = 6
      !angleStr = ''
    endif
    if( !angleStr.empty() ) then
      !this.angle.active = false
      !this.angle.clear()
    else
      !this.angle.active = true
      !this.angle.val = !angleStr.real()
    endif
    !this.modeIndex = !mInd
    !this.lLShape.select('RTEXT', !this.llModes[!mInd])
    !nppt = NPPT
    !pkey = PKEY
    -- This assumes, that for 'ID' to be used, both PKEY must be unset
    -- and NPPT must be -1 (P-5981)
    if( !nppt.gt(-1) ) then
      !this.setIdMethod('IDP')
      !!appDraMain.optAttaType.val = 2
    elseif( !pkey.empty() ) then
      !this.setIdMethod('ID')
      !!appDraMain.optAttaType.val = 1
    else
      !this.setIdMethod('IDPD')
      !!appDraMain.optAttaType.val = 3
    endif
    !this.collectTree()
    enhance sole ce

  else

    -- not a GLAB nor a SLAB
    !this.tree.clear()
    !this.tree.active = false
    if( !this.ref.set() ) then
      unenhance $!this.ref
      handle ANY
      endhandle
    endif
    !this.setName('unset')

  endif

  if( !!draLabelAttributes.shown() ) then
    !!draLabelAttributes.init()
  endif

endmethod
-- End of method definition for .loadCE()

------------------------------------------------------------------------
--
-- Method:      libraryForm
--
-- Description: Shows or Hides the library form
--
-- Method Type: Procedure
-- Arguments:
--  1  R  REAL 1 - show, 0 - hide, other - toggle
-- Return:
--
------------------------------------------------------------------------
define method .libraryForm( !showMode is REAL )

  --If we are in create mode we need to unset the ref so the current SLAB is no t modified.
  if !this.createMode.val then
    !this.ref = object DBREF()
  endif

  if( !showMode.eq(1) ) then
    !show = true
  elseif( !showMode.eq(0) ) then
    !show = false
  else
    !show = !this.showLib.tag.eq('Show Library')
  endif
  if( undefined(!!draSylaLib) ) then
    pml load form !!draSylaLib
  endif
  if( !show ) then
    if( not !!draSylaLib.shown() ) then
      !!draSylaLib.setLibType('SLAB', !!draLabelsFast)
      !!draSylaLib.show()
    endif
    !this.showLib.tag = 'Hide Library'
  else
    if( !!draSylaLib.shown() ) then
      !!draSylaLib.hide()
    endif
    !this.showLib.tag = 'Show Library'
  endif
endmethod
-- End of method definition for .libraryForm(REAL)

------------------------------------------------------------------------
--
-- Method:      setLabelType
--
-- Description: Modifies to form to handle the given type of labels
--
-- Method Type: Procedure
-- Arguments:
--  1  R  STRING   The type of labels required (GLAB or SLAB)
-- Return:
--
------------------------------------------------------------------------
define method .setLabelType( !labelType is STRING )

  if( !this.labelType.eq(!labelType) ) then
    return
  endif
  !this.labelType = !labelType
  !isSlab = !labelType.eq('SLAB')
  if( !isSlab ) then
    !this.textFrame.tag = 'AText:'
    !this.setFormTitle('Symbolic')
    !this.textAttribute = 'ATEX'
    -- Show the library form if the template is not set
    -- but only if this form is already shown
    -- If it is not, it would be nice to show the library form
    -- after passing the checks in the .init() method, but unfortunately
    -- it is not possible to show a form while displaying another
    if( !this.shown() ) then
      if( !this.template.val.unset() or !this.template.val.eq('') ) then
        !this.libraryForm(1)
      endif
    endif
  else
    !this.textFrame.tag = 'BText:'
    !this.setFormTitle('General')
    !this.textAttribute = 'BTEX'
    !this.libraryForm(0)
  endif
  !this.iconTitle = !labelType
  !this.template.visible = !isSlab
  !this.showLib.visible  = !isSlab
  !this.setName('unset')
  !this.tree.clear()
  !this.tree.active = FALSE
  --!this.createMode.val = TRUE
  --!this.switchMode('Creation')

endmethod
-- End of method definition for .setLabelType(STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form and tidy up
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .close()

  if( !this.ref.set() ) then
    unenhance $!this.ref
    handle ANY
    endhandle
  endif
  !this.setName('unset')
  !this.libraryForm(0)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      getStringForLabel
--
-- Description: Returns a string to be set as ATEX or BTEX
--
-- Method Type: Function
-- Arguments:
-- Return:
--   STRING   The string to be set as ATEX/BTEX
--
------------------------------------------------------------------------
define method .getStringForLabel() is STRING

  !s = !this.text.val.join('#/')
  handle ANY
    !s = ''
  elsehandle None
    -- NOTE: String length limit = 120!
    if( !s.length().gt(120) ) then
      !s = !s.subString(1,120)
    endif
  endhandle
  return !s

endmethod
-- End of method definition for .getStringForLabel()

------------------------------------------------------------------------
--
-- Method:      initText
--
-- Description: Initialisation of the Label's text pane
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .initText()
  -- Assumption: We are at !this.ref
  var !text RAW $!this.textAttribute
  var !text RAW (trim(|$!text|))
  !this.initText(!text)
endmethod
-- End of method definition for .initText()

------------------------------------------------------------------------
--
-- Method:      initText
--
-- Description: Initialisation of the Label's text pane (text string given!)
--
-- Method Type: Procedure
-- Arguments:
--   1  RW  STRING  The label's text to be set
-- Return:
--
------------------------------------------------------------------------
define method .initText(!text is STRING)

if (|$!text| eq |unset|) then
    !text = ''
  endif
  !nl = |#/|

  !lines = ARRAY()
  !lines = !text.splitString(!nl)

  !this.text.val = !lines
endmethod
-- End of method definition for .initText(STRING)

------------------------------------------------------------------------
--
-- Method:      repositionText
--
-- Description: Updates the position of the label's text (AT or BY cursor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   1  R   STRING  The repositioning mode (either 'AT' or 'BY')
-- Return:
--
------------------------------------------------------------------------
define method .repositionText(!how is STRING)
  if( !this.ref.unset() ) then
    return
  endif

  prompt off
  if( !how.eq('AT') ) then
    prompt load escape |Position the label...|
    !this.setStatus(3)
  else
    prompt load escape |Indicate two positions to define the displacement of the label's text|
    !this.setStatus(4)
  endif

  $!this.ref
  $!how @
  handle (61,528)
  endhandle

  prompt on
  prompt dismiss

  !this.setStatus(0)

endmethod
-- End of method definition for .repositionText(STRING)

------------------------------------------------------------------------
--
-- Method:      copyText
--
-- Description: Copies the text from another drawing's element
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .copyText()

  !this.setStatus(1)

  !ref = REF
  prompt off
  prompt load escape |Identify element to copy text from...|
  ID @
  handle (61,528)
    prompt off
    prompt dismiss
    !this.setStatus(0)
    return
  endhandle

  -- attempt to extract a text attribute
  var !text ||
  var !text RAW ATEX
  handle any
    var !text RAW BTEX
    handle any
      var !text RAW ETEX
      handle any
        var !text RAW DMTX
        handle any
          var !text RAW PLTX
          handle any
          endhandle
        endhandle
      endhandle
    endhandle
  endhandle

  if( !text.empty().not() ) then
    -- If not updating a particular label, just change the label's text pane
    if( !this.ref.unset() ) then
      $!ref
      !this.initText(!text)
    else
      $!this.ref
      $!this.textAttribute '$!text'
      handle ANY
      endhandle
      !this.initText()
    endif
  endif

  !this.setStatus(0)

endmethod
-- End of method definition for .copyText()

------------------------------------------------------------------------
--
-- Method:      attach
--
-- Description: Creates or updates a GLAB/SLAB using the settings from the Labels toolbar
--
-- Method Type: Procedure
-- Arguments:
--  1  R  BOOLEAN  True, if CREATING. False if RE-ATTACHING
-- Return:
--
------------------------------------------------------------------------
define method .attach( !new is BOOLEAN )

  if( !this.labelType.eq('SLAB') ) then
    !ce = !!ce
    $!this.template.val
    handle any
       !this.libraryForm(1)
       !!alert.warning('Select the template first...')
       return
    elsehandle none
      if not(!!ce.type.eq('SYTM').or(!!ce.type.eq('TXTM'))) then
       !this.libraryForm(1)
       !!alert.warning('Select a valid template...')
       return
      endif
    endhandle
    !!ce = !ce
  endif

  if( !new ) then
    -- move to layer
    !!draSetLayer('','LAB')
    !what = 'a NEW label'
    !command = 'new ' & !this.labelType
    !loop = true
    !this.setStatus(2)
  else
    if( !this.ref.unset() ) then
      return
    endif
    !this.setStatus(5)
    !name = FULLNAME
    !what = 'the $!name label'
    !command = ''
    !loop = false
  endif

  !opt = !this.idMethod
  !atOrigin = !opt.eq('ID')

  do
    !ref = REF
    if( !atOrigin ) then
      prompt off
      prompt load escape |Identify Any Design element for $!what$n...|

      do
        if (defined(!obj)) then
          !obj.delete()
        endif
        var !obj name of ID DESEL @
        handle (61,528)
          --If we have just created new labels then we need to flick into modify mode.
          if !new then
            !this.createMode.val = true
            !this.switchMode('Creation')
          endif
          $!ref
          prompt on
          !this.setStatus(0)
          return
        endhandle
        break if (defined(!obj))
        Write 'An appropriate Design element has not been found! Try again ...'
      enddo
      -- TL: Should not be necessary, but apparently after the ID command, the dbtype
      -- TL: is set to DESI, whereas it should remain at PADD.
      -- TL: Observed cases, where multiple switch commands were needed to return from
      -- TL: DESI to PADD - that's why there is a do loop.
      do
        !dbt = DBTYPE
        break if( !dbt.eq('PADD') )
        switch
      enddo
      if( not !new ) then
        $!this.ref
      endif
      $!command ON $!obj
      prompt on
    else
      if( not !new ) then
        $!this.ref
      endif
      $!command ON $!opt @
      handle (61,528)
        $!ref
        !this.setStatus(0)
        return
      endhandle
      if( !opt.eq('IDPD') ) then
        !num = PKDI
        if( !num.lt(0)) then
          !num = -!num
          PKDI $!num
        endif
      endif
    endif
    !name = FULLNAME
    !this.setName(!name)
    !this.collectTree()


    --Apply user defined settings.
    !this.applyLLTypeAngle(FALSE)
    !this.applyText()
    --If we are creating a SLAB then apply the template.
    if !this.ref.type.eq('SLAB') then
      !this.applyTemplate(!this.ref)
    endif

    !this.create.active = true

    !this.repositionText('AT')

    enhance sole ce
    break if (not !loop)
    !this.setStatus(2)
  enddo

endmethod
-- End of method definition for .attach(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      collectTree
--
-- Description: Collects the elements for the owner's list for DDNM
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .collectTree()
  -- This routine is supposed to be called on creation, so
  -- there is no point in checking if we are at a label
  !this.tree.clear()
  !names = ARRAY()
  !refs  = ARRAY()

  if( !this.idMethod.eq('ID') ) then

    !ddnm = DDNM
    -- VIEW is allowed as a DDNM - no hierarchy considered then
    if( !ddnm.type.eq('VIEW') ) then
      !name = FULLNAME
      !names[1] = '$!name (VIEW)'
      !refs[1]  = !ddnm.string()
    else
      -- a Design element - consider the hierarchy
      !tree = OWNLST of DDNM
      handle ANY
      elsehandle None
        !tree.append(!ddnm)
        !save = REF
        -- Scan the list
        do !ref values !tree
          $!ref
          !type = FULLTYPE
          if( !this.ignoreSiteZone ) then
            -- if requested, skip SITE and ZONE elements
            skip if( !type.eq('SITE') or !type.eq('ZONE') )
          endif
          !name = FULLNAME
          !refs.append(!ref.string())
          !names.append('$!name ($!type)')
        enddo
        $!save
      endhandle
    endif

  else

    !name = FULLNAME of DDNM
    !type = FULLTYPE of DDNM
    if( !this.idMethod.eq('IDP') ) then
      !nppt = NPPT
      !names[1] = |P$!nppt of $!name ($!type)|
    elseif( !this.idMethod.eq('IDPD') ) then
      !pkey = PKEY
      if( !pkey.eq('MEML') ) then
        !meml = MEMLINE of DDNM
        handle ANY
        elsehandle None
          !pkey = |$!pkey ($!meml)|
        endhandle
      endif
      !pkdi = PKDI
      !sPkdi = !pkdi.string(!!realFmt)
      !names[1] = |P-line $!pkey of $!name ($!type), PKDI=$!sPkdi|
    else
      return $* mode not recognised
    endif
    !refs[1] = ''

  endif

  !this.tree.dText = !names
  !this.tree.rText = !refs
  !nItems = !names.size()
  if( !nItems.gt(0) ) then
    !this.tree.val = !nItems $* select the last item by default
    !this.tree.active = true
  else
    !this.tree.active = false
  endif
endmethod
-- End of method definition for .collectTree()

------------------------------------------------------------------------
--
-- Method:      chooseFromTree
--
-- Description: Re-attaches the label after a selection in the .tree gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .chooseFromTree()

  if( !this.ref.set() ) then
    if( !this.idMethod.eq('ID') ) then
      !ref = !this.tree.selection()
      $!this.ref
      ON $!ref
    endif
  endif

endmethod
-- End of method definition for .chooseFromTree()

------------------------------------------------------------------------
--
-- Method:      validNum
--
-- Description: Validating routine guarding from the unset or out-of-range values
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The gadget being validated
--   2  R  REAL    Minimum allowed value
--   3  R  REAL    Maximum allowed value
-- Return:
--
------------------------------------------------------------------------
define method .validNum(!gadget is GADGET, !min is REAL, !max is REAL)

  !gTag = !gadget.tag
  if( !gadget.val.unset() ) then
    return error 1 |The $!gTag value is not set!|
  elseif( !gadget.val.lt(!min) ) then
    return error 1 |The $!gTag value is below the allowed minimum!|
  elseif( !gadget.val.gt(!max) ) then
    return error 1 |The $!gTag value is above the allowed maximum!|
  endif

endmethod
-- End of method definition for .validNum(GADGET, REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      setIdMethod
--
-- Description: Sets the identification mode (updating the form's title)
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   new ID method
-- Return:
--
------------------------------------------------------------------------
define method .setIdMethod( !idMethod is STRING )

  !this.idMethod = !idMethod
  if( !this.labelType.eq('SLAB') ) then
    !this.setFormTitle('Symbolic')
  else
    !this.setFormTitle('General')
  endif

endmethod
-- End of method definition for .setIdMethod(STRING)

------------------------------------------------------------------------
--
-- Method:      setFormTitle
--
-- Description: Updates the form's title
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   the label's kind (General or Symbolic)
-- Return:
--
------------------------------------------------------------------------
define method .setFormTitle( !kind is STRING )

  if ( !this.idMethod.eq('ID') ) then
    !this.formTitle = !kind & ' Label (at Origin)'
  elseif( !this.idMethod.eq('IDP') ) then
    !this.formTitle = !kind & ' Label (at a P-point)'
  elseif( !this.idMethod.eq('IDPD') ) then
    !this.formTitle = !kind & ' Label (at a P-line)'
  endif

  !!appDraMain.optAttaType.select('RTEXT', !this.idMethod)
  !this.optAttaType.select('RTEXT', !this.idMethod)

endmethod
-- End of method definition for .setFormTitle(STRING)

------------------------------------------------------------------------
--
-- Method:      switchMode
--
-- Description: Called when the mode is switched between CREATION and MODIFY
--
-- Method Type: Procedure
-- Arguments:
--   1   R   STRING   the mode of the FORM either Create or Modify
-- Return:
--
------------------------------------------------------------------------

define method .switchMode( !mode is STRING )

  if !mode.eq('Creation') then
    !this.create.visible = TRUE
    !this.move.active = FALSE
    !this.tree.active = FALSE
    !this.reattach.active = FALSE
    !this.attributes.active = FALSE
    !this.ref = object DBREF()
    !this.labelName.val = 'New Label'
    !this.refreshLabel.visible = false
  elseif !mode.eq('Modify') then
    !this.create.visible = FALSE
    !this.move.active = TRUE
    !this.tree.active = TRUE
    !this.reattach.active = TRUE
    !this.attributes.active = TRUE
    !this.refreshLabel.visible = true
    !this.loadCE()
  endif

endmethod
-- End of method definition for .setFormTitle(STRING)

------------------------------------------------------------------------
--
-- Method:      applyLLTypeAngle
--
-- Description: Called when the Leader Line selection is changed on the toolbar
--     and we are in modify mode and the form is shown.
--     Apply's the leader line to the current label.
--
-- Method Type: Procedure
-- Arguments:
--    1   R   BOOLEAN   if called from enter on leader line angle text gadget then true
-- Return:
--
------------------------------------------------------------------------

define method .applyLLTypeAngle(!enterEvent is BOOLEAN)

  if !enterEvent.and(!this.createMode.val) then
    return
  endif

  -- It is assumed, that this routine is always called, when CE is a label
  !mode = !this.modeIndex
  -- Nothing to do for STRAIGHT (1)
  if( !mode.eq(1) ) then
    LSHAPE STRAIGHT
    LLEADER TRUE
  elseif (!mode.eq(6)) then
    LLEADER FALSE
  else
    !angle = !this.angle.val
    if( !mode.eq(2) ) then     $* HA
      LEAD HORIZONTAL $!angle DEG
    elseif( !mode.eq(3) ) then $* AH
      LEAD $!angle DEG HORIZONTAL
    elseif( !mode.eq(4) ) then $* VA
      LEAD VERTICAL $!angle DEG
    elseif( !mode.eq(5) ) then $* AV
      LEAD $!angle DEG VERTICAL
    endif
    if( !mode.lt(6) ) then
      !this.defAngle[!mode] = !angle
      LLEADER TRUE
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      applyTemplate
--
-- Description: apply's the symbol template on creation or
--            when a selection is made in modify mode.
--
-- Method Type: Procedure
-- Arguments:
--    1   R   DBRREF   the label on which to apply the template.
--             Needed for a new selection from the symbol library form
-- Return:
--
------------------------------------------------------------------------

define method .applyTemplate(!label is DBREF)

  --If we have no label ref set then we are not modifying an existing
  --label so return. Symbol Template is probably being selected for the
  --creation of a new label.
  if !label.unset() then
    return
  endif

  --Else we are in modify mode so reaffirm this go back to the label ref and set the changes
  !this.modifyMode.val = TRUE
  !!ce = !label

  !templateName = !this.template.val
  if( !templateName.eq('unset') ) then
    return
  endif
  TMRF $!templateName
  handle ANY
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      applyText
--
-- Description: apply's the text gadget contents to the label.
--
-- Method Type: Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------

define method .applyText()

  !text = !this.getStringForLabel()
  $!this.textAttribute '$!text'

endmethod

------------------------------------------------------------------------
--
-- Method:      setStatus
--
-- Description: Called to set the status bar text to localise instructions
--                for graphical interaction
--
-- Method Type: Procedure
-- Arguments:
--    1   R   Identifies which text to show.
--
-- Return:
--
------------------------------------------------------------------------

define method .setStatus(!textCode is REAL)

  if !textCode.eq(0) then
    !this.statusBar.val = ''
  elseif !textCode.eq(1) then
    !this.statusBar.val = 'Identify element to copy text from...'
  elseif !textCode.eq(2) then
    !this.statusBar.val = 'Identify Any Design element to create a new label...'
  elseif !textCode.eq(3) then
    !this.statusBar.val = |Position the label...|
  elseif !textCode.eq(4) then
    !this.statusBar.val = |Indicate two positions to define the displacement of the label's text...|
  elseif !textCode.eq(5) then
    !this.statusBar.val = 'Identify a Design Element to attach the label to...'
  else
    !this.statusBar.val = ''
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      loadLLShapeOptions
--
-- Description: Populate the leader line shape gadget with images
--
-- Method Type: Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------

define method .loadLLShapeOptions()

  --Read in the pixmap's
  !dText = object ARRAY()
  do !i from 1 to 6
    !dText.append(!!pml.getPathName('draft_lab_0$!i$n.png'))
  enddo
  !this.lLShape.dText = !dText
  !this.lLShape.rText = !this.llModes
  !this.lLShape.select('RTEXT', !this.llModes[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      loadLabelTypeOptions
--
-- Description: Populate the label type option gadget
--
-- Method Type: Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------

define method .loadLabelTypeOptions()

  !dText = object ARRAY()
  !dText[1] = 'General'
  !dText[2] = 'Symbolic'
  !rText = object ARRAY()
  !rText[1] = 'GLAB'
  !rText[2] = 'SLAB'
  !this.optLabType.dText = !dText
  !this.optLabType.rText = !rText
  !this.optLabType.val = 1

endmethod

------------------------------------------------------------------------
--
-- Method:      loadAttaTypeOptions
--
-- Description: Populate the attachment type options gadget
--
-- Method Type: Procedure
-- Arguments:
--
-- Return:
--
------------------------------------------------------------------------

define method .loadAttaTypeOptions()

  !dText = object ARRAY()
  !dText[1] = 'the Origin'
  !dText[2] = 'a P-point'
  !dText[3] = 'a P-line'
  !rText = object ARRAY()
  !rText[1] = 'ID'
  !rText[2] = 'IDP'
  !rText[3] = 'IDPD'
  !this.optAttaType.dText = !dText
  !this.optAttaType.rText = !rText
  !this.optAttaType.val = 1

endmethod

