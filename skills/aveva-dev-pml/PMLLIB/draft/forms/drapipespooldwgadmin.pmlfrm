--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  backToMainTask()                 -                   back to main task
--  changeDrawing(GADGET,STRING)     -                   display selected drawing whenever changing drawing
--  changeViewReference()            -                   callback to change view reference
--  checkInputDataForText(BOOLEAN)   BOOLEAN             check input data for making a texp
--  checkInputDataForView(BOOLEAN)   STRING              check input data for making view
--  checkIsoOptionFile()             -                   check ISO option file
--  drapipespooldwgadmin()           -                   Constructor
--  getMarginFromRectangle(DBREF)    STRING              get margin from existing rectangle element
--  getOverlayViewAREA()             -                   get overlay view area from existing rectangle
--  getSourceDrawingElementName(STRING) STRING              get source element related to drawing from gadget
--  getViewDirection()               -                   get view direction by picking on canvas
--  highlightElement()               -                   highlight element
--  initialise()                     -                   initialise this form
--  loadDefaultFile()                -                   load default file
--  loadIsoOptionFile()              -                   load iso option file
--  modifyText(STRING)               -                   create / modify / texp element
--  modifyView(STRING)               -                   create / modify / delete view
--  navigateDwgTmpl(STRING)          -                   navigate selected drawing template
--  navigateKeyword(STRING)          -                   navigate texp element which has specify key-word
--  pickViewPosition(STRING)         -                   set position of view
--  populateNoteList()               -                   populate list of note elements
--  populateTextKeywords()           -                   populate keywords for writing drawing information
--  populateViewList(STRING)         -                   populate list of view elements
--  popupMenusForDwgTmpl()           -                   set popup menus for drawing template and backing sheet gadget(cboSpoolDrwg,optBSRF)
--  popupMenusForKeywordList()       -                   set popup menus for keywords list
--  saveDefaultFile()                -                   save default file
--  separatePos(STRING)              ARRAY               separate position with inputted value on gadget
--  setAutoNaming()                  -                   set auto naming for a new view
--  setCommandOptionGadget(BOOLEAN,STRING) -                   set command option gadget
--  setCurrentElement(STRING)        -                   change current element
--  setDetailOption(GADGET,STRING)   -                   set detail option form
--  setIsoOptionFIle()               -                   set iso option file
--  setMainGadget()                  -                   display detail option
--  setNoteVisibility(BOOLEAN)       -                   change note visibility
--  setOverlayViewAREA(STRING)       -                   set overlay view area
--  setResultPath()                  -                   set result path for exporting plt file
--  setViewBoundary(STRING)          -                   set boundary of view
--  setViewDirection(STRING)         -                   set view direction
--  setVnotForOverlayView()          -                   set VNOTE for overlay view
--  showPreview()                    -                   display selected drawing
--  updateExpressionText()           -                   update expression
--
------------------------------------------------------------------------

-- define form
setup form !!drapipespooldwgadmin dialog dock
  !this.formTitle = |Pipe Spool Drawing Admin|
  !this.initcall  = |!this.initialise()|
  !this.quitcall  = |!this.close()|

  -- main frame
  frame .frmMain '' anchor l+t+r                                           at x0.5  y0      width 60
    -- pipe spool drawing
    combo .cboSpoolDrwg   'Pipe Spool Drawing'    tagwidth 13 anchor t+l+r at x1    ymax0.5 callback   |!this.changeDrawing(| width 40

    -- backing sheet reference
    option .optBSRF       'Backing Sheet Ref'     tagwidth 13 anchor t+l+r at x1    ymax0.2 callback   |!this.populateNoteList()| width 40

    button .btnCreateView 'Create / Modify View'              anchor l+t   at xmin.optBSRF+5   ymax0.5    width 14 callback |!this.setCommandOptionGadget(true, 'VIEW')|
    button .btnCreateText 'Create / Modify Text'              anchor l+t   at xmax0.5   ymin   width 14   callback |!this.setCommandOptionGadget(true,'TEXT')|
    button .btnApplyText  'Dismiss'                           anchor l+t   at xmax0.5   ymin   width 14   cancel
  exit

  -- preview frame
  frame .frmDwgPreview panel      anchor all    at x0     ymax0 width 61 height 15
    view .view area
    exit
  exit

  frame .frmCommandOption panel   anchor all    at x0.5   ymax.frmMain
    para .pgPositions                           at x0     ymax          width 20
    line  .lineCommandOption      anchor l+t+r  at x0.5   ymax0.1       horizontal  width 60

    -- frame for view properties
    frame .frmModifyView ''       anchor all    at x0     ymin width 60 height 11
      -- define view type whether ISO or Non-ISO
      para   .paraViewISOType     anchor l+t    at x1     ymin1 text 'View Kinds' width 9
      frame .frmViewISOType panel anchor l+t    at xmax   ymin-0.2 width 15
        rtoggle .rtglISOView    'For ISO Overlay View'    tagwidth 15 callback |!this.setDetailOption(|
        rtoggle .rtglNonISOView 'For Draft Underlay View' tagwidth 15 callback |!this.setDetailOption(|
      exit

      frame .frmDraftSketchOption panel anchor all at x1 y2.3 height 8
        -- define view name
        combo  .cboViewNames  'View Name' tagwidth 10   anchor l+t+r  at x0     ymin0.5 callback |!this.changeViewReference()| width 27
        button .btnViewNameCE   linkLabel    'CE'       anchor r+t    at xmax1  ymin    width 3 callback |!this.setCurrentElement('VIEW')|
        button .btnViewNameAuto linkLabel    'Auto'     anchor r+t    at xmax   ymin    width 5 callback |!this.setAutoNaming()|

        -- define view direction
        para   .paraIsoViewDir                          anchor l+t    at x0     ymax0.2 text 'View Direction' width 10
        combo  .cboIsoViewDir                           anchor l+t+r  at xmax   ymin    width 26.8
        button .btnDeriveViewDir linkLabel 'Derived..'  anchor r+t    at xmax1  ymin    width 9 callback |!this.getViewDirection()|

        -- define view size
        text  .txtViewSize tagwidth 10 'View Size'      anchor l+t    at x0       ymax0.2 width 29 is STRING
        button .btnPickViewSize linkLabel 'Pick Size'   anchor l+t    at xmax1    ymin    width 7   callback |!this.setViewBoundary('PICK')|
        button .btnGetViewSize  linkLabel 'Get Size'    anchor l+t    at xmax0.3  ymin    width 7 callback |!this.setViewBoundary('GET')|

        -- define view position
        text  .txtViewPosition tagwidth 10 'View Position'  anchor l+t  at x0     ymax0.2 width 29 is STRING
        button .btnPickViewPos   linkLabel 'Pick Pos'       anchor l+t  at xmax1  ymin    width 9 callback |!this.pickViewPosition('VIEW')|
      exit

      frame .frmISOOption panel anchor all at x1 y2.3 height 8

        -- iso option file path
        text  .txtIsoOptFile tagwidth 10 'Option File'  anchor l+t+r  at x0       ymin0.3 callback |!this.checkIsoOptionFile()|   width 38 is STRING
        button .btnISOOptfileBrowser                    anchor r+t    at xmax+0.5 ymin    pixmap  width 16 height 16 callback |!this.setIsoOptionFIle()|

        text   .txtIsoResultPath tagwidth 10 'Result Path'    anchor l+t+r  at x0         ymax0.2 width 38 is STRING
        button .btnISOResultBrowser                           anchor r+t    at xmax+0.5   ymin pixmap width 16 height 16   callback |!this.setResultPath()|

        option .optIsoViewType      'View Type'  tagwidth 10  anchor l+t    at x0         ymax0.3 width 10.8
        text   .txtIsoCharHeight tagwidth 10 'Text Height'    anchor l+t    at xmax1.5    ymin    width 12 is REAL

        text   .txtIsoViewMargin tagwidth 10 'View Margin'  anchor l+t  at x0     ymax0.2 callback |!this.setOverlayViewAREA('VALUES')|  width 13 is STRING
        button .btnPickOlayArea linkLabel 'Pick Area'       anchor l+t  at xmax1  ymin    width 7 callback |!this.setOverlayViewAREA('PICK')|
        button .btnGetOlayArea  linkLabel 'Get Area'        anchor l+t  at xmax1  ymin    width 7 callback |!this.getOverlayViewAREA()|
      exit

      button .btnAddView  'Save'    anchor l+b at xmin.txtViewPosition+10 ymax width 8.5 callback |!this.modifyView('ADD')|
      button .btnEditView 'Edit'    anchor l+b at xmax0.5 ymin width 8.5 callback |!this.modifyView('EDIT')|
      button .btnDelView  'Delete'  anchor l+b at xmax0.5 ymin width 8.5 callback |!this.modifyView('DEL')|
      --
    exit

    -- frame for text properties
    frame .frmModifyText panel anchor all at x0 ymin width 60 height 12
      frame .frmTextProp 'Text Properties'          anchor all    at xmin   ymin0.3 width 55
        option .optNoteList 'Note' tagwidth 7       anchor l+t+r  at x1     ymax0.2 callback |!this.populateTextKeywords()| width 42
        button .btnCENote linklabel 'CE'            anchor r+t    at xmax1  ymin    callback |!this.setCurrentElement('NOTE')|

        text  .txtTextKey   tagwidth 7 'Keyword'    anchor l+t    at x1     ymax0.2 width 10 is STRING
        text  .txtTextExp   tagwidth 9 'Expression' anchor l+t+r  at xmax1  ymin width 23 is STRING
        text  .txtTextChei  tagwidth 7 'Height'     anchor l+t    at x1     ymax0.2 width 10 is REAL
        option .optTextJust  'Justification'  tagwidth 9 anchor l+t   at xmax1 ymin width 5
        option .optTextAlign  'Alignment'     tagwidth 7 anchor l+t+r at xmax1 ymin width 5
        text  .txtTextPos   tagwidth 7 'Position'   anchor l+t    at x1     ymax0.2 width 10 is STRING
        button .btnPickTextPos linkLabel 'Pick Pos' anchor l+t    at xmax1  ymin    width 5 callback |!this.pickViewPosition('TEXT')|
        option .optTextColour  'Colour'  tagwidth 7 anchor l+t+r  at xmin.optTextAlign ymin width 5


        list  .lstKeyword           anchor all at x1      ymax0.2         callback |!this.updateExpressionText()|  width 55 lines 4

        button .btnAddProp 'Add'    anchor l+b at x3.5    ymax0.4 width 6 callback |!this.modifyText('ADD')|
        button .btnEditProp 'Edit'  anchor l+b at xmax0.5 ymin    width 6 callback |!this.modifyText('EDIT')|
        button .btnDelProp 'Delete' anchor l+b at xmax0.5 ymin    width 6 callback |!this.modifyText('DELETE')|
      exit
    exit

    paragraph .pgBackToMainTask     anchor l+b at x1      ymax    pixmap width 16 height 16
    button .btnBackToMainTask    linkLabel   'Back to Main Tasks'  anchor l+b at xmax1    ymin     width 20 callback |!this.backToMainTask()|
  exit

  member .isoOptionFile  is FILE
  member .defaultFile    is FILE
  member .mtoNoteElement is DBREF
  member .refNoteElement is DBREF
  member .keywordList    is ARRAY
  member .vnotForOLayView is DBREF
exit
-- End of method

------------------------------------------------------------------------
--
-- Method:      drapipespooldwgadmin
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drapipespooldwgadmin()
  !this.btnISOOptfileBrowser.addPixmap(!!pml.getPathName('openbrowser.png'))
  !this.btnISOResultBrowser.addPixmap(!!pml.getPathName('openbrowser.png'))

  -- define tool tip
  !this.txtIsoOptFile.setToolTip('Select option file for pipe spool drawing')
  !this.txtIsoResultPath.setToolTip('Select path to store the result plt file.')
--  !this.txtIsoViewSize.setToolTip('Input view size,(ex.aa~ad, h 300 w 400)')
--  !this.txtIsoPicScale.setToolTip('Input picture scale for iso picture')
  !this.txtIsoCharHeight.setToolTip('Input height of character for iso drawing')
  !this.txtIsoViewMargin.setToolTip('Input view margin, (ex,80,80,20,20)')

  !this.txtViewSize.setToolTip('Input view size. (ex.400,500)')
  !this.txtViewPosition.setToolTip('Input view position. (ex, 50,50)')

  !this.defaultFile = object FILE('%pdmsuser%/pipespldwgadm.dat')

--  !this.txtTextExp.setToolTip(|input expression. ('!entry' will be changed the spool element)|)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- initialise main gadget
  !this.setMainGadget()

  !this.setCommandOptionGadget(false,'')

  -- initialise view direction
  !isoViews = 'ISO1,ISO2,ISO3,ISO4,X,-X,Y,-Y,Z,-Z'
  !this.cboIsoViewDir.dtext = !isoViews.split(',')
  !this.cboIsoViewDir.val = 3

  -- initialise text key-expression
  !headings = 'Keyword,Expression'
  !this.lstKeyword.setHeadings(!headings.split(','))

  -- initialise icon for backing to main task
  !this.pgBackToMainTask.addPixmap(!!pml.getPathName('tick.png'))


  -- import dll for file browser
  import 'PMLFileBrowser'
  handle any
  endhandle

  -- initialise view kinds
  !this.frmViewISOType.val = 1
  !this.frmDraftSketchOption.visible = false
  !this.frmISOOption.visible = true

  -- initialise iso view type
  !isoViewType = 'ISO1,ISO2,ISO3,ISO4'
  !this.optIsoViewType.dtext = !isoViewType.split(',')

  -- initialize text justification
  !textJust = 'Left,Centre,Right'
  !this.optTextJust.dtext = !textJust.split(',')

  -- initialise text alignment
  !textAlignStr  = 'Bottom Of Body,Halfway Up Body,Top of Body,Base of First Character'
  !textAlignKeys = 'Bbody,Hbody,Tbody,Base'

  !this.optTextAlign.dtext = !textAlignStr.split(',')
  !this.optTextAlign.rtext = !textAlignKeys.split(',')

  !colourStr = 'grey,red,orange,yellow,green,cyan,blue,violet,brown,white,pink,mauve'
  !this.optTextColour.dtext = !colourStr.split(',')

  -- initialise text keyword list
--  !this.frmTextType.val = 1
  !this.populateNoteList()
  !this.populateViewList('')
  !this.frmViewISOType.val = 1

  -- popup for keyword list
  !this.popupMenusForKeywordList()

  !this.popupMenusForDwgTmpl()

  -- load iso option file
  !project  = current project
  !projCode = !project.code()

  -- load default file
  -- it contains saved gadget values
  !this.loadDefaultFile()

  if !this.txtIsoOptFile.val.eq('') then

    !defaultOptionFilePath = |%$!<projCode>iso%\std\pipeSpoolDwg.pmldat|
    !this.isoOptionFile = object FILE(!defaultOptionFilePath)

    if (!this.isoOptionFile.exists()) then
      !this.txtIsoOptFile.val = !defaultOptionFilePath
      !this.loadIsoOptionFile()
    endif

  else
    --load information from specified file (file last used)
    !this.isoOptionFile = object FILE(!this.txtIsoOptFile.val)
    if (!this.isoOptionFile.exists()) then
      !this.loadIsoOptionFile()
    endif
  endif

  -- check if  the button gadgets used for saving the Iso option file are activated properly
  !this.checkIsoOptionFile()

  -- show preview
  !this.showPreview()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMainGadget
--
-- Description: display detail option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMainGadget()
  -- set drawing templates list
  var !spoolDwgList eval name for all DRWG with sppurp of owner eq |PSPOOL|
  !this.cboSpoolDrwg.dtext = !spoolDwgList

  !showFlag = false

  if (!spoolDwgList.set()) then
    !refEntry = !spoolDwgList[1].dbref()
    !showFlag = !refEntry.dbwrite
  endif

  !this.cboSpoolDrwg.active  = !showFlag
  !this.btnCreateView.active = !showFlag

  -- set bsrf templates list
  var !backSheetList eval name for all BACK with sppurp of owner eq |PSPOOL|
  !this.optBSRF.dtext = !backSheetList

  !showFlag = false

  if (!backSheetList.set()) then
    !refEntry = !backSheetList[1].dbref()
    !showFlag = !refEntry.dbwrite
  endif

  !this.optBSRF.active       = !showFlag
  !this.btnCreateText.active = !showFlag
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDetailOption
--
-- Description: display detail option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    GADGET     gadget which used to be defined iso over view or draft underlay view
--    2     R    STRING     dummy string
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDetailOption(!gadget is GADGET, !dummyAction is STRING)
  if (!gadget eq !this.rtglISOView) then
    !this.frmDraftSketchOption.visible = false
    !this.frmISOOption.visible = true
    !this.btnAddView.tag = 'Save'
    !this.checkIsoOptionFile()

  else
    !this.frmDraftSketchOption.visible = true
    !this.frmISOOption.visible = false
    !this.btnAddView.tag = 'Add'
    !this.btnAddView.active = false
    !this.btnEditView.active = true
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSourceDrawingElementName
--
-- Description: get source element related to drawing from gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     element type to check drawing element (DRWG , VIEW, NOTE )
-- Return:
--   [Data Type] [Description]
--    1     R    STRING     return drawing element name
------------------------------------------------------------------------
define method .getSourceDrawingElementName(!elementType is STRING) is STRING

  !elementName = ''
  if (!elementType eq 'DRWG') then
    !isValid = !this.cboSpoolDrwg.dtext.set() and !this.cboSpoolDrwg.displayText().empty().not()
    !elementName = !this.cboSpoolDrwg.displayText()
  elseif (!elementType eq 'VIEW') then
    !isValid = !this.cboViewNames.dtext.set() and !this.cboViewNames.displayText().empty().not()
    !elementName = !this.cboViewNames.displayText()
  elseif (!elementType eq 'NOTE') then
    !isValid = !this.optNoteList.dtext.set() and !this.optNoteList.displayText().empty().not()
    !elementName = !this.optNoteList.displayText()
  endif

  if (!isValid and !elementName ne '/') then
    if (substring(!elementName,1,1) ne |=|) then
      if (substring(!elementName,1,1) ne |/|) then
        !elementName  = '/' & !elementName
      endif
    endif

    !elementRef = !elementName.dbref()
    handle any
      return error 1 'Invalid $!elementType reference. : $!elementName'
    endhandle

    if (!elementRef.badref()) then
      return error 1 'Invalid $!elementType reference. : $!elementName'
    endif

    if (!elementRef.dbwrite.not()) then
      return error 1  'It cannot write this db. Check DB rights or claim'
    endif
  endif

  return !elementName
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeViewReference
--
-- Description: callback to change view reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeViewReference()
  !viewRefName = !this.getSourceDrawingElementName('VIEW')
  if (!viewRefName.empty()) then
    return
  endif

  !this.populateViewList(!viewRefName)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      populateViewList
--
-- Description: populate list of view elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateViewList(!viewName is STRING)
  if (!viewName.empty()) then

    !drwgRefName = !this.getSourceDrawingElementName('DRWG')
    if (!drwgRefName.empty()) then
      return
    endif

    var !viewNames eval name for all view with func ne 'ISO_VIEW' for $!drwgRefName

    !this.cboViewNames.dtext = !viewNames

    if (!viewNames.size() eq 0) then
      return
    endif

    !viewRef = object DBREF(!viewNames[1])

  else
    !viewRef = object DBREF(!viewName)
  endif

  !!ce = !viewRef

  !this.setCurrentElement('VIEW')
  same
endmethod
-- End of method



------------------------------------------------------------------------
--
-- Method:      populateNoteList
--
-- Description: populate list of note elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateNoteList()
  if (!this.optBSRF.displayText().empty()) then
    return
  endif

  !backingSheet = !this.optBSRF.displayText().dbref()
  handle any
    !!alert.error(!this.optBSRF.displayText() + ' is a bad reference')
    return
  endhandle


  var !noteNames eval name for all note for $!backingSheet
  !this.optNoteList.dtext = !noteNames

  !this.showPreview()
  !this.populateTextKeywords()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      populateTextKeywords
--
-- Description: populate text keywords in a drawing template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateTextKeywords()
  if (!this.optNoteList.displayText().empty()) then
    return
  endif

  !noteRef = !this.optNoteList.displayText().dbref()
  handle any
    !!alert.error(!this.optNoteList.displayText() + ' is a bad reference')
    return
  endhandle

  !textList = !!collectAllFor('TEXP',|btext ne ''|, !noteRef)

  !rowData = object ARRAY()
  !refData = object ARRAY()
  !this.keywordList.clear()

  do !entry values !textList
    !table[1] = !entry.btext.replace('?','')
    !table[2] = !entry.etext
    !rowData.append(!table)
    !refData.append(!entry.name)
    !this.keywordList.append(!table[1])
  enddo

  !this.lstKeyword.setRows(!rowData)
  !this.lstKeyword.rtext = !refData
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateExpressionText
--
-- Description: update expression
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateExpressionText()
  !rowData   = !this.lstKeyword.selection()
  !textEntry = !this.lstKeyword.rtext[!this.lstKeyword.val].dbref()
  handle any
    return
  endhandle

  !this.txtTextKey.val = !textEntry.btext.replace('?','')
  !this.txtTextExp.val = !textEntry.etext
  !this.txtTextChei.val  = !textEntry.chei

  !texpPos  = xyps of ptrf of $!textEntry

  !this.txtTextPos.val = !texpPos.east.nint().string() & ',' & !texpPos.north.nint().string()

  if (!this.optTextColour.dtext.find(!textEntry.txcolour.lowcase()).set()) then
    !this.optTextColour.val = !this.optTextColour.dtext.find(!textEntry.txcolour.lowcase())[1]
  endif

  -- update text justification attribute

  if (!this.optTextJust.dtext.find(!textEntry.just).set()) then
    !this.optTextJust.val = !this.optTextJust.dtext.find(!textEntry.just)[1]
  endif

  -- update text justification attribute
  if (!this.optTextAlign.rtext.find(!textEntry.align).set()) then
    !this.optTextAlign.val = !this.optTextAlign.rtext.find(!textEntry.align)[1]
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCommandOptionGadget
--
-- Description: set command option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN    visible flag for command option gadget
--    2     R    STRING     element type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCommandOptionGadget(!showFlag is BOOLEAN, !type is STRING)
  !this.frmDwgPreview.visible    = !showFlag.not()
  !this.frmCommandOption.visible = !showFlag
  if (!type.upcase() eq 'VIEW') then
    !this.frmModifyText.visible    = !showFlag.not()
    !this.frmModifyView.visible    = !showFlag

    !this.pgPositions.val = '[ Create / Modify View ]'
  else
    !this.frmModifyText.visible    = !showFlag
    !this.frmModifyView.visible    = !showFlag.not()

    !this.pgPositions.val = '[ Create / Modify Text ]'
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeDrawing
--
-- Description: display selected drawing whenever changing drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeDrawing(!gadget is GADGET, !dummyAction is STRING)
  if (!gadget ne !this.cboSpoolDrwg OR !this.cboSpoolDrwg.displayText().empty()) then
    return
  endif

  !this.showPreview()
  !this.populateViewList('')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setVnotForOverlayView
--
-- Description: set VNOTE for overlay view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVnotForOverlayView()
 -- get layer which has rectangle with overlay area information

  !drwgRefName = !this.getSourceDrawingElementName('DRWG')
  if (!drwgRefName.empty()) then
    return
  endif

  !drwgRef = object DBREF(!drwgRefName)

  var !olayLayer coll all LAYE with purp eq 'OLAY' for $!drwgRef
  if (!olayLayer.unset()) then
    return
  endif

  !mem = ce
  $!olayLayer[1]

  !vnotForOlay = vnote 1 of ce
  handle any
    new vnot
    !vnotForOlay = !!ce
  endhandle
  $!mem

  !this.vnotForOLayView = !vnotForOlay
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showPreview
--
-- Description: display selected drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPreview()
  -- get selected drawing or backing sheet name from gadget.
  -- try to get the drawing name first, if there's no drawing it'll try to get the bsrf.
  if (!this.cboSpoolDrwg.displayText().empty().not()) then
    !selectedEntryName = !this.cboSpoolDrwg.displayText()
    !selectedEntryType = 'Drawing'
  else
    !selectedEntryName = !this.optBSRF.displayText()
    !selectedEntryType = 'Backing Sheet'
  endif

  !this.cboSpoolDrwg.active  = !this.cboSpoolDrwg.displayText().empty().not()
  !this.btnCreateView.active = !this.cboSpoolDrwg.displayText().empty().not()

  !selectedEntryRef = !selectedEntryName.dbref()
  handle any
    !badref = true
  elsehandle none
    !badref = !selectedEntryRef.badref()
  endhandle


  if (!badref) then
    !dtext = !this.cboSpoolDrwg.dtext
    !index = !this.cboSpoolDrwg.dtext.find(!selectedEntryName)
    !dtext.remove(!index[1])
    !this.cboSpoolDrwg.dtext = !dtext

    !!alert.error(|Can not preview : $!selectedEntryName is bad reference|)
    return
  endif

  if (!selectedEntryType.upcase() eq 'DRAWING') then
    -- display selected sheet on drawing
    !sheet = sheet 1 of $!selectedEntryRef
    handle any
      return
    endhandle

    !this.setVnotForOverlayView()
    !previewEntry = !sheet
  else
    !previewEntry = !selectedEntryRef
  endif

  edit !!drapipespooldwgadmin.view area
  put $!previewEntry
  handle ANY
    exit
      handle ANY
      -- It seems that the exit sometimes is by passed by the error, depending on the error.
      endhandle

      -- May not be required in final version but update the anno on the template
      $!previewEntry
      --update anno
      handle ANY
      endhandle
      same

      return
  endhandle
  exit

  if (!selectedEntryType.upcase() eq 'DRAWING') then
    -- set backing sheet
    !backRef = !sheet.bsrf
    if (!backRef.badref()) then
      !dtext = !this.optBSRF.dtext
      !index = !this.optBSRF.dtext.find('Null Ref')
      if (!index.unset()) then
        !dtext.append('Null Ref')
        !this.optBSRF.dtext = !dtext
        !this.optBSRF.val = !dtext.size()
      else
        !this.optBSRF.val = !index[1]
      endif

      return
    endif

    if (!this.optBSRF.dtext.unset()) then
      return
    endif

    !index = !this.optBSRF.dtext.find(!backRef.name)[1]
    if (!index eq 0) then
      return
    endif

    !this.optBSRF.val = !index
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      backToMainTask
--
-- Description: back to main task
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainTask()
  !this.setCommandOptionGadget(false,'')
endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      setIsoOptionFIle
--
-- Description: set iso option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIsoOptionFIle()
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !fileBrowser = object PMLFILEBROWSER('OPEN')

  var !projCode proj code
  !homeDir = |%|& !projCode & |iso%\STD\|

  !fileBrowser.show(!homeDir, '', 'Set Iso Option File', false, 'dat files (*.pmldat)|*.pmldat', 1)

  if (!fileBrowser.file().empty()) then
      return
  endif

  -- read iso option file
  !this.isoOptionFile = object FILE(!fileBrowser.file())
  !this.txtIsoOptFile.val =  !fileBrowser.file()
  !this.loadIsoOptionFile()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadIsoOptionFile
--
-- Description: load iso option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadIsoOptionFile()
  !readData = !this.isoOptionFile.readFile()
  handle (41,319)
    write |$!!error.text|
    return
  elsehandle (160,9)
    !!alert.error(|Please check if the file exists.|)
    return
  endhandle

  do !data values !readData
    !contents = !data.split(',')
    if (!contents[1].upcase().occurs('DWGTYPE') gt 0) then
      if (!this.cboSpoolDrwg.dtext.find(!contents[2]).set()) then
        !this.cboSpoolDrwg.val = !this.cboSpoolDrwg.dtext.find(!contents[2])[1]
      endif

    elseif (!contents[1].upcase().occurs('ISOTYPE') gt 0) then
      if (!this.optIsoViewType.dtext.find(!contents[2]).set()) then
        !this.optIsoViewType.val = !this.optIsoViewType.dtext.find(!contents[2])[1]
      endif

    elseif (!contents[1].upcase().occurs('ISOMARGIN') gt 0) then
      !this.txtIsoViewMargin.val = !data.after('isoMargin,')
      !this.setOverlayViewAREA('VALUES')
    elseif (!contents[1].upcase().occurs('ISOCHARCHEIGHT') gt 0) then
      !this.txtIsoCharHeight.val = !contents[2].real()

    elseif (!contents[1].upcase().occurs('ISOFILEPATH') gt 0) then
      !this.txtIsoResultPath.val = !contents[2]
    endif
  enddo

  !this.checkIsoOptionFile()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkIsoOptionFile
--
-- Description: check Iso Option File
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkIsoOptionFile()

  !this.btnAddView.active = true
  !this.btnEditView.active = false
  !this.isoOptionFile = object FILE()

  if (!this.txtIsoOptFile.val.set()) then

    !checkIsoFile = object FILE(!this.txtIsoOptFile.val.trim())

    if (!checkIsoFile.set()) then
      if !checkIsoFile.exists() then
        !this.isoOptionFile = !checkIsoFile
        !this.btnAddView.active = false
        !this.btnEditView.active = true
      endif
    endif

  endif

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      setResultPath
--
-- Description: set result path for exporting plt file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setResultPath()
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)

  -- Use the selected folder
  !this.txtIsoResultPath.val = !folderBrowser.selectedPath()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentElement
--
-- Description: change current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     element type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCurrentElement(!type is STRING)
  !element = !!ce
  if (!type eq 'VIEW') then
    !compareType = 'VIEW'
  else
    !compareType = 'NOTE'

    if (!element.dbwrite.not()) then
      !!alert.error(|You may only modify the text belonging to the backing sheet reference.|)
      return
    endif

  endif

  if (!element.type ne !compareType and !element.ahlist.findfirst(!compareType).unset()) then
    return
  endif

  if (!type eq 'VIEW') then
    if (!element.func eq 'ISO_VIEW') then
      !!alert.error('Can not modify. current view is for ISO OLAY View')
      return
    endif
    if (!element.type eq 'VIEW') then
      !view = !element

    else
      !view = !element.ownlst[!element.ahlist.find('VIEW')[1]]
    endif

    !viewName = !element.name
    !sheetRef = !element.owner

    var !viewNames eval name for all view with func ne 'ISO_VIEW' for $!sheetRef

    !this.cboViewNames.dtext = !viewNames
    !this.cboViewNames.val = !this.cboViewNames.dtext.find(!viewName)[1]


    !iso[1]  = object DIRECTION('-X45-Y35.2644-Z')
    !iso[2]  = object DIRECTION('-X45Y35.2644-Z')
    !iso[3]  = object DIRECTION('X45Y35.2644-Z')
    !iso[4]  = object DIRECTION('-Y45X35.2644-Z')

    if (!iso.findfirst(!view.dir.wrt( /* )).set()) then
      !viewDir =  'ISO' & !iso.find(!view.dir)[1]
    else
      !viewDir = !view.dir.string().before('WRT')
    endif

    !viewSize = !view.size[1].string() & ',' & !view.size[2].string()
    !viewPos = !view.xypos.east.nint().string() & ',' & !view.xypos.north.nint().string()

    !this.setViewDirection(!viewDir)
    !this.txtViewSize.val     = !viewSize
    !this.txtViewPosition.val = !viewPos
  else
    if (!element.type eq 'NOTE') then
      !note = !element
    else
      !note = !element.ownlst[!element.ahlist.find('NOTE')[1]]
    endif

    !noteName = !element.name
    !bsrfRef  = !element.owner

    var !noteNames eval name for all note for $!bsrfRef

    !this.optNoteList.dtext = !noteNames
    !this.optNoteList.val = !this.optNoteList.dtext.find(!noteName)[1]

    !this.populateTextKeywords()

  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setAutoNaming
--
-- Description: set auto naming for a new view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAutoNaming()
  !element = !!ce

  -- checking type of current element
  if (!element.type ne 'SHEE') then
    if (!element.type eq 'VIEW' OR !element.ahlist.findfirst('VIEW').set()) then
      Sheet
      !element = !!ce
      same
    else
      !!alert.error(|Please select a Sheet|)
      return
    endif
  endif

  -- checking whether sheet is named or not.
  if (!element.isNamed.not()) then
    !!alert.error(|A Sheet should be named|)
    return
  endif

  -- get view list from current sheet
  var !viewList coll all view with func ne 'ISO_VIEW' for $!element

  !viewSize = !viewList.size() + 1
  !viewName = !element.name & '/V' & !viewSize

  -- set name for new view
  --!this.txtViewName.val = !viewName

  if (!this.cboViewNames.dtext.findfirst(!viewName).set()) then
    !this.cboViewNames.val = !this.cboViewNames.dtext.find(!viewName)[1]
  else
    !viewNames = !this.cboViewNames.dtext
    !viewNames.append(!viewName)
    !this.cboViewNames.dtext = !viewNames
    !this.cboViewNames.val   = !viewNames.size()
  endif

  !this.txtViewSize.val = ''
  !this.txtViewPosition.val = ''
  !this.btnAddView.active = true
--
--  !this.setCurrentElement('VIEW')
--
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setViewDirection
--
-- Description: set view direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setViewDirection(!viewDir is STRING)
  if (!this.cboIsoViewDir.dtext.findfirst(!viewDir).set()) then
    !this.cboIsoViewDir.val = !this.cboIsoViewDir.dtext.find(!viewDir)[1]
  else
    !viewDirs = !this.cboIsoViewDir.dtext
    --!viewDirs.insert(!this.cboIsoViewDir.dtext.size(),!viewDir)
    !viewDirs.append(!viewDir)
    !this.cboIsoViewDir.dtext = !viewDirs
    !this.cboIsoViewDir.val   = !viewDirs.size()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getViewDirection
--
-- Description: get view direction by picking on canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getViewDirection()
  -- edg pick a view
  prompt off
  prompt load escape |Identify VIEW element for derived direction|
  ID VIEW @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on

  !view = !!ce
  !viewDir = !view.direction.string().before('WRT')
  !this.setViewDirection(!viewDir)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setViewBoundary
--
-- Description: set boundary of view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setViewBoundary(!type is STRING)
  prompt off

  if (!type eq 'PICK') then
    prompt load escape |Identify corner points for view frame|
    var !shpo RSHPOS @
    handle (61,528)
      prompt on
      return
    endhandle
  else
    prompt load escape |Identify VIEW element for derived direction|
    ID VIEW @
    handle (61,528)
      prompt on
      return
    endhandle
  endif

  prompt on

  if (!type eq 'PICK') then
    !sizeData = !shpo.split(' ')

    !xDiff   = abs( !sizeData[6].real() - !sizeData[2].real() )
    !yDiff   = abs( !sizeData[8].real() - !sizeData[4].real() )

    !xCentre = ( !sizeData[6].real() + !sizeData[2].real() ) / 2
    !yCentre = ( !sizeData[8].real() + !sizeData[4].real() ) / 2

    !sizeString = !xDiff.nint().string()   & ',' & !yDiff.nint().string()
    !centrePos  = !xCentre.nint().string() & ',' & !yCentre.nint().string()

    !this.txtViewPosition.val = !centrePos

  else
    !viewSize = !!ce.size
    !sizeString = !viewSize[1] & ',' & !viewSize[2]
  endif

  !this.txtViewSize.val = !sizeString
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickViewPosition
--
-- Description: set position of view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickViewPosition(!type is STRING)
  prompt off
  prompt load escape |Identify point for view centre position|
  var !shpos shpos @
  handle (61,528)
    return
  endhandle

  !posData   = !shpos.split(' ')
  !posString = !posData[2].real().nint().string() & ',' & !posData[4].real().nint().string()

  if (!type eq 'VIEW') then
    !this.txtViewPosition.val = !posString
  else
    !this.txtTextPos.val = !posString
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      separatePos
--
-- Description: separate position with inputted value on gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .separatePos(!type is STRING) is ARRAY
  !result = object ARRAY()
  if (!type eq 'VIEW') then
    !pos  = !this.txtViewPosition.val.split(',')
  else
    !pos  = !this.txtTextPos.val.split(',')
  endif

  if (!pos.unset()) then
    !!alert.error('Please input view position')
    return !result
  endif

  !xpos = !pos[1].real()
  handle any
    !!alert.error('Invalid X position (xpos,ypos)')
    return !result
  endhandle

  !ypos = !pos[2].real()
  handle any
    !!alert.error('Invalid Y position (xpos,ypos)')
    return !result
  endhandle

  !result[1] = !xpos
  !result[2] = !ypos

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkInputDataForView
--
-- Description: check input data for making view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkInputDataForView(!isAdd is BOOLEAN) is STRING
  !viewName = ''

  if (!this.cboViewNames.dtext.unset() or !this.cboViewNames.displayText().empty()) then
    !!alert.error(|Please input View name|)
    return ''
  endif

  !viewName = !this.cboViewNames.displayText()
  if (substring(!viewName,1,1) ne |=|) then
    if (substring(!viewName,1,1) ne |/|) then
      !viewName  = '/' & !viewName
    endif
  endif

  !unusedView = !viewName.dbref()
  handle any
    if (!isAdd.not()) then
      !!alert.error(|$!viewName is bad reference|)
      return ''
    endif
  elsehandle none
    if (!isAdd) then
      !!alert.error(|$!viewName already exists|)
      return ''
    endif
  endhandle

  if (!this.txtViewSize.val.empty()) then
    !!alert.error(|Please input view size|)
  else
    !sizeData = !this.txtViewSize.val.split(',')
    if (!sizeData.size() ne 2) then
      !!alert.error(|Size should be input as x-size,y-size|)
      return ''
    else
      !xVal = !sizeData[1].real()
      handle any
        !!alert.error(|Invalid size input: | + !sizeData[1])
        return ''
      endhandle

      !yVal = !sizeData[2].real()
      handle any
        !!alert.error(|Invalid size input: | + !sizeData[2])
        return ''
      endhandle
    endif
  endif

  if (!this.txtViewPosition.val.empty()) then
    !!alert.error(|Please input view position| )
  else
    !posData = !this.txtViewPosition.val.split(',')
    if (!posData.size() ne 2) then
      !!alert.error(|Position should be input as x-position,y-position|)
      return ''
    else
      !xVal = !posData[1].real()
      handle any
        !!alert.error(|Invalid position input: | + !posData[1])
        return ''
      endhandle

      !yVal = !posData[2].real()
      handle any
        !!alert.error(|Invalid position input: | + !posData[2])
        return ''
      endhandle

    endif
  endif

  return !viewName
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkInputDataForText
--
-- Description: check input data for making a texp
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN    flag about add or modify TEXP
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return check result about input data
--
------------------------------------------------------------------------
define method .checkInputDataForText(!isAdd is BOOLEAN) is BOOLEAN

  if (!isAdd AND !this.keywordList.findfirst(!this.txtTextKey.val).set()) then
    !!alert.error(|The key : $!this.txtTextKey.val already exists|)
    return false
  endif

  if (!this.txtTextKey.val.empty()) then
    !!alert.error(|Please input a keyword|)
    return false
  endif

  if (!this.txtTextChei.val.unset()) then
    !!alert.error(|Please input text height|)
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyView
--
-- Description: create / modify / delete view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type for modifying view
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyView(!type is STRING)

  if (!type eq 'ADD') then
    !this.saveDefaultFile()
  endif

  if (!this.frmViewISOType.val eq 1 AND !type ne 'DEL') then
    if (!this.isoOptionFile.unset()) then
      !this.isoOptionFile = object FILE(!this.txtIsoOptFile.val)
    endif

    !this.isoOptionFile.open('OVER')
    handle any
      !!alert.error('Failed to save ISO option file')
      return
    endhandle

    !dwgTypeName = !this.cboSpoolDrwg.displayText()
    !regiName    = name of regi of $!dwgTypeName
    handle any
      !regiName  = ''
    endhandle



    !isoViewType = !this.optIsoViewType.displayText()
    !isoMargin   = !this.txtIsoViewMargin.val
    !isoCharHeig = !this.txtIsoCharHeight.val
    !isoFilePath = !this.txtIsoResultPath.val

    !this.isoOptionFile.writeRecord('DwgType,$!dwgTypeName')
    !this.isoOptionFile.writeRecord('IsoTmplpath,$!regiName')
    !this.isoOptionFile.writeRecord('isoViewType,$!isoViewType')
    !this.isoOptionFile.writeRecord('isoMargin,$!isoMargin')
    !this.isoOptionFile.writeRecord('isoCharCheight,$!isoCharHeig')
    !this.isoOptionFile.writeRecord('isoFilePath,$!isoFilePath')

    !this.isoOptionFile.close()
    !this.saveDefaultFile()
    savework
    !!alert.message(|Option file saved|)
    return
  elseif (!this.frmViewISOType.val eq 1 AND !type eq 'DEL') then
    if (!!alert.confirm('Are you sure you want to delete iso option file?') neq 'YES') then
      return
    endif

    !filePath = !this.isoOptionFile.fullname()
    handle any
      return
    endhandle

    syscom |del $!filePath|
    handle any
    elsehandle none
      !!alert.warning('ISO option file deleted')
    endhandle

    !this.txtIsoOptFile.val    = ''
    !this.optIsoViewType.val   = 3
--    !this.txtIsoViewSize.val   = ''
    !this.txtIsoViewMargin.val = ''
--    !this.txtIsoPicScale.val   = 160
    !this.txtIsoCharHeight.val = 2.4
    !this.txtIsoResultPath.val = ''

    return
  endif

  if (!type eq 'EDIT') then
    !viewRef = !this.cboViewNames.displayText().dbref()
    handle any
      !!alert.error(|Cannot modify. Invalid Reference|)
      return
    endhandle

    if (!viewRef.badref()) then
      !!alert.error(|Cannot modify. Invalid Reference|)
      return
    endif

    !!ce = !viewRef
  else
    !viewList = !this.cboViewNames.dtext.sort()

    do !i from !viewList.size() to 1 by -1
      !refViewRef = !viewList[!i].dbref()
      handle any
        skip
      endhandle

      skip if (!refViewRef.badref())
      break

    enddo

    !!ce = !refViewRef
    handle any
    endhandle
  endif

  if (!type eq 'ADD') then
    !viewName = !this.checkInputDataForView(true)
  else
    !viewName = !this.checkInputDataForView(false)
  endif

  !viewDir  = !this.cboIsoViewDir.displayText()
  !viewSize = !this.txtViewSize.val.split(',')

  !viewPos = !this.separatePos('VIEW')
  if (!viewPos.unset()) then
    return
  endif

  !mem = !!ce
  if (!viewName.empty()) then
    return
  endif

  if (!type eq 'ADD') then
    !sourceViewName = !refViewRef.name
    new view $!viewName copy $!sourceViewName ren $!sourceViewName $!viewName

    dir   $!viewDir
    size  $!viewSize[1] $!viewSize[2]
    xypos $!viewPos[1] $!viewPos[2]
    Lvisibility true

  elseif (!type eq 'EDIT') then
    if (!this.frmViewISOType.val ne 1) then


      $!viewName
      if (!!ce.dbwrite.not()) then
        $!mem
        !!alert.error(|Cannot change attribute. Please check DB access rights|)
        return
      endif

      dir   $!viewDir
      size  $!viewSize[1] $!viewSize[2]
      xypos $!viewPos[1] $!viewPos[2]
      $!mem
    endif

  else
    if (!!alert.confirm('Are you sure you want to delete $!viewName?') neq 'YES') then
      return
    endif

    $!viewName
    if (!!ce.dbwrite.not()) then
      !!alert.error(|Cannot delete this view. Please check DB access rights|)
      return
    endif

    delete view
    handle any
      !!alert.error(|Failed to delete $!viewName|)
    endhandle

    $!mem
    handle any
    endhandle

    !this.populateViewList('')
    !index = !this.cboViewNames.dtext.find(!viewName)
    if (!index.set()) then
      !this.cboViewNames.val = !index[1]
    endif
  endif

  refresh

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      modifyText
--
-- Description: create / modify / texp element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type for modifying text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyText(!type is STRING)
--  if (!this.mtoNoteElement.unset() or !this.refNoteElement.unset()) then
--    !!alert.error(|Backing sheet not defined|)
--    return
--  endif
  if (!this.optNoteList.displayText().unset()) then
    !!alert.error(|Please create note first|)
    return
  endif

  !noteRef = !this.optNoteList.displayText().dbref()
  handle any
    !!alert.error(|The note is a bad reference|)
    return
  endhandle

  if (!noteRef.dbwrite.not()) then
    !!alert.error(|You do not have write access to the note|)
    return
  endif

  if (!type eq 'ADD') then
    if (!this.checkInputDataForText(true).not()) then
      return
    endif
  else
    if (!this.checkInputDataForText(false).not()) then
      return
    endif
  endif

  var !textList coll all TEXP for $!noteRef
  !noteName = !noteRef.name
--  if (!this.frmTextType.val eq 1) then
--    var !textList coll all TEXP for $!this.mtoNoteElement
--    !noteName = !this.mtoNoteElement.name
--  else
--    var !textList coll all TEXP for $!this.refNoteElement
--    !noteName = !this.refNoteElement.name
--  endif

  !mem = !!ce

  !textKeyword = |?$!this.txtTextKey.val?|
  !textExpress = !this.txtTextExp.val
  !textHeight  = !this.txtTextChei.val
  !textJustification = !this.optTextJust.displayText()
  !textAlignment     = !this.optTextAlign.rtext[!this.optTextAlign.val]
  !textColour = !this.optTextColour.displayText()

  --!textPos           = !this.txtTextPos.val
  !textPos = !this.separatePos('TEXT')

  if (!type ne 'ADD') then
    !selectedItem = !this.lstKeyword.rtext[!this.lstKeyword.val]
    !textEntry    = !selectedItem.dbref()
    handle any
      !!alert.error(|$!selectedItem is bad reference|)
      return
    endhandle
  endif

  if (!type eq 'ADD') then
    if (!textList.unset()) then
      $!noteName
    else
      !lastIndex = !textList.size()
      $!textList[$!lastIndex]
    endif

    !texpName = !noteName & '/heading' &( !textList.size() + 1 )

    new texp $!texpName
    btext |$!textKeyword|
    handle (64,384)
      !textKeyword = !textKeyword.replace('?','')
      btext |$!textKeyword|
    endhandle
    etext |$!textExpress|
    chei  $!textHeight
    just  $!textJustification
    xyps x $!textPos[1] y $!textPos[2]
    align $!textAlignment
    txColour $!textColour

  elseif (!type eq 'EDIT') then
    $!textEntry
    btext |$!textKeyword|
    handle (64,384)
      !textKeyword = !textKeyword.replace('?','')
      btext |$!textKeyword|
    endhandle
    etext |$!textExpress|
    chei  $!textHeight
    just  $!textJustification
    xyps x $!textPos[1] y $!textPos[2]
    align $!textAlignment
    txColour $!textColour
  else
    $!textEntry
    if (!!ce.dbwrite.not()) then
      !!alert.error(|You do not have access rights to delete this TEXP element|)
      return
    endif

    delete TEXP
    handle any
      !!alert.error(|Failed to delete $!selectedItem|)
    endhandle
  endif

  $!mem
  handle any
  endhandle

  !this.populateNoteList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenusForKeywordList
--
-- Description: set popup menus for keywords list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupMenusForKeywordList()

  -- Popup Menus for keyword list
  !popup = !this.newMenu('keywordListPopup')
  !popup.add( 'callback', 'Navigate to Selected Item',  |!this.navigateKeyword('ITEM')| )
  !popup.add( 'callback', 'Navigate to Owner of Selected Item',       |!this.navigateKeyword('OWNER')| )
  !popup.add( 'callback', 'Highlight Selected Item',       |!this.highlightElement()| )

  !this.lstKeyword.popup   = !popup

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      popupMenusForDwgTmpl
--
-- Description: set popup menus for drawing template and backing sheet gadget(cboSpoolDrwg,optBSRF)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupMenusForDwgTmpl()

  !popup1 = !this.newMenu('dwgTmplPopup')
  !popup1.add( 'callback', 'Navigate to Selected Item',  |!this.navigateDwgTmpl('DWGTMPL')| )
  !popup1.add( 'callback', 'Open Sheet',  |CALLIBM XELEMSEL| )
  !this.cboSpoolDrwg.popup = !popup1

  !popup2 = !this.newMenu('bsrfPopup')
  !popup2.add( 'callback', 'Navigate to Selected Item',  |!this.navigateDwgTmpl('BACKINGSHEET')| )
  !this.optBSRF.popup = !popup2

  !popup3 = !this.newMenu('viewPopup')
  !popup3.add( 'callback', 'Navigate to Selected Item',  |!this.navigateDwgTmpl('VIEW')| )
  !this.cboViewNames.popup = !popup3

  !popup4 = !this.newMenu('notePopup')
  !popup4.add( 'callback', 'Navigate to Selected Item',  |!this.navigateDwgTmpl('NOTE')| )
  !popup4.add( 'callback', 'Show Note',  |!this.setNoteVisibility(true)| )
  !popup4.add( 'callback', 'Hide Note',  |!this.setNoteVisibility(false)| )
  !this.optNoteList.popup = !popup4
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setNoteVisibility
--
-- Description: change note visibility
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    BOOLEAN    flag for displaying or hiding a note
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNoteVisibility(!visibilityFlag is BOOLEAN)
  !noteRefName = !this.getSourceDrawingElementName('NOTE')
  if (!noteRefName.empty()) then
    return
  endif

  !noteRef = object DBREF(!noteRefName)
  if (!noteRef.dbwrite.not()) then
    return error 1  'It cannot write this db. Check DB rights or claim'
  endif

  if (!visibilityFlag) then
    !noteRef.lvis = true
  else
    !noteRef.lvis = false
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      navigateKeyword
--
-- Description: navigate texp element which has specify key-word
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigateKeyword(!type is STRING)
  !selectedItem = !this.lstKeyword.rtext[!this.lstKeyword.val]
  !textEntry    = !selectedItem.dbref()
  handle any
    !!alert.error(|$!selectedItem is bad reference|)
    return
  endhandle

  if (!type eq 'ITEM') then
    !!ce = !textEntry
  else
    !!ce = !textEntry.owner
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      highlightElement
--
-- Description: highlight element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightElement()
  !selectedItem = !this.lstKeyword.rtext[!this.lstKeyword.val]
  !textEntry    = !selectedItem.dbref()
  handle any
    !!alert.error(|$!selectedItem is bad reference|)
    return
  endhandle

  !!ce = !textEntry
  high

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      navigateDwgTmpl
--
-- Description: navigate selected drawing template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateDwgTmpl(!type is STRING)
  if (!type eq 'DWGTMPL') then
    !navigateItem = !this.cboSpoolDrwg.displayText()
  elseif (!type eq 'BACKINGSHEET') then
    !navigateItem = !this.optBSRF.displayText()
  elseif (!type eq 'VIEW') then
    !navigateItem = !this.cboViewNames.displayText()
  elseif (!type eq 'NOTE') then
    !navigateItem = !this.optNoteList.displayText()
  endif

  if (!navigateItem.empty()) then
    return
  endif

  if (substring(!navigateItem,1,1) ne |/|) then
    !navigateItem = '/' & !navigateItem
  endif

  $!navigateItem
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOverlayViewAREA
--
-- Description: get overlay view area from existing rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getOverlayViewAREA()
  !mem = ce
-- edg pick a view
  prompt off
  prompt load escape |Identify RECTangle element for getting margin|
  ID RECT @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on

  !this.txtIsoViewMargin.val = !this.getMarginFromRectangle(!!ce)
  $!mem
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setOverlayViewAREA
--
-- Description: set overlay view area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     action type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOverlayViewAREA(!type is STRING)
  !marginPos = object ARRAY()
  if (!type eq 'VALUES') then
    !tmpData = !this.txtIsoViewMargin.val.split(',')
    if (!this.txtIsoViewMargin.val.empty() OR !tmpData.size() ne 4) then
      !!alert.error(|Enter margin (left,right,top,bottom)|)
      return
    endif

    do !val values !tmpData
      !marginPos.append(!val.real())
      handle any
        !!alert.error(|Invalid margin entered|)
        return
      endhandle
    enddo
  endif

  !mem = ce

  if (!this.vnotForOLayView.unset() OR !this.vnotForOLayView.badref()) then
    !!alert.error(|Check VNOT element for overlay area|)
    return
  endif

  !!ce = !this.vnotForOLayView
  !size =  size of sheet

  delete vnot mem
  handle any
    !!alert.error('It cannot write this db. Check DB rights or claim')
    return
  endhandle

  if (!type eq 'VALUES') then
    !xlen = nint(abs(!marginPos[2] - !marginPos[1]))
    !ylen = nint(abs((!size[2] - !marginPos[3]) - !marginPos[4]))

    !xcen = nint((!marginPos[1] + !marginPos[2]) / 2)
    !ycen = nint(abs((!size[2] - !marginPos[3]) + !marginPos[4]) / 2)

    -- make rectangle & texp entry for displaying iso overlay area
    new rect
    xypos x $!xcen y $!ycen
    xlen $!xlen
    ylen $!ylen

    new texp
    xypos x $!xcen y $!ycen
    btext |OLAY AREA|
    Justification center
    font 20
    handle any
    endhandle
    cheight 15mm

    by y -10mm

  else
    -- make rectangle & texp entry for displaying iso overlay area
    NEW RECT
    prompt off
    prompt load escape |Identify frame corner points for overlaying view|
    DEF @
    handle (61,528)
      delete rect
      prompt on
      return
    endhandle
    prompt on
    prompt dismiss

    !this.txtIsoViewMargin.val = !this.getMarginFromRectangle(!!ce)

    new texp
    btext |OLAY AREA|
    Justification center
    font 20
    handle any
    endhandle
    cheight 15mm

    by y -10mm
  endif

  $!mem
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getMarginFromRectangle
--
-- Description: get margin from existing rectangle element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF       source element which used to be get rectangle size
-- Return:
--   [Data Type] [Description]
--    1     R    DBREF       return margin
--
------------------------------------------------------------------------
define method .getMarginFromRectangle(!rectangle is DBREF) is STRING
  !size = size of sheet

  !!ce = !rectangle

  !xyps = xyps of ptrf

  !xcen = !xyps.east
  !ycen = !xyps.north

  !leftMargin  = nint(!xcen - ( xlen / 2 ))
  !rightMargin = nint(!xcen + ( xlen / 2 ))
  !topMargin   = nint(!size[2] - (!ycen + (ylen / 2)))
  !botMargin   = nint(!ycen - (ylen / 2))

  !result = |$!leftMargin,$!rightMargin,$!topMargin,$!botMargin|
  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveDefaultFile
--
-- Description: save default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveDefaultFile()

  !defaultData = object ARRAY()
  !defaultData.append('!this.txtIsoOptFile.val@$!this.txtIsoOptFile.val')
  !defaultData.append('!this.txtIsoResultPath.val@$!this.txtIsoResultPath.val')
  !defaultData.append('!this.optIsoViewType.val@$!this.optIsoViewType.val')
  !defaultData.append('!this.txtIsoCharHeight.val@$!this.txtIsoCharHeight.val')
  !defaultData.append('!this.txtIsoViewMargin.val@$!this.txtIsoViewMargin.val')

  !defaultData.append('!this.cboViewNames.val@$!this.cboViewNames.val')
  !defaultData.append('!this.cboIsoViewDir.val@$!this.cboIsoViewDir.val')
  !defaultData.append('!this.txtViewSize.val@$!this.txtViewSize.val')
  !defaultData.append('!this.txtViewPosition.val@$!this.txtViewPosition.val')

  !this.defaultFile.writeFile('OVER',!defaultData)
  handle any
    write '[warning] It was failed to save the data file for pipe spool dwg. admin'
  endhandle

  !this.defaultFile.close()
  !this.btnAddView.active = false
  !this.btnEditView.active = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadDefaultFile
--
-- Description: load default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadDefaultFile()
  -- reads the values from data file if it exists
  if (!this.defaultFile.exists().not()) then
    return
  endif

  -- reads the file
  !defData = !this.defaultFile.readFile()
  handle (41,319)
    write |$!!error.text|
    return
  endhandle

  do !data values !defData
    !gadget = !data.part(1,'@')
    !value  = !data.part(2,'@')
    skip if (!value.empty())

    !unusedReal = !value.real()
    handle any
      !command = |$!gadget = '$!value'|
    elsehandle none
      !command = |$!gadget = $!value|
    endhandle
    $!command
    handle any
    endhandle
  enddo
endmethod
