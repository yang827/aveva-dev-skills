-- File:            drasettings.pmlfrm
--   Type:          Form Definition
--   Group:         Settings
--
--     Keyword:     Options
--   Module:        Draft
--   Replaces:
--
-- Author:          Andy Kirkland
-- Created:         Fri Jun 25    13:57:36  2004
--
--
-- Description:
-- Form to display DRAFT settings to replace existing settings forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actionForm()                     -                   Action the form (OK & APPLY), by setting the values in PDMS
--  draSettings()                    -                   Constructor
--  init(STRING)                     -                   Initialisation of the form
--  setButton(GADGET,BOOLEAN)        -                   set the colour of the background of the gadget passed
--  setColour(STRING,BOOLEAN)        -                   set the button colour
--
------------------------------------------------------------------------

layout form !!draSettings dialog AutoAlign
--setup form !!draSettings

path down
frame .tabSet tabset
  -- Graphical Colour settings
  -- Page 1
  frame .graphics 'Graphics' width 30
    path down
    frame .colourSettings 'Colour Highlighting' width 29
     halign centre
     button    .feedbackButton ' ' wid 2
     button    .enhanceButton  ' ' wid 2
     toggle    .highLightView
     halign left
     paragraph .feedbackPara at xmax.feedbackButton+5 ymin.feedbackButton text 'Feedback Colour'
     paragraph .enhancePara                                               text 'Enhance Colour'
     paragraph .highLightViewPara                                         text 'Highlight Current View'
    exit

    -- Picking default setting
    !wtag = 8
    frame .pointConstruction 'Point Construction'  wid to max.colourSettings
      option .mode tagwid $!wtag |Option| width 15
    exit

    -- Ppoint Settings
    frame .pPointSettings 'Ppoint Display' wid to max.colourSettings
      vdist 0.2
      !wtag = 8
      option .elem  tagwid $!wtag |Ppoints on| width 13
      option .styl  tagwid $!wtag |Style|      width 6
      option .scale tagwid $!wtag |Scale|      width 2
    exit
  exit

  -- Page 2
  frame .draughtSettings '2D Draughting' wid.graphics
     path right
     valign centre
     !wtag = 16
     text .bulge    tagwid $!wtag |Cloud Bulge Factor| width 8 is REAL
     para .bulgePix pixmap width 16 height 16

     text .gaps    tagwid $!wtag |Line Gap| at xmin.bulge ymax+0.6 width 8 is REAL format !!distanceFmtForm
     para .gapPix   pixmap width 16 height 16

     text .cham1   tagwid $!wtag |Chamfer First Pick| at xmin.bulge ymax+0.6 width 8 is REAL format !!distanceFmtForm
     para .cham1Pix pixmap width 16 height 16

     text .cham2   tagwid $!wtag |Chamfer Second Pick| at xmin.bulge ymax+0.6 width 8 is REAL format !!distanceFmtForm
     para .cham2Pix pixmap width 16 height 16

     text .frad    tagwid $!wtag |Fillet Radius| at xmin.bulge ymax+0.6 width 8 is REAL format !!distanceFmtForm
     para .fradPix  pixmap width 16 height 16
  exit

  -- Page 3
  frame .drawing 'Drawing' wid.graphics
    !wtag = 16
    frame .pickSettings 'Picking'
      text .tol     tagwid $!wtag |Point Merge Tolerance| width 10 is REAL format !!distanceFmtForm
      text .pkdi    tagwid $!wtag |Pline Proportion|  width to max.tol num min 0 max 1
    exit

    frame .general 'General'
      text .precd   tagwid $!wtag |Precision Distance|  width to max.tol STRING
      option .precb tagwid $!wtag |Precision Bore|      width to max.tol
      option .aBlnk tagwid $!wtag |Autoblanking|        width to max.tol
      text .rMass   tagwid $!wtag |Mass Property Level| width to max.tol integer min 0 max 9999
    exit
  exit
exit


-- OK and Cancel buttons
  button .default |Default|  at xmin.graphics
  path right
  hdist 0.5
  button .apply   |Apply|  at xmax form-size
  path left
  button .cancel  |Cancel| CANCEL
  button .ok      | OK |   OK

exit
-- End of form definition for !!draSettings
------------------------------------------------------------------------
--
-- Method:      draSettings()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draSettings()

-- form setup
   !this.formTitle                 = 'General Settings'
   !this.iconTitle                 = 'settings'
   !this.cancelCall                = ''
   !this.callback                  = '!this.init(|INIT|)'
   !this.formRevision              = '$Revision: 1.4 $ '
   !this.feedbackButton.callback   = '!this.setColour(|FEEDBACK|, false)'
   !this.enhanceButton.callback    = '!this.setColour(|ENHANCE|, false)'
   !this.ok.callback               = '!this.actionForm()'
   !this.apply.callback            = '!this.actionForm()'
   !this.default.callback          = '!this.init(|DEFAULT|)'
   !this.highLightView.val         = TRUE

-- set the descriptive icons
   !this.bulgePix.addPixmap('/%PDMSUI%/ICONS/dra/dra0003916.png')
   !this.gapPix.addPixmap(!!pml.getpathname('singlegap16.png'))
   !this.cham1Pix.addPixmap(!!pml.getpathname('chamfirst16.png'))
   !this.cham2Pix.addPixmap(!!pml.getpathname('chamsecd16.png'))
   !this.fradPix.addPixmap(!!pml.getpathname('frad16.png'))

-- set values of the ppoint option gadgets
   !dText[1] = 'Significant' !rText[1] = 'SIG'
   !dText[2] = 'Primitives ' !rText[2] = 'PRI'
   !this.elem.dText = !dText
   !this.elem.rText = !rText

   !dText.clear()
   !rText.clear()
   !dText[1] = 'Stop'  !rText[1] = 'STOP'
   !dText[2] = 'Plus'  !rText[2] = 'PLUS'
   !dText[3] = 'Star'  !rText[3] = 'STAR'
   !dText[4] = 'Ring'  !rText[4] = 'RING'
   !dText[5] = 'Cross' !rText[5] = 'CROSS'

   !this.styl.dText = !dText
   !this.styl.rText = !rText

   !dText.clear()
   !dText[1] = '1'   !dText[2] = '2'   !dText[3] = '3'   !dText[4] = '4'
   !dText[5] = '5'   !dText[6] = '6'   !dText[7] = '7'   !dText[8] = '8'

   !this.scale.dText = !dText

-- set values of point construction gadgets
   !dText.clear()
   !rText.clear()
   !dText[1]  = 'Repeat'          !rText[1]  = 'REPEAT'
   !dText[2]  = '2D Cursor hit'   !rText[2]  = 'TWODHIT'
   !dText[3]  = 'End point of'    !rText[3]  = 'ENDOF'
   !dText[4]  = 'Centre pt of'    !rText[4]  = 'CENTREOF'
   !dText[5]  = 'Mid point of'    !rText[5]  = 'MIDOF'
   !dText[6]  = 'Mid pt between'  !rText[6]  = 'MIDBETWEEN'
   !dText[7]  = 'Intersection at' !rText[7]  = 'INTAT'
   !dText[8]  = 'Inter. between'  !rText[8]  = 'INTBETWEEN'
   !dText[9]  = 'Nearest to'      !rText[9]  = 'NEAREST'
   !dText[10] = 'X coordinate of' !rText[10] = 'XOF'
   !dText[11] = 'Y coordinate of' !rText[11] = 'YOF'

   !this.mode.dText = !dText
   !this.mode.rText = !rText

   !dText.clear()
   !dText[1] = |Nominal|
   !dText[2] = |Actual|
   !this.precb.dText = !dText

   !dText.clear()
   !dText[1] = |On|
   !dText[2] = |Off|
   !this.aBlnk.dText = !dText

   !this.init('DEFAULT')

endmethod
-- End of method definition for .draSettings()
------------------------------------------------------------------------
--
-- Method:      init(STRING)
--
-- Description: Initialisation of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Initialise or Default setting button]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!mode is STRING)

if(!mode.upcase().eq(|INIT|)) then

  var !tol TOL
  var !pkdi setdef pkdi
  var !gaps setdef gaps
  var !aBlnk autoblanking
  var !rMass repre mass

  !this.tol.val   = !tol.real(!!distanceFmtForm)
  !this.pkdi.val  = !pkdi
  !this.gaps.val  = !gaps.real(!!distanceFmtForm)
  !this.aBlnk.select('RTEXT', !aBlnk)
  !this.rMass.val = !rMass

-- check the old form exists
  if(undefined(!!cdrSetDef)) then
   pml load form !!cdrSetDef
  endif

-- get initialised values from the old form, as using it to store and reference old macros
   !this.bulge.val = !!cdrSetDef.bulge.val.real()
   !this.cham1.val = !!cdrSetDef.cham1.val
   !this.cham2.val = !!cdrSetDef.cham2.val
   !this.frad.val  = !!cdrSetDef.frad.val
-- NOTE :- done this way because there is NO query for these values
   !this.precd.val = !!cdrSetDef.precd.val
   !this.precb.select('DTEXT', !!cdrSetDef.precb.selection())

-- set other values from current settings
   var !elem ppoints
   if(!elem.eq('Significant')) then
      !this.elem.val = 1
   else
      !this.elem.val = 2
   endif

   var !feed setfeedback ppoints
   !this.styl.select('RTEXT',!feed.part(3))
   !this.scale.select('RTEXT',!feed.part(2))

elseif(!mode.upcase().eq(|DEFAULT|)) then

-- set the default values for the gadgets
  !this.feedbackButton.background = 6
  !this.enhanceButton.background  = 8
  !this.elem.val  = 2
  !this.styl.val  = 3
  !this.scale.val = 2
  !this.mode.val  = 1
  !this.aBlnk.val = 1

  !this.rMass.val = '6'
  !this.precb.select('RTEXT', 'Nominal')
  !this.aBlnk.select('RTEXT', 'On')
  !this.pkdi.val = '0.5'
  !this.bulge.val = 0.85


  if (!!isImperialLength('DIST')) then
    !this.gaps.val  = 1/8in
    !this.cham1.val = 1/2in
    !this.cham2.val = 1/2in
    !this.frad.val  = 1/2in
    !this.precd.val = '1/32in'
    !this.tol.val   = 1/32in
  else
    !this.gaps.val  = 2mm
    !this.cham1.val = 10mm
    !this.cham2.val = 10mm
    !this.frad.val  = 10mm
    !this.precd.val = '1mm'
    !this.tol.val   = 0.2mm
  endif

endif
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      setColour(STRING)
--
-- Description: set the button colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Button to change colour]
--   [2] [R]    [BOOLEAN]   [True if called from popup on the 2d view]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!button is STRING, !fromMainScreen is BOOLEAN)

if(!button.eq('FEEDBACK')) then
  !!colourSelectLoad('!!draSettings.setButton(!!draSettings.feedbackButton, $!fromMainScreen)', 'Feedback Colour', !!draSettings.feedbackButton.background)
else
  !!colourSelectLoad('!!draSettings.setButton(!!draSettings.enhanceButton, $!fromMainScreen)', 'Enhance Colour', !!draSettings.enhanceButton.background)
endif

endmethod
-- End of method definition for .setColour()
------------------------------------------------------------------------
--
-- Method:      setButton(GADGET)
--
-- Description: set the colour of the background of the gadget passed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Button to change colour]
--   [2] [R]    [BOOLEAN]   [True if called from popup on the 2d view]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setButton(!button is GADGET, !fromMainScreen is BOOLEAN)

-- get the colour number of the button pressed

  !colNumber         = !!colourSelectGet()
  !button.background = !colNumber
   if(!fromMainScreen) then
     -- set the colour in CORE live if called from the 2d view
     if(!button.name().eq('FEEDBACKBUTTON')) then
       setfeedback  colour $!colNumber
     else
       setenhance  colour $!colNumber
     endif
   endif

endmethod
-- End of method definition for .setButton()
------------------------------------------------------------------------
--
-- Method:      actionForm()
--
-- Description: Action the form (OK & APPLY), by setting the values in PDMS
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionForm()

-- set as variables for expanding on the PDMS command line
  !gaps   = !this.gaps.val
  !tol    = !this.tol.val
  !pkdi   = !this.pkdi.val
  !precd  = !this.precd.val
  !precb  = !this.precb.selection()
  !aBlnk  = !this.aBlnk.selection()
  !rMass  = !this.rMass.val

-- for unit testing
-- write ' setfeedback colour $!this.feedbackButton.background '
-- write ' setenhance  colour $!this.enhanceButton.background  '
-- write ' setfeedback ppoints $!this.styl scale $!this.scale  '
-- write ' ppoints $!this.elem                                 '
-- write ' pcoption $!this.mode                                '
-- write ' setdef gaps  $!gaps                                 '
-- write ' tol          $!tol                                  '
-- write ' setdef pkdi  $!pkdi                                 '
-- write ' prec dist    $!precd                                '
-- write ' prec bore    $!precb                                '
-- write ' autoblanking $!aBlnk                                '
-- write ' repre mass   $!rMass                                '

-- Command line setting of values
  setfeedback colour $!this.feedbackButton.background
  setenhance  colour $!this.enhanceButton.background
  setfeedback ppoints $!this.styl scale $!this.scale
  ppoints      $!this.elem
  pcoption     $!this.mode
  setdef gaps  $!gaps
  tol          $!tol
  setdef pkdi  $!pkdi
  prec dist    $!precd
  handle ANY
   -- this command doesn't work if the format is unrecognised by PDMS.
   prec dist 1/32
  endhandle
  prec bore    $!precb
  autoblanking $!aBlnk
  repre mass   $!rMass

-- set the old form values as other functions reference the old form
  if(undefined(!!cdrSetDef)) then
   pml load form !!cdrSetDef
  endif

  -- SB DFN8654 all the Global Settings form values are now updated, as they need to be because other PDMSUI macros use them.
  !!cdrSetDef.tol.val   = !this.tol.val
  !!cdrSetDef.pkdi.val  = !this.pkdi.val
  !!cdrSetDef.bulge.val = !this.bulge.val
  !!cdrSetDef.gaps.val  = !this.gaps.val
  !!cdrSetDef.cham1.val = !this.cham1.val
  !!cdrSetDef.cham2.val = !this.cham2.val
  !!cdrSetDef.frad.val  = !this.frad.val
  !!cdrSetDef.precd.val = !this.precd.val
  !!cdrSetDef.precb.select('DTEXT', !this.precb.selection())
  !!cdrSetDef.aBlnk.select('DTEXT', !this.aBlnk.selection())
  !!cdrSetDef.rMass.val = !this.rMass.val

-- unenhance any views if .highLightView is not set
  if(!this.highLightView.val.not()) then
     !sheet = !!appDraMain.sheet.selection('RTEXT')
     if(!sheet.neq('')) then
       unenhance all view for $!sheet
       handle ANY
       endhandle
     endif
  endif

endmethod
-- End of method definition for .actionForm()
