--    Group:         Labels
--      Keyword:     Symbolic
--    Module:        Draft
--  Author:          T.Lisowski
--  Created:         Fri Feb 29 17:43:05 2008
--
--  Description:     The form handling the selection of the Symbol Template
--                   or a Text Template for a SLAB. It is a rewriting of
--                   the files: USHOWLIB, FSYLALIB, ISYLALIB, MSYLALIB,
--                   USETVIEW into a single PML2 form. It works together
--                   with the draLabelsFast form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draSylaLib()                     -                   Constructor
--  init()                           -                   Initialise form
--  loadLibraries()                  -                   Loads the library and LALB/SYLB names into the gadgets
--  newLib(STRING)                   -
--  putLib()                         -                   Callback to show the selected SYLB
--  resetLimits()                    -                   Resets the limits of the view to show the entire sheet
--  select()                         -                   Callback to select the template (store it in calling form)
--  selectLibrary(STRING,STRING)     -
--  setLibType(STRING,FORM)          -
--
------------------------------------------------------------------------
--
setup form !!draSylaLib dialog

  bar
  exit
  !bar = !this.bar
  !bar.add('Control', 'MBCONTROL')

  !menu = !this.newMenu('mbControl')
  !menu.add('CALLBACK', 'Refresh', 'refresh !!draSylaLib.library', 'refresh')
  !menu.add('CALLBACK', 'Reset Limits', '!this.resetLimits()', 'resetLimits')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Close', '!this.hide()', 'close')

  path down
  vdist 0.2
  view .library AREA
    WIDTH 50 ASPECT 1
    SETCOLOUR 15
  exit
  option .liby 'Library' tagwidth 11 width 36
  para .paraLib text ' ' width 10
  option .lib  at x11 ymin width 36
  button .select at x0 'Select' width 8
  button .close  at xmax form-size ymin 'Close' width 8 OK

  member .libType is STRING
  member .defLiby is STRING
  member .form is FORM
exit

------------------------------------------------------------------------
--
-- Method:      draSylaLib
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draSylaLib()
  !this.formTitle = 'Library'
  !this.iconTitle = 'LIBRARY'
  !this.initCall  = '!this.init()'
  !this.formRevision = '$Revision: '
  !this.libType = 'XXXX'

  !this.liby.callback   = |!this.newLib('')|
  !this.lib.callback    = |!this.putLib()|
  !this.select.callback = |!this.select()|
endmethod
-- End of method definition for .draSylaLib()

------------------------------------------------------------------------
--
-- Method:      loadLibraries
--
-- Description: Loads the library and LALB/SYLB names into the gadgets
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .loadLibraries()
  !ref = REF
  !this.lib.clear()
  !this.liby.clear()

  !isSymb = !this.libType.eq('SYMB')
  !isSlab = !this.libType.eq('SLAB')
  if( not ( !isSymb or !isSlab ) ) then
    return error 1 |!!draSylaLib: Member .libType incorrectly set (either SYMB or SLAB expected)!|
  endif

  if( !isSymb ) then
    !this.paraLib.val = 'Symbol Liby'
    !lType = 'SYLB'
    !isLalb = false
    -- move to SYLB element
    $_CDRUDFLTS_SYMB $* may be unset or invalid
    handle any
      return error 1 |Pointer to Symbol Library not set. Contact your system administrator|
    endhandle
  else $* isSlab is true
    !this.paraLib.val = 'Lab/Symb Liby'
    !lType = 'LALB'
    !isLalb = true
    -- move to LALB element
    $_CDRUDFLTS_SLAB $* may be unset or invalid
    handle any
      return error 1 |Pointer to Symbolic Label Library not set. Contact your system administrator|
    endhandle
  endif

  -- load all LIBYs into master library gadget
  -- goto default library end load all LIBYs under DEPT that contain sylb/lalb
  -- STOP adding when LIBY is found that contains no SYLBs or LALBs,
  -- this enables users to hide template LIBYs at bottom of DEPT

  !lib = NAME
  !this.defLiby = !lib
  -- move to SYLB/LALB owner
  !dText = ARRAY()
  OWNER
  !foundLib = false
  !libyCount = MEM LIBY COUNT
  do !n from 1 to !libyCount
    LIBY $!n
    if( !isLalb ) then
      -- Bug fix Note: if SLABs are created now allow the user to select SYLB & LALBs
      !lalbCount = MEM LALB COUNT
      !sylbCount = MEM SYLB COUNT
      !lCount = !lalbCount + !sylbCount
    else
      !lCount = MEM $!lType COUNT
    endif
    if( !lCount.neq(0) ) then
      !foundLib = true
      !lName = NAME
      !dText.append(!lName)
    else
      -- Have ANY SYLBs/LALBs been found yet? Then go no further down the DEPT list ...
      break if ( !foundLib )
    endif
  enddo
  !this.liby.dText = !dText
  !this.liby.select('Dtext', !lib)
  handle (61,122) $* selected element is not in list
    !this.liby.add(!lib)
    !this.liby.select('Dtext', !lib)
  endhandle
  $!ref
endmethod
-- End of method definition for .loadLibraries()

------------------------------------------------------------------------
--
-- Method:      setLibType
--
-- Description: Sets the library type (as the !!CDLIBTYPE variable for USHOWLIB)
--
-- Note: The form passed as the argument must meet the following criteria:
--   1. It has a TEXT gadget called 'template', which is queried and set
--   2. It has a libraryForm(REAL) method showing/hiding the !!draSylaLib form
--
-- Method Type: Procedure
-- Arguments:
--   1    R   STRING    The library type (SYMB or SLAB)
--   2    R   FORM      The calling form
-- Return:
--
------------------------------------------------------------------------
define method .setLibType( !libType is STRING, !form is FORM )
  if( !libType.eq('SYMB') or !libType.eq('SLAB') ) then
    !this.form = !form
    !name = !form.fullName()
    !this.cancelCall      = '$!name$n.libraryForm(0)'
    !this.close.callback  = '$!name$n.libraryForm(0)'
    if( !this.libType.neq(!libType) ) then
      !this.libType = !libType
      !this.loadLibraries()
    endif
  else
    return error 1 |!!draSylaLib: Unknown library type '$!libType'|
  endif
endmethod
-- End of method definition for .setLibType(STRING, FORM)

------------------------------------------------------------------------
--
-- Method:      selectLibrary
--
-- Description: Selects the given LIBY and LALB/SYLB
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING  The name of the LIBY
--   2  R  STRING  The name of the LALB/SYLB
-- Return:
--
------------------------------------------------------------------------
define method .selectLibrary( !liby is STRING, !lib is STRING )
  if( !liby.empty() ) then
    !toLiby = !this.defLiby
  else
    !toLiby = !liby
  endif
  !curLiby = !this.liby.selection()
  -- Is this a different LIBY?
  if( !curLiby.neq(!toLiby) or !this.lib.count.eq(0) ) then
    !this.liby.select('Dtext', !toLiby)
    handle (61,122) $* selected element is not in the list
      !this.liby.add(!toLiby)
      !this.liby.select('Dtext', !toLiby)
    endhandle
    !this.newLib(!lib)
  -- Does the user request the default LALB/SYLB?
  elseif( !lib.empty() ) then
    if( !this.lib.count.eq(0) ) then
      !this.newLib('')
      !this.lib.val = 1
      !this.putLib()
    endif
  -- Does the user request an explicit LALB/SYLB?
  else
    !this.lib.select('Dtext', !lib)
    handle (61,122)
      if( !this.lib.count.gt(0) ) then
        !this.lib.val = 1
      endif
    endhandle
    !this.putLib()
  endif
endmethod
-- End of method definition for .selectLibrary(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
	
  !template = !this.form.template.val
  handle ANY
    !isSet = false
  elsehandle None
    !isSet = !template.set()
  endhandle
  if( !isSet ) then
    !lib = NAME of OWNER of $!template
    handle any
      !this.selectLibrary('', '')
      return
    endhandle
    !liby = NAME of OWNER of $!lib
    !this.selectLibrary(!liby, !lib)
  else
    !this.selectLibrary('', '')
  endif
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      resetLimits
--
-- Description: Resets the limits of the view to show the entire sheet
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .resetLimits()
  var !sheet GADGET _draSylaLib_library AREA CONTENTS
  var !size ( SIZE of $!sheet )

  edit _draSylaLib_library AREA
    limits 0 0 TO $!size
    handle ANY
      exit
      return error
   endhandle
  exit
endmethod
-- End of method definition for .resetLimits()

------------------------------------------------------------------------
--
-- Method:      newLib
--
-- Description: Callback to initialise the selection from a new library
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING  Name of the default SYLB/LALB (or empty string)
-- Return:
--
------------------------------------------------------------------------
define method .newLib( !curLib is STRING )
  !save = REF
  -- load option gadget with liby SYLBs or LALBs only...
  if( !this.libType.eq('SYMB') ) then
    !lType = 'SYLB'
  else $* SLAB
    !lType = 'LALB'
  endif
  !liby = !this.liby.selection()
  if( !liby.empty() ) then
    return
  endif
  $!liby
  handle ANY
    return
  endhandle
  -- Add the members to the list
  !dTextLib = ARRAY()
  !nMembers = MEM $!lType COUNT
  do !n from 1 to $!nMembers
    !name = NAME of $!lType $!n
    !dTextLib.append(!name)
  enddo
  if( !lType.eq('LALB') ) then
    -- Bug fix Note: also add SYLBs as SLABS can reference SYTMs under SYLBs!
    !nMembers = MEM SYLB COUNT
    do !n from 1 to $!nMembers
      !name = NAME of SYLB $!n
      !dTextLib.append(!name)
    enddo
  endif
  $!save
  -- Set the list contents
  !this.lib.dText = !dTextLib
  !nLibOK = !dTextLib.empty().not()
  if( !curLib.empty() ) then
    if( !nLibOK ) then
      !this.lib.val = 1
    endif
  else
    !this.lib.select('Dtext', !curLib)
    handle (61,122) $* selected element is not in list
      if( !nLibOK ) then
        !this.lib.val = 1
      endif
    endhandle
  endif
  -- Update the area view
  !this.putLib()
endmethod
-- End of method definition for .newLib(STRING)

------------------------------------------------------------------------
--
-- Method:      putLib
--
-- Description: Callback to show the selected SYLB
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .putLib()
  !lib = !this.lib.selection()
  if( !lib.empty() ) then
    -- Any means of clearing the view?
  else
    edit _draSylaLib_library AREA
      put $_draSylaLib_lib
      handle ANY
        exit
        return error
      endhandle
    exit
  endif
endmethod
-- End of method definition for .putLib()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Callback to select the template (store it in the calling form)
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .select()
  !ref = REF
  prompt off
  prompt load escape |Identify library label required|
  ID SYTM TXTM @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on
  !this.form.template.val = FULLNAME
  handle ANY
  elsehandle NONE
  	if !this.form.string().eq('DRALABELSFAST') then
      !this.form.applyTemplate(!this.form.ref)
    endif
  endhandle
endmethod
-- End of method definition for .select()
