--
-- File:            drattfontsel.pmlfrm
--   Type:          Form Definition
--   Group:         common
--     Keyword:     TrueType fonts
--   Module:        DRAFT
--
-- Author:          T.Lisowski
-- Created:         Tue Jul 16 11:04:44 2007
--
-- Description:
-- Form providing a selection of the TrueType fonts configured in the SYSTEM DB
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbSort(BOOLEAN)                  -
--  draTTFontSel()                   -
--  init()                           -                   INIT callback
--  ok()                             -
--
kill !!draTTFontSel

setup form !!draTTFontSel at xr0 yr 0
  member .fontGadget is GADGET
  member .fontAtt is STRING
  frame .sortBy 'Sort by'
    rtoggle .s1 'DB ordering' tagwidth 8
    path right
    rtoggle .s2 'Face name' tagwidth 7
    rtoggle .s3 'Font ID' tagwidth 6
    rtoggle .s4 'Description' tagwidth 8
  exit
  path down
  list .fonts 'TrueType fonts' anchor all COLUMNS SINGLE width_sortBy length 10
  toggle .bold 'Bold'
  path right
  toggle .italic 'Italic'
  path down
  button .btnOK 'OK' at xmin_fonts anchor left+bottom callback '!this.ok()' width 8 OK
  path right
  button .btnCancel 'Cancel' at xmax form-size anchor right+bottom CANCEL
exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      draTTFontSel
--
-- Description: Constructor method
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draTTFontSel()
  !this.initcall = '!this.init()'
  !this.formTitle = 'TrueType font selection'
  !h[1] = 'Face name'
  !h[2] = 'Font ID'
  !h[3] = 'Description'
  !this.fonts.setHeadings(!h)
  !this.sortBy.val = 1
  !this.sortBy.callback = '!this.cbSort(true)'
  !this.fontAtt = 'FONT'
endmethod
-- End of method definition for .draTTFontSel()

------------------------------------------------------------------------
--
-- Method:      cbSort
--
-- Description: Callback for the Sort by radio group
--
-- Method Type: Procedure
-- Arguments:
--   1  R  BOOLEAN  True, if the current selection is to be restored
-- Return:
--
------------------------------------------------------------------------
define method .cbSort(!restoreSelection is BOOLEAN)
  if( !restoreSelection ) then
    !sel = !this.fonts.selection()
  endif
  !sortBy = !this.sortBy.val
  if( !sortBy.eq(1) ) then
    !by = 4
  elseif( !sortBy.eq(2) ) then
    !by = 2
  elseif( !sortBy.eq(3) ) then
    !by = 1
  else
    !by = 3
  endif
  !!fontManager.sort(!by)
  !dText = ARRAY()
  !rText = ARRAY()
  !!fontManager.addSpecialFontValues(!this.fontAtt, !dText, !rText)
  !!fontManager.makeListArrays(!dText, !rText, 1, true)
  !this.fonts.dText = !dText
  !this.fonts.rText = !rText
  if( !restoreSelection ) then
    !this.fonts.select('rText', !sel)
  endif
endmethod
-- End of method definition for .cbSort()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation method
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  if( !!cdfontform.substring(1,1).eq('_') ) then
    !baseName = !!cdfontform.substring(2)
  elseif( !!cdfontform.substring(1,2).eq('!!') ) then
    !baseName = !!cdfontform.substring(3)
  else
    !baseName = !!cdfontform
  endif
  !this.fontGadget = !!$!baseName$n.font
  !font = $!this.fontAtt
  handle ANY
    !this.fontGadget.val = 1
    !font = !this.fontGadget.selection()
  endhandle
  !!fontManager.loadFontInfo()
  !this.cbSort(false)
  !effectiveID = -1
  !bold = false
  !italic = false
  !fType = -999
  !fontNum = !font.real()
  handle (2,441) $* Calculator error
    !this.fonts.select('dText', !font.upCase())
    handle ANY
    endhandle
  elsehandle None
    !!fontManager.fontType(!fontNum, !effectiveID, !bold, !italic, !fType)
    if( !fType.eq(2) ) then
      !this.fonts.select('rText', !effectiveID.string())
      handle ANY
      elsehandle None
        !this.bold.val = !bold
        !this.italic.val = !italic
      endhandle
    else
      !this.fonts.val = 1
      !this.bold.val = false
      !this.italic.val = false
    endif
  endhandle
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: Callback for the OK button
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .ok()
  !fontIDStr = !this.fonts.selection().lowCase()
  !font = !fontIDStr.real()
  handle (2,441) $* Calculator error
    -- A special font value - should be already in the list!
  elsehandle None $* numerical font
    !rText = !this.fontGadget.rText
    !dText = !this.fontGadget.dText
    !add = 0
    if( !this.bold.val ) then
      !add = 1000
    endif
    if( !this.italic.val ) then
      !add = !add + 2000
    endif
    !font = !font + !add
    !fontName = !!fontManager.fontName(!font, TRUE)
    !fontIDStr = !font.string()
    !unusedFirst = !rText[1].real()
    handle ANY
      -- Not a number, must be Default, Template or Unchanged
      !dText.insert(1, !fontName)
      !rText.insert(1, !fontIDStr)
    elsehandle None
      -- a numerical font ID
      !dText[1] = !fontName
      !rText[1] = !fontIDStr
    endhandle
    !this.fontGadget.dText = !dText
    !this.fontGadget.rText = !rText
  endhandle
  !this.fontGadget.select('rText', !fontIDStr)
  handle ANY
  endhandle
endmethod
-- End of method definition for .ok()
