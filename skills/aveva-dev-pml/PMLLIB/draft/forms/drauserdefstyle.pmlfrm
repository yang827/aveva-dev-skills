--
-- File:            drauserdefstyle.pmlfrm
--   Type:          Form Definition
--   Group:         common
--     Keyword:     styles
--   Module:        DRAFT
--
-- Author:          T.Lisowski
--  Created:         Tue May 29 10:27:50 2007
--
-- Description:
-- The form presents the user defined styles for the user to choose
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbCancel()                       -
--  cbOK()                           -
--  close()                          -                   Close the form
--  draUserDefStyle()                -
--  getStyleTables(STRING)           -                   Get the style tables and build grid array
--  init()                           -
--  selectStyle(STRING,REAL)         -                   Select the used style when user-defined
--  styAfterSelectChange(ARRAY)      -                   Callback on grid control after select change of the style grid
--  tabAfterSelectChange(ARRAY)      -                   Callback on grid control after select change of the library grid
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!draUserDefStyle

  -- Form members
  !this.callback  = '!this.init()'
  !this.quitCall  = '!this.close()'

  -- Style Tables grid
  para      .tabTxt at x2 ymin text 'Style Table' width 8
  container .tabGrid nobox pmlNetControl 'NET' at x0 ymax-0.25 width 30 height 10


  -- Styles grid
  para      .styTxt at xmax+2 ymin.tabTxt text 'Style' width 4
  container .styGrid nobox pmlNetControl 'NET' at xmax.tabGrid+0.5 ymin.tabGrid width 60 height 10

  button .ok |Select| at xmin.tabGrid ymax+0.3 width 8

  button .cancel |Dismiss| at xmax.styGrid-size  width 8

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .tabControl  is NETGRIDCONTROL
  member .styControl  is NETGRIDCONTROL

  member .parent      is FORM
  member .kind        is STRING
  member .family      is STRING
  member .initial     is STRING

  -- The selected library and style
  member .tabIndex    is REAL
  member .styIndex    is REAL
  member .styDesc     is STRING

  -- Grid headings
  member .tabHeadings is ARRAY
  member .styHeadings is ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .draUserDefStyle()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draUserDefStyle()

  -- Callbacks
  !this.ok.callback     = '!this.cbOK()'
  !this.cancel.callback = '!this.cbCancel()'

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.tabControl = object NETGRIDCONTROL()
  !this.styControl = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.tabGrid.control = !this.tabControl.handle()
  !this.styGrid.control  = !this.styControl.handle()

  -- Add PML event handlers to .net controls
  !this.tabControl.addEventHandler('afterSelectChange', !this, 'tabAfterSelectChange')
  !this.styControl.addEventHandler('afterSelectChange', !this, 'styAfterSelectChange')

  -- Set grid visual attributes
  !this.tabControl.columnExcelFilter(false)
  !this.tabControl.outlookGroupStyle(false)
  !this.tabControl.fixedRows(false)
  !this.tabControl.gridHeight(1000.0)
  !this.tabControl.editableGrid(false)
  !this.tabControl.singleRowSelection(true)
  !this.tabControl.columnExcelFilter(false)
  !this.tabControl.fixedHeaders(false)
  !this.tabControl.headerSort(true)
  !this.tabControl.columnSummaries(false)
  !this.styControl.columnExcelFilter(false)
  !this.styControl.outlookGroupStyle(false)
  !this.styControl.fixedRows(false)
  !this.styControl.gridHeight(1000.0)
  !this.styControl.editableGrid(false)
  !this.styControl.singleRowSelection(true)
  !this.styControl.columnExcelFilter(false)
  !this.styControl.fixedHeaders(false)
  !this.styControl.headerSort(true)
  !this.styControl.columnSummaries(false)

  -- Set grid control headings
  !this.tabHeadings.append('Name')
  !this.tabHeadings.append('Description ')
  !this.styHeadings.append('Name')
  !this.styHeadings.append('Description')
  !this.styHeadings.append('Style Number')

  -- Initialise variables
  !this.kind = ''
  !this.initial = ''

endmethod
-- End of method definition for .draUserDefStyle()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation method
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
	
	-- Set form title
  !this.family    = !!draColStyle.styleFamily(!this.kind)
  !kind      = !!draColStyle.familyDescription(!this.family).lowCase()
  !this.formTitle = 'User-defined ' & !kind & ' styles'
  !prefix         = !this.family.lowCase()

  -- Get the currently selected style
  !currStyleRef = !!draColStyle.$!prefix$nStyRef

  -- Get all available style tables
  !this.getStyleTables(!prefix)

  -- Select the use-defined style if used
  if (!currStyleRef.badref()) then

    -- Make the select button inactive
	  !this.ok.active = false

  else
  	  	
    -- Select the style
    !this.selectStyle('INIT', !currStyleRef.$!prefix$nStyNo)

    -- Make the select button active
    !this.ok.active = true

	endif
	
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cbCancel
--
-- Description: Callback for the Cancel button
--
-- Method Type: Procedure
-- Arguments:
--   1  R  GADGET  The button, that has been clicked
--   2  R  STRING  The action string
-- Return:
--
------------------------------------------------------------------------
define method .cbCancel()
	
  !!draColStyle.cbStyleToggleReturn(!this.parent, !this.kind, '')

  !this.close()

endmethod
-- End of method definition for .cbCancel()

------------------------------------------------------------------------
--
-- Method:      cbOK
--
-- Description: Callback for the OK button
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .cbOK()
	
  -- Pass the selected style to the global object
  !!draColStyle.cbStyleToggleReturn(!this.parent, !this.kind, !this.styDesc)

  -- Pass the index of the selected library and style to the global object
  -- These will be used to get the selected style dbref
  !!draColStyle.cbStyleSetDbref(!this.kind, !this.tabIndex, !this.styIndex)

  -- Done
  !this.close()

endmethod
-- End of method definition for .cbOK()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .getStyleTables(STRING)
--
-- Description: Get the style tables and build grid array
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Family code in lowercase 'l' or 'f'
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getStyleTables(!family is STRING)
	
	-- Initialise variables
	!rowSet = ARRAY()
	
	-- Get the style tables from the global object and build the grid array
	do !tableStrg val !!draColStyle.$!family$nStyTB

    -- Initialise variables
	  !row       = ARRAY()
		!tableRef  = !tableStrg.dbref()
				
		-- Build the row data
		!row.append(!tableStrg)
		!row.append(!tableRef.func)
		
		-- Add the row data to the row set array
	  !rowSet.append(!row)
	
	enddo
	
	-- Populate the table grid
	using namespace 'Aveva.Pdms.Presentation'
  !this.tabControl.bindToDataSource(object NETDATASOURCE('Name', !this.tabHeadings, !rowSet, '^Name'))

endmethod
-- End of method definition for .getStyleTables(STRING)

------------------------------------------------------------------------
--
-- Method:      .selectStyle(STRING,REAL)
--
-- Description: Select the used style when user-defined
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      On initialisation INIT or when table selected 'SELECT'
--    2   R      REAL        The currently used style number
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectStyle(!type is STRING, !styleNo is REAL)
	
	-- Initialise variables
	!kind     = !this.kind
	!prefix   = !this.family.lowcase()
	!selected = -1
	
	-- Test each style table for the selected style
	if (!type.eq('INIT')) then
		
	  do !index ind !!draColStyle.$!prefix$nStyleNos
		
	    !selected = !!draColStyle.$!prefix$nStyleNos[!index].findFirst(!styleNo.string())	
	
	    if (!selected.set()) then

        -- Select the relevant table
        !this.tabControl.selectRow(!index)

        -- Select the relevant style
        !this.styControl.selectRow(!selected)

        -- Done
	  	  break
	  	
	    endif
	
	  enddo
	
	 else
	 	
	 	 -- Test for a selected table row
	 	 if (defined(!this.tabControl.getSelectedRowTags()[1])) then
	 	
	 	   -- Attempt to find the current style in the displayed style list
	     !selected = !!draColStyle.$!prefix$nStyleNos[!this.tabControl.getSelectedRowTags()[1].real()].findFirst(!styleNo.string())	
	
	     -- If the style is displayed then select it
	     if (!selected.set()) then

         -- Select the relevant style
         !this.styControl.selectRow(!selected)
	  	
	     endif
	
	   endif
	
	 endif
	
endmethod
-- End of method definition for .selectStyle(STRING,EAL)

------------------------------------------------------------------------
--
-- Method:      .styAfterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the style grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .styAfterSelectChange(!selected is ARRAY)
	
	-- Test for a selected style table when auto callback on initialisation
	if (defined(!this.tabControl.getSelectedRowTags()[1])) then

    -- Get the family in lowercase either 'l' or 'f'
    !prefix = !this.family.lowCase()

    -- Get selected table
    !selectedTable = !this.tabControl.getSelectedRowTags()[1]

    if (defined(!selectedTable) and defined(!selected[0][1])) then
  	
      -- Get the selected table and style indices
      !tabIndex      = !selectedTable.real()
      !styIndex      = !selected[0][1].real()

      -- Store the indices for use once the form is selected
      !this.tabIndex = !tabIndex
      !this.styIndex = !styIndex

      -- Obtain the necessary description string from the global variable
      !this.styDesc = !!draColStyle.$!prefix$nStyle[$!tabIndex][$!styIndex]

    endif

    -- Make the select button active
    !this.ok.active = true

	endif

endmethod
-- End of method definition for .styAfterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .tabAfterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the library grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tabAfterSelectChange(!selected is ARRAY)

  !prefix = !this.family.lowCase()
  !rowSet = ARRAY()

  -- Build the row data for each style in the selected style table
  do !styleRefe val !!draColStyle.$!prefix$nStyleRefs[!selected[0][1].real()]
  	
  	!row = ARRAY()
	
  	-- Extract style name, description and style number
  	!row.append(!styleRefe.flnm)
  	!row.append(!styleRefe.func)
  	!row.append(!styleRefe.$!prefix$nStyno)
  	
  	!rowSet.append(!row)
  	
  enddo

 	-- Populate the table grid
	using namespace 'Aveva.Pdms.Presentation'
  !this.styControl.bindToDataSource(object NETDATASOURCE('Name', !this.styHeadings, !rowSet, '^Name'))

  -- Get the currently selected style
  !currStyleRef = !!draColStyle.$!prefix$nStyRef

  -- Select the style
  if (!currStyleRef.badref().not()) then
    !this.selectStyle('SELECT', !currStyleRef.$!prefix$nStyNo)
  endif

endmethod
-- End of method definition for .tabAfterSelectChange(ARRAY)
