--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:16:33 1997
--
--
-- Description:
-- form to allow user to change dxf advanced config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autocadTwelve(BOOLEAN)           -                   If( !this.autocadR12 is ON, then:
--  cancel()                         -                   Removes form from Owner's Children array
--  dxfAdvSet()                      -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  ignoreOODerr()                   -                   Warning about effect of ignore OOD switch
--  init()                           -
--  minimiseSize()                   -                   Warning about disabled settings
--  ok()                             -
--  setOwnerObject(DXFOUT)           -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfAdvSet

-- Define form
setup form !!dxfAdvSet

  !!dxfAdvSet.formTitle     = 'DXF - Advanced'
  !!dxfAdvSet.iconTitle     = 'Advanced'
  !!dxfAdvSet.callback      = '!!dxfAdvSet.init()'
  !!dxfAdvSet.formRevision  = ' $Revision: 1.7 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .advanced 'Advanced settings: ' width 30
    toggle .entityAcDb      ' Entity AcDb Markers    '  states 'OFF' 'ON'
    toggle .headerEntities  ' Header Entities        '  states 'OFF' 'ON'
    toggle .autocadR12      ' AutoCAD R12 compatible '  states 'OFF' 'ON'
    toggle .minDxfSize      ' Minimise DXF File size '  states 'OFF' 'ON'
    toggle .ignOODerr       ' Continue if Design Graphics out of date '  states 'OFF' 'ON'
  exit

  button .ok      ' OK '     at x0 ymax+0.5    OK
  button .cancel  'Cancel'   at xmax Form-size  ymin CANCEL

exit
-- End of form definition for !!dxfAdvSet

------------------------------------------------------------------------
--
-- Method:      !dxfAdvSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfAdvSet()

  -- define callbacks
  !this.autocadR12.callback = '!!dxfAdvSet.autocadTwelve(TRUE)'
  !this.minDxfSize.callback = '!!dxfAdvSet.minimiseSize()'
  !this.ignOODerr.callback  = '!!dxfAdvSet.ignoreOODerr()'
  !this.ok.callback         = '!!dxfAdvSet.ok()'
  !this.cancel.callback     = '!!dxfAdvSet.cancel()'

endmethod
-- End of method definition for .dxfAdvSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  !this.minDxfSize.val     = FALSE
  !this.autocadR12.val     = !configData.graphicsOnlyDxf()
  !this.entityAcDb.val     = !configData.entityAcDbMarker()
  !this.headerEntities.val = !configData.includeDxfHeader()
  if (!configData.ignoreOODerrs().unset()) then
    !this.ignOODerr.val      = false
  else
    !this.ignOODerr.val      = !configData.ignoreOODerrs()
  endif

  -- Sort out related switches
  !this.autocadTwelve(FALSE)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    -- Apply settings to DXF Object
    !configData.entityAcDbMarker( !this.entityAcDb.val )
    !configData.includeDxfHeader( !this.headerEntities.val )

    if( !this.minDxfSize.val or !this.autocadR12.val) then
      !configData.groupDims( FALSE )
      !configData.groupNote( FALSE )
      !configData.groupVnot( FALSE )
      !configData.groupFrame( FALSE )
      !configData.groupGlab( FALSE )
      !configData.groupSlab( FALSE )
      !configData.groupBlocks( FALSE )
    endif

    if( !this.minDxfSize.val ) then
      -- Switch off - LineTypeMapping, ColourMapping, IncludeZcoordinates
      --            - ALL Group Switches; FontFilePath
      --            - ALL Block Switches ??
      -- Access to these settings is NOT de-activated
      !configData.fontFilePath( 'OFF' )
      !configData.lineTypeMapping( FALSE )
      !configData.colourMapping( FALSE )
      !configData.includeZCoord( FALSE )

      -- *** Do we want this ***
      -- !configData.ignoreBlockRules( TRUE )
      -- !configData.blockBack( FALSE )
      -- !configData.blockOlay( FALSE )
      -- !configData.blockSymb( FALSE )
      -- !configData.blockGraphicFile( FALSE )
    endif

   !configData.ignoreOODerrs( !this.ignOODerr.val )
    -- De-activate 'Grouping..' button on Parent form and hide Grouping Form
    if( !this.autocadR12.val ) then
      !configData.graphicsOnlyDxf( TRUE )
      !configData.userGrouping( FALSE )
      -- HeaderEntities and EntityAcDbMarkers already Switched off & de-activated
    else
      !configData.graphicsOnlyDxf( FALSE )
      !configData.userGrouping( TRUE )
    endif

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Update display on Owner and any shown forms
  -- This also de-activates Grouping form/button if appropriate
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.setFontPath()
    !this.main.childFormAccess()
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      minimiseSize
--
-- Description:  Warning about disabled settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .minimiseSize()

  if( !this.minDxfSize.val ) then
    -- WARNING - this option disables group switches, linetype and colour
    --           mapping, and switches off Z coords and Fontfile pathnames
    !!messageFile.warning( 144, 512 )
  endif

endmethod
-- End of method definition for .minimiseSize()

------------------------------------------------------------------------
--
-- Method:      ignoreOODerr
--
-- Description:  issue warning about effect of ignoreOODerr switch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ignoreOODerr()

  if( !this.ignOODerr.val ) then
    -- WARNING - This option will allow the creation of incomplete .dxf drawings
    !!messageFile.warning( 144, 514 )
  endif

endmethod
-- End of method definition for .ignoreOODerr()

------------------------------------------------------------------------
--
-- Method:      autocadTwelve
--
-- Description:  If( !this.autocadR12 is ON, then:
--               -- Grouping... button is de-activated
--               -- 'EntityAcDb'     is switched OFF and de-activated
--               -- 'HeaderEntities' is switched OFF and de-activated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .autocadTwelve(!warning is BOOLEAN)

  if( !this.autocadR12.val eq TRUE ) then
    !this.headerEntities.val    = FALSE
    !this.headerEntities.active = FALSE
    !this.entityAcDb.val        = FALSE
    !this.entityAcDb.active     = FALSE

    if( !warning ) then
      -- WARNING - this option disables group switches and group settings form
      !!messageFile.warning( 144, 513 )
    endif
  else
    !this.headerEntities.active = TRUE
    !this.entityAcDb.active     = TRUE
  endif

endmethod
-- End of method definition for .autocadTwelve(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      return !this.main.getDxfObject()
  else
      return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DXFOUT )
