-- Created:         Fri Jul 11 10:17:12 1997
--
--
-- Description:
-- form to allow the administrator to change dxf config settings and to save to file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  as()                             -                   Save As specified file name
--  checkHeader()                    -                   Check Header Filename
--  checkSaved()                     -                   Check that changes have been saved and save if necessary
--  childFormAccess()                -                   Controls access to  Child forms
--  close()                          -                   Close form
--  dxfASet()                        -                   Constructor
--  fontPath()                       -                   FontPath callback - Disable FontFilePath gadget if toggle OFF
--  from()                           -
--  getDxfObject()                   DXFOUT              Returns DXFOUT object
--  init()                           -
--  load(FILE)                       -                   Load from given file
--  save(FILE)                       -                   Save given settings to a file
--  setDxfObject(DXFOUT)             -
--  setFile(FILE)                    -                   Set Filename
--  setFontPath()                    -                   Set Font path gadgets from FontPath settings
--  setLocalGadgets()                -                   Initialises Gadgets on Form
--  setModified()                    -                   Set Modified flag
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfASet

-- Define form
setup form !!dxfASet
Import 'pmlfilebrowser'
handle any
endhandle

  !!dxfASet.formTitle     = 'DXF Configuration settings - Administrator'
  !!dxfASet.iconTitle     = 'Administrator'
  !!dxfASet.callback      = '!!dxfASet.init()'
  !!dxfASet.formRevision  = ' $Revision: 1.10 $ '

  -- Modified flag
  member .modified is BOOLEAN

  -- local form Configdata store
  member .data is DXFOUT

  member .children is ARRAY

  -- Body of form definition

  bar
  exit

  path down

  text   .description   'Description' tagwidth 9 width 32 string

  para .dirP  at x1 text 'Directory :' width 7
  para .fileP at x4.4 text 'File :' width 4

  para .directory at x9 ymin.dirP width 35 lines 1
  para .file  width 35 lines 1

  toggle .fontPath  'Font File Path' at x0 ymax+0.5  states 'FALSE' 'TRUE'
  path right
  text   .fontFilePath '' at x12 width 28 string

  text   .headerFileName  at x0 ymax+0.2 'Header File Name' tagwidth 12 width 28 string

  path down
  frame .settings ' Settings ' at x6 ymax+0.2 width 30


    button .general  ' General...  '
    button .mapping  ' Mapping...  '
    button .layer    ' Layering... '
    button .group    ' Grouping... '
    button .block    ' Blocking... '
    button .advanced ' Advanced... '

    para   .userAccess at xmax_general+3 ymin_general-1 text ' User Access ' width 9
    toggle .userGeneral  '' at xmax_general+7 ymin_general
    toggle .userMapping  '' at ymin_mapping
    toggle .userLayering '' at ymin_layer
    toggle .userGrouping '' at ymin_group
    toggle .userBlocking '' at ymin_block
    toggle .userAdvanced '' at ymin_advanced
  exit

exit

-- End of form definition for !!dxfASet
------------------------------------------------------------------------
--
-- Method:      !dxfASet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfASet()

  -- build menu bar
  !this.bar.add( 'Control', 'ControlMenu' )
  !this.bar.add( 'File', 'FileMenu' )

  !this.newMenu('ControlMenu')
  !this.controlMenu.add('callback', 'Close', |!!dxfASet.close()| )

  !this.newMenu('FileMenu')
  !this.fileMenu.add('callback', 'Save', |!!dxfASet.save( !!file( $
            !!dxfASet.directory.val + '/' + !!dxfASet.file.val + '.pmldat') )| )
  !this.fileMenu.add('callback', 'Save As...',  '!!dxfASet.as()')
  !this.fileMenu.add('separator')
  !this.fileMenu.add('callback', 'Load', |!!dxfASet.load( !!file( $
            !!dxfASet.directory.val + '/' + !!dxfASet.file.val + '.pmldat') )| )
  !this.fileMenu.add('callback', 'Load from...', '!!dxfASet.from()' )

  -- define callbacks
  !this.headerFileName.callback   = '!!dxfASet.checkHeader()'  $* Validate name
  !this.fontPath.callback     = '!!dxfASet.fontPath()'
  !this.description.callback  = '!!dxfASet.setModified()'
  !this.fontFilePath.callback = '!!dxfASet.setModified()'

  !this.general.callback      = |show !!dxfGSet|
  !this.mapping.callback      = |show !!dxfMSet|
  !this.group.callback        = |Show !!dxfGrSet|
  !this.block.callback        = |Show !!dxfBSet|
  !this.layer.callback        = |Show !!dxfLSet|
  !this.advanced.callback     = |Show !!dxfAdvSet|
  -- !this.access.callback       = |Show !!dxfAccSet|

endmethod
-- End of method definition for .dxfASet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !!dxfUSet.hide()
  handle (2,751)
  -- Form not defined
  endhandle

  !this.modified = FALSE

  -- Initialise Config.file gadgets
  !fileObject = !!file('%PDMSUSER%/dra-dxf-myconfig.pmldat')

  if( !fileObject.exists() ) then
    !this.load( !fileObject )

  else
    -- File does not exist - Initialise settings
    !this.setFile( !fileObject )

    !this.data.default()
    !this.description.val = |Configuration settings|

    -- Allow all settings to be modifiable
    !this.data.userGeneral( TRUE )
    !this.data.userMapping( TRUE )
    !this.data.userGrouping( TRUE )
    !this.data.userLayering( TRUE )
    !this.data.userBlocking( TRUE )
    !this.data.userAdvanced( TRUE )

    !this.setLocalGadgets()
  endif

  !this.fontFilePath.val = !this.data.fontFilePath()
  !this.setFontPath()

  !this.userGeneral.val  = !this.data.userGeneral()
  !this.userMapping.val  = !this.data.userMapping()
  !this.userGrouping.val = !this.data.userGrouping()
  !this.userLayering.val = !this.data.userLayering()
  !this.userBlocking.val = !this.data.userBlocking()
  !this.userAdvanced.val = !this.data.userAdvanced()

  if( !this.data.graphicsOnlyDxf() ) then
    !this.group.active        = FALSE
    !this.userGrouping.active = FALSE
  endif

  -- Access to Child forms
  -- Update data on Shown Child forms
  !this.children = ARRAY()

  !this.modified = FALSE

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  !this.checkSaved()
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      setModified
--
-- Description:  Set Modified flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setModified()

  !this.modified = TRUE

endmethod
-- End of method definition for .setModified()

------------------------------------------------------------------------
--
-- Method:      setFontPath
--
-- Description:  Set Font path gadgets from FontPath settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setFontPath()

  !string = !this.data.fontFilePath()

  if( !string eq 'OFF' ) then
    !this.fontPath.val = FALSE
    !this.fontFilePath.active = FALSE
    -- Don't overwrite existing FontFilePath gadget text
  else
    !this.fontPath.val = TRUE
    !this.fontFilePath.active = TRUE
    !this.fontFilePath.val = !string
  endif

  -- !this.modified = TRUE

endmethod
-- End of method definition for .setFontPath()

------------------------------------------------------------------------
--
-- Method:      fontPath
--
-- Description:  FontPath callback - Disable FontFilePath gadget if toggle OFF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .fontPath()

  if( !this.fontPath.val eq FALSE ) then
    !this.fontPath.val = FALSE
    !this.fontFilePath.active = FALSE
  else
    if( !this.fontFilePath.val eq 'OFF' ) then
      -- Re-initialise FontFilePath
      !this.fontFilePath.val = !this.data.fontFilePath()
      if( !this.fontFilePath.val eq 'OFF' ) then
        !this.fontFilePath.val = '%PDMSEXE%/autodraftfonts'
      endif
    endif
    !this.fontFilePath.active = TRUE
    !this.fontPath.val = TRUE
  endif

  !this.modified = TRUE

endmethod
-- End of method definition for .fontPath()

------------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load from given file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .load(!fileObject is FILE)

  -- Verify that changes have been saved if required
  !this.checkSaved()

  !this.setFile( !fileObject )

  !this.data.load( !fileObject )

  !this.setFontPath()
  !this.setLocalGadgets()

  !this.childFormAccess()

  -- Ensure Modified flag unset
  !this.modified = FALSE

endmethod
-- End of method definition for .load(FILE)
-------------------------------------------------------------------
--
-- Method:      from
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .from()

  -- Verify that changes have been saved if required
  !this.checkSaved()

 !filename =  !this.file.val + '.pmldat'

 call !!fileBrowser( !this.directory.val, !filename,  $
                     'Load Config Settings', true,    $
                     '!!dxfASet.load(!!fileBrowser.file) ' )

endmethod
-- End of method definition for .from()

------------------------------------------------------------------------
--
-- Method:      checkSaved
-- Description: Check that changes have been saved and save if necessary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkSaved()

  if( !this.modified ) then
    !string = !!messageFile.messageString( 144, 509 )
    !answer = !!alert.confirm( !string )
    if( !answer.boolean() ) then
      -- Save Data to File
      !fileObject = !!file( !this.directory.val + '/' + $
                            !this.file.val + '.pmldat' )
      !this.save( !fileObject )
    endif
  endif

endmethod
-- End of method definition for .checkSaved()

------------------------------------------------------------------------
--
-- Method:      save
-- Description: Save given settings to a file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE      File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .save(!fileObject is FILE)

  !this.setFile( !fileObject )

  -- Add data from Form
  !this.data.name( !this.file.val )

  !session = CURRENT SESSION
  !this.data.createdBy( !session.name )
  -- *** COMMAND-LINE SYNTAX
  var !date CLOCK DATE
  !this.data.createdDate( !date )

  !this.data.description( !this.description.val )
  !this.data.headerFileName( !this.headerFileName.val )
  if( !this.fontPath.val ) then
    !this.data.fontFilePath('OFF')
  else
    !this.data.fontFilePath( !this.fontFilePath.val )
  endif

  !this.data.function( 'General Configuration' )

  !this.data.userGeneral( !this.userGeneral.val )
  !this.data.userMapping( !this.userMapping.val )
  !this.data.userLayering( !this.userLayering.val )
  !this.data.userGrouping( !this.userGrouping.val )
  !this.data.userBlocking( !this.userBlocking.val )
  !this.data.userAdvanced( !this.userAdvanced.val )

  !this.data.save( !fileObject )

  -- Unset Modified flag
  !this.modified = FALSE

endmethod
-- End of method definition for .save(FILE)

------------------------------------------------------------------------
--
-- Method:      as
--
-- Description: Save As specified file name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .as()

 Using Namespace 'Aveva.Pdms.Presentation'
 !browser = object PMLFILEBROWSER('save')
 !filename = !this.file.val + '.pmldat'

 !browser.show(!this.directory.val, !filename, 'Save Config Settings', false, 'PMLDAT Files (*.pmldat)|*.pmldat', 1)
 !file = !!file(!browser.file())
 if(!file.set()) then
     !this.save(!file)
 endif

endmethod
-- End of method definition for .as()

------------------------------------------------------------------------
--
-- Method:      setFile
--
-- Description: Set Filename
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE      File
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setFile(!fileObject is FILE)

  !entry = !fileObject.entry()
  !path  = !fileObject.pathName()

  !this.directory.val   = !path

  !string = !entry.before( '.pmldat' )
  if( !string.length() gt 0 ) then
    !this.file.val = !string
  else
    !this.file.val = !entry
  endif

  -- !this.checkFile()
  !filename = !this.file.val
  if( !filename.match( 'dra-dxf-' ) ne 1 ) then
    -- Warning 'Filename should start with dra-dxf-' )
    !!messageFile.warning( 144, 503 )
  endif

endmethod
-- End of method definition for .setFile(FILE)

------------------------------------------------------------------------
--
-- Method:      checkHeader
--
-- Description: Check Header Filename
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkHeader()

  !filename = !this.headerFileName.val
  if( !filename.match('.dxf') ne (!filename.length() - 3) ) then
    -- Warning 'Header FileName does not end in .dxf'
    !!messageFile.warning( 144, 504 )
  endif

  !fileObject = !!file( !filename )
  if( not !fileObject.exists() ) then
    -- Error 'File does not exist'
    !!messageFile.error( 146, 9, !fileObject.fullName() )
    return error
  endif

  !this.modified = TRUE

endmethod
-- End of method definition for .checkHeader()
------------------------------------------------------------------------
--
-- Method:      setLocalGadgets
--
-- Description: Initialises Gadgets on Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLocalGadgets()

  !this.headerFileName.val = !this.data.headerFileName()
  -- !this.outputFileName.val = !this.data.outputFileName()

  !this.description.val = !this.data.description()

  !this.userGeneral.val  = !this.data.userGeneral()
  !this.userMapping.val  = !this.data.userMapping()
  !this.userGrouping.val = !this.data.userGrouping()
  !this.userLayering.val = !this.data.userLayering()
  !this.userBlocking.val = !this.data.userBlocking()
  !this.userAdvanced.val = !this.data.userAdvanced()

  -- !this.modified = TRUE
endmethod
-- End of method definition for .setLocalGadgets()

------------------------------------------------------------------------
--
-- Method:      getDxfObject
--
-- Description: Returns DXFOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDxfObject() is DXFOUT
  return !this.data

endmethod
-- End of method definition for .getDxfObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setDxfObject
--
-- Description: Sets DXFOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDxfObject( !dxfObject is DXFOUT )

  !this.data = !dxfObject

  -- Form data has been modified
  !this.modified = TRUE

endmethod
-- End of method definition for .setDxfObject( DXFOUT )

------------------------------------------------------------------------
--
-- Method:      childFormAccess
--
-- Description:  Controls access to  Child forms
--               Initialise child-forms by passing in DXF object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .childFormAccess()

  -- Update Active status for Grouping gadgets - not available if R12 compatible
  !graphicsOnly = !this.data.graphicsOnlyDxf()
  !this.group.active        = !graphicsOnly.not()
  !this.userGrouping.active = !graphicsOnly.not()
  if( !graphicsOnly ) then
    !this.userGrouping.val = FALSE
  endif

  -- Other child forms are always accessible to the administrator

  -- Hide shown Child forms which are now longer accessible
  -- Re-initialise any forms which are still shown
  do !form values !this.children
    if( !form.shown() ) then
      !showFlag = TRUE

      -- Check that Administrator still has access to this form
      if( !form.name() eq 'DXFGRSET' ) then
        !showFlag = !this.group.active

        -- Hide form if not accessible
        if( not !showFlag ) then
          !form.hide()
          -- Remove form from array
          !index = !this.children.findFirst( !form )
          !this.children.deleteFrom( !index, 1 )
        endif
      endif

      if( !showFlag ) then
        -- Re-initialise Child form
        !form.init()
      endif

    else
        -- Hidden form - Remove form from array
        !index = !this.children.findFirst( !form )
        !this.children.deleteFrom( !index, 1 )
    endif
  enddo
  !this.children.compress()

endmethod
-- End of method definition for .childFormAccess()
