--
--
-- Description:
-- form to allow user to change dxf block config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  checkRule(STRING)                -                   Validate Block,With,Include syntax (element types)
--  constructRule()                  STRING              Construct Rule text from Block,With,Include gadget text
--  copy()                           -                   Copy rule from Rules list gadget,
--  copyRule()                       -                   Update Block, With and Include gadgets with current selection
--  cut()                            -                   Cut rule from Rules list gadget,
--  dxfBSet()                        -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  ignoreRules()                    -                   Disable/Enable BlockRule gadgets
--  init()                           -
--  insert()                         -                   Insert rule in Rules gadget,
--  ok()                             -
--  replace()                        -                   Replace rule in Rules gadget,
--  setOwnerObject(DXFOUT)           -
--
------------------------------------------------------------------------
--

-- Kill existing form definition
kill !!dxfBSet

-- Define form
setup form !!dxfBSet

  !!dxfBSet.formTitle     = 'DXF - Blocking'
  !!dxfBSet.iconTitle     = 'Blocking'
  !!dxfBSet.callback      = '!!dxfBSet.init()'
  !!dxfBSet.formRevision  = ' $Revision: 1.10 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .anno '2d Elements' width 25 height 4
    toggle .blockBack 'Backs   '     states 'OFF' 'ON'
    toggle .blockOlay 'Overlays'     states 'OFF' 'ON'
    toggle .blockGraphicFile   'Graphics files'     states 'OFF' 'ON'
    toggle .blockFill  'Hatch/Fill'  at xmax ymin_blockBack states 'OFF' 'ON'
    toggle .blockSymb  'Symbols'     states 'OFF' 'ON'
  exit

  frame .desi 'Design Graphics Blocks' at xmax_anno + 1 y0 width 25 height 4
    rgroup .designGraphics  VERTICAL
      add tag 'Grouped'     select 'Grouped'
      add tag 'Nested'      select 'Nested'
      add tag 'Independent' select 'Independent'
    exit
  exit

  frame .blockRules 'Block Rules' at x0 ymax+0.5 width 52
    path down
    toggle .ignoreBlockRules 'Ignore Block Rules' states 'OFF' 'ON'
    frame .bwi ''
      text   .block   'Block   ' width 44 string
      text   .with    'With    ' width 44 string
      text   .include 'Include ' width 44 string
    exit

    -- frame .Edit ''
      button .cut     ' Cut  '
      path right
      hdist 2
      button .copy    ' Copy '
      button .replace 'Replace'
      button .insert  'Insert'
      hdist 0
      option .insertOpt width 6
    -- exit

    path down
    frame .fRules '' at x1 ymax
      list   .rules  width 52 length 6
    exit
  exit

  button .ok      ' OK '   at x0 ymax+0.5 OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfBSet

------------------------------------------------------------------------
--
-- Method:      !dxfBSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfBSet()

  -- Define Rgroup/Option/List data
  !options = ARRAY()
  !options[1] = 'After'
  !options[2] = 'Before'
  !this.insertOpt.dText = !options

  -- define callbacks
  !this.cut.callback              = '!!dxfBSet.cut()'
  !this.copy.callback             = '!!dxfBSet.copy()'
  !this.replace.callback          = '!!dxfBSet.replace()'
  !this.insert.callback           = '!!dxfBSet.insert()'
  !this.ignoreBlockRules.callback = '!!dxfBSet.ignoreRules()'
  !this.block.callback            = '!!dxfBSet.checkRule(|Block|)'
  !this.with.callback             = '!!dxfBSet.checkRule(|With|)'
  !this.include.callback          = '!!dxfBSet.checkRule(|Include|)'
  !this.ok.callback               = '!!dxfBSet.ok()'
  !this.cancel.callback           = '!!dxfBSet.cancel()'

endmethod
-- End of method definition for .dxfBSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  -- Annotation Blocking
  !this.blockBack.val        = !configData.blockBack()
  !this.blockOlay.val        = !configData.blockOlay()
  !this.blockSymb.val        = !configData.blockSymb()
  !this.blockFill.val        = !configData.blockFill()
  !this.blockGraphicFile.val = !configData.blockGraphicFile()

  -- Design graphics Blocking
  if( !configData.groupBlocks() ) then
    !this.designGraphics.select( 'Grouped' )
  elseif( !configData.nestedBlocks() ) then
    !this.designGraphics.select( 'Nested' )
  else
    !this.designGraphics.select( 'Independent' )
  endif

  -- Design Blocking Rules
  !this.ignoreBlockRules.val = !configData.ignoreBlockRules()
  if( !this.ignoreBlockRules.val ) then
    -- Disable BlockRule gadgets
    !this.ignoreRules()
  endif

  -- Need to populate Rules list
  !dText = ARRAY()
  do !rule values !configData.blockRules()
    !dText.append( !rule )
  enddo
  !this.rules.dText = !dText

  -- Need to initialise Block, With, Include
  !this.copyRule()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    -- Annotation Blocking
    !configData.blockBack( !this.blockBack.val )
    !configData.blockOlay( !this.blockOlay.val )
    !configData.blockSymb( !this.blockSymb.val )
    !configData.blockFill( !this.blockFill.val )
    !configData.blockGraphicFile( !this.blockGraphicFile.val )

    -- Design graphics Blocking
    !configData.nestedBlocks( FALSE )
    !configData.groupBlocks( FALSE )

    !temp =  !this.designGraphics.selection()
    if( !temp eq 'Grouped' ) then
      !configData.groupBlocks( TRUE )
    elseif( !temp eq 'Nested' ) then
      !configData.nestedBlocks( TRUE )
    endif

    !configData.ignoreBlockRules( !this.ignoreBlockRules.val )

    --  Set up block rules
    !configData.blockRules = !this.rules.dText

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      ignoreRules
--
-- Description:  Disable/Enable BlockRule gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ignoreRules()

  !boolFlag = !this.ignoreBlockRules.val

  !this.block.active   = !boolFlag.not()
  !this.with.active    = !boolFlag.not()
  !this.include.active = !boolFlag.not()
  !this.rules.active   = !boolFlag.not()
  !this.cut.active     = !boolFlag.not()
  !this.copy.active    = !boolFlag.not()
  !this.insert.active  = !boolFlag.not()
  !this.replace.active = !boolFlag.not()

endmethod
-- End of method definition for .ignoreRules()

------------------------------------------------------------------------
--
-- Method:      cut
--
-- Description:  Cut rule from Rules list gadget,
--               apply to Block,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cut()
  !pos = !this.rules.val
  !dText = !this.rules.dText

  if( !pos gt 0 ) then

    -- Update Block,With,Include gadgets before cutting selected line
    !this.copyRule()

    -- Cut selected line
    !rule = !dText.remove( !pos )
    !pos = Min( !dText.size(), !pos )

    !this.rules.dText = !dText
    if( !pos gt 0 ) then
      !this.rules.val   = !pos
    endif

  endif

endmethod
-- End of method definition for .cut()

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description:  Copy rule from Rules list gadget,
--               apply to Block,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .copy()
    -- Update Block,With,Include gadgets
    !this.copyRule()

endmethod
-- End of method definition for .copy()

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description:  Replace rule in Rules gadget,
--               applying Block,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replace()
  !rule = !this.constructRule()

  !pos = Max( !this.rules.val, 1 )
  !dText = !this.rules.dText

  -- Replace rule in list gadget by rule constructed from gadgets
  !dText[!pos] = !rule

  !this.rules.dText = !dText
  !this.rules.val   = !pos
endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      insert
--
-- Description:  Insert rule in Rules gadget,
--               applying Block,With,Include gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .insert()
  !rule = !this.constructRule()

  !pos = !this.rules.val
  !dText = !this.rules.dText

  -- Replace rule in list gadget by rule constructed from gadgets
  !selection = !this.insertOpt.selection()
  if( !selection eq 'After' ) then
    !pos = !pos + 1
  endif
  !pos = Max( !pos, 1 )
  !dText.insert( !pos, !rule )

  !this.rules.dText = !dText
  !this.rules.val   = !pos
endmethod
-- End of method definition for .insert()

------------------------------------------------------------------------
--
-- Method:      copyRule
--
-- Description:  Update Block, With and Include gadgets with current selection
--               **** Do we want this to be automatic callback!! ***
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .copyRule()
  -- Find Index for each component of String
  !string = !this.rules.selection()
  !uString = !string.upcase()

  !withIndex = !uString.match( 'WITH' )
  !commaIndex = !uString.match( ',' )
  if( !commaIndex eq 0 ) then
    !commaIndex = !uString.length() + 1
  endif
  !incIndex = !uString.match( 'INCLUDE' )

  if( !incIndex gt 0 ) then
    !this.include.val = !string.subString( !incIndex + 8 ).trim()
  else
    !this.include.val = ''
  endif

  if( !withIndex gt 0 ) then
    !length = !commaIndex - (!withIndex + 5)
    !this.with.val = !string.subString( !withIndex + 5, !length ).trim()
  else
    !this.with.val = ''
    !withIndex = !commaIndex
  endif

  !this.block.val = !string.subString( 1, !withIndex - 1 ).trim()
  if( !this.block.val eq '' ) then
    !this.block.val = 'ALL'
  endif
endmethod
-- End of method definition for .copyRule()

------------------------------------------------------------------------
--
-- Method:      checkRule
--
-- Description:  Validate Block,With,Include syntax (element types)
--               eg ALL (noun noun noun ...)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-- *** COMMAND-LINE SYNTAX
--
------------------------------------------------------------------------

-- Define method
define method .checkRule(!dummyGadgetName is STRING)
  !rule = 'BLOCK ' + !this.constructRule()

  -- Use a junk DLICON to validate syntax
  DLICON /__dxf_check_rule_
  $!rule
  handle any
    EXIT
    -- Error - !!error.text in !gadgetName syntax
    !errorText = !!error.text.after(') ')
    !!messageFile.error( 144, 505, !errorText, 'Block, With or Include' )
    return error
  endhandle
  EXIT

endmethod
-- End of method definition for .checkRule(STRING)

------------------------------------------------------------------------
--
-- Method:      constructRule
--
-- Description:  Construct Rule text from Block,With,Include gadget text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .constructRule() is STRING

  !rule = !this.block.val
  if( !this.with.val ne '' ) then
     !rule = !rule + ' WITH '     + !this.with.val
   endif
   if( !this.include.val ne '' ) then
     !rule = !rule +  ' , INCLUDE ' + !this.include.val
   endif
   return !rule

endmethod
-- End of method definition for .constructRule() STRING

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      return !this.main.getDxfObject()
  else
      return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif


endmethod
-- End of method definition for .setOwnerObject( DXFOUT )
