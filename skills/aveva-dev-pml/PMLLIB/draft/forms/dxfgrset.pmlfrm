--
-- File:            dxfgrset.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:14:46 1997
--
--
-- Description:
-- form to allow user to change group dxf config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  dxfGrSet()                       -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DXFOUT)           -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfGrSet

-- Define form
setup form !!dxfGrSet

  !!dxfGrSet.formTitle     = 'DXF - Grouping'
  !!dxfGrSet.iconTitle     = 'Grouping'
  !!dxfGrSet.callback      = '!!dxfGrSet.init()'
  !!dxfGrSet.formRevision  = ' $Revision: 1.6 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .grouping 'Grouping' width 25
    toggle .groupDims  ' Dimensions      '   states 'OFF' 'ON'
    toggle .groupGlab  ' General  Labels '   states 'OFF' 'ON'
    toggle .groupSlab  ' Symbolic Labels '   states 'OFF' 'ON'
    toggle .groupVnot  ' View Notes      '   states 'OFF' 'ON'
    toggle .groupNote  ' Notes           '   states 'OFF' 'ON'
    toggle .groupFrame ' Frames          '   states 'OFF' 'ON'

  exit

  button .ok      ' OK '   at x0 ymax+0.5 OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfGrSet

------------------------------------------------------------------------
--
-- Method:      !dxfGrSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfGrSet()

  -- define callbacks
  !this.ok.callback     = '!!dxfGrSet.ok()'
  !this.cancel.callback = '!!dxfGrSet.cancel()'

endmethod
-- End of method definition for .dxfGrSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  !this.groupDims.val = !configData.groupDims()
  !this.groupNote.val = !configData.groupNote()
  !this.groupVnot.val = !configData.groupVnot()
  !this.groupGlab.val = !configData.groupGlab()
  !this.groupSlab.val = !configData.groupSlab()
  !this.groupFrame.val = !configData.groupFrame()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    !configData.groupDims( !this.groupDims.val )
    !configData.groupNote( !this.groupNote.val )
    !configData.groupVnot( !this.groupVnot.val )
    !configData.groupGlab( !this.groupGlab.val )
    !configData.groupSlab( !this.groupSlab.val )
    !configData.groupFrame( !this.groupFrame.val )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )

  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      return !this.main.getDxfObject()
  else
      return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DXFOUT )
