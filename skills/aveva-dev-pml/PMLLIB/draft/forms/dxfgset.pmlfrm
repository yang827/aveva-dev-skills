-- File:            dxfgset.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:13:40 1997
--
--
-- Description:
-- form to allow user to change general dxf config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  dxfGSet()                        -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DXFOUT)           -
--  validPositiveNumber(GADGET,STRING) -                   Validates gadget's input
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfGSet

-- Define form
setup form !!dxfGSet

  !!dxfGSet.formTitle     = 'DXF - General'
  !!dxfGSet.iconTitle     = 'General'
  !!dxfGSet.callback      = '!!dxfGSet.init()'
  !!dxfGSet.formRevision  = ' $Revision: 1.6 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .general 'General Settings' width 25
    toggle .viewNumberPrefix ' View Number Prefix'       states 'OFF' 'ON'
    toggle .includeZCoord    ' Z Coordinates'            states 'OFF' 'ON'
    toggle .primitiveThick   ' Primitive Thickness'      states 'OFF' 'ON'
    -- toggle .useShiftJISFonts ' Shift JIS Fonts'          states 'OFF' 'ON'
    -- option .useShiftJISFonts 'Character Encoding    '    width 3
    -- text   .pLineWidthFactor 'Polyline Width Factor '    width 8 is REAL format !!realFmt
    text   .scaleFactor      'Scale Factor          '    width 8 is REAL format !!realFmt
  exit

  button .ok      'OK'   at x0 ymax+0.5 width 6 OK
  button .cancel  'Cancel' at xmax Form-size ymin width 6 CANCEL

exit
-- End of form definition for !!dxfGSet

------------------------------------------------------------------------
--
-- Method:      !dxfGSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfGSet()

  -- Define Rgroup/Option/List data
  !options = ARRAY()
  !options[1] = 'EUC'
  !options[2] = 'JIS'
  --!this.useShiftJISFonts.dText = !options
  !options[1] = 'FALSE'
  !options[2] = 'TRUE'
  --!this.useShiftJISFonts.rText = !options

  -- define callbacks
  !this.ok.callback     = '!!dxfGSet.ok()'
  !this.cancel.callback = '!!dxfGSet.cancel()'
  !this.scaleFactor.validateCall = '!this.validPositiveNumber('

endmethod
-- End of method definition for .dxfGSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  !this.viewNumberPrefix.val = !configData.viewNumberPrefix()
  !this.includeZCoord.val    = !configData.includeZCoord()
  !this.primitiveThick.val   = !configData.primitiveThick()

  -- !this.useShiftJISFonts.val = !configData.useShiftJISFonts()
  --!this.useShiftJISFonts.val = !configData.useShiftJISFonts().real() + 1
  --!this.pLineWidthFactor.val = !configData.pLineWidthFactor()
  !this.scaleFactor.val      = !configData.scaleFactor()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then
    !configData.primitiveThick(   !this.primitiveThick.val )
    !configData.viewNumberPrefix( !this.viewNumberPrefix.val )
    !configData.includeZCoord( !this.includeZCoord.val )
    -- !configData.useShiftJISFonts( !this.useShiftJISFonts.val )
    -- !configData.useShiftJISFonts( !this.useShiftJISFonts.selection().boolean() )
    -- !configData.pLineWidthFactor( !this.pLineWidthFactor.val )
    !configData.scaleFactor( !this.scaleFactor.val )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    return !this.main.getDxfObject()
  else
    return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DXFOUT )

------------------------------------------------------------------------
--
-- Method:      validPositiveNumber
--
-- Description:  Validates gadget's input
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .validPositiveNumber(!gadget is GADGET, !dummyString is STRING)

  -- !gadget.val is either Unset, or it is a Real number
  if (unset(!gadget.val) or !gadget.val.leq(0.0)) then
    return error 1 'Invalid input. Positive number expected'
  endif

endmethod
-- End of method definition for .validPositiveNumber()
