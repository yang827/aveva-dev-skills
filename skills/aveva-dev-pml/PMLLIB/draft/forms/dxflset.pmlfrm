--
-- File:            dxflset.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:16:01 1997
--
--
-- Description:
-- form to allow user to change dxf layering config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  dxfLSet()                        -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DXFOUT)           -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfLSet

-- Define form
setup form !!dxfLSet

  !!dxfLSet.formTitle     = 'DXF - Layers'
  !!dxfLSet.iconTitle     = 'Layers'
  !!dxfLSet.callback      = '!!dxfLSet.init()'
  !!dxfLSet.formRevision  = ' $Revision: 1.6 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down

  frame .design 'Design Layering' width 32
    path right
    hdist 2
    vdist 0.2
    toggle .sites   ' Sites  '  states 'OFF' 'ON'
    toggle .zones   ' Zones  '  states 'OFF' 'ON'
  exit
  path down
  vdist 0.5
  frame .anno   'Annotation Layering' width 32
    vdist 0.2
    toggle .notes   ' Notes  '  states 'OFF' 'ON'
    toggle .layers  ' Layers '  states 'OFF' 'ON'
    toggle .backs   ' Backingsheets'  at xmax_notes+2 ymin_notes states 'OFF' 'ON'
    toggle .overs   ' Overlaysheets'  states 'OFF' 'ON'
  exit

  button .ok      ' OK '     at x0 ymax+0.5 OK
  button .cancel  'Cancel'   at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfLSet

------------------------------------------------------------------------
--
-- Method:      !dxfLSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfLSet()

  -- define callbacks
  !this.ok.callback     = '!!dxfLSet.ok()'
  !this.cancel.callback = '!!dxfLSet.cancel()'

endmethod
-- End of method definition for .dxfLSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  -- !this.ownerName = !main.name()
  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  !this.sites.val  = !configData.layerSite()
  !this.zones.val  = !configData.layerZone()
  !this.backs.val  = !configData.layerBack()
  !this.overs.val  = !configData.layerOlay()
  !this.notes.val  = !configData.layerNote()
  !this.layers.val = !configData.layerLaye()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    !configData.layerSite( !this.sites.val )
    !configData.layerZone( !this.zones.val )
    !configData.layerBack( !this.backs.val )
    !configData.layerOlay( !this.overs.val )
    !configData.layerNote( !this.notes.val )
    !configData.layerLaye( !this.layers.val )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      return !this.main.getDxfObject()
  else
      return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DXFOUT )
