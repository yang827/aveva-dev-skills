--
-- File:            dxfmset.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:14:15 1997
--
--
-- Description:
-- form to allow user to change dxf mapping config settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Removes form from Owner's Children array
--  dxfMSet()                        -                   Constructor
--  getOwnerObject()                 DXFOUT              Get Owner's DXF Object
--  init()                           -
--  ok()                             -
--  setOwnerObject(DXFOUT)           -
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfMSet

-- Define form
setup form !!dxfMSet

  !!dxfMSet.formTitle     = 'DXF - Mapping'
  !!dxfMSet.iconTitle     = 'Mapping'
  !!dxfMSet.callback      = '!!dxfMSet.init()'
  !!dxfMSet.formRevision  = ' $Revision: 1.6 $ '

  -- Name of Owning form
  member .main is FORM

  -- Body of form definition

  path down
  vdist 0.2

  frame .mapping 'Mapping' width 25
    toggle .lineTypeMapping ' LineTypes '  states 'OFF' 'ON'
    toggle .fontMapping     ' Fonts     '  states 'OFF' 'ON'
    toggle .colourMapping   ' Colour    '  states 'OFF' 'ON'
  exit

  button .ok      ' OK '   at x0 ymax+0.5 OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfMSet

------------------------------------------------------------------------
--
-- Method:      !dxfMSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfMSet()

  -- define callbacks
  !this.ok.callback     = '!!dxfMSet.ok()'
  !this.cancel.callback = '!!dxfMSet.cancel()'

endmethod
-- End of method definition for .dxfMSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.main = !this.owner()
  if( !this.main.children.findFirst( !this ).unset() ) then
    !this.main.children.append( !this )
  endif

  !configData = !this.getOwnerObject()

  if( !configData.unset() ) then
    !configData = object DXFOUT()
    !configData.default()
  endif

  !this.fontMapping.val     = !configData.fontMapping()
  !this.colourMapping.val   = !configData.colourMapping()
  !this.lineTypeMapping.val = !configData.lineTypeMapping()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description:  Removes form from Owner's Children array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- Remove this form from Parent form's list of shown children
  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
    !this.main.children.remove( !this.main.children.findFirst( !this ) )
  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !configData = !this.getOwnerObject()
  if( !configData.set() ) then

    !configData.fontMapping( !this.fontMapping.val )
    !configData.colourMapping( !this.colourMapping.val )
    !configData.lineTypeMapping( !this.lineTypeMapping.val )

    -- Apply changes to Object
    !this.setOwnerObject( !configData )
  endif

  -- Remove this form from Parent form's list of shown children
  !this.cancel()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      getOwnerObject
--
-- Description:  Get Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getOwnerObject() is DXFOUT

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      return !this.main.getDxfObject()
  else
      return object DXFOUT()
  endif
endmethod
-- End of method definition for .getOwnerObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setOwnerObject
--
-- Description:  Set Owner's DXF Object
--               Need indirect access to Owner's object because we must use
--               Global variables to access user-defined form methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setOwnerObject( !dxfObject is DXFOUT )

  !ownerName = !this.main.name()
  if( !ownerName eq 'DXFUSET' or !ownerName eq 'DXFASET' ) then
      !this.main.setDxfObject( !dxfObject )
  endif

endmethod
-- End of method definition for .setOwnerObject( DXFOUT )
