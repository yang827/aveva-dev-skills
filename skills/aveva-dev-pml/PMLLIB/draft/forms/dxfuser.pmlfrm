-- Created:         Fri Jul 11 10:12:16 1997
--
--
-- Description:
-- form to allow user to generate dxf output file using new enhanced dxf output options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  buildConfig()                    -                   Load ConfigData from File to initialise !!dxfUSet.data
--  ce()                             -                   New Current element - build Sheet option gadget
--  changeFileType()                 -                   Callback for the DXF/DWG file type toggle
--  checkConfig()                    -                   Check Selected Configuration to see whether user-modifiable
--  dxfUser()                        -                   Constructor
--  editConfigDesc()                 -                   Edits Config to update Description
--  fileExtension()                  STRING              Returns the file extension for the currently selected file type
--  getDxfObject()                   DXFOUT              Returns DXFOUT object selected in Config gadget
--  init()                           -
--  initFirst()                      -                   First initialisation of the form
--  modifiedConfig()                 -                   Edits Config to flag as modified
--  modify()                         -                   Load current ConfigData from File to initialise !!dxfUSet.data
--  queryConfig()                    -                   Show query form for selected configuration
--  readConfig()                     REAL                Get ConfigData DXFOUT object, loading from file if necessary
--  setDxfObject(DXFOUT)             -
--  sheet()                          -                   Generate output File name from Sheet name
--  writeConfig()                    -                   Writes DXF Object to file
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfUser

-- Define form
setup form !!dxfUser

  !!dxfUser.formTitle     = 'Configurable DXF/DWG Output'
  !!dxfUser.iconTitle     = 'DXF/DWG Output'
  !!dxfUser.formRevision  = ' $Revision: 1.20 $ '

  -- Current selection
  member .index     is REAL
  -- Index into array of ConfigData
  member .listPos   is ARRAY

  -- local ConfigData store
  member .dataArray is ARRAY

  -- Body of form definition

  path down
  vdist 0.2

  button .ce ' CE ' at x0 y0.2
  -- option .sheet 'Sheet ' at xmax+1 ymin width - was 24
  para .desc at xmax+0.5 ymin width 6 lines 1
  option .sheet '' at xmax ymin width 38

  frame .output 'Output' at x0 ymax+0.2
    valign centre
    para .fType at x1 ymax-0.4 text |File type| width 7
    path right
    rtoggle .dxf 'DXF'
    rtoggle .dwg 'DWG'
    option  .release 'Release' tagwidth 7 width 15
    path down
    text   .directory   at xmin_fType 'Directory' tagwidth 8 width 40 string
    text   .file                      'File' tagwidth 8 width 40 string
  exit

  frame .frame  'Configuration' at x0 ymax+0.2
    list  .config ''  width 50 height 10
    para  .note text 'NOTE: The above configuration settings apply to DXF or DWG file generation.' width_output
    path right
    hdist 2
    button .query  'Query...'  at xmin ymax
    button .modify 'Modify...'
    button .buildConfig 'Re-build' at xmax_config - 9 ymin
  exit

  button .apply   'Apply' at x0 ymax_frame+1     APPLY
  button .dismiss 'Dismiss' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfUser

------------------------------------------------------------------------
--
-- Method:      dxfUser()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfUser()

  -- define callbacks
  !this.initCall             = '!!dxfUser.init()'
  !this.firstShownCall       = '!!dxfUser.initFirst()'
  !this.config.callback      = '!!dxfUser.checkConfig()'
  !this.modify.callback      = '!!dxfUser.modify()'
  !this.query.callback       = '!!dxfUser.queryConfig()'
  !this.buildConfig.callback = '!!dxfUser.buildConfig()'
  !this.ce.callback          = '!!dxfUser.ce()'
  !this.sheet.callback       = '!!dxfUser.sheet()'
  !this.apply.callback       = '!!dxfUser.apply()'
  !this.output.callback      = '!!dxfUser.changeFileType()'

  !h[1] = 'Configuration file'
  !h[2] = 'Status'
  !this.config.setHeadings(!h)

  -- If you change this list, update the default assignment in .initFirst below.
  !s = 'R13 R14 2000 2000i 2002 2004 2005 2006 2007 2008 2009 2010'
  !this.release.dText = !s.split()
  !s = 'R13 R14 R15 R16 R17 R18 R19 R20 R21 R22 R23 R24'
  !this.release.rText = !s.split()
endmethod
-- End of method definition for .dxfUser()

------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()

  !this.directory.val      = |%PDMSUSER%|
  -- Derive Filename from Sheet name
  !this.file.val           = |my.dxf|

  -- Populate Sheet gadget
  !this.ce()
  --!this.sheet()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      initFirst
--
-- Description: First initialisation of the form
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .initFirst()
  !this.release.val = 12 $* AutoCAD 2010
  !this.output.val = 1
  !this.changeFileType()
  !this.buildConfig()
endmethod
-- End of method definition for .initFirst()

------------------------------------------------------------------------
--
-- Method:      changeFileType()
--
-- Description: Callback for the DXF/DWG file type toggle
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .changeFileType()
  !fType = !this.output.val
  !this.release.active = !fType.eq(2)
  !name = !this.file.val.trim()
  !nameLen = !name.length()
  if( !nameLen.gt(0) ) then
    !last = !name.subString(-4,4)
    if( !last.eq('.dxf') or !last.eq('.dwg') ) then
      !this.file.val = !name.subString(1, !nameLen - 4) & !this.fileExtension()
    else
      !this.file.val = !name & !this.fileExtension()
    endif
  endif
endmethod
-- End of method definition for .changeFileType()

------------------------------------------------------------------------
--
-- Method:      fileExtension()
--
-- Description: Returns the file extension for the currently selected file type
--
-- Method Type: Function
-- Arguments:
-- Return:
--   STRING  File extension
--
------------------------------------------------------------------------
define method .fileExtension() is STRING
  if( !this.output.val.eq(1) ) then
    !ext = '.dxf'
  else
    !ext = '.dwg'
  endif
  return !ext
endmethod
-- End of method definition for .fileExtension()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
--  modified 02/02/00 by GEWJ - fixed to navigate correctly to selected sheet
--                              (PUR35348)
--  modified 14/07/00 by GEWJ - don't lose the user's filename when we navigate
--  modified 24/02/09 by TL   - add the DWG production ability
------------------------------------------------------------------------
--
-- Define method
define method .apply()

  -- Save Current DB Position and navigate to Selected Sheet
  !x = !!ce
  !y = !this.file.val
  !newSheet = !this.sheet.selection()
  $!newSheet
  !this.ce()
-- restore filename
  !this.file.val = !y

  -- Ensure that this configuration has been loaded from File
  !dataIndex = !this.readConfig()

  !configName = !this.dataArray[!dataIndex].name()

  -- Load Configuration into DRAFT
  !this.dataArray[!dataIndex].config()

  !filename = !this.directory.val + '/' + !this.file.val

  -- ***** Command-line Syntax *****
  if( !this.output.val.eq(1) ) then
    -- DXF
    !module  = 'Draft_DXF_LI'
    !release = 'DXFOUT' $* use latest
  else
    -- DWG
    !module  = 'Draft_DWG_LI'
    !release = !this.release.selection()
  endif
  LIEXEC /$!module '$!release' CONFIGDATA '$!configName' $
                               OUTPUTFILENAME '$!filename'
  !!ce = !x
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      ce
--
-- Description:  New Current element - build Sheet option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .ce()

  !mainElement = LIBY
  handle any
     !mainElement = DRWG
     handle any
       -- we are above a DRWG or LIBY
       !!messageFile.error( 144, 4 )
       return error
     endhandle
  endhandle

  !mainTypes = 'DRWG LIBY'
  if( !mainTypes.match( !!ce.type ) gt 0 ) then
       -- we are at a DRWG or LIBY
       !!messageFile.error( 144, 4 )
       return error
  endif

  -- Find owning Picture element
  !pictureTypes = 'SHEE LALB SYLB BACK OVER ISOLB SHTMPL'
  !!ce = !!dtbGetOwnerType(!!ce, !pictureTypes)

  if( !pictureTypes.match( !!ce.type ) gt 0 ) then
    -- Already at a Picture element
    !picture = !!ce
  endif

  !sheets = !!collectAllFor( !pictureTypes, '', !mainElement )

  -- Build Sheet gadget (option gadget .sheet is 38 chars wide)
  --!dTextEval = object BLOCK('!sheets[!evalIndex].namn')
  --!dTextEval = object BLOCK('cutnmn 38 of $$!sheets[$$!evalIndex]')
  !dTextEval = object BLOCK('!sheets[!evalIndex].cutnmn[38]')
  !dText = !sheets.evaluate(!dTextEval)
  !this.sheet.dText = !dText

  !rTextEval = object BLOCK('!sheets[!evalIndex].name')
  !rText = !sheets.evaluate(!rTextEval)
  !this.sheet.rText = !rText

  if( defined(!picture) ) then
    -- !this.sheet.select( 'Dtext', !picture.namn )
    !this.sheet.select( 'Rtext', !picture.name )
    -- Callback doesn't seem to be automatic !
    !this.sheet()
  endif

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      sheet
--
-- Description:  Generate output File name from Sheet name
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .sheet()

  -- Generate File gadget text from Sheet name
  !name = !this.sheet.selection()
  !ext = !this.fileExtension()
  if( !name.empty() ) then
    !this.file.val = |my| & !ext
    !this.apply.active = TRUE
  else
    !desc = !name.dbref().type
    if( !desc eq 'SHEE' ) then
      !this.desc.val = 'Sheet'
    else
      !this.desc.val = !desc.subString(1,1) + !desc.subString(2).lowcase()
    endif

    --!name = !this.sheet.selection('Dtext')
    !name = !this.sheet.selection('Rtext')
    !!ce = !name.dbref()

    -- Re-use of FD check for Draft+ -- note 'ON'/'OFF' are both Draft, Draft+ is 'ONLY' and possibly newer values
    if( !desc.eq('SHEE') or !desc.eq('OVER') ) then
      !this.apply.active = !name.dbref().acPicture.upCase().eq('OFF') or !name.dbref().acPicture.upCase().eq('ON')
    elseif( !desc.eq('VIEW') ) then
      -- Special case; a view with an owner converted to Final Designer
      !owner = !name.dbref().owner()
      !ownerType = !owner.type
      if( !ownerType.eq('SHEE') or !ownerType.eq('OVER') ) then
        !this.apply.active = !owner.acPicture.upCase().eq('OFF') or !owner.acPicture.upCase().eq('ON')
      else
        !this.apply.active = true
      endif
    else
      !this.apply.active = true
    endif
    if( not !this.apply.active ) then
      !!alert.error(!name & ' has been modified by AVEVA E3D Draw')
    endif

    if( !name.subString(1,1) eq '/' ) then
       !name = !name.subString(2)
    endif
    !name = !name.replace( '/', '.' ) + !ext
    !this.file.val = !name

  endif

endmethod
-- End of method definition for .sheet()

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description:  Load current ConfigData from File to initialise !!dxfUSet.data
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .modify()

  -- Establish Configuration
  !dataIndex = !this.readConfig()

  if( not !this.dataArray[!dataIndex].userAccess() ) then
    -- Newly loaded Configuration file is not modifiable
    !this.modify.active = FALSE
    -- Error 'Configuration is not modifiable by Users'
    !!messageFile.error( 144, 501, !this.config.selection() )
    return error
  endif

  -- Config not saved - use Administration>Settings>DXF Config
  !!messageFile.warning( 144, 506, !this.config.selection() )

  show !!dxfUSet
endmethod
-- End of method definition for .modify()

------------------------------------------------------------------------
--
-- Method:      buildConfig
--
-- Description:  Load ConfigData from File to initialise !!dxfUSet.data
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
--  *** PML1 CODE ***
------------------------------------------------------------------------

-- Define method
define method .buildConfig()
  -- Generate list of File objects
  !fileArray = !!uniquePath( 'dra-dxf-*.pmldat', 'USER PROJ PDMS', '' )

  !dText = ARRAY()
  !rText = ARRAY()
--  --         12345678901234567890123456789012
--  !spaces = '                                '

--  !eval = object BLOCK( '!fileArray[!evalIndex].entry().before( |.pmldat| )' )
--  !s = !fileArray.evaluate( !eval )
--  !width = !s.width() + 3

  -- At least one entry always exists with default settings!
  !this.index = 1
  !this.listPos.clear()
  !this.listPos[1] = 1

  !this.dataArray.clear()
  !this.dataArray[1] = object DXFOUT()
  !this.dataArray[1].default()

  !tab = '	'
  !dText[1] = !this.dataArray[1].name() & !tab & !this.dataArray[1].description()
  !rText[1] = ''

  !description = 'not loaded'
  do !file values !fileArray
    ---- Read Description from file
    ---- !description = !this.dataArray[1].readDescription( !file )
    !name = !file.entry().before( '.pmldat' )
    !dText.append(!name & !tab & !description)
    !rText.append( !file.fullName() )
    !this.listPos.append(0)
  enddo
  !this.config.dText = !dText
  !this.config.rText = !rText

  -- Set MODIFY gadget status
  !this.checkConfig()

endmethod
-- End of method definition for .buildConfig()

------------------------------------------------------------------------
--
-- Method:      checkConfig
--
-- Description:  Check Selected Configuration to see whether user-modifiable
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .checkConfig()

  -- First check that we're not currently Modifying configuration
  if ( defined( !!dxfUSet ) ) then
    if( !!dxfUSet.shown() ) then
      !this.config.val = !this.index
      -- Error - Currently modifying configuration. Retain current selection
      !!messageFile.error( 144, 508 )
      return error
    endif
  endif

  -- !!dxfQuery.hide()
  -- handle (2,751)
  --   -- Form not defined
  -- endhandle

  !this.index = !this.config.val

  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex eq 0 ) then
    -- Config not yet loaded - assume modifiable
    !this.modify.active = TRUE
  else
    !this.modify.active = !this.dataArray[!dataIndex].userAccess()
  endif

endmethod
-- End of method definition for .checkConfig()

------------------------------------------------------------------------
--
-- Method:      queryConfig
--
-- Description:  Show query form for selected configuration
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .queryConfig()

  -- Check that Config is loaded
  !this.readConfig()

  if( defined( !!dxfQuery ) and !!dxfQuery.shown() ) then
    !!dxfQuery.init()
  endif
  -- Still need to show it in order to Raise it if hidden by other forms
  show !!dxfQuery
endmethod
-- End of method definition for .queryConfig()

------------------------------------------------------------------------
--
-- Method:      readConfig
--
-- Description:  Get ConfigData DXFOUT object, loading from file if necessary
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--   REAL   Configuration index
--
------------------------------------------------------------------------

-- Define method
define method .readConfig() is REAL

  -- Find ConfigData selection - is it loaded?
  -- !index = !this.config.val
  !selection = !this.config.selection()

  if( !this.listPos[!this.index] gt 0 ) then
    -- File has been loaded
    !dataIndex = !this.listPos[!this.index]
    !alreadyLoaded = TRUE

  else
    -- Need to load file
    !this.dataArray.append( object DXFOUT() )
    !this.listPos[!this.index] = !this.dataArray.size()

    !dataIndex = !this.listPos[!this.index]
    !configFile = !!file( !selection )
    !this.dataArray[!dataIndex].load( !configFile )
    handle(146,9)
      -- Failed to load file
      !this.listPos[!this.index] = 0
      !this.dataArray.removeLast()
      !this.modify.active = FALSE
      return error
    endhandle

    !alreadyLoaded = FALSE
  endif

  -- Set Active status of Modify button
  !this.modify.active = !this.dataArray[!dataIndex].userAccess()

  if( !alreadyLoaded.not() ) then
    !this.editConfigDesc()
  endif

  -- Return the position of the DXF Object
  return !dataIndex

endmethod
-- End of method definition for .readConfig() REAL

------------------------------------------------------------------------
--
-- Method:      editConfigDesc
--
-- Description: Edits Config to update Description
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .editConfigDesc()
  -- Update Description in .config gadget
  !dataIndex = !this.listPos[!this.index]

  -- ?? What if Config Filename doesn't match internal name ?? (should not get)
  !dText = !this.config.dText
  !rText = !this.config.rText
  !tab   = |	|

  !a = !dText[!this.index].split(!tab)
  !dText[!this.index] = !a[1] & !tab & !this.dataArray[!dataIndex].description()

  !this.config.dText = !dText
  !this.config.rText = !rText
  !this.config.val   = !this.index
endmethod
-- End of method definition for .editConfigDesc()

------------------------------------------------------------------------
--
-- Method:      modifiedConfig
--
-- Description: Edits Config to flag as modified
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .modifiedConfig()
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]

  -- Add * to Dtext in .config gadget to show that it is modified
  !dText = !this.config.dText
  !rText = !this.config.rText
  !tab   = |	|

  !a = !dText[!this.index].split(!tab)
  !dText[!this.index] = !a[1] & !tab & |* | & !this.dataArray[!dataIndex].description()

  !this.config.dText = !dText
  !this.config.rText = !rText
  !this.config.val = !this.index
endmethod
-- End of method definition for .modifiedConfig()

------------------------------------------------------------------------
--
-- Method:      writeConfig
--
-- Description: Writes DXF Object to file
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .writeConfig()
  -- !index = !this.config.val
  !selection = !this.config.selection()
  if( !selection eq '' ) then
    -- Error 'No Configuration file selected'
    !!messageFile.error( 144, 502 )
     return error
  endif

  -- Only write to file if file in USER area
  -- *** PML1 code ***
  var !evar EVAR PDMSUSER
  !dirName = !selection.before( '/' + !selection.part( -1, '/' ) )

  if( !evar.match( !dirName ) eq 0 ) then
    -- File not saved - use Administration>Settings>DXF Config
    !!messageFile.warning( 144, 506, !selection )
    return
  endif

  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex gt 0 ) then
    !this.dataArray[!dataIndex].save( !!file(!selection) )
  endif
endmethod
-- End of method definition for .writeConfig()

------------------------------------------------------------------------
--
-- Method:      getDxfObject
--
-- Description: Returns DXFOUT object selected in Config gadget
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--   DXFOUT  Object describing the configuration
--
------------------------------------------------------------------------

-- Define method
define method .getDxfObject() is DXFOUT
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]
  if( !dataIndex eq 0 ) then
    return object DXFOUT()
  else
    return !this.dataArray[!dataIndex]
  endif
endmethod
-- End of method definition for .getDxfObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setDxfObject
--
-- Description: Sets DXFOUT object selected in Config gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   1  R  DXFOUT  Selected configuration
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .setDxfObject( !dxfObject is DXFOUT )
  -- !index = !this.config.val
  !dataIndex = !this.listPos[!this.index]
  if( !this.dataArray[!dataIndex].userAccess() ) then
    !this.dataArray[!dataIndex] = !dxfObject
  else
    -- Error 'Configuration is not modifiable by Users'
    !!messageFile.error( 144, 501, !this.config.selection() )
     return error
  endif

endmethod
-- End of method definition for .setDxfObject( DXFOUT )
