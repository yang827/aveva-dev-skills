--   Group:         General Application
--     Keyword:     GEN
--   Module:        draft
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Fri Jul 11 10:13:08 1997
--
--
-- Description:
-- form to allow user to change dxf configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  childFormAccess()                -                   Controls access to other gadgets on form
--  dxfUSet()                        -                   Constructor
--  fontPath()                       -                   FontPath callback - Disable FontFilePath gadget if toggle OFF
--  getDxfObject()                   DXFOUT              Returns DXFOUT object
--  init()                           -
--  ok()                             -
--  setDxfObject(DXFOUT)             -
--  setFontPath()                    -                   Set Font path gadgets from FontPath settings
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dxfUSet

-- Define form
setup form !!dxfUSet

  !!dxfUSet.formTitle     = 'DXF Configuration Settings'
  !!dxfUSet.iconTitle     = 'DXF Settings'
  !!dxfUSet.callback      = '!!dxfUSet.init()'
  !!dxfUSet.formRevision  = ' $Revision: 1.8 $ '

  -- local form ConfigData store
  member .data is DXFOUT

  member .main is FORM
  member .children is ARRAY

  -- Body of form definition

  path down
  vdist 0.2

  para .configP at x0 y0.2 text   'Configuration : '
  para .config  at xmax ymin width 40 lines 1

  para .descP at x0 ymax+0.2 text 'Description   : '
  para .description  at xmax ymin width 40 lines 1

  toggle .fontPath  'Font File Path ' at x0 ymax+0.5  states 'FALSE' 'TRUE'
  text   .fontFilePath '' at xmax+1 ymin width 32 string

  text   .headerFileName 'Header File Name  ' at x0 ymax+0.2 width 32 string

  frame .settings 'Settings' at x1 ymax+0.5

    button .general  ' General...  '   at x+1 y+1
    button .mapping  ' Mapping...  '   at xmin ymax+0.5

    button .group    ' Grouping... '   at xmax_general+4 ymin_general
    button .block    ' Blocking... '   at xmin ymax+0.5

    button .layer    ' Layering... '   at xmax_group+4 ymin_general
    button .advanced ' Advanced... '   at xmin ymax+0.5

  exit

  button .ok      ' OK '   at x0 ymax+1  OK
  button .cancel  'Cancel' at xmax Form-size ymin CANCEL

exit
-- End of form definition for !!dxfUSet

------------------------------------------------------------------------
--
-- Method:      !dxfUSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dxfUSet()

  -- define callbacks
  !this.fontPath.callback  = '!!dxfUSet.fontPath()'
  !this.general.callback   = |show !!dxfGSet|
  !this.mapping.callback   = |show !!dxfMSet|
  !this.group.callback     = |Show !!dxfGrSet|
  !this.block.callback     = |Show !!dxfBSet|
  !this.layer.callback     = |Show !!dxfLSet|
  !this.advanced.callback  = |Show !!dxfAdvSet|
  !this.ok.callback        = '!!dxfUSet.ok()'

endmethod
-- End of method definition for .dxfUSet()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !!dxfASet.hide()
  handle (2,751)
  -- Form not defined
  endhandle

  !this.main = !this.owner()

  if( !this.main.name().match( 'DXFUSER' ) gt 0 ) then
    !this.setDxfObject( !this.main.getDxfObject() )
    if( !this.data.unset() ) then
      -- Error in getting object from Main form
      !this.data.default()
    endif

    !this.config.val      = !this.data.name()
    !this.description.val = !this.data.description()

  else
    !this.data.default()
    !this.config.val = 'unset'
  endif

  !this.headerFileName.val = !this.data.headerFileName()

  !this.fontFilePath.val = !this.data.fontFilePath()
  !this.setFontPath()

  -- Access to Child forms
  -- Update data on Shown Child forms
  !this.children = ARRAY()
  !this.childFormAccess()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  if ( !this.fontPath.val eq OFF ) then
    !this.data.fontFilePath( 'OFF' )
  else
    !this.data.fontFilePath( !this.fontFilePath.val )
  endif

  !this.data.headerFileName( !this.headerFileName.val )

  -- Return data to parent
  if( !this.main.name() eq 'DXFUSER' ) then
    !this.main.setDxfObject( !this.getDxfObject() )

    -- Mark configuration as modified
    !this.main.modifiedConfig()
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      setFontPath
--
-- Description:  Set Font path gadgets from FontPath settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setFontPath()

  !string = !this.data.fontFilePath()

  if( !string eq 'OFF' ) then
    !this.fontPath.val = FALSE
    !this.fontFilePath.active = FALSE
    -- Don't overwrite existing FontFilePath gadget text
  else
    !this.fontPath.val = TRUE
    !this.fontFilePath.active = TRUE
    !this.fontFilePath.val = !string
  endif

endmethod
-- End of method definition for .setFontPath()


------------------------------------------------------------------------
--
-- Method:      fontPath
--
-- Description:  FontPath callback - Disable FontFilePath gadget if toggle OFF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .fontPath()

  if( !this.fontPath.val eq FALSE ) then
    !this.fontPath.val = FALSE
    !this.fontFilePath.active = FALSE
  else
    if( !this.fontFilePath.val eq 'OFF' ) then
      -- Re-initialise FontFilePath
      !this.fontFilePath.val = !this.data.fontFilePath()
      if( !this.fontFilePath.val eq 'OFF' ) then
        !this.fontFilePath.val = '%PDMSEXE%/autodraftfonts'
      endif
    endif
    !this.fontFilePath.active = TRUE
    !this.fontPath.val = TRUE
  endif

endmethod
-- End of method definition for .fontPath()
------------------------------------------------------------------------
--
-- Method:      getDxfObject
--
-- Description: Returns DXFOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getDxfObject() is DXFOUT
  return !this.data

endmethod
-- End of method definition for .getDxfObject() DXFOUT

------------------------------------------------------------------------
--
-- Method:      setDxfObject
--
-- Description: Sets DXFOUT object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDxfObject( !dxfObject is DXFOUT )
  !this.data = !dxfObject

endmethod
-- End of method definition for .setDxfObject( DXFOUT )

------------------------------------------------------------------------
--
-- Method:      childFormAccess
--
-- Description:  Controls access to other gadgets on form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .childFormAccess()

  -- Update Active status for gadgets which access child forms
  !this.general.active  = !this.data.userGeneral()
  !this.mapping.active  = !this.data.userMapping()
  !this.block.active    = !this.data.userBlocking()
  !this.layer.active    = !this.data.userLayering()
  !this.group.active    = !this.data.userGrouping()
  !this.advanced.active = !this.data.userAdvanced()

  -- Hide shown Child forms which are now longer accessible
  -- Re-initialise any forms which are still shown
  do !form values !this.children
    if( !form.shown() ) then
      !showFlag = TRUE

      -- Check that User still has access to this form
      -- (We probably only need to check DXFGRSET here)
      if( !form.name() eq 'DXFGRSET' ) then
        !showFlag = !this.group.active

        -- Hide form if not accessible
        if( not !showFlag ) then
          !form.hide()
          -- Remove form from array
          !index = !this.children.findFirst( !form )
          !this.children.deleteFrom( !index, 1 )
        endif
      endif

      if( !showFlag ) then
        -- Re-initialise Child form
        !form.init()
      endif

     else
      -- Remove Hidden forms
      !index = !this.children.findFirst( !form )
      !this.children.deleteFrom( !index, 1 )
    endif
  enddo
  !this.children.compress()

endmethod
-- End of method definition for .childFormAccess()
