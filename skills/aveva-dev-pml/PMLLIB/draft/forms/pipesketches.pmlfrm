-- End of method
------------------------------------------------------------------------
--
-- Method:      printSketch
--
-- Description: Print sketch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word BACK, SELECTED or FORWARD
--    2    R     STRING      Key word CURRENT, ALL or PREVIEW
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printSketch(!option is STRING, !dummyPrintOption is STRING)

  -- What is selected at the moment
  !pickedField = 0
  !index = !this.list.val.size()
  if (!index gt 0) then
    !picked = !this.list.val
    !pickedField = !picked[!index]
  endif

  if (!option eq 'BACK') then
    if (!pickedField gt 1) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField - 1])
      !this.printSketch('SELECTED')
    endif
  elseif (!option eq 'FORWARD') then
    if (!pickedField lt (!this.list.rtext.size())) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField + 1])
      !this.printSketch('SELECTED')
    endif
  endif

  -- Make the apply active
  if (!option eq 'SELECTED') then
          -- OK so how many selections have a existing sketch
    !count = 0
    do !sel values !this.list.selection('dtext')
      !testForDrawing = !sel.part(3).dbref()
      handle ANY
        -- This must not have an existing sketch
      elsehandle NONE
        !count = !count + 1
      endhandle
    enddo
    -- Do a check on how many sheets are being opened and ask for confirmation if many
    if (!count eq 0) then
      !!alert.message('No available sketches selected!')
      return
    elseif (!count gt 1) then
      !answer = !!alert.confirm('Print ' &  !count.string() & ' selected sketches?')
      if (!answer.boolean().not()) then
        return
      endif
    endif

    -- The Plot Service code..........

    !counter = 0
    do !sel values !this.list.selection('dtext')
      !counter = !counter + 1
      -- Get the drawing name
      !drawing = !sel.part(3)
      !sheet = !!dtbMemberOfType(!drawing.dbref(), 'SHEE', 1)
      handle ANY
        if (!counter eq 1) then
        	!counter = 0
        endif	
        skip
      endhandle
      if (!counter eq 1) then
        PLOT $!sheet FILE PRINT 'COL BW, REDUCE, EXPAND'
      else
        PLOT $!sheet FILE PRINT 'COL BW, NODIALOG, REDUCE, EXPAND'
      endif
    enddo

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteSketch
--
-- Description: Delete sketch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word BACK, SELECTED or FORWARD
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteSketch(!option is STRING)

  -- What is selected at the moment
  !pickedField = 0
  !index = !this.list.val.size()
  if (!index gt 0) then
    !picked = !this.list.val
    !pickedField = !picked[!index]
  endif

  if (!option eq 'BACK') then
    if (!pickedField gt 1) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField - 1])
      !this.deleteSketch('SELECTED')
      return
    endif
  elseif (!option eq 'FORWARD') then
    if (!pickedField lt (!this.list.rtext.size())) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField + 1])
      !this.deleteSketch('SELECTED')
      return
    endif
  endif

  -- Make the apply active
  if (!option eq 'SELECTED') then
          -- OK so how many selections have a existing sketch
    !count = 0
    do !sel values !this.list.selection('dtext')
      !testForDrawing = !sel.part(3).dbref()
      handle ANY
        -- This must not have an existing sketch
      elsehandle NONE
        !count = !count + 1
      endhandle
    enddo
    -- Do a check on how many sheets are being opened and ask for confirmation if many
    if (!count eq 0) then
      !!alert.message('No available sketches selected!')
      return
    elseif (!count gt 1) then
      !answer = !!alert.confirm('Delete ' &  !count.string() & ' selected sketches?')
      if (!answer.boolean().not()) then
        return
      endif
    endif

    do !sel values !this.list.selection('dtext')
      -- Get the drawing name
      !drawing = !sel.part(3)
      -- Delete the drawing
      !!ce = !drawing.dbref()
      handle ANY
        skip
      endhandle
      -- Navigate to the drawing
      !type = !!ce.type
      DELETE $!type
      handle ANY
        skip
      endhandle
    enddo

    -- Update the main draft gadgets after deletions
    !file = object FILE('%PDMSUI%/DRA/CLIB/UDELCLEAN')
    !!runMacro(!file.fullName() , 'DRWG')

    -- Refresh the list
    !this.search()

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      activateGadgets
--
-- Description: Activate Display, Print Delete based on what is selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activateGadgets()

  -- What is selected at the moment
  !pickedField = 0
  !index = !this.list.val.size()
  if (!index gt 0) then
    !picked = !this.list.val
    !pickedField = !picked[!index]
  endif

  -- Make the gadgets active?
  -- OK so how many selections have a existing sketch
  !count = 0
  !lowCount = 0
  !highCount = 0
  !lowestSelected = !this.list.dtext.size()
  !totalLessOne = !this.list.dtext.size() - 1
  !highestSelected = 0

  -- Find out the highest and lowest picked
  do !curPicked values !picked
    if (!curPicked gt !highestSelected) then
      !highestSelected = !curPicked
    endif
    if (!curPicked lt !lowestSelected) then
      !lowestSelected = !curPicked
    endif
  enddo

  -- Find out if a selected sketch is valid
  do !listSel values !this.list.selection('dtext')
    !testForDrawing = !listSel.part(3).dbref()
    handle ANY
      -- This must not have an existing sketch
    elsehandle NONE
      !count = !count + 1
      break
    endhandle
  enddo

  -- Has the previous to highest/lowest valid
  !testForDrawing = !this.list.dtext[!lowestSelected - 1].part(3).dbref()
  handle ANY
    -- This must not have an existing sketch
  elsehandle NONE
    !lowCount = !lowCount + 1
  endhandle
  !testForDrawing = !this.list.dtext[!highestSelected + 1].part(3).dbref()
  handle ANY
    -- This must not have an existing sketch
  elsehandle NONE
    !highCount = !highCount + 1
  endhandle

  -- Do a check on how many sheets are being opened and ask for confirmation if many
  if (!count eq 0) then
    !this.listPopUp.setActive('Print Sketch', FALSE)
    !this.listPopUp.setActive('Delete Sketch', FALSE)
    !this.display.active = FALSE
    !this.forward.active = FALSE
    !this.back.active = FALSE
  else
    !this.listPopUp.setActive('Print Sketch', TRUE)
    !this.listPopUp.setActive('Delete Sketch', TRUE)
    !this.display.active = TRUE
  endif

  -- Grey in the forward and back buttons
  if (!highestSelected le !totalLessOne and !highCount gt 0) then
    !this.forward.active = TRUE
  else
    !this.forward.active = FALSE
  endif
  if (!lowestSelected ge 2 and !lowCount gt 0) then
    !this.back.active = TRUE
  else
    !this.back.active = FALSE
  endif

  -- Activate the Apply or not
  !this.activeApply()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      newElement
--
-- Description: New Design Element for form to action on
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .newElement(!valOrCurrentElement is STRING)

  -- Remember the gadget setting
  !memory = !this.actionElement.name

  if (!valOrCurrentElement.lowcase() eq 'ce') then
    if (dbtype neq 'DESI') then
      switch
    endif
    !this.ceName.val = !!ce.name
  endif

  -- Run the gadget validation
  !this.validateCeName(!this.ceName, 'unused')
  handle ANY
    !!alert.error(!!error.text)
    !this.ceName.val = !memory
    return
  endhandle

  -- Navigate to the new Element
  !!ce = !this.ceName.val.dbref()
  handle ANY
    -- This should never happen because we've just validated it
    return
  endhandle

  -- Initialise
  call !!pipeSketches()

endmethod
-- End of method
