-- File:            pipesketches.pmlfrm
--   Type:          Form Definition
--   Group:         Document production
--     Keyword:     Pipe Sketches
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve.Bentley
-- Created:         Fri Jan 21 08:00:00 GMT 2005
--
--
-- Description:
-- Form for Creating Pipe Sketches
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateGadgets()                -                   Activate Display, Print Delete based on what is selected
--  activeApply()                    -                   Activate the apply gadget
--  apply()                          -                   Apply the form
--  deleteSketch(STRING)             -                   Delete sketch
--  displaySketch(STRING)            -                   Display sketch
--  init()                           -                   Initialise Form
--  listPopUpCallback()              -                   Call back for the pop up menu on the spool list
--  logFile(STRING)                  -                   Set the log File to record each Pipe Sketch process
--  newElement(STRING)               -                   New Design Element for form to action on
--  pipeSketches()                   -                   Constructor
--  printSketch(STRING,STRING)       -                   Print sketch
--  readDefaultFile()                ARRAY               read the default file to restore defaults to gadgets
--  registry(STRING)                 -                   Set the registry to store all the Pipe Sketches created
--  registryCE()                     -                   Set CE to be the registry to store all the Pipe Sketches created
--  search()                         -                   Refresh the Spool list
--  setLogFile(STRING)               -                   Set the log File and log file gadget to record each Pipe Sketch process
--  template(STRING)                 -                   Set the template to be use for each Pipe Sketch drawing
--  templateCE()                     -                   Set CE to be the template to be use for each Pipe Sketch drawing
--  trace(DBREF)                     -                   Trace
--  validateCeName(GADGET,STRING)    -                   Validate the input to the ceName gadget
--  validateLogFile(GADGET,STRING)   -                   Validate the input to the log file gadget
--  validateRegistry(GADGET,STRING)  -                   Validate the input to the registry gadget
--  validateTemplate(GADGET,STRING)  -                   Validate the input to the template gadget
--  writeDefaultFile()               -                   Write a default file so we can restore gadget settings
--
setup form !!pipeSketches dialog dock r
Import 'pmlfilebrowser'
handle any
endhandle

  !this.formTitle     = 'Pipe Sketches'
  !this.iconTitle     = 'Pipe Sketch'
  !this.callback      = '!this.init()'

  -- Form Members
  member .actionElement   is DBREF

  hdist 0

  para .searchByParagraph   at x1 ymax width 30 lines 1
  !this.searchByParagraph.val = 'Search by any or all of the criteria below:'
  para .searchUnderParagraph   at x1 ymax width 30 lines 1
  !this.searchUnderParagraph.val = 'Design Element to search under:'


  -- Paragraph showing export element / CE name
  text .ceName '' anchor top + left + right at x2 ymax call '!this.newElement(|val|)' width 30 scroll 90 STRING


  -- Body of form definition
  button .ce 'CE ' anchor top + right at xmax+1 ymin   callback '!this.newElement(|ce|)'

  para .filterSpoolsParagraph   at x1 ymax+0.5 width 20 lines 1
  !this.filterSpoolsParagraph.val = 'Filter the spools using:'

  para .nameIncludesParagraph   at x2 ymax width 20 lines 1
  !this.nameIncludesParagraph.val = 'All or part of the spool name:'
  text .nameFilter '' anchor top + left + right at x2 ymax call '' tooltip |Wildcard expression expected. The character '*' stands for an arbitrary sequence of characters.
The character '?' stands for a single character only. Examples: ABC*, *XYZ, A?XYZ*| width 30 scroll 90 STRING

  para .productStatusParagraph   at x1 ymax width 20 lines 1
  !this.productStatusParagraph.val = 'Production Status:'
  option .statusOption '' anchor top + left + right at x2 ymax callback '' width 28

  para .drawingDrawnParagraph   at x1 ymax width 20 lines 1
  !this.drawingDrawnParagraph.val = 'Sketch Status:'
  option .drawnOption '' anchor top + left + right at x2 ymax callback '' width 28

  button .search      'Search' anchor top + right at xmax+1 ymax+0.5  call '!this.search()'

  list   .list   'Search Results:' anchor top + bottom + left + right at x0 ymax+0.5 call '!this.activateGadgets()' columns MULTI width 40 length 6

  !menu = !this.newMenu('listPopUp')
  !menu.add(|callback|, 'Select All',      '!this.listPopUpCallback()', 'Select All')
  !menu.add(|callback|, 'Clear Selection', '!this.listPopUpCallback()', 'Clear Selection')
  --  !menu.add(|callback|, 'Display Sketch',   '!this.listPopUpCallback()', 'Display Sketch')
  !menu.add(|callback|, 'Print Sketch',   '!this.listPopUpCallback()', 'Print Sketch')
  !menu.add(|callback|, 'Delete Sketch',   '!this.listPopUpCallback()', 'Delete Sketch')

  path down
  vdist 0.5

  halign right
  button    .display 'Display' at xmin.search - 2 ymax+0.5 anchor bottom + right call |!this.displaySketch('SELECTED')|  tooltip 'Display selected Sketches' width 6
  path right
  button    .forward at ycen anchor bottom + right    call |!this.displaySketch('FORWARD')| pixmap width 16 height 16 tooltip 'Forward one Sketch'
  path up
  vdist 0
  button    .back            anchor bottom + right    call |!this.displaySketch('BACK')|    pixmap width 16 height 16 tooltip 'Back one Sketch'

  frame .optionsFrame  'Sketch Creation Options: '   anchor bottom + left + right at x0.1 ymax+1

    para .templateParagraph   at x2 ymax width 25 lines 1
    !this.templateParagraph.val = 'Sketch Template:'
    text .template     '' anchor bottom + left + right at x2 ymax call '' width 26 string
    button .templateCE 'CE ' anchor bottom + right at xmax+1 ymin  call '!this.templateCE()'
    para .templateType anchor bottom + right at xmax ymin text 'DRWG '

    para .registryParagraph   at x2 ymax width 25 lines 1
    !this.registryParagraph.val = 'Create Sketches in Registry:'
    text .registry     '' anchor bottom + left + right at x2 ymax call '' width 26 string
    button .registryCE 'CE ' anchor bottom + right at xmax+1 ymin  call '!this.registryCE()'
    para .registryType anchor bottom + right at xmax ymin text 'REGI '

    para .logFileParagraph   at x2 ymax width 25 lines 1
    !this.logFileParagraph.val = 'Log File:'
    text .logFile      '' anchor bottom + left + right at x2 ymax call '' width 26 string
    button .browse     'Browse...' anchor bottom + right at xmax+1 ymin  callback |!!fileBrowser('%PDMSUSER%', '*.txt', 'Log File for Pipe Sketches Process', FALSE, '!!pipeSketches.setLogFile(!!fileBrowser.file.name())') |

  exit

  -- Bottom Line
  button .apply    'Create Sketches'   anchor bottom + right at xmax form-17     ymax+0.5  callback '!this.apply()'


-- End of form definition
exit
------------------------------------------------------------------------
--
-- Method:      pipeSketches
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pipeSketches()

  -- Set the gadget pixmaps
  !this.forward.addPixmap(!!pml.getPathName('downarrow16.png'))
  !this.back.addPixmap(!!pml.getPathName('uparrow16.png'))

  -- Set the list pop-up menu
  !this.list.setPopup(!this.listPopUp)

  -- Heading For list gadget
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Valid')
  !headings.append('Sketch')
  !headings.append('Drawn')
  !this.list.setHeadings(!headings)

  -- Heading For status filter gadget
  !headings = ARRAY()
  !headings.append('Any')
  !headings.append('Valid')
  !headings.append('Not Valid')
  !this.statusOption.dtext = !headings

  -- Heading For drawn filter gadget
  !headings = ARRAY()
  !headings.append('Any')
  !headings.append('Created')
  !headings.append('Not Created')
  !this.drawnOption.dtext = !headings

endmethod
-- End of method definition for .pipeSketches()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:  Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Element to be actioned on
  !this.actionElement = !!ce

  -- Show ce as the element
  !this.ceName.val   = !this.actionElement.name

  -- Read the defaults file from previous time this function was run
  !defaults = ARRAY()
  !defaults = !this.readDefaultFile()
  if (!defaults.size() eq 3) then
    !this.registry.val = !defaults[1]
    !this.template.val = !defaults[2]
    !this.logFile.val  = !defaults[3]
  else
    !this.template.val = !!pipeSketch.selectedTemplate.name.string()
    handle ANY
      -- In case it is not set at all
    endhandle
    !this.logFile.val  = !!pipeSketch.logFile.string()
  endif

  -- Run the gadget validation
  !this.validateCeName(!this.ceName, 'unused')

  -- Populate the list gadget with all the spools of the ce
  !this.search()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  if (!!module().appName eq 'MarineDrafting') then
    import 'marapi'
    handle( 1000, 0 )
    -- This error means that the module has already been imported,
    -- ignore this error and continue.
    endhandle
  endif

  !memory = !!ce

  -- Initialise variables
  !allSpools = ARRAY()

  -- Array of selected spools
  !selectedSpools = !this.list.val

  -- Get spools for the selected element
  !allSpools = !this.list.selection('rtext')
  !numberOfSpools = !allSpools.size()

  -- Stop if no spools selected
  if (!numberOfSpools eq 0) then
    !!alert.error('No Pipe Spools selected')
    return
  endif

  if (!!module().appName eq 'MarineDrafting') then
    -- If Marine, then check if there is a modified drawing opened
    -- and the ask the user to save or not save before close the drawing.
    using namespace 'AVEVA.Marine.Drafting'

    !drafting = object MARDRAFTING()
    !answer   = 'YES'
    -- !drawingElement   = !sheet

    --Write 'openmarinesheet start...'

    if (!drafting.dwgCurrent()) then
    --
    -- Ask the user if he wants to save it
    --
       if (!drafting.dwgIsModified()) then
          !answer = !!alert.question( 'The opened drawing is modified. Do you want to save it before closing it?' )
       else
          !answer = 'NO'
       endif
       if ( !answer.eq('YES') ) then
    --
    --    Save the current drawing
    --
          !drafting.dwgSave()
       endif
       if ( !answer.eq('CANCEL') ) then
          return
       else
    --
    --    Close the current drawing and clean the display canvas
    --
          !drafting.dwgClose()
          --$P Pipe sketch creation, repaint canvas
          --!drafting.dwgRepaint()
       endif
    endif
  endif

  -- Set the global instance of the pipeSketch
  !this.validateCeName(!this.ceName, 'unused')
  !this.validateRegistry(!this.registry, 'unused')
  !this.validateTemplate(!this.template, 'unused')
  !this.validateLogFile(!this.logFile, 'unused')

  -- Set the global instance of the !!pipeSketch
  !this.registry(!this.registry.val)
  !this.template(!this.template.val)
  !this.logFile(!this.logFile.val)

  -- Record the global instance of the !!pipeSketch
  !this.writeDefaultFile()

  -- Navigate to the element to action on
  !!ce = $!this.actionElement

  -- switch a prompt on
  prompt 'Starting to generate Pipe Sketches'

  WARNINGS OFF

  -- Log progress - Put a start entry into the logfile
  var !clock clock
  !element   = !this.actionElement.name
  !createIn = !!pipeSketch.createIn.name
  !template = !!pipeSketch.selectedTemplate.name
  !!pipeSketchesLog('Pipe Sketching Log')
  !!pipeSketchesLog('=================================')
  !!pipeSketchesLog(' ')
  !!pipeSketchesLog('Starting the log file at $!clock')
  !!pipeSketchesLog('Element to be processed = $!element')
  !!pipeSketchesLog('Template being used for all drawings = $!template')
  !!pipeSketchesLog('All drawings being created in registry = $!createIn')
  !!pipeSketchesLog(' ')

  -- Log progress
  !!pipeSketchesLog('$!numberOfSpools drawings are to be created')
  !!pipeSketchesLog('----------------------------------')
  !!pipeSketchesLog(' ')

  -- ************* Pipe Sketches Code... ***********************

  -- Run drawing creation
  do !i indices !allSpools

    !spool = !allSpools[!i].dbref()

    -- Log progress
    prompt 'Generate Pipe Sketch $!i of $!numberOfSpools'
    var !clock clock
    !!pipeSketchesLog('Generating Pipe Sketch $!i of $!numberOfSpools for $!spool.fullName - $!clock')

    -- ******** This is the command that does all the work (Batch would call this per spool) ************
    !!processPipeSketches(!spool)

    -- For debugging only
--    !this.trace(!spool)

    -- Log progress
    var !clock clock
    !!pipeSketchesLog('*Completed Pipe Sketch $!i of $!numberOfSpools for $!spool.fullName - $!clock')
    !!pipeSketchesLog(' ')

  enddo

  -- Record the global instance of the !!pipeSketch (It could now have been updated)
  !this.writeDefaultFile()

  -- Log progress - Put an end entry into the logfile
  var !clock clock
  !!pipeSketchesLog('Ending the log file at $!clock')

  -- Open the log file
  !!pipeSketch.openLog()

  -- Write to the log file
  !!pipeSketch.writeLog()

  -- Close the log file
  !!pipeSketch.closeLog()

  -- Empty the log data array
  !!pipeSketch.emptyLogData()

  -- Refresh the spool list
  !this.search()

  if (!!module().appName eq 'MarineDrafting') then
     do !i indices !allSpools
       !spool = !allSpools[!i].dbref()
     enddo
     !answer = !!alert.question( 'Pipe sketches are created. Do you want to save work?' )
     if ( !answer.eq('YES') ) then
        SAVEWORK
     endif
  endif

  -- Try to select same again
  !this.list.val = !selectedSpools
  handle ANY
    -- paranoid or what
  endhandle

  -- Activate Gadgets if we should
  !this.activateGadgets()

  -- Switch off any prompts
  prompt dismiss

  WARNINGS ON

  !!ce = !memory
  handle ANY
    -- paranoid or what
  endhandle

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      registry
--
-- Description: Set the registry to store all the Pipe Sketches created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Element name to be used as the registry
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .registry(!registry is STRING)

  !!pipeSketch.createIn = !registry.dbref()

endmethod
-- End of method definition for .registry()
------------------------------------------------------------------------
--
-- Method:      template
--
-- Description: Set the template to be use for each Pipe Sketch drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Element name to be used as the template
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .template(!template is STRING)

  !!pipeSketch.selectedTemplate = !template.dbref()

endmethod
-- End of method definition for .template()
------------------------------------------------------------------------
--
-- Method:      logFile
--
-- Description: Set the log File to record each Pipe Sketch process
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      File name to be used as the log file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .logFile(!filename is STRING)

  !!pipeSketch.logFile = object FILE(!filename)

endmethod
-- End of method definition for .logFile()
------------------------------------------------------------------------
--
-- Method:      setLogFile
--
-- Description: Set the log File and log file gadget to record each Pipe Sketch process
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      File name to be used as the log file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLogFile(!filename is STRING)

  !this.logFile.val = !filename
  !this.logFile(!this.logFile.val)

endmethod
-- End of method definition for .setLogFile()
------------------------------------------------------------------------
--
-- Method:      registryCE
--
-- Description: Set CE to be the registry to store all the Pipe Sketches created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .registryCE()

  -- Make sure we are in the Draft DB
  context draw

  -- Try to ascertain REGI
  !registry = REGI of ce
  handle ANY
    !registry = !!ce
  endhandle

  if (!registry.type eq 'REGI') then
    !this.registry.val = !registry.name
  else
    !!alert.error('Must be a registry(REGI) element')
    return
  endif

endmethod
-- End of method definition for .registryCE()
------------------------------------------------------------------------
--
-- Method:      templateCE
--
-- Description: Set CE to be the template to be use for each Pipe Sketch drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .templateCE()

  -- Make sure we are in the Draft DB
  context draw

  -- Try to ascertain DRWG or DRTMPL
  !derivedElement = DRWG of ce
  handle ANY
    !derivedElement = DRTMPL of ce
    handle ANY
      !derivedElement = !!ce
    endhandle
  endhandle

  if (!derivedElement.type eq 'DRWG' or !derivedElement.type eq 'DRTMPL') then
    !this.template.val = !derivedElement.name
  else
    !!alert.error('Must be a drawing template(DRWG or DRTMPL) element')
    return
  endif

endmethod
-- End of method definition for .templateCE()
------------------------------------------------------------------------
--
-- Method:      validateCeName
--
-- Description: Validate the input to the ceName gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateCeName(!gadget is GADGET, !dummyString is STRING)

  !s = !gadget.val.string().trim()
  -- Test if there is any input
  if (!s.length().eq(0)) then
    return error 1 'Invalid input in CE Name field'
  endif

  -- Test it is an existing dbref element
  !element = !s.dbref()
  handle ANY
    return error 1 'Invalid input in CE Name field'
  endhandle

  -- Try to ascertain ZONE or PIPE
  !derivedElement = PIPE of $!element
  handle ANY
    !derivedElement = ZONE of $!element
    handle ANY
      !derivedElement = !element
    endhandle
  endhandle

  -- test if the dbref is a ZONE or REGI element
  if (!derivedElement.type inset('ZONE', 'PIPE')) then
    -- OK
  else
    return error 1 'Must be a valid element in CE Name field (ZONE, PIPE)'
  endif

endmethod
-- End of method definition for .validateCeName()
------------------------------------------------------------------------
--
-- Method:      validateRegistry
--
-- Description: Validate the input to the registry gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateRegistry(!gadget is GADGET, !dummyString is STRING)

  !s = !gadget.val.string().trim()
  -- Test if there is any input
  if (!s.length().eq(0)) then
    return error 1 'Invalid input in Registry field'
  endif

  -- Test it is an existing dbref element
  !element = !s.dbref()
  handle ANY
    return error 1 'Invalid input in Registry field'
  endhandle

  -- Try to ascertain REGI
  !registry = REGI of $!element
  handle ANY
    !registry = !element
  endhandle

  -- test if the dbref is a REGI element
  if (!registry.type neq 'REGI') then
    return error 1 'Must be a registry(REGI) element in Registry field'
  endif

endmethod
-- End of method definition for .validateRegistry()
------------------------------------------------------------------------
--
-- Method:      validateTemplate
--
-- Description: Validate the input to the template gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateTemplate(!gadget is GADGET, !dummyString is STRING)

  !s = !gadget.val.string().trim()
  -- Test if there is any input
  if (!s.length().eq(0)) then
    return error 1 'Invalid input in Template field'
  endif

  -- Test it is an existing dbref element
  !element = !s.dbref()
  handle ANY
    return error 1 'Invalid input in Template field'
  endhandle

  -- Try to ascertain DRWG or DRTMPL
  !derivedElement = DRWG of $!element
  handle ANY
    !derivedElement = DRTMPL of $!element
    handle ANY
      !derivedElement = !element
    endhandle
  endhandle

  -- test if the dbref is a DRWG or DRTMPL element
  if (!derivedElement.type eq 'DRWG' or !element.type eq 'DRTMPL' ) then
    -- OK
  else
    return error 1 'Must be a drawing template(DRWG or DRTMPL) element in Template field'
  endif

endmethod
-- End of method definition for .validateTemplate()
------------------------------------------------------------------------
--
-- Method:      validateLogFile
--
-- Description: Validate the input to the log file gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateLogFile(!gadget is GADGET, !dummyString is STRING)

  -- Test if there is any input
  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input in Log File field'
  endif

  -- test if the input is a valid file element
  !file = object FILE(!gadget.val)
  handle ANY
    return error 1 'Invalid input in Log File field'
  endhandle

  -- test the file is an existing directory
  if (!file.exists() and !file.type() eq 'DIRECTORY') then
    return error 1 'Invalid input. Cannot be an existing Directory in Log File field'
  endif

endmethod
-- End of method definition for .validateLogFile()
------------------------------------------------------------------------
--
-- Method:      writeDefaultFile
--
-- Description: Write a default file so we can restore gadget settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeDefaultFile()

  !defaultFile = object FILE('%PDMSUSER%/PipeSketches.pmldat')
  !defaultFile.open('OVERWRITE')
  !defaultEntry[1] = !!pipeSketch.createIn.name
  !defaultEntry[2] = !!pipeSketch.selectedTemplate.name
  !defaultEntry[3] = !!pipeSketch.logFile.string()
  !defaultFile.writeFile('APPEND', !defaultEntry)
  !defaultFile.close()

endmethod
------------------------------------------------------------------------
--
-- Method:      readDefaultFile
--
-- Description: read the default file to restore defaults to gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readDefaultFile() is ARRAY

  !result = ARRAY()

  !defaultFile = object FILE('%PDMSUSER%/PipeSketches.pmldat')
  if (!defaultFile.exists()) then
    -- File should only be 3 lines long so lets just read that
    !result = !defaultFile.readFile()
  endif

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      listPopUpCallback
--
-- Description: Call back for the pop up menu on the spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .listPopUpCallback()

  if (!this.listPopUp.pickedField eq 'Select All') then
    !this.list.select('rtext', !this.list.rtext)
    !this.activateGadgets()
  elseif (!this.listPopUp.pickedField eq 'Clear Selection') then
    !this.list.clearSelection()
    !this.activateGadgets()
  elseif (!this.listPopUp.pickedField eq 'Display Sketch') then
    !this.displaySketch('SELECTED')
  elseif (!this.listPopUp.pickedField eq 'Print Sketch') then
    !this.printSketch('SELECTED', 'ALL')
  elseif (!this.listPopUp.pickedField eq 'Delete Sketch') then
    !this.deleteSketch('SELECTED')
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      displaySketch
--
-- Description: Display sketch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word BACK, SELECTED or FORWARD
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySketch(!option is STRING)

  -- What is selected at the moment
  !pickedField = 0
  !index = !this.list.val.size()
  if (!index gt 0) then
    !picked = !this.list.val
    !pickedField = !picked[!index]
  endif

  if (!option eq 'BACK') then
    if (!pickedField gt 1) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField - 1])
      !this.displaySketch('SELECTED')
      !this.activateGadgets()
    endif
  elseif (!option eq 'FORWARD') then
    if (!pickedField lt (!this.list.rtext.size())) then
      !this.list.clearSelection()
      !this.list.select('rtext', !this.list.rtext[!pickedField + 1])
      !this.displaySketch('SELECTED')
      !this.activateGadgets()
    endif
  endif

  -- Make the apply active
  if (!option eq 'SELECTED') then
          -- OK so how many selections have a existing sketch
    !count = 0
    do !sel values !this.list.selection('dtext')
      !testForDrawing = !sel.part(3).dbref()
      handle ANY
        -- This must not have an existing sketch
      elsehandle NONE
        !count = !count + 1
      endhandle
    enddo
    -- Do a check on how many sheets are being opened and ask for confirmation if many
    if (!count eq 0) then
      !!alert.message('No available sketches selected!')
      return
    elseif (!count gt 1) then
      if !!module().modKey.upCase().eq('MARDRA') then
        !!alert.message('You can only display 1 selected sketch. Displaying the first selected...')
        -- Get the first and refresh list with one selection
        !first = !this.list.selection('rtext')[1]
        !this.list.clearSelection()
        !this.list.select('rtext', !first)
      else
        !answer = !!alert.confirm('Open ' &  !this.list.selection('dtext').size().string() & ' selected sketches?')
        if (!answer.boolean().not()) then
          return
        endif
      endif
    endif
    do !sel values !this.list.selection('dtext')
      -- Get the drawing name
      !drawing = !sel.part(3)
      !sheet = !!dtbMemberOfType(!drawing.dbref(), 'SHEE', 1).name
      handle ANY
        skip
      endhandle
      -- Add the sheet to the standard system
      if !!module().modKey.upCase().eq('MARDRA') then
        !!openMarineSheet('', !sheet.dbref())
      else
        call !!runMacro(|%PDMSUI%/DRA/CLIB/UELEMSEL|, !sheet)
        handle ANY
          skip
        endhandle
      endif
    enddo
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search for the Spools to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .search()

  --Initialise variables
  !processedBefore = ARRAY()
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Collect all the spools
  var !allSpools collect all PSPOOL for $!this.actionElement

  !nameFilterString = !this.nameFilter.val.trim().lowcase()
  -- if '*', turn to empty string to speed up processing
  if (!nameFilterString eq '*') then
    !nameFilterString = ''
  endif
  !nfsLength = !nameFilterString.length()
  !statusOptionSelection = !this.statusOption.selection()
  !drawnOptionSelection = !this.drawnOption.selection()

  do !spool values !allSpools

    -- Reference
    !spRef = !spool.dbref()
    !reference = !spRef.string()
    -- Name
    !name = !spRef.name
    if (!nfsLength gt 0) then
      skip if (!name.lowcase().matchwild(!nameFilterString).not())
    endif

    -- Valid
    !valid = !spRef.psvld.string()
    if (!statusOptionSelection eq 'Valid') then
      skip if (!valid.upCase() eq 'FALSE')
    elseif (!statusOptionSelection eq 'Not Valid') then
      skip if (!valid.upCase() eq 'TRUE')
    endif

    -- Processed Sketch
    if (dbtype neq 'PADD') then
      switch
    endif
    !drawingTitle = 'Pipe Sketch - Spool ' & !spRef.namn
    var !processedBefore collect all DRWG with (TITLE eq '$!drawingTitle')
    !pbSize = !processedBefore.size()
    if (!pbSize gt 0) then
      !sketch = 'TRUE'
      !pbRef = !processedBefore[1].dbref()
      !sketch = !pbRef.name
      if (!pbSize gt 1) then
        !drawn  = !pbSize.string() & ' times'
      else
        !drawn  = !pbRef.date
      endif
    else
      !sketch = 'FALSE'
      !drawn = '---'
    endif
    if (!drawnOptionSelection eq 'Not Created') then
      skip if (!sketch.upCase() neq 'FALSE')
    elseif (!drawnOptionSelection eq 'Created') then
      skip if (!sketch.upCase() eq 'FALSE')
    endif

   -- Report a Warning if an invalid spool is drawn
   if (!valid.boolean().not()) then
     if (!drawn neq '---') then
       !!pipeSketchesLog('*** Warning - ' & !name & ' Pipe Spool is NOT valid - Check Drawing!')
     endif
   endif

    -- Display the elements
   !rtext.append(!reference)
   !theDText = !name & '	' & !valid & '	' & !sketch & '	' & !drawn
   !dtext.append(!theDText)

  enddo

  -- Populate the gadget
  !this.list.dtext = !dtext
  !this.list.rtext = !rtext
  -- Display number found by search
  !this.list.tag = 'Search Results:  ( ' & !dtext.size().string() & ' found )'

  -- Make the apply active
  !this.activateGadgets()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      activeApply
--
-- Description: Activate the apply gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activeApply()

  -- Make the apply active
  if (!this.list.selection('rtext').size() eq 0) then
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod
-- End of method
