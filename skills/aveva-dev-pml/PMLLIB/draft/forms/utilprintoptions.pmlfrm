--
--
-- Description:     Options form for the Print CE command
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(BOOLEAN)                    -                   Form initialisation before showing
--  print(BOOLEAN)                   -                   Routine to print the current picture element
--  utilPrintOptions()               -                   Constructor method
--
------------------------------------------------------------------------
setup form !!utilPrintOptions dialog docking size 20 10
  path down
  -- min line width is no longer used by core draft - line widths defined precisely in PADD(user defined) or system DB (system linestyles)
  --text .mlw 'Minimum pen line width' tagwidth 15 width 4 is REAL format !!realFmt
  frame .cc ' Colour correction mode ' width 22
    rtoggle .cc1 'Standard'
    rtoggle .cc2 'Colour Plus'
    rtoggle .cc3 'Greyscale'
    rtoggle .cc4 'Black && White'
  exit
  frame .print 'Print CE...' width 22
    button .btnUnscaled 'Not scaled' callback '!this.print(false)' width 8
    button .btnFit at xmax.cc - 10   ymin 'Fit to page' callback '!this.print(true)' width 8
  exit
exit

------------------------------------------------------------------------
--
-- Method:      .utilPrintOptions()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .utilPrintOptions()
  !this.firstShownCall = '!this.init(true)'
  !this.initCall = '!this.init(false)'
  !this.formTitle = 'Print CE'
  !this.cc.val = 1
  --!this.mlw.validateCall = '!this.validateMLW()'
  --!this.mlw.val = 0.22
endmethod
-- End of method definition for .utilPrintOptions()

