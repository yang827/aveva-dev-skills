------------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Routine to print the current picture element
--
-- Method Type: Procedure
-- Arguments:
--  1  R  BOOLEAN  True, if the picture should be fit to the page, False for the print not to scale
-- Return:
--
------------------------------------------------------------------------
define method .print(!fitToPage is BOOLEAN)
  -- check for valid element navigation
  !types = 'VIEW, SHEET, BACK, OVER, LALB, SYLB, ISOLB, or SHTMPL'
  !typeArr = !types.replace('or ', '').split(',')
  !err = true
  do !type values !typeArr
    $!type
    handle ANY
    elsehandle None
      !err = false
      break
    endhandle
  enddo
  if( !err ) then
    !!alert.error('You must be at or below a $!types')
    return
  endif

  --!mlw = !this.mlw.val.string(!!realFmt)
  !cc = !this.cc.val
  if( !cc.eq(1) ) then
    !ccOpt = 'STANDARD'
  elseif( !cc.eq(2) ) then
    !ccOpt = 'COLOURPLUS'
  elseif( !cc.eq(3) ) then
--   best leave it mis-spelt as grAyscale as this is a keyword supplied to the PLOT command
    !ccOpt = 'GRAYSCALE'
  else
    !ccOpt = 'BW'
  endif
  --!options = 'MINL $!mlw, COL $!ccOpt'
  !options = 'COL $!ccOpt'
  if( !fitToPage ) then
    !options = !options & ', REDUCE, EXPAND'
  endif
  !ce = FLNM
  !type = TYPE
  !tag = !this.cc$!cc$n.tag.replace('&&', '&')
  --prompt 'Printing $!type $!ce (minimum pen line width $!mlw, colour mode $!tag) ...'
  prompt 'Printing $!type $!ce (colour mode $!tag) ...'
  PLOT CE FILE PRINT '$!options'

  prompt ''
endmethod
