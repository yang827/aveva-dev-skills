--   Group:         ADP
--     Keyword:     GEN
--   Module:        Type 4 annotation
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Thu Jun 12 07:36:25 1997
--
--
-- Description:
-- Routine to generate type 4 ADP annotation for steelwork GAs
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       View being annotated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adpAnno4(!view is DBREF)

  -- Local variable definitions
  !dimRule   = STRING()          $* rule to COLLECT members for dimensioning
  !dimRules  = ARRAY()           $* array of dimensioning rules
  !members   = ARRAY()           $* array of steelwork members in VIEW volume
  !ewMembers = ARRAY()           $* array of steelwork members in EW orientation
  !nsMembers = ARRAY()           $* array of steelwork members in NS orientation
  !noMembers = ARRAY()           $* array of steelwork members in Non-Orthogonal orientation
  !ewEval    = ARRAY()           $* array of evaluated steelwork members in EW orientation
  !nsEval    = ARRAY()           $* array of evaluated steelwork members in NS orientation
  !from      = object POSITION() $* 'From' pos for view volume
  !to        = object POSITION() $* 'To'   pos for view volume
  !union     = ARRAY()           $* union array for EW and NS arrays

  -- BLOCK definitions
  !extractEw = object BLOCK('(!members[!evalIndex].ori.wrt(World).zDir().east.nint() eq 1) or (!members[!evalIndex].ori.wrt(World).zDir().east.nint() eq -1)')
  !extractNs = object BLOCK('(!members[!evalIndex].ori.wrt(World).zDir().north.nint() eq 1) or (!members[!evalIndex].ori.wrt(World).zDir().north.nint() eq -1)')

  -- validate view
  if (!view.unset() or !view.badRef()) then
    !!alert.error('[adpAnno4] Invalid VIEW argument')
    return
  endif

  -- collect all members in view volume using rules

    -- get view volume
    call !!viewVolume(!view,!from,!to)

    -- copy contents of dimension rule list into local array
    !dimRules = !!adpDef4.dimRules.dText
    do !dimRule values !dimRules
      !members = !!collectAllWithin(!!adpDef4.dimTypes.val, !dimRule, !from, !to, 'WORL')
    enddo

  -- filter out element not in view's drawlist
  var !savePos REF
  $!view
  do !elem values !members
    -- -----got here......and then it was time to leave!
  enddo


  -- evaluate all members having an E/W orientation
  !ewEval = !members.evaluate(!extractEw)

   !highlight = !!alert.confirm('Highlight East/West members ?')

    -- build array of EW members
    do !ptr index !ewEval
      if (!ewEval[!ptr]) then
        !ewMembers.append(!members[!ptr])
        var !elem '$$!members[$!ptr]'
        if (BOOLEAN(!highlight)) then
          HIGHLIGHT $!elem IN _cdrCadcGa1_N1
          handle any
            !!alert.error($!!error.text)
          endhandle
         endif
      endif
    enddo


  -- evaluate all members having an N/S orientation
  !nsEval = !members.evaluate(!extractNs)

    !highlight = !!alert.confirm('Highlight North/South members ?')

    -- build array of NS members
    do !ptr index !nsEval
      if (!nsEval[!ptr]) then
        !nsMembers.append(!members[!ptr])
        var !elem '$$!members[$!ptr]'
        if (BOOLEAN(!highlight)) then
          HIGHLIGHT $!elem IN _cdrCadcGa1_N1
          handle any
            !!alert.error($!!error.text)
          endhandle
         endif
      endif
    enddo


    -- build array containing all remaining non-orthogonal members

    -- Union EW and NS arrays
    !union = !ewMembers.union(!nsMembers)

    -- difference of !members and EW/NS arrays
    !noMembers = !members.difference(!union)

   !highlight = !!alert.confirm('Highlight Non-orthogonal members ?')

    -- highlight Non-orthogonal members
    do !elem values !noMembers
      if (BOOLEAN(!highlight)) then
        HIGHLIGHT $!elem IN _cdrCadcGa1_N1
        handle any
          !!alert.error($!!error.text)
        endhandle
      endif
    enddo


  -- call dimensioning routine for each ortho direction

    --call !!adpMainDim4('East/West',!ewMembers)
    --call !!adpMainDim4('North/South',!nsMembers)

$!savePos

endfunction
-- End of function definition for !!adpAnno4
