--
--
-- Description:
-- action routine for adpDeveloper form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Call mode:
--                           TRACK - track PADDCE for current VIEW
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adpDeveloperAct(!mode is STRING)


  if (!mode eq 'TRACK') then

    !view = object DBREF()

    !view = VIEW
    handle none
      !!adpDeveloper.view.val = !view.name
      !!adpDeveloper.trackedView = !view
    elsehandle any
    endhandle

  endif

endfunction
-- End of function definition for !!adpDeveloperAct
