-- File:            appdrasetbackground.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Set Drawing Application Canvas Background
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View Area gadget to modify
--    2   R      BOOLEAN     Whether to select the colour from the palette
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!appDraSetBackground(!viewGadget is GADGET, !select is BOOLEAN)

  -- Initialise variables
  !code = !viewGadget.background

  -- set default colour
  if (!code.unset()) then
    var !col COLOUR NUMBER GREY
    !colCode = !col.real()
  else
    !colCode = !code
  endif

  -- Select a colour
  if (!select) then

    -- check here for the colour selection form and load it if necessary.
    if (undefined(!!colourSelect)) then
      pml load form !!colourSelect
    endif

    -- Set Colour Code
    call !!colourSelectSet(!colCode)

    -- set colour to return to when reset button clicked
    !!colourSelect.original = !colCode

    -- Set the form title
    !!colourSelect.formTitle = 'Background Colour'

    -- Set Action
    !!colourSelect.action = '!!appDraSetBackground(' & !viewGadget.fullname() & ', false)'

    -- Show form
    show !!colourSelect

  else

    -- Get colour number
    !colour = !!colourSelectGet()

    -- Get colour name
    VAR !colourName COL $!colour

    -- Set the background colour
    if !colour.eq(15) then
      !viewGadget.background = 305
    elseif !colour.eq(10) then
      !viewGadget.background = 306
    else
      !viewGadget.background = !colour
    endif

    -- If the background that the view gadget is being changed to is black/white and the another view gadget is shown and has
    --a background colour of black/white then change the background colour of that gadget as well.
    if (!colourName.upcase().eq('BLACK') or !colourName.upcase().eq('WHITE') or !colourName.upcase().eq('WHITESMOKE')) then
      if !viewGadget.fullname().eq('!!CDRCADCGA1.N1') then
        if defined(!!cdrCadcGa2) then
          !altColour = !!cdrCadcGa2.n1.background
          var !altColourName COL $!altColour
          if (!altColourName.upcase().eq('BLACK') or !altColourName.upcase().eq('WHITE') or !altColourName.upcase().eq('WHITESMOKE')) then
            !!cdrCadcGa2.n1.background = !viewGadget.background
            --Highlighting colour for the alternate view needs changing from white to black and vice versa according to the background colour.
            if !colourName.upcase().eq('BLACK') then
              !!cdrCadcGa2.n1.highlight = 306
            elseif !colourName.upcase().eq('WHITE') or !colourName.upcase().eq('WHITESMOKE') then
              !!cdrCadcGa2.n1.highlight = 305
            endif
          else
            !!cdrCadcGa2.n1.highlight = 306
          endif
        endif
      elseif !viewGadget.fullname().eq('!!CDRCADCGA2.N1') then
        if defined(!!cdrCadcGa1) then
          !altColour = !!cdrCadcGa1.n1.background
          var !altColourName COL $!altColour
          if (!altColourName.upcase().eq('BLACK') or !altColourName.upcase().eq('WHITE') or !altColourName.upcase().eq('WHITESMOKE')) then
            !!cdrCadcGa1.n1.background = !viewGadget.background
            --Highlighting colour for the alternate view needs changing from white to black and vice versa according to the background colour.
            if !colourName.upcase().eq('BLACK') then
              !!cdrCadcGa1.n1.highlight = 306
            elseif !colourName.upcase().eq('WHITE') or !colourName.upcase().eq('WHITESMOKE') then
              !!cdrCadcGa1.n1.highlight = 305
            endif
          else
            !!cdrCadcGa2.n1.highlight = 306
          endif
        endif
      endif
    endif

    -- Change White colour depending on background colour
    -- P-30249: logic here is wrong - it's not symmetrical.
    -- Can remove the 'BLACK' case as now identical to default
    --if (!colourName.upcase().eq('BLACK')) then

    --  COLOUR 10 WHITE

      ----COLOUR 15 WHITE
      --COLOUR 15 BLACK

      --SETFEED COL DEF

      --!viewGadget.highlight = 306

    --else

    if (!colourName.upcase().eq('WHITE') or !colourName.upcase().eq('WHITESMOKE')) then

      COLOUR 10 BLACK

      --COLOUR 15 BLACK 10 & 15 must be different, so...
      COLOUR 15 WHITE

      SETFEED COL BRIGHTRED

      --If the background colour is white then we must change the highlighting colour from white to black.
      !viewGadget.highlight = 305

    else

      COLOUR 10 WHITE

      COLOUR 15 BLACK

      SETFEED COL DEF

      !viewGadget.highlight = 306

    endif

  endif

endfunction
-- End of function !!appDraSetBackground
