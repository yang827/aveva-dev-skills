--
--
-- Description:
-- Function to track ce changes to be shown in 3D section planes form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!dra3dviewsectionstrack()

  !memory = !!ce

  if (!!ce.type eq 'FPLA' or !!ce.type eq 'SPLA' or !!ce.type eq 'PPLA' or !!ce.type eq 'WPOS') then
    -- OK
  else
    return
  endif

  if (!!ce.type eq 'WPOS') then
    !ref = !!ce.owner.reference.string()
  else
    !ref = !!ce.reference.string()
  endif
  -- Try and select the section plane in the section plane form
  !!dra3dViewSections.list.clearSelection()
  !!dra3dViewSections.list.select('rtext', !ref)
  handle ANY
  endhandle

  -- Run the list callback
  !!dra3dViewSections.setActives()

  !!ce = !memory

endfunction
-- End of function definition for !!dra3dviewsectionstrack
