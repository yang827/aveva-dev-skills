-- Created:         Mon Apr 26 14:14:31 GMT 2004
--
--
-- Description:
-- Function to be post run when the explorer adds 3D to 3D view,
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draaddto3dview(!element is ANY)

  !memory = !!ce
  !objectType = !element.objectType()

  if (defined(!!dra3dView)) then
    if (!!dra3dView.shown()) then
      -- Test validity of current Sheet
      if(!!dra3dView.formTitle eq '3D View - No associated view') then
        !test = FALSE
      else
        !test = TRUE
      endif
      if (!objectType eq 'STRING') then
        if (!element.dbref().type eq 'PLLB' or (!element.dbref().type neq 'WORL' and !element.dbref().owner.type eq 'PLLB')) then
          if (defined(!!dra3dViewSections) and !!dra3dViewSections.shown()) then
            !!dra3dViewSections.initialise(TRUE)
          endif
        else
          if (!!dra3dView.explorerAddIdlist and !test) then
            !!ce = !element.dbref()
            !!dra3dView.viewAdd()
          endif
        endif
      else
        -- We must have an array of dbrefs passed in !element
        if (!!dra3dView.explorerAddIdlist and !test) then
          !!dra3dView.viewAdd(!element)
        endif
      endif
    endif
  endif

  !!ce = !memory

endfunction
-- End of function definition for !!draaddto3dview
