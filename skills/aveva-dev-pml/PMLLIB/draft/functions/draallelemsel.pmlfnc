--
--
-- Description:
-- Function to add all sheets from a drawing hierarchy level.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draAllElemSel()

  -- set the owner search
  !element = !!ce

  -- get the drwg dbref
  !climbToDrwg = !!dtbGetOwnerType(!element, 'DRWG')

  if(!climbToDrwg.unset()) then

    return error 1 'You must be at a drawing or below to add all sheets.'

  else

    VAR !sheets2 COLL ALL SHEE FOR $!climbToDrwg

    !sheets = object ARRAY()
    !mDrawCount = 0
    do !i values !sheets2
      if (!i.dbref().acPicture.upcase() eq 'OFF') then
         !sheets.append(!i)
      else
         !mDrawCount = !mDrawCount + 1
      endif
    enddo

    !mCount = !sheets.size()

    if (!mCount eq 0 and !mDrawCount gt 0) then
       !!ce = !element
       return error 2 'Cannot display any sheets under the current drawing as they can only be accessed using AVEVA E3D Draw'
    endif

    -- if more than 1 sheet check first, otherwise just add it
    if(!mCount.gt(1) or (!mCount.eq(1) and !mDrawCount.gt(0)) ) then

      -- initialise confirm form for this question
      !answer   = FALSE
      if (!mDrawCount eq 0) then
         !question = 'Do you wish to add all sheets of the current drawing to the view?'
         !remember = '!!draAllSheets'
      else
         !question = 'AVEVA E3D Draw sheets will be skipped. Do you wish to add the other sheets to the view?'
         !remember = '!!draAllSheets2'
      endif
      !!comAlertOnce(!question, !answer, !remember, 'CONFIRM')

      -- add all sheets if yes
      if($!remember and !answer or !answer) then
        !alert = 'YES'
      else
       !alert = 'NO'
      endif

    else

      !alert = 'YES'

    endif

    if(!alert.eq('YES')) then

      do !i values !sheets

        !!runSynonym('CALLIBM UELEMSEL $!i')

        -- Load all notes and views using the main form layer control object
        !!cdrGenApp.layerControl.getNotesViews(!i, true)

      enddo

    endif

    -- return to drwg
    !!ce = !element

  endif

endfunction
-- End of function definition for !!draAllElemSel()
