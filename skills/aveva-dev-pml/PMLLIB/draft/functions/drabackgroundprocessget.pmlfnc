--
--
-- Description:
-- Function to get Background Process Results at current element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Element key word could be CE, WORLD
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draBackgroundProcessGet(!element is STRING)

  !memory = !!ce

--  clock init

  if (!element.lowcase() eq 'ce') then
    var !collect collect all views for ce
  elseif (!element.lowcase() eq 'world') then
    world
    var !collect collect all views for ce
  else
    -- Unexpected argument
  endif
  do !i indices !collect
    !!ce = !collect[!i].dbref()
    write 'update refresh $!!ce.name '
    update refresh
  enddo
  -- $!i views refreshed.

--  clock read
  !!ce = !memory

endfunction
-- End of function definition for !!draBackgroundProcessGet
