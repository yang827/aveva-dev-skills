--
--
-- Description:
-- Function to call the correct macro for GLABs and SLABs
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Menu option selected]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draCallLabelMacro(!menuOption is STRING)

-- make sure the form is load
   if(undefined(!!draLabels)) then
     pml load form !!draLabels
   endif

   !!draLabels.ref = !!ce

-- switch off modify mode

   !!setModifyMode(!!cdrCadcGa1.n1)

-- do it from the current element, because the menus will be greyed out for anything else

!type = !!ce.type
if(!menuOption.upcase().eq('POSITION') and !type.eq('GLAB')) then
 !!draLabels.runMacro('CALLDRS MGPOS ATDEF')
elseif(!menuOption.upcase().eq('POSITION') and !type.eq('SLAB')) then
 !!draLabels.runMacro('CALLDRS MPOS ATDEF')
elseif(!menuOption.upcase().eq('BEND') and !type.eq('GLAB')) then
 !!draLabels.runMacro('CALLDRS UBENDPOS GLAB STRA')
elseif(!menuOption.upcase().eq('BEND') and !type.eq('SLAB')) then
 !!draLabels.runMacro('CALLDRS UBENDPOS SLAB STRA')
elseif(!menuOption.upcase().eq('CLEARANCE') and !type.eq('GLAB')) then
 !!draLabels.runMacro('CALLDRS MGPOS CLEDEF')
elseif(!menuOption.upcase().eq('CLEARANCE') and !type.eq('SLAB')) then
 !!draLabels.runMacro('CALLDRS MPOS CLEDEF')
elseif(!menuOption.upcase().eq('CPOF')) then
 !!draLabels.setAttribute('CPOF', 'STANDARD')
elseif(!menuOption.upcase().eq('APOF')) then
 !!draLabels.setAttribute('APOF', '0 0')
 endif

endfunction
-- End of function definition for !!draCallLabelMacro()
