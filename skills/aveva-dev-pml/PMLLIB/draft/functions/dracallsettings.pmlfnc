--
-- Description:
-- Function to set feedback or enhance colour, via the new settings form
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Feedback colour or Enhance colour]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draCallSettings(!mode is STRING)

-- in case the settings form has not been opened
   if(undefined(!!draSettings)) then
      pml load form !!draSettings
   endif

-- change the colour
   !!draSettings.setColour(!mode, true)

endfunction
-- End of function definition for !!draCallSettings()
