-- File:            drachangestyle.pmlfnc
--   Type:          Function Definition
--   Group:         Change Style
--     Keyword:     CHANGE
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Build form for Change Design Style Creation and Modification
--
------------------------------------------------------------------------
define function !!draChangeStyle(!formType is STRING)
  !upFormType = !formType.upCase()
  if( !upFormType.eq('DESIGN') ) then
    !isDesign = true
    !isAnnote = false
  elseif( !upFormType.eq('ANNOTE') ) then
    !isDesign = false
    !isAnnote = true
  else
    !isDesign = false
    !isAnnote = false
  endif

  setup form !!draChangeStyle at xr0 yr0
    -- Title
    if( !isDesign ) then
      !this.formTitle = 'Change Design Library'
    elseif( !isAnnote ) then
      !this.formTitle = 'Change Annotation Library'
    else
      return
    endif

    -- Other form bits
    !this.initCall = |!this.formMethods.init('$!formType')|
    !this.cancelCall = '!this.formMethods.dismiss()'

    -- Reset form for current element
    button .ce |CE| tooltip 'Current Element' call |!!draShowChange('!!draChangeStyle','NEW STYLE')|

    -- Element name
    para .rplbTex at xmax+1 ymin text |Library |
    para .rplb at xmax+1 ymin width 32 lines 1

    -- Styles
    if( !isDesign ) then
      list .styles |Styles| at x11 ymax+0.25 call |!this.formMethods.getStyleAtt()| width 70 length 8
    else
      list .styles |Styles| at x9 ymax+0.25 call |!this.formMethods.getStyleAtt()| width 70 length 8
    endif

    -- Style display mode
    para .modText at x0 ymin-0.2 text |Display|
    option .styMode at xmin ymax-0.18 tooltip 'Style Display Mode' call |!this.formMethods.stylDisplay()| width 5

    -- Create & Delete style
    button .createStyle |Create Style| at xmax.styles+1 ymin.styles+0.45 call |!this.formMethods.createStyle()|
    button .deleteStyle |Delete Style| at xmin ymax+0.2 call |!this.formMethods.deleteStyle()|

    -- Standard Pens
    if( !isDesign ) then
      !name[1] = 'FFPN|Frontface'
      !name[2] = 'BFPN|Backface'
      !name[3] = 'CLPN|Centre line'
      !name[4] = 'PLNP|P-line'
      !name[5] = 'MLNP|Member line'
      !name[6] = 'OBPN|Obscured line'
      !name[7] = 'OLPEN|Outline'
    else
      !name[1] = 'NLPN|Note line'
    endif
    !name.append('FPEN|Hatch pattern')

    !atY = 'ymax.styles+0.2'
    vdist 0
    do !paramString values !name
      !params = !paramString.split('|')
      !root = !params[1]
      !title = !params[2]
      !!draColStyle.setup(!root, 1, !title, 'at xmin.modText $!atY')
      !atY = 'ymax+0.1'
    enddo

    -- Text Pen, Font Pen, Underline and Brackets
    if( !isAnnote ) then

      -- Text pen
      frame .frTPEN at xmin.modText ymax+0.2 |Text| width_frFPEN
        !!draColStyle.setup('TPEN', 1, '')
        path right
        para .fontPara at xmin.FPENLS-0.5 ymin text |Font| width 4
        $M "%PDMSUI%/dra/gen/FFONTS" $<!!draChangeStyle$>

      -- Heading for representation
        para .repHead1  at xmin.TPEN ymax+0.7 text |Representation Flags:|
        path right

      -- Underline
        toggle .underOnOff |Underline| tagwidth 7

      -- Brackets
        option .brackets |Brackets| tagwidth 6 width 7
      exit

    endif

    -- Actions
    button .apply at x0 ymax+0.7 | Apply | call |!this.formMethods.apply()|
    button .dismiss at xmax form-size ymin |Dismiss| call |!this.formMethods.dismiss()| CANCEL

    -- Members
    member .formMethods is DRACHANGESTYLE
    member .rplbRefe is DBREF
    member .allStyle is ARRAY
    member .formType is STRING

    -- Set form in object
    !this.formMethods.form = !this
    !this.formType = !upFormType

    -- Populate style mode
    if( !isDesign ) then
      !dtext[1] = |Name|
      !dtext[2] = |Gen|
      !dtext[3] = |Pipe|
      !dtext[4] = |Steel|
      !dtext[5] = |Hatch|
      !rtext[1] = |NAME|
      !rtext[2] = |GEN|
      !rtext[3] = |PIPE|
      !rtext[4] = |STEEL|
      !rtext[5] = |HATCH|
    else
      !dtext[1] = |Name|
      !dtext[2] = |Gen|
      !dtext[3] = |Hatch|
      !dtext[4] = |Style|
      !rtext[1] = |NAME|
      !rtext[2] = |GEN|
      !rtext[3] = |HATCH|
      !rtext[4] = |STYLE|
    endif
    !this.styMode.dtext = !dtext
    !this.styMode.rtext = !rtext

    -- Populate Brackets
    if( !isAnnote ) then
      !dtext = ARRAY()
      !rtext = ARRAY()
      !dtext[1] = |Off|
      !dtext[2] = |Round|
      !dtext[3] = |Curly|
      !dtext[4] = |Square|
      !dtext[5] = |Angle|
      !rtext[1] = |NONE|
      !rtext[2] = |ROUND|
      !rtext[3] = |CURLY|
      !rtext[4] = |SQUARE|
      !rtext[5] = |ANGLE|
      !this.brackets.dtext = !dtext
      !this.brackets.rtext = !rtext
    endif

  -- End of form definition
  exit

-- End of function definition
endfunction
