--
--
-- Description:
-- Function to check how many characters would
-- be input to the command line from a textpane
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [Text pane to check]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draCheckTextSize(!textPane is GADGET) is STRING

-- initialise variables
  !text            = !textPane.val
  !countCharacters = 0
  !validText       = ''
-- find out how many characters are used (add 2 for each line for the '#/')
  do !i values !text
    !size = !i.length() + 2
    !countCharacters = !countCharacters + !size
  enddo

-- remove #/ from last line
  !total = !countCharacters - 2

-- Get draft max text length using pseudo attribute (not element specific)
!maxtext = DRMXTL
if(!total.gt(!maxtext)) then
-- find out cursor position of 'max' characters
  !count = 0
  do !i indices !text
  !save  = !count
  !count = !count + !text[!i].length() + 2

  if(!count.gt(!maxtext)) then
     !column  = !maxtext - !save
     !row     = !i
     !lastBit = !text[!i].substring(1,!column)
     break
  else
    !validText = !validText + !text[!i] + '#/'
  endif
  enddo
-- store the valid amount of characters
  !validText = !validText + !lastBit

-- set the cursor at the 'max text length' character
  !textPane.setCurPos(!row, !column)
  handle ANY
  -- in case max length character is at the end of the line
    !textPane.setCurPos(!row, !column - 1)
  endhandle

  !textPane.setfocus()

-- return the 'max length' characters to set
   return !validText

endif

endfunction
-- End of function definition for !!draCheckTextSize()
