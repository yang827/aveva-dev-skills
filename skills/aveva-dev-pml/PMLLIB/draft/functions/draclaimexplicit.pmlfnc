--
--
-- Description:
-- Function to ask the user if the selected sheet is to be claimed when adding
-- the view
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Element to claim if requested]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draClaimExplicit(!dbRef is DBREF)

-- check to see if the  element is in a db that is EXPLICIT claim
   !dbClaim  = !dbRef.dbClaim
   !dbAccess = !dbRef.dbAccess
   !type     = !dbRef.type
   !userC    = !dbRef.userC

-- determine the string for the type to make the question readable, and to clarify what is being claimed
   if(!type.eq('SHEE')) then
      !stringType = 'Drawing'
      !elemName   = !dbRef.owner.name
   elseif(!type.eq('BACK')) then
      !stringType = 'Backing Sheet'
      !elemName   = !dbRef.owner.name
   else
      !stringType = 'Sheet'
      !elemName   = !dbRef.name
   endif

-- ask the question for claiming if in an explicit DB
   if(!dbAccess.neq('UPDATE') and !dbClaim.eq('EXPLICIT')) then
      if(!userC.eq('')) then
        -- initialise confirm form for this question
        !question = !stringType + ' ' + !elemName + ' - is not claimed by you, do you want to claim it?'
        !answer   = FALSE
        !!comAlertOnce(!question, !answer, '!!draClaimQuest', 'CONFIRM')

        -- claim out the sheet if answer is yes
        if(!!draClaimQuest and !answer or !answer) then
          if(!type.eq('SHEE')) then
           !command = 'CLAIM owner of $!dbRef HIER'
          else
           !command = 'CLAIM $!dbRef HIER'
          endif
          $!command
          handle (2,614)
          -- (2,614) Unable to claim ... as already claimed by user ...
             error |Warning - $!!error.text|
          elsehandle (2,25)
          -- (2,25)  Read only DB
             error |Warning - unable to claim $!type $!dbRef.name - it is from a read-only database|
          elsehandle any
          -- Ignore other errors for now, likely ones are:
          -- (2,603) Element is already claimed by user
          -- (2,608) Only items in a MultiWrite or Controlled database etc
          endhandle
        endif
      endif
   endif

endfunction
-- End of function definition for !!draClaimExplicit()
