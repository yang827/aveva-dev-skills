--
-- Description:
-- Create change elements
--
------------------------------------------------------------------------
define function !!draCreateChange(!elemType is STRING, !arg is STRING)

  -- Access the last mem
  if (!!ce.mcount.neq(0)) then
    LAST MEM
  endif

  if (!elemType.upCase().eq('RPLB') and !arg.upCase().eq('LIBRARY')) then

    -- Load change rule form
    if (undefined(!!draChangeRule)) then
      !!loadForm ('draChangeRule')
      !!draChangeRule.formType = !arg.upCase()
    endif

    -- Create a change representation rule library
    $M "%PDMSUI%/DRA/CLIB/FCREATE" $<RPLB$> $<NO$>

    -- Set purpose
    SPPURP CHANGE

  elseif (!elemType.upCase().eq('CRST')) then

    -- Load change rule form
    if (undefined(!!draChangeRule)) then
      !!loadForm ('draChangeRule')
      !!draChangeRule.formType = !arg.upCase()
    endif

    -- Create a change representation rule library
    $M "%PDMSUI%/DRA/CLIB/FCREATE" $<CRST$> $<NO$> $<!!draShowChange('!!draChangeRule','$!elemType')$>

    -- Set purpose
    SPPURP CHANGE

  elseif (!elemType.upCase().eq('RPLB')) then

    -- Load change style form
    if (undefined(!!draChangeStyle)) then
      !!draChangeStyle(!arg.upCase())
    endif

    -- Create a representation rule library
    $M "%PDMSUI%/DRA/CLIB/FCREATE" $<RPLB$> $<NO$> $<!!draShowChange('!!draChangeStyle','$!arg')$>

    -- Set purpose
    SPPURP CHANGE

  endif

endfunction
