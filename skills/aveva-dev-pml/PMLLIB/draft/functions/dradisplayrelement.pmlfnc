--
--  Description:     Function to display read only draw able elements in the reference view.
--
----------------------------------------------------------------------

-- Function to display read only draw able elements in the reference view.
define function !!draDisplayRElement(!elementStr is STRING)

  --Make Sure We have a displayable element.
  !validEle  = 'OVER SHEE DRWG BACK SYLB SYTM LALB ISOLB SHTMPL'
  !selectedDbRef = !!dtbGetOwnerType(!elementStr.dbref(), !validEle)
  if !selectedDbRef.unset() then
    return
  endif

  !ref = !!ce
  !!ce = !selectedDbRef

  if(not(defined(!!cdrCadcGa2)) or !!cdrCadcGa2.shown().not()) then
    !!runSynonym('CALLDRG MSINGLEV')
  endif

  --CALLDRG MDISPPUT CE
  if(!selectedDbRef.set() and !selectedDbRef.type.eq('DRWG') and !selectedDbRef.mcount('SHEE').eq(1)) then
    !!ce = SHEE 1
  endif

  !!cdrCadcGa2.n1AddType = !!ce.type
  !!cdrCadcGa2.n1AddName = !!ce.name

  !newTitle = 'Reference Display' & '   ' & !!ce.type & '  ' & !!ce.name
  !newTitle = !newTitle & '   (Read Only)'

  !!cdrCadcGa2.formTitle = !newTitle
  edit !!cdrCadcGa2.n1 area
    put ce
    handle ANY
      exit
      return error
    endhandle
  exit

  !!cdrCadcGa2.hide()
  !!cdrCadcGa2.show('FREE')

  !!ce = !ref

endfunction
