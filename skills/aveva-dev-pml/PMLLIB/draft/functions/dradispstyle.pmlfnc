-- File:            dradispstyle.pmlfnc
--   Type:          Function Definition
--   Group:         Change Style
--     Keyword:     CHANGE
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Determine display strings for different combinations of style attributes
--
------------------------------------------------------------------------
define function !!draDispStyle(!allStyle is ARRAY, !group is STRING, !showType is BOOLEAN) is ARRAY

  -- Initialise variables
  !dispArray = ARRAY()
  !noneString = 'No attributes available'

  -- Test for none found
  if (!allStyle.size().eq(0)) then
    !dispArray.append('None')
  else

    -- Build display string for each style
    do !style val !allStyle

      -- Initialise
      !styleRefe = !style.dbref()
      !attlist   = !styleRefe.attlist
      if (!attlist.findFirst('DLEV').set()) then
        !showLevel = true
        !levelString = 'Level ' & !styleRefe.dlev
      else
        !showLevel   = FALSE
        !levelString = ''
      endif

      -- Show type in place of level
      if (!showType) then
        !showLevel = true
        !levelString = 'Type ' & !styleRefe.type
      endif
      -- Flag indicating, that !levelString is to be added BEFORE or AFTER the !stringToAdd
      !lsBefore = true
      !stringToAdd = ''

      -- Get data according to group
      if (!group.upCase().eq('GEN')) then
        -- Ffpn, Bfpn and Obpn
          if (!attlist.findFirst('FFSTYL').set() and !attlist.findFirst('BFSTYL').set() and !attlist.findFirst('OBSTYL').set()) then
            !ffPenString = ' FFStyle ' & !styleRefe.ffstyle
            if( !ffPenString.substring(-3,3).neq('Off') ) then
              !ffPenString = ' FFColour ' & !styleRefe.ffcolour & !ffPenString
            endif
            !bfPenString = ' BFStyle ' & !styleRefe.bfstyle
            if( !bfPenString.substring(-3,3).neq('Off') ) then
              !bfPenString = ' BFColour ' & !styleRefe.bfcolour & !bfPenString
            endif
            !obPenString = ' ObStyle ' & !styleRefe.obstyle
            if( !obPenString.substring(-3,3).neq('Off') ) then
              !obPenString = ' ObColour ' & !styleRefe.obcolour & !obPenString
            endif
            !stringToAdd  = !ffPenString & !bfPenString & !obPenString
        -- Tpen and Nlpn
          elseif (!attlist.findFirst('TXCOLO').set() and !attlist.findFirst('NLSTYL').set()) then
            !tPenString  = ' TxColour ' & !styleRefe.txcolour
            !nlpnString  = ' NLStyle ' & !styleRefe.nlstyle
            if( !nlpnString.substring(-3,3).neq('Off') ) then
              !nlpnString = ' NLColour ' & !styleRefe.nlcolour & !nlpnString
            endif
            !stringToAdd = !tPenString & !nlpnString
          endif
      elseif (!group.upCase().eq('NAME')) then
          !stringToAdd = !styleRefe.flnm & ' '
          !lsBefore = false
      elseif (!group.upCase().eq('PIPE')) then
          !tubeString  = ''
          !getCl = false
          if (!attlist.findFirst('TUFG').set() and !attlist.findFirst('CLFG').set() and !attlist.findFirst('CLSTYL').set()) then
          -- Get cl and tube pens depending on tube and cl flags
          if (!styleRefe.tubeFlag) then
              !tubeString = ' Tube On'
            endif
            !getCl = !styleRefe.cline
          elseif (!attlist.findFirst('CLSTYL').set()) then
            !getCl = true
          endif
          if( !getCl ) then
            !clPenString  = ' CLStyle ' & !styleRefe.clstyle
            if( !clPenString.substring(-3,3).neq('Off') ) then
              !clPenString  = ' CLColour ' & !styleRefe.clcolour & !clPenString
            endif
          else
            !clPenString = ''
          endif
          !stringToAdd = !tubeString & !clPenString
      elseif (!group.upCase().eq('STEEL')) then
        -- Profile, P-line pen and Member-line pen
          !profString   = ''
          !getPL = false
          if (!attlist.findFirst('PRFG').set() and !attlist.findFirst('PLNSTY').set()) then
          -- Get pline pen depending on profile flag
          if (!styleRefe.profile) then
              !profString = ' Prof On'
            endif
            !getPL = !styleRefe.plines
          elseif (!attlist.findFirst('PLNSTY').set()) then
            !getPL = true
          endif
          if( !getPL ) then
            !plnPenString = ' PLnStyle ' & !styleRefe.plnstyle
            if( !plnPenString.substring(-3,3).neq('Off') ) then
              !plnPenString = ' PLnColour ' & !styleRefe.plncolour & !plnPenString
            endif
          else
            !plnPenString = ''
          endif
        -- Mlpn
          if (!attlist.findFirst('MLNSTY').set()) then
            !mlnPenString  = ' MLnStyle ' & !styleRefe.mlnstyle
            if( !mlnPenString.substring(-3,3).neq('Off') ) then
              !mlnPenString  = ' MLnColour ' & !styleRefe.mlncolour & !mlnPenString
            endif
          else
            !mlnPenString = ''
          endif

          !stringToAdd = !profString & !plnPenString & !mlnPenString

      elseif (!group.upCase().eq('HATCH')) then
          !fPenString  = ''
          !olPenString = ''
        -- Fpen and Olpen
          if (!attlist.findFirst('FSTYLE').set() ) then
            !fPenString  = ' FStyle ' & !styleRefe.fstyle
            if( !fPenString.substring(-3,3).neq('Off') ) then
              !fPenString  = ' FColour ' & !styleRefe.fcolour & !fPenString
            endif
            if( !attlist.findFirst('OLSTYL').set() ) then
              !olPenString  = ' OLStyle ' & !styleRefe.olstyle
              if( !olPenString.substring(-3,3).neq('Off') ) then
                !olPenString  = ' OLColour ' & !styleRefe.olcolour & !olPenString
              endif
            endif
          endif
          !stringToAdd = !fPenString & !olPenString
      elseif (!group.upCase().eq('STYLE')) then
        -- Font, Brackets and Underline
          if (!attlist.findFirst('FONT').set() and !attlist.findFirst('BRACKE').set() and !attlist.findFirst('UNDERL').set()) then
          -- Font
            !fontString = ' Font ' & !styleRefe.font
          -- Brackets
          if (!styleRefe.brackets.eq('None')) then
            !bracketString = ''
          else
              !bracketString = ' Brackets ' & !styleRefe.brackets
          endif
          -- Underline
          if (!styleRefe.underline) then
              !underString = ' Underline On'
          else
            !underString = ''
          endif
            !stringToAdd = !fontString & !bracketString & !underString
          endif
      endif
      -- Collate the collected data
      if( !stringToAdd.empty() ) then
        if( !levelString.empty() ) then
          !dispArray.append(!noneString)
        else
          !dispArray.append(!levelString & ': ' & !noneString)
        endif
      elseif( !lsBefore ) then
        !dispArray.append(!levelString & !stringToAdd)
      else
        !dispArray.append(!stringToAdd & !levelString)
      endif
    enddo
  endif

  return !dispArray

endfunction
