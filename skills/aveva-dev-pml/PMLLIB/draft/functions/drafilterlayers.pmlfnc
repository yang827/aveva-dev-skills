--
-- Author:          A.kirkland
-- Created:         Mon Dec 1 11:00 GMT 2003
--
--
-- Description:
-- Function to filter the layers and repopulate the layer gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Filter keyword, ALL,DIM,LAB,DRA]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draFilterLayers(!filter is STRING, !navigate is BOOLEAN)

  -- save position
  !layer = !!cdrGenApp.layeNam.selection().dbRef()
    handle ANY
      return
    endhandle

  -- Check for a valid note or view
  if (!!cdrGenApp.notesViews.val.eq(0)) then
    return

  -- Set the layers
  else
    !!cdrGenApp.layerControl.setLayers(!filter)

  endif

  -- If the layer is unavailable
  if (!layer.unset()) then

    -- Populate the layer toolbar
    !!cdrGenApp.layerControl.populateToolbar(!filter, !!cdrGenApp.notesViews.val)

    -- Nothing else we can do so stop here
    return

  -- If the layer is available
  else

    -- see if the saved position can be reset
    -- remember to use fullname rather than dbref!
    !!cdrGenApp.layeNam.select('RTEXT', !layer.fullname)

    handle any

      -- Try and find a layer/vnot of the filter type on the current view from the list of layers
      if(!navigate.not()) then

        -- get the view of the current selected layer or vnot
        -- moved inside handle so it's not run if not needed
        if(!layer.type.neq('NOTE')) then
          var !viewName name of VIEW of $!layer
        else
          !viewName = !layer.name
        endif

        !allLayers = !!cdrGenApp.layeNam.rtext
        do !i indices !allLayers

          VAR !view NAME OF VIEW OF $!allLayers[$!i]
            handle ANY
              -- NOTEs do not live under a view
              skip

            elsehandle NONE

              if(!view.eq(!viewName)) then

                -- move this inside 'if (!view.eq(!viewName))' block so it's not done if view name doesn't match
                !appList  = 'DRA DIM LAB'

                if(!appList.match(!filter).neq(0)) then

                  -- also moved so purpose not found unless we need it
                  !itsPurp  = !!draGetItsPurp(!allLayers[!i].dbRef())
                  !purpTest = !!cdrPrpDflts.attribute(!filter).val.match(!itsPurp).gt(0)

                else
                  !purpTest = TRUE

                endif

                if(!purpTest) then

                  !!cdrGenApp.layeNam.select('RTEXT',!allLayers[!i])

                  if(!!ce.type.neq('VIEW')) then

                    !!ce = !!cdrGenApp.layeNam.selection().dbRef()
                      handle ANY
                        -- in case it's been deleted
                      endhandle

                  endif

                  break

                endif

              endif

            endhandle

        enddo

      endif

    endhandle

  endif

  -- set the visible gadget to LVIS value of selected
  !!draSetLvisGadget(!!cdrGenApp.layeNam.selection().dbRef())

endfunction
-- End of function definition for draFilterLayers(STRING)
