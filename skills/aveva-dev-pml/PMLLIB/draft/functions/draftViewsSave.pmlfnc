--
--
-- Description:
-- Function for saving the view settings in draft
-- to enable save and restore deprecation
--
------------------------------------------------------------------------
define function !!draftViewsSave()
!draForms = ARRAY()
if (defined(!!cdrcadcga1)) then
  !draForms.append( |!!cdrcadcga1| )
endif
if (defined(!!cdrcadcga2)) then
  !draForms.append( |!!cdrcadcga2| )
endif
!data = ARRAY()
do !formName values !draForms
  -- Set Borders
  !bord=$!<formName>.n1.borders
  !data.append( !formName & |.n1.borders = | & !bord )
  -- Set Highlight
  !high=$!<formName>.n1.highlight
  !data.append( !formName & |.n1.highlight = | & !high )
  -- Set Background
  !back=$!<formName>.n1.background
  !data.append( !formName & |.n1.background = | & !back )
  -- Set form title
  !formT=$!<formName>.formTitle
  !data.append( !formName & |.formTitle = | & |'| & !formT & |'| )
  -- Set add name
  !n1AddN=$!<formName>.n1addname
  if (!n1addN.unset().not()) then
    !data.append( !formName & |.n1AddName = | & |'| & !n1AddN & |'| )
  endif
  -- Set add type
  !n1AddT=$!<formName>.n1addtype
  if (!n1addT.unset().not()) then
    !data.append( !formName & |.n1AddType = | & |'| & !n1AddT & |'| )
  endif
  -- Add the element to the view
  !n1add=$!<formName>.n1addname
  if (!n1add.unset().not()) then
    !data.append ( |edit view | & !formName & |.n1 area| )
    !data.append ( |put | & !n1add )
    !data.append ( |handle any| )
    !data.append ( |endhandle| )
    !data.append ( |exit| )
    !data.append( |!limits = ARRAY()| )
    !lim=$!<formName>.n1.limits
    do !limit values !lim
      !data.append( |!limits.append(| & !limit & |)| )
    enddo
    !data.append( !formName & |.n1.limits = !limits| )
  endif
enddo

!module   = !!module().appkey
!project  = current project
!projCode = !project.code().lowcase()
var !mdb mdb
!mdb = !mdb.after('/')
!filename = '%PDMSUSER%\' & !module & '-' & !projCode & '-' & !mdb & '-gphviews.pmldat'

!file = object FILE(!filename)
!file.writeFile(|OVERWRITE|, !data)
