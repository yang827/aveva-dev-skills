-- Description:
-- Procedure to load all draft forms
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draftForms()

  -- Load all draft forms

  -- ADP Forms
  call !!loadForm('schedule')      $* schedule modification
  call !!loadForm('adpDef4')       $* adp type 4 defaults
  call !!loadForm('adpDeveloper')  $* adp developer form (AVEVA user only)

  -- DXF Forms not pre-loaded

endfunction
-- End of function definition for !!draftForms
