--
--
-- Description:     opens Rename form in Draft
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!draftRename()

  if (!!cdrName.shown().not()) then
    show !!cdrName
  else
    !!runSynonym('CALLDRG INAME')
  endif

endfunction
-- End of function definition
