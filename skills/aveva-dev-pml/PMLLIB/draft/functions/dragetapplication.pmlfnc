--
--
-- Description:
-- Function to find out the application of passed purpose
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Three letter WORD of the Purpose to check]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [Three letter WORD of the application (DIM,DRA,LAB)]
--
------------------------------------------------------------------------

-- Define function
define function !!draGetApplication(!purpose is STRING) is STRING

!application = ''

-- handle purpose unset
if(!purpose.eq('')) then
   return !application
endif
-- categorise the layer and find out group (DIM,LAB,DRA)
if(!!cdrPrpDflts.dim.val.match(!purpose).neq(0)) then
   !application = 'DIM'
elseif(!!cdrPrpDflts.lab.val.match(!purpose).neq(0)) then
   !application = 'LAB'
elseif(!!cdrPrpDflts.dra.val.match(!purpose).neq(0)) then
   !application = 'DRA'
endif

return !application
endfunction
-- End of function definition for draGetApplication(STRING)
