--
--
-- Description:
-- Read Change Rule criteria and style reference
--
------------------------------------------------------------------------
define function !!draGetCriteria(!ruleRefe is DBREF) is ARRAY

  -- Initialise variables
  !resultArray = ARRAY()
  !allArray = ARRAY()
  !allDesc = ARRAY()
  !menuNumber = REAL()

  -- Get criteria
  if (!ruleRefe.type.upCase().eq('ACRULE')) then

    -- Set variables
    !type = 'ANNO'
    !withSyntax = !ruleRefe.ascode.upCase()
    !styf = !ruleRefe.acstyf

  else

    -- Get criteria & styf
    VAR !string CRITERIA OF $!ruleRefe
    !styf = !ruleRefe.dcstyf

    -- Test for unset
    if (!string.upCase().eq('UNSET')) then

      -- Set as default
      !type = 'ELEMENTS'
      !withSyntax = ''
      !menuNumber = 1

    -- Test for criteria too long
    elseif (!string.eq('')) then

      -- Mark as too long to read
      !type = 'TOO LONG'
      !withSyntax = ''

    else

      -- Test type
      if (!string.match('WITH').neq(0)) then
        if (!string.before('WITH').occurs('ALL').neq(0)) then
          !type = 'ELEMENTS'
        else
          !type = 'NAMES'
          !allArray = !string.before('WITH').trim().split()
          !allDesc = !allArray
        endif
        !withSyntax = !string.after('WITH').trim().subString(2).trim()
        !withSyntax = !withSyntax.subString(1,!withSyntax.length() - 1).trim()
      else
        if (!string.occurs('ALL').neq(0) and !string.occurs('/ALL').eq(0)) then
          !type = 'ELEMENTS'
        else
          !type = 'NAMES'
          !allArray = !string.split()
          !allDesc = !allArray
        endif
        !withSyntax = ''
      endif

      -- Search for ALL part & determine menu global array
      if (!type.eq('ELEMENTS')) then

        -- Search for the ALL word and strip out the element type
        !bitArray = !string.before('WITH').split()
        do !index ind !bitArray

          -- Initialise variables
          !word = !bitArray[!index]

          -- When find the "ALL" word
          if (!word.eq('ALL')) then

            -- Get element description from the menu global arrays
            -- For each menu entry
            -- *** OLD PML SYNTAX
            do !number ind !!cdElemMenu

              -- For each menu option
              -- *** OLD PML SYNTAX
              !found = false
              do !menuString val !!cdElem$n$!number

                -- Test for "ALL" on its own
                if (undefined(!bitArray[!index + 1])) then

                  -- Test the word against the menu string
                  if (!menuString.split('\')[2].eq(!bitArray[!index])) then

                    -- Remember the menu number
                    if (undefined(!allArray[1])) then
                      !menuNumber = !number
                    endif

                    -- Add found word and menu description into the arrays
                    !allArray.append(!bitArray[!index])
                    !allDesc.append(!menuString.split('\')[1])

                    -- Done since menu word found
                    !found = true
                    break

                  endif

                else

                  -- Test for >1 words after the "ALL" e.g. ALL BRANCH MEMBERS
                  -- Taking care to test when the ")" does not exist
                  if (defined(!bitArray[!index + 2])) then
                    if (!bitArray[!index + 2].neq('ALL') and !bitArray[!index + 2].neq(')')) then
                      !testString = !bitArray[!index + 1] & ' ' & !bitArray[!index + 2]
                    else
                      !testString = !bitArray[!index + 1]
                    endif
                  else
                    !testString = !bitArray[!index + 1]
                  endif

                  -- Test the NEXT word against the menu string
                  if (!menuString.split('\')[2].eq(!testString)) then

                    if (undefined(!allArray[1])) then
                      !menuNumber = !number
                    endif
                    !allArray.append(!testString)
                    !allDesc.append(!menuString.split('\')[1])
                    !found = true
                    break
                  endif

                endif

              enddo

              -- Use only the first encountered entry and ignore the rest (some entries occur more than once)
              break if (!found)

            enddo

          endif

        enddo

      endif

    endif

  endif

  -- Build result array
  !resultArray.append(!type)
  !resultArray.append(!allArray)
  !resultArray.append(!allDesc)
  !resultArray.append(!withSyntax)
  !resultArray.append(!styf)
  !resultArray.append(!menuNumber)

  return !resultArray

endfunction
