--
--
-- Description:
-- Function to return the current displayed sheet name, retrieved from
-- the SHEET gadget on the main draft main.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [DBREF]     [Sheet name of the current displayed sheet]
--
------------------------------------------------------------------------
-- Define function
define function !!dragetcursheet() is DBREF

!dbRef = !!appDraMain.sheet.selection().dbRef()
handle ANY
   !dbRef = object DBREF()
endhandle

return !dbRef

endfunction
-- End of function definition for !!dragetcursheet()
