--
--
-- Description:
-- Function get any purposes from the GDP that are not in the 3 apps DIM,LAB,DRA
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [string of those purposes found]
--
------------------------------------------------------------------------

-- Define function
define function !!draGetGenPurps() is STRING
-- initialise variables
  !purpTest    = !!cdrPrpDflts.attribute('DIM').val
  !purpTest    = !purpTest + ' ' + !!cdrPrpDflts.attribute('DRA').val
  !purpTest    = !purpTest + ' ' + !!cdrPrpDflts.attribute('LAB').val

  !genList     = !!cdrPrpDflts.attribute('GDP').val.split()
  !list        = ''

do !i values !genList

   if(!purpTest.match(!i).eq(0)) then
      !list = !list + !i
   endif

enddo

return !list

endfunction
-- End of function definition for draGetGenPurps()
