--
--
-- Description:
-- Function get the purpose from a VNOT, LAYER or NOTE.
-- The purpose of a layer is on the layer itself.
-- The purpose of a VNOT is on the owning layer
-- The purpose of a NOTE, is self explanatory (NOT)
-- The return is the 3 letter code of the Purpose
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Dbref of the element to get the purpose]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [string of  purpose]
--
------------------------------------------------------------------------

-- Define function
define function !!draGetitsPurp(!dbRef is DBREF) is STRING

-- determine the type of element
   !type = !dbRef.type

-- get the purpose from the element
   if(!type.eq('LAYE')) then
      !purpose = !dbRef.purp.substring(1,3)
   elseif(!type.eq('VNOT')) then
      !purpose = !dbRef.owner.purp.substring(1,3)
   elseif(!type.eq('NOTE')) then
      !purpose = 'NOT'
   else
      !purpose = ''
   endif

   return !purpose

endfunction
-- End of function definition for draGetitsPurp()
