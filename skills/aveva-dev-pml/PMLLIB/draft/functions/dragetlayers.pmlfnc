--
--
-- Description:
-- Function to get all layers and populate the main form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Selected filter on main form]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Of layer and note names for the Gen application layer gadget]
--
------------------------------------------------------------------------

-- Define function
define function !!draGetLayers(!filter is STRING) is ARRAY

  -- get name of current sheet
  -- get RTEXT rather than DTEXT as DTEXT is sometimes truncated for long names (otherwise we get syntax errors further down)
  !sheetName       = !!appDraMain.sheet.selection('RTEXT')
  !allLayers       = ARRAY()
  -- Check to see if the sheet has been selected
  if(!sheetName.eq('')) then
    !!alert.error('You must have a sheet selected in order to use the applications')
    return !allLayers
  endif
  -- unset test for purpose
  !unsetTest = '(not(unset(purp))) and '
  if(!filter.eq('ALL')) then
    !purpTest = !!cdrPrpDflts.attribute('DIM').val
    !purpTest = !purpTest + ' ' + !!cdrPrpDflts.attribute('DRA').val
    !purpTest = !purpTest + ' ' + !!cdrPrpDflts.attribute('LAB').val
    !purpTest = !purpTest + !!draGetGenPurps()

    var !allLayers append coll all NOTE for $!sheetName
    var !allLayers append coll all VNOT for $!sheetName
    !unsetTest = ''
    var !allLayers append coll all layer with (not(unset(purp))) for $!sheetName
    --var !allLayers append coll all layer with $!unsetTest match(!purpTest,(substring(purp,1,3))) neq 0 for $!sheetName
  elseif(!filter.eq('DIM')) then
    !purpTest = !!cdrPrpDflts.attribute('DIM').val
    var !allLayers append coll all layer with $!unsetTest match(!purpTest,(substring(purp,1,3))) neq 0 for $!sheetName
  elseif(!filter.eq('DRA')) then
    var !allLayers append coll all NOTE for $!sheetName
    var !allLayers append coll all VNOT for $!sheetName
  elseif(!filter.eq('LAB')) then
    !purpTest = !!cdrPrpDflts.attribute('LAB').val
    var !allLayers append coll all layer with $!unsetTest match(!purpTest,(substring(purp,1,3))) neq 0 for $!sheetName
  endif
  var !names eval flnm for all from !allLayers
  !names.sort()

  return !names

endfunction
-- End of function definition for draGetLayers()
