-- File:            dragetpipeentrypos.pmlfnc
--   Type:          Function Definition
--   Group:         PIPE
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Daniel (JaeHun Choi)
-- Created:
--
--
-- Description:
-- get position data of pipe element on 2d View
--
--
-- ASSUMPTIONS
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        position reference data
--                            ARRAY[1] element reference
--                            ARRAY[2] ppoint
--
-- Return:
--   [Data Type] [Description]
--    1   R      Return pipe entry position
--                            ARRAY[1] 3d Position
--                            ARRAY[2] 2d position on view
--                            ARRAY[3] split position on view
--
------------------------------------------------------------------------
define function !!draGetPipeEntryPos(!posRefData is ARRAY) is ARRAY
  !convertPosData = object ARRAY()

  if (!posRefData.unset()) then
    return
  endif

  !elementRef = !posRefData[1]
  !ppointRef  = !posRefData[2]

  if (!elementRef.type inset ('TEE','OLET')) then
    !pos3D = !elementRef.position
  else
    !pos3D = !elementRef.pposition[!ppointRef]
    handle any
      return !convertPosData
    endhandle
  endif

  -- translate 3d to 2d position
  var !pos2D shpos of $!pos3D
  !transFrom2Dpos = $!pos2D

  -- define string format
  !strFormat = object FORMAT()

  var !units SPLIT UNITS
  if (!units[3] neq |MM|) then
    !strFormat.dimension = 'L'
    !strFormat.units     = 'INCH'
    !strFormat.dp        = 2
  else
    !strFormat.dimension = 'L'
    !strFormat.units     = 'MM'
    !strFormat.dp        = 2
  endif

  -- split position
  !split2DPos = 'E' & !transFrom2Dpos.east.string(!strFormat) & ' N ' & !transFrom2Dpos.north.string(!strFormat) & ' U ' & !transFrom2Dpos.up.string(!strFormat)

  !convertPosData[1] = !pos3D
  !convertPosData[2] = !transFrom2Dpos
  !convertPosData[3] = !split2DPos

  return !convertPosData
endfunction
