--
--
-- Description:
-- Function to get PURP of selected layer/note
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [Purpose of the selected layer]
--
------------------------------------------------------------------------

-- Define function
define function !!draGetPurp() is STRING

-- Initialise variables

   !applicationForm = '!!' + !!cdApplic.substring(2)
   !form            = $!applicationForm
   !sheetName       = !form.sheet.selection('DTEXT')
   !layerName       = !form.layeNam.selection('DTEXT')
   !purpose         = ''

-- Check to see if the sheet has been selected
   if(!sheetName.eq('')) then
      return !purpose
   endif

-- Check the layer is selected
   if(!layerName.eq('')) then
      return !purpose
   endif

   !purpose = !layerName.dbRef().purp.substring(1,3)
   handle ANY
   -- in case the element is a note
    !purpose = !layerName.dbRef().owner.purp.substring(1,3)
    handle ANY
      !purpose = ''
    endhandle
   endhandle

   return !purpose


endfunction
-- End of function definition for draGetPurp()
