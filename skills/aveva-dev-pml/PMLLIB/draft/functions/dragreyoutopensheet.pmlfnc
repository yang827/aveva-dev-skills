--
--
-- Description:
-- Function to determine whether or not to grey out "Open Sheet" in the explorer
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Passed element for greying out.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draGreyOutOpenSheet(!passedElement is STRING) is BOOLEAN

  --Function modified so that only non draw able elements have open sheet greyed out.

  if (!!module().appName eq 'MarineDrafting') then
     !str  = 'SHEE DRWG'

     !list = !str.split()
     !element = !!dtbOwnerOfTypes(!passedElement.dbref(), !list)

     if(!element.unset()) then
        return FALSE
     else
        return TRUE
     endif
  endif

  !str  = 'OVER SHEE DRWG BACK SYLB SYTM LALB ISOLB SHTMPL'

  !list = !str.split()
  !element = !!dtbOwnerOfTypes(!passedElement.dbref(), !list)

  if(!element.unset()) then
     return FALSE
  else
     return TRUE
  endif

endfunction
-- End of function definition for !!draGreyOutOpenSheet() is BOOLEAN
