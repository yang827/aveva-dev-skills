--
--
-- Description:
-- Function to display the owner of the layer selected and deselect any current displayed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [dbRef of view/layer to highlight]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draHighLightView(!layer is DBREF)

-- set the frame of the view to highlight the current view
   if(!layer.type.eq('LAYE')) then
      !view      = !layer.owner
   else
      !view = !layer
   endif

-- only highlight the view if settings form toggle is set
   if(defined(!!draSettings) and !!draSettings.highLightView.val.not()) then
       unenhance all view for owner of $!view
       handle ANY
       endhandle
       return
   endif

   if(!layer.type.eq('LAYE') or !layer.type.eq('VIEW')) then
      unenhance all view for owner of $!view
      enhance  $!view
      handle ANY
      endhandle
   endif

endfunction
-- End of function definition for draHighLightView()
