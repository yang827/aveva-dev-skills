--
--
-- Description:
-- Function to activate relevant gadgets on old form !!CDRLMHSTYMOD
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drahstylemod(!gadget is STRING)

  if (!gadget eq 'Pattern') then
    if (!!cdrlmhstymod.fpenTog1.val) then
      !!cdrlmhstymod.fpen.active = true
      !!cdrlmhstymod.fpenHP.active = true
      !!cdrlmhstymod.fpenUD.active = false
      !!cdrlmhstymod.fpenGetUD.active = false
    else
      !!cdrlmhstymod.fpen.active = false
      !!cdrlmhstymod.fpenHP.active = false
      !!cdrlmhstymod.fpenUD.active = true
      !!cdrlmhstymod.fpenGetUD.active = true
    endif
  elseif (!gadget eq 'Outline') then
    if (!!cdrlmhstymod.olpenTog1.val) then
      !!cdrlmhstymod.olpen.active = true
      !!cdrlmhstymod.olpenTH.active = true
      !!cdrlmhstymod.olpenLS.active = true
      !!cdrlmhstymod.olpenUD.active = false
      !!cdrlmhstymod.olpenGetUD.active = false
    elseif (!!cdrlmhstymod.olpenTog2.val) then
      !!cdrlmhstymod.olpen.active = false
      !!cdrlmhstymod.olpenTH.active = false
      !!cdrlmhstymod.olpenLS.active = false
      !!cdrlmhstymod.olpenUD.active = true
      !!cdrlmhstymod.olpenGetUD.active = true
    else
      !!cdrlmhstymod.olpen.active = false
      !!cdrlmhstymod.olpenTH.active = false
      !!cdrlmhstymod.olpenLS.active = false
      !!cdrlmhstymod.olpenUD.active = false
      !!cdrlmhstymod.olpenGetUD.active = false
    endif
  endif

endfunction
-- End of function definition for !!drahstylemod
