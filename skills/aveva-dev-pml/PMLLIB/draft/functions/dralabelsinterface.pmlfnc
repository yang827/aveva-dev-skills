--
--  Description:     Provides the Interface between the Labelling toolbar
--               and the Labelling form.
--
----------------------------------------------------------------------
define function !!draLabelsInterface(!mode is STRING)

  if( undefined(!!draLabelsFast) ) then
    pml load form !!draLabelsFast
  endif

  if( !mode.eq('LABTYPE') ) then

    if( !!draLabelsFast.shown() ) then
      !!draLabelsFast.setLabelType(!!appDraMain.optLabType.selection())
      !!draLabelsFast.optLabType.select('RTEXT', !!appDraMain.optLabType.selection())
    endif

  elseif( !mode.eq('ATTATYPE') ) then

    if( !!draLabelsFast.shown() ) then
      !!draLabelsFast.setIdMethod(!!appDraMain.optAttaType.selection())
      !!draLabelsFast.optAttaType.select('RTEXT', !!appDraMain.optAttaType.selection())
    endif

  elseif( !mode.eq('MODIFY') ) then

    !type = !!ce.type
    if( !type.eq('SLAB') or !type.eq('GLAB') ) then
      !!draLabelsFast.show()
      --If this function is being called we must be in modify mode, so just make sure.
      !!draLabelsFast.modifyMode.val = TRUE
      !!draLabelsFast.switchMode('Modify')
    else
      !!alert.warning('The current element is not a Label!')
    endif

  else

    !labType = !!appDraMain.optLabType.selection()
    !idMethod = !!appDraMain.optAttaType.selection()
    !!draLabelsFast.optLabType.select('RTEXT', !labType)
    !!draLabelsFast.optAttaType.select('RTEXT', !idMethod)
    if !!draLabelsFast.shown().and(!!draLabelsFast.modifyMode.val) then
      !!draLabelsFast.setMode(!labType, !mode, !idMethod)
      !!draLabelsFast.applyLLTypeAngle(FALSE)
    else
      !!draLabelsFast.setMode(!labType, !mode, !idMethod)
      !!draLabelsFast.show()
    endif

  endif

endfunction
