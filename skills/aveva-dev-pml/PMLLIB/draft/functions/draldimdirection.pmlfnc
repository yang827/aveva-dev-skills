--
-- File:            draldimdirection.pmlfnc
--   Type:          Function Definition
--   Group:         Linear Dimensioning
--     Keyword:     DIMENSION
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         31 January 2002
--
--
-- Description:
-- Build form to set linear dimension directions
------------------------------------------------------------------------
define function !!draLdimDirection(!callType is STRING)

  -- Test for ldim
  if (!callType.eq('AUTO')) then
    if (!!ce.owne.type.upCase().neq('LDIM') and !!ce.type.upCase().neq('LDIM')) then
      return
    endif
  else
    if (!!ce.owne.type.upCase().neq('LDIM') and !!ce.type.upCase().neq('LDIM')) then
      PROMPT OFF
      PROMPT LOAD ESCAPE |Identify the linear dimension to be modified|
      ID LDIM @
        handle (61,528)
          PROMPT DISMISS
          PROMPT ON
          return
        endhandle
      PROMPT DISMISS
      PROMPT ON
    endif
  endif

  -- Get view direction
  VAR !view VIEW
  !dir = !view.dbref().dir

  -- Build form
  setup form !!draLdimDirection

    -- Test for orthogonal directions N, S, E, W, U and D
    if (!dir.up.eq(0) and !dir.east.eq(0) and !dir.north.eq(1)) then
      !nonorthogonal = false
    elseif (!dir.up.eq(0) and !dir.east.eq(0) and !dir.north.eq(-1)) then
      !nonorthogonal = false
    elseif (!dir.up.eq(0) and !dir.east.eq(1) and !dir.north.eq(0)) then
      !nonorthogonal = false
    elseif (!dir.up.eq(0) and !dir.east.eq(-1) and !dir.north.eq(0)) then
      !nonorthogonal = false
    elseif (!dir.up.eq(1) and !dir.east.eq(0) and !dir.north.eq(0)) then
      !nonorthogonal = false
    elseif (!dir.up.eq(-1) and !dir.east.eq(0) and !dir.north.eq(0)) then
      !nonorthogonal = false
    else
      !nonorthogonal = true
    endif

    -- Warning for non-orthogonal views
    if (!nonorthogonal) then
      para .warn at x0 ymin+0.5 text |NON-ORTHOGONAL VIEWS CAN GIVE MISLEADING DIMENSION VALUES|
    endif

    -- Line directions
    frame .fr || at xmin ymax width 57

      -- Dimension Line direction
      para   .dlP      at x1.5     ymax     text |Dimension Line:  |
      option .dlXAxis  at xmax     ymin     width 5
      text   .dlAngleA at xmax+1   ymin     width 10 is REAL format !!angleFmt
      option .dlYAxis  at xmax+1   ymin     width 5
      text   .dlAngleB at xmax+1   ymin     width 10 is REAL format !!angleFmt
      option .dlZAxis  at xmax+1   ymin     width 5

      -- Projection Line direction
      para   .plP      at x1.5     ymax+0.2 text |Projection Line: |
      option .plXAxis  at xmax     ymin     width 5
      text   .plAngleA at xmax+1   ymin     width 10 is REAL format !!angleFmt
      option .plYAxis  at xmax+1   ymin     width 5
      text   .plAngleB at xmax+1   ymin     width 10 is REAL format !!angleFmt
      option .plZAxis  at xmax+1   ymin     width 5

    exit

    -- Action
    button .apply   |Apply| at x0 ymax+0.2
    button .dismiss |Dismiss| at xmax form-size ymin ok

    -- Members
    member .formMethods is DRALDIMDIRECTION
    member .dimeRef is DBREF
    member .dimeDir is STRING
    member .projDir is STRING
    member .dimeTyp is STRING
    member .projTyp is STRING

    -- Form
    !this.formTitle = 'Linear Dimension Directions'
    !this.initCall = '!this.formMethods.init()'
    !this.formRevision  = | $Revision: 1.3 $ |

    -- Gadget calls
    !this.dlXAxis.callback  = |!this.formMethods.setDire(!this.dlXAxis)|
    !this.dlAngleA.callback = |!this.formMethods.setDire(!this.dlAngleA)|
    !this.dlYAxis.callback  = |!this.formMethods.setDire(!this.dlYAxis)|
    !this.dlAngleB.callback = |!this.formMethods.setDire(!this.dlAngleB)|
    !this.dlZAxis.callback  = |!this.formMethods.setDire(!this.dlZAxis)|

    !this.plXAxis.callback  = |!this.formMethods.setDire(!this.plXAxis)|
    !this.plAngleA.callback = |!this.formMethods.setDire(!this.plAngleA)|
    !this.plYAxis.callback  = |!this.formMethods.setDire(!this.plYAxis)|
    !this.plAngleB.callback = |!this.formMethods.setDire(!this.plAngleB)|
    !this.plZAxis.callback  = |!this.formMethods.setDire(!this.plZAxis)|

    !this.apply.callback  = |!this.formMethods.apply()|

    -- Set form in object
    !this.formMethods.form = !this

  exit
  -- End of form definition

  -- Show the form
  show !!draLdimDirection

endfunction
-- End of function definition
