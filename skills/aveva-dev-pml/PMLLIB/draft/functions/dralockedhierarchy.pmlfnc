--
--  Description:     returns primarily whether the supplied element or any of its descendant hierarchy is locked,
--                   it also indicates if the element is read only
--
--  Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      element to be checked
--    2   RW     STRING     output string describing status of element
--
--  Returns:
--   integer:
--      0   - neither element or any of its descendant hierarchy is locked, and element is writable
--     -1   - element doesn't exist or is in a read-only database
--      1   - element is locked
--      2   - element descendant is locked
------------------------------------------------------------------------
define function !!draLockedHierarchy(!ele is DBREF, !sMessage is STRING) is REAL

  var !lockedmembers coll all with (LOCK) for $!ele
  -- Check writable status using keyword DELETE: could use UPDATE instead; currently the 'writable' status
  --  for each is identical (and we know this function is definitely used in the context of deletion).
  var !sDeletable exists $!ele $!ele.type DELETE
  -- value of !deletable string will start with either 'TRUE' or 'FALSE'
  !deletable = substr(|$!sDeletable|,1,1) eq 'T'

  if (!ele.lock) then
    !sMessage = |$!ele.name is Locked.|
    return 1
  elseif (arraysize(!lockedmembers) gt 0) then
    !mem1 = !lockedmembers[1].dbref()
    !sMessage = |$!ele.name owns locked elements (the first is $!mem1.type $!mem1.name).|
    return 2
  elseif (not !deletable) then
    !sMessage = |$!ele.name is in a read-only database.|
    return -1
  endif

  !sMessage = ''
  return 0

endfunction
