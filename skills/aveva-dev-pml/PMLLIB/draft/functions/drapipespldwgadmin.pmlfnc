--
--  Description:     Function to show the pipe spool drawing admin form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function  !!drapipespldwgadmin()
  kill !!drapipespooldwgadmin

-- in case the settings form has not been opened
   if(undefined(!!drapipespooldwgadmin)) then
      pml reload form !!drapipespooldwgadmin
   endif

   show !!drapipespooldwgadmin
endfunction
