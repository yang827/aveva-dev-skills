--
-- Description:
-- Function to call Plot CE from Draft explorer
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Database element as a string (i.e '=123/4567' or '/myView')
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draPlotFromExplorer(!element is STRING)

   !file = object FILE('%PDMSUI%/DRA/GEN/XPLOTIT')
   !!runMacro(!file.fullname() , !element)

endfunction
-- End of function definition for !!draPlotFromExplorer
