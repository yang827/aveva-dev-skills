-- Created:         Mon Apr 26 14:14:31 GMT 2004
--
--
-- Description:
-- Function to be post run when the explorer removes 3D to 3D view,
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ANY       element ref or name as a string or array of such
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draremovefrom3dview(!element is ANY)

  !memory = !!ce
  !objectType = !element.objectType()

  if (defined(!!dra3dView)) then
    if (!!dra3dView.shown()) then
      -- Test validity of current Sheet
      if(!!dra3dView.formTitle eq '3D View - No associated view') then
        !test = FALSE
      else
        !test = TRUE
      endif
      if (!objectType eq 'STRING') then
        if (!!dra3dView.explorerAddIdlist and !test) then
          !!ce = !element.dbref()
          !!dra3dView.viewRem()
        endif
      else
        -- We must have an array of dbrefs passed in !element
        if (!!dra3dView.explorerAddIdlist and !test) then
          !!dra3dView.viewRem(!element)
        endif
      endif

    endif
  endif

  !!ce = !memory

endfunction
-- End of function definition for !!draremovefrom3dview
