--
-- Author:          Steve Wilson
-- Created:         19 June 2001
--
--
-- Description:
-- Call the form for selecting Change Comparison Date via STAMP elements
-- Used by FSYSTEM
--
------------------------------------------------------------------------
define function !!draRunCompDate(!callType is STRING, !updateType is STRING)

  -- Exit standard mode
  !!exitModifyMode()

  -- Initialise variables
  !testString = 'DRWG SHEE VIEW'

  -- Update the current element if at or below DRWG
  if (!testString.match(!!ce.type.upCase()).eq(0)) then

    -- Test for below view level
    -- Have to access the view since 'show changes' does not function below that level
    VIEW
    handle (2,111)
      !!alert.error('You need to be positioned at a DRWG, SHEE or VIEW to Update Changes!')
      return
    endhandle

  endif

  -- Load the form
  !!compDate(!callType, !updateType)

  -- Show the set comparison date form
  !!compDate.show()

-- End of function definition
endfunction
