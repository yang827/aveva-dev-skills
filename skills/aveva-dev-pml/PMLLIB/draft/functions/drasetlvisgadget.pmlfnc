-- Define function
define function !!draSetLvisGadget(!dbRef is DBREF)

!lvis = !dbRef.lvis
handle ANY
-- in case the dbref passed in not a layer (it will always be a type that has lvis)
  return
endhandle

if(!lvis) then
   !!cdrGenApp.lvis.select('RTEXT','true')
else
   !!cdrGenApp.lvis.select('RTEXT','false')
endif


endfunction
-- End of function definition for draSetLvisGadget(DBREF)
