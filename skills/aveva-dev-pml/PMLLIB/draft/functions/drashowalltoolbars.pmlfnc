--
-- Description:
-- function to run all associated toolbars
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [application type ie. DIM or 2D etc.]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draShowAllToolbars(!appType is STRING)

if(!appType.eq('DIM')) then
   show !!draCrdims3
elseif(!appType.eq('2D')) then
--  !!appTbarCntrl.setVisible('shapes', TRUE)
--  !!appTbarCntrl.setVisible('symbols', TRUE)
--  !!appTbarCntrl.setVisible('texts', TRUE)
   show !!draCrPrims
endif

endfunction
-- End of function definition for !!draShowAllToolbars()
