--   Group:         Change Style
--     Keyword:     CHANGE
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Show the Change Forms
--
------------------------------------------------------------------------
define function !!draShowChange(!formName is STRING, !arg is STRING)

  -- Test for shown or needs loading
  if (!formName.eq('!!draChangeRule')) then

    -- Test for undefined
    if (undefined(!!draChangeRule)) then
      !!loadForm ('draChangeRule')
     !form = !!draChangeRule
    else

      -- Initialise variables
      !form = !!draChangeRule
      !!draChangeRule.formType = !arg.upCase()

    endif

  elseif (!formName.eq('!!draChangeStyle')) then

    -- Call the function to build the correct form
    if (!arg.neq('NEW STYLE')) then
      !!draChangeStyle(!arg.upCase())
    endif
    !form = !!draChangeStyle

  endif

  -- Get rplb
  !ce = !!ce
  RPLB
    handle (2,111)
      -- Cannot access element type RPLB from the level of
      !!alert.warning('You must be at or below a RPLB to continue')
      return
    elsehandle none
      -- Test that the rplb is a change library
      !rplbRefe = !!ce
      !!ce = !ce
      if (!rplbRefe.spPurp.neq('CHANGE')) then
        !!alert.warning('Cannot get a Change Library from this position in the hierarchy')
        return
      endif
    endhandle

  -- Test for change ruleset hierarchy
  if (!arg.upCase().eq('CRST')) then
    !testString = 'CRST DCRULE ACRULE'
    if (!testString.match(!!ce.type.upCase()).eq(0)) then
      !!alert.warning('You must be at or below a CRST to continue')
      return
    endif
  endif

  -- Test for change ruleset elements
  if (!arg.upCase().eq('LIBY') or !arg.upCase().eq('CRST')) then
    if (!!ce.type.upCase().eq('ACRULE') or !!ce.type.upCase().eq('DCRULE')) then
      VAR !allCrst COLL ALL CRST FOR OWNER OF CE
    else
      VAR !allCrst COLL ALL CRST FOR CE
    endif
    if (!allCrst.empty()) then
      !!alert.warning('This Representation Rule Library does not contain any Change Rulesets')
      return
    else
      if (!form.shown()) then
        !form.formMethods.init()
      else
        !form.show()
      endif
    endif
  endif

  -- Test for change style
  if (!arg.upCase().eq('DESIGN') or !arg.upCase().eq('ANNOTE') or !arg.upCase().eq('NEW STYLE')) then
    if (!form.shown()) then
      !form.formMethods.init(!form.formType)
    else
      !form.show()
    endif
  endif

endfunction
