--
--
-- Description:
-- Function to show a form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Form to show]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draShowForm(!form is STRING)

-- convert string to the form object
   !formObj = $!form
   handle ANY
   -- if the form does not exist, show it. (The constructor picks up the icon size)
      show $!form
   elsehandle NONE
   -- if it does exist, rebuild it with new icons
     !iconSize = !formObj.iconSize
     handle ANY
     -- in case the form has not had an iconsize defined
        show $!form
     elsehandle NONE
       if(!iconSize.neq(!!comSysOpt.iconSize())) then
          call !!comRebuildForm(!formObj)
       else
          show $!form
       endif
     endhandle
   endhandle

endfunction
-- End of function definition for draShowForm(FORM)
