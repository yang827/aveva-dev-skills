--
-- Description:
-- function to display the gaps form from dimension form
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!drashowgaps(!form is STRING)


  !valid = 'DPBA DPPT DPOI RDIM APPT ADIR PDIM'
  !dbRef = $!form$n.userdata.string().dbRef()

  if(!valid.match(!dbRef.type).neq(0)) then
    !!ce = !dbRef
    !!draGapManager.ref = !dbRef
    handle ANY
      pml load form !!draGapManager
      !!draGapManager.ref = !dbRef
    endhandle
  endif
  show !!draGapManager

endfunction
-- End of function definition for !!drashowgaps()
