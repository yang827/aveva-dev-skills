--
--
-- Description:
-- Function to display the 3D Design view in Draft module (called from DES/GEN/MSINGLEV)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!draShowView3dInDraft()

  -- Load form of not defined
  if( not defined(!!dra3dView)) then
    pml load form !!dra3dView
  endif

  -- Initialise form if shown (prior to reshowing)
  if (!!dra3dView.shown()) then
    !!dra3dView.initialise()
  else
    !!dra3dView.show('FREE')
    !!dra3dView.initialise()
  endif

endfunction
-- End of function definition for draShowView3dInDraft()
