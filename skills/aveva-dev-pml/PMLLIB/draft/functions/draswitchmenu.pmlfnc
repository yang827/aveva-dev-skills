--
--
-- Description:
-- Function to switch menu grey and ungrey depending on CE type
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draSwitchMenu()

   !drwg = FALSE
   !ref  = !!ce

   !displayEle = 'SHEE DRWG BACK OVER SYLB ISOLB LALB SHTMPL'
   !displayDbRef = !!dtbGetOwnerType(!ref, !displayEle)
-- deactivate if the drwg has  more than one sheet
   if(!ref.type.eq('DRWG') and !ref.mcount('SHEE').eq(1)) then
      !selectedDbRef = !ref
   elseif(!ref.type.eq('DRWG') and !ref.mcount('SHEE').neq(1)) then
      !selectedDbRef = object DBREF()
      !drwg = TRUE
   else
-- only valid menu when below one of these :-
    !isAdmin = !!appCntrl.isAdmin()
    if(!isAdmin) then
       !validEle  = 'BACK OVER SYLB ISOLB LALB SHTMPL'
    else
       !validEle  = 'OVER SHEE DRWG'
    endif
    !selectedDbRef = !!dtbGetOwnerType(!ref, !validEle)
   endif
-- deactivate if no dbref found
   if(!displayDbRef.unset()) then
      !!cdrCadcGa1.barPopup.setactive('Add CE', FALSE)
      if(defined(!!cdrCadcGa2)) then
         !!cdrCadcGa2.barPopup.setactive('Add CE', FALSE)
      endif
      if(!drwg.not()) then
         !!appDraMain.select.active = FALSE
      else
         !!appDraMain.select.active = TRUE
      endif
   else
-- activate if dbref is found
     if (!selectedDbRef.unset() or ( not dbwrite ) or (  not !!dbRefUpdatable(REF))) then
       !!cdrCadcGa1.barPopup.setactive('Add CE', FALSE)
       if ((!drwg.not()) or (( not dbwrite ) or (  not !!dbRefUpdatable(REF))) ) then
         !!appDraMain.select.active = FALSE
       else
         !!appDraMain.select.active = TRUE
       endif
     else
       !!cdrCadcGa1.barPopup.setactive('Add CE', TRUE)
       !!appDraMain.select.active = TRUE
     endif
     if(defined(!!cdrCadcGa2)) then
       !!cdrCadcGa2.barPopup.setactive('Add CE', TRUE)
     endif
   endif

endfunction
-- End of function definition for !!draSwitchMenu()
