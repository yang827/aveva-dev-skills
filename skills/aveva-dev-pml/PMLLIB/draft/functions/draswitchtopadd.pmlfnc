--
-- Description:
-- function to switch to the PADD db if not already in the PADD db
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draSwitchToPadd()

-- are we in the PADD db?
   !testDbType = !!ce.dbType
   if(!testDbType.neq('PADD')) then
      switch
   endif

endfunction
-- End of function definition for !!draSwitchToPadd()
