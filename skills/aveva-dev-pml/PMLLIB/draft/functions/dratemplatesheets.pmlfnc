--
--
-- Description:
-- Initialisation for create drawing and sheets from template
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word DRAWING or SHEET to be created (or ANY if mode is DEFAULT)
--    2    R     STRING      Key word CREATE or MODIFY or DEFAULT(Modify being done at this stage)
--    3    R     DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draTemplateSheets(!type is STRING, !mode is STRING, !calledFrom is DBREF)

  if (!mode.lowcase() eq 'select') then

    -- Make sure the form is defined
    if (defined(!!draTemplateSheets)) then
      if (!!cdrGenApp.optionDefaultTemplate.selection('rtext') eq 'Select...') then
        !!draTemplateSheets('DRAWING', 'CREATE', !!ce)
        return
      endif
    endif

  elseif (!mode.lowcase() eq 'default') then

    -- Make sure the form is defined
    if (defined(!!draTemplateSheets)) then
      if (!!cdrGenApp.optionDefaultTemplate.selection('rtext') eq 'Select...') then
        !!draTemplateSheets('DRAWING', 'CREATE', !!ce)
        return
      endif
      -- draft template sheets form must have been loaded
      --!!draTemplateSheets.selectedTemplate = !!draTemplateSheets.defaultTemplate
    -- If we are here then the default gadget on the main form must be set to the default template
      !!draTemplateSheets.selectedTemplate = !!cdrGenApp.optionDefaultTemplate.selection('rtext').dbref()
      if (!!draTemplateSheets.selectedTemplate.unset() ) then
        !!alert.error('Template not selected')
        return
      endif
      if (!!draTemplateSheets.selectedTemplate.type eq 'DRWG' or !!draTemplateSheets.selectedTemplate.type eq 'DRTMPL') then
        !!draTemplateSheets.setUp('DRAWING', !mode, !calledFrom)
      elseif (!!draTemplateSheets.selectedTemplate.type eq 'SHEE' or !!draTemplateSheets.selectedTemplate.type eq 'SHTMPL') then
        !!draTemplateSheets.setUp('SHEET', !mode, !calledFrom)
      endif
      if (!!appDraMain.defaultName.val) then
        -- This method uses a default name
        !!draTemplateSheets.onApply()
      else
        -- This method shows a naming form
        !!draTemplateSheets.preOnApply()
      endif
    else
      !!alert.error('Template not selected')
    endif

  elseif (!mode.lowcase() eq 'create') then
    -- Test to make sure the template area is set up
    !userTemplateArea = !!cdrUdflts.tmplt.val
    if (!userTemplateArea eq |unset|) then
      -- ********** This if rule may need tightening up ************
      return error 1 |Drawing & Sheet Template area not defined...|
    endif

    show !!draTemplateSheets
    !!draTemplateSheets.setUp(!type, !mode, !calledFrom)
  endif

endfunction
-- End of function definition for !!draTemplateSheets
