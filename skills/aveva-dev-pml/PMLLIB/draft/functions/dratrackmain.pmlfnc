--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!draTrackMain()

--  -- grey out FD menu if there
--  !license = !!appDraMain.fdLicense
--
--  if (!license) then
--
--    if (!!draGreyOutExportFDItem(!!ce.name)) then
--      !!appDraMain.mbUtils.setFieldProperty('sheetToFinalDesign', 'ACTIVE', TRUE)
--
--    else
--       !!appDraMain.mbUtils.setFieldProperty('sheetToFinalDesign', 'ACTIVE', FALSE)
--
--    endif
--
--    -- grey out modify if not below or at a RPLB
--    !test[1] = 'RPLB'
--    if (!!dtbOwnerOfTypes(!!ce, !test).unset()) then
--        !!appDraMain.mbModify.setFieldProperty('LayerFDRuleset', 'ACTIVE', FALSE)
--
--    else
--        !!appDraMain.mbModify.setFieldProperty('LayerFDRuleset', 'ACTIVE', TRUE)
--
--    endif
--
--  endif

  -- grey out Add CE menu if not at the correct element
  !!draSwitchMenu()

  -- do nothing if variable not defined
  if(not(defined(!!cdCurTyp))) then
    return
  endif

  if (defined(!!appCntrl)) then

    !app = !!appCntrl.currentAppObj()

    if (!app.admin) then
      !status = 'ADMIN'
    else
      !status = 'USER'
    endif

    !gadgets = !app.gadgets
    !eleType = !app.types

  else

    !!cdrApplic.apps.select('DTEXT',!!cdApplic)
    !info    = !!cdrApplic.apps.selection().split('\')
    !status  = !info[1]
    !gadgets = !info[10].real()
    !eleType = !info[11]

  endif

  ---- Tracking doesn't need to do anything if layer gadget is not shown
  ---- P-40900 Oh yes it does!!!!! RAB 22-09-11
  --if (!!cdrGenApp.layerToolbar.visible.not()) then
  --  return
  --endif

  -- Do nothing if no sheets are selected
  if (!!cdrGenApp.sheet.rText.unset()) then
    return
  endif

  -- check status P-40900 without looking at the layer toolbar (irrelevant) RAB 22-Sep-11
  if(!status.eq('USER')) then

    -- highlight the selected layer (AK)
    !ref = !!ce

    -- attempt to navigate to a NOTE,VNOT,LAYER,VIEW
    !selectedDbRef = !!dtbGetOwnerType(!ref, 'NOTE VNOT LAYE VIEW')

    if(!selectedDbRef.unset()) then
      -- not under a selectable item
      return
    endif

    -- don't navigate if the elements below sheet are not the current sheet
    !selectedSheet = !!dtbGetOwnerType(!ref, 'SHEE OVER')
    if(!selectedSheet.unset()) then
      return
    endif

    if(!selectedSheet.fullname.neq(!!cdrGenApp.sheet.selection('RTEXT'))) then
      return
    endif

    -- highlight the view if selecting an element under the current sheet
    !layerDbRef = !!dtbGetOwnerType(!ref, 'LAYE VIEW')
    if(!layerDbRef.set()) then
      call !!draHighLightView(!layerDbRef)
    endif

    -- P-40900 don't check the layer toolbar (irrelevant) RAB 22-Sep-11
  elseif (!status.eq('ADMIN')) then

    !ref = !!ce

    -- attempt to navigate to a LAYER,VIEW,NOTE,VNOT
    !selectedDbRef = !!dtbGetOwnerType(!ref, 'VIEW NOTE LAYE VNOT')

    if(!selectedDbRef.unset()) then
      -- not under a selectable item
      return
    endif

    -- don't navigate if the elements below sheet are not the current sheet
    !selectedSheet = !!dtbGetOwnerType(!ref, 'BACK OVER SHTMPL')
    if(!selectedSheet.unset()) then
      return
    endif

    if(!selectedSheet.fullname.neq(!!cdrGenApp.sheet.selection('RTEXT'))) then
      return
    endif

    -- highlight the view if selecting an element under the current sheet
    !layerDbRef = !!dtbGetOwnerType(!ref, 'LAYE VIEW')
    if(!layerDbRef.set()) then
      call !!draHighLightView(!layerDbRef)
    endif

  endif

  -- Attempt to select the element via the layer control object
  !!cdrGenApp.layerControl.selectElement(!!ce)

endfunction
-- End of function definition for draTrackMain()
