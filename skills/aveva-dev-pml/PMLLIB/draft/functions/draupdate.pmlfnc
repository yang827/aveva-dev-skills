--
--
-- Description:
-- Function to run the update command from anywhere
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [PDMS update command]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Of forms displayed]
--
------------------------------------------------------------------------

-- Define function
define function !!draUpdate(!command is STRING)

!ref = !!ce

!view = !!dtbGetOwnerType(!!ce, 'VIEW')

if(!view.set()) then
-- climb to view and update
  !!ce = !view
  $!command
else
-- under a sheet note, climb to sheet
  !shee = !!dtbGetOwnerType(!!ce, 'SHEE')
  if(!shee.set()) then
   !!ce = !shee
   $!command
  else
  -- do it from the currently selected sheet
   !currentSheet = !!appdramain.sheet.selection().dbRef()
   handle ANY
   elsehandle NONE
    !yes = !!alert.confirm('Do you wish to update the whole Sheet?')
    if(!yes.upcase().eq('YES')) then
      !!ce = !currentSheet
      $!command
    endif
   endhandle

  endif
endif

!!ce = !ref

endfunction
-- End of function definition for draUpdate(STRING)
