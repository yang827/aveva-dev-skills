--
--  File:            draupdate2dsectionsketch.pmlfnc
--  Type:            Function Definition
--  Group:           3D View
--     Keyword:      Sections
--  Module:          Draft
--  Replaces:        Wrapper for %PDMSUI%/DRA/GEN/UPLDRAW
--
--  Author:          Steve Bentley
--  Created:         Thu Jun  9 14:56:25 2005
--
--
--  Description:     Function to update the older 2D PDMSUI appware form for section planes, when using the 3D view to modify
--
----------------------------------------------------------------------
define function !!draUpdate2dSectionSketch()

  !memory = !!ce

  -- Navigate to the Section Plane
  if (defined(!!cdrmsplane) ) then

    -- Navigate to view for initialisation
    !!ce = !!dra3dView.currentDraftView
    handle ANY
  	  !!ce = !memory
      return
    endhandle

    -- Initialise 2d form
    !file = object FILE('%PDMSUI%/DRA/GEN/IMSPLANE')
    !!runMacro(!file.fullname() , '')
    handle ANY
    endhandle

    -- Select the section plane on the 2d form same as 3d form
    if (defined(!!dra3dViewSections)) then
      !selectionText = !!dra3dViewSections.list.selection('rtext')
      if (!selectionText.size() gt 0) then
        !!cdrmsplane.splane.select('rtext', !selectionText[!selectionText.size()].dbref().name)
      handle ANY
        !!ce = !memory
        return
      endhandle
    else
      ERASE PLANE IN $!!dra3dView.currentDraftView
      !!ce = !memory
      return
      endif
    endif

    -- Run the callback for the new selected plane
    !file = object FILE('%PDMSUI%/DRA/GEN/UMSPLANE')
    !!runMacro(!file.fullname() , '')
    handle ANY
    endhandle

    -- Run the 2d form sketch button callback
    !file = object FILE('%PDMSUI%/DRA/GEN/UPLDRAW')
    !!runMacro(!file.fullname() , 'SKETCH _cdrmsplane')
    handle ANY
    endhandle
  else
    ERASE PLANE IN $!!dra3dView.currentDraftView
  endif

  !!ce = !memory
  handle ANY
    -- just in case it has been deleted
  endhandle

endfunction
-- End of function definition for !!draUpdate2dSectionSketch
