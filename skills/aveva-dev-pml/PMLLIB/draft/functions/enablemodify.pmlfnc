-- File:            enablemodify.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        draft
--   Replaces:
--
-- Author:          G.Wynne-Jones
-- Created:         23 December 1998
--
--
-- Description:
--  Disable/enable  modify mode for read only/writable  sheets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM          Form displaying the sheet
--    2   R      STRING        ON/OFF
--
------------------------------------------------------------------------
define function !!enableModify (!form is FORM, !opt is STRING)

if ( !form.formName.upcase() ne |_CDRCADCGA1| )then
  return
endif

if (!opt eq 'ON') then
  !form.modifyItem.active = true
  !form.snap.active       = true

else
-- first make sure we are not already in modify mode
-- (AK) toggle button can be tested as a boolean now
  if (!form.modifyItem.val) then
     !!setModifyMode(!form.n1)
  endif
  !form.modifyItem.active = false
  !form.snap.active       = false
endif

endfunction
-- End of function definition for !!enableModify
