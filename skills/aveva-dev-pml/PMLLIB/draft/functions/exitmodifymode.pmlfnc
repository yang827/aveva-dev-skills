--
-- Description:
-- This resets standard navigate mode and popup menu
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--none
--
------------------------------------------------------------------------

define function !!exitModifyMode()

   !!modLabInit = 0
   !!modRDimInit = 0
   !view = !!cdrCadcGa1.n1
   !view.runInMode('Native')
   !view.setPopup(!!cdrCadcGa1.barPopup)
   !!cdrCadcGa1.modifyItem.val = false

endfunction
-- End of function definition for !!exitModifyMode
