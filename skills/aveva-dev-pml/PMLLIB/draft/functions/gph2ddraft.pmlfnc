-- Created:         5 August 1998
--
--
-- Description:
--  Standard Draft Graphic View
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
--    2   R      STRING      MAIN or REFERENCE
--
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------

-- Define function
define function !!gph2dDraft(!number is STRING, !mainWindow is BOOLEAN)

-- Initialise Variables
  !formObj = '!!cdrCadcGa' & !number

    $!<formObj>.iconTitle     = '2DView'
    $!<formObj>.formRevision  = ' $Revision: 1.5 $ '
if (!number eq '1') then
    !!cdrCadcGa1.cancelCall    = 'HIDE !!cdrCadcGa1'
endif

 -- set the form variables
$!<formObj>.n1.setPopup($!<formObj>.barPopup)
$!<formObj>.n1formTitle = $!<formObj>.formTitle
$!<formObj>.formName =  |_cdrCadcGa| & !number
$!<formObj>.viewNumber = |_n1|

if (!mainWindow) then
-- Set Defaults for Modes
   $!<formObj>.n1.pickItem.cursor      = 'Pointer'
   $!<formObj>.n1.pickItem.prompt      = 'MODIFY MODE: Pick Item & Drag'
   $!<formObj>.n1.editItem.cursor      = 'Pointer'
   $!<formObj>.n1.editItem.prompt      = 'MODIFY MODE: Pick & Drag Highlighted Item or Pick New Item'

   $!<formObj>.n1.pickPoint.cursor     = 'Pick_Cursor'
   $!<formObj>.n1.pickPoint.prompt     = 'DEFINE SECTION PLANE: Pick Point '
   $!<formObj>.n1.editPoint.cursor     = 'LeftArrow'
   $!<formObj>.n1.editPoint.prompt     = 'EDIT SECTION PLANE: Pick/Move Hot Spot '

--   $!<formObj>.n1.native.cursor        = 'Pointer'
--   $!<formObj>.n1.default.prompt       = 'Navigate'

-- build popup menus for restore/save view buttons
  $!<formObj>.newMenu('saveView1')
  $!<formObj>.saveView1.add('callback', 'Save 1', '!this.n1.saveView(1)')
  $!<formObj>.newMenu('saveView2')
  $!<formObj>.saveView2.add('callback', 'Save 2', '!this.n1.saveView(2)')
  $!<formObj>.newMenu('saveView3')
  $!<formObj>.saveView3.add('callback', 'Save 3', '!this.n1.saveView(3)')
  $!<formObj>.newMenu('saveView4')
  $!<formObj>.saveView4.add('callback', 'Save 4', '!this.n1.saveView(4)')
  $!<formObj>.newMenu('spacing')
  $!<formObj>.spacing.add('callback', 'Spacing...', 'SHOW !!cdr2DGrid')

  $!<formObj>.restoreView1.setPopup($!<formObj>.saveView1)
  $!<formObj>.restoreView2.setPopup($!<formObj>.saveView2)
  $!<formObj>.restoreView3.setPopup($!<formObj>.saveView3)
  $!<formObj>.restoreView4.setPopup($!<formObj>.saveView4)
  $!<formObj>.vgrid.setPopup($!<formObj>.spacing)
--     $!<formObj>.snap.setPopup($!<formObj>.snapThings)

endif

-- attempt to add current sheet into area view
  if (undefined(!!cdCurTyp)) then
    var !!cdCurTyp ||
  endif
  if (undefined(!!cdCurShe)) then
    var !!cdCurShe ||
  endif
  -- put sheet into master area view if general application
  -- sheet gadget has a valid entry
  if (|$_cdrGenApp_SHEET| neq ||) then
    $!<formObj>.n1AddType = |$!!cdCurTyp|
    $!<formObj>.n1AddName = |$!!cdCurShe|

    -- make up the title with the sheet name
    !newTitle = $!<formObj>.n1formTitle & '   SHEE ' & !!cdCurShe
    edit $!<formObj> TITLE |$!newTitle|

    -- check if sheet is already added into area view
    edit $!<formObj>.n1 AREA
      PUT $!!cdCurShe
      handle any
      endhandle
    exit
    !!tog2DSnap('REFRESH')
    !!tog2DGrid('REFRESH')
  endif

endfunction
-- End of function definition for !!gph2dDraft
