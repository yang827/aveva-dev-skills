--
-- File:            hvacsketchesdimensiondir.pmlfnc
--   Type:          Function Definition
--   Group:         Document production
--     Keyword:     HVAC Sketches
--   Module:        DRAFT
--
-- Author:          Steve Wilson/Steve Bentley
-- Created:         13 March 2006
--
-- Description:
-- Calculates the direction between two component ppoints
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The first component reference
--    2    R     REAL        The first component ppoint
--    3    R     DBREF       The second component reference
--    4    R     REAL        The second component ppoint
--    5    R     BOOLEAN     Whether to return an accurate value or a rounded value
--
-- Return:
--   [Data Type] [Description]
--    STRING      Description of the continuation.
-------------------------------------------------------------------------
define function !!hvacSketchesDimensionDir(!first is DBREF, !one is REAL, !second is DBREF, !two is REAL, !true is BOOLEAN) is STRING

  -- Initialise variables
  !format = object FORMAT()
  !format.dp = 2

  -- In case points are superimposed
  if (!first.pposition[!one].eq(!second.pposition[!two])) then
    !secondPos = !second.pposition[!two].offset(!second.pdirection[!two],10)
  else
    !secondPos = !second.pposition[!two]
  endif

  -- Get direction between the first and second elements
  !direction = !first.pposition[!one].direction(!secondPos)
  !dimnDir = !direction.string(!format).before(' WRT')
  !dir = !dimnDir.split()
  !angle = !dir.size()

  -- Test for compound angle and determine the horizontal vectors only
  if (!true) then

    if (!angle.eq(5)) then
      if (!dir[!angle].eq('U') or !dir[!angle].eq('D')) then
        !dimnLineDir = !dir[1] & !dir[2].real().nint() & !dir[3]
      else
        if (!angle.gt(1)) then
          !dimnLineDir = !dir[1] & !dir[2].real().nint() & !dir[3]
        else
          !dimnLineDir = !dir[1]
        endif
      endif
    elseif (!angle.eq(3)) then
      if (!dir[!angle].eq('U') or !dir[!angle].eq('D')) then
        if (!dir[2].real().geq(45)) then
          !dimnLineDir = !dir[3]
        else
          !dimnLineDir = !dir[1]
        endif
      else
        !dimnLineDir = !dir[1] & !dir[2].real().nint() & !dir[3]
      endif
    else
      !dimnLineDir = !dir[1]
    endif

  -- Get the direction while integerise the values
  else

    !dimnDir = !direction.string().before(' WRT')
    !dir = !dimnDir.split()
    !angle = !dir.size()
    if (!angle.eq(1)) then
      !direc = !dimnDir
    elseif (!angle.eq(3)) then
      !angle = !dir[2].real().nint()
      if (!angle.neq(0)) then
        !direc = !dir[1] & !angle & !dir[3]
      else
        !direc = !dir[1]
      endif
    else
      !angle1 = !dir[2].real().nint()
      !angle2 = !dir[4].real().nint()
      if (!angle1.neq(0) and !angle2.neq(0)) then
        !direc = !dir[1] & !angle1 & !dir[3] & !angle2 & !dir[5]
      elseif (!angle1.eq(0) and !angle2.neq(0)) then
        !direc = !dir[1] & !angle2 & !dir[5]
      elseif (!angle1.neq(0) and !angle2.eq(0)) then
        !direc = !dir[1] & !angle1 & !dir[3]
      else
        !direc = !dir[1]
      endif
    endif
    !dirObj = object DIRECTION(!direc)
    !dimnLineDir = !dirObj.string().before(' WRT')

  endif

  return !dimnLineDir

endfunction
