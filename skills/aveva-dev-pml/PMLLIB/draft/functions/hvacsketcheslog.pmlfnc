--
-- Description:
-- Function to append to a HVAC sketches log file
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      text to be appended to logfile
--
------------------------------------------------------------------------
define function !!hvacSketchesLog(!text is STRING)

  -- Append to the object member not write to file yet
  !!hvacSketch.logdata.append(!text)

endfunction
