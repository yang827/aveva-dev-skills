--
-- File:            immodify.pmlfnc
--   Type:          Function Definition
--   Module:        DRAFT
--
-- Author:          G.Wynne-Jones
-- Created:         15 Oct 1998
--
--
-- Description:
-- This is the main callback function for modifying an entity
-- for Event Driven Graphics in Draft
--
-- Updates:
--   in EDITITEM mode, handle case when the picked item has gone (22/02/99 gewj)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Reference to the FORM gadget the pick was made in
--                           VIEW.inMode.data[] stores data on pick.
--    2   R      STRING      The mode the VIEW was in e.g. INIT,PICKLABEL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!imModify(!view is GADGET, !action is STRING)

!form = !view.owner()

if (!action EQ 'INIT') then
   !view.callback = '!!imModify('
   !view.setInMode('PICKITEM')

elseif (!action EQ 'PICKITEM') then
      !!imPickedElement = !view.inMode.data[2]
-- go do it
      $!!imPickedElement
-- activate the popup menu
      !view.setPopup(!form.modifyPopup)
      !view.setInMode ('EDITITEM')
-- re-initialise inmode input data to make sure popup menu is reset
      !view.inMode.input[1] = 1  $* 2d pick mode
      !view.inMode.input[2] = 0  $* reset/delete/finish



elseif (!action EQ 'EDITITEM') then
-- Reissue navigate command in case user has changed it
      $!!imPickedElement
      handle any
        !!alert.error (' Picked element no longer available' )
        VIEW
        golabel /endmodify
      endhandle

   !count = !view.inMode.data[1]
   if (!count eq 0) then
      golabel /endmodify
   endif
   !command = !view.inMode.data[2]
-- Go do it
    $!command
    handle any
          !!alert.error (' Invalid command : $!command (Error - $!!error.text)' )
          golabel /endmodify
    endhandle
   if (!count gt 1 ) then
      do !x from 2 to !count
         break if ((!x + 1 ) gt !view.inMode.data.size())
         !command = !view.inMode.data[ !x + 1 ]
         $!command
         handle any
           !!alert.error (' Invalid command : $!command (Error - $!!error.text)')
           golabel /endmodify
         endhandle
      enddo
   endif

label /endmodify
 !view.setPopup(!form.barPopup)
 !view.setInMode('PICKITEM')

endif
return

endfunction
-- End of function definition for !!imModify
