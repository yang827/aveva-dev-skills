-- Description:     Function to show the Pipe Sketching Utility
--
------------------------------------------------------------------------
define function !!pipeSketches()

  -- Initialise types of elements for which an pipe sketch can be produced
  !detailTypes[1] = 'ZONE'
  !detailTypes[2] = 'PIPE'

  -- Switch to the DESI DB
  if (!!ce.dbtype neq 'DESI') then
    switch
  endif

  -- Detail CE - check type is valid for detailing
  !selectedElement = !!ce
  !isoElement      = !!dtbOwnerOfTypes(!selectedElement, !detailTypes)

  -- Navigate to element to be actioned on
  if (!isoElement.set()) then
    !!ce = !isoElement
  endif
  if (defined(!!pipeSketches) and !!pipeSketches.shown()) then
    -- No need to show but run the initialisation
    !!pipeSketches.init()
  else
    show !!pipeSketches
  endif

endfunction
