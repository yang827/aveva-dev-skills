--
-- Description:
-- Function to append to a pipe sketches log file
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      text to be appended to logfile
--
------------------------------------------------------------------------
define function !!pipeSketchesLog(!text is STRING)

  -- Append to the object member not write to file yet
  !!pipeSketch.logdata.append(!text)

endfunction
