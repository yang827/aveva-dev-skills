--
-- Description: Function to be used to create HVAC sketches
--
------------------------------------------------------------------------
define function !!processHvacSketches(!element is DBREF)

  -- Remember the current position
  !memory = !!ce

  -- Set the Form Member for HVAC spool
  !!hvacSketch.hvacSpool = !element

  -- Apply the action method
  !!hvacSketch.apply()

  -- Navigate back to the original element
  !!ce = !memory

endfunction
