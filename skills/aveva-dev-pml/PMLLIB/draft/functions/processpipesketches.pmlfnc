--
-- Description: Function to be used to create Pipe sketches
--
------------------------------------------------------------------------
define function !!processPipeSketches(!element is DBREF)

  -- Remember the current position
  !memory = !!ce

  -- Set the Form Member for pipe spool
    !!pipeSketch.pipeSpool = !element

  -- Apply the action method
  !!pipeSketch.apply()

  -- Navigate back to the original element
  !!ce = !memory

endfunction
