--
--
-- Description:
-- Function to change the enhance colour setting, and change back again (main for the delete function)
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]       [Colour to set enhance to, DEFAULT to set it back to previous set colour]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setEnhanceColour(!colour is ANY)

-- get the current sheet
    !curShee = !!draGetCurSheet()

-- save view if below a view
   var !view VIEW
   handle ANY

   endhandle

  if(!colour.objectType().eq('STRING') and !colour.upcase().eq('DEFAULT')) then
    if(defined(!!draSettings)) then
      setenhance  colour $!!draSettings.enhanceButton.background
    else
      pml load form !!draSettings
      setenhance  colour $!!draSettings.enhanceButton.background
    endif
    if(!curShee.set()) then
       unenhance all for $!curShee
    endif

    !!draHighlightView(!view.dbRef())
    handle ANY
      -- in case the view is deleted or above the view in hierarchy (sheet note)
    endhandle
  else
    if(!curShee.set()) then
      unenhance all view for $!curShee
    endif
    setenhance  colour $!colour
    enhance ce
  endif

endfunction
-- End of function definition for !!setEnhanceColour(ANY)
