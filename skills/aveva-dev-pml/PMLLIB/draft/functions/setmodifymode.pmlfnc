define function !!setModifyMode (!view is GADGET)
!form = !view.owner()

-- (AK) toggle button can be tested as a boolean now
   if (!form.modifyItem.val) then
      !!imModify(!view, 'INIT')
   else
      !view.runInMode('Native')
      !view.setPopup(!form.barPopup)
   endif


endfunction
-- End of function definition for !!setModifyMode
