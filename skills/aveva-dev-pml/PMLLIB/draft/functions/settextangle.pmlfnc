--   Type:          Function Definition
--   Module:        DRAFT
--
-- Author:          G.Wynne-Jones
-- Created:         30 March 1998
--
--
-- Description:
-- This is the main callback function for picks made on a label
-- for Event Driven Graphics in Draft
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Reference to the FORM gadget the pick was made in
--                           VIEW.inMode.data[] stores data on pick.
--    2   R      STRING      The mode the VIEW was in e.g. INIT,PICKLABEL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!setTextAngle (!theForm is FORM,!angle is STRING)
!popMenu = !theForm.textAngles

  !theForm.n1.inMode.data[2] = !angle
  !popMenu.select('Standard', FALSE)
  !popMenu.select('Horizontal', FALSE)
  !popMenu.select('Vertical', FALSE)
  !popMenu.select(!popMenu.pickedField, TRUE)

endfunction
-- End of function definition for !!setTextAngle
