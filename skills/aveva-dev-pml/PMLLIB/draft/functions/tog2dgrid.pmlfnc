--
-- File:            tog2dgrid.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        draft
--   Replaces:      macro TOG2DGRID
--
-- Author:          G.Wynne-Jones
-- Created:         11 August 1998
--
--
-- Description:
--  Turn grid display on or off
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING        ON/OFF/TOGGLE/REFRESH
-- Return:
--   none
--
------------------------------------------------------------------------

-- Define function
define function !!tog2dGrid (!opt is STRING)

!form = !!cdrCadcGa1
!gridded = !form.n1

-- CHECK VGRID TOGGLE, SET & NAVIGATE BACK TO ORIG
if ( |!form.n1AddName| eq || ) then
  return
endif
if ( !form.n1AddName.DBRef().badref() ) then
  return
endif

VAR !vgrid VGRID $!form.n1AddName

var !mult VGRID
var !mult (AFTER(|$!mult|,|Snap|))
var !snap SNAP
var !snapA SPLIT |$!snap|
var !vgridX DIST(($!snapA[10] * $!mult))
var !vgridY DIST(($!snapA[12] * $!mult))
var !vgridS |$!vgridX$Nx$!vgridY|

!gridOn = |Display grid (| & |$!vgridS| & |)|
!gridOff = |Hide grid|
!form.vgrid.setToolTip(!gridOn)

if (|$!opt| EQ |REFRESH|) then
  -- refresh display grid
  if ((match (|$!vgrid| , |Off|)) neq 0) then
    !form.vgrid.val = FALSE
    return
  else
    VGRID $!form.n1AddName OFF
    VGRID $!form.n1AddName ON
    handle (64,548)
-- grid multiple has been increased for this design elem
      var !mult (AFTER(|$!!error.text|,|increased to |))
      var !vgridX ($!snapA[10] * $!mult)
      var !vgridY ($!snapA[12] * $!mult)
      var !vgridS |$!vgridX$Nx$!vgridY|
       !!alert.message('$!!error.text')
    endhandle
  endif
elseif (|$!opt| eq |TOGGLE|) then
-- (AK) now true boolean gadget
    if (!form.vgrid.val.not()) then
    VGRID $!gridded OFF
    handle any
-- if fail to turn it off, don't switch the button
       !!alert.error('$!!error.text')
      !form.vgrid.setToolTip(!gridOff)
      !form.vgrid.val = TRUE
      return
    endhandle
    !form.vgrid.setToolTip(!gridOn)
    !form.vgrid.val = FALSE
    REFRESH
  else
    VGRID $!gridded ON
    handle (64,548)
-- grid multiple has been increased for this design elem
      var !mult (AFTER(|$!!error.text|,|increased to |))
      var !vgridX ($!snapA[10] * $!mult)
      var !vgridY ($!snapA[12] * $!mult)
      var !vgridS |$!vgridX$Nx$!vgridY|
       !!alert.message('$!!error.text')
    elsehandle any
       !!alert.error('$!!error.text')
       !form.vgrid.val = FALSE
       !form.vgrid.setToolTip(!gridOn)
       return
    endhandle
    !form.vgrid.val = TRUE
    !form.vgrid.setToolTip(!gridOff)
  endif
elseif (|$!opt| eq |ON|) then
    VGRID $!gridded ON
    handle (64,548)
-- grid multiple has been increased for this design elem
       var !mult (AFTER(|$!!error.text|,|increased to |))
       var !vgridX ($!snapA[10] * $!mult)
       var !vgridY ($!snapA[12] * $!mult)
       var !vgridS |$!vgridX$Nx$!vgridY|
       !!alert.message('$!!error.text')
    endhandle
    !form.vgrid.val = TRUE
    !form.vgrid.setToolTip(!gridOff)
--  var <!form>.n1Vgrid |$!vgridS|
elseif (|$!opt| eq |OFF|) then
    VGRID $!gridded OFF
    !form.vgrid.val = FALSE
    !form.vgrid.setToolTip(!gridOn)
    REFRESH
endif
return

endfunction
-- End of function definition for !!tog2dGrid
