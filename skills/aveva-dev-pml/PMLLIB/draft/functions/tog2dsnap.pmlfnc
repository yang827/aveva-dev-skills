--
--
-- Description:
--  Set/unset snap mode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING        ON/OFF/TOGGLE/REFRESH
-- Return:
--   none
--
------------------------------------------------------------------------

-- Define function
define function !!tog2dSnap(!mode is STRING)
!form = !!cdrCadcGa1


--!snapOff = |no SNAP|
--!snapOn  = |SNAP to grid|

if (|$!mode| eq |TOGGLE|) then
-- assume here that this is called from callback and that
--      system has already changed the toggle value
-- (AK) now I true boolean
  if (!form.snap.val) then
    SNAP ON
--    !form.snap.val = TRUE
  else
    SNAP OFF
--    !form.snap.val = FALSE
  endif
elseif (|$!mode| eq |REFRESH|) then

elseif (|$!mode| eq |ON|) then
    SNAP ON
    !form.snap.val = TRUE

elseif (|$!mode| eq |OFF|) then
    SNAP OFF
    !form.snap.val = FALSE
endif

-- $P snap is set to $!form.snapOn, snap grid is $!sgrid

!form.snap.setToolTip(|SNAP to grid|)

endfunction
-- End of function definition for !!tog2dSnap
