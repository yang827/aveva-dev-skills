------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Load Text...|, 'CDRTEXREAD', 'LoadText')
  !menu.add('CALLBACK', |Clean Up Annotation|, |CALLDRG UDELNULL|, 'CleanUpAnnotation')
  !menu.add('SEPARATOR')
--  !menu.add('FORM', |Dynamic Dim Text...|, 'CDRDMTEXT', 'DynamicDimText')
--  !menu.add('FORM', |Dynamic Proj Text...|, 'CDRPLTEXT', 'DynamicProjText')
--  !menu.add('CALLBACK', |Sort Dimension Points|, |CALLDRG XSORTDIM|, 'SortDimensionPoints')
--  !menu.add('SEPARATOR')
  !menu.add('FORM', |Sketch Drafting...|, 'CDRSPEED', 'SketchDrafting')
  !menu.add('FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'DynamicPrimitives')
  !menu.add('CALLBACK', 'Dynamic Text...', 'show _CDRQTEXT free', 'DynamicText')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

--  67650 no need to disable DGN CE for Outfitting Draft anymore

endmethod
------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .genToolbar toolbar 'General Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('genToolbar', 'GEN')

  -- SB's stuff
  -- Create a frame toolbar for the template default (But only for General User)
  frame .defaultTemplateToolbar toolbar 'Create From Default Template'
    button .createDefaultTemplate tooltip 'Create New From Default Template' pixmap callback  |!!draTemplateSheets('DRAWING', 'DEFAULT', !!ce)|
    button .defaultName toggle tooltip 'Use Default Name' pixmap callback  |!!appDraMain.alignTemplateGadget()|
    option .optionDefaultTemplate '' call |!!draTemplateSheets('DRAWING', 'SELECT', !!ce)| width 25
  exit
  !!appDraMain.createDefaultTemplate.addPixmap(!!pml.getPathName('draft_t_028.png'))
  -- Set the undoable object (It is a temporary solution to use Global variable (Core restriction))
  !!draTemplateSheetsUndo = object UNDOABLE()
  !!draTemplateSheetsUndo.description('Undo Creation by Template')
  !!draTemplateSheetsUndo.undoAction('')
  !!draTemplateSheetsUndo.redoAction('')
  !!appDraMain.createDefaultTemplate.setUndoable(!!draTemplateSheetsUndo)
  !!appDraMain.defaultName.addPixmap(!!pml.getPathName('draft_t_029.png'))
  !!appDraMain.defaultName.val = TRUE
  !!appTbarCntrl.addToolbar('defaultTemplateToolbar', 'GEN')

-- Dimensioning toolbar
  frame .lDimensions toolbar 'Linear Dimensions'
    !iconSize = 16
    do !i from 1 to 5
      button .hlDim$!i pix
      !!appDraMain.hlDim$!i$n.setToolTip(!!dimensionDefinitions.horizontals[!i].description)
      !!appDraMain.hlDim$!i$n.callback = !!dimensionDefinitions.horizontals[!i].callback
      !!appDraMain.hlDim$!i$n.addPixmap(!!dimensionDefinitions.horizontals[!i].icon & !iconSize & '.png')
    enddo
    do !i from 1 to 5
      button .vlDim$!i pix
       !!appDraMain.vlDim$!i$n.setToolTip(!!dimensionDefinitions.verticals[!i].description)
       !!appDraMain.vlDim$!i$n.callback = !!dimensionDefinitions.verticals[!i].callback
       !!appDraMain.vlDim$!i$n.addPixmap(!!dimensionDefinitions.verticals[!i].icon & !iconSize & '.png')
    enddo
    button .moreDims pix
     !!appDraMain.moreDims.setToolTip('Show Dimensioning Form')
     !!appDraMain.moreDims.addPixmap(!!pml.getPathName('draft_t_030.png'))
     !!appDraMain.moreDims.callback = |!!draShowAllToolbars('DIM')|

  exit

-- 2D draughting toolbar (AK - BIG NOTE - I have repositioned some buttons into different groups to
                       --(what SJR had, that's why there are some strange  indexes in the do loops)
  frame .lines toolbar 'Lines'
    do !i to 4
      button .sLine$!i pix
      !!appDraMain.sLine$!i$n.setToolTip(!!drawing2dDefinitions.straights[!i].description)
      !!appDraMain.sLine$!i$n.addPixmap(!!drawing2dDefinitions.straights[!i].icon)
      !!appDraMain.sLine$!i$n.callback = !!drawing2dDefinitions.straights[!i].callback
    enddo
    do !i to 4
      button .cLine$!i pix
      !!appDraMain.cLine$!i$n.setToolTip(!!drawing2dDefinitions.outlines[!i].description)
      !!appDraMain.cLine$!i$n.addPixmap(!!drawing2dDefinitions.outlines[!i].icon)
      !!appDraMain.cLine$!i$n.callback = !!drawing2dDefinitions.outlines[!i].callback
    enddo
    !count = 0
    do !i from 5 to 6
      !count = !count + 1
      button .cLine$!i pix
      !!appDraMain.cLine$!i$n.setToolTip(!!drawing2dDefinitions.arcs[!count].description)
      !!appDraMain.cLine$!i$n.addPixmap(!!drawing2dDefinitions.arcs[!count].icon)
      !!appDraMain.cLine$!i$n.callback = !!drawing2dDefinitions.arcs[!count].callback
    enddo
    button .more2d pix
     !!appDraMain.more2d.setToolTip('Add all 2D drawing primitives')
     !!appDraMain.more2d.addPixmap(!!pml.getPathName('commore16.png'))
     !!appDraMain.more2d.callback = |!!draShowAllToolbars('2D')|
  exit

  frame .shapes toolbar  'Shapes'
     do !i to 3
       button .shape$!i pix
       !!appDraMain.shape$!i$n.setToolTip(!!drawing2dDefinitions.circles[!i].description)
       !!appDraMain.shape$!i$n.addPixmap(!!drawing2dDefinitions.circles[!i].icon)
       !!appDraMain.shape$!i$n.callback = !!drawing2dDefinitions.circles[!i].callback
     enddo
     !count = 0
     do !i from 4 to 7
       !count = !count + 1
       button .shape$!i pix
       !!appDraMain.shape$!i$n.setToolTip(!!drawing2dDefinitions.shapes[!count].description)
       !!appDraMain.shape$!i$n.addPixmap(!!drawing2dDefinitions.shapes[!count].icon)
       !!appDraMain.shape$!i$n.callback = !!drawing2dDefinitions.shapes[!count].callback
     enddo
     button .shape8 pix
     !!appDraMain.shape8.setToolTip(!!drawing2dDefinitions.rectangles[1].description)
     !!appDraMain.shape8.addPixmap(!!drawing2dDefinitions.rectangles[1].icon)
     !!appDraMain.shape8.callback = !!drawing2dDefinitions.rectangles[1].callback

  exit

  !geoms[1] = 'symbols[1]'
  !geoms[2] = 'rectangles[2]'
  !geoms[3] = 'shapes[5]'

  frame .symbols  toolbar 'Symbols'
    do !i to 3
      button .symb$!i pix
      !!appDraMain.symb$!i$n.setToolTip(!!drawing2dDefinitions$n.$!geoms[$!i]$n.description)
      !!appDraMain.symb$!i$n.addPixmap(!!drawing2dDefinitions$n.$!geoms[$!i]$n.icon)
      !!appDraMain.symb$!i$n.callback = !!drawing2dDefinitions$n.$!geoms[$!i]$n.callback
    enddo
  exit

  frame .texts  toolbar 'Text'
    do !i to 4
      button .text$!i  pix
      !!appDraMain.text$!i$n.setToolTip(!!drawing2dDefinitions.text[!i].description)
      !!appDraMain.text$!i$n.addPixmap(!!drawing2dDefinitions.text[!i].icon)
      !!appDraMain.text$!i$n.callback = !!drawing2dDefinitions.text[!i].callback
    enddo
  exit

  -- DUN0768: Add the new Labels toolbar
  do !i from 1 to 8
    !path[!i] = !!pml.getPathName('draft_lab_0$!i$n.png')
  enddo

  !dText[1] = 'General'
  !dText[2] = 'Symbolic'
  !rText[1] = 'GLAB'
  !rText[2] = 'SLAB'

$( Deferred until a later release
  frame .labels toolbar 'Labels'
    option .optLabType callback |!!draLabelsInterface('LABTYPE')| $
      tooltip |Choose between the General and Symbol label type| width 6
    !!appDraMain.optLabType.dText = !dText
    !!appDraMain.optLabType.rText = !rText
    !!appDraMain.optLabType.val = 1
    option .optAttaType 'Attach to:' tagwidth 5 callback |!!draLabelsInterface('ATTATYPE')| $
      tooltip |Choose the method of picking the referred element| width 8
    !dText[1] = 'the Origin'
    !dText[2] = 'a P-point'
    !dText[3] = 'a P-line'
    !rText[1] = 'ID'
    !rText[2] = 'IDP'
    !rText[3] = 'IDPD'
    !!appDraMain.optAttaType.dText = !dText
    !!appDraMain.optAttaType.rText = !rText
    !!appDraMain.optAttaType.val = 1
    button .btnLabel1 pixmap "$!path[1]" callback |!!draLabelsInterface('STRA')| $
      tooltip |Place a label with a straight leader line| width 16 height 16
    button .btnLabel2 pixmap "$!path[2]" callback |!!draLabelsInterface('HA')| $
      tooltip |Place a label with the leader line horizontal, then angled| width 16 height 16
    button .btnLabel3 pixmap "$!path[3]" callback |!!draLabelsInterface('AH')| $
      tooltip |Place a label with the leader angled, then horizontal| width 16 height 16
    button .btnLabel4 pixmap "$!path[4]" callback |!!draLabelsInterface('VA')| $
      tooltip |Place a label with the leader vertical, then angled| width 16 height 16
    button .btnLabel5 pixmap "$!path[5]" callback |!!draLabelsInterface('AV')| $
      tooltip |Place a label with the leader angled, then vertical| width 16 height 16
    button .btnLabel6 pixmap "$!path[6]" callback |!!draLabelsInterface('NO')| $
      tooltip |Place a label with no leader line| width 16 height 16
    button .btnLabMod pixmap "$!path[7]" callback |!!draLabelsInterface('MODIFY')| $
      tooltip |Modify label properties| width 16 height 16
  exit
$)

  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'GEN')
  -- !!appTbarCntrl.addToolbar('currentLayerToolbar', 'GEN')
  !!appTbarCntrl.addToolbar('layerToolbar', 'GEN')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('MENU', |Copy|, 'MBCOPY', 'Copy')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Department...|, |CALLDRG XDEPT CREATE|, 'Department')
  !menu.add('CALLBACK', |Registry...|, |CALLDRG XREGI CREATE|, 'Registry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Drawing|, 'MBCRDRWG', 'Drawing')
  !menu.add('MENU', |Sheet|, 'MBCRSHEE', 'Sheet')
  !menu.add('CALLBACK', |Overlay...|, |CALLDRG XOLAY CREATE|, 'Overlay')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |View|, 'MBVIEW', 'View')
  !menu.add('CALLBACK', |Drawlist...|, |CALLDRG XDRAWLIST CREATE|, 'Drawlist')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Layer...|, |CALLIBM FCREATE LAYE NO $<$>|, 'Layer')
  !menu.add('CALLBACK', |Note...|, |CALLDRG XCRNOTE|, 'Note')
  !menu.add('MENU', |Dimension|, 'MBDIMENSION', 'Dimension')
  !menu.add('MENU', |Label|, 'MBLABEL', 'Label')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBDIMENSION')
  !menu.add('CALLBACK', |Dimension Linear... |, |call !!draSetLayer('_CDRLDIM','DIM')|, 'DimensionLinear')
  !menu.add('CALLBACK', |Dimension Angular...|, |call !!draSetLayer('_CDRADIM','DIM')|, 'DimensionAngular')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Dimension Toolbar...|, |call !!draSetLayer('!!draCrDims3','DIM')|, 'DimensionToolbar')
  --!menu.add('CALLBACK', |Dimension Toolbar...|, |call !!draSetLayer('!!draCrDims','DIM')|
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBLABEL')
--  !menu.add('CALLBACK', |Symbolic Label...|, |CALLDRS XLABEL CREATE|, 'SymbolicLabel')
--  !menu.add('CALLBACK', |General Label... |, |CALLDRS XGLABED CREATE|, 'GeneralLabel')
--  !menu.add('CALLBACK', |Fast Labelling... |, |!!draLabelsInterface('STRA')|, 'Labelling')
--  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |General/Symbolic... |, |show !!draLabels|, 'GeneralLabel')
  !menu.add('FORM', |Autotagging...|, 'CDRMTAGRULE', 'Autotagging')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Pipe End Labels|, 'PEND', 'PipeEndLabels')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('PEND')
  !menu.add('CALLBACK', |Identified|, |CALLDRS MPIPEEND|, 'Identified')
  !menu.add('FORM', |Automatic...|, 'CDRAUTOPEND', 'Automatic')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBCOPY')
  !menu.add('CALLBACK', |CE...|, |var !!cdCopyType 'CE'
  show _CDRTLCOPY|, 'CE')
  !menu.add('CALLBACK', |Identified...|, |var !!cdCopyType 'Identify'
  show _CDRTLCOPY|, 'Identified')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Drawing...|, |var !!cdCopyType 'DRWG'
  show _CDRTLCOPY|, 'Drawing')
  !menu.add('CALLBACK', |Sheet...|, |var !!cdCopyType 'SHEE'
  show _CDRTLCOPY|, 'Sheet')
  !menu.add('CALLBACK', |Sheet Note...|, |var !!cdCopyType 'NOTE'
  show _CDRTLCOPY|, 'SheetNote')
  !menu.add('CALLBACK', |View...|, |var !!cdCopyType 'VIEW'
  show _CDRTLCOPY|, 'View')
  !menu.add('CALLBACK', |Layer...|, |var !!cdCopyType 'LAYE'
  show _CDRTLCOPY|, 'Layer')
  !menu.add('CALLBACK', |Layer Note...|, |var !!cdCopyType 'VNOT'
  show _CDRTLCOPY|, 'LayerNote')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBCRDRWG')
  !menu.add('CALLBACK', |Explicitly...|, |CALLDRG XDRWG CREATE|, 'Explicitly')
  -- old version, replaced by SB's version below (2004-01-23)
  -- !menu.add('CALLBACK', |From Template...|, |CALLDRG XTEMPLATE DRWG|, 'FromTemplate')
  -- SB's version, added 2004-01-23
  !menu.add('CALLBACK', |From Template...|, |CALL !!draTemplateSheets('DRAWING', 'CREATE', !!ce)|, 'FromTemplate')
  !menu.add('CALLBACK', |From Default Template...|, |CALL !!draTemplateSheets('DRAWING', 'DEFAULT', !!ce)|, 'FromDefaultTemplate')
  !!appDraMain.mbCrDrwg.setActive(|From Default Template...|, false)
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBCRSHEE')
  !menu.add('CALLBACK', |Explicitly...|, |CALLDRG XSHEET CREATE|, 'Explicitly')
  -- !menu.add('CALLBACK', |From Template...|, |CALLDRG XTEMPLATE SHEE|, 'FromTemplate')
  -- more stuff added 2004-01-23
  !menu.add('CALLBACK', |From Template...|, |CALL !!draTemplateSheets('SHEET', 'CREATE', !!ce)|, 'FromTemplate')
  !menu.add('CALLBACK', |From Default Template...|, |CALL !!draTemplateSheets('SHEET', 'DEFAULT', !!ce)|, 'FromDefaultTemplate')
  !!appDraMain.mbCrShee.setActive(|From Default Template...|, false)
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW CREATE ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User-defined...|, |CALLDRG XVIEW CREATE USER|, 'Userdefined')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Detail...|, 'CDRDETVIEW', 'Detail')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Predefined Frame...|, |CALLDRG XVIEWCONF|, 'PredefinedFrame')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Section Flat...|, |CALLDRG XPLANE _CDRFPLANE|, 'SectionFlat')
  !menu.add('CALLBACK', |Section Perpendicular...|, |CALLDRG XPLANE _CDRPPLANE|, 'SectionPerpendicular')
  !menu.add('CALLBACK', |Section Stepped...|, |CALLDRG XPLANE _CDRSPLANE|, 'SectionStepped')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Local Rules...|, |var !!cdLibRule 'False'
  CALLMREP XLIBMREP VIEW|, 'LocalRules')
  !menu.add('CALLBACK', |Hatching Rules...|, |var !!cdLibHRule 'False'
  CALLMREP XLIBMREPH VIEW|, 'HatchingRules')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('CALLBACK', |Name...|, |!!exitModifyMode()
   show _CDRNAME|, 'exitModifyModeName')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Department...|, 'CDRDEPTATT', 'Department')
  !menu.add('FORM', |Registry...|, 'CDRREGIATT', 'Registry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Drawing|, 'MBMDRAWING', 'Drawing')
  !menu.add('MENU', |Sheet|, 'MBMSHEET', 'Sheet')
  !menu.add('CALLBACK', |Overlay...|, |CALLDRG XOLAY MODIFY|, 'Overlay')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |View|, 'MBMVIEW', 'View')
  !menu.add('CALLBACK', |Drawlist...|, |CALLDRG XDRAWLIST MODIFY|, 'Drawlist')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Layer|, 'MBMLAYER', 'Layer')
  !menu.add('MENU', |Note|, 'MBMNOTE', 'Note')
  !menu.add('MENU', |Dimension|, 'MBMODIFYDIM', 'Dimension')
  !menu.add('MENU', |Label|, 'MBMODIFYLAB', 'Label')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Blanking...|, 'CDRE2DBLANK', 'Blanking')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMLAYER')
  !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
   show _CDRLAYER|, 'Definition')
  !menu.add('CALLBACK', |Attributes...|, |!!exitModifyMode()
   CALLDRG XLAYATT NOFORM|, 'Attributes')
  !menu.add('CALLBACK', |Members...|, |!!exitModifyMode()
   show _CDRLAYMEM|, 'Members')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMNOTE')
  !menu.add('CALLBACK', |Sheet...|, |CALLDRG XMNOTE MODIFY NOTE SHEET|, 'Sheet')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE MODIFY VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMODIFYDIM')
  !menu.add('CALLBACK', |Dimension Definition...|, |!!exitModifyMode()
   CALLDRD IMDIM|, 'DimensionDefinition')
  !menu.add('CALLBACK', |Dimension Colour & Font...|, |!!exitModifyMode()
   show _CDRDIMPENS|, 'DimensionColourFont')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Dimension Line...|, |!!exitModifyMode()
   show _CDRDIMATT|, 'DimensionLine')
  !menu.add('CALLBACK', |Projection Line...|, |!!exitModifyMode()
   CALLDRD XPROATT|, 'ProjectionLine')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Dimension Points...|, |!!exitModifyMode()
   CALLDRD XDIMPOINTS|, 'DimensionPoints')
  !menu.add('CALLBACK', |Dimension Blanking...|, |!!exitModifyMode()
   show _CDRDIMBLANK|, 'DimensionBlanking')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Dimension Text...|, 'CDRDMTEXT', 'DimText')
  !menu.add('FORM', |Projection Text...|, 'CDRPLTEXT', 'ProjText')
  !menu.add('CALLBACK', |Sort Dimension Points|, |CALLDRG XSORTDIM|, 'SortDimensionPoints')
  !!appMenuCntrl.addMenu(!menu, 'GEN')



  !menu = object APPMENU('MBMODIFYLAB')
--  !menu.add('MENU', |Symbolic Label|, 'MBSLAB', 'SymbolicLabel')
--  !menu.add('CALLBACK', |Fast Labelling... |, |!!draLabelsInterface('MODIFY')|, 'Labelling')
--  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
   show !!draLabels|, 'Definition')
  !menu.add('CALLBACK', |Autotagging...|, |!!exitModifyMode()
   show _CDRMTAGRULE|, 'Autotagging')
  !menu.add('CALLBACK', |Label Placement...|, |!!exitModifyMode()
   show _CDRINTELL|, 'LabelPlacement')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Label Visibility...|, |!!exitModifyMode()
   show _CDRLABELVIS|, 'LabelVisibility')
  !menu.add('CALLBACK', |Label Blanking...|, |!!exitModifyMode()
   show _CDRLABBLANK|, 'LabelBlanking')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

 -- !menu = object APPMENU('MBSLAB')
 -- !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
 --  show !!draLabels|, 'Definition')
 -- !menu.add('CALLBACK', |Attributes...|, |!!exitModifyMode()
 --  show _CDRSLABATT|, 'Attributes')
 -- !!appMenuCntrl.addMenu(!menu, 'GEN')
 --
 -- !menu = object APPMENU('MBGLAB')
 -- !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
 --  show !!draLabels|, 'Definition')
 -- !menu.add('CALLBACK', |Text Contents...|, |!!exitModifyMode()
 --  show _CDRQTEXT|, 'TextContents')
 -- !menu.add('CALLBACK', |Text Settings...|, |!!exitModifyMode()
 --  show _CDRGLTXATT|, 'TextSettings')
 -- !menu.add('CALLBACK', |Frame...|, |!!exitModifyMode()
 --  show _CDRGLLFATT|, 'Frame')
 -- !menu.add('CALLBACK', |Leader Line...|, |!!exitModifyMode()
 --  show _CDRGLLLATT|, 'LeaderLine')
 -- !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMDRAWING')
  !menu.add('CALLBACK', |Definition...|, |CALLDRG XDRWG MODIFY|, 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRDRWGATT', 'Attributes')
  !menu.add('CALLBACK', |Drawlist Ref...|, |CALLDRG XMIDLNAM DRWG|, 'DrawlistRef')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMSHEET')
  !menu.add('CALLBACK', |Definition...|, |CALLDRG XSHEET MODIFY|, 'Definition')
  !menu.add('CALLBACK', |Drawlist Ref...|, |CALLDRG XMIDLNAM SHEE|, 'DrawlistRef')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBMVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW MODIFY ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User-defined...|, |CALLDRG XVIEW MODIFY USER|, 'Userdefined')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Section Flat...|, |CALLDRG XPLANE _CDRMFPLANE|, 'SectionFlat')
  !menu.add('CALLBACK', |Section Perpendicular...|, |CALLDRG XPLANE _CDRMPPLANE|, 'SectionPerpendicular')
  !menu.add('CALLBACK', |Section Stepped...|, |CALLDRG XPLANE _CDRMSPLANE|, 'SectionStepped')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Local Rules...|, |var !!cdLibRule 'False'
  CALLMREP XLIBMREP VIEW|, 'LocalRules')
  !menu.add('CALLBACK', |Hatching Rules...|, |var !!cdLibHRule 'False'
  CALLMREP XLIBMREPH VIEW|, 'HatchingRules')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Drawlist Ref...|, |CALLDRG XMIDLNAM VIEW|, 'DrawlistRef')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |!!exitModifyMode()
   CALLDRG MDELCE|, 'exitModifyModeCE')
  !menu.add('CALLBACK', |Members|, |!!exitModifyMode()
   CALLDRG MDELMEM|, 'exitModifyModeMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |!!exitModifyMode()
   OWNER
   CALLDRG MDELCE|, 'exitModifyModeOwner')
  !menu.add('CALLBACK', |Owner Members|, |!!exitModifyMode()
   OWNER
   CALLDRG MDELMEM|, 'exitModifyModeOwnerMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Group Members|, |CALLDRG XDELETEN|, 'GroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  !menu = object APPMENU('E2DDRAW')
  !menu.add('CALLBACK', |Primitives...|, |show !!draCrPrims|, 'Primitives')
  !menu.add('CALLBACK', |Local Symbol...|, |CALLEDR INITSHOW _CDRUSRSYMB|, 'LocalSymbol')
  !!appMenuCntrl.addMenu(!menu, 'GEN')
  -- add to other applications as well to save defining all this again
--  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('E2DCONSTRU')
  !menu.add('FORM', |Group...|, 'CDRUGROUP', 'Group')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |2D Copy|, |CALLEDR XCOPYPRIM|, '2DCopy')
  !menu.add('MENU', |Repeat|, 'E2DCONSTARRAY', 'Repeat')
  !menu.add('CALLBACK', |Mirror...|, |show _CDRMIRCOPY free|, 'Mirror')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Fillet Arc...|, |CALLEDR XFILL|, 'FilletArc')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Chamfer Line...|, |CALLEDR XCHAM|, 'ChamferLine')
  !menu.add('CALLBACK', |Parallel Line...|, |show _CDROFFSET free|, 'ParallelLine')
  !menu.add('CALLBACK', |Tangent Line...|, |CALLEDR XTANL|, 'TangentLine')
  !menu.add('CALLBACK', |Ray Line...|, |CALLEDR XRAYL|, 'RayLine')
  !menu.add('CALLBACK', |Constructed Line...|, |CALLEDR XCONL|, 'ConstructedLine')
  !menu.add('CALLBACK', |Bisector Line...|, |CALLEDR XBISL|, 'BisectorLine')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Local Symbol...|, |CALLEDR XUSRSYMB CREATE|, 'LocalSymbol')
  !!appMenuCntrl.addMenu(!menu, 'GEN')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('E2DEDIT')
  !menu.add('CALLBACK', |Primitive...|, |CALLEDR XMODATTS|, 'Primitive')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Move Primitive/Node To|, 'E2DNAT', 'MovePrimitiveNodeTo')
  !menu.add('MENU', |Move Primitives By|, 'E2DPBY', 'MovePrimitivesBy')
  !menu.add('MENU', |Move Node By|, 'E2DNBY', 'MoveNodeBy')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Line Gap|, 'E2DBREAK', 'LineGap')
  !menu.add('CALLBACK', |Line Trim|, |CALLEDR XTRIM|, 'LineTrim')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Rotate...|, |CALLEDR XROTATE|, 'Rotate')
  !menu.add('CALLBACK', |Demolish Symbol|, |CALLEDR XEXPLDSYMB|, 'DemolishSymbol')
  !menu.add('FORM', |Action Group...|, 'CDRMODGROUP', 'ActionGroup')
  !!appMenuCntrl.addMenu(!menu, 'GEN')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('E2DDUMMY')
  !!appMenuCntrl.addMenu(!menu, 'GEN')

  -- $* lower level menus -----------------------------------
  -- delete !menu variable so it can be reassigned as MENU rather than APPMENU
  !menu.delete()

  !menu = !!appDraMain.newMenu('E2DCONSTARRAY')
  -- either whole menu is visible or none is visible, so we don't need to control the fields on it - create menu directly
  !menu.add('CALLBACK', |Offset...|, |CALLEDR XMULCOPY|, 'Offset')
  !menu.add('CALLBACK', |Rows & Columns...|, |CALLEDR INITSHOW _CDRMATCOPY|, 'RowsColumns')
  !menu.add('CALLBACK', |Polar...|, |CALLEDR XCENCOPY|, 'Polar')

  !menu = !!appDraMain.newMenu('E2DBREAK')
  !menu.add('CALLBACK', |Zero Length|, |CALLEDR XBREAK NOGAP|, 'ZeroLength')
  !menu.add('CALLBACK', |Default Length|, |CALLEDR XBREAK AUTOGAP|, 'DefaultLength')
  !menu.add('CALLBACK', |Start, End|, |CALLEDR XBREAK DEFINEDGAP|, 'StartEnd')

  -- $* new prim/node Drag and move menu options
  !menu = !!appDraMain.newMenu('E2DPBY')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MPBY BY|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MPBY BYEX|, 'XY')

  !menu = !!appDraMain.newMenu('E2DNAT')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MNPOS AT|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MNPOS ATEX|, 'XY')

  --Menu Text Relates to Coordinate System
  if !!coords.isxyz() then
    !coordMenuText = 'X,Y,Z...'
  else
    !coordMenuText = 'E,N,U...'
  endif

  !menu.add('FORM', !coordMenuText, 'CDRNODEPOS', 'ENU')
  !menu.add('FORM', |Pline...|, 'CDRNODEPLINE', 'Pline')
  !menu.add('FORM', |Design Element...|, 'CDRNODEPOINT', 'DesignElement')

  !menu = !!appDraMain.newMenu('E2DNBY')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MNBY BY|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MNBY BYEX|, 'XY')

endmethod

