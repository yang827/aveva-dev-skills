-- Author:          Steve Wilson
-- Created:         Fri 14 Nov 2008
--
-- Description:
-- Object to control the Layer Toolbar
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Clear the object
--  clearAll()                       -                   Clear all object members
--  firstAvailable(STRING)           STRING              Return the first available layer of the passed type
--  getAllLayers(DBREF,REAL)         -                   Get data
--  getDimLayers(DBREF,REAL)         -                   Get all dimension layers in the sheet
--  getDraLayers(DBREF,REAL)         -                   Get all 2D draughting layers in the sheet
--  getLabLayers(DBREF,REAL)         -                   Get all label layers in the sheet
--  getNotesViews(STRING,BOOLEAN)    -                   Get all notes and views for the passed sheet
--  getViewLayer(DBREF)              DBREF               Get the first available valid layer for the passed view
--  populateToolbar(STRING,REAL)     -                   Populate the main form layer toolbar
--  reorder(STRING)                  -                   Reorder the arrays after a hierarchy reorder
--  selectElement(DBREF)             -                   Selected the passed element
--  selectNoteView()                 -                   Select the chosen note or view
--  setActive(STRING)                -                   Set the toolbar and this object active
--  setInactive(STRING)              -                   Set the toolbar and this object inactive
--  setLayers(STRING)                -                   Set the layers for the chosen layer type
--  toolbarActive(STRING,BOOLEAN)    -                   Set the layer toolbar active state
--  toolbarClear()                   -                   Clear the relevant layer toolbar gadgets
--
------------------------------------------------------------------------
define object APPDRALAYERCTRL

  -- The sheet being handled
  member .sheetName  is STRING

  -- All notes and views
  member .notesViews is ARRAY

  -- Names of Dimensions layers
  member .dimLayers  is ARRAY

  -- Names of 2D Draughting layers
  member .draLayers  is ARRAY

  -- Names of Label layers
  member .labLayers  is ARRAY

endobject
-- End of object definition for APPDRALAYERCTRL

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear the object
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.notesViews.clear()
  !this.dimLayers.clear()
  !this.draLayers.clear()
  !this.labLayers.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .clearAll()
--
-- Description:   Clear all object members
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearAll()

  !this.sheetName = ''
  !this.notesViews.clear()
  !this.dimLayers.clear()
  !this.draLayers.clear()
  !this.labLayers.clear()

endmethod
-- End of method definition for .clearAll()

------------------------------------------------------------------------
--
-- Method:        .firstAvailable(STRING)
--
-- Description:   Return the first available layer of the passed type
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The layer type ALL, DIM, LAB or DRA
--
-- Return:
--   [Data Type] [Description]
--    STRING      The layer name
--
------------------------------------------------------------------------
define method .firstAvailable(!layerType is STRING) is STRING

  -- Initialise variables
  !index     = !!cdrGenApp.notesViews.val
  !layerName = STRING()

  -- Try all layer arrays in turn
  if (!layerType.eq('ALL')) then

    if (defined(!this.dimLayers[!index][1])) then
      !layerName = !this.dimLayers[!index][1]

    elseif (defined(!this.labLayers[!index][1])) then
      !layerName = !this.labLayers[!index][1]

    elseif (defined(!this.draLayers[!index][1])) then
      !layerName = !this.draLayers[!index][1]

    endif

  -- Get the first dimension layer
  elseif (!layerType.eq('DIM')) then

    if (defined(!this.dimLayers[!index][1])) then
      !layerName = !this.dimLayers[!index][1]
    endif

  elseif (!layerType.eq('LAB')) then

    if (defined(!this.labLayers[!index][1])) then
      !layerName = !this.labLayers[!index][1]
    endif

  elseif (!layerType.eq('DRA')) then

    if (defined(!this.draLayers[!index][1])) then
      !layerName = !this.draLayers[!index][1]
    endif

  endif

  return !layerName

endmethod
-- End of method definition for .firstAvailable(STRING)

------------------------------------------------------------------------
--
-- Method:        .getAllLayers(DBREF,REAL)
--
-- Description:   Get data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The selected note or view
--    2   R      REAL        The selected note or view index in !this.notesViews array
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllLayers(!elemRefe is DBREF, !index is REAL)

  -- In order to display all layers we have to get them all
  !this.getDimLayers(!elemRefe, !index)

  !this.getDraLayers(!elemRefe, !index)

  !this.getLabLayers(!elemRefe, !index)

endmethod
-- End of method definition for .getAllLayers(DBREF,REAL)

------------------------------------------------------------------------
--
-- Method:        .getDimLayers(DBREF,REAL)
--
-- Description:   Get all dimension layers in the sheet
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The selected note or view
--    2   R      REAL        The selected note or view index in !this.notesViews array
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDimLayers(!elemRefe is DBREF, !index is REAL)

  -- Get all possible purposes for dimension layers
  !purpTest = !!cdrPrpDflts.attribute('DIM').val

  -- Get dimension layers
  VAR !layerNames EVAL FULLNAME FOR ALL LAYER WITH (NOT(UNSET(PURP))) AND MATCH(!purpTest,(SUBSTRING(PURP,1,3))) NEQ 0 FOR $!elemRefe

  !this.dimLayers[!index] = !layerNames.sort()

endmethod
-- End of method definition for .getDimLayers(DBREF,REAL)

------------------------------------------------------------------------
--
-- Method:        .getDraLayers(DBREF,REAL)
--
-- Description:   Get all 2D draughting layers in the sheet
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The selected note or view
--    2   R      REAL        The selected note or view index in !this.notesViews array
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDraLayers(!elemRefe is DBREF, !index is REAL)

  -- Clear array
  !this.draLayers[!index].clear()

  -- For a note, it is a layer in its own right, hence it is the only entry in the .layNam option gadget
  if (!elemRefe.hardtype.eq('NOTE')) then
    !this.draLayers[!index].append(!elemRefe.fullname)

  else

    VAR !layerNames EVAL FULLNAME FOR ALL VNOT FOR $!elemRefe

    !this.draLayers[!index] = !layerNames.sort()

  endif

endmethod
-- End of method definition for .getDraLayers(DBREF,REAL)

------------------------------------------------------------------------
--
-- Method:        .getLabLayers(DBREF,REAL)
--
-- Description:   Get all label layers in the sheet
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The selected note or view
--    2   R      REAL        The selected note or view index in !this.notesViews array
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getLabLayers(!elemRefe is DBREF, !index is REAL)

  -- Get all possible purposes for label layers
  !purpTest = !!cdrPrpDflts.attribute('LAB').val

  -- Get label layers
  VAR !layerNames EVAL FULLNAME FOR ALL LAYER WITH (NOT(UNSET(PURP))) AND MATCH(!purpTest,(SUBSTRING(PURP,1,3))) NEQ 0 FOR $!elemRefe

  !this.labLayers[!index] = !layerNames.sort()

endmethod
-- End of method definition for .getLabLayers(DBREF,REAL)

-----------------------------------------------------------------------
--
-- Method:        .getNotesViews(STRING,BOOLEAN)
--
-- Description:   Get all notes and views for the passed sheet
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The name of the SHEE under which to search
--    2   R      BOOLEAN     Whether to initialise the main form toolbar gadget or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getNotesViews(!sheetName is STRING, !initialise is BOOLEAN)

  -- Clear this object
  !this.clear()

  -- Clear the toolbar option gadgets
  !this.toolbarClear()

  -- Previously, the sheet was the managed element for layers
  -- But for a large number of layers this was prohibitively slow
  -- The idea is to now manage by Notes and View

  -- Initialise variables
  !dtext = ARRAY()
  !count = 0

  -- Get all notes and views
  VAR !allNotes COLL ALL NOTE FOR $!sheetName
  VAR !allViews COLL ALL VIEW FOR $!sheetName

  !this.notesViews = !allNotes
  !this.notesViews.appendArray(!allViews)

  -- Define all layer arrays, one for each note
  -- These will hold their respective layers
  -- We do not populate the arrays here, only when needed in the .selectElement method
  do !index from 1 to !this.notesViews.size()

    -- Raise the counter
    !count = !count + 1

    -- Reset the counter when the end of the notes has been reached
    if (!index.eq(!allNotes.size() + 1)) then
      !count = 1
    endif

    -- Build the layer arrays
    !this.dimLayers[!index] = ARRAY()
    !this.draLayers[!index] = ARRAY()
    !this.labLayers[!index] = ARRAY()

    -- Build display text
    if (!index.leq(!allNotes.size())) then
      !dtext[!index]          = 'Note ' & !count

    else
      !dtext[!index]          = 'View ' & !count

    endif

  enddo

  -- Populate the notes & views option gadget
  !!cdrGenApp.notesViews.dtext = !dtext
  !!cdrGenApp.notesViews.rtext = !this.notesViews

  -- Access the first available, which allows draTrackMain to take over
  -- Check though for any existing notes/views
  if (!initialise and !this.notesViews.set()) then
    !!cdrGenApp.notesViews.val = 1
    !!cdrGenApp.layerControl.selectElement(!this.notesViews[1].dbref())

  endif

endmethod
-- End of method definition for .getNotesViews(STRING,BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .getViewLayer(DBREF)
--
-- Description:   Get the first available valid layer for the passed view
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The VIEW under which to search
--
-- Return:
--   [Data Type] [Description]
--    DBREF       The reference of the first available layer
--
------------------------------------------------------------------------
define method .getViewLayer(!viewRefe is DBREF) is DBREF

  -- Get all dimension layers
  !purpTest = !!cdrPrpDflts.attribute('DIM').val
  VAR !allLayers COLL ALL LAYER WITH (NOT(UNSET(PURP))) AND MATCH(!purpTest,(SUBSTRING(PURP,1,3))) NEQ 0 FOR $!viewRefe

  -- Return the first found
  if (defined(!allLayers[1])) then
    !firstLaye = !allLayers[1].dbref()

  else

    -- Get all 2D draughting layers
    VAR !allLayers COLL ALL VNOT FOR $!viewRefe

    if (defined(!allLayers[1])) then
      !firstLaye = !allLayers[1].dbref()

    else

      -- Get all label layers
      !purpTest = !!cdrPrpDflts.attribute('LAB').val
      VAR !allLayers COLL ALL LAYER WITH (NOT(UNSET(PURP))) AND MATCH(!purpTest,(SUBSTRING(PURP,1,3))) NEQ 0 FOR $!viewRefe

      if (defined(!allLayers[1])) then
        !firstLaye = !allLayers[1].dbref()

      else
        !firstLaye = object DBREF()

      endif

    endif

  endif

  return !firstLaye

endmethod
-- End of method definition for .getViewLayer(DBREF)

------------------------------------------------------------------------
--
-- Method:        .populateToolbar(STRING,REAL)
--
-- Description:   Populate the main form layer toolbar
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The layer type
--    2   R      REAL        The index of the relevant array that holds the data
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateToolbar(!layerType is STRING, !index is REAL)

  -- Initialise the gadget
  !!cdrGenApp.layeNam.clear()

  if (!layerType.eq('ALL')) then

    !dtext = !this.dimLayers[!index]
    !dtext.appendArray(!this.draLayers[!index])
    !dtext.appendArray(!this.labLayers[!index])

  elseif (!layerType.eq('DIM')) then

    !dtext = !this.dimLayers[!index]

  elseif (!layerType.eq('DRA')) then

    !dtext = !this.draLayers[!index]

  elseif (!layerType.eq('LAB')) then

    !dtext = !this.labLayers[!index]

  endif

  !!cdrGenApp.layeNam.dtext = !dtext

endmethod
-- End of method definition for .populateToolbar(STRING,REAL)

------------------------------------------------------------------------
--
-- Method:        .reorder(STRING)
--
-- Description:   Reorder the notes/views array after a hierarchy reorder
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     The name of the element being moved
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reorder(!elemName is STRING)

  -- Initialise variables
  !elemRefe   = !elemName.dbref()
  !elemSysRef = !elemRefe.string()
  !elemType   = !elemRefe.type
  !sheetName  = !this.sheetName
  !count      = 0
  !sort       = ARRAY()

  -- Stop here if the element is not a note or a view
  if (!elemType.neq('NOTE') and !elemType.neq('VIEW')) then
    return
  endif

  -- Get all notes and views for the working sheet
  VAR !allNotes COLL ALL NOTE FOR $!sheetName
  VAR !allViews COLL ALL VIEW FOR $!sheetName

  !notesViews = !allNotes
  !notesViews.appendArray(!allViews)

  -- Find out where the element has moved to
  !itIsHere = !notesViews.findfirst(!elemSysRef)

  -- Find out where it was
  !itWasHere = !this.notesViews.findfirst(!elemSysRef)

  -- Belts & braces: If it has not moved, then stop here
  if (!itIsHere.eq(!itWasHere)) then
    return
  endif

  -- Build an array for sorting
  do !index from 1 to !this.notesViews.size()

    -- Ignore where it used to be
    skip if (!index.eq(!itWasHere))

    -- Add the sequential number
    !sort.append(!index)

  enddo

  -- Insert where it was into where it is now
  !sort.insert(!itIsHere,!itWasHere)

  -- Sort all arrays
  !this.notesViews.reindex(!sort)
  !this.dimLayers.reindex(!sort)
  !this.labLayers.reindex(!sort)
  !this.draLayers.reindex(!sort)

  -- Reset the notes/views gadget rtext
  !!cdrGenApp.notesViews.rtext = !notesViews

endmethod
-- End of method definition for .reorder(STRING)

------------------------------------------------------------------------
--
-- Method:        .selectElement(DBREF)
--
-- Description:   Selected the passed element
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The selected element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectElement(!dbref is DBREF)

  -- Initialise variables
  !this.sheetName  = !!appDraMain.sheet.selection('RTEXT')

  -- Check to see if a sheet has been selected
  if(!this.sheetName.eq('') and (( dbwrite ) or ( !!dbRefUpdatable(REF) ))) then
    !!alert.error('You must have a sheet selected in order to use the applications')
    return
  endif

  -- Ensure element is of a valid type
  !elementRefe = !!dtbGetOwnerType(!dbref, 'VIEW NOTE LAYE VNOT VSEC')

  -- For no element
  if (!elementRefe.unset()) then
    return
  endif

  -- Get element data
  !elementType = !elementRefe.type
  !elementName = !elementRefe.fullname

  -- For a selected view, display all layers and select the first available vnot
  if (!elementType.eq('VIEW')) then

    !layerType = 'ALL'

    -- If the toolbar does not contain any notes/views or this note/view has just been created
    if (!this.notesViews.empty() or !this.notesViews.findfirst(!elementRefe.string()).unset()) then
      !this.getNotesViews(!this.sheetName, true)

    endif

    -- Select the current one in the toolbar and reset the index
    !!cdrGenApp.notesViews.select('RTEXT',!elementRefe.string())
    !noteViewRefe    = !!cdrGenApp.notesViews.selection('RTEXT').dbref()
    !notesViewsIndex = !!cdrGenApp.notesViews.val

    -- Look for the first available layer
    !elementRefe = !this.getViewLayer(!elementRefe)

    -- For no valid layer, try for any layer
    if (!elementRefe.unset()) then

      if (!this.draLayers[!notesViewsIndex].empty()) then

        if (!this.labLayers[!notesViewsIndex].empty()) then

          if (!this.dimLayers[!notesViewsIndex].empty()) then

            -- There are no layers
            !!cdrGenApp.layeNam.clear()
            !!cdrGenApp.layerFilter.select('RTEXT','ALL')
            return

          else
            !elementRefe = !this.dimLayers[!notesViewsIndex][1].dbref()
          endif

        else
          !elementRefe = !this.labLayers[!notesViewsIndex][1].dbref()
        endif

      else
       !elementRefe = !this.draLayers[!notesViewsIndex][1].dbref()
      endif

    endif

    !elementType = !elementRefe.type
    !elementName = !elementRefe.fullname

  -- Use the determined layer element
  else

    -- Get the layer type DIM, LAB or DRA
    if (!elementType.eq('LAYE')) then

      -- Purpose is unset, so stop here
      if (!elementRefe.purp.trim().eq('')) then
        return

      -- Test for valid DIM layer purpose
      elseif (!!cdrPrpDflts.dim.val.match(!elementRefe.purp.substring(1,3)).neq(0)) then
        !layerType = 'DIM'

      -- Test for valid LAB layer purpose
      elseif (!!cdrPrpDflts.lab.val.match(!elementRefe.purp.substring(1,3)).neq(0)) then
        !layerType = 'LAB'

      -- Test for valid DRA layer purpose
      elseif (!!cdrPrpDflts.dra.val.match(!elementRefe.purp.substring(1,3)).neq(0)) then
        !layerType = 'DRA'

      -- Not a valid layer (as recognised by the setup), so stop here
      else
        return

      endif

      -- Select the owning view in the toolbar and reset the index
      !!cdrGenApp.notesViews.select('RTEXT',!elementRefe.owne.string())
      !noteViewRefe    = !!cdrGenApp.notesViews.selection('RTEXT').dbref()
      !notesViewsIndex = !!cdrGenApp.notesViews.val

    -- Treat all NOTE as 2D draughting
    elseif (!elementType.eq('NOTE')) then
      !layerType = 'DRA'

      -- If this note is not available, then must have been created since the toolbar was populated
      if (!this.notesViews.findfirst(!elementRefe.string()).unset()) then

        -- Get all notes & views for this sheet
        !this.getNotesViews(!this.sheetName, false)

      endif

      -- Select the current one in the toolbar and reset the index
      !!cdrGenApp.notesViews.select('RTEXT',!elementRefe.string())
      !noteViewRefe    = !!cdrGenApp.notesViews.selection('RTEXT').dbref()
      !notesViewsIndex = !!cdrGenApp.notesViews.val

    -- Treat all VNOT as 2D draughting
    elseif(!elementType.eq('VNOT')) then
      !layerType = 'DRA'

      -- Select the owning view in the toolbar and reset the index
      !!cdrGenApp.notesViews.select('RTEXT',!elementRefe.owne.owne.string())
      !noteViewRefe    = !!cdrGenApp.notesViews.selection('RTEXT').dbref()
      !notesViewsIndex = !!cdrGenApp.notesViews.val

    -- Not a valid layer so stop here (Probably a VSEC)
    else
      return

    endif

  endif

  -- Attempt to select the element in the main form layer toolbar
  if (!layerType.eq('ALL')) then

    -- Get all layers
    !this.getAllLayers(!noteViewRefe, !notesViewsIndex)

  elseif (!layerType.eq('DIM')) then

    -- Try to find the element in the dimensions array
    if (!this.dimLayers[!notesViewsIndex].findfirst(!elementName).unset()) then
      !this.getDimLayers(!noteViewRefe,!notesViewsIndex)
    endif

  elseif (!layerType.eq('LAB')) then

    -- Try to find the element in the labels array
    if (!this.labLayers[!notesViewsIndex].findfirst(!elementName).unset()) then
      !this.getLabLayers(!noteViewRefe,!notesViewsIndex)
    endif

  elseif (!layerType.eq('DRA')) then

    -- For a 2D layer, the actual element is a VNOT
    if (!elementType.eq('LAYE')) then

      VAR !allVnot EVAL FULLNAME FOR ALL VNOT FOR $!elementRefe

      if (defined(!allVnot[1])) then
        !elementName = !allVnot[1]

      else
        return

      endif

    endif

    -- Try to find the element in the 2D draughting array
    if (!this.draLayers[!notesViewsIndex].findfirst(!elementName).unset()) then
      !this.getDraLayers(!noteViewRefe,!notesViewsIndex)
    endif

  endif

  -- Select the layer type if different
  if (!!cdrGenApp.layerFilter.selection('RTEXT').neq(!layerType)) then
    !!cdrGenApp.layerFilter.select('RTEXT', !layerType)

  endif

  -- Populate the list with the relevant array
  !this.populateToolbar(!layerType, !notesViewsIndex)

  -- Select the element
  !!cdrGenApp.layeNam.select('DTEXT', !elementName)

  -- Select the visibility
  !!draSetLvisGadget(!elementRefe)

endmethod
-- End of method definition for .selectElement(DBREF)

------------------------------------------------------------------------
--
-- Method:        .selectNoteView()
--
-- Description:   Select the chosen note or view
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectNoteView()

  -- Access the selected note/view and function !!draTrackMain will take over
  !!ce = !!cdrGenApp.notesViews.selection('RTEXT').dbref()

endmethod
-- End of method definition for .selectNoteView()

------------------------------------------------------------------------
--
-- Method:        .setActive(STRING)
--
-- Description:   Set the toolbar and this object active
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The name of the element being loaded
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive(!element is STRING)

  -- Load all notes and views
  !!cdrGenApp.layerControl.getNotesViews(!element, true)

  -- Set toolbar active status
  !!cdrGenApp.layerControl.toolbarActive(!element.dbref().type, true)

endmethod
-- End of method definition for .setActive(STRING)

------------------------------------------------------------------------
--
-- Method:        .setInactive(STRING)
--
-- Description:   Set the toolbar and this object inactive
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The element type being loaded
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setInactive(!type is STRING)

  -- Clear this object members
  !!cdrGenApp.layerControl.clearAll()

  -- Clear the toolbar and set the active status
  !!cdrGenApp.layerControl.toolbarClear()
  !!cdrGenApp.layerControl.toolbarActive(!type, false)

endmethod
-- End of method definition for .setInactive(STRING)

------------------------------------------------------------------------
--
-- Method:        .setLayers(STRING)
--
-- Description:   Set the layers for the chosen layer type
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The layer type 'ALL', 'DIM', 'LAB' or 'DRA'
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLayers(!layerType is STRING)

  -- Read the index of the current selected note or view
  !notesViewsIndex = !!cdrGenApp.notesViews.val
  !noteViewRefe    = !this.notesViews[!notesViewsIndex].dbref()

  -- Get the layers for the passed filter
  if (!layerType.eq('ALL')) then

    -- Get all layers
    !this.getAllLayers(!noteViewRefe,!notesViewsIndex)

    -- Select the view
    !!ce = !noteViewRefe

  elseif (!layerType.eq('DIM')) then

    -- Get all layers if they have not been collected before
    if (!this.dimLayers[!notesViewsIndex].empty()) then
      !this.getDimLayers(!noteViewRefe,!notesViewsIndex)
    endif

    -- If any layers have been found, then select the first
    if (!this.dimLayers[!notesViewsIndex].empty().not()) then
      !!ce = !this.dimLayers[!notesViewsIndex][1].dbref()

    -- If no found layers, clear the toolbar gadget
    else
      !!cdrGenApp.layeNam.clear()
    endif

  elseif (!layerType.eq('LAB')) then

    if (!this.labLayers[!notesViewsIndex].empty()) then
      !this.getLabLayers(!noteViewRefe,!notesViewsIndex)
    endif

    if (!this.labLayers[!notesViewsIndex].empty().not()) then
      !!ce = !this.labLayers[!notesViewsIndex][1].dbref()
    else
      !!cdrGenApp.layeNam.clear()
    endif

  elseif (!layerType.eq('DRA')) then

    if (!this.draLayers[!notesViewsIndex].empty()) then
      !this.getDraLayers(!noteViewRefe,!notesViewsIndex)
    endif

    if (!this.draLayers[!notesViewsIndex].empty().not()) then
      !!ce = !this.draLayers[!notesViewsIndex][1].dbref()
    else
      !!cdrGenApp.layeNam.clear()
    endif

  endif

endmethod
-- End of method definition for .setLayers(STRING)

------------------------------------------------------------------------
--
-- Method:        .toolbarActive(BOOLEAN)
--
-- Description:   Set the layer toolbar active state
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type BACK, OVER, SHTMPL
--    2   R      BOOLEAN     Whether the layer toolbar is active or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbarActive(!elementType is STRING, !state is BOOLEAN)

  -- Initialise variables
  !stateTrue = BOOLEAN()

  -- Get toolbar start-up visibility state
  !statusFile = object FILE(!!appTbarCntrl.statusFile)

  -- Check for existing status file
  if (!statusFile.exists()) then
    !stateTrue = !statusFile.readFile().findfirst('LAYERTOOLBAR:TRUE').set()
  endif

  -- Set the toolbar visibility overriding the decisions made by the common object appTbarCntrl
  if (!state) then

    -- For admin users, we decide whether the toolbar is visible or not
    if (!!appCntrl.currentAppObj().admin) then

      -- We should only set the toolbar visible/active if the start-up state is true or it is currently shown
      if (!stateTrue.eq(true) or !!cdrGenApp.layerToolbar.visible) then

        !!cdrGenApp.layerToolbar.visible = true
        !!cdrGenApp.layerToolbar.active  = true

      endif

    -- We allow a user to control whether the toolbar is visible or not
    else
      !!cdrGenApp.layerToolbar.active  = true

    endif

  -- If the start-up state is unset, then the start-up visibility is false
  else

    !!cdrGenApp.layerToolbar.visible = false
    !!cdrGenApp.layerToolbar.active  = false

  endif

  !!cdrGenApp.layerToolbar.active  = !state

  -- For a BACK, make the filter option unavailable as it cannot own anything but notes
  if (!elementType.eq('BACK')) then
    !!cdrGenApp.layerFilter.visible = false

    if (!this.notesViews.set()) then
      !!cdrGenApp.lvis.visible        = true

    else
      !!cdrGenApp.lvis.visible        = false

    endif

  -- For an LALB, SYLB or ISOLB make both the filter & visibility options unavailable in case the user displays it
  elseif (!elementType.eq('LALB') or !elementType.eq('SYLB') or !elementType.eq('ISOLB')) then

    !!cdrGenApp.layerFilter.visible  = false
    !!cdrGenApp.lvis.visible         = false

  else

    if (!this.notesViews.set()) then
      !!cdrGenApp.layerFilter.visible = true
      !!cdrGenApp.lvis.visible        = true

    else
      !!cdrGenApp.layerFilter.visible = false
      !!cdrGenApp.lvis.visible        = false

    endif

  endif

endmethod
-- End of method definition for .toolbarActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .toolbarClear()
--
-- Description:   Clear the relevant layer toolbar gadgets
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbarClear()

  !!cdrGenApp.notesViews.clear()
  !!cdrGenApp.layeNam.clear()

endmethod
-- End of method definition for .toolbarClear()
