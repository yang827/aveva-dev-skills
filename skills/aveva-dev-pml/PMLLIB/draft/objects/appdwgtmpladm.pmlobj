--
--
-- Description:     Object for Drawing Template Admin
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPDWGTMPLADM
  -- Yes this object definition should be empty
endobject
------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Configure|, 'MBCONFIG')

  !!appMenuCntrl.addBarMenu(!bmenu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('mbDisplay')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('mbGraphics')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('mbQuery')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Group Filter...|, 'CDRGROUPFILT', 'GroupFilter')
  !menu.add('FORM', |Icon Menu Styles...|, 'CDRICONSTYLE', 'IconMenuStyles')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR', 'adminSep')
  !menu.insertAfter('adminSep', 'FORM', |Load Text...|, 'CDRTEXREAD', 'adminLoadText')
  !menu.insertAfter('adminLoadText', 'CALLBACK', |Sketch Drafting...|, 'CALLEDR INITSHOW _CDRSPEED', 'libmsheSketchDrafting')
  !menu.insertAfter('libmsheSketchDrafting', 'FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'adminDynamicPrimitives')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  !mod = !!module()
  if (!mod.modkey neq 'marodes') then
   return
  endif

  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'DWGTMPLADM')
  !!appTbarCntrl.addToolbar('currentLayerToolbar', 'DWGTMPLADM')
  !!appTbarCntrl.addToolbar('layerToolbar', 'DWGTMPLADM')

endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCONFIG')
  !menu.add('CALLBACK', |Pipe Spool Drawing Admin...|, |!!drapipespldwgadmin()|, 'Pipe Spool Drawing Admin')
  !!appMenuCntrl.addMenu(!menu, 'DWGTMPLADM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
