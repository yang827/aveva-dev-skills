------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('E2DEDIT')
  !menu.add('FORM', |Symbols... |, 'CDRACADSYMB', 'editoradminSymbols')
  !menu.add('FORM', |Sheet Frame... |, 'CDRACADBACK', 'editoradminSheetFrame')
  !!appMenuCntrl.addMenu(!menu, 'EDITORADMIN')

  !menu = object APPMENU('MBIMPORT')
  !menu.add('FORM', |Symbols... |, 'CDRACADLSYM', 'editoradminSymbols')
  !menu.add('FORM', |Sheet Frame... |, 'CDRACADLOAD', 'editoradminSheetFrame')
  !!appMenuCntrl.addMenu(!menu, 'EDITORADMIN')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'editoradminCE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'editoradminMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'editoradminOwner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'editoradminOwnerMembers')
  !!appMenuCntrl.addMenu(!menu, 'EDITORADMIN')

endmethod

