endmethod

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Edit|, 'E2DEDIT')
  !bmenu.add(|Import|, 'MBIMPORT')
  !bmenu.add(|Delete|, 'MBDELETE')
  !!appMenuCntrl.addBarMenu(!bmenu, 'EDITORADMIN')
endmethod

