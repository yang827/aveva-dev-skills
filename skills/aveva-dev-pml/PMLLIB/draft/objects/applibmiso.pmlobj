------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Group Filter...|, 'CDRGROUPFILT', 'GroupFilter')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')
endmethod

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR', 'adminSep')
  !menu.insertAfter('adminSep', 'FORM', |Load Text...|, 'CDRTEXREAD', 'adminLoadText')
  !menu.insertAfter('adminLoadText', 'FORM', |Sketch Drafting...|, 'CDRSPEED', 'adminSketchDrafting')
  !menu.insertAfter('adminSketchDrafting', 'FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'adminDynamicPrimitives')
  !menu.insertAfter('adminDynamicPrimitives', 'FORM', |Export Isodraft Symbols...|, 'CDRISOSYMF', 'adminExportIsodraftSymbols')
  !menu.insertAfter('adminExportIsodraftSymbols', 'FORM', |Import Isodraft Symbols...|, 'CDRISOTRANS', 'adminImportIsodraftSymbols')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')
endmethod

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .libmisoToolbar toolbar 'Isodraft Symbol Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('libmisoToolbar', 'LIBMISO')
  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'LIBMISO')
  !!appTbarCntrl.addToolbar('layerToolbar', 'LIBMISO')
  !!appTbarCntrl.hideGadgets('lvis layerFilter', 'LIBMISO')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Isodraft Symbol Library...|, |CALLIBM FCREATE ISOLB NO $<show _CDRMISOLB$>|, 'IsodraftSymbolLibrary')
  !menu.add('CALLBACK', |Isodraft Symbol Template...|, |CALLIBM FCREATE ISOTM NO $<show _CDRISOSYMT$>|, 'IsodraftSymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Isodraft Symbol Library|, 'MBISOSYLB', 'IsodraftSymbolLibrary')
  !menu.add('FORM', |Isodraft Symbol Template...|, 'CDRISOSYMT', 'IsodraftSymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('MBISOSYLB')
  !menu.add('FORM', |Definition...|, 'CDRMISOLB', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRISOLBATT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !menu.add('CALLBACK', |Group Members|, |CALLDRG XDELETEN|, 'GroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  --   $* 2D Menu for Isodraft symbols
  !menu = object APPMENU('E2DDRAW')
  !menu.add('FORM', |Primitives...|, 'CDRISOPRIM', 'libmisoPrimitives')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('E2DCONSTRU')
  !menu.add('FORM', |Group...|, 'CDRUGROUP', 'Group')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |2D Copy|, |CALLEDR XCOPYPRIM|, '2DCopy')
  !menu.add('MENU', |Repeat|, 'E2DCONSTARRAY', 'Repeat')
  !menu.add('FORM', |Mirror...|, 'CDRMIRCOPY', 'libmisoMirror')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Fillet Arc...|, |CALLEDR XFILL|, 'FilletArc')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Chamfer Line...|, |CALLEDR XCHAM|, 'ChamferLine')
  !menu.add('FORM', |Parallel Line...|, 'CDROFFSET', 'libmisoParallelLine')
  !menu.add('CALLBACK', |Tangent Line...|, |CALLEDR XTANL|, 'TangentLine')
  !menu.add('CALLBACK', |Ray Line...|, |CALLEDR XRAYL|, 'RayLine')
  !menu.add('CALLBACK', |Constructed Line...|, |CALLEDR XCONL|, 'ConstructedLine')
  !menu.add('CALLBACK', |Bisector Line...|, |CALLEDR XBISL|, 'BisectorLine')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Local Symbol...|, |CALLEDR XUSRSYMB CREATE|, 'LocalSymbol')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('E2DEDIT')
  !menu.add('CALLBACK', |Primitive...|, |CALLEDR XMODATTS|, 'Primitive')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Move Primitive/Node To|, 'E2DNAT', 'MovePrimitiveNodeTo')
  !menu.add('MENU', |Move Primitives By|, 'E2DPBY', 'MovePrimitivesBy')
  !menu.add('MENU', |Move Node By|, 'E2DNBY', 'MoveNodeBy')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Line Gap|, 'E2DBREAK', 'LineGap')
  !menu.add('CALLBACK', |Line Trim|, |CALLEDR XTRIM|, 'LineTrim')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Rotate...|, |CALLEDR XROTATE|, 'Rotate')
  !menu.add('CALLBACK', |Demolish Symbol|, |CALLEDR XEXPLDSYMB|, 'DemolishSymbol')
  !menu.add('FORM', |Action Group...|, 'CDRMODGROUP', 'ActionGroup')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  --   $* lower level menus -----------------------------------
  !menu = object APPMENU('E2DCONSTARRAY')
  !menu.add('CALLBACK', |Offset...|, |CALLEDR XMULCOPY|, 'Offset')
  !menu.add('FORM', |Rows & Columns...|, 'CDRMATCOPY', 'libmisoRowsColumns')
  !menu.add('CALLBACK', |Polar...|, |CALLEDR XCENCOPY|, 'Polar')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('E2DBREAK')
  !menu.add('CALLBACK', |Zero Length|, |CALLEDR XBREAK NOGAP|, 'ZeroLength')
  !menu.add('CALLBACK', |Default Length|, |CALLEDR XBREAK AUTOGAP|, 'DefaultLength')
  !menu.add('CALLBACK', |Start,End|, |CALLEDR XBREAK DEFINEDGAP|, 'StartEnd')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  --   $* new prim/node Drag and move menu options
  !menu = object APPMENU('E2DPBY')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MPBY BY|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MPBY BYEX|, 'XY')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('E2DNAT')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MNPOS AT|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MNPOS ATEX|, 'XY')
  !menu.add('FORM', |E,N,U...|, 'CDRNODEPOS', 'ENU')
  !menu.add('FORM', |Pline...|, 'CDRNODEPLINE', 'Pline')
  !menu.add('FORM', |Design Element...|, 'CDRNODEPOINT', 'DesignElement')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')

  !menu = object APPMENU('E2DNBY')
  !menu.add('CALLBACK', |Cursor|, |CALLEDR MNBY BY|, 'Cursor')
  !menu.add('CALLBACK', |X,Y...|, |CALLEDR MNBY BYEX|, 'XY')
  !!appMenuCntrl.addMenu(!menu, 'LIBMISO')


endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
