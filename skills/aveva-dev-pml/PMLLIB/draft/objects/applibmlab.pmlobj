--
--
-- Description:     Object for Label Administration application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPLIBMLAB
endobject

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Modify|, 'MBMODIFY')
  !bmenu.add(|Delete|, 'MBDELETE')
  --    CALLIBM FE2DBAR
  -- from DRA\CLIB\FE2DBAR
  !bmenu.add(|Draw|, 'E2DDRAW')
  !bmenu.add(|Construct|,'E2DCONSTRU')
  !bmenu.add(|Edit|, 'E2DEDIT')
  !!appMenuCntrl.addBarMenu(!bmenu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('mbDisplay')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('mbGraphics')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('mbQuery')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Group Filter...|, 'CDRGROUPFILT', 'GroupFilter')
  !menu.add('FORM', |Icon Menu Styles...|, 'CDRICONSTYLE', 'IconMenuStyles')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR', 'adminSep')
  !menu.insertAfter('adminSep', 'FORM', |Load Text...|, 'CDRTEXREAD', 'adminLoadText')
  !menu.insertAfter('adminLoadText', 'FORM', |Sketch Drafting...|, 'CDRSPEED', 'adminSketchDrafting')
  !menu.insertAfter('adminSketchDrafting', 'FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'adminDynamicPrimitives')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .libmlabToolbar toolbar 'Label Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('libmlabToolbar', 'LIBMLAB')
  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'LIBMLAB')
  !!appTbarCntrl.addToolbar('layerToolbar', 'LIBMLAB')
  !!appTbarCntrl.hideGadgets('lvis layerFilter', 'LIBMLAB')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Label Library...|, |CALLIBM FCREATE LALB NO $<show _CDRMLALB$>|, 'LabelLibrary')
  !menu.add('CALLBACK', |Text Template...|, |CALLIBM FCREATE TXTM NO $<CALLMLAB XTXTM CREATE$>|, 'TextTemplate')
  !menu.add('CALLBACK', |Symbol Template...|, |CALLIBM FCREATE SYTM NO $<CALLMSYM MSYTM$>|, 'SymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('CALLBACK', |Name...|, |!!exitModifyMode()
   show _CDRNAME|, 'exitModifyModeName')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR', 'librarySep')
  !menu.add('CALLBACK', |Library...|, |!!exitModifyMode()
   show _CDRLIBATT|, 'libmlabLibrary')
  !menu.add('MENU', |Label Library...|, 'MBLALB', 'libmlabLabelLibrary')
  !menu.add('MENU', |Text Template...|, 'MBTXTM', 'libmlabTextTemplate')
  !menu.add('CALLBACK', |Symbol Template...|, |!!exitModifyMode()
   CALLMSYM INITSHOW _CDRSYTMATT|, 'libmlabSymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('CALLBACK', |Reorder...|, |!!exitModifyMode()
   show _CDRREORDER|, 'exitModifyModeReorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

  !menu = object APPMENU('MBTXTM')
  !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
   CALLMLAB XTXTM MODIFY|, 'Definition')
  !menu.add('CALLBACK', |Attributes...|, |!!exitModifyMode()
   show _CDRTXTMATT|, 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

  !menu = object APPMENU('MBLALB')
  !menu.add('CALLBACK', |Definition...|, |!!exitModifyMode()
   show _CDRMLALB|, 'Definition')
  !menu.add('CALLBACK', |Attributes...|, |!!exitModifyMode()
   show _CDRLALBATT|, 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |!!exitModifyMode()
   CALLDRG MDELCE|, 'exitModifyModeCE')
  !menu.add('CALLBACK', |Members|, |!!exitModifyMode()
   CALLDRG MDELMEM|, 'exitModifyModeMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |!!exitModifyMode()
   OWNER
   CALLDRG MDELCE|, 'exitModifyModeOwner')
  !menu.add('CALLBACK', |Owner Members|, |!!exitModifyMode()
   OWNER
   CALLDRG MDELMEM|, 'exitModifyModeOwnerMembers')
  !menu.add('SEPARATOR')
  -- !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Group Members|, |!!exitModifyMode()
   CALLDRG XDELETEN|, 'exitModifyModeGroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMLAB')

endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
