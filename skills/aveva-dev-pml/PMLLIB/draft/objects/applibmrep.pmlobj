------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Representation Library...|, |var !!CDLIBRULE 'True'
  CALLMREP XLIBMREPCR RPLB|, 'RepresentationLibrary')
--  !session = current session
--  !license = !session.finalDesigner()
--  if(!license) then
--    !menu.add('CALLBACK', |Final Designer Layer Library...|, |var !!CDLIBRULE 'True'
--    CALLMREP XLIBMREPCR RPLBFD|, 'LayerFDLibrary')
--    !menu.add('CALLBACK', |Final Designer Layer Table...|, |var !!CDLIBRULE 'True'
--    CALLMREP XLIBMREPCR LAYTBL|, 'LayerFDTable')
--
--    !menu.add('CALLBACK', |Final Designer Layer Ruleset...|, |var !!CDLIBRULE 'True'
--    CALLMREP XLIBMREPCR LAYRST|, 'LayerFDRuleset')
--  endif
  !menu.add('CALLBACK', |Representation Ruleset...|, |var !!CDLIBRULE 'True'
  CALLMREP XLIBMREPCR RRST|, 'RepresentationRuleset')
  !menu.add('CALLBACK', |Hatching Library...|, |var !!CDLIBHRULE 'True'
  CALLMREP XLIBMREPHCR RPLB|, 'libmrepHatchingLibrary')
  !menu.add('CALLBACK', |Hatching Ruleset...|, |var !!CDLIBHRULE 'True'
  CALLMREP XLIBMREPHCR HRST|, 'HatchingRuleset')
  !menu.add('CALLBACK', |Change Library...|, |!!draCreateChange('RPLB','LIBRARY')|, 'ChangeLibrary')
  !menu.add('CALLBACK', |Change Ruleset...|, |!!draCreateChange('CRST','RULESET')|, 'ChangeRuleset')
  !!appMenuCntrl.addMenu(!menu, 'LIBMREP')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Library...|, 'CDRLIBATT', 'Library')
  !menu.add('CALLBACK', |Representation Library...|, |var !!CDLIBRULE 'True'
  CALLMREP XLIBMREP RPLB|, 'RepresentationLibrary')
  !menu.add('CALLBACK', |Representation Ruleset...|, |var !!CDLIBRULE 'True'
  CALLMREP XLIBMREP RRST|, 'RepresentationRuleset')
--    if(!license) then
--       !menu.add('CALLBACK', |Final Designer Layer Rules...|, |show !!draCreateLayRules|, 'LayerFDRuleset')
--    endif
  !menu.add('CALLBACK', |Hatching Library...|, |var !!CDLIBHRULE 'True'
  CALLMREP XLIBMREPH RPLB|, 'libmrepHatchingLibrary')
  !menu.add('CALLBACK', |Hatching Ruleset...|, |var !!CDLIBHRULE 'True'
  CALLMREP XLIBMREPH HRST|, 'HatchingRuleset')
  !menu.add('CALLBACK', |Change Library...|, |!!draShowChange('!!draChangeRule','LIBY')|, 'ChangeLibrary')
  !menu.add('CALLBACK', |Change Ruleset...|, |!!draShowChange('!!draChangeRule','CRST')|, 'ChangeRuleset')
  !!appMenuCntrl.addMenu(!menu, 'LIBMREP')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMREP')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMREP')


endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
