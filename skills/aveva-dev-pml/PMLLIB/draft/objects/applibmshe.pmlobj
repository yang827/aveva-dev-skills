--
--
-- Description:     Object for Sheet Administration application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPLIBMSHE
endobject

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Modify|, 'MBMODIFY')
  !bmenu.add(|Delete|, 'MBDELETE')
  --    CALLIBM FE2DBAR
  -- from DRA\CLIB\FE2DBAR
  !bmenu.add(|Draw|, 'E2DDRAW')
  !bmenu.add(|Construct|,'E2DCONSTRU')
  !bmenu.add(|Edit|, 'E2DEDIT')
  !!appMenuCntrl.addBarMenu(!bmenu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('mbDisplay')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('mbGraphics')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('mbQuery')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Group Filter...|, 'CDRGROUPFILT', 'GroupFilter')
  !menu.add('FORM', |Icon Menu Styles...|, 'CDRICONSTYLE', 'IconMenuStyles')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  -- !menu.add('SEPARATOR')
  !menu.add('SEPARATOR', 'adminSep')
  !menu.insertAfter('adminSep', 'FORM', |Load Text...|, 'CDRTEXREAD', 'adminLoadText')
  !menu.insertAfter('adminLoadText', 'CALLBACK', |Sketch Drafting...|, 'CALLEDR INITSHOW _CDRSPEED', 'libmsheSketchDrafting')
  !menu.insertAfter('libmsheSketchDrafting', 'FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'adminDynamicPrimitives')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .libmsheToolbar toolbar 'Sheet Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('libmsheToolbar', 'LIBMSHE')
  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'LIBMSHE')
  !!appTbarCntrl.addToolbar('currentLayerToolbar', 'LIBMSHE')
  !!appTbarCntrl.addToolbar('layerToolbar', 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('MENU', |Note|, 'MBCNOTE', 'NoteMenu')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Sheet Library...|, |CALLIBM FCREATE SHLB NO $<show _CDRSHLB$>|, 'SheetLibrary')
  !menu.add('CALLBACK', |Backing Sheet...|, |CALLIBM FCREATE BACK NO $<show _CDRBSHEE$>|, 'BackingSheet')
  !menu.add('CALLBACK', |Overlay Sheet...|, |CALLIBM FCREATE OVER NO $<show _CDROSHEE$>|, 'OverlaySheet')
  !menu.add('MENU', |View|, 'MBVIEW', 'View')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBCNOTE')
  !menu.add('CALLBACK', |Back/Over...|, |CALLDRG XMNOTE CREATE NOTE BACK OVER|, 'BackOver')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE CREATE VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW CREATE ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User-defined...|, |CALLDRG XVIEW CREATE USER|, 'UserDefined')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Note|, 'MBMNOTE', 'Note')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Library...|, 'CDRLIBATT', 'Library')
  !menu.add('MENU', |Sheet Library|, 'MBSHLB', 'SheetLibrary')
  !menu.add('MENU', |Backing Sheet|, 'MBBSHEE', 'BackingSheet')
  !menu.add('MENU', |Overlay Sheet|, 'MBOSHEE', 'OverlaySheet')
  !menu.add('MENU', |View|, 'MBMVIEW', 'View')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBMNOTE')
  !menu.add('CALLBACK', |Back/Over...|, |CALLDRG XMNOTE MODIFY NOTE BACK OVER|, 'BackOver')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE MODIFY VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBSHLB')
  !menu.add('FORM', |Definition...|, 'CDRSHLB', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRSHLBAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBBSHEE')
  !menu.add('FORM', |Definition...|, 'CDRBSHEE', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRBSHEEAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBOSHEE')
  !menu.add('FORM', |Definition...|, 'CDROSHEE', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDROSHEEAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBMVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW MODIFY ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User-defined...|, |CALLDRG XVIEW MODIFY USER|, 'UserDefined')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Group Members|, |CALLDRG XDELETEN|, 'GroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSHE')
endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
