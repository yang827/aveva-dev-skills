-- Created:         Wed Jan 28 16:05:19 2004
--
--
-- Description:     Object for Symbol Administration application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPLIBMSYM
endobject

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Modify|, 'MBMODIFY')
  !bmenu.add(|Delete|, 'MBDELETE')
  --    CALLIBM FE2DBAR
  -- from DRA\CLIB\FE2DBAR
  !bmenu.add(|Draw|, 'E2DDRAW')
  !bmenu.add(|Construct|,'E2DCONSTRU')
  !bmenu.add(|Edit|, 'E2DEDIT')
  !!appMenuCntrl.addBarMenu(!bmenu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('mbDisplay')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('mbGraphics')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('mbQuery')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Group Filter...|, 'CDRGROUPFILT', 'GroupFilter')
  !menu.add('FORM', |Icon Menu Styles...|, 'CDRICONSTYLE', 'IconMenuStyles')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  !menu.add('SEPARATOR', 'adminSep')
  !menu.insertAfter('adminSep', 'FORM', |Load Text...|, 'CDRTEXREAD', 'adminLoadText')
  !menu.insertAfter('adminLoadText', 'FORM', |Sketch Drafting...|, 'CDRSPEED', 'adminSketchDrafting')
  !menu.insertAfter('adminSketchDrafting', 'FORM', |Dynamic Primitives...|, 'CDRATTRIB', 'adminDynamicPrimitives')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .libmsymToolbar toolbar 'Symbol Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('libmsymToolbar', 'LIBMSYM')
  !!appTbarCntrl.addToolbar('workingSheetToolbar', 'LIBMSYM')
  !!appTbarCntrl.addToolbar('layerToolbar', 'LIBMSYM')
  !!appTbarCntrl.hideGadgets('lvis layerFilter', 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Symbol Library...|, |CALLIBM FCREATE SYLB NO $<show _CDRMSYLB$>|, 'SymbolLibrary')
  !menu.add('CALLBACK', |Symbol Template...|, |CALLIBM FCREATE SYTM NO $<CALLMSYM MSYTM$>|, 'SymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Library...|, 'CDRLIBATT', 'Library')
  !menu.add('MENU', |Symbol Library...|, 'MBSYLB', 'SymbolLibrary')
  !menu.add('FORM', |Symbol Template...|, 'CDRSYTMATT', 'SymbolTemplate')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('MBSYLB')
  !menu.add('FORM', |Definition...|, 'CDRMSYLB', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRSYLBATT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Group Members|, |CALLDRG XDELETEN|, 'GroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMSYM')
endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
