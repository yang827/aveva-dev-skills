--
------------------------------------------------------------------------
define method .toolbars()
  -- frame .libmtagToolbar toolbar 'Tagging Toolbar'
  -- exit
  -- !!appTbarCntrl.addToolbar('libmtagToolbar', 'LIBMTAG')
endmethod

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('MBCREATE')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Tagrule Library...|, |CALLIBM FCREATE TRLB NO $<show _CDRLMTAGR$>|, 'TagruleLibrary')
  !!appMenuCntrl.addMenu(!menu, 'LIBMTAG')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Library...|, 'CDRLIBATT', 'Library')
  !menu.add('FORM', |Tagrule Library...|, 'CDRLMTAGR', 'TagruleLibrary')
  !!appMenuCntrl.addMenu(!menu, 'LIBMTAG')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMTAG')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMTAG')


endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()
endmethod
