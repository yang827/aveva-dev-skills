-- Return:
--   [REAL] [value of the levelBack Flag]
--
------------------------------------------------------------------------
define method .levelBack(!value is REAL) is REAL
  if( !value.set() ) then
    if ( !value eq 0 ) then
      !this.levelBack = REAL()
    else
      !this.levelBack = !value
    endif
  endif
