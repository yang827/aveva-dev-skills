------------------------------------------------------------------------
--
-- Method:      !userAccess()
--
-- Description: set/get the overall User Access
--              Object is editable if any User flag is set
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [BOOLEAN] [value of the User Access]
--
------------------------------------------------------------------------
define method .userAccess() is BOOLEAN
  !access = !this.userGeneral  or !this.userGrouping or !this.userMapping  or !this.userLeveling or !this.userAdvanced

  return !access
endmethod
-- End of method definition for .userAccess() BOOLEAN

