------------------------------------------------------------------------
--
-- Method:      !readDescription()
--
-- Description: Read Description from specified File - 1st line of file
--              This method does NOT modify the dgnOut Object
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [FILE] [Name of file defining dgnOut object]
-- Return:
--   [STRING] [Description of dgnOut Config object]
--
------------------------------------------------------------------------
define method .readDescription(!file is FILE) is STRING

  !returnString = STRING()
  !string = STRING()
  if( !file.exists() ) then
    if( !file.open('READ') ) then
      !returnString = !file.readRecord().after(|= '|).before( |'| )
      !file.close()
    endif
  endif

  return !returnString
endmethod
-- End of method definition for .readDescription(FILE) STRING

