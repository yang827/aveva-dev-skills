-- File:            dimensionlist.pmlobj
--   Type:          Object Definition
--   Group:         DIM
--
--     Keyword:     DIMENSIONS
--   Module:        DRAFT
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Fri Sep 19th 8:24:23 GMT 2002
--
--
-- Description:
-- Object to store all the dimension types available
-- There are several different dimension definitions for each type
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dimCreateList()                  -                   Constructor running defaults in from the object
--  getDefinition(STRING)            DIMENSION
--  globalInstance()                 -
--

define object dimCreateList

   member .horizontals is ARRAY $* Horizontal Linear Dimension Definitions
   member .verticals   is ARRAY $* Vertical Linear Dimension Definitions
   member .slopes      is ARRAY $* Angled  Linear Dimension Definitions
   member .angles      is ARRAY $* Angular Dimension Definitions
   member .diameters   is ARRAY $* Diameter Dimension Definitions
   member .radii       is ARRAY $* Radius Dimension Definitions
   member .pcds        is ARRAY $* Pitch Circle Diameter Dimension Definitions
   member .pcrs        is ARRAY $* Pitch Circle Radius Dimension Definitions

endobject
-- End of object definition for dimCreateList
------------------------------------------------------------------------
--
-- Method:      dimCreateList
--
-- Description: Constructor running defaults in from the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dimCreateList()

-- initialise variables
!dimension  = object dimension()
!dimensions = !!cdDimCreate
!savedGroup = 0
!count      = 0

do !i indices !dimensions
-- set/get dimension Definition
  !dimension = !this.getDefinition(!dimensions[!i])
-- set counter to group the dimensions into their respective groups
  if(!dimension.group.eq(!savedGroup)) then
     !count = !count + 1
  else
     !count = 1
  endif

-- set each dimension type

  if(!dimension.type.eq('HLDIM')) then
     !this.horizontals[!count] = !dimension
  elseif(!dimension.type.eq('VLDIM')) then
     !this.verticals[!count] = !dimension
  elseif(!dimension.type.eq('TLDIM')) then
     !this.slopes[!count] = !dimension
  elseif(!dimension.type.eq('ADIM')) then
     !this.angles[!count] = !dimension
  elseif(!dimension.type.eq('DIA')) then
     !this.diameters[!count] = !dimension
  elseif(!dimension.type.eq('RAD')) then
     !this.radii[!count] = !dimension
  elseif(!dimension.type.eq('PCD')) then
     !this.pcds[!count] = !dimension
  elseif(!dimension.type.eq('RPCD')) then
     !this.pcrs[!count] = !dimension
  endif
-- set flag to continue with the same group

  !savedGroup = !dimension.group

enddo

endmethod
-- End of method definition for .dimCreateList()

------------------------------------------------------------------------
--
-- Method:      getDefinition
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R/RW] [STRING]    [String of the stored dimension definition]
-- Return:
--   [Data Type] [Description]
--   [DIMENSION] [Return an object of the dimension definition]
--
------------------------------------------------------------------------
define method .getDefinition(!dimensionString is STRING) is DIMENSION

   !dimension = object DIMENSION(!dimensionString.split(':'))

   return !dimension

endmethod
-- End of method definition for .getDefinition(STRING)
------------------------------------------------------------------------
--
-- Method:      globalInstance()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- create the global instance of this object
  !!dimensionDefinitions = !this

endmethod
-- End of method definition for .globalInstance()
