--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dimension(ARRAY)                 -                   Constructor running defaults in from the object
--

define object dimension

   member .group       is REAL    $* Real number to group the dimensions
   member .callback    is STRING  $* Callback executed when button is pressed
   member .icon        is STRING  $* Icon displayed on the button
   member .type        is STRING  $* Code for the type of dimension (eg. HLDIM)
   member .preferred   is BOOLEAN $* TRUE or False is this dimension a preferred dimension
   member .description is STRING  $* Tooltip for the button

endobject
-- End of object definition for dimension
------------------------------------------------------------------------
--
-- Method:      dimension
--
-- Description: Constructor running defaults in from the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dimension(!arrayOfValues is ARRAY)

-- initialise variables

   !this.group       = !arrayOfValues[1].real()
   !this.callback    = !arrayOfValues[3]
   !this.icon        = !arrayOfValues[4]
   !this.type        = !arrayOfValues[2]
   !this.preferred   = !arrayOfValues[5].boolean()
   !this.description = !arrayOfValues[6]

endmethod
-- End of method definition for .dimension(ARRAY)

