-- Created:         20/04/2007 10:23
--
--
-- Description: Object to be used to create mitre dimensions on Pipe sketches
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angularDimension(DBREF,DBREF,ARRAY,STRING,REAL,REAL) -                   Add angular dimensions to mitred bends
--  checkTerminator(STRING)          STRING              Check that terminator is valid, default to arrows
--  createAngularDim(STRING,REAL,REAL) -                   Setup angular dimension
--  createDimPoint(REAL)             -                   Create Dimension Point
--  dimensionsegment(REAL)           -
--  isitinplane()                    BOOLEAN
--  itsamitre()                      BOOLEAN
--  linearDimension(DBREF,DBREF,DBREF) -
--  linearDimension(DBREF,DBREF,STRING) -
--  makedim(REAL,REAL)               -
--  makedppt(ARRAY)                  -
--  setoptions(STRING)               BOOLEAN
--


define object DIMENSIONMITRE

member .bend               is DBREF
member .view               is DBREF
member .ncuts              is REAL
member .arrivepoint        is REAL
member .leavepoint         is REAL
member .dimensiontype      is REAL
member .dimensionsegments  is REAL    $* input character 1
member .dimensionoptions   is REAL    $* input character 2
member .sense              is BOOLEAN
member .undo               is UNDOABLE

endobject
------------------------------------------------------------------------

------------------------------------------------------------------------

--   angularDimension(DBREF,DBREF,ARRAY)       -                 Adds angular dimensions to mitred bends
--   linearDimension(BEND,Dimension,View)      -                 Builds a set of dimensions
--   itsamitre()                             BOOLEAN             Checks to see if the current bend is a mitre
--   isitinplane()                           BOOLEAN             Checks to see if the current bend in the view plane
--   dimensionsegment(REAL)                    -                 dimensions the segment number defined by the passed parameter


------------------------------------------------------------------------
define method .linearDimension(!bend is DBREF, !dimension is DBREF, !view is DBREF)

   !this.bend = !bend
   !this.view = !view

   if !this.itsamitre().not().or(!this.isitinplane().not()) then
    --$P not valid
       return
   endif

   !!ce = !dimension
   do !a from 1 to !this.ncuts - 1
      !this.dimensionsegment(!a)
   enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .linearDimension(!bend is DBREF,!layer is DBREF,!type is STRING)

  !this.undo.description('Dimension Bend')
  !this.undo.add()

   !this.bend = !bend
   !this.view = !layer.owner

   -- see if the bend is a mitre and we are looking in the right direction
   -- and get the bend clockwise / anticlockwise sense
   if !this.itsamitre().not().or(!this.isitinplane().not()) then
    --$P not valid
       return
   endif

   -- its a valid bend so we now need to check the type
   if !this.setoptions(!type).not() then
      --$P invalid options
      return
   endif

   !!ce = !layer
   if !this.dimensionsegments.eq(0) then
      do !a from 1 to !this.ncuts - 1
         !this.dimensionsegment(!a)
      enddo
   else
      !this.dimensionsegment(!this.dimensionsegments)
   endif

   !this.undo.endUndoable()

endmethod
------------------------------------------------------------------------

-- method to check to ensure that the bend is a new type mitre
------------------------------------------------------------------------
define method .itsamitre() is BOOLEAN

  !this.ncuts = !this.bend.actncu
  handle any
    !this.ncuts = 0
  endhandle
  if !this.ncuts.eq(0) then
    return FALSE
  endif

  return TRUE


endmethod
------------------------------------------------------------------------

-- we can only draw a dimension if the bend is drawn perpendicular to
-- the view direction this method checks.
------------------------------------------------------------------------
define method .isitinplane() is BOOLEAN

  !pos  = !this.bend.pos.wrt( /* )
  !apos = !this.bend.apos.wrt( /* )
  !lpos = !this.bend.lpos.wrt( /* )

  !arc = !apos.arcthru(!pos,!lpos,!this.view.direction)
  !this.sense = !arc.sense

  !direction = !pos.plane(!apos, !lpos).pointvector().direction

  if !this.view.direction.isparallel(!direction) then
    return TRUE
  else
    return FALSE
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .dimensionsegment(!segmentNo is REAL)

--if segment number is 1 then we need to dimension between
--ppoints 12 and 22 outside and 11 and 21 inside

 !this.makedim(!segmentNo, !this.dimensionoptions)
 !seq = ARRAY()
 if !this.dimensionoptions inset( 0,3,4,5,6,7,8,9 ) then
   if !this.dimensionoptions inset (0,6) then
     !seq.append( !segmentNo * 10 + 2)
     !seq.append( !segmentNo * 10 + 1)
     !seq.append( !segmentNo * 10 + 11)
     !seq.append( !segmentNo * 10 + 12)
   elseif !this.dimensionoptions inset(3,7) then
     !seq.append( !segmentNo * 10 + 2)
     !seq.append( !segmentNo * 10 + 12)
   elseif !this.dimensionoptions inset(4,8) then
     !seq.append( !segmentNo * 10)
     !seq.append( !segmentNo * 10 + 10)
   elseif !this.dimensionoptions inset(5,9) then
     !seq.append( !segmentNo * 10 + 1)
     !seq.append( !segmentNo * 10 + 11)
   endif
elseif !this.dimensionoptions inset(1,2) then
     !seq.append( !segmentNo * 10 + 2)
     !seq.append( !segmentNo * 10 + 12)
     !this.makedppt(!seq)
     if !this.dimensionoptions.eq(1) then
       !this.makedim(!segmentNo,0)
     else
       !this.makedim(!segmentNo,9)
     endif
     !seq.clear()
     !seq.append( !segmentNo * 10 + 1)
     !seq.append( !segmentNo * 10 + 11)
endif
!this.makedppt(!seq)
endmethod
------------------------------------------------------------------------

define method .makedim(!segmentNo is REAL,!opt is REAL)
   new ldim
   !name = '/' & !!ce.refno & 'MITRE'
   name $!name
   !pos1 = !this.bend.ppos[!segmentNo * 10 + 12].wrt(/* )
   !pos2 = !this.bend.ppos[!segmentNo * 10 + 2].wrt(/* )
   if !this.sense.not() then
     !sdir = !pos1.direction(!pos2)
   else
     !sdir = !pos2.direction(!pos1)
   endif
   if !opt.gt(5) then
     !sdir = !sdir.opposite()
   endif
   !dir = !sdir.string().before('WRT')
   direction $!dir
   !seq = ARRAY()


endmethod


------------------------------------------------------------------------
define method .makedppt(!list is ARRAY)

do !a values !list
    new dppt !!ce.ddname = !this.bend !!ce.nppt = !a
enddo

endmethod


------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to set the dimensioning options based on the input parameter
--   types can be
--   first character   = 0   Dimension all segments
--   first character   = 1-n Dimension the numbered segment
--   second character  = 0   make a single dimension for inside and outside tube lengths to away from the bend radius
--   second character  = 1   make two dimensions  overall and inside
--   second Character  = 2   make one dimension inside and one outside dimension
--   second Character  = 3   dimension overall length only offset to the outside
--   second character  = 4   Dimension centreline length only offset to the outside
--   second character  = 5   Dimension inside length only offset to the outside
--   second character  = 6   make a single dimension for inside and outside tube lengths towards the bend radius
--   second Character  = 7   dimension overall length only offset to the inside
--   second character  = 8   Dimension centreline length only   offset to the inside
--   second character  = 9   Dimension inside length only offset to the inside
--   third Character   = 0   do not dimension angles
--   third Character   = 1   dimension angles for all dimensioned segments (note any value above 0 is true)
------------------------------------------------------------------------
define method .setoptions(!type is STRING)is BOOLEAN


-- first of all validate the passed number for two characters
if !type.length().neq(2) then
   return FALSE
endif

-- now get character 1
   !this.dimensionsegments = !type.substring(1,1).real()
   if !this.dimensionsegments.gt(!this.ncuts - 1) then
      -- we are trying to dimension a segment we havent got
      return FALSE
   endif

-- now get character 2
   !this.dimensionoptions  = !type.substring(2,1).real()

   return TRUE

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      angularDimension
--
-- Description: Add angular dimensions to mitred bends
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Reference of mitred bend
--    2   R      DBREF      Reference of layer
--    3   R      ARRAY      List of ppoints on segments to dimension
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .angularDimension(!bend is DBREF,!layer is DBREF,!segments is ARRAY,!terminator is STRING,!tSize is REAL,!cSize is REAL)

   -- Add UNDO information
   !this.undo.description('Added angular dimension to mitred bend')
   !this.undo.add()

   -- Check references are valid
 --  if(!bend.badRef() OR !layer.badRef()) then
  --    return
  -- endif

  !this.bend = !bend
  !this.view = !layer.owner

   -- See if the bend is a mitre and we are looking in the right direction
   -- and get the bend clockwise / anticlockwise sense
   if !this.itsamitre().not().or(!this.isitinplane().not()) then
      -- Not valid
      return
   endif

   !!ce = !layer

   -- Check terminator is valid
   !term = !this.checkTerminator(!terminator)
   --Create Angular dimension
   !this.createAngularDim(!term,!tSize,!cSize)
   -- Create dimensions on segments
   -- If segments array is empty then dimension all segments
   if !segments.unset() then
      !this.createDimPoint(1)
      do !a from 1 to !this.ncuts
        !this.createDimPoint(!a * 10)
      enddo
      !this.createDimPoint(2)
   -- Dimension each segment listed in array
   else
      do !ppoint values !segments
        !this.createDimPoint(!ppoint)
      enddo
   endif

    -- Mark end of Undo
   !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      createAngularDim
--
-- Description: Setup angular dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createAngularDim(!terminator is STRING,!tSize is REAL,!cSize is REAL)

  -- Create new angular dimension
  NEW ADIM
  -- Set the name eg. 12345/8910ADIM
  !name = '/' & !!ce.refno & 'ADIM'
  NAME $!name
  -- Set design element reference to the bend
  DDNAME $!this.bend
  -- Origin of bend
  NPPT 15
  -- Set dimension text at a distance of twice the radius
  !dOffset = !this.bend.radius * !this.view.vscale * 2
  DOFFSET $!dOffset
  -- Set dimension terminator
  DTERMINATOR $!terminator
   -- Set terminator size
  TSIZE $!tSize
  -- Set dimension text character height
  DTCHEIGHT $!cSize

endmethod

------------------------------------------------------------------------
--
-- Method:      createDimPoint
--
-- Description: Create Dimension Point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1  R      REAL        Ppoint number on segment
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDimPoint(!segmentNumber is REAL)

  NEW DPPT
  DDNAME $!this.bend
  NPPT $!segmentNumber

endmethod

------------------------------------------------------------------------
--
-- Method:      checkTerminator
--
-- Description: Check that terminator is valid, default to arrows
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1  R      STRING      Terminator type
-- Return:
--   [Data Type] [Description]
--   STRING      Terminator type
--
------------------------------------------------------------------------
define method .checkTerminator(!terminator is STRING) is STRING

  !termUp = !terminator.upCase()
  if(!termUp.eq('OFF')) then
    !term = 'OFF'
  elseif (!termUp inset('ARR','ARROWS')) then
    !term = 'ARR'
  elseif (!termUp inset('DOT','DOTS')) then
    !term = 'DOT'
  elseif (!termUp inset('OBL','OBLIQUES')) then
    !term = 'OBL'
  elseif (!termUp inset('OPENA','OPENARROWS')) then
    !term = 'OPENA'
  elseif (!termUp inset('NARR','NARROWDARTS')) then
    !term = 'NARR'
  elseif (!termUp inset('WIDE','WIDEDARTS')) then
    !term = 'WIDE'
  elseif (!termUp inset('SLAS','SLASHES')) then
    !term = 'SLAS'
  elseif (!termUp inset('OPEND','OPENDOTS')) then
    !term = 'OPEND'
  else
   !term = 'ARR'
  endif

  return !term

endmethod
