--
-- File:            drabackhandler.pmlobj
--   Type:          Object Definition
--   Group:         draft
--     Keyword:     Backing sheet handling
--   Module:        DRAFT
--
-- Author:          Tomasz Lisowski
-- Created:         07/08/2007
--
-- Description:
-- The object manages the gadgets for handling backing sheet references
-- and filenames in the PML forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(FORM)                      -                   Applies the backing sheet data
--  fillOtherList(STRING,STRING,STRING,STRING,BOOLEAN,BOOLEAN) -                   Fills in other lists in the form
--  getData(FORM)                    ARRAY               Retrieves data from the gadgets
--  globalInstance()                 -                   Creates a global instance of itself
--  handleBSFN(FORM)                 -                   Callback routine for the BSFN TEXT gadget
--  handleBSRF(FORM)                 -                   Callback routine for the BSRF OPTION gadget
--  init(STRING,REAL,BOOLEAN)        -                   Initialises the gadgets. Assumes, that form's _USERDATA has been set
--  reset(FORM)                      -                   Workaround for defect P-845
--  setup(STRING,REAL,STRING)        -                   Creates a set of gadgets handling the backing sheet reference an dfile name
--  stdSizeSelection(GADGET,STRING,STRING) -                   PML2 equivalent of the USTDSIZSEL macro
--  toggle(FORM,BOOLEAN)             -                   Updates the active status of the gadgets after a change of the selected RTOGGLE
--
define object DRABACKHANDLER
-- Correct, the object should be empty!
endobject

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Creates a global instance of itself
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .globalInstance()
  !!backHandler = !this
endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Creates a set of gadgets handling the backing sheet reference an dfile name
--
-- Method Type: Procedure
-- Arguments:
--   1  STRING The form name without the leading underscore or double exclamation mark
--   2  REAL   The width of the _BSRF OPTION gadget
--   3  STRING The 'at ...' specification for the _BTAG frame
-- Return:
--
------------------------------------------------------------------------
define method .setup(!formName is STRING, !bsrfWidth is REAL, !at is STRING)
  PATH DOWN
  frame _BTAG |Backing Sheet| $!at
    VDIST 0
    rtoggle _BSOPT1 |Unset|
    rtoggle _BSOPT2 |Reference|
    rtoggle _BSOPT3 |Filename|
    option _BSRF at xmax_BSOPT2 ymin_BSOPT2 call |!!backHandler.handleBSRF(!!$!formName)| width $!bsrfWidth
    !textWidth = !bsrfWidth + 2
    text   _BSFN at xmax_BSOPT2 ymin_BSOPT3 call |!!backHandler.handleBSFN(!!$!formName)| width $!textWidth STRING
  exit
  !gadget = _BTAG
  !gadget.callback = |!!backHandler.toggle(!!$!formName, true)|
endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      toggle
--
-- Description: Updates the active status of the gadgets after a change of the selected RTOGGLE
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM    The form to operate on
--   2  BOOLEAN True, if the full update is requested. False - only the active status is updated
-- Return:
--
------------------------------------------------------------------------
define method .toggle(!form is FORM, !fullUpdate is BOOLEAN)
  !val = !form.bTag.val
  if( !val.eq(2) ) then
    if( !fullUpdate ) then
      !form.bsrf.select('RText', 'unset')
      !form.bsfn.val = 'unset'
      BSFN unset
    endif
    !form.bsrf.active = true
    !form.bsfn.active = false
  elseif( !val.eq(3) ) then
    if( !fullUpdate ) then
      !form.bsrf.select('RText', 'unset')
      var !bsfn BSFN
      !form.bsfn.val = !bsfn
      BSRF =0
    endif
    !form.bsrf.active = false
    !form.bsfn.active = true
  else
    if( !fullUpdate ) then
      !form.bsrf.select('RText', 'unset')
      BSRF =0
      BSFN unset
      !form.bsfn.val = 'unset'
    endif
    !form.bsrf.active = false
    !form.bsfn.active = false
  endif
endmethod
-- End of method definition for .toggle()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialises the gadgets. Assumes, that form's _USERDATA has been set
--
-- Method Type: Procedure
-- Arguments:
--   1  STRING The name of the form to initialise
--   2  REAL   The width of the _BSRF OPTION gadget
--   3  BOOLEAN True, if the full INIT is required
-- Return:
--
------------------------------------------------------------------------
define method .init(!formName is STRING, !gWidth is REAL, !isInit is BOOLEAN)
  !gadget = !!$!formName$n.bsrf
  if( !isInit ) then
    !dText = ARRAY()
    !rText = ARRAY()
    !dText[1] = 'unset'
    !rText[1] = 'unset'
    -- Goto backing sheet area
    if ( |$_CDRUDFLTS_BSRF| eq |unset| ) then
      -- ERROR |No standard backing sheets available, contact your System Administrator|
    else
      $_CDRUDFLTS_BSRF
      -- HANDLE (41,69)
      handle (2,109)
        error |Backing sheet file area not set up, contact your System Administrator|
      elsehandle None
        !nBacks = MEM BACK COUNT
        if( !nBacks.eq(0) ) then
          -- ERROR |No standard backing sheets available, contact your System Administrator|
        else
           do !c to !nBacks
            BACK $!c
            !name = NAME
            !cutname =  CUTNAME $!gWidth
            !dText.append(!cutname)
            !rText.append(!name)
           enddo
        endif
      endhandle
    endif

    !gadget.dText = !dText
    !gadget.rText = !rText
  endif

  $_USERDATA
  var !bsrf BSRF
  var !bsfn BSFN
  if( !bsrf.eq('=0/0') ) then
    !gadget.select('Rtext', 'unset')
    var _BSFN '$!bsfn'
    !gadget.active = false
    if( !bsfn.eq('unset') ) then
      !ind = 1
    else
      !ind = 3
    endif
    !!$!formName$n.bsfn.active = !ind.eq(3)
    !!$!formName$n.bTag.val = !ind
  else
    !gadget.select('Rtext', !bsrf)
    handle (61,122) (61,567) $* selected element is not in list
      !cutname  = CUTNAME $!gWidth of $!bsrf
      !gadget.add(!cutname, !bsrf)
      !gadget.select('RText', !bsrf)
    endhandle
    var _BSFN 'unset'
    !gadget.active = true
    !!$!formName$n.bsfn.active = false
    !!$!formName$n.bTag.val = 2
  endif
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      handleBSRF
--
-- Description: Callback routine for the BSRF OPTION gadget
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM  The form containing the backing sheet handling gadgets
-- Return:
--
------------------------------------------------------------------------
define method .handleBSRF(!form is FORM)
  !theRef = !form.bsrf.selection()
  !val = !form.bTag.val
  !type = TYPE
  if( !theRef.eq('unset') ) then
    BSRF =0
    if( !val.neq(1) ) then
      !form.bTag.val = 1
      !this.toggle(!form, false)
    endif
  else
    if( !val.neq(2) ) then
      !form.bTag.val = 2
      !this.toggle(!form, false)
    endif
    BSRF $!theRef
    handle (64,10) (2,21)
      !res = !!alert.confirm('$!type and Backing sheet sizes are different. Do you want to change the $!type size?')
      if( !res.eq('YES') ) then
        -- var !units UNITS
        $!theRef
        var !size SIZE
        SAME
        SIZE $!size
        handle (64,280)
          BSRF =0/0
          SIZE $!size
        endhandle
        !xSize = !size.before(' ')
        !ySize = !size.after(' ')
        var _XSIZE $!xSize
        var _YSIZE $!ySize
        BSRF $!theRef
        handle (64,382) (64,394) $* Data for codeword not accessible
        endhandle
      else
        var !bsrf name of BSRF
        if( !bsrf.eq('unset') or !bsrf.eq('=0/0') ) then
          !form.bTag.val = 1
          !this.toggle(!form, false)
          !bsrf = 'unset'
        endif
        !form.bsrf.select('RText', !bsrf)
        handle any
        endhandle
        return
      endif
    elsehandle (64,837)
		-- 212861:Pdms Draft 12.1sp5 - Selecting Truetype Backing Sheet on dept & regi creation causes Warning message
		-- get font selected in other tab of form
		!val = !form.font.val
		$* 217590:PDMS 12.1.SP5_Test#10: Error message "(2,759) Object does not have a member FONT" is displayed while setting reference backing sheet.
		$* there won't be a FONT in the form if it's CDRMSHEET
		handle (2,759)
			var !ttf TTFENA of $!theRef
			if (!ttf.eq('On')) then
				!val = 5
				!ftype = 1
			else
				!val = 1
				!ftype = 0
			endif
		elsehandle none
		!num = !form.font.rtext[!val]
		!ftype = !!fontManager.fontType(!num.real())
		endhandle

		-- get TTFENAble state of bsrf
		var !ttf TTFENA of $!theRef
		-- if they're not (going to be) compatible, issue a warning
		if ( ( !ttf.eq('On') and !ftype.eq(0)) or ( !ttf.neq('On') and !ftype.neq(0)) ) then
		  !!alert.warning('The selected backing sheet has incompatible font settings with the $!type being modified. The backing sheet reference has NOT been set!')
		endif
    endhandle
    var _BSFN 'unset'
  endif
  !this.stdSizeSelection(!form.stdsiz, !form.xSize.val.string(), !form.ySize.val.string())
endmethod
-- End of method definition for .handleBSRF()

------------------------------------------------------------------------
--
-- Method:      stdSizeSelection
--
-- Description: PML2 equivalent of the USTDSIZSEL macro
--
-- Method Type: Procedure
-- Arguments:
--   1  GADGET  The OPTION gadget with standard sizes
--   2  STRING  The sheet X size (ISOU gadget)
--   3  STRING  The sheet Y size (ISOU gadget)
-- Return:
--
------------------------------------------------------------------------
define method .stdSizeSelection(!gadget is GADGET, !xSize is STRING, !ySize is STRING)
  -- get valid sheet widths & heights from globals
  -- these are set by macro ULOADSHEET
  !validX = !!cdsWidth.split()
  !validY = !!cdsHeigh.split()

  !found = false
  !ptr = 0
  do !xVal values !validX
    !ptr = !ptr + 1
    if( !xSize.real()eq(!xVal.real()) ) then
      -- check corresponding YVAL
      !yVal = !validY[!ptr]
      if( !ySize.real().eq(!yVal.real()) ) then
        -- this array entry matches the passed arguments...
        !found = true
        break
      endif
    endif
  enddo

  -- select a matching std size option or set to blank
  if( !found ) then
    !gadget.val = !ptr + 1 $* allow for 1st blank item at start of list
  else
    !gadget.val = 1
  endif
endmethod
-- End of method definition for .stdSizeSelection()

------------------------------------------------------------------------
--
-- Method:      handleBSFN
--
-- Description: Callback routine for the BSFN TEXT gadget
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM  The form containing the backing sheet handling gadgets
-- Return:
--
------------------------------------------------------------------------
define method .handleBSFN(!form is FORM)
  var !theFile '$_BSFN'
  if( !theFile.neq('unset') ) then
    BSRF =0
    if( !theFile.substring(1,1).neq('/') ) then
      !theFile = '/' & !theFile
    endif
    handle any
      BSFN UNSET
      return error 1 'Invalid filename'
    endhandle
    BSFN $!theFile
    handle any
      !form.bsfn.val = 'unset'
      return error 1 |$!!error.text|
    endhandle
    !form.bsrf.val = 1
    !form.bTag.val = 3
    !this.toggle(!form, false)
  elseif( !form.bTag.val.neq(2) ) then
    BSFN UNSET
    !form.bTag.val = 1
    !this.toggle(!form, false)
  endif
endmethod
-- End of method definition for .handleBSFN()

------------------------------------------------------------------------
--
-- Method:      getData
--
-- Description: Retrieves data from the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM  The form containing the backing sheet handling gadgets
-- Return:
--   ARRAY  [1] - status code (1, 2, 3 - OK, -1 - Error), [2] - value
------------------------------------------------------------------------
define method .getData(!form is FORM) is ARRAY
  !val = !form.bTag.val
  if( !val.eq(1) ) then
    !res[1] = 1
    !res[2] = 'unset'
  elseif( !val.eq(2) ) then
    !res[1] = 2
    !res[2] = !form.bsrf.selection()
    if( !res[2].empty() or !res[2].eq('unset') ) then
      !res[1] = 1
      !res[2] = 'unset'
    endif
  elseif( !val.eq(3) ) then
    !res[1] = 3
    !res[2] = !form.bsfn.val.trim()
    if( !res[2].empty() ) then
      !res[1] = 1
      !res[2] = 'unset'
    endif
  else
    !res[1] = -1
    !res[2] = ''
  endif
  return !res
endmethod
-- End of method definition for .getData()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Applies the backing sheet data
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM  The form containing the backing sheet handling gadgets
-- Return:
--
------------------------------------------------------------------------
define method .apply(!form is FORM)
  !val = !form.bTag.val
  if( !val.eq(1) ) then
    BSRF =0
    BSFN UNSET
  elseif( !val.eq(2) ) then
    !bsrf = !form.bsrf.selection()
    if( !bsrf.eq('unset') ) then
      BSRF =0
    else
      !this.handleBSRF(!form)
    endif
  elseif( !val.eq(3) ) then
    !bsfn = !form.bsfn.val.trim()
    if( !bsfn.empty() or !bsfn.eq('unset') ) then
      BSFN UNSET
    else
      !this.handleBSFN(!form)
    endif
  endif
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      reset
--
-- Description: Workaround for defect P-845
--
-- Method Type: Procedure
-- Arguments:
--   1  FORM  The form containing the backing sheet handling gadgets
-- Return:
--
------------------------------------------------------------------------
define method .reset(!form is FORM)
  !val = !form.bTag.val
  if( !val.eq(1) or !val.eq(3) ) then
    !form.bsrf.val = 1 $* force selection of 'unset'
  elseif( !val.eq(2) ) then
    var !bsrf BSRF
    !form.bsrf.select('RText', !bsrf)
    handle ANY
    endhandle
  endif
  !this.toggle(!form, false)
endmethod
-- End of method definition for .reset()

------------------------------------------------------------------------
--
-- Method:      fillOtherList
--
-- Description: Fills in other lists in the form
--
-- Method Type: Procedure
-- Arguments:
--   1  STRING  Gadget name
--   2  STRING  DB element name being collected
--   3  STRING  element description
--   4  STRING  The width for 'cutname' (as a macro argument, so a STRING)
--   5  BOOLEAN True, if ERROR should be raised when no elements found
--   6  BOOLEAN True, if the full loading of the list is required
-- Return:
--
------------------------------------------------------------------------
define method .fillOtherList(!gadget is STRING, !dbName is STRING, !description is STRING, !gWidth is STRING, !notFoundErr is BOOLEAN, !isInit is BOOLEAN)
  !g = _$!gadget
  if( !isInit ) then
    -- Pick up rule sets/circulation lists
    !dText[1] = 'unset'
    !rText[1] = 'unset'
    !mem = REF
    -- Goto rule set area
    !defName = !!cdrudflts.$!gadget$n.val.trim()
    !err = False
    if( !defName.empty() ) then
      !err = True
    else
      $!defName
      handle any
        !err = True
      endhandle
    endif
    if( !err ) then
      error |$!description area not set up, contact your System Administrator|
      !g.dText = !dText
      !g.rText = !rText
      return
    endif

    var !memTab collect all $!dbName for $!defName
    if( !memTab.empty() ) then
      if( !notFoundErr ) then
        error |No standard $!description$ns available, contact your System Administrator|
      endif
    else
      do !c values !memTab
        $!c
        !name = NAME
        !cutname =  cutname $!gWidth
        !dText.append(!cutname)
        !rText.append(!name)
      enddo
    endif
    $!mem
    !g.dText = !dText
    !g.rText = !rText
  endif
  $_USERDATA
  var !ref $!gadget
  if( !ref.eq('=0/0') ) then
    !g.val = 1
  else
    !g.select('Rtext', !ref)
     handle (61,122) $* selected element is not in list
       !cutname  = cutname $!gWidth of $!ref
       !g.add(!cutname, !ref)
       !g.select('Rtext', !ref)
     endhandle
  endif
endmethod
-- End of method definition for .fillOtherList()
