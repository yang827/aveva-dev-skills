-- Created:         14 June 2001
--
--
-- Description:
-- Change Ruleset form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set reference to style
--  applyActive()                    -                   Set apply button active status
--  ce()                             -                   Re-initialise the form for the selected element
--  checkWith()                      -                   Test the entered 'with' string for validity
--  createRule()                     -                   Create a new acrule or dcrule
--  criteria()                       -                   Read the selected rule criteria and set relevant gadget values
--  crstDisplay()                    -                   Populate gadget for change rulesets
--  deleteRule()                     -                   Delete the selected rule
--  dismiss()                        -                   Close the form
--  dispStyl()                       -                   Populate the style mode gadget with the options for the relevant rule type
--  init()                           -                   The form initialisation
--  loadMenu(REAL)                   -                   Load the criteria element menu
--  modify(STRING)                   -                   Add or Remove elements to the criteria list
--  newMenu()                        -                   Load the selected menu options
--  ruleDisplay()                    -                   Populate the rule list gadget
--  selNewRule()                     -                   Display selected rule data
--  setHatch()                       -                   Display selected hatching
--  setStyle()                       -                   Display selected style
--  setStyle(BOOLEAN)                -                   Display selected style
--  stylDisplay()                    -                   Get all styles for relevant rule type
--  stylMode()                       -                   Build the style mode gadget options
--  stylSelect()                     -                   Get all change style libraries
--
------------------------------------------------------------------------
-- Define Object
define object DRACHANGERULE

  member .form is FORM

endobject
-- End of Object definition

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Set reference to style
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .apply()

  -- Initialise variables
  !ce = !!ce
  !style = !this.form.styles.selection()

  -- Access the change rule
  !!ce = !this.form.crulRefe

  -- Set the change rule attributes
  if (!!ce.type.upCase().eq('ACRULE')) then

    -- Read the code value
    !aSCode = !this.form.anno.selection()

    -- Set styf and code
    ACSTYF $!style
    ASCODE $!aSCode

  else

    -- Check for empty output
    if (!this.form.output.rtext.empty()) then
      !!alert.warning('You have not set any "FOR" elements!')
      return
    endif

    -- Build elements string
    do !index ind !this.form.output.rtext

      -- Initialise variables
      !word = !this.form.output.rtext[!index]

      -- Test for just "ALL"
      if (!word.eq('ALL')) then

        -- Set string
        !elemString = !word

        -- Test for any selective "with" syntax
        if (!this.form.with.val.eq('')) then
          !!alert.warning('Cannot set the criteria to "ALL" without some selective "WITH" expression!')
          !this.form.with.val = 'MODIFIED (POS)'
          return
        endif

      else

        -- For first word
        if (!index.eq(1)) then
          !elemString = 'ALL ( ' & !word

        -- For all other words
        else
          !elemString = !elemString & ' ' & !word
        endif

        -- For last word
        if (!index.eq(!this.form.output.rtext.size())) then
          !elemString = !elemString & ' )'
        endif

      endif

    enddo

    -- Add the selective "with" string
    if (!this.form.with.val.eq('')) then
      !criteria = !elemString
    else
      !criteria = !elemString & ' WITH ' & !this.form.with.val
    endif

    -- Set styf and criteria
    DCSTYF $!style
    CRITERIA $!criteria

    -- Test if the criteria being set is too long to read
    !critArray = !!draGetCriteria(!this.form.crulRefe)
    if (!critArray[1].eq('TOO LONG')) then
      !!alert.warning('The criteria attribute has been set but is too long to read at a later session!')
    endif

  endif

  -- Return to original position in hierarchy
  !!ce = !ce

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .applyActive()
--
-- Description: Set apply button active status
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .applyActive()

  -- Get gadgets status
  !testA = !this.form.crul.selection('RTEXT').eq('NONE')
  !testB = !this.form.style.val.upCase().eq('UNSET')
  !testC = !this.form.styles.selection('RTEXT').eq('NONE')
  !testD = !this.form.output.rtext.empty()

  -- For no rules
  if (!testA) then
    !this.form.apply.active = false
  endif

  -- For anno rules
  if (!this.form.ruleType.eq('ANNO')) then

    if (!testA or !testB or !testC) then
      !this.form.apply.active = false
    endif
    if (!testA.not() and !testB.not() and !testC.not()) then
      !this.form.apply.active = true
    endif

  -- For design rules
  else

    if (!testA or !testB or !testC or !testD) then
      !this.form.apply.active = false
    endif
    if (!testA.not() and !testB.not() and !testC.not() and !testD.not()) then
      !this.form.apply.active = true
    endif

  endif

endmethod
-- End of method definition for ..applyActive()

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Re-initialise the form for the selected element
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ce()

  -- Attempt to reload the form for the current element
  !type = !!ce.type.upCase()
  if (!type.eq('ACRULE') or !type.eq('DCRULE') or !type.eq('CRST')) then
    !!draShowChange('!!draChangeRule','CRST')
  else
    !!draShowChange('!!draChangeRule','LIBY')
  endif

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .checkWith()
--
-- Description: Test the entered 'with' string for validity
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkWith()

  -- Initialise variables
  !withString = !this.form.with.val.trim()
  !empty = ARRAY()

  -- For any input string
  if (!withString.neq('')) then
    VAR !unusedTest COLLECT ALL WITH ($!withString) FROM !empty
      handle any
        !!alert.error(|Invalid selection: | & !!error.text)
      endhandle
  endif

endmethod
-- End of method definition for .checkWith()

------------------------------------------------------------------------
--
-- Method:      .createRule()
--
-- Description: Create a new acrule or dcrule
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .createRule()

  -- Access the change ruleset
  !!ce = !this.form.crstRefe

  -- Access the last mem
  if (!!ce.mcount.neq(0)) then
    LAST MEM
  endif

  -- Create the new rule
  if (!this.form.createType.selection().eq('ACRULE')) then
    $M "%PDMSUI%/DRA/CLIB/FCREATE" $<ACRULE$> $<NO$> $<!!draChangeRule.formMethods.selNewRule()$>
  else
    $M "%PDMSUI%/DRA/CLIB/FCREATE" $<DCRULE$> $<NO$> $<!!draChangeRule.formMethods.selNewRule()$>
  endif

endmethod
-- End of method definition for .createRule()

------------------------------------------------------------------------
--
-- Method:      .criteria()
--
-- Description: Read the selected rule criteria and set relevant gadget values
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .criteria()

  -- Test for rule entry 'NONE' selected
  if (!this.form.crul.selection('Dtext').eq('None')) then

    -- Set gadgets
    !this.form.output.clear()
    !this.form.with.clear()
    !this.form.style.val = 'Unset'

    -- Set active
    !this.form.menu.active = false
    !this.form.add.active = false
    !this.form.rem.active = false
    !this.form.output.active = false
    !this.form.with.active = false

    -- Load default menu
    !this.loadMenu(1)
    !this.form.menu.val = 12
    return

  endif

  -- Store current selected rule
  !this.form.crulRefe = !this.form.crul.selection().dbref()

  -- Get the criteria for this rule
  !critArray = !!draGetCriteria(!this.form.crulRefe)

  -- Store rule type in form member
  !this.form.ruleType = !critArray[1]

  -- Activate the 'with' gadget type ELEMENTS only
  if (!this.form.ruleType.eq('ELEMENTS') or !this.form.ruleType.eq('TOO LONG')) then
    !this.form.with.active = true
  else
    !this.form.with.clear()
    !this.form.with.active = false
  endif

  -- Set criteria gadgets
  if (!this.form.ruleType.eq('ANNO')) then

    -- Populate option gadget
    !dtext[1] = |Changed Annotation|
    !dtext[2] = |Added Annotation|
    !dtext[3] = |Added & Changed|
    !rtext[1] = |CHANGEDANNO|
    !rtext[2] = |ADDEDANNO|
    !rtext[3] = |CHANGED AND ADDEDANNO|
    !this.form.anno.dtext = !dtext
    !this.form.anno.rtext = !rtext

    -- Select current setting
    !this.form.anno.select('RTEXT',!critArray[4])

    -- Clear gadgets
    !this.form.menu.clear()
    !this.form.output.clear()

    -- Set active
    !this.form.anno.active = true
    !this.form.menu.active = false
    !this.form.add.active = false
    !this.form.rem.active = false
    !this.form.output.active = false

  else

    -- Test for criteria too long
    if (!critArray[1].eq('TOO LONG')) then

      -- Warn
      !!alert.warning('Cannot read the rule since the criteria value is too long!')

      -- Load default menu
      !this.loadMenu(1)
      !this.form.menu.val = 12

      -- Clear gadgets
      !this.form.output.clear()
      !this.form.with.clear()

    else

      -- Initialise variables
      !dtext = ARRAY()
      !rtext = ARRAY()

      -- Populate the 'output' gadget
      do !index ind !critArray[2]
        !dtext.append(!critArray[3][!index])
        !rtext.append(!critArray[2][!index])
      enddo
      !this.form.output.dtext = !dtext
      !this.form.output.rtext = !rtext

      -- Set 'with' gadget
      !this.form.with.val = !critArray[4]

      -- Load the element menu
      !this.loadMenu(!critArray[6])

      -- Select the first element
      if (!this.form.output.rtext.empty()) then
        !this.form.menu.val = 12
      else
        !this.form.menu.select('RTEXT',!this.form.output.rtext[1])
      endif

    endif

    -- Clear the annotation gadget
    !this.form.anno.clear()

    -- Set active
    !this.form.anno.active = false
    !this.form.menu.active = true
    !this.form.add.active = true
    !this.form.rem.active = true
    !this.form.output.active = true

  endif

  -- Select the relevant style library
  !this.stylSelect()
  if (!critArray[5].unset().not() and !critArray[5].badref().not()) then
    !this.form.styLib.select('RTEXT',!critArray[5].owner.string())
  endif

  -- Check for style libraries
  if (!this.form.styLib.selection('RTEXT').neq('NONE')) then

    -- Load the relevant style mode
    !this.stylMode()

    -- Load the relevant styles
    !this.stylDisplay()

    -- Select the relevant style
    !fromSelection = !critArray[5].unset().not() and !critArray[5].badref().not()
    if( !fromSelection ) then
      !this.form.styles.select('RTEXT',!critArray[5].string())
    endif

    -- Set the style choice
    !this.setStyle(!fromSelection)

  endif

  -- Set apply button active status
  !this.applyActive()

endmethod
-- End of method definition for .criteria()

------------------------------------------------------------------------
--
-- Method:      .crstDisplay()
--
-- Description: Populate gadget for change rulesets
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .crstDisplay()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get all change rulesets for this rplb and populate ruleset gadget
  VAR !allCrst COLL ALL CRST FOR $!<this.form.rplbRefe>
  do !crst val !allCrst
    !dtext.append(!crst.dbref().flnm)
    !rtext.append(!crst)
  enddo
  !this.form.crst.dtext = !dtext
  !this.form.crst.rtext = !rtext

  -- For the form being called to modify a crst, select the current one
  !ceType = !!ce.type.upCase()
  if (!this.form.formType.eq('CRST') and !ceType.eq('CRST')) then
    !this.form.crstRefe = !!ce
    !this.form.crst.select('RTEXT',!this.form.crstRefe.string())
  elseif( !ceType inset('ACRULE', 'DCRULE') ) then
    !this.form.crstRefe = !!ce.owner
    !this.form.crst.select('RTEXT',!this.form.crstRefe.string())
  endif

  -- Get all change rules for the selected crst
  !this.ruleDisplay()

endmethod
-- End of method definition for .crstDisplay()

------------------------------------------------------------------------
--
-- Method:      .deleteRule()
--
-- Description: Delete the selected rule
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .deleteRule()

  -- Access the change rule
  !!ce = !this.form.crulRefe
  !type = !!ce.type.upCase()

  -- Delete the rule
  !response = !!alert.confirm(' Are you sure you want to delete ' & !type & ' ' & !!ce.flnm & '?')
  if (!response.eq('YES')) then

    -- Delete element
    DELETE $!type

    -- Refresh the form
    !this.ruleDisplay()

  endif

endmethod
-- End of method definition for .deleteRule()

------------------------------------------------------------------------
--
-- Method:      .dismiss()
--
-- Description: Close the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dismiss()

  hide !!draChangeRule

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      .dispStyl()
--
-- Description: Populate the style mode gadget with the options for the relevant rule type
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dispStyl()

  -- Populate style mode with the relevant options
  if (!this.form.crulRefe.type.upCase().eq('ACRULE')) then

    !dtext[1] = |Name|
    !dtext[2] = |Gen|
    !dtext[3] = |Hatch|
    !dtext[4] = |Style|
    !rtext[1] = |NAME|
    !rtext[2] = |GEN|
    !rtext[3] = |HATCH|
    !rtext[4] = |STYLE|
    !this.form.styMode.dtext = !dtext
    !this.form.styMode.rtext = !rtext

  else

    !dtext[1] = |Name|
    !dtext[2] = |Gen|
    !dtext[3] = |Pipe|
    !dtext[4] = |Steel|
    !dtext[5] = |Hatch|
    !rtext[1] = |NAME|
    !rtext[2] = |GEN|
    !rtext[3] = |PIPE|
    !rtext[4] = |STEEL|
    !rtext[5] = |HATCH|
    !this.form.styMode.dtext = !dtext
    !this.form.styMode.rtext = !rtext

  endif

endmethod
-- End of method definition for .dispStyl()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: The form initialisation
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Test location
  if (!!ce.type.upCase().eq('RPLB')) then
    !this.form.rplbRefe = !!ce
  elseif (!!ce.type.upCase().eq('CRST')) then
    !this.form.rplbRefe = !!ce.owner
    !this.form.crstRefe = !!ce
  elseif (!!ce.type.upCase().eq('ACRULE') or !!ce.type.upCase().eq('DCRULE')) then
    !this.form.rplbRefe = !!ce.owner.owner
    !this.form.crstRefe = !!ce.owner
  endif

  -- Set ce
  !this.form.rplb.val = !this.form.rplbRefe.flnm

  -- Get all change rulesets for the current rplb
  !this.crstDisplay()

  -- Set apply button active status
  !this.applyActive()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .loadMenu(REAL)
--
-- Description: Load the criteria element menu
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of AVEVA element menu array to load
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .loadMenu(!arg is REAL)

  -- Initialise variables
  !dtext[1] = |--------MENUS--------|
  !rtext[1] = |TITLE|

  -- Append the main menu options
  -- *** OLD PML SYNTAX
  do !index ind !!cdElemMenu

    -- Check for attempt to load current menu
    skip if (!index.eq(!arg))

    !dtext.append(!!cdElemMenu[!index])
    !rtext.append('MENU\' & !index)

  enddo

  -- Put the current menu header into the list
  -- *** OLD PML SYNTAX
  !menuString = '-' & !!cdElemMenu[!arg] & '------------------------'
  !dtext.append(!menuString.subString(1,21))
  !rtext.append('TITLE')

  -- Append current menu options
  -- *** OLD PML SYNTAX
  do !value val !!cdElem$n$!arg
    !dtext.append(!value.before('\'))
    !rtext.append(!value.after('\'))
  enddo

  -- Populate gadget
  !this.form.menu.dtext = !dtext
  !this.form.menu.rtext = !rtext

endmethod
-- End of method definition for .loadMenu(REAL)

------------------------------------------------------------------------
--
-- Method:      .modify(STRING)
--
-- Description: Add or Remove elements to the criteria list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Whether to ADD or REMOVE elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .modify(!arg is STRING)

  -- Initialise variables
  !dtext = !this.form.output.dtext
  !rtext = !this.form.output.rtext

  -- Add the selected element to the output gadget
  if (!arg.eq('ADD')) then

    !sel = !this.form.menu.selection('RTEXT')
    !dSel = !this.form.menu.selection('DTEXT')
    -- Check if not already added
    if (!dtext.findFirst(!dSel).unset()) then

      -- Don't add the group titles
      if( !sel.eq('TITLE') ) then
        return
      endif

      -- Check for ALL
      if (!dtext.empty().not()) then

        if (!sel.eq('ALL') and !dtext.empty().not()) then
          !response = !!alert.confirm('Cannot add "ALL" when other elements exist. Do you want to delete the existing?')
          if (!response.eq('YES')) then
            !dtext = ARRAY()
            !rtext = ARRAY()
          else
            return
          endif
        endif
        if (!sel.neq('ALL') and !rtext[1].eq('ALL')) then
          !response = !!alert.confirm('Cannot add another element when "ALL" exists. Do you want to delete the existing?')
          if (!response.eq('YES')) then
            !dtext = ARRAY()
            !rtext = ARRAY()
          else
            return
          endif

        endif

      endif

      -- Append selection to output arrays
      !dtext.append(!dSel)
      !rtext.append(!sel)

    else
      !!alert.warning('The selected element already exists in the list!')
      return
    endif

  -- Remove the selected item from the output gadget
  else

    -- Check for empty list
    if (!dtext.empty()) then
      return
    endif

    -- Remove the selected element from the output arrays
    !index = !dtext.findFirst(!this.form.output.selection('DTEXT'))
    !dtext.remove(!index)
    !rtext.remove(!index)

  endif

  -- Re-populate gadget
  !this.form.output.dtext = !dtext
  !this.form.output.rtext = !rtext

  -- Set apply button active status
  !this.applyActive()

endmethod
-- End of method definition for .modify(STRING)

------------------------------------------------------------------------
--
-- Method:      .newMenu()
--
-- Description: Load the selected menu options
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .newMenu()

  !sel = !this.form.menu.selection()
  -- Check for menu
  if (!sel.split('\')[1].eq('MENU')) then

    -- Load selected menu and choose first option
    !this.loadMenu(!sel.split('\')[2].real())
    !this.form.menu.val = 12

  endif

endmethod
-- End of method definition for .newMenu()

------------------------------------------------------------------------
--
-- Method:      .ruleDisplay()
--
-- Description: Populate the rule list gadget
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ruleDisplay()

  -- Initialise variables
  !crstRefe = !this.form.crst.selection().dbref()
  !this.form.crstRefe = !crstRefe
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get all rules and build rule arrays
  VAR !allRule COLL ALL (ACRULE DCRULE) FOR $!crstRefe
  do !rule val !allRule
    !dtext.append(!rule.dbref().flnm)
    !rtext.append(!rule)
  enddo

  -- Test for no rules
  if (!dtext.empty()) then

    -- Populate gadget
    !dtext.append('None')
    !rtext.append('NONE')
    !this.form.crul.dtext = !dtext
    !this.form.crul.rtext = !rtext

    -- Set gadgets
    !this.form.output.clear()
    !this.form.with.clear()
    !this.form.anno.clear()
    !this.form.anno.active = false
    !this.form.style.val = 'Unset'

    -- Load default menu
    !this.loadMenu(1)
    !this.form.menu.val = 12

    -- Set criteria active status
    !this.criteria()

    -- Set styles active status
    !this.stylMode()

  else

    -- Populate gadget
    !this.form.crul.dtext = !dtext
    !this.form.crul.rtext = !rtext

    -- Select the current element
    if( !!ce.type.upCase() inset('ACRULE', 'DCRULE') ) then
      !this.form.crulRefe = !!ce
      !this.form.crul.select('RTEXT',!this.form.crulRefe.string())
    else
      !this.form.crulRefe = !this.form.crul.rtext[1].dbref()
    endif

    -- Load style libraries & rule criteria
    !this.stylSelect()
    !this.criteria()

  endif

  -- Set apply button active status
  !this.applyActive()

endmethod
-- End of method definition for .ruleDisplay()

------------------------------------------------------------------------
--
-- Method:      .selNewRule()
--
-- Description: Display selected rule data
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .selNewRule()

-- Called by method !this.createRule as the callback used by 'pre PML2 appware'

  -- Store new element in form method
  !this.form.crulRefe = !!ce

  -- Rebuild rule display
  !this.ruleDisplay()

  -- Select current element
  !this.form.crul.select('RTEXT',!this.form.crulRefe.string())

endmethod
-- End of method definition for .selNewRule()

------------------------------------------------------------------------
--
-- Method:      .setHatch()
--
-- Description: Display selected hatching
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setHatch()
  -- Initialise variables
  !visible = true
  !styleRefe = !this.form.styles.selection().dbref()
  handle ANY
    !visible = false
  endhandle
  if( !visible ) then
    !fStyleNumber = FSTNUMBER of $!styleRefe
    handle ANY
      !visible = false
    endhandle
  endif
  !this.form.hatch.visible = !visible
  if( not !visible ) then
    return
  endif

  !fColour = FCONUM of $!styleRefe
  var !hatchPictureNumber HATCHPICNUMBER
  HATCHPICSETTING $!fStyleNumber $!fColour
  var !rgbStr colour RGB $!fColour
  !rgb = !rgbStr.subString(5).split(',')
  !rgbMax = MAX(!rgb[1].real(), !rgb[2].real(), !rgb[3].real())
  -- Use 25 as a threshold value determining when to use a white
  -- background instead of white
  -- This enables to see the (almost) black hatch pattern
  if( !rgbMax.lt(25) ) then
    !bgCol = 10
  else
    !bgCol = 15
  endif

  !formName = !this.form.name()
  edit _$!formName_hatch area
    PUT WWPICTURE $!hatchPictureNumber
    setcolour $!bgCol
  exit
endmethod
-- End of method definition for .setHatch()

------------------------------------------------------------------------
--
-- Method:      .setStyle()
--
-- Description: Display selected style
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setStyle()
  !this.setStyle(true)
endmethod
-- End of method definition for .setStyle()

------------------------------------------------------------------------
--
-- Method:      .setStyle(fromSelection)
--
-- Description: Display selected style
--
-- Function Type:   Procedure
-- Arguments:
--   1 R BOOLEAN  True - take value from .styles selection. False - consider unset
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .setStyle(!fromSelection is BOOLEAN)

  if( !fromSelection ) then
    -- Check for a valid style
    if (!this.form.styles.selection('RTEXT').eq('NONE')) then
      return
    endif
    -- Set style gadget as the choice for the rule
    !styleRef = !this.form.styles.selection().dbref()
  else
    !styleRef = object DBREF()
  endif
  if( !styleRef.unset() ) then
    !this.form.style.val = 'Unset'
    !this.form.hatch.visible = false
    !this.form.apply.active = false
  else
    !this.form.style.val = !styleRef.flnm.string()

    -- Display hatch pattern
    !this.setHatch()
    if( not !this.form.apply.active ) then
      !this.applyActive()
    endif
  endif

endmethod
-- End of method definition for .setStyle()

------------------------------------------------------------------------
--
-- Method:      .stylDisplay()
--
-- Description:  Get all styles for relevant rule type
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stylDisplay()

  -- Initialise variables
  !rplbRefe = !this.form.styLib.selection('RTEXT').dbref()

  -- Get all styles for current library but only get the relevant styles that match the rule type
  if( !rplbRefe.unset() ) then
    !allStyle = ARRAY()
  elseif (!this.form.crulRefe.type.upCase().eq('ACRULE')) then
    VAR !allStyle COLL ALL ACSTYL FOR $!rplbRefe
  else
    VAR !allStyle COLL ALL DCSTYL FOR $!rplbRefe
  endif

  -- Get display string for the current selected style & populate list gadget
  !dtext = !!draDispStyle(!allStyle, !this.form.styMode.selection('RTEXT'), false)

  -- Test for no rules
  if (!dtext.unset() or !dtext.empty() or !dtext[1].upCase().eq('NONE')) then

    -- Populate gadget
    !dtext = ARRAY()
    !rtext = ARRAY()
    !dtext.append('None')
    !rtext.append('NONE')
    !this.form.styles.dtext = !dtext
    !this.form.styles.rtext = !rtext

  else

    -- Populate gadget
    !this.form.styles.dtext = !dtext
    !this.form.styles.rtext = !allStyle

    -- Display the choice
    !this.setStyle(true)

    -- Display hatch pattern
    !this.setHatch()

  endif

endmethod
-- End of method definition for .stylDisplay()

------------------------------------------------------------------------
--
-- Method:      .stylMode()
--
-- Description: Build the style mode gadget options
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stylMode()

  -- For the selected rule
  if (!this.form.crul.selection().eq('NONE') or !this.form.styLib.selection().eq('NONE')) then

    -- Clear style gadgets and set inactive
    !this.form.styLib.clear()
    !this.form.styles.clear()
    !this.form.styMode.clear()
    !this.form.styLib.active  = false
    !this.form.styles.active  = false
    !this.form.styMode.active = false
    !this.form.hatch.active   = false

  else

    -- Set style gadgets active
    !this.form.styLib.active = true
    !this.form.styles.active = true
    !this.form.styMode.active = true

    -- Store selected rule in form
    !this.form.crulRefe = !this.form.crul.selection().dbref()

    -- Load the relevant style mode
    !this.dispStyl()

  endif

endmethod
-- End of method definition for .stylMode()

------------------------------------------------------------------------
--
-- Method:      .stylSelect()
--
-- Description: Get all change style libraries
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stylSelect()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  !isACRULE = !this.form.crulRefe.type.upCase().eq('ACRULE')
  -- Get and load all style libraries i.e. those RPLB with sppurp set to 'change'
  VAR !allStyleLiby TSEARCH SPPURP CHANGE RPLB
  do !styleLiby val !allStyleLiby

    -- Get relevant styles that match the rule type
    if( !isACRULE ) then
      VAR !allStyl COLL ALL ACSTYL FOR $!styleLiby
    else
      VAR !allStyl COLL ALL DCSTYL FOR $!styleLiby
    endif

    -- Only add those libraries that actually own anything
    if (!allStyl.size().neq(0)) then
      !dtext.append(!styleLiby.dbref().flnm)
      !rtext.append(!styleLiby)
    endif

  enddo

  -- Test for no style libraries
  if (!dtext.empty()) then
    !!alert.warning('Warning: No style libraries found, please contact your system administrator')
    !rtext = ARRAY()
    !dtext.append('')
    !rtext.append('NONE')
  endif
  !this.form.styLib.dtext = !dtext
  !this.form.styLib.rtext = !rtext

endmethod
-- End of method definition for .stylSelect()
