-- File:            drachangestyle.pmlobj
--   Type:          Object Definition
--   Group:         Change Style
--     Keyword:     CHANGE
--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 2001
--
--
-- Description:
-- Change rule form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set style attributes
--  createStyle()                    -                   Create a new acstyle or dcstyle element
--  deleteStyle()                    -                   DELETE the relevant style
--  dismiss()                        -                   Close the form
--  getStyleAtt()                    -                   Read the style attributes and set the form gadgets as appropriate
--  init(STRING)                     -                   Form initialisation
--  init(STRING,BOOLEAN)             -                   Form initialisation
--  selNew()                         -                   Re-initialise the form for the selected style
--  stylDisplay()                    -                   Call function !!draDispStyle to determine style description
--  unsetAtt()                       -                   Unset gadgets
--
------------------------------------------------------------------------
-- Define object
define object DRACHANGESTYLE

  member .form is FORM
$(  member .select is ARRAY
  member .gadgets is ARRAY $)
  member .type is STRING
  member .gadgetGroups is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Set style attributes
--
-- Function Type: Procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
-- Define method
define method .apply()

  -- Initialise variables
  !ce = !!ce
  !sel = !this.form.styles.selection('RTEXT')
  -- Test for None
  if (!sel.eq('NONE')) then
    return
  endif

  -- Initialise variables
  !stylRefe = !sel.dbref()
  $!stylRefe
  do !root values !this.gadgetGroups
    !res = !!draColStyle.getData(!root)
    if( !res[1] ) then
      !res.remove(1)
      !!draColStyle.setAttributeValues(!root, !res)
    endif
  enddo

  -- For annotation
  if (!this.form.formType.eq('ANNOTE')) then

    $M "%PDMSUI%/dra/gen/MFONTSEL"  $<SET$> $<FONT$>
    -- Underline
    if (!this.form.underOnOff.val) then
      UNDERLINE ON
    else
      UNDERLINE OFF
    endif

    -- Brackets
    !bracket = !this.form.brackets.selection()
    BRACKETS $!bracket

  endif

  -- Return to original element
  !!ce = !ce

  -- Rebuild style display
  !this.stylDisplay()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .createStyle()
--
-- Description: Create a new acstyle or dcstyle element
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .createStyle()

  -- Access the representation library
  !!ce = !this.form.rplbRefe

  -- Access the last mem
  if (!!ce.mcount.neq(0)) then
    LAST MEM
  endif

  -- Create the new dcstyle/acstyle
  if (!this.form.formType.eq('DESIGN')) then
    !ceType = 'DCSTYL'
  else
    !ceType = 'ACSTYL'
  endif
  !!draColStyle.setFormName('draChangeStyle')
  $M "%PDMSUI%/DRA/CLIB/FCREATE"  $!ceType NO $<!!draChangeStyle.formMethods.selNew()$>
endmethod
-- End of method definition for .createStyle()

------------------------------------------------------------------------
--
-- Method:      .deleteStyle()
--
-- Description: DELETE the relevant style
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .deleteStyle()

  -- Initialise variables
  !ce = !!ce

  -- Access style
  !!ce = !this.form.styles.selection().dbref()
  DELETE $!!<ce.type>

  -- Reinitialise form
  !this.init(!this.form.formType, false)

  -- Return to original element
  if (!ce.badref().not()) then
    !!ce = !ce
  endif

endmethod
-- End of method definition for .deleteStyle()

------------------------------------------------------------------------
--
-- Method:      .dismiss()
--
-- Description: Close the form
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .dismiss()

  hide !!draChangeStyle

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Function Type: Procedure
-- Arguments:
--   1 R STRING Type of the form (DESIGN / ANNOTE)
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .init(!formType is STRING)
  !this.init(!formType, true)
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Function Type: Procedure
-- Arguments:
--   1 R STRING  Type of the form (DESIGN / ANNOTE)
--   2 R BOOLEAN True, if a full (initial) initialisation should be performed
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .init(!formType is STRING, !fullInit is BOOLEAN)

  -- Initialise variables
  !this.type = !formType.upCase()

  -- Build gadgets array for Standard pens
  if (!this.type.eq('DESIGN')) then
    !gNam[1] = 'FFPN'
    !gNam[2] = 'BFPN'
    !gNam[3] = 'CLPN'
    !gNam[4] = 'PLNP'
    !gNam[5] = 'MLNP'
    !gNam[6] = 'OBPN'
    !gNam[7] = 'OLPEN'
  else
    !gNam[1] = 'NLPN'
  endif
  !gNam.append('FPEN')

  if( !this.type.eq('ANNOTE') ) then
    !gNam.append('TPEN')
  endif
  !this.gadgetGroups = !gNam

  -- Test location
  !testString = 'ACSTYL DCSTYL'
  !ceType = !!ce.type.upCase()
  if (!ceType.eq('RPLB')) then
    !this.form.rplbRefe = !!ce
  elseif (!testString.match(!ceType).neq(0)) then
    !this.form.rplbRefe = !!ce.owner
  endif

  -- Set ce
  !this.form.rplb.val = !this.form.rplbRefe.flnm

  -- Get all styles for current library
  if (!this.type.eq('DESIGN')) then
    !dbType = 'DCSTYL'
  else
    !dbType = 'ACSTYL'
  endif
  VAR !allStyle COLL ALL $!dbType FOR $!<this.form.rplbRefe>
  !this.form.allStyle = !allStyle
  if( !fullInit ) then
    !!draColStyle.onInit()
    do !root values !gNam
      !!draColStyle.updateGadgets(!root, !dbType)
    enddo
    !!draColStyle.loadUserStyles()
  endif

  -- Get display for owned styles
  !this.stylDisplay()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getStyleAtt()
--
-- Description: Read the style attributes and set the form gadgets as appropriate
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .getStyleAtt()

  -- Initialise variables
  !sel = !this.form.styles.selection()
  if (!sel.eq('NONE')) then
    return
  endif
  !stylRefe = !sel.dbref()

  do !root values !this.gadgetGroups
    !res = !!draColStyle.getAttributeValues(!root, !stylRefe)
    !status = !res[1]
    if( !status.gt(0) ) then
      !!draColStyle.setColour(!root, !res[2])
      if( !status.eq(2) ) then
        !!draColStyle.setStyle(!root, !res[3])
      endif
    endif
  enddo

  -- For Annotation
  if (!this.form.formType.eq('ANNOTE')) then

    -- Initialise variables
    !memory = REF
    $!stylRefe
    $M "%PDMSUI%/dra/gen/IFONTS" FONT
    $!memory

    -- Underline
    !this.form.underOnOff.active = true
    !this.form.underOnOff.val = !stylRefe.underline

    -- Brackets
    !this.form.brackets.active = true
    !this.form.brackets.select('RTEXT',!stylRefe.brackets.upCase())

  endif

endmethod
-- End of method definition for .getStyleAtt()

------------------------------------------------------------------------
--
-- Method:      .selNew()
--
-- Description: Re-initialise the form for the selected style
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .selNew()

  -- Get all styles for current library
  if (!this.type.eq('DESIGN')) then
    !dbType = 'DCSTYL'
  else
    !dbType = 'ACSTYL'
  endif
  VAR !allStyle COLL ALL $!dbType FOR $!<this.form.rplbRefe>
  !form = !this.form
  !diff = !allStyle.difference(!form.allStyle)
  !wasEmpty = !form.allStyle.empty()
  !form.allStyle = !allStyle
  !form.styles.dText = !!draDispStyle(!allStyle, !form.stymode.selection('RTEXT'), false)
  if( !wasEmpty ) then
    do !root values !this.gadgetGroups
      !this.form.fr$!root$n.active = true
    enddo
  endif
  !form.styles.rText = !form.allStyle
  !form.styles.select('RText', !diff[1])
  !this.getStyleAtt()
  !!draColStyle.clearFormName()

endmethod
-- End of method definition for .selNew()

------------------------------------------------------------------------
--
-- Method:      .stylDisplay()
--
-- Description: Call function !!draDispStyle to determine style description
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .stylDisplay()

  !form = !this.form
  -- Initialise variables
  !currSel = !form.styles.selection()

  -- Get display string for the current selected style & populate list gadget
  if (!form.allStyle.empty()) then

    -- Set display for none
    !dText[1] = 'None'
    !rText[1] = 'NONE'
    !form.styles.dText = !dText
    !form.styles.rText = !rText

    -- Unset all attribute gadgets
    !this.unsetAtt()

    -- Done
    return

  else
    !form.styles.dText = !!draDispStyle(!form.allStyle, !form.stymode.selection('RTEXT'), false)
    !form.styles.rText = !form.allStyle
  endif

  -- Return to style originally selected
  if (!form.styles.rText.findFirst(!currSel).set()) then
    !form.styles.select('RTEXT',!currSel)
  -- Get attributes
  else
    !this.getStyleAtt()
  endif

endmethod
-- End of method definition for .stylDisplay()

------------------------------------------------------------------------
--
-- Method:      .unsetAtt()
--
-- Description: Unset gadgets
--
-- Function Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
-- Define method
define method .unsetAtt()

  do !root values !this.gadgetGroups
    !!draColStyle.setColour(!root, -3)  $* UNCHANGED
    if( !root.neq('TPEN') ) then
      !!draColStyle.setStyle(!root, 'UNCHANGED')
    endif
    !this.form.fr$!root$n.active = false
  enddo

  -- For Annotation
  if (!this.form.formType.eq('ANNOTE')) then
    !dText[1] = 'UNCHANGED'
    !font = !this.form.font
    !font.dText = !dText
    !font.select('DText', 'UNCHANGED')
    -- !!draColStyle.setColour('TPEN', -3) $* UNCHANGED
    !this.form.underOnOff.val = false
    !this.form.brackets.val = 1
    !this.form.frTPEN.active = false

  endif

endmethod
-- End of method definition for .unsetAtt()
