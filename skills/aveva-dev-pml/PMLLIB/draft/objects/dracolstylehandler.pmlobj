------------------------------------------------------------------------
--
-- Method:      getSpecialValues09
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : CHPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues09(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( match('/LDIM/ADIM/DPOI/DPPT/RDIM/PDIM/APPT/ADIR/DPBA/', '/$!type/') gt 0 ) then
    !colours.append('-2')
    !styles.append('-1')
    !styles.append('-2')
  elseif( !type.neq('ACSTYL') ) then
    !styles.append('-1')
  endif
endmethod
-- End of method definition for .getSpecialValues09(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues10
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : RPEN, CPEN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues10(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.neq('ACSTYL') ) then
    !styles.append('-1')
    if( !type.eq('TABL') ) then
      !colours.append('-2')
      !styles.append('-2')
    endif
  endif
endmethod
-- End of method definition for .getSpecialValues10(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues11
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : FFPN, BFPN, CLPN, OBPN, PLNP, MLNP, OLPEN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues11(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.neq('ACSTYL') ) then
    !styles.append('-1')
    if( !type.eq('DCSTYL') ) then
      !colours.append('-3')
      !styles.append('-3')
    endif
  else
    !colours.append('-3')
    !styles.append('-3')
  endif
endmethod
-- End of method definition for .getSpecialValues11(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues
--
-- Description: Main method determining the 'special' values for colours and styles
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING The root name of the gadget
--   2  R  STRING Type of the DB element, for which the attributes are determined
--   3 R/W ARRAY  The array of colour values
--   4 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues(!root is STRING, !type is STRING, !colours is ARRAY, !styles is ARRAY)
  !rootInd = !this.rootNames.match('/$!root/')
  if( !rootInd.eq(0) ) then
    return
  endif
  !suffix = !this.specialRoutine.subString(2 * (!rootInd + 4) / 5 - 1, 2)
  !this.getSpecialValues$!suffix(!type, !colours, !styles)
endmethod
-- End of method definition for .getSpecialValues(STRING,STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      csClose
--
-- Description: Attempts to hide the Colour Selector gadget, if defined
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .csClose()
  if( defined(!!draftColourSelector) ) then
    !!draftColourSelector.hide()
  endif
endmethod
-- End of method definition for .csClose()
