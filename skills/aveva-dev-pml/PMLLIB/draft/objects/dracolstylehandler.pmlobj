------------------------------------------------------------------------
define method .getSpecialValues08(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( match('/LDIM/ADIM/DPOI/DPPT/RDIM/PDIM/APPT/ADIR/DPBA/', '/$!type/') gt 0 ) then
    !colours.append('-2')
    !styles.append('-2')
  endif
endmethod
