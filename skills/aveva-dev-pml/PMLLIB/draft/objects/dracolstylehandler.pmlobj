------------------------------------------------------------------------
define method .getSpecialValues06(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type inset('GLAB', 'SLAB') ) then
    !colours.append('-2')
    !styles.append('-2')
  endif
endmethod
-- End of method definition for .getSpecialValues06(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues07
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : LFPN, LLPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues07(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.eq('GLAB') ) then
    !colours.append('-2')
    !styles.append('-2')
  elseif( !type.eq('SLAB') ) then
    !colours.append('-2')
    !colours.append('-4')
    !styles.append('-2')
    !styles.append('-4')
  elseif( !type.eq('LAYE') ) then
    !colours.append('-4')
    !styles.append('-4')
  endif
endmethod
-- End of method definition for .getSpecialValues07(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues08
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : DLPN, PLPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
