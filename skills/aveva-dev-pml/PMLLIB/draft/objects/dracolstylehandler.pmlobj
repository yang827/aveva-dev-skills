--   Type:          Object Definition
--   Group:         draft
--     Keyword:     Colour and style
--   Module:        DRAFT
--
-- Author:          Tomasz Lisowski
-- Created:         16/04/2007
--
-- Description: The object handles data for colour and style manipulation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbActiveState(FORM,STRING)       -                   Handler for the Style control active state
--  cbActiveState(STRING)            -                   Handler for the Style control active state (current form)
--  cbColourSelector(ARRAY)          -                   Handler for the Colour Selector invoked by the PICK button
--  cbPick(STRING)                   -                   Handler for the PICK button
--  cbSelectUDStyle(STRING)          -
--  cbStyleSetDbref(STRING,REAL,REAL) -                   Called by !!draUserDefStyle form, when a style is selected to store
--  cbStyleToggle(STRING)            -                   Callback routine for the system/user-defined style toggle
--  cbStyleToggleReturn(FORM,STRING,STRING) -                   Routine called by !!draUserDefStyle form, when a style is selected
--  clearFormName()                  -                   Clears the explicitly given form name
--  colourName(REAL)                 STRING              Returns the display name of the colour
--  csClose()                        -                   Attempts to hide the Colour Selector gadget, if defined
--  draColStyleHandler()             -                   Default constructor creating pre-computed data for later use
--  familyDescription(STRING)        STRING              Returns the textual description of the gadget family
--  getAttributeValues(STRING,DBREF) ARRAY               Reads the colour and style attribute values from the given DB reference
--  getData(STRING)                  ARRAY               Returns an array of results from the colour/style gadget group
--  getSpecialValues(STRING,STRING,ARRAY,ARRAY) -                   Main method determining the 'special' values for colours and styles
--  getSpecialValues01(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues02(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues03(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues04(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues05(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues06(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues07(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues08(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues09(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues10(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  getSpecialValues11(STRING,ARRAY,ARRAY) -                   Determines the 'special' values for colours and styles
--  globalInstance()                 -                   Creates a global instance of this object for use in forms
--  loadUserStyles()                 -                   Loads the user-defined styles from the database
--  locateStyle(ARRAY,STRING)        ARRAY               Routine for locating the given style description in a set of the loaded user-defined styles
--  onInit()                         -                   Performs the initial activities, before setting up the gadgets on the form to be shown
--  reset(STRING)                    -                   Resets the active state of the gadgets, according to the current setting of the <root>UD toggle
--  selectColour(GADGET,GADGET,REAL) -                   Selects the colour from the palette in the OPTION gadget
--  setAttributeValues(STRING,ARRAY) -                   Sets the given colour and style attribute values to the current element
--  setColour(STRING,REAL)           -                   Routine for setting the gadget to a given colour
--  setColour(STRING,STRING)         -                   Dummy routine warning the user, if a STRING colour value is used
--  setFormName(STRING)              -                   Sets the form name explicitly (stores it without the _ or !! prefixes)
--  setStyle(STRING,REAL)            -                   Routine for setting the gadgets to a given USER-DEFINED style (a REAL)
--  setStyle(STRING,STRING)          -                   Routine for setting the gadgets to a given SYSTEM or SPECIAL style (a STRING)
--  setStyleToggle(FORM,STRING,BOOLEAN) -                   Sets the state of the style toggle (on the given form), and updates the active status of the related gadgets
--  setStyleToggle(STRING,BOOLEAN)   -                   Sets the state of the style toggle, and updates the active status of the related gadgets
--  setup(STRING,REAL,STRING)        -                   Creates a frame at x0 in the current form with the colour/style gadget group
--  setup(STRING,REAL,STRING,STRING) -                   Creates a frame in the current form with the colour/style gadget group
--  setup(STRING,STRING)             -                   Creates the colour/style gadget group in the current form using the options provided
--  styleFamily(STRING)              STRING              Determines the family of styles, depending on the gadget root name
--  styleName(GADGET,GADGET,STRING)  STRING              Returns the style name for the given style and thickness gadgets
--  udStyleByNo(STRING,REAL)         ARRAY               Returns the user-defined style table and style numbers for the given Style Number
--  udStyleData2Description(STRING)  ARRAY               For the given user-defined style data presents a style description and tooltip to be shown to the user
--  udStyleDescription2ID(STRING)    STRING              For the given user-defined style description returns the corresponding style ID
--  updateColourArrays(REAL)         -                   Update the defColDText and defColRText arrays with the given colour
--  updateColours(GADGET,ARRAY)      -                   Updates the 'special' colours in the pixmap OPTION gadget
--  updateGadgets(STRING)            -                   Updates the colour and style gadgets in the group
--  updateGadgets(STRING,STRING)     -                   Updates the colour and style gadgets in the group for the given DB type
--  updateSample(GADGET,GADGET)      -                   Updates the 'sample' paragraph to reflect the colour change
--  updateStyles(GADGET,ARRAY,STRING) -                   Updates the 'special' styles in the pixmap OPTION gadget
--
import 'DrawListAddin'
handle (1000,0)
endhandle

define object DRACOLSTYLEHANDLER
  member .specialStyPNG is ARRAY    $* PNG file paths for special styles: Off, Default, Unchanged, Template
  member .specialNames is ARRAY     $* special names: OFF, DEFAULT, UNCHANGED, TEMPLATE

  member .sysLStylePNG is ARRAY     $* PNG file paths for system LINEAR styles: 0 to 9 (PDMS), 10 - 13 (Tribon)
  member .sysLStyleName is ARRAY    $* system LINEAR style names, as defined by the syntax graphs
  member .sysLStyleData is ARRAY    $* corresponding LINEAR style group/thickness settings for the gadgets
  member .sysLStyleGrpName is ARRAY $* system LINEAR style group names
  member .sysLStyleThPNG is ARRAY   $* PNG file paths for system LINEAR style thicknesses
  member .sysLStyleTh is ARRAY      $* LINEAR style thicknesses (strings)

  member .sysFStylePNG is ARRAY     $* PNG file paths for system FILL styles
  member .sysFStyleName is ARRAY    $* system FILL style names, as defined by the syntax graphs
  member .nFillStyles is REAL       $* number of system fill styles

  member .sysMStyleName is ARRAY    $* system MARKER style names, as defined by the syntax graph (without scale factor)

  member .lStyTB is ARRAY           $* Linear style tables (user-defined)
  member .lStyleRefs is ARRAY       $* 2d array of dbrefs of the linear styles in each style table held in the array .lStyTB
  member .lStyleNos  is ARRAY       $* 2d array of style numbers of the linear styles in .lStyleRefs
  member .lStyle is ARRAY           $* Linear style information (user-defined)
  member .lStyleLocate is ARRAY     $* Modified linear style information for locateStyle
  member .lStyRef is DBREF          $* The dbref of the selected line style

  member .fStyTB is ARRAY           $* Fill style tables (user-defined)
  member .fStyleRefs is ARRAY       $* 2d array of dbrefs of the fill styles in each style table held in the array .fStyTB
  member .fStyleNos  is ARRAY       $* 2d array of style numbers of the fill styles in .fStyleRefs
  member .fStyle is ARRAY           $* Fill style information (user-defined)
  member .fStyleLocate is ARRAY     $* Modified linear style information for locateStyle
  member .fStyRef is DBREF          $* The dbref of the selected fill style

  member .mStyTB is ARRAY           $* Marker style tables (user-defined)
  member .mStyleRefs is ARRAY       $* 2d array of dbrefs of the marker styles in each style table held in the array .mStyTB
  member .mStyleNos  is ARRAY       $* 2d array of style numbers of the marker styles in .mStyleRefs
  member .mStyle is ARRAY           $* Marker style information (user-defined)
  member .mStyleLocate is ARRAY     $* Modified marker style information for locateStyle
  member .mStyRef is DBREF          $* The dbref of the selected marker style

  member .styleLoaded is ARRAY      $* array[3] of BOOLEAN
  -- [1] - L, [2] - F, [3] - M. True, if the given kind of the user-defined style information
  -- has been already loaded or needs not be loaded

  -- default lists displayed in gadgets
  member .defColDText is ARRAY      $* Default colours (displayed)
  member .defColRText is ARRAY      $* Default colours (values as STRING)
  member .initialColours is REAL    $* Number of colours 1..N shown initially

  member .rootNames is STRING       $* String of allowed root names
  member .attrNames is ARRAY        $* array of colour and style attribute names in the order as in .rootNames

  member .formName is STRING        $* explicit form name (workaround of a bug when the form looses focus)

  member .csHandler is REAL         $* handler ID for ColourSelector form
  member .csForm is STRING          $* form to use in a ColourSelector callback
  member .csRoot is STRING          $* Root name to use in a ColourSelector callback

  member .specialRoutine is STRING  $* suffix for the getSpecialValuesXX methods
endobject

------------------------------------------------------------------------
--
-- Method:      draColStyleHandler
--
-- Description: Default constructor creating pre-computed data for later use
--
-- Method Type: Constructor
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draColStyleHandler()

  -- Special values for colours and styles
  !this.specialNames[1] = 'OFF'
  !this.specialNames[2] = 'DEFAULT'
  !this.specialNames[3] = 'UNCHANGED'
  !this.specialNames[4] = 'TEMPLATE'
  !this.specialStyPNG[1] = !!pml.getPathName('styoff.png')
  !this.specialStyPNG[2] = !!pml.getPathName('stydefault.png')
  !this.specialStyPNG[3] = !!pml.getPathName('styunchanged.png')
  !this.specialStyPNG[4] = !!pml.getPathName('stytemplate.png')

  -- *********** LINEAR STYLES SETUP ***********

  -- 10 PDMS styles + 5 Tribon style - Solid, which is common = 14 styles
  -- icons sty0.png .. sty9.png - PDMS
  -- icons sty10.png .. sty13.png - Tribon except Solid
  do !ind from 0 to 13
    !this.sysLStylePNG[!ind + 1] = !!pml.getPathName('sty' & !ind & '.png')
  enddo

  -- Line thicknesses - assuming, that the icons are found
  !this.sysLStyleTh[1] = ''
  !this.sysLStyleTh[2] = 'MEDIUM'
  !this.sysLStyleTh[3] = 'THICK'
  !this.sysLStyleThPNG[1] = !!pml.getPathName('stythin.png')
  !this.sysLStyleThPNG[2] = !!pml.getPathName('stymedium.png')
  !this.sysLStyleThPNG[3] = !!pml.getPathName('stythick.png')

  -- Create the full set of LINEAR style names, as supported by the syntax
  !s = 'SOLID SOLIDMEDIUM SOLIDTHICK DASHED DASHEDMEDIUM DASHEDTHICK DOTTED DOTTEDMEDIUM DOTTEDTHICK ' & $
       'CHAINED CHAINEDMEDIUM CHAINEDTHICK LDASHED LDASHEDMEDIUM LDASHEDTHICK DDASHED DDASHEDMEDIUM DDASHEDTHICK ' & $
       'DDOTTED DDOTTEDMEDIUM DDOTTEDTHICK FDOTTED FDOTTEDMEDIUM FDOTTEDTHICK DCHAINED DCHAINEDMEDIUM DCHAINEDTHICK ' & $
       'TCHAINED TCHAINEDMEDIUM TCHAINEDTHICK DASHPATTERN DASHWIDE DASHXWIDE DASHDOT DASHDOTWIDE DASHDOTXWIDE ' & $
       'DASHDOUBLEDOT DASHDOUBLEDOTWIDE DASHDOUBLEDOTXWIDE SHORTDASH SHORTDASHWIDE SHORTDASHXWIDE'
  !this.sysLStyleName = !s.split()

  -- Create the corresponding LINEAR style/thickness values for the gadgets
  !this.sysLStyleData = ARRAY()
  !s = 'SOLID DASHED DOTTED CHAINED LDASHED DDASHED DDOTTED FDOTTED DCHAINED TCHAINED *DASH *DASHDOT *DASHDOUBLEDOT *SHORTDASH'
  !this.sysLStyleGrpName = !s.split()
  do !styleGroup values !this.sysLStyleGrpName
    !tab[1] = !styleGroup & '/'
    !tab[2] = !styleGroup & '/MEDIUM'
    !tab[3] = !styleGroup & '/THICK'
    !this.sysLStyleData.appendArray(!tab)
  enddo

  -- Initialise the user-defined style information arrays
  !this.lStyTB = ARRAY()
  !this.lStyle = ARRAY()
  !this.lStyleLocate = ARRAY()

  -- *********** FILL STYLES SETUP ***********

  -- fill styles
  !this.nFillStyles = 30
  !this.sysFStylePNG = ARRAY()
  -- 18 (to be extended to 20) system styles + Solid (fsty0.png)
  !this.sysFStylePNG[1]  = !!pml.getPathName('fsty0.png')
  !this.sysFStyleName[1] = 'SOLIDFILLED'
  do !ind from 1 to !this.nFillStyles
    !this.sysFStylePNG[!ind + 1]  = !!pml.getPathName('fsty' & !ind & '.png')
    !this.sysFStyleName[!ind + 1] = 'SYSTEMSTYLE ' & !ind
  enddo

  -- Initialise the user-defined style information arrays
  !this.fStyTB = ARRAY()
  !this.fStyle = ARRAY()
  !this.fStyleLocate = ARRAY()

  -- *********** MARKER STYLES SETUP ***********

  -- Initialise the array for the MARKER style names
  !s = 'STOP CROSS PLUS STAR RING'
  !this.sysMStyleName = !s.split()

  !this.mStyTB = ARRAY()
  !this.mStyle = ARRAY()
  !this.mStyleLocate = ARRAY()

  -- *********** COLOUR SETUP ***********

  -- setup default lists (DText / RText) to be shown in the OPTION gadgets
  !this.initialColours = 16

  -- establish default colours to show
  !this.defColDText = ARRAY()
  !this.defColRText = ARRAY()
  $(
  P-30249 MOVED to OnInit as the name of COLOUR n can be changed, see appdrasetbackground
  do !ind from 1 to !this.initialColours
    var !cName colour $!ind
    -- colours in the lower range ARE named
    !this.defColDText.append(!ind & ': ' & !cName)
    !this.defColRText.append(!ind.string())
  enddo
  $)
  -- *********** MISCELLANEOUS SETUP ***********

  -- Making sure, that the form used internally, are loaded
  if( not defined(!!draUserDefStyle) ) then
    pml load form !!draUserDefStyle
    handle ANY
    endhandle
  endif
  -- Set the user-defined style information loading flag
  !this.styleLoaded[1] = true
  !this.styleLoaded[2] = true
  !this.styleLoaded[3] = true

  -- IMPORTANT! OLPEN, which has 5 characters, must be the last element. The order of elements is significant,
  -- as the code uses .between method on the element index to validate certain group of elements.
  !this.rootNames = '/TPEN/DTPN/PTPN/FPEN/MPEN/NLPN/LLPN/LFPN/DLPN/PLPN/CHPN/RPEN/CPEN/FFPN/BFPN/CLPN/OBPN/PLNP/MLNP/OLPEN/PIPN/'

  -- IMPORTANT! This attribute triples in this list must be in the same order, as .rootNames
  !s = 'TXCONU/TXCOLO//DTCONU/DTCOLO//PTCONU/PTCOLO//FCONUM/FCOLOU/FSTYLE/MCONUM/MCOLOU/MSTYLE/' & $
       'NLCONU/NLCOLO/NLSTYL/LLCONU/LLCOLO/LLSTYL/LFCONU/LFCOLO/LFSTYL/DLCONU/DLCOLO/DLSTYL/PLCONU/PLCOLO/PLSTYL/' & $
       'CHCONU/CHCOLO/CHSTYL/ROWCON/ROWCOL/ROWSTY/COLCON/COLCOL/COLSTY/FFCONU/FFCOLO/FFSTYL/BFCONU/BFCOLO/BFSTYL/' & $
       'CLCONU/CLCOLO/CLSTYL/OBCONU/OBCOLO/OBSTYL/PLNCON/PLNCOL/PLNSTY/MLNCON/MLNCOL/MLNSTY/OLCONU/OLCOLO/OLSTYL'
  !this.attrNames = !s.split('/')
  !this.formName = ''
  !this.csRoot = ''
  -- Suffixes for the getSpecialValuesXX routines for consecutive root names
-- P-35364: LLPN now has 07 (as LFPN), so 06 no longer used
  !this.specialRoutine = '010202030405070708080910101111111111111111'

endmethod
-- End of method definition for .draColStyleHandler()

------------------------------------------------------------------------
--
-- Method:      colourName
--
-- Description: Returns the display name of the colour
--
-- Method Type: Function
-- Arguments:
--   1  REAL  The colour value (real, non-special colour)
-- Return:
--   STRING  The display name of the colour
--
------------------------------------------------------------------------
define method .colourName(!colour is REAL) is STRING
  var !s colour $!colour
  if( !s.match('Mix').eq(1) ) then
    !parts = !s.split()
    !s = '$!colour: RGB $!parts[3] $!parts[5] $!parts[7]'
  else
    !s = !colour & ': ' & !s
  endif
  return !s
endmethod
-- End of method definition for .colourName(REAL)

------------------------------------------------------------------------
--
-- Method:      getAttributeValues
--
-- Description: Reads the colour and style attribute values from the given DB reference
--
-- Status values:
--    1 - success, only colour returned
--    2 - success, colour and style returned
--   -1 - failure, invalid gadget group name
--   -2 - failure, colour attribute not found in the DB element
--   -3 - failure, style attribute not found in the DB element
--
-- Method Type: Function
-- Arguments:
--   1  STRING  The gadget group name
--   2  DBREF   The DB reference of the element, for which the attributes should be read
-- Return:
--   ARRAY  3-element array: [1] - status, [2] - colour attribute value, [3] - style attribute value
--
------------------------------------------------------------------------
define method .getAttributeValues(!root is STRING, !at is DBREF) is ARRAY
  !ind = !this.rootNames.match('/$!root/')
  if( !ind.eq(0) ) then
    !res[1] = -1
  else
    -- From character indices (1, 6, 11, 16, ...) derive root name indices (1, 2, 3, 4, ...)
    -- Multiplied by 3 to get the index in the attrNames array
    !ind = ((!ind + 4) / 5) * 3
    !colAttr = !this.attrNames[!ind - 2] $* ...CONUMBER attribute
    !styleAttr = !this.attrNames[!ind]   $* ...STYLE attribute
    !res[2] = !at.attribute(!colAttr)
    handle ANY
      !res[1] = -2
    elsehandle None
      if( !styleAttr.empty() ) then
        !res[1] = 1
      else
        !res[3] = !at.attribute(!styleAttr)
        handle ANY
          !res[1] = -3
        elsehandle None
          !res[1] = 2
        endhandle
      endif
    endhandle
  endif
  return !res
endmethod
-- End of method definition for .getAttributeValues(STRING,DBREF)

------------------------------------------------------------------------
--
-- Method:      setAttributeValues
--
-- Description: Sets the given colour and style attribute values to the current element
--
-- Method Type: Procedure
-- Arguments:
--   1  STRING  The gadget group name
--   2  ARRAY   1 or 2 element array containing the values to be set (colour, style)
-- Return:
--
------------------------------------------------------------------------
define method .setAttributeValues(!root is STRING, !attributeValues is ARRAY)
  !ind = !this.rootNames.match('/$!root/')
  if( !ind.eq(0) ) then
    return
  endif
  -- From character indices (1, 6, 11, 16, ...) derive root name indices (1, 2, 3, 4, ...)
  -- Multiplied by 3 to get the index in the attrNames array
  !ind = ((!ind + 4) / 5) * 3
  !colAttr = !this.attrNames[!ind - 1] $* ...COLOUR attribute
  $!colAttr $!attributeValues[1]
  handle ANY
    !type = TYPE
    !name = NAME
    !!alert.error('Error setting the $!colAttr attribute to the $!type $!name')
    return
  endhandle

  !styleAttr = !this.attrNames[!ind]   $* ...STYLE attribute
  if( not !styleAttr.empty() ) then
    $!styleAttr $!attributeValues[2]
    handle ANY
      !type = TYPE
      !name = NAME
      !!alert.error('Error setting the $!styleAttr attribute to the $!type $!name')
    endhandle
  endif
endmethod
-- End of method definition for .setAttributeValues(STRING,ARRAY)

------------------------------------------------------------------------
--
-- Method:      setFormName()
--
-- Description: Sets the form name explicitly (stores it without the _ or !! prefixes)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING  The form name
-- Return:
--
------------------------------------------------------------------------
define method .setFormName(!formName is STRING)
  if( !formName.empty() ) then
    !this.formName = ''
  elseif( !formName.subString(1,1).eq('_') ) then
    !this.formName = !formName.subString(2)
  elseif( !formName.subString(1,2).eq('!!') ) then
    !this.formName = !formName.subString(3)
  else
    !this.formName = !formName
  endif
endmethod
-- End of method definition for .setFormName(STRING)

------------------------------------------------------------------------
--
-- Method:      clearFormName()
--
-- Description: Clears the explicitly given form name
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .clearFormName()
  !this.formName = ''
endmethod
-- End of method definition for .clearFormName()

------------------------------------------------------------------------
--
-- Method:      globalInstance()
--
-- Description: Creates a global instance of this object for use in forms
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .globalInstance()
  !!draColStyle = !this
endmethod
-- End of method definition for .globalInstance()

$(
Relation between the gadget group ROOT names and the corresponding attributes

Description             | ROOT name | Family  |Colour attr | Colour number attr| Style attr
------------------------|-----------|---------|------------|-------------------|---------------
Leader-line pen         | LLPN      | L       | LLCOLO/ur  | LLCONU/mber       | LLSTYL/e
Label-frame pen         | LFPN      | L       | LFCOLO/ur  | LFCONU/mber       | LFSTYL/e
Dimension-line pen      | DLPN      | L       | DLCOLO/ur  | DLCONU/mber       | DLSTYL/e
Projection-line pen     | PLPN      | L       | PLCOLO/ur  | PLCONU/mber       | PLSTYL/e
Cross-hair pen          | CHPN      | L       | CHCOLO/ur  | CHCONU/mber       | CHSTYL/e
Note line pen           | NLPN      | L       | NLCOLO/ur  | NLCONU/mber       | NLSTYL/e
Table-row pen           | RPEN      | L       | ROWCOL/our | ROWCON/umber      | ROWSTY/le
Table-column pen        | CPEN      | L       | COLCOL/our | COLCON/umber      | COLSTY/le
Front-face pen          | FFPN      | L       | FFCOLO/ur  | FFCONU/mber       | FFSTYL/e
Back-face pen           | BFPN      | L       | BFCOLO/ur  | BFCONU/mber       | BFSTY/e
Centre-line pen         | CLPN      | L       | CLCOLO/ur  | CLCONU/mber       | CLSTYL/e
Obscured-line pen       | OBPN      | L       | OBCOLO/ur  | OBCONU/mber       | OBSTYL/e
P-line pen              | PLNP      | L       | PLNCOL/our | PLNCON/umber      | PLNSTY/le
Member-line pen         | MLNP      | L       | MLNCOL/our | MLNCON/umber      | MLNSTY/le
Outline pen             | OLPEN     | L       | OLCOLO/ur  | OLCONU/mber       | OLSTYL/e
------------------------|-----------|---------|------------|-------------------|---------------
(General) Text pen      | TPEN      | (empty) | TXCOLO/ur  | TXCONU/mber       | ---
Dimension-line text pen | DTPN      | (empty) | DTCOLO/ur  | DTCONU/mber       | ---
Projection-line text pen| PTPN      | (empty) | PTCOLO/ur  | PTCONU/mber       | ---
------------------------|-----------|---------|------------|-------------------|---------------
Fill pen                | FPEN      | F       | FCOLOU/r   | FCONUM/ber        | FSTYLE
------------------------|-----------|---------|------------|-------------------|---------------
Marker pen              | MPEN      | M       | MCOLOU/r   | MCONUM/ber        | MSTYLE
-----------------------------------------------------------------------------------------------
$)

------------------------------------------------------------------------
--
-- Method:      styleFamily
--
-- Description: Determines the family of styles, depending on the gadget root name
--
-- Method Type: Function
-- Arguments:
--   1 R STRING The gadget root name
-- Return:
--   STRING   L - Linear style, F - Fill style, M - marker style, (empty) - no style
------------------------------------------------------------------------
define method .styleFamily(!root is STRING) is STRING
  -- /TPEN/DTPN/PTPN/FPEN/MPEN/NLPN ...
  -- 123456789012345678901234567890 ...
  !ind = !this.rootNames.match('/$!root/')
  if( !ind.eq(16) ) then $* FPEN
    return 'F'
  elseif( !ind.eq(21) ) then $* MPEN
    return 'M'
  elseif( !ind.eq(102) ) then
  	-- Pipe and Insulation PIPN
    return 'L'
  elseif( !ind.geq(26) ) then $* Family L starts at index 26 (NLPN)
    return 'L'
  else
    return ''
  endif
endmethod
-- End of method definition for .styleFamily(STRING)

------------------------------------------------------------------------
--
-- Method:      familyDescription
--
-- Description: Returns the textual description of the gadget family
--
-- Method Type: Function
-- Arguments:
--   1 R STRING family code
-- Return:
--   STRING Family description
--
------------------------------------------------------------------------
define method .familyDescription(!family is STRING) is STRING
  if( !family.eq('L') ) then
    !res = 'Linear'
  elseif( !family.eq('F') ) then
    !res = 'Fill'
  elseif( !family.eq('M') ) then
    !res = 'Marker'
  elseif( !family.empty() ) then
    !res = 'Text'
  else
    !res = ''
  endif
  return !res
endmethod
-- End of method definition for .familyDescription(STRING)

------------------------------------------------------------------------
--
-- Method:      updateColours
--
-- Description: Updates the 'special' colours in the pixmap OPTION gadget
--
-- Method Type: Procedure
-- Arguments:
--   1 R/W GADGET The pixmap OPTION gadget holding the colours
--   2 R/W  ARRAY Input: The list of codes for allowed 'special' colours
--                Output: The Rtext array of the gadget
-- Return:
--
------------------------------------------------------------------------
define method .updateColours(!option is GADGET, !special is ARRAY)
  if( !special.empty() ) then
    !option.dText = !this.defColDText
    !option.rText = !this.defColRText
  else
    !dText = ARRAY()
    do !codeString values !special
      !ind = -!codeString.real()
      !dText.append('*' & !this.specialNames[!ind] & '*')
    enddo
    !dText.appendArray(!this.defColDText)
    !special.appendArray(!this.defColRText)
    !option.dText = !dText
    !option.rText = !special
  endif
endmethod
-- End of method definition for .updateColours(GADGET,ARRAY)

------------------------------------------------------------------------
--
-- Method:      updateStyles
--
-- Description: Updates the 'special' styles in the pixmap OPTION gadget
-- Avoids updating the list, if not necessary. Will not be called for Text family
--
-- Method Type: Procedure
-- Arguments:
--   1 R/W GADGET The pixmap OPTION gadget holding the styles (style groups)
--   2 R/W ARRAY  The list of codes for allowed 'special' styles
--   3  R  STRING 'L' - linear style 'F' - fill style, 'M' - marker style
-- Return:
--
------------------------------------------------------------------------
define method .updateStyles(!option is GADGET, !special is ARRAY, !family is STRING)
  !dText = ARRAY()
  if( !family.eq('M') ) then
    do !codeString values !special
      !ind = -!codeString.real()
      !dText.append('*' & !this.specialNames[!ind] & '*')
    enddo
  else
    do !codeString values !special
      !ind = -!codeString.real()
      !dText.append(!this.specialStyPNG[!ind])
    enddo
  endif

  -- Build the RText array
  if( !family.eq('L') ) then
    !special.appendArray(!this.sysLStyleGrpName)
  elseif( !family.eq('F') ) then
    !special.appendArray(!this.sysFStyleName)
  elseif( !family.eq('M') ) then
    !special.appendArray(!this.sysMStyleName)
  endif
  -- If different from current, build the DText array and update the gadget
  if( !special.neq(!option.rText) ) then
    if( !family.eq('L') ) then
      !dText.appendArray(!this.sysLStylePNG)
    elseif( !family.eq('F') ) then
      !dText.appendArray(!this.sysFStylePNG)
    else $* M
      !dText.appendArray(!this.sysMStyleName)
    endif
    !option.dText = !dText
    !option.rText = !special
  endif

	-- MAW May 2010: comment this out, it seems unnecessary and was causing the
	--   form to partly forget its previous settings (causing an error when trying to apply
	--   an empty user defined style to CE)
  --!name = !option.fullName().subString(-3) & 'UDS' $* replace last two characters with UDS
  --$!name$n.clear()
  --$!name$n.setToolTip('No user-defined style selected')
endmethod
-- End of method definition for .updateStyles(GADGET,ARRAY,STRING)

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Updates the colour and style gadgets in the group
-- Should be called on INIT, before the form is shown on a new DB element
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The gadget group root name
-- Return:
--
------------------------------------------------------------------------
define method .updateGadgets(!root is STRING)
  !type = TYPE
  !this.updateGadgets(!root, !type)
endmethod
-- End of method definition for .updateGadgets(STRING)

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Updates the colour and style gadgets in the group for the given DB type
-- Should be called on INIT, before the form is shown on a new DB element
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The gadget group root name
--   2 R STRING The DB element type
-- Return:
--
------------------------------------------------------------------------
define method .updateGadgets(!root is STRING, !dbType is STRING)
  !colours = ARRAY()
  !styles = ARRAY()
  !this.getSpecialValues(!root, !dbType, !colours, !styles)
  !family = !this.styleFamily(!root)
  !notText = not !family.empty()
  !fName = !this.formName
  !isEmpty = !fName.empty()
  if( !isEmpty ) then
    !gColour = _$!root
  else
    !gColour = !!$!fName$n.$!root
  endif
  !this.updateColours(!gColour, !colours)
  if( !notText ) then
    if( !isEmpty ) then
      !gStyle = _$!root$nLS
    else
      !gStyle = !!$!fName$n.$!root$nLS
    endif
    !this.updateStyles(!gStyle, !styles, !family)
    if( !family.eq('L') ) then
      !this.styleLoaded[1] = false $* request loading LINEAR user-defined styles
    elseif( !family.eq('F') ) then
      !this.styleLoaded[2] = false $* request loading FILL user-defined styles
    else $* 'M'
      !this.styleLoaded[3] = false $* request loading MARKER user-defined styles
    endif
  endif
endmethod
-- End of method definition for .updateGadgets(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      loadUserStyles
--
-- Description: Loads the user-defined styles from the database
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .loadUserStyles()

  --*********************************
  --Take out MSTYTB
  --UNTIL MARKER STYLES IMPLEMENTED IN CORE
  -- see also code in .setup()
--  !s = 'LSTYTB FSTYTB MSTYTB'
  !s = 'LSTYTB FSTYTB'

  !tab = '	' $* a tab character (DO NOT REPLACE WITH SPACES!)
  if (!tab.Substring(1,1) eq ' ') then
  	write('ERROR in dracolstylehandler.pmlobj: expected tab not spaces')
  endif

  !current = REF
  !types = '( '
  do !ind from 1 to 3
    if( not !this.styleLoaded[!ind] ) then
      !types = !types & !s.part(!ind) & ' '
      -- reset the flag
      !this.styleLoaded[!ind] = true
    endif
  enddo
  -- Return if no style needs to be loaded
  if( !types.trim().eq('(') ) then
    return
  endif

  !types = !types & ')'

  !this.lStyTB.clear()
  !this.lStyleRefs.clear()
  !this.lStyleNos.clear()
  !this.lStyle.clear()
  !this.lStyleLocate.clear()

  !this.fStyTB.clear()
  !this.fStyleRefs.clear()
  !this.fStyleNos.clear()
  !this.fStyle.clear()
  !this.fStyleLocate.clear()

  !this.mStyTB.clear()
  !this.mStyleRefs.clear()
  !this.mStyleNos.clear()
  !this.mStyle.clear()
  !this.mStyleLocate.clear()

  -- Collect all required style tables
  var !styleTableRefs collect all $!types

  do !tableRefStr values !styleTableRefs
    !tableRef = !tableRefStr.dbRef()
    !type = !tableRef.type
    !styInfoLocate = ARRAY()

    if( !type.eq('LSTYTB') ) then
      !styleName = 'LINEST'
      !sNoOK     = true
      !style     = 'l'
    elseif( !type.eq('FSTYTB') ) then
      !styleName = 'FILLST'
      !sNoOK     = true
      !style     = 'f'
    else $* MSTYTB
      !styleName = 'MARKST'
      !sNoOK     = false
      !style     = 'm'
    endif

    -- Collect all styles within the table and read their style numbers
    VAR !styInfo COLLECT ALL $!styleName FOR $!tableRefStr
    VAR !styNumb EVAL $!style$nStyno FOR ALL FROM !styInfo

    !styRefs = ARRAY()

    if( !sNoOK ) then
      do !styInd indices !styInfo
        !ref  = !styInfo[!styInd].dbRef()
        !sNo  = !ref.$!style$nStyNo
        !name = !ref.flnm
        !styRefs[!styInd] = !ref
        !styInfo[!styInd] = !name & !tab & !ref.function & !tab & !sNo
        !styInfoLocate[!styInd] = !sNo & ': ' & !name
      enddo
    else
      do !styInd indices !styInfo
        !ref  = !styInfo[!styInd].dbRef()
        !name = !ref.flnm
        !styRefs[!styInd] = !ref
        !styInfo[!styInd] = !name & !tab & !ref.function & !tab
        !styInfoLocate[!styInd] = & !name
      enddo
    endif

    !this.$!style$nStyTB.append(!tableRef.flnm & !tab & !tableRef.function)
    !this.$!style$nStyleRefs.append(!styRefs)
    !this.$!style$nStyleNos.append(!styNumb)
    !this.$!style$nStyle.append(!styInfo)
    !this.$!style$nStyleLocate.append(!styInfoLocate)

  enddo

  -- Restore the current element
  $!current

endmethod
-- End of method definition for .loadUserStyles()

------------------------------------------------------------------------
--
-- Method:      onInit
--
-- Description: Performs the initial activities, before setting up the gadgets on the form to be shown
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .onInit()
  -- Clear the user-defined style loading flags
  !this.styleLoaded[1] = true
  !this.styleLoaded[2] = true
  !this.styleLoaded[3] = true
  -- make sure, that the form name is not explicitly given when the form is shown,
  -- unless an explicit call to the .setFormName() method is added
  !this.clearFormName()

  -- Moved from constructor as the colours corresponding to numbers can be changed
  -- establish default colours to show
  !this.defColDText.clear()
  !this.defColRText.clear()
  do !ind from 1 to !this.initialColours
    var !cName colour $!ind
    !this.defColDText.append(!ind & ': ' & !cName)
    !this.defColRText.append(!ind.string())
  enddo
endmethod
-- End of method definition for .onInit()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Creates the colour/style gadget group in the current form using the options provided
-- <root>       - textual OPTION gadget handling the colour selection
-- <root>SA     - PARAGRAPH gadget showing the selected colour
-- <root>PICK   - BUTTON gadget showing the colour picker
-- if the gadget family allows style gadgets:
-- <root>LS     - pixmap OPTION gadget handling the system linear style groups (L), fill styles (F) or marker styles (M - textual)
-- <root>TH     - OPTION gadget handling the system style thicknesses (not for FILL styles!) or marker scale factors
-- <root>SEL    - BUTTON gadget allowing the selection of the user-defined style
-- <root>UD     - TOGGLE gadget, indicating whether the user-defined style is requested
-- <root>UDS    - PARAGRAPH gadget, holding the name of the selected user-defined style
--
-- nRows holds the layout information:
--  1  - one row of gadgets (style FOLLOWS colour). If there is no <root>TH gadget, there is a space
--       between <root>LS and <root>UD, so that <root>UD is vertically aligned in consecutive frames
--  2  - two rows of gadgets (style BELOW colour). If there is no <root>TH gadget, there is a space
--       between <root>LS and <root>UD, so that <root>UD is vertically aligned in consecutive frames
--  11 - one row of gadgets (as for 1). The <root>TH gadget follows directly the previous gadget (no space!)
--  12 - two rows of gadgets (as for 2). The <root>TH gadget follows directly the previous gadget (no space!)
--  3  - three rows of gadget (Colour, System style, user-defined style)
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group (see comments for .getSpecialValues)
--   2 R STRING The \-separated string of settings (KEY=VALUE)
-- Return:
--
------------------------------------------------------------------------
define method .setup(!root is STRING, !options is STRING)
  -- defaults
  !frameAt = ''
  !nRows = 1
  !firstAt = ''
  !tagWidth = 5
  !frameTitle = ''

  -- read the options, and update the settings
  !defs = !options.split('\')
  do !def values !defs
    !ind = !def.match('=')
    skip if( !ind.eq(0) )
    !key = !def.subString(1, !ind - 1)
    !value = !def.subString(!ind + 1)
    if( !key.eq('FRAMEAT') ) then
      !frameAt = !value
    elseif( !key.eq('NROWS') ) then
      !nRows = !value.real()
      handle ANY
      endhandle
    elseif( !key.eq('FIRSTAT') ) then
      !firstAt = !value
    elseif( !key.eq('TAGWIDTH') ) then
      !tagWidth =!value.real()
      handle ANY
      endhandle
    elseif( !key.eq('FRAMETITLE') ) then
      !frameTitle = !value
    endif
  enddo

  -- set up the gadgets
  !isFrame = !frameTitle.neq('')
  -- start the frame if requested
  if( !isFrame ) then
    path down
    frame .fr$!root |$!frameTitle| $!frameAt
  endif

  -- build the body - Colour gadgets
  hdist 0.5
  option .$!root $!firstAt |Colour:| tagwidth $!tagWidth callback |!!draColStyle.updateSample(_$!root, _$!root$nSA)| width 13 $
    tooltip |Pick a colour from the list|
  !g = _$!root
  !g.dText = !this.defColDText
  !g.rText = !this.defColRText

  path right
  paragraph .$!root$nSA text | | width 4 lines 1
  button    .$!root$nPICK |Pick| width 4 callback |!!draColStyle.cbPick('$!root')| $
    tooltip |Pick a colour from the palette|

  !stFamily = !this.styleFamily(!root)
  -- Check, if style gadgets are to be set
  if( not !stFamily.empty() ) then
    !udAlign = !nRows.lt(10)
    if( !udAlign ) then
      !nR = !nRows
    else
      !nR = !nRows - 10
    endif
    -- Determine the tag width and position of the system style gadget <root>LS
    if( !nR.eq(1) ) then
      !lsAT = '4 at xmax+1'
    else
      !lsAT = '5 at xmin_$!root ymax+0.2'
    endif

    -- Add the System Style gadgets
    !selPos = '12.5'                 $* offset of the <root>SEL BUTTON gadget from <root>LS (!nR = 1 or 2 only!)
    if( !stFamily.eq('L') ) then     $* LINEAR style

      option .$!root$nLS |Style:| tagwidth $!lsAT callback |!!draColStyle.cbActiveState('$!root')| PIXMAP width 209 height 16 $
        tooltip |Pick the system style from the list|
      option .$!root$nTH PIXMAP width 63 height 16 tooltip |Pick a thickness of your selected system style|
      !g = _$!root$nLS
      !g.dText = !this.sysLStylePNG
      !g.rText = !this.sysLStyleGrpName
      !g = _$!root$nTH
      !g.dText = !this.sysLStyleThPNG
      !g.rText = !this.sysLStyleTh

    elseif( !stFamily.eq('F') ) then $* FILL style

      option .$!root$nLS |Style:| tagwidth $!lsAT callback |!!draColStyle.cbActiveState('$!root')| PIXMAP width 209 height 16 $
        tooltip |Pick the system style from the list|
      -- No <root>TH (thickness) gadget !!!
      !g = _$!root$nLS
      !g.dText = !this.sysFStylePNG
      !g.rText = !this.sysFStyleName

    else                             $* MARKER style

      option .$!root$nLS |Style:| tagwidth $!lsAT callback |!!draColStyle.cbActiveState('$!root')| width 10 $
        tooltip |Pick the marker type from the list|
      option .$!root$nTH width 3.5 tooltip |Pick a marker scale factor|
      var list _$!root$nTH add |1| |2| |3| |4| |5| |6| |7| |8| exit
      !selPos = '28.7'
      !g = _$!root$nLS
      !g.dText = !this.sysMStyleName
      !g.rText = !this.sysMStyleName
    endif

    -- Determine the position of the <root>SEL button
    if( !nRows.eq(3) ) then
      !selAT = 'at xmin_$!root + $!tagWidth ymax+0.2'
    elseif( !udAlign ) then
      !selAT = 'at xmax_$!root$nLS + ' & !selPos
    else
      !selAT = ''
    endif

    -- Add the user-defined style gadgets
    button .$!root$nSEL $!selAT 'Select' callback |!!draColStyle.cbSelectUDStyle('$!root')| width 5 $
      tooltip 'Select the user-defined style'
    toggle .$!root$nUD || callback |!!draColStyle.cbStyleToggle('$!root')| $
      tooltip 'Check to use user-defined styles, leave unchecked to use the system styles'
    text .$!root$nUDS at xmax width 24 scroll 250 is STRING tooltip 'No user-defined style selected'

    --*********************************
    --KEEP THIS UNTIL MARKER STYLES IMPLEMENTED IN CORE
    -- see also commented out code in .loadUserStyles()
    if ( !stFamily.eq('M') ) then
      !gUDSEL = _$!root$nSEL
      !gUDSEL.active = false
    endif
    --*********************************
    	
    !gUDS = _$!root$nUDS
    !gUDS.clear()
    !gUDS.setEditable(false)
    !gUD = _$!root$nUD
    !gUD.val = false
    !gUD.active = false
  endif

  -- finish the frame, if requested
  if( !isFrame ) then
    exit
  endif
endmethod
-- End of method definition for .setup(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Creates the colour/style gadget group in the current form. Does not create the frame!
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group (see comments for .getSpecialValues)
--   2 R REAL   Either 1 or 2 (or 11, 12) - the number of rows (colour/style)
--   3 R STRING The 'at' property of the FIRST gadget
-- Return:
--
------------------------------------------------------------------------
define method .setup(!root is STRING, !nRows is REAL, !at1 is STRING)
  !options = 'NROWS=$!nRows\FIRSTAT=$!at1'
  !this.setup(!root, !options)
endmethod
-- End of method definition for .setup(STRING,REAL,STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Creates a frame in the current form with the colour/style gadget group
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group (see comments for .getSpecialValues)
--   2 R REAL   The number of rows (colour/style)
--   3 R STRING The title of the frame
--   4 R STRING The options to the 'frame' statement (the at, width specification)
-- Return:
--
------------------------------------------------------------------------
define method .setup(!root is STRING, !nRows is REAL, !frameTitle is STRING, !frameOptions is STRING)
  !options = 'NROWS=$!nRows\FRAMETITLE=$!frameTitle\FRAMEAT=$!frameOptions'
  !this.setup(!root, !options)
endmethod
-- End of method definition for .setup(STRING,REAL,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      cbActiveState
--
-- Description: Handler for the Style control active state
--
-- Method Type: Procedure
-- Arguments:
--   1 R FORM    The form to be handled
--   2 R STRING  The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .cbActiveState(!form is FORM, !root is STRING)
  if( !form.$!root$nUD.val ) then $* user-defined style is chosen
    !state = true
    !stateTH = false
  else
    !gadget = !form.$!root$nLS
    !sel = !gadget.selection()
    !defState = !gadget.active
    if( !sel.match('-').eq(1) ) then $* system style, special
      !stateTH = false
      if( !sel.neq('-1') ) then $* special, but not OFF
        !state = !defState
      else $* OFF
        !state = false
      endif
    else $* system style, non-special
      !state = !defState
      !stateTH = !defState
    endif
  endif
  !form.$!root$n.active     = !state
  !form.$!root$nPICK.active = !state
  !form.$!root$nTH.active   = !stateTH
  handle (2,759)
  endhandle
endmethod
-- End of method definition for .cbActiveState(FORM,STRING)

------------------------------------------------------------------------
--
-- Method:      cbActiveState
--
-- Description: Handler for the Style control active state (current form)
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING  The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .cbActiveState(!root is STRING)
  !fName = !this.formName
  if( !fName.empty() ) then
    !gadget = _$!root
    !form   = !gadget.owner()
  else
    !form   = !!$!fName
  endif
  !this.cbActiveState(!form, !root)
endmethod
-- End of method definition for .cbActiveState(STRING)

------------------------------------------------------------------------
--
-- Method:      cbPick
--
-- Description: Handler for the PICK button
--
-- NOTE: This method is not likely to be called when the form DOES NOT have a focus!!!
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING  The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .cbPick(!root is STRING)
  !fName = !this.formName
  if( !fName.empty() ) then
    !gadget = _$!root
    !fName = !gadget.owner().name()
  else
    !gadget = !!$!fName$n.$!root
  endif
  !this.csForm = !fName
  !this.csRoot = !root

  if( undefined(!!draftColourSelector) ) then
    using namespace 'Aveva.Pdms.Presentation.DrawListAddin'
    !!draftColourSelector = object COLOURSELECTOR()
    !!draftColourSelector.caption('Pick a colour')
    !!draftColourSelector.draftMode(true)
    !this.csHandler = !!draftColourSelector.addEventHandler('ColourSelected', !this, 'cbColourSelector')
  endif
  !colourString = !gadget.selection()
  if( !colourString.neq('') ) then
    !!draftColourSelector.initialColourNumber(!colourString.real())
  endif
  !!draftColourSelector.show()
endmethod
-- End of method definition for .cbPick(STRING)

------------------------------------------------------------------------
--
-- Method:      cbColourSelector
--
-- Description: Handler for the Colour Selector invoked by the PICK button
--
-- Method Type: Procedure
-- Arguments:
--   1 R ARRAY  The selected colour index and name
-- Return:
--
------------------------------------------------------------------------
define method .cbColourSelector(!args is ARRAY)
  !root  = !this.csRoot
  if( !root.neq('') ) then
--    !!draftColourSelector.hide()
    !fName = !this.csForm
    !oldForm = !this.formName
    !this.formName = !fName
    !this.selectColour(!!$!fName$n.$!root, !!$!fName$n.$!root$nSA, !args[0])
    !this.formName = !oldForm
  endif
endmethod
-- End of method definition for .cbColourSelector(ARRAY)

$(
'SOLID'          'SOLIDMEDIUM'       'SOLIDTHICK'
'DASHED'         'DASHEDMEDIUM'      'DASHEDTHICK'
'DOTTED'         'DOTTEDMEDIUM'      'DOTTEDTHICK'
'CHAINED'        'CHAINEDMEDIUM'     'CHAINEDTHICK'
'LDASHED'        'LDASHEDMEDIUM'     'LDASHEDTHICK'
'DDASHED'        'DDASHEDMEDIUM'     'DDASHEDTHICK'
'DDOTTED'        'DDOTTEDMEDIUM'     'DDOTTEDTHICK'
'FDOTTED'        'FDOTTEDMEDIUM'     'FDOTTEDTHICK'
'DCHAINED'       'DCHAINEDMEDIUM'    'DCHAINEDTHICK'
'TCHAINED'       'TCHAINEDMEDIUM'    'TCHAINEDTHICK'

'SOLID'          'SOLIDWIDE'         'SOLIDXWIDE'
'DASHPATTERN'    'DASHWIDE'          'DASHXWIDE'
'DASHDOT'        'DASHDOTWIDE'       'DASHDOTXWIDE'
'DASHDOUBLEDOT'  'DASHDOUBLEDOTWIDE' 'DASHDOUBLEDOTXWIDE'
'SHORTDASH'      'SHORTDASHWIDE'     'SHORTDASHXWIDE'
$)

------------------------------------------------------------------------
--
-- Method:      styleName
--
-- Description: Returns the style name for the given style and thickness gadgets
--
-- Method Type: Function
-- Arguments:
--   1 R GADGET The pixmap OPTION gadget with styles(F,M) (style groups(L))
--   2 R GADGET The pixmap OPTION gadget with thickness(L)/scale factors (M)
--   3 R STRING The style family
-- Return:
--   STRING  The style name (may be OFF, DEFAULT, UNCHANGED, TEMPLATE)
------------------------------------------------------------------------
define method .styleName(!gStyle is GADGET, !gThickness is GADGET, !family is STRING) is STRING
  !style = !gStyle.selection()
  -- 'special' styles - negative number
  if( !style.match('-').eq(1) ) then
    !num = !style.subString(2).real()
    return !this.specialNames[!num]
  -- Tribon & PDMS styles
  elseif( !family.eq('L') ) then   $* LINEAR
    -- look for the combination of a style group and thickness
    !s = !style & '/' & !gThickness.selection()
    !ind = !this.sysLStyleData.findFirst(!s)
    -- if found, return the corresponding style string according to the syntax graphs
    if( set(!ind) ) then
      return !this.sysLStyleName[!ind]
    else $* should not happen!
      !!alert.warning('Unrecognised style: $!s')
      return ''
    endif
  elseif( !family.eq('F') ) then   $* FILL
    return !style
  elseif( !family.eq('M') ) then   $* MARKER
    !s = !style & ' Scale ' & !gThickness.selection()
    return !s
  else
    return ''
  endif
endmethod
-- End of method definition for .styleName(GADGET,GADGET,STRING)

------------------------------------------------------------------------
--
-- Method:      selectColour
--
-- Description: Selects the colour from the palette in the OPTION gadget
--
-- Method Type: Procedure
-- Arguments:
--   1 R/W GADGET The OPTION gadget holding the colours
--   2 R/W GADGET The PARAGRAPH gadget holding the sample of the colour
--   3  R  REAL   The selected colour from the palette
-- Return:
--
------------------------------------------------------------------------
define method .selectColour(!option is GADGET, !para is GADGET, !colour is REAL)
  !colourString = !colour.string()
  !option.select('Rtext', !colourString)
  handle ANY
    if( !colour.between(1,272) ) then
      !this.updateColourArrays(!colour)
      !rText = !option.rText
      !n = 1
      do !codeString values !rText
        break if ( !codeString.match('-').eq(0) )
        !n = !n + 1
      enddo
      if( !n.eq(1) ) then
        !option.dText = !this.defColDText
        !option.rText = !this.defColRText
      else
        !dText = !option.dText.to(!n - 1)
        !dText.appendArray(!this.defColDText)
        !option.dText = !dText
        !rText.deleteFrom(!n)
        !rText.appendArray(!this.defColRText)
        !option.rText = !rText
      endif
      !option.select('Rtext', !colourString)
      handle ANY
      endhandle
    endif
  endhandle
  !this.updateSample(!option, !para)
endmethod
-- End of method definition for .selectColour(GADGET,GADGET,REAL)

------------------------------------------------------------------------
--
-- Method:      updateColourArrays
--
-- Description: Update the defColDText and defColRText arrays with the given colour
--
-- Method Type: Procedure
-- Arguments:
--   1  R  REAL   The selected colour from the palette
-- Return:
--
------------------------------------------------------------------------
define method .updateColourArrays(!colour is REAL)
  -- Skip default colours - nothing can be inserted in this range
  !n1 = !this.initialColours
  !nOptions = !this.defColRText.size()
  !n2 = !nOptions
  !v1 = !this.defColRText[!n1].real()
  !v2 = !this.defColRText[!n2].real()
  if( !colour.leq(!v1) or !colour.eq(!v2) ) then
    return $* nothing to do - one of the lower colours or matches the upper bound
  endif
  !s = !this.colourName(!colour)
  if( !colour.gt(!v2) ) then
    -- Append the new colour entry
    !this.defColDText.append(!s)
    !this.defColRText.append(!colour.string())
  else
    !gap = !n2 - !n1
    if( !gap.lt(8) ) then
      -- Linear search - better performance on short lists
      do !n from !n1 + 1 to !n2
        !v = !this.defColRText[!n].real()
        if( !colour.eq(!v) ) then
          return $* nothing to do - one of the existing entries
        endif
        -- If found a bigger colour index, break and insert there the new colour
        break if( !colour.lt(!v) )
      enddo
    else
      -- Start binary search - better performance on longer lists
      do
        break if ( !gap.leq(1) )
        -- Middle element
        !n = !n1 + INT( !gap / 2 )
        !v = !this.defColRText[!n].real()
        if( !colour.eq(!v) ) then
          return $* nothing to do - one of the existing entries
        endif
        -- Choose left or right partition and try again ...
        if( !colour.gt(!v) ) then
          !n1 = !n
        else
          !n2 = !n
        endif
        !gap = !n2 - !n1
      enddo
      -- The position at which to insert
      !n = !n1 + 1
    endif
    !this.defColDText.insert(!n, !s)
    !this.defColRText.insert(!n, !colour.string())
  endif
endmethod
-- End of method definition for .updateColourArrays(REAL)

------------------------------------------------------------------------
--
-- Method:      updateSample
--
-- Description: Updates the 'sample' paragraph to reflect the colour change
--
-- Method Type: Procedure
-- Arguments:
--   1 R/W GADGET The OPTION gadget holding the colours
--   2 R/W GADGET The PARAGRAPH gadget holding the sample of the colour
-- Return:
--
------------------------------------------------------------------------
define method .updateSample(!option is GADGET, !para is GADGET)
  !res = !option.selection().real()
  handle ANY
  elsehandle NONE
    if( !res.lt(1) ) then
      !para.visible = False
    else
      !para.visible = True
      !para.background = !res
    endif
  endhandle
endmethod
-- End of method definition for .updateSample(GADGET,GADGET)

------------------------------------------------------------------------
--
-- Method:      cbSelectUDStyle
--
-- Description: Callback routine for the button selecting a user-defined style
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .cbSelectUDStyle( !root is STRING )
  !fName = !this.formName
  if( !fName.empty() ) then
    !gUDS    = _$!root$nUDS
    !!draUserDefStyle.parent  = !gUDS.owner()
    !!draUserDefStyle.initial = !gUDS.val
  else
    !!draUserDefStyle.parent  = !!$!fName
    !!draUserDefStyle.initial = !!$!fName$n.$!root$nUDS.val
  endif
  !!draUserDefStyle.kind = !root

  -- If already shown, make sure we re-initialise, otherwise the form may contain
  --   data of the wrong type
  if ( !!draUserDefStyle.shown() ) then
    !!draUserDefStyle.init()
  endif

  show !!draUserDefStyle
endmethod
-- End of method definition for .cbSelectUDStyle(STRING)

------------------------------------------------------------------------
--
-- Method:      cbStyleToggle
--
-- Description: Callback routine for the system/user-defined style toggle
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .cbStyleToggle(!root is STRING)
  !fName = !this.formName
  if( !fName.empty() ) then
    !gToggle = _$!root$nUD
    !form    = !gToggle.owner()
  else
    !form    = !!$!fName
    !gToggle = !form.$!root$nUD
  endif
  !this.setStyleToggle(!form, !root, !gToggle.val)
endmethod
-- End of method definition for .cbStyleToggle(STRING)

------------------------------------------------------------------------
--
-- Method:      setStyleToggle
--
-- Description: Sets the state of the style toggle (on the given form), and updates the active status of the related gadgets
--
-- Method Type: Procedure
-- Arguments:
--   1 R FORM    The form to operate on
--   2 R STRING  The root name of the gadget group to be handled
--   3 R BOOLEAN New value of the toggle
-- Return:
--
------------------------------------------------------------------------
define method .setStyleToggle(!form is FORM, !root is STRING, !toggleValue is BOOLEAN)
  -- Don't check the toggle, if no user-defined style is selected
  if( !form.$!root$nUDS.val.unset() or !form.$!root$nUDS.val.eq('Unset') ) then
    !value = false
    -- Toggle active depends entirely on whether UDS is set, not on value passed in
    !form.$!root$nUD.active  = false
  else
    !value = !toggleValue
    -- Toggle active depends entirely on whether UDS is set, not on value passed in
  !form.$!root$nUD.active  = true
  endif
  !form.$!root$nUD.val     = !value
  !form.$!root$nUDS.active = !value
  !form.$!root$nLS.active  = not !value
  !this.cbActiveState(!form, !root)
endmethod
-- End of method definition for .setStyleToggle(FORM,STRING,BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setStyleToggle
--
-- Description: Sets the state of the style toggle, and updates the active status of the related gadgets
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING  The root name of the gadget group to be handled
--   2 R BOOLEAN New value of the toggle
-- Return:
--
------------------------------------------------------------------------
define method .setStyleToggle(!root is STRING, !value is BOOLEAN)
  !fName = !this.formName
  if( !fName.empty() ) then
    !gUD  = _$!root$nUD
    !form = !gUD.owner()
  else
    !form = !!$!fName
  endif
  !this.setStyleToggle(!form, !root, !value)
endmethod
-- End of method definition for .setStyleToggle(STRING,BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .cbStyleSetDbref(STRING,REAL,REAL)
--
-- Description: Called by !!draUserDefStyle form, when a style is selected to store
--              the dbref of the selected style. This will be used when setting the
--              element style instead of using string handling as was previously used.
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The type of style eg NLPN, FPEN. TPEN, LFPEN, LLPN
--   2 R REAL   The index in the library array
--   3 R REAL   The index in the array holding the style dbrefs
--
-- Return:
--
------------------------------------------------------------------------
define method .cbStyleSetDbref(!type is STRING, !lIndex is REAL, !sIndex is REAL)

  -- Initialise variables
  !family = !this.styleFamily(!type)

  -- Store the index in the relevant array for the selected line style
  !this.$!family$nStyRef = !this.$!family$nStyleRefs[!lIndex][!sIndex]

endmethod
-- End of method definition for .cbStyleSetDbref(STRING,REAL,REAL)

------------------------------------------------------------------------
--
-- Method:      cbStyleToggleReturn
--
-- Description: Routine called by !!draUserDefStyle form, when a style is selected
--
-- Method Type: Procedure
-- Arguments:
--   1 R FORM   The parent form to manipulate
--   2 R STRING The root name of the gadget group to be handled
--   3 R STRING The description of the new style to be presented in the <root>UDS TEXT gadget
-- Return:
--
------------------------------------------------------------------------
define method .cbStyleToggleReturn(!form is FORM, !root is STRING, !newStyle is STRING)
  if( not !newStyle.empty() ) then
    !gadget = !form.$!root$nUDS $* user-defined style data
    !res = !this.udStyleData2Description(!newStyle)
    !gadget.val = !res[1]
    !gadget.setToolTip(!res[2])
    !this.setStyleToggle(!form, !root, true)
  endif
endmethod
-- End of method definition for .cbStyleToggleReturn(FORM,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      reset
--
-- Description: Resets the active state of the gadgets, according to the current setting of the <root>UD toggle
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING  The root name of the gadget group to be handled
-- Return:
--
------------------------------------------------------------------------
define method .reset(!root is STRING)

  !fName = !this.formName
  if( !fName.empty() ) then
    !ud = _$!root$nUD
    handle (61,125) $* gadget not found
    endhandle
    !option = _$!root
    handle (61,125) $* gadget not found
      return
    endhandle
    !para   = _$!root$nSA
  else
    !ud = !!$!fName$n.$!root$nUD
    handle (61,125) $* gadget not found
    endhandle
    !option = !!$!fName$n.$!root
    handle (61,125) $* gadget not found
      return
    endhandle
    !para   = !!$!fName$n.$!root$nSA
  endif
  !this.updateSample(!option, !para)
  if defined(!ud) then
    !this.setStyleToggle(!ud.owner(), !root, !ud.val)
  endif

endmethod
-- End of method definition for .setStyleToggle(STRING)

------------------------------------------------------------------------
--
-- Method:      setStyle
--
-- Description: Routine for setting the gadgets to a given SYSTEM or SPECIAL style (a STRING)
-- NOTE: User-defined styles would return a REAL number (LSTYNO, FSTYNO, ...)
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group
--   2 R STRING The style string
-- Return:
--
------------------------------------------------------------------------
define method .setStyle(!root is STRING, !style is STRING)
  !family = !this.styleFamily(!root)
  -- skip, if the gadget group does not support styles
  if( !family.empty() ) then
    return
  endif

  !upStyle = !style.upCase()
  !th = '-' $* default - do NOT set
  !st = '-' $* default - do NOT set

  -- search the special style names first
  !ind = !this.specialNames.findFirst(!upStyle)

  if( set(!ind) ) then

    !st = '-$!ind'

  elseif( !family.eq('L') ) then $* not a special, try system style (LINEAR)

    !ind = !this.sysLStyleName.findFirst(!upStyle)
    if( set(!ind) ) then
      !parts = !this.sysLStyleData[!ind].split('/')
      !st = !parts[1]
      !th = !parts[2]
    endif

  elseif( !family.eq('F') ) then $* system style (FILL)

    !ind = !this.sysFStyleName.findFirst(!upStyle)
    if( set(!ind) ) then
      !st = !upStyle
    endif

  elseif( !family.eq('M') ) then

    !parts = !upStyle.split() $* e.g. 'CROSS SCALE 5'
    if( !parts.size().eq(3) ) then
      if( !parts[2].eq('SCALE') ) then
        !ind = !this.sysMStyleName.findFirst(!parts[1])
        if( set(!ind) ) then
          !scale = !parts[3]
          if( match('1/2/3/4/5/6/7/8/', !scale & '/') gt 0 ) then
            !st = !parts[1]
            !th = !scale
          endif
        endif
      endif
    endif

  endif

  if( !st.eq('-') ) then
    !!alert.warning('Warning: Unknown style - $!style$n!')
  else
    !fName = !this.formName
    if( !fName.empty() ) then
      !gLS = _$!root$nLS
    else
      !gLS = !!$!fName$n.$!root$nLS
    endif
    !form = !gLS.owner()
    !gLS.select('rText', !st)
    handle ANY $* field not found in a list
      !!alert.error('Style setting $!st is not valid here!')
    elsehandle None
      if( !th.neq('-') ) then
        !fName = !gLS.fullName().subString(-3) & 'TH'
        !gTH = $!fName
        !gTH.select('rText', !th)
        handle ANY $* field not found in a list
          !!alert.error('Style thickness setting $!th is not valid here!')
        endhandle
      endif
      !this.setStyleToggle(!form, !root, false)
    endhandle
  endif

endmethod
-- End of method definition for .setStyle(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      udStyleByNo
--
-- Description: Returns the user-defined style table and style numbers for the given Style Number
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING Style family
--   2 R REAL   The style number
-- Return:
--   ARRAY   2-element array containing the table index and the style index, or [-1,-1] if not found
------------------------------------------------------------------------
define method .udStyleByNo(!family is STRING, !styleNo is REAL) is ARRAY

  -- Initialise the return variables
  !res[1] = -1
  !res[2] = -1

  -- skip, if the gadget group does not support styles
  if( not !family.empty() ) then

    -- Get lowercase value of the family either 'l' or 'f'
    !familyLo = !family.lowCase()
    !found    = false

    -- For each style libraries
    do !tbIndex indices !this.$!familyLo$nStyle

      -- Look for an occurrence of the passed style number in the array of style numbers for all styles in this library
      !styleIndex = !this.$!familyLo$nStyleNos[!tbIndex].findFirst(!styleNo.string())

      if (!styleIndex.set()) then

        -- A match has been found so pass on the data for this style
        !found  = true
        !res[1] = !tbIndex
        !res[2] = !styleIndex

        -- Done
         break

      endif

    enddo

  endif

  return !res

endmethod
-- End of method definition for .udStyleByNo(STRING,REAL)

------------------------------------------------------------------------
--
-- Method:      setStyle
--
-- Description: Routine for setting the gadgets to a given USER-DEFINED style (a REAL)
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The root name of the gadget group
--   2 R REAL   The style number
-- Return:
--
------------------------------------------------------------------------
define method .setStyle(!root is STRING, !styleNo is REAL)

  !family = !this.styleFamily(!root)
  !result = !this.udStyleByNo(!family, !styleNo)
  !tbInd  = !result[1]

  if( !tbInd.gt(0) ) then

    !styInd = !result[2]
    !fLo    = !family.lowCase()
    !data   = !this.$!fLo$nStyle[!tbInd][!styInd]
    !res    = !this.udStyleData2Description(!data)
    !fName  = !this.formName

    if( !fName.empty() ) then
      !gUDS =  _$!root$nUDS
      !gUD  = _$!root$nUD
    else
      !gUDS = !!$!fName$n.$!root$nUDS
      !gUD  = !!$!fName$n.$!root$nUD
    endif

    !gUDS.val = !res[1]
    !gUDS.setToolTip(!res[2])
    !gUD.active = true
    !this.setStyleToggle(!root, true)

    -- Set the chosen style as the current selection in this object
    !this.cbStyleSetDbref(!root, !result[1], !result[2])

  else

    !desc = !this.familyDescription(!family)
    !!alert.error('ERROR: $!desc style number $!styleNo has not been found!')

  endif

endmethod
-- End of method definition for .setStyle(STRING,REAL)

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Routine for setting the gadget to a given colour
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The gadget group root name
--   2 R REAL   The colour string (the system and special ones)
-- Return:
--
------------------------------------------------------------------------
define method .setColour(!root is STRING, !colour is REAL)
  !fName = !this.formName
  if( !fName.empty() ) then
    !gColour = _$!root
    !gPara   = _$!root$nSA
  else
    !gColour = !!$!fName$n.$!root
    !gPara   = !!$!fName$n.$!root$nSA
  endif
  if( !colour.gt(0) ) then
    !col = !colour
  else
    !col = !colour - 1 $* map -3,-2,-1,0 from Dabacon to -4,-3,-2,-1 in the GUI
  endif
  !this.selectColour(!gColour, !gPara, !col)
endmethod
-- End of method definition for .setColour(STRING,REAL)

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Dummy routine warning the user, if a STRING colour value is used
--
-- Method Type: Procedure
-- Arguments:
--   1 R STRING The gadget group root name
--   2 R STRING The colour string value
-- Return:
--
------------------------------------------------------------------------
define method .setColour(!dummyRoot is STRING, !dummyColour is STRING)
  !!alert.error('Error: For initialising colour selector use the integer colour numbers, not colour names!')
endmethod
-- End of method definition for .setColour(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      getData
--
-- Description: Returns an array of results from the colour/style gadget group
--    [1] - True, if the data are valid, False, if they are not
--    [2] - colour number or special value as a string
--    [3] - style number or a name or a special value as a string
--
-- Method Type: Function
-- Arguments:
--   1 R STRING The gadget group root name
-- Return:
--   ARRAY   Array [3] of results for the given gadget group
------------------------------------------------------------------------
define method .getData(!root is STRING) is ARRAY
  !family = !this.styleFamily(!root)
  !res = ARRAY()
  !fName = !this.formName
  if( !fName.empty() ) then
    !gColour = _$!root
    if( not !family.empty() ) then
      !gUD  = _$!root$nUD
      !gUDS = _$!root$nUDS
      !gLS  = _$!root$nLS
      if( !family.eq('F') ) then
        !gTH = !gLS
      else
        !gTH = _$!root$nTH
      endif
    endif
  else
    !gColour = !!$!fName$n.$!root
    if( not !family.empty() ) then
      !gUD  = !!$!fName$n.$!root$nUD
      !gUDS = !!$!fName$n.$!root$nUDS
      !gLS  = !!$!fName$n.$!root$nLS
      if( !family.eq('F') ) then
        !gTH = !gLS
      else
        !gTH = !!$!fName$n.$!root$nTH
      endif
    endif
  endif
  !res[1] = true                 $* data are VALID
  !col = !gColour.selection()    $* colour number/special value STRING

  if( !col.empty() ) then        $* NOTE: It happened, that the selection returned an empty string!!!
    !res[1] = false
  elseif( !col.match('-').eq(1) ) then $* Special colour value
    !num = !col.subString(2,1).real()
    !col = !this.specialNames[!num]
  endif
  !res[2] = !col

  if( !family.empty() ) then
    !res[3] = ''                 $* undefined style (STRING)
  elseif( !gUD.val ) then        $* a user-defined style

    !res[3] = !this.udStyleDescription2ID(!gUDS.val)
    if( !res[3].empty() ) then
      !res[1] = false
    endif

  else                         $* system style

    !res[3] = !this.styleName(!gLS, !gTH, !family)
    if( !res[3].empty() ) then
      !res[1] = false          $* invalid system style
    endif

  endif

  return !res

endmethod
-- End of method definition for .getData(STRING)

------------------------------------------------------------------------
--
-- Method:      locateStyle
--
-- Description: Routine for locating the given style description in a set of the loaded user-defined styles
--
-- Method Type: Function
-- Arguments:
--   1 R ARRAY  The 'data' array for the given style family
--   2 R STRING The style string to look for
-- Return:
--   ARRAY  array of indices (style table, style) of the located style, or [-1,-1], if not found
------------------------------------------------------------------------
define method .locateStyle(!styData is ARRAY, !styleDescription is STRING) is ARRAY
  if( !styleDescription.unset() ) then
    !res[1] = -1
    !res[2] = -1
    return !res
  elseif( !styleDescription.subString(1,4).eq('Use ') ) then
    !search = !styleDescription.subString(5)
  else
    !search = !styleDescription
  endif
  do !ind1 indices !styData
    !ind2 = !styData[!ind1].findFirst(!search)
    if( set(!ind2) ) then
      !res[1] = !ind1
      !res[2] = !ind2
      return !res
    endif
  enddo
  !res[1] = -1
  !res[2] = -1
  return !res
endmethod
-- End of method definition for .locateStyle(ARRAY,STRING)

------------------------------------------------------------------------
--
-- Method:      udStyleData2Description
--
-- Description: For the given user-defined style data presents a style description and tooltip to be shown to the user
--
-- Method Type: Function
-- Arguments:
--   1 R STRING The style data
-- Return:
--   ARRAY 2-element array: [1] - the style description, [2] - tooltip for UDS gadget
------------------------------------------------------------------------
define method .udStyleData2Description(!styleData is STRING) is ARRAY
  -- data = name TAB function TAB (style number)
  -- descr = Use styleNo: name (function), if style number is present, or
  -- descr = Use name (function), if there is no style number (eg MSTYTB?)
  -- If function is empty, the '(function)' element is omitted
  !tab = '	' $* a tab character (DO NOT REPLACE WITH SPACES!)
  if (!tab.Substring(1,1) eq ' ') then
  	write('ERROR in dracolstylehandler.pmlobj: expected tab not spaces')
  endif
  !parts = !styleData.split(!tab)
  -- Is style number provided?
  if( !parts[3].empty() ) then
    !res[1] = !parts[1]
  else
    !res[1] = !parts[3] & ': ' & !parts[1]
  endif
  -- Determine the UDS gadget tooltip
  if( !parts[2].empty() ) then
    !res[2] = !res[1]
  else
    !res[2] = !parts[2]
  endif
  -- Add the 'Use ' prefix
  !res[1] = 'Use ' & !res[1]
  return !res
endmethod
-- End of method definition for .udStyleData2Description(STRING)

------------------------------------------------------------------------
--
-- Method:      udStyleDescription2ID
--
-- Description: For the given user-defined style description returns the corresponding style ID
--
-- Method Type: Function
-- Arguments:
--   1 R STRING The style description
-- Return:
--   STRING The style data (style number, or name, if no style number)
------------------------------------------------------------------------
define method .udStyleDescription2ID(!styleDescr is STRING) is STRING
  -- descr = Use styleNo: name, if style number is present, or
  -- descr = Use name, if there is no style number
  -- data = style number OR name
  if( unset(!styleDescr) ) then
    return ''
  elseif( !styleDescr.match('Use ').eq(1) ) then
    !ind0 = 5
  else
    !ind0 = 1
  endif
  !colInd = !styleDescr.match(':')

  -- Extract the style number
  if( !colInd.gt(0) ) then
    !res = !styleDescr.subString(!ind0, !colInd - !ind0)
    !unusedStyleNumber = !res.real()
    handle (2,441)
      -- not a real style number - at least not convertible to a number
      !res = !styleDescr.subString(!ind0)
    endhandle
  else
    !res = !styleDescr.subString(!ind0)
  endif
  return !res
endmethod
-- End of method definition for .udStyleDescription2ID(STRING)


$(
Legality checker rules for the colour and style attributes:
-----------------------------------------------------------

Value OFF is valid for attributes:
FSTYLE, MSTYLE, CHSTYL, OLSTYL, FFSTYL, BFSTYL, CLSTYL, OBSTYL,
ROWSTY, COLSTY, PLNSTY, MLNSTY
at: ALL elements except ACSTYL

NLSTYL at: NOTE, VNOT, SYTM, OUTL, VRTX, 2d primitives
     (i.e.: CIRC, RECT, ELLI, ETRI, TABL, MRKP, DMND, HEXA, STRA, ARC  )

Value DEFAULT (meaning obtain value from element owner) is valid for attributes:
*** COLOUR ***
DLCOLO, PLCOLO, DTCOLO, PTCOLO, CHCOLO at:
   Dimension Points (DPOI, DPPT, DPBA, ADIR, APPT)
   Dimensions (ADIM, LDIM, RDIM, PDIM) --> isDim
LLCOLO, LFCOLO at: Labels (GLAB, SLAB) --> isLabel
TXCOLO at: VNOT, TEXP, Labels (GLAB, SLAB)
NLCOLO at: VNOT, OUTL, VRTX, 2d primitives
     (i.e.: CIRC, RECT, ELLI, ETRI, TABL, MRKP, DMND, HEXA, STRA, ARC  ) --> is2D
FCOLOU at: VNOT, OUTL, 2d primitives
     (i.e.: CIRC, RECT, ELLI, ETRI, TABL, MRKP, DMND, HEXA, STRA, ARC  )
MCOLOU at: VNOT, MRKP, VRTX, RDIM, PDIM
ROWCOL, COLCOL at: TABL

*** STYLE ***
DLSTYL, PLSTYL, CHSTYL at:
   Dimension Points (DPOI, DPPT, DPBA, ADIR, APPT)
   Dimensions (ADIM, LDIM, RDIM, PDIM)
LLSTYL, LFSTYL at: Labels (GLAB, SLAB)
NLSTYL at: VNOT, OUTL, VRTX, 2d primitives
     (i.e.: CIRC, RECT, ELLI, ETRI, TABL, MRKP, DMND, HEXA, STRA, ARC  )
FSTYLE at: VNOT, OUTL, 2d primitives
     (i.e.: CIRC, RECT, ELLI, ETRI, TABL, MRKP, DMND, HEXA, STRA, ARC  )
MSTYLE at: VNOT, MRKP, VRTX, RDIM, PDIM
ROWSTY, COLSTY at: TABL

Value UNCHANGED (meaning do not change the Colour when the Change Rule applies)

*** COLOUR: Valid for attributes: NLCOLO, TXCOLO, FCOLOU, OLCOLO, FFCOLO, BFCOLO,
CLCOLO, OBCOLO, PLNCOL, MLNCOL at: Change Styles (i.e.: ACSTYL, DCSTYL)
*** STYLE:  Valid for attributes: NLSTYL,         FSTYLE, OLSTYL, FFSTYL, BFSTYL,
CLSTYL, OBSTYL, PLNSTY, MLNSTY at: Change Styles (i.e.: ACSTYL, DCSTYL)

Value TEMPLATE (meaning obtain value from referenced symbol template) is valid for attributes:
*** COLOUR: LFCOLO, TXCOLO at: SLAB, LAYE
*** STYLE:  LFSTYL at: SLAB, LAYE
$)
------------------------------------------------------------------------
--
-- Method:      getSpecialValues01
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : TPEN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues01(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.eq('SLAB') ) then
    !colours.append('-2')
    !colours.append('-4')
  elseif( !type.eq('LAYE') ) then
    !colours.append('-4')
  elseif( !type inset( 'GLAB', 'VNOT', 'TEXP') ) then
    !colours.append('-2')
  elseif ( !type inset( 'ACSTYL', 'DCSTYL') ) then
    !colours.append('-3')
  endif
endmethod
-- End of method definition for .getSpecialValues01(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues02
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : DTPN, PTPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues02(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( match('/LDIM/ADIM/DPOI/DPPT/RDIM/PDIM/APPT/ADIR/DPBA/', '/$!type/') gt 0 ) then
    !colours.append('-2')
  endif
endmethod
-- End of method definition for .getSpecialValues02(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues03
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : FPEN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues03(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.neq('ACSTYL') ) then
    !styles.append('-1')
    if( match('/STRA/RECT/CIRC/ARC/ELLI/ETRI/TABL/MRKP/DMND/HEXA/VNOT/OUTL/', '/$!type/') gt 0 ) then
      !colours.append('-2')
      !styles.append('-2')
    elseif( !type.eq('DCSTYL') ) then
      !colours.append('-3')
      !styles.append('-3')
    endif
  else
    !colours.append('-3')
    !styles.append('-3')
  endif
endmethod
-- End of method definition for .getSpecialValues03(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues04
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : MPEN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues04(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( !type.neq('ACSTYL') ) then
    !styles.append('-1')
    if( !type inset('RDIM', 'PDIM', 'VNOT', 'VRTX', 'MRKP') ) then
      !colours.append('-2')
      !styles.append('-2')
    endif
  endif
endmethod
-- End of method definition for .getSpecialValues04(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues05
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : NLPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
--
------------------------------------------------------------------------
define method .getSpecialValues05(!type is STRING, !colours is ARRAY, !styles is ARRAY)
  if( match('/STRA/RECT/CIRC/ARC/ELLI/ETRI/TABL/MRKP/DMND/HEXA/VNOT/OUTL/VRTX/', '/$!type/') gt 0 ) then
    !styles.append('-1')
    !styles.append('-2')
    !colours.append('-2')
  elseif( !type inset('NOTE', 'SYTM') ) then
    !styles.append('-1')
  elseif( !type inset('ACSTYL', 'DCSTYL') ) then
    !colours.append('-3')
    !styles.append('-3')
  endif
endmethod
-- End of method definition for .getSpecialValues05(STRING,ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:      getSpecialValues06 ----- NO LONGER USED, LLPN uses getSpecialValues07
--
-- Description: Determines the 'special' values for colours and styles
-- Root names : LLPN
-- Encoding   : -1 (Off), -2 (Default), -3 (Unchanged), -4 (Template)
--
-- Method Type: Procedure
-- Arguments:
--   1  R  STRING Type of the DB element, for which the attributes are determined
--   2 R/W ARRAY  The array of colour values
--   3 R/W ARRAY  The array of style values
-- Return:
