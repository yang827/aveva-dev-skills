--
--
-- Description:
-- Object to store all the dimension types available
-- There are several different dimension definitions for each type
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draCreateList()                  -
--  getDefinition(STRING)            DRAUGHTING
--  globalInstance()                 -
--  icons()                          -
--

define object DRACREATELIST

   member .straights    is ARRAY $* straight line Definitions
   member .outlines     is ARRAY $* Definitions
   member .arcs         is ARRAY $* Definitions
   member .circles      is ARRAY $* Definitions
   member .rectangles   is ARRAY $* Definitions
   member .shapes       is ARRAY $* Definitions
   member .symbols      is ARRAY $* Definitions
   member .text         is ARRAY $* Definitions

   -- Store new icon paths
   member .iconPaths    is ARRAY

endobject
-- End of object definition for dracreatelist
------------------------------------------------------------------------
--
-- Method:      dracreatelist
--
-- Description: Constructor running defaults in from the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draCreateList()

-- initialise variables
!drawing2d  = object DRAUGHTING()
!drawing2ds = !!cd2dCreate
!savedGroup = 0
!count      = 0

 -- Load the icons
 !this.icons()

do !i indices !drawing2ds
-- set/get dimension Definition
  !drawing2d = !this.getDefinition(!drawing2ds[!i])

  -- Reset the icon path
  !drawing2d.icon = !this.iconPaths[!i]

-- set counter to group the dimensions into their respective groups
  if(!drawing2d.group.eq(!savedGroup)) then
     !count = !count + 1
  else
     !count = 1
  endif

-- set each dimension type

  if(!drawing2d.group.eq(1)) then
     !this.straights[!count] = !drawing2d
  elseif(!drawing2d.group.eq(2)) then
     !this.outlines[!count] = !drawing2d
  elseif(!drawing2d.group.eq(3)) then
     !this.arcs[!count] = !drawing2d
  elseif(!drawing2d.group.eq(4)) then
      !this.circles[!count] = !drawing2d
  elseif(!drawing2d.group.eq(5)) then
      !this.rectangles[!count] = !drawing2d
  elseif(!drawing2d.group.eq(6)) then
      !this.shapes[!count] = !drawing2d
  elseif(!drawing2d.group.eq(7)) then
      !this.symbols[!count] = !drawing2d
  elseif(!drawing2d.group.eq(8)) then
      !this.text[!count] = !drawing2d
  endif
-- set flag to continue with the same group

  !savedGroup = !drawing2d.group

enddo

endmethod
-- End of method definition for .dimCreateList()

------------------------------------------------------------------------
--
-- Method:      getDefinition
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R/RW] [STRING]    [String of the stored dimension definition]
-- Return:
--   [Data Type] [Description]
--   [DIMENSION] [Return an object of the dimension definition]
--
------------------------------------------------------------------------
define method .getDefinition(!drawing2dString is STRING) is DRAUGHTING

   !drawing2d = object DRAUGHTING(!drawing2dString.split(':'))

   return !drawing2d

endmethod
-- End of method definition for .getDefinition(STRING)
------------------------------------------------------------------------
--
-- Method:      globalInstance()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- create the global instance of this object
  !!drawing2dDefinitions = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      .icons()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .icons()

  -- Use the new icons stored in folder %PMLLIB%/icons/draft
  -- The original forms cannot use them, hence why we are overriding them here
  !this.iconPaths.append('/%PMLLIB%/icons/draft/draft_t_017.png')
