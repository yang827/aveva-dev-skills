--
--  Description:
--  The object managing the old elemopt gadgets enabling the selection of the
--  type of the object to be picked/selected. Based on the old DELEMTAB
--  and MELEMTAB macros.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGroup(REAL,STRING,STRING)     -                   Auxiliary method helping to build the menu structures
--  cbSelectGroup(FORM)              -                   Callback on the group selection gadget
--  draElementSelector()             -                   Constructor
--  findType(FORM,STRING)            -                   Locates the given selection and sets the gadgets accordingly
--  init(FORM,STRING)                -                   Initialises the element selector gadgets
--  setup(STRING,REAL,STRING)        -                   Builds the menu option gadgets
--
------------------------------------------------------------------------
define object DRAELEMENTSELECTOR
  member .groupNames is ARRAY
  member .groupDtext is ARRAY
  member .groupRtext is ARRAY
endobject

------------------------------------------------------------------------
--
-- Method:      addGroup
--
-- Description: Auxiliary method helping to build the menu structures
--
-- Method Type: Procedure
-- Arguments:
--   1   R   REAL   Index in the groups menu
--   2   R   STRING Title of the menu group
--   3   R   STRING Element data(dtext\rtext^dtext\rtext^...)
-- Return:
--
------------------------------------------------------------------------
--
define method .addGroup(!index is REAL, !title is STRING, !data is STRING)
  !this.groupNames[!index] = !title
  !tab = !data.split('^')
  !dText = ARRAY()
  !rText = ARRAY()
  do !item values !tab
    !n = !item.match('\')
    !dText.append( !item.subString(1, !n - 1) )
    !rText.append( !item.subString(!n + 1) )
  enddo
  !this.groupDtext[!index] = !dText
  !this.groupRtext[!index] = !rText
endmethod
-- End of method definition for .addGroup(REAL, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      draElementSelector
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .draElementSelector()
  !this.groupNames = ARRAY()
  !this.groupDtext = ARRAY()
  !this.groupRtext = ARRAY()

  !s = 'All\ALL^Branches\BRANCH^Branch Members\BRANCH MEMBERS^Equipments\EQUIPMENT^' & $
       'Framework\FRMWORK^Hangers\HANGER^Nozzles\NOZZLE^Pipes\PIPE^Pipe Tracks\PTRACK^' & $
       'Restraints\RESTRAINT^Sites\SITE^Structures\STRUCTURE^Sub-Equipments\SUBEQUIPMENT^' & $
       'Sub-Structures\SUBSTRUCTURE^Sub-Framework\SBFRAMEWORK^Template\TMPLATE^Zones\ZONE'
  !this.addGroup(1, 'Common Elements', !s)

  !s = 'Attachments\ATTACHMENT^Blind Flange\FBLIND^Bends\BEND^Caps\CAP^Closures\CLOSURE^' & $
       'Couplings\COUPLING^Crosses\CROSS^Ductings\DUCTING^Elbows\ELBOW^Filters\FILTER^' & $
       'Fixed Tube\FTUBE^Flanges\FLANGE^Four Way Valves\VFWAY^Gaskets\GASKET^Instruments\INSTRUMENT^' & $
       'Lap Joint Stub End\LJSE^Olets\OLET^Pipe Components\PCOMPONENT^Reducers\REDUCER^' & $
       'Special Hook Up\SHU^Shoe\SHOE^Tees\TEE^Traps\TRAP^Tubing\TUBING^Two Way Valves\VTWAY^' & $
       'Unions\UNION^Valves\VALVE^Vents\VENT^Welds\WELD'
  !this.addGroup(2, 'Piping', !s)

  !s = 'Compound Fitting\CMFITTING^Compound Panel Fit.\CMPFITTING^Co-Fitting\COFITTING^' & $
       'Complementary Fixing\COMFIXING^Extrusion\EXTRUSION^Fitting\FITTING^Fixing\FIXING^' & $
       'Framework\FRMWORK^Gen. Section\GENSEC^Loop\LOOP^Negative Extrusion\NXTRUSION^' & $
       'Panel\PANEL^Panel Fitting\PFITTING^Panel Loop\PLOOP^Panel Linear Joint\PALJOINT^' & $
       'Panel Vertex\PAVERT^Primary Cmplx Joint\PCOJOINT^Primary Joint\PJOINT^Primary Node\PNODE^' & $
       'Secondary Comp. Joint\SCOJOINT^Secondary Cmplx Joint\PCOJOINT^Secondary Joint\SJOINT^' & $
       'Secondary Lin''r Joint\SELJOINT^Secondary Node\SNODE^Secondary Vertex\SEVERT^Section\SCTN^' & $
       'Sub-Fitting\SBFITTING^Sub-Framework\SBFRAMEWORK^Sub-Joint\SUBJOINT^Vertex\VERTEX'
  !this.addGroup(3, 'Structural', !s)

  !s = 'Compound Floor\CFLOOR^Compound Screed\CSCREED^Compound Wall\CWALL^Floor\FLOOR^' & $
       'Screed\SCREED^Straight-Wall\STWALL^Wall\WALL'
  !this.addGroup(4, 'Walls & Floors', !s)

  !s = 'Beam Bolting Attach''t\BBOLT^Beam Welding Attach''t\BWLD^Clevis Pin\CLEVIS^Eye Nut\EYENUT^' & $
       'Eye Rod\EYRD^Hanger Elements\HELEMENT^Hanger Nut\HNUT^Hanger Pin\HPIN^Hanger Rod\HROD^' & $
       'Pipe Clamps\PCLAMP^Pipe Clip\PCLIP^Pipe Lug\PLUG^Pipe Overstrap\POST^Rod Coupling\RCPL^' & $
       'Snubber\SNUB^Spacer\SPACER^Steel Clamps\SCLAMP^Steel Lug\SLUG^Steel Overstrap\SOST^' & $
       'Steel Spacer\STLS^Sway Brace\SWBR^Trunnion\TRNN^Turn Buckle\TRNB^U Bolt\UBOLT^' & $
       'Variable Spring\VSPR^Washer\WASH^Wear Pad\WPAD'
  !this.addGroup(5, 'Hangers & Supports', !s)

  !s = 'Access Panel\HACC^Air Handling Unit\AHU^Bend\BEND^Branch Connector\BRCO^Cap\CAP^' & $
       'Component\PCOMPONENT^Coupling\COUPLING^Cowl\COWL^Damper\DAMPER^Elbow\ELBOW^Fan\HFAN^' & $
       'Flexible Tubing\FLEXIBLE^Gasket\GASKET^Grille\GRILLE^Heater/Cooler Battery\BATTERY^' & $
       'HVAC Main\HVAC^Internal damper\IDAM^Mesh\MESH^Offset Piece\OFST^Plenum\PLENUM^Saddle\HSADDLE^' & $
       'Silencer\SILENCER^Spigot Plate\PLATE^Splitter Plate\SPLR^Stiffener\STIFFENER^' & $
       'Straight Piece\STRT^Taper piece\TAPER^Test Point\TP^Three Way\THREEWAY^Transition Piece\TRNS^' & $
       'Weather Skirt\SKIR'
  !this.addGroup(6, 'HVAC', !s)

  !index = 7
  var !check EVAR 'AVEVA_MARINE'
  if( not !check.empty() ) then

    !s = 'Planar panel\HPANEL^P.panel plate\HPLATE^P.panel stiffener\HSTIFF^P.panel bracket\HBRCKT^' & $
         'P.panel flange\HFLANG^P.panel pillar\HPILLR^P.panel seam\HSEAM^P.panel hole\HHOLE^' & $
         'P.panel cutout\HCTOUT^P.panel clip\HCLIP^P.panel notch\HNOTCH^P.panel doubling plate\HDOPLA^' & $
         'P.panel curve\HCURVE^P.panel point\HPOINT^P.panel tap\HTAP^P.panel boundary\HPANBO^' & $
         'Bracket panel\HBRAPN^Standard bracket\HSTBRA^P.panel bracket stiffener\HBRSTI^' & $
         'P.panel bracket flange\HBRFLA^Subpanel\HSUBPN^P.panel profile cutout\HPRCUT^' & $
         'P.panel profile end\HPREND^P.panel profile hole\HPRHOL^P.panel profile notch\HPRNOT^' & $
         'P.panel bead\HBEAD^P.panel boundary interval\HPANBI^P.panel bracket boundary\HBRABO^' & $
         'Exposed Reference Surface Object (RSO)\HRSO^Exposed RSO Limit\HRSOL^' & $
         'Exposed RSO Face\HRSOF^Exposed Compartment\HCOMPT'
    !this.addGroup(!index, 'Planar Hull', !s)

    !s = 'Curved panel\CPANEL^Shell plate\CPLATE^Shell stiffener\CSTIFF^Shell profile\CPROF^' & $
         'Seam\CSEAM^Curved panel internal seam\CPNISE^Shell hole\CHOLE^General shell curve\CCURVE^' & $
         'Surface\CSURF^Curved panel boundary\CPANBO^Shell profile cutout\CPRCUT^' & $
         'Shell profile hole\CPRHOL^Shell profile notch\CPRNOT^Shell profile marking\CPRMRK^' & $
         'Shell profile trace curve\CPROTR^Shell stiffener end\CPREND^Plane\CPLANE^Curved hull point\CPOINT'
    !this.addGroup(!index + 1, 'Curved Hull', !s)
    !index = !index + 2

  endif

  !s = 'Boundaries\BOUNDARY^Datums\DATUM^Drawings\DRAWING^Ground Models\GRDMODEL^Points\POINT^' & $
       'Invisible Points\IPOINT^Tangent Points\TANPOINT^Texts\TEXT'
  !this.addGroup(!index, '2D Drawing', !s)

  !s = 'Boxes\BOX^Cones\CONE^Circular Tori\CTORUS^Cylinders\CYLINDER^Dishes\DISH^Drawings\DRAWING^' & $
       'Extrusion\EXTRUSION^Po-gons\POGON^Po-hedra\POHEDRON^Polyhedra\POLYHEDRON^' & $
       'Penalty Volumes\PVOLUME^Pyramids\PYRAMID^Revolution\REVOLUTION^Routing Planes\RPLANE^' & $
       'Rectangular Tori\RTORUS^Slope Cylinders\SLCYLINDER^Snouts\SNOUT'
  !this.addGroup(!index + 1, 'Primitives', !s)

  !s = 'Neg. Boxes\NBOX^Neg. Cones\NCONE^Neg. Circular Tori\NCTORUS^Neg. Cylinders\NCYLINDER^' & $
       'Neg. Dishes\NDISH^Neg. Polyhedra\NPOLYHEDRON^Neg. Pyramids\NPYRAMID^Neg. Revolution\NREVOLUTION^' & $
       'Neg. Rectangular Tori\NRTORUS^Neg. Slope Cylinders\NSLCYLINDER^Neg. Snouts\NSNOUT'
  !this.addGroup(!index + 2, 'Negatives', !s)

  !s = 'Load Case Descriptor\LCDESCRIPTOR^Load Point\LOAPOINT^Nodal Displacements\NODISPLACEMENT^' & $
       'Nodal Loads\NOLOAD^Releases\RELEASE^Section Distr. Loads\SDLOAD^Section Point  Loads\SPLOAD'
  !this.addGroup(!index + 3, 'Loads', !s)

endmethod
-- End of method definition for .draElementSelector

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Builds the menu option gadgets
--
-- Method Type: Procedure
-- Arguments:
--  1  R  STRING  The element group option gadget tag string
--  2  R  REAL    The tag width of the element group option gadget tag
--  3  R  STRING  The 'at ...' expression for the placement of the element group option gadget
-- Return:
--
------------------------------------------------------------------------
define method .setup(!tag is STRING, !tagWidth is REAL, !at is STRING)
  option .elemGroup $!at '$!tag' tagwidth $!tagWidth width 14 $
    tooltip |Groups of Design element types|
  option .elemOpt at xmax+0.5 ymin width 18 $
    tooltip |Types of Design element to reference by the label|
endmethod
-- End of method definition for .setup(STRING, REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialises the element selector gadgets
--
-- Method Type: Procedure
-- Arguments:
--  1  R  FORM    The form containing the gadgets
--  2  R  STRING  The initial value of the selection
-- Return:
--
------------------------------------------------------------------------
define method .init(!form is FORM, !initial is STRING)
  !form.elemGroup.dText = !this.groupNames
  !this.findType(!form, !initial)
  !formName = !form.fullName()
  !form.elemGroup.callback = '!!elementSelector.cbSelectGroup($!formName)'
endmethod
-- End of method definition for .init(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      findType
--
-- Description: Locates the given selection and sets the gadgets accordingly
--
-- Method Type: Procedure
-- Arguments:
--  1  R  FORM    The form containing the gadgets
--  2  R  STRING  The value of the selection
-- Return:
--
------------------------------------------------------------------------
define method .findType(!form is FORM, !selection is STRING)
  !gInd = 1
  !eInd = 1
  do !index indices !this.groupRtext
    !ind = !this.groupRtext[!index].findFirst(!selection)
    if( set(!ind) ) then
      !gInd = !index
      !eInd = !ind
      break
    endif
  enddo
  !form.elemGroup.val = !gInd
  !form.elemOpt.dText = !this.groupDtext[!gInd]
  !form.elemOpt.rText = !this.groupRtext[!gInd]
  !form.elemOpt.val = !eInd
endmethod
-- End of method definition for .findType(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      cbSelectGroup
--
-- Description: Callback on the group selection gadget
--
-- Method Type: Procedure
-- Arguments:
--  1  R  FORM    The form containing the gadgets
-- Return:
--
------------------------------------------------------------------------
define method .cbSelectGroup(!form is FORM)
  !ind = !form.elemGroup.val
  !form.elemOpt.dText = !this.groupDtext[!ind]
  !form.elemOpt.rText = !this.groupRtext[!ind]
  !form.elemOpt.val = 1
endmethod
-- End of method definition for .cbSelectGroup(FORM)
