--
--
-- Description:
-- Font selection form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -                   Close the form
--  init()                           -                   The form initialisation
--  ok()                             -                   Pass the selected font back to the calling form
--  view()                           -                   Determine view gadget limits for selected font
--
------------------------------------------------------------------------
-- Define object
define object DRAFONTSEL

  member .form is FORM

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .dismiss()
--
-- Description: Close the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dismiss()

  -- *** OLD PML SYNTAX
  !!cdFontForm = '_cdRSpeed'

endmethod
-- End of form definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: The form initialisation
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Add sheet to view
  edit view !!draFontSel.feedback AREA put $_CDRDRAFTAIDS_FONTSEL
  !box[1] = 3
  !box[2] = 3
  !box[3] = 48
  !box[4] = 50
  !this.form.feedback.limits = !box

  -- Find current font from drawing template form
  if (!this.form.setForm.font.rtext[2].eq('SELECT')) then
    !font = 1
  else
    !font = !this.form.setForm.font.rtext[2].real()
  endif
  if (!font.eq(1) or !font.eq(2) or !font.eq(3) or !font.eq(4)) then
    !fontF = !font * 10
    !fontSelect = 10
    !fontN = 1
  else
    !fontF = !font / 10
    !fontSelect = !fontF.int() * 10
    !fontN = !font - !fontSelect
  endif

  -- Select font & attributes
  !this.form.fontName.select('RTEXT',!fontSelect.string())

  if (!fontN.eq(1) or !fontN.eq(2) or !fontN.eq(3)) then
    !this.form.fontThk.select('DTEXT','Thin')
  else
    !this.form.fontThk.select('DTEXT','Bold')
  endif

  if (!fontN.eq(1) or !fontN.eq(4)) then
    !this.form.fontSlant.select('DTEXT','Upright')
  elseif (!fontN.eq(2) or !fontN.eq(5)) then
    !this.form.fontSlant.select('DTEXT','Forward')
  else
    !this.form.fontSlant.select('DTEXT','Reverse')
  endif

  -- Reset view limits
  !this.view()

endmethod
-- End of form definition for .init()

------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: Pass the selected font back to the calling form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ok()

  -- Determine font description
  !fontDesc = !this.form.fontName.selection('DTEXT') & ' ' &  !this.form.fontThk.selection('DTEXT') & ' ' & !this.form.fontSlant.selection('DTEXT')
  !fontNum = !this.form.fontName.selection('RTEXT').real() + !this.form.fontThk.selection('RTEXT').real() + !this.form.fontSlant.selection('RTEXT').real()

  -- Set drawing template attributes form font gadget
  !this.form.setForm.font.clear()
  !dtext[1] = ' '
  !dtext[2] = !fontDesc
  !dtext[3] = 'Selected...'
  !rtext[1] = 'UNCHANGED'
  !rtext[2] = !fontNum.string()
  !rtext[3] = 'SELECT'
  !this.form.setForm.font.dtext = !dtext
  !this.form.setForm.font.rtext = !rtext

  -- Select this setting
  !this.form.setForm.font.select('DTEXT',!fontDesc)

  -- Dismiss
  !this.dismiss()

endmethod
-- End of form definition for .ok()

------------------------------------------------------------------------
--
-- Method:      .view()
--
-- Description: Determine view gadget limits for selected font
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .view()

  -- Calculate distance to next font
  !fontF = (!this.form.fontName.selection('RTEXT').real() / 10) - 1
  !fontN = !this.form.fontThk.selection('RTEXT').real() + !this.form.fontSlant.selection('RTEXT').real()
  !xDist = 50 * ((!fontF * 6) + (!fontN - 1))

  -- Read current units & set to mm
  !savedUnits = object COMUNITS(TRUE)
  UNITS MM DIST

  -- Set view limits
  !box[1] = 3 + !xDist
  !box[2] = 3
  !box[3] = 48 + !xDist
  !box[4] = 50
  !this.form.feedback.limits = !box

  -- Reset units
  !savedUnits.restoreSavedUnitsByPtype('DIST')

endmethod
-- End of form definition for .view()
