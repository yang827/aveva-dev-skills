--
--
-- Description:
-- User-definable pen selection form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set dimension directions
--  getCE()                          -                   Get data for CE
--  init()                           -                   Form initialisation
--  setDire(GADGET)                  -                   Set direction gadgets
--  setXDire(GADGET)                 -                   Set the available x-axis directions
--  setYDire(GADGET)                 -                   Set the available y-axis directions
--  setZDire(GADGET)                 -                   Set the available z-axis directions
--  testUnset()                      -                   Test real gadgets for unset
--
------------------------------------------------------------------------
-- Define object
define object DRALDIMDIRECTION

  member .form is FORM
  member .short is ARRAY $* short axes names
  member .full is ARRAY  $* full axes names

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method: .apply()
--
-- Description: Set dimension directions
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Store current location
  !ce = !!ce

  -- Access the dimension
  !!ce = !this.form.dimeRef

  -- Projection - validity check
  if( !this.form.projTyp.eq('ANGLE') ) then
    !projSyntax = !this.form.projDir
  else
    !projSyntax = !!coords.enuDir(!this.form.projDir )
    handle ANY
      !!alert.error('Invalid projection direction specified!')
      !projSyntax = ''
    endhandle
  endif

  -- Direction - validity check
  !dirSyntax = !this.form.dimeDir
  !notTrueLength = match('TRUELENGTH', !dirSyntax) neq 1
  if( !notTrueLength ) then
    !dirSyntax = !!coords.enuDir(!dirSyntax)
    handle ANY
      !!alert.error('Invalid dimension direction specified!')
      !dirSyntax = ''
    endhandle
  endif

  -- Apply if the settings are acceptable
  if( !projSyntax.neq('') and !dirSyntax.neq('') ) then
    if( !notTrueLength ) then
      TLIN False
    endif
    DIR $!dirSyntax
    handle ANY
      !!alert.error(!!error.text)
    endhandle

    PLDI $!projSyntax
    handle ANY
      !!alert.error(!!error.text)
    endhandle

    -- Sort the dimension
    SORT DIM
    -- Refresh form since setting a compound angle is not always what it seems!
    !this.getCE()
  endif

  -- Attempt to return to original location
  if (!ce.badref().not()) then
    !!ce = !ce
  endif

endmethod
-- End of method definition .apply()

------------------------------------------------------------------------
--
-- Method: .getCE()
--
-- Description: Get data for CE
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCE()

  !form = !this.form
  -- Test for ce location
  if (!!ce.type.upCase().eq('LDIM')) then
    !form.dimeRef = !!ce
  elseif (!!ce.owne.type.upCase().eq('LDIM')) then
    !form.dimeRef = !!ce.owne
  endif

  -- Get Line direction
  -- Dimension
  -- Test for truelength
  -- Have to read using var because 'dbref().dir' & 'EVAL DIR FOR' returns 'E' if DIR set to TRUELENGTH
  !!ce = !form.dimeRef
  VAR !dimeDir DIR
  SAME
  if (!dimeDir.upCase().eq('TRUELENGTH')) then
    !form.dimeDir = 'TRUE'
    !form.dimeTyp = 'TRUE'
  else
    !form.dimeDir = !form.dimeRef.dir.string().before(' WRT')
    !form.dimeTyp = 'DIRECTION'
  endif

  -- Projection
  if (!form.dimeRef.pldi.size().eq(1)) then

    -- Set as an angle
    !form.projDir = !form.dimeRef.pldi[1].string()
    !form.projTyp = 'ANGLE'

  else

    -- Set as a direction
    !dirObj = object DIRECTION()
    !dirObj.east   = !form.dimeRef.pldi[1]
    !dirObj.north  = !form.dimeRef.pldi[2]
    !dirObj.up     = !form.dimeRef.pldi[3]
    !dirObj.origin = !form.dimeRef.owne
    !form.projDir = !dirObj.string().before(' WRT')
    !form.projTyp = 'DIRECTION'

  endif

  -- Set gadgets
  -- Dimension
  if (!form.dimeTyp.eq('TRUE')) then
    !form.dlXAxis.select('RTEXT','TRUELENGTH')
    !this.setYDire(!form.dlYAxis)
    !this.setZDire(!form.dlZAxis)
  else
    !dir = !form.dimeDir.split()
    !form.dlXAxis.select('RTEXT',!dir[1])
    !this.setYDire(!form.dlYAxis)
    if (defined(!dir[2])) then
      !form.dlAngleA.val = !dir[2].real().nint()
    else
      !form.dlAngleA.clear()

    endif
    if (defined(!dir[3])) then
      !form.dlYAxis.select('RTEXT',!dir[3])
    else
      !form.dlYAxis.val = 1
    endif
    !this.setZDire(!form.dlZAxis)
    if (defined(!dir[4])) then
      !form.dlAngleB.val = !dir[4].real().nint()
    else
      !form.dlAngleB.clear()
    endif
    if (defined(!dir[5])) then
      !form.dlZAxis.select('RTEXT',!dir[5])
    else
      !form.dlZAxis.val = 1
    endif
  endif

  -- Projection
  if (!form.projTyp.eq('ANGLE')) then
    !form.plAngleA.val = !form.projDir.real().nint()
    !form.plXAxis.select('RTEXT','ANGLE')
    !this.setYDire(!form.plYAxis)
    !this.setZDire(!form.plZAxis)
  else
    !dir = !form.projDir.split()
    !form.plXAxis.select('RTEXT',!dir[1])
    !this.setYDire(!form.plYAxis)
    if (defined(!dir[2])) then
      !form.plAngleA.val = !dir[2].real().nint()
    else
      !form.plAngleA.clear()
    endif
    if (defined(!dir[3])) then
      !form.plYAxis.select('RTEXT',!dir[3])
    else
      !form.plYAxis.val = 1
    endif
    !this.setZDire(!form.plZAxis)
    if (defined(!dir[4])) then
      !form.plAngleB.val = !dir[4].real().nint()
    else
      !form.plAngleB.clear()
    endif
    if (defined(!dir[5])) then
      !form.plZAxis.select('RTEXT',!dir[5])
    else
      !form.plZAxis.val = 1
    endif
  endif

endmethod
-- End of method definition .getCE()

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Form initialisation
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !this.short = !!coords.axesShortNames()
  !this.full  = !!coords.axesFullNames()

  -- Set the x-axis directions
  !this.setXDire(!this.form.dlXAxis)
  !this.setXDire(!this.form.plXAxis)

  -- Read CE
  !this.getCE()

endmethod
-- End of method definition .init()

------------------------------------------------------------------------
--
-- Method: .setDire(GADGET)
--
-- Description: Set direction gadgets
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDire(!gadget is GADGET)

  !form = !this.form
  -- Initialise variables
  !name = !gadget.name().upCase()

  -- X-axis
  if (!name.eq('DLXAXIS')) then
    -- Set the y-axis
    !this.setYDire(!form.dlYAxis)
    !this.setDire(!form.dlYAxis)
  elseif (!name.eq('PLXAXIS')) then
    if (!gadget.selection().eq('ANGLE')) then
      if (!form.plAngleA.val.unset()) then
        !form.plAngleA.val = 90
      endif
      !form.plYAxis.clear()
      !form.plAngleB.clear()
      !form.plZAxis.clear()
      !form.projTyp = 'ANGLE'
    else
      !this.setYDire(!form.plYAxis)
      !this.setDire(!form.plYAxis)
      !form.projTyp = 'DIRECTION'
    endif
  endif

  -- Y-axis
  if (!name.eq('DLYAXIS')) then

    -- Check for an angle
    if (!form.dlAngleA.val.unset() and !gadget.selection().neq(' ')) then
      !form.dlAngleA.val = 0
    elseif (!gadget.selection().eq(' ')) then
      !form.dlAngleA.clear()
    endif

    -- Set the z-axis
    !this.setZDire(!form.dlZAxis)
    !this.setDire(!form.dlZAxis)

  elseif (!name.eq('PLYAXIS')) then
    if (!form.plAngleA.val.unset() and !gadget.selection().neq(' ')) then
      !form.plAngleA.val = 0
    elseif (!gadget.selection().eq(' ')) then
      !form.plAngleA.clear()
    endif
    !this.setZDire(!form.plZAxis)
    !this.setDire(!form.plZAxis)
  endif

  -- Z-axis
  if (!name.eq('DLZAXIS')) then
    if (!form.dlAngleB.val.unset() and !gadget.selection().neq(' ')) then
      !form.dlAngleB.val = 0
    elseif (!gadget.selection().eq(' ') ) then
      !form.dlAngleB.clear()
    endif
  elseif (!name.eq('PLZAXIS')) then
    if (!form.plAngleB.val.unset() and !gadget.selection().neq(' ')) then
      !form.plAngleB.val = 0
    elseif (!gadget.selection().eq(' ')) then
      !form.plAngleB.clear()
    endif
  endif

  -- AngleA
  if (!name.eq('DLANGLEA')) then
    if (!gadget.val.unset()) then
      !form.dlYAxis.val = 1
    else
      if (!form.dlYAxis.selection().eq(' ')) then
        !form.dlYAxis.val = 2
      endif
    endif
    !this.setZDire(!form.dlZAxis)
  elseif (!name.eq('PLANGLEA')) then
    if (!gadget.val.unset()) then
      !form.plYAxis.val = 1
    else
      if (!form.plXAxis.selection().neq('ANGLE') and !form.plYAxis.selection().eq(' ')) then
        !form.plYAxis.val = 2
      endif
    endif
    !this.setZDire(!form.plZAxis)
  endif

  -- AngleB
  if (!name.eq('DLANGLEB')) then
    !value = !gadget.val
    if (!gadget.val.set()) then
      if (!form.dlYAxis.selection().eq(' ')) then
        !form.dlYAxis.val = 2
        !this.setDire(!form.dlYAxis)
      endif
      if (!form.dlZAxis.selection().eq(' ')) then
        !form.dlZAxis.val = 2
      endif
    else
      !form.dlZAxis.val = 1
    endif
    !gadget.val = !value
  elseif (!name.eq('PLANGLEB')) then
    !value = !gadget.val
    if (!gadget.val.set()) then
      if (!form.plYAxis.selection().eq(' ')) then
        !form.plYAxis.val = 2
        !this.setDire(!form.plYAxis)
      endif
      if (!form.plZAxis.selection().eq(' ')) then
        !form.plZAxis.val = 2
      endif
    else
      !form.plZAxis.val = 1
    endif
    !gadget.val = !value
  endif

  -- Save the direction in form member
  !form.dimeDir = !form.dlXAxis.selection() & | | & !form.dlAngleA.val & | | & !form.dlYAxis.selection() & | | & !form.dlAngleB.val & | | & !form.dlZAxis.selection()
  if (!form.projTyp.eq('ANGLE')) then
    !form.projDir = !form.plAngleA.val.string()
  else
    !form.projDir = !form.plXAxis.selection() & | | & !form.plAngleA.val & | | & !form.plYAxis.selection() & | | & !form.plAngleB.val & | | & !form.plZAxis.selection()
  endif

endmethod
-- End of method definition .setDire(GADGET)

------------------------------------------------------------------------
--
-- Method: .setXDire(GADGET)
--
-- Description: Set the available x-axis directions
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Which gadget is being set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setXDire(!gadget is GADGET)

  -- Set the dimension x-axis direction gadget
  !dtext = !this.full
  !rtext = !this.short

  -- Test for line direction
  if (!gadget.name().upCase().eq('DLXAXIS')) then
    !dtext.append('True')
    !rtext.append('TRUELENGTH')
  else
    !dtext.append('Angle')
    !rtext.append('ANGLE')
  endif

  -- Set the gadget text
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

endmethod
-- End of method definition .setDire(GADGET)

------------------------------------------------------------------------
--
-- Method: .setYDire(GADGET)
--
-- Description: Set the available y-axis directions
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setYDire(!gadget is GADGET)

  -- Initialise variables
  if (!gadget.name().upCase().eq('DLYAXIS')) then
    !dire       = !this.form.dlXAxis.selection()
  else
    !dire       = !this.form.plXAxis.selection()
  endif
  !dtext[1]   = ' '

  -- Set gadget
  !delFrom = -1
  if( !dire inset('N', 'S', 'Y', '-Y') ) then
    !delFrom = 4
  elseif( !dire inset('E', 'W', 'X', '-X') ) then
    !delFrom = 2
  elseif( !dire inset('U', 'D', 'Z', '-Z') ) then
    !delFrom = 6
  elseif (!dire.eq('TRUE')) then
    !gadget.dtext = !dtext
    !this.form.dlAngleA.clear()
  elseif (!dire.eq('ANGLE')) then
    !gadget.dtext = !dtext
  else
    !gadget.dtext = !dtext
    !this.form.dlAngleA.clear()
  endif

  if( !delFrom.gt(0) ) then
    !rtext[1] = ' '
    !dtext.appendArray(!this.full)
    !rtext.appendArray(!this.short)
    !dtext.removeFrom(!delFrom, 2)
    !rtext.removeFrom(!delFrom, 2)
    !gadget.dtext = !dtext
    !gadget.rtext = !rtext
  endif

endmethod
-- End of method definition .setYDire(GADGET)

------------------------------------------------------------------------
--
-- Method: .setZDire(GADGET)
--
-- Description: Set the available z-axis directions
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setZDire(!gadget is GADGET)

  -- Initialise variables
  if (!gadget.name().upCase().eq('DLZAXIS')) then
    !direX      = !this.form.dlXAxis.selection()
    !direY      = !this.form.dlYAxis.selection()
    !gadgetB    = !this.form.dlAngleB
  else
    !direX      = !this.form.plXAxis.selection()
    !direY      = !this.form.plYAxis.selection()
    !gadgetB    = !this.form.plAngleB
  endif
  !dtext[1]   = ' '

  -- Set gadget
  !addFrom = -1
  if( !direX inset( 'N', 'S', 'Y', '-Y' ) ) then
    if( !direY inset( 'E', 'W', 'X', '-X' ) ) then
      !addFrom = 5
    elseif( !direY inset( 'U', 'D', 'Z', '-Z' ) ) then
      !addFrom = 1
    endif
  elseif( !direX inset( 'E', 'W', 'X', '-X' ) ) then
    if( !direY inset( 'N', 'S', 'Y', '-Y' ) ) then
      !addFrom = 5
    elseif( !direY inset( 'U', 'D', 'Z', '-Z' ) ) then
      !addFrom = 3
    endif
  elseif( !direX inset( 'U', 'D', 'Z', '-Z' ) ) then
    if( !direY inset( 'N', 'S', 'Y', '-Y' ) ) then
      !addFrom = 1
    elseif( !direY inset( 'E', 'W', 'X', '-X' ) ) then
      !addFrom = 3
    endif
  endif

  if( !addFrom.gt(0) ) then
    !rtext[1] = ' '
    -- 1-2: E/W/X/-X, 3-4: N/S/Y/-Y, 5-6: U/D/Z/-Z
    !dtext.appendArray( !this.full.from(!addFrom, 2) )
    !rtext.appendArray( !this.short.from(!addFrom, 2) )
    !gadget.dtext = !dtext
    !gadget.rtext = !rtext
  else
    !gadget.dtext = !dtext
    !gadgetB.clear()
  endif

endmethod
-- End of method definition .setZDire(GADGET)

------------------------------------------------------------------------
--
-- Method: .testUnset
--
-- Description: Test real gadgets for unset
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .testUnset()

  if (!this.form.dlAngleA.val.unset()) then
    !this.form.dlAngleA.val = 0
  endif
  if (!this.form.dlAngleB.val.unset()) then
    !this.form.dlAngleB.val = 0
  endif
  if (!this.form.plAngleA.val.unset()) then
    !this.form.plAngleA.val = 0
  endif
  if (!this.form.plAngleB.val.unset()) then
    !this.form.plAngleB.val = 0
  endif

endmethod
-- End of method definition .testUnset()
