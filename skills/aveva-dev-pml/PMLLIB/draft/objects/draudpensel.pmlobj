--   Module:        draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         26 June 2001
--
--
-- Description:
-- User-definable pen selection form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkNumb()                      -                   Check that the entered pen number is within the valid range
--  curSel()                         -                   Identify by cursor
--  dismiss()                        -                   Close the form
--  init()                           -                   The form initialisation
--  oK()                             -                   Pass the selected pen back to the calling form
--  page(STRING)                     -                   Determine view gadget limits for selected element
--
------------------------------------------------------------------------
-- Define object
define object DRAUDPENSEL

  member .form is FORM

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .checkNumb()
--
-- Description: Check the input number
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkNumb()

  -- Test user-definable pen for value range
  if (!this.form.penNo.val.unset() or !this.form.penNo.val.lt(1) or !this.form.penNo.val.gt(40)) then
    !!alert.warning('A User-definable pen must lie between values 1 and 40')
    !this.form.penNo.val = 1
  endif

endmethod
-- End of form definition for .checkNumb()

------------------------------------------------------------------------
--
-- Method:      .curSel()
--
-- Description: Identify by cursor
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .curSel()

  -- Initialise variables
  !ce = !!ce

  -- Id a new stra
  prompt |Select Pen no or linestyle|
  var !elem ID ID TEXP STRA @
   handle (61,528)
    return
   endhandle
  !elemRefe = !elem.dbref()

  -- Get selected pen number
  if (!elemRefe.type.upCase().eq ('STRA')) then
    !texpOrder = !elem.dbref().sequence - 1
    var !texp COLL ALL TEXP WI ORDER EQ $!texpOrder FOR $!elemRefe.owne
    !penNumb = !texp[1].dbref().btex.real()
  else
    !penNumb = !elem.dbref().btex.real()
  endif

  -- Set form gadget
  !this.form.penNo.val = !penNumb

  -- Return to original hierarchy position
  !!ce = !ce

endmethod
-- End of form definition for .curSel()

------------------------------------------------------------------------
--
-- Method:      .dismiss()
--
-- Description: Close the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dismiss()

  hide !!draUdPenSel

endmethod
-- End of form definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: The form initialisation
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Test for existing library sheet
  !librSheet = $_CDRDRAFTAIDS_PENNSEL
  if (!librSheet.badref()) then
    !!alert.error('Undefined Applications library ' & !librSheet & ' - Please contact your System Administrator')
  endif

  -- Add pen sheet to view
  edit view !!draUdPenSel.pens AREA put $!librSheet

  -- Set view limits
  !box[1] = 0
  !box[2] = 400
  !box[3] = 200
  !box[4] = 300
  !this.form.pens.limits = !box

  -- Set default selection
  !this.form.select = 0

endmethod
-- End of form definition for .init()

------------------------------------------------------------------------
--
-- Method:      .oK()
--
-- Description: Pass the selected pen back to the calling form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .oK()

  -- Hide form
  hide !!draUdPenSel

  -- Set form gadget
  !this.form.form.formMethods.setUd(!this.form.penNo.val)

endmethod
-- End of form definition for .oK()

------------------------------------------------------------------------
--
-- Method:      .page(STRING)
--
-- Description: Determine view gadget limits for selected element
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction of page load UP or DOWN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .page(!dir is STRING)

  -- Set next selection
  if (!dir.eq('UP')) then
    !newPos = !this.form.select - 10
  else
    !newPos = !this.form.select + 10
  endif

  if (!newPos.gt(30)) then
    !newPos = 30
  elseif (!newPos.lt(0)) then
    !newPos = 0
  endif

  -- Reset limits
  !box[1] = 0
  !box[2] = 400 - (!newPos * 10)
  !box[3] = 200
  !box[4] = !box[2] - 100
  !this.form.pens.limits = !box

  -- Store new position
  !this.form.select = !newPos

endmethod
-- End of form definition for .page(STRING)
