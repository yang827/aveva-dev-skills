--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draughting(ARRAY)                -                   Constructor running defaults in from the object
--

define object DRAUGHTING

   member .group       is REAL    $* Real number to group the 2d draughting
   member .callback    is STRING  $* Callback executed when button is pressed
   member .icon        is STRING  $* Icon displayed on the button
   member .type        is STRING  $* Code for the type of 2d draughting (eg. CURVES)
   member .description is STRING  $* Tooltip for the button

endobject
-- End of object definition for draughting
------------------------------------------------------------------------
--
-- Method:      draughting
--
-- Description: Constructor running defaults in from the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draughting(!arrayOfValues is ARRAY)

-- initialise variables

   !this.group       = !arrayOfValues[1].real()
   !this.callback    = !arrayOfValues[3]
   !this.icon        = !arrayOfValues[4]
   !this.type        = !arrayOfValues[2].upcase()
   !this.description = !arrayOfValues[2]

endmethod
-- End of method definition for .draughting(ARRAY)
