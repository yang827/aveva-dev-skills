--  createdDate()                    STRING
--  createdDate(STRING)              STRING              set/get the CreatedDate
--  default()                        -                   Default options settings
--  description()                    STRING
--  description(STRING)              STRING              set/get the Description
--  entityAcDbMarker()               BOOLEAN
--  entityAcDbMarker(BOOLEAN)        BOOLEAN             set/get the entityAcDbMarker Flag
--  fontFilePath()                   STRING
--  fontFilePath(STRING)             STRING              set/get the fontFilePath
--  fontMapping()                    BOOLEAN
--  fontMapping(BOOLEAN)             BOOLEAN             set/get the fontMapping Flag
--  function()                       STRING
--  function(STRING)                 STRING              set/get the Function
--  graphicsOnlyDxf()                BOOLEAN
--  graphicsOnlyDxf(BOOLEAN)         BOOLEAN             set/get the graphicsOnlyDxf Flag
--  groupBlocks()                    BOOLEAN
--  groupBlocks(BOOLEAN)             BOOLEAN             set/get the groupBlocks Flag
--  groupDims()                      BOOLEAN
--  groupDims(BOOLEAN)               BOOLEAN             set/get the groupDims Flag
--  groupFrame()                     BOOLEAN
--  groupFrame(BOOLEAN)              BOOLEAN             set/get the groupFrame Flag
--  groupGlab()                      BOOLEAN
--  groupGlab(BOOLEAN)               BOOLEAN             set/get the groupGlab Flag
--  groupNote()                      BOOLEAN
--  groupNote(BOOLEAN)               BOOLEAN             set/get the groupNote Flag
--  groupSlab()                      BOOLEAN
--  groupSlab(BOOLEAN)               BOOLEAN             set/get the groupSlab Flag
--  groupVnot()                      BOOLEAN
--  groupVnot(BOOLEAN)               BOOLEAN             set/get the groupVnot Flag
--  headerFileName()                 STRING
--  headerFileName(STRING)           STRING              set/get the HeaderFileName
--  ignoreBlockRules()               BOOLEAN
--  ignoreBlockRules(BOOLEAN)        BOOLEAN             set/get the ignoreBlockRules Flag
--  ignoreOODerrs()                  BOOLEAN
--  ignoreOODerrs(BOOLEAN)           BOOLEAN             set/get the ignore out-of-date design graphics Flag
--  includeDxfHeader()               BOOLEAN
--  includeDxfHeader(BOOLEAN)        BOOLEAN             set/get the includeDxfHeader Flag
--  includeZCoord()                  BOOLEAN
--  includeZCoord(BOOLEAN)           BOOLEAN             set/get the includeZCoord Flag
--  layerBack()                      BOOLEAN
--  layerBack(BOOLEAN)               BOOLEAN             set/get the layerBack Flag
--  layerLaye()                      BOOLEAN
--  layerLaye(BOOLEAN)               BOOLEAN             set/get the layerLaye Flag
--  layerNote()                      BOOLEAN
--  layerNote(BOOLEAN)               BOOLEAN             set/get the layerNote Flag
--  layerOlay()                      BOOLEAN
--  layerOlay(BOOLEAN)               BOOLEAN             set/get the layerOlay Flag
--  layerSite()                      BOOLEAN
--  layerSite(BOOLEAN)               BOOLEAN             set/get the layerSite Flag
--  layerZone()                      BOOLEAN
--  layerZone(BOOLEAN)               BOOLEAN             set/get the layerZone Flag
--  lineTypeMapping()                BOOLEAN
--  lineTypeMapping(BOOLEAN)         BOOLEAN             set/get the lineTypeMapping Flag
--  load(FILE)                       -                   Load options from system and user files
--  name()                           STRING
--  name(STRING)                     STRING              set/get the Name
--  nestedBlocks()                   BOOLEAN
--  nestedBlocks(BOOLEAN)            BOOLEAN             set/get the nestedBlocks Flag
--  primitiveThick()                 BOOLEAN
--  primitiveThick(BOOLEAN)          BOOLEAN             set/get the primitiveThick Flag
--  queryRules()                     ARRAY               Query Configuration data BlockRules
--  querySwitch()                    ARRAY               Query Configuration data Switches and other members (excluding BlockRules)
--  readDescription(FILE)            STRING              Read Description from specified File - 1st line of file
--  save(FILE)                       -                   Save options settings to %PDMSUSER%
--  scaleFactor()                    REAL
--  scaleFactor(REAL)                REAL                set/get the scaleFactor
--  userAccess()                     BOOLEAN             set/get the overall UserAccess
--  userAdvanced()                   BOOLEAN
--  userAdvanced(BOOLEAN)            BOOLEAN             set/get the UserAdvanced Access
--  userBlocking()                   BOOLEAN
--  userBlocking(BOOLEAN)            BOOLEAN             set/get the UserBlocking Access
--  userGeneral()                    BOOLEAN
--  userGeneral(BOOLEAN)             BOOLEAN             set/get the UserGeneral Access
--  userGrouping()                   BOOLEAN
--  userGrouping(BOOLEAN)            BOOLEAN             set/get the UserGrouping Access
--  userLayering()                   BOOLEAN
--  userLayering(BOOLEAN)            BOOLEAN             set/get the UserLayering access
--  userMapping()                    BOOLEAN
--  userMapping(BOOLEAN)             BOOLEAN             set/get the UserMapping access
--  viewNumberPrefix()               BOOLEAN
--  viewNumberPrefix(BOOLEAN)        BOOLEAN             set/get the viewNumberPrefix Flag
--

--  [name]                   [set/get the Name]
--  [description]            [set/get the description]
--  [primitiveThick]         [set/get the primitiveThickness flag]
--  [viewNumberPrefix]       [set/get the viewNumberPrefix flag]
--  [layerZone]              [set/get the layerZone flag]
--  [layerSite]              [set/get the layerSite flag]
--  [layerBack]              [set/get the layerBack flag]
--  [layerOlay]              [set/get the layerOlay flag]
--  [layerNote]              [set/get the layerNote flag]
--  [layerLaye]              [set/get the layerLaye flag]
--  [fontMapping]            [set/get the fontMapping flag]
--  [lineTypeMapping]        [set/get the lineTypeMapping flag]
--  [colourMapping]          [set/get the colourMapping flag]
--  [includeZCoord]          [set/get the includeZCoordinates flag]
--  [graphicsOnlyDxf]        [set/get the graphicsOnlyDxf flag]
--  [entityAcDbMarker]       [set/get the entityAcDbMarkers flag]
--  [nestedBlocks]           [set/get the nestedBlocks flag]
--  [fontMapping]            [set/get the fontMapping flag]
--  [blockBack]              [set/get the blockBack flag]
--  [blockOlay]              [set/get the blockOlay flag]
--  [blockSymb]              [set/get the blockSymb flag]
--  [blockFill]              [set/get the blockFill flag]
--  [blockGraphicFile]       [set/get the blockGraphicFile flag]
--  [groupDims]              [set/get the groupDims flag]
--  [groupNote]              [set/get the groupNote flag]
--  [groupVnot]              [set/get the groupVnot flag]
--  [groupFrame]             [set/get the groupFrame flag]
--  [groupGlab]              [set/get the groupGlab flag]
--  [groupSlab]              [set/get the groupSlab flag]
--  [groupBlocks]            [set/get the groupBlocks flag]
--  [fontFilePath]           [set/get the fontFilePath setting]
--  [headerFileName]         [set/get the headerFileName setting]
--  [outputFileName]         [set/get the outputFileName setting]
--  [ignoreBlockRules]       [set/get the ignoreBlockRules flag]
--  [scaleFactor]            [set/get the scaleFactor setting]
--  [blockRules]             [set/get the Block Rules]
--  [readDescription]        [Get Description from specified dra-dxf-* file
--
------------------------------------------------------------------------

-- Define object

define object DXFOUT

-- Note:

  member .description      is STRING    $* LICON description
  member .name             is STRING    $* LICON name
  -- member .userAccess       is BOOLEAN   $* restrict user access to settings forms
  member .createdBy        is STRING    $* user who created the config definition
  member .createdDate      is STRING    $* creation date
  member .function         is STRING    $* allows user to categories use of config definition (e.g. 'PIPING' - for use by the piping team members)
  member .userGeneral      is BOOLEAN   $* restrict user access to general settings form
  member .userMapping      is BOOLEAN   $* restrict user access to map settings form
  member .userGrouping     is BOOLEAN   $* restrict user access to group settings form
  member .userBlocking     is BOOLEAN   $* restrict user access to block settings form
  member .userLayering     is BOOLEAN   $* restrict user access to layer settings form
  member .userAdvanced     is BOOLEAN   $* restrict user access to advanced settings form

  -- Loadable Image configuration switch settings

  member .primitiveThick   is BOOLEAN   $* Switch primitiveThickness
  member .pLineWidthFactor is REAL      $* DEPRECATED: do not use (has no effect)
  member .viewNumberPrefix is BOOLEAN
  member .layerZone        is BOOLEAN
  member .layerSite        is BOOLEAN
  member .layerBack        is BOOLEAN
  member .layerOlay        is BOOLEAN
  member .layerNote        is BOOLEAN
  member .layerLaye        is BOOLEAN
  member .fontMapping      is BOOLEAN
  member .lineTypeMapping  is BOOLEAN
  member .colourMapping    is BOOLEAN
  member .includeZCoord    is BOOLEAN  $* Switch includeZCoordinates
  member .graphicsOnlyDxf  is BOOLEAN
  member .entityAcDbMarker is BOOLEAN  $* Switch entityAcDbMarkers
  member .nestedBlocks     is BOOLEAN
  member .blockBack        is BOOLEAN
  member .blockOlay        is BOOLEAN
  member .blockSymb        is BOOLEAN
  member .blockFill        is BOOLEAN
  member .blockGraphicFile is BOOLEAN
  member .groupDims        is BOOLEAN
  member .groupNote        is BOOLEAN
  member .groupVnot        is BOOLEAN
  member .groupFrame       is BOOLEAN
  member .groupGlab        is BOOLEAN
  member .groupSlab        is BOOLEAN
  member .groupBlocks      is BOOLEAN
  member .fontFilePath     is STRING
  member .useShiftJISFonts is BOOLEAN  $* DEPRECATED: do not use (has no effect)
  member .includeDxfHeader is BOOLEAN  $* Switch includeDxfHeaderEntities
  member .headerFileName   is STRING
  member .ignoreBlockRules is BOOLEAN
  member .ignoreOODerrs    is BOOLEAN $* ignore Design Graphics out-of-date errors
  member .scaleFactor      is REAL
  member .outputFileName   is STRING

  -- We need something for Block rules
  member .blockRules       is ARRAY
endobject
-- End of object definition for DXFOUT

------------------------------------------------------------------------
--
-- Method:      !default()
--
-- Description: Default options settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .default()
  -- In-built system default settings - equivalent to full_dxf.mac (Jan 2010)
  -- (used to be equivalent to default_dxf.mac but no longer!!!)
  !this = object DXFOUT()
  -- header details for this object
  !this.description      = 'System Defaults for DXF output'
  !this.name             = 'Default'
  !this.createdBy        = ''
  !this.createdDate      = ''
  !this.function         = 'General Configuration'
  !this.userGeneral      = TRUE $* FALSE
  !this.userMapping      = TRUE $* FALSE
  !this.userGrouping     = TRUE $* FALSE
  !this.userBlocking     = TRUE $* FALSE
  !this.userLayering     = FALSE
  !this.userAdvanced     = TRUE $* FALSE

  -- DXF switches
  !this.primitiveThick   = ON
  --!this.pLineWidthFactor = 0.2; removed for DUN1372
  !this.viewNumberPrefix = TRUE $* OFF
  !this.layerZone        = TRUE $* OFF
  !this.layerSite        = TRUE $* OFF
  !this.layerBack        = TRUE $* OFF
  !this.layerOlay        = TRUE $* OFF
  !this.layerNote        = TRUE $* OFF
  !this.layerLaye        = TRUE $* OFF
  !this.fontMapping      = ON
  !this.lineTypeMapping  = ON
  !this.colourMapping    = ON
  !this.includeZCoord    = OFF
  !this.graphicsOnlyDxf  = OFF
  !this.entityAcDbMarker = TRUE $* OFF
  !this.nestedBlocks     = TRUE $* OFF
  !this.blockBack        = TRUE $* OFF
  !this.blockOlay        = ON
  !this.blockSymb        = TRUE $* OFF
  !this.blockFill        = ON
  !this.blockGraphicFile = TRUE $* OFF
  !this.groupDims        = TRUE $* OFF
  !this.groupNote        = TRUE $* OFF
  !this.groupVnot        = TRUE $* OFF
  !this.groupFrame       = TRUE $* OFF
  !this.groupGlab        = TRUE $* OFF
  !this.groupSlab        = TRUE $* OFF
  !this.groupBlocks      = OFF
  !this.fontFilePath     = 'OFF'
  --!this.useShiftJISFonts = OFF; removed for unicode
  !this.includeDxfHeader = OFF
  !this.headerFileName   = '%PDMSEXE%/draft_dxf_li.dxf'
  !this.outputFileName   = '%PDMSUSER%/output.dxf' $* ''
  !this.ignoreBlockRules = FALSE $* ON
  !this.ignoreOODerrs    = FALSE
  !this.scaleFactor      = 1.0
  !this.blockRules       = ARRAY()
  !this.blockRules.append( |all hvac, INCLUDE name| )
  !this.blockRules.append( |all rest, INCLUDE name| )
  !this.blockRules.append( |all pipe, INCLUDE name| )
  !this.blockRules.append( |all equi, INCLUDE name| )
  !this.blockRules.append( |all stru, INCLUDE name| )

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------
define method .load( !file is FILE)

  -- set the default values
  !this.default()

  !!messageFile.prompt( 144, 2 )
  -- Don't use FILE object to read and execute file - $M is much faster !!
----  !file.open('READ')
----    if( !file.isOpen() ) then
----      -- load file
----       !fileContents = !file.readFile()
----       do !pmlCode values !fileContents
----       -- execute pml code
----       if( !pmlCode.match('--') eq 0 ) then
----         -- $P $!<pmlCode>
----         $!<pmlCode>
----         handle (2,759)
----           -- Unexpected member - ignore
----         endhandle
----       endif
---- --      handle any
---- --        !!alert.warning( !!error.text )
---- --        break
---- --      endhandle
----       enddo
----      !file.close()
----    endif

  -- create a temporary global variable to store the data
  if (defined(!!tmpDxfOut)) then
    !!tmpDxfOut.delete()
  endif
  !!tmpDxfOut = object DXFOUT()

  -- load the data
  !localName = !file.fullName()
  -- Continue if error so if the customer has files with deprecated switches,
  --  at least it will still load- error will still be reported though (can't handle
  --  as handling will happen at the end of the child macro)
  onerror continue
  $m "$!<localName>"
  handle any
    -- Error - DXF data file corrupt
    !!messageFile.error(144,501, !file.fullName())
  endhandle
  onerror return
  -- Copy object from Temporary global variable and delete it
  !this = !!tmpDxfOut
  !!tmpDxfOut.delete()

  -- Remove prompt
  !!prompt(0)

endmethod
-- End of method definition for .load( FILE)

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .save( !file is FILE)

  !!messageFile.prompt( 144, 3 )

  -- initialise array to contain strings for ConfigData file
  -- Description must be 2nd line of file
  !saveContents = ARRAY()
  -- *** Not in file ***  !saveContents.append( '!!tmpDxfOut = object DXFOUT()' )
  !value = !this.description(STRING())
  !saveContents.append( '!!tmpDxfOut.description      = ' + |'| + !value + |'| )

  !members = !this.attributes()
  --          1234567890123456
  !spaces  = '                '

  do !string values !members
    !value.delete()
    !value   = !this.attribute(!string)
    !objectType = !value.objectType()

    -- Required in case we add new members with no corresponding entry in existing configurations
    --if( !value.unset() ) then
    --  skip              Commented out as we may not need this and it requires testing
    --endif

    !record = '!!tmpDxfOut.' + !string + $
              !spaces.subString( !string.length() + 1 ) + ' = '

    if( !string.upcase() eq 'DESCRIPTION' ) then
      -- Already done

    elseif( !objectType eq 'STRING' ) then
      !saveContents.append( !record + |'| + !value + |'| )

    elseif( !objectType eq 'REAL' or !objectType eq 'BOOLEAN' ) then
      !saveContents.append( !record + !value.string() )

    elseif( !objectType eq 'ARRAY' ) then
      -- Config Block Rules
      -- Append lines to file in the form '!!tmpDxfOut.blockRules.append( rule text )'
      !saveContents.append( '!!tmpDxfOut.blockRules = ARRAY()' )
      !record = '!!tmpDxfOut.blockRules.append( |'
      !recend = '| )'
      !eval = object BLOCK( $
         '!saveContents.append( !record  + !this.blockRules[!evalIndex] + !recend )' )
      !this.blockRules.evaluate( !eval )
    endif
  enddo

  !file.writeFile('OVERWRITE', !saveContents)

  !!prompt(0)

endmethod
-- End of method definition for .save( FILE)

------------------------------------------------------------------------
--
-- Method: !config()
--
-- Description: Load ConfigData into DRAFT
--
-- Method Type: Procedure
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .config()

  !!messageFile.prompt( 144, 507 )

  !ignoreString  = 'NAME DESCRIPTION CREATEDBY CREATEDDATE FUNCTION ' + $
                   'OUTPUTFILENAME'
  !ignoreBoolean = 'USERMAPPING USERGENERAL USERGROUPING ' + $
                   'USERBLOCKING USERLAYERING USERADVANCED'

-- Each of the 4 keywords in the following string must be 24 characters
-- long (including its trailing spaces) - else .subString method will
-- generate the wrong replacement text.
  !longBoolean   = 'PRIMITIVETHICKNESS      ' + $
                   'INCLUDEZCOORDINATES     ' + $
                   'ENTITYACDBMARKERS       ' + $
                   'INCLUDEDXFHEADERENTITIES'

  -- Convert DXFOUT object to DLICON commands
  !members = !this.attributes()

  !commands = ARRAY()
  !commands.append( 'DLICON /' + !this.name(STRING()) )

  !value = ''
  do !string values !members
    !value.delete()
    !value   = !this.attribute(!string)
    !objectType = !value.objectType()

    -- Required in case we have members with no corresponding entry in existing configurations
    if( !value.unset() ) then
      skip
    endif

    if( !objectType eq 'STRING' ) then
      if( !ignoreString.match(!string.upcase()) eq 0 ) then
        !commands.append( 'SWITCH ' + !string + | '| + !value + |'| )
      endif

    elseif( !objectType eq 'REAL' ) then
        !commands.append( 'SWITCH ' + !string + $
                                | '| + !value.string() + |'| )

    elseif( !objectType eq 'ARRAY' ) then
      -- Config Block Rules
      -- Append lines to array of the form 'BLOCK rule text'
      !record = 'BLOCK '
      !eval = object BLOCK( $
         '!commands.append( !record  + !this.blockRules[!evalIndex])' )
      !this.blockRules.evaluate( !eval )

    elseif( !objectType eq 'BOOLEAN' ) then
      !onOff = 'OFF'
      if(!value.unset().not() and !value ) then
        !onOff = 'ON'
      endif

      if( !ignoreBoolean.match(!string.upcase()) gt 0 ) then
        -- Ignore
      elseif( !longBoolean.match(!string.upcase()) gt 0 ) then
        -- we have to output a keyword which is longer than the sub-17
        -- character member name
        !index = !longBoolean.match(!string.upcase())
        !newString = !longBoolean.subString( !index , 24 ).trim()
        !commands.append( 'SWITCH ' + !newString + | '$!onOff'| )
      else
        !commands.append( 'SWITCH ' + !string + | '$!onOff'| )
      endif
    endif
  enddo
  !commands.append( 'EXIT' )

  -- Load DLICON commands into DRAFT
  do !line values !commands
    -- *** COMMAND LINE SYNTAX ***
    -- $P $!line
    $!<line>
  enddo

  !!prompt(0)

endmethod
-- End of method definition for .config()

------------------------------------------------------------------------
--
-- Method: !querySwitch()
--
-- Description: Query Configuration data Switches and other members (excluding BlockRules)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--  ARRAY of STRINGS   Display format for Members (impossible to re-input)
--
-- *** contains OLD-STYLE PML1 CODE ***
--
------------------------------------------------------------------------
define method .querySwitch() is ARRAY

  !ignoreString  = 'FUNCTION OUTPUTFILENAME'

  -- Convert DXFOUT object to DLICON commands
  !members = !this.attributes()

  !returnArray = ARRAY()

  !value = ''
  do !string values !members
    !value.delete()
    !value   = !this.attribute(!string)
    !objectType = !value.objectType()
    !display = !string

    -- Ignore this object attribute 'USESHIFTJISFONTS' as this has been deprecated
    skip if (!string.eq('USESHIFTJISFONTS'))

    -- Required in case we add new members with no corresponding entry in existing configurations
    --if( !value.unset() ) then
    --  skip            Commented out as we may not need this and it requires testing
    --endif

    if( !objectType eq 'STRING' ) then
      -- Test for NAME explicitly, since it may be falsely ignored
      if( !string eq 'NAME' ) then
        var !aa COMPOSE |$!display| WIDTH 20 |$!value|
      elseif( !ignoreString.match(!string.upcase()) eq 0 ) then
        var !aa COMPOSE |$!display| WIDTH 20 |$!value|
      else
        !aa = object ARRAY()
      endif

    elseif( !objectType eq 'REAL' ) then
      !valString = !value.string(!!realFmt)
       var !aa COMPOSE |$!display| WIDTH 20 |$!valString|

    elseif( !objectType eq 'BOOLEAN' ) then
      if( !string eq 'GRAPHICSONLYDXF' ) then
        !display = 'AUTOCADR12'
      -- elseif( !string.match( 'USERACCESS' ) gt 0 ) then
      --  !display = 'ACCESSUSER'
      elseif( !string.match('USER') gt 0 ) then
        !display = 'ACCESS' + !string.subString(5)
      endif

      if(!value.unset().not() and !value ) then
        var !aa COMPOSE |$!display| WIDTH 20 'ON'
      else
        var !aa COMPOSE |$!display| WIDTH 20 'OFF'
      endif

    elseif( !objectType eq 'ARRAY' ) then
      -- Ignore - do later
      !aa = object ARRAY()
    endif

    if( !aa.size() gt 0 ) then
      !returnArray.append( !aa[1] )
    endif
  enddo

  -- Sort list
  !returnArray.sort()

  return !returnArray

endmethod
-- End of method definition for .querySwitch() ARRAY

------------------------------------------------------------------------
--
-- Method: !queryRules()
--
-- Description: Query Configuration data BlockRules
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--  ARRAY of STRINGS   Display format for BlockRules
--
-- *** contains OLD-STYLE PML1 CODE ***
--
------------------------------------------------------------------------
define method .queryRules() is ARRAY

  !returnArray = ARRAY()

  -- Config Block Rules
  -- Append lines to array of the form 'BLOCK rule text'

  if( !this.blockRules.size() gt 0 ) then
    !record = 'BLOCK '
    !eval = object BLOCK( $
         '!returnArray.append( !record  + !this.blockRules[!evalIndex])' )
    !this.blockRules.evaluate( !eval )
  endif

  return !returnArray

endmethod
-- End of method definition for .queryRules() ARRAY

------------------------------------------------------------------------
--
-- Method: !blockRules()
--
-- Description: set/get the Block rules
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [ARRAY] [values for Block rules]
-- Return:
--   [ARRAY] [value of the Block rules]
--
------------------------------------------------------------------------

define method .blockRules(!value is ARRAY) is ARRAY

  if (!value.unset()) then
    !returnValue = !this.blockRules

  else
    -- set the Block rules
    !this.blockRules = !value

    !returnValue = !value
  endif

  return !returnValue
endmethod
-- End of method definition for .blockRules(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method: !blockRules()
--
-- Description: get the Block rules
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [ARRAY] [value of the Block rules]
------------------------------------------------------------------------
define method .blockRules() is ARRAY
  return !this.blockRules
endmethod
-- End of method definition for .blockRules() ARRAY

------------------------------------------------------------------------
--
-- Method:      !name()
--
