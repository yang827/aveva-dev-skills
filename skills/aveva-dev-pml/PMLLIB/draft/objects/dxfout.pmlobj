--  blockOlay(BOOLEAN)               BOOLEAN             set/get the blockOlay Flag
--  blockRules()                     ARRAY               get the Block rules
--  blockRules(ARRAY)                ARRAY               set/get the Block rules
--  blockSymb()                      BOOLEAN
--  blockSymb(BOOLEAN)               BOOLEAN             set/get the blockSymb Flag
--  colourMapping()                  BOOLEAN
--  colourMapping(BOOLEAN)           BOOLEAN             set/get the colourMapping Flag
--  config()                         -                   Load ConfigData into DRAFT
--  createdBy()                      STRING
