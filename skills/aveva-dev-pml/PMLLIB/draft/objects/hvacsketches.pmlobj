--
-- File:            hvacsketches.pmlobj
--   Type:          Object Definition
--   Group:         Document production
--     Keyword:     HVAC Sketches
--   Module:        DRAFT
--
-- Author:          Steve Bentley
-- Created:         2005/02/28
--
-- Description: Main object to be used to create HVAC sketches
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Method called on Apply of the form to do the actual work
--  closeLog()                       -                   Close the log file
--  copyDrawingFrom(STRING)          -                   Create new drawing by copying DRWG or DRTMPL
--  copySheetFrom(STRING)            -                   Create new sheet by copying DRWG (was in MTEMPLATE)
--  createElement(STRING,STRING,STRING) -                   Method to create the new element (like DRA CLIB ICREATE)
--  createTable(DBREF,STRING,REAL,ARRAY,STRING) STRING
--  dimensionLayer(ARRAY)            -
--  dimensionViews()                 -                   Dimension all views
--  emptyBendingPlanes()             -                   Empty the bending Plane Arrays
--  emptyLogData()                   -                   Empty the log Data array
--  flattenedDirection(DBREF,REAL,DBREF,REAL) STRING              Flatten the direction between 2 points onto the view plane for a true dimension
--  getAllTables(DBREF,STRING)       -
--  getAssemblyTable()               ARRAY               Get assembly table
--  getBendingPlanes(DBREF,REAL)     -                   Fill the Bending Plane Members for Spool
--  getEndPointTable()               ARRAY               Get end point table
--  getEndPointTags()                ARRAY               Get end points to be tagged
--  getMtoTable()                    ARRAY               Get MTO table
--  getQuadrantAngle(DBREF)          STRING              Get the rotation Angle in Quadrant
--  globalInstance()                 -                   global Instance
--  makeSketch(DBREF)                -                   Do the work to make the actual sketch
--  openLog()                        -                   Open the log file
--  readAssemblyHeadings(DBREF)      ARRAY               Read the Assembly heading from the Backing sheet
--  readMtoHeadings(DBREF)           ARRAY               Read the MTO heading from the Backing sheet
--  tagLayer(ARRAY)                  -
--  tagLayerEndPoints()              -                   Tag each view in the DIMA layer with end points
--  tagViews()                       -                   Dimension all views
--  tagViewsEndPoints()              -                   Tag all views with end point tags
--  writeLog()                       -                   Write to the log file
--
define object HVACSKETCHES

  -- Form Members
  -- mtoTags is an ARRAY of DBREFS used throughout for MTO tags
  -- mtoHeadings is an ARRAY of STRINGS
  -- logData is an ARRAY of STRINGS
  member .type             is STRING
  member .hvacSpool        is DBREF
  member .createIn         is DBREF
  member .selectedTemplate is DBREF
  member .drawingPrefix    is STRING
  member .sheetPrefix      is STRING
  member .drawing          is DBREF
  member .sheet            is DBREF
  member .backingSheet     is DBREF
  member .mtoHeadings      is ARRAY
  member .assemblyHeadings is ARRAY
  member .logFile          is FILE
  member .logData          is ARRAY
  member .mtoTags          is ARRAY
  member .rotationElements     is ARRAY
  member .rotationPlanes       is ARRAY
  member .rotationPlaneNumbers is ARRAY
  member .quadrantPlanes       is ARRAY
  member .hasBendPlane         is BOOLEAN

endobject
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Method called on Apply of the form to do the actual work
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !memory = !!ce

  -- We need to load the Common formats object if not in graphics mode (for TTY batch processing
  var !device device
  if (!device.lowcase() neq 'graphics') then
    !!comDefineGlobal(object comFormats())
  endif

  -- Navigate to the registry to create the drawings in
  !!ce = !this.createIn
  handle ANY
    !!hvacSketchesLog('ERROR - Registry to create drawings in is not recognised ')
    return
  elsehandle NONE
    -- Test the registry is r/w
    if (!!ce.type eq 'REGI' and !!ce.dbwrite ) then
      -- OK
    else
      !!hvacSketchesLog('ERROR - Must be a r/w registry(REGI) element')
      return
    endif
  endhandle

  -- Create the new drawing
  if (!this.type.lowcase() eq 'drawing') then
    -- Create the actual new element
    !this.createElement(!this.drawingPrefix, 'DRWG', 'ce')
    handle ANY
      !!hvacSketchesLog('Error creating new Drawing ')
      return
    endhandle
    if (!this.selectedTemplate.type eq 'DRWG') then
       !this.copyDrawingFrom('drawing')
    elseif (!this.selectedTemplate.type eq 'DRTMPL') then
      !this.copyDrawingFrom('drtmpl')
    endif
  endif

  -- Navigate to the new drawing
  DRWG
  !drawing = !!ce

  -- Record this stage in the log
  !!hvacSketchesLog('New Drawing ' & !drawing.fullName & ' created')

  -- Do the actual work to make this into a HVAC sketch
  !this.makeSketch(!drawing)

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      copyDrawingFrom
--
-- Description: Create new drawing by copying DRWG or DRTMPL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      key word 'DRAWING' or 'DRTMPL' (Type of template)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyDrawingFrom(!templateType is STRING)

  !memory = !!ce

  -- Copy drawing from which template
  !template = !this.selectedTemplate
  !templateName = !template.name

  -- First check we are in the correct DB type
  if (!!ce.dbtype neq 'PADD') then
    switch
  endif

  -- This assumes the template is named
  -- We are at the drawing to be copied like template...
  !newDrawing = !!ce
  !newDrawingName = !newDrawing.name

  -- Record the author and date because we want to retain these
  !author = !!ce.author
  !date = !!ce.date

  -- Do the copying
  if (!templateType.lowcase() eq 'drawing') then
    !command = 'COPY ' & !templateName & ' RENAME ' & !templateName & ' ' & !newDrawingName
  else
    !command = 'BSRF unset COPY LIKE ' & !templateName & ' RENAME ' & !templateName & ' ' & !newDrawingName
  endif
  $!command
  handle ANY
    -- error occurred using copy or copy like
  endhandle

  -- Set author back to real author and date not template's author
  !!ce.author = !author
  !!ce.date = !date
  update anno

  -- For a copied DRTMPL element
  -- This bit has been copied from the abaDrawing pml object
  -- Copy and rename all the members of the template into the new drawing because copy like does not do this.
  if (!templateType.lowcase() eq 'drtmpl') then

    LINKREF $!templateName
    SPPURPOSE unset

    -- Cycle round the members of the drawing template make copies and rename
    do !member values !template.members
      -- Initialise variables
      !memberType = !member.type
      !memberName = !member.flnn
      if (!memberType.eq('SHTMPL')) then
        -- Do not do anything yet till the next do loop
      else
        -- its not the sheet template
        if (!memberName.match(!templateName).gt(0)) then
          !newName = !newDrawingName & !memberName.after(!templateName)
        else
          !newName = ' '
        endif
        if (!memberType eq 'LIBY') then
          NEW LIBY $!newDrawingName/LIBY
          COPY MEMBERS OF $!member rename $!templateName $!newDrawingName
        else
          NEW $!memberType $!newName COPY $!member RENAME $!templateName $!newDrawingName
          handle (64,503)
            -- Picture needs to be loaded
            !loadElem = !!error.text.after(') ').before(': Picture')
            LOAD $!loadElem
            handle ANY
            endhandle
          endhandle
        endif
      endif
    enddo

    -- Do again
    do !member values !template.members
      -- Initialise variables
      !memberType = !member.type
      !memberName = !member.flnn
      if (!memberType.eq('SHTMPL')) then
        -- Just change the selected template to be this shtmpl and run the .copySheetFrom('shtmpl') method
        !this.selectedTemplate = !member
        -- Create the actual new element
        !this.createElement(!this.sheetPrefix, 'SHEE', 'ce')
        !this.copySheetFrom('shtmpl')
        !this.selectedTemplate = !template
      endif
    enddo
    DRWG

  endif

  -- For a copied DRWG element
  if (!templateType.lowcase() eq 'drawing') then
    -- set the idln to point to the drwgs default idlist
    -- This relies on names being adhered to (This is a Draft dependency on expected naming)
    IDLN $!newDrawingName/DRAWLIST/DRWG
    handle ANY
    endhandle
    var !idlname IDLN

    -- drwg may contain sheets
    -- goto each sheet and cascade drwgs new idln to each sheet....
    var !numberSheets MEM SHEE COUNT
    do !i to $!numberSheets
      SHEET $!i
      IDLN $!idlname
      handle ANY
      endhandle
      !newSheetName = !!ce.name
    enddo
  endif

  -- Navigate back to the new drawing
  !!ce = !newDrawing

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      copySheetFrom
--
-- Description: Create new sheet by copying DRWG (was in MTEMPLATE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word can be 'SHEET' or 'SHTMPL' (Type of template)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copySheetFrom(!templateType is STRING)

  !memory = !!ce

  -- Copy sheet from which template
  !template = !this.selectedTemplate
  !templateName = !template.name

  -- This assumes the template is named.
  !newSheet = !!ce
  !newSheetName = !!ce.name
  if (!templateType.lowcase() eq 'sheet') then
    !command = 'COPY ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
  else
    !command = 'BSRF unset COPY LIKE ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
  endif
  $!command
  handle ANY
    -- error occurred using copy or copy like
  endhandle

  -- Specific requirements if using the SHTMPL as the template origin
  if (!templateType.lowcase() eq 'shtmpl') then
    LINKREF $!templateName
    SPPURPOSE unset
    BSRF BSRF OF $!templateName
    handle ANY
      !!hvacSketchesLog('Unable to Set Template Backing Sheet for $!template - See Your System Administrator')
    endhandle
    -- Now copy all members of the sheet
    !command = 'COPY MEMBERS OF ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
    $!command

    SHEET
    -- For all ABA templates we want to unset the SPPURP
    var !allWithABAT collect all with (SPPURP eq 'ABAT') for ce
    do !i indices !allWithABAT
      !!ce = !allWithABAT[!i].dbref()
      SPPURPOSE unset
    enddo
    SHEET

  endif

  -- Navigate to owning DRWG and set sheets IDLN to DRWGS IDLN
  DRWG
  !drawingName = !!ce.name
  var !idlname IDLN

  -- Go to the template name and capture the IDLN of all of the VIEWS

  -- return to sheet
  !!ce = !newSheet
  IDLN $!idlname
  handle ANY
  endhandle

  -- sheet may contain views....
  -- goto each view and cascade sheets new idln to all views....
  var !views MEM VIEW COUNT
  do !i to $!views
    VIEW $!i
    !viewName = !!ce.name
    $!drawingName/LIBY
    handle ANY
      -- this might not exist
    elsehandle NONE
      NEW PLLB
      name $!viewName/PLANES
      handle (41,12)
        DELETE PLLB
      endhandle
    endhandle
    !!ce = !newSheet
  enddo

  -- We now have a copy of the drawing and all its members so now we need to go and reassign references,
  -- such as refs for tagrules etc, because in the DRTMPL situation, the library is not copied with
  -- the drawing it may be a separate library stored anywhere in the database.

  DRWG

  var !library coll all liby for ce
  var !allViews coll all view for ce

  do !view val !allViews

    -- Initialise variables
    !viewElement = !view.dbref()
    -- Set idln
    !!ce = !viewElement
    !idliOrder = !viewElement.idln.order
    !tempDllb = !viewElement.idln.owne
    !tempLiby = !viewElement.idln.owne.owne
    var !allDllbs coll all dllb for $!tempLiby
    var !allTrlbs coll all trlb for $!tempLiby
    var !allLayers coll all laye for $!viewElement

    -- 1. Find the number of the dllb that owns the referenced idln
    do !index index !allDllbs
      if (!allDllbs[!index].eq(!tempDllb.string())) then
        !dllbOrder = !index
        break
      endif
    enddo
    -- Set idln
    !!ce = !viewElement
    IDLN IDLI $!idliOrder OF DLLB $!dllbOrder OF $!library[1]
    handle ANY
      -- May not be any libraries
    endhandle

    -- 2. Re-assign all tagruleset to that of the local trst and not the template trst
    -- but set a link reference to the template trst
    do !laye val !allLayers

      -- Initialise variables
      !layerElement = !laye.dbref()
      !tempTrst = !layerElement.trsf

      -- For any tagruleset reference
      if (!tempTrst.badref().not()) then

        -- Get trsf data
        !trstOrder = !layerElement.trsf.order
        !tempTrlb = !layerElement.trsf.owne
        var !tempTagrules coll all tagr for $!tempTrst

        -- Find the number of the trlb that owns the referenced trst
        do !index index !allTrlbs
          if (!allTrlbs[!index].eq(!tempTrlb.string())) then
            !trlbOrder = !index
            break
          endif
        enddo

        -- Set tagruleset
        !!ce = !layerElement
        TRSF TRST $!trstOrder OF TRLB $!trlbOrder OF $!library[1]
        handle ANY
          -- May not be any libraries
        endhandle

        -- Run round all of the tagrules and set a link reference to the template ones
        !trst = !layerElement.trsf
        var !allTagrules coll all tagr for $!trst

        do !index ind !allTagrules
          !!ce = !allTagrules[!index].dbref()
          LINKREF $!tempTagrules[$!index]
          handle ANY
            -- May not be possible
          endhandle
        enddo
      endif
    enddo
  enddo

  -- Position at the drawing.
  DRWG
  -- For all ABA templates we want to unset the SPPURP
  var !allWithABAT collect all with (SPPURP eq 'ABAT') for ce
  do !i indices !allWithABAT
    !!ce = !allWithABAT[!i].dbref()
    SPPURPOSE unset
  enddo
  DRWG

  -- Navigate back to the new drawing
  !!ce = !newSheet

  !!ce = !memory

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createElement
--
-- Description: Method to create the new element (like DRA CLIB ICREATE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      The prefix for the new element
--    2    R      STRING      The type of the new element
--    3    R      STRING      Where to create the new element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createElement(!prefix is STRING, !elementType is STRING, !where is STRING)

  -- This method only works when !where is 'ce'
  if (!where.lowcase() eq 'ce') then

    -- First check we are in the correct DB type
    if (!!ce.dbtype neq 'PADD') then
      switch
    endif

    -- Test we can write to this element
    if (!!ce.dbwrite.not()) then
      !!hvacSketchesLog('Cannot create ' & !elementType.upcase() & ' here: Read Only Database')
      return error 1 noalert
    endif

    -- So what if we at a valid element but cannot create a new element because of DAC or claim or RO reasons

    -- Create the new element
    !command = 'NEW ' & !elementType
    $!command
    handle ANY
      !!hvacSketchesLog('Cannot create ' & !elementType.upcase() & ' here: ' & !!error.text)
      handle ANY
        -- In case concatenated text is too long
        !!hvacSketchesLog(!!error.text.after(')'))
      endhandle
      return error 1 noalert
    endhandle

    -- Assume a set star style concatenated name
    !owner = !!ce.owner
    if (!owner.isNamed) then
      !ownerName = !owner.name.after('/') & '/'
    else
      !ownerName = ''
    endif

   -- Formulate the name
   do !i
     if (!this.hvacSpool.isNamed) then
       !newName = '/' & !this.hvacSpool.namn & '/' & !prefix & !i
     else
       !newName = '/Spool' & !this.hvacSpool.namn.after('=') & '/' & !prefix & !i
     endif
     !unusedTestNameDefault = object DBREF(!newName)
     handle ANY
       -- name not used
       !command = 'NAME ' & !newName
       $!command
       break
     elsehandle NONE
       -- name already exists, stay in loop
     endhandle
   enddo

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      makeSketch
--
-- Description: Do the work to make the actual sketch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makeSketch(!drawing is DBREF)

  !memory = !!ce

  -- Navigate to the element
  !!ce = !drawing

  -- Set a new title for the drawing
  TITLE 'HVAC Sketch - Spool $!this.hvacSpool.namn'

  -- Record this new drawing as a member of this object
  !this.drawing = !!ce

  SHEE 1
  handle ANY
    !!hvacSketchesLog(|Drawing does not have a sheet|)
    return
  endhandle
  -- Set a new title for the sheet
  TITLE '$!this.hvacSpool.namn'
  -- Record this new drawing as a member of this object
  !this.sheet = !!ce

  -- Record the Backing Sheet
  !this.backingSheet = !!ce.bsrf

  -- Get the mto headings from the backing sheet
  !backingSheet = !this.backingSheet.name
  handle ANY
    !!hvacSketchesLog('ERROR - Cannot create sketch because : Backing Sheet not found')
    return
  endhandle

  -- Collect the table entry notes from the backing sheet
  var !cells collect all note with (SPPURP eq 'CELLS' and FUNC eq 'MTO') for $!backingSheet

  -- Record the MTO headings
  !this.mtoHeadings = !this.readMtoHeadings(!cells[1].dbref())
  handle ANY
  endhandle

  -- Collect the table entry notes from the backing sheet
  var !cells collect all note with (SPPURP eq 'CELLS' and FUNC eq 'ASSEMBLY') for $!backingSheet

  -- Record the Assembly headings
  !this.assemblyHeadings = !this.readAssemblyHeadings(!cells[1].dbref())
  handle ANY
  endhandle

  -- Core HVAC Spool Manager object
  !hvacSpoolManager = object HVACSPOOLMANAGER()
  -- Elements for all MTO tags
  !this.mtoTags = !hvacSpoolManager.getMtoElementsForSpool(!this.hvacSpool)
  -- Remove any implied tube here ????????
  do !i indices !this.mtoTags
    if (!this.mtoTags[!i].type eq 'TUBI') then
      !!hvacSketchesLog('ERROR - Implied should not be present in HVAC Spools' & !this.mtoTags[!i].ref )
      !this.mtoTags[!i].delete()
    endif
  enddo
  -- Compress the array now implied tubes have been removed
  !this.mtoTags.compress()

  !sheet = !!ce

  -- Get all the tables of information
  !!hvacSketchesLog('Getting all Tables')
  !this.getAllTables(!sheet, 'ALL')

  !!ce = !sheet

   --set the correct MARPTY only in marine drafting
   !moduleObject = object MODULE()
   if (!moduleObject.appkey.eq('mardra')) then
     !!setmarptype(!sheet, 29)
   endif

   -- Collect all views
   !smallestScale = 1
   var !views collect all view for ce
   --Add the HVAC spool to the view and autoscale it
   do !i indices !views
     !view = !views[!i].dbref()
     -- PSKTCH for Pipe Spools is also PSKTCH (not HSKTCH) for HVAC Spools
     if (!view.sppurp.eq('PSKTCH').not()) then
       !!hvacSketchesLog('ERROR - Views must have specific purpose (SPPURP) of PSKTCH')
     endif
     !!ce = !view

     -- Capture the idList of the current drawing
     !!ce = !view.idln
     new adde
     idname $!this.hvacSpool
     !!ce = !view
     lfra FALSE
     auto
     handle ANY
       !!hvacSketchesLog('Unable to auto HVAC Spool - probably a bad definition')
     endhandle
     -- To ensure all views are the same scale
     !viewScale = !!ce.vscale
     if (!viewScale lt !smallestScale) then
       !smallestScale = !viewScale
     endif
     -- To ensure all views are the same through point
     if (!i eq 1) then
       !throughPosition = THPOS
       !throughPoint = !throughPosition.string().before('WRT')
      else
        THPOS $!throughPoint
      endif
   enddo
   -- Set all the views to the same scale
   do !i indices !views
     !view = !views[!i].dbref()
     !!ce = !view
      vscale $!smallestScale
      update design
     handle ANY
       !!hvacSketchesLog('Unable to update Design the view of the HVAC Spool - probably a bad definition')
     endhandle
   enddo

  -- Do the dimensioning
  !!hvacSketchesLog('Dimensioning views')
  !this.dimensionViews()

  -- Do the tagging of end points
  !!hvacSketchesLog('Tagging End Points in views')
  !this.tagViewsEndPoints()

  -- Do the tagging of component numbers (Put this tag last will arrange all tags)
  !!hvacSketchesLog('Tagging MTO in views')
  !this.tagViews()

  -- Update BkSheet (Matts on behalf of Dragos Patilea)
  !!ce = !sheet
  UPDATE BSHEETS

  -- Navigate to Drawing
  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      createTable
--
-- Description: Create at a table
--
-- Method Type: Function/Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Sheet
--    2    R     STRING      Type of Table ('MTO', 'ASSEMBLY')
--    3    R     REAL        The length of the table so a second Table can continue at the XY position of the bottom of the table
--    4    R     ARRAY       Array to be put in the cells of the table
--    5    R     STRING      Position as a string 'x100mm y100mm' or key word 'BackingSheetPosition'
-- Return:
--   [Data Type] [Description]
--     STRING   End Position of the table in XY coordinates as a string
--
------------------------------------------------------------------------
define method .createTable(!passedSheet is DBREF, !tableType is STRING, !hvacPieceCount is REAL, !passedArray is ARRAY, !position is STRING ) is STRING

  !memory = !!ce
  !result = 'BackingSheetPosition'

  -- Use the 2 passed dimensional array
  !cell = ARRAY()
  !cell = !passedArray

  -- Navigate to sheet
  !!ce = !passedSheet
  setstar
  tail
  !sheet = !passedSheet.name
  !backingSheet = !!ce.bsrf.name

  -- Collect the table entry notes from the backing sheet
  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet
  var !cells collect all note with (SPPURP eq 'CELLS' and FUNC eq !tableType) for $!backingSheet

  -- Get the name of the note
  !cellsName = !cells[1].dbref().name
  !tableName = !table[1].dbref().name

  -- Get the direction of the build from the STRA element in the table note.
  !straElement = !tableName & '/ColumnLine1'
  if (!straElement.dbref().adeg eq 90) then
    !buildDirection = 'Y'
  else
    !buildDirection = 'Y -'
  endif

  -- Copy the table notes from the backing sheet (copy like will not copy the table notes, we'll copy these as required)
  new note */$!tableType$n.table$!hvacPieceCount copy $!tableName rename $!tableName */$!tableType$n.table$!hvacPieceCount
  !newTableName = !!ce.name
  lvis TRUE
  if (!position neq 'BackingSheetPosition') then
      xypos $!position
  endif
  new note */$!tableType$n.tableEntries$!hvacPieceCount copy like $!cellsName
  var !xypos (xypos of $!cellsName )
  xypos $!xypos
  lvis true
  if (!position neq 'BackingSheetPosition') then
      xypos $!position
  endif
  setstar

  -- Count the TEXP's named /Column because there may be extra texps in there
  !numberOfColumns = 0
  do !i indices !cells[1].dbref().members
    if (!cells[1].dbref().members[!i].type eq 'TEXP' and !cells[1].dbref().members[!i].name.match('/Column').gt(0)) then
      !numberOfColumns = !numberOfColumns + 1
    endif
  enddo

  -- Get the cell spacing from the length of the STRA element in the table note
  !cellSpacing = !straElement.dbref().length

  !memory2 = !!ce
  -- Use the passed ARRAY and create texp elements
  do !row indices !cell
    !column = 0
    do from 1 to !numberOfColumns
      !column = !column + 1
      !entry      = !cell[!row][!column]
      !cellName   = 'cell' & !row.string() & '.' & !column.string()
      !copiedFrom = !cellsName & '/Column' & !column.string()
      new texp */$!hvacPieceCount/$!cellName copy $!copiedFrom
      if (!entry eq '') then
        !entry = ' '
      endif
      btex |$!entry|
      !copyBy = !cellSpacing * (!row - 1)
      by $!buildDirection$!copyBy
    enddo
    -- There may also be a line to copy
    !lineName   = 'line' & !row.string()
    !copiedFrom = !cellsName & '/Line'
    new stra */$!hvacPieceCount/$!lineName copy $!copiedFrom
    handle ANY
      skip
    endhandle
    !copyBy = !cellSpacing * (!row - 1)
    by $!buildDirection$!copyBy
  enddo

  -- Use the passed ARRAY and modify stra elements
  !column = -1
  !loop = !numberOfColumns + 1
  do from 1 to !loop
    !column = !column + 1
    !lineName = 'line' & !column.string()
    !modifyElement = !newTableName & '/ColumnLine' & !column.string()
    $!modifyElement
    handle ANY
      -- This is because it may be that some lines are not to be extended. (Suggest that in BSRF note these are named */FixedLineN )
      skip
    endhandle
    !oldLength = !!ce.length
    !newLength = ((!oldLength) + (!cellSpacing * (!row)))
      length $!newLength
      if (!column eq 0) then
        var !result TPT
        !result = 'X' & !result.after('X')
      endif
  enddo

  -- Position the last line
  !modifyElement = !newTableName & '/LastLine'
  $!modifyElement
  handle ANY
  elsehandle NONE
    at $!result
  endhandle

  -- This prevents the explorer tree opening each note member list
  !!ce = !memory2

  -- Refresh the graphics
  --  REFRESH
  --  handle ANY
  --  endhandle

  !!ce = !memory

  -- Return the end position of the table
  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getAllTables
--
-- Description: Get all tables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      DBREF of the new sheet
--    2    R     STRING     Type of Table ('ALL')
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllTables(!passedSheet is DBREF,!tableType is STRING )

  !memory = !!ce

  if (!tableType eq 'ALL') then
    !table = !this.getMtoTable()
    !this.createTable(!passedSheet, 'MTO', 1, !table, 'BackingSheetPosition')
    handle ANY
      !!hvacSketchesLog('Error creating MTO table')
    endhandle
    -- Set the Title of the MTO to contain the Specification code
    var !specificationCode DSCODE of BRAN1 of HVAC of $!this.hvacSpool
    !!ce = !this.sheet
    var !mtoTable collect all note with (SPPURP eq 'TABLE' and FUNC eq 'MTO') for ce
    if (defined(!mtoTable[1])) then
      !mtoTableName = !mtoTable[1].dbref().name
      !nameString = !mtoTableName & '/Title'
      var !mtoTitle collect all texp with (NAME eq !nameString) for ce
      if (defined(!mtoTitle[1])) then
        !!ce = !mtoTitle[1].dbref()
        var !btex BTEX
        !newText = !btex & ' - Specification: ' & !specificationCode
        BTEX '$!newText'
      endif
    endif
    !!ce = !memory

    !table = !this.getAssemblyTable()
    !this.createTable(!passedSheet, 'ASSEMBLY', 1, !table, 'BackingSheetPosition')
    handle ANY
      !!hvacSketchesLog('Error creating ASSEMBLY table')
    endhandle

    !table = !this.getEndPointTable()
    !this.createTable(!passedSheet, 'ENDPOINT',  1, !table, 'BackingSheetPosition')
    handle ANY
      !!hvacSketchesLog('Error creating ENDPOINT table')
    endhandle
  endif

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      getMtoTable
--
-- Description: Get MTO table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getMtoTable( ) is ARRAY

  !headings = ARRAY()
  if (!this.mtoHeadings.set() and !this.mtoHeadings.size() gt 0) then
    !headings = !this.mtoHeadings
  endif

  -- Get the table from the HVAC Spool
  --  !result = !this.hvacSpool.getMtoTable(!headings)

  -- Elements for the Rows of the Table
  !rows = ARRAY()
  if (!this.mtoTags.set() and !this.mtoTags.size() gt 0) then
    !rows = !this.mtoTags
  endif
  -- Values for the columns of each row
  !columns = !this.mtoHeadings

  -- Create a 2 dimensional array *****************
  !result = ARRAY()
  do !i indices !rows
    !result[!i] = ARRAY()
    do !j indices !columns
      !result[!i][!j] = '---'
      if (!columns[!j].upcase() eq 'TAG') then
        -- Special case
        !result[!i][!j] = !i.string()
      elseif (!columns[!j].upcase() eq 'QUANTITY') then
        !result[!i][!j] = '1'
      elseif (!columns[!j].upcase() eq 'UNITS') then
        !result[!i][!j] = 'Pieces'
      elseif (!columns[!j].upcase() eq 'BUILD') then
        !result[!i][!j] = !rows[!i].fitlen.string(!!distanceFmt)
        handle ANY
        endhandle
      elseif (!columns[!j].upcase().trim().part(1) eq 'PROP') then
        !partOne = !columns[!j].part(1)
        !partTwo = !columns[!j].part(2)
        !result[!i][!j] = !rows[!i].attribute('$!partOne').$!partTwo
        handle ANY
        endhandle
      else
        -- It must be just any attribute
        -- We need to have a way of knowing if a core attribute is a distance for formatting
        var !testUnit attdef $!columns[$!j] unit
        handle ANY
          -- Just try to evaluate the pdms expression
          !memory = !!ce
          !!ce = !rows[!i]
          var !test $!columns[$!j]
          handle ANY
          endhandle
          !result[!i][!j] = !test
          handle ANY
          endhandle
          !!ce = !memory
        elsehandle NONE
          if (!testUnit[1] eq 'DIST') then
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string(!!distanceFmt)
            handle ANY
            endhandle
          else
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string()
            handle ANY
            endhandle
            -- Handle special characters
            if (!result[!i][!j].match('#') gt 0) then
              !result[!i][!j] = !result[!i][!j].replace('#', '##')
            endif
          endif
        endhandle
      endif
    enddo
  enddo

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getAssemblyTable
--
-- Description: Get Assembly table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getAssemblyTable( ) is ARRAY

  !headings = ARRAY()
  if (!this.assemblyHeadings.set() and !this.assemblyHeadings.size() gt 0) then
    !headings = !this.assemblyHeadings
  endif

  -- Elements for the Rows of the Table
  !rows = ARRAY()
  if (!this.mtoTags.set() and !this.mtoTags.size() gt 0) then
    !rows = !this.mtoTags
  endif
  -- Values for the columns of each row
  !columns = !this.assemblyHeadings

  -- Create a 2 dimensional array *****************
  !result = ARRAY()
  !this.emptyBendingPlanes()
  do !i indices !rows
    -- Keep a running check on potential rotation requirements
    !this.getBendingPlanes(!rows[!i], !i)
    handle ANY
      -- q var !!error
    endhandle
    !result[!i] = ARRAY()

    do !j indices !columns
      !result[!i][!j] = '---'
      if (!columns[!j].upcase() eq 'TAG') then
        -- Special case
        !result[!i][!j] = !i.string()
      elseif (!columns[!j].upcase() eq 'QUANTITY') then
        !result[!i][!j] = '1'
      elseif (!columns[!j].upcase() eq 'UNITS') then
        !result[!i][!j] = 'Pieces'
      elseif (!columns[!j].upcase() eq 'BUILD') then
        !result[!i][!j] = !rows[!i].fitlen.string(!!distanceFmt)
        handle ANY
        endhandle
      elseif (!columns[!j].upcase()inset('TURN','ROTATE')) then
        -- Set Default Result
        !result[!i][!j] = !this.getQuadrantAngle(!rows[!i])
        handle ANY
          -- q var !!error
          !result[!i][!j] = ''
        endhandle
      elseif (!columns[!j].upcase().trim().part(1) eq 'PROP') then
        !partOne = !columns[!j].part(1)
        !partTwo = !columns[!j].part(2)
        !result[!i][!j] = !rows[!i].attribute('$!partOne').$!partTwo
        handle ANY
        endhandle
      else
        -- It must be just any attribute
        -- We need to have a way of knowing if a core attribute is a distance for formatting
        var !testUnit attdef $!columns[$!j] unit
        handle ANY
          -- Just try to evaluate the pdms expression
          !memory = !!ce
          !!ce = !rows[!i]
          var !test $!columns[$!j]
          handle ANY
          endhandle
          !result[!i][!j] = !test
          handle ANY
          endhandle
          !!ce = !memory
        elsehandle NONE
          if (!testUnit[1] eq 'DIST') then
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string(!!distanceFmt)
            handle ANY
            endhandle
          else
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string()
            handle ANY
            endhandle
            -- Handle special characters
            if (!result[!i][!j].match('#') gt 0) then
              !result[!i][!j] = !result[!i][!j].replace('#', '##')
            endif
          endif
        endhandle
      endif
    enddo
  enddo

  -- Ok so we have the results but if only the column 1 is set we should delete that entire row
  !mayBeDeleted = true
  do !i indices !result
    do !j indices !result[!i]
      if (!j gt 1 and !result[!i][!j].trim() neq '') then
        !mayBeDeleted = false
        -- We have found one so cannot delete this row so no use looking further in this rows columns
        break
      endif
    enddo
    if (!mayBeDeleted) then
      -- All columns except first must be blank so we can delete this row
      !result[!i].delete()
    endif
    !mayBeDeleted = true
  enddo
  -- Make the new array now all blank lines have been removed
  !result.compress()
  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getEndPointTable
--
-- Description: Get end point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getEndPointTable() is ARRAY

  !memory = !!ce
  !result = ARRAY()
  !useShip = false

  -- Need to know at this stage if should use Ship Position or xyz
  !backingSheet = !this.sheet.bsrf
  handle ANY
  elsehandle NONE
    !tableType = 'ENDPOINT'
    var !notes collect all note with (SPPURP eq 'CELLS' and FUNC eq !tableType) for $!backingSheet
    do !i indices !notes
      !cells = !notes[!i].dbref().members
      do !j indices !cells
        if (!cells[!j].type.eq('TEXP') and !cells[!j].btext.match('SHIP').gt(0)) then
          !useShip = true
          break
        endif
      enddo
      if (!useShip) then
        break
      endif
    enddo
  endhandle

  -- Get all the members of the spool
  !components = ARRAY()
  !components = !this.mtoTags

  -- Get the Start Positions
  !unusedTestA = !components[1].type
  handle ANY
    !!hvacSketchesLog('HVAC Spool has no components')
    !!ce = !memory
    return !result
  endhandle
  -- Just get the arrive of the first and the leave of the last component
  do !i indices !components
    if (!i eq 1) then
      !position[1] = !components[!i].apos.wrt(/* )
    endif
    if (!i eq !components.size()) then
      !position[2] = !components[!i].lpos.wrt(/* )
    endif
  enddo

  -- Get the p3 points of relevant components
  !count = 2
  do !i indices !components
    if (!components[!i].type inset('BRCO','TEE','THRE','CROS')) then
      var !temporary POS P3 of $!components[$!i] wrt /*
      !position[!count + 1] = object POSITION(!temporary)
      !count = !count + 1
    endif
  enddo

  -- Get the X,Y and Z of the position or Ship Positions

  -- Create a 2 dimensional array *****************
  !result = ARRAY()
    do !point indices !position
      !result[!point] = ARRAY()
      !result[!point][1] = 'C' & !point.string()

      if (!useShip) then
        !shipGrid = object SHIPGRID()
        !shipGridPosition = !shipGrid.shipGridPosition(!position[!point])
        !useShip = !shipGridPosition.valid
      endif

      if (!useShip) then
        -- Ship reference system in here.
        !shipGrid = object SHIPGRID()
        !shipGridPosition = !shipGrid.shipGridPosition(!position[!point])

        !distanceFmt = !!distanceFmt
        if (!distanceFmt.units.eq('MM')) then
          !distanceFmt.dp = 0
          !distanceFmt.label = ''
        endif

        !xPrefix   = !shipGridPosition.xPrefix
        !yPrefix   = !shipGridPosition.yPrefix
        !zPrefix   = !shipGridPosition.zPrefix
        !xGridLine = !shipGridPosition.xGridLine.string()
        !yGridLine = !shipGridPosition.yGridLine.string()
        !zGridLine = !shipGridPosition.zGridLine.string()
        !xOffset   = !shipGridPosition.xOffset.string(!distanceFmt)
        !yOffset   = !shipGridPosition.yOffset.string(!distanceFmt)
        !zOffset   = !shipGridPosition.zOffset.string(!distanceFmt)

        !xText = !xPrefix & !xGridLine & | | & !xOffset
        !yText = !yPrefix & !yGridLine & | | & !yOffset
        !zText = !zPrefix & !zGridLine & | | & !zOffset

        !result[!point][2] = !xText
        !result[!point][3] = !yText
        !result[!point][4] = !zText

      else
        !result[!point][2] = !position[!point].east.string(!!distanceFmt)
        !result[!point][3] = !position[!point].north.string(!!distanceFmt)
        !result[!point][4] = !position[!point].up.string(!!distanceFmt)
      endif
    enddo

  return !result

endmethod
----------------------------------------------------
--
-- Method:      getEndPointTags
--
-- Description: Get end points to be tagged
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Arguments:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getEndPointTags( ) is ARRAY

  !memory = !!ce
  !result = ARRAY()

  -- Get all the members of the spool
  !components = ARRAY()
  !components = !this.mtoTags

  -- Get the Start Positions
  !unusedTestB = !components[1].type
  handle ANY
    !!hvacSketchesLog('HVAC Spool has no components')
    !!ce = !memory
    return !result
  endhandle
  -- Just get the arrive of the first and the leave of the last component
  do !i indices !components
    if (!i eq 1) then
      !position[1] = !components[!i].apos.wrt(/* )
      !text[1] = 'P1 of $!components[$!i] '
    endif
    if (!i eq !components.size()) then
      !position[2] = !components[!i].lpos.wrt(/* )
      !text[2] = 'P2 of $!components[$!i] '
    endif
  enddo

  -- Get the p3 points of relevant components
  !count = 2
  do !i indices !components
    if (!components[!i].type inset('BRCO','TEE','THRE','CROS')) then
      var !temporary POS P3 of $!components[$!i] wrt /*
      !position[!count + 1] = object POSITION(!temporary)
      !text[!count + 1] = 'P3 of $!components[$!i] '
      !count = !count + 1
    endif
  enddo


   -- Create a 2 dimensional array *****************
  !result = ARRAY()
    do !point indices !position
      !result[!point] = ARRAY()
      !result[!point][1] = 'C' & !point.string()
      !result[!point][2] = !position[!point]
      !result[!point][3] = !text[!point]
    enddo

  !!ce = !memory

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      dimensionViews
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionViews( )

  -- Get all the members of the spool
  !components = ARRAY()
  !components = !this.mtoTags

  -- Remove all tubing from array
  do !i indices !components
    if (!components[!i].type eq 'TUBI') then
      !components[!i].delete()
    endif
  enddo
  -- Re-index
  !components.compress()

  -- Go to each View's dimensioning layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first dimensioning layer
    var !dimLayer collect all layer with (PURP eq 'DIMA') for $!views[$!i]
    if (!dimLayer.size().gt(0)) then
      !dimensioningLayer = !dimLayer[1].dbref()
    else
      skip
    endif

    !!ce = !dimensioningLayer
    !this.dimensionLayer(!components)
    handle ANY
      !!hvacSketchesLog('Error occurred in dimensioning')
      skip
    endhandle
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagViews
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagViews( )

  -- Get all the members of the spool (HVAC at the moment)
  !components = ARRAY()
  !components = !this.mtoTags

  -- Re-index
  !components.compress()

  -- Go to each View's label layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first label layer
    var !tagLayer collect all layer with (PURP eq 'LABA') for $!views[$!i]
    if (!tagLayer.size().gt(0)) then
      !taggingLayer = !tagLayer[1].dbref()
    else
      skip
    endif
    !!ce = !taggingLayer
    !this.tagLayer(!components)
    handle ANY
     !!hvacSketchesLog('Error occurred in tagging MTO refs')
      skip
    endhandle

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagLayer
--
-- Description: Tag each view in the DIMA layer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREF's of components in the spool
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagLayer(!components is ARRAY )

  -- Initialise variables
  !tagLayer   = !!ce
  !parameters = STRING()

  -- Get task and read parameters
  VAR !allTasks COLL ALL TASK WITH SPPURP EQ 'TAGDEF' FOR $!tagLayer
  VAR !allTaskParameters COLL ALL TKPARA FOR $!allTasks[1]
  -- Extract defaults from TKPARA elements
  do !i indices !allTaskParameters
    if (!allTaskParameters[!i].dbref().func eq 'TEMPLATE') then
      !symbol = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'OFFSET') then
      !offset = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'TXCOLOUR') then
      !txColour = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'FCOLOUR') then
        !fPenCol = !allTaskParameters[!i].dbref().tpvalue
        skip
    endif
    if (!allTaskParameters[!i].dbref().func  eq 'FSTYLE') then
           !fPenSty = !allTaskParameters[!i].dbref().tpvalue
           if (!fPenSty.upcase().match('SYS').eq(1) ) then
               !styEquiv = !fPenSty.after('SYS')
               !styNo = !styEquiv.real()
                    handle (2,441)
                      return error 1
                    endhandle
               !fstyldflts = 'SOLID DASH DOT CHAIN LDASH SOLIDTHICK DASHEDTHICK DOTEDTHICK  CHAINEDTHICK'
               !fstyleTypes = !fstyldflts.split()
               !fstyleTypes[0] = 'LDASHTHICK'
               !ind =!styNo - (  int (!styNo / 10) * 10)
               !equivStyle = !fstyleTypes[!ind]
           elseif(!fPenSty.upcase().eq('SOLIDFILLED')) then
               !equivStyle  = 'SOLID'
           endif
        skip
      endif
  enddo
  -- Build the local tags
  do !i indices !components
    -- Unique tag identifier
    !mtoTag    = !this.mtoTags.findFirst(!components[!i]).string()
    if (!mtoTag neq '') then
      NEW SLAB ON $!components[$!i] ATEX |$!mtoTag|
      TMRF $!symbol XYPO $!offset OSET TRUE Txcolour $!txColour LFCOLOUR $!fPenCol LFSTYLE $!equivStyle  LLCOLOUR $!fPenCol LLSTYLE $!equivStyle BLNK TRUE CPOF 0 0 LLEA TRUE
    endif
  enddo

  -- Return to layer
  !!ce = !tagLayer
  UPDATE ANNO

  -- Get arrange label task and read parameters
  VAR !allTasks COLL ALL TASK WITH SPPURP EQ 'ARRLAB' FOR $!tagLayer
  VAR !allTaskParameters COLL ALL TKPARA FOR $!allTasks[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  -- Arrange the labels
  !!hvacSketchesArrangeLabels($!parameters)

endmethod
------------------------------------------------------------------------
--
-- Method:      tagViewsEndPoints
--
-- Description: Tag all views with end point tags
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagViewsEndPoints( )

  -- Go to each View's label layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first label layer
    var !tagLayer collect all layer with (PURP eq 'LABA') for $!views[$!i]
    if (!tagLayer.size().gt(0)) then
      !taggingLayer = !tagLayer[1].dbref()
    else
      skip
    endif

    !!ce = !taggingLayer
    !this.tagLayerEndPoints()
    handle ANY
     !!hvacSketchesLog('Error occurred in tagging End Points')
      skip
    endhandle

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagLayerEndPoints
--
-- Description: Tag each view in the DIMA layer with end points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagLayerEndPoints()

  -- Initialise variables
  !tagLayer   = !!ce
  !tags = ARRAY()

  -- Build the local tags

  -- Need the getEndPointTags in here which returns a 2x2 array
  !tags = !this.getEndPointTags()

  do !i indices !tags

    -- Read position number
    !connectionNumber = !tags[!i][1]
--    !connectionPosition = !tags[!i][2]

    -- Create new general label for each end point
    NEW GLAB ON $!tags[$!i][3] BTEX |$!connectionNumber|
-- $!connectionPosition|
    CPOFFSET 0 -1.25

  enddo

  -- Return to layer
  !!ce = !tagLayer
  UPDATE ANNO

endmethod
------------------------------------------------------------------------
--
-- Method:      dimensionLayer
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREF's of components in the spool
-- Arguments:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionLayer(!allComponents is ARRAY )

  -- Initialise variables
  !number      = 1
  !branches[1] = ARRAY()
  !allBranches = ARRAY()
  !allSequence = ARRAY()

  -- Get data for all components except TUBE
  do !compRefe val !allComponents

    -- Get owning branch and sequence number
    !allBranches.append(!compRefe.owner.flnm)
    !allSequence.append(!compRefe.sequence)

  enddo

  -- Rationalise the all components array
  !components = !allComponents

  -- Sort the components into sequence
  !sorted = !allSequence.sortedIndices()
  !components.reIndex(!sorted)
  !allBranches.reIndex(!sorted)

  -- Sort components into their owning branches
  VAR !sort SORT !allBranches LASTINGROUP !last
  do !index ind !sort

    -- Add component to branch array
    !branches[!number].append(!components[!sort[!index].real()])

    -- Create next branch array
    if (defined(!last[!index]) and !index.neq(!sort.size())) then
      !number = !number + 1
      !branches[!number] = ARRAY()
    endif

  enddo

  -- List components to dimension
  do !number from 1 to !branches.size()

    !dimnComp[!number] = ARRAY()

    do !index ind !branches[!number]

      !compRefe = !branches[!number][!index]

      -- These are the components to dimension
      !dimnComp[!number].append(!compRefe)

    enddo

  enddo

  -- Dimension each branch
  do !index from 1 to !dimnComp.size()

    -- FROM START to END do dimensions from PA to PL for components or PA to P0 for Bends and the like.
    -- For all components
    -- Dimension from the current component to the next component
    do !number from 1 to !dimnComp[!index].size()
      -- Initialise variables
      !compRefe = !dimnComp[!index][!number]
      !compType = !compRefe.type.upcase()
      !compHardType = !compRefe.hardType.upcase()

      if (!compType inset('BEND','ELBO','TEE','THRE','CROS')) then
        NEW LDIM  DTAN PARA
        !direction = !compRefe.adir.wrt(/* ).string().before('WRT')
        -- Now assign the new direction to LDIM
        DIR $!direction
        handle ANY
          -- Dimension direction parallel to View direction, Dimension direction parallel to View direction
          -- Cannot dimension
          DELETE LDIM
        elsehandle none
          -- Add dimension points
          FROM PA OF $!compRefe
          TO $!compRefe
          handle ANY
            -- Dimension probably 0
            -- Cannot dimension
            LDIM
            DELETE LDIM
          endhandle
        endhandle
      else
        NEW LDIM  DTAN PARA
        !direction = !compRefe.adir.wrt(/* ).string().before('WRT')
        -- Now assign the new direction to LDIM
        DIR $!direction
        handle ANY
          -- Dimension direction parallel to View direction, Dimension direction parallel to View direction
          -- Cannot dimension
          DELETE LDIM
        elsehandle none
          -- Add dimension points
          FROM PA OF $!compRefe
          TO PL OF $!compRefe
          handle ANY
            -- Dimension probably 0
            -- Cannot dimension
            LDIM
            DELETE LDIM
          endhandle
        endhandle
      endif

      -- If we have one of these components dimension to it's end
      if (!compType inset('BEND','ELBO','TEE','OLET','THRE','BRCO','STIF','CROS') or !compHardType inset('ATTA')) then
        NEW LDIM  DTAN PARA
        !direction = !compRefe.ldir.wrt(/* ).string().before('WRT')
        -- Now assign the new direction to LDIM
        DIR $!direction
        handle ANY
          -- Dimension direction parallel to View direction, Dimension direction parallel to View direction
          -- Cannot dimension
          DELETE LDIM
        elsehandle none
          -- Add dimension points
          FROM PL OF $!compRefe
          TO $!compRefe
          handle ANY
            -- Dimension probably 0
            -- Cannot dimension
            LDIM
            DELETE LDIM
          endhandle
        endhandle
      endif
    enddo
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: global Instance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .globalInstance()

  !!hvacSketch = object HVACSKETCHES()
  -- Set Form Members
  !!hvacSketch.type             = 'drawing'
  !!hvacSketch.drawingPrefix    = 'DR'
  !!hvacSketch.sheetPrefix      = 'S'
  !template = object DBREF('/TT/DRA/PRJ/TMP/HvacSketch/A4')
  handle ANY
  elsehandle NONE
    !!hvacSketch.selectedTemplate = !template
  endhandle
  !!hvacSketch.logFile          = object FILE('%PDMSUSER%/hvacSketchesLog.txt')

endmethod
------------------------------------------------------------------------
--
-- Method:      openLog
--
-- Description: Open the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .openLog()

  !this.logFile.open('OVERWRITE')

endmethod
------------------------------------------------------------------------
--
-- Method:      closeLog
--
-- Description: Close the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeLog()

  !this.logFile.close()

endmethod
------------------------------------------------------------------------
--
-- Method:      writeLog
--
-- Description: Write to the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeLog()

  !this.logFile.writeFile('OVERWRITE', !this.logData)
  handle ANY
    -- Belt and braces
    !!alert.error('Unable log Data to file')
    handle ANY
      !!hvacSketchesLog('Unable log Data to file')
    endhandle
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      emptyLogData
--
-- Description: Empty the log Data array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .emptyLogData()

  !this.logData.clear()

endmethod
------------------------------------------------------------------------
--
-- Method:      readMtoHeadings
--
-- Description: Read the MTO heading from the Backing sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     DBREF      This is the note with SPPURP eq 'TABLE' and FUNC eq 'MTO'
-- Return:
--   [Data Type] [Description]
--    ARRAY       An array of the attributes of the HVAC spool materials
--
------------------------------------------------------------------------
define method .readMtoHeadings(!cells is DBREF) is ARRAY

  !result = ARRAY()
  !logMessage = 'MTO headings are :'

  -- Find the MTO entries table
  var !headings collect all texp for $!cells
  do !i indices !headings
    !result.append(!headings[!i].dbref().btex)
    !logMessage = !logMessage & ' ' & !result[!i]
  enddo

  -- Write a line in the log file
  !!hvacSketchesLog(!logMessage)

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      readAssemblyHeadings
--
-- Description: Read the Assembly heading from the Backing sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     DBREF      This is the note with SPPURP eq 'TABLE' and FUNC eq 'ASSEMBLY'
-- Return:
--   [Data Type] [Description]
--    ARRAY       An array of the attributes of the HVAC spool materials
--
------------------------------------------------------------------------
define method .readAssemblyHeadings(!cells is DBREF) is ARRAY

  !result = ARRAY()
  !logMessage = 'Assembly headings are :'

  -- Find the MTO entries table
  var !headings collect all texp for $!cells
  do !i indices !headings
    !result.append(!headings[!i].dbref().btex)
    !logMessage = !logMessage & ' ' & !result[!i]
  enddo

  -- Write a line in the log file
  !!hvacSketchesLog(!logMessage)

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      flattenedDirection
--
-- Description: Flatten the direction between 2 points onto the view plane for a true dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The first component reference
--    2    R     REAL        The first component ppoint
--    3    R     DBREF       The second component reference
--    4    R     REAL        The second component ppoint
-- Return:
--   [Data Type] [Description]
--    STRING       Direction as mapped onto a plane of the view direction
--
------------------------------------------------------------------------
define method .flattenedDirection(!firstElement is DBREF, !firstPoint is REAL, !secondElement is DBREF, !secondPoint is REAL) is STRING

  !direction = STRING()

  -- OK we just need to map this onto the view plane to get a true LDIM DIR
  var !viewName VIEW
  !view = object DBREF(!viewName)
  !planeDirection = !view.direction
  !planePosition = object POSITION('E0N0U0 wrt /* ')
  !planeOrientation = object ORIENTATION('Z is ' & !planeDirection.string())
  !plane = object PLANE(!planePosition, !planeOrientation)
  -- Map each point onto the plane
  var !position POS P$!firstPoint OF $!firstElement
  !firstPosition = object POSITION(!position)
  var !position POS P$!secondPoint OF $!secondElement
  !secondPosition = object POSITION(!position)
  !firstNear = !plane.near(!firstPosition)
  !secondNear = !plane.near(!secondPosition)
  -- Now get the direction of first point to second
  !direction = !firstNear.direction(!secondNear).string().before('WRT')

  return !direction

endmethod
------------------------------------------------------------------------
--
-- Method:      getBendingPlanes
--
-- Description: Fill the Bending Plane Members for Spool
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Element to consider as Bending Plane
--    2    R     REAL        Counter of elements in Spool
--
------------------------------------------------------------------------
define method .getBendingPlanes(!element is DBREF, !count is REAL)

  if (!element.type inset ('BEND','ELBO','TEE','BRCO','THRE')) then
    -- Test Shape too
--    if (!element.attribute('PROP').shap eq 'CIRC' or !element.attribute('PROP').face eq 'CIRC') then
      !this.rotationElements.append(!element)
      !currentCount = !this.rotationElements.size()
      -- Beware and Revisit because points are not sure to be at same level????
      if (!this.rotationElements[!currentCount].type inset ('BRCO','TEE','THRE')) then

        -- Do not consider BRCO's if already have a bend plane
        if (!this.hasBendPlane.not() or !this.rotationElements[!currentCount].type.neq('BRCO')) then
          -- Branch point may not be 3 ..will be (6 - (arrive + leave))
          !third = (6 - (!this.rotationElements[!currentCount].arri + !this.rotationElements[!currentCount].leav))

          -- Better to get intersection of arrive and p3
          !arriveDirection = !this.rotationElements[!currentCount].adir
          !arrivePosition  = !this.rotationElements[!currentCount].apos
          !arriveVector = object POINTVECTOR(!arrivePosition, !arriveDirection)

          !leaveDirection = !this.rotationElements[!currentCount].ldir
          !leavePosition  = !this.rotationElements[!currentCount].lpos
          !leaveVector = object POINTVECTOR(!leavePosition, !leaveDirection)

          !thirdDirection = !this.rotationElements[!currentCount].pdir[!third]
          !thirdPosition  = !this.rotationElements[!currentCount].ppos[!third]
          !thirdVector = object POINTVECTOR(!thirdPosition, !thirdDirection)

          !line = !leaveVector.line(1000mm)
          !finalPosition = !line.endPosition

          !pos = !leaveVector.intersection(!thirdVector)
          handle ANY
            !pos = !leaveVector.intersection(!arriveVector)
            handle ANY
              !pos = !this.rotationElements[!currentCount].position
            endhandle
          endhandle

          !plane = !leavePosition.plane(!pos, !thirdPosition)
          handle ANY
            !plane = !leavePosition.plane(!arrivePosition, !thirdPosition)
            handle ANY
              !plane = !leavePosition.plane(!pos, !arrivePosition)
              handle ANY
                !plane = !leavePosition.plane(!finalPosition, !thirdPosition)
                handle ANY
                endhandle
              endhandle
            endhandle
          endhandle
        else
          -- Must be a BRCO that needs to copy the previous Bend Plane
          !this.rotationPlanes[!currentCount] = !this.rotationPlanes[!currentCount - 1]
          !this.quadrantPlanes[!currentCount] = !this.quadrantPlanes[!currentCount - 1]
          !this.rotationPlaneNumbers[!currentCount] = !this.rotationPlaneNumbers[!currentCount - 1]
          return
        endif

      elseif (!this.rotationElements[!currentCount].type inset ('BEND','ELBO')) then

        -- Get intersection of arrive and leave
        !arriveDirection = !this.rotationElements[!currentCount].adir
        !arrivePosition  = !this.rotationElements[!currentCount].apos
        !arriveVector = object POINTVECTOR(!arrivePosition, !arriveDirection)

        !leaveDirection = !this.rotationElements[!currentCount].ldir
        !leavePosition  = !this.rotationElements[!currentCount].lpos
        !leaveVector = object POINTVECTOR(!leavePosition, !leaveDirection)

        !pos = !leaveVector.intersection(!arriveVector)
        handle ANY
          !pos = !this.rotationElements[!currentCount].position
        endhandle

        !plane = !leavePosition.plane(!pos, !arrivePosition)
        handle ANY
        endhandle

      endif

      !rotationPlaneDirection = !plane.orientation.zdir().wrt(world)
      -- Test for Z being generally up or down
      !up = up wrt /*
      -- Rotation Plane angle from UP
      if (!up.angle(!rotationPlaneDirection).gt(90degree)) then
        !rotationPlaneDirection = !rotationPlaneDirection.opposite()
      elseif (!up.angle(!rotationPlaneDirection).lt(90degree)) then
        -- OK
      else
        -- Equals 90 (What to do? Nothing necessary)
      endif
      -- For Rotation Plane
      !orientationString = 'Z is ' & !rotationPlaneDirection.string() & ' and Y is ' & !leaveDirection.opposite()
      !plane.orientation = object ORIENTATION(!orientationString)
      handle ANY
      endhandle

      -- For Quadrant Plane
      !orientationString = 'Z is ' & !leaveDirection & ' and Y is ' & !rotationPlaneDirection.string()
      !orientation = object ORIENTATION(!orientationString)

      -- Consider a Tee like a bend or elbow
      !this.rotationPlanes[!currentCount] = !plane
      !this.quadrantPlanes[!currentCount] = object PLANE(!leavePosition, !orientation)
      !this.rotationPlaneNumbers[!currentCount] = !count
      if (!this.rotationElements[!currentCount].type.neq('BRCO')) then
        !this.hasBendPlane = true
      endif

--    endif
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      getQuadrantAngle
--
-- Description: Get the rotation Angle in Quadrant
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Element for Angle
-- Return:
--   [Data Type] [Description]
--     STRING    Descriptive Angle Text for Sketch
--
------------------------------------------------------------------------
define method .getQuadrantAngle(!element is DBREF) is STRING

  -- Set Default Result
  !result = ''
  !angle = 0
  -- Get Rotate angle based of Type, Shape
  if (!element.type inset('BEND','ELBO','BRCO','TEE','THRE')) then
    -- Get rotation plane from previous 'BEND','ELBO','BRCO','TEE','THRE'
    if (!this.rotationElements.size().gt(0)) then
      do !i indices !this.rotationElements
        if (!element eq !this.rotationElements[!i]) then
          if (!i gt 1) then
            !number = !i - 1
          else
            !number = !i
          endif
          !rotationPlane = !this.rotationPlanes[!number]
          !quadrantPlane = !this.quadrantPlanes[!number]
          !rotationPlaneNumber = !this.rotationPlaneNumbers[!number]
        endif
      enddo
      !rotationPlaneDirection = !rotationPlane.orientation.zdir().wrt(world)
      -- ??? is below logic full enough as seem to do more above
      if (!element.type inset('BEND','ELBO')) then
        if (!number eq !i) then
          !direction = !element.adir
          !position  = !element.apos
        else
          !direction = !element.ldir
          !position  = !element.lpos
        endif
        !direction = !direction.projected(!quadrantPlane)
        !position  = !quadrantPlane.near(!position)
        !vector1 = object POINTVECTOR(!position, !direction)
        !intersection1 = !rotationPlane.intersection(!vector1)
        handle (2,875)
          -- parallel
        elsehandle ANY
        elsehandle NONE
          !vector2 = object POINTVECTOR(!position, !rotationPlaneDirection)
          !intersection2 = !rotationPlane.intersection(!vector2)
          handle (2,875)
            -- parallel
          elsehandle ANY
          elsehandle NONE
            !angle = !intersection1.angle(!intersection2, !position)
            handle ANY
            endhandle
          endhandle
        endhandle
      elseif (!element.type inset('BRCO','TEE','THRE')) then

        -- Branch point may not be 3 ..will be (6 - (arrive + leave))
        !third = (6 - (!element.arri + !element.leav))

        !direction = !element.pdir[!third]
        !position  = !element.ppos[!third]
        !direction = !direction.projected(!quadrantPlane)
        !position  = !quadrantPlane.near(!position)
        !vector1 = object POINTVECTOR(!position, !direction)

        !intersection1 = !rotationPlane.intersection(!vector1)
        handle (2,875)
          -- parallel
        elsehandle ANY
        elsehandle NONE
          !vector2 = object POINTVECTOR(!position, !rotationPlaneDirection)
          !intersection2 = !rotationPlane.intersection(!vector2)
          handle (2,875)
            -- parallel
          elsehandle ANY
          elsehandle NONE
            !angle = !intersection1.angle(!intersection2, !position)
            handle ANY
            endhandle
          endhandle
        endhandle
      endif
    endif
    -- Get the quadrant by projecting onto !quadrantPlane
    !xypos = !quadrantPlane.xyOffset(!position)

    if (!xypos.x.gt(0) and !xypos.y.gt(0)) then
      -- TR quadrant
      !angle = (!angle)
    elseif (!xypos.x.lt(0) and !xypos.y.gt(0)) then
      -- TL quadrant
      !angle = (180degree - !angle)
    elseif (!xypos.x.gt(0) and !xypos.y.lt(0)) then
      -- BR quadrant
      !angle = (-1 * !angle)
    elseif (!xypos.x.lt(0) and !xypos.y.lt(0)) then
      -- BL quadrant
      !angle = (-1 * (180degree - !angle))
    endif
    if (!xypos.y.between(-1mm, 1mm) and !xypos.x.gt(0)) then
      !angle = (0degree)
    elseif (!xypos.x.between(-1mm, 1mm) and !xypos.y.gt(0)) then
      !angle = (90degree)
    elseif (!xypos.y.between(-1mm, 1mm) and !xypos.x.lt(0)) then
      !angle = (180degree)
    elseif (!xypos.x.between(-1mm, 1mm) and !xypos.y.lt(0)) then
      !angle = (-90degree)
    endif
    !rotationElement = !this.mtoTags[!rotationPlaneNumber]
    if (!rotationElement.type eq 'ELBO') then
      !prefix = 'E'
    elseif (!rotationElement.type eq 'BRCO') then
      !prefix = 'BR'
    elseif (!rotationElement.type eq 'TEE') then
      !prefix = 'T'
    elseif (!rotationElement.type eq 'THRE') then
      !prefix = 'T'
    else
      !prefix = 'BP'
    endif
    !result = !prefix & '[' & !rotationPlaneNumber.string() & '] ' & !angle.string(!!angleFmt)
    handle ANY
      !result = ''
    endhandle
  endif

  return !result

endmethod

------------------------------------------------------------------------
--
-- Method:      emptyBendingPlanes
--
-- Description: Empty the bending Plane Arrays
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .emptyBendingPlanes()

  !this.rotationElements = ARRAY()
  !this.rotationPlanes = ARRAY()
  !this.rotationPlaneNumbers = ARRAY()
  !this.quadrantPlanes = ARRAY()
  !this.hasBendPlane = false

endmethod
