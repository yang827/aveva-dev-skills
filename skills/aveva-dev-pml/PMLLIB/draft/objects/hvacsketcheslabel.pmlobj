--     Keyword:     HVAC Sketches
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson/Steve Bentley
-- Created:         13 Mar 2006
--
-- Description:
-- A label either a GLAB or SLAB for arrangement purposes
--
------------------------------------------------------------------------
-- Member descriptions:
--
-- reference  = slab or glab reference
-- designRefe = reference of attached design db element
-- direction  = direction from view xypo to label xypo
-- endPoint   = xypo position on page of label
-- startPoint = xypo position on page of leaderline end at ddnm
-- template   = template reference
-- cpof       = x & y offset of leaderline endpoint at the label
--
------------------------------------------------------------------------
define object HVACSKETCHESLABEL

  member .reference is DBREF
  member .designRefe is DBREF
  member .direction is DIRECTION
  member .endPoint is POSITION
  member .startPoint is POSITION
  member .template is DBREF
  member .cpof is ARRAY

endobject
