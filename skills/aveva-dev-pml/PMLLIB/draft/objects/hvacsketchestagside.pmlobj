--
-- File:            hvacsketchestagside.pmlobj
--   Type:          Object Definition
--   Group:         Document production
--     Keyword:     HVAC Sketches
--   Module:        DRAFT
--
-- Author:          Steve Wilson/Steve Bentley
-- Created:         13 March 2006
--
-- Description:
-- The side of a view for tagging arrangement
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  readPos(STRING)                  ARRAY               Read side array of labels and return an array of the passed coordinate values.
--  tagSwitch(REAL)                  -                   Switch label positions around if they intersect
--

-- member descriptions
--
-- angle     = attribute adeg
-- coord     = direction of label arrangement
-- desc      = description
-- gap       = user specified minimum gap between labels
-- just      = attribute justification
-- labels    = array of labels to be arranged on this side
-- length    = length of the side for arrangement (view side + margin)
-- lsha      = attribute leader line shape
-- margin    = user specified distance from edge of view to label position
-- spacing   = distance between each arranged label
-- startXpos = side start x position on the page
-- startYpos = side start y position on the page
--
------------------------------------------------------------------------

define object HVACSKETCHESTAGSIDE

  member .angle is REAL
  member .coord is STRING
  member .desc is STRING
  member .gap is REAL
  member .just is STRING
  member .labels is ARRAY
  member .length is REAL
  member .lsha is STRING
  member .margin is REAL
  member .spacing is REAL
  member .startXPos is REAL
  member .startYPos is REAL

endobject

------------------------------------------------------------------------
--
-- Method:      readPos(STRING)
--
-- Description:
-- Read side array of labels and return an array of the passed coordinate values.
--
-- Method Type: Function
--
-- Arguments:  1 = Axis to extract
--
------------------------------------------------------------------------
define method .readPos(!coord is STRING) is ARRAY

  !values = ARRAY()

  do !label val !this.labels

    if (!coord.eq('east')) then
      !values.append(!label.startPoint.east)
    elseif (!coord.eq('north')) then
      !values.append(!label.startPoint.north)
    else
      !values.append(!label.startPoint.up)
    endif

  enddo

  return !values

endmethod
------------------------------------------------------------------------
--
-- Method:      tagSwitch(ARRAY)
--
-- Description:
-- Switch label positions around if they intersect
-- The key here is that the endpoint of the leaderline is modified to
-- allow for consideration of the label shape
--
-- Method Type: Function
--
-- Arguments:  1 = Side number being processed
--
------------------------------------------------------------------------
define method .tagSwitch(!side is REAL)

  -- Initialise variables
  !labels = !this.labels

  -- Iterate to a limit for protection
   do from 1 to 100

     -- Initialise variables
     !ints = false

     -- For all labels in group
     do !thisIndex ind !labels

       -- Initialise variables
       !thisLabel = !labels[!thisIndex]

       -- Create line representing this label leaderline
       -- The start point is the ddnm end and the end is the label
       !thisLine = object LINE()
       !thisLine.startPosition = !thisLabel.startPoint
       !thisLine.endPosition = !thisLabel.endPoint
       !startCount = !thisIndex + 1

       -- Allow for bend point offset
       if (!side.eq(1)) then
         !thisLine.endPosition.east = !thisLabel.endPoint.east - !thisLabel.cpof[2]
         !thisLine.endPosition.north = !thisLabel.endPoint.north - !thisLabel.cpof[1]
       elseif (!side.eq(2)) then
         !thisLine.endPosition.east = !thisLabel.endPoint.east + !thisLabel.cpof[2]
         !thisLine.endPosition.north = !thisLabel.endPoint.north + !thisLabel.cpof[1]
       elseif (!side.eq(3)) then
         !thisLine.endPosition.east = !thisLabel.endPoint.east + !thisLabel.cpof[1]
         !thisLine.endPosition.north = !thisLabel.endPoint.north + !thisLabel.cpof[2]
       elseif (!side.eq(4)) then
         !thisLine.endPosition.east = !thisLabel.endPoint.east - !thisLabel.cpof[1]
         !thisLine.endPosition.north = !thisLabel.endPoint.north - !thisLabel.cpof[2]
       endif

       -- Check a line against all the others
       do !nextIndex from !startCount to !labels.size()

         -- Initialise variables
         !nextLabel = !labels[!nextIndex]

         -- Create line representing the next leaderline
         !nextLine = object LINE()
         !nextLine.startPosition = !nextLabel.startPoint
         !nextLine.endPosition = !nextLabel.endPoint

         -- Allow for bend point offset
         if (!side.eq(1)) then
           !nextLine.endPosition.east = !nextLabel.endPoint.east - !nextLabel.cpof[2]
           !nextLine.endPosition.north = !nextLabel.endPoint.north - !nextLabel.cpof[1]
         elseif (!side.eq(2)) then
           !nextLine.endPosition.east = !nextLabel.endPoint.east + !nextLabel.cpof[2]
           !nextLine.endPosition.north = !nextLabel.endPoint.north + !nextLabel.cpof[1]
         elseif (!side.eq(3)) then
           !nextLine.endPosition.east = !nextLabel.endPoint.east + !nextLabel.cpof[1]
           !nextLine.endPosition.north = !nextLabel.endPoint.north + !nextLabel.cpof[2]
         elseif (!side.eq(4)) then
           !nextLine.endPosition.east = !nextLabel.endPoint.east - !nextLabel.cpof[1]
           !nextLine.endPosition.north = !nextLabel.endPoint.north - !nextLabel.cpof[2]
         endif

         -- get intersection point
         !intersection = !thisLine.intersection(!nextLine)
         handle (2,870)
           -- Lines are parallel
           skip
         endhandle

         -- Test if the intersection is within either line
         if (!thisLine.onProjected(!intersection) and !nextLine.onProjected(!intersection)) then

           -- Check if intersection is at the start end
           if (!intersection.neq(!thisLabel.startPoint) and !intersection.neq(!nextLabel.startPoint)) then

             -- Indicate an intersect found
             !ints = true

             -- Swap endpoints
             !thisEndPos = !labels[!thisIndex].endPoint
             !labels[!thisIndex].endPoint = !nextLabel.endPoint
             !labels[!nextIndex].endPoint = !thisEndPos

           endif

         endif

       enddo

     enddo

     -- Stop if no intersects found
     break if (not !ints)

   enddo

   -- Store new sequence
   !this.labels = !labels

endmethod
-- End of method definition
