-- File:            pipesketches.pmlobj
--   Type:          Object Definition
--   Group:         Document production
--     Keyword:     Pipe Sketches
--   Module:        DRAFT
--
-- Author:          Steve Bentley
-- Created:         2005/02/28
--
--
-- Description: Main object to be used to create Pipe sketches
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Method called on Apply of the form to do the actual work
--  closeLog()                       -                   Close the log file
--  convertToDecimal(STRING)         STRING              convert the X and Y portions of a string like this
--  copyDrawingFrom(STRING)          -                   Create new drawing by copying DRWG or DRTMPL
--  copySheetFrom(STRING)            -                   Create new sheet by copying DRWG (was in MTEMPLATE)
--  createDimension(STRING,DBREF,REAL,DBREF,REAL) ARRAY               Create a dimension
--  createElement(STRING,STRING,STRING) -                   Method to create the new element (like DRA CLIB ICREATE)
--  createTable(DBREF,STRING,REAL,ARRAY,STRING) STRING
--  dimensionLayer(ARRAY)            -
--  dimensionViews()                 -                   Dimension all views
--  emptyLogData()                   -                   Empty the log Data array
--  formatUnits(REAL)                STRING              Format to current distance units
--  getAllTables(DBREF,STRING)       -
--  getAssemblyTable()               ARRAY               Get assembly table
--  getBendingActivityTable(DBREF)   ARRAY
--  getBendingTable(DBREF)           ARRAY
--  getEndPointTable()               ARRAY               Get end point table
--  getEndPointTags()                ARRAY               Get end points to be tagged
--  getFlangeAngle(DBREF,REAL)       REAL                calculate the angle of a flange component
--  getMtoTable()                    ARRAY               Get MTO table
--  getWeldingTable()                ARRAY
--  globalInstance()                 -                   global Instance
--  isitacutmitre(DBREF)             REAL                Check a bend to see if it has mitres
--  makeSketch(DBREF)                -                   Do the work to make the actual sketch
--  openLog()                        -                   Open the log file
--  readMtoHeadings(DBREF)           ARRAY               Read the MTO heading from the Backing sheet
--  tagLayer(ARRAY)                  -
--  tagLayerAssemblyPlanes(ARRAY)    -
--  tagLayerEndPoints()              -                   Tag each view in the DIMA layer with end points
--  tagViews()                       -                   Dimension all views
--  tagViewsAssemblyPlanes()         -                   Tag all views with assembly planes
--  tagViewsEndPoints()              -                   Tag all views with end point tags
--  testformitres()                  -                   Check a pipe piece to see if it has mitres
--  writeLog()                       -                   Write to the log file
--
define object PIPESKETCHES

  -- Form Members
  -- pipePieces is an ARRAY of DBREFS
  -- mtoTags is an ARRAY of DBREFS used throughout for MTO tags
  -- mtoHeadings is an ARRAY of STRINGS
  -- logData is an ARRAY of STRINGS
  member .type             is STRING
  member .pipeSpool        is DBREF
  member .pipePieces       is ARRAY
  member .createIn         is DBREF
  member .selectedTemplate is DBREF
  member .drawingPrefix    is STRING
  member .sheetPrefix      is STRING
  member .drawing          is DBREF
  member .sheet            is DBREF
  member .backingSheet     is DBREF
  member .mtoHeadings      is ARRAY
  member .logFile          is FILE
  member .logData          is ARRAY
  member .mtoTags          is ARRAY

endobject
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Method called on Apply of the form to do the actual work
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !memory = !!ce

  -- We need to load the Common formats object if not in graphics mode (for TTY batch processing
  var !device device
  if (!device.lowcase() neq 'graphics') then
    !!comDefineGlobal(object comFormats())
  endif

  -- Collect all the pipe pieces for the pipe spool and store on this.pipePieces array of DBREFs
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !this.pipePieces = !pipeSpoolManager.getPipePieces(!this.pipeSpool)

  -- Navigate to the registry to create the drawings in
  !!ce = !this.createIn

  -- Create the new drawing
  if (!this.type.lowcase() eq 'drawing') then
    -- Create the actual new element
    !this.createElement(!this.drawingPrefix, 'DRWG', 'ce')
    handle ANY
      !!pipeSketchesLog('Error creating new Drawing ')
      return
    endhandle
    if (!this.selectedTemplate.type eq 'DRWG') then
       !this.copyDrawingFrom('drawing')
    elseif (!this.selectedTemplate.type eq 'DRTMPL') then
      !this.copyDrawingFrom('drtmpl')
    endif
  endif

  -- Navigate to the new drawing
  DRWG
  !drawing = !!ce

  -- Record this stage in the log
  !!pipeSketchesLog('New Drawing ' & !drawing.fullName & ' created')

  -- Do the actual work to make this into a pipe sketch
  !this.makeSketch(!drawing)

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      copyDrawingFrom
--
-- Description: Create new drawing by copying DRWG or DRTMPL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      key word 'DRAWING' or 'DRTMPL' (Type of template)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyDrawingFrom(!templateType is STRING)

  !memory = !!ce

  -- Copy drawing from which template
  !template = !this.selectedTemplate
  !templateName = !template.name

  -- First check we are in the correct DB type
  if (!!ce.dbtype neq 'PADD') then
    switch
  endif

  -- This assumes the template is named
  -- We are at the drawing to be copied like template...
  !newDrawing = !!ce
  !newDrawingName = !newDrawing.name

  -- Record the author and date because we want to retain these
  !author = !!ce.author
  !date = !!ce.date

  -- Do the copying
  if (!templateType.lowcase() eq 'drawing') then
    !command = 'COPY ' & !templateName & ' RENAME ' & !templateName & ' ' & !newDrawingName
  else
    !command = 'BSRF unset COPY LIKE ' & !templateName & ' RENAME ' & !templateName & ' ' & !newDrawingName
  endif
  $!command
  handle ANY
    -- error occurred using copy or copy like
  endhandle

  -- Set author back to real author and date not template's author
  !!ce.author = !author
  !!ce.date = !date
  update anno

  -- For a copied DRTMPL element
  -- This bit has been copied from the abaDrawing pml object
  -- Copy and rename all the members of the template into the new drawing because copy like does not do this.
  if (!templateType.lowcase() eq 'drtmpl') then

    LINKREF $!templateName
    SPPURPOSE unset

    -- Cycle round the members of the drawing template make copies and rename
    do !member values !template.members
      -- Initialise variables
      !memberType = !member.type
      !memberName = !member.flnn
      if (!memberType.eq('SHTMPL')) then
        -- Do not do anything yet till the next do loop
      else
        -- its not the sheet template
        if (!memberName.match(!templateName).gt(0)) then
          !newName = !newDrawingName & !memberName.after(!templateName)
        else
          !newName = ' '
        endif
        if (!memberType eq 'LIBY') then
          NEW LIBY $!newDrawingName/LIBY
          COPY MEMBERS OF $!member rename $!templateName $!newDrawingName
        else
          NEW $!memberType $!newName COPY $!member RENAME $!templateName $!newDrawingName
          handle (64,503)
            -- Picture needs to be loaded
            !loadElem = !!error.text.after(') ').before(': Picture')
            LOAD $!loadElem
            handle ANY
            endhandle
          endhandle
        endif
      endif
    enddo

    -- Do again
    do !member values !template.members
      -- Initialise variables
      !memberType = !member.type
      !memberName = !member.flnn
      if (!memberType.eq('SHTMPL')) then
        -- Just change the selected template to be this shtmpl and run the .copySheetFrom('shtmpl') method
        !this.selectedTemplate = !member
        -- Create the actual new element
        !this.createElement(!this.sheetPrefix, 'SHEE', 'ce')
        !this.copySheetFrom('shtmpl')
        !this.selectedTemplate = !template
      endif
    enddo
    DRWG

  endif

  -- For a copied DRWG element
  if (!templateType.lowcase() eq 'drawing') then
    -- set the idln to point to the drwgs default idlist
    -- This relies on names being adhered to (This is a Draft dependency on expected naming)
    IDLN $!newDrawingName/DRAWLIST/DRWG
    handle ANY
    endhandle
    var !idlname IDLN

    -- drwg may contain sheets
    -- goto each sheet and cascade drwgs new idln to each sheet....
    var !numberSheets MEM SHEE COUNT
    do !i to $!numberSheets
      SHEET $!i
      IDLN $!idlname
      handle ANY
      endhandle
      !newSheetName = !!ce.name

      -- sheet may contain views
      -- goto each view and cascade sheets new idln to each view....
      var !numberViews MEM VIEW COUNT
      do !j to $!numberViews
        VIEW $!j
        IDLN $!idlname
        handle ANY
        endhandle
      enddo

    enddo
  endif

  -- Navigate back to the new drawing
  !!ce = !newDrawing

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      copySheetFrom
--
-- Description: Create new sheet by copying DRWG (was in MTEMPLATE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Key word can be 'SHEET' or 'SHTMPL' (Type of template)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copySheetFrom(!templateType is STRING)

  !memory = !!ce

  -- Copy sheet from which template
  !template = !this.selectedTemplate
  !templateName = !template.name

  -- This assumes the template is named.
  !newSheet = !!ce
  !newSheetName = !!ce.name
  if (!templateType.lowcase() eq 'sheet') then
    !command = 'COPY ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
  else
    !command = 'BSRF unset COPY LIKE ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
  endif
  $!command
  handle ANY
    -- error occurred using copy or copy like
  endhandle

  -- Specific requirements if using the SHTMPL as the template origin
  if (!templateType.lowcase() eq 'shtmpl') then
    LINKREF $!templateName
    SPPURPOSE unset
    BSRF BSRF OF $!templateName
    handle ANY
      !!pipeSketchesLog('Unable to Set Template Backing Sheet for $!template - See Your System Administrator')
    endhandle
    -- Now copy all members of the sheet
    !command = 'COPY MEMBERS OF ' & !templateName & ' RENAME ' & !templateName & ' ' & !newSheetName
    $!command

    SHEET
    -- For all ABA templates we want to unset the SPPURP
    var !allWithABAT collect all with (SPPURP eq 'ABAT') for ce
    do !i indices !allWithABAT
      !!ce = !allWithABAT[!i].dbref()
      SPPURPOSE unset
    enddo
    SHEET

  endif

  -- Navigate to owning DRWG and set sheets IDLN to DRWGS IDLN
  DRWG
  !drawingName = !!ce.name
  var !idlname IDLN

  -- Go to the template name and capture the IDLN of all of the VIEWS

  -- return to sheet
  !!ce = !newSheet
  IDLN $!idlname
  handle ANY
  endhandle

  -- sheet may contain views....
  -- goto each view and cascade sheets new idln to all views....
  var !views MEM VIEW COUNT
  do !i to $!views
    VIEW $!i
    !viewName = !!ce.name
    $!drawingName/LIBY
    handle ANY
      -- this might not exist
    elsehandle NONE
      NEW PLLB
      name $!viewName/PLANES
      handle (41,12)
        DELETE PLLB
      endhandle
    endhandle
    !!ce = !newSheet
  enddo

  -- We now have a copy of the drawing and all its members so now we need to go and reassign references,
  -- such as refs for tagrules etc, because in the DRTMPL situation, the library is not copied with
  -- the drawing it may be a separate library stored anywhere in the database.

  DRWG

  var !library coll all liby for ce
  var !allViews coll all view for ce

  do !view val !allViews

    -- Initialise variables
    !viewElement = !view.dbref()
    -- Set idln
    !!ce = !viewElement
    !idliOrder = !viewElement.idln.order
    !tempDllb = !viewElement.idln.owne
    !tempLiby = !viewElement.idln.owne.owne
    var !allDllbs coll all dllb for $!tempLiby
    var !allTrlbs coll all trlb for $!tempLiby
    var !allLayers coll all laye for $!viewElement

    -- 1. Find the number of the dllb that owns the referenced idln
    do !index index !allDllbs
      if (!allDllbs[!index].eq(!tempDllb.string())) then
        !dllbOrder = !index
        break
      endif
    enddo
    -- Set idln
    !!ce = !viewElement
    IDLN IDLI $!idliOrder OF DLLB $!dllbOrder OF $!library[1]
    handle ANY
      -- May not be any libraries
    endhandle

    -- 2. Re-assign all tagruleset to that of the local trst and not the template trst
    -- but set a link reference to the template trst
    do !laye val !allLayers

      -- Initialise variables
      !layerElement = !laye.dbref()
      !tempTrst = !layerElement.trsf

      -- For any tagruleset reference
      if (!tempTrst.badref().not()) then

        -- Get trsf data
        !trstOrder = !layerElement.trsf.order
        !tempTrlb = !layerElement.trsf.owne
        var !tempTagrules coll all tagr for $!tempTrst

        -- Find the number of the trlb that owns the referenced trst
        do !index index !allTrlbs
          if (!allTrlbs[!index].eq(!tempTrlb.string())) then
            !trlbOrder = !index
            break
          endif
        enddo

        -- Set tagruleset
        !!ce = !layerElement
        TRSF TRST $!trstOrder OF TRLB $!trlbOrder OF $!library[1]
        handle ANY
          -- May not be any libraries
        endhandle

        -- Run round all of the tagrules and set a link reference to the template ones
        !trst = !layerElement.trsf
        var !allTagrules coll all tagr for $!trst

        do !index ind !allTagrules
          !!ce = !allTagrules[!index].dbref()
          LINKREF $!tempTagrules[$!index]
          handle ANY
            -- May not be possible
          endhandle
        enddo
      endif
    enddo
  enddo

  -- Position at the drawing.
  DRWG
  -- For all ABA templates we want to unset the SPPURP
  var !allWithABAT collect all with (SPPURP eq 'ABAT') for ce
  do !i indices !allWithABAT
    !!ce = !allWithABAT[!i].dbref()
    SPPURPOSE unset
  enddo
  DRWG

  -- Navigate back to the new drawing
  !!ce = !newSheet

  !!ce = !memory

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createElement
--
-- Description: Method to create the new element (like DRA CLIB ICREATE)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      The prefix for the new element
--    2    R      STRING      The type of the new element
--    3    R      STRING      Where to create the new element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createElement(!prefix is STRING, !elementType is STRING, !where is STRING)

  -- This method only works when !where is 'ce'
  if (!where.lowcase() eq 'ce') then

    -- First check we are in the correct DB type
    if (!!ce.dbtype neq 'PADD') then
      switch
    endif

    -- Test we can write to this element
    if (!!ce.dbwrite.not()) then
      !!pipeSketchesLog('Cannot create ' & !elementType.upcase() & ' here: Read Only Database')
      return error 1 noalert
    endif

    -- So what if we at a valid element but cannot create a new element because of DAC or claim or RO reasons

    -- Create the new element
    !command = 'NEW ' & !elementType
    $!command
    handle ANY
      !!pipeSketchesLog('Cannot create ' & !elementType.upcase() & ' here: ' & !!error.text)
      handle ANY
        -- In case concatenated text is too long
        !!pipeSketchesLog(!!error.text.after(')'))
      endhandle
      return error 1 noalert
    endhandle

    -- Assume a set star style concatenated name
    !owner = !!ce.owner
    if (!owner.isNamed) then
      !ownerName = !owner.name.after('/') & '/'
    else
      !ownerName = ''
    endif

   -- Formulate the name
   do !i
     if (!this.pipeSpool.isNamed) then
       !newName = '/' & !this.pipeSpool.namn & '/' & !prefix & !i
     else
       !newName = '/Spool' & !this.pipeSpool.namn.after('=') & '/' & !prefix & !i
     endif
     !unusedTestNameDefault = object DBREF(!newName)
     handle ANY
       -- name not used
       !command = 'NAME ' & !newName
       $!command
       break
     elsehandle NONE
       -- name already exists, stay in loop
     endhandle
   enddo

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      makeSketch
--
-- Description: Do the work to make the actual sketch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makeSketch(!drawing is DBREF)

  !memory = !!ce

  -- Navigate to the element
  !!ce = !drawing

  -- Set a new title for the drawing
  TITLE 'Pipe Sketch - Spool $!this.pipeSpool.namn'

  -- Record this new drawing as a member of this object
  !this.drawing = !!ce

  SHEE 1
  handle ANY
    !!pipeSketchesLog(|Drawing does not have a sheet|)
    return
  endhandle

  -- Make sure all tables are built to 0 decimal places when in metric units
  if (!!distanceFmt.units.upcase() eq 'MM') then
    !savedDecimalPlaces = !!distanceFmt.dp
    !!distanceFmt.dp = 0
  endif

  -- Set a new title for the sheet
  TITLE '$!this.pipeSpool.namn'
  -- Record this new drawing as a member of this object
  !this.sheet = !!ce

  -- Record the Backing Sheet
  !this.backingSheet = !!ce.bsrf

  -- Get the mto headings from the backing sheet
  !backingSheet = !this.backingSheet.name
  handle ANY
    !!pipeSketchesLog('ERROR - Cannot create sketch because : Backing Sheet not found')
    return
  endhandle

  -- Collect the table entry notes from the backing sheet
  var !cells collect all note with (SPPURP eq 'CELLS' and FUNC eq 'MTO') for $!backingSheet

  -- Record the MTO headings
  !this.mtoHeadings = !this.readMtoHeadings(!cells[1].dbref())
  handle ANY
  endhandle

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Elements for all MTO tags
  !this.mtoTags = !pipeSpoolManager.getMtoElements(!this.pipeSpool)
  !this.testformitres()

  !sheet = !!ce

  -- Get all the tables of information
  !!pipeSketchesLog('Getting all Tables')
  !this.getAllTables(!sheet, 'ALL')

  !!ce = !sheet

  -- Get the current brand
  !moduleObject = object MODULE()
  !productFamily = !moduleObject.productFamily
  if (!productFamily.eq('Marine')) then
    if (!!module().modKey.upcase().eq('MARDRA')) then
      -- This means that drawings created by Marine drafting can be modified only by Marine drafting
      -- and drawings created by Marine outfitting draft can be modified only by Marine outfitting draft
      !!pipeSketchesLog('Drawing generated from Marine Drafting')
      -- Set the marine drawing type
      input begin
        marptype 7
      input finish
    else
      !!pipeSketchesLog('Drawing generated from Marine Outfitting Draft')
    endif
  endif

   -- Collect all views
   !smallestScale = 1
   var !views collect all view for ce
   --Add the pipe spool or pipe piece to the view and autoscale it
   do !i indices !views
     !view = !views[!i].dbref()
     if (!view.sppurp.eq('PSKTCH').not()) then
       !!pipeSketchesLog('ERROR - Views must have specific purpose (SPPURP) of PSKTCH')
     endif
     !!ce = !view

     -- Capture the idList of the current drawing
     -- need to be updated for fix generation spool drawing problem on TTY mode
     VAR !device DEVICE
     if (!device.upcase().eq('GRAPHICS')) then
      !idli = object IDLIST(!view.idln)
      !idli.add(!this.pipeSpool)
     else
      !!ce = !view.idln
      add $!<this.pipeSpool>
      same
     endif
     lfra FALSE
     auto
     handle ANY
       !!pipeSketchesLog('Unable to auto Pipe Spool - probably a bad definition')
     endhandle
     -- To ensure all views are the same scale
     !viewScale = !!ce.vscale
     if (!viewScale lt !smallestScale) then
       !smallestScale = !viewScale
     endif
   enddo
   -- Set all the views to the same scale
   do !i indices !views
     !view = !views[!i].dbref()
     !!ce = !view
      vscale $!smallestScale
      update design
     handle ANY
       !!pipeSketchesLog('Unable to update Design the view of the Pipe Spool - probably a bad definition')
     endhandle
   enddo

  -- Do the dimensioning
  !!pipeSketchesLog('Dimensioning views')
  !this.dimensionViews()

  -- Do the tagging of end points
  !!pipeSketchesLog('Tagging End Points in views')
  !this.tagViewsEndPoints()

  -- Do the tagging of assembly planes
  !!pipeSketchesLog('Tagging Assembly Planes in views')
  !this.tagViewsAssemblyPlanes()

  -- Do the tagging of component numbers (Put this tag last will arrange all tags)
  !!pipeSketchesLog('Tagging MTO in views')
  !this.tagViews()

  -- Make sure all tables are set back to original decimal places when in metric units
  if (!!distanceFmt.units.upcase() eq 'MM') then
    !!distanceFmt.dp = !savedDecimalPlaces
  endif

-- Start TMTMTMTMTMTMTMTMTMTMTM

  -- Loop through each view and find where it is positioned on the sheet.
  -- This is so we can position the dimensioning
  shee
  !sheetSize = size
  -- Collect all views
  var !realViews coll all view with sppurp eq 'PSKTCH' for ce
  do !loopThroughViews from 1 to !realViews.size()
  -- Get extremities of view
    !viewXypo = !realViews[$!loopThroughViews].dbref().xypo
    !size  = !realViews[$!loopThroughViews].dbref().size
    !xmin = !viewXypo.east - (!size[1] / 2)
    !xmid = !viewXypo.east
    !xmax = !viewXypo.east + (!size[1] / 2)
    !ymin = !viewXypo.north - (!size[2] / 2)
    !ymid = !viewXypo.north
    !ymax = !viewXypo.north + (!size[2] / 2)
    -- Access the dimension layer
    !viewName = !realViews[$!loopThroughViews].dbref().name
    !dimLayerName = !viewName + '/USER_Dims'
    !!ce = !dimLayerName.dbref()
      handle NONE
        -- Collect all the dimensions
        var !allDims coll all ldim for ce
        do !loopThroughDims values !allDims
          !!ce = !loopThroughDims.dbref()
          -- Access the first dimension point
          1
            handle NONE
              -- skip if the dimension is on a mitre
              if !!ce.ddname.type.eq('BEND') then
                 !ncuts = !!ce.ddname.actncu
                 handle any
                    !ncuts = 0
                endhandle
                if !ncuts.neq(0) then
                   if !!ce.owner.name.match('/').eq(1) then
                     skip
                   endif
                endif
              endif
              -- Work out where the ddnm is located in the view
              var !viewSide vside of ddnm
              if !viewSide.upcase().match('LEFT').gt(0) then
                !xdef = !xmin
              else
                !xdef = !xmax
              endif
              if !viewSide.upcase().match('DOWN').gt(0) then
                !ydef = !ymin
              else
                !ydef = !ymax
              endif
              -- If the member is in the middle then set the correct size dependant
              -- on where the view is within the sheet.
              var !testIfInMiddle shpos of ddnm
              -- typical imperial output  'X 3.257/512 Y 7.929/1024'
              !xpos = !testIfInMiddle.after('X').before('Y').trim()
              if !xpos.match('/').gt(0) then
                !xpos = !this.convertToDecimal(!xpos)
              endif
              !ypos = !testIfInMiddle.after('Y').trim()
              if !ypos.match('/').gt(0) then
                !ypos = !this.convertToDecimal(!ypos)
              endif
              if !xpos.real().int().eq(!xmid.int()) then
                !xdef = !xmin
              endif
              if !ypos.real().int().eq(!ymid.int()) then
                !ydef = !ymin
              endif
              if !xpos.real().lt(!sheetSize[1] / 2) then
                -- !x =  !sheetSize[1] / 2
                !xdef = !xmin
              else
                !xdef = !xmax
              endif
              if !ypos.real().lt(!sheetSize[2] / 2) then
                !ydef = !ymin
              else
                !ydef = !ymax
              endif
              -- Access the dimension and then reset the dimension line position
              ldim
              dpos $!xdef $!ydef
                handle ANY
                endhandle
            elsehandle ANY
            endhandle
        enddo
      elsehandle ANY
      endhandle
  enddo

-- END TMTMTMTMTMTMTMTMTMTMTMTM

  -- Navigate to Drawing
  !!ce = !memory

endmethod

------------------------------------------------------------------------
--
-- Method:      convertToDecimal
--
-- Description: convert the X and Y portions of a string like this
--              'X 3.257/512 Y 7.929/1024' to Decimal
--
-- Method Type: Function/Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      like 3.257/512
--
-- Return:
--   [Data Type] [Description]
--     STRING   string DECIMAL Conversion
--
------------------------------------------------------------------------
define method .convertToDecimal(!input is STRING)is STRING

!return = '0'
!start = !input.before('/')
!end   = !input.after('/')
!return = (!start / !end).string()
handle ANY
endhandle

return !return

endmethod

------------------------------------------------------------------------
--
-- Method:      createTable
--
-- Description: Create at a table
--
-- Method Type: Function/Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Sheet
--    2    R     STRING      Type of Table ('BENDINGA', 'BENDING', 'WELDING', 'MTO', 'ASSEMBLY')
--    3    R     REAL        The length of the table so a second Table can continue at the XY position of the bottom of the table
--    4    R     ARRAY       Array to be put in the cells of the table
--    5    R     STRING      Position as a string 'x100mm y100mm' or key word 'BackingSheetPosition'
-- Return:
--   [Data Type] [Description]
--     STRING   End Position of the table in XY coordinates as a string
--
------------------------------------------------------------------------
define method .createTable(!passedSheet is DBREF, !tableType is STRING, !pipePieceCount is REAL, !passedArray is ARRAY, !position is STRING ) is STRING

  !memory = !!ce
  !result = 'BackingSheetPosition'

  -- Use the 2 passed dimensional array
  !cell = ARRAY()
  !cell = !passedArray

  -- Navigate to sheet
  !!ce = !passedSheet
  setstar
  tail
  !sheet = !passedSheet.name
  !backingSheet = !!ce.bsrf.name

  -- Collect the table entry notes from the backing sheet
  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet
  var !cells collect all note with (SPPURP eq 'CELLS' and FUNC eq !tableType) for $!backingSheet

  -- Get the name of the note
  !cellsName = !cells[1].dbref().name
  !tableName = !table[1].dbref().name

  -- Get the direction of the build from the STRA element in the table note.
  !straElement = !tableName & '/ColumnLine1'
  if (!straElement.dbref().adeg eq 90) then
    !buildDirection = 'Y'
  else
    !buildDirection = 'Y -'
  endif

  -- Copy the table notes from the backing sheet (copy like will not copy the table notes, we'll copy these as required)
  new note */$!tableType$n.table$!pipePieceCount copy $!tableName rename $!tableName */$!tableType$n.table$!pipePieceCount
  !newTableName = !!ce.name
  lvis TRUE
  if (!position neq 'BackingSheetPosition') then
      xypos $!position
  endif
  new note */$!tableType$n.tableEntries$!pipePieceCount copy like $!cellsName
  var !xypos (xypos of $!cellsName )
  xypos $!xypos
  lvis true
  if (!position neq 'BackingSheetPosition') then
      xypos $!position
  endif
  setstar

  -- Count the TEXP's named /Column because there may be extra texps in there
  !numberOfColumns = 0
  do !i indices !cells[1].dbref().members
    if (!cells[1].dbref().members[!i].type eq 'TEXP' and !cells[1].dbref().members[!i].name.match('/Column').gt(0)) then
      !numberOfColumns = !numberOfColumns + 1
    endif
  enddo

  -- Get the cell spacing from the length of the STRA element in the table note
  !cellSpacing = !straElement.dbref().length

  !memory2 = !!ce
  -- Use the passed ARRAY and create texp elements
  do !row indices !cell
    !column = 0
    do from 1 to !numberOfColumns
      !column = !column + 1
      !entry      = !cell[!row][!column]
      !cellName   = 'cell' & !row.string() & '.' & !column.string()
      !copiedFrom = !cellsName & '/Column' & !column.string()
      new texp */$!pipePieceCount/$!cellName copy $!copiedFrom
      if (!entry eq '') then
        !entry = ' '
      endif
      btex |$!entry|
      !copyBy = !cellSpacing * (!row - 1)
      by $!buildDirection$!copyBy
    enddo
    -- There may also be a line to copy
    !lineName   = 'line' & !row.string()
    !copiedFrom = !cellsName & '/Line'
    new stra */$!pipePieceCount/$!lineName copy $!copiedFrom
    handle ANY
      skip
    endhandle
    !copyBy = !cellSpacing * (!row - 1)
    by $!buildDirection$!copyBy
  enddo

  -- Use the passed ARRAY and modify stra elements
  !column = -1
  !loop = !numberOfColumns + 1
  do from 1 to !loop
    !column = !column + 1
    !lineName = 'line' & !column.string()
    !modifyElement = !newTableName & '/ColumnLine' & !column.string()
    $!modifyElement
    handle ANY
      -- This is because it may be that some lines are not to be extended. (Suggest that in BSRF note these are named */FixedLineN )
      skip
    endhandle
    !oldLength = !!ce.length
    !newLength = ((!oldLength) + (!cellSpacing * (!row)))
      length $!newLength
      if (!column eq 0) then
        var !result TPT
        !result = 'X' & !result.after('X')
      endif
  enddo

  -- Position the last line
  !modifyElement = !newTableName & '/LastLine'
  $!modifyElement
  handle ANY
  elsehandle NONE
    at $!result
  endhandle

  -- This prevents the explorer tree opening each note member list
  !!ce = !memory2

  -- Refresh the graphics
  --  REFRESH
  --  handle ANY
  --  endhandle

  !!ce = !memory

  -- Return the end position of the table
  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getAllTables
--
-- Description: Get all tables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      DBREF of the new sheet
--    2    R     STRING     Type of Table ('BENDING', 'WELDING', 'MTO', 'ASSEMBLY', 'ALL')
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllTables(!passedSheet is DBREF,!tableType is STRING )

  !memory = !!ce
    -- Get all the members of the spool (Pipe at the moment)
  !pipePieces = ARRAY()
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !pipePieces = !pipeSpoolManager.getPipePieces(!this.pipeSpool)

  if (!tableType eq 'ALL') then
    !table = !this.getMtoTable()

    !this.createTable(!passedSheet, 'MTO', 1, !table, 'BackingSheetPosition')
    handle ANY
      !!pipeSketchesLog('Error creating MTO table')
    endhandle
    !table = !this.getWeldingTable()
    if (!table.size() gt 0) then
      !this.createTable(!passedSheet, 'WELDING', 1, !table, 'BackingSheetPosition')
      handle ANY
        !!pipeSketchesLog('Error creating WELDING table')
      endhandle
    endif
    !table = !this.getAssemblyTable()
    !this.createTable(!passedSheet, 'ASSEMBLY', 1, !table, 'BackingSheetPosition')
    handle ANY
      !!pipeSketchesLog('Error creating ASSEMBLY table')
    endhandle

    --Initialise a position
    !newPosition = 'BackingSheetPosition'

    do !i indices !pipePieces
    if (!i eq 1) then
      !table = !this.getBendingTable(!pipePieces[!i])
      if (!table.size() gt 0) then
        !newPosition = !this.createTable(!passedSheet, 'BENDING', !i, !table, 'BackingSheetPosition')
        handle ANY
          !!pipeSketchesLog('Error creating BENDING table')
        endhandle
      endif
      !table = !this.getBendingActivityTable(!pipePieces[!i])
      if (!table.size() gt 0) then
        !newPosition = !this.createTable(!passedSheet, 'BENDINGA', !i, !table, !newPosition)
        handle ANY
          !!pipeSketchesLog('Error creating BENDING Activity table')
        endhandle
      endif
    else
      !table = !this.getBendingTable(!pipePieces[!i])
      if (!table.size() gt 0) then
        !newPosition = !this.createTable(!passedSheet, 'BENDING', !i, !table, !newPosition)
        handle ANY
          !!pipeSketchesLog('Error creating BENDING table')
        endhandle
      endif
      !table = !this.getBendingActivityTable(!pipePieces[!i])
      if (!table.size() gt 0) then
        !newPosition = !this.createTable(!passedSheet, 'BENDINGA', !i, !table, !newPosition)
        handle ANY
          !!pipeSketchesLog('Error creating BENDING Activity table')
        endhandle
      endif
    endif
    enddo

    !table = !this.getEndPointTable()
    !this.createTable(!passedSheet, 'ENDPOINT',  1, !table, 'BackingSheetPosition')
    handle ANY
      !!pipeSketchesLog('Error creating ENDPOINT table')
    endhandle
  endif

  !!ce = !memory

endmethod
------------------------------------------------------------------------
--
-- Method:      getMtoTable
--
-- Description: Get MTO table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      This will probably be a pipe piece dbref or Assembly dbref
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getMtoTable( ) is ARRAY

  !headings = ARRAY()
  if (!this.mtoHeadings.set() and !this.mtoHeadings.size() gt 0) then
    !headings = !this.mtoHeadings
  endif

  -- Get the table from the Pipe Spool

  --Sort out the array for the mto table depending on the type of a component
  !mtoCol = object COLLECTION()
  !mtoCol.scope(!this.mtoTags)
  !expCol = object EXPRESSION()

  !expCol.expression('dtxrtext neq |TEE SET ON|')
  !mtoCol.filter(!expCol)

  !this.mtoTags = !mtoCol.results()

  -- Elements for the Rows of the Table
  !rows = ARRAY()
  if (!this.mtoTags.set() and !this.mtoTags.size() gt 0) then
    do !row values !this.mtoTags
      skip if !row.string().match('IL TUB').gt(0)
      !rows.append (!row)
    enddo
    !this.mtoTags = !rows
  endif
  -- Values for the columns of each row
  !columns = !this.mtoHeadings

  -- Create a 2 dimensional array *****************
  !result = ARRAY()
  do !i indices !rows
    !result[!i] = ARRAY()
    do !j indices !columns
      !result[!i][!j] = '---'
      if (!columns[!j].upcase() eq 'TAG') then
        -- Special case
        !result[!i][!j] = !i.string()
      elseif (!columns[!j].upcase() eq 'QUANTITY') then
        -- Special case
        if (!rows[!i].type eq 'PPIECE') then
          !result[!i][!j] = !rows[!i].ppcutl.string(!!distanceFmt)
          handle ANY
          endhandle
          if !rows[!i].aelrfa.size().eq(1).and(!this.isitacutmitre(!rows[!i].aelrfa[1]).gt(0)) then
            -- its a bend pipe piece
             !result[!i][!j] = !rows[!i].aelrfa[1].bsmxl.string(!!distanceFmt)
             handle ANY
             endhandle
          --elseif !this.isitacutmitre(!rows[!i].aelrfa[1]).gt(0).or(!this.isitacutmitre(!rows[!i].aelrfa[2]).gt(0)) then
          --     !result[!i][!j] = !rows[!i].aelrfa[1].ltlen.string(!!distanceFmt)
          endif
        else
          !result[!i][!j] = '1'
        endif
      elseif (!columns[!j].upcase() eq 'UNITS') then
        -- Special case
        if (!rows[!i].type eq 'PPIECE') then
          !result[!i][!j] = !!comFormats.getCurrentUnit('DIST')
          handle ANY
          endhandle
          -- Cosmetic
          if (!result[!i][!j] eq 'mm' or !result[!i][!j] eq 'cm' or !result[!i][!j] eq 'metre') then
            !result[!i][!j] = 'mm'
          elseif (!result[!i][!j] eq 'in') then
            !result[!i][!j] = 'inches'
          elseif (!result[!i][!j] eq 'FINC' or !result[!i][!j] eq 'ft') then
            !result[!i][!j] = 'ft/in'
          endif
        else
          !result[!i][!j] = 'Pieces'
        endif
      elseif (!columns[!j].upcase() eq 'BUILD') then
        -- Special case
        if (!rows[!i].type eq 'PPIECE') then
          !result[!i][!j] = !rows[!i].ppfinl.string(!!distanceFmt)
          handle ANY
          endhandle
          if !rows[!i].aelrfa.size().eq(1).and(!this.isitacutmitre(!rows[!i].aelrfa[1]).gt(0)) then
            !result[!i][!j] = !rows[!i].aelrfa[1].bsmnl.string(!!distanceFmt)
          endif
        else
          !result[!i][!j] = !rows[!i].fitlen.string(!!distanceFmt)
          handle ANY
          endhandle
        endif

      else



        -- It must be just any attribute
        -- We need to have a way of knowing if a core attribute is a distance for formatting
        var !testUnit attdef $!columns[$!j] unit
        handle ANY
        elsehandle NONE
          if (!testUnit[1] eq 'DIST') then
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string(!!distanceFmt)
            handle ANY
            endhandle
          else
            !result[!i][!j] = !rows[!i].attribute(!columns[!j]).string()
            handle ANY
            endhandle
            -- Handle special characters
            if (!result[!i][!j].match('#') gt 0) then
              !result[!i][!j] = !result[!i][!j].replace('#', '##')
            endif
          endif
        endhandle
      endif
      -- Special case
       if (!rows[!i].type eq 'PPIECE') then
        if !rows[!i].aelrfa.size().eq(1).and(!this.isitacutmitre(!rows[!i].aelrfa[1]).gt(0))  then

            if (!columns[!j].upcase() eq 'DTXR') then
               !result[!i][!j] = !rows[!i].lstu.dtxr
               handle ANY
               endhandle
            elseif (!columns[!j].upcase() eq 'MTXX') then
               !result[!i][!j] = !rows[!i].lstu.mtxx
               handle ANY
               endhandle
            endif
         endif
       endif
    enddo
  enddo

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getEndPointTable
--
-- Description: Get end point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getEndPointTable() is ARRAY

  -- Get the table from the Pipe Spool

  !memory = !!ce

  -- Get the Start Positions
  !unusedTestC = !this.pipeSpool.psarfa[1].type
  handle ANY
    !!pipeSketchesLog('Pipe Spool psarfa not set')
  endhandle
  do !i indices !this.pipeSpool.psarfa
    if (!this.pipeSpool.psarfa[!i].type eq 'BRAN') then
      !firstPosition[!i] = !this.pipeSpool.psarfa[!i].hpos.wrt(/* )
    else
      !firstPosition[!i] = !this.pipeSpool.psarfa[!i].lpos.wrt(/* )
    endif
  enddo

  -- Get the End Position
  !unusedTestD = !this.pipeSpool.pslrfa[1].type
  handle ANY
    !!pipeSketchesLog('Pipe Spool pslrfa not set')
  endhandle
  do !i indices !this.pipeSpool.pslrfa
    if (!this.pipeSpool.pslrfa[!i].type eq 'BRAN') then
      !lastPosition[!i] = !this.pipeSpool.pslrfa[!i].tpos.wrt(/* )
    else
      !lastPosition[!i] = !this.pipeSpool.pslrfa[!i].apos.wrt(/* )
    endif
  enddo

  -- Get the X,Y and Z of the position
  -- Create a 2 dimensional array *****************
  !result = ARRAY()
  !starts = !this.pipeSpool.psarfa.size()
  !countConnection = 0
  do !start indices !this.pipeSpool.psarfa

    if !this.pipeSpool.psarfa[!start].type.eq('BRAN') then
      !href = !this.pipeSpool.psarfa[!start].href
      if unset(!href) eq false then
        if !href.type inset ('TEE', 'OLET') then
          !countConnection = !countConnection + 1
          skip
        endif
      endif
    endif

    !result[!start - !countConnection] = ARRAY()
    !result[!start - !countConnection][1] = 'C' & string(!start - !countConnection)
    -- ???????????????? Ship reference system in here.
    !result[!start - !countConnection][2] = !firstPosition[!start].east.string(!!distanceFmt)
    !result[!start - !countConnection][3] = !firstPosition[!start].north.string(!!distanceFmt)
    !result[!start - !countConnection][4] = !firstPosition[!start].up.string(!!distanceFmt)

  enddo

  do !end indices !this.pipeSpool.pslrfa
    if !this.pipeSpool.pslrfa[!end].type.eq('BRAN') then
      !tref = !this.pipeSpool.pslrfa[!end].tref
      if unset(!tref) eq false then
        if !tref.type inset ('TEE', 'OLET') then
          !countConnection = !countConnection + 1
          skip
        endif
      endif
    endif

    !count = !starts + !end
    !result[!starts + !end - !countConnection] = ARRAY()
    !result[!starts + !end - !countConnection][1] = 'C' & string(!count - !countConnection)
    -- ???????????????? Ship reference system in here.
    !result[!starts + !end - !countConnection][2] = !lastPosition[!end].east.string(!!distanceFmt)
    !result[!starts + !end - !countConnection][3] = !lastPosition[!end].north.string(!!distanceFmt)
    !result[!starts + !end - !countConnection][4] = !lastPosition[!end].up.string(!!distanceFmt)

  enddo

  !!ce = !memory

  return !result

endmethod

------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: Get bending table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      This will be a pipe piece dbref
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getBendingTable(!pipePiece is DBREF ) is ARRAY

  -- Checksum is not implemented

  -- Initialise Variables
  !result = ARRAY()
  !pipePieceIndex = '---'
  !bendingMachine = '---'
  !bendingMachineClutch = '---'
  !bendingMachineCheckSum = '---'

  -- Get the table from the Pipe Spool

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Bending Table
  !bendingTables = !pipeSpoolManager.getBendingTables(!this.pipeSpool)
  -- Welding Table
  !weldingTables = !pipeSpoolManager.getWeldingTables(!this.pipeSpool)

  -- Find the bending and welding table for this pipe piece
  -- Loop through the array to find the index of the array where .pipePiece matches !pipePiece
  !index = 0
  do !i indices !bendingTables
    if (!bendingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !bendingTable = !bendingTables[!index]
  handle ANY
    -- I assume there is no bending of this pipe piece
    return !result
  endhandle
  !index = 0
  do !i indices !weldingTables
    if (!weldingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !weldingTable = !weldingTables[!index]
  handle ANY
    -- I assume there is no bending of this pipe piece
    return !result
  endhandle


  -- Get the pipe Piece index for the MTO Elements array .findFirst method
  !pipePieceIndex = !this.mtoTags.findFirst(!pipePiece).string()
  -- Get the bending machine directly from the object
  !bendingMachine = !bendingTable.bendingMachine().namn
  -- Get the bending machine check sum directly from the object
  !bendingMachineCheckSum = !bendingTable.checkSum().string(!!distanceFmt)
  handle ANY
    -- Because the checksum is not implemented at VM11.6 SP1
  endhandle

  -- Code to get Bending Machine Clutch tag
  if (!bendingTable.clutchArriveTube()) then
    if (!weldingTable.arriveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoTags.findFirst(!weldingTable.arriveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'Start'
    endif
  else
    if (!weldingTable.leaveFlangeWelded()) then
      !bendingMachineClutch = !this.mtoTags.findFirst(!weldingTable.leaveFlange()).string()
    else
      -- Need the end point tag
      !bendingMachineClutch = 'End'
    endif
  endif

  !result[1] = ARRAY()
  !result[1][1] = !pipePieceIndex
  !result[1][2] = !bendingMachine
  !result[1][3] = !bendingMachineClutch
  !result[1][4] = !bendingMachineCheckSum

  -- Example return array
  --    -- Create a 2 dimensional array ***************** Only ever 1 line long
  --  !result = ARRAY()
  --  !result[1] = ARRAY()
  --  !result[1][1] = '01'
  --  !result[1][2] = '2'
  --  !result[1][3] = '2B'
  --  !result[1][4] = '2345'

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getBendingActivityTable
--
-- Description: Get bending activities table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      This will be a pipe piece dbref
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getBendingActivityTable(!pipePiece is DBREF ) is ARRAY

  -- Initialise Variables
  !result = ARRAY()

  -- Get the table from the Pipe Spool

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Bending Table
  !bendingTables = !pipeSpoolManager.getBendingTables(!this.pipeSpool)

  -- Find the bending table for this pipe piece
  -- Loop through the array to find the index of the array where .pipePiece matches !pipePiece
  !index = 0
  do !i indices !bendingTables
    if (!bendingTables[!i].pipePiece() eq !pipePiece) then
      !index = !i
      break
    endif
  enddo
  !bendingTable = !bendingTables[!index]
  handle ANY
    -- I assume there is no bending of this pipe piece
    return !result
  endhandle

 do !i indices !bendingTable.activities()

   -- Get the feed directly from the object
   !feed = !this.formatUnits(!bendingTable.activities()[!i].feed())
   -- Get the rotate directly from the object
   !rotate = !bendingTable.activities()[!i].rotate().string('D2')
   -- Get the bend directly from the object
   !bend = !bendingTable.activities()[!i].bend().string('D2')

   !result[!i] = ARRAY()
   !result[!i][1] = !feed
   !result[!i][2] = !rotate
   !result[!i][3] = !bend

  enddo


  -- Example return array
  -- Create a 2 dimensional array *****************
  --  !result = ARRAY()
  --  !result[1] = ARRAY()
  --  !result[1][1] = '300'
  --  !result[1][2] = '0.0'
  --  !result[1][3] = '90.0'
  --  !result[2] = ARRAY()
  --  !result[2][1] = '400'
  --  !result[2][2] = '45.0'
  --  !result[2][3] = '90.0'

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getWeldingATable
--
-- Description: Get welding table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getWeldingTable( ) is ARRAY

  -- Core returns a weldingMachine dbref but this is not on sketch

  -- Get the table from the Pipe Spool

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Welding Table
  -- Get the pipe piece data for the pspool
  !weldingTables = !this.pipeSpool.pprfa

  -- Initialise variable
  !result = ARRAY()

  do !i indices !weldingTables

    --Get the data for the weld arrive / leave flange from the pipe piece
    !pipePiece =  !weldingTables[!i]
    !weldArrive = !pipePiece.awdarr
    !weldLeave = !pipePiece.awdlev
    !pieceComponent = !this.pipeSpool.belrfa

    -- Which welding Table
    !weldingTable = !weldingTables[!i]
    !arriveFlangeTag = ''
    !leaveFlangeTag  = ''
    !relativeAngle   = ''

    -- Get the connection 1
    if (!weldArrive) then
      -- Get the flange tag index for the MTO Elements array .findFirst method
      !arriveFlangeTag = !this.mtoTags.findFirst(!pieceComponent.first()).string()
      handle ANY
        !!pipeSketchesLog('Welding Table Arrive Flange error')
      endhandle
    endif
    -- Get the connection 2
    if (!weldLeave) then
      -- Get the flange tag index for the MTO Elements array .findFirst method
      !leaveFlangeTag = !this.mtoTags.findFirst(!pieceComponent.last()).string()
      handle ANY
        !!pipeSketchesLog('Welding Table Leave Flange error')
      endhandle
    endif

    -- Get the relative angle directly from the object
    !weldingTableForAngle = !pipeSpoolManager.getWeldingTables(!this.pipeSpool)
    !relativeAngle = !weldingTableForAngle[!i].angle().string('D2')
    handle ANY
      !!pipeSketchesLog('Welding Table relative angle error')
    endhandle

    -- Only record result if relevant
    if (!arriveFlangeTag.eq('') and !leaveFlangeTag.eq('') and !relativeAngle eq '0') then
      skip
    elseif !weldArrive.eq(false) and !weldLeave.eq(false) then
    -- Skip if there is no welding table available.
      skip
    else
      !result[!i] = ARRAY()
      !result[!i][1] = !arriveFlangeTag
      !result[!i][2] = !leaveFlangeTag
      !result[!i][3] = !relativeAngle
    endif

  enddo

  -- Compress the result array
  !result.unique()

  --if the result is null, create a minimum array for the welding table.
  --Otherwise there will no line for the table.
  if !result.size().eq(0)then
    !result = ARRAY()
    !result[1] = ARRAY()
    !result[1][1] = ''
    !result[1][2] = ''
    !result[1][3] = ''
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  elseif !result.size().eq(1)then
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  endif
  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getAssemblyTable
--
-- Description: Get assembly table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getAssemblyTable( ) is ARRAY

  -- Initialise variable
  !result = ARRAY()

  -- Get the table from the Pipe Spool

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Assembly Activity Table
  !assemblyTables = !pipeSpoolManager.getActivityTables(!this.pipeSpool)

  !entryCount = 0
  --Array for the new result of Stub
  --!entryCountStub = 0
  --!resultStub = ARRAY()

  do !i indices !assemblyTables

    -- What type of Activity
    -- ** Flange **
    if (!assemblyTables[!i].objectType() eq 'FLANGEASSEMBLYACTIVITY') then

      !flangeActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!flangeActivity.component()).string()

      -- Get the angle and direction from a component
      -- If the angle of a component is 180 / 90 degree, make it as 0.
      !zAngle = !flangeActivity.component().orientation.zDir().string().part(2)
      if !zAngle.neq('WRT') then
        !rotate = !flangeActivity.component().orientation.zDir().string().part(2).real().string('D2')
      else
        !rotate = '0'
      endif
      -- Calculate the angle of a flange component depending on the number of its bolt holes
      !rotate = !this.getFlangeAngle(!flangeActivity.component(),!rotate.real()).string()

      !zDir = !flangeActivity.component().orientation.zDir()
      if !zDir.string().substring(1,1).eq('-') then
         !rotate = '-' & !rotate
         if !zAngle.eq('WRT')  then
           !rotate = substring(!rotate, 2)
         endif
      endif

      if (!rotate.match('9999').eq(1)) then
        !rotate = '?'
        !!pipeSketchesLog(|Assembly Table - Error with rotation of flange. Rotate value given as '?' because the Catalogue PZaxis is unset|)
      endif
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      if (!flangeActivity.referencePlaneComponent().set() and !flangeActivity.referencePlaneComponent().badref().not()) then
        if (!flangeActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!flangeActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!flangeActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !flangeActivity.referencePlaneComponent().tyseq
      else
        !planeRef = '---'
      endif
      !remarks = !planeRef

      !entryCount = !entryCount + 1

    -- ** Branch Piece **
    elseif (!assemblyTables[!i].objectType() eq 'BRANCHPIECEASSEMBLYACTIVITY') then

      !branchActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!branchActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = !branchActivity.rotationAngle().string('D2')
      -- Get the incline directly from the object
      !incline = !branchActivity.inclinationAngle().string('D2')
      -- Get the turn directly from the object
      !turn = !branchActivity.offsetAngle().string('D2')

      -- if the type of a component is 'TEE', skip it.
      if !branchActivity.component().type.eq('TEE') then
        -- P-40101 and P-40102 do not skip if tee is a set-on (has zero length)
        if !branchActivity.component().fitlength.gt(0) then
           skip
        endif
      endif

      -- Get the remarks directly from the object
      if (!branchActivity.referencePlaneComponent().set() and !branchActivity.referencePlaneComponent().badref().not()) then
        if (!branchActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!branchActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!branchActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !branchActivity.referencePlaneComponent().tyseq
      else
        !planeRef = '---'
      endif
      !remarks = !planeRef & ' : ' & !branchActivity.branchConnection().string()

      !entryCount = !entryCount + 1

    -- ** Elbow **
    elseif (!assemblyTables[!i].objectType() eq 'ELBOWASSEMBLYACTIVITY') then

      !elbowActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!elbowActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = !elbowActivity.offsetAngle().string('D2')
      -- Get the remarks directly from the object
      if (!elbowActivity.referencePlaneComponent().set() and !elbowActivity.referencePlaneComponent().badref().not()) then
        if (!elbowActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!elbowActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!elbowActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !elbowActivity.referencePlaneComponent().tyseq
      else
        !planeRef = '---'
      endif
      !remarks = !planeRef

      !entryCount = !entryCount + 1

    -- ** Mitre **
    elseif (!assemblyTables[!i].objectType() eq 'MITREASSEMBLYACTIVITY') then

      !mitreActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!mitreActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = !mitreActivity.cutAngle().string('D2')
      -- Get the turn directly from the object
      !turn = !mitreActivity.offsetAngle().string('D2')
      -- Get the remarks directly from the object
      if (!mitreActivity.referencePlaneComponent().set() and !mitreActivity.referencePlaneComponent().badref().not()) then
        if (!mitreActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!mitreActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!mitreActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !mitreActivity.referencePlaneComponent().tyseq
      else
        !planeRef = '---'
      endif
      !remarks = 'MITRE :' & !planeRef

      !entryCount = !entryCount + 1

    -- ** Cut **
    elseif (!assemblyTables[!i].objectType() eq 'CUTASSEMBLYACTIVITY') then

      !cutActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!cutActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'

      -- Get the incline from the object
      if (!cutActivity.arriveEnd()) then
        !incline = 'Start'
      else
        !incline = 'End'
      endif
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      if (!cutActivity.referenceComponent().set() and !cutActivity.referenceComponent().badref().not()) then
        -- Read position number
        !refComponent = !this.mtoTags.findFirst(!cutActivity.referenceComponent()).string()
      else
        !refComponent = '---'
      endif

      !remarks = 'CUT :' & !refComponent & ' : ' & !cutActivity.finalLength().nint().string()

      !entryCount = !entryCount + 1

    -- ** Split **
    elseif (!assemblyTables[!i].objectType() eq 'SPLITASSEMBLYACTIVITY') then

      !splitActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!splitActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      if (!splitActivity.referenceComponent().set() and !splitActivity.referenceComponent().badref().not()) then
        -- Read position number
        !refComponent = !this.mtoTags.findFirst(!splitActivity.referenceComponent()).string()
      else
        !refComponent = '---'
      endif
      !remarks = 'SPLIT :' & !refComponent & ' : ' & !this.formatUnits(!splitActivity.feedExcess())

      !entryCount = !entryCount + 1

    -- ** Thread **
    elseif (!assemblyTables[!i].objectType() eq 'THREADASSEMBLYACTIVITY') then

      !threadActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!threadActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline from the object
      if (!threadActivity.arriveEnd()) then
        !incline = 'Start'
      else
        !incline = 'End'
      endif
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      !remarks = 'THREAD :' & !threadActivity.thread().string() & ' : ' & !this.formatUnits(!threadActivity.threadLength())

      !entryCount = !entryCount + 1

    -- ** Insert **
    elseif (!assemblyTables[!i].objectType() eq 'INSERTASSEMBLYACTIVITY') then

      !insertActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!insertActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      !remarks = 'INSERT :' & !this.formatUnits(!insertActivity.insertLength())

      !entryCount = !entryCount + 1

    -- ** Any other component **
    elseif (!assemblyTables[!i].objectType() eq 'COMPONENTASSEMBLYACTIVITY') then

      !componentActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!componentActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = !componentActivity.rotationAngle().string('D2')
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      if (!componentActivity.referencePlaneComponent().set() and !componentActivity.referencePlaneComponent().badref().not()) then
        if (!componentActivity.referencePlaneComponent().type eq 'BEND') then
          !prefix = 'BP'
        elseif (!componentActivity.referencePlaneComponent().type eq 'ELBO') then
          !prefix = 'EP'
        elseif (!componentActivity.referencePlaneComponent().type inset('TEE','CROS')) then
          !prefix = 'TP'
        else
          -- Could be a flange
          !prefix = 'FP'
        endif
        -- Read position number
        !planeRef = !prefix & !componentActivity.referencePlaneComponent().tyseq
      else
        !planeRef = '---'
      endif
      !remarks = 'Ref Plane :' & !planeRef

      !entryCount = !entryCount + 1

    else
    -- ** Unexpected Activity **
      !!pipeSketchesLog('Unexpected Activity Type - ' & !assemblyTables[!i].objectType())

      !otherActivity = !assemblyTables[!i]
      -- Get the tag from the index which originates from !this.mtoTags
      !mtoTag = !this.mtoTags.findFirst(!otherActivity.component()).string()
      -- Get the rotate directly from the object
      !rotate = '---'
      -- Get the incline directly from the object
      !incline = '---'
      -- Get the turn directly from the object
      !turn = '---'
      -- Get the remarks directly from the object
      !remarks = 'Unrecognised Activity'

      !entryCount = !entryCount + 1

    endif

    !result[!entryCount] = ARRAY()
    !result[!entryCount][1] = !mtoTag
    !result[!entryCount][2] = !rotate
    !result[!entryCount][3] = !incline
    !result[!entryCount][4] = !turn
    !result[!entryCount][5] = !remarks

  enddo

  -- Example return array
  -- Create a 2 dimensional array *****************
--   !result = ARRAY()
--     !result[1] = ARRAY()
--       !result[1][1] = '2'
--       !result[1][2] = '0.0'
--       !result[1][3] = '-'
--       !result[1][4] = '-'
--       !result[1][5] = 'BP:  :'
--     !result[2] = ARRAY()
--       !result[2][1] = '3'
--       !result[2][2] = '0.0'
--       !result[2][3] = '-'
--       !result[2][4] = '-'
--       !result[2][5] = 'BP:  :'
--     !result[3] = ARRAY()
--       !result[3][1] = '4'
--       !result[3][2] = '0.0'
--       !result[3][3] = '42.0'
--       !result[3][4] = '-180.0'
--       !result[3][5] = 'BP: 4:SDL'

  return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getEndPointTags
--
-- Description: Get end points to be tagged
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Arguments:
--   [#] [Data Type] [Description]
--    1    ARRAY      Array to be used in Table
--
------------------------------------------------------------------------
define method .getEndPointTags( ) is ARRAY

  -- Get the table from the Pipe Spool

  -- Initialise a 2 dimensional array *****************
  !result = ARRAY()
    !result[1] = ARRAY()
      !result[1][1] = ''
      !result[1][2] = ''

  !memory = !!ce

  -- Get the Start Positions
  !unusedTestA = !this.pipeSpool.psarfa[1]
  handle ANY
    !!pipeSketchesLog('Pipe Spool psarfa not set')
    return !result
  endhandle

  !countConnection = 0

  do !start indices !this.pipeSpool.psarfa

    if !this.pipeSpool.psarfa[!start].type.eq('BRAN') then
      !href = !this.pipeSpool.psarfa[!start].href
      if unset(!href) eq false then
        if !href.type inset ('TEE', 'OLET')  then
          !countConnection =  !countConnection + 1
          skip
        endif
      endif
    endif

    if (!this.pipeSpool.psarfa[!start].type eq 'BRAN') then
      !firstPosition[!start] = 'PH of ' & !this.pipeSpool.psarfa[!start].name
    else
      !firstPosition[!start] = 'PL of ' & !this.pipeSpool.psarfa[!start].name
    endif

    -- Record the Start Result
    !result[!start - !countConnection] = ARRAY()

    !result[!start - !countConnection][1] = 'C' & string(!start - !countConnection)
    !result[!start - !countConnection][2] = !firstPosition[!start]

  enddo

  -- Get the End Positions
  !unusedTestB = !this.pipeSpool.pslrfa[1]
  handle ANY
    !!pipeSketchesLog('Pipe Spool pslrfa not set')
    return !result
  endhandle
  !starts = !this.pipeSpool.psarfa.size()
  do !end indices !this.pipeSpool.pslrfa
    if !this.pipeSpool.pslrfa[!end].type.eq('BRAN') then
      !tref = !this.pipeSpool.pslrfa[!end].tref
      if unset(!tref) eq false then
        if !tref.type inset ('TEE', 'OLET') then
          !countConnection = !countConnection + 1
          skip
        endif
      endif
    endif

    if (!this.pipeSpool.pslrfa[!end].type eq 'BRAN') then
      !lastPosition[!end] = 'PT of ' & !this.pipeSpool.pslrfa[!end].name
    else
      !lastPosition[!end] = 'PA of ' & !this.pipeSpool.pslrfa[!end].name
    endif

    -- Record the End Result
    !number = !starts + !end
    !result[!number] = ARRAY()
    !result[!number - !countConnection][1] = 'C' & string(!number - !countConnection)
    !result[!number - !countConnection][2] = !lastPosition[!end]
  enddo

  !!ce = !memory

  return !result

endmethod

------------------------------------------------------------------------
--
-- Method:      dimensionViews
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionViews( )

  -- Get all the members of the spool
  !components = ARRAY()
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !components = !pipeSpoolManager.getBranchElements(!this.pipeSpool)

  -- Remove all tubing from array (Actually we need tubing that is first or last in the list, but will add later)
  do !i indices !components
    if (!components[!i].type eq 'TUBI') then
      !components[!i].delete()
    endif
  enddo
  -- Re-index
  !components.compress()

  -- Go to each View's dimensioning layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first dimensioning layer
    var !dimLayer collect all layer with (PURP eq 'DIMA') for $!views[$!i]
    if (!dimLayer.size().gt(0)) then
      !dimensioningLayer = !dimLayer[1].dbref()
    else
      skip
    endif

    !!ce = !dimensioningLayer
    !this.dimensionLayer(!components)
    handle ANY
     -- !!pipeSketchesLog('Error occurred in dimensioning')
      -- q var !!error
      skip
    endhandle
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagViews
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagViews( )

  -- Get all the members of the spool (Pipe at the moment)
  !components = ARRAY()
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !components = !pipeSpoolManager.getMtoElements(!this.pipeSpool)

  -- Re-index
  !components.compress()

  -- Go to each View's label layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first label layer
    var !tagLayer collect all layer with (PURP eq 'LABA') for $!views[$!i]
    if (!tagLayer.size().gt(0)) then
      !taggingLayer = !tagLayer[1].dbref()
    else
      skip
    endif

    !!ce = !taggingLayer
    !this.tagLayer(!components)
    handle ANY
     !!pipeSketchesLog('Error occurred in tagging MTO refs')
     --q var !!error
      skip
    endhandle

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagLayer
--
-- Description: Tag each view in the DIMA layer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREF's of components in the spool
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagLayer(!components is ARRAY )

  -- Initialise variables
  !tagLayer   = !!ce
  !parameters = STRING()

  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !pipePieces = !pipeSpoolManager.getPipePieces(!this.pipeSpool)

  -- Get task and read parameters
  VAR !allTasks COLL ALL TASK WITH SPPURP EQ 'TAGDEF' FOR $!tagLayer
  VAR !allTaskParameters COLL ALL TKPARA FOR $!allTasks[1]
  -- Extract defaults from TKPARA elements
  do !i indices !allTaskParameters
    if (!allTaskParameters[!i].dbref().func eq 'TEMPLATE') then
      !symbol = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'OFFSET') then
      !offset = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'TXCOLOUR') then
      !txColour = !allTaskParameters[!i].dbref().tpvalue
      skip
    endif
    if (!allTaskParameters[!i].dbref().func eq 'FCOLOUR') then
        !fPenCol = !allTaskParameters[!i].dbref().tpvalue
        skip
    endif
    if (!allTaskParameters[!i].dbref().func  eq 'FSTYLE') then
           !fPenSty = !allTaskParameters[!i].dbref().tpvalue
           if (!fPenSty.upcase().match('SYS').eq(1) ) then
               !styEquiv = !fPenSty.after('SYS')
               !styNo = !styEquiv.real()
                    handle (2,441)
                      return error 1
                    endhandle
               !fstyldflts = 'SOLID DASH DOT CHAIN LDASH SOLIDTHICK DASHEDTHICK DOTEDTHICK  CHAINEDTHICK'
               !fstyleTypes = !fstyldflts.split()
               !fstyleTypes[0] = 'LDASHTHICK'
               !ind =!styNo - (  int (!styNo / 10) * 10)
               !equivStyle = !fstyleTypes[!ind]
           elseif(!fPenSty.upcase().eq('SOLIDFILLED')) then
               !equivStyle  = 'SOLID'
           endif
      skip
    endif
  enddo

  -- Build the local tags
  do !i indices !components
    -- Unique tag identifier
    !mtoTag    = !this.mtoTags.findFirst(!components[!i]).string()
    if (!mtoTag neq '') then
      NEW SLAB ON $!components[$!i] ATEX |$!mtoTag|
      if (!components[!i].type eq 'PPIECE') then
        -- Tag at centre of tube
        !pipePiecePosition = !!positionAlongPipePiece(!components[!i], 0.5)
        POS $!pipePiecePosition
      endif
      TMRF $!symbol XYPO $!offset OSET TRUE TXCOLOUR  $!txColour LFCOLOUR $!fPenCol LFSTYLE $!equivStyle  LLCOLOUR $!fPenCol LLSTYLE $!equivStyle  BLNK TRUE CPOF 0 0 LLEA TRUE
    endif

  enddo

  -- Return to layer
  !!ce = !tagLayer
  UPDATE ANNO

  -- Get arrange label task and read parameters
  VAR !allTasks COLL ALL TASK WITH SPPURP EQ 'ARRLAB' FOR $!tagLayer
  VAR !allTaskParameters COLL ALL TKPARA FOR $!allTasks[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  -- Arrange the labels
  !!pipeSketchesArrangeLabels($!parameters)

endmethod
------------------------------------------------------------------------
--
-- Method:      tagViewsEndPoints
--
-- Description: Tag all views with end point tags
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagViewsEndPoints( )

  -- Go to each View's label layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first label layer
    var !tagLayer collect all layer with (PURP eq 'LABA') for $!views[$!i]
    if (!tagLayer.size().gt(0)) then
      !taggingLayer = !tagLayer[1].dbref()
    else
      skip
    endif

    !!ce = !taggingLayer
    !this.tagLayerEndPoints()
    handle ANY
     !!pipeSketchesLog('Error occurred in tagging End Points')
     --q var !!error
      skip
    endhandle

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagLayerEndPoints
--
-- Description: Tag each view in the DIMA layer with end points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagLayerEndPoints()

  -- Initialise variables
  !tagLayer   = !!ce
  !tags = ARRAY()

  -- Build the local tags

  -- Need the getEndPointTags in here which returns a 2x2 array
  !tags = !this.getEndPointTags()

  do !i indices !tags

    -- Read position number
    !connectionNumber = !tags[!i][1]
    --$p $!tags[$!i][2]

    -- Create new general label for each end point
    NEW GLAB ON $!tags[$!i][2] BTEX |$!connectionNumber|
    CPOFFSET 0 -1.25

  enddo

  -- Return to layer
  !!ce = !tagLayer
  UPDATE ANNO

endmethod
------------------------------------------------------------------------
--
-- Method:      tagViewsAssemblyPlanes
--
-- Description: Tag all views with assembly planes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagViewsAssemblyPlanes( )

  -- Core Pipe Spool Manager object
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  -- Assembly Activity Table
  !assemblyTables = !pipeSpoolManager.getActivityTables(!this.pipeSpool)

  !entryCount = 0
  !refPlane = ARRAY()

  do !i indices !assemblyTables

    !activity[!i] = !assemblyTables[!i]
    !refPlane[!i] = !activity[!i].referencePlaneComponent()
    handle ANY
      -- Because not all activities have this method
    endhandle
  enddo

  -- Make list of components unique and re-indexed
  !components = !refPlane.unique()

  -- Go to each View's label layer
  var !views collect all view for $!this.sheet

  do !i indices !views
    -- Get the first label layer
    var !tagLayer collect all layer with (PURP eq 'LABA') for $!views[$!i]
    if (!tagLayer.size().gt(0)) then
      !taggingLayer = !tagLayer[1].dbref()
    else
      skip
    endif

    !!ce = !taggingLayer
    !this.tagLayerAssemblyPlanes(!components)
    handle ANY
     !!pipeSketchesLog('Error occurred in tagging Assembly Planes')
      skip
    endhandle

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      tagLayerAssemblyPlanes
--
-- Description: Tag each view in DIMA layer with assembly planes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREF's of components in the spool
-- Return:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tagLayerAssemblyPlanes(!components is ARRAY )

  -- Initialise variables
  !tagLayer   = !!ce

  -- Build the local tags
  do !i indices !components

    if (!components[!i].type eq 'BEND') then
      !prefix = 'BP'
    elseif (!components[!i].type eq 'ELBO') then
      !prefix = 'EP'
    elseif (!components[!i].type inset('TEE','CROS')) then
      !prefix = 'TP'
    else
      -- Could be a flange
      !prefix = 'FP'
    endif
    -- Read position number
    !posNumber = !prefix & !components[!i].tyseq

    -- Create new
    NEW GLAB ON $!components[$!i] BTEX |$!posNumber|
    CPOFFSET 0 -1.25

  enddo

  -- Return to layer
  !!ce = !tagLayer
  UPDATE ANNO

endmethod
------------------------------------------------------------------------
--
-- Method:      dimensionLayer
--
-- Description: Dimension all views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY      Array of DBREF's of components in the spool
-- Arguments:
--   [#] [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionLayer(!allComponents is ARRAY )

  -- Initialise variables
  !number      = 1
  !branches[1] = ARRAY()
  !allBranches = ARRAY()
  !allSequence = ARRAY()

  -- Get data for all components except TUBE
  do !compRefe val !allComponents

    -- Get owning branch and sequence number
    !allBranches.append(!compRefe.owner.flnm)
    !allSequence.append(!compRefe.sequence)

  enddo

  -- Rationalise the all components array
  !components = !allComponents

  -- Sort the components into sequence
  !sorted = !allSequence.sortedIndices()
  !components.reIndex(!sorted)
  !allBranches.reIndex(!sorted)

  -- Sort components into their owning branches
  VAR !sort SORT !allBranches LASTINGROUP !last
  do !index ind !sort

    -- Add component to branch array
    !branches[!number].append(!components[!sort[!index].real()])

    -- Create next branch array
    if (defined(!last[!index]) and !index.neq(!sort.size())) then
      !number = !number + 1
      !branches[!number] = ARRAY()
    endif

  enddo

  -- Eliminate components
  do !number from 1 to !branches.size()

    !dimnComp[!number] = ARRAY()

    do !index ind !branches[!number]

      !compRefe = !branches[!number][!index]
      !type     = !compRefe.type.upcase()

        -- Add all items except gaskets and tubing
      if (!type inset('GASK','TUBI')) then
      else
        !dimnComp[!number].append(!compRefe)
      endif

    enddo

  enddo

  -- We may have tubing at the start or end of the spool so we need these
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !tube = !pipeSpoolManager.getBranchElements(!this.pipeSpool)
  if (!tube.size() eq 1 and !tube[1].type eq 'TUBI') then
    -- Adding a tube at the beginning
    !dimnComp[1][1] = !tube[1]
  elseif (!tube[1].type eq 'TUBI') then
    -- Adding a tube at the beginning
    !dimnComp[1].insert(1, !tube[1])
  endif
  if (!tube.size() neq 1 and !tube[!tube.size()].type eq 'TUBI') then
    -- Adding a tube at the end
    !dimnComp[!branches.size()].append(!tube[!tube.size()])
  endif

  -- Dimension each branch
  do !index from 1 to !dimnComp.size()

    -- Initialise variables for first component
    !compRefe = !dimnComp[!index][1]
    handle ANY
      -- We must have no components so let us test if we have just Tubing
      !pipeSpoolManager = object PIPESPOOLMANAGER()
      !tube = !pipeSpoolManager.getBranchElements(!this.pipeSpool)
      if (!tube.size() eq 1 and !tube[1].type eq 'TUBI') then
        !dimnComp[!index][1] = !tube[1]
        !compRefe = !dimnComp[!index][1]
      endif
    endhandle
    !compType = !compRefe.type.upcase()
    if (!dimnComp[!index].size() eq 1) then
    -- See if we have just 1 component. if so dimension it arrive to leave
      if (!compType eq 'TUBI') then
        -- Find the next element (which could be a branch)
        !nextRefe = object DBREF('next of $!compRefe')
        handle ANY
          !nextRefe = !compRefe.owner
        endhandle
        -- Find the previous element (which could be a branch)
        !prevRefe = object DBREF('previous of $!compRefe')
        handle ANY
          !prevRefe = !compRefe.owner
        endhandle
        if (!prevRefe.type eq 'BRAN' and !nextRefe.type eq 'BRAN') then
          !currDir = !!pipeSketchesDimensionDir(!prevRefe, 1, !nextRefe, 2, false)
          !this.createDimension(!currDir, !prevRefe, 1, !nextRefe, 2)
        elseif (!prevRefe.type eq 'BRAN' and !nextRefe.type neq 'BRAN') then
          !currDir = !!pipeSketchesDimensionDir(!prevRefe, 1, !nextRefe, !nextRefe.arrive, false)
          !this.createDimension(!currDir, !prevRefe, 1, !nextRefe, !nextRefe.arrive)
        elseif (!prevRefe.type neq 'BRAN' and !nextRefe.type eq 'BRAN') then
          !currDir = !!pipeSketchesDimensionDir(!prevRefe, !prevRefe.leave, !nextRefe, 2, false)
          !this.createDimension(!currDir, !prevRefe, !prevRefe.leave, !nextRefe, 2)
        elseif (!prevRefe.type neq 'BRAN' and !nextRefe.type neq 'BRAN') then
          !currDir = !!pipeSketchesDimensionDir(!prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive, false)
          !this.createDimension(!currDir, !prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive)
        endif
        skip
      endif
    endif

    -- START
    -- Test for first component having a change in direction
    -- In which case a dimension is required from the PA to the P0
    if (!compType.eq('BEND') or !compType.eq('ELBO') or !compType.eq('TEE')) then
      !currDir = !!pipeSketchesDimensionDir(!compRefe, !compRefe.arrive, !compRefe, 0, false)
      !this.createDimension(!currDir, !compRefe, !compRefe.arrive, !compRefe, 0)
       var !layername layer
      !layer = object DBREF(!layername)
      !s = object DIMENSIONMITRE()
      !s.linearDimension(!compRefe,!layer,'12')
      !segs = ARRAY()
      !s.angularDimension(!compRefe, !layer, !segs, 'ARR',0.5, 1)
      handle any
      endhandle
    endif
    if (!compType eq 'TUBI') then
      -- Find the previous element
      !nextRefe = !dimnComp[!index][2]
      -- Find the next element (which could be a branch)
      !prevRefe = object DBREF('previous of $!compRefe')
      handle ANY
        !prevRefe = !nextRefe.owner
      endhandle
      if (!prevRefe.type eq 'BRAN') then
        !currDir = !!pipeSketchesDimensionDir(!prevRefe, 1, !nextRefe, !nextRefe.arrive, false)
        !this.createDimension(!currDir, !prevRefe, 1, !nextRefe, !nextRefe.arrive)
      else
        !currDir = !!pipeSketchesDimensionDir(!prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive, false)
        !this.createDimension(!currDir, !prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive)
      endif
    endif

    -- MIDDLE
    -- For all components
    -- Dimension from the current component to the next component
    do !number from 1 to !dimnComp[!index].size() - 1
      -- Initialise variables
      !compRefe = !dimnComp[!index][!number]
      !compType = !compRefe.type.upcase()

      -- Get next component
      !nextIndex = !number + 1
      !centrePoint = 0
      !nextRefe = !dimnComp[!index][!nextIndex]
      if (!nextRefe.type eq 'TUBI') then
        skip
      elseif (!compRefe.type eq 'TUBI') then
        !centrePoint = 1
        !compRefe = !nextRefe
      endif

      -- Test direction of current P0 to next P0
      !currDir = !!pipeSketchesDimensionDir(!compRefe, !centrePoint, !nextRefe, 0, false)
      !this.createDimension(!currDir, !compRefe, !centrePoint, !nextRefe, 0)

      -- if comptype is bend then add an extra dimension
      if !compType.eq('BEND') then
          var !layername layer
         !layer = object DBREF(!layername)
         !s = object DIMENSIONMITRE()
         !s.linearDimension(!compRefe,!layer,'12')
         !segs = ARRAY()
         !s.angularDimension(!compRefe, !layer, !segs, 'ARR', 0.5, 1)
           handle any
           endhandle
      endif
    enddo

    -- Initialise variables for last component
    !compRefe = !dimnComp[!index][!dimnComp[!index].size()]
    handle ANY
      skip
    endhandle
    !compType = !compRefe.type.upcase()

    -- END
    -- Test for last component having a change in direction
    -- In which case a dimension is required from the P0 to the PL
    if (!compType.eq('BEND') or !compType.eq('ELBO') or !compType.eq('TEE')or !compType.eq('CROS')) then
      !currDir = !!pipeSketchesDimensionDir(!compRefe, 0, !compRefe, !compRefe.leave, false)
      !this.createDimension(!currDir, !compRefe, 0, !compRefe, !compRefe.leave)
       var !layername layer
      !layer = object DBREF(!layername)
      !s = object DIMENSIONMITRE()
      !s.linearDimension(!compRefe,!layer,'12')
      !segs = ARRAY()
      !s.angularDimension(!compRefe, !layer, !segs, 'ARR', 0.5, 1)
      handle any
      endhandle
    endif
    if (!compType eq 'TUBI') then
      -- Find the previous element
      !prevRefe = !dimnComp[!index][!dimnComp[!index].size() - 1]
      -- Find the next element (which could be a branch)
      !nextRefe = object DBREF('next of $!compRefe')
      handle ANY
        !nextRefe = !prevRefe.owner
      endhandle
      if (!nextRefe.type eq 'BRAN' and !prevRefe.type neq 'BEND') then
        !currDir = !!pipeSketchesDimensionDir(!prevRefe, !prevRefe.leave, !nextRefe, 2, false)
        !this.createDimension(!currDir, !prevRefe, !prevRefe.leave, !nextRefe, 2)
      elseif (!prevRefe.type inset('BEND')) then
        !currDir = !!pipeSketchesDimensionDir(!prevRefe, 0, !nextRefe, 2, false)
        !this.createDimension(!currDir, !prevRefe, 0, !nextRefe, 2)
      else
        !currDir = !!pipeSketchesDimensionDir(!prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive, false)
        !this.createDimension(!currDir, !prevRefe, !prevRefe.leave, !nextRefe, !nextRefe.arrive)
      endif
    endif

  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: global Instance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .globalInstance()

  !!pipeSketch = object PIPESKETCHES()
  -- Set Form Members
  !!pipeSketch.type             = 'drawing'
  !!pipeSketch.drawingPrefix    = 'DR'
  !!pipeSketch.sheetPrefix      = 'S'
  !template = object DBREF('/TT/DRA/PRJ/TMP/PipeSketch/A4')
  handle ANY
  elsehandle NONE
    !!pipeSketch.selectedTemplate = !template
  endhandle
  !!pipeSketch.logFile          = object FILE('%PDMSUSER%/pipeSketchesLog.txt')

endmethod
------------------------------------------------------------------------
--
-- Method:      openLog
--
-- Description: Open the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .openLog()

  !this.logFile.open('OVERWRITE')

endmethod
------------------------------------------------------------------------
--
-- Method:      closeLog
--
-- Description: Close the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeLog()

  !this.logFile.close()

endmethod
------------------------------------------------------------------------
--
-- Method:      writeLog
--
-- Description: Write to the log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeLog()

  !this.logFile.writeFile('OVERWRITE', !this.logData)
  handle ANY
    -- Belt and braces
    !!alert.error('Unable log Data to file')
    handle ANY
      !!pipeSketchesLog('Unable log Data to file')
    endhandle
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      emptyLogData
--
-- Description: Empty the log Data array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .emptyLogData()

  !this.logData.clear()

endmethod
------------------------------------------------------------------------
--
-- Method:      readMtoHeadings
--
-- Description: Read the MTO heading from the Backing sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     DBREF      This is the note with SPPURP eq 'TABLE' and FUNC eq 'MTO'
-- Return:
--   [Data Type] [Description]
--    ARRAY       An array of the attributes of the pipe spool materials
--
------------------------------------------------------------------------
define method .readMtoHeadings(!cells is DBREF) is ARRAY

  !result = ARRAY()
  !logMessage = 'MTO headings are :'

  -- Find the MTO entries table
  var !headings collect all texp for $!cells
  do !i indices !headings
    !result.append(!headings[!i].dbref().btex)
    !logMessage = !logMessage & ' ' & !result[!i]
  enddo

  -- Write a line in the log file
  !!pipeSketchesLog(!logMessage)

  return !result

endmethod

------------------------------------------------------------------------
--
-- Method:      createDimension
--
-- Description: Create a dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R     STRING     Current Dimension Direction
--    2     R     DBREF      First reference of component for dimension
--    3     R     REAL     First Point of Dimension P0, P1 or P2 etc
--    4     R     DBREF      Second reference of component for dimension
--    5     R     REAL     Second Point of Dimension P0, P1 or P2 etc
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDimension(!currDir is STRING, !firstElement is DBREF, !firstPoint is REAL, !secondElement is DBREF, !secondPoint is REAL) is ARRAY


      NEW LDIM  DTAN PARA
      DIR $!currDir
        handle any
          -- Dimension direction parallel to View direction,
          -- Cannot dimension
          DELETE LDIM
        elsehandle none

          -- Add dimension points
          FROM P$!firstPoint  OF $!firstElement
          TO   P$!secondPoint OF $!secondElement

          -- OK we just need to map this onto the view plane to get a true LDIM DIR
--          var !viewName VIEW
--          !view = object DBREF(!viewName)
--          !planeDirection = !view.direction
--          !planePosition = object POSITION('E0N0U0 wrt /* ')
--          !planeOrientation = object ORIENTATION('Z is ' & !planeDirection.string())
--          !plane = object PLANE(!planePosition, !planeOrientation)
--          -- Map each point onto the plane
--          var !position POS P$!firstPoint OF $!firstElement
--          !firstPosition = object POSITION(!position)
--          var !position POS P$!secondPoint OF $!secondElement
--          !secondPosition = object POSITION(!position)
--          !firstNear = !plane.near(!firstPosition)
--          !secondNear = !plane.near(!secondPosition)
--          -- Now get the direction of first point to second
--          !direction = !firstNear.direction(!secondNear).string().before('WRT')
--          -- Now assign the new direction to LDIM
--          LDIM
--          DIR $!direction
--          handle ANY
--          endhandle

        endhandle

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      testformitres
--
-- Description: Check a pipe piece to see if it has mitres
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .testformitres()

   !mtoTags = ARRAY()
   do !a index !this.mtoTags
      if !this.mtoTags[!a].type.eq('BEND') then
         skip
      else
         !mtoTags.append(!this.mtoTags[!a])
      endif
   enddo

  !this.mtoTags = !mtoTags

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      isitacutmitre
--
-- Description: Check a bend to see if it has mitres
--
-- Method Type: Function/Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
--    REAL   the number of cuts 0 if its not a mitre
------------------------------------------------------------------------
define method .isitacutmitre(!test is DBREF)is REAL

 if !test.type.eq('BEND') then
    return !test.actncu
    handle any
       --q var !!error
      return 0
    endhandle
 else
    return 0
 endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      formatUnits
--
-- Description: Format to current distance units
-- Values returned from bending activities in core are always in mm. This
-- method takes this into account and then converts to the current units.
-- This ensures that values are correct when imperial is used.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R      REAL     Value to be formatted
-- Return:
--   [Data Type] [Description]
--    STRING      Input value formatted to current units
------------------------------------------------------------------------
define method .formatUnits(!value is REAL)is STRING

   -- Set the value to mm
   !mmValue = !!comConvertUnknownValue(!value,'MM')
   -- Convert to the current distance format
   !result  = !mmValue.string(!!distanceFmt)
   -- Return the result
   return !result

endmethod
------------------------------------------------------------------------
--
-- Method:      getFlangeAngle
--
-- Description: calculate the angle of a flange component
-- depending on the number of its bolt holes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R            DBREF         Flange component
--    2     R            REAL            Angle of the Z direction of a component
-- Return:
--   [Data Type] [Description]
--    REAL            Get the actual angle of a component
--
------------------------------------------------------------------------
define method .getFlangeAngle(!component is DBREF, !rotate is REAL) is REAL

  --Get the number of bolt holes from a component
  !boltRef = !component.spref.bltref
  if !boltRef.unset() then
    return !rotate
  else
    !numBoltHole = !boltRef.noff
    if !numBoltHole.eq(0) then
      return !rotate
    endif
  endif

  --Calculate the maximum angle of a component
  !maxAng = (360 / !numBoltHole) / 2
  !flangeAngle = REAL()
  if !rotate gt !maxAng  then
    !flangeAngle = !rotate - (INT(!rotate / !maxAng) * !maxAng)
  elseif !rotate eq !maxAng  then
    !flangeAngle = 0
  else
    return !rotate
  endif
  return !flangeAngle

endmethod
