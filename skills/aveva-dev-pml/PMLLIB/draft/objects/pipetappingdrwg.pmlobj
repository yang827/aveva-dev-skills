------------------------------------------------------------------------
--
-- Method:      initializeDrawing
--
-- Description: initialize drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Current Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initializeDrawing() is BOOLEAN

  !this.dwgTmplName = '/DETAIL/ISO'

  !this.deptName = '/NSBC_DRAWINGS/DEPT'

  !this.regiName = '/NSBC_DRAWINGS/REGI'

  var !projCode proj code

  !this.pltFileDir = '%' & !projCode & 'iso%'

  -- check plt file directory
  !checkPltDir = object FILE(!this.pltFileDir)
  if (!checkPltDir.exists().not()) then
    !this.writeErrorMessage(!this.pltFileDir, 'Error creating detailed plot drawing, project ISO directory $!this.pltFileDir does not exist.')
    return false
  endif

  -- checking drawing template
  --!checkDwgTmpl = !this.dwgTmplName.dbref()
  --handle any
  --  !this.writeErrorMessage(!this.dwgTmplName, 'Error creating drawing, template $!this.dwgTmplName not found.')
  --  return false
  --elsehandle none
  --  if (!checkDwgTmpl.badref()) then
  --    !this.writeErrorMessage(!this.dwgTmplName, 'Error creating drawing, template $!this.dwgTmplName not found.')
  --    return false
  --  endif
  --endhandle

  -- checking drawing template
  !checkDwgTmpl = !this.dwgTmplName.dbref()
  handle any
    !this.dwgTmplName = 'NOT-FOUND'
    --  !this.writeErrorMessage(!this.dwgTmplName, 'Error creating drawing, template $!this.dwgTmplName not found.')
    --  return false
  elsehandle none
    if (!checkDwgTmpl.badref()) then
      !this.dwgTmplName = 'NOT-FOUND'
      --    !this.writeErrorMessage(!this.dwgTmplName, 'Error creating drawing, template $!this.dwgTmplName not found.')
      --    return false
    endif
  endhandle

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      makeDrawing
--
-- Description: make underlying drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makeDrawing(!elementString is STRING, !spldrgString is STRING)

  --evaluate owner
  --sortunique owner collection
  --create sheet for each owner (e.g. elbo)

  --for first component, use existing sheet
  --idlname can be set same for drwg, sheet, view (set to pipe)
  --go to view, set thpos and direction
  --copy view, move view (e.g. by 60 e) set direction
  --save plotfile

  --for subsequent components, create new sheet and repeat the above

  --(saved plotfiles are picked up in design)

  --warning off
  --trace off
  !this.errorList.clear()

  !this.pipeElement = !elementString.dbref()
  handle ANY
    if (!!module().appkey.upcase().eq('MON')) then
      !elementName = !elementString.substring(2).replace('"','_').replace('"','_').replace('\','_').replace('/','_').replace(':','_').replace('*','_').replace('?','_').replace('<','_').replace('>','_')
      !dwgName = '/' & !elementName & '_DETAIL'
      !this.errorLogFile = object FILE('%pdmsuser%/' & !dwgName & 'tappingdrwgerror.log')
      !this.clearResultFile()
      if (!!module().productfamily.upcase().eq('MARINE')) then
        !this.writeErrorMessage(!this.deptName, 'Error creating detailed plot drawing - cannot access Outfitting Draft module, check PADD database with write access is available.')
      else
        !this.writeErrorMessage(!this.deptName, 'Error creating detailed plot drawing - cannot access Draft module, check PADD database with write access is available.')
      endif
      !this.createResultFile()
      return
    else
      -- we do a savework now so this should never be needed
      return
    endif
  endhandle

  -- set spool element
  --!this.pipeElement = !element
  --!this.isoOptionFile = object FILE(!isoOptionFilePath)

  warning off
  trace off

  if (!spldrgString.eq('')) then
    !elementName = !this.pipeElement.name.substring(2).replace('"','_').replace('\','_').replace('/','_').replace(':','_').replace('*','_').replace('?','_').replace('<','_').replace('>','_')
  else
    !elementName = !spldrgString.substring(2).replace('"','_').replace('\','_').replace('/','_').replace(':','_').replace('*','_').replace('?','_').replace('<','_').replace('>','_')
  endif
  !dwgName = '/' & !elementName & '_DETAIL'
  !this.errorLogFile = object FILE('%pdmsuser%/' & !dwgName & 'tappingdrwgerror.log')

  !this.clearResultFile()

  !dept = nulref
  !regi = nulref
  !dwg = nulref

  -- Initialise Drawing, if initialisation fails, e.g. can't find drawing template, return
  if (!this.initializeDrawing().not()) then
    !this.createResultFile()
    return
  endif

  -- check DEPT if exists
  !dept = !this.deptName.dbref()
  handle ANY
  endhandle
  if (!dept.badref()) then
    context draw
    new DEPT $!this.deptName
    handle ANY
      !this.writeErrorMessage(!this.deptName, 'Error creating detailed plot drawing - cannot create department $!this.deptName' & '. Please ensure you have write access to a PADD DB.')
      !this.createResultFile()
      return
    endhandle
    !dept = !!ce
  endif

  -- check REGI if exists
  !regi = !this.regiName.dbref()
  handle ANY
  endhandle
  if (!regi.badref()) then
    !!ce = !dept
    new REGI $!this.regiName
    handle ANY
      !this.writeErrorMessage(!this.regiName, 'Error creating detailed plot drawing - cannot create registry $!this.regiName' & '. Please ensure you have write access to a PADD DB.')
      !this.createResultFile()
      return
    endhandle
    !regi = !!ce
  else
    if (!regi.owner.neq(!dept)) then
      !this.writeErrorMessage(!this.regiName, 'Error creating detailed plot drawing - Registry $!this.regiName appears under different Department than $!this.deptName' & '.')
      !this.createResultFile()
      return
    endif
  endif

  -- check DRWG if exists
  !dwg = !dwgName.dbref()
  handle ANY
  endhandle
  if (!dwg.badref()) then
    !!ce = !regi
    new DRWG $!dwgName
    handle any
      !this.writeErrorMessage(!!ce, 'Error creating detailed plot drawing - please ensure you have write access to a PADD DB.')
      !this.createResultFile()
      return
    endhandle
    !dwg = !!ce
  else
    -- check if read-write
    !!ce = !dwg
    delete DRWG memb
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modifying detailed plot drawing $!!ce - please ensure you have write access to existing drawings and existing drawings are not already claimed.')
      !this.createResultFile()
      return
    endhandle
    if (!dwg.owner.neq(!regi)) then
      !!ce = !regi
      include $!dwg
      handle ANY
        !!ce = !regi
        new DRWG
        handle ANY
          !this.writeErrorMessage(!dwg, 'Error modifying detailed plot drawing - cannot move existing ' & !dwg.namtyp & ' to Registry ' & !this.regiName & '.')
          !this.createResultFile()
          return
        endhandle
        !deleteDwg = !dwg
        !dwg = !!ce
        !!ce = !deleteDwg
        delete DRWG
        !dwg.name = !dwgName
      endhandle
      !!ce = !dwg
    endif
  endif

  --!!ce.linkref = !this.dwgTmplName.dbref()
  if (!this.dwgTmplName.eq('NOT-FOUND')) then
    -- creating template
    !this.dwgTmplName = '/DETAIL/TEMP'
    -- copy DRWG from template
    !test = !this.dwgTmplName.dbref()
    handle any
      !created = !this.createBaseDrawing()
      if (!created.not()) then
        return
      endif
    elsehandle none
    endhandle

    copy $!this.dwgTmplName rename $!this.dwgTmplName $!dwgName
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modifying detailed plot drawing $!dwgName - please ensure you have write access to existing drawings and existing drawings are not already claimed.')
      !this.createResultFile()
      return
    endhandle

    !this.deleteBaseDrawing()

  else
    -- using template
    copy $!this.dwgTmplName rename $!this.dwgTmplName $!dwgName
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modifying detailed plot drawing $!dwgName - please ensure you have write access to existing drawings and existing drawings are not already claimed.')
      !this.createResultFile()
      return
    endhandle
  endif

  --collect all pipca for pipe (!element)

  var !pipcaColl coll all pipca for $!this.pipeElement

  !setPipcas = ARRAY()

  do !i values !pipcaColl
    !pipca = !i.dbref()
    if (!pipca.cref.eq(nulref)) then
      if (!pipca.own.typ.eq('PTAP') AND !pipca.own.cref.neq(nulref)) then
        !setPipcas.append(!i)
      endif
    else
      !setPipcas.append(!i)
    endif
  enddo



  var !nameColl eval name of own for all from !setPipcas
  var !pipcaNameColl eval name for all from !setPipcas

  !nameColl.sortUnique()

  --loop through components, new sheet for each one (with 2 views per sheet)

  do !i indices !pipcaNameColl

    !component = !pipcaNameColl[!i].dbref().owner

    !pipca = !pipcaNameColl[!i].dbref()

    --!thpos = !component.position.wrt(world)

    !thpos = !pipca.position.wrt(world)

    !firstSheetName = !dwgName & '/S1'

    $!firstSheetName

    --if first component we already have sheet and 1 view, stay at first sheet
    --if not first component, copy sheet (and both views), go to newly created sheet

    if (!i.gt(1)) then
      own
      last shee
      !s1Name = name
      if (!i.gt(100)) then
        !slength = !s1Name.length() - 3
      elseif (!i.gt(10)) then
        !slength = !s1Name.length() - 2
      else
        !slength = !s1Name.length() - 1
      endif
      !s2Name = !s1Name.substring(1,!slength) & !i.string()

      new shee  $!s2Name copy prev rename $!s1Name $!s2Name
      view 1
      laye 1
      delete laye
      laye 1
      vnot 1
      delete vnot
      shee
      view 2
      laye 1
      delete laye
      shee
    endif

    !sheetRef = !!ce

    var !viewList coll all view for shee

    --do !i indices !viewList

    !view     = !viewList[1].dbref()

    !!ce  = !view

    thpos $!thpos

    goto idlname
    delete idli mem
    new adde

    !!ce.idna = !this.pipeElement

    !!ce = !view

    if (!component.aDir.wrt(world).isParallel(!pipca.ddir.wrt(world)).not()  ) then
      -- adir not parallel, so use adir cross product with pipca direction
      !view1Direction = !component.aDir.wrt(world).cross(!pipca.ddir.wrt(world))
    elseif (!component.lDir.wrt(world).isParallel(!pipca.ddir.wrt(world)).not()) then
      -- ldir not parallel so use ldir cross product with pipca direction
      !view1Direction = !component.lDir.wrt(world).cross(!pipca.ddir.wrt(world))
    else
      --we have parallel situation e.g. pipca on end of a flange so use plane to get direction
      !plane = object PLANE(!component.pos,!component.ori)
      !view1Direction = !plane.direction().string().before('WRT')
    endif
    !view1DirString = !view1Direction.string().before('WRT').trim()

    direction $!view1DirString

    --view 1 change view size, move view, add direction text here

    Size 50mm 45mm

    Lframe false

    Xyposition X 35mm Y 28mm

    -- add view direction text at bottom of view

    laye 1

    new vnot
    Xyposition X 1mm Y 0mm
    new texp
    !viewTitle = 'VIEW LOOKING ' & !view1DirString
    !!ce.btex = !viewTitle
    Cheight 2.5mm

    view

    --adeg calculation here***
    --if non-orthogonal (nothing (component adir/ldir) parallel with e/n/u) then
    --check if plan view (no up component in view direction - or if view dir parallel to U) - if so use ndir, if not use udir (see method in workbook)
    --setting adeg - set to angle found or 90 - angle found or similar - how to decide this? - component east +ve or bisect component east +ve?
    --adeg is anticlockwise rotation of view
    !viewDir = dir
    --only rotate if component arrive direction no orthogonal

    !aDir = !component.aDir.wrt(world)

    !view1Adeg = 0

    if (!aDir.isParallel(E) OR !aDir.isParallel(N) OR !aDir.isParallel(U)) then

    else

      --in here we need to check if view dir is parallel to U, if so will use N to rotate to.

      !pipcaPos = !pipca.pos.wrt(world)

      !ori = z is $!viewDir
      !plane = object PLANE()
      !plane = !plane.plane(!pipcaPos,!ori)

      if (!viewDir.isParallel(U)) then
        !viewTopDir = n wrt /*
      else
        !viewTopDir = u wrt /*
      endif

      --!uDir = u wrt /*

      !ddir = !pipca.ddir.wrt(world)

      --!aDir = !component.aDir.wrt(world)
      if (!ddir.angle(!aDir).eq(90)) then
        if (!ddir.up.lt(0)) then
          !directionToRotate = !ddir.opposite()
        else
          !directionToRotate = !ddir
        endif
      else
        !directionToRotate = !aDir
      endif

      !viewTopDirProj = !viewTopDir.projected(!plane)
      !directionToRotateProj = !directionToRotate.projected(!plane)

      !angle = !directionToRotateProj.angle(!viewTopDirProj)

      --cross direction

      !crossDir = !viewDir.cross(!directionToRotate)

      if (!crossDir.up.gt(0)) then
        !newAngString = '-' & !angle.string()
        !angle = !newAngString.real()
        adeg $!angle
      else
        adeg $!angle
      endif
      !view1Adeg = !angle
    endif

    update all

    --!!ce.dir = !dir

    --go to second view, or create second view if first sheet (component)

    !v1Name = name
    !vlength = !v1Name.length() - 1
    if (!i.eq(1)) then
      --!v1Name = name
      !v2Name = !v1Name.substring(1,!vlength) & '2'

      new view  $!v2Name copy prev rename $!v1Name $!v2Name
      adeg 0
      by x 60mm
    else
      !v2Name = !v1Name.substring(1,!vlength) & '2'
      $!v2Name
      adeg 0
      thpos $!thpos
    endif
    --set view direction of second view to direction towards pipca along connected branch
    --!dir = p1dir of $!component
    --!dir = ddir of $!pipca
    !view2Direction = !pipca.ddir.wrt(world)
    !view2Direction = !view2Direction.opposite()

    !view2DirString = !view2Direction.string().before('WRT').trim()
    dir $!view2DirString

    --update view 2 with direction***

    var !texpColl coll all texp for ce
    !texp = !texpColl[1].dbref()
    $!texp
    !viewTitle = 'VIEW LOOKING ' & !view2DirString
    !!ce.btex = !viewTitle
    view

    !viewDir = dir
    --only rotate if component arrive direction no orthogonal

    !view2Adeg = 0

    !aDir = !component.aDir.wrt(world)

    if (!aDir.isParallel(E) OR !aDir.isParallel(N) OR !aDir.isParallel(U)) then

    else

      --in here we need to check if view dir is parallel to U, if so will use N to rotate to.

      !pipcaPos = !pipca.pos.wrt(world)

      !ori = z is $!viewDir
      !plane = object PLANE()
      !plane = !plane.plane(!pipcaPos,!ori)

      if (!viewDir.isParallel(U)) then
        !viewTopDir = n wrt /*
      else
        !viewTopDir = u wrt /*
      endif

      !ddir = !pipca.ddir.wrt(world)

      !directionToRotate = !aDir

      !viewTopDirProj = !viewTopDir.projected(!plane)
      !directionToRotateProj = !directionToRotate.projected(!plane)

      !angle = !directionToRotateProj.angle(!viewTopDirProj)

      --cross direction

      !crossDir = !viewDir.cross(!directionToRotate)

      if (!crossDir.up.gt(0)) then
        !newAngString = '-' & !angle.string()
        !angle = !newAngString.real()
        adeg $!angle
      else
        adeg $!angle
      endif
      !view2Adeg = !angle

    endif

    update all

    --go to both views and add dimensions
    update desi

    if (!component.type.eq('BEND')) then
      if (!component.radius.gt(300mm)) then
        !scaleFlag = TRUE
        !scaleFactor = (300mm / !component.radius) * 1.5
      else
        !scaleFlag = FALSE
        !scaleFactor = 1
      endif
    elseif (!component.abore.real().gt(300mm)) then
      !scaleFlag = TRUE
      !scaleFactor = (300mm / !component.abore.real())
    else
      !scaleFlag = FALSE
      !scaleFactor = 1
    endif

    --view 1
    $!v1Name
    -- Create dimensions

    -- if needs vscale changing, change vscale
    if (!scaleFlag) then
      --!test = vscale
      !test = 0.05
      !test = !test * !scaleFactor
      vscale $!test
    endif
    --!v1DimsName = !v1Name & '/USER_Dims'
    !view = !v1Name.dbref()
    !sizeOfView = !view.size
    !componentArriveDirection = !component.aDir.wrt(/* ).string().before('WRT')
    !componentLeaveDirection  = !component.lDir.wrt(/* ).string().before('WRT')
    --$!v1DimsName

    -- Work out the maximum X and Y of the top of the view
    !positionOfView = !view.xypo
    !maximumXOfView = !view.xypo.east + (!sizeOfView[1] / 2) - 6mm
    !maximumYOfView = !view.xypo.north + (!sizeOfView[2] / 2) - 12mm

    if (!pipca.cref.set()) then

      -- Is the connected branch connected by the head or tail
      if (!pipca.cref.href.eq(!pipca)) then
        !connectedBy = 'PH'
      elseif (!pipca.cref.tref.eq(!pipca)) then
        !connectedBy = 'PT'
      else
        -- Not connected need error
        !this.writeErrorMessage(!dwg, 'Error adding dimensions to detailed plot, PIPCA not connected to a branch head or tail')
        !connectedBy = STRING()
      endif

    elseif (!component.type.eq('PTAP')) then
      -- Is the connected branch connected by the head or tail
      if (!component.cref.unset()) then
        !this.writeErrorMessage(!dwg, 'Error generating detailed plot, PTAP not connected to a branch head or tail')
        !this.createResultFile()
        return
      elseif (!component.cref.href.eq(!component)) then
        !connectedBy = 'PH'
      elseif (!component.cref.tref.eq(!component)) then
        !connectedBy = 'PT'
      else
        -- Not connected need error
        !this.writeErrorMessage(!dwg, 'Error adding dimensions to detailed plot, PTAP not connected to a branch head or tail')
        !connectedBy = STRING()
      endif
    else

      -- Not connected need error
      !this.writeErrorMessage(!dwg, 'Error adding dimensions to detailed plot, PIPCA not connected to a branch head or tail')
      !connectedBy = STRING()

    endif

    if (!connectedBy.set()) then

      -- add dimensions for view 1

      if (!component.type.neq('PTAP')) then
        !branchElement = !pipca.cref
      else
        !branchElement = !component.cref
      endif

      !layename1 = !v1Name & '/Dims'

      $!layename1
      handle any
      elsehandle none
        delete laye
      endhandle

      view
      new laye $!layename1 before 1

      -- if pa to pipca to pl all in line then do one LDIM, otherwise do two

      if (  !componentLeaveDirection.direction().isParallel(!componentArriveDirection.direction())) then

        new ldim from pa of $!component to $!connectedBy of $!branchElement
        to pl of $!component
        direction $!componentArriveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos X$!maximumXOfView Y$!maximumYOfView
          sort dim
          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle

      else

        --first ldim
        new ldim from pa of $!component to $!connectedBy of $!branchElement
        direction $!componentArriveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos X$!maximumXOfView Y$!maximumYOfView
          sort dim
          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle

        --!ce = !!ce
        --view

        --!!ce = !ce
        --second ldim

        new ldim from pl of $!component to $!connectedBy of $!branchElement
        direction $!componentLeaveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos Y$!maximumYOfView X$!maximumXOfView
          sort dim

          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle
      endif

      --here we need to handle if the 2 ldims just created are too close to one-another, and if so
      --add a dtoffset  (and gaps) so they do not overlap
      --*** we are now doing 1 ldim for 2 dimensions if in same direction so this no longer relevant
      --we may need to split these though

      --laye

      -- var !ldim coll all ldim for ce
      --if !ldim.size().eq(2) then

      --ldim 1
      --!dir1 = dir

      -- ldim 2
      --!dir2 = dir
      --laye
      --if dirs of ldim are parallel check sizes of dimensions
      --first check both are less than 80mm
      --if both less than 80mm then offset
      --if view dir is parallel with U, offsetX
      --if offsetX
      --set dtoffset 5mm 0mm
      --set a gap?
      --else
      --set dtoffset 0mm 5mm
      --set a gap?

      --if !view1Direction.direction().isParallel(U) then
      --if !dir1.isParallel(S) then
      --!offsetX = TRUE
      --elseif !dir1.isParallel(W) then
      --!offsetX = FALSE
      --endif

      -- !dim1String = exdmtxt of dppt 2 of ldim 1
      -- !dim2String = exdmtxt of dppt 2 of ldim 2

      -- !dim1 = !dim1String.real()
      --!dim2 = !dim2String.real()


      -- !offsetX = BOOLEAN()

      --  if !dim1.lt(70mm) AND !dim2.lt(70mm) then

      --    !offsetX = TRUE
      --  endif
      -- check exdmtxt less than 70mm for both, 100mm and 7mm ok

      --  if !offsetX.set() then
      --if !offsetX then
      --    ldim 1
      --    dtoff 0mm -3mm
      --    ldim 2
      --    dtoff 0mm 3mm
      --else
      --ldim 1
      --dtoff -3mm 0mm
      --ldim 2
      --dtoff 3mm 0mm
      --endif
      --  endif

      --endif

      -- endif


      --!ce = !!ce
      --view

      --!!ce = !ce

      $( not required
      --if pipca direction not orthogonal - so not parallel with p1 or p2 of component, show an angular dimension

      if !component.aDir.wrt(world).isParallel(!pipca.ddir.wrt(world)).not() AND !component.lDir.wrt(world).isParallel(!pipca.ddir.wrt(world)).not() AND !component.aDir.wrt(world).isParallel(!view1Direction.wrt(world)).not() AND !component.lDir.wrt(world).isParallel(!view1Direction.wrt(world)).not() then

        laye
        new adim

        if !component.type.eq('ELBO') OR !component.type.eq('BEND') then

          !centreOfRadius = !this.getCentrePosition(!component)

          pos $!centreOfRadius

          !elbowPos = !component.ppos[2].wrt(world)
          !pipcaPos = !pipca.position.wrt(world)

          new dpoi
          pos $!elbowPos

          new dpoi
          pos $!pipcaPos

        else
          new appt
          ddnm $!component
          --should choose ppdi 1 or 2 based on smallest angle
          ppdi 2
          new appt

          ddnm $!branchElement
        endif
      endif

      $)

      --if in-line/parallel component then show distance offset from centre-line

      if (!component.aDir.wrt(world).isParallel(!component.lDir.wrt(world))) then
        if (!component.aDir.wrt(world).isParallel(!pipca.ddir.wrt(world)).not()) then
          laye
          new ldim
          !dirLdim = !pipca.ddir.wrt(world)
          !dirLdimString = !dirLdim.string().before('WRT').trim()
          dir $!dirLdimString
          new dppt
          ddnm $!component
          new dppt
          ddnm $!pipca
        endif
      endif

      --collect all LDIMs for View 1, set DPOS to move LDIM to left hand side or top of view
      --do orthogonal cases first
      !this.moveDims(!view,1,!view1Adeg)
      --!this.moveDims(!view,1)

      --new ldim from pl of $!component to $!connectedBy of $!branchElement
      --!pos1 = p1pos of $!component
      --!pos2 = $!connectedBy pos of $!branchElement
      --!direction = !pos1.direction(!pos2)
      --!directionString = !direction.wrt(/* ).string().before('WRT')
      --dir $!directionString

      !view = !v2Name.dbref()
      !sizeOfView = !view.size
      !componentArriveDirection = !component.aDir.wrt(/* ).string().before('WRT')
      !componentLeaveDirection  = !component.lDir.wrt(/* ).string().before('WRT')
      --$!v1DimsName

      -- Work out the maximum X and Y of the top of the view
      !positionOfView = !view.xypo
      !maximumXOfView = !view.xypo.east + (!sizeOfView[1] / 2) - 6mm
      !maximumYOfView = !view.xypo.north + (!sizeOfView[2] / 2) - 12mm

      view
      update design

      -- add dimensions for view 2

      $!v2Name

      if (!scaleFlag) then
        --!scale = vscale
        !scale = 0.05
        !scale = !scale * !scaleFactor
        vscale $!scale
        --update design
      endif

      !layename2 = !v2Name & '/Dims'

      $!layename2
      handle any
      elsehandle none

        delete laye
      endhandle

      view
      new laye $!layename2 before 1

      if (  !componentLeaveDirection.direction().isParallel(!componentArriveDirection.direction())) then

        new ldim from pa of $!component to $!connectedBy of $!branchElement
        to pl of $!component
        !ldim1 = !!ce
        direction $!componentArriveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos X$!maximumXOfView Y$!maximumYOfView
          sort dim
          --if dmtxt is 0 then delete ldim
          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle

        if (!componentArriveDirection.direction().wrt(world).isParallel(!view2Direction.wrt(world))) then
          $!ldim1
          handle any
          elsehandle none
            delete ldim
          endhandle
        endif

      else

        new ldim from pa of $!component to $!connectedBy of $!branchElement
        !ldim1 = !!ce
        direction $!componentArriveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos X$!maximumXOfView Y$!maximumYOfView
          sort dim
          --if dmtxt is 0 then delete ldim
          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle

        if (!componentArriveDirection.direction().wrt(world).isParallel(!view2Direction.wrt(world))) then
          $!ldim1
          handle any
          elsehandle none
            delete ldim
          endhandle
        endif

        new ldim from pl of $!component to $!connectedBy of $!branchElement
        !ldim2 = !!ce
        direction $!componentLeaveDirection
        handle any
          ldim
          delete ldim
        elsehandle none
          dpos Y$!maximumYOfView X$!maximumXOfView
          sort dim
          --if dmtxt is 0 then delete ldim
          ldim
          2
          if (!!ce.exdmtxt.eq('0')) then
            ldim
            delete ldim
          endif

        endhandle

        if (!componentLeaveDirection.direction().isParallel(!view2Direction)) then
          $!ldim2
          handle any
          elsehandle none
            delete ldim
          endhandle
        endif

      endif

      --if component arrive/leave parallel and angle between component arrive/leave and pipca is < 45 then do offsets fo
      --connection on end of component e.g. blind flange use p0 of component?

      --!tempVector = object POINTVECTOR()
      --!tempVector.position = !this.newSurfacePosition
      --!tempVector.direction = !pipca.ddir.wrt(world)

      --!tempPlane = !tempVector.plane()

      --if on a blind flange we want distance from pa/pl along surface
      if (!component.type.eq('FBLI')) then
        !pos1 = pl pos of $!component
        !pos2 = pa pos of $!component
        !pos3 = $!connectedBy pos of $!branchElement

        if (!pos1.distance(!pos3).gt(!pos2.distance(!pos3))) then
          !pToUse = 'pa'
        else
          !pToUse = 'pl'
        endif

        new ldim from $!pToUse of $!component to $!connectedBy of $!branchElement
        !pos1 = $!pToUse pos of $!component
        --!pos2 = $!connectedBy pos of $!branchElement
        !direction = !pos1.direction(!pos3)
        !directionString = !direction.wrt(/* ).string().before('WRT')
        dir $!directionString
        handle any
          ldim
          delete ldim
        elsehandle none
        endhandle

      endif

    endif

    !this.moveDims(!view,2,!view2Adeg)

    -- view 2 dimensions end of section

    view
    update design

    --update all
    !!ce = !sheetRef
    !plotFileName = !this.pltFileDir & '\' & !sheetRef.namn.replace('/','.') & '.plt'

    --!plotFileName = !this.pltFileDir & '\' & !!generateFileName(!sheetRef.namn) & '.plt'
    plot ce "$!plotFileName" over
    --!resultPath = !plotFileName

  enddo

  --!!ce = !dwgName

  --test line to test error message return (next line)
  --!this.writeErrorMessage(!this.regiName, 'Detailed plot files successfully created for components with non-standard boss connections')

  !this.createResultFile()

  return

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      makeUnderlyingDrwg
--
-- Description: make underlying drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makeUnderlyingDrwg(!element is DBREF, !isoOptionFilePath is STRING) is STRING

  warning off
  trace off
  !this.errorList.clear()
  !resultPath = STRING()
  !dept = nulref
  !regi = nulref
  !dwg = nulref

  -- set spool element
  !this.spoolElement = !element
  !this.isoOptionFile = object FILE(!isoOptionFilePath)
  !dwgName = !this.spoolElement.name & '_Spool'

  -- set pipeSpoolType
  !this.pipeSpoolType = !this.spoolElement.pstyp.upcase()
  if (!this.pipeSpoolType.empty()) then
    !this.pipeSpoolType = 'SHOP'
  endif

  --set up format objects
  !!setGlobalFormats()

  -- Initialise Drawing
  if (!this.initializeDrawing().not()) then
    !this.createResultFile()
    return !resultPath
  endif

  -- check DEPT if exists
  !dept = !this.deptName.dbref()
  handle ANY
  endhandle
  if (!dept.badref()) then
    context draw
    new DEPT $!this.deptName
    handle ANY
      !this.writeErrorMessage(!this.deptName, 'Error creating underlying drawing - Cannot Create Department.')
      !this.createResultFile()
      return !resultPath
    endhandle
    !dept = !!ce
  endif

  -- check REGI if exists
  !regi = !this.regiName.dbref()
  handle ANY
  endhandle
  if (!regi.badref()) then
    !!ce = !dept
    new REGI $!this.regiName
    handle ANY
      !this.writeErrorMessage(!this.regiName, 'Error creating underlying drawing - Cannot Create Registry.')
      !this.createResultFile()
      return !resultPath
    endhandle
    !regi = !!ce
  else
    if (!regi.owner.neq(!dept)) then
      !this.writeErrorMessage(!this.regiName, 'Error creating underlying drawing - Registry $!this.regiName appears under different Department than $!this.deptName.')
      !this.createResultFile()
      return !resultPath
    endif
  endif

  -- check DRWG if exists
  !dwg = !dwgName.dbref()
  handle ANY
  endhandle
  if (!dwg.badref()) then
    !!ce = !regi
    new DRWG $!dwgName
    !dwg = !!ce
  else
    -- check if read-write
    !!ce = !dwg
    delete DRWG memb
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modify underlying drawing.')
      !this.createResultFile()
      return !resultPath
    endhandle
    if (!dwg.owner.neq(!regi)) then
      !!ce = !regi
      include $!dwg
      handle ANY
        !!ce = !regi
        new DRWG
        handle ANY
          !this.writeErrorMessage(!dwg, 'Error modify underlying drawing - cannot move existing ' & !dwg.namtyp & ' to Registry ' & !this.regiName & '.')
          !this.createResultFile()
          return !resultPath
        endhandle
        !deleteDwg = !dwg
        !dwg = !!ce
        !!ce = !deleteDwg
        delete DRWG
        !dwg.name = !dwgName
      endhandle
      !!ce = !dwg
    endif
  endif

  !!ce.linkref = !this.dwgTmplName.dbref()

  -- copy DRWG from template
  copy $!this.dwgTmplName rename $!this.dwgTmplName $!dwgName

  !drawingType = !!ce.func
  if (!drawingType.upcase().occurs('2D SKETCH') gt 0) then
    !isSketchType = true
  else
    !isSketchType = false
  endif

  !sheetRef = sheet 1

  -- CW - P-40137 - Fix to Add date and Loginname to pipesketch

  !session = current session
  !n = !session.name
  !!ce.author = !n

  !a = object DATETIME()
  !b = !a.date() & ' ' & !a.monthstring().substring(1,3) & ' ' & !a.year()
  !!ce.date = !b

  !name = !!ce.name
  !title = !name.after('/').before('_Spool')
  !!ce.title = ('Pipe Sketch - Spool') & (' ') & !title
  --navigate to sheet level
  1
  !!ce.title = !title
  --navigate back to drg level

  end

  update anno
  -- CW - end of fix

  -- view update
  var !viewList coll all view for drwg

  -- set draw-list on view
  do !i indices !viewList
    !view     = !viewList[!i].dbref()

    !!ce  = !view

    if (!view.func ne 'ISO_VIEW') then
      -- add item on drawlist
      goto idlname
      delete idli mem
      new adde

      !!ce.idna = !this.spoolElement

      !!ce = !view
      auto
      handle any
      endhandle
    else
      !userLabelLayer = object DBREF(!view.name & '/USER_Labs')
      handle (2,109)
        -- there is no user label layer for the view
      elsehandle none
        !userLabelLayer.lvis = false
      endhandle
    endif

    if (!isSketchType) then
      lvis true
      lframe false

      !this.markAdditionalSpoolInfo(!view)
    else
      -- invisible overlay area
      !overlayAreaLayer = object DBREF(!view.name & '/Overlay')
      handle (2,109)
        -- there is no overlay element for displaying iso plot file
      elsehandle none
        !overlayAreaLayer.lvis = false
      endhandle
    endif

    !!ce = !view
    update all
    handle any
    endhandle
  enddo

  !!ce = !sheetRef

  if (!isSketchType.not()) then
    -- create olay for displaying iso drawing if current drawing type is iso spool drawing
    !olayName = !dwgName & '/Overlay'

    new olay $!olayName
    -- assemble plot file name U files are the final underlay files
    -- rename the spool name if it is unnamed
    !newSpoolName = !this.spoolElement.namn
    !invalidStr = substring(!this.spoolElement.namn,1,1)
    if (!invalidStr.eq('=')) then
      !newSpoolName = substring(!this.spoolElement.namn,2)
    endif
    !spoolName = |U-| & !newSpoolName & |.iso.plt|
    !fileName = !!generateFileName(!spoolName)
    !olayPath = !this.pltFileDir & |\iso\| & !fileName
    Osfname /$!olayPath
    handle any
      !this.writeErrorMessage(!olayPath, 'Error creating underlying drawing - Failure of loading overlay file')
    endhandle
  endif

  -- update mto and other list on the drawing
  !sourceNoteList = !!collectAllFor('NOTE',|sppurp eq 'CELLS' and func ne ''|, !sheetRef.bsrf)

  !displayList = object ARRAY()
  do !entry values !sourceNoteList
    !tmpList    = !entry.name.split(|/|)
    !newNote    = |/| & !dwgName & |/| & !tmpList.last()
    !sourceNote = !entry.name
    new note $!newNote copy $!sourceNote ren $!sourceNote $!newNote

    -- add display detail list (Material list, etc..)
    !table[1] = !!ce.function.upcase()
    !table[2] = !!ce
    !displayList.append(!table)
  enddo

  !noteFunctions = 'MTO,OTHERDATA,BENDING,ASSEMBLY,ENDPOINT,WELDING'
  !functionList  = !noteFunctions.split(',')

  do !item values !displayList
    !this.noteRef = !item[2]
    !index = !functionList.findFirst(!item[1])
    skip if (!index.unset())

    !this.displayDrawingInformation(!functionList[!index])
  enddo


  if (!isSketchType) then
    !this.markBendingTable(!this.getBendingTable())
  endif

  -- Generate the plot file, but only if the sheet doesn't use TrueType fonts - they are
  -- not supported by the plot format
  if (!sheetRef.ttfEnabled) then
    !this.writeErrorMessage(!dwgName, 'Warning: plot could not be created because the sheet uses TrueType fonts')
  else
    !plotFileName = !this.pltFileDir & |\| & !!generateFileName(!sheetRef.namn) & |.plt|
    plot ce "$!plotFileName" over
    !resultPath = !plotFileName
  endif

  -- Test if drawing template contains an isometric view and spool contains a boss connection.
  !this.checkForIsoAndBoss()
  !this.createResultFile()

  !mem = !!ce
  !!ce = drwg
  !drwgName = name
  !regiNameOfDrwg = name of regi
  !regiNameOfPspool = '/' & !this.spoolElement.:SKTCHREGI

  if (!regiNameOfDrwg neq !regiNameOfPspool) then
    !!ce = !regiNameOfPspool.dbref()
    include $!drwgName
    handle any
      !errorMessage = 'Error occurred while including the old DRWG to the new REGI.'
      !this.writeErrorMessage(!this.spoolElement.name, !errorMessage)
      !this.createResultFile()
      return
    endhandle
  endif
  !!ce = !mem

  return !resultPath

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createResultFile
--
-- Description: create result file
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearResultFile()

  -- append error list to error file
  !this.errorLogFile.writeFile('OVERWRITE',!this.errorList)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createResultFile
--
-- Description: create result file
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createResultFile()

  -- append error list to error file
  !this.errorLogFile.writeFile('APPEND',!this.errorList)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeErrorMessage
--
-- Description: write error message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeErrorMessage(!element is ANY, !message is STRING)

  !datatype = !element.objectType()
  if (!datatype.eq('DBREF')) then
    if (!element.isNamed) then
      !name = !element.name
    else
      !name = !element.namtyp
    endif
  elseif (!datatype.eq('STRING')) then
    !name = !element
  elseif (!datatype.eq('FILE')) then
    !name = !element.string()
  endif
  --!this.errorList.append(!name & '@'  & !message)
  !this.errorList.append(!message)

endmethod
------------------------------------------------------------------------
--
-- Method:      writeErrorMessage
--
-- Description: write error message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeErrorMessage(!message is STRING)

  !this.errorList.append(!message)

endmethod
------------------------------------------------------------------------
--
-- Method:      getCentrePosition
--
-- Description: calculate centre position of elbow or bend
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R            DBREF         Elbow or bend component
-- Return:
--   [Data Type] [Description]
--    REAL            Get the actual angle of a component
--
------------------------------------------------------------------------
define method .getCentrePosition(!element is DBREF) is POSITION

  --find the centre of radius for the bend or elbow
  !aPosition = !element.aPos.wrt( /* )
  !lPosition = !element.lPos.wrt( /* )
  !aDir = !element.aDir.wrt( /* )
  !lDir = !element.lDir.wrt( /* )

  -- make a plane for the arrive and leave
  !aPlane = !this.makePlane(!aPosition,!aDir)
  !lPlane = !this.makePlane(!lPosition,!lDir)

  -- make a flat plane which passes through p1 and p2 and the elbow centre point
  --!elbowDir = !aDir.cross(!lDir)
  !elbowDir = !element.orientation.zDir()
  !bendArc = object ARC()
  !radius = !this.getRadius(!element)
  -- !intersect = !aPlane.pointVector().intersection(!lPlane.pointVector())
  !bendArc = !aPosition.arcRadius( !lPosition, !element.position.wrt(/* ), !elbowDir, !radius,FALSE)

  !position = !bendArc.position.wrt(world)

  return !position

endmethod


define method .getRadius(!element is DBREF ) is REAL

  !aDir = !element.aDir
  !lDir = !element.lDir
  !angle = !aDir.angle(!lDir) / 2
  !adj = !element.aPos.distance(!element.pos)
  if (!adj.eq(0)) then
    !bendRadius = 0
  else
    !bendRadius = tan( !angle ) * !adj
  endif

  return !bendRadius

endmethod

define method .makePlane(!passedPosition is POSITION,!direction is DIRECTION)is PLANE

  !plane = object PLANE()
  !plane.position = !passedPosition
  !plane.orientation = z is $!direction
  return !plane

endmethod
------------------------------------------------------------------------
--
-- Method:      moveDims
--
-- Description: Move dimensions to reserved areas at edges of views
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveDims(!view is DBREF,!whichView is REAL,!angle is REAL)

  !ref = !!ce
  $!view
  !viewDir = dir wrt /*
  var !ldims coll all ldim for ce

  do !ldim values !ldims

    --define variables for if dimension is long or short
    !longDim = FALSE
    !shortDim = FALSE

    !ldimRef = !ldim.dbref()
    !dimDir = !ldimRef.dir.wrt(world)

    $!ldimRef

    var !dpptColl coll all dppt for ce
    if (!dpptColl.size().gt(1)) then
      var !dmtxt eval exdmtxt for all from !dpptColl
      do !index indices !dmtxt
        if (!index.neq(1)) then
          !dmtxtVal = !dmtxt[!index].real()
          handle any
          elsehandle none
            if (!dmtxtVal.geq(500)) then
              !longDim = TRUE
            elseif (!dmtxtVal.lt(100)) then
              !shortDim = TRUE
            endif
          endhandle
        endif
      enddo

    endif
    --if view dir parallel with U (top of view will be N)
    if (!viewDir.isParallel(U)) then

      if (!viewDir.cross(!dimDir).isParallel(N)) then

        --put dim at top
        if (!whichView.eq(1)) then
          if (!longDim) then
            dpos 0 53
          elseif (!shortDim) then
            dpos 0 52
            dtoff 0 4
          else
            dpos 0 55
          endif
        else
          if (!longDim) then
            dpos 60 53
          elseif (!shortDim) then
            dpos 60 52
            dtoff 0 4
          else
            dpos 60 55
          endif
        endif
      else
        --put at side
        if (!whichView.eq(1)) then
          if (!longDim) then
            dpos 7 0
          elseif (!shortDim) then
            dpos 8 0
            dtoff 0 5
          else
            dpos 5 0
          endif
        else
          if (!longDim) then
            dpos 67 0
          elseif (!shortDim) then
            dpos 68 0
            dtoff 0 5
          else
            dpos 65 0
          endif
        endif
      endif

    else

      --(top of view will be as U as possible)

      --!adegFactor = !view.adeg / 90
      --!adegFactor = !adegFactor.abs()

      $(

      $p abs angle
      !vv = (!angle.abs() / 180)
      q var !vv

      $p view dir crossed with dim dir, up comp
      q var !viewDir.cross(!dimDir).up
      !newFactor = !viewDir.cross(!dimDir).up + (!angle / 180)
      if !newFactor.gt(1) then
        !newFactor = !newFactor - 1
      endif
      $p new factor
      q var !newfactor
      --!totalFactor = !viewDir.cross(!dimDir).up.abs()
      --$p factor
      --q var !totalFactor
      --q var !viewDir.cross(!dimDir).up.abs()

      $)

      if (!viewDir.cross(!dimDir).isParallel(U)) then
        --if !viewDir.cross(!dimDir).up.abs().gt(0.5) AND !view.adeg.between(45,90).not() then
        --if !viewDir.cross(!dimDir).up.abs().gt(0.5) AND !view.adeg.between(45,90).not() then
        --if !viewDir.cross(!dimDir).up.abs().gt(0.5) then
        --put dim at top
        if (!whichView.eq(1)) then
          if (!longDim) then
            dpos 0 53
          elseif (!shortDim) then
            dpos 0 52
            dtoff 0 4
          else
            dpos 0 55
          endif
        else
          if (!longDim) then
            dpos 60 53
          elseif (!shortDim) then
            dpos 60 52
            dtoff 0 4
          else
            dpos 60 55
          endif
        endif
      else
        --put at side
        if (!whichView.eq(1)) then
          if (!longDim) then
            dpos 7 0
          elseif (!shortDim) then
            dpos 8 0
            dtoff 0 5
          else
            dpos 5 0
          endif
        else
          if (!longDim) then
            dpos 67 0
          elseif (!shortDim) then
            dpos 68 0
            dtoff 0 5
          else
            dpos 65 0
          endif
        endif
      endif
    endif

  enddo

  !!ce = !ref

endmethod

------------------------------------------------------------------------
--
-- Method:      createBaseDrawing
--
-- Description: Create temporary template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createBaseDrawing() is BOOLEAN

  !ref = !!ce

  /DRA/PRJ/REPR/GEN/PIPE
  handle any
    if (!!module().productfamily.upcase().eq('MARINE')) then
      !this.writeErrorMessage(!!ce, 'Error creating detailed plot drawing - database MPROJECT/PADD must be in current MDB')
    else
      !this.writeErrorMessage(!!ce, 'Error creating detailed plot drawing - database ADMIN/PADD must be in current MDB')
    endif
    !this.createResultFile()
    return FALSE
  endhandle

  !!ce = !ref

  NEW REGISTRY /TEMP-REGI
  SIZE 1189mm 841mm
  UCOD mm  Distance  mm  Bore Nominal
  FONT 5
  DTER Arrows
  LTER Off
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 1
  NLSTYL Solid
  NLCOLO 1
  LLSTYL Solid
  LLCOLO 1
  LFSTYL Solid
  LFCOLO 1
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  POSFOR ENU

  NEW DRWG /DETAIL/TEMP
  DATE '5  Apr 2013'
  SIZE 120mm 60mm
  FONT 1
  UCOD mm  Distance  mm  Bore Nominal
  DTER Arrows
  LTER Off
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TITL 'Detail Plot View'
  AUTH 'chris.whiteley'
  TXCOLO 1
  NLSTYL Solid
  NLCOLO 1
  LLSTYL Solid
  LLCOLO 1
  LFSTYL Solid
  LFCOLO 1
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  POSFOR ENU

  NEW SHEET /DETAIL/TEMP/S1
  SIZE 120mm 60mm
  TITL 'Piping Drawing'
  POSFOR ENU

  NEW VIEW /DETAIL/TEMP/S1/V1
  DIR D
  VSCA 0.05
  VTYP Universal HLine
  SIZE 60mm 60mm
  XYPS X 30mm Y 30mm
  LFRA true
  NLSTYL Solid
  NLCOLO 8
  POSFOR ENU

  NEW LAYER /DETAIL/TEMP/S1/V1/USER_dims
  PURP DIMA
  UCOD mm  Distance  mm  Bore Nominal
  FONT 11
  LTER Off
  JUST Left
  ALIGN Bbody
  DTER Arrows
  TSIZ 3mm
  CHOS 6mm
  ASUB 0degree
  PJUS Towards
  OSHT 2mm
  PLCL 0mm
  DOFF 25mm
  DMSP 0mm
  DIR E
  CHEI 3mm
  LLEA true
  LFRA true
  LSHA Straight
  GBOX 1mm
  CSPA 0
  LSPA 0
  LLCL 0mm
  XYPS 25mm 25mm
  BPOF 0mm 0mm
  BLNK false
  BMAR 0mm
  FTER Default
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 10
  NLSTYL Solid
  NLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  LLSTYL Solid
  LLCOLO 1
  LFSTYL Solid
  LFCOLO 1
  DLSTYL Solid
  DLCOLO 10
  PLSTYL Solid
  PLCOLO 10
  MSTYLE Off
  MCOLOUR 1
  CHSTYL Off
  CHCOLO 1
  POSFOR ENU

  END
  NEW LAYER /DETAIL/TEMP/S1/V1/USER_labs
  PURP LABA
  UCOD mm  Distance  mm  Bore Nominal
  FONT 11
  LTER Off
  JUST Left
  ALIGN Base
  DTER Arrows
  TSIZ 3mm
  CHOS 6mm
  ASUB 0degree
  PJUS Towards
  OSHT 2mm
  PLCL 0mm
  DOFF 25mm
  DMSP 0mm
  DIR E
  CHEI 3mm
  LLEA true
  LFRA true
  LSHA Straight
  GBOX 0mm
  CSPA 0
  LSPA 0
  LLCL 0mm
  XYPS 0mm 0mm
  BPOF 0mm 0mm
  BLNK false
  BMAR 0mm
  FTER Default
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 2
  NLSTYL Solid
  NLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  LLSTYL Solid
  LLCOLO 2
  LFSTYL Solid
  LFCOLO 2
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  MSTYLE Off
  MCOLOUR 1
  CHSTYL Off
  CHCOLO 1
  POSFOR ENU

  END
  NEW LAYER /DETAIL/TEMP/S1/V1/USER_notes
  PURP NOTA
  UCOD mm  Distance  mm  Bore Nominal
  FONT 1
  LTER Off
  JUST Left
  ALIGN Bbody
  DTER Arrows
  TSIZ 3mm
  CHOS 6mm
  ASUB 0degree
  PJUS Towards
  OSHT 2mm
  PLCL 0mm
  DOFF 25mm
  DMSP 0mm
  DIR E
  CHEI 3mm
  LLEA true
  LFRA true
  LSHA Straight
  GBOX 1mm
  CSPA 0
  LSPA 0
  LLCL 0mm
  XYPS 25mm 25mm
  BPOF 0mm 0mm
  BLNK false
  BMAR 0mm
  FTER Default
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 1
  NLSTYL Solid
  NLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  LLSTYL Solid
  LLCOLO 1
  LFSTYL Solid
  LFCOLO 1
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  MSTYLE Off
  MCOLOUR 1
  CHSTYL Off
  CHCOLO 1
  POSFOR ENU

  NEW VNOTE
  XYPS X 30mm Y 30mm
  JUST Left
  ALIGN Bbody
  FONT 1
  BLNK false
  BMAR 0mm
  CHEI 3mm
  CSPA 0
  LSPA 0
  TXCOLO 1
  NLSTYL Solid
  NLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  MSTYLE Stop Scale 1
  MCOLOUR 1

  END
  END
  NEW LAYER /DETAIL/TEMP/S1/V1/USER_tags
  PURP TAGA
  UCOD mm  Distance  mm  Bore Nominal
  FONT 1
  LTER Off
  JUST Left
  ALIGN Bbody
  DTER Arrows
  TSIZ 3mm
  CHOS 6mm
  ASUB 0degree
  PJUS Towards
  OSHT 2mm
  PLCL 0mm
  DOFF 25mm
  DMSP 0mm
  DIR E
  CHEI 4mm
  LLEA true
  LFRA true
  LSHA Straight
  GBOX 1mm
  CSPA 0
  LSPA 0
  LLCL 0mm
  XYPS 25mm 25mm
  BPOF 0mm 0mm
  BLNK false
  BMAR 0mm
  FTER Default
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 4
  NLSTYL Solid
  NLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  LLSTYL Solid
  LLCOLO 4
  LFSTYL Solid
  LFCOLO 4
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  MSTYLE Off
  MCOLOUR 1
  CHSTYL Off
  CHCOLO 1
  POSFOR ENU

  END
  END
  END
  NEW LIBY /DETAIL/TEMP/LIBY
  SIZE 1189mm 841mm
  UCOD mm  Distance  mm  Bore Nominal
  FONT 1
  DTER Arrows
  LTER Off
  PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
  NTEXT unset
  TXCOLO 1
  NLSTYL Solid
  NLCOLO 1
  LLSTYL Solid
  LLCOLO 1
  LFSTYL Solid
  LFCOLO 1
  DLSTYL Solid
  DLCOLO 1
  PLSTYL Solid
  PLCOLO 1
  FSTYLE Off
  FCOLOUR 1
  POSFOR ENU

  NEW PLLB

  END
  NEW DLLB

  NEW IDLIST

  NEW ADDENTRY

  END
  END
  END
  NEW TRLB

  END
  END
  END
  END
  OLD DRWG /DETAIL/TEMP
  IDLN IDLIST 1 of DLLB 1 of LIBY /DETAIL/TEMP/LIBY
  RRSF RRST /DRA/PRJ/REPR/GEN/PIPE

  OLD SHEET /DETAIL/TEMP/S1
  IDLN IDLIST 1 of DLLB 1 of LIBY /DETAIL/TEMP/LIBY

  OLD VIEW /DETAIL/TEMP/S1/V1
  IDLN IDLIST 1 of DLLB 1 of LIBY /DETAIL/TEMP/LIBY
  RRSF RRST /DRA/PRJ/REPR/GEN/BASIC

  !!ce = !ref

  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      deleteBaseDrawing
--
-- Description: Delete temporary template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteBaseDrawing()

  !ref = !!ce

  /TEMP-REGI
  handle any
    return
  endhandle

  delete regi
  handle any
    return
  endhandle

  !!ce = !ref
  handle any
  endhandle

endmethod
