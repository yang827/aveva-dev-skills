-- Kill existing form definition
-- kill !!glbAllDb

-- Define form
setup form !!glbAllDb at xr 0.35 yr 0.1 resize

  !!glbAllDb.formTitle     = 'Database Allocation (By Database)'
  !!glbAllDb.iconTitle     = 'ALLOC BY DB'
  !!glbAllDb.callback      = 'call !!glbAllDbInit()'
  !!glbAllDb.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  frame .dbFrame anchor all at x 4 y 0 |Project Databases|

    list   .projectDb anchor all         at xmin+1 ymin+1 call |call !!glbAllDbRefSel(_projectDb)| columns width 58 height 10
    option .sort      anchor bottom+left at xmin ymax+0.2 |Sort By| call |call !!glbAllDbArrList()| width 12
    text   .filter    anchor bottom+left at xmax+1 ymin   |Filter|  call |call !!glbAllDbArrList()| width 15 STRING

  exit

  -- Frame containing allocation details.
  frame .allocFrame anchor bottom+left+right at x 0 ymax+0.5 |Allocation Details|

    list   .locn anchor all at xmin+1 ymin+1 |Project Locations| columns multiple width 30 height 11

    button .add  anchor top+right at xmax+0.2 ymin+1 call |call !!glbAllDbAdd()| pixmap width 16 height 16
    button .aAll anchor top+right at xmin     ymax   call |call !!glbAllDbAddAll()| pixmap width 16 height 16
    button .rem  anchor top+right at xmin     ymax+1 call |call !!glbAllDbRem()| pixmap width 16 height 16
    button .rAll anchor top+right at xmin     ymax   call |call !!glbAllDbRemAll()| pixmap width 16 height 16

    list   .alloc anchor top+bottom+right at xmax+0.2 ymin.locn |Allocated To| multiple width 30 height 11

  exit

  button   .apply   anchor bottom+left  at xmin ymax+0.5 |Apply| call |call !!glbAllDb()| APPLY
  button   .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
    -- Array of project databases
    member .dbArray  is ARRAY
    -- Array of project locations
    member .locArray is ARRAY
    member .parArray is ARRAY
    member .levArray is ARRAY
    -- Current Database and allocation
    member .dbRef    is DBREF
    member .primary  is DBREF
    member .allocRef is ARRAY
    -- Store for sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING


exit
-- End of form definition for !!glbAllDb

-- set icons
!!glbAllDb.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
!!glbAllDb.aAll.addPixmap(!!pml.getPathName('rightrightarrow16.png'))
!!glbAllDb.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))
!!glbAllDb.rAll.addPixmap(!!pml.getPathName('leftleftarrow16.png'))

-- Assign sort gadget values
call !!admDbSortGadg(!!glbAllDb.sort)

-- Assign filter gadget values
!!glbAllDb.filter.val = |*|
