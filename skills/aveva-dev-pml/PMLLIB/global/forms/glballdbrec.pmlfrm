-- Method:      .dbList()
--
-- Description: Update and maintain the Database list gadgets based on
-- sort and filter values in form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbList()

  !this.glballRecoverDb.dbList()

endmethod
-- End of method definition for .dbList()

