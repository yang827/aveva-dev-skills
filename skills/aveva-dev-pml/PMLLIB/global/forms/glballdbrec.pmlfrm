endmethod
-- End of method definition for .locSel()

------------------------------------------------------------------------
--
-- Method:      .target()
--
-- Description: method to control the gadget states in the Recover Database form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .target()

  !this.glballRecoverDb.target()

endmethod
-- End of method definition for .target()
