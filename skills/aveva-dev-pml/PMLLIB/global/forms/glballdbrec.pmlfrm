-- File:            glballdbrec.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Aug 11 15:53:05 BST 1997
--
--
-- Description:
-- Form definition to allow a corrupt PRIMARY database to be restored
-- to a working state from a (secondary) location. This is a quick
-- method of allowing work to continue without resorting to the tape
-- backup.
-- This form provide the functionality of
-- RECOVER-> dbname-+-> AT-> location-.
--                  `-----------------+-> FROM-> location
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to recover a database in case of failure.
--  dbList()                         -                   Update and maintain the Database list gadgets based on
--  dbSel()                          -                   method to deal with the selection of the database to recover.
--  glballDbRec()                    -                   Constructor
--  init()                           -                   Initialise the Recover Db form (!!glballDbRec).
--  locSel()                         -                   method to deal with the selection of the a location to
--  target()                         -                   method to control the gadget states in the Recover Database form.
--
------------------------------------------------------------------------

-- Define form
setup form !!glballDbRec resize

  !this.formTitle     = 'Recover Database'
  !this.iconTitle     = 'REC DB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  option .target   at x1 ymax+0.2 tagwid 15 |Recover | call |!this.target()| width 20

  list   .locn     at xmin ymax+0.2 call |!this.locSel()| anchor r+t+l columns width 52 height 5

  -- Body of form definition
  frame .dbFrame   at x 0.2 ymax || anchor all

    if(!!admControl.isValid('Centralised Admin')) then
      -- Global Plus only - not global 1
      option .whichDbs at x 1 ymax+0.2 tagwid 15 |Type of Databases | call |!this.dbList()| width 18
    endif

    list   .db     at x 1 ymax+0.2 call |!this.dbSel()| anchor all columns width 52 height 15

    option .sort   at xmin ymax+0.2 |Sort By | anchor b+l call |!this.dbList()| width 12
    text   .filter at xmax+1 ymin | Filter | anchor b+r call |!this.dbList()| width 20 STRING

  exit

  button .apply   at x 0.2 ymax+0.5 |Apply| anchor b+l call |!this.cbApply()| APPLY
  button .dismiss anchor b+r at xmax form-size ymin |Dismiss| CANCEL


  -- Member Definitions
    -- Object serving this form
    member .glballRecoverDb is GLBALLRECOVERDB
    -- Array of databases at location
    member .dbArray  is ARRAY
    -- Selected database
    member .database is DBREF
    -- Selected location
    member .location is DBREF
    -- Sort and Filter gadget memory
    member .dbFilter is STRING
    member .dbSort   is STRING
    -- Stores the current at location for recover to take place at
    member .atLoc    is DBREF
    -- User or System DB's Selected USER=TRUE SYSTEM=FALSE
    member .userDbs  is BOOLEAN

exit
-- End of form definition for !!glballRmtRec

------------------------------------------------------------------------
--
-- Method:      .glballDbRec()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glballDbRec()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- Assign Target gadget values
  !dText.append(|From Primary Location|)
  !dText.append(|From Selected Location|)
  !dText.append(|To All Locations|)
  !this.target.dText  = !dText
  !dText.clear()
  !rText.append(|SYSTEM|)
  !rText.append(|SELECT|)
  !rText.append(|ALL|)
  !this.target.rText  = !rText
  !rText.clear()

  if(!!admControl.isValid('Centralised Admin')) then
    -- Assign whichDbs gadget values
    !dText.append(|User Databases|)
    !dText.append(|System Databases|)
    !this.whichDbs.dText  = !dText
    !dText.clear()
    !rText.append(|USER|)
    !rText.append(|SYSTEM|)
    !this.whichDbs.rText  = !rText
    !rText.clear()
  endif

  -- Assign Sort gadget values
  call !!admDbSortGadg(!this.sort)

  -- Set filter gadget
  !this.filter.val = |*|
  !this.userDbs    = true
  !this.atLoc      = object DBREF()

  -- Fix for defect DFN2024
  -- Make sure that 'at location' member is at least set to current location
  !this.atLoc = CURLOC

  -- initialise object serving this form
  !this.glballRecoverDb.parentForm(!this)

endmethod
-- End of form definition for !!glballDbRec

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: method to recover a database in case of failure.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()

  !this.glballRecoverDb.cbApply()

endmethod
-- End of method definition for .cbApply()

