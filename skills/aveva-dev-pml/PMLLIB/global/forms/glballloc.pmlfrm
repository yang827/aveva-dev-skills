--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue Jul 8 16:39:39 BST 1997
--
--
-- Description:
-- Project database allocation by location.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Callback method to the Add button in the Database Allocation
--  addAll()                         -                   Callback method to the AAll button in the Database Allocation
--  allAdd(DBREF)                    -                   Function to add a DBREF to the allocation of the selected location
--  allGet(ARRAY,ARRAY)              -                   Function to return the form members for database allocation of the
--  allList()                        -                   Function to control and display the database allocation of the
--  allRem(DBREF)                    -                   Function to remove a DBREF from the allocation of the selected
--  allSet()                         -                   Function to set the form member for database allocation for the
--  arrGet()                         ARRAY               Function to return the form member for project locations in the
--  arrList()                        -                   Function to list the project locations in the Database Allocation
--  arrSet()                         -                   Function to set the form member for Project Locations in the
--  cbApply()                        -                   Function to allocate and de-allocate databases to or from the selected
--  err(ARRAY)                       -                   Function to populate the textpane gadget in the Allocation Errors
--  glbAllLoc()                      -                   constructor function for this form !
--  init()                           -                   Function to initialise the Database Allocation By Location form.
--  refGet()                         DBREF               Function to return the current selected location form member value
--  refSel()                         -                   Callback method to selection of a location to work on in the
--  refSet(DBREF)                    -                   Function to save the selected location in a form member in the
--  rem()                            -                   Callback method to the Rem button in the Database Allocation
--  remAll()                         -                   Callback method to the AAll button in the Database Allocation
--
------------------------------------------------------------------------

-- Define form
setup form !!glbAllLoc resize

  !!glbAllLoc.formTitle     = 'Database Allocation (By Location)'
  !!glbAllLoc.iconTitle     = 'ALLOC BY LOC'
  !!glbAllLoc.callback      = '!!glbAllLoc.init()'
  !!glbAllLoc.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition
  list .loc anchor top+left+right at x 5 y 0  |Project Locations| call |!this.refSel()| columns width 58 height 6

  -- Frame containing allocation details
  frame .allocFrame anchor all at x 0 ymax |Database Allocation|

    list .db anchor top+bottom+left at xmin+1 ymin+1  |De-Allocated| multiple columns width 30 height 15
    button .clrDb anchor top+left at xmax-8.5 ymin-0.4  |Clear| call |!this.db.clearSelection()|

    button .add  anchor top+left at xmax.db+0.1 ymin.db+2 pixmap width 16 height 16 call |!this.add()|
    button .aAll anchor top+left at xmin ymax    pixmap width 16 height 16 call |!this.addAll()|
    button .rem  anchor top+left at xmin ymax+2  pixmap width 16 height 16 call |!this.rem()|
    button .rAll anchor top+left at xmin ymax    pixmap width 16 height 16 call |!this.remAll()|

    list   .alloc    anchor all at xmax+0.1 ymin.db |Allocated| multiple columns width 30 height 15
    button .clrAlloc anchor top+right at xmax-8.5 ymin-0.4 |Clear| call |!this.alloc.clearSelection()|

    option .sort   anchor bottom+left  at xmin.db ymax.db+0.2 |Sort By| call |!this.allList()| width 12
    text   .filter anchor bottom+left  at xmax+1 ymin |Filter | call |!this.allList()| width 15 STRING
    button .copy   anchor bottom+right at xmax+2 ymin |Copy Allocation...| form !!glbCpyAll

  exit

  frame .optionFrame anchor bottom at xmin.allocFrame+11 ymax |Processing Options|
    toggle .include at xmin+1 ymax |Include descendants when de-allocating databases|
    toggle .propagatingOnly at xmin ymax |'Allocate All' to allocate non-propagating databases|
    toggle .suppress at xmin ymax |Show errors as summary at end of processing|
    toggle .keepmdb at xmin ymax |Keep MDBs while De-allocating DBs|
  exit

  button .apply   anchor bottom+left  at xmin.allocFrame ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| CANCEL

  -- set icons
  !!glbAllLoc.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !!glbAllLoc.aAll.addPixmap(!!pml.getPathName('rightrightarrow16.png'))
  !!glbAllLoc.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !!glbAllLoc.rAll.addPixmap(!!pml.getPathName('leftleftarrow16.png'))


  -- Member Definitions
    -- Array of project locations
    member .locArray  is ARRAY
    -- Array of project databases
    member .dbArray   is ARRAY
    -- Current location and allocation
    member .locRef    is DBREF
    -- allocated
    member .allocArr  is ARRAY
    -- deallocated
    member .deAllArr  is ARRAY
    -- Sort and filter values
    member .sortVal   is STRING
    member .filterVal is STRING
    -- Member to store db format
    member .displayFormat is DBLISTATTR

exit
-- End of form definition for !!glbAllLoc
------------------------------------------------------------------------
--
--Method:.glbAlloc()
--
-- Description: constructor function for this form !
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .glbAllLoc()

  !this.displayFormat.name  = TRUE
  !this.displayFormat.typeDb = TRUE
  !this.displayFormat.dbNo = FALSE
  !this.displayFormat.description = FALSE
  !this.displayFormat.access = FALSE
  !this.displayFormat.claim = FALSE
  !this.displayFormat.filename = FALSE

endmethod
-- End of method definition for .glbAllLoc()
------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: Function to allocate and de-allocate databases to or from the selected
-- location in the Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !continue   = true
  !continueAll = true
  !continueTransaction = true
  !answered   = false
  !matchFound = false
--  !curPos     = !!ce
  !locRf      = !this.refGet()
  !curLoc     = CURLOC
  !include    = !this.include.val
  !suppress   = !this.suppress.val
  !keepmdb    = !this.keepmdb.val
  !updateFlag = false
  !curAlloc   = ARRAY()
  !alloc      = ARRAY()
  !deAlloc    = ARRAY()
  !addDb      = ARRAY()
  !remDb      = ARRAY()
  !commands   = ARRAY()
  !commRefs   = ARRAY()
  !errors     = ARRAY()
  if (!include) then
    !includeTxt = |INCLUDING DESCENDANTS|
  else
    !includeTxt = ||
  endif

  if (!keepmdb) then
    !keepmdbTxt = | KEEPMDBS |
  else
    !keepmdbTxt = ||
  endif

  -- Get the locations current allocation

  !!ce        = !locRf
--  !clause     = 'TYPE eq |DB|'
--  !curAlloc   = !!collectAllFor('',!clause,!!ce)
  !curAlloc   = !!ce.mem[1].mem

  -- Get Desired allocation through the form
  !this.allGet(!alloc, !deAlloc)
  -- Determine which databases must be added and removed
  -- all dbs in !curAlloc but not in !alloc i.e.:- All DBs currently allocated to be removed
  !remDb      = !curAlloc.difference(!alloc)
  -- all dbs in !alloc but not in !curAlloc i.e.:- All DBs that need to be allocated
  !addDb      = !alloc.difference(!curAlloc)

  -- Deallocate (Remove) database from this location
  -- Additional Clause checks. Cannot use deallocate all for the last transaction dB
  if (!alloc.empty() AND (!curAlloc EQ !remDb) AND NOT !remDb.empty() AND (!remDb.size() gt 1))then
    -- De-allocate all databases
    !command    = |DEALLOCATE ALL| + !keepmdbTxt + | at '|+ !locRf.locId +|' |
    -- Extra warning about transaction dB
    !!alert.warning(|'DEALLOCATE ALL' Note that the Transaction dB for this location will not be deallocated by this command|)
    !commands.append(!command)
    !commRefs.append('ALL')

  elseif(NOT !remDb.empty()) then

    -- Create require de-allocate commands
    do !db values !remDb
      !command    = |DEALLOCATE |+ !db.name.substring(3) + !keepmdbTxt + | AT '|+ !locRf.locId +|' |+ !includeTxt
      !commands.append(!command)
      !commRefs.append(!db)

    enddo

  endif

  -- Allocate (Add) databases to this location
  if (!deAlloc.empty() AND NOT !addDb.empty()) then

    -- Check to see if allocation is in progress and give warning
    GETWORK

    if (!locRf.members[1].dealal) then
      !answer = !!alert.confirm('DEALLOCATE ALL is in progress for ' & !locRf.locId & '. ALLOCATE ALL will stall until$
 DEALLOCATE ALL has completed. Continue?')
      if (!answer.boolean()) then
        if (!this.propagatingOnly.val) then
          !answerTwo = !!alert.confirm(|The option - 'Allocate All' to allocate non-propagating databases - is switched ON.$
 This is not the default. Continue?|)
        else
          !answerTwo = true
        endif
        if (!answerTwo.boolean()) then
          -- Allocate all databases (Continue because use said so even though DEALLOCATE ALL is in progress)
          if (!this.propagatingOnly.val) then
            !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|' OVERRIDE PROPG|
          else
            !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|'|
          endif
          !commands.append(!command)
          !commRefs.append('ALL')
        endif
      endif
    else
      -- Check for any individual databases being deallocated
      do !db value !addDb
        !deallocateArray = !db.members[1].dealdb
        if (!deallocateArray.size() gt 0) then
          !matchFound = false
          do !i indices !deallocateArray
            -- It could be that the location db ref is unset so test for this
            !validateDeallocateArray = !deallocateArray[!i].locId
            handle ANY
              !validateDeallocateArray = 'NOT SET'
            endhandle
            if (!validateDeallocateArray eq !locRf.locId) then
              !answer = !!alert.confirm('DEALLOCATE DB is in progress for ' & !db.name.substring(3) & '. ALLOCATE ALL will stall until$
 DEALLOCATE DB has been completed. Continue?')
              !matchFound = true
              if (!answer.boolean()) then
                if (!this.propagatingOnly.val) then
                  !answerTwo = !!alert.confirm(|The option - 'Allocate All' to allocate non-propagating databases - is switched ON.$
 This is not the default. Continue?|)
                else
                  !answerTwo = true
                endif
                if (!answerTwo.boolean()) then
                  -- Allocate all databases (Continue because use said so even though DEALLOCATE ALL is in progress)
                  if (!this.propagatingOnly.val) then
                   !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|' OVERRIDE PROPG|
                  else
                   !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|'|
                  endif
                  !commands.append(!command)
                  !commRefs.append('ALL')
                endif
              endif
            endif
            if (!matchFound) then
              -- No point in looking for more locations
              break
            endif
          enddo
        endif
        if (!matchFound) then
          -- No point in looking for more dbs
          break
        endif
      enddo
    endif

    -- if no deallocate all is in progress and no dB was found to be in progress just do it
    if (!locRf.members[1].dealal.not() and !matchFound.not() ) then
      if (!this.propagatingOnly.val) then
        !answerOne = !!alert.confirm(|The option - 'Allocate All' to allocate non-propagating databases - is switched ON.$
 This is not the default. Continue?|)
      else
        !answerOne = true
      endif
      if (!answerOne.boolean()) then
        -- Allocate all databases (Continue because use said so)
        if (!this.propagatingOnly.val) then
          !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|' OVERRIDE PROPG|
        else
          !command    = |ALLOCATE ALL AT '|+ !locRf.locId +|'|
        endif
        !commands.append(!command)
        !commRefs.append('ALL')
      endif
    endif

  elseif(NOT !addDb.empty()) then

    GETWORK
    -- Create required allocate commands
    do !db value !addDb

      if (!locRf.members[1].dealal) then
        -- Deallocation from this location is in progress so give warning (but only once)
        if (!answered.not()) then
          !answer = !!alert.confirm('DEALLOCATE ALL is in progress for ' & !locRf.locId & '. ALLOCATE DB will stall until$
 DEALLOCATE ALL has completed. Continue with all databases where this is the case?')
          if (!answer.boolean()) then
          else
            !continueAll = false
            !continue    = false
          endif
          !answered = true
        endif
      endif

      !deallocateArray = !db.members[1].dealdb
      if (!deallocateArray.size() gt 0) then
        !matchFound = false
        do !i indices !deallocateArray
          !validateDeallocateArray = !deallocateArray[!i].locId
          handle ANY
            !validateDeallocateArray = 'NOT SET'
          endhandle
          if (!validateDeallocateArray eq !locRf.locId) then
            -- Deallocation from this location is in progress so give warning (but only once)
            if (!answered.not()) then
              !answer = !!alert.confirm('DEALLOCATE is in progress for ' & !db.name.substring(3) & '. ALLOCATE on this DB will stall until$
 DEALLOCATE has been completed. Continue with all databases where this is the case?')
              if (!answer.boolean()) then
                -- Continue because user said so, even though there are DEALLOCATE DB in progress for this DB at this location
                if (!db.type eq 'TRAN') then
                  if (!locRf.locId neq !curLoc.locId) then
                    !confirmTransaction = !!alert.confirm('Are you sure you wish to allocate the transaction dB ' & !db.name.substring(3) )
                    !continueTransaction = !confirmTransaction.boolean()
                  endif
                endif
                if (!continueTransaction) then
                  !command    = |ALLOCATE |+ !db.name.substring(3) +| AT '|+ !locRf.locId +|'|
                  !commands.append(!command)
                  !commRefs.append(!db)
                else
                  !continueTransaction = true
                  -- need to put that database back in the deallocated list
                  !this.alloc.clearSelection()
                  !this.db.clearSelection()
                  !this.alloc.select('rtext', !db.refe.string())
                  -- Record the selected text
                  !dtext = !this.alloc.selection('dtext')
                  !rtext = !this.alloc.selection('rtext')
                  !tempArrayDtext = !this.alloc.dtext
                  !tempArrayRtext = !this.alloc.rtext
                  !valueArray = !this.alloc.val
                  !tempArrayDtext.remove(!valueArray[1])
                  !tempArrayRtext.remove(!valueArray[1])
                  !this.alloc.clearSelection()
                  !this.db.clearSelection()
                  !this.alloc.dtext = !tempArrayDtext
                  !this.alloc.rtext = !tempArrayRtext
                  !tempArrayDtext = !this.db.dtext
                  !tempArrayRtext = !this.db.rtext
                  !tempArrayDtext.append(!dtext[1])
                  !tempArrayRtext.append(!rtext[1])
                  !this.db.dtext = !tempArrayDtext
                  !this.db.rtext = !tempArrayRtext
                endif
              else
                !continue = false
              endif
              !answered = true
            else
              if (!continue) then
                -- Continue because user previously said so, even though there are DEALLOCATE DB in progress for this DB at this location
                if (!db.type eq 'TRAN') then
                  if (!locRf.locId neq !curLoc.locId) then
                    !confirmTransaction = !!alert.confirm('Are you sure you wish to allocate the transaction dB ' & !db.name.substring(3) )
                    !continueTransaction = !confirmTransaction.boolean()
                  endif
                endif
                if (!continueTransaction) then
                  !command    = |ALLOCATE |+ !db.name.substring(3) +| AT '|+ !locRf.locId +|'|
                  !commands.append(!command)
                  !commRefs.append(!db)
                else
                  !continueTransaction = true
                  -- need to put that database back in the deallocated list
                  !this.alloc.clearSelection()
                  !this.db.clearSelection()
                  !this.alloc.select('rtext', !db.refe.string())
                  -- Record the selected text
                  !dtext = !this.alloc.selection('dtext')
                  !rtext = !this.alloc.selection('rtext')
                  !tempArrayDtext = !this.alloc.dtext
                  !tempArrayRtext = !this.alloc.rtext
                  !valueArray = !this.alloc.val
                  !tempArrayDtext.remove(!valueArray[1])
                  !tempArrayRtext.remove(!valueArray[1])
                  !this.alloc.clearSelection()
                  !this.db.clearSelection()
                  !this.alloc.dtext = !tempArrayDtext
                  !this.alloc.rtext = !tempArrayRtext
                  !tempArrayDtext = !this.db.dtext
                  !tempArrayRtext = !this.db.rtext
                  !tempArrayDtext.append(!dtext[1])
                  !tempArrayRtext.append(!rtext[1])
                  !this.db.dtext = !tempArrayDtext
                  !this.db.rtext = !tempArrayRtext
                endif
              endif
            endif
            !matchFound = true
            if (!matchFound) then
              -- No point in looking for more locations
              break
            endif
          endif
        enddo

        -- if this location was not found after looping through all deallocate on this DB
        if (!matchFound.not() and !continueAll) then
          -- Continue because there are no DEALLOCATE DB in progress for this DB at this location
          if (!db.type eq 'TRAN') then
            if (!locRf.locId neq !curLoc.locId) then
              !confirmTransaction = !!alert.confirm('Are you sure you wish to allocate the transaction dB ' & !db.name.substring(3) )
              !continueTransaction = !confirmTransaction.boolean()
            endif
          endif
          if (!continueTransaction) then
            !command    = |ALLOCATE |+ !db.name.substring(3) +| AT '|+ !locRf.locId +|'|
            !commands.append(!command)
            !commRefs.append(!db)
          else
            !continueTransaction = true
            -- need to put that database back in the deallocated list
            !this.alloc.clearSelection()
            !this.db.clearSelection()
            !this.alloc.select('rtext', !db.refe.string())
            -- Record the selected text
            !dtext = !this.alloc.selection('dtext')
            !rtext = !this.alloc.selection('rtext')
            !tempArrayDtext = !this.alloc.dtext
            !tempArrayRtext = !this.alloc.rtext
            !valueArray = !this.alloc.val
            !tempArrayDtext.remove(!valueArray[1])
            !tempArrayRtext.remove(!valueArray[1])
            !this.alloc.clearSelection()
            !this.db.clearSelection()
            !this.alloc.dtext = !tempArrayDtext
            !this.alloc.rtext = !tempArrayRtext
            !tempArrayDtext = !this.db.dtext
            !tempArrayRtext = !this.db.rtext
            !tempArrayDtext.append(!dtext[1])
            !tempArrayRtext.append(!rtext[1])
            !this.db.dtext = !tempArrayDtext
            !this.db.rtext = !tempArrayRtext
          endif
        endif
      else
        -- Continue because there are no DEALLOCATE DB in progress for this DB
        -- If continue is true DEALLOCATE ALL is not in progress or we were told to continue
        if (!continueAll) then
          if (!db.type eq 'TRAN') then
            if (!locRf.locId neq !curLoc.locId) then
              !confirmTransaction = !!alert.confirm('Are you sure you wish to allocate the transaction dB ' & !db.name.substring(3) )
              !continueTransaction = !confirmTransaction.boolean()
            endif
          endif
          if (!continueTransaction) then
            !command    = |ALLOCATE |+ !db.name.substring(3) +| AT '|+ !locRf.locId +|'|
            !commands.append(!command)
            !commRefs.append(!db)
          else
            !continueTransaction = true
            -- need to put that database back in the deallocated list
            !this.alloc.clearSelection()
            !this.db.clearSelection()
            !this.alloc.select('rtext', !db.refe.string())
            -- Record the selected text
            !dtext = !this.alloc.selection('dtext')
            !rtext = !this.alloc.selection('rtext')
            !tempArrayDtext = !this.alloc.dtext
            !tempArrayRtext = !this.alloc.rtext
            !valueArray = !this.alloc.val
            !tempArrayDtext.remove(!valueArray[1])
            !tempArrayRtext.remove(!valueArray[1])
            !this.alloc.clearSelection()
            !this.db.clearSelection()
            !this.alloc.dtext = !tempArrayDtext
            !this.alloc.rtext = !tempArrayRtext
            !tempArrayDtext = !this.db.dtext
            !tempArrayRtext = !this.db.rtext
            !tempArrayDtext.append(!dtext[1])
            !tempArrayRtext.append(!rtext[1])
            !this.db.dtext = !tempArrayDtext
            !this.db.rtext = !tempArrayRtext
          endif
        endif
      endif
    enddo
  endif
  -- Execute allocate and de-allocate commands
  do !index indices !commands

    -- Use for Debugging
    --!!alert.confirm(!commands[!index])
    --q var !commands[!index]
    --call !!admCommand(!commands[!index])
    $!commands[$!index]
    --************** There rest of this Method is Error Handling! ********** in a truly evil style!
    handle (1,501)

      -- Failed to contact daemon
      -- Preserve specific error text as handled errors when regenerating lists will overwrite error.text
      !daemonError = !!error.text
      !this.allSet()
      !this.allList()
      !!messageFile.error(141, 723, !daemonError.after(')').trim('L'))

    elsehandle (1,462)

      -- Database still allocated to a descendent
      -- Will only occur if INCLUDE DESCENDANTS in not used
      !updateFlag = true
      !this.allAdd(!commRefs[!index])

      -- Raise error
      !errorMessage = !!messageFile.messageString(141, 550, !commRefs[!index].name.substring(3), !locRf.locId, !!error.text.part(-1))
      if (!suppress) then
        !errors.append(!errorMessage)
      else
        !!alert.error(!errorMessage)
      endif

    elsehandle (1,463)

      -- Location still has descendants when de-allocating all databases
      !updateFlag = true
      !this.allSet()

      -- Raise error
      !errorMessage = !!messageFile.messageString(141, 551)
      if (!suppress) then
        !errors.append(!errorMessage)
      else
        !!alert.error(!errorMessage)
      endif

    elsehandle (1,484)

      -- Database is still primary at current location
      !updateFlag = true
      !this.allAdd(!commRefs[!index])

      -- Raise error
      !errorMessage = !!messageFile.messageString(141, 552, !commRefs[!index].name.substring(3), !locRf.locId)
      if (!suppress) then
        !errors.append(!errorMessage)
      else
        !!alert.error(!errorMessage)
      endif

    elsehandle (1,485)

      -- Location has a primary child
      !updateFlag = true
      !this.allAdd(!commRefs[!index])

      -- Raise error
      !errorMessage = !!messageFile.messageString(141, 553, !commRefs[!index].name.substring(3), !locRf.locId, !!error.text.part(-1))
      if (!suppress) then
        !errors.append(!errorMessage)
      else
        !!alert.error(!errorMessage)
      endif

    elsehandle (1,486)

      --Deallocate ALL - #F is primary at #F - command not allowed
      -- Primary child location in deallocate all
      !updateFlag = true
      !this.allSet()
      -- Raise error
      !errorMessage = !!messageFile.messageString(141, 554, !locRf.locId, !!error.text.part(6), !!error.text.part(11))
      if (!suppress) then
        !errors.append(!errorMessage)
      else
        !!alert.error(!errorMessage)
      endif

    elsehandle (1,498)

      -- Allocate ALL doesn't allocate foreign Dbs! - A Friendly warning
      !updateFlag = true
      !this.allSet()

      -- Raise error
--      !errorMessage = !!messageFile.messageString(141, 554, !locRf.locId, !!error.text.part(4), !!error.text.part(8))
      if (!suppress) then
--        !errors.append(!errorMessage)
        !errors.append(|Warning Only - Allocate ALL does not allocate foreign Databases|)
      else
--        !!alert.error(!errorMessage)
      endif

    elsehandle any

      -- Non-specific error deallocating database
      !updateFlag = true
      if (!commRefs[!index].objectType() eq 'STRING') then
        !this.allSet()
        --Raise error
        !errorMessage = !!messageFile.messageString(141, 555, !commands[!index].part(1), !commRefs[!index], !!error.text)
        if (!suppress) then
          !errors.append(!errorMessage)
        else
          !!alert.error(!errorMessage)
        endif
      else
        if (!commands[!index].part(1) eq 'DEALLOCATE') then
          !this.allAdd(!commRefs[!index])
        else
          !this.allRem(!commRefs[!index])
        endif

        -- In some cases De-allocation Commands are re-submitted,
        -- If Parent DBs de-allocated before happening the de-allocation for child Extract DBs.
        -- Set a max of 3 tries to prevent looping
        if (!commands.find(!commands[!index]).size() lt 3) then
          !commands.append(!commands[!index])
          !commRefs.append(!commRefs[!index])
        else
          !errorMessage = !!messageFile.messageString(141, 555, !commands[!index].part(1), !commRefs[!index].name.substring(3), !!error.text)
          -- Returns if parent DBs are selected for De-allocation and child extract DBs are still exists in allocation list.
          !allocDbs = !this.alloc.rtext
          do !checkExtDbs values !remDb
            do !checkChildExt values !allocDbs
              if (!checkChildExt.dbRef().extowner eq !checkExtDbs) then
                if (!suppress) then
                  !errors.append(!errorMessage)
                 else
                  !!alert.error(!errorMessage)
                endif
              endif
            enddo
          enddo
        endif
      endif

    endhandle
  enddo
  -- Display any errors (if required)
  if (!suppress and !errors.set()) then

    -- Display errors
    show !!glbAllLocErr
    !this.err(!errors)

  endif

  -- Update the form if required
  if (!updateFlag) then
    -- To update list gadget.
    !this.allSet()
    !this.allList()
  endif

  if (!commands.size() gt 0) then
    -- warning message for updates
    !!alert.warning('A request has been made to allocate or de-allocate databases. This request will only be actioned when the remote site has responded to your request, and you have used Getwork to update your project. Until then, the database allocation will not change.')
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method: .add()
--
-- Description: Callback method to the Add button in the Database Allocation
-- By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add()

  -- Initialise variables
  !selection    = !this.db.val

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  endif

  -- Process the selection
  do !index values !selection

    !dbRef        = !this.db.rtext[!index].dbRef()
    handle any
      -- Bad databases
      skip
    endhandle

    -- Add the database to the allocation
    !this.allAdd(!dbRef)

  enddo

  -- Update the list gadgets
  !this.allList()

endmethod
-- End of method definition for .add()

------------------------------------------------------------------------
--
-- Method: .addAll()
--
-- Description: Callback method to the AAll button in the Database Allocation
-- By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addAll()

  -- Initialise variables
  !databases    = !this.db.rtext

  -- Return if no selection
  if (!databases.size() eq 0) then
    return
  endif

  -- Process the selection
  do !db values !databases

    !dbRef        = !db.dbRef()
    handle any
      -- Bad databases
      skip
    endhandle

    -- Add the database to the allocation
    !this.allAdd(!dbRef)

  enddo

  -- Update the list gadgets
  !this.allList()

endmethod
-- End of method definition for .addAll()

------------------------------------------------------------------------
--
-- Method: .allAdd()
--
-- Description: Function to add a DBREF to the allocation of the selected location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of databases
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allAdd(!dbRef is DBREF)

  -- Return if the DBREF is unset
  if (!dbRef.unset()) then
    return
  endif

  -- Add database to allocation
  !this.allocArr.append(!dbRef)
  !this.allocArr.unique()

  -- Remove database from the DeAllocated list
  !index   = !this.deAllArr.findFirst(!dbRef)
  if (!index.set()) then
    !this.deAllArr.remove(!index)
  endif

endmethod
-- End of method definition for .allAdd(DBREF)

------------------------------------------------------------------------
--
-- Method: .allGet()
--
-- Description: Function to return the form members for database allocation of the
-- selected location in the Database Allocation By Database form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       Array of Allocated databases (return)
--    2   RW     ARRAY       Array of De-allocated databases (return)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allGet(!alloc is ARRAY, !deAlloc is ARRAY)

  -- Set the values
  !alloc    = !this.allocArr
  !deAlloc  = !this.deAllArr

endmethod
-- End of method definition for .allGet(ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method: .allList()
--
-- Description: Function to control and display the database allocation of the
-- current selected location in the Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allList()

  -- Initialise variables
  !locRf    = !this.refGet()
  !alloc    = ARRAY()
  !deAlloc  = ARRAY()
  !this.allGet(!alloc, !deAlloc)

  -- Try to determine whether an Allocate all will be done rather than a loop of dbs
  if (!deAlloc.size() eq 0 AND !alloc.size() gt 0) then
    !this.propagatingOnly.active = true
  else
    !this.propagatingOnly.active = false
  endif

  -- Preserve sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal = !this.filter.val
  !this.sortVal   = !this.sort.selection('rtext')

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, 'DB')

  -- Clear the list gadgets
  !this.db.clear()
  !this.alloc.clear()

  -- Sort the databases
  !dispAlloc  = !!adminFilterSort(!alloc,!this.sort,!this.filter)
  !dispDeAll  = !!adminFilterSort(!deAlloc,!this.sort,!this.filter)

  -- Display the lists
  !!adminDbTxtList(!dispDeAll, !this.db, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !locRf)
  !!adminDbTxtList(!dispAlloc, !this.alloc, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !locRf)

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .allList()

------------------------------------------------------------------------
--
-- Method: .allRem
--
-- Description: Function to remove a DBREF from the allocation of the selected
-- location.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of databases
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allRem(!dbRef is DBREF)

  -- Return if the DBREF is unset
  if (!dbRef.unset()) then
    return
  endif

  -- Add database to deallocation list
  !this.deAllArr.append(!dbRef)
  !this.deAllArr.unique()

  -- Remove database from the DeAllocated list
  !index   = !this.allocArr.findFirst(!dbRef)
  if (!index.set()) then
    !this.allocArr.remove(!index)
  endif

endmethod
-- End of method definition for .allRem(DBREF)

------------------------------------------------------------------------
--
-- Method: .allSet()
--
-- Description: Function to set the form member for database allocation for the
-- current selected location.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allSet()

  -- Initialise variables
  !curPos   = !!ce
  !dbRef    = !this.refGet()
  !alloc    = ARRAY()
  !dbArray  = ARRAY()

  -- Get the current allocation
  !!ce      = !dbRef
--  !clause   = |TYPE eq 'DB'|
--  !alloc    = !!collectAllFor('',!clause,!!ce)
  !alloc = !!ce.mem[1].mem

  -- Get project databases
  !!ce      = !!dbrAdminGetWorld('TEAM')
  !dbArray  = !!collectAllFor('DB','',!!ce)

  -- Save the allocation
  !this.allocArr  = !alloc
  !this.deAllArr  = !dbArray.difference(!alloc)

  -- Restore database position
  !!ce      = !curPos

endmethod
-- End of method definition for .allSet()

------------------------------------------------------------------------
--
-- Method: .arrGet()
--
-- Description: Function to return the form member for project locations in the
-- Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project locations
--
------------------------------------------------------------------------

-- Define method
define method .arrGet() is ARRAY

  -- Return the value
  return !this.locArray

endmethod
-- End of method definition for .arrGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .arrList()
--
-- Description: Function to list the project locations in the Database Allocation
-- By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .arrList()

  -- Initialise variables
  !locations  = !this.arrGet()
  !hubRef     = !!dbrGlbHubLocRf()
  !locNames   = ARRAY()

  -- Get Location names
  !nBlock     = object BLOCK(|!locations[!evalIndex].name|)
  !locNames   = !locations.evaluate(!nBlock)

  -- Sort based on name
  !order      = !locNames.sortedIndices()
  !locations.reIndex(!order)

  -- Clear the list gadget
  !this.loc.clear()

  -- Add the list text
  !!adminLocnTxtList(!locations, !this.loc)

  -- Select the hub location
  !curSel     = !this.refGet()
  if (!curSel.set()) then
    -- P-6896 Check for a badref in case the location has just been deleted
    if (badref(!curSel)) then
      !this.loc.select('rtext',!hubRef.string())
    else
    !this.loc.select('rtext',!curSel.string())
    endif
  elseif(!hubRef.lInit)then
    !this.loc.select('rtext',!hubRef.string())
  endif
  !this.refSet(object DBREF())
  !this.refSel()

endmethod
-- End of method definition for .arrList()

------------------------------------------------------------------------
--
-- Method: .arrSet()
--
-- Description: Function to set the form member for Project Locations in the
-- Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .arrSet()

  -- Initialise variables
  !curPos    = !!ce
  !locations = ARRAY()

  -- Collect on-line initialised locations
  !!ce       = !!dbrAdminGetWorld('LOC')
  -- !clause    = |LINIT eq TRUE and ICONN eq 1|
  -- !loc       = !!collectAllFor('LOC',!clause,!!ce)
  -- !locations.appendArray(!loc)
  -- Collect offline locations
  -- !clause    = |ICONN eq 0|
  -- !loc       = !!collectAllFor('LOC',!clause,!!ce)
  -- !locations.appendArray(!loc)
  !allLocs = !!ce.mem[2].mem
  do !i values !allLocs
    !!ce = !i
    if((LINIT eq TRUE and ICONN eq 1) OR (ICONN eq 0))then
      !locations.append(!i)
    endif
  enddo

  if(!locations.size() LT 1)then
    -- There are no locations, exit with err
    -- ##
    return error 1 |There are no initialised location in this project, there must be at least 1 location initialised in order to
allocate|
  endif

  -- Store the values
  !this.locArray = !locations

  -- Restore database position
  !!ce       = !curPos

endmethod
-- End of method definition for .arrSet()

------------------------------------------------------------------------
--
-- Method: .err()
--
-- Description: Function to populate the textpane gadget in the Allocation Errors
-- form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of errors to display
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .err(!errors is ARRAY)

  -- Clear the text pane
  !!glbAllLocErr.errors.clear()

  -- Display the array
  !!glbAllLocErr.errors.val = !errors

endmethod
-- End of method definition for .err(ARRAY)

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Function to initialise the Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.displayFormat.name  = TRUE
  !this.displayFormat.typeDb = TRUE
  !this.displayFormat.dbNo = FALSE
  !this.displayFormat.description = FALSE
  !this.displayFormat.access = FALSE
  !this.displayFormat.claim = FALSE
  !this.displayFormat.filename = FALSE
  !this.keepmdb.val = false

  -- Assign option gadget values
  call !!admDbSortGadg(!!glbAllLoc.sort)

  -- Assign filter gadget values
  !!glbAllLoc.filter.val   = |*|

  -- Restore the sort and filter states
  if (!this.sortVal.set()) then
    !this.filter.val   = !this.filterVal
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Get the project locations
  !this.arrSet()
  handle 1
    -- ##
    !!alert.error(!!error.text)
    return
  endhandle
  !this.arrList()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .refGet()
--
-- Description: Function to return the current selected location form member value
-- in the Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Selected location
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the value
  return !this.locRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
-- Method: .refSet()
--
-- Description: Callback method to selection of a location to work on in the
-- Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSel()

  -- Initialise variables
  !selection  = !this.loc.selection('rtext').dbRef()
  !curLoc     = !this.refGet()
  !hubRef     = !!dbrGlbHubLocRf()

  -- Return if current location
  if (!selection eq !curLoc) then
    return
  endif

  -- Modify gadget states
  if (!selection eq !hubRef) then

    -- Selected hub, allocation cannot be changed
    !this.add.active   = false
    !this.aAll.active  = false
    !this.rem.active   = false
    !this.rAll.active  = false
    !this.copy.active  = false
    !this.apply.active = false

    if (Defined (!!glbCpyAll) and !!glbCpyAll.shown()) then
      !!glbCpyAll.hide()
    endif

  else

    -- Allocation can be changed
    !this.add.active   = true
    !this.aAll.active  = true
    !this.rem.active   = true
    !this.rAll.active  = true
    !this.copy.active  = true
    !this.apply.active = true

  endif

  -- Save the selected value
  !this.refSet(!selection)
  !this.allSet()
  !this.allList()

  -- Update the copy form
  if (Defined (!!glbCpyAll)) then
     call !!refreshDependent(!!glbCpyAll)
  endif

endmethod
-- End of method definition for .refSel()

------------------------------------------------------------------------
--
-- Method: .refSet()
--
-- Description: Function to save the selected location in a form member in the
-- Database Allocation By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Current selected location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Store the value
  !this.locRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
-- Method: .rem()
--
-- Description: Callback method to the Rem button in the Database Allocation
-- By Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .rem()

  -- Initialise variables
  !selection    = !this.alloc.val

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  endif

  -- Process the selection
  do !index values !selection

    !dbRef        = !this.alloc.rtext[!index].dbRef()
    handle any
      -- Bad databases
      skip
    endhandle

    -- Add the database to the allocation
    !this.allRem(!dbRef)

  enddo

  -- Update the list gadgets
  !this.allList()

endmethod
-- End of method definition for .rem()

