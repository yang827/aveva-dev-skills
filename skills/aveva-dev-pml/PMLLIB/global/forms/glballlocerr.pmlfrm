--
-- Description:
-- Form definition to show suppressed messages from the Allocate or Deallocate
-- commands raised by the Allocated Database (By Location) form.
--
------------------------------------------------------------------------

-- Define form
setup form !!glbAllLocErr

  !!glbAllLocErr.formTitle     = 'Allocation Errors'
  !!glbAllLocErr.iconTitle     = 'ALLOC ERR'
  !!glbAllLocErr.callback      = ''
  !!glbAllLocErr.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  textpane .errors at x 0 y 0 |Errors Whilst Allocating/Deallocating Databases| width 50 height 10

  button .dismiss at xmax form-size ymax |Dismiss| CANCEL

exit
-- End of form definition for !!glbAllLocErr
