-- File:            glbauthuserlist.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--  Keyword:         GEN
--   Module:        global
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         November 2006
--
--
-- Description:
-- Form to display all the authenticated user data at a Location.
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed and get info and return
--  getAuthUsers()                   -                   Interrogate the local SYS db that is open to find out the authenticated users
--  getUsers()                       -                   Interrogate the local SYS db that is open to find out the users for the chosen authenticated user
--  glbAuthUserList()                -                   Constructor
--  init()                           -                   Method to initialise the data for the Auth User List form
--

!sessionData = CURRENT SESSION
!priv = !sessionData.user().access

setup form !!glbAuthUserList

  -- Member Definitions
  -- To Store current admin Context
  member .initAdmdLoc is DBREF
  -- A list of the Location Objects
  member .locList is ARRAY

  -- Body of form definition
  option .location |Location Queried | at xmin y0.5   width 9

  list .authUsers 'Authenticated Users' at xmin ymax   width 25 length 14

  path right
  valign bottom

  -- Information
  list .users at |Details| width 43 length 14

  button .dismiss at xmax form-size ymax |Dismiss|  OK


exit
-- End of form definition for !!glbAuthUserList
------------------------------------------------------------------------
--
-- Method:      .glbAuthUserList()
--
-- Description: Method to initialise the data for the User List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
--
------------------------------------------------------------------------

define method .glbAuthUserList()

  !this.formTitle     = |Authenticated User List|
  !this.iconTitle     = |NT USER LIST|
  !this.callback      = |!this.init()|
  !this.formRevision  = '  '

  -- callbacks
  !this.location.callback  = |!this.cbLocs()|
  !this.authUsers.callback = |!this.getUsers()|

endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the User List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
--
------------------------------------------------------------------------

define method .init()

  -- Set member to indicate current loc
   !this.initAdmdLoc  = !!adminApplic.getAdmContext()

  -- initialise Location Gadget
  !this.location.clear()

  -- Get a list of locations which are on-line
  !clause = |LINIT EQ TRUE|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locs
  !this.locList.clear()

  do !i values !resultingLocs
    -- Then we will have the local details
    if (!this.initAdmdLoc EQ !i) then
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
      -- To insure Initial Location is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !this.locList.invert()
    else
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif
  enddo

  !this.location.dText = !textOfLocs

  !heading=ARRAY()
  !heading.append(|Name|)
  !this.authUsers.setHeadings(!heading)
  !heading.clear()
  !heading.append(|Users|)
  !this.users.setHeadings(!heading)

  --Get the Authenticated Users
  !this.getAuthUsers()


endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getAuthUsers()
--
-- Description: Interrogate the local SYS db that is open to
-- return a list of authenticated users
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
------------------------------------------------------------------------

define method .getAuthUsers()

  !authUsers = authusers
  !dispList=ARRAY()
  do !i values !authUsers
    !displist.append(!i.name)
  enddo
  !dispList.sort()
  if (!dispList.size() eq 0) then
    !dispList.append('No authenticated users')
    !this.authUsers.dtext=!dispList
  else
    !this.authUsers.dtext=!dispList
    !this.getUsers()
  endif

endmethod
-- End of method definition for .getAuthUsers()
------------------------------------------------------------------------
--
-- Method:      .getUsers()
--
-- Description: Interrogate the local SYS db that is open to
-- return a list of users for the authenticated users
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
------------------------------------------------------------------------

define method .getUsers()

  !authUser = !this.authUsers.selection()
  !dispList=ARRAY()
  !au=object authUser (!authUser)
  !authUserList=!au.userList()
  !default=!au.defaultUser()
  do !i values !authUserList
    if (!i eq !default) then
      !text=!i.name & | (DEFAULT) |
      !displist.append(!text)
    else
      !displist.append(!i.name)
    endif
  enddo
  !dispList.sort()
  !this.users.dtext=!dispList
  !this.users.select('dtext',!text)


endmethod
-- End of method definition for .getAuthUsers()


------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed and get info and return
-- to initial location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
  ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'

  !this.getAuthUsers()

endmethod
-- End of method definition for .cbLocs()
