--
--
-- Description:
-- Form definition to allow hub user to change the current project hub.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbChHub

-- Define form
setup form !!glbChHub resize

  !!glbChHub.formTitle     = 'Change Project Hub Location'
  !!glbChHub.iconTitle     = 'CHNG HUB'
  !!glbChHub.callback      = 'call !!glbChHubInit()'
  !!glbChHub.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  list .locn at x 0 y 0 anchor all |Project Locations| columns width 40 height 8
  option .sort at xmin ymax+0.2 anchor bottom+left |Sort| call |call !!glbChHubLocLst()| width 12
  text .filter at xmax ymin anchor bottom+right |Filter| call |call !!glbChHubLocLst()| width 14 STRING

  button .ok at xmin.locn ymax+0.5 anchor bottom+left |  OK  | call |call !!glbChHub()| OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

  -- Form member definitions
    -- Array of locations
    member .locArray  is ARRAY
    -- Sort and filter stores
    member .filterVal is STRING
    member .sortVal   is STRING

exit
-- End of form definition for !!glbChHub

-- Assign sort gadget values
call !!admLocSortGadg(!!glbChHub.sort)

-- Assign Filter gadget values
!!glbChHub.filter.val    = |*|
