--
--
-- Description:
-- A form Detailing the update events from  particular location.
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed
--  generateComms()                  -                   To query the open SYS DB and get an array of Users and place it
--  getDetails()                     -                   Display Event Details
--  getEvents()                      -                   Display a list of Comm Events
--  init()                           -                   Method to initialise the data for the DB List form
--
------------------------------------------------------------------------

setup form !!glbCommList resize

  !!glbCommList.formTitle     = 'List Update Events'
  !!glbCommList.iconTitle     = 'UpdateList'
  !!glbCommList.callback     = '!!glbCommList.init()'
  !!glbCommList.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition
  option  .location anchor top+left at x 0 y 0.5 |Location Queried | call |!this.cbLocs()| width 17

  list .events      anchor all at xmin ymax+0.5 call |!this.getDetails()| width 18 length 10

  para .dDesc       anchor top+right at xmax+1 y 1.4 width 37 lines 1

  para .dLocTx      anchor top+right at x 23        ymax text  |Destination Loc         : |
  para .dLoc        anchor top+right at xmax ymin width 15 line 1

  para .dFreqTx     anchor top+right at xmin.dLocTx ymax text  |Frequency               : |
  para .dFreq       anchor top+right at xmax ymin width 12 line 1

  para .dRetryTx    anchor top+right at xmin.dLocTx ymax text  |Max Retries             : |
  para .dRetry      anchor top+right at xmax ymin width 6 line 1

  para .dIntervalTx anchor top+right at xmin.dLocTx ymax text  |Retry Interval          : |
  para .dInterval   anchor top+right at xmax ymin width 16 line 1

  para .dStartTx    anchor top+right at xmin.dLocTx ymax text  |Transfer Script(Start)  : |
  para .dStart      anchor top+right at xmax ymin width 15 line 1

  para .dFinishTx   anchor top+right at xmin.dLocTx ymax text  |Transfer Script(Finish) : |
  para .dFinish     anchor top+right at xmax ymin width 15 line 1

  button .dismiss at xmax form-size ymax.events |Dismiss| anchor bottom+right OK

  -- Member Definitions
  member .initAdmdLoc is DBREF
  member .locList is ARRAY
  member .allEventList is ARRAY

exit

-- End of form definition for !!glbCommList

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the Location List
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Set member to indicate current loc
  -- When curLoc is implemented then LOCAL will refer to the details
  -- Of this Location
  !this.initAdmdLoc  = !!adminApplic.getAdmContext()

  -- initialise Location Gadget
  !this.location.clear()

  -- Get a list of locations which are on-line
  !clause = |LINIT EQ TRUE|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locs
  !this.locList.clear()

  do !i values !resultingLocs
    -- ian_flag
    -- This will have to be changed when Curloc is implemented
    -- The we will have the local details
    if (!this.initAdmdLoc EQ !i) then
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
      -- To insure Initial Location is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !this.locList.invert()
    else
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif
  enddo

  !this.location.dText = !textOfLocs
  -- Generate a list of comms events
  !this.generateComms()
  -- Get The Events
  !this.getEvents()
  -- Get The Details of Selected
  !this.getDetails()

  !this.location.active = !!admControl.isValid('Centralised Admin')

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getEvents()
--
-- Description: Display a list of Comm Events
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getEvents()


  -- Clear the current list of dbs
  !this.events.clear()
  !evList = ARRAY()

  -- Loop through the Event list
  do !i indices !this.allEventList
    if (!!sessionSettings.showAs eq |DESC|) then
      !evList[!i] = !this.allEventList[!i].description
      if (!evList[!i].unset() or !evList[!i].empty()) then
        !evList[!i] = !this.allEventList[!i].name
      else
        -- removes whitespace
        !evList[!i] = !this.allEventList[!i].trim()
      endif
    else
       !evList[!i] = !this.allEventList[!i].name
    endif
  enddo

  -- Sort the list of Events and place them in the list gadget
  !sortOrder = !evList.sortedIndices()
  !evList.reIndex(!sortOrder)
  !this.allEventList.reIndex(!sortOrder)

  !this.events.dText = !evList

endmethod
-- End of method definition for .getEvents()

------------------------------------------------------------------------
--
-- Method:      .getDetails()
--
-- Description: Display Event Details
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getDetails()

  !this.dDesc.val     = ||
  !this.dLoc.val      = ||
  !this.dFreq.val     = ||
  !this.dRetry.val    = ||
  !this.dInterval.val = ||
  !this.dStart.val    = ||
  !this.dFinish.val   = ||

  -- If there are No events!
  if (!this.events.val EQ 0) then
    return
  endif

  -- Get the current selected DB
  !currEv       = !this.allEventList[!this.events.val]

   -- Set the current EV's description text
  !desc = !currEv.description
  if (!desc.unset() or !desc.empty()) then
    !this.dDesc.val = |-- no description --|
  else
    !desc = !desc.trim()
    if (!desc.length() gt 43) then
      !this.dDesc.val = !desc.substring(1,41) + |>>|
    else
      !this.dDesc.val = !desc
    endif
  endif

  -- Set the selected EV's Destination Location
  !destLoc = !currEv
  if (!!sessionSettings.showAs eq |DESC|) then
    !locTx = !destLoc.locRfdesc
    if (!locTx.unset() or !locTx.empty()) then
      !this.dLoc.val = !destLoc.locRfname
    else
      if (!locTx.length() gt 35) then
        !this.dLoc.val = !locTx.substring(1,33) + |>>|
      else
        !this.dLoc.val = !locTx.trim()
      endif
    endif
  else
   !this.dLoc.val = !destLoc.locRfname
  endif

  -- Display the selected DB's properties

  !freq     = !currEv.timeR
  !retry    = !currEv.timeO
  !interval = !currEv.timeI
  !start    = !currEv.execB
  !finish   = !currEv.execA

  !this.dFreq.val     = !freq.trim()
  !this.dRetry.val    = !retry.string()
  !this.dInterval.val = !interval.string()
  !this.dStart.val    = !start.trim()
  !this.dFinish.val   = !finish.trim()

endmethod
-- End of method definition for .getDetails()

------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- IF No locations(this should not happen
  if(!this.location.val EQ 0) then
    return
  endif


  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

   -- Administer new location
   ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
   !this.generateComms()
   ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'

  !this.getEvents()
  !this.getDetails()

endmethod
-- End of method definition for .cbLocs()

------------------------------------------------------------------------
--
-- Method:      .generateComms()
--
-- Description: To query the open SYS DB and get an array of Users and place it
-- form member !this.allUserList in non sys db specific format
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .generateComms()
  !this.allEventList.clear()
  -- This uses a function which returns all Events
  !events = !!collectAllFor(|LCOMD|,||,!!dbrAdminGetWorld(|LCOM|))
   do !i values !events
    !temp = object GLBEVENT()
    !temp.event2GlbEvent(!i)
    !this.allEventList.append(!temp)
  enddo
endmethod
-- End of method definition for .generateComms()
