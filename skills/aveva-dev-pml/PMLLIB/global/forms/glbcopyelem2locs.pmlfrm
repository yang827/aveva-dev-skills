-- File:            glbcopyelem2locs.pmlfrm
--   Type:          Form Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        global
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Wed Feb 17 10:45:16 GMT 1999
--
--
-- Description:
-- A form to copy USER, DBSET, SCOPE or MDB Element to other locations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbCopy()                         -                   Function to a selected list of locations and copy this
--  display(STRING,DBREF)            -                   Function to display form correctly set-up
--  init()                           -                   Function to initialise this form with locations!
--
------------------------------------------------------------------------
setup form !!glbCopyElem2Locs

  !this.formTitle     = ''
  !this.iconTitle     = ''
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  list   .locations at  x 1 y 0.2 MULTIPLE width 40 height 12
  path down
  text   .newPasswd      |New Password         | width 15 noecho string
  text   .confirmPasswd  |Confirm New Password | width 15 noecho string
  button .all    at xmin ymax+0.2   | All | call |!this.locations.select('rtext',!this.locations.rText)|
  button .clear  at xmax+1 ymin   |Clear| call |!this.locations.clearSelection()|
  button .copy at xmin.locations ymax+0.2 |Copy| call |!this.cbCopy()|
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- form members
  member .dbRef is DBREF
  member .type is STRING

exit
-- End of form definition for !!glbCopyElem2Locs

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Function to initialise this form with locations!
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

   -- initialise Location Gadget
  !this.locations.clear()

  --get some useful locations
  !actualLoc = !!dbrGlbCurLocRf()
  !hubRef    = !!dbrGlbHubLocRf()
  !isHub     = !actualLoc EQ !hubRef

  -- Get a list of locations which are initialised
  !matchingLocTexts = ARRAY()
  !matchingLocNames = ARRAY()

  -- Get all Locations
  !allLocations = !!collectAllFor(|loc|,||,!!dbrAdminGetWorld(|LOC|))

  -- Pre-conditions:- this will display only locations administered by here,
  -- not including the currently open System DB. Further if this site is the hub
  -- then the administrator can administer sites which have yet to be transferred

  do !i values !allLocations

    skip if(!i EQ !!adminApplic.getAdmContext())

    if((!i.prmRf eq !actualLoc))then
      -- location is administered here
      !matchingLocTexts.append(!i.locId +  | - | + !i.name.substring(2))
      !matchingLocNames.append(!i.name)
    elseif((!i.lInit EQ FALSE) AND !isHub)then
      -- location not initialised and at hub
      !matchingLocTexts.append(!i.locId +  | - | + !i.name.substring(2))
      !matchingLocNames.append(!i.name)
    endif

  enddo

  if( !matchingLocTexts.empty() ) then
    !matchingLocTexts[1] = 'Cannot copy elements to another location'
    !matchingLocTexts[2] = 'No locations administered here'
    !matchingLocNames[1] = ''
    !matchingLocNames[2] = ''
    !this.locations.active = false
    !this.all.active       = false
    !this.clear.active     = false
    !this.copy.active      = false
  else
    !this.locations.active = true
    !this.all.active       = true
    !this.clear.active     = true
    !this.copy.active      = true
  endif
  !this.locations.dText = !matchingLocTexts
  !this.locations.rText = !matchingLocNames

  !this.newPasswd.val     = ||
  !this.confirmPasswd.val = ||

  if (!this.type eq 'USER') then
    !this.newPasswd.active     = TRUE
    !this.confirmPasswd.active = TRUE
  else
    !this.newPasswd.active     = FALSE
    !this.confirmPasswd.active = FALSE
  endif



endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Function to display form correctly set-up
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Element type
--    2   R      DBREF       DBREF of element of said type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!type is STRING, !dbRef is DBREF)

  if(not badref(!dbRef))then
    !this.formTitle = |Copy | + !type + |(| + !dbRef.name.substring(2) + |)| + | to locations|
    !this.dbRef = !dbRef
  else
    !this.dbRef = object DBREF()
  endif
  !this.type = !type
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  endif
endmethod
-- End of method definition for .display(STRING, DBREF)
------------------------------------------------------------------------
--
-- Method:      .cbCopy()
--
-- Description: Function to a selected list of locations and copy this
-- element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Element type
--    2   R      DBREF       DBREF of element of said type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbCopy()

  -- Get the selection
  !textNameOfLocations = !this.locations.selection(|RTEXT|)
  if(!textNameOfLocations.empty())then
    -- no locations selected, warn user
    !!alert.error('No locations selected - no action required')
    return
  endif
  -- Store the currently open location
  !currentOpenLocId = !!adminApplic.getAdmContext().locId

  -- Create the right type of virtual element
  if(!this.type eq |USER|)then
    -- This object will manage ACR and SCOPE elements too
    !elem = object ADMVIRTUSER()
    if (!this.newPasswd.val eq ||) then
      !!alert.warning('No password entered. The password will need to be set at the location for this user to be available')
    elseif (!this.newPasswd.val neq !this.confirmPasswd.val) then
      !!alert.error('The Passwords you typed do not match.  Type the new password in both text boxes')
      !this.newPasswd.val     = ||
      !this.confirmPasswd.val = ||
      return
    endif

  elseif(!this.type eq |MDB|)then
    !elem = object ADMVIRTMDB()
  elseif(!this.type eq |SCOPE|)then
    !elem = object ADMVIRTSCOPE()
  elseif(!this.type eq |DBSET|)then
    !elem = object ADMVIRTDBSET()
  endif

  -- extract data from existing element
  !elem.goVirtual(!this.dbRef)

  -- iterate through locations and create element
  do !i values !textNameOfLocations
    -- Test site see if it has been initialised
    -- Note:- !i is location's name
    !targetLoc = !i.dbRef()
    !targetLocName = !targetLoc.name

    if(!targetLoc.lInit eq FALSE)then
       call !!admCommand('ADMINISTER SYSTEM AT |$!targetLoc.locId|')
       handle (1,501)
         !!alert.error(!!error.text)
       endhandle
    else
       call !!admCommand('ADMINISTER SYSTEM AT |$!targetLoc.locId|')
       handle (1,501)
          !!alert.error(!!error.text)
       endhandle
    endif
    !elem.goReal()
    -- Can we handle errors here?

    if (!this.type eq 'USER') then
      PASSWORD |$!this.newPasswd.val|
    endif
    !this.newPasswd.val     = ||
    !this.confirmPasswd.val = ||
    -- do lots of error handling here
    handle any
      !text = !!error.text & | An error occurred whilst copying this element to location | + !targetLocName
      !!alert.error(!text)
    endhandle
  enddo

  -- go back to the sysDB previously open
  call !!admCommand('ADMINISTER SYSTEM AT |$!currentOpenLocId|')

endmethod
-- End of method definition for .cbCopy()
