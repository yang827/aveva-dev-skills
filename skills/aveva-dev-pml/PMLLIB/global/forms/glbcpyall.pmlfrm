--
--
-- Description:
-- Form definition to allow a user to copy one project locations database
-- allocation to another.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allList()                        -                   Function to control and display the database allocation of the
--  copyAll()                        -                   copy the selected location allocation into the allocation
--  init()                           -                   initialise the Copy Database Allocation form
--

-- Define form
setup form !!glbCpyAll resize

  !this.formTitle     = 'Copy Database Allocation'
  !this.iconTitle     = 'CPY DB ALLOC'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  list .loc at x 0 y 0 anchor all |Copy Allocation From| columns width 40 height 10

  button .ok at xmin ymax anchor bottom+left |  OK  | call |!this.copyAll()| OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

exit
-- End of form definition for !!glbCpyAll

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the Copy Database Allocation form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !curPos      = !!ce
  !activeLoc   = !!glbAllLoc.refGet()

  -- Collect project locations
  !!ce         = !!dbrAdminGetWorld('LOC')
  !clause      = 'REF neq '+ !activeLoc.string()
  !locations   = !!collectAllFor('LOC',!clause,!!ce)

  -- Sort the locations based on name
  !nBlock      = object BLOCK(|!locations[!evalIndex].name|)
  !locNames    = !locations.evaluate(!nBlock)
  !order       = !locNames.sortedIndices()
  !locations.reindex(!order)

  -- Clear the list gadget
  !this.loc.clear()

  -- Display list texts
  call !!adminLocnTxtList(!locations, !this.loc)

  -- Restore the database position
  !!ce         = !curPos

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .copyAll()
--
-- Description: copy the selected location allocation into the allocation
-- of the active location in the Database Allocation By Location form.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyAll()

  -- Initialise variables
  !curPos      = !!ce
  !sourceLoc   = !this.loc.selection('rtext').dbref()
--  !targetLoc   = !!glbAllLocRefGet()
  !tgtAlloc    = ARRAY()
  !tgtDeAlloc  = ARRAY()
  !!glbAllLoc.allGet(!tgtAlloc, !tgtDeAlloc)

  -- Get the source locations allocation
  !!ce         = !sourceLoc
  !clause      = |TYPE eq 'DB'|
  !srcAlloc    = !!ce.mem[1].mem

  -- Create array of databases to add and remove
  !addDb       = !srcAlloc.difference(!tgtAlloc)
  !remDb       = !tgtAlloc.difference(!srcAlloc)

  -- Return if there is no difference
  if (!addDb.unset() and !remDb.unset()) then
    return
  endif

  !countTransaction = 0
  -- Remove databases (but ignore transaction dbs)
  do !db values !remDb
    if (!db.owner.owner.name eq '/*TRANSACTION') then
      !countTransaction = !countTransaction + 1
      -- ignore it - give message only once
      if (!countTransaction eq 1) then
        !!alert.message(|Transaction dB's are ignored by 'Copy Allocation...'|)
      endif
    else
      !!glbAllLoc.allRem(!db)
    endif
  enddo

  -- Add databases (but ignore transaction dbs)
  do !db values !addDb
    if (!db.owner.owner.name eq '/*TRANSACTION') then
      !countTransaction = !countTransaction + 1
      -- ignore it - give message only once
      if (!countTransaction eq 1) then
        !!alert.message(|Transaction dB's are ignored by 'Copy Allocation...'|)
      endif
    else
      !!glbAllLoc.allAdd(!db)
    endif
  enddo

  -- Update the lists in the parent form
  !this.allList()

endmethod
-- End of method definition for .copyAll()

------------------------------------------------------------------------
--
-- Method: .allList()
--
-- Description: Function to control and display the database allocation of the
-- current selected location in the Database Allocation By Location form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .allList()

  -- Initialise variables
  !locrf    = !!glbAllLoc.refGet()
  !alloc    = ARRAY()
  !deAlloc  = ARRAY()
  !!glbAllLoc.allGet(!alloc, !deAlloc)

  -- Preserve sort and filter values
  if (!!glbAllLoc.filter.val.empty()) then
    !!glbAllLoc.filter.val = |*|
  endif
  !!glbAllLoc.filterVal = !!glbAllLoc.filter.val
  !!glbAllLoc.sortVal   = !!glbAllLoc.sort.selection('rtext')

  -- Display a message
  !!messageFile.prompt(141, 4, !!glbAllLoc.formTitle, 'DB')

  -- Clear the list gadgets
  !!glbAllLoc.db.clear()
  !!glbAllLoc.alloc.clear()

  -- Sort the databases
  !dispAlloc  = !!adminFilterSort(!alloc,!!glbAllLoc.sort,!!glbAllLoc.filter)
  !dispDeAll  = !!adminFilterSort(!deAlloc,!!glbAllLoc.sort,!!glbAllLoc.filter)

  -- Display the lists
  call !!adminDbTxtList(!dispDeAll, !!glbAllLoc.db, !!admdisplayconfig.fmtDbGet(), true, !locrf)
  call !!adminDbTxtList(!dispAlloc, !!glbAllLoc.alloc, !!admdisplayconfig.fmtDbGet(), true, !locrf)

  -- Dismiss the prompt
  call !!prompt(0)

endmethod
-- End of method definition for .allList()
