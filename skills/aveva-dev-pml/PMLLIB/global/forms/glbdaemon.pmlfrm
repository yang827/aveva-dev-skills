-- Description:
-- Form definition to allow the specification of communications
-- diagnostic parameters.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbDaemon

-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!glbDaemon at xr 0.35 yr 0.1

  !!glbDaemon.formTitle     = 'Local Daemon Settings'
  !!glbDaemon.iconTitle     = 'COMM SETUP'
  !!glbDaemon.callback      = 'call !!glbDaemonInit()'
  !!glbDaemon.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  text .file at x 0  y 0.5 |Diagnostic Logfile | width 25 STRING

  text .level at xmin ymax+0.2 |Diagnostic Level   | width 10 INTEGER min 0 max 255
  button .lvlBtn at xmax ymin |Define...| form !!glbDiagLvl

  option .logging at xmin.file ymax+0.2 |Diagnostic Logging | width 10

  button .ok at xmin.file ymax+0.5 |  OK  | call |call !!glbDaemon()| OK
  button .reset at xmax+1 ymin |Reset| RESET
  button .cancel at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbDaemon

-- Assign Logging gadget values
!dText.append(|Enabled|)
!dText.append(|Disabled|)
!!glbDaemon.logging.dText  = !dText
!dText.clear()
!rText.append(|true|)
!rText.append(|false|)
!!glbDaemon.logging.rText  = !rText
!rText.clear()
