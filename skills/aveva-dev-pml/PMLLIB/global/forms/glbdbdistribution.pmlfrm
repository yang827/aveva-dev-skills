-- Created:         Wed Jan 6 07:57:10 GMT 2010
--
--
-- Description:
-- Project database distribution as primary or otherwise.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allList()                        -                   Control and display the database list
--  apply()                          -                   Apply changes to primary databases
--  dbList()                         -                   List the project databases
--  dbSelect()                       -                   Callback on selecting in db list
--  glbDbDistribution()              -                   Constructor
--  init()                           -                   Initialise form
--  locList()                        -                   List the project locations
--
------------------------------------------------------------------------

-- Define form
setup form !!glbDbDistribution resize

  !!glbDbDistribution.formTitle     = 'Database Distribution'
  !!glbDbDistribution.iconTitle     = 'Distribution'
  !!glbDbDistribution.callback      = '!!glbDbDistribution.init()'
  !!glbDbDistribution.formRevision  = ' $Revision: 1.00 $ '

  -- Db distribution
  frame .dbFrame anchor all at x 0 ymax |Database Distribution|
    list   .dbs      anchor all multiple columns width 100 height 15
    option .sort     anchor bottom+left  at xmin.dbs ymax.dbs+0.2 |Sort By| width 12
    text   .filter   anchor bottom+left  at xmax+1 ymin |Filter | width 15 STRING
    button .clearDbs anchor bottom+right at xmax.dbs-size ymin |Clear Selection| width 12
    path left
    button .refresh  anchor bottom+right |Refresh|
  exit

  -- Location for dbs to be made primary
  frame .locFrame anchor bottom+left+right at xmin.dbFrame ymax+0.5 |Make selected databases primary at:|
    list .loc anchor all columns width 100 height 6
   exit

  -- Buttons
  button .apply   anchor bottom+left  at xmin.dbFrame ymax+0.5 |Change Primary Location| width 20 apply
  button .dismiss anchor bottom+right at xmax form-size ymin   |Dismiss| cancel

  -- Array of project locations
  member .locArray       is ARRAY
  -- Array of project databases
  member .dbArray        is ARRAY
  -- Sort and filter values
  member .sortVal        is STRING
  member .filterVal      is STRING
  -- Member to store db format
  member .displayFormat  is DBLISTATTR
  -- Member to store list data
  member .dbList         is ADMTEXTLIST

exit
-- End of form definition for !!glbDbDistribution
------------------------------------------------------------------------
--
-- Method: glbDbDistribution()
--
-- Description: Constructor
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .glbDbDistribution()

  -- Callbacks
  !this.dbs.callback       = |!this.dbSelect()|
  !this.clearDbs.callback  = |!this.dbs.clearSelection()|
  !this.refresh.callback   = |!this.allList()|
  !this.sort.callback      = |!this.allList()|
  !this.filter.callback    = |!this.allList()|
  !this.apply.callback     = |!this.apply()|

  -- Display format
  !this.displayFormat.name        = TRUE
  !this.displayFormat.typeDb      = TRUE
  !this.displayFormat.dbNo        = FALSE
  !this.displayFormat.description = FALSE
  !this.displayFormat.access      = FALSE
  !this.displayFormat.claim       = FALSE
  !this.displayFormat.filename    = FALSE

endmethod
-- End of method definition for .glbDbDistribution()

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Initialise form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Assign option gadget values
  call !!admDbSortGadg(!this.sort)

  -- Assign filter gadget values
  !this.filter.val = |*|

  -- Restore the sort and filter states
  if (!this.sortVal.set()) then
    !this.filter.val = !this.filterVal
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Get the project locations
  !this.locList()

  -- Get the project databases and distribution
  !this.dbList()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .allList()
--
-- Description: Control and display the database list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allList()

  -- Preserve sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal = !this.filter.val
  !this.sortVal   = !this.sort.selection('rtext')

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, 'DB')

  -- Get the project databases and distribution
  !this.dbList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .allList()

------------------------------------------------------------------------
--
-- Method: .dbList()
--
-- Description: List the project databases
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbList()

  -- Initialise
  !this.dbs.clear()

  -- Collect project databases
  !!ce = !!dbrAdminGetWorld('TEAM')
  !this.dbArray = !!collectAllFor('DB','',!!ce)

  -- Sort the project databases
  !displayList = !!adminFilterSort(!this.dbArray, !this.sort, !this.filter)
  if( !displayList.empty()) then
    !!alert.error('No databases matching filter ' + !this.filterVal)
  endif

  -- Display the database list
  !this.dbList = object ADMTEXTLIST()
  !this.dbList.addDbs(!displayList, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !this.dbs, object DBREF(), FALSE)

  -- Get the list data just calculated
  !heading = !this.dbList.heading
  !data    = !this.dbList.cd

  -- Add locations to database list
  do !location values !this.locArray
    !heading.append(!location.locid)
    !newColumn = ARRAY()
    do !db values !displayList
      -- Is it foreign?
      !foreign = (!db.foreign eq 'FOREIGN')
      handle any
        !foreign = FALSE
      endhandle
      -- Is it primary at this location?
      !primary = (!location eq !db.members[1].locrf)
      handle any
        !primary = FALSE
      endhandle
      -- Is it allocated to this location?
      !allocated = !location.dball.findFirst(!db).set()
      handle any
        !allocated = FALSE
      endhandle
      -- Is it in transit from this location?
      !inTransit = (!location eq !db.members[1].prvrf)
      handle any
        !inTransit = FALSE
      endhandle
      -- Set status of this database for this location
      if (!primary) then
        if (!foreign) then
          !newColumn.append('*')
        else
          !newColumn.append('+')
        endif
      elseif (!allocated) then
        if (!foreign) then
          !newColumn.append('*')
        elseif (!inTransit) then
          !newColumn.append('>')
        else
          !newColumn.append('-')
        endif
      else
        !newColumn.append(' ')
      endif
    enddo
    !data.append(!newColumn)
  enddo
  !this.dbs.setHeadings(!heading)
  !this.dbs.setColumns(!data)
  !this.dbs.rtext = !this.dbList.stringRefs

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
-- Method: .locList()
--
-- Description: List the project locations
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locList()

  -- Initialise
  !hubRef = !!dbrGlbHubLocRf()
  !this.loc.clear()

  -- Get the locations
  !!ce = !!dbrAdminGetWorld('LOC')
  !locArray = !!ce.mem[2].mem

  -- Sort based on name
  !locNames = !locArray.evaluate(object BLOCK(|!locArray[!evalIndex].name|))
  !order = !locNames.sortedIndices()
  !locArray.reIndex(!order)

  -- Reorder so hub first (which must be current location as this form is available only at the hub)
  !this.locArray = ARRAY()
  !this.locArray.append(!hubRef)
  do !loc values !locArray
    skip if (!loc eq !hubRef)
    !this.locArray.append(!loc)
  enddo

  -- Add the list text
  !!adminLocnTxtList(!this.locArray, !this.loc)

  -- Select the hub location
  !this.loc.select('rtext',!hubRef.string())

endmethod
-- End of method definition for .locList()

------------------------------------------------------------------------
--
-- Method: .dbSelect()
--
-- Description: Callback on selecting in db list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbSelect()

  -- Make last selection current
  !!ce = !this.dbs.selection('rtext').last().dbRef()
  handle any
  endhandle

endmethod
-- End of method definition for .dbSelect()

------------------------------------------------------------------------
--
-- Method: .apply()
--
-- Description: Apply changes to primary databases
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise
  !updateFlag = FALSE
  !location   = !this.loc.selection('rtext').dbRef()

  -- Make primary selected databases that are not primary at the selected location
  do !dbName values !this.dbs.selection('rtext')

    -- Get db ref and ignore bad refs
    !db = !dbName.dbRef()
    handle any
      skip
    endhandle

    -- Skip if already primary
    !primary = (!location eq !db.members[1].locrf)
    handle any
      !primary = FALSE
    endhandle
    skip if (!primary)

    -- Is it allocated to this location?
    !allocated = !location.dball.findFirst(!db).set()
    handle any
      !allocated = FALSE
    endhandle
    if (!allocated) then
      -- Change primary
      !command  = |CHANGE |+ !db.name.substring(3) +| PRIMARY AT |+ !location.name
    else
      -- Allocate primary
      !command  = |ALLOCATE |+ !db.name.substring(3) +| PRIMARY AT |+ !location.name
    endif
    call !!admCommand(!command)
    handle (1,501) (1,504) (1,505)
      -- Failed to change primary due to communications error
      !!alert.error(!!messageFile.messageString(141, 560, !db.name.substring(3), !!error.text, !!ce.curloc.name))
      break
    elsehandle any
      -- Failed to change primary
      !!alert.error(!!messageFile.messageString(141, 545, !db.name.substring(3), !!error.text))
    elsehandle none
      !updateFlag = TRUE
    endhandle

  enddo

  -- Refresh form
  if (!updateFlag) then
    !this.allList()
  endif

endmethod
-- End of method definition for .apply()
