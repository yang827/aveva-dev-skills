--   Replaces:
--
-- Author:          I.Clark
-- Created:         Thu Oct 29 9:30:48 GMT 1998
--
--
-- Description:
-- Form to display information on all databases in the project at a Location
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed
--  dbListSelect()                   -                   Method to initialise the data for the DB List form
--  extractHierarchy(DBREF,REAL)     -
--  getDbs(LOCATION)                 -                   While interrogate the local SYS db that is open to
--  init()                           -                   Method to initialise the data for the DB List form
--  sortByHierarchy()                -                   Sort DB's by hierarchy
--
------------------------------------------------------------------------

setup form !!glbDbList resize

  !this.formTitle     = 'Database List'
  !this.iconTitle     = 'DB List'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition
  rgroup .sortOrder 'Sort Databases' at x 0.5 y 0.2 anchor top+left callback '!this.init()' frame HORIZONTAL
    add tag 'Alphabetic  ' SELECT 'ALPHABETIC'
    add tag 'By Hierarchy' SELECT 'HIERARCHY'
  exit

  -- Body of form definition
  option  .location  |Location Queried | at xmax+1 ycen anchor top+left call |!this.cbLocs()| width 9

  list .dbs at x 0.5 ymax.sortOrder+0.5 anchor top+left+bottom call |!this.dbListSelect()| width 24 length 17

  list .report at xmax+0.5 ymin anchor all width 40 length 17

  button .dismiss at xmax form-size ymax.report+0.2 |Dismiss| anchor bottom+right OK

  -- Member Definitions
  member .dbList      is DBLISTOBJ
  member .dbNames     is ARRAY
  member .dbShow      is ARRAY

  member .initAdmdLoc is DBREF
  member .locList     is ARRAY

exit

-- End of form definition for !!glbDbList
-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the DB List form
-- depending on the display mode.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Set member to indicate current loc
  !this.initAdmdLoc  = !!adminApplic.getAdmContext()
  handle any
    -- some problem with finding locations
    !!alert.warning('Could not find a Global Location')
    !this.getDbs(object LOCATION())
    return
  endhandle

  !this.locList.clear()

  !project         = CURRENT PROJECT
  !allLocList      = !project.locations()
  !currentLocation = object LOCATION( !this.initAdmdLoc.name )
  -- make sure that the current location is first in the list
  !textOfLocs[1]   = !currentLocation.locId
  !this.locList[1] = !currentLocation

  -- initialise Location Gadget
  !this.location.clear()

  do !location values !allLocList

    -- current location has already been placed at the top of the list
    skip if( !location eq !currentLocation )
    -- skip uninitialised locations
    skip if( !location.refno.dbref().linit.not() )
    -- append location to the list
    -- make sure that the option gadget and the location list are in the same order
    !textOfLocs.append( !location.locId )
    !this.locList.append(!location)

  enddo

  !this.location.dText = !textOfLocs

  -- Get The DBs
  !this.getDbs(!currentLocation)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getDbs(LOCATION)
--
-- Description: While interrogate the local SYS db that is open to
-- return a list of DBS
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getDbs(!location is LOCATION)

  !this.dbList = object DBLISTOBJ()
  if( !location.set() ) then
    !this.dbList.setLocation(!location)
  else
    !this.dbList.update()
  endif

  if (!!sessionSettings.showAs eq |DESC|) then
    -- show DB descriptions
    !dbDtext = !this.dbList.getDbDesc()
    !dbRtext = !this.dbList.getDbNames()
  else
    -- show DB names
    !dbDtext = !this.dbList.getDbNames()
    !dbRtext = !dbDtext
  endif

  if( defined(!dbDtext[1]) ) then
    if( !this.sortOrder.selection().upcase() eq 'HIERARCHY' ) then
      -- sort by hierarchy
      !this.sortByHierarchy()
    else
      -- Sort the list of DBs
      !sortOrder = !dbDtext.sortedIndices()
      !dbDispList = ARRAY()
      !dbReplList = ARRAY()

      do !i values !sortOrder
        !dbDispList.append(!dbDtext[!i])
        !dbReplList.append(!dbRtext[!i])
      enddo

      !this.dbs.dText = !dbDispList
      !this.dbs.rText = !dbReplList
    endif

    -- get details for first DB
    !this.report.dText = !this.dbList.getDbDetails(!this.dbs.rText[1])
  else
    !this.report.clear()
  endif

endmethod
-- End of method definition for .getDbs(LOCATION)

------------------------------------------------------------------------
--
-- Method:      .dbListSelect()
--
-- Description: Method to initialise the data for the DB List form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbListSelect()

  !this.report.dText = !this.dbList.getDbDetails(!this.dbs.rText[!this.dbs.pickedField])

endmethod
-- End of method definition for .dbListSelect()

------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
--  !this.generateMdbs()
  !this.getDbs(!currLocation)
  handle any
  endhandle
  ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'

endmethod
-- End of method definition for .cbLocs()

------------------------------------------------------------------------
--
-- Method:      .sortByHierarchy()
--
-- Description: Sort DB's by hierarchy
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sortByHierarchy()

  !this.dbNames.clear()
  !this.dbShow.clear()

  !dbRefs = !this.dbList.getDbRefs()
  VAR !dbMasters COLLECT ALL WITH ( badref(EXTOWN) ) FROM !dbRefs

  do !masterDB values !dbMasters

    -- add master to output list
    !masterDbRef = !masterDB.dbref()
    if (!!sessionSettings.showAs eq |DESC|) then
      if( !masterDbRef.description.trim().empty() ) then
        -- use name if no description
        !this.dbShow.append(!masterDbRef.name.substring(3))
      else
        -- show DB descriptions
        !this.dbShow.append(!masterDbRef.description)
      endif
    else
      !this.dbShow.append(!masterDbRef.name.substring(3))
    endif
    !this.dbNames.append(!masterDbRef.name.substring(3))
    -- list extract hierarchy for this master
    !this.extractHierarchy(!masterDbRef, 1)

  enddo

  -- copy DB info to the form
  !this.dbs.dText = !this.dbShow
  !this.dbs.rText = !this.dbNames

endmethod
-- End of method definition for .sortByHierarchy()

------------------------------------------------------------------------
--
-- Method:      .extractHierarchy()
--
-- Description: Sort DB's by hierarchy
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extractHierarchy( !dbElement is DBREF, !level is REAL )

  -- set up indent string
  !indent = ' '
  do !i to !level
    !indent = '..' + !indent
  enddo

  -- loop through all child extracts for given DB
  do !childExtract values !dbElement.extcls
    if (!!sessionSettings.showAs eq |DESC|) then
      if( !childExtract.description.trim().empty() ) then
        -- use name if no description
        !this.dbShow.append(!indent + !childExtract.name.substring(3))
      else
        -- show DB descriptions
        !this.dbShow.append(!indent + !childExtract.description)
      endif
    else
      !this.dbShow.append(!indent + !childExtract.name.substring(3))
    endif
    !this.dbNames.append(!childExtract.name.substring(3))
    -- list next level down
    !this.extractHierarchy(!childExtract, !level + 1)
  enddo

endmethod
-- End of method definition for .extractHierarchy( DBREF, REAL )
