--
--  Description:     -- Form definition to allow the user to specify the primary location-- of the database being created or modified.--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to return the selected primary location of a database
--  infoInit(FORM)                   -                   a function to initialise this form + and to set the callingForm member
--  init()                           -                   method to return the form member containing the array of
--  locGet()                         ARRAY
--  locList()                        -                   method to control the displayed list of LOC elements in the
--  locSet()                         -                   method to collect and store the project locations applicable
--  refGet()                         DBREF               method to return the current save primary location DBREF in the
--  refSel()                         -                   Callback to list gadget for selection of the databases primary
--  refSet(DBREF)                    -                   method to store the primary location of a database for use in the
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            glbdbpri.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
--
-- Description:
-- Form definition to allow the user to specify the primary location
-- of the database being created or modified.
--
------------------------------------------------------------------------
--

-- Define form
setup form !!glbDbPri resize

  !this.formTitle     = 'Primary Location'
  !this.iconTitle     = 'PRI LOC'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  list .locN at x 0 y 0 anchor all |Project Locations| call |!this.refSel()| columns width 44 height 8
  option .sort at xmin ymax+0.2 anchor bottom+left |Sort | call |!this.locList()| width 12
  text .filter at xmax ymin anchor bottom+right |  Filter | call |!this.locList()| width 14 STRING

  button .ok at xmin.locN ymax+0.5 anchor bottom+left |  OK  | call |!this.cbApply()| OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

  -- Member definitions
    -- Location Dbref
    member .dbRef     is DBREF
    -- Array of project locations
    member .locArray  is ARRAY
    -- Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING
    -- The form that called this form!
    member .callingForm is FORM

-- Assign sort gadget values
!!admLocSortGadg(!this.sort)

-- Assign Filter gadget values
!this.filter.val    = |*|

exit
-- End of form definition for !!glbDbPri

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to return the selected primary location of a database
-- to the database definition form. Selection of the database is
-- made in the DB Primary Location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !primary  = !this.refGet()

  -- Validate the element using callback from
  -- the DB Definition form
  !this.callingForm.loc(!primary.name)

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the DB Primary Location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  if(!this.callingForm.set())then
    -- Initialise variables
    !primary               = !this.callingForm.locGet()

    -- Save the primary location
    !this.refSet(!primary)

    -- Restore the sort and filter gadgets
    if (!this.filterVal.set()) then
      !this.filter.val  = !this.filterVal
    endif
    if (!this.sortVal.set()) then
      !this.sort.select('rtext',!this.sortVal)
    endif

    -- Update the list of project locations
    !this.locSet()
    !this.locList()
  else
    return
  endif

endmethod
-- End of method definition for .init()


------------------------------------------------------------------------
--
--method: .locGet()
--
-- Description: method to return the form member containing the array of
-- locations that a database can be made primary at.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       ARRAY of project location DBREFs
--
------------------------------------------------------------------------

-- Define method
define method .locGet() is ARRAY

  -- Return the value
  return !this.locArray

endmethod
-- End of method definition for .locGet() ARRAY

------------------------------------------------------------------------
--
--Method: .locList()
--
-- Description: method to control the displayed list of LOC elements in the
-- DB Primary Location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locList()

  -- Initialise variables
  !locations  = !this.locGet()
  !primary    = !this.refGet()

  -- Save the sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val =|*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list
  !this.locN.clear()

  -- Sort the location list
  !displayList          = !!adminFilterSort(!locations, !this.sort, !this.filter)

  -- Check that the primary location is in the array
  !pos                  = !displayList.findFirst(!primary)
  if (!pos.unset()) then
    !displayList.insert(1,!primary)
  endif

  -- Display the list of locations
  !!adminLocNTxtList(!displayList, !this.locN)

  -- Select the current selected primary location
  !this.locN.select('rtext',!primary.string())
  handle any
    -- This should never happen
  endhandle

endmethod
-- End of method definition for .locList()

------------------------------------------------------------------------
--
--Method: .locSet()
--
-- Description: method to collect and store the project locations applicable
-- to the database currently in the DB Definition form. The LOC elements
-- are store in a form member of DB Primary location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locSet()

  -- Initialise variables
  !dbFormMode   = !this.callingForm.modeGet().upcase()
  !dbFormDbref  = !this.callingForm.refGet()
  !locArray     = ARRAY()
  !locations    = ARRAY()

  -- Get location depending on mode of DB Definition form
  !hubRef       = !!dbrGlbHubLocRf()
  if (!dbFormMode eq 'CREATE') then

    -- All initialised online locations are valid
    !!ce          = !!dbrAdminGetWorld('LOC')
    !curLoc = curLoc
    if (!curLoc eq !hubRef) then
        !clause       = 'linit eq true and iconn eq 1'
    else
        -- Initialised locations administered by Current location
        !clause       = 'linit eq true and iconn eq 1 and (prmLoc eq $!curLoc or ref eq $!curLoc)'
    endif
    !locations    = !!collectAllFor('LOC',!clause,!!ce)


  elseif (!dbFormMode eq 'MODIFY') then

    -- Get the connection state
    !!ce          = !dbFormDbref
    DBLOC 1
    !connection   = !!ce.locRf.iconn.boolean()
    handle any
      !!alert.error('Database primary location is transient. Recover database primary location before reassigning it.')
      !this.locArray  = !locations
      return
    endhandle
    !primary      = !!ce.locRf

    -- On-line locations, only get allocated locations
    if (!connection) then

      -- The hub gets all locations, satellites do not
      -- get offline locations.
      !hubRef       = !!dbrGlbHubLocRf()
      if (!primary eq !hubRef) then
        !clause       = 'linit eq true'
      else
        !clause       = 'linit eq true and iconn eq 1'
      endif

      -- Collect project locations
      !!ce          = !!dbrAdminGetWorld('LOC')
      !locArray     = !!collectAllFor('LOC',!clause,!!ce)
      do !loc values !locArray
        !alloc        = !loc.mem[1].mem
        !index        = !alloc.findFirst(!dbFormDbref)
        if (!index.set()) then
          !locations.append(!loc)
        endif
      enddo
    else

      -- Offline locations only get the hub
      !locations.append(!!dbrGlbHubLocRf())

    endif

  endif

  -- Store the array value
  !this.locArray  = !locations

endmethod
-- End of method definition for .locSet()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: method to return the current save primary location DBREF in the
-- DB Primary Location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of primary location
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the value
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF


------------------------------------------------------------------------
--
--Method: .refSel
--
-- Description: Callback to list gadget for selection of the databases primary
-- location.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSel()

  -- Get the selected DBREF
  !primary    = !this.locN.selection('rtext').dbRef()
  handle any

    -- Bad location reference
    !!messageFile.error(141, 517,  !this.locN.selection('rtext'))
    handle (06, 517)
      -- Dummy handle
    endhandle

    -- Rebuild list gadget
    !this.locSet()
    !this.locList()

    return

  endhandle

  -- Dbref is okay so set the value
  !this.refSet(!primary)

endmethod
-- End of method definition for .refSel()

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: method to store the primary location of a database for use in the
-- DB Primary Location form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of primary location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Save the value
  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
--Method: infoInit()
--
-- Description: a function to initialise this form + and to set the callingForm member
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R/RW   GADGET      This is the form this was called from!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .infoInit(!form is FORM)

  if (!form.modeGet().upcase() eq 'MODIFY') then

    -- Get the connection state
    !!ce          = !form.refGet()
    DBLOC 1
    !connection   = !!ce.locRf.iconn.boolean()
    handle any
      !!alert.error('Database primary location is transient. Recover database primary location before reassigning it.')

      if(!this.shown())then
        !this.hide()
      endif
      return
    endhandle

  endif

  if(!this.shown().not())then
    !this.show()
  endif

  !this.callingForm = !form

  !this.init()

endmethod
-- End of method definition for .infoInit(FORM)
