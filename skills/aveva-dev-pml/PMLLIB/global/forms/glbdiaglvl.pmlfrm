--
--
-- Description:
-- Form definition to allow the user to specify the diagnostic
-- level for communication events
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbDiagLvl

-- Define form
setup form !!glbDiagLvl

  !!glbDiagLvl.formTitle     = 'Diagnostic Level'
  !!glbDiagLvl.iconTitle     = 'DIAG LVL'
  !!glbDiagLvl.callback      = 'call !!glbDiagLvlInit()'
  !!glbDiagLvl.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  toggle .bit1   at x 0 y 0   |Messages Received (Summary)|
  toggle .bit2   at xmin ymax |Messages Received (Detailed)|
  toggle .bit4   at xmin ymax+0.5 |Messages Sent (Summary)|
  toggle .bit8   at xmin ymax |Messages Sent (Detailed)|
  toggle .bit16  at xmin ymax+0.5 |Dabacon Thread (Summary)|
  toggle .bit32  at xmin ymax |Dabacon Thread (Detailed)|
  toggle .bit64  at xmin ymax+0.5 |Propagation Thread (Summary)|
  toggle .bit128 at xmin ymax |Propagation Thread (Detailed)|


  button .ok at xmin ymax+0.5 |  OK  | call |call !!glbDiagLvl()| OK
  button .reset at xmax+1 ymin |Reset| RESET
  button .cancel at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbDiagLvl
