--
-- File:            glbeventtimings.pmlfrm
--   Type:          Form Definition
--   Group:         Global Event Timings
--     Keyword:     GLOBAL
--   Module:        all
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jan 18 10:00:00 "GMT 2002
--
--
-- Description:
-- Specific Form to set a locations event timings to other locations
-- This task can only be performed when administering the location.
-- It is not compulsory to create event timing, if there are none then global defaults are used
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Get the recorded values
--  getCurrent()                     -                   Get the current values
--  getDefaults()                    -                   Get the default values
--  getLocations()                   -                   Get the connected locations
--  glbEventTimings()                -                   Constructor
--  init()                           -                   Initialise Form
--  validateDays(GADGET,STRING)      -                   Validate input to days gadgets
--  validateHours(GADGET,STRING)     -                   Validate input to hours gadgets
--  validateMinutes(GADGET,STRING)   -                   Validate input to minutes gadgets
--  validateRetries(GADGET,STRING)   -                   Validate input to retries gadgets
--  validateSeconds(GADGET,STRING)   -                   Validate input to seconds gadgets
--
setup form !!glbEventTimings

  !this.formTitle     = 'Transaction Command Timings'
  !this.iconTitle     = 'Command Timings'
  !this.callback      = '!this.init()'
  !this.formRevision  = '$Revision: 1.6 $ '

  -- Body of form definition
  path down

  -- Event timings to all locations (Element LCTIML attribute LEVENL)
  text      .eventLoopTimeMinutes     'Command Loop (All Locations) ' at x0.5 ymax call '' tagwidth 24 width 2 is REAL
  paragraph .eventLoopTimeMinutesText    at xmax ymin  text 'Minutes'  width 8
  text      .eventLoopTimeSeconds     '' at xmax ymin call '' width 2 is REAL
  paragraph .eventLoopTimeSecondsText    at xmax ymin  text 'Seconds'  width 8

  frame .timingFrame at x0 ymax 'Timings to Locations'
    -- (Element LCTIMD attribute LEVENL)
    option    .locations     'Location' at x1 ymax call '' tagwidth 8 width 37

    -- Event timings per location
    --(Element LCTIMD attribute LENDTI)
    text      .eventLoopTimeoutDays        'Timeout  ' at x1 ymax+0.2 call '' tagwidth 8 width 2 is REAL
    paragraph .eventLoopTimeoutDaysText       at xmax ymin  text 'Days'     width 7
    text      .eventLoopTimeoutHours       '' at xmax ymin call '' width 2 is REAL
    paragraph .eventLoopTimeoutHoursText      at xmax ymin  text 'Hours'    width 7
    text      .eventLoopTimeoutMinutes     '' at xmax ymin call '' width 2 is REAL
    paragraph .eventLoopTimeoutMinutesText    at xmax ymin  text 'Minutes'  width 7
    text      .eventLoopTimeoutSeconds     '' at xmax ymin call '' width 2 is REAL
    paragraph .eventLoopTimeoutSecondsText    at xmax ymin  text 'Seconds'  width 7

    --(Element LCTIMD attribute LMAXTR)
    text      .maximumRetries        'Retries' at x1 ymax+0.2 call '' tagwidth 8 width 5 is REAL

    --(Element LCTIMD attribute LTIMEI)
    text      .intervalTimeMinutes   'Interval ' at x1 ymax+0.2 call '' tagwidth 8 width 2 is REAL
    paragraph .intervalTimeMinutesText    at xmax ymin  text 'Minutes'  width 7
    text      .intervalTimeSeconds     '' at xmax ymin call '' width 2 is REAL
    paragraph .intervalTimeSecondsText    at xmax ymin  text 'Seconds'  width 7

    --(Element LCTIMD attribute LWAITD)
    text      .resendTimeHours       'Resend   ' at x1 ymax+0.2 call '' tagwidth 8 width 2 is REAL
    paragraph .resendTimeHoursText      at xmax ymin  text 'Hours'  width 7
    text      .resendTimeMinutes     '' at xmax ymin call '' width 2 is REAL
    paragraph .resendTimeMinutesText    at xmax ymin  text 'Minutes'  width 7
    text      .resendTimeSeconds     '' at xmax ymin call '' width 2 is REAL
    paragraph .resendTimeSecondsText    at xmax ymin  text 'Seconds'  width 7
  exit

  -- Apply / Dismiss
  button    .apply         'Apply'    at x1 ymax+0.5 call '!this.apply()' width 8 apply
  button    .defaults      'Defaults' at xmax+2 ymin call '!this.getDefaults()' width 8
  button    .reset         'Current Settings'    at xmax+3 ymin call '!this.getCurrent()' width 14
  button    .dismiss       'Dismiss'  at x42 ymin call '' width 8 cancel

-- End of form definition for !!glbEventTimings
exit

------------------------------------------------------------------------
--
-- Method:      glbEventTimings
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .glbEventTimings()

  -- Tool tips
  !this.eventLoopTimeMinutes.setToolTip('Time in Command Loop, common to all locations (Range 1 to 300 seconds)')
  !this.locations.setToolTip('These are locations to which this location has a connection to.')
  !this.eventLoopTimeoutDays.setToolTip('Timeout period. This is length of time a command is given to send')
  !this.maximumRetries.setToolTip('Maximum number of retries allowed to send a command')
  !this.intervalTimeMinutes.setToolTip('Interval time between retries')
  !this.resendTimeHours.setToolTip('Time between resending, sent commands that have failed')
  !this.apply.setToolTip('Set the Command Timings for the displayed location')
  !this.defaults.setToolTip('Display the default settings')
  !this.reset.setToolTip('Display the current settings for the displayed location')
  !this.dismiss.setToolTip('Close the form')

  -- Validation Calls
  !this.eventLoopTimeMinutes.validateCall = '!this.validateMinutes('
  !this.eventLoopTimeSeconds.validateCall = '!this.validateSeconds('

  !this.eventLoopTimeoutDays.validateCall = '!this.validateDays('
  !this.eventLoopTimeoutHours.validateCall = '!this.validateHours('
  !this.eventLoopTimeoutMinutes.validateCall = '!this.validateMinutes('
  !this.eventLoopTimeoutSeconds.validateCall = '!this.validateSeconds('

  !this.maximumRetries.validateCall = '!this.validateRetries('

  !this.intervalTimeMinutes.validateCall = '!this.validateMinutes('
  !this.intervalTimeSeconds.validateCall = '!this.validateSeconds('

  !this.resendTimeHours.validateCall   = '!this.validateHours('
  !this.resendTimeMinutes.validateCall = '!this.validateMinutes('
  !this.resendTimeSeconds.validateCall = '!this.validateSeconds('

endmethod
-- End of method definition for .glbEventTimings()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
------------------------------------------------------------------------

define method .init()

  -- Ensure the form is active
  !this.setActive(true)

  -- Populate the Location gadget
  !this.getLocations()

  -- It is possible that there are no locations in the list
  if (!this.locations.rtext.size() eq 0) then
    -- Set up the default Settings
    !this.getDefaults()
  else
    -- Set up the current Settings
    !this.getCurrent()
  endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      getDefaults
--
-- Description: Get the default values
--
------------------------------------------------------------------------

define method .getDefaults()

  !this.eventLoopTimeMinutes.val = 0
  !this.eventLoopTimeSeconds.val = 1

  !this.eventLoopTimeoutDays.val = 2
  !this.eventLoopTimeoutHours.val = 0
  !this.eventLoopTimeoutMinutes.val = 0
  !this.eventLoopTimeoutSeconds.val = 0

  !this.maximumRetries.val = 6000

  !this.intervalTimeMinutes.val = 0
  !this.intervalTimeSeconds.val = 30

  !this.resendTimeHours.val   = 0
  !this.resendTimeMinutes.val = 15
  !this.resendTimeSeconds.val = 0

endmethod
-- End of method definition for .getDefaults()
------------------------------------------------------------------------
--
-- Method:      getCurrent
--
-- Description: Get the current values
--
------------------------------------------------------------------------

define method .getCurrent()

  !location = !this.locations.selection('rtext').dbref()

  var !c collect all LCTIMD with (LOCRF eq $!location) for /*LC
  if (!c.size() gt 1) then
    -- There cannot be more than 1
    !!alert.error('There should be only one LCTIMD, for location ' & !location & ' but there are ' & !c.size().string())
    return
  elseif (!c.size() eq 1) then
    -- That is ok, so remember this element
    !timingElement = !c[1].dbref()
  else
    -- Set up the defaults
    !this.getDefaults()
    return
  endif

  -- The timing attributes are all stored in seconds so we need to convert these
  !eventLoopTimeMinute     = !timingElement.owner.levenl / 60
  !eventLoopTimeMinutes    = !eventLoopTimeMinute.int()
  !eventLoopTimeSeconds    = (!eventLoopTimeMinute * 60) - (!eventLoopTimeMinutes * 60)

  !eventLoopTimeoutDay     = !timingElement.lendti / (60 * 60 * 24)
  !eventLoopTimeoutDays    = !eventLoopTimeoutDay.int()
  !eventLoopTimeoutHour    = (!eventLoopTimeoutDay * 24) - (!eventLoopTimeoutDays * 24)
  !eventLoopTimeoutHours   = !eventLoopTimeoutHour.int()
  !eventLoopTimeoutMinute  = (!eventLoopTimeoutHour * 60) - (!eventLoopTimeoutHours * 60)
  !eventLoopTimeoutMinutes = !eventLoopTimeoutMinute.int()
  !eventLoopTimeoutSeconds = (!eventLoopTimeoutMinute * 60) - (!eventLoopTimeoutMinutes * 60 )

  !intervalTimeMinute      = !timingElement.ltimei / 60
  !intervalTimeMinutes     = !intervalTimeMinute.int()
  !intervalTimeSeconds     = (!intervalTimeMinute * 60) - (!intervalTimeMinutes * 60)

  !resendTimeHour          = !timingElement.lwaitd / (60 * 60)
  !resendTimeHours         = !resendTimeHour.int()
  !resendTimeMinute        = (!resendTimeHour * 60) - (!resendTimeHours * 60)
  !resendTimeMinutes       = !resendTimeMinute.int()
  !resendTimeSeconds       = (!resendTimeMinute * 60) - (!resendTimeMinutes * 60 )

  !this.eventLoopTimeMinutes.val    = !eventLoopTimeMinutes
  !this.eventLoopTimeSeconds.val    = !eventLoopTimeSeconds

  !this.eventLoopTimeoutDays.val    = !eventLoopTimeoutDays
  !this.eventLoopTimeoutHours.val   = !eventLoopTimeoutHours
  !this.eventLoopTimeoutMinutes.val = !eventLoopTimeoutMinutes
  !this.eventLoopTimeoutSeconds.val = !eventLoopTimeoutSeconds.int()

  !this.maximumRetries.val          = !timingElement.lmaxtr

  !this.intervalTimeMinutes.val     = !intervalTimeMinutes
  !this.intervalTimeSeconds.val     = !intervalTimeSeconds

  !this.resendTimeHours.val         = !resendTimeHours
  !this.resendTimeMinutes.val       = !resendTimeMinutes
  !this.resendTimeSeconds.val       = !resendTimeSeconds

endmethod
-- End of method definition for .getCurrent()
------------------------------------------------------------------------
--
-- Method:      getLocations
--
-- Description: Get the connected locations
--
------------------------------------------------------------------------

define method .getLocations()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get the parent. Only do this if we are not at the Hub
  if (!!adminApplic.currentAdmLoc.string() neq !!adminApplic.hubRef.string()) then
    -- This location as a dbref
    !here       = !!adminApplic.currentAdmLoc
    !parentObj  = !here.locrf
    if( !parentObj.unset() ) then
      -- parent not established on transient location
      !!alert.warning('Current location has no initialised project locations to communicate with.')
      !parentName = STRING()
      !parentRef  = STRING()
    else
      !parentName = !parentObj.namn
      !parentRef  = !parentObj.string()
    endif
  else
    !parentName = STRING()
    !parentRef  = STRING()
  endif

  -- Get the immediate children (not grandchildren)
  !locations = ARRAY()
  !parents   = ARRAY()
  !levels    = ARRAY()
  !!dbrLocDataSet(!!adminApplic.currentAdmLoc, 1, !locations, !parents, !levels)
  -- loop thro the parents array and for those that have a parent of this location the record the corresponding number from the locations array
  do !i indices !parents
    if (!parents[!i].set() and !parents[!i].string() eq !!adminApplic.currentAdmLoc.string()) then
      !dtext.append(!locations[!i].namn & ' (Child)')
      !rtext.append(!locations[!i].string())
    endif
  enddo
  -- If the dtext size is still 0 then this location has no children - that is OK

  -- If the parentRef is unset then this location has no parent (Hub)
  if (!parentRef.set()) then
    !dtext.insert(1, !parentName & ' (Parent)')
    !rtext.insert(1, !parentRef)
  endif

  -- If the dtext size is still 0 then this location has no children or parents - so inactivate the form and give a warning.
  if (!dtext.size() eq 0) then
    !this.setActive(false)
    !!alert.warning('This location has no children or parents')
  endif

  -- Set the gadgets
  !this.locations.dtext = !dtext
  !this.locations.rtext = !rtext

endmethod
-- End of method definition for .getLocations()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Get the recorded values
--
------------------------------------------------------------------------

define method .apply()

  --initialise variables
  !timingElement   = object DBREF()
  !locationElement = object DBREF()
  !error = false

  /*LC
  var !c collect all LCTIML for /*LC
  if (!c.size() eq 0) then
    -- A LCTIML should have been automatically created when the project was made global
    !!alert.error('A LCTIML should have been automatically created when the project was made global')
    return
  elseif (!c.size() gt 1) then
    -- There cannot be more than 1
    !!alert.error('There should be only one LCTIML, automatically created when the project was made global')
    return
  else
    -- That is ok, so remember this element
    !timingElement = !c[1].dbref()
  endif

  -- OK navigate to the LCTIML
  !!ce = !timingElement

  -- Test to see if there is already a LCTIMD for this location. If so disallow creating another.
  !location = !this.locations.selection('dtext')
  !locationRef = !this.locations.selection('rtext').dbref()

  var !c collect all LCTIMD with (LOCRF eq $!locationRef) for ce
  if (!c.size() gt 1) then
    -- There cannot be more than 1 Catch this straight away, and delete the extra ones
    do !i indices !c
      if (!i eq 1) then
        skip
      else
        !!ce = !c[!i].dbref()
        DELETE LCTIMD
        handle ANY
          !error = true
        endhandle
      endif
    enddo
    if (!error) then
      !!alert.warning('There is more than one event timing for ' & !location & ' This has not been resolved.')
    else
      !!alert.warning('There was more than one event timing for ' & !location & ' This has resolved.')
    endif
    -- We must be modifying the remaining existing one ( record it )
    !locationElement = !c[1].dbref()

  elseif (!c.size() eq 0) then
    -- Create a new LCTIMD element here and record it
    NEW LCTIMD
    !locationElement = !!ce

  else
    -- We must be modifying an existing one ( record it )
    !locationElement = !c[1].dbref()

  endif

  -- Set the attributes for all locations (Get the gadget settings in the correct format)
  !eventLoopTime    = ((!this.eventLoopTimeMinutes.val * 60) + !this.eventLoopTimeSeconds.val )
  !!ce = !timingElement
  -- Validate the values are not 0
  if (!eventLoopTime gt 0) then
    LEVENL $!eventLoopTime
  else
    !!alert.error('The Event Loop cannot be zero. It has been ignored and unchanged')
  endif

  -- Set the attributes for the location (Get the gadget settings in the correct format)
  !description      = 'Transaction Timing to ' & !location

  !location         = !this.locations.selection('rtext')

  !eventLoopTimeout = ((!this.eventLoopTimeoutDays.val * 60 * 60 * 24) + (!this.eventLoopTimeoutHours.val * 60 * 60) + $
                      (!this.eventLoopTimeoutMinutes.val * 60) + !this.eventLoopTimeoutSeconds.val )

  !maximumRetries   = !this.maximumRetries.val

  !intervalTime     = ((!this.intervalTimeMinutes.val * 60) + !this.intervalTimeSeconds.val )

  !resendTime       = ((!this.resendTimeHours.val * 60 * 60) + (!this.resendTimeMinutes.val * 60) + !this.resendTimeSeconds.val )

  -- Set the attributes for the location
  !!ce = !locationElement
  DESCRI '$!description'
  LOCRF  $!locationRef

  -- Validate the values are not 0
  if (!eventLoopTimeout gt 0) then
    LENDTI $!eventLoopTimeout
  else
    !!alert.error('The Timeout cannot be zero. It has been ignored and unchanged')
  endif
  LMAXTR $!maximumRetries

  -- Validate the values are not 0
  if (!intervalTime gt 0) then
    LTIMEI $!intervalTime
  else
    !!alert.error('The Interval cannot be zero. It has been ignored and unchanged')
  endif

  -- Validate the values are not 0
  if (!resendTime gt 0) then
    LWAITD $!resendTime
  else
    !!alert.error('The Resend cannot be zero. It has been ignored and unchanged')
  endif

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      validateSeconds
--
-- Description:
--   Validate input to seconds gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateSeconds(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  elseif (!gadget.val.between(0, 60).not()) then
    return error 1 'Invalid input.'
  endif

  if (!gadget eq !this.eventLoopTimeSeconds) then
    if (!gadget.val.between(1, 60) and !this.eventLoopTimeMinutes.val gt 4) then
      return error 1 'Limit for the event loop is 5 minutes.'
    endif
  endif

endmethod
-- End of method definition for .validateSeconds()
------------------------------------------------------------------------
--
-- Method:      validateMinutes
--
-- Description:
--   Validate input to minutes gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateMinutes(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  elseif (!gadget.val.between(0, 60).not()) then
    return error 1 'Invalid input.'
  endif

  if (!gadget eq !this.eventLoopTimeMinutes) then
    if (!gadget.val.between(0, 5).not()) then
      return error 1 'Limit for the event loop is 5 minutes'
    endif
    if (!gadget.val.eq(5) and !this.eventLoopTimeSeconds.val neq 0) then
      return error 1 'Limit for the event loop is 5 minutes. Adjust the seconds'
    endif
  endif


endmethod
-- End of method definition for .validateMinutes()
------------------------------------------------------------------------
--
-- Method:      validateHours
--
-- Description:
--   Validate input to hours gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateHours(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  elseif (!gadget.val.between(0, 24).not()) then
    return error 1 'Invalid input.'
  endif

endmethod
-- End of method definition for .validateHours()
------------------------------------------------------------------------
--
-- Method:      validateDays
--
-- Description:
--   Validate input to days gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDays(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  elseif (!gadget.val.between(0, 30).not()) then
    !!alert.warning('Warning - Input is greater than 30 days')
    return
  endif

endmethod
-- End of method definition for .validateDays()
------------------------------------------------------------------------
--
-- Method:      validateRetries
--
-- Description:
--   Validate input to retries gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateRetries(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  elseif (!gadget.val.between(1, 6000).not()) then
    return error 1 'Invalid input. (default is 6000)'
  endif

endmethod
-- End of method definition for .validateRetries()
