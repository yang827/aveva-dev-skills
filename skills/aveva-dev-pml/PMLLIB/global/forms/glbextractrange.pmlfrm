-- File:            glbextractrange.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Nov 10 14:13:19 GMT 1997
--
--
-- Description:
-- Form definition to create/modify location elements.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Method to create and modify Location elements.
--  glbExtractRange()                -                   initialise form
--  init()                           -                   initialise form
--  setExtractNo(STRING)             -                   method to set the from and to extract number range values.
--

-- Define form
setup form !!glbExtractRange

  !this.formTitle     = 'Global Extract Range'
  !this.iconTitle     = 'GER'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  frame .extractNos  |Global Extract Number Range|
    text .from at xmin+2 ymax |From | width 5 INTEGER
    text .to   at xmax+4 ymin |To |   width 5 INTEGER
  exit

  button .apply   at x 0 ymax+0.5        |Apply|   APPLY
  button .reset   at xmax+1 ymin         |Reset|   RESET
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Member Definitions

exit

-- End of form definition for !!glbExtractRange
------------------------------------------------------------------------
--
-- Method:      .glbExtractRange()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbExtractRange()

  --!this.from.callback        = |!this.checkExtNo(!this.from)|
  --!this.to.callback          = |!this.checkExtNo(!this.to)|
  !this.apply.callback       = |!this.cbApply()|
  !this.from.val = '0'
  !this.to.val   = '0'

endmethod
-- End of method definition for .glbExtractRange()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- extract numbers (AK)
  !this.setExtractNo('FROM')
  !this.setExtractNo('TO')

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .setExtractNo(!which is STRING)
--
-- Description: method to set the from and to extract number range values.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Which attribute to set

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setExtractNo(!which is STRING)

  !locationSet = !!dbrGlbHubLocRf().owner
  if(!which.eq('FROM')) then
    !this.from.val = !locationSet.extLo.string()
  else
    !this.to.val   = !locationSet.extHi.string()
  endif

endmethod
-- End of method definition for .setExtractNo(STRING)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify Location elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  -- extract numbers
  if(!!glbIsGlobal().not()) then
    !!alert.error('You can only set extract number ranges in a global project')
    return
  endif
  !currentLocation = !!dbrGlbCurLocRf()
  if(!currentLocation neq !!dbrGlbHubLocRf()) then
    !!alert.error('You can only set global extract number ranges at the hub')
    return
  endif

  !from            = !this.from.val.real()
  !to              = !this.to.val.real()

  if( !from lt 1 or !to lt 1 or !from gt !to ) then
    !!alert.error('Invalid extract number range')
    !this.setExtractNo('FROM')
    !this.setExtractNo('TO')
    return
  endif

  !prev = !!ce
  -- If this is the hub location and it is uninitialised
  if(!currentLocation.lInit.not() )then
    -- ##
    !answer  = !!alert.question(|The hub is currently uninitialised, do you wish to initialise it?|)
    if (!answer eq 'YES') then
      !!ce = !currentLocation
      call !!admCommand(|call !!glbInitialise()|)
    elseif (!answer eq 'NO') then
      !!ce = !currentLocation
    else
      !!ce = !prev
      return
    endif
  endif

  !locationSet   = !!dbrGlbHubLocRf().owner
  !!ce = !locationSet
   -- extract numbers
  call !!admCommand(|EXTLO | & !from )
  handle any
    !!alert.error(!!error.text)
    !this.setExtractNo('FROM')
    !this.setExtractNo('TO')
  endhandle

  call !!admCommand(|EXTHI | & !to )
  handle any
  !!alert.error(!!error.text)
  !this.setExtractNo('FROM')
  !this.setExtractNo('TO')
  endhandle
  !!ce = !prev

  -- P-43418 Clear the Location extract range
  if( defined( !!glbLoc ) ) then
    if (defined(!!glbLoc.extractRange[0] ) ) then
      -- old-style array index, delete explicitly
      !!glbLoc.extractRange[0].delete()
    endif
    !!glbLoc.extractRange.clear()
  endif

endmethod
-- End of method definition for .cbApply()
