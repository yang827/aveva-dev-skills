--
-- Description:
-- Form definition for specifying the frequency of updates for a
-- communications event.
--
------------------------------------------------------------------------

-- Kill existing form definition
-- kill !!glbFreq

-- Define form
setup form !!glbFreq

  !!glbFreq.formTitle     = 'Update Event Frequency'
  !!glbFreq.iconTitle     = 'UPDATE FREQ'
  !!glbFreq.callback      = 'call !!glbFreqInit()'
  !!glbFreq.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  para .titleTx at x 0 y 0 text |Frequency Parameters|

  text .min      at x 2 ymax+0.2 |Minutes          | call |call !!glbFreqChk(_min,0,59,'0')| width 10 NAME
  button .minBtn at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreqMin

  text .hours    at x 2 ymax+0.2 |Hours            | call |call !!glbFreqChk(_hours,0,23,'*')| width 10 NAME
  button .hoursBtn at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreqHours

  text .dates    at x 2 ymax+0.2 |Dates            | call |call !!glbFreqChk(_dates,1,31,'*')| width 10 NAME
  button .datesBtn at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreqDates

  text .months   at x 2 ymax+0.2 |Months           | call |call !!glbFreqChk(_months,1,12,'*')| width 10 NAME
  button .monthsBtn at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreqMon

  text .days     at x 2 ymax+0.2 |Days of the week | call |call !!glbFreqChk(_days,0,6,'*')| width 10 NAME
  button .daysBtn at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreqDays

  button .apply  at xmin.titleTx ymax+0.5 |Apply| call |call !!glbFreq()|
  button .dismiss at xmax form-size ymin |Dismiss| cancel


exit
-- End of form definition for !!glbFreq

-- set icons
!!glbFreq.minBtn.addPixmap(!!pml.getPathName('popup16.png'))
!!glbFreq.hoursBtn.addPixmap(!!pml.getPathName('popup16.png'))
!!glbFreq.datesBtn.addPixmap(!!pml.getPathName('popup16.png'))
!!glbFreq.monthsBtn.addPixmap(!!pml.getPathName('popup16.png'))
!!glbFreq.daysBtn.addPixmap(!!pml.getPathName('popup16.png'))
