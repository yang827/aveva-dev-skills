--
--
-- Description:
-- Form definition to allow the specification of the update
-- frequency dates field.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbFreqDates

-- Define form
setup form !!glbFreqDates

  !!glbFreqDates.formTitle     = 'Frequency (Dates)'
  !!glbFreqDates.iconTitle     = 'FREQ DATE'
  !!glbFreqDates.callback      = 'call !!glbFreqDatesInit()'
  !!glbFreqDates.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  toggle .all at x 0 y 0 |Every Day| call |call !!glbFreqDatesAll()|

  path down halign left

  toggle .d01 at xmin ymax+0.5 |01|
  toggle .d02 |02|
  toggle .d03 |03|
  toggle .d04 |04|
  toggle .d05 |05|
  toggle .d06 |06|
  toggle .d07 |07|
  toggle .d08 |08|
  toggle .d09 |09|
  toggle .d10 |10|

  toggle .d11 at xmax.D01+4 ymin.D01 |11|
  toggle .d12 |12|
  toggle .d13 |13|
  toggle .d14 |14|
  toggle .d15 |15|
  toggle .d16 |16|
  toggle .d17 |17|
  toggle .d18 |18|
  toggle .d19 |19|
  toggle .d20 |20|

  toggle .d21 at xmax.D11+4 ymin.D01 |21|
  toggle .d22 |22|
  toggle .d23 |23|
  toggle .d24 |24|
  toggle .d25 |25|
  toggle .d26 |26|
  toggle .d27 |27|
  toggle .d28 |28|
  toggle .d29 |29|
  toggle .d30 |30|
  toggle .d31 |31|

  button .ok at x 0 ymax+0.5 |  OK  | call |call !!glbFreqDates()| OK
  button .can at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbFreqDates
