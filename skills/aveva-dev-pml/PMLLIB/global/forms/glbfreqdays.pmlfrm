--
--
-- Description:
-- Form definition to allow the specification of the update
-- frequency days of the week field.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbFreqDays

-- Define form
setup form !!glbFreqDays

  !!glbFreqDays.formTitle     = 'Frequency (Days)'
  !!glbFreqDays.iconTitle     = 'FREQ DAY'
  !!glbFreqDays.callback      = 'call !!glbFreqDaysInit()'
  !!glbFreqDays.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  toggle .all at x 0 y 0 |Daily| call |call !!glbFreqDaysAll()|

  path down halign left

  toggle .d01 at xmin ymax+0.5 |Monday   |
  toggle .d02 |Tuesday  |
  toggle .d03 |Wednesday|

  toggle .d04 at xmax.D01+2 ymin.D01 |Thursday |
  toggle .d05 |Friday   |
  toggle .d06 |Saturday |

  toggle .d00 at xmin.D03+8 |Sunday|

  button .ok at x 0 ymax+0.5 |  OK  | call |call !!glbFreqDays()| OK
  button .can at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbFreqDays
