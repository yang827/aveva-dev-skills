--
--
-- Description:
-- Form definition to allow the specification of the Hour
-- at which an update will take place
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbFreqHours

-- Define form
setup form !!glbFreqHours

  !!glbFreqHours.formTitle     = 'Frequency (Hours)'
  !!glbFreqHours.iconTitle     = 'FREQ HOUR'
  !!glbFreqHours.callback      = 'call !!glbFreqHoursInit()'
  !!glbFreqHours.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  toggle .all at x 0 y 0 |Every Hour| call |!!glbFreqHoursAll()|

  path down halign left

  toggle .h00 at xmin ymax+0.2 |00|
  toggle .h01 |01|
  toggle .h02 |02|
  toggle .h03 |03|
  toggle .h04 |04|
  toggle .h05 |05|
  toggle .h06 |06|
  toggle .h07 |07|
  toggle .h08 at xmax.h00+5 ymin.h00 |08|
  toggle .h09 |09|
  toggle .h10 |10|
  toggle .h11 |11|
  toggle .h12 |12|
  toggle .h13 |13|
  toggle .h14 |14|
  toggle .h15 |15|
  toggle .h16 at xmax.h08+5 ymin.h00 |16|
  toggle .h17 |17|
  toggle .h18 |18|
  toggle .h19 |19|
  toggle .h20 |20|
  toggle .h21 |21|
  toggle .h22 |22|
  toggle .h23 |23|

  button .ok at x 0 ymax+0.5 |  OK  | call |call !!glbFreqHours()| OK
  button .can at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbFreqHours
