--
-- Description:
-- Form definition to allow the specification of the update
-- frequency minutes field.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbFreqMin

-- Define form
setup form !!glbFreqMin

  !!glbFreqMin.formTitle     = 'Frequency (Minutes)'
  !!glbFreqMin.iconTitle     = 'FREQ MIN'
  !!glbFreqMin.callback      = 'call !!glbFreqMinInit()'
  !!glbFreqMin.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  path down halign left

  toggle .m00 at x 0  y 0 |00|
  toggle .m01 |01|
  toggle .m02 |02|
  toggle .m03 |03|
  toggle .m04 |04|
  toggle .m05 |05|
  toggle .m06 |06|
  toggle .m07 |07|
  toggle .m08 |08|
  toggle .m09 |09|
  toggle .m10 |10|
  toggle .m11 |11|
  toggle .m12 |12|
  toggle .m13 |13|
  toggle .m14 |14|

  toggle .m15 at xmax.m00+4 ymin.m00 |15|
  toggle .m16 |16|
  toggle .m17 |17|
  toggle .m18 |18|
  toggle .m19 |19|
  toggle .m20 |20|
  toggle .m21 |21|
  toggle .m22 |22|
  toggle .m23 |23|
  toggle .m24 |24|
  toggle .m25 |25|
  toggle .m26 |26|
  toggle .m27 |27|
  toggle .m28 |28|
  toggle .m29 |29|

  toggle .m30 at xmax.m15+4 ymin.m00 |30|
  toggle .m31 |31|
  toggle .m32 |32|
  toggle .m33 |33|
  toggle .m34 |34|
  toggle .m35 |35|
  toggle .m36 |36|
  toggle .m37 |37|
  toggle .m38 |38|
  toggle .m39 |39|
  toggle .m40 |40|
  toggle .m41 |41|
  toggle .m42 |42|
  toggle .m43 |43|
  toggle .m44 |44|

  toggle .m45 at xmax.m30+4 ymin.m00 |45|
  toggle .m46 |46|
  toggle .m47 |47|
  toggle .m48 |48|
  toggle .m49 |49|
  toggle .m50 |50|
  toggle .m51 |51|
  toggle .m52 |52|
  toggle .m53 |53|
  toggle .m54 |54|
  toggle .m55 |55|
  toggle .m56 |56|
  toggle .m57 |57|
  toggle .m58 |58|
  toggle .m59 |59|

  button .ok at x 0 ymax+0.5 |  OK  | call |call !!glbFreqMin()| OK
  button .can at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbFreqMin
