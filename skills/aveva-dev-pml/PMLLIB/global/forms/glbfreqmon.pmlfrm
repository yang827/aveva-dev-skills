--
--
-- Description:
-- Form definition to allow the specification of the update
-- frequency months field.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbFreqMon

-- Define form
setup form !!glbFreqMon

  !!glbFreqMon.formTitle     = 'Frequency (Months)'
  !!glbFreqMon.iconTitle     = 'FREQ MONTH'
  !!glbFreqMon.callback      = 'call !!glbFreqMonInit()'
  !!glbFreqMon.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  toggle .all at x 0 y 0 |Each Month| call |call !!glbFreqMonAll()|

  path down halign left

  toggle .m01 at xmin ymax+0.5 |January  |
  toggle .m02 |February |
  toggle .m03 |March    |
  toggle .m04 |April    |
  toggle .m05 |May      |
  toggle .m06 |June     |

  toggle .m07 at xmax.m01+2 ymin.m01 |July     |
  toggle .m08 |August   |
  toggle .m09 |September|
  toggle .m10 |October  |
  toggle .m11 |November |
  toggle .m12 |December |

  button .ok at x 0 ymax+0.5 |  OK  | call |call !!glbFreqMon()| OK
  button .can at xmax form-size ymin |Cancel| CANCEL


exit
-- End of form definition for !!glbFreqMon
