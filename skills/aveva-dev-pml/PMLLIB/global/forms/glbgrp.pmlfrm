--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Wed Jun 4 10:31:34 BST 1997
--
--
-- Description:
-- Form definition to create/modify location groups.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  display(STRING)                  -                   Display group location form
--  glbGrp()                         -                   Constructor
--  init()                           -                   Initialisation
--  mode()                           -                   Callback for mode
--  name()                           -                   Callback for name
--  setToModify()                    BOOLEAN             Return true if set to Modify
--  update(DBREF)                    -                   Update form for current group
--

-- Define form
setup form !!glbGrp at xr 0.35 yr 0.1

  !!glbGrp.formTitle     = 'Location Group Definition'
  !!glbGrp.iconTitle     = 'GROUP'
  !!glbGrp.callback      = '!!glbGrp.init()'
  !!glbGrp.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  text   .name at x 3 y 0.2 |Name       | width 20 scroll 32 NAME
  option .mode at xmax+2 ymin width 10

  text .desc at xmin.name ymax+0.2 |Description| width 32 scroll 120 STRING

  button .apply at x 0  ymax+0.5 |Apply| APPLY
  button .reset at xmax+1 ymin |Reset| RESET
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
  -- Group DBREF
  member .dbRef is DBREF

exit
-- End of form definition for !!glbGrp

--------------------------------------------------------------------------
-- Method:      .glbGrp()
--
-- Description: Constructor
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .glbGrp()

  -- Assign mode gadget values
  !dText = ARRAY()
  !rText = ARRAY()
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText = !rText
  !rText.clear()

  -- Callbacks
  !this.name.callback    = |!this.name()|
  !this.mode.callback    = |!this.mode()|
  !this.apply.callback   = |!this.apply()|

endmethod

--------------------------------------------------------------------------
-- Method:      .init()
--
-- Description: Initialisation
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !mode    = !this.mode.selection('rtext').upcase()
  !dbRef   = !this.dbRef

  -- Activate mode if there are existing groups
  !this.mode.active = !!adminElem.grpGet().set()

  -- Check the current mode
  if (!mode eq 'CREATE') then

    -- Set the form title
    !this.formTitle  = 'Create Group'

    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.desc.val   = |unset|

  elseif (!mode eq 'MODIFY') then

    -- Set the form title
    !this.formTitle  = 'Modify Group: ' + !dbRef.name.substring(2)

    -- Set the form gadgets
    !this.name.val   = !dbRef.name.substring(2)

    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif

  endif

endmethod

--------------------------------------------------------------------------
-- Method:      .name()
--
-- Description: Callback for name
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .name()

   -- Initialise variables
  !mode           = !this.mode.selection('rtext').upcase()
  !name           = !this.name.val
  !curDbRef       = !this.dbRef

  -- Check for unset name
  if (!this.name.val.trim() eq ||) then
    !this.name.val = |unset|
    !!messageFile.error(141, 501, !mode.lowcase())
  endif

  -- Check to see if name converts to a dbref
  if (!name.substring(1, 1) neq |/|) then
    !name  = |/| + !name
  endif
  !dbRef  = !name.dbRef()
  handle any
    !dbRef = object DBREF()
  endhandle
  if (!dbRef.unset()) then
    -- Element name not used
    !this.desc.setFocus()
    return
  endif

  -- Check to see if dbref matches current location
  if (!dbRef eq !curDbRef) then
    return
  endif

  -- Element name already used (Bad)

  -- Reset value based on mode
  if (!mode eq 'CREATE') then
    !this.name.val = |unset|
  elseif (!mode eq 'MODIFY') then
    !this.name.val = !curDbRef.name.substring(2)
  endif

  -- Raise error
  !!messageFile.error(141, 502, !dbRef.name)

endmethod

--------------------------------------------------------------------------
-- Method:      .mode()
--
-- Description: Callback for mode
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mode()

  -- Read the mode value
  !mode = !this.mode.selection('rtext').upcase()

  -- Call the display method to reset the form
  !this.display(!mode)

endmethod

--------------------------------------------------------------------------
-- Method:      .setToModify()
--
-- Description: Return true if set to Modify
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if set to MODIFY
--
------------------------------------------------------------------------
define method .setToModify() is BOOLEAN

  -- Return true if set to Modify
  return (!this.mode.selection('rtext').upcase() eq |MODIFY|)

endmethod

--------------------------------------------------------------------------
-- Method:      .apply()
--
-- Description: Apply form
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !dbRef      = !this.dbRef
  !mode       = !this.mode.selection('rtext').upcase()

  -- Check that the group name is not unset
  if (!this.name.val eq 'unset') then

    -- Reset name is modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val  = !dbRef.name.substring(2)
    endif

    -- Raise error
    !!messageFile.error(141, 501, !mode.lowcase())

  endif

  -- Action attributes depending on mode
  if (!mode eq 'CREATE') then

    -- Navigate to GROUPLIST element
    !!ce      = !!dbrAdminGetWorld('LOC')
    GRPLI 1

    -- Create the new GRP
    !newName  = |/| + !this.name.val
    NEW GRP $!newName
    handle (41,12)

      -- Delete the Group
      DELETE GRP

      -- Team already exists
      !!messageFile.error(141, 502, !this.name.val)
      !this.name.val      = |unset|

    endhandle

    -- Set the team description
    if (!this.desc.val neq 'unset') then
      !!ce.description = !this.desc.val
    endif

    -- Grab the new DBREF
    !this.dbRef = !!ce
    !!adminElem.grpSet(!!ce)

  elseif (!mode eq 'MODIFY') then

    -- Check for element being already claimed

    if (not !!dbRefUpdate(!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Goto to GRP element
    !!ce  = !dbRef

    -- Check the name
    if (!dbRef.name.substring(2) neq !this.name.val) then

      -- Modify the name
      !newName   = |/| + !this.name.val
      NAME $!newName
      handle (41,12)

        -- Team already exists
        !!messageFile.error(141, 502, !this.name.val)
        !this.name.val      = |unset|

      endhandle

      -- Change the form title
      !this.formTitle =  !!messageFile.messageString(141, 857) & !dbRef.name.substring(2)

    endif

    -- Check the description
    if (!this.desc.val neq |unset| and !dbRef.desc neq !this.desc.val) then

      -- Modify the description
      !!ce.description = !this.desc.val

    endif

  endif

  -- Update the Admin Elements form
  !!adminElem.update('GRP')

  -- Reset the form for creation (if applicable)
  if (!mode eq 'CREATE') then
    !this.display('CREATE')
  endif

endmethod

--------------------------------------------------------------------------
-- Method:      .display()
--
-- Description: Display group location form
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for Location Group form|

  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    !this.dbRef = object DBREF()

  elseif (!mode eq 'MODIFY') then

    !dbRef   = !!adminElem.grpGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.dbRef and !this.shown()) then
      -- No action required
      return
    endif

    -- Set the new locations
    !this.dbRef = !dbRef

  endif

  -- Select the mode
  !this.mode.select('rtext',!mode.upcase())

  -- Update the form if already shown
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  else
    -- Calling function glbDisplay will show as free form
  endif

endmethod

--------------------------------------------------------------------------
-- Method:      .update()
--
-- Description: Update form for current group
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Current group
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update(!currentGroup is DBREF)

  -- Update Location Group form if shown in Modify mode for a group that is not the currently selected group
  if (!this.mode.selection('rtext').upcase() eq |MODIFY|) then
    if (!this.dbRef neq !currentGroup) then
      !this.dbRef = !currentGroup
      !this.init()
    endif
  endif

endmethod
