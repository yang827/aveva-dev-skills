-- Created:         Wed Jun 11 16:22:06 BST 1997
--
--
-- Description:
-- Form definition to define which Group a specific location is
-- a member of.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbGrpLoc

-- Initialise variables
!dText = ARRAY()
!rText = ARRAY()

-- Define form
setup form !!glbGrpLoc

  !!glbGrpLoc.formTitle     = 'Group Membership'
  !!glbGrpLoc.iconTitle     = 'GRP MEMB'
  !!glbGrpLoc.callback      = 'call !!glbGrpLocInit()'
  !!glbGrpLoc.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  list .group at x 0 y 0 |Project Groups| width 40 height 10

  option .sort at xmin ymax |Sort| call |call !!glbGrpLocList()| width 12
  text .filter at xmax+0.5 ymin |Filter| call |call !!glbGrpLocList()| width 13 STRING

  button .ok at x 0 ymax+0.5 |  OK  | call |!!glbLoc.groupSet(!this.group.selection('RTEXT').dbRef())| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
    -- Array of groups
    member .grpArray  is ARRAY
    -- Sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

exit
-- End of form definition for !!glbGrpLoc

-- Assign sort gadget values
!dText.append(|Name|)
!dText.append(|Description|)
!!glbGrpLoc.sort.dText    = !dText
!dText.clear()
!rText.append(|name|)
!rText.append(|description|)
!!glbGrpLoc.sort.rText    = !rText

-- Assign Filter Gadget values
!!glbGrpLoc.filter.val    = |*|
