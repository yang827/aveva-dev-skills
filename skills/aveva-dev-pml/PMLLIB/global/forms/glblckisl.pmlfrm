--
-- Author:          E.conba
-- Created:         Thu Jun 26 13:18:49 BST 1997
--
--
-- Description:
-- Form definition to allow the hub user to lock and isolate
-- remote on-line locations.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbLckIsl

-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!glbLckIsl resize

  !!glbLckIsl.formTitle     = 'Remote Locking and Isolation'
  !!glbLckIsl.iconTitle     = 'RMT L&I'
  !!glbLckIsl.callback      = 'call !!glbLckIslInit()'
  !!glbLckIsl.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  frame .locFr at x0 y 0 anchor all |On-line Project Locations|

    list .locn at xmin+1 ymin+1 anchor all call |call !!glbLckIslLocSel()| columns width 40 height 10
    option .sort at xmin ymax+0.2 anchor bottom+left |Sort By| call |call !!glbLckIslLocList()| width 12
    text .filter at xmax+1 ymin anchor bottom+right |Filter| call |call !!glbLckIslLocList()| width 10 STRING

  exit

  para .locIdTx at xmin.locn ymax+0.5 anchor bottom+left text |Location Id:|
  para .locId   at xmax+4 ymin anchor bottom+left width 5 line 1

  option .lock at xmin.locn ymax+0.2  anchor bottom+left |Lock State     | $
               call |call !!glbLckIslLock(_lock)| width 10
  option .isol at xmin.locn ymax      anchor bottom+left |Isolation State| $
               call |call !!glbLckIslIsol(_isol)| width 10

  text .message at xmin.locn ymax+0.2  anchor bottom+left+right |Message        | width 25 scroll 80 STRING

  button .apply at xmin.locn ymax+0.5  anchor bottom+left |Apply| call |call !!glbLckIsl()| APPLY
  button .dismiss at xmax form-size ymin  anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- DBREF of selected location
    member .dbRef      is DBREF
    -- Array of on-line locations
    member .locArray   is ARRAY
    -- Sort and filter values
    member .filterVal  is STRING
    member .sortVal    is STRING
    -- State of lock
    member .lockState  is BOOLEAN
    -- State of isolation
    member .isolState  is BOOLEAN


exit
-- End of form definition for !!glbLckIsl

-- Assign sort gadget values
call !!admLocSortGadg(!!glbLckIsl.sort)

-- Assign filter gadget values
!!glbLckIsl.filter.val    = |*|

-- Assign Lock gadget values
!dText.append(|Unknown|)
!dText.append(|Locked|)
!dText.append(|Unlocked|)
!!glbLckIsl.lock.dText  = !dText
!dText.clear()
!rText.append(|unset|)
!rText.append(|true|)
!rText.append(|false|)
!!glbLckIsl.lock.rText  = !rText
!rText.clear()

-- Assign Isol gadget values
!dText.append(|Unknown|)
!dText.append(|Isolated|)
!dText.append(|Connected|)
!!glbLckIsl.isol.dText  = !dText
!dText.clear()
!rText.append(|unset|)
!rText.append(|true|)
!rText.append(|false|)
!!glbLckIsl.isol.rText  = !rText
!rText.clear()
