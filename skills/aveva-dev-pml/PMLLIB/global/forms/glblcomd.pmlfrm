--
--
-- Description:
-- Form definition to create/modify a communications link element.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  arrSet()                         -                   Set locations that the current location can create update events with
--  blankEvent()                     -                   Callback for blank event toggle
--  display(STRING)                  -                   Display the Automatic Update definition form
--  glbLcomd()                       -                   Constructor
--  init()                           -                   Initialisation
--  locList()                        -                   List locations
--  locSel()                         -                   Select location
--  mode()                           -                   Callback for mode
--  modeSet(STRING)                  -                   Set mode
--  name()                           -                   Callback for name
--  noupdateFlag()                   -                   Checks action is made in Suppress Scheduled Updates gadget.
--  unsetCheck(GADGET,REAL,REAL,STRING) -                   Validation
--  update()                         -                   method to update the displayed LOC in the Location Definition
--
-----------------------------------------------------------------------------
-- Define form
setup form !!glbLcomd at xr 0.35 yr 0.1 resize

  !!glbLcomd.formTitle     = 'Automatic Update Definition'
  !!glbLcomd.iconTitle     = 'AUTO UPD'
  !!glbLcomd.callback      = '!this.init()'
  !!glbLcomd.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  text   .name     anchor top+left+right at x 3 y 0.2 |Name       | width 20 scroll 32 NAME
  option .mode     anchor top+right at xmax+2 ymin                  width 10

  text   .desc     anchor top+left+right at xmin.name ymax+0.2 |Description| width 32 scroll 120 STRING

  frame  .locFrame anchor all at x 0 ymax+0.2 |Update Location|

    list   .projLocn anchor all         at xmin+1 ymin+1 columns width 50 height 10
    option .sort     anchor bottom+left at xmin   ymax |Sort|   width 12
    text   .filter   anchor bottom+left at xmax+1 ymin |Filter| width 20 STRING

  exit
  toggle .noupdate    anchor bottom+left       at xmin+0.5 ymax+0.2     |Suppress Scheduled Updates|
  frame .settingFrame anchor bottom+left+right at x 0 ymax+0.2 |Update Settings|

    toggle .blankEvent anchor top+left   at xmin+1 ymin+1 |Inactive update event - Associate transfer scripts with remote update event| tagwidth 48
    text   .timeR  anchor top+left+right at xmin ymax+0.2 |Frequency      | width 32 scroll 120 STRING
    button .timeRP anchor top+right      at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreq

    text .retry    anchor top+left+right at xmin.timeR ymax.timeR+0.2 |Max. Retries   | width 10 INTEGER min 0 max 100
    text .inter    anchor top+left+right at xmin ymax+0.2       |Retry Interval |       width 10 INTEGER min 1 max 14400
    para .interTx  anchor top+right      at xmax ymin text      |seconds|  width 6

    text .before   anchor top+left+right at xmin.timeR ymax+0.2 |Transfer Script| width 30 scroll 120 STRING
    para .beforeTx anchor top+right      at xmax ymin text      |(Before)|  width 6
    text .after    anchor top+left+right at xmin.timeR ymax+0.2 |Transfer Script| width 30 scroll 120 STRING
    para .afterTx  anchor top+left       at xmax ymin text      |(After)|   width 6

  exit

  button .apply   anchor bottom+left  at xmin ymax+0.5 |Apply| APPLY
  button .reset   anchor bottom       at xcen form-0.5 * size ymin |Reset| RESET
  button .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
    -- commsLink element (LCOMD)
    member .dbRef     is DBREF
    -- Array of locations
    member .locArray  is ARRAY
    -- Endpoint Location
    member .toLoc     is DBREF
    -- Sort and filter values
    member .sortVal   is STRING
    member .filterVal is STRING
    -- Checks action is made in Suppress Scheduled Updates
    member .checkNoUpdate is BOOLEAN

exit
-- End of form definition for !!glbLcomd

------------------------------------------------------------------------
--
-- Method:      glbLcomd
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbLcomd()

  -- Callbacks
  !this.name.callback       = |!this.name()|
  !this.mode.callback       = |!this.mode()|
  !this.projLocn.callback   = |!this.locSel()|
  !this.sort.callback       = |!this.locList()|
  !this.filter.callback     = |!this.locList()|
  !this.noupdate.callback   = |!this.noupdateFlag()|
  !this.blankEvent.callback = |!this.blankEvent()|
  !this.timeR.callback      = |!!glbLcomdTimer()|
  !this.retry.callback      = |!this.unsetCheck(!this.retry, 0, 100,   '10')|
  !this.inter.callback      = |!this.unsetCheck(!this.inter, 1, 14400, '30')|
  !this.apply.callback      = |!this.apply()|

  -- Set icons
  !this.timeRP.addPixmap(!!pml.getPathName('popup16.png'))

  -- Assign mode gadget values
  !dText = ARRAY()
  !rText = ARRAY()
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText = !rText
  !rText.clear()

  -- Assign sort gadget values
  call !!admLocSortGadg(!this.sort)

endmethod
-- End of method definition for .glbLcomd()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !mode = !this.mode.selection('rtext')
  !this.checkNoUpdate = false

  -- Reinstate sort and filter values
  if (!this.sortVal.set()) then
    !this.filter.val = !this.filterVal
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Set form gadgets based on mode
  if (!mode eq 'CREATE') then

    -- Set form gadget values
    !this.formTitle   = |Create Update Event|
    !this.name.val    = |unset|
    !this.desc.val    = |unset|
    !this.timeR.val   = |0 * * * *|
    !this.retry.val   = |10|
    !this.inter.val   = |30|
    !this.before.val  = |unset|
    !this.after.val   = |unset|
    !this.noupdate.val   = false
    !this.blankEvent.val = false

    -- Activate timer gadgets
    !this.timeR.active  = true
    !this.timeRP.active = true
    !this.retry.active  = true
    !this.inter.active  = true

  elseif (!mode eq 'MODIFY') then

    -- Set form gadget values
    !this.formTitle   = |Modify Update Event: |+ !this.dbRef.name.substring(2)
    !this.name.val    = !this.dbRef.name.substring(2)

    if (!this.dbRef.description.empty()) then
      !this.desc.val    = |unset|
    else
      !this.desc.val    = !this.dbRef.description
    endif

    !this.noupdate.val  = !this.dbRef.lnoupd

    !this.timeR.val     = !this.dbRef.timeR
    !this.retry.val     = !this.dbRef.timeO.string()
    !this.inter.val     = !this.dbRef.timeI.string()

    if (!this.dbRef.execB.empty()) then
      !this.before.val  = |unset|
    else
      !this.before.val  = !this.dbRef.execB
    endif

    if (!this.dbRef.execA.empty()) then
      !this.after.val   = |unset|
    else
      !this.after.val   = !this.dbRef.execA
    endif

    -- Blank frequency implies event is partner for other location to run remote scripts
    !this.blankEvent.val = (!this.timeR.val.trim() eq ||)
    !this.timeR.active   =  !this.blankEvent.val.not()
    !this.timeRP.active  =  !this.blankEvent.val.not()
    !this.retry.active   =  !this.blankEvent.val.not()
    !this.inter.active   =  !this.blankEvent.val.not()

  endif

  -- Gather Location information
  !this.arrSet()
  !this.locList()

  -- Set focus on the name gadget
  !this.name.setFocus()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      name
--
-- Description: Callback for name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name()

  -- Initialise variables
  !mode       = !this.mode.selection('rtext')
  !curDbRef   = !this.dbRef
  !name       = !this.name.val

  -- Check to see if name converts to a dbref
  !dbRef      = !name.dbRef()
  handle any

    !name     = |/| + !name
    !dbRef    = !name.dbRef()
    handle any
      -- Element name not used (Good)
      !this.desc.setFocus()
      return
    endhandle

  endhandle

  -- Check to see if Dbref match current comms event
  if (!dbRef eq !curDbRef) then
    return
  endif

  -- Element name already used (Bad)
  -- Reset value based on mode
  if (!mode eq 'CREATE') then
    !this.name.val   = |unset|
  elseif (!mode eq 'MODIFY') then
    !this.name.val  = !curDbRef.name.substring(2)
  endif

  -- Raise error
  !!messageFile.error(141, 613, !dbRef.name)

endmethod
-- End of method definition for .name()

------------------------------------------------------------------------
--
-- Method:      mode
--
-- Description: Callback for mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mode()

  -- Call the display method to reset the form
  !this.display(!this.mode.selection('rtext'))

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
-- Method:      locSel
--
-- Description: Select location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locSel()

  -- Set the new location
  !location = !this.projLocn.selection('rtext').dbRef()
  handle any
    -- Take no action
  elsehandle none
    !this.toLoc = !location
  endhandle

endmethod
-- End of method definition for .locSel()

------------------------------------------------------------------------
--
-- Method:      locList
--
-- Description: List locations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locList()

  -- Initialise variables
  !target     = !this.toLoc

  -- Preserve sort and filter
  !this.sortVal    = !this.sort.selection('rtext')
  !this.filterVal  = !this.filter.val

  -- Clear the list
  !this.projLocn.clear()

  -- Filter the list
  !displayRefs = !!adminFilterSort(!this.locArray,!this.sort,!this.filter)

  -- Display the list
  call !!adminLocnTxtList(!displayRefs,!this.projLocn)

  -- Attempt to select the target location
  if (!target.set()) then

    !this.projLocn.select('rtext', !target.string())
    handle any

      -- Current target is not shown, so add it the rebuild
      !displayRefs.append(!target)
      !this.projLocn.clear()
      call !!adminLocnTxtList(!displayRefs,!this.projLocn)
      !this.projLocn.select('rtext', !target.string())

    endhandle

  endif

  -- Select the current target
  !dbRef = !this.projLocn.selection('rtext').dbRef()
  handle any
    !dbRef = object DBREF()
  endhandle
  !this.toLoc = !dbRef

endmethod
-- End of method definition for .locList()

------------------------------------------------------------------------
--
-- Method:      arrSet
--
-- Description: Set locations that the current location can create update events with
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .arrSet()

  -- Initialise variables
  !curPos    = !!ce
  !admLoc    = !!adminapplic.currentAdmLoc
  !locArray  = ARRAY()

  -- Get Child Locations
  !!ce       = !!dbrAdminGetWorld('LOC')
  !clause    = 'LOCRF eq '+ !admLoc.string()
  !locArray  = !!collectAllFor('LOC', !clause, !!ce)

  -- Add all locations in the same group
  if (!admLoc.grpRf.set()) then
    !group   = !admLoc.grpRf.name
    !!ce     = !!dbrAdminGetWorld('LOC')
    !clause  = 'GRPRF eq '+ !group
    !grpLoc  = !!collectAllFor('LOC', !clause, !!ce)
    !locArray.appendArray(!grpLoc)
  endif

  -- Get parent location (if Applicable)
  if (!admLoc.locRf.set()) then
    !locArray.append(!admLoc.locRf)
  endif

  -- Store the array
  !this.locArray = !locArray

  -- Check that we have some locations
  if (!locArray.unset()) then
    !!messageFile.error(141, 601)
  endif

  -- Restore database position
  !!ce = !curPos

endmethod
-- End of method definition for .arrSet()

------------------------------------------------------------------------
--
-- Method:      modeSet
--
-- Description: Set mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to set (CREATE or MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modeSet(!mode is STRING)

  -- Set the mode
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle

endmethod
-- End of method definition for .modeSet()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: method to update the displayed LOC in the Location Definition
-- form. The form must be displayed and in MODIFY mode.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Return if the form is not shown
  if (not !this.shown()) then
    return
  endif

  -- Initialise variables
  !mode     = !this.mode.selection('rtext')
  !selLcomd = !!adminElem.lComGet()
  !curLcomd = !this.dbRef

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selLcomd eq !curLcomd) then
    return
  endif

  -- Reinitialise the form
  !this.dbRef = !selLcomd
  !this.toLoc = !selLcomd.locRf
  !this.init()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Display the Automatic Update definition form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display the form in (CREATE or MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then
    -- Invalid mode
    return error |Invalid mode for form !!glbLcomd|
  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    !this.dbRef = object DBREF()
    !this.toLoc = object DBREF()

  elseif (!mode eq 'MODIFY') then

    -- Get the current LCOMD from the adminElements form
    !dbRef    = !!adminElem.lComGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.dbRef and !this.shown()) then
      -- No action require
      return
    elseif (!dbRef.badRef()) then
      -- Raise an error
      !!messageFile.error(141, 614, !dbRef.string())
      handle (06, 614)
        !!adminElem.update('LCOMD')
        return
      endhandle
    endif

    -- Set the new reference
    !this.dbRef = !dbRef
    !this.toLoc = !dbRef.locRf

  endif

  -- Select the mode
  !this.modeSet(!mode.upcase())

  -- Show or update the form
  if (!this.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!glbLcomd free

  endif

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      .noupdateFlag()
--
-- Description: Checks action is made in Suppress Scheduled Updates gadget.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .noupdateFlag()

  !this.checkNoUpdate = true

endmethod
-- End of method definition .noupdateFlag()

------------------------------------------------------------------------
--
-- Method:      .blankEvent()
--
-- Description: Callback for blank event toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .blankEvent()

  -- Blank out timer if event is partner for event at from other location
  if (!this.blankEvent.val) then
    !this.timeR.val = ||
    !this.retry.val = |0|
    !this.inter.val = |30|
  else
    !mode = !this.mode.selection('rtext')
    if ( !mode eq 'CREATE') then
      -- Normal event in create mode so use default values
      !this.timeR.val = |0 * * * *|
      !this.retry.val = |10|
      !this.inter.val = |30|
    elseif (!mode eq 'MODIFY') then
      -- Normal event in modify mode so use current values
      !this.timeR.val = !this.dbRef.timeR
      !this.retry.val = !this.dbRef.timeO.string()
      !this.inter.val = !this.dbRef.timeI.string()
    endif
  endif
  -- Activate gadgets
  !this.timeR.active  = !this.blankEvent.val.not()
  !this.timeRP.active = !this.blankEvent.val.not()
  !this.retry.active  = !this.blankEvent.val.not()
  !this.inter.active  = !this.blankEvent.val.not()

endmethod
-- End of method definition .noupdateFlag()

------------------------------------------------------------------------
--
-- Method:      unsetCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget being checked for unset value
--    2   R      REAL        Min value
--    3   R      REAL        Max value
--    4   R      STRING      Default value to use if gadget is unset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetCheck(!gadget is GADGET, !min is REAL, !max is REAL, !default is STRING)

  -- Prevent unset value
  if (!gadget.val.trim() eq ||) then
    !!alert.error(|Integer between | & !min & | and | & !max & | required|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetCheck()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise variables
  !updateFlag  = false
  !mode        = !this.mode.selection('rtext')
  !dbRef       = !this.dbRef
  !target      = !this.toLoc

  -- Check that a location has been selected
  if (!target.unset()) then

    -- Raise error
    !!messageFile.error(141, 611, !mode.lowcase())

  elseif (!target.badRef()) then

    -- Reset values
    !this.toLoc = object DBREF()
    !this.init()

    -- Location does not exist
    !!messageFile.error(141, 003, !!messageFile.messageString(141, 823), !target.string())

  endif

  -- Check that the name has not already been used
  -- This can occur with Apply-Reset-Apply which avoids the Name callback
  !this.name()

  -- Check that the location name is set
  if (!this.name.val eq 'unset') then

    -- Reset the name if modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val = !dbRef.name.substring(2)
    endif

    -- Raise error
    !!messageFile.error(141, 612, !mode.lowcase())

  endif

  -- Get the new attribute values
  !eventName    = |/| + !this.name.val
  !description  = !this.desc.val
  !location     = !target.name
  !timerVal     = !this.timeR.val
  !maxRetries   = !this.retry.val
  !interval     = !this.inter.val
  !scriptBefore = !this.before.val
  !scriptAfter  = !this.after.val

  -- Act on location according to mode
  if (!mode eq 'CREATE') then

    -- Navigate to the Local communications world
    !!ce = !!dbrAdminGetWorld('LCOM')
    LCOML 1

    -- Create a new communications event
    NEW LCOMD $!eventName
    handle (41,12)

      -- Delete the LCOMD
      DELETE LCOMD

      -- Raise error
      !badName = !this.name.val
      !this.name.val = |unset|
      !!messageFile.error(141, 613, !badName)

    endhandle

    -- Set the location
    LOCRF $!location

    -- Set the TIMER
    TIMER '$!timerVal'

    -- Set the comms parameters
    TIMEO $!maxRetries
    TIMEI $!interval

    -- Set the description
    if (!description neq 'unset') then
      !!ce.description = !description
    endif

    -- Set the transfer script values
    if (!scriptBefore neq 'unset') then
      EXECB '$!scriptBefore'
    endif
    if (!scriptAfter neq 'unset') then
      EXECA '$!scriptAfter'
    endif

    -- Grab the new DBREF
    !this.dbRef = !!ce
    !!adminElem.lcomSet(!!ce)

    -- Set the update flag
    !updateFlag = true

  elseif (!mode eq 'MODIFY') then

    -- Check for element being already claimed

    if (not !!dbRefUpdate(!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Navigate to the LCOMD
    !!ce = !dbRef

    -- Check the old name and the new name
    if (!dbRef.name neq !eventName) then

      -- Modify the name
      NAME $!eventName
      handle (41,12)

        -- Comms event already exists
        !badName = !this.name.val
        !this.name.val = !dbRef.name.substring(2)
        !!messageFile.error(141, 613, !badName)

      endhandle

      -- Change the formTitle
      !this.formTitle = !!messageFile.messageString(141, 856) + !dbRef.name.substring(2)

      -- Set the update flag
      !updateFlag = true

    endif

    -- Check to see if the location need changing
    if (!dbRef.locRf neq !target) then

      -- Change the location
      LOCRF $!location
      !updateFlag = true

    endif

    -- Check the timer value
    if (!dbRef.timeR.trim() neq !timerVal) then

      -- Change the timer
      TIMER '$!timerVal'

    endif

    -- Check the communications parameters
    if (!dbRef.timeO neq !maxRetries.real()) then

      -- Change the max retries value
      TIMEO $!maxRetries

    endif
    if (!dbRef.timeI neq !interval.real()) then

      -- Change the interval between retries
      TIMEI $!interval

    endif

    -- Check the descriptions
    if (!description neq 'unset' and !dbRef.description neq !description) then

      -- Change the description
      !!ce.description = !description
      !updateFlag      = true

    endif

    -- Check the transfer scripts
    if (!scriptBefore neq 'unset' and !dbRef.execB neq !scriptBefore) then

      -- Change the Before Update transfer script
      EXECB '$!scriptBefore'

    endif
    if (!scriptAfter neq 'unset' and !dbRef.execA neq !scriptAfter) then

      -- Change the After Update transfer script
      EXECA '$!scriptAfter'

    endif

  endif

  -- Check if scheduled update event has been suppressed
  if (!!ce.type.eq('LCOMD')) then
    if (!this.noupdate.val) then
      LNoUpdate true
    else
      LNoUpdate false
    endif
  endif

  -- Check to see if the Admin Elements form needs refreshing
  if (!updateFlag) then
    !!adminElem.update('LCOMD')
  endif

  -- Reset the form for creation (if applicable)
  if (!mode eq 'CREATE') then
    -- call !!commsLinkCreate()
    !this.display('CREATE')
  endif
  -- Modified for DFN 9328, Date:23.06.06
  -- Giving alert message if scheduled update event option is taken into action or not
  if (!this.checkNoUpdate) then
    !this.checkNoUpdate = false
    !!alert.message('Please SAVEWORK for change to Suppress Scheduled Updates to take effect')
  endif

endmethod
-- End of method definition for .apply()
