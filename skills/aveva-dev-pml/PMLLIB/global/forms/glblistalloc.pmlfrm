--
--
-- Description:
-- Form definition to provide a list function for database allocation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allocDb()                        -
--  allocLocn()                      -
--  allocSel()                       -
--  init()                           -
--
------------------------------------------------------------------------

-- Initialise variables
!dText   = ARRAY()
!rText   = ARRAY()

-- Define form
setup form !!glbListAlloc at xr 0.35 yr 0.1 resize

  !!glbListAlloc.formTitle     = 'List Database Allocation'
  !!glbListAlloc.iconTitle     = 'LST ALLOC'
  !!glbListAlloc.callback      = '!!glbListAlloc.init()'
  !!glbListAlloc.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  list .db at x0 y 0.4 anchor top+bottom+left call |!this.allocSel()| width 20 height 20

  para .desc anchor top+left at xmax+1 ymin width 40 line 1

  para .primTx   anchor top+left at xmax.db+1 ymax+0.1 text |Primary Loc.  :|
  para .prim     anchor top+left at xmax+1 ymin width 26 line 1
  para .distTx   anchor top+left at xmax.db+1 ymax+0.1 text |Distributed   :|
  para .dist     anchor top+left at xmax+1 ymin width 26 line 1
  para .pictTx   anchor top+left at xmax.db+1 ymax+0.1 text |Picture Files :|
  para .pict     anchor top+left at xmax+1 ymin width 26 line 1

  option .allocAs anchor top+left at xmin.primTx ymax+0.2 |Locations| call |!this.allocLocn()| width 15
  list .alloc anchor all at xmin.primTx ymax width 38 height 11

  button .dismiss at xmax form-size ymax |Dismiss| anchor bottom+right CANCEL

  -- Member definitions
  -- Previous Allocation type displayed
  member .allocLocn is STRING

  -- Assign allocAs gadget values
  !dText.append('Allocated')
  !dText.append('De-Allocated')
  !!glbListAlloc.allocAs.dText  = !dText
  !dText.clear()
  !rText.append('ALL')
  !rText.append('DEALL')
  !!glbListAlloc.allocAs.rText  = !rText
  !rText.clear()

exit
-- End of form definition for !!glbListAlloc

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description:
-- Function to initialise the Database Allocation list form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define method .init()

  -- Reinstate previous allocation list value
  if (!this.allocLocn.set()) then
    !this.allocAs.select('rtext',!this.allocLocn)
  else
    !this.allocLocn  = !this.allocAs.selection('rtext')
  endif

  -- Initialise the form
  !this.allocDb()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .allocDb()
--
-- Description:
-- Function to maintain the database list gadget in the !!glbListAlloc
-- form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .allocDb()

  -- Initialise variables

  !!ce                  = !!dbrAdminGetWorld('TEAM')
  !databases            = !!collectAllFor('DB','',!!ce)
  !dText                = ARRAY()
  !rText                = ARRAY()

-- Sort databases based on display setting

  if (!!sessionSettings.showAs eq 'NAME') then
     !sortOn = 'name'
  else
     !sortOn = 'description'
  endif

-- Sort the list of databases
  !textBlock            = object BLOCK(|!databases[!evalIndex].|& !sortOn &| + !databases[!evalIndex].name|)
  !sortText             = !databases.evaluate(!textBlock)

  !sortOrder            = !sortText.sortedIndices()
  !databases.reIndex(!sortOrder)

  -- Construct a list of display texts
  do !db values !databases

    if (!!sessionSettings.showAs eq 'NAME') then
      !dText.append(!db.name.substring(3))
    elseif (!db.description.empty()) then
      !dText.append(!db.name.substring(3))
    else
      !dText.append(!db.description)
    endif

    !rText.append(!db.string())

  enddo

  -- Assign values to list
  !this.db.dText = !dText
  !this.db.rText = !rText


  -- Initialise data on the selected database
  !this.allocSel()

endmethod
-- End of method definition for .allocDb()



-- End of Method definition

------------------------------------------------------------------------
--
-- Method:      .allocSel()
--
-- Description:
-- Function to display information about the selected database.
-- Information is displayed in the !!glbListAlloc form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allocSel()

  -- Initialise variables
  !db    = !this.db.selection('rtext').dbRef()
  !!ce   = !db
  DBLOC 1
  !dbLoc = !!ce
  !!ce   = !db

  -- Get the database description
  if (!!sessionSettings.showAs eq 'DESC') then
    !this.desc.val  = !db.name.substring(3)
  elseif (!db.description.empty()) then
    !this.desc.val  = '-- No Description --'
  else
    !this.desc.val  = !db.description
  endif

  if (!this.desc.val.length() gt 40) then
    !this.desc.val  = !this.desc.val.substring(1,38)+|>>|
  endif


  -- Set paragraph gadget values
  if (!db.foreign eq 'FOREIGN') then
    !this.prim.val  = 'Foreign from project '+ !db.filename.substring(3,3)
  elseif (!dbLoc.locRf.unset()) then
    !this.prim.val  = 'Transferring (Old: '+ !dbLoc.prvRf.locId +')'
  elseif (!!sessionSettings.showAs eq 'NAME') then
    !this.prim.val  = !dbLoc.locRf.name.substring(2)
  elseif (!dbLoc.locRf.description.empty()) then
    !this.prim.val  = !dbLoc.locRf.name.substring(2)
  else
    !this.prim.val  = !dbLoc.locRf.description
  endif

  if (!dbLoc.propg) then
    !this.dist.val  = 'Yes'
  else
    !this.dist.val  = 'No'
  endif

  if (!db.typeDb eq 'PADD') then
    if (!dbLoc.picfd) then
      !this.pict.val  = 'Distributed'
    else
      !this.pict.val  = 'Local'
    endif
  else
    !this.pict.val  = 'Not Applicable'
  endif

  -- Display a list of locations for the database
  !this.allocLocn()


endmethod
-- End of method definition for .allocSel()


------------------------------------------------------------------------
--
-- Method:      .allocLocn()
--
-- Description:
-- Function to list the locations to which a database is allocated
-- or de-allocated for the !!glbListAlloc form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .allocLocn()

  -- Initialise variables
  !db          = !this.db.selection('rtext').dbRef()
  !!ce         = !!dbrAdminGetWorld('LOC')
  !locnList    = !!collectAllFor('LOC','',!!ce)
  !display     = !this.allocAs.selection('rtext')
  !allocated   = ARRAY()
  !deallocated = ARRAY()
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Process the location list to find the selected database
  -- in the locations DBALL list.
  do !locn values !locnList

    !alloc       = !locn.mem[1].mem
    if (!alloc.findFirst(!db).set()) then
      !allocated.append(!locn)
    else
      !deallocated.append(!locn)
    endif

  enddo

  -- Get the list to display
  if (!display eq 'ALL') then
    !locations   = !allocated
  else
    !locations   = !deallocated
  endif

  -- Clear the list gadget
  !this.alloc.clear()

  -- Construct display texts for the list
  do !i indices !locations

    -- Assign list value depending upon display mode
    if (!!sessionSettings.showAs eq 'NAME') then
      !dText.append(!locations[!i].name.substring(2))
    elseif (!locations[!i].description.empty()) then
      !dText.append(!locations[!i].name.substring(2))
    else
      !dText.append(!locations[!i].description)
    endif

    !rText.append(!locations[!i].string())

  enddo

  -- Sort the list order
  !order       = !dText.sortedIndices()
  !dText.reIndex(!order)
  !rText.reIndex(!order)

  -- Assign list gadget values
  !this.alloc.dText  = !dText
  !this.alloc.rText  = !rText


endmethod
-- End of method definition for .allocLocn()
