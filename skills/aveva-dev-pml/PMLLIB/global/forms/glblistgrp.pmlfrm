--
--
-- Description:
-- Form definition for the List Groups form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  grpSel()                         -                   Function to display information about the selected  group in the
--  init()                           -                   Function to initialise the List Groups form.
--

-- Define form
setup form !!glbListGrp at xr 0.35 yr 0.1 resize

  !!glbListGrp.formTitle     = 'List Location Groups'
  !!glbListGrp.iconTitle     = 'LST GRP'
  !!glbListGrp.callback      = '!!glbListGrp.init()'
  !!glbListGrp.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  list .grp at x 0 y 0.5 anchor top+left+bottom call |!this.grpSel()| width 20 height 10

  para .desc   anchor top+left at xmax+1 ymin width 40 line 1
  list .member anchor all      at xmin.desc ymax+0.2 |Group Members| width 38 height 7

  button .dismiss at xmax form-size ymax |Dismiss| anchor bottom+right CANCEL

exit

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- End of form definition for !!glbListGrp
-- Description:
-- Function to initialise the List Groups form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .init()

  -- Initialise variables
  !!ce     = !!dbrAdminGetWorld('LOC')
  !groups  = !!collectAllFor('GRP','',!!ce)
  !dText   = ARRAY()
  !rText   = ARRAY()

  -- Clear the groups list
  !this.grp.clear()

  -- Construct display texts
  do !grp values !groups

    if (!!sessionSettings.showAs eq 'NAME') then
      !dText.append(!grp.name.substring(2))
    elseif (!grp.description.empty()) then
      !dText.append(!grp.name.substring(2))
    else
      !dText.append(!grp.description)
    endif

    !rText.append(!grp.string())

  enddo

  -- Sort the list order
  !order = !dText.sortedIndices()
  !dText.reIndex(!order)
  !rText.reIndex(!order)

  -- Assign list gadget values
  !this.grp.dText  = !dText
  !this.grp.rText  = !rText

  -- Display selection information
  !this.grpSel()

endmethod
-- End of method definition for .init()
-- End of Method definition

------------------------------------------------------------------------
--
-- Method:      .grpSel()
--
-- Description:
-- Function to display information about the selected  group in the
-- List Groups form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .grpSel()

  -- Initialise variables
  !curPos     = !!ce
  !dbRef      = object DBREF()
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Get the current selection
  !dbRef     = !this.grp.selection('rtext').dbRef()
  handle any
    -- No groups
    return
  endhandle

  -- Return if no current group
  if (!dbRef.unset()) then
    return
  endif

  -- Collect locations that are in the selected group
  !!ce        = !!dbrAdminGetWorld('LOC')
  !clause     = 'GRPRF eq '+ !dbRef.name
  !locations  = !!collectAllFor('LOC',!clause, !!ce)

  -- Set paragraph values
  if (!!sessionSettings.showAs eq 'NAME') then

    if (!dbRef.description.empty()) then
      !this.desc.val   = '-- No Description --'
    elseif (!dbRef.description.length() gt 40) then
      !this.desc.val   = !dbRef.description.substring(1,38) + '>>'
    else
      !this.desc.val   = !dbRef.description
    endif

  else

    !this.desc.val   = !dbRef.name.substring(2)

  endif

  -- Clear the members
  !this.member.clear()

  -- Create display texts
  do !loc values !locations

    skip if !loc.badRef()
    -- Get locations info
    !locName  = !loc.name.substring(2)
    !locId    = !loc.locId
    !locHost  = !loc.rhost

    -- *** OLD PML SYNTAX ***
    var !displayText COMPOSE SPACE 0 |$!locName| WIDTH 20 LEFT $
                             SPACE 1 |$!locId|   WIDTH 3 $
                             SPACE 1 |$!locHost| LEFT $

    !dText.append(!displayText[1])
    !rText.append(!loc.string())

  enddo

  -- Assign list gadget values
  !this.member.dText  = !dText
  !this.member.rText  = !rText

  -- Navigate to original database position
  !!ce  = !curPos

endmethod
-- End of method definition for .grpSel()
