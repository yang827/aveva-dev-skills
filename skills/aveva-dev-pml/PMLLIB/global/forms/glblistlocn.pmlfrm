--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue Jul 29 16:03:39 BST 1997
--
--
-- Description:
-- Form definition to provide facilities to list the locations
-- that exist in the current project.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Function to initialise the !!glbListLocn form.
--  locnSel()                        -                   Function to display information about the selected location
--

setup form !!glbListLocn at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'List Locations'
  !this.iconTitle     = 'LST LOCN'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  list .locn at x 0 y 0.5 anchor top+bottom+left call |!this.locnSel()| width 20 height 20

  para .desc anchor top+left at xmax+1 ymin width 40 line 1

  para .idTx     anchor top+left at xmax.locn+1 ymax text |Location ID     :|
  para .id       anchor top+left at xmax+1 ymin width 26 line 1
  para .statusTx anchor top+left at xmax.locn+1 ymax text |Status          :|
  para .status   anchor top+left at xmax+1 ymin width 26 line 1
  if(!!admControl.isValid('Centralised Admin')) then
    para .adminTx  anchor top+left at xmax.locn+1 ymax text |Administered by :|
    para .admin    anchor top+left at xmax+1 ymin width 26 line 1
  endif
  para .connTx   anchor top+left at xmax.locn+1 ymax text |Connection      :|
  para .conn     anchor top+left at xmax+1 ymin width 26 line 1
  para .hostTx   anchor top+left at xmax.locn+1 ymax text |Hostname        :|
  para .host     anchor top+left at xmax+1 ymin width 26 line 1
  para .groupTx  anchor top+left at xmax.locn+1 ymax text |Group           :|
  para .group    anchor top+left at xmax+1 ymin width 26 line 1

  list .alloc anchor all at xmin.idTx ymax+0.2 |Database Allocation| width 40 height 9

  button .dismiss at xmax form-size ymax |Dismiss| anchor right+bottom CANCEL

exit
-- End of form definition for !!glbListLocn

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description:
-- Function to initialise the !!glbListLocn form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !!ce        = !!dbrAdminGetWorld('LOC')
  !locations  = !!collectAllFor('LOC','',!!ce)
  !currentLoc = !!dbrGlbCurLocRf()
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Clear the location list
  !this.locn.clear()

  -- Construct display texts for the list
  do !i indices !locations

    -- Assign list value depending upon display mode
    if (!!sessionSettings.showAs eq 'NAME') then
      !dText.append(!locations[!i].name.substring(2))
    elseif (!locations[!i].description.empty()) then
      !dText.append(!locations[!i].name.substring(2))
    else
      !dText.append(!locations[!i].description)
    endif

    !rText.append(!locations[!i].string())

  enddo

  -- Sort the list order
  !order = !dText.sortedIndices()
  !dText.reIndex(!order)
  !rText.reIndex(!order)

  -- Assign list gadget values
  !this.locn.dText  = !dText
  !this.locn.rText  = !rText

  -- Attempt to select the current location
  !this.locn.select('rtext',!currentLoc.string())

  -- Display selection information
  !this.locnSel()

endmethod
-- End of method definition for .init()
-- End of Method definition


------------------------------------------------------------------------
--
-- Method:      .locnSel()
--
-- Description:
-- Function to display information about the selected location
-- in the this form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locnSel()

  -- Initialise variables
  !dbRef      = !this.locn.selection('rtext').dbRef()
  !!ce        = !dbRef
  !allocation = !!ce.mem[1].mem
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Set form gadget variables
  if (!!sessionSettings.showAs eq 'NAME') then

    if (!dbRef.description.empty() or !dbRef.description eq 'unset') then
      !this.desc.val   = '-- No Description --'
    elseif (!dbRef.description.length() gt 40) then
      !this.desc.val   = !dbRef.description.substring(1,38) + '>>'
    else
      !this.desc.val   = !dbRef.description
    endif

  else

    !this.desc.val   = !dbRef.name.substring(2)

  endif

  if (!dbRef.iconn.boolean()) then
    !this.conn.val   = 'On-line'
  else
    !this.conn.val   = 'Off-line'
  endif

  if (!dbRef eq !!dbrGlbHubLocRf()) then
    !locType = 'Hub'
  else
    !locType = 'Satellite'
  endif
  if (!dbRef.lInit) then
    !initFlag                = ' (Initialised)'
  else
    !initFlag                = ' (Uninitialised)'
  endif
  !this.status.val = !locType + !initFlag

  if(!!admControl.isValid('Centralised Admin')) then
    -- show administering location
    if (!dbRef.prmRf.unset() or !dbRef.prmRf eq !dbRef) then
      !this.admin.val = 'Self'
    else
      !this.admin.val = !dbRef.prmRf.namn
    endif
  endif

  if (!dbRef.grpRf.set()) then
    !this.group.val  = !dbRef.grpRf.name.substring(2)
  else
     !this.group.val  = 'Unset'
  endif

  !this.id.val     = !dbRef.locId
  !this.host.val   = !dbRef.rhost

  -- Clear the allocation list
  !this.alloc.clear()

  -- Populate the list of allocated databases
  do !db values !allocation

    skip if !db.badRef()
    -- Get database info
    !dbName    = !db.name.substring(3)
    !dbType    = !db.typeDb
    !dbFore    = !db.foreign.substring(1,1).upcase() + !db.foreign.substring(2).lowcase()
--    !dbPrim    = !db.primDb.substring(1,1).upcase() + !db.primDb.substring(2).lowcase()
    -- get DBLOC 1 of DB element. Its locRf attribute points to its primary location
    !dbLoc = !db.members[1]
    handle any
      -- should not get here - the word Unallocated will indicate a problem
      !dbPrim = 'Unallocated'
    elsehandle none
      if( !dbLoc.locRf eq !dbRef ) then
        !dbPrim = 'Primary'
      else
        !dbPrim = 'Secondary'
      endif
    endhandle

    -- *** OLD PML SYNTAX ***
    var !displayText COMPOSE SPACE 0 |$!dbName| WIDTH 20 LEFT $
                             SPACE 1 |$!dbType| WIDTH 4 $
                             SPACE 1 |$!dbPrim| WIDTH 9 LEFT $
                             SPACE 1 |$!dbFore| LEFT

    !dText.append(!displayText[1])
    !rText.append(!db.string())

  enddo

  -- Assign list gadget values
  !this.alloc.dText  = !dText
  !this.alloc.rText  = !rText

  -- Navigate to selected location
  !!ce  = !dbRef

endmethod
-- End of method definition for .locnSel()
