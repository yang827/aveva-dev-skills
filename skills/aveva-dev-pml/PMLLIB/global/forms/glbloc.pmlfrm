--
-- Author:          E.conba
-- Created:         Mon Nov 10 14:13:19 GMT 1997
--
--
-- Description:
-- Form definition to create/modify location elements.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admRefGet()                      DBREF               Function to return the current Administering location.
--  admRefSet(DBREF)                 -                   method to set the administering location of the current location.
--  cbAdmLoc(STRING)                 -                   method to set a locations Administration location.
--  cbApply()                        -                   Method to create and modify Location elements.
--  cbConn()                         -                   Function to disable the parent and group gadgets if the
--  cbConn(BOOLEAN)                  -                   Function to disable the parent and group gadgets if the
--  cbId()                           -                   Method to check that the LOCID specified is unique.
--  cbMode()                         -                   Callback to the mode gadget in the Location Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget in the Location form.
--  cbParent()                       -                   method to set a locations parent location.
--  checkExtractNumbers(GADGET,STRING) -                   Check the extract numbers are valid
--  checkHost()                      -                   Checks the user can ping the host name
--  createTransaction(STRING,STRING) DBREF               method to create a Transaction DB if missing. Returns dbRef for transDb
--  display(STRING)                  -                   Method to display the location definition form.
--  glbLoc()                         -                   initialise form
--  host()                           -                   Checks the user can ping the host name
--  init()                           -                   initialise form
--  modeGet()                        STRING              Function to return the current mode of the LOC Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the LOC Definition form.
--  overWrite()                      -                   Alerts while switch on the Overwrite DB Users option.
--  parentGet()                      DBREF               Function to return the current locations parent location.
--  parentSet(DBREF)                 -                   method to set the parent location of the current location.
--  refGet()                         DBREF               Return current location dbRef in this form
--  refSet(DBREF)                    -                   Set current location dbRef in this form
--  setExtractNo(STRING)             -                   method to set the from and to extract number range values.
--  update()                         -                   method to update the displayed LOC in the Location Definition
--
------------------------------------------------------------------------

-- Define form
setup form !!glbLoc resize

  !this.formTitle     = 'Location Definition'
  !this.iconTitle     = 'LOC'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.38 $ '

  -- Body of form definition
  text   .name  anchor top+left+right |Name|         tagwid 14 at x1        y0.2            width 20 scroll 50  NAME
  option .mode  anchor top+right                               at xmax+2    ymin            width 7

  text   .id    anchor top+left       |Location ID|  tagwid 14 at xmin.name ymax+0.2        width 4  scroll 3   NAME
  para   .idTx  anchor top+left                                at xmax+1    ymin            text     |(Unique 3 character code)|
  text   .desc  anchor top+left+right |Description|  tagwid 14 at xmin.name ymax+0.2        width 32 scroll 120 STRING

  option .conn  anchor top+left        |Connection|  tagwid 14 at xmin.name ymax+0.2        width 10

  text   .host  anchor top+left+right  |Hostname|    tagwid 14 at xmin.name ymax+0.2        width 24 scroll 120 NAME
  path right
  button .checkHost anchor top+right   |Check|
  path down
  option   .parent anchor top+left     |Parent|  tagwid 14 at xmin.name ymax+0.2        width 18

  option   .group  anchor top+left     |Group|   tagwid 14 at xmin.name ymax+0.2        width 18

  if(!!admControl.isValid('Centralised Admin')) then
    option   .admLoc  anchor top+left  |Admin Location| tagwid 14 at xmin.name ymax+0.2 width 18
  endif

  toggle .locpov    anchor top+left    |Overwrite DB Users|       at xmin ymax+0.2 call '!this.overWrite()'
  toggle .noextcr   anchor top+left    |Disable Extract Creation| at xmax ymin

  -- working extracts (AK)
  if(!!admControl.isValid('Global Extract Range')) then
    frame .extractNos anchor top+left+right |Working Extract Number Range| at xmin.name-1 ymax+0.5 width 46
      text .from      |        From | at xmin.name ymax            width 5 INTEGER min 0 max 8191
      text .to        |          To | at xmax      ymin            width 5 INTEGER min 0 max 8191
    exit
  endif

  frame .transactionDb anchor top+left+right |Transaction Database|  at x 0         ymax+0.5

    text   .dbNo    anchor top+left |DB Number| tagwid 14 at xmin+1  ymax+0.2 call |!!admChkDbDbno(!this.dbNo.val, !this.dbNo)|                  width 10 INTEGER min 1 max 255000
    button .dbNoDef anchor top+left |System|              at xmax+1  ymin     call |!!admChkDbDbno('SYS', !this.dbNo)|

    text   .tranDesc anchor top+left+right |Description| tagwid 14  at xmin.dbNo ymax+0.2  width 32 scroll 120 STRING
  exit


  button .apply   anchor bottom+left  |Apply|   at xmin form            ymax+0.5 APPLY
  button .dismiss anchor bottom+right |Dismiss| at xmax form-size       ymin     CANCEL

  -- Member Definitions
  -- Location dbRef
  member .dbRef     is DBREF

  -- Location Parent
  member .parentRef is DBREF

  -- Location group
  member .groupRef  is DBREF

  -- Administering Location
  member .adminRef is DBREF

  -- Extract ranges
  member .extractRange is ARRAY

exit

-- End of form definition for !!glbLoc
------------------------------------------------------------------------
--
-- Method:      .glbLoc()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbLoc()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !rText.append(|CREATE|)
  !dText.append(|Modify|)
  !rText.append(|MODIFY|)
  !this.mode.dText  = !dText
  !this.mode.rText  = !rText

  !rText.clear()
  !dText.clear()

  --- Assign connection gadget values
  !dText.append(|On-line|)
  !rText.append(|1|)
  !dText.append(|Off-line|)
  !rText.append(|0|)

  !this.conn.dText  = !dText
  !this.conn.rText  = !rText

  !dText.clear()
  !rText.clear()

  !this.name.callback        = |!this.cbName(!this.name)|
  !this.mode.callback        = |!this.cbMode()|
  if(!!admControl.isValid('Global Extract Range')) then
    !this.to.callback          = |!this.checkExtractNumbers(|
    !this.from.callback        = |!this.checkExtractNumbers(|
  endif
  !this.id.callback          = |!this.cbId()|
  !this.checkHost.callback   = |!this.checkHost()|
  !this.host.callback        = |!this.host()|
  !this.conn.callback        = |!this.cbConn()|
  !this.initcall             = '!this.init()'
  if(!!admControl.isValid('Centralised Admin')) then
    !this.admLoc.callback      = |!this.cbAdmLoc(!this.admLoc.selection())|
  endif
  !this.apply.callback       = |!this.cbApply()|

  -- Grey in/out connection
  !this.conn.active          = !!admControl.isValid('Offline Transfer')

  if(!!admControl.isValid('Global Extract Range')) then
    !this.from.val = '0'
    !this.to.val   = '0'
  endif

endmethod
-- End of method definition for .glbLoc()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- Initialise variables
  !mode    = !this.modeGet()
  !dbRef   = !this.refGet()
  !hubRef  = !!dbrGlbHubLocRf()
  !here    = !this.refGet()

    -- Check the current mode
  if (!mode eq 'CREATE') then

    -- Set the form title
    !this.formTitle  = 'Create Location'

    -- Assign gadget values Parent
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1'
    !siteLocations    = !!collectAllFor('LOC',!clause, !!ce)
    LOCLI 1
    !low  = !!ce.extlo
    !high = !!ce.exthi
    do !index from !low to !high
      !this.extractRange[!index] = !index
    enddo
    do !i values !siteLocations
      !low  = !i.extlo
      !high = !i.exthi
      do !index from !low to !high
        !this.extractRange[!index] = !index
      enddo
      !dbParents = (!i.name.after('/'))
      !dText.append(!dbParents)
      !rText.append(!dbParents)
    enddo

    !this.parent.dText = !dText
    !this.parent.rText = !rText
    !rText.clear()
    !dText.clear()

    -- Assign gadget values admin location
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1'
    !admLocations    = !!collectAllFor('LOC',!clause, !!ce)
    !dText.append('Local')
    !rText.append('LOCAL')
    do !i values !admLocations
      !dbAdmLoc = (!i.name.after('/'))
      !dText.append(!dbAdmLoc)
      !rText.append(!dbAdmLoc)
    enddo

    !this.admLoc.dText = !dText
    !this.admLoc.rText = !rText
    !rText.clear()
    !dText.clear()

    -- Assign gadget values groups
    !dText.append('unset')
    !rText.append('=0/0')
    !gCe          = !!dbrAdminGetWorld('LOC')
    !groups       = !!collectAllFor('GRP','',!gCe)
    do !i values !groups
      !dbGroups = (!i.name.after('/'))
      !dText.append(!dbGroups)
      !rText.append(!i.name)
    enddo

    !this.group.dText = !dText
    !this.group.rText = !rText

    !rText.clear()
    !dText.clear()

    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.id.val     = ||
    -- Make location ID gadgets active
    !this.id.active   = true
    !this.idTx.active = true
    !this.desc.val   = |unset|
    !this.host.val   = |unset|
    !this.conn.val   = !!dbrGlbHubLocRf().iconn
    !this.locpov.val = false
    !this.noextcr.val = FALSE
    !this.parent.visible = TRUE
    !this.admLoc.visible = TRUE


    !this.dbNo.val        = |System|
    !this.dbNo.active     = true
    !this.dbNoDef.active  = true

    !this.tranDesc.val       = |unset|
    !tranDescription = !this.tranDesc.val


    if(!!admControl.isValid('Global Extract Range')) then
      !this.from.val = |0|
      !this.to.val   = |0|
    endif

  elseif (!mode eq 'MODIFY') then

    -- Set the form title
    !this.formTitle  = 'Modify Location: ' + !dbRef.name.substring(2)

    -- Assign gadget values Parent
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1'
    !siteLocations    = !!collectAllFor('LOC',!clause, !!ce)
    LOCLI 1
    !low  = !!ce.extlo
    !high = !!ce.exthi
    do !index from !low to !high
      !this.extractRange[!index] = !index
    enddo
    do !i values !siteLocations
      !low  = !i.extlo
      !high = !i.exthi
      do !index from !low to !high
        !this.extractRange[!index] = !index
      enddo
      skip if (!dbRef.name eq !i.name)
      !dbParents = (!i.name.after('/'))
      !dText.append(!dbParents)
      !rText.append(!dbParents)
    enddo

    !this.parent.dText = !dText
    !this.parent.rText = !rText

    !rText.clear()
    !dText.clear()
    -- Assign gadget values admin location
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1'
    !admLocations    = !!collectAllFor('LOC',!clause, !!ce)
    !dText.append('Local')
    !rText.append('LOCAL')
    do !i values !admLocations
      skip if (!dbRef.name eq !i.name)
      !dbAdmLoc = (!i.name.after('/'))
      !dText.append(!dbAdmLoc)
      !rText.append(!dbAdmLoc)
    enddo

    !this.admLoc.dText = !dText
    !this.admLoc.rText = !rText

    !rText.clear()
    !dText.clear()

    -- Assign gadget values groups
    !dText.append('unset')
    !rText.append('=0/0')
    !gCe          = !!dbrAdminGetWorld('LOC')
    !groups       = !!collectAllFor('GRP','',!gCe)
    do !i values !groups
      !dbGroups = (!i.name.after('/'))
      !dText.append(!dbGroups)
      !rText.append(!i.name)
    enddo

    !this.group.dText = !dText
    !this.group.rText = !rText

    !rText.clear()
    !dText.clear()

    -- Set the form gadgets
    !this.name.val   = !dbRef.name.substring(2)
    !this.id.val     = !dbRef.locId

    -- Make location ID gadgets inactive (See exception)
    !this.id.active = false
    !this.idTx.active = false
    -- There is an exception to this, in that, if the HUB is not initialised it should be
    -- possible to modify it's location ID. So we will find out if we are at the HUB
    -- and initialised.
    if (!hubRef eq !here) then
      if (!here.linit.not()) then
        -- Make location ID gadgets active
        !this.id.active = true
        !this.idTx.active = true
      endif
    endif
    !this.host.val   = !dbRef.rhost

    -- extract numbers (AK)
    if(!!admControl.isValid('Global Extract Range')) then
      !this.setExtractNo('FROM')
      !this.setExtractNo('TO')
    endif

    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif

    !this.conn.select('rtext',!dbRef.iconn.string())

    -- Added for Global Enhancements. Date :05.04.06
    -- Checks the attributes lcpovw & noextcr at loc element.
    !this.locpov.val   = !dbRef.lcpovw
    !this.noextcr.val  = !dbRef.noextcr

    -- Transaction DB number and Description
    !tranDb = object DBREF( '/*TRANSACTION/' & !dbRef.locId )
    handle (2,109)
      !this.dbNo.val        = |System|
      !this.dbNo.active     = true
      !this.dbNoDef.active  = true

      !this.tranDesc.val       = |unset|
      !tranDescription = !this.tranDesc.val

    elsehandle none
       !this.dbNo.val        = !tranDb.dbNo.string()
       !this.dbNo.active     = false
       !this.dbNoDef.active  = false
       if (!tranDb.description.empty()) then
        !this.tranDesc.val       = |unset|
       else
        !this.tranDesc.val = !tranDb.description
       endif
       !tranDescription = !this.tranDesc.val
    endhandle


  endif
  !this.mode.active = !!dbrGlbHubLocRf().linit

  -- Set the state of the parent and group gadgets
  -- if the location if offline (but do not warn if already offline and just displaying form)
  !this.cbConn(FALSE)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .refGet()
--
-- Description: Return current location dbRef in this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   dbRef       Location Ref
--
------------------------------------------------------------------------

define method .refGet() is DBREF

  -- Return the value
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
-- Method:      .refSet()
--
-- Description: Set current location dbRef in this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       dbRef       location Reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refSet(!dbRef is DBREF)

  -- Store the dbRef
  !this.dbRef = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the Location Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbMode()

  -- Read the mode value
  !mode    = !this.modeGet()

  -- Call the display method to reset the form
  !this.display(!mode)

endmethod
-- End of method definition for .cbMode()

------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the LOC Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
------------------------------------------------------------------------

define method .modeGet() is STRING

  -- Return the mode
  return !this.mode.selection('rtext')

endmethod
-- End of method definition for .modeGet() STRING

------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the LOC Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modeSet(!mode is STRING)

  -- Check hub is initialised
  if( !!dbrGlbHubLocRf().linit.not() ) then
  	if( !mode.upcase() neq 'MODIFY' ) then
      !!alert.error(|The Hub Location has not been set. This must happen before the creation of new locations.|)
      return
  	endif
  endif

  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle

endmethod
-- End of method definition for .modeSet(STRING)

------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget in the Location form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbName(!gadget is GADGET)

   -- Initialise variables
  !mode           = !this.modeGet()
  !name           = !gadget.val
  !curDbRef       = !this.refGet()

  -- Check to see if name converts to a dbRef
  !dbRef            = !name.dbRef()

  handle any

    !name             = |/| + !name
    !dbRef            = !name.dbRef()

    handle any
      -- Element name not used
      !this.id.setFocus()
      return
    endhandle
  endhandle

  -- Check to see if dbRef matches current location
  if (!dbRef eq !curDbRef) then
    return
  endif

  -- Element name already used (Bad)

  -- Reset value based on mode
  if (!mode eq 'CREATE') then
    !gadget.val      = |unset|
  elseif (!mode eq 'MODIFY') then
    !gadget.val      = !curDbRef.name.substring(2)
  endif

  -- Raise error
  if( !dbRef.set() ) then
    !!messageFile.error(141, 504, !dbRef.name)
  else
    !!messageFile.error(141, 503, !mode.lowcase() )
  endif

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method:      .cbId()
--
-- Description: Method to check that the LOCID specified is unique.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbId()

  -- Initialise variables
  !project         = CURRENT PROJECT
  !locId           = !this.id.val.upcase()
  !mode            = !this.modeGet().upcase()
  !dbRef           = !this.refGet()
  !locArray            = ARRAY()
  -- !dirArray        = ARRAY()

  -- Check for current setting
  if (!mode eq 'MODIFY') then

    if (!locId eq !dbRef.locId) then
      !this.id.val  = !locId
      return
    endif
  endif

  -- Check that the value is 3 Characters
  if (!locId.length() neq 3) then

    -- Invalid length
    if (!mode eq 'CREATE') then
      !this.id.val  = ||
      !this.id.setFocus()
    else
      !this.id.val  = !dbRef.locId
    endif
    !!messageFile.error(141, 506)
  endif

  -- See if any locations match this LOCID
  !!ce              = !!dbrAdminGetWorld('LOC')
  !clause           = 'LOCID eq |'+!locId+'|'
  !locArray             = !!collectAllFor('LOC',!clause,!!ce)

  if (!locArray.set()) then

    -- Location matched LOCID, not unique
    if (!mode eq 'CREATE') then
      !this.id.val  = ||
      !this.id.setFocus()
    else
      !this.id.val  = !dbRef.locId
    endif
    !!messageFile.error(141, 507, !locId)
  endif

  -- Basic test have been passed, check that we have all the
  -- environment setup to be able to generate the location
  if (!mode eq 'CREATE') then

    -- Check that the container directory evar is set (may be a search-path)
    !evarArray = !!evarSplit(!project.code() +|_|+ !locId)
    !evarValue = !evarArray[1]
    handle(2,752)
      -- Variable returns no value
      !this.id.val  = ''
      !this.id.setFocus()
      !!messageFile.error(141, 514, !locId, !project.code() +|_|+ !locId)
    endhandle

    -- Check that the directory exists
    !directory = object FILE(!evarValue)

    if (not !directory.exists()) then
      !this.id.val  = ''
      !this.id.setFocus()
      !!messageFile.error(146, 023, !evarValue)
    endif

    -- P-19059 Check on sub-folders no longer required for 12 (necessary in 11.6)

  endif

  -- Reset the gadget value with the upper case version
  !this.id.val  = !locId

endmethod
-- End of method definition for .cbId()

------------------------------------------------------------------------
--
-- Method:      .cbConn()
--
-- Description: Function to disable the parent and group gadgets if the
-- current location is offline.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbConn()

  -- For callback on connection control warn if going to offline
  !this.cbConn(TRUE)

endmethod
-- End of method definition for .cbConn()

------------------------------------------------------------------------
--
-- Method:      .cbConn()
--
-- Description: Function to disable the parent and group gadgets if the
-- current location is offline.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Flag to warn if location is offline
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbConn(!warnIfOffline is BOOLEAN)

  -- Initialise variables
  !hubRef     = !!dbrGlbHubLocRf()
  !dbRef      = !this.refGet()
  !this.parent.visible = TRUE
  !this.admLoc.visible = TRUE

  -- Check the connection state
  if (!this.conn.selection('rtext').real().boolean()) then

    -- On-line connection
    if (!dbRef.set()) then

      -- Set Hub gadget states
      if (!dbRef eq !hubRef) then

        -- Location is HUB
        !this.host.active         = TRUE
        -- Select the hubRef
        !this.parent.visible       = false
        if(!!admControl.isValid('Centralised Admin')) then
          -- select the primary location
          !this.admLoc.visible       = false
        endif
        !this.group.active        = true
        !this.locpov.active       = true
        !this.noextcr.active      = true
      elseif (!hubRef.iconn.boolean().not()) then
        -- HUB is off-line location cannot be made on-line until hub is
        !this.conn.select('rtext','0')
        !!messageFile.error(141, 513)
      else
        -- Location is SATELLITE
        !this.host.active        = TRUE
        -- select the current parent
        !this.parent.active      = true
        if (!dbRef.locRf.unset()) then
          !this.parent.select('dtext',!hubRef.namn)
          !this.parentRef        = !hubRef
        else
          !this.parent.select('dtext',!dbRef.locRf.namn)
          !this.parentRef = !dbRef.locRf
        endif
        !this.group.active       = true
        !this.locpov.active      = true
        !this.noextcr.active     = true
        -- do not allow this location to be administered if it is already
        -- administering another location
        if(!!admControl.isValid('Centralised Admin')) then
          !clause                  = 'prmRf eq '+!dbRef.string()+' and refNo neq '+!dbRef.string()
          !tempLocations = !!collectAllFor( 'LOC', !clause, !!dbrAdminGetWorld('LOC'))
          if (!dbRef.prmloc.unset()) then
            !this.admLoc.select('dtext',!hubRef.namn)
            !this.adminRef        = !hubRef
          else
            if (!dbRef.name eq !dbRef.prmloc.name) then
              !this.admLoc.select('dtext','Local')
            else
              !this.admLoc.select('dtext',!dbRef.prmloc.namn)
            endif
            !this.adminRef = !dbRef.prmloc
          endif
          !this.admLoc.active      = !tempLocations.empty()
        endif
      endif
      -- Set the group
      if (!dbRef.grpRf.unset()) then
        !this.group.select('dtext','unset')
      else
        !this.group.select('dtext',!this.dbRef.grpRf.namn)
      endif
    else
      -- Create mode
      !this.host.active         = true
      !this.parent.select('dtext',!hubRef.namn)
      !this.parent.active       = true
      !this.group.active        = true
      if(!!admControl.isValid('Centralised Admin')) then
        !this.admLoc.select('dtext','Local')
        !this.admLoc.active       = true
      endif
      !this.locpov.active       = true
      !this.noextcr.active      = true
    endif
      !this.checkHost.active    = TRUE
  else

    -- About to make a location Off-line Warning required.
    if (!warnIfOffline) then
      !!alert.warning('Off-line connection selected for this location.')
    endif

    -- Check to see if existing location has children
    if (!dbRef.set()) then
      !children = ARRAY()
      !!dbrLocOffspring(!dbRef, !children)
      if (!children.set()) then

        -- Location has children (cannot be made offline)
        !this.conn.select('rtext','1')
        !!messageFile.error(141, 512, !dbRef.name.substring(2))
      endif
    endif

    -- Off-line connection
    !this.host.active         = false
    !this.parent.active       = false
    !this.group.active        = FALSE
    !this.checkHost.active    = FALSE
    if(!!admControl.isValid('Centralised Admin')) then
      !this.admLoc.active       = false
    endif
    !this.locpov.active       = false
    !this.noextcr.active      = false
  endif

endmethod
-- End of method definition for .cbConn()

------------------------------------------------------------------------
--
-- Method:      .cbParent()
--
-- Description: method to set a locations parent location.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name or dbRef as string.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- define method .cbParent(!location is STRING)
define method .cbParent()

  -- Initialise variables
  !dbRef     = !this.refGet()
  !parentRef = !this.parentGet()
  !parent    = object DBREF()
  !children  = ARRAY()

  -- Check that the name exists
--  !parent    = !location.dbRef()
  !parent    = !location.dbRef()
  handle any

    -- Add a slash and see if it makes a difference
    !newName   = |/| + !location
    !parent    = !newName.dbRef()
    handle any

     -- see if the text is a locid
      !locArray = !!collectAllFor(|loc|,||,!!dbrAdminGetWorld(|LOC|))
      do !ref values !locArray
        if ( !location.upcase() EQ !ref.locId) then
          !parent = !ref
          break
        endif
      enddo

      if (!parent.unset() ) then
        -- Invalid name argument
        !this.parentSet(!parentRef)
        !!messageFile.warning(143, 7, !newName)
        return
      endif
    endhandle
  endhandle

  -- Trap =0/0 as a input value
  if (!parent.unset()) then
    !this.parentSet(!parentRef)
    return
  endif

  -- Check that named element is of type LOC
  if (!parent.type neq 'LOC') then
    !this.parentSet(!parentRef)
    !!messageFile.error(143, 11, !parent.type, !parent.name, 'LOC')
  endif

  -- Don't do anything if this is the same parent
  if (!parent eq !parentRef) then
    !this.parentSet(!parentRef)
    return
  endif

  -- Check that this location is not the current location
  if (!parent eq !dbRef) then
    !this.parentSet(!parentRef)
    return
  endif

  -- Check that the new location is not a child of the
  -- current active location (modify only)
  if (!dbRef.set()) then

    -- Get child locations
    !!dbrLocOffspring(!dbRef, !children)

    if (!children.findFirst(!parent).set()) then

      -- Recursive structure not allowed
      !this.parentSet(!parentRef)
      !!messageFile.error(141, 530, !parent.locId, !dbRef.locId)
    endif
  endif

  -- Warn the user about changing the parent location
  if (!dbRef.set()) then

    !answer  = !!alert.confirm(!!messageFile.messageString(141, 505))
    if (!answer.boolean().not()) then

      -- User abort, reset the value
      !this.parentSet(!parentRef)
      return
    endif
  endif

  -- Change to form values
  !this.parentSet(!parent)

endmethod
-- End of method definition for .cbParent(STRING)

------------------------------------------------------------------------
--
-- Method:      .parentGet()
--
-- Description: Function to return the current locations parent location.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    dbRef       Current locations parent
--
------------------------------------------------------------------------

define method .parentGet() is DBREF

  return !this.parentRef

endmethod
-- End of method definition for .parentGet() DBREF

------------------------------------------------------------------------
--
-- Method:      .parentSet()
--
-- Description: method to set the parent location of the current location.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       dbRef of parent location (may be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parentSet(!dbRef is DBREF)

  -- Store the value
  !this.parentRef  = !dbRef

endmethod
-- End of method definition for .parentSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .setExtractNo(!which is STRING)
--
-- Description: method to set the from and to extract number range values.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       Which attribute to set

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setExtractNo(!which is STRING)

  if(!!admControl.isValid('Global Extract Range')) then
    if(!which.eq('FROM')) then
      !this.from.val = !this.dbRef.extlo.string()
      handle(2,754)
         !this.from.val = '0'
      endhandle
    else
      !this.to.val   = !this.dbRef.exthi.string()
       handle(2,754)
          !this.to.val = '0'
      endhandle
    endif
  endif

endmethod
-- End of method definition for .setExtractNo(STRING)

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to display the location definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  -- Initialise variables
  !hubRef  = !!dbrGlbHubLocRf()
  !here    = !this.refGet()

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for form !!glbLoc|
  endif

  -- Select the mode
  !this.modeSet(!mode.upcase())

  -- hide the parent locations list if already shown
--  if( defined(!!glbParLoc) ) then
--    if( !!glbParLoc.shown() ) then
--      !!glbParLoc.hide()
--    endif
--  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    -- Make location ID gadgets active
    !this.id.active = true
    !this.idTx.active = true
    !this.refSet(object DBREF())
    !this.parentSet(!hubRef)
    !this.admRefSet(object DBREF())

  elseif (!mode eq 'MODIFY') then

    --endif
    !dbRef   = !!adminElem.locGet()
    !locRef  = !this.refGet()

    if(!dbRef.prvRf.set())then
      -- site undergoing admLoc change await changing from daemon
      -- ##
      !!alert.error(|This location is undergoing an administration location change, awaiting final change from daemon, if this does not happen you may have to do a prevowner command|)
    endif

    if (!dbRef.unset()) then
      -- No action required
      return
    --elseif (!dbRef eq !this.refGet() and !this.shown()) then
      -- No action required
    --  return
    endif

    -- Always initialise as different location may need repopulated admin location list
    if( !locRef.unset() ) then
      -- Initialise form using selected Location
      !this.refSet(!dbRef)
    endif
    !this.init()
    -- Set the new locations
    !this.refSet(!dbRef)
    !here = !this.refGet()
    !this.parentSet(!dbRef.locRf)

    -- Added for DFN 9211. Date:03.08.06
    -- Setting up the value for admLoc text gadget.
    -- !this.admRefSet(!dbRef.prmRf)
    if (!dbRef.prmRf.set() AND !dbRef.prmRf NE !locRef ) then
      if(!!admControl.isValid('Centralised Admin')) then
        !this.admLoc.select('dtext',!dbRef.prmRf.namn)
      endif
    else
      if(!!admControl.isValid('Centralised Admin')) then
        !this.admLoc.select('dtext','Local')
      endif
    endif
    -- End addition for DFN 9211.
    -- extract numbers (AK)
    if(!!admControl.isValid('Global Extract Range')) then
      !this.setExtractNo('FROM')
      !this.setExtractNo('TO')
    endif

    -- Make location ID gadgets inactive (See exception)
    !here    = !this.refGet()
    !this.id.active = false
    !this.idTx.active = false
    -- There is an exception to this, in that, if the HUB is not initialised it should be
    -- possible to modify its location ID. So we will find out if we are at the HUB
    -- and initialised.
    -- DFN1930 We will allow any uninitialised location to modify the locid
    --if (!hubRef eq !here) then
      if (!here.linit.not()) then
        -- Make location ID gadgets active
        !this.id.active = true
        !this.idTx.active = true
      endif
  endif

  -- Show or update the form
  if (!this.shown()) then
    -- Re-Initialise the form - this overrides some settings
    !this.init()
  else
    -- Show the form
    show !!glbLoc free
  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify Location elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !dbRef            = !this.refGet()
--  !parentRef        = !this.parentGet()
  !admLoc           = !this.admRefGet()
  !mode             = !this.modeGet().upcase()
  !hubRef           = !!dbrGlbHubLocRf()
  !groupRef         = !this.group.selection().dbRef()
  !updateFlag       = FALSE

  !parent           = !this.parent.selection()
  !parentRef        = object DBREF( |/| & !parent )
  handle any
    !parentRef = object DBREF()
  endhandle
  !this.parentSet(!parentRef)

  -- Check that all parameters are set
  if (!this.name.val eq 'unset') then
    -- Reset the name if modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val         = !dbRef.name.substring(2)
    endif

    -- Raise error
    !!messageFile.error(141, 503, !mode.lowcase())
  elseif (!this.id.val.empty()) then

    -- Unset LOCID
    if (!mode eq 'MODIFY') then
      !this.id.val           = !dbRef.locId
    endif

    -- Raise error
    !!messageFile.error(141, 508, !mode.lowcase())
  elseif (!this.conn.selection('rtext').real().boolean()) then

    -- For an on-line location check PARENT and hostname
    if (!this.host.val eq 'unset') then

      -- Reset daemon hostname
      if (!mode eq 'MODIFY') then
        !this.host.val         = !dbRef.rhost
      endif

      -- Raise error
      !!messageFile.error(141, 509, !mode.lowcase())
    elseif (!dbRef neq !hubRef and !parentRef.unset()) then
      -- Unset location parent name
      if (!mode eq 'MODIFY') then
        !this.parentSet(!dbRef.locRf)
      else
        !this.parentSet(object dbRef)
      endif

      -- Raise error
      !!messageFile.error(141, 510, !mode.lowcase())
    endif
  endif

  -- Get all the new attribute values
  !locName          = |/| + !this.name.val
  !locId            = !this.id.val
  !description      = !this.desc.val
  !connection       = !this.conn.selection('rtext').real()
  !hostname         = !this.host.val
  !lcpvoval         = !this.locpov.val
  !noextcrval       = !this.noextcr.val

  -- extract numbers (AK)
  if(!!admControl.isValid('Global Extract Range')) then
    !from             = !this.from.val.real()
    !to               = !this.to.val.real()
    if (!from.unset()) then
      !!alert.error('Invalid global extract from range')
      !this.from.val = '0'
      return
    elseif (!to.unset()) then
      !!alert.error('Invalid global extract to range')
      !this.to.val = '0'
      return
    endif
  endif

  -- Act on location according to mode
  if (!mode eq 'CREATE') then

    -- Navigate to the Global Location World
    !!ce                   = !!dbrAdminGetWorld('LOC')
    call !!admCommand(|LOCLI 1|)

    -- (AK) automatically set the high range of the main db area.
    if(!!admControl.isValid('Global Extract Range')) then
      !mainNo = !from - 1
      if(!!ce.mcount.eq(0)) then
        call !!admCommand(|EXTHI | & !mainNo )
      endif
    endif

    call !!admCommand(|NEW LOC | & !locName)
    handle (41,12)
      -- Raise error
      !!messageFile.error(141, 504, !this.name.val)
      !this.name.val              = |unset|

    endhandle

    -- extract numbers (AK)
    if(!!admControl.isValid('Global Extract Range')) then
      call !!admCommand(|EXTLO | & !from)
      handle any
        -- only have time to do this harsh error check (AK)
       !!alert.error(!!error.text)
       !this.setExtractNo('FROM')
       !this.setExtractNo('TO')
      endhandle

      call !!admCommand(|EXTHI | & !to)
      handle any
      -- only have time to do this harsh error check (AK)
        !!alert.error(!!error.text)
        !this.setExtractNo('FROM')
        !this.setExtractNo('TO')
      endhandle
    endif

    -- Set attributes
    call !!admCommand('LOCID |' & !locId & '|')
    !!ce.description = !description
    call !!admCommand(|ICONN  | & !connection)

    -- Set attributes only for on-line locations
    if (!connection.boolean()) then
      call !!admCommand(|LOCRF  | & !parentRef.name)
      call !!admCommand('RHOST |' & !hostname & '|')

      if (!this.group.selection() neq '=0/0') then
        !command = |GRPRF | & !this.group.selection()
        call !!admCommand(!command)
      endif
      -- For the moment (till proved otherwise I'm going to assume the intended admin location is valid,
      -- see error checking in !this.admRefSet()
      if(NOT !admLoc.badRef() AND !admLoc.set())then
        -- Location LOCID values must be in quotes
        !command = 'SYSTEMLOCATION |' & !!ce.locId & '| PRIMARY AT |' & !admLoc.locId & '|'
        call !!admCommand( !command )
      endif

       -- Note the above will also work where with case where the admin location is the same current location i.e. - Local
    endif

    -- Get user to confirm Allocation and Savework
    !parentAlloc = !parentRef.mem[1].mem.size().string()
    !answer  = !!alert.question(!!messageFile.messageString(141, 511,$
       !!ce.name.substring(2), !parentAlloc))
    if (!answer eq 'CANCEL') then
      -- User does not wish to proceed
      DELETE LOCATION
      !this.display('CREATE')
      return
    elseif (!answer eq 'YES') then

      -- Generate location with allocation
      !commandGenerateLocation     = |GENERATE LOCATION | + !locName + | ALLOCATE|
      !!messageFile.prompt(141, 515, !locName.substring(2), $
        !!messageFile.messageString(141, 818))
    elseif (!answer eq 'NO') then

      -- Generate location without allocation
      !commandGenerateLocation     = |GENERATE LOCATION | + !locName + | NOALLOCATE|
      !!messageFile.prompt(141, 515, !locName.substring(2), $
        !!messageFile.messageString(141, 819))
    endif

    -- When the first location is made then this is when the Hub Transaction Database should be created
    !hubId = !hubRef.locId

    -- Get the DBNO value
    if (!this.dbNo.val.trim() eq 'System') then
      !dbNo        = ||
    else
      !dbNo        = | DBNO |+ !this.dbNo.val
    endif

    !tranDescription = !this.tranDesc.val


    -- Check to see if the hub has Transaction database
    !testA = object DBREF('/*TRANSACTION/' & !hubId )
    handle ANY
      -- Create the transaction database for hub location
      if( !hubId eq !locId ) then
        !commandCreateHubTranDB = 'CREATE DB TRANSACTION/' & !hubId & ' ACCESS OVERWRITE' & !dbNo
      else
        -- Let the System assign a number. The supplied number is for the Location Trans DB
        -- (Unlikely to get here if Hub transaction db was created through Modify Hub Location)
        !commandCreateHubTranDB = 'CREATE DB TRANSACTION/' & !hubId & ' ACCESS OVERWRITE'
      endif
    endhandle
    -- Check to see if the location has Transaction database (if it has then tell user to renew it)
    !testB = object DBREF('/*TRANSACTION/' & !locId )
    handle ANY
      -- Create the transaction database for this location
      !commandCreateLocTranDB = 'CREATE DB TRANSACTION/' & !locId & ' ACCESS OVERWRITE' & !dbNo
    elsehandle NONE
      !!alert.message('A transaction dB already exists for this location with DB Number ' & !testB.dbNo & '. It may need to be renewed')
    endhandle

    -- Check to see if the hub has Transaction database
    if (defined(!commandCreateHubTranDB)) then
      -- Create the transaction database for hub location
      call !!admCommand(!commandCreateHubTranDB)
      !testA = object DBREF('/*TRANSACTION/' & !hubId )
    endif
    if (defined(!commandCreateLocTranDB)) then
      -- Create the transaction database for location
      call !!admCommand(!commandCreateLocTranDB)
      !testA = object DBREF('/*TRANSACTION/' & !locId )
    endif

    -- Set the database description
    if (!tranDescription neq 'unset' and !this.tranDesc.active) then
      !testA.description = !tranDescription
    endif

    -- Generate the location data (The transaction databases will be allocated by the core by the generate command, so must exist now)
    -- This also attempts to allocate the system db to other online locations
    call !!admCommand(!commandGenerateLocation)
    handle (1,646)
      -- Cannot allocate System database to other location(s)
      -- Do not abort Location generation for this error
      !!alert.warning(!!error.text)

    elsehandle ANY
      !!alert.error(!!error.text)
      -- Error in generate location so delete location and transaction database
      !commandDeleteLocation = 'DELETE LOCATION'
      call !!admCommand(!commandDeleteLocation)
      handle ANY
        -- Ignore warning that system database must be manually deleted from other satellites
      endhandle
      -- Now delete Transaction DB (for satellite) - but only if created here
      if( defined(!commandCreateLocTranDB) ) then
        !commandDeleteLocTranDB = 'DELETE DB TRANSACTION/' & !locId
        call !!admCommand(!commandDeleteLocTranDB)
        handle ANY
          -- Ignore any error deleting the newly created or possibly old transaction database for this location
        endhandle
      endif
      !this.display('CREATE')
      return
    endhandle

    -- Issue warning about database allocation
    !!messageFile.warning(141, 516, !!ce.name.substring(2), $
       !parentRef.name.substring(2))

    -- Set the current location
    !!adminElem.locSet(!!ce)

    -- Set the update flag
    !updateFlag            = true

  elseif (!mode eq 'MODIFY') then

    -- Check for element being already claimed
    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Modify the current Location element.
    -- Navigate to LOC element
    !!ce                   = !dbRef

    -- See if the name need modifying
    if (!locName neq !dbRef.name) then

      -- Modify the name
      call !!admCommand(|NAME | & !locName)
      handle (41,12)

        -- Location name already exists
        !!messageFile.error(141, 504, !this.name.val)
        !this.name.val              = !dbRef.name.substring(2)
      endhandle

      -- Change the formTitle
      !this.formTitle     = |Modify Location: | + !dbRef.name.substring(2)
      !updateFlag            = true
    endif

    -- Check LOCID modification
    if (!locId neq !dbRef.locId) then
      !oldId = !dbRef.locId
      !newId = !locId

      -- Modify the location ID
      call !!admCommand(|LOCID '| & !locId & |'|)
      !updateFlag            = true

      -- Do not wish the non hub location ID to be modified so Gadgets are inactive so this should not arise
      -- However the HUB location ID may be changed before the location is initialised.
      -- This can be a problem if the transaction DB has already been created, delete and create a new one
      -- Check to see if the location has an old Transaction database
      !unusedTestC = object DBREF('/*TRANSACTION/' & !oldId )
      handle ANY
      elsehandle NONE
        -- Delete the old transaction database for hub location
        !commandDeleteOldTranDB = 'DELETE DB TRANSACTION/' & !oldId

        -- Check to see if the hub has a new Transaction database
        -- (use System-defined DB no, since old DB may be using it already)
        !unusedTestD = !this.createTransaction( !newId, || )
        if (defined(!commandDeleteOldTranDB)) then
          -- Delete the transaction database for hub location
          call !!admCommand(!commandDeleteOldTranDB)
          handle ANY
            !!alert.error(!!error.text)
          endhandle
        endif
      endhandle
      -- This helps to keep the transaction database in step, transaction database allocation is already done
      -- when the location was first generated, by the create option on the appware.
    endif

    -- Check DESC modification
    if (!description neq 'unset' and !description neq !dbRef.description) then
      -- Modify the description
      !!ce.description = !description
      !updateFlag      = true
    endif

    -- Check the connection
    if (!connection eq 0) then

      -- Location OFF-LINE
      if (!connection neq !dbRef.iconn) then

        -- Make connection off-line
        if( !dbRef.linit ) then
          -- ask user if they want to go off-line if location initialised
          !reply = !!alert.confirm(|Are you sure that you want to take location | & !locName & | offline? Database synchronisation/update will only be possible by offline transfer|)
          if( !reply eq 'YES' ) then
            call !!admCommand(|ICONN  0|)
--        call !!admCommand(|RHOST  'unset'|)
            !updateFlag            = true
          endif
        else
          -- un-initialised location can be set offline
          call !!admCommand(|ICONN  0|)
--        call !!admCommand(|RHOST  'unset'|)
          !updateFlag            = true
        endif
      endif
    elseif (!connection eq 1) then

      -- Location ON-LINE
      if (!connection neq !dbRef.iconn) then
        -- Make connection on-line
        call !!admCommand(|ICONN  1|)
        call !!admCommand('RHOST |' & !hostname & '|')
        if (!dbRef neq !hubRef) then
          call !!admCommand(|LOCRF | & !parentRef)
        endif
        if (!groupRef.set()) then
          call !!admCommand(|GRPRF | & !groupRef)
        endif
        !updateFlag            = true
      endif

      -- Check RHOST modification
      if (!hostname neq !dbRef.rhost) then
        call !!admCommand('RHOST |' & !hostname & '|')
      endif

      -- Check parent modification
      if (!dbRef neq !hubRef and !parentRef neq !dbRef.locRf) then
        -- Change location parent
        call !!admCommand(|LOCRF | & !parentRef)
      endif
      -- Check group modification
      if (not (!groupRef.unset() and !dbRef.grpRf.unset()) ) then
        if ((!groupRef.set() and !dbRef.grpRf.unset()) or $
            (!groupRef.unset() and !dbRef.grpRf.set()) or $
            (!groupRef neq !dbRef.grpRf))then
          -- Change location GROUP
          call !!admCommand(|GRPRF | & !groupRef)
          handle(1,459)
            !!alert.error(!!error.text & '. Ancestors must be assigned to a group before the descendant locations')
          endhandle
        endif
      endif

      -- Check admLoc modification
      -- if there is a difference
      if ((!admLoc NE !dbRef.prmRf)  )then
        --
        if(!admLoc.badRef() OR !admLoc.unset() OR (!admLoc EQ !dbRef))then
          -- as !admLoc.unset() and !dbRef.prmRf.unset() = admLoc LOCAL anyway!
          if(!dbRef.prvRf.unset() AND !dbRef.prmRf.set())then
            call !!admCommand('SYSTEMLOCATION ' & !!ce.locId & ' LOCAL')
            -- prmRf is unset but prvRf is set indicative of location currently undergoing change!
          elseif(!dbRef.prvRf.set())then
            --##
            !!alert.error(|This location is under a current administration location change!|)
          endif
        else
          call !!admCommand('SYSTEMLOCATION ' & !dbRef.locId & ' PRIMARY AT ' & !admLoc.locId )
        endif
        !updateFlag            = true
      endif
    endif

    if (!this.dbNo.val.trim() eq 'System') then
      !dbNo        = ||
    else
      !dbNo        = | DBNO |+ !this.dbNo.val
    endif

    -- If this is the hub location and it is uninitialised
    if((!dbRef EQ !hubRef) AND (!dbRef.linit EQ FALSE))then
      -- ##
      !answer  = !!alert.confirm(|The hub is currently uninitialised, do you wish to initialise it?|)
      if (!answer eq 'YES') then
        !!ce = !dbRef

        -- Create Transaction DB first to so number can be set
        !tranDb = !this.createTransaction( !hubRef.locId, !dbNo )

        -- This does not allow the Transaction DB number to be set
        call !!admCommand(|call !!glbInitialise()|)
      endif
    endif

    if(!!admControl.isValid('Global Extract Range')) then

      -- extract numbers (AK)
      call !!admCommand(|EXTLO | & !from)
      handle any
        -- only have time to do this harsh error check (AK)
        !!alert.error(!!error.text)
        !this.setExtractNo('FROM')
        !this.setExtractNo('TO')
      endhandle

      call !!admCommand(|EXTHI | & !to)
      handle any
        -- only have time to do this harsh error check (AK)
        !!alert.error(!!error.text)
        !this.setExtractNo('FROM')
        !this.setExtractNo('TO')
      endhandle
    endif

    -- Transaction DB description
    if( !this.dbNo.active ) then
      !tranDb = !this.createTransaction( !dbRef.locId, !dbNo )
    else
      !tranDb = object DBREF('/*TRANSACTION/' & !dbRef.locId )
    endif
    !tranDescription = !this.tranDesc.val

    if (!tranDescription neq 'unset' and !this.tranDesc.active) then

      -- Modify the description
      !tranDb.description = !tranDescription

      -- Set the update flag
      !updateFlag    = true

    endif


  endif

  -- Check to see if the Admin Elements form needs refreshing
  if (!updateFlag) then
    !!adminElem.update('LOC')
    -- Re-gather the possible locations this physical location can
    -- administer in case of change
    !!adminApplic.getPossLocs()
    -- Set Context and Gadget to current Admin Context
    !!adminApplic.setAdmContext(!!adminApplic.getAdmContext())
  endif

  -- Added for Global Enhancements. Date :05.04.06
    call !!admCommand(|LCPOVW | & !lcpvoval)
    call !!admCommand(|NOEXTCR | & !noextcrval)

  -- Reset the form for creation (if applicable)
  if (!mode eq 'CREATE') then
   !this.display('CREATE')
  endif
  !this.init()
endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .admRefGet()
--
-- Description: Function to return the current Administering location.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    dbRef       Current Administration location
--
------------------------------------------------------------------------

define method .admRefGet() is DBREF

  -- Return the value
  return !this.adminRef

endmethod
-- End of method definition for .admRefGet() DBREF

------------------------------------------------------------------------
--
-- Method:      .admRefSet()
--
-- Description: method to set the administering location of the current location.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       dbRef of Administration location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admRefSet(!dbRef is DBREF)

  -- Always initialise as different location may need repopulated admin location list
  !this.init()
  !locRef            = !this.refGet()

    if( !locRef.set() ) then
      !locId = !locRef.locId
    else
      !locId = !this.id.val
    endif


  -- Warn user if target not currently self administrating
  -- Not sure about the logic of this one
  -- if ((!admLoc.prmRf.unset().not() OR !admLoc.prmRf NEQ !admLoc) AND !admLoc NEQ !hubRef ) then
  if ( not( !dbRef.prmRf EQ !dbRef OR !dbRef.unset() OR !dbRef EQ !!dbrGlbHubLocRf() OR !dbRef EQ !locRef ) ) then
    if ( !dbRef.prmRf.set() ) then
      -- target is not self administering
      !answer = !!alert.confirm(!!messageFile.messageString(141, 558, !dbRef.locId, !dbRef.prmRf.locId, !dbRef.locId, !locId))
      if (!answer.boolean().not()) then
        return
      endif
    else
      -- This location cannot be administered by a location that this location administers
      if (!dbRef.prmRf eq curLoc) then
        !!alert.error('This location cannot be administered by a location that this location administers')
        return
      endif
      !answer = !!alert.confirm(!!messageFile.messageString(141, 558, !dbRef.locId, |ITSELF|, !dbRef.locId, !locId))
      if (!answer.boolean().not()) then
        return
      endif
    endif
  endif
  -- Display location name
  if (!dbRef.set() AND !dbRef NE !locRef ) then
    !this.admLoc.select('dtext',!dbRef.namn)
  else
    if(!!admControl.isValid('Centralised Admin')) then
      !this.admLoc.select('dtext','Local')
    endif
    !this.adminRef   = !this.refGet()
    return
  endif

  -- Store the value
  !this.adminRef  = !dbRef

endmethod
-- End of method definition for .admRefSet(DBREF)

------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed LOC in the Location Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Return if the form is not shown
  if (Undefined (!!glbLoc) or not !this.shown()) then
    return
  endif

  -- Initialise variables
  !mode    = !this.modeGet()
  !selLoc  = !!adminElem.locGet()
  !curLoc  = !this.refGet()

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selLoc eq !curLoc) then
    return
  endif

  -- Reinitialise the form
  !this.refSet(!selLoc)
  !this.parentSet(!selLoc.locRf)
  !this.admRefSet(!selLoc.prmRf)
  !this.init()

  -- Update the PARENT, GROUP, Admin Location forms if displayed
  if (Defined (!!glbParLoc)) then
     !!refreshDependent(!!glbParLoc)
  endif

  if (Defined (!!glbGrpLoc)) then
     !!refreshDependent(!!glbGrpLoc)
  endif

  if (Defined (!!glbLocAdmLocSub)) then
     !!refreshDependent(!!glbLocAdmLocSub)
  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      .cbAdmLoc()
--
-- Description: method to set a locations Administration location.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name or dbRef as string.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbAdmLoc(!location is STRING)

  -- Initialise variables
  !dbRef     = !this.refGet()
  !curRef    = !this.admRefGet()
  !admLoc    = object DBREF()
  !hubRef    = !!dbrGlbHubLocRf()

  -- Check for string Local
  if (!location.upcase() EQ |LOCAL|) then
    !this.admRefSet(!dbRef)
    return
  endif

  -- Check that the name exists
  !admLoc    = !location.dbRef()
  handle any

    -- Add a slash and see if it makes a difference
    !newName   = |/| + !location
    !admLoc    = !newName.dbRef()
    handle any

      -- see if the text is a locid
      !locArray = !!collectAllFor(|loc|,||,!!dbrAdminGetWorld(|LOC|))
      do !ref values !locArray
        if ( !location.upcase() EQ !ref.locId) then
          !admLoc = !ref
          break
        endif
      enddo

      if (!admLoc.unset()) then

        -- Invalid name argument
        !this.admRefSet(!curRef)
        !!messageFile.warning(143, 7, !newName)
        return
      endif
    endhandle
  endhandle

  -- Trap =0/0 as a input value
  if (!admLoc.unset()) then
    !this.admRefSet(!curRef)
    return
  endif

  -- Check that named element is of type LOC
  if (!admLoc.type neq 'LOC') then

    !this.admRefSet(!curRef)
    !!messageFile.error(143, 11, !admLoc.type, !admLoc.name, 'LOC')

  endif

  -- Don't do anything if this is the same
  if (!admLoc eq !curRef) then
    !this.admRefSet(!admLoc)
    return
  endif

  -- Check to see if target location is on-line
  if (!admLoc.iconn.boolean().not() ) then
    !this.admRefSet(!curRef)
    !!messageFile.error(141, 557, !admLoc.locId)
    return
  endif

  -- Change to form values
  !this.admRefSet(!admLoc)

endmethod
-- End of method definition for .cbAdmLoc(STRING)
------------------------------------------------------------------------
--
-- Method:      .overWrite()
--
-- Description: Alerts while switch on the Overwrite DB Users option.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .overWrite()
     if(!this.locpov.val) then
    !string = !!alert.confirm('Other Projects can not use this project if this option is switched on. Do you want to set it on?')
    if (!string.eq('NO')) then
           !this.locpov.val = false
        endif
     endif
endmethod
-- End of method definition for .overWrite()
------------------------------------------------------------------------
--
-- Method:      .host()
--
-- Description: Checks the user can ping the host name
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .host()

  if (!this.host.val eq '') then
    !!alert.error('Invalid host name')
    !this.host.val = 'unset'
    return
  endif

endmethod
-- End of method definition for .host()
------------------------------------------------------------------------
--
-- Method:      .checkHost()
--
-- Description: Checks the user can ping the host name
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .checkHost()

  if (!this.host.val eq 'unset') then
    !!alert.error('Host name is unset')
    return
  endif

  !input = ARRAY()
  var !unique UNIQUEID
  !pdmsWork = !!evarSplit('PDMSWK')
  !fileName = !pdmsWork[1] & '\' & !unique & 'ping'
  !batFileName = !pdmsWork[1] & '\' & !unique & '.bat'

  !batFile = object FILE(!batFileName)
  !str = ''
  !input.append(!str)
  !str = 'ping ' & !this.host.val
  !input.append(!str)
  !str = 'echo %ERRORLEVEL% > "' & !fileName & '"'
  !input.append(!str)
  !batFile.writeFile('OVERWRITE',!input)

  -- Need first to remove UTF8 BOM character from this - use Current Code-page
  !!pmlTransCFile( !batFileName, '', '', '0', '?' )

  !commandString = |SYSCOM 'call "$!batFileName"'|
  call !!admCommand(!commandString)


  -- Read the file to see if the host could be contacted
  !file = object FILE(!fileName)
  !list = !file.readFile()
  handle any
    -- Unexpected error - still need to delete file
    !!alert.error(!!error.text)
  elsehandle none
    if (!list[1] eq '1') then
      !!alert.error(|Could not contact the host | & !this.host.val)
    else
      !!alert.message(!this.host.val & | contacted|)
    endif
  endhandle

  !commandString = |SYSCOM 'del "$!fileName"'|
  call !!admCommand(!commandString)
  !commandString = |SYSCOM 'del "$!batFileName"'|
  call !!admCommand(!commandString)

endmethod
-- End of method definition for .checkHost()

------------------------------------------------------------------------
--
-- Method:      .checkExtractNumbers()
--
-- Description: Check the extract numbers are valid
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .checkExtractNumbers(!gadget is GADGET, !dummyAction is STRING)

  !from = !this.from.val.real()
  !to   = !this.to.val.real()
  if (!gadget.tag.trim() eq 'From') then
    if (!from.unset()) then
      !!alert.error('Invalid global extract from range')
      !this.from.val = '0'
      return
    else
      !test = !this.extractRange[!from]
      handle ANY
        -- OK the number has not been used
        -- Add 100 to the to value as a default
        !toValue = !from + 100
        !this.to.val = !toValue.string()
        !this.checkExtractNumbers(!this.to, '')
      elsehandle NONE
        !!alert.error('The from value $!from lies within a used extract range. Please input a valid value')
        !this.from.val = '0'
        return
      endhandle
    endif
  elseif (!gadget.tag.trim() eq 'To') then
    if (!to.unset()) then
      !!alert.error('Invalid global extract to range')
      !this.to.val = '0'
      if (!this.to.val.real() lt !this.from.val.real()) then
        !this.apply.active = FALSE
      endif
      return
    else
      !test = !this.extractRange[!to]
      handle ANY
        -- OK the number has not been used
      elsehandle NONE
        !!alert.error('The to value $!to lies within a used extract range. Please input a valid value')
        !this.to.val = '0'
        !this.apply.active = FALSE
        return
      endhandle
    endif
    if (!from gt !to) then
      !!alert.error('The FROM extract number must be less than or equal to the TO extract number')
      !this.to.val   = '0'
      !this.apply.active = FALSE
      return
    else
      !this.apply.active = TRUE
    endif

  endif


endmethod
-- End of method definition for .checkExtractNumbers()
------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      .createTransaction()
--
-- Description: Create Transaction DB for location if missing
--              returns the Transaction DB element
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      LOCID of Location
--    2    R     STRING      String defining required DBNO (if set)
-- Return:
--   [Data Type] [Description]
--    DBREF       Object for Transaction DB element (or Null DBREF)
------------------------------------------------------------------------
define method .createTransaction(!locId is STRING, !dbNo is STRING) is DBREF

    !testD = object DBREF('/*TRANSACTION/' & !locId )
    handle ANY
      -- Create the transaction database for hub location with the new locid
      !commandCreateNewTranDB = 'CREATE DB TRANSACTION/' & !locId & ' ACCESS OVERWRITE' & !dbNo
    endhandle
    if (defined(!commandCreateNewTranDB)) then
      -- Create the transaction database for location
      call !!admCommand(!commandCreateNewTranDB)
      handle ANY
        !!alert.error(!!error.text)
      endhandle
      !testD = object DBREF('/*TRANSACTION/' & !locId )
      handle any
         -- Ensure that there is an object to return
         !testD = object DBREF()
      endhandle
    endif

    -- Return the Transaction DB object
    return !testD

endmethod
-- End of method definition for .createTransaction()
