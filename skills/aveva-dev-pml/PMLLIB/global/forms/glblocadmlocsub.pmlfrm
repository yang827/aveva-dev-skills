-- File:            glblocadmlocsub.pmlfrm
--   Type:          Form Definition
--   Group:         File Handling

--     Keyword:     FILE
--   Module:        global
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Thu Oct 22 13:22:59 BST 1998
--
--
-- Description:
-- A sub-form to Display a list of suitable locations which can possibly administer the site in question
--
-- Note: This form will have to be closed and re-opened in order for any new locs to appear???
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbFilterSort()                   -                   Call back function for the gadget called filter and Sort
--  cbOk()                           -                   To take selection and pass it to the parent form!
--  init()                           -                   initialise form
--  locsGet()                        ARRAY               Get the list of locs
--  locsSet(ARRAY)                   -                   Set the list of locs and display them in the list
--
------------------------------------------------------------------------

setup form !!glbLocAdmLocSub resize

  !!glbLocAdmLocSub.formTitle     = 'Potential Locations'
  !!glbLocAdmLocSub.iconTitle     = 'Pot Loc'
  !!glbLocAdmLocSub.callback      = '!!glbLocAdmLocSub.init()'
  !!glbLocAdmLocSub.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  list .potLoc at x 0 y 0 anchor all |Potential Locations| columns width 40 height 10

  option .sort at xmin ymax+0.2 anchor bottom+left |Sort| call |!this.cbFilterSort()| width 12
  text .filter at xmax+0.5 ymin anchor bottom+right |Filter| call |!this.cbFilterSort()| width 13 STRING

  button .ok at x 0 ymax+0.5 anchor bottom+left |  OK  | call |!this.cbOk()| OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

  -- A useful function to create a sort contents associated with locations
  !!admLocSortGadg(!!glbLocAdmLocSub.sort)

  -- list of locations write locsGet & locSet
  member .locs is ARRAY

exit

-- End of form definition for !!glbLocAdmLocSub

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !resultingLocs = ARRAY()

  -- Get a list of locations which are on-line and are not administered by another location
  !clause = |ICONN EQ 1 AND ( UNSET(PRMRF) OR (REFNO OF PRMRF EQ REFNO) )|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  -- Set the location list
  !this.locsSet(!resultingLocs)

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .locsSet()
--
-- Description: Set the list of locs and display them in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY       list of locations to be displayed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locsSet(!listOfLocs is ARRAY)
  !this.locs = !listOfLocs
  -- Clear the list
  !this.potLoc.clear()
  !!adminLocnTxtList(!listOfLocs, !this.potLoc)
endmethod
-- End of method definition for .locsSet(ARRAY)
------------------------------------------------------------------------
--
-- Method:      locsGet()
--
-- Description: Get the list of locs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of locations displayed in the list
------------------------------------------------------------------------
define method .locsGet() is ARRAY
  return !this.locs
endmethod
-- End of method definition for .locsGet() ARRAY
------------------------------------------------------------------------
--
-- Method:      .cbFilterSort()
--
-- Description: Call back function for the gadget called filter and Sort
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbFilterSort()
  -- To get a list of all potential Sites
  !clause = |ICONN EQ 1 AND ( UNSET(PRMRF) OR (REFNO OF PRMRF EQ REFNO) )|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  -- Get a list sites and set them and the gadgets
  !this.locsSet(!!adminFilterSort(!resultingLocs,!!glbLocAdmLocSub.sort,!!glbLocAdmLocSub.filter))
endmethod
-- End of method definition for .cbFilterSort()
------------------------------------------------------------------------
--
-- Method:      .cbOk()
--
-- Description: To take selection and pass it to the parent form!
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbOk()
  !locs = !this.locsGet()
  !!glbLoc.admRefSet( !locs[!this.potLoc.val] )
endmethod
-- End of method definition for .cbOk()
