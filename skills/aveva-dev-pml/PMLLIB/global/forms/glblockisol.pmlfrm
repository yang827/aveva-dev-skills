--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Thu Jun 26 13:18:49 BST 1997
-- Modified         M.A.Ward April 2009
--
-- Description:
-- Form definition to allow the hub user to lock and isolate
-- remote on-line locations.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply the locking and isolations states
--  glbLockIsol()                    -                   Constructor
--  init()                           -                   initialise form
--  locList()                        -                   Set the location List
--  locSel()                         -                   Select the location
--  refSet()                         -                   Set up the current settings
--

-- Define form
setup form !!glbLockIsol resize

  -- Body of form definition
  frame .locFr at x0 y 0 anchor all |On-line Project Locations|

    list .locn at xmin+1 ymin+1 anchor all call |!this.locSel()| columns width 40 height 10
    option .sort at xmin ymax+0.2 anchor bottom+left |Sort By| call |!this.locList()| width 12
    text .filter at xmax+1 ymin anchor bottom+right |Filter| call |!this.locList()| width 10 STRING

  exit

  para .locIdTx at xmin.locn ymax+0.5 anchor bottom+left text |Location Id:|
  para .locId   at xmax+4 ymin anchor bottom+left width 5 line 1

  option .lock at xmin.locn ymax+0.2  anchor bottom+left |Lock State     | width 10
  option .isol at xmin.locn ymax      anchor bottom+left |Isolation State| width 10

  text .message at xmin.locn ymax+0.2  anchor bottom+left+right |Message        | width 25 scroll 80 STRING

  button .apply at xmin.locn ymax+0.5  anchor bottom+left |Apply| call |!this.apply()| APPLY
  button .dismiss at xmax form-size ymin  anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- DBREF of selected location
    member .dbRef      is DBREF
    -- Array of on-line locations
    member .locArray   is ARRAY
    -- Sort and filter values
    member .filterVal  is STRING
    member .sortVal    is STRING
    -- State of lock
    member .lockState  is BOOLEAN
    -- State of isolation
    member .isolState  is BOOLEAN
    member .firstInit  is BOOLEAN


exit
-- End of form definition for !!glbLockIsol

------------------------------------------------------------------------
--
-- Method:      .glbLockIsol()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbLockIsol()

  !this.initcall      = '!this.init()'
  !this.formTitle     = 'Project Locking and Isolation'
  !this.iconTitle     = 'RMT L&I'
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()
  -- Assign sort gadget values
  call !!admLocSortGadg(!!glbLockIsol.sort)

  -- Assign filter gadget values
  !this.filter.val    = |*|

  -- Assign Lock gadget values
  !dText.append(|Locked|)
  !dText.append(|Unlocked|)
  !!glbLockIsol.lock.dText  = !dText
  !dText.clear()
  !rText.append(|true|)
  !rText.append(|false|)
  !this.lock.rText  = !rText
  !rText.clear()

  -- Assign Isol gadget values
  !dText.append(|Isolated|)
  !dText.append(|Connected|)
  !this.isol.dText  = !dText
  !dText.clear()
  !rText.append(|true|)
  !rText.append(|false|)
  !!glbLockIsol.isol.rText  = !rText
  !rText.clear()

endmethod

 ------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.firstInit = TRUE

  -- Initialise variables
  !curPos     = !!ce
  !locations  = ARRAY()

  -- Collect location elements
  !!ce        = !!dbrAdminGetWorld('LOC')
  !clause     = 'LINIT eq true and ICONN eq 1'
  !locations  = !!collectAllFor('LOC', !clause, !!ce)

  -- Store the value
  !this.locArray = !locations

  -- Restore database position
  !!ce        = !curPos

  -- Check that there are some locations
  if (!locations.size() eq 0) then

    -- Raise error
    !!messageFile.error(141, 701)

  endif

  -- Restore sort and filter gadget values
  if (!this.filterVal.set()) then
    !this.filter.val  = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext', !this.sortVal)
  endif

  -- Populate the location list gadget
  !this.locList()

endmethod

------------------------------------------------------------------------
--
-- Method:      .locList()
--
-- Description: Set the location List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locList()

 -- Initialise variables
 !locations  = !this.locArray
 !dbRef      = !this.dbRef

 -- Preserve sort and filter values
 if (!this.filter.val.empty()) then
   !this.filter.val = |*|
 endif
 !this.filterVal = !this.filter.val
 !this.sortVal   = !this.sort.selection('rtext')

 -- Clear the list gadget
 !this.locn.clear()

 -- Sort the location list
 !displayList          = !!adminFilterSort(!locations, !this.sort, !this.filter)

  -- Display the list
  call !!adminLocnTxtList(!displayList, !this.locn)

  -- Attempt to select the current DBREF
  if (!dbRef.set()) then

    !this.locn.select('rtext',!dbRef.string())
    handle any
      -- Dummy handle
    endhandle

  endif

  -- Select the new DBREF as appropriate
  !this.locSel()

endmethod

------------------------------------------------------------------------
--
-- Method:      .locSel()
--
-- Description: Select the location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locSel()

  -- Initialise variables
  !dbRef   = object DBREF()

  -- If this being run from the initialise method select the current location from the list
  if (!this.firstInit) then
    !currentLocation = curloc
    !this.locn.select('rtext',!currentLocation.string())
    !this.firstInit = FALSE
  endif
  -- Get the current selection
  !dbRef   = !this.locn.selection('rtext').dbRef()
  handle any
    -- Dummy handle in case badRef
  endhandle

  -- Set the DBREF value
  !this.dbRef = !dbRef
  !this.refSet()

endmethod
------------------------------------------------------------------------
--
-- Method:      .refSet()
--
-- Description: Set up the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refSet()

  -- Store the value
  !dbRef      = !this.dbRef
  !this.lockState  = BOOLEAN()
  !this.isolState  = BOOLEAN()

  -- Return early if the DBREF is unset
  if (!dbRef.unset()) then

    !this.locId.val  = |unset|
    !this.lock.active = FALSE
    !this.isol.active = FALSE
    return

  endif

  -- Only need to use the AT syntax when not at the current location
  -- if the daemon is not running it can take a long time to find out
  -- and it does not matter if the daemon is running or not.
  !currentLocation = curloc
  -- Get additional information
  !locId           = !dbRef.locId
  !this.locId.val  = !locId
  if (!currentLocation eq !dbRef) then
    var !lockState LOCK
    var !isolState ISOLATION
  else
    -- Get the lock state
    var !lockState LOCK AT '$!locId'
    handle ANY

      -- Daemon not available
      !this.isol.active  = FALSE
      !this.lock.active  = FALSE
      !this.apply.active = FALSE
      -- Raise error
      !!alert.error(!!error.text)
      return
    elsehandle NONE
      var !isolState ISOLATION AT '$!locId'
    endhandle
  endif

  !this.isol.active  = TRUE
  !this.lock.active  = TRUE
  !this.apply.active = TRUE

  -- Returned result
  if (!lockState eq 'Locked') then
    !this.lockState  = true
    !this.lock.select('rtext','true')
  else
    !this.lockState  = false
    !this.lock.select('rtext','false')
  endif

  if (!isolState.boolean()) then
    !this.isolState  = true
    !this.isol.select('rtext','true')
  else
    !this.isolState  = false
    !this.isol.select('rtext','false')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: apply the locking and isolations states
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise variables
  !dbRef     = !this.dbRef
  !lockState = !this.lockState
  !isolState = !this.isolState
  !lockValue = !this.lock.selection('rtext')
  !isolValue = !this.isol.selection('rtext')
  !message   = !this.message.val
  !currentLocation = curloc
  if (!currentLocation eq !dbRef) then
    !current = TRUE
  else
    !current = FALSE
  endif

  -- See if the lock needs setting
  if (!lockState.string().lowcase() neq !lockValue) then

    -- Set the lock
    if (!lockValue.boolean() and !current) then
      !command = 'LOCK'
      !!adminapplic.lock.val = 'Locked'
      !!adminapplic.lock.background = 3
    elseif (!lockValue.boolean() and !current.not()) then
      !command = 'LOCK AT |'+ !dbRef.locId + '|'
    elseif (!lockValue.boolean().not() and !current) then
      !command = 'UNLOCK'
      !!adminapplic.lock.val = 'Unlocked'
      !!adminapplic.lock.background = 0
    elseif (!lockValue.boolean().not() and !current.not()) then
      !command   = 'UNLOCK AT |'+ !dbRef.locId + '|'
    endif

    -- Perform lock command
    call !!admCommand('$!command')
    handle ANY
      !this.lock.select('rtext', !lockState.string().lowcase())
      !!alert.error(!!error.text)
    endhandle

    -- Update form states
    !this.lockState = !lockValue.boolean()

  endif

  -- See if the isolation needs setting
  if (!isolState.string().lowcase() neq !isolValue) then

    -- Set the isolation
    if (!isolValue.boolean() and !current) then
      !command = 'ISOLATION TRUE'
      !!adminapplic.isolate.val = TRUE
    elseif (!isolValue.boolean() and !current.not()) then
      !command = 'ISOLATION TRUE AT |'+ !dbRef.locId + '|'
    elseif (!isolValue.boolean().not() and !current) then
      !command = 'ISOLATION FALSE'
      !!adminapplic.isolate.val = false
    elseif (!isolValue.boolean().not() and !current.not()) then
      !command   = 'ISOLATION FALSE AT |'+ !dbRef.locId + '|'
    endif

    -- Perform isolate command
    call !!admCommand('$!command')
    handle ANY
      !this.isol.select('rtext', !isolState.string().lowcase())
      !!alert.error(!!error.text)
    endhandle

    -- Update form states
    !this.isolState = !isolValue.boolean()

  endif

  -- If we got this far then a message should if one is specified
  -- The message goes to FREEUSER at the remote location.
  if (!message.empty()) then

    -- Message not required
    return

  endif

  if (!current.not()) then
    -- Send a message if changing a the state
    !command   = 'REMOTEMESSAGE ' + !dbRef.name +' FREEUSER |'+ !message + '|'
    call !!admCommand('$!command')
    handle none

      -- Inform user success
      !!alert.message('Message sent successfully')

    elsehandle any

      -- Raise error
      !!alert.error(!!error.text)

    endhandle
  endif

  !this.message.val = ''

endmethod
