--
--
-- Description:
-- Form to display project MDB data at a Location
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed
--  generateMdbs()                   -                   To query the open SYS DB and get an array of MDBS and place it
--  getDbs()                         -                   Will take the list !this.allMdbList and display the current
--  getMdbs()                        -                   Will take the list of mdbs (!this.allMdbLlist)
--  init()                           -                   Method to initialise the data for the MDB List form
--
------------------------------------------------------------------------

setup form !!glbMdbList resize
  !!glbMdbList.formTitle     = |MDB List|
  !!glbMdbList.iconTitle     = |MDB LIST|
  !!glbMdbList.callback      = |!!glbMdbList.init()|
  !!glbMdbList.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  option  .location at x 0 y 0.5 |Location Queried| anchor top+left call |!this.cbLocs()| width 9

  list .mdbs     at xmin ymax 0.5 anchor left+top+bottom call |!this.getDbs()| width 12 length 14

  para .mDesc    at xmax+1 y 1.4 anchor top+left width 43 lines 1

  list .current  at xmin.mDesc ymax |Current DBs|  anchor all width 43 length 4
  list .deferred at xmin.mDesc ymax |Deferred DBs| anchor bottom+left+right width 43 length 4

  button .dismiss at xmax form-size ymax |Dismiss| anchor bottom+right OK

  -- Member Definitions
  member .initAdmdLoc is DBREF
  member .locList is ARRAY
  member .allMdbList is ARRAY

exit
-- End of form definition for !!glbMdbList

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the MDB List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.initAdmdLoc  = !!adminApplic.getAdmContext()

  -- initialise Location Gadget
  !this.location.clear()

  -- Get a list of locations which are on-line
  !clause = |LINIT EQ TRUE|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locs
  !this.locList.clear()

  do !i values !resultingLocs
    if (!this.initAdmdLoc EQ !i) then
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
      -- To insure Initial Location is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !this.locList.invert()
    else
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif
  enddo

  !this.location.dText = !textOfLocs
  -- Generate list of MDBS at Location
  !this.generateMdbs()
  -- Get The MDBs
  !this.getMdbs()
  -- Get The DBs
  !this.getDbs()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getMdbs()
--
-- Description: Will take the list of mdbs (!this.allMdbLlist)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getMdbs()

  -- This uses a function which returns all dbs
  !resultingMdbs = !this.allMdbList
  -- Clear the current list of dbs
  !this.mdbs.clear()
  !tMdbList = ARRAY()

  -- Loop through the location db team list
  do !i indices !resultingMdbs
    if (!!sessionSettings.showAs eq |DESC|) then
      !tMdbList[!i] = !resultingMdbs[!i].description
      if (!tMdbList[!i].unset() or !tMdbList[!i].empty()) then
        !tMdbList[!i] = !resultingMdbs[!i].name
      else
        -- removes whitespace
        !tMdbList[!i] = !tMdbList[!i].trim()
      endif
    else
       !tMdbList[!i] = !resultingMdbs[!i].name
    endif
  enddo

  -- Sort the list of db and place them in the list gadget
  !sortOrder = !tMdbList.sortedIndices()
  !tMdbList.reIndex(!sortOrder)
  !this.allMdbList.reIndex(!sortOrder)

  !this.mdbs.dText = !tMdbList

endmethod
-- End of method definition for .getMdbs()

------------------------------------------------------------------------
--
-- Method:      .getDbs()
--
-- Description: Will take the list !this.allMdbList and display the current
-- and deferred dbs
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getDbs()

  --Clear current DBLISTS
  !this.current.clear()
  !this.deferred.clear()

  --Check there some MDBS
  if(!this.mdbs.val EQ 0)then
    return
  endif

  -- Get the current selected MDB
  !mdb       = !this.allMdbList[!this.mdbs.val]

  -- Set the MDB description text
  !desc = !mdb.description
  if (!desc.empty()) then
    !this.mDesc.val = |-- No description --|
  else
    if (!desc.length() gt 43) then
      !this.mDesc.val = !desc.subString(1,41) + |>>|
    else
      !this.mDesc.val = !desc
    endif
  endif

  -- List the current DB's in the selected MDB
  !currentName = !mdb.currDbName

  !this.current.clear()

  -- Get all databases as elements not strings
  !current = ARRAY()
  do !i indices !currentName
    !current[!i] = object DB(!currentName[!i] )
  enddo

  do !i indices !current
    !cdbType = !current[!i].type
    !cdbAcce = !current[!i].access
    !cdbCmod = !current[!i].claim
    if (!!sessionSettings.showAs eq |DESC|) then
      !cdbList[!i] = !current[!i].description
      if (!cdbList[!i].unset() or !cdbList[!i].empty()) then
        !cdbList[!i]  = !current[!i].name
      else
        if (!cdbList[!i].length() gt 40) then
          !cdbList[!i] = !cdbList[!i].subString(1,38) + |>>|
        endif
      endif
      var !cdbList[!i] COMPOSE SPACE 0 |$!cdbList[$!i]| WIDTH 40 LEFT SPACE 1 |$!cdbType| WIDTH 4 LEFT SPACE 1 |$!cdbAcce| WIDTH 10 LEFT SPACE 1 |$!cdbCmod| WIDTH 8 LEFT
    else
      var !cdbList[!i] COMPOSE SPACE 0 |$!current[$!i]| WIDTH 26 LEFT SPACE 1 |$!cdbType| WIDTH 4 LEFT SPACE 1 |$!cdbAcce| WIDTH 10 LEFT SPACE 1 |$!cdbCmod| WIDTH 8 LEFT
    endif
    !currDispList[!i] = !cdbList[!i]
  enddo

  -- Display the result if the array was populated.
  if (defined(!currDispList)) then
--    !currDispList.sort()
    !this.current.dText = !currDispList
  endif

  -- List the deferred DB's in the selected MDB
  !deferredName = !mdb.defDbName

  !this.deferred.clear()

  -- Get all databases as elements not strings
  !deferred = ARRAY()
  do !i indices !deferredName
    !deferred[!i] = object DB(!deferredName[!i] )
  enddo

  !this.deferred.clear()

  do !i indices !deferred
    if (!!sessionSettings.showAs eq |DESC|) then
      !dDbList[!i] = !deferred[!i].description
      if (!dDbList[!i].unset() or !dDbList[!i].empty()) then
        !dDbList[!i] = !deferred[!i].name
      else
        !dDbList[!i] = !dDbList[!i].trim()
      endif
    else
      !dDbList[!i] = !deferred[!i].name
    endif
  enddo

  -- List the deferred Db's in the selected MDB
  if (defined(!dDbList)) then
    !dDbList.sort()
    !this.deferred.dText = !dDbList
  endif

endmethod
-- End of method definition for .getDbs()

------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- This follows the premise that there will always be a location to
  -- administer!!!
  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
  !this.generateMdbs()
  ADMINISTER SYSTEM AT '$!<this.initAdmdLoc.locId>'

  !this.getMdbs()
  !this.getDbs()

endmethod
-- End of method definition for .cbLocs()

------------------------------------------------------------------------
--
-- Method:      .generateMdbs()
--
-- Description: To query the open SYS DB and get an array of MDBS and place it
-- form member !this.allMdbList in non sys db specific format
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .generateMdbs()
  !this.allMdbList.clear()
  !theMdbs = MDBS
  do !i values !theMdbs
    !temp = object GLBMDB()
    !temp.mdb2GlbMdb(!i)
    !this.allMdbList.append(!temp)
  enddo
endmethod
-- End of method definition for .generateMdbs()
