-- File:            glbmergepurgetimings.pmlfrm
--   Type:          Form Definition
--   Group:         Timings
--     Keyword:     GLOBAL
--   Module:        all
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jan 13 10:00:00 "GMT 2003
--
--
-- Description:
-- Specific Form to enable Automatic Merging and Purging of the local Transaction dB
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activeGadgets()                  -                   Get the default values
--  apply()                          -                   Get the recorded values
--  getCurrent()                     -                   Get the current values
--  getDefaults()                    -                   Get the default values
--  glbMergePurgeTimings()           -                   Constructor
--  init()                           -                   Initialise Form
--  validateDays(GADGET,STRING)      -                   Validate input to days gadgets
--

setup form !!glbMergePurgeTimings

  !this.formTitle     = |Transaction dB Merge/Purge|
  !this.iconTitle     = 'Merge/Purge'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  path down

  toggle .autoMergePurge at x0.5 y0 |Automatically Merge and Purge the '---' Transaction Database [ON/OFF] | call |!this.activeGadgets()|

  frame .options at x0 ymax+0.5 'Options'
    -- Merge timings
    text .timer    at x1 ymax |Frequency of Automatic Merge/Purge :- | call |call !!glbLcomdTimer()| width 30 scroll 120 STRING
    button .timerButton at xmax+0.2 ymin-0.1 pixmap width 16 height 16 form !!glbFreq

    -- Purge timings
    toggle .deleteSuccess    at x1 ymax+0.5 |Purge Successful Commands (from Transaction dB) older than | call |!this.deleteSuccesses.active = !this.deleteSuccess.val|
    text      .deleteSuccesses       '' at xmax ymin call '' width 4 is REAL
    paragraph .deleteSuccessesText   at xmax+1 ymin  text 'Days'  width 4
    toggle .deleteFailure    at x1 ymax |Purge Failed Commands (from Transaction dB) older than     | call |!this.deleteFailures.active = !this.deleteFailure.val|
    text      .deleteFailures        '' at xmax ymin call '' width 4 is REAL
    paragraph .deleteFailuresText    at xmax+1 ymin  text 'Days'  width 4

  exit

  -- Apply / Dismiss
  button    .apply         'Apply'    at x1 ymax+0.5 call '!this.apply()' apply
  button    .defaults      'Defaults' at xmax+5 ymin call '!this.getDefaults()'
  button    .reset         'Current Settings'    at xmax+5 ymin call '!this.getCurrent()'
  button    .dismiss       'Dismiss'  at xmax form-size ymin call '' cancel

-- End of form definition for !!glbMergePurgeTimings
exit

-- Set the form pixmaps
!this.timerButton.addPixmap(!!pml.getPathName('popup16.png'))

------------------------------------------------------------------------
--
-- Method:      glbMergePurgeTimings
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .glbMergePurgeTimings()

  -- Tool tips
  !this.timer.setToolTip('Frequency (The Default example is 23:59 every Saturday(format = minutes hours dates months days)')
  !this.timerButton.setToolTip('Frequency setting forms')
  !this.apply.setToolTip('Apply the Settings')
  !this.defaults.setToolTip('Display the default settings')
  !this.reset.setToolTip('Display the current settings')
  !this.dismiss.setToolTip('Close the form')

  -- Validation Calls
  !this.deleteSuccesses.validateCall = '!this.validateDays('
  !this.deleteFailures.validateCall = '!this.validateDays('

  -- Do not allow user input to timer string
  !this.timer.setEditable(false)

endmethod
-- End of method definition for .glbMergePurgeTimings()
------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise Form
--
------------------------------------------------------------------------

define method .init()

  !location = admloc
  handle NONE
    -- only valid for administering locations
    !this.autoMergePurge.tag = |Automatically Merge and Purge the '| & !location.locid & |' Transaction Database [ON/OFF] |
    !this.setActive(true)
  elsehandle ANY
    !this.setActive(false)
  endhandle

  !this.getCurrent()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      getDefaults
--
-- Description: Get the default values
--
------------------------------------------------------------------------

define method .getDefaults()

  !this.autoMergePurge.val = false

  !this.timer.val           = '59 23 * * 6'

  !this.deleteSuccess.val = true
  !this.deleteSuccesses.val = 3
  !this.deleteFailure.val  = true
  !this.deleteFailures.val  = 3

--  !this.autoExpunge.val    = true

  -- Activate the valid gadgets
  !this.activeGadgets()

endmethod
-- End of method definition for .getDefaults()
------------------------------------------------------------------------
--
-- Method:      getCurrent
--
-- Description: Get the current values
--
------------------------------------------------------------------------

define method .getCurrent()

  var !c collect all LCTIML for /*LC
  if (!c.size() gt 1) then
    -- There cannot be more than 1
    !!alert.error('There should be only one LCTIML, but there are ' & !c.size().string())
    return
  elseif (!c.size() eq 1) then
    -- That is ok, so remember this element
    !timingElement = !c[1].dbref()
  else
    -- A LCTIML should have been automatically created when the project was made global
    !!alert.error('A LCTIML should have been automatically created when the project was made global')
    -- Set up the defaults
    !this.getDefaults()
    return
  endif

  -- On/Off setting
  !this.autoMergePurge.val  = !timingElement.lmerdl

  -- Frequency setting
  !this.timer.val           = !timingElement.lmerti

  -- The timing attributes are stored in days
  !this.deleteSuccesses.val = !timingElement.lmersu
  if (!this.deleteSuccesses.val eq -1) then
    !this.deleteSuccess.val = false
    !this.deleteSuccesses.val = 3
  else
    !this.deleteSuccess.val = true
  endif
  !this.deleteFailures.val  = !timingElement.lmerfa
  if (!this.deleteFailures.val eq -1) then
    !this.deleteFailure.val = false
    !this.deleteFailures.val  = 3
  else
    !this.deleteFailure.val = true
  endif

  -- Expunge project setting
--  !this.autoExpunge.val     = !timingElement.lmerex

  -- Activate the valid gadgets
  !this.activeGadgets()

endmethod
-- End of method definition for .getCurrent()
------------------------------------------------------------------------
--
-- Method:      activeGadgets
--
-- Description: Get the default values
--
------------------------------------------------------------------------

define method .activeGadgets()

  if (!this.autoMergePurge.val.not()) then
    !this.timer.active               = false
    !this.timerButton.active         = false
    !this.deleteSuccess.active       = false
    !this.deleteSuccesses.active     = false
    !this.deleteSuccessesText.active = false
    !this.deleteFailure.active       = false
    !this.deleteFailures.active      = false
    !this.deleteFailuresText.active  = false
--    !this.autoExpunge.active         = false
  else
    !this.timer.active                = true
    !this.timerButton.active          = true
    !this.deleteSuccess.active        = true
    !this.deleteSuccesses.active      = true
    !this.deleteSuccessesText.active  = true
    !this.deleteFailure.active        = true
    !this.deleteFailures.active       = true
    !this.deleteFailuresText.active   = true
--    !this.autoExpunge.active          = true
  endif

endmethod
-- End of method definition for .activeGadgets()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Get the recorded values
--
------------------------------------------------------------------------

define method .apply()

  --initialise variables
  !timingElement   = object DBREF()
  -- !memory = !!ce

  -- /*LC
  var !c collect all LCTIML for /*LC
  if (!c.size() eq 0) then
    -- A LCTIML should have been automatically created when the project was made global
    !!alert.error('A LCTIML should have been automatically created when the project was made global')
    return
  elseif (!c.size() gt 1) then
    -- There cannot be more than 1
    !!alert.error('There should be only one LCTIML, automatically created when the project was made global')
    return
  else
    -- That is ok, so remember this element
    !timingElement = !c[1].dbref()
  endif

  -- OK navigate to the LCTIML
  -- !!ce = !timingElement

  -- *************** Set the ON/OFF attribute ***************
  !onOffSetting = !this.autoMergePurge.val
  -- LMERDL $!onOffSetting
  !timingElement.lmerdl = !onOffSetting

  if (!onOffSetting) then
    -- *************** Set the Frequency attribute ***************
    !frequencySetting = !this.timer.val
    -- LMERTI '$!frequencySetting'
    !timingElement.lmerti = !frequencySetting
    handle ANY
      !!alert.error('The Timing Frequency string is invalid. Use the frequency input forms to get it right')
      !this.timerButton.setFocus()
    endhandle


    -- *************** Set the purge Successes attribute ***************
    if (!this.deleteSuccess.val) then
      !successSetting = !this.deleteSuccesses.val
    else
      !successSetting = -1
    endif
    -- LMERSU $!successSetting
    !timingElement.lmersu = !successSetting


    -- *************** Set the purge Failures attribute ***************
    if (!this.deleteFailure.val) then
      !failureSetting = !this.deleteFailures.val
    else
      !failureSetting = -1
    endif
    -- LMERFA $!failureSetting
    !timingElement.lmerfa = !failureSetting

    if (!successSetting eq 0 and !failureSetting eq 0) then
      !!alert.warning('These settings indicate that all completed commands (successful and failed) will be purged$
 from the Transaction dB')
    endif

    -- *************** Set the expunge project attribute ***************
--    !expungeSetting = !this.autoExpunge.val
--    $p LMEREX $!expungeSetting
    -- !!ce.lmerex = !expungeSetting
  endif


  -- Navigate back to the original dB element
  -- !!ce = !memory

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      validateDays
--
-- Description:
--   Validate input to days gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDays(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input. Input should between 0 and 365 days'
  elseif (!gadget.val.between(0, 365).not()) then
    return error 1 'Input between 0 and 365 days'
  elseif (!gadget.val.eq(0)) then
    if (!gadget eq !this.deleteSuccesses) then
      !!alert.warning('Warning - zero days indicates that all successful commands will be Purged. Even those commands that$
 may have just been issued, but not yet reviewed by the users')
      return
    elseif (!gadget eq !this.deleteFailures) then
      !!alert.warning('Warning - zero days indicates that all failed commands will be Purged. Even those commands that$
 may have just been issued, but not yet reviewed by the users')
      return
    endif
  endif

endmethod
-- End of method definition for .validateDays()
