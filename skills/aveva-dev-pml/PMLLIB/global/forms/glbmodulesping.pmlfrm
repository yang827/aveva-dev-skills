--
--
-- Description:
-- Form definition to allow user to PING (test communications)
-- with remote locations.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Returns the result.
--  clearResults()                   -                   Clear the Results pane
--  errorDetail()                    -                   Display an alert containing the error detail
--  glbModulesPing()                 -                   Constructor function for this form
--  init()                           -                   Method to initialise the form
--  locnTxtList(ARRAY,GADGET)        -                   To construct the list texts for LOC elements
--  pingLocList()                    -                   To sort and filter the Location list.
--  pingLocSel()                     -                   To assign the selected location value to .dbRef (form member)
--  pingLocSet()                     -                   To get the current project location list.
--
------------------------------------------------------------------------
-- Form Definition

setup form !!glbModulesPing resize

  !this.formTitle     = 'Test Project Communications'
  !this.iconTitle     = 'PING'
  !this.callback      = '!this.init()'

  -- Body of form definition
  frame .locFrame at x 0 y 0 anchor all |On-Line Locations|

    list   .loc    at xmin+1   ymin+1   anchor all     call |!this.pingLocSel()| columns width 45 height 8
    option .sort   at xmin     ymax+0.2 anchor bottom+left  |Sort|   call |!this.pingLocList()| width 12
    text   .filter at xmax+0.5 ymin     anchor bottom+right |Filter| call |!this.pingLocList()| width 13 STRING

  exit

  button   .resultClr at xmax form-size ymax+0.5 anchor bottom+right |Clear Results| call |!this.clearResults()|
  button   .moreDetail  at xmin.resultClr-20     anchor bottom       |Detail...| call |!this.errorDetail()|
  textpane .results   at xmin.loc       ymax-0.5 anchor bottom+left+right |Ping Results| width 45 height 10

  button .apply at xmin.locFrame ymax+0.2 anchor bottom+left |Apply| call |!this.apply()|
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definition
  -- Array of locations
  member .locArray  is ARRAY
  -- Selected Location
  member .dbRef     is DBREF
  -- Sort and filter values
  member .sortVal   is STRING
  member .filterVal is STRING
  member .curLoc    is DBREF
  member .hubRef    is DBREF

  member .lastError is STRING

exit
-- End of form definition for !!glbModulesPing
----------------------------------------------------------------------------
--
--Method:.glbModulesPing()
--
-- Description: Constructor function for this form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .glbModulesPing()

  -- Assign sort gadget values
  call !!admLocSortGadg(!this.sort)
  -- Assign Filter gadget value
  !this.filter.val    = |*|

  -- Set textpane un-editable
  !this.results.setEditable(false)

  !current = CURRENT SESSION
  if( !current.module() neq 'ADMIN' ) then
    -- Only visible in ADMIN
    !this.moreDetail.visible = false
  endif
  !this.moreDetail.active = false

endmethod
-- End of method definition for .glbModulesPing()
----------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Restore sort and filter values
  if (!this.filterVal.set()) then
    !this.filter.val  = !this.filterVal
    !this.sort.select('rtext',!this.sortVal)
  endif
  -- Get project locations
  !this.pingLocSet()

  -- List the project locations
  !this.pingLocList()
  -- To get the location value
  !this.pingLocSel()

endmethod
-- End of method definition for .init()
----------------------------------------------------------------------------
--
-- Method:      .pingLocSet()
--
-- Description: To get the current project location list.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pingLocSet()

  -- Collect an array of locations
  !project      = CURRENT PROJECT
  !prjLocations = !project.locations()
  -- to get the dbref for all locations.
  !locationsOwn = !prjLocations.evaluate(object BLOCK('!prjLocations[!evalIndex].refno.dbRef()'))
  -- Uninitialised locations are valid - but exclude invalid ones
  !clause       = 'ICONN eq 1 and RHOST neq |*****|'
  -- to get the hubRef through /*GL element other than admin module.
  !currentElem  = !!ce
  !!ce          = !locationsOwn[1]
  /*GL
  !locations    = !!collectAllFor('LOC',!clause,!!ce)
  !this.hubRef  = !!ce.hubRf
  !!ce          = !currentElem
  -- Store the array
  !this.locArray = !locations

endmethod
-- End of method definition for .pingLocSet()
----------------------------------------------------------------------------
--
-- Method:      .pingLocList()
--
-- Description: To sort and filter the Location list.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .pingLocList()

  -- Initialise variables
  !locations    = !this.locArray
  -- Preserve the sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val  = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.loc.clear()

  -- Sort and filter the list
  !displayRefs  = !!adminFilterSort(!locations ,!this.sort,!this.filter)
  !this.locnTxtList(!displayRefs,!this.loc)

endmethod
-- End of method definition for .pingLocList()
----------------------------------------------------------------------------
--
-- Method:      .locnTxtList(ARRAY, GADGET)
--
-- Description: To construct the list texts for LOC elements
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF objects for LOC elements.
--    2   RW     GADGET      List gadget to populate
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .locnTxtList(!dbRefArray is ARRAY, !list is GADGET)

  -- Initialise variables
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Check that we have some locations to process
  if (!dbRefArray.unset()) then
    return
  endif

  -- Loop through array
  do !i indices !dbRefArray

    -- Collect attributes
    !name[!i]   = !dbRefArray[!i].name.substring(2)
    !id[!i]     = !dbRefArray[!i].locId
    if (!dbRefArray[!i].iconn eq 1) then
      !conn[!i]   = '(On )'
    else
      !conn[!i]   = '(Off)'
    endif
    !desc[!i]   = !dbRefArray[!i].desc
    if (!desc[!i].empty()) then
      !desc[!i] = |unset|
    endif

    if(!!admControl.isValid('Centralised Admin')) then
      if (!dbRefArray[!i].prmRf.unset() AND !dbRefArray[!i].prvRf.set()) then
        if (!dbRefArray[!i] EQ !this.hubRef) then
          !primRef[!i] = |{Adm:HUB  }|
        else
          !primRef[!i] = |{Adm:!!!  }|
        endif
      else
        -- last clause add in upgrade functionality from phase 1, prmRf.unset and prvRf.unset then it is administered locally
        if ((!dbRefArray[!i].prmRf EQ !dbRefArray[!i]) OR (!dbRefArray[!i].prmRf.unset() AND !dbRefArray[!i].prvRf.unset()))then
          !primRef[!i] = |{Adm:LOCAL}|
        else
          !primRef[!i] = |{Adm:| + !dbRefArray[!i].prmRf.locId + |  }|
        endif
      endif
    endif

  enddo

  -- Calculate column widths
  !widthName = !name.width()

  -- Loop through array and build texts
  do !i indices !dbRefArray

    -- Build Masks
    !name[!i] = !name[!i] + |                                |

    !this.curLoc = CURLOC

    -- Build Display text
    if (!dbRefArray[!i] eq !this.curLoc) then
      !displayText  = |<LOC>*|
    else
      !displayText  = |<LOC> |
    endif
    if (!dbRefArray[!i] eq !this.hubRef) then
      !displayText  = !displayText + |Hub |
    else
      !displayText  = !displayText + |    |
    endif

    if(!!admControl.isValid('Centralised Admin')) then
      !heading[1] = 'Name' !heading[2] = 'Location Id' !heading[3] = 'Connection' !heading[4] = 'Administered By' !heading[5] = 'Description'
      !displayText  = !displayText  & '  ' &  !name[!i].substring(1,!widthName)  & '	' &  |[| & !id[!i] & |]|  & '	' &  !conn[!i]  & '	' &  !primRef[!i]  & '	' &  !desc[!i]
    else
      !heading[1] = 'Name' !heading[2] = 'Location Id' !heading[3] = 'Connection' !heading[4] = 'Description'
      !displayText  = !displayText  & '  ' &  !name[!i].substring(1,!widthName)  & '	' &  |[| & !id[!i] & |]|  & '	' &  !conn[!i]  & '	' &  !desc[!i]
    endif

    -- Construct texts
    !dText.append(!displayText)
    !rText.append(!dbRefArray[!i].string())

  enddo

  -- Assign elements to the list gadget
  !list.setheadings(!heading)
  !list.dText   = !dText
  !list.rText   = !rText

endmethod
-- End of method definition for .locnTxtList(ARRAY, GADGET)
----------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Returns the result.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !location   = !this.dbRef
  !curLoc     = !this.curLoc
  !text       = ARRAY()
  -- Check that the location is set
  if (!location.unset()) then

    -- Raise error
    !!alert.error('Location is Unset')
    return

  endif

  -- Construct ping command
  !command    = |COMMS '|+ !location.locId +|'|

  -- Ping the location
  !this.lastError = ''
  var !result $!command
  handle (1,431)

    -- Un-initialise location
    !result   = |FAIL    - Location |+ !location.locId +| is uninitialised|

  elsehandle  (1,432)

    -- Off-line location
    !result   = |FAIL    - Location |+ !location.locId +| is off-line|

  elsehandle (1,500)

    -- Local daemon is unreachable
    !result   = |FAIL    - Local daemon is unreachable. Is "admind" started?|

  elsehandle (1,501)

    -- Cannot contact daemon
    !result   = |FAIL    - A daemon is unreachable between |+ !curLoc.locId +| and |+ !location.locId
    !reason = !!error.text.after('(1,501)   ')

  elsehandle none

    -- Success
    !result   = |SUCCESS - |+ !result

  endhandle

  -- Command to determine path
  !command   = |COMMS '|+ !location.locId +|' PATH|
  var !path $!command
  handle ANY
    !path = |          [ |+ !!error.text +| ]|
  elsehandle NONE
    !path = |          [ Path: |+ !path +| ]|
  endhandle

  -- Publish the result in the text pane
  !text     = !this.results.val
  !text.append(!result)
  !text.append(!path)
  if( defined(!reason)  ) then
    !this.lastError = !reason.after(' - ')
    if( !this.moreDetail.visible eq true ) then
      !this.moreDetail.active = true
    endif
  else
    !this.moreDetail.active = false
  endif
  !this.results.val = !text

endmethod
-- End of method definition for .apply()

----------------------------------------------------------------------------
--
-- Method:      .errorDetail()
--
-- Description: Display an alert containing the error detail
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .errorDetail()

  -- Display alert for last Comms error
  if( !this.lastError.length() gt 0 ) then
    !!alert.error(!this.lastError)
    -- Record the detail
      !text     = !this.results.val
      !text.append('Detail:')
      !text.append('       ' & !this.lastError.substring(1,255) )
      !text.append('')
      !this.results.val = !text
  endif

endmethod
-- End of method definition for .errorDetail()
----------------------------------------------------------------------------

----------------------------------------------------------------------------
--
-- Method:      .clearResults()
--
-- Description: Clear the Results pane
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .clearResults()

    -- Clear results
    !this.moreDetail.active = false
    !this.results.clear()

endmethod
-- End of method definition for .clearResults()
----------------------------------------------------------------------------

----------------------------------------------------------------------------
--
-- Method:      .pingLocSel()
--
-- Description: To assign the selected location value to .dbRef (form member)
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------
define method .pingLocSel()

  -- Initialise variables
  !dbRef    = !this.loc.selection('rtext').dbRef()
  handle any
    -- Cannot convert
    !dbRef    = object DBREF()
  endhandle

  -- Save the value
  !this.dbRef = !dbRef

endmethod
-- End of method definition for .pingLocSel()
----------------------------------------------------------------------------
