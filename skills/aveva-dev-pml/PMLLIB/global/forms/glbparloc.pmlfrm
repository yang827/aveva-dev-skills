-- Created:         Wed Jun 11 16:27:34 BST 1997
--
--
-- Description:
-- Form definition to define which location is the parent of the
-- current created or modified location.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrGet()                         ARRAY               Returns a list of Locations displayed in this form!
--  arrSet()                         -                   Method sets the locations list of this form
--  init()                           -                   method to initialise the Parent Location form.
--  list()                           -                   method to control the contents of the parent list gadget in the
--

-- Define form
setup form !!glbParLoc resize

  !!glbParLoc.formTitle     = 'Parent Location'
  !!glbParLoc.iconTitle     = 'PAR LOCN'
  !!glbParLoc.callback      = '!!glbParLoc.init()'
  !!glbParLoc.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  list .parent at x 0 y 0 anchor all |Project Locations| columns width 40 height 10

  option .sort at xmin ymax+0.2 anchor bottom+left |Sort| call |!this.list()| width 12
  text .filter at xmax+0.5 ymin anchor bottom+right |Filter| call |!this.list()| width 13 STRING

  button .ok at x 0 ymax+0.5 anchor bottom+left |  OK  | call |!!glbLoc.cbParent(!this.parent.selection('rtext'))| OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

  -- Member definition
    -- Array of locations
    member .locArray is ARRAY
    -- Sort and filter gadgets
    member .filterVal is STRING
    member .sortVal   is STRING

exit
-- End of form definition for !!glbParLoc

-- Assign sort gadget values
call !!admLocSortGadg(!!glbParLoc.sort)

-- Assign Filter gadget value
!!glbParLoc.filter.val    = |*|

------------------------------------------------------------------------
--
-- Method: .arrGet()
--
-- Description: Returns a list of Locations displayed in this form!
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of location DBREF's
--
------------------------------------------------------------------------
define method .arrGet() is ARRAY

  -- Return the values
  return !!glbParLoc.locArray

endmethod
-- End of method definition for .arrGet() ARRAY
------------------------------------------------------------------------
--
-- Method: .arrSet()
--
-- Description: Method sets the locations list of this form
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .arrSet()

  -- Initialise variables
  !curPos       = !!ce
  !locRef       = !!glbLoc.refGet()
  !parent       = !!glbLoc.parentGet()
  !children     = ARRAY()
  !locations    = ARRAY()

  -- Collect project locations (except the current one)
  if (!locRef.set()) then

    -- MODIFY, get on-line locations that are not descendants
    -- of the current location
    -- Get on-line project locations (except the current)
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1 and ref neq '+ !locRef.string()
    !projLocs     = !!collectAllFor('LOC',!clause, !!ce)

    -- Get children of the current location
    call !!dbrLocOffspring(!locRef , !children)

    -- Difference of the two arrays
    !locations    = !projLocs.difference(!children)

  else

    -- CREATE mode Get all on-line site
    !!ce          = !!dbrAdminGetWorld('LOC')
    !clause       = 'iconn eq 1'
    !locations    = !!collectAllFor('LOC',!clause, !!ce)

  endif

  -- Store the value
  !!glbParLoc.locArray = !locations

  -- Restore database position
  !!ce          = !curPos

endmethod
-- End of method definition for .arrSet()
------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: method to initialise the Parent Location form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Restore sort and filter values
  if (!!glbParLoc.sortVal.set()) then
    !!glbParLoc.sort.select('rtext', !!glbParLoc.sortVal)
    !!glbParLoc.filter.val  = !!glbParLoc.filterVal
  endif

  -- Collect and display the project locations
  !this.arrSet()
  !this.list()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method: .list()
--
-- Description: method to control the contents of the parent list gadget in the
-- Parent Location form.
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .list()

  -- Initialise variables
  !locations    = !this.arrGet()
  !parent       = !!glbLoc.parentGet()

  -- Preserve sort and filter states
  if (!!glbParLoc.filter.val.empty()) then
    !!glbParLoc.filter.val = |*|
  endif
  !!glbParLoc.filterVal = !!glbParLoc.filter.val
  !!glbParLoc.sortVal   = !!glbParLoc.sort.selection('rtext')

  -- Clear the list gadget
  !!glbParLoc.parent.clear()

    -- Sort and filter the list
  !displayRefs  = !!adminFilterSort(!locations ,!!glbParLoc.sort,!!glbParLoc.filter)

  -- Build the list of texts
  call !!adminLocnTxtList(!displayRefs,!!glbParLoc.parent)

  -- Try and select the current group
  if (!parent.set() and !parent.badRef().not()) then

    !!glbParLoc.parent.select('rtext',!parent.string())
    handle any

      -- Current parent must be displayed
      !displayRefs.append(!parent)
      call !!adminLocnTxtList(!displayRefs,!!glbParLoc.parent)
      !!glbParLoc.parent.select('rtext',!parent.string())

    endhandle

  endif

endmethod
-- End of method definition for .list()
