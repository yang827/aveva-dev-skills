--
--
-- Description:
-- Form definition to allow administrator to PING (test communications)
-- with remote locations.
--
------------------------------------------------------------------------

-- Kill existing form definition
-- kill !!glbPing

-- Define form
setup form !!glbPing resize

  !!glbPing.formTitle     = 'Test Project Communications'
  !!glbPing.iconTitle     = 'PING'
  !!glbPing.callback      = 'call !!glbPingInit()'
  !!glbPing.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  frame .locFrame at x 0 y 0 anchor all |On-Line Locations|

    list   .loc    at xmin+1   ymin+1   anchor all     call |call !!glbPingLocSel()|  columns width 45 height 8
    option .sort   at xmin     ymax+0.2 anchor bottom+left |Sort|   call |call !!glbPingLocList()| width 12
    text   .filter at xmax+0.5 ymin anchor bottom+right |Filter| call |call !!glbPingLocList()| width 13 STRING

  exit

  button   .resultClr at xmax form-size ymax+0.5 anchor bottom+right |Clear Results| call |_results.clear()|
  textpane .results   at xmin.loc       ymax-0.5 anchor bottom+left+right |Ping Results| width 45 height 10

  button .apply at xmin.locFrame ymax+0.2 anchor bottom+left |Apply| call |call !!glbPing()| APPLY
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definition
    -- Array of locations
    member .locArray  is ARRAY
    -- Selected Location
    member .dbRef     is DBREF
    -- Sort and filter values
    member .sortVal   is STRING
    member .filterVal is STRING

exit
-- End of form definition for !!glbPing

-- Assign sort gadget values
call !!admLocSortGadg(!!glbPing.sort)

-- Assign Filter gadget value
!!glbPing.filter.val    = |*|

-- Set textpane un-editable
!!glbPing.results.setEditable(false)
