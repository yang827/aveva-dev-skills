--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Wed Sep 3 17:26:31 BST 1997
--
--
-- Description:
-- Form definition to allow a database to be re-instated to its
-- previous owning location, should an allocation command fail.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Function to restore the previous owner of selected databases
--  dbGet()                          ARRAY               Function to return an array of transient database in the current
--  dbList()                         -                   Function to control the contents of the transient database list
--  dbSet()                          -                   Function to collect a list of transient database in the current
--  init()                           -                   Function to initialise the Restore Database Owner form.
--  locGet()                         ARRAY               Function to get all the Transient Locations
--  locList()                        -                   Function to control the contents of the transient location list
--  locSet()                         -                   Function to get all the Transient Locations
--  type()                           -                   Method to switch between elements!
--
------------------------------------------------------------------------

-- Define form
setup form !!glbPrOwn resize

  !!glbPrOwn.formTitle     = 'Recover Primary Location'
  !!glbPrOwn.iconTitle     = 'PREVOWNER DB'
  !!glbPrOwn.callback      = '!!glbPrOwn.init()'
  !!glbPrOwn.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  option .type at x 0 y 0 anchor top+left |Transient | call |!this.type()| width 12
  list .elems at xmin ymax+0.2 anchor all multiple columns width 40 height 10
  option .sort at xmin   ymax+0.2 anchor bottom+left |Sort By| call |!this.dbList()| width 12
  text .filter at xmax+1 ymin anchor bottom+right |Filter| call |!this.dbList()| width 10 STRING

  button .apply at xmin.elems ymax+0.5 anchor bottom+left |Apply| call |!this.cbApply()|  APPLY
  button .cancel at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- Array of transient DBS
    member .dbArray  is ARRAY
    member .locArray is ARRAY
    -- Sort and filter gadget values
    member .filterVal is STRING
    member .sortVal   is STRING
    member .state is STRING
-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Assign function gadget values
!dText.append(|Databases|)
!dText.append(|Locations|)
!!glbPrOwn.type.dText  = !dText
!dText.clear()
!rText.append(|DB|)
!rText.append(|LOC|)
!!glbPrOwn.type.rText  = !rText
!rText.clear()


exit
-- End of form definition for !!glbPrOwn
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Get the transient databases
  !this.dbSet()
  !this.locSet()

  -- See if there are any in the project
  if( (!this.dbGet().size() eq 0) AND (!this.locGet().size() eq 0) )then
    --call !!error(06715)
    --!!messageFile.error(141,715)
    -- ##
    !!alert.error(|There are no transient Elements in this Project|)
  endif

  if( !this.dbGet().size() GT 0) then

    -- Update the list gadget
    !this.dbList()
    !this.state = |DB|
  else

    -- Update the list gadget
    !this.locList()
    !this.state = |LOC|
  endif
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .cbApply
--
-- Description: Function to restore the previous owner of selected databases
-- after a change primary command has failed to complete.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .cbApply()

  -- Initialise variables
  !selection   = !this.elems.val

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  else
    !answer = !!alert.confirm(|Continue only if the Daemon is down; the Location is Offline; or recovering from $
a Change Primary for own transaction dB. In all other circumstances wait for the built-in recovery. Continue?|)
    if (!answer.boolean()) then
      -- Continue
    else
      return
    endif
  endif

  -- Process the selection list
  do !index values !selection

    -- Get the DBREF
    !dbRef       = !this.elems.rText[!index].dbRef()
    handle any
      -- Bad Dbref
      skip
    endhandle
    if(!this.state EQ |DB|)then
      -- Restore the previous owner
      !command     = |PREVOWNER |+ !dbRef.name.substring(3)
    elseif(!this.state EQ |LOC|)then
      -- Restore the previous owner
      !command     = 'PREVOWNER SYSTEM |'+ !dbRef.locId + '|'
    endif
    call !!admCommand(!command)
    handle any

      -- Raise error (non-specific)
     -- !!messageFile.error(141, 716,  !dbRef.name.substring(3))
     -- ##
     !!alert.error(|The was an error trying to restore the Previous owner of this Element|)
      handle (06, 716)
        -- Dummy handle
      endhandle

    endhandle

  enddo

  if(!this.state EQ |DB|)then

    -- Get new transient database list
    !this.dbSet()

    -- Update forms
    !!adminElem.update('DB')
    if( defined(!!admDb) ) then
      if( !!admDb.shown() ) then
        !!admDb.update()
      endif
    endif
    !this.dbList()

  elseif(!this.state EQ |LOC|)then

    -- Get new transient database list
    !this.locSet()

    -- Update forms
    !!adminElem.update('LOC')
    !this.locList()

  endif

endmethod
-- End of method definition for .cbApply()
-- End of Method definition
------------------------------------------------------------------------
--
-- Method: .dbGet()
--
-- Description: Function to return an array of transient database in the current
-- project.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbGet() is ARRAY

  -- Return the value
  return !this.dbArray

endmethod
-- End of method definition for .dbGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .dbList()
--
-- Description: Function to control the contents of the transient database list
-- gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbList()

  -- Initialise variables
  !databases              = !this.dbGet()

  -- Save state of sort and filter
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.elems.clear()

  -- Sort databases
  !displayList            = !!adminFilterSort(!databases, !this.sort, !this.filter)

  -- Display the database list
  !!adminDbTxtList(!displayList, !this.elems, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), object DBREF())

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
-- Method: .dbSet()
--
-- Description: Function to collect a list of transient database in the current
-- project.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbSet()

  -- Initialise variables
  !curPos     = !!ce
  !this.dbArray.clear()

  -- Get transient databases
  !!ce        = !!dbrAdminGetWorld('TEAM')
  !clause     = 'locrf eq nulref'
  !dbLocElem  = !!collectAllFor('DBLOC', !clause, !!ce)
  !ownerBlock = object BLOCK(|!dbLocElem[!evalIndex].owner|)
  !databases  = !dbLocElem.evaluate(!ownerBlock)

  -- Discard database that are foreign
  do !db values !databases
    skip if (!db.foreign neq |LOCAL|)
    !this.dbArray.append(!db)
  enddo

  -- Restore database position
  !!ce        = !curPos
endmethod
-- End of method definition for .dbSet()
------------------------------------------------------------------------
--
-- Method: .locSet()
--
-- Description: Function to get all the Transient Locations
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locSet()

  -- Assign sort gadget values
  !!admDbSortGadg(!!glbPrOwn.sort)

  -- Assign filter gadget values
  !!glbPrOwn.filter.val  = |*|

  -- Initialise variables
  !curPos     = !!ce
  !this.locArray.clear()

  -- Get transient Locations
  !!ce        = !!dbrAdminGetWorld('LOC')
  !allLocs = !!ce.mem[2].mem
  !transLoc = ARRAY()
  do !i values !allLocs
    -- condition for Transient Location
    if(!i.prmRf.unset() AND !i.prvRf.set())then
      !transLoc.append(!i)
    endif
  enddo

  !this.locArray = !transLoc

  -- Restore database position
  !!ce        = !curPos

endmethod
-- End of method definition for .locSet()
------------------------------------------------------------------------
--
-- Method: .locGet()
--
-- Description: Function to get all the Transient Locations
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locGet() is ARRAY

  return !this.locArray

endmethod
-- End of method definition for .locGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .locList()
--
-- Description: Function to control the contents of the transient location list
-- gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locList()

  -- Initialise variables
  !locations              = !this.locGet()

  -- Save state of sort and filter
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.elems.clear()

  -- Sort databases
  !displayList            = !!adminFilterSort(!locations, !this.sort, !this.filter)

  -- Display the database list
  !!adminLocnTxtList(!locations, !this.elems)

endmethod
-- End of method definition for .locList()
------------------------------------------------------------------------
--
-- Method: .type()
--
-- Description: Method to switch between elements!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .type()
  if(!this.type.selection(|rtext|) EQ !this.state)then
    -- No change required!
    return
  endif
  if(!this.type.selection(|rtext|) EQ |DB|)then
    !this.dbList()
    !this.state = |DB|
    -- Assign sort gadget values
    !!admDbSortGadg(!!glbPrOwn.sort)
    -- Assign filter gadget values
    !!glbPrOwn.filter.val  = |*|
  endif
  if(!this.type.selection(|rtext|) EQ |LOC|)then
    !this.locList()
    !this.state = |LOC|
    -- Assign sort gadget values
    !!admLocSortGadg(!!glbPrOwn.sort)
    -- Assign filter gadget values
    !!glbPrOwn.filter.val  = |*|
  endif
endmethod
-- End of method definition for .type()
