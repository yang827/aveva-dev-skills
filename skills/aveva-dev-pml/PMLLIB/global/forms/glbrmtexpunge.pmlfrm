-- End of method definition for .userProcessList()
------------------------------------------------------------------------
--
--Method: .getForLocs()
--
-- Description: Get all the locations this location can administer:-
-- i.e. all sites this site can administer (plus always itself)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--   Boolean      Are there any valid locations
--
------------------------------------------------------------------------
define method .getForLocs() is BOOLEAN

  -- initialise Location Gadget
  !this.forLocn.clear()
  !result = false

  -- Get a list of locations which are on-line
  !clause = |ICONN EQ 1|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  do !i values !resultingLocs
    -- The rules are ;-
    -- 1. Hub or Sat - All locations that the location is administering. (Even itself)
    if (!i.prmRf eq !this.location or !i eq !this.location) then
      !textOfLocs.append(!i.locId)
    endif
  enddo

  !this.forLocn.dText = !textOfLocs

  -- Only make active if expunging the system dB
  if (!!glbRmtExpunge.type.selection('rtext') eq 'SYSTEM') then
    !this.forLocn.active = true
  else
    !this.forLocn.active = false
  endif

  -- We need some on line locations to do a remote expunge for
  if (!textOfLocs.size() eq 0) then
    !this.forLocn.active = false
    return !result
  endif

  !result = true
  return !result

endmethod
-- End of method definition for .getForLocs()
