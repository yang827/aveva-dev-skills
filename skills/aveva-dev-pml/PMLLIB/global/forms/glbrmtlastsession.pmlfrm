--
--
-- Description:
-- Form to display information on all databases in specified location and selected DBs returns Lastsession with date and description.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed
--  clear()                          -                   Clear report data
--  filt()                           -                   Take the user input filter and remember the value
--  getDbs(LOCATION)                 -                   While interrogate the local SYS db that is open to
--  getDbsList()                     -                   To get the sys DBS list
--  glbRmtLastSession()              -                   Constructor method
--  init()                           -                   Method to initialise the data for the DB List form
--  loadSettings()                   -                   Load settings
--  remListSelect()                  -                   Returns the results in Report list gadget
--  repHeader()                      -                   To set the Header for report list gadget
--  reportGen(STRING)                -                   Compose reports in file.
--  save()                           -                   Save message to the selected location
--  saveFolder()                     STRING              Return last used folder name for save file
--  saveSettings()                   -                   Save settings
--  setHeader()                      -                   To set the Header for DBS list gadget
--  sort()                           -                   Take the user input sort and remember the value
--
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle any
endhandle

setup form !!glbRmtLastSession resize

  !this.formTitle     = 'Remote Last Session'
  !this.iconTitle     = 'DB List'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  paragraph .locquer   at xmax ycen text 'Location'       width 8
  option    .location  at xmax ymin call |!this.cbLocs()| width 6
  button    .fileOut   at xmax+2 ymin  |Save Report|    call |!this.save()|

  list      .dbs       at x 0.5 ymax0.5 anchor left+bottom+top multiple columns width 35 length 17
  list      .report    at xmax+0.5 ymin anchor all                      columns width 30 length 17

  option    .sort      at xmin.dbs ymax.dbs+0.2  anchor left+bottom  |Sort by | call |!this.sort()| width 7
  text      .filter    at xmax+0.5 ymin          anchor left+bottom  |Filter |  call |!this.filt()| width 8 STRING
  button    .testComms at xmax form-size ymin    anchor bottom+right |Test Communications... | call |show !!glbping|
  button    .clear     at xmax form-size ymin.fileOut anchor top+right |Clear| call |!this.clear()|

  button    .apply     at xmin.dbs ymax.sort+0.2 anchor left+bottom |Apply| call |!this.remListSelect()|
  paragraph .status    at xmax.apply+0.5 ymin    anchor left+bottom width 50 line 2
  button    .dismiss   at xmax form-size ymin    anchor bottom+right |Dismiss| CANCEL

  -- Member Definitions
  member .dbList      is DBLISTOBJ
  member .dbNames     is ARRAY
  member .dbShow      is ARRAY
  member .initAdmdLoc is DBREF
  member .locList     is ARRAY
  member .dbSort      is STRING
  member .dbrefs      is ARRAY
  member .dbFilter    is STRING
  member .repheading  is ARRAY
  -- Report data array
  member .repData     is ARRAY
  -- Folder for save message file
  member .saveFolder  is STRING

exit

-- End of form definition for !!glbRmtLastSession
----------------------------------------------------------------------
--
-- Method:      .glbRmtLastSession()
--
-- Description: Constructor Method
--
-- Function Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbRmtLastSession()

  -- Initialise the variables
  !this.dbFilter       = |*|
  !this.dbSort         = |Name|
  !!admDbSortGadg(!this.sort)
  !this.callback      = '!this.init()'

  -- Load last used settings
  !this.loadSettings()
  handle any
    -- Ignore any error from the load
  endhandle

endmethod

-- End of method definition for .glbRmtLastSession()
-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the DB List form
-- depending on the display mode.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.setHeader()
  !this.repHeader()
  -- Set member to indicate current loc
  !this.initAdmdLoc    = !!adminApplic.getAdmContext()
  handle any
    -- some problem with finding locations
    !!alert.warning('Could not find a Global Location')
    !this.getDbs(object LOCATION())
    return
  endhandle

  !this.locList.clear()

  !project         = CURRENT PROJECT
  !allLocList      = !project.locations()
  !currentLocation = object LOCATION( !this.initAdmdLoc.name )
  -- make sure that the current location is first in the list
  !textOfLocs[1]   = !currentLocation.locId
  !this.locList[1] = !currentLocation

  -- initialise Location Gadget
  !this.location.clear()

  do !locName values !allLocList

    -- current location has already been placed at the top of the list
    skip if( !locName eq !currentLocation )
    -- skip uninitialised locations
    skip if( !locName.refno.dbref().linit.not() )
    -- skip offline locations
    skip if( !locName.refno.dbref().iconn.eq(0) )
    -- append location to the list
    -- make sure that the option gadget and the location list are in the same order
    !textOfLocs.append( !locName.locId )
    !this.locList.append(!locName)

  enddo

  !this.location.dText = !textOfLocs

  -- Get The DBs
  -- !this.getDbs(!currentLocation)
  -- !this.getDbsList()
  !this.cbLocs()
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getDbs(LOCATION)
--
-- Description: While interrogate the local SYS db that is open to
-- return a list of DBS
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--------------------------------------------------------------------------

define method .getDbs(!locName is LOCATION)

  !this.dbList = object DBLISTOBJ()
  if( !locName.set() ) then
    !this.dbList.setLocation(!locName)
  else
    !this.dbList.update()
  endif

  if (!!sessionSettings.showAs eq |DESC|) then
    -- show DB descriptions
    !dbDtext = !this.dbList.getDbDesc()
    !dbRtext = !this.dbList.getDbNames()
  else
    -- show DB names
    !dbDtext = !this.dbList.getDbNames()
    !dbRtext = !dbDtext
  endif
    !this.dbrefs = !dbDtext.evaluate(object BLOCK('!dbDtext[!evalindex].db()'))

endmethod
-- End of method definition for .getDbs(LOCATION)
-----------------------------------------------------------------------------
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
-----------------------------------------------------------------------------

define method .cbLocs()

  -- Save the previous db selection
  !dbSelection = !this.dbs.selection()

  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Initialise Variables
  !qryLocName  = !currLocation.name.after('/')
  !qryLocId    = !currLocation.locId

  -- Message will popped up when daemon is not connected for selected location.
  !this.status.val        = |Establishing connection to the location $!qryLocName ...|
  !this.status.visible    = true
  !this.status.refresh()

  -- To check the communication status
  var !unusedDaemonCheck COMMS $!qryLocId

  -- Error handled when the daemon fails for selected location.
  handle  (1,500) (1,501)
    !this.apply.active = false
    !this.status.val   = !!error.text.after(')').trim('L') + ' for $!qryLocName'
  elsehandle ANY
   !this.status.val   = !!error.text
   !this.apply.active = false
  elsehandle none
    !this.status.val     = ||
    !this.status.visible = false
    !this.apply.active   = true
  endhandle

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
  --!this.generateMdbs()
  !this.getDbs(!currLocation)
  handle any
  endhandle
  ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'
  !!admDbSortGadg(!this.sort)
  !this.sort.select('dText',!this.dbSort)
  !this.getDbsList()

  -- Attempt to reselect same dbs at new location
  do !db values !dbSelection
    !this.dbs.select('rtext', !db)
    handle any
    endhandle
  enddo

endmethod
-- End of method definition for .cbLocs()
-----------------------------------------------------------------------------
--
-- Method:      .remListSelect(GADGET,STRING)
--
-- Description: Returns the results in Report list gadget
--
-- Function Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------

define method .remListSelect()

  !repdtext   = ARRAY()
  !locnam     = !this.location.selection('rtext')
  !currLocNam = !this.locList[!this.location.val].refno.dbref().namn
  !usersel    = !this.dbs.selection('rtext')
  -- Getting the selected of dbs list
  !usersel    = !this.dbs.selection('rtext')
  !dbSelIndex = !this.dbs.val
  -- Sorting the selection list
  !dbsIndexSort = !dbSelIndex.sortedindices()
  !usersel.reindex(!dbsIndexSort)
  -- Evaluate the DBs
  !seldbs   = !usersel.evaluate(object BLOCK('!usersel[!evalindex].db()'))
  do !n from 1 to !seldbs.size()
    !dbName = !seldbs[!n].name
    if (!seldbs[!n].foreign eq 'FOREIGN' or !seldbs[!n].type eq 'TRAN') then
      !repdtext[!n][1] = !currLocNam
      !repdtext[!n][2] = !dbName
      !repdtext[!n][3] = '-'
      !repdtext[!n][4] = '-'
      !repdtext[!n][5] = '-'
      !repdtext[!n][6] = '-'
    else
      -- Collects Lastsession for specified dbs for specified location.
      var !repstr REMOTE $!locnam $!dbName LASTSESSION
      !repspl = !repstr.split(',')
      !repdtext[!n][1] = !currLocNam
      !repdtext[!n][2] = !dbName
      !repdtext[!n][3] = !repspl[1]
      !repdtext[!n][4] = !repspl[2]
      !repdtext[!n][5] = !repspl[3]
      !repdtext[!n][6] = !repspl[4]
    endif
  enddo
  !this.repData.appendArray(!repdtext)
  !this.report.setRows(!this.repData)

endmethod
-- End of method definition for .remListSelect(GADGET,STRING)
-------------------------------------------------------------------------------
--
-- Method:      .setHeader()
--
-- Description: To set the Header for DBS list gadget.
--
-- Function Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .setHeader()

  !validHeadings = !!admDisplayConfig.dbFormat.order
  -- To set the Header for DBs list gadget.
  do !i indices !validHeadings
    if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
      if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
        !heading[!i] = 'Type'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
        !heading[!i] = 'DB Number'
      else
        !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
      endif
    endif
  enddo
  !this.dbs.setHeadings(!heading)

endmethod
-- End of method definition for .setHeader()
---------------------------------------------------------------------------------
--
-- Method:      .getDbsList()
--
-- Description: To get the sys DBS list.
--
-- Function Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------------

define method .getDbsList()
  -- To get the DBs list with all details.
  !displayRefs = ARRAY()
  !displayRefs = !!adminFilterSort(!this.dbrefs, !this.sort, !this.filter)

  if(!!admControl.isValid('Global'))then
    !!adminDbTxtList(!displayRefs, !this.dbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),!!adminApplic.getAdmContext())
  else
    !!adminDbTxtList(!displayRefs, !this.dbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),object DBREF())
  endif
endmethod
-- End of method definition for .getDbsList()
---------------------------------------------------------------------------------
--
-- Method:      .sort()
--
-- Description: Take the user input sort and remember the value
--
-- Function Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

define method .sort()
  -- To sort the DBs list according to the selected option.
  !this.dbSort = !this.sort.selection('dText')
  !this.getDbsList()
endmethod
-- End of method definition for .sort()
---------------------------------------------------------------------------------
--
-- Method:      .filt()
--
-- Description: take the user input filter and remember the value
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------------

define method .filt()
  -- To filter the DBs list depends the text entered.
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.dbFilter     = !this.filter.val
  -- Refresh the form list
  !this.getDbsList()
endmethod
-- End of method definition for .filt()
---------------------------------------------------------------------------------
--
-- Method:      .repHeader()
--
-- Description: To set the Header for report list gadget.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------------------

define method .repHeader()

  !this.repheading[1] = 'Location'
  !this.repheading[2] = 'DB Name'
  !this.repheading[3] = 'Last Session No'
  !this.repheading[4] = 'Date & Time'
  !this.repheading[5] = ' User  '
  !this.repheading[6] = 'Description'
  -- To set the Header for report list gadget.
  !this.report.setHeadings(!this.repheading)

endmethod
-- End of method definition for repHeader()
--------------------------------------------------------------------------------------
--
-- Method:      .reportGen()
--
-- Description: Compose reports in file.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename to save report to
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------

define method .reportGen(!fileName is STRING)

  !filehead     = ARRAY()
  !currDateTime = object DATETIME()
  !project      = CURRENT PROJECT
  !projName     = !project.name()
  -- Get The currently Selected Location
  !currLocation = !this.locList[!this.location.val]
  !filehead[1]  = 'Project Name  : $!projName'
  !filehead[2]  = 'Date & Time   : $!currDateTime'
  !filehead[3]  = ''
  !filehead[4]  = '$!this.repheading[1]                          $!this.repheading[2]            $!this.repheading[3]      $!this.repheading[4]               $!this.repheading[5]                   $!this.repheading[6]'
  !tablelist    = !filehead
  !reportDtext  = !this.report.dText
  do !n indices !reportDtext
    !locnam[!n]     = !reportDtext[!n].part(1)
    !dbNam[!n]      = !reportDtext[!n].part(2)
    !lastsessNo[!n] = !reportDtext[!n].part(3)
    !datetime[!n]   = !reportDtext[!n].part(4) & ' ' & !reportDtext[!n].part(5) & ' ' & !reportDtext[!n].part(6) & ' ' & !reportDtext[!n].part(7)
    !usernam[!n]    = !reportDtext[!n].part(8)
    !desc[!n]       = !reportDtext[!n].after(!reportDtext[!n].part(8))
    -- Compose the result to specified file.
    var !results COMPOSE |$!locnam[$!n]| width 32 L spaces 2 |$!dbNam[$!n]| width 20 L spaces 6 |$!lastsessNo[$!n]| width 5 L spaces 6 |$!datetime[$!n]| width 20 L spaces 6 $
                         |$!usernam[$!n]| width 20 L spaces 6 |$!desc[$!n]| width 60 L
    !tablelist.appendArray(!results)
  enddo
  !file = object FILE(!fileName)
  !file.writeFile('overwrite',!tablelist)

  -- Update settings
 !this.saveFolder = !file.directory().string()
 !this.saveSettings()

endmethod
-- End of method definition for .reportGen()
--------------------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear report data
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------

define method .clear()

  !this.repData.clear()
  !this.report.clear()

endmethod
-- End of method definition for .reportGen()

------------------------------------------------------------------------
-- Method:      save
--
-- Description:
--   Save message to the selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .save()

  using namespace 'Aveva.Pdms.Presentation'

  -- Display file browser to select save file
  !browser = object PMLFILEBROWSER(|SAVE|)
  !seedFile = |*.txt|
  !docType = 'Text files (*.txt)|*.txt|Log files (*.log)|*.log|All files (*.*)|*.*'
  !browser.show(!this.saveFolder(), !seedFile, |Save Report|, false, !docType, 1)
  if (!browser.file() ne ||) then
    !this.reportGen(!browser.file())
  endif

endmethod

------------------------------------------------------------------------
-- Method:      saveSettings
--
-- Description:
--   Save settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .saveSettings()

  -- Save settings
  !file = object FILE(|%pdmsuser%/adm-remoteLastSessionSettings.pmldat|)
  !data = ARRAY()
  !data.append(|saveFolder | & !this.saveFolder)
  !file.writeFile(|Overwrite|, !data)

endmethod

------------------------------------------------------------------------
-- Method:      loadSettings
--
-- Description:
--   Load settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .loadSettings()

  -- Load settings
  !file = object FILE(|%pdmsuser%/adm-remoteLastSessionSettings.pmldat|)
  if (!file.exists()) then
    do !line values !file.readFile()
      if (!line.substring(1, 11) eq |saveFolder |) then
        !this.saveFolder = !line.after(|saveFolder |)
      endif
    enddo
  endif

endmethod

------------------------------------------------------------------------
-- Method:      saveFolder
--
-- Description:
--   Return last used folder name for save file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Folder name
------------------------------------------------------------------------
define method .saveFolder() is STRING

  -- Return last used folder if available else pdms defaults
  !folder = |%pdmsuser%|
  if (!this.saveFolder.set()) then
    if (!this.saveFolder.trim() ne ||) then
      !testFolder = object FILE(!this.saveFolder)
      !testExists = !testFolder.exists()
      handle any
      elsehandle none
        if (!testExists) then
          !folder = !this.saveFolder
        endif
      endhandle
    endif
  endif
  return !folder

endmethod
