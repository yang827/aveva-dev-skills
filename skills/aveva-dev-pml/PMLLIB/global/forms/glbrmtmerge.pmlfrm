--
-- File:            glbrmtmerge.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          C.J.Fellows
-- Created:         Tues Mar 24 1998
--
--
-- Description: Remote Merge changes form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allChange()                      -                   Apply merge selection
--  apply()                          -                   Apply selection to Merge Changes
--  cbAtLocn()                       -                   Callback on location gadget
--  changeActive(BOOLEAN)            -                   Maintain the gadget activity
--  dateSession(BOOLEAN)             -                   Maintain session number from session time
--  dbListInit()                     -                   Initialise the Database List gadget based on the current display mode.
--  dbListSelect()                   -                   display information about the database selected in the Database List form
--  getForLocs()                     BOOLEAN             Get all the locations this primary dB location can administer
--  getPossLocs()                    BOOLEAN             Get all the locations this site can merge
--  glbRmtMerge()                    -                   Constructor
--  ifTime(BOOLEAN)                  -                   Maintain the Since Gadgets
--  init()                           -                   form initialisation
--  mergeAction()                    -                   Output a summary of the selected action
--  mergeType()                      -                   Apply merge selection
--  notStamped()                     -                   Check for db not stamped
--  qrySessComment()                 -                   Show a form with the session comment on
--  selectedChange()                 -                   Apply merge selection
--  sessCount(BOOLEAN,REAL)          -                   Session Plus/Minus counter
--  sessionDate(BOOLEAN)             -                   Maintain session time from session number
--  stampActive()                    -                   Set stamp gadgets active status
--  stampData(GADGET)                -                   Get data for selected stamp
--  stampList(GADGET)                -                   Populate the stamp list gadget
--  zero(STRING)                     STRING              Tests if a hour or minute value requires a leading zero
--
------------------------------------------------------------------------

setup form !!glbRmtMerge

  !this.formTitle     = 'Remote Merge Changes'
  !this.iconTitle     = 'RmtMerge'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.20 $ '

  -- Body of form definition

  -- Available Databases
  member .dbObjects is ARRAY
  member .currentDb is DB
  member .lastSession is DBSESS
  member .currentSession is DBSESS
  member .currentNumber is REAL

  -- Was - or + button pressed or direct number input (0 = Minus, 1 = Plus, 2 = Number input)
  member .plusMinusNum  is REAL

 --The at location i.e. the location of the databases to be merged
  member .location is DBREF

  -- Array of possible locations
  member .locList is ARRAY

  -- Stamps
  member .stampRefs is ARRAY

  -- Timed merge
  member .timed      is BOOLEAN
  member .mergeTime  is DATETIME

  path down
  vdist 0.1

  option .atLocn at x 1 y 0.1 |Primary Database Location :- | call |!this.cbAtLocn()| width 6
  option .forLocn at xmax+1 ymin |for Location :- | call |!this.mergeAction()| width 6

  -- What to merge?
  option .mergeType at x 1 ymax width 22

  -- Database being merged
  para   .dbName at xmax+2 ymin width 40

  -- All databases
  frame .databases 'Available databases' at x0 ymax
    list .dbs at xmin+1 ymax call |!this.dbListSelect()| width 25 length 34
  exit

  path right

  -- Changes
  frame .changes ' Changes ' at xmax+0.6

    -- Changes type
    toggle .allChange at x7 ymax+0.1 'All'
    toggle .changeAfter       'After'
    toggle .changeBefore      'Up To'

    path down

    -- Changes After
    frame .since 'Changes After' at x1 ymax+0.35

      rgroup .sinceType '' at xmin+1 ymax-0.1 Horizontal
        add tag 'TimeDate'  select 'TIME'
        add tag 'Session'  select 'SESS'
        add tag 'Stamp '  select 'STAMP'
      exit

      para     .tim   at x1 ymax+0.4  text       'Time: HH:MM         '
      text     .time  at xmax.tim+0.5  ymin  width 5  string
      para     .dat   at x1 ymin+1  text     'Date: DD Mon Year   '
      text     .date  at xmax.dat+0.5  ymin  width 11  string

      para     .sessNu   at x1  ymax text    'Session Number:     '
      text     .sessNum  at xmax.sessNu+3.5  ymin  width 5  is REAL
      button   .minus '-' at xmin.sessNum-3 ymin.sessNum
      button   .plus  '+' at xmin.sessNum+7 ymin.sessNum
      para     .sessUser at x1  ymax  text   'Session User:      '
      para     .stampA at xmin ymax text 'Stamps     Sort By '
      option   .sortA  at xmax ymin width 11
      list     .stampAfter at xmin.stampA ymax SINGLE width 30 length 3
    exit

    -- Changes before
    frame .before 'Changes Up To'
      rgroup .beforeType '' at xmin+1 ymax-0.1 Horizontal
        add tag 'TimeDate'  select 'TIME'
        add tag 'Session'  select 'SESS'
        add tag 'Stamp '  select 'STAMP'
      exit

      para     .bTim   at x1 ymax+0.4  text       'Time: HH:MM        '
      text     .bTime  at xmax.bTim+0.5  ymin  width 5  string
      para     .bDat   at x1 ymin+1  text     'Date: DD Mon Year  '
      text     .bDate  at xmax.bDat+0.5  ymin  width 11  string

      para     .bSessNu    at x1  ymax text    'Session Number:    '
      text     .bSessNum   at xmax.bSessNu+3.5  ymin  width 5  is REAL
      button   .bMinus '-' at xmin.bSessNum-3 ymin.bSessNum
      button   .bPlus  '+' at xmin.bSessNum+7 ymin.bSessNum
      para     .bSessUser  at x1 ymax  text   'Session User:      '
      para     .stampB at xmin ymax text 'Stamps     Sort By '
      option   .sortB  at xmax ymin width 11
      list     .stampBefore at xmin.stampB ymax SINGLE width 30 length 3
    exit

  exit

  -- Report
  frame .summary ' Action ' at xmin.databases ymax.databases+0.1 width 68 height 1
    paragraph .action1 at x1 ymax-0.2 width 66 lines 1
    para .action2 at xmin ymax-0.5 width 66 lines 1
    para .action3 at xmin ymax-0.5 width 66 lines 1
  exit

  path down
  button .apply  at ymax+0.4 |Apply| call |!this.apply()|
  path right
  hdist 1
  button .rebuild  |Rebuild list| width 10 height 1
  button .more  'Database Sessions...'
  button .timeDate |Timed Merge...| form !!timeDate width 12 height 1
  button .dismiss at xmax form-size ymin.apply |Dismiss| OK

exit
-- End of form definition for !!glbRmtMerge

------------------------------------------------------------------------
--
-- Method:      !glbRmtMerge()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .glbRmtMerge()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Database list
  !this.dbs.callback       = '!this.dbListSelect()'

  -- Merge type options
  !dtext.append('All Project databases')
  !dtext.append('System database')
  !dtext.append('Single database')
  !rtext.append('ALL')
  !rtext.append('SYS')
  !rtext.append('DB')
  !this.mergeType.dtext = !dtext
  !this.mergeType.rtext = !rtext
  !this.mergeType.callback    = '!this.mergeType()'

  -- Change type
  !this.allChange.callback    = '!this.allChange()'
  !this.changeAfter.callback  = '!this.selectedChange()'
  !this.changeBefore.callback = '!this.selectedChange()'

  -- Database sessions
  !this.more.callback         = '!this.qrySessComment()'

  -- Change after
  !this.sinceType.callback = '!this.ifTime(TRUE) !this.notStamped()'
  !this.time.callback      = '!this.dateSession(TRUE)'
  !this.date.callback      = '!this.dateSession(TRUE)'
  !this.sessNum.callback   = '!this.sessionDate(TRUE)'
  !this.minus.callback     = '!this.sessCount(TRUE,0)'
  !this.plus.callback      = '!this.sessCount(TRUE,1)'

  -- Change before
  !this.beforeType.callback = '!this.ifTime(FALSE) !this.notStamped()'
  !this.bTime.callback      = '!this.dateSession(FALSE)'
  !this.bDate.callback      = '!this.dateSession(FALSE)'
  !this.bSessNum.callback   = '!this.sessionDate(FALSE)'
  !this.bMinus.callback     = '!this.sessCount(FALSE,0)'
  !this.bPlus.callback      = '!this.sessCount(FALSE,1)'

  -- Stamp sort options
  !!admStampSortGadg(!this.sortA,'LONG')
  !!admStampSortGadg(!this.sortB,'LONG')
  !this.sortA.callback = '!!admStampSort(!this.stampRefs,!this.sortA,!this.stampAfter)'
  !this.sortB.callback = '!!admStampSort(!this.stampRefs,!this.sortB,!this.stampBefore)'

  -- Stamp lists selection
  !this.stampAfter.callback = '!this.stampData(!this.stampAfter)'
  !this.stampBefore.callback = '!this.stampData(!this.stampBefore)'

  -- Action gadgets
  !this.apply.callback     = '!this.apply()'
  !this.rebuild.callback   = '!this.dbListInit()'

endmethod
-- End of method definition for .glbRmtMerge()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: form initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Warn the user about need to synchronise
  -- This is not essential but anything after the latest session will be ignored
  if (!this.shown().not()) then
    !!alert.warning(|Remote Merge will work if dB has not been synchronised, $
but it is recommended that this is done, or else sessions after the latest $
known session will be ignored.|)
  endif

  -- Get possible locations
  if (!this.getPossLocs().not()) then
    !this.forLocn.active = false
    return
  else
    -- See if the selected location can itself administer any other locations
    !this.getForLocs()
  endif

  !this.sinceType.select( 'SESS' )
  !this.beforeType.select( 'SESS' )

  !this.mergeType.select('rtext','DB')
  !this.mergeType()
  !this.changeAfter.val = TRUE

  !this.plusMinusNum = 2

  -- Select the current location
  !currentLoc    = curloc
  !this.location = !currentLoc
  !this.atLocn.select('RTEXT',!currentLoc.locId)
  !this.cbAtLocn()
  -- Initialise List of DBs
  !this.dbListInit()

  -- Set changes after & before gadgets
  !this.ifTime(TRUE)
  !this.ifTime(FALSE)

  !this.timed = FALSE

  !this.selectedChange()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply selection to Remote Merge Changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .apply()

  !atLoc = !this.location.locId

  -- Put in a test do see if the date and time are set.
  !timeValue = !this.time.val
  !dateValue = !this.date.val
  !selection = !this.dbs.selection()
  var !sessDnum SESSION ON $!timeValue $!dateValue $!selection
  handle ANY
    -- Fix for defect 1988 to handle the fact that the time and date value may be unset
    !!alert.error('The time, date or database is invalid. Any propagating databases must be allocated to both locations.')
    !this.timed = FALSE
    return
  endhandle

  if (!this.timed) then
    !mergeTime = !this.mergeTime.hour().string() & ':' & !this.mergeTime.minute().string() & ' ' & !this.mergeTime.date().string() & ' ' & !this.mergeTime.monthString() & ' ' & !this.mergeTime.year().string()
  endif

  if( !this.mergeType.selection() eq 'SYS' ) then
    -- Merge System database
    if (!this.forLocn.active.not()) then
      !!alert.message(!atLoc & ' System dB is not Primary at ' & !atLoc)
      !this.timed = FALSE
      return
    endif

    !forLoc = !this.forLocn.selection('rtext')
    if (!atLoc neq !forLoc) then
      if (!this.timed)then
        !command = |REMOTE '$!atLoc' MERGE CHANGES SYSTEM FOR '$!forLoc' AT $!mergeTime|
      else
        !command = |REMOTE '$!atLoc' MERGE CHANGES SYSTEM FOR '$!forLoc'|
      endif
    else
      if (!this.timed)then
        !command = |REMOTE '$!atLoc' MERGE CHANGES SYSTEM AT $!mergeTime|
      else
        !command = |REMOTE '$!atLoc' MERGE CHANGES SYSTEM|
      endif
    endif
    -- *** COMMAND LINE SYNTAX ***
    call !!admCommand(!command)
    handle any
      !!alert.error( !!error.text)
      !this.timed = FALSE
      return
    endhandle
    -- When to use Remote merge SYSTEM :-
    -- If a location is administering locations
    -- then the location will have the primary system dB for those locations
    -- so do we want to remote merge them? I guess NOT because
    -- I would expect him to use
    -- ADMIN LOC AT 'other' then normal MERGE CHANGES SYSTEM

    -- 1. The hub or satellite will use normal merge on locations that it administers - OK
    -- 2. The hub will use remote merge on locations that it does NOT administer - OK
    -- 3. If the hub wishes to merge the system db of a location that is administered by another location
    --    he needs to use  REMOTE '$!atLoc' MERGE CHANGES SYSTEM FOR '$!otherLoc'  - OK
    -- 4. A satellite will use normal merge on locations that it administers (As 1.) - OK
    -- 5. A satellite CAN NOT use remote merge on locations that it does NOT administer. - OK

  else

    !afterSession  = ( !this.sinceType.selection() eq 'SESS' ) and !this.allChange.val.not()
    !beforeSession = ( !this.beforeType.selection() eq 'SESS' ) and !this.allChange.val.not()

    -- Merge selected DB or all available Project DBs
    if( !this.allChange.val ) then
      !changeString = ''
    else
      if( !this.changeAfter.val ) then
        if( !this.sinceType.selection() eq 'SESS' ) then
          !changeString = 'AFTER SESSION' + !this.sessNum.val.string()
        elseif(!this.sinceType.selection().eq('STAMP')) then
          !changeString = 'AFTER STAMP ' + !this.stampAfter.selection('rtext').dbRef().flnm
        else
          !changeString = 'AFTER ' + !this.time.val + ' ' + !this.date.val
        endif
      else
        !changeString = ''
      endif
      if( !this.changeBefore.val ) then
        if( !this.beforeType.selection() eq 'SESS' ) then
          !changeString = !changeString + ' BEFORE SESSION' + !this.bSessNum.val.string()
        elseif(!this.beforeType.selection().eq('STAMP')) then
          !changeString = !changeString & ' BEFORE STAMP ' + !this.stampBefore.selection('rtext').dbRef().flnm
        else
          !changeString = !changeString + ' BEFORE ' + !this.bTime.val + ' ' + !this.bDate.val
        endif
      endif
    endif

    -- *** COMMAND LINE SYNTAX ***
    if( !this.mergeType.selection() eq 'DB' ) then
      !selection = !this.dbs.selection()
      -- write |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString|
      if (!this.timed)then
        !command = |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString AT $!mergeTime |
      else
        !command = |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString|
      endif
      call !!admCommand(!command)
      handle any
        !!alert.error( !!error.text)
        !this.timed = FALSE
        return
      endhandle
    else
      if( !afterSession or !beforeSession ) then
        !!alert.error('You cannot merge changes for all project databases using session numbers. Please select dates for sessions to be merged')
        !this.timed = FALSE
        return
      endif
      -- Cannot do a remote merge changes project as you can for a normal merge so we need to do a loop
      -- WAS call !!admCommand(|REMOTE '$!atLoc' MERGE CHANGES PROJECT $!changeString|)
      !countErrors = 0
      do !i indices !this.dbs.rtext
        !selection = !this.dbs.rtext[!i]
        -- write |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString|
        if (!this.timed)then
          !command = |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString AT $!mergeTime |
        else
          !command = |REMOTE '$!atLoc' MERGE CHANGES $!selection $!changeString|
        endif
        call !!admCommand(!command)
        handle any
          !countErrors = !countErrors + 1
          !!alert.error( !!error.text)
          if (!countErrors eq 5) then
            !!alert.message('5 errors have occurred after attempting ' & !i & ' of ' !this.dbs.rtext.size() ' dBs. All project dB merge aborted.')
            !this.timed = FALSE
            return
          endif
        endhandle
      enddo
    endif

   -- Refresh session comment form
   if (Defined (!!admSessComment)) then
      call !!refreshDependent (!!admSessComment)
   endif

    !this.timed = FALSE

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      dbListInit
--
-- Description: Initialise the Database List gadget based on the current display mode.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbListInit()

  !project   = CURRENT PROJECT
  !locations = !project.locations()
  !this.dbObjects.clear()
  !dbs = ARRAY()

  if(!this.location.set())then
    -- find location in the list and get its databases
    !curLocationRef   = !this.location.string()
    do !loc values !locations
      skip if( !loc.refNo neq !curLocationRef )
      -- found the current location, now get its databases
      !dbs = !loc.dbList()
      break
    enddo
  else
    --How did they get this far?
    return
  endif

  !dbList = ARRAY()
  !replList = ARRAY()
  do !database values !dbs
    !dbRef = !database.refNo.dbRef()
    -- Remove non-primary dbs and Foreign dbs from list
    skip if( !database.foreign eq 'FOREIGN' )
    -- Remove parent extract dbs from list
    skip if( !dbRef.extCls.empty().not() )
    -- Check for secondary databases
    -- Relies on knowledge of Admin DB
    skip if( !dbRef.mem[1].locRf neq !this.location )
    -- got a location - add it to the lists
    !this.dbObjects.append(!database)
    -- add to list replacement text
    !databaseName = !database.name
    !replList.append( !databaseName )
    -- add to list display text
    if (!!sessionSettings.showAs eq |DESC|) then
      !data = !database.description
      if (!data.unset() or !data.empty()) then
        !data = !databaseName
      else
        !data = !data.trim()
      endif
    else
      !data = !databaseName
    endif
    !dbList.append( !data )
  enddo

  -- Clear the current list of databases
  !this.dbs.clear()

  --If No DBs At Location disable the Apply Button
  if(!dbList.empty())then
    !this.apply.active = FALSE
    !dbList.append(|No User Dbs|)
    !this.dbs.dtext = !dbList
  else
    !this.apply.active = TRUE
    -- Sort the list of teams and place them in the list gadget
    !sortOrder = !dbList.sortedIndices()
    !this.dbObjects.reIndex( !sortOrder )
    !dbDispList = ARRAY()
    !dbReplList = ARRAY()

    do !i values !sortOrder
      !dbDispList.append(!dbList[!i])
      !dbReplList.append(!replList[!i])
    enddo

    !this.dbs.dtext = !dbDispList
    !this.dbs.rtext = !dbReplList

    -- Call function to display selected users information
    !this.dbListSelect()
  endif

endmethod
-- End of method definition for .dbListInit()

------------------------------------------------------------------------
--
-- Method:      dbListSelect
--
-- Description: display information about the database selected in the Database List form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget from which DB is selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbListSelect()

  -- Get the current selected database object
  if( !this.mergeType.selection() eq 'ALL' ) then
    !this.dbName.val = 'ALL'
  elseif( !this.mergeType.selection() eq 'SYS' ) then
    !this.dbName.val = 'SYSTEM'
  else
    !this.dbName.val = '=  ' & !this.dbs.selection()
  endif

  -- Find Highest Session number
  !lastSess = !this.dbObjects[ !this.dbs.val ].lastSession()
  handle any
    !!alert.error('Problem with selected database: ' + !!error.text)
    return
  endhandle
  !this.bSessNum.val = !lastSess.number
  !this.sessNum.val  = 1

  -- Maintain the session comments form
  if (defined(!!admSessComment)) then
    if (!!admSessComment.shown()) then
      !!admSessComment.initialise()
    endif
  endif

  -- Set changes gadgets
  !this.ifTime(TRUE)
  !this.ifTime(FALSE)

  -- Check for db not stamped
  !this.notStamped()

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .dbListSelect()

------------------------------------------------------------------------
--
-- Method:      mergeType
--
-- Description: Apply merge selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mergeType()

  !mode = !this.mergeType.selection()

  if ( !mode eq 'SYS' ) then

    !this.allChange.active    = FALSE
    !this.changeAfter.active  = FALSE
    !this.changeBefore.active = FALSE
    !this.sinceType.select( 'TIME' )
    !this.beforeType.select( 'TIME' )
    !this.ifTime(TRUE)
    !this.ifTime(FALSE)
    !this.allChange()
    !this.dbs.active         = FALSE
    !this.more.active        = FALSE
    !this.dbName.val         = 'SYSTEM'
    !this.dbName.active      = FALSE
    -- Only if there are some valid system dBs
    if (!this.forLocn.rtext.size().neq(0)) then
      !this.forLocn.active     = TRUE
    else
      !this.forLocn.active     = FALSE
    endif

    -- Child form only applies to Single project database
    !!admSessComment.hide()
    handle( 2,751)
    endhandle

  elseif( !mode eq 'ALL' ) then

    !this.allChange.active    = TRUE
    !this.changeAfter.active  = TRUE
    !this.changeBefore.active = TRUE
    !this.sinceType.select( 'TIME' )
    !this.beforeType.select( 'TIME' )
    if( !this.allChange.val ) then
      !this.allChange()
    else
      !this.selectedChange()
    endif
    !this.dbs.active         = FALSE
    !this.more.active        = FALSE
    !this.dbName.val         = 'ALL'
    !this.dbName.active      = FALSE
    !this.forLocn.active     = FALSE

    -- Child form only applies to Single project database
    !!admSessComment.hide()
    handle( 2,751)
    endhandle

  elseif( !mode eq 'DB' ) then

    -- Get the current selected database object
    !this.dbName.val = '=  ' & !this.dbs.selection()
    !this.allChange.active    = TRUE
    !this.changeAfter.active  = TRUE
    !this.changeBefore.active = TRUE
    if( !this.allChange.val ) then
      !this.allChange()
      !this.sinceType.active   = false
      !this.beforeType.active  = false
    else
      !this.selectedChange()
    endif
    !this.dbs.active         = TRUE
    !this.more.active        = TRUE
    !this.dbName.active      = TRUE
    !this.forLocn.active     = FALSE

  endif

  -- Set stamp gadget active status
  !this.stampActive()

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .mergeType()

------------------------------------------------------------------------
--
-- Method:      allChange
--
-- Description: Apply merge selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .allChange()

  !this.allChange.val    = TRUE
  !this.changeBefore.val = FALSE
  !this.changeAfter.val  = FALSE

  !this.sinceType.active  = FALSE
  !this.time.active       = FALSE
  !this.date.active       = FALSE
  !this.sessNum.active    = FALSE
  !this.plus.active       = FALSE
  !this.minus.active      = FALSE

  !this.beforeType.active = FALSE
  !this.bTime.active      = FALSE
  !this.bDate.active      = FALSE
  !this.bSessNum.active   = FALSE
  !this.bPlus.active      = FALSE
  !this.bMinus.active     = FALSE

  -- Stamp gadgets active status
  !this.stampActive()

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .allChange()

------------------------------------------------------------------------
--
-- Method:      selectedChange
--
-- Description: Apply merge selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedChange()

  if( !this.changeAfter.val.not() and !this.changeBefore.val.not() ) then
    !this.allChange.val = TRUE
    !this.allChange()
    return
  endif

  !this.allChange.val = FALSE

  !this.sinceType.active  = !this.changeAfter.val
  if( !this.changeAfter.val ) then
    -- Set gadget activity according sinceType setting
    !this.changeActive( TRUE )
    !this.ifTime(TRUE)
  else
    !this.time.active    = FALSE
    !this.date.active    = FALSE
    !this.sessNum.active = FALSE
    !this.plus.active    = FALSE
    !this.minus.active   = FALSE
  endif

  !this.beforeType.active = !this.changeBefore.val
  if( !this.changeBefore.val ) then
    -- Set gadget activity according beforeType setting
    !this.changeActive( FALSE )
    !this.ifTime(FALSE)
  else
    !this.bTime.active    = FALSE
    !this.bDate.active    = FALSE
    !this.bSessNum.active = FALSE
    !this.bPlus.active    = FALSE
    !this.bMinus.active   = FALSE
  endif

  -- Stamp gadgets active status
  !this.stampActive()

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .selectedChange()

------------------------------------------------------------------------
--
-- Method:      sessCount
--
-- Description: Session Plus/Minus counter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN   Flag for AFTER/BEFORE gadgets (True for AFTER)
--    2   R      REAL      Plus/Minus selection
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .sessCount( !aft is BOOLEAN, !select is REAL)

  -- remember which button was pressed
  !this.plusMinusNum = !select

  if( !aft ) then
    -- Callback on AFTER gadgets
    if (!select eq 1) then
      -- Adding
      !nextSession = !this.currentDb.sessionRange(!this.sessNum.val, 2)
      !this.currentSession = !nextSession[!nextSession.size()]
      !this.currentNumber = !this.currentSession.number
      !this.sessNum.val = !this.currentNumber
    elseif( !this.sessNum.val gt 1 ) then
      -- Subtracting - don't go lower than 1
      !nextSession = !this.currentDb.sessionRange(!this.sessNum.val, -2)
      !this.currentSession = !nextSession[!nextSession.size()]
      !this.currentNumber = !this.currentSession.number
      !this.sessNum.val = !this.currentNumber
    endif

  else
    -- Callback on BEFORE gadgets
    if (!select eq 1) then
      -- Adding
      !nextSession = !this.currentDb.sessionRange(!this.bSessNum.val, 2)
      !this.currentSession = !nextSession[!nextSession.size()]
      !this.currentNumber = !this.currentSession.number
      !this.bSessNum.val = !this.currentNumber
    elseif( !this.bSessNum.val gt 1 ) then
      -- Subtracting - don't go lower than 1
      !nextSession = !this.currentDb.sessionRange(!this.bSessNum.val, -2)
      !this.currentSession = !nextSession[!nextSession.size()]
      !this.currentNumber = !this.currentSession.number
      !this.bSessNum.val = !this.currentNumber
    endif
  endif

  !this.sessionDate(!aft)

endmethod
-- End of method definition for .sessCount( BOOLEAN, REAL)

------------------------------------------------------------------------
--
-- Method:      ifTime
--
-- Description: Maintain the Since Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN   Flag for AFTER/BEFORE (True for AFTER)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ifTime(!aft is BOOLEAN)

  !this.changeActive( !aft )

  if( !aft ) then
    -- AFTER gadgets
    if (!this.sinceType.selection() eq 'TIME') then
      !this.dateSession(TRUE)
      !this.stampAfter.clear()
    elseif (!this.sinceType.selection() eq 'SESS') then
      !this.sessionDate(TRUE)
      !this.stampAfter.clear()
    endif

  else
    -- BEFORE gadgets
    if (!this.beforeType.selection() eq 'TIME') then
      !this.dateSession(FALSE)
      !this.stampBefore.clear()
    elseif (!this.beforeType.selection() eq 'SESS') then
      !this.sessionDate(FALSE)
      !this.stampBefore.clear()
    endif
  endif

  -- For after stamp
  if (!aft and !this.sinceType.selection().eq('STAMP')) then

    -- Populate the stamp gadget(s)
    !this.stampList(!this.stampAfter)

    -- Get stamp data
    !this.stampData(!this.stampAfter)

  endif

  -- For before stamp
  if (!aft.not() and !this.beforeType.selection().eq('STAMP')) then
    !this.stampList(!this.stampBefore)
    !this.stampData(!this.stampBefore)
  endif

  -- Set stamp gadget active status
  !this.stampActive()

endmethod
-- End of method definition for .ifTime(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      changeActive
--
-- Description: Maintain the gadget activity
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN   Flag for AFTER/BEFORE (True for AFTER)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeActive(!aft is BOOLEAN)

  if( !aft ) then
    -- AFTER gadgets
    if (!this.sinceType.selection() eq 'TIME') then
      if (!this.changeAfter.val) then
        !this.time.active    = true
        !this.date.active    = true
      else
        !this.time.active    = false
        !this.date.active    = false
      endif
      !this.sessNum.active = false
      !this.plus.active    = false
      !this.minus.active   = false
    elseif (!this.sinceType.selection() eq 'SESS') then
      !this.time.active    = false
      !this.date.active    = false
      if (!this.changeAfter.val) then
        !this.sessNum.active = true
        !this.plus.active    = true
        !this.minus.active   = true
      else
        !this.sessNum.active = false
        !this.plus.active    = false
        !this.minus.active   = false
      endif
     endif
  else
    -- BEFORE gadgets
    if (!this.beforeType.selection() eq 'TIME') then
      if (!this.changeBefore.val) then
        !this.bTime.active    = true
        !this.bDate.active    = true
      else
        !this.bTime.active    = false
        !this.bDate.active    = false
      endif
      !this.bSessNum.active = false
      !this.bPlus.active    = false
      !this.bMinus.active   = false
    elseif (!this.beforeType.selection() eq 'SESS') then
      !this.bTime.active    = false
      !this.bDate.active    = false
      if (!this.changeBefore.val) then
        !this.bSessNum.active = true
        !this.bPlus.active    = true
        !this.bMinus.active   = true
      else
        !this.bSessNum.active = false
        !this.bPlus.active    = false
        !this.bMinus.active   = false
      endif
    endif
  endif

  if( !this.mergeType.selection() ne 'DB' ) then
    -- do not allow time/session choice
    !this.sinceType.active  = false
    !this.beforeType.active = false
    return
  endif

endmethod
-- End of method definition for .changeActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      sessionDate
--
-- Description: Maintain session time from session number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN   Flag for AFTER/BEFORE (True for AFTER)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sessionDate(!aft is BOOLEAN)

  -- Find out the high session number of this DB
  !lastSession = !this.dbObjects[ !this.dbs.val ].lastSession()
  handle any
    return
  endhandle

  if( !aft ) then
    -- Modifying AFTER session gadget
    if( !this.sessNum.val.unset() ) then
      !this.sessNum.val = !lastSession.number
    endif
    !sessionNumber = !this.sessNum.val
  else
    -- Modifying BEFORE session gadget
    if( !this.bSessNum.val.unset() ) then
      !this.bSessNum.val = 1
    endif
    !sessionNumber = !this.bSessNum.val
  endif

  if (!sessionNumber gt !lastSession.number or !sessionNumber eq 0) then
    !sessionNumber   = !lastSession.number
    !sessDate        = !lastSession.date
    !sessAuthor      = !lastSession.author

  else

    !this.currentDb = !this.dbObjects[ !this.dbs.val ]
    !this.currentSession = !this.currentDb.session(!sessionNumber)
    !sessionNumber = !this.currentSession.number
    !sessDate      = !this.currentSession.date
    !sessAuthor    = !this.currentSession.author

  endif

  !clockArr = !sessDate.split()
  !timeValue = !clockArr[1]
  !dateValue = !clockArr[2] & ' ' & !clockArr[3] & ' ' & !clockArr[4]
  !sessionUser = 'Session User      ' & !sessAuthor

  if( !aft ) then
    -- AFTER gadgets
    !this.sessNum.val  = !sessionNumber
    !this.time.val     = !timeValue
    !this.date.val     = !dateValue
    !this.sessUser.val = !sessionUser
  else
    -- BEFORE gadgets
    !this.bSessNum.val  = !sessionNumber
    !this.bTime.val     = !timeValue
    !this.bDate.val     = !dateValue
    !this.bSessUser.val = !sessionUser
  endif

  -- Maintain the session comments form
  -- *** This form uses the wrong parent form
  if (defined(!!admSessComment)) then
    if (!!admSessComment.shown()) then
      !!admSessComment.initialise()
    endif
  endif

  !this.plusMinusNum = 2

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .sessionDate(BOOLEAN)
------------------------------------------------------------------------
--
-- Method:      dateSession
--
-- Description: Maintain session number from session time
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN   Flag for AFTER/BEFORE (True for AFTER)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dateSession(!aft is BOOLEAN)

  -- Set Session number
  !selection = !this.dbs.selection()
  !dbSelection = object DB(!selection)

  if( !aft ) then
    -- modifying AFTER date
    !timeValue = !this.time.val
    !dateValue = !this.date.val
  else
    !timeValue = !this.bTime.val
    !dateValue = !this.bDate.val
  endif

  var !sessDnum SESSION ON $!timeValue $!dateValue $!selection
  handle ANY
    -- Fix for defect 1988 to handle the fact that the time and date value may be unset
    !!alert.error('Time, date or database is not set')
    return
  endhandle
  !sessionNumber = !sessDnum.real()

  -- Get session
  !this.currentSession = !dbSelection.session(!sessionNumber)
  !this.currentNumber = !sessionNumber

  -- Set Session user
  !sessAuthor = ''
  !sessAuthor = !this.currentSession.author

  !sessionUser = 'Session User      ' & !sessAuthor

  if( !aft ) then
    -- AFTER gadgets
    !this.sessNum.val  = !sessionNumber
    !this.sessUser.val = !sessionUser
  else
    -- BEFORE gadgets
    !this.bSessNum.val  = !sessionNumber
    !this.bSessUser.val = !sessionUser
  endif

  -- Maintain apply button
  if (!this.dbs.rtext.size().gt(0) or !this.mergeType.selection() eq 'SYS') then
    !this.apply.active = true
  elseif (!this.dbs.rtext.size().eq(0)) then
    !this.apply.active = false
  endif

  -- Maintain the session comments form
  if (defined(!!admSessComment)) then
    if (!!admSessComment.shown()) then
      !!admSessComment.initialise()
    endif
  endif

  -- Output summary
  !this.mergeAction()

endmethod
-- End of method definition for .dateSession(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      qrySessComment
--
-- Description: Show a form with the session comment on
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of showing selection form
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .qrySessComment()

  !!admSessComment.main = !this
  handle( 2,765)
    -- Undefined first time
  endhandle
  -- if form shown do initialise (AK 34108)
  if(defined(!!admSessComment) and !!admSessComment.shown() ) then
    !!admSessComment.initialise()
  else
    SHOW !!admSessComment
  endif

endmethod
-- End of method definition for .qrySessComment()

------------------------------------------------------------------------
--
-- Method:      mergeAction
--
-- Description: Invent a paragraph describing the action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .mergeAction()

  !mode          = !this.mergeType.selection()

  if( !mode eq 'SYS' ) then

    !atLoc = !this.location.locId
    !forLoc = !this.forLocn.selection('rtext')
    if (!atLoc eq !forLoc) then
      !this.action1.val = 'Merge the ' & !forLoc & ' System DB sessions'
    else
      if( !this.forLocn.active ) then
        !this.action1.val = 'Merge the ' & !forLoc & ' System DB sessions at ' & !atLoc
      else
        !this.action1.val = 'System dB for ' & !atLoc & ' is not primary at ' & !atLoc
      endif
    endif

    !this.action2.val = ''
    !this.action3.val = ''

  elseif( !mode eq 'ALL' ) then

    if( !this.allChange.val ) then
      !this.action1.val = 'Merge all sessions in all databases'
      !this.action2.val = ''
      !this.action3.val = ''
    else
      if( !this.changeAfter.val ) then
        !from = 'after ' + !this.time.val + ' on ' + !this.date.val
      else
        !from = ''
      endif
      if( !this.changeBefore.val ) then
        !to   = 'to '  + !this.bTime.val + ' on ' + !this.bDate.val
      else
        !to   = ''
      endif
      !this.action1.val = 'Merge sessions in all databases'
      !this.action2.val = !from
      !this.action3.val = !to
    endif

  elseif( !mode eq 'DB' ) then

    !database = !this.dbs.selection()
    if( !this.allChange.val ) then
      !this.action1.val = 'Merge all sessions in database ' + !database
      !this.action2.val = ''
      !this.action3.val = ''
    else
      if( !this.changeAfter.val ) then
        if( !this.sinceType.selection() eq 'SESS' ) then
          !from = 'after session '  + !this.sessNum.val.string()
        elseif (!this.sinceType.selection().eq('STAMP')) then
          !from = 'after stamp ' & !this.stampAfter.selection('dtext')
        else
          !from = 'after '  + !this.time.val + ' on ' + !this.date.val
        endif
      else
        !from = ''
      endif
      if( !this.changeBefore.val ) then
        if( !this.beforeType.selection() eq 'SESS' ) then
          !to   = 'to session '  + !this.bSessNum.val.string()
        elseif (!this.beforeType.selection().eq('STAMP')) then
          !to = 'to stamp ' & !this.stampBefore.selection('dtext')
        else
          !to   = 'to '  + !this.bTime.val + ' on ' + !this.bDate.val
        endif
      else
        !to   = ''
      endif
      !this.action1.val = 'Merge sessions in database ' + !database
      !this.action2.val = !from
      !this.action3.val = !to
    endif

  endif

endmethod
-- End of method definition for .mergeAction()

------------------------------------------------------------------------
--
-- Method:      notStamped()
--
-- Description: Check for db not stamped
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .notStamped()

  -- Check for no stamps
  if (!this.stampAfter.selection().eq('None Found') or !this.stampBefore.selection().eq('None Found')) then
    !this.apply.active = false
  else
    if (!this.dbs.rtext.size().gt(0)) then
      !this.apply.active = true
    endif
  endif

endmethod
-- End of method definition for .notStamped()

------------------------------------------------------------------------
--
-- Method:      stampActive()
--
-- Description: Set stamp gadgets active status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .stampActive()

    -- Initialise variables
    !mode = !this.mergeType.selection()

    -- For Project Merge, System Merge or All Changes
    if (!this.allChange.val or !mode.eq('SYS') or !mode.eq('ALL')) then

      -- Set stamp gadgets inactive
      !this.sortA.active       = false
      !this.stampAfter.active  = false
      !this.sortB.active       = false
      !this.stampBefore.active = false

      -- Clear the stamp lists
      !this.stampAfter.clear()
      !this.stampBefore.clear()

    -- For DB Merge and Changes After and Before
    else

      -- Changes after stamp
      if (!this.changeAfter.val and !this.sinceType.selection().eq('STAMP')) then

        -- Set time, date and session inactive
        !this.time.active        = false
        !this.date.active        = false
        !this.sessNum.active     = false
        !this.plus.active        = false
        !this.minus.active       = false

        -- Set stamp gadgets
        !this.stampAfter.active  = true
        if (!this.stampAfter.selection().eq('None Found')) then
          !this.sortA.active = false
        else
          !this.sortA.active = true
        endif

      else
        !this.sortA.active       = false
        !this.stampAfter.active  = false
        !this.stampAfter.clear()
      endif

      -- Changes before stamp
      if (!this.changeBefore.val and !this.beforeType.selection().eq('STAMP')) then
        !this.bTime.active    = false
        !this.bDate.active    = false
        !this.bSessNum.active = false
        !this.bPlus.active    = false
        !this.bMinus.active   = false
        !this.stampBefore.active = true
        if (!this.stampBefore.selection().eq('None Found')) then
          !this.sortB.active = false
        else
          !this.sortB.active = true
        endif
      else
        !this.sortB.active       = false
        !this.stampBefore.active = false
        !this.stampBefore.clear()
      endif

    endif

endmethod
-- End of method definition for .stampActive()

------------------------------------------------------------------------
--
-- Method:      stampData(GADGET)
--
-- Description: Get data for selected stamp
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Which list gadget to act upon
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .stampData(!listGadget is GADGET)

  -- Output summary
  !this.mergeAction()

  -- Test for no stamps
  if (!listGadget.selection().eq('None Found')) then
    return
  endif

  -- Get selected stamp
  !stampRef = object DBREF(!listGadget.selection())

  -- Get the stamp list that references the current db
  !stampedDbs = !stampRef.dbsStp
  !getDbName = object BLOCK('!stampedDbs[!evalIndex].name.after(|*|)')
  !dbNames = !stampedDbs.evaluate(!getDbName)
  !stlstRef = !stampRef.mem[!dbNames.findFirst(!this.dbs.selection('dtext'))]

  --If stamp has a date use it, otherwise use the session date
  if (!stampRef.setDat.eq('')) then
    !dbObj = object DB(!this.dbs.selection('dtext'))
    !this.currentSession = !dbObj.session(!stlstRef.stSess)
    !dateObj = object DATETIME(!this.currentSession.date)
  else
    !dateObj = object DATETIME(!stampRef.setDat)
  endif

  -- Test hours, minutes & day if they require a leading zero
  !hours = !this.zero(!dateObj.hour().string())
  !minutes = !this.zero(!dateObj.minute().string())
  !day = !this.zero(!dateObj.date().string())

  -- Populate gadgets
  if (!listGadget.name().eq('STAMPAFTER')) then
    !this.time.val = !hours & ':' & !minutes
    !this.date.val = !day & ' ' & !dateObj.monthString().subString(1,3) & ' ' & !dateObj.year()
    !this.sessNum.val = !stlstRef.stSess
  else
    !this.bTime.val = !hours & ':' & !minutes
    !this.bDate.val = !day & ' ' & !dateObj.monthString().subString(1,3) & ' ' & !dateObj.year()
    !this.bSessNum.val = !stlstRef.stSess
  endif

endmethod
-- End of method definition for .stampData(GADGET)

------------------------------------------------------------------------
--
-- Method:      stampList(GADGET)
--
-- Description: Populate the stamp list gadget(s)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The list gadget to populate
--
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
define method .stampList(!listGadget is GADGET)

  -- Get current db
  !curDb = object DB(!this.dbs.selection('dtext'))

  -- Get all stamps for this db
  !this.stampRefs = !curDb.refNo.dbRef().stpDbs

  -- Sort and populate the gadget
  if (!this.stampRefs.empty()) then

    -- Populate the list gadget
    !dtext[1] = 'None Found'
    !listGadget.dtext = !dtext

  else

    -- Get sort gadget
    if (!listGadget.name().eq('STAMPAFTER')) then
      !sortGadget = !this.sortA
    else
      !sortGadget = !this.sortB
    endif

    -- Populate the list gadget
    !!admStampSort(!this.stampRefs,!sortGadget,!listGadget)

  endif

endmethod
-- End of method definition for .stampList(GADGET)

------------------------------------------------------------------------
--
-- Method:      .zero(STRING)
--
-- Description: Tests if a hour or minute value requires a leading zero
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value to be tested
-- Return:
--   [Data Type] [Description]
--    STRING      Returned string
--
------------------------------------------------------------------------
-- Define method
define method .zero(!string is STRING) is STRING

  -- Is a leading zero required?
  if (!string.length().eq(1)) then
    !value = '0' & !string
  else
    !value = !string
  endif
  return !value

endmethod
-- End of method definition for .zero(STRING)

------------------------------------------------------------------------
--
--Method: .cbAtLocn()
--
-- Description: Callback on at location gadget
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAtLocn()
    !this.location = !this.locList[!this.atLocn.val]
    !this.dbListInit()

    -- Get the for Locations
    !this.getForLocs()

endmethod
-- End of method definition for .cbAtLocn()
------------------------------------------------------------------------
--
--Method: .getPossLocs()
--
-- Description: Get all the locations this site can merge:-
-- i.e. all sites this site can administer + itself
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--   Boolean      Are there on line locations
--
------------------------------------------------------------------------
define method .getPossLocs() is BOOLEAN

  -- initialise Location Gadget
  !this.atLocn.clear()
  !result = false

  -- Get a list of locations which are on-line
  !clause = |ICONN EQ 1|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locations
  !this.locList.clear()

  do !i values !resultingLocs
    -- The rules are ;-
    -- 1. Hub - All locations (excluding itself )
    -- 2. All - Itself always (even if not administering itself) - REMOVED decided not itself.
    -- 3. All - All locations it is administering.

    -- Use rules
    if (!!dbrGlbCurLocRf() eq !!dbrGlbHubLocRf()) then
      -- 1. Hub - All locations (but not itself on this form)
      -- Modified for DFN 7305. Date:09.08.06
      -- Commented, To include the Hub location in this form.
      -- skip if(!!dbrGlbCurLocRf() EQ !i)
      !textOfLocs.append(!i.locId)
      !this.locList.append(!i)
    else
      -- 2. All - Itself always (even if not administering itself)
      --if (!!dbrGlbCurLocRf() EQ !i) then
      --  !textOfLocs.append(!i.locId)
      --  !this.locList.append(!i)
      --endif
      -- 3. All - All locations it is administering.
      var !prmLoc prmLoc of $!i
      if (!prmLoc.dbRef() eq !!dbrGlbCurLocRf()) then
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif

  enddo

  -- We need some on line locations to do a remote merge
  if (!textOfLocs.size() eq 0) then
    !!alert.error('No remote on-line locations')
    !this.setActive(false)
    return !result
  else
    !this.setActive(true)
  endif

  !this.atLocn.dtext = !textOfLocs
  !this.location = !this.locList[!this.atLocn.val]

  !result = true
  return !result

endmethod
-- End of method definition for .getPossLocs()
------------------------------------------------------------------------
--
--Method: .getForLocs()
--
-- Description: Get all the locations this primary dB location can administer:-
-- i.e. all sites this site can administer
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--   Boolean      Are there any valid locations
--
------------------------------------------------------------------------
define method .getForLocs() is BOOLEAN

  -- initialise Location Gadget
  !this.forLocn.clear()
  !result = false

  -- Get a list of locations which are on-line
  !clause = |ICONN EQ 1|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  do !i values !resultingLocs
    -- The rules are ;-
    -- 1. Hub - All online locations, that administer themselves.
    -- 2. Sat - All locations that the location is administering.
    if (!!dbrGlbCurLocRf() eq !!dbrGlbHubLocRf()) then
      -- 1. Hub - All online locations, that administer themselves.
      if (!i.prmrf eq !this.location or (!i.prmrf.unset() and !i eq !this.location)) then
        !textOfLocs.append(!i.locId)
      endif
    else
      -- 2. Sat - All locations that the location is administering.
      if (!i.prmrf eq !this.location) then
        !textOfLocs.append(!i.locId)
      endif
    endif
  enddo

  !this.forLocn.dtext = !textOfLocs

  -- We need some on line locations to do a remote merge for
  if (!textOfLocs.size() eq 0) then
    !this.forLocn.active = false
    !this.mergeAction()
    return !result
  else
    -- Only make active if merging the system dB
    if (!this.mergeType.selection() eq 'SYS') then
      !this.forLocn.active = true
      !this.mergeAction()
    endif
  endif

  !result = true
  return !result

endmethod
-- End of method definition for .getForLocs()
