-- Method:      .dbSel()
--
-- Description: deal with the selection of the database to recover.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbSel()

  !this.glbRecoverDb.dbSel()

endmethod
-- End of method definition for .dbSel()

