endmethod
-- End of method definition for .cbAll()
------------------------------------------------------------------------
--
--Method: .cbClear()
--
-- Description: clears the selection!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbClear()

