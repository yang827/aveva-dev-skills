-- File:            glbrmtsync.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Wed Jun 18 16:45:54 BST 1997
--
--
-- Description:
-- Form definition to allow for the specification of a synchronisation
-- process with another project location.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  act()                            -                   method to set the action to be performed upon APPLY for the
--  cbAll()                          -                   This method selects all db in the db gadget.
--  cbApply()                        -                   method to perform and PDMS Global SYNCHRONISE command based upon
--  cbAtLocn()                       -                   Select an AT location
--  cbClear()                        -                   clears the selection!
--  cbDbSelection()                  -                   select all db Currently on-screen
--  glbRmtSync()                     -                   Constructor
--  init()                           -                   method to initialise the !this form.
--  list()                           -                   method to act as a callback to the Sort and Filter gadgets
--  locn()                           -                   method to maintain the list of databases that are common
--  targ()                           -                   method to control form gadget states depending upon the selected
--
------------------------------------------------------------------------

-- Define form
setup form !!glbRmtSync resize

  !this.formTitle     = 'Remote Synchronise Secondary Databases'
  !this.iconTitle     = 'RSYNCDB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition
  option .atLocn  at x 1 y 0.2 |Synchronise Secondary Databases of | call |!this.cbAtLocn()| width 5
  path down
  halign right
  option .target  |With Databases at | call |!this.targ()| width 17

  list   .locn    at xmin.atLocn  ymax+0.2  call |!this.locn()| anchor r+t+l columns width 50 height 5

  frame .dbFrame  at x 0 ymax | Secondary Databases | anchor all

    option .act      at xmin+1 ymin+1 |Synchronise   | call |!this.act()| width 18
    path down
    halign left
    option .whichDbs |Type          | call |!this.targ()| width 18
    list   .db       call |!this.cbDbSelection()| anchor all MULTIPLE columns   width 50 height 15
    option .sort     |Sort By| call |!this.list()| anchor b+l width 12
    text   .filter   at xmax+1 ymin |Filter|  anchor b+r call |!this.list()| width 20 STRING
    button .all      at xmax.act+5 ymin.act   | All | anchor t+r call |!this.cbAll()|
    button .clear    at xmin.all   ymin.whichDbs |Clear| anchor t+r call |!this.cbClear()|

  exit

  button .apply   at x 0 ymax+0.5        |Apply| anchor b+l call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| anchor b+r CANCEL

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All DBs|,|!this.db.select('rtext',!this.db.rText)|)
    !this.dbPopupMenu.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.db)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.db.clearSelection()|)
    !this.db.setPopup(!this.dbPopupMenu)

  -- Member Definitions
    -- Object serving this form
    member .glbSynchronise is GLBSYNCHRONISE
    -- Array of Locations secondary databases
    member .dbArray        is ARRAY
    -- Array of DB sets
    member .dbArraySet    is ARRAY
    -- Array of MDBS
    member .mdbArray      is ARRAY
    -- Array storing previous Selection
    member .prevSelection  is ARRAY
    -- Selected Location
    member .location       is DBREF
    -- Sort and Filter gadget memory
    member .dbFilter       is STRING
    member .dbSort         is STRING
    member .init           is BOOLEAN


exit
-- End of form definition for !!glbRmtSync

------------------------------------------------------------------------
--
-- Method:      .glbRmtSync()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbRmtSync()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- Assign function gadget values
  !dText.append(|Primary Locations|)
  !dText.append(|Selected Location|)
  !this.target.dText  = !dText
  !dText.clear()
  !rText.append(|PRI|)
  !rText.append(|SEL|)
  !this.target.rText  = !rText
  !rText.clear()

  -- Assign Act gadget values
  !dText.append(|Selected Databases|)
  !dText.append(|All Databases|)
  !this.act.dText  = !dText
  !dText.clear()
  !rText.append(|SEL|)
  !rText.append(|ALL|)
  !this.act.rText  = !rText
  !rText.clear()

  -- Assign whichDbs gadget values
  !dText.append(|User Databases|)
  !dText.append(|System Databases|)
  !dText.append(|DB Sets|)
  !dText.append(|MDBs|)
  !this.whichDbs.dText  = !dText
  !dText.clear()
  !rText.append(|USER|)
  !rText.append(|SYSTEM|)
  !rText.append(|DBSET|)
  !rText.append(|MDB|)
  !this.whichDbs.rText  = !rText
  !rText.clear()

  -- Assign Sort gadget values
  call !!admDbSortGadg(!this.sort)

  -- Set filter gadget
  !this.filter.val = |*|

  -- initialise object serving this form
  !this.glbSynchronise.parentForm(!this)
  !this.glbSynchronise.operation('SYNCHRONISE')

  -- activate the whichDbs selection
  !this.targ()

endmethod
-- End of method definition for .glbRmtSync()

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: method to perform and PDMS Global SYNCHRONISE command based upon
-- the selected databases. This command only works for secondary
-- databases.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  !this.glbSynchronise.cbSynchronise()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .act()
--
-- Description: method to set the action to be performed upon APPLY for the
-- form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .act()

  !this.glbSynchronise.act()

endmethod
-- End of method definition for .act()

------------------------------------------------------------------------
--
--Method: .cbAtLocn()
--
-- Description: Select an AT location
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAtLocn()

  !this.glbSynchronise.cbAtLocn()

endmethod
-- End of method definition for .cbAtLocn()
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: method to initialise the !this form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.init = TRUE

  !this.glbSynchronise.initSynchronise()

  --Get the locations this actual site can synchronise!!!
  !this.glbSynchronise.getPossLocs()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .list()
--
-- Description: method to act as a callback to the Sort and Filter gadgets
-- in the !this form. method control the DB list gadget
-- contents based on the sort and filter gadget values.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .list()

  !this.glbSynchronise.list()

endmethod
-- End of method definition for .list()

------------------------------------------------------------------------
--
-- Method:      .locn()
--
-- Description: method to maintain the list of databases that are common
-- to the current location and the target location for the
-- synchronise operation. All database listed will be secondary
-- at the current location. Update of list in form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locn()

  !this.glbSynchronise.locn()

endmethod
-- End of method definition for .locn()

------------------------------------------------------------------------
--
-- Method:      .targ()
--
-- Description: method to control form gadget states depending upon the selected
-- synchronisation target. The location list gadget becomes inactive
-- is the Target is "Primary Locations".
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .targ()

  !this.glbSynchronise.targ()

endmethod
-- End of method definition for .targ()
------------------------------------------------------------------------
--
--Method: .cbDbSelection()
--
-- Description: select all db Currently on-screen
-- to be reinforced in the cbApply()
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbDbSelection()

  !this.glbSynchronise.cbDbSelection()

endmethod
-- End of method definition for .cbDbSelection()
------------------------------------------------------------------------
--
--Method: .cbAll()
--
-- Description: This method selects all db in the db gadget.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAll()

