--
--  Description:     -- For definition to allow for the specification of an out of-- phase update with a directly connected location.--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  act()                            -                   Function to set the action to be performed upon apply for this
--  cbAll()                          -                   This method selects all db in the db gadget.
--  cbApply()                        -                   Function to perform and PDMS Global UPDATE command based upon the
--  cbClear()                        -                   clears the selection!
--  cbDbSelection()                  -                   select all db Currently on-screen
--  init()                           -                   Function to initialise the !!glbRmtUpdateDb form.
--  list()                           -                   Function to act as a callback to the Sort and Filter gadgets
--  locn()                           -                   Function to maintain the list of databases that are common
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            glbrmtupdatedb.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
--
-- Description:
-- For definition to allow for the specification of an out of
-- phase update with a directly connected location.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Define form
setup form !!glbRmtUpdateDb resize

  !this.formTitle     = 'Unscheduled Database Update'
  !this.iconTitle     = 'UPD DB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition
  list .locn at x 1 y 0 |Update With Location| call |!this.locn()| anchor t+l+r columns width 50 height 7

  frame .dbFrame at x 0  ymax |Allocated Databases| anchor all

    option .act at xmin+1 ymin+1 |Update| call |!this.act()| width 18
    path down
    halign left

    option .whichDbs at xmin.act ymax.act |Type           | call |!this.list()| width 18
    list .db at xmin.dbFrame+1 ymax+0.2 call |!this.cbDbSelection()| anchor all MULTIPLE columns width 50 height 15

    option .sort at xmin ymax |Sort By| anchor b+l call |!this.list()| width 12
    text .filter at xmax+1 ymin |Filter| anchor b+r call |!this.list()| width 20 STRING
    button .all      at xmax.act+5 ymin.act   | All | anchor t+r call |!this.cbAll()|
    button .clear    at xmin.all ymin.whichDbs |Clear| anchor t+r call |!this.cbClear()|

  exit

  button .apply at x 0 ymax+0.5 |Apply| anchor b+l call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| anchor b+r CANCEL

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All DBs|,|!this.db.select('rtext',!this.db.rText)|)
    !this.dbPopupMenu.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.db)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.db.clearSelection()|)
    !this.db.setPopup(!this.dbPopupMenu)

  -- Member Definitions
    -- Array of project databases
    member .dbArray is ARRAY
    -- Array of DB sets
    member .dbArraySet    is ARRAY
    -- Array of MDBS
    member .mdbArray      is ARRAY
    -- Selected location
    member .location is DBREF
    -- Sort and Filter gadget memory
    member .dbFilter is STRING
    member .dbSort   is STRING
    member .prevSelection is ARRAY
    member .init          is BOOLEAN


-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Assign Upd option gadget values
!dText.append(|Selected Databases|)
!dText.append(|All Databases|)
!this.act.dText  = !dText
!dText.clear()
!rText.append(|SEL|)
!rText.append(|ALL|)
!this.act.rText  = !rText
!rText.clear()

-- Assign whichDbs gadget values
!dText.append(|User Databases|)
!dText.append(|System Databases|)
!dText.append(|DB Sets|)
!dText.append(|MDBs|)

!this.whichDbs.dText  = !dText
!dText.clear()
!rText.append(|USER|)
!rText.append(|SYSTEM|)
!rText.append(|DBSET|)
!rText.append(|MDB|)

!this.whichDbs.rText  = !rText
!rText.clear()


 -- Assign Sort gadget values
!!admDbSortGadg(!this.sort)

-- Set filter gadget
!this.filter.val = |*|

exit
-- End of form definition for !!glbRmtUpdateDb

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Function to perform and PDMS Global UPDATE command based upon the
-- selected databases. The update is an unscheduled propagation event.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .cbApply()

  -- Initialise variables
  !mode      = !this.act.selection('rtext')
  !remoteLoc = !this.location
  !dbToDo     = !this.db.selection(|RTEXT|)
  if (!dbToDo.size() eq 0 ) then
    --##
    !!alert.error(|Please select databases.|)
    return
  endif

  !prev = !!ce

   --reverse from the logical construction

   !targetTxt = | WITH '| + !remoteLoc.locId +|'|

  -- if all update all required or not
  if(!mode eq |ALL|)then
    !commandText = |UPDATE ALL| + !targetTxt
    call !!admCommand(!commandText)
    handle (1,500) (1,501)
      -- Daemon errors
      !!messageFile.error(141, 704, !!error.text.after(')').trim('L'))
      -- This is the generic message and need to be replaced
    elsehandle any
      -- Non-specific error
      !!messageFile.error(141, 704, !!error.text)
    endhandle
  elseif(!mode eq |SEL|)then
    -- whether system DBs or not
    !commandArray = ARRAY()
    if(!this.whichDbs.selection(|RTEXT|) EQ |SYSTEM|)then
      -- In this clause they are locations
      do !i values !dbToDo
        if(!i EQ |GLOBAL|)then
          !text = |UPDATE GLOBAL| + !targetTxt
        elseif(!i EQ |LOCAL|)then
          !text = |UPDATE SYSTEM | + !targetTxt
        else
          !text = |UPDATE SYSTEM FOR | + !i + !targetTxt
        endif
        !commandArray.append(!text)
      enddo
    elseif(!this.whichDbs.selection(|RTEXT|) EQ |USER|)then
      -- In this clause they are db names
      do !i values !dbToDo
        !text = |UPDATE | + !i.dbRef().name.substring(3) + !targetTxt
        !commandArray.append(!text)
      enddo
    endif

    -- initialise report object
    !updateReport = object GLBACTIONREPORT()
    !updateReport.clear()
    -- Now must iterate through command executing them!
    !counter = 0
    do !j values !commandArray
      !counter = !counter + 1
      call !!admCommand(!j)
      handle (1,500) (1,501)
        -- Daemon errors
        !message = !!messageFile.messageString(141, 704, !!error.text.after(')').trim('L'))
        !!alert.error(!message)
        -- This is the generic message and need to be replaced
        if(!this.whichDbs.selection(|RTEXT|) EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief = 'UPDATE FAILED'
      elsehandle any
        -- Non-specific error
        !message = !!messageFile.messageString(141, 704, !!error.text)
        !!alert.error(!message)
        if(!this.whichDbs.selection(|RTEXT|) EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief = 'UPDATE FAILED'
      elsehandle none
        if(!this.whichDbs.selection(|RTEXT|) EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief   = 'UPDATE OK    '
        !message = !db.replace('/','',1,1)
        !message = !message.replace('*','',1,1) + ' update command issued'
      endhandle
      !reportRef = !db.dbRef()
      handle any
        !reportRef = !!dbrAdminGetWorld('DB')
      endhandle
      !updateReport.append(!brief, !message, !reportRef)
    enddo
  endif

  -- show the summary report
  !updateReport.display('Update Summary')
  !updateReport.clear()

  !!ce = !prev

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .act()
--
-- Description: Function to set the action to be performed upon apply for this
-- form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .act()

  -- Initialise variables
  !action          = !this.act.selection('rtext')

  -- Set form gadget states depending on action
  if (!action eq 'SEL') then

    -- Gadgets are active
    !this.db.active     = true
    !this.all.active    = true
    !this.clear.active  = true
    !this.sort.active   = true
    !this.filter.active = true

  elseif (!action eq 'ALL') then

    -- Gadgets are inactive
    !this.db.active     = false
    !this.all.active    = false
    !this.clear.active  = false
    !this.sort.active   = false
    !this.filter.active = false

  endif

endmethod
-- End of method definition for .act()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Function to initialise the !!glbRmtUpdateDb form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.init = TRUE

  -- Initialise variables
  !currentPos  = !!ce
  !currentLoc  = !!dbrGlbCurLocRf()
  !locations   = ARRAY()

  -- Make sure current location is online
  if (!currentLoc.iconn.boolean().not()) then
    -- Cannot run for an off-line site
    !!messageFile.error(141, 602)
  endif

  -- Collect the project locations that can be updated with
  -- PARENT, CHILD, GROUP
  -- Get the parent of the current location.
  if (!currentLoc neq !!dbrGlbHubLocRf()) then
    !locations.append(!currentLoc.locRf)
  endif

  -- Get locations that are children of the current locations
  !!ce         = !!dbrAdminGetWorld('LOC')
  !clause      = 'LOCRF eq '+ !currentLoc.string() +' and LINIT eq TRUE'
  !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))

  -- Get locations that are members of the same group
  if (!currentLoc.grpRf.set()) then
    !clause      = 'GRPRF eq '+ !currentLoc.grpRf.string() +' and LINIT eq TRUE'
    !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))
  endif

  -- Make the locations array unique
  !locations.unique()

  -- Restore the database location
  !!ce         = !currentPos

  -- See if there are any locations to communicate with
  if (!locations.unset()) then
    !!messageFile.error(141, 601)
  endif

  -- Display the list of locations
  call !!adminLocnTxtList(!locations,!this.locn)

  -- Set the form member for the current location
  if (!this.location.set()) then

    -- Attempt to select the previous update location
    !this.locn.select('rtext',!this.location.string())
    handle any
      -- Dummy handle
    endhandle

  endif
  !this.location = !this.locn.selection('rtext').dbRef()

  -- Restore previous sort states
  if (!this.dbSort.set()) then
    !this.sort.select('dtext',!this.dbSort)
  else
    !this.dbSort     = !this.sort.selection('dtext')
  endif

  --  Restore previous filter state
  if (!this.dbFilter.set()) then
    !this.filter.val = !this.dbFilter
  else
    !this.dbFilter   = !this.filter.val
  endif

  -- Update the list of databases depending upon the
  -- selected location
  !this.locn()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .list()
--
-- Description: Function to act as a callback to the Sort and Filter gadgets
-- in the !!glbRmtUpdateDb form. Function control the DB list gadget
-- contents based on the sort and filter gadget values.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .list()

  -- Clear the database list
  !this.db.clear()
  !this.prevSelection.clear()


  if(!this.whichDbs.selection(|rtext|) EQ |USER|)then

    -- Capture the sort and filter gadget values
    !this.dbSort     = !this.sort.selection('dtext')
    !this.dbFilter   = !this.filter.val

    -- Sort, filter and display the database list
    !displayList = !!adminFilterSort(!this.dbArray,!this.sort,!this.filter)
    !format2Use = !!admDisplayConfig.fmtDbGet()
    !!adminDbTxtList(!displayList,!this.db,!format2Use,!!admDisplayConfig.eleTypeGet(), object DBREF())

    !this.sort.active = TRUE
    !this.filter.active = TRUE

  elseif(!this.whichDbs.selection(|rtext|) EQ |SYSTEM|)then

    !this.sort.active = FALSE
    !this.filter.active = FALSE

    !localLoc    = !!dbrGlbCurLocRf()
    !targetLoc   = !this.locn.selection('rtext').dbRef()

    !this.location = !targetLoc

    !tempDtext = !this.db.dText
    !tempRtext = !this.db.rText

      -- Now system DB can be picked from any Location
    !tempDtext.insert(1,|-  Local System Database|)
    !tempRtext.insert(1,|LOCAL|)
    !tempDtext.insert(1,|-  Global System Database|)
    !tempRtext.insert(1,|GLOBAL|)

    -- Get a list of other locations sys db's here!
    -- the next line get an array of locations
    !arrayLocs = !!dbrAdminGetWorld(|LOC|).mem[2].mem
    !text = ||
    do !i values !arrayLocs
      if((!i NEQ !localLoc) AND (!i.lInit))then
        !text = |-  Local Copy of | + !i.name.substring(2) + |'s System Database|
        !tempDtext.append(!text)
        !tempRtext.append(!i.name)
      endif
    enddo

    !this.db.dText = !tempDtext
    !this.db.rText = !tempRtext
  endif

endmethod
-- End of method definition for .list()

------------------------------------------------------------------------
--
-- Method:      .locn()
--
-- Description: Function to maintain the list of databases that are common
-- to the current location and the update location for this form.
-- (Unscheduled updates).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .locn()

  -- Initialise variables
  !localLoc    = !!dbrGlbCurLocRf()
  !remoteLoc   = !this.locn.selection('rtext').dbRef()
  !localDbs    = ARRAY()
  !remoteDbs   = ARRAY()

  -- Set the selected location
  !this.location = !remoteLoc

  -- Get the local databases (Non-foreign and propagated)
  !!ce         = !localLoc
  !localAlloc  = !!ce.mem[1].mem
  do !db values !localAlloc
    skip if !db.badRef()
    skip if (!db.foreign neq 'LOCAL')
    !!ce           = !db
    DBLOC 1
    if (!!ce.propg) then
      !localDbs.append(!db)
    endif
  enddo

  -- Get the remote locations databases (Non-foreign and propagated)
  !!ce         = !remoteLoc
  !remoteAlloc = !!ce.mem[1].mem
  do !db values !remoteAlloc
    skip if !db.badRef()
    skip if (!db.foreign neq 'LOCAL')
    !!ce           = !db
    DBLOC 1
    if (!!ce.propg) then
      !remoteDbs.append(!db)
    endif
  enddo

  -- Update the array of common databases
  !this.dbArray  = !localDbs.intersect(!remoteDbs)

  -- Update the database list contents
  !this.list()

endmethod
-- End of method definition for .locn()
------------------------------------------------------------------------
--
--Method: .cbDbSelection()
--
-- Description: select all db Currently on-screen
-- to be reinforced in the cbApply()
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbDbSelection()

    -- Not much need for this line only kept it in for completeness!
    !this.prevSelection = !this.db.selection(|RTEXT|)
    return

endmethod
-- End of method definition for .cbDbSelection()
------------------------------------------------------------------------
--
--Method: .cbAll()
--
-- Description: This method selects all db in the db gadget.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAll()
  -- selects all in gadget
  !this.db.select('rtext',_db.rText)
  -- set prev selection
  !this.prevSelection = !this.db.selection(|RTEXT|)
endmethod
-- End of method definition for .cbAll()
------------------------------------------------------------------------
--
--Method: .cbClear()
--
-- Description: clears the selection!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbClear()
  -- clear selection
  !this.db.clearSelection()
  -- set prev selection
  !this.prevSelection.clear()
endmethod
-- End of method definition for .cbClear()
