-- Created:         Tue Oct 27 10:09:53 GMT 1998
--
--
-- Description:
-- Form to Display data on which users are members of which Project Teams
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed
--  generateUsers()                  -                   To query the open SYS DB and get an array of Users and place it
--  getDbUsers()                     -                   To Capture the information on the selected team
--  getTeams()                       -                   Method to initialise the data for the Team List form
--  init()                           -                   Method to initialise the data for the Team List form
--
------------------------------------------------------------------------

setup form !!glbTeamList resize

  !!glbTeamList.formTitle     = 'Team List'
  !!glbTeamList.iconTitle     = 'TEAM LIST'
  !!glbTeamList.callback      = '!!glbTeamList.init()'
  !!glbTeamList.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition
  option  .location at x 0 y 0.5 |Location Queried| anchor left+top call |!this.cbLocs()| width 7

  list    .teams 'Teams' at xmin ymax+0.5 anchor left+top+bottom call |!this.getDbUsers()| width 12 length 19
  path right
  valign bottom
  list    .dbs |DBs| anchor all width 43 length 8
  path down
  halign right
  vdist 0
  button  .dismiss at xmax form-size ymax form |Dismiss| anchor right+bottom OK

  list    .users |Users| at xmin.dbs ymin.teams anchor left+right+top width 43 length 8



  -- Member Definitions
  member .initAdmdLoc is DBREF
  member .teamList is ARRAY
  member .locList is ARRAY
  member .dbList is ARRAY
  member .allUserList is ARRAY
exit


-- End of form definition for !!glbTeamList


------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the Team List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Set member to indicate current loc
  !this.initAdmdLoc  = !!adminApplic.getAdmContext()

  -- initialise Location Gadget
  !this.location.clear()

  -- Get a list of locations which are initialised
  !clause = |LINIT EQ TRUE|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locs
  !this.locList.clear()

  do !i values !resultingLocs
    if (!this.initAdmdLoc EQ !i) then
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
      -- To insure Initial Location is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !this.locList.invert()
    else
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif
  enddo

  !this.location.dText = !textOfLocs

  !this.generateUsers()
  !this.getTeams()
  !this.getDbUsers()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getTeams()
--
-- Description: Method to initialise the data for the Team List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getTeams()

  -- This uses a function which returns all teams
  !resultingTeams = TEAMS
  -- Clear the current list of teamNames
  !this.teams.clear()
  !this.teamList.clear()

  -- Loop through the project team list
  do !i indices !resultingTeams
    if (!!sessionSettings.showAs eq |DESC|) then
      !tmList[!i] = !resultingTeams[!i].description
      if (!tmList[!i].unset() or !tmList[!i].empty()) then
        !tmList[!i] = !resultingTeams[!i].name
      else
        -- removes whitespace
        !tmList[!i] = !tmList[!i].trim()
      endif
    else
       !tmList[!i] = !resultingTeams[!i].name
    endif
  enddo

  !this.teamList = !resultingTeams

  -- Sort the list of teams and place them in the list gadget
  !sortOrder = !tmList.sortedIndices()
  !tmList.reIndex(!sortOrder)
  !this.teamList.reIndex(!sortOrder)

  !this.teams.dText = !tmList

endmethod
-- End of method definition for .getTeams()

------------------------------------------------------------------------
--
-- Method:      .getDbUsers()
--
-- Description: To Capture the information on the selected team
-- at the selected Location i.e.: DBS and Users
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- define method
define method .getDbUsers()

  -- Initialise some variables
  !matchingUsers = ARRAY()
  !matchingDbs = ARRAY()
  !temp = ARRAY()
  !this.dbs.clear()
  !this.users.clear()

  -- Check there are some teams
  if(!this.teams.val EQ 0)then
    return
  endif

  -- Get the current selected team
  !currTeam       = !this.teamList[!this.teams.val]

  -- FOR ALL USERS
  do !i indices !this.allUserList

    -- FOR ALL TEAMS THE USER IS A MEMBER OF
    do !j indices !this.allUserList[!i].teamName

      -- IF CURRENT TEAM MATCHS TEAM UNDER INSPECTION
      if (!this.allUserList[!i].teamName[!j] EQ !currTeam.name) then

        -- IF IN DESCRIPTION MODE
        if (!!sessionSettings.showAs eq |DESC|) then
          -- i.e. selected team is in the list of teams for this user
          !matchingUsers.append(!this.allUserList[!i].description)
          -- DROP OUT OF SEARCH TEAM LIST AS RESULT REACHED
          break

        else
          !matchingUsers.append(!this.allUserList[!i].name)

        endif
      endif
    enddo
  enddo

  !this.users.dText = !matchingUsers

  -- Get a list of DBs allocated to Team
  !matchingDbs = !currTeam.dbList()

  -- Get Current Dbs
  do !i indices !matchingDbs
    if (!!sessionSettings.showAs eq |DESC|) then
      !temp[!i] = !matchingDbs[!i].description
      !this.dbList.append(!matchingDbs[!i])
      if (!temp[!i].unset() or !temp[!i].empty()) then
        !temp[!i] = !matchingDbs[!i].name
      else
        -- removes whitespace
        !temp[!i] = !temp[!i].trim()
      endif
    else
      !temp[!i] = !matchingDbs[!i].name
      !this.dbList.append(!matchingDbs[!i])
    endif
  enddo

  !this.dbs.dText = !temp

endmethod
-- End of method definition for .getDbUsers()


------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To get information if a different location is to be queried
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- This follows the premise that there will always be a location to
  -- administer!!!
  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
  !this.generateUsers()
  ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'

  !this.getTeams()
  !this.getDbUsers()

endmethod
-- End of method definition for .cbLocs()

------------------------------------------------------------------------
--
-- Method:      .generateUsers()
--
-- Description: To query the open SYS DB and get an array of Users and place it
-- form member !this.allUserList in non sys db specific format
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .generateUsers()
  !this.allUserList.clear()
  !theUsers = USERS
  do !i values !theUsers
    !temp = object GLBUSER()
    !temp.user2GlbUser(!i)
    !this.allUserList.append(!temp)
  enddo
endmethod
-- End of method definition for .generateUsers()
