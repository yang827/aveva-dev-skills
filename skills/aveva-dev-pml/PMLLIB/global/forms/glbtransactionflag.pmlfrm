--
--
-- Description:
-- Specific Form to set the Command Transaction Flag Text
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the Flag to the selected commands
--  glbTransactionFlag()             -                   Constructor
--
setup form !!glbTransactionFlag

  !this.formTitle     = 'Command Transaction Flag'
  !this.iconTitle     = 'Flag'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  text    .setFlagText   'Flag Text ' at x1 ymax call '' width 20 is STRING
  button .default 'Default' at x11 ymax callback |!this.setFlagText.val = '*** Follow Up ***'|
  button .ok 'OK' at x1 ymin callback '!this.apply()' ok
  button .cancel 'Cancel' at xmax form-size ymin callback '' cancel

exit

-- End of form definition for !!glbTransactionFlag
------------------------------------------------------------------------
--
-- Method:      glbTransactionFlag
--
-- Description: Constructor
--
------------------------------------------------------------------------

define method .glbTransactionFlag()

  !this.setFlagText.val = '*** Follow Up ***'

endmethod
-- End of method definition for .glbTransactionFlag()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply the Flag to the selected commands
--
------------------------------------------------------------------------

define method .apply()

  -- For each selected command on the owning form set the flag via the transaction object of the owning form
  -- P-35077 Escape sequence $X6 for Paragraph sign replaced by actual character #
--  !actualFlag = '$x6 ' & !this.setFlagText.val
  !actualFlag = '# ' & !this.setFlagText.val
  !unusedPasses = !!glbTransactions.object.setFlag(!!glbTransactions.transactions.selection('RTEXT'), !!glbTransactions.transactions.val, !actualFlag )

  -- Copy the transaction gadget details
--  !dtext       = !!glbTransactions.transactions.dtext
--  !rtext       = !!glbTransactions.transactions.rtext
--  !dtextObject = !!glbTransactions.object.commandDtext

  -- Set the copied dtext and the object command dtext to append the flag text
--  do !i indices !passes
--    !dtext[!passes[!i]] = !dtext[!passes[!i]].before('$x6 ').trim('R', ' ') & ' $x6 ' & !this.setFlagText.val
--    !!glbTransactions.object.commandDtext[!passes[!i]] = !dtextObject[!passes[!i]].before('$x6 ').trim('R', ' ') & ' $x6 ' & !this.setFlagText.val
--  enddo

  -- Update the gadgets
--  !!glbTransactions.transactions.dtext = !dtext
--  !!glbTransactions.transactions.rtext = !rtext

  -- Remember the page number
  !pageNumber = !!glbTransactions.pageGadget.val

  -- Update the Transactions
  !!glbTransactions.updateTransactions()

  -- We need to find the page again
  !!glbTransactions.goPage(!pageNumber)

endmethod
-- End of method definition for .apply()
