--
--
-- Description:
-- Form definition to allow Import and Export of data to and
-- from offline project locations.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbTransfer

-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!glbTransfer resize

  !!glbTransfer.formTitle     = 'Offline Data Transfer'
  !!glbTransfer.iconTitle     = 'DTRAN'
  !!glbTransfer.callback      = 'call !!glbTransferInit()'
  !!glbTransfer.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  option .action at x 0 y 0.2 anchor top+left |Transfer Operation| width 15

  frame .locFrame at xmin ymax+0.2 anchor all |Project Locations|
    list .loc at xmin+1 ymin+1 anchor all columns width 45  height 10
  exit

  button .apply at xmin ymax+0.5 anchor bottom+left |  OK  | call |call !!glbTransfer()|  OK
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

exit
-- End of form definition for !!glbTransfer

-- Assign action gadget values
!dText.append('Export Data')
!dText.append('Import Data')
!!glbTransfer.action.dText  = !dText
!dText.clear()
!rText.append('EXPORT')
!rText.append('IMPORT')
!!glbTransfer.action.rText  = !rText
!rText.clear()
