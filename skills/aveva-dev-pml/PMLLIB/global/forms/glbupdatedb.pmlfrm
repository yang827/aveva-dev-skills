-- File:            glbupdatedb.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Wed June 18 16:19:36 BST 1997
--
--
-- Description:
-- For definition to allow for the specification of an out of
-- phase update with a directly connected location.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  act()                            -                   Function to set the action to be performed upon apply for this
--  cbAll()                          -                   This method selects all db in the db gadget.
--  cbApply()                        -                   Function to perform and PDMS Global UPDATE command based upon the
--  cbClear()                        -                   clears the selection!
--  cbDbSelection()                  -                   select all db Currently on-screen
--  glbUpdateDb()                    -                   Constructor
--  init()                           -                   Function to initialise the !!glbUpdateDb form.
--  list()                           -                   Function to act as a callback to the Sort and Filter gadgets
--  locn()                           -                   Function to maintain the list of databases that are common
--
------------------------------------------------------------------------

-- Define form
setup form !!glbUpdateDb resize

  !this.formTitle     = 'Unscheduled Database Update'
  !this.iconTitle     = 'UPD DB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.17 $ '

  -- Body of form definition
  list .locn at x 1 y 0 |Update With Location| anchor t+l+r call |!this.locn()| columns width 50 height 5

  frame .dbFrame at x 0  ymax |Allocated Databases| anchor all

    option .act      at xmin+1 ymin+1 |Update        | call |!this.act()| width 18
    path down
    halign left
    option .whichDbs |Type          | call |!this.list()| width 18
    list   .db       call |!this.cbDbSelection()| anchor all MULTIPLE columns width 50 height 15
    option .sort     |Sort By| anchor b+l call |!this.list()| width 12
    text   .filter   at xmax+1 ymin |Filter| anchor b+r call |!this.list()| width 20 STRING
    button .all      at xmax.act+5 ymin.act   | All | anchor t+r call |!this.cbAll()|
    button .clear    at xmin.all ymin.whichDbs |Clear| anchor t+r call |!this.cbClear()|

  exit

  button .apply   at x 0 ymax+0.5        |Apply| anchor b+l call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| anchor b+r CANCEL

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All|,|!this.db.select('rtext',!this.db.rText)|)
    !this.dbPopupMenu.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.db)|,|DBSET|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.db.clearSelection()|)
    !this.db.setPopup(!this.dbPopupMenu)

  -- Member Definitions
    -- Object serving this form
    member .glbSynchronise is GLBSYNCHRONISE
    -- Array of project databases
    member .dbArray       is ARRAY
    -- Array of DB sets
    member .dbArraySet    is ARRAY
    -- Array of MDBS
    member .mdbArray      is ARRAY
    -- Array storing previous Selection
    member .prevSelection is ARRAY
    -- Selected location
    member .location      is DBREF
    -- Sort and Filter gadget memory
    member .dbFilter      is STRING
    member .dbSort        is STRING
    member .init          is BOOLEAN

exit
-- End of form definition for !!glbUpdateDb

------------------------------------------------------------------------
--
-- Method:      .glbUpdateDb()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbUpdateDb()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- Assign Upd option gadget values
  !dText.append(|Selected Databases|)
  !dText.append(|All Databases|)
  !this.act.dText  = !dText
  !dText.clear()
  !rText.append(|SEL|)
  !rText.append(|ALL|)
  !this.act.rText  = !rText
  !rText.clear()

  -- Assign whichDbs gadget values
  !dText.append(|User Databases|)
  !dText.append(|System Databases|)
  !dText.append(|DB Sets|)
  !dText.append(|MDBs|)
  !this.whichDbs.dText  = !dText
  !dText.clear()
  !rText.append(|USER|)
  !rText.append(|SYSTEM|)
  !rText.append(|DBSET|)
  !rText.append(|MDB|)
  !this.whichDbs.rText  = !rText
  !rText.clear()

  -- if at hub in Global 1, then there are no secondary system DB's to update
--  if(!!glbHubStatus(!!glbIsGlobal()) and !!admControl.isValid('Centralised Admin').not() ) then
--    !this.whichDbs.select(|rtext|,|USER|)
--    !this.whichDbs.active = false
--  endif

   -- Assign Sort gadget values
  !!admDbSortGadg(!this.sort)

  -- Set filter gadget
  !this.filter.val = |*|

  -- initialise object serving this form
  !this.glbSynchronise.parentForm(!this)
  !this.glbSynchronise.operation('UPDATE')

endmethod
-- End of form definition for !!glbUpdateDb

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Function to perform and PDMS Global UPDATE command based upon the
-- selected databases. The update is an unscheduled propagation event.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  !this.glbSynchronise.cbUpdate()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .act()
--
-- Description: Function to set the action to be performed upon apply for this
-- form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .act()

  !this.glbSynchronise.act()

endmethod
-- End of method definition for .act()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Function to initialise the !!glbUpdateDb form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.init = TRUE

  !this.glbSynchronise.initUpdate()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .list()
--
-- Description: Function to act as a callback to the Sort and Filter gadgets
-- in the !!glbUpdateDb form. Function control the DB list gadget
-- contents based on the sort and filter gadget values.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .list()

  !this.glbSynchronise.list()

endmethod
-- End of method definition for .list()

------------------------------------------------------------------------
--
-- Method:      .locn()
--
-- Description: Function to maintain the list of databases that are common
-- to the current location and the update location for this form.
-- (Unscheduled updates).
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locn()

  -- Update the database list contents
  !this.glbSynchronise.commonDb()

endmethod
-- End of method definition for .locn()
------------------------------------------------------------------------
--
--Method: .cbDbSelection()
--
-- Description: select all db Currently on-screen
-- to be reinforced in the cbApply()
--
