--
-- File:            glbupdord.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application
--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Fri Nov 7 10:26:18 GMT 1997
--
-- Description:
-- Form definition for the Update Order form.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoReorder()                    -                   Automatically reorder list
--  glbUpdOrd()                      -                   Constructor
--  init()                           -                   Initialisation
--  listAlloc()                      -                   List the allocation order for the current location
--  listLocations()                  -                   List locations
--  move()                           -                   Move selected row
--  reorder(GADGET,STRING)           -                   Reorder selected row in list
--  select()                         -                   Select row to move
--  selectDB()                       -                   Activate buttons according to data
--  selectLocation()                 -                   Select location
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!glbUpdOrd

-- Define form
setup form !!glbUpdOrd at xr 0.35 yr 0.1 resize

  !!glbUpdOrd.formTitle     = 'Update Order'
  !!glbUpdOrd.iconTitle     = 'UPD ORD'
  !!glbUpdOrd.callback      = '!this.init()'
  !!glbUpdOrd.formRevision  = ' $Revision: 1.4 $ '

  -- Icons
  !downIcon     = !!pml.getPathName(|downarrow16.png|)
  !downDownIcon = !!pml.getPathName(|downdownarrow16.png|)
  !upIcon       = !!pml.getPathName(|uparrow16.png|)
  !upUpIcon     = !!pml.getPathName(|upuparrow16.png|)

  -- Body of form definition
  frame .locFrame |Project Locations| anchor top+left+right

    list   .loc    at xmin+1 ymin+1           anchor top+left+right columns width 60 height 8
    option .sort   at xmin ymax+0.2 |Sort By| anchor top+left width 12
    text   .filter at xmax+1 ymin   |Filter|  anchor top+left width 15 STRING

  exit

  -- Frame containing allocation details.
  frame .allocFrame at xmin ymax+0.5 |Allocation Order| anchor all

    list .alloc at xmin+1 ymin+1 anchor all columns width 56 height 10

    -- Reordering buttons
    button .upUp     tooltip |Move to top|    anchor top+right pixmap "$!<upUpIcon>"     width 16 height 16 at xmax+1 ymin+1
    button .up       tooltip |Move up|        anchor top+right pixmap "$!<upIcon>"       width 16 height 16 at xmin ymax+0.5
    button .down     tooltip |Move down|      anchor top+right pixmap "$!<downIcon>"     width 16 height 16 at xmin ymax+0.5
    button .downDown tooltip |Move to bottom| anchor top+right pixmap "$!<downDownIcon>" width 16 height 16 at xmin ymax+0.5

    -- Move to row number buttons
    button .select at xmin.alloc ymax.alloc+0.2 |Select row to move| anchor bottom+left width 14
    para   .from   at xmax+1 ymin anchor bottom+left width 4 lines 1
    button .move   at xmax+1 ymin |Move to| anchor bottom+left width 6
    para   .to     at xmax+1 ymin anchor bottom+left width 4 lines 1

    -- Auto update button
    button .auto at xmax.alloc-size ymin |Automatic Re-order| anchor bottom+right width 14

  exit

  -- Array of project locations
  member .locArray      is ARRAY
  -- Current Location
  member .locRef        is DBREF
  -- Sort and filter values
  member .filterVal     is STRING
  member .sortVal       is STRING
  -- Allocation
  member .allocArray    is ARRAY
  -- Selected row to move
  member .selectedRow   is REAL
  member .moveToRow     is REAL

exit
-- End of form definition for !!glbUpdOrd

--------------------------------------------------------------------------
-- Method:      .glbUpdOrd()
--
-- Description: Constructor
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .glbUpdOrd()

  -- Assign sort gadget values
  call !!admLocSortGadg(!this.sort)

  -- Assign filter gadget values
  !this.filter.val  = |*|

  -- Callbacks
  !this.loc.callback           = |!this.selectLocation()|
  !this.sort.callback          = |!this.listLocations()|
  !this.filter.callback        = |!this.listLocations()|
  !this.alloc.callback         = |!this.selectDB()|
  !this.auto.callback          = |!this.autoReorder()|
  !this.upUp.callback          = |!this.reorder(|
  !this.up.callback            = |!this.reorder(|
  !this.down.callback          = |!this.reorder(|
  !this.downDown.callback      = |!this.reorder(|
  !this.select.callback        = |!this.select()|
  !this.move.callback          = |!this.move()|

  -- Set selected row to move
  !this.selectedRow = 0
  !this.moveToRow   = 0

endmethod

--------------------------------------------------------------------------
-- Method:      .init()
--
-- Description: Initialisation
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Restore sort and filter values
  if (!this.sortVal.set()) then
    !this.sort.select('rtext', !this.sortVal)
    !this.filter.val = !this.filterVal
  endif

  -- Set selected row to move
  !this.selectedRow = 0
  !this.moveToRow   = 0
  !this.from.val = ||
  !this.to.val   = ||

  -- Get the project locations
  !this.locArray.clear()
  !this.locArray = !!collectAllFor('LOC', '', !!dbrAdminGetWorld('LOC'))
  !this.listLocations()

endmethod

--------------------------------------------------------------------------
-- Method:      .listLocations()
--
-- Description: List locations
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .listLocations()

  -- Save sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.sortVal   = !this.sort.selection('rtext')
  !this.filterVal = !this.filter.val

  -- Refresh the locations list
  !this.loc.clear()
  !displayRefs = !!adminFilterSort(!this.locArray, !this.sort, !this.filter)
  call !!adminLocnTxtList(!displayRefs, !this.loc)

  -- Try to select the previous selection
  !this.loc.select('rtext', !this.locRef.string())
  handle any
    -- Ignore any error
  endhandle
  !this.selectLocation()

endmethod

--------------------------------------------------------------------------
-- Method:      .selectLocation()
--
-- Description: Select location
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectLocation()

  -- Set the new location selection if different or the allocation has changed
  !selection = !this.loc.selection('rtext').dbRef()
  !allocationChanged = false
  if (!this.locRef.set()) then
    !allocationChanged = (!this.allocArray ne !this.locRef.dball)
  endif
  if (!this.locRef ne !selection or !allocationChanged) then
    !this.locRef = !selection
    !this.listAlloc()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      listAlloc
--
-- Description:
--   List the allocation order for the current location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .listAlloc()

  -- Clear current settings
  !this.allocArray.clear()
  !this.alloc.clear()
  !this.selectedRow = 0
  !this.moveToRow   = 0
  !this.from.val = ||
  !this.to.val   = ||

  -- Display a prompt
  !!messageFile.prompt(141, 004, !this.formTitle, 'DB')

  -- Get the allocation for the current location
  if (!this.locRef.set()) then
    !this.allocArray = !this.locRef.dball
  endif

  -- Refresh the list
  if (!this.allocArray.set()) then
    call !!adminDbTxtList(!this.allocArray, !this.alloc, !!admDisplayConfig.fmtOrderedDbGet(), !!admDisplayConfig.eleTypeGet(), object DBREF())
  endif

  -- Dismiss the prompt
  call !!prompt(0)

  -- Activate buttons
  !this.selectDB()

endmethod

------------------------------------------------------------------------
-- Method:      reorder
--
-- Description:
--   Reorder selected row in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .reorder(!gadget is GADGET, !dummyAction is STRING)

  -- Reorder the allocation list
  !!ce  = !this.locRef
  FIRST MEMBER
  !current = !this.alloc.val
  !newPosition = 0
  if (!gadget eq !this.upUp) then
    !newPosition = 1
    REORDER $!current BEFORE 1
  elseif (!gadget eq !this.up) then
    if (!current gt 1) then
      !newPosition = !current - 1
      REORDER $!current before $!newPosition
    endif
  elseif (!gadget eq !this.down) then
    if (!current lt !this.alloc.dtext.size()) then
      !newPosition = !current + 1
      REORDER $!current AFTER $!newPosition
    endif
  elseif (!gadget eq !this.downDown) then
    !newPosition = !this.alloc.dtext.size()
    REORDER $!current AFTER $!newPosition
  endif
  END

  -- Update the allocation list
  !this.listAlloc()
  -- Select the row just moved to and activate the gadgets
  if (!newPosition gt 0) then
    !this.alloc.val = !newPosition
  endif
  !this.selectDB()

endmethod

------------------------------------------------------------------------
-- Method:      autoReorder
--
-- Description:
--   Automatically reorder list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .autoReorder()

  -- Initialise variables
  !typeDb     = !!admTypeDbGet()
  !newAlloc   = ARRAY()
  !dbName     = ARRAY()
  !dbType     = ARRAY()

  -- Display a prompt
  !!messageFile.prompt(141, 549, !this.locRef.locId)

  -- Reorder first by extract order
  SORTALLOCATE $!<this.locRef>

  -- Evaluate the names and types of databases
  !allocation = !this.locRef.dball
  do !db values !allocation
    !dbName.append(!db.name.substring(3))
    !dbType.append(!db.typeDb)
  enddo

  -- Evaluate the database type order
  !orderBlock = object BLOCK(|!typeDb[!evalIndex].order|)
  !orderNo    = !typeDb.evaluate(!orderBlock)
  !typeOrder  = !orderNo.sortedIndices()

  -- Process the database list to get order by db type
  do !i values !typeOrder
    -- Collect databases of the same type
    !$!<typeDb[$!i].type>Db = ARRAY()
    !indices    = !dbType.find(!typeDb[!i].type)
    do !index values !indices
      !$!<typeDb[$!i].type>Db.append(!allocation[!index])
    enddo
    !newAlloc.appendArray(!$!<typeDb[$!i].type>Db)
  enddo

  -- Re-order the current locations allocation
  !size = !allocation.size()
  !!ce  = !this.locRef
  FIRST MEMBER
  do !db values !newAlloc
    !name = !db.name
    REORDER $!name AFTER $!size
  enddo
  END

  -- Dismiss the prompt
  call !!prompt(0)

  -- Update the allocation list
  !this.listAlloc()

endmethod

------------------------------------------------------------------------
-- Method:      select
--
-- Description:
--   Select row to move
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .select()

  -- Store current row so can be moved later
  !this.selectedRow = !this.alloc.val
  !this.moveToRow = 0
  !this.from.val = ||
  !this.to.val = ||
  if (!this.selectedRow gt 0) then
    !this.from.val = !this.selectedRow.string()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      move
--
-- Description:
--   Move selected row
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .move()

  -- Move selected row
  if (!this.selectedRow gt 0 and !this.moveToRow gt 0 and !this.selectedRow ne !this.moveToRow) then
    !newPosition = !this.moveToRow
    !!ce = !this.locRef
    FIRST MEMBER
    if (!this.moveToRow gt !this.selectedRow) then
      REORDER $!<this.selectedRow> AFTER $!<this.moveToRow>
    else
      REORDER $!<this.selectedRow> BEFORE $!<this.moveToRow>
    endif
    END
    -- Update the allocation list
    !this.listAlloc()
    -- Select the row just moved to and activate the gadgets
    !this.alloc.val = !newPosition
    !this.selectDB()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      selectDB
--
-- Description:
--   Activate buttons according to data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .selectDB()

  -- Set move to row text
  !this.to.val = ||
  if (!this.alloc.val gt 0) then
    if (!this.selectedRow gt 0) then
      if (!this.alloc.val ne !this.selectedRow) then
        !this.moveToRow = !this.alloc.val
        !this.to.val = !this.moveToRow.string()
      endif
    endif
  endif

  -- Activate buttons that act on list selection
  !this.upUp.active     = (!this.alloc.val gt 1)
  !this.up.active       = (!this.alloc.val gt 1)
  !this.down.active     = (!this.alloc.val gt 0 and !this.alloc.val lt !this.alloc.dtext.size())
  !this.downDown.active = (!this.alloc.val gt 0 and !this.alloc.val lt !this.alloc.dtext.size())
  !this.select.active   = (!this.alloc.val gt 0)
  !this.move.active     = (!this.selectedRow gt 0 and !this.moveToRow gt 0)

endmethod
