-- Created:         Fri Oct 30 9:28:45 GMT 1998
--
--
-- Description:
-- Form to display all the projects user data at a Location.
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbLocs()                         -                   To change SYS DB if location has changed and get info and return
--  generateUsers()                  -                   To query the open SYS DB and get an array of Users and place it
--  getTeams()                       -                   While interrogate the local SYS db that is open to
--  getUsers()                       -                   While interrogate the local SYS db that is open to
--  init()                           -                   Method to initialise the data for the User List form
--

setup form !!glbUserList resize

  !!glbUserList.formTitle     = |User List|
  !!glbUserList.iconTitle     = |USER LIST|
  !!glbUserList.callback      = |!!glbUserList.init()|
  !!glbUserList.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition
  option .location |Location Queried | at xmin y0.5 anchor left+top call |!this.cbLocs()|   width 9

  list .users 'Users' at xmin ymax anchor left+top+bottom call |!this.getTeams()| width 12 length 14

  path right
  valign bottom

  -- Information
  list .teams |Details| anchor all width 43 length 14

  button .dismiss at xmax form-size ymax |Dismiss| anchor right+bottom OK

  -- Member Definitions
  -- To Store current admin Context
  member .initAdmdLoc is DBREF
  -- A list of the Location Objects
  member .locList is ARRAY
  -- A list of Users
  member .userList is ARRAY
  -- Another List of Users (Not to be sorted)
  member .allUserList is ARRAY

exit
-- End of form definition for !!glbUserList

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the User List form
-- depending on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Set member to indicate current loc
   !this.initAdmdLoc  = !!adminApplic.getAdmContext()

  -- initialise Location Gadget
  !this.location.clear()

  -- Get a list of locations which are on-line
  !clause = |LINIT EQ TRUE|
  !resultingLocs = !!collectAllFor(|loc|,!clause,!!dbrAdminGetWorld(|LOC|))
  !textOfLocs = ARRAY()

  -- Rebuild list of Locs
  !this.locList.clear()

  do !i values !resultingLocs
    -- Then we will have the local details
    if (!this.initAdmdLoc EQ !i) then
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
      -- To insure Initial Location is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !this.locList.invert()
    else
      if(!!dbrGlbCurLocRf() EQ !i) then
        !textOfLocs.append(|LOCAL|)
        !this.locList.append(!i)
      else
        !textOfLocs.append(!i.locId)
        !this.locList.append(!i)
      endif
    endif
  enddo

  !this.location.dText = !textOfLocs

  -- Generate a list of users for this location
  !this.generateUsers()

  --Get the Users
  !this.getUsers()

  -- Get The Teams
  !this.getTeams()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getUsers()
--
-- Description: While interrogate the local SYS db that is open to
-- return a list of Users
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getUsers()

  -- This uses a function which returns all users
  !resultingUsers = !this.allUserList
  -- Clear the current lists of Users
  !this.userList.clear()
  !this.users.clear()

  -- Loop through all the users for this location
  do !i indices !resultingUsers
    if (!!sessionSettings.showAs eq |DESC|) then
      !tList[!i] = !resultingUsers[!i].description
      if (!tList[!i].unset() or !tList[!i].empty()) then
        !tList[!i] = !resultingUsers[!i].name
      else
        -- removes whitespace
        !tList[!i] = !tList[!i].trim()
      endif
    else
       !tList[!i] = !resultingUsers[!i].name
    endif
  enddo

  !this.userList = !resultingUsers

  -- Sort the list of db and place them in the list gadget
  !sortOrder = !tList.sortedIndices()
  !tList.reIndex(!sortOrder)
  !this.userList.reIndex(!sortOrder)

  !this.users.dText = !tList

endmethod
-- End of method definition for .getUsers()

------------------------------------------------------------------------
--
-- Method:      .getTeams()
--
-- Description: While interrogate the local SYS db that is open to
-- return a list of Teams and display the current users details
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getTeams()

  -- Initialise Variables
  !detail = ARRAY()

  -- Clear the current Team lists
  !this.teams.clear()

  -- Check there are some Users
  if(!this.users.val EQ 0)then
    return
  endif

  -- Get the current selected User
  !cUser       = !this.userList[!this.users.val]

  -- Set the selected userNames description if applicable
  !desc = !cUser.description
  if (!desc.unset() or !desc.empty()) then
    !detail.append('Description : unset')
  else
    !detail.append('Description : ' & !desc)
  endif

  -- Show the selected users Privilege level
  !uPriv = !cUser.access
  !detail.append('  Privilege : ' & !uPriv)

  !detail.append('')
  !detail.append('Teams')

  -- Process the selected users teamlist to get display texts
  !teamNames = !cUser.teamName
  !teamDescs = !cUser.teamDesc

  !this.teams.clear()

  do !i indices !teamNames
    if (!!sessionSettings.showAs eq |DESC|) then
      !tList[!i] = !teamDescs[!i]
      if (!tList[!i].unset() or !tList[!i].empty()) then
        !detail.append('  ' & !teamNames[!i])
      else
        !detail.append('  ' & !tList[!i].trim())
      endif
    else
      !detail.append('  ' & !teamNames[!i])
    endif
  enddo

  -- Display the constructed array if it has elements
  if(!detail.empty().not()) then
    !this.teams.dText = !detail
  endif

endmethod
-- End of method definition for .getTeams()


------------------------------------------------------------------------
--
-- Method:      .cbLocs()
--
-- Description: To change SYS DB if location has changed and get info and return
-- to initial location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .cbLocs()

  -- Get The currently Selected Location
  !currLocation   = !this.locList[!this.location.val]

  -- Administer new location
  ADMINISTER SYSTEM AT '$!currLocation.locId' READONLY
  !this.generateUsers()
  ADMINISTER SYSTEM AT '$!this.initAdmdLoc.locId'

  !this.getUsers()
  !this.getTeams()

endmethod
-- End of method definition for .cbLocs()

------------------------------------------------------------------------
--
-- Method:      .generateUsers()
--
-- Description: To query the open SYS DB and get an array of Users and place it
-- form member !this.allUserList in non sys db specific format
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .generateUsers()

  !this.allUserList.clear()
  !theUsers = USERS
  do !i values !theUsers
    !temp = object GLBUSER()
    !temp.user2GlbUser(!i)
    !this.allUserList.append(!temp)
  enddo
endmethod
-- End of method definition for .generateUsers()
