--
--
-- Description: Timed up for Merging data changes form
--
------------------------------------------------------------------------
-- Define form
setup form !!timeDate

  -- Members
  member .mergeTime  is DATETIME

  paragraph .timeDate width 38 lines 2

  path down

-- Body of form definition
  frame .times 'Time & Date'
    text     .time  tagwid 20 'Time: HH:MM'  width 5  string
    text     .date  tagwid 20 'Date: Day Mon Year  ' width 11  string
  exit

  path right
  button .ok   at x 0.2 ymax+0.5 | OK | call |!this.ok()| OK
  button .dismiss at xmax form-size ymin |Cancel| CANCEL

  exit
-- Exit form definition

  define method .timeDate()

-- Adds a description to the form
  !this.timeDate.val = |Please enter the time and date for the merge to take place|

  !this.formTitle     = 'Timed Merge'

-- Callbacks
  !this.callback      = '!this.init()'
  !this.time.callback = '!this.check()'
  !this.date.callback = '!this.check()'

  endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise the form
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .init()
-- Sets variables with the current time and date
  !date = object DATETIME()

-- Split the date variable
  !hour = !date.hour()
  !minute = !date.minute()
  if (!hour lt 10) then
    !hourString = '0' & !hour.string()
  else
    !hourString = !hour.string()
  endif
  if (!minute lt 10) then
    !minuteString = '0' & !minute.string()
  else
    !minuteString = !minute.string()
  endif

  !time = !hourString & ':' & !minuteString
  !dateTime = !date.date() & ' ' & !date.monthString().substring(1,3) & ' ' & !date.year()

-- Sets the current time on the form
  !this.time.val = !time
  !this.date.val = !dateTime

  endmethod
------------------------------------------------------------------------
--
-- Method:      .check()
--
-- Description: check the date and time are correct and that it is later than the current time
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .check()

  !time = !this.time.val
  !date = !this.date.val

  !hour = !time.before(':').real()
  handle ANY
    !!alert.error('Invalid time')
    !this.init()
  endhandle
  !minute = !time.after(':').real()
  handle ANY
    !!alert.error('Invalid time')
    !this.init()
  endhandle

  !day = !date.split()[1].real()
  handle ANY
    !!alert.error('Invalid date')
    !this.init()
  endhandle

  !month = !date.split()[2]
  handle ANY
    !!alert.error('Invalid date')
    !this.init()
  endhandle

  !year = !date.split()[3].real()
  handle ANY
    !!alert.error('Invalid date')
    !this.init()
  endhandle

  !this.mergeTime = object DATETIME(!year, !month, !day, !hour, !minute)
  handle ANY
    !!alert.error('Invalid date time')
    !this.init()
  endhandle

  endmethod
------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: set the time on the calling form
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .ok()

  -- Check the time is later than the current time
  !now = object DATETIME()
  if (!this.mergeTime lt !now) then
    !answer = !!alert.confirm('The requested time is earlier than the current time. Do you want to continue? If so the merge will be done immediately')
    if (!answer.boolean().not()) then
      show !!timeDate
      return
    endif
  endif

  !!glbRmtMerge.timed     = TRUE
  !!glbRmtMerge.mergeTime = !this.mergeTime

  endmethod
