--
--
-- Description:
-- A function to return Boolean if the Current Admin Context can be administered from this physical Location.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN  True is physical loc can administer current admin context
------------------------------------------------------------------------

define function !!glbAdminSysDb() is BOOLEAN
  if((!!dbrGlbHubLocRf() EQ !!dbrGlbCurLocRf()) AND ( !!adminApplic.getAdmContext()  EQ !!dbrGlbHubLocRf()) )then
    return TRUE
  else
    if( !!adminApplic.getAdmContext().prmRf EQ !!dbrGlbCurLocRf())then
      return TRUE
    else
      return FALSE
    endif
  endif
endfunction
-- End of function definition for !!glbAdminSysDb
