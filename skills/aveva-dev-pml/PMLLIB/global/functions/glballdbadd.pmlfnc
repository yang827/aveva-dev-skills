--
--
-- Description:
-- Callback to add gadget to add selected project locations to the
-- current database allocation list.
-- Function to be replaced by method !!glbAllDb.cbAdd()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAdd()

  -- Initialise variables
  !selection    = !!glbAllDb.locn.val
  !locations    = ARRAY()
  !parents      = ARRAY()
  !levels       = ARRAY()

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  endif

  -- Get current location data
  call !!glbAllDbLocGet(!locations, !parents, !levels)

  -- Process the selection list
  do !index values !selection

    !dbRef        = !!glbAllDb.locn.rText[!index].dbRef()
    handle any
      -- Bad location
      skip
    endhandle

    -- Ensure allocations between the current location
    -- and a parent location are in the list
    do

      -- Add the location to allocation
      call !!glbAllDbAllocAdd(!dbRef)

      -- Get loop variables
      !allocation   = !!glbAllDbAllocGet()
      !pos          = !locations.findFirst(!dbRef)
      !parent       = !parents[!pos]

      -- Trap off-line location or hub
      if (!parent.unset()) then
        break
      endif

      -- See if the parent is in the allocation
      !parentPos    = !allocation.findFirst(!parent)
      if (!parentPos.set()) then
        break
      endif

      -- Continue loop
      !dbRef        = !parent

    enddo

  enddo

  -- Update the allocation list gadgets
  call !!glbAllDbAllocLst()

endfunction
-- End of function definition for !!glbAllDbAdd
