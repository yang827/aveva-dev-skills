--
--
-- Description:
-- Callback function to add all location to the current databases
-- allocation list in the Allocation By Database form
-- Function to be replaced by method !!glbAllDb.cbAAll()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAddAll()

  -- Initialise variables
  !allocation  = !!glbAllDbAllocGet()
  !locations   = ARRAY()
  !parents     = ARRAY()
  !levels      = ARRAY()

  -- Get location data
  call !!glbAllDbLocGet(!locations, !parents, !levels)

  -- Get additional locations to add
  !addLocs     = !locations.difference(!allocation)

  -- Add remaining locations
  do !dbRef values !addLocs
    call !!glbAllDbAllocAdd(!dbRef)
  enddo

  -- Update allocation list gadgets
  call !!glbAllDbAllocLst()

endfunction
-- End of function definition for !!glbAllDbAddAll
