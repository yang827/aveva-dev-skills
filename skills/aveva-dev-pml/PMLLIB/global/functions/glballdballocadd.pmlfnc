--
--
-- Description:
-- Function to add a location DBREF to the current allocation in the
-- Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.allocAdd(!dbRef)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     DBREF       Dbref of location to add to list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAllocAdd(!dbRef is DBREF)

  -- Append values to array
  !!glbAllDb.allocRef.append(!dbRef)

  -- Ensure only one of each
  !!glbAllDb.allocRef.unique()

endfunction
-- End of function definition for !!glbAllDbAllocAdd
