--
--
-- Description:
-- Function to control the contents of the Location list gadgets in
-- the Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.allocList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAllocLst()

  -- Initialise variables
  !primaryLoc  = !!glbAllDbPriGet()
  !locations   = ARRAY()
  !parents     = ARRAY()
  !levels      = ARRAY()
  !alloc       = ARRAY()
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Get location data
  call !!glbAllDbLocGet(!locations, !parents, !levels)
  !alloc       = !!glbAllDbAllocGet()

  -- Construct the project locations first
  !projLocs    = !locations.difference(!alloc)

  -- Sort the project location list by name
  !nameBlock   = object BLOCK(|!projLocs[!evalIndex].name|)
  !locNames    = !projLocs.evaluate(!nameBlock)
  !order       = !locNames.sortedIndices()
  !projLocs.reIndex(!order)

  -- Add location to list gadget
  !!glbAllDb.locn.clear()
  call !!adminLocnTxtList(!projLocs, !!glbAllDb.locn)

  -- Construct Allocation list
  !allocList   = !locations.intersect(!alloc)

  -- Process the allocation list
  do !loc values !allocList

    !index       = !locations.findFirst(!loc)
    !level       = !levels[!index]
    !name        = !loc.name.substring(2)
    !locId       = !loc.locId
    !pad         = ||
    if (!loc eq !primaryLoc) then
      !priFlag     = |+|
    else
      !priFlag     = |-|
    endif

    if (!level gt 0) then
      do from 1 to !level
        !pad         = !pad + |   |
      enddo
    endif
    !text        = !pad +|[|+ !locId +|]|+ !priFlag +|  |+!name

    !dText.append(!text)
    !rText.append(!loc.string())

  enddo

  -- Assign gadget values
  !!glbAllDb.alloc.dText  = !dText
  !!glbAllDb.alloc.rText  = !rText

endfunction
-- End of function definition for !!glbAllDbAllocLst
