--
--
-- Description:
-- Function to remove a location DBREF from the current allocation in
-- Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.allocRem(!dbRef)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of location to remove
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAllocRem(!dbRef is DBREF)

  -- Find allocation in array
  !pos    = !!glbAllDb.allocRef.findFirst(!dbRef)

  -- Remove element from array
  if (!pos.set()) then
    !!glbAllDb.allocRef.remove(!pos)
  endif

endfunction
-- End of function definition for !!glbAllDbAllocRem
