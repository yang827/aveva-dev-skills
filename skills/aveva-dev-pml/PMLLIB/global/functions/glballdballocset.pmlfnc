--
--
-- Description:
-- Function to get the current allocation from a DB DBREF and save
-- the value in the form member.
-- Function to be replaced by method !!glbAllDb.allocSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbAllocSet()

  -- Initialise variables
  !dbRef               = !!glbAllDbRefGet()
  !!glbAllDb.allocRef  = ARRAY()

  -- Return if DB DBREF is unset
  if (!dbRef.unset()) then
    return
  endif

  -- Get project location data
  !locs                = ARRAY()
  !parents             = ARRAY()
  !levels              = ARRAY()
  call !!glbAllDbLocGet(!locs, !parents, !levels)

  -- Process the project location list
  do !locRf values !locs

    -- Find the DBREF in the allocation list
    !clause              = 'TYPE eq |DB|'
    !alloc               = !locRf.mem[1].mem
    !pos                 = !alloc.findFirst(!dbRef)
    if (!pos.set()) then
      !!glbAllDb.allocRef.append(!locRf)
    endif

  enddo

endfunction
-- End of function definition for !!glbAllDbAllocSet
