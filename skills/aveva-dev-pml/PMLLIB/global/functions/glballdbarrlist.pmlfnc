--
--
-- Description:
-- Function to control the contents of the list gadget for the
-- project databases in the Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.projDbList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbArrList()

  -- Initialise variables
  !projDbs    = !!glbAllDbArrGet()
  !dbRef      = !!glbAllDbRefGet()

  -- Save sort and filter values
  if (!!glbAllDb.filter.val.empty()) then
    !!glbAllDb.filter.val = |*|
  endif
  !!glbAllDb.filterVal  = !!glbAllDb.filter.val
  !!glbAllDb.sortVal    = !!glbAllDb.sort.selection('rtext')

  -- Sort the project databases
  !displayList          = !!adminFilterSort(!projDbs, !!glbAllDb.sort, !!glbAllDb.filter)

  if( !displayList.empty()) then
    !!alert.error('No databases matching filter ' + !!glbAllDb.filterVal + ' - the current selected DB will be displayed')
    !displayList[1] = !dbRef
  endif

  -- Clear the list gadget
  !!glbAllDb.projectDb.clear()

  -- Ensure current DBREF is in the list
  if (!dbRef.set()) then

    -- Find current DB if in the list
    !pos = !displayList.findFirst(!dbRef)
    if (!pos.unset()) then
      -- Select first member
      !dbRef = !displayList[1]
      !!glbAllDbRefSet(!dbRef)
      -- Update the allocations lists
      call !!glbAllDbAllocSet()
      call !!glbAllDbAllocLst()
    endif

  else

    -- Select first member
    !dbRef = !displayList[1]
    !!glbAllDbRefSet(!dbRef)
    -- Update the allocations lists
    call !!glbAllDbAllocSet()
    call !!glbAllDbAllocLst()

  endif

  -- Display the database list
  call !!adminDbTxtList(!displayList, !!glbAllDb.projectDb, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), object DBREF())

  -- Select the current database
  !!glbAllDb.projectDb.select('rtext',!dbRef.string())
  handle any
    -- Only if DBREF is unset
  endhandle

endfunction
-- End of function definition for !!glbAllDbArrList
