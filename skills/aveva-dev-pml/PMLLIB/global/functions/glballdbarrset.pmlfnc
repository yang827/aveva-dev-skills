--
-- Description:
-- Function to collect the array of project database and store them
-- in a form variables for the Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.projDbSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbArrSet()

  -- Initialise variables
  !dbs  = ARRAY()

  -- Collect project databases
  !!ce  = !!dbrAdminGetWorld('TEAM')
  !dbs  = !!collectAllFor('DB','',!!ce)

  -- Store the value
  !!glbAllDb.dbArray  = !dbs

endfunction
-- End of function definition for !!glbAllDbArrSet
