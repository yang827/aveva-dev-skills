--
--
-- Description:
-- Function to initialise the Allocation By Database form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbInit()

  -- Initialise form variables
  call !!glbAllDbArrSet()
  call !!glbAllDbLocSet()

  -- Restore previous sort and filter gadgets
  if (!!glbAllDb.filterVal.set()) then
    !!glbAllDb.filter.val  = !!glbAllDb.filterVal
  endif
  if (!!glbAllDb.sortVal.set()) then
    !!glbAllDb.sort.select('rtext',!!glbAllDb.sortVal)
  endif

  -- Display project databases
  call !!glbAllDbArrList()

  -- Set the current allocation
  call !!glbAllDbAllocSet()

  -- Update the allocation list gadgets
  call !!glbAllDbAllocLst()

endfunction
-- End of function definition for !!glbAllDbInit
