--
--
-- Description:
-- Function to return the form data for project locations, location
-- parents and location levels (in the global tree).
-- Function to be replaced by method !!glbAllDb.locDataGet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       Array of project locations (tree order)
--    2   RW     ARRAY       Array of location parents
--    3   RW     ARRAY       Array of location levels (in tree)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbLocGet(!locs is ARRAY, !parents is ARRAY, !levels is ARRAY)

  -- Set the values for return
  !locs     = !!glbAllDb.locArray
  !parents  = !!glbAllDb.parArray
  !levels   = !!glbAllDb.levArray

endfunction
-- End of function definition for !!glbAllDbLocGet
