--
--
-- Description:
-- Function to call the routine that will return Location Data
-- and store the structure in form variables.
-- Function to be replaced by method !!glbAllDb.locDataSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbLocSet()

  -- Reset form variables
  !!glbAllDb.locArray  = ARRAY()
  !!glbAllDb.parArray  = ARRAY()
  !!glbAllDb.levArray  = ARRAY()

  -- Process on line site below the hub
  !hubRef              = !!dbrGlbHubLocRf()
  call !!dbrLocDataSet(!hubRef, 0, !!glbAllDb.locArray, !!glbAllDb.parArray, !!glbAllDb.levArray)

  -- Get off-line locations
  !!ce                 = !!dbrAdminGetWorld('LOC')
  !offLineLoc          = !!collectAllFor('LOC','iconn eq 0',!!ce)
  !nameBlock           = object BLOCK(|!offLineLoc[!evalIndex].name|)
  !names               = !offLineLoc.evaluate(!nameBlock)
  !order               = !names.sortedIndices()
  !offLineLoc.reIndex(!order)

  -- Process off-line locations
  do !loc values !offLineLoc

    call !!dbrLocDataSet(!loc, 0, !!glbAllDb.locArray, !!glbAllDb.parArray, !!glbAllDb.levArray)

  enddo

endfunction
-- End of function definition for !!glbAllDbLocSet
