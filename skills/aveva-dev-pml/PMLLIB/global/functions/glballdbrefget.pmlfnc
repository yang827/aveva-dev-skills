-- Description:
-- Function to return the current database in the Allocation By
-- Database form
-- Function to be replaced by method !!glbAllDb.refGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of selected database
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbRefGet() is DBREF

  -- Return the value
  return !!glbAllDb.dbRef

endfunction
-- End of function definition for !!glbAllDbRefGet
