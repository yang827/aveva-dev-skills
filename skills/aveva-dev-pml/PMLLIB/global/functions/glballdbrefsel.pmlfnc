--
--
-- Description:
-- Callback to selection of a database in the database list gadget
-- in the Allocation By Database form.
-- Function to be replaced by method !!glbAllDb.refSel()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      List gadget selection was made from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbRefSel(!gadget is GADGET)

  -- Initialise variables
  !curDbRef          = !!glbAllDbRefGet()
  !selectedDb        = !gadget.selection('rtext').dbRef()
  handle (2,107)

    -- Database does not exist in project
    !!messageFile.error(141, 003, $
       !!messageFile.messageString(141, 824), !gadget.selection('rtext'))
    handle (06, 003)
      -- Dummy handle
    endhandle

    call !!glbAllDbRefresh()
    return

  endhandle

  -- Check that the selection is new
  if (!curDbRef eq !selectedDb) then
    return
  endif

  -- Set the new dbref
  call !!glbAllDbRefSet(!selectedDb)

  -- Update the allocations lists
  call !!glbAllDbAllocSet()
  call !!glbAllDbAllocLst()

endfunction
-- End of function definition for !!glbAllDbRefSel
