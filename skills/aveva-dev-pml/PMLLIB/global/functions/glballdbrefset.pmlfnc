--
--
-- Description:
-- Function to store the selected database in the Allocation By
-- Database form. Function also gets the primary location.
-- Function to be replaced by method !!glbAllDb.refSet(!dbRef is DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of database
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbRefSet(!dbRef is DBREF)

  -- Initialise variables
  !curPos            = !!ce
  !primaryLoc        = object DBREF()

  -- Get the primary location
  !!ce               = !dbRef
  handle any
    -- Dummy handle
  elsehandle none
    DBLOC 1
    !primaryLoc        = !!ce.locRf
  endhandle

  -- Save the values
  !!glbAllDb.dbRef   = !dbRef
  !!glbAllDb.primary = !primaryLoc

  -- Restore database position
  !!ce               = !curPos

endfunction
-- End of function definition for !!glbAllDbRefSet
