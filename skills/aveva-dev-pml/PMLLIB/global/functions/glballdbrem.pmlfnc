-- Created:         Wed Sep 3 14:24:14 BST 1997
--
--
-- Description:
-- Callback to remove gadget to remove selected allocated locations from
-- the current databases allocation list.
-- Function to be replaced by method !!glbAllDb.cbRem()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbRem()

  -- Initialise variables
  !database    = !!glbAllDbRefGet()
  !primaryLoc  = !!glbAllDbPriGet()
  !hubRef      = !!dbrGlbHubLocRf()
  !selection   = !!glbAllDb.alloc.val
  !locations   = ARRAY()
  !parents     = ARRAY()
  !levels      = ARRAY()
  !selRefs     = ARRAY()

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  endif

  -- Get all dbrefs for selection
  do !index values !selection

    !dbRef       = !!glbAllDb.alloc.rText[!index].dbRef()
    handle any
      -- Bad location
      skip
    endhandle

    -- Check the selection is not the hub
    if (!dbRef eq !hubRef) then
      !!messageFile.warning(141, 519,  !database.name.substring(3),  !dbRef.locId)
      skip
    endif

    -- Check to see if this is the primary location
    if (!dbRef eq !primaryLoc) then
      !!messageFile.warning(141, 522,  !database.name.substring(3),  !dbRef.locId)
      skip
    endif

    -- Add ref to selection
    !selRefs.append(!dbRef)

  enddo

  -- Get the current location data
  call !!glbAllDbLocGet(!locations, !parents, !levels)

  -- The process order for this must be bottom up
  !order        = !levels.sortedIndices()
  !order.invert()
  !locations.reIndex(!order)
  !parents.reIndex(!order)
  !levels.reIndex(!order)

  !processList  = !locations.intersect(!selRefs)
  !allocation   = !locations.intersect(!!glbAllDbAllocGet())

  -- Process the selected locations
  do !dbRef values !processList

    -- Set deallocation flag true until otherwise
    !deallocate   = true

    -- Set if the current location is a parent of any locations
    !childPos     = !parents.find(!dbRef)
    if (!childPos.set()) then

      -- See if children are in the current allocations
      do !index values !childPos

        !child        = !locations[!index]
        !allocPos     = !allocation.findFirst(!child)
        if (!allocPos.set()) then

          -- Cannot De-Allocate, with children
          !!messageFile.warning(141, 520,  !database.name.substring(3),  !dbRef.locId,  !child.locId)
          !deallocate   = false

        endif

      enddo

    endif

    -- Deallocate database if required
    if (!deallocate) then

      -- Remove location from the allocation
      !allocPos     = !allocation.findFirst(!dbRef)
      !allocation.remove(!allocPos)

    endif

  enddo

  -- Compare the modified allocation list with
  -- allocation list store on the form
  !curAlloc     = !!glbAllDbAllocGet()
  !removeLocs   = !curAlloc.difference(!allocation)

  -- Remove locations
  if (!removeLocs.set()) then

    do !dbRef values !removeLocs
      call !!glbAllDbAllocRem(!dbRef)
    enddo

    -- Update the allocation lists
    call !!glbAllDbAllocLst()

  endif

endfunction
-- End of function definition for !!glbAllDbRem
