-- Created:         Wed Sep 3 16:42:12 BST 1997
--
--
-- Description:
-- Callback function to remove all location (except the hub) from
-- the current database allocation list in from Allocation By Database.
-- Function to be replaced by method !!glbAllDb.cbRAll
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbAllDbRemAll()

  -- Initialise variables
  !database    = !!glbAllDbRefGet()
  !primaryLoc  = !!glbAllDbPriGet()
  !allocation  = !!glbAllDbAllocGet()
  !hubRef      = !!dbrGlbHubLocRf()

  -- Deallocation from all locations not permitted
  -- unless the database is primary at the hub.
  if (!primaryLoc neq !hubRef) then

    -- Raise error
    !!messageFile.error(141, 521,  !database.name.substring(3),  !hubRef.locId)

  endif

  -- Remove locations (except hub)
  do !dbRef values !allocation

    skip if (!dbRef eq !hubRef)
    call !!glbAllDbAllocRem(!dbRef)

  enddo

  -- Update allocation list gadgets
  call !!glbAllDbAllocLst()

endfunction
-- End of function definition for !!glbAllDbRemAll
