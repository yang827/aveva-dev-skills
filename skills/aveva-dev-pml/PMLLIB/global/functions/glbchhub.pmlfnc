--
--
-- Description:
-- Function to action a change hub command
-- Function to be replaced by method !!glbChHub.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbChHub()

  -- Initialise variables
  !location = object DBREF()
  !hubRef   = !!dbrGlbHubLocRf()

  -- Get the selection
  !location = !!glbChHub.locn.selection('rtext').dbRef()
  handle any
    -- Bad DBREF
  endhandle

  -- Check we have a selection
  if (!location.unset()) then
    -- No selection
  endif

  -- Check that the allocations are the same
  !clause       = 'TYPE eq |DB|'
  !currentAlloc = !hubRef.mem[1].mem
  !newAlloc     = !location.mem[1].mem
  !countMissing = !currentAlloc.difference(!newAlloc).size()
  if (!countMissing gt 0) then

    -- Missing databases
    !!messageFile.error(141, 525,  !location.locId)

  endif

  -- New location checks out.
  -- Warn user about change and savework
  !answer       = !!alert.confirm(!!messageFile.messageString(141, 526,  !location.locId))
  if (!answer.boolean().not()) then
    return
  endif

  -- User wants to continue so execute the command
  !locId        = !location.locId
  !command      = |HUBLOCATION '|+ !locId +|'|

  $!command
  handle (1,446)

    -- Allocation lists differ
    !!messageFile.error(141, 525,  !location.locId)

  elsehandle (1,500)

    -- Comms error
    !!messageFile.error(141, 527, !!error.text.part(-1))

  elsehandle (1,501)

    -- Comms error
    !!messageFile.error(141, 528, !!error.text.part(-1))

  elsehandle any

    -- Non-specific error
    !!messageFile.error(141, 529,  !!error.text)

  endhandle

  -- Cannot swap main to itself - use intermediate empty form
  swap main !!emptyForm
  -- Restart the Admin user interface
  call !!adminStart()
  -- For some reason this doesn't appear to work in the
  -- call to adminStart
  swap main to !!adminApplic

endfunction
-- End of function definition for !!glbChHub
