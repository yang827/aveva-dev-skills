--
--
-- Description:
-- Function to initialise the Change Project Hub form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbChHubInit()

  -- Get valid locations
  call !!glbChHubLocSet()

  -- Check that locations are set
  if (!!glbChHubLocGet().unset()) then

    -- No locations to transfer to
    !!messageFile.error(141, 524)

  endif

  -- Restore the sort and filter values
  if (!!glbChHub.filterVal.set()) then
    !!glbChHub.filter.val  = !!glbChHub.filterVal
  endif
  if (!!glbChHub.sortVal.set()) then
    !!glbChHub.sort.select('rtext', !!glbChHub.sortVal)
  endif

  -- Update the list of locations
  call !!glbChHubLocLst()

endfunction
-- End of function definition for !!glbChHubInit
