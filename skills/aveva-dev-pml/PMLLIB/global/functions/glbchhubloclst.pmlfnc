--
--
-- Description:
-- Function to control the contents of the list gadget in the
-- Change Hub form.
-- Function to be replaced by method !!glbChHub.locList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbChHubLocLst()

  -- Initialise variables
  !locations   = !!glbChHubLocGet()

  -- Save sort and filter values
  !!glbChHub.sortVal   = !!glbChHub.sort.selection('rtext')
  !!glbChHub.filterVal = !!glbChHub.filter.val

  -- Sort and filter the list
  !displayRefs = !!adminFilterSort(!locations, !!glbChHub.sort, !!glbChHub.filter)

  -- Display the list of locations
  !!glbChHub.locn.clear()
  call !!adminLocnTxtList(!displayRefs, !!glbChHub.locn)

endfunction
-- End of function definition for !!glbChHubLocLst
