--
--
-- Description:
-- Function to collect and store a list of on-line project
-- locations that may become the new project hub.
-- Function to be replaced by method !!glbChHub.locSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbChHubLocSet()

  -- Initialise variables
  !curPos    = !!ce
  !locArray  = ARRAY()
  !hubRef    = !!dbrGlbHubLocRf()

  -- Get on-line locations
  !!ce       = !!dbrAdminGetWorld('LOC')
  !clause    = 'LINIT eq TRUE and ICONN eq 1 and REF neq '+ !hubRef.string()
  !locArray  = !!collectAllFor('LOC', !clause, !!ce)

  -- Store the value
  !!glbChHub.locArray  = !locArray

  -- Restore database position
  !!ce       = !curPos

endfunction
-- End of function definition for !!glbChHubLocSet
