--
--
-- Description:
-- Callback function to copy the selected location allocation into the
-- allocation of the active location in the Database Allocation By Location
-- form.
-- Function to be replaced by method !!glbCpyAll.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbCpyAll()

  -- Initialise variables
  !sourceLoc   = !!glbCpyAll.loc.selection('rtext').dbRef()
--  !targetLoc   = !!glbAllLocRefGet()
  !tgtAlloc    = ARRAY()
  !tgtDeAlloc  = ARRAY()
  call !!glbAllLocAllGet(!tgtAlloc, !tgtDeAlloc)

  -- Get the source locations allocation
  !!ce         = !sourceLoc
  !clause      = |TYPE eq 'DB'|
  !srcAlloc    = !!ce.mem[1].mem

  -- Create array of databases to add and remove
  !addDb       = !srcAlloc.difference(!tgtAlloc)
  !remDb       = !tgtAlloc.difference(!srcAlloc)

  -- Return if there is no difference
  if (!addDb.unset() and !remDb.unset()) then
    return
  endif

  -- Remove databases
  do !db values !remDb
    call !!glbAllLocAllRem(!db)
  enddo

  -- Add databases
  do !db values !addDb
    call !!glbAllLocAllAdd(!db)
  enddo

  -- Update the lists in the parent form
  call !!glbAllLocAllList()


endfunction
-- End of function definition for !!glbCpyAll
