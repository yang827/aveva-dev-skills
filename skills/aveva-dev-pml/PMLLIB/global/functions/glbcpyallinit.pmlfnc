--
--
-- Description:
-- Function to initialise the Copy Database Allocation form. The form
-- is a child of the Database Allocation (By Database) for,
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbCpyAllInit()

  -- Initialise variables
  !curPos      = !!ce
  !activeLoc   = !!glbAllLocRefGet()

  -- Collect project locations
  !!ce         = !!dbrAdminGetWorld('LOC')
  !clause      = 'REF neq '+ !activeLoc.string()
  !locations   = !!collectAllFor('LOC',!clause,!!ce)

  -- Sort the locations based on name
  !nBlock      = object BLOCK(|!locations[!evalIndex].name|)
  !locNames    = !locations.evaluate(!nBlock)
  !order       = !locNames.sortedIndices()
  !locations.reIndex(!order)

  -- Clear the list gadget
  !!glbCpyAll.loc.clear()

  -- Display list texts
  call !!adminLocnTxtList(!locations, !!glbCpyAll.loc)

  -- Restore the database position
  !!ce         = !curPos

endfunction
-- End of function definition for !!glbCpyAllInit
