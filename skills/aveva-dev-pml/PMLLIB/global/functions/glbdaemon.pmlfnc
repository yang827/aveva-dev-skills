--
--
-- Description:
-- Function to set local daemon parameters of the LCOMC element.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDaemon()

  -- Navigate to LCOMC element
  !!ce = !!dbrAdminGetWorld('LCOM')
  LCOMC 1

  -- Initialise the variables
  !logfile  = !!glbDaemon.file.val
  !logging  = !!glbDaemon.logging.selection('rtext').boolean()
  !level    = !!glbDaemon.level.val.real()

  -- Check the logfile name
  if (!!ce.logFn neq !logfile) then
    LOGFN '$!logfile'
  endif

  -- Check logging state
  if (!!ce.logMs neq !logging) then
    LOGMS $!logging
  endif

  -- Check the diagnostic level
  if (!!ce.logLv neq !level) then
    LOGLV $!level
  endif

  -- Give a message to make the user aware......
  !!alert.message('The Daemon will need to be restarted for any changes to take effect')

endfunction
-- End of function definition for !!glbDaemon
