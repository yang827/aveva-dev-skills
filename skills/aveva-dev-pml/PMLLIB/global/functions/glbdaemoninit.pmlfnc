--
-- Description:
-- Function to initialise the local daemon settings form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDaemonInit()

  -- Navigate to LCOMC element
  !!ce  = !!dbrAdminGetWorld('LCOM')
  LCOMC 1

  -- Initialise the form variables
  !!glbDaemon.file.val    = !!ce.logFn
  !!glbDaemon.level.val   = !!ce.logLv.string()
  !!glbDaemon.logging.select('rtext',!!ce.logMs.string().lowcase())


endfunction
-- End of function definition for !!glbDaemonInit
