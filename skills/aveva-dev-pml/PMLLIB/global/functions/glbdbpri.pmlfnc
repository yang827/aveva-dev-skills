--
--
-- Description:
-- Function to return the selected primary location of a database
-- to the database definition form. Selection of the database is
-- made in the DB Primary Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPri()

  -- Initialise variables
  !primary  = !!glbDbPriRefGet()

  -- Validate the element using callback from
  -- the DB Definition form
  !!admDb.loc(!primary.name)

endfunction
-- End of function definition for !!glbDbPri
