--
--
-- Description:
-- Function to initialise the DB Primary Location form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPriInit()

  -- Initialise variables
  !primary               = !!admDb.locGet()

  -- Save the primary location
  call !!glbDbPriRefSet(!primary)

  -- Restore the sort and filter gadgets
  if (!!glbDbPri.filterVal.set()) then
    !!glbDbPri.filter.val  = !!glbDbPri.filterVal
  endif
  if (!!glbDbPri.sortVal.set()) then
    !!glbDbPri.sort.select('rtext',!!glbDbPri.sortVal)
  endif

  -- Update the list of project locations
  call !!glbDbPriLocSet()
  call !!glbDbPriLocList()

endfunction
-- End of function definition for !!glbDbPriInit
