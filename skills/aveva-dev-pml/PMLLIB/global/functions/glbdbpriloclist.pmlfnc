--
--
-- Description:
-- Function to control the displayed list of LOC elements in the
-- DB Primary Location form.
-- Function to be replaced by method !!glbDbPri.locList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPriLocList()

  -- Initialise variables
  !locations  = !!glbDbPriLocGet()
  !primary    = !!glbDbPriRefGet()

  -- Save the sort and filter values
  if (!!glbDbPri.filter.val.empty()) then
    !!glbDbPri.filter.val =|*|
  endif
  !!glbDbPri.filterVal  = !!glbDbPri.filter.val
  !!glbDbPri.sortVal    = !!glbDbPri.sort.selection('rtext')

  -- Clear the list
  !!glbDbPri.locn.clear()

  -- Sort the location list
  !displayList          = !!adminFilterSort(!locations, !!glbDbPri.sort, !!glbDbPri.filter)

  -- Check that the primary location is in the array
  !pos                  = !displayList.findFirst(!primary)
  if (!pos.unset()) then
    !displayList.insert(1,!primary)
  endif

  -- Display the list of locations
  call !!adminLocnTxtList(!displayList, !!glbDbPri.locn)

  -- Select the current selected primary location
  !!glbDbPri.locn.select('rtext',!primary.string())
  handle any
    -- This should never happen
  endhandle

endfunction
-- End of function definition for !!glbDbPriLocList
