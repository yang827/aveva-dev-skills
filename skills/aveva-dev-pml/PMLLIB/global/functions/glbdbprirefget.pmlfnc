--
-- Description:
-- Function to return the current save primary location DBREF in the
-- DB Primary Location form.
-- Function to be replaced by method !!glbDbPri.refGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of primary location
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPriRefGet() is DBREF

  -- Return the value
  return !!glbDbPri.dbRef

endfunction
-- End of function definition for !!glbDbPriRefGet
