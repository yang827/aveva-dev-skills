--
--
-- Description:
-- Callback to list gadget for selection of the databases primary
-- location.
-- Function to be replaced by method !!glbDbPri.refSel()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPriRefSel()

  -- Get the selected DBREF
  !primary    = !!glbDbPri.locn.selection('rtext').dbRef()
  handle any

    -- Bad location reference
    !!messageFile.error(141, 517,  !!glbDbPri.locn.selection('rtext'))
    handle (06, 517)
      -- Dummy handle
    endhandle

    -- Rebuild list gadget
    call !!glbDbPriLocSet()
    call !!glbDbPriLocList()

    return

  endhandle

  -- Dbref is okay so set the value
  call !!glbDbPriRefSet(!primary)

endfunction
-- End of function definition for !!glbDbPriRefSel
