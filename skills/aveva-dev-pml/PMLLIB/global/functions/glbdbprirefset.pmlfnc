--
-- Description:
-- Function to store the primary location of a database for use in the
-- DB Primary Location form.
-- Function to be replaced by method !!glbDbPri.refSet(!dbRef is DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of primary location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDbPriRefSet(!dbRef is DBREF)

  -- Save the value
  !!glbDbPri.dbRef  = !dbRef

endfunction
-- End of function definition for !!glbDbPriRefSet
