-- Created:         Tue Nov 17 11:10:11 GMT 1998
--
--
-- Description:
-- A function to go from a dbref object to a db object
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       A dbref of a Database
-- Return:
--   [Data Type] [Description]
--     DB         The DB object of said database
--
------------------------------------------------------------------------

define function !!glbDbRef2Db(!theDbRef is DBREF) is DB
  !name = !theDbRef.name.substring(3)
  !allDbs = DBS
  do !i values !allDbs
    if(!i.name EQ !name)then
      return !i
    endif
  enddo
  -- No DB with matching DBREF
  return error 1
endfunction
-- End of function definition for !!glbDbRef2Db
