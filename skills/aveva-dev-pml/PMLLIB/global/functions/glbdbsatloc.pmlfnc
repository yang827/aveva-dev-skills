--     Keyword:     GEN
--   Module:        global
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Mon Nov 16 14:53:20 GMT 1998
--
--
-- Description:
-- A function which given a Location will return an array of DBs currently at location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The location to be queried
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of DBs at the location specified
--
------------------------------------------------------------------------

define function !!glbDbSatLoc(!loc is DBREF) is ARRAY
  !locWorld         = !!dbrAdminGetWorld('LOC')
  !clause           = 'LOCID eq |'+!loc.locId+'|'
  !locs             = !!collectAllFor('LOC',!clause,!locWorld)
  handle any
    return object ARRAY()
  endhandle

  if(!locs.size() EQ 1)then
    -- this is an ultra irritating way of getting to the dbs (and still returns dbrefs anyways)
    return !locs[1].members[1].members
  else
    return object ARRAY()
  endif

endfunction
-- End of function definition for !!glbDbSatLoc
