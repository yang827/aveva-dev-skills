--
--
-- Description:
-- Function read toggle settings from the diagLevel form and
-- create an integer value denoting the current diagnostic level.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDiagLvl()

  -- Initialise variables
  !level   = 0

  -- Check the toggle gadget states
  -- Bit 1
  if (!!glbDiagLvl.bit1.val) then
    !level   = !level + 1
  endif

  -- Bit 2
  if (!!glbDiagLvl.bit2.val) then
    !level   = !level + 2
  endif

  -- Bit 4
  if (!!glbDiagLvl.bit4.val) then
    !level   = !level + 4
  endif

  -- Bit 8
  if (!!glbDiagLvl.bit8.val) then
    !level   = !level + 8
  endif

  -- Bit 16
  if (!!glbDiagLvl.bit16.val) then
    !level   = !level + 16
  endif

  -- Bit 32
  if (!!glbDiagLvl.bit32.val) then
    !level   = !level + 32
  endif

  -- Bit 64
  if (!!glbDiagLvl.bit64.val) then
    !level   = !level + 64
  endif

  -- Bit 128
  if (!!glbDiagLvl.bit128.val) then
    !level   = !level + 128
  endif


  -- Set the gadget value in the parent form
  !!glbDaemon.level.val    = !level.string()

endfunction
-- End of function definition for !!glbDiagLvl
