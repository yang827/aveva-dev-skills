--
--
-- Description:
-- Function to initialise the toggle gadgets on the Diagnostic
-- Level form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbDiagLvlInit()

  -- Navigate to LCOMC element
  !!ce  = !!dbrAdminGetWorld('LCOM')
  LCOMC 1

  -- Initialise variables
  !level                 = !!ce.logLv

  -- Set the toggle gadget values
  -- Bit 128
  if  ((!level - 128) ge 0) then
    !level                 = !level - 128
    !!glbDiagLvl.bit128.val = true
  else
    !!glbDiagLvl.bit128.val = false
  endif

  -- Bit 64
  if ((!level - 64) ge 0) then
    !level                 = !level - 64
    !!glbDiagLvl.bit64.val  = true
  else
    !!glbDiagLvl.bit64.val  = false
  endif

  -- Bit 32
  if ((!level - 32) ge 0) then
    !level                 = !level - 32
    !!glbDiagLvl.bit32.val  = true
  else
    !!glbDiagLvl.bit32.val  = false
  endif

  -- Bit 16
  if ((!level - 16) ge 0) then
    !level                 = !level - 16
    !!glbDiagLvl.bit16.val  = true
  else
    !!glbDiagLvl.bit16.val  = false
  endif

  -- Bit 8
  if ((!level - 8) ge 0) then
    !level                 = !level - 8
    !!glbDiagLvl.bit8.val  = true
  else
    !!glbDiagLvl.bit8.val  = false
  endif

  -- Bit 4
  if ((!level - 4) ge 0) then
    !level                 = !level - 4
    !!glbDiagLvl.bit4.val  = true
  else
    !!glbDiagLvl.bit4.val  = false
  endif

  -- Bit 2
  if ((!level - 2) ge 0) then
    !level                 = !level - 2
    !!glbDiagLvl.bit2.val  = true
  else
    !!glbDiagLvl.bit2.val  = false
  endif

  -- Bit 1
  if ((!level - 1) ge 0) then
    !level                 = !level - 1
    !!glbDiagLvl.bit1.val  = true
  else
    !!glbDiagLvl.bit1.val  = false
  endif


endfunction
-- End of function definition for !!glbDiagLvlInit
