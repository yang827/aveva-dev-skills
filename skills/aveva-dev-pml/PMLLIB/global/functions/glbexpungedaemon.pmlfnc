--
--
-- Description:
-- Function to expunge dead global daemon users from the currently administered project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbExpungeDaemon()

  -- Initialise variables
  !currentAdmLoc = '---'
  if (!!adminApplic.currentAdmLoc.description.length() gt 0) then
    !currentAdmLoc = !!adminApplic.currentAdmLoc.description
  else
    !currentAdmLoc = !!adminApplic.currentAdmLoc.locid
  endif

  -- Get user to confirm the expunge process
  !answer = !!alert.confirm('Ensure the Global Daemon has stopped before expunging...... $
OK to expunge global daemon for ' & !currentAdmLoc & '?')

  if (!answer.boolean().not()) then

    -- User aborted
    return

  endif

  -- Expunge the daemon
  EXPUNGE DAEMON

endfunction
-- End of function definition for !!glbExpungeDaemon
