--
--
-- Description:
-- Function to concatenate the fields in the Comms Frequency form into a
-- valid value.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreq()

-- Create the value
!!glbFreq.owner().timeR.val  = !!glbFreq.min.val    + | | +$
!!glbFreq.hours.val  + | | +$
!!glbFreq.dates.val  + | | +$
!!glbFreq.months.val + | | +$
!!glbFreq.days.val
handle ANY
endhandle

endfunction
-- End of function definition for !!glbFreq
