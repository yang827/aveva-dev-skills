--
--
-- Description:
-- Function to set the date frequency field for the timer value of
-- an update event.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqDates()

  -- Initialise variables
  !value   = ||
  !start   = REAL()
  !end     = REAL()

  -- See if ALL has been selected
  if (_All.val) then
    !!glbFreq.dates.val  = '*'
    return
  endif

  -- Read through the toggle list
  do !i from 1 to 31

    -- Set the gadget name
    !gName  = |00| + !i.string()
    !gName  = |D| + !gName.substring(-2,2)

    -- Don't process gadgets mid range.
    skip if (_$!<gName>.val and !start.set())

    -- Check the gadget is true
    if (_$!<gName>.val and !start.unset()) then
      !start      = !i
    elseif (not _$!<gName>.val) then

      if (!start.set()) then

        -- Check the range of the series
        if (!i eq !start + 1) then
          !value      = !value + !start.string() + |,|
        else
          !end        = !i - 1
          !value      = !value + !start.string() + |-| + !end.string() + |,|
        endif

        -- Reset the series values
        !start      = REAL()
        !end        = REAL()

      endif

    endif

  enddo

  -- Check the last series
  if (!start.set()) then

    -- Check the final value
    if (!start eq 31) then
      !value      = !value + !start.string()
    else
      !value      = !value + !start.string() + |-31|
    endif

  endif

  -- Construct the value to return to gadget
  !value                = !value.trim('R',',')
  if (!value eq '1-31' or !value.empty()) then
    !value   = '*'
  endif

  !!glbFreq.dates.val = !value


endfunction
-- End of function definition for !!glbFreqDates
