--
--
-- Description:
-- Function to toggle the state the toggle gadgets in the
-- Frequency (Dates) form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqDatesAll()

  -- Set the active state
  if (!!glbFreqDates.all.val) then

    -- Gadgets inactive
    !dateState    = false

  else

    -- Gadgets active
    !dateState    = true

  endif

  -- Set the hour gadget states
  do !i from 1 to 31

    !gName  = |00| + !i.string()
    !gName  = |D| + !gName.substring(-2,2)
    !!glbFreqDates.$!<gName>.active  = !dateState

  enddo


endfunction
-- End of function definition for !!glbFreqDatesAll
