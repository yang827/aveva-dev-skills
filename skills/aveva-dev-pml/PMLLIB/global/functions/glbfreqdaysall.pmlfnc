--
--
-- Description:
-- Function to toggle the state the toggle gadgets in the Frequency
-- (Days) form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqDaysAll()

  -- Set the active state
  if (!!glbFreqDays.all.val) then

    -- Gadgets inactive
    !dayState    = false

  else

    -- Gadgets active
    !dayState    = true

  endif

  -- Set the hour gadget states
  do !i from 0 to 6

    !gName  = |00| + !i.string()
    !gName  = |D| + !gName.substring(-2,2)
    !!glbFreqDays.$!<gName>.active  = !dayState

  enddo


endfunction
-- End of function definition for !!glbFreqDaysAll
