--
--
-- Description:
-- Function to initialise the update event frequency (Days)
-- form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqDaysInit()

  -- Initialise variables
  !value     = !!glbFreq.days.val

  -- Check for a asterisk
  if (!value eq '*') then

    !!glbFreqDays.all.val  = true
    !dayToggle             = false

  else

    !!glbFreqDays.all.val  = false
    !dayToggle             = true

  endif

  -- Set the toggle states
  do !i from 0 to 6

    !gName   = |00| + !i.string()
    !gName   = |D| + !gName.substring(-2,2)
    !!glbFreqDays.$!<gName>.val    = false
    !!glbFreqDays.$!<gName>.active = !dayToggle

  enddo

  -- Return if an asterisk
  if (!value eq '*') then
    return
  endif

  -- Break down the values
  !fields    = !value.split(|,|)
  !toggles   = ARRAY()

  -- Process each field
  do !i indices !fields

    -- Split the field to see if its a range
    !atoms     = !fields[!i].split(|-|)

    if (!atoms.size() eq 1) then

      -- Single value
      !toggles.append(!atoms[1].real())

    elseif (!atoms.size() eq 2) then

      -- Range of values
      do !j from !atoms[1].real() to !atoms[2].real()
         !toggles.append(!j)
      enddo

    else
      -- Bad field specification
    endif

  enddo

  -- Set the toggles active as appropriate
  do !i values !toggles

    !gName      = |00| + !i.string()
    !gName      = |D| + !gName.substring(-2,2)
    !!glbFreqDays.$!<gName>.val   = true

  enddo


endfunction
-- End of function definition for !!glbFreqDaysInit
