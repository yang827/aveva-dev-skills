--
--
-- Description:
-- Function to toggle the state the toggle gadgets in the
-- Frequency (Hours) form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqHoursAll()

  -- Set the active state
  if (!!glbFreqHours.all.val) then

    -- Gadgets inactive
    !hourState    = false

  else

    -- Gadgets active
    !hourState    = true

  endif

  -- Set the hour gadget states
  do !i from 0 to 23

    !gName  = |00| + !i.string()
    !gName  = |H| + !gName.substring(-2,2)
    !!glbFreqHours.$!<gName>.active  = !hourState

  enddo


endfunction
-- End of function definition for !!glbFreqHoursAll
