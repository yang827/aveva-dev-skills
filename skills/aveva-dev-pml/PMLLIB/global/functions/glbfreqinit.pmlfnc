--
--
-- Description:
-- Function to initialise the communications event frequency form.
-- The value used must be 5 fields in crontab(1) format.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqInit()
  -- To set form title with respect to its owner.
  if (defined(!!glblcomd) and !!glbFreq.owner().eq(!!glblcomd)) then
    !!glbFreq.formTitle     = 'Update Event Frequency'
  elseif (defined(!!glbMergePurgeTimings) and !!glbFreq.owner().eq(!!glbMergePurgeTimings)) then
    !!glbFreq.formTitle     = 'Merge/Purge Frequency'
  else
    !!glbFreq.formTitle     = ''
    return
  endif

  -- Initialise variables
  !value    = !!glbFreq.owner().timeR.val

  -- Check that the value is unset or five part
  if (!value eq |unset| or !value.empty()) then
    !value  = |0 * * * *|
  endif

  if (!value.split().size() neq 5) then
    !value  = |0 * * * *|
    !!messageFile.warning(141,603)
  endif

  -- Sort the value into the constituent parts
  !minutes  = !value.part(1)
  !hours    = !value.part(2)
  !dates    = !value.part(3)
  !months   = !value.part(4)
  !days     = !value.part(5)

  -- Set the text gadget values
  !!glbFreq.min.val    = !minutes
  !!glbFreq.hours.val  = !hours
  !!glbFreq.dates.val  = !dates
  !!glbFreq.months.val = !months
  !!glbFreq.days.val   = !days


endfunction
-- End of function definition for !!glbFreqInit
