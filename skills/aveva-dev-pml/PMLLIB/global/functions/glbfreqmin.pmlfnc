--
--
-- Description:
-- Function to set the minutes frequency field for the timer values
-- of a update event.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqMin()

  -- Initialise variables
  !value   = ||
  !start   = REAL()

  -- Read through the toggle list
  do !i from 0 to 59

    -- Set the gadget name
    !gName  = |00| + !i.string()
    !gName  = |M| + !gName.substring(-2,2)

    -- Don't process gadgets mid range.
    skip if (_$!<gName>.val and !start.set())

    -- Check the gadget is true
    if (_$!<gName>.val and !start.unset()) then
      !start      = !i
    elseif (not _$!<gName>.val) then

      if (!start.set()) then

        -- Check the range of the series
        if (!i eq !start + 1) then
          !value      = !value + !start.string() + |,|
        else
          !end        = !i - 1
          !value      = !value + !start.string() + |-| + !end.string() + |,|
        endif

        -- Reset the series values
        !start      = REAL()
        !end        = REAL()

      endif

    endif

  enddo

  -- Check the last series
  if (!start.set()) then

    -- Check the final value
    if (!start eq 59) then
      !value      = !value + !start.string()
    else
      !value      = !value + !start.string() + |-59|
    endif

  endif

  -- Construct the value to return to gadget
  !value                = !value.trim('R',',')
  if (!value.empty()) then
    !value                = '0'
  endif

  !!glbFreq.min.val   = !value

  call !!glbFreqChk(!!glbFreq.min,0,59,'0')

endfunction
-- End of function definition for !!glbFreqMin
