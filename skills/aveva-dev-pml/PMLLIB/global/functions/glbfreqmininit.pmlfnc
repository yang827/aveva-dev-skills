--
--
-- Description:
-- Function to initialise the update event frequency (minutes) form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqMinInit()

  -- Initialise variables
  if (!!glbFreq.min.val.eq('*')) then
    !value = '0-59'
  else
  !value     = !!glbFreq.min.val
  endif

  !fields    = !value.split(|,|)
  !toggles   = ARRAY()

  -- Check that there is a values to use
  if (!fields.unset()) then
    -- Set the default value
    !fields[1]  = '0'
  endif

  -- Set all toggles false
  do !i from 0 to 59

    !gName     = |00| + !i.string()
    !gName     = |!!glbFreqMin.m| + !gName.substring(-2,2) + |.val|
    $!gName    = false

  enddo

  -- Set the values
  if (!fields[1] eq '*') then

    -- Illegal value for minutes
    return

  else

    -- Process each field
    do !i indices !fields

      -- Split the field to see if its a range
      !atoms     = !fields[!i].split(|-|)

      if (!atoms.size() eq 1) then

        -- Single value
        !toggles.append(!atoms[1].real())

      elseif (!atoms.size() eq 2) then

        -- Range of values
        do !j from !atoms[1].real() to !atoms[2].real()
           !toggles.append(!j)
        enddo

      else
        -- Bad field specification
      endif

    enddo

  endif

  -- Set the toggles active as appropriate
  do !i values !toggles

    !gName      = |00| + !i.string()
    !gName      = |!!glbFreqMin.m| + !gName.substring(-2,2) + |.val|
    $!gName     = true

  enddo


endfunction
-- End of function definition for !!glbFreqMinInit
