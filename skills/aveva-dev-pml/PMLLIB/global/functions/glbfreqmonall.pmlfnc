--
--
-- Description:
-- Function to toggle the state the toggle gadgets in the Frequency
-- (Months) form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbFreqMonAll()

  -- Set the active state
  if (!!glbFreqMon.all.val) then

    -- Gadgets inactive
    !monthState    = false

  else

    -- Gadgets active
    !monthState    = true

  endif

  -- Set the hour gadget states
  do !i from 1 to 12

    !gName  = |00| + !i.string()
    !gName  = |M| + !gName.substring(-2,2)
    !!glbFreqMon.$!<gName>.active  = !monthState

  enddo


endfunction
-- End of function definition for !!glbFreqMonAll
