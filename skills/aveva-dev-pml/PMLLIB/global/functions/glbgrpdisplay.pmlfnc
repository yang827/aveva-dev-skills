--
--
-- Description:
-- Function to display the Group Definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbGrpDisplay(!mode is STRING)

  -- Display the form
  if (undefined(!!glbGrp)) then
    pml load form !!glbGrp
  endif
  !!glbGrp.display(!mode)
  if (!!glbGrp.shown().not()) then
    show !!glbGrp free
  endif

endfunction
-- End of function definition for !!glbGrpDisplay
