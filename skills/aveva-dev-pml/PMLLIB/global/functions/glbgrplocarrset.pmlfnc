--
-- Description:
-- Function to collect and store an array of project locations that
-- may become the current locations parent.
-- Function to be replaced by method !!glbGrpLoc.arrSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbGrpLocArrSet()

  -- Initialise variables
  !curPos       = !!ce
  !groups       = ARRAY()

  -- Collect project groups
  !!ce          = !!dbrAdminGetWorld('LOC')
  !groups       = !!collectAllFor('GRP','',!!ce)

  -- Save the array
  !!glbGrpLoc.grpArray = !groups

  -- Restore database position
  !!ce          = !curPos

endfunction
-- End of function definition for !!glbGrpLocArrSet
