--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbGrpLocInit()

  -- Restore sort and filter values
  if (!!glbGrpLoc.sortVal.set()) then
    !!glbGrpLoc.sort.select('rtext', !!glbGrpLoc.sortVal)
    !!glbGrpLoc.filter.val  = !!glbGrpLoc.filterVal
  endif

  -- Collect and display the project locations
  call !!glbGrpLocArrSet()
  call !!glbGrpLocList()

endfunction
-- End of function definition for !!glbGrpLocInit
