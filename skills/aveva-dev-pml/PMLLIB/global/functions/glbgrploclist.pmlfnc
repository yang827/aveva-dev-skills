--
--
-- Description:
-- Function to control the contents of the group list gadget in the
-- Group Membership from.
-- Function to be replaced by method !!glbGrpLoc.list()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbGrpLocList()

  -- Initialise variables
  !groups       = !!glbGrpLocArrGet()
  !group        = !!glbLoc.groupGet()

  -- Preserve sort and filter states
  if (!!glbGrpLoc.filter.val.empty()) then
    !!glbGrpLoc.filter.val = |*|
  endif
  !!glbGrpLoc.filterVal = !!glbGrpLoc.filter.val
  !!glbGrpLoc.sortVal   = !!glbGrpLoc.sort.selection('rtext')

  -- Clear the list gadget
  !!glbGrpLoc.group.clear()

  -- Sort and filter the list
  !displayRefs  = !!adminFilterSort(!groups,!!glbGrpLoc.sort,!!glbGrpLoc.filter)
  -- Build the list of texts
  call !!adminGrpTxtList(!displayRefs,!!glbGrpLoc.group)

  -- Try and select the current group
  if (!group.set() and not badref(!group)) then
    !!glbGrpLoc.group.select('rtext',!group.string())
    handle any

      -- Current Group must be displayed
      !displayRefs.append(!group)
      call !!adminGrpTxtList(!displayRefs,!!glbGrpLoc.group)
      !!glbGrpLoc.group.select('rtext',!group.string())

    endhandle

  endif

endfunction
-- End of function definition for !!glbGrpLocList
