--
--
-- Description:
-- Function to update the displayed GRP in the Group Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbGrpUpdate()

  -- Update Location Group form if shown in Modify mode for a group that is not the currently selected group
  if (defined(!!glbGrp)) then
    if (!!glbGrp.shown()) then
      !!glbGrp.update(!!adminElem.grpGet())
    endif
  endif

endfunction
-- End of function definition for !!glbGrpUpdate
