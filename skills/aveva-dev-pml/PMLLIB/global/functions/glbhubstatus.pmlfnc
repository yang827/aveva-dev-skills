-- Created:         Mon Jun 9 11:17:58 BST 1997
--
--
-- Description:
-- Function to determine whether the current project location is
-- the project Administration hub.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Global project status
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is location is the HUB (or non-global project)
--
------------------------------------------------------------------------

-- Define function
define function !!glbHubStatus(!globalStatus is BOOLEAN) is BOOLEAN

  -- Check to see is project is Global
  if (!globalStatus) then

    !project   = CURRENT PROJECT

    -- Project location
    !locRef    = !project.currentLocation().refno.dbref()

    -- Get project hub
    !hubRef    = !project.currentLocation().refno.dbref().owner.owner.hubRf

    -- Check to see if current location is HUB
    if (!locRef eq !hubRef) then
      return true
    else
      return false
    endif

  else

    -- Non-global project
    return true

  endif

endfunction
-- End of function definition for !!glbHubStatus
