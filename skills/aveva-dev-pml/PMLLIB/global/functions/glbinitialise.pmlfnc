-- Created:         Fri Sep 5 12:05:17 BST 1997
--
--
-- Description:
-- Function to initialise a newly created location.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbInitialise()

  -- Initialise variables
  !locRf   = !!dbrAdminGetWorld('STAT').locRf

  -- Check that the location is not initialise
  if (!locRf.lInit) then

    -- Raise error
    !!messageFile.error(141, 710,  !locRf.locId)

  endif

  -- Check that location is not off-line
  if (!locRf.iconn eq 0) then

    -- Raise error
    !!messageFile.error(141, 711,  !locRf.locId)

  endif

  -- If at the hub then the transaction db will be created if possible
  if (!locRf eq !!dbrGlbHubLocRf()) then
    !hubRef = !!dbrGlbHubLocRf()
    !hubId = !hubRef.locId

    -- Check to see if the hub has Transaction database
    !unusedTest = object DBREF('/*TRANSACTION/' & !hubId )
    handle ANY
      -- Create the transaction database command for hub location
      !commandCreateHubTranDB = 'CREATE DB TRANSACTION/' & !hubId
    endhandle

    -- Check to see if the hub has the Transaction database command
    if (defined(!commandCreateHubTranDB)) then
      -- Create the transaction database for hub location
      call !!admCommand(!commandCreateHubTranDB)
      handle ANY
        !!alert.error('Problem creating Transaction database. This will need creating manually, for the Daemon to operate.')
      elsehandle NONE
        !!alert.message('A transaction dB has been created. This will be fully available when you next enter Admin')
        -- This savework means that the daemon could be started now
        savework
      endhandle
    endif
  endif

  -- If at the Hub make !locRf.lInit true
  if (!locRf eq !!dbrGlbHubLocRf()) then
    !prev = !!ce
    !!ce = !locRf
    LINIT TRUE
    !!ce = !prev
    return
  endif

  -- Initialise the location (Not Hub)
  INITIALISE
  handle (1,500)

    -- Unknown hostname
    !!messageFile.error(141, 712, !!error.text.part(-1))

  elsehandle (1,501)

    -- Daemon failure
    !!messageFile.error(141, 713, !!error.text.part(-1))

  elsehandle any

    -- Non-specific error
    !!messageFile.error(141, 714,  !!error.text)

  endhandle

endfunction
-- End of function definition for !!glbInitialise
