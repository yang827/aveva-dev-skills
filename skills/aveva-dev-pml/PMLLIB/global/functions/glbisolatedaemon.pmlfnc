-- Created:         Mon Jun 9 14:10:32 BST 1997
--
--
-- Description:
-- Function to switch the current location isolation on or off.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW      GADGET     State of isolation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbIsolateDaemon(!isolation is GADGET)

  -- Check the isolate flag against the project
  if (!isolation.val) then

    -- Isolate the current location
    ISOLATION TRUE
    handle ANY
      !!alert.error(!!error.text)
    endhandle

  else

    -- Reconnect the daemon
    ISOLATION FALSE
    handle ANY
      !!alert.error(!!error.text)
    endhandle

  endif

  -- If a gadget value was passed an error may have occurred
  var !test isolation
  !isolation.val = !test.boolean()
  handle ANY
    -- $!!error.text
    -- In case we cannot write back to the argument
  endhandle

endfunction
-- End of function definition for !!glbIsolateDaemon
