-- Author:          E.conba
-- Created:         Mon Sep 8 14:04:47 BST 1997
--
--
-- Description:
-- Function to remotely lock and isolate project satellite
-- locations.
-- Function to be replaced by method !!glbLckIsl.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIsl()

  -- Initialise variables
  !dbRef     = !!glbLckIslRefGet()
  !lockState = _lockState
  !isolState = _isolState
  !lockValue = _lock.selection('rtext')
  !isolValue = _isol.selection('rtext')
  !message   = _message.val

  -- See if the lock need setting
  if (!lockState.string().lowcase() neq !lockValue) then

    -- Set the lock
    if( !lockValue.upcase() ne 'UNSET') then
      if (!lockValue.boolean()) then
        !command   = 'LOCK AT |'+ !dbRef.locId + '|'
      else
        !command   = 'UNLOCK AT |'+ !dbRef.locId + '|'
      endif

      -- Perform lock command
      call !!admCommand('$!command')
      handle (1,500)

        -- Unknown hostname
        !error = !!error.text
        _lock.select('rtext', !lockState.string().lowcase())
        handle any
        endhandle
         !!messageFile.error(141, 718,  'locking', !error.part(-1))

      elsehandle (1,501)

        -- Daemon failure
        !error = !!error.text
        _lock.select('rtext', !lockState.string().lowcase())
        handle any
        endhandle
         !!messageFile.error(141, 719,  'locking', !error.part(-1))

      elsehandle any

        -- Non-specific error
        !error = !!error.text
        _lock.select('rtext', !lockState.string().lowcase())
        handle any
        endhandle
        !!messageFile.error(141, 720,  'locking',  !error)

      endhandle

      -- Update form states
      _lockState = !lockValue.boolean()
    endif

  endif

  -- See if the isolation needs setting
  if (!isolState.string().lowcase() neq !isolValue) then

    -- Set the lock
    if( !isolValue.upcase() ne 'UNSET') then
      if (!isolValue.boolean()) then
        !command   = 'ISOLATION TRUE AT |'+ !dbRef.locId + '|'
      else
        !command   = 'ISOLATION FALSE AT |'+ !dbRef.locId + '|'
      endif

      -- Perform lock command
      call !!admCommand('$!command')
      handle (1,500)

        -- Unknown hostname
        _isol.select('rtext', !isolState.string().lowcase())
        !!messageFile.error(141, 718,  'isolation', !!error.text.part(-1))

      elsehandle (1,501)

        -- Daemon failure
        _isol.select('rtext', !isolState.string().lowcase())
        !!messageFile.error(141, 719,  'isolation', !!error.text.part(-1))

      elsehandle any

        -- Non-specific error
        _isol.select('rtext', !isolState.string().lowcase())
        !!messageFile.error(141, 720,  'isolation',  !!error.text)

      endhandle

      -- Update form states
      _isolState = !isolValue.boolean()
    endif

  endif

  -- If we got this far then a message should if one is specified
  -- The message goes to FREEUSER at the remote location.
  if (!message.empty()) then

    -- Message not required
    return

  endif

  -- Send a message
  !command   = 'REMOTEMESSAGE ' + !dbRef.name +' FREEUSER |'+ !message + '|'
  call !!admCommand('$!command')
  handle none

    -- Inform user success
    !!messageFile.message(141, 721)

  elsehandle any

    -- Raise error
    !!messageFile.error(141, 722,  !!error.text)

  endhandle

endfunction
-- End of function definition for !!glbLckIsl
