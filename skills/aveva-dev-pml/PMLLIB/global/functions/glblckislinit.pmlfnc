--
--
-- Description:
-- Function to initialise the Global Locking & Isolation form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslInit()

  -- Get project locations
  call !!glbLckIslLocSet()

  -- Check that there are some locations
  !locations    = !!glbLckIslLocGet()
  if (!locations.size() eq 0) then

    -- Raise error
    !!messageFile.error(141, 701)

  endif

  -- Restore sort and filter gadget values
  if (!!glbLckIsl.filterVal.set()) then
    !!glbLckIsl.filter.val  = !!glbLckIsl.filterVal
  endif
  if (!!glbLckIsl.sortVal.set()) then
    !!glbLckIsl.sort.select('rtext', !!glbLckIsl.sortVal)
  endif

  -- Populate the location list gadget
  call !!glbLckIslLocList()

endfunction
-- End of function definition for !!glbLckIslInit
