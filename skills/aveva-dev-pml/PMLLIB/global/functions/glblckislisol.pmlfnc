--
--
-- Description:
-- Callback function to the isolation list gadget in the Global Locking
-- & Isolation form
-- Function to be replaced by method !!glbLckIsl.cbLock(!gadget is GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Isolation list gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslIsol(!gadget is GADGET)

  -- Initialise variables
  !value     = !gadget.selection('rtext')
  !isolState = _isolState

  -- If the isolState is already unset the check is not required.
  if (!isolState.unset()) then
    return
  endif

  -- Check that user had not selected 'unset'
  if (!value eq 'unset') then

    -- Raise warning and set to state value
    !!messageFile.warning(141, 717,  $
      !!messageFile.messageString(141, 821))

    -- Set to state value
    !gadget.select('rtext',!isolState.string().lowcase())

  endif

endfunction
-- End of function definition for !!glbLckIslIsol
