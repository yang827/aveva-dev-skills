-- Created:         Mon Sep 8 11:19:22 BST 1997
--
--
-- Description:
-- Callback function to the lock list gadget in the Global Locking &
-- Isolation form
-- Function to be replaced by method !!glbLckIsl.cbLock(!gadget is GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Lock list gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslLock(!gadget is GADGET)

  -- Initialise variables
  !value     = !gadget.selection('rtext')
  !lockState = _lockState

  -- If the lockState is already unset the check is not required.
  if (!lockState.unset()) then
    return
  endif

  -- Check that user had not selected 'unset'
  if (!value eq 'unset') then

    -- Raise warning and set to state value
    !!messageFile.warning(141, 717, $
       !!messageFile.messageString(141, 822))

    -- Set to state value
    !gadget.select('rtext', !lockState.string().lowcase())

  endif

endfunction
-- End of function definition for !!glbLckIslLock
