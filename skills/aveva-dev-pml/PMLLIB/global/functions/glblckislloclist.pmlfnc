--
--
-- Description:
-- Function to control the contents of the location list gadget
-- in the Global Locking & Isolation form.
-- Function to be replaced by method !!glbLckIso.locList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslLocList()

 -- Initialise variables
 !locations  = !!glbLckIslLocGet()
 !dbRef      = !!glbLckIslRefGet()

 -- Preserve sort and filter values
 if (!!glbLckIsl.filter.val.empty()) then
   !!glbLckIsl.filter.val = |*|
 endif
 !!glbLckIsl.filterVal = !!glbLckIsl.filter.val
 !!glbLckIsl.sortVal   = !!glbLckIsl.sort.selection('rtext')

 -- Clear the list gadget
 !!glbLckIsl.locn.clear()

 -- Sort the location list
 !displayList          = !!adminFilterSort(!locations, !!glbLckIsl.sort, !!glbLckIsl.filter)

  -- Display the list
  call !!adminLocnTxtList(!displayList, !!glbLckIsl.locn)

  -- Attempt to select the current DBREF
  if (!dbRef.set()) then

    !!glbLckIsl.locn.select('rtext',!dbRef.string())
    handle any
      -- Dummy handle
    endhandle

  endif

  -- Select the new DBREF as appropriate
  call !!glbLckIslLocSel()

endfunction
-- End of function definition for !!glbLckIslLocList
