--
-- Description:
-- Callback to the list gadget for user selection of a location.
-- Function to the replaced by method !!glbLckIsl.locSel()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslLocSel()

  -- Initialise variables
  !dbRef   = object DBREF()

  -- Get the current selection
  !dbRef   = !!glbLckIsl.locn.selection('rtext').dbRef()
  handle any
    -- Dummy handle in case badRef
  endhandle

  -- Set the DBREF value
  call !!glbLckIslRefSet(!dbRef)

endfunction
-- End of function definition for !!glbLckIslLocSel
