--
--
-- Description:
-- Function to collect the list of project LOC elements that
-- apply to the Global Locking & Isolation form.
-- Function to be replaced by method !!glbLckIsl.locSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslLocSet()

  -- Initialise variables
  !curPos     = !!ce
  !locations  = ARRAY()
  !locRef     = !!dbrGlbCurLocRf()

  -- Collect location elements
  !!ce        = !!dbrAdminGetWorld('LOC')
  !clause     = 'LINIT eq true and ICONN eq 1 and REF neq '+ !locRef.string()
  !locations  = !!collectAllFor('LOC', !clause, !!ce)

  -- Store the value
  !!glbLckIsl.locArray = !locations

  -- Restore database position
  !!ce        = !curPos

endfunction
-- End of function definition for !!glbLckIslLocSet
