-- Description:
-- Function to return the DBREF of the current selected LOC
-- element in the Global Locking & Isolation form.
-- Function to be replaced by method !!glbLckIsl.refGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBBRE of selected locations
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslRefGet() is DBREF

  -- Return the values
  return !!glbLckIsl.dbRef

endfunction
-- End of function definition for !!glbLckIslRefGet
