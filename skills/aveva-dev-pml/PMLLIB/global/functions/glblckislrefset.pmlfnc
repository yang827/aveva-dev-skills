-- Author:          E.conba
-- Created:         Mon Sep 8 09:01:38 BST 1997
--
--
-- Description:
-- Function to store the reference of a location to perform locking
-- and isolation operations on.
-- Function to be replaced by method !!glbLckIsl.refSet(!dbRef is DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selected location DBREF (may be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLckIslRefSet(!dbRef is DBREF)

  -- Store the value
  !!glbLckIsl.dbRef      = !dbRef
  !!glbLckIsl.lockState  = BOOLEAN()
  !!glbLckIsl.isolState  = BOOLEAN()

  -- Return early if the DBREF is unset
  if (!dbRef.unset()) then

    !!glbLckIsl.locId.val  = |unset|
    !!glbLckIsl.lock.select('rtext','unset')
    !!glbLckIsl.isol.select('rtext','unset')
    return

  endif

  -- Get additional information
  !locId                 = !dbRef.locId
  !!glbLckIsl.locId.val  = !locId

  -- Get the lock state
  var !lockState LOCK AT '$!locId'
  handle any

    -- Daemon not available
    !!glbLckIsl.lockState  = BOOLEAN()
    !!glbLckIsl.isolState  = BOOLEAN()
    !!glbLckIsl.isol.select('rtext','unset')
    !!glbLckIsl.lock.select('rtext','unset')

    -- Raise error
    !!messageFile.error(141, 705,  !!error.text)
    handle any
      -- Dummy handle to let form display
    endhandle

  elsehandle none

    -- Returned result
    if (!lockState eq 'Locked') then
      !!glbLckIsl.lockState  = true
      !!glbLckIsl.lock.select('rtext','true')
    else
      !!glbLckIsl.lockState  = false
      !!glbLckIsl.lock.select('rtext','false')
    endif

    -- Get the isolation state (if lock worked)
    var !isolState ISOLATION AT '$!locId'
    handle any

      -- Daemon not available
      !!glbLckIsl.isolState  = BOOLEAN()
      !!glbLckIsl.isol.select('rtext','unset')

      -- Raise error
      !!messageFile.error(141, 705,  !!error.text)

    elsehandle none

      -- Returned result
      if (!isolState.boolean()) then
        !!glbLckIsl.isolState  = true
        !!glbLckIsl.isol.select('rtext','true')
      else
        !!glbLckIsl.isolState  = false
        !!glbLckIsl.isol.select('rtext','false')
      endif

    endhandle

  endhandle

endfunction
-- End of function definition for !!glbLckIslRefSet
