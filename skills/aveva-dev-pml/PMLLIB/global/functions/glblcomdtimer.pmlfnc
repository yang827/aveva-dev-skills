--
--
-- Description:
-- Function to check that the input value is in a valid format.
-- Function to be replaced by method !!glbLcomd.cbTimer()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbLcomdTimer()

  -- Initialise variables
  !value                  = !!glbLcomd.timeR.val
  !default                = '0 * * * *'

  -- Split the gadget value
  !fields                 = !value.split(| |)

  -- Check that we have 5 values
  if (!fields.size() neq 5) then

    -- Malformed value (only applies if called from Update Event form)
    if (defined(!!glbLcomd)) then
      !!glbLcomd.timeR.val   = !default
      !!messageFile.error(141, 603)
    endif

  endif

  -- Load the form !!glbFreq form or this will crash!
  loadForm !!glbFreq
  handle any
    -- We want to keep going
  endhandle

  -- Assign part to freq form gadgets
  !!glbFreq.min.val     = !fields[1]
  !!glbFreq.hours.val   = !fields[2]
  !!glbFreq.dates.val   = !fields[3]
  !!glbFreq.months.val  = !fields[4]
  !!glbFreq.days.val    = !fields[5]

  -- Call the CommFreq form gadget callbacks
  call !!glbFreqChk(!!glbFreq.min,0,59,'0')
  handle any
    -- We want to keep going
  endhandle

  call !!glbFreqChk(!!glbFreq.hours,0,23,'*')
  handle any
    -- We want to keep going
  endhandle

  call !!glbFreqChk(!!glbFreq.dates,1,31,'*')
  handle any
    -- We want to keep going
  endhandle

  call !!glbFreqChk(!!glbFreq.months,1,12,'*')
  handle any
    -- We want to keep going
  endhandle

  call !!glbFreqChk(!!glbFreq.days,0,6,'*')
  handle any
    -- We want to keep going
  endhandle

  -- Now call the freq form callback to rebuild the field
  call !!glbFreq()


endfunction
-- End of function definition for !!glbLcomdTimer
