--
--
-- Description:
-- Function to initialise the List Groups form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbListGrpInit()

  -- Initialise variables
  !!ce     = !!dbrAdminGetWorld('LOC')
  !groups  = !!collectAllFor('GRP','',!!ce)
  !dText   = ARRAY()
  !rText   = ARRAY()

  -- Clear the groups list
  !!glbListGrp.grp.clear()

  -- Construct display texts
  do !grp values !groups

    if (!!sessionSettings.showAs eq 'NAME') then
      !dText.append(!grp.name.substring(2))
    elseif (!grp.description.empty()) then
      !dText.append(!grp.name.substring(2))
    else
      !dText.append(!grp.description)
    endif

    !rText.append(!grp.string())

  enddo

  -- Sort the list order
  !order = !dText.sortedIndices()
  !dText.reIndex(!order)
  !rText.reIndex(!order)

  -- Assign list gadget values
  !!glbListGrp.grp.dText  = !dText
  !!glbListGrp.grp.rText  = !rText

  -- Display selection information
  call !!glbListGrpSel()

endfunction
-- End of function definition for !!glbListGrpInit
