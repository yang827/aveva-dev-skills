--
--
-- Description:
-- Function to display information about the selected  group in the
-- List Groups form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbListGrpSel()

  -- Initialise variables
  !curPos     = !!ce
  !dbRef      = object DBREF()
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Get the current selection
  !dbRef     = !!glbListGrp.grp.selection('rtext').dbRef()
  handle any
    -- No groups
    return
  endhandle

  -- Return if no current group
  if (!dbRef.unset()) then
    return
  endif

  -- Collect locations that are in the selected group
  !!ce        = !!dbrAdminGetWorld('LOC')
  !clause     = 'GRPRF eq '+ !dbRef.name
  !locations  = !!collectAllFor('LOC',!clause, !!ce)

  -- Set paragraph values
  if (!!sessionSettings.showAs eq 'NAME') then

    if (!dbRef.description.empty()) then
      !!glbListGrp.desc.val   = '-- No Description --'
    elseif (!dbRef.description.length() gt 40) then
      !!glbListGrp.desc.val   = !dbRef.description.substring(1,38) + '>>'
    else
      !!glbListGrp.desc.val   = !dbRef.description
    endif

  else

    !!glbListGrp.desc.val   = !dbRef.name.substring(2)

  endif

  -- Clear the members
  !!glbListGrp.member.clear()

  -- Create display texts
  do !loc values !locations

    skip if !loc.badRef()
    -- Get locations info
    !locName  = !loc.name.substring(2)
    !locId    = !loc.locId
    !locHost  = !loc.rhost

    -- *** OLD PML SYNTAX ***
    var !displayText COMPOSE SPACE 0 |$!locName| WIDTH 20 LEFT $
                             SPACE 1 |$!locId|   WIDTH 3 $
                             SPACE 1 |$!locHost| LEFT $

    !dText.append(!displayText[1])
    !rText.append(!loc.string())

  enddo

  -- Assign list gadget values
  !!glbListGrp.member.dText  = !dText
  !!glbListGrp.member.rText  = !rText

  -- Navigate to original database position
  !!ce  = !curPos

endfunction
-- End of function definition for !!glbListGrpSel
