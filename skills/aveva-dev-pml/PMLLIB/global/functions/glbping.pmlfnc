-- Created:         Fri Nov 28 11:22:22 GMT 1997
--
--
-- Description:
-- Function to broadcast a Q COMMS command to an on-line project
-- location in the Test Project Communications form.
-- Function to be replaced by method !!glbPing.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPing()

  -- Initialise variables
  !location   = !!glbPingRefGet()
  !curLoc     = !!dbrGlbCurLocRf()
  !text       = ARRAY()

  -- Check that the location is set
  if (!location.unset()) then

    -- Raise error
    !!alert.error('Location is Unset')
    return

  endif

  -- Construct ping command
  !command    = |COMMS '|+ !location.locId +|'|

  -- Ping the location
  var !result $!command
  handle (1,431)

    -- Uninitialise location
    !result   = |FAIL    - Location |+ !location.locId +| is uninitialised|

  elsehandle  (1,432)

    -- Off-line location
    !result   = |FAIL    - Location |+ !location.locId +| is off-line|

  elsehandle (1,500)

    -- Local daemon is unreachable
    !result   = |FAIL    - Local daemon is unreachable. Is "admind" started?|

  elsehandle (1,501)

    -- Cannot contact daemon
    !result   = |FAIL    - A daemon is unreachable between |+ !curLoc.locId +| and |+ !location.locId

  elsehandle none

    -- Success
    !result   = |SUCCESS - |+ !result

  endhandle

  -- Command to determine path
  !command   = |COMMS '|+ !location.locId +|' PATH|
  var !path $!command
  handle ANY
    !path = |          [ |+ !!error.text +| ]|
  elsehandle NONE
    !path = |          [ Path: |+ !path +| ]|
  endhandle

  -- Publish the result in the text pane
  !text     = !!glbPing.results.val
  !text.append(!result)
  !text.append(!path)
  !!glbPing.results.val = !text

endfunction
-- End of function definition for !!glbPing
