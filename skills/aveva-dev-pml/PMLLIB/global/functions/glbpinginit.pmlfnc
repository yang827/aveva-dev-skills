--
--
-- Description:
-- Function to initialise the Test Project Communications form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingInit()

  -- Restore sort and filter values
  if (!!glbPing.filterVal.set()) then
    !!glbPing.filter.val  = !!glbPing.filterVal
    !!glbPing.sort.select('rtext',!!glbPing.sortVal)
  endif

  -- Get project locations
  call !!glbPingLocSet()

  -- List the project locations
  call !!glbPingLocList()

endfunction
-- End of function definition for !!glbPingInit
