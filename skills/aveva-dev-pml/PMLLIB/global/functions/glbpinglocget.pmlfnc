-- Description:
-- Function to return the form member for project locations in the
-- Test Project Communications form.
-- Function to be replaced by method !!glbPing.locGet() is ARRAY
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project locations
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingLocGet() is ARRAY

  -- Return the value
  return !!glbPing.locArray

endfunction
-- End of function definition for !!glbPingLocGet
