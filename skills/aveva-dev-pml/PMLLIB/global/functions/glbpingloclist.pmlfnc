--
--
-- Description:
-- Function to control the contents of the project location list gadget.
-- Function to be replaced by method !!glbPing.locList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingLocList()

  -- Initialise variables
  !locations    = !!glbPingLocGet()

  -- Preserve the sort and filter values
  if (!!glbPing.filter.val.empty()) then
    !!glbPing.filter.val  = |*|
  endif
  !!glbPing.filterVal  = !!glbPing.filter.val
  !!glbPing.sortVal    = !!glbPing.sort.selection('rtext')

  -- Clear the list gadget
  !!glbPing.loc.clear()

  -- Sort and filter the list
  !displayRefs  = !!adminFilterSort(!locations ,!!glbPing.sort,!!glbPing.filter)

  -- Build the list of texts
  call !!adminLocnTxtList(!displayRefs,!!glbPing.loc)

  -- Set the current selection
  call !!glbPingLocSel()

endfunction
-- End of function definition for !!glbPingLocList
