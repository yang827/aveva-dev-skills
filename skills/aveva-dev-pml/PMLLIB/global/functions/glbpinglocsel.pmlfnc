--
-- Description:
-- Callback function to selection of a location in the Test Project
-- Communications form.
-- Function to be replaced by method !!glbPing.locSel()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingLocSel()

  -- Initialise variables
  !dbRef    = !!glbPing.loc.selection('rtext').dbRef()
  handle any
    -- Cannot convert
    !dbRef    = object DBREF()
  endhandle

  -- Save the value
  call !!glbPingRefSet(!dbRef)

endfunction
-- End of function definition for !!glbPingLocSel
