--
-- Description:
-- Function to construct and save an array of project locations that
-- are used in the Test Project Communications form.
-- Function to be replaced by method !!glbPing.locSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingLocSet()

  -- Initialise variables

  -- Collect an array of locations
  !!ce       = !!dbrAdminGetWorld('LOC')
  -- This should work with the current location
  --!clause    = 'ICONN eq 1 and LINIT eq TRUE and REF neq '+ !curLoc
  -- This should now work for uninitialised locations (SB 5.8.02 DFN1594)
  --!clause    = 'ICONN eq 1 and LINIT eq TRUE'
  !clause    = 'ICONN eq 1'
  !locations = !!collectAllFor('LOC',!clause,!!ce)

  -- Store the array
  !!glbPing.locArray = !locations

endfunction
-- End of function definition for !!glbPingLocSet
