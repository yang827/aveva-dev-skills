--
-- Description:
-- Function to set the form member for the Current Selected location.
-- Function to be replaced by method !!glbPing.refSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of selected location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPingRefSet(!dbRef is DBREF)

  -- Save the value
  !!glbPing.dbRef  = !dbRef

endfunction
-- End of function definition for !!glbPingRefSet
