--
-- Description:
-- Function to purge database files after an import of transfer data
-- at an offline location or the project hub.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbPurgeDb()

  -- Confirm the purge action
  !answer   = !!alert.confirm(!!messageFile.messageString(141, 729))
  if (!answer.boolean()) then

    -- Purge the picture files (old files (AK))
    PURGE OLDFILES DB

  endif

endfunction
-- End of function definition for !!glbPurgeDb
