-- Created:         Fri Oct 24 14:16:16 GMT 1997
--
--
-- Description:
-- Function to allow the previous hub location to recover it's hub
-- status, whilst the system is in transit to the new hub. (i.e. if the
-- move hub command has failed).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRecoverHub()

  -- Initialise variables
  !location   = !!dbrGlbCurLocRf()
  !!ce        = !!dbrAdminGetWorld('LOC')
  !prevHubRef = !!ce.prvRf

  -- Check we still can perform the command
  if (!prevHubRef.unset()) then

    !curHub  = !!ce.hubRf.locId
    handle any
      !curHub  = 'UNKNOWN'
    endhandle
    -- No previous hub location
    !!messageFile.error(141, 730,  !curHub)

  endif

  -- Check that this location is the previous hub
  if (!location neq !prevHubRef) then

    -- No authority to restore hub location
    !!messageFile.error(141, 731,  !prevHubRef.locId,  !location.locId)

  endif

  -- Warn user about the command
   !answer = !!alert.confirm(|Continue only if the Daemon is down or the Location is Offline. $
In all other circumstances wait for the built-in recovery. Continue to Recover Hub?|)
    if (!answer.boolean()) then
      -- Continue
    else
      return
    endif

  -- Restore previous hub location
  PREVOWNER HUB

endfunction
-- End of function definition for !!glbRecoverHub
