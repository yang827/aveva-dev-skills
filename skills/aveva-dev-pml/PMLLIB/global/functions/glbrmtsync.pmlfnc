--
--
-- Description:
-- Callback to Apply button in the Remote Database Synchronisation
-- form.
-- Function to be replaced by method !!glbRmtSync.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSync()

  -- Initialise variables
  !source   = !!glbRmtSyncSrcGet()
  !target   = !!glbRmtSyncTgtGet()
  !action   = !!glbRmtSync.action.selection('rtext')
  !commands = ARRAY()

  -- Set Target part of command
  if (!target.set()) then
    !targetComm  = | WITH '|+ !target.locId +|'|
  else
    !targetComm  = ||
  endif

  -- Command depend on action
  if (!action eq 'ALL') then

    -- Synchronise all secondary database
    !commands.append(|SYNCHRONISE ALL AT '|+ !source.locId +|'|+ !targetComm)

  elseif (!action eq 'SEL') then

    -- Get the database selection details
    !totalDbs  = !!glbRmtSyncDbGet().size()
    !selDb     = !!glbRmtSync.db.selection('rtext')

    -- Return if no selection
    if (!selDb.unset()) then
      return
    endif

    -- See if all databases have been selected
    if (!selDb.size() eq !totalDbs) then

      -- Synchronise all DBS
      !commands.append(|SYNCHRONISE ALL AT '|+ !source.locId +|'|+ !targetComm)

    else

      -- Synchronise selected databases
      -- Get the source location allocation order
      !!ce      = !source
      !allocSrc = !!ce.mem[1].mem

      -- The order should follow the order to in which the
      -- databases appear in the current locations DBALL.
      do !i indices !selDb

        !dbRef   = !selDb[!i].dbRef()
         handle any
          -- Bad conversion
          skip
        endhandle
        !listPos = !allocSrc.findFirst(!dbRef)
        !commands[!listPos] = |SYNCHRONISE |+ !dbRef.name.substring(3) +| AT '|+ !source.locId +|'|+ !targetComm

      enddo

      -- Compress the command as is will be
      -- sparsely populated
      !commands.compress()

    endif

  endif

  -- Process the list of commands
  do !i indices !commands

    -- ***OLD PML SYNTAX
    $!commands[$!i]
    handle (1,500) (1,501)

      -- Daemon errors
      !!messageFile.error(141, 724, !source.locId, !!error.text.after(')').trim('L'))

    elsehandle any

      -- Non-specific error
      !!messageFile.error(141, 724, !source.locId, !!error.text)

    endhandle

  enddo

endfunction
-- End of function definition for !!glbRmtSync
