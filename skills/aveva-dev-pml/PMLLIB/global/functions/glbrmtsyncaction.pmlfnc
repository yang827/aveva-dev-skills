--
--
-- Description:
-- Callback function for the Action gadget in the Remote Database
-- Synchronisation form.
-- Function to be replaced by method !!glbRmtSync.cbAction()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncAction()

  -- Initialise variables
  !action   = !!glbRmtSync.action.selection('rtext')

  -- Set gadget modes
  if (!action eq 'ALL') then

    !!glbRmtSync.all.active   = false
    !!glbRmtSync.clear.active = false
    !!glbRmtSync.db.active    = false

  elseif (!action eq 'SEL') then

    !!glbRmtSync.all.active   = true
    !!glbRmtSync.clear.active = true
    !!glbRmtSync.db.active    = true

  endif
endfunction
-- End of function definition for !!glbRmtSyncAction
