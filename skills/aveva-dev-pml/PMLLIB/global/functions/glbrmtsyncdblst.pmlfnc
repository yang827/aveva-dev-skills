--
--
-- Description:
-- Function to maintain and update the contents of the  Database
-- list gadget in the Remote Database Synchronisation form.
-- Function to be replaced by method !!gblRmtSync.dbList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncDbLst()

  -- Initialise variables
  !databases    = !!glbRmtSyncDbGet()

  -- Save the sort and filter states
  !!glbRmtSync.sortVal   = !!glbRmtSync.sort.selection('rtext')
  !!glbRmtSync.filterVal = !!glbRmtSync.filter.val

  -- Sort and filter the list
  !displayList  = !!adminFilterSort(!databases, !!glbRmtSync.sort, !!glbRmtSync.filter)

  -- Display the returned list
  !!adminDbTxtList(!displayList, !!glbRmtSync.db, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !!glbRmtSyncSrcGet())

endfunction
-- End of function definition for !!glbRmtSyncDbLst
