-- Author:          E.conba
-- Created:         Wed Oct 1 11:42:30 BST 1997
--
--
-- Description:
-- Function to store a list of project databases that are secondary
-- and common to both selected locations.
-- Function to be replaced by method !!glbRmtSync.dbSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncDbSet()

  -- Initialise variables
  !source    = !!glbRmtSyncSrcGet()
  !target    = !!glbRmtSyncTgtGet()
  !localDbs  = ARRAY()
  !remoteDbs = ARRAY()

  -- Get the secondary databases at the source that are propagated
  !!ce       = !source
  !allocSrc  = !!ce.mem[1].mem
  do !db values !allocSrc
    skip if !db.badRef()
    skip if (!db.foreign neq 'LOCAL')
    !!ce       = !db
    DBLOC 1
    if (!!ce.locRf neq !source and !!ce.propg) then
      !localDbs.append(!db)
    endif
  enddo

  -- Get databases at the target location
  -- Not primary at the source location
  if (!target.set()) then

    !!ce       = !target
    !allocTgt  = !!ce.mem[1].mem
    do !db values !allocTgt
      skip if !db.badRef()
      skip if (!db.foreign neq 'LOCAL')
      !!ce       = !db
      DBLOC 1
      if (!!ce.locRf neq !source and !!ce.propg) then
        !remoteDbs.append(!db)
      endif
    enddo

  endif

  -- Show all primary database (if no target)
  -- or
  -- Databases common to both locations
  if (!target.unset()) then
    !!glbRmtSync.dbArray  = !localDbs
  else
    !!glbRmtSync.dbArray  = !localDbs.intersect(!remoteDbs)
  endif

endfunction
-- End of function definition for !!glbRmtSyncDbSet
