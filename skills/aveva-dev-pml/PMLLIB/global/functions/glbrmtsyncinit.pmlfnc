--
--
-- Description:
-- Function to initialise the remote synchronisation form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncInit()

  -- Initialise variables
  !source    = !!glbRmtSyncSrcGet()

  -- Get project location list
  call !!glbRmtSyncLocSet()

  -- Check that the project has locations to talk to
  if (!!glbRmtSyncLocGet().size() eq 0) then
    !!messageFile.error(141, 601)
  endif

  -- Display a list of possible source locations
  call !!glbRmtSyncSrcLst()

  -- Restore the sort and filter values
  if (!!glbRmtSync.sortVal.set()) then
    !!glbRmtSync.sort.select('rtext',!!glbRmtSync.sortVal)
  endif
  if (!!glbRmtSync.filterVal.set()) then
    !!glbRmtSync.filter.val  = !!glbRmtSync.filterVal
  endif

  -- Update the gadget states
  call !!glbRmtSyncTarget()
  call !!glbRmtSyncAction()

  -- Attempt to select the previous source location
  !!glbRmtSync.source.select('rtext', !source.string())
  handle (61,567)
    --
  endhandle
  call !!glbRmtSyncSrcSel()

endfunction
-- End of function definition for !!glbRmtSyncInit
