--
-- Description:
-- Function to return and array of project locations that can have a
-- remote synchronisation command executed on their behalf.
-- Function to be replaced by method !!glbRmtSync.locGet() is ARRAY
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of DBREFs of project locations
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncLocGet() is ARRAY

  -- Return the value
  return !!glbRmtSync.locArray

endfunction
-- End of function definition for !!glbRmtSyncLocGet
