--
--
-- Description:
-- Function to store the on-line project locations that can have a
-- remote synchronisation command executed on their  behalf. Must be
-- initialised.
-- Function to be replaced by method !!glbRmtSync.locGet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncLocSet()

  -- Initialise variables
  !locations   = ARRAY()

  -- Collect location elements
  !!ce         = !!dbrAdminGetWorld('LOC')
  !clause      = 'LINIT eq true and ICONN eq 1'
  !locations   = !!collectAllFor('LOC', !clause, !!ce)

  -- Store the array
  !!glbRmtSync.locArray = !locations

endfunction
-- End of function definition for !!glbRmtSyncLocSet
