--
-- Description:
-- Function to return the source location of the remote synchronise
-- command.
-- Function to be replaced by method !!glbRmtSync.sourceGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of source location
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncSrcGet() is DBREF

  -- Return the value
  return !!glbRmtSync.sourceLoc

endfunction
-- End of function definition for !!glbRmtSyncSrcGet
