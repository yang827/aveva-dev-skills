--
--
-- Description:
-- Function to maintain the list of locations that can be
-- the source of a synchronise command.
-- Function to be replaced bt method !!glbRmtSync.sourceList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncSrcLst()

  -- Initialise variables
  !hubRef     = !!dbrGlbHubLocRf()
  !locArray   = !!glbRmtSyncLocGet()
  !locNames   = ARRAY()
  !locations  = ARRAY()

  -- Sort the location list based on name
  do !loc values !locArray
    skip if (!loc eq !hubRef)
    !locNames.append(!loc.name)
    !locations.append(!loc)
  enddo
  !order      = !locNames.sortedIndices()
  !locations.reIndex(!order)

  -- Update the gadget contents
  call !!adminLocnTxtList(!locations,!!glbRmtSync.source)

endfunction
-- End of function definition for !!glbRmtSyncSrcLst
