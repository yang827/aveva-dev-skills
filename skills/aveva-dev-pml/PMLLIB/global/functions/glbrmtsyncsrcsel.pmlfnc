--
--
-- Description:
-- Callback to the source list gadget in the Remote Synchronisation
-- form.
-- Function to be replaced by method !!glbRmtSync.cbSource()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncSrcSel()

  -- Initialise variables
  !selection  = !!glbRmtSync.source.selection('rtext').dbRef()
  !curSource  = !!glbRmtSyncSrcGet()

  -- Update the source if different
  if (!selection neq !curSource) then
    call !!glbRmtSyncSrcSet(!selection)
    call !!glbRmtSyncTgtLst()
  endif

endfunction
-- End of function definition for !!glbRmtSyncSrcSel
