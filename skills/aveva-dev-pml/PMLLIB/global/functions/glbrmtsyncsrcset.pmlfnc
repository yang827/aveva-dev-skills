--
--
-- Description:
-- Function to set and store the source location a the remote
-- synchronise command.
-- Function to be replaced by method !!glbRmtSync.sourceSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of LOC where Synchronise command will
--                           be performed. (May be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncSrcSet(!dbRef is DBREF)

  -- Set the value
  !!glbRmtSync.sourceLoc  = !dbRef

endfunction
-- End of function definition for !!glbRmtSyncSrcSet
