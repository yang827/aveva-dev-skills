--
--
-- Description:
-- Callback function for the target type of the Remote Database
-- Synchronisation form.
-- Function to be replaced by method !!glbRmtSync.cbTarget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncTarget()

  -- Initialise variables
  !source       = !!glbRmtSyncSrcGet()
  !targetType   = !!glbRmtSync.target.selection('rtext')

  -- Set gadget modes
  if (!targetType eq 'PRI') then

    !!glbRmtSync.locn.active  = false
    call !!glbRmtSyncTgtSet(object DBREF())

  elseif (!targetType eq 'SEL') then

    !!glbRmtSync.locn.active  = true
    !selection  = !!glbRmtSync.locn.selection('rtext').dbRef()
    handle any
      -- In case its unset
    endhandle
    call !!glbRmtSyncTgtSet(!selection)

  endif

  -- Update the database list
  if (!source.set()) then
    call !!glbRmtSyncDbSet()
    call !!glbRmtSyncDbLst()
  endif


endfunction
-- End of function definition for !!glbRmtSyncTarget
