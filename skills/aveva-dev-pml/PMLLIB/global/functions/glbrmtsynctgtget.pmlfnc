--
-- Description:
-- Function to return the DBREF of the target location for the remote
-- synchronisation command.
-- Function to be replaced by method !!glbRmtSync.targetGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of target location
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncTgtGet() is DBREF

  -- Return the value
  return !!glbRmtSync.targetLoc

endfunction
-- End of function definition for !!glbRmtSyncTgtGet
