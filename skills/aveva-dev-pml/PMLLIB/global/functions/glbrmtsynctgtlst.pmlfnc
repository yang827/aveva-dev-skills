-- Author:          E.conba
-- Created:         Wed Oct 1 14:38:12 BST 1997
--
--
-- Description:
-- Function to update and maintain the list of Target locations
-- that can be used in conjunction with the selected source location.
-- Function to be replaced by method !!glbRmtSync.targetList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncTgtLst()

  -- Initialise variables
  !currentPos  = !!ce
--  !locArray    = !!glbRmtSyncLocGet()
  !source      = !!glbRmtSyncSrcGet()
  !target      = !!glbRmtSyncTgtGet()
  !hubRef      = !!dbrGlbHubLocRf()
  !locations   = ARRAY()
  !locNames    = ARRAY()
  !targetType  = !!glbRmtSync.target.selection('rtext')

  -- Collect the project locations that can be updated with
  -- PARENT, CHILD, GROUP
  -- Get the parent of the current location.
  if (!source neq !hubRef) then
    !locations.append(!source.locRf)
  endif

  -- Get locations that are children of the current locations
  !!ce         = !!dbrAdminGetWorld('LOC')
  !clause      = 'LOCRF eq '+ !source.string() +' and LINIT eq TRUE'
  !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))

  -- Get locations that are members of the same group
  if (!source.grpRf.set()) then
    !clause      = 'GRPRF eq '+ !source.grpRf.string() +' and LINIT eq TRUE'
    !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))
  endif

  -- Make the locations array unique
  !locations.unique()

  -- Restore the database location
  !!ce         = !currentPos

  -- See if there are any locations to communicate with
  if (!locations.unset()) then
    !!messageFile.error(141, 601)
  endif

  -- Prepare an array of data to be sorted
  do !loc values !locations
    !locNames.append(!loc.name)
  enddo

  -- Sort the location list
  !order       = !locNames.sortedIndices()
  !locations.reIndex(!order)

  -- Display the list texts
  call !!adminLocnTxtList(!locations, !!glbRmtSync.locn)

  -- Update the selection
  if (!targetType eq 'SEL') then

    -- Attempt to reselect the value
    !!glbRmtSync.locn.select('rtext', !target.string())
    handle (61,567)
      -- Selection cannot be made
      -- Set the default
      !selection   = !!glbRmtSync.locn.selection('rtext').dbRef()
      call !!glbRmtSyncTgtSet(!selection)
    endhandle

  endif

  -- Update the database list contents
  call !!glbRmtSyncDbSet()
  call !!glbRmtSyncDbLst()

endfunction
-- End of function definition for !!glbRmtSyncTgtLst
