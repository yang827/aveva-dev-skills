--
--
-- Description:
-- Callback function for a selection of the remote (target) location
-- in the Remote Database Synchronisation form.
-- Function to be replaced by method !!glbRmtSync.cbTarget()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncTgtSel()

  -- Initialise variables
  !selection  = !!glbRmtSync.locn.selection('rtext').dbRef()
  !curTarget  = !!glbRmtSyncTgtGet()

  -- Update the target if different
  if (!selection neq !curTarget) then

    call !!glbRmtSyncTgtSet(!selection)
    call !!glbRmtSyncDbSet()
    call !!glbRmtSyncDbLst()

  endif

endfunction
-- End of function definition for !!glbRmtSyncTgtSel
