--
-- Description:
-- Function to store the DBREF of the target location for a remote
-- synchronise command. This is the location DB will be synchronised with.
-- Function to be replaced by method !!glbRmtSync.targetSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of target location.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbRmtSyncTgtSet(!dbRef is DBREF)

  -- Store the value
  !!glbRmtSync.targetLoc  = !dbRef

endfunction
-- End of function definition for !!glbRmtSyncTgtSet
