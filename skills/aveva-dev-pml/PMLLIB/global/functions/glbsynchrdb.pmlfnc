--
-- Author:          E.conba
-- Created:         Thu Jul 31 09:37:00 BST 1997
--
--
-- Description:
-- Function to perform and PDMS Global SYNCHRONISE command based upon
-- the selected databases. This command only works for secondary
-- databases.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbSynchrDb()

  -- Initialise variables
  !mode       = !!glbSynchrDb.act.selection('rtext')
  !currentLoc = !!dbrGlbCurLocRf()
  !remoteLoc  = !!glbSynchrDb.location
  !commands   = ARRAY()

  -- Transform remote location to a string
  if (!remoteLoc.set()) then
    !target     = |WITH |+ !remoteLoc.locId
  else
    !target     = ''
  endif

  -- Action depends on the mode
  if (!mode eq 'ALL') then

    -- Synchronise all secondary databases
    !commands.append(|SYNCHRONISE ALL |+ !target)

  elseif (!mode eq 'SEL') then

    -- Get the selection variables
    !totalDb    = !!glbSynchrDb.dbArray.size()
    !selDb      = !!glbSynchrDb.db.selection('rtext')

    -- Return if no selection
    if (!selDb.unset()) then
      return
    endif

    -- See if all databases have been selected
    if (!selDb.size() eq !totalDb) then

      -- Synchronise all dbs
      !commands.append(|SYNCHRONISE ALL |+ !target)

    else

      -- Synchronise selected databases
      !!ce      = !currentLoc
      !alloc    = !!ce.mem[1].mem

      -- The order should follow the order to in which the
      -- databases appear in the current locations DBALL.
      do !i indices !selDb

        !dbRef    = !selDb[!i].dbRef()
         handle any
          -- Bad conversion
          skip
        endhandle
        !listPos  = !alloc.findFirst(!dbRef)
        !commands[!listPos] = |SYNCHRONISE |+ !dbRef.name.substring(3) +| |+!target

      enddo

      -- Compress the command as is will be
      -- sparsely populated
      !commands.compress()

    endif

  endif

  -- Process the list of commands
  do !i indices !commands

    -- *** OLD PML SYNTAX ***
    $!commands[$!i]
    handle (1,500) (1,501)
      -- Daemon errors
      !!messageFile.error(141, 723, !!error.text.after(')').trim('L'))

    elsehandle any

      -- Non-specific error
      !!messageFile.error(141, 723, !!error.text)

    endhandle

  enddo

endfunction
-- End of function definition for !!glbSynchrDb
