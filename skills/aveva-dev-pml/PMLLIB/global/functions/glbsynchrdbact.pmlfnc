--
--
-- Description:
-- Function to set the action to be performed upon APPLY for the
-- form !!glbSynchrDb.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbSynchrDbAct()

  -- Initialise variables
  !action          = !!glbSynchrDb.act.selection('rtext')

  -- Set the form gadget states depending on action
  if (!action eq 'SEL') then

    -- Gadgets are active
    !!glbSynchrDb.db.active     = true
    !!glbSynchrDb.all.active    = true
    !!glbSynchrDb.clear.active  = true
    !!glbSynchrDb.sort.active   = true
    !!glbSynchrDb.filter.active = true

  elseif (!action eq 'ALL') then

    -- Gadgets are inactive
    !!glbSynchrDb.db.active     = false
    !!glbSynchrDb.all.active    = false
    !!glbSynchrDb.clear.active  = false
    !!glbSynchrDb.sort.active   = false
    !!glbSynchrDb.filter.active = false

  endif



endfunction
-- End of function definition for !!glbSynchrDbAct
