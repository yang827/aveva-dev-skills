--
--
-- Description:
-- Function to act as a callback to the Sort and Filter gadgets
-- in the !!glbSynchrDb form. Function control the DB list gadget
-- contents based on the sort and filter gadget values.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbSynchrDbList()

  -- Capture the sort and filter gadget values
  !!glbSynchrDb.dbSort    = !!glbSynchrDb.sort.selection('dtext')
  !!glbSynchrDb.dbFilter  = !!glbSynchrDb.filter.val

  -- Clear the database list
  !!glbSynchrDb.db.clear()

  -- Sort, filter and display the database list
  !displayList = !!adminFilterSort(!!glbSynchrDb.dbArray,!!glbSynchrDb.sort,!!glbSynchrDb.filter)
  !!adminDbTxtList(!displayList,!!glbSynchrDb.db,!!admDisplayConfig.fmtDbGet(),!!admDisplayConfig.eleTypeGet(), object DBREF())


endfunction
-- End of function definition for !!glbSynchrDbList
