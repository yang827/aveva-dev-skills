--
--
-- Description:
-- Function to maintain the list of databases that are common
-- to the current location and the target location for the
-- synchronise operation. All database listed will be secondary
-- at the current location. Update of list in form !!glbSynchrDb.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbSynchrDbLocn()

  -- Initialise variables
  !localLoc    = !!dbrGlbCurLocRf()
  !localDbs    = ARRAY()
  !remoteDbs   = ARRAY()

  -- Set the target location
  if (!!glbSynchrDb.target.selection('rtext') eq 'PRI') then
    !targetLoc   = object DBREF()
  else
    !targetLoc   = !!glbSynchrDb.locn.selection('rtext').dbRef()
    !!glbSynchrDb.location = !targetLoc
  endif

  -- Get the local secondary databases (non-foreign)
  !!ce         = !localLoc
  !localAlloc  = !!ce.mem[1].mem
  do !db values !localAlloc
    skip if !db.badRef()
    skip if (!db.foreign neq 'LOCAL')
    skip if (!db.primDb  neq 'SECONDARY')
    !!ce         = !db
    DBLOC 1
    if (!!ce.propg) then
      !localDbs.append(!db)
    endif
  enddo

  -- Get the target locations secondary databases (non-foreign)
  if (!targetLoc.set()) then

    !!ce         = !targetLoc
    !targetAlloc = !!ce.mem[1].mem
    do !db values !targetAlloc
      skip if !db.badRef()
      skip if (!db.foreign neq 'LOCAL')
      !!ce         = !db
      DBLOC 1
      if (!!ce.locRf neq !localLoc and !!ce.propg) then
        !remoteDbs.append(!db)
      endif
    enddo

  endif

  -- Set the list of databases depending upon the
  -- Target location
  if (!targetLoc.set()) then
    -- Only use common databases
    !!glbSynchrDb.dbArray  = !localDbs.intersect(!remoteDbs)
  else
    -- Display all the local databases
    !!glbSynchrDb.dbArray  = !localDbs
  endif

  -- Update the database list contents
  call !!glbSynchrDbList()

endfunction
-- End of function definition for !!glbSynchrDbLocn
