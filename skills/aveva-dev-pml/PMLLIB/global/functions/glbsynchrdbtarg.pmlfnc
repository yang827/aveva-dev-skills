--
--
-- Description:
-- Function to control form gadget states depending upon the selected
-- synchronisation target. The location list gadget becomes inactive
-- is the Target is "Primary Locations".
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbSynchrDbTarg()

  -- Initialise variables
  !target   = !!glbSynchrDb.target.selection('rtext')

  -- Set mode depending on target
  if (!target eq 'PRI') then

    -- Gadget becomes inactive
    !!glbSynchrDb.locn.active   = false
    !!glbSynchrDb.location      = object DBREF()

  elseif (!target eq 'SEL') then

    -- Gadget becomes active
    !!glbSynchrDb.locn.active   = true
    !!glbSynchrDb.location      = !!glbSynchrDb.locn.selection('rtext').dbRef()

  endif

  -- Update the databases list based upon location
  call !!glbSynchrDbLocn()

endfunction
-- End of function definition for !!glbSynchrDbTarg
