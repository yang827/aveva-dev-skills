-- Author:          E.conba
-- Created:         Mon Oct 27 15:48:07 GMT 1997
--
--
-- Description:
-- Function to import or export data from to or from an off-line
-- location. An environment variable must exist and point to
-- <PROJ>_<locId> where LOCID is the target for export, or source for
-- import.
-- Function to be replaced by method !!glbTransfer.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbTransfer()

  -- Initialise variables
  !project     = CURRENT PROJECT
  !action      = !!glbTransfer.action.selection('rtext')
  !location    = !!glbTransfer.loc.selection('rtext').dbRef()
  !locId       = !location.locId
  !dirArray    = ARRAY()

  -- Check that the environment variable exists
  !evarArray = !!evarSplit(!project.code() +|_|+ !locId)
  !evarValue = !evarArray[1]
  handle(2,752)

    -- Variable returns no value
    !!messageFile.error(141, 532, !locId, !project.code() +|_|+ !locId)

  endhandle

  -- Check that the directory exists

  !directory = object FILE(!evarValue)
  if (not !directory.exists()) then

    -- directory does not exist
    !!messageFile.error(146, 023, !evarValue)

  endif

  -- Directory exists, now check project structure

  -- Resolve any database areas
  !!ce         = !!dbrAdminGetWorld('TEAM')
  !dbs         = !!collectAllFor('DB','',!!ce)
  !areaBlock   = object BLOCK(|'000'+ !dbs[!evalIndex].area.string()|)
  !areas       = !dbs.evaluate(!areaBlock)
  !areas.unique()

  -- Construct array of required directories
  !dirArray    = !areas
  !dirArray.append('pic')
  !dirArray.append('mac')
  !dirArray.append('iso')

  -- Check that the project directories have been reconstructed.

  !subDirs = !directory.subDirs()

  do !value values !dirArray

    !dirName     = !project.code() + !value.substring(-3,3)
    !dirFound = false
    do !path values !subDirs
      -- Comparison is not case-sensitive
      if( !path.entry().lowcase() eq !dirName.lowcase() ) then
        !dirFound = true
        !dirPath = !path
      endif
    enddo
    if (not !dirFound) then

      -- Directory not found
      !!messageFile.error(146, 023, !dirName)
      return
    endif

    -- Check  the directory contents
    !files = !dirPath.files()
    handle (61,143)
      !noFiles = true
    elsehandle none
      if (!files.size() ne 0) then
        !noFiles = false
      else
        !noFiles = true
      endif
    endhandle

    if (!action eq 'EXPORT') then
      -- Check export directories are empty
      if (not !noFiles) then
        !!messageFile.error(141, 533,  !directory.entry() + '/' + !dirName)
        return
      endif

    elseif (!value.substring(-3,3) eq '000' and !action eq 'IMPORT') then

      -- For import check that at least '000' contains files
      if (!noFiles) then
        !!messageFile.error(141, 534, !directory.entry() + '/' + !dirName)
        return
      endif

    endif

  enddo

  -- Directories check out so lets do the transfer
  if (!action eq 'EXPORT') then
    !command   = |TRANSFER TO '|+ !locId +|'|
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 535, !locId))
  elseif (!action eq 'IMPORT') then
    !command   = |TRANSFER FROM '|+ !locId +|'|
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 536, !locId))
  endif

  -- Checkout the user response
  if (!answer.boolean()) then

    -- Perform the transfer
    !!messageFile.prompt(141, 537,  !action.substring(1,1) + !action.lowcase().substring(2) +'ing',  !locId)

    $!command
    handle any
      !!messageFile.warning(141, 538,  !action.substring(1,1) + !action.lowcase().substring(2),  !locId,  !!error.text)
    endhandle

    call !!prompt(0)

    -- Repair if necessary
    if (!action eq 'IMPORT') then
      if (!location eq !!dbrAdminGetWorld('LOC').hubrf) then
        var !repairRequired REPAIRREQUIRED
        if (!repairRequired.real() gt 0) then
          if (!repairRequired.real() eq 1) then
            !doRepair = !!alert.confirm('The System Database requires 1 repair. Do you wish to repair it now?')
          elseif (!repairRequired.real() gt 1) then
            !doRepair = !!alert.confirm('The System Database requires ' & !repairRequired & ' repairs. Do you wish to repair them now?')
          endif
          if (!doRepair.boolean()) then
            show !!admRepair
          endif
        endif
      endif
    endif

  endif

endfunction
-- End of function definition for !!glbTransfer
