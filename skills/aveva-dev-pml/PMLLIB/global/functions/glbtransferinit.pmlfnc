--
--
-- Description:
-- Function to initialise the Offline Data Transfer form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbTransferInit()

  -- Initialise variables
  !locations  = ARRAY()
  !locRef     = !!dbrGlbCurLocRf()
  !hubRef     = !!dbrGlbHubLocRf()
  !!ce        = !!dbrAdminGetWorld('LOC')

  -- Get 'transferable locations'
  if (!locRef eq !hubRef) then

    -- Transfer only to offline locations
    !clause     = 'iconn eq 0'
    !locations  = !!collectAllFor('LOC',!clause,!!ce)

  else
  	if( !locRef.iConn neq 0 ) then
  		-- Current location is not the Project Hub or an off-line location
  		!!messageFile.error(1,413)
  		return
    endif

    -- Transfers only from the hub
    !locations.append(!hubRef)

  endif

  -- Check that there are off-line locations
  if (!locations.size() eq 0) then

    -- No off-line locations
    !!messageFile.error(141, 531)

  endif

  -- Sort the locations by name
  !lBlock    = object BLOCK(|!locations[!evalIndex].name|)
  !names     = !locations.evaluate(!lBlock)
  !order     = !names.sortedIndices()
  !locations.reIndex(!order)

  -- Display the list of locations
  !!glbTransfer.loc.clear()
  call !!adminLocnTxtList(!locations, !!glbTransfer.loc)

endfunction
-- End of function definition for !!glbTransferInit
