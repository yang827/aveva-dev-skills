--
--
-- Description:
-- Function to refresh the contents of the Update Order form.
-- Function to be replaced by method !!glbUpdOrd.refresh(STRING)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Part of form to update 'LOC' or 'DB'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!glbUpdOrdRefresh(!refresh is STRING)

  -- Refresh update order form if shown
  if (defined(!!glbUpdOrd)) then
    if (!!glbUpdOrd.shown()) then
      if (!refresh eq 'LOC') then
        -- Refresh locations if required (this also refreshes allocation)
        !!glbUpdOrd.init()
      elseif (!refresh eq 'DB') then
        -- Refresh allocation if required (the form method checks if the allocation has changed)
        !!glbUpdOrd.selectLocation()
      endif
    endif
  endif

endfunction
-- End of function definition for !!glbUpdOrdRefresh
