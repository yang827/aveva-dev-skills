-- Author:          N.Holmes
-- Created:         Web Feb 23 15:40:00 GMT 2000
--
--
-- Description:
--  Check and returns true if the passed db is allocated to the
--  specified location.
--
------------------------------------------------------------------------

-- Define object
define function !!isAllocatedTo(!dbName is STRING, !locationName is STRING) is BOOLEAN

  -- DB
  !db            = object DB(!dbName)
  handle ANY
    return false
  endhandle

  -- Location name
  !location      = !!location(!locationName)

  -- Get DB Allocation
  !dbAllocated   = !location.dbAll

  -- Convert all dbs into strings
  !block         = object BLOCK('!dbAllocated[!evalIndex].flnn.after(|*|)')
  !databases     = !dbAllocated.evaluate(!block)

  -- See if db is in allocation list
  !index         = !databases.findFirst(!dbName)

  -- Not found
  if(!index.unset()) then
    !!error.text = 'Database ' & !db & ' is not currently allocated to ' & !location.name & '.'
    return false
  else
    !!error.text = ''
    handle any
    endhandle
    return true
  endif

return
