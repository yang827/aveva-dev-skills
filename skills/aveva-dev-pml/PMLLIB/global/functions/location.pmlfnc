--
--
-- Description:
--  Return location element for passed location.
--
------------------------------------------------------------------------

-- Define object
define function !!location(!locationCheck is STRING) is DBREF

  -- Initialise Variables
  !reference    = !!ce
  !locationName = !locationCheck.upcase()

  -- Move to the location world
  !locations = LOCLI 1 of /*GL
  handle ANY
    !!error.text = 'Not a global project'
    return object DBREF()
  endhandle

  -- Loop through each location
  do !location values !locations.members
    if(!locationName.match(!location.locID).boolean() or !location.locID.match(!locationName).boolean()) then
      !!ce = !reference
      return !location
    endif
  enddo

  !!error.text = 'Unknown location (' & !location & ')'
  !!ce = !reference
  return object DBREF()

endfunction
-- End of function definition
