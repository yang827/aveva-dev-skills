--
-- Author:          E.conba
-- Created:         Thu Jun 26 08:33:00 BST 1997
--
--
-- Description:
-- Function to query the lock and/or isolation of a remote project
-- location. Both location must be on-line.
-- **** This is modified for Early testing ****
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!qryLockIsol()

  -- Initialise Variables
  !qryLocRef   = !!qryLockIsol.locn.selection('rtext').dbRef()
  !qryLocName  = !qryLocRef.name


  -- Query Lock
  if (!!qryLockIsol.qLock.val) then

    --!lockResult  = LOCK AT $!qryLocName
    -- *** OLD PML SYNTAX ***
    var !lockResult LOCK AT $!qryLocName
    handle  (1,500) (1,501)

      -- Daemon errors
      !!qryLockIsol.lock.val  = |Unknown|
      !!messageFile.error(141, 705, !!error.text.after(')').trim('L'))

    elsehandle any

      -- Non-specific error
      !!qryLockIsol.lock.val  = |Unknown|
      !!messageFile.error(141, 705, !!error.text)

    elsehandle none

      -- Post the result
      !!qryLockIsol.lock.val  = !lockResult

    endhandle

  endif

  -- Query Isolation
  if (!!qryLockIsol.qIsol.val) then

    -- !isolResult  = ISOLATION AT $!qryLocName
    -- *** OLD PML SYNTAX ***
    var !isolResult ISOLATION AT $!qryLocName
    handle  (1,500) (1,501)

      -- Daemon errors
      !!qryLockIsol.isol.val  = |Unknown|
      !!messageFile.error(141, 705, !!error.text.after(')').trim('L'))

    elsehandle any

      -- Non-specific error
      !!qryLockIsol.isol.val  = |Unknown|
      !!messageFile.error(141, 705, !!error.text)

    elsehandle none

      -- Post the result
      if (!isolResult.boolean()) then
        !!qryLockIsol.isol.val  = 'Isolated'
      else
        !!qryLockIsol.isol.val  = 'Connected'
      endif

    endhandle

  endif


endfunction
-- End of function definition for !!qryLockIsol
