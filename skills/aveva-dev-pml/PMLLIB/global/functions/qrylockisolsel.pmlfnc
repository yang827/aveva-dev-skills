-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!qryLockIsolSel()

  -- Initialise variables
  !locRef                  = !!qryLockIsol.locn.selection('rtext').dbRef()

  -- Set form variables
  !!qryLockIsol.locId.val  = !locRef.locId
  !!qryLockIsol.lock.val   = 'Unknown'
  !!qryLockIsol.isol.val   = 'Unknown'


endfunction
-- End of function definition for !!qryLockIsolSel
