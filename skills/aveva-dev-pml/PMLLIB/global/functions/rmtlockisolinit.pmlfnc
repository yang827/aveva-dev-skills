--
--
-- Description:
-- Function to initialise the hub form to set the location lock and
-- isolation of remote on-line locations.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!rmtLockIsolInit()

  -- Initialise variables
  !locRef = !!dbrGlbCurLocRf()

  -- Make sure current location is online
  if (!locRef.iconn.boolean().not()) then
    -- Cannot run for an off-line site
    !!messageFile.error(141, 602)
  endif

  -- Collect all on-line initialised location for this project
  !!ce    = !!dbrAdminGetWorld('LOC')
  !clause = 'ICONN eq 1 and LINIT eq TRUE and REF neq '+ !locRef.string()
  !locn   = !!collectAllFor('LOC', !clause, !!ce)

  -- Check that we have some locations
  if (!locn.unset()) then
    !!messageFile.error(141, 701)
  endif

  -- Sort the list of locations (on name)
  do !i indices !locn
    !name[!i]  = !locn[!i].name.substring(2)
  enddo

  !sortOrder = !name.sortedIndices()
  !locn.reIndex(!sortOrder)

  -- Build the list of texts
  call !!adminLocnTxtList(!locn,!!rmtLockIsol.locn)


endfunction
-- End of function definition for !!rmtLockIsolInit
