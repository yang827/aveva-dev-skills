-- !location example /CAMBRIDGE
-- !qryAllocated is an array of strings where strings are database names
-- !primary is an array of booleans where booleans are whether database names are to be primary a location

define function !!tstAllocRecdpm(!location is DBREF, !qryAllocated is ARRAY, !primary is ARRAY) is BOOLEAN

  CLOCK INIT

  -- Navigate to the location element
  !!ce = !location

  -- Initialise variables
  !numberReceived = 0
  do !i indices !qryAllocated
    !received[!i] = false
  enddo
  !allReceived = false

  -- This needs doing in an infinite loop till all db are received
  -- go to the database allocation element
  do

    -- Add a failsafe check to stop the function
    !file = object FILE('c:\stopAllocationCheck')
    if (!file.exists()) then
      write 'Forced - Allocation check stopped because file c:\stopAllocationCheck exists'
      write 'The macro will attempt to delete the file.'
      break
    endif

    GETWORK

    -- Relook at the db allocation
    !dball = DBALL
    -- For each of the allocated dbs
    do !i indices !qryAllocated
      -- Only loop if the new allocation is not already flagged as received
      if (!received[!i].not()) then

        -- For each of the db allocation
        do !j indices !dball
          !dballName = !dball[!j].name
          !received[!i] = (!dballName eq !qryAllocated[!i])
          if (!received[!i] and !primary[!i]) then
            -- Check that db is primary at location
            if (!primary[!i]) then
              !locref = object DBREF()
              !locref = LOCRF of 1 DBLOC of $!qryAllocated[$!i]
              handle ANY
                -- DBLOC element might not be there
              endhandle
              if (!locref eq !location) then
              	!outString = $!qryAllocated[$!i] & ' received as primary!'
              	write (!outString)
                !numberReceived = !numberReceived + 1
                CLOCK READ
                break
              else
                !received[!i] = false
              endif
            endif
          elseif (!received[!i] and !primary[!i].not()) then
          	!outString = $!qryAllocated[$!i] & ' received !'
          	write (!outString)
            !numberReceived = !numberReceived + 1
            CLOCK READ
            break
          endif
        enddo

      endif
    enddo

    PAUSE 5
    if (!numberReceived eq !qryAllocated.size()) then
      !allReceived = true
      write 'All received !'
      CLOCK READ
    endif
    if (!allReceived) then
      return true
    endif

  enddo

  -- Tidy up the failsafe check to stop the function
  !file = object FILE('c:\stopAllocationCheck')
  if (!file.exists()) then
    !file.deleteFile()
    handle ANY
      write 'Attempted to delete file c:\stopAllocationCheck but failed, Please delete'
    elsehandle NONE
      write 'File c:\stopAllocationCheck deleted'
    endhandle
  endif

return false

endfunction
