--   Type:          Object Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        global
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Mon Jan 17 15:09:29 "GMT 2000
--
--
-- Description:
-- Report a summary of global actions
--
------------------------------------------------------------------------

define object GLBACTIONREPORT

  -- Array of DBREFTEXT objects containing report summary
  member .report     is ARRAY

  -- can have values 'FORM' (Summary report form), 'LOG' (output using $P), 'FILE' (output to file)
  member .outputTo   is STRING

endobject
-- End of object definition for GLBACTIONREPORT


------------------------------------------------------------------------
--
-- Method:      glbActionReport
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .glbActionReport()

    -- initialise for output to summary report form
    !this.outputTo = 'FORM'

endmethod
-- End of method definition for .glbActionReport()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: clear report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .clear()

  -- Display current element
  !this.report.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Adds a message to the current progress/error report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Brief message to for report header
--    2   R      STRING      Detailed message to add to the report
--    3   R      DBREF       Dbref of item relating to the error
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .append(!brief is STRING, !detail is STRING, !item is DBREF)

  !message         = object DBREFTEXT()
  !message.brief   = !brief
  !message.detail  = !detail
  !message.element = !item
  !this.append(!message)

endmethod
-- End of method definition for .append(STRING, STRING, DBREF)

------------------------------------------------------------------------
--
-- Method:      append
--
-- Description: Adds a message to the current progress/error report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREFTEXT   Append DBREFTEXT message
--    2   R      STRING      Detailed message to add to the report
--    3   R      DBREF       Dbref of item relating to the error
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .append( !message is DBREFTEXT )

    -- add to end of report array
  !this.report.append(!message)

endmethod
-- End of method definition for .append( DBREFTEXT )

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Displays summary report output.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form Title (or filename for a file)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .display( !formTitle is STRING )

  if( !this.report.empty() ) then
    return
  endif

  -- select output medium
  if( !this.outputTo.upcase() eq 'FORM' ) then
    if( not defined( !!admActionSummary ) ) then
      pml load form !!admActionSummary
    endif
    !!admActionSummary.display(!this.report)
  elseif( !this.outputTo.upcase() eq 'FILE' ) then
    -- output to file - formTitle is a filename
    !this.fileDisplay( !formTitle )
  else
    -- output using $P - formTitle is a heading
    !this.requestDisplay( !formTitle )
  endif

endmethod
-- End of method definition for .display( STRING )

------------------------------------------------------------------------
--
-- Method:      fileDisplay
--
-- Description: Displays summary report output to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .fileDisplay( !filename is STRING )

  -- open file for output
  -- strip spaces from filename
  !name = !filename.replace(' ','')
  -- open file
  !file = object FILE(!name)
  !file.open('OVERWRITE')

  -- loop through report and format the output
  do !record values !this.report

    !element   = !record.element.flnn
    handle any
      !element = 'UNKNOWN'
    endhandle
    !brief = !record.brief.trim()
    var !display COMPOSE         |$!<brief>|         WIDTH 18 SPACE 2 |-| SPACE 2 |$!element|
    var !detail  COMPOSE SPACE 5 |$!<record.detail>| WIDTH 70

    -- choose output to file or command line
    !file.writeRecord(!display[1])
    !file.writeRecord(!detail[1])
    if(defined(!detail[2])) then
      !file.writeRecord(!detail[2])
    endif

    !detail.clear()

  enddo

  -- output summary of report
  !file.writeRecord(' ')
  !file.writeRecord('____________________________________________________________________________')
  !file.writeRecord(' ')
  !file.writeRecord(' Processed ' & !this.report.size().string() & ' elements')
  !file.writeRecord('____________________________________________________________________________')

  -- close file for output
  !file.close()

endmethod
-- End of method definition for .fileDisplay( STRING )

------------------------------------------------------------------------
--
-- Method:      requestDisplay
--
-- Description: Displays summary report output to screen ($P)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      report header
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  define method .requestDisplay( !header is STRING )

  write(' ')
  write('$!header')
  write(' ')

  -- loop through report and format the output
  do !record values !this.report

    !element   = !record.element.flnn
    handle any
      !element = 'UNKNOWN'
    endhandle
    !brief = !record.brief.trim()
    var !display COMPOSE         |$!<brief>|         WIDTH 18 SPACE 2 |-| SPACE 2 |$!element|
    var !detail  COMPOSE SPACE 5 |$!<record.detail>| WIDTH 70

    write('$!display[1]')
    write('$!detail[1]')
    if(defined(!detail[2])) then
      write('!detail[2]')
    endif

    !detail.clear()

  enddo

  -- output summary of report
  write(' ')
  write('____________________________________________________________________________')
  write(' ')
  !summary = ' Processed ' & !this.report.size().string() & ' elements'
  write('$!summary')
  write('____________________________________________________________________________')

endmethod
-- End of method definition for .requestDisplay( STRING )
