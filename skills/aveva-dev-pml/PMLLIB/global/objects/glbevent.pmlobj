-- Created:         Mon Nov 10 09:37:10 GMT 1997
--
--
-- Description:
-- Object definition to store Event objects without any dbrefs or methods which
-- may be local Sys Db specific
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  event2GlbEvent(DBREF)            -                   To capture a glbevent from a Event
--

-- Define object
define object GLBEVENT
  member .name is STRING
  member .lock is BOOLEAN
  member .description is STRING
  member .locRfname is STRING
  member .locRfdesc is STRING
  member .timeR is STRING
  member .times is REAL
  member .timeE is REAL
  member .timeI is REAL
  member .timeO is REAL
  member .execB is STRING
  member .execA is STRING
endobject
-- End of object definition for GLBEVENT

------------------------------------------------------------------------
--
-- Method:      .event2GlbEvent()
--
-- Description: To capture a glbevent from a Event
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .event2GlbEvent(!event is DBREF)
  !this.name = !event.name
  !this.lock = !event.lock
  !this.description = !event.description
  !this.locRfname = !event.locRf.name
  !this.locRfdesc = !event.locRf.description
  !this.timeR = !event.timeR
  !this.times = !event.times
  !this.timeE = !event.timeE
  !this.timeI = !event.timeI
  !this.timeO = !event.timeO
  !this.execB = !event.execB
  !this.execA = !event.execA
endmethod
-- End of method definition for .event2GlbEvent(DBREF)
