-- Created:         Mon Nov 10 09:37:10 GMT 1997
--
--
-- Description:
-- Object definition to store MDB objects without any dbrefs or methods which require
-- the source Sys DB to be open
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdb2GlbMdb(MDB)                  -                   To capture a glbuser from a User
--

-- Define object
define object GLBMDB
  member .currDbName is ARRAY
  -- corresponding DBs description
  member .currDbDesc is ARRAY
  member .defDbName is ARRAY
  -- corresponding DBs description
  member .defDbDesc is ARRAY
  member .name is STRING
  member .description is STRING
endobject
-- End of object definition for GLBMDB

------------------------------------------------------------------------
--
-- Method:      .mdb2GlbMdb()
--
-- Description: To capture a glbuser from a User
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .mdb2GlbMdb(!mdb is MDB)
  !this.name = !mdb.name
  !this.description = !mdb.description

  !temp1 = !mdb.current()
  !this.currDbName.clear()
  !this.currDbDesc.clear()
  do !i values !temp1
    !this.currDbName.append(!i.name)
    !this.currDbDesc.append(!i.description)
  enddo
  !temp2 = !mdb.deferred()
  !this.defDbName.clear()
  !this.defDbDesc.clear()
  do !j values !temp2
    !this.defDbName.append(!j.name)
    !this.defDbDesc.append(!j.description)
  enddo

endmethod
-- End of method definition for .mdb2GlbMdb(MDB)
