--
-- Description: Object to serve local and remote update and synchronise
-- operation forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  atLocGet()                       DBREF               returns the location the recover is to be done from!
--  atLocSet(DBREF)                  -                   returns the location the recover is to be done from!
--  cbApply()                        -                   recover a database in case of failure.
--  cbApplySystem(STRING)            -                   recover a system database in case of failure.
--  cbApplyUser(STRING)              -                   recover a user database in case of failure.
--  cbAtLocn()                       -
--  dbGet(STRING)                    ANY                 Returns the stored array of databases DBREF applicable to the
--  dbList()                         -                   Update and maintain the Database list gadgets based on
--  dbLoad(DBREF)                    -                   Load the current locations databases into the form member
--  dbSel()                          -                   deal with the selection of the database to recover.
--  getPossLocs()                    -                   Get all the locations this site can recover for:-
--  glbRecoverDb()                   -                   Constructor
--  initLocal()                      -                   Initialise the Recover Db form (!!glbDbRec).
--  initRemote()                     -
--  locGet()                         DBREF               Returns the stored target location, that is currently selected in
--  locList(DBREF,DBREF)             -                   maintain the location list gadget contents in the
--  locSel()                         -                   deal with the selection of the a location to
--  parentForm(FORM)                 -                   Store form which this object instance serves
--  targGet()                        STRING              return the current target required for recovery.
--  target()                         -                   control the gadget states in the Recover Database form.
--
------------------------------------------------------------------------

define object GLBRECOVERDB

  -- Member Definitions
  -- Form served by this object instance
  member  .form       is FORM
  -- Remote Location (Global Plus) - Set to local location for Global 1
  member .atLocation  is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .glbRecoverDb()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbRecoverDb()

  -- .atLocation unset indicates that no AT command is needed
  !this.atLocation = object DBREF()

endmethod
-- End of form definition for !!glbRmtRec

------------------------------------------------------------------------
--
-- Method:      .parentForm(FORM)
--
-- Description: Store form which this object instance serves
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parentForm(!form is FORM)

  !this.form = !form

endmethod
-- End of method definition for .parentForm(FORM)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: recover a database in case of failure.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !location  = !this.locGet()
  !target    = !this.targGet()
  !atLoc     = !this.atLocGet()

  if(!this.form.locn.dText.size() lt 1)then
    -- Error no location to recover database from
    !dbName = !this.form.db.selection().dbRef().name.substring(3)
    handle any
      !dbName = 'unknown'
    endhandle
    !!messageFile.error(141, 706, !dbName)
    return
  endif

  -- if the target is something other than the designated primary location
  !targetTxt = ||
  if(!this.form.target.selection(|RTEXT|) eq |SELECT|)then
    !targetTxt = ' FROM |' + !location.locId +'|'
  endif

  -- if the at location is something other than the current location
  if(!atLoc eq !!dbrGlbCurLocRf() or badref(!atLoc ))then
    !atTxt = ||
  else
    !atTxt = ' AT |' + !atLoc.locId + '|'
  endif

  if(!this.form.userDbs)then
    !this.cbApplyUser( !atTxt + !targetTxt )
  else
    !this.cbApplySystem( !atTxt + !targetTxt )
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .cbApplyUser()
--
-- Description: recover a user database in case of failure.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      From and At arguments in command form
-- Return:
--   [Data Type] [Description]
--
  ------------------------------------------------------------------------

define method .cbApplyUser( !fromAtCommand is STRING )

  -- Initialise variables
  !database  = !this.dbGet('SELECT')
  !location  = !this.locGet()
  !target    = !this.targGet()
  !dbToDo    = !this.form.db.selection(|RTEXT|)
  !atLoc     = !this.atLocGet()

  !dbsInPackage = ARRAY()

  !dbsInPackage.append(!database)

  -- Warn users all about recovery (more severe is primary)
  !!ce = !database
  DBLOC 1
  -- if dbLoc is the at location for this command, potentially bad!
  if (!!ce.locRf eq !atLoc) then
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 707))
  else
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 708))
  endif

  -- Check the users response
  if (!answer.boolean().not()) then
    return
  endif

  -- The user wants to continue
  -- Proceed with caution
  -- *** OLD STYLE PML SYNTAX ***

  -- only use report mechanism if more than one DB recovered
  !useReport = !dbsInPackage.size() gt 1
  if( !useReport ) then
    -- initialise report object
    !updateReport = object GLBACTIONREPORT()
    !updateReport.clear()
  endif

  -- issue recover command for each DB
  do !adb values !dbsInPackage

    !arguments = !adb.name.substring(3) + !fromAtCommand
    !command = |RECOVER | + !arguments
    call !!admCommand(!command)
    handle (1,500) (1,501)
      -- Cannot contact global daemon (local)
      !brief   = 'RECOVER FAILED'
      !message = 'Recover failed: ' + !!messageFile.messageString(141, 709, !adb.name.substring(3), !!error.text.after(')').trim('L'))
    elsehandle any
      -- Non specific error
      !brief   = 'RECOVER FAILED'
      !message = 'Recover failed: ' + !!messageFile.messageString(141, 709, !adb.name.substring(3), !!error.text)
    elsehandle none
      !brief   = 'RECOVER INITIATED'
      !message = 'Recover initiated: ' + !arguments
    endhandle
    if( !useReport ) then
      !updateReport.append(!brief, !message, !adb)
    else
      if( !brief eq 'RECOVER INITIATED' ) then
        !!alert.message( !message )
      else
        !!alert.error( !message )
      endif
    endif

  enddo

  if( !useReport ) then
    -- show the summary report
    !updateReport.display('Recover Summary')
    !updateReport.clear()
  endif

endmethod
-- End of method definition for .cbApplyUser( STRING )

------------------------------------------------------------------------
--
-- Method:      .cbApplySystem()
--
-- Description: recover a system database in case of failure.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      From and At arguments in command form
-- Return:
--   [Data Type] [Description]
--
  ------------------------------------------------------------------------

define method .cbApplySystem( !fromAtCommand is STRING )

  -- Initialise variables
  !dbToDo    = !this.form.db.selection(|RTEXT|)
  !atLoc     = !this.atLocGet()
  !dbRef     = object DBREF()
  !local     = false

  -- Check to see if we are processing the system db of this location
  if (!dbToDo eq !atLoc.name) then
    !local = true
  endif

  -- get location of system DB
  !dbRef = !dbToDo.dbRef()

  -- Confirm messages for primary or secondary db's
  if ((!dbRef.prmRf EQ !atLoc) OR (!local)) then
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 707))
  else
    !answer    = !!alert.confirm(!!messageFile.messageString(141, 708))
  endif

  -- Check the users response
  if (!answer.boolean().not()) then
    return
  endif

  -- The user wants to continue
  -- Proceed with caution
  -- *** OLD STYLE PML SYNTAX ***
  !command = |RECOVER SYSTEM FOR | + !dbToDo + !fromAtCommand
  call !!admCommand(!command)
  handle (1,500) (1,501)
    -- Cannot contact global daemon (local)
    !!alert.error(!!messageFile.messageString(141, 709, 'SYSTEM', !!error.text.after(')').trim('L')))
  elsehandle any
    -- Non specific error
    !!alert.error(!!messageFile.messageString(141, 709, 'SYSTEM', !!error.text))
  elsehandle none
    !!alert.message('Recover initiated: ' + !dbToDo.substring(2) + ' System database ' + !fromAtCommand)
  endhandle

endmethod
-- End of method definition for .cbApplySystem( STRING )

------------------------------------------------------------------------
--
-- Method:      .dbGet()
--
-- Description: Returns the stored array of databases DBREF applicable to the
-- form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element to return (SELECT / ARRAY)
-- Return:
--   [Data Type] [Description]
--    ANY         Return a DBREF or and ARRAY depending on argument.
--
------------------------------------------------------------------------

define method .dbGet(!what is STRING) is ANY

  if (!what eq 'ARRAY') then
    return !this.form.dbArray
  else
    return !this.form.database
  endif

endmethod
-- End of method definition for .dbGet(STRING) ANY

------------------------------------------------------------------------
--
-- Method:      .dbList()
--
-- Description: Update and maintain the Database list gadgets based on
-- sort and filter values in form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbList()

  -- Clear the database list
  !this.form.db.clear()
  !this.form.database =  object DBREF()
--  !this.form.dbArray.clear()
  -- USER or SYSTEM
  if(!!admControl.isValid('Centralised Admin')) then
    -- System DB's in Global Plus only
    !this.form.userDbs = !this.form.whichDbs.selection(|rtext|) eq |USER|
  else
    !this.form.userDbs = true
  endif

  if(!this.form.userDbs)then

    -- USER Dbs
    -- Capture the sort and filter gadget values
    !this.form.dbSort     = !this.form.sort.selection('dtext')
    !this.form.dbFilter   = !this.form.filter.val

    -- Sort and filter the dbArray
    !displayRefs          = !!adminFilterSort(!this.dbGet('ARRAY'), !this.form.sort, !this.form.filter)

    -- Create display texts
    !format2Use = !!admDisplayConfig.fmtDbGet()
    !!adminDbTxtList(!displayRefs,!this.form.db,!format2Use,!!admDisplayConfig.eleTypeGet(), object DBREF())

    -- Get the default selection
    !this.dbSel()

    !this.form.sort.active   = TRUE
    !this.form.filter.active = TRUE

  else

    -- SYSTEM Dbs
    !atLoc     = !this.atLocGet()
    if( !atLoc.unset() ) then
      !atLoc   = !!dbrGlbCurLocRf()
    endif

    !tempDtext = !this.form.db.dText
    !tempRtext = !this.form.db.rText

    -- Get a list of other locations sys db's secondary here! (only Global Plus)
    if(!!admControl.isValid('Centralised Admin')) then
       !tempDtext.insert(1,  |-  Local System Database|)
       !tempRtext.insert(1,  !atLoc.name)

       -- Get a list of other locations sys db's secondary here!
       -- the next line get an array of locations
       !arrayLocs = !!dbrAdminGetWorld(|LOC|).mem[2].mem
       !text = ||
       do !i values !arrayLocs
         if((!atLoc NEQ !i) AND (!i.lInit))then
           !text = |-  Local Copy of | + !i.name.substring(2) + |'s System Database|
           !tempDtext.append(!text)
           !tempRtext.append(!i.name)
         endif
       enddo
     endif

    !this.form.db.dText = !tempDtext
    !this.form.db.rText = !tempRtext

    !this.form.sort.active   = FALSE
    !this.form.filter.active = FALSE

  endif

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
-- Method:      .dbLoad()
--
-- Description: Load the current locations databases into the form member
-- for the DBREFs.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbLoad(!atLocn is DBREF)

  -- Clear the current database array
  !this.form.dbArray.clear()

  !prompt = 'Collecting database information from location ' + !atLocn.locId
  PROMPT |$!prompt|

  -- Collect all the DBrefs in the DBALL attribute
  !!ce       = !atLocn
  !dbRefs    = !!ce.mem[1].mem

  -- Only get the project databases that are local and propagated
  do !db values !dbRefs
    skip if (!db.foreign neq 'LOCAL')
    !!ce       = !db
    DBLOC 1
    if (!!ce.propg) then
      !this.form.dbArray.append(!db)
    endif
  enddo

  -- Update the list gadget with the contents
  !this.dbList()

  PROMPT DISMISS

  -- Get the defaults location
  !this.dbSel()

endmethod
-- End of method definition for .dbLoad(DBREF)

------------------------------------------------------------------------
--
-- Method:      .dbSel()
--
-- Description: deal with the selection of the database to recover.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbSel()

  PROMPT 'Find locations from which the selected databases can be recovered'

  -- Conditional, get locations!
  if(!this.form.userDbs.not())then
    -- get the locations this System db can be recovered from!
    !this.locList(!this.form.database,!this.atLocGet())
  else
    -- Get the user DBs selection
    !selRef                = !this.form.db.selection('rtext').dbRef()
    handle any
      -- Bad selection
      !this.form.database  = object DBREF()
    endhandle
    -- Store the selected database
    !this.form.database  = !selRef
    -- Update the contents of the location list
    -- Only locations the DB is present at
    !this.locList(!selRef,!this.atLocGet())
  endif

  PROMPT DISMISS

endmethod
-- End of method definition for .dbSel()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise the Recover Db form (!!glbRmtRec).
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initRemote()

  -- Populate atLocn gadget, with site this actual site can administer!
  !this.getPossLocs()

  -- Initialise variables
  !currentLoc  = !this.atLocGet()

  -- Make sure current location is online
  if (!currentLoc.iconn.boolean().not()) then
    -- Cannot run for an off-line site
    !!messageFile.error(141, 602)
  endif

  -- Restore previous sort states
  if (!this.form.dbSort.set()) then
    !this.form.sort.select('dtext',!this.form.dbSort)
  else
    !this.form.dbSort     = !this.form.sort.selection('dtext')
  endif

  -- Restore previous filter states
  if (!this.form.dbFilter.set()) then
    !this.form.filter.val = !this.form.dbFilter
  else
    !this.form.dbFilter   = !this.form.filter.val
  endif

  -- Load the current locations databases
  !this.dbLoad(!this.atLocGet())

  -- Set the gadget states based on target selection
  !this.target()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .initLocal()
--
-- Description: Initialise the Recover Db form (!!glbDbRec).
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initLocal()

  -- Initialise variables
  !currentLoc  = !!dbrGlbCurLocRf()

  -- Make sure current location is online
  if (!currentLoc.iconn.boolean().not()) then
    -- Cannot run for an off-line site
    !!messageFile.error(141, 602)
  endif

  -- Restore previous sort states
  if (!this.form.dbSort.set()) then
    !this.form.sort.select('dtext',!this.form.dbSort)
  else
    !this.form.dbSort     = !this.form.sort.selection('dtext')
  endif

  -- Restore previous filter states
  if (!this.form.dbFilter.set()) then
    !this.form.filter.val = !this.form.dbFilter
  else
    !this.form.dbFilter   = !this.form.filter.val
  endif

  -- Load the current locations databases
  !this.dbLoad(!!dbrGlbCurLocRf())

  -- Set the gadget states based on target selection
  !this.target()

endmethod
-- End of method definition for .initLocal()

------------------------------------------------------------------------
--
-- Method:      .locGet()
--
-- Description: Returns the stored target location, that is currently selected in
-- form !this.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Return a DBREF of the selected target location
--
------------------------------------------------------------------------

define method .locGet() is DBREF

  return !this.form.location

endmethod
-- End of method definition for .locGet() DBREF
------------------------------------------------------------------------
--
--Method: .cbAtLocn()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAtLocn()

  !this.atLocSet(!this.form.atLocn.selection(|RTEXT|).dbRef())
  !this.dbLoad(!this.atLocGet())
  !this.locList(!this.dbGet(| |),!this.atLocGet() )

endmethod
-- End of method definition for .cbAtLocn()
------------------------------------------------------------------------
--
--Method: .atLocGet()
--
-- Description: returns the location the recover is to be done from!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .atLocGet() is DBREF
  return !this.form.atLoc
endmethod
-- End of method definition for .atLocGet() DBREF
------------------------------------------------------------------------
--
--Method: .atLocSet()
--
-- Description: returns the location the recover is to be done from!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .atLocSet(!atLocn is DBREF)
  !this.form.atLoc = !atLocn
endmethod
-- End of method definition for .atLocSet(DBREF)

------------------------------------------------------------------------
--
-- Method:      .locList()
--
-- Description: maintain the location list gadget contents in the
-- Recover Db form. (!!glbRmtRec).
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database to find on-line, initialised
--                           locations for.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locList(!db is DBREF,!wrtLoc is DBREF)

  -- Initialise variables
  !locations = ARRAY()
  !locnName  = ARRAY()
  -- used in clause so as not to get the atLocn repeated, you can't force a site to recover with it's self
  if( badref(!wrtLoc) ) then
    -- set locRef to current location
    !locRef    = !!dbrGlbCurLocRf()
  else
    !locRef    = !wrtLoc
  endif

  -- Clear the current list
  !this.form.locn.clear()

  -- Collect all the on-line, initialised project locations
  !!ce       = !!dbrAdminGetWorld('LOC')
  !locn      = !!collectAllFor('LOC','ICONN eq 1 and LINIT and REF neq '& !locRef, !!ce)

  if(!this.form.userDbs)then
    -- Process the location list and see if the user database is allocated to the location.
    do !i values !locn
      !!ce       = !i
      !alloc     = !!ce.mem[1].mem
      if (!alloc.findFirst(!db).unset().not()) then
        !locations.append(!i)
        !locnName.append(!i.name.substring(2))
      endif
    enddo
  else
    -- System databases
    do !i values !locn
      !locations.append(!i)
      !locnName.append(!i.name.substring(2))
    enddo
  endif

  -- Sort the locations by name
  !order     = !locnName.sortedIndices()
  !locations.reIndex(!order)

  -- Display the locations
  !!adminLocnTxtList(!locations, !this.form.locn)

  -- Store the selected location
  !this.locSel()

endmethod
-- End of method definition for .locList(DBREF,DBREF)

------------------------------------------------------------------------
--
-- Method:      .locSel()
--
-- Description: deal with the selection of the a location to
-- recover from.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locSel()

  -- Set the selected location based upon the Recover gadget state
  if (!this.form.target.selection('rtext') eq 'SYSTEM') then
    !this.form.location  = object DBREF()
  else
    !this.form.location  = !this.form.locn.selection('rtext').dbRef()
    handle any
      !this.form.location  = object DBREF()
    endhandle
  endif

endmethod
-- End of method definition for .locSel()

------------------------------------------------------------------------
--
-- Method:      .target()
--
-- Description: control the gadget states in the Recover Database form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .target()

  -- Get the selected target
  !target    = !this.targGet()

  -- Change gadget modes based on target
  if (!target eq 'SYSTEM') then
    !this.form.locn.visible  = false
  else
    !this.form.locn.visible  = true
  endif

  -- Update the selected location
  !this.locSel()

endmethod
-- End of method definition for .target()

------------------------------------------------------------------------
--
-- Method:      .targGet()
--
-- Description: return the current target required for recovery.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Target type (SYSTEM / SELECT)
--
------------------------------------------------------------------------

define method .targGet() is STRING

  -- Get and return target
  !target  = !this.form.target.selection('rtext').upcase()
  return !target

endmethod
-- End of method definition for .targGet() STRING
------------------------------------------------------------------------
--
--Method: .getPossLocs()
--
-- Description: Get all the locations this site can recover for:-
-- i.e. all sites this site can administer + itself!!!!!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPossLocs()

  -- Set the default location to the current location (for Global 1 & Global Plus)
  !this.form.atLoc = !!dbrGlbCurLocRf()

  -- initialise Location Gadget
  !this.form.atLocn.clear()
  !matchingLocs = ARRAY()

  if(!!admControl.isValid('Remote Admin Only At Hub')) then
    -- Global 1 - Hub handles all remote commands
    -- Get a list of locations
    !resultingLocs = !!collectAllFor(|loc|,|ICONN eq 1 and LINIT|,!!dbrAdminGetWorld(|LOC|))
    !matchingLocs = !resultingLocs
  else
    -- Global 2 - Administering location handles remote commands
    -- Get a list of locations
    !resultingLocs = !!collectAllFor(|loc|,||,!!dbrAdminGetWorld(|LOC|))
    do !i values !resultingLocs
      -- Get only Locations that this physical Location can administer! + itself(to be opened readonly, if it can't admin itself)
      -- Only the Hub can administer the Hub this clause catches this.
      skip if((!i EQ !!dbrGlbHubLocRf()) AND (!!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf()))
      if (( !i.prmRf EQ !!dbrGlbCurLocRf() ) OR ( !i EQ !!dbrGlbCurLocRf() ) AND !i.lInit)then
        !matchingLocs.append(!i)
      elseif( (!!dbrGlbCurLocRf() EQ !!dbrGlbHubLocRf() ) AND ( !i.lInit.not() ) )then
        !matchingLocs.append(!i)
      endif
    enddo
  endif

  -- Rebuild list of Locs
  !txtNames = ARRAY()
  !textOfLocs = ARRAY()
  do !i values !matchingLocs
    if ( !!dbrGlbCurLocRf() EQ !i) then
      !textOfLocs.append(|LOCAL|)
      !txtNames.append(!i.name)
      -- To insure Local is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !txtNames.invert()
    else
      !textOfLocs.append(!i.locId)
      !txtNames.append(!i.name)
    endif
  enddo
  !this.form.atLocn.dText = !textOfLocs
  !this.form.atLocn.rText = !txtNames
  !this.atLocSet(!!dbrGlbCurLocRf())

endmethod
-- End of method definition for .getPossLocs()
