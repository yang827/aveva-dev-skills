--
--
-- Description: Object to serve local and remote update and synchronise
-- operation forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  act()                            -                   method to set the action to be performed upon APPLY for the
--  cbAll()                          -                   This method selects all db in the db gadget.
--  cbAtLocn()                       -                   Select an AT location
--  cbClear()                        -                   clears the selection!
--  cbDbSelection()                  -                   select all db Currently on-screen
--  cbSynchronise()                  -                   method to perform and PDMS Global SYNCHRONISE command based upon
--  cbUpdate()                       -                   Function to perform and PDMS Global UPDATE command based upon the
--  commonDb()                       -                   Function to maintain the list of databases that are common
--  dbList(STRING)                   ARRAY               Build a list of DBs
--  getPossLocs()                    -                   Get all the locations this site can synchronise for:-
--  getTargLocs(DBREF)               -                   gathers the potential locations this site can synchronise to!
--  glbSynchronise()                 -                   Constructor
--  initSynchronise()                -                   method to initialise the !this form.
--  initUpdate()                     -                   method to initialise the !this form.
--  list()                           -                   method to act as a callback to the Sort and Filter gadgets
--  locn()                           -                   method to maintain the list of databases that are common
--  operation(STRING)                BOOLEAN             Store operation 'UPDATE' or 'SYNCHRONISE'
--  parentForm(FORM)                 -                   Store form which this object instance serves
--  targ()                           -                   method to control form gadget states depending upon the selected
--
------------------------------------------------------------------------

define object GLBSYNCHRONISE

  -- Form served by this object instance
  member .form        is FORM
  -- Remote Location (Global Plus) - Set to local location for Global 1
  member .atLocation  is DBREF
  -- set to 'UPDATE' or 'SYNCHRONISE' to indicate which operation is active
  member .operation   is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .glbSynchronise()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .glbSynchronise()

  -- .atLocation unset indicates that no AT command is needed
  !this.atLocation = object DBREF()
  -- default to synchronise, although .operation should always be set
  !this.operation  = 'SYNCHRONISE'

endmethod
-- End of method definition for .glbSynchronise()

------------------------------------------------------------------------
--
-- Method:      .parentForm(FORM)
--
-- Description: Store form which this object instance serves
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parentForm(!form is FORM)

  !this.form = !form

endmethod
-- End of method definition for .parentForm(FORM)

------------------------------------------------------------------------
--
-- Method:      .operation(STRING)
--
-- Description: Store operation 'UPDATE' or 'SYNCHRONISE'
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True = operation OK; False = operation invalid
--
------------------------------------------------------------------------

define method .operation(!operation is STRING) is BOOLEAN

  -- set current mode of operation. Allow for operation mode to be
  -- specified as first three characters of the operation
  -- If an invalid operation is specified, the current operation is unchanged
  !return = true
  !briefOperation = !operation.trim().upcase().substring(1,3)
  if ( !briefOperation eq 'UPD') then
     !this.operation = 'UPDATE'
  elseif ( !briefOperation eq 'SYN' ) then
     !this.operation = 'SYNCHRONISE'
  else
    !return = false
  endif
  return !return

endmethod
-- End of method definition for .parentForm(FORM)

------------------------------------------------------------------------
--
-- Method:      .cbSynchronise()
--
-- Description: Perform a PDMS Global SYNCHRONISE command
-- based upon the selected databases.
-- This command only works for secondary databases.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbSynchronise()

  -- Initialise variables
  -- ALL or Selected
  !mode       = !this.form.act.selection('rtext')

  -- USER or SYSTEM
  !whichDbs   = !this.form.whichDbs.selection(|rtext|)
  !remoteLoc  = !this.form.location
  !dbToDo     = !this.form.db.selection(|RTEXT|)
  !currentLoc = !this.atLocation
  if (!dbToDo.size() eq 0 and !mode ne |ALL|) then
    --##
    !!alert.error(|Please select databases|)
    return
  endif

  --  set the target location (WITH command option)
  -- if the target is something other than the designated primary location
  if(!this.form.target.selection(|RTEXT|) eq |PRI|)then
    !targetTxt = ||
  elseif(!this.form.target.selection(|RTEXT|) eq |SEL|)then
    !targetTxt = ' WITH |' + !remoteLoc.locId +'|'
  endif

  -- if the at location is something other than the current location
  if(!currentLoc.unset() or !currentLoc eq !!dbrGlbCurLocRf())then
    !atTxt = ||
  else
    !atTxt = ' AT |' + !currentLoc.locId + '|'
  endif

  -- if all update all required or not
  if(!mode eq |ALL|)then
    !commandText = |SYNCHRONISE ALL| + !atTxt + !targetTxt
    call !!admCommand(!commandText)
    handle (1,500) (1,501)
      -- Daemon errors
      !!messageFile.error(141, 723, !!error.text.after(')').trim('L'))
    elsehandle any
      -- Non-specific error
      !!messageFile.error(141, 723, !!error.text)
    endhandle
  elseif(!mode eq |SEL|)then

    -- get list of databases
    !dbToDo = !this.dbList('synchronised')
    if( !dbToDo.empty() ) then
      return
    endif

    -- whether system DBs or not
    !commandArray = ARRAY()
    if(!whichDbs EQ |SYSTEM|)then
      -- In this clause they are locations
      do !i values !dbToDo
        if(!i EQ |GLOBAL|)then
          !text = |SYNCHRONISE GLOBAL| + !atTxt + !targetTxt
        elseif(!i EQ |LOCAL|)then
          !text = |SYNCHRONISE SYSTEM FOR LOCAL| + !atTxt + !targetTxt
        else
          !text = |SYNCHRONISE SYSTEM FOR | + !i + !atTxt + !targetTxt
        endif
        !commandArray.append(!text)
      enddo
    elseif(!whichDbs EQ |USER|)then
      -- In this clause they are db names
      do !i values !dbToDo
        !text = |SYNCHRONISE | + !i.dbRef().name.substring(3) + !atTxt + !targetTxt
        !commandArray.append(!text)
      enddo
    elseif (!whichDbs eq |DBSET| or !whichDbs eq |MDB|) then
      -- Use the synchronise db List command
      do !i values !dbToDo
        !text = |SYNCHRONISE DBLIST | + !i.dbRef().name + !targetTxt
        !commandArray.append(!text)
      enddo
    endif

    -- initialise report object
    !updateReport = object GLBACTIONREPORT()
    !updateReport.clear()
    -- Now must iterate through command executing them!
    !counter = 0
    do !j values !commandArray
      !counter = !counter + 1
      call !!admCommand(!j)
      handle (1,500) (1,501)
        -- Daemon errors
        !message = !!messageFile.messageString(141, 723, !!error.text.after(')').trim('L'))
        !!alert.error(!message)
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif

        !brief = 'SYNCHRONISATION FAILED'
      elsehandle any
        -- Non-specific error
        !message = !!messageFile.messageString(141, 723, !!error.text)
        !!alert.error(!message)
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief = 'SYNCHRONISATION FAILED'
      elsehandle none
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief   = 'SYNCHRONISATION OK    '
        !message = !db.replace('/','',1,1)
        !message = !message.replace('*','',1,1) + ' synchronisation command issued successfully'
      endhandle
      !reportRef = !db.dbRef()
      handle any
        !reportRef = !!dbrAdminGetWorld('DB')
      endhandle
      !updateReport.append(!brief, !message, !reportRef)
    enddo

    -- show the summary report
    !updateReport.display('Synchronisation Summary')
    !updateReport.clear()
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .cbUpdate()
--
-- Description: Perform a PDMS Global unscheduled UPDATE command
-- based upon the selected databases.
-- The update is an unscheduled propagation event.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbUpdate()

  -- Initialise variables
  -- ALL or Selected
  !mode       = !this.form.act.selection('rtext')

  -- USER or SYSTEM
  !whichDbs   = !this.form.whichDbs.selection(|rtext|)
  !remoteLoc  = !this.form.location
  !dbToDo     = !this.form.db.selection(|RTEXT|)

  if (!dbToDo.size() eq 0 and !mode ne |ALL|) then
    --##
    !!alert.error(|Please select databases|)
    return
  endif

  --  set the target location (WITH command option)
  !targetTxt = ' WITH |' + !remoteLoc.locId +'|'

  -- if all update all required or not
  if(!mode eq |ALL|)then
    !commandText = |UPDATE ALL| + !targetTxt
    call !!admCommand(!commandText)
    handle (1,500) (1,501)
      -- Daemon errors
      !!messageFile.error(141, 704, !!error.text.after(')').trim('L'))
      -- This is the generic message and need to be replaced
    elsehandle any
      -- Non-specific error
      !!messageFile.error(141, 704, !!error.text)
    endhandle

  elseif(!mode eq |SEL|)then

    -- get list of databases
    !dbToDo = !this.dbList('updated')
    if( !dbToDo.empty() ) then
      return
    endif

    -- whether system DBs or not
    !commandArray = ARRAY()

    if(!whichDbs EQ |SYSTEM|)then
      -- In this clause they are locations
      do !i values !dbToDo
        if(!i EQ |GLOBAL|)then
          !text = |UPDATE GLOBAL| + !targetTxt
        elseif(!i EQ |LOCAL|)then
          !text = |UPDATE SYSTEM | + !targetTxt
        else
          !text = |UPDATE SYSTEM FOR | + !i + !targetTxt
        endif
        !commandArray.append(!text)
      enddo
    elseif(!whichDbs EQ |USER|)then
      -- In this clause they are db names
      do !i values !dbToDo
        !text = |UPDATE | + !i.dbRef().name.substring(3) + !targetTxt
        !commandArray.append(!text)
      enddo
    elseif (!whichDbs eq |DBSET| or !whichDbs eq |MDB|) then
      -- Use the update db List command
      do !i values !dbToDo
        !text = |UPDATE DBLIST| + !i.dbRef().name + !targetTxt
        !commandArray.append(!text)
      enddo

    endif

    -- initialise report object
    !updateReport = object GLBACTIONREPORT()
    !updateReport.clear()
    -- Now must iterate through command executing them!
    !counter = 0
    do !j values !commandArray
      !counter = !counter + 1
      call !!admCommand(!j)
      handle (1,500) (1,501)
        -- Daemon errors
        !message = !!messageFile.messageString(141, 704, !!error.text.after(')').trim('L'))
        !!alert.error(!message)
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief = 'UPDATE FAILED'
      elsehandle any
        -- Non-specific error
        !message = !!messageFile.messageString(141, 704, !!error.text)
        !!alert.error(!message)
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief = 'UPDATE FAILED'
      elsehandle none
        if(!whichDbs EQ |USER|)then
          !db = !dbToDo[!counter].dbRef().name
        else
          !db = !dbToDo[!counter]
        endif
        !brief   = 'UPDATE OK    '
        !message = !db.replace('/','',1,1)
        !message = !message.replace('*','',1,1) + ' update command issued successfully'
      endhandle
      !reportRef = !db.dbRef()
      handle any
        !reportRef = !!dbrAdminGetWorld('DB')
      endhandle
      !updateReport.append(!brief, !message, !reportRef)
    enddo

    -- show the summary report
    !updateReport.display('Update Summary')
    !updateReport.clear()
  endif

endmethod
-- End of method definition for .cbUpdate()

------------------------------------------------------------------------
--
-- Method:      .act()
--
-- Description: Set up active gadgets for the action to be performed
-- upon APPLY for the form !this.form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .act()

  -- Initialise variables
  !action          = !this.form.act.selection('rtext')

  -- Set the form gadget states depending on action
  if (!action eq 'SEL') then

    -- Gadgets are active
    !this.form.db.visible      = true
    !this.form.all.active    = true
    !this.form.clear.active  = true
    !this.form.sort.active   = true
    !this.form.filter.active = true
    !this.form.whichDbs.active = true

  elseif (!action eq 'ALL') then

    -- Gadgets are inactive
    !this.form.db.visible      = false
    !this.form.all.active    = false
    !this.form.clear.active  = false
    !this.form.sort.active   = false
    !this.form.filter.active = false
    !this.form.whichDbs.active = FALSE
  endif

endmethod
-- End of method definition for .act()

------------------------------------------------------------------------
--
--Method: .getTargLocs()
--
-- Description: Gathers the potential locations this site can synchronise to!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTargLocs(!currentLoc is DBREF)

  -- Initialise variables
  !currentPos  = !!ce
  !locations   = ARRAY()

  -- Make sure current location is online
  if (!currentLoc.iconn.boolean().not()) then
    -- Cannot run for an off-line site
    !!messageFile.error(141, 602)
  endif

  -- Collect the project locations that can be updated with
  -- PARENT, CHILD, GROUP
  -- Get the parent of the current location.
  if (!currentLoc neq !!dbrGlbHubLocRf()) then
    if( !currentLoc.locRf.set() ) then
      !locations.append(!currentLoc.locRf)
    endif

    -- Get locations that are children of the current locations
    !!ce         = !!dbrAdminGetWorld('LOC')
    !clause      = 'LOCRF eq '+ !currentLoc.string() +' and LINIT and ICONN eq 1'
    !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))

    -- Get locations that are members of the same group
    if (!currentLoc.grpRf.set()) then
      !clause      = 'GRPRF eq '+ !currentLoc.grpRf.string() +' and LINIT and ICONN eq 1'
      !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))
    endif
  else
    -- The hub can synchronise with all locations except for itself
    !!ce         = !!dbrAdminGetWorld('LOC')
    !clause      = 'REFNO neq '+ !!dbrGlbHubLocRf().string() +' and LINIT and ICONN eq 1'
    !locations.appendArray(!!collectAllFor('LOC',!clause, !!ce))
  endif

  -- Make the locations array unique
  !locations.unique()

  -- Restore the database location
  !!ce         = !currentPos

  -- See if there are any locations to communicate with
  if (!locations.unset()) then
    !!messageFile.error(141, 601)
  endif

  -- Display the list of locations
  !!adminLocnTxtList(!locations,!this.form.locn)

endmethod
-- End of method definition for .getTargLocs(DBREF)
------------------------------------------------------------------------
--
--Method: .cbAtLocn()
--
-- Description: Select an AT location
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAtLocn()

  !this.atLocation = !this.form.atLocn.selection(|rtext|).dbRef()
  !this.getTargLocs(!this.atLocation)
  !this.targ()

endmethod
-- End of method definition for .cbAtLocn()
------------------------------------------------------------------------
--
-- Method:      .initSynchronise()
--
-- Description: Initialise the synchronisation forms.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initSynchronise()

  -- get the potential target locations
  !this.getTargLocs(!!dbrGlbCurLocRf())

  -- Restore the previous sort states
  if (!this.form.dbSort.set()) then
    !this.form.sort.select('dText',!this.form.dbSort)
  else
    !this.form.dbSort     = !this.form.sort.selection('dText')
  endif

  --  Restore previous filter state
  if (!this.form.dbFilter.set()) then
    !this.form.filter.val = !this.form.dbFilter
  else
    !this.form.dbFilter   = !this.form.filter.val
  endif
  -- Re-initialise based on the user databases
  !this.form.act.select(|rtext|,|SEL|)
  !this.form.whichDbs.select(|rtext|,|USER|)
  !this.form.whichDbs.active = TRUE
  !this.form.db.visible      = TRUE

  -- Set the Target location gadget state
  !this.targ()

endmethod
-- End of method definition for .initSynchronise()
-----------------------------------------------------------------------
--
-- Method:      .initUpdate()
--
-- Description: Initialise the update form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initUpdate()

  -- get the potential target locations
  !this.getTargLocs(!!dbrGlbCurLocRf())

  -- Set the form member for the current location
  if (!this.form.location.set()) then

    -- Attempt to select the previous update location
    !this.locn.form.select('rtext',!this.location.string())
    handle any
      -- Dummy handle
    endhandle
  endif
  !this.form.location = !this.form.locn.selection('rtext').dbRef()

  -- Restore the previous sort states
  if (!this.form.dbSort.set()) then
    !this.form.sort.select('dText',!this.form.dbSort)
  else
    !this.form.dbSort     = !this.form.sort.selection('dText')
  endif

  --  Restore previous filter state
  if (!this.form.dbFilter.set()) then
    !this.form.filter.val = !this.form.dbFilter
  else
    !this.form.dbFilter   = !this.form.filter.val
  endif

  -- Re-initialise based on the user databases
  !this.form.act.select(|rtext|,|SEL|)
  !this.form.whichDbs.select(|rtext|,|USER|)
  !this.form.whichDbs.active = TRUE
  !this.form.db.visible      = TRUE

  -- Update the list of databases depending upon the
  -- selected location
  !this.commonDb()

endmethod
-- End of method definition for .initUpdate()

------------------------------------------------------------------------
--
-- Method:      .list()
--
-- Description: Acts as a callback to the Sort and Filter gadgets
-- in !this.form. Controls the DB list gadget contents
-- based on the sort and filter gadget values.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .list()

  -- Clear the database list
  !this.form.db.clear()
  !this.form.prevSelection.clear()
  !whichDbs   = !this.form.whichDbs.selection(|rtext|)

  -- USER or SYSTEM
  if(!whichDbs EQ |USER|)then

    if (!this.form.sort.dText.size() neq 7) then
      !!admDbSortGadg(!this.form.sort)
    endif

    -- Capture the sort and filter gadget values
    !this.form.dbSort    = !this.form.sort.selection('dText')
    !this.form.dbFilter  = !this.form.filter.val

    -- Sort, filter and display the database list
    !displayList = !!adminFilterSort(!this.form.dbArray,!this.form.sort,!this.form.filter)
    !format2Use  = !!admDisplayConfig.fmtDbGet()
    !!adminDbTxtList(!displayList,!this.form.db,!format2Use,!!admDisplayConfig.eleTypeGet(), object DBREF())
    !this.form.sort.active   = TRUE
    !this.form.filter.active = TRUE

  elseif(!whichDbs EQ |DBSET|)then

    if (!this.form.sort.dText.size() neq 2) then
      !!admDbSetSortGadg(!this.form.sort)
    endif

    -- Capture the sort and filter gadget values
    !this.form.dbSort    = !this.form.sort.selection('dText')
    !this.form.dbFilter  = !this.form.filter.val

    -- Sort, filter and display the database set list
    !displayList = !!adminFilterSort(!this.form.dbArraySet,!this.form.sort,!this.form.filter)
    !format2Use  = !!admDisplayConfig.fmtDbSetGet()

    !!admDbSetTxtList(!displayList, !this.form.db,!format2Use, !!admDisplayConfig.eleTypeGet())
    !this.form.sort.active   = TRUE
    !this.form.filter.active = TRUE

  elseif(!whichDbs EQ |MDB|)then

    if (!this.form.sort.dText.size() neq 2) then
      !!admMdbSortGadg(!this.form.sort)
    endif

    -- Capture the sort and filter gadget values
    !this.form.dbSort    = !this.form.sort.selection('dText')
    !this.form.dbFilter  = !this.form.filter.val

    -- Sort, filter and display the MDB list
    !displayList = !!adminFilterSort(!this.form.mdbArray,!this.form.sort,!this.form.filter)
    !format2Use  = !!admDisplayConfig.fmtMdbGet()

    !!adminMdbTxtList(!displayList, !this.form.db,!format2Use, !!admDisplayConfig.eleTypeGet())
    !this.form.sort.active   = TRUE
    !this.form.filter.active = TRUE

  elseif(!whichDbs EQ |SYSTEM|)then
    !this.form.sort.active   = FALSE
    !this.form.filter.active = FALSE
    if( badref(!this.atLocation) ) then
      !atLoc    = !!dbrGlbCurLocRf()
    else
      !atLoc    = !this.atLocation
    endif

    -- Set the target location
    !usePrimary = !this.form.target.selection('rtext') EQ 'PRI'

    handle any
      -- handle case where the form does not have the Primary option gadget
      !usePrimary = false
    endhandle

    if (!usePrimary) then
      !targetLoc   = object DBREF()
    else
      !targetLoc   = !this.form.locn.selection('rtext').dbRef()
      !this.form.location = !targetLoc
    endif

    !tempDtext = !this.form.db.dText
    !tempRtext = !this.form.db.rText

    -- if this location doesn't administer itself then it's local system db will be secondary
    -- System DB synchronisation is only valid for Global Plus
    if((!atLoc.prmRf ne !atLoc) AND (!!dbrGlbHubLocRf() ne !atLoc) AND !!admControl.isValid('Centralised Admin') )then
      -- Now system DB can be picked from any Location
      !tempDtext.insert(1,  |-  Local System Database|)
      !tempRtext.insert(1,  |LOCAL|)
    endif

    -- if this location is not the hub, then the global db is also secondary here!
    if(!this.operation eq 'UPDATE' or !!dbrGlbHubLocRf() ne !atLoc)then
      -- if Target isn't the Hub (Global DB primary at hub by definition, then don't show Global DB)
--      if(!usePrimary OR (!targetLoc EQ !!dbrGlbHubLocRf()))then
        !tempDtext.insert(1,|-  Global System Database|)
        !tempRtext.insert(1,|GLOBAL|)
--      endif
    endif

    -- Get a list of other locations sys db's secondary here! (only Global Plus)
    if(!!admControl.isValid('Centralised Admin')) then
      -- the next line get an array of locations
      !arrayLocs = !!dbrAdminGetWorld(|LOC|).mem[2].mem
      !text = ||
      do !i values !arrayLocs
        if((!i.prmRf NEQ !atLoc) AND (!i NEQ !atLoc) AND (!i.lInit))then
          !text = |-  Local Copy of | + !i.name.substring(2) + |'s System Database|
          !tempDtext.append(!text)
          !tempRtext.append(!i.name)
        endif
      enddo
    endif

    -- DFN7494 heading not shown for system
    !heading[1] = 'Name'
    !this.form.db.setHeadings(!heading)
    !this.form.db.dText = !tempDtext
    !this.form.db.rText = !tempRtext
    if( !tempDtext.empty() ) then
      !!alert.warning('There are no system databases that can be synchronised or updated at this location')
    endif
  endif

endmethod
-- End of method definition for .list()

------------------------------------------------------------------------
--
-- Method:      .locn()
--
-- Description: Maintains the list of databases for the synchronise operation
-- that are common to the current location and the target location.
-- All databases listed will be secondary at the current location.
-- Update of list in form !this.form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locn()

  -- Initialise variables
  !prev = !!ce
  !whichDbs   = !this.form.whichDbs.selection(|rtext|)

  -- Get the location to collect secondary dbs from
  !atLoc       = !this.atLocation
  if( badref(!atLoc) ) then
    !atLoc = !!dbrGlbCurLocRf()
  endif
  !localDbs    = ARRAY()
  !remoteDbs   = ARRAY()
  -- Set the target location
  if (!this.form.target.selection('rtext') eq 'PRI') then
    !targetLoc = object DBREF()
    !prompt = 'Collecting database information from locations ' + !atLoc.locId + ' and the primary location'
  else
    !targetLoc = !this.form.locn.selection('rtext').dbRef()
    !this.form.location = !targetLoc
    !prompt = 'Collecting database information from locations ' + !atLoc.locId + ' and ' + !targetLoc.locId
  endif
  PROMPT |$!prompt|
  -- Get the local secondary databases (non-foreign)
  VAR !localDbs COLLECT ALL WITH ( type eq 'DB' and foreign eq 'LOCAL' and locRf OF DBLOC 1 ne $!atLoc and propg OF DBLOC 1 ) FOR $!atLoc

  -- Get the target locations databases (non-foreign)
  if (!targetLoc.set()) then
    VAR !remoteDbs COLLECT ALL WITH ( type eq 'DB' and foreign eq 'LOCAL' and locRf OF DBLOC 1 ne $!atLoc and propg OF DBLOC 1 ) FOR $!targetLoc
  endif
  -- Set the list of databases depending upon the
  -- Target location
  if (!targetLoc.set()) then
    -- Only use common databases
    !localDbs = !localDbs.intersect(!remoteDbs)
  else
    -- Display all the local databases
    !this.form.dbArray = !localDbs
  endif

  -- convert to array of DBREFs
  !block             = object BLOCK('!localDbs[!evalIndex].dbRef()')
  !this.form.dbArray = !localDbs.evaluate(!block)
  -- Get the database sets
  VAR !localDbSet COLLECT ALL WITH ( type eq 'DBSET') for /*DS
  -- convert to array of DBREFs
  !block                = object BLOCK('!localDbSet[!evalIndex].dbRef()')
  !this.form.dbArraySet = !localDbSet.evaluate(!block)
  -- Get the MDBS
  VAR !localMdbs COLLECT ALL WITH ( type eq 'MDB') for /*M
  -- convert to array of DBREFs
  !block                = object BLOCK('!localMdbs[!evalIndex].dbRef()')
  !this.form.mdbArray = !localMdbs.evaluate(!block)

  if (!whichDbs eq |USER|) then
    -- Update the database list contents
    !this.list()
  endif
  PROMPT DISMISS
  !!ce = !prev

endmethod
-- End of method definition for .locn()

------------------------------------------------------------------------
--
-- Method:      .commonDb()
--
-- Description: Function to maintain the list of databases that are common
-- to the current location and the update location for this form.
-- (Unscheduled updates).
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .commonDb()

  -- Initialise variables
  !localLoc    = !!dbrGlbCurLocRf()
  !remoteLoc   = !this.form.locn.selection('rtext').dbRef()
  !localDbs    = ARRAY()
  !remoteDbs   = ARRAY()
  !whichDbs   = !this.form.whichDbs.selection(|rtext|)

  -- Set the selected location
  !this.form.location = !remoteLoc
  !prompt = 'Collecting database information from locations ' + !localLoc.locId + ' and ' + !remoteLoc.locId
  PROMPT |$!prompt|

  -- Get the local databases (Non-foreign and propagated)
  VAR !localAlloc COLLECT ALL WITH ( type eq 'DB' and foreign eq 'LOCAL' and propg OF DBLOC 1 ) FOR $!localLoc

  -- Get the remote locations databases (Non-foreign and propagated)
  VAR !remoteAlloc COLLECT ALL WITH ( type eq 'DB' and foreign eq 'LOCAL' and propg OF DBLOC 1 ) FOR $!remoteLoc

  -- Update the array of common databases
  !localDbs  = !localAlloc.intersect(!remoteAlloc)

  -- convert to array of DBREFs
  !block             = object BLOCK('!localDbs[!evalIndex].dbRef()')
  !this.form.dbArray = !localDbs.evaluate(!block)

  -- Get the database sets
  VAR !localDbSet COLLECT ALL WITH ( type eq 'DBSET') for $!localLoc.name /*DS
  -- convert to array of DBREFs
  !block                = object BLOCK('!localDbSet[!evalIndex].dbRef()')
  !this.form.dbArraySet = !localDbSet.evaluate(!block)
  -- Get the MDBS
  VAR !localMdbs COLLECT ALL WITH ( type eq 'MDB') for $!localLoc.name /*M
  -- convert to array of DBREFs
  !block                = object BLOCK('!localMdbs[!evalIndex].dbRef()')
  !this.form.mdbArray = !localMdbs.evaluate(!block)
  PROMPT DISMISS
  if (!whichDbs eq |USER| or !this.form.init) then
    !this.form.init = FALSE
    !this.list()
  endif

endmethod
-- End of method definition for .commonDb()

------------------------------------------------------------------------
--
-- Method:      .targ()
--
-- Description: method to control form gadget states depending upon the selected
-- synchronisation target. The location list gadget becomes inactive
-- is the Target is "Primary Locations".
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .targ()

  -- Initialise variables
  !target   = !this.form.target.selection('rtext')
  !whichDbs = !this.form.whichDbs.selection(|rtext|)
  -- Set mode depending on target
  if (!target eq 'PRI') then

    -- Gadget becomes inactive
    !this.form.locn.visible   = false
    !this.form.location      = object DBREF()
  elseif (!target eq 'SEL') then

    -- Gadget becomes active
    !this.form.locn.visible   = true
    !this.form.location      = !this.form.locn.selection('rtext').dbRef()
  endif

  -- Update the databases list based upon location
  if(!whichDbs EQ |USER| or !whichDbs EQ |DBSET| or !whichDbs EQ |MDB|)then
    !this.locn()
  endif
  if(!whichDbs EQ |SYSTEM| or !whichDbs EQ |DBSET| or !whichDbs EQ |MDB|)then
    -- Skip the function which works out which dbs because its slow!
    !this.list()
  endif
endmethod
-- End of method definition for .targ()
------------------------------------------------------------------------
--
--Method: .getPossLocs()
--
-- Description: Get all the locations this site can synchronise for:-
-- i.e. all sites this site can administer + itself!!!!!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPossLocs()

  -- initialise Location Gadget
  !this.form.atLocn.clear()
  !matchingLocs = ARRAY()

  if(!!admControl.isValid('Remote Admin Only At Hub')) then
    -- Global 1 - Hub handles all remote commands
    -- Get a list of locations
    !resultingLocs = !!collectAllFor(|loc|,|ICONN eq 1 and LINIT|,!!dbrAdminGetWorld(|LOC|))
    !matchingLocs = !resultingLocs
  else
    -- Global 2 - Administering location handles remote commands
    -- Get a list of locations
    !resultingLocs = !!collectAllFor(|loc|,||,!!dbrAdminGetWorld(|LOC|))
    do !i values !resultingLocs
      -- Get only Locations that this physical Location can administer! + itself(to be opened readonly, if it can't admin itself)
      -- Only the Hub can administer the Hub this clause catches this.
      skip if((!i EQ !!dbrGlbHubLocRf()) AND (!!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf()))
      if (( !i.prmRf EQ !!dbrGlbCurLocRf() ) OR ( !i EQ !!dbrGlbCurLocRf() ) AND !i.lInit)then
        !matchingLocs.append(!i)
      elseif( (!!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf() ) AND ( !i.lInit.not() ) )then
        !matchingLocs.append(!i)
      endif
    enddo
  endif

  -- Rebuild list of Locs
  !txtNames = ARRAY()
  !textOfLocs = ARRAY()
  do !i values !matchingLocs
    if ( !!dbrGlbCurLocRf() EQ !i) then
      !textOfLocs.append(|LOCAL|)
      !txtNames.append(!i.name)
      -- To insure Local is always the first Value
      -- Can I prove that there will always be a Local?
      !textOfLocs.invert()
      !txtNames.invert()
    else
      !textOfLocs.append(!i.locId)
      !txtNames.append(!i.name)
    endif
  enddo
  !this.form.atLocn.dText = !textOfLocs
  !this.form.atLocn.rText = !txtNames

endmethod
-- End of method definition for .getPossLocs()
------------------------------------------------------------------------
--
--Method: .cbDbSelection()
--
-- Description: select all db Currently on-screen
-- to be reinforced in the cbApply()
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbDbSelection()

  -- Not much need for this line only kept it in for completeness!
  !this.form.prevSelection = !this.form.db.selection(|RTEXT|)
  return

endmethod
-- End of method definition for .cbDbSelection()
------------------------------------------------------------------------
--
--Method: .cbAll()
--
-- Description: This method selects all db in the db gadget.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbAll()
  -- selects all in gadget
  !this.form.db.select('rtext',!this.form.db.rText)
  -- set prev selection
  !this.form.prevSelection = !this.form.db.selection(|RTEXT|)

endmethod
-- End of method definition for .cbAll()
------------------------------------------------------------------------
--
--Method: .cbClear()
--
-- Description: clears the selection!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbClear()
  -- clear selection
  !this.form.db.clearSelection()
  -- set prev selection
  !this.form.prevSelection.clear()

endmethod
-- End of method definition for .cbClear()
------------------------------------------------------------------------
--
--Method: .dbList()
--
-- Description: Build a list of DBs
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Word describing operation (updated or synchronised)
-- Return:
--  [Data Type] [Description]
--   ARRAY       of DB refno to operate on
--
------------------------------------------------------------------------
define method .dbList(!dummyWord is STRING) is ARRAY

  !whichDbs   = !this.form.whichDbs.selection(|rtext|)
  !remoteLoc  = !this.form.location
  !dbToDo     = !this.form.db.selection(|RTEXT|)
  !currentLoc = !this.atLocation
  if (!dbToDo.size() eq 0 and !this.form.act.selection('rtext') ne |ALL|) then
    --##
    !!alert.error(|Please select databases|)
    return ARRAY()
  endif
  return !dbToDo

endmethod
-- End of method definition for .dbList()
