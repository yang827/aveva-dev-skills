-- Created:         Mon Nov 10 09:37:10 GMT 1997
--
--
-- Description:
-- Object definition to store user objects without any dbrefs or methods which require
-- the source Sys DB to be open
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  user2GlbUser(USER)               -                   To capture a glbuser from a User
--

-- Define object
define object GLBUSER
  member .access is STRING
  member .teamName is ARRAY
  -- corresponding teams description
  member .teamDesc is ARRAY
  member .name is STRING
  member .description is STRING
  member .password is STRING
endobject
-- End of object definition for GLBUSER

------------------------------------------------------------------------
--
-- Method:      .user2GlbUser()
--
-- Description: To capture a glbuser from a User
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .user2GlbUser(!user is USER)
  !this.name = !user.name
  !this.access = !user.access
  !this.description = !user.description
  -- DUN1135 : no access to user password text
  !this.password = ||
  !temp = !user.teamList()
  !this.teamName.clear()
  !this.teamDesc.clear()
    do !i values !temp
    !this.teamName.append(!i.name)
    !this.teamDesc.append(!i.description)
  enddo
endmethod
-- End of method definition for .user2GlbUser(USER)
