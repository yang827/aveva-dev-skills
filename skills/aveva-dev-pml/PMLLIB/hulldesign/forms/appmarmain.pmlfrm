--
--
-- Description:     Main form for Marine modules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appMarMain()                     -                   Constructor method
--  initialise()                     -                   takes the place of the DES\GEN\ISYSTEM macro
--  navigate()                       -                   set edg navigate depending on the navigate toggle
--
------------------------------------------------------------------------
setup form !!appMarMain at xr 0 yr 0 main VarChars

  -- icon size is now 16 because we can't change the size of icons on toolbars
  !iconSize = 16

  title     |Hull Design|
  iconTitle |Design|
  revision  | $$Revision: 1.17 $ |
  !this.quitCall = |CALLIB XEXIT|

  -- Main bar Menu
--  bar
--    add |Design|    _sysDes
--    add |Display|   _sysView
--    add |Edit|      _coreEditMenu
--    add |View|      _coreViewMenu
--    add |Query|     _sysQry
--    add |Settings|  _sysSet
--    add |Utilities| _sysUtil
--    add |Modify|    _sysMod
--    add |Delete|    _sysDel
--    add window
--    add help
--  exit

  -- define toolbar icons

  -------------------------------------------
  -- Main toolbar
  -------------------------------------------
  -- get work
  button .mtbGetWork 'Get Work' tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |GETWORK|

  -- save work
  button .mtbSaveWork 'Save Work' tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- Add CE to drawlist
  button .mtbAddCe 'Add CE to Drawlist' tooltip 'Add CE to Drawlist' pixmap width $!iconSize height $!iconSize callback |CALLG MADDELEM CE|

  -- Remove CE from drawlist
  button .mtbRemoveCe 'Remove CE from Drawlist' tooltip 'Remove CE from Drawlist' pixmap width $!iconSize height $!iconSize callback |REMOVE CE|

  -- List Creation/modification
  button .mtbCreateList 'Create/Modify Lists' tooltip 'Create/Modify Lists' pixmap width $!iconSize height $!iconSize callback |CALLIB SHOWFORM _CDCLIST|

  -- Active List/Collection
  option .list at xmax tooltip 'Active List' callback |CALLIB ILIST $$_list| width 15

  -- Delete CE
  button .mtbDeleteCe 'Delete CE' tooltip 'Delete CE' pixmap width $!iconSize height $!iconSize callback |!!deleteCE()|

$(
  ----------------------------------------------------------------------------------------------------------------------------------
  --  DO NOT ATTEMPT TO MODIFY THE NAMES OR DEFINITIONS OF ANY .core BUTTONS.  THESE ARE CONTROLLED BY PDMS DESIGN CORE.
  ----------------------------------------------------------------------------------------------------------------------------------
  ---- Graphical interaction model editor, undo & redo buttons
  --!modifyIcon     = !!pml.getPathName('editmodel' & !iconSize & '.png')
  !undoIcon     = !!pml.getPathName('activeundo' & !iconSize & '.png')
  !redoIcon     = !!pml.getPathName('activeredo' & !iconSize & '.png')
  frame .modelEditorToolbar toolbar 'Model Editor'
    --button .coreModifyButton toggle 'Model Editor' tooltip 'Model Editor'  pixmap "$!<modifyIcon>" width $!iconSize height $!iconSize
    button .coreUndoButton          'Undo'         tooltip 'Undo'          pixmap "$!<undoIcon>"   width $!iconSize height $!iconSize
    button .coreRedoButton          'Redo'         tooltip 'Redo'          pixmap "$!<redoIcon>"   width $!iconSize height $!iconSize
  exit
  !this.coreUndoButton.active = false
  !this.coreRedoButton.active = false
  --!this.coreModifyButton.val  = false
  !!appTbarCntrl.addToolbar('modelEditorToolbar')

  frame .utilitiesToolbar toolbar 'Utilities'
    -- single navigate
    button .mtbNavigate toggle 'Navigate to Element' tooltip 'Navigate to Element' pixmap width $!iconSize height $!iconSize callback |!this.navigate()|

    -- measure
    --button .mtbMeasure 'Measure' tooltip 'Measure' pixmap width $!iconSize height $!iconSize callback |!!gphViews.measure('DISTANCE')|

    -- axes on CE
    button .mtbAxes 'Display Axes on CE' tooltip 'Display Axes on CE' pixmap width $!iconSize height $!iconSize callback |!!gphViews.tag('AXES')|

    -- Auto Clasher toggle
    !autoCPix = !!pml.getPathName('autoclashoff' & !iconSize & '.png')
    button .sysCla toggle 'Auto Clash' tooltip 'Auto Clash' pixmap "$!<autoCPix>" width $!iconSize height $!iconSize callback |CALLCL XAUTO $$_sysCla|
  exit
  !!appTbarCntrl.addToolbar('utilitiesToolbar')
$)

  -- set pixmaps for above buttons
  !this.mtbGetWork.addPixmap(!!pml.getPathName('getwork' & !iconSize & '.png'))
  !this.mtbSaveWork.addPixmap(!!pml.getPathName('savework' & !iconSize & '.png'))
  !this.mtbAddCe.addPixmap(!!pml.getPathName('addce' & !iconSize & '.png'))
  !this.mtbRemoveCe.addPixmap(!!pml.getPathName('removece' & !iconSize & '.png'))
  --!this.mtbNavigate.addPixmap(!!pml.getPathName('navigate' & !iconSize & '.png'))
  --!this.mtbMeasure.addPixmap(!!pml.getPathName('measure' & !iconSize & '.png'))
  --!this.mtbAxes.addPixmap(!!pml.getPathName('axes' & !iconSize & '.png'))
  !this.mtbDeleteCe.addPixmap(!!pml.getPathName('deletece' & !iconSize & '.png'))
  !this.mtbCreateList.addPixmap(!!pml.getPathName('createlist' & !iconSize & '.png'))

  -- Positioning data
  -- Working Plane
  !wpOn  = !!pml.getPathName('workingplaneon' & !iconSize & '.png')
  !wpOff = !!pml.getPathName('workingplaneoff' & !iconSize & '.png')

  frame .edgPositioningToolbar toolbar 'Positioning Control'
    button .wp toggle 'Turn working plane on/off' tooltip 'Turn working plane on/off' pixmap unsel "$!<wpOff>" sel "$!<wpOn>" width $!iconSize height $!iconSize

    -- Pick Types  (Element, Pline, etc)
    option .pick     width  8

    -- Pick Option (position deriving mechanism)
    option .pickType width 10

    -- Explicit Positioning Form
    if(undefined(!!edgFormat)) then
      !!edgFormat = object FORMAT()
    endif
    text   .input    width 14 is REAL format !!edgFormat

    -- Explicit position pick form
    !explicitIcon         = !!pml.getPathName('xyz' & !iconSize & '.png')
    button .explicit 'Explicit Position' tooltip 'Explicit Position' pixmap "$!<explicitIcon>" width $!iconSize height $!iconSize callback |show !!edgEPosition free|
  exit
  !this.edgPositioningToolbar.active = false

  -- now load all the toolbars for the other applications
  --!!appCntrl.modifyForm()

exit

------------------------------------------------------------------------
