import 'marAPI'
handle(1000, 0)
endhandle

setup form !!pHullJoinSplitNotchCutout dialog

    title 'CombineSplitNotchAndCutout'
    paragraph .message width 40
    path down
    frame .frame1 'Automatic Combining And Splitting'
       valign centre
       button .joinNotchCutout 'CombineNotchAndCutout' call '!this.combine()'
       button .splitCutout      'SeparateNotchAndCutout' call '!this.separate()'

    exit

	button .cancel      at xmin form ymax form anchor l+b cancel
    button .ok     'OK' at xmax form ymax form-size anchor r+b ok
exit
-- it`s constructor for the form
define method .pHullJoinSplitNotchCutout()
    !this.keyboardFocus = !this.cancel
    !this.cancel.setTooltip('discard values and hide the form')
endmethod

------------------------------------------------------------------------
--
-- Method:      .separate()
--
-- Description: calls object for separating cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .separate()

    !unusedSeparateObj = object PHULLSEPARATE()

endmethod

------------------------------------------------------------------------
--
-- Method:      .combine()
--
-- Description: calls object for combining cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .combine()

    !unusedCombineObj = object PHULLCOMBINE()

endmethod
