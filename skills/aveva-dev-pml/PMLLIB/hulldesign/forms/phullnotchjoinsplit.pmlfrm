--
-- Description:
-- Form definition for joining/splitting notches functions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comb()                           -                   Combine notches function
--  sep()                            -                   Split notches function
--
------------------------------------------------------------------------

setup form !!phullnotchjoinsplit

  title 'Choose option'
  path down
  paragraph .message text 'Choose which operation you want to perform:'
  button .combine '&1 Combine' call |!this.comb()|
  vdist 0.5
  button .separate '&2 Separate' call |!this.sep()|
  vdist 1.25
  halign centre
  button .quit '&Quit' cancel

exit


--Notch combination

define method .comb()

  !!phullnotchcombine()

endmethod


-- Notch separation

define method .sep()

  !!phullnotchsplit()

endmethod
