-- Created:         Fri Jul 22 08:05:34 2011
--
--
-- Description:     Pic a point in drawing and present list of documents linked to the indicated space at point.
--                  Make sure that AM_DESAREA_DOC has been set using MarEnvUtil.
--
------------------------------------------------------------------------

define function !!HullDesignAreaDocs()
   var !evar evar MARINE
   if (!evar.upcase() eq 'YES') then
     import 'marAPI'
     handle any
     endhandle

     import 'LinksAddin'
     handle any
     endhandle

     using namespace 'aveva.marine.ui'
     using namespace 'aveva.marine.utility'
     using namespace 'aveva.marine.geometry'
     using namespace 'aveva.marine.drafting'
     using namespace 'Aveva.Pdms.LinksAddin'

     !drafting = object MARDRAFTING()

     if( !drafting.DwgCurrent()) then
        !util = object MARUTIL()
        !picker = object MARUI()
        !msg = 'Pick space in drawing'
        !uvpt = object MARPOINTPLANAR()

        !continue = TRUE
        !desarea = !util.TBEnvironmentGet( 'AM_DESAREA_DOC')
        handle any
            !!Alert.Message( 'Space arrangement for design info not defined (AM_DESAREA_DOC)')
            !continue = FALSE
        endhandle

        if (!continue) then
           !result = !picker.PointPlanarReqPML( !msg, !uvpt)
           !picker.AppWindowRefresh()

           if( !result eq !util.OkPML()) then
              !pt = object MARPOINT()
              if( !util.TraCoordShip( !uvpt, '', !pt)) then

                 if( NOT !desarea.Empty()) then
                       !cmd = object STRING()
                       !cmd = 'spmsfp(X ' + !pt.X().string() + ' Y ' + !pt.Y().string() + ' Z ' + !pt.Z().string() + ')'
                       var !space $!cmd of $!desarea
                       handle any
                          !!Alert.Message( 'No design info defined in given position')
                          !continue = FALSE
                       endhandle
                       if (!continue) then
                          $!space
                          !linksmgr = object PMLEntry()
                          !linksmgr.Show()
                       endif
                 else
                    !!Alert.Message( 'Space arrangement for design info not given (AM_DESAREA_DOC)')
                 endif
              else
                 !!Alert.Message( 'No model view was indicated')
              endif
           else
              $P Error
           endif
        endif
     else
       !!Alert.Message( 'No drawing is available')
     endif
   endif
endfunction
