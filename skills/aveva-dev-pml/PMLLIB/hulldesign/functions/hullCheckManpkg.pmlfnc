define function !!HullCheckManpkg()
--
-- Constants
--
	 !space = ' '
	 !widthPanelCol = 30
	 !widthTypeCol  = 8
	 !fileName = 'ResultCheckManpkg.txt'
--
-- Setup output file information
--
	 !project  = CURRENT PROJECT
   !projectCode = !project.code()
   !projectEvar = !projectCode & 'mar'
   var !Directory EVAR $!<projectEvar>
   !fullFilePath = !Directory + '\lst\' + !fileName
--
-- Open file in write mode
--
	 !output = object FILE( !fullFilepath)
	 !output.Open('WRITE')
--
-- Put file header
--
	 !line = 'Panel name                    Type    Manufacturing package'
	 !output.WriteRecord( !line.String() )
	 !line = '-----------------------------------------------------------'
	 !output.WriteRecord( !line.String() )
--
-- Collect all planer and curved panels, plate nest and profile nest
--
	 $p Working....
	 var !coll collect all (HPANEL CPANEL MPLNST MAPLNS MPRNST)
--
-- Loop over the collection to check if panels have storing locations in
-- manufacturing database
--
	 do !i to !coll.size()
	 	  !elem = object DBREF( !coll[$!i])
	 	  if (not !elem.BadRef()) then
	 	  	 !panelName  = !elem.Attribute( 'NAMN')
	 	  	 !typeName = !elem.Attribute( 'TYPE')
	 	  	 !attrib = !elem.Attribute( 'MPFIND')
	 	  	 if (not !attrib.BadRef()) then
	 	  	 	  !manPkgName = !attrib.Attribute( 'NAMN')
	 	  	 endif
	 	  endif
--
--    Handle error 2, 201
-- 	
	    handle (2,201)
	    	!manPkgName = 'No manufacturing package found'
	    endhandle
--	
--    Panel name column
--			
			!width = !widthPanelCol
			!width = !width - !panelName.Length()
			do !j to !width
				 !panelName = !panelName + !space
			enddo
--
--    Type name column
--			
			!width = !widthTypeCol
			!width = !width - !typeName.Length()
			do !j to !width
				 !typeName = !typeName + !space
			enddo
--
--    Wirte line to file
--
			!line = !panelName + !typeName + !manPkgName
			!output.WriteRecord( !line.String() )
	 enddo
--
-- Close file
--
	 !output.Close()
	 $p Report created in file: $!fullFilePath
endfunction
