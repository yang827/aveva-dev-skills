define function !!HullCreateQualityList()
--
-- The current element must be of type MATW
--
   !ok = TRUE
   !TypeCE = !!ce.Type
   !NameCE = !!ce.Name
   if ( !TypeCE NE 'MATW') then
      !!Alert.Error( 'The current element must be of type MATW')
      !ok = FALSE
   endif
--
-- Get file SBH_QUALITY_LIST from SB_SHIP
--
   if (!ok) then
      !project  = CURRENT PROJECT
      !projectCode = !project.code()
      !projectEvar = !projectCode & 'mar'
      var !Directory EVAR $!<projectEvar>

      !!filebrowser( !Directory, '', 'Select file', TRUE, '')
      !Input= !!filebrowser.file
      if ( NOT !Input.Unset()) then
         !Input.Open('READ')

         !Nlines = 0
         !DensityFactor = 1000000000
         !DefaultDensity = 7860/$!DensityFactor
         !DefaultPaint = ''
			   !first = TRUE
         do
            !Line = !Input.ReadRecord()
            break if (!Line.set() EQ FALSE)
            !Nlines = !Nlines + 1
            !Array = !Line.Split()
            !Nelem = !Array.Size()
--TEST
            $p $!Array[1] $!Array[2] $!Array[3]
--TEST
--
--          Check if Painting has been specified
--
            if ( !Array[1] EQ 'DEFAULT') then
               if ( !Nlines EQ 1) then
                  !DefaultDensity = REAL( !Array[3])
                  if ( !Nelem GE 4) then
                     $p $!Array[4]
                     if ( !Nelem GE 5) then
                        $p $!Array[5]
                     endif
                     !DefaultPaint = !Array[4].trim( 'R', ';').trim('LR',|'|)
                  endif
               else
                  !!Alert.Error( 'The DEFAULT statement must be placed in line 1')
                  break
               endif
            endif
--
--          Get data
--
            !Quality = !Array[1]
            !QualityCode = REAL(!Array[2])
            if ( !Array[3] EQ '*') then
               !Dens = !DefaultDensity
            else
               !Dens = REAL(!Array[3])
            endif
            !Dens = !Dens * $!DensityFactor
            if ( !Nelem EQ 4) then
               !Paint = !Array[4].trim( 'R', ';').trim('LR',|'|)
            else
               !Paint = !DefaultPaint
            endif
            !Paint = |'| + !Paint + |'|
--
--          Skip DEFAULT statement
--
            if ( !Quality NE 'DEFAULT') then
               !Quality = 'Grade' + !Quality
--
--             Print out values
--
               $p $!Quality $!QualityCode $!Dens $!Paint
--
--             Check if the solid exists
--
               !exists = TRUE
               /$!Quality
--
--             Create new solid if it does not exist
--
               handle (2,109)
--                  $!NameCE
                  if ( NOT !first) then
                     owner
                     owner
                  endif
                  new SOLI /$!Quality
                  new SOLEXT
                  !exists = FALSE
               endhandle
               if ( !exists) then
                  1
               endif
--
--             Update the solid element
--
               QuaCd $!QualityCode
               Preppr $!Paint
               if ( NOT !exists) then
                  new TDEN
                  new SDEN
               else
                  owner
                  2
                  1
               endif
               Density $!Dens
               !first = FALSE
            endif
--
         enddo
         !Input.Close()
         !!Alert.Message( 'The quality file has been successfully read')
      endif
   endif
endfunction
