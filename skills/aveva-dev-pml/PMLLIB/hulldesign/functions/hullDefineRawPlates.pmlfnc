define function !!HullDefineRawPlates()
--
-- The current element must be of type TABWLD
--
   !ok = TRUE
   !TypeCE = !!ce.Type
   !NameCE = !!ce.Name
   if ( !TypeCE NE 'TABWLD') then
      !!Alert.Error( 'The current element must be of type TABWLD')
      !ok = FALSE
   endif
--
-- Read Raw Plate Data and create RPLTAB elements in CATA,
-- one for each Quality
--
--
-- Get file from SB_SHIP
--
   !Nlines = 0
   !Ncreated = 0
   if (!ok) then
      !project  = CURRENT PROJECT
      !projectCode = !project.code()
      !projectEvar = !projectCode & 'mar'
      var !Directory EVAR $!<projectEvar>

      !!filebrowser( !Directory, '', 'Select file', TRUE, '')
      !Input= !!filebrowser.file
      if ( NOT !Input.Unset()) then
         !Input.Open('READ')

         $p Working....
         !lines = !input.ReadFile()
         do !FileIndex To !lines.Size()
            !Line = !Lines[!FileIndex]
            SKIP if (!Line.eq(''))
            !Nlines = !Nlines + 1

            $* Scan input string, eliminating spaces if they are inside a single quote
            !stringline = !line
            !line = ''
            !InQuote = false
            do !StringIndex to !stringline.length()
               !char = !stringline.SubString(!StringIndex,1)
               if !char.eq(|'|) then
                  !InQuote = !InQuote.Not()
               endif

               if !char.eq(' ') then
                  if !inQuote.Not() then
                     !line = !line & !char
                  endif
               else
                  !line = !line & !char
               endif
            enddo

            !Array = !Line.Split()
---            !Array = !Line.Split(',')
            !Nelem = !Array.Size()

--
--          Alert if size != 9
--
            if ( !Nelem NE 9) then
               !!Alert.Error( 'Please make sure that there are no blanks in e.g. the quality column. If blanks are needed, convert the file to a csv-file.')
               !ok = FALSE
               $p $!Nlines
               break
            endif
--
--          Get data
--
            !Tbname          = !Array[1]
            !RawPlateName    = !Tbname.trim('LR',|'|)
            !RawPlateLength  = REAL(!Array[2])
            !RawPlateWidth   = REAL(!Array[3])
            !RawPlateThickn  = REAL(!Array[4])
            !Quality         = !Array[5]
            !Quality         = !Quality.trim('LR',|'|)
            !Quality         = !Quality.trim()
            !RawPlateQuality = 'Grade' + !Quality
            !RawPlateCharge  = !Array[7]
            !PurchaseInfo    = !Array[9]
            !RplElement      = 'RawPlates' + !Quality
--TEST             $p $!Nlines $!RawPlateName $!RawPlateLength $!RawPlateWidth $!RawPlateThickn $!RawPlateQuality $!RawPlateCharge
--
--          Create the RPLTAB element if it does not exist
--
            !RPLexists = TRUE
            /$!RplElement
            handle (2,109)
               new RPLTAB /$!RplElement
               !RPLexists = FALSE
            endhandle
--
--          Check if quality exists
--
            !NameCE = !!ce.Name
            /$!RawPlateQuality

            handle (2,109)
               !!Alert.Error( 'The ' + !RawPlateQuality + ' does not exist')
               !ok = FALSE
               break
            endhandle

            $!NameCE
            !Nelem = !!ce.Members.Size()
            if ( !Nelem GT 0 AND !RPLexists) then
               $!Nelem
            endif
--
--          Create the RAWPLA element
--
            !RAWexists = TRUE
            /$!RawPlateName
            handle (2,109)
               new RAWPLA /$!RawPlateName
               !RAWexists = FALSE
            endhandle
            if ( NOT !RAWexists) then
               Height $!RawPlatethickn
               Length $!RawPlateLength
               Matref /$!RawPlateQuality
               Width  $!RawPlateWidth
               Charge $!RawPlateCharge
               Purch  $!PurchaseInfo
               !Ncreated = !Ncreated + 1
            else
               $p Line $!FileIndex : The raw plate $!RawPlateName already exists
            endif
--
         enddo
         !Input.Close()
      endif
      if ( !ok) then
         !!Alert.Message( 'The raw plate file has been successfully read')
         $p Number of Raw Plates read    :   $!Nlines
         $p Number of Raw Plates created :   $!Ncreated
      endif
   endif
endfunction
