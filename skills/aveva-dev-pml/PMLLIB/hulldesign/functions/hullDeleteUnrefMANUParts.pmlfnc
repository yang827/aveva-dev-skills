--
--  Description:     Remove dangling MPLATE/MPROF/MBPRO elements
--
----------------------------------------------------------------------

define function !!HullDeleteUnrefMANUParts()
--
-- Collect all MPLATE, MPROF and MBPRO elements with a bad hdbref
--
   var !HR collect all hrdref where (badref(hdbref) and ((type of own of own eq 'MPLATE') or (type of own of own eq 'MPROF') or (type of own of own eq 'MBPRO')))
   do !X TO !HR.size()
      !H = object dbref('$!HR[$!X]')
      !M = !H.owner.owner
      $P Deleting $!M.type $!M.name
      old $!M.flnm
      delete $!M.type
      handle (2,618)
         $P Failed to delete $!M.type $!M.name
      endhandle
   enddo
endfunction
