define function !!HullNewBlock(!blkName is STRING, !ownName is STRING) is DBREF
--
-- The current element must be of type MATW
--
   if (!blkName.length() LT 1) then
      !!Alert.Message('A blockname must be given!')
      return =0/0
   endif

   !dbCmd = ''
   !oName = !ownName
   if (!oName.length() GT 1) then
      if (!oName.match('/') GT 1) then
         !dbCmd = 'DB ' + !oName
      else
         if (!oName.match('/') LT 1) then
            !oName = '/' + !oName
         endif
         !bwld = object DBREF(!oName)
         if (!bwld.type EQ 'HBLWLD') then
            !!ce = !bwld
         endif
      endif
   endif

   !bName = !blkName
   if (!bName.subString(1,1) EQ '/') then
      !bName = !bName.subString(2)
   endif
   !gName = '/SB_OGDB~' + !bName
   !oName = '/SB_OGDB::' + !bName

   !bName = '/' + !bName
   !blk = object DBREF(!bName )
   handle (2,109)
     new GBLOCK $!gName $!dbCmd
     new OBJHD $!oName
     new BLOCK $!bName $!dbCmd
     new GOBELE
     PROTECTION OFF
     GOBREF $!oName
     OWN
     PROTECTION ON
     return !!ce
   endhandle

   if (!blk NE =0/0) then
      !!Alert.Message('The name ' + !bName + ' is already used!')
   endif

   !blk = object DBREF(!bName )
   return !blk

endfunction
