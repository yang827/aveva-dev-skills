define function !!HullGlobalCommunication()
  -- find current project and global status
  !project = current project
  !isGlobal = !project.isGlobal()
  if (not !isGlobal) then
     !!alert.error('This is not a global project')
     return
  else
    show !!glbModulesPing
  endif
endfunction
-- End of function definition for .HullGlobalCommunication()
