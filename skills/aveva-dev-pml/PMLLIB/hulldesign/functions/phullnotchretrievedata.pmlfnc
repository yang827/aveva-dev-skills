--
--
-- Description:
-- Function for selecting and retrieving data from any notch through data extraction
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   None
-- Return:
--   ARRAY       4-element array, where each elements are: [0] notch U coordinate, [1] notch V coordinate,
--              [2] name of the panel that the notch is on, [3] notch ID
--
------------------------------------------------------------------------

define function !!phullnotchretrievedata() is ARRAY

  using namespace 'aveva.marine.drafting'
  using namespace 'aveva.marine.dataextraction'
  using namespace 'aveva.marine.ui'
  using namespace 'aveva.marine.geometry'
  using namespace 'aveva.marine.utility'

  !mUI = object MARUI()
  !point = object MARPOINTPLANAR()
  !mDraft = object MARDRAFTING()
  !modelSubView = object MARELEMENTHANDLE()
  !modelComponent = object MARELEMENTHANDLE()
  !resultCodes = object MARUTIL()
  !mDataEx = object MARDEX()
  !result = ARRAY()

  do
    !pointResult = !mUI.pointPlanarReqPML('Select object',!point)
    if (!pointResult eq !resultCodes.quitPML()) then
      !mUI.messageNoConfirm('Script aborted!')
      return !result
    endif
    !mod = object MARMODEL()
    !mod.partType('notch')
    !mDraft.modelIdentify(!point, !mod, !modelSubView, !modelComponent)

    !id = !mod.partIDPML()
    if (!id gt 3000 and !id lt 3100) then
      break
    endif
  enddo

  !panelName = !mod.name()
  !notchId = !mod.partIDPML() - 3000
  !cmd = 'HULL.PANEL(' & '''' & '$!panelName' & '''' & ').NOTCH(' & '$!notchId' & ').CEN'
  !res = !mDataEx.extractPML(!cmd)

  if (!res eq 0) then
    !nextRes = !mDataEx.nextResultPML()
    if (!nextRes eq 6) then
      !u = !!phullroundnumber(!mDataEx.getIndexedReal(0))
      !v = !!phullroundnumber(!mDataEx.getIndexedReal(1))
    else
      !u = STRING()
      !v = STRING()
    endif
  else
    !mUI.messageNoConfirm('Extraction failed!')
  endif

  !result[0] = !u
  !result[1] = !v
  !result[2] = !panelName
  !result[3] = !id

return !result

endfunction
