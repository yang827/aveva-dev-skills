--
--
-- Description:
-- Get array of stiffener positions from reference string
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   STRING [R]  reference string
--   STRING [R] prefix in stiffener reference
-- Return:
--   ARRAY       two-dimensional array, each element [1]prefix and [2]stiffener number
--
------------------------------------------------------------------------
-- Define function
define function !!phullReferenceNumbers(!reference is STRING) is ARRAY
	-- cut spaces
	!reference2 = !reference.replace(' ','')	
	!arYNumbers = ARRAY()
	!newElem = ARRAY()	
	
	do !cutIndex
	  !referencePart = !reference2.part(!cutIndex,',')
		break if !referencePart.eq('')
		--check prefix
		!twoCharPrefix = !referencePart.substring(1,2)
		if !twoCharPrefix.eq('SL') then
		  !prefix = 'SL'
		elseif !twoCharPrefix.eq('ST') then
		  !prefix = 'ST'
		elseif !twoCharPrefix.eq('SF') then
		  !prefix = 'SF'		
		elseif !twoCharPrefix.eq('TR') then
		  !prefix = 'TR'
    else
      !oneCharPrefix = !referencePart.substring(1,1)
			if !oneCharPrefix.eq('S') then
			  !prefix = 'S'
			elseif !oneCharPrefix.eq('T') then
			  !prefix = 'T'
			elseif !oneCharPrefix.eq('L') then
			  !prefix = 'L'
      endif				
    endif   			
			
		if 	!prefix.length().eq(0) then
			-- error in syntax
			return !arYNumbers
		endif
		
		!referencePart = !referencePart.substring( !prefix.length() + 1 )
		!p = match(!referencePart,'(')
		!p2 = match(!referencePart, '-')
		if ( !p.neq(0) or !p2.gt(1) ) then
		  if !prefix.eq('L') then
		    !arY = !!phullRepetitionSplit(!referencePart, 10)
			else
			  !arY = !!phullRepetitionSplit(!referencePart, 1)
			endif
			do !fRef values !arY
			  !newElem[1] = !prefix
			  !newElem[2] = !fRef			
			  !arYNumbers.append(!newElem)
			enddo
		else
			-- plain number
			!fRef = !referencePart.real()
			handle (2,441)
				-- error in syntax
				return !arYNumbers
			endhandle				
			!newElem[1] = !prefix
			!newElem[2] = !fRef
			!arYNumbers.append(!newElem)
		endif
	enddo
	
	-- NO SORT NOW
	--VAR !unusedIndex SORT !unusedCar CIASCII !unusedColour !unusedYear NUMERIC
	--!arYNumbers.sort()	
	
	return !arYNumbers

endfunction
