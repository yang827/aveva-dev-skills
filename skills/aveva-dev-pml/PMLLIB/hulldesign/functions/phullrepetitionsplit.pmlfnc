--
--
-- Description:
-- Get array of positions from repetition string
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   STRING [R]  repetition string
--   REAL [R]    default step in repetition
-- Return:
--   ARRAY       positions
--
------------------------------------------------------------------------
-- Define function
define function !!phullRepetitionSplit(!repetition is STRING, !defaultStep is REAL) is ARRAY
	-- cut spaces
	!repetition2 = !repetition.replace(' ','')	
	!arYNumbers = ARRAY()
	
	-- TODO repetition with hyphen and negative values
	
	!index = match(!repetition,'(')
	if !index.neq(0) then
	  --repetition with brackets
		!start = !repetition.before('(')
		!fStart = !start.real()
		handle (2,441)
		  -- error in syntax
		  return !arYNumbers
		endhandle		
		!repetitionNext = !repetition.after('(')
		!step = !repetitionNext.before(')')
		if !step.length().neq(0) then
			!fStep = !step.real()
			handle (2,441)
				-- error in syntax
				return !arYNumbers
			endhandle			
		else
			!fStep = !defaultStep		
		endif
		!end = !repetitionNext.after(')')
		!fEnd = !end.real()
		handle (2,441)
			-- error in syntax
			return !arYNumbers
		endhandle	
  else
	  -- must check for negative number at start
	  !repetition2 = !repetition.substring(2)
		!firstPos = match(!repetition2,'-') + 1
		
	  !repetitionNext = !repetition.substring(!firstPos + 1)
		if !repetitionNext.length().neq(0) then
		  --repetition with hyphen
			!start = !repetition.substring(1, !firstPos - 1)
			!fStart = !start.real()
			handle (2,441)
			  -- error in syntax
			  return !arYNumbers
			endhandle
			
			-- find second hyphen
			-- must check for negative number
			if !repetitionNext.substring(1,1).eq('-') then
			  !repetitionNext2 = !repetitionNext.substring(2)
				!addAtStart = '-'
			else
			  !repetitionNext2 = !repetitionNext
				!addAtStart = ''
			endif	
			
			!end = !repetitionNext2.after('-')					
			if !end.length().neq(0) then	
			  -- a step given
	      !step = !addAtStart & !repetitionNext2.before('-')
				!fStep = !step.real()
				handle (2,441)
				  -- error in syntax
				  return !arYNumbers
				endhandle				
			else
			  -- no step
			  !end = !addAtStart & !repetitionNext2
				!fStep = !defaultStep
			endif		
			!fEnd = !end.real()
			handle (2,441)
				-- error in syntax
				return !arYNumbers
			endhandle	
		else
			-- error in syntax
			return !arYNumbers		
    endif	
  endif		
	
	do !pos from !fStart to !fEnd by !fStep
	  !arYNumbers.append(!pos)
	enddo
	
	return !arYNumbers

endfunction
