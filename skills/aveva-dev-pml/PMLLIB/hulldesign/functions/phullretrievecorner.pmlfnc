--
--
-- Description:
-- Function for retrieving corner coordinates.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   STRING      panel name
--   REAL        corner number
-- Return:
--   ARRAY       2-element array containing corner U and V coordinates
--
------------------------------------------------------------------------

define function !!phullretrievecorner(!panelName is STRING, !corner is REAL) is ARRAY

  using namespace 'aveva.marine.dataextraction'
  using namespace 'aveva.marine.ui'

  !mDataEx = object MARDEX()
  !mUI = object MARUI()
  !corners = ARRAY()

  !extractString = 'HULL.PANEL(''' & !panelName & ''').BOU(' & !corner & ').COR'
  !dataExtractResult =  !mDataEx.extractPML(!extractString)
  if !dataExtractResult.eq(0) then
    !mDataEx.nextResultPML()
    !corners[1] = !!phullroundnumber(!mDataEx.getindexedReal(0)).real()
    !corners[2] = !!phullroundnumber(!mDataEx.getindexedReal(1)).real()
  else
    !mUI.messageNoConfirm('Data extraction error!')
  endif		

  return !corners

endfunction
