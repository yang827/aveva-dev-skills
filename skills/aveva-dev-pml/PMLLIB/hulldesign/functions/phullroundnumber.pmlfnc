--
-- Description:
-- Rounding numbers function for the combine/split notches script.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   real        input number
-- Return:
--   string      rounded number
--
------------------------------------------------------------------------

define function !!phullroundnumber(!number is REAL) is STRING

  if (abs(nint(!number) - !number) lt 0.00001) then
    !num = nint(!number)
    !b = !num.string()
  else
    !dot = !number.string().match('.')
    !lgth = !number.string().substring(!dot + 4).length()
    !c = !number.string().length() - !lgth
    !b = !number.string().substring(0,!c)
  endif
  return !b

endfunction
