-- Created:         Thu Jul 10 14:14:31 GMT 2008
--
--
-- Description:
-- Find stiffener reference string in statement
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   STRING [R]  statement
-- Return:
--   ARRAY       3 strings - start of statement, stiffener reference, end of statement
--
------------------------------------------------------------------------
-- Define function
define function !!phullStiffenerReferenceFind(!statement is STRING) is ARRAY
	-- cut spaces
	!statement2 = !statement.replace(' ','')	
	-- reference prefix found
	!unusedFirstPrefix = ''
	
	--find start of ext prof reference
	!extProfRef = !statement2.after('''')

	if !extProfRef.neq('') then
	  -- get start of stiffener reference (with coma)
	  !startStiffRef = !extProfRef.after('''')
		-- check prefix
	  !ref = !startStiffRef.after(',SL')
		if !ref.eq('') then	
	    !ref = !startStiffRef.after(',ST')
		  if !ref.eq('') then	
			  !ref = !startStiffRef.after(',SF')
				if !ref.eq('') then	
				  !ref = !startStiffRef.after(',S')
					if !ref.eq('') then	
					  -- error (could be a comment), try to find shell profile
						!extProfRef = ''				
					endif
				endif
		  endif			
		endif
		-- skip coma
		!startStiffRef = !startStiffRef.substring(2)		
	endif
	if !extProfRef.eq('') then
	  -- shell profile reference
	  !startStiffRef = 'L' & !statement2.after(',L')
		if !startStiffRef.eq('') then
		  !startStiffRef = 'TR' & !statement2.after(',TR')
			if !startStiffRef.eq('TR') then
			  !startStiffRef = 'T' & !statement2.after(',T')
				if !startStiffRef.eq('T') then
				  -- error
					!ret[1] = !statement
					!ret[2] = ''
					!ret[3] = ''
				  return !ret
				endif
      endif				
		endif	
	endif
	
	-- find end of reference
	!endStiffRef = !startStiffRef
	
	if !extProfRef.eq('') then
		do
		  !posStr = match(!endStiffRef, ',L')
			if !posStr.eq(0) then
			  !posStr = match(!endStiffRef, ',TR')
			endif
			if !posStr.eq(0) then
			  !posStr = match(!endStiffRef, ',T')
			endif			
			break if !posStr.eq(0)
			!endStiffRef = !endStiffRef.substring( !posStr + 2 )
		enddo
	else
		do
		  !posStr = match(!endStiffRef, ',SL')
			if !posStr.eq(0) then
			  !posStr = match(!endStiffRef, ',ST')
			endif
			if !posStr.eq(0) then
			  !posStr = match(!endStiffRef, ',SF')
			endif			
			if !posStr.eq(0) then
			  !posStr = match(!endStiffRef, ',S')
			endif					
			break if !posStr.eq(0)
			!endStiffRef = !endStiffRef.substring( !posStr + 2 )
		enddo	
	endif
	!posStr = match(!endStiffRef, ',')
	if !posStr.eq(0) then
	  !posStr = match(!endStiffRef, ';')
	endif	
	
	!endStiffRef = !endStiffRef.substring(!posStr)
	-- remove endStiffRef
	!startStiffRef = !startStiffRef.substring( - !endStiffRef.length() - 1)
	
	!ret[1] = !statement2.substring( - ( !startStiffRef.length() + !endStiffRef.length() ) - 1 )
	!ret[2] = !startStiffRef
	!ret[3] = !endStiffRef
	return !ret	
	
endfunction
