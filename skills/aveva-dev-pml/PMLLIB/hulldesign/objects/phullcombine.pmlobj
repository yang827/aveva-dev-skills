------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  combineByTagCodeOne()            -
--  combineByTagCodeThree()          -
--  combineByTagCodeTwo()            -
--  combineByTagCodeZero()           -
--  combineForShellStiffLong()       -                   method assigns procedures for tag code 30
--  combineForShellStiffTr()         -
--  createNewCutoutsStatForShellStiff(STRING) ARRAY
--  createNewCutoutsStatForShellStiffT(STRING) ARRAY
--  createNewCutoutsStatementsTag(STRING,STRING) ARRAY               method creates new cutout statements for  cutout tag codes 2, 3, 4
--  createNewCutoutsStatementsTagCodeOne(STRING) ARRAY
--  createNewCutoutsStatementsTagCodeZero(STRING) ARRAY
--  getFlangeDir(ARRAY,ARRAY)        -
--  getOffsetBetweenCutoutAndScallopForTagCodeOne() -
--  getOffsetBetweenCutoutAndScallopForTagCodeThreeCombine() -
--  getOffsetBetweenCutoutAndScallopForTagCodeZero() -
--  getOffsetBetweenShellStiffAndNotch() -
--  getPanelOrRsoName()              -
--  getShellStifData(ARRAY,ARRAY)    -
--  getStifData(ARRAY,ARRAY)         -
--  getStiffenersNumbers()           -
--  main()                           -
--  notchCoordinatesXYZ()            -
--  phullcombine()                   -
--  removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeOne() -
--  removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeZero() -
--  removeNotchAndCutoutStatementAndRunNewCutoutsStatements() -
--  removeNotchAndCutoutStatementAndRunNewCutoutsStatementsTagTwo() -
--  removeNotchAndCutoutStatementsAndRunNewCutShellStiffStat() -                   method removes cutout statement and notch statement
--  removeNotchAndCutoutStatementsAndRunNewCutShellStiffStatT() -                   method removes cutout statement and notch statement
--  searchFreeNamingStrings(STRING)  BOOLEAN             method retrieves free naming strings
--  selectCombineMethodByTagNr()     -
--  whichNotch()                     -
--

-- To run script properly from menu should be selected PlanarHull->Panel->Recreate after each operation!

--Script supports cutouts created for profile types: 10, 120, 30, 31, 35, 36, 40, 43, 50
--For above profiles newly created cutout has type 'AB'.
--It supports also bulb bars profiles: 20, 21, 22 , 23, for which newly created cutout has type 'BB'.

define object PHULLCOMBINE
    member .partType is STRING
    member .cutOutPanelName is STRING
    member .notchPanelName is STRING
    member .notchPartId is REAL
    member .cutoutPartId is REAL
    member .cutoutTagCode is REAL
    member .removedCutoutRefNr is REAL
    member .side is STRING
    member .typeOfChosenCutOut is STRING
    member .cutoutGroupNr is REAL
    member .panelOrRsoName is STRING
    member .offset is REAL
    member .notchNr is REAL
    member .stiffenersBelongingToChosenCutoutGroup is ARRAY
    member .cutoutReflected is BOOLEAN
    member .flangeSide is BOOLEAN
    member .notchPointX is REAL
    member .notchPointY is REAL
    member .notchPointZ is REAL
    member .radOne is REAL
    member .newCutoutType is STRING
    member .notchRadius is REAL
    member .freeNaming is BOOLEAN
    member .freeNamingStrings is ARRAY
    member .profileReferencedFreeName is STRING
endobject


--constructor
define method .phullcombine()
    !this.side = ''
    !this.main()
    !this.selectCombineMethodByTagNr()
    !this.notchPointX = 0
    !this.notchPointY = 0
    !this.notchPointZ = 0
endmethod


------------------------------------------------------------------------
--
-- Method:      .main()
--
-- Description: method main() takes essential information about identified on screen objects
-- also checks whether objects are notch and notch and cutout
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .main()
   using namespace 'Aveva.Marine.Geometry'
   using namespace 'Aveva.Marine.UI'
   using namespace 'Aveva.Marine.Drafting'
   using namespace 'Aveva.Marine.Utility'
   using namespace 'Aveva.Marine.DataExtraction'
   !model = object MARMODEL()
   !point = object MARPOINTPLANAR()
   !identifiedModel = object MARDRAFTING()
   !identifyOnView = object MARUI()
   !modelSubView = object MARELEMENTHANDLE()
   !modelComponent = object MARELEMENTHANDLE()
   !messageObj = object MARUI()
   !cancelObj = object MARUTIL()
   !extractObject = object MARDEX()
   do
      do
         !result = !identifyOnView.pointPlanarReqPML('Identify Notch', !point)
         break if(!result eq !cancelObj.quitPML())
         !identifiedModel.modelIdentify(!point, !model, !modelSubView, !modelComponent)
         !this.partType = !model.partType()
         !conditionStr = 'notch'
         if ( !conditionStr ne !this.partType ) then
            !messageObj.messageNoConfirm('Notch not identified, try again!')
         endif
         if(!conditionStr eq !this.partType) then
             !this.notchPanelName = !model.name()
             !this.notchPartId = !model.partIdPML()
             !messageObj.messageNoConfirm('Notch identified, identify Cutout!')
             break
         endif
         break if(!result eq !cancelObj.quitPML())
      enddo
      do
         !result = !identifyOnView.pointPlanarReqPML('Identify Cutout!', !point)
         !identifiedModel.modelIdentify(!point, !model, !modelSubView, !modelComponent)
         !this.partType = !model.partType()
         !conditionStr = 'cutout'
         if ( !conditionStr ne !this.partType ) then
             !messageObj.messageNoConfirm('Cutout not identified, try again!')
         endif
         if(!conditionStr eq !this.partType) then
             !this.cutOutPanelName = !model.name()
             !this.cutoutPartId = !model.partIdPML()
             !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').CUTOUT(' & !this.cutoutPartId & ').TAG_CODE'
             !a = !extractObject.extractPML(!str)
             !extractObject.nextResultPML()
             !this.cutoutTagCode = !extractObject.getIntPML()
             !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').CUTOUT(' & !this.cutoutPartId & ').PROF_REFERENCE'
                !a = !extractObject.extractPML(!str)
             !extractObject.nextResultPML()
             !this.removedCutoutRefNr = !extractObject.getIntPML()
             break
         endif
         break if(!result eq !cancelObj.quitPML())
      enddo
      break if (!this.cutOutPanelName eq !this.notchPanelName)
      !messageObj.messageNoConfirm('Notch and Cutout must be attached on the same panel')
      !messageObj.messageNoConfirm('Locate Notch and Cutout again on the same panel!')
      !this.cutOutPanelName = ''
      !this.notchPanelName = ''
   enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      .selectCombineMethodByTagNr()
--
-- Description: method assigns appropriate joining functions depending on tag of chosen group of cutouts
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .selectCombineMethodByTagNr()

    if( (!this.cutoutTagCode eq 4) or (!this.cutoutTagCode eq 3)) then
        !this.combineByTagCodeThree()
    elseif ( !this.cutoutTagCode eq 0 ) then
        !this.combineByTagCodeZero()
    elseif( !this.cutoutTagCode eq 1 ) then
        !this.combineByTagCodeOne()
    elseif( !this.cutoutTagCode eq 2 ) then
        !this.combineByTagCodeTwo()
    elseif ( !this.cutoutTagCode eq 30 ) then
        !this.combineForShellStiffLong()
    elseif ( !this.cutoutTagCode eq 40 ) then
        !this.combineForShellStiffTr()
    endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .combineByTagCodeThree()
--
-- Description: below code concerns on combining by cutout TagCode3
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .combineByTagCodeThree()
    !this.getPanelOrRsoName()
    !this.getStiffenersNumbers()
    !this.getOffsetBetweenCutoutAndScallopForTagCodeThreeCombine()
    !this.removeNotchAndCutoutStatementAndRunNewCutoutsStatements()
endmethod

------------------------------------------------------------------------
--
-- Method:      .getPanelOrRsoName()
--
-- Description: getting panel name for which referenced stiffener was created
-- getting the cutout name, getting side of cutout
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getPanelOrRsoName()
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Design'
    !extractObject = object MARDEX()
    !panelObj = object MARHULLPAN()
    !this.cutoutGroupNr = !panelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId)
    !statement = !panelObj.stmtGet(!this.cutOutPanelName, !this.cutoutGroupNr)
    !position = match(!statement, 'SHP')
    if(!position gt 0) then
        !statementT = !panelObj.stmtGet(!this.cutOutPanelName, 3)
           !positionTwo = match(!statementT, 'SUR')
        !subStatement = !statementT.substring((!positionTwo + 5))
        !this.panelOrRsoName = !subStatement.before('''')
        !statementT = !statement
        !this.freeNaming = !this.searchFreeNamingStrings(!statementT)
    else
        !subStatement = !statement.before('''')
        !startPos = !subStatement.length()
        !subStatementT = !statement.substring((!startPos + 2))
        !subStatementTT = !subStatementT.before('''')
        !this.panelOrRsoName = !subStatementTT
        --getting the Side
        !compareStr = 'S'
        !posStr = match(!subStatement, !compareStr)
        if (!posStr gt 0) then
            !this.side = !compareStr
        endif
        !compareStrR = 'TYP'
        !pos = match( !subStatement, !compareStrR)
        if ( !pos gt 0 ) then
            !subStatement = !subStatement.substring( (!pos + 3) )
        endif
        !compareStr = 'P'
        !posStr = match(!subStatement, !compareStr)
        if ( (!posStr gt 0) ) then
            !this.side = !compareStr
        endif
        -- getting type
        !typeStr = !statement.substring(5)
        !this.typeOfChosenCutOut = !typeStr.before(',')
    endif
    !ref = 'REF'
    !a = match( !statement, !ref )
    if ( !a gt 0 ) then
        !this.cutoutReflected = TRUE
    else
        !this.cutoutReflected = FALSE
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .searchFreeNamingStrings()
--
-- Description: method retrieves free naming strings
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .searchFreeNamingStrings(!statement is STRING) is BOOLEAN
    !pos = match(!statement, 'SHP')
    !shpStrings = ARRAY()
    !positionTwo = !pos + 5
    !loop = 1
    if (!pos gt 0) then
        do
            !stringOne = !statement.substring( !positionTwo )
            !shpStrings[!loop] = !stringOne.before('''')
            !pos = match(!statement, ':')
               break if ( (!pos eq 0) or (!loop gt 100) )
            if (!pos gt 0) then
                !positionTwo = 2
                !statement = !statement.substring( !pos + 1 )
             endif
            !loop = !loop + 1
        enddo
    endif
    if ( !shpStrings.size() gt 0 ) then
        !this.freeNamingStrings = !shpStrings
           return true
    endif
    return false
endmethod

------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatementAndRunNewCutoutsStatements()
--
-- Description: method removes cutout statement and notch statement
-- method adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatementAndRunNewCutoutsStatements()
    using namespace 'Aveva.Marine.Design'
    !activatePanelObj = object MARHULLPAN()
    !panels =ARRAY()
    !panels[1] = !this.cutOutPanelName

    if (!this.cutOutPanelName eq !this.notchPanelName) then
        !activatePanelObj.panModify(!this.cutOutPanelName, 2)
        !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

        !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

        !statements = ARRAY()
        !statements = !this.createNewCutoutsStatementsTag(!this.newCutoutType, 'SL')
        !quantityOfStatements = !statements.size()

        if (!quantityOfStatements eq 1) then
            !activatePanelObj.stmtExec( 0, !statements[1])
        else
            !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
        endif
    endif
    !activatePanelObj.panRecreate(!panels)
    !answer = !!Alert.Confirm('Store panel?')
    if (!answer eq 'YES') then
        !activatePanelObj.panStore(!panels)
    endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .createNewCutoutsStatementsTag()
--
-- Description: method creates new cutout statements for  cutout tag codes 2, 3, 4
--
-- Method Type: Procedure
-- Arguments:
--   STRING [R]  cutName  it`s cutout name
-- Return:  ARRAY with statement of combined cutout and statement of cutouts
-- belonging to combined cutout group
------------------------------------------------------------------------

define method .createNewCutoutsStatementsTag(!cutName is STRING, !location is STRING) is ARRAY
       !nrOfCutoutsObjects = !this.stiffenersBelongingToChosenCutoutGroup.size()

    do !x from 1 TO !nrOfCutoutsObjects BY 1
        !this.stiffenersBelongingToChosenCutoutGroup[!x] = !this.stiffenersBelongingToChosenCutoutGroup[!x] / 10
    enddo

    !typeM = !cutName
    !pos = !location

    !combinedCutoutProfNumber = !this.removedCutoutRefNr / 10

    if (!nrOfCutoutsObjects eq 1) then
        if ( !this.flangeSide eq TRUE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & !pos & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF' & ',C=' & !this.offset & ',REF' & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & !pos & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & ',C=' & !this.offset & ';'
                endif
        elseif ( !this.flangeSide eq False ) then
            if ( !this.cutoutReflected eq TRUE ) then
                 !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & !pos & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            else
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & !pos & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif
        endif
    else
        !subst = ''
        !x = 1
        do !x from 1 TO !nrOfCutoutsObjects BY 1

            if (!this.stiffenersBelongingToChosenCutoutGroup[!x] ne !combinedCutoutProfNumber) then
                !subst =!subst & ',' & !pos & !this.stiffenersBelongingToChosenCutoutGroup[!x]
            endif
           enddo
        if ( !this.cutoutReflected eq TRUE ) then
            !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ',REF' & ';'
        else
            !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ';'
        endif

        if ( !this.flangeSide eq TRUE ) then
               if ( !this.cutoutReflected eq TRUE ) then
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & !pos &  !combinedCutoutProfNumber & ',REF' & ',C=' & !this.offset & ';'
            else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & !pos &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ';'
            endif
        elseif ( !this.flangeSide eq FALSE ) then
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & !pos &  !combinedCutoutProfNumber & ',REF' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & !pos &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif
        endif
    endif
    return !statements
endmethod

------------------------------------------------------------------------
--
-- Method:      .getOffsetBetweenCutoutAndScallopForTagCodeThreeCombine()
--
-- Description: method calculates distance between cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getOffsetBetweenCutoutAndScallopForTagCodeThreeCombine()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Geometry'
    using namespace 'Aveva.Marine.Utility'
    !extractObject = object MARDEX()
    !coordObj = object MARUTIL()
    !marHullObj = object MARHULLPAN()

    !combinedCutoutProfNumber = !this.removedCutoutRefNr / 10
    if (!this.cutoutTagCode eq 4) then
        !combinedCutoutProfNumber = !combinedCutoutProfNumber * -1
    endif

    !flangeDirXYZ = ARRAY()
    !stiffIntersectionPointXYZ = ARRAY()

    !this.whichNotch()
    !this.notchCoordinatesXYZ()


    !this.getStifData( !stiffIntersectionPointXYZ, !flangeDirXYZ )
    !this.getFlangeDir( !stiffIntersectionPointXYZ, !flangeDirXYZ )

    !dimX = !this.notchPointX - !stiffIntersectionPointXYZ[1]
    !dimY = !this.notchPointY - !stiffIntersectionPointXYZ[2]
    !dimZ = !this.notchPointZ - !stiffIntersectionPointXYZ[3]
    !offsetXX = pow(!dimX , 2)
    !offsetYY = pow(!dimY , 2)
    !offsetZZ = pow(!dimZ , 2)

    !this.offset = SQR(!offsetXX  + !offsetYY + !offsetZZ)

    !stiffParameters = ARRAY()
    !stiffParameters = !marHullObj.getPanelStiffPar(!this.cutOutPanelName, !this.cutoutTagCode, !this.removedCutoutRefNr, !this.panelOrRsoName)
    !a = !stiffParameters[1].profType()

    --below case supports angle bars only following macro script 'cutout_3201.lst
    if ( (!a eq 30) or (!a eq 31) or (!a eq 35) or (!a eq 36) or (!a eq 40) or (!a eq 43) or (!a eq 50) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParameters[1].dimOne() lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- 1.5 i think it`s distance between cutout contour and bottom of the stiffener
                -- 1.5 must be declared somewhere in macro file
                -- for standard cutout type "309" there is a gap1 defined equal 1.5
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[1].dimOne() ge 200) and (!stiffParameters[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() ge 350 and (!stiffParameters[1].dimOne() le   500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' AB'
    elseif ( (!a eq 20) or (!a eq 21) or (!a eq 22) or (!a eq 23) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParameters[1].dimOne() lt 200 ) then
                !this.radOne = 35
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- 1.5 it`s distance between cutout contour and bottom of the stiffener
                -- for standard cutout type "309" there is a gap1 defined equal 1.5
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[1].dimOne() ge 200) and (!stiffParameters[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() ge 350 and (!stiffParameters[1].dimOne() le   500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' BB'
    endif
      !this.offset = !this.offset.nint()
endmethod

------------------------------------------------------------------------
--
-- Method:      .combineByTagCodeTwo()
--
-- Description: method concerns on combining for cutout tag code 2 (cutout positions defined by frames)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------


define method .combineByTagCodeTwo()
    !this.getPanelOrRsoName()
    !this.getStiffenersNumbers()
    -- below method is the same for TagCode eq 3 and TagCode eq 2
    !this.getOffsetBetweenCutoutAndScallopForTagCodeThreeCombine()

    !this.removeNotchAndCutoutStatementAndRunNewCutoutsStatementsTagTwo()
endmethod

------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatementAndRunNewCutoutsStatementsTagTwo()
--
-- Description: method removes cutout statement and notch statement
-- method adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatementAndRunNewCutoutsStatementsTagTwo()
    using namespace 'Aveva.Marine.Design'
    !activatePanelObj = object MARHULLPAN()
    !panels =ARRAY()
    !panels[1] = !this.cutOutPanelName

    if (!this.cutOutPanelName eq !this.notchPanelName) then
        !activatePanelObj.panModify(!this.cutOutPanelName, 2)
        !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

        !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

        !statements = ARRAY()
        !statements = !this.createNewCutoutsStatementsTag(!this.newCutoutType, 'SF')
        !quantityOfStatements = !statements.size()

        if (!quantityOfStatements eq 1) then
           !activatePanelObj.stmtExec( 0, !statements[1])
        else
            !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
        endif
    endif
   !activatePanelObj.panRecreate(!panels)
   !answer = !!Alert.Confirm('Store panel?')
   if (!answer eq 'YES') then
       !activatePanelObj.panStore(!panels)
   endif
endmethod


------------------------------------------------------------------------
--
-- Method:      .getStifData()
--
-- Description: below function returns by reference:
-- intersectionPoint between bottom of the stiffener and panel
-- and the direction in which flange points
-- Method Type: Procedure
-- Arguments:
-- ARRAY [R] intersectionPoint intersectionPoint[1] - X, intersectionPoint[2] - Y,intersectionPoint[3] - Z axis
-- ARRAY [R] flangeDir vector points to material side of stiffener
-- Return:
--
------------------------------------------------------------------------

define method .getStifData(!intersectionPoint is ARRAY, !flangeDir is ARRAY)
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.Geometry'
    !matSideObject = object MARHULLPAN()
    !stiffVectors = ARRAY()
    !stiffVectors = !matSideObject.getStiffData(!this.cutOutPanelName, !this.cutoutTagCode, !this.removedCutoutRefNr, !this.panelOrRsoName, !this.cutoutReflected)
    !flangeDirR = object MARVECTOR( !stiffVectors[1].flangeDirX(), !stiffVectors[1].flangeDirY(), !stiffVectors[1].flangeDirZ() )
    !intersectionPointT = object MARPOINT( !stiffVectors[1].intersectionPointX(), !stiffVectors[1].intersectionPointY(), !stiffVectors[1].intersectionPointZ() )

    !flangeDir[1] = !flangeDirR.x()
    !flangeDir[2] = !flangeDirR.y()
    !flangeDir[3] = !flangeDirR.z()
    !intersectionPoint[1] = !intersectionPointT.x()
    !intersectionPoint[2] = !intersectionPointT.y()
    !intersectionPoint[3] = !intersectionPointT.z()
endmethod

------------------------------------------------------------------------
-- Method:      .whichNotch()
--
-- Description: function searches for noch number, of which data is to be extracted
--
-- and the direction in which flange points
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .whichNotch()
    using namespace 'Aveva.Marine.Design'
    !panelObj = object MARHULLPAN()
    !notchId = !this.notchPartId
    !x = 0
    !notchGroupNr = 0

    do
        !notchGroupNr = !panelObj.groupGet(!this.notchPanelName, !notchId)
        handle(1000, 0)
            !notchGroupNr = -1
        endhandle
        if ( !notchGroupNr gt 1) then
            !x = !x + 1
        endif
        !notchId = !notchId - 1
        break if (!notchId eq 3000)
    enddo
    !this.notchNr = !x


endmethod

------------------------------------------------------------------------
-- Method:      .combineByTagCodeZero()
--
-- Description: method assigns procedures for tag code 0
--
-- and the direction in which flange points
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .combineByTagCodeZero()

    !this.getPanelOrRsoName()
       !this.getStiffenersNumbers()
    !this.getOffsetBetweenCutoutAndScallopForTagCodeZero()

    !this.removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeZero()
endmethod

------------------------------------------------------------------------
-- Method:      .getStiffenersNumbers()
--
-- Description: Function firstly searches for quantity of cutouts belonging to one cutout statement group. To this group(it`s a statement) belongs chosen cutout.
-- Searching is done by parameter !this.cutoutPartId which is database number of cutout.
-- Subsequently function gets profile reference numbers for every cutout belonging to the chosen cutout group.
-- Cutout profile reference numbers are put into !this.stiffenersBelongingToChosenCutoutGroup[] array.
-- Profile reference numbers are used to create new cutout groups(new cutout statements) after splitting one group(one statement).
-- New statements are created in functions createNewCutoutsStatements(There are others for each cutout TagCode).
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getStiffenersNumbers()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    !panelObj = object MARHULLPAN()
    !extractObject = object MARDEX()
    !cutoutGroupNrR = !this.cutoutGroupNr
    !startCutOutId = !this.cutoutPartId
    !cutoutGroupNrR = !this.cutoutGroupNr
    !startCutOutId = !this.cutoutPartId
    do
                !startCutOutId = !startCutOutId - 1

             !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').CUTOUT(' & !startCutOutId & ').TAG_CODE'
             !cutoutGroupNrR = !panelObj.groupGet(!this.cutOutPanelName, !startCutOutId)
             handle(1000, 0)
                 !cutoutGroupNrR = -1
             endhandle

             if (!cutoutGroupNrR ne !this.cutoutGroupNr) then
                 !startCutOutId = !startCutOutId + 1
                 break
             endif
             !a = !extractObject.extractPML(!str)
             !extractObject.nextResultPML()
             !tagC = !extractObject.getReal()

    enddo

    !endCutoutId = !this.cutoutPartId
    do
        !endCutoutId = !endCutoutId + 1
        !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').CUTOUT(' & !endCutoutId & ').TAG_CODE'
        !cutoutGroupNrR = !panelObj.groupGet(!this.cutOutPanelName, !endCutoutId)
        handle(1000, 0)
            !cutoutGroupNrR = -1
        endhandle


        if (!cutoutGroupNrR ne !this.cutoutGroupNr) then
            !endCutoutId = !endCutoutId - 1
            break
        endif
        !a = !extractObject.extractPML(!str)
        !extractObject.nextResultPML()
        !tagC = !extractObject.getIntPML()

    enddo

    !quantityOfTheSameGroupCutouts = !endCutoutId - !startCutOutId + 1
    if(!quantityOfTheSameGroupCutouts gt 0) then
        do !x from 1 TO !quantityOfTheSameGroupCutouts BY 1
            !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').CUTOUT(' & !startCutOutId  & ').PROF_REFERENCE'
            !a = !extractObject.extractPML(!str)
            !extractObject.nextResultPML()
            !profRef = !extractObject.getIntPML()
            !this.stiffenersBelongingToChosenCutoutGroup[!x] = !profRef
            --!this.idOfStiffenersBelongingToChosenCutoutGroup[!x] = !startCutOutId
            if (!this.cutoutTagCode eq 4) then
                !this.stiffenersBelongingToChosenCutoutGroup[!x] = !this.stiffenersBelongingToChosenCutoutGroup[!x] * -1
               endif
            !startCutOutId = !startCutOutId + 1
        enddo
    endif
    !this.stiffenersBelongingToChosenCutoutGroup.sort()
endmethod

------------------------------------------------------------------------
--
-- Method:      .createNewCutoutsStatementsTagCodeZero()
--
-- Description: method creates new cutout statements for cutout tag code 0
--
-- Method Type: Procedure
-- Arguments:
-- STRING [R]  cutName - name of the combined cutout
-- Return:  ARRAY with statement of combined cutout and statement of cutouts
-- belonging to combined cutout group
------------------------------------------------------------------------

define method .createNewCutoutsStatementsTagCodeZero(!cutName is STRING) is ARRAY
    !nrOfCutoutsObjects = !this.stiffenersBelongingToChosenCutoutGroup.size()

    !typeM = !cutName
    !combinedCutoutProfNumber = !this.removedCutoutRefNr

    if (!nrOfCutoutsObjects eq 1) then
        if ( !this.flangeSide eq TRUE ) then
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'S' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',REF;'
            else
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'S' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ';'
            endif
        elseif ( !this.flangeSide eq FALSE ) then
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'S' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            else
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'S' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif
        endif
    else
        !subst = ''
        !x = 1
        do !x from 1 to !nrOfCutoutsObjects BY 1
            if (!this.stiffenersBelongingToChosenCutoutGroup[!x] ne !combinedCutoutProfNumber) then
                !subst =!subst & ',' & 'S' & !this.stiffenersBelongingToChosenCutoutGroup[!x]
            endif
        enddo
        if ( !this.cutoutReflected eq TRUE ) then
            !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ',REF;'
        else
            !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ';'
        endif
        if ( !this.flangeSide eq TRUE ) then
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'S' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ';'
            else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'S' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ';'
            endif
        elseif ( !this.flangeSide eq FALSE ) then
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'S' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
             else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'S' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif
        endif
    endif
    return !statements
endmethod

--------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeZero()
--
-- Description: method removes cutout statement and notch statement
-- method adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeZero()
   using namespace 'Aveva.Marine.Design'
   !activatePanelObj = object MARHULLPAN()
   !panels = ARRAY()
   !panels[1] = !this.cutOutPanelName
    if (!this.cutOutPanelName eq !this.notchPanelName) then
        !activatePanelObj.panModify(!this.cutOutPanelName, 2)

        !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

        !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

        !statements = ARRAY()
        !statements = !this.createNewCutoutsStatementsTagCodeZero(!this.newCutoutType)
        !quantityOfStatements = !statements.size()

        if (!quantityOfStatements eq 1) then
            !activatePanelObj.stmtExec( 0, !statements[1])
        else
            !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
        endif
    endif
    !activatePanelObj.panRecreate(!panels)
    !answer = !!Alert.Confirm('Store panel?')
    if (!answer eq 'YES') then
        !activatePanelObj.panStore(!panels)
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .getOffsetBetweenCutoutAndScallopForTagCodeZero()
--
-- Description: method calculates distance between cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getOffsetBetweenCutoutAndScallopForTagCodeZero()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Geometry'
    using namespace 'Aveva.Marine.Utility'
    !extractObject = object MARDEX()
    !coordObj = object MARUTIL()

    !stiffIntersectionPointXYZ = ARRAY()
    !flangeDirXYZ = ARRAY()
       !this.getStifData( !stiffIntersectionPointXYZ, !flangeDirXYZ )

    !this.whichNotch()
    !this.notchCoordinatesXYZ()

    !distX = !this.notchPointX - !stiffIntersectionPointXYZ[1]
    !distY = !this.notchPointY - !stiffIntersectionPointXYZ[2]
    !distZ = !this.notchPointZ - !stiffIntersectionPointXYZ[3]
    !offsetXX = pow(!distX , 2)
    !offsetYY = pow(!distY , 2)
    !offsetZZ = pow(!distZ , 2)

    !dist = SQR(!offsetXX  + !offsetYY + !offsetZZ)
    !this.offset = !dist
    !this.getFlangeDir( !stiffIntersectionPointXYZ, !flangeDirXYZ)

    --below getting parameters of stiffener using traditional DataExtraction
    !marHullObj = object MARHULLPAN()

    !str = 'HULL.PANEL(' & '''' & !this.panelOrRsoName & '''' & ').STIFFENER(' & !this.removedCutoutRefNr & ').PROFILE.TYPE_CODE'
    !a = !extractObject.extractPML(!str)
    !extractObject.nextResultPML()
    !profType = !extractObject.getIntPML()
    !b = !profType

    !str = 'HULL.PANEL(' & '''' & !this.panelOrRsoName & '''' & ').STIFFENER(' & !this.removedCutoutRefNr & ').PROFILE.PARAMETER'
    !a = !extractObject.extractPML(!str)
    !extractObject.nextResultPML()
    !stiffParameters = ARRAY()
    !stiffParameters = !extractObject.getBox()

    -- currently supports angle type stiffeners
    if ( (!b eq 30) or (!b eq 31) or (!b eq 35) or (!b eq 36) or (!b eq 40) or (!b eq 43) or (!b eq 50) ) then
        if ( !this.flangeSide eq FALSE ) then
            --!stiffParameters[0] is stiffener height
            if ( !stiffParameters[0] lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- it`s distance between cutout contour and bottom of the stiffener
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[0] ge 200) and (!stiffParameters[0] lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[0] ge 350 and (!stiffParameters[0] le  500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[0] gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst macro file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' AB'
    elseif ( (!b eq 20) or (!b eq 21) or (!b eq 22) or (!b eq 23) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParameters[0] lt 200 ) then
                !this.radOne = 35
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- 1.5 i think it`s distance between cutout contour and bottom of the stiffener
                -- 1.5 must be declared somewhere in macro file
                -- for standard cutout type "309" there is a gap1 defined equal 1.5
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[0] ge 200) and (!stiffParameters[0] lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[0] ge 350 and (!stiffParameters[0] le  500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[0] gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' BB'
    endif

    !this.offset = !this.offset.nint()
endmethod

------------------------------------------------------------------------
--
-- Method:      .notchCoordinatesXYZ()
--
-- Description: getting notch coordinates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .notchCoordinatesXYZ()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Geometry'
    using namespace 'Aveva.Marine.Utility'

    !extractObject = object MARDEX()
    !panelObj = object MARHULLPAN()
    !notchGroupNr = !panelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
    !statement = !panelObj.stmtGet(!this.cutOutPanelName, !notchGroupNr)
    !comp = 'SEA='
    !compP = ''''
    !a = match(!statement, !comp)
    if ( !a gt 0 ) then
        !w = match(!statement, !compP)
        !notchPanelName = !statement.substring( !w + 1 )
        !notchPanelNameM = !notchPanelName.before('''')
        !new = !statement.substring((!a + 4))
        !nr = (!new.before(';'))
        !nrR = !nr.real()
        !seamObject = object MARHULLPAN()
        !seamRecords = ARRAY()
        !seamRecords = !seamObject.getNearbySeams(!this.cutOutPanelName)
        !nrOfSeams = !seamRecords.size()
        !p = 1
        do
           	if ( (!seamRecords[!p].seamNo() eq !nrR) and ( !seamRecords[!p].panelName() eq !notchPanelNameM ) ) then
                !planarNotchX = !seamRecords[!p].uCoord()
                !planarNotchY = !seamRecords[!p].vCoord()
                break
            endif
            break if(!p eq !nrOfSeams )
            !p= !p + 1
        enddo
    else
        !str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').NOTCH(' & !this.notchNr & ').CENTRAL_COORDINATES'
        !a = !extractObject.extractPML(!str)
        !extractObject.nextResultPML()
        !data = !extractObject.getBox()
        !planarNotchX = !data[0]
        !planarNotchY = !data[1]
    endif

       !pointPlanarNotchToTransform = object MARPOINT(!planarNotchX, !planarNotchY, 0)

    !obTransformNotchPointMatrix = object MARTRANSFORMATION()

    !loopTransformMatrixPanel = ARRAY()
    !strMat = 'HULL.PANEL(' & '''' & !this.notchPanelName & '''' & ').TRANSFORMATION_MATRIX'
    !a = !extractObject.extractPML(!strMat)
       do !loop from 0 to 15 BY 1
        !extractObject.nextResultPML()
           !loopTransformMatrixPanel[!loop] = !extractObject.getIndexedreal(!loop)
    enddo

    !obTransformNotchPointMatrix.setByRowFromArray(0, !loopTransformMatrixPanel)
    !pointPlanarNotchToTransform.transform(!obTransformNotchPointMatrix)

    !this.notchPointX = !pointPlanarNotchToTransform.x()
    !this.notchPointY = !pointPlanarNotchToTransform.y()
    !this.notchPointZ = !pointPlanarNotchToTransform.z()
	
	!str = 'HULL.PANEL(' & '''' & !this.cutOutPanelName & '''' & ').NOTCH(' & !this.notchNr & ').PARAMETER'
    !a = !extractObject.extractPML(!str)
    !extractObject.nextResultPML()
    !data = !extractObject.getBox()
    !this.notchRadius = !data[0]

endmethod

------------------------------------------------------------------------
--
-- Method:      .getFlangeDir()
--
-- Description: below method decides on which side of Cutout notch is located
--
-- Method Type: Procedure
-- Arguments:
-- ARRAY [R]  !stiffInterPointXYZ - intersection point between stiffener and panel
-- ARRAY [R]  !flangeDir - vector towards material side of stiffener
-- Return:
--
------------------------------------------------------------------------

define method .getFlangeDir( !stiffInterPointXYZ is ARRAY, !flangeDir is ARRAY )
    !sIP = ARRAY()
    !sIP[1] = !stiffInterPointXYZ[1]
    !sIP[2] = !stiffInterPointXYZ[2]
    !sIP[3] = !stiffInterPointXYZ[3]

    !sIP[1] = !sIP[1] + !flangeDir[1]
    !sIP[2] = !sIP[2] + !flangeDir[2]
    !sIP[3] = !sIP[3] + !flangeDir[3]
    !distOneX = !stiffInterPointXYZ[1] - !this.notchPointX
    !distOneY = !stiffInterPointXYZ[2] - !this.notchPointY
    !distOneZ = !stiffInterPointXYZ[3] - !this.notchPointZ
    !distanceOne = sqr( pow( !distOneX, 2) + pow( !distOneY, 2) + pow( !distOneZ, 2) )

    !distTwoX = !sIP[1] - !this.notchPointX
    !distTwoY = !sIP[2] - !this.notchPointY
    !distTwoZ = !sIP[3] - !this.notchPointZ
    !distanceTwo = SQR( pow( !distTwoX, 2) + pow( !distTwoY, 2) + pow( !distTwoZ, 2) )

    if ( !distanceTwo lt !distanceOne ) then
        !this.flangeSide = TRUE
    else
        !this.flangeSide = FALSE
    endif
    -- !this.flangeSide = TRUE means that notch lies on the material side of stiffener for which cutout was created
endmethod

------------------------------------------------------------------------
-- Method:      .combineByTagCodeOne()
--
-- Description: method assigns procedures for tag code 1
--
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .combineByTagCodeOne()
    !this.getPanelOrRsoName()
    !this.getStiffenersNumbers()
    -- member !this.stiffenersBelongingToChosenCutoutGroup[ARRAY] are numbered from 1 not from 0!
    -- so element !this.stiffenersBelongingToChosenCutoutGroup[0] doesn`t exist
    !this.getOffsetBetweenCutoutAndScallopForTagCodeOne()
    !this.removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeOne()
endmethod

------------------------------------------------------------------------
--
-- Method:      .getOffsetBetweenCutoutAndScallopForTagCodeOne()
--
-- Description: method calculates distance between cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getOffsetBetweenCutoutAndScallopForTagCodeOne()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Geometry'
    using namespace 'Aveva.Marine.Utility'
    !extractObject = object MARDEX()
    !coordObj = object MARUTIL()
    !marHullObj = object MARHULLPAN()


    !stiffIntersectionPointXYZ = ARRAY()
    !flangeDirXYZ = ARRAY()
       -- getting intersection point between bottom mould side of stiffener and panel
    -- also gets vector (X,Y,Z) directed along flange of stiffener (for flat bars vector is also defined)
    !this.getStifData( !stiffIntersectionPointXYZ, !flangeDirXYZ )
    -- getting parameters of notch
    !this.whichNotch()
    !this.notchCoordinatesXYZ()


    !dimX = !this.notchPointX - !stiffIntersectionPointXYZ[1]
    !dimY = !this.notchPointY - !stiffIntersectionPointXYZ[2]
    !dimZ = !this.notchPointZ - !stiffIntersectionPointXYZ[3]
    !offsetXX = pow(!dimX , 2)
    !offsetYY = pow(!dimY , 2)
    !offsetZZ = pow(!dimZ , 2)
    !this.offset = SQR(!offsetXX  + !offsetYY + !offsetZZ)
    -- specifies what side of cutout notch is
    !this.getFlangeDir( !stiffIntersectionPointXYZ, !flangeDirXYZ)
    --getting parameters of stiffener: height, flange length etc.
    !stiffParameters = ARRAY()

    !stiffParameters = !marHullObj.getPanelStiffPar(!this.cutOutPanelName, !this.cutoutTagCode, !this.removedCutoutRefNr, !this.panelOrRsoName)
    !a = !stiffParameters[1].profType()


    -- in fact !this.radOne is used only if height is less then 200
    --below case supports angle bars and bulb bars following macro script 'cutout_3201.lst,
    --it supports cutout type AB, which is for angle bars
    --cutout type AB or BB is type of newly created cutout, they have possibility to extend it on mould side using negative "C" parameter
    -- and it`s possible to extend them on non-mould side using positive "C" parameter
    --cutout type " AB" and " B"B is chosen dependent to the profile number which is return as !stiffParameters[1].profType()

    if ( (!a eq 30) or (!a eq 31) or (!a eq 35) or (!a eq 36) or (!a eq 40) or (!a eq 43) or (!a eq 50) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParameters[1].dimOne() lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- it`s distance between cutout contour and bottom of the stiffener
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[1].dimOne() ge 200) and (!stiffParameters[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() ge 350 and (!stiffParameters[1].dimOne() le  500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' AB'
    elseif ( (!a eq 21) or (!a eq 21) or (!a eq 22) or (!a eq 23) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParameters[1].dimOne() lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- 1.5 i think it`s distance between cutout contour and bottom of the stiffener
                -- 1.5 must be declared somewhere in macro file
                -- for standard cutout type "309" there is a gap1 defined equal 1.5
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParameters[1].dimOne() ge 200) and (!stiffParameters[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() ge 350 and (!stiffParameters[1].dimOne() le  500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParameters[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
		
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' BB'
    endif

    !this.offset = !this.offset.nint()
endmethod

--------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeOne()
--
-- Description: method removes cutout statement and notch statement
-- method adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatAndRunNewCutoutsStatTagCodeOne()
   using namespace 'Aveva.Marine.Design'
   !activatePanelObj = object MARHULLPAN()
   !panels = ARRAY()
   !panels[1] = !this.cutOutPanelName
   if (!this.cutOutPanelName eq !this.notchPanelName) then
       !activatePanelObj.panModify(!this.cutOutPanelName, 2)
       !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
       !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

       !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
       !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

       !statements = ARRAY()
       !statements = !this.createNewCutoutsStatementsTagCodeOne(!this.newCutoutType)
       !quantityOfStatements = !statements.size()

       if (!quantityOfStatements eq 1) then
            !activatePanelObj.stmtExec( 0, !statements[1])
       else
            !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
       endif
   endif
   !activatePanelObj.panRecreate(!panels)
   !answer = !!Alert.Confirm('Store panel?')
    if (!answer eq 'YES') then
        !activatePanelObj.panStore(!panels)
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .createNewCutoutsStatementsTagCodeOne()
--
-- Description: method creates new cutout statements for cutout tag code 1
--
-- Method Type: Procedure
-- Arguments:
-- STRING [R]  cutName - name of the combined cutout
-- Return:  ARRAY with statement of combined cutout and statement of cutouts
-- belonging to combined cutout group
------------------------------------------------------------------------

define method .createNewCutoutsStatementsTagCodeOne(!cutName is STRING) is ARRAY
    !nrOfCutoutsObjects = !this.stiffenersBelongingToChosenCutoutGroup.size()

    !typeM = !cutName

    !combinedCutoutProfNumber = !this.removedCutoutRefNr

    if (!nrOfCutoutsObjects eq 1) then
        if ( !this.flangeSide eq TRUE ) then
		    if ( !this.cutoutReflected eq TRUE ) then		
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'ST' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ';'
			else
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'ST' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ';'
            endif  			
        elseif ( !this.flangeSide eq FALSE ) then
		    if ( !this.cutoutReflected eq TRUE ) then		
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'ST' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
			else
                !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'ST' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif 			
        endif
    else
        !subst = ''
        !x = 1
        do !x from 1 to !nrOfCutoutsObjects BY 1
            if (!this.stiffenersBelongingToChosenCutoutGroup[!x] ne !combinedCutoutProfNumber) then
                !subst =!subst & ',' & 'ST' & !this.stiffenersBelongingToChosenCutoutGroup[!x]
            endif
        enddo
        if ( !this.cutoutReflected eq TRUE ) then
		    !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ',REF;'
		else
            !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ';'
        endif		
        if ( !this.flangeSide eq TRUE ) then
            if ( !this.cutoutReflected eq TRUE ) then
			    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'ST' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ';'
			else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'ST' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ';'
            endif			
        elseif ( !this.flangeSide eq FALSE ) then
		    if ( !this.cutoutReflected eq TRUE ) then
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'ST' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
			else
                !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'ST' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
            endif			
        endif
    endif
    return !statements
endmethod

-----------------------------------------------------------------------------------------------------------------------------------------
-- Method:      .combineForShellStiffLong()
--
-- Description: method assigns procedures for tag code 30
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .combineForShellStiffLong()
       using namespace 'Aveva.Marine.Design'
       !panelObj = object MARHULLPAN()	
       !this.getPanelOrRsoName()
	   !res = true
	   if ( !this.freeNaming ) then
           !res = !panelObj.getShellStiffFreeName( 1, !this.panelOrRsoName, !this.removedCutoutRefNr, !this.profileReferencedFreeName )
       else
           !this.getStiffenersNumbers()           	
       endif		
       !this.getOffsetBetweenShellStiffAndNotch()
       !this.removeNotchAndCutoutStatementsAndRunNewCutShellStiffStat()
endmethod

------------------------------------------------------------------------
--
-- Method:      .getOffsetBetweenShellStiffAndNotch()
--
-- Description: method calculates distance between cutout and notch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .getOffsetBetweenShellStiffAndNotch()
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.DataExtraction'
    using namespace 'Aveva.Marine.Geometry'
    using namespace 'Aveva.Marine.Utility'
    !extractObject = object MARDEX()
    !coordObj = object MARUTIL()
    !shellStiffPar = object MARHULLPAN()
    !stiffIntersectionPointXYZ = ARRAY()
    !flangeDirXYZ = ARRAY()
    !this.getShellStifData( !stiffIntersectionPointXYZ, !flangeDirXYZ )

    !this.whichNotch()
    !this.notchCoordinatesXYZ()

    !dimX = !this.notchPointX - !stiffIntersectionPointXYZ[1]
    !dimY = !this.notchPointY - !stiffIntersectionPointXYZ[2]
    !dimZ = !this.notchPointZ - !stiffIntersectionPointXYZ[3]
    !offsetXX = pow(!dimX , 2)
    !offsetYY = pow(!dimY , 2)
    !offsetZZ = pow(!dimZ , 2)
    !this.offset = SQR(!offsetXX  + !offsetYY + !offsetZZ)
    !this.getFlangeDir( !stiffIntersectionPointXYZ, !flangeDirXYZ)

    !stiffParam = !shellStiffPar.getShellStiffPar(!this.cutOutPanelName, !this.panelOrRsoName, !this.cutoutTagCode, !this.removedCutoutRefNr)

    -- !dimOne is height
    -- dimTwo is flange length

    !a = !stiffParam[1].profType()

    if ( (!a eq 30) or (!a eq 31) or (!a eq 35) or (!a eq 36) or (!a eq 40) or (!a eq 43) or (!a eq 50) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParam[1].dimOne() lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                -- 35 is declared in macro file as constant
                -- it`s distance between cutout contour and bottom of the stiffener
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParam[1].dimOne() ge 200) and (!stiffParam[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParam[1].dimOne() ge 350 and (!stiffParam[1].dimOne() le  500) ) then
                !this.radOne = 75

                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParam[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' AB'
    elseif ( (!a eq 21) or (!a eq 21) or (!a eq 22) or (!a eq 23) ) then
        if ( !this.flangeSide eq FALSE ) then
            --dimTwo is stiffener height
            if ( !stiffParam[1].dimOne() lt 200 ) then
                !this.radOne = !this.notchRadius
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
                --it`s distance between cutout contour and bottom of the stiffener
                -- for standard cutout type "309" there is a gap1 defined equal 1.5
                -- last 35 is added according to project specification it`s 35 behind the middle point of the notch
            elseif ( (!stiffParam[1].dimOne() ge 200) and (!stiffParam[1].dimOne() lt 350) ) then
                !this.radOne = 50
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParam[1].dimOne() ge 350 and (!stiffParam[1].dimOne() le  500) ) then
                !this.radOne = 75
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            elseif ( !stiffParam[1].dimOne() gt 500 ) then
                !this.radOne = 100
                !this.offset = - ( !this.offset - 1.5 - 35 + 35 )
            endif
            -- in fact operations are the same for every cutout height
        elseif ( !this.flangeSide eq TRUE ) then
            !this.offset = !this.offset - 35 + 35
            -- first "35" is subtracted according to cutout_3201.lst file
            -- second 35 is added according to documentation it`s 35 after the middle of notch
        endif
        !this.newCutoutType = ' BB'
    endif
	!this.offset = !this.offset.nint()
endmethod

------------------------------------------------------------------------
--
-- Method:      .getShellStifData()
--
-- Description: below function returns by reference:
-- intersectionPoint between bottom of the stiffener and shell
-- and the direction in which flange points
-- Method Type: Procedure
-- Arguments:
-- ARRAY [R] intersectionPoint intersectionPoint[1] - X, intersectionPoint[2] - Y,intersectionPoint[3] - Z axis
-- ARRAY [R] flangeDir vector points to material side of stiffener
-- Return:
--
------------------------------------------------------------------------

define method .getShellStifData(!intersectionPoint is ARRAY, !flangeDir is ARRAY)
    using namespace 'Aveva.Marine.Design'
    using namespace 'Aveva.Marine.Geometry'
    !shellStiffDataOb = object MARHULLPAN()
    !stiffVectors = ARRAY()
    !stiffVectors = !shellStiffDataOb.getShellStiffData(!this.cutOutPanelName, !this.panelOrRsoName, !this.cutoutTagCode, !this.removedCutoutRefNr, !this.cutoutReflected)

    !flangeDirR = object MARVECTOR( !stiffVectors[1].flangeDirX(), !stiffVectors[1].flangeDirY(), !stiffVectors[1].flangeDirZ() )
    !intersectionPointT = object MARPOINT( !stiffVectors[1].intersectionPointX(), !stiffVectors[1].intersectionPointY(), !stiffVectors[1].intersectionPointZ() )

    !flangeDir[1] = !flangeDirR.x()
    !flangeDir[2] = !flangeDirR.y()
    !flangeDir[3] = !flangeDirR.z()
    !intersectionPoint[1] = !intersectionPointT.x()
    !intersectionPoint[2] = !intersectionPointT.y()
    !intersectionPoint[3] = !intersectionPointT.z()
endmethod

--------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatementsAndRunNewCutShellStiffStat()
--
-- Description: method removes cutout statement and notch statement
-- method adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatementsAndRunNewCutShellStiffStat()
   using namespace 'Aveva.Marine.Design'
   !activatePanelObj = object MARHULLPAN()
   !panels = ARRAY()
   !panels[1] = !this.cutOutPanelName
    if (!this.cutOutPanelName eq !this.notchPanelName) then
        !activatePanelObj.panModify(!this.cutOutPanelName, 2)
        !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

        !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

        !statements = ARRAY()
        !statements = !this.createNewCutoutsStatForShellStiff('TB')
        !quantityOfStatements = !statements.size()

        if (!quantityOfStatements eq 1) then
            !activatePanelObj.stmtExec( 0, !statements[1])
        else
   	        !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
        endif
    endif
    !activatePanelObj.panRecreate(!panels)
    !answer = !!Alert.Confirm('Store panel?')
    if (!answer eq 'YES') then
        !activatePanelObj.panStore(!panels)
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .createNewCutoutsStatForShellStiff()
--
-- Description: method creates new cutout statements for cutout tag code 30
--
-- Method Type: Procedure
-- Arguments:
-- STRING [R]  cutName - name of the combined cutout
-- Return:  ARRAY with statement of combined cutout and statement of cutouts
-- belonging to combined cutout group
------------------------------------------------------------------------

define method .createNewCutoutsStatForShellStiff(!cutName is STRING) is ARRAY
    !typeM = !cutName
    if ( !this.freeNaming eq false ) then
        !nrOfCutoutsObjects = !this.stiffenersBelongingToChosenCutoutGroup.size()
        !combinedCutoutProfNumber = !this.removedCutoutRefNr
        if (!nrOfCutoutsObjects eq 1) then
	        if ( !this.flangeSide eq TRUE ) then
		        if ( !this.cutoutReflected eq TRUE ) then		
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'L' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ';'
			    else
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'L' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ';'
                endif			
		    elseif ( !this.flangeSide eq FALSE ) then	
		        if ( !this.cutoutReflected eq TRUE ) then		
		            !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'L' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else				
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'L' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';' 				
                endif				
            endif			
        else
            !subst = ''
            !x = 1
            do !x from 1 to !nrOfCutoutsObjects BY 1
                if (!this.stiffenersBelongingToChosenCutoutGroup[!x] ne !combinedCutoutProfNumber) then
                    !subst = !subst & ',' & 'L' & !this.stiffenersBelongingToChosenCutoutGroup[!x]
                endif
            enddo
		    !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ';'
            if ( !this.flangeSide eq TRUE ) then
		        if ( !this.cutoutReflected eq TRUE ) then
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'L' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ';'
			    else
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'L' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ';'
                endif			
		    elseif ( !this.flangeSide eq FALSE ) then
		        if ( !this.cutoutReflected eq TRUE ) then
		            !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'L' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
			    else
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'L' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
           	    endif		
		    endif	
        endif
    --  free naming mode:
	else
        !nrOfCutouts = !this.freeNamingStrings.size()
        if( !nrOfCutouts eq 1) then
            if ( !this.flangeSide eq TRUE ) then            	
                if ( !this.cutoutReflected eq TRUE ) then		
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',' & 'C=' & !this.offset & ';'                     				
				endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then		
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif				
            endif				
        -- group of cutouts
		elseif ( !nrOfCutouts gt 1) then
		    !subst = ''
			!x = 1
			do !x from 1 to !nrOfCutouts by 1
                if ( !this.freeNamingStrings[!x] ne !this.profileReferencedFreeName ) then
				    !subst = !subst & '''' & !this.freeNamingStrings[!x] & '''' & ':'
				endif	
			enddo
            !substLength = !subst.length()
            !substNew = !subst.substring( 0, !substLength )
            !statements[1] = 'CUT, ' & !typeM & ',SHP=' & !substNew & ';'
            if ( !this.flangeSide eq TRUE ) then            	
                if ( !this.cutoutReflected eq TRUE ) then		
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',' & 'C=' & !this.offset & ';'                     				
				endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then		
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif				
            else				
            endif			            			
		endif			
    endif	
	return !statements
endmethod

-----------------------------------------------------------------------------------------------------------------------------------------
-- Method:      .combineForShellStiffTr()
--
-- Description: method assigns procedures for tag code 40
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .combineForShellStiffTr()
    using namespace 'Aveva.Marine.Design'
    !panelObj = object MARHULLPAN()	
    !this.getPanelOrRsoName()
    !res = true 	
	if ( !this.freeNaming ) then
        !res = !panelObj.getShellStiffFreeName( 2, !this.panelOrRsoName, !this.removedCutoutRefNr, !this.profileReferencedFreeName )
    else
        !this.getStiffenersNumbers()           	
    endif	
    !this.getOffsetBetweenShellStiffAndNotch()
    !this.removeNotchAndCutoutStatementsAndRunNewCutShellStiffStatT()
endmethod

--------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      .removeNotchAndCutoutStatementsAndRunNewCutShellStiffStatT()
--
-- Description: method removes cutout statement and notch statement
-- method also adds two new cutout statements: !statements[1] and !statements[2]
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .removeNotchAndCutoutStatementsAndRunNewCutShellStiffStatT()
    using namespace 'Aveva.Marine.Design'
    !activatePanelObj = object MARHULLPAN()
    !panels = ARRAY()
    !panels[1] = !this.cutOutPanelName
    if (!this.cutOutPanelName eq !this.notchPanelName) then
        !activatePanelObj.panModify(!this.cutOutPanelName, 2)

        !notchGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.notchPartId)
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !notchGroupNr)

        !cutoutGroupNr = !activatePanelObj.groupGet(!this.cutOutPanelName, !this.cutoutPartId )
        !activatePanelObj.panGroupDelete(!this.cutOutPanelName, !cutoutGroupNr)

        !statements = ARRAY()
        !statements = !this.createNewCutoutsStatForShellStiffT('TB')
        !quantityOfStatements = !statements.size()

        if (!quantityOfStatements eq 1) then
            !activatePanelObj.stmtExec( 0, !statements[1])
        else
            !activatePanelObj.stmtExec( 0, !statements[1])
            !activatePanelObj.stmtExec( 0, !statements[2])
        endif
    endif
    !activatePanelObj.panRecreate(!panels)
	!answer = !!Alert.Confirm('Store panel?')
    if (!answer eq 'YES') then
        !activatePanelObj.panStore(!panels)
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .createNewCutoutsStatForShellStiffT()
--
-- Description: method creates new cutout statements for cutout tag code 40
--
-- Method Type: Procedure
-- Arguments:
-- STRING [R]  cutName - name of the combined cutout
-- Return:  ARRAY with statement of combined cutout and statement of cutouts
-- belonging to combined cutout group
------------------------------------------------------------------------

define method .createNewCutoutsStatForShellStiffT(!cutName is STRING) is ARRAY
    !typeM = !cutName
    if ( !this.freeNaming eq false ) then
        !nrOfCutoutsObjects = !this.stiffenersBelongingToChosenCutoutGroup.size()
        !combinedCutoutProfNumber = !this.removedCutoutRefNr
        if (!nrOfCutoutsObjects eq 1) then
            if ( !this.flangeSide eq TRUE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'T' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'T' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ';'
               endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'T' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ',' & 'T' & !this.stiffenersBelongingToChosenCutoutGroup[1] & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif
            endif
        else
            !subst = ''
            !x = 1
            do !x from 1 to !nrOfCutoutsObjects BY 1
                if (!this.stiffenersBelongingToChosenCutoutGroup[!x] ne !combinedCutoutProfNumber) then
                    !subst = !subst & ',' & 'T' & !this.stiffenersBelongingToChosenCutoutGroup[!x]
                endif
            enddo
            if ( !this.cutoutReflected eq TRUE ) then
                !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ',REF;'
            else
                !statements[1] = 'CUT, ' & !this.typeOfChosenCutOut & ',' & '''' & !this.panelOrRsoName & '''' & ' ' & !subst & ';'
            endif
            if ( !this.flangeSide eq TRUE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'T' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'T' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ';'
                endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'T' &  !combinedCutoutProfNumber & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & '''' & !this.panelOrRsoName & '''' & ', ' & 'T' &  !combinedCutoutProfNumber & ',' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif
            endif
        endif
    --  free naming mode:
    else
        !nrOfCutouts = !this.freeNamingStrings.size()
        if( !nrOfCutouts eq 1) then
            if ( !this.flangeSide eq TRUE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',' & 'C=' & !this.offset & ';'
                endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[1] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.freeNamingStrings[1] & '''' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif
            endif
        -- group of cutouts
        elseif ( !nrOfCutouts gt 1) then
            !subst = ''
            !x = 1
            do !x from 1 to !nrOfCutouts by 1
                if ( !this.freeNamingStrings[!x] ne !this.profileReferencedFreeName ) then
                    !subst = !subst & '''' & !this.freeNamingStrings[!x] & '''' & ':'
                endif
            enddo
            !substLength = !subst.length()
            !substNew = !subst.substring( 0, !substLength )
            !statements[1] = 'CUT, ' & !typeM & ',SHP=' & !substNew & ';'
            if ( !this.flangeSide eq TRUE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',REF,' & 'C=' & !this.offset & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',' & 'C=' & !this.offset & ';'
                endif
            elseif ( !this.flangeSide eq FALSE ) then
                if ( !this.cutoutReflected eq TRUE ) then
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',REF,' & 'C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                else
                    !statements[2] = 'CUT, ' & !typeM & ',' & ' SHP=' & '''' & !this.profileReferencedFreeName & '''' & ',C=' & !this.offset & ',' & 'R1=' & !this.radOne & ';'
                endif
            else
            endif
        endif
    endif
    return !statements
endmethod
