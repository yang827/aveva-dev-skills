------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  executeNotchesNearSeamsStatement() -
--  extractNrOfCorners()             REAL
--  generateNotchesAtCornerStatement() STRING
--  generateNotchesNearSeamsStatements() ARRAY
--  getAdjacentPanelSideFromGroupTwoStatement(STRING) STRING
--  getCreatedPanelSide()            -
--  phullnotch(ARRAY)                -
--  runNotchesAtCornersStatement(STRING) -
--
define object PHULLNOTCH

     member .panelNames is ARRAY
     member .nrOfCorners is REAL
     member .notchInCornersSize is STRING
     member .notchNearSurfaceSize is STRING
     member .notchNearPanelSize is STRING
     member .panelSide is STRING
     member .nrOfSeams is REAL
     member .createdPanelSide is STRING

     member .allPanelNames is ARRAY
     member .seamPanelNames is ARRAY
     member .nrOfPanels is REAL
     member .nrOfPanelsWithSeams is REAL
	 member .createdPanelSymmetry is REAL
	 member .adjacentPanelSymmetry is REAL
endobject

define method .phullnotch(!names is ARRAY)
     !this.nrOfPanels = 0
     !this.nrOfPanelsWithSeams = 0

     !this.notchInCornersSize = 'R100'
     !this.notchNearSurfaceSize = ' R75'
     !this.notchNearPanelSize = ' R50'
     !this.panelNames = !names
     !this.nrOfCorners = !this.extractNrOfCorners()
     !this.runNotchesAtCornersStatement( !this.generateNotchesAtCornerStatement() )
     !this.getCreatedPanelSide()
     !this.executeNotchesNearSeamsStatement()


endmethod

-- Method is extracting number of boundary which is equal number of corners.
-- Method uses data extraction.
define method .extractNrOfCorners() is REAL
     using namespace 'Aveva.Marine.DataExtraction'
     !getInfoObj = object MARDEX()
     !extractString = 'HULL.PANEL(' & '''' & !this.panelNames[0] & '''' & ').SYMMETRY'
	 !dataExtractedResult = !getInfoObj.extractPML(!extractString)
	 if ( !dataExtractedResult EQ 0) then
         !getInfoObj.nextResultPML()
	     !this.createdPanelSymmetry = !getInfoObj.getIntPML()
     endif		  																						
	
	
	 !extractString = 'HULL.PANEL(' & '''' & !this.panelNames[0] & '''' & ').NBOUNDARY'
     !dataExtractedResult = !getInfoObj.extractPML(!extractString)
     if ( !dataExtractedResult EQ 0) then
        !getInfoObj.nextResultPML()
        !dataExtracted = !getInfoObj.getIntPML()
        return !dataExtracted
     endif
endmethod

-- Method creates statement for generating notches at corners.
define method .generateNotchesAtCornerStatement() is STRING
    !notchesStatement = 'NOT,' & !this.notchInCornersSize & ', COR=1(1)' & $!this.nrOfCorners & ';'
    return !notchesStatement
endmethod

-- Method executes statement for notches in corners.
define method .runNotchesAtCornersStatement(!statement is STRING)
    using namespace 'Aveva.Marine.Design'
    !runObject = object MARHULLPAN()
    !runObject.stmtExec( 0, !statement)
endmethod

-- Method executes statement for notches near seams.
-- Statements are returned by function GenerateNotchesNearSeamsStatements()
define method .executeNotchesNearSeamsStatement()
    using namespace 'Aveva.Marine.Design'
     !runObject = object MARHULLPAN()
     !statements = ARRAY()
     !statements = !this.generateNotchesNearSeamsStatements()

     !x = 1
     do
         !runObject.stmtExec( 0, !statements[!x])
          --!x = !x + 1
          break if ( !x EQ !this.nrOfSeams )
          !x = !x + 1
     enddo
endmethod

-- Function generates notches statements for seams.
-- Seams are placed on adjacent surfaces or on adjacent panels.
-- Inside function method GetNearbySeams is called which returns
-- all seams on surfaces and on panels that are adjacent to newly created panel.

define method .generateNotchesNearSeamsStatements() is ARRAY
     using namespace 'Aveva.Marine.Design'
	 using namespace 'Aveva.Marine.DataExtraction'

     !getInfoObj = object MARDEX()
     !seamObject = object MARHULLPAN()
     !seamRecords = ARRAY()
     !statements = ARRAY()
     !seamRecords = !seamObject.getNearbySeams(!this.panelNames[0])
     !this.nrOfSeams = !seamRecords.size()

     !p = 1
     do
            if( !seamRecords[!p].isSurfaceSeam() eq TRUE ) then
			    !surfaceName = !seamRecords[!p].panelName()
   				!m = 1
				do
				    !extractString = 'HULL.PANEL(' & '''' & !this.panelNames[0] & '''' & ').BOUNDARY(' & !m & ').NAME'
					!dataExtractedResult = !getInfoObj.extractPML(!extractString)
                    if ( !dataExtractedResult EQ 0) then
                        !getInfoObj.nextResultPML()
                        !boundaryName = !getInfoObj.getString()
					    if ( !boundaryName eq !surfaceName ) then
						    !extractString = 'HULL.PANEL(' & '''' & !this.panelNames[0] & '''' & ').BOUNDARY(' & !m & ').REFLECT'
                            !dataExtractedResult = !getInfoObj.extractPML(!extractString)
                            if ( !dataExtractedResult eq 0) then
							    !getInfoObj.nextResultPML()
                                !ref = !getInfoObj.getIntPML()
								if ( !ref eq 0 ) then
								    !statements[!p] = 'NOT,' & !this.notchNearSurfaceSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ';'
								else
                                	!statements[!p] = 'NOT,' & !this.notchNearSurfaceSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ', REF' & ';'
								endif
								break
							endif	
						endif	
					endif	
   					break if ( !m eq !this.nrOfCorners )
				    !m = !m + 1	
				enddo
            else
                !adjacentPanelName = !seamRecords[!p].panelName()
                  -- side on which panel adjacent to newly created panel is defined by !this.createdPanelSymmetry

                !adjacentPanelSide = !this.getAdjacentPanelSideFromGroupTwoStatement(!adjacentPanelName)
                 -- !adjacentPanelSide is defined by !this.adjacentPanelSymmetry. Intersecting Panel is one of the boundary panel defined with option "intersecting".
				 -- !adjacentPanel is one of the intersecting panels.


						if ( !this.createdPanelSymmetry eq 1 ) then
						    if ( !this.adjacentPanelSymmetry eq 1 ) then
                                !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
                            endif 							
							if ( !this.adjacentPanelSymmetry eq 11 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 0 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 10 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif	
						endif
						-- created panel 11
						if ( !this.createdPanelSymmetry eq 11 ) then
						    if ( !this.adjacentPanelSymmetry eq 1 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
                            endif 								
							if ( !this.adjacentPanelSymmetry eq 11 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 0 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 10 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif	
						endif
						-- created panel: 12
						if ( !this.createdPanelSymmetry eq 12 ) then
						    if ( !this.adjacentPanelSymmetry eq 2 ) then
                                !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif							
							if ( !this.adjacentPanelSymmetry eq 12 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif
							if ( !this.adjacentPanelSymmetry eq 0 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							endif
							if ( !this.adjacentPanelSymmetry eq 10 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif
							if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif	
							if ( !this.adjacentPanelSymmetry eq 1 ) then
                           	    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif	
						endif	
						-- created panel: 2
						if ( !this.createdPanelSymmetry eq 2 ) then
						    -- !this.adjacentPanelSymmetry eq 2 - here may be different panel on the starboard
							--if ( !this.adjacentPanelSymmetry eq 2 ) then
							    --!statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',' & 'REF' & ';'
							--endif
							-- !this.adjacentPanelSymmetry eq 12 - this case shouldn`t happen
                            if ( !this.adjacentPanelSymmetry eq 12 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif 							
							if ( !this.adjacentPanelSymmetry eq 0 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',REF' & ';'
							endif
                            if ( !this.adjacentPanelSymmetry eq 10 ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif 	
                            if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							endif	 							
						endif
							

						-- created panel: 3
						if ( !this.createdPanelSymmetry eq 3 ) then


                            if( ( !this.adjacentPanelSymmetry eq 2) or ( !this.adjacentPanelSymmetry eq 11) ) then
							    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',REF' & ';'
							else
   								!statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
                            endif
							
                        endif
						-- created panel: 0
						
						    if (  !this.createdPanelSymmetry eq 0 ) then
                                    if ( ( !this.adjacentPanelSymmetry eq 10 ) or ( !this.adjacentPanelSymmetry eq 10 ) ) then
								        !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
								    endif	
									if ( !this.adjacentPanelSymmetry eq 1) then
									    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & ' P,' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
									elseif ( !this.adjacentPanelSymmetry eq 11 ) then	
									    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & ' P,' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',REF' & ';'
									endif	
									if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	            !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							        endif	 	
                            endif							
							if (  !this.createdPanelSymmetry eq 10 ) then
							        if ( ( !this.adjacentPanelSymmetry eq 0 ) or ( !this.adjacentPanelSymmetry eq 10 ) ) then
								        !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'
								    endif
								    if ( !this.adjacentPanelSymmetry eq 2) then
									    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & ' S,' &  '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ',REF' & ';'
								    elseif ( !this.adjacentPanelSymmetry eq 12 ) then	
									    !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & ' S,' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() & ';'
								    endif	
									if ( !this.adjacentPanelSymmetry eq 3 ) then
                           	            !statements[!p] = 'NOT,' & !this.notchNearPanelSize & ',' & '''' & !seamRecords[!p].panelName() & '''' & ',' & ' SEA=' & !seamRecords[!p].seamNo() &  ';'   						
							        endif	 	
							endif
						
			endif	
            break if(!p eq !this.nrOfSeams )
           !p= !p + 1
     enddo
	 return !statements
endmethod

-- Function gets on which sides adjacent panel is defined.
-- Adjacent panel(!adjacentPanelName) is panel placed near created panel.

define method .getAdjacentPanelSideFromGroupTwoStatement(!adjacentPanelName is STRING) is STRING
    using namespace 'Aveva.Marine.DataExtraction'
     using namespace 'Aveva.Marine.Design'
     !extractObject = object MARDEX()
     !panelObj = object MARHULLPAN()
	
     !getInfoObj = object MARDEX()
     !extractString = 'HULL.PANEL(' & '''' & !adjacentPanelName & '''' & ').SYMMETRY'
	 !dataExtractedResult = !getInfoObj.extractPML(!extractString)
	 if ( !dataExtractedResult EQ 0) then
         !getInfoObj.nextResultPML()
	     !this.adjacentPanelSymmetry = !getInfoObj.getIntPML()
     endif		

     !statement = !panelObj.stmtGet( !adjacentPanelName, 2)
     !compareStr = ''''
     !posStr = match(!statement, !compareStr)
     !subStatement = !statement.substring(!posStr + 1)

    !compareStr = ','
    !posStr = match(!subStatement, !compareStr)
    !word = !subStatement.substring(!posStr + 1)

    !side = !word.before(',')

     -- done for three choices: SBP, P, S
     if ( match( !side, 'SBP' ) GT 0 ) then
         !panelSide = ''
     elseif ( match( !side, 'SP' ) GT 0 ) then
	     !panelSide = ''
     elseif ( !side EQ ' P' ) then
        !panelSide = 'P'
     else
         !panelSide = 'S'
     endif

     return !panelSide
endmethod

-- Method gets side on which newly created panel is defined

define method .getCreatedPanelSide()

     using namespace 'Aveva.Marine.DataExtraction'
     using namespace 'Aveva.Marine.Design'
     !extractObject = object MARDEX()
     !panelObj = object MARHULLPAN()

     !statement = !panelObj.stmtGet( !this.panelNames[0], 2)
     !compareStr = ''''
     !posStr = match(!statement, !compareStr)
     !subStatement = !statement.substring(!posStr + 1)

     !compareStr = ','
     !posStr = match(!subStatement, !compareStr)
     !subStatementT = !subStatement.substring(!posStr + 1)
    !side = !subStatementT.before(',')

    if ( match( !side, 'SBP' ) GT 0 ) then
         !this.createdPanelSide = ''
    elseif ( match( !side, 'SP' ) GT 0 ) then
	    !this.createdPanelSide = ''
    elseif ( !side EQ ' P' ) then
        !this.createdPanelSide = 'P'
    else
        !this.createdPanelSide = 'S'
    endif
endmethod
