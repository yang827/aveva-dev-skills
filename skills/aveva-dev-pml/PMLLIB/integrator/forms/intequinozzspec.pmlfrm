--
-- Description:
-- Set Nozzle specs for unset references
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Tidy up
--  delConn()                        -                   Delete nozzle
--  init()                           -                   Constructor
--  intEquiNozzSpec()                -                   Initialise form
--  newConn()                        -                   Create new nozzle
--  nozzSpec()                       -                   Show nozzle specification form
--  refresh()                        -                   Refresh lists
--  setLink()                        -                   Set nozzle link
--  setNozzle()                      -                   Select nozzle
--  setScConn()                      -                   Populate nozzle list
--  setup(DBREF)                     -                   Setup form
--

import 'IntegratorAddin'
handle any
endhandle

setup form !!intEquiNozzSpec resize

using namespace 'Aveva.Pdms.IntegratorAddin'

  !!intEquiNozzSpec.formTitle = |Equipment Connections|
  !!intEquiNozzSpec.iconTitle = |Equi Conns|
  !!intEquiNozzSpec.helpContextId = |F1_SCHEMATIC_INTEGRATOR_EQUIPMENT_CONNECTIONS$@PIDIUG|

  list .scConns     |Schematic Equipment Connections| anchor top+left+right width 72 height 8
  path down
  list .connections |3D Equipment Connections| anchor all width 72 height 8

  frame .linkFrame |Connections| anchor left+bottom
    para .sizePara  text |Size is| width 5 lines 1
    path right
    para .match       width 8 lines 1
    button .setLink  |Set Link| at xmin ymax+0.2 width 7
  exit

  frame .connFrame |3D Connection| anchor left+bottom at xmax+2 ymin
    button .nozzSpec |Modify Specification...| width 15
    option .newType              at xmax+2 ymin width 17
    button .new      |Create...| at xmax ymin width 7
    button .delete   |Delete Connection...| at xmin.nozzSpec ymax+0.2 width 15
    button .refresh  |Refresh Lists| at xmax+2 ymin width 10
  exit

  button .close |Close| anchor right+bottom at xmax form-size ymax form-size width 5

  member .equi               is DBREF
  member .scConnsRefs        is ARRAY
  member .scConnsConns       is ARRAY
  member .scConnsRows        is ARRAY
  member .connectionsRefs    is ARRAY
  member .connectionsConns   is ARRAY
  member .connectionsRows    is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .intEquiNozzSpec()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .intEquiNozzSpec()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Callbacks
  !this.callback              = |!this.init()|
  !this.formRevision          = | |
  !this.scConns.callback      = |!this.setScConn()|
  !this.connections.callback  = |!this.setNozzle()|
  !this.new.callback          = |!this.newConn()|
  !this.refresh.callback      = |!this.refresh()|
  !this.delete.callback       = |!this.delConn()|
  !this.nozzSpec.callback     = |!this.nozzSpec()|
  !this.setLink.callback      = |!this.setLink()|
  !this.close.callback        = |!this.close()|

  -- List titles
  !headText = ARRAY()
  !headText.append('Type')
  !headText.append('Name')
  !headText.append('Size')
  !headText.append('Link')
  !headText.append('Connection')
  !this.scConns.setHeadings(!headText)
  !this.connections.setHeadings(!headText)

  -- New connection options
  !dtext    = ARRAY()
  !dtext[1] = |New Piping Nozzle|
  !dtext[2] = |New HVAC Nozzle|
  !dtext[3] = |New Electrical Connection|
  !rtext    = ARRAY()
  !rtext[1] = |PIPE|
  !rtext[2] = |HVAC|
  !rtext[3] = |ELCONN|
  !this.newType.dtext = !dtext
  !this.newType.rtext = !rtext

endmethod

------------------------------------------------------------------------
--
-- Method:      .setup()
--
-- Description: Setup form
--
------------------------------------------------------------------------
define method .setup(!equi is DBREF)

  -- Store selected equi
  !this.equi = !equi

endmethod
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
------------------------------------------------------------------------
define method .init()

  using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Initialise
  !this.nozzSpec.active = FALSE
  !this.delete.active   = FALSE
  !this.setLink.active  = FALSE
  !scNozzRtext       = ARRAY()
  !this.scConnsRefs  = ARRAY()
  !this.scConnsConns = ARRAY()
  !this.scConnsRows  = ARRAY()
  !this.scConns.tag  = 'Schematic Equipment ' & !this.equi.schlnk.flnm
  handle any
    -- Link no longer available
    !this.hide()
    return error 1 |Equipment is no longer linked|
  endhandle
  !this.connections.tag = '3D Equipment '        & !this.equi.flnm

  -- Collect schematic nozzles and elconns
  !scNozz = object COLLECTION()
  !scNozz.scope(!this.equi.schlnk)
  !scNozz.type('SCNOZZ')
  !scNozz.addType('SCELCO')

  -- Build list of schematic nozzles and elconns
  do !scNozzVal values !scNozz.results()
    !this.scConnsRefs.append(!scNozzVal)
    -- Connection array is used for direct connections only so pad with unset dbrefs
    !this.scConnsConns.append(object DBREF())
    !nozz = object INTEGRATORNOZZLE(!scNozzVal)
    !row = ARRAY()
    !row[1] = !scNozzVal.type
    !row[2] = !scNozzVal.flnm
    !row[3] = !nozz.sizeString
    !row[4] = !nozz.linkString
    !row[5] = !nozz.crefString
    !this.scConnsRows.append(!row)
    !scNozzRtext.append(!scNozzVal.refn.string())
  enddo

  -- Add direct piping and HVAC connections
  if (!this.equi.schlnk.ecrfa.size() gt 0) then
    do !i indices !this.equi.schlnk.ecrfa
      !crefString = !this.equi.schlnk.ecrfa[!i].flnm
      handle any
      elsehandle none
        -- Store ref to schematic object so we can get to it later even if duplicate names are used
        !this.scConnsConns.append(!this.equi.schlnk.ecrfa[!i])
        !row = ARRAY()
        !row[1] = |ECRFA[| & !i & |]|
        !row[2] = ||
        !row[3] = ||
        !row[4] = ||
        !row[5] = !crefString
        !this.scConnsRows.append(!row)
        !scNozzRtext.append(|ECRFA|)
      endhandle
    enddo
  endif

  -- Add direct electrical connections
  if (!this.equi.schlnk.elcxrf.size() gt 0) then
    do !i indices !this.equi.schlnk.elcxrf
      !crefString = !this.equi.schlnk.elcxrf[!i].flnm
      handle any
      elsehandle none
        -- Store ref to schematic object so we can get to it later even if duplicate names are used
        !this.scConnsConns.append(!this.equi.schlnk.elcxrf[!i])
        !row = ARRAY()
        !row[1] = |ELCXRF[| & !i & |]|
        !row[2] = ||
        !row[3] = ||
        !row[4] = ||
        !row[5] = !crefString
        -- Mark the multi-cables as they have no 3D equivalent
        if (!this.equi.schlnk.elcxrf[!i].type eq |SCMCAB|) then
          !row[5] = |SCMCAB | & !row[5]
        endif
        !this.scConnsRows.append(!row)
        !scNozzRtext.append(|ELCXRF|)
      endhandle
    enddo
  endif

  -- Populate list
  !this.scConns.setRows(!this.scConnsRows)
  !this.scConns.rtext = !scNozzRtext

  -- Build list of 3D nozzles and elconns
  !this.connections.setRows(ARRAY())
  !this.connections.rtext = ARRAY()
  if (!this.scConns.rtext.empty().not()) then
    !this.setScConn()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .setScConn()
--
-- Description: Populate nozzle list
--
------------------------------------------------------------------------

define method .setScConn()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Initialise
  !connectionsRtext      = ARRAY()
  !this.connectionsRefs  = ARRAY()
  !this.connectionsConns = ARRAY()
  !this.connectionsRows  = ARRAY()

  -- Clear any highlighting
  !drawlist = !!integratorSupportHandler.intDrawlist()
  !drawlist.update()
  unmark all

  -- No link action for direct connections to scequi
  if (!this.scConns.selection() inset(|ECRFA|, |ELCXRF|)) then
    !this.match.val = 'N/A'
    !this.match.background = 1
    !this.setLink.active = FALSE
    !scNozz = object DBREF()
  else
    !scNozz = !this.scConns.selection().dbref()
  endif

  -- Collect 3D nozzles and elconns
  !conns = object COLLECTION()
  !conns.scope(!this.equi)
  !conns.type('NOZZ')
  !conns.addType('ELCONN')

  -- Build list of 3D nozzles and elconns
  do !conn values !conns.results()
    !this.connectionsRefs.append(!conn)
    -- Connection array is used for direct connections only so pad with unset dbrefs
    !this.connectionsConns.append(!conn.cref)
    handle any
      !this.connectionsConns.append(object DBREF())
    endhandle
    !nozz = object INTEGRATORNOZZLE(!conn)
    !row = ARRAY()
    !row[1] = !conn.type
    !row[2] = !conn.fullname
    !row[3] = !nozz.sizeString
    !row[4] = !nozz.linkString
    !row[5] = !nozz.crefString
    !this.connectionsRows.append(!row)
    !connectionsRtext.append(!conn.refn.string())
  enddo

  -- Add direct electrical connections
  if (!this.equi.elcxrf.size() gt 0) then
    do !i indices !this.equi.elcxrf
      !crefString = !this.equi.elcxrf[!i].flnm
      handle any
      elsehandle none
        -- Store ref to schematic object so we can get to it later even if duplicate names are used
        !this.connectionsConns.append(!this.equi.elcxrf[!i])
        !row = ARRAY()
        !row[1] = |ELCXRF[| & !i & |]|
        !row[2] = ||
        !row[3] = ||
        !row[4] = ||
        !row[5] = !crefString
        !this.connectionsRows.append(!row)
        !connectionsRtext.append(|ELCXRF|)
      endhandle
    enddo
  endif

  -- Populate list
  !this.connections.setRows(!this.connectionsRows)
  !this.connections.rtext = !connectionsRtext

  -- Select nozzle already linked if available
  !this.connections.select('Rtext', !scNozz.deslnk[1].refn.string())
  handle any
    if (!this.scConns.selection() inset(|ECRFA|, |ELCXRF|)) then
      -- Direct connection so find row with linked connection (skipping multi-cable which is not in 3D)
      !scConnConn = !this.scConnsConns[!this.scConns.val]
      if (!scConnConn.type eq |SCMCAB|) then
        if (!this.scConnsConns.size() gt !this.scConns.val) then
          if (!this.scConnsConns[!this.scConns.val + 1].type eq |SCCAB|) then
            !scConnConn = !this.scConnsConns[!this.scConns.val + 1]
          endif
        endif
      endif
      if (!scConnConn.deslnk.set()) then
        if (!scConnConn.deslnk.size() gt 0) then
          if (!scConnConn.deslnk[1].badref().not()) then
            do !i indices !this.connectionsConns
              if (!this.connectionsConns[!i] eq !scConnConn.deslnk[1]) then
                !this.connections.val = !i
                break
              endif
            enddo
          endif
        endif
      endif
    else
      -- Nozzle or elconn not linked so find first not linked row
      do !i indices !this.connectionsRows
        if (!this.connectionsRows[!i][4] eq |Not Linked|) then
          !this.connections.val = !i
          break
        endif
      enddo
    endif
  endhandle

  -- Highlight nozzle selection
  if (!this.connections.rtext.empty().not()) then
    !this.setNozzle()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .setNozzle()
--
-- Description: Select nozzle
--
------------------------------------------------------------------------

define method .setNozzle()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Initialise
  !name = 'unset'
  !sub = FALSE

  -- Clear any highlighting
  !drawlist = !!integratorSupportHandler.intDrawlist()
  !drawlist.update()
  unmark all

  -- Activate Modify and Delete buttons for nozzle and elconn
  !modifiable = (!this.connectionsRows[!this.connections.val][1] inset(|NOZZ|, |ELCONN|))
  !this.nozzSpec.active = !modifiable
  !this.delete.active   = !modifiable

  -- No link action for direct connections to scequi or equi
  !multiCableRowSelected = (!this.scConnsConns[!this.scConns.val].type eq |SCMCAB|)
  handle any
    !multiCableRowSelected = FALSE
  endhandle
  !schematicDirectConnection = (!this.scConns.selection() inset(|ECRFA|, |ELCXRF|))
  handle any
    !schematicDirectConnection = FALSE
  endhandle
  if (!this.connections.selection() eq |ELCXRF| or !multiCableRowSelected or !schematicDirectConnection) then
    !this.match.val = 'N/A'
    !this.match.background = 1
    !this.setLink.active  = FALSE
    return
  endif

  -- Get nozzle details
  !scNozz = object INTEGRATORNOZZLE(!this.scConns.selection().dbref())
  handle any
    !scNozz = object INTEGRATORNOZZLE()
  endhandle
  !conn = !this.connections.selection().dbref()
  !nozz = object INTEGRATORNOZZLE(!conn)

  -- Get scnozz details
  if (!conn.schlnk.set()) then
    -- Nozzle is linked so get bore from schematic nozzle catref or bore attribute
    !name = !conn.schlnk.ref.string()
    !sub = TRUE
  elseif (!conn.owner.type eq 'EQUI') then
    -- Nozzle is not linked so use owning equipment link
    if (!conn.owner.schlnk.set()) then
      !name = !conn.owner.schlnk.ref.string()
    endif
  elseif (!conn.owner.type neq 'EQUI') then
    -- Nozzle under template or sube is not linked so using owning equipment link
    if (!conn.owner.owner.schlnk.set()) then
      !name = !conn.owner.owner.schlnk.ref.string()
    endif
  endif

  -- Highlight on diagram view and select in scnozz grid or scequi grid
  if (!name neq 'unset') then
    !itemList[1] = !name
    !intMan = object INTEGRATORMANAGER()
    if (!sub) then
      !intMan.subGridSelectedItems(!itemList)
    else
      !intMan.gridSelectedItems(!itemList)
    endif
    !intMan.findOnDrawing(!itemList)
    handle any
      -- Ignore any error
    endhandle
  endif

  -- Highlight selected 3D nozzle
  !drawlist.highlight(!conn, !!gphcolopt.highlight.code)
  handle any
    -- Not in drawlist
  endhandle
  mark $!conn

  -- Activate link button if appropriate
  !this.setLink.active = FALSE
  if (!scNozz.element.set()) then
    if (!scNozz.element.type eq |SCNOZZ|) then
      !this.setLink.active = (!nozz.element.type eq |NOZZ|)
    elseif (!scNozz.element.type eq |SCELCO|) then
      !this.setLink.active = (!nozz.element.type eq |ELCONN|)
    endif
  endif

  -- Show matching size if appropriate
  if (!this.setLink.active) then
    if (!nozz.sizeString eq !scNozz.sizeString) then
      -- Flag matching bores for scnozz and nozz
      !this.match.val = 'Matched'
      !this.match.background = 5
    else
      !this.match.val = 'Unmatched'
      !this.match.background = 2
    endif
  else
    !this.match.val = 'N/A'
    !this.match.background = 1
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .nozzSpec()
--
-- Description: Show nozzle specification form
--
------------------------------------------------------------------------

define method .nozzSpec()

  -- Show nozzle specification form
  !!ce = !this.connections.selection().dbref()
  !nozz = object INTEGRATORNOZZLE(!!ce)
  if (!nozz.isHVAC) then
    -- HVAC nozzle
    !!cDHCEBUTTON = |1|
    !!runSynonym(|CALLDCT FNCDNOZ|)
    handle any
      !!alert.error(|Unable to show HVAC Nozzle form - check HVAC Designer application is current|)
    endhandle
  elseif (!nozz.isPiping) then
    -- Piping nozzle
    !!runSynonym(|CALLE XNOZZSPEC|)
  elseif (!nozz.isElectrical) then
    -- Electrical connection
    !!equElecModify()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .delConn()
--
-- Description: Delete nozzle
--
------------------------------------------------------------------------

define method .delConn()

  -- Delete nozzle
  !!ce = !this.connections.selection().dbref()
  !name = !!ce.flnm
  !type = !!ce.type
  if (!!alert.confirm('OK to delete $!type $!name?') eq 'YES') then
    DELETE $!type
    !this.refresh()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .newConn()
--
-- Description: Create new nozzle
--
------------------------------------------------------------------------

define method .newConn()

  -- Get equi for connection
  !!ce = !this.equi
  LAST MEMBER
  handle any
  elsehandle none
    END
  endhandle

  -- Create nozzle or elconn
  if (!this.newType.selection() eq |ELCONN|) then
    NEW ELCONN
  else
    NEW NOZZ
    -- Set a default height
    height 100mm
    if (!this.newType.selection() eq |HVAC|) then
      -- Set initial attributes so that HVAC application can modify the nozzle
      !nozz = object INTEGRATORNOZZLE(!!ce)
      !nozz.defaultHvacNozzle()
    endif
  endif
  !this.refresh()

endmethod
------------------------------------------------------------------------
--
-- Method:      .setLink()
--
-- Description: Set nozzle link
--
------------------------------------------------------------------------

define method .setLink()

  -- Get selections
  !scNozz = !this.scConns.selection().dbref()
  !equiNozz = !this.connections.selection().dbref()

  -- Check for inconsistent types
  if (!scNozz.type eq |SCNOZZ|) then
    if (!equiNozz.type ne |NOZZ|) then
      return error 1 |Types of connections are not suitable for linking|
    endif
  endif
  if (!scNozz.type eq |SCELCO|) then
    if (!equiNozz.type ne |ELCONN|) then
      return error 1 |Types of connections are not suitable for linking|
    endif
  endif

  -- Store existing link on schematic nozzle
  !alreadyLinked = false
  !deslnk = object DBREF()
  if (!scNozz.deslnk.size() gt 0) then
    if (!scNozz.deslnk[1].set()) then
      if (!scNozz.deslnk[1].badref().not()) then
        !deslnk = !scNozz.deslnk[1]
        if (!scNozz.deslnk[1] eq !equiNozz) then
          -- Already linked to selected nozzle
          !alreadyLinked = true
        endif
      endif
    endif
  endif

  -- Check not already linked to selected nozzle
  if (!alreadyLinked.not()) then

    -- See if currently linked 3D nozzle was autocreated this session
    !autoCreatedIndex = !!integratorSupportHandler.nozzBuilt.findFirst(!deslnk)

    -- If owners are both unlinked subequipment then link them
    !scNozzOwnerIsLinked = !scNozz.owner.deslnk[1].badref().not()
    handle any
      !scNozzOwnerIsLinked = FALSE
    endhandle
    !equiNozzOwner = !equiNozz.owner
    if (!equiNozzOwner.type eq |TMPL|) then
      !equiNozzOwner = !equiNozz.owner.owner
    endif
    !equiOwnerIsLinked = !equiNozzOwner.schlnk.badref().not()
    handle any
      !equiOwnerIsLinked = FALSE
    endhandle
    if (!scNozzOwnerIsLinked.not() and !equiOwnerIsLinked.not()) then
      if (!scNozz.owner.type eq |SCSUBE| and !equiNozzOwner.type eq |SUBE|) then
        !!integrator.link(!scNozz.owner.ref.string(), !equiNozzOwner.ref.string())
        handle any
          return error 1 |Unable to link owning subequipment: $!!error.text|
        endhandle
      endif
    endif

    -- Store existing link on 3D nozzle
    !schlnk = object DBREF()
    if (!equiNozz.schlnk.set()) then
      if (!equiNozz.schlnk.badref().not()) then
        !schlnk = !equiNozz.schlnk
        if (!deslnk.set() and !autoCreatedIndex.unset()) then
          -- Both already linked to other nozzles and not autocreated this session
          if (!!alert.confirm(|Connection are both linked - ok to swap links?|) eq |NO|) then
            return
          endif
        elseif (!!alert.confirm(|Equipment connection is already linked - ok to unlink?|) eq |NO|) then
          return
        endif
      endif
    endif

    -- Unlink selected nozzles
    if (!deslnk.set()) then
      !!integrator.unlink(!scNozz.ref.string())
      handle any
        return error 1 |Unable to unlink schematic connection: $!!error.text|
      endhandle
    endif
    if (!schlnk.set()) then
      !!integrator.unlink(!equiNozz.ref.string())
      handle any
        return error 1 |Unable to unlink 3D connection: $!!error.text|
      endhandle
    endif

    -- Link selected schematic and 3D nozzle
    !!integrator.link(!scNozz.ref.string(), !equiNozz.ref.string())
    handle any
      return error 1 |Unable to link connections: $!!error.text|
    endhandle

    -- Set HVAC duct size
    !scConnNozz = object INTEGRATORNOZZLE(!scNozz)
    if (!scConnNozz.isHVAC) then
      !scConnNozz.setDuctSize()
    endif

    -- If both were linked before and not autocreated this session then link the two unlinked objects
    if (!deslnk.set() and !schlnk.set() and !autoCreatedIndex.unset()) then
      !!integrator.link(!schlnk.ref.string(), !deslnk.ref.string())
      handle any
        !!alert.error(|Unable to link previous connections: $!!error.text|)
      endhandle
    endif

    -- Transfer name (only if target nozzle is not already named)
    if (!equiNozz.isNamed.not()) then
      if (!deslnk.badref().not()) then
        if (!deslnk.isNamed) then
          !!ce = !deslnk
          !name = !deslnk.name
          UNNAME
          !!ce = !equiNozz
          name $!name
        endif
      endif
    endif

    -- Get attributes from autocreated nozzle then delete it
    if (!deslnk.set()) then
      if (!autoCreatedIndex.set()) then
        !nozzAtts = !!integratorSupportHandler.nozzAtts[!autoCreatedIndex]
        -- Copy over any set attributes
        !value = STRING()
        do !attrib values !nozzAtts
          !value.delete()
          !value = !deslnk.attribute(!attrib)
          handle any
            if (!!integratorSupportHandler.debug) then
              !output = 'Error getting nozzle attribute ' & !attrib & ': ' & !!error.text
              write !output
            endif
            skip
          endhandle
          skip if (!attrib.upcase() eq |NAME| or !value.unset())
          !equiNozz.attribute(!attrib) = !value
          handle any
            if (!!integratorSupportHandler.debug) then
              !output = 'Error setting nozzle attribute ' & !attrib & ': ' & !!error.text
              write !output
            endif
            skip
          endhandle
        enddo
        -- Delete autocreated nozzle
        !!ce = !deslnk
        !type = !deslnk.type
        DELETE $!type
        !!ce = !equiNozz
      endif
    endif

  endif

  -- If nozzle name still unset (e.g for when linking nozzles following a reselect of template) try to copy name
  if (!equiNozz.isNamed.not()) then
    if (!scNozz.isNamed) then
      !equiNozz.name = !scNozz.name
      handle any
        !!alert.error(|Unable to set nozzle name: $!!error.text|)
      endhandle
    endif
  endif

  -- Refresh list
  !this.refresh()

endmethod
------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: Refresh lists
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh lists
  !val1 = !this.scConns.val
  !val2 = !this.connections.val
  !this.init()
  !this.scConns.val = !val1
  handle any
  endhandle
  !this.setScConn()
  !this.connections.val = !val2
  handle any
  endhandle
  if (!this.connections.rtext.empty().not()) then
    !this.setNozzle()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Tidy up
--
------------------------------------------------------------------------

define method .close()

  -- Tidy up display
  unmark all
  if (!this.connections.selection() eq |ELCXRF|) then
    !conn = !this.connections.selection().dbref()
    handle any
    elsehandle none
      !drawlist = !!integratorSupportHandler.intDrawlist()
      !drawlist.unhighlight(!conn)
    endhandle
  endif
  !this.hide()

endmethod
