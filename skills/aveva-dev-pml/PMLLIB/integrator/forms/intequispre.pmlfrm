-- Created:         March 2007
--
--
-- Description:
-- Set Nozzle specs for unset references
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Constructor
--  intEquiSpre()                    -                   Constructor
--  setEqui()                        -                   sets the current equipment
--  setNozz()                        -                   shows the nozzles with no catref set
--  setPos()                         -                   Function/Procedure
--  setSpecRef()                     -                   Function/Procedure
--  templateLinkedNozzles()          BOOLEAN             Check if equipment has linked nozzles below template
--
import 'IntegratorAddin'
handle any
endhandle

setup form !!intEquiSpre

using namespace 'Aveva.Pdms.IntegratorAddin'

  !!intEquiSpre.helpContextId = |F1_SCHEMATIC_INTEGRATOR_EQUIPMENT_DETAILS$@PIDIUG|

  list .equip      |Equipment Name:|  width 30 height 5
  path down
  para .spreHead  Text |Specification Reference:|  width 30 lines 1
  para .spre  Text ||  width 30 lines 1
  button .modify  |Set Equipment Specification...| width 20
  button .setPos  |Set Equipment Position...     | width 20
  button .nozzles |Set Connection Details...     | width 20

  button .dismiss |Dismiss| at xmax form-size ymax.nozzles+0.3 cancel

exit

------------------------------------------------------------------------
--
-- Method:      .intEquiSpre()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .intEquiSpre()

using namespace 'Aveva.Pdms.IntegratorAddin'

  !this.formTitle        = |Equipment Details|
  !this.iconTitle        = |EquiSpre|
  !this.callback         = |!this.init()|
  !this.formRevision     = | |
  !this.equip.callback   = |!this.setEqui()|
  !this.nozzles.callback = |!this.setNozz()|
  !this.modify.callback  = |!this.setSpecRef()|
  !this.setPos.callback  = |!this.setPos()|

endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
------------------------------------------------------------------------
define method .init()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Load in the equipment items from the project handler
  !equiDtext = ARRAY()
  !equiRtext = ARRAY()
  do !i values !!integratorSupportHandler.equiBuilt
    !equiDtext.append(!i.namn)
    !equiRtext.append(!i.refn.string())
  enddo
  !this.equip.dtext = !equiDtext
  !this.equip.rtext = !equiRtext
  !this.setEqui()

endmethod

------------------------------------------------------------------------
--
-- Method:      .setEqui()
--
-- Description: Select equipment
--
------------------------------------------------------------------------

define method .setEqui()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Select equipment in grid
  !!ce = !this.equip.selection().dbref()
  !name = !!ce.schlnk.ref.string()
  handle any
    -- Link no longer available
    !this.hide()
    return error 1 |Equipment is no longer linked|
  endhandle
  !itemList[1] = !name
  !intMan = object INTEGRATORMANAGER()
  !intMan.gridSelectedItems(!itemList)

  -- Get spref of equi
  if (unset(spre)) then
    !this.spre.val = 'unset'
  else
    !this.spre.val = name of spre
  endif

  -- Reinitialise child forms if shown
  if (defined(!!equModSpref)) then
    if (!!equModSpref.shown()) then
      !this.setSpecRef()
    endif
  endif
  if (defined(!!intEquiNozzSpec)) then
    if (!!intEquiNozzSpec.shown()) then
      if (!!ce.schlnk.type eq |SCEQUI|) then
      !this.setNozz()
      else
        hide !!intEquiNozzSpec
      endif
    endif
  endif
  if (defined(!!pos3DExplicit)) then
    if (!!pos3DExplicit.shown()) then
      !this.setPos()
    endif
  endif

  -- Deactivate connection details button if not for equipment, e.g. for offline instrument
  !this.nozzles.active = (!!ce.schlnk.type eq |SCEQUI|)

endmethod
------------------------------------------------------------------------
--
-- Method:      .setSpecRef()
--
-- Description: Show equi spref form
--
------------------------------------------------------------------------

define method .setSpecRef()

  -- Show equipment spref form
  !continue = |YES|
  !!ce = !this.equip.selection().dbref()
  if (!this.templateLinkedNozzles()) then
    !continue = !!alert.confirm(|Selecting another equipment specification for | & !!ce.name & | will delete its linked nozzles. Do you want to continue?|)
  endif
  if (!continue eq |YES|) then
    if (defined(!!equModSpref)) then
      if (!!equModSpref.shown()) then
        hide !!equModSpref
      endif
    endif
    show !!equModSpref
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .setNozz()
--
-- Description: Show nozzle details form
--
------------------------------------------------------------------------

define method .setNozz()

  -- Show nozzles form
  !!ce = !this.equip.selection().dbref()
  if (defined(!!intEquiNozzSpec)) then
    if (!!intEquiNozzSpec.shown()) then
      hide !!intEquiNozzSpec
    endif
  else
    pml load form !!intEquiNozzSpec
  endif
  !!intEquiNozzSpec.setup(!!ce)
  show !!intEquiNozzSpec

endmethod
------------------------------------------------------------------------
--
-- Method:      .setPos()
--
-- Description: Show position form
--
------------------------------------------------------------------------

define method .setPos()

  -- Show position form for equi
  !!ce = !this.equip.selection().dbref()
  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    show !!shipReferencePosition
  else
    !!pos3DExplicit()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      templateLinkedNozzles
-- Description: Check if equipment has linked nozzles below template
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--   [Data Type] [Description]
--    BOOLEAN     True if equi has tmpl with linked nozzles below it
------------------------------------------------------------------------
define method .templateLinkedNozzles() is BOOLEAN

  -- Return true if equi has tmpl with linked nozzles below it
  !result = FALSE
  !!ce = !this.equip.selection().dbref()
  TMPL 1
  handle any
    -- No template
  elsehandle none
    !collection = object COLLECTION()
    !collection.scope(!!ce)
    !collection.type(|NOZZ|)
    END
    do !nozzle values !collection.results()
      if (!nozzle.schlnk.badref().not()) then
        !result = TRUE
        break
      endif
    enddo
  endhandle
  return !result

endmethod
