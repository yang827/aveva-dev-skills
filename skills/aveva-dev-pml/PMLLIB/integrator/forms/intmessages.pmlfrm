-- Created:         February 2008
--
--
-- Description:
-- Display messages during Integrator operations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addMessage(ARRAY)                -                   Display new messages on end of current messages
--  clear()                          -                   Clear old messages
--  display(ARRAY)                   -                   Display new messages in place of current messages
--  intMessages()                    -                   Constructor
--

setup form !!intMessages

  !!intMessages.formTitle = |Integrator Messages|
  !!intMessages.iconTitle = |Messages|
  textpane .messages width 64 height 4

exit

------------------------------------------------------------------------
--
-- Method:      .intMessages()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .intMessages()

  -- Make it read only
  !this.messages.setEditable(FALSE)

endmethod

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear old messages
--
------------------------------------------------------------------------
define method .clear()

  -- Clear messages
  !this.messages.clear()

endmethod

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Display new messages in place of current messages
--
------------------------------------------------------------------------
define method .display(!textArray is ARRAY)

  -- Display messages and repeat to command window so can be reviewed later
  !this.messages.val = !textArray
  do !text values !textArray
    write !text
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      .addMessage()
--
-- Description: Display new messages on end of current messages
--
------------------------------------------------------------------------
define method .addMessage(!textArray is ARRAY)

  -- Display messages
  !messages = !this.messages.val
  !messages.appendArray(!textArray)
  !this.messages.val = !messages

endmethod
