--
--
-- Description:
-- Pick a connection or create a new connection when connected to an equipment
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   Clear form arrays
--  close()                          -                   Function/Procedure
--  delConn()                        -                   Delete nozzle
--  init()                           -                   Constructor
--  intPickConn()                    -                   Constructor
--  newConn()                        -                   Function/Procedure
--  nozzSpec()                       -                   Show nozzle specification form
--  refresh()                        -                   Refresh lists
--  setBran()                        -                   Function/Procedure
--  setConn()                        -                   Function/Procedure
--  setConnection()                  -                   Function/Procedure
--  setup(ARRAY)                     -                   Add to form arrays
--

import 'IntegratorAddin'
handle any
endhandle

setup form !!intPickConn resize

using namespace 'Aveva.Pdms.IntegratorAddin'

  !!intPickConn.formTitle = |Pick Connection|
  !!intPickConn.iconTitle = |PickConn|
  !!intPickConn.helpContextId = |F1_SCHEMATIC_INTEGRATOR_PICK_CONNECTION_FORM$@PIDIUG|

  list .branches    |Unresolved Branches| anchor top+left+right width 70 height 8
  path down
  list .connections |Connection Name| anchor all width 70 height 8

  frame .linkFrame |Connection| anchor left+bottom
    para .sizePara  text |Size is| width 5 lines 1
    path right
    para .match       width 8 lines 1
    button .setConn  |Set Connection| at xmin.sizePara+2 ymax+0.2 width 11
  exit

  frame .connFrame |Nozzle| anchor left+bottom at xmax+2 ymin
    button .nozzSpec |Modify Specification...| width 15
    option .newType              at xmax+2 ymin width 13
    button .new      |Create...| at xmax ymin width 7
    button .delete   |Delete Connection...| at xmin.nozzSpec ymax+0.2 width 15
    button .refresh  |Refresh Lists| at xmax+2 ymin width 10
  exit

  button .close |Close| anchor right+bottom at xmax form-size ymax form-size width 5

  member .type   is ARRAY
  member .schlnk is ARRAY
  member .deslnk is ARRAY
  member .bran   is ARRAY
  member .conn   is ARRAY
  member .connBore is ARRAY
  member .connected is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .intPickConn()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .intPickConn()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Callbacks
  !this.callback              = |!this.init()|
  !this.formRevision          = | |
  !this.branches.callback     = |!this.setBran()|
  !this.connections.callback  = |!this.setConn()|
  !this.new.callback          = |!this.newConn()|
  !this.refresh.callback      = |!this.refresh()|
  !this.delete.callback       = |!this.delConn()|
  !this.nozzSpec.callback     = |!this.nozzSpec()|
  !this.setConn.callback      = |!this.setConnection()|
  !this.close.callback        = |!this.close()|
  !this.cancelcall            = |!this.close()|

  -- Set headings
  !headText = ARRAY()
  !headText.append('Name')
  !headText.append('Size')
  !headText.append('Connection')
  !this.branches.setHeadings(!headText)
  !this.connections.setHeadings(!headText)

  -- New connection options
  !dtext    = ARRAY()
  !dtext[1] = |New Piping Nozzle|
  !dtext[2] = |New HVAC Nozzle|
  !rtext    = ARRAY()
  !rtext[1] = |PIPE|
  !rtext[2] = |HVAC|
  !this.newType.dtext = !dtext
  !this.newType.rtext = !rtext

endmethod

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear form arrays
--
------------------------------------------------------------------------

define method .clear()

  -- Clear form arrays
  !this.type.clear()
  !this.schlnk.clear()
  !this.deslnk.clear()
  !this.bran.clear()
  !this.conn.clear()

endmethod
------------------------------------------------------------------------
--
-- Method:      .setup()
--
-- Description: Add to form arrays
--
------------------------------------------------------------------------

define method .setup(!args is ARRAY)

  -- Add to form arrays
  !this.type.append(!args[0])
  !this.schlnk.append(!args[1])
  !this.deslnk.append(!args[2])
  !this.bran.append(!args[3])
  !this.conn.append(!args[4])

endmethod
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
------------------------------------------------------------------------
define method .init()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Initialise
  !type          = ARRAY()
  !schlnk        = ARRAY()
  !deslnk        = ARRAY()
  !bran          = ARRAY()
  !conn          = ARRAY()
  !this.connBore = ARRAY()
  !connBore      = ARRAY()
  !connected     = ARRAY()
  !branchesDtext = ARRAY()
  !branchesRtext = ARRAY()
  !branchesRows  = ARRAY()

  -- Get branch connection details into list
  do !i index !this.bran
    if (!this.conn[!i] eq 'HEAD') then
      !cref = !this.bran[!i].dbref().href
    else
      !cref = !this.bran[!i].dbref().tref
    endif
    if (!cref.unset()) then
      !crefString = 'Not Connected'
      !this.connected[!i] = FALSE
    else
      !crefString = 'Connected to ' & !cref.fullname
      !this.connected[!i] = TRUE
    endif
    !this.connBore[!i] = !!integratorHvac.branchSize(!this.bran[!i].dbref(), !this.conn[!i])
    !boreString = !this.conn[!i] & ' ' & !this.connBore[!i]
    !textString = !this.bran[!i].dbref().fullname & ' ' & !boreString & ' ' & !crefString
    if (!branchesDtext.findFirst(!textString).unset()) then
      !branchesDtext.append(!textString)
      !row = ARRAY()
      !row[1] = !this.bran[!i].dbref().fullname
      !row[2] = !boreString
      !row[3] = !crefString
      !branchesRows.append(!row)
      !branchesRtext.append(!this.bran[!i].dbref().refn.string())
      !type.append(!this.type[!i])
      !schlnk.append(!this.schlnk[!i])
      !deslnk.append(!this.deslnk[!i])
      !bran.append(!this.bran[!i])
      !conn.append(!this.conn[!i])
      !connBore.append(!this.connBore[!i])
      !connected.append(!this.connected[!i])
    endif
  enddo
  !this.branches.setRows(!branchesRows)
  !this.branches.rtext = !branchesRtext

  -- Clear gadgets
  !this.type.clear()
  !this.schlnk.clear()
  !this.deslnk.clear()
  !this.bran.clear()
  !this.conn.clear()
  !this.connBore.clear()
  !this.connected.clear()

  -- Initialise member arrays
  !this.type = !type
  !this.schlnk = !schlnk
  !this.deslnk = !deslnk
  !this.bran = !bran
  !this.conn = !conn
  !this.connBore = !connBore
  !this.connected = !connected

  -- Initialise available connections for first in list
  !this.setBran()

  -- Activate apply buttons
  !this.nozzSpec.active = !this.connections.rtext.empty().not()
  !this.delete.active   = !this.connections.rtext.empty().not()
  !this.setConn.active  = (!this.branches.rtext.empty().not() and !this.connections.rtext.empty().not())

endmethod

------------------------------------------------------------------------
--
-- Method:      .setBran()
--
-- Description: Get available connections for selected branch
--
------------------------------------------------------------------------

define method .setBran()

  -- Initialise
  !val = !this.branches.val
  !connectionsRtext = ARRAY()
  !headText         = ARRAY()
  !connectionsRows  = ARRAY()
  !status           = ARRAY()

  -- Collect available connections
  if (!this.deslnk[!val].set()) then
    if (!this.deslnk[!val] ne |unset|) then
      !conns = object COLLECTION()
      !conns.scope(!this.deslnk[!val].dbref())
      !conns.type(!this.type[!val])

      -- Get connection details
      do !conn values !conns.results()
        !nozz = object INTEGRATORNOZZLE(!conn)
        !row = ARRAY()
        !row[1] = !conn.fullname
        !row[2] = !nozz.sizeString
        !row[3] = !nozz.crefString
        !connectionsRows.append(!row)
        !connectionsRtext.append(!conn.refn.string())
        !status.append(!row[3])
      enddo

    endif
  endif
  !this.connections.setRows(!connectionsRows)
  !this.connections.rtext = !connectionsRtext

  -- Set heading
  !this.connections.tag = 'Connections of ' & !this.branches.selection().dbref().name

  -- Select nozzle already linked if available
  if (!this.bran[!val].set()) then
    if (!this.conn[!val] eq 'HEAD') then
      !this.connections.select('Rtext', !this.bran[!val].dbref().href.name)
      handle any
        -- Find first not connected row
        do !i indices !status
          if (!status[!i] eq |Not Connected|) then
            !this.connections.val = !i
            break
          endif
        enddo
      endhandle
    elseif (!this.conn[!val] eq 'TAIL') then
      !this.connections.select('Rtext', !this.bran[!val].dbref().tref.name)
      handle any
        -- Find first not connected row
        do !i indices !status
          if (!status[!i] eq |Not Connected|) then
            !this.connections.val = !i
            break
          endif
        enddo
      endhandle
    endif
  endif

  -- Activate apply buttons
  !this.setConn.active = (!this.branches.rtext.empty().not() and !this.connections.rtext.empty().not())

  -- Clear any highlighting
  !drawlist = !!integratorSupportHandler.intDrawlist()
  !drawlist.update()
  unmark all

  -- Initialise nozzle selection
  if (!this.connections.rtext.empty().not()) then
    !this.setConn()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .setConn()
--
-- Description: Select connection
--
------------------------------------------------------------------------

define method .setConn()

using namespace 'Aveva.Pdms.IntegratorAddin'

  -- Get connection details
  !itemList[1] = !this.schlnk[!this.branches.val]
  !conn = !this.connections.selection().dbref()
  !nozz = object INTEGRATORNOZZLE(!conn)

  -- Select in grid
  !intMan = object INTEGRATORMANAGER()
  !intMan.gridSelectedItems(!itemList)
  !intMan.findOnDrawing(!itemList)
  handle any
    -- Ignore any error
  endhandle

  -- Flag matching bores for scnozz and nozz
  if (!nozz.sizeString eq !this.connBore[!this.branches.val]) then
    !this.match.val = 'Matched'
    !this.match.background = 5
  else
    !this.match.val = 'Unmatched'
    !this.match.background = 2
  endif

  -- Highlight selected 3D nozzle
  !drawlist = !!integratorSupportHandler.intDrawlist()
  !drawlist.update()
  !drawlist.highlight(!conn)
  unmark all
  mark $!conn

endmethod
------------------------------------------------------------------------
--
-- Method:      .setConnection()
--
-- Description: Set connection between branch and nozzle
--
------------------------------------------------------------------------

define method .setConnection()

  -- Set cref of selected nozzle
  !val = !this.branches.val
  !dbpos = !!ce
  !!ce = !this.bran[!val].dbref()
  !this.connections.selection().dbref().cref = !!ce

  -- Set href/tref of selected branch
  if (!this.conn[!val] eq 'HEAD') then
    !!ce.href = !this.connections.selection().dbref()
    CONN PH TO HREF
    handle any
    endhandle
    if (!!ce.owner.type eq |HVAC|) then
      !!integratorHvac.setBranchSize(!!ce.href)
    endif
  elseif (!this.conn[!val] eq 'TAIL') then
    !!ce.tref = !this.connections.selection().dbref()
    CONN PT TO TREF
    handle any
    endhandle
  endif

  -- Restack components
  !!integratorSupportHandler.stackComps(!!ce)
  !!ce = !dbpos

  -- Refresh lists
  !this.refresh()

endmethod
------------------------------------------------------------------------
--
-- Method:      .nozzSpec()
--
-- Description: Show nozzle specification form
--
------------------------------------------------------------------------

define method .nozzSpec()

  -- Set selected spref on nozzle
  !!ce = !this.connections.selection().dbref()
  !nozz = object INTEGRATORNOZZLE(!!ce)
  if (!nozz.isHVAC) then
    !!cDHCEBUTTON = |1|
    !!runSynonym(|CALLDCT FNCDNOZ|)
    handle any
      !!alert.error(|Unable to show HVAC Nozzle form - check HVAC Designer application is current|)
    endhandle
  else
    !!runSynonym(|CALLE XNOZZSPEC|)
    handle any
      !!alert.error(|Unable to show Nozzle Specification form - check Equipment application is current|)
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .newConn()
--
-- Description: Create new nozzle
--
------------------------------------------------------------------------

define method .newConn()

  -- Get equi for connection
  !!ce = !this.deslnk[!this.branches.val].dbref()
  LAST MEMBER
  handle any
  elsehandle none
    END
  endhandle

  -- Create nozzle
  NEW NOZZ
  if (!this.newType.selection() eq |HVAC|) then
    -- Set initial attributes so that HVAC application can modify the nozzle
    !nozz = object INTEGRATORNOZZLE(!!ce)
    !nozz.defaultHvacNozzle()
  endif
  !this.refresh()

endmethod
------------------------------------------------------------------------
--
-- Method:      .delConn()
--
-- Description: Delete nozzle
--
------------------------------------------------------------------------

define method .delConn()

  -- Delete nozzle
  !!ce = !this.connections.selection().dbref()
  !name = !!ce.flnm
  if (!!alert.confirm('OK to delete NOZZ $!name?') eq 'YES') then
    DELETE NOZZ
    !this.refresh()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: Refresh lists
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh lists
  !val1 = !this.branches.val
  !val2 = !this.connections.val
  !this.init()
  !this.branches.val = !val1
  handle any
  endhandle
  !this.setBran()
  !this.connections.val = !val2
  handle any
  endhandle
  if (!this.connections.rtext.empty().not()) then
    !this.setConn()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Tidy up
--
------------------------------------------------------------------------

define method .close()

  -- Check for unresolved connections
  !hide = TRUE
  do !i values !this.connected
    if (!i.not()) then
      !answer = !!alert.confirm('There are unresolved connections. Do you still want to close the form?')
      if (!answer eq 'YES') then
        break
      else
        !hide = FALSE
        break
      endif
    endif
  enddo

  -- Tidy up display
  if (!hide) then
    -- Clear any highlighting
    !drawlist = !!integratorSupportHandler.intDrawlist()
    !drawlist.update()
    unmark all
    hide !!intPickConn
  else
    if (!this.shown().not()) then
      show !!intPickConn
    endif
  endif

endmethod
