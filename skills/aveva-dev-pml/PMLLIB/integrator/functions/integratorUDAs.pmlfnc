--
-- File:            integratorUDAs.pmlfnc
--   Type:          Function
--   Group:         General
--     Keyword:     Integrator
--   Module:        Design
--   Replaces:      None
--
-- Author:          M.Lewis
-- Created:         Thu May 03 11:51:27 GMT 2012
--
-- Description:
-- Define the UDAs needed for Accept Differences
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!integratorUDAs()

  -- Check we are in Lexicon
  !session = CURRENT SESSION
  if (!session.module() ne |LEXICON|) then
    return error 1 |Must be in Lexicon to load UDA definitions|
  endif

  -- Check if already loaded
  OLD UDA /ACCEPT2D3DDIFFERENCE
  handle (2,109)
    -- Name not defined so load all the UDA definitions
    NEW UWRLD /AVEVA/INTEGRATOR/UWRL
    NEW UGROUP /AVEVA/INTEGRATOR/UGRO
    -- Accept 2D 3D difference
    NEW UDA /ACCEPT2D3DDIFFERENCE
    UDNA 'ACCEPT2D3DDIFFERENCE'
    ABLE 20
    UTYP LOG
    ELEL ADD CYMLNK GPITEM GPSET
    DFLT FALSE
    END
    -- Matching enabled
    NEW UDA /MATCHINGENABLED
    UDNA 'MATCHINGENABLED'
    ABLE 15
    UTYP LOG
    ELEL ADD GPITEM GPSET
    DFLT TRUE
    END
    -- Update date
    NEW UDA /AVINT_UPDATE_DATE
    UDNA 'AVINT_UPDATE_DATE'
    ABLE 17
    UTYP TEXT
    ULEN 16
    ELEL ADD CYMLNK GPITEM GPSET
    END
    -- Comments
    NEW UDA /AVINT_COMMENTS
    UDNA 'AVINT_COMMENTS'
    ABLE 14
    UTYP TEXT
    ULEN 120
    ELEL ADD CYMLNK GPITEM GPSET
    END
    -- User
    NEW UDA /AVINT_UPDATE_USER
    UDNA 'AVINT_UPDATE_USER'
    ABLE 17
    UTYP TEXT
    ULEN 120
    ELEL ADD CYMLNK GPITEM GPSET
    END
    END
  elsehandle none
    -- Some test users need to add the User UDA
    OLD UDA /AVINT_UPDATE_USER
    handle (2,109)
      -- Load the missing UDA definition
      OLD UDA /AVINT_COMMENTS
      -- User
      NEW UDA /AVINT_UPDATE_USER
      UDNA 'AVINT_UPDATE_USER'
      ABLE 17
      UTYP TEXT
      ULEN 120
      ELEL ADD CYMLNK GPITEM GPSET
      END
      END
    endhandle
    -- Some early implementations need a fix for ULEN on the Date UDA
    OLD UDA /AVINT_UPDATE_DATE
    ULEN 16
    END
    END
  endhandle

endfunction
-- End of function definition for !!integratorUDAs()
