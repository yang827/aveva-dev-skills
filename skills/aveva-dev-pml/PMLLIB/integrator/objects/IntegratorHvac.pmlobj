--
--
-- Description:
-- Integrator HVAC component object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branchSize(DBREF,STRING)         STRING              Return size for HVAC branch
--  compSize(DBREF)                  ARRAY               Return size for HVAC branch
--  copyHvacSize(ARRAY)              -                   Copy size of HVAC component from 2D to 3D
--  createLookup()                   -                   Create new lookup table from source data
--  defaultStype(STRING,STRING)      STRING              Return default Styp for given gtyp
--  ductShape(DBREF,REAL)            STRING              Check duct shape is legal
--  ductShape(REAL)                  STRING              Check duct shape is legal
--  findXMLFile()                    FILE                Find lookup table XML file
--  globalInstance()                 -                   Create global instance of object
--  gtypes()                         ARRAY               Return gtypes from lookup table
--  integratorHvac()                 -                   Constructor
--  loadDefaultStypes()              -                   Load default selectors from here
--  loadTableFromSource()            -                   Load table from source spec and appware
--  printStypes()                    -                   Write out selectors
--  readXMLFile(FILE)                -                   Read in lookup table from XML file
--  selectComp()                     -                   Return spref for given gtype and shape
--  setBranchSize(BORE,BORE,STRING)  -                   Set sizes on HVAC branch explicitly
--  setBranchSize(DBREF)             -                   Set sizes on HVAC branch from reference
--  setDefaultStype(STRING,STRING)   -                   Set default stype for a gtype
--  setDefaultStype(STRING,STRING,STRING,STRING) -                   Set default styp for a gtyp
--  setDesignCode()                  -                   Set sizes on HVAC branch
--  setHstu(DBREF)                   -                   Set hstu on HVAC branch
--  setHstu(STRING)                  -                   Set hstu on HVAC branch
--  setLstu(STRING)                  -                   Set lstu on HVAC comp
--  setSpre(STRING)                  -                   Return spref for given gtype and shape
--  stypesForGtype(STRING)           ARRAY               Return stypes for given gtype
--  stypesForGtypeAndShape(STRING,STRING) ARRAY               Return stypes for given gtype
--  trnsShape(STRING,STRING)         STRING              Return shape code for transition piece
--  writeXMLFile()                   -                   Write out lookup table as XML file
--
------------------------------------------------------------------------
define object INTEGRATORHVAC

  member .table           is ARRAY
  member .specMessage     is BOOLEAN
  member .udaMessage      is BOOLEAN
  member .tableMessage    is BOOLEAN
  member .shapeParams     is ARRAY
  member .widthParams     is ARRAY
  member .heightParams    is ARRAY

endobject
-- End of object definition for INTEGRATORHVAC

------------------------------------------------------------------------
--
-- Method:      integratorHvac
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .integratorHvac()

  -- Messages not yet output
  !this.specMessage  = FALSE
  !this.udaMessage   = FALSE
  !this.tableMessage = FALSE

  -- Size parameters
  !this.shapeParams[1]  = 40
  !this.shapeParams[2]  = 40
  !this.shapeParams[3]  = 30
  !this.widthParams[1]  =  2
  !this.widthParams[2]  =  4
  !this.widthParams[3]  = 41
  !this.heightParams[1] =  3
  !this.heightParams[2] =  5
  !this.heightParams[3] = 42

  -- Global Synonyms
  !unusedTest = object DBREF('/CADCHVACSPEC')
  handle ANY
    $G AVEVAHVACSPEC=AVEVAHVACSPEC
    $U AVEVAHVACSPEC
    $G AVEVAHVACISPEC=AVEVAHVACISPEC
    $U AVEVAHVACISPEC
    $G AVEVAHVACCATA=AVEVAHVACCATA
    $U AVEVAHVACCATA
    $G AVEVAHVACMTO=AVEVAHVACMTO
    $U AVEVAHVACMTO
  elsehandle NONE
    $G AVEVAHVACSPEC=CADCHVACSPEC
    $U AVEVAHVACSPEC
    $G AVEVAHVACISPEC=CADCHVACISPEC
    $U AVEVAHVACISPEC
    $G AVEVAHVACCATA=CADCHVACCATA
    $U AVEVAHVACCATA
    $G AVEVAHVACMTO=CADCHVACMTO
    $U AVEVAHVACMTO
  endhandle

endmethod
-- End of method definition for integratorHvac()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!integratorHvac = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      loadTableFromSource
--
-- Description:
--   Load table from source spec and appware
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadTableFromSource()

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Collect HVAC spec data
  var !spco collect all spco for /$:AVEVAHVACSPEC$:
  var !stype evaluate tans for all from !spco
  var !gtype evaluate (tans of owne of owne) for all from !spco

  -- Build initial lookup table
  !this.table.clear()
  !row = ARRAY()
  do !i ind !spco
    !row[1] = !gtype[!i]
    !row[2] = ||
    !name = !spco[!i].dbref().name
    !shapeLetter = !name.after('/$:AVEVAHVACSPEC$:/').substring(1,1)
    !row[3] = ''
    -- Letter does not denote shape for transition piece, cooler battery, or centrifugal fan
    if (!gtype[!i] ne |TRNS| and not !name inset(|/$:AVEVAHVACSPEC$:/CBATT|,|/$:AVEVAHVACSPEC$:/RHCENTRIFAN|)) then
      if (!shapeLetter eq 'R') then
        !row[3] = 'RECT'
      elseif (!shapeLetter eq 'C') then
        !row[3] = 'CIRC'
      elseif (!shapeLetter eq 'F') then
        !row[3] = 'OVAL'
      endif
    endif
    !row[4] = !name
    !row[5] = !stype[!i]
    !row[6] = ||
    !row[7] = ||
    !row[8] = ||
    !row[9] = FALSE
    !this.table.append(!row)
  enddo

  -- Extract codes from appware files that create fittings
  !folder = object FILE('%PDMSUI%\des\hvacadv')
  !sprefFound = ARRAY()
  !fileFound  = ARRAY()
  do !file values !folder.files()
    !filename = !file.entry()
    skip if (!filename.substring(1,2) ne 'mn')

    -- Initialise
    !code1  = ''
    !code66 = ''
    !code67 = ''
    !splt   = ''
    !spref  = ''
    !additionalSpref = ARRAY()

    -- Skip set-fill macros which create two bends to fill a gap
    skip if (!filename inset('mnsetfill','mncsetfill','mnflexfill'))

    -- Loop through the block that sets the description and design parameters
    !lines  = !file.readfile()
    do !record values !lines
      if (!record.substring(1,5) eq 'SPLT ') then
        !splt  = !record.after('SPLT ').replace('$$','').trim()
        !splt  = !splt.substring(2).substring(-2)
      elseif (!record.substring(1,8) eq 'DESP N1 ') then
        !code1 = !record.after('DESP N1 ').trim()
        if (!code1.match('$$') gt 0) then
          !code1 = ''
        endif
      elseif (!record.substring(1,9) eq 'DESP N66 ') then
        !code66 = !record.after('DESP N66 ').trim()
        if (!code66.match('$$') gt 0) then
          !code66 = ''
        endif
      elseif (!record.substring(1,9) eq 'DESP N67 ') then
        !code67 = !record.after('DESP N67 ').trim()
        if (!code67.match('$$') gt 0) then
          !code67 = ''
        endif

      -- Look for a valid spref and allow for additional sprefs in certain cases
      elseif (!record.trim().substring(1,6) eq 'SPREF ') then
        !sprefBase = !record.after('SPREF ').trim()
        if (!sprefBase.substring(1,1) eq '/') then
          if (!spref eq '') then
            -- Found first spref in file
            !spref = !sprefBase
            if (!filename eq 'mncthole') then
              -- Special case for circular test point holes, up to 2
              !sprefBase = !sprefBase.before('$$')
              !spref = !sprefBase & '1'
              !additionalSpref.append(!sprefBase & '2')
            elseif (!filename eq 'mnrthole') then
              -- Special case for rectangular test point holes, up to 8
              !sprefBase = !sprefBase.before('$$')
              !spref = !sprefBase & '1'
              do !i from 2 to 8
                !additionalSpref.append(!sprefBase & !i)
              enddo
            endif
          elseif (!filename inset('mnrstif','mncentrifan','mnpcbciro','mnpflvter')) then
            -- Additional sprefs in same file for rectangular stiffener, centrifugal fan, connection box, flat low velocity terminal
            !additionalSpref.append(!sprefBase)
          endif
        endif

      endif

      -- if not expecting additional sprefs in same file, avoid second block, e.g. for splitter inside bend
      if (not !filename inset('mnrstif','mncentrifan','mnpcbciro','mnpflvter')) then
        break if (!spref.substring(1,1) eq |/|)
      endif

    enddo
    skip if (!spref eq '')

    -- Check for spref found in more than one macro file (if any appear then decide which file to skip above)
    !found = !sprefFound.findFirst(!spref)
    if (!found.set()) then
      !message = 'Warning: spref ' & !spref & ' found in files ' & !fileFound[!found] & ' and ' & !filename
      write !message
      skip
    endif
    !sprefFound.append(!spref)
    !fileFound.append(!filename)

    -- Add the data to the table
    do !i indices !this.table
      if (!this.table[!i][4] eq !spref or !additionalSpref.findFirst(!this.table[!i][4]).set()) then
        !this.table[!i][2] = !code1
        !this.table[!i][6] = !code66
        !this.table[!i][7] = !code67
        !this.table[!i][8] = !splt
        break if (!additionalSpref.empty())
      endif
    enddo

  enddo

endmethod
-- End of method definition for loadTableFromSource()

------------------------------------------------------------------------
--
-- Method:      loadDefaultStypes
--
-- Description:
--   Set which stypes in the table will be defaults
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadDefaultStypes()

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Set which stypes in the table will be defaults
  !this.setDefaultStype(|TUBE|, |/$:AVEVAHVACSPEC$:/RTUBEB|)
  !this.setDefaultStype(|TUBE|, |/$:AVEVAHVACSPEC$:/CTUBE|)
  !this.setDefaultStype(|TUBE|, |/$:AVEVAHVACSPEC$:/FOTUBEB|)
  !this.setDefaultStype(|STRT|, |STRA|, |RECT|, |Rectangular Straight|)
  !this.setDefaultStype(|STRT|, |STRA|, |CIRC|, |Circular Straight|)
  !this.setDefaultStype(|STRT|, |STRA|, |OVAL|, |FlatOval Straight|)
  !this.setDefaultStype(|COUP|, |COUP|, |CIRC|, |Circular Coupling|)
  !this.setDefaultStype(|COUP|, |COUP|, |OVAL|, |FlatOval Coupling|)
  !this.setDefaultStype(|CAP|, |CAP|, |RECT|, |Rectangular Cap End|)
  !this.setDefaultStype(|CAP|, |CAP|, |CIRC|, |Circular Cap End|)
  !this.setDefaultStype(|CAP|, |CAP|, |OVAL|, |FlatOval Cap End|)
  !this.setDefaultStype(|TAPE|, |TAPR|, |RECT|, |Rectangular Taper|)
  !this.setDefaultStype(|TAPE|, |REDU|, |CIRC|, |Circular Taper|)
  !this.setDefaultStype(|TAPE|, |TAPR|, |OVAL|, |FlatOval Taper|)
  !this.setDefaultStype(|OFST|, |CRAN|, |RECT|, |Rectangular Crank Offset|)
  !this.setDefaultStype(|OFST|, |OFFS|, |CIRC|, |Circular Mitred Offset|)
  !this.setDefaultStype(|OFST|, |OFFS|, |OVAL|, |FlatOval -A- Mitred Offset|)
  !this.setDefaultStype(|ELBO|, |ELBO|, |RECT|, |Rectangular !!ANGLEINP degree Elbow|)
  !this.setDefaultStype(|ELBO|, |ELBO|, |CIRC|, |Circular !!ANGLEINP degree Elbow|)
  !this.setDefaultStype(|ELBO|, |ELBA|, |OVAL|, |FlatOval !!ANGLEINP degree -A- Elbow|)
  !this.setDefaultStype(|BEND|, |SQBE|, |RECT|, |Rectangular Square Bend|)
  !this.setDefaultStype(|BEND|, |RBEN|, |CIRC|, |Circular !!ANGLEINP degree Bend|)
  !this.setDefaultStype(|BEND|, |FFSE|, |OVAL|, |FlatOval !!ANGLEINP degree -A4- Bend|)
  !this.setDefaultStype(|BRCO|, |BOOT|, |RECT|, |Rectangular Boot Branch Connector|)
  !this.setDefaultStype(|BRCO|, |BOOT|, |CIRC|, |Circular Boot Branch Connector|)
  !this.setDefaultStype(|BRCO|, |ABOO|, |OVAL|, |FlatOval Boot -A- Branch Connector|)
  !this.setDefaultStype(|TRNS|, |SQRD|, ||, |Rectangular/Round Transition|)
  !this.setDefaultStype(|TRNS|, |SQFO|, ||, |Rectangular/FlatOval Transition|)
  !this.setDefaultStype(|TRNS|, |FORD|, ||, |FlatOval/Round Transition|)
  !this.setDefaultStype(|TRNS|, |FOFO|, ||, |FlatOval Transition|)
  !this.setDefaultStype(|DAMP|, |VCD|, |RECT|, |Rectangular Control Damper|)
  !this.setDefaultStype(|DAMP|, |VCD|, |CIRC|, |Circular Control Damper|)
  !this.setDefaultStype(|FLEX|, |MATL|, |RECT|, |Rectangular Material Connection|)
  !this.setDefaultStype(|FLEX|, |FLEX|, |CIRC|, |Circular Flexible Tube|)
  !this.setDefaultStype(|PLEN|, |SBOX|, |CIRC|, |Plenum Box|)
  !this.setDefaultStype(|PLAT|, |PLAT|, |CIRC|, |Circular Spigot Plate|)
  !this.setDefaultStype(|PLAT|, |FPLT|, |OVAL|, |FlatOval Spigot Plate|)
  !this.setDefaultStype(|STIF|, |/$:AVEVAHVACSPEC$:/RSTIF|)
  !this.setDefaultStype(|STIF|, |/$:AVEVAHVACSPEC$:/CSTIF|)
  !this.setDefaultStype(|STIF|, |/$:AVEVAHVACSPEC$:/FSTIF|)
  !this.setDefaultStype(|GASK|, |GASK|, |RECT|, |Rectangular Gasket|)
  !this.setDefaultStype(|GASK|, |GASK|, |CIRC|, |Circular Gasket|)
  !this.setDefaultStype(|GASK|, |GASK|, |OVAL|, |FlatOval Gasket|)
  !this.setDefaultStype(|SILE|, |SILE|, |RECT|, |Rectangular Silencer|)
  !this.setDefaultStype(|SILE|, |SILE|, |CIRC|, |Circular Silencer|)
  !this.setDefaultStype(|BATT|, |HB|, ||, |Heater|)
  !this.setDefaultStype(|HACC|, |ACCE|, |RECT|, |Access Panel/Door|)
  !this.setDefaultStype(|SPLR|, |ASPL|, |RECT|, |Splitter Plate|)
  !this.setDefaultStype(|TP|, |/$:AVEVAHVACSPEC$:/RTHOLE3|)
  !this.setDefaultStype(|TP|, |/$:AVEVAHVACSPEC$:/CTHOLE1|)
  !this.setDefaultStype(|MESH|, |MESH|, |RECT|, |Rectangular Mesh End|)
  !this.setDefaultStype(|MESH|, |MESH|, |CIRC|, |Circular Mesh End|)
  !this.setDefaultStype(|COWL|, |COWL|, |CIRC|, |Circular Cowl|)
  !this.setDefaultStype(|IDAM|, |SBD|, |CIRC|, |Circular Damper|)
  !this.setDefaultStype(|IDAM|, |SBD|, |RECT|, |Rectangular Damper|)
  !this.setDefaultStype(|SKIR|, |SKIR|, |RECT|, |Rectangular Weather Skirt|)
  !this.setDefaultStype(|THRE|, |STHR|, |RECT|, |Rectangular Threeway|)
  !this.setDefaultStype(|THRE|, |RTHR|, |CIRC|, |Circular Threeway|)
  !this.setDefaultStype(|GRIL|, |GRIN|, |RECT|, |Rectangular Grille/Diffuser|)
  !this.setDefaultStype(|GRIL|, |GRIN|, |CIRC|, |Circular Grille/Diffuser|)
  !this.setDefaultStype(|HFAN|, |AFAN|, |CIRC|, |Circular Fan|)
  !this.setDefaultStype(|PCOM|, |GENP|, ||, |Plant Item|)
  !this.setDefaultStype(|AHU|, |SAHU|, ||, |Rectangular Air Handling Unit|)
  !this.setDefaultStype(|TEE|, |CSBT|, |CIRC|, |Circular Side Branch Tee Piece|)

endmethod
-- End of method definition for loadDefaultStypes()

------------------------------------------------------------------------
--
-- Method:      setDefaultStype
--
-- Description:
--   Set default stype for a gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Word used for desparam 1 (compared with SCSTYP on build)
--    3   R      STRING      Duct shape
--    4   R      STRING      Description for type of fitting
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefaultStype(!gtype is STRING, !stype is STRING, !shape is STRING, !splt is STRING)

  -- Set default stype for a gtype
  do !i indices !this.table
    if (!this.table[!i][1] eq !gtype) then
      if (!this.table[!i][2] eq !stype) then
        if (!this.table[!i][3] eq !shape) then
          !this.table[!i][9] = TRUE
          break
        endif
      endif
    endif
  enddo

endmethod
-- End of method definition for setDefaultStype(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setDefaultStype
--
-- Description:
--   Set default stype for a gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Spref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefaultStype(!gtype is STRING, !spref is STRING)

  -- Set default stype for a gtype
  do !i indices !this.table
    if (!this.table[!i][1] eq !gtype) then
      if (!this.table[!i][4] eq !spref) then
        !this.table[!i][9] = TRUE
        break
      endif
    endif
  enddo

endmethod
-- End of method definition for setDefaultStype(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      printStypes
--
-- Description:
--   Write out rows for edit to set defaults and paste back into method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .printStypes()

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Write out rows for edit to set defaults and paste back into method
  !file = object FILE('hvacSelectors.txt')
  !lines = ARRAY()
  do !i ind !this.table
    !gtype = !this.table[!i][1]
    !stype = !this.table[!i][2]
    !shape = !this.table[!i][3]
    !spref = !this.table[!i][4]
    !splt  = !this.table[!i][8]
    if (!gtype inset('TUBE','STIF','TP')) then
      !row = '  !this.setDefaultStype(|' & !gtype & '|, |' & !spref & '|)'
    else
      !row = '  !this.setDefaultStype(|' & !gtype & '|, |' & !stype & '|, |' & !shape & '|, |' & !splt & '|)'
    endif
    !lines.append(!row)
  enddo
  !file.writefile('OVERWRITE', !lines)

endmethod
-- End of method definition for .printStypes()

------------------------------------------------------------------------
--
-- Method:      writeXMLFile
--
-- Description:
--   Write out lookup table to XML file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .writeXMLFile()

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Write out lookup table to XML file
  !file = object FILE(|%pdmsuser%\HVACStypeTable.xml|)
  !lines = ARRAY()
  !lines.append(|<?xml version="1.0" encoding="utf-8" ?>|)
  !lines.append(|<HVACStypeTable xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">|)
  !lines.append(|  <HVACStypes>|)
  do !i ind !this.table
    !gtype   = !this.table[!i][1]
    !code1   = !this.table[!i][2]
    !shape   = !this.table[!i][3]
    !spref   = !this.table[!i][4]
    !stype   = !this.table[!i][5]
    !code66  = !this.table[!i][6]
    !code67  = !this.table[!i][7]
    !splt    = !this.table[!i][8]
    !default = !this.table[!i][9]
    !row = |    <HVACStype gtype="| & !gtype & |" scstype="| & !code1 & |" shape="| & !shape & |" spref="| & !spref & |" stype="| & !stype & |" data66="| & !code66 & |" data67="| & !code67 & |" description="| & !splt & |" isdefault="| & !default.string().lowcase() & |" />|
    !lines.append(!row)
  enddo
  !lines.append(|  </HVACStypes>|)
  !lines.append(|</HVACStypeTable>|)
  !file.writefile('OVERWRITE', !lines)

endmethod
-- End of method definition for .writeXMLFile()

------------------------------------------------------------------------
--
-- Method:      createLookup
--
-- Description:
--   Create new lookup table XML file from source data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .createLookup()

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Create new lookup table XML file from source data
  !this.loadTableFromSource()
  !this.loadDefaultStypes()
  !this.writeXMLFile()

endmethod
-- End of method definition for .createLookup()

------------------------------------------------------------------------
--
-- Method:      findXMLFile
--
-- Description:
--   Find lookup table XML file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    FILE        File object for XML file
--
------------------------------------------------------------------------

-- Define method
define method .findXMLFile() is FILE

  -- Find XML file
  var !proj project code
  !folder = |%| & !proj.lowcase() & |dflts%\ModelManagement|
  !file = object FILE(!folder & |\HVACStypeTable.xml|)
  if (!file.exists().not()) then
    !file = object FILE(|%pdmsexe%\HVACStypeTable.xml|)
    if (!file.exists().not()) then
      return error 1 |Cannot find file HVACStypeTable.xml in $!folder or %pdmsexe%|
    endif
  endif
  return !file

endmethod
-- End of method definition for .findXMLFile() is FILE

------------------------------------------------------------------------
--
-- Method:      readXMLFile
--
-- Description:
--   Read in lookup table from XML file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for XML file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .readXMLFile(!file is FILE)

  -- This method is not normally called and is used only if the XML file is to be regenerated

  -- Read in file
  !this.table.clear()
  !data  = ARRAY()
  !lines = !file.readfile()
  do !row values !lines
    skip if (!row.trim().substring(1,11) ne |<HVACStype |)
    !data[1] = !row.after(|gtype="|).before(|"|)
    !data[2] = !row.after(|scstype="|).before(|"|)
    !data[3] = !row.after(|shape="|).before(|"|)
    !data[4] = !row.after(|spref="|).before(|"|)
    !data[5] = !row.after(|stype="|).before(|"|)
    !data[6] = !row.after(|data66="|).before(|"|)
    !data[7] = !row.after(|data67="|).before(|"|)
    !data[8] = !row.after(|description="|).before(|"|)
    !data[9] = !row.after(|isdefault="|).before(|"|).boolean()
    !this.table.append(!data)
  enddo

endmethod
-- End of method definition for .readXMLFile(FILE)

------------------------------------------------------------------------
--
-- Method:      gtypes
--
-- Description:
--   Return gtypes from lookup table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Gtypes
--
------------------------------------------------------------------------

-- Define method
define method .gtypes() is ARRAY

  using namespace 'Aveva.Pdms.MMServices'

  -- Return sorted unique list of gtypes
  !gtypes = ARRAY()
  !hvacTable = object HVACSTYPETABLE()
  !hvacStypes = !hvacTable.stypes()
  handle any
    return error 1 |Integrator HVAC stypes table is not available|
  endhandle
  do !hvacStype values !hvacStypes
    !gtypes.append(!hvacStype.gtype())
  enddo
  !gtypes.sort()
  !gtypes.unique()
  return !gtypes

endmethod
-- End of method definition for .gtypes()

------------------------------------------------------------------------
--
-- Method:      stypesForGtype
--
-- Description:
--   Return stypes for given gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
-- Return:
--   [Data Type] [Description]
--    ARRAY       Stypes, shapes and descriptions 2D array
--
------------------------------------------------------------------------

-- Define method
define method .stypesForGtype(!gtype is STRING) is ARRAY

  using namespace 'Aveva.Pdms.MMServices'

  -- Return stypes, descriptions and whether defaults for a given gtype
  !stypes = ARRAY()
  !hvacTable = object HVACSTYPETABLE()
  !hvacStypes = !hvacTable.stypesForGtype(!gtype)
  handle any
    return error 1 |Integrator HVAC stypes table is not available|
  endhandle
  do !hvacStype values !hvacStypes
    !stype = ARRAY()
    if (!hvacStype.isDefault()) then
      !stype[1] = |Default|
    else
      !stype[1] = ||
    endif
    !stype[2] = !hvacStype.scstype()
    !stype[3] = !hvacStype.shape()
    !stype[4] = !hvacStype.description()
    handle (2,779)
      -- Method not found
      !stype[4] = ||
    endhandle
    !stypes.append(!stype)
  enddo
  return !stypes

endmethod
-- End of method definition for .stypesForGtype()

------------------------------------------------------------------------
--
-- Method:      stypesForGtypeAndShape
--
-- Description:
--   Return stypes for given gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--    ARRAY       Stypes and descriptions 2D array
--
------------------------------------------------------------------------

-- Define method
define method .stypesForGtypeAndShape(!gtype is STRING, !shape is STRING) is ARRAY

  using namespace 'Aveva.Pdms.MMServices'

  -- Return stypes, descriptions and whether defaults for a given gtype and shape
  !stypes = ARRAY()
  !hvacTable = object HVACSTYPETABLE()
  !hvacStypes = !hvacTable.stypesForGtypeAndShape(!gtype, !shape)
  handle any
    return error 1 |Integrator HVAC stypes table is not available|
  endhandle
  do !hvacStype values !hvacStypes
    !stype = ARRAY()
    if (!hvacStype.isDefault()) then
      !stype[1] = |Default|
    else
      !stype[1] = ||
    endif
    !stype[2] = !hvacStype.scstype()
    !stype[3] = !hvacStype.description()
    !stypes.append(!stype)
  enddo
  return !stypes

endmethod
-- End of method definition for .stypesForGtypeAndShape()

------------------------------------------------------------------------
--
-- Method:      defaultStype
--
-- Description:
--   Return default stype for given gtype
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gtype
--    2   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--    STRING      Default Stype
--
------------------------------------------------------------------------

-- Define method
define method .defaultStype(!gtype is STRING, !shape is STRING) is STRING

  using namespace 'Aveva.Pdms.MMServices'

  -- Return default stype for a given gtype
  !code = ||
  !hvacTable = object HVACSTYPETABLE()
  !hvacStype = !hvacTable.defaultStype(!gtype, !shape)
  handle any
    -- No value returned
  elsehandle none
    if (!hvacStype.set()) then
      !code = !hvacStype.scstype()
    endif
  endhandle
  return !code

endmethod
-- End of method definition for .defaultStype()

------------------------------------------------------------------------
--
-- Method:      selectComp
--
-- Description:
--   Select HVAC component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectComp()

  if (!!integratorSupportHandler.debug) then
    write 'integratorHvac.selectComp()'
  endif

  -- Initialise design parameters
  do !i to 90
    var !desparam desparam numb $!i
    if (!desparam eq |unset|) then
      desparam numb $!i 0
    endif
  enddo

  -- Set duct shape (arri and leav indexes here are used as 1 and 2 for setting design parameters)
  !conArri = !this.ductShape(1)
  !conLeav = !this.ductShape(2)
  if (!!ce.type eq |TRNS|) then
    !ductShape = !this.trnsShape(!conArri, !conLeav)
    desparam numb 30 TRAN
    desparam numb 40 TRAN
    if (!ductShape ne ||) then
      desparam numb 1 $!ductShape
    endif
  else
    !ductShape = !conArri
    if (!conArri.trim() ne ||) then
      desparam numb 40 $!conArri
    endif
  endif

  -- Set duct width and height
  !widArri = !!ce.schlnk.widarray[1]
  !widLeav = !!ce.schlnk.widarray[2]
  ddesparam numb 2  $!widArri
  ddesparam numb 4  $!widLeav
  if (!conArri ne |CIRC|) then
    !heiArri = !!ce.schlnk.heiarray[1]
    ddesparam numb 3 $!heiArri
  else
    !heiArri = object BORE(0)
    desparam numb 3 DIAM
  endif
  if (!conLeav ne |CIRC|) then
    !heiLeav = !!ce.schlnk.heiarray[2]
    ddesparam numb 5 $!heiLeav
  else
    !heiLeav = object BORE(0)
    desparam numb 5 DIAM
  endif
  if (!!integratorSupportHandler.debug) then
    !output1 = 'P1: ' & !conArri & ' ' & !widArri & ' x ' & !heiArri
    !output2 = 'P2: ' & !conLeav & ' ' & !widLeav & ' x ' & !heiLeav
    write !output1 !output2
  endif

  -- Set a default length and end conditions
  ddesparam numb 6 500
  desparam numb 58 RE
  desparam numb 59 RE
  desparam numb 68 0
  desparam numb 69 0

  -- Check for branching component
  if (!!ce.schlnk.conarray.size() gt 2) then
    !conOffLeg = !this.ductShape(3)
    if (!conOffLeg ne ||) then
      desparam numb 30 $!conOffLeg
      desparam numb 60 RE
      desparam numb 70 0
    endif
    !widOffLeg = !!ce.schlnk.widarray[3]
    handle any
      !widOffLeg = object BORE(0)
    endhandle
    desparam numb 41 $!widOffLeg
    if (!conOffLeg ne |CIRC|) then
      !heiOffLeg = !!ce.schlnk.heiarray[3]
      handle any
        !heiOffLeg = object BORE(0)
      endhandle
      desparam numb 42 $!heiOffLeg
    else
      !heiOffLeg = object BORE(0)
      desparam numb 42 0
    endif
    if (!!integratorSupportHandler.debug) then
      !output = 'P3: ' & !conOffLeg & ' ' & !widOffLeg & ' x ' & !heiOffLeg
      write !output
    endif
  endif

  -- Set branch details based on first component using schematic component arrive value
  if (!!ce.sequ eq 1) then
    !this.setHstu(!conArri)
    if (!!ce.schlnk.arri eq 1) then
      !this.setBranchSize(!widArri, !heiArri, !conArri)
    else
      !this.setBranchSize(!widLeav, !heiLeav, !conLeav)
    endif
  endif

  -- Set spref and lstu
  !this.setSpre(!ductShape)
  !this.setLstu(!conLeav)

  -- Get working size to see if flip required
  if (!!ce.sequ eq 1) then
    -- Details from head
    !conPrev = !!ce.owner.hcon
    !widPrev = !!ce.owner.:HXYsize[1]
    handle any
      !widPrev = object BORE(0)
    endhandle
    !heiPrev = !!ce.owner.:HXYsize[2]
    handle any
      !heiPrev = object BORE(0)
    endhandle
  else
    -- Details from previous member
    !sizePrev = !this.compSize(!!ce.owner.members[!!ce.sequ - 1])
    !conPrev  = !sizePrev[4]
    !widPrev  = !sizePrev[5]
    !heiPrev  = !sizePrev[6]
  endif
  if (!widPrev.unset()) then
    !widPrev = object BORE(0)
  endif
  if (!heiPrev.unset()) then
    !heiPrev = object BORE(0)
  endif

  -- Flip component
  !arriveDoesNotMatch = (!conArri ne !conPrev or  !widArri ne !widPrev or  !heiArri ne !heiPrev)
  !leaveDoesMatch     = (!conLeav eq !conPrev and !widLeav eq !widPrev and !heiLeav eq !heiPrev)
  if (!arriveDoesNotMatch and !leaveDoesMatch) then
    if (!!integratorSupportHandler.debug) then
      write 'Flip HVAC component'
    endif
    FLIP
  endif

endmethod
-- End of method definition for selectComp()

------------------------------------------------------------------------
--
-- Method:      trnsShape
--
-- Description:
--   Return shape code for transition piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ppoint1 shape
--    2   R      STRING      Ppoint2 shape
-- Return:
--   [Data Type] [Description]
--    STRING      Shape code
--
------------------------------------------------------------------------
define method .trnsShape(!conArri is STRING, !conLeav is STRING) is STRING

  -- Get duct shape code (arri and leav indexes here are used 1 and 2)
  if (!conArri eq |RECT| and !conLeav eq |CIRC|) then
    !ductShape = |SQRD|
  elseif (!conArri eq |RECT| and !conLeav eq |OVAL|) then
    !ductShape = |SQFO|
  elseif (!conArri eq |OVAL| and !conLeav eq |CIRC|) then
    !ductShape = |FORD|
  elseif (!conArri eq |OVAL| and !conLeav eq |OVAL|) then
    !ductShape = |FOFO|
  else
    !ductShape = ||
  endif
  return !ductShape

endmethod
-- End of method definition for trnsShape(STRING, STRING) is STRING

-----------------------------------------------------------------------
--
-- Method:      ductShape
--
-- Description:
--   Check duct shape is legal for current linked 3D element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Ppoint
-- Return:
--   [Data Type] [Description]
--    STRING      Modified shape
--
------------------------------------------------------------------------
define method .ductShape(!ppoint is REAL) is STRING

  -- Check duct shape is legal
  return !this.ductShape(!!ce.schlnk, !ppoint)

endmethod
-- End of method definition for ductShape(REAL) is STRING

-----------------------------------------------------------------------
--
-- Method:      ductShape
--
-- Description:
--   Check duct shape is legal
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Schematic HVAC fitting
--    2   R      REAL        Ppoint
-- Return:
--   [Data Type] [Description]
--    STRING      Modified shape
--
------------------------------------------------------------------------
define method .ductShape(!element is DBREF, !ppoint is REAL) is STRING

  -- Check duct shape is legal
  !shape = ||
  !conn = !element.conarray[!ppoint]
  handle any
    !conn = STRING()
  endhandle
  if (!conn.unset()) then
    !output = 'Duct shape unset for ppoint ' & !ppoint & ' of ' & !element.flnm
    write !output
  elseif (!conn inset(|RECT|, |OVAL|, |CIRC|)) then
      !shape = !conn
  else
    !output = 'Illegal duct shape ' & !conn & ' for ppoint ' & !ppoint & ' of ' & !element.flnm
    write !output
  endif
  return !shape

endmethod
-- End of method definition for ductShape(DBREF, REAL) is STRING

------------------------------------------------------------------------
--
-- Method:      setSpre
--
-- Description:
--   Set spref for current gtype and scstyp and given shape
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSpre(!ductShape is STRING)

  using namespace 'Aveva.Pdms.MMServices'

  -- Transition piece has its shape code as stype
  if (!!ce.type eq |TRNS|) then
    !code1 = !ductShape
    !shape = ||
  else
    -- Check for default stype
    !code1 = !!ce.schlnk.scstyp
    !shape = !ductShape
    if (!code1.trim() eq ||) then
      !code1 = !this.defaultStype(!!ce.type, !shape)
    endif
  endif

  -- Find matching row, allowing for default selection
  !hvacTable = object HVACSTYPETABLE()
  !hvacStypes = !hvacTable.stypesForGtypeAndShape(!!ce.type, !shape)
  handle any
    if (!this.tableMessage.not()) then
      if (istty) then
        write 'Components not selected from spec: HVAC stype table is not available'
      else
        !!alert.warning(|Components not selected from spec: HVAC stype table is not available|)
      endif
      !this.tableMessage = TRUE
    endif
  elsehandle none
    do !hvacStype values !hvacStypes
      if (!hvacStype.scstype() eq !code1 or !code1 eq ||) then
        if (!!ce.spre.unset()) then
          -- Component not already selected
          !spref = !hvacStype.spref()
          if (!!exists(!spref, |SPCO|, ||)) then
            SPREF $!spref
          endif
        endif
        -- Set remaining lookup data
        if (!code1.trim() ne ||) then
          desparam numb 1 $!code1
        endif
        !data66 = !hvacStype.data66()
        if (!data66.trim() ne ||) then
          desparam numb 66 $!data66
        endif
        !data67 = !hvacStype.data67()
        if (!data67.trim() ne ||) then
          desparam numb 67 $!data67
        endif
        break
      endif
    enddo
  endhandle

endmethod
-- End of method definition for setSpre()

------------------------------------------------------------------------
--
-- Method:      setLstu
--
-- Description:
--   Set lstu on HVAC comp
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLstu(!shape is STRING)

  -- Set lstu
  !lstu = ||
  if (!shape eq |RECT|) then
    if (!!ce.type inset(|ELBO|,|BEND|)) then
      -- Elbows and bends should use the alternative tube orientation
      !lstu = |/$:AVEVAHVACSPEC$:/RTUBEA|
    else
      !lstu = |/$:AVEVAHVACSPEC$:/RTUBEB|
    endif
  elseif (!shape eq |CIRC|) then
    !lstu = |/$:AVEVAHVACSPEC$:/CTUBE|
  elseif (!shape eq |OVAL|) then
    if (!!ce.type inset(|ELBO|,|BEND|)) then
      -- Elbows and bends should use the alternative tube orientation
      !lstu = |/$:AVEVAHVACSPEC$:/FOTUBEA|
    else
      !lstu = |/$:AVEVAHVACSPEC$:/FOTUBEB|
    endif
  endif
  if (!lstu.length() gt 0) then
    if (!!exists(!lstu, |SPCO|, ||)) then
      lstube $!lstu
    endif
  endif

endmethod
-- End of method definition for setLstu()

------------------------------------------------------------------------
--
-- Method:      setHstu
--
-- Description:
--   Set hstu on HVAC branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHstu(!shape is STRING)

  -- Store db position
  !dbpos = !!ce
  if (!!ce.owner.type eq |BRAN|) then
    !bran = !!ce.owner
  else
    !bran = !!ce
  endif
  !hvac = !bran.owner

  -- Check availability of HVAC spec
  !specExists = !!exists(|/$:AVEVAHVACSPEC$:|, |SPEC|, ||)
  if (!this.specMessage.not()) then
    if (not !specExists) then
      if (istty) then
        write(|Spec /$:AVEVAHVACSPEC$: not found|)
      else
        !!alert.warning(|Spec /$:AVEVAHVACSPEC$: not found|)
      endif
    endif
    !this.specMessage = TRUE
  endif

  -- Set specs
  !!ce = !hvac
  if (!specExists) then
    PSPE /$:AVEVAHVACSPEC$:
  endif
  !!ce = !bran
  if (!specExists) then
    PSPE /$:AVEVAHVACSPEC$:
  endif

  -- Set hstu
  !hstu = ||
  if (!shape eq |RECT|) then
    !hstu = |/$:AVEVAHVACSPEC$:/HRTUBEB|
  elseif (!shape eq |CIRC|) then
    !hstu = |/$:AVEVAHVACSPEC$:/HCTUBE|
  elseif (!shape eq |OVAL|) then
    !hstu = |/$:AVEVAHVACSPEC$:/HFOTUBEB|
  endif
  if (!hstu.length() gt 0) then
    if (!!exists(!hstu, |SPCO|, ||)) then
      hstube $!hstu
    endif
  endif

  -- Restore db position
  !!ce = !dbpos

endmethod
-- End of method definition for setHstu()

------------------------------------------------------------------------
--
-- Method:      setHstu
--
-- Description:
--   Set hstu on HVAC branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ref of SCHVAC
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHstu(!ref is DBREF)

  -- Set HSTU from SCHVAC duct shape
  if (!ref.type eq |SCHVAC|) then
    !this.setHstu(!ref.ductShape)
  endif

endmethod
-- End of method definition for setHstu()

------------------------------------------------------------------------
--
-- Method:      setBranchSize
--
-- Description:
--   Set sizes on HVAC branch explicitly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BORE        Duct width
--    2   R      BORE        Duct height
--    3   R      STRING      Duct shape
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBranchSize(!ductWidth is BORE, !ductHeight is BORE, !ductShape is STRING)

  -- Store db position
  if (!!integratorSupportHandler.debug) then
    !output = 'integratorHvac.setBranchSize(' & !ductWidth & ', ' & !ductHeight & ', ' & !ductShape & ')'
    write !output
  endif
  !dbpos = !!ce
  if (!!ce.owner.type eq |BRAN|) then
    !bran = !!ce.owner
  else
    !bran = !!ce
  endif

  -- Set sizes and shape
  !!ce = !bran
  if (!ductWidth.set() and !ductHeight.set()) then
    if (!ductWidth gt 0 and !ductHeight gt 0) then
      :HXYsize $!ductWidth $!ductHeight
      handle (99,532)
        -- Undefined UDA
        if (!this.udaMessage.not()) then
          if (istty) then
            write 'UDA definition :HXYsize not found'
          else
            !!alert.warning(|UDA definition :HXYsize not found|)
          endif
          !this.udaMessage = TRUE
        endif
      endhandle
      !hbor = !ductWidth.real() + !ductHeight.real()
      HBOR $!hbor
    endif
  endif
  if (!ductShape.set()) then
    if (!ductShape inset(|RECT|,|CIRC|,|OVAL|)) then
      HCON $!ductShape
    endif
  endif

  -- Restore db position
  !!ce = !dbpos

endmethod
-- End of method definition for setBranchSize()

------------------------------------------------------------------------
--
-- Method:      setBranchSize
--
-- Description:
--   Set sizes on HVAC branch from reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Href
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBranchSize(!ref is DBREF)

  -- Get size from href
  if (!!integratorSupportHandler.debug) then
    !output = 'integratorHvac.setBranchSize(' & !ref.flnm & ')'
    write !output
  endif
  if (!ref.set()) then
    if (!ref.badref().not()) then

      -- Taking data from SCHVAC
      if (!ref.type eq |SCHVAC|) then
        !this.setBranchSize(!ref.ductWidth, !ref.ductHeight, !ref.ductShape)

      -- Connected to nozzle
      elseif (!ref.type eq |NOZZ|) then
        !nozz = object INTEGRATORNOZZLE(!ref)
        if (!nozz.ductWidth.real() gt 0) then
          !this.setBranchSize(!nozz.ductWidth, !nozz.ductHeight, !nozz.ductShape)
        endif

      -- Connected to fitting
      elseif (!ref.owner.type eq |BRAN|) then
        !sizeRef    = !this.compSize(!ref)
        !ductShape  = !sizeRef[7]
        !ductWidth  = !sizeRef[8]
        !ductHeight = !sizeRef[9]
        if (!ductWidth.real() gt 0) then
          !this.setBranchSize(!ductWidth, !ductHeight, !ductShape)
        endif

      endif
    endif
  endif

endmethod
-- End of method definition for setBranchSize()

------------------------------------------------------------------------
--
-- Method:      setDesignCode
--
-- Description:
--   Set sizes on HVAC branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDesignCode()

  -- Set design code
  !dsco = 'MODELONLY'
  DSCO '$!dsco'

endmethod
-- End of method definition for setDesignCode()

------------------------------------------------------------------------
--
-- Method:      compSize
--
-- Description:
--   Return size for HVAC branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Branch
-- Return:
--   [Data Type] [Description]
--    ARRAY       9 elements: Arrive shape, width, height, Leave same, OffLeg same
--
------------------------------------------------------------------------
define method .compSize(!comp is DBREF) is ARRAY

  -- Get shapes
  !conArri = !comp.wdesp[40]
  handle any
    !conArri = ||
  endhandle
  !conLeav = !comp.wdesp[40]
  handle any
    !conLeav = ||
  endhandle
  if (!conArri eq |TRAN|) then
    !transition = !comp.wdesp[1]
    handle any
      !transition = ||
    endhandle
    if (!transition eq |SQRD|) then
      if (!comp.arri eq 1) then
        !conArri = |RECT|
        !conLeav = |CIRC|
      else
        !conArri = |CIRC|
        !conLeav = |RECT|
      endif
    elseif (!transition eq |SQFO|) then
      if (!comp.arri eq 1) then
        !conArri = |RECT|
        !conLeav = |OVAL|
      else
        !conArri = |OVAL|
        !conLeav = |RECT|
      endif
    elseif (!transition eq |FORD|) then
      if (!comp.arri eq 1) then
        !conArri = |OVAL|
        !conLeav = |CIRC|
      else
        !conArri = |CIRC|
        !conLeav = |OVAL|
      endif
    elseif (!transition eq |FOFO|) then
      !conArri = |OVAL|
      !conLeav = |OVAL|
    endif
  endif

  -- Get widths and heights
  if (!comp.arri eq 1) then
    !paramWidArri = 2
    !paramHeiArri = 3
    !paramWidLeav = 4
    !paramHeiLeav = 5
  else
    !paramWidArri = 4
    !paramHeiArri = 5
    !paramWidLeav = 2
    !paramHeiLeav = 3
  endif
  !widArri = object BORE(!comp.desp[!paramWidArri])
  handle any
    !widArri = object BORE(0)
  endhandle
  !heiArri = object BORE(!comp.desp[!paramHeiArri])
  handle any
    !heiArri = object BORE(0)
  endhandle
  !widLeav = object BORE(!comp.desp[!paramWidLeav])
  handle any
    !widLeav = object BORE(0)
  endhandle
  !heiLeav = object BORE(!comp.desp[!paramHeiLeav])
  handle any
    !heiLeav = object BORE(0)
  endhandle

  -- Check for word DIAM
  !wHeiArri = !comp.wdesp[!paramHeiArri]
  handle any
  elsehandle none
    if (!wHeiArri eq |DIAM|) then
      !heiArri = object BORE(0)
    endif
  endhandle
  !wHeiLeav = !comp.wdesp[!paramHeiLeav]
  handle any
  elsehandle none
    if (!wHeiLeav eq |DIAM|) then
      !heiLeav = object BORE(0)
    endif
  endhandle

  -- Get P3 size and shape
  !conOffLeg = !comp.ppco[3]
  handle any
    !conOffLeg = ||
    !widOffLeg = object BORE(0)
    !heiOffLeg = object BORE(0)
  elsehandle none
    !conOffLeg = !comp.wdesp[30]
    handle any
      !conOffLeg = ||
    endhandle
    !widOffLeg = object BORE(!comp.desp[41])
    handle any
      !widOffLeg = object BORE(0)
    endhandle
    !heiOffLeg = object BORE(!comp.desp[42])
    handle any
      !heiOffLeg = object BORE(0)
    endhandle
    !wheiOffLeg = !comp.wdesp[42]
    handle any
    elsehandle none
      if (!wheiOffLeg eq |DIAM|) then
        !heiOffLeg = object BORE(0)
      endif
    endhandle
    -- Branch connector has arrive/leave and offleg shapes reversed as takes desp[30] from main line
    if (!comp.type eq |BRCO|) then
      !conTemp   = !conArri
      !conArri   = !conOffLeg
      !conLeav   = !conOffLeg
      !conOffLeg = !conTemp
    endif
  endhandle

  -- Results
  !shape = ARRAY()
  !shape[1] = !conArri
  !shape[2] = !widArri
  !shape[3] = !heiArri
  !shape[4] = !conLeav
  !shape[5] = !widLeav
  !shape[6] = !heiLeav
  !shape[7] = !conOffLeg
  !shape[8] = !widOffLeg
  !shape[9] = !heiOffLeg
  return !shape

endmethod
-- End of method definition for compSize()

------------------------------------------------------------------------
--
-- Method:      branchSize
--
-- Description:
--   Return size for HVAC branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Branch
--    2   R      STRING      HEAD or TAIL
-- Return:
--   [Data Type] [Description]
--    STRING      Size string
--
------------------------------------------------------------------------
define method .branchSize(!branch is DBREF, !headOrTail is STRING) is STRING

  -- Get size string
  if (!branch.owner.type eq |PIPE|) then
    if (!headOrTail eq |HEAD|) then
      !bore = !branch.hbor
    else
      !bore = !branch.tbor
    endif
    return !bore.string(!!boreFmt)
  elseif (!branch.owner.type eq |HVAC|) then
    if (!headOrTail eq |HEAD|) then
      !element = !branch.members[1]
      handle any
        return |unset|
      endhandle
      !pp = !element.arrive
    else
      !element = !branch.members.last()
      handle any
        return |unset|
      endhandle
      !pp = !element.leave
    endif
    !shape = !element.schlnk.conarray[!pp]
    handle any
      return |unset|
    endhandle
    !size = !shape  & | | & !element.schlnk.widarray[!pp].string(!!boreFmt)
    handle any
      return |unset|
    endhandle
    if (!shape eq |CIRC|) then
      return !size
    else
      !size = !size & | x | & !element.schlnk.heiarray[!pp].string(!!boreFmt)
      handle any
        return |unset|
      endhandle
      return !size
    endif
  endif

endmethod
-- End of method definition for branchSize()

------------------------------------------------------------------------
--
-- Method:      copyHvacSize
--
-- Description:
--   Copy size of HVAC component from 2D to 3D
--
-- Method Type: Function/Procedure
-- Arguments:
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to 2D element]
-- !args[1] [R]    [STRING]   [reference to 3D element]
-- !args[2] [R]    [STRING]   [ppoint]
-- !args[3] [R]    [STRING]   [new size, e.g. RECT 200mm x 300mm, or blank if 2D element data to be used]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyHvacSize(!args is ARRAY)

  -- Initialise
  !d2Ele   = !args[0].dbref()
  !d3Ele   = !args[1].dbref()
  !ppoint  = !args[2]
  !newSize = !args[3]
  if (!!integratorSupportHandler.debug) then
    !output = 'integratorHvac.copyHvacSize(' & !d2Ele.flnm & ', ' & !d3Ele.flnm & ', ' & !ppoint & ', ' & !newSize & ')'
    write !output
    !!integratorSupportHandler.isRefNo('integratorHvac.copyHvacSize', !args[0])
    !!integratorSupportHandler.isRefNo('integratorHvac.copyHvacSize', !args[1])
  endif

  -- Check ppoint
  if (!ppoint lt 1 or !ppoint gt 3) then
    return error 1 |integratorHvac.copyHvacSize: Invalid ppoint number|
  endif
  !shapeParam  = !this.shapeParams[!ppoint]
  !widthParam  = !this.widthParams[!ppoint]
  !heightParam = !this.heightParams[!ppoint]

  -- Check size
  !newWidth  = object BORE(0)
  !newHeight = object BORE(0)
  if (!newSize.trim() eq ||) then
    -- New size blank so use schematic data
    if (!d2Ele.gtyp eq |THRE| and !d3Ele.type eq |BRCO|) then
      !ppoint = 3
    endif
    !newShape = !this.ductShape(!d2Ele, !ppoint)
    !newWidth  = !d2Ele.widarray[!ppoint]
    handle any
    endhandle
    if (!newShape ne |CIRC|) then
      !newHeight = !d2Ele.heiarray[!ppoint]
      handle any
      endhandle
    endif
  else
    -- New size specified as argument
    !newShape = !newSize.part(1)
    if (not !newShape inset(|RECT|,|OVAL|,|CIRC|)) then
      return error 1 |integratorHvac.copyHvacSize: Invalid duct shape|
    endif
    !newWidth  = object BORE(object REAL(!newSize.part(2), !!boreFmt))
    if (!newShape ne |CIRC|) then
      !newHeight = object BORE(object REAL(!newSize.part(4), !!boreFmt))
      handle any
      endhandle
    endif
  endif

  -- Set duct shape
  !!ce = !d3Ele
  if (!!ce.type eq |TRNS|) then
    if (!ppoint eq 1 or !ppoint eq 2) then
      !currentSize = !this.compSize(!!ce)
      if (!!ce.arri eq 1) then
        !arriveShape = 1
        !leaveShape  = 4
      else
        !arriveShape = 4
        !leaveShape  = 1
      endif
      if (!ppoint eq 1) then
        !conArri = !newShape
        !conLeav = !currentSize[!leaveShape]
      elseif (!ppoint eq 2) then
        !conArri = !currentSize[!arriveShape]
        !conLeav = !newShape
      endif
      !ductShape = !this.trnsShape(!conArri, !conLeav)
      desparam numb 30 TRAN
      desparam numb 40 TRAN
      if (!ductShape ne ||) then
        desparam numb  1 $!ductShape
        desparam numb 67 $!ductShape
      endif
    endif
  else
    if (!newShape.trim() ne ||) then
      desparam numb $!shapeParam $!newShape
    endif
  endif

  -- Set duct width and height
  ddesparam numb $!widthParam $!newWidth
  if (!newShape ne |CIRC|) then
    ddesparam numb $!heightParam $!newHeight
  else
    if (!ppoint eq 3) then
      desparam numb $!heightParam 0
    else
      desparam numb $!heightParam DIAM
    endif
  endif

endmethod
-- End of method definition for copyHvacSize()
