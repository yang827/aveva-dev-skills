import 'IntegratorAddin'
handle any
endhandle
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            IntegratorInit.pmlobj
--   Type:          Object Definition
--   Group:         Integrator
--
--   Keyword:       Integrator
--   Module:        Design
--   Replaces:
--
-- Author:          Mac Lewis
-- Created:         Wed Aug 1    13:40:01  2007
--
--
-- Description:
-- Integrator helper object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  globalInstance()                 -                   Create global instance of object
--  integratorInit()                 -                   Constructor
--  integratorInit(BOOLEAN)          -                   Constructor with startup flag
--  startUp()                        -                   Start the Integrator
--  startUp(ARRAY)                   -                   Start the Integrator from event which has array argument
--
------------------------------------------------------------------------
define object INTEGRATORINIT

  member .showHandle           is REAL

endobject
-- End of object definition for INTEGRATORINIT

------------------------------------------------------------------------
--
-- Method:      integratorInit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .integratorInit()

  using namespace 'Aveva.Pdms.IntegratorAddin'

  -- (Re)Setup global IntegratorStarter
  !!integratorStarter = object INTEGRATORINITIALISER()
  handle any
  endhandle

  -- (Re)Setup global IntegratorInit
  !this.globalInstance()
  !this.showHandle = !!integratorStarter.addEventHandler('StartUp', !!integratorInit, 'startUp')
  handle any
  endhandle

endmethod
-- End of method definition for integratorInit

------------------------------------------------------------------------
--
-- Method:      integratorInit
--
-- Description:
--   Constructor with startup flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .integratorInit(!dummyStartUp is BOOLEAN)

  -- Default constructor
  !this.integratorInit()

  -- Startup Integrator
  !this.startUp()

endmethod
-- End of method definition for IntegratorInit(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!integratorInit = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      startUp
--
-- Description:
--   Start the Integrator
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Empty array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .startUp()

  -- (Re)Initialise the support handler which initialises everything else
  !!comDefineGlobal(object INTEGRATORSUPPORTHANDLER())

endmethod
-- End of method definition for .startUp()

------------------------------------------------------------------------
--
-- Method:      startUp
--
-- Description:
--   Start the Integrator from event which has array argument
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Empty array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .startUp(!dummyArgs is ARRAY)

  -- Start the Integrator
  !this.startUp()

endmethod
-- End of method definition for .startUp(ARRAY)
