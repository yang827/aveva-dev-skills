--   Module:        Design
--   Replaces:
--
-- Author:          Mac Lewis
-- Created:         Thu Sep 20    11:40:01  2007
--
--
-- Description:
-- Integrator nozzle or elconn object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  defaultHvacNozzle()              -                   Set default design parameters on HVAC nozzle
--  integratorNozzle(DBREF)          -                   Constructor
--  setDuctSize()                    -                   Copy duct shape and size from schematic nozzle to nozzle
--  sizeTest(DBREF)                  BOOLEAN             Check if passed 3D nozzle matches this schematic nozzle in size
--
------------------------------------------------------------------------
define object INTEGRATORNOZZLE

  member .element           is DBREF
  member .linkedElement     is DBREF
  member .isSchematic       is BOOLEAN
  member .isHVAC            is BOOLEAN
  member .isPiping          is BOOLEAN
  member .isElectrical      is BOOLEAN
  member .ductShape         is STRING
  member .ductWidth         is BORE
  member .ductHeight        is BORE
  member .bore              is BORE
  member .sizeString        is STRING
  member .specAnsw          is STRING
  member .linkString        is STRING
  member .crefString        is STRING

endobject
-- End of object definition for INTEGRATORNOZZLE

------------------------------------------------------------------------
--
-- Method:      integratorNozzle
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Scnozz or Nozz
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .integratorNozzle(!element is DBREF)

  -- Clear object data
  !this.element       = object DBREF()
  !this.linkedElement = object DBREF()
  !this.isSchematic   = FALSE
  !this.isHVAC        = FALSE
  !this.isPiping      = FALSE
  !this.isElectrical  = FALSE
  !this.ductShape     = ||
  !this.ductWidth     = object BORE()
  !this.ductHeight    = object BORE()
  !this.bore          = object BORE()
  !this.sizeString    = ||
  !this.specAnsw      = ||
  !this.linkString    = ||
  !this.crefString    = ||

  -- Check ref and type
  if (!element.unset()) then
    return
  endif
  if (not !element.type inset(|SCNOZZ|, |NOZZ|, |SCELCO|, |ELCONN|)) then
    return error 1 |IntegratorNozzle: Element wrong type|
  endif
  !this.element = !element
  !this.isSchematic  = (!this.element.type inset(|SCNOZZ|, |SCELCO|))
  !this.isElectrical = (!this.element.type inset(|SCELCO|, |ELCONN|))

  -- Nozzle details
  if (!this.isElectrical.not()) then

    -- Get duct or bore details
    if (!this.isSchematic) then
      -- SCNOZZ
      !this.ductShape = !this.element.ductsh
      if (!this.ductShape.unset()) then
        !this.ductShape = ||
      endif
      if (!this.ductShape inset(|RECT|, |CIRC|, |OVAL|)) then
        -- HVAC SCNOZZ
        !this.isHVAC = TRUE
        !this.ductWidth = !this.element.ductwi
        if (!this.ductWidth.unset()) then
          !this.ductWidth = object BORE(0)
        endif
        if (!this.ductShape eq |CIRC|) then
          !this.ductHeight = object BORE(0)
        else
          !this.ductHeight = !this.element.ducthe
          if (!this.ductHeight.unset()) then
            !this.ductHeight = object BORE(0)
          endif
        endif
      else
        -- Piping SCNOZZ use bore from catref if set otherwise use bore on scnozz
        !this.isPiping = TRUE
        !this.bore = !this.element.ppbo[1]
        handle any
          !this.bore = !this.element.bore
          if (!this.bore.real() eq 0) then
            !this.bore = object BORE(0)
          endif
        endhandle
      endif
    else
      -- NOZZ
      !this.ductShape = !this.element.ppco[1]
      handle any
        !this.ductShape = ||
      endhandle
      if (!this.ductShape inset(|RECT|, |CIRC|, |OVAL|)) then
        -- HVAC NOZZ
        !this.isHVAC = TRUE
        !this.ductWidth = object BORE(!this.element.desp[2])
        handle any
          !this.ductWidth = object BORE(0)
        endhandle
        if (!this.ductShape eq |CIRC|) then
          !this.ductHeight = object BORE(0)
        else
          !this.ductHeight = object BORE(!this.element.desp[3])
          handle any
            !this.ductHeight = object BORE(0)
          endhandle
        endif
      else
        -- Piping NOZZ
        !this.isPiping = TRUE
        !this.bore = !this.element.ppbo[1]
        handle any
          !this.bore = object BORE(0)
        endhandle
      endif
    endif

    -- Size string
    if (!this.isHVAC) then
      !this.sizeString = !this.ductShape & | | & !this.ductWidth.string(!!boreFmt)
      handle any
      elsehandle none
        if (!this.ductShape ne |CIRC|) then
          !this.sizeString = !this.sizeString & | x | & !this.ductHeight.string(!!boreFmt)
          handle any
          endhandle
        endif
      endhandle
      !this.specAnsw = !this.ductShape
    else
      !this.sizeString = !this.bore.string(!!boreFmt)
      handle any
      endhandle
      !this.specAnsw = !this.bore.real().string()
      handle any
      endhandle
    endif

  endif

  -- Connection string
  !this.crefString = |Not Connected|
  if (!this.isElectrical) then
    if (!this.element.elcxrf.size() gt 0) then
      !this.crefString = |Connected to |
      !started = FALSE
      do !conn values !this.element.elcxrf
        if (!started) then
          !this.crefString = !this.crefString & |, | & !conn.fullname
        else
          !this.crefString = !conn.fullname
          !started = TRUE
        endif
      enddo
    endif
  else
    if (!this.element.cref.set()) then
      if (!this.element.cref.badref().not()) then
        !this.crefString = !this.element.cref.fullname
      endif
    endif
  endif

  -- Linked element and link string
  !this.linkString = |Not Linked|
  if (!this.isSchematic) then
    !this.linkedElement = !this.element.deslnk[1]
    handle any
    endhandle
  else
    !this.linkedElement = !this.element.schlnk
    handle any
    endhandle
  endif
  if (!this.linkedElement.set()) then
    if (!this.linkedElement.badref().not()) then
      !this.linkString = !this.linkedElement.fullname
    endif
  endif

endmethod
-- End of method definition for integratorNozzle(DBREF)

------------------------------------------------------------------------
--
-- Method:      setDuctSize
--
-- Description:
--   Copy duct shape and size from schematic nozzle to nozzle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDuctSize()

  -- Set HVAC size and shape
  if (!this.isSchematic) then

    -- On schematic nozzle so call method for linked 3D nozzle
    if (!this.isHVAC) then
      !nozz = object INTEGRATORNOZZLE(!this.element.deslnk[1])
      if (!nozz.element.set()) then
        !nozz.setDuctSize()
      endif
    endif

  else

    -- On 3D nozzle so get details of linked schematic nozzle
    !scNozz = object INTEGRATORNOZZLE(!this.element.schlnk)
    if (!scNozz.element.set() and !scNozz.isHVAC) then

      -- Save db position
      !dbpos = !!ce
      !!ce = !this.element

      -- Initialise design parameters
      do !i to 90
        var !desparam desparam numb $!i
        if (!desparam eq |unset|) then
          desparam numb $!i 0
        endif
      enddo

      -- Set duct catref, shape, width and height
      desparam numb 2  $!scNozz.ductWidth
      desparam numb 30 $!scNozz.ductShape
      desparam numb 40 $!scNozz.ductShape
      desparam numb 41 $!scNozz.ductWidth
      if (!scNozz.ductShape eq |RECT|) then
        catref /CDRNOZ
        desparam numb 1  RHNZ
        desparam numb 3  $!scNozz.ductHeight
        desparam numb 42 $!scNozz.ductHeight
      elseif (!scNozz.ductShape eq |CIRC|) then
        catref /CDCNOZ
        desparam numb 1  CHNZ
        desparam numb 3  DIAM
        desparam numb 42 DIAM
      elseif (!scNozz.ductShape eq |OVAL|) then
        catref /CDFNOZ
        desparam numb 1  FHNZ
        desparam numb 3  $!scNozz.ductHeight
        desparam numb 42 $!scNozz.ductHeight
      endif

      -- Set a default length, flange width and thickness
      desparam numb 4 100
      desparam numb 5 50
      desparam numb 7 5

      -- Restore db position
      !!ce = !dbpos

    endif
  endif

endmethod
-- End of method definition for setDuctSize()

------------------------------------------------------------------------
--
-- Method:      sizeTest
--
-- Description:
--   Check if passed 3D nozzle matches this schematic nozzle in size
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       3D nozzle to be checked
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if size matches
--
------------------------------------------------------------------------
define method .sizeTest(!d3ele is DBREF) is BOOLEAN

  -- Confirm types
  if (!this.isSchematic.not()) then
    return error 1 |Nozzle types not valid for size test|
  endif

  -- Check for HVAC or bore size to compare
  if (!this.isHVAC) then
    !sizeTest = (!this.ductShape eq !d3ele.ppco[1] and !this.ductWidth eq !d3ele.desp[2])
    handle any
      !sizeTest = FALSE
    endhandle
    if (!this.ductShape ne |CIRC|) then
      !sizeTest = (!sizeTest and !this.ductHeight eq !d3ele.desp[3])
      handle any
        !sizeTest = FALSE
      endhandle
    endif
  elseif (!this.isElectrical) then
    !sizeTest = (!this.element.catref eq !d3ele.catref)
    handle any
      !sizeTest = FALSE
    endhandle
  else
    !sizeTest = (!this.bore eq !d3ele.ppbo[1])
    handle any
      !sizeTest = FALSE
    endhandle
  endif
  return !sizeTest

endmethod
-- End of method definition for sizeTest()

------------------------------------------------------------------------
--
-- Method:      defaultHvacNozzle
--
-- Description:
--   Set default design parameters on HVAC nozzle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .defaultHvacNozzle()

  -- Set default 3D HVAC size and shape
  if (!this.isSchematic.not() and !this.isElectrical.not()) then

    -- Save db position
    !dbpos = !!ce
    !!ce = !this.element

    -- Initialise design parameters
    do !i to 90
      var !desparam desparam numb $!i
      if (!desparam eq |unset|) then
        desparam numb $!i 0
      endif
    enddo

    -- Set duct catref, shape, width and height
    if (!!exists(|/CDRNOZ|, |SPCO|, ||) or !!exists(|/CDRNOZ|, |SCOM|, ||)) then
      catref /CDRNOZ
    endif
    desparam numb 1  RHNZ
    desparam numb 2  300
    desparam numb 3  150
    desparam numb 30 RECT
    desparam numb 40 RECT
    desparam numb 41 300
    desparam numb 42 150

    -- Set a default length, flange width and thickness
    desparam numb 4 100
    desparam numb 5 50
    desparam numb 7 5

    -- Restore db position
    !!ce = !dbpos

  endif

endmethod
-- End of method definition for defaultHvacNozzle()
