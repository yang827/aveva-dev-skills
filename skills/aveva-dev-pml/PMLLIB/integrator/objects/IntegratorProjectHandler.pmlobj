--
-- File:            IntegratorProjectHandler.pmlobj
--   Type:          Object Definition
--   Group:         Integrator
--
--   Keyword:       Integrator, Project Configuration
--   Module:        Design
--   Replaces:
--
-- Author:          Ray Davies
-- Created:         Fri Mar 9    16:0:01  2007
--
--
-- Description:
-- Integrator helper object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  beginBuild(ARRAY)                -
--  beginBuildCallback(ARRAY)        -                   Opportunity for initialise prior to the Integrator Build process
--  beginCompare(ARRAY)              -
--  beginCompareCallback(ARRAY)      -                   Opportunity for initialise prior to the Integrator Compare process
--  endBuild(ARRAY)                  -
--  endBuildCallback(ARRAY)          -                   Opportunity for tidy up following the Integrator Build process
--  endCompare(ARRAY)                -
--  endCompareCallback(ARRAY)        -                   Opportunity for tidy up following the Integrator Build process
--  globalInstance()                 -
--  integratorProjectHandler()       -
--  localDrawlist()                  BOOLEAN             Set whether using local or global drawlist
--  postCreate(ARRAY)                -
--  postCreateCallback(ARRAY)        -
--  postEvents()                     -                   Setup events that precede support handler equivalent events
--  preCreate(ARRAY)                 -
--  preCreateCallback(ARRAY)         -
--  preEvents()                      -                   Setup events that precede support handler equivalent events
--
------------------------------------------------------------------------
define object INTEGRATORPROJECTHANDLER

  member .debug                is BOOLEAN
  member .beginBuildHandle     is REAL
  member .beginCompareHandle   is REAL
  member .endBuildHandle       is REAL
  member .endCompareHandle     is REAL
  member .preCreateHandle      is REAL
  member .postCreateHandle     is REAL
  member .itemBuilt            is ARRAY

endobject
-- End of object definition for INTEGRATORPROJECTHANDLER

------------------------------------------------------------------------
-- Method:      integratorProjectHandler
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .integratorProjectHandler()

  !this.debug = FALSE

  using namespace 'Aveva.Pdms.Integrator'

  -- Setup global Integrator
  if (not defined(!!integrator)) then
     !!integrator = object INTEGRATOR()
  endif

  -- Setup global IntegratorProjectHandler
  if (not defined(!!integratorProjectHandler)) then
    !this.globalInstance()
  endif

endmethod
-- End of method definition for integratorProjectHandler

------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!integratorProjectHandler = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
-- Method:      preEvents
--
-- Description:
--   Setup events that precede support handler equivalent events
--   Called from IntegratorSupportHandler constructor which checks if this already done
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .preEvents()

  -- Set project callbacks
  !this.preCreateHandle    = !!integrator.addEventHandler('PreCreate',    !!integratorProjectHandler, 'PreCreateCallback')
  !this.beginBuildHandle   = !!integrator.addEventHandler('BeginBuild',   !!integratorProjectHandler, 'BeginBuildCallback')
  !this.beginCompareHandle = !!integrator.addEventHandler('BeginCompare', !!integratorProjectHandler, 'BeginCompareCallback')

endmethod
-- End of method definition for preEvents

------------------------------------------------------------------------
-- Method:      postEvents
--
-- Description:
--   Setup events that precede support handler equivalent events
--   Called from IntegratorSupportHandler constructor which checks if this already done
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .postEvents()

  -- Set project callbacks
  !this.postCreateHandle   = !!integrator.addEventHandler('PostCreate',   !!integratorProjectHandler, 'PostCreateCallback')
  !this.endBuildHandle     = !!integrator.addEventHandler('EndBuild',     !!integratorProjectHandler, 'EndBuildCallback')
  !this.endCompareHandle   = !!integrator.addEventHandler('EndCompare',   !!integratorProjectHandler, 'EndCompareCallback')

endmethod
-- End of method definition for postEvents

------------------------------------------------------------------------
-- Method:      beginBuildCallback
-- Description: Opportunity for initialise prior to the Integrator Build process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .beginBuildCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beginBuild(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .beginBuild(!args is ARRAY)

  if (!this.debug) then
    write 'integratorProjectHandler.beginBuildCallback()'
  endif

  -- Initialise
  !this.itemBuilt.clear()

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for .beginBuild

------------------------------------------------------------------------
-- Method:      beginCompareCallback
-- Description: Opportunity for initialise prior to the Integrator Compare process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .beginCompareCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beginCompare(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .beginCompare(!args is ARRAY)

  if (!this.debug) then
    write 'integratorProjectHandler.beginCompareCallback()'
  endif

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for .beginCompare

------------------------------------------------------------------------
-- Method:      endBuildCallback
-- Description: Opportunity for tidy up following the Integrator Build process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .endBuildCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.endBuild(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .endBuild(!args is ARRAY)

  if (!this.debug) then
    write 'integratorProjectHandler.endBuildCallback()'
  endif

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Loop through what has been built
  do !item values !this.itemBuilt
    if (!this.debug) then
      !output = 'Item built: ' & !item.fullname
      write !output
    endif
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  enddo

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for .endBuild

------------------------------------------------------------------------
-- Method:      endCompareCallback
-- Description: Opportunity for tidy up following the Integrator Compare process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .endCompareCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.endCompare(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .endCompare(!args is ARRAY)

  if (!this.debug) then
    write 'integratorProjectHandler.endCompareCallback()'
  endif

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for .endCompare

------------------------------------------------------------------------
-- Method:      preCreateCallback
-- Description: Opportunity for intervention prior to an element being created in the Integrator Build process
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to 2-D "source" element]
-- !args[1] [R]    [STRING]   [reference to 3-D owner of element to be created]
-- !args[2] [R]    [STRING]   [type of element to be created]
-- !args[3] [R]    [STRING]   [proposed name of element to be created]
-- !args[4] [RW]   [STRING]   [return error text in the event of an error]
------------------------------------------------------------------------
define method .preCreateCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.preCreate(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .preCreate(!args is ARRAY)

  -- Initialise
  !d2Ele = !args[0].dbref()
  !d2EleName = !d2Ele.fullname
  !d3EleOwner = !args[1].dbref()
  handle any
    !d3EleOwner = object DBREF()
  endhandle
  !d3EleOwnerName = !d3EleOwner.fullname
  handle any
    -- no matching 3D
    !d3EleOwnerName = ''
  endhandle
  !newType = !args[2]
  if (defined(!args[3])) then
    !newName = !args[3]
  else
    !newName = 'unset'
  endif

  if (!this.debug) then
    !output = 'integratorProjectHandler.preCreateCallback(' & !d2EleName & ', ' & !d3EleOwnerName & ', ' & !newType & ', ' & !newName & ')'
    write !output
    !!integratorSupportHandler.isRefNo('integratorProjectHandler.preCreateCallback', !args[0])
    !!integratorSupportHandler.isRefNo('integratorProjectHandler.preCreateCallback', !args[1])
  endif

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for .preCreate

------------------------------------------------------------------------
-- Method:      postCreateCallback
-- Description: Opportunity for intervention immediately following an element being created in the Integrator Build process
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to element just created]
-- !args[1] [R]    [STRING]   [reference to 2-D "source" element]
-- !args[2] [RW]   [STRING]   [return error text in the event of an error]
------------------------------------------------------------------------
define method .postCreateCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.postCreate(!args)
  handle any
    !!integratorSupportHandler.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .postCreate(!args is ARRAY)

  -- Initialise
  !d3Ele = !args[0].dbref()
  !d3EleName = !d3Ele.fullname
  !d2Ele = !args[1].dbref()
  handle any
    !d2Ele = object DBREF()
  endhandle
  !d2EleName = !d2Ele.fullname
  handle any
    -- no matching 2-D
    !d2EleName = ''
  endhandle

  if (!this.debug) then
    !output = 'integratorProjectHandler.postCreateCallback(' & !d3EleName & ', ' & !d2EleName & ')'
    write !output
    !!integratorSupportHandler.isRefNo('integratorProjectHandler.postCreateCallback', !args[0])
    !!integratorSupportHandler.isRefNo('integratorProjectHandler.postCreateCallback', !args[1])
  endif

  -- Record what has been built
  !this.itemBuilt.append(!d3Ele)

  --====================================================================
  -- Start of customisation

  -- End of customisation
  --====================================================================

  -- Graphics mode only
  if (not istty) then
    --==================================================================
    -- Start of customisation

    -- End of customisation
    --==================================================================
  endif

endmethod
-- End of event callback definition for postCreateCallback

------------------------------------------------------------------------
-- Method:      localDrawlist
--
-- Description:
--   Set whether using local or global drawlist
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [BOOLEAN] [True if using local drawlist]
------------------------------------------------------------------------
define method .localDrawlist() is BOOLEAN

  -- Set to false if you want Integrator to use the global drawlist and current graphical view
  return TRUE

endmethod
-- End of event callback definition for .localDrawlist
