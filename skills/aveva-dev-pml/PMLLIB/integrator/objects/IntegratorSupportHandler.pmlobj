-- File:            IntegratorSupportHandler.pmlobj
--   Type:          Object Definition
--   Group:         Integrator
--
--   Keyword:       Integrator
--   Module:        Design
--   Replaces:
--
-- Author:          Ray Davies
-- Created:         Fri Mar 9    16:0:01  2007
--
--
-- Description:
-- Integrator helper object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptedDifferences()            ARRAY               Return the differences accepted
--  addInfo(DBREF,STRING)            -                   Output an info message to the dialogue
--  addMessage(STRING,DBREF,STRING)  -                   Output a message to the dialogue
--  addToView(ARRAY)                 -
--  addToViewCallback(ARRAY)         -                   Add Items into Build View
--  addWarning(DBREF,STRING)         -                   Output a warning message to the dialogue
--  autoNozzLink()                   -                   Auto link nozzles when equipment template used
--  beginBuild(ARRAY)                -
--  beginBuildCallback(ARRAY)        -                   Opportunity for initialise prior to the Integrator Build process
--  beginCompare(ARRAY)              -
--  beginCompareCallback(ARRAY)      -                   Opportunity for initialise prior to the Integrator Compare process
--  colourCode(ARRAY)                -
--  colourCodeCallback(ARRAY)        -
--  compareDiagram(DBREF)            -                   Compare the contents of a diagram and view the report
--  compareDiagram(DBREF,BOOLEAN,BOOLEAN,BOOLEAN) -                   Compare the contents of a diagram
--  compareSummary()                 ARRAY               Return the compare summary statistics
--  copyHvacSize(ARRAY)              -                   Copy HVAC size from 2D to 3D
--  createDrawlist()                 -                   Create Integrator drawlist
--  debugOff()                       -                   Clear debug flag
--  debugOn()                        -                   Set debug flag
--  elementList(ARRAY)               -
--  elementListCallback(ARRAY)       -
--  endBuild(ARRAY)                  -
--  endBuildCallback(ARRAY)          -                   Opportunity for tidy up following the Integrator Build process
--  endCompare(ARRAY)                -
--  endCompareCallback(ARRAY)        -                   Opportunity for tidy up following the Integrator Build process
--  formatDate(STRING)               DATETIME            Format accepted difference date string into dateTime object
--  globalInstance()                 -
--  highlighted()                    -                   Output list of what is currently highlighted
--  intDrawlist()                    DRAWLIST            Return Integrator drawlist
--  integratorSupportHandler()       -
--  isRefNo(STRING,STRING)           -                   Check that supplied string is a ref number
--  pickConnection(ARRAY)            -
--  pickConnectionCallback(ARRAY)    -
--  postColourCoding(ARRAY)          -
--  postColourCodingCallback(ARRAY)  -
--  postCreate(ARRAY)                -
--  postCreateCallback(ARRAY)        -                   Opportunity for intervention immediately following an element being created in the Integrator Build process
--  preColourCoding(ARRAY)           -
--  preColourCodingCallback(ARRAY)   -
--  printAllAccepted()               -                   Output all the accepted differences
--  printSummary()                   -                   Output the compare summary statistics
--  processDiagram(DBREF)            -                   Compare the contents of a diagram and process the report
--  processReport(STRING,STRING)     -                   Process a compare report file
--  selectComponent(ARRAY)           -
--  selectComponentCallback(ARRAY)   -
--  selectConfig()                   -                   Select a config file
--  selectInGrid(ARRAY)              -
--  selectInGridCallback(ARRAY)      -                   Notification when main grid selection changes
--  selectOrChoose(STRING,STRING,STRING) -                   Select or choose a piping component
--  selectPipeComp(STRING,STRING)    -                   Select Piping Component during Integrator Build
--  setLimits(ARRAY)                 -
--  setLimitsCallback(ARRAY)         -
--  showAppForm(ARRAY)               -
--  showConnForm(ARRAY)              -                   Show pick connections form from context menu
--  showForm(ARRAY)                  -                   Called when pml form displayed from context menu
--  showNozzForm(ARRAY)              -                   Show nozzle details form from context menu
--  showView()                       -                   Show Integrator view
--  stackComps(DBREF)                -                   Stack components near head or tail
--  traceBack()                      -                   Output traceback for most recent error
--  useConfig(FILE)                  -                   Use the selected config file
--  useConfig(STRING)                -                   Use the selected config file
--
------------------------------------------------------------------------
define object INTEGRATORSUPPORTHANDLER

  member .debug                         is BOOLEAN
  member .eleList                       is ARRAY
  member .beginBuildHandle              is REAL
  member .beginCompareHandle            is REAL
  member .endBuildHandle                is REAL
  member .endCompareHandle              is REAL
  member .elementListHandle             is REAL
  member .colourCodeHandle              is REAL
  member .preColourCodingHandle         is REAL
  member .postColourCodingHandle        is REAL
  member .selectHandle                  is REAL
  member .setLimitsHandle               is REAL
  member .addToViewHandle               is REAL
  member .postCreateHandle              is REAL
  member .pickConnectionCallbackHandle  is REAL
  member .showFormHandle                is REAL
  member .selectInGridHandle            is REAL
  member .copyHvacSizeHandle            is REAL
  member .intView                       is BOOLEAN
  member .intForm                       is FORM
  member .intToken                      is REAL
  member .backgroundColour              is REAL
  member .equiBuilt                     is ARRAY
  member .nozzBuilt                     is ARRAY
  member .nozzAtts                      is ARRAY
  member .itemBuilt                     is ARRAY
  member .elementsToColour              is ARRAY
  member .colourCodes                   is ARRAY
  member .highlightedElements           is ARRAY
  member .originalColours               is ARRAY
  member .pickConn                      is BOOLEAN
  member .stackDirs                     is ARRAY
  member .stackDirNo                    is REAL
  member .equipmentTranslucency         is REAL
  member .translucencyValueIfUsed       is REAL
  member .useClippingPlanes             is BOOLEAN
  member .limitsMargin                  is REAL

endobject
-- End of object definition for INTEGRATORSUPPORTHANDLER

------------------------------------------------------------------------
-- Method:      integratorSupportHandler
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .integratorSupportHandler()

  -- Initialise debug and view flags
  !this.debug = FALSE
  !this.intView = FALSE
  if (not istty) then
    !!command(|$$S intDebugOn  = !!integratorSupportHandler.debugOn()|)
    !!command(|$$S intDebugOff = !!integratorSupportHandler.debugOff()|)
    !!command(|$$S intConfig   = !!integratorSupportHandler.selectConfig()|)
  endif

  -- View background colour darkgrey
  !this.backgroundColour = 311

   using namespace 'Aveva.Pdms.Integrator'

  -- Setup global Integrator
  if (not defined(!!integrator)) then
     !!integrator = object INTEGRATOR()
     handle (46,87)
       -- Object definition for Integrator not found - license has failed
       return error 1 |Integrator cannot start - license may not be available|
     endhandle
  endif

  -- Setup global IntegratorSupportHandler
  if (not defined(!!integratorSupportHandler)) then
    !this.globalInstance()
  endif

  -- (Re)Setup global IntegratorProjectHandler
  !!comDefineGlobal(object INTEGRATORPROJECTHANDLER())

  -- (Re)Setup HVAC object
  !!comDefineGlobal(object INTEGRATORHVAC())

  -- Set mandatory callbacks if not set already
  if (not !!integrator.isEventAdded('SelectComponent')) then
    !!integratorProjectHandler.preEvents()
    !this.beginBuildHandle             = !!integrator.addEventHandler('BeginBuild',             !!integratorSupportHandler, 'BeginBuildCallback')
    !this.beginCompareHandle           = !!integrator.addEventHandler('BeginCompare',           !!integratorSupportHandler, 'BeginCompareCallback')
    !this.endBuildHandle               = !!integrator.addEventHandler('EndBuild',               !!integratorSupportHandler, 'EndBuildCallback')
    !this.endCompareHandle             = !!integrator.addEventHandler('EndCompare',             !!integratorSupportHandler, 'EndCompareCallback')
    !this.elementListHandle            = !!integrator.addEventHandler('ElementList',            !!integratorSupportHandler, 'ElementListCallback')
    !this.postCreateHandle             = !!integrator.addEventHandler('PostCreate',             !!integratorSupportHandler, 'PostCreateCallback')
    !this.selectHandle                 = !!integrator.addEventHandler('SelectComponent',        !!integratorSupportHandler, 'SelectComponentCallback')
    !this.pickConnectionCallbackHandle = !!integrator.addEventHandler('PickConnectionCallback', !!integratorSupportHandler, 'PickConnectionCallback')
    !this.preColourCodingHandle        = !!integrator.addEventHandler('PreColourCoding',        !!integratorSupportHandler, 'PreColourCodingCallback')
    !this.postColourCodingHandle       = !!integrator.addEventHandler('PostColourCoding',       !!integratorSupportHandler, 'PostColourCodingCallback')
    !this.colourCodeHandle             = !!integrator.addEventHandler('ColourCode',             !!integratorSupportHandler, 'ColourCodeCallback')
    !this.setLimitsHandle              = !!integrator.addEventHandler('SetLimits',              !!integratorSupportHandler, 'SetLimitsCallback')
    !this.addToViewHandle              = !!integrator.addEventHandler('AddToView',              !!integratorSupportHandler, 'AddToViewCallback')
    !this.showFormHandle               = !!integrator.addEventHandler('ShowForm',               !!integratorSupportHandler, 'ShowForm')
    !this.selectInGridHandle           = !!integrator.addEventHandler('SelectInGrid',           !!integratorSupportHandler, 'SelectInGridCallback')
    !this.copyHvacSizeHandle           = !!integrator.addEventHandler('CopyHvacSize',           !!integratorSupportHandler, 'CopyHvacSize')
    !!integratorProjectHandler.postEvents()
  endif

  -- Directions for stacking unpositioned components
  !this.stackDirs[1] = object DIRECTION(|E|)
  !this.stackDirs[2] = object DIRECTION(|N|)
  !this.stackDirs[3] = object DIRECTION(|W|)
  !this.stackDirs[4] = object DIRECTION(|S|)
  !this.stackDirNo   = 0

  -- Graphical settings initialisation
  !this.equipmentTranslucency   = 0
  !this.translucencyValueIfUsed = 30
  !this.useClippingPlanes       = FALSE
  !this.limitsMargin            = 1000mm

endmethod
-- End of method definition for integratorSupportHandler

------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .globalInstance()

  -- Create Global Variable
  !!integratorSupportHandler = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
-- Method:      createDrawlist
-- Description: Create Integrator drawlist
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .createDrawlist()

  -- Create the next available drawlist if there isn't one already created
  if (!this.intView.not()) then
    !this.intView = TRUE
    if (!!integratorProjectHandler.localDrawlist()) then
      !this.intToken = !!gphDrawlists.createDrawlist(TRUE)
    else
      !this.intToken = 1
    endif
  endif

endmethod
-- End of method definition for .createDrawlist()

------------------------------------------------------------------------
-- Method:      showView
-- Description: Show Integrator view
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .showView()

  -- Create the Integrator view and drawlist if not already there
  if (!this.intView.not()) then
    !this.createDrawlist()
  endif

  -- Show the Integrator view
  !this.intForm.show()
  handle any
    -- View has not been shown yet or user has manually deleted it
    if (!!integratorProjectHandler.localDrawlist()) then
      !this.intForm = !!gphviews.addDesignform()
      !this.intForm.formTitle = |Integrator 3D View|
      !this.intForm.view.background = !this.backgroundColour
      !!gphDrawlists.attachView(!this.intToken,!this.intForm.view)
    else
      -- For global drawlist use the currently selected view if available
      if (!!gphviews.views.empty()) then
        !this.intForm = !!gphviews.addDesignform()
      else
        !form = !!fmsys.currentDocument()
        handle ANY
          !this.intForm = !!gphviews.addDesignform()
        elsehandle NONE
          if (!form.set()) then
            !this.intForm = !form
          else
            !this.intForm = !!gphviews.addDesignform()
          endif
        endhandle
      endif
    endif
  endhandle

endmethod
-- End of method definition for .showView()

------------------------------------------------------------------------
-- Method:      intDrawlist
-- Description: Return Integrator drawlist
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DRAWLIST    View drawlist
------------------------------------------------------------------------
define method .intDrawlist() is DRAWLIST

  -- Return view drawlist
  !drawlist = object DRAWLIST()
  if (!this.intView) then
    !drawlist = !!gphDrawlists.drawlist(!this.intToken)
  endif
  return !drawlist

endmethod
-- End of method definition for .buildDrawlist()

------------------------------------------------------------------------
-- Method:      beginBuildCallback
-- Description: Opportunity for initialise prior to the Integrator Build process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .beginBuildCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beginBuild(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .beginBuild(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.beginBuildCallback()'
  endif

  -- Initialisation
  !this.equiBuilt.clear()
  !this.nozzBuilt.clear()
  !this.nozzAtts.clear()
  !this.itemBuilt.clear()
  !this.pickConn = FALSE
  FORWARDS

  -- Graphics mode only
  if (not istty) then

    -- Clear pick connections form lists
    if (defined(!!intPickConn)) then
      !!intPickConn.clear()
    endif

    -- Create the Integrator drawlist
    !this.createDrawlist()

  endif

endmethod
-- End of event callback definition for .beginBuild

------------------------------------------------------------------------
-- Method:      beginCompareCallback
-- Description: Opportunity for initialise prior to the Integrator Compare process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .beginCompareCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.beginCompare(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .beginCompare(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.beginCompareCallback()'
  endif

  -- Set precision so imperial bores compare correctly
  PRECISION 6DP
  PRECISION BORES NOMINAL

  -- Graphics mode only
  if (not istty) then

    -- Create the Integrator view and drawlist
    !this.showView()

  endif

endmethod
-- End of event callback definition for .beginCompare

------------------------------------------------------------------------
-- Method:      endBuildCallback
-- Description: Opportunity for tidy up following the Integrator Build process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .endBuildCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.endBuild(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .endBuild(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.endBuildCallback()'
  endif

  -- Link nozzles if equipment templates used
  !this.autoNozzLink()
  handle any
    -- Display errors then continue
    !this.traceBack()
  endhandle

  -- Stack unpositioned piping or HVAC components if head or tail position available
  do !item values !this.itemBuilt
    !dbpos = !!ce
    !!ce = !item
    if (!item.type eq |BRAN|) then
      -- Always try to set connections but ignore any error such as unpositioned tee
      if (!item.href.set()) then
        !end = | |
        if (!item.href.type eq |BRAN|) then
          if (!item.hend inset(|HEAD|, |TAIL|)) then
            !end = |P| & !item.hend.subString(1, 1) & | OF|
          endif
        endif
        CONN PH TO $!end HREF
        handle any
        endhandle
        -- Set branch size and shape from href
        if (!!ce.owner.type eq |HVAC|) then
          !!integratorHvac.setBranchSize(!item.href)
        endif
      endif
      if (!item.tref.set()) then
        !end = | |
        if (!item.tref.type eq |BRAN|) then
          if (!item.tend inset(|HEAD|, |TAIL|)) then
            !end = |P| & !item.tend.subString(1, 1) & | OF|
          endif
        endif
        CONN PT TO $!end TREF
        handle any
        endhandle
      endif
      !this.stackComps(!item)
      handle any
        -- Display errors then continue
        !this.traceBack()
      endhandle
    endif
    !!ce = !dbpos
  enddo

  -- Graphics mode only
  if (not istty) then

    -- Show equi form
    if (!this.equiBuilt.size() gt 0 ) then
      if (defined(!!intEquiSpre)) then
        if (!!intEquiSpre.shown()) then
          hide !!intEquiSpre
        endif
      endif
      show !!intEquiSpre free
    endif

    -- Populate drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.intToken)
    !limitsArgs = ARRAY()
    !notOnlyCable = FALSE
    do !ele values !this.itemBuilt
      if (not !ele.type inset('SITE','ZONE','CABLE')) then
        !notOnlyCable = TRUE
      endif
      !drawlist.add(!ele)
      !limitsArgs.append(!ele.refn.string())
    enddo

    -- Show the Integrator view if anything other than cable has been built
    if (!notOnlyCable) then
      !this.showView()
      !this.setLimits(!limitsArgs)
    endif

    -- Show connections form if selection required
    if (!this.pickConn) then
      show !!intPickConn free
    endif

    -- Hide messages form
    hide !!intMessages
    handle any
    endhandle

  endif

endmethod
-- End of event callback definition for .endBuild

------------------------------------------------------------------------
-- Method:      autoNozzLink
-- Description: Auto link nozzles when equipment template used
-- Method Type: PML Event
-- Arguments:   None
------------------------------------------------------------------------
define method .autoNozzLink()

  if (!this.debug) then
    write 'integratorSupportHandler.autoNozzLink()'
  endif

  -- Check if template nozzles can be auto linked
  !dbpos = !!ce
  do !equi values !this.equiBuilt
    if (!equi.spref.set()) then

      -- Collect schematic and 3D nozzles and copy results arrays so can delete members
      !scNozz = object COLLECTION()
      !scNozz.scope(!equi.schlnk)
      !scNozz.type('SCNOZZ')
      !scNozz.addType('SCELCO')
      !scNozzles = !scNozz.results()
      !nozz = object COLLECTION()
      !nozz.scope(!equi)
      !nozz.type('NOZZ')
      !nozz.addType('ELCONN')
      !nozz.filter(object expression(|type of owner eq 'TMPL'|))
      !nozzles = !nozz.results()

      -- Loop thru schematic nozzles and look for matching 3D nozzle within template
      do !d2ele values !scNozzles
        do !d3ele values !nozzles

          -- Nozzle may have been deleted in previous pass through loop
          if (!d3ele.badref().not()) then
            if (!d3ele.schlnk.unset()) then
              !nozzTest = object INTEGRATORNOZZLE(!d2ele)
              if (!nozzTest.sizeTest(!d3ele)) then

                -- Found unlinked template nozzle with matching size
                !oldD3ele = !d2ele.deslnk[1]
                !!integrator.unlink(!d2ele.ref.string())
                !!integrator.link(!d2ele.ref.string(), !d3ele.ref.string())

                -- Remove nozzle from built arrays
                !item = !this.itemBuilt.findFirst(!oldD3ele)
                !this.itemBuilt.remove(!item)
                !item = !this.nozzBuilt.findFirst(!oldD3ele)
                !this.nozzBuilt.remove(!item)

                -- Get attributes to be copied before removing from that array
                !nozzAtts = !this.nozzAtts[!item]
                !this.nozzAtts.remove(!item)

                -- Copy over any set attributes
                do !attrib values !nozzAtts
                  if (defined(!value)) then
                    !value.delete()
                  endif
                  !value = !oldD3ele.attribute(!attrib)
                  handle any
                    if (!this.debug) then
                      !output = 'Error getting ' & !d3ele.type & ' attribute ' & !attrib & ': ' & !!error.text
                      write !output
                    endif
                    skip
                  endhandle
                  skip if (!attrib.upcase() eq |NAME| or !value.unset())
                  !d3ele.attribute(!attrib) = !oldD3ele.attribute(!attrib)
                  handle any
                    if (!this.debug) then
                      !output = 'Error setting ' & !d3ele.type & ' attribute ' & !attrib & ': ' & !!error.text
                      write !output
                    endif
                    skip
                  endhandle
                enddo

                -- Transfer name and delete auto-created nozzle
                !!ce = !oldD3ele
                !name = !!ce.name
                !type = !!ce.type
                DELETE $!type
                !!ce = !d3ele
                name $!name
                break

              endif
            endif
          endif
        enddo
      enddo
    endif
  enddo
  !!ce = !dbpos

endmethod
-- End of event callback definition for .autoNozzLink

------------------------------------------------------------------------
-- Method:      stackComps
-- Description: Stack components near head or tail
-- Method Type: PML Event
-- Arguments:   [1] DBREF branch
------------------------------------------------------------------------
define method .stackComps(!item is DBREF)

  if (!this.debug) then
    write 'integratorSupportHandler.stackComps()'
  endif

  -- Stack unpositioned piping components if head or tail position available
  !pos = object POSITION()
  !setHead = FALSE
  !setTail = FALSE
  !offset = 300mm
  if (!item.owner.type eq |HVAC|) then
    !offset = 1000mm
  endif

  -- Get a stacking direction
  !this.stackDirNo = !this.stackDirNo + 1
  if (!this.stackDirNo eq 5) then
    !this.stackDirNo = 1
  endif
  !dir = !this.stackDirs[!this.stackDirNo]

  -- Check for connected position at head
  if (!item.href.set()) then
    if (!item.href.badref().not()) then
      -- Head has a position
      if (!item.href.type eq |NOZZ|) then
        !dir = !item.href.pdir[1]
        handle any
        endhandle
      endif
      if (!item.href.type eq |BRAN|) then
        if (!item.hend eq |TAIL|) then
          !hpos = !item.href.tpos
        else
          !hpos = !item.href.hpos
        endif
      else
        !hpos = !item.href.pos
      endif
      !pos = !hpos.offset(!dir, 600mm)
      !list = !item.members
      -- If head is unpositioned then set an approximate head position
      if (!item.hpos.east eq 0 and !item.hpos.north eq 0 and !item.hpos.up eq 0) then
        !item.hpos = !hpos
      endif
      -- If tail is unpositioned then mark it to be positioned
      if (!item.tpos.east eq 0 and !item.tpos.north eq 0 and !item.tpos.up eq 0) then
        !setTail = TRUE
      endif
    endif
  endif

  -- Check for connected position at tail
  if (!pos.unset()) then
    if (!item.tref.set()) then
      if (!item.tref.badref().not()) then
        -- Tail has a position
        if (!item.tref.type eq |NOZZ|) then
          !dir = !item.tref.pdir[1]
          handle any
          endhandle
        endif
        if (!item.tref.type eq |BRAN|) then
          if (!item.tend eq |HEAD|) then
            !tpos = !item.tref.hpos
          else
            !tpos = !item.tref.tpos
          endif
        else
          !tpos = !item.tref.pos
        endif
        !pos = !tpos.offset(!dir, 600mm)
        !list = !item.members.invert()
        -- If tail is unpositioned then set an approximate tail position
        if (!item.tpos.east eq 0 and !item.tpos.north eq 0 and !item.tpos.up eq 0) then
          !item.tpos = !tpos
        endif
        -- If head is unpositioned then mark it to be positioned
        if (!item.hpos.east eq 0 and !item.hpos.north eq 0 and !item.hpos.up eq 0) then
          !setHead = TRUE
        endif
      endif
    endif
  endif

  -- Use default head position
  if (!pos.unset()) then
    !pos = !item.hpos
    !list = !item.members
    !setTail = TRUE
  endif

  -- Position any unpositioned components along the direction
  do !element values !list
    if (!element.pos.east eq 0 and !element.pos.north eq 0 and !element.pos.up eq 0) then
      !element.position = !pos
      !element.posflag  = FALSE
      -- Offset position beyond leave point
      !pos = !pos.offset(!dir, !element.ppos[1].distance(!element.ppos[2]) + !offset)
      handle any
        -- Not selected
        skip
      endhandle
    endif
  enddo

  -- Set head/tail position if marked to be set
  if (!setHead) then
    if ( !item.hpos.east eq 0 and !item.hpos.north eq 0 and !item.hpos.up eq 0 ) then
      !item.hpos = !pos
    endif
  elseif (!setTail) then
    if ( !item.tpos.east eq 0 and !item.tpos.north eq 0 and !item.tpos.up eq 0 ) then
      !item.tpos = !pos
    endif
  endif

endmethod
-- End of event callback definition for .stackComps

------------------------------------------------------------------------
-- Method:      endCompareCallback
-- Description: Opportunity for tidy up following the Integrator Compare process
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .endCompareCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.endCompare(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .endCompare(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.endCompareCallback()'
  endif

  -- Graphics mode only
  if (not istty) then
    !this.setLimits(object ARRAY())
  endif

endmethod
-- End of event callback definition for .endCompare

------------------------------------------------------------------------
-- Method:      selectComponentCallback
-- Description: Select Component during Integrator Build
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to element to be chosen]
-- !args[1] [R]    [STRING]   [contains the SPEC]
-- !args[2] [R]    [STRING]   [contains any WITH phrases required]
-- !args[3] [R]    [STRING]   [not used]
-- !args[4] [RW]   [STRING]   [return error text in the event of an error]
------------------------------------------------------------------------
define method .selectComponentCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.selectComponent(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .selectComponent(!args is ARRAY)

  -- Initialise
  !ele  = !args[0]
  !spec = name of $!args[1]
  handle any
    !spec = |unset|
  endhandle
  !with = !args[2]

  -- Save db position and make component to be selected current
  !saveCe = !!ce
  !!ce = !ele.dbref()

  if (!this.debug) then
    !output = 'integratorSupportHandler.selectComponentCallback(' & !!ce.fullname & ', ' & !spec & ', ' & !with & ')'
    write !output
    !this.isRefNo('integratorSupportHandler.selectComponentCallback', !args[0])
  endif

  if (!!ce.owner.owner.type eq |PIPE|) then
    -- Select piping component
    !this.selectPipeComp(!spec, !with)
  elseif (!!ce.owner.owner.type eq |HVAC|) then
    -- Select HVAC component
    !!integratorHvac.selectComp()
  endif

  -- Restore db position
  !!ce = !saveCe

endmethod
-- End of event callback definition for .selectComponent

------------------------------------------------------------------------
-- Method:      selectPipeComp
-- Description: Select Piping Component during Integrator Build
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !spec [R]    [STRING]   [contains the SPEC]
-- !with [R]    [STRING]   [contains any WITH phrases required]
------------------------------------------------------------------------
define method .selectPipeComp(!spec is STRING, !with is STRING)

  if (!this.debug) then
    !output = 'integratorSupportHandler.selectPipeComp(' & !spec & ', ' & !with & ')'
    write !output
  endif

  if (!!ce.spre.set()) then

    -- Component already selected, get bores in case flip needed
    !bores = ARRAY()
    !bores[1] = !!ce.ppbo[1]
    handle any
      !bores[1] = object BORE(0)
    endhandle
    !bores[2] = !!ce.ppbo[2]
    handle any
      !bores[2] = object BORE(0)
    endhandle
    if (!!ce.sequ eq 1) then
      !prevBore = !!ce.owner.hbor
      if (!prevBore.unset()) then
        !prevBore = object BORE(0)
      endif
    else
      !prevBore = !!ce.owner.members[!!ce.sequ - 1].lbor
      handle any
        -- LBOR not found, probably because previous component not selected
        !prevBore = object BORE(0)
      endhandle
    endif
    if (!bores[1].set() and !bores[2].set()) then
      if (!bores[2] ne !bores[1]) then
        if (!bores[1] gt !prevBore and !!ce.arrive eq 1 and !!ce.leave eq 2) then
          if (!this.debug) then
            write '..Flip reducer'
          endif
          FLIP
        endif
      endif
    endif

  else

    -- Get bores for selection
    !bores  = !!ce.schlnk.borear
    !arrive = !!ce.schlnk.arrive
    !leave  = !!ce.schlnk.leave
    !arriBore = object BORE(0)
    !leavBore = object BORE(0)
    if (!bores.size() ge !arrive) then
      if (!bores[!arrive].set()) then
        !arriBore = !bores[!arrive]
      endif
    endif
    if (!bores.size() ge !leave) then
      if (!bores[!leave].set()) then
        !leavBore = !bores[!leave]
      endif
    endif
    -- Get working bore used for choose piping components
    if (!!ce.sequ eq 1) then
      !prevBore = !!ce.owner.hbor
      if (!prevBore.unset()) then
        !prevBore = object BORE(0)
      endif
    else
      !prevBore = !!ce.owner.members[!!ce.sequ - 1].lbor
      handle any
        -- LBOR not found, probably because previous component not selected
        !prevBore = object BORE(0)
      endhandle
    endif
    -- Use bore from schematic data if previous 3D bore not available (probably because not selected)
    if (!prevBore eq 0) then
      !prevBore = !arriBore
      if (!prevBore gt 0) then
        !with = !with & | PBOR0 | & !prevBore
      endif
    endif
    -- Get PBOR2 selector
    if (!bores.size() gt 1) then
      if (!bores[1].set() and !bores[2].set()) then
        if (!bores[2] ne !bores[1]) then
          -- Get PBOR2 selector
          if (!bores[1] eq !prevBore) then
            !secondBore = !bores[2]
          else
            !secondBore = !bores[1]
          endif
          !with = !with & | PBOR2 | & !secondBore
          -- Flip reducer
          if (!secondBore gt !prevBore and !!ce.arrive eq 1 and !!ce.leave eq 2) then
            if (!this.debug) then
              write '..Flip reducer'
            endif
            FLIP
          endif
        endif
        -- Get PBOR3 selector
        if (!bores.size() gt 2) then
          if (!bores[3].set()) then
            !with = !with & | PBOR3 | & !bores[3]
          endif
        endif
        -- Get PBOR4 selector
        if (!bores.size() gt 3) then
          if (!bores[4].set()) then
            !with = !with & | PBOR4 | & !bores[4]
          endif
        endif
      endif
    endif

    -- Check for selector string (leading space is needed for message form)
    !withWith  = ||
    !withSpace = ||
    if (!with.trim() ne ||) then
      if (!with.subString(1, 1) ne | |) then
        !withSpace = | |
      endif
      !withWith = | with| & !withSpace & !with
    endif

    -- Try to select with available information
    !this.selectOrChoose(!spec, !with, !withWith)

    -- If tee selection has failed, or been cancelled by the user, try to select an olet
    if (!!ce.spref.unset()) then
      if (!!ce.type eq |TEE|) then
        if (!this.debug) then
          write '..Change tee to olet'
        endif
        CHANGETYPE TO OLET
        -- Try to select with available information
        !this.selectOrChoose(!spec, !with, !withWith)
        if (!!ce.spref.unset()) then
          -- Selection not available so change it back to tee
          if (!this.debug) then
            write '..Change olet to tee'
          endif
          CHANGETYPE TO TEE
        endif
      endif
    endif

    -- Check for unset spref
    if (!!ce.spre.unset()) then
      !this.addWarning(!!ce, 'SPRE not selected: Choice not available or was cancelled')
    endif

  endif

  -- Choose lstube using spec of sctub if there is one
  !tubeSpref = object DBREF()
  !tubePspec = !!ce.schlnk.pspe
  if (!!ce.schlnk.owner.members.size() gt !!ce.schlnk.sequ) then
    !nextSchematicElement = !!ce.schlnk.owner.members[!!ce.schlnk.sequ + 1]
    handle any
    elsehandle none
      -- Members method can return unset dbref if beyond end of list
      if (!nextSchematicElement.set()) then
        if (!nextSchematicElement.badref().not()) then
          if (!nextSchematicElement.type eq |SCTUB|) then
            !tubeSpref = !nextSchematicElement.spre
            !tubePspec = !nextSchematicElement.pspe
          endif
        endif
      endif
    endhandle
  endif
  -- Use spref from sctub if available
  if (!tubeSpref.set()) then
    !!ce.lstu = !tubeSpref
  else
    -- Use pspec of sctub if available otherwise use pspec of component
    if (!tubePspec.unset()) then
      !tubePspec = !spec.dbref()
      handle any
        -- Spec is unset
      endhandle
    endif
    -- If a spec is available then choose lstube
    if (!tubePspec.badref()) then
      !this.addWarning(!!ce, 'LSTU not selected: PSPE not set')
    else
      !choices = select spec $!tubePspec lstu
      handle any
        -- Selection not available or previous component not selected
        !this.addWarning(!!ce, 'LSTU not selected: ' & !!error.text)
      elsehandle none
        if (!choices.size() eq 1) then
          !!ce.lstu = !choices[1]
        endif
      endhandle
    endif
  endif

  -- Check for spec change that is not a single out-of-spec component
  if (!!ce.spre.set() and !!ce.sequ gt 1 and !!ce.schlnk.owner.members.size() gt !!ce.schlnk.sequ) then
    -- Get current spec
    !dbpos = !!ce
    !!ce = !!ce.spre
    SPEC
    !currentSpec = !!ce
    !!ce = !dbpos
    -- Check spec of previous 3D component
    !!ce = !!ce.owner.members[!!ce.sequ - 1].spre
    handle any
      -- No action if previous component spec not available
    elsehandle none
      SPEC
      !prevSpec = !!ce
      !!ce = !dbpos
      if (!currentSpec ne !prevSpec) then
        -- Get spec of two components back in case previous was single out-of-spec component
        !prevTwoSpec = !prevSpec
        if (!!ce.sequ gt 2) then
          !!ce = !!ce.owner.members[!!ce.sequ - 2].spre
          handle any
            -- Default to same as previous spec if this spec not available
          elsehandle none
            SPEC
            !prevTwoSpec = !!ce
            !!ce = !dbpos
          endhandle
        endif
        -- Get spec of next schematic component
        !nextSpec = object DBREF()
        !!ce = !!ce.schlnk.owner.members[!!ce.schlnk.sequ + 1].spre
        handle any
          -- Spre not available so try pspe
          !!ce = !!ce.schlnk.owner.members[!!ce.schlnk.sequ + 1].pspe
          handle any
            -- No action if next schematic component spec not available
          elsehandle none
            !nextSpec = !!ce
            !!ce = !dbpos
          endhandle
        elsehandle none
          SPEC
          !nextSpec = !!ce
          !!ce = !dbpos
        endhandle
        if (!nextSpec.set()) then
          -- Set change of spec if is not just a single out-of-spec schematic component
          if (!prevTwoSpec ne !currentSpec and !prevSpec ne !currentSpec and !nextSpec ne !prevSpec) then
            if (!this.debug) then
              !output = '.. Spec change ' & !currentSpec.name
              write !output
            endif
            !!ce.spkchg = !currentSpec
            handle any
              -- Ignore if attribute not available
            endhandle
          endif
        endif
      endif
    endhandle
  endif

endmethod
-- End of event callback definition for .selectPipeComp

------------------------------------------------------------------------
-- Method:      selectOrChoose
-- Description: Select or choose a piping component
-- Method Type: Function
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      STRING      Pipe spec
--    2     R      STRING      Selector string
--    3     R      STRING      Message string
------------------------------------------------------------------------
define method .selectOrChoose(!spec is STRING, !with is STRING, !withWith is STRING)

  using namespace 'Aveva.Pdms.IntegratorAddin'

  if (!this.debug) then
    !output = 'integratorSupportHandler.selectOrChoose(' & !spec & ', ' & !with & ', ' & !withWith & ')'
    write !output
  endif

  -- Try to select a single spref with available selectors
  !this.addInfo(!!ce, 'Choose ' & !!ce.type & !withWith & ' from spec ' & !spec)
  if (!this.debug) then
    !output = '..Choose ' & !withWith
    write !output
  endif

  -- Check for unset spec
  !unusedSpec = !spec.dbref()
  handle any
    -- Do not try to select
  elsehandle none

    -- See if single choice available
    !choices = ARRAY()
    !choices = select spec $!spec $!withWith
    handle (61,165)
      -- Previous component has zero bore (not handled correctly by above form of select command)
      if (!this.debug) then
        !output = '..Select ' & !withWith
        write !output
      endif
      select with spec $!spec $!with
      handle any
      endhandle
    elsehandle any
    elsehandle none
      if (!choices.size() eq 1) then
        -- Single choice so set spref
        !!ce.spref = !choices[1]
      elseif (!choices.size() eq 0) then
        -- Spec does not contain elements matching given criteria may be choose failing to cope with PBOR1 PBOR2 selectors
        if (!this.debug) then
          !output = '..Select ' & !withWith
          write !output
        endif
        select with spec $!spec $!with
        handle any
        endhandle
      endif
    endhandle

    -- Component not yet selected so try choose form
    if (!!ce.spref.unset()) then
      if (not istty) then
        if (!this.debug) then
          write '..Graphical choose'
        endif

        -- Highlight the item to be chosen in diagram view and select in subtype table
        !itemList[1] = !!ce.schlnk.ref.string()
        !intMan = object INTEGRATORMANAGER()
        !intMan.subGridSelectedItems(!itemList)
        !intMan.findOnDrawing(!itemList)
        handle any
          -- Ignore any error
        endhandle

        -- Tell the user what we are trying to select
        !messText = ARRAY()
        if (!!ce.schlnk.isnamed) then
          !messText[1] = !!ce.schlnk.type & ' ' & !!ce.schlnk.name
        else
          !messText[1] = !!ce.schlnk.flnm
        endif
        !messText[2] = 'Schematic data values specify choose ' & !!ce.type & !withWith & ' from spec ' & !spec
        !messText[3] = 'This choice cannot be made automatically so please choose manually'
        if (!!ce.type eq |TEE|) then
          !messText[3] = !messText[3] & ' or cancel to choose an OLET'
        endif
        show !!intMessages
        !!intMessages.display(!messText)

        -- Choose with available selectors
        choose spec $!spec ALL $!withWith
        handle any
        endhandle
      endif
    endif

  endhandle

endmethod

------------------------------------------------------------------------
-- Method:      setLimitsCallback
-- Description: Set limits for current element list
-- Method Type: PML Event
-- Arguments:   Elements for limits box
------------------------------------------------------------------------
define method .setLimitsCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.setLimits(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .setLimits(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.setLimitsCallback(...)'
    do !arg values !args
      !this.isRefNo('integratorSupportHandler.setLimitsCallback', !arg)
    enddo
  endif

  -- Graphics mode only
  if (not istty) then

    -- Show the Integrator view
    !this.showView()

    -- Set limits for whole compare view if args is empty
    !elements = ARRAY()
    if (!args.size() eq 0) then
      !elements = !this.eleList
    else
      do !element values !args
        !elements.append(!element.dbref())
      enddo
    endif

    -- Disable and clear all defined clipping planes
    do !i to 6
      if (!this.intForm.clipPlanes[!i].notDefined().not()) then
        !this.intForm.clipPlanes[!i].enable(FALSE)
        !this.intForm.clipPlanes[!i].clear()
      endif
    enddo

    -- Check volume is valid and zoom out 1m all round (value used is distance x root3) for single components
    !volume = object VOLUME(!elements)
    if (!volume.set()) then
      if (!elements.size() eq 1) then
        if (!elements[1].owner.type eq |BRAN| or !elements[1].type inset(|NOZZ|,|ELCONN|)) then
          !zoomOut = !this.limitsMargin * 1.732
          !dirUp   = object DIRECTION(|E 45 N 45 U WRT /*|)
          !dirDown = object DIRECTION(|W 45 S 45 D WRT /*|)
          !volume.from = !volume.from.offset(!dirDown, !zoomOut)
          !volume.to   = !volume.to.offset(!dirUp, !zoomOut)
        endif
      endif

      -- Define and enable clipping planes
      if (!this.useClippingPlanes) then
        !positions     = ARRAY()
        !positions[1]  = !volume.from
        !positions[2]  = !volume.from
        !positions[3]  = !volume.from
        !positions[4]  = !volume.to
        !positions[5]  = !volume.to
        !positions[6]  = !volume.to
        !directions    = ARRAY()
        !directions[1] = object DIRECTION(|E|)
        !directions[2] = object DIRECTION(|N|)
        !directions[3] = object DIRECTION(|U|)
        !directions[4] = object DIRECTION(|W|)
        !directions[5] = object DIRECTION(|S|)
        !directions[6] = object DIRECTION(|D|)
        do !i to 6
          !this.intForm.clipPlanes[!i].define(!positions[!i], !directions[!i])
          !this.intForm.clipPlanes[!i].enable(TRUE)
          !this.intForm.clipPlanes[!i].capOn()
        enddo
      endif

      -- Create a format object to convert view attributes
      !format           = object FORMAT()
      !format.units     = 'MM'
      !format.dp        = 0
      !format.dimension = 'L'

      -- Set limits if whole compare view
      if (!args.size() eq 0) then

        -- Setting limits after clipping gives neater redraw in view
        !!gphviews.limits(!this.intForm.view, !volume)
        handle any
          -- Volume invalid if elements do not have geometry
        endhandle

      else

        -- Set through point and radius for compare selection
        !throughPos = !volume.from.midPoint(!volume.to).string(!format).position()
        !through    = ARRAY()
        !through[1] = !throughPos.east
        !through[2] = !throughPos.north
        !through[3] = !throughPos.up
        !this.intForm.view.through = !through
        !this.intForm.view.radius  = !throughPos.distance(!volume.to.string(!format).position())
        handle any
          -- Radius invalid if elements do not have positions
        endhandle

      endif
    endif
  endif

endmethod
-- End of event callback definition for setLimits

------------------------------------------------------------------------
-- Method:      preColourCodingCallback
-- Description: Prepare for Compare colour coding events
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [T or F for show equipment translucent]
------------------------------------------------------------------------
define method .preColourCodingCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.preColourCoding(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .preColourCoding(!args is ARRAY)

  if (!this.debug) then
    !argList = ''
    do !i from 0
      break if (undefined(!args[!i]))
      if (!i gt 0) then
        !argList = !argList & ','
      endif
      !argList = !argList & !args[!i]
    enddo
    !output = 'integratorSupportHandler.preColourCodingCallback(' & !argList & ')'
    write !output
  endif

  -- Graphics mode only
  if (not istty) then

    -- Initialise colour code arrays
    !this.elementsToColour.clear()
    !this.colourCodes.clear()

    -- Show the Integrator view
    !this.showView()

    -- Switch off autocolour
    AUTOCOLOUR OFF

    -- Add to drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.intToken)
    !drawlist.addMembers(!this.eleList)

    -- Flag to show equipment translucent
    !this.equipmentTranslucency = 0
    do !i from 0
      break if (undefined(!args[!i]))
      if (!args[!i].match('EQUI_TRANSLUCENT=') gt 0) then
        if (!args[!i].after('EQUI_TRANSLUCENT=').boolean()) then
          !this.equipmentTranslucency = !this.translucencyValueIfUsed
        endif
      endif
    enddo

  endif

endmethod
-- End of event callback definition for preColourCoding

------------------------------------------------------------------------
-- Method:      postColourCodingCallback
-- Description: Tidy up after Compare colour coding events
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .postColourCodingCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.postColourCoding(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .postColourCoding(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.postColourCodingCallback()'
  endif

  -- Graphics mode only
  if (not istty) then

    -- Loop through the cached colour codes
    !drawlist = !!gphDrawlists.drawlist(!this.intToken)
    do !i ind !this.elementsToColour

      -- Apply the colour code
      !element = !this.elementsToColour[!i]
      !colour  = !this.colourCodes[!i]
      !drawlist.colour(!element, !colour)

      -- Apply translucency to equipment
      if (!element.type inset(|EQUI|, |SUBE|)) then
        !drawlist.translucency(!element, !this.equipmentTranslucency)
      endif

      -- Update stored colours for highlighting
      !j = !this.highlightedElements.findFirst(!element)
      if (!j.set()) then
        !this.originalColours[!j] = !colour
      endif

    enddo

    -- Reset autocolour setting
    !!gphColOpt.coreSettings()

  endif

endmethod
-- End of event callback definition for postColourCoding

------------------------------------------------------------------------
-- Method:      colourCodeCallback
-- Description: Apply Compare colour code to element
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to element to be coloured]
-- !args[1] [R]    [STRING]   [colour number]
-- !args[2] [R]    [STRING]   [compare state description]
------------------------------------------------------------------------
define method .colourCodeCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.colourCode(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .colourCode(!args is ARRAY)

  -- Initialise
  !elementError = FALSE
  !element = !args[0].dbref()
  handle any
    !elementError = TRUE
    !name = !args[0]
  elsehandle none
    !name = !element.flnm
  endhandle

  -- Graphics mode only
  if (not istty and not !elementError) then

    -- Trace
    !colour = !args[1].real()
    !colourName = !!colourName(!colour)
    handle any
      !colourName = !args[1]
    endhandle

    if (!colourName.unset())then
      !colourName = !args[1]
    endif

    if (!this.debug) then
      !output = 'integratorSupportHandler.colourCodeCallback(' & !name & ', ' & !colourName & ', ' & !args[2] & ')'
      write !output
      !this.isRefNo('integratorSupportHandler.colourCodeCallback', !args[0])
    endif

    -- Cache the colour code
    !this.elementsToColour.append(!element)
    !this.colourCodes.append(!colour)

  endif

endmethod
-- End of event callback definition for .colourCode

------------------------------------------------------------------------
-- Method:      elementListCallback
-- Description: List of elements under consideration
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[i] [R]    [STRING]   [reference to list elements]
------------------------------------------------------------------------
define method .elementListCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.elementList(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .elementList(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.elementListCallback(...)'
    do !arg values !args
      !this.isRefNo('integratorSupportHandler.elementListCallback', !arg)
    enddo
  endif

  -- Build element list
  !this.eleList.clear()
  do !element values !args
    !this.eleList.append(!element.dbref())
  enddo

endmethod

-- End of event callback definition for .elementList

------------------------------------------------------------------------
-- Method:      addToViewCallback
-- Description: Add Items into Build View
-- Method Type: PML Event
-- Arguments:   Elements to be processed
------------------------------------------------------------------------
define method .addToViewCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.addToView(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .addToView(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.addToViewCallback(...)'
    do !arg values !args
      skip if (!arg eq |COMPARE| or !arg.trim() eq ||)
      !this.isRefNo('integratorSupportHandler.addToViewCallback', !arg)
    enddo
  endif

  -- Graphics mode only
  if (not istty) then

    -- Show the Integrator view
    !this.showView()

    -- Populate elements in drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.intToken)
    !list = ARRAY()
    do !ele values !args
      skip if (!ele eq |COMPARE| or !ele.trim() eq ||)
      !list.append(!ele.dbref())
    enddo
    !drawlist.addMembers(!list)

    -- Highlight elements added
    !this.selectInGrid(!args)

  endif

endmethod
-- End of event callback definition for addToView

------------------------------------------------------------------------
-- Method:      pickConnectionCallBack
-- Description: Pick connections when line connected direct to schematic equipment
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [TargetType                         ]
-- !args[1] [R]    [STRING]   [OwnerSchematicElement              ]
-- !args[2] [R]    [STRING]   [OwnerElement                       ]
-- !args[3] [R]    [STRING]   [ConnectingElement                  ]
-- !args[4] [R]    [STRING]   [ConnectingElementEnd, HEAD or TAIL ]
-- !args[5] [R]    [STRING]   [PickedElement                      ]
-- !args[6] [R]    [STRING]   [NewElement, true/false             ]
------------------------------------------------------------------------
define method .pickConnectionCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.pickConnection(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .pickConnection(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.pickConnectionCallback(...)'
    !this.isRefNo('integratorSupportHandler.pickConnectionCallback', !args[1])
    !this.isRefNo('integratorSupportHandler.pickConnectionCallback', !args[2])
    !this.isRefNo('integratorSupportHandler.pickConnectionCallback', !args[3])
  endif

  -- Graphics mode only
  if (not istty) then

    -- Setup pick connection form
    if (undefined(!!intPickConn)) then
      pml load form !!intPickConn
    endif
    if (!args[2] ne |unset|) then
      !!intPickConn.setup(!args)
      !this.pickConn = TRUE
    endif

  endif

endmethod
-- End of event callback definition for pickConnection

------------------------------------------------------------------------
-- Method:      postCreateCallback
-- Description: Opportunity for intervention immediately following an element being created in the Integrator Build process
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to element just created]
-- !args[1] [R]    [STRING]   [reference to 2-D "source" element]
-- !args[2] [RW]   [STRING]   [return error text in the event of an error]
-- !args[3+][R]    {STRING]   [list of attributes already set by core]
------------------------------------------------------------------------
define method .postCreateCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.postCreate(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .postCreate(!args is ARRAY)

  -- Initialise
  !d2Element = TRUE
  !d3Ele = !args[0].dbref()
  !d3EleName = !d3Ele.fullname
  !d2Ele = !args[1].dbref()
  handle any
    !d2Ele = object DBREF()
  endhandle
  !d2EleName = !d2Ele.fullname
  handle any
    -- no matching 2D
    !d2Element = FALSE
    !d2EleName = ''
  endhandle

  if (!this.debug) then
    !output = 'integratorSupportHandler.postCreateCallback(' & !d3EleName & ', ' & !d2EleName & ')'
    write !output
    !this.isRefNo('integratorSupportHandler.postCreateCallback', !args[0])
    !this.isRefNo('integratorSupportHandler.postCreateCallback', !args[1])
  endif

  -- Save db position
  !saveCe = !!ce
  !!ce = !d3Ele
  !this.itemBuilt.append(!!ce)

  if (!d3Ele.type eq 'EQUI') then
    !this.equiBuilt.append(!!ce)
    if (!d2Element) then

      -- If the spref has not been set on the 2d item then try to find it from description
      if (!d2Ele.spre.unset()) then
        !desc = !d2Ele.desc.lowcase()
        if (!desc neq '' ) then
          !equiType = ARRAY()
          var !equiSpco coll all tabite with (SPTYPE OF TABGRO EQ 'EQUI')
          var !equiSpco append coll all spco with (PURP OF SPWL EQ 'EQUI' AND PURP OF SPEC EQ 'EQUI')
          do !i values !equiSpco
            !spcoDesc=!i.dbref().owner.desc.lowcase()
            if !spcoDesc.matchwild('*$!desc*') then
              !equiType.append(!i.dbref())
            endif
          enddo
          if (!equiType.size() ne 0 ) then
            !d3ele.spre = !equiType[1]
          endif
        endif
      endif

      -- If the spref has been set then instantiate the equipment template
      if (!d3Ele.spre.set()) then
        if (!d3Ele.spre.badref().not()) then

          -- Graphics mode only for common properties code
          if (not istty) then
            !comprop = object COMPROP()
            !comprop.initialise(!d3ele.spref)
            !comprop.setProperties(!d3ele)
            !comprop.unsetDesiElement()
          elseif (!d3Ele.spre.tmpref.set()) then
            if (!d3Ele.spre.tmpref.badref().not()) then
              if (!this.debug) then
                write 'Simple copy template'
              endif
              !tmpref = !d3Ele.spre.tmpref
              new tmpl
              copy rexe $!tmpref
              end
            endif
          endif

        endif
      endif
    endif

  elseif (!d3Ele.type eq 'SUBE') then
    if (!d2Element) then
      -- If the spref has been set then instantiate the sub equipment template
      if (!d3Ele.spre.set()) then
        if (!d3Ele.spre.badref().not()) then

          -- Graphics mode only for common properties code
          if (not istty) then
            !comprop = object COMPROP()
            !comprop.initialise(!d3ele.spref)
            !comprop.setProperties(!d3ele)
            !comprop.unsetDesiElement()
          elseif (!d3Ele.spre.tmpref.set()) then
            if (!d3Ele.spre.tmpref.badref().not()) then
              if (!this.debug) then
                write 'Simple copy template'
              endif
              !tmpref = !d3Ele.spre.tmpref
              new tmpl
              copy rexe $!tmpref
              end
            endif
          endif

        endif
      endif
    endif

  elseif (!d3Ele.type eq 'NOZZ') then
    !this.nozzBuilt.append(!d3Ele)
    -- Set a default height
    height 100mm
    -- Set HVAC duct size
    !nozz = object INTEGRATORNOZZLE(!d3Ele)
    !nozz.setDuctSize()
    -- Store any nozzle attributes
    !nozzAtts = ARRAY()
    do !i from 3
      break if (undefined(!args[!i]))
      !nozzAtts.append(!args[!i])
    enddo
    !this.nozzAtts.append(!nozzAtts)

  elseif (!d3Ele.type eq 'ELCONN') then
    !this.nozzBuilt.append(!d3Ele)
    -- Store any elconn attributes
    !nozzAtts = ARRAY()
    do !i from 3
      break if (undefined(!args[!i]))
      !nozzAtts.append(!args[!i])
    enddo
    !this.nozzAtts.append(!nozzAtts)

  elseif (!d3Ele.type eq |BRAN|) then
    if (!d3Ele.owner.type eq |PIPE|) then
      -- Check hbor
      if (!!ce.hbor.unset()) then
        if (!d2Element) then
          if (!d2Ele.owner.bore.set()) then
            !!ce.hbor = !d2Ele.owner.bore
          endif
        endif
      endif
      -- Choose hstube
      if (!!ce.pspe.badref()) then
        !this.addWarning(!!ce, 'HSTU not selected: PSPE not set')
      else
        !choices = select hstu
        handle any
          -- Selection not available or hbor not set
          !this.addWarning(!!ce, 'HSTU not selected: ' & !!error.text)
        elsehandle none
          if (!choices.size() eq 1) then
            !!ce.hstu = !choices[1]
          endif
        endhandle
      endif
    elseif (!d3Ele.owner.type eq |HVAC|) then
      -- Set HVAC branch details from SCHVAC settings
      if (!d2Element) then
        !!integratorHvac.setHstu(!d2Ele.owner.owner)
        !!integratorHvac.setBranchSize(!d2Ele.owner.owner)
      endif
      !!integratorHvac.setDesignCode()
    endif

  elseif (!d3Ele.type eq 'CABLE') then

  elseif (!d3Ele.type eq 'PIPE') then

  elseif (!d3Ele.type eq 'SITE') then

  elseif (!d3Ele.type eq 'ZONE') then

  elseif (!d3ele.owner.type eq 'BRAN') then
    -- May be single build component
    FCONN
    handle any
    endhandle
  endif

  -- Restore db position
  !!ce = !saveCe

endmethod
-- End of event callback definition for postCreate

------------------------------------------------------------------------
-- Method:      showForm
-- Description: Called when pml form displayed from context menu
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [Form name                         ]
-- !args[1-n] [R]  [STRING]   [Selected Element References       ]
------------------------------------------------------------------------
define method .showForm(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.showAppForm(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .showAppForm(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.showForm(...)'
    do !i from 1
      break if (undefined(!args[!i]))
      !this.isRefNo('integratorSupportHandler.showForm', !args[!i])
    enddo
  endif

  -- Graphics mode only
  if (not istty) then

    -- Show the Integrator view
    !this.showView()

    -- Hide or load nozzle details form
    if (defined(!!intEquiNozzSpec)) then
      if (!!intEquiNozzSpec.shown()) then
        hide !!intEquiNozzSpec
      endif
    else
      pml load form !!intEquiNozzSpec
    endif

    -- Hide or load pick connections form
    if (defined(!!intPickConn)) then
      if (!!intPickConn.shown()) then
        hide !!intPickConn
      endif
    else
      pml load form !!intPickConn
    endif

    -- Initialise
    !formName = |!!| & !args[0]
    !form     = $!formName
    !elements = ARRAY()
    do !i from 1
      break if (undefined(!args[!i]))
      !elements.append(!args[!i].dbref())
      !name = !elements.last().flnm
      if (!this.debug) then
        !output = 'Args[' & !i & '] ' & !name
        write !output
      endif
    enddo

    if (!form eq !!intEquiNozzSpec) then
      -- Setup and display nozzle spec form
      !this.showNozzForm(!elements)
    elseif (!form eq !!intPickConn) then
      -- Setup and display pick connection form
      !this.showConnForm(!elements)
    endif

  endif

endmethod
-- End of event callback definition for showAppForm

------------------------------------------------------------------------
-- Method:      showNozzForm
-- Description: Show nozzle details form from context menu
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      ARRAY       Elements to be processed
------------------------------------------------------------------------
define method .showNozzForm(!elements is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.showNozzForm()'
  endif

  -- Get drawlist
  !drawlist = !this.intDrawlist()

  -- Setup and display connection details form
  -- This menu entry is activated for:
  -- SCEQUI that is linked to an EQUI
  -- SCNOZZ or SCELCO that may or may not be linked itself, but is below an SCEQUI that is linked to an EQUI
  -- EQUI that is linked to an SCEQUI
  -- NOZZ or ELCONN that may or may not be linked itself, but is below an EQUI that is linked to an SCEQUI
  if (!elements.empty().not()) then

    -- Derive a single equipment from the selection
    !!ce = !elements[1]
    if (!!ce.type inset(|SCNOZZ|, |SCELCO|)) then
      SCEQUI
    endif
    if (!!ce.type eq |SCEQUI|) then
      if (!!ce.deslnk.size() gt 0) then
        if (!!ce.deslnk[1].set()) then
          if (!!ce.deslnk[1].badref().not()) then
            !!ce = !!ce.deslnk[1]
          endif
        endif
      endif
    endif
    if (!!ce.type inset(|NOZZ|, |ELCONN|)) then
      EQUI
    endif
    if (!!ce.type eq |EQUI|) then
      !isLinked = FALSE
      if (!!ce.schlnk.set()) then
        if (!!ce.schlnk.badref().not()) then
          !isLinked = TRUE
        endif
      endif
      if (!isLinked.not()) then
        return error 1 |Equipment must be linked for connection details form|
      endif
    else
      return error 1 |Cannot determine equipment for connection details form|
    endif

    -- Add to drawlist and set limits
    !drawlist.add(!!ce)
    !!gphviews.limits(!this.intForm.view, object VOLUME(!!ce))
    handle any
      -- May not have volume
    endhandle

    -- The form can be shown whether or not there are schematic nozzles to link
    !!intEquiNozzSpec.setup(!!ce)
    show !!intEquiNozzSpec free
  endif

endmethod
-- End of event callback definition for showNozzForm

------------------------------------------------------------------------
-- Method:      showConnForm
-- Description: Show pick connections form from context menu
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      ARRAY       Elements to be processed
------------------------------------------------------------------------
define method .showConnForm(!elements is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.showConnForm()'
  endif

  -- Setup and display pick connection form
  -- This menu entry is activated for:
  -- SCPLIN that is linked to a PIPE and has at least one SCBRAN below it that connects directly to an SCEQUI or an SCSUBE
  -- PIPE that is linked to an SCPLIN that has at least one SCBRAN below it that connects directly to an SCEQUI or an SCSUBE
  -- and similarly for SCHVAC and HVAC
  if (!elements.empty().not()) then
    !!intPickConn.clear()
    !this.pickConn = FALSE
    -- Derive data from selection
    do !selected values !elements

      -- Get linked pipe and scplin
      !scplin = object DBREF()
      !pipe   = object DBREF()
      !type   = |NOZZ|
      if (!selected.type inset(|PIPE|,|HVAC|)) then
        !pipe = !selected
        if (!selected.schlnk.set()) then
          if (!selected.schlnk.badref().not()) then
            !scplin = !selected.schlnk
          endif
        endif
      endif
      if (!selected.type inset(|SCPLIN|,|SCHVAC|)) then
        !scplin = !selected
        if (!selected.deslnk.size() gt 0) then
          if (!selected.deslnk[1].set()) then
            if (!selected.deslnk[1].badref().not()) then
              !pipe = !selected.deslnk[1]
            endif
          endif
        endif
      endif
      break if (!scplin.unset() or !pipe.unset())

      -- Get linked branch at head
      do !scbran values !scplin.members
        if (!scbran.type eq |SCBRAN|) then
          !bran = !scbran.bralnk.first().ref.string()
          handle any
          elsehandle none
            -- Check for head connected to scequi
            if (!scbran.href.set()) then
              if (!scbran.href.badref().not()) then
                if (!scbran.href.type inset(|SCEQUI|,|SCSUBE|)) then
                  -- Got scequi at head
                  !schlnk = !scbran.href.ref.string()
                  if (!scbran.href.type eq |SCSUBE|) then
                    !schlnk = !scbran.href.owner.ref.string()
                  endif
                  !conn = |HEAD|
                  !deslnk = !scbran.href.deslnk[1].ref.string()
                  handle any
                  elsehandle none
                    -- Got corresponding equi so setup form
                    !data    = ARRAY()
                    !data[0] = !type
                    !data[1] = !schlnk
                    !data[2] = !deslnk
                    !data[3] = !bran
                    !data[4] = !conn
                    !!intPickConn.setup(!data)
                    !this.pickConn = TRUE
                  endhandle
                endif
              endif
            endif
          endhandle

          -- Get linked branch at tail
          !bran = !scbran.bralnk.last().ref.string()
          handle any
          elsehandle none
            -- Check for tail connected to scequi
            if (!scbran.tref.set()) then
              if (!scbran.tref.badref().not()) then
                if (!scbran.tref.type inset(|SCEQUI|,|SCSUBE|)) then
                  -- Got scequi at tail
                  !schlnk = !scbran.tref.ref.string()
                  if (!scbran.tref.type eq |SCSUBE|) then
                    !schlnk = !scbran.tref.owner.ref.string()
                  endif
                  !conn = |TAIL|
                  !deslnk = !scbran.tref.deslnk[1].ref.string()
                  handle any
                  elsehandle none
                    -- Got corresponding equi so setup equi
                    !data    = ARRAY()
                    !data[0] = !type
                    !data[1] = !schlnk
                    !data[2] = !deslnk
                    !data[3] = !bran
                    !data[4] = !conn
                    !!intPickConn.setup(!data)
                    !this.pickConn = TRUE
                  endhandle
                endif
              endif
            endif
          endhandle

        endif
      enddo

    enddo
    -- Show connections form if selection required
    if (!this.pickConn) then
      show !!intPickConn free
    endif
  endif

endmethod
-- End of event callback definition for showConnForm

------------------------------------------------------------------------
-- Method:      selectInGrid
-- Description: List of items currently selected in the main grid
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0]  R      ARRAY     Elements to be processed
------------------------------------------------------------------------
define method .selectInGridCallback(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !this.selectInGrid(!args[0])
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
define method .selectInGrid(!args is ARRAY)

  if (!this.debug) then
    write 'integratorSupportHandler.selectInGridCallback(...)'
    do !arg values !args
      skip if (!arg eq |COMPARE| or !arg.trim() eq ||)
      !this.isRefNo('integratorSupportHandler.selectInGridCallback', !arg)
    enddo
  endif

  -- Graphics mode only
  if (not istty) then

    -- Get drawlist for view
    !drawlist = !this.intDrawlist()
    if (!drawlist.set()) then
      !members = !drawlist.members()

      -- Switch off autocolour
      AUTOCOLOUR OFF
      handle any
        -- Ignore error that can occur when this event called whilst in autoroute mode
      endhandle

      -- Build list of 3D elements to highlight
      !list3D = ARRAY()
      do !ele values !args
        skip if (!ele eq |COMPARE| or !ele.trim() eq ||)
        !element = !ele.dbref()
        handle (2,107)
          -- Deleted object
        elsehandle none
          if (!element.type inset('SCPLIN', 'SCHVAC', 'SCEQUI', 'SCOINS', 'SCCAB')) then
            !list3D.appendarray(!element.deslnk)
          elseif (!element.type inset('SCOPCI', 'SCOPCO')) then
            -- Ignore types with no 3D implications
          elseif (!element.owner.type inset('SCSEG', 'SCEQUI', 'SCSUBE')) then
            !list3D.appendarray(!element.deslnk)
          elseif (!element.type inset('PIPE', 'HVAC', 'EQUI', 'CABLE')) then
            !list3D.append(!element)
          elseif (!element.owner.type inset('BRAN', 'EQUI', 'SUBE', 'TMPL')) then
            !list3D.append(!element)
          endif
        endhandle
      enddo

      -- Build list of significant elements to highlight
      !listSig = ARRAY()
      do !element values !list3D
        skip if (!element.badref())
        if (!element.type inset('EQUI', 'CABLE') or !element.owner.type inset('BRAN', 'EQUI', 'SUBE', 'TMPL')) then
          !listSig.append(!element)
        elseif (!element.type inset('PIPE', 'HVAC')) then
          !listSig.appendarray(!element.members)
        endif
      enddo

      -- If highlighting a cable, make other cables translucent, otherwise make them all solid
      !translucency = 0
      do !element values !listSig
        if (!element.type eq 'CABLE') then
          !translucency = 80
          break
        endif
      enddo
      do !element values !members
        if (!element.badref().not()) then
          if (!element.type eq |CABLE|) then
            if (!listSig.findFirst(!element).set()) then
              !drawlist.translucency(!element, 0)
            else
              !drawlist.translucency(!element, !translucency)
            endif
          endif
        endif
      enddo

      -- Clear current highlighting, minimising visual properties updates
      !previousHighlighted = !this.highlightedElements
      !previousColours     = !this.originalColours
      do !i indices !this.highlightedElements
        !element = !this.highlightedElements[!i]
        if (!element.badref().not()) then
          if (!element.type inset(|EQUI|,|SUBE|,|CABLE|,|BRAN|)) then
            -- Reset colours on significant elements that are in drawlist and not about to be highlighted again
            if (!members.findFirst(!element).set()) then
              if (!listSig.findFirst(!element).unset()) then
                !drawlist.colour(!element, !this.originalColours[!i])
              endif
            endif
          elseif (!element.owner.type eq |BRAN| or !element.type inset(|NOZZ|,|ELCONN|)) then
            -- Reset colours on nozzles and components that are in drawlist and who or whose owners are not about to be highlighted again
            if (!drawlist.primitives(!element.owner).findFirst(!element).set()) then
              if (!listSig.findFirst(!element).unset() and !listSig.findFirst(!element.owner).unset()) then
                !drawlist.colour(!element, !this.originalColours[!i])
              endif
            endif
          endif
        endif
      enddo
      !this.highlightedElements.clear()
      !this.originalColours.clear()

      -- Get new list for highlighting, storing original colours for clearing next time
      !list = ARRAY()
      do !element values !listSig
        if (!members.findFirst(!element).set() or !members.findFirst(!element.owner).set()) then
          -- Store colour for significant element
          !list.append(!element)
          -- Carry forward original colour if previously in list, minimising visual properties updates
          !i = !previousHighlighted.findFirst(!element)
          if (!i.set()) then
            !originalColour = !previousColours[!i]
          else
            !originalColour = !drawlist.colour(!element)
          endif
          !this.highlightedElements.append(!element)
          !this.originalColours.append(!originalColour)
          -- Store primitive colours for components and nozzles
          if (!element.type inset(|BRAN|,|EQUI|,|SUBE|)) then
            do !primitive values !drawlist.primitives(!element)
              if (!element.type eq |BRAN| or !primitive.type inset(|NOZZ|,|ELCONN|)) then
                !i = !previousHighlighted.findFirst(!primitive)
                if (!i.set()) then
                  !originalColour = !previousColours[!i]
                else
                  !originalColour = !drawlist.colour(!primitive)
                endif
                -- Primitive colour of zero means it has not been coloured itself on top of significant element
                if (!originalColour gt 0) then
                  !this.highlightedElements.append(!primitive)
                  !this.originalColours.append(!originalColour)
                endif
              endif
            enddo
          endif
        endif
      enddo

      -- Highlight new list
      if (!list.empty().not()) then
        !drawlist.colour(!list, !!integrator.getHighlightColour())
        handle any
          !drawlist.colour(!list, !!gphColOpt.highlight.code)
        endhandle
      endif

      -- Reset autocolour setting
      !!gphColOpt.coreSettings()
      handle any
        -- Ignore error that can occur when this event called whilst in autoroute mode
      endhandle

    endif
  endif

endmethod
-- End of event callback definition for selectInGrid

------------------------------------------------------------------------
-- Method:      copyHvacSize
-- Description: Copy HVAC size from 2D to 3D
-- Method Type: PML Event
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
-- !args[0] [R]    [STRING]   [reference to 2D element]
-- !args[1] [R]    [STRING]   [reference to 3D element]
-- !args[2] [R]    [STRING]   [ppoint]
-- !args[3] [R]    [STRING]   [new size, e.g. RECT 200mm x 300mm]
------------------------------------------------------------------------
define method .copyHvacSize(!args is ARRAY)

  -- Wrapped method for error trapping from core callback
  !!integratorHvac.copyHvacSize(!args)
  handle any
    !this.traceBack()
  endhandle

endmethod

------------------------------------------------------------------------
-- Method:      debugOn
-- Description: Set debug flag
------------------------------------------------------------------------
define method .debugOn()

  -- Set debug flag
  !this.debug = TRUE

endmethod

------------------------------------------------------------------------
-- Method:      debugOff
-- Description: Clear debug flag
------------------------------------------------------------------------
define method .debugOff()

  -- Clear debug flag
  !this.debug = FALSE

endmethod

------------------------------------------------------------------------
-- Method:      traceBack
-- Description: Output traceback for most recent error
------------------------------------------------------------------------
define method .traceBack()

  -- Format traceback for writing to commands view
  !errorText    = !!error.text
  !errorLine    = !!error.line
  !errorCommand = !!error.command
  write !errorText !errorLine !errorCommand
  do !stack values !!error.callstack
    write !stack
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      isRefNo
-- Description: Check that supplied string is a ref number
-- Method Type: Function
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      STRING      Calling method
--    2     R      STRING      Candidate ref number to be checked
------------------------------------------------------------------------
define method .isRefNo(!method is STRING, !refNo is STRING)

  -- Check for ref number, not name, to avoid confusion, as 2D and 3D elements could have the same name
  if (!refNo.set()) then
    if (!refNo.subString(1,1) ne |=| and !refNo.subString(1,16) ne |ileave tube of =|) then
      !message = |Method | & !method & | | & !refNo & | should be a ref number|
      write !message
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      addInfo
-- Description: Output an info message to the dialogue
-- Method Type: Function
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      DBREF       Object concerned
--    2     R      STRING      Message text
------------------------------------------------------------------------
define method .addInfo(!item is DBREF, !message is STRING)

  -- Output the message
  !this.addMessage('3', !item, !message)

endmethod

------------------------------------------------------------------------
-- Method:      addWarning
-- Description: Output a warning message to the dialogue
-- Method Type: Function
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      DBREF       Object concerned
--    2     R      STRING      Message text
------------------------------------------------------------------------
define method .addWarning(!item is DBREF, !message is STRING)

  -- Output the message
  !this.addMessage('4', !item, !message)

endmethod

------------------------------------------------------------------------
-- Method:      addMessage
-- Description: Output a message to the dialogue
-- Method Type: Function
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--    1     R      STRING      Severity
--    2     R      DBREF       Object concerned
--    3     R      STRING      Message text
------------------------------------------------------------------------
define method .addMessage(!severity is STRING, !item is DBREF, !message is STRING)

  -- Output the message and object concerned
  -- Severity is a string which determines the icon
  -- '0' - None, blank
  -- '1' - Query, Question Mark
  -- '2' - OK, Green Tick
  -- '3' - Info, Blue (i)
  -- '4' - Warning, Yellow triangle
  -- '5' - Minor Error, Plain Red Blob
  -- '6' - Major Error, Red Blob with white shriek
  -- '7' - Critical Error, Red Blob with white X
  !errorMessage = !item.flnm & ' ' & !message
  if (!this.debug or istty) then
    if (!severity eq '4') then
      !errorMessage = 'Warning: ' & !errorMessage
    endif
    write !errorMessage
  endif
  if (not istty) then
    !items    = ARRAY()
    !items[1] = !item.name
    !!integrator.messagesAdd(!severity, !errorMessage, !errorMessage, !items)
    handle any
      if (!severity eq '4') then
        !errorMessage = 'Warning: ' & !errorMessage
      endif
      if (!this.debug.not()) then
        write !errorMessage
      endif
    elsehandle none
      !!integrator.messagesShow()
    endhandle
  endif

endmethod

------------------------------------------------------------------------
-- Method:      highlighted
-- Description: Output list of what is currently highlighted
------------------------------------------------------------------------
define method .highlighted()

  -- Write out the stored elements that have been highlighted along with their original colours
  do !i indices !this.highlightedElements
    if (!this.highlightedElements[!i].badref().not()) then
      !colour = !!colourName(!this.originalColours[!i])
      if (!colour.unset()) then
        !colour = !this.originalColours[!i].string()
      endif
      !output = '[' & !i & '] ' & !this.highlightedElements[!i].flnm & ' Colour ' & !colour
      if (not !this.highlightedElements[!i].type inset(|EQUI|,|SUBE|,|CABLE|,|BRAN|)) then
        !output = '  ' & !output
      endif
      write !output
    endif
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      selectConfig
-- Description: Select a config file
------------------------------------------------------------------------
define method .selectConfig()

  -- Show file browser to select config file
  var !project project code
  !!fileBrowser(|%| & !project & |dflts%\ModelManagement|, |*.xml|, |Select Config File|, TRUE, |!!integratorSupportHandler.useConfig(!!fileBrowser.file)|)

endmethod

------------------------------------------------------------------------
-- Method:      useConfig
-- Description: Use the selected config file
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Config filename
------------------------------------------------------------------------
define method .useConfig(!filename is STRING)

  -- Use selected config file
  var !project project code
  !file = object FILE(|%| & !project & |dflts%\ModelManagement\| & !filename)
  if (!file.exists()) then
    !this.useConfig(!file)
  else
    return error 1 |Config file does not exist|
  endif

endmethod

------------------------------------------------------------------------
-- Method:      useConfig
-- Description: Use the selected config file
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Config file
------------------------------------------------------------------------
define method .useConfig(!file is FILE)

  -- Use selected config file
  var !project project code
  !defaultName  = |%| & !project & |dflts%\ModelManagement\ProjectConfiguration.xml|
  !defaultFile  = object FILE(!defaultName)
  if (!file.entry() ne !defaultFile.entry()) then
    !defaultFile.deleteFile()
    !file.copy(!defaultName)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      compareDiagram
-- Description: Compare the contents of a diagram and view the report
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Diagram
------------------------------------------------------------------------
define method .compareDiagram(!diagram is DBREF)

  -- Compare the diagram and view the report
  !this.compareDiagram(!diagram, true, false, false)

endmethod

------------------------------------------------------------------------
-- Method:      processDiagram
-- Description: Compare the contents of a diagram and process the report
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Diagram
------------------------------------------------------------------------
define method .processDiagram(!diagram is DBREF)

  -- Compare the diagram and process the report
  !this.compareDiagram(!diagram, false, false, true)

endmethod

------------------------------------------------------------------------
-- Method:      compareDiagram
-- Description: Compare the contents of a diagram
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Diagram
--    2   R      BOOLEAN     View report on screen
--    3   R      BOOLEAN     Save report XML file
--    4   R      BOOLEAN     Process report to text file
------------------------------------------------------------------------
define method .compareDiagram(!diagram is DBREF, !viewReport is BOOLEAN, !saveReport is BOOLEAN, !processReport is BOOLEAN)

  -- Collect all main types for this diagram (excluding offline instruments)
  if (!diagram.type ne |SCDIAG|) then
    return error 1 |Not a diagram|
  endif
  var !items collect all (SCEQUI SCPLIN SCHVAC SCCAB)
  !contents = ARRAY()
  do !item values !items
    !match = !item.dbref().diaref.findFirst(!diagram).set()
    handle any
      !match = false
    endhandle
    if (!match) then
      !contents.append(!item)
    endif
  enddo

  -- Compare the diagram
  !!integrator.setReportVisible(!viewReport and not istty)
  if (!saveReport or !processReport) then
    !!integrator.setReportPath(!diagram.namn & |.xml|)
  endif
  !!integrator.compare(!contents)
  handle any
    write !!error.text
  endhandle
  if (!processReport) then
    if (!saveReport) then
      !processAction = |keep|
    else
      !processAction = |move|
    endif
    !this.processReport(!diagram.namn & |.xml|, !processAction)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      processReport
-- Description: Process a compare report file
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Compare report filename
--    2   R      STRING      Action on report file - keep, delete, move (to pdmswk)
------------------------------------------------------------------------
define method .processReport(!reportFilename is STRING, !action is STRING)

  -- Open files
  !outputFilename = !reportFilename.before(|.xml|) & |.txt|
  !reportFile = object FILE(!reportFilename)
  !outputFile = object FILE(!outputFilename)
  !reportFile.open(|Read|)

  -- Initialise
  !elements    = ARRAY()
  !elementKeys = ARRAY()
  !comments    = ARRAY()
  !commentKeys = ARRAY()
  !output      = ARRAY()
  !stateDescription = ||
  !displayTag1      = ||
  !displayTag2      = ||
  !comment          = ||
  !key              = ||
  !inElement   = FALSE
  !inAttribute = FALSE
  !inComment   = FALSE

  -- Loop through the file
  do !i
    -- Stop infinite looping if something unexpected has happened (file is typically 50000 lines so stop at 10x)
    break if (!i eq 500000)
    -- Process record by record as file is too long to read in one go
    !record = !reportFile.readrecord()
    handle any
      break
    endhandle
    break if (!record.unset())

    -- Find start and end of Attributes section which follows Elements and precedes Comments sections
    if (!inAttribute.not()) then
      !inAttribute = (!record.trim() eq |<Attributes>|)
    else
      skip if (!record.trim() ne |<Comments>|)
      !inAttribute = FALSE
    endif

    -- Find start and end of Elements block
    if (!inElement.not()) then
      !inElement = (!record.trim() eq |<Elements>|)
    else
      !inElement = (!record.trim() ne |</Elements>|)

      -- Key
      if (!record.trim().match(|<Key>|) eq 1) then
        !key = !record.after(|<Key>|).before(|</Key>|)
      endif

      -- State description
      if (!record.trim().match(|<StateDescription>|) eq 1) then
        !stateDescription = !record.after(|<StateDescription>|).before(|</StateDescription>|)
      endif

      -- Display tag 1
      if (!record.trim().match(|<DisplayTag1>|) eq 1) then
        !displayTag1 = !record.after(|<DisplayTag1>|).before(|</DisplayTag1>|)
      endif

      -- Display tag 2
      if (!record.trim().match(|<DisplayTag2>|) eq 1) then
        !displayTag2 = !record.after(|<DisplayTag2>|).before(|</DisplayTag2>|)
      endif

      -- Store the element key and record
      if (!inElement.not() and !stateDescription ne |ROOT|) then
        !elementKeys.append(!key)
        !elements.append(!stateDescription & | :: | & !displayTag1 & | :: | & !displayTag2)
        !stateDescription = ||
        !displayTag1      = ||
        !displayTag2      = ||
        !comment          = ||
        !key              = ||
      endif

    endif

    -- Find start and end of Comments block
    if (!inComment.not()) then
      !inComment = (!record.trim() eq |<Comments>|)
    else
      !inComment = (!record.trim() ne |</Comments>|)

      -- Key
      if (!record.trim().match(|<Key>|) eq 1) then
        !key = !record.after(|<Key>|).before(|</Key>|)
      endif

      -- Comment
      if (!record.trim().match(|<Comment>|) eq 1) then
        !comment = !record.after(|<Comment>|).before(|</Comment>|)
      endif

      -- Store the comment key and record
      if (!inComment.not()) then
        !commentKeys.append(!key)
        !comments.append(!comment)
        !comment = ||
        !key = ||
      endif

    endif
  enddo

  -- Sort and output the data
  do !i indices !elementKeys
    !output.append(!elements[!i])
    do !j indices !commentKeys
      if (!commentKeys[!j] eq !elementKeys[!i]) then
        !output.append(!comments[!j])
      endif
    enddo
  enddo
  !outputFile.writeFile(|Overwrite|, !output)

  -- Tidy up and move original report file so it is not compared
  !reportFile.close()
  if (!action.lowcase() eq |move|) then
    !newFile = object FILE(|%pdmswk%/| & !reportFile.entry())
    if (!newFile.exists()) then
      !newFile.deleteFile()
    endif
    !reportFile.move(!newFile)
  elseif (!action.lowcase() eq |delete|) then
    !reportFile.delete()
  endif

endmethod

------------------------------------------------------------------------
-- Method:      compareSummary
-- Description: Return the compare summary statistics
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of strings of compare summary
------------------------------------------------------------------------
define method .compareSummary() is ARRAY

  -- Initialise
  !data            = ARRAY()
  !subTotals       = ARRAY()
  !typeCategory    = ARRAY()
  !compareCategory = ARRAY()

  -- Get the compare summary statistics
  !!integrator.getCompareSummary(!subTotals, !typeCategory, !compareCategory)
  do !i indices !typeCategory
    -- First total is number compared for this type category
    if (!subTotals[!i][1] gt 0) then
      do !j indices !compareCategory
        if (!j eq 1) then
          -- Total for type category
          !data.append(|Number of | & !typeCategory[!i] & | compared,| & !subTotals[!i][!j])
        elseif (!subTotals[!i][!j] gt 0) then
          -- Ignore categories where none found: 0, switched off: -1, not applicable: -2
          !data.append(!compareCategory[!j] & |,| & !subTotals[!i][!j])
        endif
      enddo
    endif
  enddo
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      printSummary
-- Description: Output the compare summary statistics
------------------------------------------------------------------------
define method .printSummary()

  -- Output the compare summary statistics
  do !line values !this.compareSummary()
    !category = !line.before(|,|)
    !count    = !line.after(|,|)
    if (!category.subString(1, 9) eq |Number of|) then
      !spaces = 0
    elseif (!category.subString(1, 8) eq |Compared|) then
      !spaces = 2
    else
      !spaces = 4
    endif
    !width = 48 - !spaces
    var !text compose spaces $!spaces |$!category| width $!width left |$!count| width 4 right
    write !text[1]
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      acceptedDifferences
-- Description: Return the differences accepted
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of strings of accepted differences
------------------------------------------------------------------------
define method .acceptedDifferences() is ARRAY

  -- Initialise
  !data = ARRAY()

  -- Collect all accepted missing and disabled matching
  var !groupItems collect all GPITEM with (function of owner eq 'aveva.integrator.group' and :ACCEPT2D3DDIFFERENCE eq TRUE)
  var !items      evaluate  FLNM of SITEM     for all from !groupItems
  var !matches    evaluate :MATCHINGENABLED   for all from !groupItems
  var !groupDates evaluate :AVINT_UPDATE_DATE for all from !groupItems
  var !groupUsers evaluate :AVINT_UPDATE_USER for all from !groupItems

  -- Collect all accepted differences
  var !linkItems  collect all CYMLNK with (:ACCEPT2D3DDIFFERENCE eq TRUE)
  var !schlnks    evaluate  FLNM of SCHLNK    for all from !linkItems
  var !linkDates  evaluate :AVINT_UPDATE_DATE for all from !linkItems
  var !linkUsers  evaluate :AVINT_UPDATE_USER for all from !linkItems

  -- Assemble data
  !data = ARRAY()
  do !i indices !groupItems
    if (!items[!i] ne 'unset') then
      if (!matches[!i].boolean()) then
        !data.append(|Accepted missing element | & !items[!i] & | by | & !groupUsers[!i] & | at | & !this.formatDate(!groupDates[!i]))
      else
        !data.append(|Disabled matching on | & !items[!i] & | by | & !groupUsers[!i] & | at | & !this.formatDate(!groupDates[!i]))
      endif
    endif
  enddo
  do !i indices !linkItems
    !data.append(|Accepted differences on | & !schlnks[!i] & | by | & !linkUsers[!i] & | at | & !this.formatDate(!linkDates[!i]))
  enddo
  return !data

endmethod

------------------------------------------------------------------------
-- Method:      formatDate
-- Description: Format accepted difference date string into dateTime object
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Encoded date and time like 20120525111241
-- Return:
--   [Data Type] [Description]
--    DATETIME    Date time of accepted difference
------------------------------------------------------------------------
define method .formatDate(!encodedDate is STRING) is DATETIME

  -- Format date from encoded string but leave out time
  !date = object DATETIME(!encodedDate.subString(1,4).real(), !encodedDate.subString(5,2).real(), !encodedDate.subString(7,2).real(), !encodedDate.subString(9,2).real(), !encodedDate.subString(11,2).real(), !encodedDate.subString(13,2).real())
  handle any
    -- String can be unset or content not valid
    !date = object DATETIME()
  endhandle
  return !date

endmethod
-- End of method definition for formatDate

------------------------------------------------------------------------
-- Method:      printAllAccepted
-- Description: Output all the accepted differences
------------------------------------------------------------------------
define method .printAllAccepted()

  -- Output the accepted differences
  do !line values !this.acceptedDifferences()
    write !line
  enddo

endmethod
