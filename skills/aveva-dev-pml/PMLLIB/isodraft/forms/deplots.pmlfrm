-- Created:         Thu Mar 13 11:45:06 GMT 1997
--
--
-- Description:
-- detail plotfiles definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  modify()                         -                   switch off NSBC if Display off
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dePlots

-- Define form
setup form !!dePlots

  !!dePlots.formTitle     = 'Detail Plots'
  !!dePlots.iconTitle     = 'Details'
  !!dePlots.callback      = 'call !!dePlotsInit()'
  !!dePlots.formRevision  = ' $Revision: 1.17 $ '

  -- Body of form definition

-- set up local form variables/members
  member .units is STRING
  member .allunits is STRING
  member .params is ARRAY
  member .newParamData is ARRAY
  member .thisFile is STRING
  member .thisIndex is REAL
  member .reshow is BOOLEAN
  member .manual is BOOLEAN
  member .valid is BOOLEAN
  member .pardef is BOOLEAN
  member .copying is BOOLEAN
  member .modifying is BOOLEAN
  member .okForm is BOOLEAN
  member .altered is BOOLEAN

  !!dePlots.okForm = TRUE
  !!dePlots.manual = FALSE


-- Detail plots start position
  toggle .display ' Display Plots' at x1 ymax+0.5 callback |!!deplots.modify()| states 'TRUE' 'FALSE'

-- Detail plots NSBC
  toggle .nsbc ' Non-Standard Branch Connection Detail Plots' at xmax+1 ymin callback |!!deplots.modify()| states 'TRUE' 'FALSE'


  frame .posFrame 'Position Plotfiles' at xmin.display ymax+.5 width 70 height 8

    option .method 'Method         ' at xmin+1 ymin+1 callback 'call !!dePlotsValidate(5)' width 12

    option .dcorn  'Corner of First' at xmin.method ymax+0.5 width 12

-- Stacking
    text .stackVal 'Size of Stack              ' at xmax+3 ymin width 3 integer min 1 max 20

-- Alignment
    option .align    'First Direction' at xmin.dcorn ymax+.2 width 12

    option .stackDir 'Second Direction' at xmin.stackVal ymin callback 'call !!dePlotsValidate(4)' width 12

    text .xPos 'X position     '        at xmin.dcorn ymax+.2 callback 'call !!dePlotsValidate(1)' width 12 isou
    para .xunits at xmax ymin width 3 lines 1
    text .yPos 'Y position      ' at xmin.stackVal ymin callback 'call !!dePlotsValidate(2)' width 12 isou
    para .yunits at xmax ymin width 3 lines 1

-- height & Scale factor
    text .charHeight    'Char height    '        at xmin.dcorn ymax+.2 callback 'call !!dePlotsValidate(3)' width 12 isou
    para .hunits at xmax ymin width 3 lines 1
    text .scale 'Scale Factor               ' at xmin.stackVal ymin width 3 integer min 50 max 200
  exit

-- 2nd frame
  frame .paramFrame 'Parameterised Plotfiles' at xmin.posFrame ymax.posFrame+0.5 width 70 height 10

    button .new at xmin.paramFrame+2 ymin.paramFrame+1 ' New...  ' callback 'call !!dePlotsNew()'

    list .plotnames 'PlotfileNames' at xmin ymax+0.5 width 62 length 8

    button .modify at xmin   ymax+0.2    'Modify...' callback 'call !!dePlotsMod()'
    button .copy   at xmax+15.5 ymin   ' Copy... ' callback 'call !!dePlotsCopy()'
    button .delete at xmax+15.5 ymin   ' Delete  ' callback 'call !!dePlotsDel()'

  exit

-- Dismiss the form
  button .ok     at xmin_posFrame+53    ymax+0.5 '  OK  ' callback 'call !!dePlotsEnd()' ok
  button .cancel at xmax form-size ymin     'Cancel' callback 'call !!dePlotsConfirm()' cancel


exit
-- End of form definition for !!dePlots


-- set up form lists
!a = ARRAY()
!a.append('top left')
!a.append('top right')
!a.append('bottom left')
!a.append('bottom right')
!!dePlots.dcorn.dText = !a

!a.clear()
!a.append('Up')
!a.append('Down')
!a.append('Left')
!a.append('Right')
!!dePlots.align.dText = !a
!!dePlots.stackDir.dText = !a

!a.clear()
!a.append('Stacking')
!a.append('Manual')
!!dePlots.method.dText = !a

!a.clear()

------------------------------------------------------------------------
--
-- Method:      !modify()
--
-- Description: switch off NSBC if Display off
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------
define method .modify()

if (!!dePlots.display.val.not()) then
  !!dePlots.nsbc.val = FALSE
endif

endmethod
-- End of method definition for .modify()
