--
--
-- Description:
-- form for parameterised attributes on detail plots
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!detParams

-- Define form
setup form !!detParams

  !!detParams.formTitle     = 'Parameters for Detail Plots'
  !!detParams.iconTitle     = 'Parameters'
  !!detParams.callback      = 'call !!detParamsInit()'
  !!detParams.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
-- set up local form variables/members

  member .attArray is ARRAY
  member .valid is BOOLEAN

-- Parameterised plotfiles

  text .plotFilename 'Filename' at x1 ymin+.5 callback 'call !!detParamsFile()' width 40 string

  button   .browse at xmax ymin  ' Browse...' callback  'call !!detParamsBrowse()'

  frame .attData 'Attribute Data' at xmin.plotFilename ymax+.5 width 56 height 6
    text .attName 'Attribute  '  at xmin+1 ymin+1 width 8 string
    text .xPos 'X position ' at xmin.attName ymax+.2 callback 'call !!detParamsVal(1)' width 8 isou
    text .yPos 'Y position' at xmax+4 ymin callback 'call !!detParamsVal(2)' width 8 isou
    text .charHeight 'Char height'at xmin.attName ymax+.2 callback 'call !!detParamsVal(3)' width 8 isou
    text .angle 'Angle     ' at xmax+4 ymin callback 'call !!detParamsVal(4)' width 8 isou



    button   .include at xmin.attName ymax+.5  ' Include ' callback 'call !!detParamsInc()'
    button   .replace at xmax+10 ymin          ' Replace ' callback 'call !!detParamsReplace()'
    button   .remove  at xmax+10 ymin          ' Remove  ' callback 'call !!detParamsRemove()'
  exit
-- attribute Lists
  list .attributes ' Attributes' at xmin.plotFilename ymax+.5 callback 'call !!detParamsAtts()' width 55 length 8
  path right


-- Dismiss the form
  button .ok at xmin.plotFilename ymax+1 '  OK  ' callback 'call !!detParamsEnd()' ok
  button .cancel at xmax form-size  ymin 'Cancel' callback 'call !!detParamsClear()' cancel


exit
-- End of form definition for !!detParams
