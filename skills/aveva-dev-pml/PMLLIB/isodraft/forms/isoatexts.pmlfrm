--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        isodraft
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Mar 19 08:53:04 GMT 1998
--
--
-- Description:
-- Display and modify alternative texts
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
-- Amendments
--
-- Init Date       Ref     Description
-- ---- ---------- ------- ---------------------------------------------
-- NJSB 08/05/2007 DUN0741 (Isometrics containing Out of Spec Components)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applySetting(BOOLEAN)            -                   apply user modifications
--  atextGroup()                     -                   action on selecting atext group
--  atextGroups()                    -                   define indices of atexts for each group
--  atextList()                      -                   action on selecting atext from list
--  atextOption()                    -                   action on choose default or user text
--  init()                           -                   initialisation
--  isoAtexts()                      -                   constructor
--  ok()                             -                   action on ok
--  setAtextDisplay(BOOLEAN)         -                   display current atext
--  setAtextList()                   -                   list the atext values and define data member if unset
--  setDfltAtexts()                  -                   set the default atext values
--  setGroupList()                   -                   set atext groups
--
------------------------------------------------------------------------

setup form !!isoAtexts

  !!isoAtexts.formTitle     = 'Alternative Texts'
  !!isoAtexts.iconTitle     = 'Atexts'
  !!isoAtexts.callback      = '!!isoAtexts.init()'
  !!isoAtexts.formRevision  = 'Revision$ '

  -- Body of form definition

  -- initial value before modification used to control apply activation
  member .initialIndex is REAL
  member .initialValue is STRING
  member .initialMode is STRING

  member .currentGroup is STRING
  member .currentMode is STRING

  member .saveList is ARRAY

  -- store newline character
  member .newline is STRING

  -- store atexts in sparse array
  member .atextUserValue is ARRAY
  member .atextMode   is ARRAY

  -- store default values
  member .defaultAtexts is ARRAY

  -- store index numbers of all atexts for each group
  member .drwgAreaIndex   is ARRAY
  member .matListIndex    is ARRAY
  member .titleBlockIndex is ARRAY
  member .weldBoxIndex    is ARRAY
  member .lineSummIndex   is ARRAY
  member .bendTableIndex  is ARRAY
  member .boltReportIndex is ARRAY

  frame .selectAtext 'Select Atext' at xmin ymax+0.2
    option .atextGroup at xmin+1 ymax width 20
    list .atextList at xmin ymax+0.2 width 32 height 16
  exit

  frame .editAtext 'Edit Atext' at xmin.selectAtext ymax+0.5
    option .atextOption at xmin+1 ymax width 12
    textpane .atextSetting at xmin ymax+0.2 width 34 height 3
  exit

  button .apply   '  OK  ' at xmin.selectAtext+19.5 ymax+0.5 ok
  button .dismiss 'Cancel' at xmax form-size ymin cancel

exit
-- End of form definition for !!isoAtexts

------------------------------------------------------------------------
--
-- Method:      !isoAtexts()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .isoAtexts()

  -- set callbacks
  !this.atextGroup.callback = '!!isoAtexts.atextGroup()'
  !this.atextList.callback = '!!isoAtexts.atextList()'
  !this.atextOption.callback = '!!isoAtexts.atextOption()'
  !this.okCall = '!!isoAtexts.ok()'

  -- populate option
  !dText[1] = 'Default text'
  !rText[1] = 'DEFAULT'
  !dText[2] = 'User text'
  !rText[2] = 'USER'
  !dText[3] = 'Switched off'
  !rText[3] = 'OFF'
  !this.atextOption.dText = !dText
  !this.atextOption.rText = !rText

  -- store return character
  !this.newline = '
'

  -- setup default atext values
  !this.setDfltAtexts()

  -- setup group atext indices
  !this.atextGroups()

  -- populate group list
  !this.setGroupList()

endmethod
-- End of method definition for .isoAtexts()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- clear the data stores
  !this.atextUserValue = ARRAY()
  !this.atextMode = ARRAY()
  !this.saveList = ARRAY()

  !this.initialMode = STRING()
  !this.initialValue = STRING()
  !this.initialIndex = REAL()

  !this.currentGroup = !this.atextGroup.selection()
  !this.currentMode = !this.atextOption.selection()

  -- setup atext list
  !this.setAtextList()

  !this.setAtextDisplay(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !atextGroup()
--
-- Description: action on selecting atext group
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .atextGroup()

  if (!this.atextGroup.selection() eq !this.currentGroup) then
    !this.applySetting(true)

  else
    -- display first atext
    !this.setAtextList()

    -- display current selection
    !this.setAtextDisplay(true)

    !this.currentGroup = !this.atextGroup.selection()
  endif

endmethod
-- End of method definition for .atextGroup()

------------------------------------------------------------------------
--
-- Method:      !atextList()
--
-- Description: action on selecting atext from list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .atextList()

  !listPos = !this.atextList.val
  !indexString = !this.atextList.selection()

  do
    !listPos = !listPos - 1
    if (!listPos lt 1) then
      !this.atextList.val = 1
      break
    elseif (!this.atextList.rText[!listPos] ne !indexString) then
      !this.atextList.val = !listPos + 1
      break
    endif
  enddo

  !this.applySetting(true)

  -- display first atext
  !this.setAtextDisplay(true)

endmethod
-- End of method definition for .atextList()

------------------------------------------------------------------------
--
-- Method:      !setAtextDisplay()
--
-- Description: display current atext
--
-- Method Type: Procedure
-- Arguments:
--  [1]  [BOOLEAN]  [Flag to indicate setting of initial values]
--
------------------------------------------------------------------------

define method .setAtextDisplay(!initial is BOOLEAN)

  -- get atext index number
  !index = !this.atextList.selection().real()

  if (!initial) then
    -- store the initial settings
    !this.initialIndex = !this.atextList.selection().real()
    !this.initialMode = !this.atextMode[!index]
    !this.initialValue = !this.atextUserValue[!index]
  endif

  if (!this.atextMode[!index] eq 'DEFAULT') then
    !this.atextOption.select('rtext', 'DEFAULT')
    !dText[1] = !this.defaultAtexts[!index]
    !this.atextSetting.val = !dText

  elseif (!this.atextMode[!index] eq 'USER') then
    !this.atextOption.select('rtext', 'USER')
    !dText[1] = !this.atextUserValue[!index]
    !this.atextSetting.val = !dText

  else
    !this.atextOption.select('rtext', 'OFF')
    !dText[1] = ''
    !this.atextSetting.val = !dText
  endif

  -- activate user textpane if appropriate
  !this.atextSetting.active = (!this.atextOption.selection() eq 'USER')
  if (!this.atextSetting.active) then
    !this.atextSetting.setFocus()
  endif

  !this.currentMode = !this.atextOption.selection()

endmethod
-- End of method definition for .setAtextDisplay(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !atextOption()
--
-- Description: action on choose default or user text
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .atextOption()

  !storePos = !this.atextOption.val

  !this.atextOption.select('rtext', !this.currentMode)

  !this.applySetting(false)

  !this.atextOption.val = !storePos

  -- get atext index number
  !index = !this.atextList.selection().real()

  -- set the atext mode
  !this.atextMode[!index] = !this.atextOption.selection()

  !this.setAtextDisplay(false)

endmethod
-- End of method definition for .atextOption()

------------------------------------------------------------------------
--
-- Method:      !applySetting()
--
-- Description: apply user modifications
--
-- Method Type: Procedure
-- Arguments:
--  [1]  [BOOLEAN]  [Flag to indicate list rebuild]
--
------------------------------------------------------------------------

define method .applySetting(!rebuild is BOOLEAN)

    -- get atext index number
  !index = !this.initialIndex

  if (!this.atextOption.selection() eq 'USER') then
    -- build up atext from lines
    !atextValue = !this.atextSetting.line(1)
    handle (61,609)
      !atextValue = ''
    endhandle
    do !i from 2 to !this.atextSetting.count
      !atextValue = !atextValue & !this.newline & !this.atextSetting.line(!i)
    enddo
    !this.atextUserValue[!index] = !atextValue
  endif
  !this.atextMode[!index] = !this.atextOption.selection()

  !saveFlag = false
  if (!this.atextMode[!index] ne !this.initialMode or !this.atextUserValue[!index] ne !this.initialValue) then
    if (!this.saveList.findFirst(!index).unset()) then
      !this.saveList.append(!index)
    endif
    !saveFlag = true
  endif

  if (!rebuild and !saveFlag) then
    !storeListPos = !this.atextList.selection()

    !replIndices = !this.atextList.rText.find(!index.string())
    !dText = !this.atextList.dText
    !rText = !this.atextList.rText

    if (!this.atextMode[!index] eq 'DEFAULT') then
      !atextString = !this.defaultAtexts[!index]
    elseif (!this.atextMode[!index] eq 'USER') then
      !atextString = !this.atextUserValue[!index]
    else
      !atextString = '  '
    endif

    !newDtext = ARRAY()
    !newRtext = ARRAY()

    !lines = !atextString.split(!this.newline)
    do !i indices !lines
      if (!i eq 1) then
        !newDtext.append(!index & '  ' + !lines[!i])
      else
        !newDtext.append('     ' + !lines[!i])
      endif
      !newRtext.append(!index.string())
    enddo

    !dText.removeFrom(!replIndices[1], !replIndices.size())
    !rText.removeFrom(!replIndices[1], !replIndices.size())

    !dText.insertArray(!replIndices[1], !newDtext)
    !rText.insertArray(!replIndices[1], !newRtext)

    !this.atextList.dText = !dText
    !this.atextList.rText = !rText
    !this.atextList.select('rtext', !storeListPos)
  endif

endmethod
-- End of method definition for .applySetting(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action on ok
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ok()

  !this.applySetting(false)

  -- save all atexts in save list
  do !index values !this.saveList

    !mode = !this.atextMode[!index]
    !uText = !this.atextUserValue[!index]
    !dText = !this.defaultAtexts[!index]

    -- default text
    if (!mode eq 'DEFAULT' or (!mode eq 'USER' and !uText eq !dText)) then
      ATEXT $!<index>

    -- switched off, or user null text
    elseif (!mode  eq 'OFF' or (!mode eq 'USER' and !uText.empty())) then
      ATEXT $!<index> ''

    -- valid user text
    else

      -- allow for embedded quotes
      !atextValue = !this.atextUserValue[!index].replace(|'|, |''|)

      ATEXT $!<index> '$!<atextValue>'
    endif

  enddo

  -- Save options state
  !!isoSaveOptions()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !setGroupList()
--
-- Description: set atext groups
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setGroupList()

  !dText[1] = 'Drawing Area'
  !rText[1] = 'drwgAreaIndex'
  !dText[2] = 'Material List'
  !rText[2] = 'matListIndex'
  !dText[3] = 'Titleblock'
  !rText[3] = 'titleBlockIndex'
  !dText[4] = 'Weldbox'
  !rText[4] = 'weldBoxIndex'
  !dText[5] = 'Line Summary'
  !rText[5] = 'lineSummIndex'
  !dText[6] = 'Bend Table'
  !rText[6] = 'bendTableIndex'
  !dText[7] = 'Bolt Report'
  !rText[7] = 'boltReportIndex'

  !this.atextGroup.dText = !dText
  !this.atextGroup.rText = !rText

endmethod
-- End of method definition for .setGroupList()

------------------------------------------------------------------------
--
-- Method:      !setAtextList()
--
-- Description: list the atext values and define data member if unset
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setAtextList()

  !atextData = !this.atextGroup.selection()
  !dText = ARRAY()
  !rText = ARRAY()

  -- loop through index list and get atext values
  do !index values !this.attribute(!atextData)
    if (undefined(!this.atextMode[!index])) then
      -- get atext value
      var !atext RAW ATEXT $!<index>
      if (!atext.trim().upcase() eq 'UNSET') then
        !this.atextMode[!index] = 'DEFAULT'
        !this.atextUserValue[!index] = !this.defaultAtexts[!index]
      elseif (!atext.trim().empty()) then
        !this.atextMode[!index] = 'OFF'
        !this.atextUserValue[!index] = !this.defaultAtexts[!index]
      else
        !this.atextMode[!index] = 'USER'
        !this.atextUserValue[!index] = !atext
      endif

    endif

    if (!this.atextMode[!index] eq 'DEFAULT') then
      !atextString = !this.defaultAtexts[!index]
    elseif (!this.atextMode[!index] eq 'USER') then
      !atextString = !this.atextUserValue[!index]
    else
      !atextString = '  '
    endif

    !lines = !atextString.split(!this.newline)
    do !i indices !lines
      if (!i eq 1) then
        !dText.append(!index & '  ' + !lines[!i])
      else
        !dText.append('     ' + !lines[!i])
      endif
      !rText.append(!index.string())
    enddo

  enddo

  if (!this.atextList.dText ne !dText) then
    !this.atextList.dText = !dText
  endif
  if (!this.atextList.rText ne !rText) then
    !this.atextList.rText = !rText
  endif

endmethod
-- End of method definition for .setAtextList()

