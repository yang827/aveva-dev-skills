-- File:            isocolours.pmlfrm
--   Type:          Form Definition
--   Group:         Change Representation
--     Keyword:     CHANGE
--   Module:        iso
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         9 January 2002
--
--
-- Description:
-- Revision Highlight Colour selection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Constructor
--  setColour(REAL)                  -                   Constructor
--
------------------------------------------------------------------------

-- Initialise Variables
!tableWidth = 6

-- Define form
setup form !!isoColours

  !this.formTitle     = |Choose a colour|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.3 $ |

  -- Initial Colours
  member .colour is REAL
  member .original is REAL

  -- What action is to occur when the colour is selected
  member .action is STRING

  -- Colour Frame
  frame .colFrame |Colours| at x0.6 ymax
    !colObject = object COLOUR(1)
    !colName   = !colObject.name.subString(1,1).upcase() & !colObject.name.subString(2)
    button .colour1 |  | at x1 y.75 tooltip '$!<colName>' callback '!this.setColour(!this.colour1.background)'
    !this.colour1.background = 1

    -- Build colour form matrix
    do !count from 2 to 12
      !colObject = object COLOUR(!count)
      !colName   = !colObject.name.subString(1,1).upcase() & !colObject.name.subString(2)
      if(abs(int(!count / !tableWidth) - (!count / !tableWidth)) * !tableWidth eq 1) then
        button .colour$!count |  | at x1   ymax+0.05 tooltip '$!<colName>' callback '!this.setColour(!this.colour$!<count>.background)'
      else
        button .colour$!count |  | at xmax+0.1 ymin tooltip '$!<colName>' callback '!this.setColour(!this.colour$!<count>.background)'
      endif
      !this.colour$!<count>.background = !count
    enddo
  exit

  -- Current selected colour
  para .currentColour at x0.6 ymax+0.25 width 22 lines 1

  -- Dismiss button
   button .dismiss 'Dismiss' at xmax.colFrame-8.2 ymax call '' cancel
   button .reset   ' Reset ' at xmin-9 ymin call '!this.setColour(!this.original)' reset

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Constructor
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise colours
  if (!this.colour.unset()) then
    !this.setColour(1)
  endif
  !this.original = !this.colour

endmethod
-- End of method definition .isoColours()

------------------------------------------------------------------------
--
-- Method: .setColour(REAL)
--
-- Description: Constructor
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!colour is REAL)

  -- Set this form gadgets
  !colObject = object COLOUR(!colour)
  !this.currentColour.background = !colObject.code
  !this.currentColour.val = ' ' & !colObject.name

  -- Store colour at form
  !this.colour = !colObject.code

  -- Make action
  if (!this.action.set()) then
    $!this.action
  endif

endmethod
-- End of method definition .setColour(REAL)
