--
-- File:            isocutback.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        isodraft
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Dec 18 15:06:13 GMT 1997
--
--
-- Description:
-- Cut back rules for bends and threading
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copy(REAL)                       -                   Copy selected rule to edit fields
--  display()                        -                   Display list of cutback rules on form
--  edit(STRING)                     -                   Edit functions for cutback rule definition
--  init()                           -                   Initialise Cut back rules for bends and threading
--  save()                           -                   Save cutback rules to options file
--  type()                           -                   Grey out rule gadgets for threaded cutbacks (special case)
--
------------------------------------------------------------------------
--
-- *** COMMAND LINE SYNTAX ***
-- *** OLD STYLE PML ***
--

-- Switch for future upgrade from ISOU texts to use of format qualifiers
!useFormats = FALSE

-- Define form
setup form !!isoCutBack

  -- Store switch for future upgrade from ISOU texts to use of format qualifiers
  member .useFormats is BOOLEAN

  -- Rules maintained in array from which display is taken
  member .rules is ARRAY

  -- Modified flag is maintained but not currently used
  member .modified is BOOLEAN

  !!isoCutBack.formTitle     = 'Cutback Rule Definitions'
  !!isoCutBack.iconTitle     = 'Cutback'
  !!isoCutBack.callback      = '!!isoCutBack.init()'
  !!isoCutBack.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition

  -- Rule Definitions
  frame .edit |Define cutback rule|
    para   .lengthHead at xmin+1 ymax+0.2 text | Min Length|
    para   .typeHead at xmax+10 ymin text | Type|
    para   .exprHead at xmax+14 ymin text | Rule|
    if (!useFormats) then
      text   .length at xmin.lengthHead ymax width 14 scroll 14 is REAL format !!distanceFmt
    else
      text   .length at xmin.lengthHead ymax width 14 scroll 14 ISOU
    endif
    para   .on     at xmax ymin text | on |
    option .type   at xmin.typeHead ymin callback |!!isoCutBack.type()| width 8
    para   .with   at xmax ymin text | with |
    text   .expr   at xmin.exprHead ymin width 32 is STRING
  exit

  -- Column Edit Buttons
  button .cut     | Cut  | at xmin.edit+30 ymax+0.5 callback |!!isoCutBack.edit('CUT')|
  button .copy    | Copy | at xmax+1 ymin callback |!!isoCutBack.edit('COPY')|
  button .replace |Replace| at xmax+1 ymin callback |!!isoCutBack.edit('REPLACE')|
  button .insert  |Insert| at xmax+1 ymin callback |!!isoCutBack.edit('INSERT')|
  option .insertMode at xmax ymin width 6

  -- Column Display
  list .display |Rules| at xmin.edit+5 ymax width 64 length 8

  button .ok |  OK  | at xmin.edit ymax+0.5 callback |!!isoCutBack.save()| ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit

!typeDtext[1] = |Threads|
!typeRtext[1] = |threadedends|
!typeDtext[2] = |Bends|
!typeRtext[2] = |all bend|
!!isoCutBack.type.dText = !typeDtext
!!isoCutBack.type.rText = !typeRtext

!dText[1] = |Before|
!rText[1] = |BEFORE|
!dText[2] = |After|
!rText[2] = |AFTER|
!!isoCutBack.insertMode.dText = !dText
!!isoCutBack.insertMode.rText = !rText

!!isoCutBack.modified = false
!!isoCutBack.useFormats = !useFormats

-- End of form definition for !!isoCutBack

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialise Cut back rules for bends and threading
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Initialise cutback rule list
  !this.rules.clear()

  -- Get rules
  var !ruleCount CUTBACK RULE COUNT
  do !i to !ruleCount.real()
    var !rule CUTBACK RULE $!i
    !this.rules[!i] = !rule
  enddo

  -- Display rules list
  !this.display()

  -- Check display type
  !this.type()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Display list of cutback rules on form
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------

-- Define method
define method .display()

  -- Rules are held in form data array
  !ruleNumbers = ARRAY()
  do !i ind !this.rules
    !ruleNumbers[!i] = !i.string()
  enddo
  !this.display.dText = !this.rules
  !this.display.rText = !ruleNumbers

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: Edit functions for cutback rule definition
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [String] [Edit action: CUT, COPY, INSERT, REPLACE]
--
------------------------------------------------------------------------

-- Define method
define method .edit(!action is STRING)

  if (!action eq |CUT|) then

    -- Copy the current data into the edit boxes
    !this.copy(!this.display.selection().real())

    -- Delete data from form member .rules
    if (!this.display.selection() ne '') then
      !this.rules.remove(!this.display.selection().real())
    endif

    -- Refresh the rules display
    !this.display()

    -- Modified flag is maintained but is not currently used
    !this.modified = true

  elseif (!action eq |COPY|) then

    -- Copy the current data into the edit boxes
    !this.copy(!this.display.selection().real())

  elseif (!action eq |REPLACE| or !action eq |INSERT|) then

    -- Check that a rule definition has been selected
    !index = !this.display.selection().real()
    if (!index.unset()) then
      !index = 1
    endif

    -- Format the new rule
    if (!this.length.val eq ||) then
      !!alert.error(  'Cannot create rule: undefined minimum length.')
      !newRule = ||
    elseif (!this.expr.val.trim() eq ||) then
      !newRule = !this.length.val & | on | & !this.type.selection()
    else
      !newRule = !this.length.val & | on | & !this.type.selection() & | with | & !this.expr.val.trim()
    endif

    if (!action eq |REPLACE|) then

      -- Overwrite the current rule with the edit data

      if (!newRule neq ||) then
      !this.rules[!index] = !newRule
      endif

    else

      -- Don't insert after if this is the first column definition
      if (!this.insertMode.selection() eq |AFTER| and !this.display.selection().real().set()) then
        !index = !index + 1
      endif
      if (!newRule neq ||) then
      !this.rules.insert(!index,!newRule)
      endif

    endif

    -- Refresh the rules display
    !this.display()

    -- Select the current position in the list
    !this.display.select(|RTEXT|,!index.string())

    -- Modified flag is maintained but is not currently used
    !this.modified = true

  endif

endmethod
-- End of method definition for .edit(STRING)

------------------------------------------------------------------------
--
-- Method:      !copy()
--
-- Description: Copy selected rule to edit fields
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [Real] [Rule definition array index]
--
------------------------------------------------------------------------

-- Define method
define method .copy(!index is REAL)

  if (!index.set()) then
    -- Need string value for ISOU
    if (!this.useFormats) then
      !this.length.val = !this.rules[!index].before(| on |).real()
    else
      !this.length.val = !this.rules[!index].before(| on |)
    endif
    !this.type.select(|RTEXT|,!this.rules[!index].after(| on |).before(| with |))
    !this.expr.val = !this.rules[!index].after(| with |)

  -- No cutback rules defined yet
  else
    !this.length.val = ||
    !this.expr.val = ||
  endif

  -- Check display type
  !this.type()

endmethod
-- End of method definition for .copy(REAL)

------------------------------------------------------------------------
--
-- Method:      !type()
--
-- Description: Grey out rule gadgets for threaded cutbacks (special case)
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------

-- Define method
define method .type()

  if (!this.type.selection(|DTEXT|) eq |Threads|) then
    !this.with.active = FALSE
    !this.exprHead.active = FALSE
    !this.expr.active = FALSE
    !this.expr.val = ||
  else
    !this.with.active = TRUE
    !this.exprHead.active = TRUE
    !this.expr.active = TRUE
  endif

endmethod
-- End of method definition for .type()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: Save cutback rules to options file
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------

-- Define method
define method .save()

  -- Set cutback rules using command line syntax
  CUTBACK NONE
  do !rule values !this.rules
    -- Allow for syntax differing from query message
    !ruleText = !rule.replace(|threaded ends|,|threadedends|)
    -- Insert expression brackets
    if (match(!ruleText,| with |) gt 0) then
      !ruleText = !ruleText.replace(| with |,| with (|) & |)|
    endif
    CUTBACK $!ruleText
  enddo

  -- Save options state
  !!isoSaveOptions()

endmethod
-- End of method definition for .save()
