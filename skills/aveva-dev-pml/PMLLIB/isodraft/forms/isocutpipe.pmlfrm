--
-- File:            isocutpipe.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        isodraft
-- Author:          M.Lewis
-- Created:         Tue Oct 21 15:12:10 BST 1997
--
--  Description:     Cut pipe file format
-- The principal of this form is that all data is maintained in a
-- format object, from which the form is displayed, and the data saved
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copy(REAL)                       -                   Copy selected column definition into edit gadgets
--  data(REAL)                       -                   Display cut pipe format column definition in textpane
--  default()                        -                   Default cut pipe list format settings
--  display()                        -                   Display cut pipe format object on form
--  edit(STRING)                     -                   Edit column definitions for cut pipe format
--  file(STRING)                     -                   Control file loading operations for cut pipe format
--  init()                           -                   Cut pipe report format form initialisation
--  isoCutPipe()                     -                   Constructor
--  load(FILE)                       -                   Load cut pipe format file data
--  modify()                         -                   Mark data as modified and store header data in format object
--  onOff(BOOLEAN)                   STRING              Return on/off for boolean for csv file
--  save(FILE)                       -                   Save cut pipe format data to file
--  saved(STRING)                    BOOLEAN             Check if format file saved, if not prompt for action
--
------------------------------------------------------------------------

-- Integer format object must be global variable
!!isoCutPipeIntFmt = object FORMAT()
!!isoCutPipeIntFmt.dp = 0

-- Define form
setup form !!isoCutPipe
  -- Body of form definition

  bar
    add 'Control' .control
    add 'Files'   .files
  exit

  menu .control
    add |Close| |!!isoCutPipe.file('CLOSE')|
  exit

  menu .files
    add |Save|         |!!isoCutPipe.file('SAVE')|
    add |Save as...|   |!!isoCutPipe.file('SAVEAS')|
    add sep
    add |Load|         |!!isoCutPipe.file('LOAD')|
    add |Load from...| |!!isoCutPipe.file('LOADFROM')|
    add |Load default| |!!isoCutPipe.file('LOADDEF')|
  exit

  -- Current Filename
  paragraph .fileStext at xmin ymax+0.5 text | File: |
  paragraph .filename  at xmax ymin width 65 lines 1

  -- Header Definition (texts are stripped of commas on input for CSV file)
  frame .header |Header Input| at xmin.fileStext ymax
    toggle .keepCsvFile      | Keep comma separated value file| at xmin+1 ymax+0.2 callback |!!isoCutPipe.modify()|
    toggle .pagingOn         | Paging| at xmax+1 ymin callback |!!isoCutPipe.modify()|
    text   .pageLength       |length | at xmax+1 ymin  callback |!!isoCutPipe.modify()| width 3 scroll 3 is REAL format !!isoCutPipeIntFmt
    text   .pageText         |text | at xmax+1 ymin callback |!!isoCutPipe.modify()| width 6 is STRING
    toggle .createReport     | Create Formatted Report| at xmin.keepCsvFile ymax callback |!!isoCutPipe.modify()|
    toggle .dateOn           | Date| at xmin.pagingOn ymin callback |!!isoCutPipe.modify()|
    text   .dateText         |text | at xmin.pageText ymin callback |!!isoCutPipe.modify()| width 6 is STRING
    toggle .createMacro      | Create Appware Data Macro| at xmin.keepCsvFile ymax callback |!!isoCutPipe.modify()|
    text   .headerText       |Header | at xmin.keepCsvFile ymax+0.5 callback |!!isoCutPipe.modify()| width 44 is STRING
    toggle .projectNumberOn  | Project number| at xmax+1 ymin callback |!!isoCutPipe.modify()|
    toggle .pipeListOn       | Pipe list| at xmin.keepCsvFile ymax+0.3 callback |!!isoCutPipe.modify()|
    text   .pipeListText     |text | at xmax+1 ymin-0.01 callback |!!isoCutPipe.modify()| width 48 is STRING
    text   .metricLengText   |Metric texts:    Lengths | at xmin.fileStext+8 ymax+0.5 callback |!!isoCutPipe.modify()| width 12 is STRING
    text   .metricBoreText   |Bores | at xmax+1 ymin callback |!!isoCutPipe.modify()| width 12 is STRING
    text   .imperialLengText |Imperial texts:  Lengths | at xmin.metricLengText ymax callback |!!isoCutPipe.modify()| width 12 is STRING
    text   .imperialBoreText |Bores | at xmax+1 ymin callback |!!isoCutPipe.modify()| width 12 is STRING
    text   .subTotalText     |Subtotal text | at xmin.keepCsvFile ymax+0.5 callback |!!isoCutPipe.modify()| width 24 is STRING
  exit

  -- Column Definitions for editing (texts are stripped of commas on input for CSV file)
  frame .edit     |Column Input| at xmin ymax+0.1
    option .type     |Type | at xmin+1 ymax+0.2 width 11
    text   .width    |Width | at xmax+1 ymin width 2 scroll 2 is REAL format !!isoCutPipeIntFmt
    text   .space    |followed by spaces | at xmax+1 ymin width 2 scroll 2 is REAL format !!isoCutPipeIntFmt
    para   .unitsNote   at xmin.type ymax+0.5 text |Use text "<Units>" for Size and Length to get appropriate units texts |
    text   .titleOne |Title Top Line     | at xmin+0.3 ymax width 50 is STRING
    text   .titleTwo |Title Bottom Line  | at xmin ymax width 50 is STRING
  exit

  -- Column Edit Buttons
  button .cut     | Cut  | at xmin.fileStext+30 ymax+0.5 callback |!!isoCutPipe.edit('CUT')|
  button .copy    | Copy | at xmax+1 ymin callback |!!isoCutPipe.edit('COPY')|
  button .replace |Replace| at xmax+1 ymin callback |!!isoCutPipe.edit('REPLACE')|
  button .insert  |Insert| at xmax+1 ymin callback |!!isoCutPipe.edit('INSERT')|
  option .insertMode at xmax ymin width 6

  -- Column Display
  frame .display |Column Display| at xmin.fileStext ymax
    list .columns |Column| at xmin+1 ymax+0.2 callback |!!isoCutPipe.data(!!isoCutPipe.columns.selection().real())| width 16 length 8
    textpane .columnDef 'Data' at xmax+0.5 ymin+0.7 width 49 height 8
  exit


  member .format is ISOCUTPIPEFMT
  member .file is FILE
  member .modified is BOOLEAN
  -- member .integerFormat is FORMAT -- gives syntax error in text definition: format !!isoCutPipe.integerFormat

exit
-- End of form definition for !!isoCutPipe

------------------------------------------------------------------------
--
-- Method:      isoCutPipe()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [Real] [Index into array of column definitions]
--
------------------------------------------------------------------------
define method .isoCutPipe()

   Import 'pmlfilebrowser'
   handle any
   endhandle

!type[1] = |Itemcode|
!type[2] = |Description|
!type[3] = |Size|
!type[4] = |Length|
!type[5] = |TruLength|
!type[6] = |Specreq|
!type[7] = |Pieceno|
!type[8] = |Pipename|
!type[9] = |Batchref|
!type[10] = |Endpreps|
!type[11] = |Spoolno|
!type[12] = |Piecename|

!!isoCutPipe.type.dText = !type

!dText[1] = |Before|
!rText[1] = |BEFORE|
!dText[2] = |After|
!rText[2] = |AFTER|
!!isoCutPipe.insertMode.dText = !dText
!!isoCutPipe.insertMode.rText = !rText

!!isoCutPipe.modified = false

  !!isoCutPipe.formTitle     = 'Cut Pipe Report Format'
  !!isoCutPipe.iconTitle     = 'Cut Pipe'
  !!isoCutPipe.callback      = '!!isoCutPipe.init()'
  !!isoCutPipe.formRevision  = ' $Revision: 1.18 $ '

endmethod
-- End of method definition for .isocutpipe()

------------------------------------------------------------------------
--
-- Method:      !copy()
--
-- Description: Copy selected column definition into edit gadgets
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [Real] [Index into array of column definitions]
--
------------------------------------------------------------------------
define method .copy(!index is REAL)

  -- Populate edit gadgets with data from selected column format definition
  if (!index.set()) then
    !this.type.select(|DTEXT|,!this.format.columns[!index].columnType)
    !this.titleOne.val = !this.format.columns[!index].titleOne
    !this.titleTwo.val = !this.format.columns[!index].titleTwo
    !this.width.val = !this.format.columns[!index].width
    !this.space.val = !this.format.columns[!index].space

  -- No columns defined yet
  else
    !this.type.clearSelection()
    !this.titleOne.val = ||
    !this.titleTwo.val = ||
    !this.width.val = 0
    !this.space.val = 0
  endif

endmethod
-- End of method definition for .copy(REAL)

------------------------------------------------------------------------
--
-- Method:      !data()
--
-- Description: Display cut pipe format column definition in textpane
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [Real] [Index into array of column definitions]
--
------------------------------------------------------------------------
define method .data(!index is REAL)

  if (!index.set()) then
    -- Populate array with column format data
    !varray[1] = |Column type : | & !this.format.columns[!index].columnType
    !varray[2] = |Title       : | & !this.format.columns[!index].titleOne
    !varray[3] = |            : | & !this.format.columns[!index].titleTwo
    !varray[4] = |Width       : | & !this.format.columns[!index].width
    !varray[5] = |Spaces      : | & !this.format.columns[!index].space

    -- Display data in textpane gadget
    !this.columnDef.val = !varray

  else
    !this.columnDef.clear()
  endif

endmethod
-- End of method definition for .data(REAL)

------------------------------------------------------------------------
--
-- Method:      !default()
--
-- Description: Default cut pipe list format settings
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------
define method .default()

  -- Create a default format that matches the old style cut pipe report
  -- (but without Fortran carriage control characters)
  !this.format.keepCsvFile = false
  !this.format.createReport = true
  !this.format.createMacro = false
  !this.format.fccsOn = false
  !this.format.pagingOn = true
  !this.format.pageLength = 68
  !this.format.pageText = |Page|
  !this.format.dateOn = true
  !this.format.dateText = |Date|
  !this.format.headerText = |Summary of cut pipe lengths for project number -|
  !this.format.projectNumberOn = true
  !this.format.pipeListOn = true
  !this.format.pipeListText = |For Pipeline References|
  !this.format.metricLengText = |(metres)|
  !this.format.metricBoreText = |(mm)|
  !this.format.imperialLengText = |(ft & ins)|
  !this.format.imperialBoreText = |(ins)|
  !this.format.subTotalText  = |SUB TOTAL|

  -- Column defaults
  !this.format.columns.clear()

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Itemcode|
  !column.titleOne = |Item|
  !column.titleTwo = |Code|
  !column.width = 12
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Description|
  !column.titleOne = |Item Description and Specification|
  !column.titleTwo = ||
  !column.width = 38
  !column.space = 3
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Size|
  !column.titleOne = |Size|
  !column.titleTwo = |<Units>|
  !column.width = 7
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Length|
  !column.titleOne = |Cut Length|
  !column.titleTwo = |<Units>|
  !column.width = 10
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |TruLength|
  !column.titleOne = |Length|
  !column.titleTwo = |<Units>|
  !column.width = 10
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Specreq|
  !column.titleOne = |Special|
  !column.titleTwo = |Req.|
  !column.width = 9
  !column.space = 1
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Pieceno|
  !column.titleOne = |Piece|
  !column.titleTwo = |No.|
  !column.width = 5
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Pipename|
  !column.titleOne = |Pipeline|
  !column.titleTwo = |Reference|
  !column.width = 18
  !column.space = 2
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Batchref|
  !column.titleOne = |Batch|
  !column.titleTwo = |Reference|
  !column.width = 18
  !column.space = 0
  !this.format.columns.append(!column)

  !column = object ISOCUTPIPECOL()
  !column.columnType = |Piecename|
  !column.titleOne = |Piece|
  !column.titleTwo = |Name|
  !column.width = 14
  !column.space = 1
  !this.format.columns.append(!column)

  -- Display format on form
  !this.display()

  -- Mark the data as not yet modified
  !this.modified = FALSE

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Display cut pipe format object on form
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------
define method .display()

  -- Header settings
  !this.keepCsvFile.val      = !this.format.keepCsvFile
  !this.createReport.val     = !this.format.createReport
  !this.createMacro.val      = !this.format.createMacro
  !this.pagingOn.val         = !this.format.pagingOn
  !this.pageLength.val       = !this.format.pageLength
  !this.pageText.val         = !this.format.pageText
  !this.dateOn.val           = !this.format.dateOn
  !this.dateText.val         = !this.format.dateText
  !this.headerText.val       = !this.format.headerText
  !this.projectNumberOn.val  = !this.format.projectNumberOn
  !this.pipeListOn.val       = !this.format.pipeListOn
  !this.pipeListText.val     = !this.format.pipeListText
  !this.metricLengText.val   = !this.format.metricLengText
  !this.metricBoreText.val   = !this.format.metricBoreText
  !this.imperialLengText.val = !this.format.imperialLengText
  !this.imperialBoreText.val = !this.format.imperialBoreText
  !this.subTotalText.val     = !this.format.subTotalText

  -- Column types with array position as replacement text
  !columnTypes = ARRAY()
  !columnNumbers = ARRAY()
  do !i ind !this.format.columns
    !columnTypes.append(!this.format.columns[!i].columnType)
    !columnNumbers.append(!i.string())
  enddo
  !this.columns.dText = !columnTypes
  !this.columns.rText = !columnNumbers
  !this.columnDef.clear()

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: Edit column definitions for cut pipe format
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [String] [Edit action: CUT, COPY, INSERT, REPLACE]
--
------------------------------------------------------------------------
define method .edit(!action is STRING)

  if (!action eq |CUT|) then

    -- Test for anything to cut
    if (!this.columns.selection().real().unset()) then
      return
    endif

    -- Copy the current data into the edit boxes
    !this.copy(!this.columns.selection().real())

    -- Delete data from form member .format
    !this.format.columns.remove(!this.columns.selection().real())

    -- Refresh the format display
    !this.display()

    -- Reload the data display for the currently selected column
    !this.data(!this.columns.selection().real())

    -- Set the modified flag for the data
    !this.modified = TRUE

  elseif (!action eq |COPY|) then

    -- Copy the current data into the edit boxes
    !this.copy(!this.columns.selection().real())

  elseif (!action eq |REPLACE| or !action eq |INSERT|) then

    -- Check that a column definition has been selected
    !index = !this.columns.selection().real()
    if (!index.unset()) then
      !index = 1
    endif

    -- Format the new column definition
    !newColumn = object ISOCUTPIPECOL()
    !newColumn.columnType = !this.type.selection()
    !newColumn.titleOne = !this.titleOne.val
    !newColumn.titleTwo = !this.titleTwo.val
    !newColumn.width = !this.width.val
    !newColumn.space = !this.space.val

    if (!action eq |REPLACE|) then

      -- Overwrite the current format data with the edit data
      !this.format.columns[!index] = !newColumn

    else

      -- Don't insert after if this is the first column definition
      if (!this.insertMode.selection() eq |AFTER| and !this.columns.selection().real().set()) then
        !index = !index + 1
      endif

      !this.format.columns.insert(!index,!newColumn)

    endif

    -- Refresh the format display
    !this.display()

    -- Select the current position in the list
    !this.columns.select(|RTEXT|,!index.string())

    -- Reload the data display for the currently selected column
    !this.data(!this.columns.selection().real())

    -- Mark data as modified
    !this.modified = TRUE

  endif

endmethod
-- End of method definition for .edit(STRING)

------------------------------------------------------------------------
--
-- Method:      !file()
--
-- Description: Control file loading operations for cut pipe format
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [String] [Form action: SAVEAS, SAVE, LOADFROM, LOAD, LOADDEF, CLOSE]
--
------------------------------------------------------------------------
define method .file(!action is STRING)

   Using Namespace 'Aveva.Pdms.Presentation'
   !browser = object PMLFILEBROWSER('save')

  if (!action eq |SAVEAS|) then
    if (!this.file.unset()) then
      !path = |%PDMSUSER%|
    else
      !path = !this.file.pathName()
    endif
    !browser.show(!path, ||, |Save Cut Pipe Format File as|, FALSE, 'All Files (*.*)|*.*', 1)
    !file = !!file(!browser.file())
    if(!file.set()) then
       !this.save(!file)
    endif

  elseif (!action eq |SAVE|) then
    !this.save(!this.file)

  elseif (!action eq |LOADFROM|) then
    -- check for unsaved changes
    if (!this.saved(|Loading|)) then
      if (!this.file.unset()) then
        !path = |%PDMSUSER%|
      else
        !path = !this.file.pathName()
      endif
      !!fileBrowser(!path, ||, |Load Cut Pipe Format File|, TRUE, |!!isoCutPipe.load(!!fileBrowser.file)|)
    else
      -- nothing to do, user has cancelled operation
    endif

  elseif (!action eq |LOAD|) then
    -- check for unsaved changes
    if (!this.saved(|Loading|)) then
      !this.load(!this.file)
    else
      -- nothing to do, user has cancelled operation
    endif

  elseif (!action eq |LOADDEF|) then
    -- check for unsaved changes
    if (!this.saved(|Loading|)) then
      !this.default()
    else
      -- nothing to do, user has cancelled operation
    endif

  elseif (!action eq |CLOSE|) then
    -- check for unsaved changes
    if (!this.saved(|Closing|)) then
      !this.hide()
    else
      -- nothing to do, user has cancelled operation
    endif

  endif

endmethod
-- End of method definition for .file(STRING)

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Cut pipe report format form initialisation
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------
define method .init()

  -- Load user's current cut pipe format file and display settings
  !this.load(!this.file)

  -- If any problems load default settings
  handle any
    !this.default()

    -- Initialise stored file as unset
    !this.file = object FILE()
    !this.filename.val = ||
  endhandle

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: Load cut pipe format file data
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [File] [Format file to load from]
--
------------------------------------------------------------------------
define method .load(!formatFile is FILE)

  -- Check for no filename
  if (!formatFile.unset()) then
    -- 'A filename is required.'
    !!messageFile.error(146, 28)
    return error 1 noalert
  endif

  -- Clear format object
  !this.format.keepCsvFile = false
  !this.format.createReport = false
  !this.format.createMacro = false
  !this.format.fccsOn = false
  !this.format.pagingOn = false
  !this.format.pageLength = 0
  !this.format.pageText = ||
  !this.format.dateOn = false
  !this.format.dateText = ||
  !this.format.headerText = ||
  !this.format.projectNumberOn = false
  !this.format.pipeListOn = false
  !this.format.pipeListText = ||
  !this.format.metricLengText = ||
  !this.format.metricBoreText = ||
  !this.format.imperialLengText = ||
  !this.format.imperialBoreText = ||
  !this.format.subTotalText  = ||
  !this.format.columns.clear()

  -- Load cut pipe format data from file
  !data = !formatFile.readFile()

  -- Load format object
  do !i ind !data
    skip if (!data[!i].trim() eq ||)
    !record = !!readCsvRecord(!data[!i])

    -- Keep comma separated value file
    if (!record[1].upCase().eq(|KEEPCSVFILE|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.keepCsvFile = true
        endif
      endif

    -- Create report file
    elseif (!record[1].upCase().eq(|CREATEFORMATTEDREPORT|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.createReport = true
        endif
      endif

    -- Create appware macro file
    elseif (!record[1].upCase().eq(|CREATEAPPWAREDATA|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.createMacro = true
        endif
      endif

    -- Output Fortran carriage controls
    elseif (!record[1].upCase().eq(|FCC|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.fccsOn = true
        endif
      endif

    -- Output page feeds, numbers and headers
    elseif (!record[1].upCase().eq(|PAGING|)) then
      if (!!checkCsvCount(!record,4,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.pagingOn = true
        endif
        !this.format.pageLength = !record[3].real()
        !this.format.pageText = !record[4]
      endif

    -- Output date
    elseif (!record[1].upCase().eq(|DATE|)) then
      if (!!checkCsvCount(!record,3,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.dateOn = true
        endif
        !this.format.dateText = !record[3]
      endif

    -- Output header text
    elseif (!record[1].upCase().eq(|HEADER|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        !this.format.headerText = !record[2]
      endif

    -- Output project number
    elseif (!record[1].upCase().eq(|PROJECTNUMBER|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.projectNumberOn = true
        endif
      endif

    -- Output list of pipes included in report
    elseif (!record[1].upCase().eq(|PIPELIST|)) then
      if (!!checkCsvCount(!record,3,!this.file.name())) then
        if (!record[2].upCase().eq(|ON|)) then
          !this.format.pipeListOn = true
        endif
        !this.format.pipeListText = !record[3]
      endif

    -- Metric units texts
    elseif (!record[1].upCase().eq(|METRIC|)) then
      if (!!checkCsvCount(!record,5,!this.file.name())) then
        !this.format.metricLengText = !record[3]
        !this.format.metricBoreText = !record[5]
      endif

    -- Imperial units texts
    elseif (!record[1].upCase().eq(|IMPERIAL|)) then
      if (!!checkCsvCount(!record,5,!this.file.name())) then
        !this.format.imperialLengText = !record[3]
        !this.format.imperialBoreText = !record[5]
      endif

    -- Subtotal text
    elseif (!record[1].upCase().eq(|SUBTOTAL|)) then
      if (!!checkCsvCount(!record,2,!this.file.name())) then
        !this.format.subTotalText  = !record[2]
      endif

    -- Column definition
    elseif (!record[1].upCase().eq(|COLUMN|)) then
      if (!!checkCsvCount(!record,10,!this.file.name())) then
        !column = object ISOCUTPIPECOL()
        !column.columnType = !record[2]
        !column.titleOne = !record[4]
        !column.titleTwo = !record[6]
        !column.width = !record[8].real()
        !column.space = !record[10].real()
        !this.format.columns.append(!column)
      endif

    endif

  enddo

  -- Display format on form
  !this.display()

  -- Reload the data display for the currently selected column
  !this.data(!this.columns.selection().real())

  -- Initialise File object to new filename (after reading in case of error)
  !this.file = !formatFile

  -- Display format filename in full
  !this.filename.val = !formatFile.name()

  -- Mark the data as not yet modified
  !this.modified = FALSE

endmethod
-- End of method definition for .load(FILE)

------------------------------------------------------------------------
--
-- Method:      !modify()
--
-- Description: Mark data as modified and store header data in format object
--
-- Method Type: Procedure
--
-- Arguments:
--   None
--
------------------------------------------------------------------------
define method .modify()

  -- Copy header data into format object
  !this.format.keepCsvFile      = !this.keepCsvFile.val
  !this.format.createReport     = !this.createReport.val
  !this.format.createMacro      = !this.createMacro.val
  !this.format.pagingOn         = !this.pagingOn.val
  !this.format.pageLength       = !this.pageLength.val
  !this.format.pageText         = !this.pageText.val
  !this.format.dateOn           = !this.dateOn.val
  !this.format.dateText         = !this.dateText.val
  !this.format.headerText       = !this.headerText.val
  !this.format.projectNumberOn  = !this.projectNumberOn.val
  !this.format.pipeListOn       = !this.pipeListOn.val
  !this.format.pipeListText     = !this.pipeListText.val
  !this.format.metricLengText   = !this.metricLengText.val
  !this.format.metricBoreText   = !this.metricBoreText.val
  !this.format.imperialLengText = !this.imperialLengText.val
  !this.format.imperialBoreText = !this.imperialBoreText.val
  !this.format.subTotalText     = !this.subTotalText.val

  -- Mark the data as modified
  !this.modified = TRUE

endmethod
-- End of method definition for .modify()

------------------------------------------------------------------------
--
-- Method:      !onOff()
--
-- Description: Return on/off for boolean for csv file
--
-- Method Type: Function
--
-- Arguments:
--   [1] [R] [Boolean] [Format object boolean member]
-- Return:
--   [String] ['"on"' or '"off"' text for CSV format file]
--
------------------------------------------------------------------------
define method .onOff(!flag is BOOLEAN) is STRING

  if (!flag) then
    return |"on"|
  else
    return |"off"|
  endif

endmethod
-- End of method definition for .onOff(BOOLEAN) STRING

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: Save cut pipe format data to file
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [R] [String] [Name of format file to save to]
--
------------------------------------------------------------------------
define method .save(!formatFile is FILE)

  -- Check for no filename
  if (!formatFile.unset()) then
    -- 'No filename given, use Save as...'
    !!messageFile.error(146, 29)
    return
  endif

  -- Load header data into text array
  !data = ARRAY()
  !data.append(|"KeepCSVFile",| & !this.onOff(!this.format.keepCsvFile))
  !data.append(|"CreateFormattedReport",| & !this.onOff(!this.format.createReport))
  !data.append(|"CreateAppwareData",| & !this.onOff(!this.format.createMacro))
  !data.append(|"FCC",| & !this.onOff(!this.format.fccsOn))
  !data.append(|"Paging",| & !this.onOff(!this.format.pagingOn) & |,"| & !this.format.pageLength & |","| & !this.format.pageText.replace(|"|,|""|) & |"|)
  !data.append(|"Date",| & !this.onOff(!this.format.dateOn)  & |,"| & !this.format.dateText.replace(|"|,|""|) & |"|)
  !data.append(|"Header","| & !this.format.headerText.replace(|"|,|""|) & |"|)
  !data.append(|"ProjectNumber",| & !this.onOff(!this.format.projectNumberOn))
  !data.append(|"Pipelist",| & !this.onOff(!this.format.pipeListOn) & |,"| & !this.format.pipeListText.replace(|"|,|""|) & |"|)
  !data.append(|"Metric","lengths","| & !this.format.metricLengText.replace(|"|,|""|) & |","bores","| & !this.format.metricBoreText.replace(|"|,|""|) & |"|)
  !data.append(|"Imperial","lengths","| & !this.format.imperialLengText.replace(|"|,|""|) & |","bores","| & !this.format.imperialBoreText.replace(|"|,|""|) & |"|)
  !data.append(|"Subtotal","| & !this.format.subTotalText.replace(|"|,|""|) & |"|)

  -- Load column data into text array
  do !i ind !this.format.columns
    !data.append(|"Column","| & !this.format.columns[!i].columnType & |","Title1","| & !this.format.columns[!i].titleOne.replace(|"|,|""|) & $
                 |","Title2","| & !this.format.columns[!i].titleTwo.replace(|"|,|""|) & |","Width","| & !this.format.columns[!i].width & $
                 |","Space","| & !this.format.columns[!i].space & |"|)
  enddo

  -- Write data to format file
  !formatFile.writeFile(|OVERWRITE|, !data)

  -- Update File object after writing (in case just created)
  !this.file = !formatFile

  -- Display format filename in full
  !this.filename.val = !formatFile.name()

  -- Mark the data as no longer modified
  !this.modified = FALSE

endmethod
-- End of method definition for .save(FILE)

------------------------------------------------------------------------
--
-- Method:      !saved()
--
-- Description: Check if format file saved, if not prompt for action
--
-- Method Type: Function
--
-- Arguments:
--   [1] [R] [String] [Form action: Loading, Closing]
-- Return:
--   [Boolean] [True if current form settings have been saved]
--
------------------------------------------------------------------------
define method .saved(!action is STRING) is BOOLEAN

  if (!this.modified) then
    -- 'Save #name before #actioning file'
    !answer = !!alert.question(!!messageFile.messageString(146, 17, !this.file.name(), !action))
    if (!answer eq 'YES') then
      !this.save(!this.file)
      !return = true
    elseif (!answer eq 'NO') then
      !return = true
    else
      !return = false
    endif
  else
    !return = true
  endif

  return !return

endmethod
-- End of method definition for .saved(STRING) BOOLEAN
