--
--
-- Description:
-- Detail list for Isodraft
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
-- Amendments
--
-- Name     Date       Ref     Description
-- ----     ---------- ------- -----------------------------------------
-- JM McCoy 13/05/2008 DUN0874 PSPOOLs and PSLISTs added to Detail List
--
-- Init Date       Ref     Description
-- ---- ---------- ------- ---------------------------------------------
-- NJSB 16/10/2009 P-24316 (Variable !!ISOMEMBERS does not exist error)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   add current element to detail list
--  addElement(DBREF)                -                   add an element to detail list
--  addElement(STRING,DBREF)         -                   add an element to detail list
--  close()                          -                   hide form and show normal members
--  dbSwitch(MENU,STRING)            -                   Database Switch callback method
--  displayList()                    -                   update detail list display
--  findName(GADGET)                 -                   Navigate to named element
--  init()                           -                   initialisation
--  isoDetailLst()                   -                   constructor
--  navigate(DBREF)                  -                   Navigate method for form
--  remove()                         -                   remove selected elements from detail list
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------

setup form !!isoDetailLst

  !!isoDetailLst.formTitle     = 'Isodraft Detail List'
  !!isoDetailLst.iconTitle     = 'DETAIL'
  !!isoDetailLst.callback      = '!!isoDetailLst.init()'
  !!isoDetailLst.formRevision  = ' $Revision: 1.11 $ '

  member .isodCe     is DBREF
  member .desiCe     is DBREF
  member .currentDb  is STRING
  member .detailList is ARRAY

  -- Body of form definition

  -- Define Bar Menu
  bar
    add 'Control'  .controlMenu
    add 'Navigate' .navigateMenu
  exit

  frame .database 'Members' at xmin ymax+0.2
    button   .previous at xmin+1        ymax     pixmap $!!cdCpmLarr height 16 width 16
    text     .find     at xmax          ymin     width 30 string
    button   .next     at xmax          ymin     pixmap $!!cdCpmRarr height 16 width 16
    selector .dbList   at xmin.previous ymax+0.2 single width 35 height 15 database auto
    button .add 'Add' at xmin ymax
    option .addOpt at xmax+1 ymin width 24
  exit

  frame .listFrame 'Detail List' at xmax.database+1 ymin.database
    list .displayList at xmin+1 ymin.dbList multiple width 35 height 15
    button .remove 'Remove' at xmin ymax
    option .removeOpt at xmax+1 ymin width 8
  exit

  -- setup form tracking
  track |ISODCE| |DESICE| |CATACE| |PROPCE| |PADDCE| callback '!!isoDetailLst.track('

exit
-- End of form definition for !!isoDetailLst

------------------------------------------------------------------------
--
-- Method:      !isoDetailLst()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .isoDetailLst()

  -- define menus (navigate menu built dynamically)
  !this.newMenu('ControlMenu')
  !this.newMenu('switchMenu')
  !this.newMenu('NavigateMenu')
  !this.newMenu('NavFirstMenu')
  !this.newMenu('NavLastMenu')

  !this.controlMenu.add('menu', 'Switch', 'switchMenu')
  !this.controlMenu.add('callback', 'Close', '!!isoDetailLst.close()')

  !this.switchMenu.add('toggle', 'Fabrication', '!!isoDetailLst.dbSwitch(')
  !this.switchMenu.add('toggle', 'Design', '!!isoDetailLst.dbSwitch(')

  !this.navFirstMenu.add('callback', 'Element', 'FIRST')
  !this.navFirstMenu.add('callback', 'Member', 'FIRST MEM')

  !this.navLastMenu.add('callback', 'Element', 'LAST')
  !this.navLastMenu.add('callback', 'Member', 'LAST MEM')

  -- remove options
  !dText[1] = 'Selected'
  !rText[1] = 'Selected'
  !dText[2] = 'All'
  !rText[2] = 'All'
  !this.removeOpt.dText = !dText
  !this.removeOpt.rText = !rText

  -- set callbacks
  !this.previous.callback  = 'PREVIOUS'
  !this.next.callback      = 'NEXT'
  !this.find.callback      = '!!isoDetailLst.findName(!!isoDetailLst.find)'
  !this.dbList.callback    = '!!isoDetailLst.navigate(!!isoDetailLst.dbList.selection().dbRef())'
  !this.add.callback       = '!!isoDetailLst.add()'
  !this.remove.callback    = '!!isoDetailLst.remove()'
  !this.cancelCall         = '!!isoDetailLst.close()'

endmethod
-- End of method definition for .isoDetailLst()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- members forms mutually exclusive
  if (defined(!!isoSystemLst)) then
    if (!!isoSystemLst.shown()) then
      !this.hide()
      return error 1 'Detail list not allowed whilst System List form is active'
    endif
  endif
  !!isoMembers.hide()
  handle (2,751)
  endhandle

  -- initialise tracking
  if (!!ce.dbType eq 'ISOD') then
    !this.isodCe = !!ce
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
    !track = 'ISODCE'
  elseif (!!ce.dbType eq 'DESI') then
    !this.desiCe = !!ce
    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)
    !track = 'DESICE'
  else
    -- in another db whilst members form not tracking
    /*
    !this.isodCe = !!ce
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
    !track = 'ISODCE'
  endif

  !this.track(!!isoDetailLst, !track)

  -- update detail list display
  !this.displayList()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !type is STRING)

  -- constrain navigation within design and isod dbs
  if (!type ne 'DESICE' and !type ne 'ISODCE') then
    -- navigate back to previously displayed member
    if (!this.currentDb eq 'ISOD') then
      !!ce = !this.isodCe
    else
      !!ce = !this.desiCe
    endif
    return
  endif

  !element = !!ce

  -- select dbtype and set CE accordingly
  !this.currentDb = !element.dbType
  if (!element.dbType eq 'ISOD') then
    !this.isodCe = !element
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
  elseif (!element.dbType eq 'DESI') then
    !this.desiCe = !element
    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)
  endif

  -- dynamic creation of navigate menu to allow goto spool/field at top
  -- could make owner and member dynamic rather than control activation
  -- but this would make it inconsistent with Design
  !this.navigateMenu.clear()

  -- activate spool/field link for piping components
  if (!element.type ne 'WORL' ) then
    if (!element.owner.type eq 'BRAN') then
      if (!element.sfref.set()) then
        !this.navigateMenu.add('callback', 'Goto ' & !element.sfref.type, '!!ce = !!ce.sfref')
      endif
    endif
  endif

  -- remainder of navigate menu
  !this.navigateMenu.add('callback', 'Owner', 'OWNER')
  !this.navigateMenu.add('menu', 'First', 'navFirstMenu')
  !this.navigateMenu.add('menu', 'Last', 'navLastMenu')
  !this.navigateMenu.add('callback', 'Same', 'SAME')
  !this.navigateMenu.setActive('Owner', !element.owner.set())
  if (!element.type eq 'TUBI') then
    !active = false
  else
    !active = !element.members.set()
  endif
  !this.navFirstMenu.setActive('Member', !active)
  !this.navLastMenu.setActive('Member', !active)

  -- add options
  !addData = ARRAY()
  !addData.append('Member')

  -- get sheets based on split attas
  if (!!ce.type eq 'PIPE' or !!ce.type eq 'SPLDRG') then
    var !attas COLLECT ALL ATTA WITH (ATTY EQ |XXXX|) FOR CE
    if (!attas.size() gt 0) then
      do !i to (!attas.size() + 1)
        !addData.append('Sheetnumber ' & !i)
      enddo
    endif
  endif

  -- get spools based on pipe component attributes
  -- (for splDrgs add spool as member)
  if (!!ce.type eq 'PIPE') then
    var !branches COLLECT ALL BRANCH WITH (NOT UNSET(SPLH)) FOR CE
    var !members COLLECT ALL BRANCH MEMBERS WITH (NOT UNSET(SPLN)) FOR CE
    var !tubes COLLECT ALL BRANCH MEMBERS WITH (NOT UNSET(SPLT)) FOR CE
    var !spools EVALUATE SPLH FOR ALL FROM !branches
    var !spools APPEND EVALUATE SPLN FOR ALL FROM !members
    var !spools APPEND EVALUATE SPLT FOR ALL FROM !tubes
    !spools.sort().unique()
    do !spool values !spools
      !addData.append('Spool ' & !spool)
    enddo
  endif

  -- display add options and activate add button if appropriate
  !this.addOpt.dText = !addData
  !this.addOpt.rText = !addData
  !addTypes = 'GROUP ZONE PIPE BRAN PSLIST PSPOOL ISOREG SPLDRG SPOOL FIELD'
  !this.add.active = (!addTypes.match(!!ce.type) gt 0)
  !this.addOpt.active = !this.add.active

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !dbSwitch()
--
-- Description: Database Switch callback method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MENU] [menu gadget]
--   [2] [R] [STRING] [select state]
--
------------------------------------------------------------------------

-- Define method
define method .dbSwitch(!menu is MENU, !dummySelect is STRING)

  if (!menu.pickedField eq 'Fabrication') then

    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)

    if (!this.isodCe.badRef()) then
      !!ce = !!dbeWorldGet('ISOD')
    else
      !!ce = !this.isodCe
    endif

  elseif (!menu.pickedField eq 'Design') then

    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)

    if (!this.desiCe.badRef()) then
      !!ce = !!dbeWorldGet('DESI')
    else
      !!ce = !this.desiCe
    endif

  endif

endmethod
-- End of method definition for .dbSwitch(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      !navigate()
--
-- Description: Navigate method for form
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .navigate(!element is DBREF)

  if (!element.type eq 'WORL' and !element.dbType ne !this.currentDb) then
    !!ce = WORLD
  elseif (!element ne !!ce) then
    !!ce = !element
  else
    -- element is same as current element, there is nothing to do
  endif

endmethod
-- End of method definition for .navigate(DBREF)

------------------------------------------------------------------------
--
-- Method:      !findName()
--
-- Description: Navigate to named element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [GADGET] [Text gadget holding element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .findName(!name is GADGET)

  call !!nameGadget(!name, 'OLD')
  if (!name.val ne 'unset') then
    !!ce = !name.val.dbRef()
    !name.clear()
  endif

endmethod
-- End of method definition for .findName(GADGET)

------------------------------------------------------------------------
--
-- Method:      !add()
--
-- Description: add current element to detail list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .add()

  if (!this.addOpt.selection() eq 'Member') then

    !addDirectTypes = 'PIPE BRAN PSLIST PSPOOL SPLDRG SPOOL FIELD'
    if (!addDirectTypes.match(!!ce.type) gt 0) then
      !this.addElement(!!ce)

    elseif (!!ce.type eq 'ZONE') then
      do !element values !!ce.members
        if (!element.type eq 'PIPE') then
          !this.addElement(!element)
        endif
      enddo

    elseif (!!ce.type eq 'ISOREG') then
      do !element values !!ce.members
        if (!element.type eq 'SPLDRG') then
          !this.addElement(!element)
        endif
      enddo

    elseif (!!ce.type eq 'GROUP') then
      do !element values !!ce.members
        if (!element.type eq 'PIPE' or !element.type eq 'SPLDRG') then
          !this.addElement(!element)
        endif
      enddo

    endif

  elseif (!this.addOpt.selection().subString(1,5) eq 'Sheet') then

    if (!!ce.type eq 'PIPE' or !!ce.type eq 'SPLDRG') then
      !this.addElement(!this.addOpt.selection(), !!ce)
    endif

  elseif (!this.addOpt.selection().subString(1,5) eq 'Spool') then

    -- pipe only (for splDrg add spools as members)
    if (!!ce.type eq 'PIPE') then
      !this.addElement(!this.addOpt.selection(), !!ce)
    endif

  endif

  -- update display
  !this.displayList()

endmethod
-- End of method definition for .add()

------------------------------------------------------------------------
--
-- Method:      !addElement(DBREF)
--
-- Description: add an element to detail list
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF] [element to add]
--
------------------------------------------------------------------------

-- Define method
define method .addElement(!element is DBREF)

  !this.addElement(STRING(), !element)

endmethod
-- End of method definition for .addElement(DBREF)

------------------------------------------------------------------------
--
-- Method:      !addElement(STRING,DBREF)
--
-- Description: add an element to detail list
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF] [element to add]
--
------------------------------------------------------------------------

-- Define method
define method .addElement(!addString is STRING, !element is DBREF)

  -- element type and name
  if (!element.name.subString(1,1) eq '/') then
    !addText = !element.type & ' ' & !element.name
  else
    !addText = !element.fullName
  endif

  -- add spool/sheetnumber text
  if (!addString.set()) then
    !addText = !addString & ' ' & !addText
  endif

  -- add to detail list
  if (!this.detailList.findFirst(!addText).unset()) then
    !this.detailList.append(!addText)
  endif

endmethod
-- End of method definition for .addElement(STRING, DBREF)

------------------------------------------------------------------------
--
-- Method:      !remove()
--
-- Description: remove selected elements from detail list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .remove()

  if (!this.removeOpt.selection() eq 'Selected') then

    do !addText values !this.displayList.selection('RTEXT')
      !this.detailList.remove(!this.detailList.findFirst(!addText))
    enddo

  elseif (!this.removeOpt.selection() eq 'All') then

    !this.detailList.clear()

  endif

  -- update display
  !this.displayList()

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      !displayList()
--
-- Description: update detail list display
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .displayList()

  -- display detail list
  !this.displayList.clear()
  !this.displayList.dText = !this.detailList
  !this.displayList.rText = !this.detailList

  -- activate remove button if appropriate
  !this.remove.active = (!this.detailList.size() gt 0)
  !this.removeOpt.active = !this.remove.active

endmethod
-- End of method definition for .displayList()

------------------------------------------------------------------------
--
-- Method:      !close()
--
-- Description: hide form and show normal members
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .close()

  !this.hide()
  show !!isoMembers free at xr 0 yr 0.1

endmethod
-- End of method definition for .close()
