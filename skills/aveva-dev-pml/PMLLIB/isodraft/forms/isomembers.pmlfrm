--     Keyword:     GEN
--   Module:        isodraft
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Mar 16 12:53:43 GMT 1998
--
--
-- Description:
-- Isodraft members form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbSwitch(MENU,STRING)            -                   Database Switch callback method
--  findName(GADGET)                 -                   Navigate to named element
--  init()                           -                   initialisation
--  isoMembers()                     -                   constructor
--  navigate(DBREF)                  -                   Navigate method for form
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------

setup form !!isoMembers resize

  !!isoMembers.formTitle     = 'Isodraft Members'
  !!isoMembers.iconTitle     = 'MEMBERS'
  !!isoMembers.callback      = '!!isoMembers.init()'
  !!isoMembers.formRevision  = ' $Revision: 1.13 $ '

  member .isodCe     is DBREF
  member .desiCe     is DBREF
  member .currentDb  is STRING

  -- Default members list size in global variables for dynamic loading
  if (undefined(!!isoMemWidth)) then
    !!isoMemWidth = 35
  endif
  if (undefined(!!isoMemHeight)) then
    !!isoMemHeight = 10
  endif
  !activeWidth = MAX(10, !!isoMemWidth - 4)

  -- Body of form definition

  -- Define Bar Menu
  bar
    add 'Control'  .controlMenu
    add 'Navigate' .navigateMenu
  exit

  frame .database 'Members' at xmin ymax+0.2 anchor all
    button   .previous at xmin+1        ymax     pixmap height 12 width 9
    text     .find     at xmax          ymin     width $!activeWidth string
    button   .next     at xmax          ymin     pixmap height 12 width 9
    selector .dbList   at xmin.previous ymax+0.5 anchor all single width $!!isoMemWidth height $!!isoMemHeight database auto
  exit

  -- setup form tracking
  track |ISODCE| |DESICE| |CATACE| |PROPCE| |PADDCE| callback '!!isoMembers.track('

exit
-- End of form definition for !!isoMembers

------------------------------------------------------------------------
--
-- Method:      !isoMembers()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .isoMembers()

  -- define menus (navigate menu built dynamically)
  !this.newMenu('ControlMenu')
  !this.newMenu('switchMenu')
  !this.newMenu('NavigateMenu')
  !this.newMenu('NavFirstMenu')
  !this.newMenu('NavLastMenu')

  !this.controlMenu.add('menu', 'Switch', 'switchMenu')

  !this.switchMenu.add('toggle', 'Fabrication', '!!isoMembers.dbSwitch(')
  !this.switchMenu.add('toggle', 'Design', '!!isoMembers.dbSwitch(')

  !this.navFirstMenu.add('callback', 'Element', 'FIRST')
  !this.navFirstMenu.add('callback', 'Member', 'FIRST MEM')

  !this.navLastMenu.add('callback', 'Element', 'LAST')
  !this.navLastMenu.add('callback', 'Member', 'LAST MEM')

  -- set callbacks
  !this.previous.callback = 'PREVIOUS'
  !this.next.callback     = 'NEXT'
  !this.find.callback     = '!!isoMembers.findName(!!isoMembers.find)'
  !this.dbList.callback   = '!!isoMembers.navigate(!!isoMembers.dbList.selection().dbRef())'

  -- set pixmaps
  !this.previous.addPixmap(!!pml.getPathName('leftarrow9x12.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow9x12.png'))

endmethod
-- End of method definition for .isoMembers()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  if (!!ce.dbType eq 'ISOD') then
    !this.isodCe = !!ce
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
    !track = 'ISODCE'
  elseif (!!ce.dbType eq 'DESI') then
    !this.desiCe = !!ce
    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)
    !track = 'DESICE'
  else
    -- in another db whilst members form not tracking
    /*
    !this.isodCe = !!ce
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
    !track = 'ISODCE'
  endif

  !this.track(!!isoMembers, !track)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !type is STRING)

  -- constrain navigation within design and isod dbs
  if (!type ne 'DESICE' and !type ne 'ISODCE') then
    -- navigate back to previously displayed member
    if (!this.currentDb eq 'ISOD') then
      !!ce = !this.isodCe
    else
      !!ce = !this.desiCe
    endif
    return
  endif

  !element = !!ce

  -- select dbtype and set CE accordingly
  !this.currentDb = !element.dbType
  if (!element.dbType eq 'ISOD') then
    !this.isodCe = !element
    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)
  elseif (!element.dbType eq 'DESI') then
    !this.desiCe = !element
    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)
  endif

  -- dynamic creation of navigate menu to allow goto spool/field at top
  -- could make owner and member dynamic rather than control activation
  -- but this would make it inconsistent with Design
  !this.navigateMenu.clear()

  -- activate spool/field link for piping components
  if (!element.type ne 'WORL' ) then
    if (!element.owner.type eq 'BRAN') then
      if (!element.sfref.set()) then
        !this.navigateMenu.add('callback', 'Goto ' & !element.sfref.type, '!!ce = !!ce.sfref')
      endif
    endif
  endif

  -- remainder of navigate menu
  !this.navigateMenu.add('callback', 'Owner', 'OWNER')
  !this.navigateMenu.add('menu', 'First', 'navFirstMenu')
  !this.navigateMenu.add('menu', 'Last', 'navLastMenu')
  !this.navigateMenu.add('callback', 'Same', 'SAME')
  !this.navigateMenu.setActive('Owner', !element.owner.set())
  if (!element.type eq 'TUBI') then
    !active = false
  else
    !active = !element.members.set()
  endif
  !this.navFirstMenu.setActive('Member', !active)
  !this.navLastMenu.setActive('Member', !active)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !dbSwitch()
--
-- Description: Database Switch callback method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MENU] [menu gadget]
--   [2] [R] [STRING] [select state]
--
------------------------------------------------------------------------

-- Define method
define method .dbSwitch(!menu is MENU, !dummySelect is STRING)

  if (!menu.pickedField eq 'Fabrication') then

    !this.switchMenu.select('Fabrication', true)
    !this.switchMenu.select('Design', false)

    if (!this.isodCe.badRef()) then
      !!ce = !!dbeWorldGet('ISOD')
    else
      !!ce = !this.isodCe
    endif

  elseif (!menu.pickedField eq 'Design') then

    !this.switchMenu.select('Fabrication', false)
    !this.switchMenu.select('Design', true)

    if (!this.desiCe.badRef()) then
      !!ce = !!dbeWorldGet('DESI')
    else
      !!ce = !this.desiCe
    endif

  endif

endmethod
-- End of method definition for .dbSwitch(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      !navigate()
--
-- Description: Navigate method for form
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .navigate(!element is DBREF)

  if (!element.unset()) then
    !!alert.error('Element is empty or does not exist.')
  elseif (!element.type eq 'WORL' and !element.dbType ne !this.currentDb) then
    !!ce = WORLD
  elseif (!element ne !!ce) then
    !!ce = !element
  else
    -- element is same as current element, there is nothing to do
  endif

endmethod
-- End of method definition for .navigate(DBREF)

------------------------------------------------------------------------
--
-- Method:      !findName()
--
-- Description: Navigate to named element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [GADGET] [Text gadget holding element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .findName(!name is GADGET)

  call !!nameGadget(!name, 'OLD')
  if (!name.val ne 'unset') then
    !!ce = !name.val.dbRef()
    !name.clear()
  endif

endmethod
-- End of method definition for .findName(GADGET)
