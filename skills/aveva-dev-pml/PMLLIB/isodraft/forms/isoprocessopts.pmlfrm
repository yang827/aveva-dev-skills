--
-- File:            isoprocessopts.pmlfrm
--   Type:          Form Definition
--   Group:         IsoDraft options setting for pre and post process of IDF files
--   Keyword:       ISO
--   Module:        Isodraft
--   Replaces:
--
-- Author:          T Martin
-- Created:         1999/12/05 16:46:12
--
--
-- Description:
-- form to set and edit IDF pre and post process options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Initialise form with current option settings
--  setGadget(GADGET)                -                   checks and sets gadgets to off if blank is input
--  setProc()                        -                   sets pre and process options according to form settings
--

-- Define form
setup form !!isoProcessOpts

  !this.formTitle = 'IDF Processing'
  !this.iconTitle = 'Process'
  !this.callback  = '!this.init()'

  path down
  vdist 0.5
  -- pre process frame
  frame .pre |IDF Pre Processing|
    text .prep1 |Option 1 |call |!this.setGadget(!this.prep1)| width 40 is STRING
    vdist 0.1
    text .prep2 |Option 2 | call |!this.setGadget(!this.prep2)| width 40 is STRING
    text .prep3 |Option 3 | call |!this.setGadget(!this.prep3)| width 40 is STRING
    text .prep4 |Option 4 | call |!this.setGadget(!this.prep4)| width 40 is STRING
    text .prep5 |Option 5 | call |!this.setGadget(!this.prep5)| width 40 is STRING
  exit
  vdist 0.5
  -- post processing frame
  frame .post |IDF Post Processing|
    text .post1 |Option 1 | call |!this.setGadget(!this.post1)| width 40 is STRING
    vdist 0.1
    text .post2 |Option 2 | call |!this.setGadget(!this.post2)| width 40 is STRING
    text .post3 |Option 3 | call |!this.setGadget(!this.post3)| width 40 is STRING
    text .post4 |Option 4 | call |!this.setGadget(!this.post4)| width 40 is STRING
    text .post5 |Option 5 | call |!this.setGadget(!this.post5)| width 40 is STRING
  exit
  vdist 0.7

  button .ok at xmin.pre+36 ymax+0.5 |  OK  | call |!this.setProc()| ok
  button .dismiss at xmax form -size ymin |Cancel| Cancel

exit

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form with current option settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  do !a from 1 to 5
    var !p PREPROCESS $!a
    !p = !p.replace(|'|,||).substring(3).trim('l')
    if(!p.substring(1,1) eq |'| and !p.substring(!p.length(),1) eq |'|)then
      !p = !p.substring(2,!p.length() - 2)
    endif
    !this.prep$!a$n.val = !p.lowcase()
  enddo

  do !a from 1 to 5
    var !p POSTPROCESS $!a
    !p = !p.replace(|'|,||).substring(3).trim('l')
    if(!p.substring(1,1) eq |'| and !p.substring(!p.length(),1) eq |'|)then
      !p = !p.substring(2,!p.length() - 2)
    endif
    !this.post$!a$n.val = !p.lowcase()
  enddo


endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .setProc()
--
-- Description: sets pre and process options according to form settings
--              and saves the option file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setProc()

  do !a from 1 to 5
    !x = !this.prep$!a$n.val
    if (!x.lowcase() eq |off| or !x.trim().length() eq 0) then
      PREPROCESS $!a OFF
    else
      PREPROCESS $!a |$!x|
    endif
  enddo
  do !a from 1 to 5
    !x = !this.post$!a$n.val
    if (!x.lowcase() eq |off| or !x.trim().length() eq 0) then
      POSTPROCESS $!a OFF
    else
      POSTPROCESS $!a |$!x|
    endif
  enddo
  !!isoSaveOptions()

endmethod
-- End of method definition for .setProc()

------------------------------------------------------------------------
--
-- Method:      .setGadget(!gadget is GADGET)
--
-- Description: checks and sets gadgets to off if blank is input
--
-- Method Type: Procedure
--
-- Arguments:
--   [1] [RW] [gadget] [gadget to be modified]
--
------------------------------------------------------------------------

define method .setGadget(!gadget is GADGET)

  if(!gadget.val.lowcase().trim('lr') eq |off| or !gadget.val.trim().length() eq 0)then
    !gadget.val = |off|
  else
    !gadget.val = !gadget.val.trim('lr')
    if(!gadget.val.match('/') ne 1)then
      !gadget.val = '/' & !gadget.val
    endif
  endif

endmethod
-- End of method definition for .setGadget(GADGET)
