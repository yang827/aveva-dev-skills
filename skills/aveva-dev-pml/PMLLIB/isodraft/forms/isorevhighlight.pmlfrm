-- File:            isorevhighlight.pmlfrm
--   Type:          Form Definition
--   Group:         Change Representation
--     Keyword:     CHANGE
--   Module:        iso
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         08 January 2002
--
--
-- Description:
-- Option file settings for Change Highlighting
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form changes
--  checkWith()                      -                   Check the entered "with" syntax
--  dismiss()                        -                   Form closure
--  getRule(STRING)                  -                   Display the selected rule
--  init()                           -                   Form initialisation
--  isoRevHighlight()                -                   Constructor
--  loadColours()                    -                   Load colour selection form
--  loadMenu()                       -                   Load the criteria element menu
--  mode()                           -                   Modify the mode
--  modifyCriteria(STRING)           -                   Add or Remove elements to the criteria list
--  modifyRule(STRING)               -                   Create, Delete and Clear rules
--  setActive()                      -                   Set the form gadgets active status
--  setGadgets()                     -                   Set the form gadgets
--  setRule()                        -                   Set the current rule
--  storeColour()                    -                   Store the selected colour
--
------------------------------------------------------------------------
setup form !!isoRevHighlight at xr0 yr0

  -- Set
  frame .set || at xmin ymin

    -- Mode
    toggle .mode 'Show Change Highlighting' at x1 ymax

    -- Colour
    para .col at xmax+11.6 ymin text |Colour |
    button .colour '   ' at xmax ymin

  exit

  -- All rules
  frame .allRule | Rules | at xmin ymax

    -- Rules
    list .rules |Rules | at x9 ymin+1 single width 40 length 5
    button .createRule |Create| at x1 ymin.rules+1 tooltip 'Create a new Rule'
    button .deleteRule |Delete| at xmin ymax+0.2 tooltip 'Delete Selected Rule'
    button .clearRules |Clear | at xmin ymax+0.2 tooltip 'Clear all Rules'

    -- Criteria
    para .forPara at x1 ymax.rules text |For|
    option .menu at xmin.rules ymin tooltip 'Choose an Element Type' width 21
    list .criteria || at xmin.rules ymax.menu+0.3 single width 40 length 5
    button .addCriteria |Add   | at x1   ymin+0.2 tooltip 'Add "For" Type to the List'
    button .remCriteria |Remove| at xmin ymax+0.2 tooltip 'Remove List Entry'

    -- With restriction
    para .withPara at x1 ymax.criteria text |With|
    text .with at xmin.rules ymin tooltip 'Set the "Selective" Rule(s)' width 42 STRING

  exit

  -- Action
  button .apply |Apply| at x0 ymax+0.5 tooltip 'Write to the Options File'
  button .dismiss |Dismiss| at xmax form-size ymin tooltip 'Close'

  -- Members
  member .formMethods is ISOHIGHLIGHT
  member .origCol is REAL

  -- Set form in object
  !this.formMethods.form = !this

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method: .apply()
--
-- Description: Apply the form changes
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Set the options and write to file
  !this.formMethods.write()

  -- Set apply button inactive
  !this.setActive()

endmethod
-- End of method definition .apply()

-----------------------------------------------------------------------
--
-- Method: .checkWith()
--
-- Description: Check the entered "with" syntax
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkWith()

  -- Initialise variables
  !withString = !this.with.val.trim()
  !empty = ARRAY()

  -- For any input string
  if (!withString.neq(||)) then

    VAR !unusedTest COLLECT ALL WITH ($!withString) FROM !empty
      handle any

        -- Put out the error
        !!alert.error(|Invalid selection: | & !!error.text)
        !this.with.setFocus()
        return

      elsehandle none

        -- Capitalise the text
        !this.with.val = !withString.upCase()

        -- Set form as modified
        !this.formMethods.modified = true

      endhandle

  endif

  -- Set the rule syntax
  !this.setRule()

endmethod
-- End of method definition .checkWith()

------------------------------------------------------------------------
--
-- Method: .dismiss()
--
-- Description: Form closure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dismiss()

  -- Test for a modified form
  if (!this.formMethods.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.formMethods.write()

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoRevHighlight.hide()

endmethod
-- End of method definition .dismiss()

------------------------------------------------------------------------
--
-- Method: .getRule(STRING)
--
-- Description: Display the selected rule
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of modification taking place
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRule(!arg is STRING)

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Check for no rule details
  if (!this.rules.selection().upCase().neq('NONE')) then

    -- Display the selected rule "for" elements
    !this.criteria.dtext = !this.formMethods.rules[!this.rules.val].menuText
    !this.criteria.rtext = !this.formMethods.rules[!this.rules.val].elements

    -- Set the "with" syntax - leave as the previous setting if modify mode is create
    if (!arg.neq('CREATE')) then
      !this.with.val = !this.formMethods.rules[!this.rules.val].withString
    endif

  endif

  -- Set gadgets active status
  !this.setActive()

endmethod
-- End of method definition .getRule(STRING)

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Form initialisation
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Load the element menus from
  $m "%PDMSUI%/DRA/CLIB/DELEMTAB"

  -- Set the form as unmodified
  !this.formMethods.modified = false

  -- Load default menu
  !this.loadMenu()

  -- Read settings for change highlighting
  !this.formMethods.read(!this.menu)

  -- Set gadgets
  !this.setGadgets()

  -- Get rule data
  !this.getRule('NONE')

endmethod
-- End of method definition .init()

------------------------------------------------------------------------
--
-- Method: .isoRevHighlight()
--
-- Description: Constructor
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoRevHighlight()

  -- Form
  !this.formTitle = 'Change Highlighting'
  !this.initCall = '!this.init()'
  !this.cancelCall = '!this.dismiss()'
  !this.formRevision  = | $Revision: 1.5 $ |

  -- Gadget calls
  !this.mode.callback        = |!this.mode()|
  !this.colour.callback      = |!this.loadColours()|
  !this.rules.callback       = |!this.getRule('NONE')|
  !this.createRule.callback  = |!this.modifyRule('CREATE')|
  !this.deleteRule.callback  = |!this.modifyRule('DELETE')|
  !this.clearRules.callback  = |!this.modifyRule('CLEAR')|
  !this.addCriteria.callback = |!this.modifyCriteria('ADD')|
  !this.remCriteria.callback = |!this.modifyCriteria('REM')|
  !this.with.callback        = |!this.checkWith()|
  !this.apply.callback       = |!this.apply()|
  !this.dismiss.callback     = |!this.dismiss()|

endmethod
-- End of method definition .isoRevHighlight()

------------------------------------------------------------------------
--
-- Method: .loadColours()
--
-- Description: Load colour selection form
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadColours()

  -- Store original colour
  !this.origCol = !this.formMethods.colour

  -- Test for colour selection form
  if (undefined(!!isoColours)) then
    pml load form !!isoColours
  endif

  -- Set colour selection form action
  !!isoColours.action = '!!isoRevHighlight.storeColour()'

  -- Set start colour
  !!isoColours.setColour(!this.formMethods.colour)

  -- Set form title
  !!isoColours.formTitle = |Highlight Colour|

  -- Show colour selection form
  !!isoColours.show()

endmethod
-- End of method definition .loadColours()

------------------------------------------------------------------------
--
-- Method:      .loadMenu()
--
-- Description: Load the criteria element menu
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .loadMenu()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()
  !options = ARRAY()

  -- Create common options
  !options.append('All\ALL')
  !options.append('Pipes\PIPE')
  !options.append('Branches\BRANCH')
  !options.append('Branch Members\BRANCH MEMBERS')
  !options.append('Nozzles\NOZZLE')

  -- Add PIPING menu options
  !options.appendArray(!!cdElem2)

  -- Build arrays
  do !value val !options
    !dtext.append(!value.before('\'))
    !rtext.append(!value.after('\'))
  enddo

  -- Populate gadget
  !this.menu.dtext = !dtext
  !this.menu.rtext = !rtext

endmethod
-- End of method definition for .loadMenu(REAL)

------------------------------------------------------------------------
--
-- Method: .mode()
--
-- Description: Modify the mode
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mode()

  -- Store the mode in the form object
  !this.formMethods.store('MODE')

  -- Set apply active status
  !this.setActive()

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
-- Method:      .modifyCriteria(STRING)
--
-- Description: Add or Remove elements to the criteria list
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Whether to ADD or REMove elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .modifyCriteria(!arg is STRING)

  -- Initialise variables
  !dtext = !this.criteria.dtext
  !rtext = !this.criteria.rtext

  -- ADD the selected element to the criteria gadget
  if (!arg.eq('ADD')) then

    -- Check if not already added
    if (!dtext.findFirst(!this.menu.selection('DTEXT')).unset()) then

      -- Check for ALL
      if (!dtext.empty().not()) then

        if (!this.menu.selection('RTEXT').eq('ALL') and !dtext.empty().not()) then
          !response = !!alert.confirm('Cannot add "ALL" when other elements exist. Do you want to replace the existing element(s)?')
          if (!response.eq('YES')) then
            !dtext = ARRAY()
            !rtext = ARRAY()
          else
            return
          endif
        endif
        if (!this.menu.selection('RTEXT').neq('ALL') and !rtext[1].eq('ALL')) then
          !response = !!alert.confirm('Cannot add another element when "ALL" exists. Do you want to replace it?')
          if (!response.eq('YES')) then
            !dtext = ARRAY()
            !rtext = ARRAY()
          else
            return
          endif

        endif

      endif

      -- Append selection to criteria arrays
      !dtext.append(!this.menu.selection('DTEXT'))
      !rtext.append(!this.menu.selection('RTEXT'))

    else
      !!alert.warning('The selected element already exists in the rules list!')
      return
    endif

  -- REMove the selected item from the criteria gadget
  else

    -- Check for only one entry
    if (!dtext.size().eq(1)) then
      !response = !!alert.confirm('If you remove the last element the rule will be deleted. Do you wish to continue?')
      if (!response.eq('NO')) then
        return
      else
        !this.modifyRule('DELETE')
        return
      endif
    endif

    -- Remove the selected element from the criteria arrays
    !index = !dtext.findFirst(!this.criteria.selection('DTEXT'))
    !dtext.remove(!index)
    !rtext.remove(!index)

  endif

  -- Set form as modified
  !this.formMethods.modified = true

  -- Re-populate gadget
  !this.criteria.dtext = !dtext
  !this.criteria.rtext = !rtext

  -- Set the rule
  !this.setRule()

  -- Set gadget active status
  !this.setActive()

  -- Select the last element ADDed
  if (!arg.eq('ADD')) then
    !this.criteria.select('RTEXT',!this.menu.selection())
  endif

endmethod
-- End of method definition for .modifyCriteria(STRING)

------------------------------------------------------------------------
--
-- Method: .modifyRule(STRING)
--
-- Description: Create, Delete and Clear rules
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyRule(!arg is STRING)

  -- Create a new rule
  if (!arg.eq('CREATE')) then

    -- Clear rules
    if (!this.rules.selection().upCase().eq('NONE')) then
      !this.rules.clear()
    endif

    -- Append a new rule to the form object, using the current selected menu option as the default
    -- Build rule string testing for no "with" and "all" only
    if (!this.with.val.eq('')) then
      !withString = ''
    else
      !withString = | WITH ( | & !this.with.val & | )|
    endif
    if (!this.menu.selection().eq('ALL')) then
      !allString = ''
    else
      !allString = |ALL |
    endif
    !ruleString = |( | & !allString & !this.menu.selection() & | ) WITH ( | & !this.with.val & | )|
    !this.formMethods.rules.append(object ISORULE(!ruleString, !this.menu))

  -- Delete the selected rule
  elseif (!arg.eq('DELETE')) then

    -- Modify the form object
    !this.formMethods.rules.remove(!this.rules.val)

    -- Modify the display text
    !text = !this.rules.dtext
    !text.remove(!this.rules.val)
    !this.rules.dtext = !text

  -- Clear all rules
  elseif (!arg.eq('CLEAR')) then

    -- Empty the gadget & form object
    !this.rules.clear()
    !this.formMethods.rules.clear()

    -- Select the first menu option
    !this.menu.val = 1

  endif

  -- Set form as modified
  !this.formMethods.modified = true

  -- Reset form
  !this.setGadgets()

  -- For created, select the new rule
  if (!arg.eq('CREATE')) then
    !this.rules.val = !this.formMethods.rules.size()
  endif

  -- Get the rule data
  !this.getRule(!arg)

endmethod
-- End of method definition .modifyRule(STRING)

------------------------------------------------------------------------
--
-- Method: .setActive()
--
-- Description: Set the form gadgets active status
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive()

  -- Rules
  if (!this.rules.selection().upCase().eq('NONE')) then

    !this.rules.active       = false
    !this.deleteRule.active  = false
    !this.clearRules.active  = false
    !this.addCriteria.active = false
    !this.remCriteria.active = false
    !this.criteria.active    = false
    !this.with.active        = false

    !this.criteria.clear()
    !this.with.clear()

  else

    !this.rules.active       = true
    !this.deleteRule.active  = true
    !this.clearRules.active  = true
    !this.addCriteria.active = true
    !this.remCriteria.active = true
    !this.criteria.active    = true
    !this.with.active        = true

  endif

  -- Apply button
  if (!this.formMethods.modified) then
    !this.apply.active = true
  else
    !this.apply.active = false
  endif


endmethod
-- End of method definition .setActive()

------------------------------------------------------------------------
--
-- Method: .setGadgets()
--
-- Description: Set the form gadgets
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgets()

  -- Initialise variables
  !text = ARRAY()

  -- Mode
  !this.mode.val = !this.formMethods.mode

  -- Colour
  !this.colour.background = !this.formMethods.colour

  -- Rules
  if (!this.formMethods.rules.unset() or !this.formMethods.rules.empty()) then
    !text.append('None')
  else

    -- Read the form object rules and set the rule gadget
    do !array val !this.formMethods.rules

      -- Build rule string
      if (!array.withString.unset() or !array.withString.eq(||)) then
        !text.append(!array.forString)
      else
        !text.append(!array.forString & | WITH | & !array.withString)
      endif

    enddo

  endif
  !this.rules.dtext = !text

endmethod
-- End of method definition .setGadgets()

------------------------------------------------------------------------
--
-- Method: .setRule()
--
-- Description: Set the current rule
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRule()

  -- Initialise variables
  !selected = !this.rules.val
  !array = ARRAY()

  -- Save "for" criteria
  do !index ind !this.criteria.rtext

    -- Build criteria string
    !word = !this.criteria.rtext[!index]
    if (!index.eq(1)) then
      if (!word.eq('ALL')) then
        !allCriteria = !word
      else
        !allCriteria = |ALL | & !word
      endif
    else
      !allCriteria = !allCriteria & | ALL | & !this.criteria.rtext[!index]
    endif

  enddo
  !this.formMethods.rules[!this.rules.val].forString = |( | & !allCriteria & | )|
  !this.formMethods.rules[!this.rules.val].elements = !this.criteria.rtext
  !this.formMethods.rules[!this.rules.val].menuText = !this.criteria.dtext

  -- Save "with" syntax
  !this.formMethods.rules[!this.rules.val].withString = !this.with.val.upCase()

  -- Reset the form
  !this.setGadgets()

  -- Reselect the selected rule
  !this.rules.val = !selected
  !this.getRule('NONE')

  --Set gadget active status
  !this.setActive()

endmethod
-- End of method definition .setRule()

------------------------------------------------------------------------
--
-- Method: .storeColour()
--
-- Description: Store the selected colour
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .storeColour()

  -- Store colour
  !this.formMethods.store('COLOUR')

  -- Set colour button background
  !this.colour.background = !this.formMethods.colour

  -- Test for colour change
  if (!this.formMethods.colour.neq(!this.origCol)) then

    -- Set the form as modified
    !this.formMethods.modified = true

    -- Set gadgets active status
    !this.setActive()

  endif

endmethod
-- End of method definition .storeColour()
