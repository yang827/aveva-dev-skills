-- Description:
-- confirm cancellation of any changes made
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsConfirm()

  if(!!deplots.altered eq TRUE) then
    !result = !!alert.confirm( 'Do you want to lose all edits to parameters')
    if(!result eq 'NO') then
      !!deplots.okForm = FALSE
     !!deplots.show()
    endif
  endif

endfunction
-- End of function definition for !!dePlotsConfirm
