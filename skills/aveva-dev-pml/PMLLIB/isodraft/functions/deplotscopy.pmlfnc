--
--
-- Description:
-- Copies a detail plot parameter definition to a new file definition
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsCopy()

if(!!deplots.pardef eq TRUE) then
  !!alert.error( 'Parameter form still in use - please exit form')
  return
endif

-- check can copy something
!entry = !!deplots.plotnames.val

if(!entry gt 0) then
  !!deplots.copying = TRUE
  !!deplots.pardef  = TRUE

  !!deplots.thisFile = !!deplots.plotnames.rText[!entry]
  !!deplots.thisIndex = !entry
  !!detParams.plotFilename.val = ''
  !!detParams.plotFilename.active = TRUE
  !!detParams.browse.active = TRUE
  !!detParams.show()
else
  !!alert.error( 'No files to copy')
endif

endfunction
-- End of function definition for !!dePlotsCopy
