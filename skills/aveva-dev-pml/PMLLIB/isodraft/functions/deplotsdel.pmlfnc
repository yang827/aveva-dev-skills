--
--
-- Description:
-- remove a detail plotfile definition from the list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsDel()

if(!!deplots.pardef eq TRUE) then
  !!alert.error( 'Parameter form still in use - please exit form')
  return
endif

!entry = !!deplots.plotnames.val
if(!entry gt 0) then
  !!deplots.params.remove(!entry)
  !!deplots.newParamData.remove(!entry)
  !!deplots.altered = TRUE
  !!deplots.plotnames.dText = !!deplots.params
else
  !!alert.error( 'No files to delete')
endif

endfunction
-- End of function definition for !!dePlotsDel
