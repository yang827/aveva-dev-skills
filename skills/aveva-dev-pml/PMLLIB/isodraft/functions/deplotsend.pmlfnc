--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsEnd()

!!deplots.valid = TRUE

-- check whether detail parameters form still shown
if(!!deplots.pardef eq TRUE) then
  !!deplots.valid = FALSE
  !!alert.error( 'Parameter form still in use - please exit form')
endif

-- validate x y co-ords and char height - depending on positioning method
if(!!deplots.valid eq TRUE) then
  if(!!deplots.manual eq FALSE) then
    do !count to 4
      call !!dePlotsValidate(!count)
      break if (!!deplots.valid eq FALSE)
    enddo
  else
    call !!dePlotsValidate(3)
  endif
endif

-- check whether detail plots on/off
if(!!deplots.valid eq TRUE) then
  if(!!deplots.display.val eq FALSE) then
     textpos detailplots off
  else
    if(!!deplots.nsbc.val eq TRUE) then
      textpos detailplots on
    else
      textpos detailplots on nsbcoff
    endif
  endif
endif

if(!!deplots.valid eq TRUE) then

-- Store current units, then set according to userdata

  call !!plotDetailSyntax(1, ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ')
  if( !!deplots.dcorn.val eq 1) then
   !corn = 'TL'
  elseif ( !!deplots.dcorn.val eq 2) then
   !corn = 'TR'
  elseif ( !!deplots.dcorn.val eq 3) then
   !corn = 'BL'
  elseif ( !!deplots.dcorn.val eq 4) then
   !corn = 'BR'
  endif

  !align = !!deplots.align.rText[!!deplots.align.val]
  !stack = !!deplots.stackDir.rText[!!deplots.stackDir.val]
  !x = !!deplots.xPos.val
  !y = !!deplots.yPos.val
  !h = !!deplots.charHeight.val
  !st = !!deplots.stackVal.val
  !sc = !!deplots.scale.val

-- Detail plots

  if( !!deplots.display.val eq TRUE) then
    if(!!deplots.manual eq TRUE) then
      call !!plotDetailSyntax(4, !corn, !x, !y, !h, !align, !st ,!stack, !sc)
    else
      call !!plotDetailSyntax(2, !corn, !x, !y, !h, !align, !st ,!stack, !sc)
    endif
  endif

-- Parameterised plotfiles - clear existing definition if modified

  if ( !!deplots.params.size() eq 0 ) then
     PLOTDETAILDATA CLEAR
  else
    if(!!deplots.altered eq TRUE) then
      PLOTDETAILDATA CLEAR
      do !count to !!deplots.newParamData.size()
        !file = '/' + !!deplots.newParamData[!count].file
        do !attCount to !!deplots.newParamData[!count].params.size()
          !pars = !!deplots.newParamData[!count].params[!attCount]
          call !!plotDetailSyntax(3, !file, !pars, ' ', ' ', ' ', ' ', ' ', ' ')
        enddo
      enddo
    endif
  endif

-- Reset units
  $!!deplots.allunits

-- Save options state
  call !!isoSaveOptions()

-- show form to get correct values
else
  !!deplots.okForm = FALSE
  !!deplots.show()
endif

endfunction
-- End of function definition for !!dePlotsEnd
