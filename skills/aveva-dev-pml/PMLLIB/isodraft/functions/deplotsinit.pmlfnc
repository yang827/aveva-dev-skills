--
--
-- Description:
-- initialise deplots form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsInit()

-- Set units labels and store units in userdata

 if(!!dePlots.okForm eq TRUE) then
   !!dePlots.altered = FALSE
--  var !dunits UNITS
   !dunits = STRING()
   !tempString = STRING()
   call !!queryPlotdetail(1, !tempString , 0, !dunits)
  !!dePlots.allunits = !dunits
  !!dePlots.units = !dunits.part(3)

  if ( !!dePlots.units eq 'MM' ) then
     !!dePlots.xunits.val = 'mm'
     !!dePlots.yunits.val = 'mm'
     !!dePlots.hunits.val = 'mm'
  else
     !!dePlots.xunits.val = 'in'
     !!dePlots.yunits.val = 'in'
     !!dePlots.hunits.val = 'in'
  endif

-- Detail plots start position:
-- Corner TL X 10 Y 10 Char Height 3 Direction RIGHT Stack 2 Direction UP Scale 100
--  var !delPosi TEXTPOS DETAILPLOTS
  !delPosi = STRING()
  call !!queryPlotdetail(2, !tempString, 0, !delPosi)

  !dePlotData = !delPosi.split()
  !size = !dePlotData.size()
  if (!dePlotData[$!size] eq 'NSBCOFF') then
  	!disp = TRUE
    !nsbc = FALSE
    !size = !size - 2
  elseif (!dePlotData[$!size] eq 'ON') then
    !disp = TRUE
    !nsbc = TRUE
    !size = !size - 1
  else
    !disp = FALSE
    !nsbc = FALSE
  endif

-- Initialise all fields to active
  !!dePlots.dcorn.active = TRUE
  !!dePlots.xPos.active = TRUE
  !!dePlots.yPos.active = TRUE
  !!dePlots.align.active = TRUE
  !!dePlots.stackVal.active = TRUE
  !!dePlots.stackDir.active = TRUE

-- Initialise Plotfile Names
  do !count to !!dePlots.params.size()
    !!dePlots.params.remove(1)
  enddo
  !!dePlots.plotnames.dText = !!dePlots.params

  !!dePlots.display.val = !disp
  !!dePlots.nsbc.val = !nsbc

  if ( !dePlotData[1] eq 'OFF' or !dePlotData[1] eq 'Unset' ) then
    !!dePlots.manual = FALSE
    !!dePlots.method.val = 1
    !!dePlots.dcorn.val = 1
    !!dePlots.xPos.val = ''
    !!dePlots.yPos.val = ''
    !!dePlots.charHeight.val = '2.1'
    !!dePlots.align.val = 4
    !!dePlots.stackVal.val = '20'
    !!dePlots.stackDir.val = 1
    !!dePlots.scale.val = '100'
  else

-- check whether manual positioning or stacking
-- manual method first

    if(!size eq 5 or !size eq 6) then
      !!dePlots.method.val = 2
      !!dePlots.manual = TRUE

      !!dePlots.charHeight.val = !dePlotData[3]
      !!dePlots.scale.val = !dePlotData[5]

      !!dePlots.dcorn.val = 1
      !!dePlots.xPos.val = ''
      !!dePlots.yPos.val = ''
      !!dePlots.align.val = 4
      !!dePlots.stackVal.val = ''
      !!dePlots.stackDir.val = 1
-- grey out fields
      !!dePlots.dcorn.active = FALSE
      !!dePlots.xPos.active = FALSE
      !!dePlots.yPos.active = FALSE
      !!dePlots.align.active = FALSE
      !!dePlots.stackVal.active = FALSE
      !!dePlots.stackDir.active = FALSE

-- stacking method
    else
      !!dePlots.method.val = 1
      !!dePlots.manual = FALSE
      if ( !dePlotData[2] eq 'TL' ) then
        !!dePlots.dcorn.val = 1
      elseif ( !dePlotData[2] eq 'TR' ) then
      !!dePlots.dcorn.val = 2
      elseif ( !dePlotData[2] eq 'BL' ) then
        !!dePlots.dcorn.val = 3
      elseif ( !dePlotData[2] eq 'BR' ) then
        !!dePlots.dcorn.val = 4
      endif
      !!dePlots.xPos.val = !dePlotData[4]
      !!dePlots.yPos.val = !dePlotData[6]
      !!dePlots.charHeight.val = !dePlotData[8]
      if ( !dePlotData[10] eq 'UP' ) then
        !!dePlots.align.val = 1
      elseif ( !dePlotData[10] eq 'DOWN' ) then
        !!dePlots.align.val = 2
      elseif ( !dePlotData[10] eq 'LEFT' ) then
        !!dePlots.align.val = 3
      elseif ( !dePlotData[10] eq 'RIGHT' ) then
        !!dePlots.align.val = 4
      endif
      !!dePlots.stackVal.val = !dePlotData[12]
      if ( !dePlotData[14] eq 'UP' ) then
        !!dePlots.stackDir.val = 1
      elseif ( !dePlotData[14] eq 'DOWN' ) then
        !!dePlots.stackDir.val = 2
      elseif ( !dePlotData[14] eq 'LEFT' ) then
        !!dePlots.stackDir.val = 3
      elseif ( !dePlotData[14] eq 'RIGHT' ) then
        !!dePlots.stackDir.val = 4
      endif
      !!dePlots.scale.val = !dePlotData[16]
    endif
  endif

-- check whether any parameterised plotfiles defined
--  var !detParamFiles PLOTDETAILDATA FILENAMES

  !detParamFiles = STRING()
  call !!queryPlotdetail(3, !tempString, 0, !detParamFiles)
  !!dePlots.params = !detParamFiles.split()

-- if no parameterised plotfiles - then empty out array
  if ( !!dePlots.params[1] eq 'No' ) then
    do !count to !!dePlots.params.size()
      !!dePlots.params.remove(1)
    enddo
  else
    !!dePlots.params.sort()
    !!dePlots.plotnames.dText = !!dePlots.params
    do !count to !!dePlots.params.size()
      !!dePlots.newParamData[!count] = object DEPLOT()
      !!dePlots.newParamData[!count].file = !!dePlots.params[!count]

-- now read in the attributes associated with each plotfile
       !locvar1 = '/'+!!dePlots.params[!count]
       !locvar2 = STRING()
       !numatts = STRING()
       call !!queryPlotdetail(4, !locvar1, 0, !numatts)
       do !thisAtt to !numatts.real()
         !locvar3 = STRING()
         call !!queryPlotdetail(5, !locvar1, !thisAtt, !locvar3)
         !!dePlots.newParamData[!count].params.append(!locvar3)
       enddo
       !!dePlots.newParamData[!count].params.sort()
     enddo

   endif
 endif
 !!dePlots.pardef = FALSE
 !!dePlots.copying = FALSE
 !!dePlots.modifying = FALSE
 !!dePlots.reshow = FALSE
 !!dePlots.okForm = TRUE

  if( undefined(!!detParams)) then
     pml load form !!detParams
  endif

endfunction
-- End of function definition for !!dePlotsInit
