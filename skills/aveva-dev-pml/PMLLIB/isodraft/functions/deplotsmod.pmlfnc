--
--
-- Description:
-- modify the definition of parameters for a plotfile
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsMod()

if(!!deplots.pardef eq TRUE) then
  !!alert.error( 'Parameter form still in use - please exit form')
  return
endif

!entry = !!deplots.plotnames.val
if(!entry gt 0) then
  !!deplots.thisFile = !!deplots.plotnames.rText[!entry]
  !!deplots.thisIndex = !entry
  !!deplots.pardef = TRUE
  !!deplots.modifying = TRUE
  !!detParams.plotFilename.active = FALSE
  !!detParams.browse.active = FALSE
  !!detParams.show()
else
  !!alert.error( 'No files to modify')
endif


endfunction
-- End of function definition for !!dePlotsMod
