--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsNew()

  if(!!deplots.pardef eq TRUE) then
    !!alert.error( 'Parameter form still in use - please exit form')
    return
  endif

  !!deplots.pardef = TRUE

  !!deplots.thisFile = ''
  !!deplots.thisIndex = 0
  !!detParams.plotFilename.active = TRUE
  !!detParams.browse.active = TRUE
  !!detParams.attArray.clear()
  !!detParams.show()

endfunction
-- End of function definition for !!dePlotsNew
