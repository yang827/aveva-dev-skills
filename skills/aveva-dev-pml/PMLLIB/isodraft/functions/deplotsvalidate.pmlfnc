--
--
-- Description:
-- validate input of the detailplots form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dePlotsValidate(!iflag is REAL)

-- Build distance format object
!!setGlobalFormats()

-- Test for units
if ( !!deplots.hunits.val eq 'mm' ) then
  !hmin =  1.4
  !hmax =  99
else
  !hmin = 0.1/16
  !hmax = 3.7/8
endif

-- Check for invalid settings

!!deplots.valid = TRUE

if (!!deplots.display.val) then
  if(!iflag eq 1) then
    if ( !!deplots.xPos.val.real(!!distanceFMT) lt 0  or !!deplots.xPos.val eq '') then
      !!deplots.xPos.setFocus()
      !!alert.error(  'Invalid X position')
      !!deplots.valid = FALSE
     endif
  elseif(!iflag eq 2) then
    if ( !!deplots.yPos.val.real(!!distanceFMT) lt 0  or !!deplots.yPos.val eq '') then
      !!deplots.yPos.setFocus()
      !!alert.error(  'Invalid Y position')
      !!deplots.valid = FALSE
    endif
  elseif(!iflag eq 3) then
    if ( !!deplots.charHeight.val.real(!!distanceFMT) lt 0  or !!deplots.charHeight.val eq '') then
      !!deplots.charHeight.setFocus()
      !!alert.error(  'Invalid character height')
      !!deplots.valid = FALSE
    else
      if ( !!deplots.charHeight.val.real(!!distanceFMT) lt !hmin ) then
        !!deplots.charHeight.val = !hmin.string()
        !!alert.error( 'Minimum character height is ' & !hmin & !!deplots.hunits )
      elseif ( !!deplots.charHeight.val.real(!!distanceFMT) gt !hmax ) then
        !!deplots.charHeight.val =  !hmax.string()
        !!alert.error( 'Maximum character height is ' & !hmax & !!deplots.hunits )
      endif
    endif
  elseif(!iflag eq 4) then
    if ( !!deplots.align.val eq !!deplots.stackDir.val) then
      !!alert.error(  'Second Direction inconsistent with first direction')
      !!deplots.valid = FALSE
    endif

--  check for manual or stacking method
--  if manual - set manual true and grey out unwanted fields

  elseif(!iflag eq 5) then
    if ( !!deplots.method.val eq 2) then
      !!deplots.manual = TRUE
      !!deplots.dcorn.active = FALSE
      !!deplots.stackVal.active = FALSE
      !!deplots.align.active = FALSE
      !!deplots.stackDir.active = FALSE
      !!deplots.xPos.active = FALSE
      !!deplots.yPos.active = FALSE

--  if switching to stacking - ungrey fields and set manual to false
    else
      !!deplots.manual = FALSE
      !!deplots.dcorn.active = TRUE
      !!deplots.stackVal.active = TRUE
      !!deplots.align.active = TRUE
      !!deplots.stackDir.active = TRUE
      !!deplots.xPos.active = TRUE
      !!deplots.yPos.active = TRUE
    endif
  endif
endif



endfunction
-- End of function definition for !!dePlotsValidate
