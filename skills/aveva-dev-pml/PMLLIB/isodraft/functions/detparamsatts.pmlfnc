--
--
-- Description:
-- puts attribute names into list on parameter form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsAtts()

-- initialise  vars
!thisPar = 0
if(!!detParams.attArray.size() gt 0) then
  !thisPar = !!detParams.attributes.val
endif

if(!thisPar gt 0) then
  !thisAtt = !!detParams.attributes.rText[!thisPar]
  !splitAtt = !thisAtt.split()
  !size = !splitAtt.size()
  if( !size eq 9) then
    !!detParams.attName.val = !splitAtt[1]
    !!detParams.xPos.val = !splitAtt[3]
    !!detParams.yPos.val = !splitAtt[5]
    !!detParams.charHeight.val = !splitAtt[7]
    !!detParams.angle.val = !splitAtt[9]
  elseif( !size eq 10) then
    !!detParams.attName.val = !splitAtt[1] + ' ' + !splitAtt[2]
    !!detParams.xPos.val = !splitAtt[4]
    !!detParams.yPos.val = !splitAtt[6]
    !!detParams.charHeight.val = !splitAtt[8]
    !!detParams.angle.val = !splitAtt[10]
  elseif( !size eq 11) then
    !!detParams.attName.val = !splitAtt[1] + ' ' + !splitAtt[2] + ' ' + !splitAtt[3]
    !!detParams.xPos.val = !splitAtt[5]
    !!detParams.yPos.val = !splitAtt[7]
    !!detParams.charHeight.val = !splitAtt[9]
    !!detParams.angle.val = !splitAtt[11]
  endif
else
  !!detParams.attName.val = ''
  !!detParams.xPos.val = ''
  !!detParams.yPos.val = ''
  !!detParams.charHeight.val = '2.1'
  !!detParams.angle.val = '0'
endif


endfunction
-- End of function definition for !!detParamsAtts
