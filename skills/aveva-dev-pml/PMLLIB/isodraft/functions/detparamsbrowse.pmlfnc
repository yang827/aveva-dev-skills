-- Define function
define function !!detParamsBrowse()
Import 'pmlfilebrowser'
handle any
endhandle

  var !path EVAR PDMSUSER
  call !!fileBrowser(!path, !!detParams.plotFilename.val, 'Select a plotfile...', TRUE, 'call !!detParamsFileSet()')

endfunction
-- End of function definition for !!detParamsBrowse
