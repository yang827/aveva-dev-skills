--
--
-- Description:
-- validation and exit from the parameter form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsEnd()

-- everything already validated apart from filename - which could still be wrong
-- check at least one attribute defined


!!detParams.valid = TRUE

if(!!detParams.plotFilename.val eq '') then
   !!detParams.valid = FALSE
   !!alert.error(  'A filename must be specified')
else
   if(!!deplots.modifying eq FALSE) then
      call !!detParamsFile()
   endif
endif

if(!!detParams.valid eq TRUE) then
  if(!!detParams.attributes.val eq 0) then
     !!detParams.valid = FALSE
     !!alert.error(  'No attributes have been defined')
     !!detParams.attName.setFocus()
  endif
endif

-- things all ok update array and add filename to list

if(!!detParams.valid eq TRUE) then

  !addFile = FALSE
  if(!!deplots.copying eq TRUE) then
    !addFile = TRUE
  elseif(!!deplots.modifying eq FALSE) then
    !addFile = TRUE
  endif

-- add new file data to parameter objects

  if(!addFile) then
    !!deplots.params.append(!!detParams.plotFilename.val)
    !last = !!deplots.params.size()
    !!deplots.newParamData[!last] = object DEPLOT()
    !!deplots.newParamData[!last].file = !!detParams.plotFilename.val
-- now insert parameter data into object

       do !thisAtt to !!detParams.attArray.size()
         !pars = !!detParams.attArray[!thisAtt]
         !!deplots.newParamData[!last].params.append(!pars)
       enddo

    !!deplots.params.sort()
-- now sort object array based on unsorted object
    !evaluate = object BLOCK('!!deplots.newParamData[!evalIndex].file')
    !f = !!deplots.newParamData.evaluate(!evaluate)
    !x = !f.sortedIndices()
    !arr = object ARRAY()
    do !v values !x
      !arr.append(!!deplots.newParamData[!v])
    enddo
    !!deplots.newParamData = !arr
    !!deplots.plotnames.dText = !!deplots.params

-- modifying existing - so clear out array and over-write
  else
    !!deplots.newParamData[!!deplots.thisIndex].params.clear()
    do !thisAtt to !!detParams.attArray.size()
       !pars = !!detParams.attArray[!thisAtt]
       !!deplots.newParamData[!!deplots.thisIndex].params.append(!pars)
    enddo
  endif

  !!deplots.copying = FALSE
  !!deplots.modifying = FALSE
  !!deplots.pardef  = FALSE
  !!detParams.attArray.clear()
  !!deplots.altered = TRUE

-- incomplete/errors reshow form
else
  !!deplots.reshow = TRUE
  !!detParams.show()
endif


endfunction
-- End of function definition for !!detParamsEnd
