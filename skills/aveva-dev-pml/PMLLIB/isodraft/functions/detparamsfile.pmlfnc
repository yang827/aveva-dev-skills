--
-- Description:
-- set filename from browse selector
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsFile()


!!detParams.valid = TRUE

!size = !!deplots.params.size()
do !count to !size
  !lengthNew = !!detParams.plotFilename.val.length()
  !existingFile  = !!deplots.params[!count]
  !lengthOld = !existingFile.length()
  if(!lengthNew eq !lengthOld) then
    !match = !!detParams.plotFilename.val.match(!existingFile)
    if(!match gt 0) then
      !!alert.error(  'Definition for ' & !existingFile & ' already exists')
       !!detParams.plotFilename.setFocus()
       !!detParams.valid = FALSE
       break
    endif
  endif
enddo


endfunction
-- End of function definition for !!detParamsFile
