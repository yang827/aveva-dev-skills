--
--
-- Description:
-- include parameter definition in list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsInc()

do !count to 4
  call !!detParamsVal(!count)
  break if (!!detParams.valid eq FALSE)
enddo

if(!!detParams.valid eq TRUE) then
  !val1 = !!detParams.attName.val.upcase()
  !val2 = ' X ' + !!detParams.xPos.val
  !val3 = ' Y ' + !!detParams.yPos.val
  !val4 = ' HEIGHT ' + !!detParams.charHeight.val
  !val5 = ' ANGLE ' + !!detParams.angle.val
  !newEntry = !val1 + !val2 + !val3 + !val4 + !val5
  if( !!detParamsUnique(!val1) eq TRUE) then
    !!detParams.attArray.append(!newEntry)
    !!detParams.attArray.unique()
    !!detParams.attArray.sort()
    !entry = !!detParams.attArray.findFirst(!newEntry)
    !!detParams.attributes.dText = !!detParams.attArray
    !!detParams.attributes.val = !entry
  else
    !!alert.error(  'Cannot duplicate attribute ' & !val1)
  endif
endif


endfunction
-- End of function definition for !!detParamsInc
