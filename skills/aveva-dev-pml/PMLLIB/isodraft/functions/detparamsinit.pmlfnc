--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsInit()

if(!!deplots.reshow eq FALSE) then
  !!detParams.plotFilename.val =  !!deplots.thisFile

-- check whether any attributes defined for plotfile
  if(!!detParams.plotFilename.val ne '' ) then
    !numatts = !!deplots.newParamData[!!deplots.thisIndex].params.size()
    do !thisAtt to !numatts.real()
      !locvar4= !!deplots.newParamData[!!deplots.thisIndex].params[!thisAtt]
      !!detParams.attArray.append(!locvar4)
    enddo
    !!detParams.attArray.sort()
  endif
  !!detParams.attributes.dText = !!detParams.attArray
  call !!detParamsAtts()
endif
!!deplots.reshow = FALSE

endfunction
-- End of function definition for !!detParamsInit
