--
--
-- Description:
-- remove a parameter from the parameter list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsRemove()

!entry = !!detParams.attributes.val
if(!entry gt 0) then
  !!detParams.attArray.remove(!entry)
  !!detParams.attributes.dText = !!detParams.attArray
  call !!detParamsAtts()
else
  !!alert.error(  'Nothing to remove')
endif

endfunction
-- End of function definition for !!detParamsRemove
