--
--
-- Description:
-- make sure attribute definition is unique in parameter list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsUnique(!attValue is STRING) is BOOLEAN

!unique = TRUE

do !count to !!detParams.attArray.size()
 !thisString = !!detParams.attArray[!count]
 !iPos = !thisString.match(!attValue)
 if(!iPos gt 0) then
   !unique = FALSE
   break
 endif
enddo

return !unique

endfunction
-- End of function definition for !!detParamsUnique
