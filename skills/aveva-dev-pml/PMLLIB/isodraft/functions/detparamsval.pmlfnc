--
--
-- Description:
-- Validate attribute definition before inserting into parameter list
-- s
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!detParamsVal(!flag is REAL)

!!detParams.valid = TRUE

-- Possibility of having legal att syntax checked in the future
--  if( !!checkLegalAtt(!!detParams.attName.val) eq FALSE) then

if(!flag eq 1) then
  if(!!detParams.xPos.val.real().unset()) then
    !!alert.error(  'X position must be set')
    !!detParams.valid = FALSE
    !!detParams.xPos.setFocus()
  elseif(!!detParams.xPos.val.real() le 0) then
    !!alert.error(  'X position must be > 0')
    !!detParams.valid = FALSE
    !!detParams.xPos.setFocus()
  endif
elseif(!flag eq 2) then
  if(!!detParams.yPos.val.real().unset()) then
    !!alert.error(  'Y position must be set')
    !!detParams.valid = FALSE
    !!detParams.yPos.setFocus()
  elseif(!!detParams.yPos.val.real() le 0) then
    !!alert.error(  'Y position must be > 0')
    !!detParams.valid = FALSE
    !!detParams.yPos.setFocus()
  endif
elseif(!flag eq 3) then
  if(!!detParams.charHeight.val.real().unset()) then
    !!alert.error(  'Character height must be set')
    !!detParams.valid = FALSE
    !!detParams.charHeight.setFocus()
  elseif(!!detParams.charHeight.val.real() le 0) then
    !!alert.error(  'Character height must be > 0')
    !!detParams.valid = FALSE
    !!detParams.charHeight.setFocus()
  endif
elseif(!flag eq 4) then
  if(!!detParams.angle.val.real().unset()) then
    !!alert.error(  'Angle must be set')
    !!detParams.valid = FALSE
    !!detParams.angle.setFocus()
  elseif(!!detParams.angle.val.real() lt -180 or !!detParams.angle.val.real() gt 180) then
    !!alert.error(  'angle must be in range -180 to + 180')
    !!detParams.valid = FALSE
    !!detParams.angle.setFocus()
  endif
endif

endfunction
-- End of function definition for !!detParamsVal
