define function !!isdOptFileList(!optGadget is GADGET, !listGadget is GADGET, !stdOpt is STRING, !warn is BOOLEAN)

  !optFileList = ARRAY()

  !prjOpt = !optGadget.selection()

  if (!prjOpt eq 'PROJ') then
    var !isoDir EVAR $:ISODIR$:
    -- if Project variable is not set change default area
    if (!isoDir.trim().empty()) then
      if (!warn) then
        !!alert.warning('$:ISODIR$: is not set, changing to company default area')
      endif
      !prjOpt = 'APPW'
    else
      !prjVar = !!evarSplit('$:ISODIR$:')
      !pathValid = FALSE
      do !i indices !prjVar
        !prjPaths[!i] = object FILE(!prjVar[!i] + '/' + !stdOpt)
        if (!prjPaths[!i].exists()) then
          !pathValid = TRUE
        endif
      enddo
      if (NOT(!pathValid)) then
        if (!warn) then
          !!alert.warning('$:ISODIR$: path does not exist, changing to company default Area')
        endif
        !prjOpt = 'APPW'
      endif
    endif
  endif

  if (!prjOpt eq 'APPW') then
    var !isoDir EVAR PDMSDFLTS
    -- If default area variable is not set change to local area
    if (!isoDir.trim().empty()) then
      if (!warn) then
        !!alert.warning('PDMSDFLTS is not set, changing local area')
      endif
      !prjOpt = 'Local'
    else
      !prjVar = !!evarSplit('PDMSDFLTS')
      !pathValid = FALSE
      do !i indices !prjVar
        !prjPaths[!i] = object FILE(!prjVar[!i] + '/' + !stdOpt)
        if (!prjPaths[!i].exists()) then
          !pathValid = TRUE
        endif
      enddo
      if (NOT(!pathValid)) then
        if (!warn) then
          !!alert.warning('Could not find any valid path name for PDMSDFLTS, setting to company default Area')
        endif
        !prjOpt = 'Local'
      endif
    endif
  endif

  if (!prjOpt eq 'Local') then
    !tempFile = object FILE('.')
    !prjPaths[1] = !tempFile
  endif

  !evalEntry = object BLOCK('!fileList[!evalIndex].entry()')
  do !i indices !prjPaths
    if (!prjPaths[!i].exists()) then
      !fileList = !prjPaths[!i].files()
      !fileNameList = !fileList.evaluate(!evalEntry)
      !optFileList.appendArray(!fileNameList)
    endif
  enddo
   !optFileList.unique()
   !optFileList.sort()

   !optGadget.select('rtext', !prjOpt)
   !listGadget.dText =!optFileList

endfunction
-- End of function definition for !!isdOptFileList
