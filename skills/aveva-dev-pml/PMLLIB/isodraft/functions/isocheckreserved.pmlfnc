-- Created:         Fri July 05 15:09:11 GMT 2002
--
--
-- Description:
-- Check that the entered reserved area will fit on the sheet
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The paper height
--    2   R      STRING      The Top margin
--    3   R      STRING      The Bottom margin
--    4   R      STRING      The area being reserved
--    5   R      STRING      The description of the area being reserved DRG or MTO
--    6   R      GADGET      The gadget being set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!isoCheckReserved(!paper is STRING, !marginT is STRING, !marginB is STRING, !area is STRING, !descr is STRING, !gadget is GADGET)

  -- Build distance format object
  !!setGlobalFormats()

  -- Convert paper, margins and area values to real values
  !paperHeight  = object REAL(!paper,!!distanceFMT)
  !marginTop    = object REAL(!marginT,!!distanceFMT)
  !marginBottom = object REAL(!marginB,!!distanceFMT)
  !areaHeight   = object REAL(!area,!!distanceFMT)

  -- Take margins into account
  !spaceHeight = !paperHeight - !marginTop - !marginBottom
  !space = !spaceHeight.string(!!distanceFMT)

  -- Test area against available space
  if (!areaHeight.gt(!spaceHeight)) then
    !!alert.warning('The ' & !descr & ' reserved area cannot be larger than the space available - ' & !space)
    !gadget.val = '0'
  endif

endfunction
-- End of function definition for !!isoCheckReserved
