-- File:            isochkstandout.pmlfnc
--   Type:          Function Definition
--   Module:        ISODRAFT
--
-- Author:          Steve Wilson
-- Created:         02 Sept 2002
--
--
-- Description:
-- Checks that dimension standouts on form CDIDIME are not the same
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being set
--    2   R      GADGET      The second gadget
--    3   R      GADGET      The third gadget
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!isoChkStandout(!gadget is GADGET, !gadgetS is GADGET, !gadgetT is GADGET)

  -- Read gadget values
  !standout  = !gadget.val
  !standoutS = !gadgetS.val
  !standoutT = !gadgetT.val

  -- Get start dimension standout values
  -- ** OLD PML SYNTAX **
  var !dist split DIMDIST

  -- Component
  if (!dist[1].upCase().eq('DEFAULT')) then
    !dimD = '0'
  else
    !dimD = !dist[1]
  endif

  -- Overall
  if (!dist[2].upCase().eq('DEFAULT')) then
    !oveD = '0'
  else
    !oveD = !dist[2]
  endif

  -- Support
  if (!dist[3].upCase().eq('DEFAULT')) then
    !supD = '0'
  else
    !supD = !dist[3]
  endif

  -- Check that the three gadget values are not the same
  if (!standout.eq(!standoutS) or !standout.eq(!standoutT)) then
    if (!gadget.name().eq('DIMD')) then
      !!alert.warning('The Component standout cannot be the same value as either the Overall or Support standout. Resetting to original value')
      !gadget.val = !dimD
    elseif (!gadget.name().eq('OVED')) then
      !!alert.warning('The Overall standout cannot be the same value as either the Component or Support standout. Resetting to original value')
      !gadget.val = !oveD
    else
      !!alert.warning('The Support standout cannot be the same value as either the Overall or Component standout. Resetting to original value')
      !gadget.val = !supD
    endif
  endif

  -- Set focus
  !gadget.setFocus()

endfunction
-- End of function definition
