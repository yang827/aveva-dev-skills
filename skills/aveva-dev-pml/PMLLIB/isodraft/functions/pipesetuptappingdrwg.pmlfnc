--  File:            pipesetuptappingdrwg.pmlfnc
--    Type:          Function Definition
--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        draft
--  Author:          Michael Board
--  Created:
--
--  Description:     Setup pipe tapping drawing to be created in draft
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pipesetuptappingdrwg(!element is DBREF, !spldrg is DBREF)

  var !projCode proj code
  var !mdb mdb
  var !user user
  var !unique unique
  var !installenv evar 'pdms_installed_dir'

  -- create temporary login file
  !userlogin = object PMLUSERLOGIN()
  !userlogin.project(!projCode)
  !userlogin.mdb(!mdb)

  var !path evar pdmswk
  !path = !path.replace(';','')
  !userlogin.saveToFile(!path & '\temp_login_' & !user & '.tmp')

  -- create macro file for spool drawing
  !macfile = object FILE('%pdmsuser%\maketappingdrwg.mac')
  !macfile.open('OVER')

  -- run temporary user login file as first line of makespooldrwg.mac to set project, username, password and MDB
  !macfile.writeRecord('$m "/$!path\temp_login_' & !user & '.tmp"')

  -- write current mdb
  !macfile.writeRecord(!mdb)
  -- log-in outfitting draft module

  if !!module().productfamily.upcase().eq('MARINE') then	
    !macfile.writeRecord(|OUTFITTINGDRAFT|)
  else
    !macfile.writeRecord(|DRAFT|)
  endif

  !elementName = !element.fullname
  if (!spldrg eq nulref) then
    !spldrgName = ''
  else
    !spldrgName = !spldrg.fullname
  endif

  --!macfile.writeRecord(|!!pipemakensbcdrwg('$!entryName','$!optionFilePath','$!unique')|)
  !macfile.writeRecord(|!!pipecreatetappingdrwg('$!elementName', '$!spldrgName')|)

  -- write to file to record run as complete
  !macfile.writeRecord(|!donefile = object FILE('%pdmsuser%\tappingdrwgdone.log')|)
  !macfile.writeRecord(|!donefile.open('OVER')|)
  !macfile.writeRecord(|!donefile.writeRecord('DONE')|)
  !macfile.writeRecord(|!donefile.close()|)

  -- write macro file
  !macfile.writeRecord(|FINISH|)
  !macfile.close()

  -- create batch file to batch run

  var !pdmsuser evar pdmsuser
  !pdmsuser = !pdmsuser.replace(';','')

  !batchFile = object FILE('$!pdmsuser\maketappingdrwg.bat')
  !batchFile.open('OVER')
  !batchFile.writeRecord(|setlocal|)
  !batchFile.writeRecord(|set savepath=%path%|)
  !batchFile.writeRecord(|set pdms_installed_dir=$!installenv|)
  !batchFile.writeRecord(|"%pdms_installed_dir%\MON"  tty -macro="$!pdmsuser/maketappingdrwg.mac"|)
  !batchFile.writeRecord(|endlocal|)
  !batchFile.writeRecord(|exit|)
  !batchFile.close()

  -- create tapping drawing using batchfile
  SYSCOM 'START /MIN cmd.exe /C "$!batchFile" &'

endfunction
-- End of function definition
