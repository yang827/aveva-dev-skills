--
--  File:            pipestarttappingdrwg.pmlfnc
--    Type:          Function Definition
--    Group:         Pipe
--      Keyword:     Pipe
--    Module:        draft
--  Author:          Michael Board
--  Created:
--
--  Description:     Start pipe tapping drawing
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
--    2   R      STRING      Option file path
--    3   R      STRING      Unique ID of calling process
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pipestarttappingdrwg(!element is DBREF) is ARRAY

  --function should return array of error messages
  --check if any PIPCA below passed element first

  !ref = !!ce

  !!ce = !element

  !errorArray = ARRAY()

  !pipes = ARRAY()

  var !type type

  if (!type eq 'SPLDRG') then
  	
    !pipcaColl = ARRAY()

    !spldrg = !!ce

    var !allSpools collect all spldrg members where (type eq 'SPOOL' or type eq 'FIELD') for ce

    do !i ind !allSpools
      !object = !allSpools[!i]
      $!object
      !spltbl = spltbl
      !n      = !spltbl.size()
      do !j from 1 to !n by 4
        !k = !j + 1
        !sref = '=' & $!spltbl[$!j] & '/' & $!spltbl[$!k]
        var !allPipcas coll all pipca for $!sref
        do !l ind !allPipcas
          !pipcaRef = !allPipcas[!l]
          !pipcaColl.append(!pipcaRef)
          $!pipcaRef
          !pipe = pipe
          !pipefound = false
          do !m ind !pipes
            if (!pipes[!m].eq(!pipe)) then
              !pipefound = true
              break
            endif
          enddo
          if (not !pipefound) then
            !pipes.append(!pipe)
          endif
        enddo
      enddo
    enddo

  else

    PIPE
    handle any
      return !errorArray
    endhandle

    !pipe = !!ce

    !spldrg = nulref

    var !pipcaColl coll all pipca for $!pipe

    !pipes.append(!pipe)

  endif

  !setPipcas = ARRAY()

  do !i values !pipcaColl
    !pipca = !i.dbref()
    if (!pipca.cref.eq(nulref)) then
        if (!pipca.own.typ.eq('PTAP') AND !pipca.own.cref.neq(nulref)) then
            !setPipcas.append(!i)
      endif
    else
        !setPipcas.append(!i)
    endif
  enddo

  if (!setPipcas.set()) then

    do !i ind !pipes

      !pipe = !pipes[!i]

      -- check if pipe is named - must be named to construct plot file name
      if (!pipe.isnamed.eq(FALSE)) then

        !errorArray.append('Error creating detailed plot file drawing for non-standard branch connection, pipe must be named')

        return !errorArray

      endif

    enddo

    savework
    !doneFile = object FILE('%pdmsuser%\tappingdrwgdone.log')
    !doneFile.open('OVER')
    !doneFile.writeRecord('IN-PROGRESS')
    !doneFile.close()

    do !i ind !pipes

      !!pipesetuptappingdrwg(!pipe, !spldrg)

    enddo

    do
      !doneFile.open('READ')
      !stop = !doneFile.readRecord()
      !doneFile.close()

      skip if (!stop.neq('DONE'))
      break

    enddo

    --now read log file for errors, return array of errors - this will be empty if no errors

    !elementName = !element.name.substring(2).replace('"','_').replace('\','_').replace('/','_').replace(':','_').replace('*','_').replace('?','_').replace('<','_').replace('>','_')
    !dwgName = '/' & !elementName & '_DETAIL'
    !errorLogFile = object FILE('%pdmsuser%/' & !dwgName & 'tappingdrwgerror.log')

    -- get errors

    if (!errorLogFile.exists()) then
      !errorArray = !errorLogFile.readFile()
    endif

  endif

  !!ce = !ref

  return !errorArray

endfunction
-- End of function definition for pipemakeunderlyingdrwg
