-- Define object
define object ISOCUTPIPEFMT

  member .keepCsvFile is BOOLEAN
  member .createReport is BOOLEAN
  member .createMacro is BOOLEAN
  member .fccsOn is BOOLEAN
  member .pagingOn is BOOLEAN
  member .pageLength is REAL
  member .pageText is STRING
  member .dateOn is BOOLEAN
  member .dateText is STRING
  member .headerText is STRING
  member .projectNumberOn is BOOLEAN
  member .pipeListOn is BOOLEAN
  member .pipeListText is STRING
  member .metricLengText is STRING
  member .metricBoreText is STRING
  member .imperialLengText is STRING
  member .imperialBoreText is STRING
  member .subTotalText is STRING
  member .columns is ARRAY

endobject
