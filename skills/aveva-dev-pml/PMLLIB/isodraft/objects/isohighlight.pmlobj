-- Created:         08 January 2002
--
--
-- Description:
-- Object to define
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  read(GADGET)                     -                   Read options
--  store(STRING)                    -                   Store certain form changes
--  write()                          -                   Write options
--
------------------------------------------------------------------------
-- Define object
define object ISOHIGHLIGHT

  member .form     is FORM
  member .modified is BOOLEAN

  member .mode     is BOOLEAN
  member .colour   is REAL
  member .rules    is ARRAY

endobject
-- End of object definition for ISOHIGHLIGHT

------------------------------------------------------------------------
--
-- Method: .store(STRING)
--
-- Description: Store certain form changes
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of member to store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!member is STRING)

  -- Save form settings
  if (!member.eq('MODE')) then

    !this.mode = !this.form.mode.val

  elseif (!member.eq('COLOUR')) then

    !this.colour = !!isoColours.colour

  endif

  -- Mark form as modified
  !this.modified = true

endmethod
-- End of method definition .store(STRING)

------------------------------------------------------------------------
--
-- Method: .read(GADGET)
--
-- Description: Read options
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget that holds the menu descriptions
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .read(!menuGadget is GADGET)

  -- Initialise variables
  !this.rules.clear()

  -- Read options
  VAR !mode CHANGE HIGHLIGHTING MODE
  VAR !colour CHANGE HIGHLIGHTING COLOUR
  !rules = HIGHLIGHTING RULES

  -- Mode
  if (!mode.upCase().match('ON').neq(0)) then
    !this.mode = true
  else
    !this.mode = false
  endif

  -- Colour
  !this.colour = !colour.real()
    handle any
      !this.colour = 2
    endhandle

  -- Rules
  if (!rules.empty().not()) then
    do !rule val !rules
      !this.rules.append(object ISORULE(!rule,!menuGadget))
    enddo
  endif

endmethod
-- End of method definition .read()

------------------------------------------------------------------------
--
-- Method: .write()
--
-- Description: Write options
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .write()

  -- Reset
  CHANGE HIGHLIGHTING CLEAR

  -- Set options
  -- Mode
  if (!this.mode) then
    CHANGE HIGHLIGHTING ON
--    write ''
--    write 'CHANGE HIGHLIGHTING ON'
  else
    CHANGE HIGHLIGHTING OFF
--    write 'CHANGE HIGHLIGHTING OFF'
  endif

  -- Colour
  CHANGE HIGHLIGHTING COLOUR $!<this.colour>
--  write 'CHANGE HIGHLIGHTING COLOUR $!<this.colour>'

  -- Set each rule
  do !index ind !this.rules

    -- Build rule string
    if (!this.rules[!index].withString.unset() or !this.rules[!index].withString.eq(||)) then
      !syntax = !this.rules[!index].forString
    else
      !syntax = !this.rules[!index].forString  & | WITH | &  !this.rules[!index].withString
    endif

    -- Action the rule
    CHANGE HIGHLIGHTING RULE $!syntax

    -- Testing
--    write 'CHANGE HIGHLIGHTING RULE $!syntax'

  enddo

  -- Save options
  $M "%PDMSUI%/ISO/GEN/USAVOPT"

  -- Set form as unmodified
  !this.modified = false

endmethod
-- End of method definition .write()
