--
--
-- Description:
-- Object to define
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoRule(STRING,GADGET)           -                   Construct to set the rule using the rule string
--
------------------------------------------------------------------------
-- Define object
define object ISORULE

  member .elements   is ARRAY
  member .menuText   is ARRAY
  member .forString  is STRING
  member .withString is STRING

endobject
-- End of object definition for ISORULE

------------------------------------------------------------------------
--
-- Method: .isoRule(STRING,GADGET)
--
-- Description: Construct to set the rule using the rule string
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The rule string
--    2   R      GADGET      Menu gadget that holds the menu options
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoRule(!string is STRING, !menuGadget is GADGET)

  -- Initialise variables
  !elements = ARRAY()
  !menus = ARRAY()

  -- Get the "for" and "with" syntax
  if (!string.match('WITH').neq(0)) then
    !with = !string.after('WITH').trim().subString(2).trim()
    !this.withString = !with.subString(1,!with.length() - 1).trim()
    !this.forString = !string.before(' WITH')
  else
    !this.forString = !string
  endif

  -- Search for the ALL word and strip out the element type but remove any brackets first
  !bitArray = !string.before('WITH').replace('(','').replace(')','').split()
  do !index ind !bitArray

    -- Get the elements
    if (!bitArray[!index].eq('ALL')) then

      -- Test for "ALL" on its own
      if (undefined(!bitArray[!index + 1])) then
        !elements.append(!bitArray[!index])
        !menus.append('All')
      else

        -- Test for >1 words after the "ALL" e.g. ALL BRANCH MEMBERS
        -- Taking care to test when the ")" does not exist
        if (defined(!bitArray[!index + 2])) then
          if (!bitArray[!index + 2].neq('ALL') and !bitArray[!index + 2].neq(')')) then
            !testString = !bitArray[!index + 1] & ' ' & !bitArray[!index + 2]
          else
            !testString = !bitArray[!index + 1]
          endif
        else
          !testString = !bitArray[!index + 1]
        endif

        -- Find matching menu description, allowing for user manually setting the rule incorrectly
        !location = !menuGadget.rtext.findFirst(!testString)
        if (!location.unset()) then

        else
          !menus.append(!menuGadget.dtext[!location])
          !elements.append(!testString)
        endif

      endif

    endif

  enddo

  -- Store the elements and menus
  !this.elements = !elements
  !this.menuText = !menus

endmethod
-- End of method definition .isoRule(STRING,GADGET)
