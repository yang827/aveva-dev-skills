ONERROR GOLABEL /ERROR0

-- Read the current units
!savedUnits = object COMUNITS(true)

-- Set the units to metric millimetres
UNITS mm BORE
UNITS mm DISTANCE

-- Create a document link world
NEW LINKWLD /IsometricADP_DocumentLinks
  handle (41,12)
    -- Name already used.
    DELETE LINKWLD

  elsehandle none
    NEW LNFOLD /IsometricADP_LinkFolder
    FUNC 'Isometric ADP'

    END
    END

  endhandle

-- Build test new grid system
NEW GRIDWLD /IsometricADP_Grids DESC 'Isometric ADP Example Grid'

 NEW GRIDSYSTEM /IsometricADP_Grids/1  PURP AXIS  DESC 'ISOADP'

  NEW GRIDAXIS /IsometricADP_GridX  GRDAXE 'X'

   NEW GRIDLN /IsometricADP_GridX1  GRDOFF 0     GRDID '1'
   NEW GRIDLN /IsometricADP_GridX2  GRDOFF 5000  GRDID '2'
   NEW GRIDLN /IsometricADP_GridX3  GRDOFF 10000 GRDID '3'
   NEW GRIDLN /IsometricADP_GridX4  GRDOFF 15000 GRDID '4'
   NEW GRIDLN /IsometricADP_GridX5  GRDOFF 20000 GRDID '5'
   NEW GRIDLN /IsometricADP_GridX6  GRDOFF 25000 GRDID '6'
   NEW GRIDLN /IsometricADP_GridX7  GRDOFF 30000 GRDID '7'
   NEW GRIDLN /IsometricADP_GridX8  GRDOFF 35000 GRDID '8'
   NEW GRIDLN /IsometricADP_GridX9  GRDOFF 40000 GRDID '9'
   NEW GRIDLN /IsometricADP_GridX10 GRDOFF 45000 GRDID '10'

  NEW GRIDAXIS /IsometricADP_GridY GRDAXE 'Y'

   NEW GRIDLN /IsometricADP_GridYA GRDOFF 0     GRDID 'A'
   NEW GRIDLN /IsometricADP_GridYB GRDOFF 5000  GRDID 'B'
   NEW GRIDLN /IsometricADP_GridYC GRDOFF 10000 GRDID 'C'
   NEW GRIDLN /IsometricADP_GridYD GRDOFF 15000 GRDID 'D'
   NEW GRIDLN /IsometricADP_GridYE GRDOFF 20000 GRDID 'E'
   NEW GRIDLN /IsometricADP_GridYF GRDOFF 25000 GRDID 'F'
   NEW GRIDLN /IsometricADP_GridYG GRDOFF 30000 GRDID 'G'
   NEW GRIDLN /IsometricADP_GridYH GRDOFF 35000 GRDID 'H'
   NEW GRIDLN /IsometricADP_GridYI GRDOFF 40000 GRDID 'I'
   NEW GRIDLN /IsometricADP_GridYJ GRDOFF 45000 GRDID 'J'

  NEW GRIDAXIS /IsometricADP_GridEL. GRDAXE 'Z' GRDLBL 'EL.'

   NEW GRIDLN /IsometricADP_GridEL.0 GRDOFF 0     GRDID '0'
   NEW GRIDLN /IsometricADP_GridEL.1 GRDOFF 4000  GRDID '1'
   NEW GRIDLN /IsometricADP_GridEL.2 GRDOFF 8000  GRDID '2'
   NEW GRIDLN /IsometricADP_GridEL.3 GRDOFF 12000 GRDID '3'
   NEW GRIDLN /IsometricADP_GridEL.4 GRDOFF 16000 GRDID '4'
   NEW GRIDLN /IsometricADP_GridEL.5 GRDOFF 20000 GRDID '5'

-- Build test HVAC site
NEW SITE /HVACISOADP

NEW ZONE /HVACISOADPZONE
PURP HVAC

NEW HVAC /HTESTHVAC
BUIL false
SHOP false
PRES 0
PSPE /CADCHVACSPEC
ISPE /CADCHVACISPEC
CCEN 0
CCLA 0
LNTP unset
DUTY unset
DSCO 'TUTORIAL'
PTSP unset
INSC unset
DELDSG FALS

NEW BRANCH /HTESTB1
BUIL false
SHOP false
HPOS E 3048 S 5125 U 3300
TPOS E 18040 N 5199.999511 U 3150
HDIR N
TDIR W
LHEA true
LTAI true
HBOR 1500
TBOR 1300
HCON RECT
TCON RECT
LNTP unset
HSTU /CADCHVACSPEC/HRTUBEA
CCEN 0
CCLA 0
PSPE /CADCHVACSPEC
ISPE /CADCHVACISPEC
DUTY unset
DSCO 'TUTORIAL'
PTSP unset
INSC unset
DELDSG FALS
:HXYsize 1000 500

