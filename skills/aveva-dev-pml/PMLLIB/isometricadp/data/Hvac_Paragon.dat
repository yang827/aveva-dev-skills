    NEW DATA /CADCHVACMTO/CCONIC_XSECSAINP    DESC 'Brco diameter'       DKEY c DTIT 'ø' PPRO (DDESP[41])
    NEW DATA /CADCHVACMTO/CCONIC_ANGLINP      DESC 'Angle of sides'      DKEY d DTIT '°' PPRO (DESP[8])
    NEW DATA /CADCHVACMTO/CCONIC_BRLEINP      DESC 'Brco length'         DKEY e DTIT '' PPRO (DDESP[7])
    NEW DATA /CADCHVACMTO/CCONIC_AOFFSETINP   DESC 'Distance from leave' DKEY f DTIT '' PPRO (DDESP[10] - (DDESP[41] / 2) - ((DDESP[7] ) * TAN (DESP[8])))
    NEW DATA /CADCHVACMTO/CCONIC_BOFFSETINP   DESC 'B offset'            DKEY g DTIT '' PPRO (DDESP[11])
    NEW DATA /CADCHVACMTO/CCONIC_BREXTINP     DESC 'Brco extension'      DKEY h DTIT '' PPRO (DDESP[19])
    NEW DATA /CADCHVACMTO/CCONIC_BRJNTINP     DESC 'Brco joint & size'          DTIT '' PPRO (WDESP[60] + (STR(DESP[70])))
    NEW DATA /CADCHVACMTO/CCONIC_FIXJTINP     DESC 'Fixing to duct'             DTIT '' PPRO (WDESP[64] + (STR(DESP[65])))
  endhandle

