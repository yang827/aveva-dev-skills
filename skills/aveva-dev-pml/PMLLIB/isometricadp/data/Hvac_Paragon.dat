-- ISOMETRIC ADP
-- DATA SETS TO PROVIDE REFERENCE BETWEEN THE HVAC & CATALOGUE
-- -------------------------------------------------------------------------
-- Parametric Information on each item
-- ===================================

-- Item Number       DESP[31] (if this eq 0 then probably want name)
-- Type of component TYPE
-- Identifier        CATREF
-- Specification     DSCODE of BRAN
-- Description       SPLT

-- Specific Values for each type in alphabetical order
-- ===================================================

-- Example would be 1,BEND,/C3SEGB,Norsok2,300,90,150,50,50,FJ50,FJ50
-- -------------------------------------------------------------------------

CATA /CADCHVACDFLTS

NEW SECT /CADCHVACMTO PURP HMTO
  handle any
    DELETE SECT
    SECT /CADCHVACMTO
  endhandle

-- BRCO --------------------------------------------------------------------

NEW CATE /CADCHVACMTO-BRCO PURP BRCO
  handle any
    DELETE CATE
    CATE /CADCHVACMTO-BRCO
  endhandle

NEW DTSE /CADCHVACMTO/CANGBRCO FUNC 'CANGBRCO'
  handle any
    DELETE DTSE
  elsehandle none
    NEW DATA /CADCHVACMTO/CANGBRCO_XSECLAINP  DESC 'Main width LA'       DKEY a DTIT 'ø'  PPRO (DDESP[4])
    NEW DATA /CADCHVACMTO/CANGBRCO_XSECLBINP  DESC 'Main depth LB'       DKEY b DTIT 'ø'  PPRO (DDESP[5])
    NEW DATA /CADCHVACMTO/CANGBRCO_XSECSAINP  DESC 'Brco diameter'       DKEY c DTIT 'ø'  PPRO (DDESP[41])
    NEW DATA /CADCHVACMTO/CANGBRCO_BRLEINP    DESC 'Brco length'         DKEY d DTIT ''   PPRO (DDESP[7])
    NEW DATA /CADCHVACMTO/CANGBRCO_ANGLEINP   DESC 'Angle to main'       DKEY e DTIT '°'  PPRO (DESP[8])
    NEW DATA /CADCHVACMTO/CANGBRCO_AOFFSETINP DESC 'Distance from leave' DKEY f DTIT ''   PPRO (DDESP[10])
    NEW DATA /CADCHVACMTO/CANGBRCO_BOFFSETINP DESC 'B offset'            DKEY g DTIT ''   PPRO (DDESP[11])
    NEW DATA /CADCHVACMTO/CANGBRCO_BREXTINP   DESC 'Brco extension'      DKEY h DTIT ''   PPRO (DDESP[19])
    NEW DATA /CADCHVACMTO/CANGBRCO_BRJNTINP   DESC 'Brco joint & size'          DTIT ''   PPRO (WDESP[60] + (STR(DESP[70])))
    NEW DATA /CADCHVACMTO/CANGBRCO_FIXJTINP   DESC 'Fixing to duct'             DTIT ''   PPRO (WDESP[64] + (STR(DESP[65])))
  endhandle

NEW DTSE /CADCHVACMTO/CBOOT FUNC 'CBOOT'
  handle any
    DELETE DTSE
  elsehandle none
    NEW DATA /CADCHVACMTO/CBOOT_XSECLAINP    DESC 'Main width LA'       DKEY a DTIT 'ø' PPRO (DDESP[4])
    NEW DATA /CADCHVACMTO/CBOOT_XSECLBINP    DESC 'Main depth LB'       DKEY b DTIT 'ø' PPRO (DDESP[5])
    NEW DATA /CADCHVACMTO/CBOOT_XSECSAINP    DESC 'Boot diameter'       DKEY c DTIT 'ø' PPRO (DDESP[41])
    NEW DATA /CADCHVACMTO/CBOOT_BRLEINP      DESC 'Boot length'         DKEY d DTIT '' PPRO (DDESP[7])
    NEW DATA /CADCHVACMTO/CBOOT_AOFFSETINP   DESC 'Distance from leave' DKEY e DTIT '' PPRO (DDESP[10] - (DDESP[41] / 2))
    NEW DATA /CADCHVACMTO/CBOOT_BOFFSETINP   DESC 'B offset'            DKEY f DTIT '' PPRO (DDESP[11])
    NEW DATA /CADCHVACMTO/CBOOT_BREXTINP     DESC 'Boot extension'      DKEY g DTIT '' PPRO (DDESP[19])
    NEW DATA /CADCHVACMTO/CBOOT_BRJNTINP     DESC 'Boot joint & size'          DTIT '' PPRO (WDESP[60] + (STR(DESP[70])))
    NEW DATA /CADCHVACMTO/CBOOT_FIXJTINP     DESC 'Fixing to duct'             DTIT '' PPRO (WDESP[64] + (STR(DESP[65])))
  endhandle

NEW DTSE /CADCHVACMTO/CCONIC FUNC 'CCONIC'
  handle any
    DELETE DTSE
  elsehandle none
    NEW DATA /CADCHVACMTO/CCONIC_XSECLAINP    DESC 'Main width LA'       DKEY a DTIT 'ø' PPRO (DDESP[4])
