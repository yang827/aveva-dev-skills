-- Argument 3 - $3$N or null
INPUT BEGIN
NEW DEPT /$3$NIsometric_ADP/Department
SIZE 46.811024in 33.110236in
UCOD mm  Distance  mm  Bore Nominal
FONT $1
DTER Arrows
LTER Off
BSDWG unset
BSLAYE 'Border'
ACDSTY unset
PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
NTEXT '---'
TXCOLO 1
NLSTYL Solid
NLCOLO 1
LLSTYL Solid
LLCOLO 1
LFSTYL Solid
LFCOLO 1
DLSTYL Solid
DLCOLO 1
PLSTYL Solid
PLCOLO 1
FSTYLE Off
FCOLOUR 1
POSFOR $2

NEW LIBY /$3$NIsometric_ADP/StandardLibrary
SIZE 46.811024in 33.110236in
UCOD mm  Distance  mm  Bore Nominal
FONT $1
DTER Arrows
LTER Off
BSDWG unset
BSLAYE 'Border'
ACDSTY unset
PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
NTEXT '---'
TXCOLO 1
NLSTYL Solid
NLCOLO 1
LLSTYL Solid
LLCOLO 1
LFSTYL Solid
LFCOLO 1
DLSTYL Solid
DLCOLO 1
PLSTYL Solid
PLCOLO 1
FSTYLE Off
FCOLOUR 1
POSFOR $2
SPPURP ISOADP
FUNC 'Isometrics ADP with CWAY'

NEW SHLB /$3$NIsometric_ADP/Back-&-Over
