UDNA 'IdpDtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Etex
UDNA 'IdpEtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Ftex
UDNA 'IdpFtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Gtex
UDNA 'IdpGtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Htex
UDNA 'IdpHtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Itex
UDNA 'IdpItex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Jtex
UDNA 'IdpJtex'
