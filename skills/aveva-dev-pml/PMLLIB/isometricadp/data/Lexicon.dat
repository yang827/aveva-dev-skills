ONERROR CONTINUE

NEW UWRLD /Isometric_ADP/Uwrl

NEW UGROUP /Isometric_ADP/Drwg

NEW UDA /Isometric_ADP/AreaCode
DESC 'Area Code from the SITE'
UDNA 'IdpAreaCode'
ABLE 5
UTYP TEXT
ULEN 12
RPTX 'Area'
ELEL ADD DRWG
DFLT '-'

END
NEW UDA /Isometric_ADP/LineNumber
DESC 'Line Number'
UDNA 'IdpLineNo'
ABLE 5
UTYP TEXT
ULEN 120
RPTX 'Line Number'
ELEL ADD DRWG
DFLT '-'

END
END
NEW UGROUP /Isometric_ADP/Shee

NEW UDA /Isometric_ADP/Shee/SheetNo
DESC 'Sheet Number'
UDNA 'IdpSheetNo'
ABLE 6
UTYP REAL
ULEN 3
RPTX ' Sheet No'
ELEL ADD SHEE

END
NEW UDA /Isometric_ADP/Shee/NumberOff
DESC 'Number of Sheets'
UDNA 'IdpNumberOff'
ABLE 7
UTYP REAL
ULEN 3
RPTX 'No of Sheets'
ELEL ADD SHEE

END
NEW UDA /Isometric_ADP/Shee/RevisionRef
DESC 'Reference to the latest revision'
UDNA 'IdpReviRef'
ABLE 10
UTYP REF
RPTX 'Latest Revision'
ELEL ADD SHEE

END
NEW UDA /Isometric_ADP/Shee/IsoStatus
DESC 'Iso Status'
UDNA 'IdpIsoStatus'
ABLE 6
UTYP TEXT
ULEN 24
RPTX 'Iso Status'
ELEL ADD SHEE RRUL

END
NEW UDA /Isometric_ADP/Shee/Spec
DESC 'Specification'
UDNA 'IdpSpec'
ABLE 4
UTYP TEXT
ULEN 120
RPTX 'Specification'
ELEL ADD SHEE
DFLT 'Unset'

END
NEW UDA /Isometric_ADP/Shee/TotalWeight
DESC 'Total Weight'
UDNA 'IdpTotWeight'
ABLE 6
UTYP TEXT
ULEN 24
RPTX 'Total Weight'
ELEL ADD SHEE

END
NEW UDA /Isometric_ADP/Shee/CoG
DESC 'Centre of Gravity'
UDNA 'IdpCofG'
ABLE 4
UTYP TEXT
ULEN 120
RPTX 'C of G'
ELEL ADD SHEE

END
END
NEW UGROUP /Isometric_ADP/Revi

NEW UDA /Isometric_ADP/Revi/Checked
DESC 'Who checked the Drawing'
UDNA 'IdpCheckedBy'
ABLE 10
UTYP TEXT
ULEN 24
RPTX 'Checked By'
ELEL ADD REVI
DFLT ' '

END
NEW UDA /Isometric_ADP/Revi/description
DESC 'Reason for Revision'
UDNA 'IdpDesc'
ABLE 7
UTYP TEXT
ULEN 120
RPTX 'Description'
ELEL ADD REVI SYTM LAYE
DFLT ' '

END
NEW UDA /Isometric_ADP/Approved2
DESC 'Approver 2'
UDNA 'IdpApprover2'
ABLE 9
UTYP TEXT
ULEN 25
RPTX 'Approver 2'
ELEL ADD REVI
DFLT ' '

END
NEW UDA /Isometric_ADP/Approved3
DESC 'Approver 3'
UDNA 'IdpApprover3'
ABLE 9
UTYP TEXT
ULEN 25
RPTX 'Approver 3'
ELEL ADD REVI
DFLT ' '

END
NEW UDA /Isometric_ADP/IntExt
DESC ' Internal or External revision'
UDNA 'IdpIntExt'
ABLE 6
UTYP WORD
ULEN 3
RPTX 'Revision Type'
ELEL ADD REVI
DFLT INT

END
END
NEW UGROUP /Isometric_ADP/Slab

NEW UDA /Isometric_ADP/Slab/Btex
UDNA 'IdpBtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
NEW UDA /Isometric_ADP/Slab/Ctex
UDNA 'IdpCtex'
ABLE 4
UTYP TEXT
ULEN 24
ELEL ADD SLAB

END
