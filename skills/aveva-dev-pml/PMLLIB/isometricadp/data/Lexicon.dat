NEW UGROUP /Isometric_ADP/Sytm

NEW UDA /Isometric_ADP/Column
DESC 'Column Number'
UDNA 'IdpColumn'
ABLE 6
UTYP REAL
RPTX 'Column Number'
ELEL ADD SYTM
DFLT 0

END
NEW UDA /Isometric_ADP/Function
DESC 'PML Function called'
UDNA 'IdpFunc'
ABLE 4
UTYP TEXT
ULEN 100
RPTX 'PML Function'
ELEL ADD SYTM RECT

END
NEW UDA /Isometric_ADP/Purpose
DESC 'Purpose used for'
UDNA 'IdpPurp'
ABLE 4
UTYP TEXT
ULEN 24
RPTX 'Purpose used for'
ELEL ADD SYTM

END
NEW UDA /Isometric_ADP/Unique
DESC 'Sort Unique'
UDNA 'IdpSort'
ABLE 4
UTYP LOG
RPTX 'Sort Unique'
ELEL ADD SYTM
DFLT FALSE

END
NEW UDA /Isometric_ADP/Check
DESC 'Check for too long'
UDNA 'IdpCheck'
ABLE 8
UTYP LOG
RPTX 'Length Check'
ELEL ADD SYTM
DFLT FALSE

END
NEW UDA /Isometric_ADP/End
DESC 'End position from row start'
UDNA 'IdpEnd'
UTYP REAL
RPTX 'End position'
ELEL ADD SYTM
UUNITS DIST

END
END
NEW UGROUP /Isometric_ADP/Lalb

NEW UDA /Isometric_ADP/Movement
DESC 'Mto Table entry move'
UDNA 'IdpMove'
ABLE 4
UTYP REAL
RPTX 'Mto Table entry move'
ELEL ADD LALB
UUNITS DIST

END
NEW UDA /Isometric_ADP/Direction
DESC 'Mto Table entry direction'
UDNA 'IdpDire'
ABLE 4
UTYP TEXT
ULEN 3
RPTX 'Mto table direction'
ELEL ADD LALB

END
END
NEW UGROUP /Isometric_ADP/Stra

NEW UDA /Isometric_ADP/Side
DESC 'Side'
UDNA 'IdpSide'
ABLE 4
UTYP WORD
RPTX 'Side'
ELEL ADD STRA

END
END
END
