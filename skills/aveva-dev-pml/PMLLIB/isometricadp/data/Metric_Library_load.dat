-- Argument 1 = FONT number
-- Argument 2 = Coordinates XYZ or ENU
-- Argument 3 - $3$N or null
INPUT BEGIN
NEW DEPT /$3$NIsometric_ADP/Department
SIZE 1189mm 841mm
UCOD mm  Distance  mm  Bore Nominal
FONT $1
DTER Arrows
LTER Off
BSDWG unset
BSLAYE 'Border'
ACDSTY unset
PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
NTEXT '---'
TXCOLO 1
NLSTYL Solid
NLCOLO 1
LLSTYL Solid
LLCOLO 1
LFSTYL Solid
LFCOLO 1
DLSTYL Solid
DLCOLO 1
PLSTYL Solid
PLCOLO 1
FSTYLE Off
FCOLOUR 1
POSFOR $2

NEW LIBY /$3$NIsometric_ADP/StandardLibrary
SIZE 1189mm 841mm
UCOD mm  Distance  mm  Bore Nominal
FONT $1
DTER Arrows
LTER Off
BSDWG unset
BSLAYE 'Border'
ACDSTY unset
PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
NTEXT '---'
TXCOLO 1
NLSTYL Solid
NLCOLO 1
LLSTYL Solid
LLCOLO 1
LFSTYL Solid
LFCOLO 1
DLSTYL Solid
DLCOLO 1
PLSTYL Solid
PLCOLO 1
FSTYLE Off
FCOLOUR 1
POSFOR $2
SPPURP ISOADP
FUNC 'Isometrics ADP with CWAY'

NEW SHLB /$3$NIsometric_ADP/Back-&-Over
SIZE 1189mm 841mm
FONT $1
UCOD mm  Distance  mm  Bore Nominal
DTER Arrows
LTER Off
PCODE mms to 0 dpls  Inches to 1 dpls  Fractions to 32 ths  Angles to 1 dpls
NTEXT '---'
ACDSTY unset
TXCOLO 1
NLSTYL Solid
NLCOLO 1
LLSTYL Solid
LLCOLO 1
LFSTYL Solid
LFCOLO 1
DLSTYL Solid
DLCOLO 1
PLSTYL Solid
PLCOLO 1
FSTYLE Off
FCOLOUR 1
POSFOR $2

NEW BACKINGSHEET /$3$NIsometric-A3
SIZE 420mm 297mm
FONT $1
TXCOLO 1
NLSTYL Solid
NLCOLO 1
FSTYLE Off
FCOLOUR 1
ACDSTY unset

NEW NOTE /$3$NIsometric-A3/ReservedAreas
XYPS X 0mm Y 0mm
LVIS false
JUST Left
ALIGN Bbody
FONT $1
CHEI 4mm
CSPA 0
LSPA 0
BLNK true
BMAR 0mm
TXCOLO 1
NLSTYL Solid
NLCOLO 1
FSTYLE Off
FCOLOUR 1
MSTYLE Stop Scale 1
MCOLOUR 1
ACDSTY unset
SPPURP TABLE

NEW RECTANGLE /$3$NIsometric-A3/ViewArea
Origin Centre Offset X 145mm Y 169.5mm
XLEN 270mm
YLEN 245mm
NLSTYL Solid
NLCOLO 2
FSTYLE SystemStyle 1
FCOLOUR 2
:IdpFunc 'View'

END
