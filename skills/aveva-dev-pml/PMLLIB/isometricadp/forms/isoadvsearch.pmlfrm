--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         22 July 2008
--
--
-- Description:
-- The form used to search for elements using various filters
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  find()                           -                   Find the pipes that match the criteria
--  init()                           -                   Method to initialise the form
--  isoAdvSearch()                   -                   Constructor method
--  setAttrib()                      -                   Display the system or user defined attributes
--
------------------------------------------------------------------------
setup form !!isoAdvSearch dialog

  -- Form members
  !this.formtitle = 'Advanced Search'
  !this.callback  = '!this.init()'

  frame .frScope 'Scope' at x0 y0 width 61

    rtoggle .mdb 'Search the whole Mdb'             tagwidth 18 at x6   ymin+0.6
    rtoggle .ce  'Search below the Current Element' tagwidth 25 at xmax ymin

  exit

  frame .all 'Find elements that have...' at x0 ymax width 61

    para    .expr       at x1 ymax text 'The expression:'
    text    .expression at xmax ymin width 43 STRING

    para    .andOne at x2 ymax-0.2 text 'and'

    para    .words      at x1 ymax-0.2 text 'Name with all of these words:'
    text    .nameString at xmax-8 ymin width 37 STRING

    para    .andTwo at x2 ymax-0.2 text 'and'

    para    .attr      at x1 ymax-0.2 text 'Attribute:'
    option  .attribute at xmax ymin  width 20

    para    .eq    at xmax+0.7 ymin text 'that matches'
    text    .value at xmax-3 ymin width 15 STRING

    button  .search 'Search' at xmax-8 ymax+0.5

    rtoggle .system 'System' tagwidth 6 at xmin.attribute+3 ymax.attribute+0.2
    rtoggle .udas   'Udas'              at xmax ymin

  exit

  member .sysAtts  is ARRAY
  member .udaAtts  is ARRAY
  member .type     is STRING

exit

------------------------------------------------------------------------
--
-- Method:      .isoAdvSearch()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoAdvSearch()

  -- Form callbacks
  !this.search.callback = |!this.find()|
  !this.system.callback = |!this.setAttrib()|
  !this.udas.callback   = |!this.setAttrib()|

  -- Set default as HVAC
  !this.type = 'HVAC'

  -- Set search point at MDB
  !this.mdb.val = true

endmethod
-- End of method definition for .isoAdvSearch()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !type = !this.type
  !this.sysAtts.clear()
  !this.udaAtts.clear()

  -- Get attributes for element
  VAR !allElements COLL ALL $!type

  -- Get element attributes
  !allAtts = !allElements[1].dbref().attlist

  -- Separate into system and user-defined
  do !attrib val !allAtts

    skip if (!attrib.eq('NAME'))

    if (!attrib.substring(1,1).eq(':')) then
      !this.udaAtts.append(!attrib)

    else
      !this.sysAtts.append(!attrib)

    endif

  enddo

  -- Populate the attribute option gadget
  !this.attribute.dtext = !this.sysAtts

  -- Set the default attribute TYPE as the chosen element
  if (!this.attribute.selection().eq('TYPE')) then
    !this.value.val = !type
  endif

  -- Clear the name gadget
  !this.nameString.val = ''

  -- Set the default displayed attributes as system ones
  !this.system.val = true

  -- Determine default selection rule
  -- Cable Tray
  if (!type.eq('CWAY')) then

    !this.expression.val = !!isoMain.isoAdpApp.data.elecRule
    !this.formtitle = 'Advanced Search for Cable Tray'

  -- Assemblies which contain HSPOOL elements
  elseif (!type.eq('ASMBLY')) then

    !this.expression.val = !!isoMain.isoAdpApp.data.hvacAssyRule
    !this.formtitle = 'Advanced Search for HVAC Spool Assemblies'

  -- Otherwise use HVAC
  else

    !this.expression.val = !!isoMain.isoAdpApp.data.hvacRule
    !this.formtitle = 'Advanced Search for Ducting'

  endif


endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .find()
--
-- Description: Find the pipes that match the criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .find()

  -- Initialise variables
  !expression  = !this.expression.val
  !nameString  = !this.nameString.val
  !attribute   = !this.attribute.selection()
  !attrValue   = !this.value.val
  !type        = !this.type
  !allElements = ARRAY()

  -- Set scope
  if (!this.mdb.val) then
    !scope = ''

  else
    !scope = 'FOR CE'

  endif

  -- Test attribute value for real
  !unusedReal = !attrValue.real()
    handle(2,441)
      -- Unable to convert string to a number

      -- Test attribute for boolean
      if (!attrValue.upcase().neq('TRUE') and !attrValue.upcase().neq('FALSE')) then
       !attrValue = '|' & !attrValue & '|'

      endif

    endhandle

  -- For no expression
  if (!expression.eq('')) then

    -- For no name string
    if (!nameString.eq('')) then

      -- Include attribute value
      if (!attrValue.neq('')) then
        VAR !allElements COLL ALL $!type WI $!attribute EQ $!attrValue $!scope
      endif

    -- Include name string
    else

      -- Get the name words
      !allWords = !nameString.split(' ')

      -- For no attribute value
      if (!attrValue.eq('')) then
        VAR !allElements COLL ALL $!type WI MATCHWILD (NAME, |*$!allWords[1]*|) $!scope

      -- Include attribute value
      else
        VAR !allElements COLL ALL $!type WI MATCHWILD (NAME, |*$!allWords[1]*|) AND $!attribute EQ $!attrValue $!scope

      endif

      -- For each word
      do !count from 2 to !allWords.size()

        !word   = !allWords[!count]
        !remove = ARRAY()

        -- Test each name if it contains this word, if not remove it from the array
        do !index ind !allElements

          if (!allElements[!index].dbref().name.matchwild('*' & !word & '*').not()) then

            !remove.append(!index)

          endif

        enddo

        -- Remove the unwanted elements
        do !indexNo val !remove
          !allElements.deleteFrom(!indexNo,1)
        enddo

        !allElements.compress()

      enddo

    endif

  -- Include expression
  else

    -- For no name string
    if (!nameString.eq('')) then

      if (!attrValue.neq('')) then
        VAR !allElements COLL ALL $!type WI $!attribute EQ $!attrValue AND $!expression $!scope
      endif

    else

      -- Get the name words
      !allWords = !nameString.split(' ')

      -- For no attribute value
      if (!attrValue.eq('')) then
        VAR !allElements COLL ALL $!type WI MATCHWILD (NAME, |*$!allWords[1]*|) AND $!expression $!scope

      -- Include attribute value
      else
        VAR !allElements COLL ALL $!type WI MATCHWILD (NAME, |*$!allWords[1]*|) AND $!attribute EQ $!attrValue AND $!expression $!scope

      endif

      -- For each word
      do !count from 2 to !allWords.size()

        !word   = !allWords[!count]
        !remove = ARRAY()

        -- Test each name if it contains this word, if not remove it from the array
        do !index ind !allElements

          if (!allElements[!index].dbref().name.matchwild('*' & !word & '*').not()) then

            !remove.append(!index)

          endif

        enddo

        -- Remove the unwanted elements
        do !indexNo val !remove
          !allElements.deleteFrom(!indexNo,1)
        enddo

        !allElements.compress()

      enddo

    endif

  endif

  -- Return to found pipes to the status form
  if (!allElements.empty()) then
    !!alert.message('Unfortunately, no elements were found.')

  else

    -- Add to detail list
    !!isoMain.include(!allElements)

  endif

  -- Check that we are still looking at the design database
  VAR !ddl DDL
  if (match('$!ddl', 'PADD') gt 0)then
    SWITCH
  endif

endmethod
-- End of method .find()

-----------------------------------------------------------------------
--
-- Method:      .setAttrib()
--
-- Description: Display the system or user defined attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAttrib()

  if (!this.system.val) then
    !this.attribute.dtext = !this.sysAtts
  else
    !this.attribute.dtext = !this.udaAtts
  endif

endmethod
-- End of method .setAttrib()
