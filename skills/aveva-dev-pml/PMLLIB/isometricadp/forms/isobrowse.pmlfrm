--
-- File:            isobrowse.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Browse the Operating System for files or browse databases
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Use the selected directory/element
--  cancel()                         -                   Closes this form
--  getElements(STRING)              -                   Get db elements
--  getFiles(FILE)                   -                   Get directory files
--  init()                           -                   Method to initialise the form
--  isoBrowse()                      -                   Construct
--  look()                           -                   Test for operating system or db's
--  upDir(FILE)                      -                   Read owning directory
--  use(FILE)                        -                   Pass the selected directory/element to the calling form
--
------------------------------------------------------------------------
setup form !!isoBrowse

  !this.formTitle  = 'Browse'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  option .lookIn |Look in | tagwidth 6 at x0.2 y0.3 call |!this.look()| width 25
  button .upDir at xmax+1.5 ymin+0.1 pixmap height 16 width 16 call |!this.upDir(object file(!this.lookIn.selection()))|

  list .list at xmin.lookIn ymax+0.5 single width 38 length 10

  button .use   | Use | at xmin ymax+0.2 call |!this.action()|
  button .cancel |Cancel| at xmax form-size ymin call |!this.cancel()|

  member .what   is STRING
  member .gadget is GADGET
  member .store  is BOOLEAN

exit
-- End of form definition for !!isoBrowse

------------------------------------------------------------------------
--
-- Method:        .isoBrowse()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoBrowse()

  -- Pixmaps
  !this.upDir.addPixmap(!!PML.getPathName('up_level.png'))

  !this.store = false

endmethod
-- End of method definition for .isoBrowse()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Get files/elements
  if (!this.what.eq('OS')) then

    -- Set up dir active
    !this.upDir.visible = true

     !start = object FILE(!!isoPrint.directory.val)
     if !start.exists().not() then
       -- Start with pdmsuser
       !start = object FILE('%PDMSUSER%')
     endif
    !this.getFiles(!start)

  else

    -- Set up dir invisible
    !this.upDir.visible = false

    -- Get all draft db's open in RW
    !draftDbs = !!isoRwDbs()

    -- Populate gadgets
    !this.lookIn.dtext = !draftDbs
    !this.lookIn.rtext = !draftDbs

    -- Get elements of type
    !this.getElements(!this.what)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .action()
--
-- Description: Use the selected directory/element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .action()

  -- Test for o/s or dbs
  if (!this.what.eq('OS')) then

    -- Use the current selected directory
    !this.use(object FILE(!this.lookIn.selection()))

  else

    -- Set passed gadget to the selected value
    !this.gadget.val = !this.list.selection()

    -- Set gadget form as modified
    !form = !this.gadget.owner()
    !form.modified = true

    -- Make a calling form store call
    if (!this.store) then
      !form.store()
    endif

    -- Hide this form
    hide !!isoBrowse

  endif

endmethod
-- End of method definition for .action()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Closes this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .cancel()

  -- Hide this form
  hide !!isoBrowse

endmethod
-- End of method definition for .cancel()

-----------------------------------------------------------------------
--
-- Method:      .getElements(STRING)
--
-- Description: Get db elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The type of the element being searched for
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .getElements(!dummyType is STRING)

  -- Initialise variables
  !worldRefe   = /*
  !allElements = ARRAY()

  do !elemRefe values !worldRefe.mem

    if (!elemRefe.dbname.eq(!this.lookIn.selection())) then

      VAR !allElements APPEND EVAL NAME FOR ALL $!<this.what> FOR $!elemRefe

    endif

  enddo

  -- Populate list gadget
  !this.list.dtext = !allElements.sort()

  -- set active status of "Use' button
  !this.use.active = !this.list.dtext.set()

endmethod
-- End of method definition for .getElements(STRING)

-----------------------------------------------------------------------
--
-- Method:      .getFiles(FILE)
--
-- Description: Get directory files
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .getFiles(!fileObj is FILE)

  -- Initialise variables
  !dispNames = ARRAY()
  !direNames = ARRAY()
  !fileNames = ARRAY()
  !this.lookIn.clear()

  -- Get current directory
  !dispNames.append(!fileObj.fullName())
  !direNames.append(!fileObj.fullName())

  -- Get sub directories
  do !entry val !fileObj.subDirs()
    if (!fileObj.fullName().eq('C:\')) then
      !dispNames.append('  |_' & after(!entry.fullName(),!fileObj.fullName()))
    else
      !dispNames.append('  |_' & after(!entry.fullName(),!fileObj.fullName() & '\'))
    endif
    !direNames.append(!entry.fullName())
  enddo
  !this.lookIn.dtext = !dispNames
  !this.lookIn.rtext = !direNames

  -- Get files
  do !entry val !fileObj.files()
    if (!fileObj.fullName().eq('C:\')) then
      !fileNames.append(after(!entry.fullName(),!fileObj.fullName()))
    else
      !fileNames.append(after(!entry.fullName(),!fileObj.fullName() & '\'))
    endif
  enddo
  !this.list.dtext = !fileNames
  !this.list.rtext = !fileNames

  -- Select the current directory
  !this.lookIn.select('DTEXT',!fileObj.fullName())

endmethod
-- End of method definition for .getFiles(FILE)

-----------------------------------------------------------------------
--
-- Method:      .look()
--
-- Description: Test for operating system or db's
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .look()

  -- Test for o/s or dbs
  if (!this.what.eq('OS')) then
    !this.getFiles(object file(!this.lookIn.selection()))
  else
    !this.getElements(!this.what)
  endif

endmethod
-- End of method definition for .look()

-----------------------------------------------------------------------
--
-- Method:      .upDir(FILE)
--
-- Description: Read owning directory
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDir(!fileObj is FILE)

  -- Get sub directories and files for the owner
  !this.getFiles(!fileObj.directory())

endmethod
-- End of method definition for .upDir(FILE)

-----------------------------------------------------------------------
--
-- Method:      .use(FILE)
--
-- Description: Pass the selected directory/element to the calling form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .use(!fileObj is FILE)

  -- Pass this directory to the calling form
  !!isoPrint.fileOpt.val      = true
  !!isoPrint.directory.active = true
  !!isoPrint.directory.val    = !fileObj.fullName()

  -- Hide this form
  hide !!isoBrowse

endmethod
-- End of method definition for .use(FILE)
