-- File:            isocontdflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the default parameters for the labels
-- used to indicate a continuation to another drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(STRING)                    -                   Check that the entered element exists
--  close()                          -                   Close the form
--  codeCheck(STRING)                -                   Check the entered code string
--  init()                           -                   Method to initialise the form
--  isoContDflts()                   -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save(BOOLEAN)                    -                   Saves the form settings to file
--  selSet()                         -                   Set and select gadget values
--  setCe(STRING,GADGET)             -                   Close the form
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  setPen(GADGET)                   -                   Set form frame pen values and stores in form object
--  store()                          -                   Updates the form objects with the form values
--  store(GADGET,STRING)             -                   Store the chosen character height and XY offset
--  upDown(REAL,STRING,GADGET)       -                   Raise or Lower distance gadgets
--
------------------------------------------------------------------------
setup form !!isoContDflts

  !this.formTitle = 'Continuation Tag Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-CONT-TAG| width 40 lines 1

  option .type 'Drawing Type' at xmin ymax+0.1 call |!this.selSet()| width 10

  frame .loc 'Local Labels' at x0 ymax+0.1

    text .aTemplate 'Arrive Template' at xmin+0.5 ymax-0.2 call |!this.check(!this.aTemplate.val)| width 28 is STRING
    button .aCe                       at xmax+0.5 ymin+0.1 call |!this.setCe('TXTM', !this.aTemplate)| pixmap width 10 height 12

    text .lTemplate 'Leave Template ' at xmin.aTemplate ymax+0.4 call |!this.check(!this.lTemplate.val)| width 28 is STRING
    button .lCe at xmax+0.5 ymin+0.1 call |!this.setCe('TXTM', !this.lTemplate)| pixmap width 10 height 12

    para .pOn at xmin.aTemplate ymax+0.4 text |Cont'd On String|
    text .on  at xmax ymin call |!this.store()| width 30 is STRING

    para .pFrom at xmin.pOn ymax+0.2 text |Cont'd From String|
    text .from  at xmax-2 ymin call |!this.store()| width 30 is STRING

    para .pCode at xmin.pFrom ymax+0.2 text 'Code String'
    text .code  at xmax-1 ymin call |!this.codeCheck(!this.code.val)| width 36 is STRING

    option .tPen 'Text Pen ' at xmin.lTemplate ymax+0.4 call |!this.store()| pixmap width 20 height 12

    text   .chei 'Text Height' tagwidth 9 at xmax+4.5 ymin  width 8 is REAL format !!isoTextFormat
    button .cheiUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .cheiDo at xmin      ymax-0.05 pixmap width 13 height 10

    option .fPen 'Frame Pen' at xmin.tPen ymax+0.4 call |!this.store()|              pixmap width 20 height 12
    option .fThick           at xmax+0.6  ymin     call |!this.setPen(!this.fThick)| pixmap width 44 height 12
    option .fStyle           at xmax+0.6  ymin     call |!this.store()|              pixmap width 90 height 12

    para    .pXOff    at xmin.fPen ymax+0.5 text 'Offset'

    text   .xOff 'X' at xmax+2    ymin  width 8 is REAL format !!isoOffsetFormat
    button .xOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .xOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

    text   .yOff 'Y' at xmax+1    ymin.xOff  width 8is REAL format !!isoOffsetFormat
    button .yOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .yOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

  exit

  button .save  'Save'  at x0.2           ymax+0.5  call |!this.save(true)|
  button .reset 'Reset' at xmax_Save+5    ymin_Save call |!this.reset()|
  button .close 'Close' at xmax form-size ymin_Save call |!this.close()|

  -- Members
  member .modified    is BOOLEAN
  member .hvacContTag is ISOCONTTAG
  member .elecContTag is ISOCONTTAG
  member .title       is STRING

  -- Units
  member .units           is STRING
  member .textIncrement   is REAL
  member .offsetIncrement is REAL

exit
-- End of form definition for !!isoContDflts

------------------------------------------------------------------------
--
-- Method:        .isoContDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoContDflts()

  -- Read the application units
  !appUnits             = object ISOUNITS()
  !this.units           = !appUnits.getUnits()
  !this.textIncrement   = !appUnits.getTextIncrement()
  !this.offsetIncrement = !appUnits.getOffsetIncrement()

  -- Pixmaps
  !this.aCe.addPixmap(!!pml.getPathName('browse.png'))
  !this.lCe.addPixmap(!!pml.getPathName('browse.png'))
  !this.cheiUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.cheiDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.xOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.xOffDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.yOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.yOffDo.addPixmap(!!pml.getPathName('downcounter.png'))

  -- Callbacks
  !this.chei.callback   = |!this.store(|
  !this.cheiUp.callback = |!this.upDown(!this.textIncrement,'UP',!this.chei)|
  !this.cheiDo.callback = |!this.upDown(!this.textIncrement,'DOWN',!this.chei)|
  !this.xOff.callback   = |!this.store(|
  !this.xOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.xOff)|
  !this.xOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.xOff)|
  !this.yOff.callback   = |!this.store(|
  !this.yOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.yOff)|
  !this.yOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.yOff)|

  -- Type
  !text[1]         = 'Hvac'
  !text[2]         = 'Electrical'
  !this.type.dtext = !text
  !text[2]         = 'Elec'
  !this.type.rtext = !text

  -- Pens
  do !count from 1 to 16
    !iconFile = 'colour' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
    !rtext[!count] = !count.string()
  enddo
  !this.tPen.dtext = !dtext
  !this.tPen.rtext = !rtext
  !this.fPen.dtext = !dtext
  !this.fPen.rtext = !rtext

  -- Thickness
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext[1] = !!pml.getPathName('linestylethin.png')
  !dtext[2] = !!pml.getPathName('linestylemedium.png')
  !dtext[3] = !!pml.getPathName('linestylethick.png')
  !rtext[1] = |Thin|
  !rtext[2] = |Medium|
  !rtext[3] = |Thick|
  !this.fThick.dtext = !dtext
  !this.fThick.rtext = !rtext

  -- Style
  !dtext     = ARRAY()
  !rtext     = ARRAY()
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|
  do !count from 1 to 10
    !iconFile = 'linestylethin' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Set form member objects
  !this.hvacContTag = !!isoMain.isoAdpApp.data.hvacContTag
  !this.elecContTag = !!isoMain.isoAdpApp.data.elecContTag

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoContDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set the defaults file name display
  !this.source.val = |Filename: | & !this.hvacContTag.file

  -- Set form member objects
  !this.hvacContTag = !!isoMain.isoAdpApp.data.hvacContTag
  !this.elecContTag = !!isoMain.isoAdpApp.data.elecContTag

  -- Set gadget settings
  !this.selSet()

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!this.hvacContTag.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .check(STRING)
--
-- Description: Check that the entered element exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .check(!element is STRING)

  -- Initialise variables
  !error = false

  -- Check if entered element actually exists
  !unusedTest = !element.dbref()
    handle (2,109)
      !!alert.error('The entered element name does not exist')
      !this.setModified(true)
      return
    endhandle

  -- Store change
  if (!error.not()) then
    !this.store()
  endif

endmethod
-- End of method definition for .check(STRING)

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoContDflts.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .codeCheck(STRING)
--
-- Description: Check the entered code string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The entered hash code string
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .codeCheck(!hashCode is STRING)

  -- Check that the code string contains a P3
  -- This is used as a default only.
  -- When the label is attached to a design element the P3 will be replaced by the relevant connection point
  -- This also allows for easy switching between ppoints in edit mode
  if (!hashCode.match('p3').eq(0) and !hashCode.match('P3').eq(0)) then
    !!alert.error('The code string must contain the word P3. This will be substituted for correct design element connection')
    return
  endif

  -- Store ce
  !ce = !!ce

  -- Check the validity of the code string
  !!ce = /*
  NEW DEPT
  !tempRefe = !!ce

  NEW LIBY
  NEW LALB
  NEW TXTM
    BTEX |$!<this.code.val>|
      handle any
        !!ce = !tempRefe
        DELETE DEPT
        !!ce = !ce
        return error
      endhandle

  -- Clear test and return to original ce
  !!ce = !tempRefe
  DELETE DEPT
  !!ce = !ce

  -- Store data
  !this.store()

endmethod
-- End of method definition for .codeCheck(STRING)

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save(!confirm is BOOLEAN)

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    if (!confirm) then
      !response = !!alert.confirm('Are you sure you wish to save the changes?')
      if (!response.eq('NO')) then
        return
      endif
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.hvacContTag = !this.hvacContTag
    !!isoMain.isoAdpApp.data.elecContTag = !this.elecContTag

    -- Save the settings to defaults file
    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric Continuation Tag defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Hvac
    !array.append('-- Part 1 - Hvac')
    !array.append(!this.hvacContTag.aTemplate.flnm)
    !array.append(!this.hvacContTag.lTemplate.flnm)
    !array.append(!this.hvacContTag.onString)
    !array.append(!this.hvacContTag.fromString)
    !array.append(!this.hvacContTag.code)
    !array.append(!this.hvacContTag.tColour.string())
    !array.append(!this.hvacContTag.chei.string(!!isoTextFormat))
    !array.append(!this.hvacContTag.fColour.string())
    !array.append(!this.hvacContTag.offset[1].string(!!isoOffsetFormat) & ' ' & !this.hvacContTag.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.hvacContTag.fStyle)
    !array.append(!this.hvacContTag.fThickness)

    -- Electrical
    !array.append('-- Part 2 - Electrical')
    !array.append(!this.elecContTag.aTemplate.flnm)
    !array.append(!this.elecContTag.lTemplate.flnm)
    !array.append(!this.elecContTag.onString)
    !array.append(!this.elecContTag.fromString)
    !array.append(!this.elecContTag.code)
    !array.append(!this.elecContTag.tColour.string())
    !array.append(!this.elecContTag.chei.string(!!isoTextFormat))
    !array.append(!this.elecContTag.fColour.string())
    !array.append(!this.elecContTag.offset[1].string(!!isoOffsetFormat) & ' ' & !this.elecContTag.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.elecContTag.fStyle)
    !array.append(!this.elecContTag.fThickness)

    -- Write to file
    !this.hvacContTag.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Initialise variables
  !gName = !this.type.selection() & 'ContTag'

  -- Set template gadgets
  !this.aTemplate.val = !this.$!gName$N.aTemplate.flnm
  !this.lTemplate.val = !this.$!gName$N.lTemplate.flnm

  -- Continuation strings
  !this.on.val = !this.$!gName$N.onString
  !this.from.val = !this.$!gName$N.fromString

  -- Code string
  !this.code.val = !this.$!gName$N.code

  -- Set offset gadgets
  !this.xOff.val = !this.$!gName$N.offset[1]
  !this.yOff.val = !this.$!gName$N.offset[2]

  -- Select pens
  !this.tPen.val = !this.$!gName$N.tColour
  !this.fPen.val = !this.$!gName$N.fColour

  -- Set character height
  !this.chei.val = !this.$!gName$N.chei

  -- Select the frame thickness and style
  !this.fThick.select('RTEXT', !this.$!gName$N.fThickness)
  !this.fStyle.select('RTEXT', !this.$!gName$N.fStyle)

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setCe(STRING,GADGET)
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type being searched for
--    2   R      GADGET      The gadget receiving the chosen element
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setCe(!type is STRING, !gadget is GADGET)

  -- Set browse form to search for db elements
  pml load form !!isoBrowse

  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  show !!isoBrowse

endmethod
-- End of method definition for .setCe(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setPen(GADGET)
--
-- Description: Set form frame pen values and stores in form object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setPen(!gadget is GADGET)

  -- Initialise variables
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|

  -- For thickness change the style values
  do !count from 1 to 10
    !iconFile = 'linestyle' & !gadget.selection().lowCase() & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Store change
  !this.store()

endmethod
-- End of method definition for .setPen()

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Updates the form objects with the form values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Initialise variables
  !gName = !this.type.selection() & 'ContTag'

  -- Save settings to the object
  !this.$!gName$N.aTemplate  = !this.aTemplate.val.dbref()
  !this.$!gName$N.lTemplate  = !this.lTemplate.val.dbref()
  !this.$!gName$N.onString   = !this.on.val
  !this.$!gName$N.fromString = !this.from.val
  !this.$!gName$N.code       = !this.code.val
  !this.$!gName$N.tColour    = !this.tPen.selection().real()
  !this.$!gName$N.fColour    = !this.fPen.selection().real()
  !this.$!gName$N.fThickness = !this.fThick.selection()
  !this.$!gName$N.fStyle     = !this.fStyle.selection()
  !this.$!gName$N.chei       = !this.chei.val
  !this.$!gName$N.offset[1]  = !this.xOff.val
  !this.$!gName$N.offset[2]  = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:        .store(GADGET,STRING)
--
-- Description:   Store the chosen character height and XY offset
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!dummyObject is GADGET, !dummyAction is STRING)

  -- Initialise variables
  !gName = !this.type.selection() & 'ContTag'

  -- Save settings to the object
  !this.$!gName$N.chei      = !this.chei.val
  !this.$!gName$N.offset[1] = !this.xOff.val
  !this.$!gName$N.offset[2] = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise or Lower distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDown(!increment is REAL, !direction is STRING, !gadget is GADGET)

  -- Initialise variables
  !gName = !this.type.selection() & 'ContTag'

  -- Raise the value by the increment
  if (!direction.eq('UP')) then

    !nextValue = !gadget.val + !increment

  -- Reduce value by the increment
  else

    !nextValue = !gadget.val - !increment

  endif

  -- Test for zero or less
  if (!nextValue.leq(0)) then
   !nextValue = 0
  endif

  -- Set the gadget value
  !gadget.val = !nextValue

  -- Save settings to the object
  !this.$!gName$N.chei      = !this.chei.val.convertUnits(!this.units)
  !this.$!gName$N.offset[1] = !this.xOff.val.convertUnits(!this.units)
  !this.$!gName$N.offset[2] = !this.yOff.val.convertUnits(!this.units)

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .upDown()
