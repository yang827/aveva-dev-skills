--
-- File:            isocontent.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store a list of those drawing elements that will
-- be created when the drawing is produced
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  isoContent()                     -                   Construct
--  modify(GADGET)                   -                   Set this form as modified
--  save()                           -                   Saves the form settings to file
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--
------------------------------------------------------------------------
setup form !!isoContent

  !this.formTitle  = |Drawing Content|
  !this.initCall   = |!this.init()|
  !this.quitCall   = '!this.close()'

  para .text   at x0     ymin text |Defaults Filename:|
  para .source at xmin+1 ymax text |%PDMSDFLTS%\IsoADP\DRA-ISO-CONTENT| width 30 lines 1

  frame .hdr |Available Content| at x0 ymax+0.1 width 34

    path down
    vdis 0.5
    toggle .c1  |Main View| at xmin+3 ymax+0.2 call |!this.modify(!this.c1)|
    toggle .c2  |North Arrow| call |!this.modify(!this.c2)|
    toggle .c3  |Location Plan| call |!this.modify(!this.c3)|
    toggle .c4  |Key Plan| call |!this.modify(!this.c4)|
    toggle .c5  |MTO Table| call |!this.modify(!this.c5)|
    toggle .c6  |Revision Block| call |!this.modify(!this.c6)|
    toggle .c7  |Dimensions| call |!this.modify(!this.c7)|
    toggle .c8  |Elevations| call |!this.modify(!this.c8)|
    toggle .c9  |Named Labels| call |!this.modify(!this.c9)|
    toggle .c10 |Specification Breaks| call |!this.modify(!this.c10)|
    toggle .c11 |Insulation Breaks| call |!this.modify(!this.c11)|
    toggle .c12 |Penetration| call |!this.modify(!this.c12)|
    toggle .c13 |Calculate C of G| call |!this.modify(!this.c13)|
    toggle .c14 |Standard Pattern| call |!this.modify(!this.c14)|
    toggle .c15 |MDS Supports| call |!this.modify(!this.c15)|

  exit

  button .ok    |Save|  at x0 ymax+0.5 call |!this.save()|
  button .close |Close| at xmax form-size ymin.ok call |!this.close()|

  -- Members
  member .file     is FILE
  member .modified is BOOLEAN
  member .title    is STRING

exit
-- End of form definition for !!isoContent

------------------------------------------------------------------------
--
-- Method:        .isoContent()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoContent()

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoContent()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set gadgets
  !this.c1.val  = !!isoMain.isoAdpApp.data.isoContent.main
  !this.c2.val  = !!isoMain.isoAdpApp.data.isoContent.nArr
  !this.c3.val  = !!isoMain.isoAdpApp.data.isoContent.loca
  !this.c4.val  = !!isoMain.isoAdpApp.data.isoContent.keyP
  !this.c5.val  = !!isoMain.isoAdpApp.data.isoContent.mtoT
  !this.c6.val  = !!isoMain.isoAdpApp.data.isoContent.revi
  !this.c7.val  = !!isoMain.isoAdpApp.data.isoContent.dimn
  !this.c8.val  = !!isoMain.isoAdpApp.data.isoContent.elev
  !this.c9.val  = !!isoMain.isoAdpApp.data.isoContent.name
  !this.c10.val = !!isoMain.isoAdpApp.data.isoContent.spec
  !this.c11.val = !!isoMain.isoAdpApp.data.isoContent.insul
  !this.c12.val = !!isoMain.isoAdpApp.data.isoContent.pene
  !this.c13.val = !!isoMain.isoAdpApp.data.isoContent.cog
  !this.c14.val = !!isoMain.isoAdpApp.data.isoContent.stanPat
  !this.c15.val = !!isoMain.isoAdpApp.data.isoContent.supp

  -- Set members
  !this.file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-CONTENT')

  -- Mark form as not modified
  !this.setModified(false)

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save()

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoContent.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .modify(GADGET)
--
-- Description: Set this form as modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget being actioned
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .modify(!gadget is GADGET)

  -- Test for associated switches
  -- Main with dimensions,coordinates,named,spec break and insul break
  if (!gadget.name().eq('C1')) then
    !this.c7.val = !gadget.val
    !this.c8.val = !gadget.val
    !this.c9.val = !gadget.val
    !this.c10.val = !gadget.val
    !this.c11.val = !gadget.val
    !this.c12.val = !gadget.val
  endif

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .modify(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save()

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    !response = !!alert.confirm('Are you sure you wish to save the changes?')
    if (!response.eq('NO')) then
      return
    endif

    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric ADP Content Defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Body
    do !count from 1 to 15

      -- Read gadget value
      !boolean = !this.c$!<count>.val

      -- Store value as On or Off
      if (!boolean) then
        !array.append('On')
      else
        !array.append('Off')
      endif

    enddo

    -- Write to file
    !this.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

    -- Rebuild defaults object
    !!isoMain.isoAdpApp.data.isoContent.getDflts()

    -- Load MDS defaults
    if (!this.c15.val) then
      !!isoMain.isoAdpApp.data.hvacMdsTag.getDflts('HVAC')
      !!isoMain.isoAdpApp.data.elecMdsTag.getDflts('PIPE')
      !!isoDflts.defaults.setActive('MDS Supports...',true)
    else
      !!isoDflts.defaults.setActive('MDS Supports...',false)
    endif

  endif

endmethod
-- End of method definition for .save()

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and close/cancel button
  if (!modified) then
    !this.formTitle = !this.title & ' *'
    !this.close.tag = 'Cancel'
    !this.ok.active = true

  else
    !this.formTitle = !this.title
    !this.close.tag = 'Close'
    !this.ok.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)
