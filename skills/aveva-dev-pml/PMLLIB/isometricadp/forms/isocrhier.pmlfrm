-- File:            isocrhier.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Create the required hierarchy for this application in the selected database
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accessWorld()                    -                   Access the world and create the hierarchy
--  cancel()                         -                   Cancel the hierarchy creation process
--  create(STRING)                   -                   Create the hierarchy
--  init()                           -                   Method to initialise the form
--  isoCrHier()                      -                   Constructor method
--  setTask()                        -                   Set the task name
--
------------------------------------------------------------------------
setup form !!isoCrHier

  !this.formTitle  = |Creating the Hierarchy|
  !this.initCall   = |!this.init()|
  !this.quitCall   = '!this.cancel()'


  -- Task
  para .task at x1 ymax text 'Choose a DB for the Registry'

  -- Databases
  frame .dtbs | Databases | at x0 ymax

    list .dbs at x1 y1 single width 25 height 5

  exit

  path right
  button .apply  | Apply | at x0 ymax.dtbs+0.5
  button .cancel |Dismiss| at xmax form-size cancel

  member .userName is STRING
  member .module   is ISOMODULE

  -- What is being created REGI or LIBY
  member .create   is STRING

exit

------------------------------------------------------------------------
--
-- Method:        .isoCrHier()
--
-- Description:   Constructor method
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoCrHier()

  -- Form callbacks
  !this.dbs.callback    = |!this.accessWorld()|
  !this.apply.callback  = |!this.create(!this.create)|
  !this.cancel.callback = |!this.cancel()|

endmethod
-- End of method definition for .isoCrHier()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !session = current session

  -- Get all draft db's open in RW
  !draftDbs = !!isoRwDbs()

  -- Populate list gadget
  !this.dbs.dtext = !draftDbs
  !this.dbs.rtext = !draftDbs

  -- Username
  !this.userName = !session.name

  -- Set the task name
  !this.setTask()

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .accessWorld()
--
-- Description: Access the world and create the hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .accessWorld()

  -- Find the point world within the selected db
  -- This is too ensure that the liby is created at the highest level
  !world = /*
  !!ce = !world
  do !count from 1 to !world.mcount

    !!ce = !world
    $!count
    !currElem = !!ce

    VAR !dbName DBNAME

    if (!dbName.eq(!this.dbs.selection('RTEXT')) and !currElem.type.upCase().eq('PTWL')) then

      -- We are positioned at the correct point
      break

    endif

  enddo

endmethod
-- End of method .accessWorld()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel the hierarchy creation process
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .cancel()

  -- As the user has chosen not to create the hierarchy, grey out the toolbar options
  !!isoMain.isoAdpApp.setActive(false)

endmethod
-- End of method .cancel()

-----------------------------------------------------------------------
--
-- Method:      .create(STRING)
--
-- Description: Create the hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The element to be created REGI or LIBY
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .create(!create is STRING)

  -- Test for units
  if (!!isImperialLength('DIST')) then
    !metric = false

  else
    !metric = true

  endif

  -- Test for True-Type
  !fontManager = object ADMFONTMANAGER()
  if (!fontManager.firstTtfId.set()) then
    !font = !fontManager.firstTtfId
  else
    !font = 1
  endif

  -- Test for coordinate system
  if (defined(!!coords)) then

    -- XYZ
    if (!!coords.xyzFlag) then
      !coord = 'XYZ'

    -- ENU
    else
      !coord = 'ENU'

    endif

  -- Default to ENU
  else
    !coord = 'ENU'

  endif

  -- Create the registry
  if (!create.eq('REGI')) then

    -- Check for any existing registry
    var !existsRegi EXIST $!!isoDflts.default2.val

    -- Create the registry
    if (!existsRegi.eq('FALSEA')) then

      -- Build department name
      -- For Native Fonts
      if (!font.lt(5)) then
        !deptName = '/Isometrics/Department'

      -- For True-Type Fonts
      else
        !deptName = '/TT/Isometrics/Department'

      endif

      NEW DEPT $!deptName
        handle (41,12)
          DELETE DEPT
          $!deptName
        elsehandle none
          FONT $!font
        endhandle

      -- Set the units
      UCODE $!!<distanceFmt.units> DISTANCE $!!<boreFmt.units> BORE

      NEW REGI $!!isoDflts.default2.val
        handle (41,12)
          DELETE REGI
          !!ce = !!isoDflts.default2.val.dbref()
        endhandle

    endif

    -- Look for the library
    var !existsLiby EXIST $!!isoDflts.default3.val
    if (!existsLiby.eq('FALSEA')) then

      -- Set the form to create the library
      !this.create = 'LIBY'
      !this.dbs.clearSelection()
      !this.setTask()

      return

    endif

  -- Create the library
  else

    -- Check for any existing Library
    var !existsOld EXIST /Isometric_ADP/StandardLibrary
    var !existsNew EXIST /TT/Isometric_ADP/StandardLibrary

    -- Create the library
    if (!!isoDflts.default3.val.eq('/TT/Isometric_ADP/StandardLibrary')) then

      -- Check that there are true-type fonts available
      if (!font.lt(5) and !existsOld.eq('FALSEA')) then
        !!alert.message('There are not any True-Type fonts defined in the system. The Library will use PDMS Native Fonts instead.')
      endif

      -- Load the supplied data
      if (!metric) then

        -- PDMS Native font
        if (!font.lt(5) and !existsOld.eq('FALSEA')) then
          $M "%PMLLIB%\isometricadp\data\Metric_Library_load.dat" $!font $!coord

        -- True-type font
        elseif (!existsNew.eq('FALSEA')) then
          $M "%PMLLIB%\isometricadp\data\Metric_Library_load.dat" $!font $!coord TT/

        endif

      else

        -- PDMS Native font
        if (!font.lt(5) and !existsOld.eq('FALSEA')) then
          $M "%PMLLIB%\isometricadp\data\Imperial_Library_load.dat" $!font $!coord

        -- True-type font
        elseif (!existsNew.eq('FALSEA')) then
          $M "%PMLLIB%\isometricadp\data\Imperial_Library_load.dat" $!font $!coord TT/

        endif

      endif

    elseif (!!isoDflts.default3.val.eq('/Isometric_ADP/StandardLibrary')) then

      -- Load the supplied data
      if (!metric) then
        $M "%PMLLIB%\isometricadp\data\Metric_Library_load.dat" $!font $!coord

      else
        $M "%PMLLIB%\isometricadp\data\Imperial_Library_load.dat" $!font $!coord

      endif

    else

      -- Check for an existing entered Library
      var !existsLiby EXIST $!!isoDflts.default3.val
      if (!existsLiby.eq('FALSEA')) then
        !!alert('The library specified in the defaults file does not exist. Please specify one that does.')
        return

      endif

    endif

  endif

  -- Return to drawing dept
  REGI $!!isoDflts.default2.val
  DEPT

  -- Set defaults form create button focus
  !!isoDflts.create.active = false

  -- Rebuild defaults form member object
  !!isoDflts.data.loaded = true
  !!isoDflts.data.isoContent.getDflts()
  !!isoDflts.data.hvacMtoGen.getDflts('HVAC')
  !!isoDflts.data.elecMtoGen.getDflts('CWAY')
  !!isoDflts.data.hvacElevTag.getDflts('HVAC', !this.module.description)
  !!isoDflts.data.elecElevTag.getDflts('CWAY', !this.module.description)
  !!isoDflts.data.hvacContTag.getDflts('HVAC', !this.module.description)
  !!isoDflts.data.elecContTag.getDflts('CWAY', !this.module.description)
  !!isoDflts.data.hvacNamedTag.getDflts('HVAC')
  !!isoDflts.data.elecNamedTag.getDflts('CWAY')
  !!isoDflts.data.hvacSpecBrk.getDflts('HVAC')
  !!isoDflts.data.elecSpecBrk.getDflts('CWAY')
  !!isoDflts.data.hvacInsulBrk.getDflts('HVAC')
  !!isoDflts.data.elecInsulBrk.getDflts('CWAY')
  !!isoDflts.data.hvacDimn.getDflts('HVAC')
  !!isoDflts.data.elecDimn.getDflts('CWAY')
  !!isoDflts.data.hvacPeneTag.getDflts('HVAC')
  !!isoDflts.data.elecPeneTag.getDflts('CWAY')
  !!isoDflts.data.hvacOrigin.getDflts('HVAC')
  !!isoDflts.data.elecOrigin.getDflts('CWAY')
  !!isoDflts.data.hvacMdsTag.getDflts('HVAC')
  !!isoDflts.data.elecMdsTag.getDflts('CWAY')
  !!isoDflts.init()
  !!isoDflts.data.isoRegister  = !!isoDflts.default2.val.dbref()
  !!isoDflts.data.stdLibrary   = !!isoDflts.default3.val.dbref()
  !!isoDflts.data.reprRuleset  = !!isoDflts.default4.val.dbref()
  !!isoDflts.data.backingSheet = !!isoDflts.default5.val.dbref()
  !!isoDflts.data.standardPatt = !!isoDflts.default6.val.dbref()

  -- Reload the main application defaults
  !!isoMain.isoAdpApp.load()

  -- Reset the defaults form
  !!isoDflts.init()

  -- Hide the errors list
  !!isoDisplayList.hide()

  -- Set the toolbar active
  !!isoMain.isoAdpApp.active(true)

  -- Hide this form
  !this.hide()

  SAVEWORK

endmethod
-- End of method .create()

-----------------------------------------------------------------------
--
-- Method:      .setTask()
--
-- Description: Set the task name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setTask()

  -- Create the registry
  if (!this.create.eq('REGI')) then
    !this.task.val = 'Choose a DB for the Registry'

  else
    !this.task.val = 'Choose a DB for the Library'

  endif

endmethod
-- End of method .setTask()
