--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the general default parameters for this application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(GADGET,STRING)             -                   Check that the entered element exists
--  checkLiby()                      -                   Check that the libraries exist
--  close()                          -                   Close the form
--  hierarchy()                      -                   Display the form for creating the hierarchy
--  init()                           -                   Method to initialise the form
--  isoDflts()                       -                   Constructor method
--  load(STRING)                     -                   Load the standard drawings
--  reset()                          -                   Reinitialise the form
--  revision()                       -                   Set the relevant set of revision codes
--  save()                           -                   Save the form settings
--  setCe(STRING,GADGET)             -                   Choose the relevant db element via a unique db browser
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  store()                          -                   Sets the form as modified after calling the browser
--
------------------------------------------------------------------------
setup form !!isoDflts

  !this.formTitle = 'Isometric ADP Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  -- Other defaults
  bar
    add |More defaults| .defaults
    add |Load| .load
  exit

  menu .defaults
    add |Continued Tags...| |show !!isoContDflts|
    add |Dimensions...|     |show !!isoDimnDflts|
    add |Drawing Content...| |show !!isoContent|
    add |Drawing Number...| |show !!isoDrwgNoDflts|
    add |Elevation Tags...| |show !!isoElevDflts|
    add |Insul Break...|    |show !!isoInsulBrkDflts|
    add |MDS Supports...|   |show !!isoMdsDflts|
    add |MTO General...|    |show !!isoMtoGenDflts|
    add |MTO Parameters...| |show !!isoMtoParam|
    add |Named Tags...|     |show !!isoNamedDflts|
    add |Origin...|         |show !!isoOriginDflts|
    add |Penetrations...|   |show !!isoPeneDflts|
    add |Spec Break...|     |show !!isoSpecBrkDflts|
  exit

  menu .load
    add |Standard Drawings| |!this.load('STD')|
  exit

  para .source at x0.5 y0 text |Defaults Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-ADP                        |

  frame .settings ' General Settings ' at x0 y1.2

    -- Note: default setting 1 was deleted at version 12 and is not now used
    -- However, the naming must remain unchanged as the defaults file still contains an entry
    -- This allows the defaults file to be compatible between versions
    para .para2   at x1 ymax width 28 lines 1
    para .para3   at x1 ymax width 28 lines 1
    para .para4   at x1 ymax width 28 lines 1
    para .para5   at x1 ymax width 28 lines 1
    para .para6   at x1 ymax width 28 lines 1
    para .para7   at x1 ymax width 28 lines 1
    para .para8   at x1 ymax width 28 lines 1
    para .para9   at x1 ymax width 28 lines 1
    para .para10  at x1 ymax width 28 lines 1
    para .para11  at x1 ymax width 28 lines 1
    para .para12  at x1 ymax width 28 lines 1
    para .para13  at x1 ymax width 28 lines 1

    !this.para2.val  = |Register where Isometrics are created .........|
    !this.para3.val  = |Isometric ADP Standard Library ....................|
    !this.para4.val  = |Representation Ruleset .................................|
    !this.para5.val  = |Backing Sheet ................................................|
    !this.para6.val  = |Standard Pattern ............................................|
    !this.para7.val  = |Rule that identifies a Cable Way ....................|
    !this.para8.val  = |Rule that identifies a Ducting ..........................|
    !this.para9.val  = |Method used to split the design into spools ..|
    !this.para10.val = |Drawing Name Rule .......................................|
    !this.para11.val = |Line Number Rule ..........................................|
    !this.para12.val = |Initial Revision ................................................|
    !this.para13.val = |Date Format ...................................................|

    text .default2    at xmax.para2         ymin.para2         call |!this.check(!this.default2,!this.default2.val)| width 35 STRING
    text .default3    at xmax.para3         ymin.para3         call |!this.check(!this.default3,!this.default3.val)| width 35 STRING
    text .default4    at xmax.para4         ymin.para4         call |!this.check(!this.default4,!this.default4.val)| width 35 STRING
    text .default5    at xmax.para5         ymin.para5         call |!this.check(!this.default5,!this.default5.val)| width 35 STRING
    text .default6    at xmax.para6         ymin.para6         call |!this.check(!this.default6,!this.default6.val)| width 35 STRING
    text .default7    at xmax.para7         ymin.para7         call |!this.setModified(true)|                        width 38 STRING
    text .default8    at xmax.para8         ymin.para8         call |!this.setModified(true)|                        width 38 STRING
    option .default9  at xmax.para9         ymin.para9         call |!this.setModified(true)|                        width 15
    text .default10   at xmax.para10        ymin.para10        call |!this.setModified(true)|                        width 38 STRING
    text .default11   at xmax.para11        ymin.para11        call |!this.setModified(true)|                        width 38 STRING
    option .default12 at xmax.para12        ymin.para12        call |!this.revision()|                               width 9
    option .default13 at xmax.default12+0.5 ymin.default12     call |!this.setModified(true)|                        width 3
    option .default14 at xmin.default12     ymax.default12+0.1 call |!this.setModified(true)|                        width 13
    option .default15 at xmax.default14+0.5 ymin.default14     call |!this.setModified(true)|                        width 5

    button .default2CE at xmax.default2+0.5 ymin.default2 call |!this.setCe('REGI', !this.default2)| pixmap width 10 height 12
    button .default3CE at xmax.default3+0.5 ymin.default3 call |!this.setCe('LIBY', !this.default3)| pixmap width 10 height 12
    button .default4CE at xmax.default4+0.5 ymin.default4 call |!this.setCe('RRST', !this.default4)| pixmap width 10 height 12
    button .default5CE at xmax.default5+0.5 ymin.default5 call |!this.setCe('BACK', !this.default5)| pixmap width 10 height 12
    button .default6CE at xmax.default6+0.5 ymin.default6 call |!this.setCe('OVER', !this.default6)| pixmap width 10 height 12

    button .create at xmax.default2-2.5 ymax.default12-0.3 call |!this.hierarchy()| pixmap width 20 height 20

  exit

  button .save  'Save'  at x0.2 ymax.settings+0.5   call |!this.save()|
  button .reset 'Reset' at xmax_Save+10 ymin_Save   call |!this.reset()|
  button .close 'Close' at xmax form-size ymin_Save call |!this.close()|

  -- Members
  member .data     is ISODEFAULTS
  member .file     is FILE
  member .modified is BOOLEAN
  member .title    is STRING

exit
-- End of form definition for !!isoDflts

------------------------------------------------------------------------
--
-- Method:        .isoDflts()
--
-- Description:   Constructor method
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDflts()

  -- Pixmaps
 !this.create.addPixmap(!!pml.getPathName('trafficlight_red.png'),!!pml.getPathName('trafficlight_red.png'),!!pml.getPathName('trafficlight_green.png'))
-- !this.default1CE.addPixmap(!!pml.getPathName('browse.png'))
 !this.default2CE.addPixmap(!!pml.getPathName('browse.png'))
 !this.default3CE.addPixmap(!!pml.getPathName('browse.png'))
 !this.default4CE.addPixmap(!!pml.getPathName('browse.png'))
 !this.default5CE.addPixmap(!!pml.getPathName('browse.png'))
 !this.default6CE.addPixmap(!!pml.getPathName('browse.png'))

  -- Spool Splitting options
  !dtext[1] = 'By Volume'
  !dtext[2] = 'By Split Point'
  !rtext[1] = 'VOLUME'
  !rtext[2] = 'SPLITPOINT'
  !this.default9.dtext = !dtext
  !this.default9.rtext = !rtext

  -- Revision option
  !text[1]              = 'Internal'
  !text[2]              = 'External'
  !this.default12.dtext = !text
  !this.default12.rtext = !text

  -- Date format
  !text     = ARRAY()
  !text[1]  = '3/4'
  !text[2]  = '3/4/00'
  !text[3]  = '03/04/00'
  !text[4]  = '3-Mar'
  !text[5]  = '3-Mar-00'
  !text[6]  = '03-Mar-00'
  !text[7]  = 'Mar-00'
  !text[8]  = 'March-00'
--  !text[9]  = 'March 3, 2000'
--  !text[10] = '3/4/00 1:30pm'
--  !text[11] = '3/4/00 13:30'
  !this.default14.dtext = !text
  !this.default14.rtext = !text

  -- Date zone
  !text    = ARRAY()
  !text[1] = 'World'
  !text[2] = 'USA'
  !this.default15.dtext = !text
  !this.default15.rtext = !text

  -- Set loaded
  !this.data.loaded = false

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Get the defaults from the main object
  !this.data = !!isoMain.isoAdpApp.data
  !this.file = !this.data.file

  -- Set the defaults file name display
  !this.source.val = |Defaults Filename: | & !this.file

  -- Check loaded status
  if (!this.data.loaded) then

    -- Set the 'create hierarchy' button inactive
    !this.create.active = false

    -- Set gadgets that relate to database elements
    !this.default2.val   = !this.data.isoRegister.flnm
    !this.default3.val   = !this.data.stdLibrary.flnm
    !this.default4.val   = !this.data.reprRuleset.flnm
    !this.default5.val   = !this.data.backingSheet.flnm
    !this.default6.val   = !this.data.standardPatt.flnm

  else

    -- Set the 'create hierarchy' button active
    !this.create.active = true

    -- Set gadgets that relate to database elements, which do not exist
    if (!this.data.isoRegister.unset()) then
      !this.default2.val = !this.data.isoRegisterDef
    else
      !this.default2.val = !this.data.isoRegister.flnm
    endif

    if (!this.data.stdLibrary.unset()) then
      !this.default3.val = !this.data.stdLibraryDef
    else
      !this.default3.val = !this.data.stdLibrary.flnm
    endif

    if (!this.data.reprRuleset.unset()) then
      !this.default4.val = !this.data.reprRulesetDef
    else
      !this.default4.val = !this.data.reprRuleset.flnm
    endif

    if (!this.data.backingSheet.unset()) then
      !this.default5.val = !this.data.backingSheetDef
    else
      !this.default5.val = !this.data.backingSheet.flnm
    endif

    if (!this.data.standardPatt.unset()) then
      !this.default6.val = !this.data.standardPattDef
    else
      !this.default6.val = !this.data.standardPatt.flnm
    endif

  endif

  -- Set the remaining gadgets
  !this.default7.val   = !this.data.elecRule
  !this.default8.val   = !this.data.hvacRule
  !this.default10.val  = !this.data.drwgNameRule
  !this.default11.val  = !this.data.lineNumbRule

  !this.default9.select('RTEXT',!this.data.splitMethod)
  !this.default12.select('RTEXT',!this.data.startRev)

  -- Fill option gadget with the array of revision values
  if (!this.data.startRev.upcase().eq('INTERNAL')) then
    !this.default13.dtext = !this.data.revs[1].split(',')
    !this.default13.rtext = !this.data.revs[1].split(',')
  else
    !this.default13.dtext = !this.data.revs[2].split(',')
    !this.default13.rtext = !this.data.revs[2].split(',')
  endif

  !this.default13.select('RTEXT',!this.data.initialRev)
  !this.default14.select('RTEXT',!this.data.dateFormat)
  !this.default15.select('RTEXT',!this.data.dateZone)

  -- Mark form as not modified or not
  -- For a previous version allow the latest settings to be saved
  if (!this.data.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .check(GADGET,STRING)
--
-- Description: Check that the entered element exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The calling gadget
--    2   R      STRING      Element reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .check(!gadget is GADGET,!element is STRING)

  -- Check for a leading slash character
  if (!element.substring(1,1).neq('/')) then
    !name = '/' & !element
    !gadget.val = !name
    !gadget.setFocus()

  else
    !name = !element

  endif

  -- Check if entered element actually exists
  !unusedTest = !name.dbref()
    handle (2,109)
      !!alert.error('Element '& !element & ' does not exist')
      return

    endhandle

  -- Set form as modified
  !this.setModified(true)

endmethod
-- End of method .check(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .checkLiby()
--
-- Description: Check that the libraries exist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .checkLiby()

  -- Initialise variables
  !notExist = 0

  -- Build array of db elements
--  !elements[1] = !this.data.drawListLiby
  !elements[2] = !this.data.isoRegister
  !elements[3] = !this.data.stdLibrary
  !elements[4] = !this.data.reprRuleset
  !elements[5] = !this.data.backingSheet
  !elements[6] = !this.data.standardPatt

  -- Look for any non-existing default elements
  do !elementRefe val !elements

    -- Test if library exists
    if (!elementRefe.badref()) then
      !notExist = !notExist + 1
    endif

  enddo

  -- Set defaults form create button focus
  if (!notExist.neq(0)) then
    !this.create.active = true

  else
    !this.create.active = false

  endif

endmethod
-- End of method .checkLiby()

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save()

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoDflts.hide()

endmethod
-- End of method .close()

-----------------------------------------------------------------------
--
-- Method:      .hierarchy()
--
-- Description: Display the form for creating the hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .hierarchy()

  -- Test for existing registry
  var !exist EXIST $!this.default2.val
  if (!exist.upcase().eq('FALSEA')) then

    -- Choose in which db to create the registry
    !!isoCrHier.create = 'REGI'
    show !!isoCrHier

  -- The registry might exist but test for existing library
  else

    -- Test for existing library
    var !exist EXIST $!this.default3.val
    if (!exist.upcase().eq('TRUEA')) then

      -- Attempt to create the hierarchy
      !!isoCrHier.create('LIBY')

    else

      -- Choose in which db to create the library
      !!isoCrHier.create = 'LIBY'
      show !!isoCrHier

    endif

  endif

endmethod
-- End of method .hierarchy()

-----------------------------------------------------------------------
--
-- Method:      .load(STRING)
--
-- Description: Load the standard drawings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Load type STD
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .load(!type is STRING)

  -- Standard drawings
  if (!type.eq('STD')) then

    -- Load the drawings
    !!isoCrStd()

  endif

endmethod
-- End of method .load(STRING)

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Reinitialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method .reset()

-----------------------------------------------------------------------
--
-- Method:      .revision()
--
-- Description: Set the relevant set of revision codes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .revision()

  -- For each type load the relevant codes
  if (!this.default12.selection().upcase().eq('INTERNAL')) then
    !this.default13.dtext = !this.data.internalRev
    !this.default13.rtext = !this.data.internalRev
  else
    !this.default13.dtext = !this.data.externalRev
    !this.default13.rtext = !this.data.externalRev
  endif

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method .revision()

-----------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: Save the form settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save()

  -- Initialise variables
  !contents = ARRAY()

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    !response = !!alert.confirm('Are you sure you wish to save the changes?')
    if (!response.eq('NO')) then
      return
    endif

    !contents.append('--')
    !contents.append('-- Isometric ADP Main Defaults')
    !contents.append('--')
    !contents.append('--')
    !contents.append('-- Part 1 - Production defaults')
--    !contents.append(!this.default1.val)
    !contents.append('NOT USED AT PDMS12 AND LATER')
    !contents.append(!this.default2.val)
    !contents.append(!this.default3.val)
    !contents.append(!this.default4.val)
    !contents.append(!this.default5.val)
    !contents.append(!this.default6.val)
    !contents.append(!this.default7.val)
    !contents.append(!this.default8.val)
    !contents.append(!this.default10.val)
    !contents.append(!this.default11.val)
    !contents.append(!this.default12.selection())
    !contents.append(!this.default13.selection())
    !contents.append(!this.default14.selection())
    !contents.append(!this.default15.selection())

    !contents.append('-- Part 2 - Revision Ranges')
    !contents.append(!this.data.revs[1])
    !contents.append(!this.data.revs[2])

    !contents.append('-- Part 3 - North Arrow Symbols')
    !contents.appendArray(!this.data.narrSymbols)

    !contents.append('-- Part4 - Limits Boxes')
    do !limits val !this.data.limitsBoxes
      !contents.append(!limits.string(!!isoLimitsFormat))
    enddo

    !contents.append('-- Part5 - Output')
    !contents.append(!this.data.outputXls)
    !contents.append(!this.data.xlsFolder)
    !contents.append(!this.data.outputPdf)
    !contents.append(!this.data.pdfFolder)

    !contents.append('-- Part 6 - Spool Splitting')
    !contents.append(!this.default9.selection())

    -- Write to file
    !this.file.writefile('over',!contents)

    -- Mark form as unmodified
    !this.setModified(false)

    -- Rebuild form member object
    !this.data.getDflts()

    -- Check the libraries
    !this.checkLiby()

    -- Pass the changes to the main object
    !!isoMain.isoAdpApp.data = !this.data
    !!isoMain.init()

  endif

endmethod
-- End of method .save()

-----------------------------------------------------------------------
--
-- Method:      .setCe(STRING,GADGET)
--
-- Description: Choose the relevant db element via a unique db browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type being searched for
--    2   R      GADGET      The gadget receiving the chosen element
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setCe(!type is STRING, !gadget is GADGET)

  -- Set browse form to search for db elements
  if (undefined(!!isoBrowse)) then
    pml load form !!isoBrowse
  endif

  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  show !!isoBrowse

endmethod
-- End of method .setCe(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Sets the form as modified after calling the browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()
