--
-- File:            isodimndflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the default parameters for the dimensions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  isoDimnDflts()                   -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save(BOOLEAN)                    -                   Saves the form settings to file
--  selSet()                         -                   Set and select gadget values
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  setPen(GADGET)                   -                   Set form frame pen values and stores in form object
--  store()                          -                   Updates the form objects with the form values
--  store(GADGET,STRING)             -                   Store the chosen character height and XY offset
--  upDown(REAL,STRING,GADGET)       -                   Raise or Lower distance gadgets
--
------------------------------------------------------------------------
setup form !!isoDimnDflts

  !this.formTitle = 'Dimension Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-DIMENSION| width 40 lines 1

  option .type 'Drawing Type' at xmin ymax+0.1 call |!this.selSet()| width 10

  frame .loc 'Dimensions' at x0 ymax+0.1

    option .function 'Dimension' at xmin+1 ymax-0.2 call |!this.store()| width 27

    option .tPen 'Text Pen ' at xmin.function ymax+0.3 call |!this.store()| pixmap width 20 height 12

    text   .chei 'Text Height' tagwidth 9 at xmax+4.5 ymin  width 8 is REAL format !!isoTextFormat
    button .cheiUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .cheiDo at xmin      ymax-0.05 pixmap width 13 height 10

    option .lPen 'Line Pen ' at xmin.tPen ymax.tPen+0.4 call |!this.store()|              pixmap width 20 height 12
    option .lThick           at xmax+0.6  ymin          call |!this.setPen(!this.lThick)| pixmap width 44 height 12
    option .lStyle           at xmax+0.6  ymin          call |!this.store()|              pixmap width 90 height 12

    para   .pTerm   at xmin.tPen ymax+0.4 text |Terminator|
    option .term '' at xmax ymin call |!this.store()| pixmap width 16 height 16

    text   .gap 'Gap Accuracy' tagwidth 10 at xmax+6 ymin width 8 is REAL format !!isoOffsetFormat

    para   .pOff  at xmin.lPen ymax+0.3 text 'Offset'
    text   .off   at xmax+4    ymin  width 8 is REAL format !!isoOffsetFormat
    button .offUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .offDo at xmin      ymax-0.05 pixmap width 13 height 10

    toggle .relBore 'Relative to Bore' tagwidth 12 at xmax+2 ymin.off call |!this.store()|

  exit

  button .save  'Save' at x0.2            ymax+0.5  call |!this.save(true)|
  button .reset 'Reset' at xmax.save+5    ymin.save call |!this.reset()|
  button .close 'Close' at xmax form-size ymin.save call |!this.close()|

  -- Members
  member .modified        is BOOLEAN
  member .hvacDimn        is ISODIMENSION
  member .elecDimn        is ISODIMENSION
  member .title           is STRING

  -- Units
  member .units           is STRING
  member .textIncrement   is REAL
  member .offsetIncrement is REAL

exit
-- End of form definition for !!isoDimnDflts

------------------------------------------------------------------------
--
-- Method:        .isoDimnDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDimnDflts()

  -- Read the application units
  !appUnits             = object ISOUNITS()
  !this.units           = !appUnits.getUnits()
  !this.textIncrement   = !appUnits.getTextIncrement()
  !this.offsetIncrement = !appUnits.getOffsetIncrement()

  -- Pixmaps
  !this.cheiUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.cheiDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.offUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.offDo.addPixmap(!!pml.getPathName('downcounter.png'))

  -- Callbacks
  !this.chei.callback   = |!this.store(|
  !this.cheiUp.callback = |!this.upDown(!this.textIncrement,'UP',!this.chei)|
  !this.cheiDo.callback = |!this.upDown(!this.textIncrement,'DOWN',!this.chei)|
  !this.off.callback    = |!this.store(|
  !this.offUp.callback  = |!this.upDown(!this.offsetIncrement,'UP',!this.off)|
  !this.offDo.callback  = |!this.upDown(!this.offsetIncrement,'DOWN',!this.off)|
  !this.gap.callback    = |!this.store()|

  -- Type
  !text[1] = 'Hvac'
  !text[2] = 'Electrical'
  !this.type.dtext = !text
  !text[2] = 'Elec'
  !this.type.rtext = !text

  -- Dimension function
  !dtext[1] = |Each component|
  !dtext[2] = |Overall|
  !dtext[3] = |Each in Horiz Only|
  !dtext[4] = |Overall in Horiz Only|
  !rtext[1] = |ALL|
  !rtext[2] = |OVERALL|
  !rtext[3] = |ALLHORIZ|
  !rtext[4] = |OVERHORIZ|
  !this.function.dtext = !dtext
  !this.function.rtext = !rtext

  -- Pens
  do !count from 1 to 16
    !iconFile = 'colour' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
    !rtext[!count] = !count.string()
  enddo
  !this.tPen.dtext = !dtext
  !this.tPen.rtext = !rtext
  !this.lPen.dtext = !dtext
  !this.lPen.rtext = !rtext

  -- Thickness
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext[1] = !!pml.getPathName('linestylethin.png')
  !dtext[2] = !!pml.getPathName('linestylemedium.png')
  !dtext[3] = !!pml.getPathName('linestylethick.png')
  !rtext[1] = |Thin|
  !rtext[2] = |Medium|
  !rtext[3] = |Thick|
  !this.lThick.dtext = !dtext
  !this.lThick.rtext = !rtext

  -- Style
  !dtext     = ARRAY()
  !rtext     = ARRAY()
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|
  do !count from 1 to 10
    !iconFile = 'linestylethin' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.lStyle.dtext = !dtext
  !this.lStyle.rtext = !rtext

  -- Terminator
  !dtex[1] = (!!pml.getPathName('lter_none.png'))
  !dtex[2] = (!!pml.getPathName('lter_arr.png'))
  !dtex[3] = (!!pml.getPathName('lter_dot.png'))
  !dtex[4] = (!!pml.getPathName('lter_obl.png'))
  !rtex[1] = 'OFF'
  !rtex[2] = 'ARR'
  !rtex[3] = 'DOT'
  !rtex[4] = 'OBL'
  !this.term.dtext = !dtex
  !this.term.rtext = !rtex

  -- Set form member objects
  !this.hvacDimn = !!isoMain.isoAdpApp.data.hvacDimn
  !this.elecDimn = !!isoMain.isoAdpApp.data.elecDimn

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoDimnDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set form member objects
  !this.hvacDimn = !!isoMain.isoAdpApp.data.hvacDimn
  !this.elecDimn = !!isoMain.isoAdpApp.data.elecDimn

  -- Set gadget settings
  !this.selSet()

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!this.hvacDimn.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoDimnDflts.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save(!confirm is BOOLEAN)

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    if (!confirm) then
      !response = !!alert.confirm('Are you sure you wish to save the changes?')
      if (!response.eq('NO')) then
        return
      endif
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.hvacDimn = !this.hvacDimn
    !!isoMain.isoAdpApp.data.elecDimn = !this.elecDimn

    -- Save the settings to defaults file
    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric Dimension defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Hvac
    !array.append('-- Part 1 - Hvac')
    !array.append(!this.hvacDimn.function)
    !array.append(!this.hvacDimn.tColour.string())
    !array.append(!this.hvacDimn.chei.string(!!isoTextFormat))
    !array.append(!this.hvacDimn.lColour.string())
    !array.append(!this.hvacDimn.term)
    !array.append(!this.hvacDimn.offset.string(!!isoOffsetFormat))
    !array.append(!this.hvacDimn.relBore.string())
    !array.append(!this.hvacDimn.lStyle)
    !array.append(!this.hvacDimn.lThickness)

    -- Electrical
    !array.append('-- Part 2 - Electrical')
    !array.append(!this.elecDimn.function)
    !array.append(!this.elecDimn.tColour.string())
    !array.append(!this.elecDimn.chei.string(!!isoTextFormat))
    !array.append(!this.elecDimn.lColour.string())
    !array.append(!this.elecDimn.term)
    !array.append(!this.elecDimn.offset.string(!!isoOffsetFormat))
    !array.append(!this.elecDimn.relBore.string())
    !array.append(!this.elecDimn.lStyle)
    !array.append(!this.elecDimn.lThickness)
    !array.append(!this.elecDimn.gapAccuracy.string(!!isoOffsetFormat))

    -- Write to file
    !this.hvacDimn.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Initialise variables
  !gName = !this.type.selection() & 'Dimn'

  -- Dimension function
  !this.function.select('RTEXT',!this.$!gName$N.function)

  -- Set offset gadget
  !this.off.val = !this.$!gName$N.offset

  -- Select pens
  !this.tPen.val = !this.$!gName$N.tColour
  !this.lPen.val = !this.$!gName$N.lColour

  -- Set character height
  !this.chei.val = !this.$!gName$N.chei

  -- Set terminator
  !this.term.select('RTEXT',!this.$!gName$N.term)

  -- Set relative to bore
  !this.relBore.val = !this.$!gName$N.relBore

  -- Select the line thickness and style
  !this.lThick.select('RTEXT', !this.$!gName$N.lThickness)
  !this.lStyle.select('RTEXT', !this.$!gName$N.lStyle)


  -- Set gadgets depending on type
  -- HVAC
  if (!this.type.selection().eq('Hvac')) then
    !this.relBore.tag = 'Relative to Bore'
    !this.gap.visible = false

  -- CWAY
  else
    !this.relBore.tag = 'Relative to Width'
    !this.gap.visible = true

    -- Set the gap accuracy
    !this.gap.val = !this.$!gName$N.gapAccuracy

  endif

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setPen(GADGET)
--
-- Description: Set form frame pen values and stores in form object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setPen(!gadget is GADGET)

  -- Initialise variables
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|

  -- For thickness change the style values
  do !count from 1 to 10
    !iconFile = 'linestyle' & !gadget.selection().lowCase() & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.lStyle.dtext = !dtext
  !this.lStyle.rtext = !rtext

  -- Store change
  !this.store()

endmethod
-- End of method definition for .setPen(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Updates the form objects with the form values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Initialise variables
  !gName = !this.type.selection() & 'Dimn'

  -- Save settings to the object
  !this.$!gName$N.function   = !this.function.selection('RTEXT')
  !this.$!gName$N.tColour    = !this.tPen.selection().real()
  !this.$!gName$N.lColour    = !this.lPen.selection().real()
  !this.$!gName$N.chei       = !this.chei.val
  !this.$!gName$N.term       = !this.term.selection('RTEXT')
  !this.$!gName$N.offset     = !this.off.val
  !this.$!gName$N.relBore    = !this.relBore.val
  !this.$!gName$N.lThickness = !this.lThick.selection()
  !this.$!gName$N.lStyle     = !this.lStyle.selection()

  -- CWAY gap accuracy
  if (!this.type.selection().eq('Elec')) then
    !this.$!gName$N.gapAccuracy  = !this.gap.val

  endif

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:        .store(GADGET,STRING)
--
-- Description:   Store the chosen character height and XY offset
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!dummyObject is GADGET, !dummyAction is STRING)

  -- Initialise variables
  !gName = !this.type.selection() & 'Dimn'

  -- Save settings to the object
  !this.$!gName$N.chei   = !this.chei.val
  !this.$!gName$N.offset = !this.off.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise or Lower distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDown(!increment is REAL, !direction is STRING, !gadget is GADGET)

  -- Initialise variables
  !gName = !this.type.selection() & 'Dimn'

  -- Raise the value by the increment
  if (!direction.eq('UP')) then

    !nextValue = !gadget.val + !increment

  -- Reduce value by the increment
  else

    !nextValue = !gadget.val - !increment

  endif

  -- Test for zero or less
  if (!nextValue.leq(0)) then
   !nextValue = 0
  endif

  -- Set the gadget value
  !gadget.val = !nextValue

  -- Save settings to the object
  !this.$!gName$N.chei   = !this.chei.val.convertUnits(!this.units)
  !this.$!gName$N.offset = !this.off.val.convertUnits(!this.units)

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .upDown()
