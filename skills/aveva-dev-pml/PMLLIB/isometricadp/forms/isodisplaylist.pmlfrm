--
-- File:            isodisplaylist.pmlfrm
--   Type:          Form Definition
--   Group:         Isometric ADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Display default load errors
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel this form
--  load(STRING,ARRAY)               -                   Load the passed data into this form
--
------------------------------------------------------------------------
setup form !!isoDisplayList

  !this.formTitle = ' '
  !this.cancelCall = '!this.cancel()'

  list .list at xmin ymin multi width 60 length 20

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .load(STRING,ARRAY)
--
-- Description: Load the passed data into this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load(!string is STRING, !array is ARRAY)

  !this.formTitle  = !string
  !this.list.dtext = !array

endmethod
-- End of method definition for .load(STRING,ARRAY)

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  hide !!displayList

endmethod
-- End of method definition for .cancel()
