--
-- File:            isodrwgnodflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the default parameters for the symbols
-- used to indicate the isometric origin point
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  isoDrwgNoDflts()                 -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save()                           -                   Saves the form settings
--  selSet()                         -                   Set and select gadget values
--  setActive(BOOLEAN)               -                   Set gadget active status
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  store()                          -                   Store the modified gadget values
--
------------------------------------------------------------------------
setup form !!isoDrwgNoDflts

  !this.formTitle = 'Isometric Drawing Number Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-DRWGNO| width 40 lines 1

  para .nseqP  at x1 ymax text 'Use a Name Sequence Database' width 22
  toggle .useNseq at xmax ymin


  frame .symb 'Name Settings' at x0 ymax+0.1

    option .type     'Drawing Type' at xmin+1 ymax-0.1 width 10

    text .prefix     'Prefix'       at xmin   ymax+0.2 width 30 scroll 90 STRING

    text .suffix     'Suffix'       at xmin   ymax+0.2 width 30 scroll 90 STRING

    text .separator  'Separator Characters' tagwidth 15 at xmin ymax+0.2 width 10 STRING

    text .startIndex 'Starting Index Number' tagwidth 15 at xmin ymax+0.2 width 10 STRING

  exit

  button .save  'Save'  at x0.2           ymax+0.5
  button .reset 'Reset' at xmax_Save+5    ymin_Save
  button .close 'Close' at xmax form-size ymin_Save

  -- Members
  member .modified      is BOOLEAN
  member .elecSettings  is ARRAY
  member .hvacSettings  is ARRAY
  member .title         is STRING
  member .libraryFont   is REAL

exit
-- End of form definition for !!isoDrwgNoDflts

------------------------------------------------------------------------
--
-- Method:        .isoDrwgNoDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDrwgNoDflts()

  -- Callbacks
  !this.useNseq.callback    = |!this.setActive(!this.useNseq.val)|
  !this.type.callback       = |!this.selSet()|
  !this.prefix.callback     = |!this.store()|
  !this.suffix.callback     = |!this.store()|
  !this.separator.callback  = |!this.store()|
  !this.startIndex.callback = |!this.store()|
  !this.save.callback       = |!this.save()|
  !this.reset.callback      = |!this.reset()|
  !this.close.callback      = |!this.close()|

  -- Type
  !dtext[1]        = 'Hvac'
  !dtext[2]        = 'Electrical'
  !rtext[1]        = 'HVAC'
  !rtext[2]        = 'ELEC'
  !this.type.dtext = !dtext
  !this.type.rtext = !rtext

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoDrwgNoDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Get the defaults
  !defaults = !!isoMain.isoAdpApp.data.drwgNoDflts

  -- Set form member objects
  !this.hvacSettings = !defaults.getHvacSettings()
  !this.elecSettings = !defaults.getElecSettings()

  -- Get and store the current backing sheet font
  !this.libraryFont = !!isoMain.isoAdpApp.data.backingSheet.font

  -- Set gadget settings
  !this.selSet()

  -- Set gadgets active depending on the first default setting to use nseq
  !this.setActive(!this.elecSettings[1])

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!defaults.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: Saves the form settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save()

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    !response = !!alert.confirm('Are you sure you wish to save the changes?')
    if (!response.eq('NO')) then
      return
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.drwgNoDflts.saveSettings('ELEC', !this.elecSettings)
    !!isoMain.isoAdpApp.data.drwgNoDflts.saveSettings('HVAC', !this.hvacSettings)

    -- Save the settings to file
    !!isoMain.isoAdpApp.data.drwgNoDflts.saveToFile()

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save()

-----------------------------------------------------------------------
--
-- Method:      .setActive(BOOLEAN)
--
-- Description: Set gadget active status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setActive(!active is BOOLEAN)

  -- Set gadgets active
  if (!active) then

    !this.type.active       = true
    !this.prefix.active     = true
    !this.suffix.active     = true
    !this.separator.active  = true
    !this.startIndex.active = true

  -- Set gadgets inactive
  else

    !this.type.active       = false
    !this.prefix.active     = false
    !this.suffix.active     = false
    !this.separator.active  = false
    !this.startIndex.active = false

  endif

  -- Store the modified value
  !this.elecSettings[1] = !active
  !this.hvacSettings[1] = !active

  -- Set form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .setActive(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Set gadgets to the defaults settings depending on type
  -- CWAY
  if (!this.type.selection('RTEXT').eq('ELEC')) then

    -- Test for 11.6 version
    if (!this.libraryFont.lt(5)) then

      -- Irrespective of the defaults settings, use the file based method
      !this.useNseq.val  = false

    -- Use the default setting
    else
      !this.useNseq.val  = !this.elecSettings[1]

    endif

    !this.prefix.val     = !this.elecSettings[2]
    !this.suffix.val     = !this.elecSettings[3]
    !this.startIndex.val = !this.elecSettings[4]
    !this.separator.val  = !this.elecSettings[5].replace(' ','space')

  -- HVAC
  else

    -- Test for 11.6 version
    if (!this.libraryFont.lt(5)) then

      -- Irrespective of the defaults settings, use the file based method
      !this.useNseq.val  = false

    -- Use the default setting
    else
      !this.useNseq.val  = !this.hvacSettings[1]

    endif

    !this.prefix.val     = !this.hvacSettings[2]
    !this.suffix.val     = !this.hvacSettings[3]
    !this.startIndex.val = !this.hvacSettings[4]
    !this.separator.val  = !this.hvacSettings[5].replace(' ','space')

  endif

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Check modified status and set gadgets accordingly
  if (!modified) then

    -- Set form title
    !this.formTitle = !this.title & ' *'

    -- Set close button to read cancel
    !this.close.tag = 'Cancel'

    -- Set the save and reset buttons active
    !this.save.active  = true
    !this.reset.active = true

  else

    -- Set form title
    !this.formTitle = !this.title

    -- Set close button to read close
    !this.close.tag = 'Close'

    -- Set the save and reset buttons inactive
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .store()
--
-- Description:   Store the modified gadget values
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store()

  -- Store the settings in the relevant form member array
  if (!this.type.selection('RTEXT').eq('ELEC')) then

    !this.elecSettings[1] = !this.useNseq.val
    !this.elecSettings[2] = !this.prefix.val
    !this.elecSettings[3] = !this.suffix.val
    !this.elecSettings[4] = !this.startIndex.val
    !this.elecSettings[5] = !this.separator.val.replace(' ','space')

  else

    !this.hvacSettings[1] = !this.useNseq.val
    !this.hvacSettings[2] = !this.prefix.val
    !this.hvacSettings[3] = !this.suffix.val
    !this.hvacSettings[4] = !this.startIndex.val
    !this.hvacSettings[5] = !this.separator.val.replace(' ','space')

  endif

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)
