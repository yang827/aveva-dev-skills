-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            isoedit.pmlfrm
--   Type:          Form Definition
--   Group:         isoAdp
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Drawing browser and edit tools
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browser(GADGET)                  -                   Show standard browser for PDF output
--  callRev()                        -                   Call the revision form
--  cancel()                         -                   Cancel this form
--  changeDir()                      -                   Change the current sheet view direction
--  checkModified()                  BOOLEAN             Check if the current drawing has been modified
--  checkWrite(STRING)               -                   Check if the current drawing is writable
--  deleteCE()                       -                   Delete the current element
--  dimensions(BOOLEAN)              -                   Change the dimension style
--  displayLog(STRING)               -                   Display the a log file
--  drwgDisplay(STRING)              -                   Display a drawing
--  getDimnStyle()                   -                   Get the currently used dimension style
--  getDoff()                        -                   Get the currently used dimension offset
--  hiddenLine()                     -                   Update the design graphics
--  init()                           -                   This form initialisation
--  isoEdit()                        -                   Constructor method
--  layerSet()                       -                   Set the layer gadgets
--  layerVis()                       -                   Set layer visibility gadgets
--  load()                           -                   Load
--  modify()                         -                   Access modify mode
--  modifyDoff(GADGET,STRING)        -                   Modify the offset of all dimensions as a group
--  moveDT()                         -                   Move the dimension text
--  moveStdPattern()                 -                   Set the terminator style
--  nudgeScale(STRING)               -                   Nudge the main view scale and update the annotation
--  pPoint()                         -                   Change the ppoint used
--  pdfAll()                         -                   Create PDF for all isometrics
--  print()                          -                   Print the current sheet
--  search()                         -                   Search for drawings
--  selectDrwg()                     -                   Select a drawing
--  selectShee()                     -                   Select a sheet
--  setNudgeFactor(REAL)             -                   Set the nudge scale factor
--  setStatus()                      -                   Set the current sheet status
--  setedit(BOOLEAN)                 -                   Set the edit tools active mode
--  setsnapValue(REAL)               -                   Set the snap grid value
--  spacing()                        -                   Set the grid spacing
--  submitToPdf(DBREF,STRING)        -                   Create PDF output for the displayed sheet
--  terminator()                     -                   Set the terminator style
--  toggleSnap()                     -                   Set the snap gadgets
--  togglevgrid()                    -                   Set the grid on and off
--
------------------------------------------------------------------------
setup form !!isoEdit RESIZ

  !this.formTitle  = 'Edit Isometrics'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  -- Search
  frame .searchFrame |Search| at x0 ymin

    text   .searchString  at          ymin+0.8 tooltip 'Search String' width 23 STRING
    option .searchOptions at xmin     ymax+0.2 width 16
    button .go |Go|       at xmax+0.7 ymin     tooltip 'Make search'

  exit

  -- Drawing list
  frame .listFrame |Drawings| at xmin ymax+0.1

    list .drwgs single width 22 length 12
    list .shts at xmin ymax+0.3 single width 22 length 19

  exit

  -- Standard tools
  -- Getwork
  button .getWork  at xmax+1 ymax.searchFrame+2 tooltip 'Get Work' pixmap width 16 height 16

  -- Savework
  button .saveWork at xmin ymax+0.3 tooltip 'Save Work' pixmap width 16 height 16

  -- Delete CE
  button .deleteCE at xmin ymax+0.3 tooltip 'Delete CE' pixmap width 16 height 16

  -- View control buttons
  button .autoCe     at xmin ymax+0.5        tooltip 'Reset Limits' pixmap width 16 height 16
  button .modifyItem at xmin ymax+0.3 toggle tooltip 'Modify Mode'  pixmap width 16 height 16
  button .snap       at xmin ymax+0.3 toggle tooltip 'SNAP to grid' pixmap width 16 height 16
  button .vgrid      at xmin ymax+0.3 toggle tooltip 'Display grid' pixmap width 16 height 16

  -- Print
  button .print   at xmin ymax+0.5 tooltip 'Print this Isometric' pixmap width 16 height 16

  -- Pdf
  button .pdf     at xmin ymax+0.3 tooltip 'PDF this Isometric' pixmap width 16 height 16

  -- Log File
  button .showLog at xmin ymax+0.5 tooltip 'Display Log' pixmap width 16 height 16

  -- Edit tools
  frame .edittools |Edit Tools| at xmax.searchFrame+1 ymin.searchFrame

    -- Isometric directions
    option .dir at xmin+1 ymin+1.2 tooltip 'Isometric Direction'  pixmap width 16 height 16

    -- Layer visibility
    option .layers     at xmax+1   ymin width 15
    toggle .layerOnOff at          ymin tooltip 'Switch Visibility'

    -- Edit buttons
    button .setPP         at xmax+2   ymin tooltip 'Move Connection Point' pixmap width 16 height 16
    option .term          at xmax+1   ymin.layers pixmap width 16 height 16
    toggle .loop |Loop|   at xmax+0.6 ymin-0.5
    toggle .layer |Layer| at xmin     ymax

    -- Nudge View Scale
    button .nudgeUp   at xmax-0.5 ymin.loop+0.5 tooltip 'Nudge Scale Up'   pixmap width 16 height 11
    button .nudgeDown at xmin     ymax          tooltip 'Nudge Scale Down' pixmap width 16 height 11

    -- Dimensions
    button .cyDimn  at xmax+1.5 ymin.layers tooltip 'Cycle Dimension Style' pixmap width 16 height 16

    if (!!isImperialLength('DIST')) then
      numeric .doffset  'Offset' tagwidth 5 tooltip 'Change Dimensions Offset' at xmax+1 ymin range 0 12  step 0.1 ndp 1 width 3

    else
      numeric .doffset  'Offset' tagwidth 5 tooltip 'Change Dimensions Offset' at xmax+1 ymin range 0 300 step 1   ndp 0 width 3

    endif

    -- Standard Pattern
    button .moveStanPat at xmax+1.5 tooltip 'Move Standard Pattern' pixmap width 16 height 16

    -- Hidden Line
    button .hidden  at xmax+1.5 ymin tooltip 'Switch Hidden Line' pixmap width 16 height 16

    -- Revision
    button .revi    at xmax+1 ymin tooltip 'Revision' pixmap width 16 height 16

    -- Status
    option .status |Status| tagwidth 5 at xmax+1 ymin.term width 10

  exit

  -- Prompt
  para .pickPrompt at xmax.listFrame+1 ymin.searchString+2.3 text |Navigate| width 45 lines 1

  -- Readout
  para .readout    at xmax+1 ymin width 28 lines 1
  para .dimnStyle  at xmax+1 ymin width 12 lines 1
  para .snapStatus at xmax+1 ymin width 10 lines 1

  -- Sheet viewer
  view .feedback at xmax.listFrame+4 ymax PROMPT .pickPrompt AREA

    height 22 aspect 1.414
    setcolour 10

    -- set inmodes
    INMODE CREATE _pickItem  TYPE 'PICKITEM'
    INMODE CREATE _editItem  TYPE 'EDITITEM'
    INMODE CREATE _pickPoint TYPE 'PICKPOINT'
    INMODE CREATE _editPoint TYPE 'EDITPOINT'

  exit

  -- Pop-up menus
  menu .barPopup
    add |Refresh|            |REFRESH !!isoEdit.feedback|
    add |Reset Limits|       |!this.feedback.limits = !this.limits|
    add sep
    add |Highlight CE|       |HIGHLIGHT CE IN !!isoEdit.feedback|
    add separator
    add |Colour Settings|    menu .colSettings
    add separator
    add |Snap Spacing|       menu .snapSettings
  exit

  menu .colSettings
    add |Background Colour...| |!!appDraSetBackground(!!isoEdit.feedback,true)|
    add |Highlight Colour...|  |!!draCallSettings('ENHANCE')|
    add |Feedback Colour...|   |!!draCallSettings('FEEDBACK')|
  exit

  menu .snapSettings
    if (!!distanceFmt.units.upcase().match('MM').neq(0)) then
      add |1| |!this.setsnapValue(1)|
      add |5| |!this.setsnapValue(5)|
      add |10| |!this.setsnapValue(10)|
      add |20| |!this.setsnapValue(20)|
      add |50| |!this.setsnapValue(50)|
    else

    endif
  exit

  menu .drwgPopup
    add |Display|  menu .drwgOptions
    add |PDF All Sheets| |!this.pdfAll()|
  exit

  menu .drwgOptions
    add |Draft Name| |!this.drwgDisplay('PDMS')|
    add |Drwg Number| |!this.drwgDisplay('DRWG')|
    add |Line Number| |!this.drwgDisplay('LINE')|
  exit

  -- Added for 11.3 ModifyMode
  -- if text of these menu items changes, must change DRA_eventHandler too
  menu _modifyPopup
    add 'Refresh'                  |REFRESH !!isoEdit.feedback|
    add 'Reset Limits'             |!this.feedback.limits = !this.limits|
    add sep
    add '2D cursor hit'     toggle |!!isoSet2dMode(!!isoEdit,1)| selected
    add 'End Point of'      toggle |!!isoSet2dMode(!!isoEdit,2)|
    add 'Mid Point of'      toggle |!!isoSet2dMode(!!isoEdit,4)|
    add 'Centre Point of'   toggle |!!isoSet2dMode(!!isoEdit,3)|
    add 'Intersect at'      toggle |!!isoSet2dMode(!!isoEdit,6)|
    add 'Intersect between' toggle |!!isoSet2dMode(!!isoEdit,7)|
    add 'Nearest to'        toggle |!!isoSet2dMode(!!isoEdit,8)|
    add sep
    add 'Crosshair cursor' toggle  | |
    add sep
    add 'Text Angle'               menu _TEXTANGLES
    add 'Delete Point'             | |
    add 'Insert After'             | |
    add sep
    add 'Colour Settings'          menu _SETTINGS
  exit

  menu _textAngles
    add 'Standard'     toggle   | |
    add 'Horizontal'   toggle   | |
    add 'Vertical'     toggle   | |
  exit

  menu _settings
    add |Background Colour...| |!!colourSelectLoad('!!isoEdit.feedback.background = !!colourSelectGet()', 'Background Colour', !this.feedback.background)|
    add |Highlight Colour...|  |!!colourSelectLoad('!!isoEdit.feedback.highlight = !!colourSelectGet()', 'Highlight Colour', !this.feedback.highlight)|
    add |Feedback Colour...|  form  _CDRRBANDCOL
  exit

  -- Members
  member .allOptions   is ARRAY
  member .currShee     is DBREF
  member .limits       is ARRAY
  member .snapValue    is REAL
  member .currElem     is DBREF
  member .selected     is ARRAY
  member .readWrite    is BOOLEAN
  member .origCol      is REAL
  member .dimeLayer    is DBREF
  member .origScale    is REAL
  member .nudgeFactor  is REAL

  member .module       is ISOMODULE

  -- Pdf output
  member .pdfFolder    is FILE

  -- Main form tracking
  member .mainTracking is BOOLEAN
  member .tracking     is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .isoEdit()
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoEdit()

  -- Pixmaps
  !this.getWork.addPixmap(!!pml.getPathName('getwork16.png'))
  !this.saveWork.addPixmap(!!pml.getPathName('savework16.png'))
  !this.deleteCE.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.autoCe.addPixmap(!!pml.getPathName('autoce16.png'))
  !this.snap.addPixmap(!!pml.getPathName('isosnapon16.png'))
  !this.vgrid.addPixmap(!!pml.getPathName('isogridon16.png'))
  !this.modifyItem.addPixmap(!!pml.getPathName('editmodel16.png'))
  !this.setPP.addPixmap(!!pml.getPathName('ppoint.png'))
  !this.print.addPixmap(!!pml.getPathName('printer_small.png'))
  !this.cyDimn.addPixmap(!!pml.getPathName('dimn.png'))
  !this.moveStanPat.addPixmap(!!pml.getPathName('move.png'))
  !this.hidden.addPixmap(!!pml.getPathName('hidden.png'))
  !this.revi.addPixmap(!!pml.getPathName('revision.png'))
  !this.showLog.addPixmap(!!pml.getPathName('ad_t_009.png'))
  !this.pdf.addPixmap(!!pml.getPathName('pdf.png'))
  !this.nudgeUp.addPixmap(!!pml.getPathName('nudge_up.png'))
  !this.nudgeDown.addPixmap(!!pml.getPathName('nudge_down.png'))

  -- Callbacks
  !this.go.callback          = |!this.search()|
  !this.drwgs.callback       = |!this.selectDrwg()|
  !this.shts.callback        = |!this.selectShee()|
  !this.getWork.callback     = |GETWORK|
  !this.saveWork.callback    = |CALLG MSAVEW|
  !this.deleteCE.callback    = |!this.checkWrite('!this.deleteCE()')|
  !this.dir.callback         = |!this.checkWrite('!this.changeDir()')|
  !this.layers.callback      = |!this.layerVis()|
  !this.layerOnOff.callback  = |!this.checkWrite('!this.layerSet()')|
  !this.autoCe.callback      = |!this.feedback.limits = !this.limits|
  !this.snap.callback        = |!this.toggleSnap()|
  !this.vgrid.callback       = |!this.togglevgrid()|
  !this.modifyItem.callback  = |!this.checkWrite('!!setModifyMode(!!isoEdit.feedback)')|
  !this.setPP.callback       = |!this.checkWrite('!this.pPoint()')|
  !this.term.callback        = |!this.checkWrite('!this.terminator()')|
  !this.nudgeUp.callback     = |!this.nudgeScale('UP')|
  !this.nudgeDown.callback   = |!this.nudgeScale('DOWN')|
  !this.cyDimn.callback      = |!this.checkWrite('!this.dimensions(true)')|
  !this.moveStanPat.callback = |!this.moveStdPattern()|
  !this.doffset.callback     = |!this.modifyDoff(|
  !this.hidden.callback      = |!this.checkWrite('!this.hiddenLine()')|
  !this.revi.callback        = |!this.checkWrite('!this.callRev()')|
  !this.print.callback       = |!this.print()|
  !this.pdf.callback         = |!this.browser(!this.pdf)|
  !this.showLog.callback     = |!this.displayLog('OPEN')|
  !this.status.callback      = |!this.checkWrite('!this.setStatus()')|

  -- Grid spacing pop-up menu
  !this.newMenu('spacing')
  !this.spacing.add('callback', 'Spacing...', '!this.spacing()')
  !this.vgrid.setPopup(!this.spacing)

  -- Set nudge scale pop-up menu
  !this.newMenu('percent')
  !this.percent.add('toggle', '1%', '!this.setNudgeFactor(0.01)', 'one')
  !this.percent.add('toggle', '2%', '!this.setNudgeFactor(0.02)', 'two')
  !this.percent.add('toggle', '5%', '!this.setNudgeFactor(0.05)', 'five')
  !this.percent.add('toggle', '10%', '!this.setNudgeFactor(0.1)', 'ten')
  !this.newMenu('factor')
  !this.factor.add('menu', 'Factor...', 'percent')
  !this.nudgeUp.setPopup(!this.factor)
  !this.nudgeDown.setPopup(!this.factor)

  -- Direction option
  if (!this.module.description.eq('DRAFT')) then
    !dtex[1] = (!!pml.getPathName('iso1_small.png'))
    !dtex[2] = (!!pml.getPathName('iso2_small.png'))
    !dtex[3] = (!!pml.getPathName('iso3_small.png'))
    !dtex[4] = (!!pml.getPathName('iso4_small.png'))
  else
    !dtex[1] = (!!pml.getPathName('iso1_small_mar.png'))
    !dtex[2] = (!!pml.getPathName('iso2_small_mar.png'))
    !dtex[3] = (!!pml.getPathName('iso3_small_mar.png'))
    !dtex[4] = (!!pml.getPathName('iso4_small_mar.png'))
  endif
  !rtex[1] = 'iso1'
  !rtex[2] = 'iso2'
  !rtex[3] = 'iso3'
  !rtex[4] = 'iso4'
  !this.dir.dtext = !dtex
  !this.dir.rtext = !rtex

  -- Terminator option
  !dtex[1] = (!!pml.getPathName('lter_none.png'))
  !dtex[2] = (!!pml.getPathName('lter_arr.png'))
  !dtex[3] = (!!pml.getPathName('lter_dot.png'))
  !dtex[4] = (!!pml.getPathName('lter_obl.png'))
  !rtex[1] = 'OFF'
  !rtex[2] = 'ARR'
  !rtex[3] = 'DOT'
  !rtex[4] = 'OBL'
  !this.term.dtext = !dtex
  !this.term.rtext = !rtex

  --Set Defaults for Modes
   !this.feedback.pickItem.cursor  = 'Pointer'
   !this.feedback.pickItem.prompt  = 'MODIFY MODE: Pick Item & Drag'
   !this.feedback.editItem.cursor  = 'Pointer'
   !this.feedback.editItem.prompt  = 'MODIFY MODE: Pick & Drag Highlighted Item or Pick New Item'

   !this.feedback.pickPoint.cursor = 'Pick_Cursor'
   !this.feedback.pickPoint.prompt = 'DEFINE SECTION PLANE: Pick Point '
   !this.feedback.editPoint.cursor = 'LeftArrow'
   !this.feedback.editPoint.prompt = 'EDIT SECTION PLANE: Pick/Move Hot Spot '

  -- Set pop-up menus
  !this.feedback.setPopup(!this.barPopup)
  !this.drwgs.setPopup(!this.drwgPopup)

  -- Set the default location for pdf output
  !this.pdfFolder = object FILE('%PDMSUSER%\PdfFiles')

  -- Allow the main form to control the tracking
  !this.tracking = true

  -- Set the doffset gadget to accept modified events
  !this.doffset.modifiedEvents = true

endmethod
-- End of method definition for .isoEdit()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: This form initialisation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set up a global command to stop resize warnings
  WARNINGS OFF

  -- Read search options file
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-SEARCH')
  if (!file.exists()) then

    -- Get defaults
    !contents = !file.readFile()
    !data     = !contents.from(!contents.findFirst('-- Display text; Element Type; Element Attribute'))

    -- Split found data and build the objects to hold that data
    do !count from 2 to !data.size()

      !this.allOptions[!count] = object ISOSEARCH(!data[!count])
      !dtext[!count]           = !this.allOptions[!count].desc
      !rtext[!count]           = !count.string()

    enddo

  else

    !count = 1
    !!alert.error('Loading error! The defaults file DRA-ISO-SEARCH does not exist. Please contact your System Administrator')

  endif

  -- Set first option for ALL drawings search
  !firstOption        = 'All Drwgs;DRWG;REFE'
  !this.allOptions[1] = object ISOSEARCH(!firstOption)

  -- Set last option for Status search
  !lastOption = 'Status;SHEE;:IdpIsoStatus'
  !this.allOptions[!count + 1] = object ISOSEARCH(!lastOption)

  -- Set search option gadget
  !dtext[1]                 = 'All Drwgs'
  !rtext[1]                 = '1'
  !dtext[!count + 1]        = 'Status'
  !rtext[!count + 1]        = string(!count + 1)
  !this.searchOptions.dtext = !dtext
  !this.searchOptions.rtext = !rtext

  -- Read status options file
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-STATUS')
  if (!file.exists()) then

    !contents = !file.readFile()
    !text = !contents.from(!contents.findFirst('-- Status settings') + 1)

    -- Add a deleted option
    !text.append('Deleted')

  else

    !text[1] = 'Unchecked'
    !text[2] = 'Checked'
    !text[3] = 'Approved'
    !text[4] = 'Deleted'
    !!alert.error('Loading error! The defaults file DRA-ISO-STATUS does not exist. Please contact your System Administrator')

  endif

  -- Set status options gadget
  !this.status.dtext = !text
  !this.status.rtext = !text

  -- Check for previously shown drawings
  if (!this.drwgs.val.eq(0)) then

     !this.setedit(FALSE)

    if (!this.drwgs.dtext.size().gt(0)) then
      !this.drwgs.val = 1
      !this.selectDrwg()

    else
      !this.drwgs.clear()
      !this.shts.clear()

    endif

  else
    !this.selectDrwg()

  endif

  -- Set default snap grid
  if (!!distanceFmt.units.upcase().match('MM').neq(0)) then
    !this.snapValue = 10mm
  else
    !this.snapValue = 0.4in
  endif

  -- Set readouts
  !this.readout.val = '          '
  !this.snapStatus.val = 'Snap: Off'

  -- Check that the colour palette is available
  if (undefined(!!colourSelect)) then
    pml load form !!colourSelect
  endif

  -- Set the pens for the white canvas background after storing the current colour
  !this.origCol = !!colourSelectGet()
  !!colourSelect(306)
  !!appDraSetBackground(!!isoEdit.feedback, false)

  -- Take control of the tracking
  if (!!isomain.shown()) then

    -- Do not allow the main form to control tracking
    !this.tracking = false

    -- Remember the main form tracking status
    !this.mainTracking = !!isomain.trackElement

    -- Set the tracking off
    !!isomain.setTracking(false)

  endif

  -- Check whether revisions are being used
  if (!!isomain.isoAdpApp.data.isoContent.revi.not()) then

    -- Deactivate the revision option
    !this.revi.active = false

  else
    !this.revi.active = true

  endif

  -- Check whether the standard pattern is used
  if (!!isomain.isoAdpApp.data.isoContent.stanPat.not()) then

     -- Deactivate the revision option
    !this.moveStanPat.visible = false

  else
    !this.moveStanPat.visible = true

  endif

  -- Set starting nudge factor
  !this.nudgeFactor = 0.01
  !this.percent.setFieldProperty('one','selected',true)

endmethod
-- End of method definition for .init()
-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser for PDF output
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!dummyGadget is GADGET)

  import 'PMLFILEBROWSER'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise browser variables
  !directory       = !this.pdfFolder.directory().fullName() & '\' & !this.pdfFolder.entry()
  if !this.pdfFolder.exists().not() then
    !!isomain.createFolder(!directory)
  endif

  !title           = 'Save Drawing as PDF'
  !extensionString = 'pdf files (*.pdf)|*.pdf'
  !browser         = object PMLFILEBROWSER('SAVE')
  !seedFile        = !this.currShee.flnn.replace('\','_').replace('/','_').replace('.','_') & '_' & !!isoDateStamp() & '.pdf'

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Output file as an object
    !outputFile = object FILE(!browser.file())

    -- Save the chosen output folder
    !this.pdfFolder = !outputFile.directory()

    -- Build output file name
    !pdfPathName = !outputFile.directory() & '\' & !outputFile.entry()

    -- Write the output file
    !this.submitToPdf(!this.currShee, !pdfPathName)

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pdfAll
--
-- Description: Create PDF for all isometrics
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pdfAll()

  !drwg = !this.drwgs.string()
  -- exit silently if there is no DRWG
  if !drwg.eq('NONE').or(!drwg.empty()) then
    return
  endif

  !isoprint = !!fmsys.loadform('isoprint')
  !isoprint.show()
  !isoprint.search()
  !index = !isoprint.list.rtext.findFirst(!drwg)
  !isoprint.list.val = !index
  !isoprint.select(!isoprint.list,'STOP')
  !isoprint.select('CE')
  !isoprint.list.setFocus()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .search()
--
-- Description: Search for drawings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .search()

  -- Read search criteria
  !unusedSearchString  = !this.searchString
  !unusedSearchOptions = !this.searchOptions

  -- Get all drawings
  VAR !allDrawings SPLIT TSEARCH spPurp isoAdp DRWG

  -- Have any drawings been found
  if (undefined(!allDrawings[1])) then

    !dtext[1]         = '- None Found -'
    !rtext[1]         = 'NONE'
    !this.drwgs.dtext = !dtext
    !this.drwgs.rtext = !rtext

    !this.shts.clear()

    return

  endif

  -- Reduce list by options
  if (!this.searchOptions.val.neq(1)) then
    !index                        = !this.searchOptions.selection().real()
    !this.allOptions[!index].rule = !this.searchString.val
    !allDrwgs                     = !!isoSearch(!allDrawings, !this.allOptions[!index])

  else

    !this.searchString.clear()
    !allDrwgs = ARRAY()

    do !drwg val !allDrawings
      !allDrwgs.append(object ISODISPLAYDRWG(!drwg.dbref()))
    enddo

  endif

  -- Test for none found
  if (not defined(!allDrwgs) or !allDrwgs.empty()) then

    !dtext[1] = '- None Found -'
    !rtext[1] = 'NONE'
    !this.drwgs.dtext = !dtext
    !this.drwgs.rtext = !rtext
    !this.shts.clear()
    return

  endif

  -- Display the found drawings
  !this.selected = !allDrwgs
  !this.load()

endmethod
-- End of method definition for .search()

------------------------------------------------------------------------
--
-- Method:      .load()
--
-- Description: Load
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load()

  -- Initialise variables
  !drwgsName = ARRAY()
  !drwgsRefe = ARRAY()

  -- Get drawing data
  do !value val !this.selected
    !drwgsName.append(!value.drwgRefe.flnn)
    !drwgsRefe.append(!value.drwgRefe.string())
  enddo

  -- Populate drawing list gadget
  !this.drwgs.dtext = !drwgsName
  !this.drwgs.rtext = !drwgsRefe

  -- Populate sheet list gadget
  !this.selectDrwg()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      .drwgDisplay(STRING)
--
-- Description: Display a drawing
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drwgDisplay(!word is STRING)

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Build arrays
  do !drwgObj val !this.selected

    -- Dtext
    if (!word.eq('PDMS')) then
      !dtext.append(!drwgObj.drwgName)

    elseif (!word.eq('DRWG')) then
      !dtext.append(!drwgObj.drwgNumb)

    else
      !dtext.append(!drwgObj.drwgLine)

    endif

    -- Rtext
    !rtext.append(!drwgObj.drwgRefe.string())

  enddo

  -- Populate the list gadget
  !this.drwgs.dtext = !dtext
  !this.drwgs.rtext = !rtext

endmethod
-- End of method definition for .drwgDisplay(STRING)

------------------------------------------------------------------------
--
-- Method:      .selectDrwg()
--
-- Description: Select a drawing
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectDrwg()

  -- Initialise variables
  !drwg     = !this.drwgs.selection('RTEXT')
  !index    = !this.drwgs.val
  !shtsDesc = ARRAY()

  -- Test for NONE
  if (!drwg.eq('NONE')) then
    return
  endif

  -- Test for Undefined
  !current = !!ce
  !!ce     = !drwg.dbref()
    handle any
      return
    elsehandle none
      !!ce = !current
    endhandle

  -- Get owned sheets for selected drawing if not already found by the search tool
  if (!this.selected[!index].sheets.empty()) then

    VAR !shtsRefe COLL ALL SHEE FOR $!drwg
      handle(2,107)
        !shtsRefe = !this.selected[!index].sheets
      endhandle

  else
    !shtsRefe = !this.selected[!index].sheets
  endif

  -- Test for none found
  if (!shtsRefe.empty()) then

    !shtsNumb[1] = '0'
    !shtsOff[1]  = '0'
    !shtsDesc[1] = '- None Found -'
    !shtsRefe[1] = 'NONE'

  else

    -- Get sheet data
    VAR !shtsNumb EVAL :IdpSheetNo FOR ALL FROM !shtsRefe
    VAR !shtsOff EVAL :IdpNumberOff FOR ALL FROM !shtsRefe
    do !index ind !shtsRefe
      !shtsDesc.append('Sheet ' & !shtsNumb[!index] & ' of ' & !shtsOff[!index])
    enddo

  endif

  -- Populate sheet list gadget
  !this.shts.clear()
  !this.shts.dtext = !shtsDesc
  !this.shts.rtext = !shtsRefe

  -- Show selected sheet
  !this.selectShee()

endmethod
-- End of method definition for .selectDrwg()

------------------------------------------------------------------------
--
-- Method:      .selectShee()
--
-- Description: Select a sheet
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectShee()

  -- Test for a selected sheet
  if (!this.shts.selection('RTEXT').eq('')) then
    !this.shts.val = 1
  endif

  -- Get the selected sheet
  !sheeRefe = !this.shts.selection('RTEXT').dbref()

  -- Do nothing if the selected sheet is already loaded
  if (!sheeRefe.eq(!this.currShee)) then
    return

  endif

  -- For a previously selected sheet
  if (!this.currShee.badref().not()) then

    -- Check for the last accessed sheet being modified
    -- Prompt to savework
    if (!this.checkModified()) then
      !answer = !!alert.question('The currently displayed sheet has been modified. Do you want to savework before you leave it?')

      if (!answer.eq('YES')) then
        SAVEWORK

      elseif (!answer.eq('CANCEL')) then

        -- Select the previously selected and stop
        !this.shts.select('RTEXT',!this.currShee.string())
        return

      endif

    endif

  endif

  -- Display the selected sheet
  !this.module.displaySheet(!this.feedback, !sheeRefe)

  -- Mark editing status
  !this.setedit(true)

  -- Set the form limits for reset limits option
  !this.limits = !!isoEdit.feedback.limits

  -- Access the relevant sheet
  !!ce = !sheeRefe

  -- Get the main view  -- Get the main view
  VAR !view COLL ALL VIEW  WI SPPURP EQ 'MAINVW' FOR CE
  !viewRefe = !view[1].dbref()

  --Modified as you cannot assign to left hand side at 11.3. 20/11/02
  -- Check read-write access
  if (DBWRITE) then
    !this.readWrite = true
    !this.readout.val = '                '

  else
    !this.readWrite = false
    !this.readout.val = 'THIS DRAWING IS READ ONLY'

  endif

  -- Set snap & vgrid off
  SNAP OFF
  vgrid OFF

  -- Get main view direction
  VAR !vDir EVAL DIR FOR $!viewRefe

  if (!vDir.empty()) then
    !!alert.error('Invalid or corrupt sheet selected. If it is not obvious why, please contact your Administrator.')
    return
  endif

  if (!vDir[1].eq('W 45 S 35.2644 D')) then
    !this.dir.val = 1

  elseif (!vDir[1].eq('W 45 N 35.2644 D')) then
    !this.dir.val = 2

  elseif (!vDir[1].eq('E 45 N 35.2644 D')) then
    !this.dir.val = 3

  else
    !this.dir.val = 4

  endif

  -- Store the main view scale
  !this.origScale = !viewRefe.vsca

  -- Get all layers & set layer visibility option gadget
  VAR !allLayer COLL ALL LAYE FOR CE
  VAR !allFunc EVAL FUNC FOR ALL FROM !allLayer

  !this.layers.dtext = !allFunc
  !this.layers.rtext = !allLayer

  -- Force select the first layer
  if (!this.layers.val.eq(0)) then
    !this.layers.val = 1
  endif

  -- Check selected layer visibility switch
  !this.layerVis()

  -- Check for dimension style
  !this.getDimnStyle()

  -- Select status
  !this.status.select('DTEXT',!sheeRefe.:IdpIsoStatus)

  -- Store
  !this.currShee = !sheeRefe
  !this.readout.val = '          '

  -- Get dimension offset
  !this.getDoff()

endmethod
-- End of method definition for .selectShee()

------------------------------------------------------------------------
--
-- Method:      .getDoff()
--
-- Description: Get the currently used dimension offset
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDoff()

  -- Get the dimensions laye
  VAR !allLayer COLL ALL LAYE WI spPurpOSE EQ 'DIMENS' FOR $!<this.currShee>

  -- Test for no layer
  if (!allLayer.empty()) then
    return
  endif

  -- Store the layer
  !this.dimeLayer = !allLayer[1].dbref()

  -- Get all linear dimensions
  VAR !allLdim COLL ALL LDIM FOR $!allLayer[1]

  -- For any found dimensions
  if (!allLdim.empty().not()) then

    -- Select the gadget value using the layer offset, which would have been set by the dimensioning functions
    !this.doffset.val = !this.dimeLayer.doff
      handle (61,571)
        -- F&M: Number must be in the range 0 to 99
        !this.doffset.val                 = 99
        !this.dimeLayer.attribute('doff') = 99
      endhandle

  endif

endmethod
-- End of method definition for .getDoff()

------------------------------------------------------------------------
--
-- Method:      .getDimnStyle()
--
-- Description: Get the currently used dimension style
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDimnStyle()

  -- Get the function for all layers
  VAR !allLayer COLL ALL LAYE FOR CE
  VAR !allFunc EVAL FUNC FOR ALL FROM !allLayer

  -- Check for dimension style
  !dimnFunc = !allFunc.findFirst('Dimensions')

  if (!dimnFunc.unset().not()) then

    if (!allLayer[!dimnFunc].dbref().lvis) then
      !this.dimnStyle.val = 'Dimn: ' & !allLayer[!dimnFunc].dbref().:IdpDesc

    else
      !this.dimnStyle.val = 'Dimn: Off'

    endif

  else
    !this.dimnStyle.val = '    '

  endif

endmethod
-- End of method definition for .getDimnStyle()

------------------------------------------------------------------------
--
-- Method:      .checkModified()
--
-- Description: Check if the current drawing has been modified
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modified
--
------------------------------------------------------------------------
define method .checkModified() is BOOLEAN

  -- Initialise variables
  !collection = object COLLECTION()
  !modified   = false

  -- Check this sheet
  if (!this.currShee.set()) then

    -- Get the history
    !history = HISTORY OF $!<this.currShee>

    -- Sheet has been modified
    if (!history[1].eq(0)) then
      !modified = true

    -- Sheet has not been modified so check all offspring
    else

      -- Get all offspring
      !collection.scope(!this.currShee)
      !allElements = !collection.results()

      -- For each element
      do !element val !allElements

        -- Get the history
        !history = HISTORY OF $!element

        -- Check for modified
        if (!history[1].eq(0)) then
          !modified = true

          -- We are done
          break

        endif

      enddo

    endif

  endif

  return !modified

endmethod
-- End of method definition for .checkModified()

------------------------------------------------------------------------
--
-- Method:      .checkWrite(STRING)
--
-- Description: Check if the current drawing is writable
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkWrite(!function is STRING)


  -- Check for write access
  if (!this.readWrite.not()) then

    !!alert.error('This drawing is Read Only and cannot be modified')

    return

  endif

  -- Run method
  $!function

endmethod
-- End of method definition for .checkWrite(STRING)

------------------------------------------------------------------------
--
-- Method:      .layerVis()
--
-- Description: Set layer visibility gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .layerVis()

  -- Check for the Location layer which needs setting at VIEW and not LAYER
  if (!this.layers.selection('DTEXT').eq('Location')) then

    -- Access the view
    !!ce = !this.layers.selection().dbref().owne

    -- Set the layer visibility toggle gadget
    if (!!ce.lvis) then
      !this.layerOnOff.val = true

    else
      !this.layerOnOff.val = false

    endif

    -- We are done
    return

  endif

  -- Check for selected layer
  if (!this.layers.selection().dbref().lvis) then
    !this.layerOnOff.val = true

  else
    !this.layerOnOff.val = false

  endif

  -- Check for dimension style
  !this.getDimnStyle()

endmethod
-- End of method definition for .layerVis()

------------------------------------------------------------------------
--
-- Method:      .layerSet()
--
-- Description: Set the layer gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .layerSet()

  -- Access layer
  !!ce = !this.layers.selection().dbref()

  -- Check for the Location layer which needs setting at VIEW and not LAYER
  if (!this.layers.selection('DTEXT').eq('Location')) then
    VIEW
  endif

  -- Set layer visibility
  if (!this.layerOnOff.val) then
    LVIS TRUE

  else
    LVIS FALSE

  endif

  -- Check for dimension style
  !this.getDimnStyle()

endmethod
-- End of method definition for .layerSet()

------------------------------------------------------------------------
--
-- Method:      .hiddenLine()
--
-- Description: Update the design graphics
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hiddenLine()

  -- Initialise variables
  !sheeRefe   = !this.currShee
  !discipline = !sheeRefe.func.upcase()
  !collection = object COLLECTION()

  -- Show process message form
  !!isoProcess.show('CEN',0.5,0.5)
  !!isoProcess.set(|Please Wait...|,1)
  !!isoProcess.set(|Recalculating the view|,2)

  -- Get the main view
  VAR !view COLL ALL VIEW WI SPPURP EQ 'MAINVW' FOR $!sheeRefe
  !viewRefe = !view[1].dbref()
  !!ce      = !viewRefe

  -- Test for hidden line
  VAR !rrul COLL ALL RRUL WI :IdpIsoStatus EQ 'Hidden' FOR CE

  -- Create a local rule
  if (!rrul.empty()) then

    -- Build the new rule name
    !ruleName = !!ce.flnm & '/HiddenLine'

    -- Create a new local rule for all elements
    NEW RRUL
      NAME $!ruleName
      :IdpIsoStatus 'Hidden'

      -- Use style depending whether PDMS or True-Type Font
      if (!!ce.owne.owne.owne.font.gt(4)) then

        -- Use a style for the particular discipline
        -- HVAC
        if (!discipline.eq('HVAC')) then
          USE /TT/Isometric_ADP/Hidden_Style FOR ALL

        -- CWAY
        else

          -- Get this drawlist sheet number
          !thisShtNo = !viewRefe.idln.func.real()

          -- Get the library containing all drawlists
          !libyRefe = !viewRefe.idln.owne.owne

          -- Get the sheet parts drawlist
          !collection.scope(!libyRefe)
          !collection.type('IDLI')
          !collection.filter(object EXPRESSION('SPPURP EQ |PARTSL| AND FUNC EQ |$!thisShtNo|'))
          !idln = !collection.results()[1]

          USE /TT/Isometric_ADP/Hidden_Style_Cway FOR $!idln

          -- Return to the View
          !!ce = !viewRefe

          -- Build a new rule name
          !ruleName = !!ce.flnm & '/TemplateRule'

          -- Create a new local rule for all templates
          NEW RRUL
            NAME $!ruleName
            :IdpIsoStatus 'Template'

          USE  /TT/Isometric_ADP/Iso_Style_Template FOR ALL GENSEC ALL TMPLATE

        endif

      -- PDMS Native fonts
      else
        USE /Isometric_ADP/Hidden_Style FOR ALL

      endif

  -- delete the local rule
  else

    -- Access the hidden line rule and delete it
    !!ce = !rrul[1].dbref()
    DELETE RRUL

    -- Return to view
    !!ce      = !viewRefe

    -- Look for a CWAY Template rule
    VAR !rrul COLL ALL RRUL WI :IdpIsoStatus EQ 'Template' FOR CE

    -- Delete it
    if (defined(!rrul[1])) then
      !!ce = !rrul[1].dbref()
      DELETE RRUL

    endif

  endif

  -- Update the graphics
  UPDATE DESIGN

  -- Return to sheet
  !!ce = !sheeRefe
  hide !!isoProcess

endmethod
-- End of method definition for .hiddenLine()

------------------------------------------------------------------------
--
-- Method:      .callRev()
--
-- Description: Call the revision form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .callRev()

  -- Try to find a revision set to the overflow characters 'XX'
  VAR !allRevi COLL ALL REVI WI RVSN EQ 'XX' FOR $!<this.currShee>

  -- As long as there isn't one then shown the revision form
  if (!allRevi.empty()) then

    pml reload form !!isoRevision

    !!isoRevision.show()

  -- Otherwise provide a message
  else
    !!alert.warning(|The current sheet has the system revision 'XX'. Please contact your System Administrator.|)

  endif

endmethod
-- End of method definition for .callRev()

------------------------------------------------------------------------
--
-- Method:      .setNudgeFactor(REAL)
--
-- Description: Set the nudge scale factor
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Factor
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNudgeFactor(!factor is REAL)

  -- Deselect all options
  !this.percent.setFieldProperty('one','selected', false)
  !this.percent.setFieldProperty('two','selected', false)
  !this.percent.setFieldProperty('five','selected', false)
  !this.percent.setFieldProperty('ten','selected', false)

  -- Reselect the selected one
  !this.percent.setFieldProperty(!this.percent.pickedFieldName,'selected', true)

  -- Store the nudge factor
  !this.nudgeFactor = !factor

endmethod
-- End of method definition for .setNudgeFactor(REAL)

------------------------------------------------------------------------
--
-- Method:      .setStatus()
--
-- Description: Set the current sheet status
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setStatus()

  -- Get the stored status
  !status = !this.status.selection()

   -- Access current shee and set the status
  !!ce = !this.currShee
  :IdpIsoStatus '$!status'

endmethod
-- End of method definition for .setStatus()

------------------------------------------------------------------------
--
-- Method:      .spacing()
--
-- Description: Set the grid spacing
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spacing()

  -- Display the standard spacing form
  !!cdr2DGrid.show()

  -- Syncronise the grid visibility
  !this.togglevgrid()

endmethod
-- End of method definition for .spacing()

------------------------------------------------------------------------
--
-- Method:      .submitToPdf(DBREF,STRING)
--
-- Description: Create PDF output for the displayed sheet
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The sheet to be output
--    2   R      STRING      The output file name
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitToPdf(!sheetRefe is DBREF, !pdfPathName is STRING)

  -- Initialise plot driver options
  !options = 'COL COLOURPLUS, VIEW'

  -- Plot the sheet depending upon the module
  !this.module.submitToPdf(!sheetRefe, !pdfPathName, !options, 'OVERWRITE')

endmethod
-- End of method definition for .submitToPdf(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Print the current sheet
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .print()

  -- As this is a single default print of the current sheet
  -- Set to convert all white to black, show the dialog and reduce to fit the paper size
  !colourOption = 'COL COLOURPLUS'
  !dialogOption = ''
  !scaleOption  = ', REDUCE'

  -- Submit to the relevant printer mechanism
  !this.module.submitToPrinter(!this.currShee, !colourOption, !dialogOption, !scaleOption)

endmethod
-- End of method definition for .print()

------------------------------------------------------------------------
--
-- Method:      .toggleSnap()
--
-- Description: Set the snap gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleSnap()

  -- Initialise variables
  !value = !this.snapValue

  -- Toggle snap
  if (!this.snap.val.eq(FALSE)) then

    -- Set snap and form value
    SNAP OFF
    --!this.snap.val = 'FALSE'
    !this.snapStatus.val = 'Snap: Off'

  else
    SNAP ON $!value
    --!this.snap.val = 'TRUE'
    !this.snapStatus.val = 'Snap: On'
  endif

  -- Set visual grid to that of the snap grid
  vgrid SNAP 1

endmethod
-- End of method definition for .toggleSnap()

------------------------------------------------------------------------
--
-- Method:      .setsnapValue(REAL)
--
-- Description: Set the snap grid value
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setsnapValue(!value is REAL)

  -- Store value
  !this.snapValue = !value

  -- Set snap
  SNAP SPACING X $!value Y $!value

  -- Refresh vgrid
  if !this.vgrid.val then
    !this.togglevgrid()
  endif

endmethod
-- End of method definition for .setsnapValue(REAL)

------------------------------------------------------------------------
--
-- Method:      .togglevgrid()
--
-- Description: Set the grid on and off
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .togglevgrid()

  -- Toggle visual grid
  if !this.vgrid.val then
    VGRID SNAP 1
    VGRID ON
    handle (64,548)
      vgrid SNAP 5
      vgrid ON
      !!alert.message('The grid is too small to show. Setting to 5 times the snap grid')
    endhandle
  else
    vgrid OFF
  endif

  -- refresh the screen
  !this.feedback.refresh()

endmethod
-- End of method definition for .togglevgrid()

------------------------------------------------------------------------
--
-- Method:      .changeDir()
--
-- Description: Change the current sheet view direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeDir()

  -- Show process message form
  !!isoProcess.show('CEN',0.5,0.5)
  !!isoProcess.set(|Please Wait...|,1)
  !!isoProcess.set(|Recalculating the views|,2)

  -- Initialise variables
  !sheeRefe   = !this.currShee
  !type       = !sheeRefe.func
  !direction  = !this.dir.selection('RTEXT')
  !narrSymbol = !!isomain.isoAdpApp.data.narrSymbols[!this.dir.val]
  VAR !note COLL ALL NOTE WI spPurp EQ 'NARNOT' FOR $!sheeRefe
  VAR !view COLL ALL VIEW WI spPurp EQ 'MAINVW' FOR $!sheeRefe
  VAR !loca COLL ALL VIEW WI spPurp EQ 'LOCPLN' FOR $!sheeRefe
  !collection = object COLLECTION()

  -- Modify the north arrow
  if (!!isomain.isoAdpApp.data.isoContent.nArr) then

    if (undefined(!note[1])) then

      -- Get backing sheet data
      !backObj = object ISOBACK(!!isomain.isoAdpApp.data.backingSheet)
      !northOrigin = 'X' & !backObj.northOrigin.east & 'Y' & !backObj.northOrigin.north

      -- Access sheet and create a new north arrow symbol
      !!ce = !sheeRefe
      NEW NOTE /$!unusedSheeName$!unusedShtNumber/NorthArrow
       spPurp NARNOT
      NEW SYMB  TMRF $!narrSymbol  ORIGIN $!northOrigin

    else

      -- Reset template reference for new direction
      SYMB 1 OF NOTE $!note[1]
       TMRF $!narrSymbol

    endif

  endif

  -- Modify the isometric view
  if (!!isomain.isoAdpApp.data.isoContent.main) then

    -- Redo graphics
    !!ce = !view[1].dbref()
    DIR $!direction

    -- Set the limits
    -- HVAC
    if (!type.eq('HVAC')) then
      AUTO

    -- CWAY
    else

      -- Get this drawlist sheet number
      !thisShtNo = !!ce.idln.func.real()

      -- Get the library containing all drawlists
      !libyRefe = !!ce.idln.owne.owne

      -- Get the sheet parts drawlist
      !collection.scope(!libyRefe)
      !collection.type('IDLI')
      !collection.filter(object EXPRESSION('SPPURP EQ |PARTSL| AND FUNC EQ |$!thisShtNo|'))
      !allIdli = !collection.results()

      AUTO $!allIdli[1]

    endif

    UPDATE DESI
      handle any
      endhandle

    -- Update the dimensioning
    -- We are doing this rather than relying on Update Anno on its own, because the latter
    -- can produce dimensions parallel to the view dir, which the dimensioning routines take into account.
    !this.dimensions(false)

    -- Update annotation
    UPDATE ANNO
      handle any
      endhandle

  endif

  -- Modify the location plan
  if (!!isomain.isoAdpApp.data.isoContent.loca) then

    -- Redo graphics
    !!ce = !loca[1].dbref()
    DIR $!direction
    AUTO
    UPDATE DESI
      handle any
      endhandle

    -- Update annotation
    UPDATE ANNO
      handle any
      endhandle

  endif

  -- Refresh the graphical view
  REFRESH !!isoEdit.feedback

  -- Return to sheet
  !!ce = !sheeRefe
  hide !!isoProcess

endmethod
-- End of method definition for .changeDir()

------------------------------------------------------------------------
--
-- Method:      .deleteCE()
--
-- Description: Delete the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteCE()

  -- Get ce type
  !type = !!ce.type.upcase()

  -- Test that the ce is an element that can be deleted
  if (!type.neq('SLAB') and !type.neq('GLAB') and !type.neq('LDIM') and !type.neq('TEXP')) then
    !this.readout.val = 'Pick a label, dimension, text or ESC to exit'
    ID SLAB GLAB LDIM TEXP @
      handle (61,528)
        !this.readout.val = '              '
        return
      endhandle
  endif

  -- Highlight & enhance ce
  HIGHLIGHT CE
  ENHANCE CE

  -- Delete
  !type = !!ce.type.upcase()
  !response = !!alert.confirm('Are you sure you want to delete this ' & !type & '?')
  if (!response.eq('YES')) then
    DELETE $!type
  else
    UNENHANCE CE
  endif

endmethod
-- End of method definition for .deleteCE()

------------------------------------------------------------------------
--
-- Method:      .modify()
--
-- Description: Access modify mode
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modify()

  -- Initialise variables
  !type = !!ce.type.upcase()
  !new  = false
  UNENHANCE ALL

  -- Run continuous
  do from 1 to 1000

    -- Unenhance ce
    UNENHANCE CE

    -- Test if ce is suitable
    if (!type.neq('SLAB') and !type.neq('GLAB') and !type.neq('LDIM') and !type.neq('TEXP') or !new) then

      -- Make prompt
      !new = false
      !this.readout.val = 'Pick either a label, a dimension, a piece of text or ESC to exit'

      -- Identify a suitable element
      ID SLAB GLAB LDIM TEXP @
        handle (61,528)
          !this.readout.val = '              '
          break
        endhandle

      -- Test that this element is not part of the mto or rev tables, origin symbol or location plan
      !spPurp = !!ce.owne.spPurp
      if (!spPurp.eq('MTOTAB') or !spPurp.eq('MTOSUM') or !spPurp.eq('HISTRY') or !spPurp.eq('ORIGIN') or !spPurp.eq('LOCLAB')) then
        !new = true
        skip
      endif

      -- Get ce data
      !this.currElem = !!ce
      !type = !!ce.type.upcase()

    endif

    -- Enhance ce
    ENHANCE CE

    -- Test type
    if (!type.eq('SLAB') or !type.eq('GLAB')) then
      if (!!ce.tmrf.type.upcase().eq('TXTM')) then

       -- Make readout and modify
       !this.readout.val = 'Modify the label using the intelligent connections'
        MODIFY @
          handle (61,528)
            UNENHANCE CE
            !new = true
            skip
          endhandle

        -- Force next selection
        !new = true

      else
        !this.readout.val = 'Pick a new position on the page'
        AT @
          handle (61,528)
            !new = true
            skip
          endhandle
      endif
    elseif (!type.eq('TEXP')) then
      !this.readout.val = 'Pick a new position on the page'
      AT @
        handle (61,528)
          !new = true
          skip
        endhandle
    else
      !this.readout.val = 'Pick a new position on the page'
      DIM @
        handle (61,528)
          !new = true
          skip
        endhandle
    endif

    -- Refresh the view
    REFRESH !!isoEdit.feedback

    -- Test for loop
    if (!this.loop.val.not()) then
      break
    endif

  enddo

  -- Reset
  !this.readout.val = '         '
  UNENHANCE ALL
  !!ce = !this.currShee

endmethod
-- End of method definition for .modify()

------------------------------------------------------------------------
--
-- Method:      .modifyDoff(GADGET,STRING)
--
-- Description: Modify the offset of all dimensions as a group
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyDoff(!dummyObject is GADGET, !action is STRING)

  -- Test for no layer
  if (!this.dimeLayer.badref()) then
    return
  endif

  -- Get all linear dimensions
  VAR !allLdim COLL ALL LDIM FOR $!<this.dimeLayer>

  -- Modif each dimension
  do !ldim val !allLdim

    -- Set the gadget value
    !doff = !this.doffset.val

    -- Access the ldim
    !!ce = !ldim.dbref()

    -- Set the doff
    DOFF $!doff
      handle any
      endhandle

  enddo

  -- Store the set value at the layer in case of new or modified dimensions
  LAYE
   DOFF $!doff

endmethod
-- End of method definition for .modifyDoff(GADGET,STRING)

------------------------------------------------------------------------
--
-- Method:      .moveStdPattern()
--
-- Description: Set the terminator style
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveStdPattern()

  -- Find the overlay
  VAR !allOver COLL ALL OLAY WI spPurp EQ 'STDPAT' FOR $!<this.currShee>

  -- Access the overlay
  if (defined(!allOver[1])) then

    !!ce = !allOver[1].dbref()

    ENHANCE CE

    -- Move it
    OSHEE BY @
      handle any
        UNENHANCE CE

      endhandle

  endif

  UNENHANCE ALL

endmethod
-- End of method definition for .moveStdPattern()

------------------------------------------------------------------------
--
-- Method:      .nudgeScale()
--
-- Description: Nudge the main view scale and update the annotation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      UP or DOWN
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nudgeScale(!direction is STRING)

  -- Initialise variables
  !sheeRefe   = !this.currShee
  !discipline = !sheeRefe.func

  -- Get the main view
  VAR !view COLL ALL VIEW WI TITLE EQ 'Isometric' FOR $!sheeRefe

  -- Access the main view and read the current scale
  if (undefined(!view[1])) then
    !!alert.error('There is no main view to modify. You will need to repair your drawing.')
    return

  else
    !!ce = !view[1].dbref()
    !currentScale = !!ce.vsca

  endif

  -- Nudge the scale
  !changeInScale = !currentScale * !this.nudgeFactor

  -- Scale up
  if (!direction.eq('UP')) then
    !newScale = !currentScale + !changeInScale

  -- Scale down
  else
    !newScale = !currentScale - !changeInScale

  endif

  -- Set the scale if not zero or less
  if (!newScale.gt(0)) then

    -- Set the scale
    VSCA $!newScale

    -- For CWAY, update the graphics for adjacent parts
    if (!discipline.eq('CWAY')) then
      UPDATE DESIGN
        handle any
        endhandle

    endif

    -- Update all view annotation
    UPDATE ANNO
      handle any
        !answer = !!alert.confirm('You have reached an unusable scale. Do you wish to wish to reset to the original scale?')
        if (!answer.eq('YES')) then
          VSCA $!currentScale
        endif
      endhandle

    -- Refresh the canvas
    REFRESH $!<this.feedback>

  endif

  -- Return to the sheet
  SHEE

endmethod
-- End of method definition for .nudgeScale()

------------------------------------------------------------------------
--
-- Method:      .terminator()
--
-- Description: Set the terminator style
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .terminator()

  -- Initialise variables
  !action = !this.term.selection()
  UNENHANCE ALL

  -- Run continuous
  do from 1 to 1000

    -- Test if ce is suitable
    !type = !!ce.type.upcase()
    if (!type.neq('SLAB') and !type.neq('GLAB') and !type.neq('LDIM')) then

      -- Make prompt
      !this.readout.val = 'Pick either a label, a dimension, or ESC to exit'

      -- Identify a suitable element
      ID SLAB GLAB LDIM @
        handle (61,528)
          !this.readout.val = '              '
          break
        endhandle

      -- Test that this element is not part of the mto or rev tables, origin symbol or location plan
      !spPurp = !!ce.owne.spPurp
      if (!spPurp.eq('MTOTAB') or !spPurp.eq('MTOSUM') or !spPurp.eq('HISTRY') or !spPurp.eq('ORIGIN') or !spPurp.eq('LOCLAB')) then
        skip
      endif

      -- Get ce data
      !this.currElem = !!ce
      !type = !!ce.type.upcase()

    endif

    -- Test type
    if (!type.eq('SLAB') or !type.eq('GLAB')) then

      -- If all layer
      if (!this.layer.val) then

        -- Get all labels for this layer
        VAR !allLabel COLL ALL (SLAB GLAB) FOR OWNE OF CE
        do !label val !allLabel
          !!ce = !label.dbref()
          LTER $!action
        enddo
        LAYE

      else
        LTER $!action
        LAYE
      endif

    else
      -- If all layer
      if (!this.layer.val) then

        -- Get all labels for this layer
        VAR !allDimn COLL ALL (ADIM LDIM) FOR OWNE OF CE
        do !dimn val !allDimn
          !!ce = !dimn.dbref()
          DTER $!action
        enddo
        LAYE

      else
        DTER $!action
        LAYE
      endif
    endif

    -- Refresh the view
    REFRESH !!isoEdit.feedback

    -- Test for loop
    if (!this.loop.val.not()) then
      break
    endif

  enddo

  -- Reset
  !this.readout.val = '         '
  !!ce = !this.currShee

endmethod
-- End of method definition for .terminator()

------------------------------------------------------------------------
--
-- Method:      .moveDT()
--
-- Description: Move the dimension text
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveDT()

  -- Run continuous
  do from 1 to 1000

    -- Test if ce is suitable
    !type = !!ce.type.upcase()
    if (!type.upcase().neq('DPOI') and !type.upcase().neq('DPPT') and !type.upcase().neq('DPBA')) then

      -- Make prompt
      !this.readout.val = 'Pick a dimension text, or ESC to exit'

      -- Identify a suitable element
      ID DPOI DPPT DPBA @
        handle (61,528)
          !this.readout.val = '              '
          break
        endhandle

      -- Get ce data
      !this.currElem = !!ce
      !type = !!ce.type.upcase()

    endif

    -- Set dimension text position
    do from 1 to 1000
      !this.readout.val = 'Pick a new position on the page, or ESC to exit'
      DTOF @
        handle (61,528)
          LAYE
          break
        endhandle
    enddo

    -- Refresh the view
    REFRESH !!isoEdit.feedback

    -- Test for loop
    if (!this.loop.val.not()) then
      break
    endif

  enddo

  -- Reset
  !this.readout.val = '         '
  UNENHANCE ALL
  !!ce = !this.currShee

endmethod
-- End of method definition for .moveDT()

------------------------------------------------------------------------
--
-- Method:      .pPoint()
--
-- Description: Change the ppoint used
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pPoint()

  -- Test if ce is suitable
  !type = !!ce.type.upcase()
  if (!type.neq('SLAB') and !type.neq('GLAB')) then

    -- Make prompt
    !this.readout.val = 'Pick a label, or ESC to exit'

    -- Identify a suitable element
    ID SLAB GLAB @
      handle (61,528)
        !this.readout.val = '              '
        return
      endhandle

  endif

  -- Enhance ce
  ENHANCE CE

  -- Call ppoints form
  pml load form !!isoPpoints
  !!isoPpoints.show('AT',0.55,0)

endmethod
-- End of method definition for .pPoint()

------------------------------------------------------------------------
--
-- Method:      .dimensions(BOOLEAN)
--
-- Description: Change the dimension style
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Cycle through dimension styles or simply rerun the existing style
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensions(!cycle is BOOLEAN)

  -- Initialise variables
  !ce         = !!ce
  !collection = object COLLECTION()

  -- Show process message form
  if (!cycle) then
    !!isoProcess.show('CEN',0.5,0.5)
    !!isoProcess.set(|Please Wait...|,1)
    !!isoProcess.set(|Recalculating dimensions|,2)
  endif

  -- Get the discipline
  !discipline = !this.currShee.function

  -- Get the main view
  VAR !allView COLL ALL VIEW WI spPurp EQ 'MAINVW' FOR $!<this.currShee>
  !viewRefe = !allView[1].dbref()

  -- Get the view drawlist
  -- HVAC
  if (!discipline.eq('HVAC')) then
    !idln = !viewRefe.idln

  -- CWAY
  else

    -- Get this drawlist sheet number
    !thisShtNo = !viewRefe.idln.func.real()

    -- Get the library containing all drawlists
    !libyRefe = !viewRefe.idln.owne.owne

    -- Get the sheet parts drawlist
    !collection.scope(!libyRefe)
    !collection.type('IDLI')
    !collection.filter(object EXPRESSION('SPPURP EQ |PARTSL| AND FUNC EQ |$!thisShtNo|'))
    !idln = !collection.results()[1]

  endif

  -- Get all components
  VAR !allIdnm EVAL REFE OF IDNM FOR ALL ADDE FOR $!idln

  -- Turn the string refs into dbrefs
  !getDbref = object BLOCK('!allIdnm[!evalIndex].dbref()')
  !allComp  = !allIdnm.evaluate(!getDbref)

  -- Get the dimension layer
  VAR !allLaye COLL ALL LAYE WI spPurp EQ 'DIMENS' FOR $!<this.currShee>
  !layeRefe = !allLaye[1].dbref()

  -- Remove all the dimensions
  !!ce = !layeRefe
  DELETE LAYE MEM

  -- Recalculate the dimensions
  -- Ccycle through the avaiable styles
  if (!cycle) then
  	
    if (!layeRefe.:IdpDesc.eq('Overall')) then
      :IdpDesc 'All'
      !this.dimnStyle.val = 'Dimn: All'

      if (!discipline.eq('HVAC')) then
        !!isoDimnFull(!allComp, !!isomain.isoAdpApp.data, false)

      else
        !!isoCwDimnFull(!allComp, !!isomain.isoAdpApp.data, false)

      endif

    elseif (!layeRefe.:IdpDesc.eq('All Horiz')) then
      :IdpDesc 'Over Horiz'
      !this.dimnStyle.val = 'Dimn: Over Horiz'

      if (!discipline.eq('HVAC')) then
        !!isoDimnOverall(!allComp, !!isomain.isoAdpApp.data, true)

      else
        !!isoCwDimnOverall(!allComp, !!isomain.isoAdpApp.data, true)

      endif

    elseif (!layeRefe.:IdpDesc.eq('Over Horiz')) then
      :IdpDesc 'Overall'
      !this.dimnStyle.val = 'Dimn: Overall'

      if (!discipline.eq('HVAC')) then
        !!isoDimnOverall(!allComp, !!isomain.isoAdpApp.data, false)

      else
        !!isoCwDimnOverall(!allComp, !!isomain.isoAdpApp.data, false)

      endif

    elseif (!layeRefe.:IdpDesc.eq('All')) then
      :IdpDesc 'All Horiz'
      !this.dimnStyle.val = 'Dimn: All Horiz'

      if (!discipline.eq('HVAC')) then
        !!isoDimnFull(!allComp, !!isomain.isoAdpApp.data, true)

      else
        !!isoCwDimnFull(!allComp, !!isomain.isoAdpApp.data, true)

      endif

    endif

  -- Rebuild the current dimension style, essentially used when changing the view direction
  else

    if (!layeRefe.:IdpDesc.eq('Overall')) then
    	
      if (!discipline.eq('HVAC')) then
        !!isoDimnOverall(!allComp, !!isomain.isoAdpApp.data, false)

      else
        !!isoCwDimnOverall(!allComp, !!isomain.isoAdpApp.data, false)

      endif

    elseif (!layeRefe.:IdpDesc.eq('All Horiz')) then

      if (!discipline.eq('HVAC')) then
        !!isoDimnFull(!allComp, !!isomain.isoAdpApp.data, true)

      else
        !!isoCwDimnFull(!allComp, !!isomain.isoAdpApp.data, true)

      endif

    elseif (!layeRefe.:IdpDesc.eq('Over Horiz')) then
    	
      if (!discipline.eq('HVAC')) then
        !!isoDimnOverall(!allComp, !!isomain.isoAdpApp.data, true)

      else
        !!isoCwDimnOverall(!allComp, !!isomain.isoAdpApp.data, true)

      endif

    elseif (!layeRefe.:IdpDesc.eq('All')) then
    	
      if (!discipline.eq('HVAC')) then
        !!isoDimnFull(!allComp, !!isomain.isoAdpApp.data, false)

      else
        !!isoCwDimnFull(!allComp, !!isomain.isoAdpApp.data, false)

      endif

    endif

  endif

  -- Finish off
  if (!cycle) then

    -- Refresh the view
    REFRESH !!isoEdit.feedback

    -- Hide the message form
    hide !!isoProcess

  endif

  -- Return to original
  !!ce = !ce
    handle any
    endhandle

endmethod
-- End of method definition for .dimensions(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .displayLog(STRING)
--
-- Description: Display the a log file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      OPEN   Attempt to open the log file
--                           BROWSE Browse for a log file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayLog(!option is STRING)

  import 'PMLFILEBROWSER'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Test for no current log file, in which case browse for one
  if (undefined(!!isoLog) or !!isoLog.file.exists().not() or !option.eq('BROWSE')) then

    -- Initialise variables
    !browser = object PMLFILEBROWSER('OPEN')
    !folder  = object FILE('%PDMSUSER%\LogFiles')

    -- Create the configuration folder if necessary
    if (!folder.exists().not()) then
      !folderPath = !folder.directory().fullName() & '\' & !folder.entry()
      SYSCOM 'mkdir "$!folderPath"'
    endif

    -- Initialise variables
    !directory       = !folder.fullName()
    !seedFile        = ' '
    !title           = 'Isometric Drawing Log File'
    !extensionString = 'txt files (*.txt)|*.txt'

    -- Show Browser
    !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

    -- Test for no returned file name
    if (!browser.file().neq('')) then

      -- Read the log file and display the log file viewer
      !!isoLogViewer.read(object FILE(!browser.file()))
      !!isoLogViewer.show(|CEN|,0.5,0.4)

    endif

  else

    -- Pass the log object
    !!isoLogViewer.log = !!isoLog

    -- Show form
    !!isoLogViewer.show('CEN',0.5,0.4)

  endif

endmethod
-- End of method definition for .displayLog(STRING)

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Test for displayed main form
  if (!!isomain.shown()) then

    -- Switch to design
    VAR !ddl DDL
    if (!ddl.match('PADD').gt(0))then
      SWITCH
    endif

    -- Allow the main form to control tracking
    !this.tracking = true

    -- Reset the tracking to its original status
    !!isomain.setTracking(!this.mainTracking)

  endif

  -- Reset the background colour to the original setting
  !!colourSelect(!this.origCol)
  !!appDraSetBackground(!!isoEdit.feedback, false)

  -- Initialise necessary variables
  !this.currShee = object DBREF()
  !this.currElem = object DBREF()
  !this.feedback.clear()
  !this.selected.clear()
  !this.drwgs.clear()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .setedit(BOOLEAN)
--
-- Description: Set the edit tools active mode
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setedit(!mode is BOOLEAN)

  -- sets the top frame to active or inactive
  !this.edittools.active = !mode

  -- Side options
  !this.getWork.active    = !mode
  !this.saveWork.active   = !mode
  !this.deleteCE.active   = !mode
  !this .autoCe.active    = !mode
  !this.snap.active       = !mode
  !this.vgrid.active      = !mode
  !this.modifyItem.active = !mode
  !this.print.active      = !mode
  !this.pdf.active        = !mode
  !this.showLog.active    = !mode

endmethod
-- End of method definition for .setedit(BOOLEAN)
