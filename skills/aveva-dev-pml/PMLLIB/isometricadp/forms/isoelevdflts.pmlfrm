--
-- File:            isoelevdflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the default parameters for the labels
-- used to indicate an elevation change
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(STRING)                    -                   Checks whether passed db element exists
--  checkFormat(GADGET)              -                   Check the format of the input ppoints
--  close()                          -                   Close the form
--  codeCheck(STRING)                -                   Checks the validity of the passed hash code string
--  init()                           -                   Method to initialise the form
--  isoElevDflts()                   -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save(BOOLEAN)                    -                   Saves the form settings to file
--  selSet()                         -                   Set and select gadget values
--  setCe(STRING,GADGET)             -                   Close the form
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  setPen(GADGET)                   -                   Set form frame pen values and stores in form object
--  setType(GADGET)                  -                   Set the label type
--  store()                          -                   Updates the form objects with the form values
--  store(GADGET,STRING)             -                   Store the chosen character height and XY offset
--  upDown(REAL,STRING,GADGET)       -                   Raise or Lower distance gadgets
--
------------------------------------------------------------------------
setup form !!isoElevDflts

  !this.formTitle = 'Elevation Tag Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG| width 40 lines 1

  option .type 'Drawing Type ' at xmin ymax+0.1 call |!this.selSet()| width 10

  frame .loc 'Local Labels' at x0 ymax+0.1

    text .template 'Template' at xmin+1   ymax     call |!this.check(!this.template.val)| width 27 is STRING
    button .ce                at xmax+0.5 ymin+0.1 call |!this.setCe('TXTM', !this.template)| pixmap width 10 height 12

    text .code 'Code    ' at xmin.template ymax+0.5 call |!this.codeCheck(!this.code.val)| width 29 is STRING

    toggle .slab 'Use Template'  at x5   ymax.template+0.5
    toggle .glab 'General Label' at xmax ymin

    option .tPen 'Text Pen' at xmin.template ymax+0.4 call |!this.store()| pixmap width 20 height 12

    text   .chei 'Text Height' tagwidth 9 at xmax+4.5 ymin  width 8 is REAL format !!isoTextFormat
    button .cheiUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .cheiDo at xmin      ymax-0.05 pixmap width 13 height 10

    para   .pFpen   at xmin.tPen ymax+0.4 text 'Frame Pen'
    option .fPen '' at xmax      ymin call |!this.store()|              pixmap width 20 height 12
    option .fThick  at xmax+0.6  ymin call |!this.setPen(!this.fThick)| pixmap width 44 height 12
    option .fStyle  at xmax+0.6  ymin call |!this.store()|              pixmap width 90 height 12

    para    .pXOff    at xmin.pFpen ymax+0.5 text 'Offset'

    text   .xOff 'X' at xmax+1    ymin  width 8 is REAL format !!isoOffsetFormat
    button .xOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .xOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

    text   .yOff 'Y' at xmax+1    ymin.xOff  width 8is REAL format !!isoOffsetFormat
    button .yOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .yOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

  exit

  frame .conn ' Connection Points ' at x0 ymax+0.1

    text .bend 'BEND'        at xmin+1   ymax call |!this.checkFormat(!this.bend)| width 3 is STRING
    text .brco 'BRCO'        at xmax+2.6 ymin call |!this.checkFormat(!this.brco)| width 3 is  STRING
    text .subc 'SubElements' at xmax+2.6 ymin call |!this.checkFormat(!this.subc)| width 3 is STRING

    para   .vTex      at xmin.bend ymax+0.3 text 'Tag in the Vertical'
    toggle .vOn       at xmax-5    ymin.vTex
    text   .vert 'on' at xmax      ymin call |!this.checkFormat(!this.vert)| width 3 is STRING

  exit

  button .save  'Save' at x0.2 ymax+0.5 call |!this.save(true)|
  button .reset 'Reset' at xmax_Save+10 ymin_Save call |!this.reset()|
  button .close 'Close' at xmax form-size ymin_Save call |!this.close()|

  -- Members
  member .modified    is BOOLEAN
  member .hvacElevTag is ISOELEVTAG
  member .elecElevTag is ISOELEVTAG
  member .suffixes    is ARRAY
  member .title       is STRING

  -- Units
  member .units           is STRING
  member .textIncrement   is REAL
  member .offsetIncrement is REAL

exit
-- End of form definition for !!isoElevDflts

------------------------------------------------------------------------
--
-- Method:        .isoElevDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoElevDflts()

  -- Read the application units
  !appUnits             = object ISOUNITS()
  !this.units           = !appUnits.getUnits()
  !this.textIncrement   = !appUnits.getTextIncrement()
  !this.offsetIncrement = !appUnits.getOffsetIncrement()

  -- Pixmaps
  !this.ce.addPixmap(!!pml.getPathName('browse.png'))
  !this.cheiUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.cheiDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.xOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.xOffDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.yOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.yOffDo.addPixmap(!!pml.getPathName('downcounter.png'))

  -- Callbacks
  !this.chei.callback   = |!this.store(|
  !this.cheiUp.callback = |!this.upDown(!this.textIncrement,'UP',!this.chei)|
  !this.cheiDo.callback = |!this.upDown(!this.textIncrement,'DOWN',!this.chei)|
  !this.xOff.callback   = |!this.store(|
  !this.xOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.xOff)|
  !this.xOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.xOff)|
  !this.yOff.callback   = |!this.store(|
  !this.yOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.yOff)|
  !this.yOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.yOff)|
  !this.slab.callback   = |!this.setType(!this.slab)|
  !this.glab.callback   = |!this.setType(!this.glab)|

  -- Type
  !text[1]         = 'Hvac'
  !text[2]         = 'Electrical'
  !this.type.dtext = !text
  !text[2]         = 'Elec'
  !this.type.rtext = !text

  -- Pens
  do !count from 1 to 16
    !iconFile = 'colour' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
    !rtext[!count] = !count.string()
  enddo
  !this.tPen.dtext = !dtext
  !this.tPen.rtext = !rtext
  !this.fPen.dtext = !dtext
  !this.fPen.rtext = !rtext

  -- Thickness
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext[1] = !!pml.getPathName('linestylethin.png')
  !dtext[2] = !!pml.getPathName('linestylemedium.png')
  !dtext[3] = !!pml.getPathName('linestylethick.png')
  !rtext[1] = |Thin|
  !rtext[2] = |Medium|
  !rtext[3] = |Thick|
  !this.fThick.dtext = !dtext
  !this.fThick.rtext = !rtext

  -- Style
  !dtext     = ARRAY()
  !rtext     = ARRAY()
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|
  do !count from 1 to 10
    !iconFile = 'linestylethin' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Hvac template suffixes
  !this.suffixes[1] = ''
  !this.suffixes[2] = ':BRCO'

  -- Set form member objects
  !this.hvacElevTag = !!isoMain.isoAdpApp.data.hvacElevTag
  !this.elecElevTag = !!isoMain.isoAdpApp.data.elecElevTag

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoElevDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set the defaults file name display
  !this.source.val = |Filename: | & !this.hvacElevTag.file

  -- Set form member objects
  !this.hvacElevTag = !!isoMain.isoAdpApp.data.hvacElevTag
  !this.elecElevTag = !!isoMain.isoAdpApp.data.elecElevTag

  -- Set gadget settings
  !this.selSet()

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!this.hvacElevTag.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .check(STRING)
--
-- Description: Checks whether passed db element exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .check(!element is STRING)

  -- Initialise variables
  !error = false

  -- Check if entered element actually exists
  if (!this.type.selection().eq('Hvac')) then

    -- Check each system suffix
    do !suffix val !this.suffixes
      !template = !this.template & !suffix
      !test = !template.dbref()
        handle (2,109)
          !suffix = !template.after(':')
          !!alert.error('The symbolic template $!template does not exist')
          !this.setModified(true)
          !error = true
          break
        endhandle
    enddo

  else
    !test = !element.dbref()
      handle (2,109)
        !!alert.error('The entered element name does not exist')
        !this.setModified(true)
        return
      endhandle
  endif

  -- Store change
  if (!error.not()) then
    !this.store()
  endif

endmethod
-- End of method definition for .check(STRING)

-----------------------------------------------------------------------
--
-- Method:      .checkFormat(GADGET)
--
-- Description: Check the format of the input ppoints
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .checkFormat(!gadget is GADGET)

  -- Check that the format is in the form P & 'L' or 'A' or a number
  !firstChar = !gadget.val.subString(1,1)
  !secondChar = !gadget.val.after(!firstChar)

  -- Test first character is a P
  if (!firstChar.neq('P')) then
    !!alert.error(|The format must be in form 'P' and 'L' or 'A' or a number|)
    return
  endif

  -- Test second character as number
  if (!secondChar.neq('L') and !secondChar.neq('A')) then
    !test = !secondChar.real()
      handle (2,441)
        !!alert.error(|The format must be in form 'P' and 'L' or 'A' or a number|)
        return
      endhandle
  endif

  -- Store any changes
  !this.store()

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .checkFormat(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoElevDflts.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .codeCheck(STRING)
--
-- Description: Checks the validity of the passed hash code string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .codeCheck(!hashCode is STRING)

  -- Check that the code string contains a P3
  -- This is used as a default only.
  -- When the label is attached to a design element the P3 will be replaced by the relevant connection point
  -- This also allows for easy switching between ppoints in edit mode
  if (!hashCode.match('p3').eq(0) and !hashCode.match('P3').eq(0)) then
    !!alert.error('The code string must contain the word P3. This will be substituted for correct design element connection')
    return
  endif

  -- Store ce
  !ce = !!ce

  -- Check the validity of the code string
  !!ce = /*
  NEW DEPT
  !tempRefe = !!ce

  NEW LIBY
  NEW LALB
  NEW TXTM
    BTEX |$!<this.code.val>|
      handle any
        !!ce = !tempRefe
        DELETE DEPT
        !!ce = !ce
        return error
      endhandle

  -- Clear test and return to original ce
  !!ce = !tempRefe
  DELETE DEPT
  !!ce = !ce

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .codeCheck(STRING)

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save(!confirm is BOOLEAN)

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    if (!confirm) then
      !response = !!alert.confirm('Are you sure you wish to save the changes?')
      if (!response.eq('NO')) then
        return
      endif
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.hvacElevTag = !this.hvacElevTag
    !!isoMain.isoAdpApp.data.elecElevTag = !this.elecElevTag

    -- Save the settings to defaults file
    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric Elevation Tag defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Hvac
    !array.append('-- Part 1 - Hvac')
    !array.append(!this.hvacElevTag.tempArray[1].flnm)
    !array.append(!this.hvacElevTag.code)
    !array.append(!this.hvacElevTag.tColour.string())
    !array.append(!this.hvacElevTag.chei.string(!!isoTextFormat))
    !array.append(!this.hvacElevTag.fColour.string())
    !array.append(!this.hvacElevTag.offset[1].string(!!isoOffsetFormat) & ' ' & !this.hvacElevTag.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.hvacElevTag.bendConn)
    !array.append(!this.hvacElevTag.brcoConn)
    !array.append(!this.hvacElevTag.subconn)
    !array.append(!this.hvacElevTag.vertOn)
    !array.append(!this.hvacElevTag.vertConn)
    !array.append(!this.hvacElevTag.fStyle)
    !array.append(!this.hvacElevTag.fThickness)

    -- Electrical
    !array.append('-- Part 2 - Electrical')
    !array.append(!this.elecElevTag.template.flnm)
    !array.append(!this.elecElevTag.tColour.string())
    !array.append(!this.elecElevTag.chei.string(!!isoTextFormat))
    !array.append(!this.elecElevTag.fColour.string())
    !array.append(!this.elecElevTag.offset[1].string(!!isoOffsetFormat) & ' ' & !this.elecElevTag.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.elecElevTag.lType)
    !array.append(!this.elecElevTag.fStyle)
    !array.append(!this.elecElevTag.fThickness)
    !array.append(!this.elecElevTag.bendConn)
    !array.append(!this.elecElevTag.vertOn)
    !array.append(!this.elecElevTag.vertConn)

    -- Write to file
    !this.hvacElevTag.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Initialise variables
  !gName = !this.type.selection() & 'ElevTag'

  -- Set template gadget depending on discipline
  -- HVAC
  if (!this.type.selection().eq('Hvac')) then

    -- Set the gadget to part of the template name
    !this.template.val = !this.$!gName$N.tempArray[1].flnm

    -- Make certain gadgets visibility
    !this.code.visible    = true
    !this.brco.visible    = true
    !this.subc.visible    = true
    !this.slab.visible    = false
    !this.glab.visible    = false
    !this.template.active = true

    -- Set the hash code
    !this.code.val = !this.$!gName$N.code

    -- Set the connection gadgets
    !this.bend.val = !this.$!gName$N.bendConn
    !this.brco.val = !this.$!gName$N.brcoConn
    !this.subc.val = !this.$!gName$N.subconn
    !this.vert.val = !this.$!gName$N.vertConn
    !this.vOn.val  = !this.$!gName$N.vertOn

  -- CWAY
  else

    -- Set the gadget to part of the template name
    !this.template.val = !this.$!gName$N.template.flnm

    -- Make certain gadgets visibility
    !this.code.visible = false
    !this.brco.visible = false
    !this.subc.visible = false
    !this.slab.visible = true
    !this.glab.visible = true

    -- Set the connection gadgets
    !this.bend.val = !this.$!gName$N.bendConn
    !this.vert.val = !this.$!gName$N.vertConn
    !this.vOn.val  = !this.$!gName$N.vertOn

    -- Set the label type gadgets
    if (!this.$!gName$N.lType.eq('Template')) then
      !this.slab.val        = true
      !this.glab.val        = false
      !this.template.active = true

    else
      !this.slab.val        = false
      !this.glab.val        = true
      !this.template.active = false

    endif

  endif

  -- Set offset gadget
  !this.xOff.val = !this.$!gName$N.offset[1]
  !this.yOff.val = !this.$!gName$N.offset[2]

  -- Select pens
  !this.tPen.val = !this.$!gName$N.tColour
  !this.fPen.val = !this.$!gName$N.fColour

  -- Set character height
  !this.chei.val = !this.$!gName$N.chei

  -- Select the frame thickness and style
  !this.fThick.select('RTEXT', !this.$!gName$N.fThickness)
  !this.fStyle.select('RTEXT', !this.$!gName$N.fStyle)

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setCe(STRING,GADGET)
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type being searched for
--    2   R      GADGET      The gadget receiving the chosen element
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setCe(!type is STRING, !gadget is GADGET)

  -- Set browse form to search for db elements
  pml load form !!isoBrowse

  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  show !!isoBrowse

endmethod
-- End of method definition for .setCe(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setPen(GADGET)
--
-- Description: Set form frame pen values and stores in form object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setPen(!gadget is GADGET)

  -- Initialise variables
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|

  -- For thickness change the style values
  do !count from 1 to 10
    !iconFile = 'linestyle' & !gadget.selection().lowCase() & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Store the change
  !this.store()

endmethod
-- End of method definition for .setPen(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setType(GADGET)
--
-- Description: Set the label type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The calling gadget
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setType(!gadget is GADGET)

  -- Make the toggle gadgets work like a radio gadget

  -- Unset both toggle gadgets
  !this.glab.val = false
  !this.slab.val = false

  -- Select the passed gadget
  !gadget.val = true

  -- Set the template gadget active status
  if (!this.slab.val) then
    !this.template.active = true
  else
    !this.template.active = false
  endif

  -- Store the change
  !this.store()

endmethod
-- End of method .setType(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Updates the form objects with the form values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Initialise variables
  !gName = !this.type.selection() & 'ElevTag'

  -- Save settings to the object
  -- HVAC
  if (!this.type.selection().eq('Hvac')) then

    -- For each suffix store the template
    do !suffix val !this.suffixes
      !template = !this.template.val & !suffix
      !this.$!gName$N.tempArray.append(!template.dbref())
    enddo

    -- Store the hash code
    !this.$!gName$N.code = !this.code.val

    -- Store the connection gadgets
    !this.$!gName$N.bendConn = !this.bend.val
    !this.$!gName$N.brcoConn = !this.brco.val
    !this.$!gName$N.subconn  = !this.subc.val
    !this.$!gName$N.vertConn = !this.vert.val
    !this.$!gName$N.vertOn   = !this.vOn.val

  -- CWAY
  else

    -- Store the template
    !this.$!gName$N.template = !this.template.val.dbref()

    -- Store the connection gadgets
    !this.$!gName$N.bendConn = !this.bend.val
    !this.$!gName$N.vertConn = !this.vert.val
    !this.$!gName$N.vertOn   = !this.vOn.val

    -- Store the label type
    if (!this.slab.val) then
      !this.$!gName$N.lType = 'Template'
    else
      !this.$!gName$N.lType = 'General'
    endif

  endif

  !this.$!gName$N.tColour    = !this.tPen.selection().real()
  !this.$!gName$N.fColour    = !this.fPen.selection().real()
  !this.$!gName$N.fThickness = !this.fThick.selection()
  !this.$!gName$N.fStyle     = !this.fStyle.selection()
  !this.$!gName$N.chei       = !this.chei.val
  !this.$!gName$N.offset[1]  = !this.xOff.val
  !this.$!gName$N.offset[2]  = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:        .store(GADGET,STRING)
--
-- Description:   Store the chosen character height and XY offset
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!dummyObject is GADGET, !dummyAction is STRING)

  -- Initialise variables
  !gName = !this.type.selection() & 'ElevTag'

  -- Save settings to the object
  -- Unfortunately, the gadget value query is in system units so we must convert it to ours
  !this.$!gName$N.chei      = !this.chei.val
  !this.$!gName$N.offset[1] = !this.xOff.val
  !this.$!gName$N.offset[2] = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise or Lower distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDown(!increment is REAL, !direction is STRING, !gadget is GADGET)

  -- Initialise variables
  !gName = !this.type.selection() & 'ElevTag'

  -- Raise the value by the increment
  if (!direction.eq('UP')) then

    !nextValue = !gadget.val + !increment

  -- Reduce value by the increment
  else

    !nextValue = !gadget.val - !increment

  endif

  -- Test for zero or less
  if (!nextValue.leq(0)) then
   !nextValue = 0
  endif

  -- Set the gadget value
  !gadget.val = !nextValue

  -- Save settings to the object
  !this.$!gName$N.chei      = !this.chei.val.convertUnits(!this.units)
  !this.$!gName$N.offset[1] = !this.xOff.val.convertUnits(!this.units)
  !this.$!gName$N.offset[2] = !this.yOff.val.convertUnits(!this.units)

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .upDown()
