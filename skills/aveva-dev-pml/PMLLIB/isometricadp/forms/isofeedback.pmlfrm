--
-- File:            isofeedback.pmlfrm
--   Type:          Form Definition
--   Group:         Isometric ADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply the form settings
--  cancel()                         -                   Cancel this form
--  init()                           -                   Method to initialise the form
--
------------------------------------------------------------------------
setup form !!isoFeedBack

  !this.formTitle = 'Feedback Colour'
  !this.cancelCall = '!this.cancel()'
  !this.initCall = '!this.init()'

  para .text at xmin ymax+0.2 text |Colour |
  option .colour at xmax.text+7 ymin width 7

  button .apply | OK | at xmin.text ymax+0.5 call |!this.apply()|
  button .cancel | Cancel | at xmax form -size ymin cancel

  !dtext[1] = |Grey|
  !dtext[2] = |Red|
  !dtext[3] = |Orange|
  !dtext[4] = |Yellow|
  !dtext[5] = |Green|
  !dtext[6] = |Cyan|
  !dtext[7] = |Blue|
  !dtext[8] = |Violet|
  !dtext[9] = |Brown|
  !dtext[10] = |White|
  !dtext[11] = |Pink|
  !dtext[12] = |Mauve|
  !rtext[1] = |1|
  !rtext[2] = |2|
  !rtext[3] = |3|
  !rtext[4] = |4|
  !rtext[5] = |5|
  !rtext[6] = |6|
  !rtext[7] = |7|
  !rtext[8] = |8|
  !rtext[9] = |9|
  !rtext[10] = |10|
  !rtext[11] = |11|
  !rtext[12] = |12|
  !this.colour.dtext = !dtext
  !this.colour.rtext = !rtext

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set default colour
  !this.colour.val = 6

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply the form settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !colour = !this.colour.selection()

  SETFEEDBACK COLOUR $!colour

  !this.cancel()

endmethod
-- End of method definition for .apply()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  hide !!isoFeedBack

endmethod
-- End of method definition for .cancel()
