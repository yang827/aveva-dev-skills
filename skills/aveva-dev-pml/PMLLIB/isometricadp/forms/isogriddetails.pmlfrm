-- File:            isogriddetails.pmlfrm
--   Type:          Form Definition
--   Group:         Isometric ADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 November 2010
--
--
-- Description:
-- Used to display the details about the selected element in the detail grid
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close the form
--  display()                        -                   Display the relevant data
--  init()                           -                   Form initialisation
--  isoGridDetails()                 -                   Constructor
--  setData(ISODATA,ARRAY)           -                   Read a passed file
--
------------------------------------------------------------------------
-- Define form
setup form !!isoGridDetails

  -- Form callbacks
  !this.callback   = '!this.init()'
  !this.cancelCall = '!this.close()'

  -- Display
  textPane .display anchor left + right + top + bottom at xmin ymax width 50 height 10

  -- Members
  -- File to display
  member .isoData  is ISODATA

  -- Form title
  member .title    is STRING

  --The selected elements
  member .selected is ARRAY

exit
-- End of form definition for !!isoGridDetails

------------------------------------------------------------------------
--
-- Method:      .isoGridDetails()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .isoGridDetails()

  -- Set form title
  !this.formTitle  = 'Details of the Selected Element'

  -- Set textpane as non-editable
  !this.display.setEditable(false)

endmethod
-- End of method definition for .isoGridDetails()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Display the details
  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Display the data for the selected element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display()

  -- Initialise variables
  !displayText = ARRAY()

  -- Build the display text
  do !selected val !this.selected

    -- Get the index
    !index = !selected.real()

    -- Get the data
    !type     = !this.isoData.sysRefs[!index].type.upcase()
    !name     = !this.isoData.names[!index]
    !contents = !this.isoData.contents[!index]
    !drawn    = !this.isoData.drawn[!index]
    !drwgName = !this.isoData.dwgNames[!index]
    !access   = !this.isoData.access[!index]
    !mode     = !this.isoData.mode[!index]
    !locked   = !this.isoData.locked[!index]
    !font     = !this.isoData.validFont[!index]

    -- Build the display text
    !displayText.append('Type: ' & !type)
    !displayText.append('Name: ' & !name)
    !displayText.append('Does it have valid 3D contents: ' & !contents)
    !displayText.append('Has it been drawn?: ' & !drawn)
    !displayText.append('Drawing name: ' & !drwgName)
    !displayText.append('Is the drawing locked?: ' & !locked)
    !displayText.append('Does the drawing have a compatible font?: ' & !font)
    !displayText.append('Do you have Write access to the drawing?: ' & !access)
    !displayText.append('The Processing Type: ' & !mode)

    -- Add a separator line
    !displayText.append('--------------------------------------------------------------------------------------------')

  enddo

  -- Display the text
  !this.display.val = !displayText

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      .setData(ISODATA,REAL)
--
-- Description: Read a passed file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ISODATA)    The data object
--    2   R      ARRAY       The string indices of the selected elements in the grid
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!data is ISODATA, !selected is ARRAY)

  -- Save the passed data
  !this.isoData  = !data
  !this.selected = !selected

endmethod
-- End of method definition for .setData(ISODATA,REAL)
