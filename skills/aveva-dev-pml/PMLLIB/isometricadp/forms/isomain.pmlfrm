--
-- File:            isomain.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- The main form for processing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browse(FILE)                     -                   Start windows browser for output
--  browseLocation(STRING,GADGET)    -                   Browse for an element of a passed type
--  browser(GADGET)                  -                   Show standard browser for Excel output
--  browser(GADGET,FILE)             -                   Show standard browser
--  cancel()                         -                   Cancel this form
--  checkFile(GADGET,STRING)         -                   Check the entered file
--  checkLocation(GADGET,STRING)     -                   Check that the entered element exists and is of the correct type
--  clearAll()                       -                   Clear variables
--  clearUser()                      -                   Clear saved user settings
--  createFolder(STRING)             FILE                Create folder
--  currentElement()                 -                   Set form to report on the current element
--  currentElement(DBREF)            -                   Set form to report on the current element
--  deselectAll()                    -                   Deselect all selections in the grid
--  displayDetails()                 -                   Display details about the element selected in the grid
--  getSettings()                    ARRAY               Get the setting on this form that are used during the process run
--  goToDrawing()                    -                   Navigate to drawing associated with the selected element
--  goToElement()                    -                   Navigate to the selected element
--  hiddenPreview()                  -                   Update this form when the preview form is hidden
--  hidePreview(BOOLEAN)             -                   Hide the preview form when shown
--  include(ARRAY)                   -                   Include the passed elements in the grid
--  init()                           -                   Method to initialise the form
--  isoMain()                        -                   Constructor method
--  loadUserDflts()                  -                   Load user defaults if available
--  mode(STRING)                     -                   Set revision mode
--  modified(BOOLEAN)                -                   Set form as having had its settings modified
--  modifyMode(BOOLEAN)              -                   Switch modify mode on or off
--  netAfterSelectChange(ARRAY)      -                   Callback on grid control after select change
--  netBeforeCellUpdate(ARRAY)       -                   Callback on grid control before cell update
--  netPopup(ARRAY)                  -                   Pop-up for grid control
--  previewSplit()                   -                   Preview the spool splitting
--  process()                        -                   Process isometrics
--  refresh()                        -                   Refresh this and the preview form for the current element
--  remove(STRING)                   -                   Remove entries from the detail list
--  resetModify()                    -                   Reset the modify gadgets to the saved settings
--  runSearch()                      -                   Run the report
--  saveExcel(FILE)                  -                   Set file to that returned from the file browser and save the report to Excel
--  saveSettings()                   -                   Save changes to the settings
--  saveUserDefaults()               -                   Save settings to user defaults file for reloading on start up
--  searchMode()                     -                   Set panels for searching
--  selAll()                         -                   Select all entries in the grid control
--  setCe()                          -                   Select the current element
--  setComplexity(GADGET,GADGET)     -                   Set the splitting complexity
--  setDefaults()                    -                   Set all defaults
--  setDirection(REAL)               -                   Set the direction gadgets
--  setDisplay(BOOLEAN)              -                   Set whether drawings should be displayed when picked
--  setIcon()                        -                   Set the cell icons
--  setIcon(REAL,ARRAY)              -                   Set the specified column cell icons
--  setPopUpActive(BOOLEAN)          -                   Set the display grid pop-up active or inactive
--  setPreviewSettings()             -                   Set the model preview form settings
--  setRefresh(BOOLEAN)              -                   Set the refresh gadget invisible status
--  setSettings()                    -                   Set the settings gadgets
--  setSplitting(STRING,GADGET,GADGET) -                   Set the split method
--  setTracking(BOOLEAN)             -                   Set tracking
--  setType()                        -                   Set the search type
--  setValues(STRING,REAL)           -                   Set process values for splitting limits and north direction
--  showAdv()                        -                   Display the advanced search form
--  singleMode()                     -                   Set panels for a single element
--  store()                          -                   Store the form settings
--  switchMode(STRING)               -                   Switch from single to search mode
--  switchToSingleMode()             -                   Switch to single mode if ta suitable element is available
--  track()                          -                   Track selected element
--  visibility()                     -                   Set gadget visibility
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!isoMain dialog docking right

  !this.formTitle  = 'Isometric Production'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  -- Track
  track |DESICE| call |!this.track()|

  -- Single element panel ----------------------------------------------------------------------------------------------------------
  frame .singlePanel panel anchor top + left + right at x0 y0

    paragraph .singleNameP  at x0.5     ymax text 'Element for processing'

    line .singleNameL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

    paragraph .elementName at xmin+0.5 ymax width 30 lines 1

    button .singleRefresh at xmax ymin tooltip 'Refresh for CE' pixmap width 16 height 16

    -- Tracking
    toggle .singleTrack 'Track current element' anchor top + left at x1 ymax+0.2

    -- Existing Drawing
    frame .singleDrawing  panel anchor top + left + right at x0 ymax

      paragraph .singleDrawnP at x0.5 ymax text 'Existing Drawing'

      line .singleDrawnL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      paragraph .singleExistingP at x1 ymax+0.2 text 'A Drawing does not exist for this element' width 30 lines 1

      path right

      rtoggle .singleUpdate     anchor left + top at x2 ymax.singleDrawnL1+0.2 tagwid 5 'Update'   states '' 'UPDATE'
      rtoggle .singleRegenerate anchor left + top                              tagwid 8 'Recreate' states '' 'REGENERATE'

    exit

    path down

   -- Multiple elements
    frame .singleMulti  panel anchor top + left + right at x0 ymax-0.5

      paragraph .singleMultiS at x0.5 ymax text 'Multiple Systems'

      line .singleMultiL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchHvacLink       linkLabel 'Search for HVAC Mains'            at x1 ymax

      button .searchCwayLink       linkLabel 'Search for Cable Ways'            at x1 ymax

      -- Add further search options here

    exit

    -- Tasks
    frame .singleTask  panel anchor top + left + right at x0 ymax.searchCwayLink

      paragraph .singleTaskP at x0.5 ymin+0.2 text 'Tasks'

      line .singleTaskL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .singleViewSplitLink linkLabel 'Preview Spooling'   at x1 ymax

      button .singleSettingsLink  linkLabel 'Modify Settings'    at x1 ymax

      -- Add further tasks here

    exit

    -- Tasks Modify
    frame .singleTaskModify  panel anchor top + left + right at x0 ymax.searchCwayLink

      paragraph .singleTaskPM at x0.5 ymin+0.2 text 'Tasks'

      line .singleTaskL1M  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .singleViewSplitLinkM linkLabel 'Preview Spooling'    at x1 ymax

      button .singleClearUserLinkM linkLabel 'Clear User Settings' at x1 ymax

      -- Add further tasks here

    exit

    -- Settings
    frame .singleSet  panel anchor top + left + right at x0 ymax.singleSettingsLink

      paragraph .singleSetP at x0.5 ymax text 'Settings'

      line .singleSetL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .singleTopBack tooltip 'Back to the Task Menu'  anchor left + top at x0.5 ymax+0.3 pixmap width 16 height 16

      frame .singleSetLocF 'Locations' at x1 ymax+0.1

        para   .singleSetLocDrwgP  anchor left + top at x1 ymin+0.7 text 'Create isometrics in this Registry' width 25 lines 1
        text   .singleSetLocDrwg   tooltip 'In which Registry? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .singleSetLocDrwgBr tooltip 'Browse Registries '  anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

      exit

      frame .singleSetLimF 'Splitting' at x1 ymax

        path down

        para    .singleSetLimFP anchor left + top at x1 ymin+0.7 text 'Produce Spool Isometrics'

        rtoggle .singleSetLimFop1 anchor left + top at x2 ymax tagwid 11 'By Volume'       states '' 'VOLUME'
        rtoggle .singleSetLimFop2 anchor left + top            tagwid 12 'By Split Points' states '' 'SPLITPOINT'

        option .singleSetLimBox anchor left + top tagwidth 10 |with complexity| at xmax.singleSetLimFop1 ymin.singleSetLimFop1 width 4

      exit

      frame .singleSetDirF 'North Direction' at x1 ymax width 33.2 height 2

        toggle .singleSetIso1 at xmin+2.6 ymin+0.8 pixmap width 16 height 16
        toggle .singleSetIso2 at xmax+3.2 ymin     pixmap width 16 height 16
        toggle .singleSetIso3 at xmax+3.2 ymin     pixmap width 16 height 16
        toggle .singleSetIso4 at xmax+3.2 ymin     pixmap width 16 height 16

      exit

      frame .singleSetRevF 'Revision' at x1 ymax

        option .singleSetRevType                     at xmin+1.5 ymax width 6
        option .singleSetRevMode                     at xmax+1   ymin width 7
        option .singleSetRevValue tagwidth 4 |Value| at xmax+1   ymin width 2

      exit

  -- FUTURE
  --    frame .singleSetTemF 'Template' at x1 ymax width 20 height 6.8
  --      option .singleSetTemType   'Type' tagwidth 4 anchor left + right + top  at xmin+1 ymin+1   tooltip 'Create which Type? '  width 23
  --      option .singleSetTemSize   'Size' tagwidth 4 anchor left + right + top  at xmin   ymax+0.3 tooltip 'With what Size? '     width 3
  --      para   .singleSetTemView  anchor left + top at xmax+2 ymin-0.2 pixmap width 140 height 100
  --    exit

      frame .singleSetOutF 'Output' at x1 ymax

        toggle .singleSetOutXls 'MS Excel file' tagwidth 10 at x1 ymin+0.8
        button .singleSetOutBrXls tooltip 'Browse for Excel files' anchor left + top at xmax ymin+0.1 pixmap width 16 height 16

        para   .singleSetXlsFile  anchor left + top  at x1 ymax.singleSetOutXls+0.1 text 'Create parts list in this location' width 20 lines 1
        text   .singleSetXlsFold  tooltip 'In which Folder? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .singleSetXlsBrFld tooltip 'Browse Folders'    anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

        toggle .singleSetOutPDF 'Output PDF' tagwidth 10 at x1 ymax+0.5
        button .singleSetOutBrPDF tooltip 'Browse for PDF files' anchor left + top at xmax ymin+0.2 pixmap width 16 height 16

        para   .singleSetPdfFile   anchor left + top at xmin.singleSetOutPDF ymax.singleSetOutBrPDF+0.1 text 'Create PDF files in this location' width 20 lines 1
        text   .singleSetPdfFold  tooltip 'In which Folder? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .singleSetPdfBrFld tooltip 'Browse Folders '   anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

      exit

      button .singleSetBack tooltip 'Back to the Task Menu'  anchor left + top at x0.5 ymax+0.3 pixmap width 16 height 16
      button .singleSetApply  'Save' tooltip 'Save as your defaults' anchor right + top  at xmax.singleSetOutF-7 ymin

    exit

    -- Process
    frame .singleProcess panel anchor top + left + right at x0 ymax.singleSettingsLink

      line .singleL1  anchor top + left + right  at x0 ymax+0.1 horizontal width 37
      line .singleL2  anchor top + left + right  at x0 ymax     horizontal width 37

      paragraph .singleProcessP at x0.5 ymin+0.2 text 'Process'

      line .singleProcessL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .singleProcessStart 'Start' at x1     ymax+0.2
      button .singleProcessStop  'Stop'  at xmax+2 ymin

    exit

    -- Process Modify
    frame .singleProcessModify panel anchor top + left + right at x0 ymax.singleSetApply

      line .singleL1M anchor top + left + right  at x0 ymax+0.1 horizontal width 37
      line .singleL2M anchor top + left + right  at x0 ymax     horizontal width 37

      paragraph .singleProcessPM at x0.5 ymin+0.2 text 'Process'

      line .singleProcessL1M  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .singleProcessStartM 'Start' at x1     ymax+0.2
      button .singleProcessStopM  'Stop'  at xmax+2 ymin

    exit

  exit

  -- Search Panel ---------------------------------------------------------------------------------------------------------------
  frame .searchPanel panel anchor top + left + right at x0 y0

    -- Model element below which to search
    para   .eTitle  anchor left + top         at x0.5     ymin text 'Model element to search under:'
    text   .ceName  anchor left + right + top at xmin     ymax-0.1 width 31 scroll 90 STRING
    button .upLevel anchor right + top        at xmax+0.5 ymin tooltip 'Go up one level '        pixmap width 16 height 16
    button .searchCe anchor right + top       at xmin     ymin tooltip 'Use the current element' pixmap width 16 height 16

    -- Tracking
    toggle .searchTrack 'Track current element' anchor top + left at x1 ymax+0.2

    -- Element type
    para   .etPara at x0.5 ymax+0.2 text 'Search for:' width 9 lines 1
    option .elementType at xmax ymin width 17

    -- Filter the search
    para   .foPara at x0.5 ymax text 'Filter the results for:'
    option .filterOption anchor top + left + right at xmin ymax-0.1 width 23
    button .search 'Search' anchor top + right at xmax+1.2 ymin

    button .advancedSearch linkLabel 'Advanced Search' at x1 ymax+0.1

    -- Model element list for processing
    container .netDetailList PMLnetCONTROL 'net' anchor left + right + top at x0.3 ymax+0.1 width 36 height 8

--    button .searchBack tooltip 'Close Search Tool'  anchor left + top at x0.5 ymax+0.5 pixmap width 16 height 16
    button .searchBack linkLabel 'Switch to Single Mode' at x0.5 ymax+0.5

    button .saveListToExcel anchor right + bottom  at xmax.netDetailList-5 ymin  tooltip 'Save List to Excel File ' pixmap width 19 height 19

    -- Tasks
    frame .searchTask  panel anchor top + left + right at x0 ymax.searchBack

      paragraph .searchTaskP at x0.5 ymin+0.2 text 'Tasks'

      line .searchTaskL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchViewSplitLink linkLabel 'Preview Spooling'   at x1 ymax

      button .searchSettingsLink  linkLabel 'Modify Settings'    at x1 ymax

      -- Add further tasks here

    exit

    -- Tasks Modify
    frame .searchTaskModify  panel anchor top + left + right at x0 ymax.searchBack

      paragraph .searchTaskPM at x0.5 ymin+0.2 text 'Tasks'

      line .searchTaskL1M  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchViewSplitLinkM linkLabel 'Preview Spooling'    at x1 ymax

      button .searchClearUserLinkM linkLabel 'Clear User Settings' at x1 ymax

      -- Add further tasks here

    exit

    -- Settings
    frame .searchSet  panel anchor top + left + right at x0 ymax.searchSettingsLink

      paragraph .searchSetP at x0.5 ymax text 'Settings'

      line .searchSetL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchTopBack tooltip 'Back to the Task Menu'  anchor left + top at x0.5 ymax+0.3 pixmap width 16 height 16

      frame .searchSetLocF 'Locations' at x1 ymax+0.1

        para   .searchSetLocDrwgP  anchor left + top at x1 ymin+0.7 text 'Create isometrics in this Registry' width 25 lines 1
        text   .searchSetLocDrwg   tooltip 'In which Registry? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .searchSetLocDrwgBr tooltip 'Browse Registries '  anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

      exit

      frame .searchSetLimF 'Splitting' at x1 ymax

        path down

        para    .searchSetLimFP anchor left + top at x1 ymin+0.7 text 'Produce Spool Isometrics'

        rtoggle .searchSetLimFop1 anchor left + top at x2 ymax tagwid 11 'By Volume'       states '' 'VOLUME'
        rtoggle .searchSetLimFop2 anchor left + top            tagwid 12 'By Split Points' states '' 'SPLITPOINT'

        option  .searchSetLimBox anchor left + top tagwidth 10 |with complexity| at xmax.searchSetLimFop1 ymin.searchSetLimFop1 width 4

      exit

      frame .searchSetDirF 'North Direction' at x1 ymax

        toggle .searchSetIso1 at xmin+2.6 ymin+0.8 pixmap width 16 height 16
        toggle .searchSetIso2 at xmax+3.2 ymin     pixmap width 16 height 16
        toggle .searchSetIso3 at xmax+3.2 ymin     pixmap width 16 height 16
        toggle .searchSetIso4 at xmax+3.2 ymin     pixmap width 16 height 16

      exit

      frame .searchSetRevF 'Revision' at x1 ymax

        option .searchSetRevType                     at xmin+1.5 ymax width 6
        option .searchSetRevMode                     at xmax+1   ymin width 7
        option .searchSetRevValue tagwidth 4 |Value| at xmax+1   ymin width 2

      exit

  -- FUTURE
  --    frame .searchSetTemF 'Template' at x1 ymax width 20 height 6.8
  --      option .searchSetTemType   'Type' tagwidth 4 anchor left + right + top  at xmin+1 ymin+1   tooltip 'Create which Type? '  width 23
  --      option .searchSetTemSize   'Size' tagwidth 4 anchor left + right + top  at xmin   ymax+0.3 tooltip 'With what Size? '     width 3
  --      para   .searchSetTemView  anchor left + top at xmax+2 ymin-0.2 pixmap width 140 height 100
  --    exit

      frame .searchSetOutF 'Output' at x1 ymax

        toggle .searchSetOutXls 'MS Excel file' tagwidth 10 at x1 ymin+0.8
        button .searchSetOutBrXls tooltip 'Browse for Excel files' anchor left + top at xmax ymin+0.1 pixmap width 16 height 16

        para   .searchSetXlsFile  anchor left + top  at x1 ymax.searchSetOutXls+0.1 text 'Create parts list in this location' width 20 lines 1
        text   .searchSetXlsFold  tooltip 'In which Folder? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .searchSetXlsBrFld tooltip 'Browse Folders'    anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

        toggle .searchSetOutPDF 'Output PDF' tagwidth 10 at x1 ymax+0.5
        button .searchSetOutBrPDF tooltip 'Browse for PDF files' anchor left + top at xmax ymin+0.2 pixmap width 16 height 16

        para   .searchSetPdfFile   anchor left + top at xmin.searchSetOutPDF ymax.searchSetOutBrPDF+0.1 text 'Create PDF files in this location' width 20 lines 1
        text   .searchSetPdfFold  tooltip 'In which Folder? ' anchor left + right + top at xmin+0.5 ymax-0.1 width 27 scroll 90 STRING
        button .searchSetPdfBrFld tooltip 'Browse Folders '   anchor right + top        at xmax+0.3 ymin+0.05 pixmap width 16 height 16

      exit

      button .searchSetBack tooltip 'Back to the Task Menu'  anchor left + top at x0.5 ymax+0.3 pixmap width 16 height 16
      button .searchSetApply  'Save' tooltip 'Save as your defaults' anchor right + top  at xmax.searchSetOutF-7 ymin

    exit

    -- Process
    frame .searchProcess panel anchor top + left + right at x0 ymax.searchSettingsLink

      line .searchL1  anchor top + left + right  at x0 ymax+0.1 horizontal width 37
      line .searchL2  anchor top + left + right  at x0 ymax     horizontal width 37

      paragraph .searchProcessP at x0.5 ymin+0.2 text 'Process'

      line .searchProcessL1  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchProcessStart 'Start' at x1     ymax+0.2
      button .searchProcessStop  'Stop'  at xmax+2 ymin

    exit

    -- Process Modify
    frame .searchProcessModify panel anchor top + left + right at x0 ymax.searchSetApply

      line .searchL1M anchor top + left + right  at x0 ymax+0.1 horizontal width 37
      line .searchL2M anchor top + left + right  at x0 ymax     horizontal width 37

      paragraph .searchProcessPM at x0.5 ymin+0.2 text 'Process'

      line .searchProcessL1M  anchor top + left + right  at xmin ymax-0.2 horizontal width 36

      button .searchProcessStartM 'Start' at x1     ymax+0.2
      button .searchProcessStopM  'Stop'  at xmax+2 ymin

    exit

  exit

  -- The main driving object for this application
  member .isoAdpApp        is ISOADPAPPLICATION

  -- Data of elements for processing
  member .isoData          is ISODATA

  -- User defaults file
  member .userDefaultsfile is FILE

  -- Current element
  member .ceRefe           is DBREF

  -- Search type
  member .searchType       is STRING

  -- Track
  member .trackElement     is BOOLEAN

  -- Modes
  member .shownModify      is BOOLEAN
  member .shownSearch      is BOOLEAN

  -- Splitting
  member .splitMethod      is STRING
  member .limitsBox        is STRING

  -- Isometric view direction
  member .isoDirection     is REAL

  -- Outputs
  member .outputXls        is BOOLEAN
  member .xlsFolder        is FILE
  member .outputPdf        is BOOLEAN
  member .pdfFolder        is FILE

  -- Modified settings
  member .modified         is BOOLEAN

  member .createLiby       is BOOLEAN
  member .createRegi       is BOOLEAN

  member .drawList         is ARRAY
  member .descList         is ARRAY
  member .printShown       is BOOLEAN
  member .runType          is STRING

  member .department       is DBREF
  member .library          is DBREF
  member .registry         is DBREF

  -- Drawing revision
  member .revision         is ISOREVISION

  member .selectedRows     is ARRAY
  member .headings         is ARRAY

  member .searchFilter     is STRING

  member .preview          is BOOLEAN

  -- Today's date
  member .date             is STRING

  -- Grid output
  member .saveExcel        is FILE

  -- My .net controls
  using namespace 'Aveva.Pdms.Presentation'
  member .detailCntrl      is NETGRIDCONTROL

  member .module           is ISOMODULE

exit

------------------------------------------------------------------------
--
-- Method:      .isoMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoMain()

  -- Pixmaps
  !this.singleRefresh.addPixmap(!!pml.getPathName('refresh.png'))
  !this.searchCe.addPixmap(!!pml.getPathName('refresh.png'))

  !this.singleSetLocDrwgBr.addPixmap(!!pml.getPathName('browse.png'))

  if (!this.module.description.eq('DRAFT')) then
    !this.singleSetIso1.addPixmap(!!pml.getPathName('iso1_small.png'))
    !this.singleSetIso2.addPixmap(!!pml.getPathName('iso2_small.png'))
    !this.singleSetIso3.addPixmap(!!pml.getPathName('iso3_small.png'))
    !this.singleSetIso4.addPixmap(!!pml.getPathName('iso4_small.png'))
  else
    !this.singleSetIso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
    !this.singleSetIso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
    !this.singleSetIso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
    !this.singleSetIso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
  endif

  !this.singleSetOutBrXls.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.singleSetXlsBrFld.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.singleSetOutBrPDF.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.singleSetPdfBrFld.addPixmap(!!pml.getPathName('ad_t_012.png'))

  !this.singleTopBack.addPixmap(!!pml.getPathName('arrow_back.png'))
  !this.singleSetBack.addPixmap(!!pml.getPathName('arrow_back.png'))

  !this.upLevel.addPixmap(!!pml.getPathName('up_level.png'))
--  !this.searchBack.addPixmap(!!pml.getPathName('arrow_back.png'))
  !this.saveListToExcel.addPixmap(!!pml.getPathName('save_to_excel.png'))

  !this.searchSetLocDrwgBr.addPixmap(!!pml.getPathName('browse.png'))

  if (!this.module.description.eq('DRAFT')) then
    !this.searchSetIso1.addPixmap(!!pml.getPathName('iso1_small.png'))
    !this.searchSetIso2.addPixmap(!!pml.getPathName('iso2_small.png'))
    !this.searchSetIso3.addPixmap(!!pml.getPathName('iso3_small.png'))
    !this.searchSetIso4.addPixmap(!!pml.getPathName('iso4_small.png'))
  else
    !this.searchSetIso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
    !this.searchSetIso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
    !this.searchSetIso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
    !this.searchSetIso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
  endif

  !this.searchSetOutBrXls.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.searchSetXlsBrFld.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.searchSetOutBrPDF.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.searchSetPdfBrFld.addPixmap(!!pml.getPathName('ad_t_012.png'))

  !this.searchTopBack.addPixmap(!!pml.getPathName('arrow_back.png'))
  !this.searchSetBack.addPixmap(!!pml.getPathName('arrow_back.png'))

-- FUTURE
--  !this.singleSetTemView.addPixmap(!!pml.getPathName('001.png'))
--  !this.searchSetTemView.addPixmap(!!pml.getPathName('001.png'))

  -- Single Mode callbacks ---------------------------------------------------------------------------------
  !this.searchHvacLink.callback         = |!this.switchMode('HVAC')|
  !this.searchCwayLink.callback         = |!this.switchMode('CWAY')|

  !this.singleRefresh.callback          = |!this.refresh()|
  !this.singleTrack.callback            = |!this.setTracking(!this.singleTrack.val)|

  !this.singleViewSplitLink.callback    = |!this.previewSplit()|
  !this.singleViewSplitLinkM.callback   = |!this.previewSplit()|

  !this.singleSettingsLink.callback     = |!this.modifyMode(true)|
  !this.singleTopBack.callback          = |!this.modifyMode(false)|
  !this.singleSetBack.callback          = |!this.modifyMode(false)|

  !this.singleClearUserLinkM.callback   = |!this.clearUser()|

  !this.singleSetLocDrwg.validatecall   = |!this.checkLocation(|
  !this.singleSetLocDrwgBr.callback     = |!this.browseLocation('REGI',!this.singleSetLocDrwg)|

  !this.singleSetLimF.callback          = |!this.setSplitting('MODIFY',!this.singleSetLimFop1,!this.singleSetLimBox)|
  !this.singleSetLimBox.callback        = |!this.setComplexity(!this.singleSetLimFop1,!this.singleSetLimBox)|

  !this.singleSetIso1.callback          = |!this.setDirection(1)|
  !this.singleSetIso2.callback          = |!this.setDirection(2)|
  !this.singleSetIso3.callback          = |!this.setDirection(3)|
  !this.singleSetIso4.callback          = |!this.setDirection(4)|

  !this.singleSetRevType.callback       = |!this.mode('TYPE')|
  !this.singleSetRevMode.callback       = |!this.mode('MODE')|
  !this.singleSetRevValue.callback      = |!this.mode('VALUE')|

  !this.singleSetOutXls.callback        = |!this.saveSettings()|
  !this.singleSetOutBrXls.callback      = |!this.browse(!this.xlsFolder)|
  !this.singleSetXlsFold.validatecall   = |!this.checkFile(|
  !this.singleSetXlsBrFld.callback      = |!this.browser(!this.singleSetXlsFold,!this.xlsFolder)|
  !this.singleSetOutPDF.callback        = |!this.saveSettings()|
  !this.singleSetOutBrPDF.callback      = |!this.browse(!this.pdfFolder)|
  !this.singleSetPdfFold.validatecall   = |!this.checkFile(|
  !this.singleSetPdfBrFld.callback      = |!this.browser(!this.singleSetPdfFold,!this.pdfFolder)|

  !this.singleSetApply.callback         = |!this.saveUserDefaults()|

  !this.singleProcessStart.callback     = |!this.process()|
  !this.singleProcessStartM.callback    = |!this.process()|

  -- Search mode callbacks ---------------------------------------------------------------------------------
  !this.ceName.callback                 = |!this.checkLocation(|
  !this.upLevel.callback                = |!this.currentElement()|
  !this.searchCe.callback               = |!this.setCe()|
  !this.searchTrack.callback            = |!this.setTracking(!this.searchTrack.val)|
  !this.elementType.callback            = |!this.setType()|
  !this.filterOption.callback           = |!this.searchFilter = !this.filterOption.selection('RTEXT')|
  !this.search.callback                 = |!this.runSearch()|
  !this.advancedSearch.callback         = |!this.showAdv()|

  !this.saveListToExcel.callback        = |!this.browser(!this.saveListToExcel)|

  !this.searchViewSplitLink.callback    = |!this.previewSplit()|
  !this.searchViewSplitLinkM.callback   = |!this.previewSplit()|

  !this.searchBack.callback             = |!this.switchToSingleMode()|

  !this.searchSettingsLink.callback     = |!this.modifyMode(true)|
  !this.searchTopBack.callback          = |!this.modifyMode(false)|
  !this.searchSetBack.callback          = |!this.modifyMode(false)|

  !this.searchClearUserLinkM.callback   = |!this.clearUser()|

  !this.searchSetLocDrwg.validatecall   = |!this.checkLocation(|
  !this.searchSetLocDrwgBr.callback     = |!this.browseLocation('REGI',!this.searchSetLocDrwg)|

  !this.searchSetLimF.callback          = |!this.setSplitting('MODIFY',!this.searchSetLimFop1,!this.searchSetLimBox)|
  !this.searchSetLimBox.callback        = |!this.setComplexity(!this.searchSetLimFop1,!this.searchSetLimBox)|

  !this.searchSetIso1.callback          = |!this.setDirection(1)|
  !this.searchSetIso2.callback          = |!this.setDirection(2)|
  !this.searchSetIso3.callback          = |!this.setDirection(3)|
  !this.searchSetIso4.callback          = |!this.setDirection(4)|

  !this.searchSetRevType.callback       = |!this.mode('TYPE')|
  !this.searchSetRevMode.callback       = |!this.mode('MODE')|
  !this.searchSetRevValue.callback      = |!this.mode('VALUE')|

  !this.searchSetOutXls.callback        = |!this.saveSettings()|
  !this.searchSetOutBrXls.callback      = |!this.browse(!this.xlsFolder)|
  !this.searchSetXlsFold.validatecall   = |!this.checkFile(|
  !this.searchSetXlsBrFld.callback      = |!this.browser(!this.searchSetXlsFold,!this.xlsFolder)|
  !this.searchSetOutPDF.callback        = |!this.saveSettings()|
  !this.searchSetOutBrPDF.callback      = |!this.browse(!this.pdfFolder)|
  !this.searchSetPdfFold.validatecall   = |!this.checkFile(|
  !this.searchSetPdfBrFld.callback      = |!this.browser(!this.searchSetPdfFold,!this.pdfFolder)|

  !this.searchSetApply.callback         = |!this.saveUserDefaults()|

  !this.searchProcessStart.callback     = |!this.process()|
  !this.searchProcessStartM.callback    = |!this.process()|

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCntrl  = object NETGRIDCONTROL()

  -- Create mode column drop-down options
  !options[1] = 'Update'
  !options[2] = 'Recreate'
  !this.detailCntrl.createValueList('Mode', !options)

  -- Add PML event handlers to .net controls
  !this.detailCntrl.addeventhandler('onPopup', !this, 'netPopup')
  !this.detailCntrl.addeventhandler('afterSelectChange', !this, 'netAfterSelectChange')
  !this.detailCntrl.addeventhandler('beforeCellUpdate', !this, 'netBeforeCellUpdate')

  -- Add .net control to PML container
  !this.netDetailList.control = !this.detailCntrl.handle()

  -- Set grid options
  !this.detailCntrl.columnExcelFilter(false)
  !this.detailCntrl.outlookGroupStyle(false)
  !this.detailCntrl.fixedHeaders(true)
  !this.detailCntrl.fixedRows(true)
  !this.detailCntrl.gridHeight(1000.0)
  !this.detailCntrl.editableGrid(true)
  !this.detailCntrl.singleRowSelection(false)
  !this.detailCntrl.headerSort(true)
  !this.detailCntrl.columnSummaries(false)

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Select All', '!this.selAll()')
    !menu.add('separator')
    !menu.add('callback', 'Deselect All', '!this.deselectAll()')
    !menu.add('separator')
    !menu.add('callback', 'Remove Selected', '!this.remove(|SELECTED|)')
    !menu.add('callback', 'Remove All', '!this.remove(|ALL|)')
    !menu.add('separator')
    !menu.add('callback', 'Goto Element', '!this.goToElement()')
    !menu.add('callback', 'Goto Drawing', '!this.goToDrawing()')
    !menu.add('separator')
    !menu.add('callback', 'Display Details', '!this.displayDetails()')

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Valid')
  !this.headings.append('Drawn')
  !this.headings.append('Access')
  !this.headings.append('Mode')

  -- Set the user defaults file
  !this.userDefaultsfile = object FILE('%PDMSUSER%\DRA-ISO-ADP-USERDEFAULTS')

  -- For the time being deactivate the stop buttons
  !this.singleProcessStop.visible  = false
  !this.singleProcessStopM.visible = false
  !this.searchProcessStop.visible  = false
  !this.searchProcessStopM.visible = false

endmethod
-- End of method definition for .isoMain()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Set the element types for searching. depending on the library being available
  -- The 11.6 version did not handle cable way, as the new library does it is marked as able to do so
  if (!this.isoAdpApp.data.stdLibrary.func.eq('Isometrics ADP with CWAY')) then
    !typeDtext[2] = 'CWAY'
  endif
  !typeDtext[1] = 'HVAC'
  !this.elementType.dtext = !typeDtext
  !this.elementType.rtext = !typeDtext

  -- Set up a global command to stop resize warnings
  WARNINGS OFF

  -- Initialise the form as searching for elements to detail
  !this.shownSearch = true

  -- Set mode
  !this.shownModify    = false

  -- Force into design
  CONTEXT DESIGN

  -- Track the current element
  !this.searchTrack.val = true
  !this.setTracking(true)

  -- Initialise the search grid and all data
  !this.clearAll()

  -- Set defaults
  !this.setDefaults()

  -- Load the revision settings
  !this.revision = !this.isoAdpApp.revision

  -- Set settings gadgets
  !this.setSettings()

  -- Set to NOT create hierarchy
  !this.createLiby = false
  !this.createRegi = false

  -- Load any user defaults
  !this.loadUserDflts()

  -- Make sure that the edit form is not displayed when the main form is
  if !!isoEdit.shown() then
    !!isoEdit.hide()
  endif

  -- Read the default element type to be used as the source for isometrics
  !this.searchType = !this.elementType.selection('RTEXT')

  -- Set search pull-down filter options
  !dtext.append('Those not drawn')
  !rtext.append('NOT DRAWN')
  !dtext.append('Those drawn')
  !rtext.append('DRAWN')
  !dtext.append('Those drawn by me')
  !rtext.append('DRAWN BY ME')
  !dtext.append('Bad Drawing Reference')
  !rtext.append('BADREF')
  !dtext.append('All')
  !rtext.append('ALL')
  !this.filterOption.dtext = !dtext
  !this.filterOption.rtext = !rtext

  -- Read search filter option
  !this.searchFilter = !this.filterOption.selection()

  -- Set the single drawn action to update
  !this.singleUpdate.val = true

  -- Set the main application object
  !this.store()

  -- Set default save directory and file
  !this.saveExcel = object FILE('%PDMSUSER%\isometric drawing report.xls')

   -- Set interrupt
  !!fmsys.setInterrupt(!this.singleProcessStop)
  !!fmsys.setInterrupt(!this.singleProcessStopM)
  !!fmsys.setInterrupt(!this.searchProcessStop)
  !!fmsys.setInterrupt(!this.searchProcessStopM)

  -- Mark settings as not modified
  !this.modified(false)

  -- Set the grid pop-up menu for nothing selected
  !this.setPopUpActive(false)

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .browse(FILE)
--
-- Description: Start windows browser for output
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Folder to open
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browse(!folder is FILE)

  -- Check for existing folder
  if (!folder.exists().not()) then

    -- Create the folder
    !folderPath = !folder.directory().fullName() & '\' & !folder.entry()
    !this.createFolder(!folderPath)
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  endif

  -- Open Windows Explorer view of the passed folder
  !command = 'explorer /root,"' & !folder.fullName() & '"'
  SYSCOM '$!command'

endmethod
-- End of method definition for .browse(FILE)

------------------------------------------------------------------------
--
-- Method:      .browseLocation(STRING,GADGET)
--
-- Description: Browse for an element of a passed type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      The type of element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browseLocation(!type is STRING, !gadget is GADGET)

  -- Load the browse form
  pml reload form !!isoBrowse

  -- Set the browse form to search for the element type
  -- and return the value to the passed gadget
  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  !!isoBrowse.show('cen',0.5,0.5)

endmethod
-- End of method definition for .browseLocation(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser for Excel output
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!gadget is GADGET)

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !directory       = !this.saveExcel.directory().fullName()
  !seedFile        = !this.saveExcel.entry()
  !title           = 'Save Drawing Report as Excel'
  !extensionString = 'xls files (*.xls)|*.xls'
  !browser = object PMLFILEBROWSER('SAVE')

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Write the output file
    !this.saveExcel(object FILE(!browser.file()))

  endif

endmethod
-- End of method .browser(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET,FILE)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!gadget is GADGET, !file is FILE)

  -- Load the .net file browser
  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !folderBrowser = object PMLFOLDERBROWSER()

  !folderBrowser.selectedPath(!file.fullName())
  handle ANY
    !folderBrowser.selectedPath(!file.directory().fullName())
    handle ANY
      var !folderPath evar TEMP
      !folderBrowser.selectedPath(!folderPath)
    endhandle
  endhandle

  !folderBrowser.show('Select Output Folder',true)

  -- Set the gadget unless the browser was cancelled
  if (!folderBrowser.selectedPath().neq('')) then
    !gadget.val = !folderBrowser.selectedPath()

  endif

  !gadget.refresh()

  -- Save the settings
  !this.saveSettings()

endmethod
-- End of method .browser(GADGET,FILE)

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Switch to draft db
  VAR !ddl DDL
  if (!ddl.match('DESI').gt(0))then
    SWITCH
  endif

  -- Hide form
  !this.hide()

  -- Clear drawlist
  !this.drawList.clear()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .currentElement()
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElement()

  -- Go up one level in the hierarchy
  if (!!ce.type.upCase().neq('WORL')) then
    END

  endif

  -- Add ce
  !this.ceRefe     = !!ce
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .currentElement()

------------------------------------------------------------------------
--
-- Method:      .currentElement(DBREF)
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The current element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElement(!element is DBREF)

  -- Add ce
  !this.ceRefe     = !element
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .currentElement(DBREF)

------------------------------------------------------------------------
--
-- Method:      .checkFile(GADGET,STRING)
--
-- Description: Check the entered file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget making the call
--    2   R      STRING      Dummy string 'VALIDATE'
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkFile(!gadget is GADGET, !dummyString is STRING)

  -- Test for a null string
  !firstChar = !gadget.val.substring(1,1)

  if (!firstChar.eq('') or !firstChar.eq(' ')) then

    if (!gadget.name().eq('SINGLESETXLSFOLD')) then
      !this.browser(!this.singleSetXlsFold,!this.xlsFolder)

    elseif (!gadget.name().eq('SINGLESETPDFFOLD')) then
      !this.browser(!this.singleSetPdfFold,!this.pdfFolder)

    endif

    return

  endif

  -- Test for existing file and whether it is a folder
  !file = object FILE(!gadget.val)

  if (!file.exists()) then

    if (!file.type().neq('DIRECTORY')) then

      !errorText = 'The entered pathname ' & !gadget.val & ' is not a folder. Please try again!'
      return error 1 '$!errorText'

    else

      -- Save settings
      !this.saveSettings()
      return

    endif

  else

    !errorText = 'The entered pathname ' & !gadget.val & ' does not exist. Please try again!'
    return error 1 '$!errorText'

  endif

endmethod
-- End of method definition for .checkFile(GADGET,STRING)

------------------------------------------------------------------------
--
-- Method:      .checkLocation(GADGET,STRING)
--
-- Description: Check that the entered element exists and is of the correct type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget making the call
--    2   R      STRING      Dummy string 'VALIDATE'
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkLocation(!gadget is GADGET, !dummyString is STRING)

  -- Initialise variables
  if (!gadget.name().eq('SINGLESETLOCDRWG')) then
    !type    = 'REGI'
--    !default = !this.registry

  else
    return
  endif

  -- Get the entered element
  !elemString = !gadget.val
  !firstChar  = !elemString.substring(1,1)

  -- Check for null string, in which case show the browser
  if (!firstChar.eq('') or !firstChar.eq(' ')) then
    !this.browseLocation(!type,!gadget)
    return

  endif

  -- Check for leading slash
  if (!firstChar.neq('=') and !firstChar.neq('/')) then
    !elemString = '/' & !elemString
  endif

  -- For an existing element, test its type
  VAR !exists EXISTS $!elemString

  if (!exists.eq('TRUEA')) then

    !elemRefe = !elemString.dbref()

    -- The element if of a matching type
    if (!elemRefe.type.eq(!type)) then

      -- Reset the display value in case of a missing slash
      !gadget.val = !elemString

      !this.saveSettings()

      return

    endif

    !errorText = 'The element ' & !elemRefe.type & !elemString & ' is not of type ' & !type & '. Please try again!'
    return error 1 '$!errorText'

  -- For an element which does not exist
  else

    !errorText = 'The element ' & !elemString & ' does not exist. Please try again!'
    return error 1 '$!errorText'

  endif

endmethod
-- End of method definition for .checkLocation(GADGET,STRING)

------------------------------------------------------------------------
--
-- Method:      .clearAll()
--
-- Description: Clear variables
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearAll()

  -- Deselect all detail list entries
  !this.detailCntrl.clearGrid()
  !this.drawList.clear()
  !this.descList.clear()
  !this.isoData.clear()

endmethod
-- End of method definition for .clearAll()

------------------------------------------------------------------------
--
-- Method:      .clearUser()
--
-- Description: Clear saved user settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearUser()

  if (!!alert.confirm('This will reset all settings to their default values. Are you sure that you want to clear your personal settings? ').eq('YES')) then

    !this.userDefaultsfile.deleteFile()

    !this.setDefaults()

    !this.setSettings()

    !this.modified(false)

    !this.userDefaultsfile.deleteFile()

  endif

endmethod
-- End of method definition for .clearUser()

------------------------------------------------------------------------
--
-- Method:      .deselectAll()
--
-- Description: Deselect all selections in the grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deselectAll()

  -- Clear the grid of any selected rows
  !this.detailCntrl.clearRowSelection()

  -- Set the grid pop-up menu for nothing selected
  !this.setPopUpActive(false)

endmethod
-- End of method definition for .deselectAll()

------------------------------------------------------------------------
--
-- Method:      .displayDetails()
--
-- Description: Display details about the element selected in the grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayDetails()

  -- Load the display form
  if (undefined(!!isoGridDetails)) then
    pml load form !!isoGridDetails

  endif

  -- Pass the data to the display form
  !!isoGridDetails.setData(!this.isoData, !this.detailCntrl.getSelectedRowTags())

  -- Update the settings in the form
  !!isoGridDetails.display()

  -- Display the form
  !!isoGridDetails.show('CEN',0.8, 0.5)

endmethod
-- End of method definition for .displayDetails()

------------------------------------------------------------------------
--
-- Method:      .getSettings()
--
-- Description: Get the setting on this form that are used during the process run
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSettings() is ARRAY

  !settings = ARRAY()

  !settings.append(!this.library)
  !settings.append(!this.registry)
  !settings.append(!this.splitMethod)
  !settings.append(!this.limitsBox.real())
  !settings.append(!this.isoDirection)
  !settings.append(!this.revision)
  !settings.append(!this.outputXls)
  !settings.append(!this.xlsFolder)
  !settings.append(!this.outputPdf)
  !settings.append(!this.pdfFolder)
  !settings.append(!this.searchType)

  return !settings

endmethod
-- End of method definition for .getSettings()

------------------------------------------------------------------------
--
-- Method:      .goToDrawing()
--
-- Description: Navigate to drawing associated with the selected element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goToDrawing()

  -- Check for anything selected
  if (!this.selectedRows.unset()) then
    return

  endif

  -- For multiple selections goto the first
  -- Get index of selected element in the array
  !index = !this.detailCntrl.getSelectedRowTags()[1].real()

  -- Find the element in the data object
  !drwgRefe = !this.isoData.dwgRefs[!index]

  -- Access the drawing
  if (!this.isoData.drawn[!index].match('No').neq(0)) then
    !!alert.message(|The element | & |'| & !this.isoData.names[!index] & |'| & | has not been drawn.|)
  else
    !!ce = !drwgRefe
  endif

endmethod
-- End of method definition for .goToDrawing()

------------------------------------------------------------------------
--
-- Method:      .goToElement()
--
-- Description: Navigate to the selected element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goToElement()

  -- Check for anything selected
  if (!this.selectedRows.unset()) then
    return

  endif

  -- Force tracking off, otherwise form will switch to single mode
  !this.setTracking(false)

  -- For multiple selections goto the first
  -- Get index of selected element in the array
  !index = !this.detailCntrl.getSelectedRowTags()[1].real()

  -- Find the element in the data object
  !elementRefe = !this.isoData.dbRefes[!index]

  -- Access the element
  if (!elementRefe.badref()) then
    !!alert.message(|The element | & |'| & !this.isoData.names[!index] & |'| & | has been deleted since the report was made.|)
  else
    !!ce = !elementRefe
  endif

endmethod
-- End of method definition for .goToElement()

------------------------------------------------------------------------
--
-- Method:      .hiddenPreview()
--
-- Description: Update this form when the preview form is hidden
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hiddenPreview()

  -- Set tracking back to on
  !this.setTracking(true)

  -- Set the refresh button back to off
  !this.setRefresh(false)

  -- Reset the preview links
  !this.singleViewSplitLink.tag  = 'Preview Spooling'
  !this.singleViewSplitLinkM.tag = 'Preview Spooling'
  !this.searchViewSplitLink.tag  = 'Preview Spooling'
  !this.searchViewSplitLinkM.tag = 'Preview Spooling'

  -- Allow preview of splitting
  !this.preview = true

endmethod
-- End of method definition for .hiddenPreview()

------------------------------------------------------------------------
--
-- Method:      .hidePreview(BOOLEAN)
--
-- Description: Hide the preview form when shown
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether tracking is turned on or off
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hidePreview(!track is BOOLEAN)

  -- Check that the form is shown
  if (!!isoModelView.shown()) then

    -- Hide the form
    !!isoModelView.hide()

    -- Set the refresh button off
    !this.setRefresh(false)

    -- Reset the preview task gadgets
    !this.singleViewSplitLink.tag  = 'Preview Spooling'
    !this.singleViewSplitLinkM.tag = 'Preview Spooling'
    !this.searchViewSplitLink.tag  = 'Preview Spooling'
    !this.searchViewSplitLinkM.tag = 'Preview Spooling'

    -- Set preview on
    !this.preview = true

  endif

endmethod
-- End of method definition for .hidePreview(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .include(ARRAY)
--
-- Description: Include the passed elements in the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .include(!allElements is ARRAY)

  -- Clear the grid and data object
  !this.detailCntrl.clearGrid()
  !this.isoData.clear()

  -- Get the data for the current element
  !this.isoData.getData(!allElements, !this.searchFilter, !this.isoAdpApp.data.drwgNameRule, !this.isoAdpApp.data.backingSheet)

  -- Build row data
  !rowSet = !this.isoData.buildData(false)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCntrl.bindToDataSource(object NETDATASOURCE('Elements', !this.headings, !rowSet, '^Name'))

  -- Set the mode column editable
  !this.detailCntrl.setEditableColumn(1,false)
  !this.detailCntrl.setEditableColumn(2,false)
  !this.detailCntrl.setEditableColumn(3,false)
  !this.detailCntrl.setEditableColumn(4,false)
  if (!this.searchFilter.eq('DRAWN') or !this.searchFilter.eq('DRAWN BY ME')) then
    !this.detailCntrl.setEditableColumn(5,true)
    !this.detailCntrl.assignValueListToColumn('Mode', 5)
  else
    !this.detailCntrl.setEditableColumn(5,false)
  endif

  -- Set the cells for element valid contents
  !this.setIcon(2, !this.isoData.contents)

  -- Set the cells for locked element
  !this.setIcon()

endmethod
-- End of method definition for .include(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .loadUserDflts()
--
-- Description: Load user defaults if available
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadUserDflts()

  -- Look for the user defaults file
  if (!this.userDefaultsfile.exists()) then

    -- Get the defaults file contents
    !contents = !this.userDefaultsfile.readfile()

    -- Select the search type
    -- But check if CWAY is available as we might be running a pre-12 version
    -- In which case we have knocked out CWAY as the old libraries do not support it
    if (!this.elementType.rtext.findFirst(!contents[1].after('=').trim('lr')).set()) then
      !this.elementType.select('RTEXT', !contents[1].after('=').trim('lr'))
    endif

    -- Drawing location
    !registry = !contents[2].after('=').trim('lr')

    VAR !exists EXISTS $!registry

    if (!exists.eq('TRUEA')) then
      !this.registry = !registry.dbref()

    endif

    -- Splitting
    !this.splitMethod  = !contents[3].after('=').trim('lr')
    if (!this.splitMethod.eq('VOLUME')) then
      !this.singleSetLimFop1.val   = true
      !this.searchSetLimFop1.val   = true
      !this.singleSetLimBox.active = true
      !this.searchSetLimBox.active = true

    else
      !this.singleSetLimFop2.val   = true
      !this.searchSetLimFop2.val   = true
      !this.singleSetLimBox.active = false
      !this.searchSetLimBox.active = false

    endif

    -- Set the complexity
    !this.limitsBox = !contents[4].after('=').trim('lr')

    -- Select the complexity
    -- If the value is not available
    if (!this.singleSetLimBox.rtext.findFirst(!this.limitsBox).unset()) then
      !this.singleSetLimBox.select('DTEXT','100%')
      !this.searchSetLimBox.select('DTEXT','100%')

    -- The value is available
    else
      !this.singleSetLimBox.select('RTEXT',!this.limitsBox)
      !this.searchSetLimBox.select('RTEXT',!this.limitsBox)

    endif

    -- North direction
    !this.singleSetIso1.val = false
    !this.singleSetIso2.val = false
    !this.singleSetIso3.val = false
    !this.singleSetIso4.val = false

    !isoDirection = !contents[5].after('=').trim('lr').real()

    if (!isoDirection.eq(1)) then
      !this.singleSetIso1.val = true

    elseif (!isoDirection.eq(2)) then
      !this.singleSetIso2.val = true

    elseif (!isoDirection.eq(3)) then
      !this.singleSetIso3.val = true

    elseif (!isoDirection.eq(4)) then
      !this.singleSetIso4.val = true

    endif

    !this.isoDirection = !isoDirection

    -- Output
    !this.singleSetOutXls.val  = !contents[6].after('=').trim('lr').boolean()
    !this.singleSetXlsFold.val = !contents[7].after('=').trim('lr')
    !this.searchSetOutXls.val  = !contents[6].after('=').trim('lr').boolean()
    !this.searchSetXlsFold.val = !contents[7].after('=').trim('lr')

    !this.singleSetOutPDF.val  = !contents[8].after('=').trim('lr').boolean()
    !this.singleSetPdfFold.val = !contents[9].after('=').trim('lr')
    !this.searchSetOutPDF.val  = !contents[8].after('=').trim('lr').boolean()
    !this.searchSetPdfFold.val = !contents[9].after('=').trim('lr')

    !this.outputXls = !contents[6].after('=').trim('lr').boolean()
    !this.xlsFolder = object FILE(!contents[7].after('=').trim('lr'))
    !this.outputPdf = !contents[8].after('=').trim('lr').boolean()
    !this.pdfFolder = object FILE(!contents[9].after('=').trim('lr'))

  endif

endmethod
-- End of method definition for .loadUserDflts()

------------------------------------------------------------------------
--
-- Method:      .mode(STRING)
--
-- Description: Set revision mode
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gagdet argument TYPE, MODE or VALE
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mode(!argument is STRING)

  -- Define which gadgets depending on which mode either single or search
  if (!this.shownSearch) then

    !revType  = !this.searchSetRevType
    !revMode  = !this.searchSetRevMode
    !revValue = !this.searchSetRevValue

  else

    !revType  = !this.singleSetRevType
    !revMode  = !this.singleSetRevMode
    !revValue = !this.singleSetRevValue

  endif

  -- Test for specific revision
  if (!argument.neq('VALUE')) then

    if (!revMode.selection('DTEXT').eq('Specific')) then

      -- Set value option active
      !revValue.active = true

      if (!revType.selection('DTEXT').eq('Internal')) then

        -- Refill gadget
        !text[1] = ' '
        !text.appendArray(!this.isoAdpApp.data.internalRev)
        !revValue.dtext = !text
        !revValue.rtext = !text

        -- Make selection depending on default
        if (!this.isoAdpApp.data.startRev.upCase().eq('INTERNAL')) then
          !revValue.select('RTEXT',!this.isoAdpApp.data.initialRev)
        else
          !revValue.select('RTEXT',!this.isoAdpApp.data.internalRev[1])
        endif

      else

        -- Refill gadget
        !text[1] = ' '
        !text.appendArray(!this.isoAdpApp.data.externalRev)
        !revValue.dtext = !text
        !revValue.rtext = !text

        -- Make selection depending on default
        if (!this.isoAdpApp.data.startRev.upCase().eq('EXTERNAL')) then
          !revValue.select('RTEXT',!this.isoAdpApp.data.initialRev)
        else
          !revValue.select('RTEXT',!this.isoAdpApp.data.externalRev[1])
        endif

      endif

    else

      !revValue.select('RTEXT',' ')
      !revValue.active = false

    endif

  endif

  -- Mark settings as having been modified
  !this.modified(true)

  -- Set the revision object
  !this.revision.revType      = !revType.selection()
  !this.revision.revMode      = !revMode.selection()
  !this.revision.revInitValue = !revValue.selection()

  -- Pass the settings to the main application object
  !this.isoAdpApp.revision = !this.revision

endmethod
-- End of method definition for .mode(STRING)

------------------------------------------------------------------------
--
-- Method:      .modified(BOOLEAN)
--
-- Description: Set form as having had its settings modified
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modified(!modified is BOOLEAN)

  -- Set form status
  !this.modified = !modified

  -- Change the settings title text to indicate that they have been modified
  if (!modified) then

    !this.singleSetP.val = 'Settings*'
    !this.searchSetP.val = 'Settings*'
    !this.singleSetApply.active = true
    !this.searchSetApply.active = true

  else

    !this.singleSetP.val = 'Settings'
    !this.searchSetP.val = 'Settings'
    !this.singleSetApply.active = false
    !this.searchSetApply.active = false

  endif

endmethod
-- End of method definition for .modified(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .modifyMode(BOOLEAN)
--
-- Description: Switch modify mode on or off
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Modify mode
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMode(!onOff is BOOLEAN)

  -- Store the status
  !this.shownModify = !onOff

  -- Single on, Modify on, Search off
  if (!this.shownModify and !this.shownSearch.not()) then

-- $P Single ON Modify ON Search OFF

    !this.singleSettingsLink.visible     = false
    !this.singleSet.visible              = true
    !this.singleProcess.visible          = false
    !this.singleProcessModify.visible    = true
    !this.singleTask.visible             = false
    !this.singleTaskModify.visible       = true

  -- Single off, Modify off, Search on
  elseif (!this.shownModify.not() and !this.shownSearch) then

-- $P Single OFF Modify OFF Search ON

    !this.searchSettingsLink.visible     = true
    !this.searchSet.visible              = false
    !this.searchProcess.visible          = true
    !this.searchProcessModify.visible    = false
    !this.searchTask.visible             = true
    !this.searchTaskModify.visible       = false

  -- Single off, Modify on, Search on
  elseif (!this.shownModify and !this.shownSearch) then

-- $P Single OFF Modify ON Search ON

    !this.searchSettingsLink.visible     = false
    !this.searchSet.visible              = true
    !this.searchProcess.visible          = false
    !this.searchProcessModify.visible    = true
    !this.searchTask.visible             = false
    !this.searchTaskModify.visible       = true

  -- Single on, Modify off, Search off
  else

-- $P Single ON Modify OFF Search OFF

    !this.singleSettingsLink.visible     = true
    !this.singleSet.visible              = false
    !this.singleProcess.visible          = true
    !this.singleProcessModify.visible    = false
    !this.singleTask.visible             = true
    !this.singleTaskModify.visible       = false

  endif

  -- Check for saved user settings
  if (!this.userDefaultsfile.exists()) then
    !this.singleClearUserLinkM.active = true
    !this.singleSettingsLink.tag      = 'Modify User Settings'
    !this.searchSettingsLink.tag      = 'Modify User Settings'

  -- We are using default settings
  else
    !this.singleClearUserLinkM.active = false
    !this.singleSettingsLink.tag      = 'Modify Settings'
    !this.searchSettingsLink.tag      = 'Modify Settings'

  endif

endmethod
-- End of method definition for .modifyMode(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .netAfterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChange(!array is ARRAY)

  -- Set the pop-up menu options active
  !this.setPopUpActive(true)

  -- Check if the selected entry is drawn
  if (!this.detailCntrl.getSelectedRowTags().set()) then

    -- For drawn set the option active
    if (!this.isoData.drawn[!this.detailCntrl.getSelectedRowTags()[1].real()].match('Yes').neq(0)) then
      !this.defPopUp.setActive('Goto Drawing', true)

    -- For not drawn set the option inactive
    else
      !this.defPopUp.setActive('Goto Drawing', false)

    endif

  endif

  ---------------------------------------------------------
  -- Disable "Goto Element" in case more than one element
  -- is selected in the grid
  if (!array[0].size().gt(1)) then
    !this.defPopup.setActive('Goto Element', false)
  else
    !this.defPopup.setActive('Goto Element', true)
  endif
  ---------------------------------------------------------

  -- Set preview gadget visibility
  !this.visibility()

  -- For any selected elements
  if (!this.detailCntrl.getSelectedRowTags().size().neq(0)) then

    -- If the preview is shown then redo for the selected element, if different to the once currently shown
    if (!!isoModelView.shown()) then

      -- Update the model preview form split settings in case of main form changes
      !this.setPreviewSettings()

      -- Check the first selected one is not the displayed one
      !firstSelectedRowIndex = !this.detailCntrl.getSelectedRowTags()[1].real()
      !selRefe               = !this.isoData.dbRefes[!firstSelectedRowIndex]

      if (!selRefe.neq(!!isoModelView.elementRefe)) then

        -- Split the element into spools
        !!isoModelView.split(!selRefe, !this.splitMethod, !this.limitsBox, !this.isoDirection)

      endif

      -- Ensure that the preview form will be closed on the next call from the 'Close Preview Spooling' gadget
      !this.preview = false

    endif

  endif

endmethod
-- End of method definition for .netAfterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .netBeforeCellUpdate()
--
-- Description: Callback on grid control before cell update
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      STRING      The new value selected from the option list
--                           or if string does not match any of those in the list
--                           the entered string
--    1   R      BOOLEAN     A return argument to confirm valid field - false aborts the update
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netBeforeCellUpdate(!array is ARRAY)

  -- Test returned value is valid for this entry
  if (!array[1].neq('1') and !array[1].neq('2') and !array[1].neq('3')) then
    !!alert.error('Invalid value. Please try again')
    !array[4] = false
  endif

endmethod
-- End of method definition for .netBeforeCellUpdate()

------------------------------------------------------------------------
--
-- Method:      .netPopup()
--
-- Description: Pop-up for grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!array is ARRAY)

  -- Show the pop-up
   !this.netDetailList.popup = !this.defPopUp
   !this.netDetailList.showPopup(!array[0], !array[1])

  -- Return the selected elements
  if (defined(!array[2])) then
    !this.selectedRows = !array[2]

  -- Otherwise clear the selected array
  else
    !this.selectedRows.clear()

  endif

endmethod
-- End of method definition for .netPopup()

------------------------------------------------------------------------
--
-- Method:      .previewSplit()
--
-- Description: Preview the spool splitting
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .previewSplit()

  -- Remember the current tracking status
  !track = !this.trackElement

  -- Get the element to split from the search grid
  if (!this.shownSearch) then

    -- Get the first selected element
    !firstSelectedRow = !this.detailCntrl.getSelectedRowTags()[1].real()

    -- Check that the selected element is valid
    if (!this.isoData.contents[!firstSelectedRow].not()) then

      -- Get the selected element from the data object
      !elemRefe = !this.isoData.dbRefes[!firstSelectedRow]

      -- Give warning
      if (!this.searchType.eq('HVAC')) then
        !!alert.warning('Cannot preview ' & !elemRefe.type & !elemRefe.flnn & ' as it does not contain any components')

      elseif (!this.searchType.eq('CWAY')) then
        !!alert.warning('Cannot preview ' & !elemRefe.type & !elemRefe.flnn & ' as it either has no components or more than one CTMTRL element')

      endif

      -- We are done
      return

    endif

  -- The element to split is the currently selected element
  else
    !elemRefe = !this.ceRefe

  endif

  -- Open the preview form
  if (!this.preview) then

    if (!!isoModelView.shown().not()) then

      -- Pass the data needed to split into spools
      !this.setPreviewSettings()

      -- Search mode
      if (!this.shownSearch) then

        -- Display the first selected element after splitting using the current limits box
        !selIndex = !this.detailCntrl.getSelectedRowTags()[1].real()
        !selRefe  = !this.isoData.dbRefes[!selIndex]

      -- Single Mode
      else

        -- Display the current element after splitting using the current limits box
        !selRefe  = !this.ceRefe

      endif

      -- Split the element into spools
      !errors = !!isoModelView.split(!selRefe, !this.splitMethod, !this.limitsBox, !this.isoDirection)

      -- As long as there are no returned errors when displaying the spools
      if (!errors.not()) then

        !this.singleViewSplitLink.tag  = 'Close Preview Spooling'
        !this.singleViewSplitLinkM.tag = 'Close Preview Spooling'
        !this.searchViewSplitLink.tag  = 'Close Preview Spooling'
        !this.searchViewSplitLinkM.tag = 'Close Preview Spooling'

        -- Do not track the current element whilst selection splitting
        !this.setTracking(false)

      endif

    endif

    -- Set preview off
    !this.preview = false

  -- Close the preview form & hide the refresh button
  else
    !this.hidePreview(!track)
    !this.hiddenPreview()

  endif

endmethod
-- End of method definition for .previewSplit()

------------------------------------------------------------------------
--
-- Method:      .process()
--
-- Description: Process isometrics
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .process()

  -- Initialise variables
  !this.isoAdpApp.clear()

  -- Check for selected elements if we are using the search grid
  if (!this.shownSearch) then

    -- Get the selected elements
    !selected       = !this.detailCntrl.getSelectedRowTags()
    !selectedArray  = !this.detailCntrl.getSelectedRows()

    -- Check for anything selected
    if (!selected.empty()) then
      !!alert.warning('You have not selected any elements to process. Please try again!')
      return
    endif

  endif

  -- Get device
  VAR !device DEVICE

  -- Get the elements to process
  -- Search mode
  if (!this.shownSearch) then

    -- Set the selected data in the main application object for processing
    do !index ind !selected

      -- Initialise variables
      !selectedTag = !selected[!index].real()
      !rowArray    = !selectedArray[!index]
      !elemRefe    = !this.isoData.dbRefes[!selectedTag]
      !drawn       = !this.isoData.drawn[!selectedTag].match('Yes').neq(0)
      !access      = !this.isoData.access[!selectedTag].match('Yes').neq(0)
      !validFont   = !this.isoData.validFont[!selectedTag]

      -- Check that the selected element is valid
      if (!this.isoData.contents[!selectedTag].not()) then
        !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as it does not contain any elements. It will be ignored')
        skip
      endif

      -- Check that any existing drawing for the selected element is writeable
      if (!drawn and !access.not()) then
        !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as the existing drawing is Read Only. It will be ignored')
        skip
      endif

      -- Check for a valid font
      if (!validFont.not()) then
        !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as the existing drawing has an incompatible Font. It will be ignored')
        skip
      endif

      -- Add the elements selected for processing
      !this.isoAdpApp.elements.append(!elemRefe)

      -- Get update type for existing drawings
      if (!rowArray[3].match('Yes').neq(0)) then

        -- Update the drawing
        if (!rowArray[5].eq('1') or !rowArray[5].upCase().eq('UPDATE')) then
          !this.isoAdpApp.updates.append(true)

        -- Recreate the drawing
        else
          !this.isoAdpApp.updates.append(false)
        endif

      -- Create the drawing
      else
        !this.isoAdpApp.updates.append(false)
      endif

    enddo

  -- Single mode
  else

    -- Initialise variables
    !isoData        = object ISODATA()
    !elemRefe       = !this.ceRefe
    !allElements[1] = !this.ceRefe.string()

    -- Get the data for the current element
    if (!this.singleUpdate.visible) then
      !isoData.getData(!allElements, 'DRAWN', !this.isoAdpApp.data.drwgNameRule, !this.isoAdpApp.data.backingSheet)

    else
      !isoData.getData(!allElements, 'NOT DRAWN', !this.isoAdpApp.data.drwgNameRule, !this.isoAdpApp.data.backingSheet)

    endif

    -- Extract current element data
    !drawn     = !this.isoData.drawn[1].match('Yes').neq(0)
    !access    = !this.isoData.access[1].match('Yes').neq(0)
    !validFont = !this.isoData.validFont[1]

    -- Check that the selected element is valid i.e. contains material elements
    if (!isoData.contents[1].not()) then
      !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as it does not contain any elements.')
      return
    endif

    -- Check that any existing drawing for the selected element is writeable
    if (!drawn and !access.not()) then
      !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as the existing drawing is Read Only.')
      return
    endif

    -- Check for a valid font
    if (!validFont.not()) then
      !!alert.warning('Cannot process ' & !elemRefe.type & !elemRefe.flnn & ' as the existing drawing has an incompatible Font.')
      return
    endif

    -- Process the current element
    !this.isoAdpApp.elements.append(!this.ceRefe)

    -- For an existing drawing
    if (!this.singleUpdate.visible) then

      if (!this.singleUpdate.val) then
        !this.isoAdpApp.updates.append(true)
      else
        !this.isoAdpApp.updates.append(false)
      endif

    -- Drawing does not exist so create it
    else
      !this.isoAdpApp.updates.append(false)
    endif

  endif

  -- Check for nothing to process
  if (!this.isoAdpApp.elements.empty()) then
    return
  endif

  -- Check if the chosen REGI has been deleted since the application was loaded
  if (!this.registry.badref()) then
    !!alert.error('The destination REGI ' & !this.registry.flnn & ' does not exist, please select another and try again.')
    return

  endif

  -- Check if the chosen REGI can be written to
  if (!this.registry.dbwrite.not()) then
    !!alert.error('The destination REGI ' & !this.registry.flnn & ' cannot be written to, please select another and try again.')
    return

  endif

  -- Check if the chosen REGI has compatible font settings
  if (!this.isoAdpApp.data.backingSheet.font.gt(4)) then
    !backingSheetFont = 'TRUETYPE'
  else
    !backingSheetFont = 'NATIVE'
  endif

  if (!this.registry.font.gt(4)) then
    !registryFont = 'TRUETYPE'
  else
    !registryFont = 'NATIVE'
  endif

  if (!registryFont.neq(!backingSheetFont)) then
    !!alert.error('The destination REGI ' & !this.registry.flnn & ' has an incompatible font setting.')
    return

  endif

  -- check Excel output folder
  if !this.outputXls.and(!this.xlsFolder.exists().not()) then
    !this.createFolder(!this.xlsFolder.string())
    handle ANY
      !!alert.error('Folder for MS Excel files does not exists and cannot be created. MTO files will not be produced!')
      if !this.shownSearch then
        !this.searchSetOutXls.val = false
      else
        !this.singleSetOutXls.val = false
      endif
      !this.saveSettings()
    endhandle
  endif
  -- check PDF output folder
  if !this.outputPdf.and(!this.pdfFolder.exists().not()) then
    !this.createFolder(!this.pdfFolder.string())
    handle ANY
      !!alert.error('Folder for PDF files does not exists and cannot be created. PDF files will not be produced!')
      if !this.shownSearch then
        !this.searchSetOutPDF.val = false
      else
        !this.singleSetOutPDF.val = false
      endif
      !this.saveSettings()
    endhandle
  endif

  -- Set logfile
  !!isoLog = object ISOLOG()
  !!isoLog.set()
  !!isoLog.alphaStart()

  -- Show process message form
  if (!device.upCase().eq('GRAPHICS')) then
    !!isoProcess.show('CEN',0.5,0.5)
  endif

  -- Create the drawings and get back an array of display drawing objects
  !displayDrwgs = !this.isoAdpApp.makeDrawings(!this.searchType)

  -- Finish up
  if (!device.upCase().eq('GRAPHICS')) then

    -- Display edit drawings form with the produced drawings
    show !!isoEdit free
    !!isoEdit.selected = !displayDrwgs
    !!isoEdit.load()

    -- Hide process message form
    !!isoProcess.hide()
    !!fmsys.setProgress(0)

    -- If the search filter is set to those not drawn, clear the selected to prevent it being selected again
    if (!this.searchFilter.eq('NOT DRAWN') or !this.searchFilter.eq('BADREF') or !this.searchFilter.eq('ALL')) then
      !this.detailCntrl.deleteSelectedRows()
    endif

    -- Attempt to close the preview, as we are removing the detailed element from the grid
    !this.hidePreview(!this.trackElement)

  endif

  -- Store log
  !this.isoAdpApp.log = !!isoLog

  -- Write logfile
  !!isoLog.alphaEnd()
  !!isoLog.write()

endmethod
-- End of method definition for .process()

------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: Refresh this and the preview form for the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  -- We are refreshing the forms because when the preview form is shown, this form tracking is switched off
  -- It allows the user to rest the forms to the CE without having to close the preview first
  -- The CE needs to be a valid single element otherwise it is pointless.
  -- We are not going to switch into search mode as would otherwise be the case

  -- Test for a valid current element either HVAC, ASMBLY or CWAY
  HVAC
    handle (2,111)
      -- Cannot access element type HVAC from the level
      CWAY
        handle (2,111)
          return
        elsehandle none
          !this.ceRefe = !!ce
        endhandle

    elsehandle none
      !this.ceRefe = !!ce
    endhandle

  -- Store the type
  !this.searchType = !this.ceRefe.type

  -- Reset the name display gaskets
  !this.elementName.val = !this.ceRefe.namn

  -- Display the ce type
  !this.singleNameP.val  = !this.ceRefe.type & ' for processing'

  -- Run the splitting
  if (!!isoModelView.shown()) then
    !this.previewSplit()
  endif

endmethod
-- End of method definition for .refresh()

-----------------------------------------------------------------------
--
-- Method:      .remove(STRING)
--
-- Description: Remove entries from the detail list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Remove ALL or only those SELECTED
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!arg is STRING)

  -- Remove the selected elements from the list
  if (!arg.eq('SELECTED')) then

    -- Remove the selected elements from the data
    !this.isoData.remove(!this.detailCntrl.getSelectedRowTags())

    -- Build row data
    !rowSet = !this.isoData.buildData(false)

    -- Set list
    using namespace 'Aveva.Pdms.Presentation'
    !this.detailCntrl.bindToDataSource(object NETDATASOURCE('Assemblies', !this.headings, !rowSet, '^Name'))

    -- Set the cells for element valid contents
    !this.setIcon(2, !this.isoData.contents)

    -- Set the cells for locked element
    !this.setIcon()

  else

    -- Check before clearing the list
    !answer = !!alert.question('Are you sure you want to remove all entries from the list?')
    if (!answer.upCase()eq('YES')) then
      !this.detailCntrl.clearGrid()
    endif

  endif

endmethod
-- End of method .remove(STRING)

-----------------------------------------------------------------------
--
-- Method:      .resetModify()
--
-- Description: Reset the modify gadgets to the saved settings
--              Used when switching between modes to ensure both have the same values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .resetModify()

  -- Set the gadgets for the opposite number
  -- Search
  if (!this.shownSearch) then

    !this.singleSetLocDrwg.val = !this.registry.flnm

    !this.singleSetLimBox.select('RTEXT',!this.limitsBox)

    if (!this.splitMethod.eq('VOLUME')) then
      !this.singleSetLimFop1.val   = true
      !this.singleSetLimBox.active = true
    else
      !this.singleSetLimFop2.val   = true
      !this.singleSetLimBox.active = false
    endif

    !this.singleSetOutXls.val  = !this.outputXls
    !this.singleSetXlsFold.val = !this.xlsFolder.string()
    !this.singleSetOutPDF.val  = !this.outputPdf
    !this.singleSetPdfFold.val = !this.pdfFolder.string()

    !this.singleSetIso1.val = false
    !this.singleSetIso2.val = false
    !this.singleSetIso3.val = false
    !this.singleSetIso4.val = false

    if (!this.isoDirection.eq(1)) then
      !this.singleSetIso1.val = true
    elseif (!this.isoDirection.eq(2)) then
      !this.singleSetIso2.val = true
    elseif (!this.isoDirection.eq(3)) then
      !this.singleSetIso3.val = true
    elseif (!this.isoDirection.eq(4)) then
      !this.singleSetIso4.val = true
    endif

  -- Single
  else

    !this.searchSetLocDrwg.val = !this.registry.flnm

    !this.searchSetLimBox.select('RTEXT',!this.limitsBox)

    if (!this.splitMethod.eq('VOLUME')) then
      !this.searchSetLimFop1.val   = true
      !this.searchSetLimBox.active = true
    else
       !this.searchSetLimFop2.val   = true
       !this.searchSetLimBox.active = false
    endif

    !this.searchSetOutXls.val  = !this.outputXls
    !this.searchSetXlsFold.val = !this.xlsFolder.string()
    !this.searchSetOutPDF.val  = !this.outputPdf
    !this.searchSetPdfFold.val = !this.pdfFolder.string()

    !this.searchSetIso1.val = false
    !this.searchSetIso2.val = false
    !this.searchSetIso3.val = false
    !this.searchSetIso4.val = false

    if (!this.isoDirection.eq(1)) then
      !this.searchSetIso1.val = true
    elseif (!this.isoDirection.eq(2)) then
      !this.searchSetIso2.val = true
    elseif (!this.isoDirection.eq(3)) then
      !this.searchSetIso3.val = true
    elseif (!this.isoDirection.eq(4)) then
      !this.searchSetIso4.val = true
    endif

  endif

endmethod
-- End of method definition for .resetModify()

-----------------------------------------------------------------------
--
-- Method:      .runSearch()
--
-- Description: Run the report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runSearch()

  -- Make a getwork so other users drawings are visible
  GETWORK

  -- Clear the grid and data object
  !this.detailCntrl.clearGrid()
  !this.isoData.clear()

  -- Set the grid pop-up menu for nothing selected
  !this.setPopUpActive(false)

  -- Get the element filter string
  -- HVAC
  if (!this.elementType.selection().eq('HVAC')) then
    !filter = !!isoMain.isoAdpApp.data.hvacRule

  -- CWAY
  elseif (!this.elementType.selection().eq('CWAY')) then
    !filter = !!isoMain.isoAdpApp.data.elecRule

  endif

  -- Get all design elements
  !allElements = !!isoElements(!this.ceRefe, !this.elementType.selection(), 'STRING', !filter)

  -- Get the data for the current element
  !this.isoData.getData(!allElements, !this.searchFilter, !this.isoAdpApp.data.drwgNameRule, !this.isoAdpApp.data.backingSheet)

  -- Build row data
  !rowSet = !this.isoData.buildData(false)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCntrl.bindToDataSource(object NETDATASOURCE('Elements', !this.headings, !rowSet, '^Name'))

  -- Set the mode column editable
  !this.detailCntrl.setEditableColumn(1,false)
  !this.detailCntrl.setEditableColumn(2,false)
  !this.detailCntrl.setEditableColumn(3,false)
  !this.detailCntrl.setEditableColumn(4,false)
  if (!this.searchFilter.eq('DRAWN') or !this.searchFilter.eq('DRAWN BY ME')) then
    !this.detailCntrl.setEditableColumn(5,true)
    !this.detailCntrl.assignValueListToColumn('Mode', 5)
  else
    !this.detailCntrl.setEditableColumn(5,false)
  endif

  -- Set the cells for element valid contents
  !this.setIcon(2, !this.isoData.contents)

  -- Set the cells for locked element
  !this.setIcon()

endmethod
-- End of method .runSearch()

------------------------------------------------------------------------
--
-- Method:        .saveExcel(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report to Excel
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveExcel(!fileObj is FILE)

  -- Create Grid Control Objects
  import 'GridControl'
    handle (1000,0)
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !elementsDbCtrl = object NETGRIDCONTROL()

  -- Store browser settings on this form
  !this.saveExcel = !fileObj

  -- Build row data
  !rowSet = !this.isoData.buildData(true)

  -- Set the grid
  !elementsDbCtrl.bindToDataSource(object NETDATASOURCE('Elements', !this.headings, !rowSet, '^Name'))

  -- Save report to excel
  !elementsDbCtrl.saveGridToExcel(!this.saveExcel.directory().fullName() & '\' & !this.saveExcel.entry())

endmethod
-- End of method definition for .saveExcel(FILE)

------------------------------------------------------------------------
--
-- Method:      .saveSettings()
--
-- Description: Save changes to the settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveSettings()

  -- Store the settings depending on the mode
  if (!this.shownSearch) then

    !this.registry = !this.searchSetLocDrwg.val.dbref()

    !limitsBox     = !this.searchSetLimBox

    !outputXls     = !this.searchSetOutXls
    !xlsFolder     = !this.searchSetXlsFold
    !outputPdf     = !this.searchSetOutPDF
    !pdfFolder     = !this.searchSetPdfFold

    !isoDirection1 = !this.searchSetIso1.val
    !isoDirection2 = !this.searchSetIso2.val
    !isoDirection3 = !this.searchSetIso3.val
    !isoDirection4 = !this.searchSetIso4.val

  else

    !this.registry = !this.singleSetLocDrwg.val.dbref()

    !limitsBox     = !this.singleSetLimBox

    !outputXls     = !this.singleSetOutXls
    !xlsFolder     = !this.singleSetXlsFold
    !outputPdf     = !this.singleSetOutPDF
    !pdfFolder     = !this.singleSetPdfFold

    !isoDirection1 = !this.singleSetIso1.val
    !isoDirection2 = !this.singleSetIso2.val
    !isoDirection3 = !this.singleSetIso3.val
    !isoDirection4 = !this.singleSetIso4.val

  endif

  -- Complexity limits box
  !this.limitsBox    = !limitsBox.selection('RTEXT')

  -- North direction
  if (!isoDirection1) then
    !this.isoDirection = 1

  elseif (!isoDirection2) then
    !this.isoDirection = 2

  elseif (!isoDirection3) then
    !this.isoDirection = 3

  elseif (!isoDirection4) then
    !this.isoDirection = 4

  endif

  -- Output
  !this.outputXls = !outputXls.val
  !this.xlsFolder = object FILE(!xlsFolder.val)
  !this.outputPdf = !outputPdf.val
  !this.pdfFolder = object FILE(!pdfFolder.val)

  -- Mark settings as having been modified
  !this.modified(true)

  -- Pass the settings to the main application object
  !this.isoAdpApp.settings(!this.getSettings())

  -- Synchronise the other mode gadgets
  !this.resetModify()

endmethod
-- End of method definition for .saveSettings()

-----------------------------------------------------------------------
--
-- Method:      .saveUserDefaults()
--
-- Description: Save settings to user defaults file for reloading on start up
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveUserDefaults()

  -- Initialise variables
  !settings = ARRAY()

  -- Build contents array
  !settings.append('elementType = ' & !this.searchType)
  !settings.append('drawingLocation = ' & !this.registry.flnm)
  !settings.append('splitMethod = ' & !this.splitMethod)
  !settings.append('limitsBox = ' & !this.limitsBox.string(!!isoLimitsFormat))
  !settings.append('northDirection = ' & !this.isoDirection)
  !settings.append('outputExcel = ' & !this.outputXls)
  !settings.append('excelFolder = ' & !this.xlsFolder.string())
  !settings.append('outputPdf = ' & !this.outputPdf)
  !settings.append('pdfFolder = ' & !this.pdfFolder.string())

  -- Write file
  !this.userDefaultsfile.writefile('OVER',!settings)

  -- Mark settings as not modified
  !this.modified(false)

  -- Allow the saved file to be deleted
  !this.singleClearUserLinkM.active = true
  !this.searchClearUserLinkM.active = true

endmethod
-- End of method definition for .saveUserDefaults()

------------------------------------------------------------------------
--
-- Method:      .searchMode()
--
-- Description: Set panels for searching
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .searchMode()

  -- Initialise
  !this.currentElement(!!ce)

  -- Store the search type
  !this.searchType = !this.elementType.selection('RTEXT')

  -- Switch single panel off
  !this.singlePanel.visible  = false

  -- Switch search panel on
  !this.searchPanel.visible  = true
  !this.shownSearch          = true

  -- Show the modify or plain version of the search panel
  !this.modifyMode(!this.shownModify)

endmethod
-- End of method definition for .searchMode()

-----------------------------------------------------------------------
--
-- Method:      .selAll()
--
-- Description: Select all entries in the grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selAll()

  -- Initialise variables
  !select = ARRAY()

  -- Build array of all rows
  do !index index !this.detailCntrl.getRows()
    !select.append(!index)
  enddo

  -- Select all rows
  !this.detailCntrl.setSelectedRowTags(!select)

endmethod
-- End of method .selAll()

------------------------------------------------------------------------
--
-- Method:      .setCe()
--
-- Description: Select the current element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCe()

  -- Use the current element
  !this.ceRefe     = !!ce
  !this.ceName.val = !this.ceRefe.flnn

  -- Check for preview form
  if (!!isoModelView.shown()) then

    -- Run the splitting
    !this.previewSplit()

  endif

endmethod
-- End of method definition for .setCe()

------------------------------------------------------------------------
--
-- Method:      .setComplexity(GADGET)
--
-- Description: Set the splitting complexity
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget selecting VOLUME type splitting
--    2   R      GADGET      The volume complexity gadget associated with 1 above
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setComplexity(!splitByVolGadget is GADGET, !complexityGadget is GADGET)

  -- If the preview form is shown, then re-run the splitting
  if (!!isoModelView.shown()) then
    !!isoModelView.runSplitting('VOLUME', !complexityGadget.selection('RTEXT'))

  endif

  -- Save the complexity setting
  !this.saveSettings()

endmethod
-- End of method definition for .setComplexity(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setDefaults()
--
-- Description: Set all defaults
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefaults()

  -- Test for an existing user settings file
  if (!this.userDefaultsfile.exists()) then
    !this.singleClearUserLinkM.active = true
    !this.searchClearUserLinkM.active = true

  else
    !this.singleClearUserLinkM.active = false
    !this.searchClearUserLinkM.active = false

  endif

  -- Select default direction
  !this.isoDirection = 3

  -- Set drawlist and drawing location
  !this.library              = !this.isoAdpApp.data.drawListLiby
  !this.registry             = !this.isoAdpApp.data.isoRegister
  !this.singleSetLocDrwg.val = !this.registry.flnm
  !this.searchSetLocDrwg.val = !this.registry.flnm

  -- Set output
  !this.outputXls = !this.isoAdpApp.data.outputXls
  !this.xlsFolder = !this.isoAdpApp.data.xlsFolder
  !this.outputPdf = !this.isoAdpApp.data.outputPdf
  !this.pdfFolder = !this.isoAdpApp.data.pdfFolder

  -- Set revision specific value inactive
  !this.singleSetRevValue.active = false
  !this.searchSetRevValue.active = false

endmethod
-- End of method .setDefaults()

-----------------------------------------------------------------------
--
-- Method:      .setDisplay(BOOLEAN)
--
-- Description: Set whether drawings should be displayed when picked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplay(!on is BOOLEAN)

  -- Check pop-up setting
  if (!on) then
    !this.displayDrwg = true
  else
    !this.displayDrwg = false
  endif

endmethod
-- End of method .setDisplay(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .setDirection(REAL)
--
-- Description: Set the direction gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL      The isometric direction being set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDirection(!isoDirection is REAL)

  -- Set all options off
  !this.singleSetIso1.val = false
  !this.searchSetIso1.val = false
  !this.singleSetIso2.val = false
  !this.searchSetIso2.val = false
  !this.singleSetIso3.val = false
  !this.searchSetIso3.val = false
  !this.singleSetIso4.val = false
  !this.searchSetIso4.val = false

  -- Select iso direction
   if (!isoDirection.eq(1)) then
    !this.singleSetIso1.val = true
    !this.searchSetIso1.val = true

  elseif (!isoDirection.eq(2)) then
    !this.singleSetIso2.val = true
    !this.searchSetIso2.val = true

  elseif (!isoDirection.eq(3)) then
    !this.singleSetIso3.val = true
    !this.searchSetIso3.val = true

  elseif (!isoDirection.eq(4)) then
    !this.singleSetIso4.val = true
    !this.searchSetIso4.val = true

  endif

  -- Update the preview form
  if (!!isoModelView.shown()) then
    !!isoModelView.modifyDir(!isoDirection)

  endif

  -- Save the settings
  !this.saveSettings()

endmethod
-- End of method .setDirection(REAL)

-----------------------------------------------------------------------
--
-- Method:      .setIcon()
--
-- Description: Set the cell icons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIcon()

  -- For each cell
  do !index from 1 to !this.detailCntrl.getRows().size()

    -- Existing Isometric
    if (!this.isoData.access[!index].upCase().match('YES').neq(0)) then
      !this.detailCntrl.setCellImage(!index, 4, !!pml.getPathName('ad_t_018.png'))

    else
      !this.detailCntrl.setCellImage(!index, 4, !!pml.getPathName('ad_t_019.png'))

    endif

  enddo

endmethod
-- End of method .setIcon()

-----------------------------------------------------------------------
--
-- Method:      .setIcon(REAL,ARRAY)
--
-- Description: Set the specified column cell icons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIcon(!column is REAL, !cellValues is ARRAY)

  -- For each cell
  do !index ind !cellValues

    -- OK
    if (!cellValues[!index]) then
      !this.detailCntrl.setCellImage(!index, !column, !!pml.getPathName('ad_t_018.png'))

    -- NOT OK
    else
      !this.detailCntrl.setCellImage(!index, !column, !!pml.getPathName('ad_t_019.png'))
    endif

  enddo

endmethod
-- End of method .setIcon(REAL,ARRAY)

------------------------------------------------------------------------
--
-- Method:      .setPopUpActive(BOOLEAN)
--
-- Description: Set the display grid pop-up active or inactive
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Visible or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPopUpActive(!active is BOOLEAN)

  if (!active) then
    !this.defPopUp.setActive('Deselect All', true)
    !this.defPopUp.setActive('Remove Selected', true)
    !this.defPopUp.setActive('Goto Element', true)
    !this.defPopUp.setActive('Goto Drawing', true)
    !this.defPopUp.setActive('Display Details', true)

  else
    !this.defPopUp.setActive('Deselect All', false)
    !this.defPopUp.setActive('Remove Selected', false)
    !this.defPopUp.setActive('Goto Element', false)
    !this.defPopUp.setActive('Goto Drawing', false)
    !this.defPopUp.setActive('Display Details', false)

  endif

endmethod
-- End of method .setPopUpActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .setRefresh(BOOLEAN)
--
-- Description: Set the refresh gadget invisible status
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Visible or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRefresh(!visible is BOOLEAN)

  !this.singleRefresh.visible = !visible

endmethod
-- End of method .setRefresh(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .setPreviewSettings()
--
-- Description: Set the model preview form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPreviewSettings()

  -- Pass the data needed to split into spools
  if (!this.searchType.eq('HVAC')) then
    !settings[1] = !this.isoAdpApp.data.hvacPeneTag.element
    !settings[2] = !this.isoAdpApp.data.hvacPeneTag.rule

  else
    !settings[1] = !this.isoAdpApp.data.elecPeneTag.element
    !settings[2] = !this.isoAdpApp.data.elecPeneTag.rule

  endif

  !settings[3] = !this.isoAdpApp.data.backingSheet
  !settings[4] = !this.isoAdpApp.data.stdLibrary
  !settings[5] = !this.isoAdpApp.drawingType

  !!isoModelView.setData(!settings)

endmethod
-- End of method .setPreviewSettings()

------------------------------------------------------------------------
--
-- Method:      .setSettings()
--
-- Description: Set the settings gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSettings()

  -- Initialise variables
  !limits     = !this.isoAdpApp.data.limitsBoxes
  !halfLimits = !limits.size() / 2
  !dtext      = ARRAY()
  !rtext      = ARRAY()

  -- Splitting
  !defaultSplit = !this.isoAdpApp.data.splitMethod

  -- Set the default value
  if (!defaultSplit.eq('VOLUME')) then
    !this.singleSetLimFop1.val = true
    !this.searchSetLimFop1.val = true

  else
    !this.singleSetLimFop2.val = true
    !this.searchSetLimFop2.val = true

  endif

  -- Limits Box
   -- The middle value in the range is treated as the 100% box
  do !index ind !limits

    -- Initialise variables
    !size       = !limits[!index].real()
    !sizeString = !limits[!index]
    !oneHundred = !limits[!halfLimits.nint()].real()

    -- Calculate the percentage of each box against the second box
    !percentage = !size / !oneHundred * 100

    -- Populate the gadget
    !dtext.append(!percentage.nint() & '%')
    !rtext.append(!sizeString)

  enddo

  !this.singleSetLimBox.dtext = !dtext
  !this.singleSetLimBox.rtext = !rtext
  !this.searchSetLimBox.dtext = !dtext
  !this.searchSetLimBox.rtext = !rtext

  -- Select default limits box as 100% if possible
  !oneHundred = !this.singleSetLimBox.dtext.findFirst('100%')
  if (!oneHundred.set()) then
    !this.limitsBox = !this.isoAdpApp.data.limitsBoxes[!oneHundred]
  else
    !this.limitsBox = !this.isoAdpApp.data.limitsBoxes[1]
  endif

  !this.singleSetLimBox.select('RTEXT',!this.limitsBox)
  !this.searchSetLimBox.select('RTEXT',!this.limitsBox)

  -- Direction
  !this.singleSetIso1.val = false
  !this.singleSetIso2.val = false
  !this.singleSetIso3.val = false
  !this.singleSetIso4.val = false
  !this.searchSetIso1.val = false
  !this.searchSetIso2.val = false
  !this.searchSetIso3.val = false
  !this.searchSetIso4.val = false

  if (!this.isoDirection.eq(1)) then
    !this.singleSetIso1.val = true
    !this.searchSetIso1.val = true

  elseif (!this.isoDirection.eq(2)) then
    !this.singleSetIso2.val = true
    !this.searchSetIso2.val = true

  elseif (!this.isoDirection.eq(3)) then
    !this.singleSetIso3.val = true
    !this.searchSetIso3.val = true

  elseif (!this.isoDirection.eq(4)) then
    !this.singleSetIso4.val = true
    !this.searchSetIso4.val = true

  endif

  -- Revision
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = 'Internal'
  !dtext[2] = 'External'
  !rtext[1] = 'INT'
  !rtext[2] = 'EXT'
  !this.singleSetRevType.dtext = !dtext
  !this.singleSetRevType.rtext = !rtext
  !this.searchSetRevType.dtext = !dtext
  !this.searchSetRevType.rtext = !rtext

  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = 'Increment'
  !dtext[2] = 'Specific'
  !rtext[1] = 'INC'
  !rtext[2] = 'SPE'
  !this.singleSetRevMode.dtext = !dtext
  !this.singleSetRevMode.rtext = !rtext
  !this.searchSetRevMode.dtext = !dtext
  !this.searchSetRevMode.rtext = !rtext

  !text[1] = ' '
  !text.appendArray(!this.isoAdpApp.data.internalRev)
  !this.singleSetRevValue.dtext = !text
  !this.searchSetRevValue.dtext = !text

  !this.singleSetRevType.select('RTEXT',!this.revision.revType)
  !this.searchSetRevType.select('RTEXT',!this.revision.revType)
  !this.singleSetRevMode.select('RTEXT',!this.revision.revMode)
  !this.searchSetRevMode.select('RTEXT',!this.revision.revMode)

  -- Template
  -- FUTURE

  -- Output
  !this.singleSetOutXls.val  = !this.outputXls
  !this.singleSetXlsFold.val = !this.xlsFolder.name()
  !this.singleSetOutPDF.val  = !this.outputPdf
  !this.singleSetPdfFold.val = !this.pdfFolder.name()
  !this.searchSetOutXls.val  = !this.outputXls
  !this.searchSetXlsFold.val = !this.xlsFolder.name()
  !this.searchSetOutPDF.val  = !this.outputPdf
  !this.searchSetPdfFold.val = !this.pdfFolder.name()

  -- Set the splitting
  !this.setSplitting('INIT',!this.singleSetLimFop1,!this.singleSetLimBox)

endmethod
-- End of method .setSettings()

------------------------------------------------------------------------
--
-- Method:      .setTracking(BOOLEAN)
--
-- Description: Set tracking
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTracking(!tracking is BOOLEAN)

  !this.trackElement = !tracking

  if (!tracking) then

    -- Track the current element
    !this.track()

    !this.singleTrack.val = true
    !this.searchTrack.val = true

    -- Switch the 'Up One Level' and 'CE' button
    !this.upLevel.visible  = true
    !this.searchCe.visible = false

    -- Set the switch to single mode
    !this.searchBack.active = false

    -- Set the refresh gadget invisible status
    !this.setRefresh(false)

  else

    !this.singleTrack.val   = false
    !this.searchTrack.val   = false
    !this.upLevel.visible   = false
    !this.searchCe.visible  = true
    !this.searchBack.active = true

    !this.setRefresh(true)

  endif

  -- Test for the preview  or edit form, in which case make the tracking inactive
  if (!!isoModelView.shown() or !!isoEdit.tracking.not()) then

    !this.singleTrack.active = false
    !this.searchTrack.active = false

  else

    !this.singleTrack.active = true
    !this.searchTrack.active = true

  endif

endmethod
-- End of method definition for .setTracking(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .setType()
--
-- Description: Set the search type
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setType()

  --- Store the search type
  !this.searchType = !this.elementType.selection('RTEXT')

  -- Mark the form settings as modified as this value can be stored in the user defaults file
  !this.modified(true)

  -- Update the main object
  !this.isoAdpApp.settings(!this.getSettings())

endmethod
-- End of method definition for .setType()

------------------------------------------------------------------------
--
-- Method:      .setValues(REAL,REAL,ARRAY,STRING)
--
-- Description: Set process values for splitting limits and north direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Complexity limits box
--    2   R      REAL        Isometric view direction
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setValues(!limitsBox is STRING, !isoDirection is REAL)

  -- Store the changes
  !this.limitsBox    = !limitsBox
  !this.isoDirection = !isoDirection

  -- Select complexity
  !this.searchSetLimBox.select('RTEXT',!this.limitsBox)
  !this.singleSetLimBox.select('RTEXT',!this.limitsBox)

  -- P-42426 Set all options off. NB: !this.SetDirection(!isoDirection) results in infinite recursion

  !this.singleSetIso1.val = false
  !this.searchSetIso1.val = false
  !this.singleSetIso2.val = false
  !this.searchSetIso2.val = false
  !this.singleSetIso3.val = false
  !this.searchSetIso3.val = false
  !this.singleSetIso4.val = false
  !this.searchSetIso4.val = false

  -- Select iso direction
   if (!this.isoDirection.eq(1)) then
    !this.singleSetIso1.val = true
    !this.searchSetIso1.val = true

  elseif (!this.isoDirection.eq(2)) then
    !this.singleSetIso2.val = true
    !this.searchSetIso2.val = true

  elseif (!this.isoDirection.eq(3)) then
    !this.singleSetIso3.val = true
    !this.searchSetIso3.val = true

  elseif (!this.isoDirection.eq(4)) then
    !this.singleSetIso4.val = true
    !this.searchSetIso4.val = true

  endif

  !this.saveSettings()

endmethod
-- End of method definition for .setValues(REAL,REAL,ARRAY,STRING)

------------------------------------------------------------------------
--
-- Method:      .showAdv()
--
-- Description: Display the advanced search form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showAdv()

  if (undefined(!!isoAdvSearch)) then
    pml load form !!isoAdvSearch
  endif

  -- Set the type to be searched for
  !!isoAdvSearch.type = !this.searchType

  !!isoAdvSearch.show('cen',0.5,0.5)

endmethod
-- End of method definition for .showAdv()

------------------------------------------------------------------------
--
-- Method:      .singleMode()
--
-- Description: Set panels for a single element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .singleMode()

  -- Initialise variables
  !this.detailCntrl.clearGrid()
  !this.ceRefe = !!ce

  -- Display the ce name
  !this.elementName.val = !this.ceRefe.namn

  -- Display and store the ce type
  !this.singleNameP.val  = !this.ceRefe.type & ' for processing'
  !this.searchType       = !this.ceRefe.type

  -- Show the modify or plain version of the single panel
  !this.singlePanel.visible      = true
  !this.modifyMode(!this.shownModify)

  -- Set the search panel off
  !this.searchPanel.visible      = false
  !this.shownSearch              = false

  -- Check whether the element has been drawn or not
  !this.isoData.clear()
  !this.isoData.setDrawn(!this.ceRefe, !this.isoAdpApp.data.drwgNameRule, !this.isoAdpApp.data.backingSheet.font)
  if (!this.isoData.drawn[1].upCase().match('NO').neq(0)) then
    !this.singleExistingP.visible  = true
    !this.singleUpdate.visible     = false
    !this.singleRegenerate.visible = false

  else
    !this.singleExistingP.visible  = false
    !this.singleUpdate.visible     = true
    !this.singleRegenerate.visible = true

  endif

endmethod
-- End of method definition for .singleMode()

------------------------------------------------------------------------
--
-- Method:      .setSplitting(STRING.GADGET,GADGET)
--
-- Description: Set the split method
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Initialise 'INIT' or Modify 'MODIFY'
--    2   R      GADGET      The gadget selecting VOLUME type splitting
--    3   R      GADGET      The volume complexity gadget associated with 2 above
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSplitting(!runType is STRING, !splitByVolGadget is GADGET, !complexityGadget is GADGET)

 -- Store the set value for Volume splitting
  if (!splitByVolGadget.val) then
    !this.splitMethod = 'VOLUME'
    !this.singleSetLimBox.active = true
    !this.searchSetLimBox.active = true

    -- If the preview form is shown, then run the splitting
    if (!!isoModelView.shown()) then
      !!isoModelView.runSplitting('VOLUME',!complexityGadget.selection('RTEXT'))
    endif

  -- For Split Point
  else

    !this.splitMethod = 'SPLITPOINT'
    !this.singleSetLimBox.active = false
    !this.searchSetLimBox.active = false

    -- If the preview form is shown, then run the splitting
    if (!!isoModelView.shown()) then
      !!isoModelView.runSplitting('SPLITPOINT',!complexityGadget.selection('RTEXT'))
    endif

  endif

  -- Mark form as modified
  if (!runType.eq('MODIFY')) then
    !this.modified(true)
  endif

  !this.saveSettings()

endmethod
-- End of method definition for .setSplitting(STRING.GADGET,GADGET)

------------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Store the form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store()

  !this.saveSettings()

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:      .switchMode(STRING)
--
-- Description: Switch from single to search mode
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchMode(!searchType is STRING)

  -- Switch to design
  CONTEXT DESIGN

  -- Move up one level when the ce is an HVAC or CWAY to improve search results
  -- It also prevents tracking for returning to single mode
  if (!!ce.type.eq('HVAC') or !!ce.type.eq('CWAY')) then

    END

  endif

  -- Switch to search mode
  if (!this.trackElement) then
    !this.track()

  else

    -- Open in search mode
    !this.shownSearch = true
    !this.searchMode()

    -- Set gadget visibility
    !this.visibility()

  endif

  -- Select the search type
  !this.elementType.select('RTEXT', !searchType)

endmethod
-- End of method definition for .switchMode()

------------------------------------------------------------------------
--
-- Method:      .switchToSingleMode()
--
-- Description: Switch to single mode if ta suitable element is available
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchToSingleMode()

  -- Try to find an HVAC or CWAY
  HVAC
    handle (2,111)
      -- Cannot access element type HVAC from the level

      CWAY
        handle (2,111)
          -- Cannot access element type CWAY from the level
        endhandle

    endhandle

  -- Test for a valid current element either HVAC or CWAY
  if (!!ce.type.eq('HVAC') or !!ce.type.eq('CWAY')) then

    !this.singleMode()

  endif

endmethod
-- End of method definition for .switchToSingleMode()

------------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: Track selected element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  -- Set default mode to search for elements
  !mode = 'SEARCH'

  -- If we are tracking the current element
  if (!this.trackElement) then

    -- Test for a valid current element either HVAC, ASMBLY or CWAY
    HVAC
      handle (2,111)
        -- Cannot access element type HVAC from the level

        CWAY
          handle (2,111)
          elsehandle none
            !mode = 'SINGLE'
          endhandle

      elsehandle none
        !mode = 'SINGLE'
      endhandle

    -- Test in which mode the application is starting
    if (!mode.eq('SINGLE')) then

      -- For individual element type, open in single mode
      !this.shownSearch = false
      !this.singleMode()

    else

      -- For multiple types, open in search mode
      !this.shownSearch = true
      !this.searchMode()

    endif

  endif

  -- Set gadget visibility
  !this.visibility()

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .visibility()
--
-- Description: Set gadget visibility
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .visibility()

  -- Search mode
  if (!this.shownSearch) then

    -- If tracking is on, then we do not need the switch to single mode
    if (!this.trackElement) then
      !this.searchBack.active = false

    else
      !this.searchBack.active = true

    endif

    -- Look for a selected grid entry
    if (!this.detailCntrl.getSelectedRowTags().unset()) then

      -- Preview splitting
      !this.searchViewSplitLink.active  = false
      !this.searchViewSplitLinkM.active = false

      -- Disallow preview splitting
      !this.preview = false

      -- Process
      !this.searchProcessStart.active   = false
      !this.searchProcessStartM.active  = false

    -- We have an element to process
    else

      !this.searchViewSplitLink.active  = true
      !this.searchViewSplitLinkM.active = true
      !this.searchProcessStart.active   = true
      !this.searchProcessStartM.active  = true
      !this.preview                     = true

    endif

  -- Single mode
  else

    if (!this.ceRefe.badref()) then
      !type = !!ce.type
    else
      !type = !this.ceRefe.type
    endif

    -- Test for not at a valid element
    if (!type.neq('HVAC') and !type.neq('ASMBLY') and !type.neq('CWAY')) then

      -- Preview splitting
      !this.singleViewSplitLink.active  = false
      !this.singleViewSplitLinkM.active = false

      -- Disallow preview splitting
      !this.preview = false

      -- Process
      !this.singleProcessStart.active   = false
      !this.singleProcessStartM.active  = false

    -- We have an element to process
    else

      !this.singleViewSplitLink.active  = true
      !this.singleViewSplitLinkM.active = true
      !this.singleProcessStart.active   = true
      !this.singleProcessStartM.active  = true
      !this.preview                     = true

    endif

  endif

endmethod
-- End of method definition for .visibility()

------------------------------------------------------------------------
--
-- Method:      createFolder
--
-- Description: Create folder
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Path of the folder to be created
--
-- Return:
--   [Data Type] [Description]
--    FILE        Folder as file object
--
------------------------------------------------------------------------
define method .createFolder(!path is STRING) is FILE

  !folder = object FILE(!path)
  syscom 'mkdir "$!path"'
  if !folder.exists().not() then
    return error 1 'Folder $!path cannot be created.'
  endif

  return !folder

endmethod
-- End of method
