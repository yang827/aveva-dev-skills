--
-- Description:
-- 3D View in Draft
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(DBREF,ARRAY)                 BOOLEAN             Add the passed spools to the drawlist
--  close()                          -                   Close the form
--  display(STRING)                  -                   Close the spools
--  initialise()                     -                   Determine current view from ce, and make it the selected view
--  isoModelView()                   -                   Constructor
--  modifyDir(REAL)                  -                   Modify the north direction
--  modifySpool(STRING)              -                   Adds / Removes elements from the selected spool
--  runSplitting(STRING,STRING)      -                   Re-run the splitting depending on the passed split type and complexity
--  setData(ARRAY)                   -                   Set the view direction to the passed isometric direction
--  setDir(REAL)                     -                   Set the view direction to the passed isometric direction
--  setLimits()                      -                   Set the splitting limits
--  setValues()                      -                   Set the process values for splitting and north direction
--  setVisible()                     -                   Set the gadgets visibility status
--  split(DBREF,STRING,STRING,REAL)  BOOLEAN             Split the passed element into spools
--  testForSpools()                  -                   Test the current HVAC as to whether it has been spooled
--
------------------------------------------------------------------------
setup form !!isoModelView resize document

  -- Split
  paragraph .type at x0 y0 text 'Split' width 4

  -- By points
  paragraph .points at x0 y0 text 'Splitting by Points,' width 12

  -- Splitting Volume Box Size
  option .box  at xmax.type ymin width 4

  -- Number of sheets
  paragraph .numberOfSheetsA at xmax+1      ymin lines 1 width 27
  paragraph .numberOfSheetsB at xmax.type+1 ymin lines 1 width 27

  -- Playback tools
  button .first    at xmax.numberOfSheetsA+2 ymin+0.1 tooltip 'First'    pixmap width 16 height 16
  button .previous at xmax+2                 ymin     tooltip 'Previous' pixmap width 16 height 16
  button .play     at xmax+2                 ymin     tooltip 'Play'     pixmap width 16 height 16
  button .next     at xmax+2                 ymin     tooltip 'Next'     pixmap width 16 height 16
  button .last     at xmax+2                 ymin     tooltip 'Last'     pixmap width 16 height 16

  -- North direction
  button .iso1 at xmax+5 ymin tooltip 'Iso1' pixmap width 16 height 16
  button .iso2 at xmax+1 ymin tooltip 'Iso2' pixmap width 16 height 16
  button .iso3 at xmax+1 ymin tooltip 'Iso3' pixmap width 16 height 16
  button .iso4 at xmax+1 ymin tooltip 'Iso4' pixmap width 16 height 16

  -- View save and restore commands
  view .view at x0 ymax+0.1 prompt .prompt GIVolume height 50 width 100

  exit

  -- Element being split
  member .elementRefe  is DBREF

  -- Element is spooled
  member .spooled      is BOOLEAN

  -- Limits box
  member .splitType    is STRING
  member .limitsBox    is STRING

  -- Spools
  member .splitManager is ISOSPOOLS

  -- Maximum of table entries
  member .maxEntries   is REAL

  -- View direction
  member .direction    is REAL

  -- Where library material table data is located
  member .backingSheet is DBREF
  member .library      is DBREF

  member .module       is ISOMODULE

exit
------------------------------------------------------------------------
--
-- Method:      .isoModelView
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoModelView()

  !this.formTitle = 'Isometric Splitting'

  -- Pixmaps
  !this.first.addPixmap(!!pml.getPathName('display_first.png'))
  !this.previous.addPixmap(!!pml.getPathName('display_previous.png'))
  !this.play.addPixmap(!!pml.getPathName('play.png'))
  !this.next.addPixmap(!!pml.getPathName('display_next.png'))
  !this.last.addPixmap(!!pml.getPathName('display_last.png'))

  if (!this.module.description.eq('DRAFT')) then
    !this.iso1.addPixmap(!!pml.getPathName('iso1_small.png'))
    !this.iso2.addPixmap(!!pml.getPathName('iso2_small.png'))
    !this.iso3.addPixmap(!!pml.getPathName('iso3_small.png'))
    !this.iso4.addPixmap(!!pml.getPathName('iso4_small.png'))
  else
    !this.iso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
    !this.iso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
    !this.iso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
    !this.iso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
  endif

  -- Callbacks
  !this.initcall          = |!this.initialise()|
  !this.cancelCall        = |!this.close()|
  !this.quitCall          = |!this.close()|
  !this.box.callback      = |!this.setLimits()|
  !this.first.callback    = |!this.display('FIRST')|
  !this.previous.callback = |!this.display('PREV')|
  !this.play.callback     = |!this.display('PLAY')|
  !this.next.callback     = |!this.display('NEXT')|
  !this.last.callback     = |!this.display('LAST')|
  !this.iso1.callback     = |!this.modifyDir(1)|
  !this.iso2.callback     = |!this.modifyDir(2)|
  !this.iso3.callback     = |!this.modifyDir(3)|
  !this.iso4.callback     = |!this.modifyDir(4)|

  -- Set view defaults
  !this.view.background = 'black'
  !this.view.shaded     = TRUE

  -- Start form maximised in MDI window
  !this.maximised       = true

  -- Set view colour shaded
  !this.view.shaded     = true

  -- Define play interrupt
  !!fmsys.setInterrupt(!this.play)

  -- Avoid the view finder
  !viewFinder = object VIEWFINDER()
  !viewFinder.hide()

  -- Start edg
--  !!edgCntrl    = object EDGCNTRL()
--  !!edgPosCntrl = object EDGPOSCNTRL()
--  !!aidNumbers  = object AIDNUMBERS()
--  !!edgCntrl.views.append(!this.view)

endmethod
-- End of method definition for .isoModelView()

------------------------------------------------------------------------
--
-- Method:      .initialise
--
-- Description: Determine current view from ce, and make it the selected view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  AID CLEAR ALL
  AID TRANSL 50

  -- Initialise variables
  !limits     = !!isoMain.isoAdpApp.data.limitsBoxes
  !halfLimits = !limits.size() / 2
  !dtext      = ARRAY()
  !rtext      = ARRAY()

  -- Limits Box
  -- The middle value in the range is treated as the 100% box
  do !index ind !limits

    -- Initialise variables
    !size       = !limits[!index].real()
    !sizeString = !limits[!index]
    !oneHundred = !limits[!halfLimits.nint()].real()

    -- Calculate the percentage of each box against the second box
    !percentage = !size / !oneHundred * 100

    -- Populate the gadget
    !dtext.append(!percentage.nint() & '%')
    !rtext.append(!sizeString)

  enddo

  !this.box.dtext = !dtext
  !this.box.rtext = !rtext

  -- Enhance the first spool
  !this.splitManager.setEnhanced(1)

  -- Set the main form refresh button on
  !!isoMain.setRefresh(true)

  -- Set the gadgets visibility
  !this.setVisible()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .add(DBREF,ARRAY)
--
-- Description: Add the passed spools to the drawlist
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to add
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if any spool do not have a volume
--
------------------------------------------------------------------------
define method .add(!elementRefe is DBREF, !spools is ARRAY) is BOOLEAN

  -- Initialise variable
  !gphView = object GPHVIEWS()
  !view    = !!isoModelView.view

  -- Clear design drawlist
  DESREM ALL

  -- Add the element to the drawlist
  DESADD $!elementRefe COLOUR ORANGE

  -- Get the limits
  !volume = object VOLUME(!elementRefe)

  -- Test for unset volume i.e. no limits, probably an empty asmbly
  if (!volume.from.unset() or !volume.to.unset()) then

    if (!elementRefe.mem.size().eq(0)) then
      !!alert.message('The ' & !elementRefe.type & ' cannot be displayed because it does not contain any elements')
    else
      !!alert.message('The ' & !elementRefe.type & ' cannot be displayed because it does not have any limits')
    endif

    return true

  else

    -- Model view limits
    !gphView.limits(!view, !volume)

    -- Display the model view form
    if (!this.shown().not()) then
      !this.show()
    endif

  endif

  -- Enhance the first spool
  !this.splitManager.setEnhanced(1)
  !this.splitManager.set(!spools)

  return false

endmethod
-- End of method definition for .add(DBREF,ARRAY)

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

  -- Update the main form
  !!isoMain.hiddenPreview()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .display(STRING)
--
-- Description: Close the spools
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The spools to display
--                             PLAY - Automatically show the spools one after the other until stop is given
--                             Display the FIRST, LAST, NEXT or PREV spool
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!what is STRING)

  -- Initialise variables
  !spoolManager   = !this.splitManager
  !numberOfSheets = !this.numberOfSheetsA
  !numberSpools   = !spoolManager.getNumbSpools()

  if (!what.eq('PLAY')) then

    -- Set play to pause
    !this.play.addPixmap(!!pml.getPathName('pause.png'))
    !this.play.refresh()

    do from 1 to !numberSpools

      !interrupt = !!fmsys.interrupt()
        handle (61,104)
        endhandle

      break if (!interrupt)

      !this.display('NEXT')

      !this.view.refresh()
      !numberOfSheets.refresh()

      PAUSE 1

    enddo

    -- Set play to play
    !this.play.addPixmap(!!pml.getPathName('play.png'))
    !this.play.refresh()

  else

    if (!what.eq('FIRST')) then
      !spoolManager.setEnhanced(1)

    elseif (!what.eq('LAST')) then
      !spoolManager.setEnhanced(!numberSpools)

    elseif (!what.eq('NEXT')) then

      if (!spoolManager.getEnhanced().eq(!numberSpools)) then
        !spoolManager.setEnhanced(1)
      else
        !spoolManager.setEnhanced(!spoolManager.getEnhanced() + 1)
      endif

    elseif (!what.eq('PREV')) then

      if (!spoolManager.getEnhanced().eq(1)) then
        !spoolManager.setEnhanced(!numberSpools)
      else
        !spoolManager.setEnhanced(!spoolManager.getEnhanced() - 1)
      endif

    endif

    !spoolManager.enhance()

    !numberOfSheets.val = 'Produces ' & !numberSpools & ' sheets of which this is ' & !spoolManager.getEnhanced()

  endif

  -- Set the actual objects
  !this.splitManager.setEnhanced(!spoolManager.getEnhanced())

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method:      .modifyDir(REAL)
--
-- Description: Modify the north direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The view isometric direction 1, 2, 3 or 4
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyDir(!isoDir is REAL)

  !this.setDir(!isoDir)

  !this.setValues()

endmethod
-- End of method definition for .modifyDir(REAL)

------------------------------------------------------------------------
--
-- Method:      .modifySpool(STRING)
--
-- Description: Adds / Removes elements from the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     STRING      Keywords for type(ADD or REMOVE)
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySpool(!option is STRING)

  -- Clear the graphical text display
  !this.splitManager.tidyGraphicalFeedback()

  -- Get the components of the currently enhanced spool
  !mtoElements   = !this.splitManager.getSpoolComponents()

  -- Test for any components
  if(!mtoElements.unset()) then
     !!alert.message('The spool does not contain any elements.')
     return
  elseif(!option eq 'REMOVE' and !mtoElements.size() eq 1) then
     !!alert.message('The spool contains only one element. It cannot be removed.')
     return
  endif

  -- edg packet to get the picked element
  !packet                  =  object EDGPACKET()
  !packet.initialisation   =  '!!pickedElements  =  ARRAY()'
  !packet.action           =  '!!pickedElements.append(!this.return[1].item)'

  if(!option eq 'ADD') then
     !packet.elementPick('Pick HVAC components to add to the selected spool or <escape> to complete')
     !elementFilter = | (owner of owner eq $!<this.elementRefe>) and (WDESP[50] neq 'BOP')|
     !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = false
     !packet.escape           =  '!!isoModelView.spools.addToSpool(!!pickedElements)'

  elseif(!option eq 'REMOVE') then
     !packet.elementPick('Pick HVAC elements to remove from selected spool or <escape> to complete')
     !elementFilter = | (owner of owner eq $!<this.elementRefe>) and (WDESP[50] neq 'BOP') |
     !packet.pickPacket.picks[1].pick.input[3]   = !elementFilter
     !packet.pickPacket.picks[1].pick.modifiable = false
     !packet.escape           =  '!!isoModelView.spools.removeFromSpool(!!pickedElements)'
  endif

  !!edgCntrl.add(!packet)

endmethod
--End of method definition for .modifySpool(STRING)

------------------------------------------------------------------------
--
-- Method:      .runSplitting(STRING,STRING)
--
-- Description: Re-run the splitting depending on the passed split type and complexity
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The splitting method VOLUME or SPLITPOINT
--    2   R      STRING      The limits box used for volume splitting
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runSplitting(!splitMethod is STRING, !limitsBox is STRING)

  -- Store the split method
  !this.splitType = !splitMethod

  -- Select the box limits
  !this.box.select('RTEXT',!limitsBox)

  -- Set the gadgets
  !this.setVisible()

  -- Re-split the current element into spools
  !this.split(!this.elementRefe, !this.splitType, !this.box.selection(), !this.direction)

endmethod
--End of method definition for .runSplitting(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      .setData(ARRAY)
--
-- Description: Set the view direction to the passed isometric direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY of settings data [1] The element type used for HVAC penetrations
--                                      [2] The rule used to collect HVAC penetration elements
--                                      [3] The backing sheet that holds the material table
--                                      [4] The library that holds the material table entries
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!settings is ARRAY)

  !this.splitManager.peneType    = !settings[1]
  !this.splitManager.peneTagRule = !settings[2]
  !this.backingSheet             = !settings[3]
  !this.library                  = !settings[4]
  !this.splitManager.discipline  = !settings[5]

endmethod
--End of method definition for .setData(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .setDir(REAL)
--
-- Description: Set the view direction to the passed isometric direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The view isometric direction 1, 2, 3 or 4
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDir(!isoDir is REAL)

  if (!isoDir.eq(1)) then

    !direction[1] = -0.57735027377783287861
    !direction[2] = -0.57735027378667214126
    !direction[3] = -0.57735026000437239535

    if (!this.module.description.eq('DRAFT')) then
      !this.iso1.addPixmap(!!pml.getPathName('iso1_green.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small.png'))
    else
      !this.iso1.addPixmap(!!pml.getPathName('iso1_green_mar.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
    endif

  elseif (!isoDir.eq(2)) then

    !direction[1] = -0.57735027378372572038
    !direction[2] = 0.57735027378077918847
    !direction[3] = -0.57735026000437228433

    if (!this.module.description.eq('DRAFT')) then
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_green.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small.png'))
    else
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_green_mar.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
    endif

  elseif (!isoDir.eq(3)) then

    !direction[1] = 0.57735027378372572038
    !direction[2] = 0.57735027378077918847
    !direction[3] = -0.57735026000437228433

    if (!this.module.description.eq('DRAFT')) then
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_green.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small.png'))
    else
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_green_mar.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
    endif

  elseif (!isoDir.eq(4)) then

    !direction[1] = 0.57735027377783287861
    !direction[2] = -0.57735027378667214126
    !direction[3] = -0.57735026000437239535

    if (!this.module.description.eq('DRAFT')) then
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_green.png'))
    else
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_green_mar.png'))
    endif

  else

    !direction[1] = 0
    !direction[2] = 0
    !direction[3] = -1

    if (!this.module.description.eq('DRAFT')) then
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small.png'))
    else
      !this.iso1.addPixmap(!!pml.getPathName('iso1_small_mar.png'))
      !this.iso2.addPixmap(!!pml.getPathName('iso2_small_mar.png'))
      !this.iso3.addPixmap(!!pml.getPathName('iso3_small_mar.png'))
      !this.iso4.addPixmap(!!pml.getPathName('iso4_small_mar.png'))
    endif

  endif

  !this.view.direction = !direction

  !this.direction      = !isoDir

endmethod
-- End of method definition for .setDir(REAL)

------------------------------------------------------------------------
--
-- Method:      .setLimits()
--
-- Description: Set the splitting limits
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLimits()

  -- Check that the selected value is not the same as already calculated
  if (!this.box.selection().neq(!this.limitsBox)) then

    -- Re-split the current element into spools
    !this.split(!this.elementRefe, !this.splitType, !this.box.selection(), !this.direction)

    -- Store the limits box
    !this.limitsBox = !this.box.selection('RTEXT')

    -- Set the process values for splitting and north direction
    !this.setValues()

  endif

endmethod
-- End of method definition for .setLimits()

------------------------------------------------------------------------
--
-- Method:      .setValues()
--
-- Description: Set the process values for splitting and north direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setValues()

  !!isoMain.setValues(!this.box.selection('RTEXT'), !this.direction)

endmethod
-- End of method definition for .setValues()

------------------------------------------------------------------------
--
-- Method:      .setVisible()
--
-- Description: Set the gadgets visibility status
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setVisible()

  -- For split by volume
  if (!this.splitType.eq('VOLUME')) then

    !this.type.visible    = true
    !this.box.visible     = true
    !this.points.visible  = false

  -- For split by points
  else

    !this.type.visible    = false
    !this.box.visible     = false
    !this.points.visible  = true

  endif

endmethod
-- End of method definition for .setVisible()

------------------------------------------------------------------------
--
-- Method:      .split(DBREF,REAL,REAL)
--
-- Description: Split the passed element into spools
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The element to be split
--    2   R      STRING      The type of split either VOLUME or SPLITPOINT
--    2   R      REAL        The splitting limits box
--    3   R      REAL        The view isometric direction 1, 2, 3 or 4
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     If any spool does not have a volume
--
------------------------------------------------------------------------
define method .split(!elementRefe is DBREF, !splitType is STRING, !limitsBox is STRING, !isoDir is REAL) is BOOLEAN

  -- Initialise variables
  !this.elementRefe            = !elementRefe
  !this.splitType              = !splitType
  !this.splitManager.limitsBox = !limitsBox.real()
  !this.splitManager.spools    = ARRAY()

  -- Get the maximum number of entries in the mto table
  !this.splitManager.maxEntries  = !!isoMaxMtoEntries(!elementRefe.type, !this.backingSheet, !this.library)

  -- Split the element into spools for type HVAC
  if (!elementRefe.type.eq('HVAC')) then
    !spools = !this.splitManager.splitHvac(!elementRefe, false, !splitType)

  -- For type CWAY
  else
    !spools = !this.splitManager.splitCway(!elementRefe, false, !splitType)

  endif

  -- Add the spools to the drawlist
  !errors = !this.add(!elementRefe, !spools)

  -- If any passed spool has returned no volume
  if (!errors) then
    return !errors
  endif

  !this.splitManager.setEnhanced(1)

  !this.setDir(!isoDir)

  -- Display number of spools
  !this.numberOfSheetsA.val = 'Produces ' & !this.splitManager.getNumbSpools() & ' sheets of which this is ' & !this.splitManager.getEnhanced()

  -- Set the limits box
  !this.box.select('RTEXT', !limitsBox)
  !this.limitsBox = !limitsBox

  !!fmsys.setProgress(0)

  return !errors

endmethod
-- End of method definition for .split(DBREF,REAL,REAL)

------------------------------------------------------------------------
--
-- Method:      .testForSpools()
--
-- Description: Test the current HVAC as to whether it has been spooled
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .testForSpools()

  -- Initialise variables
  !hvacSpoolManager = object HVACSPOOLMANAGER()

  -- Test spools
  !verifySpools = !hvacSpoolManager.verifyHvacSpools(!this.elementRefe)

  if (!verifySpools.unset() or !verifySpools[1].eq('No Spool List in the HVAC')) then
    !this.spooled = false

  else
    !this.spooled = true

   endif

endmethod
-- End of method definition for .testForSpools()
