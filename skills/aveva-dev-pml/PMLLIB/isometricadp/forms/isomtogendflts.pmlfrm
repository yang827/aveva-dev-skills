-- File:            isomtogendflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the general default parameters for the mto table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(STRING)                    -                   Checks whether passed db element exists
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  isoMtoGenDflts()                 -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save(BOOLEAN)                    -                   Saves the form settings to file
--  selSet()                         -                   Set and select gadget values
--  setCe(STRING,GADGET)             -                   Close the form
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  setPen(GADGET)                   -                   Set form frame pen values and stores in form object
--  store()                          -                   Updates the form objects with the form values
--  store(GADGET,STRING)             -                   Store the chosen XY offset
--  upDown(REAL,STRING,GADGET)       -                   Raise or Lower distance gadgets
--
------------------------------------------------------------------------
setup form !!isoMtoGenDflts

  !this.formTitle = 'MTO General Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-MTO-GEN| width 40 lines 1

  option .type 'Drawing Type' at xmin ymax+0.1 call |!this.selSet()| width 10

  frame .gen ' Table Settings' at x0 ymax width 42 height 5

    rgroup .output ' Output' at xmin+2 ymin+0.8 call |!this.store()| VERTICAL
      add tag 'Individual component entries      ' select 'INDIV'
      add tag 'Entries sorted by one field       ' select 'SORTED'
    exit

    text .separator 'Field Separator' tagwidth 11 at x1 ymax+0.5 call |!this.store()| width 28 STRING

    toggle .key 'Display Key Characters' at xmin   ymax call |!this.store()|
    toggle .sym 'Display Symbol'         at xmin   ymax call |!this.store()|
    toggle .rep 'Replace'                at xmax+2 ymin call |!this.store()|

    text .widthKey  'Width'  tagwidth 4 at x1     ymax.key width 7 SCROLL 20 STRING
    text .heightKey 'Height' tagwidth 5 at xmax+1 ymin     width 7 SCROLL 20 STRING
    text .lengthKey 'Length' tagwidth 5 at xmax+1 ymin     width 7 SCROLL 20 STRING

  exit

  frame .loc 'Local Labels' at x0 ymax+0.1

    text .template 'Template' at xmin+1 ymax call |!this.check(!this.template.val)| width 28 STRING
    button .ce 'CE' at xmax+0.5 ymin call |!this.setCe('SYTM', !this.template)| pixmap width 10 height 12

    option .tPen 'Text Pen' at xmin.template ymax+0.6 call |!this.store()| pixmap width 20 height 12

    para   .pFpen   at xmin.tPen ymax+0.4 text 'Frame Pen'
    option .fPen '' at xmax      ymin call |!this.store()|              pixmap width 20 height 12
    option .fThick  at xmax+0.8  ymin call |!this.setPen(!this.fThick)| pixmap width 44 height 12
    option .fStyle  at xmax+0.8  ymin call |!this.store()|              pixmap width 90 height 12

    para    .pXOff    at xmin.pFpen ymax+0.4 text 'Offset'

    text   .xOff 'X' at xmax+1    ymin  width 8 is REAL format !!isoOffsetFormat
    button .xOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .xOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

    text   .yOff 'Y' at xmax+1    ymin.xOff  width 8is REAL format !!isoOffsetFormat
    button .yOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .yOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

  exit

  button .save  'Save'  at x0.2           ymax+0.5  call |!this.save(true)|
  button .reset 'Reset' at xmax_Save+5    ymin_Save call |!this.reset()|
  button .close 'Close' at xmax form-size ymin_Save call |!this.close()|

  -- Members
  member .modified   is BOOLEAN
  member .hvacMtoGen is ISOMTOGEN
  member .elecMtoGen is ISOMTOGEN
  member .title      is STRING

  -- Units
  member .units           is STRING
  member .offsetIncrement is REAL

exit
-- End of form definition for !!isoMtoGenDflts

------------------------------------------------------------------------
--
-- Method:        .isoMtoGenDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoMtoGenDflts()

  -- Read the application units
  !appUnits             = object ISOUNITS()
  !this.units           = !appUnits.getUnits()
  !this.offsetIncrement = !appUnits.getOffsetIncrement()

  -- Pixmaps
  !this.ce.addPixmap(!!pml.getPathName('browse.png'))
  !this.xOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.xOffDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.yOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.yOffDo.addPixmap(!!pml.getPathName('downcounter.png'))

  -- Callbacks
  !this.widthKey.callback  = |!this.store()|
  !this.heightKey.callback = |!this.store()|
  !this.lengthKey.callback = |!this.store()|
  !this.xOff.callback      = |!this.store(|
  !this.xOffUp.callback    = |!this.upDown(!this.offsetIncrement,'UP',!this.xOff)|
  !this.xOffDo.callback    = |!this.upDown(!this.offsetIncrement,'DOWN',!this.xOff)|
  !this.yOff.callback      = |!this.store(|
  !this.yOffUp.callback    = |!this.upDown(!this.offsetIncrement,'UP',!this.yOff)|
  !this.yOffDo.callback    = |!this.upDown(!this.offsetIncrement,'DOWN',!this.yOff)|

  -- Type
  !text[1] = 'Hvac'
  !text[2] = 'Electrical'
  !this.type.dtext = !text
  !text[2] = 'Elec'
  !this.type.rtext = !text

  -- Pens
  do !count from 1 to 16
    !iconFile = 'colour' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
    !rtext[!count] = !count.string()
  enddo
  !this.tPen.dtext = !dtext
  !this.tPen.rtext = !rtext
  !this.fPen.dtext = !dtext
  !this.fPen.rtext = !rtext

  -- Thickness
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext[1] = !!pml.getPathName('linestylethin.png')
  !dtext[2] = !!pml.getPathName('linestylemedium.png')
  !dtext[3] = !!pml.getPathName('linestylethick.png')
  !rtext[1] = |Thin|
  !rtext[2] = |Medium|
  !rtext[3] = |Thick|
  !this.fThick.dtext = !dtext
  !this.fThick.rtext = !rtext

  -- Style
  !dtext     = ARRAY()
  !rtext     = ARRAY()
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|
  do !count from 1 to 10
    !iconFile = 'linestylethin' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Set form member objects
  !this.hvacMtoGen = !!isoDflts.data.hvacMtoGen
  !this.elecMtoGen = !!isoDflts.data.elecMtoGen

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoMtoGenDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set form member objects
  !this.hvacMtoGen = !!isoMain.isoAdpApp.data.hvacMtoGen
  !this.elecMtoGen = !!isoMain.isoAdpApp.data.elecMtoGen

  -- Set gadget settings
  !this.selSet()

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!this.hvacMtoGen.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .check(STRING)
--
-- Description: Checks whether passed db element exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .check(!element is STRING)

  -- Check if entered element actually exists
  !unusedTest = !element.dbref()
    handle (2,109)
      !!alert.error('The entered element name does not exist')
      !this.setModified(true)
      return
    endhandle

  -- Store change
  !this.store()

endmethod
-- End of method definition for .check(STRING)

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoMtoGenDflts.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save(!confirm is BOOLEAN)

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    if (!confirm) then
      !response = !!alert.confirm('Are you sure you wish to save the changes?')
      if (!response.eq('NO')) then
        return
      endif
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.hvacMtoGen = !this.hvacMtoGen
    !!isoMain.isoAdpApp.data.elecMtoGen = !this.elecMtoGen

    -- Save the settings to defaults file
    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric MTO General defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Hvac
    !array.append('-- Part 1 - Hvac')
    if (!this.hvacMtoGen.individual) then
      !array.append('INDIV')
    else
      !array.append('SORTED')
    endif
    !array.append(!this.hvacMtoGen.separator)
    !array.append(!this.hvacMtoGen.key)
    !array.append(!this.hvacMtoGen.symbol)
    !array.append(!this.hvacMtoGen.replace)
    !array.append(!this.hvacMtoGen.template.flnm)
    !array.append(!this.hvacMtoGen.tColour.string())
    !array.append(!this.hvacMtoGen.fColour.string())
    !array.append(!this.hvacMtoGen.offset[1].string(!!isoOffsetFormat) & ' ' & !this.hvacMtoGen.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.hvacMtoGen.fStyle)
    !array.append(!this.hvacMtoGen.fThickness)

    -- Electrical
    !array.append('-- Part 2 - Electrical')
    if (!this.elecMtoGen.individual) then
      !array.append('INDIV')
    else
      !array.append('SORTED')
    endif
    !array.append(!this.elecMtoGen.template.flnm)
    !array.append(!this.elecMtoGen.tColour.string())
    !array.append(!this.elecMtoGen.fColour.string())
    !array.append(!this.elecMtoGen.offset[1].string(!!isoOffsetFormat) & ' ' & !this.elecMtoGen.offset[2].string(!!isoOffsetFormat))
    !array.append(!this.elecMtoGen.fStyle)
    !array.append(!this.elecMtoGen.fThickness)
    !array.append(|'| & !this.elecMtoGen.separator & |'|)
    !array.append(!this.elecMtoGen.key)
    !array.append(|'| & !this.elecMtoGen.widthKey & |'|)
    !array.append(|'| & !this.elecMtoGen.heightKey & |'|)
    !array.append(|'| & !this.elecMtoGen.lengthKey & |'|)

    -- Write to file
    !this.hvacMtoGen.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Initialise variables
  !gName = !this.type.selection() & 'MtoGen'

  -- Set output gadget
  if (!this.$!gName$N.individual) then
     !this.output.select('INDIV')
  else
     !this.output.select('SORTED')
  endif

  -- Set separator gadget
  if (!this.type.selection().eq('Hvac')) then

    !this.sym.visible       = true
    !this.rep.visible       = true
    !this.widthKey.visible  = false
    !this.heightKey.visible = false
    !this.lengthKey.visible = false

    !this.separator.val = !this.$!gName$N.separator
    !this.key.val       = !this.$!gName$N.key
    !this.sym.val       = !this.$!gName$N.symbol
    !this.rep.val       = !this.$!gName$N.replace

  else

    !this.sym.visible       = false
    !this.rep.visible       = false
    !this.widthKey.visible  = true
    !this.heightKey.visible = true
    !this.lengthKey.visible = true

    !this.separator.val = !this.$!gName$N.separator
    !this.key.val       = !this.$!gName$N.key
    !this.widthKey.val  = !this.$!gName$N.widthKey
    !this.heightKey.val = !this.$!gName$N.heightKey
    !this.lengthKey.val = !this.$!gName$N.lengthKey

  endif

  -- Set template gadget
  !this.template.val = !this.$!gName$N.template.flnm

  -- Set offset gadget
  !this.xOff.val = !this.$!gName$N.offset[1]
  !this.yOff.val = !this.$!gName$N.offset[2]

  -- Select pens
  !this.tPen.val = !this.$!gName$N.tColour
  !this.fPen.val = !this.$!gName$N.fColour

  -- Select the frame thickness and style
  !this.fThick.select('RTEXT', !this.$!gName$N.fThickness)
  !this.fStyle.select('RTEXT', !this.$!gName$N.fStyle)

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setCe(STRING,GADGET)
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type being searched for
--    2   R      GADGET      The gadget receiving the chosen element
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setCe(!type is STRING, !gadget is GADGET)

  -- Set browse form to search for db elements
  pml load form !!isoBrowse

  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  show !!isoBrowse

endmethod
-- End of method definition for .setCe(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setPen(GADGET)
--
-- Description: Set form frame pen values and stores in form object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setPen(!gadget is GADGET)

  -- Initialise variables
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|

  -- For thickness change the style values
  do !count from 1 to 10
    !iconFile = 'linestyle' & !gadget.selection().lowCase() & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.fStyle.dtext = !dtext
  !this.fStyle.rtext = !rtext

  -- Store change
  !this.store()

endmethod
-- End of method definition for .setPen(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Updates the form objects with the form values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Initialise variables
  !gName = !this.type.selection() & 'MtoGen'

  -- Save settings to the object
  if (!this.output.val.eq(1)) then
    !this.$!gName$N.individual = true
    !this.$!gName$N.sorted = false
  else
    !this.$!gName$N.individual = false
    !this.$!gName$N.sorted = true
  endif

  !this.$!gName$N.separator = !this.separator.val
  !this.$!gName$N.key       = !this.key.val

  -- HVAC specific
  if (!this.type.selection().eq('Hvac')) then

    !this.$!gName$N.symbol    = !this.sym.val
    !this.$!gName$N.replace   = !this.rep.val

    if (!this.key.val.not() or !this.sym.val.not()) then
      !this.rep.val = false
    endif

  -- Electrical specific
  else

    !this.$!gName$N.widthKey  = !this.widthKey.val
    !this.$!gName$N.heightKey = !this.heightKey.val
    !this.$!gName$N.lengthKey = !this.lengthKey.val

  endif

  !this.$!gName$N.template   = !this.template.val.dbref()
  !this.$!gName$N.tColour    = !this.tPen.selection().real()
  !this.$!gName$N.fColour    = !this.fPen.selection().real()
  !this.$!gName$N.fThickness = !this.fThick.selection()
  !this.$!gName$N.fStyle     = !this.fStyle.selection()
  !this.$!gName$N.offset[1]  = !this.xOff.val
  !this.$!gName$N.offset[2]  = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:        .store(GADGET,STRING)
--
-- Description:   Store the chosen XY offset
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!dummyObject is GADGET, !dummyAction is STRING)

  -- Initialise variables
  !gName = !this.type.selection() & 'MtoGen'

  -- Save settings to the object
  -- Unfortunately, the gadget value query is in system units so we must convert it to ours
  !this.$!gName$N.offset[1] = !this.xOff.val
  !this.$!gName$N.offset[2] = !this.yOff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise or Lower distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDown(!increment is REAL, !direction is STRING, !gadget is GADGET)

  -- Initialise variables
  !gName = !this.type.selection() & 'MtoGen'

  -- Raise the value by the increment
  if (!direction.eq('UP')) then

    !nextValue = !gadget.val + !increment

  -- Reduce value by the increment
  else

    !nextValue = !gadget.val - !increment

  endif

  -- Test for zero or less
  if (!nextValue.leq(0)) then
   !nextValue = 0
  endif

  -- Set the gadget value
  !gadget.val = !nextValue

  -- Save settings to the object
  !this.$!gName$N.offset[1] = !this.xOff.val.convertUnits(!this.units)
  !this.$!gName$N.offset[2] = !this.yOff.val.convertUnits(!this.units)

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .upDown()
