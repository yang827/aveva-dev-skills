--
-- File:            isomtoparam.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Displays all of the HVAC size parameters and allows them to be switched
-- on/off from the mto table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Close the form
--  getParam()                       -                   Populates the toggle gadgets
--  getType()                        -                   Gets all dataset values
--  init()                           -                   Method to initialise the form
--  isoMtoParam()                    -                   Construct
--  modify()                         -                   Switch parameter on/off
--  save()                           -                   Saves the form settings to file
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--
------------------------------------------------------------------------
setup form !!isoMtoParam

  !this.formTitle = |MTO Parameter Switching|
  !this.initCall  = |!this.init()|
  !this.quitCall  = '!this.cancel()'

  para .text   at x0     ymin text |Defaults Filename:|
  para .source at xmin+1 ymax text |%PDMSDFLTS%\IsoADP\DRA-ISO-MTO-PARAMS| width 30 lines 1

  frame .comp |Component Selection| at xmin.text ymax+0.1

    option .group |Group| at xmin.comp+1 ymax+0.1 call |!this.getType()|  width 5

    option .type |Type|   at xmax+1.5    ymin     call |!this.getParam()| width 10

  exit

  frame .para | Parameter Switch | at x0 ymax width 36

    path down
    do !count from 1 to 20
      toggle .para$!count at xmin.para+1.6 ymax call |!this.modify()|
      para .desc$!count   at xmax ymin width 30 lines 1
    enddo

  exit

  button .ok     |Save|   at x0             ymax.para+0.5 call |!this.save()|
  button .cancel |Cancel| at xmax form-size ymin.ok       call |!this.cancel()|

  -- Members
  member .file     is FILE
  member .switches is ARRAY
  member .modified is BOOLEAN
  member .title    is STRING

exit
-- End of form definition for !!isoMtoParam

------------------------------------------------------------------------
--
-- Method:        .isoMtoParam()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoMtoParam()

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoMtoParam()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Read parameter switch defaults file
  !this.file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-MTO-PARAMS')
  if (!this.file.exists().not()) then
    !!alert.error('The defaults file DRA-ISO-MTO-PARAMS does not exist. Please contact your System Administrator')
    return
  endif
  !this.switches = !this.file.readFile()

  -- Get data from mto data sets
  -- Used to be: VAR !allCate COLL ALL CATE FOR /$:AVEVAHVACMTO$:
  -- But it was broken, now consistent with E3D.
  VAR !allCate COLL ALL CATE FOR /AVEVAHVACMTO
  handle any
  	VAR !allCate COLL ALL CATE FOR /CADCHVACMTO
  endhandle
  VAR !allPurp EVAL PURP FOR ALL FROM !allCate

  -- Populate group gadget
  !this.group.dtext = !allPurp
  !this.group.rtext = !allCate

  -- Populate type gadget
  !this.getType()

  -- Mark form as not modified
  !this.setModified(false)

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .cancel()

  -- Check for modified form
  if (!this.modified) then
    !answer = !!alert.question('The switches have been modified. Do you wish to save the changes?')
    if (!answer.upCase().eq('YES')) then
      !this.save()
    elseif (!answer.upCase().eq('CANCEL')) then
      return
    endif
  endif

  hide !!isoMtoParam

endmethod
-- End of method definition for .cancel()

-----------------------------------------------------------------------
--
-- Method:      .getType()
--
-- Description: Gets all dataset values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .getType()

  -- Initialise variables
  !group = !this.group.selection('RTEXT')

  -- Get all type data for the selected group
  VAR !allDtse COLL ALL DTSE FOR $!group
  VAR !allFunc EVAL FUNC FOR ALL FROM !allDtse

  -- Populate gadgets
  !this.type.dtext = !allFunc
  !this.type.rtext = !allDtse

  -- Populate parameter gadgets
  !this.getParam()

endmethod
-- End of method definition for .getType()

-----------------------------------------------------------------------
--
-- Method:      .getParam()
--
-- Description: Populates the toggle gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .getParam()

  -- Initialise variables
  !type = !this.type.selection('RTEXT')

  -- Get all parameter data for the selected type
  VAR !allData COLL ALL DATA FOR $!type
  VAR !allDesc EVAL DESC FOR ALL FROM !allData
  VAR !allDkey EVAL DKEY FOR ALL FROM !allData

  -- Set parameter description gadgets
  do !index ind !allDesc
    !gadget = !this.desc$!index
    if (!allDkey[!index].upCase().eq('UNSET')) then
      !gadget.val = !allDesc[!index]
    else
      !gadget.val = !allDesc[!index] & ' "' & !allDkey[!index] & '"'
    endif
  enddo

  -- Read defaults file switch data
  do !entry val !this.switches
    if (!entry.match('!!' & !this.type.selection('DTEXT') & '=').neq(0)) then
      !data = !entry.after('=|').before('|').split(',')
      break
    endif
  enddo

  -- Set parameter toggle gadgets on/off and active
  do !index ind !data
    !gadget = !this.para$!index
    if (!data[!index].eq('On')) then
      !gadget.val = true
    else
      !gadget.val = false
    endif
    !gadget.active = true
  enddo

  -- Clear and deactivate any remaining gadgets
  do !count from (!index + 1) to 20

    -- Set toggle gadget off and inactive
    !gadget = !this.para$!count
    !gadget.val = false
    !gadget.active = false

    -- Set the description gadget to null string
    !gadget = !this.desc$!count
    !gadget.val = ''

  enddo

endmethod
-- End of method definition for .getParam()

-----------------------------------------------------------------------
--
-- Method:      .modify()
--
-- Description: Switch parameter on/off
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .modify()

  -- Build parameter switch string
  do !count from 1 to 20

    -- Initialise variables
    !tGadget = !this.para$!count
    !pGadget = !this.desc$!count

    -- Test for end of actual parameters
    break if (!pGadget.val.eq(''))

    -- Build string
    if (!count.eq(1)) then
      if (!tGadget.val) then
        !string = 'On'
      else
        !string = 'Off'
      endif
    elseif (!tGadget.val) then
      !string = !string & ',On'
    else
      !string = !string & ',Off'
    endif

  enddo

  -- Change parameter switches for current type
  do !index ind !this.switches
    if (!this.switches[!index].match(!this.type.selection('DTEXT')).neq(0)) then
      !this.switches[!index] = '!!' & !this.type.selection('DTEXT') & '=|' & !string & '|'
    endif
  enddo

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .modify()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save()

  -- Save changes
  if (!this.modified) then
    !this.file.writeFile('OVERWRITE',!this.switches)
    !this.setModified(false)
  endif

endmethod
-- End of method definition for .save()

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and close/cancel button
  if (!modified) then
    !this.formTitle  = !this.title & ' *'
    !this.cancel.tag = 'Cancel'
    !this.ok.active  = true

  else
    !this.formTitle  = !this.title
    !this.cancel.tag = 'Close'
    !this.ok.active  = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)
