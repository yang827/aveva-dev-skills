--
-- File:            isopenedflts.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Set, modify and store the default parameters for the labels
-- used to indicate a penetration element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(STRING)                    -                   Check that the entered element exists
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  isoPeneDflts()                   -                   Construct
--  reset()                          -                   Resets form to the saved settings before modified
--  save(BOOLEAN)                    -                   Saves the form settings to file
--  selSet()                         -                   Set and select gadget values
--  setCe(STRING,GADGET)             -                   Close the form
--  setModified(BOOLEAN)             -                   Set this form as modified or not
--  setPen(GADGET,GADGET)            -                   Set the available styles to display the chosen thicknesses
--  store()                          -                   Updates the form objects with the form values
--  store(GADGET,STRING)             -                   Store the chosen character height and XY offset
--  upDown(REAL,STRING,GADGET)       -                   Raise or Lower distance gadgets
--
------------------------------------------------------------------------
setup form !!isoPeneDflts

  !this.formTitle = 'Penetration Defaults'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  para .source at x0 ymin text |Filename: %PDMSDFLTS%\IsoADP\DRA-ISO-PENETRATION| width 40 lines 1

  option .type 'Drawing Type' at xmin ymax+0.1 call |!this.selSet()| width 10

  frame .switch 'Component' at x0 ymax+0.1 width 43

    option .element 'Penetration Component' at x1   ymax-0.1 call |!this.store()| width 6
    text   .rule    'Find Rule'             at xmin ymax+0.2 call |!this.store()| width 30 is STRING

  exit

  frame .symb 'Symbol' at x0 ymax+0.1 width 43

    toggle .symbol |Draw Symbol| at x1 ymax call |!this.store()|

    text   .sTemplate 'Template' at xmin+0.5 ymax+0.1 call |!this.check(!this.sTemplate.val)| width 28 is STRING
    button .sCe                  at xmax+0.5 ymin+0.1 call |!this.setCe('TXTM', !this.sTemplate)| pixmap width 10 height 12

    para   .sPFpen   at xmin.sTemplate ymax+0.6 text 'Frame Pen'
    option .sFPen    at xmax           ymin call |!this.store()|                             pixmap width 20 height 12
    option .sFThick  at xmax+0.8       ymin call |!this.setPen(!this.sFThick,!this.sFStyle)| pixmap width 44 height 12
    option .sFStyle  at xmax+0.8       ymin call |!this.store()|                             pixmap width 90 height 12

    numeric .scale 'Scale   ' at xmin.sPFpen ymax+0.5 call |!this.store(| range 0.1 10 step 0.05 ndp 2 width 4

  exit

  frame .loc 'Label' at x0 ymax+0.1 width 43

    toggle .label |Draw Label| at x1 ymax call |!this.store()|

    text   .lTemplate 'Template' at xmin+0.5  ymax     call |!this.check(!this.lTemplate.val)| width 28 is STRING
    button .lCe                  at xmax+0.5  ymin+0.1 call |!this.setCe('TXTM', !this.lTemplate)| pixmap width 10 height 12

    option .lTPen 'Text Pen'     at xmin.lTemplate ymax+0.6 call |!this.store()| pixmap width 20 height 12

    text   .lChei 'Text Height' tagwidth 9 at xmax+4.5 ymin  width 8 is REAL format !!isoTextFormat
    button .lCheiUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .lCheiDo at xmin      ymax-0.05 pixmap width 13 height 10

    para   .plFPen   at xmin.lTPen ymax+0.5 text 'Frame Pen'
    option .lFPen    at xmax       ymin call |!this.store()|                             pixmap width 20 height 12
    option .lFThick  at xmax+0.8   ymin call |!this.setPen(!this.lFThick,!this.lFStyle)| pixmap width 44 height 12
    option .lFStyle  at xmax+0.8   ymin call |!this.store()|                             pixmap width 90 height 12

    para    .pXOff    at xmin.lTPen ymax+0.5 text 'Offset'

    text   .lXOff 'X' at xmax+1    ymin  width 8 is REAL format !!isoOffsetFormat
    button .lXOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .lXOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

    text   .lYOff 'Y' at xmax+1    ymin.lXOff  width 8is REAL format !!isoOffsetFormat
    button .lYOffUp   at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .lYOffDo   at xmin      ymax-0.05 pixmap width 13 height 10

  exit

  frame .dimn 'Dimension' at x0 ymax+0.1 width 43

    toggle .dimension |Draw Dimension| at x1 ymax call |!this.store()|

    option .dTPen 'Text Pen'     at xmin+0.5 ymax call |!this.store()| pixmap width 20 height 12

    text   .dChei 'Text Height' tagwidth 9 at xmax+4.5 ymin  width 8 is REAL format !!isoTextFormat
    button .dCheiUp at xmax-0.05 ymin-0.12 pixmap width 13 height 10
    button .dCheiDo at xmin      ymax-0.05 pixmap width 13 height 10

    para   .pdFPen   at xmin.dTPen ymax+0.5 text 'Line Pen '
    option .dFPen    at xmax       ymin call |!this.store()|                             pixmap width 20 height 12
    option .dFThick  at xmax+0.8   ymin call |!this.setPen(!this.dFThick,!this.dFStyle)| pixmap width 44 height 12
    option .dFStyle  at xmax+0.8   ymin call |!this.store()|                             pixmap width 90 height 12

    para   .pTerm at xmin.dTPen ymax+0.5 width 9 lines 1
    option .term  at xmin.dFPen ymin call |!this.modified = true !this.store()| pixmap width 16 height 16
    !this.pTerm.val = 'Terminator'

    para    .pOff at xmin.pdFPen ymax+0.3 text 'Offset'
    text   .doff   at xmax+3      ymin  width 8 is REAL format !!isoOffsetFormat
    button .doffUp at xmax-0.05   ymin-0.12 pixmap width 13 height 10
    button .doffDo at xmin        ymax-0.05 pixmap width 13 height 10

    toggle .relBore 'Relative to Bore' tagwidth 12 at xmax+2 ymin.doff call |!this.store()|

  exit

  button .save  'Save'  at x0.2           ymax+0.2  call |!this.save(true)|
  button .reset 'Reset' at xmax_Save+5    ymin_Save call |!this.reset()|
  button .close 'Close' at xmax form-size ymin_Save call |!this.close()|

  -- Members
  member .modified    is BOOLEAN
  member .hvacPeneTag is ISOPENETAG
  member .elecPeneTag is ISOPENETAG
  member .title       is STRING

  -- Units
  member .units           is STRING
  member .textIncrement   is REAL
  member .offsetIncrement is REAL

exit
-- End of form definition for !!isoPeneDflts

------------------------------------------------------------------------
--
-- Method:        .isoPeneDflts()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoPeneDflts()

  -- Read the application units
  !appUnits             = object ISOUNITS()
  !this.units           = !appUnits.getUnits()
  !this.textIncrement   = !appUnits.getTextIncrement()
  !this.offsetIncrement = !appUnits.getOffsetIncrement()

  -- Pixmaps
  !this.sCe.addPixmap(!!pml.getPathName('browse.png'))
  !this.lCe.addPixmap(!!pml.getPathName('browse.png'))
  !this.lCheiUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.lCheiDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.lXOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.lXOffDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.lYOffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.lYOffDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.dCheiUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.dCheiDo.addPixmap(!!pml.getPathName('downcounter.png'))
  !this.doffUp.addPixmap(!!pml.getPathName('upcounter.png'))
  !this.doffDo.addPixmap(!!pml.getPathName('downcounter.png'))

  -- Callbacks
  !this.lChei.callback   = |!this.store(|
  !this.lCheiUp.callback = |!this.upDown(!this.textIncrement,'UP',!this.lChei)|
  !this.lCheiDo.callback = |!this.upDown(!this.textIncrement,'DOWN',!this.lChei)|
  !this.lXOff.callback   = |!this.store(|
  !this.lXOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.lXOff)|
  !this.lXOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.lXOff)|
  !this.lYOff.callback   = |!this.store(|
  !this.lYOffUp.callback = |!this.upDown(!this.offsetIncrement,'UP',!this.lYOff)|
  !this.lYOffDo.callback = |!this.upDown(!this.offsetIncrement,'DOWN',!this.lYOff)|
  !this.dChei.callback   = |!this.store(|
  !this.dCheiUp.callback = |!this.upDown(!this.textIncrement,'UP',!this.dChei)|
  !this.dCheiDo.callback = |!this.upDown(!this.textIncrement,'DOWN',!this.dChei)|
  !this.doff.callback    = |!this.store(|
  !this.doffUp.callback  = |!this.upDown(!this.offsetIncrement,'UP',!this.doff)|
  !this.doffDo.callback  = |!this.upDown(!this.offsetIncrement,'DOWN',!this.doff)|

  -- Type
  !text[1]         = 'Hvac'
  !text[2]         = 'Electrical'
  !this.type.dtext = !text
  !text[2]         = 'Elec'
  !this.type.rtext = !text

  -- Element
  !text               = ARRAY()
  !text[1]            = 'ATTA'
  !text[2]            = 'WELD'
  !text[3]            = 'PCOM'
  !this.element.dtext = !text
  !this.element.rtext = !text

  -- Pens
  !dtext = ARRAY()
  !rtext = ARRAY()
  do !count from 1 to 16
    !iconFile = 'colour' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
    !rtext[!count] = !count.string()
  enddo
  !this.sFPen.dtext = !dtext
  !this.sFPen.rtext = !rtext
  !this.lTPen.dtext = !dtext
  !this.lTPen.rtext = !rtext
  !this.lFPen.dtext = !dtext
  !this.lFPen.rtext = !rtext
  !this.dTPen.dtext = !dtext
  !this.dTPen.rtext = !rtext
  !this.dFPen.dtext = !dtext
  !this.dFPen.rtext = !rtext

  -- Thickness
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext[1] = !!pml.getPathName('linestylethin.png')
  !dtext[2] = !!pml.getPathName('linestylemedium.png')
  !dtext[3] = !!pml.getPathName('linestylethick.png')
  !rtext[1] = |Thin|
  !rtext[2] = |Medium|
  !rtext[3] = |Thick|
  !this.sFThick.dtext = !dtext
  !this.sFThick.rtext = !rtext
  !this.lFThick.dtext = !dtext
  !this.lFThick.rtext = !rtext
  !this.dFThick.dtext = !dtext
  !this.dFThick.rtext = !rtext

  -- Style
  !dtext = ARRAY()
  !rtext = ARRAY()
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|
  do !count from 1 to 10
    !iconFile = 'linestylethin' & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo
  !this.sFStyle.dtext = !dtext
  !this.sFStyle.rtext = !rtext
  !this.lFStyle.dtext = !dtext
  !this.lFStyle.rtext = !rtext
  !this.dFStyle.dtext = !dtext
  !this.dFStyle.rtext = !rtext

  -- Terminator
  !dtex[1] = (!!pml.getPathName('lter_none.png'))
  !dtex[2] = (!!pml.getPathName('lter_arr.png'))
  !dtex[3] = (!!pml.getPathName('lter_dot.png'))
  !dtex[4] = (!!pml.getPathName('lter_obl.png'))
  !rtex[1] = 'OFF'
  !rtex[2] = 'ARR'
  !rtex[3] = 'DOT'
  !rtex[4] = 'OBL'
  !this.term.dtext = !dtex
  !this.term.rtext = !rtex

  -- Set form member objects
  !this.hvacPeneTag = !!isoMain.isoAdpApp.data.hvacPeneTag
  !this.elecPeneTag = !!isoMain.isoAdpApp.data.elecPeneTag

  -- Set modified events
  !this.scale.modifiedEvents = true

  -- Store form title
  !this.title = !this.formTitle

endmethod
-- End of method definition for .isoPeneDflts()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .init()

  -- Set form member objects
  !this.hvacPeneTag = !!isoMain.isoAdpApp.data.hvacPeneTag
  !this.elecPeneTag = !!isoMain.isoAdpApp.data.elecPeneTag

  -- Set gadget settings
  !this.selSet()

  -- Mark form as not modified
  -- For a previous version allow the latest settings to be saved
  if (!this.hvacPeneTag.prevVersion) then
    !this.setModified(true)

  else
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .check(STRING)
--
-- Description: Check that the entered element exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .check(!element is STRING)

  -- Initialise variables
  !error = false

  -- Check if entered element actually exists
  !unusedTest = !element.dbref()
    handle (2,109)
      !!alert.error('The entered element name does not exist')
      !this.setModified(true)
      return
    endhandle

  -- Store change
  if (!error.not()) then
    !this.store()
  endif

endmethod
-- End of method definition for .check(STRING)

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .close()

  -- Check for modified form
  if (!this.modified) then

    -- Ask
    !response = !!alert.question('Do you wish to save the changes?')
    if (!response.eq('YES')) then

      -- Save the changes
      !this.save(false)

    elseif (!response.eq('CANCEL')) then
      return
    endif

  endif

  -- Hide form
  !!isoPeneDflts.hide()

endmethod
-- End of method definition for .close()

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Resets form to the saved settings before modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .reset()

  -- For a modified form only
  if (!this.modified) then

    !response = !!alert.confirm('Are you sure you wish to lose the changes?')
    if (!response.eq('YES')) then

      -- Reinitialise form
      !this.init()

    endif

  endif

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .save(BOOLEAN)
--
-- Description: Saves the form settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to confirm the save beforehand
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .save(!confirm is BOOLEAN)

  -- For a modified form only
  if (!this.modified) then

    -- Ask
    if (!confirm) then
      !response = !!alert.confirm('Are you sure you wish to save the changes?')
      if (!response.eq('NO')) then
        return
      endif
    endif

    -- Save settings to the defaults object
    !!isoMain.isoAdpApp.data.hvacPeneTag = !this.hvacPeneTag
    !!isoMain.isoAdpApp.data.elecPeneTag = !this.elecPeneTag

    -- Save the settings to defaults file
    -- Header
    !array[1] = '--'
    !array[2] = '-- Isometric Penetration defaults'
    !array[3] = '--'
    !array[4] = '--'

    -- Hvac
    !array.append('-- Part 1 - Hvac')
    !array.append(!this.hvacPeneTag.element)
    !array.append(!this.hvacPeneTag.rule)
    !array.append(!this.hvacPeneTag.drawSymbol.string())
    !array.append(!this.hvacPeneTag.sTemplate.flnm)
    !array.append(!this.hvacPeneTag.scale.string())
    !array.append(!this.hvacPeneTag.sFColour.string())
    !array.append(!this.hvacPeneTag.sFStyle)
    !array.append(!this.hvacPeneTag.sFThickness)
    !array.append(!this.hvacPeneTag.drawLabel.string())
    !array.append(!this.hvacPeneTag.lTemplate.flnm)
    !array.append(!this.hvacPeneTag.lTColour.string())
    !array.append(!this.hvacPeneTag.lChei.string(!!isoTextFormat))
    !array.append(!this.hvacPeneTag.lFColour.string())
    !array.append(!this.hvacPeneTag.lFStyle)
    !array.append(!this.hvacPeneTag.lFThickness)
    !array.append(!this.hvacPeneTag.lOffset[1].string(!!isoOffsetFormat) & ' ' & !this.hvacPeneTag.lOffset[2].string(!!isoOffsetFormat))
    !array.append(!this.hvacPeneTag.drawDimn.string())
    !array.append(!this.hvacPeneTag.dTColour.string())
    !array.append(!this.hvacPeneTag.dChei.string(!!isoTextFormat))
    !array.append(!this.hvacPeneTag.dColour.string())
    !array.append(!this.hvacPeneTag.dStyle)
    !array.append(!this.hvacPeneTag.dThickness)
    !array.append(!this.hvacPeneTag.term)
    !array.append(!this.hvacPeneTag.dOffset.string(!!isoOffsetFormat))
    !array.append(!this.hvacPeneTag.relBore.string())

    -- Electrical
    !array.append('-- Part 2 - Electrical')
    !array.append(!this.elecPeneTag.element)
    !array.append(!this.elecPeneTag.rule)
    !array.append(!this.elecPeneTag.drawSymbol.string())
    !array.append(!this.elecPeneTag.sTemplate.flnm)
    !array.append(!this.elecPeneTag.scale.string())
    !array.append(!this.elecPeneTag.sFColour.string())
    !array.append(!this.elecPeneTag.sFStyle)
    !array.append(!this.elecPeneTag.sFThickness)
    !array.append(!this.elecPeneTag.drawLabel.string())
    !array.append(!this.elecPeneTag.lTemplate.flnm)
    !array.append(!this.elecPeneTag.lTColour.string())
    !array.append(!this.elecPeneTag.lChei.string(!!isoTextFormat))
    !array.append(!this.elecPeneTag.lFColour.string())
    !array.append(!this.elecPeneTag.lFStyle)
    !array.append(!this.elecPeneTag.lFThickness)
    !array.append(!this.elecPeneTag.lOffset[1].string(!!isoOffsetFormat) & ' ' & !this.elecPeneTag.lOffset[2].string(!!isoOffsetFormat))
    !array.append(!this.elecPeneTag.drawDimn.string())
    !array.append(!this.elecPeneTag.dTColour.string())
    !array.append(!this.elecPeneTag.dChei.string(!!isoTextFormat))
    !array.append(!this.elecPeneTag.dColour.string())
    !array.append(!this.elecPeneTag.dStyle)
    !array.append(!this.elecPeneTag.dThickness)
    !array.append(!this.elecPeneTag.term)
    !array.append(!this.elecPeneTag.dOffset.string(!!isoOffsetFormat))
    !array.append(!this.elecPeneTag.relBore.string())

    -- Write to file
    !this.hvacPeneTag.file.writefile('over',!array)

    -- Mark form as not modified
    !this.setModified(false)

  endif

endmethod
-- End of method definition for .save(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .selSet()
--
-- Description: Set and select gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .selSet()

  -- Initialise variables
  !gName = !this.type.selection() & 'PeneTag'

  -- Set template gadgets
  !this.sTemplate.val = !this.$!gName$N.sTemplate.flnm
  !this.lTemplate.val = !this.$!gName$N.lTemplate.flnm

  -- Set offset gadgets
  !this.lXOff.val = !this.$!gName$N.lOffset[1]
  !this.lYOff.val = !this.$!gName$N.lOffset[2]
  !this.doff.val  = !this.$!gName$N.dOffset

  -- Select pens
  !this.sFPen.val   = !this.$!gName$N.sFColour
  !this.lTPen.val   = !this.$!gName$N.lTColour
  !this.lFPen.val   = !this.$!gName$N.lFColour
  !this.dTPen.val   = !this.$!gName$N.dTColour
  !this.dFPen.val   = !this.$!gName$N.dColour

  -- Set character heights
  !this.lChei.val = !this.$!gName$N.lChei
  !this.dChei.val = !this.$!gName$N.dChei

  -- Switches
  !this.symbol.val     = !this.$!gName$N.drawSymbol
  !this.label.val      = !this.$!gName$N.drawLabel
  !this.dimension.val = !this.$!gName$N.drawDimn

  -- Element
  !this.element.select('RTEXT',!this.$!gName$N.element)

  -- Rule
  !this.rule.val = !this.$!gName$N.rule

  -- Scale
  !this.scale.val = !this.$!gName$N.scale

  -- Set dimension terminator
  !this.term.select('RTEXT',!this.$!gName$N.term)

  -- Set relative to bore
  !this.relBore.val = !this.$!gName$N.relBore

  -- Select the thickness and style for all pens
  !this.sFStyle.select('RTEXT', !this.$!gName$N.sFStyle)
  !this.sFThick.select('RTEXT', !this.$!gName$N.sFThickness)
  !this.lFStyle.select('RTEXT', !this.$!gName$N.lFStyle)
  !this.lFThick.select('RTEXT', !this.$!gName$N.lFThickness)
  !this.dFStyle.select('RTEXT', !this.$!gName$N.dStyle)
  !this.dFThick.select('RTEXT', !this.$!gName$N.dThickness)

  -- Set the 'Relative to Bore' text depending on type
  -- HVAC
  if (!this.type.selection().eq('Hvac')) then
    !this.relBore.tag = 'Relative to Bore'

  -- CWAY
  else
    !this.relBore.tag = 'Relative to Width'

  endif

endmethod
-- End of method definition for .selSet()

-----------------------------------------------------------------------
--
-- Method:      .setCe(STRING,GADGET)
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type being searched for
--    2   R      GADGET      The gadget receiving the chosen element
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setCe(!type is STRING, !gadget is GADGET)

  -- Set browse form to search for db elements
  pml load form !!isoBrowse

  !!isoBrowse.what   = !type
  !!isoBrowse.gadget = !gadget
  !!isoBrowse.store  = true

  show !!isoBrowse

endmethod

-----------------------------------------------------------------------
--
-- Method:      .setModified(BOOLEAN)
--
-- Description: Set this form as modified or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Mark form modified status
  !this.modified = !modified

  -- Set form title and buttons
  if (!modified) then
    !this.formTitle    = !this.title & ' *'
    !this.close.tag    = 'Cancel'
    !this.save.active  = true
    !this.reset.active = true

  else
    !this.formTitle    = !this.title
    !this.close.tag    = 'Close'
    !this.save.active  = false
    !this.reset.active = false

  endif

endmethod
-- End of method .setModified(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .setPen(GADGET,GADGET)
--
-- Description:   Set the available styles to display the chosen thicknesses
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      GADGET      The gadget to be set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPen(!gadgetA is GADGET, !gadgetB is GADGET)

  -- Initialise variables
  !rtext[1]  = |Solid|
  !rtext[2]  = |Dashed|
  !rtext[3]  = |Dotted|
  !rtext[4]  = |Chained|
  !rtext[5]  = |Ldashed|
  !rtext[6]  = |Ddashed|
  !rtext[7]  = |Ddotted|
  !rtext[8]  = |Fdotted|
  !rtext[9]  = |Dchained|
  !rtext[10] = |Tchained|

  -- For thickness change the style values
  do !count from 1 to 10
    !iconFile = 'linestyle' & !gadgetA.selection().lowCase() & !count & '.png'
    !dtext[!count] = !!pml.getPathName(!iconFile)
  enddo

  !gadgetB.dtext = !dtext
  !gadgetB.rtext = !rtext

  -- Store change
  !this.store()

endmethod
-- End of method definition for .setPen(GADGET,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .store()
--
-- Description: Updates the form objects with the form values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .store()

  -- Initialise variables
  !gName = !this.type.selection() & 'PeneTag'

  -- Save settings to the object
  !this.$!gName$N.sTemplate   = !this.sTemplate.val.dbref()
  !this.$!gName$N.lTemplate   = !this.lTemplate.val.dbref()
  !this.$!gName$N.lOffset[1]  = !this.lXOff.val.convertUnits(!this.units)
  !this.$!gName$N.lOffset[2]  = !this.lYOff.val.convertUnits(!this.units)
  !this.$!gName$N.dOffset     = !this.doff.val.convertUnits(!this.units)
  !this.$!gName$N.sFColour    = !this.sFPen.val
  !this.$!gName$N.lTColour    = !this.lTPen.val
  !this.$!gName$N.lFColour    = !this.lFPen.val
  !this.$!gName$N.dTColour    = !this.dTPen.val
  !this.$!gName$N.dColour     = !this.dFPen.val
  !this.$!gName$N.sFStyle     = !this.sFStyle.selection('RTEXT')
  !this.$!gName$N.sFThickness = !this.sFThick.selection('RTEXT')
  !this.$!gName$N.lFStyle     = !this.lFStyle.selection('RTEXT')
  !this.$!gName$N.lFThickness = !this.lFThick.selection('RTEXT')
  !this.$!gName$N.dStyle      = !this.dFStyle.selection('RTEXT')
  !this.$!gName$N.dThickness  = !this.dFThick.selection('RTEXT')
  !this.$!gName$N.lChei       = !this.lChei.val
  !this.$!gName$N.dChei       = !this.dChei.val
  !this.$!gName$N.drawSymbol  = !this.symbol.val
  !this.$!gName$N.drawLabel   = !this.label.val
  !this.$!gName$N.drawDimn    = !this.dimension.val
  !this.$!gName$N.element     = !this.element.selection('RTEXT')
  !this.$!gName$N.lChei       = !this.lChei.val
  !this.$!gName$N.dChei       = !this.dChei.val
  !this.$!gName$N.rule        = !this.rule.val
  !this.$!gName$N.scale       = !this.scale.val
  !this.$!gName$N.term        = !this.term.selection('RTEXT')
  !this.$!gName$N.relBore     = !this.relBore.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store()

------------------------------------------------------------------------
--
-- Method:        .store(GADGET,STRING)
--
-- Description:   Store the chosen character height and XY offset
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget being actioned
--    2   R      STRING      The event type MODIFIED or SELECT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .store(!dummyObject is GADGET, !dummyAction is STRING)

  -- Initialise variables
  !gName = !this.type.selection() & 'PeneTag'

  -- Save settings to the object
  !this.$!gName$N.scale      = !this.scale.val
  !this.$!gName$N.lChei      = !this.lChei.val
  !this.$!gName$N.lOffset[1] = !this.lXOff.val
  !this.$!gName$N.lOffset[2] = !this.lYOff.val
  !this.$!gName$N.dChei      = !this.dChei.val
  !this.$!gName$N.dOffset    = !this.doff.val

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .store(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .upDown()
--
-- Description: Raise or Lower distance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .upDown(!increment is REAL, !direction is STRING, !gadget is GADGET)

  -- Initialise variables
  !gName = !this.type.selection() & 'PeneTag'

  -- Raise the value by the increment
  if (!direction.eq('UP')) then

    !nextValue = !gadget.val + !increment

  -- Reduce value by the increment
  else

    !nextValue = !gadget.val - !increment

  endif

  -- Test for zero or less
  if (!nextValue.leq(0)) then
   !nextValue = 0
  endif

  -- Set the gadget value
  !gadget.val = !nextValue

  -- Save settings to the object
  !this.$!gName$N.lChei      = !this.lChei.val.convertUnits(!this.units)
  !this.$!gName$N.lOffset[1] = !this.lXOff.val.convertUnits(!this.units)
  !this.$!gName$N.lOffset[2] = !this.lYOff.val.convertUnits(!this.units)
  !this.$!gName$N.dChei      = !this.dChei.val.convertUnits(!this.units)
  !this.$!gName$N.dOffset    = !this.doff.val.convertUnits(!this.units)

  -- Mark form as modified
  !this.setModified(true)

endmethod
-- End of method definition for .upDown()
