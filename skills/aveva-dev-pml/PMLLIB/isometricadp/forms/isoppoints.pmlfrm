--
-- File:            isoppoints.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Presents the user with all available connection points for the current label
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel this form
--  change()                         -                   Change the attached p-point number
--  getPoints()                      -                   Get the Ppoints and populate the gadgets
--  init()                           -                   Method to initialise the form
--  pick()                           -                   Pick a label for modification
--  reset()                          -                   Reset to the original connected p-point
--  useCe()                          -                   Use the current element for modification
--
------------------------------------------------------------------------
setup form !!isoPpoints

  !this.formTitle  = 'Connection Points'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  frame .frame

    para   .setT at x1   ymax+0.4 text |Change Ppoint| width 10
    option .set  at xmax ymin call |!this.change()| width 4

    button .pick at xmax+2 ymin+0.05 tooltip 'Pick New' pixmap width 16 height 16 call |!this.pick()|

  exit

  button .reset 'Reset'    at x0       ymax+0.4 call |!this.reset()|
  button .close 'Finished' at xmax+6.8 ymin     call |!this.cancel()|

  !this.pick.addPixmap(!!PML.getpathname('navigate16.png'))

  member .original is REAL
  member .elemRefe is DBREF

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Use the current element
  !this.useCe()

  -- Get the ppoints and populate the gadgets
  !this.getPoints()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Hide form
  hide !!isoPpoints

  -- Clear
  !!isoEdit.readout.val = '       '
  UNENHANCE ALL

endmethod
-- End of method definition for .cancel()

-----------------------------------------------------------------------
--
-- Method:      .change()
--
-- Description: Change the attached p-point number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .change()

  -- Initialise variables
  !atex   = !this.elemRefe.atex
  !pPoint = !this.set.selection('RTEXT')
  !currPp = !this.elemRefe.nppt

  -- Test for origin
  if (!currPp.eq(-1)) then
    !currPp = 0
  endif

  -- Set nppt
  !!ce = !this.elemRefe
  NPPT $!pPoint
    handle any
      return
    endhandle

  -- Check atex for ppoint hashcodes
  do !pP val !this.set.dtext

    if (!atex.match(!pP).neq(0)) then

      !hashCode = !atex.replace('#P' & !currPp, '#' & !this.set.selection('DTEXT'))

      ATEX |$!hashCode|

      break

    endif

  enddo

  -- Refresh the view
  REFRESH !!isoEdit.feedback

endmethod
-- End of method definition for .change()

-----------------------------------------------------------------------
--
-- Method:      .getPoints()
--
-- Description: Get the Ppoints and populate the gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPoints()

  -- Initialise variables
  !dtext[1] = 'P0'
  !rtext[1] = '0'

  -- Get the current set ppoint
  !currPpoint = !this.elemRefe.nppt

  -- Get the current element point set
  !ptre = !this.elemRefe.ddnm.ptre

  -- Get all ppoints for the found point set
  VAR !allPoints EVAL NUMB FOR ALL (PTAX PTCA PTMI) FOR $!ptre

  -- Sort the ppoints into order
  !allPoints.sort()

  -- Build the gadget dtext and rtext strings
  do !point val !allPoints
    !dtext.append('P' & !point)
    !rtext.append(!point.string())
  enddo

  -- Set ppoint gadget
  !this.set.dtext = !dtext
  !this.set.rtext = !rtext

  -- Select the gadget value for the current setting
  if (!currPpoint.eq(-1)) then
    !this.set.select('RTEXT','0')

  else
    !this.set.select('RTEXT',!currPpoint.string())

  endif

endmethod
-- End of method definition for .getPoints()

-----------------------------------------------------------------------
--
-- Method:      .pick()
--
-- Description: Pick a label for modification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pick()

  -- Make prompt
  !!isoEdit.readout.val = 'Pick a label, or ESC to exit'

  -- Identify a suitable element
  ID SLAB GLAB @
    handle (61,528)
      !this.readout.val = '              '
      return
    endhandle

  -- Enhance
  UNENHANCE ALL
  ENHANCE CE

  -- Refresh the edit form canvas
  REFRESH !!isoEdit.feedback

  -- Clear the edit form display text
  !!isoEdit.readout.val = '           '

  -- Hide and show this form to force it to the front
  !this.hide()
  !this.show()

endmethod
-- End of method definition for .pick()

-----------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Reset to the original connected p-point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reset()

  -- Set to value on form call
  !!ce = !this.elemRefe
  NPPT $!<this.original>

  -- Reselect in option list
  if (!this.original.eq(-1)) then
    !this.set.select('RTEXT','0')
  else
    !this.set.select('RTEXT',!this.original.string())
  endif

  -- Refresh
  REFRESH !!isoEdit.feedback

endmethod
-- End of method definition for .reset()

-----------------------------------------------------------------------
--
-- Method:      .useCe()
--
-- Description: Use the current element for modification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .useCe()

  -- Initialise variables
  !this.elemRefe = !!ce

  -- Store original setting
  !this.original = !this.elemRefe.nppt

endmethod
-- End of method definition for .useCe()
