--
-- File:            isopreview.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Displays drawings before printing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel this form
--  cycle(STRING)                    -                   Cycle through the sheets for display
--  init()                           -                   Method to initialise the form
--
------------------------------------------------------------------------
setup form !!isoPreview resize

  !this.formTitle  = 'Print Preview'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  -- Cycle through list
  button .prev at xmin y0.1 pixmap height 9 width 12 call |!this.cycle('PREV')|
  button .next at xmax ymin pixmap height 9 width 12 call |!this.cycle('NEXT')|
  para .name at xmax ymin-0.15 width 60 lines 1

  -- View
  view .view at x0 ymax area
    width 80 aspect 1.414
    setcolour 15
    borders off
    cursor nocursor
  exit

  -- Counter
  para .counter at xmax form-size ymin.name width 7 lines 1

  -- Pixmaps
  !this.prev.addPixmap(!!PML.getPathName('leftarrow9x12.png'))
  !this.next.addPixmap(!!PML.getPathName('rightarrow9x12.png'))

  -- Members
  member .list    is ARRAY
  member .number  is REAL
  member .origCol is REAL

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Display first sheet
  !this.number = 0
  !this.cycle('NEXT')

  -- Check that the colour palette is available
  if (undefined(!!colourSelect)) then
  	pml load form !!colourSelect
  endif

  -- Set the pens for the white canvas background after storing the current colour
  !this.origCol = !!colourSelectGet()
  !!colourSelect(306)
  !!appDraSetBackground(!!isoPreview.view, false)

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .cycle(STRING)
--
-- Description: Cycle through the sheets for display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRINg      PREVious or NEXT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cycle(!argument is STRING)

  -- Test for only a single sheet
  if (!this.list.size().eq(1)) then
    !this.prev.active = false
    !this.next.active = false
  endif

  -- Test for argument
  if (!argument.eq('NEXT')) then
    if (!this.number.eq(!this.list.size())) then
      !this.number = 1
    else
      !this.number = !this.number + 1
    endif
  else
    if (!this.number.eq(1)) then
      !this.number = !this.list.size()
    else
      !this.number = !this.number - 1
    endif
  endif

  -- Put sheet into the view gadget
  !sheet = !this.list[!this.number]
  edit view !!isoPreview.view AREA put $!sheet

  -- Display sheet name
  !this.name.val = !sheet.dbref().flnn

  -- Set counter
  !this.counter.val = !this.number & '/' & !this.list.size()

endmethod
-- End of method definition for .cycle(STRING)

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Reset the background colour to the original setting
  !!colourSelect(!this.origCol)

  !!appDraSetBackground(!!isoPreview.view, false)

  -- Hide this form
  !this.hide()

endmethod
-- End of method definition for .cancel()
