--
-- File:            isoprint.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
-- Description:
-- Spools selected drawings to the print queue
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browse(GADGET)                   -                   Show standard browser
--  cancel()                         -                   Cancel this form
--  ce()                             -                   Set form to report on the current element
--  ce(DBREF)                        -                   Set form to report on the current element
--  checkName()                      -                   Check the entered name
--  continue(ARRAY)                  -                   Continue with the printing after listing prints already made
--  copies(STRING)                   -                   Method to initialise the form
--  deselect()                       -                   Deselect current selections
--  init()                           -                   Method to initialise the form
--  isoPrint()                       -                   Constructor method
--  pdf()                            -                   Create pdf output files for the selected sheets
--  preview()                        -                   Display the preview form
--  search()                         -                   Search for drawings
--  select(GADGET,STRING)            -
--  select(STRING)                   -                   Pop-up callback
--  submitPrint()                    -                   Send the selected sheets to the common printer engine
--
------------------------------------------------------------------------
setup form !!isoPrint dialog dock size 46 26.6

  !this.formTitle  = 'Print'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  -- Search
  frame .searchFrame | Search | at x0

    -- Drafting element below which to search
    para   .eTitle  anchor left + top         at x0.5     ymin+0.7 text 'Drafting element to search under:'
    text   .ceName  anchor left + right + top at xmin     ymax-0.1 width 39 scroll 90 STRING
    button .ce 'CE' anchor right + top        at xmax+1.1 ymin-0.05 tooltip 'Current Element '

    -- Search Filter
    para   .sTitle        at x0.5 ymax+0.1 text 'Filter results using:'
    text   .searchString  at x0.5 ymax-0.1 tooltip 'Search String' width 22 STRING
    option .searchOptions at xmax+0.5 width 10
    button .go |Search|   at xmax+0.5 ymin tooltip 'Make search'

    list .list |Drawing List| at xmin.searchString ymax+0.1 multi width 43 length 20

  exit

  -- Output destination
  frame .dest | PDF | at x0 ymax

    para   .setPdf    at x0.5     ymax-0.2 text 'Create PDF files in this location:' width 20 lines 1
    button .saveToPdf at x1       ymax tooltip 'Save to PDF File ' pixmap width 16 height 16
    text   .directory at xmax+1   ymin tooltip 'In which Folder? ' width 37 scroll 90 STRING
    button .browse    at xmax+0.7 ymin tooltip 'Browse Folders '   pixmap width 16 height 16

  exit

  -- Print
  frame .copy | Print | at x0 ymax

    para   .cTitle at x1 ymax text |Number of copies:| width 13 lines 1
    numeric .copies at xmax ymin range 1 999 step 1 ndp 0 width 3

    para   .coll at xmin.cTitle ymax.cTitle pixmap width 35 height 35
    toggle .collate |Collate| at xmax.coll+6 ymax.copies+0.5

    toggle .fit 'Fit' anchor right + top at xmax+2 ymin-0.3
    toggle .bw  'B/W' anchor right + top at xmin   ymax-0.2

    -- Preview
    button .preview |Preview...| at xmax.copy+3.3 ymin.copy+1

    -- Action
    button .ok |Print| at xmin.preview+5 ymax.preview+0.5

  exit

  -- Popup menus
  menu .barPopup
    add |Select|   menu .selOptions
    add |Deselect| menu .desOptions
  exit

  menu .selOptions
    add |All Shts for ce| |!this.select('CE')|
    add |All Shts|        |!this.select('ALL')|
  exit

  menu .desOptions
    add |All Shts|        |!this.deselect()|
  exit

  -- Members
  member .ceRefe     is DBREF
  member .allDrwgs   is ARRAY
  member .lastSel    is STRING
  member .allOptions is ARRAY
  member .printed    is ARRAY
  member .pdfFolder  is FILE
  member .module     is ISOMODULE

exit

------------------------------------------------------------------------
--
-- Method:      .isoPrint()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoPrint()

  -- Pixmaps
  !this.saveToPdf.addPixmap(!!pml.getPathName('pdf.png'))
  !this.browse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.coll.addPixmap(!!pml.getPathName('collate.png'))

  -- Form callbacks
  !this.ce.callback        = '!this.ce()'
  !this.ceName.callback    = '!this.checkName()'
  !this.go.callback        = '!this.search()'
  !this.list.callback      = '!this.select('
  !this.browse.callback    = '!this.browse(!this.directory)'

  !this.preview.callback   = '!this.preview()'
  !this.ok.callback        = '!this.submitPrint()'
  !this.saveToPdf.callback = '!this.pdf()'

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Select All Sheets for CE', |!this.select('CE')|)
    !menu.add('callback', 'Select All Sheets', |!this.select('ALL')|)
    !menu.add('separator')
    !menu.add('callback', 'Deselect All Sheets', '!this.deselect()')

  -- Default popup menu for list gadget
  !this.list.setPopUp(!this.defPopup)

endmethod
-- End of method definition for .isoPrint()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Force into draft
  CONTEXT DRAWING

  -- Initialise variables
  !worldRefe  = /*

  -- Set defaults search point as the world
  !this.ce(!worldRefe)

  -- Read search options file
  !file     = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-SEARCH')
  !contents = !file.readfile()
    handle (160,9)
      !!alert.error('Loading error! The defaults file DRA-ISO-SEARCH does not exist. Please contact your System Administrator')
      !this.loaded = false
      return
    endhandle

  -- Get defaults
  !data = !contents.from(!contents.findFirst('-- Display text; Element Type; Element Attribute'))

  -- Split found data and build the objects to hold that data
  do !count from 2 to !data.size()
    !this.allOptions[!count] = object ISOSEARCH(!data[!count])
    !dtext[!count] = !this.allOptions[!count].desc
    !rtext[!count] = !count.string()
  enddo

  -- Set first option for ALL drawings
  !firstOption        = 'All Drwgs;DRWG;REFE'
  !this.allOptions[1] = object ISOSEARCH(!firstOption)

  -- Set last option for Status
  !lastOption                  = 'Status;SHEE;:IdpIsoStatus'
  !this.allOptions[!count + 1] = object ISOSEARCH(!lastOption)

  !dtext[1]                    = 'All Drwgs'
  !rtext[1]                    = '1'
  !dtext[!count + 1]           = 'Status'
  !rtext[!count + 1]           = string(!count + 1)
  !this.searchOptions.dtext    = !dtext
  !this.searchOptions.rtext    = !rtext

  -- File
  !this.pdfFolder     = object FILE('%PDMSUSER%')
  !this.directory.val = !this.pdfFolder.fullName()

  -- Number of copies
--  !this.copies.val  = 1
  !this.collate.val = false

  -- Clear any previous selections
  !this.list.clear()
  !this.searchString.clear()
  !this.searchOptions.val = 1
  !this.lastSel           = STRING()
  !this.printed.clear()

  -- Set default output as black & white and scale to fit
  !this.bw.val  = true
  !this.fit.val = true

endmethod
-----------------------------------------------------------------------
--
-- Method:      .browse(GADGET)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browse(!gadget is GADGET)

  -- Load the .net file browser
  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !folderBrowser = object PMLFOLDERBROWSER()

  !folderBrowser.selectedPath(!this.pdfFolder.fullName())

  !folderBrowser.show('Select Output Folder',true)

  -- Set the gadget
  if (!folderBrowser.selectedPath().neq('')) then
    !gadget.val = !folderBrowser.selectedPath()
  else
    !gadget.val = !this.pdfFolder.fullName()
  endif

  !gadget.refresh()

  -- Save the setting
  !this.pdfFolder = object FILE(!gadget.val)

endmethod
-- End of method .browse(GADGET)

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce()

  -- Initialise variables
  !type = !!ce.hardType.upcase()

  -- Check current element is world, dept, regi or drwg
  if (!type.neq('WORL') and !type.neq('DEPT') and !type.neq('REGI') and !type.neq('DRWG')) then

    -- User warning
    !!alert.warning('Cannot report drawings from this position in the hierarchy')

    -- Give a list of things they can report from?

  endif

  -- Add ce
  !this.ceRefe     = !!ce
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .ce(DBREF)
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce(!element is DBREF)

  -- Add ce
  !this.ceRefe     = !element
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      .checkName()
--
-- Description: Check the entered name
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()

  -- Initialise variables
  !entered  = !this.ceName.val

  -- Trim any leading or trailing blanks
  !entered = !entered.trim('LR')

  -- Check for empty string
  if (!entered.eq('')) then

  	-- Set to the world
    CONTEXT DRAWING
    !worldRefe  = /*
    !this.ce(!worldRefe)

    return

  endif

  -- Get leading character
  !leadChar = !entered.substring(1,1)

  -- Check for leading slash
  if (!leadChar.neq('=') and !leadChar.neq('/')) then
    !fullName    = '/' & !entered
    !noSlashName = !entered
  else
    !fullName    = !entered
    !noSlashName = !entered.substring(2)
  endif

  -- Check name exists
  VAR !exists EXIST $!fullName
  if (!exists.eq('FALSEA')) then
    !!alert.error('The name you have entered is not valid. Please check and try again.')
    return
  endif

  -- Add ce
  !this.ceRefe = !fullName.dbref()

  -- Check for leading equals
  if (!leadChar.eq('=')) then
    !noSlashName = !this.ceRefe.flnn
  endif

  -- Display name
  !this.ceName.val = !noSlashName

endmethod
-- End of method definition for .checkName()

-----------------------------------------------------------------------
--
-- Method:      .search()
--
-- Description: Search for drawings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .search()

  -- Initialise variables
  !index = !this.searchOptions.selection().real()
  !drwgs = ARRAY()
  !refes = ARRAY()
  !this.allDrwgs.clear()

  -- Get all drawings
  if (!this.ceRefe.type.upcase().eq('WORL')) then
    VAR !allDrawings COLL ALL DRWG WI SPPURP EQ 'ISOADP'
  else
    VAR !allDrawings COLL ALL DRWG WI SPPURP EQ 'ISOADP' FOR $!<this.ceRefe>
  endif

  -- Reduce list by options
  if (!index.neq(1)) then

    !this.allOptions[!index].rule = !this.searchString.val
    !allDrwgs = !!isoSearch(!allDrawings, !this.allOptions[!index])

  else

    !this.searchString.clear()
    !allDrwgs = ARRAY()

    do !drwg val !allDrawings
      !allDrwgs.append(object ISODISPLAYDRWG(!drwg.dbref()))
    enddo

  endif

  -- Test for none found
  if (not defined(!allDrawings)) then

    !dtext[1] = '- None Found -'
    !rtext[1] = 'NONE'
    !this.list.dtext = !dtext
    !this.list.rtext = !rtext

    return

  endif

  -- Get drawing data
  do !value val !allDrwgs

    -- Build drawing object array
    !drwgObj           = object ISODRWG()
    !drwgObj.reference = !value.drwgRefe
    !drwgObj.visible   = false

    -- Get all relevant owned sheets
    if (!this.allOptions[!index].type.eq('SHEE')) then

      !attr = !this.allOptions[!index].attr
      !rule = !this.allOptions[!index].rule
      VAR !allShee COLL ALL SHEE WITH (MATCH($!attr,'$!rule') NEQ 0) FOR $!<value.drwgRefe>

    else
      VAR !allShee COLL ALL SHEE FOR $!<value.drwgRefe>

    endif

    !drwgObj.sheetRefes = !allShee
    !this.allDrwgs.append(!drwgObj)

    -- Set arrays for list gadget
    !drwgs.append('Drwg ' & !value.drwgName)
    !refes.append(!drwgObj.reference.string())

  enddo

  -- Test for none
  if (!drwgs.empty()) then

    !drwgs.append('- None Found -')
    !refes.append('EMPTY')
    !this.list.active = false

  else
    !this.list.active = true
  endif

  -- Populate list gadget
  !this.list.dtext = !drwgs
  !this.list.rtext = !refes

endmethod
-- End of method definition for .search()

-----------------------------------------------------------------------
--
-- Method:      .select(GADGET,STRING
--
-- Description: List gadget open callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget making the call
--    2   R      STRING      The action from the call
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select(!gadget is GADGET, !action is STRING)

  if (!action.neq('STOP')) then
    return
  endif

  -- Initialise variables
  !selection = !this.list.selection()
  !allNames = ARRAY()
  !allRefes = ARRAY()
  !selected = ARRAY()

  -- Test for no selection
  if (!selection.empty()) then
    !current = !this.lastSel

  else

    if (!selection[!selection.size()].dbref().type.upcase().eq('DRWG')) then
      !current = !selection[!selection.size()]
      !this.lastSel = !current
    else

      -- Clear any drawings from the selected list
      do !select val !selection
        skip if (!select.dbref().type.upcase().eq('DRWG'))
        !selected.append(!this.list.rtext.findFirst(!select))
      enddo
      !this.list.val = !selected

      return

    endif

  endif

  -- Clear any drawings from the selected list
  do !select val !selection
    if (!select.dbref().type.upcase().eq('DRWG')) then
      !selection.remove(!selection.findFirst(!select))
    endif
  enddo

  -- Cycle through the drawings
  do !index ind !this.allDrwgs

    -- Initialise variables
    !drwgObj = !this.allDrwgs[!index]

    -- Test for selected drwg
    if (!current.eq(!drwgObj.reference.string())) then

      -- Selected is a drwg so test if sheet list is visible
      if (!drwgObj.visible) then
        !this.allDrwgs[!index].visible = false
        !drwgObj.visible = false
        !visible = false
      else
        !this.allDrwgs[!index].visible = true
        !drwgObj.visible = true
        !visible = true
      endif

    endif

    -- Rebuild display list
    !allNames.append('Drwg ' & !drwgObj.reference.flnn)
    !allRefes.append(!drwgObj.reference.string())

    -- Add sheets if required
    if (!drwgObj.visible) then

      -- Build display string
      VAR !allShee COLL ALL SHEE FOR $!<drwgObj.reference>
      VAR !allSheeNames EVAL FLNN FOR ALL SHEE FROM !allShee
      do !name val !allSheeNames
        !allNames.append('   |- Sht ' & !name)
      enddo

      -- Add references
      !allRefes.appendArray(!allShee)

    endif

  enddo

  -- Find location of originally selected sheets for reselection
  do !select val !selection
    skip if (!select.dbref().type.upcase().eq('DRWG'))
    !selected.append(!allRefes.findFirst(!select))
  enddo

  -- Select drawing when sheets are displayed
  if (!visible) then
    !selected.append(!allRefes.findFirst(!current))
  endif

  -- Re-populate the list gadget
  !this.list.clear()
  !this.list.dtext = !allNames
  !this.list.rtext = !allRefes

  if !selected.unset().not() then
    !this.list.val = !selected
  endif

endmethod
-- End of method definition for .select(GADGET,STRING)

-----------------------------------------------------------------------
--
-- Method:      .select(STRING)
--
-- Description: Pop-up callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select(!option is STRING)

  -- Initialise variables
  !selection = !this.list.selection()
  !selected = ARRAY()
  !allNames = ARRAY()
  !allRefes = ARRAY()

  -- Show and/or select sheets depending on option
  -- All available sheets
  if (!option.eq('ALL')) then

    -- Cycle through the drawings
    do !index ind !this.allDrwgs

      -- Initialise variables
      !drwgObj = !this.allDrwgs[!index]
      !allNames.append('Drwg ' & !drwgObj.reference.flnn)
      !allRefes.append(!drwgObj.reference.string())

      -- Build sheet display string
      !allShee = !drwgObj.sheetRefes
      VAR !allSheeNames EVAL FLNN FOR ALL FROM !allShee
      do !name val !allSheeNames
        !allNames.append('   |- ' & !name)
      enddo

      -- Add references
      !allRefes.appendArray(!allShee)

    enddo

    -- Determine sheet selection list
    do !refe val !allRefes
      skip if (!refe.dbref().type.upcase().eq('DRWG'))
      !selected.append(!allRefes.findFirst(!refe))
    enddo

    -- Re-populate the list gadget
    !this.list.dtext = !allNames
    !this.list.rtext = !allRefes

  -- For the current drawing
  else

    -- Cycle through the drawings
    do !index ind !this.allDrwgs

      -- Initialise variables
      !drwgObj = !this.allDrwgs[!index]

      -- Test for selected drwg
      if (!this.lastSel.eq(!drwgObj.reference.string())) then

        -- Find position of all owned sheets
        do !sheet val !drwgObj.sheetRefes
          !selected.append(!this.list.rtext.findFirst(!sheet))
        enddo

        skip

      endif

    enddo

  endif

  -- Make selection
  if !selected.unset().not() then
    !this.list.val = !selected
  endif

endmethod
-- End of method definition for .select(STRING)

-----------------------------------------------------------------------
--
-- Method:      .deselect()
--
-- Description: Deselect current selections
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deselect()

  -- Initialise variables
  !selection = !this.list.selection()
  !selected = ARRAY()
  !allNames = ARRAY()
  !allRefes = ARRAY()
  !selected = ARRAY()

  -- Cycle through the drawings
  do !index ind !this.allDrwgs

    -- Initialise variables
    !drwgObj = !this.allDrwgs[!index]
    !allNames.append('Drwg ' & !drwgObj.reference.flnn)
    !allRefes.append(!drwgObj.reference.string())

  enddo

  -- Re-populate the list gadget
  !this.list.clear()
  !this.list.dtext = !allNames
  !this.list.rtext = !allRefes

  -- Make selection
  if !selected.unset().not() then
    !this.list.val = !selected
  endif
endmethod
-- End of method definition for .deselect()

-----------------------------------------------------------------------
--
-- Method:      .copies(STRING)
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Count up or down
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copies(!direction is STRING)

  -- Change number of copies
  if (!direction.eq('UP')) then
    if (!this.copies.val.eq(999)) then
      !this.copies.val = 1
    else
      !this.copies.val = !this.copies.val + 1
    endif
  else
    if (!this.copies.val.eq(1)) then
      return
    else
      !this.copies.val = !this.copies.val - 1
    endif
  endif

endmethod
-- End of method definition for .copies(STRING)

------------------------------------------------------------------------
--
-- Method:        .pdf(DBREF)
--
-- Description:   Create pdf output files for the selected sheets
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pdf()

  -- Set colour output
  if (!this.bw.val) then
    !colourOption = 'COL BW'
  else
    !colourOption = 'COL COLOURPLUS'
  endif

  -- Set no dialog
  !dialogOption = ', NODIALOG'

  -- Set no view
  !viewOption = ', NOVIEW'

  -- Build options string
  !options = !colourOption & !dialogOption & !viewOption

  -- Ensure that the destination folder exists
  if (!this.pdfFolder.exists().not()) then

    -- Create the folder
    !folderPath = !this.pdfFolder.directory().fullName() & '\' & !this.pdfFolder.entry()
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- For each selected sheet
  do !count from 1 to !this.list.selection().size()

    -- Initialise variables
    !sheetRefe = !this.list.selection()[!count].dbref()

    -- Build plotfile path name
    !sheetName     = !sheetRefe.flnn.replace('\','_').replace('/','_').replace('.','_')
    !pdfPathName   = !this.pdfFolder.fullName() & '\' & !sheetName & '_' & !!isoDateStamp() & '.pdf'

    -- Pass the print options to the PDF engine
    !this.module.submitToPdf(!sheetRefe, !pdfPathName, !options, 'OVERWRITE')

    -- Set progress bar
    !!fmsys.setProgress(!count / !this.list.selection().size() * 100)

  enddo

  -- Reset progress bar
  !!fmsys.setProgress(0)

endmethod
-- End of object definition for .pdf(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .preview()
--
-- Description: Display the preview form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .preview()

  -- Test for nothing selected
  if (!this.list.selection().empty()) then
    !!alert.error('Please select a drawing')
    return
  endif

  -- Only able to preview sheets if any drawings are selected then issue error message
  do !testForDrwg values !this.list.selection()
    if !testForDrwg.dbref().type.eq('DRWG') then
      !!alert.error('Unable to preview DRWG elements, please select sheets before using preview')
      return
    endif
  enddo

  -- Load selected sheets into the preview form
  pml load form !!isoPreview
  !!isoPreview.list = !this.list.selection()
  !!isoPreview.show(|CEN|,0.5,0.5)

endmethod
-- End of object definition for .preview()

-----------------------------------------------------------------------
--
-- Method:      .submitPrint()
--
-- Description: Send the selected sheets to the common printer engine
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitPrint()

  -- Test for any selected sheets as having been printed already this session
  !common = !this.printed.intersect(!this.list.selection())
  if (!common.empty().not()) then

    -- Pass the repeats to the warning form
    !!isoPrinted.sheeList = !common
    show !!isoPrinted

  else

    !doNotPrint = ARRAY()
    !this.continue(!doNotPrint)

  endif

endmethod
-- End of object definition for .submitPrint()

-----------------------------------------------------------------------
--
-- Method:      .continue(ARRAY)
--
-- Description: Continue with the printing after listing prints already made
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .continue(!doNotPrint is ARRAY)

	-- Initialise variables
	!numberPrinted = 0

  -- Test for any sheets NOT to be printed
  if (!doNotPrint.empty().not()) then

    -- Remove those sheets from the print list
    !printSelection = !this.list.selection().difference(!doNotPrint)

     -- Test for nothing to print
    if (!printSelection.empty()) then
      !!alert.warning('There is nothing to print!')
      return
    endif

  else

  	-- Print all of those selected
    !printSelection = !this.list.selection()

  endif

  -- Make sure that selected items are sheets
  do !index ind !printSelection

    if (!printSelection[!index].dbref().type.eq('DRWG')) then
      !printSelection.deleteFrom(!index,1)
      return
    endif

  enddo

  -- Check again for nothing to print
  if (!printSelection.empty()) then
    !!alert.error('There is nothing to print')
    return
  endif

   -- Set colour output
  if (!this.bw.val) then
    !colourOption = 'COL BW'
  else
    !colourOption = 'COL COLOURPLUS'
  endif

  -- Set scale
  if (!this.fit.val) then
    !scaleOption = ', REDUCE'
  else
    !scaleOption = ''
  endif

  -- Calculate number of prints in total
  !totalPrints = !printSelection.size() * !this.copies.val

  -- Print the sheets
  if (!this.collate.val) then

    -- Print one copy of each sheet at a time
    -- For each copy
    do !count from 1 to !this.copies.val

      -- Submit the sheet for printing
      do !index index !printSelection

        -- Get sheet
        !sheet = !printSelection[!index]

        -- Set the option to display the printer dialog for first time only
        if (!count.eq(1) and !index.eq(1)) then
          !dialogOption = ''
        else
          !dialogOption = ', NODIALOG'
        endif

        -- Send to the printer
        !this.module.submitToPrinter(!sheet.dbref(), !colourOption, !dialogOption, !scaleOption)

        -- Set printed counter
        !numberPrinted = !numberPrinted + 1

        -- Set progress bar
        !!fmsys.setProgress((!numberPrinted / !totalPrints) * 100)

      enddo

    enddo

  else

    -- Print all copies of each sheet at the same time
    do !index ind !printSelection

      -- Submit the sheet for printing
      do !count from 1 to !this.copies.val

        -- Set the option to display the printer dialog for first time only
        if (!index.eq(1) and !count.eq(1)) then
          !dialogOption = ''
        else
          !dialogOption = ', NODIALOG'
        endif

        -- Send to the printer
        !this.module.submitToPrinter(!printSelection[!index].dbref(), !colourOption, !dialogOption, !scaleOption)

        -- Set printed counter
        !numberPrinted = !numberPrinted + 1

        -- Set progress bar
        !!fmsys.setProgress((!numberPrinted / !totalPrints) * 100)

      enddo

    enddo

  endif

  -- Store sheets as having been printed
  !this.printed.clear()
  !this.printed = !printSelection

  !!fmsys.setProgress(0)

endmethod

-- End of object definition for .continue(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Hide this form
  hide !!isoPrint

endmethod
-- End of object definition for .cancel()
