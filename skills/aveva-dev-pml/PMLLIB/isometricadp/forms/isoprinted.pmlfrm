--
-- File:            isoprinted.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Displays a list of drawings that have already been printed this session
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel this form
--  init()                           -                   Method to initialise the form
--  ok()                             -                   Continue with the print process
--
------------------------------------------------------------------------
setup form !!isoPrinted blocking

  -- Initialise Variables
  !this.formTitle  = 'Warning!'
  !this.cancelCall = '!this.cancel()'
  !this.initCall   = '!this.init()'

  -- Message
  frame .message ||

    para .icon at x1 ymax pixmap

    para .m1 at xmax+2 ymin     text     |The sheets listed below have already|    width 25 lines 1
    para .m2 at xmin   ymax-0.2 text     |been printed this session.|
    para .m3 at x1     ymax+0.3 text |Please select those you wish to reprint| width 25 lines 1

  exit

  -- Printed list
  list .list at xmin ymax+0.5 multi width 32 length 5

  -- Action
  button .ok     |Continue| at xmin           ymax+0.2 call |!this.ok()|
  button .cancel |Cancel|   at xmax form-size ymin     call |!this.cancel()|

  -- Pixmaps
  !this.icon.addPixmap(!!PML.getPathName('exclaim.png'))

  -- members
  member .sheeList is ARRAY
  member .cancelled is BOOLEAN

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !allShee        = !this.sheeList
  !this.cancelled = false

  -- Populate the list with the passed sheet names
  var !sheeNames eval flnn for all from !allShee
  !this.list.dtext = !sheeNames
  !this.list.rtext = !this.sheeList

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: Continue with the print process
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ok()

  !this.hide()

  -- Do not print those unselected
  !!isoPrint.continue(!this.sheeList.difference(!this.list.selection()))

endmethod
-- End of method definition for .ok()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Cancel the printing
  !this.cancelled = true

  !this.hide()

endmethod
-- End of method definition for .cancel()
