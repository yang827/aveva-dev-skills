--
-- File:            isoprocess.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Displays messages during an interactive process run
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Method to initialize the form
--  set(STRING,REAL)                 -                   Set the display text
--  setMeter(REAL)                   -                   Set the meter to the passed percentage
--  setPercent()                     -
--  setPercent(REAL)                 -                   Set the form to store a drawing percentage
--
------------------------------------------------------------------------
setup form !!isoProcess at xr0.4 yr0.5

  !this.formTitle = 'Processing....'
  !this.callback  = '!this.init()'

  para .line1 at x1 y0.1 width 40 lines 1
  para .line2 at xmin ymax width 40 lines 1

  -- Percentage complete
  member .percentage      is REAL
  member .percentComplete is REAL

exit

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise members
  !this.percentage      = 0
  !this.percentComplete = 0

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .set()
--
-- Description: Set the display text
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The percentage complete so far
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .set(!text is STRING, !number is REAL)

  -- Set relevant gadget
  !gadget = '!this.line' & !number
  $!<gadget>.val = !text

  -- Refresh all gadgets
  refresh !!isoProcess.line1
  refresh !!isoProcess.line2

endmethod
-- End of method definition for .set()

------------------------------------------------------------------------
--
-- Method:      .setMeter()
--
-- Description: Set the meter to the passed percentage
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The percentage complete so far
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeter(!percent is REAL)

  -- Store percentage
  !this.percentComplete = !percent

endmethod
-- End of method definition for .setMeter()

------------------------------------------------------------------------
--
-- Method:      .setPercent()
--
-- Description: Set the form to store a drawing percentage
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The percentage of the job to create 50% of one drawing
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPercent(!percent is REAL)

  -- Store percentage
  !this.percentage = !percent

endmethod
-- End of method definition for .setPercent()

------------------------------------------------------------------------
--
-- Method:      .setProgress()
--
-- Description: Set the progress percentage
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPercent()

  -- Calculate the current percentage
  !percentComplete = !this.percentComplete + !this.percentage

  -- Store the current percentage
  !this.setMeter(!percentComplete)

  -- Set the progress bar
  !!fmsys.setProgress(!percentComplete)

endmethod
-- End of method definition for .setPercent()
