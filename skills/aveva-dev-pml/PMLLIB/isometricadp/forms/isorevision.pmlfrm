-- File:            isorevision.pmlfrm
--   Type:          Form Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        DRAFT
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 March 2001
--
--
-- Description:
-- Sets the field data for the revision block on the drawing
-- The gadgets represent the symbolic templates held in the library
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply this form
--  close()                          -                   Close this form
--  init()                           -                   Method to initialise the form
--
------------------------------------------------------------------------
setup form !!isoRevision

  -- Initialise variables
  !sheeRefe = !!isoEdit.currShee
  !rvsnType = 'EXT'
  !values   = ARRAY()
  !widths   = ARRAY()
  !descrs   = ARRAY()
  !codes    = ARRAY()
  !gadgets  = ARRAY()

  -- Get the latest revision for this sheet, starting with external
  VAR !allRevi COLL ALL REVI WI :IdpInText EQ 'EXT' FOR $!sheeRefe

  if (!allRevi.empty()) then
    VAR !allRevi COLL ALL REVI WI :IdpInText EQ 'INT' FOR $!sheeRefe
    !rvsnType = 'INT'

  endif

  -- Get all revisions and sort them
  VAR !allRvsn EVAL RVSN FOR ALL FROM !allRevi
  !sorted = !allRvsn.sortedIndices()

  -- Reindex the found revision elements to match
  !allRevi.reIndex(!sorted)

  -- The latest revision is now the last in the array
  !reviRefe = !allRevi[!allRevi.size()].dbref()

  -- Get the revision table entry template
  if (!sheeRefe.func.eq('HVAC')) then

    -- Get table template libraries
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Hvac Revision Table Display' FOR $!!isoMain.isoAdpApp.data.stdLibrary

  else
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Electrical Revision Table Display' FOR $!!isoMain.isoAdpApp.data.stdLibrary

  endif

  -- Read cells for text data
  VAR !allSytm COLL ALL SYTM WI :IdpPurp EQ 'Entry Display' FOR $!entryLib[1]
  VAR !allColumn EVAL :IdpColumn FOR ALL FROM !allSytm

  -- Sort the data by column number
  !sorted = !allColumn.sortedIndices()
  !allSytm.reIndex(!sorted)

  -- Get cell data
  do !index ind !allSytm

    -- Initialise variables
    !sytmRefe = !allSytm[!index].dbref()

    -- Get cell widths
    if (!index.eq(1)) then

      if (!sytmRefe.:IdpDesc.upCase().match('DESC').neq(0)) then
        !number = !sytmRefe.:IdpEnd

      else
        !number = !sytmRefe.:IdpEnd / 2

      endif

      !widths.append(!number.value().int())

    else

      !prevRefe = !allSytm[!index - 1].dbref()

      if (!sytmRefe.:IdpDesc.match('Description').neq(0)) then
        !number = !sytmRefe.:IdpEnd - !prevRefe.:IdpEnd

      else
        !number = (!sytmRefe.:IdpEnd - !prevRefe.:IdpEnd) / 2

      endif

      !widths.append(!number.value().int())

    endif

    -- Get cell descriptions
    !descrs.append(!sytmRefe.:IdpDesc)

    -- Get current values of latest revision
    !attrib = !sytmRefe.:IdpFunc.after('#')
    !values.append(!reviRefe.$!attrib)
    !codes.append(!attrib)

  enddo

  -- Form stuff
  !this.formTitle  = 'Issue Drawing'
  !this.cancelCall = '!this.close()'
  !this.initCall   = '!this.init()'

  frame .revEntry ' Revision Entry '

    path right

    -- Build cells
    do !index ind !values

      -- Test for rvsn
      if (!codes[!index].upCase().eq('RVSN')) then

        if (!index.eq(1)) then
          option .$!codes[$!index] || at xmin+1 ymax+0.2 width $!widths[$!index]

        else
          option .$!codes[$!index] || width $!widths[$!index]

        endif

      else

        if (!index.eq(1)) then
          text .$!codes[$!index] || at xmin+1 ymax+0.2 width $!widths[$!index] STRING

        else
          text .$!codes[$!index] || width $!widths[$!index] STRING

        endif

      endif

      !gadgets.append(!codes[!index])

    enddo

    -- Descriptions
    do !index ind !values

      -- test for udas
      if (!codes[!index].match(':').neq(0)) then
        !gName = !codes[!index].after(':')

      else
        !gName = !codes[!index]

      endif

      -- Test for >1 lines
      !split = !descrs[!index].split()
      !lines = !split.size()
      !width = 0

      do !bit val !split

        !wide = !bit.length()

        if (!wide.gt(!width)) then
          !width = !wide

        endif

      enddo

      para .p$!gName at xmin.$!codes[$!index] ymax.$!codes[$!index] text |$!descrs[$!index]| width $!width lines $!lines

    enddo

  exit

  button .apply 'Apply' at xmin ymax+0.2 call |!this.apply()|
  button .close 'Cancel' at xmax form-size ymin_apply call |!this.close()|

  member .reviRefe  is DBREF
  member .existRvsn is BOOLEAN
  member .rvsnType  is STRING
  member .gadgets   is ARRAY
  member .values    is ARRAY
  member .codes     is ARRAY

  !this.reviRefe = !reviRefe
  !this.rvsnType = !rvsnType
  !this.gadgets  = !gadgets
  !this.values   = !values
  !this.codes    = !codes

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set the gadget values
  do !index ind !this.gadgets

    -- Initialise variables
    !gadget = !this.$!this.gadgets[$!index]

    -- Test for rvsn
    if (!this.codes[!index].upCase().eq('RVSN')) then

      -- Get the revision character
      !rvsnChar = !this.values[!index]

      -- Set list
      if (!this.rvsnType.eq('INT')) then

      	-- Get all available revisions
      	!availableRevs = !!isoMain.isoAdpApp.data.internalRev

      	-- Remove all revisions earlier than the current one, to prevent selection
      	!location = !availableRevs.findFirst(!rvsnChar)

      	if (!location.gt(1)) then
      	  !availableRevs.deleteTo(!availableRevs.findFirst(!rvsnChar) - 1)

        endif

      	-- Set the gadget values
        !gadget.dtext = !availableRevs

      else
        !gadget.dtext = !!isoMain.isoAdpApp.data.externalRev

      endif

      -- Make selection
      !gadget.select('DTEXT',!rvsnChar)

    else

      -- Set value
      if (!this.values[!index].neq(' ')) then
        !gadget.val = !this.values[!index]

      endif

    endif

  enddo

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !ce = !!ce

  -- Access the REVI element
  !!ce      = !this.reviRefe
  !reviName = !!ce.flnm
  !type     = !!ce.owne.func
  !sheeRefe = !!ce.owne
  !reviType = !this.rvsnType

  -- Read the gadget values and set the attributes
  do !index ind !this.gadgets

    -- Initialise variables
    !gadget = !this.$!this.gadgets[$!index]

    -- Test for rvsn
    if (!this.codes[!index].upCase().eq('RVSN')) then

      !value   = !gadget.selection('DTEXT')
      !newName = !!ce.flnm.replace(!!ce.rvsn,!value)

      -- Build the new revision
      if (!newName.neq(!reviName)) then

        -- Check whether the sheet has already been released at this revision
        VAR !exists EXISTS $!newName

        if (!exists.eq('TRUEA')) then
        	!!alert.warning('The drawing has already been released previously with this revision!')
        	return
        endif

      	-- Create a new revision
        NEW REVI $!newName
         RVSN '$!value'
         :IdpIntExt '$!reviType'

        -- Remember this as the current revision
        !this.reviRefe = !!ce

      endif

    else

      !attrib = !this.codes[!index]
      !value  = !gadget.val

      if (!value.eq('')) then
        !value = ' '
      endif

      $!attrib '$!value'

    endif

  enddo

  -- Delete old history
  VAR !allNote COLL ALL NOTE WI SPPURP EQ 'HISTRY' FOR OWNE OF CE

  !!ce = !allNote[1].dbref()

  DELETE NOTE

  -- Rebuild revision history
  !!isoRevision(!type, !!isoMain.isoAdpApp.data)

  -- Set the sheet to reference the new revision
  !!ce       = !sheeRefe
  !!ce.attribute(':IdpReviRef') = !this.reviRefe

  -- Update the backing sheet for any revision hashcodes
  !backRefe = !!ce.bsrf

  BSRF $!backRefe

  UPDATE ANNO

  -- Return to ce
  !!ce = !ce
    handle any
    endhandle

endmethod
-- End of method definition for .apply()

-----------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  hide !!isoRevision

endmethod
-- End of method definition for .close()
