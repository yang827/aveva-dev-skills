-- File:            isoanalysestif.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
-- Description:
-- Analyses the stiffeners and groups them with their owning STRT
-- Other stiffeners are ignored as they are too complicated to dimension and best handled manually
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The first component reference
--
-- Return:
--   [Data Type] [Description]
--    ARRAY      A two dimensional array, one for each STRT with its associated STIFs
--
-------------------------------------------------------------------------
define function !!isoAnalyseStif(!allComp is ARRAY) is ARRAY

  -- Initialise variables
  !strts = ARRAY()
  !stifs = ARRAY()

  -- For each STIF find the associated STRT
  do !index ind !allComp

    !compRefe = !allComp[!index]
  	!compType = !compRefe.type.upCase()

  	if (!compType.eq('STRT')) then

	    -- Look down the line for any neighbouring stifs
	    do !count from !index to !allComp.size()

	    	!nextRefe = !allComp[!count]
	    	!nextType = !nextRefe.type.upCase()

	    	-- Ignore the first element because it is this one
	    	skip if (!count.eq(!index))

	    	-- Test any stifs
	    	if (!nextType.eq('STIF')) then

	    		-- Test if the stif is within the ends of the current strt
	    		if (!!isoWithIn(!nextRefe,!compRefe)) then
	    		  !stifs.append(!nextRefe)

	    		endif

	    	-- Stop when anything other than a stif
	    	else
	    		break

	    	endif

	    enddo

	    -- Look up the line for any neighbouring stifs
	    do !count from !index to 1 by -1

	    	!prevRefe = !allComp[!count]
	    	!prevType = !prevRefe.type.upCase()

	    	-- Ignore the first element because it is this one
	    	skip if (!count.eq(!index))

	    	-- Test any stifs
	    	if (!prevType.eq('STIF')) then

	    		-- Test if the stif is within the ends of the current strt
	    		if (!!isoWithIn(!prevRefe,!compRefe)) then
	    		  !stifs.append(!prevRefe)

	    		endif

	    	-- Stop when anything other than a stif
	    	else
	    		break

	    	endif

	    enddo

	    -- Store the stiffeners associated with this strt
	    !strts[!index] = !stifs

	    -- Reset the stifs array for the next strt
	    !stifs.clear()

  	endif

  enddo

  return !strts

endfunction
