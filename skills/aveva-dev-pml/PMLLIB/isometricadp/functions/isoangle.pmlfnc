-- Created:         25 March 2001
--
--
-- Description:
-- Calculate the angle between a component and it's associated BRCO element
-----------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       First element reference
--    2    R     DBREF       Second element reference (BRCO)
--
-- Return:
--   [Data Type] [Description]
--    STRING      The angle
--
-----------------------------------------------------------------------------
define function !!isoAngle(!firstRefe is DBREF, !secondRefe is DBREF) is STRING

  -- Get first direction
  if (!firstRefe.type.upCase().eq('BRAN')) then
    !firstDir = !firstRefe.hDir
  else
    !firstDir =!firstRefe.aDir.opposite()
  endif

  -- Get second direction
  if (!secondRefe.type.upCase().eq('BRCO')) then

    -- Get direction from P6 to P3
    !secondDir = !secondRefe.pPos[6].direction(!secondRefe.pPos[3])
      handle (2,201)
        !secondDir = !secondRefe.pPos[99].direction(!secondRefe.pPos[3])
          handle (2,201)
            !secondDir = !secondRefe.pPos[65].direction(!secondRefe.pPos[3])
          endhandle
      endhandle

  endif

  -- Get the angle as a string
  !angle = !firstDir.angle(!secondDir).string('D2')

  -- Return the angle
  return !angle

endfunction
