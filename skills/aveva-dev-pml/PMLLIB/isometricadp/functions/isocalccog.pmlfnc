--
-- File:            isocalccog.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Calculate the centre of gravity for a VIEW drawlist
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ISOSPOOL    The spool
--    2    R     STRING      Type of drawing being processed (HVAC or CWAY)
--
-- Return:
--   [Data Type] [Description]
--    STRING      Centre of gravity
--
------------------------------------------------------------------------
define function !!isoCalcCoG(!spool is ISOSPOOL, !type is STRING) is STRING

  -- Initialise variables
  !totalEast   = 0
  !totalNorth  = 0
  !totalUp     = 0
  !totalWeight = 0
  !errors      = false

  -- Check for coordinate system
  if (defined(!!coords)) then

    -- XYZ
    if (!!coords.xyzFlag) then
      !eAxis  = 'X'
      !nAxis  = 'Y'
      !uAxis  = 'Z'
      !origin = object POSITION('X0 Y0 Z0')

    -- ENU
    else
      !eAxis  = 'E'
      !nAxis  = 'N'
      !uAxis  = 'U'
      !origin = object POSITION('E0 N0 U0')

    endif

  -- Default to ENU
  else
    !eAxis  = 'E'
    !nAxis  = 'N'
    !uAxis  = 'U'
    !origin = object POSITION('E0 N0 U0')

  endif

  -- For each component
  do !compRefe val !spool.getComponents()

    -- For HVAC
    if (!type.eq('HVAC')) then

      -- Get the weight
      !compWeight   = !compRefe.desp[87].value()

      -- Get the centre of gravity
      !compPosition = !compRefe.gCofG
        handle any

          -- Any error
          !!isoLog.add(|   WARNING: There was an error querying the C of G of component | & !compRefe.flnn)

          -- Return an error
          !errors = true
          skip

       endhandle

    -- CWAY
    else

      -- Ignore POINTR elements
      skip if (!compRefe.type.upcase().eq('POINTR'))

      !compWeight   = !compRefe.nwei
        handle (2,827)

          -- Item has geometric volume, but no weight can be determined.
          !!isoLog.add(|   WARNING: There was an error querying the weight of component | & !compRefe.flnn)

          -- Return an error
          !errors = true
          skip

        elsehandle none

          !compPosition = !compRefe.gCofG.wrt(world)
            handle (2,201) (2,779)

             !!isoLog.add(|   WARNING: There was an error querying the C of G of component | & !compRefe.flnn)

             !errors = true
             !compPosition =!origin

            endhandle

       endhandle

    endif

    -- Test for any zero weight, as we need to warn that the c of g is inaccurate
    if (!compWeight.eq(0)) then
      !!isoLog.add(|   WARNING: One or more components has zero weight. The C of G output may be inaccurate|)
      !errors = true
    endif

    -- Calculate & accumulate moments
    !totalEast   = !totalEast   + !compWeight * !compPosition.east
    !totalNorth  = !totalNorth  + !compWeight * !compPosition.north
    !totalUp     = !totalUp     + !compWeight * !compPosition.up

    !totalWeight = !totalWeight + !compWeight

  enddo

  -- Test for zero weight
  if (!totalWeight.gt(0)) then

    -- Calculate total C of G
    !cOfGEast  = !totalEast  / !totalWeight
    !cOfGNorth = !totalNorth / !totalWeight
    !cOfGUp    = !totalUp    / !totalWeight

    !cOfG = !eAxis & !cOfGEast.nint().value() & ' ' & !nAxis & !cOfGNorth.nint().value() & ' ' & !uAxis & !cOfGUp.nint().value()

    -- Add any warning
    if (!errors) then
      !cOfG = !cOfG & ' - WARNING'
    endif

  else
    !cOfG = 'WARNING - Zero Weight'

  endif

  -- Return value
  return !cOfG

endfunction
