-- File:            isocalctotalweight.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
-- Description:
-- Calculate the centre of gravity for a spool
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ISOSPOOL    The spool
--    2    R     BOOLEAN     Whether to include the weight dimension characters
--
-- Return:
--   [Data Type] [Description]
--    STRING      Total weight
--
------------------------------------------------------------------------
define function !!isoCalcTotalWeight(!spool is ISOSPOOL, !dimension is BOOLEAN) is STRING

  -- Initialise variables
  !totalWeight  = 0
  !errorText    = ''

  -- For each component
  do !compRefe val !spool.getComponents()

    -- Ignore POINTR elements
    skip if (!compRefe.type.upcase().eq('POINTR'))

    -- Get the component weight
    !compWeight = !compRefe.nwei
      handle any
        !!isoLog.messages.append(|   WARNING: There was an error querying the weight of component | & !compRefe.flnn)
        !errorText = ' - WARNING'
        !compWeight = 0
      endhandle

    -- Check for any zero weight, as we want to warn the user that the total weight is inaccurate
    if (!compWeight.eq(0)) then
      !!isoLog.add(|   WARNING: One or more components has zero weight. The total weight value may be inaccurate|)
      !errorText = ' - WARNING'
    endif

    -- Build the total weight
    !totalWeight = !totalWeight + !compWeight

  enddo

  -- Build return string
  -- With weight dimension
  if (!dimension) then
    !returnString = !totalWeight.string(!!massFmt) & !errorText

  -- Without weight dimension or warning
  else
    !returnString = !totalWeight.value().string(!!massFmt)

  endif

  return !returnString

endfunction
