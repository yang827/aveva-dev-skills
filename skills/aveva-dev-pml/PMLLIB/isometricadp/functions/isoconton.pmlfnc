--
-- File:            isoconton.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the data for the continuation labels
--
-- Assumptions:
-- The drawing name for comparison is extracted from the cway/hvac level
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The component looking for a continuation
--    2    R     STRING      The type of search. For HVAC either HREF, TREF or CREF
--                                               For CWAY either HCREF, TCREF
--    3    R     STRING      Drawing Name extraction rule
--    4    R     STRING      Line Number extraction rule
--
-- Return:
--   [Data Type] [Description]
--    STRING      Description of the continuation.
--                Possible returns are;
--                 <Unknown>          - the continuation cannot be determined
--                 <Line Number>      - the continuation line number when not to this drwg
--                 <THIS + Reference> - THIS to indicate that the continuation is on this drwg
--                                      and the reference number of the continuation component
-------------------------------------------------------------------------
define function !!isoContOn(!component is DBREF, !end is STRING, !drwgNameRule is STRING, !lineNumbRule is STRING) is STRING

  -- Extract drawing name
  VAR !allName EVAL $!drwgNameRule FOR OWNE OF OWNE OF $!component
  !drwgName = !allName[1]

  -- Test for continuation drawing
  if (!end.eq('HREF')) then

    -- Get drwg name of href
    if (!component.owne.href.unset()) then
      !continuedOn = 'Unset'

    elseif (!component.owne.href.badref()) then
      !continuedOn = 'Badref'

    else

      -- Extract the drawing name from the head reference
      !href = !component.owne.href
      if (!href.type.upCase().eq('BRAN')) then

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!href
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!href

      elseif (!href.type.upCase().eq('NOZZ')) then

        !extract[1] = ''
        !lineNumber[1] = !href.flnn

      else

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF OWNE OF $!href
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF OWNE OF $!href

      endif

      -- Test for on same drawing
      if (!extract[1].eq(!drwgName)) then

        -- Get connected component.
        -- This is so we can find out which drawlist it is in later to find the sheet number
        if (!href.type.upCase().eq('BRAN')) then

          -- Get the last member of the referenced bran
          !last = !href.mcount
          VAR !lastMem COLL MEM OF $!href WI ORDER EQ $!last
          if (!lastMem.empty()) then
            !continuedOn = !lineNumber[1]

          else
            !continuedOn = 'THIS ' & !lastMem[1]

          endif

        else
          !continuedOn = 'THIS ' & !href.string()

        endif

      else
        !continuedOn = !lineNumber[1]

      endif

    endif

  elseif (!end.eq('TREF')) then

    -- Get drwg name of tref
    if (!component.owne.tref.unset()) then
      !continuedOn = 'Unset'

    elseif (!component.owne.tref.badref()) then
      !continuedOn = 'Badref'

    else

      -- Extract the drawing name from the tail reference
      !tref = !component.owne.tref
      if (!tref.type.upCase().eq('BRAN')) then

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!tref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!tref

      elseif (!tref.type.upCase().eq('NOZZ')) then

        !extract[1] = ''
        !lineNumber[1] = !tref.flnn

      else

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF OWNE OF $!tref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF OWNE OF $!tref

      endif

      -- Test for on same drawing
      if (!extract[1].eq(!drwgName)) then

        -- Get connected component.
        -- This is so we can find out which drawlist it is in later to find the sheet number
        if (!tref.type.upCase().eq('BRAN')) then

          -- Get the first member of the referenced bran
          VAR !firstMem COLL MEM OF $!tref WI ORDER EQ 1
          if (!firstMem.empty()) then
            !continuedOn = !lineNumber[1]

          else
            !continuedOn = 'THIS ' & !firstMem[1]

          endif

        else
          !continuedOn = 'THIS ' & !tref.string()

        endif

      else
        !continuedOn = !lineNumber[1]

      endif

    endif

  elseif (!end.eq('CREF')) then

    -- Get drwg name of cref
    if (!component.cref.unset()) then
      !continuedOn = 'Unset'

    elseif (!component.cref.badref()) then
      !continuedOn = 'Badref'

    else

      -- Get cref
      !cref = !component.cref

      -- Get connected component.
      -- This is so we can find out which drawlist it is in later to find the sheet number
      if (!cref.type.upCase().eq('BRAN')) then

        -- Extract the drawing name from the connection reference
        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!cref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!cref

        -- Test for on same drawing
        if (!extract[1].eq(!drwgName)) then

          -- Test whether head or tail has return reference
          if (!cref.href.badref() ) then

            if (!cref.tref.badref()) then
              !continuedOn = 'Unknown'
            elseif (!cref.tref.eq(!component)) then

              -- Get the last member of the referenced bran
              !order = !cref.mcount()
              VAR !lastMem COLL MEM OF $!cref WI ORDER EQ $!order
             if (!lastMem.empty()) then
               !continuedOn = !lineNumber[1]
             else
               !continuedOn = 'THIS ' & !lastMem[1]
             endif
            else
              !continuedOn = !lineNumber[1]
            endif

          elseif (!cref.href.eq(!component)) then

            -- Get the first member of the referenced bran
            VAR !firstMem COLL MEM OF $!cref WI ORDER EQ 1
            if (!firstMem.empty()) then
              !continuedOn = !lineNumber[1]
            else
              !continuedOn = 'THIS ' & !firstMem[1]
            endif
          else
            !continuedOn = !lineNumber[1]
          endif

        else
          !continuedOn = !lineNumber[1]
        endif

      elseif (!cref.type.upCase().eq('NOZZ')) then
        !extract[1] = ''
        !lineNumber[1] = !cref.flnn
      else

        -- Extract the drawing name from the connection reference
       !owneRefe = !component.cref.owne
        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!owneRefe
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!owneRefe

        -- Test for on same drawing
        if (!extract[1].eq(!drwgName)) then
          !continuedOn = 'THIS ' & !cref.string()
        else
          !continuedOn = !lineNumber[1]
        endif

      endif

    endif

  -- For cable way
  elseif (!end.eq('HCREF')) then

    -- Get drwg name of href
    if (!component.owne.owne.owne.hcref.unset()) then
      !continuedOn = 'Unset'
    elseif (!component.owne.owne.owne.hcref[1].badref()) then
      !continuedOn = 'Badref'

    else

      -- Extract the drawing name from the head reference
      !hcref = !component.owne.owne.owne.hcref[1]
      if (!hcref.type.upCase().eq('CWBRAN')) then

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!hcref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!hcref

      else

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF OWNE OF $!hcref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF OWNE OF $!hcref

      endif

      -- Test for on same drawing
      if (!extract[1].eq(!drwgName)) then

        -- Get connected component.
        -- This is so we can find out which drawlist it is in later to find the sheet number
        if (!hcref.type.upCase().eq('CWBRAN')) then

          -- Get the last member of the referenced cwbran
          !components = !!isoCwbranMem(!branch, 'LAST')
          !lastMem    = !components[!components.size()]

          if (!lastMem.empty()) then
            !continuedOn = !lineNumber[1]

          else
            !continuedOn = 'THIS ' & !lastMem[1]

          endif

        else
          !continuedOn = 'THIS ' & !hcref.string()

        endif

      else
        !continuedOn = !lineNumber[1]

      endif

    endif

  elseif (!end.eq('TCREF')) then

    -- Get drwg name of tref
    if (!component.owne.owne.owne.tcref.unset()) then
      !continuedOn = 'Unset'

    elseif (!component.owne.owne.owne.tcref[1].badref()) then
      !continuedOn = 'Badref'

    else

      -- Extract the drawing name from the tail reference
      !tcref = !component.owne.owne.owne.tcref[1]
      if (!tcref.type.upCase().eq('CWBRAN')) then

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF $!tcref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF $!tcref

      else

        VAR !extract EVAL $!drwgNameRule FOR OWNE OF OWNE OF $!tcref
        VAR !lineNumber EVAL $!lineNumbRule FOR OWNE OF OWNE OF $!tcref

      endif

      -- Test for on same drawing
      if (!extract[1].eq(!drwgName)) then

        -- Get connected component.
        -- This is so we can find out which drawlist it is in later to find the sheet number
        if (!tcref.type.upCase().eq('CWBRAN')) then

          -- Get the first member of the referenced cwbran
          !components = !!isoCwbranMem(!branch, 'LAST')
          !firstMem   = !components[1]

          if (!firstMem.empty()) then
            !continuedOn = !lineNumber[1]

          else
            !continuedOn = 'THIS ' & !firstMem[1]

          endif

        else
          !continuedOn = 'THIS ' & !tcref.string()

        endif

      else
        !continuedOn = !lineNumber[1]

      endif

    endif


  endif

  return !continuedOn

endfunction
