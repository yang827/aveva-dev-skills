--
-- File:            isocrstd.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the HVAC Component Standards drawings using plotfiles created in folder %PDMSUI%\Plots\Hvacadv
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!isoCrStd()

  -- Load the application if necessary
  if (undefined(!!isoMain)) then

  	-- Start the application
    !errors = !!isoDraStartup()

    -- Stop if there are any errors
    if (!errors) then
    	return
    endif

  endif

  -- The application has been activated
  if (!!isoMain.isoAdpApp.token.eq(false)) then
    !!isoMain.isoAdpApp.setActive(!!isoMain.isoAdpApp.license(2))
   endif

	-- Initialise variables
	!registry = !!isoMain.isoAdpApp.data.isoRegister
	!added = 0

  -- Test that the application is running
  if (!registry.unset()) then
    !!alert.warning('The Isometric Registry does not exist. Please create it using the defaults form and try again.')
    return
  endif

  -- Check for load
  !answer = !!alert.question('You are about to load the HVAC Standard Drawings. Are you certain you wish to continue?')
  if (!answer.neq('YES')) then
  	return
  endif

  -- special unicode characters must not be used in strings unless this is a unicode file
  !diam   = !!charactersymbol('DIAM')
  !degr   = !!charactersymbol('DEGR')
  -- Initialise variables
  !folder = object FILE('%PDMSUI%\Plots\Hvacadv')

  -- Test for True-Type
  !fontManager = object ADMFONTMANAGER()
  if (!fontManager.firstTtfId.set()) then
    !font = !!fontManager.firstTtfId
  else
    !font = 1
  endif

  -- Get units
  VAR !units UNITS

  -- Set paper size, backing sheet and file opos depending on units
  if (!units.upcase().match('MM').neq(0)) then
    !paperSize    = '420 297'
  else
    !paperSize    = '431.8mm 279.4mm'
  endif

  -- Get all hvac component files
  !allFiles = !folder.files()

  -- Locate the isometric registry
  VAR !exists EXISTS $!registry

  -- Stop if it does not exist
  if (!exists.eq('FALSEA')) then
    !!alert.warning('The Isometric Registry does not exist. Please create it using the defaults form and try again.')
    return

  else
    !!ce = !registry

  endif

  -- Create the registry
  VAR !exists EXISTS /TT/Isometric_ADP/Standards
  if (!exists.eq('FALSEA')) then
    NEW REGISTRY /TT/Isometric_ADP/Standards
    FONT $!font

  else
    !answer = !!alert.question('The HVAC Standards have already been loaded. Do you want to load any updates?')
    if (!answer.neq('YES')) then
     	return
    endif

    REGISTRY /TT/Isometric_ADP/Standards

  endif

  -- Create the drawing
  VAR !exists EXISTS /TT/Isometric_ADP/HVAC_Standards
  if (!exists.eq('FALSEA')) then
    NEW DRWG /TT/Isometric_ADP/HVAC_Standards
  else
    DRWG /TT/Isometric_ADP/HVAC_Standards
	endif

  -- Set DRWG attributes
  SIZE $!paperSize
  TITLE 'HVAC Component Standards'

  !drwgName = !!ce.name

  --For each found component file
  do !index ind !allFiles

    -- Initialise variables
    !file = !allFiles[!index]

    -- Get component name from the file name
    !componentType = !file.entry().upcase()

    -- Do not create a sheet for certain 'types'
    skip if (!componentType.eq(''))
    skip if (!componentType.eq('CDNOZ'))
    skip if (!componentType.eq('MAINBRAN'))
    skip if (!componentType.eq('PBRAN'))
    skip if (!componentType.eq('PCFLEXFILL'))
    skip if (!componentType.eq('PCSETFILL'))
    skip if (!componentType.eq('PMAIN'))
    skip if (!componentType.eq('PRSETFILL'))
    skip if (!componentType.eq('SIDEBRAN'))

    -- Build the file name
    !filename = '/' & !file.fullname()

    -- Build sheet name from drwg name and component name
    !sheetName     = !drwgName & '/' & !componentType

    -- Creat sheet
    VAR !exists EXISTS $!sheetName
    if (!exists.eq('FALSEA')) then
      NEW SHEET $!sheetName

      !added = !added + 1
      WRITE ('Adding sheet $!sheetName')

    else
    	SHEET $!sheetName
    endif

    -- Set SHEE attributes
    TITL '$!componentType'
    SIZE $!paperSize
--     BSRF $!backingSheet

    -- Add the file as an overlay
    VAR !exists EXISTS $!sheetName/Olay
    if (!exists.eq('FALSEA')) then
      NEW OLAYER $!sheetName/Olay
    else
    	OLAYER $!sheetName/Olay
    endif

    -- Set OLAY attributes
--     XYSC 0.85 0.85
    OSFN $!filename

    -- Create a note for any parameter text
    VAR !exists EXISTS $!sheetName/Parameters
    if (!exists.eq('FALSEA')) then
      NEW NOTE $!sheetName/Parameters
    else
    	NOTE $!sheetName/Parameters
    endif

    -- Set NOTE attributes
    CHEI 5
    TXCOLOUR Red

    -- Clear all text
    DELETE NOTE MEM

    -- Force the units to mm for the texp positions
    MM DIST

    -- Add parameter text
    if (!componentType.eq('CANGBRCO')) then
      NEW TEXP BTEX |A $!<diam>| Origin Offset X19.411758 Y119.647064
      NEW TEXP BTEX |B $!<diam>| Origin Offset X6.176464 Y252.000015
      NEW TEXP BTEX |C $!<diam>| Origin Offset X401.647064 Y226.588241
      NEW TEXP BTEX |D | Origin Offset X148.588241 Y52.941173
      NEW TEXP BTEX |E $!<degr>| Origin Offset X76.058822 Y77.823532
      NEW TEXP BTEX |F | Origin Offset X103.058822 Y165.705886
      NEW TEXP BTEX |G | Origin Offset X26.823524 Y239.823532
      NEW TEXP BTEX |H | Origin Offset X163.411773 Y29.117645
    endif
    if (!componentType.eq('CFLXBEN')) then
      NEW TEXP BTEX |A ~D| Origin Offset X128.470581 Y59.294116
      NEW TEXP BTEX |B ~0| Origin Offset X206.823532 Y180.529418
      NEW TEXP BTEX |C| Origin Offset X129 Y148.23529
      NEW TEXP BTEX |D| Origin Offset X144.352935 Y103.764709
      NEW TEXP BTEX |E| Origin Offset X162.882354 Y168.352951
    endif
    if (!componentType.eq('RTHOLE')) then
      NEW TEXP BTEX |A| Origin Offset X36.352935 Y98.470588
      NEW TEXP BTEX |B| Origin Offset X28.941171 Y249.352951
      NEW TEXP BTEX |C = NUMBER OF TEST HOLES| Origin Offset X192.529418 Y49.764705
      NEW TEXP BTEX |D ~D| Origin Offset X117.352943 Y115.411766
      NEW TEXP BTEX |E| Origin Offset X86.647056 Y56.117645
      NEW TEXP BTEX |F| Origin Offset X147.529418 Y42.352939
      NEW TEXP BTEX |G| Origin Offset X76.058822 Y254.647064
    endif
    if (!componentType.eq('CBOOT')) then
      NEW TEXP BTEX |A $!<diam>| Origin Offset X8.294114 Y154.058822
      NEW TEXP BTEX |B $!<diam>| Origin Offset X5.647052 Y254.647064
      NEW TEXP BTEX |C $!<diam>| Origin Offset X385.764709 Y240.882354
      NEW TEXP BTEX |D | Origin Offset X176.647064 Y85.235298
