      NEW TEXP BTEX |G | Origin Offset X171.352935 Y55.058822
    endif
    if (!componentType.eq('CCONIC')) then
      NEW TEXP BTEX |A $!<diam>| Origin Offset X13.058817 Y126.529411
      NEW TEXP BTEX |B $!<diam>| Origin Offset X11.470582 Y228.176483
      NEW TEXP BTEX |C $!<diam>| Origin Offset X382.058837 Y226.588241
      NEW TEXP BTEX |D $!<degr>| Origin Offset X157.588241 Y92.117645
