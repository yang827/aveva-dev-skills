--
-- File:            isocwaycont.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the continuation labels for Cable Way
--
-- Assumptions:
-- The current element is the LAYE
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL        The current sheet number
--    2    R     ISOSPOOL    This spool object for this drawing
--    3    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoCwayCont(!dummyShtNumber is REAL, !spoolObj is ISOSPOOL, !data is ISODEFAULTS)

  -- Initialise variables
  !elevLaye    = !!ce
  !viewRefe    = !elevLaye.owne
  !onString    = !data.elecContTag.onString
  !code        = !data.elecContTag.code
  !offset      = !data.elecContTag.offset[1].queryString() & ' ' & !data.elecContTag.offset[2].queryString()
  !tColour     = !data.elecContTag.tColour
  !fColour     = !data.elecContTag.fColour
  !fStyle      = !data.elecContTag.fStyle & !data.elecContTag.fThickness.replace('Thin','')
  !cHei        = !data.elecContTag.cHei.queryString()
  !allComp     = !spoolObj.components
  !firstComp   = !spoolObj.components[1]
  !lastComp    = !spoolObj.components[!spoolObj.components.size()]
  !ctCrosThird = false
  !keep        = ARRAY()

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- Clean any bad references
  DELETE NULL ANNO
    handle (64,353)
      -- n elements with null or illegal DDNM attributes have been deleted
    endhandle

  -- Get all existing labels
  VAR !existTags COLL ALL (SLAB GLAB) FOR CE
  VAR !existRefe EVAL REFE OF DDNM FOR ALL FROM !existTags IGNORE ANY

  -- Get the drawlists that contain the parts
  !allDrawlists = !!isoCwDrawLists(!viewRefe)

  -- Get the first part to use for the continued from
  -- Look for a pointr
  if (!firstComp.type.upcase().eq('POINTR')) then
    !parts[1] = !firstComp

  -- Any other component
  else

   -- Test for template and section as these are one level further down in the hierarchy
    if (!firstComp.type.upcase().eq('TMPL') or !firstComp.type.upcase().eq('GENSEC')) then
      !parts[1] = !firstComp.owne.owne

    -- For anything else use the part
    else
      !parts[1] = !firstComp

    endif

  endif

  -- Get the last part to use for the continued to
  -- Look for a pointr
  if (!lastComp.type.upcase().eq('POINTR')) then
    !parts[2] = !lastComp

  -- Any other component
  else

   -- Test for template and section as these are one level further down in the hierarchy
    if (!lastComp.type.upcase().eq('TMPL') or !lastComp.type.upcase().eq('GENSEC')) then
      !parts[2] = !lastComp.owne.owne

    -- For anything else use the part
    else
      !parts[2] = !lastComp

    endif

  endif

  -- Label the continuations for the first and last parts
  do !index ind !parts

    -- Initialise variables
    !partRefe = !parts[!index]

    -- For the first part
    if (!index.eq(1)) then

      !template    = !data.elecContTag.aTemplate
      !continuedOn = !spoolObj.contFrom
      !contString  = !data.elecContTag.fromString

      -- Look for a pointr and use the origin
      if (!partRefe.type.upcase().eq('POINTR')) then

        -- Use the origin as the annotation point
        !pPoint   = 'P0'

        -- Use the next part to determine tray levels
        !levelRefe = !allComp[2]

      -- Anything else use the arrive ppoint
      else

        -- Get this part arrive ppoint
        !pArrive = !partRefe.arrive
          handle (2,201)
            -- Element does not have attribute ARRI
            VAR !pA PA OF $!partRefe
            !pArrive = !pA.split()[2].real()
          endhandle

        !pPoint  = 'P' & !pArrive

        -- Use this part to determine tray levels
        !levelRefe = !partRefe

      endif

    -- Look for the last part
    elseif (!index.eq(!parts.size())) then

      !template    = !data.elecContTag.lTemplate
      !continuedOn = !spoolObj.contTo
      !contString  = !data.elecContTag.onString

      -- Look for a pointr and use the origin
      if (!partRefe.type.upcase().eq('POINTR')) then

        -- Use the origin as the annotation point
        !pPoint      = 'P0'

        -- Use the previous part to determine tray levels
        !levelRefe = !allComp[!allComp.size() - 1]

      -- Any other element type
      else

        -- Get this part leave ppoint
        !pLeave = !partRefe.leave
          handle (2,201)
            -- Element does not have attribute LEAV
            VAR !pL PL OF $!partRefe
            !pLeave = !pL.split()[2].real()
          endhandle

        !pPoint = 'P' & !pLeave

        -- Use this part to determine tray levels
        !levelRefe = !partRefe

      endif

    endif

    -- Find continuation sheet
    if (!continuedOn.match('THIS').neq(0)) then

      -- Get the continued element
      !element = !continuedOn.split()[2]

      -- Extract the element name and find which drawlist it belongs to
      do !idliRefe val !allDrawlists

        VAR !adde COLL ALL ADDE WI IDNM EQ $!element FOR $!idliRefe
        if (defined(!adde[1])) then

          -- Remember this idli
          !foundIdliRefe = !idliRefe

          -- We are done
          break

        endif

      enddo

      -- For a found sheet number
      if (defined(!foundIdliRefe)) then
        !continuedOn = 'Sheet ' & !foundIdliRefe.func

      else
        !!isoLog.messages.append('   Cannot get continuation - possible problems with first or last component?')
        skip

      endif

    endif

    -- Initialise variables
    !elevString = ''
    !trayLevels = ARRAY()
    !components = ARRAY()

    -- Find all tray levels
    do !memRefe val !levelRefe.mem

      -- Only consider ctray elements
      if (!memRefe.type.upcase().eq('CTRAY')) then
        !trayLevels.append(!memRefe.pos.wrt(world).up.nint().value())
        !components.append(!memRefe)

      endif

    enddo

    -- Sort the levels into order highest first
    !trayLevels.unique()
    !components.unique()
    !sorted = !trayLevels.sortedIndices()
    !components.reindex(!sorted).invert()

    -- Add the up elevation for a single level
    if (!components.size().eq(1)) then
      !hashString = !code.replace('#P3POSU','#' & !pPoint.string() & 'POSU')

    -- Add the up elevation for a multi levels
    else

      -- For each level build the elevation string
      do !level ind !components

        -- Build the string for this level and add it to the previous
        !elevString = !elevString & '[#< #POSU<FR ' & !components[!level] & '> #>]'

        -- Add a newline character for all lines but the last
        if (!level.neq(!components.size())) then
          !elevString = !elevString & '#/'
        endif

      enddo

      !hashString = !code.replace('#P3POSU',!elevString)

    endif

    -- Build atex string
    !atex = !contString & ' ' & !continuedOn & '#/' & !hashString.replace('P3',!pPoint)

    -- Check is a label already exists for this component
    if (!allComp.size().eq(1)) then

      !allFind = !existRefe.find(!partRefe.string())

      if (!allFind.unset() or !allFind.empty()) then
        !find = REAL()

      elseif (!index.eq(1)) then
        !find = !allFind[1]

      else

        if (!allFind.size().gt(1)) then
          !find = !allFind[2]
        endif

      endif

    else
      !find = !existRefe.findFirst(!partRefe.string())

    endif

    -- If a label does not already exist then create a new one
    if (!find.unset()) then

      -- Create a coordinate label
      NEW SLAB ON $!pPoint OF $!partRefe  ATEX |$!atex|
       TMRF $!template XYPO $!offset OSET TRUE CHEI $!cHei BLNK TRUE
       TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

      -- Keep this one
      !keep.append(!!ce.string())

    else

      -- Modify the existing
      !keep.append(!existTags[!find])
      !!ce = !existTags[!find].dbref()
      ON $!pPoint OF $!partRefe  ATEX |$!atex| TMRF $!template

    endif

  enddo

  -- For each CTTEE or CROSS part
  do !index ind !spoolObj.contOn

    -- Initialise variables
    !partRefe    = !allComp[!index]
    !partType    = !partRefe.type.upcase()
    !continuedOn = !spoolObj.contOn[!index]

    -- Get this parts arrive and leave ppoints
    !pArrive = !partRefe.arrive
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pA PA OF $!partRefe
        !pArrive = !pA.split()[2].real()
      endhandle

    !pLeave  = !partRefe.leave
      handle (2,201)
        -- Element does not have attribute LEAV
        VAR !pL PL OF $!partRefe
        !pLeave = !pL.split()[2].real()
      endhandle

    -- Find continuation sheet
    if (!continuedOn.match('THIS').neq(0)) then

      -- Get the continued element
      !element = !continuedOn.split()[2]

      -- Extract the element name and find which drawlist it belongs to
      do !idliRefe val !allDrawlists

        VAR !adde COLL ALL ADDE WI IDNM EQ $!element FOR $!idliRefe
        if (defined(!adde[1])) then

          -- Remember this idli
          !foundIdliRefe = !idliRefe

          -- We are done
          break

        endif

      enddo

      -- For a found sheet number
      if (defined(!foundIdliRefe)) then
        !continuedOn = 'Sheet ' & !foundIdliRefe.func

      else
        !!isoLog.messages.append('   Cannot get continuation for ' & !partType & !partRefe.string() & ' - component problems?')
        skip

      endif

    endif

    -- For CTTEE annotate the third ppoint
    if (!partType.eq('CTTEE')) then

      -- Find the remaining p-point of three
      !allPpoints[1] = 1
      !allPpoints[2] = 2
      !allPpoints[3] = 3
      !allPpoints.deleteFrom(!pArrive,1)
      !allPpoints.deleteFrom(!pLeave,1)
      !allPpoints.compress()
      !pPoint = 'P' & !allPpoints[1]

      -- Find all tray levels
      !elevString = ''
      !trayLevels = ARRAY()
      !components = ARRAY()

      do !memRefe val !partRefe.mem

        -- Only consider ctray elements
        if (!memRefe.type.upcase().eq('CTRAY')) then

          -- Only include tee types
          if (!memRefe.catref.gtype.upcase().eq('TEE')) then
            !trayLevels.append(!memRefe.pos.wrt(world).up.nint().value())
            !components.append(!memRefe)

          endif

        endif

      enddo

      -- Sort the levels into order highest first
    !trayLevels.unique()
    !components.unique()
    !sorted = !trayLevels.sortedIndices()
    !components.reindex(!sorted).invert()

      -- Add the up elevation for a single level
      if (!components.size().eq(1)) then
        !hashString = !code.replace('#P3POSU','#' & !pPoint.string() & 'POSU')

      -- Add the up elevation for a multi levels
      else

        -- For each level build the elevation string
        do !level ind !components

          -- Build the string for this level and add it to the previous
          !elevString = !elevString & '[#< #POSU<FR ' & !components[!level] & '> #>]'

          -- Add a newline character for all lines but the last
          if (!level.neq(!components.size())) then
            !elevString = !elevString & '#/'
          endif

        enddo

        !hashString = !code.replace('#P3POSU',!elevString)

      endif

      -- Build btex string
      !btex = !onString & ' ' & !continuedOn & '#/' & !hashString.replace('P3',!pPoint)

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!partRefe.string())
      if (!find.unset()) then

        -- Create a coordinate label
        NEW GLAB ON $!pPoint OF $!partRefe BTEX |$!btex|
         XYPO $!offset OSET TRUE CHEI $!cHei BLNK TRUE  FRA OFF  GBOX 0
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

         !keep.append(!!ce.string())

      else

        -- Modify the existing
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ON $!pPoint OF $!partRefe BTEX |$!atex|

      endif

    endif

    -- For a CTCROS
    if (!partType.eq('CTCROS')) then

      -- Find all tray levels
      !elevString = ''
      !trayLevels = ARRAY()
      !components = ARRAY()

      do !memRefe val !partRefe.mem

        -- Only consider ctray elements
        if (!memRefe.type.upcase().eq('CTRAY')) then

          -- Only include tee types
          if (!memRefe.catref.gtype.upcase().eq('CROS')) then
            !trayLevels.append(!memRefe.pos.wrt(world).up.nint().value())
            !components.append(!memRefe)

          endif

        endif

      enddo

      -- Sort the levels into order highest first
      !trayLevels.unique()
      !components.unique()
      !sorted = !trayLevels.sortedIndices()
      !components.reindex(!sorted).invert()

      -- Add the up elevation for a single level
      if (!components.size().eq(1)) then
        !hashString = !code.replace('#P3POSU','#P3POSU')

      -- Add the up elevation for a multi levels
      else

        -- For each level build the elevation string
        do !level ind !components

          -- Build the string for this level and add it to the previous
          !elevString = !elevString & '[#< #POSU<FR ' & !components[!level] & '> #>]'

          -- Add a newline character for all lines but the last
          if (!level.neq(!components.size())) then
            !elevString = !elevString & '#/'
          endif

        enddo

        !hashString = !code.replace('#P3POSU',!elevString)

      endif

      -- Annotate the third ppoint
      if (!ctCrosThird.not()) then

        -- Find the remaining p-point of three
        !allPpoints[1] = 1
        !allPpoints[2] = 2
        !allPpoints[3] = 3
        !allPpoints.deleteFrom(!pArrive,1)
        !allPpoints.deleteFrom(!pLeave,1)
        !allPpoints.compress()
        !pPoint = 'P' & !allPpoints[1]

        -- Get existing labels for this ddnm and ppoint
        -- We have to do this because there are two entries for this part in the existing tag array
        VAR !existLabel COLL ALL GLAB WITH DDNM EQ $!partRefe AND NPPT EQ $!allPpoints[1] FOR $!elevLaye

        -- Build btex string
        !btex = !onString & ' ' & !continuedOn & '#/' & !hashString.replace('P3',!pPoint)

        -- Check is a label already exists for this component
        if (!existLabel.unset()) then

          -- Create a coordinate label
          NEW GLAB ON $!pPoint OF $!partRefe BTEX |$!btex|
           XYPO $!offset OSET TRUE CHEI $!cHei BLNK TRUE  FRA OFF  GBOX 0
           TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

           !keep.append(!!ce.string())

        else

          -- Find the label in the existing tags array
          !find = !existTags.findFirst(!existLabel[1])
          !keep.append(!existTags[!find])

          -- Modify the existing
          !!ce = !existTags[!find].dbref()
          ON $!pPoint OF $!partRefe BTEX |$!atex|

        endif

        -- Mark the CTCROS as being annotated
        !ctCrosThird = true

      endif

      -- Annotate the fourth ppoint
      if (!ctCrosThird) then

        -- Get the continued on string
        !continuedOn = !spoolObj.crosOn[!index]

        -- Get existing labels for this ddnm and ppoint
        -- We have to do this because there are two entries for this part in the existing tag array
        VAR !existLabel COLL ALL GLAB WITH DDNM EQ $!partRefe AND NPPT EQ 4 FOR $!elevLaye

        -- Build btex string
        !btex = !onString & ' ' & !continuedOn & '#/' & !hashString.replace('P3','P4')

        -- Check is a label already exists for this component
        if (!existLabel.unset()) then

          -- Create a coordinate label
          NEW GLAB ON P4 OF $!partRefe BTEX |$!btex|
           XYPO $!offset OSET TRUE CHEI $!cHei BLNK TRUE  FRA OFF  GBOX 0
           TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

           !keep.append(!!ce.string())

        else

          -- Find the label in the existing tags array
          !find = !existTags.findFirst(!existLabel[1])
          !keep.append(!existTags[!find])

          -- Modify the existing
          !!ce = !existTags[!find].dbref()
          ON $!pPoint OF $!partRefe BTEX |$!atex|

        endif

      endif

    endif

  enddo

  -- Remove any unwanted existing labels
  !remove = !existTags.difference(!keep)
  do !delete val !remove
    !!ce = !delete.dbref()
    DELETE $!!<ce.type>
  enddo

  -- Return to laye
  !!ce = !elevLaye
  UPDATE ANNO

endfunction
