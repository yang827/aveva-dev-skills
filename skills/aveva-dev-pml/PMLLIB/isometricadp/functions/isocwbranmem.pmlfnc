--
-- File:            isocwbranmem.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Gets data about the passed CWAY
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The CWBRAN or CTMTRL child member e.g. CTSTRA
--    2    R     STRING      The type of data: PARTS, PARTMEM, ALL, FIRST, LAST
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of cable way components
-------------------------------------------------------------------------
define function !!isoCwbranMem(!elemRefe is DBREF, !dataType is STRING) is ARRAY

  -- Initialise components
  !allComponents = ARRAY()
  !components    = ARRAY()
  !parts         = ARRAY()
  !collection    = object COLLECTION()

  -- For Part child members
  if (!dataType.eq('PARTMEM')) then

    -- For each of the members of this level, which are components unless they are CTFEAT,
    -- which itself is nothing but owns components TMPL and GENSEC
    -- There is a further complication that if a CTRAY owns a TMPL it is switched off even if it has a valid spref
    do !compRefe val !elemRefe.mem

      -- Do we need a Cable Tray Joint?
      skip if (!compRefe.type.upCase().eq('CTJOIN'))

      -- Test for a CTFEAT
      if (!compRefe.type.eq('CTFEAT')) then

        -- Look for TMPL and GENSEC
        do !subComponent val !compRefe.mem

          -- TMPL
          if (!subComponent.type.eq('TMPL')) then

            -- Test for members
            if (!subComponent.mcount.gt(0)) then
              !allComponents.append(!subComponent)
            endif

          -- GENSEC
          elseif (!subComponent.type.eq('GENSEC')) then

            -- Test for bad spref
            if (!subComponent.spref.badref().not()) then
              !allComponents.append(!subComponent)
            endif

          endif

        enddo

      -- Add the component
      else

        -- Initialise variables
        !useCtray = true

        -- Look for any owned TMPL
        do !subComponent val !compRefe.mem

          -- TMPL
          if (!subComponent.type.eq('TMPL')) then
            !allComponents.append(!subComponent)
            !useCtray = false
          endif

        enddo

        -- The ctray does not own any templates so use it
        if (!useCtray) then
          !allComponents.append(!compRefe)
        endif

      endif

    enddo

  -- For CWBRAN components
  else

    -- Get the branch cable tray material (CTMTRL)
    !collection.scope(!elemRefe)
    !collection.type('CTMTRL')
    !allCtmtrl = !collection.results()

    -- Check for no CTMTRL
    if (!allCtmtrl.unset()) then
      return !components
    endif

    -- For each CTMTRL
    do !ctmtrl val !allCtmtrl

      -- For each CTMTRL member (any of CTSTRA CTRISE CTBEND CTTEE CTCROS CTREDU)
      do !ctmtrlMember val !ctmtrl.mem

        -- This is the level of material parts, which are used for annotation and splitting
        !parts.append(!ctmtrlMember)

        -- Do do anything further if we only want the parts
        skip if (!dataType.eq('PARTS'))

        -- For each of the members of this level, which are components unless they are CTFEAT,
        -- which itself is nothing but owns components TMPL and GENSEC
        -- There is a further complication that if a CTRAY owns a TMPL it is switched off even if it has a valid spref
        do !compRefe val !ctmtrlMember.mem

          -- Do we need a Cable Tray Joint?
          skip if (!compRefe.type.upCase().eq('CTJOIN'))

          -- Test for a CTFEAT
          if (!compRefe.type.eq('CTFEAT')) then

            -- Look for TMPL and GENSEC
            do !subComponent val !compRefe.mem

              -- TMPL
              if (!subComponent.type.eq('TMPL')) then

                -- Test for members
                if (!subComponent.mcount.gt(0)) then
                  !allComponents.append(!subComponent)
                endif

              -- GENSEC
              elseif (!subComponent.type.eq('GENSEC')) then

                -- Test for bad spref
                if (!subComponent.spref.badref().not()) then
                  !allComponents.append(!subComponent)
                endif

              endif

            enddo

          -- Add the component
          else

            -- Initialise variables
            !useCtray = true

            -- Look for any owned TMPL
            do !subComponent val !compRefe.mem

              -- TMPL
              if (!subComponent.type.eq('TMPL')) then
                !allComponents.append(!subComponent)
                !useCtray = false
              endif

            enddo

            -- The ctray does not own any templates so use it
            if (!useCtray) then
              !allComponents.append(!compRefe)
            endif

          endif

        enddo

      enddo

    enddo

  endif

  -- For parts
  if (!dataType.eq('PARTS')) then
    return !parts

  endif

  -- For any found components
  if (!allComponents.size().neq(0)) then

    -- For all components
    if (!dataType.eq('PARTMEM') or !dataType.eq('ALL')) then
      !components = !allComponents

    -- For the first component
    elseif (!dataType.eq('FIRST')) then
      !components.append(!allComponents[1])

    -- For the last component
    elseif (!dataType.eq('LAST')) then
      !components.append(!allComponents[!allComponents.size()])

    endif

  endif

  return !components

endfunction
