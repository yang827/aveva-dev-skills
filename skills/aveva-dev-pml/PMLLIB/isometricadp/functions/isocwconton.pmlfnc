--
-- File:            isocwconton.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the data for the continuation labels
--
-- Assumptions:
-- The drawing name for comparison is extracted from the cway level
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The part looking for a continuation
--    2    R     STRING      The type of search. HREF, TREF
--                                               CREF for CTTEE
--                                               CREF or CREFA for CTCROS
--    3    R     STRING      Drawing Name extraction rule
--    4    R     STRING      Line Number extraction rule
--
-- Return:
--   [Data Type] [Description]
--    STRING      Description of the continuation.
--                Possible returns are;
--                 <Unknown>          - the continuation cannot be determined
--                 <Line Number>      - the continuation line number when not to this drwg
--                 <THIS + Reference> - THIS to indicate that the continuation is on this drwg
--                                      and the reference number of the continuation component
-------------------------------------------------------------------------
define function !!isoCwContOn(!partRefe is DBREF, !end is STRING, !drwgNameRule is STRING, !lineNumbRule is STRING) is STRING

  -- Extract drawing name from the CWAY
  VAR !allName EVAL $!drwgNameRule FOR OWNE OF OWNE OF OWNE OF $!partRefe
  !drwgName = !allName[1]

  -- Determine the relevant ppoint
  -- Head
  if (!end.eq('HREF')) then
    !pPoint = !partRefe.arrive
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pA PA OF $!partRefe
        !pPoint = !pA.split()[2].real()
      endhandle

  -- Tail
  elseif (!end.eq('TREF')) then
    !pPoint = !partRefe.leave
      handle (2,201)
        -- Element does not have attribute LEAV
        VAR !pL PL OF $!partRefe
        !pPoint = !pL.split()[2].real()
      endhandle

  -- Tee and Cross third ppoint
  elseif (!end.eq('CREF')) then

    -- Get this part arrive and leave ppoints
    !pArrive = !partRefe.arrive
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pA PA OF $!partRefe
        !pArrive = !pA.split()[2].real()
      endhandle

    !pLeave  = !partRefe.leave
      handle (2,201)
        -- Element does not have attribute LEAV
        VAR !pL PL OF $!partRefe
        !pLeave = !pL.split()[2].real()
      endhandle

    -- Find the remaining p-point of three
    !allPpoints[1] = 1
    !allPpoints[2] = 2
    !allPpoints[3] = 3

    !allPpoints.deleteFrom(!pArrive,1)
    !allPpoints.deleteFrom(!pLeave,1)
    !allPpoints.compress()

    !pPoint        = !allPpoints[1]

  -- Cros fourth ppoint
  elseif (!end.eq('CREFA')) then

    -- Get this part arrive and leave ppoints
    !pArrive = !partRefe.arrive
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pA PA OF $!partRefe
        !pArrive = !pA.split()[2].real()
      endhandle

    !pLeave  = !partRefe.leave
    !pLeave  = !partRefe.leave
      handle (2,201)
        -- Element does not have attribute LEAV
        VAR !pL PL OF $!partRefe
        !pLeave = !pL.split()[2].real()
      endhandle

    -- Find the last p-point of four
    !allPpoints[1] = 1
    !allPpoints[2] = 2
    !allPpoints[3] = 3
    !allPpoints[4] = 4

    !allPpoints.deleteFrom(!pArrive,1)
    !allPpoints.deleteFrom(!pLeave,1)
    !allPpoints.compress()

    !allPpoints.deleteFrom(1,1)
    !allPpoints.compress()

    !pPoint        = !allPpoints[1]

  endif

  -- Get the adjacent part at the determined ppoint
  !adjacentPart = !partRefe.ctcref[!pPoint]
    handle (2,201)

      -- Element does not have attribute CTCREF
      !continuedOn = 'Unset'

    elsehandle none

      -- Extract the drawing name from the found part
      !cwayRefe = !adjacentPart.owne.owne.owne

      VAR !extract EVAL $!drwgNameRule FOR $!cwayRefe
      VAR !lineNumber EVAL $!lineNumbRule FOR $!cwayRefe

      -- Test for the adjacent part being on the same drawing as this part
      if (!extract[1].eq(!drwgName)) then

        -- Use the adjacent part.
        -- This is so we can find out which drawlist it is in later to find the sheet number
        !continuedOn = 'THIS ' & !adjacentPart

      -- Use the 'connected' line number
      else
        !continuedOn = !lineNumber[1]

      endif

    endhandle

  return !continuedOn

endfunction
