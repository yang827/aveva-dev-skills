--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Retrieves the component drawlists for a CWAY drawing
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       A VIEW element
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of DBREF objects
--
------------------------------------------------------------------------
define function !!isoCwDrawLists(!viewRefe is DBREF) is ARRAY

  -- Initialise variables
  !collection = object COLLECTION()
  !numbers    = ARRAY()

  -- Get the drawlist library
  !dllbRefe = !viewRefe.idln.mem[1].idnm.owne

  -- Get the drawlists
  !collection.scope(!dllbRefe)
  !collection.filter(object EXPRESSION('SPPURP EQ |PARTSL|'))
  !allIdli = !collection.results()

  -- Get the related sheet number from the function
  do !idli val !allIdli
    !numbers.append(!idli.func.real())
  enddo

  -- Get the drawlists into order
  !sorted = !numbers.sortedIndices()
  !allIdli.reindex(!sorted)

  return !allIdli

endfunction
