-- File:            isocworientation.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
-- Description:
-- Determines an axis orthogonal to the centreline between the passed components
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The part reference
--    2    R     DIRECTION   The p-point direction
--
-- Return:
--   [Data Type] [Description]
--    STRING     An axis direction orthogonal to the centreline direction
--
------------------------------------------------------------------------
define function !!isoCwOrientation(!partRefe is DBREF, !clDir is DIRECTION) is STRING

  -- Initialise variables
  !orthogonal = object DIRECTION()

  -- Create at plane at the first component
  !plane = object PLANE(!partRefe.ppos[0].wrt(world), !partRefe.ori.wrt(world))
    handle any

    	return '90'
    endhandle

  -- Find which axis is parallel to the p-point direction
  -- X axis
  if (!plane.orientation.xdir().eq(!clDir) or !plane.orientation.xdir().eq(!clDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.ydir()

  endif

  -- Y axis
  if (!plane.orientation.ydir().eq(!clDir) or !plane.orientation.ydir().eq(!clDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.xdir()

  endif

  -- Z axis
  if (!plane.orientation.zdir().eq(!clDir) or !plane.orientation.zdir().eq(!clDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.xdir()

  endif

  return !orthogonal.string().before('WRT')

endfunction
