--
-- File:            isodate.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Calculates the date format
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW]  [Data Type]   [Description]
--    1    R      ISODEFAULTS   The defaults settings
--
-- Return:
--   [Data Type] [Description]
--    STRING      Date
--
-------------------------------------------------------------------------
define function !!isoDate(!data is ISODEFAULTS) is STRING

  -- Initialise variables
  !format = !data.dateFormat
  !zone   = !data.dateZone
  !date   = object DATETIME()

  -- Add leading zero if necessary
  if (!date.date().string().length().eq(1)) then
    !day = '0' & !date.date().string()
  else
    !day = !date.date().string()
  endif
  if (!date.month().string().length().eq(1)) then
    !month = '0' & !date.month().string()
  else
    !month = !date.month().string()
  endif

  -- Get 12 hour clock
  if (!date.hour().gt(12)) then
    !hour = !date.hour() - 12
    !amPm = 'pm'
  else
    !hour = !date.hour()
    !amPm = 'am'
  endif

  -- Build the date according to the default format and zone
  if (!format.eq('3/4')) then
    if (!zone.eq('World')) then
      !dateString = !date.date().string() & '/' & !date.month().string()
    else
      !dateString = !date.month().string() & '/' & !date.date().string()
    endif
  elseif (!format.eq('3/4/00')) then
    if (!zone.eq('World')) then
      !dateString = !date.date().string() & '/' & !date.month().string() &  '/' & !date.year().string().subString(3)
    else
      !dateString = !date.month().string() & '/' & !date.date().string() &  '/' & !date.year().string().subString(3)
    endif
  elseif (!format.eq('03/04/00')) then
   if (!zone.eq('World')) then
      !dateString = !day & '/' & !month &  '/' & !date.year().string().subString(3)
    else
      !dateString = !month & '/' & !day &  '/' & !date.year().string().subString(3)
    endif
  elseif (!format.eq('3-Mar')) then
    if (!zone.eq('World')) then
      !dateString = !date.date().string() & '-' & !date.monthString().string().subString(1,3)
    else
      !dateString = !date.month().string().subString(1,3) & '-' & !date.date().string()
    endif
  elseif (!format.eq('3-Mar-00')) then
    if (!zone.eq('World')) then
      !dateString = !date.date().string() & '-' & !date.monthString().string().subString(1,3) & '-' & !date.year().string().subString(3)
    else
      !dateString = !date.month().string().subString(1,3) & '-' & !date.date().string() & '-' & !date.year().string().subString(3)
    endif
  elseif (!format.eq('03-Mar-00')) then
    if (!zone.eq('World')) then
      !dateString = !day & '-' & !date.monthString().string().subString(1,3) & '-' & !date.year().string().subString(3)
    else
      !dateString = !date.month().string().subString(1,3) & '-' & !day & '-' & !date.year().string().subString(3)
    endif
  elseif (!format.eq('Mar-00')) then
    !dateString = !date.monthString().string().subString(1,3) & '-' & !date.year().string().subString(3)
  elseif (!format.eq('March-00')) then
    !dateString = !date.monthString().string() & '-' & !date.year().string().subString(3)
  elseif (!format.eq('March 3, 2000')) then
    !dateString = !date.monthString().string() & ' ' & !date.date().string() & ', ' & !date.year().string()
  elseif (!format.eq('3/4/00 1:30pm')) then
    if (!zone.eq('World')) then
      !first = !date.date().string() & '/' & !date.month().string() &  '/' & !date.year().string().subString(3)
      !second = !hour.string() & ':' & !date.minute() & !amPm
      !dateString = !first & ' ' & !second
    else
      !first = !date.month().string() & '/' & !date.date().string() &  '/' & !date.year().string().subString(3)
      !second = !hour.string() & ':' & !date.minute() & !amPm
      !dateString = !first & ' ' & !second
    endif
  else
  -- 3/4/00 13:30
    if (!zone.eq('World')) then
      !first = !date.date().string() & '/' & !date.month().string() &  '/' & !date.year().string().subString(3)
      !second = !date.hour().string() & ':' & !date.minute()
      !dateString = !first & ' ' & !second
    else
      !first = !date.month().string() & '/' & !date.date().string() &  '/' & !date.year().string().subString(3)
      !second = !date.hour().string() & ':' & !date.minute()
      !dateString = !first & ' ' & !second
    endif
  endif

  return !dateString

endfunction
