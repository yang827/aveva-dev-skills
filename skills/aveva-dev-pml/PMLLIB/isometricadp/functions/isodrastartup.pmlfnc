--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
-- Description:
-- Isometric ADP Application Startup
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Whether there have been any error on loading the application
--
------------------------------------------------------------------------
define function !!isoDraStartup() is BOOLEAN

  -- Access PADD db
  if (!!ce.dbType.eq('DESI')) then
    CONTEXT DRAWING
  endif

  -- Load application forms
  pml load form !!isoDisplayList
  pml load form !!isoCrHier
  pml load form !!isoEdit
  pml load form !!isoPrint
  pml load form !!isoPrinted
  pml load form !!isoProcess
  pml load form !!isoFeedback
  pml load form !!isoDflts
  pml load form !!isoMain
  pml load form !!isoModelView
  pml load form !!isoLogViewer
  pml load form !!isoContent

  -- Load application
  if (!!isoMain.isoAdpApp.load()) then

    -- Return that there are not any errors
    !errors = false

    -- Load the user default settings
    pml load form !!isoUserDflts

    -- Activate the toolbar and main menu option
    !!isoMain.isoAdpApp.setActive(!!isoMain.isoAdpApp.license(1))

  else

    -- Return that there have been errors
    !errors = true

    -- Stop when any load errors & deactivate the toolbar and main menu option
    !!isoMain.isoAdpApp.setActive(false)

    return !errors

  endif

  return !errors

endfunction
-- End of function !!isoDraStartup
