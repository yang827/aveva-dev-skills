--
-- File:            isodrwgnumber.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Calculates and sets the drwg number
-- The number is held in a file along with the series number
-- The word 'REPLACE' is replaced by a series number that is incremented
-- and written back to the file for the next extraction.
--
-- Assumptions:
-- The current element is the DRWG element
-- The drwg number is held under the UDA :IdpDrwgNo
------------------------------------------------------------------------
--
-- Return:
--   [Data Type] [Description]
--    STRING      An error message if the file holding the drwg number is missing
-------------------------------------------------------------------------
define function !!isoDrwgNumber() is STRING

  -- Initialise variables
  !error    = 'NONE'
  !preZeros = ''
  !real     = REAL()
  !drwgRefe = !!ce

  -- Read the file for the number format and series number
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-DRWGNUMBER')
  if (!file.exists().not()) then
    !error = 'The defaults file DRA-ISO-DRWGNUMBER does not exist!'

    -- Set the drwg number
    !drwgRefe.attribute('DRWGNUMBER') = |---|

    !drwgRefe.attribute(':IdpDrwgNo') = |---|
      handle (99,532)
        -- Undefined UDA or undefined UDET
      endhandle

    return !error

  endif

  !contents   = !file.readfile()
  !numbString = !contents[4]
  !series     = !contents[5]
  !length     = !series.length()

  -- Replace the word 'REPLACE' by the series number
  !drwgNumb = !numbString.replace('REPLACE',!series)

  -- Set the drawing number attribute
  !drwgRefe.attribute('DRWGNUMBER') = |$!drwgNumb|

  -- Set the drwg number
  !drwgRefe.attribute(':IdpDrwgNo') = |$!drwgNumb|
    handle (99,532)
      -- Undefined UDA or undefined UDET
    endhandle

  -- Raise the series number by the value of one
  do !count from 1 to !length
    if (!series.subString(!count,1).eq('0')) then
      !preZeros = !preZeros & '0'
    else
      !real = !series.subString(!count).real() + 1
      break
    endif
  enddo

  -- Test for all zeros
  if (!real.unset()) then
    !preZeros = !preZeros.subString(1,!length - 1)
    !real = 1
  endif

  -- Build next series number
  !nextString = !preZeros & !real
  !nextSeries = !nextString.subString(!nextString.length() - !length + 1)

  -- Save next series to file
  !array[1] = '--'
  !array[2] = '-- Isometric ADP Drawing Number Format & Series Number'
  !array[3] = '--'
  !array[4] = !numbString
  !array[5] = !nextSeries
  !file.writefile('OVER',!array)

  return !error

endfunction
