-- File:            isoelements.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Find the relevant elements for processing
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Element
--    2    R     STRING     The type of element to find HVAC, HSPOOL, HVACASMBLY, CWAY, CWAYASMBLY
--    3    R     STRING     Object type required DBREF or STRING
--    4    R     STRING     The element filter rule
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!isoElements(!elemRefe is DBREF, !type is STRING, !objectType is STRING, !filter is STRING) is ARRAY

  -- Initialise variables
  !elements = ARRAY()

  -- Get all members of the passed element, while checking for the world
  -- The result includes the current element
  if (!type.eq('HVAC') or !type.eq('CWAY')) then

    if (!elemRefe.hardType.upcase().eq('WORL')) then
      VAR !allElements COLL ALL $!type WITH $!filter

    else
      VAR !allElements COLL ALL $!type WITH $!filter FOR $!elemRefe

    endif

  endif

  -- HVAC Spools
  if (!type.eq('HSPOOL')) then

    if (!elemRefe.hardType.upcase().eq('WORL')) then
      VAR !allElements COLL ALL HSPOOL

    else
      VAR !allElements COLL ALL HSPOOL FOR $!elemRefe

    endif

  endif

  -- HVAC Spool Assemblies and CWAY Assemblies
  if (!type.eq('HVACASMBLY') or !type.eq('CWAYASMBLY')) then

    -- Get all assembly members of the passed element, while checking for the world
    -- The result includes the current element
    if (!elemRefe.hardType.upcase().eq('WORL')) then

      -- Find all Assembly Worlds
      VAR !allAsmblyWorlds COLL ALL ASWL

      -- Add all assemblies for each world
      do !asmblyWorld val !allAsmblyWorlds
        VAR !allElements APPEND COLL ALL ASMBLY WITH $!filter FOR $!asmblyWorld
      enddo

    else
      VAR !allElements COLL ALL ASMBLY WITH $!filter FOR $!elemRefe

    endif

  endif

  -- Turn the array of strings into dbrefs
  if (defined(!allElements)) then

    if (!objectType.upcase().eq('DBREF')) then

      !extractDbref = object BLOCK('!allElements[!evalIndex].dbref()')
      !elements     = !allElements.evaluate(!extractDbref)

    else
      !elements = !allElements
    endif

  endif

  -- Return the array of dbrefs
  return !elements

endfunction
-- End of function !!isoElements
