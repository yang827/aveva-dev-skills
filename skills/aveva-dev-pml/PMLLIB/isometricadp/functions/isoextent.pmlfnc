--
-- File:            isoextent.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Tests the column entries in a table row for overlap of one to the next
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Row data held in the object ISOSLAB
--    2    R     STRING      The direction of the table build
--    3    R     STRING      The string characters used as the separator between parameters
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] True or False if there is any overlap in the row
--                [2] The modified passed array of row data
--
-------------------------------------------------------------------------
define function !!isoExtent(!row is ARRAY,!dire is STRING, !separator is STRING) is ARRAY

  -- Initialise variables
  !array[1] = false

  -- Determine corner for max extents
  if (!dire.eq('-Y') or !dire.eq('Y')) then
    !curr = 6
    !start = !row[1].reference.xypo.east
  elseif (!dire.eq('-X') or !dire.eq('X')) then
    !curr = 8
    !start = !row[1].reference.xypo.north
  endif

  -- Test each column for overlap of next
  do !index ind !row

    -- Initialise variables
    !column = !row[!index]

    -- Test if column requires checking
    skip if (!column.check.not())

    -- Read current max extent position for checking against the next
    !currMax = !column.extent.split()[!curr]

    -- Calculate end of column position i.e. max for text
    !maxPos = !start + !column.reference.tmrf.:IdpEnd

    -- Compare positions
    if (!currMax.real().gt(!maxPos)) then

      -- Store the fact that there is an overlap
      !array[1] = true
      !column.overlap = true

      -- Split the atext so that it fits into the column
      -- Do this by reducing the length as is quicker than building up
      !atex = !column.reference.atext
      !atexBits = !atex.split($!separator)
      !bitLength = 0
      do !count from !atexBits.size() to 1 by -1

        -- Calculate bit length by which to reduce the atex
        !bitLength = !bitLength + !atexBits[!count].length() + 1

        -- Reduce atex
        !reduced = !atex.substring(1,!atex.length() - !bitLength)

        -- Set slab atex and read new extent
        !!ce = !column.reference
        ATEX '$!reduced'
        var !extent split extent btext

        -- Test the new extent against the next
        if (!extent[!curr].real().leq(!maxPos)) then
          !column.btext[1] = !reduced
          !column.btext[2] = !atex.after(!reduced)
          break
        endif

      enddo

    endif

    -- Reset the object to hold the new data
    !row[!index] = !column

  enddo

  -- Store the object array in the return variable
  !array[2] = !row

  return !array

endfunction
