-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Gets data about the passed db name, in particular the RW access
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Database name
--
-- Return:
--   [Data Type] [Description]
--    DB          Database object
--                Holds the MODE in the description
--
------------------------------------------------------------------------
define function !!isoFindDb(!dbName is STRING) is DB

  -- Read current session
  !session = current session
  !mdb     = !session.mdb()
  !dbs     = !mdb.current()

  -- Find the passed db
  do !index ind !dbs
    !db = !dbs[!index]
    break if (!db.name.eq(!dbName))
  enddo

  return !db

endfunction
