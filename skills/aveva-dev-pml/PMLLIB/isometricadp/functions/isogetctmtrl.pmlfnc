--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Gets the owning CTMTRL of a cable way component
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The component being tested
--
-- Return:
--   [Data Type] [Description]
--    DBREF       Reference of owning CTMTRL
--
-------------------------------------------------------------------------
define function !!isoGetCtmtrl(!compRefe is DBREF) is DBREF

  -- Initialise components
  !owne         = !compRefe.owne
  !owneOwne     = !compRefe.owne.owne
  !owneOwneOwne = !compRefe.owne.owne.owne
  !ctmtrl       = object DBREF()

  -- Test for owner
  if (!owne.type.upcase().eq('CTMTRL')) then
    !ctmtrl = !owne

  -- Test owner of owner
  elseif (!owneOwne.type.upcase().eq('CTMTRL')) then
    !ctmtrl = !owneOwne

  -- Test owner of owner of owner
  elseif (!owneOwneOwne.type.upcase().eq('CTMTRL')) then
    !ctmtrl = !owneOwneOwne

  endif

  return !ctmtrl

endfunction
