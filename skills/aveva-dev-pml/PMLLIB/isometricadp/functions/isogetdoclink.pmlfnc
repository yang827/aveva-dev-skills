-- File:            isogetdoclink.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Get document links between elements
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Either an HVAC or CWAY design element or a DRWG element
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] The Linked element
--                [2] The Link Descriptor
--
------------------------------------------------------------------------
define function !!isoGetDocLink(!elementRefe is DBREF) is ARRAY

  -- Initialise variables
  !linkRefe = object DBREF()
  !linkDesc = object DBREF()

  -- Get link descriptors for the passed element
  !allLndesc = !elementRefe.lnkdoc

  -- For a design element get the linked isometric drawing
  if (!elementRefe.type.upCase().eq('HVAC') or !elementRefe.type.upCase().eq('CWAY')) then

    -- For each link descriptor
    do !lndesc val !allLndesc

      -- Get linked drawing
      !linkRefe = !lndesc.lnkref

      -- Test for a link to external document
      skip if (!lndesc.url.match('file:').neq(0))

      -- For a link to an internal document and the link reference is bad then use this if no other is found pointing to a DRWG
      if (!linkRefe.badref()) then
        !linkDesc = !lndesc

      else

        -- Test linkref for an isometric drawing
        -- We will be taking the first one found here, but this should be OK since there is supposedly a 1:1 relationship
        if (!linkRefe.type.upCase().eq('DRWG') and !linkRefe.spPurp.eq('ISOADP')) then
          !linkDesc = !lndesc
          break

        endif

      endif

    enddo

  -- For a drawing get the linked assembly
  elseif (!elementRefe.hardtype.upCase().eq('DRWG')) then

    -- For each link descriptor
    do !lndesc val !allLndesc

      -- Initialise variables
      !linkDesc = !lndesc
      !found    = false

      -- For each linked element
      do !lnkele val !lndesc.lnkele

        -- Test linkref for an assembly
        -- We will be taking the first one found here, but this should be OK since there is supposedly a 1:1 relationship
        if (!lnkele.hardtype.upCase().eq('HVAC') or !lnkele.hardtype.upCase().eq('CWAY')) then
          !linkRefe = !lnkele
          !found    = true
          break
        endif

      enddo

      break if (!found)

    enddo

  endif

  -- Build array
  !array[1] = !linkRefe
  !array[2] = !linkDesc

  return !array

endfunction
-- End of function !!isoGetDocLink
