--
-- File:            isogetspec.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Finds the pipe & insulation specification for the current and the
-- next element, across connection references if required
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       All components in the drawlist
--    2    R     REAL        Index position in array from argument 1 of the passed component
--    3    R     DBREF       Reference of the component to check
--    4    R     STRING      Specification type to check for
--    5    R     RULE        Rule
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Centre of gravity as a STRING
--                [2] Total weight as a STRING
--
------------------------------------------------------------------------
define function !!isoGetSpec(!allComp is ARRAY,!index is REAL,!compRefe is DBREF,!spec is STRING,!drawlists is ARRAY,!sht is REAL, !rule is STRING) is ARRAY

  -- Get current spec
  if (!spec.eq('PSPE')) then
    !currSpec = FLNN OF SPEC OF SPREF OF $!compRefe

  elseif (!spec.eq('DSCODE')) then
    !currSpec = !compRefe.owne.dSCode

  elseif (!spec.eq('ISPE')) then

    !currSpec = !compRefe.ispe.flnn
      handle (2,754) (2,759)
        !currSpec = ''
      endhandle

    !currThick = !compRefe.ipara[1] / 2
      handle (2,754) (2,201)
        !currThick = 0
      endhandle

  endif

  -- Check for position of component in member list
  if (!compRefe.order.eq(1)) then

    -- Check head reference
    if (!compRefe.owne.href.badRef().not()) then

      -- Get href
         !href = !compRefe.owne.href

      -- Test type of href
      if (!compRefe.owne.href.type.upCase().eq('BRAN')) then

        -- Find the last href component
        !last = !compRefe.owne.href.mcount

        -- Check for empty branch
        if (!last.eq(0)) then
          !otherSpec = ''
          !otherThick = 0

        else

          -- Get the last href component
          VAR !firstMem COLL ALL WI SEQUENCE EQ $!last FOR $!href

          -- Test drawing type
          if (!spec.eq('PSPE')) then
            !otherSpec = FLNN OF SPEC OF SPREF OF $!firstMem[1]

          elseif (!spec.eq('DSCODE')) then
            !otherSpec = !compRefe.owne.href.dSCode

          elseif (!spec.eq('ISPE')) then

            !otherSpec = !firstMem[1].dbref().ispe.flnn
              handle (2,754)
                !otherSpec = ''
              endhandle

          !otherThick = !firstMem[1].dbref().ipara[1] / 2
            handle (2,754)
              !otherThick = 0
            endhandle

          endif

        endif

      else

        if (!spec.eq('PSPE')) then
          !otherSpec = FLNN OF SPEC OF SPREF OF $!href

        elseif (!spec.eq('DSCODE')) then
          !otherSpec = !compRefe.owne.href.owne.dSCode
            handle (2,201)
              -- Element does not have attribute DSCO
              !otherSpec = ''
            endhandle

        elseif (!spec.eq('ISPE')) then

          !otherSpec = !compRefe.owne.href.ispe.flnn
            handle (2,754) (2,759)
              !otherSpec = ''
            endhandle

          !otherThick = !compRefe.owne.href.ipara[1] / 2
            handle (2,754) (2,759)
              !otherThick = 0
            endhandle

        endif

      endif

    else

      !otherSpec = !currSpec

      if (!spec.eq('ISPE')) then
        !otherThick = !currThick
      endif

    endif

  elseif (!compRefe.order.eq(!compRefe.owne.mcount)) then

    -- Check tail reference
    if (!compRefe.owne.tref.badRef().not()) then

      -- Get tref
        !tref = !compRefe.owne.tref

      -- Test type of tref
      if (!compRefe.owne.tref.type.upCase().eq('BRAN')) then

        -- Get the first tref component
        VAR !lastMem COLL ALL WI SEQUENCE EQ 1 FOR $!tref

        -- Test drawing type
        if (!spec.eq('PSPE')) then
          !otherSpec = FLNN OF SPEC OF SPREF OF $!lastMem[1]

        elseif (!spec.eq('CTSPE')) then
          !otherSpec = FLNN OF CTSPE OF CTMTRL 1 OF OWNER OF OWNER OF POSREF OF $!lastMem[1]

        elseif (!spec.eq('DSCODE')) then
          !otherSpec = !compRefe.owne.tref.dSCode

        elseif (!spec.eq('ISPE')) then

          !otherSpec = !lastMem[1].dbref().ispe.flnn
            handle (2,754)
              !otherSpec = ''
            endhandle

          !otherThick = !lastMem[1].dbref().ipara[1] / 2
            handle (2,754)
              !otherThick = 0
            endhandle

        endif

      else

        if (!spec.eq('PSPE')) then
          !otherSpec = FLNN OF SPEC OF SPREF OF $!tref

        elseif (!spec.eq('CTSPE')) then
          !otherSpec = FLNN OF CTSPE OF CTMTRL 1 OF OWNER OF OWNER OF POSREF OF $!tref

        elseif (!spec.eq('DSCODE')) then
          !otherSpec = !compRefe.owne.tref.owne.dSCode

        elseif (!spec.eq('ISPE')) then

          !otherSpec = !compRefe.owne.tref.ispe.flnn
            handle (2,754)
              !otherSpec = ''
            endhandle

          !otherThick = !compRefe.owne.tref.ipara[1] / 2
            handle (2,754)
              !otherThick = 0
            endhandle

        endif

      endif

    else

      !otherSpec = !currSpec

      if (!spec.eq('ISPE')) then
        !otherThick = !currThick
      endif

    endif

  else

    -- Test for next component on the next sheet, the sheets having been split by the limits box
    if (!index.eq(!allComp.size())) then
      !nextDrawList = !drawlists[!sht + 1]
      !nextComp = IDNM OF ADDE 1 OF $!nextDrawList

    else
      !nextComp = !allComp[!index + 1]

    endif

    -- Test next component
    if (!spec.eq('PSPE')) then
      !otherSpec = FLNN OF SPEC OF SPREF OF $!nextComp

    elseif (!spec.eq('CTSPE')) then
      !otherSpec = FLNN OF CTSPE OF CTMTRL OF $!nextComp
        handle (2,102)
          !otherSpec = 'Unset'
        endhandle

    elseif (!spec.eq('DSCODE')) then
      !otherSpec = !currSpec

    elseif (!spec.eq('ISPE')) then

      !otherSpec = !nextComp.ispe.flnn
        handle (2,754) (2,759)
          !otherSpec = ''
        endhandle

      !otherThick = !nextComp.ipara[1] / 2
        handle (2,754) (2,201)
          !otherThick = 0
        endhandle

    endif

  endif

  -- Return the two specs having extracted the representative part
  !array[1] = !currSpec
  !array[2] = !otherSpec

  if (!spec.eq('ISPE')) then
    !array[3] = !currThick
    !array[4] = !otherThick

  else
    !array[3] = !currSpec$!rule
    !array[4] = !otherSpec$!rule

  endif

  return !array

endfunction
