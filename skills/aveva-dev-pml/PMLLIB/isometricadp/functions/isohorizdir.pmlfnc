-- File:            isohorizdir.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Calculates the horizontal direction between two component ppoints
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The first component reference
--    2    R     REAL        The first component ppoint
--    3    R     DBREF       The second component reference
--    4    R     REAL        The second component ppoint
--
-- Return:
--   [Data Type] [Description]
--    STRING      Description of the continuation.
-------------------------------------------------------------------------
define function !!isoHorizDir(!first is DBREF, !one is REAL, !second is DBREF, !two is REAL) is STRING

  -- Initialise variables
  !format    = object FORMAT()
  !format.dp = 2

  -- In case points are superimposed
  !secondPos = !second.pposition[!two].offset(!second.pdirection[!two],10)

  -- Get direction between the first and second elements
  !direction = !first.pposition[!one].direction(!secondPos)
  !dimnDir   = !direction.string(!format).before(' WRT')
  !dir       = !dimnDir.split()
  !angle     = !dir.size()

  -- Return the horizontal direction
  if (!angle.eq(5)) then
    !dimnLineDir = !dir[1] & !dir[2].real().nint() & !dir[3]

  elseif (!angle.eq(3)) then

    if (!direction.up.eq(1) or !direction.up.eq(-1)) then
      !dimnLineDir = !dir[1]

    else
      !dimnLineDir = !dir[1] & !dir[2].real().nint() & !dir[3]

    endif

  else
    !dimnLineDir = !dir[1]

  endif

  return !dimnLineDir

endfunction
