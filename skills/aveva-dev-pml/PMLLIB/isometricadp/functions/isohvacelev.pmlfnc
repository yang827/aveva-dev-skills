--
-- File:            isohvacelev.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the elevation labels
-- Only creates a label when the elevation changes
--
-- Assumptions:
-- The current element is the layer
--
-- Logic for tagging:
-- All BEND elements at P0
-- All BRCO elements at P3
-- All sub elements at P0
-- All elements whose PL is different from the PA at the PL
-- Elements in the vertical depend on the defaults switch
--
-- For information:
-- The template references array is in the following order;
-- [1] All connections [2] BRCO only
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       The components in the drawlist
--    2    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoHvacElev(!allComp is ARRAY, !data is ISODEFAULTS)

  -- Initialise variables
  !elevLaye      = !!ce
  !templateRefes = !data.hvacElevTag.tempArray
  !code          = !data.hvacElevTag.code
  !offset        = !data.hvacElevTag.offset[1].queryString() & ' ' & !data.hvacElevTag.offset[2].queryString()
  !tColour       = !data.hvacElevTag.tColour
  !fColour       = !data.hvacElevTag.fColour
  !fStyle        = !data.hvacElevTag.fStyle & !data.hvacElevTag.fThickness.replace('Thin','')
  !cHei          = !data.hvacElevTag.cHei.queryString()
  !keep          = ARRAY()

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- Clean any bad references
  DELETE NULL ANNO
    handle (64,353)
      -- n elements with null or illegal DDNM attributes have been deleted
    endhandle

  -- Get all existing labels
  VAR !existTags COLL ALL (SLAB GLAB) FOR CE
  VAR !existRefe EVAL REFE OF DDNM FOR ALL FROM !existTags

  -- For each component
  do !index ind !allComp

    -- Initialise variables
    !compRefe = !allComp[!index]
    !compType = !compRefe.type.upCase()

    -- Test for BEND
    if (!compType.eq('BEND')) then

      -- Determine atex string
      !hashCode = !code.replace('P3',!data.hvacElevTag.bendConn)

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!compRefe.string())
      if (!find.unset()) then

        -- Create a coordinate label
        NEW SLAB ON $!<data.hvacElevTag.bendConn> OF $!compRefe ATEX |$!hashCode|
         TMRF $!templateRefes[1] XYPO $!offset OSET TRUE CHEI $!cHei BLNK TRUE
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

        -- Keep this one
        !keep.append(!!ce.string())

      else

        -- Modify the existing
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ON $!<data.hvacElevTag.bendConn> OF $!compRefe ATEX |$!hashCode| TMRF $!templateRefes[1]

      endif

      -- Done
      skip

    endif

    -- Test for an Access Way
    if (!compType.eq('HACC')) then

      -- Determine atex string
      !hashCode = !code.replace('P3','P0')

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!compRefe.string())
      if (!find.unset()) then

        -- Create a coordinate label
        NEW SLAB ON $!compRefe ATEX |$!hashCode|
         TMRF $!templateRefes[1]  XYPO $!offset  OSET TRUE  CHEI $!cHei  BLNK TRUE
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

        -- Keep this one
        !keep.append(!!ce.string())

      else

        -- Modify the existing
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ATEX |$!hashCode| TMRF $!templateRefes[1]

      endif

      -- Done
      skip

    endif

    -- Find whether the component is a sub-component i.e. test for a full-stop in the item number
    if (!compRefe.desp[31].string().match('.').neq(0) and !compType.neq('BRCO') and !compType.neq('TEE') and !compType.neq('STIF')) then

      -- Determine atex string
      !hashCode = !code.replace('P3',!data.hvacElevTag.subConn)

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!compRefe.string())
      if (!find.unset()) then

        -- Create a coordinate label
        NEW SLAB ON $!<data.hvacElevTag.subConn> OF $!compRefe ATEX |$!hashCode|
         TMRF $!templateRefes[1]  XYPO $!offset  OSET TRUE  CHEI $!cHei BLNK TRUE
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

         !keep.append(!!ce.string())

      else
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ON $!<data.hvacElevTag.subConn> OF $!compRefe ATEX |$!hashCode| TMRF $!templateRefes[1]
      endif

      -- Done
      skip

    endif

    -- Test for component in the vertical
    -- To do this we are looking for when both the arrive and leave directions have an UP component
    if (!compRefe.aDir.up.neq(0) and !compRefe.lDir.up.neq(0)) then

      -- Label this component when the defaults switch is ON
      if (!data.hvacElevTag.vertOn) then

        -- Determine atex string
        !hashCode = !code.replace('P3',!data.hvacElevTag.vertConn)

        -- Check is a label already exists for this component
        !find = !existRefe.findFirst(!compRefe.string())
        if (!find.unset()) then

          -- Create a coordinate label
          NEW SLAB ON $!<data.hvacElevTag.vertConn> OF $!compRefe ATEX |$!hashCode|
           TMRF $!templateRefes[1]  XYPO $!offset  OSET TRUE  CHEI $!cHei  BLNK TRUE
           TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

           !keep.append(!!ce.string())

        else
          !keep.append(!existTags[!find])
          !!ce = !existTags[!find].dbref()
          ON $!<data.hvacElevTag.vertConn> OF $!compRefe ATEX |$!hashCode| TMRF $!templateRefes[1]
        endif

      endif

      -- Done
      skip

    endif

    -- Finish here if this is the last component.
    -- The end will be dealt with by the continuation label
    skip if (!index.eq(!allComp.size()))

    -- Test for component PL different to the PA in the HORIZONTAL
    -- To do this we can compare the direction of the PA with the direction of the PA to the PL
    if (!!isoOffset(!compRefe,true)) then

      -- Determine atex string
      !hashCode = !code.replace('P3','P' & !compRefe.lea)

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!compRefe.string())
      if (!find.unset()) then

        -- Create a coordinate label
        NEW SLAB ON PL OF $!compRefe ATEX |$!hashCode|
         TMRF $!templateRefes[1]  XYPO $!offset  OSET TRUE  CHEI $!cHei  BLNK TRUE
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

         !keep.append(!!ce.string())

      else
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ATEX |$!hashCode| TMRF $!templateRefes[1]
      endif

    endif

  enddo

  -- Remove any unwanted existing labels
  !remove = !existTags.difference(!keep)
  do !delete val !remove
    !!ce = !delete.dbref()
    DELETE $!!<ce.type>
  enddo

  -- Return to laye
  !!ce = !elevLaye
  UPDATE ANNO

endfunction
