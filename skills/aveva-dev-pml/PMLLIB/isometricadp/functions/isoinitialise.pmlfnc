-- File:            isoinitialise.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
-- Description:
-- Isometric ADP Application Initialisation
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The action to be carried out after the application load
--                             MAIN  - display the main form
--                             EDIT  - display the edit form
--                             LOG   - display the log file
--                             TOOLS - display the defaults form
--                             PRINT - display the multi-print form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!isoInitialise(!action is STRING)

  -- Load the application if necessary
  if (undefined(!!isoMain)) then

  	-- Start the application
    !errors = !!isoDraStartup()

    -- Stop if there are any errors
    if (!errors) then
    	!!isoDflts.show(|cen|,0.5,0.5)
    	return
    endif

  else

    -- Test for unloaded application, in which case display the defaults form
    if (!!isoMain.isoAdpApp.active.not()) then
    	
    	-- For an administrator display the defaults form
    	if (!!cdAdmin.boolean()) then
    	  !!isoDflts.show(|cen|,0.5,0.5)

      -- For a non-administrator user put out a message
      else
        !!alert.warning('The Isometric ADP application has not loaded correctly due to some missing elements. Please contact your System Administrator.')

      endif
    	
    	-- Stop here
      return

    endif

  endif

  -- The application has been activated
  if (!!isoMain.isoAdpApp.token.eq(false)) then
    !!isoMain.isoAdpApp.setActive(!!isoMain.isoAdpApp.license(2))
  endif

  -- Carry out the required action
  if (!action.eq('MAIN')) then

  	-- Show the main form
  	!!isoMain.show(|cen|,0.5,0.5)
  	handle any
  		!!isoDflts.show(|cen|,0.5,0.5)
  	endhandle

  elseif (!action.eq('EDIT')) then

  	-- Display the edit form
  	!!isoEdit.show(|cen|,0.5,0.5)

  elseif (!action.eq('LOG')) then

  	-- Display the log
  	!!isoEdit.displayLog('OPEN')

  elseif (!action.eq('TOOLS')) then

  	-- Display the defaults form
  	!!isoMain.isoAdpApp.showTools()

  elseif (!action.eq('PRINT')) then

  	-- Display the multi-print form
  	!!isoPrint.show()

  endif

endfunction
-- End of function !!isoInitialise
