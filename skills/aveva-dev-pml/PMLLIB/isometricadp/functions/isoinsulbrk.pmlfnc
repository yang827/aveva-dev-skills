--
-- File:            isoinsulbrk.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates an insulation break symbol when a change in insulation is found
--
-- Assumptions:
-- The current element is the layer
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       The components in the drawlist
--    2    R     STRING      The type of drawing being processed, HVAC or ELEC
--    3    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoInsulBrk(!allComp is ARRAY, !type is STRING, !drawLists is ARRAY,!sht is REAL, !data is ISODEFAULTS)

  -- Initialise variables
  !gadget   = !type & 'InsulBrk'
  !elevLaye = !!ce
  !template = !data.$!gadget$N.template
  !offset   = !data.$!gadget$N.offset[1].queryString() & ' ' & !data.$!gadget$N.offset[2].queryString()
  !tColour  = !data.$!gadget$N.tColour
  !fColour  = !data.$!gadget$N.fColour
  !fStyle   = !data.$!gadget$N.fStyle & !data.$!gadget$N.fThickness.replace('Thin','')
  !rule     = !data.$!type$NSpecBrk.rule

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- For each component
  do !index ind !allComp

    -- Initialise variables
    !compRefe = !allComp[!index]

    -- Get the spec of the current and next component
    !specs = !!isoGetSpec(!allComp, !index, !compRefe,'ISPE', !drawLists, !sht, !rule)

    -- Test for change in spec
    if (!specs[3].neq(!specs[4])) then

      -- Determine ppoint
      if (!index.eq(1)) then
        !pPoint = 'PA'
      else
        !pPoint = 'PL'
      endif

      -- Test for zero thickness
      if (!specs[3].eq(0)) then
        !thick1 = '   '
          handle (2,761)
            !thick1.delete()
            !thick1 = '   '
          endhandle
      else
        !thick1 = !specs[3]
          handle (2,761)
            !thick1.delete()
            !thick1 = !specs[3]
          endhandle
      endif
      if (!specs[4].eq(0)) then
        !thick2 = '   '
          handle (2,761)
            !thick2.delete()
            !thick2 = '   '
          endhandle
      else
        !thick2 = !specs[4]
          handle (2,761)
            !thick2.delete()
            !thick2 = !specs[4]
          endhandle
      endif

      -- Create atex string
      !atex = !thick1 & '   ' & !thick2

      -- Create a named label
      NEW SLAB ON $!pPoint OF $!compRefe ATEX |$!atex|
        TMRF $!template  XYPO $!offset  OSET TRUE  BLNK TRUE
        TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

    endif

  enddo

  -- Return to laye
  !!ce = !elevLaye

endfunction
