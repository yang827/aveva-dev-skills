--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Set the maximum number of entries in the TABLE object for the mto table
-----------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      The type of drawing being processed, HVAC or CWAY
--    2    R     DBREF       The backing sheet
--    3    R     DBREF       The Isometric ADP library
--
-- Return:
--   [Data Type] [Description]
--    REAL        The number of entries
--
-----------------------------------------------------------------------------
define function !!isoMaxMtoEntries(!runType is STRING, !backingSheet is DBREF, !library is DBREF) is REAL

  -- Get note that owns the reserved areas
  VAR !allNotes COLL ALL NOTE WI SPPURP EQ 'TABLE' FOR $!backingSheet

  -- Read mto table position
  VAR !rect COLL ALL RECT WI :IdpFunc EQ 'Mto' FOR $!allNotes[1]
  !table = object ISORECTANGLE(!rect[1].dbref())

  -- Get discipline data
  -- HVAC
  if (!runType.eq('HVAC')) then

    -- Get table template libraries
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Hvac Mto Table Template' FOR $!library

  -- CWAY
  else
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Cway Mto Table Template' FOR $!library

  endif

  -- Read table build direction and movement
  !move = !entryLib[1].dbref().:IdpMove
  !dire = !entryLib[1].dbref().:IdpDire

  -- Get max number of entries
  !table.max(!move)

  -- Get relevant table corner move, position expression and max number of entries
  if (!dire.eq('-Y')) then
    !maxEntries = !table.maxY
  elseif (!dire.eq('Y')) then
    !maxEntries = !table.maxY
  elseif (!dire.eq('-X')) then
    !maxEntries = !table.maxX
  elseif (!dire.eq('X')) then
    !maxEntries = !table.maxX
  endif

  return !maxEntries.value()

endfunction
