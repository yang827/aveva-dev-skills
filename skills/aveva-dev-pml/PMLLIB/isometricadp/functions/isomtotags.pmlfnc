--
-- File:            isomtotags.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates the mto position tags that relate to the table entries
-- The output numbers depends on whether or not a cell has been sorted
--
-- Assumptions:
-- The ce is the mto position tag laye
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of entry objects one for each row in the table
--    2    R     STRING      Type of drawing being processed (HVAC or PIPE)
--    3    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoMtoTags(!entries is ARRAY, !runType is STRING, !data is ISODEFAULTS)

  -- Initialise variables
  !elevLaye = !!ce
  !keep     = ARRAY()

  -- Clean any bad references
  DELETE NULL ANNO
    handle (64,353)
      -- n elements with null or illegal DDNM attributes have been deleted
    endhandle

  -- Get all existing labels
  VAR !existTags COLL ALL (SLAB GLAB) FOR CE
  VAR !existRefe EVAL REFE OF DDNM FOR ALL FROM !existTags

  -- Get discipline data
  if (!runType.eq('HVAC')) then

    -- Get the local template reference and other data
    !localRefe = !data.hvacMtoGen.template
    !offset    = !data.hvacMtoGen.offset[1].queryString() & ' ' & !data.hvacMtoGen.offset[2].queryString()
    !tColour   = !data.hvacMtoGen.tColour
    !fColour   = !data.hvacMtoGen.fColour
    !fStyle    = !data.hvacMtoGen.fStyle & !data.hvacMtoGen.fThickness.replace('Thin','')
    !sorted    = !data.hvacMtoGen.sorted

    -- Get mto table templates
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Hvac Mto Table Template' FOR $!data.stdLibrary
    VAR !allCells EVAL :IdpDesc FOR ALL SYTM WI :IdpPurp EQ 'Entry' FOR $!entryLib[1]

  else

    -- Get the local template reference and other data
    !localRefe = !data.elecMtoGen.template
    !offset    = !data.elecMtoGen.offset[1].queryString() & ' ' & !data.elecMtoGen.offset[2].queryString()
    !tColour   = !data.elecMtoGen.tColour
    !fColour   = !data.elecMtoGen.fColour
    !fStyle    = !data.elecMtoGen.fStyle & !data.hvacMtoGen.fThickness.replace('Thin','')
    !sorted    = !data.elecMtoGen.sorted

    -- Get mto table templates
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Cway Mto Table Template' FOR $!<data.stdLibrary>
    VAR !allCells EVAL :IdpDesc FOR ALL SYTM WI :IdpPurp EQ 'Entry' FOR $!entryLib[1]

  endif

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- Build the local tags
  do !index ind !entries

    -- Read position number
    if (!sorted) then
      !posNumber = !index
    else
      -- Find column that holds the position number & extract data
      !posn      = !allCells.findFirst('POSITION')
      !posNumber = !entries[!index].c$!posn
    endif

    -- Create label
    do !compRefe val !entries[!index].dbRefes

      -- Check is a label already exists for this component
      !find = !existRefe.findFirst(!compRefe.string())
      if (!find.unset()) then

        -- Create new
        NEW SLAB ON $!compRefe ATEX |$!posNumber|
         TMRF $!localRefe  XYPO $!offset  OSET TRUE  BLNK TRUE
         TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

         !keep.append(!!ce.string())

      else

        -- Modify the existing
        !keep.append(!existTags[!find])
        !!ce = !existTags[!find].dbref()
        ATEX |$!posNumber| TMRF $!localRefe

      endif

    enddo

  enddo

  -- Remove any unwanted existing labels
  !remove = !existTags.difference(!keep)
  do !delete val !remove
    !!ce = !delete.dbref()
    DELETE $!!<ce.type>
  enddo

  -- Return to laye
  !!ce = !elevLaye
  UPDATE ANNO

endfunction
