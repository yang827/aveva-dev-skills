--
-- File:            isonamed.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates labels to indicate a named component
--
-- Assumptions:
-- The ce is the laye
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       All components in the drawlist
--    2    R     STRING      Type of drawing being processed (HVAC or PIPE)
--    3    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoNamed(!allComp is ARRAY, !type is STRING, !data is ISODEFAULTS)

  -- Initialise variables
  !elevLaye = !!ce
  !keep     = ARRAY()

  -- Get default data
  -- Hvac
  if (!type.eq('HVAC')) then
    !template = !data.hvacNamedTag.template
    !offset   = !data.hvacNamedTag.offset[1].queryString() & ' ' & !data.hvacNamedTag.offset[2].queryString()
    !tColour  = !data.hvacNamedTag.tColour
    !fColour  = !data.hvacNamedTag.fColour
    !fStyle   = !data.hvacNamedTag.fStyle & !data.hvacNamedTag.fThickness.replace('Thin','')
    !cHei     = !data.hvacNamedTag.cHei.queryString()

  -- Cway
  else
    !template = !data.elecNamedTag.template
    !offset   = !data.elecNamedTag.offset[1].queryString() & ' ' & !data.elecNamedTag.offset[2].queryString()
    !tColour  = !data.elecNamedTag.tColour
    !fColour  = !data.elecNamedTag.fColour
    !fStyle   = !data.elecNamedTag.fStyle & !data.elecNamedTag.fThickness.replace('Thin','')
    !cHei     = !data.elecNamedTag.cHei.queryString()

  endif

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- Clean any bad references
  DELETE NULL ANNO
    handle (64,353)
      -- n elements with null or illegal DDNM attributes have been deleted
    endhandle

  -- Get all existing labels
  VAR !existTags COLL ALL (SLAB GLAB) FOR CE
  VAR !existRefe EVAL REFE OF DDNM FOR ALL FROM !existTags

  -- For each component
  do !index ind !allComp

    -- Initialise variables
    !compRefe = !allComp[!index]

    -- Test if component is unnamed or unsuitable
    skip if (!compRefe.name.subString(1,1).eq('='))
    skip if (!compRefe.type.upcase().eq('POINTR'))

    -- Test if named with the item number for hvac
    if (!type.upcase().eq('HVAC')) then
      if (!compRefe.desp[31].neq(0)) then
        skip if (!compRefe.name.match(!compRefe.desp[31].string()).neq(0))
      endif
    endif

    -- Check is a label already exists for this component
    !find = !existRefe.findFirst(!compRefe.string())
    if (!find.unset()) then

      -- Create a named label
      NEW SLAB ON $!compRefe
        TMRF $!template  XYPO $!offset  OSET TRUE  CHEI $!cHei  BLNK TRUE
        TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

      -- Keep this one
      !keep.append(!!ce.string())

    else
      !keep.append(!existTags[!find])
      !!ce = !existTags[!find].dbref()
      TMRF $!template
    endif

  enddo

  -- Remove any unwanted existing labels
  !remove = !existTags.difference(!keep)
  do !delete val !remove
    !!ce = !delete.dbref()
    DELETE $!!<ce.type>
  enddo

  -- Return to laye
  !!ce = !elevLaye
  UPDATE ANNO

endfunction
