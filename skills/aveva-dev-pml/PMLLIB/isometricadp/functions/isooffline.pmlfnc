--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
-- Description:
-- Determines whether a component is on or off the centreline
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Component reference
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Whether or not the passed component is off the centreline
--
------------------------------------------------------------------------
define function !!isoOffline(!compRefe is DBREF) is BOOLEAN

  -- Initialise variables
  !offline = false

  -- Check sumperimposed arrive and leave, which is an indicator of being offline
  if (!compRefe.ppos[!compRefe.arr].eq(!compRefe.ppos[!compRefe.lea])) then

    -- If the origin in not the same as either the leave or arrive then we are offline
    if (!compRefe.ppos[0].neq(!compRefe.ppos[!compRefe.arr]) and !compRefe.ppos[0].neq(!compRefe.ppos[!compRefe.lea])) then

      !offline = true

    endif

  endif

  return !offline

endfunction
