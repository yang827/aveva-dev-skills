--
-- File:            isooffset.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Determines whether a component is "straight through" or
-- has an offset between the arrive and leave positions
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Component reference
--    2    R     BOOLEAN     Whether an accurate check is made to 4 decimal places or to the nearest integer
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Whether or not the passed component has an offset
--
------------------------------------------------------------------------
define function !!isoOffset(!component is DBREF, !accurate is BOOLEAN) is BOOLEAN

  -- Determine the arrive and leave points depending on discipline
  -- HVAC
  if (!component.owne.type.upcase().eq('BRAN')) then
    !arrive = !component.arrive
    !leave  = !component.leave

  -- CWAY
  else
    !arrive = !component.arrive
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pA PA OF $!component
        !arrive = !pA.split()[2].real()
      endhandle

    !leave  = !component.leave
      handle (2,201)
        -- Element does not have attribute ARRI
        VAR !pL PL OF $!component
        !leave = !pL.split()[2].real()
      endhandle

  endif

  -- In case points are superimposed
  !leavePos = !component.pposition[!leave].offset(!component.pdirection[!leave],10)

  -- Get direction opposite to arrive point and direction from PA to PL
  !oppositePA = !component.pdirection[!arrive].opposite()
  !dirPAToPL  = !component.pposition[!arrive].direction(!leavePos)

  -- If the component is orientated in the world at a compound angle,
  -- then PML gets the direction PA to PL wrong by a very small amount but enough to get the comparison wrong.
  -- Therefore, have to set the precision on each vector before the comparison
  if (!accurate) then

    !oppositePA.up    = !oppositePA.up.string('D4').real()
    !oppositePA.east  = !oppositePA.east.string('D4').real()
    !oppositePA.north = !oppositePA.north.string('D4').real()

    !dirPAToPL.up     = !dirPAToPL.up.string('D4').real()
    !dirPAToPL.east   = !dirPAToPL.east.string('D4').real()
    !dirPAToPL.north  = !dirPAToPL.north.string('D4').real()

  else

    !oppDir = !oppositePA.string().before(' WRT')
    !opp    = !oppDir.split()
    if (!opp.size().eq(5)) then
      !oppositePA = object DIRECTION(!opp[1] & !opp[2].real().nint().string() & !opp[3] & !opp[4].real().nint().string() & !opp[5])
    elseif (!opp.size().eq(3)) then
      !oppositePA = object DIRECTION(!opp[1] & !opp[2].real().nint().string() & !opp[3])
    else
      !oppositePA = object DIRECTION(!opp[1])
    endif

    !dirDir = !dirPAToPL.string().before(' WRT')
    !dir    = !dirDir.split()
    if (!dir.size().eq(5)) then
      !dirPAToPL = object DIRECTION(!dir[1] & !dir[2].real().nint().string() & !dir[3] & !dir[4].real().nint().string() & !dir[5])
    elseif (!opp.size().eq(3)) then
      !dirPAToPL = object DIRECTION(!dir[1] & !dir[2].real().nint().string() & !dir[3])
    else
      !dirPAToPL = object DIRECTION(!dir[1])
    endif

  endif

  -- Test if direction opposite to the PA is the same as that from the PA to the PL
  -- If equal the component is straight through
  -- If unequal the component PL is offset from the PA
  if (!oppositePA.eq(!dirPAToPL)) then
    !offset = false
  else
    !offset = true
  endif

  return !offset

endfunction
