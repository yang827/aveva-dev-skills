-- File:            isoorientation.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
-- Description:
-- Determines an axis orthogonal to the centreline of the passed component
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL        P-point number
--    2    R     DBREF       Component reference
--
-- Return:
--   [Data Type] [Description]
--    STRING     An axis direction orthogonal to the centreline direction
--
------------------------------------------------------------------------
define function !!isoOrientation(!pPoint is REAL, !compRefe is DBREF) is STRING

  -- Initialise variables
  !worl       = WORL OF $!compRefe
  !ppDir      = !compRefe.pdir[!pPoint].wrt(!worl)
  !orthogonal = object DIRECTION()

  -- Create at plane at the component arrive point
  !plane = object PLANE(!compRefe.ppos[!pPoint].wrt(!worl), !compRefe.ori.wrt(!worl))

  -- Find which axis is parallel to the p-point direction
  -- X axis
  if (!plane.orientation.xdir().eq(!ppDir) or !plane.orientation.xdir().eq(!ppDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.ydir()

  endif

  -- Y axis
  if (!plane.orientation.ydir().eq(!ppDir) or !plane.orientation.ydir().eq(!ppDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.xdir()

  endif

  -- Z axis
  if (!plane.orientation.zdir().eq(!ppDir) or !plane.orientation.zdir().eq(!ppDir.opposite())) then

  	-- We can use either of the other two
  	!orthogonal = !plane.orientation.xdir()

  endif

  return !orthogonal.string().before('WRT')

endfunction
