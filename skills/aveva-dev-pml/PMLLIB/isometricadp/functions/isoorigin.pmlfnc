--
-- File:            isoorigin.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Adds an origin symbol to the arrive of the first component in the drawlist
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       All components in the drawlist
--    2    R     STRING      The type of drawing being processed, HVAC or PIPE
--    3    R     ISODEFAULTS The defaults settings
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] DBREF       The component
--                [2] POSITION    The component arrive position wrt world
--
------------------------------------------------------------------------
define function !!isoOrigin(!allComp is ARRAY, !type is STRING, !data is ISODEFAULTS) is ARRAY

  -- Get the discipline defaults
  if (!type.upcase().eq('HVAC')) then
    !gadget = 'hvacOrigin'
  else
    !gadget = 'elecOrigin'
  endif

  -- Get the first component data
  !template = !data.$!gadget$N.template
  !fColour  = !data.$!gadget$N.fColour
  !fStyle   = !data.$!gadget$N.fStyle & !data.$!gadget$N.fThickness.replace('Thin','')
  !scale    = !data.$!gadget$N.scale
  !layeRefe = !!ce
  !compRefe = !allComp[1]
  !compType = !compRefe.type.upcase()
  !world    = WORL OF $!compRefe

  -- Get the origin position
  -- HVAC
  if (!type.upcase().eq('HVAC')) then
    !origin = !compRefe.apos.wrt(!world)
    !pPoint = 'P' & !compRefe.arr & ' OF '

  -- CWAY
  else

    -- If the first component is not a CTRAY, try and find one as this is preferable as an origin
    if (!compType.neq('CTRAY')) then

      -- Loop through all components
      do !component val !allComp

        -- Ignore POINTR
        if (!component.type.upcase().neq('POINTR')) then

          -- Use this one for the origin
          !compRefe = !component
          !compType = !compRefe.type.upcase()

          -- Done
          break

        endif

      enddo

    endif

    -- For a ctray
    if (!compType.neq('POINTR') and !compType.neq('GENSEC') and !compType.neq('TMPL')) then

      -- Get the arrive ppoint
      !pArrive = !compRefe.arrive
        handle (2,201)
          -- Element does not have attribute ARRI
          VAR !pA PA OF $!compRefe
          !pArrive = !pA.split()[2].real()
        endhandle

      -- Get the origin position
      !origin  = !compRefe.ppos[!pArrive].wrt(!world)
      !pPoint  = ' PA OF '

    -- If there is no ctray then use the first component as already set
    else

      -- POINTR
      if (!compType.eq('POINTR')) then
        !origin   = !compRefe.pos.wrt(!world)
        !pPoint   = ''

      -- GENSEC
      elseif (!compType.eq('GENSEC')) then
        !origin   = !compRefe.pos.wrt(!world)
        !pPoint   = ''

      -- TEMPL
      elseif (!compType.eq('TMPL')) then

        -- Use the owning CTFEAT or CTRAY
        !compRefe = !compRefe.owne
        !origin   = !compRefe.pos.wrt(!world)
        !pPoint   = ''

        -- Warn that the position may not be on the sheet
        !!isoLog.messages.append('  WARNING: Using ' & !compRefe.name & ' as the origin, which may not be within the sheet boundaries')

      -- Anything else
      else
        !origin   = !compRefe.pos.wrt(!world)
          handle any
            !!isoLog.messages.append('  WARNING: Cannot find an element to use as the origin')
            !origin = object POSITION()
            !pPoint   = ''
            return
          endhandle

      endif

    endif

  endif

  -- Add the origin symbol to the component
  NEW SLAB ON $!pPoint $!compRefe
    handle any
      !!isoLog.messages.append('  WARNING: Error in placing origin at ' & !compRefe.flnm)
    elsehandle none
         TMRF $!template  XYPO 0 0  XYSC $!scale $!scale  LFSTYLE $!fStyle  LFCOLOUR $!fColour  BLNK FALSE
    endhandle

  -- Finish
  !!ce = !layeRefe

  -- Build return array
  !array[1] = !compRefe
  !array[2] = !origin

  return !array

endfunction
