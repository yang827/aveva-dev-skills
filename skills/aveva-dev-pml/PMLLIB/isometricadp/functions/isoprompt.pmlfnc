-- File:            isoprompt.pmlfnc
--   Type:          Function Definition
--   Group:         IsoADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2010
--
--
-- Description:
-- Stream prompt text to relevant device
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING     Display text
--    2    R     REAL       In which row to display on the progress form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!isoPrompt(!text is STRING, !row is REAL)

  -- Determine device
  VAR !device DEVICE

  -- When in graphics mode
  if (!device.upcase().eq('GRAPHICS')) then

    -- Test for dismiss
    if (!text.eq('DISMISS')) then

      -- Clear the prompt text
      PROMPT DISMISS

    else

      -- Prompt the passed text
      PROMPT ON
      PROMPT '$!text'

      -- Stream text to progress form
      if (defined(!!isoProcess)) then

        !!isoProcess.set(!text, !row)

      endif

    endif

  else
    write '$!text'
  endif

endfunction
-- End of function !!isoPrompt(STRING,REAL)
