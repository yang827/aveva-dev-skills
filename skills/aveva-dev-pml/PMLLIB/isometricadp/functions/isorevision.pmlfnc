--
-- File:            isorevision.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Builds the revision history for the sheet
--
-- Assumptions:
-- The ce is the sheet
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      The type of drawing being processed, HVAC or PIPE
--    2    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoRevision(!runType is STRING, !data is ISODEFAULTS)

  -- Initialise variables
  !sheeRefe   = !!ce
  !sheename   = !sheeRefe.flnm
  !tableArray = ARRAY()

  -- Get all revisions for the sheet
  VAR !intRevi COLL ALL REVI WITH :IdpInText EQ 'INT' FOR $!sheeRefe
  VAR !extRevi COLL ALL REVI WITH :IdpInText EQ 'EXT' FOR $!sheeRefe
  VAR !intRvsn EVAL RVSN FOR ALL FROM !intRevi
  VAR !extRvsn EVAL RVSN FOR ALL FROM !extRevi

  !sorted = !intRvsn.sortedIndices()
  !intRevi.reIndex(!sorted)

  !sorted = !extRvsn.sortedIndices()
  !extRevi.reIndex(!sorted)

  !allRevi = !intRevi
  !allRevi.appendArray(!extRevi)

  -- Get the revision table entry template
  if (!runType.eq('HVAC')) then
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Hvac Revision Table Display' FOR $!<data.stdLibrary>

  else
    VAR !entryLib COLL ALL LALB WI FUNC EQ 'Electrical Revision Table Display' FOR $!<data.stdLibrary>

  endif

  -- Read table build direction and movement
  !move = !entryLib[1].dbref().:IdpMove
  !dire = !entryLib[1].dbref().:IdpDire

  -- Get revision block reserved areas
  VAR !allRect COLL ALL RECT WI SPPURP OF OWNE EQ 'TABLE' AND :IdpFunc EQ 'Revision' FOR $!<data.backingSheet>

  do !index ind !allRect

    -- Build table object
    !table       = object ISOTABLE()
    !table.shape = object ISORECTANGLE(!allRect[!index].dbref())

    -- Get max number of entries
    !table.shape.max(!move)

    -- Get relevant table corner move, position expression and max number of entries
    if (!dire.eq('-Y')) then
      !table.corner     = !table.shape.tl
      !table.posCalc    = '!yPos = !yPos - !move'
      !table.maxEntries = !table.shape.maxY

    elseif (!dire.eq('Y')) then
      !table.corner     = !table.shape.bl
      !table.posCalc    = '!yPos = !yPos + !move'
      !table.maxEntries = !table.shape.maxY

    elseif (!dire.eq('-X')) then
      !table.corner     = !table.shape.br
      !table.posCalc    = '!xPos = !xPos - !move'
      !table.maxEntries = !table.shape.maxX

    elseif (!dire.eq('X')) then
      !table.corner     = !table.shape.bl
      !table.posCalc    = '!xPos = !xPos + !move'
      !table.maxEntries = !table.shape.maxX

    endif

    -- Store table
    !tableArray.append(!table)

  enddo

  -- Read cells for text data
  VAR !allText COLL ALL TEXP WI :IdpPurp OF OWNE EQ 'Entry Display' FOR $!entryLib[1]

  -- Delete all old history notes
  VAR !allNote COLL ALL NOTE WI SPPURP Eq 'HISTRY' FOR $!sheeRefe

  do !note val !allNote

    !!ce = !note.dbref()

    DELETE NOTE

  enddo

  -- For each revision, build a table row
  do !index ind !allRevi

    -- Initialise variables
    !revision = !allRevi[!index].dbref().rvsn
    !noteName = !sheename & '/History' & !revision
    !reviName = !allRevi[!index].dbref().flnm

    -- Get table data
    if (!index.leq(!tableArray[1].maxEntries)) then
      !table = !tableArray[1]

    else
      !table = !tableArray[2]

    endif

    -- Test for full tables
    if (!index.gt(!tableArray[1].maxEntries + !tableArray[2].maxEntries)) then

      !!isoLog.messages.append('  Revision Tables are full. No entry made for Rev:' & !revision)
      break

    endif

    -- Get position
    if (!index.eq(1) or !index.eq(!tableArray[1].maxEntries + 1)) then

     -- Read table start point
     !xPos = !table.corner.east
     !yPos = !table.corner.north

    else

      -- Calculate xy position
      $!table.posCalc

    endif

    -- Build the note as the table row
    NEW NOTE $!noteName
     TXCOLOUR 10
     SPPURP HISTRY
     FUNC '$!reviName'

    -- Build cells for each table row
    do !number ind !allText

      -- Initialise variables
      !textRefe = !allText[!number].dbref()

      -- Get text data
      !chei = !textRefe.chei
      !just = !textRefe.just
      !alig = !textRefe.alig

      -- Get the position of the texp element wrt to it's owner
      if (!dire.eq('-Y') or !dire.eq('Y')) then
        !xRel = !textRefe.ptrf.xypo.east - !textRefe.owne.xypo.east
        !yRel = !textRefe.ptrf.xypo.north - !textRefe.owne.xypo.north

      elseif (!dire.eq('-X') or !dire.eq('X')) then
        !xRel = !textRefe.ptrf.xypo.north - !textRefe.owne.xypo.north
        !yRel = !textRefe.ptrf.xypo.east - !textRefe.owne.xypo.east

      endif

      -- Calculate true texp position
      !xTrue = !xPos + !xRel
      !yTrue = !yPos + !yRel

      -- Build hash code string
      !hashString = !allText[!number].dbref().owne.:IdpFunc & '<FR ' & !allRevi[!index] & '>'

      -- Build the text element
      NEW TEXP CHEI $!chei JUST $!just ALIG $!alig
       ORIGIN X $!xTrue Y $!yTrue
       BTEX '$!hashString'

    enddo

  enddo

  -- Return to sheet
  !!ce = !sheeRefe

endfunction
