--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Return a list of DRAFT db names that are available in RW mode
-----------------------------------------------------------------------------
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Database names
--
-----------------------------------------------------------------------------
define function !!isoRwDbs() is ARRAY

  -- Initialise variables
  !draftDbs = ARRAY()

  -- Get session data
  !session = CURRENT SESSION
  !mdb     = !session.mdb()
  !dbs     = !mdb.current()
  !mode    = !mdb.mode()

  -- Get all draft db's open in RW
  do !index ind !dbs

    !db = !dbs[!index]

    if (!db.type.upCase().eq('PADD') and !db.foreign.upCase().eq('LOCAL') and !mode[!index].eq('RW')) then
      !draftDbs.append(!dbs[!index].name)
    endif

  enddo

  return !draftDbs

endfunction
