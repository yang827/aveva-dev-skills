-- File:            isosearch.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Finds DRWG and its member SHEE elements for a given search criteria
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       All DRWG elements in the MDB that have been produced by this application
--    2    R     ISOSEARCH   Object holding the parameters for this search
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of ISODISPLAYDRWG objects
--
------------------------------------------------------------------------
define function !!isoSearch(!allDrawings is ARRAY, !option is ISOSEARCH) is ARRAY

  -- Initialise variables
  !type  = !option.type
  !attr  = !option.attr
  !rule  = !option.rule
  !array = ARRAY()

  -- Take an array of drawings and find those that meet the search criterion
  if (!type.eq('DRWG')) then

    do !drawing val !allDrawings

      VAR !allDrwgs COLL ALL $!type WITH (MATCH($!attr,'$!rule') NEQ 0) FOR $!drawing

      do !drwg val !allDrwgs
        !array.append(object ISODISPLAYDRWG(!drwg.dbref()))
      enddo

    enddo

  elseif (!type.eq('SHEE')) then

    do !drawing val !allDrawings

      VAR !sheets COLL ALL $!type WITH (MATCH($!attr,'$!rule') NEQ 0) FOR $!drawing

      if (!sheets.empty().not()) then
        !array.append(object ISODISPLAYDRWG(!drawing.dbref(),!sheets))
      endif

    enddo

  elseif (!type.eq('REVI')) then

    do !drawing val !allDrawings

      VAR !sheets EVAL REFE OF OWNE FOR ALL $!type WITH (MATCH($!attr,'$!rule') NEQ 0) FOR $!drawing

      !sheets.unique()

      if (!sheets.empty().not()) then
        !array.append(object ISODISPLAYDRWG(!drawing.dbref(),!sheets))
      endif

    enddo

  endif

  return !array

endfunction
