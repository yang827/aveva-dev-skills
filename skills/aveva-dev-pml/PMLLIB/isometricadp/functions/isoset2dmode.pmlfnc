-- File:            isoset2dmode.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          B.Cheetham
-- Created:         21 November 2002
--
-- Description:
-- This is the callback function for the location mode popup menu
-- for Event Driven Graphics in Draft modified for ISO ADP as the name of
-- the main form has been hardcoded in line 3
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM
--    2   R      INTEGER
--
-- Return:
--   none
--
------------------------------------------------------------------------

define function !!isoSet2dMode(!form is FORM, !mode is REAL)

  --NEW PICK MODE
  !view = !form.feedback
  !menu = !form.modifypopup

  !view.inMode.input[1] = !mode
  !menu.select('2D cursor hit', FALSE)
  !menu.select('End Point of', FALSE)
  !menu.select('Mid Point of', FALSE)
  !menu.select('Centre Point of', FALSE)
  !menu.select('Intersect at', FALSE)
  !menu.select('Intersect between', FALSE)
  !menu.select('Nearest to', FALSE)
  !menu.select(!menu.pickedField, TRUE)

endfunction
-- End of function definition for !!isoSet2dMode
