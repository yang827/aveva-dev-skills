--
-- File:            isospecbrk.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Creates a specification break symbol when a change in insulation is found
--
-- Assumptions:
-- The current element is the layer
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       The components in the drawlist
--    2    R     STRING      The type of drawing being processed, HVAC or PIPE
--    3    R     ISODEFAULTS The defaults settings
--
------------------------------------------------------------------------
define function !!isoSpecBrk(!allComp is ARRAY, !type is STRING, !drawLists is ARRAY, !sht is REAL, !data is ISODEFAULTS)

  -- Initialise variables
  !gadget   = !type & 'SpecBrk'
  !elevLaye = !!ce
  !template = !data.$!gadget$N.template
  !offset   = !data.$!gadget$N.offset[1].queryString() & ' ' & !data.$!gadget$N.offset[2].queryString()
  !tColour  = !data.$!gadget$N.tColour
  !fColour  = !data.$!gadget$N.fColour
  !fStyle   = !data.$!gadget$N.fStyle & !data.$!gadget$N.fThickness.replace('Thin','')
  !rule     = !data.$!type$NSpecBrk.rule

  -- Set the layer colours
  TXColour $!tColour  LFStyle $!fStyle  LFColour $!fColour  LLStyle $!fStyle  LLColour $!fColour

  -- For each component
  do !index ind !allComp

    -- Initialise variables
    !compRefe = !allComp[!index]

    -- Get the spec of the current and next component
    if (!type.eq('HVAC')) then
      !specs = !!isoGetSpec(!allComp, !index, !compRefe, 'DSCODE', !drawLists, !sht, !rule)

    else
      !specs = !!isoGetSpec(!allComp, !index, !compRefe, 'PSPE', !drawLists, !sht, !rule)

    endif

    -- Test for change in spec
    if (!specs[1].neq(!specs[2])) then

      -- Determine ppoint
      if (!index.eq(1)) then
        !pPoint = 'PA'
      else
        !pPoint = 'PL'
      endif

      -- Create atex string
      !atex = !specs[3] & '   ' & !specs[4]

      -- Create a named label
      NEW SLAB ON $!pPoint OF $!compRefe ATEX |$!atex|
        TMRF $!template  XYPO $!offset  OSET TRUE  BLNK TRUE
        TXColour DEF  LFStyle DEF  LFColour DEF  LLStyle DEF  LLColour DEF

    endif

  enddo

  -- Return to laye
  !!ce = !elevLaye

endfunction
