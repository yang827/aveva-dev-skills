--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2010
--
--
-- Description:
-- Creates the standard pattern
--
-- Assumptions:
-- The ce is the sheet
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      The type of drawing being processed, HVAC or PIPE
--    2    R     DBREF       The overlay reference
--    3    R     POSITION    The position of the reserved area on the sheet
--    4    R     BOOLEAN     Whether this drawing is being updated or not
--
------------------------------------------------------------------------
define function !!isoStanPat(!runType is STRING, !overRefe is DBREF, !origin is POSITION, !olayName is STRING, !update is BOOLEAN)

  -- Initialise variables
  !sheeRefe      = !!ce
  !stanPatOrigin = 'X' & !origin.east & ' Y' & !origin.north

  -- Log message
  !!isoLog.add('    Creating Standard Pattern...')

  -- Check for existing element when updating
  if (!update) then
    OLAY /$!olayName
      handle any

      	-- As we cannot find one, let us create one
  	    !!isoLog.add('WARNING: Cannot find a standard pattern OVER to update. Creating one...')

        NEW OLAY /$!olayName

      elsehandle none

      	-- Reset the overlay visibility
      	OSHEE ALL OFF

      endhandle

  else

    -- Create a new overlay
    NEW OLAY /$!olayName

  endif

  -- Set the attributes
  OSRF $!overRefe
  OPOS $!stanPatOrigin
  SPPURPOSE STDPAT

  -- Switch on the layers for the type
  OSHEE LAYE DESI $!runType

  -- Return to the sheet
  !!ce =!sheeRefe

endfunction
