--
-- File:            isowithin.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
-- Description:
-- Determines if the atta is within the ends of the passed component
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       ATTA reference
--    2    R     DBREF       Component reference
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Whether the atta is within the ends TRUE or FALSE
--
------------------------------------------------------------------------
define function !!isoWithIn(!attaRefe is DBREF, !compRefe is DBREF) is BOOLEAN

  -- Initialise variables
  !worl     = WORL OF $!attaRefe
  !result   = false
  !compType = !compRefe.type.upCase()

  -- For a STRT
  if (!compType.eq('STRT')) then

    -- Get distances from ends of component to the atta and the distance through the component
    !arriveDist  = !compRefe.ppos[!compRefe.arr].wrt(!worl).distance(!attaRefe.pos.wrt(!worl))
    !leaveDist   = !compRefe.ppos[!compRefe.lea].wrt(!worl).distance(!attaRefe.pos.wrt(!worl))
    !throughDist = !compRefe.ppos[!compRefe.arr].wrt(!worl).distance(!compRefe.ppos[!compRefe.lea].wrt(!worl))

    -- Compare
    !addDist = !arriveDist + !leaveDist
    if (!addDist.nint().eq(!throughDist.nint())) then
      !result = true
    endif

  -- For a BEND, ELBO, FLEX, TEE or THRE
  elseif (!compType.eq('BEND') or !compType.eq('ELBO') or !compType.eq('FLEX')) then

    -- Use the origin as the arrive end
    !arriveDist = !compRefe.ppos[0].wrt(!worl).distance(!attaRefe.pos.wrt(!worl))

    -- Find which end is regarded as the leave end by finding on which centreline the atta is positioned
    if (!attaRefe.pdir[!attaRefe.arr].wrt(!worl).eq(!compRefe.pdir[!compRefe.arr].wrt(!worl)) or !attaRefe.pdir[!attaRefe.arr].wrt(!worl).opposite().eq(!compRefe.pdir[!compRefe.arr].wrt(!worl))) then

      -- Use the component arrive point as the leave end for calculation purpose
      !leaveDist = !compRefe.ppos[!compRefe.arr].wrt(!worl).distance(!attaRefe.pos.wrt(!worl))
      !throughDist = !compRefe.ppos[0].wrt(!worl).distance(!compRefe.ppos[!compRefe.arr].wrt(!worl))

    else

      -- Use the component leave point as the leave end for calculation purpose
      !leaveDist = !compRefe.ppos[!compRefe.lea].wrt(!worl).distance(!attaRefe.pos.wrt(!worl))
      !throughDist = !compRefe.ppos[0].wrt(!worl).distance(!compRefe.ppos[!compRefe.lea].wrt(!worl))

    endif

    -- Compare
    !addDist = !arriveDist + !leaveDist
    if (!addDist.nint().eq(!throughDist.nint())) then
      !result = true
    endif

  elseif (!attaRefe.spref.name.after('/').before('/').eq('MDS')) then

    !result = true

  -- Nothing else is valid as yet...
  else

  endif

  return !result

endfunction
