--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Tue Nov 30 13:18:55 2010
--
-- Description:
-- Object to define the Isometric ADP Add-in for all Drafting Modules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appIsoAdp()                      -                   Constructor
--  modifyForm()                     -                   Modify Form
--  modifyMenus()                    -                   Modify menus
--  toolbars(STRING)                 -                   Creates toolbars for this application
--
------------------------------------------------------------------------
-- Define object
define object APPISOADP

  -- Module
  member .module is MODULE

  -- Application active status
  member .active is BOOLEAN

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .appIsoAdp()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appIsoAdp()

  --Initialise variables
  !application = object ISOADPAPPLICATION()

  -- Get the application status
  !this.active = !application.license(1)

endmethod
-- End of method definition for .appIsoAdp()

------------------------------------------------------------------------
--
-- Method:        .modifyForm()
--
-- Description:   Modify Form
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()

  -- Load the toolbar
  if (!this.active) then
    !this.toolbars(!this.module.modKey.upcase())

  endif

endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Modify menus
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- Test for drafting module
  -- Marine Drafting
  if (!this.module.modKey.eq('MARDRA')) then
    !form = !!appMDraMain

  -- Outfitting Draft or Draft
  else
    !form = !!appDraMain

  endif

  -- Add to the Create menu option within the core ADP application
  if (!this.active) then

    !menu = object APPMENU('MBCREATE')
    !menu.insertAfter('SteelworkDetailing', 'CALLBACK', |IsoADP Standards...|, '!!isoCrStd()', 'IsoADPStd')
    !menu.insertAfter('SteelworkDetailing', 'CALLBACK', |Isometric Drawings...|, |!!isoInitialise('MAIN')|, 'CrIsoADP')
    !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

    -- Add to the Modify menu option within the core ADP application
    !menu = object APPMENU('MBMODIFY')
    !menu.insertAfter('GeneralADP', 'CALLBACK', |Isometric Drawings...|, |!!isoInitialise('EDIT')|, 'ModIsoADP')
    !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

    -- Add a new bar menu for printing
    !bmenu = object APPBARMENU()
    !bmenu.insertBefore('E2DDRAW',|Print|, 'PRINT')
    !!appMenuCntrl.addBarMenu(!bmenu,'ADPCORE')

    !menu = object APPMENU('PRINT')
    !menu.add('CALLBACK', |Multi-Print Isometrics|, |!!isoInitialise('PRINT')|, 'MultiPrint')
    !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  endif

endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Module Key
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars(!modKey is STRING)

  -- Test for drafting module
  -- Hull Drafting
  if (!modKey.eq('MARHDRA')) then
    !form = !!appHDraMain

  -- Marine Drafting
  elseif (!modKey.eq('MARDRA')) then
    !form = !!appMDraMain

  -- Outfitting Draft or Draft
  else
    !form = !!appDraMain
  endif

  -- Isometric ADP Toolbars
  frame .isoADPToolbar toolbar 'Isometric ADP'

    button .isoMain tooltip 'Create Isometrics ' pixmap width 16 height 16
    button .isoDrwg tooltip 'View Isometrics '   pixmap width 16 height 16

    -- Check for administrator user
    if (!!cdAdmin.boolean()) then
      button .isoTools tooltip 'Modify Isometric Preferences ' pixmap width 16 height 16
    endif

    -- Log File
    button .showLog tooltip 'Display Log' pixmap width 16 height 16

    -- Check for Outfitting Draft
    if (!modKey.neq('MARHDRA') and !modKey.neq('MARDRA')) then
      button .isoPrint tooltip 'Print Isometrics ' pixmap width 16 height 16
    endif

  exit

  -- Callbacks
  !form.isoMain.callback = |!!isoInitialise('MAIN')|
  !form.isoDrwg.callback = |!!isoInitialise('EDIT')|
  !form.showLog.callback = |!!isoInitialise('LOG')|

  -- Add main Draft form icons
  !form.isoMain.addPixmap(!!pml.getPathName('draw16.png'))
  !form.isoDrwg.addPixmap(!!pml.getPathName('look16.png'))
  !form.showLog.addPixmap(!!pml.getPathName('ad_t_009.png'))

  -- Add administrator option to modify application configuration
  if (!!cdAdmin.boolean()) then

    !form.isoTools.callback = |!!isoInitialise('TOOLS')|
    !form.isoTools.addPixmap(!!pml.getPathName('toolkit16.png'))

  endif

  -- Add specific Outfitting Draft options
  if (!modKey.neq('MARHDRA') and !modKey.neq('MARDRA')) then

    -- Add printer option
    !form.isoPrint.callback = |!!isoInitialise('PRINT')|
    !form.isoPrint.addPixmap(!!pml.getPathName('printer16.png'))

    -- Add toolbar
    !!appTbarCntrl.addToolbar('isoADPToolbar', 'ADPCORE', true)

  endif

  -- Storage for whether the application is loaded
  member .isoAdpLoaded is BOOLEAN

  -- Mark the application as not loaded
  !form.isoAdpLoaded = false

endmethod
-- End of method definition for .toolbars()
