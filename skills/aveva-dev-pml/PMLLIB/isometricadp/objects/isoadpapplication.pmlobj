-- Created:         Tue Nov 30 13:18:59 2010
--
-- Description:
-- Isometric ADP Main Application calls
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -                   Make the application toolbar and main menu options active
--  batch()                          -                   Run as batch
--  clear()                          -                   Clear all necessary arrays
--  getActive()                      BOOLEAN             Get this application active status
--  getSettings()                    ARRAY               Get this object settings
--  isoAdpApplication()              -                   Construct
--  license(REAL)                    BOOLEAN             Look for a valid license
--  linkDocs()                       -                   Link the detailed element to the produced documents
--  load()                           BOOLEAN             Load assembly drawing essentials
--  loadConfig()                     -                   Load configuration settings
--  makeDrawings(STRING)             ARRAY               Create the drawings
--  makePartsList()                  -                   Create the parts list output
--  pdf()                            -                   Create pdf output files
--  print()                          -                   Print the current displayed sheet
--  setActive(BOOLEAN)               -                   Set the application active status
--  settings(ARRAY)                  -                   Read in relevant settings
--  showLog(STRING)                  -                   Show log viewer with current log file
--  showTools()                      -                   Show the configuration settings editor
--
------------------------------------------------------------------------
define object ISOADPAPPLICATION

  -- List of elements for detailing
  member .elements        is ARRAY
  member .updates         is ARRAY

  -- Current selected drawing template
  member .drwgTmpl        is DBREF

  -- Create Drawing
  member .createDrawing   is BOOLEAN
  member .drawingType     is STRING

  -- Drawing PDF Output
  member .createPdf       is BOOLEAN
  member .pdfFolder       is FILE

  -- Material XLS Output
  member .createPartsList is BOOLEAN
  member .xlsFolder       is FILE

  -- Data
  member .data            is ISODEFAULTS

  -- Drawing locations
  member .library         is DBREF
  member .registry        is DBREF

  -- Drawings
  member .drawings        is ARRAY
  member .numOfSheet      is ARRAY

  -- Splitting
  member .splitMethod     is STRING
  member .limitsBox       is REAL
  member .splitManager    is ISOSPOOLS

  -- Drawing view direction
  member .isoDirection    is REAL

  -- Drawing revision
  member .revision        is ISOREVISION

  -- Log File
  member .log             is ISOLOG

  -- Link element
  member .linkRefe        is DBREF

  -- Device
  member .device          is STRING

  -- Module
  member .module          is ISOMODULE

  -- Main application form
  member .appForm         is FORM

  -- Is this application active?
  -- If there were no suitable departments available at start-up it will not be
  member .active          is BOOLEAN
  member .token           is BOOLEAN

  -- Application units
  member .units           is ISOUNITS

endobject

------------------------------------------------------------------------
--
-- Method:        .isoAdpApplication()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoAdpApplication()

  -- Determine the device
  VAR !device DEVICE
  !this.device = !device

  -- Determine the drafting module in which we are running
  if (!this.device.upcase().eq('GRAPHICS')) then

    -- For Drafting
    if (!this.module.module.ddlType.eq('PADD')) then

      -- For Marine Drafting
      if (!this.module.description.eq('HULL')) then

        -- Remember the application main form
        if (defined(!!appMDraMain)) then
          !this.appForm = !!appMDraMain
        endif

      -- For PDMS Draft
      else

        -- Remember the application main form
        if (defined(!!appDraMain)) then
          !this.appForm = !!appDraMain
        endif

      endif

    endif

  endif

  -- Set the application as being active
  !this.setActive(false)
  !this.token = false

endmethod
-- End of method definition for .isoAdpApplication()

------------------------------------------------------------------------
--
-- Method:        .active(BOOLEAN)
--
-- Description:   Make the application toolbar and main menu options active
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Make active or inactive
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .active(!active is BOOLEAN)

  -- Initialise variables
  !module = object MODULE()

  -- This application
  !this.active = !active

  -- For active
  if (!active) then

    -- Toolbar
    !this.appForm.isoMain.active   = !active
    !this.appForm.isoDrwg.active   = !active
    !this.appForm.showLog.active   = !active

    -- Check for administrator user
    if (!!cdAdmin.boolean()) then
      !this.appForm.isoTools.visible  = !active
      !this.appForm.isoTools.active   = !active
    endif

    -- Check for Outfitting Draft
    if (!module.modKey.upcase().neq('MARHDRA') and !module.modKey.upcase().neq('MARDRA')) then
      !this.appForm.isoPrint.visible  = !active
      !this.appForm.isoPrint.active   = !active
    endif

  -- Inactive
  else

    -- Deactivate the toolbar
    if (!this.appForm.set()) then

      if (defined(!this.appForm.isoADPToolbar)) then

--        !this.appForm.isoADPToolbar.active = !active

        !this.appForm.isoMain.active   = !active
        !this.appForm.isoDrwg.active   = !active
        !this.appForm.showLog.active   = !active

        if (!!cdAdmin.boolean()) then
          !this.appForm.isoTools.active   = !active
        endif

        if (!module.modKey.upcase().neq('MARHDRA') and !module.modKey.upcase().neq('MARDRA')) then
          !this.appForm.isoPrint.active   = !active
        endif

      endif

    endif

  endif

endmethod
-- End of method definition for .active(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .batch(ARRAY,ARRAY)
--
-- Description:   Run as batch
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .batch()

  !unusedVariable = TRUE

endmethod
-- End of method definition for .batch(ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear all necessary arrays
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.elements.clear()
  !this.updates.clear()
  !this.drawings.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .getActive()
--
-- Description: Get this application active status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if active
--
------------------------------------------------------------------------
define method .getActive() is BOOLEAN

  return !this.active

endmethod
-- End of method definition for .getActive()

------------------------------------------------------------------------
--
-- Method:      .getSettings()
--
-- Description: Get this object settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSettings() is ARRAY

  !settings = ARRAY()

  !settings.append(!this.isoDirection)
  !settings.append(!this.registry)
  !settings.append(!this.data)
  !settings.append(!this.revision)

  return !settings

endmethod
-- End of method definition for .getSettings()

------------------------------------------------------------------------
--
-- Method:        .license(REAL)
--
-- Description:   Look for a valid license
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Check license
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if a license is found
--
------------------------------------------------------------------------
define method .license(!checkValue is REAL) is BOOLEAN

  -- Check for token already extracted
  if (!this.token) then
    return true
  endif

  -- Initialise variables
  !addValue      = 'h.yx6yt7L6|k+;41486347465'
  !subtractValue = '   ' & $!checkValue

  -- Test value
  !result = !addValue.substring(15, !subtractValue)

  -- Return result
  if (!result.objectType().eq('BOOLEAN')) then

    if (!checkValue.eq(2)) then
      !this.token = true
    endif

  else

    -- !!messagefile.warning(43,292)
    result = false

  endif

  return !result

endmethod
-- End of method definition for .license(REAL)

------------------------------------------------------------------------
--
-- Method:        .linkDocs()
--
-- Description:   Link the detailed element to the produced documents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .linkDocs()

  -- Try and find any link locations
  VAR !linkDoc COLL ALL LNFOLD WITH FUNCTION EQ 'Isometric ADP'

  -- Access the found link location
  if (!linkDoc.empty()) then

    -- Try to find any writable document link world
    VAR !linkWorld COLL ALL LINKWL WITH DBWRITE EQ TRUE

    if (!linkWorld.empty()) then
      !!isoLog.add(|WARNING: Unable to find any writable Link World with FUNC 'Isometric ADP'. Aborting linking...|)
      return
    endif

    -- Access the link world
    !!ce = !linkWorld[1].dbref()

    -- Create a new folder for the links
    NEW LNFOLD
      DESC 'Isometric ADP Links'
      FUNC 'Isometric ADP'

    -- Name the folder if possible
    NAME /IsometricADP/Document-Links/ADP
      handle (41,12)
        -- Name already used
      endhandle

   !!isoLog.add('WARNING: The document links have been created in a new location' & !!ce.flnm)

  else

    -- Get link document reference
    !linkDocRefe = !linkDoc[1].dbref()

    -- Check that the default link folder is writeable
    if (!linkDocRefe.dbwrite.not()) then
      !!isoLog.add('WARNING: Unable to write to the Link World ' & !linkDocRefe.name & '. Aborting linking...')
      return
    endif

    -- Access the link document
    !!ce = !linkDocRefe

  endif

  -- Create the link from the detailed element to the drawings and parts lists
  -- This is regarded as a user function as they might wish to modify its methodology
  !!isoPrompt('Building links to the documents.',1)
  !!isoLog.add('  ')
  !!isoLog.add('  Building links between the ' & !this.drawingType & ' elements and their associated documents.')
  !!isoDocLink(!this.elements, !this.drawings, !this.updates)

  -- Keep the created links in case of later errors
  SAVEWORK

endmethod
-- End of method definition for .linkDocs()

------------------------------------------------------------------------
--
-- Method:        .load()
--
-- Description:   Load assembly drawing essentials
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if no load errors encountered
--
------------------------------------------------------------------------
define method .load() is BOOLEAN

  -- Load defaults
  !this.loadConfig()

  return !this.data.loaded

endmethod
-- End of object definition for .load()

------------------------------------------------------------------------
--
-- Method:        .loadConfig()
--
-- Description:   Load configuration settings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadConfig()

  -- Initialise variables
  !array = ARRAY()

  -- Load main defaults
  !errors = !this.data.getDflts()

  -- Test for errors
  if (!errors.size().neq(0)) then

    -- Set load errors
    !!isoDisplayList.load('Default Load Errors',!errors)
      handle (2,751)
        pml load form !!isoDisplayList
        !!isoDisplayList.load('Default Load Errors',!errors)
      endhandle

    -- Mark load as unsuccessful
    !this.data.loaded = false

    -- Show error list form
    !!isoDisplayList.show('CEN',0.2,0.5)

    -- If the user is the administrator, display the defaults form
    if (!!cdAdmin.boolean()) then
      show !!isoDflts free

    -- For a standard user, show the relevant tools to enable him to escape the errors
    else

      -- If a suitable registry does not exist, allow the user to create one
      if (!!isoMain.isoAdpApp.data.isoRegister.unset()) then

        -- Use the default registry name
        !!isoDflts.default2.val = !this.data.isoRegisterDef

        -- If the library does not exist, use the default value
        if (!!isoMain.isoAdpApp.data.stdLibrary.unset()) then
          !!isoDflts.default3.val = !this.data.stdLibraryDef

        -- Otherwise use the exisiting one
        else
          !!isoDflts.default3.val = !this.data.stdLibrary.flnm

        endif

        -- Set the application active
        !this.setActive(true)

        -- Choose in which db to create the registry
        !!isoCrHier.create = 'REGI'
        show !!isoCrHier

      endif

    endif

    return

  elseif (!errors.empty()) then

    -- Load secondary defaults
    !this.data.isoContent.getDflts()
    !this.data.hvacMtoGen.getDflts('HVAC')
    !this.data.elecMtoGen.getDflts('CWAY')
    !this.data.hvacElevTag.getDflts('HVAC', !this.module.description)
    !this.data.elecElevTag.getDflts('CWAY', !this.module.description)
    !this.data.hvacContTag.getDflts('HVAC', !this.module.description)
    !this.data.elecContTag.getDflts('CWAY', !this.module.description)
    !this.data.hvacNamedTag.getDflts('HVAC')
    !this.data.elecNamedTag.getDflts('CWAY')
    !this.data.hvacSpecBrk.getDflts('HVAC')
    !this.data.elecSpecBrk.getDflts('CWAY')
    !this.data.hvacInsulBrk.getDflts('HVAC')
    !this.data.elecInsulBrk.getDflts('CWAY')
    !this.data.hvacDimn.getDflts('HVAC')
    !this.data.elecDimn.getDflts('CWAY')
    !this.data.hvacPeneTag.getDflts('HVAC')
    !this.data.elecPeneTag.getDflts('CWAY')
    !this.data.hvacOrigin.getDflts('HVAC')
    !this.data.elecOrigin.getDflts('CWAY')
    !this.data.hvacMdsTag.getDflts('HVAC')
    !this.data.elecMdsTag.getDflts('CWAY')

    -- Mark load as successful
    !this.data.loaded = true

  endif

  -- Load the revision settings
  !array.append(!this.data.startRev.substring(1,3).upcase())
  !array.append('INC')
  !array.append(!this.data.initialRev)
  !this.revision.set(!array)

endmethod
-- End of object definition for .loadConfig()

------------------------------------------------------------------------
--
-- Method:        .makeDrawings()
--
-- Description:   Create the drawings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of drawing being created HVAC or CWAY
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Drwg references
--
------------------------------------------------------------------------
define method .makeDrawings(!searchType is STRING) is ARRAY

  -- Initialise variables
  !splitSettings  = ARRAY()

  -- Set the spool split manager object
  !splitSettings.append(!this.limitsBox)
  !splitSettings.append(!!isoMaxMtoEntries(!searchType, !this.data.backingSheet, !this.data.stdLibrary))

  if (!searchType.eq('HVAC')) then
    !splitSettings.append(!this.data.hvacPeneTag.element)
    !splitSettings.append(!this.data.hvacPeneTag.rule)
    !splitSettings.append(!this.data.hvacMdsTag.element)
    !splitSettings.append(!this.data.hvacMdsTag.rule)
  else
    !splitSettings.append(!this.data.elecPeneTag.element)
    !splitSettings.append(!this.data.elecPeneTag.rule)
    !splitSettings.append(!this.data.elecMdsTag.element)
    !splitSettings.append(!this.data.elecMdsTag.rule)
  endif

  !splitSettings.append(!this.data.drwgNameRule)
  !splitSettings.append(!this.data.lineNumbRule)
  !splitSettings.append(!this.drawingType)

  !this.splitManager.setSettings(!splitSettings)

  -- Access Registry
  REGIS $!<this.registry>

  -- For each element HVAC or CWAY
  do !index ind !this.elements

    -- Initialise variables
    !elementRefe = !this.elements[!index]
    !this.splitManager.clear()

    -- Build drawing object
    !drwgObj = object ISODRWG(!elementRefe, !this.updates[!index])
    !drwgObj.setSettings(!this.getSettings())

    -- Add log message
    !!isoLog.add(' ')
    !!isoLog.add('  Splitting ' & !searchType & ' ' & !elementRefe.flnn & ' into spools')

    -- Split HVAC into spools
    if (!searchType.eq('HVAC')) then
      !drwgObj.spools = !this.splitManager.splitHvac(!elementRefe, true, !this.splitMethod)

    -- Split CWAY into spools
    else
      !drwgObj.spools = !this.splitManager.splitCway(!elementRefe, true, !this.splitMethod)

    endif

    -- Send message
    !!isoPrompt('Processing Drawing ' & !index & ' of ' & !this.elements.size(),1)
    !!isoPrompt(' ',2)

    -- Check for process interrupt
    if (!this.device.upcase().eq('GRAPHICS')) then

      -- Check for interrupt
      if (!!fmsys.interrupt()) then
        if !!alert.confirm('Sure you want to quit the task?',0.5, 0.5) eq 'YES' then
          break
        endif
      endif

    endif

    -- Create the drawing
    !this.drawings.append(!drwgObj.create())

  enddo

  -- Output drawing to pdf
  if (!this.createPdf) then
    !this.pdf()
  endif

  -- Make the mto parts list
  if (!this.createPartsList) then
    !this.makePartsList()
  endif

  -- Link the created documents to their associated design element
  !this.linkDocs()

  -- Return drawings for display
  return !this.drawings

endmethod
-- End of object definition for .makeDrawings()

------------------------------------------------------------------------
--
-- Method:        .makePartsList()
--
-- Description:   Create the parts list output
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .makePartsList()

  -- Initialise variables
  !folderPath = !this.xlsFolder

  -- Ensure that the destination folder exists
  if (!folderPath.exists().not()) then

    -- Create the folder
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- Set the percentage complete
  if (!this.device.upcase().eq('GRAPHICS')) then
    !!isoProcess.setPercent(100 / !this.drawings.size())
  endif

  -- For each drawing
  do !index ind !this.drawings

    -- Send message
    !!isoPrompt('Producing Parts List for Drawing ' & !index & ' of ' & !this.drawings.size(),1)
    !!isoPrompt(' ',2)
    !!isoLog.add('  ')
    !!isoLog.add('  Producing Parts List for Drawing ' & !index & ' of ' & !this.drawings.size())

    -- Set the percentage complete
    if (!this.device.upcase().eq('GRAPHICS')) then
      !!isoProcess.setPercent()
    endif

    -- Build object
    !partsListObj = object ISOPARTSLIST(!this.xlsFolder, !this.drawings[!index].mtoentries, !this.drawings[!index].drwgName)

    -- Output report to Excel file .xls
    !this.drawings[!index].partsList = !partsListObj.saveToExcel()

    -- Set the percentage complete
    if (!this.device.upcase().eq('GRAPHICS')) then
      !!isoProcess.setPercent()
    endif

  enddo

endmethod
-- End of object definition for .makePartsList()

------------------------------------------------------------------------
--
-- Method:        .pdf(DBREF)
--
-- Description:   Create pdf output files
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pdf()

  -- Get folder path name
  !folderPath = !this.pdfFolder.fullname()

  -- Ensure that the destination folder exists
  if (!this.pdfFolder.exists().not()) then

    -- Create the folder
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- Set the percentage complete
  if (!this.device.upcase().eq('GRAPHICS')) then
    !!isoProcess.setPercent(100 / !this.drawings.size())
  endif

  -- For each drawing
  do !drwgIndex ind !this.drawings

    -- Send message
    !!isoPrompt('Producing PDF file for Drawing ' & !drwgIndex & ' of ' & !this.drawings.size(),1)
    !!isoLog.add(' ')
    !!isoLog.add('  Producing PDF file(s) for Drawing ' & !drwgIndex & ' of ' & !this.drawings.size())

    -- Set the percentage complete
    if (!this.device.upcase().eq('GRAPHICS')) then
      !!isoProcess.setPercent()
    endif

    -- Initialise variables
    !drwgObj = !this.drawings[!drwgIndex]

    -- For each sheet
    do !shtIndex ind !drwgObj.sheetRefs

      -- Get the sheet
      !sheetRefe = !drwgObj.sheetRefs[!shtIndex]

      -- Send message
      !!isoPrompt('  Sheet ' & !shtIndex & ' of ' & !drwgObj.sheetRefs.size(),2)

      -- Build plotfile path name
      !sheetName     = !sheetRefe.flnn.replace('\','_').replace('/','_').replace('.','_')
      !pdfPathName   = !folderPath & '\' & !sheetName & '_' & !!isoDateStamp() & '.pdf'

      -- Plot sheet, whilst converting any white colours to black
      !this.module.submitToPdf(!sheetRefe, !pdfPathName, 'COL COLOURPLUS, NOVIEW', 'OVERWRITE')

      -- Store output pdf file
      !this.drawings[!drwgIndex].pdfFiles.append(object FILE(!pdfPathName))

      -- Set the percentage complete
      if (!this.device.upcase().eq('GRAPHICS')) then
        !!isoProcess.setPercent()
      endif

    enddo

  enddo

endmethod
-- End of object definition for .pdf(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Print the current displayed sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .print()

  -- Get the displayed sheet
  !sheeRefe = !!cdrcadcga1.n1addName.dbref()

  -- Test for empty display
  if (!sheeRefe.unset()) then

    -- Try for the current element
    if (!!ce.type.upcase().eq('SHEE')) then
      !answer = !!alert.confirm('Unable to find a displayed sheet. Do you want to print the current sheet?')
      if (!answer.eq('YES')) then
        !sheeRefe = !!ce
      else
        return
      endif
    else
      !answer = !!alert.warning('Unable to find a sheet to print. Please select one and try again.')
      return
    endif
  endif

  -- No need to set the dialog option
  !dialogOption = ''

  -- Set colour output
  if (!!isoPrint.bw.val) then

    -- Print in black & white
    !colourOption = 'COL BW,'

  else

    -- Print colours, but switch any white to black
    !colourOption = 'COL COLOURPLUS,'

  endif

  -- Set scale
  if (!!isoPrint.fit.val) then

    -- Scale to fit the printer paper size
    !scaleOption = 'REDUCE'

  else

    -- Print full size
    !scaleOption = ''

  endif

  -- Submit the currently displayed sheet to printer
  !this.module.submitToPrinter(!sheeRefe, !colourOption, !dialogOption, !scaleOption)

endmethod
-- End of method .print()

-----------------------------------------------------------------------
--
-- Method:      .setActive(BOOLEAN)
--
-- Description: Set the application active status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN       Active status
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive(!active is BOOLEAN)

  !this.active(!active)

endmethod
-- End of method .setActive(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .settings(ARRAY)
--
-- Description: Read in relevant settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Settings values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settings(!settings is ARRAY)

  !this.library         = !settings[1]
  !this.registry        = !settings[2]
  !this.splitMethod     = !settings[3]
  !this.limitsBox       = !settings[4]
  !this.isoDirection    = !settings[5]
  !this.revision        = !settings[6]
  !this.createPartsList = !settings[7]
  !this.xlsFolder       = !settings[8]
  !this.createPdf       = !settings[9]
  !this.pdfFolder       = !settings[10]
  !this.drawingType     = !settings[11]

endmethod
-- End of object definition for .settings(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .showLog(STRING)
--
-- Description: Show log viewer with current log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      OPEN   Attempt to open the log file
--                           BROWSE Browse for a log file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showLog(!option is STRING)

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Test for no current log file, in which case browse for one
  if (!this.log.file.exists().not() or !this.log.file.unset() or !option.eq('BROWSE')) then

    -- Initialise variables
    !browser = object PMLFILEBROWSER('OPEN')
    !folder  = !this.config.logFileDir

    -- Create the configuration folder if necessary
    if (!folder.exists().not()) then
      !folderPath = !folder.directory().fullName() & '\' & !folder.entry()
      SYSCOM 'mkdir "$!folderPath"'
    endif

    -- Initialise variables
    !directory       = !this.config.logFileDir.fullName()
    !seedFile        = ' '
    !title           = 'Isometric Drawing Log File'
    !extensionString = 'txt files (*.txt)|*.txt'

    -- Show Browser
    !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

    -- Test for no returned file name
    if (!browser.file().neq('')) then

      -- Read the log file and display the log file viewer
      !!isoLogViewer.read(object FILE(!browser.file()))
      !!isoLogViewer.show(|CEN|,0.5,0.25)

    endif

  else

    -- Pass the log object
    !!isoLogViewer.log = !this.log

    -- Show form
    !!isoLogViewer.show('CEN',0.5,0.25)

  endif

endmethod
-- End of method .showLog(STRING)

-----------------------------------------------------------------------
--
-- Method:      .showTools()
--
-- Description: Show the configuration settings editor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showTools()

  -- Test for unload form
  if (undefined(!!isoDflts)) then
    pml load form !!isoDflts
  endif

  -- Show form
  !!isoDflts.show('CEN',0.5,0.3)

endmethod
-- End of method .showTools()
