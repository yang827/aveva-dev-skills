--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- The backing sheet data, in particular the reserved areas
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoBack(DBREF)                   -                   Constructor
--
------------------------------------------------------------------------
define object ISOBACK

  member .name          is STRING
  member .reference     is DBREF
  member .size          is ARRAY
  member .viewArea      is DBREF
  member .viewOrigin    is POSITION
  member .viewXlen      is REAL
  member .viewYlen      is REAL
  member .mtoArea       is DBREF
  member .mtoOrigin     is POSITION
  member .mtoXlen       is REAL
  member .mtoYlen       is REAL
  member .locArea       is DBREF
  member .locOrigin     is POSITION
  member .locXlen       is REAL
  member .locYlen       is REAL
  member .keypArea      is DBREF
  member .keypOrigin    is POSITION
  member .keypXlen      is REAL
  member .keypYlen      is REAL
  member .northArea     is DBREF
  member .northOrigin   is POSITION
  member .stanPatArea   is DBREF
  member .stanPatOrigin is POSITION

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .isoBack(DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BACK reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoBack(!backRefe is DBREF)

  -- Initialise
  !this.reference = !backRefe
  !this.name      = !backRefe.flnm
  !this.size      = !backRefe.size

  -- Get data from the view reserved area
  VAR !viewArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ 'VIEW' FOR $!this.name
  !this.viewArea   = !viewArea[1].dbref()
  !this.viewOrigin = !this.viewArea.ptrf.xypo
  !this.viewXlen   = !this.viewArea.xlen
  !this.viewYlen   = !this.viewArea.ylen

  -- Get data from the mto reserved area
  VAR !mtoArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ 'MTO' FOR $!this.name
  !this.mtoArea   = !mtoArea[1].dbref()
  !this.mtoOrigin = !this.mtoArea.ptrf.xypo
  !this.mtoXlen   = !this.mtoArea.xlen
  !this.mtoYlen   = !this.mtoArea.ylen

  -- Get data from the location plan reserved area
  VAR !locArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ 'LOCATION' FOR $!this.name
  !this.locArea   = !locArea[1].dbref()
  !this.locOrigin = !this.locArea.ptrf.xypo
  !this.locXlen   = !this.locArea.xlen
  !this.locYlen   = !this.locArea.ylen

  -- Get data from the keyplan reserved area
  VAR !keypArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ 'KEYPLAN' FOR $!this.name
  !this.keypArea   = !keypArea[1].dbref()
  !this.keypOrigin = !this.keypArea.ptrf.xypo
  !this.keypXlen   = !this.keypArea.xlen
  !this.keypYlen   = !this.keypArea.ylen

  -- Get data from the northarrow reserved area
  VAR !northArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ 'NORTHARROW' FOR $!this.name
  !this.northArea   = !northArea[1].dbref()
  !this.northOrigin = !this.northArea.ptrf.xypo

  -- Get data from the northarrow reserved area
  VAR !stanPatArea COLL ALL RECT WI (UPCASE(:IDPFUNC)) EQ  'STANDARDPATTERN' FOR $!this.name
  if (defined(!stanPatArea[1])) then
    !this.stanPatArea   = !stanPatArea[1].dbref()
    !this.stanPatOrigin = !this.stanPatArea.ptrf.xypo
  endif

endmethod
-- End of method definition for .isoBack(DBREF)
