-- Created:         19 August 2010
--
-- Description:
-- Spool Manager
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addBrco(ARRAY)                   -                   Add the brco references array
--  addDimdir(ARRAY)                 -                   Add the dimension directions
--  addIntersect(REAL,ARRAY)         -                   Add a value to the intersections array
--  addIntersects(ARRAY)             -                   Add the intersections array
--  addPldir(ARRAY)                  -                   Add the projection line directions
--  addPoss(ARRAY)                   -                   Add the intersection with the BRCO data
--  getBrcos()                       ARRAY               Get references data
--  getDimDirs()                     ARRAY               Get dimension direction data
--  getIntersects()                  ARRAY               Get intersection data
--  getPlDirs()                      ARRAY               Get projection line direction data
--  getPoss()                        ARRAY               Get the intersections with the BRCO data
--
------------------------------------------------------------------------
define object ISOBRCO

	-- Brco elements
	member .references is ARRAY

  -- Intersections with the owning STRT as a STRING in the form 'N E U'
  member .intersects is ARRAY
  member .positions  is ARRAY

  -- Dimension Directions as a STRING in the form 'N'
  member .dimDirs    is ARRAY

  -- Dimension Projection Line Directions as a STRING in the form 'N'
  member .plDirs     is ARRAY

endobject

-----------------------------------------------------------------------
--
-- Method:      .addBrco(ARRAY)
--
-- Description: Add the brco references array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      The dbrefs
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addBrco(!array is ARRAY)

  !this.references = !array

endmethod
-- End of method definition for .addBrco(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .addDimdir(ARRAY)
--
-- Description: Add the dimension directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      The array of STRING values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addDimdir(!array is ARRAY)

  !this.dimDirs = !array

endmethod
-- End of method definition for .addDimdir(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .addIntersect(REAL,ARRAY)
--
-- Description: Add a value to the intersections array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       The index
--    2   R      ARRAY      The STRING values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addIntersect(!index is REAL, !array is ARRAY)

  !this.intersects[!index] = !array

endmethod
-- End of method definition for .addIntersect(REAL,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .addIntersects(ARRAY)
--
-- Description: Add the intersections array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      The STRING values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addIntersects(!array is ARRAY)

  !this.intersects = !array

endmethod
-- End of method definition for .addIntersects(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .addPldir(ARRAY)
--
-- Description: Add the projection line directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      The array of STRING values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addPldir(!array is ARRAY)

  !this.plDirs = !array

endmethod
-- End of method definition for .addPldir(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .addPoss(ARRAY)
--
-- Description: Add the intersection with the BRCO data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      The array of STRING values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addPoss(!array is ARRAY)

  !this.positions = !array

endmethod
-- End of method definition for .addPoss(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .getBrcos()
--
-- Description: Get references data
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--     ARRAY      Array of dbrefs
--
------------------------------------------------------------------------
define method .getBrcos() is ARRAY

  return !this.references

endmethod
-- End of method definition for .getBrcos()

------------------------------------------------------------------------
--
-- Method:      .getDimDirs()
--
-- Description: Get dimension direction data
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--     ARRAY      Array of string values
--
------------------------------------------------------------------------
define method .getDimDirs() is ARRAY

  return !this.dimDirs

endmethod
-- End of method definition for .getDimDirs()

------------------------------------------------------------------------
--
-- Method:      .getIntersects()
--
-- Description: Get intersection data
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getIntersects() is ARRAY

  return !this.intersects

endmethod
-- End of method definition for .getIntersects()

------------------------------------------------------------------------
--
-- Method:      .getPlDirs()
--
-- Description: Get projection line direction data
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--     ARRAY      Array of string values
--
------------------------------------------------------------------------
define method .getPlDirs() is ARRAY

  return !this.plDirs

endmethod
-- End of method definition for .getPlDirs()

------------------------------------------------------------------------
--
-- Method:      .getPoss()
--
-- Description: Get the intersections with the BRCO data
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--     ARRAY      Array of string values
--
------------------------------------------------------------------------
define method .getPoss() is ARRAY

  return !this.positions

endmethod
-- End of method definition for .getPoss()
