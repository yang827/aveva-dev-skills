--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- The content default settings
-- This determines which isometric elements are created during processing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts()                       -                   Read in the default settings for content
--
define object ISOCONTENT

  member .main    is BOOLEAN
  member .nArr    is BOOLEAN
  member .loca    is BOOLEAN
  member .keyP    is BOOLEAN
  member .mtoT    is BOOLEAN
  member .revi    is BOOLEAN
  member .dimn    is BOOLEAN
  member .elev    is BOOLEAN
  member .name    is BOOLEAN
  member .spec    is BOOLEAN
  member .insul   is BOOLEAN
  member .pene    is BOOLEAN
  member .cog     is BOOLEAN
  member .stanPat is BOOLEAN
  member .supp    is BOOLEAN

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .getDflts()
--
-- Description: Read in the default settings for content
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts()

  -- Initialise variables
  !array= ARRAY()

  -- Read defaults file
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-CONTENT')
  if (!file.exists().not()) then
    !!alert.error('The defaults file DRA-ISO-CONTENT does not exist!')
    !this.loaded = false
    return
  endif
  !contents = !file.readfile()

  -- Extract defaults
  do !count from 5 to !contents.size()
    if (!contents[!count].upCase().eq('ON')) then
      !array.append(true)
    else
      !array.append(false)
    endif
  enddo

  !this.main = !array[1]
  !this.nArr = !array[2]
  !this.loca = !array[3]
  !this.keyP = !array[4]
  !this.mtoT = !array[5]
  !this.revi = !array[6]
  !this.dimn = !array[7]
  !this.elev = !array[8]
  !this.name = !array[9]
  !this.spec = !array[10]
  !this.insul = !array[11]
  !this.pene = !array[12]
  !this.cog = !array[13]
  !this.stanPat = !array[14]
  !this.supp = !array[15]

endmethod
-- End of method definition for .getDflts()
