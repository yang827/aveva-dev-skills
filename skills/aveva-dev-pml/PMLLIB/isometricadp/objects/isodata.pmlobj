------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildData(BOOLEAN)               ARRAY               Build data arrays for use in a column list gadget
--  clear()                          -                   Clear the object
--  getData()                        ARRAY               Get trimmed data
--  getData(ARRAY,STRING,STRING,DBREF) -                   Get element data
--  isoData()                        -                   Construct
--  remove(ARRAY)                    -                   Remove entries from the data arrays
--  setDrawn(DBREF,STRING,REAL)      -                   Set report column data
--
------------------------------------------------------------------------
define object ISODATA

  member .dbRefes   is ARRAY

  member .sysRefs   is ARRAY

  member .names     is ARRAY

  member .status    is ARRAY

  member .drawn     is ARRAY

  member .dwgRefs   is ARRAY

  member .dwgNames  is ARRAY

  member .access    is ARRAY

  member .mode      is ARRAY

  member .contents  is ARRAY

  member .locked    is ARRAY

  member .validFont is ARRAY

  member .errors    is ARRAY

endobject
-- End of object definition for ISODATA

------------------------------------------------------------------------
--
-- Method:        .isoData()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoData()

  !unusedVariable = TRUE

endmethod
-- End of method definition for .isoData()

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear the object
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.dbRefes.clear()
  !this.sysRefs.clear()
  !this.names.clear()
  !this.status.clear()
  !this.drawn.clear()
  !this.dwgRefs.clear()
  !this.dwgNames.clear()
  !this.access.clear()
  !this.mode.clear()
  !this.contents.clear()
  !this.locked.clear()
  !this.validFont.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .buildData()
--
-- Description:   Build data arrays for use in a column list gadget
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to output column data for Valid and Access
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildData(!columnData is BOOLEAN) is ARRAY

  -- Initialise variables
  !rowSet = ARRAY()

  -- Construct arrays
  do !index ind !this.dbRefes

    -- Initialise variables
    !row = ARRAY()

    -- Extract data for each column
    -- Name
    !row.append(!this.names[!index])

    -- Valid contents, set to blank as an icon will be used later
    if (!columnData) then
      !row.append(!this.contents[!index])
    else
      !row.append('')
    endif

    -- Drawn
    !row.append(!this.drawn[!index])

    -- User access to drawing, set to blank as an icon will be used later
    if (!columnData) then
      !row.append(!this.access[!index])
    else
      !row.append('')
    endif

    -- Create/update mode
    !row.append(!this.mode[!index])

    -- Add row to the row set
    !rowSet.append(!row)

  enddo

  -- Return array
  return !rowSet

endmethod
-- End of method definition for .buildData()

------------------------------------------------------------------------
--
-- Method:        .getData(BOOLEAN)
--
-- Description:   Get trimmed data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData() is ARRAY

  -- Initialise variables
  !data[1]      = ARRAY()
  !data[2]      = ARRAY()
  !data[3]      = ARRAY()
  !data[4]      = ARRAY()
  !dataArray[1] = !this.names
  !dataArray[2] = !this.dwgNames
  !dataArray[3] = !this.access
  !dataArray[4] = !this.mode
  !dataArray[5] = !this.contents

  -- Remove leading and trailing spaces and build arrays
  do !index ind !dataArray

    do !value val !dataArray[!index]

      !data[!index].append(!value.trim('LR'))

    enddo

  enddo

  return !data

endmethod
-- End of method definition for .getData()

------------------------------------------------------------------------
--
-- Method:        .getData(DBREF,STRING, STRING)
--
-- Description:   Get element data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Elements references as STRING
--    2   R      STRING      Filter options
--    3   R      STRING      The rule for extracting the Drawing Name from the element name
--    4   R      DBREF       The currently used backing sheet
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!allElements is ARRAY, !filter is STRING, !drwgNameRule is STRING, !backRefe is DBREF)

  -- Get the currently used font
  !currFont = !backRefe.font

  -- For each design element get data Name, Status, Drwg reference, Access to drawing and update mode
  do !index ind !allElements

    -- Initialise variables
    !elementRefe = !allElements[!index].dbref()

    -- Find any document links
    !links      = !!isoGetDocLink(!elementRefe)
    !drwgRefe   = !links[1]
    !lndescRefe = !links[2]

    -- If no linkref, then test for an existing drawing using the old method
    if (!drwgRefe.unset() or !drwgRefe.badref()) then

      -- For a named element build the drawing name
      VAR !drwgName EVAL ($!drwgNameRule) FOR $!elementRefe

      -- Test for spaces in the result
      if (!drwgName[1].match(' ').neq(0)) then
        !drawing = '/' & !!elementRefe.name & '/Drawing'

      -- Test for unnamed element
      elseif (!drwgName[1].substring(1,1).eq('=')) then
        !drawing = '/' & !drwgName[1] & '/Drawing'

      else
        !drawing = !drwgName[1] & '/Drawing'

      endif

      -- Test if exists
      VAR !exists EXIST $!drawing
      if (!exists.eq('TRUEA'))then
        !drwgRefe = !drawing.dbref()

      endif

    endif

    -- Filter the elements for those not drawn
    if (!filter.eq('NOT DRAWN')) then

      if (!drwgRefe.unset() or !drwgRefe.badref()) then
        !this.setDrawn(!elementRefe, !drwgNameRule, !currFont)

      else
        skip

      endif

    -- For those drawn
    elseif (!filter.eq('DRAWN')) then

      if (!drwgRefe.set() and !drwgRefe.badref().not()) then
        !this.setDrawn(!elementRefe, !drwgNameRule, !currFont)

      else
        skip

      endif

    -- For those drawn by the current logged in user
    elseif (!filter.eq('DRAWN BY ME')) then

      -- Get this user
      !session  = current session
      !userName = !session.login.upcase()

      -- Get all drawn drwgs by this user
      if (!drwgRefe.set() and !drwgRefe.badref().not() and !drwgRefe.auth.upcase().eq(!userName)) then
        !this.setDrawn(!elementRefe, !drwgNameRule, !currFont)

      else
        skip

      endif

    -- For those with a bad drawing reference
    -- This is only used for drawings that have been created using version 12 and later of this application
    -- Since this is when linkdocs were first used to link the drawing to the design element
    elseif (!filter.eq('BADREF')) then

      if (!drwgRefe.badref() and !lndescRefe.badref().not()) then
        !this.setDrawn(!elementRefe,!drwgNameRule, !currFont)

      else
        skip

      endif

    else
      !this.setDrawn(!elementRefe,!drwgNameRule, !currFont)

    endif

    -- Store string values
    !this.sysRefs.append(!elementRefe)

    -- Store the system reference as a dbref
    !this.dbRefes.append(!elementRefe)

    -- Name
    if (!elementRefe.type.eq('ASMBLY')) then

      if (!elementRefe.asname.eq('')) then
        !this.names.append(!elementRefe.string())

      else
        !this.names.append(!elementRefe.flnn)

      endif

    else
      !this.names.append(!elementRefe.flnn)

    endif

    -- Check the element for any valid elements
    if (!elementRefe.type.eq('HVAC')) then

      -- Initialise variables
      !noBranMem = false
      !allComp   = ARRAY()

      -- Test for empty HVAC
      if (!elementRefe.mem.unset() or !elementRefe.mem.empty()) then
        !noMembers = true

      else
        !noMembers = false

      endif

      -- Test for empty BRAN
      VAR !allBran COLL ALL BRAN FOR $!elementRefe

      do !bran val !allBran

         !allComp.append(!bran.dbref().mem)

      enddo

      -- If there are not any components then this HVAC is invalid
      if (!allComp.unset() or !allComp.empty()) then
         !noBranMem = true

      endif

      -- If there are not any members or components then this HVAC is invalid
      if (!noMembers or !noBranMem) then
        !this.contents.append(false)

      else
        !this.contents.append(true)

      endif

    elseif (!elementRefe.type.eq('ASMBLY')) then

      if (!elementRefe.sexpnd.size().eq(0)) then
        !this.contents.append(false)

      else
        !this.contents.append(true)

      endif

    elseif (!elementRefe.type.eq('HSPOOL')) then

      -- Test form spool components
      !hvacSpoolManager = object HVACSPOOLMANAGER()
      !components       = !hvacSpoolManager.getMtoElementsForSpool(!elementRefe)

      if (!components.unset() or !components.empty()) then
        !this.contents.append(false)

      else
        !this.contents.append(true)

      endif

    elseif (!elementRefe.type.eq('CWAY')) then

      -- Initialise variables
      !tooManyCtmtrl = false
      !noCtmtrl      = false
      !allComp       = ARRAY()

      -- Test for empty CWAY
      if (!elementRefe.mem.unset() or !elementRefe.mem.empty()) then
        !noMembers = true

      else
        !noMembers = false

      endif

      -- Get all components, assuming we have stopped the process of a CWAY with >1 CTMTRL
      VAR !allCtmtrl COLL ALL CTMTRL FOR $!elementRefe

      do !ctmtrl val !allCtmtrl

        do !ctmtrlMember val !ctmtrl.dbref().mem

          !allComp.appendArray(!ctmtrlMember.mem)

        enddo

      enddo

      -- If there is more than one CTMTRL then this CWAY is invalid
      if (!allCtmtrl.size().gt(1)) then
        !tooManyCtmtrl = true

      endif

      -- If there are not any components then this CWAY is invalid
      if (!allComp.unset() or !allComp.empty()) then
        !noCtmtrl = true

      endif

      -- If there is not a CTMTRL or any CWAY members then this CWAY is invalid
       if (!noMembers or !noCtmtrl) then
        !this.contents.append(false)

      else
        !this.contents.append(true)

       endif

    endif

    -- For locked
    !this.locked.append(!elementRefe.lock)

  enddo

endmethod
-- End of method definition for .getData(DBREF,STRING,STRING)

-----------------------------------------------------------------------
--
-- Method:      .remove(ARRAY)
--
-- Description: Remove entries from the data arrays
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       The selected rows
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!mainArray is ARRAY)

  -- Build array of indices to remove
  !getReal = object BLOCK('!mainArray[!evalIndex].real()')
  !indices = !mainArray.evaluate(!getReal)

  -- Remove each element index from the arrays
  do !index val !indices

    !this.dbRefes.deleteFrom(!index,1)
    !this.sysRefs.deleteFrom(!index,1)
    !this.names.deleteFrom(!index,1)
    !this.drawn.deleteFrom(!index,1)
    !this.dwgRefs.deleteFrom(!index,1)
    !this.dwgNames.deleteFrom(!index,1)
    !this.access.deleteFrom(!index,1)
    !this.mode.deleteFrom(!index,1)
    !this.contents.deleteFrom(!index,1)
    !this.locked.deleteFrom(!index,1)

  enddo

  -- Compress all arrays
  !this.dbRefes.compress()
  !this.sysRefs.compress()
  !this.names.compress()
  !this.drawn.compress()
  !this.dwgRefs.compress()
  !this.dwgNames.compress()
  !this.access.compress()
  !this.mode.compress()
  !this.contents.compress()
  !this.locked.compress()

endmethod
-- End of method .remove(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .setDrawn(DBREF,STRING)
--
-- Description: Set report column data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element
--    2   R      STRING      The rule for extracting the Drawing Name from the element name
--    3   R      REAL        The currently used font
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDrawn(!elementRefe is DBREF, !drwgNameRule is STRING, !currFont is REAL)

  -- Get any linked drawing
  !drwgRefe = !!isoGetDocLink(!elementRefe)[1]

  -- If no linkref, then test for an existing drawing using the old method
  if (!drwgRefe.unset() or !drwgRefe.badref()) then

    -- For a named element build the drawing name
    VAR !drwgName EVAL ($!drwgNameRule) FOR $!elementRefe

    -- Test for spaces in the result
    if (!drwgName[1].match(' ').neq(0)) then
      !drawing = '/' & !!elementRefe.name & '/Drawing'

    -- Test for unnamed element
    elseif (!drwgName[1].substring(1,1).eq('=')) then
      !drawing = '/' & !drwgName[1] & '/Drawing'

    else
      !drawing = !drwgName[1] & '/Drawing'

    endif

    -- Test if exists
    VAR !exists EXIST $!drawing
    if (!exists.eq('TRUEA'))then
      !drwgRefe = !drawing.dbref()
    endif

  endif

  -- Has the element been drawn?
  -- No, it has not
  if (!drwgRefe.unset()) then
    !this.drawn.append('   No')
    !this.dwgRefs.append(object DBREF())
    !this.dwgNames.append('   -')
    !this.access.append('   -')
    !this.mode.append('Create')
    !this.validFont.append(true)

  -- Does it have a bad drawing reference
  elseif (!drwgRefe.badref()) then
    !this.drawn.append('   Badref')
    !this.dwgRefs.append(object DBREF())
    !this.dwgNames.append('   Bad Reference')
    !this.access.append('   - ')
    !this.mode.append('Create')
    !this.validFont.append(true)

  -- Yes, it has
  else

    -- Set drawn as yes
    !this.drawn.append('   Yes')

    -- Is the drawing font compatible with the application library?
    if (!drwgRefe.font.between(1,4) and !currFont.gt(4)) then
      !this.validFont.append(false)

    else
      !this.validFont.append(true)

    endif

    -- Get db access rights and whether claimable
    -- Db is writable
    if (!drwgRefe.dbwrite) then

      -- Multiwrite db
      if (!drwgRefe.dbAccess.eq('MULTIWRITE')) then

        -- Get the current user
        !currSession = current session
        !currUser    = !currSession.user().name

        -- Check whether the current user has claimed out the drawing
        if (!drwgRefe.userc.eq(!currUser)) then
          !this.access.append('   Yes')

        -- The drawing can be claimed and is not claimed out
        elseif (!drwgRefe.okClaim and !drwgRefe.lclm.not()) then
          !this.access.append('   Yes')

        -- Cannot claim the drawing
        else
          !this.access.append('   No')

        endif

      -- Update db
      else
        !this.access.append('   Yes')

      endif

    -- Db is not writable
    else
      !this.access.append('   No')

    endif

    -- Set update mode
    !this.mode.append('Update')

    -- Store drwg reference
    !this.dwgRefs.append(!drwgRefe)

    -- Store drwg name
    !this.dwgNames.append(!drwgRefe.flnn)

  endif

endmethod
-- End of method .setDrawn(DBREF,STRING)
