--
-- File:            isodefaults.pmlobj
--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
-- Description:
-- Every default setting for this application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts()                       ARRAY               Method to initialize the form
--  getDrwgNoDflts()                 ISODRWGNODFLTS      Get the Drawing Number defaults when using a Name Sequence
--
------------------------------------------------------------------------
define object ISODEFAULTS

  member .file            is FILE
  member .drwgNameRule    is STRING
  member .lineNumbRule    is STRING
  member .drawListLiby    is DBREF
  member .isoRegister     is DBREF
  member .stdLibrary      is DBREF
  member .reprRuleset     is DBREF
  member .backingSheet    is DBREF
  member .standardPatt    is DBREF
  member .hvacRule        is STRING
  member .elecRule        is STRING
  member .splitMethod     is STRING
  member .startRev        is STRING
  member .initialRev      is STRING
  member .internalRev     is ARRAY
  member .externalRev     is ARRAY
  member .dateFormat      is STRING
  member .dateZone        is STRING
  member .narrSymbols     is ARRAY
  member .limitsBoxes     is ARRAY
  member .loaded          is BOOLEAN
  member .drwgAttribs     is ARRAY
  member .cwayDrwgAttribs is ARRAY
  member .isoContent      is ISOCONTENT
  member .hvacMtoGen      is ISOMTOGEN
  member .elecMtoGen      is ISOMTOGEN
  member .hvacElevTag     is ISOELEVTAG
  member .elecElevTag     is ISOELEVTAG
  member .hvacContTag     is ISOCONTTAG
  member .elecContTag     is ISOCONTTAG
  member .hvacNamedTag    is ISONAMEDTAG
  member .elecNamedTag    is ISONAMEDTAG
  member .hvacSpecBrk     is ISOSPECBRK
  member .elecSpecBrk     is ISOSPECBRK
  member .hvacInsulBrk    is ISOINSULBRK
  member .elecInsulBrk    is ISOINSULBRK
  member .hvacDimn        is ISODIMENSION
  member .elecDimn        is ISODIMENSION
  member .hvacPeneTag     is ISOPENETAG
  member .elecPeneTag     is ISOPENETAG
  member .hvacOrigin      is ISORIGIN
  member .elecOrigin      is ISORIGIN
  member .hvacMdsTag      is ISOMDSTAG
  member .elecMdsTag      is ISOMDSTAG
  member .drwgNoDflts     is ISODRWGNODFLTS

  member .revs            is ARRAY

  -- Outputs
  member .outputXls       is BOOLEAN
  member .xlsFolder       is FILE
  member .outputPdf       is BOOLEAN
  member .pdfFolder       is FILE

  -- The defaults values for those setting that are type DBREF
  -- These will be used on application start-up when they do not exist
  member .isoRegisterDef  is STRING
  member .stdLibraryDef   is STRING
  member .reprRulesetDef  is STRING
  member .backingSheetDef is STRING
  member .standardPattDef is STRING

  -- Module specific
  member .module          is ISOMODULE

  -- Version
  member .prevVersion     is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of errors encountered
--
------------------------------------------------------------------------
define method .getDflts() is ARRAY

  -- Initialise variables
  !this.loaded      = true
  !errors           = ARRAY()
  !limits           = ARRAY()
  !this.prevVersion = false

  -- Determine default file depending on module being used
  -- PDMS
  if (!this.module.description.eq('DRAFT')) then

    -- Imperial
    if (!!isImperialLength('DIST')) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ADP-IMP'

      -- If using 11.6 this file will not exist, so use the metric version and overwrite the limits below
      !actualFile = object FILE(!defaultsFileName)
      if (!actualFile.exists().not()) then
        !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ADP'
        !this.prevVersion = true

      endif

    -- Metric
    else
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ADP'

    endif

  -- Marine
  else

    -- Imperial
    if (!!isImperialLength('DIST')) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ADP-MAR-IMP'

    -- Metric
    else
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ADP-MAR'

    endif

  endif

  -- Build the file object
  !file = object FILE(!defaultsFileName)

  -- Test for missing file
  if (!file.exists().not()) then
    !!alert.error('The defaults file ' & !defaultsFileName & ' does not exist! Please contact your Administrator.')
    !errors.append('Defaults File ' & !defaultsFileName & ' does not exist.')

    -- Done
    !this.loaded = false
    return !errors

  endif

  -- Read defaults file
  !contents = !file.readfile()

  -- Get defaults
  !start = !contents.findfirst('-- Part 1 - Production defaults')
  !end   = !contents.findfirst('-- Part 2 - Revision Ranges')
  !part1 = !contents.from(!start + 1, !end - 1 - !start)

  !start = !contents.findfirst('-- Part 2 - Revision Ranges')
  !end   = !contents.findfirst('-- Part 3 - North Arrow Symbols')
  !part2 = !contents.from(!start + 1, !end - 1 - !start)

  !start = !contents.findfirst('-- Part 3 - North Arrow Symbols')
  !end   = !contents.findfirst('-- Part4 - Limits Boxes')
  !part3 = !contents.from(!start + 1, !end - 1 - !start)

  !start = !contents.findfirst('-- Part4 - Limits Boxes')
  !end   = !contents.findfirst('-- Part5 - Output')

  -- For upgrade from 11 to 12 test is the defaults file is old
  if (!end.unset()) then

    !part4 = !contents.from(!start + 1)
    !part5[1] = 'TRUE'
    !part5[2] = '%PDMSUSER%\MtoFiles'
    !part5[3] = 'FALSE'
    !part5[4] = '%PDMSUSER%\PdfFiles'
    !part6[1] = 'VOLUME'

  else

    !part4 = !contents.from(!start + 1, !end - 1 - !start)
    !start = !contents.findfirst('-- Part5 - Output')
    !end   = !contents.findfirst('-- Part 6 - Spool Splitting')
    !part5 = !contents.from(!start + 1, !end - 1 - !start)
    !part6 = !contents.from(!end + 1)

  endif

  -- Save some arrays for the defaults form <<<<<<< CHANGE THIS IN THE FUTURE TO READ DIRECTLY FROM THIS OBJECT MEMBERS
  !this.revs = !part2

  -- Store data
  -- For imperial use the actual file name in case it was replaced by the metric one above
  if (!!isImperialLength('DIST')) then
    !this.file = !actualFile

  else
    !this.file = !file

  endif

  !this.isoRegister = !part1[2].dbref()
    handle (2,109)
      !errors.append('Register ' & !part1[2] & ' does not exist')
      !this.isoRegisterDef = !part1[2]

    elsehandle none

      -- Check whether the REGI is writable
      !regiRefe = !this.isoRegister
      !dbname   = !regiRefe.dbname
      !db       = !!isoFindDb(!dbname)

      if (!db.description.eq('R')) then
        !errors.append('Register ' & !part1[2] & ' is READ only')
      endif

    endhandle

  !this.stdLibrary = !part1[3].dbref()
    handle (2,109)
      !errors.append('Standard Library ' & !part1[3] & ' does not exist')
      !this.stdLibraryDef = !part1[3]
    endhandle

  !this.reprRuleset = !part1[4].dbref()
    handle (2,109)
      !errors.append('Representation ruleset ' & !part1[4] & ' does not exist')
      !this.reprRulesetDef = !part1[4]
    endhandle

  !this.backingSheet = !part1[5].dbref()
    handle (2,109)
      !errors.append('Backing sheet ' & !part1[5] & ' does not exist')
      !this.backingSheetDef = !part1[5]
    endhandle

  !this.standardPatt = !part1[6].dbref()
    handle (2,109)
      !errors.append('Overlay ' & !part1[6] & ' does not exist')
      !this.standardPattDef = !part1[6]
    endhandle

  !this.elecRule     = !part1[7]
  !this.hvacRule     = !part1[8]
  !this.drwgNameRule = !part1[9]
  !this.lineNumbRule = !part1[10]
  !this.startRev     = !part1[11]
  !this.initialRev   = !part1[12]
  !this.dateFormat   = !part1[13]
  !this.dateZone     = !part1[14]
  !this.internalRev  = !part2[1].split(',')
  !this.externalRev  = !part2[2].split(',')
  !this.narrSymbols  = !part3
  !limitsBoxes       = !part4
  !limitsUnits       = !limitsBoxes[1].real().units().shortName().upcase()

  -- Check the limits boxes for pre-12 i.e. values without limits
  -- For an imperial system check for inch units
  if (!!isImperialLength('DIST') and !limitsUnits.eq('')) then

    -- We do not have any inch units so we should set the defaults here
    !limits[1] = 100in
    !limits[2] = 200in
    !limits[3] = 400in
    !limits[4] = 600in
    !limits[5] = 800in


  -- We have inch units or are running a metric system, so we can use the values
  -- We have to force the units mainly for mm because pre-12 they did not exist
  -- This will also handle the case where an imperial project is using a metric defaults file with units
  else

    -- Build the limits array
    do !index ind !limitsBoxes

      -- Test for the number of values since it is 3 at 11.6 and 5 at 12
      -- Version 11.6
      if (!limitsBoxes.size().lt(5)) then

        -- Mark these defaults as being the previous version
        !this.prevVersion = true

        -- Add a new limit as the first, using the first and second limits
        if (!index.eq(1)) then

          -- Calculate the new limit
          !newLimit = !limitsBoxes[1].real() - (!limitsBoxes[2].real() - !limitsBoxes[1].real())
          !limits.append(!newLimit.string())

        endif

        -- Add the default
        !limits.append(!limitsBoxes[!index])

        --  Add a new limit as the last, using the second and third limits
        if (!index.eq(!limitsBoxes.size())) then

          -- Calculate the new limit
          !newLimit  = !limitsBoxes[3].real() + (!limitsBoxes[3].real() - !limitsBoxes[2].real())
          !limits.append(!newLimit.string())

        endif

      -- Version 12
      else
        !limits.append(!limitsBoxes[!index])

      endif

    enddo

  endif

  !this.limitsBoxes = !limits
  !this.outputXls   = !part5[1].boolean()
  !this.xlsFolder   = object FILE(!part5[2])
  !this.outputPdf   = !part5[3].boolean()
  !this.pdfFolder   = object FILE(!part5[4])

  !this.splitMethod  = !part6[1]
    handle any
      !this.splitMethod  = 'VOLUME'
    endhandle

  -- Read drawing attributes defaults fileS
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-ATTRIB')
  if (!file.exists()) then
    !contents         = !file.readfile()
    !this.drwgAttribs = !contents.from(!contents.findfirst('-- DRWG attribute; Associated extraction rule') + 1)
  endif

  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-ATTRIB-CWAY')
  if (!file.exists()) then
    !contents             = !file.readfile()
    !this.cwayDrwgAttribs = !contents.from(!contents.findfirst('-- DRWG attribute; Associated extraction rule') + 1)
  endif

  -- Read the drawing number defaults when using a Name Sequence db
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-DRWGNO')
  if (!file.exists()) then
    !this.drwgNoDflts = object ISODRWGNODFLTS(!file)

  else
    !this.drwgNoDflts.loadFailed(!file)

  endif

  return !errors

endmethod
-- End of method definition for .getDflts(STRING)

-----------------------------------------------------------------------
--
-- Method:      .getDrwgNoDflts()
--
-- Description: Get the Drawing Number defaults when using a Name Sequence
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDrwgNoDflts() is ISODRWGNODFLTS

  return !this.drwgNoDflts

endmethod
-- End of method definition for .getDrwgNoDflts()
