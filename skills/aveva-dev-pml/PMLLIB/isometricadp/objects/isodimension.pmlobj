--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
-- Description:
-- Dimension default settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dimension(ARRAY)                 -                   Set this members to passed data
--  getDflts(STRING)                 -                   Method to initialise the form
--
------------------------------------------------------------------------
define object ISODIMENSION

  member .file        is FILE
  member .function    is STRING
  member .tColour     is REAL
  member .cHei        is REAL
  member .lColour     is REAL
  member .term        is STRING
  member .offset      is REAL
  member .relBore     is BOOLEAN
  member .group       is REAL
  member .callback    is STRING
  member .icon        is STRING
  member .type        is STRING
  member .preferred   is BOOLEAN
  member .description is STRING
  member .lStyle      is STRING
  member .lThickness  is STRING
  member .gapAccuracy is REAL
  member .loaded      is BOOLEAN
  member .prevVersion is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts(STRING)
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts(!type is STRING)

  -- Initialise variables
  !this.prevVersion = false

  -- Read defaults file
  -- Imperial
  if (!!isImperialLength('DIST')) then
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-DIMENSION-IMP'

    -- If using 11.6 this file will not exist, so use the metric version and overwrite the chei & offset below
    !actualFile = object FILE(!defaultsFileName)
    if (!actualFile.exists().not()) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-DIMENSION'
      !this.prevVersion = true

    endif

  -- Metric
  else
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-DIMENSION'

  endif

  -- Build file object
  !file = object FILE(!defaultsFileName)

  -- Test for existing defaults file
  if (!file.exists().not()) then
    !!alert.error('The defaults file ' & !defaultsFileName & ' does not exist! Please contact your Administrator.')
    !this.loaded = false
    return
  endif

  -- Initialise variables
  !contents = !file.readfile()
  !start    = !contents.findfirst('-- Part 1 - Hvac')
  !end      = !contents.findfirst('-- Part 2 - Electrical')

  -- Extract defaults depending on type
  if (!type.eq('HVAC')) then
    !data = !contents.from(!start + 1, !end - 1 - !start)
  else
    !data = !contents.from(!end + 1)
  endif

  -- Store data
  -- For imperial use the actual file name in case it was replaced by the metric one above
  if (!!isImperialLength('DIST')) then
    !this.file = !actualFile

  else
    !this.file = !file

  endif

  !this.function   = !data[1]
  !this.term       = !data[5]
  !this.relBore    = !data[7].boolean()

  -- Look for 12.1 style defaults
  if (defined(!data[8])) then
    !this.tColour    = !data[2].real()
    !this.lColour    = !data[4].real()
    !this.lStyle     = !data[8]
    !this.lThickness = !data[9]

  -- Set them
  else
    !this.tColour     = 1
    !this.lColour     = 1
    !this.lStyle      = 'Solid'
    !this.lThickness  = 'Thin'
    !this.prevVersion = true

  endif

  -- Look for text height units
  !cHeiUnits       = !data[3].real().units().shortName()

  -- Check the distance values for pre-12 i.e. values without limits
  -- For an imperial system check for inch units
  if (!!isImperialLength('DIST') and !cHeiUnits.eq('')) then

    -- We do not have any inch units so we should set the defaults here
    !this.cHei        = 0.125in
    !this.offset      = 1in

    -- Get electrical gap accuracy
    if (!type.eq('CWAY')) then
      !this.gapAccuracy = 0.125in
    endif

  -- We have inch units or are running a metric system, so we can use the values
  -- We have to force the units mainly for mm because pre-12 they did not exist
  -- This will also handle the case where an imperial project is using a metric defaults file with units
  else

    !this.cHei        = !data[3].real(!!isoTextFormat)
    !this.offset      = !data[6].real(!!isoOffsetFormat)

    -- Get electrical gap accuracy
    if (!type.eq('CWAY')) then

      -- Test for defined default
      if (defined(!data[10])) then
        !this.gapAccuracy = !data[10].real(!!isoOffsetFormat)

      -- Set it
      else

        -- Test for units
        if (!!isImperialLength('DIST') and !cHeiUnits.eq('')) then
          !this.gapAccuracy = 0.125in

        else
          !this.gapAccuracy = 3mm

        endif

      endif

    endif

  endif

endmethod
-- End of method definition for .getDflts(STRING)

-----------------------------------------------------------------------
--
-- Method:      .dimension(ARRAY)
--
-- Description: Set this members to passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimension(!arrayOfValues is ARRAY)

  -- Set values
  !this.group       = !arrayOfValues[1].real()
  !this.type        = !arrayOfValues[2]
  !this.callback    = !arrayOfValues[3]
  !this.icon        = !arrayOfValues[4]
  !this.preferred   = !arrayOfValues[5].boolean()
  !this.description = !arrayOfValues[6]

endmethod
-- End of method definition for .dimension(ARRAY)
