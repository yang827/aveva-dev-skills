-- File:            isodisplaydrwg.pmlobj
--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- Used within the search utility to hold the owned sheets for a drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoDisplayDrwg(DBREF)            -                   Constructor
--  isoDisplayDrwg(DBREF,ARRAY)      -                   Constructor
--  setEntries(REAL,ARRAY)           -                   Set the array of mto table entries
--  setSheet(DBREF)                  -                   Set the arrays holding child sheets
--
------------------------------------------------------------------------
define object ISODISPLAYDRWG

  member .drwgRefe   is DBREF

  member .drwgName   is STRING

  member .drwgNumb   is STRING

  member .drwgLine   is STRING

  member .sheetRefs  is ARRAY

  member .sheets     is ARRAY

  member .mtoEntries is ARRAY

  member .pdfFiles   is ARRAY

  member .partsList  is FILE

endobject

-----------------------------------------------------------------------
--
-- Method:      .isoDisplayDrwg(DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDisplayDrwg(!dbref is DBREF)

  !this.drwgRefe = !dbref
  !this.drwgName = !dbref.flnn
  !this.drwgNumb = !dbref.attribute('DrwgNumber')
  !this.drwgLine = !dbref.attribute(':IdpLineNo')

endmethod
-- End of method definition for .isoDisplayDrwg(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .isoDisplayDrwg(DBREF,ARRAY)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Drawing reference
--    2   R      ARRAY       Array of Sheet references as STRINGs
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDisplayDrwg(!dbref is DBREF, !sheets is ARRAY)

  !this.drwgRefe = !dbref
  !this.drwgName = !dbref.flnn
  !this.drwgNumb = !dbref.attribute('DrwgNumber')
  !this.drwgLine = !dbref.attribute(':IdpLineNo')
  !this.sheets   = !sheets

endmethod
-- End of method definition for .isoDisplayDrwg(DBREF,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .setSheet(DBREF)
--
-- Description: Set the arrays holding child sheets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSheet(!dbref is DBREF)

  -- Store the sheet reference and as a string
  !this.sheetRefs.append(!dbref)
  !this.sheets.append(!dbref.string())

endmethod
-- End of method definition for .setSheet(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .setEntries(ARRAY)
--
-- Description: Set the array of mto table entries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setEntries(!shtNumber is REAL, !array is ARRAY)

  !this.mtoEntries[!shtNumber] = !array

endmethod
-- End of method definition for .setEntries(ARRAY)
