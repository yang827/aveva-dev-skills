-- File:            isodrwgnodflts.pmlobj
--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 Sep 2010
--
-- Description:
-- Holds the data for the Isometric drawing number
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getElecSettings()                ARRAY               Get the settings for Electrical
--  getHvacSettings()                ARRAY               Get the settings for HVAC
--  isoDrwgNoDflts(FILE)             -                   Construct
--  loadFailed(FILE)                 -                   Set the defaults when the defaults file has failed to load
--  readDefaults()                   -                   Read the defaults file
--  saveSettings(STRING,ARRAY)       -                   Save the passed settings
--  saveToFile()                     -                   Save the passed settings
--

-- .method        The method to use NSEQ or FILE
--
-- .elecPrefix    The prefix characters
-- .elecSuffix    The suffix characters
-- .elecStartNumb The start number for the index
-- .elecSeparator The separator character
--
-- .hvacPrefix    The prefix characters
-- .hvacSuffix    The suffix characters
-- .hvacStartNumb The start number for the index
-- .hvacSeparator The separator character
--
-- .prevVersion   Whether the version of the loaded defaults files is 11.6 and/or Imperial
--
------------------------------------------------------------------------
define object ISODRWGNODFLTS

  -- Defaults file
  member .file          is FILE

  -- Which method to use
  member .method        is STRING

  -- Electrical
  member .elecPrefix    is STRING
  member .elecSuffix    is STRING
  member .elecStartNumb is STRING
  member .elecSeparator is STRING

  -- HVAC
  member .hvacPrefix    is STRING
  member .hvacSuffix    is STRING
  member .hvacStartNumb is STRING
  member .hvacSeparator is STRING

  -- Comment lines
  member .comments      is ARRAY

  -- Internal settings
  member .setLocs       is ARRAY
  member .prevVersion   is BOOLEAN

endobject

------------------------------------------------------------------------
--
-- Method:        .isoDrwgNoDflts(FILE)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        The defaults file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoDrwgNoDflts(!file is FILE)

  -- Initialise the version
  !this.prevVersion = false

  -- Store the defaults file
  !this.file = !file

  -- Read the defaults
  !this.readDefaults()

endmethod
-- End of method definition for .isoDrwgNoDflts(FILE)

------------------------------------------------------------------------
--
-- Method:      .getElecSettings()
--
-- Description: Get the settings for Electrical
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Use NSEQ  BOOLEAN
--                [2] Prefix    STRING
--                [3] Suffix    STRING
--                [4] StartNumb REAL
--                [5] Separator STRING
--
------------------------------------------------------------------------
define method .getElecSettings() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Build return array
  !array.append(!this.method.eq('NSEQ'))
  !array.append(!this.elecPrefix)
  !array.append(!this.elecSuffix)
  !array.append(!this.elecStartNumb)
  !array.append(!this.elecSeparator)

  return !array

endmethod
-- End of method .getElecSettings()

------------------------------------------------------------------------
--
-- Method:      .getHvacSettings()
--
-- Description: Get the settings for HVAC
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Use NSEQ  BOOLEAN
--                [2] Prefix    STRING
--                [3] Suffix    STRING
--                [4] StartNumb REAL
--                [5] Separator STRING
--
------------------------------------------------------------------------
define method .getHvacSettings() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Build return array
  !array.append(!this.method.eq('NSEQ'))
  !array.append(!this.hvacPrefix)
  !array.append(!this.hvacSuffix)
  !array.append(!this.hvacStartNumb)
  !array.append(!this.hvacSeparator)

  return !array

endmethod
-- End of method .getHvacSettings()

------------------------------------------------------------------------
--
-- Method:      .loadFailed(FILE)
--
-- Description: Set the defaults when the defaults file has failed to load
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        The defaults file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadFailed(!file is FILE)

  -- Force the default settings
  !this.file          = !file
  !this.method        = 'NSEQ'
  !this.elecPrefix    = 'AVEVA'
  !this.elecSuffix    = 'CW'
  !this.elecStartNumb = '0001'
  !this.elecSeparator = ' '
  !this.hvacPrefix    = 'HV'
  !this.hvacSuffix    = 'AVEVA'
  !this.hvacStartNumb = '5001'
  !this.hvacSeparator = ' '

  -- Mark as the previous version where these defaults did not exist
  !this.prevVersion   = true

endmethod
-- End of method .loadFailed(FILE)

------------------------------------------------------------------------
--
-- Method:      .readDefaults()
--
-- Description: Read the defaults file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readDefaults()

  -- Initialise variables
  !this.comments.clear()
  !this.setLocs.clear()
  !contents = ARRAY()

  -- Read file
  !content = !this.file.readfile()

  -- Process the configuration file
  do !index ind !content

    -- Initialise variables
    !entry = !content[!index]

    -- Get location of all comment lines #
    if (!entry.substring(1,1).eq('#')) then

      !this.comments[!index] = !entry

    -- Store settings
    else

      !contents.append(!entry)
      !this.setLocs.append(!index)

    endif

  enddo

  -- Set object members to configuration file values
  !this.method        = !contents[1].after('=').trim('lr')

  !this.elecPrefix    = !contents[2].after('=').trim('lr')
  !this.elecSuffix    = !contents[3].after('=').trim('lr')
  !this.elecStartNumb = !contents[4].after('=').trim('lr')
    handle any
      !this.elecStartNumb = 1001
    endhandle

  !this.elecSeparator = !contents[5].after('=').trim('lr').replace('space',' ')

  !this.hvacPrefix    = !contents[6].after('=').trim('lr')
  !this.hvacSuffix    = !contents[7].after('=').trim('lr')
  !this.hvacStartNumb = !contents[8].after('=').trim('lr')
    handle any
      !this.hvacStartNumb = 5001
    endhandle

  !this.hvacSeparator = !contents[9].after('=').trim('lr').replace('space',' ')

endmethod
-- End of method .readDefaults()

------------------------------------------------------------------------
--
-- Method:      .saveSettings(STRING,ARRAY)
--
-- Description: Save the passed settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Discipline type HVAC or ELEC
--    2   R      ARRAY       [1] Use NSEQ  BOOLEAN
--                           [2] Prefix    STRING
--                           [3] Suffix    STRING
--                           [4] StartNumb REAL
--                           [5] Separator STRING
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveSettings(!type is STRING, !array is ARRAY)

  -- Test whether to use an NSEQ db
  if (!array[1]) then
    !this.method        = 'NSEQ'

  else
    !this.method        = 'FILE'

  endif

  -- Electrical
  if (!type.eq('ELEC')) then

    !this.elecPrefix    = !array[2]
    !this.elecSuffix    = !array[3]
    !this.elecStartNumb = !array[4]
    !this.elecSeparator = !array[5]

  -- HVAC
  else

    !this.hvacPrefix    = !array[2]
    !this.hvacSuffix    = !array[3]
    !this.hvacStartNumb = !array[4]
    !this.hvacSeparator = !array[5]

  endif

endmethod
-- End of method .saveSettings(STRING,ARRAY)

------------------------------------------------------------------------
--
-- Method:      .saveToFile()
--
-- Description: Save the passed settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToFile()

   -- Initialise variables
  !settings = ARRAY()
  !contents = !this.comments

  -- Write file if it already exists
  if (!this.file.exists()) then

    -- Build contents array
    !settings.append('method = ' & !this.method)
    !settings.append('prefix = ' & !this.elecPrefix)
    !settings.append('suffix = ' & !this.elecSuffix)
    !settings.append('startIndex = ' & !this.elecStartNumb)
    !settings.append('separator = ' & !this.elecSeparator.replace(' ','space'))
    !settings.append('prefix = ' & !this.hvacPrefix)
    !settings.append('suffix = ' & !this.hvacSuffix)
    !settings.append('startIndex = ' & !this.hvacStartNumb)
    !settings.append('separator = ' & !this.hvacSeparator.replace(' ','space'))

    -- Add settings to the comments to build the contents
    !count = 0
    do !index val !this.setLocs
      !count            = !count + 1
      !contents[!index] = !settings[!count]
    enddo

    -- Write file
    !this.file.writefile('OVER',!contents)

  -- If using 11.6 settings then this file does not exist
  else

    !contents.append('#')
    !contents.append('# Configuration file for the Isometric Drawing application')
    !contents.append('# Drawing Number calculation settings when using a Name Sequence Database')
    !contents.append('# Version 12.1 version 1.0')
    !contents.append('# ------------------------------------------------------------------------------------')
    !contents.append('#')
    !contents.append('# METHOD TO USE')
    !contents.append('#')
    !contents.append('# Whether to use an NSEQ for index numbering')
    !contents.append('# or to use the original FILE based methodology;')
    !contents.append('#')
    !contents.append('method = ' & !this.method)
    !contents.append('# method = FILE')
    !contents.append('#')
    !contents.append('# ------------------------------------------------------------------------------------')
    !contents.append('#')
    !contents.append('# ELECTRICAL')
    !contents.append('#')
    !contents.append('# The values used to determine the drawing number for electrical')
    !contents.append('# The drawing number will be created in the following format;')
    !contents.append('#')
    !contents.append('# prefix + separator + CWAY name + separator + index number + separator + suffix')
    !contents.append('#')
    !contents.append(|# For a space separator use the word 'space'|)
    !contents.append('#')
    !contents.append('prefix = ' & !this.elecPrefix)
    !contents.append('#')
    !contents.append('suffix = ' & !this.elecSuffix)
    !contents.append('#')
    !contents.append('startIndex = ' & !this.elecStartNumb)
    !contents.append('#')
    !contents.append('separator = ' & !this.elecSeparator.replace(' ','space'))
    !contents.append('#')
    !contents.append('# ------------------------------------------------------------------------------------')
    !contents.append('#')
    !contents.append('# HVAC')
    !contents.append('#')
    !contents.append('# The values used to determine the drawing number for electrical')
    !contents.append('# The drawing number will be created in the following format;')
    !contents.append('#')
    !contents.append('# prefix + separator + HVAC name + separator + index number + separator + suffix')
    !contents.append('#')
    !contents.append(|# For a space separator use the word 'space'|)
    !contents.append('#')
    !contents.append('prefix = ' & !this.hvacPrefix)
    !contents.append('#')
    !contents.append('suffix = ' & !this.hvacSuffix)
    !contents.append('#')
    !contents.append('startIndex = ' & !this.hvacStartNumb)
    !contents.append('#')
    !contents.append('separator = ' & !this.hvacSeparator.replace(' ','space'))
    !contents.append('#')
    !contents.append('# ------------------------------------------------------------------------------------')

    -- Write file
    !this.file.writefile('WRITE',!contents)

  endif

endmethod
-- End of method .saveToFile()
