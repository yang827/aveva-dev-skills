-- Created:         27 March 2001
--
--
-- Description:
-- Elevation label default settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts(STRING,STRING)          -                   Method to initialize the form
--
------------------------------------------------------------------------
define object ISOELEVTAG

  member .file        is FILE
  member .template    is DBREF
  member .tempArray   is ARRAY
  member .code        is STRING
  member .tColour     is REAL
  member .cHei        is REAL
  member .fColour     is REAL
  member .offset      is ARRAY
  member .bendConn    is STRING
  member .brcoConn    is STRING
  member .subConn     is STRING
  member .vertOn      is BOOLEAN
  member .vertConn    is STRING
  member .fStyle      is STRING
  member .fThickness  is STRING
  member .lType       is STRING
  member .loaded      is BOOLEAN
  member .prevVersion is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts(STRING)
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The discipline HVAC or CWAY
--    2   R      STRING      The current module description
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts(!type is STRING, !moduleDesc is STRING)

  -- Initialise the version
  !this.prevVersion = false

  -- Determine default file depending on module being used
  -- PDMS
  if (!moduleDesc.eq('DRAFT')) then

    -- Imperial
    if (!!isImperialLength('DIST')) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG-IMP'

      -- If using 11.6 this file will not exist, so use the metric version and overwrite the chei & offset below
      !actualFile = object FILE(!defaultsFileName)
      if (!actualFile.exists().not()) then
        !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG'
        !this.prevVersion = true

      endif

    -- Metric
    else
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG'

    endif


  -- Marine
  else

    -- Imperial
    if (!!isImperialLength('DIST')) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG-MAR-IMP'

    -- Metric
    else
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-ELEV-TAG-MAR'

    endif


  endif

  -- Read defaults file
  !file = object FILE(!defaultsFileName)
  if (!file.exists().not()) then
    !!alert.error('The defaults file ' & !defaultsFileName & ' does not exist! Please contact your Administrator.')
     !this.loaded = false
    return
  endif
  !contents = !file.readfile()

  -- Extract defaults
  !start = !contents.findfirst('-- Part 1 - Hvac')
  !end = !contents.findfirst('-- Part 2 - Electrical')
  if (!type.eq('HVAC')) then
    !data = !contents.from(!start + 1, !end - 1 - !start)
  else
    !data = !contents.from(!end + 1)
  endif

  -- Store data
  -- For imperial use the actual file name in case it was replaced by the metric one above
  if (!!isImperialLength('DIST')) then
    !this.file = !actualFile

  else
    !this.file = !file

  endif

  -- HVAC
  if (!type.upCase().eq('HVAC')) then

    -- Initialise variables
    !errors = false

    -- Build the actual template names with the suffix for the BRCO
    !sytm[1] = !data[1]
    !sytm[2] = !data[1] & ':BRCO'

    -- Check if entered element actually exists
    do !template val !sytm
      !unusedTest = !template.dbref()
        handle (2,109)
          !!alert.error('The symbolic template $!template does not exist')
          !errors = true
          break
        endhandle
    enddo

    -- Store templates
    if (!errors.not()) then
      do !template val !sytm
        !this.tempArray.append(!template.dbref())
      enddo
    endif

    -- Read the hash code
    !this.code = !data[2]

    -- Read the connection data
    !this.bendConn   = !data[7]
    !this.brcoConn   = !data[8]
    !this.subConn    = !data[9]
    !this.vertOn     = !data[10].boolean()
    !this.vertConn   = !data[11]

    -- Read the style settings
    if (defined(!data[12])) then
      !this.tColour    = !data[3].real()
      !this.fColour    = !data[5].real()
      !this.fStyle     = !data[12]
      !this.fThickness = !data[13]

    -- Set them
    else
      !this.tColour     = 1
      !this.fColour     = 1
      !this.fStyle      = 'Solid'
      !this.fThickness  = 'Thin'
      !this.prevVersion = true

    endif

    -- Look for text height units
    !cHeiUnits       = !data[3].real().units().shortName()

    -- Check the limits boxes for pre-12 i.e. values without limits
    -- For an imperial system check for inch units
    if (!!isImperialLength('DIST') and !cHeiUnits.eq('')) then

      -- We do not have any inch units so we should set the defaults here
      !this.cHei      = 0.1in
      !this.offset[1] = 0.5in
      !this.offset[2] = 0.5in

    -- We have inch units or are running a metric system, so we can use the values
    -- We have to force the units mainly for mm because pre-12 they did not exist
    -- This will also handle the case where an imperial project is using a metric defaults file with units
    else

      !this.cHei      = !data[4].real(!!isoTextFormat)
      !this.offset[1] = !data[6].split()[1].real(!!isoOffsetFormat)
      !this.offset[2] = !data[6].split()[2].real(!!isoOffsetFormat)

    endif

  -- CWAY
  else

    !this.template = !data[1].dbref()
      handle (2,109)
        !!alert.error('The symbolic template $!data[1] does not exist')
        return
      endhandle

    -- Added at version 12.1 so check if defaults file contains them
    if (defined(!data[6])) then
      !this.tColour    = !data[2].real()
      !this.fColour    = !data[4].real()
      !this.lType      = !data[6]
      !this.fStyle     = !data[7]
      !this.fThickness = !data[8]
      !this.bendConn   = !data[9]
      !this.vertOn     = !data[10].boolean()
      !this.vertConn   = !data[11]

    else
      !this.tColour    = 1
      !this.fColour    = 1
      !this.lType      = 'General'
      !this.fStyle     = 'Solid'
      !this.fThickness = 'Thin'
      !this.bendConn   = 'P0'
      !this.vertOn     = true
      !this.vertConn   = 'P2'

    endif

    -- Look for text height units
    !cHeiUnits       = !data[3].real().units().shortName()

    -- Check the distance values for pre-12 i.e. values without limits
    -- For an imperial system check for inch units
    if (!!isImperialLength('DIST') and !cHeiUnits.eq('')) then

      -- We do not have any inch units so we should set the defaults here
      !this.cHei      = 0.1in
      !this.offset[1] = 0.5in
      !this.offset[2] = 0.5in

    -- We have inch units or are running a metric system, so we can use the values
    -- We have to force the units mainly for mm because pre-12 they did not exist
    -- This will also handle the case where an imperial project is using a metric defaults file with units
    else

      !this.cHei      = !data[3].real(!!isoTextFormat)
      !this.offset[1] = !data[5].split()[1].real(!!isoOffsetFormat)
      !this.offset[2] = !data[5].split()[2].real(!!isoOffsetFormat)

    endif

  endif

endmethod
-- End of method definition
