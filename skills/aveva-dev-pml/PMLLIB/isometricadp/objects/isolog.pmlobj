--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- The log file details
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      -                   Add a message to this log
--  alphaEnd()                       -                   Close any running alpha logs
--  alphaStart()                     -                   Open an alpha log file
--  read(FILE)                       -                   Read a passed log file
--  set()                            -                   Set-up the log file
--  write()                          -                   Write this log to file
--
------------------------------------------------------------------------
define object ISOLOG

  member .file      is FILE

  member .alphaFile is FILE

  member .header    is ARRAY

  member .messages  is ARRAY

  member .pdms      is ARRAY

  member .folder    is FILE

  member .contents  is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:        .add(STRING)
--
-- Description:   Add a message to this log
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!message is STRING)

  !this.messages.append(!message)

endmethod
-- End of method definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:        .alphaEnd()
--
-- Description:   Close any running alpha logs
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .alphaEnd()

  -- Close the alpha log file
  ALPHA LOG END
    handle (61,278)
    endhandle

  -- Read alpha file
  !contents = !this.alphaFile.readFile()

  -- Remove file
  !this.alphaFile.deleteFile()

  -- Add only required bits to the pdms array
  do !text value !contents

    skip if (!text.eq(''))
    skip if (!text.match('update drawing if necessary').neq(0))
    skip if (!text.match('Updating Design graphics').neq(0))
    skip if (!text.match('the specified point lies outside the VIEW').neq(0))
    skip if (!text.match('Projection line parallel').neq(0))
    skip if (!text.match('F&M').neq(0))

    !this.pdms.append(!text.replace('Warning:',''))

  enddo

endmethod
-- End of method definition for .alphaEnd()

------------------------------------------------------------------------
--
-- Method:        .alphaStart()
--
-- Description:   Open an alpha log file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .alphaStart()

  -- Open the alpha log file
  ALPHA LOG "$!<this.alphaFile>" OVER
    handle (61,275)
      ALPHA LOG END
      ALPHA LOG "$!<this.alphaFile>" OVER
    endhandle

endmethod
-- End of method definition for .alphaStart()

------------------------------------------------------------------------
--
-- Method:        .set()
--
-- Description:   Set-up the log file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .set()

  -- Initialise variables
  !project     = current project
  !projectCode = !project.code()
  !folder      = object FILE('%PDMSUSER%\LogFiles')
  !date        = object DATETIME()
  !this.header.clear()
  !this.messages.clear()
  !this.pdms.clear()

  -- Build logfile object
  !this.file = object FILE('%PDMSUSER%\LogFiles\isolog' & !date.date().string() & '-' & !date.month().string() & '-' & !date.year().string().subString(3) & '.txt')

  -- Check that the directory exists
  if (!folder.exists().not()) then

    -- Create the folder
    !folderPath = !folder.directory().fullName() & '\' & !folder.entry()
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- Build alpha log file
  !this.alphaFile = object FILE('%PDMSUSER%\LogFiles\alphaLog.txt')

  -- Create file
  !line[1] = ''
  !this.file.writeFile('OVERWRITE',!line)

  -- Header
  !this.header.append('----------------------------------------------------')
  !this.header.append('                  Isometric ADP')
  !this.header.append('----------------------------------------------------')
  !this.header.append(' ')
  !this.header.append(' Project:  ' & !projectCode)
  !this.header.append(' This Log: ' & !this.file.fullName().string())
  !this.header.append(' ')
  !this.header.append(' Started Processing: ' & !date.string())
  !this.header.append(' ')

endmethod
-- End of method definition for .set()

------------------------------------------------------------------------
--
-- Method:        .read(FILE)
--
-- Description:   Read a passed log file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Log file object
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .read(!file is FILE)

  !this.file     = !file

  !this.folder   = !this.file.directory()

  !this.contents = !this.file.readFile()

endmethod
-- End of object definition for .read(FILE)

------------------------------------------------------------------------
--
-- Method:        .write()
--
-- Description:   Write this log to file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .write()

  -- Initialise date
  !date = object DATETIME()

  -- Build output array
  !output = !this.header
  !output.append('__________________________________________________________________________')
  !output.appendArray(!this.messages)
  !output.append('__________________________________________________________________________')
  !output.append(' ')
  !output.append(' Processing complete: ' & !date.string())
  !output.append('__________________________________________________________________________')
  !output.append(' ')
  !output.append(' Draft run-time warnings;')
  !output.append(' ')
  !output.appendArray(!this.pdms)

  -- Write to file
  !this.file.writeFile('OVERWRITE',!output)

endmethod
-- End of method definition for .write()
