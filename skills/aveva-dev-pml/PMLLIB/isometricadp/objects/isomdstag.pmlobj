--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Anand Kalathil
-- Created:         11 May 2005
--
-- Description:
-- The default values for the MDS tags
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts(STRING)                 -                   Method to initialise the form
--
------------------------------------------------------------------------
define object ISOMDSTAG

  member .file        is FILE
  member .element     is STRING
  member .rule        is STRING
  member .drawSymbol  is BOOLEAN
  member .sTemplate   is DBREF
  member .sFColour    is REAL
  member .sFStyle     is STRING
  member .sFThickness is STRING
  member .scale       is REAL
  member .drawLabel   is BOOLEAN
  member .lTemplate   is DBREF
  member .lTColour    is REAL
  member .lCHei       is REAL
  member .lFColour    is REAL
  member .lFStyle     is STRING
  member .lFThickness is STRING
  member .lOffset     is ARRAY
  member .drawDimn    is BOOLEAN
  member .dTColour    is REAL
  member .dChei       is REAL
  member .dColour     is REAL
  member .dStyle      is STRING
  member .dThickness  is STRING
  member .term        is STRING
  member .dOffset     is REAL
  member .relBore     is BOOLEAN
  member .prevVersion is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts(STRING)
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts(!type is STRING)

  -- Initialise the version
  !this.prevVersion = false

  -- Read defaults file
  -- Imperial
  if (!!isImperialLength('DIST')) then
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MDSSUPPORTS-IMP'

    -- If using 11.6 this file will not exist, so use the metric version and overwrite the chei & offset below
    !actualFile = object FILE(!defaultsFileName)
    if (!actualFile.exists().not()) then
      !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MDSSUPPORTS'
      !this.prevVersion = true

    endif

  -- Metric
  else
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MDSSUPPORTS'

  endif

  -- Build the file object
  !file = object FILE(!defaultsFileName)

  -- Test for missing file
  if (!file.exists().not()) then
    !!alert.error('The defaults file ' & !defaultsFileName & ' does not exist! Please contact your Administrator.')
    !this.loaded = false
    return
  endif

  -- Read file contents
  !contents = !file.readfile()

  -- Extract defaults
  !start = !contents.findfirst('-- Part 1 - Hvac')
  !end   = !contents.findfirst('-- Part 2 - Electrical')
  if (!type.eq('HVAC')) then
    !data = !contents.from(!start + 1, !end - 1 - !start)
  else
    !data = !contents.from(!end + 1)
  endif

  -- Get the size of the read data
  -- We will use this to deduce the version
  !dataSize = !data.size()

  -- For imperial use the actual file name in case it was replaced by the metric one above
  if (!!isImperialLength('DIST')) then
    !this.file = !actualFile

  else
    !this.file = !file

  endif

  -- Store remaining data
  !this.element     = !data[1]
  !this.rule        = !data[2]
  !this.drawSymbol  = !data[3].boolean()

  -- Check templates exist
  !this.sTemplate   = !data[4].dbref()
    handle (2,109)
      !!alert.error('The symbolic template $!data[4] does not exist')
    endhandle

  !this.scale       = !data[5].real()

  -- Look for a pre-12 configuration file
  if (!dataSize.eq(19)) then

    !this.prevVersion = true

    !this.sFColour    = 1

    !this.sFStyle     = 'Solid'
    !this.sFThickness = 'Thin'

    -- LABEL
    !this.drawLabel   = !data[7].boolean()

    -- Check templates exist
    !this.lTemplate = !data[8].dbref()
      handle (2,109)
        !!alert.error('The symbolic template $!data[10] does not exist')
      endhandle

    !this.lTColour    = 1
    !this.lFColour    = 1
    !this.lFStyle     = 'Solid'
    !this.lFThickness = 'Thin'

    -- DIMENSION
    !this.drawDimn   = !data[13].boolean()
    !this.dTColour   = 1
    !this.dColour    = 1
    !this.dStyle     = 'Solid'
    !this.dThickness = 'Thin'
    !this.term       = !data[17]
    !this.relBore    = !data[19].boolean()

    -- Look for text height units
    !lCHeiUnits       = !data[10].real().units().shortName()

  -- The file is a 12 version
  else

    !this.sFColour    = !data[6].real()

    !this.sFStyle     = !data[7]
    !this.sFThickness = !data[8]
    !this.drawLabel   = !data[9].boolean()

    -- Check templates exist
    !this.lTemplate   = !data[10].dbref()
      handle (2,109)
        !!alert.error('The symbolic template $!data[10] does not exist')
      endhandle

    !this.lTColour    = !data[11].real()
    !this.lFColour    = !data[13].real()
    !this.lFStyle     = !data[14]
    !this.lFThickness = !data[15]
    !this.drawDimn    = !data[17].boolean()
    !this.dTColour    = !data[18].real()
    !this.dColour     = !data[20].real()
    !this.dStyle      = !data[21]
    !this.dThickness  = !data[22]
    !this.term        = !data[23]
    !this.relBore     = !data[25].boolean()

    -- Look for text height units
    !lCHeiUnits       = !data[12].real().units().shortName()

  endif

  -- Check the distance values for pre-12 i.e. values without limits
  -- For an imperial system check for inch units
  if (!!isImperialLength('DIST') and !lCHeiUnits.eq('')) then

    -- We do not have any inch units so we should set the defaults here
    !this.lCHei       = 0.1in
    !this.lOffset[1]  = 0in
    !this.lOffset[2]  = 0in
    !this.dChei       = 0.1in
    !this.dOffset     = 0.6in

  -- We have inch units or are running a metric system, so we can use the values
  -- We have to force the units mainly for mm because pre-12 they did not exist
  -- This will also handle the case where an imperial project is using a metric defaults file with units
  else

    -- Look for a pre-12 configuration file
    if (!dataSize.eq(19)) then
      !this.lCHei       = !data[10].real(!!isoTextFormat)
      !this.lOffset[1]  = !data[12].split()[1].real(!!isoOffsetFormat)
      !this.lOffset[2]  = !data[12].split()[2].real(!!isoOffsetFormat)
      !this.dChei       = !data[15].real(!!isoTextFormat)
      !this.dOffset     = !data[18].real(!!isoTextFormat)

    else
      !this.lCHei       = !data[12].real(!!isoTextFormat)
      !this.lOffset[1]  = !data[16].split()[1].real(!!isoOffsetFormat)
      !this.lOffset[2]  = !data[16].split()[2].real(!!isoOffsetFormat)
      !this.dChei       = !data[19].real(!!isoTextFormat)
      !this.dOffset     = !data[24].real(!!isoTextFormat)

    endif

  endif

endmethod
-- End of method definition for .getDflts(STRING)
