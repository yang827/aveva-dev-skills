--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 May 1999
--
-- Description:
-- Commands specific to the module in which the application is running
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displaySheet(GADGET,DBREF)       -                   Display a sheet
--  isoModule()                      -                   Construct
--  marPtype()                       -                   Set the marine drawing type
--  submitToPdf(DBREF,STRING,STRING,STRING) -                   Display a sheet
--  submitToPrinter(DBREF,STRING,STRING,STRING) -                   Submit a sheet to a printer
--
------------------------------------------------------------------------
define object ISOMODULE

  member .module      is MODULE

  member .description is STRING

endobject

------------------------------------------------------------------------
--
-- Method:        .isoModule()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoModule()

  -- Read the module key word
  !modKey = !this.module.modKey.upcase()

  -- Get module description
  if (!modKey.eq('MARHDRA') or !modKey.eq('MARDRA')) then
     !this.description = 'HULL'

  elseif (!modKey.eq('MARODRA')) then
     !this.description = 'OUTFITTING'

  elseif (!modKey.eq('DRA')) then
     !this.description = 'DRAFT'

  endif

endmethod
-- End of method definition for .isoModule()

------------------------------------------------------------------------
--
-- Method:        .displaySheet(GADGET,DBREF)
--
-- Description:   Display a sheet
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The view gadget used to display the sheet
--    1   R      DBREF       SHEE reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySheet(!viewGadget is GADGET, !sheeRefe is DBREF)

  -- Initialise variables
  !form   = !viewGadget.owner()
  !gadget = '!!' & !form.name() & '.' & !viewGadget.name()

  -- Access the shee
  !!ce = !sheeRefe

  -- PDMS Draft
--  if (!this.description.eq('DRAFT') or !this.description.eq('OUTFITTING')) then

    -- Display sheet in the main Draft display
    EDIT VIEW $!gadget AREA PUT $!sheeRefe
      handle (64,510)

        !response = !!alert.warning('Sheet ' & !sheeRefe.flnn & ' needs fixing. Do you want me to do it for you?')
        if (!response.eq('YES')) then

          WARNINGS OFF

          !!ce = !sheeRefe

          UPDATE PIC
          UPDATE DESIGN
           handle any
           endhandle

        endif

      elsehandle any
      	!!alert.warning(!!error.text)

      endhandle

    exit

--  elseif (!this.description.eq('HULL')) then

--    !!openMarineSheet('', !sheeRefe)

--  endif

endmethod
-- End of object definition for .displaySheet(GADGET,DBREF)

------------------------------------------------------------------------
--
-- Method:        .marPtype()
--
-- Description:   Set the marine drawing type
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .marPtype()

  -- Check for hull modules
  if (!this.description.eq('HULL')) then

    -- P-20309: The marptype attribute can only be modified using the PROTECTION OFF syntax
    PROTECTION OFF

    -- Set the drawing type to allow it to be filtered by the 'Drawing Type = General Drawing' in the hull form 'Open Drawing'
    MARPTYPE 1

    -- Switch PROTECTION back ON
    PROTECTION ON

  endif

endmethod
-- End of object definition for .marPtype()

------------------------------------------------------------------------
--
-- Method:        .submitToPdf(DBREF,STRING,STRING,STRING)
--
-- Description:   Display a sheet
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Sheet DB Reference
--    2   R      STRING      Folder full pathname where to write files
--    3   R      STRING      The output driver options
--    4   R      STRING      Any overwrite command
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitToPdf(!sheetRefe is DBREF, !pdfFileName is STRING, !options is STRING, !overwrite is STRING)

  -- PDMS Draft
  if (!this.description.eq('OUTFITTING') or !this.description.eq('DRAFT')) then

    -- Plot sheet, whilst converting any white colours to black
    PLOT $!sheetRefe PDF "$!pdfFileName" '$!options' $!overwrite
      handle (44,15)
      	-- File already exists
      endhandle

  elseif (!this.description.eq('HULL')) then

    !!assyMarPdf(!sheeRefe, !pdfFileName)
      handle any
      	!!alert.error(!!error.text)
      endhandle

  endif

endmethod
-- End of object definition for .submitToPdf(DBREF,STRING,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:        .submitToPrinter(DBREF,STRING,STRING,STRING)
--
-- Description:   Display a sheet
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Sheet DB Reference
--    2   R      STRING      Printing Colour Option
--    3   R      STRING      Printing Dialogue Option
--    4   R      STRING      Printing Scale Option
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitToPrinter(!sheeRefe is DBREF, !colourOption is STRING, !dialogOption is STRING, !scaleOption is STRING)

  -- PDMS Draft
  if (!this.description.eq('OUTFITTING') or !this.description.eq('DRAFT')) then

    -- Test if the passed sheet exists
    VAR !exists EXISTS $!sheeRefe
    if (!exists.eq('FALSEA')) then
      !!alert.error('There is nothing displayed hence nothing to print!')
      return
    endif

    -- Submit to printer
    PLOT $!sheeRefe PRINT '$!colourOption $!dialogOption $!scaleOption'

  elseif (!this.description.eq('HULL')) then

    -- Not supported
    !!alert.message('This functionality is not supported at this time.')

  endif

endmethod
-- End of object definition for .submitToPrinter(DBREF,STRING,STRING,STRING)
