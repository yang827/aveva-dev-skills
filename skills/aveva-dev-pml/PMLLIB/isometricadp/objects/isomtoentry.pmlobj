--
-- File:            isomtoentry.pmlobj
--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- Data for an mto table row and the cells that are related to it
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAtext(REAL)                   STRING              Extract cell data
--  getData()                        ARRAY               Extract row data
--  getHeaders()                     ARRAY               Extract column header descriptions
--  getTemplate(REAL)                DBREF               Extract row data
--  isoMtoEntry(DBREF,STRING,STRING,DBREF) -                   Constructor
--  setCellAtext(REAL,STRING)        -                   Set the relevant cell with it's value
--  setHeader(STRING)                -                   Store the passed column header
--
------------------------------------------------------------------------
define object ISOMTOENTRY

  -- General
  member .dbRefes  is ARRAY
  member .type     is STRING
  member .number   is REAL

  -- For cell atext
  member .c1  is STRING
  member .c2  is STRING
  member .c3  is STRING
  member .c4  is STRING
  member .c5  is STRING
  member .c6  is STRING
  member .c7  is STRING
  member .c8  is STRING
  member .c9  is STRING
  member .c10 is STRING
  member .c11 is STRING
  member .c12 is STRING

  member .cellAtext    is ARRAY
  member .cellTemplate is ARRAY

  -- For cell template
  member .t1  is DBREF
  member .t2  is DBREF
  member .t3  is DBREF
  member .t4  is DBREF
  member .t5  is DBREF
  member .t6  is DBREF
  member .t7  is DBREF
  member .t8  is DBREF
  member .t9  is DBREF
  member .t10 is DBREF
  member .t11 is DBREF
  member .t12 is DBREF

  -- Column header descriptions
  member .headers is ARRAY

endobject

-----------------------------------------------------------------------
--
-- Method:      .isoMtoEntry(DBREF,STRING,STRING,DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The elements the mto refers to
--    2   R      STRING
--    3   R      STRING
--    4   R      DBREF
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoMtoEntry(!dbRefe is DBREF, !type is STRING, !string is STRING, !cellRefe is DBREF)

  -- Fill set members
  !this.dbRefes[1] = !dbRefe
  !this.type       = !type

  -- Fill cell with string
  !member = '!this.c' & !cellRefe.:IdpColumn.string()
  $!member = !string

  !this.cellAtext[!cellRefe.attribute(':IdpColumn')] = !string

  -- Fill template with string
  !member = '!this.t' & !cellRefe.:IdpColumn.string()
  $!member = !cellRefe

  !this.cellTemplate[!cellRefe.attribute(':IdpColumn')] = !cellRefe

endmethod
-- End of method definition for .isoMtoEntry(DBREF,STRING,STRING,DBREF)

-----------------------------------------------------------------------
--
-- Method:      .getAtext(REAL)
--
-- Description: Extract cell data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Column number
--
-- Return:
--   [Data Type] [Description]
--    STRING      Cell value
--
------------------------------------------------------------------------
define method .getAtext(!index is REAL) is STRING

  return !this.cellAtext[!index]

endmethod
-- End of method definition for .getAtext(REAL)

-----------------------------------------------------------------------
--
-- Method:      .getData()
--
-- Description: Extract row data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of Cell values
--
------------------------------------------------------------------------
define method .getData() is ARRAY

  return !this.cellAtext

endmethod
-- End of method definition for .getData()

-----------------------------------------------------------------------
--
-- Method:      .getHeaders()
--
-- Description: Extract column header descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       String Column Header Descriptions
--
------------------------------------------------------------------------
define method .getHeaders() is ARRAY

  return !this.headers

endmethod
-- End of method definition for .getHeaders()

-----------------------------------------------------------------------
--
-- Method:      .getTemplate(REAL)
--
-- Description: Extract row data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Column number
--
-- Return:
--   [Data Type] [Description]
--    DBREF       SYTM reference
--
------------------------------------------------------------------------
define method .getTemplate(!index is REAL) is DBREF

  return !this.cellTemplate[!index]

endmethod
-- End of method definition for .getTemplate(REAL)

-----------------------------------------------------------------------
--
-- Method:      .setCellAtext(REAL,STRING)
--
-- Description: Set the relevant cell with it's value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCellAtext(!columnNumber is REAL, !value is STRING)

  !this.cellAtext[!columnNumber] = !value

endmethod
-- End of method definition for .setCellAtext(REAL,STRING)

-----------------------------------------------------------------------
--
-- Method:      .setHeader(STRING)
--
-- Description: Store the passed column header
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Column Header Text
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHeader(!headerText is STRING)

  !this.headers.append(!headerText)

endmethod
-- End of method definition for .setHeader(STRING)
