-- Created:         27 March 2001
--
--
-- Description:
-- The mto table general default settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts(STRING)                 -                   Method to initialize the form
--
------------------------------------------------------------------------
define object ISOMTOGEN

  member .file        is FILE
  member .individual  is BOOLEAN
  member .sorted      is BOOLEAN
  member .separator   is STRING
  member .template    is DBREF
  member .tColour     is REAL
  member .fColour     is REAL
  member .offset      is ARRAY
  member .key         is BOOLEAN
  member .symbol      is BOOLEAN
  member .replace     is BOOLEAN
  member .loaded      is BOOLEAN
  member .fStyle      is STRING
  member .fThickness  is STRING

  -- Electrical specific keys for width x height x length
  member .widthKey    is STRING
  member .heightKey   is STRING
  member .lengthKey   is STRING

  member .prevVersion is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts(STRING)
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts(!type is STRING)

  -- Initialise the version
  !this.prevVersion = false

  -- Read defaults file
  -- Imperial
  if (!!isImperialLength('DIST')) then
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MTO-GEN-IMP'

     -- If using 11.6 this file will not exist, so use the metric version and overwrite the offset below
     !actualFile = object FILE(!defaultsFileName)
     if (!actualFile.exists().not()) then
       !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MTO-GEN'
       !this.prevVersion = true

     endif


  -- Metric
  else
    !defaultsFileName = '%PDMSDFLTS%\IsoADP\DRA-ISO-MTO-GEN'

  endif

  -- Build file object
  !file = object FILE(!defaultsFileName)

  -- Test for missing file
  if (!file.exists().not()) then
    !!alert.error('The defaults file  ' & !defaultsFileName & ' does not exist. Please contact your administrator.')
    !this.loaded = false
    return

  endif

  -- Get file contents
  !contents = !file.readfile()

  -- Extract defaults
  !start = !contents.findfirst('-- Part 1 - Hvac')
  !end = !contents.findfirst('-- Part 2 - Electrical')

  -- Depends on discipline type
  -- HVAC
  if (!type.eq('HVAC')) then

    -- Read relevant part of the array
    !data = !contents.from(!start + 1, !end - 1 - !start)

    -- Set these members
    !this.separator = !data[2]
    !this.key       = !data[3].boolean()
    !this.symbol    = !data[4].boolean()
    !this.replace   = !data[5].boolean()
    !this.template  = !data[6].dbref()
      handle (2,109)
        !!alert.error('There is a defaults file error. You will need to correct the template name')
        !this.loaded = false
        return
      endhandle

    -- Look for offset units
    !offsUnits       = !data[9].split()[1].real().units().shortName()

    -- For style defaults
    if (defined(!data[10])) then
      !this.tColour    = !data[7].real()
      !this.fColour    = !data[8].real()
      !this.fStyle     = !data[10]
      !this.fThickness = !data[11]

    -- Set them
    else
      !this.tColour     = 1
      !this.fColour     = 1
      !this.fStyle      = 'Solid'
      !this.fThickness  = 'Thin'
      !this.prevVersion = true

    endif

    -- Check the distance values for pre-12 i.e. values without limits
    -- For an imperial system check for inch units
    if (!!isImperialLength('DIST') and !offsUnits.eq('')) then

      -- We do not have any inch units so we should set the defaults here
      !this.offset[1] = 0.5in
      !this.offset[2] = 0.5in

    -- We have inch units or are running a metric system, so we can use the values
    -- We have to force the units mainly for mm because pre-12 they did not exist
    -- This will also handle the case where an imperial project is using a metric defaults file with units
    else

      !this.offset[1] = !data[9].split()[1].real(!!isoOffsetFormat)
      !this.offset[2] = !data[9].split()[2].real(!!isoOffsetFormat)

    endif

  -- CWAY
  else

    !data = !contents.from(!end + 1)

    !this.template = !data[2].dbref()
      handle (2,109)
        !!alert.error('There is a defaults file error. You will need to correct it')
        !this.loaded = false
        return
      endhandle

    -- Added at version 12.1, so check if defaults file has these settings
    if (defined(!data[6])) then

      !this.tColour    = !data[3].real()
      !this.fColour    = !data[4].real()
      !this.fStyle     = !data[6]
      !this.fThickness = !data[7]
      !this.separator  = !data[8]
      !this.key        = !data[9].boolean()
      !this.widthKey   = !data[10]
      !this.heightKey  = !data[11]
      !this.lengthKey  = !data[12]

    else
      !this.tColour     = 1
      !this.fColour     = 1
      !this.fStyle      = 'Solid'
      !this.fThickness  = 'Thin'
      !this.separator   = ' x '
      !this.key         = TRUE
      !this.widthKey    = 'w'
      !this.heightKey   = 'h'
      !this.lengthKey   = 'l'
      !this.prevVersion = true

    endif

    -- Look for offset units
    !offsUnits       = !data[5].split()[1].real().units().shortName()

    -- Check the distance values for pre-12 i.e. values without limits
    -- For an imperial system check for inch units
    if (!!isImperialLength('DIST') and !offsUnits.eq('')) then

      -- We do not have any inch units so we should set the defaults here
      !this.offset[1] = 0.5in
      !this.offset[2] = 0.5in

    -- We have inch units or are running a metric system, so we can use the values
    -- We have to force the units mainly for mm because pre-12 they did not exist
    -- This will also handle the case where an imperial project is using a metric defaults file with units
    else

      !this.offset[1] = !data[5].split()[1].real(!!isoOffsetFormat)
      !this.offset[2] = !data[5].split()[2].real(!!isoOffsetFormat)

    endif

  endif

  -- Store data
  -- For imperial use the actual file name in case it was replaced by the metric one above
  if (!!isImperialLength('DIST')) then
    !this.file = !actualFile

  else
    !this.file = !file

  endif

  if (!data[1].eq('INDIV')) then
    !this.individual = true
    !this.sorted = false
  else
    !this.individual = false
    !this.sorted = true
  endif

endmethod
-- End of method definition for .getDflts(STRING)
