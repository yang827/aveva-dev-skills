-- Created:         Wed Jul 25  9:29:05 2007
--
-- Description:
-- Material Parts List creation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  build()                          -                   Build report data
--  clear()                          -                   Clear the object
--  isoPartsList(FILE,ARRAY,STRING)  -                   Construct
--  saveToExcel()                    FILE                Save data to an XLS file
--
------------------------------------------------------------------------
define object ISOPARTSLIST

  member .partFolder   is FILE

  member .data         is ARRAY

  member .sheetHeaders is ARRAY

  member .sheetData    is ARRAY

  member .rootName     is STRING

endobject
-- End of object definition for ISOPARTSLIST

------------------------------------------------------------------------
--
-- Method:        .isoPartsList(FILE,ARRAY)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Report destination folder
--    2   R      ARRAY       Two dimensional array of mto objects for each sheet
--    3   R      STRING      Drawing root name used to name the output file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoPartsList(!plFold is FILE, !data is ARRAY, !rootName is STRING)

  -- Store the passed data
  !this.partFolder = !plFold
  !this.data       = !data

  -- Replace any unsuitable characters from the root name
  !this.rootName = !rootName.replace(' ','_').replace('\','_').replace('/','_').replace('.','_')

  -- Build the data arrays
  !this.build()

endmethod
-- End of method definition for .isoPartsList(FILE,ARRAY)

------------------------------------------------------------------------
--
-- Method:        .build()
--
-- Description:   Build report data
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .build()

  -- For each sheet
  do !index ind !this.data

    -- Initialise arrays
    !sheetMto = !this.data[!index]
    !dataRowSet = ARRAY()

    -- Extract the column headers from the first ISOMTOENTRY object
    !headers = !sheetMto[1].getHeaders()

    -- Build the two dimensional array for the cell data
    do !isoMtoEntry val !sheetMto

      !dataRowSet.append(!isoMtoEntry.getData())

    enddo

    !this.sheetHeaders.append(!headers)
    !this.sheetData.append(!dataRowSet)

  enddo

endmethod
-- End of method definition for .build()

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear the object
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear all arrays
  !this.data.clear()
  !this.sheetHeaders.clear()
  !this.sheetData.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .saveToExcel()
--
-- Description:   Save data to an XLS file
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The Excel file objects
--
------------------------------------------------------------------------
define method .saveToExcel() is FILE

  -- Build the parts list file name
  !fileName = !this.partFolder.fullname() & '\' & !this.rootName & '_PartsList_' & !!isoDateStamp() & '.xls'

   -- Build the parts list file object
  !file = object FILE(!fileName)

  --Create Grid Control Objects
  import 'GridControl'
    handle (1000,0)
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- For each sheet
  do !sheetNo ind !this.data

    !partsDbCtrl  = object NETGRIDCONTROL()

    --Bind the Data Sources to the Grid Control Objects
    !partsDbCtrl.bindToDataSource(object NETDATASOURCE('Parts List', !this.sheetHeaders[!sheetNo], !this.sheetData[!sheetNo]))

    -- Export the parts list data
    !partsDbCtrl.saveGridToExcel(!fileName, 'Sht ' & !sheetNo.string())
      handle (1000,0)
        !!isoLog.messages.append('The system failed in attempting to write the MTO parts list to an open MS Excel file.')
      endhandle

  enddo

  return !file

endmethod
-- End of method definition for .saveToExcel()
