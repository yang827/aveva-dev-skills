-- Created:         27 March 2001
--
--
-- Description:
-- The rectangle definition data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoRectangle(DBREF)              -                   Constructor method
--  max(REAL)                        -                   Calculate the maximum number of entries possible in this rectangle
--
------------------------------------------------------------------------
define object ISORECTANGLE

  member .reference is DBREF
  member .position  is POSITION
  member .tl        is POSITION
  member .tr        is POSITION
  member .bl        is POSITION
  member .br        is POSITION
  member .xlen      is REAL
  member .ylen      is REAL
  member .maxX      is REAL
  member .maxY      is REAL

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .isoRectangle(DBREF)
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoRectangle(!rectRefe is DBREF)

  -- Initialise variables
  !this.reference = !rectRefe
  !this.position  = !rectRefe.ptrf.xypo
  !this.xlen      = !rectRefe.xlen
  !this.ylen      = !rectRefe.ylen
  !hXLen          = !rectRefe.xlen / 2
  !hYlen          = !rectRefe.ylen / 2

  -- Calculate positions of all four corners
  !pv          = object POINTVECTOR()
  !pv.position = !this.position

  if (!this.reference.ocode.upCase().eq('CENTRE')) then

    !halfDiag     = sqrt(pow(!hXLen,2) + pow(!hYlen,2))
    !alpha        = atan(!hYlen / !hXLen)
    !angle        = !alpha - !rectRefe.adeg

    !pv.direction = object DIRECTION('W' & !angle.value() & 'N')
    !this.tl      = !pv.offSet(!halfDiag).position

    !pv.direction = object DIRECTION('E' & !angle.value() & 'S')
    !this.br      = !pv.offSet(!halfDiag).position

    !pv.position  = !this.tl
    !pv.direction = object DIRECTION('E' & !rectRefe.adeg.value() & 'N')
    !this.tr      = !pv.offSet(!rectRefe.xlen).position

    !pv.position  = !this.br
    !pv.direction = object DIRECTION('W' & !rectRefe.adeg.value() & 'S')
    !this.bl      = !pv.offSet(!rectRefe.xlen).position

  elseif (!rectRefe.ocode.upCase().eq('TOPLEFT')) then

    !this.tl      = !this.position

    !pv.direction = object DIRECTION('E' & !rectRefe.adeg.value() & 'N')
    !this.tr      = !pv.offSet(!rectRefe.xlen).position

    !pv.direction = object DIRECTION('S' & !rectRefe.adeg.value() & 'E')
    !this.bl      = !pv.offSet(!rectRefe.ylen).position

    !pv.position  = !this.bl
    !pv.direction = object DIRECTION('E' & !rectRefe.adeg.value() & 'N')
    !this.br      = !pv.offSet(!rectRefe.xlen).position

  elseif (!rectRefe.ocode.upCase().eq('TOPRIGHT')) then

    !this.tr      = !this.position

    !pv.direction = object DIRECTION('W' & !rectRefe.adeg.value() & 'S')
    !this.tl      = !pv.offSet(!rectRefe.xlen).position

    !pv.direction = object DIRECTION('S' & !rectRefe.adeg.value() & 'E')
    !this.br      = !pv.offSet(!rectRefe.ylen).position

    !pv.position  = !this.br
    !pv.direction = object DIRECTION('W' & !rectRefe.adeg.value() & 'S')
    !this.bl      = !pv.offSet(!rectRefe.xlen).position

  elseif (!rectRefe.ocode.upCase().eq('BOTTOMLEFT')) then

    !this.bl      = !this.position

    !pv.direction = object DIRECTION('N' & !rectRefe.adeg.value() & 'W')
    !this.tl      = !pv.offSet(!rectRefe.ylen).position

    !pv.direction = object DIRECTION('E' & !rectRefe.adeg.value() & 'N')
    !this.br      = !pv.offSet(!rectRefe.xlen).position

    !pv.position  = !this.br
    !pv.direction = object DIRECTION('N' & !rectRefe.adeg.value() & 'W')
    !this.tr      = !pv.offSet(!rectRefe.ylen).position

  elseif (!rectRefe.ocode.upCase().eq('BOTTOMRIGHT')) then

    !this.br      = !this.position

    !pv.direction = object DIRECTION('N' & !rectRefe.adeg.value() & 'W')
    !this.tr      = !pv.offSet(!rectRefe.ylen).position

    !pv.direction = object DIRECTION('E' & !rectRefe.adeg.value() & 'S')
    !this.bl      = !pv.offSet(!rectRefe.xlen).position

    !pv.position  = !this.bl
    !pv.direction = object DIRECTION('N' & !rectRefe.adeg.value() & 'W')
    !this.tl      = !pv.offSet(!rectRefe.ylen).position

  endif

endmethod
-- End of method definition for .isoRectangle(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .max(REAL)
--
-- Description: Calculate the maximum number of entries possible in this rectangle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .max(!move is REAL)

  -- Calculate the maximum number of entries possible in the rectangle
  !entriesX = !this.xlen / !move
  !entriesY = !this.ylen / !move

  -- Store integer
  !this.maxX = !entriesX.int()
  !this.maxY = !entriesY.int()

endmethod
-- End of method definition for .max(REAL)
-----------------------------------------------------------------------
