--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         07 May 2010
--
--
-- Description:
-- A drawing revision
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  get()                            ARRAY               Get this object values
--  set(ARRAY)                       -                   Set this object values
--
------------------------------------------------------------------------
define object ISOREVISION

  member .revType      is STRING
  member .revMode      is STRING
  member .revInitValue is STRING
  member .revNextValue is STRING

endobject

-----------------------------------------------------------------------
--
-- Method:      .get()
--
-- Description: Get this object values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of values
--    1   R      ARRAY       Array of string values
--                            [1] Internal or External
--                            [2] Incremental or Specific
--                            [3] The initial revision value
--                            [4] If Specific the value to use
--
------------------------------------------------------------------------
define method .get() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Build array
  !array.append(!this.revType)
  !array.append(!this.revMode)
  !array.append(!this.revInitValue)
  !array.append(!this.revNextValue)

	return !array

endmethod
-- End of method definition for .get()

-----------------------------------------------------------------------
--
-- Method:      .set()
--
-- Description: Set this object values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of string values
--                            [1] Internal or External
--                            [2] Incremental or Specific
--                            [3] The initial revision value
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .set(!values is ARRAY)

  !this.revType      = !values[1]
  !this.revMode      = !values[2]
  !this.revInitValue = !values[3]

endmethod
-- End of method definition for .set()
