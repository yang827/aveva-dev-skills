--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- Isometric origin default settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDflts(STRING)                 -                   Method to initialise the form
--
------------------------------------------------------------------------
define object ISORIGIN

  member .file        is FILE
  member .template    is DBREF
  member .fColour     is REAL
  member .scale       is REAL
  member .fStyle      is STRING
  member .fThickness  is STRING
  member .loaded      is BOOLEAN
  member .prevVersion is BOOLEAN

endobject

-----------------------------------------------------------------------
--
-- Method:      .getDflts(STRING)
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDflts(!type is STRING)

  -- Initialise the version
  !this.prevVersion = false

  -- Build file object
  !file = object FILE('%PDMSDFLTS%\IsoADP\DRA-ISO-ORIGIN')

  -- Test for missing file
  if (!file.exists().not()) then
    !!alert.error('The defaults file %PDMSDFLTS%\IsoADP\DRA-ISO-ORIGIN does not exist! Please contact your Administrator.')
    !this.loaded = false
    return
  endif

  -- Read the file contents
  !contents = !file.readfile()

  -- Extract defaults
  !start = !contents.findfirst('-- Part 1 - Hvac')
  !end   = !contents.findfirst('-- Part 2 - Electrical')
  if (!type.eq('HVAC')) then
    !data = !contents.from(!start + 1, !end - 1 - !start)
  else
    !data = !contents.from(!end + 1)
  endif

  -- Store data
  !this.file = !file

  -- Check templates exist
  !this.template = !data[1].dbref()
    handle (2,109)
      !!alert.error('The symbolic template $!data[1] does not exist')
      return
    endhandle

  -- Look for style defaults
  if (defined(!data[4])) then
    !this.fColour    = !data[2].real()
    !this.scale      = !data[3].real()
    !this.fStyle     = !data[4]
    !this.fThickness = !data[5]

  -- Set them
  else
    !this.fColour     = 1
    !this.scale       = 1
    !this.fStyle      = 'Solid'
    !this.fThickness  = 'Thin'
    !this.prevVersion = true

  endif

endmethod
-- End of method definition for .getDflts(STRING)
