--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
--
-- Description:
-- Data used in searching for a PDMS element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoSearch(STRING)                -                   Constructor method
--
------------------------------------------------------------------------
define object ISOSEARCH

  member .desc is STRING
  member .type is STRING
  member .attr is STRING
  member .rule is STRING

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .isoSearch(STRING)
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoSearch(!data is STRING)

  -- Split data string into parts and set object members
  !array     = !data.split(';')
  !this.desc = !array[1]
  !this.type = !array[2]
  !this.attr = !array[3]

endmethod
-- End of method definition for .isoSearch(STRING)
