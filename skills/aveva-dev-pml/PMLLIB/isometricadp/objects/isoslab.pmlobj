--
--
-- Description:
-- The SLAB definition data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoSlab(DBREF,STRING)            -                   Constructor method
--
------------------------------------------------------------------------
define object ISOSLAB

  member .reference is DBREF
  member .extent    is STRING
  member .check     is BOOLEAN
  member .btext     is ARRAY
  member .overlap   is BOOLEAN

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .isoSlab(DBREF,STRING)
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoSlab(!dbRefe is DBREF,!extent is STRING)

  !this.reference = !dbRefe
  !this.extent    = !extent
  !this.check     = !dbRefe.tmrf.:IdpCheck
  !this.overlap   = false

endmethod
-- End of method definition for .isoSlab(DBREF,STRING)
