--
-- Author:          Steve Wilson
-- Created:         19 August 2009
--
-- Description:
-- Spool Manager
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAdjacent(DBREF)               -                   Add an adjacent part
--  addComponent(DBREF)              -                   Add component to this spool
--  addComponent(DBREF,STRING,BOOLEAN) -                   Add component to this spool
--  addCrossData(DBREF,STRING)       -                   Add cross type component to this spool
--  addData(STRING,DBREF,STRING)     -                   Add continuation to for this spool
--  addPenetration(DBREF,DBREF)      -                   Add a penetration and associated component to this spool
--  addSupport(DBREF,DBREF)          -                   Add support and associated component to this spool
--  clear()                          -                   Clear this object arrays
--  deleteLast(BOOLEAN)              STRING              Delete the last component in this spool
--  getComponents()                  ARRAY               Get the components in this spool
--  getCtmtrl()                      DBREF               Get the ctmtrl owning the components in this spool
--  getData(STRING,STRING)           ARRAY               Get continuation data for this spool
--  getMaterial()                    STRING              get the material of this spool
--  getSize()                        REAL                Get the number of components
--  getSupports(STRING,STRING)       -                   Get the supports in this spool
--  getVolume()                      VOLUME              Get the volume of this spool
--  isoSpool(DBREF)                  -                   Constructor
--  isoSpool(DBREF,DBREF)            -                   Constructor
--  setCtmtrl(DBREF)                 -                   Set the ctmtrl owning the components in this spool
--  setMaterial(DBREF)               -                   Set the material of this spool
--
------------------------------------------------------------------------
define object ISOSPOOL

  -- Components
  member .components      is ARRAY

  -- Owning branch
  member .branch          is DBREF

  -- Owning Cable Material
  member .ctmtrl          is DBREF

  -- Material
  member .material        is STRING

  -- Data for drawings
  member .penetrations    is ARRAY
  member .peneComps       is ARRAY
  member .supports        is ARRAY
  member .suppComps       is ARRAY
  member .contFrom        is STRING
  member .contTo          is STRING
  member .contOn          is ARRAY
  member .crosOn          is ARRAY
  member .adjacent        is ARRAY

endobject

-----------------------------------------------------------------------
--
-- Method:      .isoSpool(DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The reference of the owning BRAN
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoSpool(!branRefe is DBREF)

  !this.branch = !branRefe

endmethod
-- End of method definition for .isoSpool()

-----------------------------------------------------------------------
--
-- Method:      .isoSpool(DBREF,DBREF)
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The reference of the owning CWBRAN
--    2   R      DBREF       The reference of the owning CTMTRL
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoSpool(!branRefe is DBREF, !ctmtrlRefe is DBREF)

  !this.branch = !branRefe
  !this.ctmtrl = !ctmtrlRefe

endmethod
-- End of method definition for .isoSpool()

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear this object arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear all arrays
  !this.components.clear()
  !this.penetrations.clear()
  !this.supports.clear()
  !this.contOn.clear()
  !this.adjacent.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .addAdjacent(DBREF)
--
-- Description: Add an adjacent part
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addAdjacent(!partRefe is DBREF)

  !this.adjacent.append(!partRefe)

endmethod
-- End of method definition for .addAdjacent(DBREF)

------------------------------------------------------------------------
--
-- Method:      .addComponent(DBREF)
--
-- Description: Add component to this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The component to be added
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addComponent(!compRefe is DBREF)

  -- Add the component to the array of components
  !this.components.append(!compRefe)

endmethod
-- End of method definition for .addComponent(DBREF)

------------------------------------------------------------------------
--
-- Method:      .addComponent(DBREF,STRING)
--
-- Description: Add component to this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The component to be added
--    2   R      STRING      Any associated continued on string
--    3   R      BOOLEAN     Whether to consider continuations or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addComponent(!compRefe is DBREF, !contOn is STRING, !continuations is BOOLEAN)

  -- Add the component to the array of components
  !this.components.append(!compRefe)

  -- Add the continued on string if valid
  if (!contOn.set() and !continuations) then

    -- Add the continued on string to the index associated with the component
    !this.contOn[!this.components.findfirst(!compRefe)] = !contOn

  endif

endmethod
-- End of method definition for .addComponent(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:      .addCrossData(DBREF,STRING)
--
-- Description: Add cross type component to this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The component to be added
--    2   R      STRING      Any associated continued on string
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCrossData(!compRefe is DBREF, !contOn is STRING)

  -- Add the continued on string to the index associated with the component
  !this.crosOn[!this.components.findfirst(!compRefe)] = !contOn

endmethod
-- End of method definition for .addCrossData(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:      .addData(STRING,DBREF,STRING)
--
-- Description: Add continuation to for this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addData(!type is STRING, !compRefe is DBREF, !value is STRING)

  -- The spool continued from description
  if (!type.eq('CONTFROM')) then

    !this.contFrom = !value

  -- The spool continued to description
  elseif (!type.eq('CONTTO')) then

    !this.contTo = !value

  -- A TEE, BRCO, THRE, CTTEE or CTCROS continued on
  elseif (!type.eq('CONTON')) then

    -- Store in the index that matches the component location in the component array
    !this.contOn[!this.components.findfirst(!compRefe)] = !value

  endif

endmethod
-- End of method definition for .addData(STRING,DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:      .addPenetration(DBREF,DBREF)
--
-- Description: Add a penetration to this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addPenetration(!penetration is DBREF, !component is DBREF)

  !this.penetrations.append(!penetration)
  !this.peneComps.append(!component)

endmethod
-- End of method definition for .addPenetration(STRING)

------------------------------------------------------------------------
--
-- Method:      .addSupport(DBREF,DBREF)
--
-- Description: Add support and associated component to this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSupport(!support is DBREF, !component is DBREF)

  !this.supports.append(!support)
  !this.suppComps.append(!component)

endmethod
-- End of method definition for .addSupport(STRING)

------------------------------------------------------------------------
--
-- Method:      .deleteLast(BOOLEAN)
--
-- Description: Delete the last component in this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to consider continuations or not
--
-- Return:
--   [Data Type] [Description]
--    STRING       The cleared 'Continued On' value
--
------------------------------------------------------------------------
define method .deleteLast(!continuations is BOOLEAN) is STRING

  -- Initialise variables
  !compRefe = !this.components[!this.components.size()]
  !compType = !compRefe.type.upcase()
  !contOn   = STRING()

  -- For a TEE, BRCO or THRE we need to return the continued on string so it can be added to the next isospool object
  if (!compType.eq('TEE') or !compType.eq('BRCO') or !compType.eq('THRE')) then

    -- Only for continuations
    if (!continuations) then

      -- Read the continued on string associated with the last component
      !contOn = !this.contOn[!this.components.size()]

      -- Remove the continued on
      !this.contOn.deleteFrom(!this.components.size())

    endif

  endif

  -- For a CTTEE or CTCROS we need to return the continued on string so it can be added to the next isospool object
  if (!compType.eq('CTTEE') or !compType.eq('CTCROS')) then

    -- Only for continuations
    if (!continuations) then

      -- Read the continued on string associated with the last component
      !contOn = !this.contOn[!this.components.size()]

      -- Remove the continued on
      !this.contOn.deleteFrom(!this.components.size())

      -- Remove the extra continued on of a cross
      if (!compType.eq('CTCROS')) then
        !this.contOn.deleteFrom(!this.components.size())

      endif

    endif

  endif

  -- Remove the component from the component arrays
  !this.components.deleteFrom(!this.components.size())

  return !contOn

endmethod
-- End of method definition for .deleteLast(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .getComponents()
--
-- Description: Get the components in this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getComponents() is ARRAY

  return !this.components

endmethod
-- End of method definition for .getComponents()

------------------------------------------------------------------------
--
-- Method:      .getCtmtrl()
--
-- Description: Get the ctmtrl owning the components in this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       CTMTRL
--
------------------------------------------------------------------------
define method .getCtmtrl() is DBREF

  return !this.ctmtrl

endmethod
-- End of method definition for .getCtmtrl()

------------------------------------------------------------------------
--
-- Method:      .getData(STRING,STRING)
--
-- Description: Get continuation data for this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!type is STRING, !value is STRING) is ARRAY

  if (!type.eq('CONTFROM')) then
    return !this.contFrom

  elseif (!type.eq('CONTTO')) then
    return !this.contTo

  elseif (!type.eq('CONTON')) then
    return !this.contOn

  elseif (!type.eq('PENE')) then
    return !this.penetrations

  elseif (!type.eq('SUPP')) then
    return !this.supports

  endif

endmethod
-- End of method definition for .getData(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      .getMaterial()
--
-- Description: get the material of this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      The material description
--
------------------------------------------------------------------------
define method .getMaterial() is STRING

  -- Check for unset
  if (!this.material.unset()) then
    !material = 'UNSET'

  else
    !material = !this.material

  endif

  return !material

endmethod
-- End of method definition for .getMaterial()

------------------------------------------------------------------------
--
-- Method:      .getSize()
--
-- Description: Get the number of components
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSize() is REAL

  return !this.components.size()

endmethod
-- End of method definition for .getSize()

------------------------------------------------------------------------
--
-- Method:      .getSupports()
--
-- Description: Get the supports in this spool
--              NOTE: This will add supports by owner and no necessarily by location
--              This is because MDS allows a support to be owned by one component but located within another
--              Consequently, the support may appear on the wrong spool drawing, but it is too difficult to overcome
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSupports(!suppType is STRING, !suppTagRule is STRING)

  -- For each component in this spool
  do !compRefe val !this.components

    -- Ignore any POINTR elements
    skip if (!compRefe.type.eq('POINTR'))

    -- Look for a support below this part
    VAR !allSupports COLL ALL $!suppType $!suppTagRule FOR $!compRefe

    -- Add the supports and part to the spool supports array
    do !support val !allSupports      	
      !this.supports.append(!support.dbref())
      !this.suppComps.append(!compRefe)

    enddo

  enddo

endmethod
-- End of method definition for .getSupports()

------------------------------------------------------------------------
--
-- Method:      .getVolume()
--
-- Description: Get the volume of this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getVolume() is VOLUME

  -- Initialise Variables
  !volumes = ARRAY()
  !volume  = object VOLUME()

  -- Get volume of all the items
  do !compRefe val !this.components

    -- Ignore POINTR elements
    skip if (!compRefe.type.upcase().eq('POINTR'))

    !volumes.append(!!volume(!compRefe))
      handle (64,347)
        --Empty ID list
        skip
      endhandle

  enddo

  -- Test for no volume
  if (!volumes.empty()) then
  	!position    = object POSITION('E0 N0 U0')
  	!volume.from = !position
  	!volume.to   = !position
  	return !volume
  endif

  -- Get each of the component from the volumes and find the max/min
  !block     = object BLOCK('!volumes[!evalIndex].from.east')
  !fromEast  = !volumes.evaluate(!block)
  !fromEast.sort()

  !block     = object BLOCK('!volumes[!evalIndex].from.north')
  !fromNorth = !volumes.evaluate(!block)
  !fromNorth.sort()

  !block     = object BLOCK('!volumes[!evalIndex].from.up')
  !fromUp    = !volumes.evaluate(!block)
  !fromUp.sort()

  !block     = object BLOCK('!volumes[!evalIndex].to.east')
  !toEast    = !volumes.evaluate(!block)
  !toEast.sort()
  !toEast.invert()

  !block     = object BLOCK('!volumes[!evalIndex].to.north')
  !toNorth   = !volumes.evaluate(!block)
  !toNorth.sort()
  !toNorth.invert()

  !block     = object BLOCK('!volumes[!evalIndex].to.up')
  !toUp      = !volumes.evaluate(!block)
  !toUp.sort()
  !toUp.invert()

  !volume.from.east   = !fromEast[1]
  !volume.from.north  = !fromNorth[1]
  !volume.from.up     = !fromUp[1]
  !volume.from.origin = World
  !volume.to.east     = !toEast[1]
  !volume.to.north    = !toNorth[1]
  !volume.to.up       = !toUp[1]
  !volume.to.origin   = World

  return !volume

endmethod
-- End of method definition for .getVolume()

------------------------------------------------------------------------
--
-- Method:      .setCtmtrl(DBREF)
--
-- Description: Set the ctmtrl owning the components in this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCtmtrl(!compRefe is DBREF)

  !this.ctmtrl = !!isoGetCtmtrl(!compRefe)

endmethod
-- End of method definition for .setCtmtrl(DBREF)

------------------------------------------------------------------------
--
-- Method:      .setMaterial(DBREF)
--
-- Description: Set the material of this spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      The CTMTRL member part
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMaterial(!partRefe is DBREF)

  -- Initialise variables
  !mtxx = 'Unset'

  -- Scan the part for a suitable element
  do !compRefe val !partRefe.mem

    -- Get the component type
    !compType = !compRefe.type.upcase()

    -- We only want CTRAY elements which have a spref
    if (!compType.eq('CTRAY')) then

      -- Test for a valid spec reference
      if (!compRefe.spref.badref()) then
        !mtxx = 'Unset'

      -- We have a spref
      else

        -- Look for a matx attribute
        if (!compRefe.spref.attlist.findfirst('MATX').set()) then

          -- We have an standard component, so test for a valid matx
          if (!compRefe.spref.matx.badref()) then

            -- Look for the material property
            !mtxx = !compRefe.prop.matl
              handle(2,207)
                -- Required property not found for element
                !mtxx  = 'Unset'

              elsehandle none

                -- Convert the returned array into a material description if necessary
                if (!mtxx.eq('GALV')) then
                  !mtxx = 'Galvanised Steel'

                elseif (!mtxx.eq('MS')) then
                  !mtxx = 'Mild Steel'

                elseif (!mtxx.eq('SS')) then
                  !mtxx = 'Stainless Steel'

                elseif (!mtxx.eq('ALUM')) then
                  !mtxx = 'Aluminium'

                endif

                -- Look for the material gauge
                !gauge = !compRefe.prop.gaug
                  handle(2,207)
                    -- Required property not found for element
                  elsehandle none
                    !mtxx  = !mtxx & ' ' & !gauge & 'g'

                  endhandle

              endhandle

          -- We have a valid matx so get material description
          else
            !mtxx = !compRefe.mtxx

          endif

        else

          -- We have a ctray component, so test for a valid ptref
          if (!compRefe.spref.prtref.badref()) then
              !mtxx = 'Unset'

          -- We have a valid ptref
          else

            -- Test for a valid matx
            if (!compRefe.spref.prtref.matx.badref()) then
              !mtxx = 'Unset'

            -- We have a valid matx so get material description
            else
              !mtxx = !compRefe.mtxx

            endif

          endif

        endif

      endif

    endif

    -- Stop if we have found a valid material
    break if (!mtxx.neq('Unset'))

  enddo

  -- Store the material
  !this.material = !mtxx

endmethod
-- End of method definition for .setMaterial(DBREF)
