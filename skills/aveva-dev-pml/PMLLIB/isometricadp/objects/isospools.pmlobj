--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addElementsInSameBranch(ARRAY,ARRAY) -                   Add elements in the same branch to the selected spool
--  addToSpool(ARRAY)                -                   Add picked elements to the selected spool
--  addToSpoolFromOtherBranch(ARRAY,ARRAY) -                   Add picked elements to the selected spool
--  clear()                          -                   Clear this object arrays
--  enhance()                        -                   Enhance the relevant spool
--  getDesignSpools(DBREF)           -                   Get the existing design spools
--  getEnhanced()                    REAL
--  getNumbSpools()                  REAL                Get the number of spools
--  getSpoolComponents()             ARRAY               Get the components of the currently enhanced spool
--  getSpools()                      ARRAY               Get spools
--  getSupports()                    -                   Gat support data for each spool
--  isoSpools()                      -                   Constructor
--  removeFromSpool(ARRAY)           -                   Remove picked elements from the selected spool
--  set(ARRAY)                       -                   Set the spool array
--  setEnhanced(REAL)                -                   Enhance the relevant spool
--  setSettings(ARRAY)               -                   Set the spool data arrays
--  splitCway(DBREF,BOOLEAN,STRING)  ARRAY               Split passed CWAY into spools
--  splitHvac(DBREF,BOOLEAN,STRING)  ARRAY               Split passed HVAC into spools
--  tidyGraphicalFeedback()          -                   tidy the graphical feedback for picked elements
--
------------------------------------------------------------------------
define object ISOSPOOLS

  -- Components grouped into spools
  member .spools       is ARRAY

  -- Display data
  member .enhanced     is REAL
  member .aidNumbers   is ARRAY

  -- Defaults data
  member .limitsBox    is REAL
  member .maxEntries   is REAL
  member .peneType     is STRING
  member .peneTagRule  is STRING
  member .suppType     is STRING
  member .suppTagRule  is STRING
  member .drwgNameRule is STRING
  member .lineNumbRule is STRING

  -- Discipline
  member .discipline   is STRING

endobject

-----------------------------------------------------------------------
--
-- Method:      .isoSpools()
--
-- Description: Constructor
