endmethod
-- End of method definition for .getSpoolComponents()

------------------------------------------------------------------------
--
-- Method:         .removeFromSpool(ARRAY)
--
-- Description: Remove picked elements from the selected spool
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
--  1   R     ARRAY       Picked elements to be removed from selected spool
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeFromSpool(!pickedElements is ARRAY)

  if(!pickedElements.unset()) then
    return
  endif

  -- store current element to navigate later and current mode to restore later
  !ref  = !!ce
  var !mode mode
  -- change to forwards mode
  FORWARDS

  -- collect the mto elements of the active spool (selected in the list)
  !mtoElementsRef   = !this.hvacSpoolManager.getMtoElementsForSpool(!this.activeElements[1])
  !mtoElements      = !mtoElementsRef.evaluate(object BLOCK('!mtoElementsRef[!evalIndex].refNo'))

  -- mark the picked elements
  do !n indices !pickedElements

    !name           = !pickedElements[!n].flnm
    --!textPosition = !pickedElements[!n].pos
    !midPointDist   = 0.5 * ( !pickedElements[!n].apos.distance(!pickedElements[!n].lpos) )
    !textPosition   = !pickedElements[!n].apos.offset(!pickedElements[!n].adir.opposite(), !midPointDist)

    -- add aid number
    !aidNumber            = !!aidNumbers.add('Picked HVAC Element')
    !this.aidNumbers[!n]  = !aidNumber

    AID text NUMBER $!<aidNumber> '$!<name>' at $!<textPosition>

  enddo

  -- group the spool mto elements and the picked elements in a new array
  !elementsToRemove = !mtoElements.intersect(!pickedElements)
  if(!elementsToRemove.unset() ) then
     !!alert.message('Select elements present in the spool to remove')
     return
  elseif(!mtoElements.size() eq 1) then
    -- this is a redundant check
    !!alert.message('Only one element is added to the selected spool. Cannot remove it.')
    return
  endif

  do !x indices !elementsToRemove
    -- check update status of the elements
    if(!this.checkUpdateStatus(!elementsToRemove[!x],'').not()) then
      return
    endif
  enddo

  -- get the first and last element in the spool mto elements list
  --!firstMtoElement   = !mtoElements.first()
  !lastMtoElement    = !mtoElements.last()

  !undoRemoveElem = object UNDOABLE()
  !undoRemoveElem.description('Remove Elements')
  !undoRemoveElem.undoAction('!!hvacSpool.undoRedoAction()')
  !undoRemoveElem.redoAction('!!hvacSpool.undoRedoAction()')
  !undoRemoveElem.add()

  do !i indices !elementsToRemove

    if(!elementsToRemove[!i] eq !lastMtoElement) then
       !!ce  = !lastMtoElement
       DESP N 36 false

    else
       !!ce  = !elementsToRemove[!i]
       DESP N 36 false

       -- check if the element is branch connector
       if(!elementsToRemove[!i].type.eq('BRCO')) then
        if(!elementsToRemove[!i].cref.set() and !elementsToRemove[!i].cend.eq('HEAD') ) then
          !ref  = !!ce

          !!ce  = !elementsToRemove[!i].cref.members[1]
          handle ANY
           -- if branch has no members
          elsehandle none
            DESP N 36 false
          endhandle

          !ref  = !!ce
        endif
       endif

       next
       handle (2,113)
         -- no element to navigate
         if(!elementsToRemove[!i].owner.tref.set()) then
           if(!elementsToRemove[!i].owner.tref.type.eq('BRAN')) then
             !!ce  = !elementsToRemove[!i].owner.tref.members[1]
             handle ANY
              -- if branch has no members
             elsehandle none
               DESP N 36 false
             endhandle
           endif
         endif
       elsehandle none
         DESP N 36 false
       endhandle
    endif

  enddo

  -- restore the stored CE and mode
  !!ce  = !ref
  handle ANY
  endhandle

  -- change back to the previous mode
  $!mode

  !selectedSpool  = !this.activeElements[1]

  -- regenerate the spools
  !this.regenerateSpools()

  !undoRemoveElem.endUndoable()

  !this.activeElements[1]  = !selectedSpool
  !this.spoolsList.select('RTEXT', !selectedSpool.string())

  !this.enhance()

  !this.splListMenu.setFieldProperty('rename','visible',true)
  !this.splListMenu.setFieldProperty('unnameSel','visible',true)

endmethod
--End of method definition for .removeFromSpool(ARRAY)

------------------------------------------------------------------------
--
-- Method:        .set(ARRAY)
--
-- Description:   Set the spool array
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of spools
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .set(!spools is ARRAY)

  !this.spools = !spools

  !this.enhance()

endmethod
-- End of method definition for .tidyGraphicalFeedback()

------------------------------------------------------------------------
--
-- Method:        .setSettings(ARRAY)
--
-- Description:   Set the spool data arrays
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of spools
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSettings(!settings is ARRAY)

  !this.limitsBox    = !settings[1]
  !this.maxEntries   = !settings[2]
  !this.peneType     = !settings[3]
  !this.peneTagRule  = !settings[4]
  !this.suppType     = !settings[5]
  !this.suppTagRule  = !settings[6]
  !this.drwgNameRule = !settings[7]
  !this.lineNumbRule = !settings[8]
  !this.discipline   = !settings[9]

endmethod
-- End of method definition for .setSettings(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .setEnhanced(REAL)
--
-- Description: Enhance the relevant spool
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setEnhanced(!index is REAL)

  !this.enhanced = !index

endmethod
-- End of method definition for .setEnhanced(REAL)

------------------------------------------------------------------------
--
-- Method:      .splitCway(DBREF,BOOLEAN,STRING)
--
-- Description: Split passed CWAY into spools
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Element to be processed
--    2    R     BOOLEAN    Whether the continuation data is required
--    3    R     STRING     The split method VOLUME or SPLITPOINT
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of ISOSPOOL objects
--
------------------------------------------------------------------------
define method .splitCway(!cwayRefe is DBREF, !continuations is BOOLEAN, !splitMethod is STRING) is ARRAY

  -- Initialise variables
  !limitsBox   = !this.limitsBox
  !allBranches = !cwayRefe.mem
  !progress    = 0
  !collection  = object COLLECTION()

  -- Clear arrays
  !this.spools.clear()

  -- For each cable way branch
  do !count ind !allBranches

    -- Initialise variables
    !branchRefe  = !allBranches[!count]

    -- Set progress bar taking 80% as the maximum for this phase
    !progress = !progress + ((!count / !allBranches.size()) * 80)
    !!fmsys.setProgress(!progress)

    -- Start a new spool since we are not splitting across branches at this time
    !spool = object ISOSPOOL(!branchRefe)

    -- Only consider branches. This cannot happen at this time but do this in case they add more member types
    skip if (!branchRefe.type.neq('CWBRAN'))

    -- Get all cable way branch components
    !parts = !!isoCwbranMem(!branchRefe, 'PARTS')

    -- Ignore branches with no components left in it
    if (!parts.size().eq(0))then
      skip
    endif

    -- Get the branch rpath points
    !collection.scope(!branchRefe)
    !collection.type('POINTR')
    !allPointr = !collection.results()

    -- Add each component to the spool until the limits of size, or split or material table length has been reached
    do !index ind !parts

      -- Initialise variables
      !partRefe = !parts[!index]
      !partType = !partRefe.type.upcase()

      -- Store the ctmtrl at the spool
      if (!spool.getCtmtrl().badRef()) then
        !spool.setCtmtrl(!partRefe)
      endif

      -- Set the spool ctray material if it is currently unset
      if (!spool.getMaterial().unset() or !spool.getMaterial().eq('UNSET')) then
        !spool.setMaterial(!partRefe)

      endif

      -- For the first part
      if (!index.eq(1)) then

        -- Add the first rpath point to the start of the first spool for this branch
        !spool.addComponent(!allPointr[1])

        -- Get the part arrive ppoint
        !pArrive = !partRefe.arrive
          handle (2,201)
            -- Element does not have attribute ARRI
            VAR !pA PA OF $!partRefe
            !pArrive = !pA.split()[2].real()
          endhandle

        -- Add the adjacent part
        !adjacentPartRefe = !partRefe.ctcref[!pArrive]
          handle (2,201)
            -- Element does not have attribute CTCREF
            -- !!isoLog.messages.append('  Cannot find the continuation part for ' & !partRefe.flnm)
          elsehandle none
            !spool.addAdjacent(!adjacentPartRefe)

          endhandle

      endif

      -- Add the start and end continuation data
      if (!continuations) then

        -- Store continuation for the first member in the branch
        if (!index.eq(1)) then
          !spool.addData('CONTFROM', !partRefe, !!isoCwContOn(!partRefe, 'HREF', !this.drwgNameRule, !this.lineNumbRule))

        endif

      endif

      -- Add component to spool
      !spool.addComponent(!partRefe)

      -- Add continuation data for connections, supports and penetrations
      if (!continuations) then

        -- Store continuation for any CTTEE
        if (!partType.eq('CTTEE')) then

           -- Store the connection reference on P3 for the continuation label
          !spool.addData('CONTON', !partRefe , !!isoCwContOn(!partRefe, 'CREF', !this.drwgNameRule, !this.lineNumbRule))

           -- Get this part arrive and leave ppoints
           !pArrive = !partRefe.arrive
             handle (2,201)
               -- Element does not have attribute ARRI
               VAR !pA PA OF $!partRefe
               !pArrive = !pA.split()[2].real()
             endhandle

           !pLeave  = !partRefe.leave
             handle (2,201)
               -- Element does not have attribute LEAV
                VAR !pL PL OF $!partRefe
                !pLeave = !pL.split()[2].real()
             endhandle

           -- Find the remaining p-point of three
           !allPpoints[1] = 1
           !allPpoints[2] = 2
           !allPpoints[3] = 3

           !allPpoints.deleteFrom(!pArrive,1)
           !allPpoints.deleteFrom(!pLeave,1)
           !allPpoints.compress()

          -- Store the adjacent part
          !adjacentPartRefe = !partRefe.ctcref[!allPpoints[1]]
            handle (2,201)
              -- Element does not have attribute CTCREF
              -- !!isoLog.messages.append('  Cannot find the continuation part for ' & !partRefe.flnm)
            elsehandle none
              !spool.addAdjacent(!adjacentPartRefe)

            endhandle

        endif

        -- Store continuation for any CTCROS
        if (!partType.eq('CTCROS')) then

          -- Store the connection references on P3 and P4 for the continuation labels
          -- P3
          !spool.addData('CONTON', !partRefe , !!isoCwContOn(!partRefe, 'CREF', !this.drwgNameRule, !this.lineNumbRule))

          -- P4
          !spool.addCrossData(!partRefe , !!isoCwContOn(!partRefe, 'CREFA', !this.drwgNameRule, !this.lineNumbRule))

         -- Find the last p-point of four
         !allPpoints[1] = 1
         !allPpoints[2] = 2
         !allPpoints[3] = 3
         !allPpoints[4] = 4

         !allPpoints.deleteFrom(!pArrive,1)
         !allPpoints.deleteFrom(!pLeave,1)
         !allPpoints.compress()
         !thirdPoint    = !allPpoints[1]

         !allPpoints.deleteFrom(1,1)
         !allPpoints.compress()

          -- Store the adjacent parts
          -- Third ppoint
          !adjacentPartRefe = !partRefe.ctcref[!thirdPoint]
            handle (2,201)
              -- Element does not have attribute CTCREF
              -- !!isoLog.messages.append('  Cannot find the continuation part for ' & !partRefe.flnm)
            elsehandle none
              !spool.addAdjacent(!adjacentPartRefe)

            endhandle

          -- Fourth ppoint
          !adjacentPartRefe = !partRefe.ctcref[!allPpoints[1]]
            handle (2,201)
              -- Element does not have attribute CTCREF
              -- !!isoLog.messages.append('  Cannot find the continuation part for ' & !partRefe.flnm)
            elsehandle none
              !spool.addAdjacent(!adjacentPartRefe)

            endhandle

        endif

      endif

      -- Make a test whether to split depending upon the method used
      -- Split by the VOLUME box
      if (!splitMethod.eq('VOLUME')) then

        -- Get the volume
        !volume = !spool.getVolume()
        !box    = !volume.box()

        -- Volume lengths
        !xlength = !box.xlength
        !ylength = !box.ylength
        !zlength = !box.zlength

        -- Make the test of this volume against the volume box
        if (!xlength.gt(!limitsBox) or !ylength.gt(!limitsBox) or !zlength.gt(!limitsBox)) then
          !testTrue = true

        else
          !testTrue = false

        endif

      -- Split by SPLIT POINT stored in the 3D Model
      -- If the component is marked as being split it means that this is the LAST component in the spool
      else

        -- Read the owing part split attribute
        !split = !partRefe.sSplit

        -- Make the test for the split point
        if (!split.boolean()) then
          !testTrue = true

        else
          !testTrue = false

        endif

      endif

      -- Test size of model
      -- We cannot test against the maximum table length, because there may be multiple trays
      -- Not including some from a group would be wrong
      if (!testTrue)then

        -- Remove last added component since it exceeds the limits
        if (!splitMethod.eq('VOLUME')) then
          !contOn = !spool.deleteLast(!continuations)
        endif

        -- Add the continuation as the next spool number
        if (!continuations) then
          !nextNumber = !this.spools.size() + 2
          !spool.addData('CONTTO', !partRefe, 'Sheet ' & !nextNumber.string())

        endif

        -- When splitting by volume add this part as the adjacent par
        -- This is because it is going to be moved to the next spool
        if (!splitMethod.eq('VOLUME')) then
          !spool.addAdjacent(!partRefe)

        -- For splitting by split point add the next part as the adjacent part
        -- This because this part remains in the spool as the last part
        else

          -- Don't do anything if this is the last part. It will be picked up later
          if (!index.neq(!parts.size())) then

            -- Add the next part as the adjacent part
            !spool.addAdjacent(!parts[!index + 1])

          endif

        endif

        -- This spool is complete so store it
        !this.spools.append(!spool)

        -- Do not add any more to this spool so start again
        !spool = object ISOSPOOL(!branchRefe)

        -- When splitting by volume, add the previous part as the adjacent part
        -- This is because this part is the first part of the new spool
        if (!splitMethod.eq('VOLUME')) then

          if (!index.neq(1)) then
            !spool.addAdjacent(!parts[!index - 1])
          endif

        -- When splitting by split point, add this part as the adjacent part
        -- This is because this part is the last part of the previous spool
        else
          !spool.addAdjacent(!partRefe)

        endif

        -- Add the previously deleted component
        if (!splitMethod.eq('VOLUME')) then

          !spool.addComponent(!partRefe, !contOn,!continuations)
          !spool.setCtmtrl(!partRefe)

          if (!partType.eq('CTRAY')) then
            !spool.setMaterial(!partRefe)
          endif

        endif

        -- Add the continuation from the previous spool number
        if (!continuations) then
          !spool.addData('CONTFROM', !partRefe, 'Sheet ' & !this.spools.size().string())
        endif

      endif

      -- For the last part in the spool
      if (!index.eq(!parts.size())) then

        -- Add the last rpath point to the end of the last spool for this branch
        !spool.addComponent(!allPointr[!allPointr.size()])

        -- Get the part leave ppoint
        !pLeave  = !partRefe.leave
          handle (2,201)
            -- Element does not have attribute LEAV
            VAR !pL PL OF $!partRefe
            !pLeave = !pL.split()[2].real()
          endhandle

        -- Add the adjacent part
        !adjacentPartRefe = !partRefe.ctcref[!pLeave]
          handle (2,201)
            -- Element does not have attribute CTCREF
            -- !!isoLog.messages.append('  Cannot find the continuation part for ' & !partRefe.flnm)
          elsehandle none
            !spool.addAdjacent(!adjacentPartRefe)

          endhandle

        -- Store the continuation
        if (!continuations) then
          !spool.addData('CONTTO', !partRefe, !!isoCwContOn(!partRefe, 'TREF', !this.drwgNameRule, !this.lineNumbRule))

        endif

        -- Set the spool ctray material if it is currently unset
        if (!spool.getMaterial().unset() or !spool.getMaterial().eq('UNSET')) then
          !spool.setMaterial(!partRefe)

        endif

      endif

    enddo

    !this.spools.append(!spool)

  enddo

  -- Get MDS supports
  !this.getSupports()

  return !this.spools

endmethod
-- End of method definition for .splitCway(DBREF,BOOLEAN,STRING)

------------------------------------------------------------------------
--
-- Method:      .splitHvac(DBREF,BOOLEAN,STRING)
--
-- Description: Split passed HVAC into spools
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Element to be processed
--    2    R     BOOLEAN    Whether the continuation data is required
--    3    R     STRING     The split method VOLUME or SPLITPOINT
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of ISOSPOOL objects
--
------------------------------------------------------------------------
define method .splitHvac(!hvacRefe is DBREF, !continuations is BOOLEAN, !splitMethod is STRING) is ARRAY

  -- Initialise variables
  !limitsBox    = !this.limitsBox
  !allBranches  = !hvacRefe.mem
  !progress     = 0
  !this.spools.clear()

  -- For each HVAC branch
  do !count ind !allBranches

    -- Initialise variables
    !branch = !allBranches[!count]

    -- Set progress bar taking 80% as the maximum for this phase
    !progress = !progress + ((!count / !allBranches.size()) * 80)
    !!fmsys.setProgress(!progress)

    -- Start a new spool since we are not splitting across branches at this time
    !spool = object ISOSPOOL(!branch)

    -- Only consider branches
    skip if (!branch.type.neq('BRAN'))

    -- Get branch components
    !components = !branch.mem

    -- Remove any components that should be ignored
    do !index ind !components

      -- Initialise variables
      !compRefe = !components[!index]

      -- Bad spref
      if (!compRefe.spref.badRef()) then
        !components.remove(!index)

      -- Atta
      elseif (!compRefe.type.upcase().eq('ATTA')) then

      	-- Remove the atta if it is not a penetration or a support
      	if (!compRefe.type.upcase().neq(!this.peneType) and !compRefe.type.upcase().neq(!this.suppType)) then
          !components.remove(!index)
        endif

      endif

      -- Possible penetration or support element
      if (!compRefe.type.upcase().eq(!this.peneType)) then

        -- Keep it if it is an MDS atta
        VAR !testMDS COLL ALL $!<this.suppType> $!<this.suppTagRule> FOR $!compRefe
        if (!testMDS.empty().not()) then
          skip
        endif

        -- Remove it if it is not a penetration
        VAR !pene COLL ALL $!<this.peneType> $!<this.peneTagRule> FOR $!compRefe
        if (!pene.empty()) then
          !components.remove(!index)
        endif

      endif

    enddo

    -- Ignore branches with no components left in it
    if (!components.size().eq(0))then
      skip
    endif

    -- Add each component to the spool until the limits of size, or split or material table length has been reached
    do !index ind !components

      -- Initialise variables
      !compRefe = !components[!index]
      !compType = !compRefe.type.upcase()

      -- Set the spool material
      if (!spool.getMaterial().unset()) then
        !spool.setMaterial(!compRefe)
      endif

      -- Add the start and end continuation data
      if (!continuations) then

        -- Store continuation for the first member in the branch
        if (!index.eq(1)) then
          !spool.addData('CONTFROM', !compRefe, !!isoContOn(!compRefe, 'HREF', !this.drwgNameRule, !this.lineNumbRule))
        endif

        -- Store continuation for the last member in the branch
        if (!index.eq(!components.size())) then
          !spool.addData('CONTTO', !compRefe, !!isoContOn(!compRefe, 'TREF', !this.drwgNameRule, !this.lineNumbRule))
        endif

      endif

      -- Add continuation data for supports and penetrations
      if (!continuations) then

        -- Check whether this component is an MDS Support Atta or a Penetration
        VAR !testMDS COLL ALL $!<this.suppType> $!<this.suppTagRule> FOR $!compRefe
        if (!compType.eq(!this.suppType) and !testMDS.empty().not()) then
          !componentIs = 'MDS-SUPPORT'

        elseif (!compType.eq(!this.peneType)) then
          !componentIs = 'PENETRATION'

        else
          !componentIs = 'STD'

        endif

        -- For an MDS Support Atta or Penetration
        if (!componentIs.eq('MDS-SUPPORT') or !componentIs.eq('PENETRATION')) then

          -- Initialise variables
          !valid = false

          -- Determine within which component lies the support element - if any
          -- Only need to test the previous and next components (if they exist within the same branch)
          if (!compRefe.order.eq(1)) then

            -- Get the next component
            !nextCompRefe = !components[!index + 1]

            -- Test the next component
            if (!!isoWithIn(!compRefe, !nextCompRefe)) then
              !valid    = true
            endif

          elseif (!compRefe.order.eq(!components.size())) then

            -- Get the previous component
            !prevCompRefe = !components[!index - 1]

            -- Test the previous component
            if (!!isoWithIn(!compRefe, !prevCompRefe)) then
              !theCompRefe = !prevCompRefe
              !valid    = true
            endif

          else

            -- Test both next and previous components
            !nextCompRefe = !components[!index + 1]
            !prevCompRefe = !components[!index - 1]

            if (!!isoWithIn(!compRefe, !nextCompRefe)) then
              !theCompRefe = !nextCompRefe
              !valid = true

            elseif (!!isoWithIn(!compRefe, !prevCompRefe)) then
              !theCompRefe = !prevCompRefe
              !valid = true

            endif

          endif

          -- Add support or penetration and the relevant component in the drawing object
          if (!valid) then

            if (!componentIs.eq('MDS-SUPPORT')) then
              !spool.addSupport(!compRefe, !theCompRefe)

            else
              !spool.addPenetration(!compRefe, !theCompRefe)

            endif

          endif

          -- Do not add this component to the drawlist
          skip

        endif

      endif

      -- Add component to spool
      !spool.addComponent(!compRefe)

      -- Add continuation data for connections, supports and penetrations
      if (!continuations) then

        -- Store continuation for any TEE, BRCO  and THRE elements
        if (!compType.eq('TEE') or !compType.eq('BRCO') or !compType.eq('THRE')) then

           -- Store the connection reference for the continuation label
          !spool.addData('CONTON', !compRefe , !!isoContOn(!compRefe, 'CREF', !this.drwgNameRule, !this.lineNumbRule))

        endif

      endif

      -- Make a test whether to split depending upon the method used
      -- Split by VOLUME
      if (!splitMethod.eq('VOLUME')) then

        -- Get the volume
        !volume = !spool.getVolume()
        !box    = !volume.box()

        -- Volume lengths
        !xlength = !box.xlength
        !ylength = !box.ylength
        !zlength = !box.zlength

        -- Make the test of this volume against the volume box
        if (!xlength.gt(!limitsBox) or !ylength.gt(!limitsBox) or !zlength.gt(!limitsBox)) then
          !testTrue = true

        else
          !testTrue = false

        endif

      -- Split by SPLIT POINT stored in the 3D Model
      -- If the component is marked as being split it means that this is the LAST component in the spool
      else

        -- Read the component property SPLI
        !split = !compRefe.prop.spli

        -- Make the test for the split point
        if (!split.eq('')) then
           !testTrue = false

        else

          if (!compRefe.prop.spli.boolean()) then
            !testTrue = true

          else
            !testTrue = false

          endif

        endif

      endif

      -- Test size of model and table length
      if (!testTrue or !spool.getSize().eq(!this.maxEntries))then

        -- Remove last added component since it exceeds the limits
        if (!splitMethod.eq('VOLUME')) then
          !contOn = !spool.deleteLast(!continuations)
        endif

        -- Add the continuation as the next spool number
        if (!continuations) then
          !nextNumber = !this.spools.size() + 2
          !spool.addData('CONTTO', !compRefe, 'Sheet ' & !nextNumber.string())
        endif

        -- This spool is complete so store it
        !this.spools.append(!spool)

        -- Do not add any more to this spool so start again
        !spool = object ISOSPOOL(!branch)

        -- Add the previously delete component
        if (!splitMethod.eq('VOLUME')) then
          !spool.addComponent(!compRefe, !contOn,!continuations)
          !spool.setMaterial(!compRefe)

          -- If the component is the last branch member then we need to set the continued on
          if (!continuations and !compRefe.eq(!components[!components.size()])) then
            !spool.addData('CONTTO', !compRefe, !!isoContOn(!compRefe, 'TREF', !this.drwgNameRule, !this.lineNumbRule))
          endif

        endif

        -- Add the continuation from the previous spool number
        if (!continuations) then
          !spool.addData('CONTFROM', !compRefe, 'Sheet ' & !this.spools.size().string())
        endif

      endif

    enddo

    !this.spools.append(!spool)

  enddo

  return !this.spools

endmethod
-- End of method definition for .splitHvac(DBREF,BOOLEAN,STRING)

------------------------------------------------------------------------
--
-- Method:        .tidyGraphicalFeedback()
--
-- Description:   tidy the graphical feedback for picked elements
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyGraphicalFeedback()

  -- Clear all aids
  do !aidNumber values !this.aidNumbers
    !!aidNumbers.remove(!aidNumber)
  enddo

endmethod
-- End of method definition for .tidyGraphicalFeedback()
