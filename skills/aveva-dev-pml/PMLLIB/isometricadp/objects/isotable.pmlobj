--
-- Author:          Steve Wilson
-- Created:         27 March 2001
--
-- Description:
-- A table definition
--
------------------------------------------------------------------------
--
-- Member descriptions:
-- .shape       The shape of the table as a rectangle object
-- .corner      A corner definition
-- .posCalc     An expression used to calculate the move distance for one
--              table entry to the next
-- .maxEntries  The maximum number of possible entries in the table
--
------------------------------------------------------------------------
define object ISOTABLE

  member .shape      is ISORECTANGLE
  member .corner     is POSITION
  member .posCalc    is STRING
  member .maxEntries is REAL

endobject
