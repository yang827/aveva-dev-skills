--
--  Description:     -- Handles the Units for the Isometric ADP application---- 1 The application will manipulate, store and display real distance values in either MM or INCH only-- 2 Read in distance values from a defaults file without units, store them in the correct units and display in the correct units-- 3 Set distance values in a test gadget with the application units and store them in the correct units-- 4 Read in angle values from a defaults file without units, store them in the correct units and display in the correct units-- 5 If the defaults file read value does not have units, will assume that the value is of the correct current units--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getOffsetIncrement()             REAL                Get the offset gadget increment
--  getTextIncrement()               REAL                Get the text height gadget increment
--  getUnits()                       STRING              Get the application units
--  isoUnits()                       -                   Construct
--
-----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            isounits.pmlobj
--   Type:          Object Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
--
-- Description:
-- Handles the Units for the Isometric ADP application
--
-- 1 The application will manipulate, store and display real distance values in either MM or INCH only
-- 2 Read in distance values from a defaults file without units, store them in the correct units and display in the correct units
-- 3 Set distance values in a test gadget with the application units and store them in the correct units
-- 4 Read in angle values from a defaults file without units, store them in the correct units and display in the correct units
-- 5 If the defaults file read value does not have units, will assume that the value is of the correct current units
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define object ISOUNITS

  -- Are we running in Imperial
  member .imperial        is BOOLEAN

  -- Distance formats
  member .limitsFormat    is FORMAT
  member .textFormat      is FORMAT
  member .offsetFormat    is FORMAT

  -- Increment values
  member .textIncrement   is REAL
  member .offsetIncrement is REAL

  -- Application units
  member .units           is STRING

endobject

------------------------------------------------------------------------
--
-- Method:        .isoUnits()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoUnits()

  -- Check for Imperial units
  !this.imperial = !!isImperialLength('DIST')

  -- Set the format to be used for form gadgets that handle distance values less than 100mm
  -- Imperial
  if (!this.imperial) then

    -- Set the application units
    !this.units = 'INCH'

    -- Set the format for the limits box parameters
    !this.limitsFormat.units  = 'INCH'
    !this.limitsFormat.label  = 'in'
    !this.limitsFormat.dp     = 0

    -- Set the format for text height gadgets
    !this.textFormat.units    = 'INCH'
    !this.textFormat.fraction = false
    !this.textFormat.label    = 'in'
    !this.textFormat.zeros    = false
    !this.textFormat.dp       = 4

    -- Set the step value up/down for text height gadgets
    !this.textIncrement       = 0.03125in

    -- Set the format for X & Y offset gadgets
    !this.offsetFormat.units    = 'INCH'
    !this.offsetFormat.fraction = false
    !this.offsetFormat.label    = 'in'
    !this.offsetFormat.zeros    = false
    !this.offsetFormat.dp       = 2

    -- Set the step value up/down for X & Y offset gadgets
    !this.offsetIncrement       = 0.1in

  -- Metric
  else

    -- Set the application units
    !this.units = 'MM'

    -- Set the format for the limits box parameters
    !this.limitsFormat.units  = 'MM'
    !this.limitsFormat.label  = 'mm'
    !this.limitsFormat.dp     = 0

    -- Set the format for text height gadgets
    !this.textFormat.units    = 'MM'
    !this.textFormat.fraction = false
    !this.textFormat.label    = 'mm'
    !this.textFormat.dp       = 2

    -- Set the step value up/down for text height gadgets
    !this.textIncrement       = 0.05mm

     -- Set the format for X & Y offset gadgets
    !this.offsetFormat.units    = 'MM'
    !this.offsetFormat.label    = 'mm'
    !this.offsetFormat.dp       = 1

    -- Set the step value up/down for X & Y offset gadgets
    !this.offsetIncrement       = 0.5mm

  endif

  -- Set all formats dimensions to length
  !this.limitsFormat.dimension = 'L'
  !this.textFormat.dimension   = 'L'
  !this.offsetFormat.dimension = 'L'

  -- Set the global variables for use by the forms
  !!isoLimitsFormat = !this.limitsFormat
  !!isoTextFormat   = !this.textFormat
  !!isoOffsetFormat = !this.offsetFormat

endmethod
-- End of method definition for .isoUnits()

-----------------------------------------------------------------------
--
-- Method:      .getOffsetIncrement()
--
-- Description: Get the offset gadget increment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        The offset gadget increment in the application units
--
------------------------------------------------------------------------
define method .getOffsetIncrement() is REAL

  return !this.offsetIncrement

endmethod
-- End of method definition for .getOffsetIncrement()

-----------------------------------------------------------------------
--
-- Method:      .getTextIncrement()
--
-- Description: Get the text height gadget increment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        The text height gadget increment in the application units
--
------------------------------------------------------------------------
define method .getTextIncrement() is REAL

  return !this.textIncrement

endmethod
-- End of method definition for .getTextIncrement()

-----------------------------------------------------------------------
--
-- Method:      .getUnits()
--
-- Description: Get the application units
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      The application units MM or INCH
--
------------------------------------------------------------------------
define method .getUnits() is STRING

  return !this.units

endmethod
-- End of method definition for .getUnits()
