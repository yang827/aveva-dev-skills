-- Created:         27 March 2001
--
--
-- Description:
-- Data about the VIEW element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isoView(DBREF)                   -                   Constructor method
--
------------------------------------------------------------------------
define object ISOVIEW

  member .xLen2D is REAL
  member .yLen2D is REAL

  member .xLen3D is REAL
  member .yLen3D is REAL

  member .tl2D   is POSITION
  member .tr2D   is POSITION
  member .bl2D   is POSITION
  member .br2D   is POSITION

  member .tl3D   is POSITION
  member .tr3D   is POSITION
  member .bl3D   is POSITION
  member .br3D   is POSITION

  member .xl2D   is POSITION
  member .xr2D   is POSITION
  member .yt2D   is POSITION
  member .yb2D   is POSITION

  member .xl3D   is POSITION
  member .xr3D   is POSITION
  member .yt3D   is POSITION
  member .yb3D   is POSITION

endobject
-- End of object definition

-----------------------------------------------------------------------
--
-- Method:      .isoView(DBREF)
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isoView(!viewRefe is DBREF)

  -- Get view data
  !ce  = !!ce
  !!ce = !viewRefe
  VAR !limits SPLIT VLIMITS
  VAR !region SPLIT VREGION
  !!ce = !ce

  -- Get corners
  !this.tl3D = object POSITION(!limits[2] & !limits[3] & ' ' & !limits[11] & !limits[12])
  !this.tr3D = object POSITION(!limits[9] & !limits[10] & ' ' & !limits[11] & !limits[12])
  !this.bl3D = object POSITION(!limits[2] & !limits[3] & ' ' & !limits[4] & !limits[5])
  !this.br3D = object POSITION(!limits[9] & !limits[10] & ' ' & !limits[4] & !limits[5])

  !this.tl2D = object POSITION('E' & !region[3] & ' N' & !region[10])
  !this.tr2D = object POSITION('E' & !region[8] & ' N' & !region[10])
  !this.bl2D = object POSITION('E' & !region[3] & ' N' & !region[5])
  !this.br2D = object POSITION('E' & !region[8] & ' N' & !region[5])

  -- Get sides
  !this.xLen2D = !viewRefe.size[1]
  !this.yLen2D = !viewRefe.size[2]

  !this.xLen3D = !this.tl3D.distance(!this.tr3D)
  !this.yLen3D = !this.tl3D.distance(!this.bl3D)

  -- Get side mid positions
  !this.xl2D = !this.bl2D.midPoint(!this.tl2D)
  !this.xr2D = !this.br2D.midPoint(!this.tr2D)
  !this.yt2D = !this.tl2D.midPoint(!this.tr2D)
  !this.yb2D = !this.bl2D.midPoint(!this.br2D)

  !this.xl3D = !this.bl3D.midPoint(!this.tl3D)
  !this.xr3D = !this.br3D.midPoint(!this.tr3D)
  !this.yt3D = !this.tl3D.midPoint(!this.tr3D)
  !this.yb3D = !this.bl3D.midPoint(!this.br3D)

endmethod
-- End of method definition for .isoView(DBREF)
