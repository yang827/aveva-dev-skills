--
-- File:            isodoclink.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2010
--
--
-- Description:
-- Set document links between elements
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       ARRAY of design element references
--    2   R      ARRAY       ARRAY of the associated DRWG objects
--    3   R      ARRAY       Drawing Update status
--                            TRUE  - update existing drawing links
--                            FALSE - create non-existing drawing links, recreate existing ones
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!isoDocLink(!desiRefes is ARRAY, !drwgObjs is ARRAY, !updateStatus is ARRAY)

  -- The current element is a link folder
  !linkFoldRefe = !!ce

  -- For each design element
  do !index ind !desiRefes

    -- Initialise variables
    !desiRefe  = !desiRefes[!index]
    !drwgRefe  = !drwgObjs[!index].drwgRefe
    !update    = !updateStatus[!index]
    !pdfFiles  = !drwgObjs[!index].pdfFiles
    !partsList = !drwgObjs[!index].partsList

    -- Find any existing link descriptor for this design element
    !linkDesc = !!isoGetDocLink(!desiRefe)[2]

    -- Create or modify links depending on the update status of each drawing
    -- When updating a drawing, use any found link folder
    if (!update and !linkDesc.set()) then

      -- Find the existing link folder and add links for any new parts lists
      !!ce = !linkDesc.owne

    else

      -- When no existing link descriptor, create a new folder and link descriptor
      if (!linkDesc.badref()) then

        -- Build link folder name, while checking for an unnamed element
        if (!desiRefe.name.substring(1,1).neq('/')) then
          !linkFoldName = '/' & !desiRefe.name & '/Links'

        else
          !linkFoldName = !desiRefe.flnm & '/Links'

        endif

        -- Access the top-level link folder
         !!ce = !linkFoldRefe

        -- Create a new link folder to hold the associated drawings
        NEW LNFOLD
         DESC 'Isometric ADP - Drawing Folder'
         FUNC 'ISOADP'

        -- Name the folder if possible
        NAME $!linkFoldName
          handle (41,303)(41,12)
            -- Too many values specified for attribute NAME
            -- Name already used
            -- Unname it as any system truncation may duplicate the name
            UNNAME
          endhandle

        NEW LNDESC
         DESC 'Isometric ADP - Drawing Link'
         FUNC 'ISOADP'

      -- Access the found link descriptor
      else
        !!ce = !linkDesc

      endif

      -- Attempt to add the design element to the link array, although there should only be a single entry
      -- This would fail with an error when updating an existing link descriptor
      DLADD $!desiRefe
        handle (2,856)
          -- Element to be INCLUDED is already owned by the current element
        endhandle

      -- Set the link to the drawing
      LNKREF $!drwgRefe

    endif

    -- Link the assembly to the external pdf files
    -- This should be done on all update types
    do !pdfFile val !pdfFiles

      if (!pdfFile.exists()) then

        -- Build URL string
        !url = 'file:///' & !pdfFile

        -- Check the link folder for any descriptors linked to the same file
        -- But only if we found a link descriptor related to this design element
        if (!linkDesc.badref().not()) then
          !linkFold = !linkDesc.owne
          VAR !existingLink COLL ALL LNDESC WITH URL EQ '$!url' FOR $!linkFold
          skip if (!existingLink.set())
        endif

        NEW LNDESC
         DLADD $!desiRefe
         DESC 'Isometric ADP - PDF Link'
         FUNC 'ISOADP'
         URL '$!url'

       endif

    enddo

    -- Link the design element to the external parts list
    -- This should be done on all update types
    if (!partsList.set()) then

      if (!partsList.exists()) then

        -- Build URL string
        !url = 'file:///' & !partsList.fullname()

        -- Check the link folder for any descriptors linked to the same file
        -- But only if we found a link descriptor related to this design element
        if (!linkDesc.badref().not()) then
          !linkFold = !linkDesc.owne
          VAR !existingLink COLL ALL LNDESC WITH URL EQ '$!url' FOR $!linkFold
          skip if (!existingLink.set())

        endif

        NEW LNDESC
         DLADD $!desiRefe
         DESC 'Isometric ADP - Parts List Link'
         FUNC 'ISOADP'
         URL '$!url'

      endif

    endif

  enddo

  SAVEWORK

endfunction
-- End of function !!isoDocLink
