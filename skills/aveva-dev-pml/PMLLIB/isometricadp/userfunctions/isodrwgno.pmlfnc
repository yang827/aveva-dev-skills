--
-- File:            isodrwgno.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         02 Sep 2010
--
-- Description:
-- Set the drawing number
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The discipline being processed HVAC or CWAY
--    2   R      DBREF       The HVAC or CWAY being processed
--    3   R      DBREF       The drawing being created
--    4   R      ISODFLTS    The application defaults
--
-- Assumptions:
-- The current element is the DRWG element
-- The drwg number is held in the DRWG attribute 'DrwgNumber'
------------------------------------------------------------------------
define function !!isoDrwgNo(!type is STRING, !elementRefe is DBREF, !drwgRefe is DBREF, !defaults is ISODEFAULTS)

  -- Get the drawing number defaults object
  !drwgNoDflts = !defaults.getDrwgNoDflts()

  -- Get the relevant defaults settings
  if (!type.upcase().eq('HVAC')) then
    !settings = !drwgNoDflts.getHvacSettings()

  else
    !settings = !drwgNoDflts.getElecSettings()

  endif

  -- Initialise variables
  !useNameSeq     = !settings[1]
  !prefix         = !settings[2]
  !suffix         = !settings[3]
  !startNumb      = !settings[4]
  !separator      = !settings[5]
  !firstSeparator = !separator
  !thirdSeparator = !separator

  -- Import name sequence object
  import 'aveva.pdms.nameseq'
    handle (1000,0)
      -- Already loaded
    endhandle

  using namespace 'aveva.pdms.nameseq'

  -- Define a name sequence object with an identifier for this application
  !nameSeq = object NAMESEQ('ISOMETRICADP')

  -- Start the sequence, making sure we do not restart it
  if (!nameSeq.getCurrent().lt(!startNumb.real())) then
    !nameSeq.setStart(!startNumb.real())
  endif

  -- Test if a name sequence db is returning a current value or not to be used
  -- If not use the original method od extracting the drawing number
  if (!nameSeq.getCurrent().eq(-1) or !useNameSeq.not()) then

    -- Access the drwg
    !!ce = !drwgRefe

    -- Call the original function
    !error = !!isoDrwgNumber()

    -- Test for the error reading the defaults file
    if (!error.neq('NONE')) then

      -- Output a log file message
      !!isoLog.add(|   WARNING: | & !error)


      -- Set the drawing number to a warning message
      DRWGNUMBER |Unable to determine Drawing Number|

      -- Set the 11.6 drawing number to a warning message
      :IdpDrwgNo |Unable to determine Drawing Number|
        handle (99,532)
          -- Undefined UDA or undefined UDET
        endhandle

    endif

  -- Use the name sequence db for the next number
  else

    -- Get the next sequence number
    !nextNumber = !nameSeq.next().after('ISOMETRICADP')
    !nextLength = !nextNumber.string().length() + 1

    -- Test for the length of any necessary leading zeros
    !leadingZeros = ''
    do from !nextLength to !startNumb.length()
      !leadingZeros = !leadingZeros & '0'
    enddo

    -- Get the element name
    if (!elementRefe.name.substring(1,1).eq('=')) then
      !elementName = !elementRefe.name

    else
      !elementName = !elementRefe.flnn

    endif

    -- Check for an empty prefix or suffix in which case set the separator to null
    if (!prefix.eq('')) then
      !firstSeparator = ''

    endif

    if (!suffix.eq('')) then
      !thirdSeparator = ''

    endif

    -- Build the drawing number
    !drwgNo = !prefix & !firstSeparator & !elementName & !separator & !leadingZeros & !nextNumber & !thirdSeparator & !suffix

    -- Have to re-access the DRWG since the name sequence seems to be changing what the core thinks is the CE
    -- If this is not done then a crash will occur
    CONTEXT DRAWING

    -- Access the drwg
    !!ce = !drwgRefe

     -- Set the drawing number attribute
    DRWGNUMBER |$!drwgNo|

    -- Set the 11.6 drawing number
    :IdpDrwgNo |$!drwgNo|
      handle (99,532)
        -- Undefined UDA or undefined UDET
      endhandle

  endif

endfunction
