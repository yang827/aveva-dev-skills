--
-- Description:
-- Gets user login name
------------------------------------------------------------------------
-- Return:
--   [Data Type] [Description]
--    STRING      User login name
--
------------------------------------------------------------------------
define function !!isoLogin() is STRING

  -- Read current session
  !session = current session

  -- Extract user name
  !userName = !session.login.part(1,'.')

  return !userName

endfunction
