--
-- File:            isoMarKeyPlan.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Creates the key plan SPECIFICALLY for the MARINE project
--
-- Assumptions:
-- The ce is the layer
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The component to which the origin symbol was attached
--    2    R     ORIGIN      The arrive point position of the component wrt world
--
------------------------------------------------------------------------
define function !!isoMarKeyPlan(!compRefe is DBREF, !origin is POSITION)

  -- Initialise variables
  !layeRefe     = !!ce
  !originString = !origin.string().before(' WRT')
  !world        = WORL OF $!compRefe
  !gridRefe     = object DBREF()

  -- Try to find an example grid system, starting with new system
  VAR !allGrids COLL ALL GRIDSYSTEM WI PURP EQ 'SHIP'

  -- Use any found grid
  if (!allGrids.empty().not()) then
    !gridRefe = !allGrids[1].dbref()

  endif

  -- Stop if no grid available
  if (!gridRefe.badref()) then
    !!isoLog.add('  A suitable Grid system has not been found. The Keyplan has not been created.')
  	return

  endif

  -- Get gridline elements for the grid system
  -- Find the X grid
  VAR !gridX COLL ALL GRIDAX WI GRDAXE EQ 'X' FOR $!gridRefe
  VAR !pass1 COLL ALL GRIDLN FOR $!gridX[1]

  -- Find the Y grid
  VAR !gridY COLL ALL GRIDAX WI GRDAXE EQ 'Y' FOR $!gridRefe
  VAR !pass2 COLL ALL GRIDLN FOR $!gridY[1]

  -- Test origin for closest gridlines
  do !count from 1 to 2

    !allElem = !pass$!count

    do !index ind !allElem

      -- Calculate distance from gridline to origin
      if (!count.eq(1)) then

        if (!index.eq(1)) then

        	-- Calculate the distance and find the nearest element
          !minDist  = !origin.east - !allElem[!index].dbref().pos.wrt(!world).east
          !nearRefe = !allElem[!index].dbref()
          !distance = !minDist

        else

        	!distance = !origin.east - !allElem[!index].dbref().pos.wrt(!world).east

        endif

      else

        if (!index.eq(1)) then

        	-- Calculate the distance and find the nearest element
          !minDist  = !origin.north - !allElem[!index].dbref().pos.wrt(!world).north
          !nearRefe = !allElem[!index].dbref()

        else

          !distance = !origin.north - !allElem[!index].dbref().pos.wrt(!world).north

        endif

      endif

      -- Test if found distance is less than the stored value
      if (!distance.abs().lt(!minDist.abs())) then
        !minDist = !distance
        !nearRefe = !allElem[!index].dbref()

      endif

    enddo

    -- Store results
    if (!count.eq(1)) then
      !xDist = !minDist
      !xRefe = !nearRefe

    else
      !yDist = !minDist
      !yRefe = !nearRefe

    endif

  enddo

  -- Get coordinate data
  !xDesc = !xRefe.owne.grdlbl & '#/' & !xRefe.grdid.string()
  !yDesc = !yRefe.owne.grdlbl & '#/' & !yRefe.grdid.string()

  -- Set the view
  VIEW
  THPO $!originString
  !viewObj = object ISOVIEW(!!ce)

  -- Access the layer
  !!ce = !layeRefe

  -- Determine template type PDMS or True-Type Fonts
  if (!!ce.owne.owne.owne.font.gt(4)) then

    !bLTemplate = /TT/Isometric_ADP/EWgrid_NEW
  	!tRTemplate = /TT/Isometric_ADP/EWgrid/D_NEW
    !tLTemplate = /TT/Isometric_ADP/EWgrid/D_NEW
    !bRTemplate = /TT/Isometric_ADP/EWgrid_NEW
    !nSTemplate = /TT/Isometric_ADP/NSgrid_NEW
    !orTemplate = /TT/Isometric_ADP/Origin

  else

  	!bLTemplate = /Isometric_ADP/EWgrid
  	!tRTemplate = /Isometric_ADP/EWgrid/D
  	!tLTemplate = /Isometric_ADP/EWgrid/D
  	!bRTemplate = /Isometric_ADP/EWgrid
  	!orTemplate = /Isometric_ADP/Origin
  	!nSTemplate = /Isometric_ADP/NSgrid

	endif

  -- Get relevant view corners
  -- Bottom Left
  if (!xDist.gt(0) and !yDist.gt(0)) then
    !xyPos     = 'X' & !viewObj.bl2D.east.value().string('D2') & 'Y' & !viewObj.bl2D.north.value().string('D2')
    !xPos      = 'E' & !viewObj.xl3D.east.value().string('D2') & 'N' & !viewObj.xl3D.north.value().string('D2')
    !yPos      = 'E' & !viewObj.yb3D.east.value().string('D2') & 'N' & !viewObj.yb3D.north.value().string('D2')
    !xTemplate = !bLTemplate
    !yScale    = '-1 1'
    !xDir      = 'E'
    !yDir      = 'S'

  -- Top Right
  elseif (!xDist.lt(0) and !yDist.lt(0)) then
    !xyPos     = 'X' & !viewObj.tr2D.east.value().string('D2') & 'Y' & !viewObj.tr2D.north.value().string('D2')
    !xPos      = 'E' & !viewObj.xr3D.east.value().string('D2') & 'N' & !viewObj.xr3D.north.value().string('D2')
    !yPos      = 'E' & !viewObj.yt3D.east.value().string('D2') & 'N' & !viewObj.yt3D.north.value().string('D2')
    !xTemplate = !tRTemplate
    !yScale    = '1 1'
    !xDir      = 'W'
    !yDir      = 'N'

  -- Top Left
  elseif (!xDist.gt(0) and !yDist.lt(0)) then
    !xyPos     = 'X' & !viewObj.tl2D.east.value().string('D2') & 'Y' & !viewObj.tl2D.north.value().string('D2')
    !xPos      = 'E' & !viewObj.xl3D.east.value().string('D2') & 'N' & !viewObj.xl3D.north.value().string('D2')
    !yPos      = 'E' & !viewObj.yt3D.east.value().string('D2') & 'N' & !viewObj.yt3D.north.value().string('D2')
    !xTemplate = !tLTemplate
    !yScale    = '-1 1'
    !xDir      = 'W'
    !yDir      = 'S'

  -- Bottom Right
  else
    !xyPos     = 'X' & !viewObj.br2D.east.value().string('D2') & 'Y' & !viewObj.br2D.north.value().string('D2')
    !xPos      = 'E' & !viewObj.xr3D.east.value().string('D2') & 'N' & !viewObj.xr3D.north.value().string('D2')
    !yPos      = 'E' & !viewObj.yb3D.east.value().string('D2') & 'N' & !viewObj.yb3D.north.value().string('D2')
    !xTemplate = !bRTemplate
    !yScale    = '1 1'
    !xDir      = 'E'
    !yDir      = 'N'

  endif

  -- Create the origin
  NEW SLAB ON PA OF $!compRefe
   TMRF $!orTemplate XYSC .5 .5 XYPO 0 0  OSET FALSE  LFSTYLE TEMP  LFCOLOUR TEMP  LEAD OFF BLNK FALSE

  -- Create the grid labels
  -- X axis
  NEW SLAB ON $!compRefe ATEX |$!xDesc|
    TMRF $!xTemplate  OSET FALSE  XYPO $!xyPos  LEAD OFF
    TXCOLOUR TEMP  LFSTYLE TEMP  LFCOLOUR TEMP

  -- Y axis
  NEW SLAB ON $!compRefe ATEX |$!yDesc|
    TMRF $!nSTemplate  XYSC $!yScale  OSET FALSE  XYPO $!xyPos   LEAD OFF
    TXCOLOUR TEMP  LFSTYLE TEMP  LFCOLOUR TEMP

  -- Create the dimensions
  -- X axis
  !dist = !xDist.abs().nint().value()
  NEW LDIM  DIR $!xDir  DTCH 2mm  DMTX |$!dist|  DOFF 7mm  DLColour 10  DTColour 10
   FROM POS $!originString
   TO POS $!xPos

  -- Y axis
  !dist = !yDist.abs().nint().value()
  NEW LDIM  DIR $!yDir  DTCH 2mm  DMTX |$!dist|  DOFF 7mm  DLColour 10  DTColour 10
   FROM POS $!originString
   TO POS $!yPos

  -- Create keyplan view description note
  NEW VNOT
  NEW TEXP |Key Plan|
   CHEI 2.5mm TPEN 31 JUST C ALIG HB ORIGIN X 30mm Y 7mm TXCOLOUR 10

  -- Return to laye
  !!ce = !layeRefe

endfunction
