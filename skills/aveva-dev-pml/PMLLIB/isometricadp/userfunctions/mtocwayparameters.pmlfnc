--
-- File:            mtocwayparameters.pmlfnc
--   Type:          Function Definition
--   Group:         ISOADP
--     Keyword:     Isometric
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Adds to the array of mto table entry objects the data for the parameters
-- THIS IS SPECIFICALLY FOR CWAY ONLY
--
-- Assumptions:
-- The current element is the main view
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of ISOMTOENTRY objects holding data for a table row
--    2    R     ARRAY       Al the components in the drawlist
--    3    R     DBREF       The reference of SYTM used for this cell in the row
--    4    R     BOOLEAN     Whether or not the data is to be sorted
--    5    R     ISODEFAULTS The defaults settings
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The modified array passed as argument 1
--
------------------------------------------------------------------------
define function !!mtoCwayParameters(!entries is ARRAY,!allComp is ARRAY,!cellRefe is DBREF,!toBeSorted is BOOLEAN,!defaults is ISODEFAULTS) is ARRAY

  -- Initialise variables
  !showKeys       = !defaults.elecMtoGen.key
  !separator      = !defaults.elecMtoGen.separator.replace(|'|,||)
  !widthKey       = !defaults.elecMtoGen.widthKey.replace(|'|,||)
  !heightKey      = !defaults.elecMtoGen.heightKey.replace(|'|,||)
  !lengthKey      = !defaults.elecMtoGen.lengthKey.replace(|'|,||)
  !allEntries     = ARRAY()
  !allDisplay     = ARRAY()
  !groupSize      = ARRAY()
  !allTypes       = ARRAY()
  !allDescription = ARRAY()

  -- Set keys to null string if switched off
  if (!showKeys.not()) then
    !widthKey  = ''
    !heightKey = ''
    !lengthKey = ''

  endif

  -- Get the current distance format
  !format       = !!distanceFmt
  !format.label = ''

  -- For each component get the parameters
  do !index ind !allComp

    -- Initialise variables
    !compRefe              = !allComp[!index]
    !compType              = !compRefe.type.upcase()
    !thisDisplayString     = STRING()
    !thisDescriptionString = STRING()

    -- Ignore any POINTR components
    skip if (!compType.eq('POINTR'))

    -- Get sizes for valid CTRAY elements
    if (!compType.eq('CTRAY') and !compRefe.spref.badref().not()) then

      -- Get ctray component type
      !allTypes.append(!compRefe.catref.gtype)

      -- Width
      !thisDisplayString = !compRefe.owne.trayw.value().string(!format) & !widthKey

      -- Height
      !thisDisplayString = !thisDisplayString & !separator & !compRefe.owne.trayh.value().string(!format) & !heightKey

      -- Length
      -- All CTRAY have a height attribute irrespective of type
      -- Output height other than zero
      if (!compRefe.height.neq(0)) then
        !thisDisplayString = !thisDisplayString & !separator & !compRefe.height.value().string(!format) & !lengthKey
      endif

      -- Description
      !thisDescriptionString = !compRefe.dtxr

    -- Templates
    elseif (!compType.eq('TMPL')) then

       -- Add component type, but make each one different
       -- This is because we need a unique field because we are sorting by parameters and templates don't have any
      !allTypes.append(!compType & !index)

      -- A template cannot have any size parameters
      !thisDisplayString = '-'

      -- A template does not have any description
      !thisDescriptionString = '-'

    -- Gensecs
    elseif (!compType.eq('GENSEC')) then

       -- Add component type
      !allTypes.append(!compType)

      -- Look for the description property
      !thisDisplayString = !compRefe.prop.desc
        handle any
          !!isoLog.add('   WARNING: Unable to find property DESC for ' & !compType & !compRefe.name)
          !thisDisplayString = 'Unset'

        endhandle

      -- Description
      if (!elementRefe.detref.badref()) then
        !thisDescriptionString = '-'
      else
        !thisDescriptionString = !elementRefe.dtxr
      endif

    -- Anything else
    else
      !!isoLog.add('   WARNING: Cannot get size of unknown element ' & !compType & !compRefe.name)

      !allTypes.append(!compType)
      !thisDisplayString = '-'
      !thisDescriptionString = '-'

    endif

    -- Add to the display strings array
    !allDisplay.append(!thisDisplayString)
    !allDescription.append(!thisDescriptionString)

  enddo

  -- Sort the components if required
  if (!toBeSorted) then

    -- Sort the components by type and display string
    VAR !sort SORT !allTypes ASCII !allDescription !allDisplay ASCII FIRSTINGROUP !first

    -- Get groups
    do !count ind !sort

      -- Initialise variables
      !index = !sort[!count].real()

      if (defined(!first[!count])) then

        -- Initialise variables
        !firstCount = !first[!count].real()

        -- Build entry object
        !allEntries[!firstCount] = object ISOMTOENTRY(!allComp[!index],!allTypes[!index],!allDisplay[!index],!cellRefe)

        if (!count.eq(1)) then
          !prevCount = 1
        else
          -- Count group size
          !groupSize.append(!count - !prevCount)
          !prevCount = !count

        endif

     else

        -- Add the other components (that are the equal to the first) to the object
        !allEntries[!firstCount].dbRefes.append(!allComp[!index])

      endif

    enddo

    -- Last group
    !groupSize.append(!allComp.size() - !prevCount + 1)

    -- Add group size to entry objects
    do !index ind !allEntries
      !allEntries[!index].number = !groupSize[!index]
    enddo

  else

    -- Add data to the passed entry objects
    !allEntries = !entries
    do !index ind !allComp

      !allEntries[!index].isoMtoEntry(!allComp[!index],!allTypes[!index],!allDisplay[!index],!cellRefe)
      !allEntries[!index].number = 1

    enddo

  endif

  -- Return the table entry object array
  return  !allEntries

endfunction
