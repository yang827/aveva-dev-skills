-- Created:         25 March 2001
--
--
-- Description:
-- Adds to the array of mto table entry objects the data for the weight cell
-- THIS IS SPECIFICALLY FOR CWAY ONLY
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of ISOMTOENTRY objects holding data for a table row
--    2    R     DBREF       The reference of SYTM used for this cell in the row
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The modified array passed as argument 1
--
------------------------------------------------------------------------
define function !!mtoCwayWeight(!entries is ARRAY, !cellRefe is DBREF) is ARRAY

  -- Set entry object members
  do !index index !entries

    -- Get the component
    !compRefe = !entries[!index].dbRefes[1]

    -- Get the component weight
    !weight = !compRefe.nwei.value()
      handle any
        !weight = 0
      endhandle

    -- Set component weight
    !member = '!entries[!index].c' & !cellRefe.:IdpColumn.string()
    $!member = !weight.string(!!massFmt)

    -- Store weight in the object array for later use by the xls output
    !entries[!index].setCellAtext(!cellRefe.attribute(':IdpColumn'), !weight.string(!!massFmt))

    -- Set template
    !member = '!entries[!index].t' & !cellRefe.:IdpColumn.string()
    $!member = !cellRefe

  enddo

  return !entries

endfunction
