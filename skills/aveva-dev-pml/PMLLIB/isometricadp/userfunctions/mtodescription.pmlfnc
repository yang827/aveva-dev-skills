-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Adds to the array of mto table entry objects the data for the description cell
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of ISOMTOENTRY objects holding data for a table row
--    2    R     DBREF       The reference of SYTM used for this cell in the row
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The modified array passed as argument 1
--
------------------------------------------------------------------------
define function !!mtoDescription(!entries is ARRAY, !cellRefe is DBREF) is ARRAY

  -- Set entry object members
  do !index index !entries

    -- Get element
    !elementRefe = !entries[!index].dbRefes[1]
    !elementType = !elementRefe.type.upcase()

    -- Get the description depending on type
    -- Hvac components and Ctray
    if (!elementRefe.owne.type.upcase().eq('BRAN') or !elementType.eq('CTRAY')) then

      -- Check for valid detref
      if (!elementRefe.detref.badref()) then
        !description = 'Unset'
      else
        !description = !elementRefe.dtxr
      endif

    -- Template
    elseif (!elementType.eq('TMPL')) then

      -- Use the template description attribute
      !description = !elementRefe.desc

      -- Test for unset
      if (!description.eq('')) then
        !description = 'Template'
      endif

    -- General Sections
    elseif (!elementType.eq('GENSEC')) then

      -- Test for a valid detref
      if (!elementRefe.detref.badref()) then
        !description = 'General Section'
      else
        !description = !elementRefe.dtxr
      endif

    -- Anything else
    else
      !description = '-'

    endif

    -- Set descriptions
    !member = '!entries[!index].c' & !cellRefe.:IdpColumn.string()
    $!member = !description

    -- Store descriptions in the object array for later use by the xls output
    !entries[!index].setCellAtext(!cellRefe.attribute(':IdpColumn'), !description)

    -- Set template
    !member = '!entries[!index].t' & !cellRefe.:IdpColumn.string()
    $!member = !cellRefe

  enddo

  return !entries

endfunction
