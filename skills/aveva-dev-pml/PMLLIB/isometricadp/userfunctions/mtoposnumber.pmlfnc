-- Created:         25 March 2001
--
--
-- Description:
-- Adds to the array of mto table entry objects the data for the position number cell
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of ISOMTOENTRY objects holding data for a table row
--    2    R     DBREF       The reference of SYTM used for this cell in the row
--    3    R     BOOLEAN     Whether or not the data is to be sorted
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The modified array passed as argument 1
--
------------------------------------------------------------------------
define function !!mtoPosNumber(!entries is ARRAY, !cellRefe is DBREF, !toBeSorted is BOOLEAN) is ARRAY

  -- Set entry object members
  do !index index !entries

    !columnNumber = !cellRefe.attribute(':IdpColumn')

    -- Set position number depending on whether or not the rows are sorted
    !member = '!entries[!index].c' & !cellRefe.:IdpColumn.string()
    if (!toBeSorted) then
      $!member = !index.string()

      -- Store the position number in the object array for later use by the xls output
      !entries[!index].setCellAtext(!columnNumber, !index.string())

    else
      $!member = !entries[!index].dbRefes[1].desp[31].string()

      !entries[!index].setCellAtext(!columnNumber, !entries[!index].dbRefes[1].desp[31].string() )

    endif

    -- Set template
    !member = '!entries[!index].t' & !cellRefe.:IdpColumn.string()
    $!member = !cellRefe

  enddo

  return !entries

endfunction
