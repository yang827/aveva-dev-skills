-- Define form
setup form !!lexiconApplic at xr 0 yr 0 main size 95 0

  !this.formTitle     = 'Lexicon - AVEVA PDMS'
  !this.iconTitle     = 'Lexicon - AVEVA PDMS'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  !this.quitCall = '$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>'

  -- Top level menu
  bar
  exit

exit
-- End of form definition for !!lexiconApplic

----------------------------------------------------------------------
--
-- Method:      lexiconApplic
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lexiconApplic()

  -- For Marine/Schematic Header
  !mm = object AVEVAModuleManager()
  !product = !mm.CurrentProductName()
  !this.formTitle = 'Lexicon - AVEVA $!product'

  -- Define Main Bar Menu
  !bar      = !this.bar
    !bar.add('Lexicon',    'Lexicon')
-- 12.1 toolbar menus replaced by UIC (XML)
--    !bar.add('Display',   'Display')
--    !bar.add('Create',    'creationmenu')
--    !bar.add('Edit',   'Edit')
--    !bar.add('Status',   'Status')
--    !bar.add('Help',      'Help')

  ----------------------------- Define Main Menus -----------------------------

  ----------------------------- Lexicon Menu Option -----------------------------
  !lexicon       = !this.newMenu('lexicon')
    !lexicon.add('separator')
    !lexicon.add('callback', 'Save Work',             'call !!comSavework()')

    !lexicon.add('callback', 'Get Work',              'call !!comGetWork()')

    !lexicon.add('separator')
    !lexicon.add('menu',     'Modules',               'modules')
    !lexicon.add('separator')
    !lexicon.add('callback', 'Exit',                  '$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>')

    -- Set the modules menu
    call !!moduleMenus(!this)
    handle ANY
    endhandle

  ----------------------------- Display Menu Option -----------------------------
-- 12.1 menu items replaced by UIC (XML)
--  !display     = !this.newMenu('display')
--    !display.add('TOGGLE',   'Dictionary Explorer',    '',                   'Dictionary Explorer')
--    !display.add('TOGGLE',   'Current Element Editor', '',                   'Current Element Editor')
--    !display.add('callback', 'Command Window...',        'show !!cadcBth free')

 ----------------------------- Edit Menu Option ---------------------------------
-- 12.1 menu items replaced by UIC (XML)
--  !edit     = !this.newMenu('edit')
--    !edit.add('callback',   'Validate',             '',                   'Lexicon GUI Validate')
--    !edit.add('separator')
--    !edit.add('callback',   'Undo',                 '',                   'Lexicon GUI Undo')
--    !edit.add('callback',   'Redo',                 '',                   'Lexicon GUI Redo')

----------------------------- Creation Menu Option ---------------------------------
--  !creationmenu     = !this.newMenu('creationmenu')
--    !creationmenu.add('callback',   'UDA World',             '',                   'new uda world')
--   !creationmenu.add('callback',   'UDA Group',             '',                   'new uda group')
--    !creationmenu.add('callback',   'UDA',             '',                   'new uda')
--    !creationmenu.add('callback',   'USDA',             '',                   'new usda')
--    !creationmenu.add('separator')
--    !creationmenu.add('callback',   'UDET World',             '',                   'new udet world')
--    !creationmenu.add('callback',   'UDET Group',             '',                   'new udet group')
--    !creationmenu.add('callback',   'UDET',             '',                   'new udet')


  -- construct forms for serialisation
  if(defined (!!appCntrl)) then
   !!appCntrl.delete()
  endif
  !!appCntrl = object APPCNTRL()

  !!appFormCntrl.constructForms()

endmethod
-- End of method definition for .lexiconApplic()
