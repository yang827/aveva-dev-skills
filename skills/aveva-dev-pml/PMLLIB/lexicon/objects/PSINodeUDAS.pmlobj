--
--
--
-- Description: function to show the specchange form at pipe or bran level
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  PSINodeUDAS()                    -
--  updateAttributes(STRING)         -
--  updateElement(STRING,STRING)     BOOLEAN
--
-- Function Type:   object
------------------------------------------------------------------------
-- Define object
define object PSINODEUDAS

member .status is STRING

endobject
------------------------------------------------------------------------
--
-- Method:      PSINodeUDAS()
-- Description: Constructor Runs all other methods
--
--
------------------------------------------------------------------------
define method .PSINodeUDAS()

!this.status = 'Not Updated'
-- test for the main UWRL
if !this.updateElement('/PSI-DESIGN-UDAS','UWRLD').not() then
  return
endif
!test = !this.updateElement('/PSISifValue','UDA')
!test = !this.updateElement('/PSIsystem','UDA')
!test = !this.updateElement('/stressdate','UDA')
!test = !this.updateElement('/PSINodeType','UDA')
!test = !this.updateElement('/PSINodeGap','UDA')
!test = !this.updateElement('/PSINodeStiffness','UDA')
!test = !this.updateElement('/PSINodeFriction','UDA')

compile
-- if it gets here we can assume that its updated correctly
!!alert.message('Pipe Stress UDAs ' & !this.status)

endmethod
------------------------------------------------------------------------
--
-- Method:      updateElement()
-- Description: tests for existing items and creates or updates accordingly
--
--
------------------------------------------------------------------------
define method .updateElement(!name is STRING,!type is STRING ) is BOOLEAN

  $!name
  handle ANY
    New $!type $!name
    handle ANY
      !!alert.error('Unable to create/set UDA Data for ' & !name & ' in this database')
      !this.status = 'Not Updated '
      return FALSE
    endhandle
    !this.status = 'Updated successfully'
  elsehandle NONE
    var !a dbwrite
    if !a.neq('true') then
     !!alert.error('Read Only Database')
     return FALSE
    endif
  endhandle
    !this.updateAttributes(!name)
    !this.status = 'Updated successfully'

  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      .updateAttributes()
-- Description: Updates the CE attributes according to name
--
--
------------------------------------------------------------------------
define method .updateAttributes(!name is STRING )


  if !name.eq('/PSI-DESIGN-UDAS') then
    return
  elseif !name.eq('/PSISifValue') then
    UDNA 'PSISifNumber'
    ABLE 6
    UTYP REAL
    ELEL rem all
    ELEL ADD CATE
  elseif !name.eq('/PSIsystem') then
    DESC ' Stress System'
    UDNA 'PsiSystem'
    ABLE 6
    UTYP REF
    ULEN 120
    RPTX 'Stress System'
    ELEL rem all
    ELEL ADD PIPE BRAN
  elseif !name.eq('/stressdate') then
    DESC ' Stress Date'
    UDNA 'PsiDate'
    ABLE 4
    UTYP TEXT
    ULEN 30
    RPTX 'Stress Date'
    ELEL rem all
    ELEL ADD PIPE
  elseif !name.eq('/PSINodeType') then
    DESC ' Node Type'
    UDNA 'NodeType'
    ABLE 7
    UTYP REAL
    ULEN 4
    RPTX 'Node Type'
    ELEL rem all
    ELEL ADD ATTA ELBO TEE BEND REDU FLAN
  elseif !name.eq('/PSINodeGap') then
    DESC ' Support Gap'
    UDNA 'NodeGap'
    ABLE 6
    UTYP REAL
    ULEN 4
    UUNI 'DISTANCE'
    RPTX 'Support Gap'
    ELEL rem all
    ELEL ADD ATTA ELBO TEE BEND REDU FLAN
  elseif !name.eq('/PSINodeStiffness') then
    DESC ' Restraint Stiffness'
    UDNA 'NodeStiff'
    ABLE 7
    UTYP REAL
    ULEN 4
    RPTX ' Restraint Stiffness'
    ELEL rem all
    ELEL ADD ATTA ELBO TEE BEND REDU FLAN
  elseif !name.eq('/PSINodeFriction') then
    DESC ' Node Friction'
    UDNA 'NodeFriction'
    ABLE 7
    UTYP REAL
    ULEN 4
    RPTX 'Node Friction'
    ELEL rem all
    ELEL ADD ATTA ELBO TEE BEND REDU FLAN
  endif

endmethod
