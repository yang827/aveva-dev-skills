--
--
-- Description:
-- Function to display aid axes at passed position
-- .
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Real]      [Aid number]
--   [2] [R]    [String]    [Display text for axes]
--   [3] [R]    [Position]  [position of axes]
--   [4] [R]    [Real]      [Size of main Arrow]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidAxes(!number is REAL, !dText is STRING, !position is POSITION, !size is REAL)

!half = !size / 2

if(!dText neq ||) then
    AID TEXT  NUMBER $!number |$!dText| AT $!position
endif
    AID ARROW NUMBER $!number AT $!position DIRECTION N HEIGHT $!size MM
    AID ARROW NUMBER $!number AT $!position DIRECTION E HEIGHT $!half MM
    AID ARROW NUMBER $!number AT $!position DIRECTION U HEIGHT $!half MM

endfunction
-- End of function definition for !!aidAxes
