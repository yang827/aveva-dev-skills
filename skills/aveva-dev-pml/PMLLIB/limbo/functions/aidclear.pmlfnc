--
--
-- Description:
-- replace GAIDCLEAR to clear aid lines
-- .
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [String]     [Aid Line Number(s) to Remove]
--   [2] [R]    [String]      [Type of Aid to be removed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidClear(!strOfNumbs is STRING, !strOfTypes is STRING)



-- Initialise Variables

   !numbers = !strOfNumbs.split()
   !types   = !strOfTypes.split()

-- Default $D 2
   if(!types[1] eq |ALL|) then
      !types[1] = |LINE|
      !types[2] = |TEXT|
      !types[3] = |SPHERE|
      !types[4] = |ARROW|
      !types[5] = |BOX|
   endif


-- Loop through numbers
 do !i values !numbers

   do !type values !types
     AID CLEAR $!type $!i
     handle any
     endhandle
   enddo
 enddo


endfunction
-- End of function definition for !!aidClear
