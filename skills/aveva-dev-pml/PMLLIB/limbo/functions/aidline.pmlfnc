--
-- Description:
-- Construct Aid line between two points
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [REAL]      [Aid number]
--   [2] [R]    [POSITION]  [position of one point]
--   [3] [R]    [POSITION]  [position of second point]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidLine(!number is REAL, !startPos is POSITION, !endPos is POSITION )

  AID LINE NUMBER $!number $!startPos TO $!endPos

endfunction
-- End of function definition for !!aidLine
