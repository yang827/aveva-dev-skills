--
--
-- Description:
-- Draw Aid Axes in specified orientation
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Real]      [Aid number]
--   [2] [R]    [String]    [Display text for axes]
--   [3] [R]    [Position]  [position of axes]
--   [4] [R]    [Real]      [Size of main Arrow]
--    5   R     Orientation Direction of axes
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidOrientate(!number is REAL, !dText is STRING, !position is POSITION, !size is REAL, !ori is ORIENTATION)

!half = !size / 2

if(!dText neq ||) then
    AID TEXT  NUMBER $!number |$!dText| AT $!position
endif

!string = !ori.xDir().string()
    AID ARROW NUMBER $!number AT $!position DIRECTION $!string HEIGHT $!size MM
!string = !ori.yDir().string()
    AID ARROW NUMBER $!number AT $!position DIRECTION $!string HEIGHT $!half MM
!string = !ori.zDir().string()
    AID ARROW NUMBER $!number AT $!position DIRECTION $!string HEIGHT $!half MM

!oriString = !ori.string()
!posString = !position.string()
  -- Define aid box
  AID BOX NUMBER $!number XLEN 2000MM YLEN 2000MM ZLEN 10MM ORIENTATION $!oriString AT $!posString FILL ON

endfunction
-- End of function definition for !!aidOrientate
