--
-- Description:
-- construct an aid sphere at pos passed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Real]      [Aid number]
--   [2] [R]    [Position]  [position of sphere]
--   [3] [R]    [Real]      [Size of sphere]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidSphere(!number is REAL, !position is POSITION, !size is REAL)

 AID SPHERE NUMBER $!number $!position  DIAMETER  $!size MM

endfunction
-- End of function definition for !!aidSphere
