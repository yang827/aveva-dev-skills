-- File:            anglebetweenposs.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST ANG <position> TO <position> TO <position>
--
-- Author:          N.Holmes
-- Created:         Tue Mar 25 13:47:16 WAT 1997
--
--
-- Description:
-- Returns the angle between the passed 3 positions.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    First position
--    2   R      POSITION    Second position
--    3   R      POSITION    Third position
-- Return:
--   [Data Type] [Description]
--    REAL        Angle
--
------------------------------------------------------------------------

-- Define function
define function !!angleBetweenPoss (!posA is POSITION, !posB is POSITION, !posC is POSITION) is REAL

   -- Construct angle
   var !const CONSTRUCT ANGLE $!posA TO $!posB TO $!posC
   return !const.real()

endfunction
-- End of function definition for !!angleBetweenPoss
