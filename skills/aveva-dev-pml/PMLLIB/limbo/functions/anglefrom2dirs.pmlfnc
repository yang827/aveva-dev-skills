--
--
-- Description:
-- Returns direction from one position to another position. If no
-- direction can be derived, return Up.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Initial direction
--    2   R      DIRECTION   Second direction
-- Return:
--   [Data Type] [Description]
--    REAL        Angle between the 2 directions
--
------------------------------------------------------------------------

-- Define function
define function !!angleFrom2Dirs(!dirA is DIRECTION, !dirB is DIRECTION) is REAL

  -- Calculate direction
  var !const CONSTRUCT ANGLE $!dirA AND $!dirB
  if(!const.trim().empty()) then
    !const = '0'
  endif
  return !const.real()

endfunction
-- End of function definition for !!angleFrom2Dirs
