--
--
-- Description:
-- get angle from a plane and line
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [VECTOR]     [Plane in question]
--   [2] [R]    [VECTOR]     [Line in  question]
-- Return:
--   [Data Type] [Description]
--   [REAL]      [Angle between plane and line]
--
------------------------------------------------------------------------

-- Define function
define function !!angleplaneline(!plane is VECTOR, !line is VECTOR) is REAL

-- Set up string definition for command line
   !lineStr  = 'Line ' & !line.direction & ' Thro ' & !line.position
   !planeStr = ' Plane ' & !plane.direction & ' Thro ' & !plane.position
-- Calculate angle
   var !angle CONST ANGLE $!planeStr $!lineStr
   if(!angle.trim().empty()) then
      !angle = '0'
   endif

return !angle.real()

endfunction
-- End of function definition for !!angleplaneline
