-- File:            autonamece.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Tue Apr 22 09:41:24 BST 1997
--
--
-- Description:
-- Automatically names current element and members
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [Flag to control naming of CE members]
--
------------------------------------------------------------------------

-- Define function
define function !!autoNameCe(!mFlag is BOOLEAN)

  -- store current database position
  !dbPos = !!ce

  -- check if at world - otherwise takes for ever
  if ( !dbPos.type eq 'WORL' ) then
     !!alert.error('Autonaming does not work when at WORLD.')
     return
  endif

  -- Autoname Current Element
  if(!mFlag) then
    !coll = !!collectAllFor('', '(NAME neq FULLNAME)', !dbPos)
  else
    !coll = !!collectAllFor(!dbPos.type, '(NAME neq FULLNAME)', !dbPos)
  endif

  PROMPT DISMISS
  PROMPT OFF

  if (!coll.empty().not()) then
    do !i indices !coll
      !name = !!namOpt.nameString(!coll[!i], '', false, false)
      if (!name.unset().not()) then
        if(!name.occurs(' ').gt(0) ) then
          !!alert.message('Name should not contain spaces.
                           Evaluated name "$!name" contains spaces.')
          return
        endif

        !!ce = !coll[!i]
        NAME /$!name
        handle (41,12)
          -- Name already exists.
          skip
        endhandle
      endif
    enddo
  endif

  !!ce = !dbPos

endfunction
-- End of function definition for !!autoNameCe
