--
--
-- Description:
-- Function to transfer data from spcSpecSelect.pmlfrm to pml1 forms
-- cdFitSpec or cdPfitSpec.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!civTransferSpec()

  !formName = !!spcSpecSelect.mainForm.name()

  if (!formName eq 'cdFitSpec' or !formName eq 'cdPfitSpec') then

    !cdFitSpec = !!spcSpecSelect.mainForm
    if (!!spcSpecSelect.specLink.selection().catRef.set()) then
      !catr[1] = !!spcSpecSelect.specLink.selection().catRef.namn
    elseif (!!spcSpecSelect.specLink.selection().tmpRef.set()) then
      !catr[1] = !!spcSpecSelect.specLink.selection().tmpRef.namn
    else
      !!alert.error('Selected has no Catalogue or Template Reference')
      return
    endif
    !catrr[1] = !!spcSpecSelect.specLink.selection().name
    !cdFitSpec.spre.dText = !catr
    !cdFitSpec.spre.rText = !catrr

    !spec[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SPEC').description
    !specr[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SPEC').name
    !cdFitSpec.spec.dText = !spec
    !cdFitSpec.spec.rText = !specr

    !selez[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SELE').description
    !selezr[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SELE').name
    !cdFitSpec.styp.dText = !selez
    !cdFitSpec.styp.rText = !selezr

    !seley[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SELE').owner.description
    !seleyr[1] = !!dtbGetOwnerType(!!spcSpecSelect.specLink.selection(), 'SELE').owner.name
    !cdFitSpec.gtyp.dText = !seley
    !cdFitSpec.gtyp.rText = !seleyr

    !cdFitSpec.apply.active = true

  endif

endfunction
-- End of function definition for !!civTransferSpec
