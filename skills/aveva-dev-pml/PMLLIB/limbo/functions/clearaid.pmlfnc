-- File:            clearaid.pmlfnc
--   Type:          Function Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        limbo
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Mar 24 14:17:05 WAT 1997
--
--
-- Description:
-- Removed all aid arrows of the passed aid number.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      AID element type to be cleared
--    2   R      REAL        Aid tag number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!clearAid (!type is STRING, !number is REAL)

  -- Remove Aid Element
  AID CLEAR $!type $!number
  handle any
  endhandle

endfunction
-- End of function definition for !!clearAid
