-- File:            clock.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      var !var EVAR command
--
-- Author:          N.Holmes
-- Created:         Wed Feb 26 09:02:22 GMT 1997
--
--
-- Description:
-- Returns clock information
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    CLOCK       Clock data object
--
------------------------------------------------------------------------

-- Define function
define function !!clock() is CLOCK

  -- Initialise Variables
  !clock = object CLOCK()

  -- Date
  var !data CLOCK DATE
  !clock.date  = !data
  !clock.dom   = !data.part(1).real()
  !clock.month = !data.part(2)
  !clock.year  = !data.part(3).real()

  -- Get DOW from CLOCK MDB
  var !data CLOCK MDB
  !clock.dow   = !data.subString(9,3)

  -- Time
   var !data CLOCK TIME
  !clock.time  = !data

  -- Return
  return !clock

endfunction
-- End of function definition for !!clock
