-- File:            collect.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--   Keyword:       LIMBO
--   Module:        limbo
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Feb 14 09:36:54 GMT 1997
--
--
-- Description:
-- Generic collection routine
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      COLLECT     Collection object containing collect options
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of items collected
--
------------------------------------------------------------------------

-- Define function
define function !!collect (!options is COLLECT) is ARRAY
    -- Initialise Variables
  if(!options.classes.unset()) then
    !options.classes = 'ALL'
  endif

  -- Uses old VAR COLLECT to allow for special VAR COLLECT syntax and
  -- collection object not working with secondary hierarchies (before 12.1)

  -- Build a command string to be used with the var syntax
  !command = 'COLL'

  -- ALL (COLL ALL (types) with (expression) for <gid>
  if(!options.classes.upcase() eq 'ALL') then

    -- Types
    if(!options.types.set() and !options.types.empty().not()) then
      !command = !command & ' ALL (' & !options.types & ')'
    else
      !command = !command & ' ALL'
    endif

    -- Expression
    if(!options.expression.set() and !options.expression.empty().not()) then
      !command = !command & ' WITH (' & !options.expression &' )'
    endif

    -- Volume Information
    if(!options.volumeGid.set() or !options.volume.from.east.set()) then

      -- Exclusive within the volume
      if(!options.exclusive.set()) then
        if(!options.exclusive) then
          !command = !command & ' EXCLUSIVE'
        endif
      endif

      -- Within volume or volume of a gid
      if(!options.volumeGid.set()) then
        !command = !command & ' WITHIN VOLUME ' & !options.volumeGid.string()
      else
        !command = !command & ' WITHIN ' & !options.volume.from.string() & ' TO ' & !options.volume.to.string()
      endif

      -- Search item
      if(!options.search.set()) then
        !command = !command & ' FOR ' & !options.search.string()
      endif

    -- Collected form position in the hierarchy
    else

      -- Search item
      if(!options.search.set()) then
        !command = !command & ' FOR ' & !options.search.string()
      endif

    endif

  -- MEMBER (COLL MEMB of <gid> WITH (expression) )
  elseif (!options.classes.upcase() eq 'MEMBERS') then

    -- Set command to get member of item
    if(!options.search.set()) then
      !command = !command & ' MEMBERS OF ' & !options.search

    -- If there is no Options.search item, assume ALL
    else
      !command = !command & ' MEMBERS OF ALL'

    endif

    -- Expression
    if(!options.expression.set() and !options.expression.empty().not()) then
      !command = !command & ' WITH (' & !options.expression &' )'
    endif

    -- Volume Information
    if(!options.volumeGid.set() or !options.volume.from.east.set()) then

      -- Exclusive within the volume
      if(!options.exclusive.set()) then
        if(!options.exclusive) then
          !command = !command & ' EXCLUSIVE'
        endif
      endif

      -- Within volume or volume of a gid
      if(!options.volumeGid.set()) then
        !command = !command & ' WITHIN VOLUME ' & !options.volumeGid.string()
      else
        !command = !command & ' WITHIN ' & !options.volume.from.string() & ' TO ' & !options.volume.to.string()
      endif

    endif

  -- ITEMS
  elseif (!options.classes.upcase() eq 'ITEMS') then

  endif

  -- If the last word on the command is "ALL", then we need to tag WORLD to
  -- the command string
  if(!command.part(-1).eq('ALL') and !options.dbType.set()) then
    !command = !command & ' WORLD WITH DBTYPE EQ |' & !options.dbType & '|'
  endif

  var !result $!command
  handle any
    !errorMessage = 'Invalid collection (' & !command & ')'
    !!alert.error(!errorMessage)
    -- print collection command to allow user/developer to cut/paste and attempt to determine problem with collection command
    write(!errorMessage)
    return ARRAY()
  elsehandle none

    -- Convert the string array to an array of dbRefs. Done inside a do loop because the
    -- performance is better.
    !return = ARRAY()
    do !item value !result
      !return.append(!item.dbRef())
    enddo

    return !return
  endhandle

endfunction
-- End of function definition for !!collect
