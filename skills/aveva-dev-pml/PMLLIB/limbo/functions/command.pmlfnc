--
--
-- Description:
-- Action the passed string as a command
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Command string
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if there was no error
--
------------------------------------------------------------------------

-- Define function
define function !!command (!command is STRING) is BOOLEAN

  -- Set the selected colour
  $!command
  handle any
    return false
  endhandle
  return true

endfunction
-- End of function definition for !!command
