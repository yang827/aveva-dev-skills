--
--
-- Description:
-- Function to compose text using the VAR COMPOSE syntax.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Compose line to submit to VAR COMPOSE
-- Return:
--   [Data Type] [Description]
--    ARRAY       Text lines to return (unset on failure)
--
------------------------------------------------------------------------

-- Define function
define function !!composeText(!submission is STRING) is ARRAY

  -- Initialise variables
  !returnArray = ARRAY()

  -- Compose the string
  var !returnArray COMPOSE $!submission
  handle any

    -- Failed return empty array
    return !returnArray

  endhandle

  -- Success
  return !returnArray


endfunction
-- End of function definition for !!composeText
