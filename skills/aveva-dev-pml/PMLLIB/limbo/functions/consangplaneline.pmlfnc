-- File:            consangplaneline.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      Var Construct Angle  <plane> <line>
--
-- Author:          S.Hudson
-- Created:         Tue Mar 11 09:30:10 GMT 1997
--
--
-- Description:
-- Construct an angle between  a plane and a line
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Vector       Plane
--    2   R      Vector        Line
-- Return:
--   [Data Type] [Description]
--      Real      Angle
--
------------------------------------------------------------------------

-- Define function
define function !!consAngPlaneLine( !plane is VECTOR, !line is VECTOR) is REAL

!planeString = 'Plane ' & !plane.direction & ' Through ' & !plane.position
!lineString = 'Line ' & !line.direction & ' Through ' & !line.position

var !angleString CONSTRUCT ANGLE $!planeString $!lineString

return !angleString.real()

endfunction
-- End of function definition for !!consAngPlaneLine
