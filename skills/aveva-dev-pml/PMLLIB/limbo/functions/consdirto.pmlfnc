-- File:            consdirto.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      Var Construct Dir <pos> To <pos>
--
-- Author:          S.Hudson
-- Created:         Fri Mar 7 14:24:49 GMT 1997
--
--
-- Description:
-- Construct a Direction between two points
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Position    Start Position
--    2   R      Position    End Position
--    3   R      String      Status Message
-- Return:
--   [Data Type] [Description]
--    Direction   Direction
--
------------------------------------------------------------------------

-- Define function
define function !!consDirTo( !start is POSITION, !end is POSITION, !message is STRING) is DIRECTION

if (!start.eq(!end)) then
      !message = |Positions the same|
      return object Direction()
else
      !startString = !start.string()
      !endString = !end.string()
      var !direction CONSTRUCT DIRECTION $!startString TO $!endString
      !message = |Success|
      return !direction.direction()
endif

endfunction
-- End of function definition for !!consDirTo
