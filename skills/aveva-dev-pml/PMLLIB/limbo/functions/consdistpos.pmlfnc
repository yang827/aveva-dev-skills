--   Replaces:      Var Cons Distance <pos> to <pos>
--
-- Author:          S.Hudson
-- Created:         Mon Mar 10 14:37:18 GMT 1997
--
--
-- Description:
-- Calculate Distance Between Two Positions
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Position    First Position
--    2   R      Position    Second Position
-- Return:
--   [Data Type] [Description]
--    REAL        Distance between positions
--
------------------------------------------------------------------------

-- Define function
define function !!consDistPos(!first is POSITION, !second is POSITION) is REAL

!pos1 = !first.wrt(WORLD)
!pos2 = !second.wrt(WORLD)
!diff = !pos1.east - !pos2.east
!eastSquare = !diff * !diff
!diff = !pos1.north - !pos2.north
!northSquare = !diff * !diff
!diff = !pos1.up - !pos2.up
!upSquare = !diff * !diff

return ( Sqrt (!eastSquare + !northSquare + !upSquare) )

endfunction
-- End of function definition for !!consDistPos
