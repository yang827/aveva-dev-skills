--
-- File:            conslinepos.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      Var Construct Line Join <Pos> <Pos>
--
-- Author:          S.Hudson
-- Created:         Fri Mar 7 14:38:14 GMT 1997
--
--
-- Description:
-- Construct Line Between Two Positions
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Position    Start
--    2   R      Position    End
--    3   RW     String      Status Message
-- Return:
--   [Data Type] [Description]
--    Line        Line
--
------------------------------------------------------------------------

-- Define function
define function !!consLinePos(!start is POSITION, !end is POSITION, !message is STRING) is VECTOR

!return = object VECTOR()

if (!start.eq(!end)) then
      !message = |Positions the same|
      return !return
else

!startString = !start.string()
!endString = !end.string()
-- Use old syntax
      var !direction CONSTRUCT LINE JOIN $!startString TO $!endString

-- Convert String to Line object
      !return.direction = !direction.after('line').before('through').direction()
      !return.position = !direction.after('through').position()

      !message = |Success|
      return !return

endif

endfunction
-- End of function definition for !!consLinePos
