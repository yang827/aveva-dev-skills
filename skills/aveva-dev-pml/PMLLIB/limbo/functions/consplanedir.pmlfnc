-- Created:         Fri Mar 7 14:37:25 GMT 1997
--
--
-- Description:
-- Construct Plane given by direction and point
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Direction   Orthogonal
--    2   R      Position    Point on plane
--    3   R      String      Status Message
-- Return:
--   [Data Type] [Description]
--    Vector       Plane
--
------------------------------------------------------------------------

-- Define function
define function !!consPlaneDir(!direction is DIRECTION, !point is POSITION, !message is STRING) is VECTOR

!return = object VECTOR()

!return.direction is !direction
!return.position is !point

!message = |Success|
return !return

endfunction
-- End of function definition for !!consPlaneDir
