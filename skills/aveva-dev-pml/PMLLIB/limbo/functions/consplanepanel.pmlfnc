--
--
-- Description:
-- Construct a plane from panel vertices using the specified P-Point number
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Panel
--    2   R      REAL        P-Point number
--    3   RW     DBREF       Ploo reference
-- Return:
--   [Data Type] [Description]
--   PLANE       Plane of Vertices
--
------------------------------------------------------------------------

-- Define function
define function !!consPlanePanel(!panel is DBREF, !pPoint is REAL, !ploo is DBREF) is VECTOR

!message = STRING()
!ploo = !!findFirstMember(!panel, 'PLOO', '', !message)

!plane = !!consPlaneThro(!ploo.member[1].pPos[!pPoint], !ploo.member[2].pPos[!pPoint], !ploo.member[3].pPos[!pPoint], !message )
handle any
     !plane = !!consPlaneThro(!ploo.member[4].pPos[!pPoint], !ploo.member[2].pPos[!pPoint], !ploo.member[3].pPos[!pPoint], !message )
endhandle

return !plane

endfunction
-- End of function definition for !!consPlanePanel
