--
-- File:            consplanethro.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      Var Construct Plane Through <pos> and <pos> And <pos>
--
-- Author:          S.Hudson
-- Created:         Fri Mar 7 14:36:08 GMT 1997
--
--
-- Description:
-- Construct a Plane through three points
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Position    First Point
--    2   R      Position    Second Point
--    3   R      Position    Third Point
--    4   RW     String      Status Message
-- Return:
--   [Data Type] [Description]
--    Vector       Plane
--
------------------------------------------------------------------------

-- Define function
define function !!consPlaneThro(!first is POSITION, !second is POSITION, !third Is POSITION, !message is STRING) is VECTOR

!return = object VECTOR()

if (!first.eq(!second) or !first.eq(!third) or !third.eq(!second) ) then
      !message = |Two Positions the same|
      return !return
else

-- Use old syntax
      !firstString =  !first.string()
      !secondString = !second.string()
      !thirdString =  !third.string()
      var !plane CONSTRUCT PLANE THROUGH $!firstString AND $!secondString AND $!thirdString
-- Convert String to Plane object
      !return.direction = !plane.after('plane').before('through').direction()
      !return.position = !plane.after('through').position()

      !message = |Success|
      return !return

endif



endfunction
-- End of function definition for !!consPlaneThro
