--
-- Description:
-- Construct a Position from a Position relaxed on to a plane
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   R      VECTOR      Plane
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on Plane
--
------------------------------------------------------------------------

-- Define function
define function !!consPointOnPlane(!position is POSITION, !plane is VECTOR) is POSITION

-- Convert Arguments to String
!posString = !position.string()
!planeString = 'Plane ' & !plane.direction & ' Through ' & !plane.position

-- Old Syntax
var !pointString CONSTRUCT POSITION NEAREST $!posString ON $!planeString

-- Convert Answer from String
return !pointString.position()

endfunction
-- End of function definition for !!consPointOnPlane
