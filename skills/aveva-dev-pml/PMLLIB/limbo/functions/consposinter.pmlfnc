-- Created:         Mon Mar 10 13:35:09 GMT 1997
--
--
-- Description:
-- Construct Position at Intersection of Two Lines
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Vector        First Line
--    2   R      Vector        Second Line
--    3   RW     String      Message
-- Return:
--   [Data Type] [Description]
--    Position    Intersection
--
------------------------------------------------------------------------

-- Define function
define function !!consPosInter(!first is VECTOR, !second is VECTOR) is POSITION

!firstString = !first.direction.string() &  ' Through ' & !first.position.string()
!secondString = !second.direction.string() & ' Through ' & !second.position.string()

var !posString CONSTRUCT POSITION INTERSECT LINE $!firstString LINE $!secondString

return !posString.position()

endfunction
-- End of function definition for !!consPosInter
