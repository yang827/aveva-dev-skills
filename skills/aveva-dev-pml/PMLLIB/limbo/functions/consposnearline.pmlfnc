-- File:            consposnearline.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      Var CONS NEAR <pos> On <line>
--
-- Author:          S.Hudson
-- Created:         Tue Mar 25 13:38:20 GMT 1997
--
--
-- Description:
-- Find the position on a line that is nearest a given position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Position     Position
--    2   R      Vector         Line
-- Return:
--   [Data Type] [Description]
--    Position    Position on Line nearest given position
--
------------------------------------------------------------------------

-- Define function
define function !!consPosNearLine(!position is POSITION, !line is VECTOR) is POSITION

!posString = !position.string()
!lineString = !line.direction.string().before('WRT') & ' Through ' & !line.position.string().before('WRT')

var !posString CONSTRUCT POSITION NEAREST $!posString ON LINE $!lineString

return !posString.position()

endfunction
-- End of function definition for !!consPosNearLine
