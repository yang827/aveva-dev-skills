--
-- Description:
-- Construct a position at the intersection of a line and a plane
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VECTOR      Line
--    2   R      VECTOR      Plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!consPosPlaneLine(!first is VECTOR, !second is VECTOR) is POSITION

!firstString = !first.direction.string() &  ' Through ' & !first.position.string()
!secondString = !second.direction.string() & ' Through ' & !second.position.string()

var !posString CONSTRUCT POSITION INTERSECT LINE $!firstString PLANE $!secondString

return !posString.position()

endfunction
-- End of function definition for !!consPosPlaneLine
