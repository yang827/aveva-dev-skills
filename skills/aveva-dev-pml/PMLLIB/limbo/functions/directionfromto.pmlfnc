--
--
-- Description:
-- Returns direction from one position to another position. If no
-- direction can be derived, return Up.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    2   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction from to positions
--
------------------------------------------------------------------------

-- Define function
define function !!directionFromTo(!from is POSITION, !to is POSITION) is DIRECTION

  -- Calculate direction
  var !const CONSTRUCT DIRECTION $!from TO $!to
  if(!const.trim().empty()) then
    !const = 'U'
  endif
  return !const.direction()

endfunction
-- End of function definition for !!directionFromTo
