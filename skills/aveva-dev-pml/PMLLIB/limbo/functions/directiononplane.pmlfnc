--
--
-- Description:
-- Calculate the direction mapped onto a plane
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Initial direction
--    2   R      VECTOR      Plane definition
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Mapped direction
--
------------------------------------------------------------------------

-- Define function
define function !!directionOnPlane(!direction is DIRECTION, !plane is VECTOR) is DIRECTION

  -- Map Line onto plane
  var !const CONSTRUCT LINE PROJECTION LINE $!direction THROUGH $!plane.position  ON PLANE $!plane.direction THROUGH $!plane.position
  if(!const.trim().empty()) then
    return !direction
  endif

  var !const CONSTRUCT DIRECTION $!const
  return !const.direction()

endfunction
-- End of function definition for !!directionOnPlane
