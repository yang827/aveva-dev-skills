-- Created:         Tue Mar 18 10:24:22 GMT 1997
--
--
-- Description:
-- Function to return the contents and expanded path of a directory name
-- ****  may be a problem where contents is a list > 250 chars ****
-- ****  FULLNAME member returns CWD 99% of time ****
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Directory path
-- Return:
--   [Data Type] [Description]
--    DIRECTORY   Directory information
--
------------------------------------------------------------------------

-- Define function
define function !!directory(!directory is STRING) is DIRECTORY

  -- Initialise variables
  !return = object DIRECTORY()

  -- Check to see if directory exists
  var !unusedCheck DIRECTORY "$!directory"
  handle any

    return !return

  elsehandle none

    !return.name = !directory

  endhandle

  -- Subdirectories
  var !subDir DIRECTORY "$!return.name" DIR
  !return.subDirs   = !subDir.split()

  -- File entries
  var !file DIRECTORY "$!return.name" FILE
  handle(61,143)
    -- on NT empty directory raises 61,143 error
    var !file ''
  endhandle
  !return.files     = !file.split()

  -- Fullname (of directory only)
  var !fullName DIRECTORY "$!return.name" FULLNAME
  !entry           = !fullName.split()
  if (not !entry.empty()) then
    !return.fullName = !entry[1].before(|/| & !entry[1].part(-1,|/|))
  endif

  return !return

endfunction
-- End of function definition for !!directory
