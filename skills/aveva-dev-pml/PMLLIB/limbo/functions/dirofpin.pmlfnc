--
--
-- Description:
-- returns the direction of a pin using old syntax.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The number of the PIN
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Position of the pin
--
------------------------------------------------------------------------

define function !!dirOfPin(!number is REAL) is DIRECTION

  !direction = object DIRECTION()

  var !pdir DIR PIN$!number WRT WORLD
  !direction = $!pdir
  handle (2,779)
    !direction = axis $!pdir
  endhandle

  return !direction

endfunction
