--
--
-- Description:
-- Takes !direction, !position and !distance and creates a plane at this point.
-- It then returns the new position !distance away from the original
-- position along the !direction specified.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION
--    2   R      POSITION
--    3   R      REAL        Distance from Position
--
-- Return:
--   [Data Type] [Description]
--    POSITION    New position !distance away from !position along the
--                !direction
--
------------------------------------------------------------------------

define function !!dirPosDist(!direction is DIRECTION, !position is POSITION, !distance is REAL) is POSITION

  !newPos = object POSITION()

  var !plane CONSTRUCT PLANE $!direction THROUGH $!position DISTANCE $!distance
  var !pos   CONSTRUCT POSITION $!plane

  !newPos = $!pos

  return !newPos

endfunction
-- End of function definition for !!dirPosDist
