-- File:            distancefromto.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST DIST <position> TO <position>
--
-- Author:          N.Holmes
-- Created:         Mon Mar 24 18:27:55 WAT 1997
--
--
-- Description:
-- Returns the distance between two positions.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From Position
--    2   R      POSITION    To Position
-- Return:
--   [Data Type] [Description]
--    REAL        Distance between the two positions
--
------------------------------------------------------------------------

-- Define function
define function !!distanceFromTo (!from is POSITION, !to is POSITION) is REAL

  -- Handle unset data passed
  if(!from.east.unset() or !to.east.unset()) then
    return REAL()
  endif

  -- Const distance
  var !const CONSTRUCT DISTANCE $!from TO $!to
  return !const.real()

endfunction
-- End of function definition for !!distanceFromTo
