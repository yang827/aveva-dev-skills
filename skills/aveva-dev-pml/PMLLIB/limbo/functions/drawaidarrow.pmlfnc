--
--
-- Description:
-- Draw an aid arrow
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid line number
--    2   R      ARROW       Arrow definition object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAidArrow (!number is REAL, !arrow is ARROW )

  -- Default
  if(!arrow.length.unset()) then
    !arrow.length = 1000mm
  endif
  if(!arrow.ratio.unset()) then
    !arrow.ratio  = 0.1
  endif

  -- Define aid box
  AID ARROW NUMB $!number AT $!arrow.pos DIR $!arrow.dir HEIGHT $!arrow.length PROP $!arrow.ratio

endfunction
-- End of function definition for !!drawAidArrow
