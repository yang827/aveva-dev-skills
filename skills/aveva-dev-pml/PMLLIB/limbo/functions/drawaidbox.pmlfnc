--
-- Description:
-- Draw an aid box
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid line number
--    2   R      BOX         Box definition object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAidBox (!number is REAL, !box is BOX )

  -- Define aid box
  AID BOX NUMB $!number XLEN $!box.x YLEN $!box.y ZLEN $!box.z ORI $!box.ori AT $!box.pos

endfunction
-- End of function definition for !!drawAidBox
