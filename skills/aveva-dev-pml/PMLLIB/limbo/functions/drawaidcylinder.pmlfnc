--
--
-- Description:
-- Draw an aid cylinder
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Diameter of Cylinder
--    2   R      REAL        Height of Cylinder
--    3   R      POSITION    Position
--    4   R      ORIENTATION Orientation
--    5   R      BOOLEAN     Filled
--    6   R      REAL        Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAidCylinder(!size is REAL, !long is REAL, !position is POSITION, !ori is ORIENTATION, !filled is BOOLEAN, !number is REAL)

!oriString = !ori.string()
!posString = !position.string()
if (!filled) then
     AID CYLINDER NUMBER $!number POSITION $!posString ORIENTATION $!oriString DIAMETER $!size HEIGHT $!long FILLED ON
else
     AID CYLINDER NUMBER $!number POSITION $!posString ORIENTATION $!oriString DIAMETER $!size HEIGHT $!long
endif

endfunction
-- End of function definition for !!drawAidCylinder
