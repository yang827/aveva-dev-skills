--
-- Description:
-- Draw an Aid Sphere at Specified Position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Diameter of Sphere
--    2   R      POSITION    Position
--    3   R      REAL        Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAidSphere(!size is REAL, !position is POSITION, !number is REAL)

!posString = !position.string()
AID SPHERE NUMBER $!number $!posString DIAMETER $!size

endfunction
-- End of function definition for !!drawAidSphere
