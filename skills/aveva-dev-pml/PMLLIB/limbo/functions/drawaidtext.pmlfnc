--
--
-- Description:
-- Draw Aid Text at given position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Text
--    2   R      POSITION    Position of Text
--    3   R      REAL        Aid Text Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAidText(!text is STRING, !position is POSITION, !number is REAL)

-- Define Aid Text
!posString = !position.string()
AID TEXT NUMB $!number '$!text' AT $!posString

endfunction
-- End of function definition for !!drawAidText
