--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        common
--   Replaces:      Edit form gadget with . in name
--
-- Author:          S.Hudson
-- Created:         Tue Feb 25 16:45:37 GMT 1997
--
--
-- Description:
-- Edit given gadget using old syntax
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      String      Gadget to be changed
--    2   R      string      Value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!editGadget(!gadget is STRING,  !value is STRING) is BOOLEAN

$!<gadget>.val = $!value
handle any
     $!<gadget>.val = 0
endhandle

endfunction
-- End of function definition for !!editGadget
