--
-- File:            enhanceitem.pmlfnc
--   Type:          Function Definition
--   Group:         Colour handling routines
--     Keyword:     COLOUR
--   Module:        limbo
--   Replaces:      UNENHANCE/ENHANCEL
--
-- Author:          N.Holmes
-- Created:         Thu Mar 20 11:52:02 WAT 1997
--
--
-- Description:
-- Enhance the passed item with the specified colour. If no colour is passed,
-- then the items in the list will be unenhanced.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Items to be enhance
--    2   R      STRING      Colour item to be enhance in
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!enhanceItem (!passedItem is DBREF, !colour is STRING)

  -- If Passed item, is unset, then return
  if(!passedItem.unset()) then
    return
  endif

  -- Initialise Variables
  !item = !passedItem.string()

  -- If no colour is passed, unenhance item
  if(!colour.empty()) then
    UNENHANCE $!item

  -- Enhance
  else
    -- Get Colour Number
    !colourObj = object COLOUR(!colour)
    !colourNumber = !colourObj.code
    ENHANCE $!item COLOUR $!colourNumber
  endif

endfunction
-- End of function definition for !!enhanceItem
