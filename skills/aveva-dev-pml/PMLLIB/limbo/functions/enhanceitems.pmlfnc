--
-- File:            enhanceitems.pmlfnc
--   Type:          Function Definition
--   Group:         Colour handling routines
--     Keyword:     COLOUR
--   Module:        limbo
--   Replaces:      UNENHANCE/ENHANCEL
--
-- Author:          N.Holmes
-- Created:         Thu Mar 20 11:52:02 WAT 1997
--
--
-- Description:
-- Enhance all items within the passed list with the specified colour.
-- If no colour is passed, then the items in the list will be unenhanced.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       DBREF array of items to be enhance
--    2   R      STRING      Colour items to be enhance in
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!enhanceItems (!list is ARRAY, !colour is STRING)

  -- If Passed list is unset, then return
  if(!list.unset()) then
    return
  endif

  -- Convert DBREF array into a STRING array
  !block    = object BLOCK('!list[!evalIndex].string()')
  !items    = !list.evaluate(!block)

  -- If no colour is passed, unenhance item
  if(!colour.empty()) then
    UNENHANCE ALL FROM !items

  -- Enhance
  else
    -- Get Colour Number
    !colourNumber = !!colourNumber(!colour)
    -- White if all else fails
    if(!colourNumber.unset()) then
      !colourNumber = 10
    endif
    ENHANCE ALL FROM !items COLOUR $!colourNumber
  endif

endfunction
-- End of function definition for !!enhanceItems
