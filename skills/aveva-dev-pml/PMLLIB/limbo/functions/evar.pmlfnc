--
-- File:            evar.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      var !var EVAR command
--
-- Author:          N.Holmes
-- Created:         Mon Feb 24 11:28:22 GMT 1997
--
--
-- Description:
-- Returns the data assigned to the passed environment variable.
-- **  may be a problem where paths are > then 250 character **
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Environment variable name
-- Return:
--   [Data Type] [Description]
--    1   R      STRING      Data assigned to evar
--
------------------------------------------------------------------------

-- Define function
define function !!evar(!evar is STRING) is STRING

  if (!evar.trim() eq ||) then
    !data = ||
  else
    var !data EVAR '$!evar'
  endif
  return !data

endfunction
-- End of function definition for !!evar
