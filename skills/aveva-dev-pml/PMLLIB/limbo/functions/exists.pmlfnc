--
-- File:            exists.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      VAR <var> EXISTS <gid> [<type>] [UPDATE/DELETE]
--
-- Author:          N.Holmes
-- Created:         Tue Mar 18 09:19:43 WAT 1997
--
--
-- Description:
-- Check existence of item.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Item to be check, this is a string so that
--                           we don't fail on entry into the function.
--                           CE will check the current item.
--    2   R      STRING      Element type
--    3   R      STRING      Update or Delete access
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if item conforms to passed checks
--
------------------------------------------------------------------------

-- Define function
define function !!exists (!pItem is STRING, !passedType is STRING, !passedAccess is STRING) is BOOLEAN

  -- Initialise Variables
  !type   = !passedType
  !access = !passedAccess

  -- Check if CE has been passed
  if(!pItem.upcase() eq 'CE') then
    !item = !!ce.string()
  elseif(!pItem.subString(1,1) ne '=' and !pItem.subString(1,1) ne '/') then
    !item = '/' & !pItem
  else
    !item = !pItem
  endif

  -- Check for unset arguments
  if(!type.unset()) then
    !type = ''
  endif
  if(!access.unset()) then
    !access = ''
  endif

  -- Check for existence
  var !exists EXISTS $!item $!type $!access

  return !exists.subString(1,1).boolean()

endfunction
-- End of function definition for !!exists
