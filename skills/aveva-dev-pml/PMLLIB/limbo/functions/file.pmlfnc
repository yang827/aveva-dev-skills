-- File:            file.pmlfnc
--   Type:          Function Definition
--   Group:         File Handling
--     Keyword:     FILE
--   Module:        limbo
--   Replaces:      query file command
--
-- Author:          N.Holmes
-- Created:         Tue Feb 25 14:21:16 GMT 1997
--
--
-- Description:
-- File checking utility.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename
-- Return:
--   [Data Type] [Description]
--    FILE        File object containing all file date
--
------------------------------------------------------------------------

-- Define function
define function !!file(!filename is STRING) is FILE

  -- Thin layer to file object constructor
  !return = object FILE()
  !return.file(!filename)
  return !return

endfunction
-- End of function definition for !!file
