--
--
-- Description:
-- Function to add the files in a specified directory to the
-- supplied list gadget.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget to be populated
--    2   R      STRING      Directory path.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     returns true if successful
--
------------------------------------------------------------------------

-- Define function
define function !!file2List(!list is GADGET, !path is STRING) is BOOLEAN

  -- Build old style gadget name
  !uUName = |_|& !list.owner() & |_| & !list.name()

  -- Add contents to gadget
  var list $!uUName
    --add directory /$!path file
    handle any

      -- Error assigning values
      exit
      return false

    endhandle

  exit
  !list.dtext = !!dirfileentry('$!uUName','DIRS')
  -- A blank entry is added to the list if the directory specified
  -- contains no files. This workaround will remove it.
  !values = !list.dText
  if (!values.size() eq 1 and !values[1] eq ||) then

    -- Delete the blank entry
    !values.deleteFrom(1,1)
    !list.dText = !values

  endif

  -- Successful completion
  return true

endfunction
-- End of function definition for !!file2List
