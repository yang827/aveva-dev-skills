--
-- File:            findfile.pmlfnc
--   Type:          Function Definition
--   Group:         File Handling
--     Keyword:     FILE
--   Module:        common
--   Replaces:      VAR FILE syntax
--
-- Author:          S.Hudson
-- Created:         Tue Feb 25 10:56:46 GMT 1997
--
--
-- Description:
-- Use VAR !variable FILE !filename 'OPTION' to find file
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      String      File Name
--    2   R      String      Option
--    3   RW     String      Error Message
--    4   RW     String      Information
-- Return:
--   [Data Type] [Description]
--    Boolean    Status (True for success)
--
------------------------------------------------------------------------

-- Define function
define function !!findFile(!filename is STRING, !option is STRING, !message is STRING, !info is STRING) is BOOLEAN

-- Check Arguments
if (Undefined(!filename) or !filename.length() le 0) then
      !message = |No File Name Supplied|
      return false
endif
if (Undefined(!option) or !option.length() le 0) then
      !message = |No Option Supplied|
      return false
endif

-- Try Old Syntax
if !filename.substring(1,1).eq('/') then
 !filename = !filename.after('/')
endif
var !info FILE "$!filename" $!option

handle any
      !message = !!error.text
      return false
endhandle

return true

endfunction
-- End of function definition for !!findFile
