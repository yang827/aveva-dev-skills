--
-- Description:
-- Determine the angle between the plane passed and two
-- points producing a line
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [PLANE]     [Plane of ASL (normally up thro EndPos)]
--   [2] [R]    [POSITION]  [Start Position of ASL component]
-- Return:
--   [Data Type] [Description]
--   [REAL]      [Angle between plane and the line of the ASL component]
--
------------------------------------------------------------------------

-- Define function
define function !!getAngPlanePts(!plane is VECTOR, !startPos is POSITION) is REAL

!planeTmp = 'Plane ' & !plane.direction  & ' Thro ' & !plane.position

var !line CONSTRUCT LINE JOIN $!startPos TO $!plane.position
var !angle CONSTRUCT ANGLE $!planeTmp $!line

!rAngle = !angle.real()

return !rAngle

endfunction
-- End of function definition for !!getAngPlanePts
