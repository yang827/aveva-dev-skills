--
--
-- Description:
-- Return all elements of given type from current list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]

--
-- Return:
--   [Data Type] [Description]
--    ARRAY of DBREF   List of objects in current list
--
------------------------------------------------------------------------

-- Define function
define function !!getCurrentList() is ARRAY

 !currentList = ARRAY()

  -- Find out if a current list is available
  var !numb ($_cdList_NAME)
  if ( !numb.unset() ) then
    return !currentList
  endif

  !cListNumb = !numb.real()

  if ( !cListNumb.eq(0) ) then
    return !currentList
  endif

  -- Get current list into a local variable
  !cList = !!cdList$!numb
  handle any
    return !currentList
  endhandle
  !block = object BLOCK('!cList[!evalIndex].dbRef()')
  !currentList = !cList.evaluate(!block)

  return !currentList

endfunction
-- End of function definition for !!getCurrentList
