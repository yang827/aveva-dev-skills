-- File:            getderivedend.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Tue Mar 18 14:48:46 GMT 1997
--
--
-- Description:
-- Limbo Function For The Geometric Calculator.
-- Function to get derived length of ASL component
-- Based on the Default values stored on the Spec.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [REAL]      [Angle of ASL component]
--   [2] [R]    [STRING]    [Direction of ASL Component Rotation]
--   [3] [R]    [POSITION]  [Start Position of ASL Component]
--   [4] [R]    [REAL]      [Height of ASL Component from Defaults]
-- Return:
--   [Data Type] [Description]
--   [Position]  [Position of derived ASL component End, based on defaults]
--
------------------------------------------------------------------------

-- Define function
define function !!getDerivedEnd(!angle is REAL, !direction is DIRECTION, !pos is POSITION, !maxH is REAL, !upOrDown is DIRECTION) is POSITION

-- convert direction to string without WRT
   !dirAsStrg = !direction.string().before(|WRT|)
   !uDirAsStrg = !upOrDown.string().before(|WRT|)

  var !plane CONSTRUCT PLANE $!dirAsStrg $!angle $!uDirAsStrg THROUGH $!pos dist $!maxH
  var !endPos CONSTRUCT POSITION $!plane

 !return = !endPos.position()

 return !return

endfunction
-- End of function definition for !!getDerivedEnd
