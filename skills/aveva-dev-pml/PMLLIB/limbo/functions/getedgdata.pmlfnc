--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!getEdgData() is EDGDATA

-- Initialise Objects

   !return = object EDGDATA()

-- load object data

   !return.item          = !!edgGeomData.pickedItem
   !return.vec.position  = !!edgGeomData.pickPosition
   !return.vec.direction = !!edgGeomData.pickLine
   !return.dir           = !!edgGeomData.direction
   !return.pos           = !!edgGeomData.position

return !return

endfunction
-- End of function definition for !!getEdgData
