-- Define function
define function !!getMbchar() is STRING

--ALPHA LOG /%PDMSUSER%/mbcharset.dat OVER
--q proj mbchar
--ALPHA LOG END
--!data = !!readfile('%PDMSUSER%/mbcharset.dat')

--Return !data[2]

-- Above code replaced by below code because
-- query outputs to requests window and because
-- the alpha log complicates bug fixing.
var !mbchar PROJ MBCHAR
return !mbchar

endfunction
-- End of function definition for !!getMbchar
