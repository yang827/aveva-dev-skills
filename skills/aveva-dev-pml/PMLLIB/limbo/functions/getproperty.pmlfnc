--
--
-- Description:
-- Extracts property from dataset.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Property
--    2   R      DBREF       Current Element
-- Return:
--   [Data Type] [Description]
--    ANY         Property
--
------------------------------------------------------------------------

-- Define function
define function !!getProperty(!property is STRING,!current is DBREF) is ANY

var !a ( PROP $!property OF $!current )

!b = $!a
handle any
!b = '$!a'
endhandle


return !b

endfunction
-- End of function definition for !!getProperty
