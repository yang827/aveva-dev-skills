--
--
-- Description:  Function To Store  Rules In An Array Of The Passed Element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Dbref]     [Dbref for rule extraction]
-- Return:
--   [Data Type] [Description]
--   [Array]     [Array of rules]
--
------------------------------------------------------------------------

-- Define function
define function !!getRules(!dbRef is DBREF) is ARRAY

-- Set where we are
   !refe = !!ce
-- Initialise Variables

   !ruleDefinition = ARRAY()

-- Goto element passed
   !!ce = !dbRef

-- find out rules that are set

   var !ruleList RLIST

-- Split into each individual rule

   !rules = !ruleList.split()

-- Handle the fact that there are no rules

--   if(!rules[1] eq 'unset') then
  --  return
  -- endif

-- load rules into the array

   do !indx indices !rules
      var !rule RULE OF $!rules[$!indx]
    handle any
    elsehandle none
    if(!rule.match('Dynamic') neq 0) then
        !newRule = 'Rule Set ' & !rule.replace('Rule','')
    else
        !newRule = 'Rule Set ' & !rule.replace('Static Rule','')
    endif
      !ruleDefinition.append(!newRule.string())
    endhandle
   enddo


-- Reset Hierarchy Position

   !!ce = !refe

return !ruleDefinition

endfunction
-- End of function definition for !!getRules
