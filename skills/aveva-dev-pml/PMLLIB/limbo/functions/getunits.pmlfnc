--
-- Description:
-- function to return current units
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [String]    [Current units]
--
------------------------------------------------------------------------

-- Define function
define function !!getUnits() is STRING

 var !units UNITS

 !currentUnits = |$!units|


 return  !currentUnits

endfunction
-- End of function definition for !!getUnits
