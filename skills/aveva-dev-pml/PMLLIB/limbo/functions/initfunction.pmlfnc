--
--
-- Description:
-- File to be run as module IMACRO to invoke the modules INIT FUNCTION.
-- The format of the function name is <module>start.pml
-- **** This function is invoked using $M syntax. ****
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

  -- Get the current module
  !sessionData  = CURRENT SESSION
  !module       = !sessionData.module()

  -- Construct function name
  !function     = |!!|& !module &|Start()|

  -- Invoke the function
  call $!function
