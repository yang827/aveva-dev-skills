--
--
-- Description:
-- function to determine the line from the passed
-- direction and position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lineDirPos(!dir is DIRECTION,!pos is POSITION) is VECTOR

var !lin CONSTRUCT LINE $!dir THROUGH $!pos

 !line = object VECTOR()
 !line.position  = !lin.after('through').position()
 !line.direction = !lin.after('line').before('through').direction()

 return !line

endfunction
-- End of function definition for !!lineDirPos
