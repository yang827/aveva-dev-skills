-- File:            linefromto.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST LINE JOIN <pos> TO <pos>
--
-- Author:          N.Holmes
-- Created:         Wed Apr 9 13:18:29 WAT 1997
--
--
-- Description:
-- Returns a line as a vector between two positions.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    From position
--    2   R      POSITION    To position
-- Return:
--   [Data Type] [Description]
--    VECTOR      Line as a vector
--
------------------------------------------------------------------------

-- Define function
define function !!lineFromTo (!from is POSITION, !to is POSITION) is VECTOR

  -- Handle unset positions passed
  if(!from.east.unset() or !to.east.unset()) then
    return object VECTOR()
  endif

  -- Construct line
  var !const CONSTRUCT LINE JOIN $!from TO $!to

  return !!lineToVector(!const)

endfunction
-- End of function definition for !!lineFromTo
