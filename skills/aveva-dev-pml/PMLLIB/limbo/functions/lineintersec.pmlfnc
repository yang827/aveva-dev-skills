--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Thu Apr 17 14:00:04 BST 1997
--
--
-- Description:
-- Takes 2 positions and creates a line. It then creates another line from
-- the vector argument. The position of the intersection of the 2 lines
-- is returned.
--
-- Used by EDG functions to determine which end of a tube etc. is picked.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    First position on line 1
--    2   R      POSITION    Second position on line 1
--    3   R      VECTOR      Used to create line 2
--
-- Return:
--   [Data Type] [Description]
--    POSITION    Position of intersection of the 2 lines
--
------------------------------------------------------------------------

define function !!lineIntersec(!pos1 is POSITION, !pos2 is POSITION, !vector is VECTOR) is POSITION

  !returnPos = object POSITION()

  var !line1 CONSTRUCT LINE JOIN $!pos1 TO $!pos2
  var !line2 CONSTRUCT LINE $!vector.direction THROUGH $!vector.position

  var !actualPos  CONSTRUCT POSITION INTER $!line1 $!line2

  !returnPos = !actualPos.position()

  return !returnPos

endfunction
-- End of function definition for !!lineIntersec
