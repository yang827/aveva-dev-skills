-- File:            lineonplane.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST LINE PROJ <line> ON <plane>
--
-- Author:          N.Holmes
-- Created:         Wed Apr 9 13:18:29 WAT 1997
--
--
-- Description:
-- Returns a line projected onto the passed plane.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VECTOR      Line as a VECTOR
--    2   R      VECTOR      Plane as a VECTOR
-- Return:
--   [Data Type] [Description]
--    VECTOR      Line as a vector
--
------------------------------------------------------------------------

-- Define function
define function !!lineOnPlane (!line is VECTOR, !plane is VECTOR) is VECTOR

  -- Construct line
  var !const CONSTRUCT LINE PROJECTION LINE $!line.direction THROUGH $!line.position ON PLANE $!plane.direction THROUGH $!plane.position

  return !!lineToVector(!const)

endfunction
-- End of function definition for !!lineOnPlane
