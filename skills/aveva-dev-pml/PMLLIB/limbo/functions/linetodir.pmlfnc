--
-- Description:
-- function to convert line to dir
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [VECTOR]    [Line]
-- Return:
--   [Data Type] [Description]
--   [DIRECTION] [resultant Direction]
--
------------------------------------------------------------------------

-- Define function
define function !!lineToDir(!line is VECTOR) is DIRECTION

 var !dir CONSTRUCT DIRECTION LINE $!line.direction THROUGH $!line.position
 !direction = !dir.direction()

 return !direction

endfunction
-- End of function definition for !!lineToDir
