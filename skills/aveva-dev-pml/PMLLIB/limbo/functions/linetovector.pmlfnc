--
--
-- Description:
-- Converts the passed line (string format LINE <dir> THROUGH <pos>)
-- into a VECTOR.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Line as a string
-- Return:
--   [Data Type] [Description]
--    VECTOR      Line as a Vector
--
------------------------------------------------------------------------

-- Define function
define function !!lineToVector (!line is STRING) is VECTOR

  -- Initialise Variables
  !returnVector              = object VECTOR()

  -- Get Position
  var !const CONSTRUCT POSITION $!line
  !returnVector.position     = !const.position()

  -- Get Position
  var !const CONSTRUCT DIRECTION $!line
  !returnVector.direction    = !const.direction()

  return !returnVector

endfunction
-- End of function definition for !!lineToVector
