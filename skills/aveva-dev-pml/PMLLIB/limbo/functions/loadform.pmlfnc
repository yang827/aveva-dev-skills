--
-- Description:
-- Load an form definition file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!loadForm (!form is STRING)

  -- Initialise Variables
  !formFile   = !form.lowcase()

  -- Load form
  pml reload form !!$!formFile

  return

endfunction
-- End of function definition for !!loadForm
