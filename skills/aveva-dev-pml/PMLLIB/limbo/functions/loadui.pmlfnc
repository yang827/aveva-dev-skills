--
--
-- Description:
-- Pseudo dynamic loading
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [STRING] [key for form loading]
--
------------------------------------------------------------------------

-- Define function
define function !!loadUi(!key is STRING)

  if (!key eq 'Query General') then

    var !display FORM _cdGenQ DISPLAY
    handle any
      $m "%PDMSUI%/DES/GEN/FGENQ"
      $m "%PDMSUI%/DES/GEN/FPPNUM"
      $m "%PDMSUI%/DES/GEN/FWRTNAME"
      $m "%PDMSUI%/DES/GEN/FBOLTQ"
    endhandle
    show _cdGenQ

  elseif (!key eq 'Data Consistency') then

    var !display FORM _cdDatChk DISPLAY
    handle any
      $m "%PDMSUI%/DES/GEN/FDATCHK"
      $m "%PDMSUI%/DES/GEN/FDATNAME"
      $m "%PDMSUI%/DES/GEN/FDATPOPT"
      $m "%PDMSUI%/DES/GEN/FDATSOPT"
      $m "%PDMSUI%/DES/GEN/FDATUOPT"
    endhandle
    show _cdDatChk

  elseif (!key eq 'Units') then

    var !display FORM _cdUnits DISPLAY
    handle any
      $m "%PDMSUI%/DES/GEN/FUNITS"
    endhandle
    show _cdUnits

  elseif (!key.subString(1,7) eq 'Reports') then

    var !display FORM _cdRepDef DISPLAY
    handle any
      $m "%PDMSUI%/CLIB/FILES/FFILEMOTIF"
      $m "%PDMSUI%/CLIB/REP/FREPDEF"
      $m "%PDMSUI%/CLIB/REP/FCOLDEF"
      $m "%PDMSUI%/CLIB/REP/FMOVCOL"
      $m "%PDMSUI%/CLIB/REP/FREPDRW"
      $m "%PDMSUI%/CLIB/REP/FREPRMPT"
      $m "%PDMSUI%/CLIB/REP/FREPPAGLEN"
    endhandle
    if (!key.after('Reports ') eq 'Run') then
      $m "%PDMSUI%/CLIB/REP/XREPSEL" $<RUN$>
    elseif (!key.after('Reports ') eq 'Create') then
      $m "%PDMSUI%/CLIB/REP/XREPDEF"
    elseif (!key.after('Reports ') eq 'Modify') then
      $m "%PDMSUI%/CLIB/REP/XREPSEL" $<MODIFY$>
    elseif (!key.after('Reports ') eq 'Delete') then
      $m "%PDMSUI%/CLIB/REP/XREPSEL" $<DELETE$>
    endif

  endif

endfunction
-- End of function definition for !!loadUi
