--
--
-- Description:
-- Returns local volume of passed item wrt to passed item
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item volume is to be returned from
--    2   R      DBREF       Item volume is to be returned wrt
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!localVolume (!item is DBREF, !wrt is DBREF) is VOLUME

  -- Get volume of current element
  var !volString LVOL OF $!item WRT $!wrt

  !split              = !volString.split()
  !volume             = object VOLUME()
  !volume.from.east   = !split[1].real()
  !volume.from.north  = !split[2].real()
  !volume.from.up     = !split[3].real()
  !volume.from.origin = !wrt
  !volume.to.east     = !split[4].real()
  !volume.to.north    = !split[5].real()
  !volume.to.up       = !split[6].real()
  !volume.to.origin   = !wrt

  return !volume

endfunction
-- End of function definition for !!localVolume
