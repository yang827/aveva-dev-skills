--
--
-- Description:
-- Returns all the lengths (distances) for each pair of positions
-- passed. Length is calculated from last to first.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Positions
-- Return:
--   [Data Type] [Description]
--    ARRAY       Lengths of each edge
--
------------------------------------------------------------------------

-- Define function
define function !!loopEdgeLengths(!positions is ARRAY) is ARRAY

  -- Initialise Variables
  !distance = ARRAY()

  -- Build new array, remove first and add to the end
  !newPos = !positions
  !newPos[1].delete()
  !newPos.compress()
  !newPos.append(!positions[1])

  do !i indices !positions
    var !dist CONSTRUCT DISTANCE $!positions[$!i] TO $!newPos[$!i]
    !distance.append(!dist.real())
  enddo
  return !distance

endfunction
-- End of function definition for !!loopEdgeLengths
