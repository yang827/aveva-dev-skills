--
-- File:            module.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:      var !var EVAR command
--
-- Author:          N.Holmes
-- Created:         Mon Feb 24 12:02:22 GMT 1997
--
--
-- Description:
-- Returns the current  module data
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!module() is MODULE

  -- This function remains to service existing calls. The MODULE object now
  -- initialises itself
  !!comModuleCache = object MODULE()
  return !!comModuleCache

  -- Get Module Data
  var !data BANN NAME

  -- Initialise Variable
  if (undefined(!!comModuleCache)) then
    !!comModuleCache = object MODULE()
  elseif (!data eq !!comModuleCache.name) then
    return !!comModuleCache
  endif

  return !!comModuleCache


  !!comModuleCache.name        = !data

  -- Appware Name
  if (match(!!comModuleCache.name.upcase(), 'DESIGN') gt 0) then
    !!comModuleCache.appName   = 'Design'
    !!comModuleCache.appKey    = 'des'
    !!comModuleCache.modKey    = 'des'
  elseif (match(!!comModuleCache.name.upcase(), 'PARAGON') gt 0) then
    !!comModuleCache.appName   = 'Paragon'
    !!comModuleCache.appKey    = 'cat'
    !!comModuleCache.modKey    = 'cat'
  elseif (match(!!comModuleCache.name.upcase(), 'ISODRAFT') gt 0) then
    !!comModuleCache.appName   = 'Isodraft'
    !!comModuleCache.appKey    = 'iso'
    !!comModuleCache.modKey    = 'iso'
  elseif (match(!!comModuleCache.name.upcase(), 'DRAFT') gt 0) then
    !!comModuleCache.appName   = 'Draft'
    !!comModuleCache.appKey    = 'dra'
    !!comModuleCache.modKey    = 'dra'
  elseif (match(!!comModuleCache.name.upcase(), 'ADMIN') gt 0) then
    !!comModuleCache.appName   = 'Admin'
    !!comModuleCache.appKey    = 'adm'
    !!comModuleCache.modKey    = 'adm'
  elseif (match(!!comModuleCache.name.upcase(), 'SPOOLER') gt 0) then
    !!comModuleCache.appName   = 'Spooler'
    !!comModuleCache.appKey    = 'spl'
    !!comModuleCache.modKey    = 'spl'
  elseif (match(!!comModuleCache.name.upcase(), 'MONITOR') gt 0) then
    !!comModuleCache.appName   = 'Monitor'
    !!comModuleCache.appKey    = 'mon'
    !!comModuleCache.modKey    = 'mon'
  elseif (match(!!comModuleCache.name.upcase(), 'HULLDESIGN') gt 0) then
    !!comModuleCache.appName   = 'HullDesign'
    !!comModuleCache.appKey    = 'marhdes'
    !!comModuleCache.modKey    = 'marhdes'
    !!comModuleCache.productFamily  = 'Hull'
  elseif (match(!!comModuleCache.name.upcase(), 'MARINEDRAFTING') gt 0) then
    !!comModuleCache.appName   = 'MarineDrafting'
    !!comModuleCache.appKey    = 'mardra'
    !!comModuleCache.modKey    = 'mardra'
    !!comModuleCache.productFamily  = 'Hull'
  elseif (match(!!comModuleCache.name.upcase(), 'OUTFITTING') gt 0) then
    !!comModuleCache.appName   = 'Design'
    !!comModuleCache.appKey    = 'des'
    !!comModuleCache.modKey    = 'marodes'
  elseif (match(!!comModuleCache.name.upcase(), 'OUTFITTINGDRAFT') gt 0) then
    !!comModuleCache.appName   = 'Draft'
    !!comModuleCache.appKey    = 'dra'
    !!comModuleCache.modKey    = 'marodra'
  elseif (match(!!comModuleCache.name.upcase(), 'DIAGRAMS') gt 0) then
    !!comModuleCache.appName   = 'Diagrams'
    !!comModuleCache.appKey    = 'diagrams'
    !!comModuleCache.modKey    = 'diagrams'
    !!comModuleCache.productFamily  = ''
  elseif (match(!!comModuleCache.name.upcase(), 'SCHEMATICMODELMANAGER') gt 0) then
    !!comModuleCache.appName   = 'SchematicModelManager'
    !!comModuleCache.appKey    = 'smm'
    !!comModuleCache.modKey    = 'smm'
    !!comModuleCache.productFamily  = ''
  elseif (match(!!comModuleCache.name.upcase(), 'TAGS') gt 0) then
    !!comModuleCache.appName   = 'Tags'
    !!comModuleCache.appKey    = 'tags'
    !!comModuleCache.modKey    = 'tags'
    !!comModuleCache.productFamily  = ''
  endif

  var !data BANN STATUS
  !!comModuleCache.status      = !data

  var !data BANN COPYRIGHT
  !!comModuleCache.copyright   = !data

  var !data BANN COMPANY
  !!comModuleCache.company     = !data

  -- Get Short Banner and parse data from it
  -- format '<module name> <version> (<compile OS>) (<compile date>)'
  var !data BANN SHORT

  -- Version
  !!comModuleCache.version     = !data.after(!!comModuleCache.name).before('(').trim()

  -- Compile OS
  !!comModuleCache.compileOS   = !data.after('(').before(')').trim()

  -- Compile Date
  !data               = !data.after(')')
  !!comModuleCache.compileDate = !data.after('(').before(')').trim()

  -- DDL Data
  -- Format <ddl type> DDL - Mark <version> <date>
  if (!!comModuleCache.appName ne 'Monitor') then

    var !data DDL

    -- DDL Type
    !!comModuleCache.ddlType     = !data.part(1)

    -- DDL Version
    !!comModuleCache.ddlVersion  = !data.part(5)

    -- DDL Data
    !!comModuleCache.ddlDate     = !data.part(-1)

  endif

  -- Return
  return !!comModuleCache

endfunction
-- End of function definition for !!module
