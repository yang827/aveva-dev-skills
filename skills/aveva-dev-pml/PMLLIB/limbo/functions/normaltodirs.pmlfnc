--
-- Description:
-- Function to return normal direction from
-- 2 directions passed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DIRECTION] [First Direction]
--   [2] [R]    [DIRECTION] [Second Direction]
-- Return:
--   [Data Type] [Description]
--   [DIRECTION] [Normal Direction]
--
------------------------------------------------------------------------

-- Define function
define function !!normalToDirs(!dir1 is DIRECTION, !dir2 is DIRECTION) is DIRECTION

var !dir CONSTRUCT DIRECTION ORTHOGONAL $!dir1 AND $!dir2

!direction = !dir.direction()

return !direction

endfunction
-- End of function definition for !!normalToDirs
