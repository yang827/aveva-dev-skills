-- File:            offsetplane.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST PLANE <plane> DIST <dist>
--
-- Author:          N.Holmes
-- Created:         Mon Apr 7 09:39:03 WAT 1997
--
--
-- Description:
-- Offsets the passed plane by the given distance, returns a
-- new plane vector.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VECTOR      Plane as a vector
--    2   R      REAL        Distance plane is to be offset
-- Return:
--   [Data Type] [Description]
--    VECTOR      New plane as vector
--
------------------------------------------------------------------------

-- Define function
define function !!offsetPlane (!plane is VECTOR, !distance is REAL) is VECTOR

  -- Construct New plane
  var !const CONST PLANE $!plane.direction THROUGH $!plane.position DISTANCE $!distance
  return !!planeToVector(!const)

endfunction
-- End of function definition for !!offsetPlane
