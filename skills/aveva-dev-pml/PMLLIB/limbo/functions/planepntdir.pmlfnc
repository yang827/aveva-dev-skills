--
-- Description:
-- Function to get plane from point and direction
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [POSITION]  [Position plane is thro]
--   [2] [R]    [DIRECTION] [Direction of plane]
-- Return:
--   [Data Type] [Description]
--   [STRING]     [Resultant Plane]
--
------------------------------------------------------------------------

-- Define function
define function !!planePntDir(!pos is POSITION, !dir is DIRECTION) is VECTOR

 var !plane CONSTRUCT PLANE $!dir THROUGH $!pos

 !vector = object VECTOR()
 !vector.position  = !plane.after('through').position()
 !vector.direction = !plane.after('plane').before('through').direction()

return !vector

endfunction
-- End of function definition for !!planePntDir
