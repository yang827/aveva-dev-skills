--
-- Description:
-- return position based on angle of ASL and plane picked
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!posPlaneLine(!startPos is POSITION,!endPos is POSITION, !endDerPos is POSITION) is POSITION


 var !line CONSTRUCT LINE JOIN  $!startPos TO  $!endDerPos
 var !plane CONSTRUCT PLANE UP THROUGH $!endPos
 var !pos CONSTRUCT POSITION INTERSECT $!line $!plane


!return = !pos.position()

return !return

endfunction
-- End of function definition for !!posPlaneLine
