--
-- Author:          L.Guyon
-- Created:         Thu May 22 12:53:16 BST 1997
--
--
-- Description:
-- outputs syntax for the plotDetailData syntax of isodraft
--
-- Modified by J.M.McCoy (12Mar09) for
-- P-8842 (Unable to delete Plotfilenames in the Detail Plots
-- form)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!plotDetailSyntax(!arg1 is REAL, !arg2 is STRING, !arg3 is STRING, !arg4 is STRING, !arg5 is STRING, !arg6 is STRING, !arg7 is STRING ,!arg8 is STRING, !arg9 is STRING)

if(!arg1 eq 1) then
   $!!deplots.units DISTANCE
elseif(!arg1 eq 2) then
   TEXTPOS DETAILPLOTS CORNER $!arg2 AT x $!arg3 y $!arg4 CHAR HEIGHT $!arg5 DIRECTION $!arg6 STACK $!arg7 DIRECTION $!arg8 SCALE $!arg9
elseif(!arg1 eq 3) then

-- Truncate all number fields of PLOTDETAILDATA option to be integers
!trnvar = !arg3.split()
!arg3 = ''
do !count to !trnvar.size()
   if (!trnvar[!count].Occurs('.') gt 0) then
      !trnvar[!count] = !trnvar[!count].before('.')
   endif
   !arg3 = !arg3 & ' ' & !trnvar[!count]
enddo
!arg3 = !arg3.trim()

   PLOTDETAIL $!arg2 ATTRIB $!arg3
   handle (47,15)
      !locvar = !arg3.split()
      !size = !locvar.size()
      if(!size eq 9) then
        !!alert.error('Syntax Error in attribute definition ' & !locvar[1] )
      elseif(!size eq 10) then
        !!alert.error('Syntax Error in attribute definition ' & !locvar[1] & ' ' & !locvar[2])
      elseif(!size eq 11) then
        !!alert.error('Syntax Error in attribute definition ' & !locvar[1] & ' ' & !locvar[2] & ' ' & !locvar[3])
      else
        !!alert.error('Syntax Error in attribute definition ' & !arg3 )
      endif
   elsehandle (2,5)
      !!alert.error('Error in attribute definition ' & !!error.text)
   endhandle
elseif(!arg1 eq 4) then
   TEXTPOS DETAILPLOTS MANUAL CHAR HEIGHT $!arg5 SCALE $!arg9
endif

endfunction
-- End of function definition for !!plotDetailSyntax
