-- File:            pos3dplaneline.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:    const pos inter <line>  <plane>
--
-- Author:          A.Kirkland
-- Created:         Thu Mar 20 16:18:14 GMT 1997
--
--
-- Description:
-- function to return position from plane and direction
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [VECTOR]    [line]
--   [2] [R]    [VECTOR]    [plane]
-- Return:
--   [Data Type] [Description]
--   [POSITION]  [Position of the intersection of line and plane]
--
------------------------------------------------------------------------

-- Define function
define function !!pos3DplaneLine(!plane is VECTOR, !line is VECTOR) is POSITION

!lineStr  = 'Line ' & !line.direction & ' Thro ' & !line.position
!planeStr = ' Plane ' & !plane.direction & ' Thro ' & !plane.position
var !pos CONSTRUCT POSITION INTERSECT $!lineStr  $!planeStr

return !pos.position()

endfunction
-- End of function definition for !!pos3DplaneLine
