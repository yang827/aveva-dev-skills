--   Group:         2D Positioning ALL
--     Keyword:     POS
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Oct 14 14:39:26 BST 1998
--
--
-- Description:
-- function to calc zdist and pass result to the old style form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]       [Edg data from position pick]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!posCalcZDist(!data is ANY)

  !refe       = !!ce

  !gensec     = FALSE
  !position   = !data.position

  -- need to get the item created from the old form
   !form = !!cdFitSpec
    !item = !form.ceName.val.dbRef()
     handle any
        var user _cdFitSpec SEL 1
        !user = '$_cdFitSpec_UserData'
        !item = !user.dbRef()
        var user _cdFitSpec SEL 2
     endhandle

  -------------------------------------------------


  if(!item.hardType inset('FIXING','FITT','CMFI')) then

    if(!item.hardType.eq('FIXING')) then
      !!ce = !item
      JLDATU
      !item = !!ce.owner
      !gensec = TRUE
    else
      !item = !item.owner
    endif
  else
    !owner = !!penGetOwningType(!item)
    if(!owner.hardType.eq('GENSEC')) then
      !gensec = TRUE
    endif
  endif

  !!ce = !item

 -- q var !item.type

  -- calc zdist from the position picked

  if(!gensec) then

        var !ppl JUSL
        var !seg ID SEGMENT PPLINE NA THROUGH  $!position VIA PLINE BOUND
        handle any
         var !seg ID SEGMENT PPLINE ANY THROUGH  $!position VIA PLINE BOUND
        endhandle
         var !z PLDIST PPLINE $!ppl THROUGH  $!position VIA PLINE BOUND
        handle any
         var !z PLDIST PPLINE ANY THROUGH  $!position VIA PLINE BOUND
        endhandle

       -- q var !seg
        var user _cdFitSpecD |$!seg| 1
       -- $p $_cdFitSpecD_UserData
  else
    !start = !item.poss.wrt(worl)
    !zPos = !!edgTypes.attribute(!item.fullType).line(!item).near(!position)
    !z = !start.distance(!zPos).string()
  endif

  -- enter calculated dist in old gadget
     !form = !!cdFitSpec
     !form.dist.val = !z.real(!!distanceFmt)

     --pin 1 at $!position

     -- update the form
     $m "%PDMSUI%/DES/STLWRK/IFITSPECD"


  !!ce = !refe


endfunction
-- End of function definition for !!posCalcZDist
