--
--
-- Description:
-- Checks whether the passed position, when mapped on the "line"
-- of the passed bounded line, lies within the start/end positions.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position
--    2   R      FINITELINE  Bounded Line
-- Return:
--   [Data Type] [Description]
--    POSITION    Position on line
--
------------------------------------------------------------------------

-- Define function
define function !!positionOnBline (!position is POSITION, !bline is FINITELINE) is POSITION

  -- Define a "line" between the start/end positions of the bounded line
  var !line CONSTRUCT LINE JOIN $!bline.startPosition TO $!bline.endPosition

  -- Map Position onto Line
  var !posStr CONSTRUCT POSITION NEAR $!position ON $!line
  !newPos  = !posStr.position()

  -- Calculate distance from S-E S-N and E-N
  var !lenStr CONSTRUCT DISTANCE $!bline.startPosition TO $!bline.endPosition
  !length  = !lenStr.real()
  var !lenStr CONSTRUCT DISTANCE $!bline.startPosition TO $!newPos
  !lengthA = !lenStr.real()
  var !lenStr CONSTRUCT DISTANCE $!bline.endPosition   TO $!newPos
  !lengthB = !lenStr.real()

  -- Check if the new position is between start & end positions
  if(!lengthA + !lengthB le !length * 1.01) then
    return !newPos
  else
    return object POSITION()
  endif

endfunction
-- End of function definition for !!positionOnBline
