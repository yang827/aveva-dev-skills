-- File:            positiononline.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST POSITION NEAR <pos> ON <line>
--
-- Author:          N.Holmes
-- Created:         Tue Apr 8 08:16:00 WAT 1997
--
--
-- Description:
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to be projected onto plane
--    2   R      VECTOR      Line definition (as vector)
-- Return:
--   [Data Type] [Description]
--    POSITION    New position
--
------------------------------------------------------------------------

-- Define function
define function !!positionOnLine (!position is POSITION, !line is VECTOR) is POSITION

  -- Map Pos onto Plane
  var !const CONSTRUCT POSITION NEAR $!position ON LINE $!line.direction THROUGH $!line.position
  return !const.position()

endfunction
-- End of function definition for !!positionOnLine
