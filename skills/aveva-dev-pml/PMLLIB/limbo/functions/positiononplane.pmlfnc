-- File:            positiononplane.pmlfnc
--   Type:          Function Definition
--   Group:         Construct3D Geometry Calculator
--     Keyword:     CONST
--   Module:        limbo
--   Replaces:      CONST POSITION NEAR <pos> ON <plane>
--
-- Author:          N.Holmes
-- Created:         Mon Mar 24 17:39:19 WAT 1997
--
--
-- Description:
-- Projects the passed position onto the plane definition.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to be projected onto plane
--    2   R      VECTOR      Plane definition (as vector)
-- Return:
--   [Data Type] [Description]
--    POSITION    New position
--
------------------------------------------------------------------------

-- Define function
define function !!positionOnPlane (!position is POSITION, !plane is VECTOR) is POSITION

  -- Map Pos onto Plane
  var !const CONSTRUCT POSITION NEAR $!position ON PLANE $!plane.direction THROUGH $!plane.position
  return !const.position()

endfunction
-- End of function definition for !!positionOnPlane
