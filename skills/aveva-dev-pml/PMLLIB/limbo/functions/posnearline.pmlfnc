-- File:            posnearline.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Tue Apr 15 18:00:55 BST 1997
--
--
-- Description:
-- Returns a position nearest the line. The position of the start and end
-- of the line are given so new appware does not have to create a line
-- using old syntax.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position near the line
--    2   R      POSITION    start of line
--    3   R      POSITION    end of line
--
-- Return:
--   [Data Type] [Description]
--    POSITION    New position near line
--
------------------------------------------------------------------------

define function !!posNearLine(!currentPos is POSITION, !startPos is POSITION, !endPos is POSITION) is POSITION

  !rtnPos = object POSITION()

  var !line   CONSTRUCT LINE JOIN $!startPos TO $!endPos
  var !newPos CONSTRUCT POSITION NEAR $!currentPos ON $!line

  !rtnPos = $!newPos
  return !rtnPos

endfunction
-- End of function definition for !!posNearLine
