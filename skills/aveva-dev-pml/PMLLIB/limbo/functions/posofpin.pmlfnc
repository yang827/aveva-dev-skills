--
--
-- Description:
-- returns the position of a pin using old syntax.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The number of the PIN
-- Return:
--   [Data Type] [Description]
--    POSITION    Position of the pin
--
------------------------------------------------------------------------

-- Define function
define function !!posOfPin(!number is REAL) is POSITION

  !position = object POSITION()

  var !ppos POS PIN$!number WRT WORLD
  !position = $!ppos

  return !position

endfunction
-- End of function definition for !!posOfPin
