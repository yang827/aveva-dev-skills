--
-- Description:
-- Display a prompt string.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Message Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!prompt(!messageCode is REAL)

  -- Check for zero message code
  if (!messageCode eq 0) then

    -- Dismiss prompt
    PROMPT dismiss

  else

    return error 1 '!!prompt() should not be called, use !!messageFile.prompt()'

  endif


endfunction
-- End of function definition for !!prompt
