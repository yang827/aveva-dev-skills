--   Module:        Common
--   Application:
--   Replaces:      NONE
--
-- Author:          P.Mooney
-- Created:         Wed Jan 29 15:37:07 GMT 1997
--
--
-- Description:
-- Q VAR the object passed to this function. I can see no way round using
-- a '$' in the evaluation of the object.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The name of the object to query
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!queryObject(!object is STRING)

  QUERY VAR $!object
  handle any
    !!alert.warning('The object "$!object" does not exist')
  endhandle

endfunction
-- End of function definition for !!queryObject
