--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!queryPlotDetail(!arg1 is REAL, !arg2 is STRING, !arg3 is REAL, !returnString is STRING)


if (!arg1 eq 1) then
   var !returnString UNITS
elseif (!arg1 eq 2) then
   var !returnString TEXTPOS DETAILPLOTS
elseif (!arg1 eq 3) then
   var !returnString PLOTDETAILDATA FILENAMES
elseif (!arg1 eq 4) then
   var !returnString PLOTDETAILDATA $!arg2 NUM
elseif (!arg1 eq 5) then
   var !returnString PLOTDETAILDATA $!arg2 ATTR $!arg3
endif

endfunction
-- End of function definition for !!queryPlotDetail
