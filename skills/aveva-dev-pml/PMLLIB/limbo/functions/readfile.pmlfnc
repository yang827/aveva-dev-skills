--
--
-- Description:
-- Reads all the contents of a file, returns records as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File to be read
--    2   RW     PROCERROR   Procedure Error return
-- Return:
--   [Data Type] [Description]
--    ARRAY       All record from file
--
------------------------------------------------------------------------

-- Define function
define function !!readFile(!filename is STRING) is ARRAY

  -- Thin layer to file.obj methods
  !sourceFile = object FILE()
  !sourceFile.file(!filename)
  return !sourceFile.readFile()

endfunction
-- End of function definition for !!readFile
