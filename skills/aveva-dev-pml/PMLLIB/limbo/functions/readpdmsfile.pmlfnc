-- Created:         Tue Feb 4 12:09:16 GMT 1997
--
--
-- Description:
-- Reads all the contents of a file. Ignores blank lines and lines
-- starting with a '#'. Returns lines as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File to be read
-- Return:
--   [Data Type] [Description]
--    ARRAY       Valid lines from the file
--
------------------------------------------------------------------------

define function !!readPdmsFile(!filename is STRING) is ARRAY

  !lines = ARRAY()
 !file = !filename

-- remove '/'
 if !file.substring(1,1).eq('/') then
  !file = !file.after('/')
 endif

  openfile "$!file" read !fileUnit

  do
    readfile $!fileUnit !line
    handle any
      break
    endhandle

    if( (!line.substring(1, 1) eq '#') or (!line.empty()) ) then
      -- DO NOTHING
    else
      !lines.append(!line)
    endif

  enddo

  closefile $!fileUnit

  return !lines

endfunction
-- End of function definition for !!readPdmsFile
