--
--
-- Description:
-- Function to run a macro file from within a function.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Full macro path and name to run
--    2   R      STRING      Argument string to be supplied to macro.
--    3   RW     PROCERROR   Returned error object.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!runMacro(!macro is STRING, !arguments is STRING)

  -- Run the macro
  $M "$!macro" $!<arguments>

endfunction
-- End of function definition for !!runMacro
