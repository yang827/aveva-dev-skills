--
-- Description:
-- function to restrict picking to owning sctn/stwall/wall/gensec
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!stlRestrictPick(!whichPixmap is STRING)

  -- old syntax to determine current element stored on the form
    !form = !!cdFitSpec
    !item = !form.ceName.val.dbRef()
     handle any
        var user _cdFitSpec SEL 1
        !user = '$_cdFitSpec_UserData'
        !item = !user.dbRef()
        var user _cdFitSpec SEL 2
     endhandle

  ----------------------------------------------------------

     -- find out what the owner is (sctn/gensec/wall/stwall)

        !sctn = !!penGetOwningType(!item)

        -- kick off event too only choose owning elements plines

           if(!whichPixmap.upcase().eq('PLINE')) then
              !!edgPickPline(!sctn)
           else
              !!stlCalcZDist()
           endif

endfunction
-- End of function definition for !!stlRestrictPick
