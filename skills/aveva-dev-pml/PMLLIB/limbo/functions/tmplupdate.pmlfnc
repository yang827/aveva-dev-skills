--   Group:         Limbo area for old style syntax
--     Keyword:     LIMBO
--   Module:        limbo
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Feb 14 09:36:54 GMT 1997
--
--
-- Description:
-- Function to update the tmpl to original assuming the ORRF is still set
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tmplUpdate()

-- Initialise Variables

   !lockFlag = FALSE

-- at current element get tmpl from the list

   !elem = REFE
   if(!!chkLock(!elem)) then
      !lockFlag = TRUE
         !result = !!alert.confirm(|The  item or one of its offspring is lock, OK to EVALUATE rules? This will reset the lock after evaluation.|)
     if(!result eq 'NO' ) then
        return
     endif
   endif

-- goto the tmpl and update

   !tmpl = !!collectAllFor(|TMPL|,||,!elem)

   if(undefined(!tmpl[1])) then
      return
   endif

do !i indices !tmpl
   !!ce = !tmpl[$!i]
       $!elem
       UNLOCK ALL
       !!ce = !tmpl[$!i]
        !orrf = ORRF
        if(unset(!orrf)) then
           !unused = !!alert.error(|Template is not referenced to original|)
           return
        endif
        !name = !orrf.name      $* need this line (for now)
        DELETE TMPL MEM
        COPY  REXE TMPL $!name
       !!ce = !tmpl[$!i]
      if(!lockFlag) then
          LOCK ALL
      endif
enddo
-- return to original pos in hierarchy

   !!ce = !elem

endfunction
-- End of function definition for !!tmplUpdate
