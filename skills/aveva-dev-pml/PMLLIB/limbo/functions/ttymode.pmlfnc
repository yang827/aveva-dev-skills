--
-- Description:
-- Function to determine if a module has been started in TTY mode or not.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE is module is running in TTY mode
--
------------------------------------------------------------------------

-- Define function
define function !!ttyMode() is BOOLEAN

  !ttyMode = ISTTY

  -- Print message if mode is TTY
  if (!ttyMode) then

    $P Non Graphics Device (Appware will not be loaded).

  endif

  -- Return TTY mode
  return !ttyMode

endfunction
-- End of function definition for !!ttyMode
