--
--
-- Description:
-- Converts the passed vector to a  line string format LINE <dir> THROUGH <pos>
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VECTOR      Vector to be used as a line
-- Return:
--   [Data Type] [Description]
--    STRING      Line
--
------------------------------------------------------------------------

-- Define function
define function !!vectorToLine (!vector is VECTOR) is STRING

  -- Initialise Variables
  return 'line ' & !vector.direction & ' through ' & !vector.position

endfunction
-- End of function definition for !!vectorToLine
