--   Group:         General Application
--     Keyword:     View Volume
--   Module:        DRAFT
--   Replaces:
--
-- Author:          S.Robinson
-- Created:         Thu Jun 12 09:15:26 1997
--
--
-- Description:
-- function to get 3d volume limits for given DRAFT VIEW
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       View
--    2   RW     POSITION    From position for view volume
--    3   RW     POSITION    To Position for view volume
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Success of getting view volume
--
------------------------------------------------------------------------

-- Define function
define function !!viewVolume(!view is DBREF, !from is POSITION, !to is POSITION) is BOOLEAN

  -- define local variables
  !limits  = ARRAY() $* limits extracted from :CDLIMITS
  !viewVol = ARRAY() $* storage for View's VVOL if :CDLIMITS not set
  !sFrom   = STRING()
  !sTo     = STRING()

  -- attempt to get view volume from :CDLIMITS
  !limits = SPLIT(!view.:CDLIMITS)
  handle any

    -- get limits from view volume
    !viewVol = !view.vVol
    -- set RW return arguments
    !from = !viewVol.from(1,3)
    !to   = !viewVol.from(4,3)

  elsehandle none

    -- validate the :CDLIMITS
    if ('!limits[1]' eq 'unset') then
      -- get view volume
      !viewVol = !view.vVol
      -- set RW return arguments
      !from = !viewVol.from(1,3)
      !to   = !viewVol.from(4,3)
    else
      -- set RW return arguments
      !sFrom = (!limits[2] & ' ' & !limits[3]  & ' ' & !limits[4]  & ' ' & !limits[5]  & ' ' & !limits[6]  & ' ' & !limits[7])
      !sTo   = (!limits[9] & ' ' & !limits[10] & ' ' & !limits[11] & ' ' & !limits[12] & ' ' & !limits[13] & ' ' & !limits[14])
      !from = !sFrom.position()
      !to   = !sTo.position()
    endif

  endhandle

  -- set return
  return TRUE

endfunction
-- End of function definition for !!viewVolume
