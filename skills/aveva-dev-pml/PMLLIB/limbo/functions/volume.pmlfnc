--
--
-- Description:
-- Returns volume of passed item.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item volume is to be returned from
-- Return:
--   [Data Type] [Description]
--    VOLUME      Volume of passed item (wrt World)
--
------------------------------------------------------------------------

-- Define function
define function !!volume (!item is DBREF) is VOLUME

  -- Get volume of current element
  var !volString VOL $!item

  !volume      = object VOLUME()
  !volume.from = !volString.before('to').position()
  !volume.to   = !volString.after('to').position()
  return !volume

endfunction
-- End of function definition for !!volume
