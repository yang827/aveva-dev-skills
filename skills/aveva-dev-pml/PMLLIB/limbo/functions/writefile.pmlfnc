--
--
-- Description:
-- Reads all the contents of a file, returns records as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File to be Written to
--    2   R      STRING      Mode of writing to file, NEW, OVERWRITE, APPEND
--                           FORCE overwrites without question.
--    3   R      ARRAY       Array to be written to file
--    4   RW     PROCERROR   Procedure Error return
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!writeFile(!filename is STRING, !mode is STRING, !records is ARRAY)

  -- Thin layer to file.obj methods
  !targetFile = object FILE()
  !targetFile.file(!filename)
  !targetFile.writeFile(!mode, !records)

endfunction
-- End of function definition for !!writeFile
