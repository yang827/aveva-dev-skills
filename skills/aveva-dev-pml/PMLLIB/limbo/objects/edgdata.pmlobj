-- Description:
-- object to extract data from GEOMDATA form
--
------------------------------------------------------------------------

-- Define object
define object EDGDATA
-- position of pick
   member .pos is POSITION
-- direction of linear item picked
   member .dir is DIRECTION
-- vector line of pick
   member .vec is VECTOR
-- item picked
   member .item is DBREF
endobject
-- End of object definition for EDGDATA
