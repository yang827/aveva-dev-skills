--
------------------------------------------------------------------------

-- Define form
setup form !!mdradim


  !!mdradim.formTitle     = 'Dim'
  !!mdradim.iconTitle     = 'Dim'

button .LIN |Linear...    | at xmin ymax call |!!dimcreate(2)|
button .RAD |Radius...    | at xmin ymax+0.2 call |!!dimcreate(8)|
button .DIA |Diameter...  | at xmin ymax+0.2 call |!!dimcreate(11)|
button .ANG |Angle...     | at xmin ymax+0.2 call |!!dimcreate(7)|

-- End of form definition
exit
