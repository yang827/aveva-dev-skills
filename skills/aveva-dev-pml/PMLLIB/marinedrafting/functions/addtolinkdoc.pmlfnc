--     Keyword:     ADD DRAWING SHEET LINK DOCUMENTS
--   Module:
--   Replaces:
--
-- Author:          S. Olsson
-- Created:         June 18 2008
--
--
-- Description:
-- This script will add a reference to a drwg/or sheet (CE) to the link documents
-- hierarchy.
--
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

import 'LinksAddin'
handle( 1000, 0 )
-- This error could mean that module has already been imported,
-- ignore this error and continue.
endhandle

-- Define function
define function !!addToLinkDoc()

using namespace 'AVEVA.pdms.Linksaddin'
using namespace 'Aveva.pdms.Linksaddin.DesignElementDialog'

!paddEle = !!ce

if( !paddEle.type.neq('DRWG') and !paddEle.type.neq('SHEE') ) then
   !!alert.warning('Not a SHEE or DRWG element')
else
   !links  = object PMLENTRY()
   !ref    = ''
   !lnName = ''
   !lnDesc = ''
   !isOK = !links.selectElement( 1, true, 'Select Link Folder', !ref, !lnName, !lnDesc )

   if !isOK then
      !folderRef  = object DBREF(!ref)
      if( !folderRef.type.eq('LNFOLD') or !folderRef.type.eq('LINKWL') ) then
         !oldCE = !!ce
         !!ce = !folderRef
         if !lnName.match('/').neq(1) then
            !lnName = '/' & !lnName
         endif		
         NEW LNDESC
         NAME $!lnName
         LNKREF $!paddEle
         DESCR  '$!lnDesc'
         if( !oldCE.badRef().not() ) then
            !!ce = !oldCE
         endif
      endif
   endif
endif

endfunction
-- End of function definition for !!addToLinkDoc
