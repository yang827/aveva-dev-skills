--
--
-- Description:
-- This will load the defaults needed for autolabelling if not done before and then start the autolabelling
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define function !!autolabel()

  if(defined(!!draDfltsInMDra)) then
    if(not !!draDfltsInMDra.autolabellingIsLoaded) then
      !!draDfltsInMDra.loadAutolabelling()
    endif
  else
    !!comdefineglobal(object DRADFLTSINMDRA())
    !!draDfltsInMDra.loadAutolabelling()
  endif

  show !!cdrmtagrule

endfunction
