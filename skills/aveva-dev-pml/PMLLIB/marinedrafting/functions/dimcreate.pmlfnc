-- File:            dimcreate.pmlfnc
--   Type:          Function Definition
--   Group:         AVEVA Marine
--     Keyword:     DIM
--   Module:
--   Replaces:
--
-- Author:          S. Palmqvist
-- Created:         Feb 10 2012
--
--
-- Description:
-- This function will show the interface for creating the type of dimension
-- described by argument act.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL         Number for the dimension type
--
--              Linear, projected on line:
--
--              = 2   2-D linear
--              = 12  3-D linear
--              = 16  3-D linear axis parallel
--
--              Other measures:
--
--              = 7   Angle between two lines
--              = 8   Radius of arc
--              = 9   Curve
--              = 10  Area
--              = 11  Diameter of arc
--              = 13  3D Coordinate
--              = 14  3D Distance to plane, leader presentation
--              = 15  3D Measure between two points
--              = 17  3D WCOG
--              = 18  3D Curve
--              = 19  3D Angle
--              = 20  3D Distance to plane, box presentation
--              = 21  3-D Ruler
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

import 'marapi'
handle (1000, 0)
endhandle

define function !!dimcreate(!act is REAL)
  using namespace 'AVEVA.Marine.UI'
  !mui = object MARUI()
  !mui.dimcreate(!act)
endfunction
