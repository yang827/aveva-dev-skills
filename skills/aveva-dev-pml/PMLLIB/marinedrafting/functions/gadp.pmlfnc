--
--
-- Description:
-- checks if the defaults for general ADP have been loaded or else loads them and starts GADP
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define function !!gadp()
--check if the defaults have been loaded or else load them

  if(defined(!!draDfltsInMDra)) then
    if(not !!draDfltsInMDra.gadpIsLoaded) then
      !!draDfltsInMDra.loadGadp()
    endif
  else
    !!comdefineglobal(object DRADFLTSINMDRA())
    !!draDfltsInMDra.loadGadp()
  endif

  $M "%PDMSUI%/dra/adpgdp/XGDPDRWG" CREATE

endfunction
