--
--
-- Description:
-- This function will show the GADP Equipment Centres toolbar
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define function !!gadpeqtool()

  if(defined(!!draDfltsInMDra)) then
    if(not !!draDfltsInMDra.gadpIsLoaded) then
      !!draDfltsInMDra.loadGadp()
    endif
  else
    !!comdefineglobal(object DRADFLTSINMDRA())
    !!draDfltsInMDra.loadGadp()
  endif

  SHOW !!cdrGDPEQTOOL
	
endfunction
