--
-- Description:
-- This function will show the GADP label toolbar
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define function !!gadplabtool()

  if(defined(!!draDfltsInMDra)) then
    if(not !!draDfltsInMDra.gadpIsLoaded) then
      !!draDfltsInMDra.loadGadp()
    endif
  else
    !!comdefineglobal(object DRADFLTSINMDRA())
    !!draDfltsInMDra.loadGadp()
  endif

  $M "%PDMSUI%/dra/symb/INITSHOW" _cdrgdplbtool
	
endfunction
