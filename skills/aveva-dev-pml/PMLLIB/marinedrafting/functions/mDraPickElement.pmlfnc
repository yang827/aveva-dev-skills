-- Created:         25 Jan 2006
--
--
-- Description:
-- Load 3D autocolours for 3D viewing
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!mDraPickElement()

  import 'marapi'
    handle(1000,0)
      -- This error means that marapi has already been imported,
      -- ignore this error and continue.
    endhandle

  -- MarUi
  using namespace 'AVEVA.Marine.UI'

  -- MarDrafting
  using namespace 'AVEVA.Marine.Drafting'
  using namespace 'AVEVA.Marine.Geometry'

  -- Initialise variables
  !mUi    = object MARUI()
  !mDraft = object MARDRAFTING()
  !point  = object MARPOINTPLANAR()

  -- Subview handle
  !handle = object MarElementHandle()

  -- Get point from picture
  !res = !mUi.PointPlanarReqPML('Indicate component',!point)

  handle(1000,0)
    !!alert.error(!!error.text)
    return
  endhandle

  if ( !res eq 253 ) then
    return
  endif

  -- Component identify
  !handle = !mDraft.ComponentIdentify(!point)

  handle(1000,0)
    !!alert.error('Failed to identify component')
    return
  endhandle

  -- ElementDbRef get
  !strDbRef = !mDraft.ElementDbrefGet(!handle)

  handle(1000,0)
    !!alert.error('Failed to get Design database reference for the component')
    return
  endhandle

  -- Access the element
  !!ce = !strDbRef.dbref()

  -- Show the attributes form
  import 'PDMSCOMMANDS'
  handle(1000,0)
    -- This error means that PDMSCOMMANDS has already been imported,
    -- ignore this error and continue.
  endhandle
  using namespace 'Aveva.Pdms.Presentation.PDMSCommands'
  !cm = object PMLNetCommandManager()
  !cm.executeCommand('AVEVA.Attributes.Show')

  handle(1000,0)
    !!alert.error(!!error.text)
    return
  endhandle


endfunction
-- End of function !!mDraPickElement
