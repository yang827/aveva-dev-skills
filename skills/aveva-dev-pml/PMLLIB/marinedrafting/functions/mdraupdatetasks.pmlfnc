--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Run all tasks for the current drawing sheet or view
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        The SHEE or VIEW to be updated
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!mDraUpdateTasks(!elementRefe is DBREF)

  -- Initiate a dummy log file
  !!assyLog = object ASSYLOG()

  -- Test for a shee or a view
  if (!elementRefe.type.upcase().eq('SHEE')) then

    -- Process all views
    VAR !allViews COLL ALL VIEW FOR $!elementRefe

    !getDbref = object BLOCK('!allViews[!evalIndex].dbref()')
    !views    = !allViews.evaluate(!getDbref)

  elseif (!elementRefe.type.upcase().eq('VIEW')) then

    -- Process just this one
    !views[1] = !elementRefe

  else

    -- Nothing to process
    return

  endif

  -- Process all views
  do !viewRefe val !views

    -- Access the VIEW
    !!ce = !viewRefe

    -- Get all tasks for this view
    VAR !allViewTasks COLL ALL TASK WI SPPURP EQ 'VTASK' FOR CE

    -- Execute all found tasks
    do !task val !allViewTasks

      -- Initialise variables
      !taskRefe = !task.dbref()

      -- Do not run the orientation workaround task
      skip if (!taskRefe.pmlFunction.match('assyOriView').neq(0))

      -- Build the task object
      !taskObj = object ASSYTASK(!taskRefe)

      -- Execute the task
      !taskObj.execute()

    enddo

  enddo

  -- Delete the dummy log
  VAR !!assyLog DELETE

endfunction
-- End of function !!assyUpdateTasks
