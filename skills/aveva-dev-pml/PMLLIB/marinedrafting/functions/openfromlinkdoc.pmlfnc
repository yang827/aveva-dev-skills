--
--
-- Description:
-- This script will let the user open a drawing from the link documents
-- hierarchy
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

import 'LinksAddin'
handle( 1000, 0 )
-- This error means that module has already been imported,
-- ignore this error and continue.
endhandle

-- Define function
define function !!openFromLinkDoc( )

using namespace 'AVEVA.pdms.LinksAddin'
using namespace 'Aveva.pdms.LinksAddin.DesignElementDialog'

!links   = object PMLENTRY()
!refStr  = object STRING()
!lnName  = object STRING()
!lnDesc  = object STRING()
!paddEle = object DBREF()
!isOK = !links.selectElement( 2, true, 'Select Drawing', !refStr, !lnName, !lnDesc )

if !isOK then
   !ref     = object DBREF(!refStr) $* an LNDESC element
   !paddEle = !ref.lnkref           $* referenced DRWG or SHEE
   !eleType = !paddEle.type

   if ( !eleType.eq('DRWG') or !eleType.eq('SHEE') ) then
      !!opensheet( !paddEle )
   endif
endif

endfunction
-- End of function definition for !!openFromLinkDoc
