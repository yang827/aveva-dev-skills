--
-- File:            openmarinesheet.pmlfnc
--   Type:          Function Definition
--   Group:         AVEVA Marine
--     Keyword:     SHEET
--   Module:
--   Replaces:
--
-- Author:          S. Olsson
-- Created:         May 22 2007
--
--
-- Description:
-- This will open a sheet (or first sheet in a DWRG element) on the Marine Drafting
-- canvas.
--
-- The script only works in an application where Marine Drafting vitesse
-- has been enabled, e.g. Marine Drafting or Hull Design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      URL-String according to the format for references to drawings in LNDESC elements.
--                           If empty then the sheet/drawing can be given as a dbref (see next argument).
--                           For a sheet or drawing stored in PADD the URL looks like this:
--                           dabref://=16387/1962
--                           For a drawing not stored in PADD the will look something like this:
--                           tbdra://myDrawing?TYPE=1
--    1   R      DBREF       The dbref for the sheet or drawing element. This parameter will only be considered
--                           URI is empty.
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

import 'marapi'
handle( 1000, 0 )
-- This error means that the module has already been imported,
-- ignore this error and continue.
endhandle

-- Define function
define function !!openmarinesheet(!url is STRING, !sheet is DBREF )

using namespace 'AVEVA.Marine.Drafting'

!drafting = object MARDRAFTING()
!drawingName  = ''
!drawingType  = 1
!answer   = 'YES'
!drawingElement   = !sheet

--Write 'openmarinesheet start...'

!ok = 'YES'
if (!drafting.dwgCurrent()) then
--
-- Ask the user if he wants to save it
--
   if (!drafting.dwgIsModified()) then
      !answer = !!alert.question( 'Do you want to save the current drawing?' )
   else
      !answer = 'NO'
   endif
   if ( !answer.eq('YES') ) then
--
--    Save the current drawing
--
     !drafting.dwgSave()
     handle any
      !!alert.confirm(!!error.text)
     endhandle
   endif
   if ( !answer.eq('CANCEL') ) then
      !ok = 'NO'
   else
--
--    Close the current drawing
--
      !drafting.dwgClose()
   endif
endif

if !ok.eq('YES') then
   if( !url.empty().not() ) then
--
--    Handle the case when the sheet/drawing is given by a url in 'LNDESC-format'
--
      !dbRefURIPrefix = 'dabref://'
      if ( !url.match(!dbRefURIPrefix).gt(0) ) then $* isDbRef
--
--       The reference is to a DABACON element (it should be a DRWG or SHEE in PADD)
--
         !drawingElement  = object DBREF( !url.after(!dbRefURIPrefix) )
         !drawingName = ''
      else
--
--       The reference is to a drawing not stored in PADD (e.g. production drawing)
--
         !tbDraURIPrefix = 'tbdra://'
         if ( !url.match(!tbDraURIPrefix).gt(0) ) then $* isTbDra
            !tmpStr = '?TYPE='
            if( !url.match(!tmpStr).gt(0) ) then $* TYPE given explicitly
              !drawingType = !url.after(!tmpStr).real()
              handle (2,441) $* On error will default to 1
              endhandle
              !drawingName = !url.after(!tbDraURIPrefix).before(!tmpStr)
            else $* no TYPE given - default value = 1, the drawing name is the whole part after the prefix
              !drawingName = !url.after(!tbDraURIPrefix)
            endif
         endif
      endif
   endif

   if( !drawingName.empty().not() ) then
--      Write 'Open by name'
      if ( !drawingType.lt(1) ) then
         !drawingType = 1
      endif
      !drafting.dwgOpen(!drawingName, !drawingType)
       handle any
         !!alert.confirm(!!error.text)
       endhandle
   elseif( !drawingElement.badRef().not() ) then
--      Write 'Open by dbref'
      !list  = 'SHEE DRWG'
      !validEle = !list.split()
      !selectedDbRef = !!dtbOwnerOfTypes(!drawingElement, !validEle)
      if(!selectedDbRef.unset()) then
         return
      else
         var !sheets collect all (SHEE) for $!selectedDbRef
         do !sh values !sheets
            !acpict = !sh.dbref().acpict
            if (!acpict.neq('OFF') and !acpict.neq('ON')) then
               !!alert.message('Cannot display $!selectedDbRef.name - it can only be accessed using AVEVA E3D Draw')
               return
            endif
         enddo
      endif

      !drawingName = !drawingElement.string()
      !eleType = !drawingElement.type

      if ( !eleType.eq('DRWG') ) then
--
--       Get the first sheet in the drawing
--
         !sheeEle = SHEE 1 of $!drawingElement
         handle (2,113)
           Write 'No SHEE found in the DRWG'
           !drawingName = ''
         elsehandle None
           !drawingName = !sheeEle.string()
--           Write 'drawingName = $!drawingName'
         endhandle
      elseif ( !eleType.eq('SHEE').not() ) then
         Write 'No SHEE found in the DRWG'
      endif

      if ( not !drawingName.empty() ) then
         !drafting.dwgOpen(!drawingName, !drawingType )
         handle any
           !!alert.confirm(!!error.text)
         endhandle
      endif
   endif
endif

--Write 'openmarinesheet end...'
endfunction
-- End of function definition for !!openmarinesheet
