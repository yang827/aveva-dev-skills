--   Type:          Function Definition
--   Group:         AVEVA Marine
--     Keyword:     SHEET
--   Module:
--   Replaces:
--
-- Author:          S. Palmqvist
-- Created:         April 19 2012
--
--
-- Description:
-- This will open a sheet (or first sheet in a DWRG element) on the Marine Drafting
-- canvas if it is not already open.
--
-- The script only works in an application where Marine Drafting vitesse
-- has been enabled, e.g. Marine Drafting or Hull Design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The dbref for the sheet or drawing element. This parameter will only be considered
--                           URI is empty.
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

import 'marapi'
handle( 1000, 0 )
-- This error means that the module has already been imported,
-- ignore this error and continue.
endhandle

-- Define function
define function !!openmarinesheetadp(!sheet is DBREF )

  !drawingElement = !sheet

  !drafting = object MARDRAFTING()
  if(match(!drafting.dwgNameGet(), '$!drawingElement') eq 0) then
     !!openmarinesheet('', !drawingElement )
  endif

endfunction
