--     Keyword:     SHEET
--   Module:
--   Replaces:
--
-- Author:          M. Sandqvist
-- Created:         Oct 16 2007
--
--
-- Description:
-- This will open a sheet (or first sheet in a DWRG element)
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The dbref for the sheet or drawing element.
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

-- Define function
define function !!opensheet(!paddEle is DBREF )

  if !paddEle.type eq('DRWG') or !paddEle.type eq('SHEE') then
    !module = !!module()
    if ( !module.product eq('Hull') or !module.product eq('Hull & Outfitting') ) then
      !!openmarinesheet('', !paddEle)
    elseif !module.appname.eq('OutfittingDraft').or(!module.appname.eq('Draft')) then
      !!ce = !paddEle
      !!draAddTo2DView()
    else
      !!alert.message('Do not know how to open')
    endif
  else
    !!alert.message('Do not know how to open this type, please select DRWG or SHEE')
  endif

endfunction
-- End of function definition for !!opensheet
