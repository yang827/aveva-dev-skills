--
--
-- Description:
--    Calculate the dbnumber from a ref in string representation.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      STRING        String representation of a ref
-- Return:
--   [REAL] [The database number as a real]
--
------------------------------------------------------------------------
define function !!refstringtodbno(!ref1 is STRING) is REAL

  return !!reftodbno(real(part(part(!ref1, -1, '='), 1, '/')))

endfunction
-- End of function definition for !!refstringtodbno
