--
--
-- Description:
--    Calculate the dbnumber the first part of a reference number
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      REAL        First int of a reference number
-- Return:
--   [REAL] [The database number as a real]
--
------------------------------------------------------------------------
define function !!reftodbno(!ref1 is REAL) is REAL

  !res = REAL()
  !res = (int(!ref1 / (Pow(2,26) - 1)) * 8192) + (!ref1 - (int(!ref1 / 8192) * 8192))
  return !res

endfunction
-- End of function definition for !!reftodbno
