-- File:            setmarptype.pmlfnc
--   Type:          Function Definition
--   Group:         AVEVA Marine
--     Keyword:     MARPTYPE
--   Module:
--   Replaces:
--
-- Author:          A. Grobelny
-- Created:         May 31, 2012
--
--
-- Description:
-- To set the type of a drawing when it's created.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Sheet element
--    2   R      REAL       Type of a drawing to be set
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

-- Define function
define function !!setmarptype(!sheet is DBREF, !ptype is REAL )
   --check arguments
   if !sheet.type NE 'SHEE' then
      return
   endif
   -- Get the current brand
   !moduleObject = object MODULE()
   if !moduleObject.appkey.eq('mardra') then
      -- Set the marine drawing type
      -- The MARPTYPE attribute can only be modified using the PROTECTION OFF syntax
      PROTECTION OFF
      -- Set the drawing type to allow it to be filtered by the 'Drawing Type = Assembly Drawings' in the hull form 'Open Drawing'
      !sheet.marptype = !ptype
      handle (143,91)
         --Report problem with database compatibility.
      endhandle
      -- Switch PROTECTION back ON
      PROTECTION ON
  endif
endfunction
-- End of function definition for !!setmarptype
