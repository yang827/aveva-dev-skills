-- Description:
-- Customising Model Info dialog
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

-- Define function
define function !!trigdraftmodelinfopre() is STRING

-- Get Model Info object
	!modelInfo = object ModelInfo()

-- Get db reference as object
	!dbrefstring = !modelInfo.DBREFGET()
	!dbRef = object DBREF(!dbrefstring)
  
-- Add user defined properties 
	!dbRefOwner = !dbRef.owner
	if (!dbRefOwner.type eq 'EQUI') then
		!modelInfo.ADDPROPERTY('DB Reference', !dbrefstring)
		!modelInfo.ADDPROPERTY('Description', !dbRefOwner.descr)
		!modelInfo.ADDPROPERTY('Function', !dbRefOwner.func)
		!modelInfo.ADDPROPERTY('Purpose', !dbRefOwner.purp)
		!pos = !dbRefOwner.pos
		!modelInfo.ADDPROPERTY('Position', 'X $!pos.east Y $!pos.north Z $!pos.up')
	endif

	!dbRefOwner = !dbRefOwner.owner
	if (!dbRefOwner.type eq 'PIPE') then
		!modelInfo.ADDPROPERTY('DB Reference', !dbrefstring)
		!modelInfo.ADDPROPERTY('Description', !dbRefOwner.descr)
		!modelInfo.ADDPROPERTY('Function', !dbRefOwner.func)
		!modelInfo.ADDPROPERTY('Purpose', !dbRefOwner.purp)
		!modelInfo.ADDPROPERTY('Bore', '$!dbRefOwner.bore')
	elseif (!dbRefOwner.type eq 'STRU') then
		!modelInfo.ADDPROPERTY('DB Reference', !dbrefstring)
		!modelInfo.ADDPROPERTY('Description', !dbRefOwner.descr)
		!modelInfo.ADDPROPERTY('Function', !dbRefOwner.func)
		!modelInfo.ADDPROPERTY('Purpose', !dbRefOwner.purp)
		!pos = !dbRefOwner.pos
		!modelInfo.ADDPROPERTY('Position', 'X $!pos.east Y $!pos.north Z $!pos.up')
	elseif (!dbRefOwner.type eq 'HVAC') then	
		!modelInfo.ADDPROPERTY('DB Reference', !dbrefstring)
		!modelInfo.ADDPROPERTY('Description', !dbRefOwner.descr)
		!modelInfo.ADDPROPERTY('Function', !dbRefOwner.func)
		!modelInfo.ADDPROPERTY('Purpose', !dbRefOwner.purp)
		
	endif
  
	return 'OK'

endfunction
-- End of function definition for !!trigdraftmodelinfopre
