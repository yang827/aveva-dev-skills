--
-- File:            DraDfltsInMDra.pmlobj
--   Type:          Object Definition
--   Group:         drafting
--     Keyword:     defaults
--   Module:        MDRA
--
-- Author:          Staffan Palmqvist
-- Created:         20/12/2011
--
-- Description:
-- This object is for loading draft defaults that is not loaded in Marine Drafting, loads defaults for autotagging and gadp
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  draDfltsInMDra()                 -
--  globalInstance()                 -                   Creates a global instance of itself
--  loadAutolabelling()              -                   Loads the defaults needed for autolabelling
--  loadGadp()                       -                   Loads the defaults needed for general automatic drawing production
--


------------------------------------------------------------------------

define object DRADFLTSINMDRA
  member .autolabellingIsLoaded is BOOLEAN
  member .gadpIsLoaded is BOOLEAN
endobject

------------------------------------------------------------------------

define method .draDfltsInMDra()

  !this.gadpIsLoaded = FALSE
  !this.autolabellingIsLoaded = FALSE

endmethod

------------------------------------------------------------------------

define method .globalInstance()
  !!draDfltsInMDra = !this
endmethod

------------------------------------------------------------------------

define method .loadAutolabelling()

!ce = !!ce
	
	if(!this.autolabellingIsLoaded.not()) then
		if(!this.gadpIsLoaded) then
			$M "%PDMSUI%/dra/gen/FSELTAGTM"
		
			$M "%PDMSUI%/dra/symb/INIT"
			--$M "%PDMSUI%/dra/symb/FGLTXATT"
			--$M "%PDMSUI%/dra/symb/FGLLFATT"
			$M "%PDMSUI%/dra/gen/FLATAGATT"

			$M "%PDMSUI%/dra/gen/FMTAGRULE"
		else

			$S CALLDRS = $M "%PDMSUI%/DRA/SYMB/$S1"				$* set up the synonym for PML1 forms that uses it

			!!comDefineGlobal(object ADMFONTMANAGER())
			!!comDefineGlobal(object DRACOLSTYLEHANDLER())		
	
			$M "%PDMSDFLTS%/DRA-SETUP"							$* loads Draft specific variables
		
			$M "%PDMSUI%/dra/gen/FLAYER"
			$M "%PDMSUI%/dra/gen/FLAYPURP"
			$M "%PDMSUI%/dra/gen/FLAYCREATE"
			
			if ( undefined(!!cdrdflts)) then
				$M "%PDMSUI%/dra/gen/FPRPDFLTS"
				$M "%PDMSUI%/dra/gen/FDFLTSHEET"
				$M "%PDMSUI%/dra/gen/FDFLTSNAME"
				$M "%PDMSUI%/dra/gen/FERRDISP"
			
				$M "%PDMSUI%/dra/gen/FDFLTS"

				var user _CDRDFLTS |$!!dfltsfile|
				
				$M "%PDMSUI%/dra/gen/FUDFLTS"
				
				$M "%PDMSUI%/dra/gen/UDFLTSLOAD" OLDFILE NOPROMPT
			endif
			
			$M "%PDMSUI%/dra/gen/FSELTAGTM"
			
			$M "%PDMSUI%/dra/CLIB/FINTTEXT"
			$M "%PDMSUI%/dra/symb/INIT"
			--$M "%PDMSUI%/dra/symb/FGLTXATT"
			--$M "%PDMSUI%/dra/symb/FGLLFATT"
			$M "%PDMSUI%/dra/gen/FLATAGATT"

			$M "%PDMSUI%/dra/gen/FMTAGRULE"						$* loads autolabelling form
	endif
	
	!this.autolabellingIsLoaded = TRUE
endif

!!ce = !ce

endmethod

------------------------------------------------------------------------

define method .loadGadp()
	
!ce = !!ce
	
	if(!this.gadpIsLoaded.not()) then

		if(!this.autolabellingIsLoaded) then

			!!coords = object COORDSTRANSFER()
			!!comDefineGlobal(object DRABACKHANDLER())
			!!appreadappdefns('MDRA')
			!!appcntrl.mainform = !!appMDraMain
			!!appxload('MDRA','ADPCORE',false)

			$M "%PDMSUI%/dra/clib/ICONS"
			$M "%PDMSUI%/dra/clib/FFILELIST"
			$M "%PDMSUI%/dra/adpcore/INIT"
			$M "%PDMSUI%/dra/adpgdp/INIT"
			$M "%PDMSUI%/dra/symb/INIT"
			--$M "%PDMSUI%/dra/symb/FSYLALIB"
			$M "%PDMSUI%/dra/clib/DGLOBALS"
			$M "%PDMSUI%/dra/gen/FDRLMOD"

		else

			!!coords = object COORDSTRANSFER()
			!!comDefineGlobal(object DRACOLSTYLEHANDLER())
			!!comDefineGlobal(object ADMFONTMANAGER())
			!!comDefineGlobal(object DRABACKHANDLER())
			
		
			$M "%PDMSDFLTS%/DRA-SETUP"

			$M "%PDMSUI%/dra/gen/FLAYER"
			$M "%PDMSUI%/dra/gen/FLAYPURP"
			$M "%PDMSUI%/dra/gen/FLAYCREATE"
			$M "%PDMSUI%/dra/gen/FDRLMOD"
			
			if ( undefined(!!cdrdflts)) then
				$M "%PDMSUI%/dra/gen/FPRPDFLTS"
				$M "%PDMSUI%/dra/gen/FDFLTSHEET"
				$M "%PDMSUI%/dra/gen/FDFLTSNAME"
				$M "%PDMSUI%/dra/gen/FERRDISP"
				$M "%PDMSUI%/dra/gen/FDFLTS"
				
				var user _CDRDFLTS |$!!dfltsfile|
				
				$M "%PDMSUI%/dra/gen/FUDFLTS"

				$M "%PDMSUI%/dra/gen/UDFLTSLOAD" OLDFILE NOPROMPT
			endif

			!!appreadappdefns('MDRA')
			!!appcntrl.mainform = !!appMDraMain
			!!appxload('MDRA','ADPCORE',false)

			$M "%PDMSUI%/dra/clib/ICONS"
			$M "%PDMSUI%/dra/clib/FFILELIST"
			$M "%PDMSUI%/dra/adpcore/INIT"
			$M "%PDMSUI%/dra/adpgdp/INIT"
			$M "%PDMSUI%/dra/symb/INIT"
			--$M "%PDMSUI%/dra/symb/FSYLALIB"
			--$M "%PDMSUI%/dra/symb/FLABEL"
			$M "%PDMSUI%/dra/clib/DGLOBALS"
			
			$M "%PDMSUI%/dra/clib/FINTTEXT"

		endif

		!this.gadpIsLoaded = TRUE

	endif

!!ce = !ce

endmethod

------------------------------------------------------------------------
