--
--  Description:     Symbolic label symbol selection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  closeCallback()                  -                   Action on symbol selection form closed
--  getSelectedSymbol()              STRING              Callback invoked on symbol selection form closed event
--  mdselectsymbol()                 -
--  mdselectsymbol(STRING)           -
--  setDefaultSymbol(STRING)         -                   Default label symbol name
--  showSymbolLibrary()              -                   Show symbol selection form
--


define object MDSELECTSYMBOL
    member .defaultSymbol is STRING
    member .slab is STRING
endobject

-- Constructor
define method .mdselectsymbol()
    !this.slab = ''
    !this.defaultSymbol = ''
endmethod

-- Constructor
define method .mdselectsymbol(!symbol is STRING)
    !this.slab = ''
    !this.setDefaultSymbol( !symbol )
endmethod

------------------------------------------------------------------------
--
-- Method:      .setDefaultSymbol()
--
-- Description: Default label symbol name
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   !symbol         STRING        Label symbol template name
-- Return:
--
------------------------------------------------------------------------

define method .setDefaultSymbol(!symbol is STRING)
  !this.defaultSymbol = !symbol
  if( !symbol NE '' ) then
    $!symbol
    LIBY
    handle any
      return
    endhandle
    if( set(name) ) then
      !this.slab = name
    endif
  endif
endmethod


------------------------------------------------------------------------
--
-- Method:      .showSymbolLibrary()
--
-- Description: Display symbol selection form
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .showSymbolLibrary()
  if (undefined(!!cdrudflts) or unset(!!cdrudflts)) then
    $SCALLDRS=$M "%PDMSUI%/DRA/SYMB/$S1" $S2
    if (undefined(!!draColStyle)) then
      !!draColStyle = object DRACOLSTYLEHANDLER()
    endif
  endif

  -- get symbol library from symbol element
  if( empty(!this.slab) ) then
    !refElement = !!ce
    do
      if( !refElement EQ LIBY ) then
        !this.slab = !refElement.name
        break
      else
        !refElement = !refElement.owner
      endif

      if( badref(!refElement) ) then
        return error 1 'Default Symbol Library not set'
      endif
    enddo
  endif

  if( defined(!!cdrsylalib) and !!cdrsylalib.shown() ) then
    return
  endif

  -- set symbol library
  if( defined(!!cdrudflts) ) then
    !dfltsTmp = !!cdrudflts.slab.val
    !!cdrudflts.slab.val = !this.slab
    !!runSynonym('CALLDRS USHOWLIB SLAB')
    !!cdrudflts.slab.val = !dfltsTmp
  else
    !!cdrudflts = !this
    !!runSynonym('CALLDRS USHOWLIB SLAB')
    !!cdrudflts.delete()
  endif

  -- Change callback
  if( !!cdrsylalib.cancelCall NE '!!mdselectsymbol.closeCallback()' ) then
    !!cdrsylalib.cancelCall = '!!mdselectsymbol.closeCallback()'
    !!cdrsylalib.control.clear('Close')
    handle any
    endhandle
    !!cdrsylalib.control.add( 'CALLBACK', 'Close','!!mdselectsymbol.closeCallback()')
    handle any
    endhandle
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      .closeCallback()
--
-- Description: Callback invoked on symbol selection form closed event
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------

define method .closeCallback()
    import 'PDMSCommands'
    handle (1000,0)
    endhandle
    !!cdrsylalib.hide()
    using namespace 'Aveva.Pdms.Presentation.PDMSCommands'
    !cm = object PMLNETCOMMANDMANAGER()
    !cm.executeCommand('AVEVA.Marine.UI.Button.GeneralAnnotateLabel')
endmethod

------------------------------------------------------------------------
--
-- Method:      .getSelectedSymbol()
--
-- Description: Callback invoked on symbol selection form closed event
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--    STRING    Label symbol template name
--
------------------------------------------------------------------------

define method .getSelectedSymbol() is STRING
    !refElement = !!ce
    do
      if( !refElement.type EQ 'SYTM' or !refElement.type EQ 'TXTM') then
        return !refElement.name
      else
        !refElement = !refElement.owner
      endif

      if( badref(!refElement) ) then
        return !this.defaultSymbol
      endif
    enddo
endmethod
