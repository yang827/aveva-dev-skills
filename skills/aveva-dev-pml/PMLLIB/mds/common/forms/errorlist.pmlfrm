--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  refresh()                        -
--
setup form !!errorlist
textpane .list width 60 line 12
path down
button .refresh 'Refresh' call '!this.refresh()'

exit

define method .refresh()

!this.list.clear()

!lines = ARRAY()
!lines.append(!!error.text)
!lines.append(!!error.line)
!lines.append(!!error.command)
!lines.appendarray(!!error.callstack)

!this.list.val = !lines

endmethod
