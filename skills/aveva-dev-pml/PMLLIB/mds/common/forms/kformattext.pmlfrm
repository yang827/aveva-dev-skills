--
-- File:            KFormatText.frm
--   Type:          Form Definition
--   Group:         Common Application
--     Keyword:
--   Module:        common
--   Replaces:
--
-- Author:          Neale Morris
-- Created:         19 Jan 1998
--
--
-- Description:
-- Form to generate a dummy text gadget in the currently set format
-- This then can be used to convert text is pml functions for display
-- purposes
------------------------------------------------------------------------

-- Kill existing form definition
kill !!KFormatText

-- Define form
setup form !!KFormatText
    !!KFormatText.FormTitle = 'Pass units'

    text .Text at 0 0 width 20 is real format !!DistanceFmt
    text .Text1 at 0 1 width 20 is real format !!DistanceFmt
    text .Bore at xmin ymax width 20 is real format !!BoreFmt
exit

return
