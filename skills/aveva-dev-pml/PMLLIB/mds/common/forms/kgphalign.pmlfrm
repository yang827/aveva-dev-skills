--
-- File:            kgphalign.frm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:
-- Created:
--
--
-- Description:
-- Standard MDS Align support form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form down
--  initialise()                     -                   Initialisation form
--  kgphalign()                      -                   Constructor
--  preview()                        -                   Preview the plane
--  setMeasure(LINE)                 -                   Set form to passed line (used to define a dimension)
--  setWrt()                         -                   Change wrt
--  setup()                          -                   Setup data for form to be shown for default measure
--  setup(REAL)                      -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!kgphalign

  !!kgphalign.formtitle     = 'Alignment Utility'
  !!kgphalign.icontitle     = 'MDS Align'
  !!kgphalign.callback      = '!this.initialise()'
  !!kgphalign.formrevision  = ' $Revision: 1.1.19.1 $ '

  -- Body of form definition

  -- Distances
  frame .distanceFrame 'Information'

    -- Distance
    text .distance 'Distance ' at x1 ymax width 14 is REAL format !!distanceFmt

    path down
    frame .offsetFrame 'Alignment Offset'

      -- Offset
      text .x ' Support offset X ' at x1 ymax   width 14 is REAL format !!distanceFmt
      path down
      halign right
      text .y                 'Y '              width 14 is REAL format !!distanceFmt
      text .z                 'Z '              width 14 is REAL format !!distanceFmt

      -- Direction
      text .direction    'Datum Atta PL Dir '                width 14 is STRING
      text .wrt        'wrt '       callback '!this.setWrt()' width 20 is STRING
    exit

  exit

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax+0.25 callback '!this.close()' cancel

  -- Form Members
  -- Measurement Object
  member .dimension    is GPHDIMENSION

  -- Position
  member .position     is POSITIONLINK

  -- Aid number being modified
  member .aidDimension is REAL

  -- Aid number
  member .aidNumber    is REAL


exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      kgphalign
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .kgphalign()

  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!kgphalign.position',!this.X, !this.Y, !this.Z)

  -- Set initial measurement
  !this.position.setPosition(N0 wrt World)

  -- Allocate aid number
--  !this.aidNumber = !!aidNumbers.add('Measuring')
  !this.aidNumber = !!aidNumbers.add('Aligning')

  -- Set initialise direction
  !this.direction.val = 'U'

  !this.wrt.val       = 'World'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Setup form
  !this.setupForm()
-- Set all gadgets NOT to be Editable by USERS when Form is displayed
  !this.distance.val = 0
  !this.x.val = 0
  !this.y.val = 0
  !this.z.val = 0
  !this.direction.val =  'U'

  !this.distance.seteditable(false)
  !this.direction.seteditable(false)
--  !this.wrt.seteditable(false)
-- <GE> 20/10/06 The !this.wrt gadget was made seteditable to allow users to align the support
-- with wrt to any element. The main reason this was done for GENSEC elements that are not straight
  !this.wrt.seteditable(true)
  !this.x.seteditable(false)
  !this.y.seteditable(false)
  !this.z.seteditable(false)
  !this.dismiss.active = false


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove aid numbers
  !this.tidy()

  -- Take rotate edg off the stack
  !!edgCntrl.remove('Define a linear dimension')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid numbers
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown for default measure
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

  -- Set form data
  !this.aidDimension  = !this.aidNumber
  !this.dimension     = object GPHDIMENSION()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidDimension  = !aidNumber
  !this.dimension     = !!aidNumbers.numbers[!aidNumber]
  handle ANY
    !this.dimension   = object GPHDIMENSION()
  endhandle


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- If plane is unset, then initialise it to default 000
  if(!this.dimension.coreObject().unset()) then
    !gphDimension         = object GPHDIMENSION()
    !gphDimension.tag     = true
    !gphDimension.detail  = true
    !this.dimension       = !gphDimension
  endif

  -- Set dimension
  !offset      = !this.dimension.offset()
  !newPosition = object POSITION('E' & !offset[1] & '  N' & !offset[2] & ' U' & !offset[3])
  !this.position.setPositionNoAct(!newPosition)

  -- Set distance
  !distance          = !this.dimension.from.distance(!this.dimension.to)
  !this.distance.val = !distance

  -- Direction
  if(!distance eq 0) then
    !direction = 'U'
  else
    !direction = !this.dimension.from.direction(!this.dimension.to).wrt(!this.dimension.wrt)
  endif

  !this.direction.val = !direction.string().before('WRT').trim()


  -- Show Plane
  !this.preview()


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.dimension)


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:  Change wrt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbref()
  handle ANY
    !wrtItem = object DBREF()
  endhandle

  -- Assume world as reference
  if(!wrtItem.unset()) then
    !wrtItem = world
  endif

  -- Set tagging method up
  !this.dimension.wrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

  -- Preview
  !this.setupForm()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description: Set form to passed line (used to define a dimension)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!line is LINE)

  -- Write the measurement (line is used as this give the from/to positions) to
  -- the gphDimension object
  !this.dimension.setDimension(!line.startPosition, !line.endPosition)

  -- Draw the dimension
  !this.setupForm()

endmethod
-- End of method

-- End of file kgphalign.frm
