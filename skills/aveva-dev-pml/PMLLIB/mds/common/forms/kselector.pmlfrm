--
-- File:		kselector.frm
--   Type:		Form Definition
--   Group:		Common forms
--     Keyword:		COM
--   Module:		ALL
--   Replaces:          _CDCTMPLIST
--
-- Author:		S.Robinson
-- Created:		Wednesday 19th November 1997
--
--
-- Description:
-- System form with single selector gadget
-- Used where selection sytax can capture space delimited queries
-- that may exceed command line length of 256 chars
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!KSelector

-- Define Form
Setup Form !!KSelector

  !!KSelector.formtitle    = |System Selector Form|
  !!KSelector.icontitle    = |SELECTOR|

  -- Body of Form
  selector .Select multi width 50 length 20

exit

-- End of file kselector.frm
