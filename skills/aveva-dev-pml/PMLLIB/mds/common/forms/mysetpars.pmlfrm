--
--
-- Description:
-- Form Definition for Selecting Multiple supports for Detailing via MDS ABA
--
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
kill !!mysetpars

-- Define Form
setup form  !!mysetpars

  !!mysetpars.formtitle = |set design parameters|
  !!mysetpars.icontitle = |MDS Select|
  !!mysetpars.callback  = |!this.init()|

  list .parameters 'Design parameters' call '!this.select() ' columns width 60 hei 41
  text .despars 'Values' at xmin .parameters ymax call '!this.setpars(!this.despars.val)' width 60 scroll 255 is STRING

-- Body of Form
  path down
  vdist 0.5



  exit

  define method .init()
    if !!ce.type.eq('SCOM') then
        var !dtref dtref
        var !a coll all data for $!dtref
    else
       var !a coll all data for ce
    endif
    !lines = ARRAY()
--    !prop = ARRAY()
--    !value = ARRAY()
--    !title = ARRAY()
!lines[1] = ' Description ' &  '	' & ' Design Parameter ' & '	' & ' Value '
    do !b values !a
     -- !prop.append( pprop of $!b )
     -- !title.append(dtitle of $!b )
     -- !value.append('0')
      !prop = pprop of $!b
      !title = dtitle of $!b
      !value= '0.00'
      !lines.append( !title &  '	' & !prop & '	' & !value)

    enddo
  --  !lines[1] = !title
  --  !lines[2] = !prop
  --  !lines[3] = !value
  --  q var !lines
    !this.parameters.dtext = !lines

  endmethod


  ------------------------------------------------------------------------------------------
  define method .select()

  --$P selected $!this.parameters.selection()
  !dtext =  !this.parameters.dtext
  !picked =  !this.parameters.pickedfield


  !val = !!alert.input(!dtext[!this.parameters.val + 1].before('('), '0')
  !number = !dtext[!this.parameters.val + 1].after('[').before(']').trim().real()
  model set design para $!number $!val

  !current = !this.parameters.val

  !dtext[!this.parameters.val + 1] =  !dtext[!this.parameters.val + 1].replace('0.00',!val)
   !this.parameters.dtext = !dtext
   !this.parameters.val = !picked
  endmethod
  ------------------------------------------------------------------------------------------

  define method .setpars(!line is STRING)
    !bits = !line.split()
    --!params = ARRAY()
    !dtext = !this.parameters.dtext
    do !a index !bits
      model set design para $!a $!bits[$!a]
      !dtext[!a + 1] = !dtext[!a + 1].before(')') & '	' & !bits[!a]
handle ANY
endhandle
     -- !params.append(!bits[!a])
    enddo

   !this.parameters.dtext = !dtext


  endmethod
