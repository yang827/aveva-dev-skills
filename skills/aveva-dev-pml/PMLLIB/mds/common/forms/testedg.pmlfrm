------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  init()                           -
--  returnfromedg(array)             -
--

setup form !!testedg


button .test 'PICK' call |!this.edgentry()|

   member .sbfi is dbref

   member .plane is plane

exit

--------------------------------------------------------------------------------
define method .init()

endmethod
--------------------------------------------------------------------------------
------------------------------------------------------------------------------------
define method .edgentry()

    prompt  'Pick Plate To Connect To'
    -- !this.setactive(false)
    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'fr03'
    --!packet.elementPick('Pick Element')
    --!packet.defineposition('Pick Element')

    -- Remember the element when the packet was first place in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- Move to the element picked
    !packet.action = '!!testedg.returnfromedg(!this.return)'

    -- Set the close sequence, so that the user returns to the original
    -- element
    -- !packet.close = '!!testedg.setactive(true)'

    !packet.remove = true $* set packet so that it deletes itself when it finished
    !pickpacket = object edgpickpacket()
    !pickpacket.stdgraphic('pick a surface')
    -- add the new picktype to the edgpacket currently defined
    !packet.pickpacket = !pickpacket

    -- Add event packet to the system
    !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is array)

   -- this method is called when the EDG returns from a valid pick
   -- first of all check to see if the item picked was a flange

   !item = !input[1].item
   if !item.type.neq('SBFI') and !item.type.neq('STWALL') and !item.type.neq('GWALL') then
      !!Alert.error('Identified element is unsuitable to support from.')
      !!edgcntrl.remove('fr03')
      !this.edgentry()
      --!this.setactive(true)
      return
   endif
  --q var !input[1]
  --q var !input[1].positiondata()
  !this.plane = !input[1].positiondata().plane
  if !this.plane.unset() then
    !!alert.error('Please identify a Surface - Not an Edge or PPoint')
    prompt dismiss
    return
  endif

  !this.sbfi = !input[1].item

   prompt dismiss
  --!!edgcntrl.remove('fr03')
  -- if it gets here then its found a face


  q var !this.sbfi
  q var !this.plane

  -- call the createfunction with the plate data
   -- !!MdscreateFr03(|PICK|)
  --!this.datum.active = false

endmethod
