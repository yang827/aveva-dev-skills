--
--
-- Description:
-- Function to reset the demo mdb to the demo master
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!MdsResetDemo()

-- Check we are in the MDE project

  !proj = current proj
  !ProjCode = !Proj.code()
  if !ProjCode.neq('MDE')and !ProjCode.neq('TWD') then
    !!Alert.Error('This function can only be used on the MDS projects MDE or TWD')
    return
  endif

  if !!Alert.Confirm('Are you sure you want to reset the demo database?').eq('YES') then
    delete db DEMO/DESI
    delete db DEMO/DRAFT
    copy db DEMO/DESIMASTER to DEMO/DESI
    copy db DEMO/DRAFTMASTER to DEMO/DRAFT
    set mdb /DEMO
    add DEMO/DESI 1
    add DEMO/DRAFT 2
  endif


-- End function
endfunction

-- End of file MdsResetDemo.pmlfnc
