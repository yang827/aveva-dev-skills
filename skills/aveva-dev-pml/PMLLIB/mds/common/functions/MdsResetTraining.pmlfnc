--
--
-- Description:
-- Function to reset the Training mdb's
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!MdsResetTraining()

-- Check we are in the FRA, MDE or MDK project

  !proj = current proj
  !ProjCode = !Proj.code()
   !test = !ProjCode.neq('MDE') and !ProjCode.neq('MDK')
  if !ProjCode.neq('MDE') and !ProjCode.neq('MDK')and !ProjCode.neq('FRA') then
    !!Alert.Error('This function can only be used on the MDS project FRA, MDE or MDK')
    return
  endif

  if !!Alert.Confirm('Are you sure you want to reset the training databases?').eq('YES') then

    !Alpha = Array()
    !Alpha.Append('A')
    !Alpha.Append('B')
    !Alpha.Append('C')
    !Alpha.Append('D')
    !Alpha.Append('E')
    !Alpha.Append('F')
    !Alpha.Append('G')
    --!Alpha.Append('H')
    --!Alpha.Append('I')
    --!Alpha.Append('J')

    do !x values !Alpha

      delete db TRAIN$!X/DESI
        handle ANY
        endhandle
      delete db TRAIN$!X/DRAFT
        handle ANY
        endhandle
      delete db TRAIN$!X/TEMPLATES
        handle ANY
        endhandle
      $P Creating DB's for TRAIN$!X user
      copy db TRAIN/DESIMASTER to TRAIN$!X/DESI
      copy db TRAIN/DRAFTMASTER to TRAIN$!X/DRAFT
      copy db TRAIN/MASTERTEMPLATES to TRAIN$!X/TEMPLATES
      set mdb /TRAIN$!X
      add TRAIN$!X/DESI 1
      add TRAIN$!X/DRAFT 2
      add TRAIN$!X/TEMPLATES 3

      if (!ProjCode.eq('FRA')) then
        add MDSCCD/HVAC-CATA 4
        handle ANY
        endhandle
        add MDSCCD/ELEC-CATA 5
        handle ANY
        endhandle
        add FRAMDS/ELECDESI 6
        handle ANY
        endhandle
        add FRAMDS/HVACTEST 7
        handle ANY
        endhandle
      endif

    enddo

  endif

-- End function
endfunction

-- End of file MdsResetTraining.pmlfnc
