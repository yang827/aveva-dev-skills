--
-- File:                Mdscatasizetag.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            PARAGON
--   Replaces:
--
-- Author:              Wayne Dodwell
-- Created:             Tuesday 18th April 2000
--
--
-- Description: Sets the UDA :MDSSizeTag at the SPRF element in a STEELWORK catalogue
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING      Name of Steelwork Catalogue
--     2      R        BOOLEAN     TRUE if SIZETAG update is LIVE, FALSE if SIZETAG update is to FILE
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscatasizetag(!name is STRING , !live is BOOLEAN)

  -- Check PDMS Module is PARAGON
  !banner = banner
  -- MAW Change
  if (!banner.name.trim().upcase.eq('PARAGON').not()) then
    !!alert.error('This function MUST be run from inside the Paragon Module')
    return
  endif

  -- Check if !name exists, is CATA type, Unlocked and that user has WRITE access to it.
  !namm = !name.replace(' ','')
  if (!name.trim().match('/').eq(1).not()) then
    !cata = '/' & !namm.trim()
  else
    !cata = !namm.trim()
  endif
  var !cataexist exists $!cata CATA UPDATE
  if (!cataexist eq 'FALSEA')then
    !!alert.error('The Steelwork Catalogue ''$!cata'' does not exist.')
    return
  elseif (!cataexist eq 'FALSEB')then
    !!alert.error('The element''$!cata'' exists but it is not a Catalogue.')
    return
  elseif (!cataexist eq 'FALSEC')then
    !!alert.error('The Catalogue ''$!cata'' exists but you do not have write access to it.')
    return
  elseif (!cataexist eq 'TRUEC')then
    !dbref = !cata.dbref()
    if (!dbref.purpose.eq('STL')) then
      if (!dbref.lock) then
        if (!!alert.confirm('The Steelwork Catalogue ''$!cata'' exists but it is LOCKED. Do you want to UNLOCK it and continue?') eq 'NO') then
          return
        endif
      endif
    else
      !!alert.error('The Catalogue ''$!cata'' exists but it is NOT a Steelwork catalogue')
      return
    endif
  endif

  if (!live) then
    !sprfs = !!kcollectallfor('SPRF', '(:MDSSizeTag eq |unset|)', !dbref)
    do !dbnam values !sprfs
      !!ce = !dbnam
      skip if (!dbnam.name.match('=').eq(1))
      !sizename = !dbnam.name.after('/')
      :MDSSizeTag |$!sizename|
    enddo
  else
    -- Collect all Cata SPRF elements in the Selected Steelwork Catalogue
    !sprfs = !!kcollectallfor('SPRF', '', !dbref)
    !block = object BLOCK('!sprfs[!evalindex].:MDSSizeTag')
    !sizet = !sprfs.evaluate(!block)

    !cname = !cata.after('/')
    !file = object FILE('%PDMSUSER%/MDS-SIZETAG-$!<cname>')

    !file.open('WRITE')
    !file.writerecord('')
    !file.writerecord('------------------------------------------------------------------------')
    !file.writerecord('-- Steelwork Catalogue ** $!cata ** - SIZETAG Attribute Upgrade File --')
    !file.writerecord('------------------------------------------------------------------------')
    !file.writerecord('')
    !file.writerecord('')

    do !line indices !sprfs
      !sprfname = !sprfs[!line].name
      !file.writerecord('OLD $!sprfname')
      if (!sizet[!line].neq('unset')) then
        !file.writerecord(':MDSSizeTag |$!sizet[$!line]|')
      else
        !sizename = !sprfname.after('/')
        !file.writerecord(':MDSSizeTag |$!sizename|')
      endif
      !file.writerecord('')
      !file.writerecord('')
    enddo

    !file.writerecord('')
    !file.writerecord('------------------------------------------------------------------------------')
    !file.writerecord('-- END of Steelwork Catalogue ** $!cata ** - SIZETAG Attribute Upgrade File --')
    !file.writerecord('------------------------------------------------------------------------------')
    !file.writerecord('')
    !file.close()

    -- Advise where the MDS-SIZETAG macro name and where it is located
    !!alert.message('The Steelwork Catalogue ''$!cata'' UDA :MDSSizeTag Upgrade Macro is called %PDMSUSER%/MDS-SIZETAG-$!<cname>')

  endif

endfunction
