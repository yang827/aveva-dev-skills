--
-- File:                Mdsdeleteattas.pmlfnc
--   Type:              Utility
--   Group:             Common
--     Keyword:         Delete
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             8 Apr 1998
--
--
-- Description:
-- Function to delete MDS attas when items are copied.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [ARRAY]       [of attas from MDS spec]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!mdsDeleteAttas(!array is ARRAY)

  -- collect all attas
  do !ind values !array
    var !attas append coll all atta with (name of spec of spref inset(|/MDS|, |/MDF|, |/MDP|)) for $!ind
    var !attas append coll all atta with (styp inset(|MH01|, |LI01|)) for $!ind
  enddo

  -- Get a list of all rest (MDS Supports referenced by the attas found)

  !ce = !!ce
  var !rests eval cref for all from !attas
  do !deleteRest values !rests
    !!ce = !deleteRest.dbref()
    handle NONE
      rest
      delete rest
    elsehandle ANY
    endhandle
  enddo
  !!ce = !ce

  !!mdsDacControl(TRUE)

  !!kPDMSdelete(!attas)

  !!mdsDacControl(FALSE)

  do !ind values !array
    var !allOlets append coll all OLET with ( styp inset(|LUF|, |LUC|)) for $!ind
    var !allOlets append coll all OLET with matchwild(STYP,'*LS*') for $!ind
  enddo

  !!mdsDacControl(TRUE)
  !ce = !!ce
  do !deleteOlets values !allOlets
    !!ce = !deleteOlets.dbref()
    handle NONE
      delete olet
      handle ANY
      endhandle
    elsehandle any
    endhandle
  enddo
  !!ce = !ce
  handle any
  endhandle
  !!mdsDacControl(FALSE)

endfunction
