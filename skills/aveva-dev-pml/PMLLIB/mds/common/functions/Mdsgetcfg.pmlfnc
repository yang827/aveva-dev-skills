--
-- File:		Mdsgetcfg.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Tue 10th Dec
--
--
-- Description:
-- function to substitute catalogue/design parameter and bore values
-- for passed ATTA and hanger config object
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       DBREF of ATTA
--     2       RW      MdsCONFIG  object containing configuration defaults for ATTA
-- Return:
--    [Data Type]   [Description]
--     BOOLOEAN      True if values were successfully substituted, otherwise false
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetCfg(!Atta is DBREF, !Config is MdsCONFIG) is BOOLEAN

  -- move to atta
  $!Atta
  handle any
    !!Alert.Error('ATTA $!ATTA does not exist!')
    return false
  endhandle

  -- check we are at an ATTA
  if (!Atta.Type.String().Neq('ATTA')) then
    !!Alert.Error('Passed element must be an attachment!')
    return false
  endif

  -- get the ATTAs Stype
  var !Stype STYPE
  handle any
    !!Alert.Error('ATTA $!ATTA does not have an STYPE!')
    return false
  endhandle

  -- check if the ATTA is a hanger
  if (!Stype.Substring(1,2).Neq('HT')) then
    !!Alert.Error('ATTA $!ATTA is not a hanger!')
    return false
  endif

  -- search for atta stype in config index array
  !Index = !!MdsCFGINDX.FindFirst(!Stype)

  -- check we have found the stype in the array
  if (!Index.Unset()) then
    !!Alert.Error('The Hanger STYPE $!Stype not found in configuration defaults!')
    return false
  endif

  -- copy config object into local object
  !LocalConfig = !!MdsCFGS[$!Index]

  -- replace catalogue/design paramters and nominal bore values in all ancillaries
  do !Index index !LocalConfig.Ancill

    !Sub = !LocalConfig.Ancill[!Index]
    if (!!MdsSubCfg(!Atta,!Sub).Not()) then
      return False
    endif
    -- replace substituted ancill back into local config object
    !LocalConfig.Ancill[$!Index] = !Sub

  enddo

  -- replace catalogue/design paramters and nominal bore values in other config object members

  --!Sub = !LocalConfig.Description
  --if (!!MdsSubCfg(!Atta,!Sub).Not()) then
  --  return False
  --endif
  -- replace substituted string back into local config object
  --!LocalConfig.Description = !Sub

  !Sub = !LocalConfig.Type
  if (!!MdsSubCfg(!Atta,!Sub).Not()) then
    return False
  endif
  -- replace substituted string back into local config object
  !LocalConfig.Type = !Sub

  !Sub = !LocalConfig.Erection
  if (!!MdsSubCfg(!Atta,!Sub).Not()) then
    return False
  endif
  -- replace substituted string back into local config object
  !LocalConfig.Erection = !Sub

  -- reset return config object with values in local object
  !Config = !LocalConfig

  Return True

-- End function
endfunction

-- End of file Mdsgetcfg.pml
