--
--
-- File: Mdssubcfg.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author: S.robinson
-- Created:		Tue 10th Dec
--
--
-- Description:
-- function to substitute catalogue/design parameter and bore values
-- for passed string
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       DBREF of ATTA
--     2       RW      STRING      string in which values are to be substituted
-- Return:
--    [Data Type]   [Description]
--     BOOLOEAN      True if values were successfully substituted, otherwise false
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSubCfg(!atta is DBREF, !string is STRING) is BOOLEAN

  -- move to atta
  $!atta
  handle any
    !!alert.error('ATTA $!atta does not exist!')
    return false
  endhandle

  -- check we are at an ATTA
  if (!atta.type.string().neq('ATTA')) then
    !!alert.error('Passed element must be an attachment!')
    return false
  endif

  -- substitute catalogue parameters
  !sub = !string.upcase()

  do
    if (!sub.match('!param').neq(0)) then
      !before = !sub.before('!param[')
      !after  = !sub.after('!param[')
      !num    = !after.before(']')
      !after  = !after.after(']')
      -- get parameter value
      !param = PARAM[$!num]
      handle (2,752) $* param does not exist
        !!alert.error('Invalid parameter: PARAM[$!num] does not exist!')
        return false
      endhandle
      -- replace parameter value string
      !sub = !before + !param.string() + !after
    else
      break
    endif
  enddo

  -- substitute design parameters
  do
    if (!sub.match('!despar').neq(0)) then
      !before = !sub.before('!despar[')
      !after  = !sub.after('!despar[')
      !num    = !after.before(']')
      !after  = !after.after(']')
      -- get parameter value
      !param = DESPAR[$!num]
      handle (2,752) $* param does not exist
        !!alert.error('Invalid parameter: DESPAR[$!num] does not exist!')
        return false
      endhandle
      -- replace parameter value in rod detail string
      !sub = !before + !param.string() + !after
    else
      break
    endif
  enddo

  -- substitute nominal bore

  !bore = PL BORE
  !nB   = !bore.real().string()
  !sub  = !sub.upcase().replace('!nB',!nB)

  -- set return string with string containing substituted values
  !string = !sub

  return True

-- End function
endfunction
