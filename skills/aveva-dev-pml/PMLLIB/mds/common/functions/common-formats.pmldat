-- Data File containing default unit definitions

-- Inportant Information
-- Type and Gvar are related, don't have different GVARs within the same
-- Type grouping. You can have different groupings with the same GVAR.

------------------------------------------------------------------------------------
--
-- Modified to enable us to mix between working in both imperial and metric
-- The use of these defaults will allow the KPIT appware to work with the old ISOU
-- gadgets and the new format gadgets.

-- Please make sure that any new formats entered have the keywords :-
--
-- Metric ( for mm)
-- and
-- Imperial (for inches)
--
-- somewhere in their description member.
--
-- ie !Formats.Description  = |Imperial Distances (fractions 1/4")|
--
------------------------------------------------------------------------------------

-- Origin Expression Block
!OriginBlock                = object BLOCK(||)

-----------------------------Convert-to-Metric-----------------------------

-- Format (000.0000mm)
--!Formats                      = object FORMATS()
--!Formats.Type                 = |Metric|
--!Formats.Description          = |Conversion to Metric (6 Decimal Places)|
--!Formats.Example              = |1234.123456mm|
--!Formats.Gvar                 = |!!MetricFmt|
--!Formats.Format               = object format()
--!Formats.Format.CompSeparator = ||
--!Formats.Format.Denominator   = 32
--!Formats.Format.Dimension     = |L|
--!Formats.Format.DP            = 6
--!Formats.Format.ENU           = true
--!Formats.Format.Fraction      = false
--!Formats.Format.FtLabel       = ||
--!Formats.Format.InchSeparator = ||
--!Formats.Format.Label         = |mm|
--!Formats.Format.PadFractions  = false
--!Formats.Format.Units         = |MM|
--!Formats.Format.OriginExp     = !OriginBlock
--!Formats.Format.Zeros         = false
--!!Formats.Permissibles.append(!Formats)

-----------------------------Distance-----------------------------

-- Format (00)
!Formats                      = object FORMATS()
!Formats.Type                 = |Distances|
!Formats.Description          = |Metric Distances (No Decimal Places)|
!Formats.Example              = |1234|
!Formats.Gvar                 = |!!DistanceFmt|
!Formats.Format               = object format()
!Formats.Format.CompSeparator = ||
!Formats.Format.Denominator   = 32
!Formats.Format.Dimension     = |L|
!Formats.Format.DP            = 0
!Formats.Format.ENU           = false
!Formats.Format.Fraction      = false
!Formats.Format.FtLabel       = ||
!Formats.Format.InchSeparator = ||
!Formats.Format.Label         = ||
!Formats.Format.PadFractions  = false
!Formats.Format.Units         = |MM|
!Formats.Format.OriginExp     = !OriginBlock
!Formats.Format.Zeros         = false
!!Formats.Permissibles.append(!Formats)


-- Format (000.00)
!Formats                      = object FORMATS()
!Formats.Type                 = |Distances|
!Formats.Description          = |Metric Distances (2 Decimal Places)|
!Formats.Example              = |1234.56|
!Formats.Gvar                 = |!!DistanceFmt|
!Formats.Format               = object format()
!Formats.Format.CompSeparator = ||
!Formats.Format.Denominator   = 32
!Formats.Format.Dimension     = |L|
!Formats.Format.DP            = 2
!Formats.Format.ENU           = false
!Formats.Format.Fraction      = false
!Formats.Format.FtLabel       = ||
!Formats.Format.InchSeparator = ||
!Formats.Format.Label         = ||
!Formats.Format.PadFractions  = false
!Formats.Format.Units         = |MM|
!Formats.Format.OriginExp     = !OriginBlock
!Formats.Format.Zeros         = false
!!Formats.Permissibles.append(!Formats)


-- Format (000.00mm)
!Formats                      = object FORMATS()
!Formats.Type                 = |Distances|
!Formats.Description          = |Metric Distances (2 Decimal Places)|
!Formats.Example              = |1234.56mm|
!Formats.Gvar                 = |!!DistanceFmt|
!Formats.Format               = object format()   
!Formats.Format.CompSeparator = ||
!Formats.Format.Denominator   = 32
!Formats.Format.Dimension     = |L|
!Formats.Format.DP            = 2
!Formats.Format.ENU           = true
!Formats.Format.Fraction      = false
!Formats.Format.FtLabel       = ||
!Formats.Format.InchSeparator = ||
!Formats.Format.Label         = |mm|
!Formats.Format.PadFractions  = false
!Formats.Format.Units         = |MM|
!Formats.Format.OriginExp     = !OriginBlock
!Formats.Format.Zeros         = false
!!Formats.Permissibles.append(!Formats)

-- Format (000.0000mm)
!Formats                      = object FORMATS()
!Formats.Type                 = |Distances|
!Formats.Description          = |Metric Distances (4 Decimal Places)|
!Formats.Example              = |1234.5678mm|
!Formats.Gvar                 = |!!DistanceFmt|
!Formats.Format               = object format()
!Formats.Format.CompSeparator = ||
!Formats.Format.Denominator   = 32
!Formats.Format.Dimension     = |L|
!Formats.Format.DP            = 4
!Formats.Format.ENU           = true
!Formats.Format.Fraction      = false
!Formats.Format.FtLabel       = ||
!Formats.Format.InchSeparator = ||
!Formats.Format.Label         = |mm|
!Formats.Format.PadFractions  = false
!Formats.Format.Units         = |MM|
!Formats.Format.OriginExp     = !OriginBlock
!Formats.Format.Zeros         = false
!!Formats.Permissibles.append(!Formats)

-- Format (00'00.00/00")
!Formats                      = object FORMATS()
!Formats.Type                 = |Distances|
!Formats.Description          = |Imperial Distances (16ths Fraction)|
!Formats.Example              = |1'10.15/16|
!Formats.Gvar                 = |!!DistanceFmt|
!Formats.Format               = object FORMAT()
!Formats.Format.CompSeparator = ||
!Formats.Format.Denominator   = 16
!Formats.Format.Dimension     = |L|
!Formats.Format.DP            = 2
!Formats.Format.ENU           = true
!Formats.Format.Fraction      = true
!Formats.Format.FtLabel       = |'|
!Formats.Format.InchSeparator = |.|
!Formats.Format.Label         = ||
!Formats.Format.PadFractions  = false
!Formats.Format.Units         = |FINCH|
!Formats.Format.OriginExp     = !OriginBlock
!Formats.Format.Zeros         = true
!!Formats.Permissibles.append(!Formats)

 
-- Format (00'00.00/00")
!Formats                      = object FORMATS()
