--
--
--
-- Description:
-- Loads the formats for bores
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!FormatsBSet ()


  -- Get Gvar of item
  !Gvar = !!Formats.Permissibles[!!Formats.Bores.selection().real()].Gvar

  -- Set Format
  $!Gvar = !!Formats.Permissibles[!!Formats.Bores.selection().real()].Format
  -- set units in PDMS
  if(!!Formats.Bores.selection('Dtext').upcase().match('IMPERIAL').neq(0)) then
  -- imperial bores
     INCH BORES
  elseif(!!Formats.Bores.selection('Dtext').upcase().match('METRIC').neq(0)) then
     MM BORES
  endif

endfunction
-- End of function definition

-- End of file formatsset.pml
