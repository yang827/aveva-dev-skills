--
-- File:                FormatsInit.pml
--   Type:              Initialisation Macro
--   Group:             Formats for Units
--     Keyword:         GEN
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             19 Jan 1998
--
--
-- Description:
-- Initialisation for formats form
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Called from GADGET or FORM]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------

define function !!FormatsInit(!FromFormOrGadget is string)

-- initialise variables

     !NewListD = ARRAY()
     !NewListR = ARRAY()

   if(!FromFormOrGadget.eq('FORM')) then

--  already restricted reload list


     !SelectedDist = !!Formats.Formats.selection()
     !SelectedDispD = !!Formats.Formats.selection('DTEXT')
     !SelectedBore = !!Formats.Bores.selection()


-- reload list if units are different from gadget set


          if(!!Formats.Restricted) then
             !!FormatsLoad()
             !!Formats.Restricted = FALSE
          endif



-- Which units ?

        if(!!KGetUnits('DIST').eq('IMPERIAL')) then
           !Units = 'Imperial'
        else
           !Units = 'Metric'
        endif

--   set option gadget to units
        !!Formats.Units.select(!Units)

--   Restrict the list to only show units

      !DistList = !!Formats.Formats.DTEXT
      !RtexList = !!Formats.Formats.RTEXT

--   block eval slow - so use do loop
     do !Index Indices !DistList
         if(!DistList[!Index].upcase().match(!Units.upcase()).neq(0)) then
            !NewListD.append(!DistList[!Index])
            !NewListR.append(!RtexList[!Index])
         endif
      enddo

      !!Formats.Formats.Dtext = !NewListD
      !!Formats.Formats.Rtext = !NewListR
-- reset selected value
      !!Formats.Formats.Select('Rtext',!SelectedDist)
       handle any
-- incase newly loaded
       endhandle

-- set flag to denote restricted list
      !!Formats.Restricted = TRUE
-- set format to current list selection
      !!Formatsset('DISTANCE')
 -- select the first current unit bore in the list (only if bore units set to units )
      if(!!KgetUnits('BORE').eq(!Units.upcase())  and !!Formats.Units.selection().eq(!Units)) then
        !BoreList = !!Formats.Bores.dtext
        do !Index values !Borelist
          if(!Index.upcase().match(!Units.Upcase()).neq(0)) then
             !!Formats.Bores.Select('Dtext',!Index)
            break
          endif
        enddo
      else
       !BoreList = !!Formats.Bores.dtext
        do !Index values !Borelist
          if(!Index.upcase().match(!!KgetUnits('BORE')).neq(0)) then
             !!Formats.Bores.Select('Dtext',!Index)
            break
          endif
        enddo
      endif

-- select the bores for current units


-- set format to current list selection

      !!Formatsset('BORE')

   else
   -- from the unit gadget
          if(!!Formats.Restricted) then
             !!FormatsLoad()
             !!Formats.Restricted = FALSE
          endif

    if(!!Formats.Units.selection().upcase().eq('METRIC')) then
       MM DISTANCE
       MM BORE
    else
       FINCH DISTANCE
       INCH BORE
    endif

  !!FormatsInit('FORM')

  endif



endfunction

-- end function FormatsInit
