--
--
-- Description:
-- Function to loop through an array and action each command line
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          ARRAY       An array containing Actions to be taken.
--                                  The array must be an array of strings.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define function
define function !!KActionCommands(!Array is ARRAY)

-- Check that array the array is not empty
  if (!Array.empty())then
    return
  endif

-- loop through Array values
  do !I indices !Array
    $!Array[$!I]
      handle(2,752)
      -- Array index does not exist
      endhandle
  enddo
  !!MdsDacControl(false)
endfunction
-- End of function definition

-- End of file kactioncommands.pml
