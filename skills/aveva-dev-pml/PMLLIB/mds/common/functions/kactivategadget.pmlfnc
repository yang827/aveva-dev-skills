--
--
-- Description:
-- Function to change gadget status
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         GADGET      Gadget to be toggled on or off
--     2     R         BOOLEAN     'True' Activates the gadget
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!KActivateGadget(!Gadget is GADGET, !State is BOOLEAN)

  -- Change Gadget Status
  !Gadget.Active = !State

-- End function
endfunction

-- End of file kactivategadget.pml
