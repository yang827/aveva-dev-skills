--
-- File:            KAidClear.pml
--   Type:          Function Definition
--   Group:         Graphics
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Mar 18 1998
--
-- Description:
-- replace GAIDCLEAR to clear aid lines
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [String]     [Aid Line Number(s) to Remove]
--   [2] [R]    [String]      [Type of Aid to be removed]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!KAidClear(!StrOfNumbs is string, !StrOfTypes is string)




-- Initialise Variables

   !Numbers = !StrOfNumbs.split()
   !Types   = !StrOfTypes.split()

-- Default $D 2
   if(!Types[1] eq |ALL|) then
      !Types[1] = |LINE|
      !Types[2] = |TEXT|
      !Types[3] = |SPHERE|
      !Types[4] = |ARROW|
      !Types[5] = |BOX|
   endif


-- Loop through numbers
 do !I values !Numbers

   do !TYPE values !Types
     AID CLEAR $!TYPE $!I
     handle ANY
     endhandle
   enddo
 enddo


endfunction
-- End of function definition


-- End of file aidclear.pml
