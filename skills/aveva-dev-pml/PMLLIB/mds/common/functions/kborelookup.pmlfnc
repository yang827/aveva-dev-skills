--
-- File:		Mdsborelookup.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 26th February 1998
--
--
-- Description:
-- Function to Derive Equivalent Pipe Size
-- This FUNCTION may be EXTENDED but Currently it ONLY ACCOUNTS for
-- The AVIALABLE Trunnion Diameters in the 'MDS' Application
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        REAL        Pipe Bore Diameter
--     2      R       STRING       MM  - For Metric Bore
--                                 IMP - For Imperial Bore
--
-- Return:
--    [Data Type]   [Description]
--       REAL          REAL  -  Equivalent Bore Size
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!kborelookup(!bore is REAL, !unit is STRING) is REAL

-- Return the Metric Bore Equivalent
    if (!unit.upcase().eq('MM')) then

      if (!bore eq 2) then
        return 50
      elseif (!bore eq 3) then
        return 80
      elseif (!bore eq 4) then
        return 100
      elseif (!bore eq 5) then
        return 125
      elseif (!bore eq 6) then
        return 150
      elseif (!bore eq 8) then
        return 200
      elseif (!bore eq 10) then
        return 250
      elseif (!bore eq 12) then
        return 300
      elseif (!bore eq 14) then
        return 350
      elseif (!bore eq 16) then
        return 400
      elseif (!bore eq 18) then
        return 450
      elseif (!bore eq 20) then
        return 500
      elseif (!bore eq 22) then
        return 550
      elseif (!bore eq 24) then
        return 600
      elseif (!bore eq 30) then
        return 750
      elseif (!bore eq 36) then
        return 900
      elseif (!bore eq 42) then
        return 1050
      elseif (!bore eq 48) then
        return 1200
      else
        golabel /abort
      endif


-- Return the Imperial Bore Equivalent
    elseif (!unit.upcase().eq('IMP')) then

      if (!bore eq 50) then
        return 2
      elseif (!bore eq 80) then
        return 3
      elseif (!bore eq 100) then
        return 4
      elseif (!bore eq 125) then
        return 5
      elseif (!bore eq 150) then
        return 6
      elseif (!bore eq 200) then
        return 8
      elseif (!bore eq 250) then
        return 10
      elseif (!bore eq 300) then
        return 12
      elseif (!bore eq 350) then
        return 14
      elseif (!bore eq 400) then
        return 16
      elseif (!bore eq 450) then
        return 18
      elseif (!bore eq 500) then
        return 20
      elseif (!bore eq 550) then
        return 22
      elseif (!bore eq 600) then
        return 24
      elseif (!bore eq 750) then
        return 30
      elseif (!bore eq 900) then
        return 36
      elseif (!bore eq 1050) then
        return 42
      elseif (!bore eq 1200) then
        return 48
      else
        golabel /abort
      endif

    endif

    label /abort
      return 0

  endfunction
-- End function

-- End of file kborelookup.pml
