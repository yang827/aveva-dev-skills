--
-- File:		kcheckcommand.pml
--   Type:		Function Definition
--   Group:		Common Application
--     Keyword:		COM
--   Module:		ALL
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Wednesday 27th November 1997
--
--
-- Description:
--
-- Function to check command line syntax typed by user
--
-- To use this function you need to reference it from the callback of the
-- string of the commands and requests form using the following syntax:
--
-- !!kcheckenable()'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!KCheckCommand()

  -- get current command typed by user command
  !Command = !!cadcbth.cadccom.val.trim()

--<wd>may2007<mds12>
--  var !BANNAM BANNER NAME
  var !BANNAM BANNER SHORT
--<wd>may2007<mds12>
  handle any
    !BANNAM = 'Unknown Module'
  elsehandle none
  endhandle

  -- check for recursive call
  if (!Command.Upcase().Trim().Match('KCHECKCOMMAND').neq(0)) then
    return
  endif

  -- check for command checker enable/disable commands
  if (!Command.Upcase().Trim() eq 'CHECKENABLE') then
    prompt 'Command Checking is Already Enabled!'
    pause 2
    prompt dismiss
    return
  elseif (!Command.Upcase().Trim() eq 'CHECKDISABLE') then
    call !!KCheckDisable()
    return
  endif

  -- split the command into its constituent parts
  !ComSplit = !Command.split()

  -- check for module and check command string as required
--<wd>may2007<mds12>
--  if (!BANNAM.Upcase().Match('DESIGN').Neq(0)) or (!BANNAM.Upcase().Match('OUTFITTING').Neq(0)) then
  if (!BANNAM.Upcase().Match('DESIGN').Neq(0)) or (!BANNAM.Upcase().Match('OUTFITTING MK').Neq(0)) then
--<wd>may2007<mds12>

    -- check for delete
    if (!ComSplit[1].upcase().eq('DELETE')) then
      !!Alert.Error('Please use the "Delete" menu options to delete PDMS elements!')
      return
    endif

  endif

  -- execute the passed command line
  $!Command
  handle (46,89) $* cannot switch module whilst in a PML function
    !!Alert.Warning('Cannot switch module from the command line...')
  elsehandle any
    $p $!!ERROR.TEXT
    !!Alert.Error('$!!ERROR.TEXT')
  endhandle

  return


-- End function
endfunction

-- End of file kcheckcommand.pml
