--
-- Author:		S.Robinson
-- Created:		Wednesday 27th November 1997
--
--
-- Description:
--
-- Function to turn off command line syntax checker
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!kcheckdisable()


  if (!!cadcbth.cadccom.callback eq '') then
    Prompt 'Command Checking Already Disabled!'
    pause 2
    Prompt dismiss
  else
    Prompt 'Command Checking Disabled...'
    pause 2
    Prompt dismiss
    var !BANNAM BANNER NAME
    handle any
    elsehandle none
      !!cadcbth.formtitle = '$!BANNAM Command Input & Output'
    endhandle
    !!cadcbth.cadccom.callback = ''
    $s checkenable  = !!kcheckenable()
    $s checkdisable = !!kcheckdisable()
  endif

  return

-- End function
endfunction

-- End of file kcheckenable.pml
