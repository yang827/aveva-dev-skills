--
-- File:		kcheckname.pml
--   Type:		Function Definition
--   Group:		Common Application
--     Keyword:		COM
--   Module:		ALL
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed Jul 30
--
--
-- Description:
-- Check name facility. Prefixes name to be check with a '/' if required
-- Checks if passed text string is a valid name for new or existing dbrefs.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Text string 'NEW' or 'OLD'
--     2     R        GADGET        Text Gadget containing name to be checked
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KCheckName(!Method is STRING, !Data is GADGET)

  -- Initialise variables
    !Name  = !Data.Val

  -- Check first character of name
    if (!Name.eq(' ') or !Name.upcase().eq('UNSET'))then
      !Data.Val = 'unset'
      !Data.setfocus()
      return

    elseif (substring(!Name,1,1) eq '=')then
      if (!Method.eq('OLD'))then
        !Ref = !Name.dbref()
        handle (2,107)
          !!Alert.error('Undefined reference. $!<Name>')
          !Data.Val = 'unset'
          !Data.setfocus()
        endhandle
      else
        !Name = '/' & !Name
        !Ref = !Name.dbref()
        handle none
          !!Alert.error('Name $!<Name> already exists.')
          !Data.Val = 'unset'
          !Data.setfocus()
        elsehandle (2,109)
          !Data.Val = !Name
        endhandle
      endif

    elseif(substring(!Name,1,1) neq '/')then
      !Name = '/' & !Name
      if (!Method.eq('OLD'))then
        !Ref = !Name.dbref()
        handle (2,109)
          !!Alert.error('Undefined name. $!Name')
          !Data.Val = 'unset'
          !Data.setfocus()
        elsehandle none
          !Data.Val = !Name
        endhandle
      else
        !Ref = !Name.dbref()
        handle none
          !!Alert.error('Name $!<Name> already exists.')
          !Data.Val = 'unset'
          !Data.setfocus()
        elsehandle (2,109)
          !Data.Val = !Name
        endhandle
      endif
    else
      if (!Method.eq('OLD'))then
        !Ref = !Name.dbref()
        handle (2,109)
          !!Alert.error('Undefined name. $!Name')
          !Data.Val = 'unset'
          !Data.setfocus()
        endhandle
      else
        !Ref = !Name.dbref()
        handle none
          !!Alert.error('Name $!<Name> already exists.')
          !Data.Val = 'unset'
          !Data.setfocus()
        endhandle
      endif
    endif

-- End function
endfunction

-- End of file kcheckname.pml
