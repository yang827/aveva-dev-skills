--
-- File:                kCheckWrite.pml
--   Type:              Read
--   Group:             Common
--     Keyword:         Read/Write
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             28 Apr 1998
--
--
-- Description:
-- Function to return whether passed dbref is write access
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [DBREF]       [Element read/write check is to be carried out on]
--    [2]   [RW]     [STRING]      [un/locked]
--    [3]   [RW]     [STRING]      [Return R/RW]
-- Return:
--    [Data Type]   [Description]
--
--    [BOOLEAN]     [Return TRUE if DBname is write accessible]
--
--------------------------------------------------------------------------------




define function !!kCheckWrite(!Dbref is dbref, !Lock is string, !Write is string) is boolean


-- Initialise Variables

   !Session    = current session
   !CurrentDBs = !Session.current()
   !Modes      = !Session.mode()
   !Dbname     = !Dbref.dbname
   !Lock       = 'Unlocked'
   !Write      = 'RW'
   !Writeable  = TRUE

-- get index of db in mdb

   do !Ind indices !CurrentDBs

      if(!CurrentDbs[!ind].Name.eq(!Dbname)) then
         !DbIndex = !ind
         break
      endif

   enddo

   if(!Modes[!DbIndex].neq('RW')) then
      !Writeable = FALSE
      !Write = 'R'
   endif

-- is the element locked

   if(!Dbref.lock) then
      !Lock = 'Locked'
      !Writeable = FALSE
   endif



Return !Writeable


endfunction

-- end function kcheckwrite.pml
