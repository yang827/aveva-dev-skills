-- Created:         Friday 21st Jan 1998
--
--
-- Description:
-- function to check the current project units match the
-- selected units in the format units form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [RW]   [STRING]    [Current Units]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [Check whether the current units match the selected format]
--
--------------------------------------------------------------------------------


-- Define function
define function !!kChkSetUnits() is BOOLEAN

  -- get current distance units
  !units         = object COMUNITS(false)
  !distanceUnits = !units.getCurrentUnitsByPtype('DIST').upCase()

  -- get current format units
  !formatUnits   = !!formats.units.selection().upCase()

-- return whether units match selected formats or not
  return !distanceUnits.eq(!formatUnits)

endfunction
