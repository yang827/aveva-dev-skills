--
-- File: kclosestpline.pmlfnc
--   Type: Function Definition
--   Group: Common Application
--     Keyword: COM
--   Module: DESIGN
--   Replaces:
--
-- Author: I.osborne
-- Created: Tue Jul 08
--
--
-- Description:
-- function to get closest point on a SCTN relative to 3d position in a given
-- direction
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Reference of a SCTN
--     2     R        POSITION      3D position from which to calculate nearest
--                                  point on section.
--     3     R        DIRECTION     Direction from datum position towards section
--
-- Return:
--    [Data Type]   [Description]
--     ARRAY         1. Pline that is closest to passed position
--                   2. Position on pline
--                   3. Next nearest pline
--                   4. Next nearest intersection point
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kclosestpline(!section is DBREF, !pos is POSITION, !dir is DIRECTION) is ARRAY

--<wd>may2007<mds12>
-- Check that passed dbref is a SCTN etc...
  --  if (!section.type neq 'SCTN' and !section.type neq 'STWALL' and !section.type neq 'GENSEC')then
  if (!section.type neq 'SCTN' and !section.type neq 'STWALL' and !section.type neq 'GENSEC' and !section.type neq 'HSTIFF')then
    !!alert.error('Passed reference is not a Section or an HSTIFF')
    return
  endif
--<wd>may2007<mds12>

  -- Initialise variables
  !!ce = !section
--  !pList  = ARRAY()
--  !pnum  = ARRAY()
    !p = ARRAY()
  --!pDist  = ARRAY()
    !distances = ARRAY()
  if !section.type eq 'STWALL' then
    !plines = !!kCollectallfor('PLIN', 'PKEY neq |NA|', !section.pstre)
     else
    !plines = !!kCollectallfor('PLIN', '', !section.pstre)
     endif
  !block = object BLOCK('!plines[!evalIndex].pkey')
  !pkeys = !plines.evaluate(!block)
  var !datumLine CONS Line $!dir THRO $!pos

    --<RM> 26/06/07 -- problem with this function not picking the correct plines
    -- the problem occurs because the pml 1 line intersection planes up through the second line.
    -- therefore you can get plines at the same distance from the reference point. the method discarded some
    -- of this information and therefore the wrong plines were sometimes picked.
    -- the following returns an array of plines which includes plines at the same distance from the reference point
  -- Loop through plines and construct an intersection point
  !origin = !!ce
  do !i indices !plines
    !pDist  = ARRAY()
    VAR !start PLSTART $!pkeys[$!i] WRT WORLD
    VAR !end PLEND $!pkeys[$!i] WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist CONS DIST $!pos TO $!inter
    --!pList.append(!inter)
    var !units units
    if (!units.part(3) eq 'mm') then
      !distances.append(!dist.real())
    else
      !temp = object REAL(!dist,!!distanceFmt)
      !distances.append(!temp)
    endif
    !pDist.append(!plines[$!i])
    !pDist.append(!inter.position())
    if (!units.part(3) eq 'mm') then
      !pDist.append(!dist.real())
    else
      !temp = object REAL(!dist,!!distanceFmt)
      !pDist.append(!temp)
    endif
    !p.append(!pDist)
  enddo

  -- Get shortest distance from datum position to section
  !shortest = !distances.unique().sort()
    !newarray = ARRAY()
    do !i from 1 to !shortest.size()
      !number = !shortest[!i]
      do !j from 1 to !p.size()

        !a = !p[$!j]
        if !a[3].eq(!number) then
        -- add this ARRAY member i.e. distance and pline ref to a new array
          !newarray.append(!a)
        endif
      enddo
    enddo

  !array = ARRAY()
    do !i from 1 to !newarray.size()
      do !j from 1 to 2
      !array.append(!newarray[!i][!j])
      enddo
    enddo

    !!ce = !origin

  return !array

$( -- original code <RM> 26/06/07 -- end of fix
  -- Get shortest distance from datum position to section
  !shortest = !pDist
  !shortest.sort()
  !shortest.unique()

  -- Set up array
  !array = ARRAY()

  do !i indices !shortest
    !distance = !shortest[!i]

    -- Get Pline and position of intersection on beam
    !number   = !pDist.findfirst(!distance)
    !pline    = !plines[!number]
    !position = !pList[!number]

    -- Set up return array
    !array.append(!pline)
    !array.append(!position.position())
    enddo

  !!ce = !origin
$)
  --return !array

-- End function
endfunction
