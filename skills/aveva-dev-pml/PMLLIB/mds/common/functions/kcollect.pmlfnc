--
--
-- Description:
-- Collect function
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       KCOLLECT       Collection object holding selection criteria
--
-- Return:
--    [Data Type]   [Description]
--    ARRAY         Array of items collected
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KCollect(!Collection is KCOLLECT) is ARRAY

  -- Initialise variables
  !Class = !Collection.Class
  !Expr  = !Collection.Expression
  !Types = !Collection.Type
  !Item  = !Collection.Search

  -- Check variables

  if (!Item.Set())then
    !Where = !Item
  else
    !Where = ''
  endif

  if (!Expr ne '')then
    !When = 'Where' & ' ' & !Expr
  else
    !When = ''
  endif

$(
--<wd>temporary code only executed for <wd>
  !sess = current session
  if (!sess.login.lowcase().eq('wayne.dodwell')) then
    alp log /c:/temp/mds-load.pmldat over
    handle ANY
    endhandle
$P *** kcollect function variables start ****
$P q var !class !expr !types !item
    q var !class !expr !types !item
$P-------------------------------------------
$P q var !what !when !where
    q var !what !when !where
$P-------------------------------------------
$P *** kcollect function variables end ****
    alp log end
    handle ANY
    endhandle
  endif
--<wd>temporary code
$)


  if (!Types.Set())then
    !What = '(' & !Class & ' ' & !Types & ')'
    if (!Where.string() eq '')then
      var !Col collect $!What $!When
    else
      var !Col collect $!What $!When FOR $!Where
    endif
  else
    !What = !Class
    var !Col collect $!What OF $!Where $!When
  endif

  if (!Col.empty().not())then
    !Block = object block('!Col[!EvalIndex].dbref()')
    !DbCollection = !Col.evaluate(!Block)
  else
    !DbCollection = ARRAY()
  endif

  -- Return collected items
  return !DbCollection

-- End function
endfunction

-- End of file kcollect.pml
