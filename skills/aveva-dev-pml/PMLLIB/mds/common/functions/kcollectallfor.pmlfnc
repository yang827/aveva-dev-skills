--   Type:    Function Definition
--   Group:   Common Application
--     Keyword:   COM
--   Module:    ALL
--   Replaces:
--
-- Author:    I.osborne
-- Created:   Tue Apr 29
--
--
-- Description:
-- Generic collection routine for collecting all items of a given type
-- for a specific db reference. Nulref will assume all worlds.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       STRING        List of elements to collect
--     2     R       STRING        Expression for search criteria
--     3     R       DBREF         Search start element
--
-- Return:
--    [Data Type]   [Description]
--    ARRAY         Array of items collected
--
--------------------------------------------------------------------------------
define function !!kCollectAllFor(!types is STRING, !expr is STRING, !item is DBREF) is ARRAY

  -- Initialise variables
  !collection = object KCOLLECT()

  -- If Item is unset, don't set Collection Search
  if (!item.set())then
    !collection.search = !item
  endif

  -- Set Expression and Types
  !collection.class      = 'ALL'
  !collection.expression = !expr
  !collection.type       = !types

  -- Return collected items
  return !!kCollect(!collection)

endfunction
