-- Created:		Tue Apr 29
--
--
-- Description:
-- Generic collection routine for collecting all members of a given type
-- for a specific db reference.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       DBREF         Element members are to be collected from
--     2     R       STRING        Expression for search criteria
--
-- Return:
--    [Data Type]   [Description]
--    ARRAY         Array of items collected
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KCollectMemberOf(!Item is DBREF, !Expr is STRING) is ARRAY

  -- Initialise variables
  !Collection = object KCOLLECT()
  !EmptyArray = ARRAY()

  -- If Item is unset, don't set Collection Search
  if (!Item.set())then
    !Collection.Search = !Item
  else
    !!Alert.error('Cannot collect members of an unknown dbref.')
    return !EmptyArray
  endif

  -- Set Expression and Types
  !Collection.Class      = 'MEMBERS'
  !Collection.Expression = !Expr

  -- Return collected items
  return !!KCollect(!Collection)

-- End function
endfunction

-- End of file kcollectmemberof.pml
