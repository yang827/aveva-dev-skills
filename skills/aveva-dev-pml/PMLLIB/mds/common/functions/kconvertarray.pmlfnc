--
--
-- Description:
-- Function to convert all elements of an array from one type to another.
-- This will only convert elements of the array that are valid, all others
-- will be ignored
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [ARRAY]       [Passed array to be converted]
--     2     R       [STRING]      [Type to convert to]
--     3     R       [STRING]      [Sort the new array "SORT"]
-- Return:
--    [Data Type]   [Description]
--
--    [ARRAY]       [Converted array of reals (sorted if requested)]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KConvertArray(!Array is array,  !To is string,!Sorted is string) is Array

 !NewArray = Array()

 do !i indices !Array
 !NewArray[!i] = !Array[!i].$!To()
  handle any
   -- not convertable
  endhandle
 enddo

 if(!Sorted.eq('SORT')) then
    !NewArray.sort()
 endif

Return !NewArray

endfunction
