--
-- Author:		I.Osborne
-- Created:		Tue May 27
--
--
-- Description:
-- function to check that two directions passed are equal to within passed tolerance
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        KEQUALDIR     Object holding data to be checked
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      True if directions are equal
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KDirEqualDir(!Object is KEQUALDIR) is BOOLEAN


  -- Initialise variables
    !Tol  = !Object.Tolerance
    !DirA = !Object.DirectionA
    !DirB = !Object.DirectionB

  -- Quick Check
    if (!DirA eq !DirB)then
      return True
    endif

  -- Check frame of reference
    if (!DirA.origin neq !DirB.origin)then
      !DirB.wrt(!DirA.origin)
    endif

   --<tm>14/07/2005 11:02
   -- had a problem with this function returning an incorrect value, so I simplified it
   if !DirA.angle(!dirB).leq(!tol) then
        return TRUE
   else
        return FALSE
   endif

$(
-- Get Direction A tolerance
--<wd>nov2004 -- These variables are  NOT required.
    --!TolUp    = !DirA.Up + !Tol
    --!TolEast  = !DirA.East + !Tol
    --!TolNorth = !DirA.North + !Tol
--<wd>nov2004

-- Get max and min directions
--<wd>nov2004 -- The variables !TolUp/East/North were INCORRECTLY included the ORIGINAL variables !DirA.Up/East/North.
-- Only the ACTUAL Tolerance, i.e. !Tol, is NOW ADDED and SUBTRACTED from the variables !Dira.Up/East/North in order to
-- Check the variables !DirB.Up/East/North etc... against the !MinUp/East/North,!MaxUp/East/North variables.
    --!MaxUp    = !DirA.Up    + !TolUp
    --!MinUp    = !DirA.Up    - !TolUp
    --!MaxEast  = !DirA.East  + !TolEast
    --!MinEast  = !DirA.East  - !TolEast
    --!MaxNorth = !DirA.North + !TolNorth
    --!MinNorth = !DirA.North - !TolNorth
    !MaxUp    = !DirA.Up    + !Tol
    !MinUp    = !DirA.Up    - !Tol
    !MaxEast  = !DirA.East  + !Tol
    !MinEast  = !DirA.East  - !Tol
    !MaxNorth = !DirA.North + !Tol
    !MinNorth = !DirA.North - !Tol

--<wd>nov2004
-- Test Direction B upping
    if (!DirB.Up geq !MinUp and !DirB.Up leq !MaxUp)then
    elseif (!DirB.Up leq !MinUp and !DirB.Up geq !MaxUp)then
    else
      return False
    endif

-- Test Direction B easting
    if (!DirB.East geq !MinEast and !DirB.East leq !MaxEast)then
    elseif (!DirB.East leq !MinEast and !DirB.East geq !MaxEast)then
    else
      return False
    endif

-- Test Direction B northing
    if (!DirB.North geq !MinNorth and !DirB.North leq !MaxNorth)then
    elseif (!DirB.North leq !MinNorth and !DirB.North geq !MaxNorth)then
    else
      return False
    endif
$)

$(
  -- Test Direction B upping
    if (!DirB.Up.between(!MinUp, !MaxUp).not())then
      return False
    endif

  -- Test Direction B easting
    if (!DirB.East.between(!MinEast, !MaxEast).not())then
      return False
    endif

  -- Test Direction B northing
    if (!DirB.North.between(!MinNorth, !MaxNorth).not())then
      return False
    endif
$)


-- Directions are the same
--    return True

-- End function
endfunction

