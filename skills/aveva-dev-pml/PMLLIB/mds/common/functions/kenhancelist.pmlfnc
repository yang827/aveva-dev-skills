--
-- File:		kenhancelist.pml
--   Type:		Function Definition
--   Group:		Common Application
--     Keyword:		COM
--   Module:		DESIGN
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu May 15
--
--
-- Description:
-- Function to enhance a list of dbref's at the currently selected highlight
-- colour in design
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         ARRAY        List of DBrefs to be highlighted
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KEnhanceList(!list is array)

  -- Initialise variables
    !Origin = !!CE

  -- Check that passed list exists
    if (!list.empty())then
      return
    endif

  -- Get Current highlight colour
    !Colour = !!GphColOpt.highlight().code

$(
-- *** NOTE: ***
-- If Function is STOPPED with '$M-' and then restarted
-- with '$M+' the COLOUR HIGHLIGHT WORKS CORRECTLY,
-- Otherwise it does NOT when CREATING a FRAMEWORK, IT
-- HIGHLIGHTS in the 'ACTIVE' COLOUR and NOT the HIGHLIGHT COLOUR?????
$p----------------------------i--------------------------------------
$p  *** START ***
$p $M+
$p Macro has PAUSED
$M-
$)

  -- Loop through list
    do !V values !list
      !Bad = boolean()
      !Bad = !V.badref()
        handle any
          -- Passed element is not a DBREF
          skip
        endhandle
      if (!Bad.set())then
        skip if (!Bad)
      else
        skip
      endif
      if (!V.mcount() eq 0)then
        UNENHANCE $!V
        ENHANCE $!V COLOUR $!Colour
        if !v.type.eq('ATTA') then
          if !v.owner.:MDSTrun then
            if !v.name.match(!v.owner.name).gt(0) then
              enhance owner of $!V colour $!Colour
              bran
                handle none
                  enhance ce mem colour $!colour
                elsehandle any
                endhandle
            endif
          endif
        endif
      else
        UNENHANCE all for $!V
        ENHANCE all for $!V colour $!Colour
      endif
    enddo
    !!CE = !Origin

--$P Macro has *** FINISHED ***

-- End function
endfunction

-- End of file kenhancelist.pml
