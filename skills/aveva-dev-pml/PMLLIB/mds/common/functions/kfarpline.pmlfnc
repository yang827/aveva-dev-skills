--
-- File: kfarpline.pmlfnc
-- Type: Function Definition
-- Group: Common Application
-- Keyword: COM
-- Module: DESIGN
-- Replaces:
--
-- Author:  I.osborne
-- Created: Wed Jul 09
--
--
-- Description:
-- function to get farthest point on a SCTN relative to 3d position in a given
-- direction
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Reference of a SCTN/GENSEC
--     2     R        POSITION      3D position from which to calculate farthest
--                                  point on section.
--     3     R        DIRECTION     Direction from datum position towards section
--
-- Return:
--    [Data Type]   [Description]
--     ARRAY         1. Pline that is farthest from passed position
--                   2. Position on pline
--                   3. Next furthest pline
--                   4. Next furthest intersection point
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kFarPline(!section is DBREF, !pos is POSITION, !dir is DIRECTION) is ARRAY

  -- Check that passed dbref is a SCTN
  if (!section.type neq 'SCTN') and (!section.type neq 'GENSEC') then
    !!alert.error('Passed reference is not a Section')
      return
    endif

  -- Initialise variables
  !!ce = !section
  !pList  = ARRAY()
  !pDist  = ARRAY()
  !plines = !!kCollectallfor('PLIN', '', !section.pstre)
  !block = object BLOCK('!plines[!evalIndex].pkey')
  !pkeys = !plines.evaluate(!block)
  var !datumLine CONS Line $!dir THRO $!pos

  -- Loop through plines and construct an intersection point
  !origin = !!ce
  do !i indices !plines
    VAR !start PLSTART $!pkeys[$!i] WRT WORLD
    VAR !end PLEND $!pkeys[$!i] WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist CONS DIST $!pos TO $!inter
    !pList.append(!inter)
    var !units units
    if (!units.part(3) eq 'mm') then
      !pDist.append(!dist.real())
    else
      !temp = object REAL(!dist,!!distanceFmt)
      !pDist.append(!temp)
    endif
    enddo

  -- Get longest distance from datum position to section
  !longest = !pDist
  !longest.sort()
  !longest.unique()
  !longest.invert()

  -- Set up array
  !array = ARRAY()

  do !i indices !longest
    !distance = !longest[!i]

    -- Get Pline and position of intersection on beam
    !numbers   = !pDist.find(!distance)
    do !j from 1 to !numbers.size()
      !number = !numbers[!j]
      !pline    = !plines[!number]
      !position = !pList[!number]

      -- Set up return array
      !array.append(!pline)
      !array.append(!position.position())
    enddo
  enddo

  !!ce = !origin

  return !array

-- End function
endfunction
