--
-- File             : KFindDrawColour
--   Type           : Function Definition
--   Group          :
--     Keyword      :
--   Module         :
--   Replaces       :
--
-- Author:          : Neale Morris
-- Created:         : September 22 1997
--
--
-- Description:
-- Function to return the value of the colour that the passed element is
-- added to the drawlist.
-- If passed element is not in the drawlist this routine will search
-- the owners... of the passed element until an owner is found in the drawlist
---------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         String      Element Name
--
-- Return:
--    [Data Type]   [Description]
--     Real             Colour Name
--
-- Define Function

define function !!KFindDrawColour(!Element is dbref) is real

-- New functionality has been added to pdms to get the colour name it has been added in
-- q drawlist ce colour

  var !colour drawlist $!Element colour
    handle NONE
      !Colour = !Colour.after('Colour ')
      !RealColour = !Colour.real()
      if !realcolour.unset() then
        return 1
      else
        return $!RealColour
      endif
    elsehandle ANY
    endhandle


  -- Use the selector gadget on the add/remove form to obtain the colour number

  var selector !!cdaddrem.drawlist clear
    draw full
  exit

  -- select all entries in list to make them active
  do !Select
    var selector !!cdaddrem.drawlist select $!Select exit
    handle any
      break
    endhandle
  enddo

  !Names      = ARRAY()
  !Colours    = ARRAY()
  !ItemName   = ''
  !ItemCol    = 0
  !FindColour = false

  -- generate array of elements -vs- colour numbers

  do !Selection selector !!cdaddrem.drawlist
    if (!FindColour) then
      -- we are at the colour for the previous element selection
      !ItemCol = !Selection.Before(')').Real()
      !Names.append(!ItemName)
      !Colours.append(!ItemCol)
      !FindColour = false
    elseif (!Selection.Match('(Colour') neq 0) then
      -- we are at the colour selection, the colour number is next in the list
      !FindColour = true
      skip
    else
      -- we are at an element selection
      !ItemName = !Selection
      !FindColour = false
    endif
  enddo

  -- reset the drawlist gadget
  var selector !!cdaddrem.drawlist clear draw exit

  -- attempt to find passed element in list

  -- is element named or do we use the dbref

  if (undefined(!Element.namn)) then
    -- use db ref as string
    !Search = !Element.String()
  else
    -- use name string
    !Search = !Element.Name
  endif

  if (set(!Names.FindFirst(!Search))) then
    -- found passed element in list
    -- get associated colour number and return
    !Index = !Names.FindFirst(!Search)
    if(!Colours[!Index] eq 199) then
       !Colour = 1
    else
       !Colour = !Colours[!Index]
    endif
    return !Colour
  else

    -- loop upwards through owners until we find an owner in the drawlist
    do

      if (!Element.Type eq 'WORL') then
        return 1
      endif

      !Owner = !Element.Owner
      handle ANY
        return 1
      endhandle

      -- attempt to find owner in list

      -- is owner named or do we use the dbref
      if (undefined(!Owner.namn)) then
        -- use db ref as string
        !Search = !Owner.String()
      else
        -- use name string
        !Search = !Owner.Name
      endif

      if (set(!Names.FindFirst(!Search))) then
        -- found passed element in list
        -- get associated colour number and return
        !Index = !Names.FindFirst(!Search)
        if(!Colours[!Index] eq 199) then
           !Colour = 1
        else
           !Colour = !Colours[!Index]
        endif
        return !Colour
      endif

      !Element = !Owner

    enddo

  endif

return $!AddColour

-- End of file KFindDrawColour.pml
