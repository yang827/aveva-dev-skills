--
-- File:            kgetboreunits.pmlfnc
--   Type:          Function Definition
--   Group:         Limbo area for old style syntax
--     Keyword:     GEN
--   Module:        DESIGN
--   Replaces:
--
-- Author:          Andrew Kirkland
-- Created:         Thu 12 Feb 1998
--
-- Description:
-- function to return Bore units from Formats form (not PDMS units)
-- This function finds out the units set in the Formats form, irrespective
-- of the current PDMS units, which will be mm, forced by the top and
-- tailing of all necessary functions
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [Boolean]   [True - units are imperial bores]
--
------------------------------------------------------------------------

-- Define function
define function !!kGetBoreUnits() is BOOLEAN

-- !imp true means bore units are in imperial
   !imperial = !!isImperialLength('BORE')

   return !imperial

endfunction
-- End of function definition
