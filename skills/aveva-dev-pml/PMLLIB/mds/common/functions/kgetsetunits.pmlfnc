--
--
-- Description:
-- function to obtain the current project units and then set the units
-- to metric distances
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
-- Return:  COMUNITS object containing saved units
--
------------------------------------------------------------------------

-- Define function
define function !!kGetSetUnits() is COMUNITS

 -- Check to see if the current project units agree with the format settings
 !savedUnits = object COMUNITS(true)
 UNITS MM DIST
 UNITS MM BORE

 return !savedUnits

endfunction
-- End of function definition
