-- Created:         19 Jan 1998
--
--
-- Description:
-- function to return current units (METRIC or IMPERIAL)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R/RW] [STRING]    [Option]
-- Return:
--   [Data Type] [Description]
--   [String]    [Current units]
--
------------------------------------------------------------------------

-- Define function
define function !!kGetunits(!option is STRING) is STRING

  if( !!isImperialLength(!option) ) then
    return 'IMPERIAL'
  else
    return 'METRIC'
  endif

endfunction
-- End of function definition
