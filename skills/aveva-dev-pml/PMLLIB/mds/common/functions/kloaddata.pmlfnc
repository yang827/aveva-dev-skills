--
--
-- Description:
-- Function to load data definition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          STRING     Data File name to be loaded
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!KLoadData(!DataFileName is STRING)

  !FileName = !DataFileName.LowCase()

  !FindFile = !!PML.getPathName('$!Filename')
    handle (44,33)
      !!Alert.message('Data file "$!Filename" cannot be found')
      return
    endhandle

  -- Try to load data file
  $m/$!FindFile
  handle (44,33)
    !!Alert.message('Data file "$!Filename" cannot be found')
  elsehandle any
    !!Alert.message('Unexpected error loading data file "$!Filename"')
  endhandle

-- End function
endfunction

-- End of file kloaddata.pml
