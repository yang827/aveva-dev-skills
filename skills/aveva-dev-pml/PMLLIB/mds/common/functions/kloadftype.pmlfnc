--
--
-- Description:
-- Function to load form definition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          STRING     Form name to be loaded
--     2     R          STRING     'BLOCKING' - Form Type to be loaded
--                                 '' - Normal Form Type to be loaded
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!Kloadftype(!FormName is STRING, !type is STRING)

  !!FormType = !Type
  !Form = '!!' + !FormName

  -- Try to load form
  pml reload form $!Form

  !!FormType.delete()

-- End function
endfunction

-- End of file kloadftype.pml
