--
-- File:    korderplinepos.pmlfnc
--   Type: Function Definition
--   Group: Common Application
--     Keyword: COM
--   Module: DESIGN
--   Replaces:
--
-- Author:    I.osborne
-- Created: Wed Jul 23
--
--
-- Description:
-- function to get positions of intersection with all plines on a SCTN/GENSEC from a 3D
-- position along a direction
-- The return is a list of pline dbrefs with the calculated intersection point
-- The order of the array is nearest intersection point to the furthest.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Reference of a SCTN/GENSEC
--     2     R        POSITION      Datum position from which to calculate nearest
--                                  point on section.
--     3     R        DIRECTION     Direction from datum position towards section
--
-- Return:
--    [Data Type]   [Description]
--     ARRAY         1. Pline that is closest to passed position
--                   2. Intersection point
--                   3. Next nearest pline
--                   4. Next nearest intersection point
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kOrderPlinePos(!section is DBREF, !pos is POSITION, !dir is DIRECTION) is ARRAY

  -- Check that passed dbref is a SCTN
  if (!section.type neq 'SCTN') and (!section.hardtype neq 'GENSEC') then
    !!alert.error('Passed reference is not a Section')
      return
    endif

  -- Initialise variables
  !!ce = !section
  !pList  = ARRAY()
  !pDist  = ARRAY()
  !plines = !!kCollectallfor('PLIN', '', !section.pstre)
  !block = object BLOCK('!plines[!evalIndex].pkey')
  !pkeys = !plines.evaluate(!block)
  var !datumLine CONS Line $!dir THRO $!pos

  -- Loop through plines and construct an intersection point
  !origin = !!ce
  do !i indices !plines
    VAR !start PLSTART $!pkeys[$!i] WRT WORLD
    VAR !end PLEND $!pkeys[$!i] WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist CONS DIST $!pos TO $!inter
    !pList.append(!inter)
    var !units units
    if (!units.part(3) eq 'mm') then
      !pDist.append(!dist.real())
    else
      !temp = object REAL(!dist,!!distanceFmt)
      !pDist.append(!temp)
    endif
    enddo

  -- Get shortest distance from datum position to section
  !shortest = !pDist
  !shortest.sort()
  !shortest.unique()

  -- Set up array
  !array = ARRAY()

  do !i indices !shortest
    !distance = !shortest[!i]

    -- Get Plines and positions of intersection on beam
    !numbers  = !pDist.find(!distance)
    !pline = ARRAY()
    !position = ARRAY()
    do !v values !numbers
      !pline.append(!plines[!v])
      !position.append(!pList[!v])
      enddo

    -- Set up return array
    do !indx indices !pline
      !array.append(!pline[!indx])
      !array.append(!position[!indx].position())
      enddo
    enddo

  !!ce = !origin

  return !array

-- End function
endfunction
