--
-- File:                KPDMSDelete.pml
--   Type:              Utility
--   Group:             Common
--     Keyword:         Delete
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             10 Jan 1998
--
--
-- Description:
-- Function to delete elements of passed array
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Array        [Array of dbrefs]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!kPDMSdelete(!list is array)

  !refe = refe


   var !type eval hardtype for all from !list

   do !Elements indices  !list
      !!CE = !list[!Elements].dbref()

      delete $!type[$!Elements]

   enddo


  !!CE = !REFE

endfunction
