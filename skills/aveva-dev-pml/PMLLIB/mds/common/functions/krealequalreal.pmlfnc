--
-- Description:
-- function to check that two reals passed are equal within passed tolerance
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        REAL          First Number to be checked
--     2     R        REAL          Second Number to be checked
--     3     R        REAL          Tolerance
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      True if reals are equal
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KRealEqualReal(!First is REAL, !Second is REAL, !Tol is REAL) is BOOLEAN

  -- Quick Check
    if (!First eq !Second)then
      return True
    endif

  -- Get max and min directions
    !Max = !First + !Tol
    !Min = !First - !Tol

  -- Test
-- Code Not working yet
--    if (!Second.between(!Max,!Min))then
--      return True
--    else
--      return False
--    endif

  -- Test
    if (!Min leq !Second and !Max geq !Second)then
      return True
    else
      return False
    endif

-- End function
endfunction

-- End of file krealequalreal.pml
