--
-- File:    kreprelevel.pmlfnc
--   Type:    Function Definition
--   Group:   Common Application
--     Keyword:   COM
--   Module:    DESIGN
--   Replaces:
--
-- Author:    I.osborne
-- Created:   Fri Mar 09
--
--
-- Description:
-- function to add passed element into model at required representation level
-- if the element cannot be navigated to then only the representation level will
-- be changed
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        Element to be added
--     2     R         STRING       Qualifying type eg PIPE,NOZZ
--     3     R         REAL         Level that element is to be add
--     4     R         COLOUR       Colour to be added at if required
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kRepreLevel(!element is DBREF, !qualifier is STRING, !level is REAL, !colour is REAL)

  -- Initialise variables
  !origin = !!ce

  -- SJR 16th September 2002 - removed level check for users
  -- who have items not in range 0-10

  -- Check that the required level is between 0 and 10
  --  if (!level.between(0,10).not())then
  --    !!alert.warning('trying to add $!element at incorrect representation level.')
  --    return
  --  endif

  -- Check that the Type can be handled
  if (!qualifier inset('PIPE', 'NOZZ', 'STRU', 'CABLE'))then
    !type = !qualifier
  else
    !type = ''
  endif

  -- Check passed reference
  if (!element.badref())then
    repre level $!type $!level
    return
  else
    !!ce = !element
    --var !prevrep repre level $!type
    rem ce
    repre level $!type $!level
    if (!colour eq 0) then
      add ce
    else
      add ce colour $!colour
      handle (61,225)
        add ce
      endhandle
    endif
    --repre level $!type $!prevrep
  endif

  !!ce = !origin

  -- End function
endfunction
