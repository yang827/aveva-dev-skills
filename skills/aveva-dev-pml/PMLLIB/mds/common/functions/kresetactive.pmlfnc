--
-- File:		kresetactive.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Friday 23nd January 1998
--
--
-- Description:
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form Name Where All Gadgets are to be made 'Active' or 'Inactive'
--     2     R       BOOLEAN       TRUE of FALSE - All Gadgets on FORM to be made 'ACTIVE' or 'INACTIVE'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!kresetactive(!form is FORM, !active is BOOLEAN)

-- Initialise Variables
    !array = !form.attributes()

    -- Set All the Forms Gadgets to !active
    do !index index !array
      !gname = '!!' & !form & '.' & !array[!index]
      $!<gname>.active = !active
      handle any
       skip
      endhandle
--<<ge 13/04/05 Activate all frames for PDMS 11.6 change of functionality as making frames
-- inactive also includes gadgets include in the frame
      if $!<gname>.type() eq 'FRAME' then
       $!<gname>.active = TRUE
      endif
--ge 13/04/05>>
    enddo


-- If the form members exists to block certain icons and the icons are being switched on then hide the icons

   if !Active then
     if defined(!Form.BlockedIcons) then
       -- !List = !Form.BlockedIcons.split(',')
       -- !List = !Form.BlockedIcons
       !!MdsDeactivate(!Form,!Form.BlockedIcons)

       -- do !SwitchOff values !List
         -- !!MdsDeactivate(!Form,'$!SwitchOff')
       -- enddo
     endif
   endif

endfunction
-- End function

-- End of file kresetactive.pml
