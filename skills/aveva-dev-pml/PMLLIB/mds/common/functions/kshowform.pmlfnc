--
--
-- Description:
-- Function to show forms
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of Form to be shown
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!KShowForm(!Form is FORM)

  -- Check for DACs

  !Test = !Form.Support.Datum
    handle none
      if !Form.Support.Datum.badref().not() then
        !!mdsShowConns(!Form)
      endif
    elsehandle any
    endhandle

  -- Check if form is already shown
  if (!Form.shown().not())then
    !Form.show()
  endif

-- End function
endfunction

-- End of file kshowform.pml
