--
-- File:		ksnaporth.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Fri 19th Dec
--
--
-- Description:
-- function to return closest ortho direction for passed direction unit vector
-- e.g. E 10 N 10 U will return E
--      E 50 N 20 U will return N etc.
--
-- Note: in situations where the direction is 'midway' between two axes
--       N is always dominant over E
--       and U is always dominant over E and N
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DIR         passed direction unit vector
-- Return:
--    [Data Type]   [Description]
--     DIR          orthogonal unit vector
--------------------------------------------------------------------------------

-- Define Function
define function !!KSnapOrth(!InDir is DIRECTION) is DIRECTION

  !Dir = !InDir

  -- determine if value has E,N,U (+ve components) or W,S,D (-ve components)
  if (!Dir.East.Geq(0)) then
    !EastDir = E
  else
    !Dir.East = -1 * !Dir.East
    !EastDir = W
  endif

  if (!Dir.North.Geq(0)) then
    !NorthDir = N
  else
    !Dir.North = -1 * !Dir.North
    !NorthDir = S
  endif

  if (!Dir.Up.Geq(0)) then
    !UpDir = U
  else
    !Dir.Up = -1 * !Dir.Up
    !UpDir = D
  endif

  -- get component closest to unit value
  if (!Dir.East.Eq(1)) then
    !OrthoDir = !EastDir
  elseif (!Dir.North.Eq(1)) then
    !OrthoDir = !NorthDir
  elseif (!Dir.Up.Eq(1)) then
    !OrthoDir = !UpDir
  else
    -- check for largest component (this is the closest ortho dir we want)
    if (!Dir.Up gt !Dir.East and !Dir.Up gt !Dir.North) then
      !OrthoDir = !UpDir
    elseif (!Dir.East gt !Dir.Up and !Dir.East gt !Dir.North) then
      !OrthoDir = !EastDir
    elseif (!Dir.North gt !Dir.Up and !Dir.North gt !Dir.East) then
      !OrthoDir = !NorthDir
    else
      -- two of the components must be equal, return preferred ortho dir
      if (!Dir.East eq !Dir.North) then
        !OrthoDir = !NorthDir
      elseif (!Dir.East eq !Dir.Up) then
        !OrthoDir = !UpDir
      elseif (!Dir.North eq !Dir.Up) then
        !OrthoDir = !UpDir
      endif
    endif
  endif

 --$p passed = $!Indir
 --$p return = $!OrthoDir

  Return !OrthoDir

-- End function
endfunction

-- End of file Mdssnaporth.pml
