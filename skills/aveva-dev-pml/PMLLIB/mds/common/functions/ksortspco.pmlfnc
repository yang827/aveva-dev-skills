--
-- File             : ksortspco.pml
--   Type           : Function Definition
--   Group          :
--     Keyword      :
--   Module         :
--   Replaces       :
--
-- Author:          : Steve Robinson
-- Created:         : Sep 11 1997
--
--
-- Description:
-- Function to re-order an items list of members in
-- ascending alpha-numeric order
--
-- Limitations:
-- This function sorts using the ascii collating sequence
-- in cases where numerals are present in a members name
-- the sort will not order the members correctly if the
-- width of the numeric fields are not the same
--
-- e.g. /ABC001
--      /ABC002
--      /ABC200
--      /ABC010
--      /ABC100
--
-- will be correctly sorted....
--
-- however...
--
--      /ABC1
--      /ABC2
--      /ABC200
--      /ABC10
--      /ABC100
--
-- will be sorted into the following order...
--
--      /ABC1
--      /ABC10
--      /ABC100
--      /ABC2
--      /ABC200
--
-- unfortunately there is no easy way around this one :-)
--
--------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1
--     2
--     3
--     4
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!Ksortspco()

  -- Initialise variables

  -- Function main

--  if (!!Alert.Confirm('OK to sort members into alphabetical order ?').boolean().not()) then
  --  return
 -- endif

 -- prompt 'Sorting...'

  -- get array of members
  !Type = !!CE.TYPE
  var !MemRefs coll all spco for CE
  var !MemNames evaluate NAME for all from !MemRefs

  -- sort the array
  !MemNames.Sort()

  -- re-order the members using the sorted array of member names
  !I = -1
  do !Member values !MemNames
    !I = !I + 1
    if (!I eq 0) then
      REORDER $!Member BEFORE 1
    else
      REORDER $!Member AFTER $!I
    endif
  enddo

  --prompt dismiss

-- End function
endfunction

-- End of file ksortspco.pml
