--
--
-- File: kstrreal.pmlfnc
--   Type:		Function Definition
--   Group:		Unit Handling
--     Keyword:		UNIT
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		15 Jan 1998
--
--
-- Description:
-- function to return a const dist string to a real in millimetres
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [STRING]      [Const string]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kStrReal(!command is STRING) is REAL

  -- Set current units

    !units = object COMUNITS(TRUE)
    units mm dist

    var !tmp $!command
    !return = !tmp.real()
    !units.restoreSavedUnitsByPtype('DIST')
    return !return

-- End function
endfunction
