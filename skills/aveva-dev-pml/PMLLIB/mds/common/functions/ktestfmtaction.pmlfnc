--
-- File             : KTestFmtAction.pml
--   Type           : Function Definition
--   Group          :
--     Keyword      :
--   Module         :
--   Replaces       :
--
-- Author:          : Steve Robinson
-- Created:         : Aug 29 1997
--
--
-- Description:
-- Test PML formats
--
--------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1
--     2
--     3
--     4
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!KTestFmtAction(!Mode is string,!Gadget is gadget,!Proc is gadget,!Internal is gadget)

  -- Initialise variables

  !Area = Real()

  -- Function main


  if (!Mode eq 'FMT') then

    !Proc.Val     = !Gadget.Val
    !Internal.Val = !Gadget.Val

  elseif (!Mode eq 'MET') then

    -- select first metric option for each format type
    !Gvar  = !!Formats.Permissibles[2].Gvar
    $!Gvar = !!Formats.Permissibles[2].Format
    !Gvar  = !!Formats.Permissibles[13].Gvar
    $!Gvar = !!Formats.Permissibles[13].Format
    !Gvar  = !!Formats.Permissibles[15].Gvar
    $!Gvar = !!Formats.Permissibles[15].Format
    !Gvar  = !!Formats.Permissibles[17].Gvar
    $!Gvar = !!Formats.Permissibles[17].Format
    !Gvar  = !!Formats.Permissibles[19].Gvar
    $!Gvar = !!Formats.Permissibles[19].Format
    !Gvar  = !!Formats.Permissibles[21].Gvar
    $!Gvar = !!Formats.Permissibles[21].Format
    !Gvar  = !!Formats.Permissibles[23].Gvar
    $!Gvar = !!Formats.Permissibles[23].Format

  elseif (!Mode eq 'IMP') then

    -- select first metric option for each format type
    !Gvar  = !!Formats.Permissibles[5].Gvar
    $!Gvar = !!Formats.Permissibles[5].Format
    !Gvar  = !!Formats.Permissibles[14].Gvar
    $!Gvar = !!Formats.Permissibles[14].Format
    !Gvar  = !!Formats.Permissibles[16].Gvar
    $!Gvar = !!Formats.Permissibles[16].Format
    !Gvar  = !!Formats.Permissibles[18].Gvar
    $!Gvar = !!Formats.Permissibles[18].Format
    !Gvar  = !!Formats.Permissibles[20].Gvar
    $!Gvar = !!Formats.Permissibles[20].Format
    !Gvar  = !!Formats.Permissibles[22].Gvar
    $!Gvar = !!Formats.Permissibles[22].Format
    !Gvar  = !!Formats.Permissibles[24].Gvar
    $!Gvar = !!Formats.Permissibles[24].Format

  elseif (!Mode eq 'REFRESH') then

    $!!KTestFormats.Isou.callback
    $!!KTestFormats.OInt.callback
    $!!KTestFormats.Area.callback
    $!!KTestFormats.Bore.callback
    $!!KTestFormats.Direction.callback
    $!!KTestFormats.Distance.callback
    $!!KTestFormats.Integer.callback
    $!!KTestFormats.Orientation.callback
    $!!KTestFormats.Position.callback
    $!!KTestFormats.Real.callback
    $!!KTestFormats.Volume.callback
    $!!KTestFormats.Metric.callback

  elseif (!Mode eq 'INIT') then

    !!KTestFormats.Isou.val        = |1.123456|
    !!KTestFormats.OInt.val        = |1|
    !!KTestFormats.Area.val        = 1.123456
    !!KTestFormats.Bore.val        = object Bore(|10|)
    --!!KTestFormats.Direction.val   = object direction('E 10 N 10 U')
    !!KTestFormats.Distance.val    =  1.123456
    --!!KTestFormats.Orientation.val = object orientation('Y is N and Z is U')
    --!!KTestFormats.Position.val    = object position('E 100 N 100 U 100')
    !!KTestFormats.Integer.val     = 1
    !!KTestFormats.Real.val        = 1.123456
    !!KTestFormats.Metric.val      =  1.123456
    !!KTestFormats.Volume.val      = 1.123456

  endif

-- End function
endfunction

-- End of file KTestFmtAction.pml
