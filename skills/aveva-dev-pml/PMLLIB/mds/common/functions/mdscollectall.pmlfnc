--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsCollectAll(!type is ANY, !filter is ANY, !scope is ANY) is ARRAY

  if !type.objectType().eq('STRING') then
    !types = !type.split()
  else
    !types = !type
  endif

  !expr = object EXPRESSION()
  if !filter.objectType().eq('STRING') then
    !expr = object EXPRESSION(!filter)
    handle (2,849)
    endhandle
  elseif !filter.objectType().eq('EXPRESSION') then
    !expr = !filter
  endif

  !collect = object COLLECTION()
  !collect.types(!types)
  if !scope.set() then
    !collect.scope(!scope)
  endif
  if !expr.set() then
    !collect.filter(!expr)
  endif

  return !collect.results()

endfunction
