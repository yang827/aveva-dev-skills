--
-- File:		mdsentrylog.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		PDMS Professional Design and Draft
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 22nd April 2002
--
--
-- Description:
-- Function for Locating and Writing to the file %MDSLOG%/mdsentrylog.txt
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      [Module Banner name]
--     2     R         STRING      [!Message variable to returned by Association]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
  define function !!mdsentrylog(!module is string,!message is string) is boolean

-- Check if %MDSLOG% evar exists
    var !evar evar MDSLOG
    if (!evar.eq('')) then
      !message = 'The environment variable MDSLOG is NOT defined. Aborting ENTRY to the MDS Application'
      return false
    endif

-- Check if %MDSLOG% directory exists
    !mdslogdir = object file('%MDSLOG%')
    if (!mdslogdir.exists().not()) then
      !message = 'The DIRECTORY set against the environment variable MDSLOG does NOT exist. Aborting ENTRY to the MDS Application'
      return false
    else
-- Check when the %MDSLOG% exists that it is a DIRECTORY and NOT a FILE
      if (!mdslogdir.type().neq('DIRECTORY')) then
        !message = 'The environment variable MDSLOG is NOT to a DIRECTORY. Aborting ENTRY to the MDS Application'
        return false
      endif
    endif

-- Create Date Time Object
    !date = object datetime()

-- Get the Current Session details
    !session = current session
    !userid  = !session.user().name
-- Get Current Project Details
    !project = current project
    !prjcode = !project.code()
    !prjdesc = !project.description()

-- Write to the MDS ENTRY LOG file if Possible
    !mdslogfile = object file ('%MDSLOG%/mdsentrylog.rep')
    if (!mdslogfile.exists().not()) then
-- Create MDS Entry Log file if it does not exist
      !newfile = array()
      !newfile.append('-------------------------------------------------------------------------------------')
      !newfile.append('-------------------------------------------------------------------------------------')
      !newfile.append('-- MDS Application Entry Log File -- *** Started at *** $!date')
      !newfile.append('-------------------------------------------------------------------------------------')
      !newfile.append('-------------------------------------------------------------------------------------')
      !newfile.append('--')
      !newfile.append('-- MDS Entry to *** $!module at *** $!date')
      !newfile.append('-- Host ID             : $!session.host')
      !newfile.append('-- PDMS Process ID     : $!session.uniqueid')
      !newfile.append('-- PDMS Project Code   : $!prjcode')
      !newfile.append('-- Project Description : $!prjdesc')
      !newfile.append('-- PDMS User ID        : $!userid')
      !newfile.append('-- Login ID            : $!session.login')
      !newfile.append('-------------------------------------------------------------------------------------')
      !mdslogfile.writefile('WRITE', !newfile)
      handle any
        !message = '$!!error.text. Aborting ENTRY to the MDS Application'
        return false
      elsehandle none
        return true
      endhandle
    else
-- Append to the Existing File
      !newfile = array()
      !newfile.append('--')
      !newfile.append('-- MDS Entry to *** $!module at *** $!date')
      !newfile.append('-- Host ID             : $!session.host')
      !newfile.append('-- PDMS Process ID     : $!session.uniqueid')
      !newfile.append('-- PDMS Project Code   : $!prjcode')
      !newfile.append('-- Project Description : $!prjdesc')
      !newfile.append('-- PDMS User ID        : $!userid')
      !newfile.append('-- Login ID            : $!session.login')
      !newfile.append('-------------------------------------------------------------------------------------')
      !mdslogfile.writefile('APPEND', !newfile)
      handle any
        !message = '$!!error.text - Aborting ENTRY to the MDS Application'
        return false
      elsehandle none
        return true
      endhandle
    endif

--------------------------------------------------------------------------------
-- End of Function - !!mdsentrylog
  endfunction
