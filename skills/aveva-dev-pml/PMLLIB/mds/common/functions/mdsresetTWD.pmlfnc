--
--
-- Description:
-- Function to reset the "12" Development Project "TWD" mdb's
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!mdsresetTWD()

-- Check we are in the TWD "12" Development project

  !proj = current proj
  !ProjCode = !Proj.code()

  if !ProjCode.neq('TWD') then
    !!Alert.Error('This function can only be used on the MDS "12" Development project - "TWD"')
    return
  endif

  if !!Alert.Confirm('Are you sure you want to reset the training databases?').eq('YES') then

    !Alpha = Array()
    !Alpha.Append('A')
    !Alpha.Append('B')
    !Alpha.Append('C')
    !Alpha.Append('D')
    !Alpha.Append('E')
    !Alpha.Append('F')
    !Alpha.Append('G')
    --!Alpha.Append('H')
    --!Alpha.Append('I')
    --!Alpha.Append('J')

    do !x values !Alpha

      delete db DEV$!X/DESI
        handle ANY
        endhandle
      delete db DEV$!X/DRAFT
        handle ANY
        endhandle
      delete db DEV$!X/TEMPLATES
        handle ANY
        endhandle
      $P Creating DB's for DEV$!X user
      copy db TRAIN/DESIMASTER to DEV$!X/DESI
      copy db TRAIN/DRAFTMASTER to DEV$!X/DRAFT
      copy db TRAIN/MASTERTEMPLATES to DEV$!X/TEMPLATES
      set mdb /DEV$!X
      add DEV$!X/DESI 1
      add DEV$!X/DRAFT 2
      add DEV$!X/TEMPLATES 3

    enddo

  endif

-- End function
endfunction

-- End of file mdsresetTWD.pmlfnc
