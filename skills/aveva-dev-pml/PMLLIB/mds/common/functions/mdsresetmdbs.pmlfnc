--
-- File:		mdsresetmdbs.pmlfnc
--   Type:		Function Definition
--   Group:
--     Keyword:
--   Module:		ADMIN
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 03rd April 2007
--
--
-- Description:
-- Function to reset the Project MDBs
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!mdsresetmdbs()

-- Check the Module is ADMIN in Version 12 of PDMS
  !bann = banner
  !bnam = !bann.short
  if (!bnam.upcase().matchwild('*PDMS ADMIN MK12*').not()) then
    !!alert.error('ERROR: You MUST be in the module PDMS ADMIN MK12 to run this MDB Upgrade -- Unable to continue.')
    return
  endif

-- check if USER wants to Continue
  if !!alert.confirm('Are you sure you want to reset ALL of the project MDBs to suit MDS12?').eq('YES') then

-- Get the MDBs in the Current Project
    var !mdbref coll all mdb

-- EXCLUDE from the current PDMS Project,
-- the original Master MDS Project LEXICON DB, i.e. MDS/LEXI - DBNO 7323
    exclude db MDS/LEXI
    handle (39,4)
      -- $* DB NOT Found
    endhandle

-- INCLUDE into the current PDMS Project,
-- the MDS 12 project DEFAULTS DB, MDS/MDSAPPDEFAULTS- DBNO 7351
    include db MDS/MDSAPPDEFAULTS from PROJ MDS USER SYSTEM/XXXXXX
    handle (1,4)
      -- $* Database name already defined
    elsehandle ANY
      !!alert.error('ERROR: db MDS/MDSAPPDEFAULTS -- Unable to continue the MDB Upgrade -- $!!error.text ')
      return
    endhandle

-- the new MAS project MDS LEXICON DB, MASTER/MDSDICT- DBNO 7323
    include db MASTER/MDSDICT from PROJ MAS USER SYSTEM/XXXXXX
    handle (1,4)
      -- $* Database name already defined
    elsehandle ANY
      !!alert.error('ERROR: db MASTER/MDSDICT -- Unable to continue the MDB Upgrade -- $!!error.text ')
      return
    endhandle

-- Determine the Number of DBs in each MDB.
-- ADD the TWO new INCLUDED DBS to each MDB in the current Project
-- i.e. MASTER/MDSDICT and MDS/APPDEFAULTS
    do !mdb indices !mdbref
      !mdbobj = object mdb($!mdbref[$!mdb])
-- Get an array of DBs in the MDB
      !mdbdbs = !mdbobj.current()
      !mdbsiz = !mdbdbs.size()

-- Set MDB and ADD Current the INCLUDED DBs
      set mdb $!mdbobj
      !numb = !mdbsiz + 1
      add MASTER/MDSDICT $!numb
      handle ANY
      endhandle
      add MDS/MDSAPPDEFAULTS $!numb
      handle ANY
      endhandle

-- Query the MDB to the Command Window
      q mdb $!mdbobj
    enddo

  endif

-- End function
endfunction

-- End of file mdsresetmdbs.pmlfnc
