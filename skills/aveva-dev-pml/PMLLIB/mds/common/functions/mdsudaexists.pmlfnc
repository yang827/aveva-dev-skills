--
-- Description:
-- function to test if UDA exists
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MDSUDAEXISTS(!UDA is STRING ) is BOOLEAN
  !result = FALSE

  !test = $!uda
  handle (2,204)
    !result = TRUE
  elsehandle ANY
  elsehandle NONE
    !result = TRUE
  endhandle


  return !result

endfunction
