define function !!mydespars(!size is real,!item is string)

 var !proj project code
  !projdflts = !proj & 'DFLTS'

  !file = object file('%$!projdflts%/des-supp-pars')
  !pars = !file.readfile(100000)

  do !b values !pars
    !csize = !b.split()[3].real()
      handle any
       skip
      endhandle
    if !b.UPCASE().match(!item.UPCASE()).gt(0) and !csize.eq(!size) then
      !line = !b
      break
    endif
  enddo

  if undefined(!line) then
    !!alert.error('Item not found')
    return
  endif

  !line = !line.after('PARAM').TRIM().before('\')
  !line = !line.after(' ')
  $p line is $!line
  !expressions = array()
  do
    if !line.match('(').gt(0) then $* its found an expression in the line
      !front = !line.before('(')
      !back = !line.after('(')
      if !back.match('(').gt(0) and !back.match('(') lt !back.match(')') then
        !expression = !line.substring(!line.match('('),!line.match('))') - !line.match('(') + 2)
        !expressions.append(!expression)
        !back = !back.after('))')
      else
        !expression = !line.substring(!line.match('('),!line.match(')') - !line.match('(') + 1)
        !expressions.append(!expression)
        !back = !back.after(')')
      endif
      !line = !front & 'dd' & !back
    else
      break
    endif
  enddo

  !params = array()
  !newline = ''
   !C = !line.SPLIT()
do !d from 1 to !c.size()
  if !c[!d] eq 'dd' then
    !exp = !expressions.removefirst()
    $p      model set Design para $!d is expression $!exp
  else
   model set desIGN para $!d $!c[$!d]
    $p      model set Design Para $!d set to $!c[$!d]
   handle any
   endhandle
  endif
enddo

-- reset remaining model pars to zero

  do !a from (!c.size() + 1) to 100
     model set design para $!a 0
  enddo

endfunction
