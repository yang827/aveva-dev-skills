define function !!mymoveorigin()
if !!ce.type ne 'RECT' then
  !!alert.error('Wrong element type')
  return
endif
!start = !!ce.ptrf.xypos
sytm
!end = !!ce.xypos
!by[1] = !end.east - !start.east
!by[2] = !end.north - !start.north
do !item values !!ce.members
  !!ce = !item
  by x $!by[1] by y $!by[2]
enddo



endfunction
