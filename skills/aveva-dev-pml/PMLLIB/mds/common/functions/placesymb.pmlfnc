 define function !!placesymb(!tex is dbref)

 new texp at @
 just c
 tpen 51
 chei 6
 !t = !!ce
 id sytm @

 !name = !!ce.name
 !!ce = !t
 !!ce.btext = !name
 return



 !!ce = !tex
 !text = !!ce.btext
 if !text eq '#:mdsshopweld' then $* its a shop weld
    just c
    at @
    by x-57 y-88.5
 else $* its a site weld
    just c
    at @
    by x-7.5 y-88.5
 endif
 rect 1
 !name = !!ce.owner.name & '/WELDTAB'
 !!ce = !name.dbref()
 handle any
   new symb $!name
   tmrf /MDS-WELDBLOCK
   at @
 endhandle

endfunction
