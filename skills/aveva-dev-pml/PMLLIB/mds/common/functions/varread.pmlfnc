-- Define Function
Define Function !!VarRead(!Question is STRING) is STRING
   LoadForm !!VarReadForm
   !!VarReadForm.FormTitle = !Question
   Waiton !!VarReadForm
   Return !!VarReadForm.Answer.val
EndFunction

