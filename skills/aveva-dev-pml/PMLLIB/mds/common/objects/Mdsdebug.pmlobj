--
-- File:    MdsDebug.obj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.Boudjnah
-- Created:   Thu March 21 2002
--
--
-- Description:
-- Multi Discipline support Debugging object

--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  MdsDebug()                       -
--  trace(Real,String)               -
--  trace(String)                    -
--  traceError(String)               -
--  traceIn(Real,String)             -
--  traceOut(Real,String)            -
--  traceOutVal(Real,String,String)  -
--

-- Define Object
define object MdsDebug


   member .level is Real

   -- number of tabs for each ident
   member .tab is Real
   -- indent deep
   member .tabIndex is Real
   member .tabStr is String
   -- template
   member .spaceLine is String

   member .callStack is Array

   member .traceError is Boolean




-- End object
endobject

define method .MdsDebug()
  !this.level = 0
  -- number of spaces incremented for each tab (or each ident)
  !this.tab = 2
  -- indent deep
  !this.tabIndex = 0
  !this.tabStr = ''
  -- template
  !this.spaceLine = '                                                                                                                                        '
  !this.callStack = Array()
  !this.traceError = false
endmethod

define method .trace(!level is Real, !text is String)
  !tabIndex = max(0,!this.tabIndex - 1)
  !tabStr = !this.spaceLine.substring(1,!tabIndex * !this.tab)
  if(!level leq !this.level) then
    $P $!tabStr$n-->$!tabIndex $!text
    if(!this.traceError) then
      $P $!this.tabStr$n*  $!!ERROR.text
      q var !!Error.Command
      $P $!this.tabStr$n*  $!!Error.Line
    endif
  endif
endmethod

define method .trace(!text is String)
   !this.trace(!this.level, !text is String)
endmethod

define method .traceIn(!level is Real, !text is String)
  if(!level leq !this.level) then
    $P $!this.tabStr$n+$!this.tabIndex Enter $!text
    if(!this.traceError) then
      $P $!this.tabStr$n*  $!!ERROR.text
      q var !!Error.Command
      $P $!this.tabStr$n*  $!!Error.Line

    endif
    !line = '$!this.tabStr$n+$!this.tabIndex called by $!text'
    handle any
      !this.tabStr = ''
      !line = '$!this.tabStr$n+$!this.tabIndex called by $!text'
      handle any
      endhandle
    endhandle
    !this.callStack.append(!line)
    !this.tabIndex = !this.tabIndex + 1
    !this.tabStr = !this.spaceLine.substring(1,!this.tabIndex * !this.tab)
  endif
endmethod


define method .traceOut(!level is Real, !text is String)
  if(!level leq !this.level) then
    !this.tabIndex = max(0,!this.tabIndex - 1)
    !this.tabStr = !this.spaceLine.substring(1,!this.tabIndex * !this.tab)
      if(!this.traceError) then
        $P $!this.tabStr$n*  $!!ERROR.text
        q var !!Error.Command
        $P $!this.tabStr$n*  $!!Error.Line
      endif
      $P $!this.tabStr$n-$!this.tabIndex Exit $!text
    !this.callStack.remove(!this.callStack.size())
    handle any
    endhandle
  endif
endmethod

define method .traceOutVal(!level is Real, !text is String, !Val is String)
  !this.trace(!level, 'Returned ' + !Val)
  !this.traceOut(!level, !text)
endmethod

define method .traceError(!text is String)
  !this.tabIndex = max(0,!this.tabIndex - 1)
  !this.tabStr = !this.spaceLine.substring(1,!this.tabIndex * !this.tab)
  $P $!this.tabStr$n*$!this.tabIndex Error Out $!text
  $P $!this.tabStr$n*  $!!ERROR.text
  q var !!Error.Command
  $P $!this.tabStr$n*  $!!Error.Line
  do !line VALUES !!Error.Callstack
    $P $!this.tabStr$n*  $!line
    handle any
      skip
    endhandle
  enddo
  do !calls from !this.callStack.size() to 1 by -1
    !line = !this.callStack[!calls]
    $P $!line
  enddo
  -- indent deep
--  !this.tabIndex = 0
--  !this.tabStr = ''
--  !this.callStack = Array()
endmethod



-- End of file MdsDebug.obj
