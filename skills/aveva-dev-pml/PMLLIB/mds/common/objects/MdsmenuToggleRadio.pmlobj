--
-- File:    MdsmenuToggleRadio.obj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.Boudjnah
-- Created:   Thu March 21 2002
--
--
-- Description:
-- Multi Discipline support menu toggle radio object.
-- Simulates the radio button mechanism for menu toggles
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  MdsmenuToggleRadio(String,MENU,Array,Array) -
--  MdsmenuToggleRadio(String,MENU,Array,Array,Real) -
--  isToggleOn(Real)                 boolean
--  restoreState()                   -
--  toggleDefaultRadioOn()           -
--  toggleRadioOff(Real)             -
--  toggleRadioOn(Real,Boolean)      -
--

-- Define Object
define object MdsmenuToggleRadio

    -- Index of default on radio. Default is zero (no button is on)
   member .defaultOn is Real

   -- Index of button which is turned on
   member .activeIndex  is Real

   -- Index of button which is turned on
   member .lastActiveIndex is Real

   -- form containing the radio gadgets
   member .menu is menu

   -- toggle name
   member .names is Array

   -- toggle callbacks
   member .callbacks is Array

-- End object
endobject


define method .MdsmenuToggleRadio(!menuInstanceName is String, !menu is MENU, !names is Array, !callbacks is Array)
  -- button names prefix (e.g radio for radio1, radio2 etc.)
  !this.defaultOn = 1
  !this.menu = !menu
  !this.names = !names
  !this.activeIndex = 1
  !this.lastActiveIndex = 1
  if(!this.names.size() neq !callbacks.size())then
    handle any
    endhandle
    !!Alert.text('Wrong values for for object names or callbacks')
    return
  endif
  do !I indices !this.names
    !callBack = '!this.$!menuInstanceName$n.toggleRadioOn($!I, true)'
    !this.menu.add('TOGGLE',!names[!I],!callBack)
    !this.callbacks[!I] = '!this.menu.owner()' + !callbacks[!I]
  enddo
endmethod



define method .MdsmenuToggleRadio(!menuInstanceName is String, !menu is MENU, !names is Array, !callbacks is Array, !defaultIndex is Real)
  -- Turn on the default toggle radio
  !this.MdsmenuToggleRadio(!menuInstanceName, !menu is MENU, !names is Array, !callbacks is Array)
  !this.defaultOn = !defaultIndex
endmethod


define method .isToggleOn(!buttonIndex is Real) is boolean
  -- is button with the given index turned on
  !toggleMenuName = '!this.form' + '.$!this.prefix$n$!buttonIndex'
  !toggleMenuIsOn = $!toggleButtonName$n.val.boolean()
  handle any
    return error 1 ('Radio button no. $!buttonIndex does not exist')
  endhandle
  return !toggleButtonIsOn
endmethod

define method .toggleDefaultRadioOn()
  !this.toggleRadioOn(!this.defaultOn)
endmethod

define method .toggleRadioOn(!clickButtonIndex is Real, !callback is Boolean)
  -- Simulates radio buttons
  -- turn off all the buttons except the on that is activated
  !this.lastActiveIndex = !this.activeIndex
  do !I indices !this.names
          -- Check that button exists
     if(!I eq !clickButtonIndex) then
       !this.activeIndex = !I
       !this.menu.select(!this.names[!I], true)
       !this.menu.setActive(!this.names[!I], false)
       if(!callBack) then
         !callbackFunc = !this.callbacks[!I]
         $!callbackFunc
       endif

     else
       !this.menu.select(!this.names[!I], false)
       !this.menu.setActive(!this.names[!I], true)
     endif
  enddo
endmethod

define method .toggleRadioOff(!clickButtonIndex is Real)
  !toggleButtonName = '!this.form' + '.$!this.prefix$n$!clickButtonIndex'
  -- Check that button exists
  !this.menu.select(!this.names[!I], false)
  !this.menu.setActive(!this.names[!I], true)
  -- When a radio button is turned off then all all buttons are off and there is no active button
  !this.lastActiveIndex = !this.activeIndex
  !this.activeIndex = 0
endmethod

define method .restoreState()
  -- When a radio button is turned off then all all buttons are off and there is no active button
  !lastActive = !this.lastActiveIndex
  !this.toggleRadioOff(!this.activeIndex)
  if(!this.lastActiveIndex eq 0) then
  else
    !this.toggleRadioOn(!lastActive)
  endif
  !this.lastActiveIndex = !lastActive
endmethod




-- End of file MdsmenuToggleRadio.obj
