--
-- File:    MdstoggleButtonRadio.obj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.Boudjnah
-- Created:   Thu March 21 2002
--
--
-- Description:
-- Multi Discipline support toggle button radio object.
-- Simulates the radio button mechanism for toggle buttons
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  MdstoggleButtonRadio(Form)       -
--  MdstoggleButtonRadio(Form,String) -
--  MdstoggleButtonRadio(Form,String,Real) -
--  isFilterOn(Real)                 boolean
--  restoreState()                   Real
--  toggleDefaultRadioOn()           -
--  toggleRadioOff(Real)             -
--  toggleRadioOn(Real)              -
--

-- Define Object
define object MdstoggleButtonRadio

   -- Prefix for radi button names
   member .prefix is String

   -- Index of default on radio. Default is zero (no button is on)
   member .defaultOn is Real

   -- Index of button which is turned on
   member .activeIndex  is Real

   -- Index of button which is turned on
   member .lastActiveIndex is Real


   -- form containing the radio gadgets
   member .form is form

   member .maxIndex is Real
-- End object
endobject


define method .MdstoggleButtonRadio(!form is Form)
  -- button names prefix (e.g radio for radio1, radio2 etc.)
  !this.prefix = 'radio'
  !this.defaultOn = 0
  !this.form = !form
endmethod


define method .MdstoggleButtonRadio(!form is Form, !prefix is String)
  !this.MdstoggleButtonRadio(!form)
  -- button names prefix (e.g radio for radio1, radio2 etc.)
  !this.prefix = !prefix
endmethod

define method .MdstoggleButtonRadio(!form is Form, !prefix is String, !defaultIndex is Real)
  -- Turn on the default radio button
  !this.MdstoggleButtonRadio(!form, !prefix)
  !this.defaultOn = !defaultIndex
endmethod


define method .isFilterOn(!buttonIndex is Real) is boolean
  -- is button with the given index turned on
  !toggleButtonName = '!this.form' + '.$!this.prefix$n$!buttonIndex'
  !toggleButtonIsOn = $!toggleButtonName$n.val.boolean()
  handle any
    return error 1 'Radio button no. $!buttonIndex does not exist'
  endhandle
  return !toggleButtonIsOn
endmethod

define method .toggleDefaultRadioOn()
  !this.toggleRadioOn(!this.defaultOn)
endmethod

define method .toggleRadioOn(!clickButtonIndex is Real)
  -- Simulates radio buttons
  -- turn off all the buttons except the on that is activated
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this' + '.toggleRadioOn($!clickButtonIndex is Real)')
  endif
  !this.lastActiveIndex = !this.activeIndex
  do !I
     !toggleButtonName = '!this.form' + '.$!this.prefix$n$!I'

     -- Check that button exists
     !toggleButtonIsOn = $!toggleButtonName$n.val.boolean()
     handle any

       if(!this.maxIndex.set() and !I lt !this.maxIndex) then

         -- This index is not in use
         skip
       else

          -- No more buttons
          break
       endif
     endhandle
     if(!I eq !clickButtonIndex) then

       $!toggleButtonName$n.val = true
       $!toggleButtonName$n.active = false
       !this.activeIndex = !I
     else

       $!toggleButtonName$n.val = false
       $!toggleButtonName$n.active = true
     endif
  enddo
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '$!this' + '.toggleRadioOn($!clickButtonIndex is Real)')
  endif
endmethod

define method .toggleRadioOff(!clickButtonIndex is Real)
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this' + '.toggleRadioOff($!clickButtonIndex is Real)')
  endif
  !toggleButtonName = '!this.form' + '.$!this.prefix$n$!clickButtonIndex'
  -- Check that button exists
  $!toggleButtonName$n.val = false
  $!toggleButtonName$n.active = true
  handle any
  endhandle
  -- When a radio button is turned off then all all buttons are off and there is no active button
--test 24/5/02  !this.lastActiveIndex = !this.activeIndex
  !this.activeIndex = 0
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '$!this' + '.toggleRadioOff($!clickButtonIndex is Real)')
  endif
endmethod

define method .restoreState() is Real
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this' + '.restoreState()')
  endif
-- When a radio button is turned off then all all buttons are off and there is no active button
  !lastActive = !this.lastActiveIndex
--  !this.toggleRadioOff(!this.activeIndex)
  if(!this.lastActiveIndex eq 0) then
  else
    !this.toggleRadioOn(!lastActive)
  endif
  !this.lastActiveIndex = !lastActive
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOutVal(1, '$!this' + '.restoreState()', '$!this.lastActiveIndex')
  endif
  -- returns the restored index
  return !this.lastActiveIndex
endmethod




-- End of file MdstoggleButtonRadio.obj
