-- Define Object
define object KCOLLECT

  -- Item to start collection from
  member .Search        is DBREF

  -- Classification for collection
  member .Class         is STRING

  -- Expression for collection
  member .Expression    is STRING

  -- Search Type for Collection routine
  member .Type          is STRING

-- End object
endobject

-- End of file kcollect.obj
