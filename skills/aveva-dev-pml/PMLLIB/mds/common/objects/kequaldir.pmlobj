-- Define Object
define object KEQUALDIR

  -- 1st Direction to check
  member .DirectionA    is DIRECTION

  -- 2nd Direction to check
  member .DirectionB    is DIRECTION

  -- Tolerance to work within
  member .Tolerance     is REAL

-- End object
endobject

-- End of file kequaldir.obj
