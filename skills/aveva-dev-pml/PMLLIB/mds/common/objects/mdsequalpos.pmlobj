-- Define Object
  define object mdsequalpos

-- 1st Position to check
    member .positiona    is position

-- 2nd Direction to check
    member .positionb    is position

-- Tolerance to work within
    member .tolerance    is REAL

-- End object
  endobject

-- End of file mdsequalpos.pmlobj
