-- Define Object
define object MDSFILES

  -- Dimensions default file
  member .Dimension is FILE

  -- Description default file
  member .Description is FILE

  -- Alternative Description file
  member .Altd is FILE

  -- Config file
  member .Config is FILE

  -- Alternative Description file
  member .Id is FILE

  -- Draft
  member .Draft is FILE

  -- Icons
  member .Icons is FILE

  -- Hangers Configuration file
  member .hangersConfigurations is FILE

-- End object
endobject

