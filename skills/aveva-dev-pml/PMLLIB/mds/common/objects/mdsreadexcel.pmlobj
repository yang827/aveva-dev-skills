--
--
-- Description:    Object for reading and writing data to and from Excel file.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getColumn(STRING)                ARRAY               Returns the passed column identifier
--  getRows()                        ARRAY
--  mdsReadExcel(FILE)               -                   Constructor
--  mdsReadExcel(STRING)             -
--  reread()                         -
--  string()                         STRING
--  writeToExcel()                   -
--
using namespace 'Aveva.Pdms.Presentation'
import 'GridControl'
handle ANY
endhandle

define object MDSREADEXCEL

	-- file
  member .file            is FILE

  -- grid data
  member .table           is ARRAY

  -- columns
  member .columnTags      is ARRAY

  member .dtm is DATETIME

endobject

------------------------------------------------------------------------
--
-- Method:      mdsReadExcel
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsReadExcel(!filename is FILE)

  -- Initialise Variables
  !this.table.clear()
  !this.columnTags.clear()

	if !filename.exists().not() then
		return
	endif

  !this.file        = !filename
  !this.dtm = !filename.dtm()
  !fullname         = !filename.fullname()

  -- Use the grid control (silently) to read the data source
  using namespace  'Aveva.Pdms.Presentation'
  !grid             = object NETGRIDCONTROL()
  !source           = object NETDATASOURCE('configFile', !fullname)
  !grid.bindToDataSource(!source)

  -- The grid control treats the first row as a heading row
  -- The rawTable does not included the first (heading) row
  !headings         = !grid.getColumns()

  !table            = ARRAY()
  do !i indices !headings
    !columns[!i]    = !headings[!i].upcase()
    !column         = !grid.getColumn(!headings[!i])
    !table[!i]      = !column
  enddo

  !this.columnTags  = !columns
  !this.table       = !table

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mdsReadExcel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsReadExcel(!filename is STRING)

	!this.mdsReadExcel(object FILE(!filename))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getColumn
--
-- Description: Returns the passed column identifier
--
-- Method Type:
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Column identifier
-- Return:
--   [Data Type] [Description]
--    ARRAY       Column data
--
------------------------------------------------------------------------

define method .getColumn(!columnTag is STRING) is ARRAY

  -- Initialise Variables
  !result = ARRAY()
  !index = !this.columnTags.findFirst(!columnTag.upcase())

  if !index.set() then
    !result = !this.table[!index]
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getRows() is ARRAY

	!rows = ARRAY()
	do !c indices !this.table[1]
		do !cc indices !this.table
			!rows[!c][!cc] = !this.table[!cc][!c]
		enddo
	enddo

	return !rows

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeExcel
--
-- Description: Save table to Excel file
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .writeToExcel()

  -- Use the grid control (silently) to read the data source
  using namespace  'Aveva.Pdms.Presentation'
  !grid = object NETGRIDCONTROL()
  !source = object NETDATASOURCE('configFile', !this.columnTags, !this.getRows())
  !grid.bindToDataSource(!source)
  !grid.saveGridToExcel(!this.file.fullname())

endmethod
-- End of method writeExcel

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reread()

	if !this.file.dtm().neq(!this.dtm) then
		!this.mdsReadExcel(!this.file)
	endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

	return !this.file.string()

endmethod
-- End of method
