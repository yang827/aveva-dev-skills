--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsreplace(string,string)        -
--  replace()                        -
--

define object mdsreplace
member .find is string
member .new is string

endobject

define method .mdsreplace(!find is string,!new is string)
!this.find = !find
!this.new = !new
!mem = !!ce.members
!this.replace()
if !mem.size() gt 0 then
 do !l values !mem
   !!ce = !l
   !this.replace()
 enddo
endif

endmethod


define method .replace()

  !attlist = attlist
  !test = array()
  do !a values !attlist
    !test.delete()
    !test = !!ce.$n$!a
    !!ce.$n$!a = !test
    handle any
     skip
    endhandle
    if (!test.objecttype() inset('BOOLEAN','ARRAY','REAL')) then
       skip
    endif
    if (!test.objecttype() inset('DBREF')) then
       !!ce.$!a = !!ce.$!a$n.name.replace(!this.find,!this.new).dbref()
       handle (2,109)
        skip
       endhandle
    endif

    !!ce.$!a = !!ce.$!a$n.replace(!this.find,!this.new)
    handle (2,759)(41,12)(2,791)(2,201)(2,779)
    endhandle
  enddo
endmethod
