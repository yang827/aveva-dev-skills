--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  diff(dateTime)                   Real
--  diff(dateTime,dateTime)          Real
--  getElapsedTime()                 Real
--  getTime()                        DateTime
--  mdsTime()                        -
--  mdsTime(DateTime)                -
--  mdsTime(MdsTime)                 -
--  setTime(DateTime)                -
--  setTime(MdsTime)                 -
--  toSeconds(dateTime)              Real
--

$(
-- create an object with the current time
!oMdsTime = object mdstime()
-- Do some jobs...
-- and check elapsed time
!elapsedTime = !oMdsTime.getElapsedTime()
$)

define object MdsTime
  member .created is datetime
  member .lastCalled is datetime
  member .setTime is datetime
endobject


define method .mdsTime()
   !this.created = object datetime()
   !this.lastCalled = !this.created
   !this.setTime = !this.created
endmethod

define method .mdsTime(!MdsTime is MdsTime)
   !this.MdsTime()
   !this.setTime(!MdsTime)
endmethod

define method .mdsTime(!dateTime is DateTime)
   !this.MdsTime()
   !this.setTime(!dateTime)
endmethod

define method .setTime(!MdsTime is MdsTime)
   !this.setTime = !MdsTime.getTime()
endmethod

define method .setTime(!dateTime is DateTime)
   !this.setTime = !dateTime
endmethod



define method .getElapsedTime() is Real
   !nowDateTime = object DateTime()
   !nowSeconds = !this.toSeconds(!nowDateTime)
   !lastSeconds = !this.toSeconds(!this.lastcalled)
   !this.lastcalled = !nowDateTime
   !elapsed = !nowSeconds - !lastSeconds
   return !elapsed
endmethod


define method .toSeconds(!dateTime is dateTime) is Real
   !seconds = 3600 * !dateTime.hour() + 60 * !dateTime.minute() + !dateTime.second()
   return !seconds
endmethod


define method .diff(!dateTime is dateTime) is Real
   !createdTime = !this.toSeconds(!this.created)
   !inputTime = !this.toSeconds(!dateTime)
   !diff = !inputTime - !createdTime
   return !diff
endmethod

define method .diff(!dateTimeA is dateTime, !dateTimeB is dateTime) is Real
   !timeA = !this.toSeconds(!dateTimeA)
   !timeB = !this.toSeconds(!dateTimeB)
   !diff = !timeA - !timeB
   return !diff
endmethod

define method .getTime() is DateTime
  return !this.setTime
endmethod
