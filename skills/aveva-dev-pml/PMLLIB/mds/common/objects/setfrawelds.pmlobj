------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applywelds()                     -
--  getsections()                    -
--  setfrawelds()                    -
--
define object setfrawelds

member .sections is ARRAY
member .zones is ARRAY
member .weld is mdsweld
member .masterweld is mdsweld
member .areaname is STRING
member .source is dbref

endobject

------------------------------------------------------------------------
define method .setfrawelds()
  !this.source = /MDS/SCTN/WELDS
  !this.masterweld = object mdsweld(/MDS/STD/WELDS/FW/FILLET/ALL/ROUND )
  !this.getsections()
  !this.applywelds()
endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .getsections()
  var !sctn coll all sctn for /MDS/FRA/STEELWORK
  !this.sections = !sctn
endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .applywelds()

do !a values !this.sections
  !this.createarea(!a.dbref().owner)
  !!ce = !a.dbref()
  :mdswelddata unset
  !this.setweld(!!ce,'S')
  !!ce = !a.dbref()
  if !!ce.joie.unset() then
    !this.setweld(!!ce,'E')
  endif
enddo

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
 define method .setweld(!section is dbref,!end is STRING )

    -- !this.weld.tagtext = !this.getweldsize(!section).string()
    !this.weld = !this.masterweld
    !this.weld.tagtext = !this.getweldsize(!section).string()
    !this.weld.designitem = !section
    !this.weld.wpurp = 'SCTN'
    !this.weld.areaname = !this.areaname
    if !end eq 'S' then
       !this.weld.name = !this.weld.designitem.name & '/WELD1'
       !this.weld.start = 'NA,START'
    else
       !this.weld.name = !this.weld.designitem.name & '/WELD2'
       !this.weld.start = 'NA,END'
    endif
    !this.weld.createdesweld(false,!this.weld.name,'SCTN' )
    !this.weld.addweldtosctn()

 endmethod
 --------------------------------------------------------------------------

 --------------------------------------------------------------------------
 -- method to look at the section size and return the weldsize
 define method .getweldsize(!section is dbref)is real

!catref = !section.catref.name


if !catref eq '/FRA-M1AA' then
    return 6
elseif !catref eq '/FRA-M1BA' then
    return 6
elseif !catref eq '/FRA-M1CA' then
    return 7
elseif !catref eq '/FRA-M1DA' then
    return 9
elseif !catref eq '/FRA-M1EA' then
    return 9
elseif !catref eq '/FRA-M1FA' then
    return 9
elseif !catref eq '/FRA-M1GA' then
    return 9
elseif !catref eq '/FRA-M1IA' then
    return 10
elseif !catref eq '/FRA-M1XA' then
    return 5
elseif !catref eq '/FRA-M1YA' then
    return 4
elseif !catref eq '/FRA-M1ZA' then
    return 5
elseif !catref eq '/FRA-O1A' then
    return 6
elseif !catref eq '/FRA-O1B' then
    return 6
elseif !catref eq '/FRA-O1C' then
    return 7
elseif !catref eq '/FRA-O1D' then
    return 9
elseif !catref eq '/FRA-O1E' then
    return 9
elseif !catref eq '/FRA-O1F' then
    return 9
elseif !catref eq '/FRA-O1G' then
    return 9
elseif !catref eq '/FRA-O1I' then
    return 10
elseif !catref eq '/FRA-O1X' then
    return 4
elseif !catref eq '/FRA-O1Y' then
    return 4
elseif !catref eq '/FRA-O1Z' then
    return 5
elseif !catref eq '/FRA-X1AA' then
    return 6
elseif !catref eq '/FRA-X1BA' then
    return 6
elseif !catref eq '/FRA-X1CA' then
    return 7
elseif !catref eq '/FRA-X1DA' then
    return 9
elseif !catref eq '/FRA-X1EA' then
    return 9
elseif !catref eq '/FRA-X1FA' then
    return 9
elseif !catref eq '/FRA-X1GA' then
    return 9
elseif !catref eq '/FRA-X1IA' then
    return 10
elseif !catref eq '/FRA-X1XA' then
    return 5
elseif !catref eq '/FRA-X1YA' then
    return 5
elseif !catref eq '/FRA-X1ZA' then
    return 7
elseif !catref eq '/FRA-X2UA' then
    return 6
elseif !catref eq '/FRA-X2VA' then
    return 6
elseif !catref eq '/FRA-X3AA' then
    return 4
elseif !catref eq '/FRA-X3FA' then
    return 6
elseif !catref eq '/FRA-X3WA' then
    return 5
elseif !catref eq '/FRA-X3ZA' then
    return 7
elseif !catref eq '/FRA-X4AA' then
    return 8
elseif !catref eq '/FRA-X4CA' then
    return 10
elseif !catref eq '/FRA-X4FA' then
    return 13
endif

endmethod

 --------------------------------------------------------------------------
 define method .createarea(!frmwk is dbref)

   !this.areaname = !frmwk.name.replace('/MDS/','/DDAR-')
   !!ce = !this.areaname.dbref()
   handle ANY
    !!ce = !this.source
    new ddar $!this.areaname
   endhandle


 endmethod
 --------------------------------------------------------------------------
