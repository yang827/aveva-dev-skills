--  ===========                      ======              ===========
--  output(string)                   -
--  replace(string,string)           -
--  swapeyerods()                    -
--
define object swapeyerods
   member .rods is array
   member .lengths is array
   member .heights is array
   member .thlb is array
   member .rinb is array
   member .catrefs is array
   member .sprefs is array
   member .bores is array
   member .inserts is array

endobject


define method .swapeyerods()
var !a coll all eyrd
!this.rods = !a
var !hei eval heig for all from !a
!this.heights = !hei
!insert = array()
!olen = array()
var !thlb eval prop thlb for all from !a
!this.thlb = !thlb
var !rinb eval prop rinb for all from !a
!this.rinb = !rinb
var !bores eval p1 bore for all from !a
!this.bores = !bores
var !catrefs eval catref for all from !a
!this.catrefs = !catrefs
var !sprefs eval spref for all from !a
!this.sprefs = !sprefs
do !rod values !a
  !!ce = !rod.dbref()
  !insert.append(!!ce.desp[1])
  var !len const dist p1 to p11
  !olen.append(!len)
enddo

!this.inserts = !insert
!this.lengths = !olen
endmethod

define method .output(!file is string)

!outfile = object file(!file)
!output = array()
do !a index !this.rods
  !output.append(!this.rods[!a] & ' ' & !this.sprefs[!a] & ' ' & !this.catrefs[!a] & ' ' & !this.bores[!a] & ' ' & !this.lengths[!a] & ' ' & !this.inserts[!a] )
enddo

!outfile.writefile('OVER',!output)

endmethod

define method .replace(!start is string,!replace is string)
  !this.output('c:\temp\old')
  do !a values !this.rods
    !!ce = !a.dbref()
    !spref = !!ce.spref.name
    !newname = !spref.replace(!start,!replace)
    spref $!newname
    handle any
      $p could not replace $!spref with $!newname for $!a
    endhandle
  enddo
  !this.output('c:\temp\new')

endmethod
