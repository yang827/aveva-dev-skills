--
-- File:		MDSPrint.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FFRAME
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Form Definition for Frameworks
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MDSPrint

-- Define Form
Setup Form !!MDSPrint

  !!MDSPrint.formtitle    = |WitchHanger Print         |
  !!MDSPrint.icontitle    = ||
  !!MDSPrint.callback     = |!this.init()|
  !!MDSPrint.formrevision = ||

  list .Supports |Supports:| at x0 Y0.5 multi width 50 length 10

-- Bottom Line

  button .Ok     | Apply | at x0 ymax call |!this.SendTo()|

  button .Cancel | Dismiss | at xmax form-size ymin cancel

-- End form definition
exit

define method .init()

  var !coll coll all atta with (match(name of spref,'/MDS/MH01') gt 0)

  var !names eval namn for all from !coll
  !names.sort()
  !this.supports.dtext = !names

  if !!MDSHangIf.upcase().eq('CPL') then
    !this.formtitle = 'WitchHanger Print'
  elseif !!MDSHangIf.upcase().eq('PSL') then
    !this.formtitle = 'PSDesigner Print'
  elseif !!MDSHangIf.upcase().eq('LISEGA') then
    !this.formtitle = 'Licad Print'
  endif

endmethod

define method .SendTo()

  if !this.supports.val.size().eq(0) then
    !!Alert.Error('Nothing selected to print')
    return
  endif

  !listofsupports = !this.supports.val
  !filename = object file('%pdmswk%\PrintTo.dat')
  !printlist = ARRAY()
  do !list values !listofsupports
    !Printlist.append(!this.supports.dtext[!list])
  enddo
  !filename.writefile('OVERWRITE',!printlist)
  !filename.close()

  if !!MdsCpldb.db.eq('') or !!MdsCpldb.db.unset() then
    var !Cplmdsexe evar cplmdsexe
    !!MdsCplDb.type = 'PRINT'
    !!MdsCplDb.init('$!Cplmdsexe','xxx','xxx')
  else
    SYSCOM |"$!!MdsCpldb.exe" /MDS /PRINT:%pdmswk%\PrintTo.dat /PD:$!!mdscpldb.db|
  endif

endmethod

-- End of file MDSPrint.pmlfrm
