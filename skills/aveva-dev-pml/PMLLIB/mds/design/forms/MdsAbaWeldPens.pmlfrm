--
-- File: MdsAbaWeldPens.pmlfrm
--   Type: Form Definition
--   Group: MDS ABA Automatic support fabrication drawings
--     Keyword: ABA
--   Module: Draft
--   Replaces:
--
-- Author: Tony Martin
-- Created: Friday 24th May 2002
--
--
-- Description:
-- Form Definition for Selecting the MDS ABA View Task Label Pen Options
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!mdsabaweldpens

-- Define Form
  setup form  !!mdsabaweldpens blocking

    !!mdsabaweldpens.formtitle = |Weld Label Attributes|
    !!mdsabaweldpens.icontitle = |MDSABAVLabs|
    !!mdsabaweldpens.callback  = |!this.init()|

-- Main Frame
    frame .frame ' Label Pen Options ' width 20
      path down

-- Form Gadget Definitions
--     option .local at x1 ymax+0.5 'Label Text Position '  width 10
--
      frame .frame2 ' Line Options '
        toggle .llea 'Leader Line                  '
---------------------------------------------
--<wd>28mar2008 -- DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--        toggle .fram 'Text Frame                   '
        toggle .fram 'Label Frame                  '
      exit
--      text   .tpen at x1 ymax+0.5 'Text Pen            '  width 11 is REAL
--      text   .dtfn 'Text Font           ' width 11 is REAL
--      text   .llpn 'Leader Line Pen     ' width 11 is REAL
--      text   .frpn 'Text Box Pen        ' width 11 is REAL
--      text   .tesi 'Terminator Size     ' width 11 is REAL
--      text   .chei 'Character Height    ' width 11 is REAL

      text   .lafo at x1 ymax+0.5 'Label Font          '  width 11 is REAL
      text   .laco 'Label Colour        ' width 11 is REAL
      text   .lasi 'Label Font Size     ' width 11 is REAL format !!distancefmt
      text   .llst 'Leader Line Style   ' width 11 is STRING
      text   .llco 'Leader Line Colour  ' width 11 is REAL
      text   .lfst 'Label Frame Style   ' width 11 is STRING
      text   .lfco 'Label Frame Colour  ' width 11 is REAL
      text   .scal 'Symbol Scale        ' width 11 is REAL
      text   .xoff 'Symbol X Offset     ' width 11 is REAL format !!distancefmt
      text   .yoff 'Symbol Y Offset     ' width 11 is REAL format !!distancefmt
      text   .tesi 'Terminator Size     ' width 11 is REAL format !!distancefmt
      option .dterm at xmin ymax+0.5 'Terminators         ' width 10
--
--<wd>28mar2008 -- DUN824 - Defect No. P-4526
---------------------------------------------
    exit

-- Bottom Line
    button .cancel | Cancel | at xmax form-size ymax+0.5 cancel
    button .ok     |   OK   | at x0 ymin call |!this.write()| ok

-- Form members
    member .settings is STRING
    member .current  is REAL
    member .toggle   is BOOLEAN

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()

-- Set the .local option dtext
--    !dtext[1] = 'Local'
--    !dtext[2] = 'Legend'
--    !this.local.dtext = !dtext

-- Set the .dterm option dtext
    !dtext = ARRAY()
    !dtext[1] = 'Obliques'
    !dtext[2] = 'Arrows'
    !dtext[3] = 'Dots'
    !dtext[4] = 'Off'
    !this.dterm.dtext = !dtext

-- q var !this.settings

-- Get the Task Parameter Values into an array
    !values = !this.settings.split(',')

---------------------------------------------
--<wd>28mar2008 -- DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Set this Label Attibutes Form with the Stored Values at the View Task
--     !this.toggle   = !values[1].boolean()
--     !this.llea.val = !values[2].boolean()
--     !this.fram.val = !values[3].boolean()
--     !this.tpen.val = !values[4].real()
--     !this.dtfn.val = !values[5].real()
--     !this.llpn.val = !values[6].real()
--     !this.frpn.val = !values[7].real()
--     !this.tesi.val = !values[8].real()
--     !this.chei.val = !values[9].real()
--     !this.scal.val = !values[10].real()
--     !this.xoff.val = !values[11].real()
--     !this.yoff.val = !values[12].real()
--     !this.dterm.select('rtext',!values[13])
--     handle any
--     endhandle
--
-- Set the Label Attibutes Form with the Stored Values at the View Task
-- Weld Labels Toggle
    !this.toggle = !values[1].boolean()

-- Weld Label Attributes
-- Label Leader Line Toggle
    !this.llea.val = !values[2].boolean()

-- Label Frame Toggle
    !this.fram.val = !values[3].boolean()

-- Label Font, Colour and Size
    !this.lafo.val = !values[4].real()
    !this.laco.val = !values[5].real()
    !this.lasi.val = !values[6].real()

-- Label Leader Line Style and Colour
    !this.llst.val = !values[7].string()
    !this.llco.val = !values[8].real()

-- Labe Frame Line Style and Colour
    !this.lfst.val = !values[9].string()
    !this.lfco.val = !values[10].real()

-- Weld Symbol Scale, X and Y Offsets
    !this.scal.val = !values[11].real()
    !this.xoff.val = !values[12].real()
    !this.yoff.val = !values[13].real()

-- Label Leader Line Terminator Size and Type
    !this.tesi.val   = !values[14].real()
    !this.dterm.select('rtext',!values[15])
    handle any
    endhandle
--
--<wd>28mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

  endmethod
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .write()

---------------------------------------------
--<wd>28mar2008 -- DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Compose the Task TPVAL attribute values
--     !return = !this.toggle.string() & ',' & !this.llea.val & ',' & !this.fram.val & ',' & !this.tpen.val & ','  $
--     & !this.dtfn.val & ',' & !this.llpn.val & ',' & !this.frpn.val & ',' & $
--     !this.tesi.val & ',' &  !this.chei.val & ',' & !this.scal.val & ','  & !this.xoff.val & ',' & $
--     !this.yoff.val & ',' & !this.dterm.selection()
--
-- Compose the Task TPVAL attribute values
    !return = !this.toggle.string() & ',' & !this.llea.val & ',' & !this.fram.val & ',' & !this.lafo.val & ',' & $
    !this.laco.val & ',' & !this.lasi.val & ',' & !this.llst.val & ',' &  !this.llco.val & ',' &  !this.lfst.val & ',' & $
    !this.lfco.val & ',' & !this.scal.val & ','  & !this.xoff.val & ',' & !this.yoff.val & ',' & $
    !this.tesi.val & ',' & !this.dterm.selection()
--
--<wd>28mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Store the Task TPVAL values in the main task form member '.subtasks'
    !!mdsabaviewtask.subtasks[!this.current] = !return

  endmethod

