--
-- Description:
-- Form Definition for selecting ALL ancillary items found in dimensions default file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearwelddisplay()               -
--  createweld()                     -
--  deleteweld()                     -
--  editweld()                       -
--  getbores()                       -
--  getframewelds()                  -
--  getppoints()                     -
--  getstdsupports()                 -
--  init()                           -
--  modifyTitle()                    -
--  saveedits()                      -
--  selectweld()                     -
--
setup form !!mdsancilwelds


  !!mdsancilwelds.formtitle    = |Ancillary Weld Selection|
  !!mdsancilwelds.icontitle    = ||
  !!mdsancilwelds.callback     = |!this.init()|
  !!mdsancilwelds.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  list .standard   |All Types                                  | at xmin ymax+0.3 call |!this.getppoints()| width 40 length 10
  list .ppointlist |Weld PPoints| at xmax+0.5 ymin multiple width 10 height 10
  list .welds      |Welds|    at xmax+0.5 ymin call '!this.selectweld()' width 10 height 10
  path down
  vdist 1
  frame .additional 'Weld Data'  at xmin.standard ymax width 70
    button .selstd  | Create Weld.. | at xmin+2  ymin+1 call |!this.createweld()|
    --button .modweld | Modify Weld.. | at xmax+4 ymin call |!this.editweld()|
    button .delweld | Delete Weld | at xmax+4 ymin call |!this.deleteweld()|
    button .showstd | View Standard.. | at xmax+4 ymin call |!!mdsAddPlot(!this.standard,'SHOW',!this)|
    path down
    vdist 0
    text .dtsen    '  Weld name:' at xmin.additional+1 ymax+0.4 call '!this.modname()' width 55 is STRING
    text .symbol   'Symbol Name:' at xmin ymax width 55 is STRING
    text .desc     'Description:' at xmin ymax width 55 is STRING
    text .tagtext  '   Tag Text:' at xmin ymax width 55 is STRING
    text .ppoint   '    PPoints:' at xmin ymax width 55 is STRING
    button .save ' Save ' at xmin.ppoint ymax+0.3  call '!this.saveedits()'
  exit
  -- Bottom Line
  button .cancel | Dismiss | at xmax form-8 ok

  -- Members
  member .sizes is ARRAY
  member .weldlist is MDSWELDLIST
  member .currentstd is MDSWELD
  member .replacement  is STRING
  member .suppfunction is STRING
  member .suppform is FORM
  member .error is BOOLEAN
  member .emess is STRING

  -- End form definition
exit

-- load ALL ancillary types
-- for user to select the standard he wants to modify
-------------------------------------------------------------------------------------------
define method .init()

  -- populate the list of available standards
  !this.getstdsupports()

  -- fill in the ppoint list
  !this.getppoints()

  -- populate the list of available welds
  !this.selectweld()

  -- Modify title to include
  !this.modifyTitle()

  -- Deactivate required gadgets
  !this.dtsen.active = FALSE
  !this.symbol.active = FALSE
  !this.desc.active = FALSE
  !this.ppoint.active = FALSE

endmethod
-------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to look at the existing standard and get the welds associated with it

define method .selectweld()

  if !this.welds.selection().eq('None Found') then
    return
  endif
  -- we have found a proper weld, now we need to decide what to do with it
  !!ce = !this.welds.selection('Rtext').dbref()
  !weld = object MDSWELD(!!ce)
  !this.currentstd = !weld
  !weld.fillform(!this)


endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to write the changes to the database for a section weld
define method .saveedits()
  -- check to make sure that all the values have been set
  if !this.tagtext.val eq '' then
    if !!alert.confirm('Weld size is unset - Do you want to continue?').eq('NO') then
      return
    endif
  endif

  !this.currentstd.tagtext = !this.tagtext.val
  !this.currentstd.wpurp = 'ANCI'
  !this.currentstd.areaname = '/DDAR-' & !this.standard.selection()
  -- q var !this.currentstd.areaname
  -- set the design item for the current weld
  -- !this.currentstd.designitem = !this.standard.selection().dbref()
  !this.currentstd.name = !this.dtsen.val
  !this.currentstd.ppointstring      = !this.ppoint.val
  !this.currentstd.startptype = 'LOC'
  !this.currentstd.createdataset('ANCIL')
  !this.getppoints()
  !this.selectweld()


endmethod
--------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to get welds from the standard list and create a new one
-- shows the mdsstdwelds form to get a new standard
-- returns a mdsweld object with the standard weld data
-- replaces the currentweld object
-- or maybe an editobject to be merged
--------------------------------------------------------------------------------------------
define method .createweld()

  if !this.ppointlist.selection().size().eq(0) then
    !!alert.error('No PPoints Selected - You must select at least 1 PPoint')
    return
  endif

  !!mdsnewweld.form = !this
  !!mdsnewweld.context = 'NEW'
  show !!mdsnewweld
  --!!mdsstdwelds.form = !this
  --!!mdsstdwelds.context = 'NEW'

  --show !!mdsstdwelds

endmethod

-------------------------------------------------------------------------------------------
-- method to show the edit weld form
--- may not be used?
define method .editweld()

  show !!mdsmodifydesweld

endmethod
------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to delete the selected weld
--
define method .deleteweld()

  !!ce = !this.welds.selection().dbref()
  handle ANY
    !!alert.error('No Welds Selected')
    return
  endhandle

  if !!alert.confirm('Do you want to Delete this weld $!!ce.name') eq 'YES' then
    delete ddse
  endif
  --!this.selectweld()
  !this.clearwelddisplay()
  !this.getppoints()

endmethod
------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------
-- clears the bottom paragraph gadgets when there is no current weld
define method .clearwelddisplay()

  !this.dtsen.val   = ''
  !this.symbol.val  = ''
  !this.desc.val    = ''
  !this.tagtext.val = ''
  !this.ppoint.val  = ''

endmethod
---------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------
-- method to go to the atta standard and find all the ppoints used for welds
define method .getppoints()

  -- save the current element
  !current = !!ce

  -- change the standard display form if shown
  if !!mdsshowplot.shown() then
    !!mdsAddPlot(!this.standard,'SHOW',!this)
  endif

  -- Reset form title

  !this.modifyTitle()

  -- get the standard eg. AT81
  !selection = !this.standard.selection()
  -- get prtef
  /PTSE-$!<selection>
  handle ANY
    !weldarray = ARRAY()
  elsehandle NONE
    !ptref = !!ce
    -- get the ppoints with purp of mweld
    var !ppoints coll all ptca with purp eq 'MWEL' and number gt 300 for $!ptref
    var !numbers eval number for all from !ppoints
    var !unusedheights eval pheight for all from !ppoints
    !weldarray = ARRAY()
    do !a index !ppoints
      !weldarray.append(!numbers[!a].string())
    enddo
  endhandle
  if !weldarray.size().eq(0) then
    !weldarray[1] = 'None Found'
    !this.welds.dtext = !weldarray
    !this.ppointlist.dtext = !weldarray
    !this.clearwelddisplay()
    !!ce = !current
    return
  endif

  -- set the list gadget with the appropriate ppoints
  !this.ppointlist.dtext = !weldarray
  -- now see if there are any welds
  -- get attas
  /DDAR-$!<selection>
  handle ANY
    -- no welds yet defined
    !array[1] = 'None Found'
    !this.welds.dtext = !array
    !!ce = !current
    return
  endhandle

  -- we now have a list of datasets for welds
  !weldlist = object MDSWELDLIST(!!ce,'STD')
  !this.weldlist = !weldlist
  !this.weldlist.currentweld = !this.weldlist.welds[1]
  handle ANY
    !array[1] = 'None Found'
    !this.welds.dtext = !array
    !!ce = !current
    return
  endhandle
  !this.currentstd = !this.weldlist.currentweld
  --q var !this.weldlist.welds[1]
  do !a index !this.weldlist.welds
    !array[!a] = 'WELD $!a'
    !rarray[!a] = !this.weldlist.welds[!a].name
  enddo
  !this.welds.dtext = !array
  handle ANY
    !array[1] = 'None'
    !this.welds.dtext = !array
  elsehandle NONE
    !this.welds.rtext = !rarray
  endhandle

  -- now we have a weld object which should have the ppoints set
  do !a values !this.currentstd.ppoints
    !this.ppointlist.select('dtext','$!a')
  enddo

  !this.selectweld()

  -- return to the current element
  !!ce = !current
endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
-- method to get the frame welds based on the selected standard
define method .getframewelds()

  -- get the standard name and all of the templates associated with it
  -- get the welds for the design standard

endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
-- method to get the range of bore sizes for each category of attas
define method .getbores()

  -- save the current element
  !current = !!ce
  !selection = !this.standard.selection()
  -- get attas
  /ATTA-$!<selection>
  !unusedcate = !!ce
  var !a coll all scom for ce
  var !b eval param 1 for all from !a
  !b.unique()
  -- turn string values into reals to sort
  !block1 = object BLOCK('!b[!evalindex].real()')
  !c = !b.evaluate(!block1)
  !c.sort()
  -- turn sorted list back to strings to put them into the list gadget
  !block2 = object BLOCK('!c[!evalindex].string()')
  !b = !c.evaluate(!block2)
  !this.bores.dtext = !b
  -- return to the current element
  !!ce = !current

endmethod
-------------------------------------------------------------------------------------------

