!pref.append('ST56')       $* Stop for pipe
!pref.append('ST57')       $* Stop for pipe
!pref.append('ST58')       $* Stop for pipe
!pref.append('ST59')       $* Adjustable Stop for pipe

-- All Slip Units and Shims added to the list available on MDS Frameworks
!pref.append('SU')         $* Slip units for Pipe Shoes

-----------------------------------------------------------------------

!pref.append('LT')         $* Lugs/Riser-Clamps
!pref.append('AN')         $* Anchors            (based on selected attachments)
--!pref.append('SPECIAL')    $* Specials
!pref.append('CA')         $* Cable Tray Ancillaries
$)
  -- populate list with required attachments
  --!!mdsReaddefs(!!mdsancilwelds,!pref)
  -- Collect all available standards


  -- Determine the MDS ANCILLARIES where :MDSACTIVE is TRUE for each SECTION element in the PARAGON /MDS/ATTA/DEFAULTS Catalogue
  !ctype = |SECTION|
  !scope = /MDS/ATTA/DEFAULTS
  !filtr = object EXPRESSION(|:mdsactive eq TRUE|)
  -- Collect ALL of the SECTION Elements
  !sect  = object COLLECTION()
  !sect.filter(!filtr)
  !sect.scope(!scope)
  !sect.type(!ctype)
  -- SECTION Collection Results Array
  !sectresults = !sect.results()

  -- Determine the MDS ANCILLARY types to LOAD into the !!mdsAllAncill form
  !mdsstds = ARRAY()
  do !vald value !sectresults
    if (!vald.description.matchwild('AC*')) then
      skip
    elseif (!vald.description.matchwild('MH*')) then
      skip
    elseif (!vald.description.matchwild('BR*')) then
      skip
    elseif (!vald.description.matchwild('SP03*')) then
      skip
    elseif (!vald.description.unset()) or (!vald.description.trim().eq('')) then
      skip
    else
      !mdsstds.append(!vald)
    endif
  enddo

  -- Remove any Duplicate Entries in the ARRAY
  !mdsstds.unique()

  -- SORT ARRAY into ALPHABETICAL and NUMBER order
  !sindices = !mdsstds.sortedindices()
  !mdsstds.reindex(!sindices)

  --$P-----------------------
  --$P q var !mdsstds.size()
  --q var !mdsstds.size()
  --$P-----------------------

  -- Load the form list gadget !!mdsAllAncill.standard with the ACTIVE MDS ANCILLARY SUPPORT types
  -- ABORT MDS Application and FORM list gadget LOADING if the ARRAY !mdsstds is EMPTY
  if (!mdsstds.empty()) then
    -- ???ABORT MDS Loading??? - Default ERROR and Message set in loading of the FORM !!mdsAllAncill
    return
  else
    !unusedMdsloadAncDefs = object MDSLOADSTDDEFS(!this, !mdsstds)
    if (!this.error) then
      !!alert.error('error in compiling ancillary list')
      return
    endif
  endif
  -- <RM> 25/06/09 upgraded the original code to work in the 12 environment - end

  !size = !!mdsancilwelds.standard.dtext.size()
  !!mdsancilwelds.standard.tag = 'Available Types = $!size'

endmethod
------------------------------------------------------------------------------------------------------

define method .modifyTitle()

  -- Title string to be "Ancillary Weld Selection (Project Standard/MDS Standard)"

  !selecteddtext = !this.standard.dtext[!this.standard.val]
  !selectedrtext = !this.standard.rtext[!this.standard.val]

  !projectstd    = !selecteddtext.before('-').trim()
  !mdsstd        = !selectedrtext

  !this.formtitle = 'Ancillary Weld Selection ( $!projectstd / $!mdsstd )'

endmethod
