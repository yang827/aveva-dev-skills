-- Revision:
--
-- Description:
-- FANP specific creation/modification form for MDS Reference Dimensions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  AttaSelect()                     -                   Select Atta from list
--  addrembench(string,string)       -
--  attace()                         -
--  benchce()                        -
--  benchmark()                      -
--  close()                          -                   close form
--  enhance()                        -
--  initialise()                     -                   initialisation
--  limits(DBREF)                    -                   set view limits to passed element
--  mdsbenches()                     -
--  refresh()                        -                   refresh form with latest Atta
--  rooms(BOOLEAN)                   -                   add rooms to drawlist
--  setbenches(string)               -
--  sfilter()                        -                   filter Attas by :MMSSTATUS
--  showbenchmarks(BOOLEAN)          -
--

setup form !!mdsbenches

  !this.formTitle     = 'FANP MDS Benchmark Reference'
  !this.iconTitle     = 'Benchmarks'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.close()'

  -- Body of form definition
  path down

  frame .attaFrame  'MDS Supports'

    list   .MDSattas ''              at xmin +1  ymax   call '!this.AttaSelect()'  width 21 height 12
    para   .nf text  'Name Filter:'                                                width 21 lines 1
    text   .filter   ''              at xmin ymax+0.1   call '!this.refresh()'     width 21 STRING
    para   .sp text  'Status Filter:'                                              width 14 lines 1
    option .SOfilter ''              at xmin ymax       call '!this.sfilter()'     width 2
    option .Sfilter  ''              at xmax ymin       call '!this.sfilter()'     width 5
    para   .pc                       at xmin.sp text ''                            width 20 lines 1
    button .attace   'Select CE'                        call '!this.attace()'

  exit

  path right

  frame .benchFrame 'Benchmarks'

     list .benchmarks 'Available Benchmarks' at xmin+1  ymin+1             call '!this.benchmark()'  width 18 height 12

     button .adde  'Add East ' at xmax+2 ymin+.5 tooltip 'Add Selected'    call '!this.addrembench(|ADD|, |EAST|)'
     button .reme  'Rem East ' at xmin ymin+1    tooltip 'Remove Selected' call '!this.addrembench(|REMSELE|, |EAST|)'

     button .aalle ' Add E/N ' at xmin ymin+2    tooltip 'Add E/N'         call '!this.addrembench(|ADD|, |EASTNORTH|)'
     button .ralln ' Rem E/N ' at xmin ymin+1    tooltip 'Remove All'      call '!this.addrembench(|REMALL|, ||)'

     button .addn  'Add North' at xmin.aalle ymin+2 tooltip 'Add Selected' call '!this.addrembench(|ADD|, |NORTH|)'
     button .remn  'Rem North' at xmin ymin+1    tooltip 'Remove Selected' call '!this.addrembench(|REMSELE|, |NORTH|)'

     list .setbenchese 'Benches Set East'  at xmax+3 ymin.benchmarks                         width 18 height 4
     list .setbenchesn 'Benches Set North' at xmin.setbenchese ymax.setbenchese width 18 height 4

     button .benchce 'Select CE'     at xmin.benchmarks ymax.benchmarks    call '!this.benchce()'
     button .enhance 'Show Coloured' at xmin.setbenchesn ymax.benchmarks   call '!this.enhance()'
  exit

  path down
  para   .RoomsP     at xmin.benchmarks +3 ymax.benchmarks + 3 text 'Rooms' width 6 lines 1
  path right
  button .RoomsAdd   '+' tooltip 'Add All Rooms for Atta'         at xmax+5.2 ymin      call '!this.rooms(TRUE)'
  button .RoomsRem   '-' tooltip 'Remove All Rooms from Drawlist' at xmax+0.2 ymin      call '!this.rooms(FALSE)'

  para   .BenchP     at at xmin.RoomsP ymax text 'Benchmarks'  width 11 lines 1
  button .BenchAdd   '+' tooltip 'Add All Benchmarks for Atta'         at xmax+0.2 ymin call '!this.showbenchmarks(TRUE)'
  button .BenchRem   '-' tooltip 'Remove All Benchmarks from Drawlist' at xmax+0.2 ymin call '!this.showbenchmarks(FALSE)'


  button .dismiss 'Dismiss' at xmax form-size ymax form - 1  call '!this.hide()'

  member .filteredAttas is ARRAY
  member .avbenchmarks is ARRAY


exit

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mdsbenches()

  !this.filter.val = '*'
  !this.pc.val = 'Attas: '
  !this.Sfilter.dtext = split('All')
  !this.SOfilter.dtext = split('< <= = => >')
  !this.SOfilter.rtext = split('LT LEQ EQ GEQ GT')
  !this.SoFilter.val = 3

  pml load form !!splupdate
  pml load form !!fanpSpoolerOptions
  pml load form !!fanpReportForm


endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !filter = !this.filter.val

-- collect all Hangers and Standalone Ancillaries without Preliminary
   var !hangers   collect all atta with (matchw(name ,'*BQ*P') and not matchw(name of spref, '/MDP*') and matchwild(name,'$!filter'))
-- collect all Frame Supports (Multi / Single)
   var !framesupp collect all atta with matchw(name ,'*BQ*P/DATUM')    and matchwild(name,'$!filter')
-- colect all  Support Group Masters
   var !suppgroup collect all atta with matchw(name ,'*BQ*P[1]/DATUM') and matchwild(name,'$!filter')

  !attas = ARRAY()
  !attas.appendarray(!hangers)
  !attas.appendarray(!framesupp)
  !attas.appendarray(!suppgroup)


  var !attaNames evaluate namn for all from !attas

  !this.MDSattas.dtext = !attaNames
  !this.MDSattas.rtext = !attas

  !this.filteredAttas = !attas

  var !status eval (:MMSSTATUS) for all from !attas
    handle ANY
      var !status eval (:STATUS) for all from !attas
    endhandle
  !status = !status.sortunique()
  !statusFilter = split('All')
  !statusFilter.appendArray(!status)
  !this.sFilter.dtext = !statusFilter

  !count = !this.MDSattas.dtext.size()
  !this.pc.val = 'Attas: $!count'

endmethod

------------------------------------------------------------------------
--
-- Method:      attace
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .attace()

   atta
   handle(2,111)
      !!alert.message('Not at an Support')
      return
   endhandle

   !this.MDSattas.val = !this.MDSattas.dtext.findfirst(!!ce.fullname.substring(2))
   handle(61,620)
      !!alert.message('Atta is a MDS Support')
      return
   endhandle

   !this.attaselect()

endmethod
------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: refresh form with latest Atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()
  !this.initialise()
endmethod

------------------------------------------------------------------------
--
-- Method:      rooms
--
-- Description: add rooms to drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rooms(!add is BOOLEAN)

  -- check if we are adding rooms or removing them
  if (!add.not()) then
    remove all STRU with (matchwild(name of site,'*-----L'))
    do !x from 10 to 20
      aid clear text $!x
      handle any
      endhandle
    enddo
    return
  endif

  if (!this.MDSattas.val.eq(0)) then
    !!alert.message('No Attas in Atta List!')
  else
    !atta = !this.MDSattas.selection('RTEXT')
  endif

  -- get array of all rooms numbers
  var !comps collect all bran mem for bran
  var !rooms eval (after(part(:FRA.ROOM_KKS,1),'/')) for all from !comps ignore any
  !rooms.sortunique()

  -- add the rooms
  !num = 9
  do !room values !rooms
    add /$!room/X/FACES
    handle any
    elsehandle none
      -- add aid text in room
      !cyli = CYLI 1 OF /$!room/X/VOLM
      handle any
      elsehandle none
        !pos = !cyli.pos.wrt(/* )
        !posup = !cyli.pos.up
        !posno = !cyli.pos.north
        !posea = !cyli.pos.east
        !posupmto = $!posup - 500
        !num = !num + 1
        aid text num $!num '$!room' at $!pos
       !area=:MTOAREA of /$!room
        aid text num $!num '$!area' at E $!posea N $!posno U $!posupmto
      endhandle
    endhandle
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      benchmarks
--
-- Description: add benchmarks to drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showbenchmarks(!add is BOOLEAN)

  -- check if we are adding benchmarks or removing them
  if (!add.not()) then
    remove all stru with (matchwild(name of stru, '*BM*'))
    do !x from 10 to 20
      aid clear text $!x
      handle any
      endhandle
    enddo
    return
  endif

  if (!this.MDSattas.val.eq(0)) then
    !!alert.message('No Attas in Atta List!')
  else
    !atta = !this.MDSattas.selection('DTEXT')
  endif

  /$!atta
  -- get all atta comps to extract room no
  !fraroomkks = :Fra.room_kks
  if (!fraroomkks eq 'unset' or unset(!fraroomkks)) then
     var !branmem collect all bran mem for bran
  else
     !branmem[1] = !!ce.string()
  endif
   var !rooms   eval :FRA.ROOM_KKS for all from !branmem ignore any
  !rooms.sortunique()

  -- get array of all benchmarks
  !bms = object ARRAY()
  do !room values !rooms
     !bmname = !room & 'BM'
     var !benchm collect all stru with matchw(name of stru, '*$!bmname*')
     !bms.appendarray(!benchm)
  enddo

  do !bm values !bms
     add $!bm
  enddo

  var !bname eval name for all from !bms
  !this.benchmarks.dtext = !bname
--  !!bname = !bname

endmethod


------------------------------------------------------------------------
--
-- Method:      AttaSelect
--
-- Description: Select Atta from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .AttaSelect()

    rem all

   !atta = !this.MDSattas.selection('DTEXT')


   ADD /$!atta

   add /$!atta/REST
   handle(41,69)(2,109)(2,109)
   endhandle

   !attan = !atta.before('/DATUM')
   !attann = !atta.before('[')

   if !atta.matchwild('*/DATUM') then
      add /$!attan
      handle(41,69)(2,109)(2,109)
      endhandle
   endif

   DO !COUNT FROM 1 TO 40
      add /$!atta$N.$N$!COUNT
      HANDLE (41,69) (2,109) (2,109)
      ENDHANDLE
      add /$!attan$N.$N$!COUNT
      HANDLE (41,69) (2,109) (2,109)
      ENDHANDLE
      add /$!attann$N[$!COUNT]/REST
      HANDLE (41,69) (2,109) (2,109)
      ENDHANDLE
    enddo

    ADD /$!ATTA/DATUM
    HANDLE (41,69) (2,109) (2,109)
    /$!ATTA
    ENDHANDLE


    /$!ATTA

    -- add aid text to the bran
    aid clear text 1
    handle any
    endhandle
    bran
    handle ANY
      return
    endhandle
    var !name name
    var !ph hpos in world
    var !pt tpos in world
    aid text num 1 'PH' at $!ph wrt world
    --aid text num 2 'PT' at $!pt wrt world


    !this.setbenches(!this.MDSattas.selection())
    !this.showbenchmarks(true)
    !this.limits(bran)
--    auto ce
    /$!atta

endmethod


------------------------------------------------------------------------
--
-- Method:      limits()
--
-- Description: set view limits to passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limits(!dbref is DBREF)

  !views = ARRAY()
  if(defined(!!gphControl)) then
    !views = !!gphControl.view.selection()
    if(!views.empty()) then
       !views[1] = !!gphControl.view.rtext[1]
       handle ANY
        -- if there are no views
        return
       endhandle
    endif
  else
    !views[1] = 'gph3dDesign1'
  endif

  do !view values !views
    !v = !!$!view$n.view
    !volume   = object VOLUME(!dbref)
    if (!volume.from.set().not()) then
       skip
    endif
    if(!volume.from.distance(!volume.to).eq(0)) then
      skip
    endif

    !!gphViews.limits(!v, !volume)
  enddo

endmethod


------------------------------------------------------------------------
--
-- Method:      sfilter
--
-- Description: filter Attas by :MMSSTATUS
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sfilter()

  if (!this.sfilter.selection().eq('All')) then
    !fattas = !this.filteredattas
    var !attaNames eval (namn) for all from !fattas
    !this.MDSattas.dtext = !attaNames
    !this.MDSattas.rtext = !this.filteredattas
    !count = !this.MDSattas.dtext.size()
    !this.pc.val = 'Attas: $!count'
  else
    !status = !this.sfilter.selection()
    !operator = !this.sofilter.selection('RTEXT')
    !fattas = !this.filteredattas
    var !attas coll all with (:mmsstatus $!operator '$!status' ) from !fattas
    var !attaNames eval (namn) for all from !attas
    !this.MDSattas.dtext = !attaNames
    !this.MDSattas.rtext = !attas
    !count = !this.MDSattas.dtext.size()
    !this.pc.val = 'Attas: $!count'
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      benchce
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .benchce()

   stru

   !this.benchmarks.val = !this.benchmarks.dtext.findfirst(!!ce.name)

   unenhance stru
   !bm = !this.benchmarks.selection()
   enhance $!bm col green

endmethod


------------------------------------------------------------------------
--
-- Method:      rembench
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addrembench(!what is string, !pos is string)

!ce = !!ce

   !!ce = !this.MDSattas.selection().dbref()
   !bm = !this.benchmarks.selection().dbref()
   !bme = !this.MDSattas.selection().dbref().:mdsbenches[1]
   handle(2,752)
      !bme = 'nulref'
   endhandle
   !bmn = !this.MDSattas.selection().dbref().:mdsbenches[2]
   handle(2,752)
      !bmn = 'nulref'
   endhandle

   !posa[1] = !pos
   if (!what eq 'ADD') then
      if !pos eq 'EAST' then
         :mdsbenches $!bm $!bmn
      elseif !pos eq 'NORTH' then
         :mdsbenches $!bme $!bm
      elseif !pos eq 'EASTNORTH' then
         :mdsbenches $!bm $!bm
      endif
   elseif(!what eq 'REMSELE') then
      if !pos eq 'EAST' then
         :mdsbenches  nulref  $!bmn
      elseif !pos eq 'NORTH' then
         if !bme.unset() then
            :mdsbenches $!bme
         else
            :mdsbenches $!bme nulref
         endif
      endif
   elseif(!what eq 'REMALL') then
      :mdsbenches unset
   endif

   !this.setbenches(!this.MDSattas.selection())

   $!ce

endmethod

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhance()

   unenhance all
   !cm  = !this.MDSattas.selection()
   !bms = !this.setbenchese.dtext
   !bms.appendarray(!this.setbenchesn.dtext)

   enhance $!cm col green
      handle(47,15)
      endhandle

   do !bm values !bms
      enhance $!bm col green
      handle(47,15)
      endhandle
   enddo


endmethod


------------------------------------------------------------------------
--
-- Method:      benchmark
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .benchmark()

   unenhance all stru
   !bm = !this.benchmarks.selection()
   enhance $!bm col green

endmethod

------------------------------------------------------------------------
--
-- Method:      setbenches
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setbenches(!comp is string)

   !benche[1] = !comp.dbref().:mdsbenches[1].name
   handle(2,759)(2,754)
      !benche[1] = ''
   endhandle
   !benchn[1] = !comp.dbref().:mdsbenches[2].name
   handle(2,759)(2,754)
      !benchn[2] = ''
   endhandle

   !!be = !benche
   !!bn = !benchn
   !this.setbenchese.dtext = !benche
   !this.setbenchesn.dtext = !benchn

endmethod

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()
  aid clear text all
  unenhance all
  !this.hide()
endmethod
