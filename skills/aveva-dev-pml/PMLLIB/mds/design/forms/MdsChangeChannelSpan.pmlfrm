-- Description:
-- Form Definition for Fixed & Variable Hangers
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsChangeChannelSpan

-- Define Form
Setup Form  !!MdsChangeChannelSpan at xr0 yr0

  !!MdsChangeChannelSpan.formtitle    = |Change Assembly Span|
  !!MdsChangeChannelSpan.icontitle    = |Change Span|
  !!MdsChangeChannelSpan.Callback     = ||
  !!MdsChangeChannelSpan.formrevision = | $Revision: 1 $ |

  -- Body of Form
    path down
    text .currentChannelSpan |Current Span: | at xmin+1 ymax+0.2 width 10 is real format !!DistanceFmt
    para .spanLimits text  || width 40

    frame .FMisc |Enter a new Span| at xmin ymax+0.2
        text .ChannelSpans || at xmin+1 ymax+0.2 width 24 is real format !!DistanceFmt

    exit
    frame .FMisc2 |Enter a new Overlap| at xmin ymax+0.2
        text .ChannelOlap  || at xmin+1 ymax+0.2 width 24 is real format !!DistanceFmt

    exit
    button .Apply  | Apply | at xmin ymax+0.5 call |!this.apply()|
    path right
    button .Cancel  | Dismiss | at xmax form-size call |!this.cancel()|

  member .selectedChannelSpan is Real
  member .hangerForm is Form
  member .modifyForm is Form
  !this.currentChannelSpan.active = false
  !this.ChannelOlap.active = false

-- End form definition

exit

define method .apply()
  !ce = !!CE
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !this.selectedChannelSpan = !this.channelSpans.val.real()
  !oRest = !this.hangerForm.support.rest
  !minSpan = !oRest.getMinRequiredSpan()

  if(!this.selectedChannelSpan lt !minSpan) then
    !!alert.error('Span ' + !this.selectedChannelSpan.string(!!DistanceFmt)  + ' is less than the minimum required span ' + !minSpan.string(!!DistanceFmt) + '.')
    return
  endif

  -- Check for maximum span only for double spring and channel assembly. (B11, B13, B14)
  if(!oRest.styp inset$!!Mdsallhangertypes.DSSpring or !oRest.styp inset$!!Mdsallhangertypes.channelAssembly or !!Mdsallhangertypes.RiserClamp.find(!oRest.styp).size().gt(0)) then
    !maxSpan = !oRest.getMaxAvailableSpan()
    if(!maxSpan gt 0 and !this.selectedChannelSpan gt !maxSpan) then
      !!alert.error('Span ' + !this.selectedChannelSpan.string(!!DistanceFmt) + ' is greater than the maximum available span ' + !maxSpan.string(!!DistanceFmt) + ' for that spring type.')
      return
    endif
  endif

  -- Calling !!Mdsfh01.changeChannelSpan() method to change the rod size
  !this.hangerForm.changeChannelSpan(!this.selectedChannelSpan)
  !this.currentChannelSpan.val = !this.selectedChannelSpan

  -- dtf 20-07-04 need to complete this
  -- Set the overlap value if can find the Data
  -- find des para num for OLAP dkey


  !this.hide()
  !this.modifyForm.changeChannelHeight(!this.hangerForm)
  !!kRestoreUnits(!currentunits)
  !!CE = !ce
endmethod

define method .cancel()
  !this.hide()
endmethod
-- End of file MdsChangeChannelSpan.frm
