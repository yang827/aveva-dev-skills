-- Created:   Tue August 13 2002
--
--
-- Description:
-- Form Definition for Fixed & Variable Hangers
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsChangeRodSize

-- Define Form
Setup Form  !!MdsChangeRodSize at xr0 yr0

  !!MdsChangeRodSize.formtitle    = |Change Hanger Rod Size|
  !!MdsChangeRodSize.icontitle    = |Change Rod Size|
  !!MdsChangeRodSize.Callback     = ||
  !!MdsChangeRodSize.formrevision = | $Revision: 1 $ |

  -- Body of Form
    text .currentRodSize |Current rod size: | at xmin+1 ymax+0.2 width 10 is real format !!DistanceFmt
    frame .FMisc |Select a Rod Size| at xmin ymax+0.2
        list .RodSizes || at xmin+1 ymax+0.2 call || width 24 length 10
    exit
    button .Apply  | Apply | at xmin ymax+0.5 call |!this.apply()|
    path right
    button .Cancel  | Dismiss | at xmax form-size call |!this.cancel()|

  member .selectedRodSize is Real
  member .hangerForm is Form
  member .modifyForm is Form
  !this.currentRodSize.active = false

-- End form definition

exit

define method .apply()
  !ce = !!CE
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !this.selectedRodSize = !this.RodSizes.rtext[!this.RodSizes.val].real()
  -- Calling !!Mdsfh01.changerodsize() method to change the rod size
  !this.hangerForm.changerodsize(!this.selectedRodSize)
  !this.currentRodSize.val = !this.selectedRodSize
  -- Update the form data data
  --Save current list of available rod sizes
  !allowedRodSizes = !this.modifyForm.allowedRodSizes
  !this.modifyForm.init()
  --Restore current list of available rod sizes
  !this.modifyForm.allowedRodSizes = !allowedRodSizes
  -- !this.hide()
  if(!this.hangerForm.support.rest.styp.substring(1,1).eq('V')) then
    -- This is a variable spring hanger
    -- Calling !!Mdsmodfh.modifySpringType() method to display the spring choose form

    -- if(!this.hangerForm.support.rest.styp inset$!!Mdsallhangertypes.RiserClamp or $
    if (!!MdsAllHangertypes.RiserClamp.find(!this.hangerform.support.rest.styp).size().gt(0) or $
       !this.hangerForm.support.rest.styp inset$!!Mdsallhangertypes.channelAssembly) then
      -- rest has 2 springs
      prompt 'Choose the spring type for hanger no. 1'
      !this.modifyForm.modifySpringType(1,true)
      -- Get the new spref of the vspr of first hanger
      !restRef = !this.hangerForm.support.rest.ref
      var !newSpreName spre of vspr 1 of hang 2 of $!restRef
      -- Change the spref of the vspr of the second hanger to be the same as the first hanger
      vspr 1 of hang 3 of $!restRef
      var !oldSpringlength const dist pa to pl
      spre $!newSpreName
      var !newSpringlength const dist pa to pl
      !diff = !newSpringlength.real() - !oldSpringlength.real()
      hang
      move ht by u $!diff
      -- resize the hanger to accomodate the new spring size
      -- do not use the choose command
      prompt 'Choose the spring type for hanger no. 2'
      !this.hangerForm.resizeHanger(!this.hangerForm.support.rest.hangers[3].ref, !this.hangerForm.support.rest.hangers[3].fitt.ref)
      -- !this.modifyForm.modifySpringType(2,false)
      prompt ''
    else
      !this.modifyForm.modifySpringType(1,true)
    endif
  endif
  !!kRestoreUnits(!currentunits)
  !!CE = !ce
  handle any
  endhandle
endmethod

define method .cancel()
  !this.hide()
endmethod
-- End of file MdsChangeRodSize.frm
