--
--
-- Description:
-- Form to check the returned hanger
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(DBREF)                      -
--  navigate()                       -
--

-- Kill existing form definition
Kill !!mdsCheckHang

-- Define Form
setup form  !!mdsCheckHang

  !!mdsCheckHang.formtitle    = |Hanger Integrity Check|
  !!mdsCheckHang.icontitle    = ||
  !!mdsCheckHang.callback     = ||
  !!mdsCheckHang.formrevision = ||

  frame .check || at x0 ymax
    list   .list call |!this.navigate()| width 80 length 20
  exit

-- Bottom Line

  button .ok      |   OK   | at x0 ymax cancel

-- Form Members
-- Support object

  member .support     is MDSSUPPORT

-- End form definition
exit

define method .init(!hanger is DBREF)

-- Define tolerance

  !tol = 2

-- Datum Atta

  !!ce = !hanger

-- Goto hanger

  goto cref

-- goto rest

  rest

-- Make sure wpad and scla are at the tail pos
  do !adjust from 1 to !!ce.mcount()
    hang $!adjust
    last mem
    if !!ce.type.eq('WPAD') then
      pos pl at pt
      prev
      if !!ce.type.eq('SCLA') then
        pos pl at pa of next
      endif
    elseif !!ce.type.eq('SCLA') then
      pos pl at pt
    endif
  enddo

-- goto rest

  rest

-- Loop through hangers and find any problems with lengths

  !members = !!ce.mcount
  !dtext = ARRAY()
  !rtext = ARRAY()
  !errors = 0

  do !hangers from 1 to !members
    rest
    !nameOfRest = !!ce.namn
    !dtext.append('REST   ' + !nameOfRest)
    !rtext.append('/$!nameOfRest')
    $!hangers
    !hangerMembers = !!ce.mcount
    !hangername = !!ce.namn
    !dtext.append('HANG $!hangers ' + !hangername)
    !rtext.append('/$!hangername')
    !dtext.append(' ')
    !rtext.append('')
    !dtext.append('Gap Check')
    !rtext.append('')
    !dtext.append('---------')
    !rtext.append('')
    do !hangMem from 1 to !hangerMembers
      hang
      $!hangMem
      if !!ce.sequence.neq(!hangerMembers) then
        var !distCheckT const dist pl to pa of next
        var !distCheck (dist($!distCheckT,f,f,f,2,t))
      else
        var !distCheckT const dist pl to pt
        var !distCheck (dist($!distCheckT,f,f,f,2,t))
      endif
      !name = !!ce.name
      if !name.match('=').eq(1) then
        !nameIs = !!ce.fullname.before('of').trim()
      else
        !nameIs = !name
      endif
      !dtext.append(!nameIs)
      !rtext.append(!name)
      if !distCheck.real().leq(!tol) then
-- If nothing to report dont
        -- !dtext.append('Warning - Distance check within tolerance of $!tol (Actual = $!distCheck)')
        -- !rtext.append(' ')
      else
-- Only check of dummy lsro
        if !!ce.lsro.name.match('/LISEGA3.0/M').gt(0) or !!ce.lsro.name.match('/LISEGA3.0R/RM').gt(0) then
          var !paToPl const dist pa to pl
          var !paToNext const dist pa to pa of next
          if !paToPl.real().gt(!paToNext.real()) then
            !text = '-'
          else
            !text = ''
          endif
          !dtext.append('Error   - Distance check not within tolerance of $!tol (Actual = $!text$!distCheck)')
          !rtext.append(' ')
          !errors = !errors + 1
        endif
      endif
-- If the comp is a hele and at lisega type 39 then we can adjust the length if will tolerance
      if !!mdsHangIf.eq('LISEGA') then
        if !!ce.type.eq('HELE') then
          if !!ce.spref.name.matchwild('/LISEGA3.0/39*') or !!ce.spref.name.matchwild('/LISEGA3.0R/R39*') then
            !despar = !!ce.despar
-- Do we need to add or subtract the diff
            var !paToPl const dist pa to pl
            var !paToNext const dist pa to pa of next
            if !paToPl.real().gt(!paToNext.real()) then
              !newDesp3 = !despar[3].real() - !distCheck.real()
              !moved = $!distCheck
              !text = 'removed from'
            else
              !newDesp3 = !despar[3].real() + !distCheck.real()
              !moved = -$!distCheck
              !text = 'added to'
            endif
            if !distCheck.real().lt(!tol) and !distCheck.real().neq(0) then
              desp n3 $!newDesp3
              desp n5 $!moved
              pos pa at pl of prev
              !dtext.append('Message - $!distCheck $!text length of rigid strut')
              !rtext.append(' ')
            else
-- Put value of diff in desp 5 for reporting
              desp n5 $!moved
            endif
          endif
        endif
      endif
      !this.list.dtext = !dtext
      !this.list.rtext = !rtext
    enddo

  enddo

  -- <RM> -- 01 Nov 06 --
  -- perform an additional check if we have an LD01 which gives a warning if the rigid strut
  -- and welded bracket form an angle which is greater than 6 degrees (note this is the maximum
  -- stated value in the lisega product literature. edition October 2001)
  if !!mdsHangIf.eq('LISEGA') then

    !!ce = !hanger
    !config = !!ce.cref.owner.:USTHcfgKey
    handle ANY
     !licadconfig = 'UNSET'
    elsehandle NONE
     !split = !config.split('.')
     !licadconfig = !split[1] & !split[2]
       handle any
         !licadconfig = 'UNSET'
       endhandle
    endhandle

    if !licadconfig.eq('LD01') or !licadconfig.eq('LD09') then
      -- Goto hanger
      goto cref
      !hangerref = !!ce
      !sclatrue = FALSE
      !hangerMembers = !!ce.mcount

      do !member from 1 to !hangerMembers
        $!member
        if !!ce.type.eq('SCLA') then
          pin 1 copy p1
          !sclatrue = TRUE
          break
        endif
        $!hangerref

      enddo

      if !sclatrue then
        pin 2 copy pin 1
        pin 2 dir to pl of $!hanger

        var !angdir1 dir pin 1
        var !angdir2 dir pin 2

        !angle = !angdir1.direction().angle(!angdir2.direction())

        if !angle.gt(90) then
          !angle = 180 - !angle
        endif

        !angle = 90 - !angle

        if !angle.gt(6) then
          !dtext.append('Message - Angle $!angle between welded bracket and rigid strut is greater than Lisega maximum of 6 degrees')
          !rtext.append(' ')
          !this.list.dtext = !dtext
          !this.list.rtext = !rtext
          !errors = !errors + 1
        endif

      endif
    endif
  endif
  -- <RM> 01 Nov 06 -- end of fix

  if !errors.gt(0) then
    if defined(!!licadautotestenabled) then
      if !!licadautotestenabled then
        -- do nothing
      else
        show !!mdsCheckHang
      endif
    else
      show !!mdsCheckHang
    endif
  else
    if !!mdsCheckHang.shown() then
      kill !!mdsCheckHang
      pml reload form !!mdsCheckHang
    endif
  endif

endmethod
----------------------------------------------------------------------------------------

define method .navigate()

-- Try to navigate to selected line

  !element = !this.list.rtext[$!this.list.val]

  $!element
    handle ANY
    endhandle


endmethod
