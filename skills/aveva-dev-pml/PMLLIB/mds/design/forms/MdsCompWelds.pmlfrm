-- Created: 17/05/04
--
--
-- Description:
-- Multi Discipline support Form
-- Purpose to build a weld for a single element or a list of elements
-- it starts up by getting a list of available welds and displaying them
-- the user then selects the items he wants to modify
--
--------------------------------------------------------------------------------

-- Define Form

setup Form !!mdsCompWelds

  title 'Standard Welds'

  init '!this.init()'
  Path down
  frame .stds 'Weld Standard Categories'

    button .newarea ' Create Weld Area ' call ''
    button .delarea ' Delete Weld Area ' call ''
    list   .arealist 'Existing Areas' at xmax .newarea+ 1 ymin .newarea width 30 height 4

  exit

  frame .welds 'Weld Items'

    button .newweld '     Create Weld ' call ''
    button .delweld '     Delete Weld ' call ''
    list   .weldlist  'Existing Welds' at xmax .newweld+ 1 ymin .newweld width 30 height 7
    path down

    text .dtsen   ' DataSet Name: ' at xmin.newweld ymax width 30 is STRING
    text .weldn   '    Weld Name: ' width 30 is STRING
    text .symbol  '  Symbol Name: ' width 30 is STRING
    text .ppoint  'PPoint Number: ' width 30 is STRING
    text .desc    '  Description: ' width 30 is STRING
    text .TYpe    '         Type: ' width 30 is STRING
    text .Range   '   Size Range: ' width 30 is STRING

  exit

  button .apply ' Apply '     ok
  button .dismiss ' Dismiss ' at xmax form -size ymin cancel


  member .source is dbref
  member .destination is dbref
  member .existingstds is ARRAY
  member .cstds is ARRAY
  member .currentstd is mdsweld
  member .edit is MDSWELD
  member .allweldlist is mdsweldlist

exit

define method .init()

  !this.source = /MDS/STD/WELDS
-- load the standard welds
  var !std coll all ddar for $!this.source
  var !names eval name for all from !std
  !this.arealist.dtext = !names
  !this.arealist.rtext = !std

-- load the default welds and the existing standards

 !this.destination = /MDS/DES/WELDS
-- first load the standard welds available
 var !stds coll all ddse for $!this.destination
 !total = ARRAY()

 do !a values !stds
   !total.append(object mdsweldlist(!A.dbref(),'STD'))
 enddo

 !this.existingstds = !total

define method .readdata()

endmethod

define method .writedata()

endmethod

define method .ok()

endmethod

-- End of file
