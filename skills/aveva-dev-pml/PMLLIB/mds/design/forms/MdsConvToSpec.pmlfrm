--
-- File:		MdsConvToSpec.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon 2nd Feb 2004
--
--
-- Description:
-- Form Definition for converting a standard to special using the same name
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsConvToSpec

-- Define Form
Setup Form !!MdsConvToSpec

  !!MdsConvToSpec.formtitle    = |Convert to Special|

  -- Body of Form
    para .Name text |Name                               |
    text .Number   |Number | at x0 Ymax+0.2 call |!!MdsCheckNum()| width 29 name

    button .Ok     |   OK   | at xmin           ymax+0.5 call |!this.OK()|

    path right
    hdist 4

        button .Cancel | Cancel | at xmax form-size ymin cancel

-- End form definition
exit

-------------------------------------------------------------------------------
define method .init(!Support is DBREF)

-- Is the passed element a support

  !IsItASupport = !!MdsGetSuppName(!Support)

-- Return if it is not

  if !IsItASupport.eq('ABORT') then
    return
  endif

-- Is it a framework

  !!ce = !IsItASupport.dbref()

  if !!ce.type.neq('STRU') then
    !!Alert.Error('Selected support is not a framework and cannot be converted to a special')
    return
  endif

  if !!ce.:MDSSuppType.eq('SPECIAL') then
    !!Alert.Error('Selected support is already a special')
    return
  endif

-- Check to see if it is a framatome electrical support

  if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
    !Sref = !IsItASupport + '/SREF'
    if !Sref.dbref().spref.name.match('/MDF/FR').eq(1) then
      !!Alert.Error('Selected support is a electrical support and cannot be converted to a special')
      return
    endif
  endif

-- Set the name gadget

  !this.name.val = 'Name   ' + !IsItASupport.after('/')
  !this.number.val = '$!!MdsOptions.SpecPre'

-- Finally show form if the user has to complete a SPS number

  if defined(!!MdsSpecOn) then
    if !!MdsSpecOn.boolean() then
      !this.show()
    else
      !This.OK()
    endif
  else
    !this.show()
  endif
endmethod
--------------------------------------------------------------------------------------------

define method .OK()

-- Navigate to selected support

  !name = '/' + !this.name.val.after('Name   ')
  !SrefName = '/' + !this.name.val.after('Name   ') + '/SREF'
  !!ce = !name.dbref()

-- Check to see if the user has set a special number if the MDSSPECON exists and is set to true

  if (defined(!!MdsSpecon)) then
    if !!MdsSpecon.boolean() then
      if (!this.Number.val.eq('$!!MdsOptions.SpecPre')) then
        !!Alert.Error('Please set a Special Support number before continuing')
        return
      endif
    endif
   else
     if (!this.Number.val.eq('$!!MdsOptions.SpecPre')) then
       !!Alert.Error('Please set a Special Support number before continuing')
       return
     endif
   endif

-- Check with user it is OK

  !NameOfSupport = !This.name.val.after('Name').trim()

  if !!Alert.Confirm('Are you sure you want to change support $!NameOfSupport to a special').eq('NO') then
    return
  endif

-- Raise DAC Access
  !!MdsDacControl(TRUE)

  desc ''
  :MdsSuppType 'SPECIAL'
  var !Sctns coll all sctn for ce
  var !oldnames eval name for all from !sctns
  !STRU = !!CE
  !NameOfStru = !!ce.name
  do !Reset values !Sctns
    !!ce = !Reset.dbref()
    :MdsAttaref default
    unname
      handle ANY
      endhandle
  enddo

-- Resetthe SREF atta to a special

  !!ce = !SrefName.dbref()

  -- sel with styp 'SPECIAL' spec /MDS
  choose spec /MDS with styp 'SPECIAL'

  !!ce = !name.dbref()

-- Rename all sctns using V naming convention

  !Counter = 1
  !newnames = ARRAY()
  do !Reset index !Sctns
    !!ce = !sctns[!Reset].dbref()
    name $!NameOfStru-V$!Counter
    !newnames.append(!!ce.name)
    !Counter = !Counter + 1
    !resetweld = object mdsweldlist(!sctns[!Reset].dbref(),true)
  enddo

--dtf >>> Mod to name PNOD and PJOI when converted to special
  !tempdesc = (desc of /MDS/TEMPLATES )
  if !tempdesc.upcase().eq('FRAMATOME TEMPLATES') then
    -- now rename the pnods
    var !PnodColl coll all pnod for stru
    do !i VALUES !PnodColl
      $!i
      UNNAME
      handle ANY
      endhandle
      1
      UNNAME
      handle ANY
      endhandle
    enddo
    do !I values !PnodColl
      $!I
      1
      if !!CE.CREF.unset().not() then
        !PrevSctnName = !!ce.cref.name
      else
        !PrevSctnName = (NAME OF PREV SCTN)
      endif
      name   $!PrevSctnName/PJOI
      handle ANY
        do !II from 1 to 100
          name $!PrevSctnName/PJOI$!II
          handle ANY
            skip
          elsehandle NONE
            break
          endhandle
        enddo
      endhandle
      end
      name   $!PrevSctnName/PNOD
      handle ANY
        do !III from 1 to 100
          name $!PrevSctnName/PNOD$!III
          handle ANY
            skip
          elsehandle NONE
            break
          endhandle
        enddo
      endhandle
    enddo
  endif
-- dtf <<< End Of Mod

  -- now go and fix all of the welds to set their intersect values
   do !Reset index !Sctns
     !!ce = !sctns[!Reset].dbref()
     !restname = object mdsweldlist(!sctns[!Reset].dbref(),!oldnames,!newnames)
   enddo

  -- rename the temporary welds to proper ones
  stru
  tmpl 1
  handle ANY
    -- no welds on this support
  elsehandle NONE
    rename all /SWELD /WELD
  endhandle

  Stru

  :MdsSpecialNo '$!This.Number'

  -- If called from a main form then hide it

  if (defined(!!formtohide)) then
    !!formtohide.hide()
    !!formtohide.delete()
  endif

-- If the modify form name gadget is unset then modify the support automatically

  if !!MdsModifySupp.name.val.eq('unset') then
    !!MdsModifySupp.cancel.active = true
    !!MdsModifySupp.name.val = !!ce.name
    !CallBackOfName = !!MdsModifySupp.name.callback
    $!CallBackOfName
    !CallBackOfOk = !!MdsModifySupp.OK.callback
    $!CallBackOfOK
  endif

   $!Stru

-- Lower DAC Access

  !!MdsDacControl(FALSE)

  !this.hide()

-- End of file MdsConvToSpecial.pmlfnc

endmethod


-- End of file MdsConvToSpec.frm
