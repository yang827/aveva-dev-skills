--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  createWeld(REAL,STRING,DBREF,DBREF,DBREF) -
--  getExistingCase(ARRAY)           ARRAY
--  getWeldCase(DBREF,DBREF)         STRING
--  getcurrentsize()                 -
--  init()                           -
--  init(STRING,DBREF)               -
--  modifyFilletWeld(REAL,DBREF,DBREF,DBREF) -
--  modifyWeld(STRING,DBREF,DBREF,DBREF) -
--  setsize()                        -
--  settype()                        -
--  setupConnectionPicks()           -
--  setupWelds(DBREF,DBREF,STRING)   -
--  validatePick1(ARRAY)             -
--  validatePick2(ARRAY)             -
--  validatePick3(ARRAY)             -
--

-- Kill existing form definition
kill !!mdsCopyFraSctn
-- Define Form
setup form !!mdsCopyFraSctn
  !!mdsCopyFraSctn.formtitle    = |Create Section|
  !!mdsCopyFraSctn.icontitle    = ||
  !!mdsCopyFraSctn.callback     = ||
-- Body of Form
  para .string text ' Type    Size   Dir'
  option .type at x1 y1.2 Call |!this.settype()| width 5
  path right
  option .size Call |!this.setsize()| width 5
  option .dir width 4
-- Bottom Line
  button .cancel  | Dismiss | at xmax form-size ymax+0.5 CANCEL
  button .ok      | Apply | at x0    ymin     Call |!this.create()|
  --button .ok      |  OK   | at x0    ymin     Call |!this.create()| OK
  member .mode is STRING
  member .sctn is DBREF
  member .currentSize is STRING
  member .currenttype is STRING
  member .newsctn is DBREF
  member .endpos is STRING
  member .mainProfile1 is DBREF
  member .mainProfile2 is DBREF
-- End form definition
exit
--------------------------------------------------------------------------------
define method .init()
  !ce = !!ce
  /MDS/FRA/STEELWORK
  -- Set the type list
  var !stru coll all stru for ce
  var !types eval name for all from !stru
  !dtext = ARRAY()
  do !addDText values !types
    !dtext.append(!addDText.after('/MDS/FRA/STEELWORK/'))
  enddo
  !this.type.dtext = !dtext
  !this.type.rtext = !dtext
  !!mdsCopyFraSctn.formtitle    = |Create Section|
  !!mdsCopyFraSctn.mode = |CREATE|
  !this.settype()
  show !!mdsCopyFraSctn
  !this.dir.active = TRUE
  !!ce = !ce
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Init method to allow form to be shown in Create/Modify modes
define method .init(!dummyMode is STRING,!sctn is DBREF)
  !ce = !!ce
  /MDS/FRA/STEELWORK
  -- Set the type list
  var !stru coll all stru for ce
  var !types eval name for all from !stru
  !dtext = ARRAY()
  do !addDText values !types
    !dtext.append(!addDText.after('/MDS/FRA/STEELWORK/'))
  enddo
  !this.type.dtext = !dtext
  !this.type.rtext = !dtext
  !this.settype()
  !!mdsCopyFraSctn.formtitle    = |Modify Section|
  !!mdsCopyFraSctn.mode = |MODIFY|
  if !sctn.unset() then
    -- Identify the section to Modify
    prompt off
    prompt load escape 'Identify section to Modify'
    ID SCTN @
      handle (61,528)
        prompt on
        return
      endhandle
    prompt on
  else
    !!ce = !sctn
  endif
  !this.sctn = !!ce
  show !!mdsCopyFraSctn
  -- Get Current size
  !this.getcurrentsize()
  !part1 = !this.currentSize.split('-')[1]
  !part2 = !this.currentSize.split('-')[2]
 $(
!currentSize = !!ce.spref.name.after('/MDS-FRA-SCTNS/')
!part1 = !currentSize.substring(1,2)
!part2 = !currentSize.substring(3,2)
  $)
  var !drns  zdir
  if !!ce.jois.unset().not() and !!ce.joie.unset().not() then
    if !!ce.jois.gtyp.unset() and !!ce.joie.gtyp.unset() then
      !this.type.select('RTEXT','M1+P')
    else
      !this.type.select('RTEXT','$!part1')
    endif
  else
    !this.type.select('RTEXT','$!part1')
    handle ANY
      !this.type.val = 1
    endhandle
  endif
  -- Update options in set type gadget
  !this.settype()
  if !!ce.jois.unset().not() and !!ce.joie.unset().not() then
    if !!ce.jois.gtyp.unset() and !!ce.joie.gtyp.unset() then
      !part2 = |$!part2$N+P|
      !this.size.select('RTEXT','$!part2')
    else
      !this.size.select('RTEXT','$!part2')
    endif
  elseif !part2.eq('VAR') then
    --!xDText = ARRAY()
    --!xRText = ARRAY()
    --!xDText.append(!part2)
    --!xRText.append(!part2)
    --!xDText.append(!sctn.despara[1].string())
    --!xRText.append(!sctn.despara[1].string())
    --!this.size.clear()
    --!this.size.dtext = !xDText
    --!this.size.rtext = !xRText
    --!partX = !sctn.despara[1]
    --!this.size.select('RTEXT','$!partX')
  else
    !this.size.select('RTEXT','$!part2')
      handle ANY
        !this.size.val = 1
      endhandle
  endif
  !this.dir.select('RTEXT','$!drns')
  !this.dir.active = FALSE
  --!!ce = !ce
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- method to look at a sctn and define what its current function should be
define method .getcurrentsize()
!func = !this.sctn.func
if !func.match('-').gt(0) then
  -- its s sctn from the additional sctn list
elseif !this.sctn.gtyp.eq('PLAT') then
  !catref = !this.sctn.spref.tanswer
    !depth = !this.sctn.prop.depth
  !func = 'P' & !depth & '-VAR'
else
  -- we need to look at the spref of the sctn to try and determine what the sctn is
    --!catref = !this.sctn.catref.:MDSSIZETAG
  !catref = !this.sctn.spref.tanswer
  !func = !catref.substring(1,2) & '-' & !catref.substring(3,2)
endif
  !this.currentSize = !func
  !this.currenttype = !func.split('-')[1]
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .settype()
-- Set the size list
  !ce = !!ce
  /MDS/FRA/STEELWORK
  -- Set the type list
  var !stru coll all stru for ce
  !!ce = !stru[$!this.type.val].dbref()
  !members = members
  !dtext = ARRAY()
  do !addDText values !members
    !dtext.append(!addDText.name.after('/MDS/FRA/STEELWORK/').after(!this.type.dtext[$!this.type.val]))
  enddo
  !this.size.dtext = !dtext
  !this.size.rtext = !dtext
-- Set directions
  !selectedSize = '/MDS/FRA/STEELWORK/' + !this.type.dtext[!this.type.val] + !this.size.dtext[!this.size.val]
  --!sctnText = '/' + !this.type.dtext[!this.type.val] + !this.size.dtext[!this.size.val]
  !!ce = !selectedSize.dbref()
  !directions = members
  if !this.mode eq |MODIFY| then
    !originalDir = !this.dir.rtext[!this.dir.val]
    handle ANY
      -- Get section direction
      !originalDir = |N|
    endhandle
  endif
  !dtext = ARRAY()
  --!rtext = ARRAY()
  --q var !directions
  do !setDir values !directions
    if !setDir.type.eq('SCTN') then
      --<wd>23feb2010 - DUN1233 - The NEW SCTN Support Types "Q3O" and Q5O" SKIP the 2nd SCTN
      skip if (!setDir.fullname.matchwild('/*-?2'))
      --<wd>23feb2010 - DUN1233 - The NEW SCTN Support Types "Q3O" and Q5O" SKIP the 2nd SCTN
      !dtext.append(!setDir.name.substring(!setDir.name.length(),1))
    endif
  enddo
  !this.dir.dtext = !dtext
  !this.dir.rtext = !dtext
  if !this.mode eq |MODIFY| then
    !this.dir.select('RTEXT','$!originalDir')
  endif
  !!ce = !ce
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .create()
-- Hide weld form if shown
  if !!mdsSpecialWelds.shown() then
    !!mdsSpecialWelds.hide()
  endif
  !flip = FALSE
  if !this.mode eq |MODIFY| then
    !!ce = !this.sctn
    !posE = !!ce.posE
    !posS = !!ce.posS
    !anCREF = !!ce.:MDSANCREF
    !selectedSize = '/' + !this.type.dtext[!this.type.val] + !this.size.dtext[!this.size.val] + '-' + !this.dir.dtext[!this.dir.val]
    -- <RM> 13/11/09 if the current sctn size is being changed then we must issue a warning that all weld info is going to be removed
    -- for the connectivity checking that is required for feature F-2273
    !function = !selectedSize.dbref().function
    handle ANY
      !function = object STRING()
    endhandle
    !replaceWelds = object STRING()
    if !function.match('X1').gt(0) or !function.match('Q2').gt(0) or !function.match('Q3M').gt(0) or !function.match('Q4M').gt(0) or !function.match('M1').gt(0) or !function.match('O1').gt(0) then
      if !function.match('M1+P').eq(0) then
        !replaceWelds = !!alert.confirm('the selected size change requires existing welding data to be replaced due to connectivity checks, are you sure you want to proceed?')
        if !replaceWelds.eq('NO') then
          return
        else
          --<RM> 16/11/09 we need to remove the weld data from the template area otherwise these will persist F-2273
          if !replaceWelds.eq('YES') then
            !current = !!ce
            do !i from 1 to !this.sctn.:MDSWeldData.size()
              !!ce = !this.sctn.:MDSWeldData[!i]
              handle ANY
                skip
              endhandle
              delete ddse
              handle ANY
                skip
              endhandle
            enddo
            !!ce = !current
          endif
        endif
      endif
    endif
    -- <RM> 13/11/09
-- save the current reference to a local weld
    !mdsWeldData = :MDSWeldData
-- Before copying sctn get rid of existing plates
    goto jois
    handle NONE
      pnod
      var !pnodSRule Rule
      pjoi 1
      handle NONE
        !unusedPjoiSOpdi = opdi
        end
      elsehandle ANY
      endhandle
      delete pnod
    elsehandle ANY
      var !pnodSRule |NONE|
    endhandle
    !!ce = !this.sctn
    goto joie
    handle NONE
      pnod
      var !pnodERule Rule
      delete pnod
    elsehandle ANY
      var !pnodERule |NONE|
    endhandle
    !!ce = !this.sctn
-- Remember the bangle of the sctn
    !bang = !!ce.bang
    if !!ce.gtyp.eq('PLAT') then
      --!width = !!ce.desp[1]
      !width = !!ce.prop.width.real()
    endif
-- copy a template based sctn which may contain a link to a weld
    copy  $!selectedSize
      handle (41,31)
        delete sctn mem
      copy  $!selectedSize
      endhandle
    if !!ce.gtyp.eq('PLAT') then
       !!ce.desp[1] = !width
      handle ANY
      endhandle
    endif
    !!ce.bang = !bang
--<tm> 10/01/2005 new requirement to build new welds if the new type is
-- different to the old one
-- check the function of the sctn against the new selected type and build
-- new welds if they are different
-- if the section type is the same, just change the weld size.
    -- <RM> 13/11/09 if we have a valid sctn type for connectivity checking as per feature 2273 we need to
    -- ensure that any existing weld information is from the default template otherwise we can't process it
    if !replaceWelds.neq('YES') then
      if !this.currenttype.eq(!this.type.selection()) then
        -- the new type is the same as the old type, so we can update the weld size
    -- the copied section may have a pointer to a weld. If there is a pointer
    -- we need to get the weld size and overwrite the existing weld sizes
        !weldSize = 0
    !newMDSWeldData = :MDSWeldData
        !unusedTest = !newMDSWeldData[1].type
      handle ANY
      elsehandle NONE
          !weld = object MDSWELD(!newMDSWeldData[1])
          !weldSize = !weld.tagtext.real()
          handle ANY
            !!alert.error('problem with weld size - reset to zero')
            !weldSize = 0
          endhandle
      endhandle
    !!ce = !this.sctn
    -- reset the weld data
        !!ce.:MDSWeldData = !mdsWeldData
      handle ANY
      endhandle
    -- reset the sizes of all welds
        !unusedWeldList = object MDSWELDLIST(!this.sctn,!weldSize)
  else    $* the weld type is different so we need to copy the welds locally
        !unusedX = object MDSWELDLIST(!this.sctn,!!mdsSpecial)
      endif
    endif
-- Retain original position for origin
    !!ce.posE = !posE
    !!ce.posS = !posS
    !!ce.:MDSANCREF = !anCREF
    handle ANY
    endhandle
    -- DTF >>> if rule of PNOD at start set AND no PNOD at joie AND gtype of section eq BOX,
-- then we must flip the section because its very likely the support has been copied from
-- a standard and the PNOD will ne placed on the sctn end if you modify it as a special.
    !sctnGtype = !!ce.gtype
    if (!sctnGtype eq 'BOX' and !pnodERule eq 'NONE' and match(!pnodSRule, 'POSS') gt 0) then
      flip
      !flip = TRUE
    endif
    -- DTF <<< End of Mod
    if !!ce.joie.unset().not() then
      goto joie
      !joieSpref = !!ce.spref
      !newSpref = !!ce.spref.name.substring(1,(!!ce.spref.name.length() - 1))
      !char = !!ce.cref.spref.namn.after('/').substring(3,1)
      !newSpref = !newSpref + !char
      spref $!newSpref
        handle ANY
          end
          delete pnod
        endhandle
      !!ce = !this.sctn
    endif
    if !!ce.jois.unset().not() then
      goto jois
      !joieSpref = !!ce.spref
      !newSpref = !!ce.spref.name.substring(1,(!!ce.spref.name.length() - 1))
      !char = !!ce.cref.spref.namn.after('/').substring(3,1)
      !newSpref = !newSpref + !char
      spref $!newSpref
        handle ANY
          end
          delete pnod
        endhandle
      !!ce = !this.sctn
    endif
  else
-- Create Mode
    !pjoi = object DBREF()
    !selectedSize = '/' + !this.type.dtext[!this.type.val] + !this.size.dtext[!this.size.val] + '-' + !this.dir.dtext[!this.dir.val]
    !!ce = !!mdsSpecial.support.stru
    frmw 1
    last mem
      handle ANY
      endhandle
    new sctn copy $!selectedSize
    --<wd>12feb2010 - DUN1233 - The NEW SCTN Support Types "Q3O" and Q5O" require an additional SCTN
    -- Store the MAIN SCTN of the SCTN type Created
  !sctn = !!ce
    !second = FALSE
    --Test and handle ANY for the existence of a 2nd SCTN when the selected type is "Q3O", "Q5O" etc...
    if (!selectedSize.matchwild('/Q*O*')) then
      -- Create the NEW additional 2nd SCTN required
      !secondSection = !selectedSize & '2'
      new sctn copy $!secondSection
      handle ANY
        --q var !!error
        delete SCTN
        !!alert.error('***NOTE:*** - Unable to create the 2nd SCTN required to complete the SCTN type $!selectedSize')
      elsehandle NONE
        -- The 2nd SCTN has been successfully created
        !second = TRUE
        !sectionTwo = !!ce
        -- Connect the START of the 2nd SCTN to SJOI 1 of SNOD 1 of the PREVIOUS "MAIN" SCTN, i.e. !sctn
        conn start to sjoi 1 of snod 1 of $!sctn
      endhandle
    endif
    --<wd>12feb2010 - DUN1233 - The NEW SCTN Support Types "Q3O" and Q5O" require an additional SCTN
  endif

  --<wd>12feb2010 - DUN1233 -- Navigate back to the MAIN SCTN of the SCTN Type
  !!ce = !sctn
  --  !sctn = !!ce
  --<wd>12feb2010 - DUN1233

  !endDir = !!ce.drne
  !opEndDir = !endDir.opposite()
  --!startDir = !!ce.drns
  --!opStartDir = !startDir.opposite()
  new pnod copy $!selectedSize/PNOD
    handle ANY
      delete pnod
    elsehandle NONE
      var !rule rule
      pjoi 1
      cref $!sctn
    !pjoi = !!ce
      if !rule.match('POSE').gt(0) then
      opdir  $!opEndDir
      endif
      !!ce = !sctn
    if !selectedSize.dbref().jois.badref().not() then
      jois $!pjoi
      endif
    if !selectedSize.dbref().joie.badref().not() then
      joie $!pjoi
    endif
  endhandle
  !!ce = !sctn

  new pnod copy $!selectedSize/PNOD1
  handle ANY
    delete pnod
  elsehandle NONE
    pjoi 1
    cref $!sctn
    !pjoi1 = !!ce
    !!ce = !sctn

    --<wd>12feb2010 - DUN1233 - The NEW SCTN Support Types "Q5O" SCTN Types ONLY have ONE PNOD and ONE PJOI at the SCTN START
    --    joie $!pjoi1
    if (!!ce.function.matchwild('Q5O*')) then
      jois $!pjoi1
    else
    joie $!pjoi1
    endif
    --<wd>12feb2010 - DUN1233 - The NEW SCTN Support Types "Q5O" SCTN Types ONLY haveONE PNOE and PJOI at the SCTN START

  endhandle

  new pnod copy $!selectedSize/PNOD2
  handle ANY
    delete pnod
  elsehandle NONE
    pjoi 1
    cref $!sctn
    !pjoi2 = !!ce
    !!ce = !sctn
    jois $!pjoi2
    endhandle

-- Name sctn/pjoi
  if !this.mode eq |CREATE| then
    !!ce = !sctn
    do !count from 1 to 100
      !struName = !!mdsSpecial.support.stru.name
      name $!struName-V$!count
        handle NONE
        --<wd>12feb2010 - DUN 1233- The NEW SCTN Support Types "Q3O" and Q5O" require an additional SCTN
        --break
        if (!second)then
          -- The 2nd SCTN exists so Name it
          !!ce = !sectionTwo
          !nextSection = !count + 1
          --          !two = '2'
          --          name $!struName-V$!count-$!two
          name $!struName-V$!nextSection
          handle NONE
            break
          elsehandle ANY
            skip
          endhandle
        else
          break
        endif
        --<wd>12feb2010 - DUN 1233- The NEW SCTN Support Types "Q3O" and Q5O" require an additional SCTN
      elsehandle ANY
        skip
      endhandle
    enddo
  endif
  !!ce = !pjoi
  handle ANY
  elsehandle NONE
    --!struName = !!mdsSpecial.support.stru.name
    --name $!struName-P$!count
    !sctnName = !!ce.cref.name
    name $!sctnName/PJOI
    handle NONE
      end
      name $!sctnName/PNOD
    elsehandle ANY
      do !count from 1 to 100
        name $!sctnName/PJOI$!count
        handle NONE
          end
          name $!sctnName/PNOD$!count
          break
        elsehandle ANY
          skip
        endhandle
      enddo
    endhandle
  endhandle
  !!ce = !pjoi1
  handle ANY
  elsehandle NONE
    --!struName = !!mdsSpecial.support.stru.name
    --name $!struName-P$!count
    !sctnName = !!ce.cref.name
    name $!sctnName/PJOI1
    handle NONE
      end
      name $!sctnName/PNOD1
    elsehandle ANY
      do !count from 1 to 100
        name $!sctnName/PJOI1$!count
        handle NONE
          end
          name $!sctnName/PNOD1$!count
          break
        elsehandle ANY
          skip
        endhandle
      enddo
    endhandle
  endhandle
  !!ce = !pjoi2
  handle ANY
  elsehandle NONE
    --!struName = !!mdsSpecial.support.stru.name
    --name $!struName-P$!count
    !sctnName = !!ce.cref.name
    name $!sctnName/PJOI2
    handle NONE
      end
      name $!sctnName/PNOD2
    elsehandle ANY
      do !count from 1 to 100
        name $!sctnName/PJOI2$!count
        handle NONE
          end
          name $!sctnName/PNOD2$!count
          break
        elsehandle ANY
          skip
        endhandle
      enddo
    endhandle
  endhandle
  !!ce = !sctn
  !sctnName = !!ce.name
    do !loop from  1 to 5
      snod $!loop
      handle NONE
        rule execute all
      name $!sctnName/SNOD$!loop
        do !i from 1 to 5
        sjoi $!i
            handle ANY
            elsehandle NONE
          name $!sctnName/SNOD$!loop/SJOI$!i
            endhandle
        enddo
      elsehandle ANY
      endhandle
    enddo

  --<wd>08mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update
  -- ONLY PROCESS WELDS for the 2nd SCTN for the NEW "Q3O" or "Q5O" SCTN types, i.d.
  --!!ce = !sctn
  if ((!second) and (defined(!sectionTwo))) then
    !!ce = !sectionTwo
    !sctn = !!ce
  else
    !!ce = !sctn
  endif
  --<wd>08mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

  !unusedCopyWelds = object MDSWELDLIST(!!ce,!!mdsSpecial)

  --<RM> 16/11/09 setup the edg picks for the t-assembly welds F-2273
  !this.newsctn = !sctn
  !function = !this.newsctn.function
  if !function.match('X1').gt(0) or !function.match('Q2').gt(0) or !function.match('Q3M').gt(0) or !function.match('Q4M').gt(0) or !function.match('M1').gt(0) or !function.match('O1').gt(0) then
    if !function.match('M1+P').eq(0) then
      !this.setupConnectionPicks()
    endif

    --<wd>08mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - Add the NEW "Q" SCTN types
  elseif ((!function.matchwild('Q3N-?')) or (!function.matchwild('Q4N-?'))) then
    !this.setupConnectionPicks()
  elseif ((!function.matchwild('Q3O-?')) or (!function.matchwild('Q5O-?'))) then
    !this.setupConnectionPicks()
    --<wd>08mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - Add the NEW "Q" SCTN types

  endif
  --<RM> 16/11/09 end of feature functionality
    if !flip then
      !!mdseditspsctn.setaxes()
    endif
endmethod
--------------------------------------------------------------------------------
define method .setsize()
  if !this.size.dtext[!this.size.pickedfield].eq('VAR') then
    -- we need to show a form to enter new value use
    -- second value of gadget as default
    !!ce = !this.sctn
    !!comProp(!!ce, 'EDIT')
  endif
endmethod
--  <RM> 10/11/09 .getWeldCase() method included for F-2273 development
--  get the welding case from the information provided
--  <inputs>
--  !mainProfile is the dbref of the main supporting profile
--  !connectingSctn is the dbref of the section connecting to the main supporting profile
--  <outputs>
--  returns a string with either 'CASE1', 'CASE2' or 'CASE3'
define method .getWeldCase(!mainProfile is DBREF, !connectingSctn is DBREF) is STRING
  --case1 size of !connectingSctn is a lot smaller than the main steel to connect to (2 or more sizes smaller) this is the default case
  --all round fillet weld with weld size = 0.7 x thickness (t) of tubular steel sctn wall of the !connectingSctn
  --case2 size of !connectingSctn is one size smaller than the main steel
  --fillet weld to top and bottom of connection, HY weld to both of the remaining sides of the connection, all at 0.7 x t
  --case3 size of !connectingSctn is equal in size to the main steel
  --fillet weld to top and bottom of connection, bevel weld to both of the remaining sides of the connection, all at 1.0 x t
  !sizeOfMainProfile = !mainProfile.para[1]
  !sizeOfConnectingProfile = !connectingSctn.para[1]
  --get lists of all available sizes of the !connectingSctn, we are only dealing with Areva X1_A series members and M1_A series members
  --which at time of writing have equal size tables i.e. 50,60,80,100,120,140,160,180,200,220 and 260 so we don't need
  --a complex algorithm to sort out relative size differences between different members
  !listOfMainMembers = !mainProfile.spref.owner.members
  !listOfSizes = object ARRAY()
  do !i from 1 to !listOfMainMembers.size()
    !listOfSizes.append(!listOfMainMembers[!i].para[1])
  enddo
  --order the size array in size order
  !listOfSizes.unique()
  !listOfSizes.sort()
  --get the difference in sizes between the connecting section and the main profile
  --array index of main steel profile
  !mainProfileIndex = !listOfSizes.findfirst(!sizeOfMainProfile)
  --array index of connecting steel
  !connectingProfileIndex = !listOfSizes.findfirst(!sizeOfConnectingProfile)
  !sizeDifference = !connectingProfileIndex - !mainProfileIndex
  if !sizeOfMainProfile.eq(!sizeOfConnectingProfile) then
    return 'CASE3'
  elseif !sizeDifference.abs().eq(1) then
    return 'CASE2'
  else
    return 'CASE1'
  endif
endmethod
--  <RM> 10/11/09 .modifyWeld() method included for F-2273 development
--  modify the standard welds generated by the MDSWELDLIST object in line with the connection case
--  <inputs>
--  !case is the string defined in the .getWeldCase method
--  !weldRef is the dbref of an existing weld on the steel member being created
--  !connectingSteel is the dbref of the section connecting to the main supporting profile
--  !mainProfile is the dbref of the main supporting profile
define method .modifyWeld(!case is STRING, !weldRef is DBREF, !connectingSteel is DBREF, !mainProfile is DBREF)
  if !case.eq('CASE1') then
    --do nothing the template welds are as required
    return
  else
    --get the square hollow section thickness
    !t = !connectingSteel.para[3]
    --get the weld size to be used
    if !case.eq('CASE2') then
      !weldSize = 0.7 * !t
      !weldSizeInt = !weldSize.int()
      if !weldSize.neq(!weldSizeInt) then
        -- round up to the nearest integer
        !weldSize = !weldSizeInt + 1
      endif
    else
      -- weldsize equals square hollow section thickness
      !weldSize = !t
      !weldSizeInt = !weldSize.int()
      if !weldSize.neq(!weldSizeInt) then
        -- round up to the nearest integer
        !weldSize = !weldSizeInt + 1
      endif
    endif
    --modify the existing joint 1 weld so that it is a top and bottom fillet weld (not all round)
    !this.modifyFilletWeld(!weldSize, !weldRef, !connectingSteel, !mainProfile)
    --create a new weld to each side of the connection
    !this.createWeld(!weldSize, !case, !weldRef, !connectingSteel, !mainProfile)
  endif
endmethod
--  <RM> 10/11/09 .modifyFilletWeld() method included for F-2273 development
--  modify the existing template fillet weld generated by the MDSWELDLIST object in line with the connection case
--  so that the weld is as required by case1, 2 or 3
--  <inputs>
--  !weldSize is the size of the weld required for the current welding case and is generated using the thickness of the !sctn wall
--  !weldRef is the dbref of the existing fillet weld on the steel member being created
--  !sctn is the dbref of the section connecting to the main supporting profile
--  !mainProfile is the dbref of the main supporting profile
define method .modifyFilletWeld(!weldSize is REAL, !weldRef is DBREF, !sctn is DBREF, !mainProfile is DBREF)
  --modify the description of the weld DDSE
  !weldRef.description =  'Field Fillet Weld Both Sides'
  --modify the weld symbol
  !symbolRef = !weldRef.name + '/SYMBOL'
  !symbolRef.dbref().ddProp = |'/MDS/SYMBOLS/WELD/FW/FILLET/BOTH/SIDES'|
  --modify the weld size
  !weldSizeRef = !weldRef.name + '/TAGTEXT'
  !sizeString = !weldSize.string()
  !sizeString = |'| + !sizeString + |'|
  !weldSizeRef.dbref().ddProp = |$!sizeString|
  --modify the position of the weld symbol
  --get the direction from poss to pose of the main profile
  !mainProfileDir = !mainProfile.posS.direction(!mainProfile.posE)
  --get the direction from TOS to BOS of the connecting sctn
  var !tosPos pos ppli tos of $!sctn wrt /*
  var !bosPos pos ppli bos of $!sctn wrt /*
  !connectedSctnDir = !tosPos.position().direction(!bosPos.position())
  --get the dot product between mainProfileDir and connectedSctnDir to determine which plines should be used for the
  --weld attachment
  !dotProduct = !mainProfileDir.dot(!connectedSctnDir)
  if !dotProduct.abs().gt(0.999) then
    !pline = 'TOS'
  else
    !pline = 'LEFT'
  endif
  --apply the new weld position
  !weldStartRef = !weldRef.name + '/START'
  !currentWeldPos = !weldStartRef.dbref().ddProp
  !currentWeldPos = $!currentWeldPos
  !currentWeldAxis = !currentWeldPos.split(',')[1]
  !newWeldPos = !currentWeldPos.replace(!currentWeldAxis, !pline)
  !newWeldPos = |('| + !newWeldPos + |')|
  !weldStartRef.dbref().ddProp = !newWeldPos
endmethod
--  <RM> 10/11/09 .createWeld() method included for F-2273 development
--  create a new weld in line with the connection case
--  <inputs>
--  !case is the string defined in the .getWeldCase method
--  !weldSize is the size of the weld required for the current welding case and is generated using the thickness of the !sctn wall
--  !weldRef is the dbref of the existing fillet weld on the steel member being created
--  !sctn is the dbref of the section connecting to the main supporting profile
--  !mainProfile is the dbref of the main supporting profile
define method .createWeld(!weldSize is REAL, !case is STRING, !weldRef is DBREF, !sctn is DBREF, !mainProfile is DBREF)
  !currentElem = !!ce
  if !case.eq('CASE2') then
    !symbol = |'/MDS/SYMBOLS/WELD/FW/HY/BOTH/SIDES'|
    !description = 'Field HY Weld Both Sides'
  else
    !symbol = |'/MDS/SYMBOLS/WELD/FW/BEVEL/BOTH/SIDES'|
    !description = 'Field Bevel Weld Both Sides'
  endif
  --navigate to !weldRef
  !!ce = !weldRef
  --navigate to last member in the template
  end
  !members = !!ce.members
  --find only those welds that exist for the current sctn
  !numWelds = 0
  do !i from 1 to !members.size()
    if !members[!i].namn.match(!weldRef.namn.before('/')).gt(0) then
      !numWelds = !numWelds + 1
      !lastMem = !members[!i]
    endif
  enddo
  !!ce = !lastMem
  handle ANY
  endhandle
  --add a new ddse copied from !weldRef first we need to find out what the next weld number is
  !name = !weldRef.name
  !currentWeldNum = !weldRef.namn.after('/')
  !numWelds = !numWelds + 1
  !weldNum = 'WELD' + !numWelds.string()
  !name = !name.replace(!currentWeldNum, !weldNum)
  --create replacement names for the copy operation
  !replace1 = '/' + !currentWeldNum
  !replace2 = '/' + !weldNum
  --copy the ddse and rename
  new ddse $!name copy $!weldRef rename $!replace1 $!replace2
  !newWeldRef = !!ce
  --modify the description of the weld DDSE
  !newWeldRef.description =  !description
  --modify the weld symbol
  !symbolRef = !newWeldRef.name + '/SYMBOL'
  !symbolRef.dbref().ddProp = !symbol
  --modify the weld size
  !weldSizeRef = !newWeldRef.name + '/TAGTEXT'
  !sizeString = !weldSize.string()
  !sizeString = |'| + !sizeString + |'|
  !weldSizeRef.dbref().ddProp = |$!sizeString|
  --last thing to do is to add the new weld to the weld list on the sctn
  !weldArray = !sctn.:MDSWeldData
  !weldArray.append(!newWeldRef)
  !sctn.:MDSWeldData = !weldArray
  --modify the position of the weld symbol
  --get the direction from poss to pose of the main profile
  !mainProfileDir = !mainProfile.posS.direction(!mainProfile.posE)
  --get the direction from TOS to BOS of the connecting sctn
  var !tosPos pos ppli tos of $!sctn wrt /*
  var !bosPos pos ppli bos of $!sctn wrt /*
  !connectedSctnDir = !tosPos.position().direction(!bosPos.position())
  --get the dot product between mainProfileDir and connectedSctnDir to determine which plines should be used for the
  --weld attachment
  !dotProduct = !mainProfileDir.dot(!connectedSctnDir)
  if !dotProduct.abs().gt(0.999) then
    !pline = 'LEFT'
  else
    !pline = 'TOS'
  endif
  --apply the new weld position
  !weldStartRef = !newWeldRef.name + '/START'
  !currentWeldPos = !weldStartRef.dbref().ddProp
  !currentWeldPos = $!currentWeldPos
  !currentWeldAxis = !currentWeldPos.split(',')[1]
  !newWeldPos = !currentWeldPos.replace(!currentWeldAxis, !pline)
  !newWeldPos = |('| + !newWeldPos + |')|
  !weldStartRef.dbref().ddProp = !newWeldPos
  !!ce = !currentElem
endmethod
--  <RM> 13/11/09 .createWeld() method included for F-2273 development
--  create a new weld in line with the connection case
--  <inputs>
--  !case is the string defined in the .getWeldCase method
--  !weldSize is the size of the weld required for the current welding case and is generated using the thickness of the !sctn wall
--  !weldRef is the dbref of the existing fillet weld on the steel member being created
--  !sctn is the dbref of the section connecting to the main supporting profile
--  !mainProfile is the dbref of the main supporting profile
define method .getExistingCase(!list is ARRAY) is ARRAY
  !filletWeldBothSides = FALSE
  !hYWeldBothSides = FALSE
  !bevelWeldBothSides = FALSE
  do !i from 1 to !list.size()
    !name = !list[!i].name + '/SYMBOL'
    !ddPropString = !name.dbref().ddProp
    !name1 = !list[!i].name + '/START'
    !ddPropString1 = !name1.dbref().ddProp
    !ddProp1 = $!ddPropString1
    if !ddPropString.match('/MDS/SYMBOLS/WELD/FW/FILLET/BOTH/SIDES').gt(0) then
      if !ddProp1.eq('TOS,START') or !ddProp1.eq('LEFT,START') or !ddProp1.eq('LEFT,END') or !ddProp1.eq('TOS,END') then
        !filletWeldBothSides = TRUE
        !filletWeldBothSidesRef = !list[!i]
      endif
    elseif !ddPropString.match('/MDS/SYMBOLS/WELD/FW/HY/BOTH/SIDES').gt(0) then
      if !ddProp1.eq('TOS,START') or !ddProp1.eq('LEFT,START') or !ddProp1.eq('LEFT,END') or !ddProp1.eq('TOS,END') then
        !hYWeldBothSides = TRUE
        !hYWeldBothSidesRef = !list[!i]
      endif
    elseif !ddPropString.match('/MDS/SYMBOLS/WELD/FW/BEVEL/BOTH/SIDES').gt(0) then
      if !ddProp1.eq('TOS,START') or !ddProp1.eq('LEFT,START') or !ddProp1.eq('LEFT,END') or !ddProp1.eq('TOS,END') then
        !bevelWeldBothSides = TRUE
        !bevelWeldBothSidesRef = !list[!i]
      endif
    endif
  enddo
  if !filletWeldBothSides and !hYWeldBothSides then
    !case = 'CASE2'
    !caseWeld1 = !filletWeldBothSidesRef
    !caseWeld2 = !hYWeldBothSidesRef
  elseif !filletWeldBothSides and !bevelWeldBothSides then
    !case = 'CASE3'
    !caseWeld1 = !filletWeldBothSidesRef
    !caseWeld2 = !bevelWeldBothSidesRef
  else
    !case = 'CASE1'
    !caseWeld1 = object DBREF()
    !caseWeld2 = object DBREF()
  endif
  !caseArray = object ARRAY()
  !caseArray.append(!case)
  !caseArray.append(!caseWeld1)
  !caseArray.append(!caseWeld2)
  return !caseArray
endmethod
--  <RM> 17/11/09 .setupWelds() method included for F-2273 development
--  use !mainProfile1, !mainProfile2 and the selected end of the new sctn that has T-joint1 attached to
--  determine welding cases that need to be applied to the sctn
--  <inputs>
--  !mainProfile1 is the dbref of the sctn that connects to the new sctn to for T-joint1
--  !mainProfile2 is the dbref of the sctn that connects to the new sctn to for T-joint2
--  !tJoint1SelectedEnd is a string which indicates the end of the new sctn that T-joint1 is attached to ('POSE' or 'POSS')
--  <outputs>
define method .setupWelds(!mainProfile1 is DBREF, !mainProfile2 is DBREF, !tJoint1SelectedEnd is STRING)
  --<RM> 09/11/09 setup boolean variables to determine whether or not we apply specific weld rules to a "T" connection for F-2273 development
  !tJoint1WeldSet = FALSE
  !tJoint2WeldSet = FALSE
  --<RM> 09/11/09
  --<RM> 09/11/09 determine whether or not we apply specific weld rules to a t connection for F-2273 development
  -- identify the main profile for the t joint
  -- i.e. this one --> | |-----
  --                   | |-----
  --                   | |
  if !mainProfile1.unset().not() then
    if !tJoint1SelectedEnd.unset().not() then
      !tJoint1WeldSet = TRUE
      --now select the second main profile to connect the other end to (if applicable)
      if !mainProfile2.unset().not() then
        !tJoint2WeldSet = TRUE
      endif
    endif
  endif
  --<RM> 09/11/09
  --<RM> 09/11/09 setup specific t connection welds for F-2273 development
  if !tJoint1WeldSet then
    --get a list of welds on the current sctn
    !sctnWeldList = !this.newsctn.:MDSWeldData
    --associate each weld with the !tJoint1SelectedEnd and T-joint2SelectedEnd (which is the opposite of !tJoint1SelectedEnd)
    !weld1Start = !sctnWeldList[1].name + '/START'
    !weld1PosProp = !weld1Start.dbref().ddProp
    !weld1PosPropExpanded = $!weld1PosProp
    !weld1Pos = !weld1PosPropExpanded.split(',')[2]
    if !sctnWeldList.size().eq(2) then
      if !tJoint1SelectedEnd.eq('POSS') then
        if !weld1Pos.eq('START') then
          !tJoint1WeldPointer = !sctnWeldList[1]
        else
          !tJoint1WeldPointer = !sctnWeldList[2]
        endif
      else
        if !weld1Pos.eq('START') then
          !tJoint1WeldPointer = !sctnWeldList[2]
        else
          !tJoint1WeldPointer = !sctnWeldList[1]
        endif
      endif
    elseif !sctnWeldList.size().eq(1) then
      --there is only 1 weld, this happens in the case of a Q2, Q3M and Q4M type
      !tJoint1WeldPointer = !sctnWeldList[1]
    else
      --there are no welds to modify which is an invalid case
      !tJoint1WeldPointer = object DBREF()
    endif
    -- only proceed if we have a valid weld to modify
    if !tJoint1WeldPointer.set() then
      !weldCase1 = !this.getWeldCase(!mainProfile1, !this.newsctn)
      !this.modifyWeld(!weldCase1, !tJoint1WeldPointer, !this.newsctn, !mainProfile1)
    endif
  endif
  -- process the weld on the end that is connected to main profile 2, this will not happen in the case of a Q2, Q3M or Q4M
  -- as we can only connect to one end
  if !tJoint2WeldSet then
    !weld2Start = !sctnWeldList[2].name + '/START'
    !weld2PosProp = !weld2Start.dbref().ddProp
    !weld2PosPropExpanded = $!weld2PosProp
    !weld2Pos = !weld2PosPropExpanded.split(',')[2]
    if !tJoint1SelectedEnd.eq('POSS') then
      if !weld2Pos.eq('START') then
        !tJoint2WeldPointer = !sctnWeldList[1]
      else
        !tJoint2WeldPointer = !sctnWeldList[2]
      endif
    else
      if !weld2Pos.eq('START') then
        !tJoint2WeldPointer = !sctnWeldList[2]
      else
        !tJoint2WeldPointer = !sctnWeldList[1]
      endif
    endif
    !weldCase2 = !this.getWeldCase(!mainProfile2, !this.newsctn)
    !this.modifyWeld(!weldCase2, !tJoint2WeldPointer, !this.newsctn, !mainProfile2)
  endif
  --end of feature 2273 additions
endmethod
--  <RM> 17/11/09 .setupConnectionPicks() method included for F-2273 development
--  set up the initial EDG pick to get main profile 1
--  <inputs>
--  <outputs>
define method .setupConnectionPicks()
  !this.mainProfile1 = object DBREF()
  !this.mainProfile2 = object DBREF()
  !this.endpos = object STRING()
  --define the edg packet
  !packet = object EDGPACKET()
  !packet.description = 'TJOINTPICKPACKET'
  !packet.priority = 0
  !packet.remove = FALSE
  !packet.pickpacket.picks[1] = object EDGPICKTYPE()
  !packet.pickpacket.picks[1].stdElement('Select main profile for T-Joint conn. 1, (pres ESC to ignore connection)')
  !packet.action = '!!mdsCopyFraSctn.validatePick1(!this.return)'
  !packet.escape = '!!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)'
  !!edgcntrl.add(!packet)
endmethod
--  <RM> 17/11/09 .validatePick1() method included for F-2273 development
--  this is the corresponding action command to the first EDG pick, it validates the pick to make sure that it has been made on
--  an appropriate sctn for t-assembly, if it has then we create the next pick
--  <inputs>
--  !edgPickArray is an array of edgPickData that is supplied when the EDG pick event is fired
--  <outputs>
define method .validatePick1(!edgPickArray is ARRAY)
  !pickData = !edgPickArray[1]
  if !this.newsctn.eq(!pickData.item) then
    !!alert.message('cannot pick the new sctn, pick must be made on an existing connecting sctn')
  elseif !pickData.item.spref.namn.match('/X1').eq(0) and !pickData.item.spref.namn.match('/M1').eq(0) and !pickData.item.spref.namn.match('/O1').eq(0) then
    !!mdsCopyFraSctn.mainProfile1 = object DBREF()
    --remove the existing edg packet so we can replace it with the next pick
    !!edgcntrl.remove('TJOINTPICKPACKET')
    !!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile1, object STRING())
  else
    !!mdsCopyFraSctn.mainProfile1 = !pickData.item
    --remove the existing edg packet so we can replace it with the next pick
    !!edgcntrl.remove('TJOINTPICKPACKET')
    --define the edg packet
    !packet = object EDGPACKET()
    !packet.description = 'TJOINTPICKPACKET'
    !packet.priority = 0
    !packet.remove = FALSE
    !packet.pickpacket.picks[1] = object EDGPICKTYPE()
    !packet.pickpacket.picks[1].stdElement('identify end of new SCTN for T-Joint')
    !packet.action = '!!mdsCopyFraSctn.validatePick2(!this.return)'
    !packet.escape = '!!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)'
    !!edgcntrl.add(!packet)
  endif
endmethod
--  <RM> 17/11/09 .validatePick2() method included for F-2273 development
--  this is the corresponding action command to the second EDG pick, it validates the pick to make sure that it has been made on
--  the new sctn that has been created or modified and then it gets the closest end on the sctn to the position on
--  the screen that was picked. this defines the location of the first t-connection. if no escape is pressed then we create the next pick
--  <inputs>
--  !edgPickArray is an array of edgPickData that is supplied when the EDG pick event is fired
--  <outputs>
define method .validatePick2(!edgPickArray is ARRAY)
  !pickData = !edgPickArray[1]
  if !this.newsctn.neq(!pickData.item) then
    !!alert.message('pick must be made on required end of the new sctn')
  else
    -- Find out which end of the sctn was identified
    !!ce = !pickData.item
    !vector = !pickData.pickline
    -- create a line along the length of the identified SCTN
    !pidSctn = object LINE()
    !pidSctn.startposition = !pickData.item.posS.wrt(/* )
    !pidSctn.endposition   = !pickData.item.posE.wrt(/* )
    -- find the intersection point of the vector and the identified SCTN
    !intersection = !vector.intersection(!pidSctn)
    -- get the position of the intersection on the identified SCTN
    !prop = !pidSctn.near(!intersection)
    -- calculate the distance of the intersection from the poss of the identified SCTN
    !startDist = !pidSctn.startposition.distance(!prop)
    -- if the distance from the start of the identified SCTN is gt half the length its the end
    if !startDist.gt(0.5 * !pidSctn.length()) then
      !!mdsCopyFraSctn.endpos = 'POSE'
    else
      !!mdsCopyFraSctn.endpos = 'POSS'
    endif
    --remove the existing edg packet so we can replace it with the next pick
    !!edgcntrl.remove('TJOINTPICKPACKET')
    -- we know that the spref of the picked sctn is valid but we also need to check the function of the sctn to make sure that we don't have
    -- a type such as Q2,Q3M,Q4M etc that only accept a connection on one end
    if !this.newsctn.function.match('X1').eq(0) then
      !!mdsCopyFraSctn.mainProfile2 = object DBREF()
      !!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)
    else
      --define the edg packet for the last pick
      !packet = object EDGPACKET()
      !packet.description = 'TJOINTPICKPACKET'
      !packet.priority = 0
      !packet.remove = FALSE
      !packet.pickpacket.picks[1] = object EDGPICKTYPE()
      !packet.pickpacket.picks[1].stdElement('Select main profile for T-Joint conn. 2, (pres ESC to ignore connection)')
      !packet.action = '!!mdsCopyFraSctn.validatePick3(!this.return)'
      !packet.escape = '!!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)'
      !!edgcntrl.add(!packet)
    endif
  endif
endmethod
--  <RM> 17/11/09 .validatePick3() method included for F-2273 development
--  this is the corresponding action command to the third and last EDG pick, it validates the pick to make sure that it has been made on
--  an appropriate sctn for t-assembly. when a valid pick is received we run the setup welds method using all three pieces of data received
--  in the pick process
--  <inputs>
--  !edgPickArray is an array of edgPickData that is supplied when the EDG pick event is fired
--  <outputs>
define method .validatePick3(!edgPickArray is ARRAY)
  !pickData = !edgPickArray[1]
  if !this.newsctn.eq(!pickData.item) then
    !!alert.message('cannot pick the new sctn, pick must be made on an existing connecting sctn')
  elseif !pickData.item.spref.namn.match('/X1').eq(0) and !pickData.item.spref.namn.match('/M1').eq(0) and !pickData.item.spref.namn.match('/O1').eq(0) then
    !!mdsCopyFraSctn.mainProfile2 = object DBREF()
    --remove the existing edg packet
    !!edgcntrl.remove('TJOINTPICKPACKET')
    !!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)
  else
    !!mdsCopyFraSctn.mainProfile2 = !pickData.item
    --remove the existing edg packet
    !!edgcntrl.remove('TJOINTPICKPACKET')
    !!mdsCopyFraSctn.setupWelds(!!mdsCopyFraSctn.mainProfile1, !!mdsCopyFraSctn.mainProfile2, !!mdsCopyFraSctn.endpos)
  endif
endmethod
