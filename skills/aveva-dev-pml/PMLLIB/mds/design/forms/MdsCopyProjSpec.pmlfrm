--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- If a piping project special sort on the bore using :mdsminbore and :mdsmaxbore
-- at the stru level
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Revision       : Introduced a two new checks as follows
--                  (1) Check of the stru :MDSHVACType uda of either RECT or CIRC
--                      for the ducr shape
--                  (2) Introduced a check against the HVAC branch :MdsDType attribute
--                      and the project special stru :MDSDType.
--                      This can be used for instance separating welded/seamed standards
--                      If the :MDSDtype/:MdsDType is unset then it will be added to the available
--                      list
--                      The means the checking is now done in the following order
--                      1 = :MDSHVACType of stru against the pa of the identified component
--                      2 = :MDSDType of stru is equal to the :MdsDtype of the HVAC branch
--                      3 = as <1> below
--                      4 = as <2> below
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Revision        : <1> Introduced the setting of the :MDSRANGE attribute at HVAC Stru Elements
--                       of the MDS HVAC Project Special templates to:
--                       <a> '0' = <ONLY used for SUPPORORTING an *** UNINSULATED *** HVAC Duct>
--                       <b> '1' = <ONLY used for SUPPORORTING an **** INSULATED **** HVAC Duct>
--                       <c> '2' or 'any value' or default<unset> =  <used for SUPPORORTING BOTH INSULATED and UNINSULATED HVAC Ducts>
--                   <2> :MDSCHECK attribute at STRU HVAC PROJECT Special template set to:
--                       <a> TRUE  = <When Building the HVAC SUPPORT in the MDS application ** INCLUDE ** the INSULATION Thickness
--                           on the HVAC Duct in the SUPOORT calculations, if any INSULATION EXISTS
--                       <b> FALSE = <When Building the HVAC SUPPORT in the MDS application ** EXCLUDE ** the INSULATION Thickness
--                           on the HVAC Duct in the SUPOORT calculations, if any INSULATION EXISTS
--------------------------------------------------------------------------------
-- Description:
-- Form Definition for copying a project special
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copy(STRING)                     -
--  init(STRING)                     -
--  mirror()                         -
--  setFilter(STRING)                -
--

-- Kill existing form definition
Kill !!mdsCopyProjSpec

/MDS/SPECIALS/HVAC/ACF
handle NONE
  !func = func
elsehandle ANY
  !func = ''
endhandle

-- Define Form
setup form  !!mdsCopyProjSpec

  !this.formTitle = 'Select Project Special Template'

  list .selection || call |!this.copy('LIST')| height 20 width 64

  path down

  text .filter    |Filter | call |!this.setFilter('FORM')| width 14 name
  !this.filter.val = '*'

  path right

  toggle .buildWithMirror 'Mirror ' call |!this.copy('LIST')| at xmax+35 ymin
  path down

  !offset = 0.5

  !this.filter.active = TRUE
  if !func.eq('FRAMATOME HVAC') then
    !this.filter.active = FALSE
    !offset = 2
    rgroup .char1 at x1 ymax+0.5 vertical call |!this.setFilter('FORM')|
      add tag 'Dead Load H (A)'
      add tag 'Guide     H (B)'
      add tag 'Fixed     H (B)'
      add tag 'Guide     V (C)'
      add tag 'Fixed     V (C)'
      add tag 'Swinging  H (D)'
    exit
    path right
    rgroup .char2 vertical call |!this.setFilter('FORM')|
      add tag 'Ceiling (C)'
      add tag 'Wall    (W)'
      add tag 'Floor   (F)'
    exit
    path right
    rgroup .char3 vertical call |!this.setFilter('FORM')|
      add tag 'Folded (F)'
      add tag 'Welded (W)'
      add tag 'Round (R)'
    exit
    path right
    rgroup .char4 vertical call |!this.setFilter('FORM')|
      add tag 'Anchor Plts (1)'
      add tag 'Anchor Chan (3)'
      add tag 'Dowel  Plts (4)'
    exit

  endif
  -- Filter members
  member .load is STRING
  member .ori is STRING
  member .type is STRING
  member .extrafilter is STRING
  !this.extrafilter = ''

  path right

  button .cancel | Dismiss | at xmax_selection-11 ymax.char1-0.4 CANCEL
  handle ANY
    button .cancel | Dismiss | at xmax_selection-9 ymax CANCEL
  endhandle

  -- End form definition
exit

-----------------------------------------------------------------------
-- Method to initialise the MDS Project Special template selection form
-----------------------------------------------------------------------

define method .init(!method is STRING)

  -- Reset filter if necessary

  if !this.shown().not() then
    !this.filter.val = '*'
  endif

  -- Set the mirror gadget dependant on the :MdsFraMirror setting because
  -- it may has been with mirror before

  !this.buildWithMirror.val = !!mdsSpecial.support.stru.:MdsFraMirror

  -- Current DB position

  !ce = !!ce

  -- Access datum element

  !!ce = !!mdsSpecial.support.datum
  handle ANY
    !!alert.error('Datum atta does not exist!')
    return
  endhandle

  -- Determine type of special PIPE/HVAC/TRAY

  !type = purp of pspe of pipe
  handle ANY
    !type = purp of pspe of hvac
    handle ANY
      pipe
      handle ANY
        hvac
      endhandle
      !type = type
      !!alert.error('Unable to determine the type of special required as the pspe attribute is unset at $!type level')
      return
    endhandle
  endhandle

  -- Determine if support is hori or vert and has insulation
  -- The :MdsHV uda will be set to BOTH/VERT/HORI to determine if the special
  -- template is available
  -- The :mdsrange is used for '1' for insulation and '0' for uninsulated - See line 102 below

  !plDir = Pl dir

  if !plDir.string().before(' WRT').eq('U') or !plDir.string().before(' WRT').eq('D') or !plDir.string().before(' WRT').eq('Z') or !plDir.string().before(' WRT').eq('-Z') then
    !ori = 'VERT'
    !this.load = 'VERT'
    handle ANY
    endhandle
  else
    !ori = 'HORI'
    !this.load = 'HORI'
    handle ANY
    endhandle
  endif

  -- Determine if duct has insulation

  var !insu insu
  if (!insu.real().eq(0)) then
    !noinsu = TRUE
  else
    !noinsu = FALSE
  endif

  -- Get duct type and shape if HVAC special

  if !type.eq('HVAC') then
    !dtype = :MdsDtype of bran
    !hVACConn = styp of lstu
    if !hVACConn.eq('RTUB') then
      !hvacConnType = 'RECT'
    elseif !hVACConn.eq('CTUB') then
      !hvacConnType = 'CIRC'
    endif
  endif

  !this.type = !hvacConnType
  handle ANY
  endhandle

  -- Find /MDS/SPECIALS specials template site
  -- and collect all structure available for specific type required

  /MDS/SPECIALS
  handle ANY
    !!alert.error('Unable to find project special templates site /MDS/SPECIALS')
    return
  elsehandle NONE
    if !type.eq('PIPE') then
      var !stru coll all stru with matchwild(name,'*PIPE*') for /MDS/SPECIALS
    elseif !type.eq('HVAC') then
      var !stru coll all stru with matchwild(name,'*HVAC*') for /MDS/SPECIALS
    else
      var !stru coll all stru with matchwild(name,'*TRAY*') for /MDS/SPECIALS
    endif
  endhandle

  -- Error if no strus are found

  if !stru.size().eq(0) then
    !!alert.error('Unable to find any project specials suitable for selected type ($!type)')
    return
  endif

  ------------------------------------------------------------
  -- Loop thro the !stru array
  -- and DELETE unwanted templates from the !stru array
  ------------------------------------------------------------

  ------------------------------------------------------------
  -- Check 1 -> MDS Special Template Stru :MDSHVACType =
  --            connection type of component
  ------------------------------------------------------------

  if !type.eq('HVAC') then
    do !filterStrus indices !stru
      if !stru[$!filterStrus].dbref().:MdsHVACType.eq('$!hvacConnType') then
      elseif !stru[$!filterStrus].dbref().:MdsHVACType.eq('unset') then
      else
        !stru[$!filterStrus].delete()
      endif
    enddo
    !stru.compress()
  endif

  ------------------------------------------------------------
  -- Check 2 -> MDS Special Template Stru :MDSDtype = :MdsDtype of HVAC branch
  ------------------------------------------------------------

  if !type.eq('HVAC') then
    do !filterStrus indices !stru
      if !stru[$!filterStrus].dbref().:MdsDtype.eq('$!dtype') then
      elseif !stru[$!filterStrus].dbref().:MdsDtype.eq('unset') then
      else
        !stru[$!filterStrus].delete()
      endif
    enddo
    !stru.compress()
  endif

  ------------------------------------------------------------
  -- Check 3 -> MDS Special Template Stru :MDSHV = 'HORI' or 'VERT' - ORI of the Identified element
  --      or -> MDS Special Template Stru :MDSHV = 'BOTH'
  ------------------------------------------------------------

  do !filterStrus indices !stru
    if !stru[$!filterStrus].dbref().:MdsHV.eq('$!ori') or !stru[$!filterStrus].dbref().:MdsHV.eq('BOTH') then
    else
      !stru[$!filterStrus].delete()
    endif
  enddo
  !stru.compress()

  ------------------------------------------------------------
  -- Check 4 -> New Check against the MDS Special template Stru Uda = :mdsrange
  ------------------------------------------------------------
  -- ***********************
  -- *** IMPORTANT NOTE: ***
  -- ***********************
  -- The STRU elements in the HVAC MDS Special templates SITE are the ONLY templates
  -- that NEED the :MDSRANGE uda value set to '0' for UNINSULATED Ducts or '1' for INSULATED Ducts
  -- or set to '2' or ANY other VALUE including the default of 'unset' for BOTH type of HVAC Ducts
  --
  -- The PIPE and CABLE TRAY MDS Special templates STRU elements
  -- Currently DO NOT NEED the :MDSRANGE uda to be set.
  ------------------------------------------------------------
  do !filterStrus indices !stru

    -- <1> Get the list of MDS Special templates available for INSULATED HVAC Ducts Only ('1') or Both ('2' or any other value except '0')
    -- DELETE from the ARRAY the Stru templates NOT available for INSULATED HVAC Ducts

    if ((!stru[$!filterStrus].dbref().:mdsrange inset ('0')) and (!noinsu.not())) then
      !stru[$!filterStrus].delete()
    endif

    -- <2> Get the list of MDS Special templates available for UNINSULATED HVAC Ducts Only ('0') or Both ('2' or any other value except '1')
    -- DELETE from the ARRAY the Stru templates NOT available for UNINSULATED HVAC Ducts

    if ((!stru[$!filterStrus].dbref().:mdsrange inset ('1')) and (!noinsu)) then
      !stru[$!filterStrus].delete()
    endif

  enddo

  -- Remove any strus that do not match the filter that is set
  -- If it is set to * then ignore
  if !this.filter.val.eq('*').not() then
    do !remove from 1 to !stru.size()
      if !stru[$!remove].dbref().desc.matchwild(!this.filter.val).not() then
        !stru[$!remove].delete()
      endif
    enddo
  endif

  -- If a piping project special sort on the bore
  if !type.eq('PIPE') then
    !bore = !!mdsSpecial.support.datum.abor
    do !remove from 1 to !stru.size()
      !tempMinBore = !stru[$!remove].dbref().:MdsMinBore
      !tempMaxBore = !stru[$!remove].dbref().:MdsMaxBore
      !realBore = !bore.real()
      if !realBore.lt(!tempMinBore) then
        !stru[$!remove].delete()
      endif
      if !realBore.gt(!tempMaxBore) then
        !stru[$!remove].delete()
      endif
    enddo
  endif

  !stru.compress()

  --<tm> now go through the list and apply the extrafilter

  if !this.extrafilter.neq('')then
    do !remove from 1 to !stru.size()
      if !this.extrafilter.match(!stru[$!remove].dbref().desc.substring(4,2)).eq(0) then
        !stru[$!remove].delete()
      endif
    enddo
  endif
  !stru.compress()

  ------------------------------------------------------------

  var !desc eval desc for all from !stru
  var !dbrefs eval ref for all from !stru
  !this.selection.dtext = !desc
  !this.selection.rtext = !dbrefs

  -- Add number of selected templates to form title

  !numberOfSelectedStrus = !desc.size()
  !this.formTitle = 'Select Project Special Template ($!numberOfSelectedStrus)'

  -- Add special filters if displaying form

  !test = !this.char1
  handle ANY
  elsehandle NONE
    if !method.eq('SHOW') then
      if !this.load.eq('HORI') then
        !this.char1.val = 1
        !this.char2.val = 1
      elseif !this.load.eq('VERT') then
        !this.char1.val = 4
        !this.char2.val = 2
      endif
      if !hvacConnType.eq('RECT') then
        if !dtype.eq('FOLDED') then
          !this.char3.val = 1
        elseif !dtype.eq('WELDED') then
          !this.char3.val = 2
        else
          !!alert.error('Unable to determine if the duct is FOLDED/WELDED from the :MdsDtype at branch level')
          return
        endif
      elseif !hvacConnType.eq('CIRC') then
        !this.char3.val = 3
      endif
      !this.char3.active = FALSE
    endif
  endhandle

  -- Try to find the existing template is was copied from

  !!ce = !!mdsSpecial.support.stru
  !mdsProjSpec = !!ce.:MdsProjSpec.string()
  !canIFindIt = !this.selection.rtext.find(!mdsProjSpec)
  if !canIFindIt.unset().not() then
    !this.selection.val = !canIFindIt[1]
  endif
  -- Show form if method set to SHOW
  if !method.eq('SHOW') then
    show !!mdsCopyProjSpec
    !this.setFilter(|CODE|)
  endif

  -- If the specials has been created we may need to reset the filter and select the correct one
  -- Test if filter exist by testing !this.char1

  !unusedTestForFilters = !this.char1
  handle ANY
  elsehandle NONE
    !tempDesc = !!mdsSpecial.support.stru.:MdsProjSpec.desc
    handle ANY
    elsehandle NONE
      if !!mdsSpecial.support.stru.:MdsProjSpec.owner.func.eq('FRAMATOME HVAC') then
        if !type.eq('HVAC') then
          if !method.eq('SHOW') then
            !char1 = !tempDesc.substring(1,1)
            !char2 = !tempDesc.substring(2,1)
            !char3 = !tempDesc.substring(3,1)
            !char4 = !tempDesc.substring(4,1)
            !char5 = !tempDesc.substring(5,1)
            -- Set the appropiate filters and then run setfilter only if method eq 'SHOW'
            -- Character 1
            if !char1.eq('A') then
              !this.char1.val = 1
            elseif !char1.eq('B') then
              if '$!char4$!char5' eq '12' or '$!char4$!char5' eq '42' then
                !this.char1.val = 2
              else
                !this.char1.val = 3
              endif
            elseif !char1.eq('C') then
              if '$!char4$!char5' eq '12' or '$!char4$!char5' eq '42' then
                !this.char1.val = 4
              else
                !this.char1.val = 5
              endif
            else
              !this.char1.val = 6
            endif
            -- Character 2
            if !char2.eq('C') then
              !this.char2.val = 1
            elseif !char2.eq('W') then
              !this.char2.val = 2
            else
              !this.char2.val = 3
            endif
            -- Character 3, not required
            if !char3.eq('F') then
              !this.char3.val = 1
            elseif !char3.eq('W') then
              !this.char3.val = 2
            else
              !this.char3.val = 3
            endif
            -- Character 4
            if !char4.eq('1') then
              !this.char4.val = 1
            elseif !char4.eq('3') then
              !this.char4.val = 2
            else
              !this.char4.val = 3
            endif
            if !method.eq('SHOW') then
              !this.setFilter(|CODE|)
            endif
          endif
        endif
      endif
    endhandle
  endhandle

  -- Access starting DB position
  !!ce = !ce

endmethod

----------------------------------------------------------
-- Method to copy a special template
----------------------------------------------------------

define method .copy(!method is STRING)

  if undefined(!!debug) then
    !!debug = FALSE
  endif

  -- if !method.eq('LIST') and !this.buildOnSelection.val then
  if !method.eq('LIST') then
  elseif !method.eq('OK') then
  elseif !method.eq('ROTATE') then
  else
    return
  endif

  -- Access stru element

  !!ce = !!mdsSpecial.support.stru

  -- If they are connected the check with user

  var !currentSctns coll all sctn for ce
  var !connected eval :mdspconn for all from !currentSctns
  !connected.unique()
  if !connected.size().eq(1) then
    if !connected[1].eq('unset') or !connected.eq('') then
    else
      if !!alert.confirm('The support is connected to plate/s and the connection will be lost. Are you sure you want to continue?').eq('NO') then
        return
      endif
    endif
  elseif !connected.size().eq(0) then
  else
    if !!alert.confirm('The support is connected to plate/s and the connection will be lost. Are you sure you want to continue?').eq('NO') then
      return
    endif
  endif

  -- Clear connections from plates before regenerating support

  !!ce = !!mdsSpecial.support.stru
  !savedRotate = :MdsSplRot

  do !clearConnections values !currentSctns
    !sctnConn = !clearConnections.dbref().:MdsPconn
    if !sctnConn.size().gt(0) then
      if !sctnConn[1].badref().not() then
        !!mdsSbfiConn('DELETE',!clearConnections.dbref(),!sctnConn[1],'VERBOSE')
      endif
    endif
  enddo

  !!ce = !!mdsSpecial.support.stru

  -- If it already has members delete them

  var !members coll all sctn for ce
  !noOfMembers = !members.size()
  --delete stru mem
  --handle any
  --endhandle

  if !method.eq('ROTATE') then
    !template = :MdsProjSpec
    !templateName = !template.name
    handle ANY
      !angle = !!mdsRotSpecial.angle.val
      if !angle.gt(0) then
        !angle = -1 * !angle
      else
        !angle = !angle.abs()
      endif
      rotate about pin 9 by $!angle
      pin 9 off
      --if !!alert.confirm('This support was not created from a project special. Do you want to rotate the whole support about the datum atta?').eq('YES') then
      !!ce = !!mdsSpecial.support.stru
      var !oriy dir y
      same
      !plDir = !!mdsSpecial.support.datum.ldir.wrt(/* )
      -- ROTATE through pl of $!!mdsSpecial.support.stru about pl of $!!mdsSpecial.support.datum by $!!mdsRotSpecial.angle.val
      ROTATE through pl of $!!mdsSpecial.support.datum about $!oriy by $!!mdsRotSpecial.angle.val
      do !loop values !!mdsSpecial.support.atta
        !!ce = !loop
        rotate thro  pl about pl by $!!mdsRotSpecial.angle.val
      enddo
      return
      --else
      --return
      --endif
    endhandle
    delete stru mem
    handle ANY
    endhandle
    !supportname = !!mdsSpecial.support.stru.name
    !nameOfTemplate = !template.name
    copy mem of $!nameOfTemplate rename $!templateName $!supportname
    desc (desc of $!template )
    :MdsCheck (:Mdscheck of $!template )
    :MdsProjSpec $!template
    !mdsSplRot = :MdsSplRot
    !mdsSplRot = !mdsSplRot + !!mdsRotSpecial.angle.val
    if !mdsSplRot.gt(360) then
      !numOf = !mdsSplRot / 360
      !numOf.int()
      !toTakeOff = 360 * $!numOf
      !mdsSplRot = !mdsSplRot - !toTakeOff
    endif
    if !mdsSplRot.eq(360) then
      !mdsSplRot = 0
    endif
    :MdsCheck (:Mdscheck of $!template )
    :MdsSplRot $!mdsSplRot
  else
    !template = !!mdsCopyProjSpec.selection.selection()
    !templateName = !!mdsCopyProjSpec.selection.selection().dbref().name
    !supportname = !!mdsSpecial.support.stru.name
    !nameOfTemplate = !template.dbref().name
    delete stru mem
    handle ANY
    endhandle
    copy mem of $!nameOfTemplate rename $!templateName $!supportname
    desc (desc of $!template )
    :MdsCheck (:Mdscheck of $!template )
    :MdsSplRot $!savedRotate
    !mdsSplRot = !savedRotate
    :MdsProjSpec $!template
  endif

  !datum = !!mdsSpecial.support.datum

  !plDir = Pl dir of $!datum

  if !plDir.string().before(' WRT').eq('U') or !plDir.string().before(' WRT').eq('D') or !plDir.string().before(' WRT').eq('Z') or !plDir.string().before(' WRT').eq('-Z') then
    !ori = 'VERT'
  else
    !ori = 'HORI'
  endif

  -- Position the STRU at the DATUM ATTA

  if !this.type.eq('CIRC') then
    at p0 of $!datum
  else
    if !ori.eq('VERT') then
      at p0 of $!datum
    else
      at p9 of $!datum
    endif
  endif


  -- **********************************************************************************************
  -- At this point the new template has been copied, there are TWO udas :MDSConfigA and MDDSConfigB
  -- at SCTN/SUBS elements that can be configured to size the templates around ** HVAC ducting ONLY **.
  -- **********************************************************************************************
  -- This has the format of:-
  -- field 1 \ field 2 \ field 3 where
  -- true,W,0.5,WIDTH\true,0.5\true,0.5
  -- field 1 is the position movement
  -- true for on
  -- direction
  -- proportion based on x 500x500 duct
  -- what side of duct to use
  -- field 2 is the start position movement
  -- true for on
  -- proportion based on a 500x500 duct
  -- field 3 is the end position movement
  -- true for on
  -- proportion based on a 500x500 duct

  -- OK lets find the duct size by going to the previous strt and if not nex strt
  -- which is a softtype for redu

  !!ce = !datum

  prev strt
  handle ANY
    next strt
    handle ANY
      return
    endhandle
  endhandle

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- The width should be design para 2 + 2 * insulation thickness
  -- The height should be design para 3 + 2 * insulation thickness

  !despars = despar
  var !insu insu

  -- *********************************************************************************************************
  -- The MDS Project Special Template STRU elements for ** HVAC templates ONLY ** may be BUILT;
  -- either:-
  -- <1> by ** INCLUDING and TAKING into CONSIDERATION the INSULATION THICKNESS ** on the HVAC Ducting in the
  --     BUILDING of the MDS Support
  -- or
  -- <2> by ** IGNORING the INSULATION THICKNESS ** on the HVAC Ducting and BUILDING the MDS support as if
  --     ** NO INSULATION existed on the HVAC Ducting **
  ------------------------------------------------------------------------------------------------------------
  -- The Uda :MDSCHECK at the MDS Special Template  STRU element is used to CONTROL the METHOD of BUILDING
  -- of the MDS Project Special HVAC Support i.e.
  --
  -- <1> Where :MDSCHECK = TRUE  -> INCLUDE the INSULATION THICKNESS in determining the LENGTH of the
  --     MDS Project Special HVAC Support SCTN & SUBS  members
  --
  -- <2> Where :MDSCHECK = FALSE -> EXCLUDE the INSULATION THICKNESS in determining the LENGTH of the
  --     MDS Project Special HVAC Support SCTN & SUBS members
  ------------------------------------------------------------------------------------------------------------
  --
  -- Reset the !insu insulation thickness variable to '0'<zero> if it is to be IGNORED/EXCLUDED from any
  -- CALCULATIONS in determining the SCTN & SUBS LENGTHS in the MDS Project Special HVAC Support

  if !method.neq('ROTATE') then
    if (!template.dbref().:mdscheck.not()) then
      !insu = '0'
    endif
  endif

  -- *********************************************************************************************************

  -- Obtain orientation of strt
  -- !plDir = pl dir wrt /*

  -- The templates are based on 500x500 so work out the width and height differnce
  -- A strt element has four p-points around the duct find the direction of these to
  -- work out which is the height and width
  pin 1 copy p61
  pin 2 copy p62
  pin 3 copy p63
  pin 4 copy p64

  --var !strtHeight const dist pin 1 to pin 2
  --var !strtWidth const dist pin 3 to pin 4

  pin 1 dir from p61 to p62
  var !pin1Dir pin 1 dir
  if !pin1Dir.eq('U') or !pin1Dir.eq('D') or !pin1Dir.eq('Z') or !pin1Dir.eq('-Z') then
    if !this.type.eq('CIRC') then
      !hdp = 2
      !wdp = 2
    else
      !hdp = 2
      !wdp = 3
    endif
  else
    if !this.type.eq('CIRC') then
      !hdp = 2
      !wdp = 2
    else
      !hdp = 3
      !wdp = 2
    endif
  endif
  !!mdsResetPins(1,4)

  -- *********************************************************************************************************
  --
  -- Reset the DATUM Atta despars to EXCLUDE any INSULATION if the INSULATION is to be IGNORED/EXCLUDED from any
  -- CALCULATIONS in determining the SCTN & SUBS LENGTHS in the MDS Project Special HVAC Support

$(

  if !method.eq('ROTATE') then
    if (!template.:mdscheck.not()) then
      !datum.desp[1] = !despars[!wdp]
      !datum.desp[2] = !despars[!hdp]
    else
      !datum.desp[1] = (!despars[!wdp] + (2 * !insu.real()))
      !datum.desp[2] = (!despars[!hdp] + (2 * !insu.real()))
    endif
  else
    if (!template.dbref().:mdscheck.not()) then
      !datum.desp[1] = !despars[!wdp]
      !datum.desp[2] = !despars[!hdp]
    else
      !datum.desp[1] = (!despars[!wdp] + (2 * !insu.real()))
      !datum.desp[2] = (!despars[!hdp] + (2 * !insu.real()))
    endif
  endif

$)
  -- Reposition the STRU at the DATUM ATTA

  !!ce = !!mdsSpecial.support.stru
  if !this.type.eq('CIRC') then
    at p0 of $!datum
  else
    if !ori.eq('VERT') then
      at p0 of $!datum
    else
      at p9 of $!datum
    endif
  endif
$(
  !!ce = !!mdsSpecial.support.stru
  if !ori.eq('VERT') then
    at p0 of $!datum
  else
    at p9 of $!datum
  endif
$)
  if !despars[$!wdp].lt(500) then
    !widthDiff = (500 - (!despars[$!wdp] + !insu.real() + !insu.real()))
    !widthDiff = !widthDiff - !widthDiff - !widthDiff
  else
    !widthDiff = ((!despars[$!wdp] + !insu.real() + !insu.real()) - 500)
  endif

  if !despars[$!hdp].lt(500) then
    !heightDiff = (500 - (!despars[$!hdp] + !insu.real() + !insu.real()))
    !heightDiff = !heightDiff - !heightDiff - !heightDiff
  else
    !heightDiff = ((!despars[$!hdp]  + !insu.real() + !insu.real()) - 500)
  endif


  !datumDespars = despar of $!datum

  if !datumDespars[1].lt(500) then
    !widthDiff = (500 - (!datumDespars[1] + !insu.real() + !insu.real()))
    !widthDiff = !widthDiff - !widthDiff - !widthDiff
  else
    !widthDiff = ((!datumDespars[1] + !insu.real() + !insu.real()) - 500)
  endif

  if !datumDespars[2].lt(500) then
    !heightDiff = (500 - (!datumDespars[2] + !insu.real() + !insu.real()))
    !heightDiff = !heightDiff - !heightDiff - !heightDiff
  else
    !heightDiff = ((!datumDespars[2]  + !insu.real() + !insu.real()) - 500)
  endif

$(



  --<ge - 02/11/04> Fix for vertical templates, to make the width always the larger
  -- than the height design parameter as the FANP templates were building incorrectly
  if !ori.eq('VERT') then
    if !strtHeight.real() gt !strtWidth.real() then
      !newHeightDiff = !widthDiff
      !newWidthDiff = !heightDiff
      !heightDiff = !newHeightDiff
      !widthDiff = !newWidthDiff
    endif
  endif
  --<ge - 02/11/04>
$)
  if !mdsSplRot.eq(90) or !mdsSplRot.eq(270) then
    !swapped = TRUE
    !newHeightDiff = !widthDiff
    !newWidthDiff = !heightDiff
    !heightDiff = !newHeightDiff
    !widthDiff = !newWidthDiff
  else
    !swapped = FALSE
  endif

  if !!debug then
    $p **************************
    $p Height Diff = $!heightDiff
    $p Width Diff  = $!widthDiff
    $p===========================
  endif

  -- Access stru element

  !!ce = !!mdsSpecial.support.stru

  -- Collect all the sections and vertex's for the linings

  var !sections coll all sctn for ce
  var !sections append coll all extr for ce
  var !sections append coll all subs for ce
  var !vertexs coll all vert for ce
  var !vertexs append coll all poinsp for ce
  var !vertexs append coll all curve for ce
  var !vertexs append coll all pnod for ce

  -- Loop through and modify the sections

  !configUdas[1] = ':MdsConfigA'
  !configUdas[2] = ':MdsConfigB'

  do !udas values !configUdas
    do !reset values !sections
      !!ce = !reset.dbref()
      !config = $!udas
      if !config.eq('unset') then
        reconn recalc
        handle ANY
        endhandle
        skip
      else
        !configS  = !config.split(|\|)
        !position = !configS[1].split(',')
        !start    = !configS[2].split(',')
        !end      = !configS[3].split(',')
        if !position[1].boolean() then
          if !position[4].eq('HEIGHT') then
            !dist = !heightDiff
          else
            !dist = !widthDiff
          endif

          by $!position[2] ($!position[3] * $!dist)
          if !!debug then
            !name = name
            $p **************************
            $p Moving $!name by $!position[2] ($!position[3] * $!dist)
          endif
        endif

        -- Move start end of sctns

        if !start[1].neq('') then
          if !start[1].boolean() then
            -- Decide what distance to use
            if !ori.eq('VERT') then
              if !start.size().gt(2) then
                if !start[3].eq('HEIGHT') then
                  !dist = !heightDiff
                else
                  !dist = !widthDiff
                endif
              else
                !dist = !heightDiff
              endif
            else
              if !!ce.poss.up.eq(!!ce.pose.up) then
                !dist = !widthDiff
              else
                !dist = !heightDiff
              endif
            endif
            if !!debug then
              $p **************************
              $p Extending start ($!dist * !start[2])
            endif
            extend start ($!dist * !start[2])
          endif
        endif

        -- Move end

        if !end[1].neq('') then
          if !end[1].boolean() then
            -- Decide what distance to use
            if !ori.eq('VERT') then
              if !end.size().gt(2) then
                if !end[3].eq('HEIGHT') then
                  !dist = !heightDiff
                else
                  !dist = !widthDiff
                endif
              else
                !dist = !heightDiff
              endif
            else
              if !!ce.poss.up.eq(!!ce.pose.up) then
                !dist = !widthDiff
              else
                !dist = !heightDiff
              endif
            endif
            if !!debug then
              $P **************************
              $P Extending end ($!dist * !end[2])
            endif
            extend End ($!dist * !end[2])
          endif
        endif
      endif

      reconn recalc
      handle ANY
      endhandle
    enddo
  enddo

  -- Reposition nodes and reconnect start
  do !reset values !sections
    !!ce = !reset.dbref()
    goto jois
    handle ANY
      skip
    endhandle
    snod
    zdist thro poss of cref of same
    same
    reconn recalc
  enddo

  -- Reposition nodes and reconnect start
  do !reset values !sections
    !!ce = !reset.dbref()
    goto joie
    handle ANY
      skip
    endhandle
    snod
    zdist thro pose of cref of same
    same
    reconn recalc
  enddo

  -- Loop through and modify the vertex positions
  do !reset values !vertexs
    !!ce = !reset.dbref()
    !config = :MdsConfigA
    if !config.eq('unset') then
      skip
    else
      !configS  = !config.split(',')
      if !configS[4].eq('WIDTH') then
        !dist = !widthDiff
      else
        !dist = !heightDiff
      endif
      if !configS[1].boolean() then
        by $!configS[2] ($!configS[3] * $!dist)
      endif
    endif
  enddo

  do !reset values !vertexs
    !!ce = !reset.dbref()
    !config = :MdsConfigB
    if !config.eq('unset') then
      skip
    else
      !configS  = !config.split(',')
      if !configS[4].upcase().eq('WIDTH') then
        !dist = !widthDiff
      else
        !dist = !heightDiff
      endif
      if !configS[1].boolean() then
        by $!configS[2] ($!configS[3] * $!dist)
      endif
    endif
  enddo

  stru

  -- Need to orientate stru along pl of strt

  if !ori.neq('VERT') then
    if !method.neq('ROTATE') then
      if !noOfMembers.eq(0) then
        ori y is $!plDir
      endif
    endif
  endif

  -- Need to rename the framework to /Support/MAIN

  stru
  !struname = name
  if !method.neq('ROTATE') then
    frmw1
    handle NONE
      name $!struname/MAIN
    elsehandle ANY
    endhandle
    stru
    :MdsSplRot $!savedRotate
  endif


  --<tm> removed 07/09/2004 as it extends sections after the process has finished
  -- Need to make sure that any end that can be extended are always extended
  -- outside of HVAC only if rect
$(

  stru
  if !this.type.neq('CIRC') then
    do !makeSure values !sections
      !!ce = !makeSure.dbref()
      if !!ce.type.eq('SCTN') then
        if !!ce.:MdsSplAdjust.eq(2) then
          extend end beh $!!mdsSpecial.support.datum
          extend end 200mm
        endif
      endif
    enddo
  endif
$)
  --<tm> 07/09/2004


  -- Mirror stru if required

  if !this.buildWithMirror.val then
    !!ce.:MDSFraMirror = TRUE
    !this.mirror()
  else
    !!ce.:MDSFraMirror = FALSE
  endif

  -- When we have finished loop through all the snods and put them back in place

  !!ce = $!struname
  var !allSnodes coll all snod for ce
  do !reset values !allSnodes
    !!ce = !reset.dbref()
    zdist thro cref of 1
    handle ANY
    endhandle
  enddo

  -- If we have a rectangular duct and insulation we have to move all members below frmw
  if !insu.real().neq(0) then
    !ce = !!ce
    var !coll coll all for $!struname/MAIN
    handle NONE
      do !loop values !coll
        if !!ce.type.eq('FRMW') then
          skip
        endif
        !!ce = !loop.dbref()
        !direction = p9 dir of $!struname/DATUM wrt /*
        !dir = !direction.string().before('WRT').trim()
        by $!dir $!insu
        handle ANY
        endhandle
      enddo
    elsehandle ANY
    endhandle
    !!ce = !ce
  endif
  stru

  !!kRestoreUnits(!currentUnits)

endmethod

--------------------------------------------------------------------------------
define method .mirror()
  --------------------------------------------------------------------------------

  -- Initialise variables

  !stru     = !!mdsSpecial.support.stru
  !name     = !stru.name

  -- If we are mirroring a HVAC special then we need to see if the value of :MdsSplRot is 90 or 270
  -- If so we need to swop the collection of bars and verticals

  if !stru.:MdsSplRot.eq(90) or !stru.:MdsSplRot.eq(270) then
    !bars     = !!kCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !stru)
    !vertical = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !stru)
  else
    !bars     = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !stru)
    !vertical = !!kCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !stru)
  endif

  -- !bars     = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !stru)
  -- !vertical = !!kCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !stru)


  !!ce = $!<name>/DATUM
  !pv = object POINTVECTOR()
  !pv.position = !!ce.pos.wrt( /* )
  !pv.direction = !!ce.ldir.wrt( /* )
  !plane = !pv.plane()
  VAR !p3Dir P3 DIR WRT WORLD
  VAR !p3DirOpp const direction p3 to p9
  !uDir = !p3DirOpp

  -- Cross-Bars

  -- If the cross bar has joints then this will not need doing as the setting of jois and joie
  -- will sort the ori out

  !fixeditems = ARRAY()

  do !v values !bars
    -- Do not mirror joint section, these can be recognised by the :MdsSplAdjust attribute being set
    -- to 0,1,2,3 (-1 is default)
    !!ce = !v
    if !!ce.:MdsSplAdjust.eq(-1) then
      !fixeditems.append(!v)
      skip
    endif
    PIN 9 AT STRU
    PIN 9 DIR $!!mdsSpecial.support.p11dir
    VAR !midp DERI MIDP
    PIN 8 AT $!midp
    PIN 9 plane PIN 9 THRO PIN 8
    PIN 9 DIR $!uDir WRT WORLD
    ROTATE THRO PIN 9 ABOUT $!uDir WRT WORLD BY 180
  enddo

  -- Vertical members

  do !v values !vertical
    !joie = !v.joie
    !jois = !v.jois
    -- temporarily remove joint ref
    !!ce = !v
    if !!ce.:MdsSplAdjust.eq(-1) then
      !fixeditems.append(!v)
      skip
    endif
    JOIS NULREF
    JOIE NULREF
    PIN 9 AT STRU
    PIN 9 DIR $!!mdsSpecial.support.p11dir
    VAR !midp DERI MIDP
    PIN 8 AT $!midp
    PIN 9 plane PIN 9 THRO PIN 8
    PIN 9 DIR $!uDir WRT WORLD
    ROTATE THRO PIN 9 ABOUT $!uDir WRT WORLD BY 180
    JOIS $!jois
    JOIE $!joie
    FLIP
  enddo

  -- now deal with the -1 items which have not rotated but may need to be moved
  do !a values !fixeditems
    !!ce = !a
    !vol = object VOLUME(!!ce)
    !pos1 = !vol.from
    !pos2 = !vol.to
    !midpoint = !pos1.midpoint(!pos2)
    !distance = !midpoint.distance(!plane)
    if !distance.lt(1) then
      -- its symmetrical about the origin
      skip
    endif
    -- we now have a distance between the plane and the object
    -- now we need to find the offset direction
    !pos3 = !plane.near(!midpoint)
    !pv1 = object POINTVECTOR()
    !pv1.position = !midpoint
    !pv1.direction = !pv.direction.opposite()
    !pv2 = !pv1.offset(!distance)
    if !pv2.position.distance(!plane).lt(!distance) then
      -- its moving opposite to the pl of the datum
      !direction = !pv1.direction
    else
      !direction = !pv.direction
    endif
    -- now we can move the item
    move $!direction distance (2 * $!distance )
  enddo

  !!ce = !!mdsSpecial.support.stru

  -- Reset pins
  call !!mdsResetPins(8,9)

endmethod

--------------------------------------------------------------------------------
define method .setFilter(!dummyFrom is STRING)
  --------------------------------------------------------------------------------

  -- Build up the characters from the set gadgets

  -- Character 1

  !test = !this.char1.val
  handle NONE
    if !this.char1.val.eq(1) then
      !char1 = 'A'
      !this.extrafilter = ''
    elseif !this.char1.val.eq(2) then
      !char1 = 'B'
      !this.extrafilter = '12,42'
    elseif !this.char1.val.eq(3) then
      !char1 = 'B'
      !this.extrafilter = '10,40,11,41,13,43,14,44'
    elseif !this.char1.val.eq(4)  then
      !char1 = 'C'
      !this.extrafilter = '12,42'
    elseif !this.char1.val.eq(5) then
      !char1 = 'C'
      !this.extrafilter = '10,40,11,41,13,43,14,44'
    else
      !char1 = 'D'
      !this.extrafilter = ''
    endif

    -- Character 2

    if !this.char2.val.eq(1) then
      !char2 = 'C'
    elseif !this.char2.val.eq(2) then
      !char2 = 'W'
    else
      !char2 = 'F'
    endif

    -- Character 3

    if !this.char3.val.eq(1) then
      !char3 = 'F'
    elseif !this.char3.val.eq(2) then
      !char3 = 'W'
    else
      !char3 = 'R'
    endif

    -- Character 4

    if !this.char4.val.eq(1) then
      !char4 = '1'
    elseif !this.char4.val.eq(2) then
      !char4 = '3'
    else
      !char4 = '4'
    endif


    -- Build text string and run filter

    !textString = !char1 + !char2 + !char3 + !char4 + '*'
    -- !textString = !char1 + !char2 + !char3 + '*'
    !this.filter.val = !textString
    -- Save filters
    !s1 = !this.char1.val
    !s2 = !this.char2.val
    !s4 = !this.char4.val

    !this.init('NOSHOW')
    !this.char1.val = !s1
    !this.char2.val = !s2
    !this.char4.val = !s4
    -- Reset filters

  elsehandle ANY
  endhandle
endmethod
