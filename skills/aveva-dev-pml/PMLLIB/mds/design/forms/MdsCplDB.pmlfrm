--
-- File:      MdsCplDB.pmlfrm
-- Type:      Form Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    Design
-- Replaces:
--
-- Author:    Neale Morris
-- Created:   Wednesday 15th June 2005
--
--
-- Description:
-- Form Definition to select a witchhanger project db
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  dbset()                          -
--  init(STRING,STRING,STRING,FORM)  -
--  ok()                             -
--  setdb()                          -
--

-- Delete existing form definition
kill !!mdsCplDB

-- Define Form
setup form  !!mdsCplDB

  !!mdsCplDB.formtitle    = |WitchHanger|
  !!mdsCplDB.callback     = ||

  list .files 'Select Project DB' width 20 lines 5

  text .newdb 'New' at x0 ymax+0.5 width 17 STRING

  button .cancel  | Cancel | at xmax form-size ymax+0.25 call |!this.cancel()| cancel
  button .ok      |   OK   |   at x0.15 ymin call |!this.ok()| ok

-- End of form definition

-- Form Members.

-- Array Member to store db name
  member .db is STRING
  member .exe is STRING
  member .lif is STRING
  member .lof is STRING
  member .type is STRING
  member .form is FORM

exit

define method .init(!exe is STRING,!lif is STRING,!lof is STRING, !form is FORM)

  -- store the mdsvendorhangertype form that is being used to create the hanger
  !this.form = !form

  -- The project db area will be stored in the evar (proj code)dat
  var !projCode proj code
  var !dbLocation evar $!projCode$ndat

  if !dbLocation.eq('') then
    !!alert.error('Location of WitchHanger DB files cannot be found in environment variable $!projCode$nDAT')
    return
  endif

  -- Get all the db names in the directory

  !dbs = object FILE()
  !dbs.file(!dbLocation)
  !files = !dbs.files()

  -- The db will be *.dbt so only list them

  !dtext = ARRAY()
  !rtext = ARRAY()

  do !getDbs values !files
    if !getDbs.name().matchwild('*.dbt') then
      !dtext.append(!getDbs.entry().before('.dbt').after('X'))
      !rtext.append(!getDbs.fullname())
    endif
  enddo

  !this.files.dtext = !dtext
  !this.files.rtext = !rtext

  !this.exe = !exe
  !this.lif = !lif
  !this.lof = !lof

  !this.newdb.val = 'unset'

  if !this.db.eq('') or !this.db.unset() then
    show !!mdsCplDB
  else
    !this.ok()
  endif

endmethod

define method .ok()

-- Set value of selected db if new

  if !this.newdb.val.neq('unset') then
    var !proj proj code
    var !dbloc evar '$!proj$ndat'
    !this.db = '$!dbloc\$!this.newdb.val'
  endif

-- Set value of db if existing
  if !this.db.eq('') or !this.db.unset() then
    !this.db = !this.files.rtext[$!this.files.val]
  endif

-- Print Support to default printer

  if !!mdsCplDB.type.eq('PRINT') then
    SYSCOM |"$!this.exe" /MDS /PRINT:%pdmswk%\PrintToWH.dat /PD:$!!mdsCplDB.db|
  elseif !!mdsCplDB.type.eq('DELETE') then
-- Do nothing as delete routine handle this
-- We are just setting the DB of the user wants to reset it
  else
-- Call WitchHanger
    SYSCOM |"$!this.exe" /MDS /if:$!this.lif /OF:$!this.lof /PD:$!this.db|
    !this.form.buildHanger('$!this.lof')
    do !loop from 1 to 9
      pin $!loop off
    enddo
  endif

endmethod

define method .cancel()

endmethod

define method .setdb()

-- The project db area will be stored in the evar (proj code)dat
  var !projCode proj code
  var !dbLocation evar $!projCode$ndat

  if !dbLocation.eq('') then
    !!alert.error('Location of WitchHanger DB files cannot be found in environment variable $!projCode$nDAT')
    return
  endif

  -- Get all the db names in the directory

  !dbs = object FILE()
  !dbs.file(!dbLocation)
  !files = !dbs.files()

  -- The db will be *.dbt so only list them

  !dtext = ARRAY()
  !rtext = ARRAY()

  do !getDbs values !files
    if !getDbs.name().matchwild('*.dbt') then
      !dtext.append(!getDbs.entry().before('.dbt').after('X'))
      !rtext.append(!getDbs.fullname())
    endif
  enddo

  !this.files.dtext = !dtext
  !this.files.rtext = !rtext

  --!this.exe = !exe
  --!this.lif = !lif
  --!this.lof = !lof

  !this.newdb.val = 'unset'

  show !!mdsCplDB

  !this.ok.callback = '!this.dbset()'

--<wd>28nov2006
-- Select the existing selection in the form .files list gadget
  !this.files.select('RTEXT', !this.db)
  handle ANY
  endhandle
--<wd>28nov2006

endmethod

define method .dbset()

-- Set value of selected db if new

  if !this.newdb.val.neq('unset') then
    var !proj proj code
    var !dbloc evar '$!proj$ndat'

--<wd>28nov2006
--     !this.db = '$!dbloc\$!this.newdb.val'
    !this.db = '$!dbloc\X$n$!this.newdb.val$n.dbt'
--<wd>28nov2006

--<wd>28nov2006
  else
-- Reset the form member .db to the SELECTED Witch hanger database name
    !this.db = !this.files.rtext[$!this.files.val]
--<wd>28nov2006

  endif
--<wd>28nov2006 - This CODE has been replaced by the "else" statement code added immediately above
-- Reset the form member .db to the SELECTED Witch hanger database name
-- Set value of db if existing
--  if !this.db.eq('') or !this.db.unset() then
--    !this.db = !this.files.rtext[$!this.files.val]
--  endif
--<wd>28nov2006

endmethod


return
