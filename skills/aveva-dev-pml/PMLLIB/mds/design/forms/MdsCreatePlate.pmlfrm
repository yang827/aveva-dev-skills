--
-- File:  MdsCreatePlate.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tues 8th June
--
-- Description:
-- Form Definition for copying a framatome section
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkVal(STRING)                 -
--  common(DBREF,DBREF,DBREF,REAL,REAL,REAL) -
--  create()                         -
--  deleteAll()                      -
--  deleteplat()                     -
--  getBearing(DBREF,REAL,REAL,REAL) -
--  init()                           -
--  modify()                         -
--  namePlates()                     -
--  setTitle()                       -
--  setWeldSize(DBREF,REAL,REAL,REAL) -
--  settype()                        -
--  silentbearing(DBREF,DBREF)       -
--

-- Kill existing form definition
Kill !!mdsCreatePlate

-- Define Form
setup form  !!mdsCreatePlate

  !!mdsCreatePlate.formtitle    = |Plates|
  !!mdsCreatePlate.icontitle    = ||
  !!mdsCreatePlate.callback     = ||

  -- Body of Form

  path down
  vdist .6

  rgroup .plates 'Available Plates  ' call |!this.settype()|

    add tag ' Compensating      '
    add tag ' Bearing           '
    add tag ' Partition         '
    add tag ' Full Reinforcement'

  exit
  vdist 0.5

  path right

  frame .sizes 'Sizes '
    text .xlen  ' Xlen ' at x1 y1 call |!this.checkVal('X')| width 14 is REAL format !!distanceFmt
    path down
    text .ylen  ' Ylen '              call |!this.checkVal('Y')| width 14 is REAL format !!distanceFmt
    text .zlen  ' Zlen '              call |!this.checkVal('Z')| width 14 is REAL format !!distanceFmt
  exit

  -- Bottom Line

  button .create | Create | at x0 Ymax.sizes+0.5 call |!this.create()|
  path right
  button .modify | Modify | call |!this.modify()|
  button .delete | Delete ID | call |!this.deleteplat()|
  button .deleteAll | Delete All | call |!this.deleteAll()|

  button .cancel  | Dismiss | at xmax form-size ymax+0.5 CANCEL

  -- Members

  member .mode is STRING
  member .plate is DBREF
  member .form is FORM
  member .picked is DBREF
  member .endText is STRING

  -- End form definition

exit

define method .init()

  !this.plates.val = 1
  !this.xlen.val = 0
  !this.xlen.active = FALSE
  !this.ylen.val = 0
  !this.ylen.active = FALSE
  !this.zlen.val = 0
  !this.zlen.active = FALSE

  !this.mode = 'CREATE'
  !this.setTitle()

  show !!mdsCreatePlate

endmethod

define method .settype()

  -- Activate/Deactivate the size gadget for the different types
  -- Type 1 is a compensating plate and only the zlen is definable at 5 to 30mm in 5mm steps
  -- Type 2 is bearing plate only, using rules to set the size
  -- Type 3 is a partition plate, on the end of sections
  -- Type 4 is a full reinforcement, on the end of sections

  !this.xlen.val = 0
  !this.xlen.active = FALSE
  !this.ylen.val = 0
  !this.ylen.active = FALSE
  !this.zlen.val = 0
  !this.zlen.active = FALSE

  !this.mode = 'CREATE'
  !this.formtitle = 'Plates - Creation'

endmethod

define method .create()

  -- Identify the ancillary associated with the plate

  prompt off
  if (!!mdsCreatePlate.plates.val.eq(1)) then
    prompt load escape |Identify ancillary associated with the compensating plate|
    !idType = 'ATTA'
  elseif (!!mdsCreatePlate.plates.val.eq(2)) then
    prompt load escape |Identify ancillary associated with the bearing plate|
    !idType = 'ATTA'
  elseif (!!mdsCreatePlate.plates.val.eq(3)) then
    prompt load escape |Identify section start/end associated with the partition plate|
    !idType = 'SCTN'
  elseif (!!mdsCreatePlate.plates.val.eq(4)) then
    prompt load escape |Identify section start/end associated with the full reinforcement|
    !idType = 'SCTN'
  endif

  if (!idType.eq('SCTN')) then
    label /nosctn
    Var !idsctn pick
    handle (61,528)
      prompt on
      return
    endhandle
    if (!idsctn[1].dbref().type.neq('SCTN')) then
      golabel /nosctn
    endif
    prompt dismiss
    prompt on
    -- Find out which end of the sctn was identified
    !!ce = !idsctn[1].dbref()
    !postext = !idsctn[2].after('Through')
    !position = $!postext wrt /*
    !dirtext = !idsctn[2].after('Line').before('Through')
    !direction = $!dirtext
    handle (2,779)
      !direction = axis $!dirtext
    endhandle
    -- create a vector along the line of the pick
    !vector = object POINTVECTOR()
    !vector.position = !position
    !vector.direction = !direction
    -- create a line along the length of the idsctn
    !pidsctn = object LINE()
    !pidsctn.startposition = !idsctn[1].dbref().poss.wrt(/* )
    !pidsctn.endposition   = !idsctn[1].dbref().pose.wrt(/* )
    -- find the intersection point of the vector and the idsctn
    !intersection = !vector.intersection(!pidsctn)
    -- get the position of the intersection on the idsctn
    !prop = !pidsctn.near(!intersection)
    -- calculate the distance of the intersection from the poss of the idsctn
    !startdist = !pidsctn.startposition.distance(!prop)
    -- if the distance from the start of the idsctn is gt half the length its the end
    if (!startdist.gt(0.5 * !pidsctn.length())) then
      !this.endText = 'POSE'
    else
      !this.endText = 'POSS'
    endif
  else
    id $!idType @
    handle (61,528)
      prompt on
      return
    endhandle
    prompt dismiss
    prompt on
  endif

  !picked = !!ce

  -- Does the identified atta/sctn belong to the support

  !supportNameOfPicked = !!mdsGetSuppName(!!ce)
  !ce = !!ce
  !!ce = !this.form.support.stru
  !supportBeingModified = !!mdsGetSuppName(!!ce)
  !!ce = !ce
  if (!supportNameOfPicked.neq(!supportBeingModified)) then
    !!alert.error('Identified $!idType does not belong to this support.')
    return
  endif

  !this.picked = !picked

  -- Does the atta/sctn already reference a plate

  if (!picked.:MdsPlate.badref().not()) then
    if (!!alert.confirm('Identified $!idType already references a plate, Do you want to delete the plate?').eq('YES')) then
      goto :MdsPlate
      pnod
      var !rule rule
      if (!rule.match('NPOS Dynamic Rule').gt(0)) then
        rule delete all
      endif
      pjoi 1
      cutb 0
      reconn recalc
      handle ANY
      endhandle
      pnod
      delete pnod
    else
      return
    endif
  endif

  !!ce = !picked

  -- Compensating Plate

  if (!!mdsCreatePlate.plates.val.eq(1)) then

    -- Identify the sctn to create the compensating plate for

    prompt off
    prompt load escape |Identify section associated with the compensating plate|
    id sctn @
    handle (61,528)
      prompt on
      return
    endhandle
    prompt dismiss
    prompt on

    !sctn = !!ce

    -- Get the depth of the section so that we can set the weld positions

    if (!!ce.gtype.neq('PLAT')) then
      !sctnWidth = cpar[1]
      !sctnThickness = cpar[3]
      !sctnOR = cpar[6]
    else
      -- plate modelled as sctn
      !sctnWidth = cpar[2]
      handle ANY
        !sctnWidth = desp[1]
      endhandle
      !sctnThickness = cpar[1]
      !sctnOR = 0
    endif
    -- Do the identified sctn belong to the support

    !ce = !!ce
    !supportNameOfIndentifiedSctn = !!mdsGetSuppName(!!ce)
    if (!supportNameOfIndentifiedSctn.neq(!supportBeingModified)) then
      !!alert.error('Identified section does not belong to this support.')
      return
    endif
    !!ce = !ce

    -- Work out the distance between the p9 of the atta and the sctn

    pin 9 copy p9 of $!picked
    pin 8 copy pin 9
    pin 8 plane pin 8 clear 0 inf $!sctn

    var !packDist const dist pin 9 to pin 8
    !!mdsResetPins(8,9)

    -- Check to see if packing distance is 0

    if (!packDist.real().eq(0)) then
      !!alert.error('Packing distance is 0 unable to create a compensating plate')
      return
    endif

    if (!packDist.real().geq(2.5) and !packDist.real().leq(7.4)) then
      !packDist = '5'
    elseif (!packDist.real().geq(7.5) and !packDist.real().leq(12.4)) then
      !packDist = '10'
    elseif (!packDist.real().geq(12.5) and !packDist.real().leq(17.4)) then
      !packDist = '15'
    elseif (!packDist.real().geq(17.5) and !packDist.real().leq(22.4)) then
      !packDist = '20'
    elseif (!packDist.real().geq(22.5) and !packDist.real().leq(27.4)) then
      !packDist = '25'
    elseif (!packDist.real().geq(27.5) and !packDist.real().leq(32.4)) then
      !packDist = '30'
    else
      !!alert.error('A packing distance of $!packDist cannot be accommodated with a compensating plate')
      return
    endif

    !!ce = !picked

    !this.zlen.val = !packDist.real()
    !xlen = !!ce.prop.xfp.real()
    handle ANY
      !!alert.error('Identified atta does not cater for a compensating plate.')
      return
    endhandle
    !xlen = !xlen + 40
    !ylen = !!ce.prop.yfp.real()
    handle ANY
      !!alert.error('Identified atta does not cater for a compensating plate.')
      return
    endhandle
    !ylen = !ylen + 40
    !zlen = !this.zlen.val
    !!ce = !this.form.support.stru
    !struName = !!ce.name

    -- We need to test the width of the compensating plate across the section to see if we need
    -- a plate with fillet welds or fillet and hy welds
    -- The rule is that if the ylen of the plate is less or equal to the width - 2 x outside radius
    -- it needs to be a compensating plate gtyp COMP, Spref /MDS-FRA-PNODS-CompPlate
    -- if not then it needs to be a comp plate as bearing gtyp COMB, spref /MDS-FRA-PNODS-BCPlate

    !testWidth = !sctnWidth - (2 * !sctnOR)
    if (!ylen.leq(!testWidth)) then
      !spref = /MDS-FRA-PNODS-CompPlate
    else
      !spref = /MDS-FRA-PNODS-BCPlate
      -- Minimum length is section width
      if (!ylen.lt(!sctnWidth)) then
        !ylen = !sctnWidth
      endif
    endif

    -- Call common plate code

    !this.common(!sctn,!picked,!spref,!xlen,!ylen,!zlen)
    despar n4 $!sctnWidth
    !plate = !!ce

    if (!ylen.leq(!testWidth)) then
      gtyp COMP
    else
      gtyp COMB
    endif

    !this.setWeldSize(!picked,!xlen,!ylen,!sctnWidth)

    -- Name the plates

    !ce = !!ce
    !!ce = !plate
    !this.namePlates()
    !!ce = !ce

    !!mdsResetPins(8,9)

    -- Bearing Plate Creation

  elseif (!!mdsCreatePlate.plates.val.eq(2)) then

    -- Test if the identified ancillary is correct for the type of plate being identified

    if (not !!ce.styp inset ('GT31','GT32','GT33','GT35','ST21','ST22','GT56','GT57','GT58')) then
      !code = !!ce.prop.code
      !!alert.error('Identified atta ($!code) is not suitable for a bearing plate')
      return
    endif

    !atta = !!ce

    -- Identify the section to be used

    prompt off
    prompt load escape |Identify section associated with the bearing plate|
    id sctn @
    handle (61,528)
      prompt on
      return
    endhandle
    prompt dismiss
    prompt on
    !sctn = !!ce

    -- Do the identified sctn belong to the support

    !ce = !!ce
    !supportNameOfIndentifiedSctn = !!mdsGetSuppName(!!ce)
    if (!supportNameOfIndentifiedSctn.neq(!supportBeingModified)) then
      !!alert.error('Identified section does not belong to this support.')
      return
    endif
    !!ce = !ce

    -- Identified section must be a boxed section

    if (!!ce.gtype.neq('BOX')) then
      !!alert.error('Identified section is not a boxed section.')
      return
    endif

    -- Test to see if bearing plate is not a MSH50 or MSH80, these are not
    -- allowed for bearing plates

    !sctnPara = cpar
    if (!sctnPara[1].real().eq(50) or !sctnPara[1].real().eq(60)) then
      !!alert.error('Identified section size is not allowed to be used for a bearing plate.')
      return
    endif

    -- Get bearing plate size
    !xlen = 0
    !ylen = 0
    !zlen = 0
    !this.getBearing(!picked,!xlen,!ylen,!zlen)
    if (!xlen.eq(0) and !ylen.eq(0) and !zlen.eq(0)) then
      !!alert.error('The selected atta and sctn does not require a bearing plate')
      return
    endif

    -- Call common plate code

    !char = !!ce.spref.namn.after('/').substring(3,1)
    !spref = /MDS-FRA-PNODS-BearPlate$!char

    !this.common(!sctn,!picked,!spref,!xlen,!ylen,!zlen)

    -- Set the weld sizes

    !this.setWeldSize(!picked,!xlen,!ylen,!sctnPara[1])

    -- Set the plate type
    gtyp BEAR
    !plate = !!ce
    despar n4 $!sctnPara[1]
    !opdi = opdi wrt /*
    pin 1 dir $!opdi
    pin 1 clear 0 beh p301 of ce

    -- Move the section behind the bearing plate

    !!ce = !sctn
    move $!opdi clear 0 beh pin 1
    !!mdsResetPins(1,1)

    -- Name the plates

    !ce = !!ce
    !!ce = !plate
    !this.namePlates()
    !!ce = !ce

    !!mdsResetPins(8,9)

    -- Partition Plate

  elseif (!!mdsCreatePlate.plates.val.eq(3)) then

    -- The default size is 50mm bigger than the identified section

    !!ce = !picked

    !wastctl = tctl
    !sctnWidth = cpar[1]

    !!ce = !this.form.support.stru
    !struName = !!ce.name
    $!struName/MAIN
    handle ANY
      !!alert.error('Unable to locate the frmw $!struName/MAIN to create partition plate in.')
      return
    endhandle
    last mem
    handle ANY
    endhandle
    new pnod
    !pnod = !!ce
    new pjoi
    !pjoi = !!ce
    func 'PLAT'

    -- Set size
    -- Add a default 25mm to xlen ylen
    !xxlen = !picked.prop.depth
    !xlen = !xxlen.real() + 50
    !this.xlen.val = !xlen.real()

    !yylen = !picked.prop.width
    !ylen = !yylen.real() + 50
    !this.ylen.val = !ylen.real()

    if (!this.zlen.val.eq(0)) then
      !zlen = 5
      !this.zlen.val = !zlen.real()
    else
      !zlen = !this.zlen.val.string()
    endif
    despar $!xlen $!ylen $!zlen

    !char = !picked.spref.namn.after('/').substring(3,1)
    spref /MDS-FRA-PNODS-PartitionPlate$!char
    cref $!picked

    !!ce = !pnod
    if (!this.endText.eq('POSS')) then
      !end = 'POSS'
      !sctn = cref of 1
      !rule = |rule set npos dynam (e(comp e of $!end of $!sctn wrt $!sctn) n(comp n of $!end of $!sctn wrt $!sctn) u(comp u of $!end of $!sctn wrt $!sctn + cutb of 1) wrt $!sctn)|
    else
      !end = 'POSE'
      !sctn = cref of 1
      !rule = |rule set npos dynam (e(comp e of $!end of $!sctn wrt $!sctn) n(comp n of $!end of $!sctn wrt $!sctn) u(comp u of $!end of $!sctn wrt $!sctn - cutb of 1) wrt $!sctn)|
    endif
    --execute the rule
    $!rule
    rule delete all
    !!ce = !pjoi

    if (!this.endText.eq('POSS')) then
      cutp drns of $!picked
      !opdi = !picked.drns.wrt(/* )
      !opdi = !opdi.opposite()
      opdi $!opdi
    else
      cutp drne of $!picked
      !opdi = !picked.drne.wrt(/* )
      !opdi = !opdi.opposite()
      opdi $!opdi
    endif

    goto cref
    if (!this.endText.eq('POSS')) then
      jois same
    else
      joie same
    endif
    reconn recalc
    handle ANY
    endhandle
    same

    if (!!ce.prop.zlen.real().leq(20)) then
      matref /S235JRG2
      --elseif !!ce.prop.zlen.real().gt(20) and !!ce.prop.zlen.real().leq(30) then
    elseif (!!ce.prop.zlen.real().gt(20)) then
      matref /S235J2G3
    endif
    !this.zlen.val = !zlen.real()
    cutb -$!zlen
    goto cref
    reconn recalc
    handle ANY
    endhandle
    !nowtctl = tctl

    same

    if (!wastctl.leq(!nowtctl)) then
      !opdi = !opdi.opposite()
      opdi $!opdi
      reconn recalc
      handle ANY
      endhandle
    endif

    !!ce = !picked
    :MdsPlate same
    same

    -- Set the plate type
    gtyp PART

    !this.setWeldSize(!picked,!xlen,!ylen,!sctnWidth)

    -- Name the plates
    !ce = !!ce
    !this.namePlates()
    !!ce = !ce

    --re-execute the pnod npos rule now that the joint is correctly initialised
    !!ce = !pnod
    $!rule
    !!ce = !ce

    -- Full Reinforcement

  elseif (!!mdsCreatePlate.plates.val.eq(4)) then

    !!ce = !picked

    -- The full reinforcement is only available on 220 and 260 sections
    -- Parameter 1 should therefore be either 220 or 260 and the
    -- gty[p eq BOX

    if (!!ce.cpar[1].eq(220) or !!ce.cpar[1].eq(260)) then
      if (!!ce.gtype.eq('BOX')) then
      else
        !!alert.error('Identified section is an unsuitable size for a full reinforcement')
        return
      endif
    endif

    !!ce = !this.form.support.stru
    !struName = !!ce.name
    $!struName/MAIN
    handle ANY
      !!alert.error('Unable to locate the frmw $!struName/MAIN to create partition plate in.')
      return
    endhandle

    last mem
    handle ANY
    endhandle

    new pnod
    !pnod = !!ce
    rule set npos dynamic $!this.endText of $!picked
    new pjoi
    func 'PLAT'

    !char = !picked.spref.namn.after('/').substring(3,1)
    spref /MDS-FRA-PNODS-FRP$!char
    handle ANY
      !!alert.error('Identified section is an unsuitable size for a full reinforcement')
      pnod
      delete pnod
      return
    endhandle
    desp 0mm 0mm 0mm
    cref $!picked
    if (!this.endText.eq('POSS')) then
      cutp drns of $!picked
      var !poss poss of $!picked
      var !pose pose of $!picked
      var !opdi const direction $!poss to $!pose
      opdi $!opdi
    else
      cutp drne of $!picked
      var !poss poss of $!picked
      var !pose pose of $!picked
      var !opdi const direction $!pose to $!poss
      opdi $!opdi
    endif

    goto cref
    if (!this.endText.eq('POSS')) then
      jois same
    else
      joie same
    endif
    reconn recalc
    handle ANY
    endhandle
    same

    -- Set Material, thickness is always 15mm
    matref /S235JRG2
    cutb 0
    goto cref
    reconn recalc
    handle ANY
    endhandle
    same

    !!ce = !picked
    :MdsPlate same
    same

    -- Set the plate type
    gtyp FRP

    -- Name the plates

    !ce = !!ce
    !this.namePlates()
    !!ce = !ce

  endif

endmethod

-- Dummy method because there was a silent bearing creation

define method .silentbearing(!dummy1 is DBREF,!dummy2 is DBREF)

endmethod

define method .checkVal(!val is STRING)

  -- Check the size gadget for the different types
  -- Type 1 is a compensating plate and only the zlen is definable at 5 to 30mm in 5mm steps
  -- Type 2 is bearing plate, using rules to set the size
  -- Type 3 is a partition plate

  if (!this.plates.val.eq(1)) then
    if (!this.mode.eq('CREATE')) then
      !value = !this.zlen.val
      if (not (!value.string() inset ('5','10','15','20','25','30'))) then
        !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to 5mm')
        --      if not (!value.string() inset ('5','10','15','20','25','30','35','40','45','50','55','60')) then
        --        !!alert.error('Compensating plate can only be between 5mm & 60mm in increments of 5mm, Resetting to 5mm')
        !this.zlen.val = 5mm
      endif
    elseif (!this.mode.eq('MODIFY')) then
      !!ce = !this.plate
      !desp = desp
      !value = !this.zlen.val
      if (not (!value.string() inset ('5','10','15','20','25','30'))) then
        !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to current setting')
        --      if not (!value.string() inset ('5','10','15','20','25','30','35','40','45','50','55','60')) then
        --        !!alert.error('Compensating plate can only be between 5mm & 60mm in increments of 5mm, Resetting current setting')
        !this.zlen.val = $!desp[3]
      else
        despar n3 $!this.zlen.val
      endif
      despar n1 $!this.xlen.val
      despar n2 $!this.ylen.val
      if (!!ce.prop.zlen.real().leq(20)) then
        matref /S235JRG2
        --elseif !!ce.prop.zlen.real().gt(20) and !!ce.prop.zlen.real().leq(30) then
      elseif (!!ce.prop.zlen.real().gt(20)) then
        matref /S235J2G3
      endif

      -- We need to test the width of the compensating plate across the section to see if we need
      -- a plate with fillet welds or fillet and hy welds
      -- The rule is that if the ylen of the plate is less or equal to the width - 2 x thickness it
      -- needs to be a compensating plate gtyp COMP, Spref /MDS-FRA-PNODS-CompPlate
      -- if not then it needs to be a comp plate as bearing gtyp COMB, spref /MDS-FRA-PNODS-BCPlate
      goto cref
      handle NONE
        !sctnWidth = cpar[1]
        !sctnThickness = cpar[3]
        handle ANY
          --plate modelled as SCTN
          !sctnWidth = !!ce.prop.widt.real()
          !sctnThickness = !!ce.prop.dept
          !sctnOR = 2
        elsehandle NONE
          !sctnOR = cpar[6]
        endhandle
        !picked = !!ce
        same
        !testWidth = !sctnWidth - (2 * !sctnOR)
        if (!this.ylen.val.leq(!testWidth)) then
          Spref /MDS-FRA-PNODS-CompPlate
          gtyp COMP
        else
          Spref /MDS-FRA-PNODS-BCPlate
          -- Minimum length is section width
          if (!this.ylen.val.lt(!sctnWidth)) then
            !this.ylen.val = !sctnWidth
            despar n2 $!this.ylen.val
          endif
          gtyp COMB
        endif
      elsehandle ANY
      endhandle
      -- Update weld size if needed
      -- In modify mode we need to get the atta we are underneath
      do !getAtta values !!mdsSpecial.support.atta
        if (!getAtta.:MdsPlate.eq(!!ce)) then
          !plateAtta = !getAtta
          break
        endif
      enddo
      !this.setWeldSize(!plateAtta,!this.xlen.val,!this.ylen.val,!sctnWidth)
    endif
  elseif (!this.plates.val.eq(2)) then
    if (!this.mode.eq('CREATE')) then
      !value = !this.zlen.val
      if (not (!value.string() inset ('5','10','15','20','25','30'))) then
        !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to 5mm')
        !this.zlen.val = 5mm
      endif
    elseif (!this.mode.eq('MODIFY')) then
      !!ce = !this.plate
      !desp = desp
      !value = !this.zlen.val
      if (not (!value.string() inset ('5','10','15','20','25','30'))) then
        !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to current setting')
        !this.zlen.val = $!desp[3]
      else
        despar n3 $!this.zlen.val
      endif
      despar n1 $!this.xlen.val
      despar n2 $!this.ylen.val
    endif
    -- Update weld size if needed
    !this.setWeldSize(!picked,!this.xlen.val,!this.ylen.val,!sctnWidth)
  elseif (!this.plates.val.eq(3)) then
    if (!val.eq('Z')) then
      if (!this.mode.eq('CREATE')) then
        !value = !this.zlen.val
        --        if not (!value.string() inset ('5','10','15','20','25','30')) then
        --          !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to 5mm')
        if (not (!value.string() inset ('5','10','15','20','25','30','35','40','45','50','55','60'))) then
          !!alert.error('Compensating plate can only be between 5mm & 60mm in increments of 5mm, Resetting to 5mm')
          !this.zlen.val = 5mm
        endif
      elseif (!this.mode.eq('MODIFY')) then
        !!ce = !this.plate
        !desp = desp
        !value = !this.zlen.val
        --        if not (!value.string() inset ('5','10','15','20','25','30')) then
        --          !!alert.error('Compensating plate can only be 5mm, 10mm, 15mm, 20mm, 25mm and 30mm. Resetting to current setting')
        if (not (!value.string() inset ('5','10','15','20','25','30','35','40','45','50','55','60'))) then
          !!alert.error('Compensating plate can only be between 5mm & 60mm in increments of 5mm, Resetting to current setting')
          !this.zlen.val = $!desp[3]
        else
          despar n3 $!this.zlen.val
          cutback -$!this.zlen.val
          reconn recalc
          handle ANY
          endhandle
        endif
      endif
    elseif (!val.eq('X')) then
      if (!this.mode.eq('MODIFY')) then
        !!ce = !this.plate
        despar n1 $!this.xlen.val
      endif
    elseif (!val.eq('Y')) then
      if (!this.mode.eq('MODIFY')) then
        !!ce = !this.plate
        despar n2 $!this.ylen.val
      endif
    endif
  endif
  if (!!ce.prop.zlen.real().leq(20)) then
    matref /S235JRG2
    --elseif !!ce.prop.zlen.real().gt(20) and !!ce.prop.zlen.real().leq(30) then
  elseif (!!ce.prop.zlen.real().gt(20)) then
    matref /S235J2G3
  endif

endmethod

define method .deleteplat()

  -- Do any plates exist

  !ce = !!ce
  !!ce = !this.form.support.stru
  var !pnod coll all pjoi with func eq 'PLAT' for ce
  if (!pnod.size().eq(0)) then
    !!ce = !ce
    !!alert.error('No plates exist in current support')
    return
  endif
  !!ce = !ce

  -- Identify the plate to be deleted

  prompt off
  prompt load escape |Identify the plate to be deleted|
  id pjoi @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt dismiss
  prompt on

  !picked = !!ce

  -- Do the identified pjoi belong to the support

  !supportNameOfPicked = !!mdsGetSuppName(!!ce)
  !ce = !!ce
  !!ce = !this.form.support.stru
  !supportBeingModified = !!mdsGetSuppName(!!ce)
  !!ce = !ce
  if (!supportNameOfPicked.neq(!supportBeingModified)) then
    !!alert.error('Identified plate does not belong to this support.')
    return
  endif

  !!ce = !picked

  -- Is it a plate

  !func = func
  if (!func.neq('PLAT')) then
    !!alert.error('Identified element is not a plate.')
    return
  endif

  -- Confirm deletion
  if (!!alert.confirm('Are you sure you want to delete the plate?').eq('YES')) then
    !plateToDelete = !!ce
    !sctn = !!ce
    if (!!ce.gtyp.eq('PART')) then
      goto cref
      :MdsPlate def
    endif
    !!ce = !plateToDelete
    pnod
    var !rule rule
    if (!rule.match('NPOS Dynamic Rule').gt(0)) then
      rule delete all
    endif
    pjoi 1
    cutb 0
    reconn recalc
    handle ANY
    endhandle
    pnod
    delete pnod
  endif

  !this.mode = 'CREATE'
  !this.setTitle()

endmethod

define method .modify()

  -- Do any plates exist

  !ce = !!ce
  !!ce = !this.form.support.stru
  var !pnod coll all pjoi with func eq 'PLAT' for ce
  if (!pnod.size().eq(0)) then
    !!ce = !ce
    !!alert.error('No plates exist in current support')
    return
  endif
  !!ce = !ce

  -- Identify the plate to be modified

  prompt off
  prompt load escape |Identify the plate to be modified|
  id pjoi @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt dismiss
  prompt on

  !picked = !!ce

  -- Do the identified pjoi belong to the support

  !supportNameOfPicked = !!mdsGetSuppName(!!ce)
  !ce = !!ce
  !!ce = !this.form.support.stru
  !supportBeingModified = !!mdsGetSuppName(!!ce)
  !!ce = !ce
  if (!supportNameOfPicked.neq(!supportBeingModified)) then
    !!alert.error('Identified plate does not belong to this support.')
    return
  endif

  !!ce = !picked

  -- Is it a plate

  !func = func
  if (!func.neq('PLAT')) then
    !!alert.error('Identified element is not a plate.')
    return
  endif

  -- Is it a bearing plate, if so user cannot modify

  if (!!ce.gtyp.eq('BEAR')) then
    !!alert.error('Identified plate is a bearing plate and cannot be modified.')
    return
  elseif (!!ce.gtyp.eq('FRP')) then
    !!alert.error('Identified plate is a full reinforcement and cannot be modified.')
    return
  endif

  -- Test if the identified ancillary is correct for the type of plate being identified

  !desp = desp
  !!mdsCreatePlate.xlen.val = !desp[1]
  !!mdsCreatePlate.ylen.val = !desp[2]
  !!mdsCreatePlate.zlen.val = !desp[3]
  !this.plate = !!ce
  !this.mode = 'MODIFY'
  !this.setTitle()

  -- Set the correct plate type toggle and activate /deactivate the gadgets

  -- Type 1 is a compensating plate and only the zlen is definable at 5 to 30mm in 5mm steps
  -- Type 2 is bearing plate, using rules to set the size
  -- Type 3 is a partition plate

  !this.xlen.active = TRUE
  !this.ylen.active = TRUE
  !this.zlen.active = TRUE
  !gtyp = gtyp
  if (!gtyp.eq('COMP') or !gtyp.eq('COMB')) then
    !this.plates.val = 1
  elseif (!gtyp.eq('BEAR')) then
    !this.plates.val = 2
  elseif (!gtyp.eq('PART')) then
    !this.plates.val = 3
  elseif (!gtyp.eq('FRP')) then
    !this.plates.val = 4
  else
    !!alert.error('Identified element is not a plate.')
    return
  endif

endmethod

define method .setTitle()

  if (!this.mode.eq('CREATE')) then
    !this.formtitle = 'Plates - Creation'
  elseif (!this.mode.eq('MODIFY')) then
    !this.formtitle = 'Plates - Modify'
  elseif (!this.mode.eq('DELETE')) then
    !this.formtitle = 'Plates - Creation'
  endif

endmethod

define method .deleteAll()

  -- Do any plates exist

  !ce = !!ce
  !!ce = !this.form.support.stru
  var !pnod coll all pjoi with func eq 'PLAT' for ce
  if (!pnod.size().eq(0)) then
    !!ce = !ce
    !!alert.error('No plates exist in current support')
    return
  endif
  !!ce = !ce

  var !pnods eval owner for all from !pnod

  -- Confirm deletion

  if (!!alert.confirm('Are you sure you want to delete all plates?').eq('YES')) then
    do !deleteAll values !pnods
      !!ce = !deleteAll.dbref()
      pnod
      var !rule rule
      if (!rule.match('NPOS Dynamic Rule').gt(0)) then
        rule delete all
      endif
      pjoi 1
      cutb 0
      reconn recalc
      handle ANY
      endhandle
      pnod
      delete pnod
    enddo
  endif

  !this.mode = 'CREATE'
  !this.setTitle()

endmethod

define method .common(!sctn is DBREF,!atta is DBREF,!spref is DBREF,!xlen is REAL,!ylen is REAL,!zlen is REAL)

  -- !sctn is identified sctn
  -- !atta is identified atta
  -- !spref is spref of plate
  -- !xlen is required xlen
  -- !ylen is required ylen
  -- !zlen is required zlen

  !!ce = !sctn
  var !sctnZdir zdir wrt /*
  stru
  !struName = !!ce.name
  $!struName/MAIN
  last mem
  handle ANY
  endhandle
  new pnod
  !pnod = !!ce
  rule set npos dynamic p9 pos of $!atta
  rule delete npos
  new pjoi
  cref $!sctn
  !pjoi = !!ce
  func 'PLAT'
  !pjoi = !!ce
  stru
  !!ce = !sctn
  var !opdi zdir wrt /*
  stru
  !!ce = !pjoi
  opdir $!opdi wrt /*

  -- Set spref and sizes

  despar 0mm 0mm 0mm 0mm
  !!ce.spref = !spref
  despar $!xlen $!ylen $!zlen 100mm
  if (!!ce.prop.zlen.real().leq(20)) then
    matref /S235JRG2
    --elseif !!ce.prop.zlen.real().gt(20) and !!ce.prop.zlen.real().leq(30) then
  elseif (!!ce.prop.zlen.real().gt(20)) then
    matref /S235J2G3
  endif

  -- Firstly set the opdir, to the zdir of the identified section

  !getOpdi = object MDSPLINES(!sctn,!atta)
  !setOpdi = !getOpdi.drne
  opdi $!setOpdi


  -- The bangle has to be set so the p302 dir is equal to the zdir of the sctn
  do !setBangle from -180 to 180
    bangle $!setBangle
    var !p302dir p302 dir wrt /*
    if (!p302dir.direction().angle(!sctnZdir.direction()).gt(-.1) and !p302dir.direction().angle(!sctnZdir.direction()).lt(.1)) then
      --if !p302dir.eq(!sctnZdir) then
      break
    endif
  enddo

  if (!!ce.bangle.eq(180) or !!ce.bangle.eq(-180)) then
    bangle 0
  endif

  -- This will orientate the plate 90 degrees out, because we cannot ori with a true ori
  -- We need to get the direction of P301 to p302 and reset the opdi

  !p1dir = p1 dir wrt /*
  !p2dir = p2 dir wrt /*
  end
  move $!opdi wrt /* thro $!atta
  move $!p2dir thro $!atta
  same

  pin 9 copy p9 of $!atta
  pin 8 copy p0 of $!atta
  var !pin8dir pin 8 dir
  pin 8 dir $!pin8dir
  var !dist1 const dist pin 9 to pin 8
  pin 9 plane pin 9 clear 0 inf ce
  var !dist2 const dist pin 9 to pin 8
  if (!dist1.real().gt(!dist2.real())) then
    !opdir = opdir
    var !opdi opdir
    !opdir = !opdi.direction()
    !opdir = !opdir.opposite()
    -- opdir $!opdir
  endif
  pin 9 at ce
  !opdidir = opdi
  pin 9 dir $!opdidir
  pin 9 plane pin 9 thro P301
  pin 8 copy pin 9
  pin 8 plane pin 8 clear 0 inf $!sctn
  var !distToMovePlate const dist pin 9 to pin 8
  -- added this check to stop an error occurring if the plate distance is 0, [RM, 25/09/06]
  if (!distToMovePlate neq '0') then
    var !testdir const dir pin 9 to pin 8
    --dtf mod to stop the plate moving 22mar05
    if (!testdir.direction().angle(U).lt(-.1) and !testdir.direction().angle(U).gt(.1)) then
      --if !testdir.neq('U') then
      var !pin8dir pin 8 dir
      by $!pin8dir $!distToMovePlate wrt /*
    endif
  endif
  -- pin 9 off
  -- pin 8 off

  --  if !atta.adir.wrt(/* ).string().eq('U WRT /*') or !atta.adir.wrt(/* ).string().eq('D WRT /*') then
  --  !p9dir = p9 dir of $!atta
  --  opdir u wrt /*
  --  end
  --  move $!p9dir clear 0 inf $!atta
  --  move $!p9dir dist $!zlen
  --  same
  --  endif
  --  !!mdsResetPins(8,9)

  !!ce = !atta
  :MdsPlate same
  same
  !desp = desp

  -- Name pjoi

  !!ce = !sctn
  stru
  !struName = !!ce.name

  !!ce = !pnod
  handle NONE
    do !count from 1 to 100
      name $!struName-P$!count
      handle NONE
        break
      elsehandle ANY
        skip
      endhandle
      pjoi 1
      handle NONE
        name $!struName-P$!count$n-PJOI
      elsehandle ANY
      endhandle
    enddo
  elsehandle ANY
  endhandle

  -- Set parameters in form

  !!ce = !pjoi

  !desp = desp
  !this.xlen.val = !desp[1].real()
  !this.ylen.val = !desp[2].real()
  !this.zlen.val = !desp[3].real()

  !this.mode = 'CREATE'
  !this.setTitle()

  -- Always leave common plate method at the new pjoi

  !!ce = !pjoi

endmethod

define method .getBearing(!picked is DBREF,!xlen is REAL,!ylen is REAL,!zlen is REAL)

  -- Old rules
  -- The following rule to be true
  -- B - C >= 2 x (R+T) + 30
  -- Where B = section width
  --       C = Atta Y foot print (length)
  --       R = Radius of section
  --       T = Thickness of section
  --
  -- OR
  -- C > B
  -- Where B = section width
  --       C = Atta Y foot print (length)
  -- End of old rules

  -- The follow rules are to be used for bearing plates
  -- MSH 80 to 120
  -- F = D + 30 ( xlen) round to next 50
  -- E = B (ylen)
  -- S = 15 (zlen)
  -- MSH 140 to 260
  -- F = D + 30 ( xlen) round to next 50
  -- E = B - R x t (ylen)
  -- S = 15 if MSH 140
  -- S = 20 if not (zlen)

  -- MSH size of !picked
  !sctnPara = cpar of $!!ce

  --!b = !!ce.prop.dept.real()
  !c = !picked.prop.yfp.real()
  --!r = !!ce.prop.erad.real()
  --!t = !!ce.prop.xthk.real()

  -- !left1 = !b - !c
  -- !right1 = ((2 * (!r + !t)) + 30 )
  !xlen = !picked.prop.xfp.real() + 30
  !xlen = (int(!xlen / 50 + 1)) * 50
  if (!sctnPara[1].lt(140)) then
    !ylen = !sctnPara[1].real()
  else
    !ylen = !sctnPara[1].real() - (5 * !sctnPara[3])
    !remainder = !ylen - (int(!ylen))

    if (!remainder.neq(0)) then
      !ylen = (int(!ylen / 10 + 1)) * 10
    endif

    if (!ylen.gt(160)) then
      !ylen = 160
    endif

    -- <RM> 07 December 06 -- Amendment requested by Areva NP
    -- get the diameter of the pipe clamp
    var !clampbore pl bore of $!picked
    -- if this is less than or equal to 200mm then we subtract 10mm from YLEN
    if (!clampbore.real().leq(200) and !sctnPara[1].gt(140)) then
      !ylen = !ylen - 10
    endif
    -- <RM> 07 December 06 end of fix

  endif

  if (!sctnPara[1].real().lt(160)) then
    !zlen = 15
  else
    !zlen = 20
  endif

endmethod

-- Method to name the pnod/pjoi

define method .namePlates()

  Pnod
  handle ANY
  elsehandle NONE
    stru
    !name = name
    same
    do !count from 1 to 100
      name $!name/PNOD$!count
      handle ANY
        skip
      elsehandle NONE
        break
      endhandle
    enddo
    pjoi 1
    handle NONE
      do !count from 1 to 100
        name $!name/PNOD$!count/P
        handle ANY
          skip
        elsehandle NONE
          break
        endhandle
      enddo
    elsehandle ANY
    endhandle
  endhandle

endmethod

define method .setWeldSize(!picked is DBREF, !xlen is REAL, !ylen is REAL, !sctnWidth is REAL)

  !wasHere = !!ce

  -- If the plate is a partition plate then get the weld size from the section

  if (!!ce.gtyp.eq('PART')) then
    goto cref
    handle NONE
      if (!this.endText.eq('POSS')) then
        do !loop values :mdswelddata
          var !coll coll all ddat with  matchwild(ddpr,'*START*') for $!loop
          if (defined(!coll[1])) then
            !!ce = !coll[1].dbref()
            end
            3
            !weldSize = ddpr
          endif
        enddo
      else
        do !loop values :mdswelddata
          var !coll coll all ddat with  matchwild(ddpr,'*END*') for $!loop
          if (defined(!coll[1])) then
            !!ce = !coll[1].dbref()
            end
            3
            !weldSize = ddpr
          endif
        enddo
      endif
      !!ce = !wasHere
      :Mdsweldsize $!weldSize
    elsehandle ANY
    endhandle
  else

    -- The weld size is stored in the uda :MDSWeldSize at pjoi because it is a calculation
    -- Weldsize = (C (prop yfp) + D ( prop xfp)) x weld size of ancillary / (xlen + ylen)

    !c = !picked.prop.yfp.real()
    !d = !picked.prop.xfp.real()

    -- dtf >>> 05.07.06 do not modify this next line
    -- the if statement should be lt but framatome can live withe the error
    -- as long as it is consistent
    if (!ylen.gt(!sctnWidth)) then
      !ancillaryWeldSize = !picked.:MdsWeldSize
      !ancillaryWeldSizeS = !ancillaryWeldSize.split(',')
      !ancillaryWeldSizeS.sort()
      !ancillaryWeldSizeS.invert()
      !weldSize = ((!c + !d) * (!ancillaryWeldSizeS[1].real() / (!xlen + !ylen)))
    else
      !ancillaryWeldSize = !picked.:MdsWeldSize
      !ancillaryWeldSizeS = !ancillaryWeldSize.split(',')
      !ancillaryWeldSizeS.sort()
      !ancillaryWeldSizeS.invert()
      !weldSize = !ancillaryWeldSizeS[1].real()
    endif
    !remainder = !weldSize - (int(!weldSize))
    if (!remainder.neq(0)) then
      !weldSize = (int(!weldSize + 1))
    endif
    if (!weldSize.lt(3)) then
      !weldSize = 3
    endif
    :MdsWeldSize '$!weldSize,$!weldSize'

    -- If the plate length is greater than the section width we must get the weld size from the atta

    if (!sctnWidth.lt(!ylen)) then
      if (!ancillaryWeldSizeS[1].real().lt(3)) then
        :MdsWeldSize '3,3'
      else
        :MdsWeldSize '$!ancillaryWeldSizeS[1],$!ancillaryWeldSizeS[1]'
      endif
    endif
  endif

  !!ce = !wasHere

endmethod
