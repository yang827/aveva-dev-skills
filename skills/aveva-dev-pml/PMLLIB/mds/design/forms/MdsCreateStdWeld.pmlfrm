-- Define Form
setup Form !!MDScreateStdWeld

  title 'Standard Welds'

  init '!this.init()'

  Path down

  frame .welds 'Create/Modify Weld Items'

   path down

   text .dtsen   ' DataSet Name: ' width 50 is STRING
   text .symbol  '  Symbol Name: ' width 50 is STRING
   text .desc    '  Description: ' width 50 is STRING

  exit

  button .apply ' Apply '    call '!this.ok()' ok
  button .dismiss ' Dismiss ' at xmax form -size ymin cancel

  member .modify is BOOLEAN
  member .source is dbref
  member .destination is dbref
  member .existingstds is ARRAY
  member .cstds is ARRAY
  member .currentstd is mdsweld
  member .edit is MDSWELD
  member .allweldlist is mdsweldlist
  member .form is form
  member .context is STRING
  !this.context = 'NEW'
  !this.modify = FALSE

exit
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .init()

  !this.form =  !!mdsstdwelds

  if !this.context eq 'AREA' then
-- WE ARE CREATING A NEW WELD AREA TO STORE WELDS
    !this.dtsen.val = '/MDS/STD/WELDS'
    !this.symbol.active = FALSE
    !this.desc.active = FALSE
  elseif !this.context eq 'NEW' then
-- WE ARE CREATING A NEW WELD
   !this.dtsen.val = !!mdsstdwelds.arealist.selection().dbref().name & '/'
   !this.symbol.active = TRUE
   !this.desc.active = TRUE
  else
-- WE ARE MODIFYING A WELD
   !this.dtsen.val = '/MDS/STD/WELDS'
   !this.symbol.active = TRUE
   !this.desc.active = TRUE
   !this.fillform()
  endif

endmethod
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .resetlist()

  var !std coll all ddse for $!this.arealist
  var !names eval name for all from !std
  !this.weldlist.dtext = !names
  !this.weldlist.rtext = !std
  !this.fillform()

endmethod
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .fillform()

   !this.dtsen.val = !this.currentstd.dtse.name
     handle ANY
         !this.dtsen.val = 'unset'
     endhandle
   !this.symbol.val = !this.currentstd.symboldata.ddprop.replace(|(|,||).replace(|)|,||).replace(|'|,||).trim()
     handle ANY
       !this.symbol.val = 'unset'
     endhandle
   !this.desc.val   = !this.currentstd.dtse.description
     handle ANY
       !this.desc.val = 'unset'
     endhandle
   !this.currentstd.description = !this.desc.val
   if !this.desc.val eq '' then
     !this.desc.val = 'unset'
   endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .ok()


  if !this.context.eq('AREA') then
    !!ce = /MDS/STD/WELDS
    new DDAR $!this.dtsen
      handle ANY
        !!alert.error('$!!error.text')
        if !!ce.name.match('=').eq(1) then
          delete DDAR
        endif
      endhandle
    !this.form.init()
    return
  endif

  !temp = !!mdsstdwelds.arealist.val
  if !this.context eq 'NEW' then
-- this bit is used to create
    !newweld = object MDSweld()
    !newweld.areaname = !!mdsstdwelds.arealist.selection()
    !newweld.name    = !this.dtsen.val
    !newweld.symbol  = !this.symbol.val
    !newweld.description = !this.desc.val
    !newweld.wpurp = 'STD'
    !newweld.createdataset('std')
  else $* its modify
    !This.form.currentstd.symbol = !this.symbol.val
    !This.form.currentstd.description = !this.desc.val
    !This.form.currentstd.createdesweld(TRUE,!this.dtsen.val,'STD' )
    !this.context = 'NEW'
  endif

  !!mdsstdwelds.init()
  !!mdsstdwelds.arealist.val = !temp
  !!mdsstdwelds.resetlist()

endmethod
--------------------------------------------------------------------------------

