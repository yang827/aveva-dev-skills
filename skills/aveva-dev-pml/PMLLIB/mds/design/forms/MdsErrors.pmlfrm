--
-- File:		MdsErrors.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		16 July 2003
--
-- Description:
-- Form Definition for error found by MDS when trying to edit a support
--
--------------------------------------------------------------------------------

-- Kill existing form definition

Kill !!MdsErrors

-- Define Form
Setup Form !!MdsErrors blocking

  !!MdsErrors.formtitle    = |Error Report|
  !!MdsErrors.icontitle    = ||
  !!MdsErrors.Callback     = ||
  !!MdsErrors.formrevision = ||

  -- Body of Form

    para .Tag text |Support Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .Check || at x0 ymax
      list   .ErrorList width 80 length 10
    exit

    para .text1 at x0 ymax+.5 width 85 lines 1
    para .text2 at x0 ymax    width 85 lines 1

    button .Ok     |   OK   | at x1 ymax+0.5  OK
    button .Cancel | Cancel | at xmax_errorlist-8 ymin  CANCEL

-- Members

    member .disablecancel is BOOLEAN
    !This.disablecancel = FALSE

--<wd>20jul2004
    member .supportmem is ARRAY
--<wd>20jul2004

-- End form definition
exit

-- End of file MdsError.pmlfrm



------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
-- Method .cancel(!members is ARRAY)
------------------------------------------------------------------------------------------------
--<wd>20jul2004
------------------------------------------------------------------------------------------------

-- CANCEL button callback method for this form set in the PML function !!mdsselectsupp.pmlfnc
  define method .cancel(!members is ARRAY)

-- Unclaim ALL MEMBERS and HIERARCHY of Current MDS Support on clicking the ' Cancel ' Button on the !!MDSERRORS form
    do !supportmember values !members
      unclaim $!supportmember hier
      handle ANY
      endhandle
    enddo

  endmethod

