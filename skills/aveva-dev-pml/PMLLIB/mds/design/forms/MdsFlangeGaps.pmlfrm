--
-- File:		MdsFlangeGaps.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Mon 27 June 2005
--
--
-- Description:
-- Form Definition for flange gap options
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFlangeGaps

-- Define Form
Setup Form !!MdsFlangeGaps

  !!MdsFlangeGaps.formtitle    = |MDS Flange Gaps|
  !!MdsFlangeGaps.icontitle    = ||
  !!MdsFlangeGaps.callback     = ||
  !!MdsFlangeGaps.formrevision = ||

-- Body of Form

  frame .Flange |Flange Gaps| at x0 ymax
    text .Gap1  |ID 1 | tagwid 4 width 8 is real format !!DistanceFmt
    path right
    rgroup .GapToggle1 at xmax+0.1 ymin -0.2 horizontal
        add tag |Off|
        add tag |Inside|
        add tag |Outside|
    exit
    path down
    text .Gap2  |ID 2 | tagwid 4 at xmin.gap1 ymax+0.5 width 8 is real format !!DistanceFmt
    path right
    rgroup .GapToggle2 at xmax+0.1 ymin -0.2 horizontal
        add tag |Off|
        add tag |Inside|
        add tag |Outside|
    exit
    rgroup .FlangeGapType at x1 ymax |Use| horizontal
      add tag 'Geometry'
      add tag 'Origin'
    exit
  exit

  button .Cancel | Dismiss | at xmax form-size ymax ok

exit

return
    Button .Default |Default| at x0 ymax_flange+0.2 call |!Load = array()
!load.append('MDS')
Call !!MdsReadDefs(!!MdsFlangeGaps,!Load)|

  -- Bottom Line


  -- Form members
    member .Structure  is STRING

    member .Pipes      is STRING

    member .MaxAng     is REAL

    member .MaxPiva    is REAL

    member .MaxPwar    is REAL

    member .MinHangRod is REAL

    member .SpecPre is STRING

    member .TranPref is STRING

    member .TranText is STRING

    member .SpecFla is BOOLEAN

-- SJR 12/09/02 - Added new representation level default
    member .levChange is REAL

-- End form definition
exit

-- Populate gadgets
  -- Creation Site Name
  !!MdsFlangeGaps.Site.val = 'Not Set'

  !!MdsFlangeGaps.slope.val = '1/10'

  -- Structural setting
  -- Call !!MdsSetStru()

  -- Piping setting
  Call !!MdsSetPipe()

--$(

  -- populate CreateCons option

     !Dstring = 'Without Connections\With Connections\With Geometry'
     !Rstring = '1\2\3'

     !Dtext = !Dstring.split('\')
     !RText = !RString.split('\')

     !!MdsFlangeGaps.CreateCons.Dtext = !Dtext
     !!MdsFlangeGaps.CreateCons.Rtext = !Rtext

  -- populate ModsCon option

     !Dstring = 'Warning\Error\Ignore'
     !Rstring = 'WARNING\ERROR\IGNORE'

     !Dtext.clear()
     !Rtext.clear()
     !Dtext = !Dstring.split('\')
     !RText = !RString.split('\')

     !!MdsFlangeGaps.ConnMods.Dtext = !Dtext
     !!MdsFlangeGaps.ConnMods.Rtext = !Rtext

--$)

-- End of file MdsFlangeGaps.frm
