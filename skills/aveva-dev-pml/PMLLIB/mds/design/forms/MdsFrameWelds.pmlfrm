--
--
-- Description:
-- Form Definition for selecting ALL ancillary items found in dimensions default file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearwelddisplay()               -
--  createweld()                     -
--  deleteweld()                     -
--  drawframewelds()                 -
--  editweld()                       -
--  elementname()                    -
--  fillvolume(STRING)               -
--  getbores()                       -
--  getframemem()                    -
--  getframes()                      -
--  getplatewelds(DBREF)             -
--  getppoints(DBREF)                -
--  getsctnweldmem()                 -
--  getselweld()                     -
--  gettemplatemem()                 -
--  init()                           -
--  modname()                        -
--  recall()                         -
--  saveEdits()                      -
--  select(STRING)                   -
--  selectweld()                     -
--  setpoints()                      STRING
--  setrgroup(REAL)                  -
--  setupFormFrames(BOOLEAN)         -
--
setup form !!mdsFrameWelds resize
track 'DESICE' call '!this.elementname()'

  !!mdsFrameWelds.formtitle    = |Framework Weld Selection|
  !!mdsFrameWelds.icontitle    = ||
  !!mdsFrameWelds.callback     = |!this.init()|
  !!mdsFrameWelds.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
  list .standard   | All Types     | at xmin ymax+0.3 call |!this.gettemplatemem()| width 38 length 10
  list .strulist   | Templates | at xmax+0.3 ymin call '!this.getframemem()' width 10 height 10
  list .memberlist | Sctn members |  at xmax+0.3 ymin call '!this.getsctnweldmem()' width 14 height 10
  list .welds      |  Welds  |    at xmax+0.3 ymin call '!this.getselweld()' width 22 height 10
  list .ppointlist |PPoints| at xmax+0.3 ymin multiple width 5 height 10

  path down
  vdist 1

  button .selstd  | New Weld.. | at x0 ymax call |!this.createweld()|
  button .delweld | Delete Weld | at xmax+1 ymin call |!this.deleteweld()|
  button .showstd 'View Standard..' at xmax+1 ymin call |!!mdsAddPlot(!this.standard,'SHOW',!this)|
  path down
  vdist 0

  frame .additional 'Section/Weld Data'  at xmin.selstd ymax

   button .resel ' Reselect Std... ' at x0.5 y1  call '!this.recall()'
   rgroup .joints 'Joint and Fitting Welds'  at xmax+2 ymin-0.5 horizontal
      add tag ' Generic '       select 'GENERIC'
      add tag ' Current Joint ' select 'SPECIFIC'
   exit

    text .sctnname '    Section:'  at xmin .resel ymax+0.5  width 37 is STRING
    text .dtsen    '  Weld name:' at xmin.sctnname ymax call '!this.modname()' width 37 is STRING
    text .symbol   'Symbol Name:' at xmin.sctnname ymax width 37 is STRING
    text .desc     'Description:' at xmin.sctnname ymax width 37 is STRING
    text .tagtext  '  Weld Size:' at xmin.sctnname ymax width 37 is STRING
    text .ppoint   '    PPoints:' at xmin.sctnname ymax width 24 is STRING
   button .resetpoints 'Use Selected' at xmax.ppoint ymin call |!this.ppoint.val = !this.setpoints()|

   frame .posi    ' Set Weld Position '    at xmin.sctnname ymax
     rgroup .enddef ' Weld Position ' at xmin + 1 ymax+ 0.4 call '!this.setrgroup(!this.enddef.val)' horizontal
      add tag ' Single Position ' select 'LOC'
      add tag ' Start & End  ' select   'SEND'
     exit
     vdist 1
      text   .start 'Start: ' at xmin .enddef ymax+0.5 width 33 is STRING
     button .idstart  ' Pick ' at xmax ymin call |!!mdspickweld.type.val = 'Start' !!mdspickweld.form = !this show !!mdspickweld|
      text   .end   '  End: ' at xmin .enddef ymax+0.5 width 33 is STRING
     button .idend    ' Pick ' at xmax ymin call |!!mdspickweld.type.val = 'End' !!mdspickweld.form = !this show !!mdspickweld|
   exit
    button .save ' Save ' at xmin ymax+0.3  call '!this.saveEdits()'
    --button .cancel | Dismiss | at xmax.idend-8 ymin ok
 exit

  --text .name 'name' width 12 is STRING
  view .vol at xmax .additional + 1 ymin.showstd vol
    width 52
    hei 15
  exit
  --!this.vol.setsize(52,15)
-- Bottom Line
  -- button .cancel | Dismiss | at xmax form-8 ok

  para .spref at xmax form - 56 ymin width 45 lines 1

 menu .selmenu
  !this.selmenu.add('callback','Select all','!this.select(|all|)')
  !this.selmenu.add('callback','Clear Selections','!this.select(|clear|)')
  !this.ppointlist.setpopup(!this.selmenu)


-- Members
  member .sizes is ARRAY
  member .weldlist is MDSWELDLIST
  member .currentstd is MDSWELD
  member .replacement is STRING
  member .suppfunction is STRING
  member .suppform is FORM
  member .error is BOOLEAN
  member .emess is STRING

-- End form definition
exit

-- load ALL ancillary types
-- for user to select the standard he wants to modify
-------------------------------------------------------------------------------------------
define method .init()

  -- populate the list of available standards
  !this.getframes()
  -- fill in the structure list
  !this.gettemplatemem()

endmethod
--------------------------------------------------------------------------------------------
-- method to write the changes to the database for a section weld
define method .saveEdits()
   -- check to make sure that all the values have been set
   if !this.tagtext.val eq '' then
     if !!alert.confirm('Weld size is unset - Do you want to continue?').eq('NO') then
        return
     endif
   endif
   if !this.start.val eq '' then
        !!alert.error('Weld Position is unset')
        return
   endif

   !this.currentstd.form = !this
   !this.currentstd.tagtext = !this.tagtext.val
   if !this.currentstd.designitem.type inset('SJOI','PJOI','FITT') then
     !this.currentstd.wpurp = 'ANCI'
     !this.currentstd.start = ''
     !this.currentstd.end   = ''
   else
     !this.currentstd.wpurp = 'SCTN'
   endif

   -- set the design item for the current weld
   !this.currentstd.designitem = !this.sctnname.val.dbref()
   !this.currentstd.name = !this.dtsen.val
   -- create the dataset or if it exists do nothing
   !this.currentstd.start    = !this.start.val
   !this.currentstd.end      = !this.end.val
   if !this.enddef.val eq 2 then
    !this.currentstd.startptype = 'SEND'
   else
    !this.currentstd.startptype = 'LOC'
   endif

  !this.currentstd.ppointstring = !this.ppoint.val.replace('Unset','')
  handle ANY
  endhandle

   !this.currentstd.createdataset('frame')
   if !this.currentstd.designitem.type.eq('SCTN') then
         !!ce = !this.memberlist.selection().dbref()
         !weldlist = !!ce.:mdswelddata
    !final = ARRAY()
         do !a values !weldlist
           if !a.badref().not() then
             !final.append(!a)
           endif
         enddo
         !final.append(!this.currentstd.dtse)
         !final.unique()
         !!ce.:mdswelddata = !final
   elseif !this.currentstd.designitem.type inset('SJOI','PJOI','FITT') and '$!this.joints' eq 'SPECIFIC' then
         !!ce = !this.memberlist.selection().dbref()
         !weldlist = !!ce.:mdswelddata
    !final = ARRAY()
         do !a values !weldlist
           if !a.badref().not() then
             !final.append(!a)
           endif
         enddo
         !final.append(!this.currentstd.dtse)
         !final.unique()
         -- set the welddata pointers
         !!ce.:mdswelddata = !final
   endif
   !this.getsctnweldmem()


endmethod
--------------------------------------------------------------------------------------------
define method .modname()

 !this.currentstd.name = !this.dtsen.val

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .select(!type is STRING)

 if !type eq 'all' then
    do !a from 1 to !this.ppointlist.dtext.size()
      !select[!a] = !a
    enddo
    !this.ppointlist.val = !select
 else
    !this.ppointlist.clearSelection()
 endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to fill in the bits when a user selects the end weld column
define method .getselweld()

 !this.selectweld()

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .setpoints()is STRING

!return = 'unset'
!selectedpoints = !this.ppointlist.selection()
handle ANY
  return !return
endhandle

do !a values !selectedpoints
  !return = !return & !a & ','
enddo

!return = !return.substring(6,!return.length() - 6)
return !return

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
--
define method .setrgroup(!val is REAL)
  if !val eq 1  then
    !active = FALSE
    !inactive = TRUE
    !this.currentstd.startptype = 'LOC'
  else
    !active = TRUE
    !inactive = FALSE
    !this.currentstd.startptype = 'SEND'
  endif
  !this.end.active     = !active
  !this.idend.active   = !active


endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to update the list of welds when the user navigates to a different element
define method .elementname()

  -- find the navigated item in the sections memberlist list
  !this.memberlist.select('rtext',!!ce.string())
  handle ANY
      return
  endhandle
  !this.getsctnweldmem()

endmethod
--------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
-- method to collect all sctn for a particular standard
define method .gettemplatemem()

  !template = !this.standard.selection()
  var !templist coll all stru with match(name,'MDS/$!template') gt 0 for /MDS/TEMPLATES

  -- var !templist coll all stru with match(name,'/MDS/$!template') gt 0
  !dbwrite = FALSE
  if undefined(!templist) then
      !names[1] = 'None Found'
      !templist[1] = 'unset'
  elseif !templist.size().eq(0) then
      !names[1] = 'None Found'
      !templist[1] = 'unset'
  else
    !dbwrite = !templist[1].dbref().dbwrite

     var !names eval name for all from !templist
     do !a index !names
        !names[!a] = !names[!a].after('MDS/')
     enddo
  endif

  !this.strulist.dtext = !names
  !this.strulist.rtext = !templist
  !this.strulist.val = 1

  if !!mdsshowplot.shown() and !templist[1].neq('unset') then
    !!mdsAddPlot(!this.standard,'SHOW',!this)
  endif

  -- fill in the members list
  !this.getframemem()

  --setup the editable form frames so that they are greyed out if the user does not have write access
  !this.setupFormFrames(!dbwrite)

  --deactivate the save button if there is no weld data to save otherwise activate it
  if !this.currentstd.designitem.unset() then
    !this.save.active = FALSE
  else
    !this.save.active = TRUE
  endif

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to collect all sctn and joints for a particular standard
define method .getframemem()

  !template = !this.strulist.selection()
  if !template eq 'unset' then
     !names[1] = 'None Found'
     !templist[1] = 'unset'
     !this.memberlist.dtext = !names
     !this.memberlist.rtext = !templist
  else
    -- get section welds
    var !templist coll all (sctn sjoi pjoi fitt) for $!this.strulist
    if !templist.size().eq(0) then
      !names[1] = 'None Found'
      !templist[1] = 'unset'
    else
       var !names eval name for all from !templist
       do !a index !names
          if !names[!a].match('=').eq(1) then
            --!names[!a] = !names[!a].dbref().flnm.split()[1] & !names[!a].dbref().flnm.split()[2]
            !names[!a] = !names[!a].dbref().flnm
          else
            !names[!a] = !names[!a].after('MDS/')
          endif
       enddo
       !this.memberlist.dtext = !names
       !this.memberlist.rtext = !templist
     endif
  endif

  -- add the stru to the volume view
  !this.fillvolume(!this.strulist.selection())

  -- fill in the welds list
  !this.getsctnweldmem()

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to look at the existing standard and get the welds associated with it
define method .getsctnweldmem()

  -- goto the section identified
  !!ce = !this.memberlist.selection().dbref()
  handle ANY
    return
  endhandle

  -- set the section name
  !this.sctnname.val = !this.memberlist.selection().dbref().name
  handle (2,813)
    return
  endhandle

  !component = !this.memberlist.selection().dbref()
  !this.currentstd.designitem = !component
  !type = !component.type
  if !type inset('SJOI','PJOI','FITT') then
    -- go and see if there are some generic welds available
    !this.joints.active = TRUE
    !this.ppoint.active = TRUE
    !this.ppointlist.active = TRUE
    !this.weldlist = object MDSWELDLIST(!component)
    !this.getppoints(!component)
    do !a values !this.currentstd.ppoints
      !this.ppointlist.select('dtext','$!a')
    enddo
    !this.enddef.active    = FALSE
    !this.start.active   = false
    !this.idstart.active = false
    !this.end.active     = false
    !this.idend.active   = false
    -- this sets the ppoint list
  else  $* its a section
     !this.joints.active = FALSE
     !this.ppoint.active = FALSE
     !this.ppointlist.active = FALSE
    !this.ppointlist.dtext = ARRAY()
     !this.enddef.active    = true
     !this.start.active   = true
     !this.idstart.active = true
     !this.end.active     = true
     !this.idend.active   = true

    !this.weldlist = object MDSWELDLIST(!component)
  endif

  if !this.weldlist.welds.size().eq(0) then
      !names[1] = 'None Found'
      !dbref[1] = 'unset'
      $!this.memberlist  :mdswelddata unset
      handle (2,614)(2,25)
      endhandle
  else
     do !a index !this.weldlist.welds
        !names[!a] = !this.weldlist.welds[!a].name.replace('/DDSE-','')
        !dbref[!a] = !this.weldlist.welds[!a].designitem.string()
     enddo
  endif
   !this.welds.dtext = !names
   !this.welds.rtext = !dbref

  -- now call the routine which displays the weld details
  !this.selectweld()

  -- if the weld can be drawn then draw an aid line and text
  !this.drawframewelds()

  -- Display the spref name if found
  !this.spref.val = !this.memberlist.selection().dbref().spref.name
    handle ANY
      !this.spref.val = 'Spref not found'
    endhandle

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- get the ppoints for a catalogue weld
-- if there are no ppoints then there cannot be a weld
define method .getppoints(!cataitem is DBREF)

   -- save the current element
   !ptref = !cataitem.ptre
   if !ptref.unset() then
    !weldarray = ARRAY()
   else
      var !ppoints coll all ptca with purp eq 'MWEL' and number gt 300 for $!ptref
      var !numbers eval number for all from !ppoints
    !weldarray = ARRAY()
      do !a index !ppoints
        !weldarray.append(!numbers[!a].string())
      enddo
   endif

   if !weldarray.size().eq(0) then
    !weldarray[1] = 'None Found'
    !this.welds.dtext = !weldarray
    !this.ppointlist.dtext = ARRAY()
    !this.clearwelddisplay()
   endif

   !this.ppointlist.dtext = !weldarray
   --!this.getplatewelds(!cataitem)

endmethod
---------------------------------------------------------------------------------------------
-- method to get a set of generic welds for a plate item
define method .getplatewelds(!cataitem is DBREF)

   -- if its a generic weld then the name will be in the format DDAR-Jointname
  !tempweld = object MDSWELD()
   !tempweld.designitem = !this.memberlist.selection().dbref()
   !name = !tempweld.getweldname(!this.joints.selection(),'std')
   $!name[1]
   handle ANY
     -- no welds yet defined
     !array[1] = 'None Found'
     !this.welds.dtext = !array
    return
  elsehandle NONE
  endhandle

  -- we now have a list of datasets for welds
  !weldlist = object MDSWELDLIST(!!ce,'STD')
  !this.weldlist = !weldlist
  !this.weldlist.currentweld = !this.weldlist.welds[1]
  handle ANY
     !array[1] = 'None Found'
     !this.welds.dtext = !array
     return
  endhandle
  !this.currentstd = !this.weldlist.currentweld
  --q var !this.weldlist.welds[1]
  do !a index !this.weldlist.welds
    !array[!a] = 'WELD $!a'
    !rarray[!a] = !this.weldlist.welds[!a].name
  enddo
  !this.welds.dtext = !array
  handle ANY
     !array[1] = 'None'
     !this.welds.dtext = !array
  elsehandle NONE
    !this.welds.rtext = !rarray
  endhandle

   -- now we have a weld object which should have the ppoints set
   do !a values !this.currentstd.ppoints
      !this.ppointlist.select('dtext','$!a')
   enddo
  !this.sctnname.val = !this.memberlist.selection().dbref().name
   handle (2,813)
     return
   endhandle

   --!this.selectweld()


endmethod
-------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to get the frame welds based on the selected standard
define method .drawframewelds()

    aid clear text all
    handle ANY
    endhandle

    aid clear cyli all
    handle ANY
    endhandle


  !this.weldlist = object MDSWELDLIST( !this.memberlist.selection().dbref() )
  !weldlist = !this.weldlist
  if defined (!weldlist.welds[1]) then
    do !weld index !weldlist.welds
       -- !aidnumber = 335 + !weld
       !weldlist.welds[!weld].drawweld(!weld)
    enddo
  endif

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to look at the existing standard and get the welds associated with it
define method .selectweld()
  if !this.welds.selection().eq('unset') then
    !weld = object MDSWELD()
    !this.currentstd = !weld
  else
     !weld = !this.weldlist.welds[!this.welds.val]
     -- we have found a proper weld, now we need to decide what to do with it
  endif
  !this.currentstd = !weld
  !this.currentstd.fillform(!this)
  if !this.currentstd.startptype.eq('SEND') then
    !this.enddef.val = 2
  else
    !this.enddef.val = 1
  endif
  !this.setrgroup(!this.enddef.val)


endmethod
----------------------------------------------------------------------------------

----------------------------------------------------------------------------------
-- method to add the current selection into the volume view
define method .fillvolume(!stru is STRING)

  if !stru.eq('unset') then
     rem all
     return
  endif

  !this.vol.shaded = TRUE

  edit view _mdsFrameWelds_vol volume
       rem all
       auto $!stru
       add $!stru

endmethod
-----------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to get welds from the standard list and create a new one
-- shows the mdsstdwelds form to get a new standard
-- returns a mdsweld object with the standard weld data
-- replaces the currentweld object
-- or maybe an editobject to be merged
--------------------------------------------------------------------------------------------
define method .createweld()

if !this.memberlist.selection().dbref().type inset('SJOI','PJOI','FITT') then
  if !this.ppointlist.selection().size().eq(0) then
      !!alert.error('No PPoints Selected - You must select at least 1 PPoint')
      return
  endif
endif
  !!mdsNewWeld.form = !this
  !!mdsNewWeld.context = 'NEW'
  show !!mdsNewWeld

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to call the weld select form to reselect a weld
define method .recall()

  !!mdsNewWeld.form = !this
  !!mdsNewWeld.context = 'RESEL'
  show !!mdsNewWeld

endmethod
--------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to show the edit weld form
--- may not be used?
define method .editweld()

  !!mdsNewWeld.source = !this.memberlist.selection().dbref()
  show !!mdsNewWeld

endmethod
------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to delete the selected weld
--
define method .deleteweld()

  !!ce = !this.dtsen.val.dbref()
  handle ANY
    !!alert.error('No Welds Selected')
    return
  endhandle

  if !!alert.confirm('Do you want to Delete this weld $!!ce.name') eq 'YES' then
    delete ddse
  endif
  -- can we find a section which points to the weld and delete the references to it
  !this.getsctnweldmem()

  --deactivate the save button if there is no weld data to save otherwise activate it
  if !this.currentstd.designitem.unset() then
    !this.save.active = FALSE
  else
    !this.save.active = TRUE
  endif

endmethod
------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- clears the bottom paragraph gadgets when there is no current weld
define method .clearwelddisplay()

  !this.dtsen.val  = ''
  !this.symbol.val = ''
  !this.desc.val   = ''
  !this.ppoint.val = ''
  !this.tagtext.val = ''

endmethod
---------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to get the range of bore sizes for each category of attas
define method .getbores()

  -- save the current element
 !current = !!ce
 !selection = !this.standard.selection()
  -- get attas
  /ATTA-$!<selection>
  var !a coll all scom for ce
  var !b eval param 1 for all from !a
  !b.unique()
  -- turn string values into reals to sort
  !block1 = object BLOCK('!b[!evalindex].real()')
  !c = !b.evaluate(!block1)
  !c.sort()
  -- turn sorted list back to strings to put them into the list gadget
  !block2 = object BLOCK('!c[!evalindex].string()')
  !b = !c.evaluate(!block2)
  !this.bores.dtext = !b
-- return to the current element
   !!ce = !current

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
--get the active framework list from the mdsappdefaults catalogue
define method .getframes()

  -- <RM> 29/08/12 upgraded the original code to work in the 12 environment - start
  -- Determine the MDS FRAMEWORKS where :MDSACTIVE is TRUE for each SECTION element in the PARAGON /MDS/STRUCTURE/DEFAULTS Catalogue
  !ctype = |SECTION|
  !scope = /MDS/STRUCTURE/DEFAULTS
  !filtr = object EXPRESSION(|:mdsactive eq TRUE|)
  -- Collect ALL of the SECTION Elements
  !sect  = object COLLECTION()
  !sect.filter(!filtr)
  !sect.scope(!scope)
  !sect.type(!ctype)
  -- SECTION Collection Results Array
  !sectresults = !sect.results()

  -- Determine the MDS FRAMEWORK types to show in this form
  !mdsstds = ARRAY()
  do !vald value !sectresults
    if (!vald.description.matchwild('SPECIAL*')) then
      skip
    elseif (!vald.description.matchwild('FB*')) then
      skip
    elseif (!vald.description.unset()) or (!vald.description.trim().eq('')) then
      skip
    else
      !mdsstds.append(!vald)
    endif
  enddo

  -- Remove any Duplicate Entries in the ARRAY
  !mdsstds.unique()

  -- SORT ARRAY into ALPHABETICAL and NUMBER order
  !sindices = !mdsstds.sortedindices()
  !mdsstds.reindex(!sindices)

  if (!mdsstds.empty()) then
    return
  else
    !unusedMdsloadStruDefs = object MDSLOADSTDDEFS(!this, !mdsstds)
    if (!this.error) then
      !!alert.error('error in compiling framework list')
      return
    endif
  endif

  !size = !!mdsFrameWelds.standard.dtext.size()
  !!mdsFrameWelds.standard.tag = 'Available Types = $!size'
  -- <RM> 29/08/12 upgraded the original code to work in the 12 environment - end

endmethod

define method .setupFormFrames(!writeable is BOOLEAN)

  --if the user has write access to the template area (for the current template) then allow editing
  if !writeable then
  	!this.additional.active = TRUE
  	!this.selstd.active = TRUE
  	!this.delweld.active = TRUE
  else
  	!this.additional.active = FALSE
  	!this.selstd.active = FALSE
  	!this.delweld.active = FALSE
  endif

endmethod
