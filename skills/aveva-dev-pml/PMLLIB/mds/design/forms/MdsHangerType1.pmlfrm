-- Kill existing form definition
kill !!mdsHangerType1

-- Define Form
setup form !!mdsHangerType1 at xr0 yr0 noquit

  !this.formtitle    = ||
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = | $Revision: 1.0 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31
    button .datum | Create datum support atta | at x1 y1 call |call !!mdsSetDatFH01(!this, 'CREATE',!this)|
    --<wd> .button .bdist | Distance | at xmin   ymax+0.25       Call |Call !!mdsPosDOnly(!this)|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsInterfacePosDist(!this)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    --<wd> button .bthro | Through |  at x1     ymax+0.2        Call |Call !!mdsPosTOnly(!this)|
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsInterfacePosThro(!this)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!this)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1
  exit

  frame .fMisc |Options| at x0 ymax width 31
    -- Icons Row 1
    button .addPipe  at x1       ymax tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call ||
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call ||
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call ||
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call ||

    -- Icons Row 2
    button .addPack       at x1 ymax+0.25 tooltip  'Add Packer'         pixmap width 18 height 18 call ||
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Hanger Elements'   pixmap width 18 height 18 call |Call !!mdsIRotHanger(!this,'!!mdsRotateInterfaceHanger(!!$!this, !!mdsRotHanger.angle.val, true)')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate a Hanger Element'     pixmap width 18 height 18 call |Call !!mdsIRotHanger(!this,'!!mdsRotateInterfaceHanger(!!$!this, !!mdsRotHanger.angle.val, false)')|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call ||
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsHangerType1,'ATTA')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call ||

    -- Icons Row 3
    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Hanger'     pixmap width 18 height 18 call |!!mdsIModFh(!this,!!mdsModFH, TRUE)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Hanger'     pixmap width 18 height 18 call ||
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call ||
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call ||
    button .setMat     at xmax+0.1 ymin tooltip 'Set Pad Material' pixmap width 18 height 18 Call |!!mdsSetMat(!!mdsHangerType1)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call ||
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4
    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Hanger Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!this)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!this,'INIT')|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!this)|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5
    button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required' pixmap width 18 height 18 call ||
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call ||
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call ||
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call ||
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call ||
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call ||
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes' pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect  at xmax+0.1 ymin tooltip 'Reconnect to another beam' pixmap width 18 height 18 call |!this.reconnect(TRUE)|

    -- Icons Row 6
    button .flipatta  at x1 ymax+0.25  tooltip 'Flip'                     pixmap width 18 height 18 call ||
    button .suppdata  at xmax+0.1 ymin tooltip 'Data'                     pixmap width 18 height 18 call |!!mdsSuppData.init(!this)|
    -- button .editAtta  at xmax+0.1 ymin tooltip 'Modify Atta Properties'   pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip  at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec  at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .mtoc      at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .dynOffset at xmax+0.1 ymin tooltip 'Offset'                   pixmap width 18 height 18 call |!!mdsInterfaceDynOffset.init(!this)|

    !desc = desc of /MDS/HANGERS
    handle (2,109)
    elsehandle NONE
      if !desc.eq('PIHASA Hanger Configurations') then
        button .clampmatl at xmax+0.1 ymin tooltip 'Pipe Clamp Material' pixmap width 18 height 18 call |!!mdsclampmatl.init(!this)|
      endif
    endhandle
  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax FORM-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   |    at x0          ymin     call |!!callInf = FALSE !this.accept(!this)|
  -- button .ok1     |           | at xmax.ok+0.5 ymin     call |!!callInf = TRUE !this.accept(!this)|

  -- Form Members
  -- Support object
  member .support     is MDSINTERFACESUPPORT

  -- Support object
  member .oldSupport     is MDSINTERFACESUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSINTERFACESUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING

  member .hangertypes is MDSINTERFACEHANGERTYPES

  -- list of plot files for this standard
  member .listofPlotfiles is ARRAY

  -- Parallel member
  member .parallel is BOOLEAN

  !this.hangertypes = object MDSINTERFACEHANGERTYPES()

  !this.blockedIcons = '1,2,3,4,6,7,9,10,11,12,13,15,19,20,21,22,23,24,26,27,29,30,31,32,34,36,37,38,41,42,58,62,63'

  --><wd>16jul2009 - DFN P-21516 (SI-12441)
  -- New FORM Members to Store the Constant Spring Full Name and the P10 direction WRt /* of the CONSTANT Spring before entering Witch Hanger
  member .constantNameOne is STRING
  member .constantDirectionOne is DIRECTION
  member .constantNameTwo is STRING
  member .constantDirectionTwo is DIRECTION
  --<<wd>16jul2009 - DFN P-21516 (SI-12441)

  member .vendorForm is FORM

  --REFACTOR member added to store beam/civils selections that will support the hanger
  member .beamArray is ARRAY

  --DUN1218 add a virtual fitting member to hold a virtualFitting object
  member .virtualFitting is MDSINTERFACEVIRTUALFITTING

  -- End form definition
exit

-- Define Methods
define method .setRestObject() is MDSINTERFACESUPPORT

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  !ce = !!ce
  !!ce = !this.support.rest.ref
  handle ANY
    -- Invalid reference
    return
  endhandle

  !oRest = !this.support.rest
  !oRest.setRestObject()
  !this.support.rest = !oRest

  !!ce = !ce

  !!kRestoreUnits(!currentUnits)
  return !this.support
endmethod

define method .resizeHanger(!hangRef is DBREF, !newFittRef is DBREF)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  aid clear line 5
  handle ANY
  endhandle
  !errNo = 0
  !!ce = !hangRef
  !attaRef = !this.support.rest.attaConnRef
  !attaName = !attaRef.name
  handle ANY
    return error 1 'Unable to resize hanger. Hanger not connected to an Atta'
  endhandle
  !alias = !this.support.rest.styp
  !virtualFitting = FALSE
  !newFittName = !newFittRef.name
  handle ANY
    --no fitting ref has been passed so we might have a virtual fitting. check for this
    if defined (!this.virtualFitting) then
      !newFittName = !this.virtualFitting.name
      !virtualFitting = TRUE
    endif
  endhandle

  -- standard length of hanger is measured from the pl of the pcla
  -- and not from the hanger head to eliminate the pipe slope influence on the length
  -- save  current hh and ht positions
  var !stdDist const dist hh to pl of last mem
  handle (2,113)
    -- List exhausted
    -- hanger does not have members (e.g. First hanger of doubleBM1Spring)
    var !stdDist const dist hh to ht
  endhandle
  --<wd>28sep2004 -- Switch ON !!mdsDacControl - HPD0025942
  !!mdsDacControl(TRUE)
  conn hh to p3 of $!attaName

  --vertical check - start
  if !virtualFitting then
    !type = !this.virtualFitting.type
    !fittingPos = !this.virtualFitting.getPosition()
    var !hangDir const dir hh to $!fittingPos
    !!mdsPushPin(4)
    pin4 at hh
    !startLine = hpos wrt world
    !endLine = $!fittingPos
    handle ANY
      !endLine = !fittingPos
    endhandle
    aid line number 5 $!startLine to $!endLine linestyle dashed
    pin4 dir u
    pin4 through $!fittingPos
    var !ang const ang pin4 to hh to $!fittingPos
    !!mdsPopPin(4)

    if(!ang.real() gt 0.2) then
      if (!type neq 'SBFI') then
        -- restores hanger position
        !errText = 'Hanger is $!ang (Direction: $!hangDir) from the vertical direction. Hanger must be vertical'
      endif
      !!kRestoreUnits(!currentUnits)
      !errNo = 51
    endif
  else
    $!newFittName
    !type = !!ce.type
    same
    var !hangDir const dir hh to p1 of $!newFittName
    !!mdsPushPin(4)
    pin4 at hh
    !startLine = hpos wrt world
    !endLine = p1 pos of $!newFittName wrt world
    aid line number 5 $!startLine to $!endLine linestyle dashed
    pin4 dir u
    pin4 through p1 of $!newFittName
    var !ang const ang pin4 to hh to p1 of $!newFittName
    !!mdsPopPin(4)

    if(!ang.real() gt 0.2) then
      if (!type neq 'SBFI') then
        -- restores hanger position
        !errText = 'Hanger is $!ang (Direction: $!hangDir) from the vertical direction. Hanger must be vertical'
      endif
      !!kRestoreUnits(!currentUnits)
      !errNo = 51
    endif
  endif
  --vertical check - end

  -- Bottom supported hangers have no fitting connection
  -- DAC's fix for HP0021504 GE 06/02/04
  !!mdsDacControl(TRUE)
  !hangerNameUnset = !!ce.name
  -- this is set in case the name is not set correctly in the template

  if !virtualFitting then
    tpos $!fittingPos
  else
    conn ht to $!newFittName
  endif

  -- Then it must be a sub fitting 'civil connections'
  handle ANY
    -- Try and find out if it is a single or double hanger
    -- atta name has become the support lug for a double
    -- therefore use this as a test.
    !newAttaName = '/' & !newFittName.split('/')[2]

    if (!attaName eq !newAttaName) then
      !hanger = 'single'
    else
      !hanger = 'double'
    endif

    if (!hanger eq 'single') then
      $!attaName
      !oriPos = !!ce.position.wrt(/* )
      PIN 1 COPY P9
      PIN 1 DIR U
      PIN 2 COPY P9
      var !pin2dir dir pin 2 to $!newFittName
      PIN 2 DIR $!pin2dir
      -- reset the positions here otherwise it moves !
      !!ce.position = !oriPos

      $!newFittName
      OWN
      OWN
      !own = !!ce
      PIN 2 PLANE PIN 2 CLEAR 0 inf $!!ce
      var !delpos pin 2 pos wrt /*
      $!newFittName
      delpos $!delpos wrt /*
      $!attaName/H1
      handle (2,109)
        $!hangerNameUnset
        !!alert.warning('Hanger' & $!hangerNameUnset & 'template name is unset please update!')
      endhandle
      tref $!newFittName
      tpos $!delpos wrt /*
      $!attaName/SBFI/H2
      $!attaName/H1

    else
      $!attaName
      PIN 1 COPY P9
      PIN 1 DIR U
      PIN 2 COPY P9
      PIN 2 DIR U
      $!newFittName
      !newAttaName = '/' & !newFittName.split('/')[2]
      OWN
      OWN
      !own = !!ce
      PIN 2 PLANE PIN 2 CLEAR 0 inf $!!ce
      var !delpos pin 2 pos wrt /*

      $!newAttaName/SBFI/H2
      delpos $!delpos wrt /*
      $!newAttaName/SBFI/H3
      delpos $!delpos wrt /*
      $!newAttaName/H1

      handle (2,109)
        $!hangerNameUnset
        !!alert.warning('Hanger' & $!hangerNameUnset & 'template name is unset please update!')
      endhandle

      CONN HT TO LAST MEM
      TREF $!newAttaName/H3
      $!newAttaName/H2
      handle (2,109)
        $!hangerNameUnset
        !!alert.warning('Hanger' & $!hangerNameUnset & 'template name is unset please update!')
      endhandle

      pin1 at hh
      pin1 dir u
      $!newAttaName/SBFI/H2
      pin1 through p1 of $!!ce
      var !delpos pin 1 pos wrt /*
      delpos $!delpos wrt /*
      $!newAttaName/H2

      tref $!newAttaName/SBFI/H2
      tpos $!delpos wrt /*

      $!newAttaName/H3
      handle (2,109)
        $!hangerNameUnset
        !!alert.warning('Hanger' & $!hangerNameUnset & 'template name is unset please update!')
      endhandle

      pin1 at hh
      pin1 dir u
      $!newAttaName/SBFI/H3
      pin1 through p1 of $!!ce
      var !delpos pin 1 pos wrt /*
      delpos $!delpos wrt /*
      $!newAttaName/H3
      tref $!newAttaName/SBFI/H3
      tpos $!delpos wrt /*
      href $!newAttaName/H1
      $!hangRef
    endif

    pin 1 off
    pin 2 off

  endhandle


  !htUp = !!ce.tpos.up
  !hhUp = !!ce.hpos.up
  !dist = !htUp - !hhUp

  aid clear line 5
  handle ANY
  endhandle
  --!numOfRods = mem hrod count
  first mem
  handle (2,113)
    -- List exhausted
    -- hanger does not have members (e.g. First hanger of doubleBM1Spring)
    hang
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)

    if(!errNo gt 50) then
      if (!type neq 'SBFI') then
        -- error to be confirm and accepted by the user
        return error $!errNo |$!errText|
      endif
    endif
    return
  endhandle

  $!attaName/H1
  handle ANY
  endhandle
  delete hanger mem
  handle ANY
  endhandle
  own

endmethod

define method .getFittOffset(!dummysteelRef is DBREF, !dummyhangType is STRING) is STRING

  --REFACTOR this method is not required for interface hangers, just return the default position
  !offset = 'E 0 N 0 D 0'
  return !offset

endmethod

define method .setGadgets()
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !attaRef = !this.support.datum

  if(!attaRef.unset()) then
    !!alert.message('Hanger is not connected to a pipe attachment (ATTA)')
    --continue out
    -- Icons Row 2
    !this.rotate.active = TRUE
    !this.rotAtt.active = TRUE

    -- Icons Row 3
    !this.modAtta.active = TRUE
    -- Icons Row 4
    !this.dim.active = TRUE
    !this.mdsadp.active = TRUE
    !this.zoom.active = TRUE
    -- Icons Row 5

    !!mdsHangerType1.rotate.active  = FALSE
    !!mdsHangerType1.rotAtt.active  = FALSE
    !!mdsHangerType1.modAtta.active = FALSE
    !!mdsHangerType1.viewStd.active = FALSE
    !!mdsHangerType1.dim.active     = FALSE

    !this.reconnect.active = TRUE
    !!kRestoreUnits(!currentUnits)
    return
  endif
  !beamRefArray = !this.support.rest.beamRefArray

  if(!beamRefArray.unset() or !beamRefArray.size() eq 0) then
    --<wd>8jul2004
    if (undefined(!!manif.exe)) then
      --<wd>8jul2004 - The 'then' added to the end of the 'if' statement
      --<GE> 08/02/07 Fix for Defect No: 10223
      --if (!attaRef.cref.tref.unset() or !attaRef.cref.tref.type neq 'SBFI')
      if (!attaRef.cref.unset() or !attaRef.cref.tref.unset() or !attaRef.cref.tref.type neq 'SBFI') then
        --<GE> 08/02/07
        --<wd>8jul2004
        -- Ignore steel work fitting for manufacturers interface fitting
        -- Also check for a civils connection
        !!alert.message('Hanger is not connected to a steelwork or civil fitting')
      endif
    endif
    --continue out
    -- Icons Row 2
    !this.rotate.active = TRUE
    !this.rotAtt.active = TRUE

    -- Icons Row 3
    !this.modAtta.active = TRUE
    -- Icons Row 4
    !this.dim.active = TRUE
    !this.mdsadp.active = TRUE
    !this.zoom.active = TRUE
    -- Icons Row 5

    !!mdsHangerType1.rotate.active  = FALSE
    !!mdsHangerType1.rotAtt.active  = FALSE
    !!mdsHangerType1.modAtta.active = FALSE
    !!mdsHangerType1.viewStd.active = FALSE
    !!mdsHangerType1.dim.active     = FALSE

    !this.reconnect.active = TRUE
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Initialize number of connections
  !i = 0
  do !h indices !beamRefArray
    if(!beamRefArray[!h].set()) then
      !i = !i + 1
      -- dtf >>> switch on for vertical lines
      if ( defined(!!manif.exe)) then
        !parallel[!i] = FALSE
        if (!!mdsVendorHangerType1.type.neq('V')) then
          !parallel[!i] = !!mdsIsTubeParallel2sctn(!attaRef, !beamRefArray[!h] )
        else
          !parallel[!i] = TRUE
        endif
      else
        !parallel[!i] = !!mdsIsTubeParallel2sctn(!attaRef, !beamRefArray[!h] )
      endif
      -- dtf <<< End of mod
      if(not !parallel[!i]) then
        -- Beam supporting the hanger is not parallel to the tube
        -- Hanger can not moved along the tube using distance.
        -- removed dtf item 189
        --!this.bdist.active = false
        --!this.dist.active = false
        --!this.bthro.active = false
        --!this.select.active = false
      else
        !ce = !!ce
        !!ce = !attaRef
        var !dist const dist p0 to pl of prev
        handle ANY
          -- Atta is the first element in the branch
          var !dist const dist p0 to ph
        endhandle
        !this.bdist.active = TRUE
        !this.dist.active = TRUE
        !this.dist.val = !dist.real()
        !this.bthro.active = TRUE
        !this.select.active = TRUE

      endif
    endif
  enddo

  -- Icons Row 2
  !this.rotate.active = TRUE
  !this.rotAtt.active = TRUE

  -- Icons Row 3
  !this.modAtta.active = TRUE
  -- Icons Row 4
  !this.dim.active = TRUE
  !this.mdsadp.active = TRUE
  !this.zoom.active = TRUE
  --    !this.adploc.active = true
  -- Icons Row 5

  !!mdsHangerType1.rotate.active  = FALSE
  !!mdsHangerType1.rotAtt.active  = FALSE
  !!mdsHangerType1.modAtta.active = FALSE
  !!mdsHangerType1.viewStd.active = FALSE
  !!mdsHangerType1.dim.active     = FALSE

  !this.reconnect.active = TRUE
  !!kRestoreUnits(!currentUnits)

endmethod

define method .cancelHanger(!userConfirm is BOOLEAN)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Initialise variables
  -- Test Decision
  -- If the manufacturers interface has been used and the user cancel then we need to delete silently if the support if the exit code is 0
  -- If this is the first time around then the hanger will have no members, therefore do not ask user to confirm
  if (!!manif.dat.set()) then
    !exitCode = object FILE(!!manif.dat & '\Exitcode')
    handle NONE
      if (!exitCode.exists()) then
        !code = !exitCode.readfile()
        if (!code[1].eq('0')) then
        else
          if(!userConfirm) then
            !membersOfHang1 = mcount of hang 1 of /$!this.name/REST
            if (!membersOfHang1.eq(0)) then
            else
              if(!!alert.confirm(|Ok to cancel Support "$!this.name". This will DELETE the Support?|) eq 'NO')then
                !!kRestoreUnits(!currentUnits)
                return
              endif
            endif
          endif
        endif
      endif
    elsehandle ANY
    endhandle
  endif

  !this.setRestObject()

  !support = !this.support
  !datum = !support.datum

  if(!datum.unset()) then
    -- Unset the oldSupport member variable
    !this.oldSupport = object MDSINTERFACESUPPORT()

    -- Unset the support member variable
    !this.support = object MDSINTERFACESUPPORT()

    -- Clear passed form Gadgets
    call !!mdsInterfaceHangerClearGadgets(!this)

    -- If dimensions are displayed the clear them from the display
    !!mdsClearDim()

    -- Hide Form
    !this.hide()

    -- Reset MdsFHanger
    !!mdsInterfaceHanger.manifActions()
    handle ANY
    endhandle

    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Test Decision if datum set
  if (!datum.badref().not() AND !userConfirm) then
    !confirmMsg = |Ok to cancel Support. This will DELETE the Support?|
    if (!this.support.preliminaryStore.set()) then
      !confirmMsg = |Ok to cancel Support. This will REVERT the Support back to the previous state.|
    endif

    if (!!alert.confirm(!confirmMsg) eq 'NO')then
      return
    endif
  endif

  !atta = !datum.name
  handle ANY
    -- Unset the oldSupport member variable
    !this.oldSupport = object MDSINTERFACESUPPORT()

    -- Unset the support member variable
    !this.support = object MDSINTERFACESUPPORT()

    -- Clear passed form Gadgets
    call !!mdsInterfaceHangerClearGadgets(!this)

    -- If dimensions are displayed the clear them from the display
    !!mdsClearDim()

    -- Hide Form
    !this.hide()

    -- Reset MdsFHanger
    !!mdsInterfaceHanger.manifActions()
    handle ANY
    endhandle

    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  --  Delete the temporary fittings
  !support = !this.support
  if(!support.rest.set()) then

    do !hangerNo indices !support.rest.hangers
      -- DAC's fix for HP0021504 GE 05/02/04
      !!mdsDacControl(TRUE)

      -- delete all temporarily created fittings
      !fittToDelete = '$!atta$n/FITT/H$!hangerNo'
      !!ce = !fittToDelete.dbref()
      handle ANY
      elsehandle NONE

        delete fitt
        handle ANY
          !!alert.error('Unable to delete $!fittToDelete')
        endhandle
      endhandle
      !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/FIRST'
      !!ce = !fittToDelete.dbref()
      handle ANY
      elsehandle NONE

        delete fitt
        handle ANY
          !!alert.error('Unable to delete $!fittToDelete')
        endhandle
      endhandle
      do !i
        !notFound = FALSE
        !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/$!i'
        !!ce = !fittToDelete.dbref()
        handle ANY
          !notFound = TRUE
        elsehandle NONE

          delete fitt
          handle ANY
            !!alert.error('Unable to delete $!fittToDelete')
          endhandle
        endhandle
        !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/$!i/FIRST'
        !!ce = !fittToDelete.dbref()
        handle ANY
          break if(!notFound)
        elsehandle NONE

          delete fitt
          handle ANY
            !!alert.error('Unable to delete $!fittToDelete')
          endhandle
        endhandle

      enddo
    enddo

    -- delete all CMPF fittings
    !fittToDelete = '$!atta$n/CMPF'
    !!ce = !fittToDelete.dbref()
    handle ANY
    elsehandle NONE
      delete cmpf
      handle ANY
        !!alert.error('Unable to delete $!fittToDelete')
      endhandle
    endhandle

    -- DAC's fix for HP0021504 GE 05/02/04
    !!mdsDacControl(FALSE)

  endif
  -- get the name of the current support
  !attaName = !support.rest.attaRef.name
  handle ANY
    -- No atta to delete
    -- Unset the oldSupport member variable
    !this.oldSupport = object MDSINTERFACESUPPORT()

    -- Unset the support member variable
    !this.support = object MDSINTERFACESUPPORT()

    -- Clear passed form Gadgets
    call !!mdsInterfaceHangerClearGadgets(!this)

    -- If dimensions are displayed the clear them from the display
    !!mdsClearDim()

    -- Hide Form
    !this.hide()

    -- Reset MdsFHanger
    !!mdsInterfaceHanger.manifActions()
    handle ANY
    endhandle

    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  -- Reset model representation if required
  call !!kActionCommands(!this.repre)

  if (!this.support.atta.empty().not())then
    !attaBran = !this.support.atta[1].owner
    do !i indices !this.support.atta
      !!ce = !this.support.atta[!i]
      handle ANY
        skip
      endhandle
      !ceAtta = !!ce
      !ceAttaName = !ceAtta.name

      !deleteList = ARRAY()
      !deleteList = !!mdsgethanglist(!ceAtta)
      if(!ceAttaName.eq(!attaName)) then
        --Delete atta only if has the same name as the restr prefix
        -- This is done to avoid deletion of welded elbow lug & trunnion which are not
        -- a part of this support
        !deleteList.append(!ceAtta)
      endif

      if (!this.support.preliminaryStore.set()) then
        !deleteList.deleteFrom (!deleteList.findFirst (!this.support.datum), 1)

        !attaName = '/' & !this.name.val
        !attaRef = !attaName.dbref()
        handle ANY
        elsehandle NONE
          !!ce = !attaRef
          delete atta
        endhandle

        !actions = !this.support.preliminaryStore
        -- Loop through ACTIONS
        do !idxAction indices !actions
          !!mdsDacControl(true)
          $!actions[$!idxAction]
          handle any
            skip
          endhandle
        enddo
      endif

      -- delete hanger and connected elements
      !!mdsdeletelist(!deleteList)
      -- delete original fitting if currently the hanger is not connected to it.
      do !!hangerNo indices !support.rest.hangers
        -- $!atta$n/FITT
        $!attaName/FITT/H$!hangerNo
        handle NONE
          delete fitt
        elsehandle ANY
        endhandle
      enddo
    enddo
    !!ce = !attaBran
  endif
  !!mdsDacControl(TRUE)
  -- delete the temporary rest if any
  $!attaName$n/REST/TEMP
  handle ANY
    -- no Temporary temp
  elsehandle NONE
    delete rest
  endhandle

  -- check if atta still exists
  !attaName = '/' & !this.name.val
  !attaRef = !attaName.dbref()
  handle ANY
  elsehandle NONE
    !!ce = !attaRef
    if (!this.support.preliminaryStore.set().not()) then
      delete atta
    endif
  endhandle

  -- Unset the oldSupport member variable
  !this.oldSupport = object MDSINTERFACESUPPORT()

  -- Unset the support member variable
  !this.support = object MDSINTERFACESUPPORT()

  -- Clear passed form Gadgets
  call !!mdsInterfaceHangerClearGadgets(!this)

  -- If dimensions are displayed the clear them from the display
  !!mdsClearDim()

  -- Hide Form
  !this.hide()

  -- Reset MdsFHanger
  !!mdsInterfaceHanger.manifActions()
  handle ANY
  endhandle

  !!kRestoreUnits(!currentUnits)

endmethod
-----------------------------------------------------------------------------------

-- Define Function
define method .reconnect(!dummyresize is BOOLEAN)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Initialise variables
  !support     = !this.support
  !datum       = !this.support.datum
  --------------------------------------------------------------------------------
  !attaName = !datum.name
  !oRest = !support.rest
  -- Empty the beam ref array.
  -- This will force the application to prompt the user to identify new beams
  -- Save the current beamArray
  !beamRefArray = !oRest.beamRefArray

  --REFACTOR we used to unset the beamrefarray here and allow common update to go through until it picked up the fact that
  --no beam had been passed. it would then try and reselect the steelwork during verification. this was bad because we were never really
  --sure that the correct elements had been picked. we now will use the standard selection routines that we use when creating
  --a hanger to select the new steelwork, pass these to the modify rest function and these will create the new hangers as required - start.
  --use the mdsselectype1 function to select the new steelwork. we need to pass in false because we don't want to select the tube again
  !selectionArray = !!mdsSelectType1(FALSE)
  --ignore the first array element because it is the unset tube reference
  !newBeamSelection = !selectionArray.from(2)
  --check that the dbref is set otherwise warn and return from this method
  if !newBeamSelection[1].unset() then
    !!alert.error('The current selection is invalid. cannot continue.')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !oRest.beamRefArray = !newBeamSelection
  --REFACTOR we used to unset the beamrefarray here and allow common update to go through until it picked up the fact that
  --no beam had been passed. it would then try and reselect the steelwork during verification. this was bad because we were never really
  --sure that the correct elements had been picked. we now will use the standard selection routines that we use when creating
  --a hanger to select the new steelwork, pass these to the modify rest function and these will create the new hangers as required - end.

  -- Saves VSPR sprefs that may have changed using the .modifySpringType method
  -- of the !!mdsModFH form
  -- to be restored after reconnection
  var !springs collect all vspr for $!oRest.ref
  -- !evalIndex is a special variable incremented automatically by PML
  !oEvalSpref = object BLOCK('!springs[!evalIndex].dbref().spref')
  !oEvalLsRod = object BLOCK('!springs[!evalIndex].dbref().lsrod')
  -- Process the block command on every spring element of the !springs array
  !sprefs = !springs.evaluate(!oEvalSpref)
  !lsRods = !springs.evaluate(!oEvalLsRod)
  !oRest.modify(!this, !!mdsInterfaceHanger)

  -- restores VSPR sprefs
  !oRest = !this.support.rest
  var !newSprings collect all vspr for $!oRest.ref
  !oEvalSpref = object BLOCK('!newSprings[!evalIndex].dbref().spref')
  -- Process the block command on every spring element of the !springs array
  !newSprefs = !newSprings.evaluate(!oEvalSpref)
  -- compare the sprefs of the new and old springs.
  -- If a spring's spref have changed, it means that the user
  -- used the .changeSpringType method of the !!mdsModFH form
  -- so we will restore it.
  do !i indices !newSprefs
    !newSpre = !newSprefs[!i]
    !oldSpre = !sprefs[!i]
    !oldLsrod = !lsRods[!i]
    if(!newSpre eq !oldSpre) then
    else
      -- Spring has been changed
      -- Restores VSPR sprefs that may have changed using the .modifySpringType method
      -- goto rest
      !!ce = !newSprings[!i].dbref().owner.owner
      !hangers = mem
      !numOfHangs = !hangers.size()
      -- get order of hanger
      !order = order of owner of $!newSprings[$!i]
      if(!numOfHangs gt 1) then
        -- spring may be in the second or third hangers
        !order = !order - 1
      endif
      -- restore the old spref
      !!ce = !newSprings[!i].dbref()
      !!ce.spref = !oldSpre
      if(!oldLsrod.set())then
        !!ce.lsrod = !oldLsrod
      endif
      -- Initializes the modification form
      !!mdsIModFh(!this,!!mdsModFH, TRUE)

      -- adjust the hanger rods to the new spring size
      !!mdsModFH.modifySpringType(!order, FALSE)
      !!mdsModFH.cancel()
    endif
  enddo

  !this.setRestObject()

  --reset the mdsVendorHangerType1.steelMem member using the new selections
  !!mdsVendorHangerType1.steelMem = !oRest.beamRefArray

  -- Add marker text markers
  !!mdsAidText(!this)

  !!ce = !datum
  -- Activate/Deactivate gadgets
  !this.datum.active = FALSE
  !this.setGadgets()

endmethod

define method .restoreHanger(!showConfirm is BOOLEAN, !hideForm is BOOLEAN)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !usrSuppName = !this.support.rest.attaRef.name

  -- Test Decision
  if(!showConfirm) then
    if (!!alert.confirm(|Ok to cancel Support "$!usrSuppName". This will reset the support prior to modifying?|) eq 'NO')then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Saves the current support object before the restore state function overrides the support object with the oldSupport object
  !tempSupport = !this.support
  !!mdsRestorehangerstate(!this)

  -- Does datum exist yet
  if (!this.support.datum.unset()) then
    !!alert.message('Unable to restore hanger as no atta have been created')
    !!kRestoreUnits(!currentUnits)
    return
  elseif (!this.support.rest.ref.unset()) then
    !!alert.message('Unable to restore hanger. Reference to Original restraint is unset')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !support = !this.support
  !datum = !support.datum
  !attaName = !datum.name
  !unusedHang = !datum.cref
  handle ANY
    !!alert.message('Unable to restore hanger as there is no hanger connected to the atta')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  !here = !!ce
  -- Put back the original tail position
  $!attaName/H1
  handle NONE
    tpos $!this.support.tposition
    handle ANY
    endhandle
  elsehandle ANY
  endhandle

  -- Put back atta if it has been moved by slope
  $!attaName
  handle NONE
    thro ph of cref
  elsehandle ANY
  endhandle

  !!ce = !here
  !support.rest.reconnected = FALSE
  if(!tempSupport.rest.ref eq !support.rest.ref) then
    -- There is no temporary restr
    -- do nothing
    -- Reactivate cancel button on modify form
    if (!!mdsModifySupp.cancel.active.not())then
      !!mdsModifySupp.cancel.active = TRUE
    endif

    !!ce = !datum
    handle ANY
    endhandle

    if(!hideForm) then
      -- Hide the dimensions
      !!mdsClearDim()
      -- Hide forms
      if(!!mdsModFH.shown()) then
        !!mdsModFH.cancel()
      endif
      -- Unsetting the oldSupport member variable
      !this.oldSupport = object MDSINTERFACESUPPORT()

      -- Unsetting the support member variable
      !this.support = object MDSINTERFACESUPPORT()

      !this.hide()
    else
      if(undefined(!oOrigRest))then
        -- skipped to /EXIT label
        !oOrigRest = !support.rest
      endif
      -- update the rest object to be for the original rest
      !support = !this.setRestObject()

      !this.support = !support
      !this.support.rest.ref = !oOrigRest.ref
    endif

    -- If the support is a hanger then reset any values that may have changed and then clear the saved values
    !!ce = !attaName.dbref()
    !!mdsSuppData.resetValues()
    same

    !!kRestoreUnits(!currentUnits)
    return
  else
    -- There is a temporary rest
    -- we need to delete its fittings
    do !hangerNo indices !tempSupport.rest.hangers
      !oTempHang = !tempSupport.rest.hangers[!hangerNo]
      !oFitt = !oTempHang.fitt
      if(!oFitt.set()) then
        if(!oFitt.ref.set() and (not !oFitt.ref.badref()))then
          if(!oFitt.ref.type.eq('FITT')) then
            -- check if this fitting is not used by the original rest
            !flag = !support.rest.hangers[!hangerNo].fitt.set() and  !oFitt.ref.set() and (!support.rest.hangers[!hangerNo].fitt.ref neq !oFitt.ref)
            handle ANY
              skip
            endhandle
            if(!flag) then
              -- original rest is pointing to another fitting
              -- we can delete the temporary rest's fitting
              !!ce = !oFitt.ref
              !fittName = !!ce.name
              delete fitt
            endif
          endif
        endif
      endif
    enddo
    -- we need to delete the curr modified rest
    !oTempRest = !tempSupport.rest
    !!ce = !oTempRest.ref
    delete restr
    -- delete the temporary rest
    $!attaName$n/REST/TEMP
    handle ANY
      -- no Temporary temp
    elsehandle NONE
      delete rest
    endhandle

    !oOrigRest = !support.rest
    !!ce = !oOrigRest.ref
    handle ANY
      !!alert.message('Unable to restore hanger. Reference to Original restraint is unset. Original Rest name is $!attaName/BACKUP ')
      !!kRestoreUnits(!currentUnits)
      return
    elsehandle NONE
      ren all $!attaName/BACKUP $!attaName
      name $!attaName$n/REST
    endhandle

    if(!oOrigRest.set() and !oOrigRest.new.set() and !oOrigRest.new and !hideForm) then
      -- newly created rest
      -- delete it
      !this.cancelHanger(FALSE)
    else
      if(!this.graphicalDim)then
        -- update the dimensions to the restored position
        !!mdsSetDim(!this)
        !!mdsSetDim(!this)
      endif
    endif
    -- Add the restr to the drawing list
    add ce
  endif

  -- Reactivate cancel button on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.cancel.active = TRUE
  endif

  !!ce = !datum
  handle ANY
  endhandle

  if(!hideForm) then
    -- Hide the dimensions
    !!mdsClearDim()
    -- Hide forms
    if(!!mdsModFH.shown()) then
      !!mdsModFH.cancel()
    endif
    -- Unsetting the oldSupport member variable
    !this.oldSupport = object MDSINTERFACESUPPORT()

    -- Unsetting the support member variable
    !this.support = object MDSINTERFACESUPPORT()

    !this.hide()
  else
    if(undefined(!oOrigRest))then
      -- skipped to /EXIT label
      !oOrigRest = !support.rest
    endif
    -- update the rest object to be for the original rest
    !support = !this.setRestObject()

    !this.support = !support
    !this.support.rest.ref = !oOrigRest.ref
  endif

  -- If the support is a hanger then reset any values that may have changed and then clear the saved values
  !!ce = !attaName.dbref()
  !!mdsSuppData.resetValues()
  same

  !!kRestoreUnits(!currentUnits)

endmethod

define method .accept(!callingForm is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Initialise variables
  !support = !this.support

  -- Check that creation is complete
  if (not defined(!support.atta[1]))then
    !!alert.message('Support has to exist before creation can be ended')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- !attaRef = !support.rest.attaRef
  -- we take the name of the atta from the rest
  -- because there might be a difference between the connected atta
  -- (which can have a different name (e.g. welded elbow lug or trunnion)
  -- and the atta associated with this support which have the same name.
  !attaName = !support.rest.ref.name.before('/REST')
  !fittName = !attaName + '/FITT'


  --><wd>16jul2009 - DFN P-21516 (SI-12441)
  -- Store the P10 direction WRt /* of the CONSTANT Spring after clicking the !!mdsHangerType1.ok button before entering Witch Hanger
  if (!!mdsHangIf.eq('CPL')) then
    !existCE = !!ce
    -- This CONSTANT SPRING will always be the FIRST in DB list order in the RESTRAINT
    !!ce = !this.constantNameOne.dbref()
    handle (2,822)
      -- (2,822)   Cannot set current element to an unset reference
    elsehandle NONE
      !this.constantDirectionOne = !!ce.pdir[10].wrt(/* )
    endhandle
    -- This CONSTANT SPRING will always be the SECOND in DB list order in the RESTRAINT
    !!ce = !this.constantNameTwo.dbref()
    handle (2,822)
      -- (2,822)   Cannot set current element to an unset reference
    elsehandle NONE
      !this.constantDirectionTwo = !!ce.pdir[10].wrt(/* )
    endhandle
    !!ce = !existCE
  endif
  --<<wd>16jul2009 - DFN P-21516 (SI-12441)

  -- Update the object structure of the support.rest object
  !support = !this.setRestObject()

  -- Retrieve the old fitting from the saved original support
  !oldSupport = !this.oldSupport
  !oOldRest = !oldSupport.rest
  !oldHangers = !oOldRest.hangers
  !support = !this.support
  !oRest = !support.rest
  !hangers = !oRest.hangers
  !!mdsDacControl(TRUE)

  -- Check to see if we need to delete old fittings by comparing the old references to the new ones
  do !hangerNo indices !oldHangers
    !oOldHang = !oldHangers[!hangerNo]
    if(!oOldHang.fitt.set()) then
      !oOldFitt = !oOldHang.fitt
      if(!oOldFitt.ref.set() and (not !oOldFitt.ref.badref()) and !oOldFitt.ref.type.eq('FITT'))then
        !!ce = !oOldFitt.ref
        !sameFitting = TRUE
        !sameFitting = (!!ce eq !hangers[!hangerNo].fitt.ref)
        handle ANY
          -- Current rest does not have hanger no. $!hangerNo
          !sameFitting = FALSE
        endhandle
        if(not !sameFitting) then
          !!mdsDacControl(TRUE)
          delete fitt
          !!mdsDacControl(FALSE)
        endif
      else
        -- handle next hanger fitting
        skip
      endif
    endif
  enddo

  -- Retrieve the existing new fitting from the current support
  !support = !this.support

  !oRest = !support.rest
  !hangers = !oRest.hangers
  do !hangerNo indices !hangers
    !oHang = !hangers[!hangerNo]
    !fittName = !attaName + '/FITT/H$!hangerNo'
    if(!oHang.fitt.set()) then
      !oFitt = !oHang.fitt
      if(!oFitt.ref.set() and (not !oFitt.ref.badref())  and !oFitt.ref.type.eq('FITT'))then
        !!ce = !oFitt.ref
        handle ANY
          !!alert.error('No current fitting reference')
        elsehandle NONE
          if(!oFitt.name.neq(!fittName)) then
            -- rename the new fitting
            !!ce = !oFitt.ref
            !!ce.name = !fittName
            handle ANY
              -- Name already exist
              -- unnamed the existing one
              $!fittName
              unname
              !!ce = !oFitt.ref
              !!ce.name = !fittName
            endhandle
          endif
        endhandle
      endif
    endif
  enddo
  -- delete all temporarily created fittings
  do !hangerNo to 3
    do !i
      !firstBreak = FALSE
      !secondBreak = FALSE
      $!attaName$n/FITT/H$!hangerNo$n/$!i/FIRST
      handle ANY
        !firstBreak = TRUE
      elsehandle NONE
        delete fitt
      endhandle
      $!attaName$n/FITT/H$!hangerNo$n/$!i
      handle ANY
        !secondBreak = TRUE
      elsehandle NONE
        delete fitt
      endhandle
      if(!firstBreak and !secondBreak) then
        break
      endif
    enddo
  enddo

  -- delete the temporary rest
  $!attaName$n/REST/TEMP
  handle ANY
    -- no Temporary temp
  elsehandle NONE
    delete rest
  endhandle

  !datum = !attaName.dbref()

  $!attaName/REST/BACKUP
  handle ANY
    -- Hanger type was not changed
  elsehandle NONE
    -- Hanger type has changed
    delete restr mem
    copy att of $!attaName/REST
    do !i
      include hang 1 of $!attaName/REST
      handle ANY
        break
      endhandle
    enddo
    $!attaName/REST
    delete restr
    $!attaName/REST/BACKUP
    name $!attaName/REST
  endhandle

  if (!callingForm eq !!mdsInterfaceHanger) then
    -- Currently no check is made
    -- Reset the references to the tube and the beam/s
    !callingForm.tubeRef = object DBREF()
    !callingForm.beamRef = object ARRAY()
  endif

  !alias = !this.support.rest.styp

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
  !temp = !this.support
  !!mdsVendorHangerType1.support = !this.support
  call !!mdsInterfaceHangerClearGadgets(!this)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    handle (2,752)
    endhandle
    !!mdsModifySupp.cancel.active = TRUE
  endif
  -- Unsetting the oldSupport member variable
  !this.oldSupport = object MDSINTERFACESUPPORT()
  !!ce = !support.datum
  -- Unsetting the support member variable
  !this.support = object MDSINTERFACESUPPORT()

  --Reset the support object for the interface
  !this.support = !temp

  -- Hide the dimensions
  !!mdsClearDim()
  -- Hide Form
  !this.hide()
  if(!!mdsModFH.shown()) then
    !!mdsModFH.cancel()
  endif
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

  -- Call the interface form for non fixed
  if (!!mdsHangerType1.dist.active eq TRUE) then
    $!attaName
    !!mdsVendorHangerType1.jointrotate = FALSE
    !!mdsVendorHangerType1.init()
  elseif (!!mdsHangerType1.dist.active eq FALSE) then
    $!attaName
    !!mdsVendorHangerType1.jointrotate = TRUE
    !!mdsVendorHangerType1.init()
  endif

  !!mdsresetpins(1,10)

endmethod

-- Set background colour of icons to white
!!mdsSetIconBack(!!mdsHangerType1,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsHangerType1,TRUE)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsHangerType1.select)
