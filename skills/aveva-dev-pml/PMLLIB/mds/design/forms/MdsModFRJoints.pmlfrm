-- Description:
-- Form Definition for Single Joints Type FR01,FR02 ....
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsModFRJoints

-- Define Form
setup form  !!MdsModFRJoints at xr0 yr0


  !!MdsModFRJoints.formtitle    = |Modify Connection|
  !!MdsModFRJoints.icontitle    = |ModJoint|
  !!MdsModFRJoints.Callback     = ||
  !!MdsModFRJoints.formrevision = | $Revision: 1.1.19.1 $ |
  !!MdsModFRJoints.initcall = |!this.init()|

    path down
  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1
    option .bangle 'Beta Angle ' at xmin.tag ymax call '!this.setbeta(!this.bangle.selection())' width 4
    !a[1] = '0'
    !a[2] = '90'
    !this.bangle.dtext = !a

    -- button .ok 'OK' ok
    button .cancel 'Dismiss'   cancel


   member .form is form
   member .joint is dbref


  -- end of form definition
  exit
  -----------------------------------------------------------------------------
  define method .init()

    !this.name.val = !this.form.name.val
    if !this.name.val.match('/').neq(1) then
      !this.name.val = '/' & !this.name.val
    endif
    if !this.form.eq(!!mdsfr07) then
      !this.joint = fitt1 of $!<this.Name.val>-H1
      handle ANY
         !!Alert.error('Fitting does not exist')
        return
      endhandle
    else
    !this.joint = fitt1 of $!<this.Name.val>-V1
      handle ANY
         !!Alert.error('Fitting does not exist')
        return
      endhandle
    endif
    !angle = !this.joint.bang
    !this.bangle.select('dtext',!angle.string())

  endmethod
  -----------------------------------------------------------------------------

  define method .setbeta(!angle is STRING)

      !this.joint.bangle = !angle.real()
      !plate = !this.joint.cref
      !!ce = !plate
      handle ANY
        return
      elsehandle NONE
        same
      endhandle
      $(
      if !!Mdscheckfitting(!this.joint,!plate).not() then
        !!alert.Warning('Warning Section Brackets are Not Within the Plate')
      endif
      $)

  endmethod
  ------------------------------------------------------------------------------
