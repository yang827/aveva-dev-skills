-- Description:
-- Form Definition for Single Joints Type FR01,FR02 ....
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsModFRMJoints

-- Define Form
setup form  !!MdsModFRMJoints at xr0 yr0


  !!MdsModFRMJoints.formtitle    = |Modify Connection|
  !!MdsModFRMJoints.icontitle    = |ModJoint|
  !!MdsModFRMJoints.Callback     = ||
  !!MdsModFRMJoints.formrevision = | $Revision: 1.1.19.1 $ |
  !!MdsModFRMJoints.initcall = |!this.init()|

    path down
  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1
    frame .frame1 'Top Joint' at xmin .tag width 27 line 1
       option .bangle1 'Beta Angle ' at xmin+4 ymax call '!this.setbeta(!this.bangle1.selection(),!this.joint1 )' width 4
       !a[1] = '0'
       !a[2] = '90'
       !this.bangle1.dtext = !a
    exit

    frame .frame2 'Bottom Joint' at xmin .tag width 27 line 1
       option .bangle2 'Beta Angle ' at xmin+4 ymax call '!this.setbeta(!this.bangle2.selection(),!this.joint2 )' width 4
       !this.bangle2.dtext = !a
    exit
    -- button .ok 'OK' ok
    button .cancel 'Dismiss'   cancel


   member .form is form
   member .joint1 is dbref
   member .joint2 is dbref


  -- end of form definition
  exit
  -----------------------------------------------------------------------------
  define method .init()

    !this.name.val = !this.form.name.val
    if !this.name.val.match('/').neq(1) then
      !this.name.val = '/' & !this.name.val
    endif
    !this.joint1 = fitt1 of $!<this.Name.val>-V1
    handle ANY
        !!Alert.error('Fitting does not exist')
        return
    endhandle
    !this.joint2 = fitt2 of $!<this.Name.val>-V1
    handle ANY
        !!Alert.error('Fitting does not exist')
        return
    endhandle

    !angle1 = !this.joint1.bang
    !this.bangle1.select('dtext',!angle1.string())
    !angle2 = !this.joint2.bang
    !this.bangle2.select('dtext',!angle2.string())

  endmethod
  -----------------------------------------------------------------------------

  define method .setbeta(!angle is STRING,!joint is dbref)

      !joint.bangle = !angle.real()
      !plate = !joint.cref
      !!ce = !plate
      handle ANY
        return
      elsehandle NONE
        same
      endhandle
      $(
      if !!Mdscheckfitting(!joint,!plate).not() then
        !!alert.Warning('Warning Section Brackets are Not Within the Plate')
      endif
     $)
  endmethod
  ------------------------------------------------------------------------------
