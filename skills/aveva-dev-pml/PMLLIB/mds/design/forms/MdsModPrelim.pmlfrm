--
-- File:  MdsModPrelim.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--
-- Author:  Neale Morris
-- Created:  Wed 10 March 2004
--
--
-- Description:
-- Form Definition for modifying Prelim Supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  reset()                          -
--

-- Kill existing form definition

kill !!mdsModPrelim

-- Define Form

setup form !!mdsModPrelim

  !!mdsModPrelim.formtitle    = |MDS Modify Preliminary Support Type|
  !!mdsModPrelim.icontitle    = ||
  !!mdsModPrelim.callback     = |!this.init()|
  !!mdsModPrelim.formrevision = ||

  -- Body of Form

  para .name width 60 lines 1

  path down
  vdist 0.1
  list .standard |Preliminary support type:| at x0 Ymax+0.5 call |call !!kActionCommands(!!mdsModPrelim.listActions)| width 62 length 8

  -- Bottom Line
  button .ok     |   OK   | at xmin           ymax call |!this.reset()|
  path right
  button .view   | View...| at xmax+1         ymin Call |call !!mdsAddPlot(!!mdsModPrelim.standard, 'show',!!mdsModPrelim)|

  button .cancel | Cancel | at xmax form-size ymin cancel

  -- Form Members
  -- Form Name of Support
  member .suppFunction is STRING

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Actions on list button
  member .listActions  is ARRAY

  member .error is BOOLEAN
  member .emess is STRING

  -- End form definition
exit

-- Set the DEFAULT settings for the form Members
!this.error = FALSE
!this.emess = ''

-- Set icons

!!mdsSetIconBack(!!mdsModPrelim,'white')

------------------------------------
define method .init()
  ------------------------------------

  -- Find out which form has loaded this FORM
  -- to set para gadget

  !this.name.val = 'Name: ' + !!mdsPr01.name.val

  -- Read defaults file to load selections
  -- If not already loaded

  if !!mdsModPrelim.standard.dtext.size().eq(0) then
    !!mdsPopulate(!!mdsModPrelim,'PRELIMSUPP')
  endif

  -- Store Current Support Form name and required function in Main form for use later

  !!mdsSetSupp(!!mdsModPrelim)

  -- Get current support type and set the form list

  !styp = !!mdsPr01.support.datum.styp
  !this.standard.select('RTEXT',!styp)
  --handle ANY
  --endhandle

  -- Reset the DAC global variable in case it has been left set to true

  !!mdsDacControl(FALSE)

endmethod

define method .reset()

  -- Access preliminary support atta

  !!ce = !!mdsPr01.support.datum

  -- Set the DAC Control

  !!mdsDacControl(TRUE)

  -- Reselect the type

  !styp = !!mdsModPrelim.standard.selection()

  var !findElements collect all DTSE with DESC eq '$!styp' for /MDS/PRELIMINARY/DEFAULTS
  var !supfElements collect all DATA with DKEY eq 'SUPF' for $!findElements[1]

  !choice = SELECT SPEC /MDP WITH STYP '$!styp'
  handle ANY
    delete atta
    !unusedProjStandard = !!mdsPr01.support.replace
    !!alert.error('Unable to select modify ancillary at this bore')
    !!mdsDacControl(FALSE)
    return
  elsehandle NONE
  endhandle

  spref $!choice[1]

  if (not !supfElements.empty()) then
    !suppFunc = !supfElements[1].dbref().pprop.after(|'|).before(|'|)
    handle any
    endhandle
  else
    !suppFunc = !!ce.catref.owner.:MDSSuppFunc
    handle any
    endhandle
  endif

  -- Reset the support type in the object

  !!mdsPr01.support.type = !styp

  -- Reset support function by calling transport function

  !namn = !!ce.namn
  call !!mdsTransport(!!ce,!namn)

  -- Redefine standard support name on form title

  !index = !!mdsModPrelim.standard.val
  !text  = !!mdsModPrelim.standard.dtext[!index]

  !title = 'PRELIMSUPP'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsPr01.support.replace = !formName

  call !!mdsSetFormName(!!mdsPr01, '$!title', '$!formName')

  -- Reset the DAC global variable in case it has been left set to true

  !!mdsDacControl(FALSE)

  if (defined(!suppFunc)) then
    !!ce.:mdssuppfunc = !suppFunc
  endif

  hide !!mdsModPrelim

endmethod
