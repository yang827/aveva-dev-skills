-- Define Form
setup Form !!MDSModifyDESWeld

  title 'Weld Items'

  init '!this.init()'

  Path down

  frame .welds 'Create/Modify Weld Items'

    path down

    list .ppointlist |Weld PPoints|  multiple width 28 height 5
    text .tag  'Tag Text:' width 20 is STRING

  exit

  button .apply ' Apply '    call '!this.writedata()' ok
  button .dismiss ' Dismiss ' at xmax form -size ymin cancel

  member .modify is BOOLEAN
  member .source is dbref
  member .destination is dbref
  member .existingstds is ARRAY
  member .cstds is ARRAY
  member .currentstd is mdsweld
  member .edit is MDSWELD
  member .allweldlist is mdsweldlist
  member .context is STRING
  member .form is form

  !this.context = 'std'
  !this.modify = FALSE

exit
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .init()

 !this.edit = !!mdsancilwelds.currentstd
 !this.fillform()

endmethod
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .resetlist()

  var !std coll all ddse for $!this.arealist
  var !names eval name for all from !std
  !this.weldlist.dtext = !names
  !this.weldlist.rtext = !std
  !this.fillform()

endmethod
-----------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .fillform()

    !this.ppointlist.dtext = !this.edit.ppoints
    !this.ppointlist.val = !!mdsancilwelds.ppointlist.val

endmethod

--------------------------------------------------------------------------------
define method .ok()

endmethod
--------------------------------------------------------------------------------

