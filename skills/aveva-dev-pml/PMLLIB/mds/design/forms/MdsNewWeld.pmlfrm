--
--   File:      MdsNewWeld.pmlfrm
--   Type:      Form Definition
--   Group:     Multi Discipline Supports Application
--   Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:  T.martin
-- Created: 17/05/04
--
--
-- Description:
-- Multi Discipline support Form
-- Purpose to build a weld for a single element or a list of elements
-- it starts up by getting a list of available welds and displaying them
-- the user then selects the items he wants to modify
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fillform()                       -
--  init()                           -
--  ok()                             -
--  resetlist()                      -
--  selectarea()                     -
--  selectweld()                     -
--

-- Define Form
setup form !!mdsNewWeld
  title ' Select Standard Weld '
  init '!this.init()'
  path down
  frame .stds 'Weld Standard Categories'

    option   .arealist 'Existing Areas '  call '!this.resetlist()'  width 35

  exit

  frame .welds 'Weld Items'

    --  button .modify  'Modify Weld ' call |!this.modweld('modify')|
    list   .weldlist  'Existing Welds'  call '!this.selectweld()' width 49 height 6
    path down

    para .pdtsen at xmin ymax text  '       Name: '
    para .dtsen at xmax ymin width 40 lines 1
    para .psymbol at xmin.pdtsen ymax text  'Symbol Name: '
    para .symbol at xmax ymin width 40   lines 1
    para .pdesc  at xmin.pdtsen ymax  text  'Description: '
    para .desc at xmax ymin width 40  lines 1

  exit

  button .apply ' Apply '  call |!this.ok()| ok
  button .dismiss ' Dismiss ' at xmax form -size ymin cancel

  member .source is DBREF
  member .destination is DBREF
  member .existingstds is ARRAY
  member .cstds is ARRAY
  member .currentstd is MDSWELD
  member .edit is MDSWELD
  member .allweldlist is MDSWELDLIST
  member .form is FORM
  member .context is STRING
  !this.context = 'std'
exit
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .init()

  !this.source = /MDS/STD/WELDS
  -- load the standard welds
  var !std coll all ddar for $!this.source
  var !names eval name for all from !std
  !this.arealist.dtext = !names
  !this.arealist.rtext = !std

  -- load the default welds and the existing standards

  !this.destination = /MDS/DES/WELDS
  -- first load the standard welds available

  !this.resetlist()

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .resetlist()

  var !std coll all ddse for $!this.arealist
  var !names eval name for all from !std
  !this.weldlist.dtext = !names
  !this.weldlist.rtext = !std
  !this.selectarea()

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .selectarea()

  !current = !this.weldlist.selection().dbref()
  if !current.unset() then
    return
    !this.currentstd = object MDSWELD()
    !this.fillform()
  endif
  !this.currentstd = object MDSWELD(!current)
  !this.fillform()

endmethod
--------------------------------------------------------------------------

--------------------------------------------------------------------------
define method .selectweld()

  !current = !this.weldlist.selection().dbref()
  !this.currentstd = object MDSWELD(!current)
  !this.fillform()

endmethod
---------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .fillform()

  !this.dtsen.val = !this.currentstd.dtse.name
  handle ANY
    !this.dtsen.val = 'unset'
  endhandle

  !this.symbol.val = !this.currentstd.symboldata.ddprop.replace(|(|,||).replace(|)|,||).replace(|'|,||).trim()
  handle ANY
    !this.symbol.val = 'unset'
  endhandle
  !this.desc.val   = !this.currentstd.dtse.description
  handle ANY
    !this.desc.val = 'unset'
  endhandle

endmethod

--------------------------------------------------------------------------------
define method .ok()

  if !this.context eq 'NEW' then

    !this.form.currentstd = !this.currentstd
    !this.form.currentstd.designitem = !this.form.memberlist.selection().dbref()
    handle (2,759) $* the host form does not have a memberlist so it must be a cata ancil
      !catename = '/ATTA-' & !!mdsancilwelds.standard.selection()
      !category = !catename.dbref()
      handle (2,109)
        !!alert.error('Cannot Find Category $!catename')
        return
      endhandle
      !this.form.currentstd.designitem = !category
      !this.form.currentstd.name = !this.form.currentstd.getweldname(!this.form.standard.selection(),'STD','NEW')[1]
    elsehandle NONE
      -- !type 'GENERIC' returns a weld based on the catref 'STD' returns a name based on the template
      -- !gtype is 'AREA' or 'STD' if its an area it returns a DDAR name to hold the DDSE
      -- !mode is 'OLD' or 'NEW' and defines if a new or existing name is returned
      !this.form.currentstd.name = !this.form.currentstd.getweldname(!this.form.joints.selection(),'STD','NEW')[1]
    endhandle

    --if this.form is MDSFRAMEWELDS deactivate the save button if there is no weld data to save otherwise activate it
    if !this.form.name().upcase().eq('MDSFRAMEWELDS') then
      if !this.form.currentstd.designitem.unset() then
        --deactivate the save button since we will not be able to save any data
        !this.form.save.active = FALSE
      else
        !this.form.save.active = TRUE
      endif
    endif
  else

    !this.form.currentstd.symbol = !this.currentstd.symbol
    !this.form.currentstd.description = !this.currentstd.description
    !this.context = 'NEW'

  endif

  if !this.form.currentstd.designitem.type inset('CATE','SJOI','PJOI','FITT') then
    --if !this.form.memberlist.selection().dbref().type inset('SJOI','PJOI','FITT') then
    -- get the ppoints
    !this.form.currentstd.setppointstring(!this.form.ppointlist.selection())
    !this.form.currentstd.function = !this.form.joints.selection()
    handle any
    endhandle
  endif

  !this.form.currentstd.fillform(!this.form)

endmethod
