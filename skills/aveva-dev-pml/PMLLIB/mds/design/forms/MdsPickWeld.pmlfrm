--
--
-- Description:
-- Multi Discipline support Form
-- Purpose to pick the start or end point of a section weld
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getplineend(ARRAY)               -
--  idaltsctn()                      -
--  idpline(STRING)                  -
--  init()                           -
--  setcurrent()                     -
--  setplines()                      -
--  setrgroup(STRING)                -
--  writedata()                      -
--

-- Define Form
setup form !!mdspickWeld

  title ' Set Weld Position'
  init '!this.init()'

  para .set text 'Set Weld '
  para .type width 5 lines 1
  rgroup .enddef ' Weld Position ' at xmin .set + 0.5 ymax+ 0.4 call '!this.setrgroup(!this.enddef.selection())' horizontal
    add tag    ' Single Pline '        select 'LOC'
    add tag    ' Pline Intersections ' Select 'SEND'
  exit

  option .plinelist ' Plines ' at xmin.set ymax+0.5 call '!this.setrgroup(!this.enddef.selection())' width 12
  button .idpline   ' Identify Pline' at xmax+2  ymin call |!this.idpline('host')|
  -- text   .weldstring 'Weld Definition ' at xmin .set ymax width 20 is STRING

  frame .inter 'Intersecting Section' at xmin.set ymax

    option .intersection  at xmin.set+1 ymax  call |!this.setplines()| width 20
    button .idsctn ' Identify SCTN ' at xmax+2  ymin call |!this.idaltsctn()|
    option .altplinelist ' Plines ' at xmin.set+1 ymax+1 call '!this.setrgroup(!this.enddef.selection())' width 12
    button .altIdpline ' Identify Pline' at xmax+2  ymin call |!this.idpline('inter')|

  exit

  text   .weldstring 'Weld Definition ' at xmin.set ymax+1 width 20 is STRING


  button .oK ' OK ' at xmin.set ymax+0.5 call '!this.writedata()'
  button .cancel ' Cancel ' at xmax form - size ymin   cancel
  member .hostsctn is DBREF
  member .endtext is STRING
  member .form is FORM
  !this.endtext = 'START'

exit

--------------------------------------------------------------------------------------------
-- init method to set up the plines etc
define method .init()

  -- set the plinelist of the host section
  !this.plinelist.dtext = !this.form.memberlist.selection().dbref().plna
  -- set the section list dtext and rtext
  !sctnrefs = !this.form.memberlist.rtext
  !names  = !this.form.memberlist.dtext
  -- get rid of the host section from the list of
  !remove = !sctnrefs.findfirst(!this.form.memberlist.selection())
  !sctnrefs.removefrom(!remove,1)
  !names.removefrom(!remove,1)
  -- set up the list of alternate sections
  !this.intersection.dtext = !names
  !this.intersection.rtext = !sctnrefs
  -- set the alternate pline list
  !this.setplines()

  !this.setrgroup(!this.enddef.selection())
  -- set the host section
  !this.hostsctn = !this.form.memberlist.selection().dbref()

  if !this.type.val.upcase().eq( 'START' )then
    !this.weldstring.val = !this.form.start.val
  else
    !this.weldstring.val = !this.form.end.val
  endif
  -- now go and set the gadgets to the current selection data
  !this.setcurrent()

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .setcurrent()

  !unusedweldsplit = !this.weldstring.val.split(',').size()
  handle ANY
    !this.setrgroup('LOC')
    return
  endhandle

  if !this.weldstring.val.split(',').size().eq(2) then $* its an end Not intersection
    !this.plinelist.select('Dtext',!this.weldstring.val.split(',')[1])
    handle ANY
    endhandle
    !this.setrgroup('LOC')
  elseif   !this.weldstring.val.split(',').size().eq(3)  then $* its an intersection

    !this.plinelist.select('Dtext',!this.weldstring.val.split(',')[1])
    !this.altplinelist.select('Dtext',!this.weldstring.val.split(',')[3])
    !int = !this.weldstring.val.split(',')[2]
    do !a values !intersection.dtext
      if !a.dbref().name.match(!int).gt(0) then
        !intersect = !a.dbref()
        break
      endif
    enddo
    !this.setrgroup('SEND')
  else
    !this.setrgroup('LOC')
  endif
  !this.setrgroup(!this.enddef.selection())
endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
---- method for activating /deactivating intersection options
define method .setrgroup(!enddef is STRING)

  if !enddef.eq('LOC') then $* grey out the intersection gadgets

    !this.inter.active        = false
    !this.intersection.active = false
    !this.idsctn.active       = false
    !this.altplinelist.active = false
    !this.altIdpline.active   = false
    !this.weldstring.val = !this.plinelist.selection() & ',' & !this.endtext
  else

    !this.inter.active        = true
    !this.intersection.active = true
    !this.idsctn.active       = true
    !this.altplinelist.active = true
    !this.altIdpline.active   = true
    !this.weldstring.val = !this.plinelist.selection() & ',' & !this.intersection.selection('dtext').after('-') & ',' & !this.altplinelist.selection()

  endif

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .setplines()

  !this.altplinelist.dtext = !this.intersection.selection().dbref().plna
  handle ANY
    $* there is no second member
    return
  endhandle

  !this.setrgroup(!this.enddef.selection())

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to write start and end data back to the current object
define method .writedata()
  -- first compile the data
  -- in the form host pline,member name,member pline
  -- !returnstring = !this.plinelist.selection() & ',' & !this.intersection.selection('dtext').after('-') & ',' & !this.altplinelist.selection()
  if !this.type.val.eq('Start') then
    !this.form.start.val = '$!this.weldstring'
  else
    !this.form.end.val = '$!this.weldstring'
  endif
  -- !this.form.currentstd.fillform(!this.form)
  !this.form.currentstd.startptype = 'SEND'
  !this.hide()

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------

define method .idaltsctn()

  var !a pick
  !this.intersection.select('rtext',!a[1]  )
  handle ANY
  endhandle



endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .idpline(!type is STRING)

  var !pline pick pline
  handle ANY
    return
  endhandle
  if !this.enddef.selection().eq('LOC') then
    !this.getplineend(!pline)
  else

    -- q var !pline
    -- now select the pline in the list
    --'PPline LBOA OF =23713/2905'
    if !type.eq('host') then
      if !pline[1].split()[4].neq( !this.form.memberlist.selection()) then
        !!alert.error(' The Pline You Identified is not on the Current Section')
        return
      else
        !selected = !pline[1].split()[2]
        !this.plinelist.select('dtext',!selected)
      endif
    else
      !selected = !pline[1].split()[2]
      !this.altplinelist.select('dtext',!selected)
    endif
    -- make up the command line
    !this.weldstring.val = !this.plinelist.selection() & ',' &  !this.intersection.selection('dtext').after('-') $
    & ',' & !this.altplinelist.selection()

  endif

endmethod
--------------------------------------------------------------------------------------------
define method .getplineend(!pline is ARRAY)


  -- now select the pline in the list
  --'PPline LBOA OF =23713/2905'
  if !pline[1].split()[4].neq( !this.hostsctn.string()) then
    !!alert.error(' The Pline You Identified is not on the Current Section')
    return
  else
    !selected = !pline[1].split()[2]
    !this.plinelist.select('dtext',!selected)
    -- now try and sort out which end of the section was hit
    -- the return from the pick [2] is as follows
    -- 'Line E 43.2 N 33.3 D Through E 2012.637817 N 29.882284 D 57.636688'
    !postext = !pline[2].after('Through')
    !position = $!postext wrt /*
    !dirtext = !pline[2].after('Line').before('Through')
    !direction = $!dirtext
    handle (2,779)
      !direction = axis $!dirtext
    endhandle
    -- create a vector along the line of the pick
    !vector = object POINTVECTOR()
    !vector.position = !position
    !vector.direction = !direction
    -- create a line along the length of the pline
    !ppline = object LINE()
    !ppline.startposition = !pline[1].split()[4].dbref().plst.$!<selected>.wrt(/* )
    !ppline.endposition   = !pline[1].split()[4].dbref().plen.$!<selected>.wrt(/* )
    -- find the intersection point of the vector and the pline
    !intersection = !vector.intersection(!ppline)
    -- get the position of the intersection on the pline
    !prop = !ppline.near(!intersection)
    -- calculate the distance of the intersection from the poss of the pline
    !startdist = !ppline.startposition.distance(!prop)
    -- if the distance from the start of the pline is gt half the length its the end
    if !startdist.gt(0.5 * !ppline.length()) then
      !this.endtext = 'END'
    else
      !this.endtext = 'START'
    endif
  endif
  !this.weldstring.val = !selected & ',' & !this.endtext
endmethod
