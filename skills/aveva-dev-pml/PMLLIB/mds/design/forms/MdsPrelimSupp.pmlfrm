--
-- File:  MdsPrelimSupp.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--
-- Author:  Neale Morris
-- Created:  Wed 10 March 2004
--
--
-- Description:
-- Form Definition for Prelim Supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  find(GADGET,STRING)              -
--  init()                           -
--

-- Kill existing form definition

kill !!mdsPrelimSupp

-- Define Form

setup form !!mdsPrelimSupp dialog resizeable

  !!mdsPrelimSupp.formtitle    = |MDS Preliminary Supports|
  !!mdsPrelimSupp.icontitle    = ||
  !!mdsPrelimSupp.callback     = |!this.init()|
  !!mdsPrelimSupp.formrevision = ||

  -- Body of Form

  text .name     |Name: | call |CALLIB NAMECHK _mdsPrelimSupp_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
  call !!mdsSupportForm(!!mdsPrelimSupp)
  call !!mdsSetSupp(!!mdsPrelimSupp)
  | width 20 name

  menu .autoNamemenu
    add 'Select Naming File...' call |show !!mdsAutoname|
  exit

  -- button .autoName |MDS Autoname| call |!!mdsAutoname.getNextName(!this)|
  -- !this.autoName.setPopup(!this.autoNamemenu)

  -- button .set |Creation Zone...| at xmax+1 ymin call |Call !!mdsIDfltSite()|

  button .autoName | | tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsAutoname.getNextName(!this)|
  !this.autoName.setPopup(!this.autoNamemenu)

  button .set | | at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!mdsIDfltSite()|
  !this.set.active = FALSE

  button .startGroup | | at xmax+1 ymin tooltip 'New Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('NEW',!this)|
  !this.startGroup.active = FALSE

  path down
  vdist 0.1
  list .standard |Preliminary support type:| at x0 Ymax+0.5 call |call !!kActionCommands(!!mdsPrelimSupp.listActions)| anchor L+B+R+T width 62 length 8

  -- Bottom Line
  button .ok     |   OK   | at xmin           ymax call |$$_SuppFunction| anchor L+B
  path right
  button .view   | View...| at xmax+1         ymin Call |call !!mdsAddPlot(!!mdsPrelimSupp.standard, 'show',!!mdsPrelimSupp)| anchor L+B
  path right
  -- Modified for defect 10598
  text .find 'Find ' call |!this.find(!this.standard,!this.find.val)| anchor L+B width 10 string
  button .cancel | Cancel | at xmax form-size ymin call |call !!mdsResetAutoName(!this)| anchor R+B

  -- Form Members
  -- Form Name of Support
  member .suppFunction is STRING

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Actions on list button
  member .listActions  is ARRAY

  --<wd>03nov2006<mds12>
  -- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
  --<wd>03nov2006<mds12>

  -- End form definition
exit

-- Actions to be taken on list gadget
!!mdsPrelimSupp.listActions[1] = |call !!mdsAddPlot(!!mdsPrelimSupp.standard, '',!!mdsPrelimSupp)|
!!mdsPrelimSupp.listActions[2] = |call !!mdsSupportForm(!!mdsPrelimSupp)|

-- Set icons
!!mdsSetIconBack(!!mdsPrelimSupp,'white')

--<wd>03nov2006<mds12>
-- Set the DEFAULT settings for the form Members
!this.error = TRUE
!this.emess = 'No MDS Preliminary Ancillaries available.'
--<wd>03nov2006<mds12>

------------------------------------
define method .init()
  ------------------------------------

  -- Reset Gadgets

  !!mdsPrelimSupp.name.val = 'unset'
  !!mdsPrelimSupp.ok.active = False

  -- Read defaults file to load selections

  !!mdsPopulate(!!mdsPrelimSupp,'PRELIMSUPP')

  -- Check to see if all the standard for this type have been commented out

  !unusedcheckVal = !!mdsPrelimSupp.standard.dtext[1]
  handle (61,567) (61,615)
    !!mdsPrelimSupp.view.active = false
    !!mdsPrelimSupp.name.active = false
    return
  elsehandle none
    !!mdsPrelimSupp.view.active = true
    !!mdsPrelimSupp.name.active = true
  endhandle

  -- Store Current Support Form name and required function in Main form for use later

  !!mdsSetSupp(!!mdsPrelimSupp)

  -- Setup autonaming

  if !!mdsAutoname.fileName.unset() then
    !!mdsAutoname.fileName = object FILE('$!!pDMSDFLTS\DES-SUPP-NAMES')
  endif

  -- Set the name gadget as the focus

  !!mdsPrelimSupp.standard.val = 1

  !!mdsPrelimSupp.name.setFocus()

  -- Reset the DAC global variable in case it has been left set to true

  !!mdsDacControl(false)

endmethod
-- Added method for defect 10598
define method .find(!gadget is GADGET,!string is STRING)

  -- Try and find string in selection list

  do !loop from 1 to !gadget.dtext.size()
    if !gadget.dtext[$!loop].matchwild('*$!string*') then
      -- Set found index
      !gadget.val = !loop
      -- Get callback and call
      !callback = !gadget.callback
      $!callback
      handle any
      endhandle
      if !callback.eq('!this.setmaster()') then
        !!mdsFrame.setmaster()
      endif
      return
    endif
  enddo

  !!alert.error('Unable to find string ' + !string)

endmethod
