--
--
-- Description:
-- Form Definition for selection of lighting support templates
--
--------------------------------------------------------------------------------

-- Define Form
Setup Form  !!MdsSelectLs


    list .Size callback '!this.select()' height 20 width 64

    text .Filter 'Filter' at xmin ymax+0.2  callback '!this.Filter()' width 14 is STRING
    option .filtertype 'Show' at xmax+2 ymin callback '!this.Filter()' width 10
    toggle .Mirror 'Mirror' at xmax form-size ymin callback ''
    button .Dismiss | Dismiss | at xmax form-size ymax OK

    -- form members
    member .TmplList is ARRAY
    member .CurrentList is ARRAY
    member .CurrentTmpl is DBREF

-- End form definition
exit


-- default setting
----------------------------------------------------------------------------------------
define method .MdsselectLs()

    !this.FormTitle = 'Select Required Template'
    !this.Initcall = '!this.Init()'

    !Dtext[1] = 'Wall Mounted'
    !Dtext[2] = 'Ceiling Mounted'
    !Dtext[3] = 'All'

    !this.filtertype.dtext = !dtext

endmethod

-- Method to initialise the template selection form
--------------------------------------------------
define method .Init()

       if !this.filter.val.Unset() then
          !this.Filter.val = '*'
       endif
       if !this.filter.val.trim().empty() then
          !this.filter.val = '*'
       endif

       !this.filter()


endmethod


-- filter list
----------------------------------------------------------------------------------------
define method .Filter()


    -- first filter basic type
    !WhatFilter = !this.filtertype.val

    !TypeFilterIsOn = TRUE
    if !WhatFilter.eq(1) then
       !MatchUp = 0
    elseif !WhatFilter.eq(2) then
       !MatchUp = 1
    else
       -- leave template list as it is
       !Matchup = 2
       !TypeFilterIsOn = FALSE
    endif

    !currentlist = ARRAY()
    !temporarylist = ARRAY()
    do !tmpl values !this.tmpllist
       !Supp = object MDSLSUPPORT(!tmpl)
       !LegDir = !supp.endplane.direction().wrt(worl)
       handle ANY
         skip if !typeFilterIsOn
         !Legdir = D
       endhandle
       skip if !Legdir.up.eq(!MatchUp).not().and(!TypeFilterIsOn)
       !temporarylist.append(!tmpl)
    enddo


    -- then filter description
    !filter = !this.filter.val

    if !filter.unset() then
       !filter = ''
    endif

    if !filter.trim().empty() then
       !filter = '*'
       !this.filter.val = !filter
    endif

    do !tmpl values !temporarylist
       skip if !tmpl.desc.matchwild(!filter).Not()
       !currentlist.append(!tmpl)
    enddo

    -- now store the result
    !this.currentlist = !currentlist

    !Selection = !currentlist.findfirst(!this.currenttmpl)

    !this.size.dtext = !currentlist.evaluate(object BLOCK('!currentlist[!evalindex].desc'))

    !this.size.val = !selection
        handle ANY
        endhandle

    !this.mirror.active = !this.size.dtext.set()
    !this.filter.active = !this.TmplList.Set()
    !this.filtertype.active = !this.tmpllist.set()

endmethod


-- callback on template selection
----------------------------------------------------------------------------------------
define method .Select()

      !Selection = !this.size.val
      !that = !this.owner()

      !tmpl = !this.currentlist[!selection]

      !that.support.copyfrom(!tmpl)

      if !this.mirror.val.and(!that.support.mirror.not()).or(!this.mirror.val.not().and(!that.support.mirror)) then
            !that.support.mirror()
      endif

      -- set buttons on calling form
      !that.setButtons()

      if !that.graphicalDim then
         !that.Support.GraphicalDim(TRUE,!that.DimAidNumber)
            handle ANY
            endhandle
      endif

      !!ce = !that.support.stru

      !that.enhance(on)

endmethod

-- End of file MdsSelectls.pmlfrm
