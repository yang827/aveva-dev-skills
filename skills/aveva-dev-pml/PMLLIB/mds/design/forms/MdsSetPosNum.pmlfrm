-- Created:		Thursday 19th May 2005
--
--
-- Description:
-- Form Definition for ADP Position Numbers
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  GetAncills(STRING,BOOLEAN,ARRAY) ARRAY
--  GetHang(STRING,BOOLEAN,ARRAY)    ARRAY
--  GetStru(STRING,BOOLEAN,ARRAY)    ARRAY
--  align(STRING)                    -
--  init(DBREF)                      -
--

-- Kill existing form definition
kill !!MdsSetPosNum

-- Define Form
setup form  !!MdsSetPosNum

  !!MdsSetPosNum.formtitle    = |ADP Position Numbers|
  !!MdsSetPosNum.icontitle    = |ADP Pos Num|
  !!MdsSetPosNum.callback     = ||
  !!MdsSetPosNum.formrevision = ||

-- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

-- List of members

  list .members |Support Members| at x0 ymax call |!this.align('MEM')| height 12 width 30
  list .posnum  |Pos Number| at xmax ymin call |!this.align('POS')| height 12 width 10

--------------------------------------------------------------------------------

$(

-- Create Datum
  frame .fdatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatv

-- Bottom Line

$)

    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptvt18()|


--------------------------------------------------------------------------------

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

define method .init(!Dbref is DBREF)

-- Find the support name

  !!MdsSilent = TRUE
  !SuppName = !!MdsGetSuppName(!Dbref)
  !!MdsSilent = FALSE

-- If we cannot find the support abort

  if !SuppName.eq('ABORT') then
    !!Alert.Error('Unable to find support to set ADP position numbers')
    return
  endif

-- Set the paragrpah gadget for the support name

  !this.name.val = !SuppName.after('/').before('[')

-- Need to put all members in the list
-- If the support member is a group we need to control the whole group as one

  if !SuppName.match('[').gt(0) then
    !Group = TRUE
  else
    !Group = FALSE
  endif

-- The list will be ordered as follows
-- Ancillaries, followed by austenetic shields if needed
-- Structural members
-- Hanger members

  !Members = ARRAY()

  !this.GetAncills(!SuppName,!Group,!Members)
  q var !members
  !this.GetStru(!SuppName,!Group,!Members)
  q var !members
  !this.GetHang(!SuppName,!Group,!Members)

  q var !members

  !DtextMem = ARRAY()
  !RtextMem = ARRAY()
  !DtextPos = ARRAY()
  !RtextPos = ARRAY()
  do !AddToList values !Members
    !DtextMem.append(!AddToList.name)
    !RtextMem.append(!AddToList.string())
    !DtextPos.append('not set')
    !RtextPos.append('not set')
  enddo
  !this.members.dtext = !DtextMem
  !this.members.rtext = !RtextMem
  !this.posnum.dtext = !DtextPos
  !this.posnum.rtext = !RtextPos

-- Display the form

  show !!MdsSetPosNum

endmethod

-- End of file MdsSetPosNum.pmlfrm

define method .GetAncills(!SuppName is STRING, !Group is BOOLEAN, !Members is ARRAY) is ARRAY
  if !Group then
    !GroupName = !SuppName.before('[')
    !GroupNum = !SuppName.after('[').before(']')
    !SuppName = !SuppName.replace('[$!GroupNum]','[1]')
    !Members.append($!SuppName/DATUM )
    do !Loop1 from 1 to 10
      do !Loop2 from 1 to 10
        !Members.append($!GroupName[$!Loop1]$n.$!Loop2 )
          handle ANY
          endhandle
      enddo
    enddo
  else
    !Members.append($!SuppName/DATUM )
    do !Loop from 1 to 100
      !Members.append($!SuppName$n.$!Loop )
        handle ANY
       endhandle
    enddo
  endif

  return !members

endmethod

define method .GetStru(!SuppName is STRING, !Group is BOOLEAN, !Members is ARRAY) is ARRAY

  var !coll coll all sctn for $!SuppName
  !Members.append($!SuppName/DATUM )
  do !Loop from 1 to !Coll.size()
    !Members.append($!Coll[$!Loop] )
      handle ANY
      endhandle
  enddo
  return !members

endmethod

define method .GetHang(!SuppName is STRING, !Group is BOOLEAN, !Members is ARRAY) is ARRAY

  return !members

endmethod

define method .align(!Which is STRING)

  if !Which.eq('MEM') then
    !this.posnum.val = !this.members.val
  elseif !Which.eq('POS') then
    !this.members.val = !this.posnum.val
  endif

endmethod
