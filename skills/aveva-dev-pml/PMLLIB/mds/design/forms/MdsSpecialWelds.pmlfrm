--
--
-- Description:
-- Form Definition for selecting ALL ancillary items found in dimensions default file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  SaveEdits()                      -
--  clearwelddisplay()               -
--  createweld()                     -
--  deleteweld()                     -
--  dismiss()                        -
--  drawframewelds()                 -
--  editweld()                       -
--  elementname()                    -
--  fillvolume(string)               -
--  getattas(ARRAY)                  ARRAY
--  getframemem()                    -
--  getplatewelds(dbref)             -
--  getppoints(dbref)                -
--  getsctnweldmem()                 -
--  getselweld()                     -
--  init(form)                       -
--  modname()                        -
--  recall()                         -
--  selectweld()                     -
--  setedit(BOOLEAN)                 -
--  setrgroup(real)                  -
--
setup form !!mdsSpecialwelds

  track 'DESICE' call '!this.elementname()'

  !!mdsSpecialwelds.formtitle    = |Framework Weld Selection|
  !!mdsSpecialwelds.icontitle    = ||
  !!mdsSpecialwelds.callback     = ||
  !!mdsSpecialwelds.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
--  list .Standard   | All Types     | at xmin ymax+0.3 call |!this.gettemplatemem()| width 38 length 10
--  list .strulist   | Templates | at xmax+0.3 ymin call '!this.getframemem()' width 10 height 10
  list .Memberlist | Sctn members |  at xmin+0.3 ymax+0.3 call '!this.getsctnweldmem()' width 26 height 10
  list .Welds      |  Welds  |    at xmax+0.3 ymin call '!this.getselweld()' width 26 height 10
  list .ppointlist |PPoints| at xmax+0.3 ymin multiple width 6 height 10

  path down
  vdist 1

  button .selstd  | New Weld... | at xmin .memberlist ymax call |!this.createweld()|
  button .delweld | Delete Weld | at xmax+1.5 ymin call |!this.deleteweld()|
  toggle .showwhat 'Show Selected Weld ' at xmax+1 ymin call |!this.getselweld()|
  path down
  vdist 0

frame .Additional 'Section/Weld Data'  at xmin.selstd ymax

   button .resel ' Reselect Std... ' at x0.5 y1  call '!this.recall()'
   rgroup .joints 'Joint and Fitting Welds'  at xmax+2 ymin-0.5 horizontal
      add tag ' Generic '       select 'GENERIC'
      add tag ' Current Joint ' select 'SPECIFIC'
   exit

   --button .Copy  ' Copy current ' at xmax+3 ymin call '!this.cecall()'

   text .sctnname '    Section:'  at xmin .resel ymax+0.5  width 53 is string
   text .dtsen    '  Weld name:' at xmin.sctnname ymax call '!this.modname()' width 53 is string
   text .symbol   'Symbol Name:' at xmin.sctnname ymax width 53 is string
   text .desc     'Description:' at xmin.sctnname ymax width 53 is string
   text .tagtext  '  Weld Size:' at xmin.sctnname ymax width 53 is string
   text .ppoint   '    PPoints:' at xmin.sctnname ymax width 53 is string

   frame .posi    ' Set Weld Position '    at xmin.sctnname ymax
     rgroup .enddef ' Weld Position ' at xmin + 1 ymax-0.2 call '!this.setrgroup(!this.enddef.val)' horizontal
      add tag ' Single Position ' select 'LOC'
      add tag ' Start & End  ' select   'SEND'
     exit
     vdist 1
     text   .start 'Start: ' at xmin .enddef ymax+0.5 width 49 is string
     button .idstart  ' Pick ' at xmax ymin call |!!mdspickweld.type.val = 'Start' !!mdspickweld.form = !this show !!mdspickweld|
     text   .end   '  End: ' at xmin .enddef ymax+0.5 width 49 is string
     button .idend    ' Pick ' at xmax ymin call |!!mdspickweld.type.val = 'End' !!mdspickweld.form = !this show !!mdspickweld|
   exit
   button .save ' Save ' at xmin ymax+0.3  call '!this.SaveEdits()'
 exit

-- Bottom Line
  button .Cancel | Dismiss | at xmax form-11 ymax.save+0.7 call '!this.dismiss()' ok

-- Members
  member .Sizes is array
  member .weldlist is mdsweldlist
  member .currentstd is mdsweld
  member .currentstandard is dbref
  member .form is FORM

-- End form definition
exit

-- load ALL ancillary types
-- for user to select the standard he wants to modify
-------------------------------------------------------------------------------------------
define method .init(!form is form)

  !this.currentstandard = !form.support.stru
  var !testmem coll all sctn for $!this.currentstandard
  --if !testmem.size().eq(0) then
    --!!alert.error('No Members Found - Unable to Add Welds')
    --return
  --endif

  !NumberOfAttas = !form.support.atta.size()
  if !NumberOfAttas.eq(0) then
    !!Alert.Error('No members have been created, unable to modify welds')
    return
  endif

  !this.form = !form
  !this.showwhat.val = FALSE

-- populate the list of available standards

  !this.getframemem()
  !this.show()

endmethod
--------------------------------------------------------------------------------------------
-- method to write the changes to the database for a  weld
define method .SaveEdits()

   -- set the new :mdsweldsize string if the current selection is an atta
   if (!!mdsspecialwelds.weldlist.designitem.type inset('ATTA','PJOI','SJOI')) then
     -- set the :mdsweldsize string to suit
     -- first get the existing values from the atta
     !exist = !!mdsspecialwelds.weldlist.designitem.:mdsweldsize
     if !this.welds.dtext.size().eq(1) then
        !!mdsspecialwelds.weldlist.designitem.:mdsweldsize = !this.tagtext.val
     else
        !list = !exist.split(',')
        !list[!this.welds.val] = !this.tagtext.val
        !weldstring = !list[1]
        do !a from 2 to !list.size()
          !weldstring = !weldstring & ','
          !weldstring = !weldstring & !list[!a]
        enddo
        !!mdsspecialwelds.weldlist.designitem.:mdsweldsize = !weldstring
     endif
     return
  endif

   -- check to make sure that all the values have been set
   if !this.tagtext.val eq '' then
     if !!alert.confirm('Weld size is unset - Do you want to continue?').eq('NO') then
        return
     endif
   endif
   if !this.start.val eq '' then
        !!alert.error('Weld Position is unset')
        return
   endif

   !this.currentstd.form = !this
   !this.currentstd.tagtext = !this.tagtext.val
   !this.currentstd.wpurp = 'SCTN'

   -- set the design item for the current weld
   !this.currentstd.designitem = !this.sctnname.val.dbref()
   !this.currentstd.name = !this.dtsen.val
   --!this.currentstd.categoryname = !this.sctnname.val.replace('/MDS/','/DDAR-')
   -- create the dataset or if it exists do nothing
   !this.currentstd.start    = !this.start.val
   !this.currentstd.end      = !this.end.val
   if !this.enddef.val eq 2 then
    !this.currentstd.startptype = 'SEND'
   else
    !this.currentstd.startptype = 'LOC'
   endif
   -- create or modify the dataset
   !this.currentstd.createdataset('Special')
   -- save the references
   -- could we change this to any item with :mdswelddata
   if !this.currentstd.designitem.type.eq('SCTN') then
         !!ce = !this.memberlist.selection().dbref()
         !weldlist = !!ce.:mdswelddata
         !final = array()
         do !a values !weldlist
           if !a.badref().not() then
             !final.append(!a)
           endif
         enddo
         !final.append(!this.currentstd.dtse)
         !final.unique()
         -- set the welddata pointers
         !!ce.:mdswelddata = !final
   elseif !this.currentstd.designitem.type inset('SJOI','PJOI','FITT') and '$!this.joints' eq 'SPECIFIC' then
         !!ce = !this.memberlist.selection().dbref()
         !weldlist = !!ce.:mdswelddata
         !final = array()
         do !a values !weldlist
           if !a.badref().not() then
             !final.append(!a)
           endif
         enddo
         !final.append(!this.currentstd.dtse)
         !final.unique()
         -- set the welddata pointers
         !!ce.:mdswelddata = !final
   endif

   -- refresh the form
   !this.getsctnweldmem()


endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .modname()

 !this.currentstd.name = !this.dtsen.val

endmethod

--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to fill in the bits when a user selects the end weld column
define method .getselweld()

  !this.selectweld()

-- If the tagtext is * then get the weld size from the :mdsweldsize attribute of the atta

$(
  if !this.tagtext.val.eq('*') then
      !MdsWeldSize = !!mdsspecialwelds.weldlist.designitem.:mdsweldsize
      !this.tagtext.val = !MdsWeldSize.split(',')[$!!mdsspecialwelds.welds.val]
  endif
$)


  if (!!mdsspecialwelds.weldlist.designitem.type inset('ATTA','PJOI','SJOI')) then
    if !!mdsspecialwelds.weldlist.designitem.type.eq('PJOI') and !!mdsspecialwelds.weldlist.designitem.gtype inset('PART','COMP','BEAR','COMB') then
      !MdsWeldSize = !!mdsspecialwelds.weldlist.designitem.:mdsweldsize
      !this.tagtext.val = !MdsWeldSize.split(',')[$!!mdsspecialwelds.welds.val]
    elseif !!mdsspecialwelds.weldlist.designitem.:mdsweldsize.neq('0') then
      !MdsWeldSize = !!mdsspecialwelds.weldlist.designitem.:mdsweldsize
      !this.tagtext.val = !MdsWeldSize.split(',')[$!!mdsspecialwelds.welds.val]
    endif
    !this.setedit(FALSE)
  else
    !this.setedit(TRUE)
  endif

  !this.drawframewelds()
endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
--
define method .setrgroup(!val is real)
  if !val eq 1  then
    !active = FALSE
    !inactive = TRUE
    !this.currentstd.startptype = 'LOC'
  else
    !active = TRUE
    !inactive = FALSE
    !this.currentstd.startptype = 'SEND'
  endif
  !this.end.active     = !active
  !this.idend.active   = !active


endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to update the list of welds when the user navigates to a different element
define method .elementname()

  -- find the navigated item in the sections memberlist list
  !this.memberlist.select('rtext',!!ce.string())
  handle ANY
      return
  endhandle
  !this.getsctnweldmem()

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to collect all sctn and joints for a particular standard
define method .getframemem()

    -- get section welds
    var !templist coll all (sctn sjoi pjoi fitt) for $!this.currentstandard
    !AttaList = !templist.appendarray(!this.getattas(!templist))
      handle ANY
      endhandle
    if !templist.size().eq(0) then
      !names[1] = 'None Found'
      !templist[1] = 'unset'
    else
       var !names eval name for all from !templist
       do !a index !names
          if !names[!a].match('=').eq(1) then
            --!names[!a] = !names[!a].dbref().flnm.split()[1] & !names[!a].dbref().flnm.split()[2]
            !names[!a] = !names[!a].dbref().flnm
          else
            --!names[!a] = !names[!a].after('MDS/')
          endif
       enddo
       !this.memberlist.dtext = !names
       !this.memberlist.rtext = !templist
     endif
 -- endif

  -- add the stru to the volume view
  !this.fillvolume( !this.currentstandard.string())

  -- fill in the welds list
  !this.getsctnweldmem()

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to find any associated attas in the list
-- by scanning the bars to get the :mdsattaref attribute of each bar
define method .getattas(!items is ARRAY)is ARRAY


  !name = !this.form.support.stru.name
  !datname  = !name & '/DATUM'
  !test = !datname.dbref()
    handle ANY
      return object ARRAY()
    endhandle
  !return[1] = !test.string()
  !miss = 0

  do !a from 1
    !attaname = !name & '.' & !a
    !test = !attaname.dbref()
    handle ANY
       !miss = !miss + 1
       if !miss.gt(3) then
          break
       else
          skip
       endif
    endhandle
    !return.append(!test.string())

  enddo

  return !return

   -- old way of doing the selection by :mdsattaref
  $(

  !bars = ARRAY()
  !return = ARRAY()
  do !a values !items
    if !a.dbref().name.match('BAR').gt(0).and(!a.dbref().type.eq('SCTN')) then   $* its a bar which might have an atta
      !bars.append(!a)
    endif
  enddo
  var !refs eval :MDSAttaRef for all from !bars
  !refs.unique()
  do !a values !refs
    !test = !a.dbref()
    handle ANY
     skip
    endhandle
    !return.append(!test.refno.string())
  enddo
$)



endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to look at the existing standard and get the welds associated with it
define method .getsctnweldmem()

  -- goto the section identified
  !!ce = !this.memberlist.selection().dbref()
  handle ANY
    return
  endhandle

  -- set the section name
  !this.sctnname.val = !this.memberlist.selection().dbref().name
  handle (2,813)
    return
  endhandle

  !component = !this.memberlist.selection().dbref()
  !this.currentstd.designitem = !component
  !type = !component.type
  if !type inset('SJOI','PJOI','FITT') then
    -- go and see if there are some generic welds available
    !this.joints.active = TRUE
    !this.ppoint.active = TRUE
    !this.ppointlist.active = TRUE
    !this.weldlist = object mdsweldlist(!component)
    !this.getppoints(!component)
    -- this sets the ppoint list
  else  $* its a section
     !this.joints.active = FALSE
     !this.ppoint.active = FALSE
     !this.ppointlist.active = FALSE
     !this.ppointlist.dtext = array()
     !this.weldlist = object mdsweldlist(!component)
  endif

  if !this.weldlist.welds.size().eq(0) then
      !names[1] = 'None Found'
      !dbref[1] = 'unset'
      $!this.memberlist  :mdswelddata unset
      handle (2,614)
      endhandle
  else
     do !a index !this.weldlist.welds
        !names[!a] = !this.weldlist.welds[!a].name.replace('/DDSE-','')
        !dbref[!a] = !this.weldlist.welds[!a].designitem.string()
     enddo
  endif
   !this.welds.dtext = !names
   !this.welds.rtext = !dbref

  -- now call the routine which displays the weld details
  !this.selectweld()
  !this.getselweld()
  -- if the weld can be drawn then draw an aid line and text
  !this.drawframewelds()

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- get the ppoints for a catalogue weld
-- if there are no ppoints then there cannot be a weld
define method .getppoints(!cataitem is dbref)

   -- save the current element
   !ptref = !cataitem.ptre
   if !ptref.unset() then
     !weldarray = array()
   else
      var !ppoints coll all ptca with purp eq 'MWEL' and number gt 300 for $!ptref
      var !numbers eval number for all from !ppoints
      var !heights eval pheight for all from !ppoints
      !weldarray = array()
      do !a index !ppoints
        !weldarray.append(!numbers[!a].string())
      enddo
   endif

   if !weldarray.size().eq(0) then
    !weldarray[1] = 'None Found'
    !this.welds.dtext = !weldarray
    !this.ppointlist.dtext = array()
    !this.clearwelddisplay()
   endif

   !this.ppointlist.dtext = !weldarray
   --!this.getplatewelds(!cataitem)

endmethod
---------------------------------------------------------------------------------------------
-- method to get a set of generic welds for a plate item
define method .getplatewelds(!cataitem is dbref)

   -- if its a generic weld then the name will be in the format DDAR-Jointname
   !tempweld = object mdsweld()
   !tempweld.designitem = !this.memberlist.selection().dbref()
   !name = !tempweld.getweldname(!this.joints.selection(),'std')
   $!name[1]
   handle ANY
     -- no welds yet defined
     !array[1] = 'None Found'
     !this.welds.dtext = !array
    return
  elsehandle NONE
  endhandle

  -- we now have a list of datasets for welds
  !weldlist = object mdsweldlist(!!ce,'STD')
  !this.weldlist = !weldlist
  !this.weldlist.currentweld = !this.weldlist.welds[1]
  handle ANY
     !array[1] = 'None Found'
     !this.welds.dtext = !array
     return
  endhandle
  !this.currentstd = !this.weldlist.currentweld
  --q var !this.weldlist.welds[1]
  do !a index !this.weldlist.welds
    !array[!a] = 'WELD $!a'
    !rarray[!a] = !this.weldlist.welds[!a].name
  enddo
  !this.welds.dtext = !array
  handle ANY
     !array[1] = 'None'
     !this.welds.dtext = !array
  elsehandle NONE
    !this.welds.rtext = !rarray
  endhandle

   -- now we have a weld object which should have the ppoints set
   do !a values !this.currentstd.ppoints
      !this.ppointlist.select('dtext','$!a')
   enddo
  !this.sctnname.val = !this.memberlist.selection().dbref().name
   handle (2,813)
     return
   endhandle

   --!this.selectweld()


endmethod
-------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to get the frame welds based on the selected standard
define method .drawframewelds()

    aid clear text all
    handle ANY
    endhandle

    aid clear cyli all
    handle ANY
    endhandle


  !this.weldlist = object mdsweldlist( !this.memberlist.selection().dbref() )
  !weldlist = !this.weldlist
  if defined (!weldlist.welds[1]) then
    if !this.showwhat.val then
        !weldlist.welds[!this.welds.val].drawweld(1)
    else
      do !weld index !weldlist.welds
       -- !aidnumber = 335 + !weld
       !weldlist.welds[!weld].drawweld(!weld)
      enddo
    endif
  endif

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to look at the existing standard and get the welds associated with it
define method .selectweld()

  if !this.welds.selection().eq('unset') then
    !weld = object mdsweld()
    !this.currentstd = !weld
  else
     !weld = !this.weldlist.welds[!this.welds.val]
--<GE> 06/02/07 Fix for Defect No: 10211
     handle ANY
     endhandle
--<GE> 06/02/07
     -- we have found a proper weld, now we need to decide what to do with it
  endif
  !this.currentstd = !weld
--<GE> 06/02/07 Fix for Defect No: 10211
  handle ANY
  endhandle
--<GE> 06/02/07
  !this.currentstd.fillform(!this)
  if !this.currentstd.startptype.eq('SEND') then
    !this.enddef.val = 2
  else
    !this.enddef.val = 1
  endif
  !this.setrgroup(!this.enddef.val)


endmethod
----------------------------------------------------------------------------------

----------------------------------------------------------------------------------
-- method to add the current selection into the volume view
define method .fillvolume(!stru is string)

  add $!stru
  -- call !!MdsZoomSupp(!this.form)

endmethod
-----------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to get welds from the standard list and create a new one
-- shows the mdsstdwelds form to get a new standard
-- returns a mdsweld object with the standard weld data
-- replaces the currentweld object
-- or maybe an editobject to be merged
--------------------------------------------------------------------------------------------
define method .createweld()

if !this.memberlist.selection().dbref().type inset('SJOI','PJOI','FITT') then
  if !this.ppointlist.selection().size().eq(0) then
      !!alert.error('No PPoints Selected - You must select at least 1 PPoint')
      return
  endif
endif
  !!mdsnewweld.form = !this
  !!mdsnewweld.context = 'NEW'
  show !!mdsnewWeld

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- method to call the weld select form to reselect a weld
define method .recall()

  !!mdsnewweld.form = !this
  !!mdsnewweld.context = 'RESEL'
  show !!mdsnewWeld

endmethod
--------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to show the edit weld form
--- may not be used?
define method .editweld()

  !!mdsnewweld.source = !this.memberlist.selection().dbref()
  show !!mdsnewweld

endmethod
------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to delete the selected weld
--
define method .deleteweld()

  !!ce = !this.dtsen.val.dbref()
  handle ANY
    !!alert.error('No Welds Selected')
    return
  endhandle

  if !!alert.confirm('Do you want to Delete this weld $!!ce.name') eq 'YES' then
    delete ddse
  endif
  -- can we find a section which points to the weld and delete the references to it
  !this.getsctnweldmem()

endmethod
------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- clears the bottom paragraph gadgets when there is no current weld
define method .clearwelddisplay()

  !this.dtsen.val  = ''
  !this.symbol.val = ''
  !this.desc.val   = ''
  !this.ppoint.val = ''
  !this.tagtext.val = ''

endmethod
---------------------------------------------------------------------------------------

define method .setedit(!type is BOOLEAN)

!this.selstd.active = !type
!this.delweld.active = !type
!this.sctnname.active = !type
!this.dtsen.active = !type
!this.symbol.active = !type
!this.desc.active = !type
-- !this.tagtext.active = !type
!this.ppoint.active = !type
!this.posi.active = !type
-- !this.save.active = !type
!this.start.active = !type
!this.idstart.active = !type
!this.end.active = !type
!this.idend.active = !type
!this.resel.active = !type
!this.joints.active = !type
!this.enddef.active = !type

endmethod


-----------------------------------------------------------------------------------------
define method .dismiss()

aid clear text all
    handle ANY
    endhandle

    aid clear cyli all
    handle ANY
    endhandle

endmethod
