--
--
-- Description:
-- Multi Discipline support Form
-- Purpose to build a weld for a single element or a list of elements
-- it starts up by getting a list of available welds and displaying them
-- the user then selects the items he wants to modify
--
--------------------------------------------------------------------------------

-- Define Form
setup Form !!mdsSTDWelds
!this.formtitle = 'Standard Welds'
init '!this.init()'
path down
frame .stds 'Weld Standard Categories'

  button .newarea ' Create Weld Area ' call '!this.createarea()'
  button .delarea ' Delete Weld Area ' call '!this.deletearea()'
  list   .arealist 'Existing Areas' at xmax .newarea+ 1 ymin .newarea call '!this.resetlist()'  width 30 height 4

exit

frame .welds 'Weld Items'

  button .newweld 'Create Weld ' call |!this.modweld('create')|
  button .delweld 'Delete Weld ' call |!this.modweld('delete')|
  button .modify  'Modify Weld ' call |!this.modweld('modify')|
  list   .weldlist  'Existing Welds' at xmax .newweld+ 1 ymin .newweld call '!this.selectweld()' width 35 height 7
  path down

  para .pdtsen at xmin.newweld ymax text  '       Name: '
  para .dtsen at xmax ymin width 40 lines 1
  para .psymbol at xmin.pdtsen ymax text  'Symbol Name: '
  para .symbol at xmax ymin width 40   lines 1
  para .pdesc  at xmin.pdtsen ymax  text  'Description: '
  para .desc at xmax ymin width 40  lines 1

exit

   button .apply ' OK '  call |!this.ok()| ok
   button .dismiss ' Cancel ' at xmax form -size ymin cancel

   member .source is dbref
   member .destination is dbref
   member .existingstds is ARRAY
   member .cstds is ARRAY
   member .currentstd is mdsweld
   member .edit is MDSWELD
   member .allweldlist is mdsweldlist
   member .form is form
   member .context is STRING
   !this.context = 'std'
exit
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .init()

  !this.source = /MDS/STD/WELDS
  -- load the standard welds
  var !std coll all ddar for $!this.source
  var !names eval name for all from !std
  !this.arealist.dtext = !names
  !this.arealist.rtext = !std

  -- load the default welds and the existing standards

  !this.destination = /MDS/DES/WELDS
  -- first load the standard welds available
  --var !stds coll all ddse for $!this.destination
  --!total = ARRAY()

  --do !a values !stds
   --!total.append(object mdsweldlist(!A.dbref(),'STD'))
  --enddo

  --!this.existingstds = !total

 if !this.context eq 'noedit' then

   !this.newarea.active  = false
   !this.delarea.active  = false
   !this.newweld.active  = false
   !this.delweld.active  = false
   !this.modify.active   = FALSE
else
   !this.newarea.active  = true
   !this.delarea.active  = true
   !this.arealist.active = true
   !this.newweld .active = true
   !this.delweld .active = true
   !this.modify  .active = true
   !this.weldlist.active = true
endif

   !this.resetlist()

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .resetlist()

 var !std coll all ddse for $!this.arealist
 var !names eval name for all from !std
 !this.weldlist.dtext = !names
 !this.weldlist.rtext = !std
 !this.selectarea()

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
define method .selectarea()

 !current = !this.weldlist.selection().dbref()
 if !current.unset() then
    return
 endif
 !this.currentstd = object mdsweld(!current)
 !this.fillform()

endmethod
--------------------------------------------------------------------------

--------------------------------------------------------------------------
define method .selectweld()

 !current = !this.weldlist.selection().dbref()
 !this.currentstd = object mdsweld(!current)
 !this.fillform()

endmethod
---------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .fillform()

  !this.dtsen.val = !this.currentstd.dtse.name
  handle ANY
      !this.dtsen.val = 'unset'
  endhandle

  !this.symbol.val = !this.currentstd.symboldata.ddprop.replace(|(|,||).replace(|)|,||).replace(|'|,||).trim()
  handle ANY
      !this.symbol.val = 'unset'
  endhandle
  !this.desc.val   = !this.currentstd.dtse.description
  handle ANY
      !this.desc.val = 'unset'
  endhandle

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
define method .modweld(!mode is STRING)


   if !mode eq 'modify' then
     !!mdscreatestdweld.context = 'Modify'
     !!mdscreatestdweld.modify = TRUE
     !current = !this.weldlist.selection().dbref()
     !!mdscreatestdweld.currentstd = object mdsweld(!current)
     !!mdscreatestdweld.source = !this.weldlist.selection().dbref()
     show !!mdscreateStdweld
   elseif !mode eq 'create' then
      !!mdscreatestdweld.context = 'NEW'
      !!mdscreateStdweld.modify = FALSE
      -- populate the form with an existing
      !!mdscreateStdweld.source = !this.arealist.selection().dbref()
      !!mdscreatestdweld.dtsen.val = !this.arealist.selection().dbref().name & '/'
      show !!mdsCreateStdWeld
   else
     -- its delete mode so delete the dataset
     !!ce = !this.weldlist.selection().dbref()
     !name = !!ce.name
     if !!alert.confirm('Do You want to delete Weld $!name').eq('YES') then
         delete ddse
     endif
     !this.resetlist()
   endif

endmethod

--------------------------------------------------------------------------------
define method .ok()


 if !this.context eq 'noedit' then
    !!mdsancilwelds.currentstd = !this.currentstd
    !!mdsancilwelds.createnewweld()
    !!mdsancilwelds.fillform()
 endif

    !this.context = 'std'

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .createarea()

   !!mdscreatestdweld.context = 'AREA'
   show !!mdscreatestdweld


endmethod
--------------------------------------------------------------------------------

define method .deletearea()

     !areaname = !this.arealist.selection().dbref().name

     if !!alert.confirm('Do You want to delete AREA $!areaname').eq('YES') then
        !!ce =  !this.arealist.selection().dbref()
        delete ddar
        !this.init()
     endif




endmethod



-- End of file
