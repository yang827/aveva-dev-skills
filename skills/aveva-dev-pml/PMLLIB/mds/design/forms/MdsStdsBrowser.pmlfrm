--
-- File:		MdsStdsBrowser.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--
-- Author:		Neale Morris
-- Created:		10/03/2005 08:30
--
--
-- Description:
-- Form Definition to browse the MDS Standards
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  set(STRING)                      -
--  setactive()                      -
--  setpara()                        -
--  showplot(STRING)                 -
--
kill !!mdsStdsBrowser
-- Define Form
setup form !!mdsStdsBrowser
  !!mdsStdsBrowser.formtitle    = |Multi Discipline Standard Standards Browser|
  !!mdsStdsBrowser.icontitle    = ||
  !!mdsStdsBrowser.callback     = |!this.set('AN')|
  !!mdsStdsBrowser.formrevision = | $Revision: 1.1.19.1 $ |
  button .aN  'AN' at x0 y0 call |!this.set('AN')|
  path right
  button .aT  'AT' call |!this.set('AT')|
  button .bR  'BR' call |!this.set('BR')|
  button .bT  'BT' call |!this.set('BT')|
  button .cA  'CA' call |!this.set('CA')|
  button .cT  'CT' call |!this.set('CT')|
  button .dT  'DT' call |!this.set('DT')|
  button .fT  'FT' call |!this.set('FT')|
  button .gT  'GT' call |!this.set('GT')|
  button .lT  'LT' call |!this.set('LT')|
  button .pR  'PR' call |!this.set('PR')|
  button .sT  'ST' call |!this.set('ST')|
  button .sU  'SU' call |!this.set('SU')|
  button .tT  'TT' call |!this.set('TT')|
  button .vT  'VT' call |!this.set('VT')|
  button _prev at x0 y1 pixmap height 12 width 9 call |!this.showplot('PREV')|
  path right
  hdist0
  button _next at xmax ymin pixmap height 12 width 9 call |!this.showplot('NEXT')|
  para .sheets width 30 lines 1
  !!mdsStdsBrowser.prev.addPixmap(!!pML.getPathName('leftarrow9x12.png'))
  !!mdsStdsBrowser.next.addPixmap(!!pML.getPathName('rightarrow9x12.png'))
  menu .ppopup
    add 'Reset Limits' call |!!mdsStdsBrowser.plot.add(!!mdsStdsBrowser.plot.val)|
  exit
-- Body of Form
  view .plot at x0 ymax+0.2 PLOT
    bord on
    height 30
    width 70
    setc 15
  exit
-- Add popup
  !this.plot.setPopup(!this.ppopup)
  path down
  vdist 0.5
-- Bottom Line
  button .dismiss | Dismiss | cancel
  path right
-- Project Type para
  para .filename at xmax+2 ymin width 40 lines 1
-- Page member
  member .sheet is REAL
  member .plots is ARRAY
-- End form definition
exit


define method .set(!type is STRING)
  !this.plots.clear()
  !file = object FILE()

  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH
  --var !dir evar MDSPLOTS
  --!splitFile = !dir.split(' ')
  !evarName = 'MDSPLOTS'
  !splitFile = !!evarSplit(!evarName)
  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH

  do !loop from 1 to !splitFile.size()
    !file.file (!splitFile[$!loop])
    if !file.exists() then
      !foundFiles = !file.files()
      do !x from 1 to !foundFiles.size()
        if !foundFiles[$!x].string().upcase().matchwild('*MDS-STANDARDS-$!type*') then
          !this.plots.append(!foundFiles[$!x])
        endif
      enddo
    endif
  enddo
-- Remove Duplicates from list
  --do !remove from 1 to !this.plots.size()
  --enddo
  !this.sheet = 1

-- Put first plot into plot view
  !currentPlot = !this.sheet
  edit !!mdsStdsBrowser.plot PLOT
    add /$!!mdsStdsBrowser.plots[1]
  exit

  !this.sheet = 1
  -- Put file name in para gadget
  !this.setpara()
  !this.setactive()
endmethod

define method .showplot(!arg is STRING)
  !currentPlot = !!mdsStdsBrowser.sheet
  if !arg.eq('NEXT') then
    !nextPlot = !currentPlot + 1
  else
    !nextPlot = !currentPlot - 1
  endif
  edit !!mdsStdsBrowser.plot PLOT
  add /$!!mdsStdsBrowser.plots[$!nextPlot]
  exit
  !this.sheet = !nextPlot
  -- Put file name in para gadget
  !this.setpara()
  !this.setactive()
endmethod

define method .setactive()
  if !this.sheet.eq(1) then
    !this.prev.active = FALSE
  elseif !this.sheet.eq(!this.plots.size()) then
    !this.next.active = FALSE
  else
    !this.prev.active = TRUE
    !this.next.active = TRUE
  endif
endmethod

define method .setpara()
  !fileString = !this.plots[$!this.sheet]
  !entry = !fileString.entry()
  !this.filename.val = !entry
endmethod
