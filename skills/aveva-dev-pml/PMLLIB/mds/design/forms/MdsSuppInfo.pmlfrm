--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -
--  adpDrawlist(DBREF,GADGET)        -
--  data()                           -
--  emptyAll()                       -
--  getAtta()                        ARRAY
--  getCode(DBREF)                   STRING
--  getDiscipline()                  STRING
--  hideData()                       -
--  listAncil()                      -
--  listSctn()                       -
--  mdsSuppInfo()                    -
--  pickAncil()                      -
--  setCodes(MENU,STRING)            -
--  showData(DBREF)                  -
--  update(FORM,STRING)              -
--
---------------------------------------------------------------------------------------------------------

-- Define Form
setup form  !!mdsSuppInfo

  -- <kp>feb07 removed as output is always formatted in columns
-- first get and store pdms version
  --  member .elevenSix is BOOLEAN
--  !bann = banner
  --  !this.elevenSix = !bann.short.after('PDMS Design Mk').match('11.6').eq(1)
  --  if !this.elevenSix then
  !columns = 'columns'
  !dataHeig = 9
  !nameWidt = 39
--  else
  --     !columns = ''
  --     !dataHeig = 8
  --     !nameWidt = 40
--  endif

  -- create bar menu
  bar

  frame .frame1 'General' at xmin ymax
    text .name 'Support ' at xmin+0.7 width $!nameWidt is STRING
    paragraph .group at xmin ymax text 'Group      '

    frame .frame12 'Sections' at xmin ymax
      list .section at xmin.frame12+0.7 ymax Columns width 45 heigh 6
    exit
    frame .frame13 'Ancillaries' at xmin.frame12 ymax+0.5
      list .ancil at xmin .section ymax callback '!this.pickAncil()' Columns width 45 heig 6
    exit
  exit

  frame .frame2 'Specific' at xmin ymax

    list .suppData at xmin.section ymax Columns width 45 heig $!dataHeig

    frame .frame22 'ADP Drawlist' at xmin.frame12 ymax
      list .adpDrawlist at xmin.section ymax width 45 heig 4
    exit

    button .data 'Data...' at xmin ymax+0.2 callback '!this.data()'

  exit

  toggle .update 'DB Tracking' at xmin .frame2 ymax+0.5
  button .dismiss 'Dismiss' at xmax form-size ymin OK


   -- setup form tracking
  track |DESICE| callback '!this.update('

   -- Form members
  member .support is DBREF
  member .atta is ARRAY
  member .sctn is ARRAY
  member .mdsCode is BOOLEAN

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
define method .mdsSuppInfo()



  !this.formTitle = 'Support Information View'
  !this.initcall = '!this.init()'

  !this.name.seteditable(false)
  !this.update.val = true
  !this.mdsCode = true

  !this.newMenu('File')
  !this.file.add('toggle','MDS Codes','!this.setCodes(')
  !this.file.add('toggle','Client Codes','!this.setCodes(')
  !this.file.select('MDS Codes',true)

  !this.bar.add('Display','File')

  !sctnHead[1] = 'Name'
  !sctnHead[2] = 'Spec.ref.'
  !sctnHead[3] = 'Mat.ref.'

  !ancilHead[1] = 'ID'
  !ancilHead[2] = 'Code'
  !ancilHead[3] = 'Mtoc'
  !ancilHead[4] = 'Anc.matr.'
  !ancilHead[5] = 'Pipe Matr.'
  !ancilHead[6] = 'Insul'

  !dataHead[1] = ''
  !dataHead[2] = ''

  !this.section.setHeadings(!sctnHead)
  !this.ancil.setHeadings(!ancilHead)
  !this.suppData.setHeadings(!dataHead)


  !this.cancelcall = '!this.hideData()'
  !this.okcall = '!this.hideData()'

  endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()

  !this.update(!this,'')

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .update(!form is FORM, !string is STRING)

  if !this.update.val.not() then
        return
     endif

     -- get supportname
  !!mdsSilent = true
  !suppName = !!mdsGetSuppName(ce)
  !!mdsSilent.delete()

     -- clear form
  !this.emptyAll()

     -- finish if not a support
  if !suppName.eq('ABORT') then
    !this.active(false)
    !this.showData(world)
        return
     else
    !this.active(true)
     endif

     -- get support refno
  !this.support = !suppName.dbref()

     -- get section list
  var !allSctn collect all SCTN for $!this.support
  !this.sctn = !allSctn.evaluate(object BLOCK('!allSctn[!evalIndex].dbref()'))

     -- get atta list
  !attas = !this.getAtta()
  do !atta values !attas
    !stext = stext of text 1 of pspe of owne of $!atta
            handle ANY
      !stext = ''
    endhandle
    !purp = !atta.owne.pspe.purp
    if !stext.eq('PIPING').or(!purp.eq('PIPE')) then
      !this.atta.append(!atta)
         endif
     enddo

     -- check if a group
  if !suppName.match('[').gt(0) then
        !this.group.val = 'Group YES'
     else
    !this.group.val = 'Group NO'
     endif

     -- set dist format for position
  !this.name.val = !suppName
  !fmt = !!distanceFMT
  if (!!isImperialLength()) then
    !fmt.dP = 0
     endif

     -- set variable defaults
  !type = ''
  !std = ''
  !disc = ''
  !size = 'N/A'
  !comment = ''
  !adpLoc = ''
  !adpFlip = ''
  !trimmer = ''

     -- set left column
  !typeHead    = '        Type:'
     !stdHead     = '    Standard:'
     !discHead    = '  Discipline:'
     !sizeHead    = '        Size:'
  !commHead    = 'Drwg Comment:'
  !adpLocHead  = 'ADP Location:'
  !adpFlipHead = '    ADP Flip:'
     !trimHead    = '     Trimmer:'

     -- set datum atta and get specific data
     if !this.support.type.eq('STRU') then

    !datum = object DBREF(!suppName + '/DATUM')
            handle ANY
            endhandle
    !main = !this.support

        -- set size
    if !this.support.desc.trim().empty().not() then
      !size = !this.support.desc.trim()
        endif

        -- set type and standard
    if !this.support.:MDSSuppType.eq('SPECIAL') then
      !type = 'SPECIAL FRAME'
--<kp>feb07 Ability to work with Lighting supports added
    elseif !this.support.:MdsSuppType.eq(!!mdslsuppdefs.type).and(!!mdslsuppdefs.error.unset()) then
      !type = 'LIGHTING SUPPORT'
      !datum = !this.support
      !sizeHead = ' Description:'
      !size = !this.support.:mdsprojspec.desc
      handle ANY
        !size = 'N/A'
      endhandle
      !std = !this.getCode(!this.support)
      --<kp>feb07
    else
      !type = 'STANDARD FRAME'
      !std = !this.getCode(!this.support)
    endif

    -- set discipline
    !disc = !this.getDiscipline()


    -- set ADP location
    if !this.support.:MdsAdpLoc.east.unset() then
      !adpLocPos = !datum.position.wrt(worl)
      handle ANY
      endhandle
    else
      !adpLocPos = !this.support.:MdsAdpLoc.wrt(worl)
    endif
    !adpLoc = !adpLocPos.string(!fmt).before(' WRT')
    handle ANY
    endhandle



  elseif !this.support.type.eq('ATTA') then

    !datum = !this.support

        -- set standard
    !std = !this.getCode(!this.support)
    if !datum.cref.badref() then
      !type = 'ANCILLARY'
      !main = !datum
        else
      !type = 'HANGER'
      !main.datum.cref.owner
    endif

    -- set discipline
    !purp = stext of text1 of pspe of owner of $!this.support
    if !purp.neq('PIPING') then
      !purp = !this.support.owner.pspe.purp
      if !purp.eq('TRAY') then
        !purp = 'CABLE'
      endif
    endif
    !disc = !purp

    -- set ADP location
    !adpLoc = !this.support.pos.wrt(worl).string(!fmt).before(' WRT')

     endif

     -- set ADP flip
  if !main.:MDSViewFlip then
    !adpFlip = 'YES'
     else
    !adpFlip = 'NO'
     endif
        handle ANY
        endhandle

     -- set drawing comment
  !comment = !datum.:MDSComment

     -- set trimmer
  if !this.support.:MDSTrimmer then
    !trimmer = 'YES'
     else
    !trimmer = 'NO'
     endif


  !columns[1] = ARRAY()
  !columns[2] = ARRAY()
  !columns[1].append(!typeHead.trim())
  !columns[1].append(!stdHead.trim())
  !columns[1].append(!discHead.trim())
  !columns[1].append(!sizeHead.trim())
  !columns[1].append(!commHead.trim())
  !columns[1].append(!adpLocHead.trim())
  !columns[1].append(!adpFlipHead.trim())
  !columns[1].append(!trimHead.trim())

  !columns[2].append(!type)
  !columns[2].append(!std )
  !columns[2].append(!disc )
  !columns[2].append(!size )
  !columns[2].append(!comment )
  !columns[2].append(!adpLoc )
  !columns[2].append(!adpFlip )
  !columns[2].append(!trimmer )

  !this.suppData.setColumns(!columns)

     -- set list of sections
  !this.listSctn()

     -- set list of ancillaries
  !this.listAncil()


     -- set ADP Drawlist
  !this.adpDrawlist(!main,!this.adpDrawlist)

     -- update data subform only if support is a hanger or single ancillary
     -- otherwise it goes through !this.listAncil() method
  if !this.support.type.eq('ATTA') then
    !this.showData(!this.support)
     endif

 endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .emptyAll()

  !dtext[1] = 'None'

      !this.support = nulref
  !this.atta.clear()
  !this.sctn.clear()
      !this.name.val = ''
      !this.group.val = 'Group'
  !this.section.clear()
  !this.ancil.clear()
  !this.adpDrawlist.clear()
  !this.suppData.clear()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .listSctn()

  if !this.sctn.unset() then
    !dtext[1] = 'None'
    !this.section.dtext = !dtext
    return
  endif

  !name = ARRAY()
  !spre = ARRAY()
  !matr = ARRAY()
  !dtext = ARRAY()

  !suppName = !this.support.name

  do !sctnref values !this.sctn
    !name.append(!sctnref.name.after(!suppName).substring(2))
    !spre.append(!sctnref.prop.desc)
    handle ANY
      !spre.append(!sctnref.spre.namn.after('/'))
          endhandle
        if !sctnref.matr.badref() then
      !matr.append('unset')
        else
      !matr.append(!sctnref.matr.:MDSMatCode)
        endif
    enddo


  !add = 0
  !columns[1] = !name
  !columns[2] = !spre
  !columns[3] = !matr
  !this.section.setColumns(!columns)


  !indx = !this.sctn.findFirst(!!ce)
  if !indx.set() then
    !this.section.val = !indx + !add
    handle ANY
    endhandle
  endif


endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .listAncil()

  !dtext = ARRAY()
  if !this.support.type.neq('STRU') then
    !dtext[1] = 'None'
    !this.ancil.dtext = !dtext
    return
  endif

  !suppName = !this.support.name

  !name = ARRAY()
  !code = ARRAY()
  !mtoc = ARRAY()
  !matr = ARRAY()
  !pipeMat = ARRAY()
  !insu = ARRAY()
  !temp = ARRAY()

-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
  -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref

     -- extract data from ancillaries
  do !attaRef values !this.atta
    !matrefAtt = !!mdsUseMatref(!attaRef)
    !name.append(!attaRef.name.after(!suppName).substring(2))
    !code.append(!this.getCode(!attaRef))
    !mtoc.append(!attaRef.mtoc)
    if !matrefAtt.eq('UDA') then
      !matr.append(!attaRef.:MDSMatref.:MDSMatCode)
      handle ANY
        !matr.append('unset')
      endhandle
    else
      !matr.append(!attaRef.matref.:MDSMatCode)
      handle ANY
        !matr.append('unset')
      endhandle
    endif
    !pipeMat.append(!attaRef.owne.pspe.:MDSPipeMat)
    if !attaRef.ispe.badref().not() then
      !insu.append('YES')
    else
      !insu.append('NO')
    endif
    !temp.append(!attaRef.owne.temp.string('d0'))
  enddo

  if !name.unset() then
    !dtext[1] = 'None'
    !this.ancil.dtext = !dtext
    return
  endif

  !add = 0
  !columns[1] = !name
  !columns[2] = !code
  !columns[3] = !mtoc
  !columns[4] = !matr
  !columns[5] = !pipeMat
  !columns[6] = !insu
  !this.ancil.setColumns(!columns)


  !attaIndx = !this.atta.findFirst(!!ce)
  if !attaIndx.unset() then
    !attaIndx = 1
  endif

  !this.ancil.val = !attaIndx + !add
  handle NONE
    !this.showData(!this.atta[!attaIndx])
  elsehandle ANY
    !this.showData(worl)
  endhandle

endmethod

----------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------

define method .setCodes(!menu is MENU,!action is STRING)

     if !menu.pickedfield.eq('MDS Codes') then
    !this.mdsCode = true
    !this.file.select('MDS Codes',true)
    !this.file.select('Client Codes',false)
     else
    !this.mdsCode = false
    !this.file.select('MDS Codes',false)
    !this.file.select('Client Codes',true)
  endif

  if !this.support.badref() then
    return
  endif

  !dtext = !this.suppData.dtext
  !std = !this.getCode(!this.support)
  !dtext[2] = !dtext[2].before(':') + ': ' + !std

  !this.suppData.dtext = !dtext

  !this.listAncil()

endmethod

----------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------

define method .getDiscipline() is STRING

  !result = STRING()
  !suppName = !this.support.name

--<kp>feb07 Support lighting functionality added
     if !this.support.type.eq('STRU') then
    if !this.support.:Mdssupptype.eq(!!mdslsuppdefs.type).and(!!mdslsuppdefs.error.unset()) then
           return 'LIGHTING'
        endif
     endif

  !purp = ARRAY()

  !attas = !this.getAtta()
  do !atta values !attas
    !stext = stext of text 1 of pspe of owner of $!atta
    if !stext.neq('PIPING') then
      !stext = !atta.owner.pspe.purp
    endif
    !purp.append(!stext)
  enddo

  !purp.unique()

  if !purp.size().gt(1) then
    !result = 'MULTI'
  elseif !purp.size().eq(1) then
    if !purp[1].eq('TRAY') then
      !result = 'CABLE'
    else
      !result = !purp[1]
    endif
  endif


  return !result

endmethod

----------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------
define method .getAtta() is ARRAY

  !result = ARRAY()

  if !this.support.type.eq('ATTA') then
    !result[1] = !this.support
    return !result
  endif

  !suppName = !this.support.name

  !atta = object DBREF(!suppName + '/DATUM')
  handle NONE
    if !atta.type.eq('ATTA') then
      !result[1] = !atta
    endif
  elsehandle ANY
  endhandle

  do !c from 1 to 50
    !atta = object DBREF(!suppName + '.' & !c)
           handle ANY
             skip
           endhandle
    skip if !atta.type.neq('ATTA')
    !result.append(!atta)
     enddo

  return !result

  endmethod

----------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------

define method .active(!onOff is BOOLEAN)

  !this.setActive(!onOff)
  if !onOff.not() then
    !this.dismiss.active = true
    !this.update.active = true
    !this.bar.setActive('Display',true)
  endif

endmethod

----------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------

define method .getCode(!support is DBREF) is STRING

  !code = ''
  !from = 'UDA'
  if !support.type.eq('ATTA') then
    if !support.cref.badref() then
      !from = 'STYP'
    endif
  endif


  if !from.eq('UDA') then
    !mdsCode = !support.:MDSSuppType
--<kp>feb07 lighting supports
    if !mdsCode.eq(!!mdslsuppdefs.type).and(!!mdslsuppdefs.error.unset()) then
      !code = !!mdslsuppdefs.suppcode.evaluate(!support)
               handle ANY
        !code = !!mdslsuppdefs.replacetype
               endhandle
      return !code
    endif
    --<kp>feb07
  else
    !mdsCode = !support.styp
  endif

  if !mdsCode.eq('SPECIAL') then
         return ''
      endif


  if !this.mdsCode then
    !code = !mdsCode
      else
    !code = 'code' + !mdsCode
    !code = !!$!code
    handle ANY
      !code = !mdsCode
    endhandle
  endif


  return !code

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------

define method .adpDrawlist(!atta is DBREF,!list is GADGET)

  !dtext = ARRAY()

  do !item values !atta.:MdsAdp
    skip if !item.badref()
    !dtext.append(!item.namtyp)

  enddo

  if !dtext.unset() then
    return
  endif

  !list.dtext = !dtext

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------

define method .data()

  loadform !!mdsSuppInfoData

  if !!mdsSuppInfoData.shown().not() then
    !!mdsSuppInfoData.show('FREE')
    !this.pickAncil()
  else
    !!mdsSuppInfoData.hide()
  endif

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------

define method .showData(!atta is DBREF)

  if undefined(!!mdsSuppInfoData) then
    return
  endif

  if !!mdsSuppInfoData.shown().not() then
    return
  endif


  if !atta.type.neq('ATTA') then
    !!mdsSuppInfoData.data.clear()
    !!mdsSuppInfoData.data.active = false
    !!mdsSuppInfoData.formTitle = 'Data'
    return
  else
    !!mdsSuppInfoData.data.active = true
  endif

  !calcNo  = !atta.:MdsCalcNo
  !config  = !atta.:MdsConfig
  !nodeNo  = !atta.:MdsNodeNo
  !temp    = !atta.owner.temp.string()
  !load    = !atta.:Mdsload.string()
  !forceX  = !atta.:MdsForceX.string()
  !forceY  = !atta.:MdsForceY.string()
  !forceZ  = !atta.:MdsForceZ.string()
  !moveX   = !atta.:MdsMoveX.string()
  !moveY   = !atta.:MdsMoveY.string()
  !moveZ   = !atta.:MdsMoveZ.string()
  !hload   = !atta.:MdsHload.string()
  !atn     = !atta.:MdsAtn.string()
  !ate     = !atta.:MdsAte.string()
  !aen     = !atta.:MdsAen.string()
  !aee     = !atta.:MdsAee.string()
  !suppF   = !atta.:MdsSuppFunc



  !columns[1] = ARRAY()
  !columns[2] = ARRAY()
  !columns[1][1]   = 'Stress Calc. No.'
  !columns[1][2]   = 'Configuration'
  !columns[1][3]   = 'Node No.'
  !columns[1][4]   = 'Temperature'
  !columns[1][5]   = 'Load'
  !columns[1][6]   = 'Force X'
  !columns[1][7]   = 'Force Y'
  !columns[1][8]   = 'Force Z'
  !columns[1][9]   = 'Movement X'
  !columns[1][10]  = 'Movement Y'
  !columns[1][11]  = 'Movement Z'
  !columns[1][12]  = 'Hydraulic Load'
  !columns[1][13]  = 'AT North'
  !columns[1][14]  = 'AT East'
  !columns[1][15]  = 'AE North'
  !columns[1][16]  = 'AE East'
  !columns[1][17]  = 'Support Function'

  !columns[2][1]   = !calcNo
  !columns[2][2]   = !config
  !columns[2][3]   = !nodeNo
  !columns[2][4]   = !temp
  !columns[2][5]   = !load
  !columns[2][6]   = !forceX
  !columns[2][7]   = !forceY
  !columns[2][8]   = !forceZ
  !columns[2][9]   = !moveX
  !columns[2][10]  = !moveY
  !columns[2][11]  = !moveZ
  !columns[2][12]  = !hload
  !columns[2][13]  = !atn
  !columns[2][14]  = !ate
  !columns[2][15]  = !aen
  !columns[2][16]  = !aee
  !columns[2][17]  = !suppF

  !!mdsSuppInfoData.data.setColumns(!columns)


  !!mdsSuppInfoData.formTitle = 'Data of ' + !atta.name

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------

define method .hideData()

  !!mdsSuppInfoData.hide()
  handle ANY
  endhandle

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------

define method .pickAncil()

        if !this.atta.unset() then
           return
        endif

  if !this.support.type.eq('ATTA') then
    !this.showData(!this.support)
           return
        endif

  !firstLine = 1
  !rem = 0

  !line = !this.ancil.val
  if !line.lt(!firstLine) then
    !this.ancil.val = !firstLine
    !line = !firstLine
  endif

  !atta = !this.atta[!line - !rem]

  !this.showData(!atta)

endmethod

------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------
