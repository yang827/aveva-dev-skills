-- Define Form
setup Form !!mdstestweldapp
  init '!this.init()'
bar
!this.bar.add('Weld Forms','menu1')

menu .menu1
!this.menu1.add('Form','Create STD   Welds','mdsSTDWElds')
--!this.menu1.add('Form','Create ATTA  Welds','mdscreatestdweld')
!this.menu1.add('Form','Create FRAME Welds','mdsframewelds')
--!this.menu1.add('Form','Create DES Welds','mdscreatedesweld')
!this.menu1.add('Form','Create ancil Welds','mdsancilwelds')


  exit

 define method .init()


 endmethod
