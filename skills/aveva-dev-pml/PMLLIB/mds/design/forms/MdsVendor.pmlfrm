--------------------------------------------------------------------------------
--
-- File:    MdsVendor.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Wed Oct 29 2003
--
--
-- Description:
-- Form Definition for interface to vendor software
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildHanger(STRING)              -
--  cancel()                         -
--  clear()                          -
--  init()                           -
--  isparallel(DBREF,DIRECTION)      BOOLEAN
--  oKmethod()                       -
--  steel()                          -
--  steelmod()                       -
--  unitsmm()                        -
--

-- Kill existing form definition

Kill !!mdsVendor

-- Define Form

setup form  !!mdsVendor noquit

  !!mdsVendor.icontitle    = ||
  !!mdsVendor.callback     = ||
  !!mdsVendor.formrevision = ||
  !!mdsVendor.okcall       = |!this.oKmethod()|

  init '!this.init()'

  -- Body of Form

  -- Support name

  para .nameTag at x1 ymax+0.5  text ' Support Name:'
  para .name at xmax+2 ymin width 18 lines 1
  para .manlarge at y0 pixmap width 0 height 50
  path down

  -- Pipe frame

  frame .pipeframe ' VPD Piping Data ' at x0 ymax_manlarge

    -- Pipe size

    para .pipesizeTag at x1 ymax+0.5 text '      Pipe Bore:'
    para .pipesize at xmax+2 ymin width 14 lines 1
    para .pipesizeunit at xmax ymin text 'mm '

    -- Pipe temperature

    para .pipetempTag at x1 ymax text '    Temperature:'
    para .pipetemp at xmax+2 ymin width 14 lines 1
    para .pipetempunit at xmax ymin text 'C  '

    -- Pipe Insulation

    para .pipeinsuTag at x1 ymax text ' Insulation Thk:'
    para .pipeinsu at xmax+2 ymin width 14 lines 1
    para .pipeinsuunit at xmax ymin text 'mm '

    -- Pipe Coordinates

    para .pipexTag at x1 ymax    text '      Pipe East:'
    para .pipex at xmax+2 ymin width 14 lines 1
    para .pipexunit at xmax ymin text 'mm '

    -- Pipe Coordinates

    para .pipeyTag at x1 ymax    text '     Pipe North:'
    para .pipey at xmax+2 ymin width 14 lines 1
    para .pipeyunit at xmax ymin text 'mm '

    -- Pipe Coordinates

    para .pipezTag at x1 ymax    text ' Pipe Elevation:'
    para .pipez at xmax+2 ymin width 14 lines 1
    para .pipezunit at xmax ymin text 'mm '

    --<wd>25jan2006<mds12>
    --
    -- This FUNCTIONALITY is REDUNDANT for the MDS 12 Development
    -- Only Used with DES-SUPP-MATR default file and is NOT VISIBLE to USERS as
    -- this FORM !!mdsVendor is ALWAYS hidden to the USER during the MDS HANGER Interface!
    --
    -- Pipe Material

    --    para .pipematlTag at x1 ymax text '       Material:'
    --    para .pipematl at xmax+2 ymin width 15 lines 1
    --
    --<wd>25jan2006<mds12>

    -- Pipe Orientation

    para .pipeoriTag at x1 ymax text '    Orientation:'
    para .pipeori at xmax+2 ymin width 15 lines 1

  exit

  -- Support Data frame

  frame .frame1 ' Support Data ' at x0

    vdist 1.5

    -- Pipe Loadings

    frame .frame2 ' Operational Loads ' at x1

      rgroup .hotcold frame '' at x3 Ymax horizontal call ||
        add tag ' [Hot] ' select 'On'
        add tag ' [Cold] ' select 'Off'
      exit

      text .pipeload   '   Normal : ' at x1 Ymax+0.5 width 8 numeric
      para .pLkN at xmax+1 ymin text 'kN  '

      text .emergencyLoad   'Emergency : ' at x1 Ymax+0.5 width 8 numeric
      para .eLkN at xmax+1 ymin text 'kN  '
      text .failureLoad   '  Failure : ' at x1 Ymax+0.5 width 8 numeric
      para .fLkN at xmax+1 ymin text 'kN  '

    exit

    frame .frame3 ' Movements (mm) ' at x30 ymin.frame2

      -- Pipe Movement xyz

      text .pipexmovement at x1 ymin.pLkN  '    Mvm-Lateral: ' width 13 numeric
      para .x at xmax ymin text ' [+X]'
      text .pipeymovement at x1 Ymax+0.5  ' Mvm-Horizontal: ' width 13 numeric
      para .y at xmax+1 ymin text '[+Y]'
      text .pipezmovement at x1 Ymax+0.5  '   Mvm-Vertical: ' width 13 numeric
      para .z at xmax+1 ymin text '[+Z]'

    exit

  exit

  vdist 0.25

  -- Hanger frame

  frame .hangerframe ' VPD Hanger Data ' at x38 ymin.pipeframe

    -- Steel Connection_L

    para .steelTagL at x1 ymax+0.5 text '   Elevation 1:'
    para .steelTagEleL at xmax+2 ymin width 9 lines 1
    para .steelTagEleLunit at xmax ymin text 'mm '

    -- Steel Connection_R

    para .steelTagR at x1 ymax text '   Elevation 2:'
    para .steelTagEleR at xmax+2 ymin width 9 lines 1
    para .steelTagEleRunit at xmax ymin text 'mm '

    -- Steel Width

    para .steelWidth at x1 ymax  text '   Steel Width:'
    para .steelWidthVal at xmax+2 ymin width 9 lines 1
    para .steelWidthValunit at xmax ymin text 'mm '

    -- Steel Elevation

    para .steelXTag at x1 ymax    text '     Conn East:'
    para .steelX at xmax+2 ymin width 9 lines 1
    para .steelXunit at xmax ymin text 'mm '

    -- Steel Elevation

    para .steelYTag at x1 ymax    text '    Conn North:'
    para .steelY at xmax+2 ymin width 9 lines 1
    para .steelYunit at xmax ymin text 'mm '

    -- Steel Elevation

    para .steelZTag at x1 ymax    text 'Conn Elevation:'
    para .steelZ at xmax+2 ymin width 9 lines 1
    para .steelZunit at xmax ymin text 'mm '

    -- Hanger Connection

    para .steelConn at x1 ymax  text '     Conn Type:'
    para .steelConnType at xmax+2 ymin width 9 lines 1

    -- Hanger Type

    para .hangerType at x1 ymax  text '   Hanger Type:'
    para .hangerSelType at xmax+2 ymin width 9 lines 1

  exit

  -- Bottom Line

  button .ok      |   OK   | at x0 ymax+10  call |!this.oKmethod()|
  button .cancel  | Cancel | at xmax form-size ymax form-size call |!this.cancel()|

  -- Form Members

  --<wd>25jan2006<mds12>
  -- This FUNCTIONALITY is REDUNDANT for the MDS 12 Development
  --  member .defaultsfile is FILE
  --<wd>25jan2006<mds12
  member .size         is STRING
  member .attaori      is ARRAY
  member .steelMem     is ARRAY
  member .boresmm      is ARRAY
  member .ce           is DBREF
  member .jointrotate  is BOOLEAN
  member .type         is STRING
  member .flangewidth  is STRING
  member .flangethk    is STRING
  member .flangeHeight is STRING
  member .support      is MDSSUPPORT
  member .wpadmat      is DBREF
  -- End form definition

exit

-------------------------------------------------------------------------------
-- init method which is called on loading the form
-------------------------------------------------------------------------------

define method .init()

  --<wd>25jan2006<mds12>
  -- This FUNCTIONALITY is REDUNDANT for the MDS 12 Development
  --
  -- -- check to see if the defaults file exists.
  -- -- abort if not
  --   var !projCode proj code
  --   !this.defaultsfile = object FILE('%$!projCode$nDFLTS%/DES-SUPP-MATR')
  --   if !this.defaultsfile.exists().not() then
  --     !!alert.error('Defaults file %$!projCode$nDFLTS%/DES-SUPP-MATR does not exist' )
  --     return error 1 noalert
  --   endif
  --
  --<wd>25jan2006<mds12>

  if (!this.name.val.eq('unset')) then
    !!alert.error('The Name of the Hanger is unset' )
    !this.clear()
    return error 1 noalert
  endif

  --<wd>30oct2009 - DFN - P-25277 SI-17086 - Must LOAD the BORES by calling the FORM METHOD !this.unitsmm()
  !this.unitsmm()
  --<wd>30oct2009 - DFN - P-25277 SI-17086 - Must LOAD the BORES by calling the FORM METHOD !this.unitsmm()

  !this.ce = !!ce

  if (!!ce.stype.eq('MH01')) then

    -- In case the support is a vertical hanger and the atta has been repositioned via
    -- the distance or through buttons we need to reposition the tail of the hanger before
    -- sending the data to the manufacturers software

    -- Only do this if the :MdsDynOffset is unset and it is not a type 7 (dynamic)

    -------------------------------------------------------------------------------------------------------
    -------------------------------------------------------------------------------------------------------
    !defaulttpos = !this.ce.cref.tpos
    !!mdsReposTail(!this.ce,!defaulttpos)
    !!ce = !this.ce

    -------------------------------------------------------------------------------------------------------
    --<wd>28nov2006> The SYNTAX has already been changed for the FIX for HPD0033742 <GE> 15/11/06
    -- shown below by Neale Morris to --> !this.name.val = !!ce.namn

    -- Fix for HPD0033742 <GE> 15/11/06
    -- Used too remove slashes in support name
    --    !this.name.val = !!ce.name.replace('/','')
    !this.name.val = !!ce.namn

    -------------------------------------------------------------------------------------------------------
    !this.pipesize.val = !!ce.lbor.string().split('mm')[1]
    !this.size = !this.pipesize.val.split('mm')[1]
    !this.pipeinsu.val = !!ce.inth.string()
    !this.pipetemp.val = :FRA.temp of owner of owner
    handle ANY
      !this.pipetemp.val = !!ce.owner.temp.string()
    endhandle
    !positionWrtWorld = !!ce.position.wrt(/* )

    -- <RM> 02 Nov 06 <
    -- removed the rounding on the position to increase accuracy.
    --!this.pipex.val = !positionWrtWorld.east.nint().string()
    --!this.pipey.val = !positionWrtWorld.north.nint().string()
    --!this.pipez.val = !positionWrtWorld.up.nint().string()
    -- > <RM> 02 Nov 06
    !this.pipex.val = !positionWrtWorld.east.string()
    !this.pipey.val = !positionWrtWorld.north.string()
    !this.pipez.val = !positionWrtWorld.up.string()
    !this.pipeori.val = !!ce.adir.string().before(' ') & '/' & !!ce.ldir.string().before(' ')
    !this.attaori[1] = !!ce.ori.wrt(/* ).alpha.string()
    !this.attaori[2] = !!ce.ori.wrt(/* ).beta.string()
    !this.attaori[3] = !!ce.ori.wrt(/* ).gamma.string()
    !this.pipeload.val = !!ce.:MDSload.string()
    handle(2,752)(2,754)
      !this.pipeload.val = '0'
    endhandle
    !this.emergencyLoad.val = !!ce.cref.owner.:USTFORCES[2].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MdsELoad.string()
    endhandle
    !this.failureLoad.val = !!ce.cref.owner.:USTFORCES[3].string()
    handle(2,752)(2,754)
      !this.failureLoad.val = '0'
    elsehandle (99,532)
      !this.failureLoad.val = !!ce.:MdsFLoad.string()
    endhandle
    !this.pipexmovement.val = !!ce.:mdsMovex.string()
    !this.pipeymovement.val = !!ce.:mdsMovey.string()
    !this.pipezmovement.val = !!ce.:mdsMovez.string()
    --<wd>25jan2006<mds12>
    --    !this.pipematl.val = !this.getmaterialcode()
    --<wd>25jan2006<mds12>

    -- <RM> 11/08/08 added the test below because we have a new filter 600 which allows licad to create spring can type supports
    if (!!mdsFhanger.confignumber.string() NEQ '6') then
      if (!!mdsFhanger.confignumber.string() NEQ '600') then
        !this.hangerSelType.val = !!mdsFhanger.confignumber.string() & !this.type
        handle ANY
          !this.hangerSelType.val = !!ce.:MdsHconfig
        endhandle
      else
        !this.hangerSelType.val = '600'
      endif
    else
      !this.hangerSelType.val = '6'
    endif
    -- <RM> 11/08/08 end of fix

    !this.steelTagEleL.val = ''
    !this.steelTagEleR.val = ''

    --><wd>18aug2009 - DFN P-22111 (SI- 13209)
    -- Ensure the !this.steelMem array is set before calling the .steel() method
    if (!this.steelMem.empty()) then
      -- Copy the !!mdsfh01.support.rest.beamRefArray
      !this.steelMem = !!mdsfh01.support.rest.beamRefArray
    else
      !!ce = !this.ce
      if (!!ce.:MDSHConfig.eq('32V') and !this.steelMem.size().neq(4)) then
        -- Copy the !!mdsfh01.support.rest.beamRefArray
        !this.steelMem = !!mdsfh01.support.rest.beamRefArray
      endif
    endif
    --<<wd>18aug2009 - DFN P-22111 (SI- 13209)

    !this.steel()

    !this.unitsmm()
    !this.size = !this.boresmm[$!this.size]

    if (!this.pipetemp.val.real().value().string() eq '-100000') then
      !this.pipetemp.background = 2
    else
      !this.pipetemp.background = 205
    endif

    if (!this.pipeinsu.val eq '') then
      !this.pipeinsu.val = '0'
    endif

  endif

  $!this.ce
  if (!!ce.:MDSHConfig.neq('')) then
    -------------------------------------------------------------------------------------------------------
    --<wd>28nov2006> The SYNTAX has already been modified by Neale Morris as shown below  to --> !this.name.val = !!ce.namn

    -- Fix for HPD0033742 <GE> 15/11/06
    -- Used too remove slashes in support name
    --    !this.name.val = !!ce.name.replace('/','')
    !this.name.val = !!ce.namn

    --<wd>28nov2006>
    -------------------------------------------------------------------------------------------------------
    !this.pipesize.val = !!ce.lbor.string().split('mm')[1]
    !this.size = !this.pipesize.val.split('mm')[1]
    !this.pipeinsu.val = !!ce.inth.string()
    !this.pipetemp.val = :FRA.temp of owner of owner
    handle ANY
      !this.pipetemp.val = !!ce.owner.temp.string()
    endhandle
    !positionWrtWorld = !!ce.position.wrt(/* )
    !this.pipex.val = !positionWrtWorld.east.nint().string()
    !this.pipey.val = !positionWrtWorld.north.nint().string()
    !this.pipez.val = !positionWrtWorld.up.nint().string()
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
    --$p 1
    !this.steelZ.val = !this.steelTagEleL.val
    !this.pipeori.val = !!ce.adir.string().before(' ') & '/' & !!ce.ldir.string().before(' ')

    !this.attaori[1] = !!ce.ori.wrt(/* ).alpha.string()
    !this.attaori[2] = !!ce.ori.wrt(/* ).beta.string()
    !this.attaori[3] = !!ce.ori.wrt(/* ).gamma.string()

    --!this.pipeload.val = !!ce.cref.owner.:USTFORCES[1].string()
    !this.pipeload.val = !!ce.:MDSload.string()
    handle(2,752)(2,754)
      !this.pipeload.val = '0'
    endhandle
    !this.emergencyLoad.val = !!ce.cref.owner.:USTFORCES[2].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MdsELoad.string()
    endhandle
    !this.failureLoad.val = !!ce.cref.owner.:USTFORCES[3].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MdsFLoad.string()
    endhandle
    !restName = !!ce.name + '/REST'
    !xyz = :USTMOVEMENT of $!restName
    handle NONE
      !this.pipexmovement.val = !xyz[2].string()
      handle ANY
        !this.pipexmovement.val = '0'
      endhandle
      !this.pipeymovement.val = !xyz[1].string()
      handle ANY
        !this.pipeymovement.val = '0'
      endhandle
      !this.pipezmovement.val = !xyz[3].string()
      handle ANY
        !this.pipezmovement.val = '0'
      endhandle
    elsehandle ANY
      !this.pipexmovement.val = !!ce.:MdsMoveX.string()
      !this.pipeymovement.val = !!ce.:MdsMoveY.string()
      !this.pipezmovement.val = !!ce.:MdsMoveZ.string()
    endhandle

    --<wd>25jan2006<mds12>
    --    !this.pipematl.val = !this.getmaterialcode()
    --<wd>25jan2006<mds12>
    !this.hangerSelType.val = !!ce.:MDSHConfig.string()

    !this.steelmod()

    !this.unitsmm()
    !this.size = !this.boresmm[$!this.size]

    if (!this.pipetemp.val.real().value().string() eq '-100000') then
      !this.pipetemp.background = 2
    else
      !this.pipetemp.background = 205
    endif

    if (!this.pipeinsu.val eq '') then
      !this.pipeinsu.val = '0'
    endif

  endif

  -- Hide calling form


  !!mdsFhanger.hide()

  !!mdsFhanger.manifactions()
  !this.oKmethod()

  refresh

endmethod


-------------------------------------------------------------------------------------
-- method to determine steel elevations on creation
--------------------------------------------------------------------------------------

define method .steel()
  -- $P Config type is :- $!this.hangerSelType.val
  --<wd>23jul2004 -- Types -->'1V','18V','19V' added to list of inset

  -- <RM> 11/08/08 removed the '6' from the list below because the support was asking for elevations when it shouldn't have been
  --<wd>03nov2009 DFN P-26541 - SI-18252 Put BACK the reference to TYPE '6' in the IF statement as MDS-WH4 is NOT WORKING for this TYPE
  --  if (!this.hangerSelType.val inset ('1V','1H','7H','7V','18H','19H','18V','19V','20V','21V','25V','20H','21H','25H','18')) then

  if (!this.hangerSelType.val inset ('6','1V','1H','7H','7V','18H','19H','18V','19V','20V','21V','25V','20H','21H','25H','18')) then

    --<wd>03nov2009 DFN P-26541 - SI-18252 Put BACK the reference to TYPE '6' in the IF statement as MDS-WH4 is NOT WORKING for this TYPE
    -- <RM> 11/08/08
    -- Navigate to the ATTA created for the MDS HANGER
    $!this.ce
    !this.steelTagEleL.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
    !this.steelTagEleR.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()

    --<wd>22jul2004
    -- For VERTICAl PIPES GET the Position, <which will be the HANGER TPOS>,
    -- of the SCTN FITTING element created at the required TAIL Position of the MDS HANGER
    if (!this.hangerSelType.val inset ('1V')) then
      -- Get the Position of the FTTING element created for the MDS HANGER
      !fittname = !!ce.name & '/FITT/H1'
      !fitt = !fittname.dbref()
      !this.steelTagEleL.val  = !fitt.position.wrt(/* ).up.nint().string()
      !this.steelTagEleR.val  = !fitt.position.wrt(/* ).up.nint().string()
    endif
    --<wd>22jul2004


    -- If on a sloping line the elevation must come from the fitting/cmpf not the tpos
    --<wd>23jul2004 -- Types -->'18V','19V' added to list of insets below
    if (!this.hangerSelType.val inset ('18H','19H','18V','19V','18')) then
      !h1PtPos = !!ce.cref.tpos.wrt(/* )
      !this.steelTagEleL.val = !h1PtPos.up.string()
      !this.steelTagEleR.val = !h1PtPos.up.string()
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype
    handle ANY
      if (!this.hangerSelType.val inset ('18H','19H','18V','19V','18')) then
        -- Nothing to DO
      else
        !this.steelMem[1] = !!ce.cref.tref.owner
        !this.steelConnType.val = !this.steelMem[1].gtype
      endif
    endhandle
    !this.unitsmm()
    !odsize = !this.boresmm[$!this.size]
    if !!mdsHangIf.eq('CPL') then
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 20 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 20 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
      if (!this.hangerSelType.val inset ('18H','19H','18V','19V','18')) then
        -- The centreline dimension of the two rods can be calculated from the tails
        var !ctoc const dist pt of hang 1 of owner of cref to pt of hang 2 of owner of cref
        handle NONE
          !this.steelWidthVal.val = !ctoc
        elsehandle ANY
        endhandle
      endif
    else
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif
    if !this.hangerSelType.val inset ('7V','7H','20H','20V') then
      -- <RM> 02 Nov 06 <
      -- removed the rounding on the position to increase accuracy.
      --!this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
      --!this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
      --!this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.string()
      !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.string()
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.string()
      -- <RM> 02 Nov 06
      --$p 2
    else
      !this.steelX.val = !this.pipex.val
      !this.steelY.val = !this.pipey.val
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      --$P 3
    endif

    if (!this.hangerSelType.val inset ('18H','19H','18V','19V','18')) then
      -- NOTHING to DO
    else
      if ((!this.steelMem[1].gtype EQ 'BEAM') OR (!this.steelMem[1].gtype EQ 'DINI')) then
        !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
        handle(2,752)
        endhandle
        !this.flangethk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangethk = '0'
        endhandle
      elseif !this.steelMem[1].gtyp.eq('BOX') then
        !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
        handle(2,752)
        endhandle
        !this.flangethk = !this.steelMem[1].prop.xthk
        handle ANY
          !this.flangethk = '0'
        endhandle
      endif
    endif
  endif

  if (!this.hangerSelType.val inset ('2V','2H')) then

    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section1 = !this.steelMem[1]
    handle ANY
      !this.steelMem[1] = !!ce.cref.tref.owner
      !this.steelConnType.val = !this.steelMem[1].gtype
      !section1 = !this.steelMem[1]
    endhandle
    !section2 = !this.steelMem[2]
    handle ANY
      !this.steelMem[2] = !!ce.cref.tref.owner
      !this.steelConnType.val = !this.steelMem[2].gtype
      !section2 = !this.steelMem[2]
    endhandle
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)

    --<wd>12jul2004
    --    if (!x1.up.nint().real() gt !x2.up.nint().real()) then
    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      --!this.steelTagEleL.val = !x1.up.nint().string()
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      --!this.steelTagEleL.val = !x2.up.nint().string()
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif
    --<wd>12jul2004

    $!this.ce
    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelTagEleR.val = !this.steelTagEleL.val
    !this.unitsmm()
    !odsize = !this.boresmm[$!this.size]
    if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !this.steelWidthVal.val = !steelWidthVal1.nint().string()
    else
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
      if (!steelWidthVal1 GT !steelWidthVal2) then
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !this.steelWidthVal.val = !steelWidthVal2.nint().string()
      endif
    endif
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val


    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangethk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangethk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangethk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif

  endif

  ------------------------------------------------------------
  -- Two Hangers connected to one/two beams - HORIZONTAL
  ------------------------------------------------------------
  if (!this.hangerSelType.val inset ('31H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section = !this.steelMem[1]
    --<wd>16aug2004
    handle ANY
      -- In Modify mode
      !h1 = $!this.ce.name/H1
      !section1 = !h1.tref.owner
      !this.steelMem[1] = !section1
      !this.steelConnType.val = !this.steelMem[1].gtype
    elsehandle NONE
      -- In Create Mode
      !section1 = !section
    endhandle

    !section2 = !this.steelMem[3]
    handle ANY
      -- In Modify mode
      !h2 = $!this.ce.name/H2
      !section2 = !h2.tref.owner
      handle ANY
        !h2 = $!this.ce.name/FITT/H2
        !section2 = !h2.owner
      endhandle
      !this.steelMem[3] = !section2
      !this.steelConnType.val = !this.steelMem[3].gtype
    endhandle
    --<wd>16aug2004

    !u = 'U'
    !dir = !u.direction()

    --<wd>16aug2004
    --!x = !!kClosestPline(!section,!pos,!dir)
    !x = !!kClosestPline(!section1,!pos,!dir)
    --<wd>16aug2004
    !this.steelTagEleL.val = !x[2].up.nint().string()

    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line

    --!section = !this.steelMem[3]
    --<wd>16aug2004
    --handle ANY
    -- In Modify MODE
    !section2  = !this.steelMem[3]
    --elsehandle NONE
    --!section2 = !section
    --endhandle
    --<wd>16aug2004

    !u = 'U'
    !dir = !u.direction()

    --<wd>16aug2004

    --    !x = !!kClosestPline(!section,!pos,!dir)
    !x = !!kClosestPline(!section2,!pos,!dir)
    --<wd>16aug2004
    !this.steelTagEleR.val = !x[2].up.nint().string()

    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line

    !steelWidthVal = !dist[1].real() + !dist[2].real()
    !this.steelWidthVal.val = !steelWidthVal.string()
    if (!this.steelTagEleL.val.real() LE !this.steelTagEleR.val.real()) then
      !this.steelTagEleR.val = !this.steelTagEleL.val
      !this.steelTagEleL.val = !x[2].up.nint().string()
    endif

    if (!this.jointrotate) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    $!this.ce
    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
    handle(2,752)
    endhandle

    !this.flangethk = !this.steelMem[1].prop.flg
    handle ANY
      !this.flangethk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangethk = '0'
      endhandle
    endhandle
  endif

  ------------------------------------------------------------
  -- Two Hangers connected to one/two beams - VERTICAL
  ------------------------------------------------------------
  if (!this.hangerSelType.val inset ('31V')) then

    !this.steelMem[1] = !!ce.cref.tref.owner
    --  !this.steelMem[3] = !this.steelMem[1]
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section = !this.steelMem[1]

    --><wd>20aug2009 -- DFN P-22111 (SI-13209) -- The PML Code below COPIED from approximately line 683 for HORIZONTAL type '31H'
    handle ANY
      -- In Modify mode
      !h1 = $!this.ce.name/H1
      !section1 = !h1.tref.owner
      !this.steelMem[1] = !section1
      !this.steelConnType.val = !this.steelMem[1].gtype
    elsehandle NONE
      -- In Create Mode
      !section1 = !section
    endhandle

    !section2 = !this.steelMem[3]
    handle ANY
      -- In Modify mode
      !h2 = $!this.ce.name/H2
      !section2 = !h2.tref.owner
      handle ANY
        !h2 = $!this.ce.name/FITT/H2
        !section2 = !h2.owner
      endhandle
      !this.steelMem[3] = !section2
      !this.steelConnType.val = !this.steelMem[3].gtype
    endhandle

    -- UPDATE the form MDSFH01 support object member "!!mdsfh01.support.rest.beamRefArray
    !!mdsfh01.support.rest.beamRefArray = !this.steelMem
    --<<wd>20aug2009 -- The PML Code above COPIED from approximately line 683 for HORIZONTAL type '31H'

    !u = 'D'
    !dir = !u.direction()
    !x = !!kClosestPline(!section,!pos,!dir)
    !this.steelTagEleL.val = !x[2].up.nint().string()
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line
    !section = !this.steelMem[3]
    !u = 'D'
    !dir = !u.direction()
    !x = !!kClosestPline(!section,!pos,!dir)
    !this.steelTagEleR.val = !x[2].up.nint().string()
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line
    !steelWidthVal = !dist[1].real() + !dist[2].real()
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.steelMem[1] EQ !this.steelMem[3]) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
    handle(2,752)
    endhandle

    !this.flangethk = !this.steelMem[1].prop.flg
    handle ANY
      !this.flangethk = !this.steelMem[1].prop.xthk
      handle ANY
        !this.flangethk = '0'
      endhandle
    endhandle

  endif

  ---------------------------------------------------------------------
  -- Two Hangers connected to one/two Double Channel beams - HORIZONTAL
  ---------------------------------------------------------------------

  if(!this.hangerSelType.val inset ('32H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !h1 = $!this.ce.name/H1
    !this.steelMem[1] = !h1.tref.owner
    !h2 = $!this.ce.name/H2
    --><wd>20aug2009 - DFN P-22111 (SI-13209)
    handle NONE
      -- In MODIFY MOde
      !this.steelMem[2] = !h2.tref.owner

      !this.steelMem[3] = !this.steelMem[1]
      !this.steelMem[4] = !this.steelMem[2]
    elsehandle ANY
      -- In CREATE MODE
    endhandle
    --<<wd>20aug2009 - DFN P-22111 (SI-13209)

    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)
    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif
    $!section1
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line
    $!section2
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line
    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif
    $!section3
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[3] CONS DIST $!inter TO $!line
    $!section4
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[4] CONS DIST $!inter TO $!line
    !steelWidth2 = !dist[2].real()
    !steelWidth4 = !dist[4].real()
    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()
    if (!this.jointrotate) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangethk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangethk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangethk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif

  endif

  -------------------------------------------------------------------
  -- Two Hangers connected to one/two Double Channel beams - VERTICAL
  -------------------------------------------------------------------
  if(!this.hangerSelType.val inset ('32V')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)
    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif
    $!section1
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line
    $!section2
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line
    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif
    $!section3
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[3] CONS DIST $!inter TO $!line
    $!section4
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[4] CONS DIST $!inter TO $!line
    !steelWidth2 = !dist[2].real()
    !steelWidth4 = !dist[4].real()
    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()
    if (!this.steelMem[1] EQ !this.steelMem[3]) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif
    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val
  endif

  -- <RM> 11/08/08 added the test below because we have a new filter 600 which allows licad to create spring can type supports
  if (!this.hangerSelType.val inset ('6') or !this.hangerSelType.val inset ('600')) then
    $!this.ce
    if !!mdsHangIf.eq('CPL') then
      -- !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      !odsize = !this.boresmm[$!this.size]
      --P-37906 do not reduce the pipez value by half the od of the pipe for vertical trunnions connecting to a type 6 spring pedestal support
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
      --i have tried to minimise the impact of this by doing the following
      --1) restricting to !!mdsHangIf = CPL only
      --2) ensuring that the atta pipe is a trunnion
      --3) ensuring that the atta pipe is vertical
      --4) ensuring that the config type is 6
      if !!mdsHangIf.eq('CPL') and !this.hangerSelType.val.eq('6') then
        !trunnion = !!ce.owner.:MDSTrun
        handle ANY
          !trunnion = FALSE
        endhandle

        if !trunnion and !!ce.ldir.up.gt(0.95) or !!ce.ldir.up.lt(-0.95) then
          !this.pipez.val = STRING(!this.pipez.val.real())
        else
          !this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
        endif
      else
        !this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
      endif
      --P-37906 do not reduce the pipez value by half the od of the pipe for vertical trunnions connecting to a type 6 spring pedestal support
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end
    elseif !!mdsHangIf.eq('PSL') then
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      --!odsize = !this.boresmm[$!this.size]
      --!this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
      --!this.pipez.val = !this.pipez.val
    else
      !this.steelTagEleL.val = !this.pipez.val
      !this.steelTagEleR.val = !this.pipez.val
      !this.steelConnType.val = 'ATTA'
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
      !this.steelX.val = !this.pipex.val
      !this.steelY.val = !this.pipey.val
      !this.steelZ.val = !this.pipez.val
    endif
  endif
  -- <RM> 11/08/08 end of fix

endmethod

-------------------------------------------------------------------------------------
-- method to determine steel elevations on modification
--------------------------------------------------------------------------------------

define method .steelmod()

  -- Reset flange thickness member to default
  -- NCM 31-01-06

  !this.flangeHeight = ''

  if (!this.hangerSelType.val inset ('1V','1H','7H','7V')) then

    -- Write the steel elevations, as bottom of steel unless
    -- :MdsDynOffset is set to a valid position. If so then
    -- the tail elevation

    $!this.ce
    !section = !!ce.cref.tref.owner
    !mdsDynOffset = !this.ce.cref.:MdsDynOffset

    if !mdsDynOffset.eq(0) then
      !this.steelTagEleL.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
      !this.steelTagEleR.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
    else
      -- need to do this section

      !unusedTestForUnset = !mdsDynOffset
      handle ANY
        !pos = !!ce.pos.wrt(/* )
        !section = !!ce.cref.tref.owner
        !u = 'U'
        !dir = !u.direction()
        !x = !!kClosestPline(!section,!pos,!dir)
        !this.steelTagEleL.val = !x[2].up.nint().string()
        !this.steelTagEleR.val = !x[2].up.nint().string()
      elsehandle NONE
        !this.steelTagEleL.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
        !this.steelTagEleR.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
      endhandle

    endif


    -- !this.steelConnType.val = !!ce.cref.tconn.string()
    !this.steelConnType.val = !section.gtype
    !this.unitsmm()
    !odsize = !this.boresmm[$!this.size]
    if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !this.steelWidthVal.val = !steelWidthVal1.nint().string()
    else
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
      if (!steelWidthVal1 GT !steelWidthVal2) then
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !this.steelWidthVal.val = !steelWidthVal2.nint().string()
      endif
    endif
    if (!this.hangerSelType.val inset ('7H','7V','20H','20V')) then
      !!ce = !this.ce
      !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
      !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      same
    else
      --!this.steelX.val = !x[2].east.nint().string()
      --!this.steelY.val = !x[2].north.nint().string()
      --!this.steelZ.val = !x[2].up.nint().string()
      !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
      !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
    endif

    if ((!section.gtype EQ 'BEAM') OR (!section.gtype EQ 'DINI')) then
      !this.flangewidth = !!mdsGetSctnWidth(!section).nint().string()
      handle(2,752)
      endhandle

      !this.flangethk = !section.prop.flg
      handle ANY
        !this.flangethk = !section.prop.xthk
        handle ANY
          !this.flangethk = '0'
        endhandle
      endhandle
    endif
  endif

  -- Dynamic hangers connected to civil panels
  if (!this.hangerSelType.val inset ('20H','20V')) then

    -- Write the steel elevations, as bottom of steel unless
    -- :MdsDynOffset is set to a valid position. If so then
    -- the tail elevation

    $!this.ce
    !this.steelTagEleL.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
    !this.steelTagEleR.val = !this.ce.cref.tpos.wrt(/* ).up.nint().string()
    !this.steelConnType.val = 'PANEL'
    !this.unitsmm()

    !odsize = !this.boresmm[$!this.size]
    if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !this.steelWidthVal.val = !steelWidthVal1.nint().string()
    else
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
      if (!steelWidthVal1 GT !steelWidthVal2) then
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !this.steelWidthVal.val = !steelWidthVal2.nint().string()
      endif
    endif
    !!ce = !this.ce
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
    same

    !this.flangewidth = '0'
    !this.flangethk = '0'

  endif

  if (!this.hangerSelType.val inset ('2V','2H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section = !!ce.cref.tref.owner
    !u = 'U'
    !dir = !u.direction()
    !x = !!kfarpline(!section,!pos,!dir)
    !this.steelTagEleL.val = !x[2].up.nint().string()
    $!this.ce
    !this.steelConnType.val = !section.gtype
    !this.steelTagEleR.val = !this.steelTagEleL.val
    !this.unitsmm()
    !odsize = !this.boresmm[$!this.size]
    if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !this.steelWidthVal.val = !steelWidthVal1.nint().string()
    else
      !factor = 10 * !odsize.real().power(-0.3)
      !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
      !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
      if (!steelWidthVal1 GT !steelWidthVal2) then
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !this.steelWidthVal.val = !steelWidthVal2.nint().string()
      endif
    endif
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val
    !this.flangewidth = '0'
    !this.flangethk = '0'

    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangethk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangethk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangethk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif
    -- Pass the beam height to WitchHanger so it stops the can clashing
    -- with the steel for pipe to two channels
    -- NCM 31-01-06
    if !!mdsHangIf.eq('CPL') then
      !this.flangeHeight = !this.steelMem[1].prop.dept
      handle ANY
        !this.flangeHeight = '100'
      endhandle
    endif
  endif

  if (!this.hangerSelType.val inset ('31H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !h1 = $!this.ce.name/H1
    !h2 = $!this.ce.name/H2
    --><wd>13nov2009 - DFN P-25277 (SI-17086)
    handle ANY
      -- HANGER $!this.ce.name/H2 - DOES NOT EXIST
      !section1 = !this.steelMem[1]
      !section2 = !this.steelMem[3]
    elsehandle NONE
      --<<wd>13nov2009 - DFN P-25277 (SI-17086)

      !section1 = !h1.tref.owner
      !section2 = !h2.tref.owner
      handle ANY
        !section2 = !h1.tref.owner
        handle ANY
          !h2 = $!this.ce.name/FITT/H1
          !section2 = !h2.owner
        endhandle
      endhandle

      --><wd>13nov2009 - DFN P-25277 (SI-17086)
    endhandle
    --<<wd>13nov2009 - DFN P-25277 (SI-17086)

    --!section1 = !h1.tref.owner
    --!section2 = !h2.tref.owner
    --handle ANY
    --  !h2 = $!this.ce.name/FITT/H1
    --  !section2 = !h2.owner
    --endhandle

    !u = 'U'
    !dir = !u.direction()
    !x = !!kClosestPline(!section1,!pos,!dir)
    !this.steelTagEleR.val = !x[2].up.nint().string()

    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line

    !u = 'U'
    !dir = !u.direction()
    !x = !!kClosestPline(!section2,!pos,!dir)

    !this.steelTagEleL.val = !x[2].up.nint().string()
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line
    !steelWidthVal = !dist[1].real() + !dist[2].real()
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.jointrotate) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    $!this.ce
    !this.steelConnType.val = !section1.gtype
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    !flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
    handle(2,752)
    endhandle

    !flangethk = !this.steelMem[1].prop.flg
    handle ANY
      !flangethk = !this.steelMem[1].prop.xthk
      handle ANY
        !flangethk = '0'
      endhandle
    endhandle
  endif

  if (!this.hangerSelType.val inset ('31V')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section = !this.steelMem[1]
    !u = 'U'
    !dir = !u.direction()
    !x = !!kClosestPline(!section,!pos,!dir)

    !this.steelTagEleL.val = !x[2].up.nint().string()
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line
    !steelMem = !this.steelMem
    !steelMem.sortunique()
    if !steelMem[2].badref() then
      !section = !steelMem[1]
      !otherMem = !steelMem[1]
    else
      !section = !steelMem[1]
      !otherMem = !steelMem[2]
    endif
    !u = 'U'
    !dir = !u.direction()
    !x = !!kClosestPline(!section,!pos,!dir)
    !this.steelTagEleR.val = !x[2].up.nint().string()
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line
    !steelWidthVal = !dist[1].real() + !dist[2].real()
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!steelMem[1] EQ !otherMem) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    !flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
    handle(2,752)
    endhandle

    !flangethk = !this.steelMem[1].prop.flg
    handle ANY
      !flangethk = !this.steelMem[1].prop.xthk
      handle ANY
        !flangethk = '0'
      endhandle
    endhandle

  endif
  -- End of 31V

  if(!this.hangerSelType.val inset ('32H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)

    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif

    $!section1
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line

    $!section2
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line

    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif

    $!section3
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[3] CONS DIST $!inter TO $!line

    $!section4
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[4] CONS DIST $!inter TO $!line

    !steelWidth2 = !dist[2].real()
    --  !steelWidth2 = (!dist[2].real() + ((!dist[1].real() - !dist[2].real())/ 2 ))
    --  !steelWidth4 = (!dist[4].real() + ((!dist[4].real() - !dist[3].real())/ 2 ))
    !steelWidth4 = !dist[4].real()

    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.jointrotate) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangewidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangethk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangethk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangethk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif
  endif

  if(!this.hangerSelType.val inset ('32V')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !h1 = $!this.ce.name/H1
    !h2 = $!this.ce.name/H2
    --><wd>18aug2009 - DFN P-2211 (SI-13209)
    handle ANY
      -- HANGER $!this.ce.name/H2 - DOES NOT EXIST
      !section1 = !this.steelMem[1]
      !section2 = !this.steelMem[2]
    elsehandle NONE
      --<<wd>18aug2009 - DFN P-2211 (SI-13209)

      !section1 = !h1.tref.owner
      !section2 = !h2.tref.owner
      handle ANY
        !section2 = !h1.tref.owner
      endhandle

      --><wd>18aug2009 - DFN P-2211 (SI-13209)
    endhandle
    --<<wd>18aug2009 - DFN P-2211 (SI-13209)
    --!section1 = !this.steelMem[1]
    --!section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)

    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif

    $!section1
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[1] CONS DIST $!inter TO $!line

    $!section2
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[2] CONS DIST $!inter TO $!line

    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif

    $!section3
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[3] CONS DIST $!inter TO $!line

    $!section4
    VAR !datumLine CONS Line $!dir THRO $!pos
    VAR !start POSS WRT WORLD
    VAR !end POSE WRT WORLD
    VAR !line CONS LINE JOIN $!start to $!end
    VAR !inter CONS POS INTER $!datumLine $!line
    VAR !dist[4] CONS DIST $!inter TO $!line

    !steelWidth2 = !dist[2].real()
    --  !steelWidth2 = (!dist[2].real() + ((!dist[1].real() - !dist[2].real())/ 2 ))
    --  !steelWidth4 = (!dist[4].real() + ((!dist[4].real() - !dist[3].real())/ 2 ))
    !steelWidth4 = !dist[4].real()

    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.steelMem[1] EQ !this.steelMem[3]) then
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

  endif

  -- <RM> 11/08/08 added the test below because we have a new filter 600 which allows licad to create spring can type supports
  if (!this.hangerSelType.val inset ('6') or !this.hangerSelType.val inset ('600')) then
    $!this.ce
    if !!mdsHangIf.eq('CPL') then
      -- !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      !odsize = !this.boresmm[$!this.size]
      --P-37906 do not reduce the pipez value by half the od of the pipe for vertical trunnions connecting to a type 6 spring pedestal support
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
      --i have tried to minimise the impact of this by doing the following
      --1) restricting to !!mdsHangIf = CPL only
      --2) ensuring that the atta pipe is a trunnion
      --3) ensuring that the atta pipe is vertical
      --4) ensuring that the config type is 6
      if !!mdsHangIf.eq('CPL') and !this.hangerSelType.val.eq('6') then
        !trunnion = !!ce.owner.:MDSTrun
        handle ANY
          !trunnion = FALSE
        endhandle

        if !trunnion and !!ce.ldir.up.gt(0.95) or !!ce.ldir.up.lt(-0.95) then
          !this.pipez.val = STRING(!this.pipez.val.real())
        else
          !this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
        endif
      else
        !this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
      endif
      --P-37906 do not reduce the pipez value by half the od of the pipe for vertical trunnions connecting to a type 6 spring pedestal support
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end
    elseif !!mdsHangIf.eq('PSL') then
      !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
      --!odsize = !this.boresmm[$!this.size]
      --!this.pipez.val = STRING(!this.pipez.val.real() - !odsize.real() / 2)
    else
      !this.steelTagEleL.val = !this.pipez.val
      !this.steelTagEleR.val = !this.pipez.val
      -- !this.steelConnType.val = !!ce.cref.tconn.string()
      !this.steelConnType.val = 'ATTA'
      !this.unitsmm()
      !odsize = !this.boresmm[$!this.size]
      if ((undefined(!this.pipeinsu.val)) OR !this.pipeinsu.val.eq('')) then
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odsize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odsize.real()) + 60)
        !steelWidthVal2 = ((!odsize.real()) + !this.pipeinsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
      !this.steelX.val = !this.pipex.val
      !this.steelY.val = !this.pipey.val
      !this.steelZ.val = !this.pipez.val
    endif
  endif
  -- <RM> 11/08/08 end of fix

  if (!this.hangerSelType.val inset ('7H','7V','20H','20V')) then
    !this.steelX.val = !this.ce.cref.tpos.wrt(/* ).east.string()
    !this.steelY.val = !this.ce.cref.tpos.wrt(/* ).north.string()
    !this.steelZ.val = !this.ce.cref.tpos.wrt(/* ).up.string()
  endif

endmethod

-------------------------------------------------------------------------------------
-- method to read the material defaults file and get the appropriate material values
-- uses the :MDSPipeMat of pspe of host pipe
--------------------------------------------------------------------------------------
--
--<wd>25jan2006<mds12>
-- This FUNCTIONALITY is REDUNDANT for the MDS 12 Development
--
-- define method .getmaterialcode() is STRING
--
--   !matcode =  :MDSPipeMat of pspe of bran
--   if !matcode eq '' then
--     !return = 'Undefined'
--   else
--     !return = 'Not Found'
--   endif
--
--   -- read defaults file from mdsdflts
--
--   !matlines = !this.defaultsfile.readfile()
--
--   -- find the material
--
--   do !a index !matlines
--     !matlines[!a] = !matlines[!a].trim()
--     if !matlines[!a].substring(1,1) eq '#' then $* its a comment line so skip
--       skip
--     endif
--     if !matlines[!a].match(!matcode & '\') eq 1 then
--       !return = !matlines[!a].after('\')
--       break
--     endif
--   enddo
--
--   return !return
--
-- endmethod
--
--
--<wd>25jan2006<mds12>
-------------------------------------------------------------------------------------
-- method to write input file (supportname.lif) to directory located in environment
-- variable project name \lif for support design in external software
-------------------------------------------------------------------------------------

define method .oKmethod()

  -- <RM 03/02/09> moved this test to the start from the sloping line code so that the variable is available everywhere
  !configtype = !this.hangerSelType.val.string()
  !dynamictypes = '7,21,20,25'
  if !dynamictypes.match(!configtype.before('H').before('V')).gt(0) then
    !dynamictype = TRUE
  else
    !dynamictype = FALSE
  endif
  -- <RM 03/02/09> end

  -- Clear the line shown with the offset form

  !!mdsDynOffset.close()
  !pipeDirection = ''
  -- Set the Atta UDA's that store the MDS data

  $!this.ce
  !!ce.:mdsload = !this.pipeload.val.real()
  !!ce.:mdsMovex = !this.pipexmovement.val.real()
  !!ce.:mdsMovey = !this.pipeymovement.val.real()
  !!ce.:mdsMovez = !this.pipezmovement.val.real()
  !!ce.:MDSHConfig = !this.hangerSelType.val.string()
  -- dtf >>> 5.12.05 we need to test if hh to ht direction id the same as the leave of atta
  !dynamicparallel =  FALSE
  !yoffset = !!mdsDynOffset.offsety.val
  handle ANY
    !yoffset = 0
  endhandle
  --if !yoffset.eq(0) then
  !directions = !!mdsremovegrad(!this.ce)
  if !!mdsfh01.support.tdir.set() then
    if !directions[1].eq(!!mdsfh01.support.tdir) or !directions[1].eq(!!mdsfh01.support.tdir.opposite()) then
      !dynamicparallel =  TRUE
    elseif !directions[1].angle(!!mdsfh01.support.tdir).gt(179.9) and !directions[1].angle(!!mdsfh01.support.tdir).lt(180.1) then
      !dynamicparallel =  TRUE
    elseif !directions[1].angle(!!mdsfh01.support.tdir).gt(-0.1) and !directions[1].angle(!!mdsfh01.support.tdir).lt(0.1) then
      !dynamicparallel =  TRUE
    endif
    -- <RM> 11/08/08 set the pldir explicitly because it was not passing through set in some cases
    !pldir = ldir
    -- <RM> 11/08/08 end of fix
    if !pldir.angle(U).gt(179) and !pldir.angle(U).lt(181) then
      !pipeDirection = 'VERTICAL'
    elseif !pldir.angle(U).gt(-1) and !pldir.angle(U).lt(1) then
      !pipeDirection = 'VERTICAL'
    else
      !pipeDirection = 'HORIZONTAL'
    endif
  endif
  --endif
  -- dtf <<<
  -- Make sure the support.tdir and support.tposition is set
  !nameOfAtta = !!ce.name
  !!mdsfh01.support.tdir = tdir of $!nameOfAtta/H1 wrt /*
  --><wd>20aug2009 -- DFN P-22111 (SI-13209)
  if (!!mdsHangIf.eq('CPL') and !!mdsfh01.support.datum.:MDSHConfig.matchwild('32?')or !!mdsfh01.support.datum.:MDSHConfig.matchwild('31?') or !!mdsfh01.support.datum.:MDSHConfig.eq('2H')) then
    -- MDS-CPL Witch Hanger Support Types '2H','31H', '31V', '32H' and '32V' will always have the !!mdsfh01.support.tdir set to "D wrt /*"
    !!mdsfh01.support.tdir = D wrt /*
  endif
  --<<wd>20aug2009 -- DFN P-22111 (SI-13209)

  !yoffset = !!mdsDynOffset.offsety.val
  handle ANY
    !yoffset = 0
  endhandle
  if !dynamicparallel.not()  then
    !!mdsfh01.support.tposition = tposition of $!nameOfAtta/H1 wrt /*
  endif
  --q var !!mdsfh01.support.tdir  !!mdsfh01.support.tposition

  -- Pass the angle of the pipe to the manufacturers program

  !pldir = ldir
  if !pldir.up.eq(0) then
    -- Horizontal Pipe
    -- Test to see if pipe parallel to wall / floor etc
    !paralleltest = !!mdsGetMoveDir(!!ce,'CREATE')
    if !paralleltest[1].not() then
      -- if not parallel we may need to send angle to lisega
      if !paralleltest[3].eq(180) then
        !pipeAngle = 0
      else
        !pipeAngle = !paralleltest[3]
      endif
    else
      !pipeAngle = 0
    endif
  elseif !pldir.up.abs().eq(1) then
    -- Vertical Pipe
    !pipeAngle = 90
  else
    -- Sloping line get the angle
    var !grad  pl grad
    -- Test to see if pipe parallel to wall / floor etc
    !paralleltest = !!mdsGetMoveDir(!!ce,'CREATE')
    if !paralleltest[1].not() and !paralleltest[3].neq(0) and !dynamictype then
      -- if not parallel we may need to send angle to lisega
      if !dynamicparallel then
        !parallelangle = !this.ce.ldir.angle(!!mdsfh01.support.tdir)
        if !parallelangle.gt(90) then
          !parallelangle =  180 - !parallelangle
        endif
        pin 1 at $!this.ce
        pin 1 dir $!pldir
        !tpos = !!mdsfh01.support.tposition
        pin 1 plane pin 1 thr $!tpos
        pin 2 at $!this.ce
        --pin 2 at $!tpos
        var !pin1pos pin 1 pos wrt world
        var !pin2pos pin 2 pos wrt world
        if !pin1pos.position().wrt( /* ).up.gt(!pin2pos.position().wrt( /* ).up ) then
          !parallelangle = !parallelangle * -1
        endif
        -- if atta rotated
        if !directions[3].eq(D) then

        elseif !directions[3].eq(U) then
          !parallelangle = !parallelangle * -1
        else
          !parallelangle = 0
        endif
        !pipeAngle = !paralleltest[3] + !parallelangle
        --!pipeAngle = !parallelangle
      else
        !pipeAngle1 = !paralleltest[3]
        -- >>> dtfx 1.02.06 all removed to pass correct anglr + or - to interfaces
        -- >>> dtf 11.01.06 temp fix because licad does not like angles nearly 90
        --if !pipeAngle.gt(89.9) and !pipeAngle.lt(90.1) then
        --  !pipeAngle = 90
        --endif
        -- dtf <<< end of fix
        if !pipeAngle1.gt(90) then
          !pipeAngle1 = (180 - !pipeAngle1 )
          --!pipeAngle1 = (!pipeAngle1 - 180 )
        endif
        -- <<< dtfx end of mod

        -- alteration to ensure that the correct angle between roof and pipe is passed
        -- for slope gradients greater than the default Richard Martin [11/08/06]
        if !!mdsgradient($!this.ce) then
          !pipeAngle = !pipeAngle1
        else
          !pipeAngle = !directions[1].angle(!!ce.ldir)
        endif
        if !pipeAngle1.gt(!pipeAngle) then
          !pipeAngle = !pipeAngle1
        else
          if !!ce.ldir.up.gt(0) then
            -- pipe sloping up
            !pipeAngle = !pipeAngle * -1
          endif
        endif

      endif
      --q var !pipeAngle

    elseif !paralleltest[1] and ( !!ce.cref.tdir.up.neq(-1) and !!ce.cref.tdir.up.neq(1) ) then
      -- horizontal support !
      !pipeAngle = 0

    else
      var !pipeAngle ( abs ( atan( 1 / $!grad) ) )
    endif

    --!pipeAngle = !!ce.ldir.string().after(' ').before(' ').real()
  endif

  -- Pass the angle to steel if dynoffset set
  !alpha35 =  !!mdsDynOffset.anglex.val
  handle ANY
    !alpha35 =  90
  elsehandle NONE
    if !alpha35.unset().not() then
      if !alpha35.gt(0) then
        !alpha35 =  ( 90 - !!mdsDynOffset.anglex.val )
      elseif !alpha35.lt(0) then
        !alpha35 =  ( 90 +  !!mdsDynOffset.anglex.val )
      else
        !alpha35 =  90
      endif
      !tdir = !!ce.cref.tdir
      if !dynamicparallel then
        !alpha35 =  0
      endif
    else
      -- >> dtf mod to set correct angle when dynamic hanger LD09 for example
      -- in the same direction as leave of pipe.
      --q var !pldir
      --q var !!ce.cref.tdir
      !tdir = !!ce.cref.tdir
      if !dynamicparallel then
        !alpha35 =  0
      endif
    endif
  endhandle

  !yoffset = !!mdsDynOffset.offsety.val
  handle ANY
    !yoffset = 0
  endhandle
  !yAngle =  !!mdsDynOffset.angley.val
  handle ANY
    !yAngle = 0
  endhandle
  !xoffset = !!mdsDynOffset.offsetx.val
  handle ANY
    !xoffset = 0
  endhandle
  !xAngle = !!mdsDynOffset.anglex.val
  handle ANY
    !xAngle = 0
  endhandle

  -- Pass the pipe material type to manufacturers program

  !pipeMaterial = !!ce.owner.pspe.:mdspipemat

  -- Pass the hydro load store in :Usttestload and
  -- HS140 in :ustforces[4]

  --  !hydroLoad = !!ce.cref.owner.:UstTestLoad
  !hydroLoad = !!ce.:MDSHLoad
  handle ANY
    !hydroLoad = 0
  endhandle

  !hsLoad = !!ce.cref.owner.:Ustforces
  handle NONE
    !hs140Load = !hsLoad[4]
    handle ANY
      !hs140Load = 0
    endhandle
  elsehandle ANY
    !hs140Load = 0
  endhandle

  -- check to make sure that the data is set correctly
  -- check valid pdmsname

  if !this.name.val.match(' ').gt(0) or !this.name.val.eq('unset') then
    !!alert.error('Invalid Name')
    return
  endif

  !cuproj = current project
  !proj = !cuproj.code()
  !dat = !proj & 'DAT'
  !lif = !proj & 'LIF'
  !lof = !proj & 'LOF'

  var !evardat evar $!dat
  var !evarlif evar $!lif
  var !evarlof evar $!lof

  !!manif.dat = object FILE(!evardat)
  !!manif.lif = object FILE(!evarlif)
  !!manif.lof = object FILE(!evarlof)

  -- check for valid temperature

  if (!this.pipetemp.val.real().value().string() eq '-100000') then
    !!alert.error('The temperature of the branch is not set')
    return
  endif

  -- Set the display text for the interface being used

  if !!mdsHangIf.upcase().eq('LISEGA') then
    !manText = 'LISEGA'
  elseif !!mdsHangIf.upcase().eq('PSL') then
    !manText = 'Pipe Supports Limited'
  elseif !!mdsHangIf.upcase().eq('CPL') then
    !manText = 'Carpenter and Paterson'
  endif

  -- check valid input directory

  if ((undefined(!!manif.lif)) OR !!manif.lif.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Interface Input Directory does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.lif.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Interface Input Directory does not exist. Unable to proceed!')
    return
  endif

  -- check valid output directory

  if ((undefined(!!manif.lof)) OR !!manif.lof.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Interface Output Directory does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.lof.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Interface Output Directory does not exist. Unable to proceed!')
    return
  endif

  -- check valid database directory

  if ((undefined(!!manif.dat)) OR !!manif.dat.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Database does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.dat.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Database Directory does not exist. Unable to proceed!')
    return
  endif

  --<wd28nov2006
  -- Modified the .replace code below because the value in the form !!mdsVendor name gadget, i.e.
  -- !this.name.val, does NOT contain the required PDMS name prefix '/' slash character,
  -- e.g. 'PS123456'
  --!file = !this.name.val.replace('/','\').replace('\','-',2,0)
  !file = !this.name.val.replace('/','\').replace('\','-',1,0)
  --<wd28nov2006

  --q var !this.name.val
  --q var !file
  if !!mdsHangIf.eq('CPL') then
    !liffile = object FILE('$!!manif.lif' & '\' & !file & '.wif')
    !loffile = object FILE('$!!manif.lof' & '\' & !file & '.wof')
  elseif !!mdsHangIf.eq('LISEGA') then
    !liffile = object FILE('$!!manif.lif' & '\' & !file & '.lif')
    !loffile = object FILE('$!!manif.lof' & '\' & !file & '.lof')
  elseif !!mdsHangIf.eq('PSL') then
    !liffile = object FILE('$!!manif.lif' & '\' & !file & '.psi')
    !loffile = object FILE('$!!manif.lof' & '\' & !file & '.pso')
  endif

  if (!this.hotcold.val EQ 1) then
    !load = 'hot'
  else
    !load = 'cold'
  endif

  if (!this.hangerSelType.val EQ '18H') then
    !this.hangerSelType.val = '1H'
  elseif (!this.hangerSelType.val EQ '18V') then
    !this.hangerSelType.val = '1V'
  elseif (!this.hangerSelType.val EQ '19V') then
    !this.hangerSelType.val = '31V'
  elseif (!this.hangerSelType.val EQ '19H') then
    !this.hangerSelType.val = '31H'
  endif

  -- Get addition info from the atta to send to manufacturers program

  !restName = !!ce.name + '/REST'
  !ustSprRate   = :UstSprRate of $!restName
  handle ANY
    !ustSprRate = ''
  endhandle

  !manIFConfigString = :USTHCFGKEY of $!restName
  handle ANY
    !manIFConfigString = ''
    !manIFConfig = ''
  elsehandle NONE
    !manIFConfig = !manIFConfigString.after('.').before('.').real()
  endhandle

  !distRod = :UstDistRod of $!restName
  handle NONE
    if (!distRod.eq(0)) then
      !distRod = !this.steelWidthVal.val.real()
    endif
  elsehandle ANY
    !distRod = !this.steelWidthVal.val.real()
  endhandle

  --<wd>22dec2009 - DFN P-23513 SI-4931
  -- Set the variable !distRod to the nearest integer
  -- The CPL WitchHanger interface does not cater for decimal places in the "Width" value supplied in the INPUT .lif file
  !distRod = !distRod.nint()
  --<wd>22dec2009 - DFN P-23513 SI-4931

  !liffile.open('Overwrite')
  handle (41,322)
    !fileName = !liffile.string()
    !!alert.error('Unable to continue as the file $!fileName is being used')
    return
  endhandle
  !liffile.writerecord('[DWG]')
  !liffile.writerecord('HangerMark=' & !this.name.val)
  !liffile.writerecord('DwgNo=' & !this.name.val)
  !liffile.writerecord('')
  !liffile.writerecord('[Load]')
  -- !liffile.writerecord('Load_condition=' & !load)

  -- the following sets the load value in licad so that autotesting solution can be used
  -- to use this set a global boolean !!licadautotestenabled = true
  if(define(!!licadautotestenabled)) then
    !liffile.writerecord('Normal=' & '5')
  else
    !liffile.writerecord('Normal=' & !this.pipeload.val.real().value().string())
  endif

  !liffile.writerecord('Emergency=' & !this.emergencyLoad.val.real().value().string())
  !liffile.writerecord('Failure=' & !this.failureLoad.val.real().value().string())
  !liffile.writerecord('Hydro=' & !hydroLoad)
  !liffile.writerecord('HS140=' & !hs140Load)
  !liffile.writerecord('')
  !liffile.writerecord('[Pipe]')
  !liffile.writerecord('Size=' & !this.size)
  !liffile.writerecord('Temp=' & !this.pipetemp.val.real().value().string())
  !liffile.writerecord('Insulation=' & !this.pipeinsu.val.real().value().string())
  !liffile.writerecord('Pipe_Z=' & !this.pipez.val.real().value().string())
  !liffile.writerecord('Pipe_X=' & !this.pipex.val.real().value().string())
  !liffile.writerecord('Pipe_Y=' & !this.pipey.val.real().value().string())
  !liffile.writerecord('Orientation_X=' & !this.attaori[1])
  !liffile.writerecord('Orientation_Y=' & !this.attaori[2])
  !liffile.writerecord('Orientation_Z=' & !this.attaori[3])
  !liffile.writerecord('Material=' & !pipeMaterial)
  !liffile.writerecord('')
  !liffile.writerecord('[StaticMovements]')
  !liffile.writerecord('Lateral=' & !this.pipexmovement.val.real().value().string())
  !liffile.writerecord('Horizontal=' & !this.pipeymovement.val.real().value().string())
  !liffile.writerecord('Vertical=' & !this.pipezmovement.val.real().value().string())
  !liffile.writerecord('')
  !liffile.writerecord('[DynamicMovements]')
  !liffile.writerecord('Positive=' & '')
  !liffile.writerecord('Negative=' & '')
  !liffile.writerecord('')
  !liffile.writerecord('[SteelConnection]')
  !liffile.writerecord('El_Steel_L=' & !this.steelTagEleL.val.real().value().string())
  !liffile.writerecord('El_Steel_R=' & !this.steelTagEleR.val.real().value().string())
  -- !liffile.writerecord('Width=' & !this.steelWidthVal.val.real().value().string())
  !liffile.writerecord('Width=' & !distRod)
  !liffile.writerecord('Steel_Z=' & !this.steelZ.val.real().value().string())
  !liffile.writerecord('Steel_X=' & !this.steelX.val.real().value().string())
  !liffile.writerecord('Steel_Y=' & !this.steelY.val.real().value().string())
  !liffile.writerecord('')
  !liffile.writerecord('[MDSHangerConfig]')

  if (!this.hangerSelType.val inset ('7H','7V','20H','20V')) then
    !liffile.writerecord('Config=7')

    -- If the type is a 7/20 dynamic hanger give the length not the elevations when modifying
    -- !manIFConfig will not be set to anything during creation because we only know this after
    -- it has been populated by the interface
    --if !manIFConfig.eq(1) or !manIFConfig.eq(9) then
    --$R54

    if !manIFConfig.string().neq('') and !this.ce.cref.owner.members.size().eq(1) then
      pin 8 at $!this.ce
      if  !dynamicparallel then
        -- <RM> 11/08/08 added handle because some licad hangers are falling over here
        pin 9 copy  p1 of pcla 1 of hang 1 of $!this.ce.cref
        handle ANY
          pin 9 copy pl of $!this.ce
        endhandle
        -- <RM> 11/08/08 end of fix
        --var !htdir tdir of hang 1 of $!this.ce.cref -- htdir not used anywhere
        pin 9 dir $!directions[1]
        pin 7 at $!!mdsfh01.support.tposition

        var !length const dist pin 7 to pin 8
      else
        pin 9 copy pt of $!this.ce.cref
        --pin 9 at $!!mdsfh01.support.tposition
        pin 8 at $!this.ce
        --pin 8 at ph of $!this.ce.cref
        var !length const dist pin 9 to pin 8
      endif
      --    $P Length is $!length before manufacturers program
      --!!mdsResetPins(8,9)
      !liffile.writerecord('Length=' + !length.real().nint().value().string())
      --elseif (!manIFConfig.string() inset ('7','10','11','12')) then
    elseif !manIFConfig.string().neq('') and !this.ce.cref.owner.members.size().eq(2) then
      -- In modify mode !manIFConfig is set. But because the support has 2 hangers
      -- you cannot pass the length as HH to HT of hang1.
      -- Therefore length is different in this case ie hh to middle of ht1 and ht2
      pin 8 at $!this.ce
      -- We need a standard ppoint to find out which direction the csupport is
      --orientated and the we can plane thr ht to get new length.
      -- remember this stuff below is lisega specific
      if !manIFConfig.string() inset ('11','12') then
        --pin 9 copy  p13 of pcla 1 of hang 1 of $!this.ce.cref
        var !lenDir  pl dir of last mem of hang 1 of $!this.ce.cref
      elseif !manIFConfig.string().eq('8') then
        pin 9 copy  p1 of pcla 1 of hang 1 of $!this.ce.cref
        var !hhdir hdir of hang 1 of $!this.ce.cref
        pin 9 plane $!hhdir thr p2 of pcla 1 of hang 1 of $!this.ce.cref
        var !lenDir construct dir pin 9 to pin 8
      else
        --pin 9 copy  p12 of pcla 1 of hang 1 of $!this.ce.cref
        var !lenDir  pl dir of last mem of hang 1 of $!this.ce.cref
      endif
      -- end of Lisega specific
      pin 8 dir $!lenDir
      pin 9 copy pin 8
      pin 9 plane $!lenDir thr ht of $!this.ce.cref
      var !length const dist pin 9 to pin 8
      -- $P Length at line 1873 = $!length
      !!mdsResetPins(8,9)

      !liffile.writerecord('Length=' + !length.real().nint().value().string())
      --      q var !length.real().nint().string()
    else
      -- Create Mode
      pin 9 copy pt of $!this.ce.cref
      --pin 8 at ph of $!this.ce.cref
      pin 8 at $!this.ce
      var !length const dist pin 9 to pin 8
      --      q var !length
      !liffile.writerecord('Length=' + !length.real().abs().nint().value().string())
      --      q var !length.real().nint().string()
    endif
  elseif (!this.hangerSelType.val inset ('21V','21H','25H','25V')) then
    !oriChar = !this.hangerSelType.val.substring(3,1)
    --!liffile.writerecord('2222')
    !liffile.writerecord('Config=21$!oriChar')
    -- If the type is a 21/25 static hanger give the length not the elevations
    var !hcoll coll all Hang for rest of  $!this.ce.cref
    !hsize = !hcoll.size()
    -- If we have two hangers then length calculated differently
    -- in modify mode, In create mode only 1 hanger will exists at this point.
    if !hsize eq 2 then
      pin 8 at hh of $!this.ce.cref
      !tdir = !this.ce.cref.tdir
      !optdir = !tdir.opposite()
      pin 9 copy pin 8
      pin 9 plane $!optdir thr ht of $!this.ce.cref
    else
      pin 9 copy pt of $!this.ce.cref
      pin 8 at ph of $!this.ce.cref
    endif
    var !length const dist pin 9 to pin 8
    --    $P Length is $!length before manufacturers program
    !!mdsResetPins(8,9)
    !liffile.writerecord('Length=' + !length.real().int().value().string())
    -- <RM> 11/08/08 added this elseif block because we have a new filter 600 which allows licad to create spring can type supports and the lif file needs to update
    -- on this basis
  elseif (!this.hangerSelType.val inset ('600')) then
    !liffile.writerecord('Config=' & '6H')
    !liffile.writerecord('Length=0')
    -- <RM> 11/08/08 end of fix
  else
    --!liffile.writerecord('2222')
    !liffile.writerecord('Config=' & !this.hangerSelType.val)
    !liffile.writerecord('Length=0')
  endif

  if !!mdsHangIf.eq('PSL') then
    !vendorCfg = !this.ce.:MdsVendorCfg
    !liffile.writerecord('VendorConfig=' & !vendorCfg)
  endif

  !!mdsResetPins(8,9)

  if !this.flangewidth.unset() then
    !liffile.writerecord('Joint Beam Flange Width=1000')
    !liffile.writerecord('Joint Beam Flange Thickness=1000')
  elseif !this.flangethk.unset() then
    !liffile.writerecord('Joint Beam Flange Width=1000')
    !liffile.writerecord('Joint Beam Flange Thickness=1000')
  else
    !liffile.writerecord('Joint Beam Flange Width=' & !this.flangewidth.real().value().string())
    !liffile.writerecord('Joint Beam Flange Thickness=' & !this.flangethk.real().value().string())
  endif

  -- Pass the beam height to WitchHanger so it stops the can clashing
  -- with the steel for pipe to two channels
  -- NCM 31-01-06

  if !!mdsHangIf.eq('CPL') then
    if !this.flangeHeight.set() then
      if !this.flangeHeight.empty().not() then
        !liffile.writerecord('Joint Beam Flange Height=' & !this.flangeHeight.real().value().string())
      endif
    endif
  endif

  !liffile.writerecord('Joint Rotate=' & !this.jointrotate)

  --P-37906 set the value of the pipe angle for vertical trunnions connecting to a type 6 spring pedestal support
  --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
  --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
  --i have tried to minimise the impact of this by doing the following
  --1) restricting to !!mdsHangIf = CPL only
  --2) ensuring that the atta pipe is a trunnion
  --3) ensuring that the atta pipe is vertical
  --4) ensuring that the config type is 6
  if !!mdsHangIf.eq('CPL') and !this.hangerSelType.val.eq('6') then
    !trunnion = !!ce.owner.:MDSTrun
    handle ANY
      !trunnion = FALSE
    endhandle

    if !trunnion and !!ce.ldir.up.gt(0.95) or !!ce.ldir.up.lt(-0.95) then
      !liffile.writerecord('Alpha=' & '0')
    else
      !liffile.writerecord('Alpha=' & !pipeAngle.string())
    endif
  else
    !liffile.writerecord('Alpha=' & !pipeAngle.string())
  endif
  --P-37906 set the value of the pipe angle for vertical trunnions connecting to a type 6 spring pedestal support
  --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
  --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end


  !liffile.writerecord('UstSprRate=' & !ustSprRate)
  -- !liffile.writerecord('UstLisCatLgv=' & !ustLisCatLgv)
  -- !liffile.writerecord('UstLisCatClv=' & !ustLisCatClv)
  -- !liffile.writerecord('UstHCfgKey=' & !ustHCfgKey)
  -- !liffile.writerecord('UstDrwg=' & !ustDrwg)
  -- Write steelwork sizes

  if defined(!this.steelMem[1]) then
    if !this.steelMem[1].badref().not() then
      !steelProfile = !this.steelMem[1].catref.:MdsSizeTag
      handle ANY
        !steelProfile = ''
      endhandle
      --!liffile.writerecord('Profile Left=' & !steelProfile)
    else
      --!liffile.writerecord('Profile Left=')
    endif
  else
    !liffile.writerecord('Profile Left=')
  endif

  if defined(!this.steelMem[2]) then
    if !this.steelMem[2].badref().not() then
      !steelProfile = !this.steelMem[2].catref.:MdsSizeTag
      handle ANY
        !steelProfile = ''
      endhandle
      --!liffile.writerecord('Profile Right=' & !steelProfile)
    else
      --!liffile.writerecord('Profile Right=')
    endif
  else
    !liffile.writerecord('Profile Right=')
  endif

  -- Need to write if the pipe is parallel to PSL only

  if !!mdsHangIf.eq('PSL') then
    if !!mdsfh01.parallel.unset() then
      !liffile.writerecord('Parallel=FALSE')
    else
      if !!mdsfh01.parallel then
        !liffile.writerecord('Parallel=TRUE')
      else
        !liffile.writerecord('Parallel=FALSE')
      endif
    endif
  endif

  if !!mdsHangIf.eq('LISEGA') then
    !taildir = !this.ce.cref.tdir.wrt( /* ).string().before(' WRT')
    !attaldir = !this.ce.ldir.wrt( /* ).string().before(' WRT')
    if !dynamicparallel and !dynamictype then
      !liffile.writerecord('DynamicParallel=TRUE')
      !liffile.writerecord('PipeDirection=$!pipeDirection')
    else
      !liffile.writerecord('DynamicParallel=FALSE')
      !liffile.writerecord('PipeDirection=$!pipeDirection')
    endif
    !taildirsplit = !taildir.split(' ')
    !attaldirsplit = !attaldir.split(' ')
    if !taildirsplit.size().lt(3) then
      !htdiry = !taildirsplit[1]
      !htang = '0'
      !htdirx = ''
    else
      !htdiry = !taildirsplit[1]
      !htang  = !taildirsplit[2]
      !htdirx = !taildirsplit[3]
    endif

    if !attaldirsplit.size().eq(5) then
      !pddiry = !attaldirsplit[1]
      !pdangh = !attaldirsplit[2]
      !pddirx = !attaldirsplit[3]
      !pdslop = !attaldirsplit[4]
      !pdupdn = !attaldirsplit[5]
    elseif !attaldirsplit.size().eq(3) then
      if !attaldirsplit[3].eq('U') or !attaldirsplit[3].eq('D') or !attaldirsplit[3].eq('Z') or !attaldirsplit[3].eq('-Z') then
        !pddiry = !attaldirsplit[1]
        !pdangh = '0'
        !pddirx = ' '
        !pdslop = !attaldirsplit[2]
        !pdupdn = !attaldirsplit[3]
      else
        !pddiry = !attaldirsplit[1]
        !pdangh = !attaldirsplit[2]
        !pddirx = !attaldirsplit[3]
        !pdslop = '0'
        !pdupdn = ' '
      endif
    else
      !pddiry = !attaldirsplit[1]
      !pdangh = '0'
      !pddirx = ' '
      !pdslop = '0'
      !pdupdn = ' '
    endif

    !liffile.writerecord('HangerTaildirection_DIRY=$!htdiry')
    !liffile.writerecord('HangerTaildirection_ANG=$!htang')
    !liffile.writerecord('HangerTaildirection_DIRX=$!htdirx')
    !liffile.writerecord('PipeDirectionActual_DIRY=$!pddiry')
    !liffile.writerecord('PipeDirectionActual_ANG_HOR=$!pdangh')
    !liffile.writerecord('PipeDirectionActual_DIRX=$!pddirx')
    !liffile.writerecord('PipeDirectionActual_SLOPE=$!pdslop')
    !liffile.writerecord('PipeDirectionActual_UPDN=$!pdupdn')

    -- <RM> 13 Oct 06 > -- We need to include information on the support condition for LICAD, this will take the form of
    -- PIPE DETAILS - i.e. HORIZONTAL + SLOPING etc.
    -- SUPPORT SURFACE - i.e. VERTICAL + ROTATED etc.
    -- PARALLEL - TRUE OR FALSE
    !liffile.writerecord('')
    !liffile.writerecord('[Connection Details]')
    -- First get the pipe details


    if !pdslop.real().abs().gt(0) then
      !sloping = 'SLOP'
    else
      !sloping = 'FLAT'
    endif

    if !pdangh.real().abs().gt(0) then
      !rotated = 'ROT'
    else
      !rotated = 'NONE'
    endif

    VAR !pipeleavedir DIR PL OF $!nameOfAtta

    --check that we are below 45 degrees

    if !pipeleavedir.direction().up.abs().leq(0.707107) then
      !dirpipe = 'HORZ'
    else
      !dirpipe = 'VERT'
    endif

    !liffile.writerecord('PipeCondition=' + !dirpipe + '-' + '$!sloping' + '-' + '$!rotated')

    !upang = !tdir.angle( U wrt /* ).real()
    if !upang.gt(90) then
      !upang = 180 - !upang
    endif

    if !upang.gt(45) then
      !suppdir = 'VERT'
    else
      !suppdir = 'HORZ'
    endif

    if !htang.real().gt(0) then
      !supprot = 'ROT'
    else
      !supprot = 'NONE'
    endif

    -- <RM> 11/08/08 added handle below for spring can types supports
    var !supptype typ of own of own of tref of cref
    handle ANY
      !supptype = 'NONE'
    endhandle
    -- <RM> 11/08/08 end of fix

    if !supptype.eq('PANE') or !supptype.eq('FLOOR') or !supptype.eq('GWALL') or !supptype.eq('FRMW') then
      !suppsurface = 'CIVILS'
    else
      -- <RM> 23 Nov 2006 --
      -- commented the following out to see if the lisega software makes use of it
      -- if not then i will just set suppsurface as civils
      !suppsurface = 'CIVILS'
      --!suppsurface = 'STRU'
      -- <RM> 23 Nov 2006 -- end of fix
    endif

    !liffile.writerecord('SupportCondition=' + !suppdir + '-' + !suppsurface + '-' + !supprot)

    -- write if the pipe and support are parallel
    !oriparallel = !this.isparallel(!!ce, !!mdsfh01.support.tdir)
    !liffile.writerecord('Parallel=' + !oriparallel.string())
    --< end of fix <RM> 13 Oct 06

    -- <RM> 26 Oct 06 > --
    !moveattadir = !!mdsGetMoveDir(!!ce,'CREATE')

    !liffile.writerecord('')
    !liffile.writerecord('[Vectors]')

    --get the pipe direction
    if !moveattadir[2].neq('') then
      !pipedir = !!mdsunitvector(!moveattadir[2].direction())
    else
      var !pipeleavedir dir pl of $!!ce
      !pipedir = !!mdsunitvector(!pipeleavedir.direction())
    endif

    !liffile.writerecord('pipe_direction_x=' + !pipedir[1].string('D5'))
    !liffile.writerecord('pipe_direction_y=' + !pipedir[2].string('D5'))
    !liffile.writerecord('pipe_direction_z=' + !pipedir[3].string('D5'))

    --get the vector perpendicular to the support surface
    !taildirperp = !!mdsunitvector(!taildir.direction())
    !liffile.writerecord('wall_perp_x=' + !taildirperp[1].string('D5'))
    !liffile.writerecord('wall_perp_y=' + !taildirperp[2].string('D5'))
    !liffile.writerecord('wall_perp_z=' + !taildirperp[3].string('D5'))

    if !dynamicparallel.not() then
      --get the vector from hanger tail to a point perpendicular on the pipe
      PIN 3 at $!!mdsfh01.support.tposition
      pin 3 dir $!!mdsfh01.support.tdir
      pin 5 copy pl of $!!ce
      pin 3 dir towards pin 5
      var !originaldist const dist pin 3 to pin 5
      var !pin3dir dir pin 3
      var !pldirect dir pin 5
      !offang = !pin3dir.direction().angle(!pldirect.direction())
      !oang = !offang
      if !offang.real().gt(90) then
        !oang = 180 - !offang.real()
      endif

      -- get the approx dist that the support needs to move to be perpendicular to the pipe
      -- it is only approximate because we do not know the component lengths that come back from
      -- licad. these component lengths determine the exact movement lengths.
      !approxdisttomove = !originaldist.real() * cosine(!oang)
      pin 5 dir $!moveattadir[2]
      handle ANY
        !tailtoperpdirection = !taildir
      elsehandle NONE
        pin 5 dist $!approxdisttomove
        pin 3 dir towards pin 5
        var !tailtoperpdirection dir pin 3
      endhandle

      !tailtoperpdir = !!mdsunitvector(!tailtoperpdirection.direction())
      !liffile.writerecord('tailpostopipe_perp_x=' + !tailtoperpdir[1].string('D5'))
      !liffile.writerecord('tailpostopipe_perp_y=' + !tailtoperpdir[2].string('D5'))
      !liffile.writerecord('tailpostopipe_perp_z=' + !tailtoperpdir[3].string('D5'))
    else
      !liffile.writerecord('tailpostopipe_perp_x=' + '0')
      !liffile.writerecord('tailpostopipe_perp_y=' + '0')
      !liffile.writerecord('tailpostopipe_perp_z=' + '0')
    endif
    -- <RM> end of fix 26 Oct 06

    !xoffdir = !!mdsfh01.support.offsetx
    !yoffdir = !!mdsfh01.support.offsety

    !xoffdira = !!mdsunitvector(!xoffdir)
    !yoffdira = !!mdsunitvector(!yoffdir)

    !liffile.writerecord('x_offdir_x=' + !xoffdira[1].string('D5'))
    !liffile.writerecord('x_offdir_y=' + !xoffdira[2].string('D5'))
    !liffile.writerecord('x_offdir_z=' + !xoffdira[3].string('D5'))

    !liffile.writerecord('y_offdir_x=' + !yoffdira[1].string('D5'))
    !liffile.writerecord('y_offdir_y=' + !yoffdira[2].string('D5'))
    !liffile.writerecord('y_offdir_z=' + !yoffdira[3].string('D5'))

    !hang1 = !this.ce.cref
    var !coll coll all WPAD for $!hang1
    if !coll.size().gt(0) then
      !this.wpadmat = !coll[1].dbref().matref
      handle ANY
        !this.wpadmat = !coll[1].dbref().:MDSMatref
      endhandle
    endif
  endif

  -- >>> dtf mod to storeposition  numbers if set
  if !this.ce.cref.members.size().gt(0) then
    --must be in modify mode, see if pcla 1 has MDSposnum set
    !posnumtest = !this.ce.cref.members[1].:MDSposnum
    handle ANY
    elsehandle NONE
      if !this.ce.cref.members[1].:MDSposnum.unset().not() then
        if defined(!!mdsFixPosNum) then
          if !this.ce.:mdsposnummax.real().gt(0) then
            handle ANY
            elsehandle NONE
              -- Store position numbers in design to be used in mto in draft
              !!mdsFixPosNum.storeposnumbers(!this.ce)
            endhandle
          endif
        endif
      endif
    endhandle
  endif
  -- <<< dtf end of mod

  !liffile.close()

  --run transc.exe to remove the utf-8 unicode encoding on the file header - start
  !!pmlTranscFile(!liffile.fullname(), '', '', '', '')
  --run transc.exe to remove the utf-8 unicode encoding on the file header - end

  -- Initialise the manufacturers software with an input file and output file
  -- Hold the PDMS session until the user exits the software and then read
  -- in the output file

  !this.hide()
  !!mdsmodifysupp.cancel.active = TRUE
  refresh

  !evartext = !proj + 'DAT'
  handle ANY
  endhandle

  -- Don't delete output file before calling interface software because
  -- If the user cancels in interface the support gets rebuild as before using last lof
  -- file created for that support number.
  -- !loffile.deletefile()


  -- Environment variable for manufacturers program modified to include name of executable
  if !!mdsHangIf.eq('LISEGA') then
    -- Call String is executable InputFilePath Outputfilepath ProjectDBs
    -- the following allows the pass through mechanism provided by Lisega to be used for AVEVA internal testing only.
    -- to use this set a global boolean !!licadautotestenabled = true
    !!a = !liffile
    !!b = !loffile
    !!c = !evartext
    if(defined(!!licadautotestenabled)) then
      -- lisega provided a pass through utility to allow automatic testing of the LD09 type
      -- hanger if !!licadautotest is true then we use this passthrough.
      SYSCOM |""%LICADMDSEXE%"" /IF:$!liffile /OF:$!loffile /PD:%$!evartext% /T:309|
    else
      SYSCOM |""%LICADMDSEXE%"" /IF:$!liffile /OF:$!loffile /PD:%$!evartext%|
    endif
  elseif !!mdsHangIf.eq('PSL') then
    -- Call String is executable /MDS Outputfilepath InputFilePath ConfigFile
    -- Config file will be called config.txt and must be stored in the software directory
    !configFile = object FILE()
    var !pslExe evar PSLMDSEXE
    !configFile.file(!pslExe)
    !configPath = !configFile.directory()
    !configFile.file(!configPath.string() + '/config.txt')
    !config = !configFile.fullname()
    var !datdir evar $!evartext
    -- Commented dat dir out until psdesigner needs it
    --    SYSCOM |$!pslExe /MDS /$!loffile /$!liffile /$!config|
    SYSCOM |""$!pslExe"" /MDS /$!loffile /$!liffile /$!config /$!datdir|
  elseif !!mdsHangIf.eq('CPL') then
    -- We need to pass the WitchHanger program the db required, these will be stored in
    -- the evar projcode(dat), the form !!mdscplDb will get the user to select the db
    -- and put the db required in the form member .db
    -- If it has been selected before then open the program if not get the user to select
    -- the db
    var !cplmdsexe evar cplmdsexe
    --$P ***    !!mdscplDb.init('$!cplmdsexe','$!liffile','$!loffile')
    !!mdscplDb.init('$!cplmdsexe','$!liffile','$!loffile')

    --    SYSCOM |""%CPLMDSEXE%"" /IF:$!liffile /OF:$!loffile /PD:%$!evartext%|
  endif

  -- Call method to build hanger and manufacturers object

  if !!mdsHangIf.neq('CPL') then

    !this.buildHanger('$!loffile')
    handle ANY
    endhandle

    do !loop from 1 to 9
      pin $!loop off
    enddo
  endif

endmethod


-------------------------------------------------------------------------------------
-- method to clear all gadgets it there is an error
-------------------------------------------------------------------------------------

define method .clear()

  !this.name.val          = ''
  !this.pipesize.val      = ''
  !this.pipeinsu.val      = ''
  !this.pipetemp.val      = ''
  !this.pipex.val         = ''
  !this.pipey.val         = ''
  !this.pipez.val         = ''
  !this.pipeori.val       = ''
  --<wd>25jan2006<mds12>
  --  !this.pipematl.val      = ''
  --<wd>25jan2006<mds12>
  !this.pipeload.val      = '0'
  !this.pipexmovement.val = ''
  !this.pipeymovement.val = ''
  !this.pipezmovement.val = ''
  !this.steelTagEleL.val  = ''
  !this.steelTagEleR.val  = ''

endmethod

-------------------------------------------------------------------------------------
-- method to match the manufacturers bore units
-------------------------------------------------------------------------------------

define method .unitsmm()

  !this.boresmm[8]  = '13'
  !this.boresmm[10]  = '17'
  !this.boresmm[15]  = '21.3'
  !this.boresmm[20]  = '26.9'
  !this.boresmm[25]  = '33.7'
  !this.boresmm[32]  = '42.4'
  !this.boresmm[40]  = '48.3'
  !this.boresmm[50]  = '60.3'
  !this.boresmm[65]  = '73'
  !this.boresmm[76]  = '76.1'
  !this.boresmm[80]  = '88.9'
  !this.boresmm[108] = '108'
  !this.boresmm[100] = '114.3'
  !this.boresmm[125] = '141.3'
  !this.boresmm[133] = '133'
  !this.boresmm[140] = '139.7'
  !this.boresmm[159] = '159'
  !this.boresmm[150] = '168.3'
  !this.boresmm[194] = '193.7'
  !this.boresmm[200] = '219.1'
  !this.boresmm[245] = '244.5'
  !this.boresmm[267] = '267'
  !this.boresmm[250] = '273'
  !this.boresmm[300] = '323.9'
  !this.boresmm[350] = '355.6'
  !this.boresmm[368] = '368'
  !this.boresmm[400] = '406.4'
  !this.boresmm[419] = '419'
  !this.boresmm[450] = '457.2'
  !this.boresmm[500] = '508'
  !this.boresmm[550] = '558.8'
  !this.boresmm[600] = '609.6'
  !this.boresmm[650] = '660.4'
  !this.boresmm[700] = '711.2'
  !this.boresmm[750] = '762'
  !this.boresmm[800] = '812.8'
  !this.boresmm[900] = '914.4'

endmethod

---------------------
-- form cancel method
---------------------

define method .cancel()

  $!this.ce
  if (!!ce.stype.eq('MH01')) then
    !!mdsmodifysupp.cancel.active = TRUE
    !this.clear()
    !this.hide()
  else
    !!mdsfh01.name.val= !this.name.val
    !!mdsfh01.cancelHanger(TRUE)
    !this.clear()
    !this.hide()
  endif

  -- Delete the support if nothing has been created

  !!mdsDacControl(TRUE)

  !!ce = !this.ce
  !attaname = !!ce
  goto cref
  handle NONE
    !members = !!ce.mcount
    if !members.eq(0) then
      rest
      delete rest
      !!ce = !attaname
      delete atta
    endif
  elsehandle ANY
  endhandle

  !!mdsDacControl(FALSE)

endmethod

-------------------------------------------------------------------------------------
-- method to build hanger
-------------------------------------------------------------------------------------

define method .buildHanger(!file is STRING)

  !cancelcode = FALSE

  !fexists = object FILE(!file)
  if !fexists.exists() and !!mdsHangIf.eq('LISEGA') then
    --read the first line to see if licad has returned a cancel code
    !filelines = !!readPdmsFile('/$!file')
    if !filelines.size().neq(0) then
      if !filelines[1].match('ERROR').gt(0) then
        !cancelcode = TRUE
      elseif !filelines.size().eq(1) then
        !cancelcode = TRUE
      endif
    endif
  endif

  if (!fexists.exists() and !cancelcode.neq(TRUE)) then

    !filelines = !!readPdmsFile('/$!file')
    if !filelines.size().eq(0) then
      -- Delete from Licad
      !delete = !!mdsDeleteSuppLicad(!this.ce.namn)
      !!mdsDacControl(FALSE)
      return error 1 |No commands found in Interface output file, please try again!|
    endif
    -- !hangers = 1 - !hangers only used once
    !supportName = !this.ce.name

    -- When the Hanger is being modified delete the members
    -- because the LOF file creates every time
    if (!!ce.stype.eq('MH01')) then
      !attaname = !!ce.name
      do !x from 1 to 10
        if ('$!attaname/H$!x' EQ '$!attaname/H1') then
          $!attaname/H1
          handle ANY
          endhandle
          delete hanger mem
          handle ANY
          endhandle
          if  !!mdsVendor.hangerSelType.val.eq('6') and !!mdsHangIf.neq('PSL') then

            --P-37906 allow bottle jack connection to vertical trunnion for CPL
            --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
            --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
            --i have tried to minimise the impact of this by doing the following
            --1) restricting to !!mdsHangIf = CPL only
            --2) ensuring that the atta pipe is a trunnion
            --3) ensuring that the atta pipe is vertical
            --4) ensuring that the config type is 6
            if !!mdsHangIf.eq('CPL') then
              !trunnion = !attaname.dbref().owner.:MDSTrun
              handle ANY
                !trunnion = FALSE
              endhandle
              if !trunnion and !attaname.dbref().ldir.up.gt(0.95) or !attaname.dbref().ldir.up.lt(-0.95) then
                --do nothing as we are connecting to the base of a vertical trunnion
              else
                conn HH to p9 of $!attaname
              endif
            else
              -- mod to connect to p9 if its a bottle jack
              --<tm>18/08/2005 11:30
              conn HH to p9 of $!attaname
            endif
            --P-37906 allow bottle jack connection to vertical trunnion for CPL
            --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
            --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end
          else
            -- Mod to ensure hhdir correct
            conn HH to $!attaname
          endif
          own
        else
          do !deletehangers from 2 to 10
            rest
            $!deletehangers
            handle ANY
              break
            elsehandle NONE
              delete hanger
            endhandle
          enddo
        endif
      enddo
    endif

    --** PRE BUILD Interface Specific DATA
    -- These pre build object return the array !filelines as an input macro

    if !!mdsHangIf.eq('LISEGA') then
      !mdsLisega = object MDSLISEGA(!!mdsVendor)
      !filelines = !mdsLisega.preBuild(!filelines)
      !software = 'Licad'
    elseif !!mdsHangIf.eq('CPL') then
      !mdscpl = object MDSCPL(!!mdsVendor)
      !filelines = !mdscpl.preBuild(!filelines)
      !software = 'WitchHanger'
    elseif !!mdsHangIf.eq('PSL') then
      !mdspsl = object MDSPSL(!!mdsVendor)
      !filelines = !mdspsl.preBuild(!filelines)
      !software = 'PSDesigner'
    endif


    -- ** END of PRE BUILD

    -- Save the tail position of hanger 1 in case its offset

    !mdsDynOffset = :MdsDynOffset of $!supportName/H1
    !savedTailPosition = tpos of $!supportName/H1 wrt /*
    !savedTailDirection = tdir of $!supportName/H1 wrt /*

    -- Because the file contains if statements we have to write the file to a temp file and run in
    -- Does not use this now, left in for debug purposes
    -- !fileToRunIn = object FILE('%PDMSWK%' & '\' & 'FileToRunIn.mac')
    -- !fileToRunIn.open('Overwrite')
    -- !fileToRunIn.writefile('OVERWRITE',!filelines)
    -- !fileToRunIn.close()

    !numberOfErrors = 0

    do !runLines values !filelines
      if !runLines.match('--').eq(1) then
        skip
      endif
      !stripType = !this.hangerSelType.val.replace('H','').replace('V','')
      if !stripType.eq('7') or !stripType.eq('20') then
        -- Don't Connect PT to last mem because its DYNAMIC and we need it later to calculate the direction
        if !runLines.trim().eq('CONN PT TO LAST MEM') then
          skip
        endif
      endif

      $!runLines
      handle (61,7)
        --$P Orientation error in manufacturers input file
        ori
      elsehandle NONE
      elsehandle ANY
        if !runLines.upcase().match('CONN PT TO').eq(0) then
          if !numberOfErrors.eq(0) then
            --$P Error occurred in manufacturers input file with the following lines
          endif
          --$P $!runLines
          !part1 = !!error.text.after('(').before(',')
          !part2 = !!error.text.after(',').before(')')
          !!messageFile.softMessage($!part1,$!part2)
          !numberOfErrors = !numberOfErrors + 1
        endif
      endhandle
    enddo

    if !numberOfErrors.gt(0) then
      if !numberOfErrors.eq(1) then
        !!alert.error('Error - An error occurred in the $!software output file, please see the command line for details')
      else
        !!alert.error('Error - $!numberOfErrors errors occurred in the $!software output file, please see the command line for details')
      endif

      -- Delete corrupt hangers
      !!mdsDacControl(TRUE)
      !!ce = !this.ce
      !attanameS = !!ce
      !attanameString = !!ce.namn
      goto cref
      handle NONE
        rest
        -- Uncomment the two lines below to clear up the hanger
        --delete rest
        !!ce = !attanameS
        --delete atta
      elsehandle ANY
      endhandle
      -- Delete lugs if existing
      do !lug from 1 to 4
        $!attanameS/LUG$!lug
        handle ANY
        elsehandle NONE
          delete olet
        endhandle
      enddo
      -- Delete from manufacturers software
      if !!mdsHangIf.eq('LISEGA') then
        !delete = !!mdsDeleteSuppLicad(!attanameString)
      elseif !!mdsHangIf.eq('CPL') then
        !delete = !!mdsDeleteSuppCPL(!attanameString)
      elseif !!mdsHangIf.eq('PSL') then
      endif
      !!mdsDacControl(FALSE)
      return
    endif

    --<wd>03nov2009 DFN P-26541 - SI-18252  For CPL-WH4 TYPE '6' the CODE is NOT WORKING????
    -- So ADD variable !existCE and 3-handle ANY/endhandle blocks to trap any error raised
    !existCE = !!ce

    -- <RM> 11/08/08 added code below to correctly orientate the type 6 and 600 supports
    if (!this.hangerSelType.val inset ('6')) or (!this.hangerSelType.val inset ('600')) then
      --P-37906 the following code for type 6,600 is not required for bottlejacks connected to trunnions so bypass
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
      --i have tried to minimise the impact of this by doing the following
      --1) restricting to !!mdsHangIf = CPL only
      --2) ensuring that the atta pipe is a trunnion
      --3) ensuring that the atta pipe is vertical
      --4) ensuring that the config type is 6
      if !!mdsHangIf.eq('CPL') and !this.hangerSelType.val inset ('6') then
        !trunnion = !attaname.dbref().owner.:MDSTrun
        handle ANY
          !trunnion = FALSE
        endhandle
        if !trunnion and !attaname.dbref().ldir.up.gt(0.95) or !attaname.dbref().ldir.up.lt(-0.95) then
          --do nothing as we are connecting to the base of a vertical trunnion
        else
          $!this.ce.name/H1
          var !connectDir dir pl of href
          hdir $!connectDir
          pcla 1 conn
          handle ANY
          endhandle
          scla 1 conn
          handle ANY
          endhandle
          own
          pos ht at pl of scla 1
          handle ANY
          endhandle
        endif
      else
        $!this.ce.name/H1
        var !connectDir dir pl of href
        hdir $!connectDir
        pcla 1 conn
        handle ANY
        endhandle
        scla 1 conn
        handle ANY
        endhandle
        own
        pos ht at pl of scla 1
        handle ANY
        endhandle
      endif
      --P-37906 the following code for type 6,600 is not required for bottlejacks connected to trunnions so bypass
      --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
      --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
    endif
    -- <RM> 11/08/08 end of fix

    !!ce = !existCE
    --<wd>03nov2009 DFN P-26541 - SI-18252  For CPL-WH4 TYPE '6' the CODE is NOT WORKING???
    -- So ADD variable !existCE and 3-handle ANY/endhandle blocks to trap any error raised

    goto cref
    tdir $!savedTailDirection

    -- Update uda's

    !amHere = !!ce
    $!supportName/REST
    !ustMoveMents = :USTMoveMent
    handle NONE
      !ustForces    = :USTForces
      !ustTestLoad  = :USTTestLoad
      $!supportName
      :MdsMoveX $!ustMoveMents[2]
      -- <GE> 15/11/06 Added additional handles for data not
      -- being set via the Witch Hanger interface return file
      handle ANY
      endhandle
      :MdsMoveY $!ustMoveMents[1]
      handle ANY
      endhandle
      :MdsMoveZ $!ustMoveMents[3]
      handle ANY
      endhandle
      :MdsLoad  $!ustForces[1]
      handle ANY
      endhandle
      -- <GE> 15/11/06
      :MdsHload $!ustTestLoad
    elsehandle ANY
    endhandle
    !!ce = !amHere

    -- When the Hanger is first created from a horz template add extra fittings
    --<wd>11aug2009 -- DFN P-22111 (SI-13209) *** PML CODE changes added for HANGER types 31V and 32V on VERTICAL PIPES as well.
    --    if (!this.hangerSelType.val inset ('31H','32H')) then
    if (!this.hangerSelType.val inset ('31H','32H','31V','32V')) then
      $!this.steelMem[3]
      handle ANY
      elsehandle NONE

        --><wd>17aug2009 -- DFN P-22111 (SI-13209 - TWIN HANGERS supported from Double Channel SCTN types
        if (!this.hangerSelType.val inset ('32H','32V')) then
          -- Navigate to the FITTING element .../FITT/H1 - Therefore Set the UDA :MDSCONNECT with the DOUBLE Channel DBREFS and the POSLINE to TOC
          $!this.ce.name/FITT/H1
          POSL TOC
          !!ce.:MDSConnect[1] = !this.steelMem[1]
          !!ce.:MDSConnect[2] = !this.steelMem[2]
        endif
        -- Now Navigate back to the valid Steel Supporting Member which EXISTS to CREATE the NEW SECOND FITTING
        $!this.steelMem[3]
        --<<wd>17aug2009 -- DFN P-22111 (SI-13209

        NEW FITT COPY $!this.ce.name/FITT/H1 NAME $!this.ce.name/FITT/H2
        handle ANY
          delete fitt
          $!this.ce.name/H2
          TREF $!this.ce.name/FITT/H2
          handle ANY
            TREF $!this.ce.name/SBFI/H2
          endhandle
          $!this.ce.name/H1
          CONN PT TO LAST MEM
          TCONN WELD
          TREF $!this.ce.name/FITT/H1
          handle ANY
            TREF $!this.ce.name/SBFI/H1
          endhandle
        elsehandle NONE

          --><wd>17aug2009 -- DFN P-22111 (SI-13209 - TWIN HANGERS supported from Double Channel SCTN types
          if (!this.hangerSelType.val inset ('32H','32V')) then
            -- Current element is the FITTING element .../FITT/H2 - Therefore Set the UDA :MDSCONNECT with the DOUBLE Channel DBREFS and the POSLINE to TOC
            POSL TOC
            !!ce.:MDSConnect[1] = !this.steelMem[3]
            !!ce.:MDSConnect[2] = !this.steelMem[4]
          endif
          --<<wd>17aug2009 -- DFN P-22111 (SI-13209

          $!this.ce.name/H2
          handle ANY
          elsehandle NONE
            TREF $!this.ce.name/FITT/H2
            $!this.ce.name/H1
            CONN PT TO LAST MEM
            TCONN WELD
            TREF $!this.ce.name/FITT/H1
          endhandle
        endhandle
      endhandle
    elseif (!this.hangerSelType.val inset ('18H','18V','19H','19V')) then
      $!this.ce.name/H1
      CONN PT TO LAST MEM
      tconn LOSE
      TREF $!this.ce.name/CMPF
    endif

    if (!this.hangerSelType.val inset ('2H')) then
      $!this.ce.name/H1
      CONN PT TO LAST MEM
      TREF $!this.ce.name/FITT/H1
    endif

  elseif (!fexists.exists() and !cancelcode.eq(TRUE)) then

    -- we have received a cancel code from LICAD we need to skip to the end of the creation process
    -- without deleting the hanger so that any autotesting can continue
    if defined(!!licadautotestenabled) then
      -- do nothing
    else
      !!mdsundolicad.restoreHanger(TRUE)
    endif
    return

  else

    -- If file does not exist, i.e user has cancelled

    !!mdsfh01.name.val= !this.name.val

    !supportName = !this.ce.name
    !manIFConfigString = :USTHCFGKEY of $!supportName/REST
    handle ANY
      -- must NOT be LISEGA
      !manIFConfigString = ||
    endhandle
    -- If :USTHCFGKEY of REST not set and just to make sure hanger 1 members not gt 1
    -- only then can we delete the hanger otherwise it could be in modify mode with a changed name.

    if !manIFConfigString.string().upcase().eq('UNSET') and !this.ce.cref.owner.members.size().gt(1).not() then
      !!mdsfh01.cancelHanger(TRUE)
    endif
    !this.clear()
    !this.hide()
    if !!mdsHangIf.eq('CPL') then
      -- !delete = !!mdsDeleteSuppCPL(!attanameString)
      !!alert.error('Support has not been completed within WitchHanger')
      -- Delete corrupt hangers
      !!mdsDacControl(TRUE)
      !!ce = !this.ce
      !attanameS = !!ce
      !attanameString = !!ce.namn
      goto cref
      handle NONE
        rest
        -- Uncomment the two lines below to clear up the hanger
        delete rest
        !!ce = !attanameS
        delete atta
      elsehandle ANY
      endhandle

    endif
    return
  endif

  -- *********************
  -- Start of generic code
  -- *********************

  -- Position the fittings of the hanger/s in the correct place
  -- After reconnecting the tails

  !steelConns = !!mdsVendor.steelMem
  --do !clearBadRefs from 1 to !steelConns.size()
  do !clearBadRefs indices !steelConns
    if !steelConns[$!clearBadRefs].badref() then
      !steelConns[$!clearBadRefs].delete()
    endif
  enddo
  !steelConns.compress()

  do !count from 1 to 10
    $!this.ce.name/H$!count
    handle any
      break
    endhandle
    pos ht at pl of last mem
    pin 4 at ht
    goto tref
    handle none
      if !!ce.type.eq('FITT') then
        !!mdsDacControl(TRUE)
        zdist thro ht of cref
        !!mdsDacControl(FALSE)
      endif
    elsehandle any
    endhandle
  enddo

  -- Make sure trefs of hanger are connected to civils if needed

  !ce = !!ce

  do !loop from 1 to 3
    !!ce = $!supportName/H$!loop
    handle NONE
      tref $!supportName/SBFI/H$!loop
      handle ANY
      endhandle
    elsehandle ANY
    endhandle
  enddo

  -- Remove any SBFI connections that are not used

  do !loop from 2 to 3
    !!ce = $!supportName/H$!loop
    handle NONE
    elsehandle ANY
      !!ce = $!supportName/SBFI/H$!loop
      handle ANY
      elsehandle NONE
        delete sbfi
      endhandle
    endhandle
  enddo

  !!ce = !ce

  -- When the hanger is located on a sloping line check to see if it needs moving
  $!this.ce.name
  handle NONE
    -- Test if atta in line is on a slope
    !gradient = !!ce.ldir

    !attadirs = !!mdsremovegrad(!!ce)
    !dir = !!ce.cref.tdir
    if ( !dir.angle(!attadirs[1]).lt(.1) and !dir.angle(!attadirs[1]).gt(-.1) ) or $
      ( !dir.angle(!attadirs[1]).gt(179.9) and !dir.angle(!attadirs[1]).lt(180.1)) then
      -- Pipe and support direction parallel dynamic

    else
      if !gradient.up.eq(0) then
        -- Horizontal line
        -- Test to see if pipe parallel to wall / floor etc
        !paralleltest = !!mdsGetMoveDir(!!ce,'CREATE')
        if !paralleltest[1].not() and !paralleltest[3].nint().neq(90) then
          -- if not parallel we may need to move clamp along pipe
          --if !this.ce.cref.:mdsdynoffy.eq(0) then
          !!mdsModAttaPos(!!ce,'CREATE')
          --endif
        endif
      elseif !gradient.up.abs().eq(1) then
        -- Vertical line

        -- <RM> 21 November 2006 -- if we have a vertical line with an LD01 run modattapos
        -- regardless of orientation as it should work for all cases
        if !!mdsHangIf.eq('LISEGA') then
          !currentelem = !!ce
          !!ce = $!attaname
          !config = !!ce.cref.owner.:USTHcfgKey
          handle ANY
            !licadconfig = 'UNSET'
          elsehandle NONE
            !split = !config.split('.')
            !licadconfig = !split[1] & !split[2]
            handle any
              !licadconfig = 'UNSET'
            endhandle
          endhandle
          if !licadconfig inset('LD01') or !licadconfig inset('LD09')  then
            !!mdsModAttaPos(!!ce,'CREATE')
          endif
          $!currentelem
        endif
        -- <RM> 21 November 2006 -- end of fix
      else
        -- Only adjust if the tail dir is U/D not horizontal
        !pipeAngle = !!ce.ldir.string().after(' ').before(' ').real()

        --        !tailDirection = !!ce.cref.tdir.string().before(' WRT')
        !tailDirection = !!ce.cref.tdir.up.nint()
        if !tailDirection.eq(-1) or !tailDirection.eq(1) then
          -- Sloping line
          -- Determine the LICAD Type from the SECOND Field of the LICAD UDA :USTHCFGKEY e.g.
          -- Navigate to REST to get the value for the UDA:USTHCFGKEY 'LD.02.73.00.16'
          -- <-- where the --> LICAD TYPE = '02'
          -- Also do not adjust when the type is 7H/7V with a offset (:MdsDynOffset)
          !mdsDynOffset = !this.ce.cref.:MdsDynOffset
          !unusedTestForPosition = !mdsDynOffset
          handle ANY
          elsehandle NONE
            --if !this.ce.cref.:mdsdynoffy.eq(0) then
            -- we need an additional check to make sure that if the pipe is sloping and
            -- the sctn is sloping then if they are truly parallel then we shouldn't
            -- modify the atta position when creating the hanger.
            -- Richard Martin 05/07/06
            -- get the connected sctn ref
            !stref = !supportName.dbref().cref.tref.owner.string()
            handle any
            endhandle
            --var !stref owner of tref of cref of $!supportName
            !sctn = !stref.dbref()
            handle ANY
              -- <RM> 06/11/06 -- additional handle included for when we have no sctn reference.
            elsehandle NONE
              -- get the atta ref
              !comp = !supportName.dbref()
              -- run parallel check to see if we have a sloping section and horizontal line
              !check1 = !!mdsistubeparallel2sctn(!comp, !sctn)
              -- run parallel check to see if we have a sloping section and sloping line that are parralel
              if !sctn.type.eq('SCTN') then
                !check2 = !!mdsistubeslopeparallel2sctn(!comp, !sctn)
                -- get the connected sctn ref
                var !stref owner of tref of cref
                !sctn = !stref.dbref()
                -- get the atta ref
                !comp = !!ce

                var !posline posl of tref of cref
                var !dir1 dir from ppli na of $!sctn to ppli $!posline of $!sctn
                var !p9dir dir p9 of $!comp

                !dirdot = !p9dir.direction().dot(!dir1.direction())
                if !check2 neq TRUE then
                  if !check1 eq TRUE then
                    !!mdsModAttaPos(!!ce,'CREATE')
                  elseif !dirdot.abs().gt(0.999999) then
                    -- do not mod atta pos because the sctn orientation is parallel
                  else
                    !!mdsModAttaPos(!!ce,'CREATE')
                  endif
                endif
              else
                -- Type not a SCTN
                !checkx = !!mdsGetMoveDir(!!ce,'CREATE')
                if !checkx[1] neq TRUE then
                  !!mdsModAttaPos(!!ce,'CREATE')
                endif
              endif
              --endif
            endhandle
            -- <RM> 06/11/06 -- end of fix
          endhandle
        else
          -- Test to see if pipe parallel to wall / floor etc
          !paralleltest = !!mdsGetMoveDir(!!ce,'CREATE')
          if !paralleltest[1].not() then
            -- if not parallel we may need to move clamp along pipe
            --if !this.ce.cref.:mdsdynoffy.eq(0) then
            !!mdsModAttaPos(!!ce,'CREATE')
            --endif
          endif
        endif
      endif
    endif
  elsehandle ANY
  endhandle

  -- The modification of a hanger may have changed the support function, therefore
  -- reset the stex if needed

  !!ce = !this.ce
  handle NONE
    !!mdsTransport(!!ce,!!ce.name)
  elsehandle ANY
    -- Cancelled hanger
    return
  endhandle

  !!mdsDacControl(TRUE)

  -- If we have created a dynamic restraint then the support may contain an angle, we need to adjust the
  -- support to cater for this, this will be type 7 for steel 20 for civil

  !typeOfHanger = :MdsHConfig of $!supportName
  handle NONE
    !typeOfHanger = !typeOfHanger.replace('H','').replace('V','')
    if !typeOfHanger.eq('7') or !typeOfHanger.eq('20') then
      !unusedDynOffset = :MdsDynOffset of $!supportName/H1 wrt /*
      handle NONE
        !!ce = $!supportName/H1
        !testDynOffset = :MdsDynOffset
        !dynamicparallel = TRUE
        if !testDynOffset.eq(0).not() or !dynamicparallel then
          tpos $!savedTailPosition
          handle ANY
          elsehandle NONE
            last mem
            --pos pl at tpos of hang
          endhandle
        endif
      elsehandle ANY
      endhandle
    endif
  elsehandle ANY
    -- Cancelled hanger
  endhandle

  -- *******************
  -- End of generic code
  -- *******************

  -- Action any post build Interface Specific code

  if !!mdsHangIf.eq('LISEGA') then
    !mdsLisega.postbuild()
  elseif !!mdsHangIf.eq('CPL') then
    !mdscpl.postbuild()
  elseif !!mdsHangIf.eq('PSL') then
    !mdspsl.postbuild()
  else
    !!alert.error('No interface detected')
  endif

  -- Reposition fitt after rebuilding support in different ori

  !iAmHere = !!ce
  $!supportName/H1
  handle NONE
    goto tref
    handle none
      if !!ce.type.eq('FITT') then
        !!mdsDacControl(TRUE)
        zdist thro ht of cref
        !!mdsDacControl(FALSE)
      endif
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle
  !!ce = !iAmHere


  -- By default only 1 hanger is created, if 2 are then set the dir and conn to the same as one
  -- This section could possibly be moved into the mdslisega object or modified to be none lisega specific
  rest
  handle NONE
    -- Lisega only Remove the next 3 lines when lines 2481 removed
    !lisegaType = !!ce.:USTHCFGKEY.substring(1,2)
    handle NONE
      !lisegaNumber = !!ce.:USTHCFGKEY.after('.').substring(1,2)
      !lisegaConfig = !lisegaType + !lisegaNumber
      -- end of Lisega
      !noOfHangers = !!ce.mcount
      if !noOfHangers.gt(1) then
        $!supportName/H1
        !tconn = tconn
        !tdir  = tdir
        do !loop from 1 to 10
          -- This is in until we get LICAD fixed to stop the need to set the TCON TBOR
          if !lisegaConfig.eq('LS34') then
            skip
          endif
          -- end of Lisega
          $!supportName/H$!loop
          handle ANY
          elsehandle NONE
            tcon $!tconn
            tdir $!tdir
          endhandle
        enddo
      endif
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle

  -- In order to keep PDMS and the manufacturers software up to date we need to savework

  -- reset :mdsancref attributes if set
  !this.support.plateconns.restoreconns()

  -- disable the savework if we are using autotesting because we need to be able to keep the standard test site
  -- unchanged which may not be the case after a modify operation.
  if !!mdsHangIf.neq('LISEGA') then
    savework
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      --$P Savework issued to save $!this.ce.name
      handle ANY
      endhandle
    endhandle
  endif
  -- Display hanger check utility if needed

  if !!mdsHangIf.eq('LISEGA') then
    !!mdsCheckHang.init(!this.ce)
    !posnumtest = !this.ce.cref.members[1].:MDSposnum
    handle ANY
    elsehandle NONE
      if defined(!!mdsFixPosNum) then
        if !this.ce.:mdsposnummax.real().gt(0) then
          handle ANY
          elsehandle NONE
            !!mdsFixPosNum.comparePosNum(!this.ce)
          endhandle
        endif
      endif
    endhandle
  elseif !!mdsHangIf.eq('CPL') then
  elseif !!mdsHangIf.eq('PSL') then
  endif

  rest
  handle ANY
  endhandle


  -- Reset MDSDynoffset values to 0
  !!mdsDynOffset.offsetx.val = 0
  !!mdsDynOffset.anglex.val = 0
  !!mdsDynOffset.offsety.val = 0
  !!mdsDynOffset.angley.val = 0

  -- !fileToRunIn.delete()

endmethod

-- <RM> 13 Oct 06 -- returns true if pipe and support surface are parallel
define method .isparallel(!atta is DBREF, !tdir is DIRECTION) is BOOLEAN

  if !!mdsHangIf.eq('LISEGA') then
    !currentelem = !!ce
    !!ce = $!atta
    !config = !!ce.cref.owner.:USTHcfgKey
    handle ANY
      !licadconfig = 'UNSET'
    elsehandle NONE
      !split = !config.split('.')
      !licadconfig = !split[1] & !split[2]
      handle any
        !licadconfig = 'UNSET'
      endhandle
    endhandle
    $!currentelem
  endif

  pin 1 copy pl of $!atta
  var !attadir dir pin 1
  !angle = !attadir.direction().angle(!tdir)
  if !licadconfig.eq('LD01') then
    if !angle.eq(90) or !angle.eq(270) then
      return TRUE
    else
      return FALSE
    endif
  else
    if !angle.between(89.9,90.1) or !angle.between(269.9,271.1) then
      return TRUE
    else
      return FALSE
    endif
  endif

endmethod
-- <RM> 13 Oct 06 -- end of fix)
