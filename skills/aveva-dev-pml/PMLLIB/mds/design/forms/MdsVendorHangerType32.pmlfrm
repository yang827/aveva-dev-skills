  !this.boresMM[8]  = '13'
  !this.boresMM[10]  = '17'
  !this.boresMM[15]  = '21.3'
  !this.boresMM[20]  = '26.9'
  !this.boresMM[25]  = '33.7'
  !this.boresMM[32]  = '42.4'
  !this.boresMM[40]  = '48.3'
  !this.boresMM[50]  = '60.3'
  !this.boresMM[65]  = '73'
  !this.boresMM[76]  = '76.1'
  !this.boresMM[80]  = '88.9'
  !this.boresMM[108] = '108'
  !this.boresMM[100] = '114.3'
  !this.boresMM[125] = '139.7'
  !this.boresMM[133] = '133'
  !this.boresMM[140] = '139.7'
  !this.boresMM[159] = '159'
  !this.boresMM[150] = '168.3'
  !this.boresMM[194] = '193.7'
  !this.boresMM[200] = '219.1'
  !this.boresMM[245] = '244.5'
  !this.boresMM[267] = '267'
  !this.boresMM[250] = '273'
  !this.boresMM[300] = '323.9'
  !this.boresMM[350] = '355.6'
  !this.boresMM[368] = '368'
  !this.boresMM[400] = '406.4'
  !this.boresMM[419] = '419'
  !this.boresMM[450] = '457.2'
  !this.boresMM[500] = '508'
  !this.boresMM[550] = '558.8'
  !this.boresMM[600] = '609.6'
  !this.boresMM[650] = '660.4'
  !this.boresMM[700] = '711.2'
  !this.boresMM[750] = '762'
  !this.boresMM[800] = '812.8'
  !this.boresMM[900] = '914.4'

endmethod

---------------------
-- form cancel method
---------------------

define method .cancel()

  $!this.ce
  if (!!ce.stype.eq('MH01')) then
    !!mdsmodifysupp.cancel.active = TRUE
    !this.clear()
    !this.hide()
  else
    !!mdsHangerType32.name.val= !this.name.val
    !!mdsHangerType32.cancelHanger(TRUE)
    !this.clear()
    !this.hide()
  endif

  -- Delete the support if nothing has been created

  !!mdsDacControl(TRUE)

  !!ce = !this.ce
  !attaName = !!ce
  goto cref
  handle NONE
    !members = !!ce.mcount
    if !members.eq(0) then
      rest
      delete rest
      !!ce = !attaName
      delete atta
    endif
  elsehandle ANY
  endhandle

  !!mdsDacControl(FALSE)

endmethod

-------------------------------------------------------------------------------------
-- method to build hanger
-------------------------------------------------------------------------------------

define method .buildHanger(!file is STRING)

  !cancelCode = FALSE

  !fExists = object FILE(!file)
  if !fExists.exists() and !!mdsHangIf.eq('LISEGA') then
    --read the first line to see if LICAD has returned a cancel code
    !fileLines = !!readPdmsFile('/$!file')
    if !fileLines.size().neq(0) then
      if !fileLines[1].match('ERROR').gt(0) then
        !cancelCode = TRUE
      elseif !fileLines.size().eq(1) then
        !cancelCode = TRUE
      endif
    endif
  endif

  if (!fExists.exists() and !cancelCode.neq(TRUE)) then

    !fileLines = !!readPdmsFile('/$!file')
    if !fileLines.size().eq(0) then
      -- Delete from LICAD
      !delete = !!mdsDeleteSuppLicad(!this.ce.namn)
      !!mdsDacControl(FALSE)
      return error 1 |No commands found in Interface output file, please try again!|
    endif
    -- !hangers = 1 - !hangers only used once
    !supportName = !this.ce.name

    -- When the Hanger is being modified delete the members
    -- because the LOF file creates every time
    if (!!ce.stype.eq('MH01')) then
      !attaName = !!ce.name
      do !x from 1 to 10
        if ('$!attaName/H$!x' EQ '$!attaName/H1') then
          $!attaName/H1
          handle ANY
          endhandle
          delete hanger mem
          handle ANY
          endhandle
          -- Mod to ensure hhdir correct
          conn HH to $!attaName
          own
        else
          do !deleteHangers from 2 to 10
            rest
            $!deleteHangers
            handle ANY
              break
            elsehandle NONE
              delete hanger
            endhandle
          enddo
        endif
      enddo
    endif

    --** PRE BUILD Interface Specific DATA
    -- These pre build object return the array !fileLines as an input macro

    if !!mdsHangIf.eq('LISEGA') then
      !mdsLISEGA = object MDSLISEGA(!!mdsVendorHangertype32, !!mdsHangerType32)
      !fileLines = !mdsLISEGA.preBuild(!fileLines)
      !software = 'Licad'
    elseif !!mdsHangIf.eq('CPL') then
      !mdsCPL = object MDSCPL(!!mdsVendorHangertype32, !!mdsHangerType32)
      !fileLines = !mdsCPL.preBuild(!fileLines)
      !software = 'WitchHanger'
    elseif !!mdsHangIf.eq('PSL') then
      !mdsPSL = object MDSPSL(!!mdsVendorHangertype32, !!mdsHangerType32)
      !fileLines = !mdsPSL.preBuild(!fileLines)
      !software = 'PSDesigner'
    endif


    -- ** END of PRE BUILD

    -- Save the tail position of hanger 1 in case its offset
    !mdsDynOffset = :MDSDynOffset of $!supportName/H1
    !savedTailDirection = tdir of $!supportName/H1 wrt /*
    !numberOfErrors = 0
    do !runLines values !fileLines
      if !runLines.match('--').eq(1) OR !runLines.occurs('handle any').eq(1) OR !runLines.occurs('endhandle').eq(1) then
        skip
      endif

      $!runLines
      handle (61,7)
        write |Orientation ERROR in manufacturers input FILE|
        ori
      elsehandle NONE
      elsehandle ANY

        skip if (!runLines.upcase().match('!!JSLISEGANUTS').gt(0))

        --<RM> REFACTOR 17/02/10 added the check for :MDSCPLWEIGHT because the refactor code is based upon the bugfix branch which contains sp5.7 fixes
        --for cpl weight whilst the refactor development branch is based upon the latest released version of sp5.6. this fix is temporary until
        --the changes from the 5.7 release are included in this branch via rebase and the required database is available. DELETE AFTER THIS HAS HAPPENED.
        if !runLines.upcase().match('CONN PT TO').eq(0) and !runLines.upcase().match(':MDSCPLWEIGHT').eq(0) then
          if !numberOfErrors.eq(0) then
            --$P Error occurred in manufacturers input file with the following lines
          endif
          --$P <<< $!runLines >>>
          !part1 = !!error.text.after('(').before(',')
          !part2 = !!error.text.after(',').before(')')
          !!messageFile.softMessage($!part1,$!part2)
          !numberOfErrors = !numberOfErrors + 1
        endif
      endhandle
    enddo

    if !numberOfErrors.gt(0) then
      if !numberOfErrors.eq(1) then
        !!alert.error('Error - An error occurred in the $!software output file, please see the command line for details')
      else
        !!alert.error('Error - $!numberOfErrors errors occurred in the $!software output file, please see the command line for details')
      endif

      -- Delete corrupt hangers
      !!mdsDacControl(TRUE)
      !!ce = !this.ce
      !attaNameS = !!ce
      !attaNameString = !!ce.namn
      goto cref
      handle NONE
        rest
        -- Uncomment the two lines below to clear up the hanger
        --delete rest
        !!ce = !attaNameS
        --delete atta
      elsehandle ANY
      endhandle
      -- Delete lugs if existing
      do !lug from 1 to 4
        $!attaNameS/LUG$!lug
        handle ANY
        elsehandle NONE
          delete olet
        endhandle
      enddo
      -- Delete from manufacturers software
      if !!mdsHangIf.eq('LISEGA') then
        !delete = !!mdsDeleteSuppLicad(!attaNameString)
      elseif !!mdsHangIf.eq('CPL') then
        !delete = !!mdsDeleteSuppCPL(!attaNameString)
      elseif !!mdsHangIf.eq('PSL') then
      endif
      !!mdsDacControl(FALSE)
      return
    endif

    !!ce = !attaName.dbref()
    goto cref
    tdir $!savedTailDirection

    -- Update uda's
    !amHere = !!ce
    $!supportName/REST
    !ustMovements = :USTMovement
    handle NONE
      !ustForces    = :USTForces
      !ustTestLoad  = :USTTestLoad
      $!supportName
      :MDSMoveX $!ustMovements[2]
      -- <GE> 15/11/06 Added additional handles for data not
      -- being set via the Witch Hanger interface return file
      handle ANY
      endhandle
      :MDSMoveY $!ustMovements[1]
      handle ANY
      endhandle
      :MDSMoveZ $!ustMovements[3]
      handle ANY
      endhandle
      :MDSLoad  $!ustForces[1]
      handle ANY
      endhandle
      -- <GE> 15/11/06
      :MDSHLoad $!ustTestLoad
    elsehandle ANY
    endhandle
    !!ce = !amHere

    -- When the Hanger is first created from a horz template add extra fittings
    --<wd>11aug2009 -- DFN P-22111 (SI-13209) *** PML CODE changes added for HANGER types 31V and 32V on VERTICAL PIPES as well.

    --dun1218 i need to change the location that the second fitting is created on to member 4, if i don't then there are problems
    --when we come to swapping the :mdsconnect values if the H1 and H2 positions need to be swapped. member 4 should in any case mimic the
    --the first fitting creation method in the hanger object (i.e. creates the fitting on the second picked member - start
    --$!this.steelMem[3]
    $!this.steelMem[4]
    --dun1218 i need to change the location that the second fitting is created on to member 4, if i don't then there are problems
    --when we come to swapping the :mdsconnect values if the H1 and H2 positions need to be swapped. member 4 should in any case mimic the
    --the first fitting creation method in the hanger object (i.e. creates the fitting on the second picked member - end

    handle ANY
    elsehandle NONE
      if !this.virtualFitting then
        --need to copy the first virtual fitting and set it up to be the second

        --$!this.ce.name/FITT/H1
        !this.virtualFittingNames[1].mdsConnect[1] = !this.beamArray[2]
        !this.virtualFittingNames[1].mdsConnect[2] = !this.beamArray[1]
        -- Now Navigate back to the valid Steel Supporting Member which EXISTS to CREATE the NEW SECOND FITTING
        $!this.steelMem[4]

        !this.virtualFittingNames[2] = !this.virtualFittingNames[1]
        !this.virtualFittingNames[2].owner = !!ce
        !this.virtualFittingNames[2].name = !this.virtualFittingNames[1].name.replace('/H1', '/H2')
        -- Current element is the FITTING element .../FITT/H2 - Therefore Set the UDA :MDSCONNECT with the DOUBLE Channel DBREFS and the POSLINE to TOC
        --REFACTOR the top of channel is not always the TOC pline, we must therefore do a check for H2 to determine which pline to connect to
        --POSL TOC
        pin 9 copy pl of $!attaName
        pin 8 copy pin 9
        pin 8 dir d wrt /*
        $!this.beamArray[3]
        pin1 at ppline na start
        Pin1 dir d
        pin1 throu pin8
        !zDirOfSctn = zdir wrt world
        pin 9 at ce
        pin 9 dir $!zDirOfSctn
        pin 9 PLANE pin 9 thro $!attaName
        pin 9 dir from pin 8 to pin 9
        var !hdir pin 9 dir wrt /*
        !furthestPline = !!kfarpline(!!ce,!attaName.dbref().position.wrt( /* ),!hdir.direction())
        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !furthestPline.size() by 2
          if !furthestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!furthestPline[$!plineNumber]
        !this.virtualFittingNames[2].posline = !plineName
        --REFACTOR the top of channel is not always the TOC pline, we must therefore do a check for H2 to determine which pline to connect to

        --REFACTOR now work out the correct delpos - start
        -- DTF >>> double channel crossing we need the DELPOS to be set to allow the FITTING to be placed between channels
        !channel1dir = !this.beamArray[3].plori.na.ydir().wrt( /* )
        !channel2dir = !this.beamArray[4].plori.na.ydir().wrt( /* )

        if !channel1dir.eq(!channel2dir) then
          pin 3 at ppline NA start of $!this.beamArray[3]
          pin 4 at ppline NA start of $!this.beamArray[4]
        else
          pin 3 at ppline NA start of $!this.beamArray[3]
          pin 4 at ppline NA end of $!this.beamArray[4]
        endif

        var !xOffset constr dist pin 3 to pin 4
        !move = (!xOffset.real() * 0.5)
        var !zDir ppline NA x dir of $!this.virtualFittingNames[2].owner wrt /*
        !currentDelpos = !this.virtualFittingNames[2].getdelpos()
        !currentDelpos.north = 0
        !currentDelpos.east = 0
        !currentDelpos.up = 0
        !this.virtualFittingNames[2].delPosition = !currentDelpos
        !pos = !this.virtualFittingNames[2].getPosition()
        !pv = object POINTVECTOR(!pos, !zDir.direction())
        !pv = !pv.offset(!move)
        !this.virtualFittingNames[2].setdelpos(!pv.position)
        !this.virtualFittingNames[2].mdsConnect[1] = !this.beamArray[4]
        !this.virtualFittingNames[2].mdsConnect[2] = !this.beamArray[3]

        $!this.ce.name/H2
        handle ANY
        elsehandle NONE
          $!this.ce.name/H1
          CONN PT TO LAST MEM
          TCONN WELD
        endhandle

        --REFACTOR, it is quite possible depending upon the order in which beams were selecting
        --during creation that the hanger 1 fitting is located at the hanger 2 last mem and visa versa
        --we need to correct this so find the distance between fitting 1 and fitting 2 (dist) and if the distance between
        --fitt/h1 and lastmem of the hanger is greater than dist/2 then we need to swap
        !virtFittPos1 = !this.virtualFittingNames[1].getPosition()
        pin 1 at $!virtFittPos1
        !virtFittPos2 = !this.virtualFittingNames[2].getPosition()
        pin 2 at $!virtFittPos2

        --make sure the pins are at the same level
        pin 2 dir u wrt /*
        pin 2 thro pin 1
      else
        --><wd>17aug2009 -- DFN P-22111 (SI-13209 - TWIN HANGERS supported from Double Channel SCTN types
        -- Navigate to the FITTING element .../FITT/H1 - Therefore Set the UDA :MDSCONNECT with the DOUBLE Channel DBREFS and the POSLINE to TOC
        $!this.ce.name/FITT/H1
        --POSL TOC
        --!!ce.:MDSConnect[1] = !this.steelMem[1]
        --!!ce.:MDSConnect[2] = !this.steelMem[2]
        --REFACTOR USE THE FORM .beamArray member to set the mdsconnect array
        --!!ce.:MDSConnect[1] = !this.beamArray[1]
        --!!ce.:MDSConnect[2] = !this.beamArray[2]
        !!ce.:MDSConnect[1] = !this.beamArray[2]
        !!ce.:MDSConnect[2] = !this.beamArray[1]
        -- Now Navigate back to the valid Steel Supporting Member which EXISTS to CREATE the NEW SECOND FITTING

        --dun1218 i need to change the location that the second fitting is created on to member 4, if i don't then there are problems
        --when we come to swapping the :mdsconnect values if the H1 and H2 positions need to be swapped. member 4 should in any case mimic the
        --the first fitting creation method in the hanger object (i.e. creates the fitting on the second picked member - start
        --$!this.steelMem[3]
        $!this.steelMem[4]
        --dun1218 i need to change the location that the second fitting is created on to member 4, if i don't then there are problems
        --when we come to swapping the :mdsconnect values if the H1 and H2 positions need to be swapped. member 4 should in any case mimic the
        --the first fitting creation method in the hanger object (i.e. creates the fitting on the second picked member - end

        --<<wd>17aug2009 -- DFN P-22111 (SI-13209
        NEW FITT COPY $!this.ce.name/FITT/H1 NAME $!this.ce.name/FITT/H2
        handle ANY
          delete fitt
          $!this.ce.name/H2
          TREF $!this.ce.name/FITT/H2
          handle ANY
            TREF $!this.ce.name/SBFI/H2
          endhandle
          $!this.ce.name/H1
          CONN PT TO LAST MEM
          TCONN WELD
          TREF $!this.ce.name/FITT/H1
          handle ANY
            TREF $!this.ce.name/SBFI/H1
          endhandle
        elsehandle NONE
          !fittRef = !!ce
          -- Current element is the FITTING element .../FITT/H2 - Therefore Set the UDA :MDSCONNECT with the DOUBLE Channel DBREFS and the POSLINE to TOC
          --REFACTOR the top of channel is not always the TOC pline, we must therefore do a check for H2 to determine which pline to connect to
          --POSL TOC
          pin 9 copy pl of $!attaName
          pin 8 copy pin 9
          pin 8 dir d wrt /*
          $!this.beamArray[3]
          pin1 at ppline na start
          Pin1 dir d
          pin1 throu pin8
          !zDirOfSctn = zdir wrt world
          pin 9 at ce
          pin 9 dir $!zDirOfSctn
          pin 9 PLANE pin 9 thro $!attaName
          pin 9 dir from pin 8 to pin 9
          var !hdir pin 9 dir wrt /*
          !furthestPline = !!kfarpline(!!ce,!attaName.dbref().position.wrt( /* ),!hdir.direction())
          -- We only need the pline that can be connected to, these are
          -- TOS, BOS, TOC, BOC, LEFT, RIGH
          do !getPlineNumber from 1 to !furthestPline.size() by 2
            if !furthestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
              !plineNumber = !getPlineNumber
              break
            endif
          enddo
          !plineName = pkey of $!furthestPline[$!plineNumber]
          !!ce = !fittRef
          posl $!plineName
          --REFACTOR the top of channel is not always the TOC pline, we must therefore do a check for H2 to determine which pline to connect to

          --REFACTOR now work out the correct delpos - start
          -- DTF >>> double channel crossing we need the DELPOS to be set to allow the FITTING to be placed between channels
          !channel1dir = !this.beamArray[3].plori.na.ydir().wrt( /* )
          !channel2dir = !this.beamArray[4].plori.na.ydir().wrt( /* )

          if !channel1dir.eq(!channel2dir) then
            pin 3 at ppline NA start of $!this.beamArray[3]
            pin 4 at ppline NA start of $!this.beamArray[4]
          else
            pin 3 at ppline NA start of $!this.beamArray[3]
            pin 4 at ppline NA end of $!this.beamArray[4]
          endif
          var !xOffset constr dist pin 3 to pin 4
          !move = (!xOffset.real() * 0.5)
          --var !tocDir ppline TOC z dir of $!this.beamArray[3]
          --if !tocDir eq 'U'  then
          var !zDir ppline NA x dir of  $!this.beamArray[3] wrt ce
          --else
          --  var !zDir ppline NA -x dir of  $!this.beamArray[3] wrt ce
          --endif
          delp E 0 N 0 U 0
          delp $!zDir $!move
          --REFACTOR now work out the correct delpos - start

          --REFACTOR USE THE FORM .beamArray member to set the mdsconnect array
          --!!ce.:MDSConnect[1] = !this.steelMem[3]
          --!!ce.:MDSConnect[2] = !this.steelMem[4]
          !!ce.:MDSConnect[1] = !this.beamArray[4]
          !!ce.:MDSConnect[2] = !this.beamArray[3]
          !!ce.:MDSConnectN = !this.beamArray[2].name

          $!this.ce.name/H2
          handle ANY
          elsehandle NONE
            TREF $!this.ce.name/FITT/H2
            $!this.ce.name/H1
            CONN PT TO LAST MEM
            TCONN WELD
            TREF $!this.ce.name/FITT/H1
          endhandle
        endhandle
      endif
    endhandle

  elseif (!fExists.exists() and !cancelCode.eq(TRUE)) then

    -- we have received a cancel code from LICAD we need to skip to the end of the creation process
    -- without deleting the hanger so that any automatic testing can continue
    if defined(!!licadAutoTestEnabled) then
      -- do nothing
    else
      if defined(!!mdsundolicad) then
        !!mdsundolicad.restoreHanger(TRUE)
      endif
    endif
    return

  else

    -- If file does not exist, i.e user has cancelled

    !!mdsHangerType32.name.val= !this.name.val

    !supportName = !this.ce.name
    !manIFConfigString = :USTHCFGKEY of $!supportName/REST
    handle ANY
      -- must NOT be LISEGA
      !manIFConfigString = ||
    endhandle
    -- If :USTHCFGKEY of REST not set and just to make sure hanger 1 members not gt 1
    -- only then can we delete the hanger otherwise it could be in modify mode with a changed name.

    if !manIFConfigString.string().upcase().eq('UNSET') and !this.ce.cref.owner.members.size().gt(1).not() then
      !!mdsHangerType32.cancelHanger(TRUE)
    endif
    !this.clear()
    !this.hide()
    if !!mdsHangIf.eq('CPL') then
      -- !delete = !!mdsDeleteSuppCPL(!attaNameString)
      !!alert.error('Support has not been completed within WitchHanger')
      -- Delete corrupt hangers
      !!mdsDacControl(TRUE)
      !!ce = !this.ce
      !attaNameS = !!ce
      !attaNameString = !!ce.namn
      goto cref
      handle NONE
        rest
        -- Uncomment the two lines below to clear up the hanger
        delete rest
        !!ce = !attaNameS
        delete atta
      elsehandle ANY
      endhandle

    endif
    return
  endif

  -- *********************
  -- Start of generic code
  -- *********************

  -- Position the fittings of the hanger/s in the correct place
  -- After reconnecting the tails

  !steelConns = !!mdsVendorHangertype32.steelMem
  --do !clearBadRefs from 1 to !steelConns.size()
  do !clearBadRefs indices !steelConns
    if !steelConns[$!clearBadRefs].badref() then
      !steelConns[$!clearBadRefs].delete()
    endif
  enddo
  !steelConns.compress()

  do !count from 1 to 10
    $!this.ce.name/H$!count
    handle ANY
      break
    endhandle
    pos ht at pl of last mem
    pin 4 at ht
    goto tref
    handle NONE
      --dun1218 add code to deal with virtual fittings when a fitting exists on the write protected steelwork
      if !this.virtualFitting then
        --construct the zdistance equivalent of 'zdist thro ht of cref' as above
        !this.virtualFittingNames[!count].zDistThrough(!!ce.tpos)
        handle ANY
        endhandle
      elseif !!ce.type.eq('FITT') then
        !!mdsDacControl(TRUE)
        zdist thro ht of cref
        !!mdsDacControl(FALSE)
      endif
    elsehandle ANY
      --dun1218 deal with the case when we have a virtual fitting (i.e no write access to the steelwork) - start
      if !this.virtualFitting then
        --construct the zdistance equivalent of 'zdist thro ht of cref' as above
        !this.virtualFittingNames[!count].zDistThrough(!!ce.tpos)
        handle ANY
        endhandle
      endif
      --dun1218 deal with the case when we have a virtual fitting (i.e no write access to the steelwork) - end
    endhandle
  enddo

  -- When the hanger is located on a sloping line check to see if it needs moving
  $!this.ce.name
  handle NONE
    -- Test if atta in line is on a slope
    !gradient = !!ce.ldir

    !attaDirs = !!mdsRemoveGrad(!!ce)
    !dir = !!ce.cref.tdir
    if ( !dir.angle(!attaDirs[1]).lt(.1) and !dir.angle(!attaDirs[1]).gt(-.1) ) or $
      ( !dir.angle(!attaDirs[1]).gt(179.9) and !dir.angle(!attaDirs[1]).lt(180.1)) then
      -- Pipe and support direction parallel dynamic

    else
      if !gradient.up.eq(0) then
        -- Horizontal line
        -- Test to see if pipe parallel to wall / floor etc
        !parallelTest = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)
        if !parallelTest[1].not() and !parallelTest[3].nint().neq(90) then
          -- if not parallel we may need to move clamp along pipe
          !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
        endif
      elseif !gradient.up.abs().eq(1) then
        -- Vertical line

        -- <RM> 21 November 2006 -- if we have a vertical line with an LD01 run !!mdsInterfaceModAttaPos
        -- regardless of orientation as it should work for all cases
        if !!mdsHangIf.eq('LISEGA') then
          !currentElem = !!ce
          !!ce = $!attaName
          !config = !!ce.cref.owner.:USTHcfgKey
          handle ANY
            !licadConfig = 'UNSET'
          elsehandle NONE
            !split = !config.split('.')
            !licadConfig = !split[1] & !split[2]
            handle ANY
              !licadConfig = 'UNSET'
            endhandle
          endhandle
          if !licadConfig inset('LD01') or !licadConfig inset('LD09')  then
            !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
          endif
          $!currentElem
        endif
        -- <RM> 21 November 2006 -- end of fix
      else
        -- Only adjust if the tail dir is U/D not horizontal
        !pipeAngle = !!ce.ldir.string().after(' ').before(' ').real()

        --        !tailDirection = !!ce.cref.tdir.string().before(' WRT')
        !tailDirection = !!ce.cref.tdir.up.nint()
        if !tailDirection.eq(-1) or !tailDirection.eq(1) then
          -- Sloping line
          -- Determine the LICAD Type from the SECOND Field of the LICAD UDA :USTHCFGKEY e.g.
          -- Navigate to REST to get the value for the UDA:USTHCFGKEY 'LD.02.73.00.16'
          -- <-- where the --> LICAD TYPE = '02'
          -- Also do not adjust when the type is 7H/7V with a offset (:MDSDynOffset)
          !mdsDynOffset = !this.ce.cref.:MDSDynOffset
          !unusedTestForPosition = !mdsDynOffset
          handle ANY
          elsehandle NONE
            --if !this.ce.cref.:MDSDynOffY.eq(0) then
            -- we need an additional check to make sure that if the pipe is sloping and
            -- the sctn is sloping then if they are truly parallel then we should not
            -- modify the atta position when creating the hanger.
            -- Richard Martin 05/07/06
            -- get the connected sctn ref
            !stRef = !supportName.dbref().cref.tref.owner.string()
            handle ANY
            endhandle
            --var !stRef owner of tref of cref of $!supportName
            !sctn = !stRef.dbref()
            handle ANY
              -- <RM> 06/11/06 -- additional handle included for when we have no sctn reference.
            elsehandle NONE
              -- get the atta ref
              !comp = !supportName.dbref()
              -- run parallel check to see if we have a sloping section and horizontal line
              !check1 = !!mdsistubeparallel2sctn(!comp, !sctn)
              -- run parallel check to see if we have a sloping section and sloping line that are parallel
              if !sctn.type.eq('SCTN') then
                !check2 = !!mdsistubeslopeparallel2sctn(!comp, !sctn)
                -- get the connected sctn ref
                var !stRef owner of tref of cref
                !sctn = !stRef.dbref()
                -- get the atta ref
                !comp = !!ce

                var !posline posl of tref of cref
                var !dir1 dir from ppli na of $!sctn to ppli $!posline of $!sctn
                var !p9dir dir p9 of $!comp

                !dirDot = !p9dir.direction().dot(!dir1.direction())
                if !check2 neq TRUE then
                  if !check1 eq TRUE then
                    !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
                  elseif !dirDot.abs().gt(0.999999) then
                    -- do not mod atta pos because the sctn orientation is parallel
                  else
                    !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
                  endif
                endif
              else
                -- Type not a SCTN
                !checkX = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)
                if !checkX[1] neq TRUE then
                  !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
                endif
              endif
              --endif
            endhandle
            -- <RM> 06/11/06 -- end of fix
          endhandle
        else
          -- Test to see if pipe parallel to wall / floor etc
          !parallelTest = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)
          if !parallelTest[1].not() then
            -- if not parallel we may need to move clamp along pipe
            !!mdsInterfaceModAttaPos(!!ce,'CREATE',!!mdsHangerType32)
          endif
        endif
      endif
    endif
  elsehandle ANY
  endhandle

  -- The modification of a hanger may have changed the support function, therefore
  -- reset the stex if needed

  !!ce = !this.ce
  handle NONE
    !!mdsTransport(!!ce,!!ce.name)
  elsehandle ANY
    -- Cancelled hanger
    return
  endhandle

  !!mdsDacControl(TRUE)

  -- *******************
  -- End of generic code
  -- *******************

  -- Action any post build Interface Specific code
  if !!mdsHangIf.eq('LISEGA') then
    !mdsLISEGA.postbuild()
  elseif !!mdsHangIf.eq('CPL') then
    !mdsCPL.postbuild()
  elseif !!mdsHangIf.eq('PSL') then
    !mdsPSL.postbuild()
  else
    !!alert.error('No interface detected')
  endif

  -- Reposition fitt after rebuilding support in different ori
  !iAmHere = !!ce
  $!supportName/H1
  handle NONE
    goto tref
    handle NONE
      --dun1218 add code to deal with virtual fittings when a fitting exists on the write protected steelwork
      if !this.virtualFitting then
        $!supportName/H1
        --construct the zdistance equivalent of 'zdist thro tpos' as above
        !this.virtualFittingNames[1].zDistThrough(!!ce.tpos)
      elseif !!ce.type.eq('FITT') then
        !!mdsDacControl(TRUE)
        zdist thro ht of cref
        !!mdsDacControl(FALSE)
      endif
    elsehandle ANY
      --dun1218 deal with the case when we have a virtual fitting (i.e no write access to the steelwork) - start
      $!supportName/H1
      if !this.virtualFitting then
        --construct the zdistance equivalent of 'zdist thro tpos' as above
        !this.virtualFittingNames[1].zDistThrough(!!ce.tpos)
      endif
      --dun1218 deal with the case when we have a virtual fitting (i.e no write access to the steelwork) - end
    endhandle
  elsehandle ANY
  endhandle
  !!ce = !iAmHere

  -- By default only 1 hanger is created, if 2 are then set the dir and conn to the same as one
  -- This section could possibly be moved into the MDSLISEGA object or modified to be none LISEGA specific
  rest
  handle NONE
    -- LISEGA only Remove the next 3 lines when lines 2481 removed
    !lisegaType = !!ce.:USTHCFGKEY.substring(1,2)
    handle NONE
      !lisegaNumber = !!ce.:USTHCFGKEY.after('.').substring(1,2)
      !lisegaConfig = !lisegaType + !lisegaNumber
      -- end of LISEGA
      !noOfHangers = !!ce.mcount
      if !noOfHangers.gt(1) then
        $!supportName/H1
        !tconn = tconn
        !tdir  = tdir
        do !loop from 1 to 10
          -- This is in until we get LICAD fixed to stop the need to set the TCON TBOR
          if !lisegaConfig.eq('LS34') then
            skip
          endif
          -- end of LISEGA
          $!supportName/H$!loop
          handle ANY
          elsehandle NONE
            tcon $!tconn
            tdir $!tdir
          endhandle
        enddo
      endif
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle

  -- In order to keep PDMS and the manufacturers software up to date we need to savework
  -- reset :MDSANCREF attributes if set
  !this.support.plateconns.restoreconns()

  -- disable the savework if we are using automatic testing because we need to be able to keep the standard test site
  -- unchanged which may not be the case after a modify operation.
  if !!mdsHangIf.neq('LISEGA') then
    if undefined(!!mdsAutoTestRunning) then
      savework
      handle ANY
        !!alert.error(!!error.text)
      elsehandle NONE
        --$P Savework issued to save $!this.ce.name
        handle ANY
        endhandle
      endhandle
    endif
  endif
  -- Display hanger check utility if needed

  if !!mdsHangIf.eq('LISEGA') then
    !!mdsCheckHang.init(!this.ce)
    !posNumTest = !this.ce.cref.members[1].:MDSPosNum
    handle ANY
    elsehandle NONE
      if defined(!!mdsFixPosNum) then
        if !this.ce.:MDSPosNumMax.real().gt(0) then
          handle ANY
          elsehandle NONE
            !!mdsFixPosNum.comparePosNum(!this.ce)
          endhandle
        endif
      endif
    endhandle
  elseif !!mdsHangIf.eq('CPL') then
  elseif !!mdsHangIf.eq('PSL') then
  endif

  rest
  handle ANY
  endhandle

  -- Reset !!mdsInterfaceDynOffset values to 0
  !!mdsInterfaceDynOffset.offsetX.val = 0
  !!mdsInterfaceDynOffset.angleX.val = 0
  !!mdsInterfaceDynOffset.offsetY.val = 0
  !!mdsInterfaceDynOffset.angleY.val = 0

  --dun1218 if we have a virtual fitting then now is the time we need to write out a connection macro so that the fittings can be run in
  --by a user who has access to the appropriate steelwork zone - start
  if !this.virtualFitting then
    !completed = !this.virtualFittingNames[1].connectionMacroTwoFittings(!this.virtualFittingNames)
    handle ANY
      !!alert.error('This hanger has not finished building properly, the required connection macro for the hanger could not be written')
    endhandle

    --dun1218 create the required UDA references which will allow a hanger to be modified when we have no access to a steelwork db - start
    if !completed then
      $!supportName/H1
      !hanger1SupportSteel = object ARRAY()
      !hanger1SupportSteel.append(!this.virtualFittingNames[1].mdsConnect[1])
      --add the second steelwork member
      !hanger1SupportSteel.append(!this.virtualFittingNames[1].mdsConnect[2])
      !!ce.:MDSCIVREF = !hanger1SupportSteel
      !!ce.:MDSCIVPOSL = !this.virtualFittingNames[1].posline
      !!ce.:MDSTREF = !this.virtualFittingNames[1].name

      $!supportName/H2
      !hanger2SupportSteel = object ARRAY()
      !hanger2SupportSteel.append(!this.virtualFittingNames[2].mdsConnect[1])
      --add the second steelwork member
      !hanger2SupportSteel.append(!this.virtualFittingNames[2].mdsConnect[2])
      !!ce.:MDSCIVREF = !hanger2SupportSteel
      !!ce.:MDSCIVPOSL = !this.virtualFittingNames[2].posline
      !!ce.:MDSTREF = !this.virtualFittingNames[2].name
    else
      !!alert.error('This hanger has not finished building properly, the required connection macro for the hanger could not be written')
    endif
  else
    $!supportName/H1
    !hanger1SupportSteel = object ARRAY()

    !hanger1SupportSteel.append(!!ce.tref.:mdsConnect[1])
    !hanger1SupportSteel.append(!!ce.tref.:mdsConnect[2])
    !!ce.:MDSCIVREF = !hanger1SupportSteel
    !!ce.:MDSCIVPOSL = !!ce.tref.posline
    !!ce.:MDSTREF = !!ce.tref.name

    $!supportName/H2
    !hanger2SupportSteel = object ARRAY()
    !hanger2SupportSteel.append(!!ce.tref.:mdsConnect[1])
    !hanger2SupportSteel.append(!!ce.tref.:mdsConnect[2])
    !!ce.:MDSCIVREF = !hanger2SupportSteel
    !!ce.:MDSCIVPOSL = !!ce.tref.posline
    !!ce.:MDSTREF = !!ce.tref.name
  endif
  --dun1218 create the required UDA references which will allow a hanger to be modified when we have no access to a steelwork db - end
  --dun1218 if we have a virtual fitting then now is the time we need to write out a connection macro so that the fittings can be run in
  --by a user who has access to the appropriate steelwork zone - end

endmethod

-- <RM> 13 Oct 06 -- returns true if pipe and support surface are parallel
define method .isparallel(!atta is DBREF, !tdir is DIRECTION) is BOOLEAN

  if !!mdsHangIf.eq('LISEGA') then
    !currentElem = !!ce
    !!ce = $!atta
    !config = !!ce.cref.owner.:USTHcfgKey
    handle ANY
      !licadConfig = 'UNSET'
    elsehandle NONE
      !split = !config.split('.')
      !licadConfig = !split[1] & !split[2]
      handle ANY
        !licadConfig = 'UNSET'
      endhandle
    endhandle
    $!currentElem
  endif

  pin 1 copy pl of $!atta
  var !attaDir dir pin 1
  !angle = !attaDir.direction().angle(!tdir)
  if !licadConfig.eq('LD01') then
    if !angle.eq(90) or !angle.eq(270) then
      return TRUE
    else
      return FALSE
    endif
  else
    if !angle.between(89.9,90.1) or !angle.between(269.9,271.1) then
      return TRUE
    else
      return FALSE
    endif
  endif

endmethod
-- <RM> 13 Oct 06 -- end of fix
