--------------------------------------------------------------------------------
--
-- File:    MdsVendorHangerType32.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Wed Oct 29 2003
--
-- Description:
-- Form Definition for interface to vendor software
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildHanger(STRING)              -
--  cancel()                         -
--  clear()                          -
--  init()                           -
--  isparallel(DBREF,DIRECTION)      BOOLEAN
--  oKmethod()                       -
--  steel()                          -
--  steelmod()                       -
--  unitsMM()                        -
--

-- Kill existing form definition

kill !!mdsVendorHangertype32

-- Define Form
setup form  !!mdsVendorHangertype32 noquit

  !!mdsVendorHangertype32.icontitle    = ||
  !!mdsVendorHangertype32.callback     = ||
  !!mdsVendorHangertype32.formrevision = ||
  !!mdsVendorHangertype32.okcall       = |!this.oKmethod()|

  init '!this.init()'

  -- Body of Form
  -- Support name
  para .nameTag at x1 ymax+0.5  text ' Support Name:'
  para .name at xmax+2 ymin width 18 lines 1
  para .manlarge at y0 pixmap width 0 height 50
  path down

  -- Pipe frame
  frame .pipeframe ' VPD Piping Data ' at x0 ymax_manlarge

    -- Pipe size
    para .pipeSizeTag at x1 ymax+0.5 text '      Pipe Bore:'
    para .pipeSize at xmax+2 ymin width 14 lines 1
    para .pipeSizeunit at xmax ymin text 'mm '

    -- Pipe temperature
    para .pipeTempTag at x1 ymax text '    Temperature:'
    para .pipeTemp at xmax+2 ymin width 14 lines 1
    para .pipeTempunit at xmax ymin text 'C  '

    -- Pipe Insulation
    para .pipeInsuTag at x1 ymax text ' Insulation Thk:'
    para .pipeInsu at xmax+2 ymin width 14 lines 1
    para .pipeInsuunit at xmax ymin text 'mm '

    -- Pipe Coordinates
    para .pipeXTag at x1 ymax    text '      Pipe East:'
    para .pipeX at xmax+2 ymin width 14 lines 1
    para .pipeXunit at xmax ymin text 'mm '

    -- Pipe Coordinates
    para .pipeYTag at x1 ymax    text '     Pipe North:'
    para .pipeY at xmax+2 ymin width 14 lines 1
    para .pipeYunit at xmax ymin text 'mm '

    -- Pipe Coordinates
    para .pipeZTag at x1 ymax    text ' Pipe Elevation:'
    para .pipeZ at xmax+2 ymin width 14 lines 1
    para .pipeZunit at xmax ymin text 'mm '

    -- Pipe Orientation
    para .pipeOriTag at x1 ymax text '    Orientation:'
    para .pipeOri at xmax+2 ymin width 15 lines 1

  exit

  -- Support Data frame
  frame .frame1 ' Support Data ' at x0
    vdist 1.5

    -- Pipe Loadings
    frame .frame2 ' Operational Loads ' at x1

      rgroup .hotcold frame '' at x3 Ymax horizontal call ||
        add tag ' [Hot] ' select 'On'
        add tag ' [Cold] ' select 'Off'
      exit

      text .pipeLoad   '   Normal : ' at x1 Ymax+0.5 width 8 numeric
      para .pLkN at xmax+1 ymin text 'kN  '

      text .emergencyLoad   'Emergency : ' at x1 Ymax+0.5 width 8 numeric
      para .eLkN at xmax+1 ymin text 'kN  '
      text .failureLoad   '  Failure : ' at x1 Ymax+0.5 width 8 numeric
      para .fLkN at xmax+1 ymin text 'kN  '

    exit

    frame .frame3 ' Movements (mm) ' at x30 ymin.frame2
      -- Pipe Movement xyz
      text .pipeXmovement at x1 ymin.pLkN  '    Mvm-Lateral: ' width 13 numeric
      para .x at xmax ymin text ' [+X]'
      text .pipeYmovement at x1 Ymax+0.5  ' Mvm-Horizontal: ' width 13 numeric
      para .y at xmax+1 ymin text '[+Y]'
      text .pipeZmovement at x1 Ymax+0.5  '   Mvm-Vertical: ' width 13 numeric
      para .z at xmax+1 ymin text '[+Z]'

    exit

  exit

  vdist 0.25

  -- Hanger frame
  frame .hangerframe ' VPD Hanger Data ' at x38 ymin.pipeframe

    -- Steel Connection_L
    para .steelTagL at x1 ymax+0.5 text '   Elevation 1:'
    para .steelTagEleL at xmax+2 ymin width 9 lines 1
    para .steelTagEleLunit at xmax ymin text 'mm '

    -- Steel Connection_R
    para .steelTagR at x1 ymax text '   Elevation 2:'
    para .steelTagEleR at xmax+2 ymin width 9 lines 1
    para .steelTagEleRunit at xmax ymin text 'mm '

    -- Steel Width
    para .steelWidth at x1 ymax  text '   Steel Width:'
    para .steelWidthVal at xmax+2 ymin width 9 lines 1
    para .steelWidthValunit at xmax ymin text 'mm '

    -- Steel Elevation
    para .steelXTag at x1 ymax    text '     Conn East:'
    para .steelX at xmax+2 ymin width 9 lines 1
    para .steelXunit at xmax ymin text 'mm '

    -- Steel Elevation
    para .steelYTag at x1 ymax    text '    Conn North:'
    para .steelY at xmax+2 ymin width 9 lines 1
    para .steelYunit at xmax ymin text 'mm '

    -- Steel Elevation
    para .steelZTag at x1 ymax    text 'Conn Elevation:'
    para .steelZ at xmax+2 ymin width 9 lines 1
    para .steelZunit at xmax ymin text 'mm '

    -- Hanger Connection
    para .steelConn at x1 ymax  text '     Conn Type:'
    para .steelConnType at xmax+2 ymin width 9 lines 1

    -- Hanger Type
    para .hangerType at x1 ymax  text '   Hanger Type:'
    para .hangerSelType at xmax+2 ymin width 9 lines 1

  exit

  -- Bottom Line
  button .ok      |   OK   | at x0 ymax+10  call |!this.oKmethod()|
  button .cancel  | Cancel | at xmax FORM-size ymax FORM-size call |!this.cancel()|

  -- Form Members
  member .size         is STRING
  member .attaOri      is ARRAY
  member .steelMem     is ARRAY
  member .boresMM      is ARRAY
  member .ce           is DBREF
  member .jointRotate  is BOOLEAN
  member .type         is STRING
  member .flangeWidth  is STRING
  member .flangeThk    is STRING
  member .flangeHeight is STRING
  member .support      is MDSINTERFACESUPPORT
  member .wpadmat      is DBREF
  member .currentUnits is STRING
  --REFACTOR add member to hold beam references of supporting steel/civils that support the hangers
  member .beamArray    is ARRAY

  --dun1218 added members to store whether or not we are dealing with a virtual fitting (i.e. no write access to steelwork)
  --and another to store the name of the virtualfitting object for use wherever we would normally be using a standard fitting
  member .virtualFitting is BOOLEAN
  member .virtualFittingNames is ARRAY

exit

-------------------------------------------------------------------------------
-- init method which is called on loading the form
-------------------------------------------------------------------------------

define method .init()
  var !units units
  !this.currentUnits = !units
  !!kGetSetUnits()

  --DUN1218 if we have a fitting object then the supporting steelwork is readonly - start
  !this.virtualFittingNames = object ARRAY()

  if !!mdsHangerType32.virtualFitting.set() then
    !this.virtualFitting = TRUE
    !this.virtualFittingNames.append(!!mdsHangerType32.virtualFitting)
    !this.virtualFittingNames.append(!!mdsHangerType32.virtualFitting2)
  else
    !this.virtualFitting = FALSE
  endif
  --DUN1218 if we have a fitting object named !!nameFITTH1 then the supporting steelwork is readonly - end

  --get the array of beams or civils that the hanger is going to be attached to
  !this.beamArray = !!mdsHangerType32.beamArray

  if (!this.name.val.eq('unset')) then
    !!alert.error('The Name of the Hanger is unset' )
    !this.clear()
    units $!this.currentUnits
    return error 1 noalert
  endif

  --<wd>30oct2009 - DFN - P-25277 SI-17086 - Must LOAD the BORES by calling the FORM METHOD !this.unitsMM()
  !this.unitsMM()
  --<wd>30oct2009 - DFN - P-25277 SI-17086 - Must LOAD the BORES by calling the FORM METHOD !this.unitsMM()

  !this.ce = !!ce

  if (!!ce.stype.eq('MH01')) then

    -- In case the support is a vertical hanger and the atta has been repositioned via
    -- the distance or through buttons we need to reposition the tail of the hanger before
    -- sending the data to the manufacturers software

    -- Only do this if the :MDSDynOffset is unset and it is not a type 7 (dynamic)

    -------------------------------------------------------------------------------------------------------
    -------------------------------------------------------------------------------------------------------
    !defaultTpos = !this.ce.cref.tpos
    !!mdsInterfaceReposTail(!this.ce,!defaultTpos)
    !!ce = !this.ce

    -------------------------------------------------------------------------------------------------------
    --<wd>28nov2006> The SYNTAX has already been changed for the FIX for HPD0033742 <GE> 15/11/06
    -- shown below by Neale Morris to --> !this.name.val = !!ce.namn

    -- Fix for HPD0033742 <GE> 15/11/06
    -- Used too remove slashes in support name
    --    !this.name.val = !!ce.name.replace('/','')
    !this.name.val = !!ce.namn

    -------------------------------------------------------------------------------------------------------
    !this.pipeSize.val = !!ce.lbor.string().split('mm')[1]
    !this.size = !this.pipeSize.val.split('mm')[1]
    !this.pipeInsu.val = !!ce.inth.string()
    !this.pipeTemp.val = :FRA.temp of owner of owner
    handle ANY
      !this.pipeTemp.val = !!ce.owner.temp.string()
    endhandle
    !positionWrtWorld = !!ce.position.wrt(/* )

    -- <RM> 02 Nov 06 <
    -- removed the rounding on the position to increase accuracy.
    --!this.pipeX.val = !positionWrtWorld.east.nint().string()
    --!this.pipeY.val = !positionWrtWorld.north.nint().string()
    --!this.pipeZ.val = !positionWrtWorld.up.nint().string()
    -- > <RM> 02 Nov 06
    !this.pipeX.val = !positionWrtWorld.east.string()
    !this.pipeY.val = !positionWrtWorld.north.string()
    !this.pipeZ.val = !positionWrtWorld.up.string()
    !this.pipeOri.val = !!ce.adir.string().before(' ') & '/' & !!ce.ldir.string().before(' ')
    !this.attaOri[1] = !!ce.ori.wrt(/* ).alpha.string()
    !this.attaOri[2] = !!ce.ori.wrt(/* ).beta.string()
    !this.attaOri[3] = !!ce.ori.wrt(/* ).gamma.string()
    !this.pipeLoad.val = !!ce.:MDSLoad.string()
    handle(2,752)(2,754)
      !this.pipeLoad.val = '0'
    endhandle
    !this.emergencyLoad.val = !!ce.cref.owner.:USTForces[2].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MDSELoad.string()
    endhandle
    !this.failureLoad.val = !!ce.cref.owner.:USTForces[3].string()
    handle(2,752)(2,754)
      !this.failureLoad.val = '0'
    elsehandle (99,532)
      !this.failureLoad.val = !!ce.:MDSFLoad.string()
    endhandle
    !this.pipeXmovement.val = !!ce.:MDSMoveX.string()
    !this.pipeYmovement.val = !!ce.:MDSMoveY.string()
    !this.pipeZmovement.val = !!ce.:MDSMoveZ.string()

    !this.hangerSelType.val = !!mdsInterfaceHanger.configNumber.string() & !this.type
    handle ANY
      !this.hangerSelType.val = !!ce.:MDSHConfig
    endhandle

    !this.steelTagEleL.val = ''
    !this.steelTagEleR.val = ''

    --><wd>18aug2009 - DFN P-22111 (SI- 13209)
    -- Ensure the !this.steelMem array is set before calling the .steel() method
    if (!this.steelMem.empty()) then
      -- Copy the !!mdsHangerType32.support.rest.beamRefArray
      !this.steelMem = !!mdsHangerType32.support.rest.beamRefArray
    else
      !!ce = !this.ce
      if (!!ce.:MDSHConfig.eq('32V') and !this.steelMem.size().neq(4)) then
        -- Copy the !!mdsHangerType32.support.rest.beamRefArray
        !this.steelMem = !!mdsHangerType32.support.rest.beamRefArray
      endif
    endif
    --<<wd>18aug2009 - DFN P-22111 (SI- 13209)

    !this.steel()

    !this.unitsMM()
    !this.size = !this.boresMM[$!this.size]

    if (!this.pipeTemp.val.real().value().string() eq '-100000') then
      !this.pipeTemp.background = 2
    else
      !this.pipeTemp.background = 205
    endif

    if (!this.pipeInsu.val eq '') then
      !this.pipeInsu.val = '0'
    endif

  endif

  $!this.ce
  if (!!ce.:MDSHConfig.neq('')) then
    -------------------------------------------------------------------------------------------------------
    --<wd>28nov2006> The SYNTAX has already been modified by Neale Morris as shown below  to --> !this.name.val = !!ce.namn

    -- Fix for HPD0033742 <GE> 15/11/06
    -- Used too remove slashes in support name
    --    !this.name.val = !!ce.name.replace('/','')
    !this.name.val = !!ce.namn

    --<wd>28nov2006>
    -------------------------------------------------------------------------------------------------------
    !this.pipeSize.val = !!ce.lbor.string().split('mm')[1]
    !this.size = !this.pipeSize.val.split('mm')[1]
    !this.pipeInsu.val = !!ce.inth.string()
    !this.pipeTemp.val = :FRA.temp of owner of owner
    handle ANY
      !this.pipeTemp.val = !!ce.owner.temp.string()
    endhandle
    !positionWrtWorld = !!ce.position.wrt(/* )
    !this.pipeX.val = !positionWrtWorld.east.nint().string()
    !this.pipeY.val = !positionWrtWorld.north.nint().string()
    !this.pipeZ.val = !positionWrtWorld.up.nint().string()
    !this.steelX.val = !!ce.cref.tpos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.cref.tpos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !!ce.cref.tpos.wrt(/* ).up.nint().string()
    --$p ## 1 ##
    !this.steelZ.val = !this.steelTagEleL.val
    !this.pipeOri.val = !!ce.adir.string().before(' ') & '/' & !!ce.ldir.string().before(' ')
    !this.attaOri[1] = !!ce.ori.wrt(/* ).alpha.string()
    !this.attaOri[2] = !!ce.ori.wrt(/* ).beta.string()
    !this.attaOri[3] = !!ce.ori.wrt(/* ).gamma.string()
    --!this.pipeLoad.val = !!ce.cref.owner.:USTForces[1].string()
    !this.pipeLoad.val = !!ce.:MDSLoad.string()
    handle(2,752)(2,754)
      !this.pipeLoad.val = '0'
    endhandle
    !this.emergencyLoad.val = !!ce.cref.owner.:USTForces[2].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MDSELoad.string()
    endhandle
    !this.failureLoad.val = !!ce.cref.owner.:USTForces[3].string()
    handle(2,752)(2,754)
      !this.emergencyLoad.val = '0'
    elsehandle (99,532)
      !this.emergencyLoad.val = !!ce.:MDSFLoad.string()
    endhandle
    !restName = !!ce.name + '/REST'
    !xyz = :USTMovement of $!restName
    handle NONE
      !this.pipeXmovement.val = !xyz[2].string()
      handle ANY
        !this.pipeXmovement.val = '0'
      endhandle
      !this.pipeYmovement.val = !xyz[1].string()
      handle ANY
        !this.pipeYmovement.val = '0'
      endhandle
      !this.pipeZmovement.val = !xyz[3].string()
      handle ANY
        !this.pipeZmovement.val = '0'
      endhandle
    elsehandle ANY
      !this.pipeXmovement.val = !!ce.:MDSMoveX.string()
      !this.pipeYmovement.val = !!ce.:MDSMoveY.string()
      !this.pipeZmovement.val = !!ce.:MDSMoveZ.string()
    endhandle

    !this.hangerSelType.val = !!ce.:MDSHConfig.string()

    !this.steelmod()

    !this.unitsMM()
    !this.size = !this.boresMM[$!this.size]

    if (!this.pipeTemp.val.real().value().string() eq '-100000') then
      !this.pipeTemp.background = 2
    else
      !this.pipeTemp.background = 205
    endif

    if (!this.pipeInsu.val eq '') then
      !this.pipeInsu.val = '0'
    endif

  endif

  -- Hide calling form
  !!mdsInterfaceHanger.hide()

  !!mdsInterfaceHanger.manifactions()
  !this.oKmethod()

  units $!this.currentUnits
  refresh

endmethod

-------------------------------------------------------------------------------------
-- method to determine steel elevations on creation
--------------------------------------------------------------------------------------

define method .steel()

  ---------------------------------------------------------------------
  -- Two Hangers connected to ONE/TWO Double Channel beams - HORIZONTAL
  ---------------------------------------------------------------------
  if(!this.hangerSelType.val inset ('32H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !h1 = $!this.ce.name/H1
    --!this.steelMem[1] = !h1.tref.owner
    !h2 = $!this.ce.name/H2
    --><wd>20aug2009 - DFN P-22111 (SI-13209)
    handle NONE
      -- In MODIFY MOde
      --!this.steelMem[2] = !h2.tref.owner
      --!this.steelMem[3] = !this.steelMem[1]
      --!this.steelMem[4] = !this.steelMem[2]
    elsehandle ANY
      -- In CREATE MODE
    endhandle
    --<<wd>20aug2009 - DFN P-22111 (SI-13209)

    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]

    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)
    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif
    $!section1
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[1] CONS DIST $!inter TO $!line
    $!section2
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[2] CONS DIST $!inter TO $!line
    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif
    $!section3
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[3] CONS DIST $!inter TO $!line
    $!section4
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[4] CONS DIST $!inter TO $!line
    !steelWidth2 = !dist[2].real()
    !steelWidth4 = !dist[4].real()
    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()
    if (!this.jointRotate) then
      !this.unitsMM()
      !odSize = !this.boresMM[$!this.size]
      if ((undefined(!this.pipeInsu.val)) OR !this.pipeInsu.val.eq('')) then
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !steelWidthVal2 = ((!odSize.real()) + !this.pipeInsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangeWidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangeThk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangeThk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangeThk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif

  endif

  -------------------------------------------------------------------
  -- Two Hangers connected to ONE/TWO Double Channel beams - VERTICAL
  -------------------------------------------------------------------
  if(!this.hangerSelType.val inset ('32V')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)
    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif
    $!section1
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[1] CONS DIST $!inter TO $!line
    $!section2
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[2] CONS DIST $!inter TO $!line
    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif
    $!section3
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[3] CONS DIST $!inter TO $!line
    $!section4
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[4] CONS DIST $!inter TO $!line
    !steelWidth2 = !dist[2].real()
    !steelWidth4 = !dist[4].real()
    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()
    if (!this.steelMem[1] EQ !this.steelMem[3]) then
      !this.unitsMM()
      !odSize = !this.boresMM[$!this.size]
      if ((undefined(!this.pipeInsu.val)) OR !this.pipeInsu.val.eq('')) then
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !steelWidthVal2 = ((!odSize.real()) + !this.pipeInsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif
    !this.steelConnType.val = !this.steelMem[1].gtype
    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val
  endif

endmethod

-------------------------------------------------------------------------------------
-- method to determine steel elevations on modification
--------------------------------------------------------------------------------------

define method .steelmod()

  -- Reset flange thickness member to default
  -- NCM 31-01-06

  !this.flangeHeight = ''

  if(!this.hangerSelType.val inset ('32H')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !section1 = !this.steelMem[1]
    !section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]
    !u = 'U'
    !dir = !u.direction()
    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)

    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif

    $!section1
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[1] CONS DIST $!inter TO $!line

    $!section2
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[2] CONS DIST $!inter TO $!line

    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif

    $!section3
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[3] CONS DIST $!inter TO $!line

    $!section4
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[4] CONS DIST $!inter TO $!line

    !steelWidth2 = !dist[2].real()
    --  !steelWidth2 = (!dist[2].real() + ((!dist[1].real() - !dist[2].real())/ 2 ))
    --  !steelWidth4 = (!dist[4].real() + ((!dist[4].real() - !dist[3].real())/ 2 ))
    !steelWidth4 = !dist[4].real()

    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.jointRotate) then
      !this.unitsMM()
      !odSize = !this.boresMM[$!this.size]
      if ((undefined(!this.pipeInsu.val)) OR !this.pipeInsu.val.eq('')) then
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !steelWidthVal2 = ((!odSize.real()) + !this.pipeInsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

    if (!this.steelMem[1].gtype inset('DINU','JISU','BSC')) then
      !this.flangeWidth = !!mdsGetSctnWidth(!this.steelMem[1]).nint().string()
      handle(2,752)
      endhandle
      !this.flangeThk = !this.steelMem[1].prop.flg
      handle ANY
        !this.flangeThk = !this.steelMem[1].prop.flg
        handle ANY
          !this.flangeThk = '0'
        endhandle
      endhandle
      -- Pass the beam height to WitchHanger so it stops the can clashing
      -- with the steel for pipe to two channels
      -- NCM 31-01-06
      if !!mdsHangIf.eq('CPL') then
        !this.flangeHeight = !this.steelMem[1].prop.dept
        handle ANY
          !this.flangeHeight = '100'
        endhandle
      endif
    endif
  endif

  if(!this.hangerSelType.val inset ('32V')) then
    $!this.ce
    !pos = !!ce.pos.wrt(/* )
    !h1 = $!this.ce.name/H1
    !h2 = $!this.ce.name/H2
    --><wd>18aug2009 - DFN P-2211 (SI-13209)
    handle ANY
      -- HANGER $!this.ce.name/H2 - DOES NOT EXIST
      !section1 = !this.steelMem[1]
      !section2 = !this.steelMem[2]
    elsehandle NONE
      --<<wd>18aug2009 - DFN P-2211 (SI-13209)
      !section1 = !h1.tref.owner
      handle (2,754)
        !section1 = !h1.:mdscivref[1]
      endhandle

      !section2 = !h2.tref.owner
      handle ANY
        !section2 = !h2.:mdscivref[1]
      endhandle

      --><wd>18aug2009 - DFN P-2211 (SI-13209)
    endhandle
    --<<wd>18aug2009 - DFN P-2211 (SI-13209)

    --!section1 = !this.steelMem[1]
    --!section2 = !this.steelMem[2]
    !section3 = !this.steelMem[3]
    !section4 = !this.steelMem[4]

    !u = 'U'
    !dir = !u.direction()

    !x1 = !!kfarpline(!section1,!pos,!dir)
    !x2 = !!kfarpline(!section2,!pos,!dir)
    !x3 = !!kfarpline(!section3,!pos,!dir)
    !x4 = !!kfarpline(!section4,!pos,!dir)

    if (!x1[2].up.nint().real() gt !x2[2].up.nint().real()) then
      !this.steelTagEleL.val = !x1[2].up.nint().string()
    else
      !this.steelTagEleL.val = !x2[2].up.nint().string()
    endif

    $!section1
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[1] CONS DIST $!inter TO $!line

    $!section2
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[2] CONS DIST $!inter TO $!line

    if (!x3[2].up.nint().real() gt !x4[2].up.nint().real()) then
      !this.steelTagEleR.val = !x3[2].up.nint().string()
    else
      !this.steelTagEleR.val = !x4[2].up.nint().string()
    endif

    $!section3
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[3] CONS DIST $!inter TO $!line

    $!section4
    var !datumLine CONS Line $!dir THRO $!pos
    var !start POSS WRT WORLD
    var !end POSE WRT WORLD
    var !line CONS LINE JOIN $!start to $!end
    var !inter CONS POS INTER $!datumLine $!line
    var !dist[4] CONS DIST $!inter TO $!line

    !steelWidth2 = !dist[2].real()
    --  !steelWidth2 = (!dist[2].real() + ((!dist[1].real() - !dist[2].real())/ 2 ))
    --  !steelWidth4 = (!dist[4].real() + ((!dist[4].real() - !dist[3].real())/ 2 ))
    !steelWidth4 = !dist[4].real()

    !steelWidthVal = !steelWidth2 + !steelWidth4
    !this.steelWidthVal.val = !steelWidthVal.string()

    if (!this.steelMem[1] EQ !this.steelMem[3]) then
      !this.unitsMM()
      !odSize = !this.boresMM[$!this.size]
      if ((undefined(!this.pipeInsu.val)) OR !this.pipeInsu.val.eq('')) then
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !this.steelWidthVal.val = !steelWidthVal1.nint().string()
      else
        !factor = 10 * !odSize.real().power(-0.3)
        !steelWidthVal1 = ((!factor * !odSize.real()) + 60)
        !steelWidthVal2 = ((!odSize.real()) + !this.pipeInsu.val.real() + 60)
        if (!steelWidthVal1 GT !steelWidthVal2) then
          !this.steelWidthVal.val = !steelWidthVal1.nint().string()
        else
          !this.steelWidthVal.val = !steelWidthVal2.nint().string()
        endif
      endif
    endif

    !this.steelConnType.val = !this.steelMem[1].gtype

    !this.steelX.val = !!ce.pos.wrt(/* ).east.nint().string()
    !this.steelY.val = !!ce.pos.wrt(/* ).north.nint().string()
    !this.steelZ.val = !this.steelTagEleL.val

  endif

endmethod

-------------------------------------------------------------------------------------
-- method to write input file (supportName.lif) to directory located in environment
-- variable project name \lif for support design in external software
-------------------------------------------------------------------------------------

define method .oKmethod()

  -- Clear the line shown with the offset form
  !!mdsInterfaceDynOffset.close()
  --dun1218 the above line will reset the units to those stored on the dynoffset form but we need to have mm units here - important for imperial units - start
  !!kGetSetUnits()
  --dun1218 the above line will reset the units to those stored on the dynoffset form but we need to have mm units here - important for imperial units - end
  !pipeDirection = ''
  -- Set the Atta UDA's that store the MDS data

  $!this.ce
  !!ce.:MDSLoad = !this.pipeLoad.val.real()
  !!ce.:MDSMoveX = !this.pipeXmovement.val.real()
  !!ce.:MDSMoveY = !this.pipeYmovement.val.real()
  !!ce.:MDSMoveZ = !this.pipeZmovement.val.real()
  !!ce.:MDSHConfig = !this.hangerSelType.val.string()
  -- DTF>>> 5.12.05 we need to test if hh to ht direction id the same as the leave of atta
  if !!mdsHangerType32.support.tdir.set() then

    !directions = !!mdsRemoveGrad(!this.ce)
    if !directions[1].eq(!!mdsHangerType32.support.tdir) or !directions[1].eq(!!mdsHangerType32.support.tdir.opposite()) then
      !dynamicParallel = TRUE
    elseif !directions[1].angle(!!mdsHangerType32.support.tdir).gt(179.9) and !directions[1].angle(!!mdsHangerType32.support.tdir).lt(180.1) then
      !dynamicParallel = TRUE
    elseif !directions[1].angle(!!mdsHangerType32.support.tdir).gt(-0.1) and !directions[1].angle(!!mdsHangerType32.support.tdir).lt(0.1) then
      !dynamicParallel = TRUE
    else
      !dynamicParallel = FALSE
    endif

    -- <RM> 11/08/08 set the pldir explicitly because it was not passing through set in some cases
    !pldir = ldir
    -- <RM> 11/08/08 end of fix
    if !pldir.angle(U).gt(179) and !pldir.angle(U).lt(181) then
      !pipeDirection = 'VERTICAL'
    elseif !pldir.angle(U).gt(-1) and !pldir.angle(U).lt(1) then
      !pipeDirection = 'VERTICAL'
    else
      !pipeDirection = 'HORIZONTAL'
    endif
  else
    !dynamicParallel = FALSE
  endif
  -- DTF<<<

  if !!mdsHangerType32.support.tdir.set() then
    -- <RM> 11/08/08 set the pldir explicitly because it was not passing through set in some cases
    !pldir = ldir
    -- <RM> 11/08/08 end of fix
    if !pldir.angle(U).gt(179) and !pldir.angle(U).lt(181) then
      !pipeDirection = 'VERTICAL'
    elseif !pldir.angle(U).gt(-1) and !pldir.angle(U).lt(1) then
      !pipeDirection = 'VERTICAL'
    else
      !pipeDirection = 'HORIZONTAL'
    endif
  endif
  -- DTF<<<
  -- Make sure the support.tdir and support.tposition is set
  !nameOfAtta = !!ce.name

  !!mdsHangerType32.support.tdir = tdir of $!nameOfAtta/H1 wrt /*
  --><wd>20aug2009 -- DFN P-22111 (SI-13209)
  if (!!mdsHangIf.eq('CPL') and !!mdsHangerType32.support.datum.:MDSHConfig.matchwild('32?')or !!mdsHangerType32.support.datum.:MDSHConfig.matchwild('31?') or !!mdsHangerType32.support.datum.:MDSHConfig.eq('2H')) then
    -- MDS-CPL Witch Hanger Support Types '2H','31H', '31V', '32H' and '32V' will always have the !!mdsHangerType32.support.tdir set to "D wrt /*"
    !!mdsHangerType32.support.tdir = D wrt /*
  endif
  --<<wd>20aug2009 -- DFN P-22111 (SI-13209)

  !!mdsHangerType32.support.tposition = tposition of $!nameOfAtta/H1 wrt /*

  -- Pass the angle of the pipe to the manufacturers program
  !pldir = ldir
  if !pldir.up.eq(0) then
    -- Horizontal Pipe
    -- Test to see if pipe parallel to wall / floor etc
    !parallelTest = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)
    if !parallelTest[1].not() then
      -- if not parallel we may need to send angle to LISEGA
      if !parallelTest[3].eq(180) then
        !pipeAngle = 0
      else
        !pipeAngle = !parallelTest[3]
      endif
    else
      !pipeAngle = 0
    endif
  elseif !pldir.up.abs().eq(1) then
    -- Vertical Pipe
    !pipeAngle = 90
  else
    -- Sloping line get the angle
    var !grad  pl grad
    -- Test to see if pipe parallel to wall / floor etc
    !parallelTest = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)
    if !parallelTest[1] and ( !!ce.cref.tdir.up.neq(-1) and !!ce.cref.tdir.up.neq(1) ) then
      -- horizontal support !
      !pipeAngle = 0
    else
      var !pipeAngleTemp ( abs ( atan( 1 / $!grad) ) )
      !pipeAngle = !pipeAngleTemp.real().value()
    endif
  endif

  !tdir = !!ce.cref.tdir

  -- Pass the pipe material type to manufacturers program
  !pipeMaterial = !!ce.owner.pspe.:MDSPipeMat

  -- Pass the hydro load store in :USTTestLoad and
  -- HS140 in :USTForces[4]
  !hydroLoad = !!ce.:MDSHLoad
  handle ANY
    !hydroLoad = 0
  endhandle

  !hsLoad = !!ce.cref.owner.:USTForces
  handle NONE
    !hs140Load = !hsLoad[4]
    handle ANY
      !hs140Load = 0
    endhandle
  elsehandle ANY
    !hs140Load = 0
  endhandle

  -- check to make sure that the data is set correctly
  -- check valid PDMS name

  if !this.name.val.match(' ').gt(0) or !this.name.val.eq('unset') then
    !!alert.error('Invalid Name')
    return
  endif

  !cuProj = current project
  !proj = !cuProj.code()
  !dat = !proj & 'DAT'
  !lif = !proj & 'LIF'
  !lof = !proj & 'LOF'

  var !evardat evar $!dat
  var !evarlif evar $!lif
  var !evarlof evar $!lof

  !!manif.dat = object FILE(!evardat)
  !!manif.lif = object FILE(!evarlif)
  !!manif.lof = object FILE(!evarlof)

  -- check for valid temperature

  if (!this.pipeTemp.val.real().value().string() eq '-100000') then
    !!alert.error('The temperature of the branch is not set')
    return
  endif

  -- Set the display text for the interface being used

  if !!mdsHangIf.upcase().eq('LISEGA') then
    !manText = 'LISEGA'
  elseif !!mdsHangIf.upcase().eq('PSL') then
    !manText = 'Pipe Supports Limited'
  elseif !!mdsHangIf.upcase().eq('CPL') then
    !manText = 'Carpenter and Paterson'
  endif

  -- check valid input directory
  if ((undefined(!!manif.lif)) OR !!manif.lif.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Interface Input Directory does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.lif.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Interface Input Directory does not exist. Unable to proceed!')
    return
  endif

  -- check valid output directory

  if ((undefined(!!manif.lof)) OR !!manif.lof.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Interface Output Directory does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.lof.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Interface Output Directory does not exist. Unable to proceed!')
    return
  endif

  -- check valid database directory

  if ((undefined(!!manif.dat)) OR !!manif.dat.string().eq('')) then
    !!alert.error('Environment variable for the $!manText Database does not exist. Unable to proceed!')
    return
  endif

  if (!!manif.dat.exists().string() EQ 'FALSE') then
    !!alert.error('$!manText Database Directory does not exist. Unable to proceed!')
    return
  endif

  --<wd28nov2006
  -- Modified the .replace code below because the value in the form !!mdsVendorHangertype32 name gadget, i.e.
  -- !this.name.val, does NOT contain the required PDMS name prefix '/' slash character,
  -- e.g. 'PS123456'
  --!file = !this.name.val.replace('/','\').replace('\','-',2,0)
  !file = !this.name.val.replace('/','\').replace('\','-',1,0)
  --<wd28nov2006

  if !!mdsHangIf.eq('CPL') then
    if defined(!!mdsAutoTestRunning) then
      --if we are autotesting then redirect the lif file location so that we can test its output
      !lifFile = object FILE(!!mdsAutotestTestObject.testLiffile)
    else
      !lifFile = object FILE('$!!manif.lif' & '\' & !file & '.wif')
      !lofFile = object FILE('$!!manif.lof' & '\' & !file & '.wof')
    endif
  elseif !!mdsHangIf.eq('LISEGA') then
    if defined(!!mdsAutoTestRunning) then
      --if we are autotesting then redirect the lif file location so that we can test its output
      !lifFile = object FILE(!!mdsAutotestTestObject.testLiffile)
    else
      !lifFile = object FILE('$!!manif.lif' & '\' & !file & '.lif')
      !lofFile = object FILE('$!!manif.lof' & '\' & !file & '.lof')
    endif
  elseif !!mdsHangIf.eq('PSL') then
    if defined(!!mdsAutoTestRunning) then
      --if we are autotesting then redirect the lif file location so that we can test its output
      !lifFile = object FILE(!!mdsAutotestTestObject.testLiffile)
    else
      !lifFile = object FILE('$!!manif.lif' & '\' & !file & '.psi')
      !lofFile = object FILE('$!!manif.lof' & '\' & !file & '.pso')
    endif
  endif

  if (!this.hotcold.val EQ 1) then
    !load = 'hot'
  else
    !load = 'cold'
  endif

  -- Get addition info from the atta to send to manufacturers program
  !restName = !!ce.name + '/REST'
  !ustSprRate   = :USTSprRate of $!restName
  handle ANY
    !ustSprRate = ''
  endhandle

  !manIFConfigString = :USTHCFGKEY of $!restName
  handle ANY
    !manIFConfigString = ''
    !manIFConfig = ''
  elsehandle NONE
    !manIFConfig = !manIFConfigString.after('.').before('.').real()
  endhandle

  !distRod = :USTDistRod of $!restName
  handle NONE
    if (!distRod.eq(0)) then
      !distRod = !this.steelWidthVal.val.real()
    endif
  elsehandle ANY
    !distRod = !this.steelWidthVal.val.real()
  endhandle

  --<wd>22dec2009 - DFN P-23515 SI-4931
  -- Set the variable !distRod to the nearest integer
  -- The CPL WitchHanger interface does not cater for decimal places in the "Width" value supplied in the INPUT .lif file
  !distRod = !distRod.nint()
  --<wd>22dec2009 - DFN P-23515 SI-4931

  !lifFile.open('Overwrite')
  handle (41,322)
    !fileName = !lifFile.string()
    !!alert.error('Unable to continue as the file $!fileName is being used')
    return
  endhandle
  !lifFile.writeRecord('[DWG]')
  !lifFile.writeRecord('HangerMark=' & !this.name.val)
  !lifFile.writeRecord('DwgNo=' & !this.name.val)
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[Load]')
  -- !lifFile.writeRecord('Load_condition=' & !load)

  -- the following sets the load value in LICAD so that automatic testing solution can be used
  -- to use this set a global boolean !!licadAutoTestEnabled = true
  if(define(!!licadAutoTestEnabled)) then
    !lifFile.writeRecord('Normal=' & '5')
  else
    !lifFile.writeRecord('Normal=' & !this.pipeLoad.val.real().value().string())
  endif

  !lifFile.writeRecord('Emergency=' & !this.emergencyLoad.val.real().value().string())
  !lifFile.writeRecord('Failure=' & !this.failureLoad.val.real().value().string())
  !lifFile.writeRecord('Hydro=' & !hydroLoad)
  !lifFile.writeRecord('HS140=' & !hs140Load)
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[Pipe]')
  !lifFile.writeRecord('Size=' & !this.size)
  !lifFile.writeRecord('Temp=' & !this.pipeTemp.val.real().value().string())
  !lifFile.writeRecord('Insulation=' & !this.pipeInsu.val.real().value().string())
  !lifFile.writeRecord('Pipe_Z=' & !this.pipeZ.val.real().value().string())
  !lifFile.writeRecord('Pipe_X=' & !this.pipeX.val.real().value().string())
  !lifFile.writeRecord('Pipe_Y=' & !this.pipeY.val.real().value().string())
  !lifFile.writeRecord('Orientation_X=' & !this.attaOri[1])
  !lifFile.writeRecord('Orientation_Y=' & !this.attaOri[2])
  !lifFile.writeRecord('Orientation_Z=' & !this.attaOri[3])
  !lifFile.writeRecord('Material=' & !pipeMaterial)
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[StaticMovements]')
  !lifFile.writeRecord('Lateral=' & !this.pipeXmovement.val.real().value().string())
  !lifFile.writeRecord('Horizontal=' & !this.pipeYmovement.val.real().value().string())
  !lifFile.writeRecord('Vertical=' & !this.pipeZmovement.val.real().value().string())
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[DynamicMovements]')
  !lifFile.writeRecord('Positive=' & '')
  !lifFile.writeRecord('Negative=' & '')
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[SteelConnection]')
  --<RM> reverse the steel elevation lines from those originally supplied for this type because
  --the elevations apply to the opposite members. i.e. !this.steelTagEleR refers to the Licad Left steel elevation
  !lifFile.writeRecord('El_Steel_L=' & !this.steelTagEleR.val.real().value().string())
  !lifFile.writeRecord('El_Steel_R=' & !this.steelTagEleL.val.real().value().string())
  -- !lifFile.writeRecord('Width=' & !this.steelWidthVal.val.real().value().string())
  !lifFile.writeRecord('Width=' & !distRod.real().value().string())
  !lifFile.writeRecord('Steel_Z=' & !this.steelZ.val.real().value().string())
  !lifFile.writeRecord('Steel_X=' & !this.steelX.val.real().value().string())
  !lifFile.writeRecord('Steel_Y=' & !this.steelY.val.real().value().string())
  !lifFile.writeRecord('')
  !lifFile.writeRecord('[MDSHangerConfig]')

  !lifFile.writeRecord('Config=' & !this.hangerSelType.val)
  !lifFile.writeRecord('Length=0')

  if !!mdsHangIf.eq('PSL') then
    !vendorCfg = !this.ce.:mdsVendorCfg
    !lifFile.writeRecord('VendorConfig=' & !vendorCfg)
  endif

  !!mdsResetPins(8,9)

  if !this.flangeWidth.unset() then
    !lifFile.writeRecord('Joint Beam Flange Width=1000')
    !lifFile.writeRecord('Joint Beam Flange Thickness=1000')
  elseif !this.flangeThk.unset() then
    !lifFile.writeRecord('Joint Beam Flange Width=1000')
    !lifFile.writeRecord('Joint Beam Flange Thickness=1000')
  else
    !lifFile.writeRecord('Joint Beam Flange Width=' & !this.flangeWidth.real().value().string())
    !lifFile.writeRecord('Joint Beam Flange Thickness=' & !this.flangeThk.real().value().string())
  endif

  -- Pass the beam height to WitchHanger so it stops the can clashing
  -- with the steel for pipe to two channels
  -- NCM 31-01-06

  if !!mdsHangIf.eq('CPL') then
    if !this.flangeHeight.set() then
      if !this.flangeHeight.empty().not() then
        !lifFile.writeRecord('Joint Beam Flange Height=' & !this.flangeHeight.real().value().string())
      endif
    endif
  endif

  !lifFile.writeRecord('Joint Rotate=' & !this.jointRotate)
  !lifFile.writeRecord('Alpha=' & !pipeAngle.real().value().string())
  if !dynamicParallel then
    !lifFile.writeRecord('Alpha35=' & '0')
  else
    !lifFile.writeRecord('Alpha35=' & '90')
  endif
  !lifFile.writeRecord('Yoffset=' & '0')
  !lifFile.writeRecord('Yangle=' & '0')
  !lifFile.writeRecord('XOffset=' & '0')
  !lifFile.writeRecord('Xangle=' & '0')

  !lifFile.writeRecord('UstSprRate=' & !ustSprRate)

  -- Write steelwork sizes
  if defined(!this.steelMem[1]) then
    if !this.steelMem[1].badref().not() then
      !steelProfile = !this.steelMem[1].catref.:MDSSizeTag
      handle ANY
        !steelProfile = ''
      endhandle
    endif
  else
    !lifFile.writeRecord('Profile Left=')
  endif

  if defined(!this.steelMem[2]) then
    if !this.steelMem[2].badref().not() then
      !steelProfile = !this.steelMem[2].catref.:MDSSizeTag
      handle ANY
        !steelProfile = ''
      endhandle
      --!lifFile.writeRecord('Profile Right=' & !steelProfile)
    else
      --!lifFile.writeRecord('Profile Right=')
    endif
  else
    !lifFile.writeRecord('Profile Right=')
  endif

  -- Need to write if the pipe is parallel to PSL only

  if !!mdsHangIf.eq('PSL') then
    if !!mdsHangerType32.parallel.unset() then
      !lifFile.writeRecord('Parallel=FALSE')
    else
      if !!mdsHangerType32.parallel then
        !lifFile.writeRecord('Parallel=TRUE')
      else
        !lifFile.writeRecord('Parallel=FALSE')
      endif
    endif
  endif

  if !!mdsHangIf.eq('LISEGA') then
    !tailDir = !this.ce.cref.tdir.wrt( /* ).string().before(' WRT')
    !attaLDir = !this.ce.ldir.wrt( /* ).string().before(' WRT')
    !lifFile.writeRecord('DynamicParallel=FALSE')
    !lifFile.writeRecord('PipeDirection=$!pipeDirection')
    !tailDirSplit = !tailDir.split(' ')
    !attaLDirSplit = !attaLDir.split(' ')
    if !tailDirSplit.size().lt(3) then
      !hTDIRY = !tailDirSplit[1]
      !hTANG = '0'
      !hTDIRX = ''
    else
      !hTDIRY = !tailDirSplit[1]
      !hTANG  = !tailDirSplit[2]
      !hTDIRX = !tailDirSplit[3]
    endif

    if !attaLDirSplit.size().eq(5) then
      !pDDIRY = !attaLDirSplit[1]
      !pDANGH = !attaLDirSplit[2]
      !pDDIRX = !attaLDirSplit[3]
      !pDSLOP = !attaLDirSplit[4]
      !pDUPDN = !attaLDirSplit[5]
    elseif !attaLDirSplit.size().eq(3) then
      if !attaLDirSplit[3].eq('U') or !attaLDirSplit[3].eq('D') or !attaLDirSplit[3].eq('Z') or !attaLDirSplit[3].eq('-Z') then
        !pDDIRY = !attaLDirSplit[1]
        !pDANGH = '0'
        !pDDIRX = ' '
        !pDSLOP = !attaLDirSplit[2]
        !pDUPDN = !attaLDirSplit[3]
      else
        !pDDIRY = !attaLDirSplit[1]
        !pDANGH = !attaLDirSplit[2]
        !pDDIRX = !attaLDirSplit[3]
        !pDSLOP = '0'
        !pDUPDN = ' '
      endif
    else
      !pDDIRY = !attaLDirSplit[1]
      !pDANGH = '0'
      !pDDIRX = ' '
      !pDSLOP = '0'
      !pDUPDN = ' '
    endif

    !lifFile.writeRecord('HangerTailDirection_DIRY=$!hTDIRY')
    !lifFile.writeRecord('HangerTailDirection_ANG=$!hTANG')
    !lifFile.writeRecord('HangerTailDirection_DIRX=$!hTDIRX')
    !lifFile.writeRecord('PipeDirectionActual_DIRY=$!pDDIRY')
    !lifFile.writeRecord('PipeDirectionActual_ANG_HOR=$!pDANGH')
    !lifFile.writeRecord('PipeDirectionActual_DIRX=$!pDDIRX')
    !lifFile.writeRecord('PipeDirectionActual_SLOPE=$!pDSLOP')
    !lifFile.writeRecord('PipeDirectionActual_UPDN=$!pDUPDN')

    -- <RM> 13 Oct 06 > -- We need to include information on the support condition for LICAD, this will take the form of
    -- PIPE DETAILS - i.e. HORIZONTAL + SLOPING etc.
    -- SUPPORT SURFACE - i.e. VERTICAL + ROTATED etc.
    -- PARALLEL - TRUE OR FALSE
    !lifFile.writeRecord('')
    !lifFile.writeRecord('[Connection Details]')
    -- First get the pipe details


    if !pDSLOP.real().abs().gt(0) then
      !sloping = 'SLOP'
    else
      !sloping = 'FLAT'
    endif

    if !pDANGH.real().abs().gt(0) then
      !rotated = 'ROT'
    else
      !rotated = 'NONE'
    endif

    var !pipeLeaveDir DIR PL OF $!nameOfAtta

    --check that we are below 45 degrees

    if !pipeLeaveDir.direction().up.abs().leq(0.707107) then
      !dirPipe = 'HORZ'
    else
      !dirPipe = 'VERT'
    endif

    !lifFile.writeRecord('PipeCondition=' + !dirPipe + '-' + '$!sloping' + '-' + '$!rotated')

    !upAng = !tdir.angle( U wrt /* ).real()
    if !upAng.gt(90) then
      !upAng = 180 - !upAng
    endif

    if !upAng.gt(45) then
      !suppDir = 'VERT'
    else
      !suppDir = 'HORZ'
    endif

    if !hTANG.real().gt(0) then
      !suppRot = 'ROT'
    else
      !suppRot = 'NONE'
    endif

    -- <RM> 11/08/08 added handle below for spring can types supports
    var !suppType typ of own of own of tref of cref
    handle ANY
      !suppType = 'NONE'
    endhandle
    -- <RM> 11/08/08 end of fix

    if !suppType.eq('PANE') or !suppType.eq('FLOOR') or !suppType.eq('GWALL') or !suppType.eq('FRMW') then
      !suppSurface = 'CIVILS'
    else
      -- <RM> 23 Nov 2006 --
      -- commented the following out to see if the LISEGA software makes use of it
      -- if not then i will just set support surface as civils
      !suppSurface = 'CIVILS'
      --!suppSurface = 'STRU'
      -- <RM> 23 Nov 2006 -- end of fix
    endif

    !lifFile.writeRecord('SupportCondition=' + !suppDir + '-' + !suppSurface + '-' + !suppRot)

    -- write if the pipe and support are parallel
    !oriParallel = !this.isparallel(!!ce, !!mdsHangerType32.support.tdir)
    !lifFile.writeRecord('Parallel=' + !oriParallel.string())
    --< end of fix <RM> 13 Oct 06

    -- <RM> 26 Oct 06 > --
    !moveAttaDir = !!mdsInterfaceGetMoveDir(!!ce,'CREATE',!!mdsHangerType32)

    !lifFile.writeRecord('')
    !lifFile.writeRecord('[Vectors]')

    --get the pipe direction
    if !moveAttaDir[2].neq('') then
      !pipeDir = !!mdsUnitVector(!moveAttaDir[2].direction())
    else
      var !pipeLeaveDir dir pl of $!!ce
      !pipeDir = !!mdsUnitVector(!pipeLeaveDir.direction())
    endif

    !lifFile.writeRecord('pipe_direction_x=' + !pipeDir[1].string('D5'))
    !lifFile.writeRecord('pipe_direction_y=' + !pipeDir[2].string('D5'))
    !lifFile.writeRecord('pipe_direction_z=' + !pipeDir[3].string('D5'))

    --get the vector perpendicular to the support surface
    !tailDirPerp = !!mdsUnitVector(!tailDir.direction())
    !lifFile.writeRecord('wall_perp_x=' + !tailDirPerp[1].string('D5'))
    !lifFile.writeRecord('wall_perp_y=' + !tailDirPerp[2].string('D5'))
    !lifFile.writeRecord('wall_perp_z=' + !tailDirPerp[3].string('D5'))

    --dun1218 reinstated the dynamic parallel test here - start
    if !dynamicParallel.not() then
      --get the vector from hanger tail to a point perpendicular on the pipe
      PIN 3 at $!!mdsHangerType32.support.tposition
      pin 3 dir $!!mdsHangerType32.support.tdir
      pin 5 copy pl of $!!ce
      pin 3 dir towards pin 5
      var !originalDist const dist pin 3 to pin 5
      var !pin3dir dir pin 3
      var !pldirect dir pin 5
      !offAng = !pin3dir.direction().angle(!pldirect.direction())
      !oAng = !offAng
      if !offAng.real().gt(90) then
        !oAng = 180 - !offAng.real()
      endif

      -- get the approx dist that the support needs to move to be perpendicular to the pipe
      -- it is only approximate because we do not know the component lengths that come back from
      -- LICAD. these component lengths determine the exact movement lengths.
      !approxDistToMove = !originalDist.real() * cosine(!oAng)
      pin 5 dir $!moveAttaDir[2]
      handle ANY
        !tailToPerpDirection = !tailDir
      elsehandle NONE
        pin 5 dist $!approxDistToMove
        pin 3 dir towards pin 5
        var !tailToPerpDirection dir pin 3
      endhandle

      !tailToPerpDir = !!mdsUnitVector(!tailToPerpDirection.direction())
      !lifFile.writeRecord('tailpostopipe_perp_x=' + !tailToPerpDir[1].string('D5'))
      !lifFile.writeRecord('tailpostopipe_perp_y=' + !tailToPerpDir[2].string('D5'))
      !lifFile.writeRecord('tailpostopipe_perp_z=' + !tailToPerpDir[3].string('D5'))
    else
      !lifFile.writeRecord('tailpostopipe_perp_x=' + '0')
      !lifFile.writeRecord('tailpostopipe_perp_y=' + '0')
      !lifFile.writeRecord('tailpostopipe_perp_z=' + '0')
    endif
    -- <RM> end of fix 26 Oct 06
    --dun1218 reinstated the dynamic parallel test here - end

    !xOffDir = !!mdsHangerType32.support.offsetX
    !yOffDir = !!mdsHangerType32.support.offsetY

    !xOffDirA = !!mdsUnitVector(!xOffDir)
    !yOffDirA = !!mdsUnitVector(!yOffDir)

    !lifFile.writeRecord('x_offdir_x=' + !xOffDirA[1].string('D5'))
    !lifFile.writeRecord('x_offdir_y=' + !xOffDirA[2].string('D5'))
    !lifFile.writeRecord('x_offdir_z=' + !xOffDirA[3].string('D5'))

    !lifFile.writeRecord('y_offdir_x=' + !yOffDirA[1].string('D5'))
    !lifFile.writeRecord('y_offdir_y=' + !yOffDirA[2].string('D5'))
    !lifFile.writeRecord('y_offdir_z=' + !yOffDirA[3].string('D5'))

    !hang1 = !this.ce.cref
    var !coll coll all WPAD for $!hang1
    if !coll.size().gt(0) then
      !this.wpadmat = !coll[1].dbref().:MDSMatref
    endif
  endif

  -- >>> DTF Mod to store position  numbers if set
  if !this.ce.cref.members.size().gt(0) then
    --must be in modify mode, see if pcla 1 has :MDSPosNum set
    !posNumTest = !this.ce.cref.members[1].:MDSPosNum
    handle ANY
    elsehandle NONE
      if !this.ce.cref.members[1].:MDSPosNum.unset().not() then
        if defined(!!mdsFixPosNum) then
          if !this.ce.:MDSPosNumMax.real().gt(0) then
            handle ANY
            elsehandle NONE
              -- Store position numbers in design to be used in mto in draft
              !!mdsFixPosNum.storeposnumbers(!this.ce)
            endhandle
          endif
        endif
      endif
    endhandle
  endif
  -- <<< DTF End of mod

  !lifFile.close()

  --run transc.exe to remove the utf-8 unicode encoding on the file header - start
  !!pmlTranscFile(!lifFile.fullname(), '', '', '', '')
  --run transc.exe to remove the utf-8 unicode encoding on the file header - end

  -- Initialise the manufacturers software with an input file and output file
  -- Hold the PDMS session until the user exist the software and then read
  -- in the output file

  !this.hide()
  !!mdsmodifysupp.cancel.active = TRUE
  refresh

  !evarText = !proj + 'DAT'
  handle ANY
  endhandle

  -- Environment variable for manufacturers program modified to include name of executable
  if (!!mdsHangIf.eq('LISEGA')) then
    var !lisExe evar LICADMDSEXE
    if (!lisExe.upcase().match('LICADV10').gt(0)) then
      SYSCOM |""%LICADMDSEXE%"" /MDS /if:$!lifFile /OF:$!lofFile|
    else
      -- Call String is executable InputFilePath OutputFilePath ProjectDBs
      SYSCOM |""%LICADMDSEXE%"" /IF:$!lifFile /OF:$!lofFile /PD:%$!evarText%|
    endif
  elseif !!mdsHangIf.eq('PSL') then
    -- Call String is executable /MDS OutputFilePath InputFilePath ConfigFile
    -- Config file will be called config.txt and must be stored in the software directory
    !configFile = object FILE()
    var !pslExe evar PSLMDSEXE
    !configFile.file(!pslExe)
    !configPath = !configFile.directory()
    !configFile.file(!configPath.string() + '/config.txt')
    !config = !configFile.fullname()
    var !datDir evar $!evarText
    if undefined(!!mdsAutoTestRunning) then
      SYSCOM |""$!pslExe"" /MDS /$!lofFile /$!lifFile /$!config /$!datDir|
    endif
  elseif !!mdsHangIf.eq('CPL') then
    -- We need to pass the WitchHanger program the db required, these will be stored in
    -- the evar projcode(dat), the form !!mdsCPLDb will get the user to select the db
    -- and put the db required in the form member .db
    -- If it has been selected before then open the program if not get the user to select
    -- the db
    var !cplMdsExe evar cplmdsexe
    if undefined(!!mdsAutoTestRunning) then
      !!mdsCPLDb.init('$!cplMdsExe','$!lifFile','$!lofFile',!this)
    else
      !this.buildHanger('$!!mdsAutotestTestObject.testLoffile')
      handle ANY
      endhandle
    endif
  endif

  -- Call method to build hanger and manufacturers object
  if !!mdsHangIf.neq('CPL') then

    --REFACTOR if we are running an mdsautotest test then !!mdsAutoTestRunning will be defined.. if this is the case
    --don't run syscom as we merely want to compare the freshly generated lif file with the one held in the
    --test directories, we will continue to build the hanger with the stored lof file and compare the
    --created hanger with the stored dblisting to see if they match
    if undefined(!!mdsAutoTestRunning) then
      !this.buildHanger('$!lofFile')
      handle ANY
        !errText = !!error.text
        !errLine = !!error.line
        !errCommand = !!error.command
        !errString = 'hanger creation has terminated in an unexpected manner - ' + !errText + !errLine + ' whilst executing ' + !errCommand
        !!alert.error(!errString)
      endhandle
    else
      !this.buildHanger('$!!mdsAutotestTestObject.testLoffile')
      handle ANY
      endhandle
    endif
    do !loop from 1 to 9
      pin $!loop off
    enddo
  endif

endmethod

-------------------------------------------------------------------------------------
-- method to clear all gadgets it there is an error
-------------------------------------------------------------------------------------

define method .clear()

  !this.name.val          = ''
  !this.pipeSize.val      = ''
  !this.pipeInsu.val      = ''
  !this.pipeTemp.val      = ''
  !this.pipeX.val         = ''
  !this.pipeY.val         = ''
  !this.pipeZ.val         = ''
  !this.pipeOri.val       = ''
  !this.pipeLoad.val      = '0'
  !this.pipeXmovement.val = ''
  !this.pipeYmovement.val = ''
  !this.pipeZmovement.val = ''
  !this.steelTagEleL.val  = ''
  !this.steelTagEleR.val  = ''

endmethod

