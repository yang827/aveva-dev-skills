-- Define Form
setup Form !!mdsWeldDraw
initcall '!this.init()'

   path down

$(
   option .symbol  call |!this.drawsymbol(!this.symbol.selection('rtext'))| width 30
   view .vol vol
     width 30 hei 8
     look thro s10000d10000w10000
     look d
   exit
 $)

   button .ce  ' CE ' call '!this.init()'

   text .dtsen   ' DataSet Name: ' width 30 is STRING
   text .weldn   '    Weld Name: ' width 30 is STRING
   text .symbol  '  Symbol Name: ' width 30 is STRING
   text .ppoint  'PPoint Number: ' width 30 is STRING
   text .desc    '  Description: ' width 30 is STRING
   text .TYpe    '         Type: ' width 30 is STRING
   text .Range   '   Size Range: ' width 30 is STRING


   button .apply ' Apply '     ok
   button .dismiss ' Dismiss ' at xmax form -size ymin cancel


member .source is dbref
member .offset is position

exit

!this.offset = s10000d10000w10000

-- method to initialise the form based on a single database item
-- go to draft and get the list of symbols
define method .init()
   -- find out what the current element is and initialise as addpropriate
   if !!ce.type eq 'ATTA' then
     !this.initatta(!!ce)
   endif
endmethod





define method .initatta(!atta is dbref)

 !a = object mdsweldlist(!atta)
 !a.drawwelds()

endmethod





$(
 !current = !!ce
 =15199/22395
 var !sytm coll all sytm for ce
 var !name eval name for all from !sytm
 !this.symbol.dtext = !name
 !this.symbol.rtext = !sytm
 !!ce = !current
 $)

endmethod


define method .drawsymbol(!symname is STRING)

 !symbol = !symname.dbref()
 do !a values !symbol.members
   if !a.type eq 'STRA' then
    !this.drawstraight(!a)
   elseif !a.type eq 'TEXP' then
    !this.drawtext(!a)
   elseif !a.type eq 'SYMB' then
    !this.drawsymbol(!a.tmrf.string())
   endif
enddo

endmethod

define method .drawstraight(!stra is dbref)
   -- q var !stra.owner.name
   q var !stra.ptfa[1].xypos

   var !startpos fpt
   var !endpos   tpt
   q var !startpos
   q var !endpos

endmethod

define method .drawtext(!a is dbref)
 $p text method
endmethod


--------------------------------------------------------------------------------
define method .ok()

endmethod
--------------------------------------------------------------------------------



