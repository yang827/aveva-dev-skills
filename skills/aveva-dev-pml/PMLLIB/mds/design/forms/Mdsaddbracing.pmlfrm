--
--
-- Description:
-- Form Definition for Framework bracing Type FB01 & FB02
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  braceangle()                     -
--  braceoption()                    -
--  braceplot()                      -
--  cancel()                         -
--  currbrace()                      -
--  delbrace()                       -
--  dimbrace()                       -
--  handbrace()                      -
--  hdimension()                     -
--  init(FORM)                       -
--  initialise()                     -
--  ldimension()                     -
--  load()                           -
--  locks()                          -
--  newbrace()                       -
--  nudgebrace()                     -
--  pickbrace()                      -
--  style(STRING)                    -
--
Kill !!mdsaddbracing

-- Define Form
setup form  !!mdsaddbracing at xr0 yr0 noquit

  !!mdsaddbracing.formtitle    = ||
  !!mdsaddbracing.icontitle    = ||
  !!mdsaddbracing.formrevision = | $Revision: 1.1.1.1 $ |

  para .tag at x0 y0  text  |Name: |
  path down
  frame .options |Options| width 31
    button .ce |CE| call '!this.currbrace()'
    option .selecta |Type:  | call '!this.braceoption()' width 11
    option .selectb |Size:  | width 11
    para .styl text |Style:  |
    button .oframe    at xmax_Styl-3 ymin_Styl         tooltip 'Outside Frame' pixmap width 19 height 19 call '!this.style(|Outside Frame|)'
    button .iframe    at xmax_oframe ymin_oframe   tooltip 'Inside Frame'  pixmap width 19 height 19 call '!this.style(|Inside Frame|)'
    button .infframe  at xmax_iframe ymin_oframe   tooltip 'Infront Frame' pixmap width 19 height 19 call '!this.style(|Infront Frame|)'
    button .behframe  at xmax_infframe ymin_oframe   tooltip 'Behind Frame'  pixmap width 19 height 19 call '!this.style(|Behind Frame|)'
    button .undercant at xmax_behframe ymin_oframe   tooltip 'Under Cantilever' pixmap width 19 height 19 call '!this.style(|Under Cantilever|)'
    button .infcant   at xmax_undercant ymin_oframe  tooltip 'Infront Cantilever' pixmap width 19 height 19 call '!this.style(|Infront Cantilever|)'
    button .behcant   at xmax_infcant ymin_oframe    tooltip 'Behind Cantilever' pixmap width 19 height 19 call '!this.style(|Behind Cantilever|)'
    button .createbycur at xmax_ce+.5 ymin_ce   tooltip 'Pick' pixmap width 19 height 19 call '!this.pickbrace()'
    button .bracing  at xmax_CreateByCur+.5 ymin_ce tooltip 'New Brace' pixmap width 19 height 19 call '!this.newbrace()'
    button .flip     at xmax_bracing+.5 ymin_ce tooltip 'Mirror Brace'  pixmap width 19 height 19 call '!this.handbrace()'
    button .nudgebrace    at xmax_Flip+.5 ymin_ce    tooltip 'Nudge Brace'   pixmap width 10 height 10 call '!this.nudgebrace()'
    button .delbrace at xmax_Nudgebrace+2.5 ymin_ce   tooltip 'Delete Brace'  pixmap width 10 height 10 call '!this.delbrace()'
  exit

  frame .dimensions |Dimensions| width 31
    text   .texta    |Dim 'L'| at x1 y1 call '!this.ldimension()' width 14 is REAL format !!distancefmt
    text   .textb    |Dim 'H'| at xmin_Texta ymin_Texta+1 call '!this.hdimension()' width 14 is REAL format !!distancefmt
    text   .textc    |Angle  | at xmin_Texta ymin_Textb+1 call '!this.braceangle()' width 14 is REAL format !!anglefmt
    text   .textd    |Offset | at xmin_Texta ymin_Textc+1 call '!this.braceangle()' width 14 is REAL format !!distancefmt
    rgroup .vertical |Lock| at xmax_Texta ymin_Texta-.6 call '!this.locks()'
      add tag 'L'
      add tag 'H'
      add tag 'A'
    exit
  exit
  halign right
  path down
  vdist 1
  button .cancel  |Dismiss| call '!this.cancel()'
  button .ok      |Apply| at xmin_Selecta ymin_Cancel call '!this.initialise()'
  button .viewstd at xmax_OK+1 ymin_OK       tooltip 'View Standard'       pixmap width 18 height 18 call '!this.braceplot()'
  button .dim     at xmax_ViewStd+.5 ymin_OK tooltip 'Show/hide Dimensions' pixmap width 18 height 18 call '!this.dimbrace()'
  para   .brname  at xmax_Tag+3 ymin_Tag width 11 lines 1

  member .form is FORM
  --<dw>28feb2008dun858 - For consistency with mdsPopulate
  -- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
  --<dw>28feb2008dun858 - End

  -- End form definition
exit

!!mdsseticonback(!!mdsaddbracing,'white')


-- Form INIT method
define method .init(!form is FORM )
  !this.form = !form
  !this.load()
  !this.show()
endmethod


-- Apply form settings for new bracing if none exist or last bracing if bracing exists
-- highlight brace name (first brace) if no brace members exist
define method .load()
  !psname  = !this.form.support.stru.namn
  !!mdsaddbracing.formtitle    = |Bracing-$!psname|

  --<dw>28feb2008dun858 - Read PARAGON MDS Defaults Catalogue to load ACTIVE MDS FRAMEWORK Support Types
  !!mdsPopulate(!!mdsaddbracing,'BRACING')
  --<dw>28feb2008dun858 - End

  --<dw>28feb2008dun858 - 'Type' now extracted using mdsPopulate.pmlfrm
  --<dw>Nov2007 Modified to allow for correct replacement name. All
  --<dw>if statements, where selection equals FB01/FB02, also updated.
  -- !lined = ARRAY()
  -- !liner = ARRAY()
  -- if (defined(!!codeFB01)) then
  --    !lined.append(|$!!codeFB01|)
  --    !liner.append(|FB01|)
  -- endif
  -- if (defined(!!codeFB02)) then
  --    !lined.append(|$!!codeFB02|)
  --    !liner.append(|FB02|)
  -- endif
  -- !this.selecta.dtext = !lined
  -- !this.selecta.rtext = !liner
  --<dw>Nov2007 End of mod
  --<dw>28feb2008dun858 - End 'Type' extraction.

  /MDS/FRAMES/FB01
  !sctarray = ARRAY()
  var !mem mem stru count
  do !x to $!mem
    stru $!x
    !sctn = !!ce.description
    !sctarray.append(!sctn)
  enddo
  !this.selectb.dtext = !sctarray

  do !x to 8
    !bracename   = !psname + '-BR$!x'
    /$!bracename
    handle(2,109)
      if ($!x eq 1) then
        !this.ce.active          = FALSE
        !this.createbycur.active = FALSE
        !this.bracing.active     = FALSE
        !this.flip.active        = FALSE
        !this.nudgebrace.active  = FALSE
        !this.delbrace.active    = FALSE
        !this.textd.active       = FALSE
        !this.texta.val  = 500
        !this.textb.val  = 500
        !this.textc.val  = 45
        frmw1 of /$!psname
        last mem
      else
        !y = ($!x - 1)
        !bracename   = !psname + '-BR$!y'
        /$!bracename
        !desp = despara
        !wdes = wdespara
        !this.texta.val = $!desp[6]
        !this.textb.val = $!desp[5]
        !this.textc.val = $!desp[7]

        if (!desp[8] gt 6) then
          !this.selecta.val  = 2
          !this.textd.active = TRUE
          !this.textd.val    = $!desp[10]
          handle(2,752)
            !this.textd.val   = 30
          endhandle
        else
          !this.selecta.val  = 1
          !this.textd.active = FALSE
        endif

        if (!wdes[9] eq 'A') then
          !this.selectb.val = 1
        elseif (!wdes[9] eq 'B') then
          !this.selectb.val = 2
        elseif (!wdes[9] eq 'C') then
          !this.selectb.val = 3
        else
          !this.selectb.val = 1
        endif

        !selectc = desc
        !this.oframe.active        = FALSE
        !this.iframe.active        = FALSE
        !this.infframe.active      = FALSE
        !this.behframe.active      = FALSE
        !this.undercant.active     = FALSE
        !this.infcant.active       = FALSE
        !this.behcant.active       = FALSE

        if (!desp[8] eq 2 or !desp[8] eq 3 or !desp[8] eq 8 or !desp[8] eq 10) then
          if (!selectc eq 'Infront Frame') then
            !this.infframe.active = TRUE
          else
            !this.behframe.active = TRUE
          endif
        elseif (!desp[8] eq 5) then
          if (!selectc eq 'Infront Cantilever') then
            !this.infcant.active  = TRUE
          else
            !this.behcant.active  = TRUE
          endif
        elseif (!desp[8] eq 6) then
          !this.undercant.active   = TRUE
        else
          if (!selectc eq 'Inside Frame') then
            !this.iframe.active   = TRUE
          else
            !this.oframe.active   = TRUE
          endif
        endif
      endif
      break
    endhandle
  enddo
  !this.brname.val = !bracename

  if (!this.ce.active eq FALSE) then
    !this.brname.background = 5
  else
    !this.brname.background = 1
    rem ce add ce col 2
  endif
  !this.vertical.val = 3
  !this.textc.active = FALSE
  !!graphicalDim     = TRUE

endmethod


-- Display default brace clearance at structural section if type FB02 selected
define method .braceoption()

  !bracename = !!ce.name
  --<dw>28feb2008dun858 - Simplify template selection
  !templatename = '/MDS/FRAMES/' & !this.selecta.rtext[!this.selecta.val]
  $!templatename
  --<dw>28feb2008dun858 - End simplify
  !sctarray = ARRAY()
  !desp     = ARRAY()
  var !mem mem stru count
  do !x to $!mem
    stru $!x
    !sctn = !!ce.description
    !sctarray.append(!sctn)
    if (!x eq 1) then
      !desp = despara of sctn1 of frmw1
    endif
  enddo
  !this.selectb.dtext = !sctarray
  if (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
    !this.textd.active = TRUE
    !this.textd.val    = $!desp[5]
  else
    !this.textd.val    = 0
    !this.textd.active = FALSE
  endif
  $!bracename

endmethod

-- Display current brace settings on form
define method .currbrace()

  !psname    = !this.form.support.stru.namn
  !bracename = !!ce.fullname
  !bracesctn = !!ce.type
  -- if (!bracename.after('/').before('-') neq !psname) then
  --<dw>aug2008 Dun979 to account for delimiters in support name
  if (!bracename.after('/').match(!psname) neq 1) then
    !!alert.error('Must be on support $!psname')
    return
  endif
  if (!bracesctn eq 'SCTN' and !bracename.match('-BR') neq 0) then
    !this.brname.val      = !bracename.after('/')
  endif
  !desp = despara
  !wdes = wdespara
  !this.texta.val = $!desp[6]
  !this.textb.val = $!desp[5]
  !this.textc.val = $!desp[7]

  if (!desp[8] gt 6) then
    !this.selecta.val  = 2
    !this.textd.active = TRUE
    !this.textd.val    = $!desp[10]
    handle(2,752)
      !this.textd.val   = 30
    endhandle
  else
    !this.selecta.val  = 1
    !this.textd.val    = 0
    !this.textd.active = FALSE
  endif

  if (!wdes[9] eq 'A') then
    !this.selectb.val = 1
  elseif (!wdes[9] eq 'B') then
    !this.selectb.val = 2
  elseif (!wdes[9] eq 'C') then
    !this.selectb.val = 3
  else
    !this.selectb.val = 1
  endif

  !selectc = desc
  !this.oframe.active    = FALSE
  !this.iframe.active    = FALSE
  !this.infframe.active  = FALSE
  !this.behframe.active  = FALSE
  !this.undercant.active = FALSE
  !this.infcant.active   = FALSE
  !this.behcant.active   = FALSE
  if (!desp[8] eq 2 or !desp[8] eq 3 or !desp[8] eq 8 or !desp[8] eq 10) then
    if (!selectc eq 'Infront Frame') then
      !this.infframe.active = TRUE
    else
      !this.behframe.active = TRUE
    endif
  elseif (!desp[8] eq 5) then
    if (!selectc eq 'Infront Cantilever') then
      !this.infcant.active  = TRUE
    else
      !this.behcant.active  = TRUE
    endif
  elseif (!desp[8] eq 6) then
    !this.undercant.active   = TRUE
  else
    if (!selectc eq 'Inside Frame') then
      !this.iframe.active   = TRUE
    else
      !this.oframe.active   = TRUE
    endif
  endif

  aid clear all

endmethod


-- Identify brace section by cursor and display settings on form
define method .pickbrace()

  !psname   = !this.form.support.stru.namn
  prompt off
  prompt load escape|Identify brace member to be modified|
  id sctn@
  !bracename = !!ce.fullname
  !bracesctn = !!ce.type
  prompt dismiss
  prompt on
  -- if (!bracename.after('/').before('-') neq !psname) then
  --<dw>aug2008 Dun979 to account for delimiters in support name
  if (!bracename.after('/').match(!psname) neq 1) then
    !!alert.error('Must be on support $!psname')
    return
  endif
  if (!bracesctn eq 'SCTN' and !bracename.match('-BR') neq 0) then
    !this.brname.val      = !bracename.after('/')
  endif
  !desp = despara
  !wdes = wdespara

  !this.texta.val = $!desp[6]
  !this.textb.val = $!desp[5]
  !this.textc.val = $!desp[7]

  if (!desp[8] gt 6) then
    !this.selecta.val  = 2
    !this.textd.active = TRUE
    !this.textd.val    = $!desp[10]
    handle(2,752)
      !this.textd.val = 30
    endhandle
  else
    !this.selecta.val  = 1
    !this.textd.val    = 0
    !this.textd.active = FALSE
  endif

  if (!wdes[9] eq 'A') then
    !this.selectb.val = 1
  elseif (!wdes[9] eq 'B') then
    !this.selectb.val = 2
  elseif (!wdes[9] eq 'C') then
    !this.selectb.val = 3
  else
    !this.selectb.val = 1
  endif

  !selectc  = desc
  !this.oframe.active    = FALSE
  !this.iframe.active    = FALSE
  !this.infframe.active  = FALSE
  !this.behframe.active  = FALSE
  !this.undercant.active = FALSE
  !this.infcant.active   = FALSE
  !this.behcant.active   = FALSE
  if (!desp[8] eq 2 or !desp[8] eq 3 or !desp[8] eq 8 or !desp[8] eq 10) then
    if (!selectc eq 'Infront Frame') then
      !this.infframe.active = TRUE
    else
      !this.behframe.active = TRUE
    endif
  elseif (!desp[8] eq 5) then
    if (!selectc eq 'Infront Cantilever') then
      !this.infcant.active  = TRUE
    else
      !this.behcant.active  = TRUE
    endif
  elseif (!desp[8] eq 6) then
    !this.undercant.active   = TRUE
  else
    if (!selectc eq 'Inside Frame') then
      !this.iframe.active   = TRUE
    else
      !this.oframe.active   = TRUE
    endif
  endif

  aid clear all

endmethod


-- flip and re-align bracing with frame member to which attached
define method .handbrace()

  !bracename = !this.brname.val
  /$!bracename
  flip
  !type     = !!ce.catref.gtype
  !para     = !!ce.catref.para
  if (!type eq 'ANG') then
    var !dirn ppline nal dir start
  elseif (!type eq 'BSC') then
    var !dirn ppline foc dir start
  endif
  by $!dirn $!para[2] mm

endmethod


-- move bracing by discrete amount in nominated direction
define method .nudgebrace()

  !bracename = !this.brname.val
  /$!bracename
  show !!mdsNudgeBrace
  !!mdsNudgeBrace.sctn = !!ce

endmethod


-- delete current brace, renumber existing brace members and apply form settings to last brace
-- highlight brace name (first brace) if no brace members remaining after deletion
define method .delbrace()

  --<dw>mar2009 DFN P-17331 DAC control added.
  !!mdsDacControl(TRUE)

  !psname    = !this.form.support.stru.namn
  !bracename = !this.brname.val
  --<dwjan2008 Addition for Oglaend
  !origname  = !bracename
  --<dwjan2008 End of addition for Oglaend
  /$!bracename
  !bracexist = TRUE
  !attaexist = TRUE
  !attaname  = !bracename.replace(!psname & '-BR',!psname & '/BR')
  !!mdsresetpins(1,9)

  !answer = !!alert.confirm('Delete $!bracename')
  if (!answer eq 'YES') then
    delete sctn
    var !mem mem sctn count
    !x = 0
    do !z to $!mem
      sctn $!z
      !bracename = !!ce.fullname
      if (!bracename.match(!psname & '-BR') neq 0) then
        !x = ($!x + 1)
        !newbracename = !psname + '-BR$!x'
        name /$!newbracename
        handle(41,12)
          skip
        endhandle
      endif
      if ($!z eq $!mem and $!x eq 0) then
        !newbracename = !psname + '-BR1'
        !bracexist               = FALSE
        !this.ce.active          = FALSE
        !this.createbycur.active = FALSE
        !this.bracing.active     = FALSE
        !this.flip.active        = TRUE
        !this.nudgebrace.active  = TRUE
        !this.delbrace.active    = TRUE
      endif
    enddo
    !this.brname.val     = !newbracename
    !this.brname.background = 1
    if (!bracexist eq FALSE) then
      !this.texta.val   = 500
      !this.textb.val   = 500
      !this.textc.val   = 45
      !this.selecta.val = 1
      !this.selectb.val = 1
    else
      !desp = despara
      !wdes = wdespara
      !this.texta.val = $!desp[6]
      !this.textb.val = $!desp[5]
      !this.textc.val = $!desp[7]

      if (!desp[8] gt 6) then
        !this.selecta.val  = 2
        !this.textd.active = TRUE
        !this.textd.val    = $!desp[10]
        handle(2,752)
          !this.textd.val = 30
        endhandle
      else
        !this.selecta.val  = 1
        !this.textd.val    = 0
        !this.textd.active = FALSE
      endif

      if (!wdes[9] eq 'A') then
        !this.selectb.val = 1
      elseif (!wdes[9] eq 'B') then
        !this.selectb.val = 2
      elseif (!wdes[9] eq 'C') then
        !this.selectb.val = 3
      else
        !this.selectb.val = 1
      endif

      !selectc  = desc
      !this.oframe.active    = FALSE
      !this.iframe.active    = FALSE
      !this.infframe.active  = FALSE
      !this.behframe.active  = FALSE
      !this.undercant.active = FALSE
      !this.infcant.active   = FALSE
      !this.behcant.active   = FALSE
      if (!desp[8] eq 2 or !desp[8] eq 3 or !desp[8] eq 8 or !desp[8] eq 10) then
        if (!selectc eq 'Infront Frame') then
          !this.infframe.active = TRUE
        else
          !this.behframe.active = TRUE
        endif
      elseif (!desp[8] eq 5) then
        if (!selectc eq 'Infront Cantilever') then
          !this.infcant.active  = TRUE
        else
          !this.behcant.active  = TRUE
        endif
      elseif (!desp[8] eq 6) then
        !this.undercant.active   = TRUE
      else
        if (!selectc eq 'Inside Frame') then
          !this.iframe.active   = TRUE
        else
          !this.oframe.active   = TRUE
        endif
      endif
    endif
    /$!attaname
    handle(2,109)
      !attaexist = FALSE
    endhandle
    if (!attaexist eq TRUE) then
      delete atta
      var !mem mem atta count
      !x = 0
      do !z to $!mem
        skip if (!z eq 0)
        atta $!z
        !attaname = !!ce.fullname
        if (!attaname.match(!psname & '/BR') neq 0) then
          !x = ($!x + 1)
          !newattaname   = '/' & !psname + '/BR$!x'
          !currbracename = '/' & !psname + '-BR$!x'
          $!currbracename
          !desp  = despara
          !wdes  = wdespara
          !orien = function
          same
          name $!newattaname
          handle(41,12)
          endhandle
          despara $!desp[8] $!desp[6] $!desp[5] $!wdes[9]
          :mdscp3 '$!orien'
        endif
      enddo
      $!currbracename
      handle(46,28)
        !this.brname.background    = 5
        !this.oframe.active        = TRUE
        !this.iframe.active        = TRUE
        !this.infframe.active      = TRUE
        !this.behframe.active      = TRUE
        !this.undercant.active     = TRUE
        !this.infcant.active       = TRUE
        !this.behcant.active       = TRUE
        !this.ce.active            = FALSE
        !this.createbycur.active   = FALSE
        !this.flip.active          = FALSE
        !this.nudgebrace.active    = FALSE
        !this.delbrace.active      = FALSE
      endhandle
    endif

    --<dwjan2008 Addition for Oglaend
    !snodexist  = TRUE
    !snodname   = '/' & !origname & '-S1'
    $!snodname
    handle(2,109)
      !snodexist  = FALSE
    endhandle
    if (!snodexist eq TRUE) then
      delete snod
    endif
    --<dwjan2008 End of addition for Oglaend

  endif
  aid clear all

  --<dw>mar2009 DFN P-17331 DAC control removed.
  !!mdsDacControl(FALSE)

  !!mdsbracings(!this.form)

endmethod


-- Create new brace with brace name highlighted
define method .newbrace()

  !psname         = !this.form.support.stru.namn
  do !x to 6
    !bracename   = !psname + '-BR$!x'
    /$!bracename
    handle(2,109)
      !this.brname.val = !bracename
      break
    endhandle
  enddo
  !this.selecta.val          = 1
  !this.ce.active            = FALSE
  !this.createbycur.active   = FALSE
  !this.flip.active          = FALSE
  !this.nudgebrace.active    = FALSE
  !this.delbrace.active      = FALSE
  !this.brname.background    = 5
  aid clear all
  !this.oframe.active        = TRUE
  !this.iframe.active        = TRUE
  !this.infframe.active      = TRUE
  !this.behframe.active      = TRUE
  !this.undercant.active     = TRUE
  !this.infcant.active       = TRUE
  !this.behcant.active       = TRUE

endmethod


-- highlight brace style for existing brace member
define method .style(!selectc is STRING)

  !this.oframe.active       = FALSE
  !this.iframe.active       = FALSE
  !this.infframe.active     = FALSE
  !this.behframe.active     = FALSE
  !this.undercant.active    = FALSE
  !this.infcant.active      = FALSE
  !this.behcant.active      = FALSE
  if (!selectc eq 'Outside Frame') then
    !this.oframe.active    = TRUE
  elseif (!selectc eq 'Inside Frame') then
    !this.iframe.active    = TRUE
  elseif (!selectc eq 'Infront Frame') then
    !this.infframe.active  = TRUE
  elseif (!selectc eq 'Behind Frame') then
    !this.behframe.active  = TRUE
  elseif (!selectc eq 'Under Cantilever') then
    !this.undercant.active = TRUE
  elseif (!selectc eq 'Infront Cantilever') then
    !this.infcant.active   = TRUE
  elseif (!selectc eq 'Behind Cantilever') then
    !this.behcant.active   = TRUE
  endif

endmethod


-- Lock either dimension L, dimension H or angle where locked text is set inactive.
define method .locks()

  if (!this.vertical.val eq 1) then
    !this.texta.active = FALSE
    !this.textb.active = TRUE
    !this.textc.active = TRUE
  elseif (!this.vertical.val eq 2) then
    !this.texta.active = TRUE
    !this.textb.active = FALSE
    !this.textc.active = TRUE
  elseif (!this.vertical.val eq 3) then
    !this.texta.active = TRUE
    !this.textb.active = TRUE
    !this.textc.active = FALSE
  endif

endmethod


-- L dimension entry results in update to either H dimension or angle depending which one is unlocked.
define method .ldimension()

  if (!this.texta.val.string().length() eq 0) then
    !this.texta.val  = 0
  endif
  if (!this.vertical.val eq 2) then
    if (!this.texta.val gt 0 and !this.textb.val gt 0) then
      !this.textc.val = (atan ($!this.texta.val / $!this.textb.val))
    endif
  elseif (!this.vertical.val eq 3) then
    if (!this.texta.val gt 0 and !this.textc.val gt 0) then
      !this.textb.val = ($!this.texta.val / tan ($!this.textc.val))
    endif
  endif

endmethod



-- H dimension entry results in update to either L dimension or angle depending which one is unlocked.
define method .hdimension()

  if (!this.textb.val.string().length() eq 0) then
    !this.textb.val  = 0
  endif
  if (!this.vertical.val eq 1) then
    if (!this.texta.val gt 0 and !this.textb.val gt 0) then
      !this.textc.val = (atan ($!this.texta.val / $!this.textb.val))
    endif
  elseif (!this.vertical.val eq 3) then
    if (!this.textb.val gt 0 and !this.textc.val gt 0) then
      !this.texta.val = ($!this.textb.val * tan ($!this.textc.val))
    endif
  endif

endmethod


-- Angle entry results in update to either L or H dimension depending which one is unlocked.
define method .braceangle()

  if (!this.textc.val.string().length() eq 0) then
    !this.textc.val  = 45
  endif
  if (!this.vertical.val eq 1) then
    if (!this.texta.val gt 0) then
      !this.textb.val = ($!this.texta.val / tan ($!this.textc.val))
    endif
  elseif (!this.vertical.val eq 2) then
    if (!this.textb.val gt 0) then
      !this.texta.val = ($!this.textb.val * tan ($!this.textc.val))
    endif
  endif

endmethod


-- Start creating new brace, if new brace setting, or modifying existing brace
define method .initialise()

  !psname  = !this.form.support.stru.namn
  prec var 0dp
  !!mdsresetpins(1,9)

  if (!this.oframe.active eq TRUE and !this.iframe.active eq TRUE and !this.infframe.active eq TRUE and !this.behframe.active eq TRUE) then
    if (!this.undercant.active eq TRUE and !this.infcant.active eq TRUE and !this.behcant.active eq TRUE) then
      !!alert.error(|Identify 'Style' then press 'Apply'|)
      return
    endif
  endif
  if (!this.oframe.active eq TRUE) then
    !selectc = 'Outside Frame'
  elseif (!this.iframe.active eq TRUE) then
    !selectc = 'Inside Frame'
  elseif (!this.infframe.active eq TRUE) then
    !selectc = 'Infront Frame'
  elseif (!this.behframe.active eq TRUE) then
    !selectc = 'Behind Frame'
  elseif (!this.undercant.active eq TRUE) then
    !selectc = 'Under Cantilever'
  elseif (!this.infcant.active eq TRUE) then
    !selectc = 'Infront Cantilever'
  elseif (!this.behcant.active eq TRUE) then
    !selectc = 'Behind Cantilever'
  endif

  if (!this.texta.val eq 0 or !this.textb.val eq 0) then
    !!alert.error(|Dimensions 'L' and 'H' must have values > 0|)
    return
  endif

  -- Identify frame member to be braced and set orthogonal directions from datum atta

  prompt off
  prompt load escape|Identify frame member to be braced|
  id sctn@
  !membername = !!ce.fullname
  !bang       = !!ce.bangle
  prompt dismiss
  prompt on
  -- if (!membername.after('/').before('-') neq !psname) then
  --<dw>aug2008 Dun979 to account for delimiters in support name
  if (!membername.after('/').match(!psname) neq 1) then
    !!alert.error('Must be on support $!psname')
    return
  endif
  !memtype     = !membername.dbref().catref.gtype
  !mempara     = para of catr of $!membername
  !memleng     = derlen of $!membername
  !memdirn     = 'xxx'
  if (!memtype eq 'BEAM') then
    var !memdirn ppline tos dir start wrt world
  endif

  -- !attaname    = !membername.before('-') + '/DATUM'
  --<dw>aug2008 Dun979 to account for delimiters in support name
  !attaname    = '/' + !psname + '/DATUM'
  !directions  = !!mdsremovegrad(!attaname.dbref())
  !p2Dirn      = !directions[1]
  !p2DirnOpp   = !directions[2]
  !p9Dirn      = !directions[3]
  !p9DirnOpp   = !directions[4]
  !p10Dirn     = !directions[5]
  !p11Dirn     = !directions[6]
  !p2Dir       = !p2Dirn.string().before(' WRT')
  !p2DirOpp    = !p2DirnOpp.string().before(' WRT')
  !p9Dir       = !p9Dirn.string().before(' WRT')
  !p9DirOpp    = !p9DirnOpp.string().before(' WRT')
  !p10Dir      = !p10Dirn.string().before(' WRT')
  !p11Dir      = !p11Dirn.string().before(' WRT')

  stru
  !ori         = orientation
  !oriz        = !ori.zdir().string().before(' WRT')
  !dimrefstrut = FALSE
  !horizontal  = FALSE
  !supportype  = :MDSSuppType
  same

  -- Support types applied as special case:
  -- FT05,FT06           Ancillary on side of cantilever extension supporting horizontal pipes.
  -- FT18                Ancillary at centreline of tee post
  -- FT34B,FT42,FT56     Ancillary in horizontal supporting vertical pipes.
  -- FT62,FT63,FT64,FT65 Ancillary inverted supporting horizontal pipes under frame cross member.

  -- Temporary offset of vertical T-post member for equiv positioning to that of left leg goal post
  if (!supportype eq 'FT18') then
    by $!p10Dir 60 mm
  endif

  -- Identify supporting member for brace attachment

  !idtype    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  prompt off
  prompt load escape|Identify supporting member|
  id $!idtype @
  !structname = !!ce.fullname
  !structtype = !!ce.type
  prompt dismiss
  prompt on

  -- Check whether supporting member parallel to pipe if brace outside frame or normal to pipe if brace behind frame

  if (!structtype eq 'SCTN') then
    pin4 at poss of $!structname
    pin4 dir tow pose of $!structname
    var !pin4Dir pin4 dir
    if (!selectc eq 'Outside Frame') then
      if (!supportype inset ('FT42','FT56')) then
        if (!pin4Dir eq !p9Dirn.string().before(' WRT') or !pin4Dir eq !p9Dirn.opposite().string().before(' WRT')) then
          !dimrefstrut = TRUE
        endif
      else
        if (!pin4Dir eq !p2Dirn.string().before(' WRT') or !pin4Dir eq !p2Dirn.opposite().string().before(' WRT')) then
          !dimrefstrut = TRUE
        endif
      endif
    elseif (!selectc eq 'Behind Frame' or !selectc eq 'Infront Frame') then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        if (!pin4Dir eq !p9Dirn.string().before(' WRT') or !pin4Dir eq !p9Dirn.opposite().string().before(' WRT')) then
          !dimrefstrut = TRUE
        endif
      else
        if (!pin4Dir eq !p10Dirn.string().before(' WRT') or !pin4Dir eq !p10Dirn.opposite().string().before(' WRT')) then
          !dimrefstrut = TRUE
        endif
      endif
      if (!dimrefstrut eq TRUE) then
        !strupos = position
        --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
        !padExists = FALSE
        !padName = !!ce.name & '/pnod1/pjoi1'
        $!padName
        handle any
        elsehandle none
          if !!ce.gtyp.eq('APAD') then
            !padExists = TRUE
            $!membername
          endif
        endhandle

        pin6 at $!attaname
        pin6 dir $!p2Dirn
        pin6 move pin6 thr $!structname
        pin6 dir tow $!attaname
        var !pin6Dir pin6 dir
        !direction = object KEQUALDIR()
        !direction.directionA = !p2DirnOpp
        !direction.directionB = !pin6Dir.direction()
        !direction.tolerance  = 0.05
        if (!!kdirequaldir(!direction)) then
          if (!selectc eq 'Infront Frame' and !p9Dir eq 'D' or !selectc eq 'Infront Frame' and !p9Dir eq '-Z') then
            !!alert.error(|'Style' must be set to 'Behind Frame'|)
            !this.behframe.active = TRUE
            pos $!strupos
            if !padExists then
            	!ce = !!ce
            	$!padName
            	rule exe all
            	!!ce = !ce
            endif
            return
          endif
        else
          if (!selectc eq 'Behind Frame'  and !p9Dir eq 'D' or !selectc eq 'Behind Frame'  and !p9Dir eq '-Z') then
            !!alert.error(|'Style' must be set to 'Infront Frame'|)
            !this.infframe.active = TRUE
            pos $!strupos
            if !padExists then
            	!ce = !!ce
            	$!padName
            	rule exe all
            	!!ce = !ce
            endif
            return
          endif
        endif
        pos $!strupos
        if !padExists then
          !ce = !!ce
          $!padName
          rule exe all
          !!ce = !ce
        endif
      endif
    endif
  endif

  -- Identify required brace direction in relation to identified vertical frame member
  -- pin3 attached to vertical leg then aligned with and directed towards atta.
  -- kdirequaldir applied to determine whether LH or RH leg

  !pin3diratta = TRUE
  pin3 at poss of $!membername
  pin3 dir $!p9Dirn
  pin3 plane pin3 through $!attaname
  pin3 dir $!p2Dirn
  pin3 plane pin3 through $!attaname
  pin3 dir tow $!attaname
  handle(61,52)
    !pin3Dir = !p11Dir
    !pin3diratta = FALSE
  endhandle
  if (!pin3diratta eq TRUE) then
    var !pin3Dir pin3 dir
  endif

  !direction = object KEQUALDIR()
  !direction.directionA = !p10Dirn.opposite()
  !direction.directionB = !pin3Dir.direction()
  !direction.tolerance  = 0.05
  if (!!kdirequaldir(!direction)) then
    -- On the LH Vertical in p2 direction
  else
    -- On the RH Vertical in p2 direction
  endif

  -- Find template sctn matching form selection
  if (!this.selecta.rtext[!this.selecta.val] eq 'FB01') then
    /MDS/FRAMES/FB01
  else
    /MDS/FRAMES/FB02
  endif
  !sctarray = ARRAY()
  var !y collect all sctn for ce
  do !x values !y
    !sctnspre = !x.dbref().fullname
    !sctarray.append(!sctnspre)
  enddo
  !sctnreqd = !sctarray[!this.selectb.val]


  -- Find pline on vertical member corresponding to brace direction - outer, inner etc.

  !attaposn = !attaname.dbref().position
  !fradbref = !membername.dbref()

  if (!selectc eq 'Outside Frame') then
    -- where web of beam is in same direction as axis of pipe requiring 'flange or web'
    -- positioning to determine outer position on web, this wrt pin5 300mm to outside.
    if (!memtype eq 'BEAM' and !memdirn.direction() eq !p2Dirn) then
      !p10DirnOpp   = !p10Dirn.opposite()
      $!membername
      !strupos  = position
      --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
      !padExists = FALSE
      !padName = !!ce.name & '/pnod1/pjoi1'
      $!padName
      handle any
      elsehandle none
        if !!ce.gtyp.eq('APAD') then
          !padExists = TRUE
          $!membername
        endif
      endhandle
      pin5 at poss
      pin5 dir $!p10Dirn
      pin5 move pin5 $!p10Dirn dist 300 mm
      var !pin5 pin5 pos wrt world
      pos $!strupos
      if !padExists then
        !ce = !!ce
        $!padName
        rule exe all
        !!ce = !ce
      endif
      !pin5pos  = !pin5.position()
      if (!p9Dir eq 'U') or (!p9Dir eq 'Z') then
        !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p10Dirn)
      else
        !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p10DirnOpp)
      endif
      pin1 dir $!p10DirnOpp
    else
      -- FarPline positioning to determine outer position on vertical leg in all other cases
      if (!!kdirequaldir(!direction)) then
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          !plinreqd = !!kfarpline(!fradbref,!attaposn,!p9Dirn)
          pin1 dir $!p9Dirn
        else
          !plinreqd = !!kfarpline(!fradbref,!attaposn,!p10Dirn)
          pin1 dir $!p10Dirn
        endif
      else
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          !plinreqd = !!kfarpline(!fradbref,!attaposn,!p9DirnOpp)
          pin1 dir $!p9DirnOpp
        else
          !plinreqd = !!kfarpline(!fradbref,!attaposn,!p11Dirn)
          pin1 dir $!p11Dirn
        endif
      endif
      !pkeyreqd = !plinreqd[1].pkey
      var !fposreqd ppline $!pkeyreqd start wrt world of $!membername
    endif

  elseif (!selectc eq 'Inside Frame') then
    -- logic as for 'Outside frame'
    if (!memtype eq 'BEAM' and !memdirn.direction() eq !p2Dirn) then
      !p11DirnOpp   = !p11Dirn.opposite()
      $!membername
      !strupos  = position
      --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
      !padExists = FALSE
      !padName = !!ce.name & '/pnod1/pjoi1'
      $!padName
      handle any
      elsehandle none
        if !!ce.gtyp.eq('APAD') then
          !padExists = TRUE
          $!membername
        endif
      endhandle
      pin5 at poss
      pin5 dir $!p11Dirn
      pin5 move pin5 $!p11Dirn dist 300 mm
      var !pin5 pin5 pos wrt world
      pos $!strupos
      if !padExists then
      	!ce = !!ce
        $!padName
        rule exe all
        !!ce = !ce
      endif
      !pin5pos  = !pin5.position()
      if (!p9Dir eq 'U') or (!p9Dir eq 'Z') then
        !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p11Dirn)
      else
        !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p11DirnOpp)
      endif
      pin1 dir $!p11DirnOpp
    else
      -- logic as for 'Outside frame'
      if (!!kdirequaldir(!direction)) then
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          !plinreqd = !!kclosestpline(!fradbref,!attaposn,!p9DirnOpp)
          pin1 dir $!p9DirnOpp
        else
          !plinreqd = !!kclosestpline(!fradbref,!attaposn,!p10Dirn)
          pin1 dir $!p11Dirn
        endif
      else
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          !plinreqd = !!kclosestpline(!fradbref,!attaposn,!p9Dirn)
          pin1 dir $!p9Dirn
        else
          !plinreqd = !!kclosestpline(!fradbref,!attaposn,!p11Dirn)
          pin1 dir $!p10Dirn
        endif
      endif
      !pkeyreqd = !plinreqd[1].pkey
      var !fposreqd ppline $!pkeyreqd start wrt world of $!membername
    endif

  elseif (!selectc eq 'Behind Frame' or !selectc eq 'Behind Cantilever') then
    -- 'Flange or web' positioning wrt pin5 300mm displaced.
    --  pin3dir applies to displacement along cantilever
    $!membername
    !strupos  = position
    --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
    !padExists = FALSE
    !padName = !!ce.name & '/pnod1/pjoi1'
    $!padName
    handle any
    elsehandle none
      if !!ce.gtyp.eq('APAD') then
        !padExists = TRUE
        $!membername
      endif
    endhandle
    if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
      pin5 at pose
    else
      pin5 at poss
    endif
    if (!supportype eq 'FT05') then
      !pin3Dir = !p9DirOpp
    elseif (!supportype eq 'FT06') then
      !pin3Dir = !p9Dir
    endif
    if (!supportype inset ('FT42','FT56','FT34B')) then
      pin5 dir $!p9Dirn
      pin5 move pin5 $!p9DirnOpp dist 300 mm
    else
      pin5 dir $!p2DirnOpp
      pin5 move pin5 $!p2Dirn dist 300 mm
    endif
    var !pin5 pin5 pos wrt world
    pos $!strupos
    if !padExists then
    	!ce = !!ce
      $!padName
      rule exe all
      !!ce = !ce
    endif
    !pin5pos  = !pin5.position()
    if (!p9Dir eq 'U') or (!p9Dir eq 'Z') then
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p2Dirn)
    elseif (!supportype inset ('FT42','FT56','FT34B')) then
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p9Dirn)
    else
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p2DirnOpp)
    endif
    if (!supportype inset ('FT42','FT56','FT34B')) then
      pin1 dir $!p9DirnOpp
    else
      pin1 dir $!p2Dirn
    endif

  elseif (!selectc eq 'Infront Frame' or !selectc eq 'Infront Cantilever') then
    -- logic applies as for 'Behind frame'
    $!membername
    !strupos  = position
    --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
    !padExists = FALSE
    !padName = !!ce.name & '/pnod1/pjoi1'
    $!padName
    handle any
    elsehandle none
      if !!ce.gtyp.eq('APAD') then
        !padExists = TRUE
        $!membername
      endif
    endhandle
    if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
      pin5 at pose
    else
      pin5 at poss
    endif
    if (!supportype eq 'FT05') then
      !pin3Dir = !p9DirOpp
    elseif (!supportype eq 'FT06') then
      !pin3Dir = !p9Dir
    endif
    if (!supportype inset ('FT42','FT56','FT34B')) then
      pin5 dir $!p9DirnOpp
      pin5 move pin5 $!p9Dirn dist 300 mm
    else
      pin5 dir $!p2Dirn
      pin5 move pin5 $!p2DirnOpp dist 300 mm
    endif
    var !pin5 pin5 pos wrt world
    pos $!strupos
    if !padExists then
      !ce = !!ce
      $!padName
      rule exe all
      !!ce = !ce
    endif
    !pin5pos  = !pin5.position()
    if (!p9Dir eq 'U') or (!p9Dir eq 'Z') then
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p2DirnOpp)
    elseif (!supportype inset ('FT42','FT56','FT34B')) then
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p9DirnOpp)
    else
      !fposreqd = !!kflangeorweb(!fradbref,!pin5pos,!p2Dirn)
    endif
    if (!supportype inset ('FT42','FT56','FT34B')) then
      pin1 dir $!p9Dirn
    else
      pin1 dir $!p2DirnOpp
    endif

  elseif (!selectc eq 'Under Cantilever') then
    -- FarPline applied to determine lower point on cantilever
    if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
      !plinreqd = !!kfarpline(!fradbref,!attaposn,!p10Dirn)
      pin1 dir $!p10Dirn
    elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
      !plinreqd = !!kfarpline(!fradbref,!attaposn,!p11Dirn)
      pin1 dir $!p11Dirn
    elseif (!supportype eq 'FT34B') then
      !plinreqd = !!kfarpline(!fradbref,!attaposn,!p2Dirn)
      pin1 dir $!p9Dirn
    else
      !plinreqd = !!kfarpline(!fradbref,!attaposn,!p9Dirn)
      pin1 dir $!p9Dirn
    endif
    !pkeyreqd = !plinreqd[1].pkey
    if (!supportype eq 'FT05') then
      var !fposreqd ppline $!pkeyreqd end wrt world of $!membername
      !pin3Dir = !p9DirOpp
    elseif (!supportype eq 'FT06') then
      var !fposreqd ppline $!pkeyreqd end wrt world of $!membername
      !pin3Dir = !p9Dir
    elseif (!supportype eq 'FT34B') then
      var !fposreqd ppline $!pkeyreqd end wrt world of $!membername
      !pin3Dir = !p10Dir
    else
      var !fposreqd ppline $!pkeyreqd start wrt world of $!membername
    endif
  endif
  var !pin1Dir pin1 dir wrt world
  !pin1DirOpp = !pin1Dir.direction().opposite()

  -- Frame member pline $!pkeyreqd

  -- Determine whether supporting member above or below datum (opposite P9 or direction P9)

  if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
    !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname.dbref(),!p10Dirn,1)
  elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
    !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname.dbref(),!p11Dirn,1)
  elseif (!p9Dir eq 'U') or (!p9Dir eq 'Z') then
    !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname.dbref(),!p9DirnOpp,1)
  elseif (!supportype inset ('FT42','FT56')) then
    !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname.dbref(),!p2Dirn,1)
  else
    !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname.dbref(),!p9Dirn,1)
  endif
  -- Relative to datum is $!relstrupos[1]

  -- Now find pline on supporting member where a sctn and above or below datum

  if (!structtype eq 'SCTN' and !oriz eq 'U' or !structtype eq 'SCTN' and !oriz eq 'D' or !structtype eq 'SCTN' and !oriz eq 'Z' or !structtype eq 'SCTN' and !oriz eq '-Z') then
    !strdbref = !structname.dbref()
    if (!selectc eq 'Under Cantilever') then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        !plinreqd = !!kclosestpline(!strdbref,!attaposn,!p9Dirn)
      else
        !plinreqd = !!kclosestpline(!strdbref,!attaposn,!p10Dirn)
      endif
    else
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        !plinreqd = !!kclosestpline(!strdbref,!attaposn,!p10Dirn)
      elseif (!supportype inset ('FT42','FT56','FT34B')) then
        !plinreqd = !!kclosestpline(!strdbref,!attaposn,!p2Dirn)
      else
        !plinreqd = !!kclosestpline(!strdbref,!attaposn,!p9DirnOpp)
      endif
    endif
    !pkeyreqd = !plinreqd[1].pkey
    !sposreqd = !plinreqd[2]
    -- Struct pline $!pkeyreqd
  else
  	
    !strupos = position
    pin1 at $!fposreqd wrt world
    handle(47,15)
      pin1 at $!fposreqd
    endhandle
    var !prevdir pin1 dir
    pin1 dir $!oriz
    pin1 inf $!structname
    --pin1 move pin1 along $!oriz wrt world inf $!structname
    var !sposreqd pin1 pos wrt world
    pin1 dir $!prevdir
    --pos $!strupos
  endif

  $!membername
  !fposplit = !fposreqd.string().split()
  !sposplit = !sposreqd.string().split()

  -- determine elevation for pin1 except where brace to align with structure
  var !units units
  if (!units.part(3) eq 'mm') then
    !metric = TRUE
  else
    !metric = FALSE
  endif
  if (!dimrefstrut eq TRUE) then
    if (!metric) then
      !newelevn = !sposplit[6].real()
    else
      !newelevn = $!sposplit[6]
    endif
  else
    if (!relstrupos[1].string() eq 'above') then
      if (!metric) then
        !newelevn  = (!sposplit[6].real() - !this.textb.val)
      else
        !elevn = $!sposplit[6]
        !newelevn  = (!elevn - !this.textb.val)
      endif
    else
      if (!metric) then
        !newelevn  = (!sposplit[6].real() + !this.textb.val)
      else
        !elevn = $!sposplit[6]
        !newelevn  = (!elevn + !this.textb.val)
      endif
    endif
  endif

  -- determine brace direction wrt support structure above or below.
  if (!relstrupos[1].string() eq 'above') then
    if (!supportype eq 'FT41' or !p9Dir eq 'D' or !p9Dir eq '-Z') then
      !bracedirn = !p9DirnOpp
    elseif (!supportype inset ('FT42','FT56')) then
      !bracedirn = !p2DirnOpp
    else
      !bracedirn = !p9Dirn
    endif
  else
    if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
      !bracedirn = !p10Dirn
    elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
      !bracedirn = !p11Dirn
    elseif (!supportype inset ('FT62','FT63','FT64','FT65')) then
      !bracedirn = !p9DirnOpp
    elseif (!supportype inset ('FT42','FT56')) then
      !bracedirn = !p2Dirn
    else
      !bracedirn = !p9Dirn
    endif
  endif

  !braceOpp = !bracedirn.opposite()
  !braceDir = !bracedirn.string().before(' WRT')
  !braceOpt = !braceOpp.string().before(' WRT')
  !unusedRelstruposcheck = !relstrupos[1].string()
  -- Relstrupos is $!unusedRelstruposcheck and Bracedirn is $!bracedirn

  -- Position pin on frame
  !strupos = position
  --store pad ref if pad exists so pad can be restored to correct position when sctn repositioned
  !padExists = FALSE
  !padName = !!ce.name & '/pnod1/pjoi1'
  $!padName
  handle any
  elsehandle none
    if !!ce.gtyp.eq('APAD') then
      !padExists = TRUE
      $!membername
    endif
  endhandle

  -- Position pin1 and pin2 on cantilevers (for start/end of bracing)
  -- Position pin1 for vertical frames
  -- Position pin1 and pin2 for horizontal frames
  if (!selectc eq 'Under Cantilever') then
    pin1 at $!fposreqd wrt world
    pin2 copy pin1
    move pin1 $!pin3Dir wrt world dist $!this.textb.val
    if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
      move pin2 $!p10Dirn dist $!this.texta.val
    elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
      move pin2 $!p11Dirn dist $!this.texta.val
    elseif (!supportype eq 'FT34B') then
      move pin2 $!p2Dirn dist $!this.texta.val
    else
      move pin2 $!p9Dir dist $!this.texta.val
    endif
  elseif (!selectc eq 'Behind Cantilever') then
    pin1 at $!fposreqd
    if (!supportype eq 'FT34B') then
      pin1 by $!pin3dir $!memleng
      pin2 copy pin1
      move pin1 $!pin3Dir wrt world dist -$!this.textb.val
      move pin2 $!p9DirOpp wrt world dist $!this.texta.val
    else
      pin2 copy pin1
      move pin1 $!pin3Dir wrt world dist $!this.textb.val
      move pin2 $!p2Dir wrt world dist $!this.texta.val
    endif
  elseif (!selectc eq 'Infront Cantilever') then
    pin1 at $!fposreqd
    if (!supportype eq 'FT34B') then
      pin1 by $!pin3dir $!memleng
      pin2 copy pin1
      move pin1 $!pin3Dir wrt world dist -$!this.textb.val
      move pin2 $!p9Dir wrt world dist $!this.texta.val
    else
      pin2 copy pin1
      move pin1 $!pin3Dir wrt world dist $!this.textb.val
      move pin2 $!p2DirOpp wrt world dist $!this.texta.val
    endif
  elseif (!oriz eq 'U' or !oriz eq 'D' or !oriz eq 'Z' or !oriz eq '-Z') then
    !newposn  = !fposplit[1] & !fposplit[2] & ' ' & !fposplit[3] & !fposplit[4] & ' ' & !sposplit[5] & !newelevn
    pin1 at $!newposn wrt world

    if (!supportype eq 'FT18') then
      pin1 by $!p10Dir -60
    endif

    pin2 copy pin1
  else
    pin2 copy pin1
    pin1 move pin1 along $!braceOpt wrt world dist -$!this.textb.val
    if (!selectc eq 'Outside Frame') then
      if (!!kdirequaldir(!direction)) then
        pin2 move pin2 along $!p10Dir wrt world dist $!this.texta.val
      else
        pin2 move pin2 along $!p11Dir wrt world dist $!this.texta.val
      endif
    elseif (!selectc eq 'Inside Frame') then
      if (!!kdirequaldir(!direction)) then
        pin2 move pin2 along $!p11Dir wrt world dist $!this.texta.val
      else
        pin2 move pin2 along $!p10Dir wrt world dist $!this.texta.val
      endif
    elseif (!selectc eq 'Behind Frame') then
      pin2 move pin2 along $!p2Dir wrt world dist $!this.texta.val
    elseif (!selectc eq 'Infront Frame') then
      pin2 move pin2 along $!p2DirOpp wrt world dist $!this.texta.val
    endif
  endif

  -- Position pin2 by alignment with structure where structure identified
  -- otherwise plane along to support point at brace angle.

  if (!dimrefstrut eq TRUE) then
    pin2 move pin2 $!pin1Dir wrt world through $!structname
    !param      = para of $!sctnreqd
    if (!this.selecta.rtext[!this.selecta.val] eq 'FB01') then
      !midprojlen = ($!param[1] / (2 * Cos($!this.textc.val)))
      if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
        pin2 move pin2 $!pin1DirOpp dist $!midprojlen mm
      else
        pin2 move pin2 $!pin1Dir wrt world dist $!midprojlen mm
      endif
      pin2 dir $!bracedirn
    endif
    pos $!strupos
    if !padExists then
      !ce = !!ce
      $!padName
      rule exe all
      !!ce = !ce
    endif
    if (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      !midprojlen = ($!param[1] / (2 * Sin($!this.textc.val)))
      pin2 move pin2 $!bracedirn through ppline NA of $!structname
      if (!relstrupos[1].string() eq 'above') then
        pin2 by $!braceDir $!midprojlen mm
      else
        pin2 by $!braceOpt $!midprojlen mm
      endif
      pin1 move pin1 $!bracedirn through pin2

      pin2 dir $!pin1DirOpp
      if (!selectc eq 'Outside Frame') then
        if (!p9Dir eq 'D' or !memtype eq 'BEAM' and !memdirn.direction() eq !p2Dirn) then
          pin2 move pin2 $!pin1DirOpp dist $!this.textd.val
        elseif (!p10Dir eq 'D' or !p10Dir eq '-Z') then
          pin2 move pin2 $!pin1DirOpp dist -$!this.textd.val
        else
          pin2 move pin2 $!pin1DirOpp dist $!this.textd.val
        endif
      else
        pin2 move pin2 $!pin1DirOpp dist $!this.textd.val
      endif
      pin2 dir $!bracedirn
    endif
    !distanceL   = !!kStrReal('const dist pin1 to pin2')
    !distanceH   = ($!distanceL / tan($!this.textc.val))
    pin1 by $!braceOpt $!distanceH
    pos $!strupos
    if !padExists then
      !ce = !!ce
      $!padName
      rule exe all
      !!ce = !ce
    endif
    !this.texta.val = $!distanceL
    !this.textb.val = $!distanceH

  else

    if (!selectc eq 'Under Cantilever' or !selectc eq 'Behind Cantilever' or !selectc eq 'Infront Cantilever') then
      pin2 dir $!pin3dir
    else
      pin2 dir $!braceOpp
    endif
    !braceangle = (90 - $!this.textc.val)
    if (!selectc eq 'Outside Frame') then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        pin2 move pin2 along $!p9Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
      else
        if (!!kdirequaldir(!direction)) then
          pin2 move pin2 along $!p10Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
        else
          pin2 move pin2 along $!p11Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
        endif
      endif
    elseif (!selectc eq 'Inside Frame') then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        pin2 move pin2 along $!p9DirOpp $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
      else
        if (!!kdirequaldir(!direction)) then
          pin2 move pin2 along $!p11Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
        else
          pin2 move pin2 along $!p10Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
        endif
      endif
    elseif (!selectc eq 'Behind Frame') then
      if (!supportype inset ('FT42','FT56')) then
        pin2 move pin2 along $!p9DirOpp $!braceangle $!bracedirn plane $!bracedirn through $!sposplit[5] $!sposplit[6] wrt world
      else
        pin2 move pin2 along $!p2Dir $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
      endif
    elseif (!selectc eq 'Infront Frame') then
      if (!supportype inset ('FT42','FT56')) then
        pin2 move pin2 along $!p9Dir $!braceangle $!bracedirn plane $!bracedirn through $!sposplit[5] $!sposplit[6] wrt world
      else
        pin2 move pin2 along $!p2DirOpp $!braceangle $!bracedirn plane $!braceDir through $!sposplit[5] $!sposplit[6] wrt world
      endif
    endif
  endif
  pos $!strupos
  if !padExists then
    !ce = !!ce
    $!padName
    rule exe all
    !!ce = !ce
  endif

  var !startpin pin1 pos
  var !endpin   pin2 pos

  pin1 dir tow pin2
  var !braceori pin1 dir

  --<dw>mar2009 DFN P-17331 DAC control added.
  !!mdsDacControl(TRUE)

  -- Create new brace sctn
  if (!this.brname.background eq 5) then
    last sctn
    new sctn /$!this.brname.val
    copy $!sctnreqd
    :MDSconn $!structname
    handle(41,52)
    endhandle
  else
    /$!this.brname.val
    copy $!sctnreqd
    :MDSconn $!structname
    handle(41,52)
    endhandle
  endif

  -- Identify start/end points, cut planes and angle interface with mating angle section.
  if (!selectc eq 'Outside Frame') then
    if (!!kdirequaldir(!direction)) then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        poss $!endpin pose $!startpin
        drns $!p10Dirn
        if (!memtype eq 'ANG') then
          extend end $!mempara[1] mm
        endif
      else
        poss $!startpin pose $!endpin
        if (!supportype inset ('FT42','FT56')) then
          drns $!p10Dir
          drne $!p2Dir
        else
          drne $!p9Dirn
        endif
        if (!memtype eq 'ANG') then
          extend start $!mempara[1] mm
        endif
      endif
      purp EQUA
    else
      poss $!endpin pose $!startpin
      if (!supportype inset ('FT42','FT56')) then
        drns $!p2Dirn
      else
        drns $!p9Dirn
      endif
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        drns $!p10Dirn
      endif
      if (!memtype eq 'ANG') then
        extend end $!mempara[1] mm
      endif
      purp NEQA
    endif
    if (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      drns $!pin1DirOpp
      drne $!pin1Dir wrt world
      !purp = purp
    endif
  elseif (!selectc eq 'Inside Frame') then
    if (!!kdirequaldir(!direction)) then
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        poss $!startpin pose $!endpin
        drne $!p10Dirn
      else
        poss $!endpin pose $!startpin
        drns $!p9Dirn
      endif
      purp EQUA
    else
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        poss $!startpin pose $!endpin
        drne $!p10Dirn
      else
        poss $!startpin pose $!endpin
        drne $!p9Dirn
      endif
      purp NEQA
    endif
  elseif (!selectc eq 'Behind Frame') then
    if (!!kdirequaldir(!direction)) then
      poss $!startpin pose $!endpin
      drns $!p2Dir wrt world
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        drne $!p10Dirn
      elseif (!supportype inset ('FT42','FT56')) then
        drne $!p2Dirn
        drns $!p9Dirn
      else
        drne $!p9Dirn
      endif
      if (!memtype eq 'ANG') then
        if (!oriz eq 'U' and $!bang neq 0 or !oriz eq 'Z' and $!bang neq 0) then
          extend start $!mempara[1] mm
        elseif (!oriz eq 'D' and $!bang eq 0 or !oriz eq '-Z' and $!bang neq 0) then
          extend start $!mempara[1] mm
        endif
      endif
      purp EQUA
    else
      poss $!endpin pose $!startpin
      drne $!p2Dir wrt world
      drns $!p9Dirn
      if (!supportype inset ('FT42','FT56')) then
        drns $!p2Dirn
        drne $!p9Dirn
      endif
      if (!memtype eq 'ANG') then
        extend end $!mempara[1] mm
      endif
      purp NEQA
    endif
    if (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      drns $!pin1DirOpp
      drne $!pin1Dir wrt world
      !purp = purp
    endif
  elseif (!selectc eq 'Infront Frame') then
    if (!!kdirequaldir(!direction)) then
      poss $!endpin pose $!startpin
      drne $!p2DirOpp wrt world
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        drns $!p10Dirn
      elseif (!supportype inset ('FT42','FT56')) then
        drns $!p2Dirn
        drne $!p9Dirn
      else
        drns $!p9Dirn
      endif
      if (!memtype eq 'ANG') then
        if (!oriz eq 'U' or !oriz eq 'Z') then
          if ($!bang eq 0) then
            extend end $!mempara[1] mm
          endif
        endif
      endif
      purp EQUA
    else
      poss $!startpin pose $!endpin
      drns $!p2DirOpp wrt world
      drne $!p9Dirn
      if (!supportype inset ('FT42','FT56')) then
        drne $!p2Dirn
        drns $!p9Dirn
      endif
      purp NEQA
    endif
    if (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      drns $!pin1DirOpp
      drne $!pin1Dir wrt world
      !purp = purp
    endif
  elseif (!selectc eq 'Under Cantilever') then
    poss $!startpin pose $!endpin
    if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
      drns $!p10Dirn
    elseif (!supportype eq 'FT34B') then
      drns $!p2Dirn
    else
      drns $!p9Dirn
    endif
    drne $!pin3Dir wrt world
    if (!memtype eq 'ANG') then
      if ($!bang eq 0 and !supportype neq 'FT34B') then
        flip
        extend end $!mempara[1] mm
      else
        extend start $!mempara[1] mm
      endif
    endif
    purp EQUA
    !horizontal = TRUE
  elseif (!selectc eq 'Infront Cantilever') then
    poss $!startpin pose $!endpin
    if (!supportype eq 'FT34B') then
      drns $!p9Dirn
    else
      drns $!p2Dirn
    endif
    drne $!pin3Dir wrt world
    if (!memtype eq 'ANG') then
      if ($!bang neq 0 or !supportype eq 'FT34B') then
        extend start $!mempara[1] mm
      endif
    endif
    purp EQUA
    !horizontal = TRUE
  elseif (!selectc eq 'Behind Cantilever') then
    poss $!startpin pose $!endpin
    if (!supportype eq 'FT34B') then
      drns $!p9Dirn
    else
      drns $!p2Dirn
    endif
    drne $!pin3Dir wrt world
    if (!memtype eq 'ANG') then
      if ($!bang eq 0 and !supportype neq 'FT34B') then
        extend start $!mempara[1] mm
      endif
    endif
    purp EQUA
    !horizontal = TRUE
  endif

  -- Align brace sctn with frame sctn

  !type     = !!ce.catref.gtype
  !offsetpara = para[1]
  !bracpara   = para[2]
  !mempara    = para of catr of $!membername
  if (!relstrupos[1].string() eq 'below' and !horizontal eq FALSE) then
    if (!type eq 'ANG') then
      jusline toay
    elseif (!type eq 'BSC') then
      jusline ltoc
    endif
  elseif (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
    if (!type eq 'ANG') then
      by d ($!offsetpara / sin($!this.textc.val) mm)
    elseif (!type eq 'BSC') then
      by d ($!offsetpara / sin($!this.textc.val) mm)
    endif
  endif
  if (!oriz eq 'U' or !oriz eq 'Z') then
  elseif (!oriz eq 'D' or !oriz eq '-Z') then
    if (!type eq 'ANG') then
      bang 90
      flip
    endif
    pin2 dir $!p9Dirn
  else
    if (!type eq 'ANG' or !type eq 'BSC') then
      if (!selectc eq 'Behind Frame' or !selectc eq 'Infront Frame') then
        flip
      endif
    endif
  endif

  if (!supportype eq 'FT18') then
    $!membername
    by $!p10Dir -60 mm
    same
  endif

  !param = para of catr
  if (!selectc eq 'Inside Frame') then
    if (!memtype eq 'ANG') then
      flip
      if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
        move along $!p2DirOpp wrt world dist $!param[5] mm
      elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
        move along $!p2Dir wrt world dist $!param[5] mm
      else
        move along $!p2DirOpp wrt world dist $!param[5] mm
      endif
    elseif (!memtype eq 'BSC' or !memtype eq 'DINU') then
      flip
      move along $!p2DirOpp wrt world dist $!param[5] mm
    else
      move along $!p2Dir wrt world clear0 inf pin1
      by $!p2Dir ($!bracpara / 2) mm wrt world
    endif

  elseif (!selectc eq 'Outside Frame') then
    if (!memtype eq 'ANG') then
      if (!supportype inset ('FT42','FT56')) then
      else
        flip
      endif
    elseif (!memtype eq 'BSC' or !memtype eq 'DINU') then
      flip
      if (!supportype inset ('FT42','FT56')) then
        move along $!p9DirOpp wrt world dist $!param[5] mm
      else
        move along $!p2DirOpp wrt world dist $!param[5] mm
      endif
    else
      move along $!p2Dir wrt world clear0 inf pin1
      by $!p2Dir ($!bracpara / 2) mm wrt world
    endif

  elseif (!selectc eq 'Behind Frame') then
    if (!memtype eq 'ANG') then
      if (!supportype inset ('FT42','FT56')) then
        flip
      endif
      if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
        flip
      endif
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        move along $!p9DirOpp wrt world dist $!param[5] mm
      else
        move along $!pin3Dir wrt world dist $!param[5] mm
      endif
    else
      move along $!pin3Dir wrt world clear0 inf pin1
      move along $!pin3Dir wrt world dist ($!bracpara / 2) mm
    endif

  elseif (!selectc eq 'Infront Frame') then
    if (!memtype eq 'ANG') then
      if (!supportype inset ('FT42','FT56')) then
        flip
      endif
      if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
        flip
      endif
      if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
        move along $!p9DirOpp wrt world dist $!param[5] mm
      else
        move along $!pin3Dir wrt world dist $!param[5] mm
      endif
    else
      move along $!pin3Dir wrt world clear0 inf pin1
      move along $!pin3Dir wrt world dist ($!bracpara / 2) mm
    endif

  elseif (!selectc eq 'Under Cantilever') then
    if (!memtype eq 'ANG') then
    elseif (!memtype eq 'BSC' or !memtype eq 'DINU') then
      move along $!p2Dir wrt world dist $!param[5] mm
    else
      move along $!p2Dir wrt world clear0 inf pin1
      by $!p2Dir ($!bracpara / 2) mm wrt world
    endif

  elseif (!selectc eq 'Infront Cantilever') then
    if (!type eq 'ANG') then
      jusline rtta
    elseif (!type eq 'BSC') then
      jusline rtoc
    endif
    !bracpara = para[1]
    if (!p10Dir eq 'U' or !p10Dir eq 'Z') then
      if (!memtype eq 'ANG') then
        by $!p10Dir $!param[5] mm
      else
        by $!p10Dir ($!bracpara / 2) mm
      endif
    elseif (!p11Dir eq 'U' or !p11Dir eq 'Z') then
      if (!memtype eq 'ANG') then
        by $!p11Dir $!param[5] mm
      else
        by $!p11Dir ($!bracpara / 2) mm
      endif
    elseif (!supportype eq 'FT34B') then
      if (!memtype eq 'ANG') then
        by $!p2DirOpp $!param[5] mm
      else
        by $!p2DirOpp ($!bracpara / 2) mm
      endif
    else
      if (!memtype eq 'ANG') then
        by $!p9DirOpp $!param[5] mm
      else
        by $!p9DirOpp ($!bracpara / 2) mm
      endif
    endif

  elseif (!selectc eq 'Behind Cantilever') then
    flip
    if (!type eq 'ANG') then
      jusline rtta
    elseif (!type eq 'BSC') then
      jusline rtoc
    endif
    !bracpara = para[1]
    if (!p10Dir eq 'U' or !p10Dir eq 'Z') then
      if (!memtype eq 'ANG') then
        by $!p10Dir $!param[5] mm
      else
        by $!p10Dir ($!bracpara / 2) mm
      endif
    elseif (!p11Dir eq 'U' or !p11Dir eq 'Z') then
      if (!memtype eq 'ANG') then
        by $!p11Dir $!param[5] mm
      else
        by $!p11Dir ($!bracpara / 2) mm
      endif
    elseif (!supportype eq 'FT34B') then
      if (!memtype eq 'ANG') then
        by $!p2DirOpp $!param[5] mm
      else
        by $!p2DirOpp ($!bracpara / 2) mm
      endif
    else
      if (!memtype eq 'ANG') then
        by $!p9DirOpp $!param[5] mm
      else
        by $!p9DirOpp ($!bracpara / 2) mm
      endif
    endif
  endif

  -- Save bracing code references

  !bracetype = 0
  if (!this.selecta.rtext[!this.selecta.val] eq 'FB01') then
    if (!selectc eq 'Under Cantilever') then
      !bracetype = 6
    elseif (!selectc eq 'Behind Cantilever' or !selectc eq 'Infront Cantilever') then
      !bracetype = 5
    elseif (!selectc eq 'Inside Frame' or !selectc eq 'Outside Frame') then
      if (!relstrupos[1].string() eq 'above') then
        !bracetype = 4
      else
        !bracetype = 1
      endif
    elseif (!selectc eq 'Behind Frame' or !selectc eq 'Infront Frame') then
      if (!relstrupos[1].string() eq 'above') then
        !bracetype = 3
      else
        !bracetype = 2
      endif
    endif
  elseif (!this.selecta.rtext[!this.selecta.val] eq 'FB02') then
    if (!selectc eq 'Inside Frame' or !selectc eq 'Outside Frame') then
      if (!relstrupos[1].string() eq 'above') then
        !bracetype = 9
      else
        !bracetype = 7
      endif
    elseif (!selectc eq 'Behind Frame' or !selectc eq 'Infront Frame') then
      if (!relstrupos[1].string() eq 'above') then
        !bracetype = 10
      else
        !bracetype = 8
      endif
    endif
  endif

  !matlcode = 'xx'
  if (!this.selectb.val eq 1) then
    !matlcode = 'A'
  elseif (!this.selectb.val eq 2) then
    !matlcode = 'B'
  elseif (!this.selectb.val eq 3) then
    !matlcode = 'C'
  endif

  !desp     = despara
  !splitori = !braceori.split()
  if (!splitori.size() eq 3) then
    !braceori = !splitori[1] & !splitori[2].real().nint() & !splitori[3]
  elseif (!splitori.size() eq 5) then
    !braceori = !splitori[1] & !splitori[2].real().nint() & !splitori[3] & !splitori[4].real().nint() & !splitori[5]
  endif
  desp $!desp[1] $!desp[2] $!desp[3] $!desp[4] $!this.textb.val $!this.texta.val $!this.textc.val $!bracetype $!matlcode  $!this.textd.val
  func '$!braceori'
  desc '$!selectc'

  -- ------------------------
  -- Max H dim.  = $!desp[1]
  -- Max L dim.  = $!desp[2]
  -- Min Angle   = $!desp[3]
  -- Max Angle   = $!desp[4]
  -- Brace Type  = $!bracetype
  -- H dimension = $!this.textb.val
  -- L dimension = $!this.texta.val
  -- Angle       = $!this.textc.val
  -- Matl. code  = $!matlcode
  -- Orientation = $!braceori
  -- ------------------------

  if ($!this.texta.val gt $!desp[2]) then
    !!alert.error('Bracing $!this.brname.val exceeds maximum length')
    return
  elseif ($!this.textb.val gt $!desp[1]) then
    !!alert.error('Bracing $!this.brname.val exceeds maximum length')
    return
  endif

  if ($!this.textc.val lt $!desp[3] or $!this.textc.val gt $!desp[4]) then
    !!alert.error('Bracing angle $!this.textc.val for $!this.brname.val is outside allowable range')
    return
  endif

  --<dwjan2008 Addition for Oglaend
  !specrefn = !!ce.spre.owner.owner.fullname.after('/')
  if (!specrefn eq 'OGLAEND') then
    !bracestart = !!ce.poss
    !braceend   = !!ce.pose
    !memberpart = !membername.substring(-3)
    if (!membername.after(!memberpart) eq 'V1') then
      poss $!braceend
      pose $!bracestart
    endif
    extend start -75
    extend end -100
    !sctnderlen = derlen
    !bracename  = !!ce.fullname
    !snodname   = !bracename & '-S1'
    fitt2
    zdist $!sctnderlen
    !bracdir    = p3 dir
    !fittname   = !!ce.fullname
    $!structname
    new snod $!snodname
    zdist thro p5 of $!fittname
    new sjoi
    spre  /OGLAEND-Pressure_Plate/1
    posline bos
    $!bracename
    move along $!bracdir thr $!membername
  endif
  --<dwjan2008 End of addition for Oglaend

  -- Check whether brace atta required

  if (defined(!!mdsframebracing)) then
    if (!!mdsframebracing eq 'true') then
      !srefname   = '/' & !psname & '/SREF'
      !bracename  = !!ce.fullname
      !currnumb   = !bracename.after(!psname & '-BR')
      !prevnumb   = (!currnumb.real() - 1)
      !prevatta   = '/' & !psname & '/BR' & !prevnumb
      !attaname   = !bracename.replace(!psname & '-BR',!psname & '/BR')
      !attamatl   = !this.selecta.rtext[!this.selecta.val] & '-' & !this.selectb.val
      $!attaname
      handle(2,109)
        if (!currnumb.real() eq 1) then
          $!srefname
        else
          $!prevatta
          handle(2,109)
            $!srefname
          endhandle
        endif
        new atta $!attaname copy prev
      endhandle
      sel spref with styp '$!attamatl' spec /MDF
      desp $!bracetype $!this.textb.val $!this.texta.val $!matlcode
      :mdscp3 '$!braceori'
      $!bracename
    else
      !!alert.message(|NO MDS ATTAS will be generated for ANY additional frame BRACING SCTNS created|)
    endif
  endif

  --<dw>mar2009 DFN P-17331 DAC control removed.
  !!mdsDacControl(FALSE)

  !this.ce.active          = TRUE
  !this.createbycur.active = TRUE
  !this.bracing.active     = TRUE
  !this.flip.active        = TRUE
  !this.nudgebrace.active  = TRUE
  !this.delbrace.active    = TRUE
  !this.brname.background  = 1
  aid clear all

  !!mdsbracings(!this.form)

endmethod


-- Display brace configuration plots for either brace type FB01 or FB02
define method .braceplot()

  if (!this.selecta.rtext[!this.selecta.val] eq 'FB01') then
    edit !!mdsShowPlot.plot PLOT
      add /%pdmsui%\des\mds\plot/MDS-Standards-FB01-1.plt
      handle (61,251)
      endhandle
    exit
    --<dw>Nov2007 Modified to allow for correct replacement name
    var !ref ref of /MDS/STRUCTURE/DEFAULTS/FB01/GEN/CCOD
    !codeFB01 = !ref.dbref().pprop
    !!mdsShowPlot.projtype.val = 'Bracing standard = ' + $!codeFB01
    --<dw>Nov2007
  else
    edit !!mdsShowPlot.plot PLOT
      add /%pdmsui%\des\mds\plot/MDS-Standards-FB02-1.plt
      handle (61,251)
      endhandle
    exit
    --<dw>Nov2007 Modified to allow for correct replacement name
    var !ref ref of /MDS/STRUCTURE/DEFAULTS/FB02/GEN/CCOD
    !codeFB02 = !ref.dbref().pprop
    !!mdsShowPlot.projtype.val = 'Bracing standard = ' + $!codeFB02
    --<dw>Nov2007
  endif
  show !!mdsShowPlot

endmethod


-- Screen dimension current brace
define method .dimbrace()

  if (!!graphicalDim eq TRUE) then

    !bracename   = !this.brname.val
    /$!bracename
    handle any
    	return
    endhandle
    !descrip     = description
    !purp        = purpose
    !param       = para of catr
    !structname  = :MDSConn
    if (!structname.string() eq 'Unset') then
      !idtype    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
      prompt off
      prompt load escape|Identify supporting member|
      id $!idtype @
      !structname = !!ce.ref
      prompt dismiss
      prompt on
      $!bracename
    endif
    !attaname    = !!ce.fullname.before('-') + '/DATUM'
    !directions  = !!mdsremovegrad(!attaname.dbref())
    !p2Dirn      = !directions[1]
    !p2DirnOpp   = !directions[2]
    !p9Dirn      = !directions[3]
    !p9DirnOpp   = !directions[4]
    !p10Dirn     = !directions[5]
    !p11Dirn     = !directions[6]
    !p9Dir       = !p9Dirn.string().before(' WRT')
    !p9DirOpp    = !p9DirnOpp.string().before(' WRT')
    !p10Dir      = !p10Dirn.string().before(' WRT')
    !p11Dir      = !p11Dirn.string().before(' WRT')
    stru
    !supportype  = :MDSSuppType
    same

    pin3 at poss
    pin3 dir $!p9Dirn
    pin3 plane pin3 through $!attaname
    pin3 dir $!p2Dirn
    pin3 plane pin3 through $!attaname
    pin3 dir tow $!attaname
    var !pin3Dir pin3 dir
    !pin3DirOpp = !pin3Dir.direction().opposite()

    if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
      !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname,!p10Dirn,1)
    elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
      !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname,!p11Dirn,1)
    elseif (!p9Dir eq 'U' or !p9Dir eq 'Z') then
      !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname,!p9DirnOpp,1)
    elseif (!supportype inset ('FT42','FT56')) then
      !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname,!p2Dirn,1)
    else
      !relstrupos = !!mdsreltodatum(!attaname.dbref(),!structname,!p9Dirn,1)
    endif

    if (!relstrupos[1].string() eq 'above') then
      if (!supportype eq 'FT41' or !p9Dir eq 'D' or !p9Dir eq '-Z') then
        !bracedirn = !p9DirnOpp
      elseif (!supportype inset ('FT42','FT56')) then
        !bracedirn = !p2DirnOpp
      else
        !bracedirn = !p9Dirn
      endif
    else
      if (!p10Dir eq 'D' or !p10Dir eq '-Z') then
        !bracedirn = !p10Dirn
      elseif (!p11Dir eq 'D' or !p11Dir eq '-Z') then
        !bracedirn = !p11Dirn
      elseif (!supportype inset ('FT62','FT63','FT64','FT65')) then
        !bracedirn = !p9DirnOpp
      elseif (!supportype inset ('FT42','FT56')) then
        !bracedirn = !p2Dirn
      else
        !bracedirn = !p9Dirn
      endif
    endif

    /$!bracename

    if (!descrip eq 'Outside Frame') then
      if (!purp eq 'EQUA') then
        if (!relstrupos[1].string() eq 'above') then
          pin1 at poss pin2 at pose
        else
          pin1 at pose pin2 at poss
        endif
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          pin1 dir $!p9DirnOpp
        elseif (!p9Dir eq 'D' or !p9Dir eq '-Z') then
          pin1 dir $!p11Dirn
        else
          pin1 dir $!p10Dirn
        endif
      elseif (!purp eq 'NEQA') then
        if (!relstrupos[1].string() eq 'above' or !supportype inset ('FT18','FT42','FT56')) then
          pin1 at pose pin2 at poss
        else
          pin1 at poss pin2 at pose
        endif
        if (!p9Dir eq 'D' or !p9Dir eq '-Z' or !supportype inset ('FT42','FT56')) then
          pin1 dir $!p10Dirn
        else
          pin1 dir $!p11Dirn
        endif
      endif
      if (!this.selecta.rtext[!this.selecta.val] eq 'FB02' and !relstrupos[1].string() eq 'above') then
        pin1 by $!p9DirOpp ($!param[1] / Sin($!this.textc.val) mm)
      endif

    elseif (!descrip eq 'Inside Frame') then
      if (!purp eq 'EQUA') then
        if (!relstrupos[1].string() eq 'above') then
          pin1 at pose pin2 at poss
        else
          pin1 at poss pin2 at pose
        endif
        if (!p10Dir eq 'D' or !p11Dir eq 'D' or !p10Dir eq '-Z' or !p11Dir eq '-Z') then
          pin1 dir $!p9Dirn
        elseif (!p9Dir eq 'D' or !p9Dir eq '-Z') then
          pin1 dir $!p10Dirn
        else
          pin1 dir $!p11Dirn
        endif
      elseif (!purp eq 'NEQA') then
        if (!relstrupos[1].string() eq 'above' or !supportype eq 'FT18') then
          pin1 at poss pin2 at pose
        else
          pin1 at pose pin2 at poss
        endif
        if (!p9Dir eq 'D' or !p9Dir eq '-Z') then
          pin1 dir $!p11Dirn
        else
          pin1 dir $!p10Dirn
        endif
      endif

    elseif (!descrip eq 'Behind Frame') then
      if (!purp eq 'EQUA') then
        pin1 at pose pin2 at poss
      elseif (!purp eq 'NEQA') then
        pin1 at poss pin2 at pose
      endif
      if (!supportype inset ('FT42','FT56')) then
        pin1 dir $!p9Dir
      else
        pin1 dir $!p2DirnOpp
      endif
      if (!this.selecta.rtext[!this.selecta.val] eq 'FB02' and !relstrupos[1].string() eq 'above') then
        pin1 by $!p9DirOpp ($!param[1] / Sin($!this.textc.val) mm)
      endif

    elseif (!descrip eq 'Infront Frame') then
      if (!purp eq 'EQUA') then
        pin1 at poss pin2 at pose
      elseif (!purp eq 'NEQA') then
        pin1 at pose pin2 at poss
      endif
      if (!supportype inset ('FT42','FT56')) then
        pin1 dir $!p9DirOpp
      else
        pin1 dir $!p2Dirn
      endif
      if (!this.selecta.rtext[!this.selecta.val] eq 'FB02' and !relstrupos[1].string() eq 'above') then
        pin1 by $!p9DirOpp ($!param[1] / Sin($!this.textc.val) mm)
      endif

    elseif (!descrip eq 'Under Cantilever') then
      pin1 at poss pin2 at pose
      pin1 dir $!p9Dirn

    elseif (!descrip eq 'Infront Cantilever') then
      pin1 at poss pin2 at pose
      pin1 dir $!p2DirnOpp

    elseif (!descrip eq 'Behind Cantilever') then
      pin1 at pose pin2 at poss
      pin1 dir $!p2Dirn
    endif

    if (!descrip eq 'Under Cantilever' or !descrip eq 'Infront Cantilever' or !descrip eq 'Behind Cantilever') then
      pin2 dir $!pin3Dir
    else
      pin2 dir $!bracedirn
    endif

    var !pin1pos  pin1 pos wrt world
    var !pin2pos  pin2 pos wrt world
    var !pin1Dir  pin1 dir
    var !pin2dir  pin2 dir
    !pin1posn    = !pin1pos.position()
    !pin2posn    = !pin2pos.position()
    !pin1Dirn    = !pin1Dir.direction()
    !pin2Dirn    = !pin2Dir.direction()
    !pin1dirnOpp = !pin1Dirn.opposite()
    !pin2dirnOpp = !pin2Dirn.opposite()

    !origin = object POINTVECTOR()
    !origin.position  = !pin1posn
    if (!p9Dir eq 'U' or !p9Dir eq 'Z') then
      !origin.direction = !pin1dirnOpp
    else
      !origin.direction = !pin1Dirn
    endif

    -- Dimension L start
    !line1 = !origin.line(0.1)
    !dimls = object POINTVECTOR()
    !dimls.position  = !line1.endposition
    if (!p9Dir eq 'U' and !this.selecta.rtext[!this.selecta.val] eq 'FB02' or !p9Dir eq 'Z' and !this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      !dimls.direction = !pin2Dirn
    else
      !dimls.direction = !pin2DirnOpp
    endif

    -- Dimension L end
    !line2 = !origin.line(!this.texta.val)
    !dimle = object POINTVECTOR()
    !dimle.position  = !line2.endposition
    if (!p9Dir eq 'U' and !this.selecta.rtext[!this.selecta.val] eq 'FB02' or !p9Dir eq 'Z' and !this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      !dimle.direction = !pin2Dirn
    else
      !dimle.direction = !pin2DirnOpp
    endif

    -- Dimension H start
    !dimhs = object POINTVECTOR()
    !dimhs.position  = !line1.endposition
    if (!p9Dir eq 'U' or !p9Dir eq 'Z') then
      !dimhs.direction = !pin1dirnOpp
    else
      !dimhs.direction = !pin1Dirn
    endif

    -- Dimension H end
    !constt = !dimhs
    if (!p9Dir eq 'U' and !this.selecta.rtext[!this.selecta.val] eq 'FB02' or !p9Dir eq 'Z' and !this.selecta.rtext[!this.selecta.val] eq 'FB02') then
      !constt.direction = !pin2Dirn
    else
      !constt.direction = !pin2DirnOpp
    endif
    !line2 = !constt.line(!this.textb.val)
    !dimhe = object POINTVECTOR()
    !dimhe.position  = !line2.endposition
    !dimhe.direction = !origin.direction

    !dimltext = |Dim L (| + !this.texta.val.string(!!distancefmt) + |)|
    !!mdsdimline(!dimls,!dimle,25mm,1200mm,!dimltext,200,.5mm)

    !dimatext = |Ang (| + !this.textc.val.string() + |)|
    !!mdsdimline(!dimls,!dimle,25mm,1050mm,!dimatext,200,.5mm)

    !dimhtext = |Dim H (| + !this.textb.val.string(!!distancefmt) + |)|
    !!mdsdimline(!dimhs,!dimhe,25mm,900mm,!dimhtext,200,.5mm)

    !!graphicalDim = FALSE
  else
    aid clear all
    !!graphicalDim = TRUE
  endif

endmethod


-- Cancel form and delete global variables
define method .cancel()

  !psname  = !this.form.support.stru.name
  $!psname
  Kill !!mdsaddbracing
  !!mdsresetpins(1,9)
  aid clear all

endmethod
