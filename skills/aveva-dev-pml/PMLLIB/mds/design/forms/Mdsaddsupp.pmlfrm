--
-- File:		Mdsaddsupp.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:
-- Form Definition for adding a support to the drawlist
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsAddSupp

-- Define Form
Setup Form  !!MdsAddSupp

  !!MdsAddSupp.formtitle    = |Add Support to Drawlist|
  !!MdsAddSupp.icontitle    = |Add Support|
  !!MdsAddSupp.callback     = |call !!MdsIAddSupp()|
  !!MdsAddSupp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

  frame .Option |Add Options| at x0 ymax
    button .CE     | CE |      at x0.5 y1   Call |Call !!MdsAddSelect('CE')|
    text .Name |Support Name | at xmax+1.0 ymin Call |Call !!MdsAddSelect('NAME')| width 20 name

    path down
    halign right
--xxx    button .Cursor | Identify By Cursor | Call |Call !!MdsAddSelect('CURSOR')|
--xxx    button .CE     | CE | at x0.5 Ymin Call |Call !!MdsAddSelect('CE')|
  exit

  -- Bottom Line
    button .Ok     | Apply | at x0 ymax+0.5         Call |Call !!MdsMaddSupp(!!MdsAddSupp.Name)|
    button .Cancel | Dismiss | at xmax form-size ymin cancel

-- End form definition
exit

-- End of file Mdsaddsupp.frm
