--
-- File:		Mdsalign.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 28th September 1998
--
--
-- Description:
-- Form Definition for Framework 'Alignment' ICON Button
--
--------------------------------------------------------------------------------

-- Delete existing form definition
  kill !!Mdsalign

-- Define Form
  Setup Form  !!Mdsalign at xr0 yr0

    !!Mdsalign.formtitle    = |Align Support|
    !!Mdsalign.icontitle    = ||
    !!Mdsalign.callback     = ||
    !!Mdsalign.formrevision = | $Revision: 1.1.19.1 $ |

-- Support Name Data at top of Form
--    para .tag text |Support Name:|
    frame .fname |Support Name| at x0 ymin width 36

      para .name at x0.75 ymax width 35 lines 1

    exit

-- Alignment
    frame .fAlign |Align Elements| at x0 ymax+0.25 width 35

      textpane   .pick1 |Align Support | at x1.25 ymax  width 33 height 3
      textpane   .pick2 |With  | at x1.25 ymax-0.5  width 33 height 3

    exit

-- Bottom Line
    button .cancel  | Cancel | at xmax form-size ymax+0.25 call |call !!kactioncommands(!!Mdsalign.dismissform)| cancel
    button .ok      |   OK   |   at x0.15 ymin call |call !!kactioncommands (!!Mdsalign.applyform)| ok


-- End of form definition


-- Form Members.
----------------

-- Array Member .'applyform'
    member .applyform is ARRAY

-- Array Member .'dismissform'
    member .dismissform is ARRAY

-- Action on 'OK' button
    !!Mdsalign.applyform[1] = ||
    !!Mdsalign.applyform[2] = |!!kgphalign.close()|
    !!Mdsalign.applyform[5] = |!!currentalignform.delete()|

-- Action on 'CANCEL' button
    !!Mdsalign.dismissform[1] = |!!kgphalign.close()|
    !!Mdsalign.dismissform[2] = |!!Mdsalign.hide()|
    !!Mdsalign.dismissform[3] = |!!currentalignform.delete()|

  exit

-- End of file Mdsalign.frm
