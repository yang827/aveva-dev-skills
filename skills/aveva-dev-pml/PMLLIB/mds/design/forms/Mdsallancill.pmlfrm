--
-- File:		Mdsallancill.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Tue Oct 28th 1997
--
--
-- Description:
-- Form Definition for selecting ALL ancillary items found in dimensions default file
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsAllAncill

-- Define Form
Setup Form  !!MdsAllAncill

  !!MdsAllAncill.formtitle    = |Ancillary Selection - Non user form...|
  !!MdsAllAncill.icontitle    = ||
  !!MdsAllAncill.callback     = ||
  !!MdsAllAncill.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
  list .Standard |All Types:                                 | at x1 y0.5 width 60 length 18

  path down
  vdist 1

-- Bottom Line
  button .Cancel | Dismiss | at xmax form-8 ok

-- Members
  member .Sizes is ARRAY

--<wd>01nov2006<mds12>
-- Form Loading Members etc..
  member .error is BOOLEAN
  member .emess is STRING
--<wd>01nov2006<mds12>

-- End form definition
exit

--<wd>01nov2006<mds12>
-- Set the DEFAULT settings for the form Members
  !this.error = TRUE
  !this.emess = 'No MDS Ancillaries available.'
--<wd>01nov2006<mds12>

-- End of file Mdsancill.frm
