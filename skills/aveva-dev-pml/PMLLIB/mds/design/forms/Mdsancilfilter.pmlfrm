--
-- File:  Mdsancilfilter.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--   Keyword: MDS
--   Module:  Design
--   Replaces:
--
-- Author:  D.fLANNERY
-- Created:  16th June 05
--
-- Description:
-- Form Definition for filtering ancillary components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  default()                        -
--  init()                           -
--  none()                           -
--  setFilterText()                  -
--  setNone()                        -
--

-- Kill existing form definition
kill !!mdsAncilFilter

-- Define Form
setup form  !!mdsAncilFilter

  !!mdsAncilFilter.formtitle    = |Ancillary Filter|
  !!mdsAncilFilter.icontitle    = ||
  !!mdsAncilFilter.callback     = ||
  !!mdsAncilFilter.initcall     = |!this.init()|


  -- Body of Form
  -- <sk> Load optional selection criteria
  !!mdsselectioncriteria = object MDSSELECTIONCRITERIA()

  -- <kk> toggles names are getting from custom criteria forms
  !cusCritNames = !!mdsselectioncriteria.description
  !notSetMessage = |own criteria not defined|

  path down
  vdist .5

  frame .filterby 'Filter by '
    toggle .mat  ' Material Code   '  call |!this.setNone()| states 'TRUE' 'FALSE'
    toggle .insu ' Insulation      '  call |!this.setNone()| states 'TRUE' 'FALSE'
    toggle .temp ' Temperature     '  call |!this.setNone()| states 'TRUE' 'FALSE'
    toggle .elev ' Elevation       '  call |!this.setNone()| states 'TRUE' 'FALSE'


    if !cusCritNames[1].empty().not() then
      toggle .cuscrit1 '$!cusCritNames[1] & (own)'  call |!this.setNone()| states 'TRUE' 'FALSE'
    else
      toggle .cuscrit1 '$!notSetMessage'
    endif
    if !cusCritNames[2].empty().not()  then
      toggle .cuscrit2 '$!cusCritNames[2] & (own)'  call |!this.setNone()| states 'TRUE' 'FALSE'
    else
      toggle .cuscrit2 '$!notSetMessage'
    endif
    if !cusCritNames[3].empty().not()  then
      toggle .cuscrit3 '$!cusCritNames[3] & (own)'  call |!this.setNone()| states 'TRUE' 'FALSE'
    else
      toggle .cuscrit3 '$!notSetMessage'
    endif
    if !cusCritNames[4].empty().not()  then
      toggle .cuscrit4 '$!cusCritNames[4] & (own)'  call |!this.setNone()| states 'TRUE' 'FALSE'
    else
      toggle .cuscrit4 '$!notSetMessage'
    endif
    if !cusCritNames[5].empty().not()  then
      toggle .cuscrit5 '$!cusCritNames[5] & (own)'  call |!this.setNone()| states 'TRUE' 'FALSE'
    else
      toggle .cuscrit5 '$!notSetMessage'
    endif
    toggle .none ' None            '  call |!this.none()| states 'TRUE' 'FALSE'
  exit


  -- Bottom Line
  button .apply  |  OK  | Call |!this.apply()| at xmin ymax+.5 OK

  path right

  button .cancel  | Cancel | at xmax form-size ymin CANCEL

  -- Members

  member .mode is STRING

  -- Save filter text for main form

  member .filterText is STRING

  -- Default values to true
  !this.mat.val  = TRUE
  !this.insu.val = TRUE
  !this.temp.val = TRUE
  !this.elev.val = TRUE

  !this.cuscrit1.val = FALSE
  !this.cuscrit2.val = FALSE
  !this.cuscrit3.val = FALSE
  !this.cuscrit4.val = FALSE
  !this.cuscrit5.val = FALSE
  !this.none.val = FALSE

  -- <kk> Set default criteria toggle to inactive
  !this.cuscrit1.active = FALSE
  !this.cuscrit2.active = FALSE
  !this.cuscrit3.active = FALSE
  !this.cuscrit4.active = FALSE
  !this.cuscrit5.active = FALSE

  !whichCCActive = !!mdsselectioncriteria.active
  handle ANY

  elsehandle NONE
    if !whichCCActive[1] then
      !this.cuscrit1.active = TRUE
      !this.cuscrit1.val = TRUE
    endif
    if !whichCCActive[2] then
      !this.cuscrit2.active = TRUE
      !this.cuscrit2.val = TRUE
    endif
    if !whichCCActive[3] then
      !this.cuscrit3.active = TRUE
      !this.cuscrit3.val = TRUE
    endif
    if !whichCCActive[4] then
      !this.cuscrit4.active = TRUE
      !this.cuscrit4.val = TRUE
    endif
    if !whichCCActive[5] then
      !this.cuscrit5.active = TRUE
      !this.cuscrit5.val = TRUE
    endif
  endhandle

exit

define method .init()

  -- Set toggles to default values

  !this.default()

  -- Save filter text

  !this.setFilterText()

endmethod


define method .default()

  !this.mat.val  = TRUE
  !this.insu.val = TRUE
  !this.temp.val = TRUE
  !this.elev.val = TRUE
  !this.none.val = FALSE

  !this.cuscrit1.val = FALSE
  !this.cuscrit2.val = FALSE
  !this.cuscrit3.val = FALSE
  !this.cuscrit4.val = FALSE
  !this.cuscrit5.val = FALSE

  -- <kk> set to active if criteria is defined

  !whichCCActive = !!mdsselectioncriteria.active

  if !whichCCActive[1] then
    !this.cuscrit1.active = TRUE
    !this.cuscrit1.val = TRUE
  endif
  if !whichCCActive[2] then
    !this.cuscrit2.active = TRUE
    !this.cuscrit2.val = TRUE
  endif
  if !whichCCActive[3] then
    !this.cuscrit3.active = TRUE
    !this.cuscrit3.val = TRUE
  endif
  if !whichCCActive[4] then
    !this.cuscrit4.active = TRUE
    !this.cuscrit4.val = TRUE
  endif
  if !whichCCActive[5] then
    !this.cuscrit5.active = TRUE
    !this.cuscrit5.val = TRUE
  endif
  -- turn off custom criteria by default - inaccurate results on DESPAR can occur
  -- ( /MDS/ATTA/DEFAULTS not applied while filtering )

endmethod

define method .none()

  !this.mat.val  = FALSE
  !this.insu.val = FALSE
  !this.temp.val = FALSE
  !this.elev.val = FALSE
  !this.cuscrit1.val  = FALSE
  !this.cuscrit2.val  = FALSE
  !this.cuscrit3.val  = FALSE
  !this.cuscrit4.val  = FALSE
  !this.cuscrit5.val  = FALSE
endmethod


define method .apply()

  !alias = !!mdsAncill.form.support.alias
  if !alias.unset() then
    !alias = 'SPECIAL'
  endif
  !!mdsIancill(!alias)
  !this.setFilterText()

endmethod

define method .setNone()

  if !this.mat.val  or  !this.insu.val  or !this.temp.val  or !this.elev.val or !this.cuscrit1.val or !this.cuscrit2.val or !this.cuscrit3.val or !this.cuscrit4.val or !this.cuscrit5.val then
    !this.none.val = FALSE
  endif

endmethod

define method .setFilterText()

  -- Split saved text into section

  !splitCrit = !!mdsAncill.filterText.split(',')
  !bore = !splitCrit[1]
  !material = !splitCrit[2]
  !insulation = !splitCrit[3]
  !temp = !splitCrit[4]
  !elevation = !splitCrit[5]

  -- Build up new criteria text

  !filtered = ' - Filtered By - Bore '
  !newText = !bore
  if !this.mat.val then
    !newText = !newText + ',' + !material
    !filtered = !filtered + 'Matl '
  endif
  if !this.insu.val then
    !newText = !newText + ',' + !insulation
    !filtered = !filtered + 'Insu '
  endif
  if !this.temp.val then
    !newText = !newText + ',' + !temp
    !filtered = !filtered + 'Temp '
  endif
  if !this.elev.val then
    !newText = !newText + ',' + !elevation
    !filtered = !filtered + 'Elev'
  endif
  if !this.none.val then
    !newText = !bore
    !filtered = ' - Filtered By - Bore '
  endif

  -- Modify title text to show user list is filtered

  !!mdsAncill.formtitle  = 'Ancillary Selection ' + !filtered
  !!mdsAncill.criteria.val = !newText

endmethod
