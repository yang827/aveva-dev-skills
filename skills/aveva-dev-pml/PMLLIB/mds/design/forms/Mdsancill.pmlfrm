--
-- <wd>feb2004
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       edgentry()
--
-- Description:  Performs actions BEFORE the Creation of an 'AT60' ANCILLARY on a STANDARD or a SPECIAL
--               MDS FRAMEWORK and Sets Up ANY DATA required for the 'AT60' ANCILLARY
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .edgentry()

  prompt  'Pick Back Face of FLANGE To Align Support'
  !!mdsAncill.setactive(FALSE)
  -- Define event packet
  !packet = object EDGPACKET()
  !packet.elementPick('Pick Element')

  -- Remember the element when the packet was first place in the event system
  !packet.initialisation = '!this.input[1] = !!ce'

  -- Move to the element picked
  !offset = REAL()
  !packet.action = '!!mdsAncill.returnfromedg(!this.return)'

  -- Set the close sequence, so that the user returns to the original element
  !packet.close = '!!mdsAncill.setactive(true)'

  !packet.remove = TRUE    $* set packet so that it deletes itself when it finished
  !pickpacket = object EDGPICKPACKET()
  !pickpacket.stdgraphic('pick a surface')

  -- Add the new picktype to the edgpacket currently defined
  !packet.pickpacket = !pickpacket

  -- Add event packet to the system
  !!edgCntrl.add(!packet)

endmethod

-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       returnfromedg(!input is ARRAY)
--
-- Description:  Performs actions BEFORE the Creation of an 'AT60' ANCILLARY on a STANDARD or a SPECIAL
--               MDS FRAMEWORK and Sets Up ANY DATA required for the 'AT60' ANCILLARY
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is ARRAY)

  -- This method is called when the EDG returns from a valid pick
  -- First of all check to see if the item picked was a flange
  !flan = !input[1].item
  if (!flan.type.neq('FLAN') or !input[1].tubing.eq('LEAVE')) then
    !!alert.error('You Must Identify the BACK surface of a Flange')
    !!mdsAncill.setactive(TRUE)
    return
  endif

  -- When it gets here then its found a flange an we need to validate the back surface
  prompt dismiss
  !!ce    = !flan
  !facets = !input[1].facets
  !offsetlist = ARRAY()

  !line = object LINE()
  !line.startposition = !!ce.position
  !line.endposition = !!ce.ppos[2]
  !ppoint = object POINTVECTOR()
  do !a values !facets
    !ppoint.position = !a
    !ppoint.direction = !!ce.pdir[1]
    !plane1 = !ppoint.plane()
    !offsetlist.append(!line.extendend(!plane1).length())
  enddo
  !offsetlist.sortunique()
  !offset = !offsetlist[!offsetlist.size()] + 2

  -- Set the Required Object Members
  !!mdsAncill.offset = !offset
  !!mdsAncill.flan   = !flan

  -- Reset the OK callback to its original setting
  !!mdsAncill.action      = !!mdsAncill.storeaction
  !!mdsAncill.ok.callback = '!this.apply ()'
  -- Execute and Continue the Original OK callback
  !!kActionCommands(!this.action)

endmethod
-- <wd>feb2004

-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------

define method .filter()

  if !this.filter.selection().eq('ALL') then
    !this.standard.dtext = !this.allDtext
    !this.standard.rtext = !this.allRtext
  else
    !tempDtext = !this.allDtext
    !tempRtext = !this.allRtext
    do !remove from 1 to !tempDtext.size()
      if !tempRtext[$!remove].match(!this.filter.selection().trim()).neq(1) then
        !tempRtext[$!remove].delete()
        !tempDtext[$!remove].delete()
      endif
    enddo
    !tempDtext.compress()
    !tempRtext.compress()
    !this.standard.dtext = !tempDtext
    !this.standard.rtext = !tempRtext
  endif

  -- Output number of available elements

  !numberOff = !this.standard.dtext.size()
  if !numberOff.eq(0) then
    --    !!alert.error('No available types, resetting to ALL')
    !this.filter.val = 1
    !this.standard.dtext = !this.allDtext
    !this.standard.rtext = !this.allRtext
  else
    !this.standard.tag = 'Select Type ($!numberOff)'
  endif

endmethod

-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------

define method .iconFilter(!type is STRING)

  if !type.eq('ALL') then
    !this.standard.dtext = !this.allDtext
    !this.standard.rtext = !this.allRtext
  else
    !tempDtext = !this.allDtext
    !tempRtext = !this.allRtext
    do !remove from 1 to !tempDtext.size()
      if !tempRtext[$!remove].match(!type.trim()).neq(1) then
        !tempRtext[$!remove].delete()
        !tempDtext[$!remove].delete()
      endif
    enddo
    !tempDtext.compress()
    !tempRtext.compress()
    !this.standard.dtext = !tempDtext
    !this.standard.rtext = !tempRtext
  endif

  -- Output number of available elements
  !numberOff = !this.standard.dtext.size()
  if !numberOff.eq(0) then
    if !type.eq('AN') then
      !!alert.error('No available anchors, resetting to ALL')
    elseif !type.eq('AT') then
      !!alert.error('No available ancillaries, resetting to ALL')
    elseif !type.eq('GT') then
      !!alert.error('No available guides, resetting to ALL')
    elseif !type.eq('BT') then
      !!alert.error('No available u bolts, resetting to ALL')
    elseif !type.eq('SU') then
      !!alert.error('No available slip units, resetting to ALL')
    elseif !type.eq('ST') then
      !!alert.error('No available stops, resetting to ALL')
    endif
    !this.standard.dtext = !this.allDtext
    !this.standard.rtext = !this.allRtext
    !numberOff = !this.standard.dtext.size()
    !this.standard.tag = 'Select Type ($!numberOff)'
  else
    !this.standard.tag = 'Select Type ($!numberOff)'
    if !type.eq('AN') then
      !this.standard.tag = 'Select Type (Anchors = $!numberOff)'
    elseif !type.eq('AT') then
      !this.standard.tag = 'Select Type (Ancillaries = $!numberOff)'
    elseif !type.eq('GT') then
      !this.standard.tag = 'Select Type (Guides = $!numberOff)'
    elseif !type.eq('BT') then
      !this.standard.tag = 'Select Type (U Bolts = $!numberOff)'
    elseif !type.eq('SU') then
      !this.standard.tag = 'Select Type (Slip Units = $!numberOff)'
    elseif !type.eq('ST') then
      !this.standard.tag = 'Select Type (Stops = $!numberOff)'
    endif
  endif

endmethod

define method .alignUnderValve()
  !currentunits = !!kgetsetunits()
  !pipeType = 'VALV'
  !idType = 'pipe'
  !tubeType = 'VALV'
  !purp = 'PIPE'
  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!idType',!purp).not())then
    !!kRestoreUnits(!currentunits)
    return
  endif
  var !unusedmode mode
  forwards
  !message = STRING()
  if !!ce.type.eq('VALV') then
    !valve = !!ce
    if !!ce.lcon.matchwild('W*').not() then
      !message = 'Identified component must be a wafer VALV.'
    endif
  else
    !message = 'Identified component must be a VALV.'
  endif
  if !message.unset() then
    -- check if support is not already there
    !next = next
    handle NONE
      if !next.type.eq('ATTA').and(!next.styp.eq('AT185')) then
        !message = 'Support already exists for the VALV picked.'
      endif
    elsehandle ANY
    endhandle
  endif
  if !message.unset() then
    -- check if PIPE is not vertical and within the slope tolerance
    !currcomp = !!ce
    if !!mdsgradient(!currcomp) then
      !message = 'The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)'
    endif
  endif
  if !message.set() then
    -- pick VALV again
    !!alert.error(!message)
    !!kRestoreUnits(!currentunits)
    return
  else
    -- Reset the OK callback to its original setting
    !!kRestoreUnits(!currentunits)
    -- note using the .flan member to represent a valve in this case
    !this.flan = !valve
    !!mdsAncill.action      = !!mdsAncill.storeaction
    !!mdsAncill.ok.callback = '!this.apply()'
    -- Execute and Continue the Original OK callback
    !!kActionCommands(!this.action)
  endif
endmethod
