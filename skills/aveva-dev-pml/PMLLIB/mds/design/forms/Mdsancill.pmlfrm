------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()
  !name = !this.name.val
  !unsetname = 'unset'
  if !name.set() then
    !name = !name.trim()
    if !name.empty() then
      !name = !unsetname
    else
      !name = !name.replace(' ','')
      if !name.match('/').eq(1) then
        !name = !name.after('/')
      endif
      if !name.empty() then
        !name = !unsetname
      else
        !slashname = '/' & !name
        !slashname.dbref()
        handle NONE
          !!alert.error('Name (' & !slashname & ') already exists.')
          !name = !unsetname
        elsehandle ANY
        endhandle
      endif
    endif
  else
    !name = !unsetname
  endif
  !this.name.val = !name
  !this.ok.active = !name.neq(!unsetname)
endmethod
-- End of method
define method .apply ()
  --<kp> 31/05/2012 13:53:46
  !preliminarySupp = !this.preliminarySupp
  !datumFromPreliminary = !this.form.support.preliminaryStore.set()
  if !datumFromPreliminary then
    !preliminarySupp = !this.form.support.preliminaryStore[3].dbref()
  endif

  if !preliminarySupp.badref().not() then

    !attaRefPrelimStore = !!mdsSavePreInf(!preliminarySupp)
    !this.form.support.attaRefPrelimStore.append(!attaRefPrelimStore)

    !unusedchoice = !!mdsSelectSpref('ATTA',!preliminarySupp.lbor,!this.standard.selection(),/MDS ).first()
    handle ANY
      !!alert.error('Cannot select ancillary at this bore.')
      return
    endhandle

    !listChoice = !this.standard.selection()

    --try and find the SUPF entry for !listChoice in the MDS/APPDEFAULTS db
    !appDefName = '/MDS/ATTA/DEFAULTS/' + '$!listChoice' + '/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !ancilSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !ancilSuppFunc = $!appDefRef.ppro
    endhandle

    !alias = !this.form.support.alias
    if !alias.unset() then
      !alias = ''
    endif

    !prelimSuppFunc = !preliminarySupp.:mdssuppfunc

    if ((!ancilSuppFunc neq !prelimSuppFunc) and (!prelimSuppFunc.unset().not() and !prelimSuppFunc.neq(''))) then
      !continue = !!alert.confirm('The wrong Ancillary Type has been chosen. The preliminary support has a support function of ' + !prelimSuppFunc + ' but the chosen support function is ' + !ancilSuppFunc + '. Do you want to continue?').boolean()
    else
      !continue = true
    endif
    if !continue then
      !!kActionCommands(!!mdsAncill.action)
      if !datumFromPreliminary then
        !!mdsSetDatumAtta(!this.form)
      endif
    endif
  else
    !!kActionCommands(!!mdsAncill.action)
  endif

endmethod
