--
-- Description:
-- Form Definition for selecting ancillary items (blocking)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignUnderValve()                -
--  apply ()                         -
--  callb(STRING)                    -
--  checkName()                      -
--  edgentry()                       -                   Performs actions BEFORE the Creation of an 'AT60' ANCILLARY on a STANDARD or a SPECIAL
--  filter()                         -
--  iconFilter(STRING)               -
--  mdsAncill()                      -
--  returnfromedg(ARRAY)             -                   Performs actions BEFORE the Creation of an 'AT60' ANCILLARY on a STANDARD or a SPECIAL
--

-- Kill existing form definition
Kill !!mdsAncill

-- Define Form
setup form  !!mdsAncill dialog resizable $* BLOCKING FORM - not a BLOCKING form ANY more --<wd>feb2004

  !!mdsAncill.formtitle    = |Ancillary Selection                                |
  !!mdsAncill.icontitle    = ||
  !!mdsAncill.callback     = ||
  !!mdsAncill.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

  text .name 'Name:' tagwidth 5 at x1 callback '!!mdsAncill.checkName()' width 20 name
  button .autoname tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsautoname.getnextname(!this)|
  list .standard |Select type:                                       | at x1 ymax+0.3 call |!this.callb(!this.standard.selection('rtext'))| anchor L+B+R+T width 60 length 10

  path down

  -- Filter gadgets

  para .pfilter at x1 ymax anchor L+B text 'List by Type : '

  button .filtAN  at xmax+0.1 ymin tooltip 'Anchors'     pixmap anchor L+B width 18 height 18 call |!this.iconFilter('AN')|
  button .filtAT  at xmax+0.1 ymin tooltip 'Ancillaries' pixmap anchor L+B width 18 height 18 call |!this.iconFilter('AT')|
  button .filtGT  at xmax+0.1 ymin tooltip 'Guides'      pixmap anchor L+B width 18 height 18 call |!this.iconFilter('GT')|
  button .filtBT  at xmax+0.1 ymin tooltip 'U-Bolts'     pixmap anchor L+B width 18 height 18 call |!this.iconFilter('BT')|
  button .filtSU  at xmax+0.1 ymin tooltip 'Slip Units'  pixmap anchor L+B width 18 height 18 call |!this.iconFilter('SU')|
  button .filtST  at xmax+0.1 ymin tooltip 'Stops'       pixmap anchor L+B width 18 height 18 call |!this.iconFilter('ST')|
  button .filtALL at xmax+0.1 ymin tooltip 'All'         pixmap anchor L+B width 18 height 18 call |!this.iconFilter('ALL')|

  button .filterBy   | Filter By...| at xmax form-15 ymin Call |show !!mdsAncilFilter| anchor R+B

  -- Selection Criteria
  vdist .1
  para .criteria at x1 ymax+0.4 width 60 lines 2

  -- Bottom Line
  --<wd>feb2004    button .ok     |   OK   | call |!!kActionCommands(!!mdsAncill.action)| ok
  button .ok     |   OK   | call |!this.apply ()| anchor L+B

  button .view   | View...| at xmax+1 ymin Call |call !!mdsAddAncill(!!mdsAncill.standard, 'show',!!mdsAncill)| anchor L+B

  path right

  button .cancel | Cancel | at xmax form-8 anchor R+B cancel

  -- Form Members
  -- Actions to be taken on applying form
  member .action  is ARRAY

  -- Member to save design parameters in when modifying the type
  member .savedPars is ARRAY

  --<wd>dec2002
  -- Shoe Reference
  member .shoeref is DBREF
  -- Shoe Existing Height
  member .shoehei is REAL
  --<wd>dec2002

  --<wd>jan2004
  -- Associated Trunnion Length
  member .tlength is REAL
  -- Store for the Initialised OK callback
  member .storeaction is ARRAY
  -- Define the 'AT60' Specific Object Members Required.
  member .offset is REAL
  member .flan   is DBREF
  -- Cancel Button Callback Actions
  member .cancelaction is ARRAY
  -- Store the Calling Form e.g. !!mdsFT09
  member .form is FORM
  --<wd>jan2004

  -- Members to store all available elements on initialisation

  member .allDtext is ARRAY
  member .allRtext is ARRAY

  -- Member to save criteria text for filtering

  member .filtertext is STRING

  -- member to store preliminary support that is being referenced and taking over
  member .preliminarySupp is DBREF
  -- Populate gadget

  -- End form definition
exit

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsAncill()
  !!mdsAncill.action[1] = ||
  -- Set icon backgrounds
  !!mdsAncill.filtAN.addPixmap(!!pml.getPathName('anchor_16.png'))
  handle any
  endhandle
  !!mdsAncill.filtAT.addPixmap(!!pml.getPathName('general_16.png'))
  handle any
  endhandle
  !!mdsAncill.filtGT.addPixmap(!!pml.getPathName('slide_16.png'))
  handle any
  endhandle
  !!mdsAncill.filtBT.addPixmap(!!pml.getPathName('ubolt.png'))
  handle any
  endhandle
  !!mdsAncill.filtSU.addPixmap(!!pml.getPathName('slip_16.png'))
  handle any
  endhandle
  !!mdsAncill.filtST.addPixmap(!!pml.getPathName('anchor_16.png'))
  handle any
  endhandle
  !!mdsAncill.filtALL.addPixmap(!!pml.getPathName('all.png'))
  handle any
  endhandle
  !this.autoname.addPixmap(!!pml.getPathName('autoname.png'))

  -- set view gadget inactive until plots are in place...
  --!!mdsAncill.view.active   = false

  !this.newMenu('autonamemenu')
  !this.autonamemenu.add('callback','Select Naming File...','show !!mdsautoname')
  !this.autoname.setpopup(!this.autonamemenu)
endmethod
-- End of method

-----------------------------------------------------------------------------------------
-->>>-<wd>dec2002
-----------------------------------------------------------------------------------------
define method .callb(!alias is STRING)

  --<wd>feb2004
  -- The OK callback is set up initially in the form member array .action
  -- It is ALWAYS copied and stored, via the init function !!mdsiancill(),
  -- in the form member array .storeaction for resetting purposes when a
  -- 'AT60' ancillary is selected in the list gadget .standard

  -- Code is ONLY Specific for the MDS Standard Type 'AT60'
  if (!alias inset ('AT60')) then
    -- Reset the OK callback to suit 'AT60'
    !this.action      = !this.storeaction
    !this.ok.callback = '!this.edgentry()'
    --add new actions for a butterfly valve support so that it can be positioned under the valve
  elseif (!alias inset ('AT185')) then
    !this.action      = !this.storeaction
    !this.ok.callback = '!this.alignUnderValve()'
  else
    -- Always Reset the OK callback to what is was when the form was initialised
    !this.action      = !this.storeaction
    !this.ok.callback = '!this.apply()'
  endif
  if !this.preliminarySupp.badref() then
    -- Navigate to the Identified Component when Initialising this FORM
    !!ce = !this.form.support.idcomp
    handle ANY
      -- Error (2,822) - Cannot set current element to an unset reference when called from the
      --                 MDS Framework Modify Ancillary form - !!mdsModAt

      -- This can be called by two form !!mdsModanc or !!mdsEditProp
      -- These form cannot be shown at the same time so therefore one
      -- will be displayed. Find out which and set !callingForm to
      -- the calling form
      if !!mdsEditProp.shown() then
        !callingForm = !!mdsEditProp
      elseif !!mdsModAt.shown() then
        !callingForm = !!mdsModAt
      endif
      !!ce = !callingForm.atta
    endhandle
  else
    -- navigate to preliminary supp
    !!ce = !this.preliminarySupp
  endif

  --<wd>feb2004
  -----------------------------------------------------------------------------------------

  -- Test for MDS Standard Type for Reinforcing/Cradle Pad
  --<wd>jan2004
  --    if (!alias inset ('AT05', 'AT09', 'AT23')) then
  if (!alias inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then

    --<wd>jan2004

    -- Form is now Hidden all the time
    --!!mdsreinfpad.show()
    -- Select the Pipe Type Automatically on the Form !!mdsreinfpad
    if (!!ce.type.eq('ATTA')) then

      --<wd>jan2004
      -- SREF ATTA of a MDS FRAMEWORK Support Identified
      if (!!ce.name.match('/SREF').gt(0)) then
        !datumnam = !!ce.name.replace('/SREF','/DATUM')
        -- Navigate to DATUM Atta
        !!ce      = !datumnam.dbref()
      endif
      --<wd>jan2004

      --<wd>16jun2004
      --if (!!ce.stype inset ('AT01','AT02','AT12','AT13','AT14','AT15','AT18','AT19')) then
      if (!!ce.stype inset ('AT01','AT02','AT12','AT13','AT14','AT15','AT18','AT19','AT96')) then
        -- WELDED Pipe Shoes Only - Clamp ON Pipe Shoes are EXCLUDED from the above list as PADS are NOT Allowed on these Shoes
        !!mdsreinfpad.type.select('SHOE')
        !!mdsAncill.shoeref = !!ce
      else
        !!mdsreinfpad.type.select('PIPE')
      endif
    else
      !!mdsreinfpad.type.select('PIPE')
    endif

    -----------------------------------------------------------------------------------------
    -->>>-<wd>feb2003
    -- Test for MDS Standard ISOLATION or SLIDE UNIT PADS
    --<wd>july2003
    -- AT42 added to !alias list in order to force the !!mdsreinfpad.type gadget to 'PIPE'
    -- as AT42 may not currently be associated with a SHOE on a MDS FRAMEWORK support
    -- when BOTH AT42 and the SHOE are members on the same MDS FRAMEWORK support
    --elseif (!alias inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F')) then

  elseif (!alias inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42')) then
    --<wd>july2003

    -- Select the Pipe Type Automatically on the Form !!mdsreinfpad
    if (!!ce.type.eq('ATTA')) then
      -- ALL WELDED Shoes and CLAMP ON Shoes are INCLUDED in the list below.
      if (!!ce.stype inset ('AT01','AT02','AT03','AT04','AT06','AT08','AT12','AT13','AT14','AT15','AT16','AT17','AT18','AT19','AT20','AT25','AT140','AT141','AT144','AT145','AT146','AT147','AT148','AT149','AT150','AT151')) then
        !!mdsreinfpad.type.select('SHOE')
        !!mdsAncill.shoeref = !!ce
      else
        !!mdsreinfpad.type.select('PIPE')
      endif
    else
      !!mdsreinfpad.type.select('PIPE')
    endif

  else
    !!mdsreinfpad.hide()
  endif

  -- Update plotfile is FORM shown

  if !!mdsShowAncill.shown() then
    call !!mdsAddAncill(!!mdsAncill.standard, 'show',!!mdsAncill)
  endif

  --<<<-<wd>feb2003
  -----------------------------------------------------------------------------------------

endmethod
