--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsgussetcreate()                -
--  mdsgussetselect()                -
--

-- Kill existing form definition
Kill !!mdsAT144

-- Define Form
setup form  !!mdsAT144 at xr0 yr0 noquit

  !!mdsAT144.formtitle    = ||
  !!mdsAT144.icontitle    = ||
  !!mdsAT144.callback     = ||
  !!mdsAT144.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatAt144()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsAT144)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosthro(!!mdsAT144)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsAT144)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  -- creation
  frame  .fcreate |Create| at x0 ymax width 31
    toggle .rpad |Additional Gusset| tagwid 15 call |!this.mdsgussetcreate()|
    option .type |No| tagwid 3 at xmax.rpad+2 ymin.rpad call |!this.mdsgussetselect()| width 3
  exit


  frame .fMisc |Options| at x0 ymax width 31
    para .pHeight at x1 Ymax+0.2 text |Height      |
    path right
    text .height    || call |Call !!mdsModShoe(!!mdsAT144,'HEIGHT',!!mdsAT144.support.atta[1])| width 14 is REAL format !!distanceFmt
    para .plength at x1 Ymax+0.2 text |Length      |
    text .length    || call |Call !!mdsModShoe(!!mdsAT144,'LENGTH',!!mdsAT144.support.atta[1])| width 14 is REAL format !!distanceFmt
    para .rangtemp at x1 ymax+0.2 text 'Temp.Range'
    para .notetemp at xmax+3 ymin width 14 lines 1

    -- Icons Row 1

    button .addPipe  at x1   ymax+0.3 tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorAT144()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsAT144)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsAT144)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call ||


    -- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip  'Add Packer'         pixmap width 18 height 18 call ||
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsAT144,'!!mdsRotateAT144()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!this)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call | !!mdsnewdatum(!this)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsAT144,'ATTA')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call ||

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |!!mdsIModAt(!this,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |!!mdsDeleteAtta(!this)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsAT144)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call ||
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsAT144)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsAT144)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |!!mdsimdsadp(!!mdsAT144,'INIT')|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsAT144)|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call ||

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipatta at x1 ymax+0.25  tooltip 'Flip Ancillary'   pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptAT144()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING
  !this.blockedIcons = '1,2,3,4,6,7,11,12,13,19,20,21,22,24,28,34,41,42,56,58,62'

  -- End form definition
exit

-------------------------------------------------
-- Set background colour of pixmaps to white
!!mdsSetIconBack(!!mdsAT144,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsAT144,TRUE)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsAT144.select)

call !!mdsloadoptionb(!!mdsAT144.type)

-------------------------------------------------
define method .mdsgussetselect()

  --<dw>mar2009 DFN P-16466 Convert to metric for reference to mds defaults
  units mm bore
  !!ce        = !this.support.atta[1]
  !desp       = despara
   !parVar     = '!!mdsPar' & !!ce.styp
  !bore       = !!ce.abor

  --<wd>14dec2009 - DFN P-26826(SI-18716) - MDS SHOE types 'AT144','AT146','AT147','AT148','AT150','AT151'
  -- The additional TWO GUSSET PLATE functionality NOT WORKING correctly
  -- Calculate the actual Gusset Plate Spacing depending on the Number of additional Gusset Plates required , instead of it being HARD CODED at 150
  --!gussetCle  = 150
  --<wd>14dec2009 - DFN P-26826(SI-18716)

  !gussdpthk  = !!mdsGetDesp('STHK')
  -- !gussetthk  = $!parVar[$!bore].despars[$!gussdpthk].real()

  --<dw>mar2009 dun1119 - Object applied to extract design parameter
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!bore.real())
  !gussetthk   = !mdsattaobj.despars[$!gussdpthk].real()

  if !this.type.string().upcase() eq 'ONE' then
    !gussetnum = 3
    !gussetCle = 0
  else
    !gussetnum = 4
   endif

  --<wd>14dec2009 - DFN P-26826(SI-18716) - MDS SHOE types 'AT144','AT146','AT147','AT148','AT150','AT151'
  -- The additional TWO GUSSET PLATE functionality NOT WORKING correctly
  -- Calculate the actual Gusset Plate Spacing depending on the Number of additional Gusset Plates required , instead of it being HARD CODED at 150
  var !distanceP4P5 cons dist P4 to P5
  !gPlateCentres = !distanceP4P5.real()
  if (!gussetnum.eq(4)) then
    !gussetCle  = !gPlateCentres / 3
  else
    !gussetCle = 0
  endif
  --<wd>14dec2009 - DFN P-26826(SI-18716)

  --<dw>mar2009 DFN P-16466 Convert back to original units.
  if(!!kgetBoreUnits()) then
    units in bore
  endif

  --<dw>mar2009 DFN P-10000 DAC control added.
  !!mdsDacControl(TRUE)
  desp n16 $!gussetnum
  desp n17 $!gussetthk

  --<wd>14dec2009 - DFN P-26826(SI-18716) - MDS SHOE types 'AT144','AT146','AT147','AT148','AT150','AT151'
  -- The additional TWO GUSSET PLATE functionality NOT WORKING correctly
  -- Design Parameter Number 22 is for the RPAD Overlap
  --desp n22 $!gussetCle
  if (!this.support.alias inset ('AT144','AT146','AT147','AT148')) then
    -- Design Parameter Number 22 is for the Gusset Plate EQUAL Spacing
    desp n22 $!gussetCle

  elseif (!this.support.alias inset ('AT150','AT151')) then
    !desp22default = '/MDS/ATTA/DEFAULTS/AT150/' + !bore.real().value().string() + '/DESPAR/22'
    !desParNum22 = !desp22default.dbref().ppro
    !desParNum22 = $!desParNum22
    --!desParNum22 = $!parVar[$!bore].despars[22].real()
    -- Design Parameter Number 24 is for the Gusset Plate EQUAL Spacing
    desp n24 $!gussetCle
  endif
  --<wd>14dec2009 - DFN P-26826(SI-18716)

  !!mdsDacControl(FALSE)
endmethod

-------------------------------------------------

define method .mdsgussetcreate()

  --<dw>mar2009 DFN P-16466 Convert to metric for reference to mds defaults
  units mm bore
  !!ce        = !this.support.atta[1]
  !desp       = despara
   !parVar     = '!!mdsPar' & !!ce.styp
  !bore       = !!ce.abor
  !gussdpthk  = !!mdsGetDesp('STHK')
  -- !gussetthk  = $!parVar[$!bore].despars[$!gussdpthk].real()

  --<dw>mar2009 dun1119 - Object applied to extract design parameter
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!bore.real())
  !gussetthk   = !mdsattaobj.despars[$!gussdpthk].real()
  --<dw>mar2009 DFN P-16466 Convert back to original units.
  if(!!kgetBoreUnits()) then
    units in bore
  endif

  if !this.rpad.val then
    !this.type.active  = TRUE
    !this.type.val  = 1
    !gussetnum = 3
    !gussetCle = 0
  else
    !this.type.active  = FALSE
    !gussetnum = 2
    !gussetthk = 0
    !gussetCle = 0
  endif

  --<dw>mar2009 DFN P-10000 DAC control added.
  !!mdsDacControl(TRUE)
  desp n16 $!gussetnum
  desp n17 $!gussetthk

  --<wd>14dec2009 - DFN P-26826(SI-18716) - MDS SHOE type AT150. The additional TWO GUSSET PLATE functionality NOT WORKING correctly
  --desp n22 $!gussetCle
  if (!this.support.alias inset ('AT144','AT146','AT147','AT148')) then
    -- Design Parameter Number 22 is for the Gusset Plate EQUAL Spacing
    desp n22 $!gussetCle
  elseif (!this.support.alias inset ('AT150','AT151')) then
    !desp22default = '/MDS/ATTA/DEFAULTS/AT150/' + !bore.real().value().string() + '/DESPAR/22'
    !desParNum22 = !desp22default.dbref().ppro
    --!desParNum22 = $!parVar[$!bore].despars[22].real()
    !desParNum22 = $!desParNum22
    desp n22 $!desParNum22
    -- Design Parameter Number 24 is for the Gusset Plate EQUAL Spacing
    desp n24 $!gussetCle
  endif
  --<wd>14dec2009 - DFN P-26826(SI-18716

  !!mdsDacControl(FALSE)
endmethod
