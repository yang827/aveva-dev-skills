--
-- File:    Mdsautoname.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue May 22
--
--
-- Description:
-- Form Definition for the autonaming selection form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkFile()                      -                   Check the existence of the specified file
--  clearAutoFile()                  -                   sets the new naming file
--  getFileIndex()                   STRING
--  getNextName(FORM)                -                   default constructor
--  resetIndex()                     -                   resets the index in the selected file
--  setAutoFile()                    -                   sets the new naming file
--  setFile()                        -                   sets the new naming file
--  setPara()                        -                   sets the paragraph gadget on the form
--  showFiles()                      -                   default constructor
--

-- Kill existing form definition

kill !!mdsAutoName

-- Define Form

setup form !!mdsAutoName

  !!mdsAutoName.formtitle    = |MDS AutoNaming File|
  !!mdsAutoName.icontitle    = ||
  !!mdsAutoName.callBack     = |!this.showFiles()|
  !!mdsAutoName.formrevision = ||

-- Body of Form
  list .namingFile  |File Name | call |!this.setPara()| width 32 lines 6

    path down

  para .pPrefix text              'Prefix          '
  para .prefix at xmax ymin width 20 lines 1

  para .pIndex at x0 ymax text    'Index           '
  para .index at xmax ymin width 20 lines 1

  para .pSuffix at x0 ymax text   'Suffix          '
  para .suffix at xmax ymin width 20 lines 1

  para .pIwidth at x0 ymax text   'Index Width     '
  para .iWidth at xmax ymin width 20 lines 1

  para .pMinIndex at x0 ymax text 'Min Index       '
  para .minIndex at xmax ymin width 20 lines 1

  para .pMaxIndex at x0 ymax text 'Max Index       '
  para .maxIndex at xmax ymin width 20 lines 1

  button .resetI |Reset Index to| at x0 ymax+0.5 call |!this.resetIndex()|

  text .reset |               | at xmax ymin width 4 integer

  path down
  button .autoName      |Set Autonaming File to Default Zone| at x0 ymax+0.5 call |!this.setAutoFile()|
  button .autoNameClear |  Clear Autonaming File from Zone  | at x0 ymax+0.5 call |!this.clearAutoFile()|

  --  text .reset |               | at xmax ymin width 4 integer

  button .ok |   OK   | at x0 ymax+0.5  call |!this.setFile()| OK

    path right
    hdist 18

  button .cancel | Cancel | cancel

  -- Members

  member .fileName is FILE

-- End form definition
exit

------------------------------------------------------------------------
--
-- Method:      .showFiles
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .showFiles()

  -- Get all naming file from defaults directory or directories

  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH
  --!splitDFLTS = !!pdmsDFLTS.split(' ')
  var !proj PROJECT CODE
  !evarName = '$!<proj>DFLTS'
  !splitDFLTS = !!evarSplit(!evarName)
  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH

  !file = ARRAY()
  do !dflts values !splitDFLTS
    skip if !dflts.trim().eq('')
    !directory = object FILE()
    !directory.file('$!dflts')
    !list = !directory.files()
    -- tm fix for 11.6
    handle(160,8)
       skip
    endhandle
    do !findNamingFiles values !list
      if !findNamingFiles.entry().matchWild('DES-SUPP-NAMES*') then
        !file.append(!findNamingFiles)
      endif
    enddo
  enddo

  !dText = ARRAY()
  !rText = ARRAY()
  do !loop values !file
    !dText.append(!loop.entry())
    !rText.append(!loop.fullname())
    !testForUnique = !dText
    if !testForUnique.size() neq !testForUnique.unique().size() then
      !dText.removeLast()
      !rText.removeLast()
    endif
  enddo

  !dText.invert()
  !rText.invert()

-- Sort dtext and rtext before setting

  !sortedDText = !dText.sortedindices()
  !newDText = ARRAY()
  !newRText = ARRAY()
  do !reset values !sortedDText
    !newDText.append(!dText[$!reset])
    !newRText.append(!rText[$!reset])
  enddo

  !this.namingFile.dText = !newDText
  !this.namingFile.rText = !newRText

  -- Try to select the existing file being used

  !this.namingFile.select('RTEXT',!this.fileName.string())
    handle (61,567)
-- The default file to use is DES-SUPP-NAMES unless a file exists called DES-SUPP-NAMES-(MDB NAME)
    var !mdb mdb
    !mdb = !mdb.after('/')
    !fileNameWithMDB = 'DES-SUPP-NAMES-$!mdb'
    !findFile = !!mdsAutoName.namingFile.dText.find(!fileNameWithMDB)
    if !findFile.set() then
      !this.fileName = object FILE(!!mdsAutoName.namingFile.rText[$!findFile[1]])
      !this.namingFile.select('RTEXT',!this.fileName.string())
    else
      !this.fileName = object FILE(!!mdsAutoName.namingFile.rText[1])
      !this.namingFile.select('RTEXT',!this.fileName.string())
      endif
    endhandle
  -- Get the data to show on the autonaming form
  !this.setPara()

-- Check the autonaming file of the Default Creation Zone
  if  (defined(!!mdsOptions)) then

    $!!mdsOptions.site.val
   handle ANY
--<wd>mar2006-<mds12> --ADDED- handle any etc...
   endhandle

    !udaFile =  object FILE('$!!ce.:MDSAUTOFILE')
      handle (61,567)(2,204)(2,427)
        return
      endhandle

    if !!ce.:MDSAUTOFILE.neq('unset') then
      !udaFileFullName = !udaFile.fullname()
        handle (160,8)
        !!alert.error('Zone $!!mdsOptions.site.val is already set to use this autonaming FILE that does not exist! $!udaFile')
        !udaFileFullName = !udaFile
        return
      elsehandle NONE
        !!mdsAutoName.namingFile.select('RTEXT','$!udaFileFullName')
        !this.setPara()
      endhandle
    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .checkFile
--
-- Description: Check the existence of the specified file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checkFile()

-- Do not think this is used

  !fileName = '$!!pdmsDFLTS\DES-SUPP-NAMES'

  !this.fileName = object FILE(!fileName)
  if (!this.fileName.exists().not()) then
    !!alert.error('The FILE specified does not exist. Aborting MDS autonaming utility')
    return
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .getNextName
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .getNextName(!form is FORM)

-- get gadget name

  if !form.name().eq('MDSMODIFYNAME') then
    !nameGadget = !form.newname
  else
    !nameGadget = !form.name
  endif

-- If the name gadget already has a name then check with user it is ok to proceed.

  if !nameGadget.val.neq('unset') then
    if !!alert.confirm('Name already set. OK to continue?').eq('NO') then
      return
    endif
  endif

-- Read current file into array

  !file = '\' + !this.fileName.string()

  !existsFileCont = !this.fileName.readfile()

-- Loop through file redefining contents

  !newFileCont = ARRAY()

-- Take next available number

  do !lines values !existsFileCont
    if !lines.upcase().match('INDEX').eq(1) then
      !tIndex = !lines.split('\')
      !newIndex = !tIndex[2].real() + 1
      !newFileCont.append('Index \ ' + !newIndex.string())
    else
      if !lines.upcase().match('PREFIX').eq(1) then
        !prefix = !lines.after('\').trim()
      elseif !lines.upcase().match('SUFFIX').eq(1) then
        !suffix = !lines.after('\').trim()
      endif
      !newFileCont.append(!lines)
    endif
  enddo

-- Make index correct width

  if !this.iWidth.val.real().neq(0) then
    !zeros = '000000000000'
    !width = !newIndex.string().length()
    !add = !this.iWidth.val.real() - !width
    !newVal = !zeros.substring(1,$!add).string() + !newIndex.string()
    !newIndex.delete()
    !newIndex = !newVal
  endif

-- make new support name from values
-- Access creation zone before evaluating expression

  !!mdsMoveToSite('')
  handle any
  endhandle

  if !prefix.neq('') then
    !nPrefix = ($!prefix)
    handle ANY
      !nPrefix = |$!prefix|
    endhandle
  else
    !nPrefix = ''
  endif

  if !suffix.neq('') then
    !nSuffix = ($!suffix)
    handle ANY
      !nSuffix = |$!suffix|
    endhandle
  else
    !nSuffix = ''
  endif

-- Before completing the naming, check if the max index has been exceeded
-- It will be set to 0 if there is not one

  if !!mdsAutoName.maxIndex.val.neq('0') then
    if !newIndex.real().gt(!!mdsAutoName.maxIndex.val.real()) then
      !!alert.error('Maximum index of naming FILE reached, cannot create new support name beyond max index.')
      return
    endif
  endif

  if !nPrefix.objecttype().eq('DIRECTION') then
    !saveNPrefix = !nPrefix
    !nPrefix.delete()
    !nPrefix = !saveNPrefix.string().before('WRT').trim()
  endif

  if !nSuffix.objecttype().eq('DIRECTION') then
    !saveNSuffix = !nSuffix
    !nSuffix.delete()
    !nSuffix = !saveNSuffix.string().before('WRT').trim()
  endif

  !nextName = !nPrefix.string() + !newIndex.string() + !nSuffix.string()
  !suppExists = FALSE

-- Before writing new name back to the file then check to see if it exists
  /$!nextName
    handle NONE
    !suppExists = TRUE
    !errName = !nextName
    elsehandle ANY
-- Check for group support with same rootname
    !nextGroupName = !nextName & '[1]'
    /$!nextGroupName
      handle NONE
      !suppExists = TRUE
      !errName = !nextGroupName
    elsehandle ANY
    endhandle
  endhandle

  if !suppExists then
    --if !!alert.confirm(|The next name available $!nextName already exists, do you want me to find the next available free name?|).eq('YES') then
    if !!alert.confirm(|The next name available $!errName already exists, do you want me to find the next available free name?|).eq('YES') then
        do from 1
        !newIndexReal = !newIndex.real() + 1
        !newIndex = !newIndexReal.string()

        !addZeros = object STRING()
        if !this.iWidth.val.real().neq(0) then
          !zeros = '000000000000'
          !width = !nextName.string().length()
          !add = !this.iWidth.val.real() - !width
          !addZeros = !zeros.substring(1,$!add).string()
        endif

        !nextName = '/' + !nPrefix.string() + !addZeros + !newIndex.string() + !nSuffix.string()

        !!ce = !nextName.dbref()
            handle NONE
          --            $P $!nextName exists
          skip
        elsehandle ANY
          -- Check for group support with same root name
          !nextGroupName = !nextName & '[1]'
          !!ce = !nextGroupName.dbref()
          handle NONE
            !suppExists = TRUE
            skip
          elsehandle ANY
            !nextName = !nPrefix.string() + !addZeros + !newIndex.string() + !nSuffix.string()
            -- Update index in !newFileCont
            do !editLines from 1 to !newFileCont.size()
              !line = !newFileCont[$!editLines]
              if !line.match('Index').eq(1) then
                !newFileCont[$!editLines] = 'Index \ $!newIndex'
                break
              endif
            enddo
            !!mdsAutoName.index.val = !newIndex
                break
              endhandle
            endhandle
        enddo
      else
        same
        return
      endif
   endif


-- Check if the name contains spaces

  if !nextName.match(' ').gt(0) then
    !!alert.error('The generated name $!nextName contains spaces. Please check the naming FILE for errors.')
    !nameGadget.val = 'unset'
     return
   endif

-- Put new name into supplied gadget

  !nameGadget.val = !nextName

-- Get callback from gadget and execute it
  -- The callback will be driven by the CALLIB synonym so replace it

  !callBack = !nameGadget.callBack
  !callBack = !callBack.replace('CALLIB ','$$M/%PDMSUI%/CLIB/FILES/')
  $!callBack

  -- Write new contents to file

  !fileName = !this.fileName.string()
  !newFile = object FILE(!fileName)
  !newFile.writeFile('OVERWRITE',!newFileCont)
    handle (41,322)
    !!alert.error('The FILE $!fileName could not be opened to update the index value.')
    !nameGadget.val = 'unset'
      return
    endhandle

  !!mdsAutoName.index.val = !newIndex

endmethod

------------------------------------------------------------------------
--
-- Method:      .setFile
--
-- Description: sets the new naming file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setFile()

  -- !this.fileName = object FILE('$!!pdmsDFLTS\' + !this.namingFile.dText[!this.namingFile.val])
  !this.fileName = object FILE(!!mdsAutoName.namingFile.selection('RTEXT'))

endmethod


------------------------------------------------------------------------
--
-- Method:      .setAutoFile
--
-- Description: sets the new naming file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setAutoFile()

  if (defined(!!mdsOptions)) then

  var !proj proj code
    !projDFLTS = '%' + '$!proj' + 'DFLTS%'
    !fileName = object FILE(!!mdsAutoName.namingFile.selection('DTEXT'))
    !this.fileName = object FILE('$!projDFLTS\' + '$!fileName')

    -- !this.fileName = object FILE('$!!pdmsDFLTS\' + !this.namingFile.dText[!this.namingFile.val])
    -- !this.fileName = object FILE(!!mdsAutoName.namingFile.selection('RTEXT'))

    $!!mdsOptions.site.val

    if !!ce.:MDSAUTOFILE.neq('unset') then
      !udaFile =  object FILE('$!!ce.:MDSAUTOFILE')
      !udaFileFullName = !udaFile.fullname()
      handle (160,8)
        !!alert.error('Zone $!!mdsOptions.site.val is already set to use this autonaming FILE that does not exist! $!udaFile')
        !udaFileFullName = !udaFile
      endhandle
    endif


    if !this.fileName.exists()then

      if !!ce.:MDSAUTOFILE.neq('unset') then
        --!shortUDAFile = !udaFile.string().split('\')[2]
        !shortUDAFile = !udaFile.entry()
        if !!ce.:MDSAUTOFILE.eq('$!this.fileName') then
          !!alert.message('Zone $!!mdsOptions.site.val is already set to use this autonaming FILE $!fileName')
        elseif !!alert.confirm('Zone $!!mdsOptions.site.val is set to use autonaming FILE $!shortUDAFile do you want to replace with autonaming FILE $!fileName').eq('YES') then
          :MDSAUTOFILE '$!this.fileName'
        endif
      endif

      if !!ce.:MDSAUTOFILE.eq('unset') then
        if !!alert.confirm('do you want Zone $!!mdsOptions.site.val to use autonaming FILE $!fileName?').eq('YES') then
          :MDSAUTOFILE '$!this.fileName'
        endif
      endif

    else

      !!alert.error('The following autonaming FILE does not exist for this FILE $!this.fileName')
      return
    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .clearAutoFile
--
-- Description: sets the new naming file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .clearAutoFile()

  if !!ce.:MDSAUTOFILE.eq('unset') then
    !!alert.error('Zone $!!mdsOptions.site.val is not set to a autonaming FILE!')
    return
  else
    if !!alert.confirm('Are you sure you want to clear autonaming FILE from zone $!!mdsOptions.site.val$n?').eq('YES') then
      !!ce = !!mdsOptions.site.val.dbref()
      :MDSAUTOFILE def
    endif
  endif

endmethod


------------------------------------------------------------------------
--
-- Method:      .setPara
--
-- Description: sets the paragraph gadget on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPara()

 -- Select the autonaming file of the Default Creation Zone
  if  (defined(!!mdsOptions)) then
    if !!mdsAutoName.shown() then

      $!!mdsOptions.site.val

      !udaFile =  object FILE('$!!ce.:MDSAUTOFILE')
      handle (61,567)(2,204)(2,427)
        return
      endhandle

      if !!ce.:MDSAUTOFILE.neq('unset') then
        !udaFileFullName = !udaFile.fullname()
        handle (160,8)
          !!alert.error('Zone $!!mdsOptions.site.val is already set to use this autonaming FILE that does not exist! $!udaFile')
          !udaFileFullName = !udaFile
          return
        elsehandle NONE
          if (!!mdsAutoName.namingFile.selection('RTEXT') neq !udaFileFullName) then
            !shortUDAFile = !udaFile.entry()
            --!shortFile = !!mdsAutoName.namingFile.selection('DTEXT')
            --if !!alert.confirm('Zone $!!mdsOptions.site.val is set to use autonaming file $!shortUDAFile do you want to continue with using autonaming file $!shortFile for this session').eq('NO') then
            !!mdsAutoName.namingFile.select('RTEXT','$!udaFileFullName')
              --endif
            endif
          endhandle
      endif

    endif
  endif


  !linesOfFile = !!readPDMSFile('/' + !this.namingFile.rText[$!this.namingFile.val])

  !this.iWidth.val = ''
  !this.maxIndex.val = ''
  !this.minIndex.val = ''

  do !set values !linesOfFile
    if !set.upcase().match('PREFIX').eq(1) then
      !this.prefix.val = !set.after('\').trim()
      if !this.prefix.val.eq('') then
        !this.prefix.val = 'unset'
      endif
    elseif !set.upcase().match('INDEX').eq(1) then
      !this.index.val = !set.after('\').trim()
      !this.reset.val = !this.index.val
    elseif !set.upcase().match('SUFFIX').eq(1) then
      !this.suffix.val = !set.after('\').trim()
      if !this.suffix.val.eq('') then
        !this.suffix.val = 'unset'
      endif
    elseif !set.upcase().match('IWIDTH').eq(1) then
      !this.iWidth.val = !set.after('\').trim()
    elseif !set.upcase().match('MAXINDEX').eq(1) then
      !this.maxIndex.val = !set.after('\').trim()
    elseif !set.upcase().match('MININDEX').eq(1) then
      !this.minIndex.val = !set.after('\').trim()
    endif
  enddo

  if !this.iWidth.val.eq('') then
    !this.iWidth.val = '0'
  endif

  if !this.maxIndex.val.eq('') then
    !this.maxIndex.val = '0'
  endif

  if !this.minIndex.val.eq('') then
    !this.minIndex.val = '0'
  endif

  !this.setFile()

endmethod

------------------------------------------------------------------------
--
-- Method:      .resetIndex
--
-- Description: resets the index in the selected file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .resetIndex()

  if !this.reset.val.string().lt(!this.minIndex.val.string()) then
    !!alert.error('Unable to rewind index to minimum value allowed')
    !this.reset.val = !this.index.val
    return
  endif

  -- Read current file into array

  !file = '\' + !this.fileName.string()

  !existsFileCont = !this.fileName.readfile()
  handle (160,46)
  endhandle
  -- Loop through file redefining contents

  !newFileCont = ARRAY()

  -- Reset index

  do !lines values !existsFileCont
    if !lines.upcase().match('INDEX').eq(1) then
      !newFileCont.append('Index \ ' + !this.reset.val.string())
    else
      !newFileCont.append(!lines)
    endif
  enddo

-- Put new index into gadget

  !this.index.val = !this.reset.val

  -- Write new contents to file
  !fileName = !this.fileName.string()
  !newFile = object FILE(!fileName)
  !newFile.writeFile('OVERWRITE',!newFileCont)
  handle (160,46)
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      .getFileIndex
--
-- Description: gets the index currently saved in selected file
--              formatted with zeros and trimmed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getFileIndex() is STRING

-- Read current file into array

  !file = '\' + !this.fileName.string()

  !existsFileCont = !this.fileName.readfile()
    handle (160,46)
    endhandle

-- Reset index

  do !lines values !existsFileCont
    if !lines.upcase().match('INDEX').eq(1) then
      !index = !lines.after('\')
    endif
  enddo

-- Make index correct width
  !index = !index.trim()
  !digitWidth = !this.iWidth.val.real()
  if !digitWidth.neq(0) then
    !zeros = '000000000000'
    !width = !index.length()
    !add = !digitWidth - !width
    !index = !zeros.substring(1,$!add).string() + !index
  endif

  return !index

endmethod
