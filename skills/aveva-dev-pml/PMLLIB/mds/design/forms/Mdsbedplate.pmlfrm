--------------------------------------------------------------------------------
--
-- File:      Mdsbedplate.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:    N.morris
-- Created:		Mon 14 Sept
--
--
-- Description:
-- Form Definition for the set bedplate form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  connect(BOOLEAN)                 -
--  hideconnections()                -
--  reinit()                         -
--  selectitem()                     -
--  showconnections()                -
--

-- Kill existing form definition
kill !!mdsBedPlate

-- Define Form
setup form  !!mdsBedPlate at xr0 yr0

track 'DESICE' call '!this.selectitem()'

!!mdsBedPlate.formtitle    = ||
!!mdsBedPlate.icontitle    = ||
!!mdsBedPlate.callback     = |!this.hideconnections()|
!!mdsBedPlate.formrevision = | $Revision: 1.1.19.1 $ |
!!mdsBedPlate.initcall     = |!this.showconnections()|

-- Body of Form
para .tag text |Support Name:|
  para .name at xmax+2 ymin width 20 lines 1

  list .sctns 'Section                     Connection' at xmin.tag ymax call '!this.showconnections()'width 45 hei 4
button .set    | Set Reference |   at xmin   ymax        call |!this.connect(true)|
button .unSet  | Clear Reference | at xmax+0.5 ymin    call   |!this.connect(false)|

--exit

-- Bottom Line
button .cancel  | Dismiss | at xmax form-size ymax+0.5 call '!this.hideconnections()' CANCEL

-- Members

  member .formname is FORM
  member .bedptype is STRING
member .sctn is DBREF
member .anchor is DBREF
member .enhanced is DBREF

exit

--------------------------------------------------------------------------------
define method .connect(!action is BOOLEAN)

   !val = !this.sctns.val
   -- if action is true then its a connect else its disconnect
   if !action then
	-- connect the appropriate item
	!a = object MDSBPLATECONN(!this.formname,!this.sctns.selection().dbref(),true)
   else
    -- disconnect the selected item
	!a = object MDSBPLATECONN(!this.formname,!this.sctns.selection().dbref(),false)
   endif
   if !this.sctns.selection().dbref().type.eq('SCTN') then
     !call = 'FRAME'
   elseif !this.sctns.selection().dbref().type.eq('FITT') then
     !call = 'FITT'
   else
     !call = 'ATTA'
   endif

--dun1218 we use a different support object for the mds interfaces so the following code calls the correct
--interface object - start
!typeOfSupport = !this.formname.support.objecttype()

if !typeOfSupport.eq('MDSINTERFACESUPPORT') then
	-- set the support object plate connections for restating
	!this.formname.support.plateconns = object MDSINTERFACEBPLATECONN(!this.formname.support)
else
	-- set the support object plate connections for restating
	!this.formname.support.plateconns = object MDSBPLATECONN(!this.formname.support)
endif
--dun1218 we use a different support object for the mds interfaces so the following code calls the correct
--interface object - end

!!mdsIBedPlate(!this.formname,!call)
   !this.sctns.val = !val
   handle ANY
   endhandle
   !this.showconnections()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .reinit()

!!mdsIBedPlate(!this.formname,'FRAME')

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .selectitem()

  if !!ce.type.neq('SCTN') then
    return
  else
    !this.sctns.select('RTEXT',!!ce.refno.string())
    handle ANY
    elsehandle NONE
      !this.showconnections()
    endhandle
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .showconnections()

  !this.hideconnections()
  !this.sctn = !this.sctns.selection().dbref()
    handle ANY
      return
    endhandle
  !name = !this.sctn.namn
    handle ANY
      return
    endhandle

  if !this.sctn.type.eq('PLAT') or !this.sctn.type.eq('ATTA') or !this.sctn.type.eq('FITT')then
    !sctnpos = !this.sctn.pos.wrt(/* )
  elseif !this.sctn.type.eq('HANG') then
    !sctnpos = !this.sctn.tpos.wrt(/* )
  else
    !sctnpos = !this.sctn.poss.wrt(/* )
  endif
  aid text number 2312 '$!name' at $!sctnpos

-- now check for the existence of an anchor plate
  if defined(!this.sctn.:mdsancref[1]) then
    !this.anchor = !this.sctn.:mdsancref[1]
  else
    return
  endif

!list = ARRAY()
!list.append(!this.anchor)
!!kEnhanceList(!list)
  !this.enhanced = !this.anchor
  if !this.anchor.badref().not() then
    !platepos = !this.anchor.position.wrt(/* )
    aid text number 2313 'Plate Connection' at $!platepos
  else
    !!ce = !this.sctn
    :mdsancref default
    same
  endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .hideconnections()

   aid clear text 2312
   handle ANY
      return
   endhandle
   aid clear text 2313
   handle ANY
   endhandle

   unenhance $!this.enhanced
     handle ANY
     endhandle

endmethod
