--
-- File:  Mdsbopdir.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:          FBOPDIR
--
-- Author:  I.osborne
-- Created:  Wed May 07
--
--
-- Description:
-- Pipe Direction Form
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsBopDir

-- Define Form
setup form !!mdsBopDir $* BLOCKING Form -- not a BLOCKING FORM any more --<wd>feb2004

  !!mdsBopDir.formtitle    = |Datum attachment direction|
  !!mdsBopDir.icontitle    = ||
  !!mdsBopDir.callback     = ||
  !!mdsBopDir.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  text .dir |Ancillary direction | width 14 string

  path down
  vdist 1

  -- Bottom Line
  button .apply   |   OK   | Call |Call !!mdsSetBopDir(_Form)| ok

  path right
  hdist 18

  button .dismiss | Cancel | Call |Axes Delete| cancel

  -- Form Members
  -- Support Form
  member .form   is FORM

  --optional member to define the component dbref of the component being directed
  --this is needed in the case of FT21 because of the way it is directed (i.e. a kactioncommands array)
  member .dirElement is DBREF

exit
