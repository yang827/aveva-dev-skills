--
-- File: Mdsbr01.pmlfrm
--   Type: Form Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Design
--   Replaces:
--
-- Author: N.Morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Form Definition for General Ancillary Type 01
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsbrpadclear()                  -
--  mdsbrpadcreate()                 -
--  mdsbrpadselect()                 -
--  mdsbrpadthick()                  -
--

-- kill existing form definition
kill !!mdsbr01

-- define form
setup form  !!mdsbr01 at xr0 yr0 noquit

  !!mdsbr01.formtitle    = ||
  !!mdsbr01.icontitle    = ||
  !!mdsbr01.callback     = ||
  !!mdsbr01.formrevision = | $revision: 1.1.19.1 $ |

  -- body of form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- create datum
  frame .fdatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |call !!mdssetdatbr01()|
    --<wd> .button .bdist | distance | at xmin   ymax+0.25       call |call !!mdsposdonly(!!mdsbr01)|
    button .bdist | Distance | at xmin   ymax+0.25       call |call !!mdsposdist(!!mdsbr01)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distancefmt
    --<wd> button .bthro | through |  at x1     ymax+0.2        call |call !!mdspostonly(!!mdsbr01)|
    button .bthro | Through |  at x1     ymax+0.2        call |call !!mdsposthro(!!mdsbr01)|
    option .select             at xmax+1 ymin            call |call !!mdsthroselect(!!mdsbr01)| width 13
    para   .p                  at x1     ymax width 25 lines 1
  exit

  --<dw>aug2008 dun979-repad addition form display
  -- creation
  frame  .fcreate |Create| at x0 ymax width 31
    toggle .rpad |Repad| call |!this.mdsbrpadcreate()|
    option .type |Type| at xmax.rpad+3 ymin.rpad call |!this.mdsbrpadselect()| width 8
    halign right
    path down
    vdist.2
    --<dw>apr2008 dun935 - width decreased from 16 to 14 to avoid pdms11.5 load error
    text .thick  |Thickness  | call |!this.mdsbrpadthick()| width 14 is REAL format !!distancefmt
    text .clear  |Clearance  | call |!this.mdsbrpadclear()| width 14 is REAL format !!distancefmt
  exit
  --<dw>aug2008 dun979-end of repad addition form display

  frame .fmisc |Options| at x0 ymax width 31

$(
para .pheight at x1 ymax+0.2 text |height      |
path right
text .height    || call |call !!mdsmodshoe(!!mdsbr01,'height',!!mdsbr01.support.atta[1])| width 14 is REAL format !!distancefmt
para .plength at x1 ymax+0.2 text |length      |
text .length    || call |call !!mdsmodshoe(!!mdsbr01,'length',!!mdsbr01.support.atta[1])| width 14 is REAL format !!distancefmt
para .pthickness at x1 ymax+0.2 text |thickness   |
text .thickness || call |call !!mdsmodshoe(!!mdsbr01,'thickness',!!mdsbr01.support.atta[1])| width 14 is REAL format !!distancefmt
para .prodcl at x1 ymax+0.2 text |rod c/l     |
text .rodcl || call |call !!mdsmodshoe(!!mdsbr01,'rodcl',!!mdsbr01.support.atta[1])| width 14 is REAL format !!distancefmt

button .setdefault | set parameters to default  | at x1 ymax+0.2 call |!!mdssetdef(!!mdsbr01.support.alias,!!mdsbr01.support.atta[1])|
button .setsteel |set height to steel/bedplate| at x1 ymax+0.2 call |call !!mdsmodshoe(!!mdsbr01,'steel',!!mdsbr01.support.atta[1])|
$)

    -- icons row 1

    button .addpipe  at x1       ymax tooltip 'add pipe'       pixmap width 18 height 18 call ||
    button .addhvac  at xmax+0.1 ymin tooltip 'add hvac'       pixmap width 18 height 18 call ||
    button .addrack  at xmax+0.1 ymin tooltip 'add rack'       pixmap width 18 height 18 call ||
    button .addbar   at xmax+0.1 ymin tooltip 'add cross bar'  pixmap width 18 height 18 call ||
    button .flip     at xmax+0.1 ymin tooltip 'mirror frame'   pixmap width 18 height 18 call |call !!mdsmirrorbr01()|
    button .hand     at xmax+0.1 ymin tooltip 'rotate frame'   pixmap width 18 height 18 call |call !!mdsrotateframe(!!mdsbr01)|
    button .alignsup at xmax+0.1 ymin tooltip 'align support'  pixmap width 18 height 18 call |call !!mdsxalign(!!mdsbr01)|
    button .modsctn  at xmax+0.1 ymin tooltip 'modify section' pixmap width 18 height 18 call ||


    -- icons row 2

    button .addpack       at x1 ymax+0.25 tooltip  'add packer'         pixmap width 18 height 18 call ||
    button .delpack       at xmax+0.1 ymin tooltip 'delete packer'      pixmap width 18 height 18 call ||
    button .rotate        at xmax+0.1 ymin tooltip 'rotate all attas'   pixmap width 18 height 18 call |call !!mdsirotan(!!mdsbr01,'!!mdsrotatebr01()')|
    button .rotatt        at xmax+0.1 ymin tooltip 'rotate atta'        pixmap width 18 height 18 call |!!mdsrotateatta.rotateonly(!this)|
    button .newdat        at xmax+0.1 ymin tooltip 'modify datum atta'  pixmap width 18 height 18 call | !!mdsnewdatum(!this)|
    button .bedplate      at xmax+0.1 ymin tooltip 'reference bed/anchor plate' pixmap width 18 height 18 call |call !!mdsibedplate(!!mdsbr01,'atta')|
    button .associate     at xmax+0.1 ymin tooltip 'associate atta'     pixmap width 18 height 18 call ||
    button .viewassociate at xmax+0.1 ymin tooltip 'view associations'   pixmap width 18 height 18 call ||

    -- icons row 3

    button .flipfw     at x1 ymax+0.25  tooltip 'flip field weld' pixmap width 18 height 18 call ||
    button .modatta    at xmax+0.1 ymin tooltip 'modify atta'     pixmap width 18 height 18 call |!!mdsimodat(!this,!!mdsmodat)|
    button .deleteatta at xmax+0.1 ymin tooltip 'delete atta'     pixmap width 18 height 18 call |!!mdsdeleteatta(!this)|
    button .nudge      at xmax+0.1 ymin tooltip 'nudge support'   pixmap width 18 height 18 call |!!mdsnudge.init(!!mdsbr01)|
    button .spool      at xmax+0.1 ymin tooltip 'spooling'        pixmap width 18 height 18 call ||
    button .setmat     at xmax+0.1 ymin tooltip 'set section material' pixmap width 18 height 18 call |!!mdssetmat(!!mdsbr01)|
    button .copylike   at xmax+0.1 ymin tooltip 'copy like' pixmap width 18 height 18 call |call !!mdscopylike(!this)|
    button .viewstd    at xmax+0.1 ymin tooltip 'view standard'   pixmap width 18 height 18 call |call !!mdsshowplotfile(_support)|

    -- icons row 4

    button .connect  at x1 ymax+0.25 tooltip 'create connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'modify connections' pixmap width 18 height 18 call ||
    button .forcecon at xmax+0.1 ymin tooltip 'force connection to a pline'  pixmap width 18 height 18 call ||
    button .disconn  at xmax+0.1 ymin tooltip 'delete connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'show/hide framework dimensions' pixmap width 18 height 18 call |call !!mdssetdim(!!mdsbr01)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'adp drawlist'       pixmap width 18 height 18 call ||
    button .zoom     at xmax+0.1 ymin tooltip 'centre on support' pixmap width 18 height 18 call |call !!mdszoomsupp(!!mdsbr01)|
    button .adploc   at xmax+0.1 ymin tooltip 'modify adp location position' pixmap width 18 height 18 call ||

    -- icons row 5

    button .trimmer  at x1 ymax+0.25  tooltip 'trimmer required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'set ancillary material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'copy ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'nudge ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'set length to steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('steel',!this.tlength.val,!this.support.datum,'d wrt /*','tt04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'set trunnion material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'add notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- icons row 6
    button .flipatta at x1 ymax+0.25  tooltip 'flip ancillary'   pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editatta at xmax+0.1 ymin tooltip 'modify atta properties' pixmap width 18 height 18 call |!!mdseditprop.init(!this)|
    button .viewflip at xmax+0.1 ymin tooltip 'flip adp view directions' pixmap width 18 height 18 call |!!mdsviewflip(!this)|
    button .convspec at xmax+0.1 ymin tooltip 'convert to special'       pixmap width 18 height 18 call ||
    button .mtoc     at xmax+0.1 ymin tooltip 'isometric control'        pixmap width 18 height 18 call |!!mdsmtoc.init(!this)|


  exit

  -- bottom line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddencancel || at x0 ymin call |call !!mdsdonthitthis()| cancel
  button .ok      |   OK   | at x0             ymin     call |call !!mdsacceptbr01()|

  -- form members
  -- support object
  member .support     is MDSSUPPORT

  -- graphical representation
  member .repre       is ARRAY

  -- form storage for support restoration
  member .store       is ARRAY

  -- support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- support regeneration function
  member .regen       is STRING

  -- bedplate reference
  member .strubpref   is ARRAY

  -- bedplate reference
  member .storebpref  is ARRAY

  -- graphical dimensions
  member .graphicaldim is BOOLEAN

  -- blocked icons
  member .blockedicons is STRING
  !this.blockedicons = '1,2,3,4,6,7,11,12,13,19,20,21,22,24,28,34,41,42,56,58,62'

  -- end form definition
exit

-- set background colour of pixmaps to white

!!mdsseticonback(!!mdsbr01,'white')

-- turn off blocked icons
!!kresetactive(!!mdsbr01,TRUE)

-- populate option gadgets
call !!mdsloadoption(!!mdsbr01.select)

--<dw>aug2008 dun979-repad addition options
call !!mdsloadoptiona(!!mdsbr01.type)

define method .mdsbrpadselect()

  --<dw>aug2008 dun955 - Navigate to atta
  !!ce = !this.support.atta[1]
  !desp  = despara
  --<dw>aug2008 dun955 - Upper case to allow for any format
  if !this.type.string().upcase() eq 'CIRCULAR PAD' then
    !dcirc  = 1
    !dsqua  = 0
    !dtype = 'b'
  else
    !dcirc  = 0
    !dsqua  = 1
    !dtype = 'c'
  endif

  --<dw>mar2009 DFN P-16885 DAC control added.
  !!mdsDacControl(TRUE)
  desp $!desp[1] $!desp[2] $!desp[3] $!desp[4] $!desp[5] $!desp[6] $!desp[7] $!desp[8] $!desp[9] $!dcirc $!dsqua $!dtype
  !!mdsDacControl(FALSE)
endmethod

define method .mdsbrpadcreate()

  --<dw>aug2008 dun955 - Navigate to atta
  !!ce = !this.support.atta[1]
  !desp  = despara
  if !this.rpad.val then
    !this.type.active  = TRUE
    !this.thick.active = TRUE
    !this.clear.active = TRUE
    !this.type.val  = 1
    !this.thick.val = 10
    !this.clear.val = 10
    !dclear = 10
    !dthick = 10
    !dcirc  = 1
    !dsqua  = 0
    !dtype  = 'b'
  else
    !this.type.active  = FALSE
    !this.thick.active = FALSE
    !this.clear.active = FALSE
    !this.thick.val = 0.00
    !this.clear.val = 0.00
    !dclear = 0
    !dthick = 0
    !dcirc  = 0
    !dsqua  = 0
    !dtype  = 'a'
  endif

  --<dw>mar2009 DFN P-16885 DAC control added.
  !!mdsDacControl(TRUE)
  desp $!desp[1] $!desp[2] $!desp[3] $!desp[4] $!desp[5] $!desp[6] $!desp[7] $!dclear $!dthick $!dcirc $!dsqua $!dtype
  !!mdsDacControl(FALSE)
endmethod

define method .mdsbrpadthick()

  --<dw>aug2008 dun955 - Navigate to atta
  !!ce = !this.support.atta[1]
  !desp   = despara
  !dthick = !this.thick.val

  --<dw>mar2009 DFN P-16885 DAC control added.
  !!mdsDacControl(TRUE)
  desp $!desp[1] $!desp[2] $!desp[3] $!desp[4] $!desp[5] $!desp[6] $!desp[7] $!desp[8] $!dthick $!desp[10] $!desp[11] $!desp[12]
  !!mdsDacControl(FALSE)
endmethod

define method .mdsbrpadclear()

  --<dw>aug2008 dun955 - Navigate to atta
  !!ce = !this.support.atta[1]
  !desp   = despara
  !dclear = !this.clear.val

  --<dw>mar2009 DFN P-16885 DAC control added.
  !!mdsDacControl(TRUE)
  desp $!desp[1] $!desp[2] $!desp[3] $!desp[4] $!desp[5] $!desp[6] $!desp[7] $!dclear $!desp[9] $!desp[10] $!desp[11] $!desp[12]
  !!mdsDacControl(FALSE)
endmethod
--<dw>mar2008 end of dun861

-- set the hiddencancel button to inactive
-- !this.hiddencancel.active = false
