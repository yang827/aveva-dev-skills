--
-- File:		Mdschecklen.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon Sept 22 1997
--
--
-- Description:
-- Form Definition for Frameworks to check the maximum lengths as defined in
-- the templates, checks if the maximum allowance between steelwork and pipe
-- has been exceeded
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsCheckLen

-- Define Form
Setup Form !!MdsCheckLen Blocking

  !!MdsCheckLen.formtitle    = |Support Integrity Check|
  !!MdsCheckLen.icontitle    = ||
  !!MdsCheckLen.Callback     = ||
  !!MdsCheckLen.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Support Name:|
    para .name at xmax+2 ymin width 20 lines 1
    para .Summary at x0 ymax+0.2 width 60 lines 1

    -- Create Datum
    -- frame .Check |Errors and Warnings| at x0 ymax
    frame .Check || at x0 ymax
      list   .ErrorList width 80 length 20
    exit

    button .Ok     |   OK   | at x1 ymax+0.5 Call |!!MdsCheckLen.Accept = true| OK
    button .Cancel | Cancel | at xmax.ErrorList-8 Ymin Call |!!MdsCheckLen.Accept = false| CANCEL

    -- object storage for acceptance
    member .Accept is BOOLEAN

exit

return

-- End form definition
