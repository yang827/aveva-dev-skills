--
-- File:		Mdscomm.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:
-- Form Definition for Adding a drawing comment for supports
-- This will be stored in the :MDSComment uda of the datum atta
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsComm

-- Define Form
Setup Form  !!MdsComm

  !!MdsComm.formtitle    = |Modify Drawing Comment|
  !!MdsComm.icontitle    = |Drwg Comment|
  !!MdsComm.callback     = |call !!MdsIComm()|
  !!MdsComm.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

    text .Name |Support Name | at x0.5 y0.5 Call |Call !!MdsCommSelect('NAME')| width 20 name

    frame .Option |Comment| at x0 ymax
      textpa  .Comment  at x0.5 y1 width 50 height 10
      !Dummy[1] = 'unset'
      !!MdsComm.Comment.val = !Dummy
      halign right
      path down
      button .Cursor | Identify By Cursor | Call |Call !!MdsCommSelect('CURSOR')|
      button .CE     | CE | at x0.5 Ymin Call |Call !!MdsCommSelect('CE')|

    exit

  -- Bottom Line
    button .Ok     | Apply | at x0 ymax+0.5         Call |Call !!MdsAcceptComm()|
    button .Cancel | Dismiss | at xmax form-size ymin cancel

  -- Form Members
    member .Support is STRING

-- End form definition
exit

-- End of file Mdscomm.frm
