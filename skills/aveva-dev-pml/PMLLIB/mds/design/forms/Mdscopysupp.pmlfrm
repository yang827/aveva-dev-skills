--
-- File:		Mdscopysupp.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:
-- Form Definition for copying a support
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsCopySupp

-- Define Form
Setup Form  !!MdsCopySupp

  !!MdsCopySupp.formtitle    = |Copy Support|
  !!MdsCopySupp.icontitle    = |Copy Support|
  !!MdsCopySupp.callback     = |call !!MdsICopySupp()|
  !!MdsCopySupp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

  frame .Frame |Copy Options| at x0 ymax
    text .Name     |Support Name | at x0.5 y1 Call |Call !!MdsSelectSupp('COPY', 'NAME','VERBOSE')| width 20 name
-- text .Name     |Support Name | at x0.5 y1 Call |Call !!MdsCopySelect('NAME')| width 20 name

    text .Nooff    |Number of copies              | at xmin ymax+0.1 width 3 integer

--xxx    text .Distance |Distance           | at xmin Ymax+0.1 width 14 isou
    text .Distance |Distance           | at xmin Ymax+0.1 width 14 is real format !!DistanceFmt

    path down
    halign right
    button .Cursor | Identify By Cursor | Call |Call !!MdsSelectSupp('COPY', 'CURSOR','VERBOSE')|
    button .CE     | CE | at x0.5 Ymin Call |Call !!MdsSelectSupp('COPY', 'CE','VERBOSE')|
    -- button .Cursor | Identify By Cursor | Call |Call !!MdsCopySelect('CURSOR')|
    -- button .CE     | CE | at x0.5 Ymin Call |Call !!MdsCopySelect('CE')|
  exit

  -- Bottom Line
    button .Ok     | Apply | at x0 ymax+0.5         Call |Call !!MdsMCopySupp(!!MdsCopySupp)|
    button .Cancel | Dismiss | at xmax form-size ymin Call |Call !!KActionCommands(!!MdsCopySupp.DismissForm)| cancel

  -- Form Members
    -- List of support members
    member .SupportMem   is ARRAY

    -- For Group Supports
    member .IsPartOfGroup is BOOLEAN
    member .ConnectedHangers is ARRAY

-- List of Structure(s) and Associated Atta(s) Names
    member .copynames    is ARRAY

    -- List of actions to be taken on dismissing form
    member .DismissForm  is ARRAY

-- End form definition
exit


  -- Populate option gadgets
    !!MdsCopySupp.DismissForm[1] = |UNENHANCE ALL|
    !!MdsCopySupp.DismissForm[2] = |!!MdsCopySupp.Name.val = 'unset'|
    !!Mdscopysupp.dismissform[3] = |!!Mdscopysupp.supportmem.clear()|
    !!Mdscopysupp.dismissform[4] = |!!Mdscopysupp.copynames.clear()|
    !!Mdscopysupp.IsPartOfGroup = FALSE

-- End of file Mdscopysupp.frm
