--
-- File:    Mdsdefaultsite.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FDEFSITE
--
-- Author:    I.Osborne
-- Created:   Tue Apr 29
--
--
-- Description:
-- Form Definition creating default site
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsDefaultSite

-- Define Form
--<wd>11oct2006 Form changed to NON BLOCKING
setup form !!mdsDefaultSite  $* blocking

  !!mdsDefaultSite.formtitle    = |Default Creation Zone|
  !!mdsDefaultSite.icontitle    = ||
  !!mdsDefaultSite.callback     = ||
  !!mdsDefaultSite.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    -- list .site call |call !!MdsUDfltSite()| width 28 length 5
    frame .tabsetZones TABSET anchor ALL wid 28 hei 8
     frame .tabSupp |Zone for Supports| at 0 0 dock FILL
      list .site width 28 length 8
     exit
     frame .tabHang |Zone for Hangers| at 0 0 dock FILL
      list .siteForHangers SINGLE ZEROSEL width 28 length 8
     exit
    exit

    path down
    vdist 0.1

    -- rgroup .Group

      -- add tag |Individual Site|
      -- add tag |Combined   Site|

    -- exit

    vdist 1

    button .ok |   OK   | call |Call !!mdsMakeDfltSite()| ok

    path right
    hdist 12

  -- Bottom Line
    button .cancel | Cancel | call |Call !!mdsCancelDflt()| cancel

-- End form definition
exit
