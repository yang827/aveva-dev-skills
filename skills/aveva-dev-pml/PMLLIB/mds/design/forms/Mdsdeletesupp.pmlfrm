--
-- File:  Mdsdeletesupp.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:          FDELALL
--
-- Author:  I.osborne
-- Created:  Wed May 14
--
--
-- Description:
-- Form Definition for Deleting supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  deleteRefsupp()                  -                   Deletes reference supports
--  mdsDeleteSupp()                  -                   Default Constructor
--  showForm()                       -
--

-- Kill existing form definition
kill !!mdsDeleteSupp

-- Define Form
setup form !!mdsDeleteSupp at xr 0.2 yr 0.2

  !!mdsDeleteSupp.formtitle    = |Delete Support|
  !!mdsDeleteSupp.icontitle    = ||
  !!mdsDeleteSupp.callback     = |!this.showForm()|
  !!mdsDeleteSupp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  frame .supportFrame 'Select Support'
    button .ce     |CE|  at xmin     ymin Call |Call !!mdsSelectSupp('DELETE', 'CE','VERBOSE')|
    text   .name         at xmax+.25 ymin Call |Call !!mdsSelectSupp('DELETE', 'NAME','VERBOSE')| width 20 name
    !!mdsDeleteSupp.name.val = 'unset'
    button .zoom  at xmin.ce ymax+.25 tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsDeleteSupp)|
    button .cursor |Identify By Cursor| at xmin.name ymin.zoom width 20 Call |Call !!mdsSelectSupp('DELETE', 'CURSOR','VERBOSE')|
    toggle .deleteRefsupp 'Delete Reference Supports' at xmin ymax+0.2 callback '!this.deleteRefsupp()'
  exit

  -- Bottom Line
  button .ok     |Apply|  at xmax form-10-size ymax+.25 width 8 Call |Call !!mdsDeleteSupp(!!mdsDeleteSupp,'VERBOSE')|
  button .cancel |Cancel| at xmax+1 ymin width 8 Call |Call !!kActionCommands(!!mdsDeleteSupp.dismissForm)| cancel

  -- Form Members
  -- List of support members
  member .supportMem   is ARRAY

  -- For Group Supports
  member .isPartOfGroup is BOOLEAN
  member .reNameHanger is BOOLEAN
  member .connectedHangers is ARRAY

  -- List of actions to be taken on dismissing form
  member .dismissForm  is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:
--
-- Description: default constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsDeleteSupp()

  !this.isPartOfGroup = FALSE
  !this.reNameHanger = FALSE
  !this.deleteRefsupp.val = true

  -- Populate option gadgets
  !this.dismissForm[1] = |UNENHANCE ALL|
  !this.dismissForm[2] = |!!mdsDeleteSupp.name.val = 'unset'|

  !this.zoom.addPixmap(!!PML.getPathName('zoomsupp.png'))
  handle any
  endhandle

endmethod
define method .showForm()

  -- if the current element is a support then activate it

  !!mdsSilent = TRUE
  !currentSupportName = !!mdsGetSuppName(!!ce)
  !!mdsSilent.delete()

  if !currentSupportName.neq('ABORT') then
    !this.name.val = !currentSupportName
    !!mdsSelectSupp('DELETE', 'NAME','VERBOSE')
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteRefsupp()

  if !this.deleteRefsupp.active then
    !!mdsSelectSupp('DELETE', 'NAME','VERBOSE')
  endif

endmethod
