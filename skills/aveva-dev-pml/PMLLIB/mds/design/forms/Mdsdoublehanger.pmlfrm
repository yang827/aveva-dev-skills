-- Kill existing form definition
Kill !!MdsDoubleHanger

-- Define Form
Setup Form !!MdsDoubleHanger
-- blockingdialog

  !!MdsDoubleHanger.formtitle    = |Double Hangers|
  !!MdsDoubleHanger.icontitle    = ||
  !!MdsDoubleHanger.callback     = ||
  !!MdsDoubleHanger.formrevision = | $Revision: 1 $ |

    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    vdist 0.2
    path down
    frame .filterFrame 'Hanger Connection types:' at XMIN FORM width 30
       paragraph .hangerNumber   at ymax+0.2 text 'Hanger number: 1'
       path down
       paragraph .filterByMsg   text 'Type: '
       path right
       hdist 1
       button .filt1 toggle tooltip 'Single Hanger connected to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.activateFilter(1,true,true)|
       button .filt2 toggle tooltip 'Single Hanger connected the top of a Double Channel Beam' pixmap width 18 height 18 call |!this.activateFilter(2,true,true)|
       button .filt3 toggle tooltip 'Single Hanger connected the top of a Double Channel Beam' pixmap width 18 height 18 call |!this.activateFilter(3,true,true)|
       button .filt4 toggle tooltip 'Single hanger connected to an offset Beam' pixmap width 18 height 18 call |!this.activateFilter(4,true,true)|
       button .filt5 toggle tooltip 'Single hanger connected to a Pipe' pixmap width 18 height 18 call |!this.activateFilter(5,true,true)|
    exit
    button .Ok     |   OK   | at xmin           ymax+0.5 call |!this.setFilter()|
    button .Cancel | Cancel | at xmax form-size ymin cancel

    member .oRadio  is MdstoggleButtonRadio

    member .activeFilterMode is String

    member .defaultFilterNumber is Real

    -- Save last activated filter
    member .lastActivatedFilter  is Real


    member .hangerCategory is String

    member .callingForm is Form
    -- Counter of hangers. Initialized to 0.
    member .hangerNo is Real

    -- Beam Array
    member .beamArrayRef is Array
-- End form definition
exit



!!MdsDoubleHanger.filt1.addPixmap(!!PML.getPathName('hfilt1.png'), !!PML.getPathName('hfilt1.png'), !!PML.getPathName('hfilt1.png'))
handle any
endhandle
!!MdsDoubleHanger.filt2.addPixmap(!!PML.getPathName('hfilt2.png'), !!PML.getPathName('hfilt2.png'), !!PML.getPathName('hfilt2.png'))
handle any
endhandle
!!MdsDoubleHanger.filt3.addPixmap(!!PML.getPathName('hfilt2.png'), !!PML.getPathName('hfilt2.png'), !!PML.getPathName('hfilt2.png'))
handle any
endhandle
!!MdsDoubleHanger.filt4.addPixmap(!!PML.getPathName('hfilt4.png'), !!PML.getPathName('hfilt4.png'), !!PML.getPathName('hfilt4.png'))
handle any
endhandle
!!MdsDoubleHanger.filt5.addPixmap(!!PML.getPathName('hfilt5.png'), !!PML.getPathName('hfilt5.png'), !!PML.getPathName('hfilt5.png'))
handle any
endhandle

define method .activateFilter(!clickButtonIndex is Real, !newTube is Boolean, !newBeam is Boolean)
  -- Simulates the radio buttons mechanism
  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this' + '.activateFilter($!clickButtonIndex is Real, $!newTube is Boolean, $!newBeam is is Boolean)')
  endif
  !this.oRadio.toggleRadioOn(!clickButtonIndex)

  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '$!this' + '.activateFilter($!clickButtonIndex is Real, $!newTube is Boolean, $!newBeam is is Boolean)')
  endif
endmethod

$(
define method .setFilter()

  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this.setFilter()')
  endif

  !groupNo = !this.oRadio.activeIndex

  -- filter by beam type. Do not refresh the list of availabel types.
  -- The hanger is a double hangers hanger.

  !this.callingForm.beamRef = Array()
  !this.hide()
  !this.callingForm.formHangerTypes.setFilterByBeam(!this.callingForm, !groupNo, false)
  handle 1
    -- user has exited by pressing the ESC key
    if(defined(!!MdsDEBUG)) then
      !!MdsDEBUG.trace(1, 'User has presses the ESC key')
    endif
    !!MdsFhanger.activateFilter(8,true,true)
    golabel /ERROR
  elsehandle any
     golabel /ERROR
  endhandle
  !this.beamArrayRef.appendArray(!this.callingForm.formHangerTypes.beamRef)
  if(!this.hangerNo lt 2) then
    !this.hangerNo = !this.hangerNo + 1
    !this.hangerNumber.val = 'Hanger number: ' + '$!this.hangerNo'
    !this.show()
  endif
  !size = !this.beamArrayRef.size()
  -- $P Size is: $!size
  !this.callingForm.beamRef = !this.beamArrayRef
  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '$!this.setFilter()')
  endif
  return
label /ERROR
  !this.callingForm.beamRef = Array()
  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceError('$!this.setFilter()')
  endif
  return error 1 '$!!ERROR.TEXT'
endmethod
$)

define method .setFilter()

  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '$!this' & '.setFilter()')
  endif

  !groupNo = !this.oRadio.activeIndex + 30

  -- filter by beam type. Do not refresh the list of availabel types.
  -- The hanger is a double hangers hanger.

  !this.hide()
  !this.callingForm.formHangerTypes.setFilterByBeam(!this.callingForm, !groupNo, false)
  handle 1
    -- user has exited by pressing the ESC key
    if(defined(!!MdsDEBUG)) then
      !!MdsDEBUG.trace(1, 'User has pressed the ESC key')
    endif
    !!MdsFhanger.activateFilter(8,true,true)
    golabel /ERROR
  elsehandle any
     golabel /ERROR
  endhandle

  !this.callingForm.beamRef = !this.callingForm.formHangerTypes.beamRef
  !size = !this.callingForm.beamRef.size()

  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '$!this' & '.setFilter()')
  endif
  return
label /ERROR
  !this.callingForm.beamRef = Array()
  if(defined(!!MdsDEBUG)) then
    !!MdsDEBUG.traceError('$!this' & '.setFilter()')
  endif
  return error 1 '$!!ERROR.TEXT'
endmethod



define method .resetFilter()
endmethod

define method .init()
  !this.hangerNo = 1
  !this.hangerNumber.val = 'Hanger number: ' + '$!this.hangerNo'
  !this.beamArrayRef = Array()
endmethod

define method .init(!callingForm is FORM)
  !this.init()
  !this.callingForm = !callingForm
  !this.name.val = !this.callingForm.name.val
endmethod
-- index of special filter buttons
!!MdsDoubleHanger.defaultFilterNumber = 1


-- Creating a MdstoggleButtonRadio object with a prefix name 'filt' and the default ON button set
-- !this.noFilterNumber. The default button will be pushed.
!!MdsDoubleHanger.oRadio = object MdstoggleButtonRadio(!!MdsDoubleHanger, 'filt', !!MdsDoubleHanger.defaultFilterNumber)
!!MdsDoubleHanger.oRadio.maxIndex = 5
--!this.lastActivatedFilter = !this.oRadio.defaultOn
!!MdsDoubleHanger.lastActivatedFilter = Real()
!!MdsDoubleHanger.oRadio.toggleDefaultRadioOn()



!!MdsDoubleHanger.hangerCategory = 'FH'

-- End of file MdsFHanger.frm
