-- Created:  Wed Jul 02
--
--
-- Description:
-- Form Definition for a dummy trunnion branch
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  flip()                           -
--  init()                           -
--

-- Kill existing form definition
Kill !!mdsdummy

-- Define Form
setup form  !!mdsdummy at xr0 yr0

  !!mdsdummy.formtitle    = |Create Trunnion Branch|
  !!mdsdummy.icontitle    = ||
  !!mdsdummy.callback     = ||
  !!mdsdummy.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  text .name       |Branch Name:  | call |call !!nameGadget(!!mdsdummy.name,'NEW')| width 20 name
  path down
  para .mainBore width 30 lines 1
  option .bores    |Trunnion Bore |       width 6
  text .branchDir  |Direction     |       width 14 name
  path right
  toggle .flip     |Flip| call |!!mdsdummy.flip()|
  path down
  text .length     |Length        | At x0 ymax+0.5 width 6 width 14 is REAL format !!distanceFmt
  text .distance   |Distance      | width 6 width 14 is REAL format !!distanceFmt
  option .material |Material      | width 20

  -- Bottom Line

  button .cancel  | Cancel | at xmax form-size ymax+0.5 cancel
  button .ok      |   OK   | at x0             ymin     call |!!mdsdummy.create()|

  -- End form definition

  -- Form members
  -- member to store identified element

  member .id is DBREF
  member .tee is DBREF
  member .bran is DBREF
  member .type is STRING

exit

-- Method to initialise the trunnion branch form

define method .init()

  -- Identify branch

  prompt off
  prompt load escape |Identify element to add trunnion branch to|
  id @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt dismiss
  prompt on

  -- The user can create a trunnion in a piece of tube or on an elbow
  -- The check should be
  -- Is the identified element an elbo
  -- Is there any tube, if not user wants to create at an elbow
  -- If there is then ask the user if it should by on tube or elbo
  --

  if !!ce.type.eq('ELBO') then
    var !spool const dist pl of ce to pa of next
    handle (2,113)
      var !spool const dist pl of ce to pt
    endhandle
    if !spool.real().eq(0) then
      !idType = 'ELBO'
    else
      if !!alert.confirm('Identified element is an elbow, do you want to create the trunnion branch on the elbow?').eq('YES') then
        !idType = 'ELBO'
      else
        !idType = 'TUBE'
      endif
    endif
  endif

  if undefined(!idType) then
    !idType = 'TUBE'
  endif

  -- If the user requires a trunnion at the elbo then it requires a p3
  if !idType.eq('ELBO') then
    !pPoints = ppls
    if !pPoints.findfirst(3).eq(3).not() then
      !!alert.error('Identified elbow does not contain ppoint 3, therefore unable to add a trunnion')
      return
    endif
  endif

  !this.type = '$!idType'

  -- If the elbo already has a cref then abort

  if !this.type.eq('ELBO') then
    if !!ce.cref.badref().not() then
      !!alert.error('Identified elbow already has a connection. Aborting trunnion creation')
      return
    endif
  endif

  -- Set form gadgets to default

  -- Name

  !this.name.val = 'unset'

  -- Bore
  -- Create tee and get all sprefs with skeys of TESO
  -- Find the bore of each tee and add to list gadget

  !this.id = !!ce

  new tee
  handle (41,8)
    !!alert.error('Identified element unsuitable for trunnion creation')
    return
  endhandle

  !tees = ARRAY()
  !availTees  = Select
  do !scan values !availTees
    if !scan.detref.skey.eq('TESO') then
      !tees.append(!scan)
    endif
  enddo

  !dtext = ARRAY()
  !rtext = ARRAY()
  do !addBore values !tees
    spref $!addBore
    !bore = p3 bore
    !dtext.append(!bore.string())
    !rtext.append(!addBore.string())
  enddo

  if !dtext.empty() then
    delete tee
    !!alert.error('Unable to select a set on tee to create a trunnion branch')
    return
  endif

  !this.bores.dtext = !dtext
  !this.bores.rtext = !rtext

  !mainBore = p1 bore
  !this.mainBore.val = 'Main Bore     ' & !mainBore.string()

  ori
  if !this.type.eq('ELBO') then
    !branchDir = p3dir of $!this.id
  else
    !branchDir = p3dir
  endif
  !this.branchDir.val = !branchDir.string().before(' WRT')
  !this.tee = !!ce
  delete tee

  !this.length.val = 0
  !this.distance.val = 0
  if !this.type.eq('ELBO') then
    !this.distance.active = false
    !this.branchDir.active = false
    !this.flip.active = true
  else
    !this.distance.active = true
    !this.branchDir.active = true
    !this.flip.active = false
  endif

  -- Matl
  !dtext = ARRAY()
  !rtext = ARRAY()
  var !specs coll all spec with purp eq 'PIPE'
  do !addSpecs values !specs
    !dtext.append(!addSpecs.dbref().name)
    !rtext.append(!addSpecs.dbref().name)
  enddo

  !this.material.dtext = !dtext
  !this.material.rtext = !rtext

  -- Try and set the material to the identified bran

  !branSpec = pspe of bran
  !specName = !branSpec.name
  !this.material.select('DTEXT','$!specName')

  !this.show()

endmethod

-- Method to create the dummy trunnion leg

define method .create()

  -- Check if name/length/distance have been set

  if !this.name.val.eq('unset') then
    !!alert.error('Name of branch has not been completed')
    return
  endif

  if !this.length.val.eq(0) then
    !!alert.error('Length of branch has not been completed')
    return
  endif

  if !this.type.eq('TUBE') then
    if !this.distance.val.eq(0) then
      --<wd>jan2001
      if (!this.id.detref.skey.neq('TESO')) then
        !!alert.error('Distance from the previous component is set to 0 (zero). Aborting the Trunnion Branch Creation')
        return
      else
        --      !!alert.error('Distance from previous component has not been completed')
        if (!!alert.confirm('Distance from the previous component is set to 0 (zero). Do you want to put this trunnion in the same position as the previous component') eq 'NO') then
          !!alert.warning('Aborting the Trunnion Branch Creation')
          return
        else
          -- Check Direction of Trunnion Branch is NOT the SAME as the Previous Trunnion branch at the SAME position
          if (!!alert.confirm('Is the Direction of the Trunnion Branch correct? Continue?') eq 'NO') then
            !!alert.warning('Aborting the Trunnion Branch Creation')
            return
          endif
        endif
      endif
    endif
    --<wd>jan2001
  endif

  -- Move to identified element and create trunnion

  !!ce = !this.id

  --<wd>jan2001
  -- Set Despar NUM 1 of ELBO and set the P3 bore of the ELBO
  -- to the the same as the TRUNNION bore.
  if (!this.type.eq('ELBO')) then
    !bore = !this.bores.selection('DTEXT')
    despar num1 $!bore
  endif
  --<wd>jan2001

  -- Select, position and direct tee

  if !this.type.eq('TUBE') then

    new tee
    !this.tee = !!ce
    !spref = !this.bores.selection('RTEXT')
    !distance = !this.distance.val
    !ori = !this.branchDir.val
    spref $!spref
    sel lstu
    dist $!distance
    ori and p3 is $!ori

  endif

  --<dw>aug2008 dun979 - flow direction turned off
  new bran flowdir OFF
  !branName = !this.name.val
  !branSpec = !this.material.selection('RTEXT')
  name $!branName
  if !this.type.eq('TUBE') then
    !teeName = !this.tee
  else
    !teeName = !this.id
  endif
  pspe $!branSpec
  conn ph to $!teeName
  pos pt at ph
  !hdir = hdir
  tdir $!hdir
  if !this.type.eq('ELBO') then
    !bore = !this.bores.selection('DTEXT')
    hbor $!bore
    tbor $!bore
  else
    !hbor = hbor
    tbor $!hbor
  endif
  sel hstu
  !hcon = hcon
  tcon $!hcon
  !length = !this.length.val
  move pt dist $!length
  var !tdir const dir pt to ph
  tdir $!tdir

  -- Create comment atta for drill hole note

  new atta sel
  handle any
    !!alert.error('Unable to create atta for drill hole note!')
    return
  endhandle

  atty ccnn
  --<wd>nov2002
  --stex 'DO NOT DRILL#/HOLE IN MAIN PIPE'
  stex 'DO NOT DRILL HOLE IN MAIN PIPE'
  --<wd>nov2002
  fconn

  bran

  -- Finally hide form

  !!mdsdummy.hide()

endmethod

-- Method to flip the elbo for a trunnion leg

define method .flip()

  -- Access elbo

  !!ce = !this.id
  !pa = pa dir
  !pl = pl dir
  flip
  ori pa is $!pa and pl is $!pl
  !branchDir = p3dir
  !this.branchDir.val = !branchDir.string().before(' WRT')

endmethod
