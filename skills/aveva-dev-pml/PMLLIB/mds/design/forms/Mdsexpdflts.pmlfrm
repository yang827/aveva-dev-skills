--
-- File:		Mdsexpdflts.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Aug 3rd 1998
--
--
-- Description:
-- Form Definition for updating a specific support types defaults
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsExpDflts

-- Define Form
setup form !!MdsExpDflts

  !!MdsExpDflts.formtitle    = |Dimension Defaults|
  !!MdsExpDflts.icontitle    = ||
  -- !!MdsExpDflts.callback     = |!!MdsReadExp()|
  !!MdsExpDflts.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    frame .Select |Dimensional Defaults|  at x0 ymax
      list .Catagory |Standard Support Type| call |call !!MdsReadExp()| width 27 length 11
      path right
      hdist 1
      list .Standard |Standard Name| call || multiple width 28 length 11
      button .All |Load all Defaults| at x0.5 ymax+0.1 call |call !!Mdsreloaddefs('RELOAD')|
      button .Apply |Load Selected Defaults| at xmin.standard ymin call |!!MdsReadPars('Partial Defaults Load','PARTIAL')|
    exit

    toggle .ViewStandard 'View Project Codes' at x1 Ymax+1 call '!!MdsReadExp()'


    frame .design |Design Dimensions| at x0 ymax+1
      para .Tdef at x0.5 y1 text |Set User Parameters to Default for Current Element    |
      button .Def |Process| at xmax+1 ymin call |!!MdsSetDespars(!!CE)|
      para .TUserDef at X0.5 y2 text |Set Non User Parameters to Default for Current Element|
      button .UserDef |Process| at xmax+1 ymin call |!!MdsSetNonUser(!!CE)|
      para .TMDBDef at x0.5 y3 text |Set Non User Parameters to Default for all supports   |
      button .MDBDef |Process| at xmax+1 ymin call |!!MdsSetNonMDB()|
    exit

    frame .messages |Session Log| at X0 ymax+1
      list .reports |Messages| width 59 length 10
    exit

  -- Bottom Line

    hdist 19

    button .Dismiss | Dismiss | at xmax.standard-9 ymax+1 call || cancel

-- End form definition
exit

-- Populate gadgets

  !Dtext = array()
  !Rtext = array()
  !Dtext.append('Ancillaries')
  !Rtext.append('AC')
  !Dtext.append('Anchors')
  !Rtext.append('AN')
  !Dtext.append('General')
  !Rtext.append('AT')
  !Dtext.append('Guides')
  !Rtext.append('GT')
  !Dtext.append('Lugs')
  !Rtext.append('LT')
  !Dtext.append('Slip Units')
  !Rtext.append('SU')
--> Added <ab> March 11 2002
  !Dtext.append('Fixed Hangers')
  !Rtext.append('FH')
  !Dtext.append('Variable Hangers')
  !Rtext.append('VH')
--< Added <ab> March 11 2002
  !Dtext.append('Springs')
  !Rtext.append('SP')
  !Dtext.append('Stops')
  !Rtext.append('ST')
  !Dtext.append('Trunnions')
  !Rtext.append('TT')
  !Dtext.append('Branch Reinforcements')
  !Rtext.append('BR')
  !Dtext.append('U-Bolts')
  !Rtext.append('BT')
  !Dtext.append('Cable Clips')
  !Rtext.append('CA')
  !Dtext.append('Vessel Supports')
  !Rtext.append('VT')

  !!MdsExpDflts.Catagory.Dtext = !Dtext
  !!MdsExpDflts.Catagory.Rtext = !Rtext

-- End of file Mdsexpdflts.frm
