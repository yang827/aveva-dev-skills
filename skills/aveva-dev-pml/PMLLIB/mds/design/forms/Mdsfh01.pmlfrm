--  cancelHanger(BOOLEAN)            -
--  changeChannelSpan(REAL)          -
--  changeRodSize(REAL)              -
--  delposBy(STRING,STRING,REAL)     STRING
--  getBeamHeight(DBREF)             REAL
--  getFittOffset(DBREF,STRING)      STRING
--  getMaxBeamHeight(DBREF)          REAL
--  getMiddleDelPos(DBREF,DBREF)     STRING
--  getPack(REAL,REAL)               ARRAY
--  getPackNum(REAL,REAL)            REAL
--  getSpringHeight(DBREF)           REAL
--  reconnect(BOOLEAN)               -
--  resizeHanger(DBREF,DBREF)        -
--  restoreHanger(BOOLEAN,BOOLEAN)   -
--  setGadgets()                     -
