                  elseif(!!mdsAllHangerTypes.eyeRodFixed.find(!alias).size().gt(0) or $
                    !!mdsAllHangerTypes.eyeRodVariable.find(!alias).size().gt(0) or $
                    !!mdsAllHangerTypes.riserClamp.find(!alias).size().gt(0) and !desc.eq('PIHASA Hanger Configurations') ) then
                    !rinb = prop RTVB of last hnut
                    handle ANY
                      !rinb = prop RTVB of last CLEVIS
                    endhandle
                  else
                    skip
                  endif
                else
                  !rinb = prop RTVB of next 4
                  handle ANY
                    !rinb = prop RTVB of LAST HNUT
                  endhandle
                endif
              endhandle
              --<<<-<wd>july2003
              break
            else
              skip
            endif
          enddo
        endif
        -- Navigate back to the HROD
        !!ce = !hrod
        --$p FIVE ***********************
        if (defined(!rina)) then
          -->>>-<wd>july2003
          -- desp $!rina $!rina
          --$P *** desp num 1 $!rina ***
          desp num 1 $!rina
        endif

        if (defined(!rinb)) then
          --$P *** desp num 2 $!rinb ***
          desp num 2 $!rinb
        endif
        --<<<-<wd>july2003
        --<<<-<wd>june2003
        ------------------------------------------------------------------------------------------------------------------------
      endif

      ---    Why are we not checking both heights ?????????????????????????????????????????????????????????????????

      --\\\||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||\\\\

      --$p  937 ?????????????????????????????????????????????????????????????????????????????????????????????????????????????
      --< tm bit to try and work out the new rod height
      if (defined(!rina) and defined(!rinb)) then
        !rodheight = !height + !rina.real() + !rinb.real()
      else
        !rodheight = !height + !!ce.despar[1] + !!ce.despar[2]
      endif

      -- q var !height
      -- $p !height
      -- q var !rodheight
      -- $p rodheight

      -- $p --<wd> VH88 -ERROR -- Investigation
      -- $p-------- wd -------- mdsfh01 -- line 1003
      -- q fullname
      -- q var !rodheight !height !rina !rinb
      -- q desp num 1
      -- q desp num 2
      -- $p-------- wd -------- mdsfh01 -- line 1008


      --< tm bit to try and work out the new rodheight
      !mdsMinHeight = :MDSMinHeight of catref
      !mdsMaxHeight = :MDSMaxHeight of catref

      --$P===============================
      --$P *** !rodheight is :-
      --q var !rodheight
      --$P===============================
      --$P ***  !mdsMinHeight is :-
      --q var !mdsMinHeight
      --$P===============================
      --$P ***  !mdsMaxHeight is :-
      --q var !mdsMaxHeight

      if(!rodheight.real() gt !mdsMaxHeight) then
        !!ce = !hangRef
        !!ce.hpos = !hposSaved
        !!ce.tpos = !tposSaved
        !!ce = !attaName.dbref()
        !errText = 'Beam and pipe are too far from each other. Rod required length $!rodheight is greater than $!mdsMaxHeight length allowed'
        !!kRestoreUnits(!currentunits)
        if(define(!!mdsDebug)) then
          !!mdsDebug.trace(1, !errText)
          !!mdsDebug.traceOut(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
        endif
        return error 9 '$!errText'
      endif
      if(!rodheight.real() lt !mdsMinHeight) then
        !!ce = !hangRef
        !!ce.hpos = !hposSaved
        !!ce.tpos = !tposSaved
        !!ce = !attaName.dbref()
        !errText = 'Beam and pipe are too close to each other. Rod required length $!rodheight is smaller than $!mdsMinHeight length allowed'
        !!kRestoreUnits(!currentunits)
        if(define(!!mdsDebug)) then
          !!mdsDebug.trace(1, !errText)
          !!mdsDebug.traceOut(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
        endif
        return error 9 '$!errText'
      endif

      --$p setting height to $!height at line 1160
      height $!height

      fconn
      --elseif((!alias inset$!!mdsAllHangerTypes.eyeRodFixed or $
      --  !alias inset$!!mdsAllHangerTypes.eyeRodVariable) and $
    elseif ((!!mdsAllHangerTypes.eyeRodFixed.find(!alias).size().gt(0) or $
      !!mdsAllHangerTypes.eyeRodVariable.find(!alias).size().gt(0)) and $
      !!ce.type.eq('EYRD') ) then

      var !curlength const dist pa to pl
      if !curlength.real() eq 0 then
        !curlength = !!ce.catref.:MDSMinHeight.string()
      endif
      height $!curlength
      --if(!alias inset$!!mdsAllHangerTypes.noRods) then
      if !!mdsAllHangerTypes.noRods.find(!alias).size().gt(0) then
        -- No middle connection. With a top connection
        --$P diff line 1688 $!diff
        if(!diff.nint() ne 0) then
          -- we need a to change eyrd height.
          -- First we try to change the eyebolt height
          !saveHeight = height
          !height = (!curlength.real() + !diff)
          --$p setting height to $!height at line 1170
          height $!height
          var !newCurlength const dist pa to pl
          if(!curlength.real() eq !newCurlength.real()) then
            -- rod length is fixed and can't be change.

            if(!diff.nint() gt 0) then
              -- if we need a longer eyerod we can try to "release" the thread
              -- minimum free thread length should be at least 1.5 times the eyebolt's diam
              -- to be used by the lock nut and the eye nut
              !rodDia = pa bore
              !minThread = 1.5 * !rodDia.real()
              !maxThread = para[4]
              if(!diff le (!maxThread - !minThread)) then
                -- "release" the thread by !diff
                !newThread = !maxThread - !diff
                desp num 1 $!newThread
              else
                -- Thread length is too short to adjust the difference
                golabel /EYERODERROR
              endif
            else
              -- if we need a sorter eyerod we can not try to "un-release" the thread
              -- Since it is already "un-release" to the maximum (using desp[1] equal to max thread length
              golabel /EYERODERROR
            endif
          else
            -- Restores the original height
            -- $p restoring height to $!saveHeight at .line 1199
            height $!saveHeight
            -- Rod length can be changed. We check that it is in the limit
            !mdsMinHeight = :MDSMinHeight of catref
            !mdsMaxHeight = :MDSMaxHeight of catref
            if(!height gt !mdsMaxHeight) then
              !!ce = !hangRef
              !!ce.hpos = !hposSaved
              !!ce.tpos = !tposSaved
              !!ce = !attaName.dbref()
              !errText = 'Beam and pipe are too far from each other. Rod required length $!height is greater than $!mdsMaxHeight length allowed'
              !!kRestoreUnits(!currentunits)
              if(define(!!mdsDebug)) then
                !!mdsDebug.trace(1, !errText)
                !!mdsDebug.traceOut(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
              endif
              return error 9 '$!errText'
            endif
            if(!height lt !mdsMinHeight) then
              !!ce = !hangRef
              !!ce.hpos = !hposSaved
              !!ce.tpos = !tposSaved
              !!ce = !attaName.dbref()
              !errText = 'Beam and pipe are too close to each other. Rod required length $!height is smaller than $!mdsMinHeight length allowed'
              !!kRestoreUnits(!currentunits)
              if(define(!!mdsDebug)) then
                !!mdsDebug.trace(1, !errText)
                !!mdsDebug.traceOut(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
              endif
              return error 9 '$!errText'
            endif
            --$p setting height to $!height at line 1228
            height $!height
          endif
        endif
      endif

      var !curlength const dist pa to pl
      --$p setting height to $!curlength at line 1237
      height $!curlength

      if(!!ce.order gt 3) then

        -- Eye rod is used as the top connection to the beam
        -- Hanger is connected to the beam through a Eye Rod and a Beam Attachment
        -- need to rotate the Eye Rod and the Beam Attachment to be with the long side along the beam
        var !plateDir pplin na of owner of $!newFittName y dir
        conn and p3 is $!plateDir
        handle ANY
        endhandle
      else
        -- Eye Rod is used as the bottom connection to the pipe
        conn
        handle ANY
          fconn
        endhandle
      endif
      --          elseif((!alias inset$!!mdsAllHangerTypes.clevisAndLugFixed or $
      --!alias inset$!!mdsAllHangerTypes.clevisAndLugVariable) and $
      --        !!ce.type.eq('CLEV') ) then
    elseif (!!mdsAllHangerTypes.clevisAndLugFixed.find(!alias).size().gt(0) and !!ce.type.eq('CLEV') ) then
      -- DTF 14.07.04 added 'and !!ce.type.eq('CLEV')' to line above because it skips an elseif
      -- below when type is neq CLEVIS , checked logic against sp1
      if !!ce.type.eq('CLEV') then
        if(!!ce.order gt 3) then
          -- Clevis is used as the top connection to the beam
          -- Hanger is connected to the beam through a clevis and lug
          -- need to rotate the clevis and lug to be with the long side along the beam
          var !plateDir pplin na of owner of $!newFittName y dir
          conn and p3 is $!plateDir
          handle ANY
          endhandle
        else
          -- Clevis is used as the bottom connection to the pipe lug
          conn
          handle ANY
            -- >>> pick up hbore as pml 1 var to sort it out
            VAR !hbore P1BORE
            HANG
            HBOR $!hbore
            SAME
            CONN
          endhandle

        endif
      endif
    elseif (!!mdsAllHangerTypes.clevisAndLugVariable.find(!alias).size().gt(0) and !!ce.type.eq('CLEV') ) then
      -- DTF 14.07.04 added 'and !!ce.type.eq('CLEV')' to line above because it skips an elseif
      -- below when type is neq CLEVIS , checked logic against sp1
      if !!ce.type.eq('CLEV') then
        if(!!ce.order gt 3) then
          -- Clevis is used as the top connection to the beam
          -- Hanger is connected to the beam through a clevis and lug
          -- need to rotate the clevis and lug to be with the long side along the beam
          var !plateDir pplin na of owner of $!newFittName y dir
          conn and p3 is $!plateDir
          handle ANY
          endhandle
        else
          -- Clevis is used as the bottom connection to the pipe lug
          conn
          handle ANY
            -- >>> pick up hbore as pml 1 var to sort it out
            VAR !hbore P1BORE
            HANG
            HBOR $!hbore
            SAME
            CONN
          endhandle
        endif
      endif
      --elseif((!alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionFixed or $
      --!alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionVariable) and $
    elseif ((!!mdsAllHangerTypes.doubleChannelRodConnectionFixed.find(!alias).size().gt(0) or $
      !!mdsAllHangerTypes.doubleChannelRodConnectionVariable.find(!alias).size().gt(0) ) and $
      !!ce.type.string() eq 'RCPL') then
      -- Hanger is connected to a double channel beam
      -- need to rotate the plate to be with the long side across the channels
      var !plateDir pplin na of owner of $!newFittName y dir
      conn and p3 is $!plateDir

    elseif(!!ce.type inset('VSPR','HELE')) then

      --if(!!ce.type inset('VSPR') and (!alias.upcase() inset$!!mdsAllHangerTypes.tS1Spring or

      --<wd>10jun2004 -- Extra Brackets added so that the code operates correctly
      --                 i.e. ENSURE type is 'VSPR' and any one of the SPRING TYPES (TS1, TS2 or TS3)
      if(!!ce.type inset('VSPR')) and $
        (!!mdsAllHangerTypes.tS1Spring.findFirst(!alias).set() or $
        !!mdsAllHangerTypes.tS3Spring.findFirst(!alias).set() or $
        !alias.upcase() inset$!!mdsAllHangerTypes.tS2Spring) then

        var !mdshanggroup :MDSHangGroup of /MDS/$!template

        if(!mdshanggroup neq '18' and !mdshanggroup neq '19') then
          var !plateDir pplin na of owner of $!newFittName y dir
          conn and p3 is $!plateDir
          --<wd>10jun2004
          handle ANY
            -- Unable to orientate VSPR 1 of HANGER -- P3 is UP in the PTSET of the VSPR
            conn
            ori and p2 is $!plateDir
            handle ANY
            endhandle
          endhandle
          --<wd>10jun2004
        endif

        handle ANY
          -- Grinnel spring does not have a p3 ppoint
          conn
          handle ANY
            return error 90 'Incompatible connections for $!!ce.name$n. Please check the template for $!alias'
          endhandle
        endhandle

      elseif(!!ce.type inset('VSPR') and (!alias.upcase() inset$!!mdsAllHangerTypes.eSSpring or $
        !alias.upcase() inset$!!mdsAllHangerTypes.tASpring)) then

        -- Spring is supported by double channel beam and is positioned on top of it
        var !plateDir pplin na of owner of $!newFittName x dir
        conn and p3 is $!plateDir
        handle ANY
          -- Grinnel spring does not have a p3 ppoint
          conn
          handle ANY
            return error 90 'Incompatible connections for $!!ce.name$n. Please check the template for $!alias'
          endhandle
        endhandle
      elseif(!alias.upcase() inset$!!mdsAllHangerTypes.dSSpring or $
        !alias.upcase() inset$!!mdsAllHangerTypes.channelAssembly) then
        -- Two Springs connected by a double channel beam. Pipe is ontop of the beam
        -- We set the parrive bore of the spring to be the same as the hanger hbore

        !bore = !!ce.owner.hbore.real()
        -- get the pipe NB para property definition

        !hm = object MDSHANGMEM(!!ce)
        -- gets an property definition array (e.g. {'DESP',1} or {'PARA',3} or {'HEIG'} or {'DATA'})
        !paras = !hm.getDataParaForDkey('PINB')

        if(!paras[1].eq('DESP')) then
          $!paras[1] num $!paras[2] $!bore
        elseif(!paras[1].neq('PARA')) then
          $!paras[1] $!bore
        endif

        -- desp num 30 $!bore
        -- Gets the outer bore of the tube.
        -- to set the position of the spring to be in the bottom of the pipe.
        --!pOutBore = !attaRef.lstub.para[2]
        -- Calculating the dist between the pipe CL and the bottom of the cradle/shoe
        !!mdsPushPin(1)

        pin1 copy p1 of $!attaRef
        pin1 dir d
        pin1 clea 0 behi $!attaRef

        --dtf >>> if trunnion used
        --!attaStype = styp of $!attaRef.name/SREF
        --if (!attaStype.substring(1,2) eq |TT| ) then
        --  var !vsprHeig |0|
        --else
        var !vsprHeig const dist p1 of $!attaRef to pin1
        --endif
        -- dtf <<< End of Mod
        !!mdsPoppin(1)
        -- !!ce.heigh = !pOutBore / 2
        !!ce.heigh = !vsprHeig.real()
        handle ANY
        endhandle
        !!ce.owner.hconn = 'ATT'
        conn and p2 is U
        handle ANY
          -- Grinnel
          conn
        endhandle
        --dtf mod to set the length of the VSPR here otherwise it goes wrong
        if !!mdsistubeparallel2sctn(!attaRef, !newFittRef.owner) then
          pin 5 copy p11 of $!attaRef
          pin 5 plane pin 5 thro $!newFittRef
          var !templength construct dist p0 of $!attaRef to pin 5
          !tlength = !templength.real() * 2
          desp num 8 $!tlength
          var !dist11to5 construct dist p11 of $!attaRef to pin 5
          var !dist10to5 construct dist p10 of $!attaRef to pin 5
          if  !dist10to5.real().gt(!dist11to5.real())  then
            end
            !hdir = !!ce.hdir.opposite()
            hdir $!hdir
            sam
            conn
            --rotate by 180
          endif
          var !lbore  lbore
          end
          pos ht at last mem
          tbore $!lbore
          sam
        endif
      elseif(!!ce.type inset('VSPR') and (!alias inset$!!mdsAllHangerTypes.bM1Spring or $
        !alias inset$!!mdsAllHangerTypes.bM2Spring)) then
        -- We set the parrive bore of the spring to be the same as the hanger hbore
        !bore = !!ce.owner.hbore.real()
        desp num 30 $!bore
        !!ce.owner.hconn = 'ATT'
        conn and p3 is pl of $!attaName
        handle ANY
          -- Grinnel spring does not have a p3 ppoint
          conn
          handle ANY
            -- problem with grinnel
            -- VH61 & VH62 have the same catref. Need to split into two catrefs
            -- This handle is for VH61 (B15)
            fconn
          endhandle
        endhandle

      elseif(!!ce.type inset('VSPR') and (!alias inset$!!mdsAllHangerTypes.doubleBM1Spring)) then

        -- We set the parrive bore of the spring to be zero

        desp num 30 0
        !!ce.owner.hconn = 'ATT'

        conn and p3 is p3 of $!attaName
        handle ANY
          -- Grinnel spring does not have a p3 ppoint
          conn
          handle ANY
            fconn
          endhandle
        endhandle
        -- move the spring horizontally away from the pipe.
        --Have a clearance of 100mm between the spring and the pipe
        if(!hangOrder eq 2) then
          -- Current hanger is connected to the ht of the first hanger
          -- Move the spring in a direction defined by the direction from hh to ht of hang1
          var !moveDirS const dir p18 of $!attaName to p19 of $!attaName
          !moveDir = object DIRECTION(!moveDirS)
          drag move $!moveDir dist -50 behi $!attaName
        elseif(!hangOrder eq 3) then
          -- Current hanger is connected to the hh of the first hanger
          -- Move the spring in a direction defined by the direction from ht to hh of hang1
          var !moveDirS const dir p19 of $!attaName to p18 of $!attaName
          !moveDir = object DIRECTION(!moveDirS)
          drag move $!moveDir dist -50 behi $!attaName
        endif

      else
        if (!!mdsAllHangerTypes.m5Constant.findFirst(!alias).set()  ) then
          -- dtf this needs to be y dir but then it goes wrong later and
          --no second beam is requested to be identified
          var !plateDir pplin na of owner of $!newFittName x dir
          handle ANY
            conn
          elsehandle NONE
            conn and p3 is $!plateDir
            handle ANY
              conn
            endhandle
          endhandle

        else

          var !plateDir pplin na of owner of $!newFittName x dir
          handle ANY
            conn
          elsehandle NONE
            conn and p3 is $!plateDir
            handle ANY
              conn
              handle ANY
              endhandle
            endhandle
          endhandle
        endif
      endif

      -- dtf. fix for dynamic Hangers for initec 14.4.04
      --elseif (!!ce.type inset('SLUG')  and ( !alias inset$!!mdsAllHangerTypes.eyeRodFixed )  ) then
    elseif (!!ce.type inset('SLUG') and !!mdsAllHangerTypes.eyeRodFixed.find(!alias).size().gt(0) and (!mdshanggroup.real() eq !!mdsAllHangerTypes.dynamicgroupno ) ) then
      if ( !i neq 1 ) then
        --No need if Slug is first only needed at end of hanger
        --and !!ce.owner.owner.number eq 17
        -- get :MDSHangGroup from template zone

        var !mdshanggroup :MDSHangGroup of /MDS/$!template
        if (!mdshanggroup.real() eq !!mdsAllHangerTypes.dynamicgroupno ) then
          pos pl at pt
          var !wdist const dist ph to pt
          --var !eXdist const dist pa to pL of prev
          VAR !oDist const dist pa to pL of prev PCLA
          handle (2,113)
            -- try slug because 1 mem may not be pipe clamp
            VAR !oDist const dist pa to pL of prev SLUG
          endhandle
          prev

          -- get min/max values of snub              --!minlength = ATTRIB RPRO WLEN
          !minlength = ( !!ce.catref.:MDSMinHeight + rpro THLA + rpro THLB )
          !maxlength = ( !!ce.catref.:MDSMaxHeight - rpro THLA - rpro THLB )
          -- check to see if dist is within range
          if (!oDist.real() lt !minlength) then
            !newDist = (!oDist.real() - rpro THLA - rpro THLB )
            return error 1 |Snub Size less than Snub min $!minlength, cannot be selected|
          elseif (!oDist.real() gt !maxlength) then
            !newDist = (!oDist.real() - rpro THLA - rpro THLB )
            return error 1 |Snub Size greater than Snub max $!maxlength, cannot be selected|
          else
            !newDist = (!oDist.real() - rpro THLA - rpro THLB )
          endif
          desp  $!newDist $!wdist
          SAM
        endif
      endif
    endif

    if(!!ce.type.string() eq 'PCLA') then
      if (!!mdsAllHangerTypes.riserClamp.find(!alias).size().gt(0)) then
        ori and p4 is p3 of $!attaRef
      else
        -- assures that the pipe clamp points u
        !pcla = !!ce
        !!ce = !attaName.dbref()
        var !udir DIR Z
        !!ce = !pcla
        ori and p4 is $!udir
        -- In case the pipe is in a slop, we need to move the pl of the clamp to be exactly below the steel fitting
        -- move pl along pa plan n thro ht

        --------------------------------------------------------------------------
        --<wd>14jun2004 - Plane Directions were INCORRECTLY HARD CODED to 'n' or 'e'
        -- The Plane direction MUST be CALCULATED each time to suit the LDIR of the Connecting Hanger ATTA

        --move pl along pa plan n thro ht
        --handle any
        --   move pl along pa plan e thro ht
        --endhandle

        -- Determine the Orthogonal PLEAVE Direction of the Hanger ATTA
        -- Create Point Vector Object
        !pvector = object POINTVECTOR()
        !pvector.position  = !attaName.dbref().lpos.wrt(/* )
        !pvector.direction = !attaName.dbref().ldir.wrt(/* )
        -- Convert to Line Object - 1000mm long
        !linobj = !pvector.line(1000)
        -- Create Plane Object
        !plnobj = object PLANE()
        !plnobj.orientation = y is n and z is u wrt /*
        !plnobj.position   = !attaName.dbref().lpos.wrt(/* )
        -- Project line onto plane to GET the Orthogonal Direction required
        !projlin = !linobj.projected(!plnobj)
        !orthdir = !projlin.direction()
        -- Move the PCLA Pleave Position Through the HANGER Tail in the CALCULATED $!orthdir direction
        move pl along pa plane $!orthdir thro ht
        --<wd>14jun2004
        --------------------------------------------------------------------------

        -- re-adjust the atta position
        !!ce = !attaName.dbref()
        -- move the atta thro the new pcla position
        thro $!pcla
        -- goto the hanger
        !!ce = !hangRef
        -- reconnect the hanger head to the atta
        conn hh to same
        var !actualDist const dist pl of 1 to ht
        -- var !actualDist const dist hh to ht
        -- var !actualDist const dist pl of 1 to pl of last mem
        -- var !actualDist const dist pl of 1 to pl of last mem
        --< tm change to avoid resetting the difference if the alias is FH08
        --q var !alias
        if (!alias inset('FH01','FH15','FH16','FH20','FH17','FH19','FH22','FH02','FH03','FH04','FH05','FH06','FH07','FH08','FH09','FH10','FH11','FH12','FH51','FH52','FH53','FH54') and !desc.neq('PIHASA Hanger Configurations')) then
          --$p not resetting diff
        else
          --$p resetting diff
          --!diff = (!actualDist.real() - !stdDist.real() )
          --$p diff is $!diff
        endif

        !!ce = !pcla
      endif
    endif

    next
    handle ANY
      break
    endhandle

  enddo

  ----------------------------------
  label /SKIPMEM
  -- Adjust the fitting location
  hang
  if(!alias inset$!!mdsAllHangerTypes.bM1Spring or $
    !alias inset$!!mdsAllHangerTypes.bM2Spring) then
    conn ht to last mem
  elseif(!hangOrder gt 1 and !alias inset$!!mdsAllHangerTypes.doubleBM1Spring) then
    conn ht to last mem
  endif

  --<wd>28sep2004 -- Switch OFF !!mdsDacControl - HPD0025942
  !!mdsDacControl(FALSE)

  !!kRestoreUnits(!currentunits)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
  endif
  if(!errNo gt 50) then
    if (!type neq 'SBFI') then
      -- error to be confirm and accepted by the user
      return error $!errNo |$!errText|
    endif
  endif
  return

  label /EYERODERROR
  !!ce = !hangRef
  !!ce.hpos = !hposSaved
  !!ce.tpos = !tposSaved
  !!ce = !attaName.dbref()

  if(define(!!mdsDebug)) then
    !!mdsDebug.traceError('$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
  endif
  !!kRestoreUnits(!currentunits)
  !stdDistI = !stdDist.real().nint()
  !actualDistI = !actualDist.real().nint()
  return error 9 'Hanger has a fixed height. Current hanger height is $!actualDistI$n. Required height should be $!stdDistI$n.'
endmethod

define method .delposBy(!delpos is STRING, !direction is STRING, !delta is REAL) is STRING

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !pos = !delpos.position()
  !npos = !pos.offset(!direction.direction(), !delta)
  !!kRestoreUnits(!currentunits)
  return 'E$!npos.east N$!npos.north U$!npos.up'

endmethod

define method .getFittOffset(!steelRef is DBREF, !hangType is STRING) is STRING

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  !!ce = !steelRef
  --!purpose = !!ce.gtype

  if (!!mdsAllHangerTypes.doubleChannelRodConnectionVariable.find(!hangType).size().gt(0) or $
    !!mdsAllHangerTypes.doubleChannelRodConnectionFixed.find(!hangType).size().gt(0) or $
    !hangType inset$!!mdsAllHangerTypes.tASpring or $
    !hangType inset$!!mdsAllHangerTypes.eSSpring) then

    var !offset PPLIN NA OFFSET FROM PPLIN LTOC wrt ce
    var !zdir PPLIN NA z dir

    !pos = object POSITION(!offset)
    !delpos = object POSITION()
    !delpos.origin = !pos.origin
    !delpos.east = !pos.east
    !delpos.up   = !pos.north
    if(!zdir.eq('U') or !zdir.eq('Z')) then
      !delpos.up = !delpos.up * -1
    endif

    !delpos.north = 0
    !offset = 'E$!delpos.east U$!delpos.up'

  else
    -- finds if web is horizontal
    -- get the direction which is orthogonal to web face
    var !xdir PPLIN NA x dir
    if(!xdir inset('U','D','Z','-Z')) then
      -- web is horizontal (not usual as the beam is weaker in this DIRECTION)
      var !offset PPLIN NA OFFSET FROM PPLIN IOC wrt ce
      handle ANY
        var !offset PPLIN NA OFFSET FROM PPLIN NAR wrt ce
        handle ANY
          var !offset PPLIN NA OFFSET FROM PPLIN RIGH wrt ce
          handle ANY
            !offset = 'E 0 N 0 D 0'
          endhandle
        endhandle
      endhandle
    else
      var !offset PPLIN BOC OFFSET FROM PPLIN NA
      handle ANY
        var !offset PPLIN BOS OFFSET FROM PPLIN NA
        handle ANY
          !offset = 'E 0 N 0 D 0'
        endhandle
      endhandle
    endif
  endif
  !!ce = !ce
  !!kRestoreUnits(!currentunits)
  return !offset

endmethod

define method .getMiddleDelPos(!firstFittRef is DBREF, !secondFittRef is DBREF) is STRING
  -- finds the middle point between a double channel
  -- and returns the delpos value for that point to position the fitting
  !currentunits = !!kgetsetunits()
  mm bore mm dist


  !!mdsPushPin(1)
  !!mdsPushPin(2)
  pin1 copy p1 of $!firstFittRef
  pin2 copy p1 of $!secondFittRef
  -- Find the back to back distance
  -- set pin2 orthogonal to the channel back (web)
  pin2 dir ppline FOC of owner of $!secondFittRef z dir
  var !dist const dist pin1 to plan pin2
  !semiOrthoDist = !dist.real() / 2
  var !delpos delpos  of $!secondFittRef
  !delpos = !this.delposBy(!delpos, 'E', !semiOrthoDist)

  -- dir pin2 to p1
  pin2 dir from pin2 to pin1
  var !dist const dist pin1 to plan pin2
  !semiDist = !dist.real() / 2
  -- position pin1 on the axis between the channels
  pin2 dist $!semiDist

  -- set the pin2 direction to be parallel to the beam axis
  pin2 dir ppline na of owner of $!secondFittRef y dir
  -- position pin1 at the start of the beam
  pin1 at ppline na of owner of $!secondFittRef start
  -- finds the new zdist needed to locate the fitting
  var !nzdist const dist pin1 to plan pin2
  var !zdist zdist  of $!secondFittRef
  !zdistDiff = !nzdist.real() - !zdist.real()
  !delpos = !this.delposBy(!delpos, 'N', !zdistDiff)
  !!mdsPoppin(1)
  !!mdsPoppin(2)

  !!kRestoreUnits(!currentunits)
  return !delpos
endmethod

define method .validRodChannels(!firstSctnRef is DBREF, !secondSctnRef is DBREF, !battenPlateRef is DBREF)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.validRodChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF, $!battenPlateRef is DBREF)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !this.validBasicChannels(!firstSctnRef, !secondSctnRef)
  handle ANY
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError('$!this' + '.validRodChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF, $!battenPlateRef is DBREF)')
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 '$!!error.text'
  endhandle
  -- Check distance between channels
  --  !!mdsPushPin(1)
  --  !!mdsPushPin(2)
  pin1 at ppline foc of $!firstSctnRef
  pin1 dir ppline foc of $!firstSctnRef z dir
  pin2 at ppline foc of $!secondSctnRef
  pin2 dir ppline foc of $!secondSctnRef z dir
  var !dist const dist pin1 to plan pin2
  !maxAllowedDist = !battenPlateRef.para[5]
  var !rodDia pa bore of $!battenPlateRef

  !rodDiaI = !rodDia.real()
  ---------  !rodDia = !battenPlateRef.para[4]
  --  !!mdsPoppin(1)
  --  !!mdsPoppin(2)
  !distI = !dist.real().nint()

  if(!distI gt !maxAllowedDist) then
    !err = 'The distance between the channels ($!distI) is too big. Allowed distance range is: $!rodDiaI - $!maxAllowedDist'
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError(!err)
    endif
    !!kRestoreUnits(!currentunits)
    return error 2 '$!err'
  endif
  if(!distI lt !rodDiaI) then
    !err = 'The distance between the channels ($!distI) is too small. Allowed distance range is: $!rodDiaI - $!maxAllowedDist'
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError(!err)
    endif
    !!kRestoreUnits(!currentunits)
    return error 3 '$!err'
  endif

  if(define(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.validRodChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF, $!battenPlateRef is DBREF)')
  endif
  !!kRestoreUnits(!currentunits)
  return TRUE

endmethod

define method .validBasicChannels(!firstSctnRef is DBREF, !secondSctnRef is DBREF)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.validBasicChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- valid channel must be parallel, back to back, and in allowed distance (dictated by the variable spring width)
  var !dirFirstS ppline foc of $!firstSctnRef z dir
  !dirFirst = object DIRECTION(!dirFirstS)
  var !dirSecondS ppline foc of $!secondSctnRef z dir
  !dirSecond = object DIRECTION(!dirSecondS)
  !dirOppositSecond = !dirSecond.opposite()
  !ang = !dirOppositSecond.angle(!dirFirst).abs()

  if(!ang gt 1) then
    -- The two channel are not in a back to back position
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError(1, 'Identified channels do not seems to be a double channel beam')
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Identified channels do not seems to be a double channel beam'
  endif
  -- Check that they have the same top level
  !!mdsPushPin(1)
  !!mdsPushPin(2)
  pin1 at $!firstSctnRef
  pin1 dir u
  --<GE> 08/02/07 Fix for Defect No:10226
  --pin1 clea 0 behind $!firstSctnRef
  --<GE> 08/02/07
  var !pos pin1 pos
  !firstjusl = !firstSctnRef.jusl
  !firstspref = !firstSctnRef.spref
  !firstnapos = !firstSctnRef.plst.nA.wrt( /* )
  !posi1 = object POSITION(!pos)
  pin2 at $!secondSctnRef
  pin2 dir u
  --<GE> 08/02/07 Fix for Defect No:10226
  --pin2 clea 0 behind $!secondSctnRef
  --<GE> 08/02/07
  var !pos pin2 pos
  !secondjusl = !secondSctnRef.jusl
  !secondspref = !secondSctnRef.spref
  !secondnapos = !secondSctnRef.plst.nA.wrt( /* )
  !posi2 = object POSITION(!pos)
  if (!firstjusl eq !secondjusl) then
    if(abs(!posi1.up - !posi2.up) gt 1) then
      -- two channels do not have the same top level
      -- The two channel are not in a back to back position
      !err = 'Identified channels do not have the same top level'
      if(define(!!mdsDebug)) then
        !!mdsDebug.trace(1, !err)
        !!mdsDebug.traceOut(1, '$!this' + '.validBasicChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF')
      endif
      !!kRestoreUnits(!currentunits)
      return error 2 '$!err'
    endif
  endif
  --<GE> 08/02/07 Fix for Defect No:10226
  if (!firstjusl neq !secondjusl) then
    if (!firstspref eq !secondspref) then
      if (!firstnapos.up neq !secondnapos.up) then
        -- two channels do not have the same top level
        -- The two channel are not in a back to back position
        !err = 'Identified channels do not have the same top level'
        if(define(!!mdsDebug)) then
          !!mdsDebug.trace(1, !err)
          !!mdsDebug.traceOut(1, '$!this' + '.validBasicChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF')
        endif
        !!kRestoreUnits(!currentunits)
        return error 2 '$!err'
      endif
    endif
  endif
  --<GE> 08/02/07
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.validBasicChannels($!firstSctnRef is DBREF, $!secondSctnRef is DBREF')
  endif
endmethod

define method .validSpringChannels(!firstSctnRef is DBREF, !secondSctnRef is DBREF, !variableSpringRef is DBREF)
  !this.validBasicChannels(!firstSctnRef, !secondSctnRef)
  handle ANY
    !!kRestoreUnits(!currentunits)
    return error 1 '$!!error.text'
  endhandle
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- Check distance between channels
  !!mdsPushPin(1)
  !!mdsPushPin(2)
  pin1 at ppline foc of $!firstSctnRef
  pin1 dir ppline foc of $!firstSctnRef z dir
  pin2 at ppline foc of $!secondSctnRef
  pin2 dir ppline foc of $!secondSctnRef z dir
  var !dist const dist pin1 to plan pin2
  !distI = !dist.real().nint()
  -- calculate allowed distance. Determined by the spring width and the rod dia
  -- calculate spring width
  -- in the spring's local E direction
  pin1 at $!variableSpringRef
  pin1 dir e wrt $!variableSpringRef
  pin1 clea 0 infr $!variableSpringRef
  pin2 copy pin1
  pin2 clea 0 behind $!variableSpringRef
  var !springWidthE const dist pin1 to pin2
  -- calculate spring width
  -- in the spring's local N direction
  pin1 at $!variableSpringRef
  pin1 dir n wrt $!variableSpringRef
  pin1 clea 0 infr $!variableSpringRef
  pin2 copy pin1
  pin2 clea 0 behind $!variableSpringRef
  var !springWidthN const dist pin1 to pin2
  !springWidth = min(!springWidthE.real() ,!springWidthN.real())
  !!mdsPoppin(1)
  !!mdsPoppin(2)
  !maxAllowedDist = !springWidth.real() * 0.5 $( Assuming that at least 25% of spring width is supported by each section$)
  var !rodDia pa bore of $!variableSpringRef
  !rodDiaI = !rodDia.real() + 2
  if(!distI gt !maxAllowedDist) then
    !!kRestoreUnits(!currentunits)
    return error 2 'The distance between the channels ($!distI) is too big. Allowed distance range is: $!rodDiaI - $!maxAllowedDist'
  endif
  if(!distI lt !rodDiaI) then
    !!kRestoreUnits(!currentunits)
    return error 3 'The distance between the channels ($!distI) is too small. Allowed distance range is: $!rodDiaI - $!maxAllowedDist'
  endif
  !!kRestoreUnits(!currentunits)
  return TRUE
endmethod

define method .validChannels(!bore is REAL, !firstSctnRef is DBREF, !secondSctnRef is DBREF)

  --<RM> 30/08/11 need to get the unqualified bore value here so that we can build up the appropriate string dbrefs without the mm or in qualifiers on the end - start
  !boreVal = !bore.value()
  --<RM> 30/08/11 need to get the unqualified bore value here so that we can build up the appropriate string dbrefs without the mm or in qualifiers on the end - end


  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.validChannels($!bore is REAL, $!firstSctnRef is DBREF, $!secondSctnRef is DBREF)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !alias =  !this.support.alias.upcase()
  -- Some templates have various sizes of hangers for the same pipe size
  -- we copy the proper restr using the suffix of the atta's styp where appropriate
  !suffix = ''
  if(!alias inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug) then
    !suffix = '/' + !this.support.rest.attaConnRef.styp.substring(-1,1)
    handle ANY
      !!kRestoreUnits(!currentunits)
      return error 1 'Unable to get suffix of the styp of the lug in $!this$n.validChannels.'
    endhandle
    !alphachars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    if(!alphachars.match(!suffix.after('/')) eq 0) then
      !!kRestoreUnits(!currentunits)
      --return error 1 'Invalid suffix: $!checksuffix of the styp of the lug in $!this$n.validChannels.'
      return error 1 'Invalid suffix'
    endif
  endif
  !template = !!mdsAllHangerTypes.getTemplateName(!alias)
  if(!alias inset$!!mdsAllHangerTypes.tASpring or $
    !alias inset$!!mdsAllHangerTypes.eSSpring ) then
    -- find the variable spring ref. This is used to validate the distance between the channels.
    !variableSpring = 'VSPR 1 of HANG 1 of REST /MDS/$!template/$!boreVal$!suffix'
    !variableSpringRef = !variableSpring.dbref()
    handle ANY
      !variableSpring = 'VSPR 1 of HANG 2 of REST /MDS/$!template/$!boreVal$!suffix'
      !variableSpringRef = !variableSpring.dbref()
      handle ANY
        !!kRestoreUnits(!currentunits)
        return error 1 'Unable to find $!variableSpring in $!this$n.validChannels. Please check the template'
      endhandle
    endhandle
    !this.validSpringChannels(!firstSctnRef , !secondSctnRef, !variableSpringRef)
    handle ANY
      !!kRestoreUnits(!currentunits)
      return error 1 '$!!error.text'
    endhandle
  else
    -- find the battenplate ref. This is used to validate the distance between the channels.
    !battenplate = 'RCPL 1 of HANG 1 of REST /MDS/$!template/$!boreVal$!suffix'
    !battenPlateRef = !battenplate.dbref()
    handle ANY
      -- Double hanger support
      !battenplate = 'RCPL 1 of HANG 2 of REST /MDS/$!template/$!boreVal$!suffix'
      !battenPlateRef = !battenplate.dbref()
      handle ANY
        !!kRestoreUnits(!currentunits)
        return error 1 'Unable to find $!battenplate in $!this$n.validChannels. Please check the template'
      endhandle
    endhandle
    !this.validRodChannels(!firstSctnRef , !secondSctnRef, !battenPlateRef)
    handle ANY
      !!kRestoreUnits(!currentunits)
      return error 1 '$!!error.text'
    endhandle
  endif
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.validChannels($!bore is REAL, $!firstSctnRef is DBREF, $!secondSctnRef is DBREF)')
  endif

endmethod

define method .getMaxBeamHeight(!hangRef is DBREF) is REAL
  -- Return the maximum of the a double channel beam
  -- Get the fitting through the atta and hanger tref
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !fittRef = !hangRef.tref
  -- Get the SCTN (Owner of the fitting)
  !firstBeam = !fittRef.owner
  --<GE> 08/02/07 Fix for Defect No: 10223
  handle ANY
    !namearray = !hangRef.name.split('/H1')
    !fittRefname = '/' & !namearray[2] & '/FITT/H1/1'
    !fittRef = !fittRefname.dbref()
    !attaName = '/' & !namearray[2]
    !hangRef.tref = !fittRefname.dbref()
    !hangRef.href =  !attaName.dbref()
    !firstBeam = !fittRef.owner
  endhandle
  --<GE> 08/02/07
  !firstHeight = !this.getBeamHeight(!firstBeam)
  -- Second SCTN is pointed by the fitting
  !secondBeam = !fittRef.:MDSConnect[1]
  handle ANY
    !!alert.error('Fitting does not have a reference to the second section')
    !!kRestoreUnits(!currentunits)
    return !firstHeight
  endhandle
  !secondHeight = !this.getBeamHeight(!secondBeam)
  !!kRestoreUnits(!currentunits)
  return max(!firstHeight, !secondHeight)
endmethod

define method .getBeamHeight(!beamRef is DBREF) is REAL
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  -- Return the beam height
  var !beamHeighS ppline TOS of $!beamRef offset from ppline BOS of $!beamRef
  handle ANY
    var !beamHeighS ppline LTOC of $!beamRef offset from ppline LBOC of $!beamRef
  endhandle
  !offsetPos = object POSITION(!beamHeighS)
  !beamHeigh = !offsetPos.up.abs()
  !!kRestoreUnits(!currentunits)
  return !beamHeigh
endmethod

define method .getSpringHeight(!hangRef is DBREF) is REAL
  -- Return the spring height
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  vspr1 of $!hangRef
  handle ANY
    !!kRestoreUnits(!currentunits)
    return 0
  endhandle
  --02/08/02  !styp = !hangRef.href.styp
  !styp = !this.support.rest.styp
  !springRef = !!ce
  if(!styp inset$!!mdsAllHangerTypes.tASpring or !styp inset$!!mdsAllHangerTypes.eSSpring) then
    !!mdsPushPin(1)
    pin1 at $!springRef
    pin1 dir u
    pin1 clea 0 infr $!!ce
    var !springHeighS const dist pin1 to pl of $!!ce
    !!mdsPoppin(1)
  else
    var !springHeighS const dist pa to pl of $!!ce
  endif
  !!kRestoreUnits(!currentunits)
  return !springHeighS .real()
endmethod

define method .setGadgets()
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !attaRef = !this.support.datum
  if(!attaRef.unset()) then
    !!alert.message('Hanger is not connected to a pipe attachment (ATTA)')
    golabel /CONTINUE
  endif

  !beamRefArray = !this.support.rest.beamRefArray

  if(!beamRefArray.unset() or !beamRefArray.size() eq 0) then
    if(!this.support.rest.styp inset$!!mdsAllHangerTypes.bM1Spring or $
      !this.support.rest.styp inset$!!mdsAllHangerTypes.bM2Spring or $
      !this.support.rest.styp inset$!!mdsAllHangerTypes.doubleBM1Spring ) then
    else
      if (!attaRef.cref.unset() or !attaRef.cref.tref.unset() or !attaRef.cref.tref.type neq 'SBFI') then
        !!alert.message('Hanger is not connected to a steelwork or civil fitting')
      endif
    endif
    golabel /CONTINUE
  endif
  -- Initialize number of connections
  !i = 0
  do !h indices !beamRefArray
    if(!beamRefArray[!h].set()) then
      !i = !i + 1
      !parallel[!i] = FALSE
      !parallel[!i] = !!mdsistubeparallel2sctn(!attaRef, !beamRefArray[!h] )
      if(not !parallel[!i]) then
        -- Beam supporting the hanger is not parallel to the tube
        -- Hanger can not moved along the tube using distance.
        -- removed dtf item 189
        !this.bdist.active = false
        !this.dist.active = false
        !this.bthro.active = false
        !this.select.active = false
      else
        !ce = !!ce
        !!ce = !attaRef
        var !dist const dist p0 to pl of prev
        handle ANY
          -- Atta is the first element in the branch
          var !dist const dist p0 to ph
        endhandle
        !this.bdist.active = TRUE
        !this.dist.active = TRUE
        !this.dist.val = !dist.real()
        !this.bthro.active = TRUE
        !this.select.active = TRUE
      endif
    endif
  enddo
  label /CONTINUE
  -- Icons Row 2
  !this.rotate.active = TRUE
  !this.rotAtt.active = TRUE

  -- Icons Row 3
  !this.modAtta.active = TRUE
  -- Icons Row 4
  !this.dim.active = TRUE
  !this.mdsadp.active = TRUE
  !this.zoom.active = TRUE
  --    !this.adploc.active = true
  -- Icons Row 5

  !!mdsFH01.rotate.active  = TRUE
  !!mdsFH01.rotAtt.active  = TRUE
  !!mdsFH01.modAtta.active = TRUE
  !!mdsFH01.viewStd.active = TRUE
  !!mdsFH01.dim.active     = TRUE

  if(!this.support.rest.styp inset$!!mdsAllHangerTypes.bM1Spring or !this.support.rest.styp inset$!!mdsAllHangerTypes.bM2Spring) then
    !this.reconnect.active = FALSE
  else
    !this.reconnect.active = TRUE
  endif
  !!kRestoreUnits(!currentunits)

endmethod

define method .cancelHanger(!userConfirm is BOOLEAN)

  if(define(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.cancelHanger($!userConfirm is BOOLEAN)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !this.setRestObject()

  !support = !this.support
  !datum = !support.datum

  if(!datum.unset()) then
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError('$!this' + '.cancelHanger($!userConfirm is BOOLEAN)')
    endif
    golabel /exit
  endif

  -- Test Decision if datum set
  if (!datum.badref().not() AND !userConfirm) then
    !confirmMsg = |Ok to cancel Support. This will DELETE the Support?|
    if (!this.support.preliminaryStore.set()) then
      !confirmMsg = |Ok to cancel Support. This will REVERT the Support back to the previous state.|
    endif

    if (!!alert.confirm(!confirmMsg) eq 'NO')then
      return
    endif
  endif

  !atta = !datum.name
  handle ANY
    golabel /exit
  endhandle

  --  Delete the temporary fittings

  !support = !this.support
  if(!support.rest.set()) then

    do !hangerNo indices !support.rest.hangers

      -- DAC's fix for HP0021504 GE 05/02/04
      !!mdsDacControl(TRUE)

      -- delete all temporarily created fittings
      !fittToDelete = '$!atta$n/FITT/H$!hangerNo'
      !!ce = !fittToDelete.dbref()
      handle ANY
      elsehandle NONE

        delete fitt
        handle ANY
          !!alert.error('Unable to delete $!fittToDelete')
        endhandle
      endhandle
      !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/FIRST'
      !!ce = !fittToDelete.dbref()
      handle ANY
      elsehandle NONE

        delete fitt
        handle ANY
          !!alert.error('Unable to delete $!fittToDelete')
        endhandle
      endhandle
      do !i
        !notFound = FALSE
        !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/$!i'
        !!ce = !fittToDelete.dbref()
        handle ANY
          !notFound = TRUE
        elsehandle NONE

          delete fitt
          handle ANY
            !!alert.error('Unable to delete $!fittToDelete')
          endhandle
        endhandle
        !fittToDelete = '$!atta$n/FITT/H$!hangerNo$n/$!i/FIRST'
        !!ce = !fittToDelete.dbref()
        handle ANY
          break if(!notFound)
        elsehandle NONE

          delete fitt
          handle ANY
            !!alert.error('Unable to delete $!fittToDelete')
          endhandle
        endhandle

      enddo
    enddo

    -- delete all CMPF fittings
    !fittToDelete = '$!atta$n/CMPF'
    !!ce = !fittToDelete.dbref()
    handle ANY
    elsehandle NONE

      delete cmpf
      handle ANY
        !!alert.error('Unable to delete $!fittToDelete')
      endhandle
    endhandle

    -- DAC's fix for HP0021504 GE 05/02/04
    !!mdsDacControl(FALSE)

  endif
  -- get the name of the current support
  !attaName = !support.rest.attaRef.name
  handle ANY
    -- No atta to delete
    golabel /exit
  endhandle

  -- Reset model representation if required
  call !!kActionCommands(!this.repre)

  if (!this.support.atta.empty().not())then
    !attaBran = !this.support.atta[1].owner
    do !i indices !this.support.atta
      !!ce = !this.support.atta[!i]
      handle ANY
        skip
      endhandle
      !ceAtta = !!ce
      !ceAttaName = !ceAtta.name

      !deleteList = ARRAY()
      !deleteList = !!mdsgethanglist(!ceAtta)
      if(!ceAttaName.eq(!attaName)) then
        --Delete atta only if has the same name as the restr prefix
        -- This is done to avoid deletion of welded elbow lug & trunion which are not
        -- a part of this support
        !deleteList.append(!ceAtta)

      endif

      if (!this.support.preliminaryStore.set()) then
        !deleteList.deleteFrom (!deleteList.findFirst (!this.support.datum), 1)
        --!datumAtta = !this.support.datum
        --!orig = !!ce

        !attaName = '/' & !this.name.val
        !attaRef = !attaName.dbref()
        handle ANY
        elsehandle NONE
          !!ce = !attaRef
          delete atta
        endhandle

        !actions = !this.support.preliminaryStore
        -- Loop through ACTIONS
        do !idxAction indices !actions
          !!mdsDacControl(true)
          $!actions[$!idxAction]
          handle any
            skip
          endhandle
        enddo
        --!!ce = !orig
      endif

      -- delete hanger and connected elements
      !!mdsdeletelist(!deleteList)
      -- delete original fitting if currently the hanger is not connected to it.
      do !!hangerNo indices !support.rest.hangers
        -- $!atta$n/FITT
        $!attaName/FITT/H$!hangerNo
        handle NONE
          delete fitt
        elsehandle ANY
        endhandle
      enddo
    enddo
    !!ce = !attaBran
  endif
  !!mdsDacControl(TRUE)
  -- delete the temporary rest if any
  $!attaName$n/REST/TEMP
  handle ANY
    -- no Temporary temp
  elsehandle NONE
    delete rest
  endhandle

  -- check if atta still exists
  !attaName = '/' & !this.name.val
  !attaRef = !attaName.dbref()
  handle ANY
  elsehandle NONE
    !!ce = !attaRef

    if (!this.support.preliminaryStore.set().not()) then
      delete atta
    endif

  endhandle
  label /exit
  !support.rest.restoreAccess()
  handle ANY
    !!alert.error('$!!error.text')
  endhandle

  --endif

  -- Unsetting the oldsupport member variable
  !this.oldSupport = object MDSSUPPORT()

  -- Unsetting the support member variable
  !this.support = object MDSSUPPORT()


  -- Clear passed form Gadgets
  call !!mdsClearGadgets(!this)

  -- If dimensions are displayed the clear them from the display

  !!mdsClearDim()

  -- Hide Form
  !this.hide()

  -- Reset Mdsfhanger
  !!mdsFHanger.manifactions()
  handle ANY
  endhandle

  !!kRestoreUnits(!currentunits)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.cancelHanger()')
  endif
  -- End function
endmethod
-----------------------------------------------------------------------------------

-- Define Function
define method .reconnect(!resize is BOOLEAN)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.reconnect($!resize is BOOLEAN)')
  endif

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables

  !support     = !this.support
  !datum       = !this.support.datum
  !name        = !this.name.val
  --------------------------------------------------------------------------------
  !attaName = !datum.name
  !oRest = !support.rest
  -- Empty the beamref array.
  -- This will force the application to prompt the user to identify new beams
  -- Save the current beamArray
  !beamRefArray = !oRest.beamRefArray

  !oRest.initBeamRef()

  -- Saves VSPR sprefs that may have changed using the .modifySpringType method
  -- of the !!mdsModFH form
  -- to be restored after reconnection
  var !springs collect all vspr for $!oRest.ref
  -- !evalindex is a special variable incremented automatically by PML
  !oEvalSpref = object BLOCK('!springs[!evalindex].dbref().spref')
  !oEvalLsrod = object BLOCK('!springs[!evalindex].dbref().lsrod')
  -- Process the block command on every spring element of the !springs array
  !sprefs = !springs.evaluate(!oEvalSpref)
  !lsrods = !springs.evaluate(!oEvalLsrod)

  !oRest.modify(!this, !!mdsFHanger)

  handle 99
    -- Restores the beam array
    !this.support.rest.beamRefArray = !beamRefArray
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  elsehandle ANY
    -- unknown error
    -- Restores the beam array
    !this.support.rest.beamRefArray = !beamRefArray
    !!alert.message(!!error.text)
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  endhandle

  -- restores VSPR sprefs
  !oRest = !this.support.rest
  var !newsprings collect all vspr for $!oRest.ref
  !oEvalSpref = object BLOCK('!newsprings[!evalindex].dbref().spref')
  -- Process the block command on every spring element of the !springs array
  !newsprefs = !newsprings.evaluate(!oEvalSpref)
  -- compare the spref of the new and old springs.
  -- If a spring's spref have changed, it mean that the user
  -- used the .changeSpringType method of the !!mdsModFH form
  -- so we will restore it.
  do !i indices !newsprefs
    !newSpre = !newsprefs[!i]
    !oldSpre = !sprefs[!i]
    !oldLsrod = !lsrods[!i]
    if(!newSpre eq !oldSpre) then
    else

      -- Spring has been changed
      -- Restores VSPR sprefs that may have changed using the .modifySpringType method
      -- goto rest
      !!ce = !newsprings[!i].dbref().owner.owner
      !hangers = mem
      !numOfHangs = !hangers.size()
      -- get order of hanger
      !order = order of owner of $!newsprings[$!i]
      if(!numOfHangs gt 1) then
        if(!this.support.rest.styp inset$!!mdsAllHangerTypes.dSSpring or $
          !this.support.rest.styp inset$!!mdsAllHangerTypes.channelAssembly) then
          -- spring is in the first hanger
          -- do not change !order
        else
          -- spring may be in the second or third hangers
          !order = !order - 1
        endif
      endif
      -- restore the old spref
      !!ce = !newsprings[!i].dbref()
      !!ce.spref = !oldSpre
      if(!oldLsrod.set())then
        !!ce.lsrod = !oldLsrod
      endif
      -- Initializes the modification form
      !!mdsIModFh(!this,!!mdsModFH, TRUE)

      -- adjust the hanger rods to the new spring size
      !!mdsModFH.modifySpringType(!order, FALSE)
      !!mdsModFH.cancel()
    endif
  enddo
  !this.setRestObject()
  -- Add marker text markers
  !!mdsaidtext(!this)

  !!ce = !datum
  -- Activate/Deactivate gadgets
  !this.datum.active = FALSE
  !this.setGadgets()
  --------------------------------------------------------------------------------

  label /exit
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.reconnect($!resize is BOOLEAN)')
  endif

  -- grinnel    return !secondFittRef
  !!mdsResetPins(1,2)
  return
  -- label /ERROR
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceError('$!this' + '.reconnect($!resize is BOOLEAN)')
  endif
  !!kRestoreUnits(!currentunits)
  !!mdsResetPins(1,2)
  return

  --$R0

endmethod

define method .restoreHanger(!showConfirm is BOOLEAN, !hideForm is BOOLEAN)

  if(define(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !usrSuppName = !this.support.rest.attaRef.name

  -- Test Decision
  if(!showConfirm) then
    if (!!alert.confirm(|Ok to cancel Support "$!usrSuppName". This will reset the support prior to modifying?|) eq 'NO')then
      !!kRestoreUnits(!currentunits)
      if(define(!!mdsDebug)) then
        !!mdsDebug.traceOut(1, 'No Restore in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
      endif
      return
    endif
  endif

  -- Saves the current support object before the restore state function overrides the support object with the oldsupport object
  !tempSupport = !this.support

  !!mdsRestorehangerstate(!this)

  -- Does datum exist yet

  if (!this.support.datum.unset()) then
    !!alert.message('Unable to restore hanger as no atta have been created')
    !!kRestoreUnits(!currentunits)
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError('Unable to restore hanger (No Atta) in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
    endif
    return
  elseif (!this.support.rest.ref.unset()) then
    !!alert.message('Unable to restore hanger. Reference to Original restraint is unset')
    !!kRestoreUnits(!currentunits)
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError('Unable to restore hanger. Reference to Original restraint is unset in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
    endif
    return
  endif

  !support = !this.support
  !datum = !support.datum
  !attaName = !datum.name
  !unusedhang = !datum.cref
  handle ANY
    !!alert.message('Unable to restore hanger as there is no hanger connected to the atta')
    !!kRestoreUnits(!currentunits)
    if(define(!!mdsDebug)) then
      !!mdsDebug.traceError('Unable to restore hanger (No Hanger) in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
    endif
    return
  endhandle

  !here = !!ce

  -- Put back the original tail position
  $!attaName/H1
  handle NONE
    tpos $!this.support.tposition
    handle ANY
    endhandle
  elsehandle ANY
  endhandle

  -- Put back atta if ot has been moved by slope
  $!attaName
  handle NONE
    thro ph of cref
  elsehandle ANY
  endhandle

  !!ce = !here

  !support.rest.reconnected = FALSE

  if(!tempSupport.rest.ref eq !support.rest.ref) then
    -- There is no temporary restr
    -- do nothing
    golabel /exit
  else
    -- There is a temporary rest
    -- we need to delete its fittings
    do !hangerNo indices !tempSupport.rest.hangers
      !oTempHang = !tempSupport.rest.hangers[!hangerNo]
      !oFitt = !oTempHang.fitt
      if(!oFitt.set()) then
        if(!oFitt.ref.set() and (not !oFitt.ref.badref()))then
          if(!oFitt.ref.type.eq('FITT')) then
            -- check if this fitting is not used by the original rest
            !flag = !support.rest.hangers[!hangerNo].fitt.set() and  !oFitt.ref.set() and (!support.rest.hangers[!hangerNo].fitt.ref neq !oFitt.ref)
            handle ANY
              skip
            endhandle
            if(!flag) then
              -- original rest is pointing to another fitting
              -- we can delete the temporary rest's fitting
              !!ce = !oFitt.ref
              !fittName = !!ce.name
              delete fitt
              if(define(!!mdsDebug)) then
                !!mdsDebug.trace(2, 'Deleted fitting $!fittName')
              endif
            endif
          endif
        endif
      endif
    enddo
    -- we need to delete the curr modified rest
    !oTempRest = !tempSupport.rest
    !!ce = !oTempRest.ref
    delete restr


    -- delete the temporary rest
    $!attaName$n/REST/TEMP
    handle ANY
      -- no Temporary temp
    elsehandle NONE
      delete rest
    endhandle

    !oOrigRest = !support.rest
    !!ce = !oOrigRest.ref
    handle ANY
      !!alert.message('Unable to restore hanger. Reference to Original restraint is unset. Original Rest name is $!attaName/BACKUP ')
      !!kRestoreUnits(!currentunits)
      if(define(!!mdsDebug)) then
        !!mdsDebug.traceError('Unable to restore hanger. Reference to Original restraint is unset in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
      endif
      return
    elsehandle NONE
      ren all $!attaName/BACKUP $!attaName
      name $!attaName$n/REST
    endhandle

    if(!oOrigRest.set() and !oOrigRest.new.set() and !oOrigRest.new and !hideForm) then
      -- newly created rest
      -- delete it
      !this.cancelHanger(FALSE)
    else
      if(!this.graphicalDim)then
        -- update the dimensions to the restored position
        !!mdsSetDim(!this)
        !!mdsSetDim(!this)
      endif
    endif
    if(define(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Deleted Restraint: $!attaName$n/REST and renamed $!attaName$n/REST/BACKUP to $!attaName$n/REST')
    endif
    -- Add the restr to the drawing list
    add ce
  endif

  label /exit


  -- Clear form gadgets
  --  Call !!mdsClearGadgets(!this)
  -- Reactivate cancel button on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.cancel.active = TRUE
  endif

  !!ce = !datum
  handle ANY
  endhandle

  if(!hideForm) then
    -- Hide the dimensions
    !!mdsClearDim()
    -- Hide forms
    if(!!mdsModFH.shown()) then
      !!mdsModFH.cancel()
    endif
    -- Unsetting the oldsupport member variable
    !this.oldSupport = object MDSSUPPORT()

    -- Unsetting the support member variable
    !this.support = object MDSSUPPORT()


    !this.hide()
  else
    if(undefined(!oOrigRest))then
      -- skipped to /EXIT label
      !oOrigRest = !support.rest
    endif
    -- update the rest object to be for the original rest
    !support = !this.setRestObject()

    !this.support = !support
    !this.support.rest.ref = !oOrigRest.ref
    -- update the rest packs for rotation to be for the original rest
    !this.setSupportPacks()

  endif

  -- If the support is a hanger then reset any values that may have changed and then clear the saved values

  if !attaName.dbref().styp.eq('MH01') then
    !!ce = !attaName.dbref()
    !!mdsSuppData.resetValues()
    same
  endif


  !!kRestoreUnits(!currentunits)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
  endif

endmethod

define method .accept(!callingForm is FORM)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '!!mdsAcceptfh01($!callingForm)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !support = !this.support

  -- Check that creation is complete

  if (not defined(!support.atta[1]))then
    !!alert.message('Support has to exist before creation can be ended')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- !attaRef = !support.rest.attaRef
  -- we take the name of the atta from the rest
  -- because there might be a difference between the connected atta
  -- (which can have a different name (e.g. welded elbow lug or trunion)
  -- and the atta associated with this support which have the same name.
  !attaName = !support.rest.ref.name.before('/REST')
  !fittName = !attaName + '/FITT'

  -- Update the object structure of the support.rest object
  !support = !this.setRestObject()

  -- Retrieve the oldfitting from the saved original support

  !oldSupport = !this.oldSupport
  !oOldRest = !oldSupport.rest
  !oldHangers = !oOldRest.hangers
  !support = !this.support
  !oRest = !support.rest
  !hangers = !oRest.hangers
  !!mdsDacControl(TRUE)

  -- Check to see if we need to delete old fittings by comparing the old references to the new ones

  do !hangerNo indices !oldHangers
    !oOldHang = !oldHangers[!hangerNo]
    if(!oOldHang.fitt.set()) then
      !oOldFitt = !oOldHang.fitt
      if(!oOldFitt.ref.set() and (not !oOldFitt.ref.badref()) and !oOldFitt.ref.type.eq('FITT'))then
        if(defined(!!mdsDebug)) then
          !!mdsDebug.trace(2, 'Found the old fitting $!oOldFitt.ref.name')
        endif
        !!ce = !oOldFitt.ref
        !sameFitting = TRUE
        !sameFitting = (!!ce eq !hangers[!hangerNo].fitt.ref)
        handle ANY
          -- Current rest does not have hanger no. $!hangerNo
          !sameFitting = FALSE
        endhandle
        if(not !sameFitting) then
          if(defined(!!mdsDebug)) then
            !!mdsDebug.trace(2, 'Deleting fitting $!oOldFitt.ref.name')
          endif
          !!mdsDacControl(TRUE)
          delete fitt
          !!mdsDacControl(FALSE)
        endif
      else
        -- handle next hanger fitting
        skip
      endif
    endif
  enddo

  -- Retrieve the existing new fitting from the current support

  !support = !this.support

  !oRest = !support.rest
  !hangers = !oRest.hangers
  do !hangerNo indices !hangers
    !oHang = !hangers[!hangerNo]
    !fittName = !attaName + '/FITT/H$!hangerNo'
    if(!oHang.fitt.set()) then
      !oFitt = !oHang.fitt
      if(!oFitt.ref.set() and (not !oFitt.ref.badref())  and !oFitt.ref.type.eq('FITT'))then
        if(defined(!!mdsDebug)) then
          !!mdsDebug.trace(2, 'Found the existing fitting $!oFitt.name for Hanger no. $!hangerNo')
        endif
        !!ce = !oFitt.ref
        handle ANY
          !!alert.error('No current fitting reference')
        elsehandle NONE
          if(!oFitt.name.neq(!fittName)) then
            -- rename the new fitting
            !!ce = !oFitt.ref
            !!ce.name = !fittName
            handle ANY
              -- Name already exist
              -- unnamed the existing one
              $!fittName
              unname
              !!ce = !oFitt.ref
              !!ce.name = !fittName
            endhandle
          endif
        endhandle
      endif
    endif
  enddo
  -- delete all temporarily created fittings
  do !hangerNo to 3
    do !i
      !firstBreak = FALSE
      !secondBreak = FALSE
      $!attaName$n/FITT/H$!hangerNo$n/$!i/FIRST
      handle ANY
        !firstBreak = TRUE
      elsehandle NONE
        if(defined(!!mdsDebug)) then
          !!mdsDebug.trace(2, 'Deleting fitting $!!ce.name')
        endif
        delete fitt
      endhandle
      $!attaName$n/FITT/H$!hangerNo$n/$!i
      handle ANY
        !secondBreak = TRUE
      elsehandle NONE
        if(defined(!!mdsDebug)) then
          !!mdsDebug.trace(2, 'Deleting fitting $!!ce.name')
        endif
        delete fitt
      endhandle
      if(!firstBreak and !secondBreak) then
        break
      endif
    enddo
  enddo

  -- delete the temporary rest
  $!attaName$n/REST/TEMP
  handle ANY
    -- no Temporary temp
  elsehandle NONE
    delete rest
  endhandle

  !datum = !attaName.dbref()

  $!attaName/REST/BACKUP
  handle ANY
    -- Hanger type was not changed
  elsehandle NONE
    -- Hanger type has changed
    delete restr mem
    copy att of $!attaName/REST
    do !i

      include hang 1 of $!attaName/REST
      handle ANY
        break
      endhandle
    enddo
    $!attaName/REST
    delete restr
    $!attaName/REST/BACKUP
    name $!attaName/REST
    if(defined(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Renaming Rest from $!attaName/REST/BACKUP to  name $!attaName/REST')
    endif
  endhandle

  if (!callingForm eq !!mdsFHanger) then
    -- Currently no check is made
    -- Reset the references to the tube and the beam/s
    !callingForm.tubeRef = object DBREF()
    !callingForm.beamRef = object ARRAY()
    if(defined(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Reset form ' + '$!callingForm'  + ' tube and beam references')
    endif
  endif


  -- re-lock previously locked atta
  !support.rest.restoreAccess()
  handle ANY
    !!alert.error('$!!error.text')
  endhandle

  !alias = !this.support.rest.styp
  !oHangerType = !!mdsAllHangerTypes.gethangertype(!alias)
  !group = !oHangerType.group


  if (!group eq 18) then
    $!attaName/SBFI/H2
    handle ANY
      -- no sbfi
    elsehandle NONE
      delete sbfi
      $!attaName/SBFI/H3
      delete sbfi
    endhandle
  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
  !!mdsVendor.support = !this.support

  call !!mdsClearGadgets(!this)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    handle (2,752)
    endhandle
    !!mdsModifySupp.cancel.active = TRUE
  endif
  -- Unsetting the oldsupport member variable
  !this.oldSupport = object MDSSUPPORT()
  !!ce = !support.datum
  -- Unsetting the support member variable
  !this.support = object MDSSUPPORT()

  -- Hide the dimensions
  !!mdsClearDim()
  -- Hide Form
  !this.hide()
  if(!!mdsModFH.shown()) then
    !!mdsModFH.cancel()
  endif
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '!!mdsAcceptfh01($!callingForm)')
  endif
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentunits)

endmethod

define method .changeRodSize(!newRodSize is REAL)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.changeRodSize($!newRodSize is REAL)')
  endif

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables

  !support     = !this.support
  !datum       = !this.support.datum
  !name        = !this.name.val
  --------------------------------------------------------------------------------
  !attaName = !datum.name
  !oRest = !support.rest
  -- Checks if required rod size is available in the catalog
  if(!!mdsModFH.allowedRodSizes.empty()) then
    -- To avoid re-creating of the list, we do it only if the list is empty
    !!mdsModFH.setAvailableRodSizes(!this)
  endif

  --   !availableSizes = !oRest.getAvailableReselectBores()
  !availableSizes = !!mdsModFH.allowedRodSizes
  handle ANY
    !!alert.message('$!!error.text')
    golabel /exit
  endhandle

  if(!availableSizes.findFirst(!newRodSize).unset()) then
    !!alert.message('$!newRodSize is not available for one or more of the hanger components')
    golabel /exit
  endif
  !oRest.newRodSize = !newRodSize
  !oRest.modify(!this, !!mdsFHanger)
  handle 99
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  elsehandle ANY
    -- unknown error
    !!alert.message(!!error.text)
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  endhandle
  !support = !this.setRestObject()
  !this.support = !support

  -- Add marker text markers
  !!mdsaidtext(!this)

  !!ce = !datum
  -- Activate/Deactivate gadgets
  !this.datum.active = FALSE
  !this.setGadgets()

  --------------------------------------------------------------------------------

  label /exit
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.changeRodSize($!newRodSize is REAL)')
  endif

  -- grinnel    return !secondFittRef
  return
  -- label /ERROR
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceError('$!this' + '.changeRodSize($!newRodSize is REAL)')
  endif
  !!kRestoreUnits(!currentunits)
  return

endmethod

define method .changeChannelSpan(!newChannelSpan is REAL)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.changeChannelSpan($!newChannelSpan is REAL)')
  endif

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- Initialise variables

  !support     = !this.support
  !datum       = !this.support.datum
  !name        = !this.name.val
  --------------------------------------------------------------------------------
  !oRest = !this.support.rest
  !newSpan = !newChannelSpan
  !oRest.newChannelSpan = !newSpan
  !oRest.changeChannelSpan(!newSpan, FALSE)
  handle 99
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  elsehandle ANY
    -- unknown error
    !!alert.message(!!error.text)
    -- don't show confirmation message
    -- don't hide forms
    !!mdsFH01.restoreHanger(FALSE, FALSE)
    golabel /exit
  endhandle
  !support = !this.setRestObject()
  !this.support = !support

  -- Add marker text markers
  !!mdsaidtext(!this)

  !!ce = !datum
  -- Activate/Deactivate gadgets
  !this.datum.active = FALSE
  !this.setGadgets()
  --------------------------------------------------------------------------------

  label /exit
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.changeChannelSpan($!newChannelSpan is REAL)')
  endif

  -- grinnel    return !secondFittRef
  return
  -- label /ERROR
  -- Reset Units
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceError('$!this' + '.changeChannelSpan($!newChannelSpan is REAL)')
  endif
  !!kRestoreUnits(!currentunits)
  return

endmethod

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFH01,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFH01,TRUE)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFH01.select)
