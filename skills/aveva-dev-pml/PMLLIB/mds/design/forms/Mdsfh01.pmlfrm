-- Kill existing form definition
Kill !!mdsFH01

-- Define Form
setup form  !!mdsFH01 at xr0 yr0 noquit

  !this.formtitle    = ||
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = | $Revision: 1.0 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |call !!mdsSetDatFH01(!this, 'CREATE',!this)|
    --<wd> .button .bdist | Distance | at xmin   ymax+0.25       Call |Call !!mdsPosDOnly(!this)|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!this)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    --<wd> button .bthro | Through |  at x1     ymax+0.2        Call |Call !!mdsPosTOnly(!this)|
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosthro(!this)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!this)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  frame .fMisc |Options| at x0 ymax width 31


    -- Icons Row 1

    button .addPipe  at x1       ymax tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call ||
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call ||
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call ||
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call ||


    -- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip  'Add Packer'         pixmap width 18 height 18 call ||
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Hanger Elements'   pixmap width 18 height 18 call |Call !!mdsIRotHanger(!this,'!!mdsRotateFh01(!!$!this, !!mdsRotHanger.angle.val, true)')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate a Hanger Element'     pixmap width 18 height 18 call |Call !!mdsIRotHanger(!this,'!!mdsRotateFh01(!!$!this, !!mdsRotHanger.angle.val, false)')|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call ||
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFH01,'ATTA')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call ||

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Hanger'     pixmap width 18 height 18 call |!!mdsIModFh(!this,!!mdsModFH, TRUE)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Hanger'     pixmap width 18 height 18 call ||
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call ||
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call ||
    button .setMat     at xmax+0.1 ymin tooltip 'Set Pad Material' pixmap width 18 height 18 Call |!!mdsSetMat(!!mdsFH01)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call ||
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Hanger Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!this)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!this,'INIT')|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!this)|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required' pixmap width 18 height 18 call ||
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call ||
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call ||
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call ||
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call ||
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call ||
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes' pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect  at xmax+0.1 ymin tooltip 'Reconnect to another beam' pixmap width 18 height 18 call |!this.reconnect(TRUE)|

    -- Icons Row 6
    button .flipatta  at x1 ymax+0.25  tooltip 'Flip'                     pixmap width 18 height 18 call ||
    button .suppdata  at xmax+0.1 ymin tooltip 'Data'                     pixmap width 18 height 18 call |!!mdsSuppData.init(!this)|
    -- button .editAtta  at xmax+0.1 ymin tooltip 'Modify Atta Properties'   pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip  at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec  at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .mtoc      at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .dynOffset at xmax+0.1 ymin tooltip 'Offset'                   pixmap width 18 height 18 call |!!mdsDynOffset.init(!this)|

    !desc = desc of /MDS/HANGERS
    handle (2,109)
    elsehandle NONE
      if !desc.eq('PIHASA Hanger Configurations') then
        button .clampmatl at xmax+0.1 ymin tooltip 'Pipe Clamp Material' pixmap width 18 height 18 call |!!mdsclampmatl.init(!this)|
      endif
    endhandle

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   |    at x0          ymin     call |!!callInf = FALSE !this.accept(!this)|
  -- button .ok1     |           | at xmax.ok+0.5 ymin     call |!!callInf = TRUE !this.accept(!this)|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Support object
  member .oldSupport     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING

  member .hangertypes is MDSHANGERTYPES

  -- list of plot files for this standard
  member .listofPlotfiles is ARRAY

  -- Parallel member
  member .parallel is BOOLEAN

  !this.hangertypes = object MDSHANGERTYPES()

  !this.blockedIcons = '1,2,3,4,6,7,9,10,11,12,13,15,19,20,21,22,23,24,26,27,29,30,31,32,34,36,37,38,41,42,58,62,63'

  --><wd>16jul2009 - DFN P-21516 (SI-12441)
  -- New FORM Members to Store the Constant Spring Full Name and the P10 direction WRt /* of the CONSTANT Spring before entering Witch Hanger
  member .constantNameOne is STRING
  member .constantDirectionOne is DIRECTION
  member .constantNameTwo is STRING
  member .constantDirectionTwo is DIRECTION
  --<<wd>16jul2009 - DFN P-21516 (SI-12441)

  -- End form definition
exit
-- Define Function

define method .setRestObject() is MDSSUPPORT
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this.setRestObject()')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !ce = !!ce
  !!ce = !this.support.rest.ref
  handle ANY
    -- Invalid reference
    return
  endhandle

  !oRest = !this.support.rest
  !oRest.setRestObject()
  !this.support.rest = !oRest

  !!ce = !ce

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this.setRestObject()')
  endif
  !!kRestoreUnits(!currentunits)
  return !this.support
endmethod

define method .setSupportPacks() is MDSSUPPORT
  return !this.support
endmethod

define method .getPackNum(!hangListNum is REAL, !order is REAL) is REAL
  -- Returns an index in the pack arrays of a pack in which a given component is contained.
  -- !hangListNum is the order of the hanger in the restr member list
  -- !order is the order of the component in the owner member list
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !oHangType = !!mdsAllHangerTypes.gethangertype(!this.support.rest.styp)


  !packs = !oHangType.packs[!hangListNum]

  do !i to !packs.size()
    !packMemString = !packs[!i]
    !packMem = !packMemString.split(',')
    if(!packMem.findFirst(STRING(!order)).set()) then
      !!kRestoreUnits(!currentunits)
      return !i
    endif
  enddo
  !!kRestoreUnits(!currentunits)
  return 0
endmethod

define method .getPack(!hangListNum is REAL, !packNo is REAL) is ARRAY
  -- Returns the pack array given the pack number.
  -- !hangListNum is the order of the hanger in the restr member list
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !oHangType = !!mdsAllHangerTypes.gethangertype(!this.support.rest.styp)

  --> 12/2002 <ab> to improve the loading time
  !oHangType.setRotDefinition()
  --< 12/2002 <ab> to improve the loading time

  !packs = !oHangType.packs[!hangListNum]
  !packMemString = !packs[!packNo]
  !packMems = ARRAY()
  handle ANY
    -- no such pack number
    !!kRestoreUnits(!currentunits)
    return !packMems
  endhandle
  !packMems = !packMemString.split(',').from(2)
  !!kRestoreUnits(!currentunits)
  return !packMems
endmethod

define method .resizeHanger(!hangRef is DBREF, !newFittRef is DBREF)
  if(define(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !desc = desc of /MDS/HANGERS

  aid clear line 5
  handle ANY
  endhandle
  !errNo = 0
  !!ce = !hangRef
  !hangOrder = !!ce.order
  !attaRef = !this.support.rest.attaConnRef
  !attaName = !attaRef.name
  handle ANY
    return error 1 'Unable to resize hanger. Hanger not connected to an Atta'
  endhandle
  !alias = !this.support.rest.styp
  !template = !!mdsAllHangerTypes.getTemplateName(!alias)
  !newFittName = !newFittRef.name
  handle ANY
    -- no fitting for bottom supported hangers
  endhandle

  -- standard length of hanger is measured from the pl of the pcla
  -- and not from the hanger head to eliminate the pipe slope influence on the length
  -- save  current hh and ht positions
  !hposSaved = hpos
  !tposSaved = tpos
  --var !stdDist const dist pl of 1 to ht
  var !stdDist const dist hh to pl of last mem
  handle (2,113)
    -- List exhausted
    -- hanger does not have members (eg. First hanger of doubleBM1Spring)
    var !stdDist const dist hh to ht
  endhandle

  -- $p ======line 429=======
  -- q fullname hpos wrt /* tpos wrt /*
  -- var !stdDist const dist hh to ht
  -- $p ======= !stdDist is $!stdDist at line 432 =========
  --q pl of last mem wrt /*
  --q ht wrt /*
  --$p ======line 435=======

  --<wd>28sep2004 -- Switch ON !!mdsDacControl - HPD0025942
  !!mdsDacControl(TRUE)

  -- ****************************************************************************************************
  -- set hhead for standard connections
  if((!alias inset$!!mdsAllHangerTypes.dSSpring or $
    !!mdsAllHangerTypes.riserClamp.find(!alias).size().gt(0) or $
    !alias inset$!!mdsAllHangerTypes.channelAssembly or $
    !alias inset$!!mdsAllHangerTypes.doubleBM1Spring) and !hangOrder gt 1) then

    -- !alias inset$!!mdsAllHangerTypes.riserClamp or
    --$P =============
    --q fullname hpos tpos

    var !stdDist const dist hh to ht

    --$P !stdDist is
    --q var !stdDist
    --$P =============

    !href = !!ce.href
    if(!href.unset()) then
      if(define(!!mdsDebug)) then
        !!mdsDebug.traceError('$!this' + '.resizeHanger($!hangRef is DBREF, $!newFittRef is DBREF)')
      endif
      !!kRestoreUnits(!currentunits)
      return error 1 |Href of $!!ce.name is unset. Please check template for $!template$n|
    endif
    if(!href.type.eq('HANG'))then
      if(!alias inset$!!mdsAllHangerTypes.doubleBM1Spring and !hangOrder eq 3) then
        conn hh to hh of $!href
      else
        -- dtf >>> 11.08.04
        -- changed because it connects hh to hh of hang 1 at 11.5
        -- which sets the datum atta cref to nulref - what a git!
        var !hrefname $!href.name
        conn hh to ht of $!hrefname
        --conn hh to ht of $!href
        --<<< dtf end of mod
      endif
    elseif(!href.type inset('VSPR','HELE'))then
      !oHang = object MDSHANGMEM(!href)
      !ppointNum = !oHang.getCrfaPPointNum()
      conn hh to p$!ppointNum of $!href
    elseif(!href.type inset('PCLA'))then
      -- we need to rotate the clamp so the bolts will be below the fitting
      -- goto pipe clamp
      !oHang = object MDSHANGMEM(!href)
      !ppointNum = !oHang.getCrfaPPointNum()

      conn hh to p$!ppointNum of $!href
    else
      conn hh to $!href
    endif
  elseif(!alias inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
    -- the hanger is connected to the tail of the trunnion branch (owner of $!attaName)
    -- Current name is $!!ce.name type is $!!ce.type
    -- the hanger is connected to the tail of the trunnion branch
    var !stdDist const dist hh to ht
    --< tm mod to connect hh to the single atta on the trunnion
    --    !plateName = !attaName.before('/SREF')
    --    q var !plateName
    --    q var !attaName
    --    q var !this.support
    --  conn hh to p3 of $!plateName
    conn hh to p3 of $!this.support.datum
    handle ANY
      -- error in connecting
      --<tm mod to get round the connection to a plate.
    endhandle
    --< end of tm mod
    -- elseif(!alias inset$!!mdsAllHangerTypes.riserClamp) then
  elseif !!mdsAllHangerTypes.riserClamp.find(!alias).size().gt(0) then
    --dtf >>> 28.09.04
    --conn hh to p5 of $!attaName
    -- the connect command at 11.5 unset the cref from the datum atta
    pos hh at p5 of $!attaName
    --<<< dtf End of Mod
    hbore  ( p1bore of $!attaName )
    hconn ATT
    TCONN FPIN
  elseif(!alias inset$!!mdsAllHangerTypes.bM2Spring) then
    -- this two springs configurations support the pipe from the bottom and are connect to a cradle
    conn hh to p8 of $!attaName
  elseif(!alias inset$!!mdsAllHangerTypes.doubleBM1Spring) then
    pos hh at p18 of $!attaName
  elseif(!alias inset$!!mdsAllHangerTypes.dSSpring or $
    !alias inset$!!mdsAllHangerTypes.channelAssembly) then
    -- set the CREF of the atta
    -- dtf >>> Mod to allow atta of trunnion to be connected
    if (!desc.eq('PIHASA Hanger Configurations') ) then
      --conn hh to p3 of $!attaName
      --q var !this.support.datum
      conn hh to p3 of $!this.support.datum
      pos hh to p3 of $!attaName
      handle (41,52)
        conn hh to p3 of $!this.support.datum
        pos hh at pl of $!this.support.datum
        !!ce.hdir = pl dir of $!this.support.datum
        !!ce.hbor = pa bore of $!this.support.datum

      elsehandle NONE
        pos hh at pl of $!attaName
        !!ce.hdir = pl dir of $!attaName
        --dtf >>> if trunnion used
        --!attaStype = styp of $!attaName/SREF
        --if (!attaStype.substring(1,2) eq |TT| ) then
        --  !!ce.hdir = p9 dir of $!this.support.datum
        --endif
        -- dtf <<< End of Mod
        !!ce.hbor = pa bore of $!attaName
      endhandle
    else
      conn hh to p3 of $!attaName
      pos hh at pl of $!attaName
      !!ce.hdir = pl dir of $!attaName
      !!ce.hbor = pa bore of $!attaName
    endif
    -- dtf <<< End of Mod
  elseif (!!mdsAllHangerTypes.m5Constant.find(!alias).size().gt(0) and !hangOrder eq 2 )  then
    --changed here because hang 2 does not connect to the atta but the  vspr of hang 1
    conn hh to p10 of vspr1 of prev hang
  elseif(!alias inset$!!mdsAllHangerTypes.bM1Spring and !desc.eq('PIHASA Hanger Configurations')) then
    -- dtf >>> Mod to allow atta of trunnion to be connected
    conn hh to p3 of $!attaName
    handle (41,52)
      conn hh to p3 of $!this.support.datum
    endhandle
    -- dtf <<< End of Mod
  else
    -- DACS fix for HP0021504 GE 03/02/04
    !!mdsDacControl(TRUE)
    conn hh to p3 of $!attaName
  endif
  -- end of hhead standard connections
  -- ***************************************************************************************************

  -- ***************************************************************************************************
  -- check to make sure that the hangers are vertical
  var !mdshanggroup :MDSHangGroup of /MDS/$!template
  handle ANY
  endhandle

  if(!hangOrder eq 1 and (!alias inset$!!mdsAllHangerTypes.dSSpring or $
    !!mdsAllHangerTypes.riserClamp.find(!alias).size().gt(0) or $
    !alias inset$!!mdsAllHangerTypes.channelAssembly)) then
    -- First hanger for a double spring or a riser clamp or a channel assembly is not connected directly
    -- to a fitting

    --elseif (!mdshanggroup.real() EQ !!mdsAllHangerTypes.dynamicgroupno ) then
    -- var !mdshanggroup :MDSHangGroup of /MDS/$!alias
    -- No need to check because the can be created at other angles


    -- !alias inset$!!mdsAllHangerTypes.riserClamp or
  elseif((not !alias inset$!!mdsAllHangerTypes.bM1Spring) and $
    (not !alias inset$!!mdsAllHangerTypes.bM2Spring) and $
    (not !alias inset$!!mdsAllHangerTypes.doubleBM1Spring)) then
    -- Bottom supported have no fitting connection.
    -- They should always be vertical

    $!newFittName
    !type = !!ce.type
    same
    --q name type
    var !hangDir const dir hh to p1 of $!newFittName
    if(define(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Hanger ($!hangRef) direction from hh to p1 of fitting $!newFittName')
      !!mdsDebug.trace(2, 'is $!hangDir')
    endif
    !!mdsPushPin(4)
    --q hh
    --q p0 of $!attaName


    pin4 at hh
    !startLine = hpos wrt world
    !endLine = p1 pos of $!newFittName wrt world
    aid line number 5 $!startLine to $!endLine linestyle dashed
    pin4 dir u
    pin4 through p1 of $!newFittName
    var !ang const ang pin4 to hh to p1 of $!newFittName
    if(define(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Hanger ($!hangRef) angle from vertical is $!ang')
    endif
    !!mdsPoppin(4)
    --!maxSlopeError = !!mdsOptions.maxPiva.real()
    --!maxSlopeWarning = !!mdsOptions.maxPwar.real()

    --><wd>12aug2009 -- DFN P-22111 (SI-13209) - Hanger Configuration Number added for TWIN HANGER types '31' and '32'
    --    if not !!mdsFHanger.confignumber.string() inset('7') then
    if not !!mdsFHanger.confignumber.string() inset('7','31','32') then
      --<<wd>12aug2009 -- DFN P-22111 (SI-13209) - Hanger Configuration Number added for TWIN HANGER types '31' and '32'
      if(!ang.real() gt 0.2) then
        if (!type neq 'SBFI') then
          -- restores hanger position
          !errText = 'Hanger is $!ang (Direction: $!hangDir) from the vertical direction. Hanger must be vertical'
        endif
        !!kRestoreUnits(!currentunits)
        !errNo = 51
      endif
    endif
  endif

  -- end of check to make sure the hanger is vertical

  --<tm mod to check if last member is positioned correctly at the tail
  !testerror = 0
  -- This bit is not needed for the interfaces

  pin 10 at ht
  pin 9 at pl of last mem
  handle (2,113)
    -- dm2spring has no members in hang 1
  elsehandle NONE
    var !pos9 pin 9 position
    !pos9up = !pos9.position().up
    var !pos10 pin 10 position
    !pos10up = !pos10.position().up
    !testerror = !pos10up - !pos9up
  endhandle
  pin9 off
  pin 10 off

  -- section for positioning fittings on double channel beams
  if(!!mdsAllHangerTypes.doubleChannelRodConnectionFixed.find(!alias).size().gt(0) or $
    !!mdsAllHangerTypes.doubleChannelRodConnectionVariable.find(!alias).size().gt(0) ) then
    --  !alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionVariable) then
    -- Hanger is connected to a double channel beam
    -- need to raise the fitting p3 connection point to allow space for the rod thread and two nuts.
    -- calculate the total length from bottom of rectangular washer to the top of the rod (hanger tail)
    var !nutsHeight const dist pa of rcpl1 to ht
    handle ANY
      -- it might be the first hanger of a double hanger rest
      -- The hanger does not have a rectangular plate (rcpl == washer)
    elsehandle NONE
