--
--
-- Description:
-- Form Definition for Fixed Hangers
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateAllFilter()              -                   Activate/deactivate ALL filter button depending on preliminary support chosen
--  activateFilter(REAL,BOOLEAN,BOOLEAN) -
--  apply()                          -
--  cancel()                         -
--  checkPrelim()                    BOOLEAN
--  fromExistingAtta()               -
--  manifActions()                   -
--  resetFilter()                    -
--  setFilter()                      -
--  setListActions()                 -
--  setToggle(STRING)                -
--  sitecheck(STRING)                -
--  testPreliminarySupportName()     BOOLEAN             Check if preliminary support name in name box.
--

-- Kill existing form definition
Kill !!mdsFHanger

-- Define Form
setup form !!mdsFHanger

  !!mdsFHanger.formtitle    = |Fixed Hangers|
  !!mdsFHanger.icontitle    = ||
  !!mdsFHanger.callback     = |call !!mdsIfhanger()|
  !!mdsFHanger.formrevision = | $Revision: 1.1.19.1 $ |

  bar
  !this.bar.add('Options','filterMode')
  !this.bar.add('Print','print')
  menu .filterMode
  exit
  menu .print
  exit
  !this.print.add('CALLBACK','Supports...','show !!mdsPrint')
  --    !this.filterMode.add('TOGGLE','Multi-Create','!this.oMenuRadio.toggle(1)')
  --    !this.filterMode.add('TOGGLE','Create and Modify','!this.setToggle(!this.createModifyMode)')
  --    !this.filterMode.add('TOGGLE','Create Once','!this.setToggle(!this.createOnlyMode)')


  -- Body of Form
  text .name     |Name :| at x0 y0.5 call |CALLIB NAMECHK _mdsFHanger_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
  call !!mdsSupportForm(!!mdsFHanger)
  call !!mdsSetSupp(!!mdsFHanger)
  !!mdsFHanger.activateAllFilter()| width 20 name

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsautoname|
  exit

  button .autoname | | tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsautoname.getNextName(!this)|
  !this.autoname.setPopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip '' pixmap width 19 height 19 call ||
  !this.set.active = FALSE

  button .addGroup   | | at xmax+1 ymin tooltip 'Add to Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('ADD',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|

  path right

  path down
  vdist 0.1

  !length = !!mdsFormFix
  handle NONE
  elsehandle ANY
    !length = '14'
  endhandle

  path down

  if !length.eq('1') then
    list .standard || at xmin_name ymax+0.5 call |!this.setListActions()| width 40 length $!length
  else
    list .standard |Standard support type:| at xmin_name ymax+0.5 call |!this.setListActions()| width 58 length $!length
  endif
  -- The global variable !!mdsHangIf should be set to MDS enabling the correct interface to use
  -- If not set default to MDS
  !unusedtestForInfVar = !!mdsHangIf
  handle ANY
    !!mdsHangIf = 'MDS'
  endhandle

  -- OK we have decided what interface set the members to tell to use set the active variables

  path down

  frame .filterFrame 'Filters' at XMIN FORM width 58
    paragraph .filterByMsg   at ymax+0.2 text 'Type:'
    path right
    hdist .75
    button .filt1 toggle tooltip 'Single Hanger connected to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.activateFilter(1,true,true)|
    button .filt2 toggle tooltip 'Single Hanger connected the top of a Double Channel Beam' pixmap width 18 height 18 call |!this.activateFilter(2,true,true)|
    button .filt31 toggle tooltip 'Two hangers connected to One/Two Beams' pixmap width 18 height 18 call |!this.activateFilter(31,true,true)|
    button .filt32 toggle tooltip 'Two hangers connected to One/Two Double Channel Beams' pixmap width 18 height 18 call |!this.activateFilter(32,true,true)|
    button .filt17 toggle tooltip 'Dynamic Hanger connected to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.activateFilter(17,TRUE,TRUE)|
    button .filt21 toggle tooltip 'Angulating Spring Supports to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.activateFilter(21,TRUE,TRUE)|
    hdist 2
    button .filt18 toggle tooltip 'Single Hanger connected to Civils' pixmap width 18 height 18 call |!this.activateFilter(18,true,true)|
    hdist .75
    button .filt19 toggle tooltip 'Two hangers connected to Civils' pixmap width 18 height 18 call |!this.activateFilter(19,true,true)|
    button .filt20 toggle tooltip 'Dynamic Hanger connected to Civils' pixmap width 18 height 18 call |!this.activateFilter(20,TRUE,TRUE)|
    button .filt25 toggle tooltip 'Angulating Spring Supports to Civils' pixmap width 18 height 18 call |!this.activateFilter(25,TRUE,TRUE)|
    hdist 2
    button .filt6 toggle tooltip 'Bottom of Pipe Supports to Steelwork' pixmap width 18 height 18 call |!this.activateFilter(6,true,true)|
    button .filt600 toggle tooltip 'Bottom of Pipe Spring Supports' pixmap width 18 height 18 call |!this.activateFilter(600,true,true)|
    hdist .75
    button .filt7 toggle tooltip 'Show all hanger types available for the selected pipe' pixmap width 18 height 18 call |!this.activateFilter(7,true,true)|
    button .filt8 toggle tooltip 'Show all fixed hanger types' pixmap width 18 height 18 call |!this.activateFilter(8,true,true)|

    -- button .filt33 toggle tooltip 'Two hangers connected to a Single Beam and to a Double Channel Beam' pixmap width 18 height 18 call |!!alert.message('Combined Double Hangers are not available at this release') !this.filt33.val = false|
    -- button .filt4 toggle tooltip 'Single hanger connected to an offset Beam' pixmap width 18 height 18 call |!!alert.message('Single hanger connected to an offset Beam is not available at this release') !this.filt4.val = false|
    -- button .filt5 toggle tooltip 'Single hanger connected to a Pipe' pixmap width 18 height 18 call |!!alert.message('Single hanger connected to a Pipe is not available at this release') !this.filt5.val = false|

    vdist 0.2
    frame .filterDataFrame 'Selection Data' at xmin.filterByMsg+0.1 ymax+0.4 width 56 height 1
      paragraph .filterData at xmin.filterByMsg+0.8 ymax text '                                                           '
    exit
  exit

  path down
  vdist 0.1

  -- Bottom Line

  button .ok     |   OK   | at xmin           ymax+0.5 call ||
  button .view   | View...| at xmax+1         ymin Call |call !!mdsAddPlot(!!mdsFHanger.standard, 'show',!!mdsFHanger)|
  button .viewC  | View Config...| at xmax+1  ymin Call |!!mdsHangView.init(!!mdsFHanger)|

  button .cancel | Cancel | at xmax form-size ymin call |!this.cancel()|

  -- Form Members

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Save suppFunction for later on list button
  member .oldFunction  is STRING

  -- fixed hanger types container
  member .formHangerTypes is MDSHANGERTYPES

  -- fixed filtered hanger types container
  member .filteredHangerTypes is MDSHANGERTYPES

  -- backup of the standard list dtext
  member .standardDtexBackup is ARRAY

  -- backup of the standard list rtext
  member .standardRtexBackup is ARRAY

  -- Index of the active filter. if zero (0) no active filter
  member .oRadio  is MDSTOGGLEBUTTONRADIO
  member .oMenuRadio is MDSMENUTOGGLERADIO

  -- Defines filter modes
  member .activeFilterMode is STRING

  -- filter numbers
  member .oneHangerSingleBeamFilterNumber is REAL
  member .oneHangerDoubleBeamFilterNumber is REAL
  member .doubleHangerSingleBeamFilterNumber is REAL
  member .doubleHangerDoubleBeamFilterNumber is REAL
  member .doubleHangerCompoundFilterNumber is REAL
  member .offsetHangerFilterNumber is REAL
  member .pipeHangerFilterNumber is REAL
  member .bottomSupportedFilterNumber is REAL
  member .bottomSupportedSpringFilterNumber is REAL
  member .dynamicFilterNumber is REAL
  member .anyFilterNumber is REAL
  member .civilPlateFilterNumber is REAL
  member .civilPlateDoubleFilterNumber is REAL
  member .noFilterNumber is REAL
  member .angulatingSpringsSteelFilterNumber is REAL
  member .angulatingSpringsCivilFilterNumber is REAL

  -- Support Manufacturers Interface
  member .configNumber is REAL
  member .tuberef is DBREF
  member .beamRef is ARRAY

  -- Save last activated filter
  member .lastActivatedFilter  is REAL

  -- Save last mode in which a filter has been activated
  member .lastActivatedToggle  is STRING
  member .lastActivatedTubeRef is DBREF
  member .lastActivatedBeamRef is ARRAY
  member .hangerCategory is STRING

  --<wd>03nov2006<mds12>
  -- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
  --<wd>03nov2006<mds12>
  -- End form definition
exit

