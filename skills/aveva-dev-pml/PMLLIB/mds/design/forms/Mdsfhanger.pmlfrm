-- Set icons
!!mdsSetIconBack(!!mdsFHanger,'white')

--<wd>03nov2006<mds12>
-- Set the DEFAULT settings for the form Members
!this.error = TRUE
!this.emess = 'No MDS Fixed Hangers available.'
--<wd>03nov2006<mds12>

--!this.formName = 'MdsFHANGER'

------------------------------------------------------------------------
--
-- Method:      testPreliminarySupportName
--
-- Description: Check if preliminary support name in name box.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------
define method .testPreliminarySupportName() is BOOLEAN

  -- check if support with given name exists already (can be preliminary support)
  !fromAtta = false
  if (!this.name.val.neq('unset')) then
    !datum = object DBREF('/' & !this.name.val)
    handle ANY
    elsehandle NONE
      !isPreliminarySupp = !!mdsaliaslist(!datum.:MDSSuppType).eq('PR01')
      handle ANY
      elsehandle NONE
        !fromAtta = !isPreliminarySupp
      endhandle
    endhandle
  endif
  return !fromAtta

endmethod
define method .setListActions()
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  if (!this.standard.val gt 0) then
    call !!mdsAddPlot(!this.standard, '',!this)
  endif
  call !!mdsSupportForm(!this)
  --if(!this.oldFunction.set() and !this.oldFunction.neq(||) ) then
  --    !this.ok.callback = !this.oldFunction
  --  endif
  if !!mdsHangView.shown() then
    !!mdsHangView.init(!this)
  endif
  !!kRestoreUnits(!currentunits)
endmethod

define method .sitecheck(!hangerCategory is STRING)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  --  !callback = !this.ok.callback
  !this.hangerCategory = !hangerCategory
  !!mdssitecheck(!this)
  --  !this.ok.callback = !callback
  !this.ok.callback = |!this.apply()|
  !!kRestoreUnits(!currentunits)
endmethod

define method .apply()

  !continue = !this.checkPrelim()
  if !continue.not() then
    return
  endif

  if(!this.name.val.upcase().eq('UNSET') or !this.name.val.eq('')) then
    !this.ok.active = FALSE
    !!alert.error('The Name of the Hanger is unset' )
    return error 1 noalert
  endif

  !unusedtest = !this.standard.rtext[!this.standard.val]
  handle ANY
    !!alert.message('List of hanger types is empty')
    return
  endhandle

  -- elsehandle NONE
  !this.configNumber = !this.oRadio.activeIndex

  if !this.filt17.val.boolean() then
    !this.configNumber = 7
  endif

  !this.oRadio.activeIndex = 8

  !!mdsifh01('', !this.name.val,!this.standard.rtext[!this.standard.val])

endmethod

define method .activateFilter(!clickButtonIndex is REAL, !newTube is BOOLEAN, !newBeam is BOOLEAN)

  -- Simulates the radio buttons mechanism
  if (defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1, '$!this' + '.activateFilter($!clickButtonIndex is REAL, $!newTube is BOOLEAN, $!newBeam is BOOLEAN)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  if(!newBeam) then
    if(!!mdsmodfh.shown())then
      -- we are in modify mode
      -- do not reset the beam ref
    else
      !this.beamRef = ARRAY()
    endif
  endif

  if(!newTube) then
    -- check if support with given name exists already (can be preliminary support)
    !fromAtta = !this.testPreliminarySupportName()
    if(!!mdsmodfh.shown() OR !fromAtta)then
      -- we are in modify mode
      -- do not reset the tube ref
    else
      !this.tuberef = object DBREF()
    endif
  endif

  !this.oRadio.toggleRadioOn(!clickButtonIndex)
  -- Save the filter state data to be able to restore it if an error occur when the filter is activated.

  !this.setFilter()
  handle any
    if(defined(!!mdsdebug)) then
      !!mdsdebug.trace(2, 'Restoring Filter button')
      !!mdsdebug.trace(2, 'Name field: ' + !this.name.val)
    endif
  endhandle

  -- activate/deactivate ALL filter on preliminary support active
  !this.activateAllFilter()

  if(!!mdsmodfh.shown())then
    -- modify mode
    -- we don't change the callback
  else
    -- Update the 'OK' button callback function of this FORM
    !!mdsSetSupp(!this)
  endif

  if(!this.name.val.neq('') and !this.name.val.upcase().neq('UNSET')) then
    if(defined(!!mdsdebug)) then
      !!mdsdebug.trace(2, 'Activating the OK button')
    endif
    !this.ok.active = true
  endif

  !!kRestoreUnits(!currentunits)

  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1, '$!this' + '.activateFilter($!clickButtonIndex is REAL, $!newTube is BOOLEAN, $!newBeam is BOOLEAN)')
  endif

  !prefix = 'VH'
  !!mdsHangerNum(!!mdsFHanger,!prefix)

endmethod

define method .setFilter()

  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1, '$!this.setFilter()')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !dtext = !this.standard.dtext
  !rtext = !this.standard.rtext

  !this.filterData.val = ''

  if(!this.oRadio.activeIndex eq 0) then
    -- No active filter
    -- clear list
    !this.standard.dtext = ARRAY()
    !this.standard.rtext = ARRAY()
  elseif(!this.oRadio.activeIndex eq !this.noFilterNumber) then
    -- No filter. Restore original list
    !this.resetFilter()
  elseif(!this.oRadio.activeIndex eq !this.anyFilterNumber) then
    -- 'ANY' filter is activated
    -- Filter by bore and insulation. Filter is activated on the complete available hanger type list (2nd parameter is true)
    !this.formHangerTypes.setFilterByPipe(!this, true)
    handle any
      golabel /ERROR
    endhandle
  else
    -- one of the other filters is activated
    -- filter by group number

    !groupNo = !this.oRadio.activeIndex
    !this.formHangerTypes.setFilterByGroup(!this, !groupNo, true)
    handle any
      golabel /ERROR
    endhandle

    if(!this.tuberef.set() and (not !this.tuberef.badref())) then

      !toUnEnhance = !this.tuberef

      unenhance bran of $!toUnEnhance
    endif

    -- filter by pipe bore and insulation
    !this.formHangerTypes.setFilterByPipe(!this, false)
    handle 1
      -- user has exited by pressing the ESC key
      if(defined(!!mdsdebug)) then
        !!mdsdebug.trace(1, 'User has presses the ESC key')
      endif
      !this.activateFilter(8,true,true)
      golabel /ERROR
    elsehandle any
      golabel /ERROR
    endhandle
    !this.tuberef = !this.formHangerTypes.tuberef


    if(!this.tuberef.set() and (not !this.tuberef.badref())) then
      !toEnhance = !this.tuberef
      enhance bran of $!toEnhance
    endif

    if(!groupNo.string().substring(1,1) eq '3') then
      -- This is a double hangers hanger.
      -- we can not filter it bu beam type because each member hanger
      -- can be of different type connection
      if(!this.beamRef.set()  and !this.beamRef.size() eq 4) then
        -- Beams connections are already set
      else
        -- Beams connections not set
        loadform !!mdsdoublehanger
        !!mdsdoublehanger.init(!this)
        !subGroup = !groupNo.string().substring(2,1).real()

        if(!subGroup leq 2) then
          !!mdsdoublehanger.activateFilter(!subGroup,true,true)
          !!mdsdoublehanger.setFilter()
          !beamRef = !this.beamRef
          !this.beamRef = ARRAY()
          !!mdsdoublehanger.activateFilter(!subGroup,true,true)
          !!mdsdoublehanger.setFilter()
          !beamRef.appendArray(!this.beamRef)
          !this.beamRef = !beamRef
        elseif(!subGroup eq 3) then
          !!mdsdoublehanger.activateFilter(1,true,true)
          !!mdsdoublehanger.setFilter()
          !beamRef = !this.beamRef
          !this.beamRef = ARRAY()
          !!mdsdoublehanger.activateFilter(2,true,true)
          !!mdsdoublehanger.setFilter()
          !beamRef.appendArray(!this.beamRef)
          !this.beamRef = !beamRef
        endif
      endif

    elseif (!this.oRadio.activeIndex.eq(!this.bottomSupportedFilterNumber).not() and !this.oRadio.activeIndex.eq(!this.bottomSupportedSpringFilterNumber).not()) then
      -- if pipe is supported from the bottom
      -- there is no need for steelwork beam connection
      -- filter by beam type
      if(!this.beamRef.set() and !this.beamRef.size() gt 0) then
        -- un enhance previous beams
        do !beamToUnEnhance values !this.beamRef
          if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
            unenhance $!beamToUnEnhance
          endif
        enddo
      endif
      !this.formHangerTypes.setFilterByBeam(!this, !groupNo, false)
      handle 1
        -- user has exited by pressing the ESC key
        if(defined(!!mdsdebug)) then
          !!mdsdebug.trace(1, 'User has presses the ESC key')
        endif
        !this.activateFilter(8,true,true)
        golabel /ERROR
      elsehandle any
        golabel /ERROR
      endhandle
      !this.beamRef = !this.formHangerTypes.beamRef
      if(!this.beamRef.set() and !this.beamRef.size() gt 0) then
        -- un enhance previous beams
        do !beamToUnEnhance values !this.beamRef
          if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
            enhance $!beamToUnEnhance
          endif
        enddo
      endif
    endif
  endif
  !select = !this.standard.rtext[1]
  handle any
  elsehandle none
    !this.standard.select('rtext', !select)
  endhandle
  !select = !this.standard.rtext[1]
  handle any
  elsehandle none
    !this.standard.select('rtext', !select)
  endhandle
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1, '$!this.setFilter()')
  endif
  return
  label /ERROR
  --<sk> do not clear tube on preliminary support selected - even on ERROR
  !fromAtta = !this.testPreliminarySupportName()
  if (!fromAtta.not()) then
    !this.tuberef = object DBREF()
  endif
  !this.beamRef = ARRAY()
  !this.standard.dtext = !dtext
  !this.standard.rtext = !rtext
  !select = !this.standard.rtext[1]
  handle any
  elsehandle none
    !this.standard.select('rtext', !select)
  endhandle
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceError('$!this.setFilter()')
  endif
  return error 1 '$!!error.text'
endmethod

define method .resetFilter()
  !this.standard.dtext = !this.standardDtexBackup
  !this.standard.rtext = !this.standardRtexBackup
  !select = !this.standard.rtext[1]
  handle any
  elsehandle none
    !this.standard.select('rtext', !select)
  endhandle
  !this.filterData.val = 'No Filter'

  unenhance all

endmethod

define method .setToggle(!toggleDtex is STRING)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1, '$!this' + '.setToggle($!toggleDtex is STRING)')
  endif
  !currentunits = !!kgetsetunits()

  mm bore mm dist

  !this.beamRef = ARRAY()
  --<sk> do not clear tube on preliminary support selected
  !fromAtta = !this.testPreliminarySupportName()
  if (!fromAtta.not()) then
    !this.tuberef = object DBREF()
  endif
  if(!this.lastActivatedToggle.set() and !this.lastActivatedToggle.eq(!toggleDtex))then
    -- User has re-selected a mode that was last activated (e.g. Last hanger was created in this mode)
    if(!this.lastActivatedFilter.set() and (!this.oRadio.activeIndex neq !this.lastActivatedFilter)) then
      -- Current filter is different from the one that was last activated for that mode
      -- Reactivated the last activated filter for that mode
      --      !this.tuberef = !this.lastActivatedTubeRef
      --      !this.beamRef = !this.lastActivatedBeamRef
      !this.activateFilter(!this.lastActivatedFilter, false, false)
    else
      -- Current filter is the same that was used on this mode
      -- do nothing
      --      !this.activateFilter(!this.oRadio.defaultOn)
    endif
    -- !this.lastActivatedFilter = REAL()
    --    !this.ok.active = true
  else
    if (!fromAtta) then
      !this.activateFilter(7, false, false)
    elseif(!this.lastActivatedFilter.unset())then
      --      !this.lastActivatedFilter = !this.oRadio.activeIndex
    else
      -- Activate the 'ALL' filter
      !this.activateFilter(!this.oRadio.defaultOn, true, true)
    endif


  endif
  if(!this.name.val.upcase().eq('UNSET') or !this.name.val.eq('')) then
    !this.ok.active = false
  else
    !this.ok.active = true
  endif

  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1, '$!this' + '.setToggle($!toggleDtex is STRING)')
  endif
endmethod

define method .cancel()

  -- <RM 10/09/08> added this check to make sure that the hanger viewer is hidden if the mdsfhanger form is closed
  if defined(!!mdsHangView) then
    if !!mdsHangView.shown() then
      !!mdsHangView.hide()
    endif
  endif
  -- <RM 10/09/08> end of fix

  if(!this.tuberef.set() and (not !this.tuberef.badref())) then
    !toUnEnhance = !this.tuberef
    unenhance pipe of $!toUnEnhance
  endif

  if(!this.beamRef.set() and !this.beamRef.size() gt 0) then
    -- un enhance previous beams
    do !beamToUnEnhance values !this.beamRef
      if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
        unenhance $!beamToUnEnhance
      endif
    enddo
  endif
  !!mdsResetAutoName(!this)
  -- !this.hide()
endmethod

-- index of special filter buttons
!!mdsFHanger.oneHangerSingleBeamFilterNumber = 1
!!mdsFHanger.oneHangerDoubleBeamFilterNumber = 2
!!mdsFHanger.doubleHangerSingleBeamFilterNumber = 31
!!mdsFHanger.doubleHangerDoubleBeamFilterNumber = 32
!!mdsFHanger.doubleHangerCompoundFilterNumber = 33
!!mdsFHanger.offsetHangerFilterNumber = 4
!!mdsFHanger.pipeHangerFilterNumber = 5
!!mdsFHanger.bottomSupportedFilterNumber = 6

-- <RM 17/07/08> added this because lisega springs supports were not being shown and this is needed to add the extra option
--<wd>04nov2009 Type 600 ONLY required in the STANDARD MDS-LICAD Interface, i.e. NOT required in the AREVA implementation of the MDS-LICAD Interface
!!mdsFHanger.bottomSupportedSpringFilterNumber = 600
-- <RM 17/07/08>

!!mdsFHanger.dynamicFilterNumber = 17
!!mdsFHanger.civilPlateFilterNumber = 18
!!mdsFHanger.civilPlateDoubleFilterNumber = 19
!!mdsFHanger.anyFilterNumber = 7
!!mdsFHanger.noFilterNumber = 8
!!mdsFHanger.angulatingSpringsSteelFilterNumber = 21
!!mdsFHanger.angulatingSpringsCivilFilterNumber = 25

-- Creating a MdstoggleButtonRadio object with a prefix name 'filt' and the default ON button set
-- !this.noFilterNumber. The default button will be pushed.
!!mdsFHanger.oRadio = object MDSTOGGLEBUTTONRADIO(!!mdsFHanger,'filt', !!mdsFHanger.noFilterNumber)
!!mdsFHanger.oRadio.maxIndex = 600
--!!mdsFHanger.lastActivatedFilter = !!mdsFHanger.oRadio.defaultOn
!!mdsFHanger.lastActivatedFilter = REAL()

--  turn on the 'ALL' filter
-- by <ab> 27/05/02 - will be activated by MdsIFhanger
-- !!mdsFHanger.activateFilter(!!mdsFHanger.noFilterNumber)

!!mdsFHanger.filterData.val = 'No Filter'


-- Handle the menu toggle for the various filters mode

!names = ARRAY()
!callbacks = ARRAY()
!names.append('Create and Modify')
!callbacks.append('.setToggle(!this.names[1])')
!names.append('Create Once')
!callbacks.append('.setToggle(!this.names[2])')
!names.append('Multi-Create')
!callbacks.append('.setToggle(!this.names[3])')
!!mdsFHanger.oMenuRadio = object MDSMENUTOGGLERADIO('oMenuRadio', !this.filterMode, !names, !callbacks)
!!mdsFHanger.oMenuRadio.toggleRadioOn(!this.oMenuRadio.defaultOn, true)
!!mdsFHanger.lastActivatedToggle = !this.oMenuRadio.names[!this.oMenuRadio.defaultOn]
!!mdsFHanger.lastActivatedToggle = STRING()
!!mdsFHanger.hangerCategory = 'FH'

-- Deactivate menu when using the interface mode

define method .manifActions()

  !this.filterData.val = 'No Filter'
  !this.filterMode.clear()
  !names = ARRAY()
  !callbacks = ARRAY()
  !names.append('Create and Modify')
  !callbacks.append('.setToggle(!this.names[1])')
  !names.append('Create Once')
  !callbacks.append('.setToggle(!this.names[2])')
  !names.append('Multi-Create')
  !callbacks.append('.setToggle(!this.names[3])')
  !this.oMenuRadio = object MDSMENUTOGGLERADIO('oMenuRadio', !this.filterMode, !names, !callbacks)
  !this.oMenuRadio.toggleRadioOn(!this.oMenuRadio.defaultOn, true)
  !this.lastActivatedToggle = !this.oMenuRadio.names[!this.oMenuRadio.defaultOn]
  !this.lastActivatedToggle = STRING()
  !this.hangerCategory = 'FH'
  !this.standard.active = TRUE
  !this.view.active = TRUE
  !this.viewC.active = TRUE
  !this.filt17.active = FALSE
  !this.standard.active = TRUE
  !this.filt20.active = FALSE
  !this.filt21.active = FALSE
  !this.filt25.active = FALSE
  !this.filt1.val = FALSE
  !this.filt2.val = FALSE
  !this.filt31.val = FALSE
  !this.filt32.val = FALSE
  !this.filt17.val = FALSE
  !this.filt21.val = FALSE
  !this.filt18.val = FALSE
  !this.filt19.val = FALSE
  !this.filt20.val = FALSE
  !this.filt25.val = FALSE
  !this.ok.active = FALSE

  --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
  !this.filt6.active = TRUE
  !this.filt6.val    = FALSE
  !this.filt600.active = FALSE
  !this.filt600.val    = FALSE
  !this.filt7.active = FALSE
  !this.filt8.active = FALSE
  !this.filt8.val    = FALSE
  --<wd>04nov2009 - DFN P-26451 - SI-18252

endmethod

define method .fromExistingAtta()
  !!mdsIdPreliminarySupp(!this)
  if (!!mdsFHanger.name.val NEQ 'unset') then
    !!mdsFHanger.tuberef = object DBREF('/' & !!mdsFHanger.name.val)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      activateAllFilter
--
-- Description: Activate/deactivate ALL filter button depending on preliminary support chosen
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------
define method .activateAllFilter()

  !fromAtta = !this.testPreliminarySupportName()
  if (!fromAtta) then
    !this.filt8.active = FALSE
  elseif (!this.oRadio.activeIndex.neq(8)) then
    !this.filt8.active = TRUE
  endif

endmethod

define method .checkPrelim() is BOOLEAN

  !preliminary = object DBREF('/' & !this.name.val)
  handle ANY
  	--the prelim data does not exist so just run the hanger creation
    return TRUE
  elsehandle none
    -- test if the selected item has the same support function as the preliminary support
    -- if no then show warning - if the answer is 'YES' then replace :mdssuppfunc of new atta
    !listChoice = !this.standard.selection()

    --try and find the SUPF entry for !listChoice in the MDS/APPDEFAULTS db
    !appDefName = '/MDS/HANGER/DEFAULTS/' + '$!listChoice' + '/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !hangSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !hangSuppFunc = $!appDefRef.ppro
    endhandle

    !prelimSuppFunc = !preliminary.:mdssuppfunc

    if ((!hangSuppFunc neq !prelimSuppFunc) and (!prelimSuppFunc.unset().not() and !prelimSuppFunc.neq(''))) then
      !result = !!alert.confirm('The selected preliminary support has a support function of ' + !prelimSuppFunc + ' but the chosen vessel support function is ' + !hangSuppFunc + '. Do you want to continue?')
      if (!result eq 'YES') then
        return TRUE
      else
        return FALSE
      endif
    else
      return TRUE
    endif

  endhandle

endmethod
