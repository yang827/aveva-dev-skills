-- Kill existing form definition
Kill !!MdsFR07

-- Define Form
setup form  !!MdsFR07 at xr0 yr0 noquit

  !!MdsFR07.formtitle    = ||
  !!MdsFR07.icontitle    = ||
  !!MdsFR07.Callback     = ||
  !!MdsFR07.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatFR07()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!MdsFR07)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!MdsFR07)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!MdsFR07)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1
      button .setconfig 'Set Configuration...' at xmin ymax call |!!mdsfrconfig.form = !this !!mdsfrconfig.gadget = !this.config show !!mdsfrconfig|
      para .c at xmin ymax text 'Current Configuration = '
      para .config at xmax ymin text |1|
    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size |    at x1 y1 call |Call !!MdsReSize(!!MdsFR07)| width 20
      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFR07,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |!this.edgentry()|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCheckFR07Con('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |!this.edgentry()|

      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1     | at x1   ymax+0.2 width 16 is real format !!DistanceFmt
      text   .Dim2   |Dim 2     | at xmin ymax width 16 is real format !!DistanceFmt
      text   .Dim3   |Dim 3     | at xmin ymax width 16 is real format !!DistanceFmt

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsFR07)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsFR07)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddFRRack(!!MdsFR07)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarFR07(_Support, 'NEW','DUMMY')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorFR07()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateframe(!!MdsFR07)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsFR07)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsFR07)|

-- Icons Row 2

      button .AddPack       at x1       ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsFR07)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsFR07)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsFR07,'!!MdsRotateFR07()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFR07)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsFR07)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFR07,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsFR07)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsFR07)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFR07,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsFR07,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFR07)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFR07)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFR07)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFR07)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

--      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!MdsCreateFRjoint(!!MdsFR07,'NEW')|
      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFR07,'FITT')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!MdsModFRJoints.form = !!mdsFR07 show !!MdsModFRJoints|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFR07,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFR07,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFR07)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFR07)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFR07,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

      -- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!this.convtospecial()|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .spkbrk   at xmax+0.1 ymin tooltip 'Spec Break on/off'        pixmap width 18 height 18 call |!this.sspkbrk = !!Mdsfrspkkbrk(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptFR07()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Create by member
    member .Method is string

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,18,13,20,28,31,32,34,37,38,41,42,56,58,63'

    member .sbfi is dbref

    member .plane is plane

    member .sspkbrk is BOOLEAN
    !this.sspkbrk = TRUE

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFR07,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsfr07,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!MdsFR07.Select)

    !!MdsFR07.Regen = |Call !!MdsCheckFR07Con('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false
------------------------------------------------------------------------------------



define method .edgentry()

    prompt  'Pick Plate To Connect To'
    !this.setactive(false)
    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'FR07'
    --!packet.elementPick('Pick Element')
    --!packet.defineposition('Pick Element')

    -- Remember the element when the packet was first place in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- Move to the element picked
    !packet.action = '!!mdsFR07.returnfromedg(!this.return)'

    -- Set the close sequence, so that the user returns to the original
    -- element
    !packet.close = '!!mdsFR07.setactive(true)'

    !packet.remove = true $* set packet so that it deletes itself when it finished
    !pickpacket = object edgpickpacket()
    !pickpacket.stdgraphic('pick a surface')
    --!pickpacket.stdposition('Pick Element')
    --!pickpacket.direction('Pick Element')
    --!pickpacket.stdscreen('Pick Element')
    --!pickpacket.stdelement('Pick Element')
    --!pickpacket.planederive()
    -- add the new picktype to the edgpacket currently defined
    !packet.pickpacket = !pickpacket

    -- Add event packet to the system
    !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is array)

   -- this method is called when the EDG returns from a valid pick
   -- first of all check to see if the item picked was a flange

   !item = !input[1].item
   if !item.type.neq('SBFI') and !item.hardtype.neq('PANE') and !item.hardtype.neq('SCTN') then
      !!Alert.error('Identified element is unsuitable to support from.')
      !!edgcntrl.remove('FR07')
      !this.edgentry()
      --!this.setactive(true)
      return
   endif
  --q var !input[1]
  --q var !input[1].positiondata()
  !this.plane = !input[1].positiondata().plane
  if !this.plane.unset() then
    !!alert.error('Please identify a Surface - Not an Edge or PPoint')
    prompt dismiss
    return
  endif

  !this.sbfi = !input[1].item

   prompt dismiss
  --!!edgcntrl.remove('FR07')
  -- if it gets here then its found a face

  -- call the create function with the plate data
   !!MdscreateFR07(|PICK|)
  --!this.datum.active = false

endmethod
---------------------------------------------------------------------------------------------------
define method .convtospecial()

-- Access structure

  !!ce = !this.support.stru
  !Spec = :fra.e_typ
  if !Spec.upcase().neq('YES') and !Spec.upcase().neq('NO') then
    !Spec = 'NO'
  endif
  if !Spec.upcase().eq('YES') then
    if !!Alert.confirm('Are you sure you want to set this electrical special to a standard type').eq('YES') then
      :fra.e_typ 'NO'
    endif
  elseif !Spec.upcase().eq('NO') then
    if !!Alert.confirm('Are you sure you want to set this electrical standard to a special type').eq('YES') then
      :fra.e_typ 'YES'
    endif
  endif

endmethod
-- End of file MdsFR07.frm
