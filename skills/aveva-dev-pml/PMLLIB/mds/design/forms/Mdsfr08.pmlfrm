-- Kill existing form definition
Kill !!MdsFR08

-- Define Form
setup form  !!MdsFR08 at xr0 yr0 noquit

  !!MdsFR08.formtitle    = ||
  !!MdsFR08.icontitle    = ||
  !!MdsFR08.Callback     = ||
  !!MdsFR08.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatFR08()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!MdsFR08)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!MdsFR08)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!MdsFR08)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1
      button .settopconfig '   Top Configuration...' at xmin ymax call |!!mdsfrconfig.form = !this
      !!mdsfrconfig.options.val = !this.tconfig.val.real() !!mdsfrconfig.gadget = !this.tconfig show !!mdsfrconfig|
      para .c1 at xmax ymin text ' = '
      para .tconfig at xmax ymin text |1|
      button .setbottomconfig 'Bottom Configuration...' at xmin.settopconfig ymax call |!!mdsfrconfig.form = !this
      !!mdsfrconfig.options.val = !this.bconfig.val.real() !!mdsfrconfig.gadget = !this.bconfig show !!mdsfrconfig|
      para .c2 at xmax ymin text ' = '
      para .bconfig at xmax ymin text |1|
    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size |    at x1 y1 call |Call !!MdsReSize(!!MdsFR08)| width 20
      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFR08,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |!this.edgentry()|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCheckFR08Con('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |!this.edgentry()|

      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1     | at x1   ymax+0.2 width 16 is real format !!DistanceFmt
      text   .Dim2   |Dim 2     | at xmin ymax width 16 is real format !!DistanceFmt
      text   .Dim3   |Dim 3     | at xmin ymax width 16 is real format !!DistanceFmt
      text   .Dim4   |Dim 4     | at xmin ymax width 16 is real format !!DistanceFmt
      text   .Dim5   |Dim 5     | at xmin ymax width 16 is real format !!DistanceFmt

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsFR08)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsFR08)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddFRRack(!!MdsFR08)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarFR08(_Support, 'NEW','DUMMY')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorFR08()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateframe(!!MdsFR08)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsFR08)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsFR08)|

-- Icons Row 2

      button .AddPack       at x1       ymax+0.25 tooltip 'Add Packer'    pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsFR08)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsFR08)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsFR08,'!!MdsRotateFR08()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFR08)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsFR08)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFR08,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsFR08)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'  pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsFR08)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFR08,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsFR08,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFR08)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFR08)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFR08)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFR08)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!mdsFRAconns.form = !!mdsFR08 show !!mdsFRAconns|
--      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFR08,'FITT')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!MdsModFRJoints.form = !!mdsFR08 show !!MdsModFRJoints|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFR08,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFR08,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFR08)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFR08)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFR08,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!this.convtospecial()|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .spkbrk   at xmax+0.1 ymin tooltip 'Spec Break on/off'        pixmap width 18 height 18 call |!this.sspkbrk = !!Mdsfrspkkbrk(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptFR08()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Create by member
    member .Method is string

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,18,13,20,28,30,31,32,34,37,38,41,42,56,58,63'

    -- connection top fitting
    member .Topsbfi is dbref

    -- connection bottom fitting
    member .Bottomsbfi is dbref

    -- plane of Top fitting
    member .Topplane is plane

    -- plane of Bottom fitting
    member .BottomPlane is plane

    member .sspkbrk is BOOLEAN
    !this.sspkbrk = TRUE

-- End form definition
exit



  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFR08,'white')

  -- Turn off blocked icons
    !!KResetActive(!!MdsFr08,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!MdsFR08.Select)

    !!MdsFR08.Regen = |Call !!MdsCheckFR08Con('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false
------------------------------------------------------------------------------------
define method .edgentry()

    prompt  'Pick Top and Bottom Mounting Plate Surface'
    !this.setactive(false)
    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'FR08'

    -- Remember the element when the packet was first place in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- Move to the element picked
    !packet.action = '!!mdsFR08.returnfromedg(!this.return)'

    -- Set the close sequence, so that the user returns to the original
    -- element
    !packet.close = '!!mdsFR08.setactive(true)'

    !packet.remove = true $* set packet so that it deletes itself when it finished
    !pickpacket = object edgpickpacket()
    --!pickpacket.Prompt = 'Pick Top Plate'
    !pickpacket.stdgraphic('Pick Top and Bottom Mounting Plate Surface')
    !pickpacket.picks[2] = object EDGPICKTYPE()
    !pickpacket.picks[2].stdGraphics('')

    !packet.pickpacket = !pickpacket

    -- Add event packet to the system
    !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is array)

   -- this method is called when the EDG returns from a valid pick
   -- first of all check to see if the item picked was a flange
   --q var !input[1][1]
   --q var !input[1][2]

   prompt dismiss

   !item1 = !input[1][1].item
   !item2 = !input[1][2].item
   if !item1.type.neq('SBFI') and !item1.hardtype.neq('PANE') and !item1.hardtype.neq('SCTN') then
      !!Alert.error('Identified element 1 is unsuitable to support from.')
      !!edgcntrl.remove('FR08')
      !this.edgentry()
      --!this.setactive(true)
      return
   endif
   if !item2.type.neq('SBFI') and !item2.hardtype.neq('PANE') and !item2.hardtype.neq('SCTN') then
      !!Alert.error('Identified element 2 is unsuitable to support from.')
      !!edgcntrl.remove('FR08')
      !this.edgentry()
      return
   endif

  --q var !input[1][1].positiondata()
  --q var !input[1][2].positiondata()

  !this.Topplane      = !input[1][1].positiondata().plane
  if !this.Topplane.unset() then
    !!alert.error('Top Surface Not Identified correctly - Edge or PPoint found')
    prompt dismiss
    return
  endif

  !this.Bottomplane   = !input[1][2].positiondata().plane
  if !this.Bottomplane.unset() then
    !!alert.error('Bottom Surface Not Identified correctly - Edge or PPoint found')
    prompt dismiss
    return
  endif

  !this.Topsbfi       = !input[1][1].item
  !this.Bottomsbfi    = !input[1][2].item

  if !this.topsbfi.position.wrt(/* ).up.leq(!this.bottomsbfi.position.wrt(/* ).up) then
    !!Alert.error('Identified elements are not Positioned correctly for this Support.')
    return
  endif

  --!!edgcntrl.remove('FR08')
  -- if it gets here then its found two faces

  -- call the create function with the plate data
  !!MdscreateFR08(|PICK|)
  --!this.datum.active = false

endmethod
---------------------------------------------------------------------------------------------------
define method .convtospecial()

-- Access structure

  !!ce = !this.support.stru
  !Spec = :fra.e_typ
  if !Spec.upcase().neq('YES') and !Spec.upcase().neq('NO') then
    !Spec = 'NO'
  endif
  if !Spec.upcase().eq('YES') then
    if !!Alert.confirm('Are you sure you want to set this electrical special to a standard type').eq('YES') then
      :fra.e_typ 'NO'
    endif
  elseif !Spec.upcase().eq('NO') then
    if !!Alert.confirm('Are you sure you want to set this electrical standard to a special type').eq('YES') then
      :fra.e_typ 'YES'
    endif
  endif

endmethod
-- End of file MdsFR08.frm
