---------------------------------------------------------------------------
define method .setposts(!num is STRING)

 if !num.real().lt(1) or !num.real().gt(20) then
   !!alert.error('Invalid Range - Number of Posts must be between 1 and 20')
   return
    --<wd>22jan2009 else
  endif

 do !i from 1 to !num.real() - 1
    !!mdsFR09.dim$!<i>.active = TRUE
 enddo

 do !i from !num.real()  to 20
    !!mdsFR09.dim$!<i>.active = FALSE
 enddo

 !this.drawaids( )

 endmethod
