-- Kill existing form definition
Kill !!mdsFR09

-- Define Form
setup form  !!mdsFR09 at xr0 yr0 noquit

  !!mdsFR09.formtitle    = ||
  !!mdsFR09.icontitle    = ||
  !!mdsFR09.callBack     = ||
  !!mdsFR09.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFR09()|
    button .bdist | Distance | at xmin   ymax+0.28       call |Call !!mdsPosDist(!!mdsFR09)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.28        call |Call !!mdsPosThro(!!mdsFR09)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFR09)| width 13
    para   .p                  at x1     ymax+0.28 width 25 lines 1

  exit

  frame .fPosts   |Posts| at xmax .fDatum ymin .tag

      text .nposts  |Number of Vertical Members | at x1 y0.75 call |!this.setposts(!this.nposts.val)|width 4 is STRING
    text .upoffs  |Post Top Offset   | at xmin ymax+0.2 call |!this.drawaids()| width 10 is REAL format !!distanceFmt
    text .lowoffs |Post Lower Offset | at xmin ymax+0.2 call |!this.drawaids()| width 10 is REAL format !!distanceFmt
      button .id1   |ID| at xmax .upoffs ymin .upoffs call |!this.setdim('Top')|
      button .id2   |ID| at xmax .lowoffs ymin .lowoffs call |!this.setdim('Bottom')|

    exit

  frame .fBars |Horizontal Bars| at xmin.fPosts ymax.fPosts

    text .nbars  |Number of Bars | at x1 y0.75 width 6 is REAL
       button .calcbars | Auto... | at xmax ymin call |!this.calcbars()|
    button .setBars  | Set Bar Dimensions.. | at xmin.nbars ymax+0.2 call |!this.setBars('std')|

    exit


  frame .olap |Overlap Dimensions| at xmin.fBars  ymax.fBars

    text .l2 | L2 | call |!this.drawaids()| width 9 is REAL format !!distanceFmt
    text .l3 | L3 | at xmax+4 ymin call |!this.drawaids()| width 9 is REAL format !!distanceFmt

    exit

    frame .buildir | Build Direction From Datum |at xmin.olap ymax
    text   .postoffset |Post 1 Offset | call |!this.drawaids()| width 9 is REAL format !!distanceFmt
      option .sense call |!this.drawaids()| width 6

    exit

    !a[1] = 'Left'
    !a[2] = 'Right'
    !this.sense.dtext = !a

