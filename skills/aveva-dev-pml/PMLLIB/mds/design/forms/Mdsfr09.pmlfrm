---------------------------------------------------------------------------
define method .setBars(!type is STRING)

  -- !!mdsFRbars.form = !this
 -- show !!mdsFRbars

  !datum  = !!mdsFR09.support.datum

  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
  return
endif

if !type.eq('std') then
  !!mdsFR11Bars.form = !this
  show !!mdsFR11bars
else
    !!mdsFRWallbars.form = !this
  show !!mdsFRWallbars
endif



endmethod
---------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .calcbars()

   -- cannot use auto when the edit form is shown
  if !!mdsFRbars.shown() then
      !!alert.error('Cannot Use Auto Whilst Editing Bars')
      return
   endif

   !lowbars = 0
   !highbars = 0
   -- clear the old values
   !this.bardims = ARRAY()
   -- method to work out how many bars can be put in
   -- first do the ones below the datum
   if !this.lowoffs.val.gt(400) then  $* there is enough room for at least 1 bar
     !lowbars = int(!this.lowoffs.val / 300)
     if !lowbars gt 1 then
       !lowbars = !lowbars - 1
       -- work out the spacing
       !lowspace = nint(!this.lowoffs.val / (!lowbars + 1))
     else
       !lowspace = 300
     endif
   endif

   if !this.upoffs.val.gt(400) then  $* there is enough room for at least 1 bar
     !highbars = int(!this.upoffs.val / 300)
     if !highbars gt 1 then
       !highbars = !highbars - 1
       -- work out the spacing
       !highspace = nint(!this.upoffs.val / (!highbars + 1))
     else
       !highspace = 300
     endif
   endif

   !datup = !this.support.datum.position.wrt(/* ).up
   !lowarray = ARRAY()
   do !a from 1 to !lowbars
     !lowarray.append(nint(!datup - !lowspace * !a))
   enddo

   !lowarray.invert()
   !lowarray.append(!datup)

   !higharray = ARRAY()

   do !a from 1 to !highbars
     !higharray.append(nint(!datup + !highspace * !a))
   enddo

   !lowarray.appendarray(!higharray)

   !this.bardims = !lowarray
   !this.nbars.val = !this.bardims.size()
   do !a index !this.bardims
      !barsides[!a] = 'S'
   enddo
   !this.barsides = !barsides
   !this.drawaids()


endmethod
---------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .setdim(!id is STRING)

    if !id eq 'Top' then
       !this.switch = TRUE
    else
       !this.switch = FALSE
    endif

    prompt  'Pick Plate To Connect To'
  !this.setactive(FALSE)
    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'FR09'

    -- Remember the element when the packet was first place in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- Move to the element picked
    !packet.action = '!!mdsFR09.returnfromedg(!this.return)'

    -- Set the close sequence, so that the user returns to the original
    -- element
    !packet.close = '!!mdsFR09.setactive(true)'

  !packet.remove = TRUE $* set packet so that it deletes itself when it finished
  !pickpacket = object EDGPICKPACKET()
    !pickpacket.stdgraphic('Pick Top and Bottom Mounting Plate Surface')

    !packet.pickpacket = !pickpacket

    -- Add event packet to the system
    !!edgCntrl.add(!packet)


endmethod
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
define method .returnfromedg(!input is ARRAY)

   -- this method is called when the EDG returns from a valid pick
   -- first of all check to see if the item picked was a flange

   prompt dismiss
   !item1 = !input[1].item
   if !item1.type.neq('SBFI') and !item1.hardtype.neq('PANE') and !item1.hardtype.neq('SCTN') then
    !!alert.error('Identified element 1 is unsuitable to support from.')
    !!edgCntrl.remove('FR09')
      return
   endif

  if !this.switch then $* its the top dimension
    !this.topplane      = !input[1].positiondata().plane
    if !this.topplane.unset() then
       !!alert.error('Surface Not Identified Correctly - Edge or PPoint found')
       prompt dismiss
       return
     endif
    !this.topsbfi       = !input[1].item
  else
    !this.bottomsbfi    = !input[1].item
    !this.bottomPlane   = !input[1].positiondata().plane
    if !this.bottomPlane.unset() then
        !!alert.error('Surface Not Identified Correctly - Edge or PPoint found')
        prompt dismiss
        return
     endif
  endif

  -- now construct the distance from the datum
  !datumup = !this.support.datum.position.wrt(/* ).up

  if !this.switch then
    !this.upoffs.val  = abs(!this.topplane.position.wrt(/* ).up - !datumup)
  else
    !this.lowoffs.val = abs(!datumup - !this.bottomPlane.position.wrt(/* ).up )
  endif

  !this.drawaids()

endmethod
----------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------
-- method to draw an aid arrow in the build direction and build vertical aid boxes
-- calls !this.drawbars() which draws a representation of the horizontal bars
define method .drawaids()

   -- first of all clear the aids which may already be on
   !this.clearaids()
   -- uses aid lines 361 461

  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009>- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------
  --   --if the direction is left then use p10 of the atta else use p11
  --   if !this.sense.val eq 1 then $* its left
  --     !dir = !this.support.datum.pdir[10].wrt(/* )
  --   else
  --     !dir = !this.support.datum.pdir[11].wrt(/* )
  --   endif

  -- Determine the P-Leave Direction of the DATUM ATTA
  !datumLeaveDirection = !!mdsFR09.support.datum.ldir.wrt(/* )

  -- Check if the DATUM ATTA Leave Direction is UP wrt /* or DOWN wrt /*
  if (!datumLeaveDirection.up.eq(1)) then
    -- DATUM ATTA Leave Direction is UP wrt /*
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[10].wrt(/* )
    else
      !dir = !this.support.datum.pdir[11].wrt(/* )
    endif
  elseif (!datumLeaveDirection.up.eq(-1)) then
    -- DATUM ATTA Leave Direction is DOWN wrt /*
    --if the direction is left then use p11 of the atta else use p10
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[11].wrt(/* )
    else
      !dir = !this.support.datum.pdir[10].wrt(/* )
    endif
  endif
  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009<- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------

   aid arrow number 361 at $!this.support.datum.position direction $!dir height 400 prop 0.33
   !p9dir = !this.support.datum.pdir[9].wrt(/* )
   !datpos = !this.support.datum.position.wrt(/* )
   -- place a pointvector at the datum
  !pv = object POINTVECTOR()
   !pv.position = !datpos
   -- move the pointvector to the vertical centreline of V1
   !pv.direction = !p9dir
   !pv = !pv.offset(70)
  -- point the point vector in the direction of the offset
   !pv.direction = !dir
   -- move the pointvector to the offset position
   !startpos = !pv.offset(!this.postoffset.val)
   -- build the vertical bars as aid lines
   do !p from 1 to !this.nposts.val.real()
      !pos1 = !startpos.position
      !pos1.up = !pos1.up - !this.lowoffs.val
      !pos2 = !startpos.position
      !pos2.up = !pos2.up + !this.upoffs.val
      !boxpos = !pos1.midpoint(!pos2)
      !boxlen = !pos1.distance(!pos2).abs()
      !lineno = 360 + !p
      aid box number $!lineno position $!boxpos ori y is $!p9dir xlen 80 ylen 80 zlen $!boxlen filled off
      !startpos = !startpos.offset(!this.dim$!<p>.val)
   enddo

   !this.drawbars()

endmethod
-----------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------
-- method to draw build horizontal aid boxes for each bar
-- uses aid boxes 400 to 440
define method .drawbars()


  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009>- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------
  --   --if the direction is left then use p10 of the atta else use p11
  --   if !this.sense.val eq 1 then $* its left
  --     !dir = !this.support.datum.pdir[10].wrt(/* )
  --   else
  --     !dir = !this.support.datum.pdir[11].wrt(/* )
  --   endif

  -- Determine the P-Leave Direction of the DATUM ATTA
  !datumLeaveDirection = !!mdsFR09.support.datum.ldir.wrt(/* )

  -- Check if the DATUM ATTA Leave Direction is UP wrt /* or DOWN wrt /*
  if (!datumLeaveDirection.up.eq(1)) then
    -- DATUM ATTA Leave Direction is UP wrt /*
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[10].wrt(/* )
    else
      !dir = !this.support.datum.pdir[11].wrt(/* )
    endif
  elseif (!datumLeaveDirection.up.eq(-1)) then
    -- DATUM ATTA Leave Direction is DOWN wrt /*
    --if the direction is left then use p11 of the atta else use p10
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[11].wrt(/* )
    else
      !dir = !this.support.datum.pdir[10].wrt(/* )
    endif
  endif
  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009<- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------

   !boxlen = !this.l2.val + !this.l3.val

   -- loop through the vertical posts to find the total distance
   do !a from 1 to !this.nposts.val.real()
      if !a eq 1 then
        skip
      endif
      !dim = !a - 1
      !boxlen = !boxlen + !this.dim$!<dim>.val
   enddo

   -- we have calculated the length of the horizontal bars.
   -- now we need to draw them.
   -- there is always one bar built from the template

   -- we need to know how many bars there are and what their positions are
   -- this will be stored on a form

   !p9dir = !this.support.datum.pdir[9].wrt(/* )
   !datpos = !this.support.datum.position.wrt(/* )
   -- place a pointvector at the datum
  !pv = object POINTVECTOR()
   !pv.position = !datpos
   -- move the pointvector to the vertical centreline of V1
   !pv.direction = !p9dir
   !pv = !pv.offset(15)
  -- point the point vector in the direction of the offset
   !pv.direction = !dir
   -- move the pointvector to the offset position
   !startpos = !pv.offset(!this.postoffset.val - !this.l2.val)
   !boxdir = !startpos.direction.opposite()

   !boxpos = !startpos.offset(!boxlen / 2).position
   if !this.bardims.size() eq 0 then
     aid box number 400 position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
   else
   !boxnum = 400
    !pv2 = object POINTVECTOR()
   !pv2.position = !boxpos
   !pv2.direction = !p9dir
   !altpos = !pv2.offset(110).position
   do !a from 1 to !this.bardims.size()
       if !this.barsides[!a].eq('R') then
         !altpos.up = !this.bardims[!a]
         aid box number $!boxnum position $!altpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
       elseif !this.barsides[!a].eq('B') then
         !boxpos.up = !this.bardims[!a]
         aid box number $!boxnum position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
         !boxnum = !boxnum + 1
         !altpos.up = !this.bardims[!a]
         aid box number $!boxnum position $!altpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
       else
         !boxpos.up = !this.bardims[!a]
         aid box number $!boxnum position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
       endif
       !boxnum = !boxnum + 1
   enddo
  endif

endmethod
-----------------------------------------------------------------------------------------------

-----------------------------------------------------------------------------------------------
define method .clearaids()
 aid clear arrow 361
 handle ANY
 endhandle
 do !a from 361 to 440
   aid clear box $!a
   handle ANY
    skip
   endhandle
 enddo
endmethod
-----------------------------------------------------------------------------------------------

define method .convtospecial()

-- Access structure

  !!ce = !this.support.stru
  !spec = :fra.e_typ
  if !spec.upcase().neq('YES') and !spec.upcase().neq('NO') then
    !spec = 'NO'
  endif
  if !spec.upcase().eq('YES') then
    if !!alert.confirm('Are you sure you want to set this electrical special to a standard type').eq('YES') then
      :fra.e_typ 'NO'
    endif
  elseif !spec.upcase().eq('NO') then
    if !!alert.confirm('Are you sure you want to set this electrical standard to a special type').eq('YES') then
      :fra.e_typ 'YES'
    endif
  endif

endmethod
