-- Kill existing form definition
Kill !!mdsFR16

-- Define Form
setup form  !!mdsFR16 at xr0 yr0 noquit

  !!mdsFR16.formtitle    = ||
  !!mdsFR16.icontitle    = ||
  !!mdsFR16.callback     = ||
  !!mdsFR16.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax+0.3 width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFR16()|
    button .bdist | Distance | at xmin   ymax+0.28       call |!this.distcall()|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.28        call |!this.through()|
    option .select             at xmax+1 ymin             call |Call !!mdsThroSelect(!!mdsFR16)| width 13
    para   .p                  at x1     ymax+0.28 width 25 lines 1

  exit

  frame .fposts   |Posts| at xmax .fDatum+0.5 ymin .tag wid 37.5

    --text .nposts  |Number of Vertical Members | at x1 y0.75 tagwid 23 call |!this.setposts(!this.nposts.val)| width 4 is STRING
    --text .upoffs  |Post Top Offset   | at xmin ymax+0.2 tagwid 23 call |!this.drawaids()| width 6 is REAL format !!distanceFmt
    --text .lowoffs |Post Lower Offset | at xmin ymax+0.2 tagwid 23 call |!this.drawaids()| width 6 is REAL format !!distanceFmt
    para .npoststag   at x1 y0.75 text |Number of Vertical Members| width 20
    text .nposts  at xmax+1 y0.75 call |!this.setposts(!this.nposts.val)| width 4 is STRING
    text .upoffs  |Post Top Offset   | at x1 ymax+0.2  call |!this.drawaids()| width 6 is REAL format !!distanceFmt
    text .lowoffs |Post Lower Offset | at xmin ymax+0.2  call |!this.drawaids()| width 6 is REAL format !!distanceFmt
    button .id1   |ID| at xmax .upoffs+1 ymin .upoffs call   |!this.setdim('Top')|
    button .id2   |ID| at xmax .lowoffs+1 ymin .lowoffs call |!this.setdim('Bottom')|

  exit

  frame .fbars |Horizontal Bars| at xmin.fposts ymax.fposts wid 37.5

    text .nbars  |Number of Bars | at x1 y0.75 width 6 is REAL
    button .bars | Auto..  | at xmax+1 ymin call |!this.calcbars()|
    button .setBars  | Set Bar Dimensions.. | at xmin.nbars ymax+0.2 call |!this.setBars('std')|

  exit


  frame .olap |Overlap Dimensions| at xmin.fbars  ymax.fbars wid 37.5

    text .l2 | L2 | call |!this.drawaids()| width 9 is REAL format !!distanceFmt
    text .l3 | L3 | at xmax+4 ymin call |!this.drawaids()| width 9 is REAL format !!distanceFmt

  exit

  frame .buildir | Build Direction From Datum |at xmin.olap ymax wid 37.5
    text   .postoffset |Post Offset | call |!this.drawaids()| width 8 is REAL format !!distanceFmt
    option .sense call |!this.drawaids()| width 6

  exit

  !a[1] = 'Left'
  !a[2] = 'Right'
  !this.sense.dtext = !a

  -- Creation
  frame .fCreate |Create| at x0 ymax.fDatum wid 31

    -- option .size   |Size |    at x1 y1 call |Call !!mdsReSize(!!mdsFR16)| width 20
    path right
    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFR16,'-BAR-1','-V1')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCheckFR16Con('DIMENSION')|
    para   .tCode   at x1 ymax+0.2 text |Support Code|
    para   .code   at xmax+0.5 ymin width 15 lines 1

  exit

  frame .walldims |Wall Connections| at x0 ymax.fCreate+0.1 wid 69
    para .conntoptag at x1 y0.75 text |Upper Connection Offset| wid 16
    text .conntop at xmax+1 ymin call |!this.connheight('UPPER')| width 6 is REAL
    para .connbotag at xmin.conntoptag ymax.conntoptag+0.2 text |Lower Connection Offset| wid 16
    text .connbot at xmax+1 ymin call |!this.connheight('LOWER')| width 6 is REAL
    para .conntag at xmax .connbot+1 ymin.connbot text |Connection Direction| wid 14
    option .conndir at xmax+1 ymin call |!this.drawaids()| width 6
    para .wallOffTag at xmax .conntop+1 ymin.conntop text |Wall Offset| wid 14
    text .walloffset  at xmax+1 ymin call |!this.drawaids()| width 6 is REAL
    button .id3   |ID| at xmax+1 ymin call |!this.setdim('wall')|
    --button .conns     | Auto | at xmax ymin call |!this.calccon()|
    --button .setconns  | Set Connection Levels.. | at xmax ymin call |!this.setBars('wall')|

  exit

  !a[1] = 'Left'
  !a[2] = 'Right'
  !this.conndir.dtext = !a

$(
