  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Form Storage for Packing Pieces for Support restoration
  member .ppack       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Create by member
  member .method is STRING

  -- Blocked icons
  member .blockedIcons is STRING
  !this.blockedIcons = '1,13,20,28,32,34,37,38,41,42,56,58,63'

  -- connection top fitting
  member .topsbfi is DBREF

  -- connection bottom fitting
  member .bottomsbfi is DBREF

  -- connection side fitting
  member .sidesbfi is DBREF

  -- plane of Top fitting
  member .topplane is PLANE

  -- plane of Bottom fitting
  member .bottomPlane is PLANE

  -- plane of Side fitting
  member .sidePlane is PLANE


  member .switch is STRING

  member .aidnumbers is ARRAY

  member .bardims is ARRAY

  member .barsides is ARRAY

  member .suppdims is ARRAY

  member .localfitt is ARRAY

  member .sspkbrk is BOOLEAN
  !this.sspkbrk = TRUE



  -- End form definition
exit

!this.switch = 'Top'

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFR16,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFR16,true)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFR16.select)

!!mdsFR16.regen = |Call !!mdsCheckFR16Con('DIMENSION')|

define method .setposts(!num is STRING)

  if !num.real().lt(1) or !num.real().gt(21) then
    !!alert.error('Invalid Range - Number of Posts must be between 1 and 21')
    return
  else

    --do !i from 1 to !num.real() - 1
    --   !!mdsFR16.dim$!<i>.active = TRUE
    --enddo

    --do !i from !num.real() to 20
    --       !!mdsFR16.dim$!<i>.active = FALSE
    --enddo

    if undefined(!this.localfitt[1]) then
      !this.localfitt[1] = ARRAY()
      !this.localfitt[1][1] = !this.support.datum.position.wrt(/* ).up
    endif

    do !i from 2 to !num.real()
      if undefined(!this.localfitt[!i]) then
        !this.localfitt[!i] = !this.localfitt[1]
      endif
    enddo

    !this.clearaids()
    !this.drawaids()
  endif
endmethod
---------------------------------------------------------------------------


---------------------------------------------------------------------------
define method .setBars(!type is STRING)

  !datum  = !!mdsFR16.support.datum

  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    return
  endif

  if !type.eq('std') then
    !!mdsFR16Bars.form = !this
    show !!mdsFR16Bars
  else
    !!mdsFRWallBars.form = !this
    show !!mdsFRWallBars
  endif

endmethod
---------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .calcbars()

  !direction = !!mdsFR16.support.datum.pdir[9].wrt(/* )
  handle ANY
    !!alert.error('Datum atta not created')
    return
  endhandle


  -- cannot use auto when the edit form is shown
  if !!mdsFR16Bars.shown() then
    !!alert.error('Cannot Use Auto Whilst Editing Bars')
    return
  endif

  !lowbars = 0
  !highbars = 0
  -- clear the old values
  !this.bardims = ARRAY()
  -- method to work out how many bars can be put in
  -- first do the ones below the datum
  if !this.lowoffs.val.gt(400) then  $* there is enough room for at least 1 bar
    !lowbars = int(!this.lowoffs.val / 300)
    if !lowbars gt 1 then
      !lowbars = !lowbars - 1
      -- work out the spacing
      !lowspace = nint(!this.lowoffs.val / (!lowbars + 1))
    else
      !lowspace = 300
    endif
  endif

  -- $p lowspace = $!lowspace

  if !this.upoffs.val.gt(400) then  $* there is enough room for at least 1 bar
    !highbars = int(!this.upoffs.val / 300)
    if !highbars gt 1 then
      !highbars = !highbars - 1
      -- work out the spacing
      !highspace = nint(!this.upoffs.val / (!highbars + 1))
    else
      !highspace = 300
    endif
  endif

  !barsides[1] = 'S'

  !datup = !this.support.datum.position.wrt(/* ).up
  !lowarray = ARRAY()
  do !a from 1 to !lowbars
    !lowarray.append(nint(!datup - !lowspace * !a))
    !barsides.append('S')
  enddo

  -- $p highspace = $!highspace

  !lowarray.invert()
  !lowarray.append(!datup)

  !higharray = ARRAY()


  do !a from 1 to !highbars
    !higharray.append(nint(!datup + !highspace * !a))
    !barsides.append('S')
  enddo

  !lowarray.appendarray(!higharray)

  !this.bardims = !lowarray
  !this.barsides = !barsides
  !this.nbars.val = !this.bardims.size()
  !this.drawaids()

endmethod
---------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .setdim(!id is STRING)

  !this.switch = !id

  prompt  'Pick Plate To Connect To'
  !this.setactive(false)
  -- Define event packet
  !packet = object EDGPACKET()
  !packet.description = 'FR16'

  -- Remember the element when the packet was first place in the event system
  !packet.initialisation = '!this.input[1] = !!ce'

  -- Move to the element picked
  !packet.action = '!!mdsFR16.returnfromedg(!this.return)'

  -- Set the close sequence, so that the user returns to the original
  -- element
  !packet.close = '!!mdsFR16.setactive(true)'

  !packet.remove = true $* set packet so that it deletes itself when it finished
  !pickpacket = object EDGPICKPACKET()
  !pickpacket.stdgraphic('Pick Top and Bottom Mounting Plate Surface')
  --!pickpacket.picks[2] = object EDGPICKTYPE()
  --!pickpacket.picks[2].stdGraphics('')

  !packet.pickpacket = !pickpacket

  -- Add event packet to the system
  !!edgCntrl.add(!packet)


endmethod
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
define method .returnfromedg(!input is ARRAY)

  -- this method is called when the EDG returns from a valid pick
  -- first of all check to see if the item picked was a flange

  prompt dismiss
  !item1 = !input[1].item
  --!item2 = !input[1][2].item
  if !item1.type.neq('SBFI') and !item1.hardtype.neq('PANE') and !item1.hardtype.neq('SCTN') then
    !!alert.error('Identified element 1 is unsuitable to support from.')
    !!edgCntrl.remove('FR16')
    return
  endif

  if !this.switch.eq('Top') then $* its the top dimension
    !this.topplane      = !input[1].positiondata().plane
    if !this.topplane.unset() then
      !!alert.error('Surface Not Identified correctly - Edge or PPoint found')
      prompt dismiss
      return
    endif
    !this.topsbfi       = !input[1].item
  elseif !this.switch.eq('Bottom') then
    !this.bottomsbfi    = !input[1].item
    !this.bottomPlane   = !input[1].positiondata().plane
    if !this.bottomPlane.unset() then
      !!alert.error('Surface Not Identified correctly - Edge or PPoint found')
      prompt dismiss
      return
    endif
  else
    !this.sidesbfi    = !input[1].item
    !this.sidePlane   = !input[1].positiondata().plane
    if !this.sidePlane.unset() then
      !!alert.error('Surface Not Identified correctly - Edge or PPoint found')
      prompt dismiss
      return
    endif

  endif

  -- now construct the distance from the datum
  !datumup = !this.support.datum.position.wrt(/* ).up

  if !this.switch.eq('Top') then
    !this.upoffs.val  = abs(!this.topplane.position.wrt(/* ).up - !datumup)
  elseif !this.switch.eq('Bottom') then
    !this.lowoffs.val = abs(!datumup - !this.bottomPlane.position.wrt(/* ).up )
  else
    -- work out the walloffset dimension
    !pv = !input[1].positiondata().plane.pointvector()
    !px = !pv.through(!this.support.datum.position.wrt(/* ))
    !this.walloffset.val = abs(!pv.position.distance(!px.position)) - 110

    --  !this.lowoffs.val = abs(!datumup - !this.bottomPlane.position.wrt(/* ).up )
  endif

  !this.drawaids()

endmethod
----------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------
-- method to draw an aid arrow in the build direction and build vertical aid boxes
-- calls !this.drawbars() which draws a representation of the horizontal bars
define method .drawaids()

  !direction = !!mdsFR16.support.datum.pdir[9].wrt(/* )
  handle ANY
    !!alert.error('Datum atta not created')
    return
  endhandle

  -- first of all clear the aids which may already be on
  !this.clearaids()
  -- uses aid lines 361 461

  -- <RM> 27 Sept 2006 > -- Fix 1
  -- included an addition check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!this.support.datum
  --if the direction is left then use p10 of the atta else use p11
  if !attadir.eq('U') then
    --if the direction is left then use p11 of the atta else use p10
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[11].wrt(/* )
    else
      !dir = !this.support.datum.pdir[10].wrt(/* )
    endif
  else
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[10].wrt(/* )
    else
      !dir = !this.support.datum.pdir[11].wrt(/* )
    endif
  endif

  !p9dir = !this.support.datum.pdir[9].wrt(/* )

  aid arrow number 361 at $!this.support.datum.position direction $!dir height 400 prop 0.33
  -- <RM> 27 Sept 2006 > -- end of Fix 1

  !datpos = !this.support.datum.position.wrt(/* )
  -- place a pointvector at the datum
  !pv = object POINTVECTOR()
  !pv.position = !datpos
  -- move the pointvector to the vertical centreline of V1
  !pv.direction = !p9dir
  !pv = !pv.offset(70)
  -- point the pontvector in the direction of the offset
  !pv.direction = !dir
  -- move the pointvector to the offset position
  !startpos = !pv.offset(!this.postoffset.val)
  -- build the vertical bars as aid lines

  do !p from 1 to !this.nposts.val.real()
    !pos1 = !startpos.position
    !pos1.up = !pos1.up - !this.lowoffs.val
    !pos2 = !startpos.position
    !pos2.up = !pos2.up + !this.upoffs.val
    !boxpos = !pos1.midpoint(!pos2)
    !boxlen = !pos1.distance(!pos2).abs()
    !lineno = 360 + !p
    aid box number $!lineno position $!boxpos ori y is $!p9dir xlen 80 ylen 80 zlen $!boxlen filled off
    -- aid line number $!lineno $!pos1 to $!pos2 linestyle dashd
    --!startpos = !startpos.offset(!this.dim$!<p>.val)
  enddo

  !this.drawbars()

  if set(!this.localfitt) then
    !this.drawconns(!this.localfitt,FALSE)
  endif

endmethod
-----------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------
-- method to draw build horizontal aid boxes for each bar
-- uses aid boxes 400 to 440
define method .drawbars()

  -- <RM> 27 Sept 2006 > -- Fix 2
  -- included an addition check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!this.support.datum
  --if the direction is left then use p10 of the atta else use p11
  if !attadir.eq('U') then
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[11].wrt(/* )
    else
      !dir = !this.support.datum.pdir[10].wrt(/* )
    endif
  else
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[10].wrt(/* )
    else
      !dir = !this.support.datum.pdir[11].wrt(/* )
    endif
  endif
  -- <RM> 27 Sept 2006 > -- end of Fix 2
  !boxlen = !this.l2.val + !this.l3.val

  --- this is where I need to put the code for a situation where there are bars both sides
  -- next problem is how do i store the data


  -- loop through the vertical posts to find the total distance
  do !a from 1 to !this.nposts.val.real()
    if !a eq 1 then
      skip
    endif
    !dim = !a - 1
    !boxlen = !boxlen + !this.dim$!<dim>.val
  enddo

  -- we have calculated the length of the horizontal bars.
  -- now we need to draw them.
  -- there is always one bar built from the template

  -- we need to know how many bars there are and what their positions are
  -- this will be stored on a form

  !p9dir = !this.support.datum.pdir[9].wrt(/* )
  !datpos = !this.support.datum.position.wrt(/* )
  -- place a pointvector at the datum
  !pv = object POINTVECTOR()
  !pv.position = !datpos
  -- move the pointvector to the vertical centreline of V1
  !pv.direction = !p9dir
  !pv = !pv.offset(15)
  -- point the pontvector in the direction of the offset
  !pv.direction = !dir
  -- move the pointvector to the offset position
  !startpos = !pv.offset(!this.postoffset.val - !this.l2.val)
  !boxdir = !startpos.direction.opposite()
  !pos = !startpos.position.wrt(/* )
  !boxpos = !startpos.offset(!boxlen / 2).position
  -- work out the opposite side for reversed bars
  !pv2 = object POINTVECTOR()
  !pv2.position = !boxpos
  !pv2.direction = !p9dir
  !altpos = !pv2.offset(110).position

  -- <RM> 27 Sept 2006 > -- Fix 3 -- changed the orientation on aid boxes
  if !this.bardims.size() eq 0 then
    aid box number 400 position $!boxpos ori z is $!boxdir and y is $!p9dir ylen 30 xlen 50 zlen $!boxlen filled off
  else
    !boxnum = 400
    do !a from 1 to !this.bardims.size()
      if !this.barsides[!a].eq('R') then
        !altpos.up = !this.bardims[!a]
        aid box number $!boxnum position $!altpos ori z is $!boxdir and y is $!p9dir ylen 30 xlen 50 zlen $!boxlen filled off
      elseif !this.barsides[!a].eq('B') then
        !boxpos.up = !this.bardims[!a]
        aid box number $!boxnum position $!boxpos ori z is $!boxdir and y is $!p9dir ylen 30 xlen 50 zlen $!boxlen filled off
        !boxnum = !boxnum + 1
        !altpos.up = !this.bardims[!a]
        aid box number $!boxnum position $!altpos ori z is $!boxdir and y is $!p9dir ylen 30 xlen 50 zlen $!boxlen filled off
      else
        !boxpos.up = !this.bardims[!a]
        aid box number $!boxnum position $!boxpos ori z is $!boxdir and y is $!p9dir ylen 30 xlen 50 zlen $!boxlen filled off
      endif
      !boxnum = !boxnum + 1
    enddo
  endif
  -- <RM> 27 Sept 2006 > -- End of Fix 3
endmethod
-----------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------
-- method to draw aid boxes for the connections
define method .drawconns(!bardims is ARRAY,!clear is BOOLEAN)

  if !clear then
    -- clear the aids which may already be on
    !this.clearaids()
  endif
  -- uses aid lines 361 461

  -- <RM> 27 Sept 2006 > -- fix 4
  -- included an addition check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!this.support.datum
  --if the direction is left then use p10 of the atta else use p11
  if !attadir.eq('U') then
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[11].wrt(/* )
    else
      !dir = !this.support.datum.pdir[10].wrt(/* )
    endif
  else
    --if the direction is left then use p10 of the atta else use p11
    if !this.sense.val eq 1 then $* its left
      !dir = !this.support.datum.pdir[10].wrt(/* )
    else
      !dir = !this.support.datum.pdir[11].wrt(/* )
    endif
  endif

  !p9dir = !this.support.datum.pdir[9].wrt(/* )

  -- if conndir.val = 1 then it's left
  if !attadir.eq('U') then
    if !this.conndir.val eq 1 then
      !diraid = '11'
    else
      !diraid = '10'
    endif
  else
    if !this.conndir.val eq 1 then
      !diraid = '10'
    else
      !diraid = '11'
    endif
  endif
  -- <RM> 27 Sept 2006 < -- end of fix 4

  !pxdir = !this.support.datum.pdir[$!diraid].wrt(/* )
  !datpos = !this.support.datum.position.wrt(/* )
  !pv = object POINTVECTOR()
  !pv.position = !datpos

  -- move the pointvector to the vertical centreline of V1
  !pv.direction = !p9dir
  !pv = !pv.offset(140 / 2)

  -- move the pointvector to the centre point of the left / right connection leg
  !pv.direction = !pxdir
  !pv = !pv.offset((80 / 2) + (!this.walloffset.val / 2))
  -- point the pontvector in the direction of the offset
  !pv.direction = !dir
  -- move the pointvector to the offset position
  !startpos = !pv.offset(!this.postoffset.val)

  -- build the vertical bars as aid lines
  do !p from 1 to !bardims.size()
    !pos1 = !startpos.position
    --!pos1.up = !pos1.up - !this.lowoffs.val + !this.bottoverlap.val
    !pos1.up = !pos1.up - !this.lowoffs.val
    -- go and draw the aid boxes for individual posts
    !this.drawconnections(!bardims[!p],!p,!pos1)
    --!startpos = !startpos.offset(!this.dim$!<p>.val)
  enddo

endmethod
-----------------------------------------------------------------------------------------------

-----------------------------------------------------------------------------------------------
-- method to draw the connecting sections from the vertical to the wall as aid boxes
define method .drawconnections(!suppdims is ARRAY, !postnumber is REAL,!position is POSITION)
  -- method to draw aid boxes in the positions of the connections
  -- uses aid lines 461 to 900

  -- <RM> 27 Sept 2006 > -- Fix 5
  -- included an addition check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!this.support.datum
  --if the direction is left then use p10 of the atta else use p11
  if !attadir.eq('U') then
    -- if conndir.val = 1 then it's left
    if !this.conndir.val eq 1 then
      !diraidh = '11'
    else
      !diraidh = '10'
    endif
  else
    -- if conndir.val = 1 then it's left
    if !this.conndir.val eq 1 then
      !diraidh = '10'
    else
      !diraidh = '11'
    endif
  endif
  -- <RM> 27 Sept 2006 > -- End of Fix 5

  !boxpos = !position
  !ori = !this.support.datum.pdir[$!diraidh].wrt(/* )
  do !a from 1 to !suppdims.size()
    !boxno = 460 + !a
    !boxpos.up = !suppdims[!a]
    aid box number $!boxno position $!boxpos ori x is $!ori xlen $!this.walloffset ylen 80 zlen 80 filled off
  enddo

endmethod
-----------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------
define method .clearaids()
  aid clear arrow 361
  handle ANY
  endhandle
  do !a from 361 to 940
    aid clear box $!a
    handle ANY
      skip
    endhandle
  enddo
endmethod
-----------------------------------------------------------------------------------------------

-----------------------------------------------------------------------------------------------
define method .setplane()
  -- method to set the plane according to the offset distance

  -- if the connection direction is left use p11
  -- <RM> 27 Sept 2006 > -- Fix 6
  -- included an addition check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!this.support.datum
  --if the direction is left then use p10 of the atta else use p11
  if !attadir.eq('U') then
    if !this.conndir.val eq 1 then
      !dircon = '11'
    else
      !dircon = '10'
    endif
  else
    if !this.conndir.val eq 1 then
      !dircon = '10'
    else
      !dircon = '11'
    endif
  endif

  --if the post direction is left then use p11 of the atta else use p10
  if !attadir.eq('U') then
    if !this.sense.val eq 1 then $* its left
      !postdir = !this.support.datum.pdir[11].wrt(/* )
    else
      !postdir = !this.support.datum.pdir[10].wrt(/* )
    endif
  else
    if !this.sense.val eq 1 then $* its left
      !postdir = !this.support.datum.pdir[10].wrt(/* )
    else
      !postdir = !this.support.datum.pdir[11].wrt(/* )
    endif
  endif
  -- <RM> 27 Sept 2006 > -- end of Fix 6

  -- create a point vector to locate the end of the connection
  !pv = object POINTVECTOR()

  -- locate the point vector wrt to the post offset
  !pv.position = !!mdsFR16.support.datum.position.wrt(/* )
  !pv.direction = !postdir
  !pv = !pv.offset(!this.postoffset.val)

  -- locate the point vector wrt to the connection offset
  !pv.direction = !!mdsFR16.support.datum.pdir[$!dircon].wrt(/* )
  handle ANY
    !!alert.error('Datum atta not created')
    return
  endhandle
  !pp = !pv.offset(!!mdsFR16.walloffset.val + 80/ 2)
  !pp.direction = !pp.direction.opposite()
  !!mdsFR16.sidePlane = !pp.plane()
  !this.drawaids()

endmethod
-----------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------
-- method to check the vertical connections against the ubolts
define method .checkconns() is BOOLEAN
  !return = FALSE
  -- build an array of the ubolt positions these are the same height for all the bars
  !bararray = ARRAY()
  do !a values !this.bardims
    !line = object LINE()
    !u1 = !a - 10
    !u2 = !a + 10
    !line.startposition = n0 e0 u $!u1
    !line.endposition = n0 e0 u $!u2
    !bararray.append(!line)
  enddo

  -- loop round the vertical members
  !postarray = ARRAY()
  do !post from 1 to !this.nposts.val.real()
    !bracketarray = ARRAY()
    do !bracket from 1 to !this.localfitt[!post].size()
      !line = object LINE()
      !up = !this.localfitt[!post][!bracket]
      !u1 = !up - 40
      !u2 = !up + 40
      !line.startposition = n0 e0 u $!u1
      !line.endposition = n0 e0 u $!u2
      !bracketarray.append(!line)
    enddo
    !postarray.append(!bracketarray)
  enddo

  -- now we have two lots of arrays, we need to check for clashes
  do !post from 1 to !this.nposts.val.real()
    !brackets = !postarray[!post]
    do !a index !brackets
      --' Connection  ' & !a & ' At Elevation ' & !this.localfitt[!post][!a]
      do !b index !bararray
        !line1 = !brackets[!a]
        !line2 = !bararray[!b]
        !overlap = !line1.overlap(!line2)
        if !overlap.set() then $* we have a clash
          !message = 'Clash at Post ' & !post & ' Bracket ' & !a & ' At Elevation ' & !this.localfitt[!post][!a]
          !message = !message & ' Do You want to Continue Checking? '
          !return = TRUE
          if !!alert.confirm('$!message').boolean().not() then
            !message = 'Do You want to accept these values?'
            if !!alert.confirm('$!message').boolean().not() then
              return !return
            else
              return FALSE
            endif
          endif
        endif
      enddo
    enddo
  enddo
  return !return

endmethod

------------------------------------------------------------------------------------------------
define method .convtospecial()

  -- Access structure

  !!ce = !this.support.stru
  !spec = :fra.e_typ
  if !spec.upcase().neq('YES') and !spec.upcase().neq('NO') then
    !spec = 'NO'
  endif
  if !spec.upcase().eq('YES') then
    if !!alert.confirm('Are you sure you want to set this electrical special to a standard type').eq('YES') then
      :fra.e_typ 'NO'
    endif
  elseif !spec.upcase().eq('NO') then
    if !!alert.confirm('Are you sure you want to set this electrical standard to a special type').eq('YES') then
      :fra.e_typ 'YES'
    endif
  endif

endmethod

define method .connheight(!level is STRING)

  -- set the localfitt array which contains the connection levels
  if !level eq 'UPPER' then
    !this.localfitt[1][1] = !!mdsFR16.support.datum.position.wrt(/* ).up + !this.conntop.val
  else
    !this.localfitt[1][2] = !!mdsFR16.support.datum.position.wrt(/* ).up + !this.connbot.val
  endif
  !this.drawaids()
endmethod

define method .through()

  -- set the through position and reset the drawing aids afterwards
  !level = !!mdsFR16.support.datum.position.wrt(/* ).up
  Call !!mdsPosThro(!!mdsFR16)
  !newlevel = !!mdsFR16.support.datum.position.wrt(/* ).up
  !levelchange = !newlevel - !level
  do !a from 1 to !this.bardims.size()
    !this.bardims[$!a] = !this.bardims[$!a] + !levelchange
  enddo
  do !a from 1 to !this.localfitt[1].size()
    !this.localfitt[1][$!a] = !this.localfitt[1][$!a] + !levelchange
  enddo
  !srefName = !this.support.datum.name.before('/DATUM') + '/SREF'
  !!ce = !srefName.dbref()
  -- if the support has previously been created then we rebuild it after the level change
  -- this stores the despars and makes sure the support is regenerated in the correct place during a modify
  if desp[15] eq 1 then
    Call !!mdsCheckFR16Con('DIMENSION')
  endif
  !this.drawaids()
endmethod

define method .distcall()

  -- set the through select position and reset the drawing aids afterwards
  !level = !!mdsFR16.support.datum.position.wrt(/* ).up
  Call !!mdsPosDist(!!mdsFR16)
  !newlevel = !!mdsFR16.support.datum.position.wrt(/* ).up
  !levelchange = !newlevel - !level
  do !a from 1 to !this.bardims.size()
    !this.bardims[$!a] = !this.bardims[$!a] + !levelchange
  enddo
  do !a from 1 to !this.localfitt[1].size()
    !this.localfitt[1][$!a] = !this.localfitt[1][$!a] + !levelchange
  enddo
  !srefName = !this.support.datum.name.before('/DATUM') + '/SREF'
  !!ce = !srefName.dbref()
  -- if the support has previously been created then we rebuild it after the level change
  -- this stores the despars and makes sure the support is regenerated in the correct place during a modify
  var !createdflag desp[15]

  if !createdflag.string() eq '1' then
    Call !!mdsCheckFR16Con('DIMENSION')
  endif
  !this.drawaids()
endmethod
