--------------------------------------------------------------------------

define method .groupfill(!pressed is REAL)

-- Set group icons as selected

  !unusedbuttoncounter = 1

  !dtext = ARRAY()
  !rtext = ARRAY()

  do !setbuttons from 1 to !this.groups[$!pressed].size()

    !findmaster = !this.standard.rtext.findfirst(!this.groups[$!pressed][$!setbuttons])
    if !findmaster.unset().not() then
      !dtext.append(!this.standard.dtext[$!findmaster])
      !rtext.append(!this.standard.rtext[$!findmaster])
    endif

    !this.listgroups.dtext = !dtext
    !this.listgroups.rtext = !rtext

  enddo

-- Modify list desc text

  !numberOfStds = !this.listgroups.dtext.size().string()

  !this.listgroups.tag = !this.groupsdesc[$!pressed] + ' (' + !numberOfStds + ')'

  !this.setmaster()

endmethod
-- End of method definition for .groupfill(REAL)

--------------------------------------------------------------------------

define method .setmaster()

-- Set master list gadget in form

  !selectedFrame = !this.listgroups.rtext[$!this.listgroups.val]
  !findframe = !this.standard.rtext.findfirst(!selectedFrame)
  !this.standard.val = !findframe
-- Update plot file if needed
  call !!kactioncommands(!!mdsframe.listactions)

-- Set correct icon
  !frameType = !this.standard.rtext[!findframe]
  !this.hideicons()
  !iconname = !frameType.substring(1,4).lowcase()
  !this.$!iconname$n.visible = true

endmethod
-- End of method definition for .setmaster()

--------------------------------------------------------------------------

define method .hideicons()

  do !count from 1 to !this.availableframes
    if !count.string().length().eq(1) then
      !std = '0$!count'
    else
      !std = '$!count'
    endif
      !this.ft$!std$n.visible = false
        handle any
        endhandle
  enddo

endmethod
-- End of method definition for .hideicons()

-- Added method for defect 10598
define method .find(!gadget is GADGET,!string is STRING)

-- Try and find string in selection list

  do !loop from 1 to !gadget.dtext.size()
    if !gadget.dtext[$!loop].matchwild('*$!string*') then
-- Set found index
      !gadget.val = !loop
-- Get callback and call
      !callback = !gadget.callback
      $!callback
        handle any
        endhandle
      if !callback.eq('!this.setmaster()') then
        !!mdsframe.setmaster()
      endif
      return
    endif
  enddo

  !!alert.error('Unable to find string ' + !string)

endmethod
-- End of method definition for .find(GADGET,STRING)
define method .fromExistingAtta ()
  !!mdsIdPreliminarySupp(!this)
endmethod
