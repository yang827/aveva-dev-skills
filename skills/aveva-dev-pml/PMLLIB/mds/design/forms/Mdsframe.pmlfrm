-- updated this value in lieu of a new standard
--!this.availableframes = 61
--<wd>may2007<mds12>

--<dw>29feb2008 - DUN858 To allow for additional frames FT62 to FT65
  --<kp>nov2011          allow frames up to 71
  !this.availableframes = 71
--<dw>29feb2008 - end DUN858

-- Body of Form
  text .name     |Name: | at x0 y0.5 call |CALLIB NAMECHK _mdsframe_name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
call !!mdssupportform(!!mdsframe)
call !!mdssetsupp(!!mdsframe)
| width 20 name

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsautoname|
  exit

  button .autoname | | tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsautoname.getnextname(!this)|
  !this.autoname.setpopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!mdsidfltsite()|

  button .startgroup | | at xmax+1 ymin tooltip 'New Support Group' pixmap width 19 height 19 call |Call !!mdsgroup('NEW',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|

  path down
  vdist 0.1
  !length = !!mdsformfra
    handle NONE
    elsehandle ANY
      !length = 39
    endhandle

  list .standard |Standard support type:| at x0 Ymax+0.5 call |call !!kactioncommands(!!mdsframe.listactions)| width 62 length $!length
--  list .standard |Standard support type:| at x0 Ymax+0.5 call |call !!kactioncommands(!!mdsframe.listactions)| columns width 62 length $!length

-- Load icon button if needed
