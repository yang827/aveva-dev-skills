-- This Value represents the inclusive "FT" numbers for ALL the MDS FRAMEWORK STANDARDS
-- e.g. A value of "60" represents the MDS FRAMEWORK STANDARDS "FT01 to FT60" inclusive
--  !this.availableframes = 57
