      handle ANY
      endhandle

    --if !useiconsasgroups then

      do !count from 1 to 10
        path right
        if !count.eq(1) then
          button .b$!count toggle pixmap AT X0 ymin.standard call |!this.unselect($!count)| width 30 height 30
        else
          button .b$!count toggle pixmap call |!this.unselect($!count)| width 30 height 30
        endif
      enddo

-- Create buttons for selection of frame type icon
      do !count from 1 to $!this.availableframes

        if !count.string().length().eq(1) then
          !std = '0$!count'
        else
          !std = '$!count'
        endif

--$p png found for frame type ft$!std$n
        button .ft$!std pixmap at xmax form-size ymin anchor R+T width 40 hei 40
        !this.ft$!std$n.addPixmap(!!pml.getpathname('ft$!std$n.png'))
        handle ANY
        endhandle
      enddo

      list .listgroups |Standard support type:| at x0 Ymax+0.5 call |!this.setmaster()| width 62 length 10

    --else
-- Create selection icons
    --  if (defined(!!mdsiconsval)) then
    --    !to = !!mdsiconsval.real()
    --  else
    --    !to = 50
    --  endif
    --  do !count from 1 to !to
    --    path right
    --    if !count.eq(1) then
    --      !at = 'AT X0 ymin.standard'
    --    elseif !count.eq(11) or !count.eq(21) or !count.eq(31) or !count.eq(41) or !count.eq(51) then
    --      !at = 'AT X0 YMAX'
    --    else
    --    endif
    --    button .b$!count toggle pixmap $!at call |!this.unselect($!count)| width 30 height 30
    --  enddo
  -- endif
 -- endif

-- Bottom Line
  button .ok     |   OK   | at x0           ymax call |$$_suppfunction|
  path right
  button .view   | View...| at xmax+1         ymin Call |call !!mdsaddplot(!!mdsframe.standard, 'show',!!mdsframe)|
  path right
-- Modified for defect 10598
  text .find 'Find ' call |!this.find(!this.listgroups,!this.find.val)| width 10 string
  button .cancel | Cancel | at xmax form-size ymin call |call !!mdsresetautoname(!this)|

-- Form Members
-- Form Name of Support
  member .suppfunction is STRING

-- Form Name of Support
  member .suppform     is FORM

-- User replacement text for support name
  member .replacement  is STRING

-- Actions on list button
  member .listactions  is ARRAY

-- Groups for icons
  member .groups is ARRAY
  member .groupsdesc is ARRAY

  member .level is REAL

--<wd>02nov2006<mds12>
-- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
--<wd>02nov2006<mds12>

-- End form definition
exit

-- Actions to be taken on list gadget
  !!mdsframe.listactions[1] = |call !!mdsaddplot(!!mdsframe.standard, '',!!mdsframe)|
  !!mdsframe.listactions[2] = |call !!mdssupportform(!!mdsframe)|

-- Set icons
  !!mdsseticonback(!!mdsframe,'white')

--<wd>02nov2006<mds12>
-- Set the DEFAULT settings for the form Members
  !this.error = TRUE
  !this.emess = 'No MDS Frameworks available.'
--<wd>02nov2006<mds12>

--------------------------------------------------------------------------

-- Method to unselect other icons when one is selected
-- and select the correct line of the hidden standard gadget

define method .unselect(!pressed is REAL)

-- Unselect all icons

  do !unselect from 1 to 100
    !this.b$!unselect$n.val = false
      handle any
        break
      endhandle
  enddo

-- Select the pressed icon

  !this.b$!pressed$n.val = TRUE

-- Select the right line in the standard gadget
--     q var !pressed
  !!mdsframe.standard.val = !pressed

-- Fill in icons with group members

  !this.groupfill(!pressed)

-- Clear the find gadget
  !this.find.val = ''

endmethod
-- End of method definition for .unselect(REAL)

--------------------------------------------------------------------------

-- Method to display groups of framework in icon menu system

define method .groups()

-- Set pixmap descriptions
  !this.groupsdesc[1] = 'L Brackets'
  !this.groupsdesc[2] = 'Cantilevers/Posts'
  !this.groupsdesc[3] = 'Pedestals'
  !this.groupsdesc[4] = 'Frames'
  !this.groupsdesc[5] = 'Braced Brackets'
  !this.groupsdesc[6] = 'T Posts'
  !this.groupsdesc[7] = 'Miscellaneous'

--mjb >>> 28.03.06 <mds12> get groups from pprop of /MDS/STRUCTURE/DEFAULTS/FT09/GEN/FGRP (where FT09 is example)

--collect all data with dkey FGRP
--get name of e.g. FT09
--set group number based on pproperty e.g. pproperty LBKT = group number 1
--!this.groups[!groupnumber].append(!standardname)

  !this.groups[1] = ARRAY()
  !this.groups[2] = ARRAY()
  !this.groups[3] = ARRAY()
  !this.groups[4] = ARRAY()
  !this.groups[5] = ARRAY()
  !this.groups[6] = ARRAY()
  !this.groups[7] = ARRAY()

  var !datacoll coll all data with dkey eq 'FGRP' for /MDS/STRUCTURE/DEFAULTS

  var !standardnames eval name for all from !datacoll
  var !groups eval pprop for all from !datacoll

  do !i index !standardnames

    !group = !groups[!i].after(|( '|).before(|' )|)

    if !group.eq('LBKT') then
      -- Group 1 - L Brackets
      !groupnumber = 1
    elseif !group.eq('CAPO') then
      -- Group 2 - Cantilevers/Posts
      !groupnumber = 2
    elseif !group.eq('PDTL') then
      -- Group 3 - Pedestals
      !groupnumber = 3
    elseif !group.eq('FRAM') then
      -- Group 4 - Frames
      !groupnumber = 4
    elseif !group.eq('BBKT') then
      -- Group 5 - Braced Brackets
      !groupnumber = 5
    elseif !group.eq('TPST') then
      -- Group 6 - T Posts
      !groupnumber = 6
    elseif !group.eq('MISC') then
      -- Group 7 - Misc
      !groupnumber = 7
    endif

    !standardname = !standardnames[!i].after('/MDS/STRUCTURE/DEFAULTS/').before('/GEN/FGRP')

    !this.groups[!groupnumber].append(!standardname)

  enddo

-- Group 1 - L Brackets
