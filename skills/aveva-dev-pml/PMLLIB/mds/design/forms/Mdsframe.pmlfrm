--mjb <<< 27.03.06 <mds12> end of mod

  !!mdsframe.formtitle    = |Multi Discipline Frameworks|
  !!mdsframe.icontitle    = ||
  !!mdsframe.callback     = |call !!mdsiframe()|
  !!mdsframe.formrevision = | $Revision: 1.1.19.1 $ |

-- Add member for the number of icons for frameworks

  member .availableframes is REAL
  --MJB WAS 51

