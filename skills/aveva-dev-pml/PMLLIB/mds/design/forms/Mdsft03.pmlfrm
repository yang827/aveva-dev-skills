--
-- File: Mdsft03.pmlfrm
--   Type: Form Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Design
--   Replaces: FPS126
--
-- Author: I.Osborne
-- Created: Tue Jun 03
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 03
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!mdsft03

-- Define Form
setup form  !!mdsft03 at xr0 yr0 noquit

  !!mdsft03.formtitle    = ||
  !!mdsft03.icontitle    = ||
  !!mdsft03.callback     = ||
  !!mdsft03.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .fDatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFt03()|
      button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsft03)|
      text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsft03)|
      option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsft03)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .fCreate |Create| at x0 ymax width 31

      -- option .Size   |Size |    at x1 y1 call |Call !!MdsReSize(!!mdsft03)| width 20
      -- path down
      -- para .create text |Create by      |
      path right
      button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsft03,'-BAR-1','-V1')|
      button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCheckFt03Con('CURSOR')|
      button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCheckFt03Con('DIMENSION')|
      button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCheckFt03Con('CLEARANCE')|

--<dw>sep2007
      button .bracing  at xmax+0.1 ymin tooltip 'Bracing'                 pixmap width 18 height 18 call |!!mdsiaddbracing(!!mdsft03)|
      -- add buttons for compensations if all compensation options and templates are loaded
      !!mdsCompensationGadgets()
--<dw>sep2007
      para   .tCode   at x1 ymax+0.2 text |Support Code|
      para   .code   at xmax+0.5 ymin width 15 lines 1
      text   .dim1   |Dim 1     | at x1   ymax+0.2 width 16 is REAL format !!distanceFmt
      text   .dim2   |Dim 2     | at xmin ymax width 16 is REAL format !!distanceFmt

    exit
    -- add ref.support gadgets if unique naming is on
    !!mdsRefSupportGadgets()

    frame .fMisc |Options| at x0 ymax+0.1 width 31

      option .slide |Slide To Beam  |  at        ymax+0.2  call |$$_Slide| width 9

-- Icons Row 1

      button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsft03)|
      button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsft03)|
      button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsft03)|
      button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarFt03(_Support, 'NEW','DUMMY')|
      button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorft03()|
      button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsft03)|
      button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!mdsxalign(!!mdsft03)|
      button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsft03)|

-- Icons Row 2

      button .addPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |call !!mdscrft25(!!mdsft03)|
      button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!mdsdelft25(!!mdsft03)|
      button .rotate        at xmax+0.1 ymin tooltip 'Rotate  All Attas'        pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsft03,'!!MdsRotateft03()')|
      button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsft03)|
      button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!mdsnewdatum(!!mdsft03)|
      button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsft03,'FRAME')|
      button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsft03)|
      button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsft03)|

-- Icons Row 3

      button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsft03,'FLIP')|
      button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsft03,!!MdsModAt)|
      button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsft03)|
      button .nudge      at xmax+0.1 ymin tooltip 'Nudg Support' pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsft03)|
      button .spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsft03)|
      button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsft03)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
      button .viewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsft03,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsft03,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsft03,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsft03,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsft03)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsft03)|
      button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsft03,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
      button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
      button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|
      button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

    exit

  -- Bottom Line
    button .cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptFt03()|

  -- Form Members
    -- Support object
    member .support     is MDSSUPPORT

    -- Graphical representation
    member .repre       is ARRAY

    -- Form Storage for support restoration
    member .store       is ARRAY

    -- Form Storage for Packing Pieces for Support restoration
    member .ppack       is ARRAY

    -- Support object storage for support regeneration
    member .backup      is MDSSUPPORT

    -- Support Regeneration function
    member .regen       is STRING

    -- BedPlate Reference
    member .struBpref   is ARRAY

    -- BedPlate Reference
    member .storeBpref  is ARRAY

    -- Graphical dimensions
    member .graphicalDim is BOOLEAN

    -- Create by member
    member .method is STRING

    -- Blocked icons
    member .blockedIcons is STRING
    !this.blockedIcons = '13,41,42,56'

   -- mdstrimsctn object for EDG extending section ends to planes
    member .mdstrimsctn is MDSTRIMSCTN

-- End of form definition for !!mdsft03
exit

  -- Set background colour of pixmaps to white

    !!mdsSetIconBack(!!mdsft03,'white')

  -- Turn off blocked icons
    !!kResetActive(!!mdsft03,true)

  -- Populate option gadgets
    call !!mdsLoadOption(!!mdsft03.select)

    !dtext[1] = |Top|
    !dtext[2] = |Bottom   |
    !rtext[1] = |Call !!mdsSlideFt03('TOP')|
    !rtext[2] = |Call !!mdsSlideFt03('BTM')|
    !!mdsft03.slide.dtext = !dtext
    !!mdsft03.slide.rtext = !rtext

    !!mdsft03.regen = |Call !!mdsCheckFt03Con('DIMENSION')|


------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object MDSTRIMSCTN(!this)

endmethod
-- End of method definition for .edgentry()
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

  !!mdsft03.dim2.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,0)

-- now reset the despars on the sref atta
  !sref = !this.support.stru.name & '/SREF'
  !!ce = !sref.dbref()

  !!mdsDacControl(true)
  DESPAR $!!mdsft03.dim1.val $!!mdsft03.dim2.val
  !!mdsDacControl(FALSE)

-- Show dimensions on graphics if required
  if !!mdsft03.graphicalDim then
    !!mdsshowdim(!!mdsft03)
  endif

endmethod
-- End of method definition for .resetdims()
------------------------------------------------------------------------------------
