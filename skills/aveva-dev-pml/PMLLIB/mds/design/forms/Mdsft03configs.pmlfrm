--
-- File:		Mdsft03configs.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS126W
--
-- Author:		I.Osborne
-- Created:		Tue Jun 03
--
--
-- Description:
-- Form Definition for different Configurations on Frame Type 03
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFt03Configs

-- Define Form
Setup Form  !!MdsFt03Configs

  !!MdsFt03Configs.formtitle    = ||
  !!MdsFt03Configs.icontitle    = ||
  !!MdsFt03Configs.Callback     = |Call !!MdsIFt03Configs()|
  !!MdsFt03Configs.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

    -- Create Datum
    frame .FConfig |Support Configurations| at x0 ymax

      button .Opt1 pixmap width 120 height 120 Call |Call !!MdsSetFt03Con(2)|
      path right
      hdist 1
      button .Opt2 pixmap width 120 height 120 Call |Call !!MdsSetFt03Con(3)|
      button .Opt3 pixmap width 120 height 120 Call |Call !!MdsSetFt03Con(4)|

      para .Text1 at xmin_Opt1 ymax_Opt1 text |Above beam|
      para .Text2 at xmin_Opt2 ymin      text |Onto column|
      para .Text3 at xmin_Opt3 ymin      text |To beam|

    exit

  -- Bottom Line
    button .Cancel at xmax-size ymax+0.3 | Cancel | cancel

-- End form definition
exit

  -- Set Pixmaps

    !!Mdsft03configs.opt1.addPixmap(!!PML.getPathName('ft03_1.png'))
    !!mdsft03configs.opt2.addPixmap(!!PML.getPathName('ft03_2.png'))
    !!mdsft03configs.opt3.addPixmap(!!PML.getPathName('ft03_3.png'))

  !!MdsFt03Configs.Opt1.background = 'black'
  !!MdsFt03Configs.Opt2.background = 'black'
  !!MdsFt03Configs.Opt3.background = 'black'

-- End of file Mdsft03configs.frm
