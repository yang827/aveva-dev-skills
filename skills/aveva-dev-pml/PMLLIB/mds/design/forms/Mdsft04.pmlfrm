--
-- File:    Mdsft04.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FPS127
--
-- Author:    I.Osborne
-- Created:   Mon Jun 23
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 04
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!mdsFt04

-- Define Form
setup form  !!mdsFt04 at xr0 yr0 noquit

  !!mdsFt04.formtitle    = ||
  !!mdsFt04.icontitle    = ||
  !!mdsFt04.callback     = ||
  !!mdsFt04.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .fDatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFt04()|
      button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFt04)|
      text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFt04)|
      option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFt04)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .fCreate |Create| at x0 ymax width 31

      -- option .Size   |Size |    at x1 y1 call |Call !!mdsReSize(!!mdsFt04)| width 20
      path right
      button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFt04,'-BAR-1','-V1')|
      button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCheckFt04Con('CURSOR')|
      button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCheckFt04Con('DIMENSION')|
      button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCheckFt04Con('CLEARANCE')|

--<dw>sep2007
      button .bracing  at xmax+0.1 ymin tooltip 'Bracing'                 pixmap width 18 height 18 call |!!mdsiaddbracing(!!mdsFt04)|
      -- add buttons for compensations if all compensation options and templates are loaded
      !!mdsCompensationGadgets()
--<dw>sep2007
      para   .tCode   at x1 ymax+0.2 text |Support Code|
      para   .code   at xmax+0.5 ymin width 15 lines 1
      text   .dim1   |Dim 1     | at x1   ymax+0.2 width 16 is REAL format !!distanceFmt
      text   .dim2   |Dim 2     | at xmin ymax width 16 is REAL format !!distanceFmt

    exit

    -- add ref.support gadgets if unique naming is on
    !!mdsRefSupportGadgets()

    frame .fMisc |Options| at x0 ymax+0.1 width 31

      option .slide |Slide To Beam  |  at        ymax+0.2  call |$$_Slide| width 9

-- Icons Row 1

      button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsFt04)|
      button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsFt04)|
      button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsFt04)|
      button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarFt04(_Support, 'NEW','DUMMY')|
      button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorFt04()|
      button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsFt04)|
      button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!mdsxalign(!!mdsFt04)|
      button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsFt04)|

-- Icons Row 2

      button .addPack       at x1       ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |call !!mdscrft25(!!mdsFt04)|
      button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!mdsdelft25(!!mdsFt04)|
      button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsFt04,'!!mdsRotateFt04()')|
      button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsFt04)|
      button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!mdsnewdatum(!!mdsFt04)|
      button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFt04,'FRAME')|
      button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsFt04)|
      button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsFt04)|

-- Icons Row 3

      button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsFt04,'FLIP')|
      button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsFt04,!!mdsModAt)|
      button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsFt04)|
      button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsFt04)|
      button .spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsFt04)|
      button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsFt04)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
      button .viewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt04,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt04,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt04,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt04,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsFt04)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsFt04)|
      button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsFt04,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
      button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
      button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
      button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|
      button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

    exit

  -- Bottom Line
    button .cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
    button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptFt04()|

  -- Form Members
    -- Support object
    member .support     is MDSSUPPORT

    -- Graphical representation
    member .repre       is ARRAY

    -- Form Storage for support restoration
    member .store       is ARRAY

    -- Form Storage for Packing Pieces for Support restoration
    member .ppack       is ARRAY

    -- Support object storage for support regeneration
    member .backup      is MDSSUPPORT

    -- Support Regeneration function
    member .regen       is STRING

    -- BedPlate Reference
    member .struBpref   is ARRAY

    -- BedPlate Reference
    member .storeBpref  is ARRAY

    -- Graphical dimensions
    member .graphicalDim is BOOLEAN

    -- Create by member
    member .method is STRING

    -- Blocked icons
    member .blockedIcons is STRING
    !this.blockedIcons = '13,41,42,56'

   -- mdstrimsctn object for EDG extending section ends to planes
    member .mdstrimsctn is MDSTRIMSCTN


-- End form definition

exit

  -- Set background colour of pixmaps to white

    !!mdsSetIconBack(!!mdsFt04,'white')

  -- Turn off blocked icons
    !!kResetActive(!!mdsFt04,true)

  -- Populate option gadgets
    call !!mdsLoadOption(!!mdsFt04.select)

    !dText[1] = |Top|
    !dText[2] = |Bottom   |
    !rText[1] = |Call !!mdsSlideFt04('TOP')|
    !rText[2] = |Call !!mdsSlideFt04('BTM')|
    !!mdsFt04.slide.dText = !dText
    !!mdsFt04.slide.rText = !rText
    !!mdsFt04.regen = |Call !!mdsCheckFt04Con('DIMENSION')|

------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object MDSTRIMSCTN(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

  !!mdsFt04.dim2.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,1)
-- now reset the despars on the sref atta
  !sref = !this.support.stru.name & '/SREF'
  !!ce = !sref.dbref()

  !!mdsDacControl(true)
  DESPAR $!!mdsFt04.dim1.val $!!mdsFt04.dim2.val
  !!mdsDacControl(FALSE)

-- Show dimensions on graphics if required
  if !!mdsFt04.graphicalDim then
    !!mdsshowdim(!!mdsFt04)
  endif

endmethod
------------------------------------------------------------------------------------
