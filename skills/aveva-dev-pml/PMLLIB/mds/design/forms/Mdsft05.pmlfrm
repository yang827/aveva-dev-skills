--
-- Description:
-- Form Definition for Frameworks Frame Type 05
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!MdsFt05

-- Define Form
setup form  !!MdsFt05 at xr0 yr0 noquit

  !!MdsFt05.formtitle    = ||
  !!MdsFt05.icontitle    = ||
  !!MdsFt05.callback     = ||
  !!MdsFt05.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatFt05()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!MdsFt05)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!MdsFt05)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!MdsFt05)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size | at x1 y1 call |Call !!MdsReSize(!!MdsFt05)| width 20
      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFt05,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt05('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt05('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt05('CLEARANCE')|

--<dw>sep2007
      button .bracing  at xmax+0.1 ymin tooltip 'Bracing' pixmap width 18 height 18 call |!!mdsiaddbracing(!!MdsFt05)|
--<dw>sep2007
      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1     | at x1   ymax+0.2 width 16 is real format !!DistanceFmt
      text   .Dim2   |Dim 2     | at xmin ymax width 16 is real format !!DistanceFmt

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsFt05)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsFt05)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsFt05)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Upright'  pixmap width 18 height 18 call |Call !!MdsAddBarFt05(_Support, 'NEW','DUMMY')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorFt05()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsFt05)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsFt05)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsFt05)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25  tooltip 'Add Packer'         pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsFt05)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsFt05)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsFt05,'!!MdsRotateFt05()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFT05)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsFt05)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFt05,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsFt05)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsFt05)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFt05,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsFt05,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFt05)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFt05)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFt05)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFt05)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT05,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT05,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFT05,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT05,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFt05)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFt05)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFt05,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|
      button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptFt05()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,13,41,42,56'

    -- mdstrimsctn object for EDG extending section ends to planes
    member .mdstrimsctn is MDSTRIMSCTN

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFT05,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsft05,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!MdsFt05.Select)

    !!MdsFt05.Regen = |Call !!MdsCreateFt05('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

define method .edgentry()

  !this.mdstrimsctn = object mdstrimsctn(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

 if !this.mdstrimsctn.sctn.name.match('BAR-1').gt(0) then
    !!Mdsft05.Dim1.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,1)
 elseif   !this.mdstrimsctn.sctn.name.match('V1').gt(0) then
    !!Mdsft05.Dim2.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,0)
 endif
 -- now reset the despars on the sref atta
 !sref = !this.support.stru.name & '/SREF'
 !!CE = !sref.dbref()

 !!MdsDacControl(true)
 DESPAR $!!Mdsft05.Dim1.Val $!!Mdsft05.Dim2.Val
 !!MdsDacControl(FALSE)

 -- Show dimensions on graphics if required
  if !!MdsFt05.GraphicalDim then
    !!Mdsshowdim(!!Mdsft05)
  endif

endmethod


-- End of file Mdsft05.frm
