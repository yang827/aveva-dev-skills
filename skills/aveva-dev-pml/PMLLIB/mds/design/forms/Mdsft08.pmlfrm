--
-- File:    Mdsft08.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FPS131
--
-- Author:    I.osborne
-- Created:   Mon Jun 30
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 08
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!mdsFt08

-- Define Form
setup form  !!mdsFt08 at xr0 yr0 noquit

  !!mdsFt08.formtitle    = ||
  !!mdsFt08.icontitle    = ||
  !!mdsFt08.callback     = ||
  !!mdsFt08.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFt08()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFt08)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFt08)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFt08)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  -- Creation
  frame .fCreate |Create| at x0 ymax width 31

    -- option .size   |Size | at x1 y1 call |Call !!mdsReSize(!!mdsFt08)| width 20

    path right
    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFt08,'-BAR-1','-V1')|
    button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreateFt08('CURSOR')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreateFt08('DIMENSION')|
    button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreateFt08('CLEARANCE')|

    --<dw>sep2007
    button .bracing  at xmax+0.1 ymin tooltip 'Bracing'                 pixmap width 18 height 18 call |!!mdsiaddbracing(!!mdsFt08)|

      -- add buttons for compensations if all compensation options and templates are loaded
      !!mdsCompensationGadgets()

    --<dw>sep2007
    para   .tCode   at x1 ymax+0.2 text |Support Code|
    para   .code   at xmax+0.5 ymin width 15 lines 1
    text   .dim1   |Dim 1 |     at x1   ymax+0.2 width 14 is REAL format !!distanceFmt
    text   .dim2   |Dim 2 |     at xmin ymax call |!!mdsFt08.dim3.setfocus()| width 14 is REAL format !!distanceFmt
    text   .dim3   |Dim 3 |     at xmin ymax width 14 is REAL format !!distanceFmt
    text   .dim4   |Dim 4 |     at xmin ymax width 14 is REAL format !!distanceFmt
    button .revd1 at xmax_dim1+1 ymax_dim1-0.7 tooltip 'Reverse Dimensions' pixmap width 28 height 28 call |Call !!mdsRevDims(_Dim1, _Dim2, 'Call !!mdsCreateFt08(''DIMENSION'')')|
    button .revd2 at xmax_dim3+1 ymax_dim3-0.7 tooltip 'Reverse Dimensions' pixmap width 28 height 28 call |Call !!mdsRevDims(_Dim3, _Dim4, 'Call !!mdsCreateFt08(''DIMENSION'')')|
    --toggle .lock1 at xmax_dim1 ymin_dim1
    --toggle .lock2 at xmax_dim1 ymin_dim2
    --toggle .lock3 at xmax_dim1 ymin_dim3
    --toggle .lock4 at xmax_dim1 ymin_dim4

  exit

  -- add ref.support gadgets if unique naming is on
  !!mdsRefSupportGadgets()

  frame .fMisc |Options| at x0 ymax+0.1 width 31

    -- Icons Row 1

    button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsFt08)|
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsFt08)|
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsFt08)|
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarFt08(_Support, 'NEW')|
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorFt08()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsFt08)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsFt08)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsFt08)|

    -- Icons Row 2

    button .addPack       at x1 ymax+0.25  tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!mdscrft25(!!mdsFt08)|
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!mdsdelft25(!!mdsFt08)|
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsFt08,'!!mdsRotateFt08()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsFt08)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!mdsnewdatum(!!mdsFt08)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFt08,'FRAME')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsFt08)|
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsFt08)|

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsFt08,'FLIP')|
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsFt08,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsFt08)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsFt08)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsFt08)|
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsFt08)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25  tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt08,'CONNECT','')|
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt08,'MODIFY','')|
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt08,'FORCECONNECT','')|
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFt08,'DISCONNECT','ERROR')|
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsFt08)|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsFt08)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsFt08,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip  'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip 'Re-connect' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
    button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|
    button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

  exit
  -----------------------------------------------------------------------------

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptFt08()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Form Storage for Packing Pieces for Support restoration
  member .ppack       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING
  !this.blockedIcons = '2,13,41,42,56'

  -- mdstrimsctn object for EDG extending section ends to planes
  member .mdstrimsctn is MDSTRIMSCTN

  -- End form definition
exit

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFt08,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFt08,true)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFt08.select)

!!mdsFt08.regen = |Call !!mdsCreateFt08('DIMENSION')|

------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object MDSTRIMSCTN(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

  if !this.mdstrimsctn.sctn.name.match('V2').gt(0) then
    !!mdsFt08.dim3.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,0)
  elseif !this.mdstrimsctn.sctn.name.match('V1').gt(0) then
    !!mdsFt08.dim4.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,0)
  endif

  -- now reset the despars on the sref atta

  !sref = !this.support.stru.name & '/SREF'
  !!ce = !sref.dbref()

  !!mdsDacControl(true)
  DESPAR $!!mdsFt08.dim1.val $!!mdsFt08.dim2.val $!!mdsFt08.dim3.val $!!mdsFt08.dim4.val
  !!mdsDacControl(FALSE)

  -- Show dimensions on graphics if required

  if !!mdsFt08.graphicalDim then
    !!mdsshowdim(!!mdsFt08)
  endif

endmethod
------------------------------------------------------------------------------------
