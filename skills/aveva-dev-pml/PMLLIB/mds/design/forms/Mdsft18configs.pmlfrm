--
-- File:		Mdsft18configs.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS142W
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 27 August 1997
--
--
-- Description:
-- Form Definition for different Configurations on Frame Type 18
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFt18Configs

-- Define Form
Setup Form  !!MdsFt18Configs

  !!MdsFt18Configs.formtitle    = ||
  !!MdsFt18Configs.icontitle    = ||
  !!MdsFt18Configs.Callback     = |Call !!MdsIFt18Configs()|
  !!MdsFt18Configs.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

    -- Create Datum
    frame .FConfig |Support Configurations| at x0 ymax

      button .Opt1 pixmap width 120 height 120 Call |Call !!MdsSetFt18Con(2)|
      path right
      hdist 1
      button .Opt2 pixmap width 120 height 120 Call |Call !!MdsSetFt18Con(3)|
      button .Opt3 pixmap width 120 height 120 Call |Call !!MdsSetFt18Con(4)|

      para .Text1 at xmin_Opt1 ymax_Opt1 text |Above beam|
      para .Text2 at xmin_Opt2 ymin      text |Onto column|
      para .Text3 at xmin_Opt3 ymin      text |To beam|

    exit

  -- Bottom Line
    button .Cancel at xmax-size ymax+0.3 | Cancel | cancel

-- End form definition
exit

  -- Set Pixmaps

  !!mdsft18configs.Opt1.addPixmap(!!PML.getPathName('ft18_1.png'))
  !!mdsft18configs.Opt2.addPixmap(!!PML.getPathName('ft18_2.png'))
  !!mdsft18configs.Opt3.addPixmap(!!PML.getPathName('ft18_3.png'))

  !!MdsFt18Configs.Opt1.background = 'black'
  !!MdsFt18Configs.Opt2.background = 'black'
  !!MdsFt18Configs.Opt3.background = 'black'

-- End of file Mdsft18configs.frm
