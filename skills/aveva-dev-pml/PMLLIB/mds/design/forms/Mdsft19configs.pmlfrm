--
-- File:		Mdsft19configs.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS142W
--
-- Author:		Wayne Dodwell
-- Created:		Monday 15 September 1997
--
--
-- Description:
-- Form Definition for different Configurations on Frame Type 19
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFt19Configs

-- Define Form
Setup Form  !!MdsFt19Configs

  !!MdsFt19Configs.formtitle    = ||
  !!MdsFt19Configs.icontitle    = ||
  !!MdsFt19Configs.Callback     = |Call !!MdsIFt19Configs()|
  !!MdsFt19Configs.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

    -- Create Datum
    frame .FConfig |Support Configurations| at x0 ymax

      button .Opt1 pixmap width 120 height 120 Call |Call !!MdsSetFt19Con(2)|
      path right
      hdist 1
      button .Opt2 pixmap width 120 height 120 Call |Call !!MdsSetFt19Con(3)|
      button .Opt3 pixmap width 120 height 120 Call |Call !!MdsSetFt19Con(4)|

      para .Text1 at xmin_Opt1 ymax_Opt1 text |Below beam|
      para .Text2 at xmin_Opt2 ymin      text |Onto column|
      para .Text3 at xmin_Opt3 ymin      text |To beam|


    exit

  -- Bottom Line
    button .Cancel at xmax-size ymax+0.3 | Cancel | cancel

-- End form definition
exit

  -- Set Pixmaps


    !!mdsft19configs.Opt1.addPixmap(!!PML.getPathName('ft19_1.png'))
    !!mdsft19configs.Opt2.addPixmap(!!PML.getPathName('ft19_2.png'))
    !!mdsft19configs.Opt3.addPixmap(!!PML.getPathName('ft19_3.png'))

  !!MdsFt19Configs.Opt1.background = 'black'
  !!MdsFt19Configs.Opt2.background = 'black'
  !!MdsFt19Configs.Opt3.background = 'black'

-- End of file Mdsft19configs.frm
