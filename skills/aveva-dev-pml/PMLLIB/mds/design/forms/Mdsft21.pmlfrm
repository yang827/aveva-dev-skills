--
-- File:		Mdsft21.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS149
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 28th October 1997
--
--
-- Description:
-- Form Definition for Framework Frame Type 'FT21'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
kill !!Mdsft21

-- Define Form
setup form  !!Mdsft21 at xr0 yr0 noquit

    !!Mdsft21.formtitle    = ||
    !!Mdsft21.icontitle    = ||
    !!Mdsft21.callback     = ||
    !!Mdsft21.formrevision = | $Revision: 1.1.19.1 $ |

-- Support Name Data at top of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

-- Create and Position Datum Atta
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatft21()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |call !!Mdsposdist(!!Mdsft21)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |call !!Mdsposthro(!!Mdsft21)|
      option .Select             at xmax+1 ymin            call |call !!Mdsthroselect(!!Mdsft21)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

--  Framework Creation
    frame .FCreate |Create| at x0 ymax width 31

      rgroup .type   |Type | at x1 y1 call |call !!Mdstagft21(!!Mdsft21)| horizontal
        add tag ' Square ' select 'S'
        add tag ' True   ' select 'T'
      exit
      -- option .Size   |Size | at x1 ymax+0.5 call |call !!Mdsresize(!!Mdsft21)| width 20
      -- path down
      -- para .create text |Create by      |
      -- path right
      -- button .CreateByCur tooltip 'Cursor' pixmap width 19 height 19 call ||
      -- button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call ||
      -- button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call ||

      path right
      button .SetSize     at x1 ymax+0.5  tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFt21,'-BAR-1','')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call ||
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt21('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call ||


      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      para   .Dim1p at x1 ymax+0.2 text |Dim 1     | width 10  lines1
      para   .Dim1  at xmax  ymin  text |0| width 16  lines1

    exit

-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------

--  Miscellaneous Options
    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |call !!kactioncommands(!!Mdsft21.action)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorft21()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!Mdsft21)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!Mdsft21)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!Mdsft21)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!Mdsft21)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!Mdsft21)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!Mdsft21,'!!MdsRotateft21()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFT21)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!Mdsft21)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!Mdsft21,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!Mdsft21)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!Mdsft21)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!Mdsft21,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!Mdsft21,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!Mdsft21)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!Mdsft21)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!Mdsft21)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFt21)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFt21)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFt21)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!Mdsft21,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|

    exit

-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------

-- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |call !!Mdsacceptft21()|

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

-- Additional Form Members Not Displayed
----------------------------------------
-- Support object
    member .Support     is MdsSUPPORT

-- Graphical representation
    member .Repre       is array

-- Form Storage for support restoration
    member .Store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

-- BedPlate Reference
    member .StruBpref   is array

-- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

-- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

-- Support Regeneration function
    member .Regen       is string

-- .Add button callback
    member .action      is  array

-- .Type rgroup callback
    member .rgaction      is  array

    -- Blocked icons
    member .BlockedIcons is string
    -- !This.BlockedIcons = '2,6,7,10,13,16,17,18,20,21,22,28,29,30,31,32,34,35,41,42'
       !This.BlockedIcons = '2,6,7,10,13,16,18,20,21,22,27,28,29,30,31,32,34,35,41,42,56,64,65'
-- End form definition

exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFT21,'white')

  -- Turn off blocked icons
    !!KResetActive(!!mdsft21,true)

-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------

-- Populate option gadgets
--------------------------

--> Modified - <wd> - 3sep1998
-- Set Callbacks for the form member '.rgaction' called via the
-- '.type' rgroup gadget and its callback function !!Mdstagft21()
    !!Mdsft21.rgaction.clear()
    !!Mdsft21.rgaction[1] = 'call !!Mdssetbopdir(_form)'
    !!Mdsft21.rgaction[2] = 'call !!Mdscreateft21(''DIMENSION'')'
--< Modified - <wd> - 3sep1998

-- Set Callbacks for the .Add button
    !!Mdsft21.action.clear()
    !!Mdsft21.action[1] = 'call !!Mdsaddpipe(!!Mdsft21)'

--  Set .Select gadget Options for positioning Datum Atta.
    call !!Mdsloadoption(!!Mdsft21.Select)

-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------

-- Set .Regen gadget callback
    !!Mdsft21.regen = |call !!Mdscreateft21('DIMENSION')|

-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false


-- End of file Mdsft21.frm

