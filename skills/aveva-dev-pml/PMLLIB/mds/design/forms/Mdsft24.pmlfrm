--
-- File:  Mdsft24.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:          FPS148
--
-- Author:  I.osborne
-- Created:  Tue Aug 05
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 24
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsFt24

-- Define Form
setup form  !!mdsFt24 at xr0 yr0 noquit

  !!mdsFt24.formtitle    = ||
  !!mdsFt24.icontitle    = ||
  !!mdsFt24.callback     = ||
  !!mdsFt24.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFt24()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFt24)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFt24)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFt24)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  -- Creation
  frame .fCreate |Create| at x0 ymax width 31

    --option .size   |Size | at x1  y1       call |Call !!mdsLengthFt24(_Size)
    --Call !!mdsReSize(!!mdsFt24)| width 20
    --path down

    --para .create text |Create by      |
    --path right

    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFt24,'-BAR-1','')
    call !!mdsReSize(!!mdsFt24)|
    button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreateFt24('CURSOR')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreateFt24('DIMENSION')|
    button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreateFt24('CLEARANCE')|

    -- add buttons for compensations if all compensation options and templates are loaded
    !!mdsCompensationGadgets()

    -- button .createByCur tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreateFt24('CURSOR')|
    -- button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreateFt24('DIMENSION')|
    -- button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreateFt24('CLEARANCE')|

    para   .tCode   at x1 ymax+0.2 text |Support Code|
    para   .code   at xmax+0.5 ymin width 15 lines 1
    option .dim1   |Dim 1     | at x1  ymax+0.2 call |Call !!mdsReSize(!!mdsFt24)| width 14
    text   .dim1Text |Dim 1     | at xmin ymin width 16 is REAL format !!distanceFmt
    text   .dim2   |Dim 2     | at x1  ymax+0.2 width 16 is REAL format !!distanceFmt

  exit

  -- add ref.support gadgets if unique naming is on
  !!mdsRefSupportGadgets()

  frame .fMisc |Options| at x0 ymax+0.1 width 31

    -- Icons Row 1

    button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsFt24)|
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsFt24)|
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsFt24)|
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarFt24(_Support, 'NEW')|
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorFt24()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsFt24)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsFt24)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsFt24)|

    -- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!mdscrft25(!!mdsFt24)|
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!mdsdelft25(!!mdsFt24)|
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsFt24,'!!mdsRotateFt24()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsFt24)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!mdsnewdatum(!!mdsFt24)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFt24,'FRAME')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsFt24)|
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsFt24)|

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsFt24,'FLIP')|
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsFt24,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsFt24)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsFt24)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsFt24)|
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsFt24)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsFt24)|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsFt24)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsFt24,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
    button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptFt24()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Form Storage for Packing Pieces for Support restoration
  member .ppack       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING
  --<kp>dec2011
  !this.blockedIcons = '8,10,13,16,18,22,24,41,42,56'

  -- End form definition
exit

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFt24,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFt24,true)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFt24.select)

!!mdsFt24.regen = |Call !!mdsCreateFt24('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
-- !this.hiddenCancel.active = false
