--
-- File:		Mdsft28.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS152
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 4th November1997
--
--
-- Description:
-- Form Definition for Beam Penetration Framework Frame Type 'FT28'
--
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Delete existing form definition
  kill !!Mdsft28

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Form
setup form  !!Mdsft28 at xr0 yr0 noquit

    !!Mdsft28.formtitle    = ||
    !!Mdsft28.icontitle    = ||
    !!Mdsft28.callback     = ||
    !!Mdsft28.formrevision = | $Revision: 1.1.19.1 $ |

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Support Name Data at top of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Create and Position Datum Atta
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatft28()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |call !!Mdsposdist(!!Mdsft28)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |call !!Mdsposthro(!!Mdsft28)|
      option .Select             at xmax+1 ymin            call |call !!Mdsthroselect(!!Mdsft28)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

--  Framework Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size | at x1 y1 call |call !!Mdsresize(!!Mdsft28)| width 20
      -- path down

     -- para .create text |Create by      |
      -- path right

      -- button .CreateByCur tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt28('CURSOR')|
      -- button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt28('DIMENSION')|
      -- button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt28('CLEARANCE')|

      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFt28,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt28('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt28('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt28('CLEARANCE')|

      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Clear  |Clearance 1 | at x1 ymax+0.2    width 14 is real format !!DistanceFmt
      text   .Fcler  |Clearance 2 | at x1 ymax+0.2    width 14 is real format !!DistanceFmt

    exit

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

--  Miscellaneous Options
    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsFt28)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsFt28)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsFt28)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarFt28(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorFt28('BUTTON')|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFt28()|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!Mdsft28)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsFT28)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!Mdsft28)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!Mdsft28)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsFT28,'!!MdsRotateFt28()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFT28)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!Mdsft28)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFt28,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsFt28)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsFt28)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFt28,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsFt28,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFt28)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFt28)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFt28)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFt28)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT28,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT28,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFT28,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT28,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFt28)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFt28)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFT28,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld   at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|

    exit

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |call !!Mdsacceptft28()|

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

-- Additional Form Members Not Displayed
----------------------------------------
-- Support object
    member .Support     is MdsSUPPORT

-- Graphical representation
    member .Repre       is array

-- Form Storage for support restoration
    member .Store       is array

-- BedPlate Reference
    member .StruBpref   is array

-- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

-- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

-- Support Regeneration function
    member .Regen       is string

-- .Add button callback
    member .action      is  array

-- Despar 3 - Distance from CL of Picked BEAM to STRU ORIGIN
    member .desp3       is real

-- Despar 4 - Pline 'NA' Direction of Picked BEAM
    member .desp4       is string

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,3,6,7,9,10,13,15,17,18,19,20,21,22,23,28,29,30,31,32,34,35,41,42,56,65'

-- End form definition

exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFT28,'white')

  -- Turn off blocked icons
    !!KResetActive(!!mdsft28,true)

--  Set .Select gadget Options for positioning Datum Atta.
    call !!Mdsloadoption(!!Mdsft28.Select)

-- Set .Regen gadget callback
    !!Mdsft28.regen = ||


-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdsft28.frm
