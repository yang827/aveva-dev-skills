-- Kill existing form definition
Kill !!mdsFT29

-- Define Form
setup form  !!mdsFT29 at xr0 yr0 noquit

  !!mdsFT29.formtitle    = ||
  !!mdsFT29.icontitle    = ||
  !!mdsFT29.callback     = ||
  !!mdsFT29.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatft29()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFT29)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFT29)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFT29)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  -- Creation
  frame .fCreate |Create| at x0 ymax width 31

    path right
    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFT29,'-BAR-1','-V1')|
    button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreateFt29('CURSOR')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreateFt29('DIMENSION')|
    button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreateFt29('CLEARANCE')|

    para   .tCode   at x1 ymax+0.2 text |Support Code|
    para   .code   at xmax+0.5 ymin width 15 lines 1
    text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is REAL format !!distanceFmt
    text   .dim2   |Dim 2     | at xmin ymax width 16 is REAL format !!distanceFmt
    para   .grate at xmin ymax text 'Grating bolts'
    path right
    toggle .grating '' call '!this.setgrating(!this.grating.val)'


  exit

  frame .fMisc |Options| at x0 ymax+0.1 width 31

    -- Icons Row 1

    button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsFT29)|
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsFT29)|
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsFT29)|
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarft29(_Support, 'NEW')|
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorft29()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsFT29)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsFT29)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsFT29)|

    -- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!mdscrft25(!!mdsFT29)|
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!mdsdelft25(!!mdsFT29)|
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsFT29,'!!mdsRotateft29()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsFT29)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!mdsnewdatum(!!mdsFT29)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFT29,'FRAME')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsFT29)|
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsFT29)|

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsFT29,'FLIP')|
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsFT29,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsFT29)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsFT29)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsFT29)|
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsFT29)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT29,'CONNECT','')|
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT29,'MODIFY','')|
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT29,'FORCECONNECT','')|
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT29,'DISCONNECT','ERROR')|
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsFT29)|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsFT29)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsFT29,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .addweld   at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
    button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptft29()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Form Storage for Packing Pieces for Support restoration
  member .ppack       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Create by member
  member .method is STRING

  -- Blocked icons
  member .blockedIcons is STRING

  --<wd>nov2004
  --    !this.blockedIcons = '2,6,7,8,10,11,12,13,15,19,20,21,22,23,35,37,38,41,42,54,56'
  !this.blockedIcons = '2,6,7,10,11,12,13,15,19,20,21,22,23,35,37,38,41,42,54,56'
  --<wd>nov2004


  -- End form definition
exit

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFT29,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFT29,true)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFT29.select)

!!mdsFT29.regen = |Call !!mdsCreateFt29('DIMENSION')|

------------------------------------------------------------------------------------
define method .setgrating(!val is BOOLEAN)

  -- if the support has not been created yet then return without doing anything
  !!ce = !this.support.stru
  subs1
  handle any
    return
  endhandle
  !stype = !this.support.atta[2].stype
  handle any
    return
  endhandle
  !supname = !this.support.stru.name

  !struname = '/MDS/' & !stype.replace('-','/')
  !template = !struname.dbref()

  if !!ce.name.match('SUBS2').gt(0) then
    !type = 'B' !newtype = 'W'
  else
    !type = 'W' !newtype = 'B'
  endif
  !!mdsDacControl(true)
  if !val then  $* grating is on
    if !type neq 'B' then $* then its already there
      !ori = !!ce.orientation
      !pos = !!ce.position
      delete subs
      new subs $!supname$n/SUBS2 copy subs 2 of $!template
      !!ce.orientation = !ori
      !!ce.position = !pos
    endif
  else
    if !type neq 'W' then $* then its already there
      !ori = !!ce.orientation
      !pos = !!ce.position
      delete subs
      new subs $!supname$n/SUBS1 copy subs 1 of $!template
      !!ce.orientation = !ori
      !!ce.position = !pos
    endif
  endif
  !sref = !!mdsFT29.name.val & '/SREF'
  if !sref.match('/').neq(1) then
    !sref = '/' + !!mdsFT29.name.val & '/SREF'
  endif
  !!ce = !sref.dbref()
  if !!ce.name.match('SREF') eq 0 then
    prev
  endif
  desp n3 $!newtype
  !!mdsDacControl(false)
  !!ce = !this.support.stru

endmethod
