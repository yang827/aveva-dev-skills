--
-- File:		Mdsft31configs.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS127W
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- Form Definition for different Configurations on Frame Type 31
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFt31Configs

-- Define Form
Setup Form  !!MdsFt31Configs

  !!MdsFt31Configs.formtitle    = ||
  !!MdsFt31Configs.icontitle    = ||
  !!MdsFt31Configs.Callback     = |Call !!MdsIFt31Configs()|
  !!MdsFt31Configs.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

    -- Create Datum
    frame .FConfig |Support Configurations| at x0 ymax

      button .Opt1 pixmap width 120 height 120 Call |Call !!MdsSetFt31Con(2)|
      path right
      hdist 1
      button .Opt2 pixmap width 120 height 120 Call |Call !!MdsSetFt31Con(3)|
      button .Opt3 pixmap width 120 height 120 Call |Call !!MdsSetFt31Con(4)|

      para .Text1 at xmin_Opt1 ymax_Opt1 text |Below beam|
      para .Text2 at xmin_Opt2 ymin      text |Onto column|
      para .Text3 at xmin_Opt3 ymin      text |To beam|

    exit

  -- Bottom Line
    button .Cancel at xmax-size ymax+0.3 | Cancel | cancel

-- End form definition
exit

  -- Set Pixmaps

    !!mdsft31configs.opt1.addPixmap(!!PML.getPathName('ft04_1.png'))
    !!mdsft31configs.opt2.addPixmap(!!PML.getPathName('ft04_2.png'))
    !!mdsft31configs.opt3.addPixmap(!!PML.getPathName('ft04_3.png'))

  !!MdsFt31Configs.Opt1.background = 'black'
  !!MdsFt31Configs.Opt2.background = 'black'
  !!MdsFt31Configs.Opt3.background = 'black'

-- End of file Mdsft31configs.frm
