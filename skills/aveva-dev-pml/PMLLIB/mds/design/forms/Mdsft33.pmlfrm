--
-- File:		Mdsft33.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPS138
--
-- Author:		I.Osborne
-- Created:		Tue Jul 22
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 33
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsFt33

-- Define Form
setup form  !!MdsFt33 at xr0 yr0 noquit

  !!MdsFt33.formtitle    = ||
  !!MdsFt33.icontitle    = ||
  !!MdsFt33.callback     = ||
  !!MdsFt33.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatFt33()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!MdsFt33)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!MdsFt33)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!MdsFt33)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation

    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size | at x0.65 y1 call |Call !!MdsReSize(!!MdsFt33)| width 20

      option .Slide  |Build      | at x1 ymax+0.2 call |call !!Mdsconfigft33(_slide.selection('rtext'))| width 14
      -- path down
      -- para .create text |Create by      |
      -- path right
      -- button .CreateByCur tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt33('CURSOR')|
      -- button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt33('DIMENSION')|
      -- button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt33('CLEARANCE')|

      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFt33,'-BAR-1','')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt33('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt33('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt33('CLEARANCE')|

--<dw>sep2007
      button .bracing  at xmax+0.1 ymin tooltip 'Bracing'                 pixmap width 18 height 18 call |!!mdsiaddbracing(!!MdsFt33)|
--<dw>sep2007

      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt
      text   .Dim2   |Dim 2     | at xmin ymax width 16 is real format !!DistanceFmt

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsFt33)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsFt33)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsFt33)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarFt33(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorFt33()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsFt33)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!Mdsft33)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsFT33)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!Mdsft33)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!Mdsft33)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsFT33,'!!MdsRotateFt33()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!MdsFT33)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!Mdsft33)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsFt33,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsFt33)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsFt33)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFt33,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsFt33,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFt33)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFt33)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFt33)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFt33)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT33,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT33,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFT33,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT33,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFt33)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFt33)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFT33,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld   at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptFt33()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Stiffener data for configuration 4 and 5
    member .Stiffener   is array

    -- Old Stiffener data for configuration 4 and 5 before External Joint added
    member .OldStiffener   is array

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,33,18,41,42,56,65'

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsFT33,'white')

  -- Turn off blocked icons
    !!KResetActive(!!mdsft33,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!MdsFt33.Select)

    !Dtext[1] = |On Column CL|
    !Dtext[2] = |After  Column|
    !Dtext[3] = |Before Column|
    !Dtext[4] = |To Web of Beam|
    !Dtext[5] = |Below Beam|
--<wd>dec1999
    !dtext[6] = |Face to Vert B/Plt|
    !dtext[7] = |End  to Vert B/Plt|
    !dtext[8] = |Face to Hori B/Plt|
    !Rtext[1] = |MID|
    !Rtext[2] = |BACK|
    !Rtext[3] = |FRONT|
    !Rtext[4] = |SIDE|
    !Rtext[5] = |UNDER|
--<wd>dec1999
    !rtext[6] = |FACEVERT|
    !rtext[7] = |ENDVERT|
    !rtext[8] = |FACEHORI|
    !!MdsFt33.Slide.Dtext = !Dtext
    !!MdsFt33.Slide.Rtext = !Rtext

    !!MdsFt33.Regen = |Call !!MdsCreateFt33('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdsft33.frm
