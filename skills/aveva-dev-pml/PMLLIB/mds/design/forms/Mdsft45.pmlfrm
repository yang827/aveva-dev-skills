-- Kill existing form definition
Kill !!MdsFt45

-- Define Form
setup form  !!MdsFt45 at xr0 yr0 noquit

  !!MdsFt45.formtitle    = ||
  !!MdsFt45.icontitle    = ||
  !!MdsFt45.callback     = ||
  !!MdsFt45.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
