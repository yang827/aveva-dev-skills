-- Kill existing form definition
Kill !!mdsFT46

-- Define Form
setup form  !!mdsFT46 at xr0 yr0 noquit

  !!mdsFT46.formtitle    = ||
  !!mdsFT46.icontitle    = ||
  !!mdsFT46.callback     = ||
  !!mdsFT46.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    --button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFt46()|
    button .datum | Create datum support atta | at x1 y1 call |!this.edgentry()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFT46)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFT46)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFT46)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
  frame .fCreate |Create| at x0 ymax width 31

    -- option .size   |Size | at x1 y1 call |Call !!mdsReSize(!!mdsFT46)| width 20
      -- path down
      -- halign right

      -- path down
      -- para .create at x1 Ymax+0.5 text |Create by      |
      -- path right

