--
-- File:		MdsFT47.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 10th May 2004
--
--
-- Description:
-- Form Definition for MDS Standard Framework Template Type 47
--
--------------------------------------------------------------------------------

-- Define Form
  setup form  !!mdsft47 at xr0 yr0 noquit

    !!mdsft47.formtitle    = ||
    !!mdsft47.icontitle    = ||
    !!mdsft47.callback     = ||
    !!mdsft47.formrevision = | $revision:$ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31
      button .datum | Create datum support atta | at x1 y1 call |call !!mdssetdatft47()|
      button .bdist | Distance | at xmin   ymax+0.25       call |call !!mdsposdist(!!mdsft47)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!distancefmt
      button .bthro | Through |  at x1     ymax+0.2        call |call !!mdsposthro(!!mdsft47)|
      option .select             at xmax+1 ymin            call |call !!mdsthroselect(!!mdsft47)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1
    exit

-- Creation
    frame .fcreate |Create| at x0 ymax width 31
      button .setsize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdssetsteel.init('SHOW',!!mdsft47,'-V1','')|
      button .createbycur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |call !!mdscreateft47('CURSOR')|
      button .createbydim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |call !!mdscreateft47('DIMENSION')|
      button .createbycle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |call !!mdscreateft47('CLEARANCE')|
      para   .tcode   at x1 ymax+0.2 text |Support Code|
      para   .code   at xmax+0.5 ymin width 15 lines 1
      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt
    exit

    frame .fmisc |Options| at x0 ymax+0.1 width 31
-- Icons Row 1
      button .addpipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |call !!mdsaddpipe(!!mdsft47)|
      button .addhvac  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |call !!mdsaddhvac(!!mdsft47)|
      button .addrack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |call !!mdsaddrack(!!mdsft47)|
      button .addbar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |call !!mdsaddbarft47(_support, 'NEW')|
      button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |call !!mdsmirrorft47()|
      button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |call !!mdsrotateframe(!!mdsft47)|
      button .alignsup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!mdsxalign(!!mdsft47)|
      button .modsctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |call !!mdsposse(!!mdsft47)|

-- Icons Row 2
      button .addpack       at x1 ymax+0.25 tooltip  'Add Packer'         pixmap width 18 height 18 call |call !!mdscrft25(!!mdsft47)|
      button .delpack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |call !!mdsdelft25(!!mdsft47)|
      button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |call !!mdsirotan(!!mdsft47,'!!mdsrotateft47()')|
      button .rotatt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsrotateatta.rotateonly(!!mdsft47)|
      button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |call !!mdsnewdatum(!!mdsft47)|
      button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |call !!mdsibedplate(!!mdsft47,'FRAME')|
      button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |call !!mdslinkatta(!!mdsft47)|
      button .viewassociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |call !!mdsshowlinks(!!mdsft47)|

-- Icons Row 3
      button .flipfw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |call !!mdsfieldweld(!!mdsft47,'FLIP')|
      button .modatta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |call !!mdsimodat(!!mdsft47,!!mdsmodat)|
      button .deleteatta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |call !!mdsdeleteatta(!!mdsft47)|
      button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsnudge.init(!!mdsft47)|
      button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsspool.init(!!mdsft47)|
      button .setmat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdssetmat(!!mdsft47)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdscopylike(!this)|
      button .viewstd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |call !!mdsshowplotfile(_support)|

-- Icons Row 4
      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsselectjoints(!!mdsft47,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsselectjoints(!!mdsft47,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsselectjoints(!!mdsft47,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsselectjoints(!!mdsFT47,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdssetdim(!!mdsft47)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdszoomsupp(!!mdsft47)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |call !!mdsimdsadp(!!mdsft47,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdssetlocation(!this)|

-- Icons Row 5
      button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip 'Flip Atta' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|

    exit

-- Bottom Line
    button .cancel  | Cancel | at xmax form-size ymax+0.5
    button .Ok      |   OK   | at x0 ymin call |call !!mdsacceptft47()|

-- Form Members
-- Support object
    member .support     is mdssupport

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Support object storage for support regeneration
    member .backup      is mdssupport

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

-- Graphical dimensions
    member .graphicaldim is boolean

-- Blocked icons
    member .blockedicons is string
    !this.blockedicons = '1,2,6,7,8,9,13,14,15,18,19,20,21,22,23,24,35,36,37,38,41,42,56,58,65'

-- Flange Member Identified
   member .flange is dbref

-- End form definition
  exit
------------------------------------------------------------------------------------------


-- Add Additional Information to Form
-- Set background colour of pixmaps to white
    !!mdsseticonback(!!mdsft47,'white')

-- turn off blocked icons
    !!kresetactive(!!mdsft47,TRUE)

-- Populate option gadgets
    call !!mdsloadoption(!!mdsft47.select)

-- Set Form Member
    !!mdsft47.regen = |call !!mdscreateft47('DIMENSION')|


-- End of file MdsFT47.pmlfrm
