--
-- File:  Mdsft48.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:          FPS147
--
-- Author:  D.flannery
-- Created:  mar 1 04
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 48
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!mdsFT48

-- Define Form
setup form  !!mdsFT48 at xr0 yr0 noquit

  !!mdsFT48.formtitle    = ||
  !!mdsFT48.icontitle    = ||
  !!mdsFT48.callback     = ||
  !!mdsFT48.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatFT48()|
    button .bdist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsFT48)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsFT48)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsFT48)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  -- Creation
  frame .fCreate |Create| at x0 ymax width 31

    -- option .size   |Size | at x1 y1 call |Call !!mdsReSize(!!mdsFT48)| width 20
    -- path down
    -- halign right

    -- path down
    -- para .create at x1 Ymax+0.5 text |Create by      |
    -- path right

    !desc = desc of /MDS/TEMPLATES
    handle ANY
      !desc = ''
    endhandle

    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsFT48,'-V1','')|
    button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreateFT48('CURSOR')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreateFT48('DIMENSION')|
    button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreateFT48('CLEARANCE')|

    if !desc.eq('Zimmer Templates') then
      option .cap    |Size     | at x1 ymax+0.2 call |Call !!mdsReSize(!!mdsFT48)| width 15
    endif


    para   .tCode   at x1 ymax+0.2 text |Support Code|
    para   .code   at xmax+0.5 ymin width 15 lines 1

    if !desc.eq('Zimmer Templates') then
      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is REAL format !!distanceFmt
    else
      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is REAL format !!distanceFmt
      text   .dim2   |Dim 2     | at x1 ymax+0.2 CALL |Call !!mdsCreateFT48('DIMSET')| width 16 is REAL format !!distanceFmt
      text   .dim3   |Dim 3     | at x1 ymax+0.2 CALL |Call !!mdsCreateFT48('DIMSET')| width 16 is REAL format !!distanceFmt
    endif


    --  text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is REAL format !!distanceFmt
    --  text   .dim2   |Dim 2     | at x1 ymax+0.2 CALL |Call !!mdsCreateFT48('DIMSET')| width 16 is REAL format !!distanceFmt
    --  text   .dim3   |Dim 3     | at x1 ymax+0.2 CALL |Call !!mdsCreateFT48('DIMSET')| width 16 is REAL format !!distanceFmt

  exit

  frame .fMisc |Options| at x0 ymax+0.1 width 31

    -- Icons Row 1

    button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsFT48)|
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsFT48)|
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsFT48)|
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarFT48(_Support, 'NEW')|
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorFT48()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsFT48)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsFT48)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsFT48)|


    -- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!mdscrft25(!!mdsFT48)|
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!mdsdelft25(!!mdsFT48)|
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsFT48,'!!mdsRotateFT48()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!!mdsFT48)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!mdsnewdatum(!!mdsFT48)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsFT48,'FRAME')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsFT48)|
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsFT48)|

    -- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsFT48,'FLIP')|
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsFT48,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsFT48)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsFT48)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsFT48)|
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsFT48)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT48,'CONNECT','')|
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT48,'MODIFY','')|
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT48,'FORCECONNECT','')|
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!mdsSelectJoints(!!mdsFT48,'DISCONNECT','ERROR')|
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsFT48)|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsFT48)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsFT48,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

    -- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
    button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
    button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!mdsRepeatAtta(!this)|
    button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0 ymin call |Call !!mdsAcceptFT48()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING
  --<wd>dec2004
  --!this.blockedIcons = '1,6,7,8,9,13,15,18,19,20,21,22,24,35,41,42,56'
  !this.blockedIcons = '1,6,7,9,13,15,18,19,20,21,22,24,35,41,42,56'

  -- mdstrimsctn object for EDG extending section ends to planes
  member .mdstrimsctn is MDSTRIMSCTN


  -- End form definition
exit

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsFT48,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsFT48,true)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsFT48.select)

!!mdsFT48.regen = |Call !!mdsCreateFT48('DIMENSION')|

------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object MDSTRIMSCTN(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

  if !this.mdstrimsctn.sctn.name.match('V1').gt(0) then
    !!mdsFT48.dim1.val = !!mdsgetoverdim(!this.support.datum ,!this.mdstrimsctn.sctn,0)
  endif
  -- now reset the despars on the sref atta
  !sref = !this.support.stru.name & '/SREF'
  !!ce = !sref.dbref()

  !!mdsDacControl(true)
  !dp4 = !!ce.desp[4]
  handle ANY
    !dp4 = 0
  endhandle
  !dp5 = !!ce.desp[5]
  handle ANY
    !dp5 = 0
  endhandle
  DESPAR $!!mdsFT48.dim1.val $!!mdsFT48.dim2.val $!!mdsFT48.dim3.val $!dp4 $!dp5
  !!mdsDacControl(FALSE)

  -- Show dimensions on graphics if required
  if !!mdsFT48.graphicalDim then
    !!mdsshowdim(!!mdsFT48)
  endif

endmethod
