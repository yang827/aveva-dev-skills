-- Kill existing form definition
  kill !!MdsFT50

-- Define Form
setup form  !!MdsFT50 at xr0 yr0 noquit

  !!MdsFT50.formtitle    = ||
  !!MdsFT50.icontitle    = |MDS - FT50|
  !!MdsFT50.callback     = ||
  !!MdsFT50.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |call !!MdssetdatFT50()|
      button .bdist | Distance | at xmin   ymax+0.25       call |call !!Mdsposdist(!!MdsFT50)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |call !!Mdsposthro(!!MdsFT50)|
      option .select             at xmax+1 ymin            call |call !!Mdsthroselect(!!MdsFT50)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------

-- Creation
    frame .fcreate |Create| at x0 ymax width 31

      -- option .size   |Size | at x1 y1 call |call !!Mdsresize(!!MdsFT50)| width 20

      -- path down
      -- para .create text |Create by      |
      -- path right

      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFT50,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |!this.edgentry()|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFT50('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFT50('CLEARANCE')|

      path down
      -- Dimension 'L' distance from centre to pipe to surface of vessel wall
      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt


    exit

--------------------------------------------------------------------------------

-- Miscellaneous
