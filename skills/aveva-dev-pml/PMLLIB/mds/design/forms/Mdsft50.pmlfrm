-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsFT50,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsModDatFT50()|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsFT50)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsFT50)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsFT50)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsFT50)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4
      button .connect  at x1 ymax+0.25 tooltip  'Create Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT50,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT50,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'    pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsFT50,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsFT50,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsFT50)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsFT50)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsFT50,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|

     exit

--------------------------------------------------------------------------------

-- Bottom Line

    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptFT50()|


--------------------------------------------------------------------------------

-- Form Members
-- Support object
    member .support     is MdsSUPPORT

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .ppack       is array

-- Support object storage for support regeneration
    member .backup      is MdsSUPPORT

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,6,7,8,9,10,13,14,15,18,19,20,21,22,23,27,34,35,36,37,38,41,42,56,58'

    -- member to hold dimensional errors encountered during build by cursor
    member .dimerrors is array

    member .sbfi is dbref
    member .plane is plane

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

  -- Set background colour of pixmaps to white
    !!MdsSetIconBack(!!MdsFT50,'white')

  -- Turn off blocked icons
    !!KResetActive(!!mdsft50,true)

--------------------------------------------------------------------------------
-- Populate option gadgets
    call !!Mdsloadoption(!!MdsFT50.select)

-- Matl
   !dtext = array()
   !rtext = array()
   !dtext.append(|Parent|)
   !dtext.append(|Other|)
   !rtext.append(|INSPEC|)
   !rtext.append(|OUTSPEC|)

--------------------------------------------------------------------------------

    !!MdsFT50.regen = |call !!MdscreateFT50('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false
---------------------------------------------------------------------------------
define method .edgentry()
--<wd>dec2004
--**********************
--*** IMPORTANT NOTE ***
--**********************
-- There is a PROBLEM with "EDG" returning the "OPPOSITE PLANE DIRECTION" when identifying a SURFACE
-- which is "EITHER at TOO SMALL a SCALE" -- "OR at a TOO SHALLOW ANGLE in the GRAPHICAL VIEW"
-- Therefore the PROMPT below NOW requests that the USER
-- *** "ZOOM IN and Identify a SURFACE to Support from..." ***
--<wd>dec2004

    prompt  'ZOOM IN and Identify a SURFACE to Support from...'

    !this.setactive(false)
    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'FT50'

    -- Remember the element when the packet was first place in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- Move to the element picked
    !packet.action = '!!mdsFT50.returnfromedg(!this.return)'

    -- Set the close sequence, so that the user returns to the original
    -- element
    !packet.close = '!!mdsFT50.setactive(true)'
    !packet.remove = true $* set packet so that it deletes itself when it finished
    !pickpacket = object edgpickpacket()
    !pickpacket.stdgraphic('Identify a Surface to Support from...')
    !packet.pickpacket = !pickpacket

-- Add event packet to the system
    !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is array)

-- this method is called when the EDG returns from a valid pick
-- first of all check to see if the item picked was a flange

  !this.plane = !input[1].positiondata().plane
  if !this.plane.unset() then
    !!alert.error('Identify a Surface - Not an Edge, Pline or PPoint')
    prompt dismiss
    return
  endif

  !this.sbfi = !input[1].item

  prompt dismiss

-- if it gets here then its found a Surface
-- call the create function with the plate data
   !!MdscreateFT50(|PICK|)
--!this.datum.active = false

endmethod
---------------------------------------------------------------------------------------------------


