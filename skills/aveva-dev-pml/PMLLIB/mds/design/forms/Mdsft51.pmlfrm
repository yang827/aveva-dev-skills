-- Kill existing form definition
Kill !!Mdsft51

-- Define Form
setup form  !!Mdsft51 at xr0 yr0 noquit

  !!Mdsft51.formtitle    = ||
  !!Mdsft51.icontitle    = ||
  !!Mdsft51.callback     = ||
  !!Mdsft51.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatft51()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!Mdsft51)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!Mdsft51)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!Mdsft51)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size | at x1 y1 call |Call !!MdsReSize(!!Mdsft51)| width 20

      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!Mdsft51,'-BAR-1','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateft51('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateft51('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateft51('CLEARANCE')|

      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1  |     at x1   ymax+0.2  tooltip 'Top member length' width 14 is real format !!DistanceFmt
      text   .Dim2   |Dim 2  |     at xmin ymax      tooltip 'Pipe 1 Offset From End' call |!!Mdsft51.Dim3.Setfocus()| width 14 is real format !!DistanceFmt
      text   .Dim3   |Dim 3  |     at xmin ymax      tooltip 'Leg 1 Length'       Call |!this.setlegs(!this.dim3)| width  14 is real format !!DistanceFmt
      text   .Dim4   |Dim 4  |     at xmin ymax      tooltip 'Leg 2 Length'       Call |!this.setlegs(!this.dim4)| width 14 is real format !!DistanceFmt
      text   .Dim5   |Dim 5  |     at xmin ymax      tooltip 'Offset 1'           Call |!this.setlegs(!this.dim5)| width 14 is real format !!DistanceFmt
      text   .Dim6   |Dim 6  |     at xmin ymax      tooltip 'Offset 2'           Call |!this.setlegs(!this.dim6)| width 14 is real format !!DistanceFmt
      text   .ang1   |Angle 1|     at xmin ymax      tooltip 'Leg 1 Inside Angle' Call |!this.setlegs(!this.ang1)| width 14 is real
      text   .ang2   |Angle 2|     at xmin ymax      tooltip 'Leg 2 Inside Angle' Call |!this.setlegs(!this.ang2)| width 14 is real

      button .Revd1 at xmax_dim1+1 ymax_dim1-0.7 tooltip 'Reverse Dimensions' pixmap width 28 height 28 call |Call !!MdsRevDims(_Dim1, _Dim2, 'Call !!MdsCreateft51(''DIMENSION'')')|
      button .Revd2 at xmax_dim3+1 ymax_dim3-0.7 tooltip 'Reverse Dimensions' pixmap width 28 height 28 call |Call !!MdsRevDims(_Dim3, _Dim4, 'Call !!MdsCreateft51(''DIMENSION'')')|

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!Mdsft51)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!Mdsft51)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!Mdsft51)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarft51(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorft51()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!Mdsft51)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!Mdsft51)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!Mdsft51)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25  tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!Mdsft51)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!Mdsft51)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!MdsIRotan(!!Mdsft51,'!!MdsRotateft51()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!Mdsft51)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!Mdsft51)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!Mdsft51,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!Mdsft51)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!Mdsft51)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!Mdsft51,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!Mdsft51,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!Mdsft51)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!Mdsft51)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!Mdsft51)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!Mdsft51)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25  tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft51,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft51,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!Mdsft51,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft51,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!Mdsft51)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdsft51)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!Mdsft51,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip  'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip 'Re-connect' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|
      button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

    exit
-----------------------------------------------------------------------------

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptft51()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,13,41,42,56'

    -- mdstrimsctn object for EDG extending section ends to planes
    member .mdstrimsctn is MDSTRIMSCTN

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!Mdsft51,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsft51,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!Mdsft51.Select)

    !!Mdsft51.Regen = |Call !!MdsCreateft51('DIMENSION')|

------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object mdstrimsctn(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

    if !this.mdstrimsctn.sctn.name.match('V1').gt(0) then
       !!Mdsft51.Dim3.val = !!mdsgetoverdim(!this.support.datum,!this.mdstrimsctn.sctn,0)
       !!MdsFT51.Dim5.val = !!mdsgetoverdim(!this.support.datum,!this.mdstrimsctn.sctn,3) - (!!mdsft51.dim1.val -  !!mdsft51.dim2.val)
    elseif !this.mdstrimsctn.sctn.name.match('V2').gt(0) then
       !!Mdsft51.Dim4.val = !!mdsgetoverdim(!this.support.datum,!this.mdstrimsctn.sctn,0)
       !!MdsFT51.Dim6.val = !!mdsgetoverdim(!this.support.datum,!this.mdstrimsctn.sctn,2) - !!MdsFT51.Dim2.val
    endif
    -- now reset the despars on the sref atta
    !sref = !this.support.stru.name & '/SREF'
    !!CE = !sref.dbref()

    !!MdsDacControl(true)
       DESPAR $!!Mdsft51.Dim1.Val $!!Mdsft51.Dim2.Val $!!Mdsft51.Dim3.Val $!!Mdsft51.Dim4.Val $!!Mdsft51.Dim5.Val $!!Mdsft51.Dim5.Val $!!Mdsft51.ang1.Val $!!Mdsft51.ang2.Val
    !!MdsDacControl(FALSE)

-- Show dimensions on graphics if required
  if !!MdsFt51.GraphicalDim then
    !!Mdsshowdim(!!Mdsft51)
  endif

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to work out the angles and offset when the user changes the gadgets
-- the initial point is the gadget name which has been changed
define method .setlegs(!gadget is gadget)


   -- gadget can be .ang1 .ang2 .dim3 .dim4 .dim5 .dim6
   if !gadget.eq(!this.dim3) or !gadget.eq(!this.dim5) or !gadget.eq(!this.ang1) then
     if !gadget.eq(!this.dim3) then  $* we have changed the height of the support
        !this.dim5.val =  !this.dim3.val * tan(!this.ang1.val - 90 )
        if !this.dim5.val.eq(0) then
           !this.ang1.val = 90
        else
           !this.ang1.val =  atan(!this.dim5.val / !this.dim3.val) + 90
        endif
     elseif !gadget.eq(!this.dim5) then
        if !this.dim5.val.eq(0) then
           !this.ang1.val = 90
        else
         !this.ang1.val =  atan(!this.dim5.val / !this.dim3.val) + 90
        endif
     elseif !gadget.eq(!this.ang1) then
        if !this.ang1.val.lt(90) then
           !!alert.error('Angle cannot be less than 90')
           !this.ang1.val = 90
        endif
       -- !this.dim3.val =
        !this.dim5.val = !this.dim3.val * tan(!this.ang1.val - 90)
     endif
   else
     if !gadget.eq(!this.dim4) then  $* we have changed the height of the support
        !this.dim6.val =  !this.dim4.val * tan(!this.ang2.val - 90 )
        if !this.dim6.val.eq(0) then
           !this.ang2.val = 90
        else
           !this.ang2.val =  atan(!this.dim6.val / !this.dim4.val) + 90
        endif
     elseif !gadget.eq(!this.dim6) then
        if !this.dim6.val.eq(0) then
           !this.ang2.val = 90
        else
         !this.ang2.val =  atan(!this.dim6.val / !this.dim4.val) + 90
        endif
     elseif !gadget.eq(!this.ang2) then
        if !this.ang2.val.lt(90) then
           !!alert.error('Angle cannot be less than 90')
           !this.ang2.val = 90
        endif
       -- !this.dim4.val =
        !this.dim6.val = !this.dim4.val * tan(!this.ang2.val - 90)
     endif
   endif

endmethod
