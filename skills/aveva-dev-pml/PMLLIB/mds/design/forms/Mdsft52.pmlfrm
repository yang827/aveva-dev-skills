--
-- File:		Mdsft52.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		R.Martin
-- Created:		Fri Dec 09
--
--
-- Description:
-- Form Definition for Frameworks Frame Type 52
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgentry()                       -
--  resetdims()                      -
--

-- Kill existing form definition
Kill !!MdsFt52

-- Define Form
setup form  !!MdsFt52 at xr0 yr0 noquit

  !!MdsFt52.formtitle    = ||
  !!MdsFt52.icontitle    = ||
  !!MdsFt52.callback     = ||
  !!MdsFt52.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatFt52()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!MdsFt52)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!MdsFt52)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!MdsFt52)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      -- option .Size   |Size | at x1 y1 call |Call !!MdsReSize(!!MdsFt52)| width 20
      -- path down
      -- halign right
      -- para .create text |Create by      |
      -- option .SetType  |Build | at x1 ymax+0.2 call || width 19
      path right
      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsFt52,'','-V1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateFt52('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateFt52('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateFt52('CLEARANCE')|
      -- para .SetSizeText text |Template |
      -- para .SizeText text |Template |
      -- option .Create |Create by | at x1  ymax+0.2 call |Call !!MdsCreateFt52(_Create.selection('Rtext'))| width 14
      para   .TCode   at x1 ymax+0.2 text |Support Code|
      para   .Code   at xmax+0.5 ymin width 15 lines 1
      text   .Dim1   |Dim 1  |     at x1   ymax+0.2 width 14 is real format !!DistanceFmt
      text   .Dim2   |Dim 2  |     at xmin ymax width 14 is real format !!DistanceFmt
      text   .Dim3   |Dim 3  |     at xmin ymax width 14 is real format !!DistanceFmt
    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

      -- option .Add   |Add Support    |  at x1     y1        Call |$$_Add| width 9
      -- text   .Nudge |Nudge| at x1     ymax+0.2  width 10 is real format !!DistanceFmt
      -- button .Plus   at xmax+0.5 ymin tooltip 'Nudge Forward'  pixmap height 16 width 16  Call |Call !!MdsPlusDist(!!Mdsft52)|
      -- button .Minus  at xmax+0.5 ymin  tooltip 'Nudge Backward' pixmap height 16 width 16  Call |Call !!MdsMinusDist(!!Mdsft52)|
      -- button .LineUp  at xmax+0.5 ymin  pix $!!CDJB.ALIFRM  height 16 width 16  Call |Call !!MdsAlignFrame(!!Mdsft52)|

      halign left

-- Icons Row 1

      button .AddPipe  at x1       ymax tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!Mdsft52)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!Mdsft52)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!Mdsft52)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarft52(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorft52()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!Mdsft52)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!Mdsft52)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!Mdsft52)|


-- Icons Row 2

      button .AddPack       at x1 ymax+0.25  tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!Mdsft52)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!Mdsft52)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!MdsIRotan(!!Mdsft52,'!!MdsRotateft52()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!MdsRotateAtta.RotateOnly(!!Mdsft52)|
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!Mdsft52)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!Mdsft52,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!Mdsft52)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!Mdsft52)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld'      pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!Mdsft52,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'          pixmap width 18 height 18 call |Call !!MdsIModAt(!!Mdsft52,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'          pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!Mdsft52)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'        pixmap width 18 height 18 call |!!MdsNudge.Init(!!Mdsft52)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'             pixmap width 18 height 18 call |!!MdsSpool.Init(!!Mdsft52)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!Mdsft52)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like'            pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'        pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip  'Create Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft52,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft52,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'    pixmap width 18 height 18 call |call !!MdsSelectJoints(!!Mdsft52,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections'             pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdsft52,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!Mdsft52)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support'              pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdsft52)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'                   pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!Mdsft52,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position'   pixmap width 18 height 18 call |call !!MdsSetLocation(!!Mdsft52)|

-- Icons Row 5

      button .trimmer   at x1 ymax+0.25  tooltip 'Trimmer Required'        pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat    at xmax+0.1 ymin tooltip 'Set Ancillary Material'  pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy   at xmax+0.1 ymin tooltip 'Copy Ancillary'          pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge  at xmax+0.1 ymin tooltip 'Nudge Ancillaries'       pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen    at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat   at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote   at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta  at x1 ymax+0.25  tooltip ''                         pixmap width 18 height 18 call |call !!mdsflipat43(!this)|
      button .suppdata  at xmax+0.1 ymin tooltip 'Data'                     pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta  at xmax+0.1 ymin tooltip 'Modify Atta Properties'   pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip  at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec  at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
      button .Mtoc      at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|
      button .addweld   at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
      button .repeat    at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call |!!MdsRepeatAtta(!this)|
      button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call |!this.edgentry()|

       -- button .alignatta at xmax+0.1 ymin tooltip 'Align Atta/s'              pixmap width 18 height 18 call |!!MdsAlignAtta(!this)|
       -- button .bracing  at xmax+0.1 ymin tooltip 'Bracing'                 pixmap width 18 height 18 call |!!mdsaddbracing(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptft52()|


  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,13,41,42,56'

    -- mdstrimsctn object for EDG extending section ends to planes
    member .mdstrimsctn is MDSTRIMSCTN

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!Mdsft52,'white')

  -- Add to form member all icons that never require showing
    !!KResetActive(!!Mdsft52,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!Mdsft52.Select)

    !!Mdsft52.Regen = |Call !!MdsCreateft52('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false
    !This.OK.active = TRUE


------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object mdstrimsctn(!this)

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method to get the overall length of a sctn after cutting it back on an angle
-- Called by the mdstrimsctn method
define method .resetdims()

 -- now reset the despars on the sref atta
 !sref = !this.support.stru.name & '/SREF'
 !!CE = !sref.dbref()

 !!MdsDacControl(true)
 DESPAR $!!Mdsft52.Dim1.Val $!!Mdsft52.Dim2.Val
 !!MdsDacControl(FALSE)

 -- Show dimensions on graphics if required
  if !!Mdsft52.GraphicalDim then
    !!Mdsshowdim(!!Mdsft52)
  endif

endmethod
------------------------------------------------------------------------------------


-- End of file Mdsft52.frm
    -- Blocked icons
