--
------------------------------------------------------------------------

define method .throPos()

  !!mdsPosThro(!this)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showDim()

  !!mdsSetDim(!this)
  !this.support.markAtta()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unenhance()

  do !atta values !this.support.atta
    unenhance $!atta
  enddo
  unenhance  $!this.support.stru
  handle ANY
  endhandle

endmethod
-- End of method
