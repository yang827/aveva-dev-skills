-- Define Form
setup form  !!mdsft69 at xr0 yr0 noquit

  -- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .fDatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |!!mdsft69.setDatum()|
      button .bDist | Distance | at xmin   ymax+0.25       call |!this.distance()|
      text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
      button .bThro | Through |  at x1     ymax+0.2        call |!this.throPos()|
      option .select             at xmax+1 ymin            call |!!mdsThroSelect(!this)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .fCreate |Create| at x0 ymax width 31

      path right
      button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!this,'-BAR-1','')|
      button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call ||
      button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |!this.create('DIMENSION')|
      button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call ||
      button .bracing  at xmax+0.1 ymin tooltip 'Bracing' pixmap width 18 height 18 call ||

      para   .tCode   at x1 ymax+0.2 text |Support Code|
      para   .code   at xmax+0.5 ymin width 15 lines 1
      text   .dim1   |Dim 1     | at x1   ymax+0.2 width 16 is REAL format !!distanceFmt

    exit

    frame .fMisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
      button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .addBar   at xmax+0.1 ymin tooltip 'Add Upright'  pixmap width 18 height 18 call ||
      button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call ||
      button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call ||
      button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!mdsxalign(!this)|
      button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!this)|

-- Icons Row 2

      button .addPack       at x1 ymax+0.25  tooltip 'Add Packer'         pixmap width 18 height 18 call ||
      button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
      button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'        pixmap width 18 height 18 call ||
      button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .newDat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call ||
      button .bedPlate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |!!mdsIBedPlate(!this,'FRAME')|
      button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
      button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |!!mdsShowLinks(!this)|

-- Icons Row 3

      button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
      button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |!!mdsIModAt(!this,!!mdsModAt)|
      button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call ||
      button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!mdsNudge.init(!this)|
      button .spool      at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call ||
      button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!this)|
      button .copyLike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call ||
      button .viewStd    at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |!!mdsShowPlotFile(!this.support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
      button .forceCon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |!this.showDim()|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!this)|
      button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!this,'INIT')|
      button .adpLoc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |!!mdsSetLocation(!this)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
      button .ancMat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .ancCopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call ||
      button .ancNudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call ||
      button .setLen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call ||
      button .trunMat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call ||
      button .ancNote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipAtta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppData at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
      button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special' pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
      button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|
      button .addWeld  at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!mdsSpecialWelds.init(!this)|
      button .repeat   at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call ||
      button .cutSect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call ||

    exit

  -- Bottom Line
    button .cancel  | Cancel | at xmax form-size ymax+0.5 callback '!this.cancel()'
    button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptft69()|

  -- Form Members
    -- Support object
    member .support     is MDSFTSIXTYNINE

    -- Graphical representation
    member .repre       is ARRAY

    -- Form Storage for support restoration
    member .store       is ARRAY

   -- storage for material references
    member .storeMatref is ARRAY

    -- Form Storage for Packing Pieces for Support restoration
    member .pPack       is ARRAY

    -- Support object storage for support regeneration
    member .backup      is MDSFTSIXTYNINE

    -- Support Regeneration function
    member .regen       is STRING

    -- BedPlate Reference
    member .struBpref   is ARRAY

    -- BedPlate Reference
    member .storeBpref  is ARRAY

    -- Graphical dimensions
    member .graphicalDim is BOOLEAN

    -- Blocked icons
--    member .BlockedIcons is string

-- End form definition
exit

-- constructor
------------------------------------------------------------------------------------------
define method .mdsft69()

  !this.initcall = '!this.init()'

  -- Set background colour of pixmaps to white
  !!mdsSetIconBack(!this,'white')


  -- Populate option gadgets
  !!mdsLoadOption(!this.select)

  !this.regen = |Call !!mdsCreateft69('DIMENSION')|

  -- make gadgets with no callback inactive
  !gadgets = !this.gadgets()
  do !gadget values !gadgets
    skip if !gadget.type().neq('BUTTON')
    !gadget.active = !gadget.callback.empty().not()
  enddo

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !!mdsSetFormName(!this, 'PIPE', !this.support.alias)
  !this.name.val = !this.support.stru.namn
  !this.aidNumbers(on)

  !this.graphicalDim = false

  !this.updateGadgets()

  !!mdsSetSteel.init('HIDE',!this,'-BAR-1','')
  !this.store.clear()
  !steel = object ANYDATASET('!!mdsSetSteel.size')
  !steel.setAttribute('val',!!mdsSetSteel.size.val)
  !this.store.append(!steel)
  !datum = !this.support.datum
  if !datum.badref().not() then
    !stru = !this.support.stru
    !sref = !this.support.sref()
    !frmw = !this.support.frmw()
    !strudata = object ANYDATASET('!this.support.stru')
    !strudata.setAttribute(':mdstrimmer',!stru.:mdstrimmer)
    !datumdata = object ANYDATASET('!this.support.datum')
    !datumdata.setAttribute('pos',!datum.pos)
    !datumdata.setAttribute('spre',!datum.spre)
    !datumdata.setAttribute('desp',!datum.desp)
    !datumdata.setAttribute('matr',!datum.matr)
    !srefdata = object ANYDATASET('!this.support.sref()')
    !srefdata.setAttribute('pos',!sref.pos)
    !dimdata = object ANYDATASET('!this.dim1')
    !dimdata.setAttribute('val',!this.dim1.val)
    !this.store.append(!strudata)
    !this.store.append(!datumdata)
    !this.store.append(!srefdata)
    !this.store.append(!dimdata)
    !matrdata = ARRAY()
    do !memb values !frmw.memb
      !data = object ANYDATASET(!memb.name)
      !data.setAttribute('matr',!memb.matr)
      !matrdata.append(!data)
    enddo
    !this.storeMatref = !matrdata
    !orig = !!ce
    !!ce = !this.support.datum
    !!mdsDistance(!this)
    !!ce = !orig
    !this.support.markAtta()
  endif

  -- Store Current representations in form for use later
  var !gen repre level
  var !pipe repre lev pipe
  var !nozz repre lev nozz
  var !sctn repre lev stru
  !this.repre.clear()
  !this.repre.append(|!!kreprelevel(nulref, '', $!gen,0)|)
  !this.repre.append(|!!kreprelevel(nulref, 'PIPE', $!pipe,0)|)
  !this.repre.append(|!!kreprelevel(nulref, 'NOZZ', $!nozz,0)|)
  !this.repre.append(|!!kreprelevel(nulref, 'STRU', $!sctn,0)|)
  !this.repre.append('!!mdsft69.unenhance()')

endmethod













------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidNumbers(!on is BOOLEAN)

  !clear = !on.not()
  if !clear then
    aid clear all $!this.support.aidNumber
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!mode is STRING)

  if !this.support.datum.badref() then
    !!alert.error('DATUM atta has to exist before frame creation.')
    return
  endif
  if !mode.eq('DIMENSION').and(!this.support.position.not()) then
    !!alert.error('Position DATUM atta first.')
    return
  endif

  !sref = !this.support.sref()
  !currentUnits = !!kGetSetUnits()
  !tmpl = object DBREF('/MDS/FT69/' & !!mdsSetSteel.size.val)
  !dim[1] = !this.dim1.val
  if !dim[1].eq(0).or(!dim[1].unset()) then
    !bar = object DBREF(!tmpl.name & '-BAR-1')
    !dim[1] = !bar.cutl
  endif

  if !mode.eq('CURSOR') then
    !hplane = object PLANE(!this.support.datum.pos,Z is U wrt world)
    !ydir = !this.support.datum.ldir.projected(!hplane)
    !hplane.orientation = object ORIENTATION('Y is ' & !ydir & ' and Z is U wrt world')
    do
      prompt off
      prompt load escape 'Identify horizontal section'
      !sctn = ref of id SCTN@
      handle ANY
        !!kRestoreUnits(!currentUnits)
        return
      endhandle
      !tolang = 0.05
      -- check if beam is horizontal
      if !sctn.zdir.isParallel(U wrt world) then
        !!alert.error('Beam picked must be horizontal.')
        skip
      endif
      !normzdir = !sctn.zdir.projected(!hplane)
      !angle = !sctn.zdir.angle(!normzdir)
      if !angle.gt(!tolang) then
        !!alert.error('Beam picked must be horizontal.')
        skip
      endif
      -- check if beam is perpendicular to supported pipe
      !angle = !normzdir.angle(!hplane.orientation.xdir())
      if !angle.gt(!tolang).and(!angle.lt(180 - !tolang)) then
        !!alert.error('Beam picked must be perpendicular to supported pipe.')
        skip
      endif
      break
    enddo
    !this.support.connections[1] = !sctn
    -- slide datum through sctn
    !!ce = !this.support.datum
    move plane $!ydir through pplin NA of $!sctn
    !sref.pos = !this.support.datum.pos
    !this.support.markAtta()
    !!mdsDistance(!this)
    !this.support.position = true
  endif

  !this.dim1.val = !dim[1]
  !this.support.buildStru(!tmpl,!dim)
  if !this.graphicalDim then
    !!mdsshowdim(!this)
  endif

  !!mdsSetSuppCode('MODIFY',!this.support.stru.name,'FT69',!sref.styp)


  !!kRestoreUnits(!currentUnits)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDatum()

-- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

-- Force into forwards mode
  forward

-- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !maxSlope = !!mdsOptions.slope.val.block().evaluate()

  !datum    = !this.support.datum

  if !tubeType.eq('FTUB') then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  if (!!mdsIdTube(!tubeType, 'Identify $!<pipeType> of datum pipe','PIPE').not()) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !idcomp = !!ce

  -- store picked element and get tube direction
  if (!!ce.type.eq('BRAN')) then
    !hdir = hdir wrt /*
    !pbor = !!ce.hbor
    !idbran = !idcomp
  else
    !hdir = pl dir wrt /*
    !pbor = !!ce.lbor
    !idbran = !idcomp.owner
  endif
  !this.support.idcomp = !idcomp
  !this.support.idbran = !idbran

  -- check the slope
  if !hdir.isParallel(U wrt world) then
    !!alert.error('This configuration is not allowed to support vertical pipes!')
    !!kRestoreUnits(!currentUnits)
    return
  endif
  !slope = abs(1 / !idcomp.pgrd[1])
  handle ANY
    !slope = 0
  endhandle
  if !slope.gt(!maxSlope) then
    !!alert.error('Slope is greater than maximum allowed (' & !!mdsOptions.slope.val & ').')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  !error = STRING()
  if !!mdsCheckBores(!this,!!mdsSetSteel.size.val.string(),!error,!currentUnits) then
    !!alert.error(!error)
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !!ce = !idcomp

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |!!mdsCrAncill(!!mdsft69)|
  !!mdsAncill.action[2] = |!!mdsft69.createDatum()|
  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT69')

-- Reset Units
   !!kRestoreUnits(!currentUnits)

  -- execute selection immediatelly if there is only one choice
  if !!mdsAncill.standard.dtext.size().eq(1).and(!!mdsAncill.shown()) then
    !!kActionCommands(!!mdsAncill.action)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createDatum()

  !this.support.createDatum()
  !!mdsAncill.action[2] = ||

  !colour = !!kfindDrawcolour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kreprelevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList = !this.support.atta

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- update gadgets
  !!ce = !this.support.datum
  !!mdsDistance(!this)
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  !datumExists = !this.support.datum.badref().not()
  !this.datum.active = !datumExists.not()
  !this.bDist.active = !datumExists
  !this.bThro.active = !datumExists

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance()

  !!mdsPosDist(!this)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
