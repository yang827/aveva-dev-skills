endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unenhance()

  do !atta values !this.support.atta
    unenhance $!atta
  enddo
  unenhance  $!this.support.stru
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction()

  !hplane = object PLANE(e0,Y is N wrt world and Z is U wrt world)
  !olddir = !this.support.datum.pdir[9].projected(!hplane)
  !dir = !this.direction.val.direction().wrt(world).projected(!hplane)
  handle ANY
    !dir = !olddir
  endhandle

  !this.direction.val = !dir.string().before('WRT /').trim()

  if !dir.eq(!olddir) then
    return
  endif

  !this.support.direction(!dir)
  if !this.graphicalDim then
    !!mdsshowdim(!this)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reverseDir()

  !newdir = !this.direction.val.direction().wrt(worl).opposite()
  !this.direction.val = !newdir.string().before('WRT /').trim()
  !this.direction()

endmethod
-- End of method
