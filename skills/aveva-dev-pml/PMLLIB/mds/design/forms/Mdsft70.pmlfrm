--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(BOOLEAN)              -
--  create(STRING)                   -
--  createDatum()                    -
--  direction()                      -
--  distance()                       -
--  init()                           -
--  mdsft70()                        -
--  reverseDir()                     -
--  setDatum()                       -
--  showDim()                        -
--  surfacePos(DBREF,REAL)           POSITION
--  throPos()                        -
--  unenhance()                      -
--  updateGadgets()                  -
