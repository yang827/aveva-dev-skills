-- Kill existing form definition
Kill !!MdsFtTestBars

-- Define Form
Setup Form  !!MdsFtTestBars at xr0 yr0

  !!MdsFtTestBars.formtitle    = |Test Values of Bars|
  !!MdsFtTestBars.icontitle    = |TVB|
  !!MdsFtTestBars.Callback     = ||
  !!MdsFtTestBars.formrevision = | $Revision: 1.1.19.1 $ |

Text .Number 'Support No.' at x0 ymin  call '!!MdsFtTestBars.Number.Setfocus()' is string
Button .TestBars  | Test | at xmax-6  ymax     Call |Call !!MdsFtTestBars(!!MdsFtTestBars.Number.val)|


exit
-- End of file Test.frm
