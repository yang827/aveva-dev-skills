--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply ()                         -
--  find(GADGET,STRING)              -
--  fromExistingAtta ()              -
--

-- Kill existing form definition
kill !!mdsGuide

-- Define Form
setup form !!mdsGuide dialog resizeable

  !!mdsGuide.formtitle    = |Ancillaries - Guides and Stops|
  !!mdsGuide.icontitle    = ||
  !!mdsGuide.callback     = |call !!mdsIguide()|
  !!mdsGuide.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  text .name     |Name: | at x0 y0.5 call |CALLIB NAMECHK _mdsGuide_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
  call !!mdsSupportForm(!!mdsGuide)
  call !!mdsSetSupp(!!mdsGuide)| width 20 name

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsAutoName|
  exit

  button .autoname | | tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsAutoName.getNextName(!this)|
  !this.autoname.setPopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!mdsIDfltSite()|

  button .startGroup | | at xmax+1 ymin tooltip 'New Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('NEW',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|
  !this.startGroup.active = TRUE

  path down
  vdist 0.1
  !length = !!mdsFormGui
  handle NONE
  elsehandle ANY
    !length = 14
  endhandle
  list .standard |Standard support type:| at x0 ymax+0.5 call |call !!kActionCommands(!!mdsGuide.listActions)| anchor R+L+T+B width 62 length $!length
  list .filterByPipe |Standard support type:| at x0 Ymin call |!!mdsGeneral.setmaster(!this)| anchor L+B width 62 length $!length

  -- Bottom Line
  button .ok     |   OK   | at xmin           ymax call |!this.apply()| anchor L+B
  button .view   | View...| at xmax+1         ymin Call |call !!mdsAddPlot(!!mdsGuide.standard, 'show',!!mdsGuide)| anchor L+B
  path right
  -- Modified for defect 10598
  text .find 'Find ' call |!this.find(!this.standard,!this.find.val)| anchor L+B width 10 STRING
  button .buttonForFilterByPipe tooltip |Filter by pipe| pixmap anchor L+B width 18 height 18 call |!!mdsGeneral.filterByPipe(!this)|
  !this.buttonForFilterByPipe.addPixmap(!!pML.getPathName('addpipe.png'))
  handle any
  endhandle
  button .noFilter tooltip |Display all available standards| pixmap anchor L+B width 18 height 18 call |!!mdsGeneral.noFilter(TRUE,!this)|
  !this.noFilter.addPixmap(!!pML.getPathName('all.png'))
  handle any
  endhandle
  button .cancel | Cancel | at xmax form-size ymin call |call !!mdsResetAutoName(!this)| anchor R+B

  -- Form Members
  -- Form Name of Support
  member .suppFunction is STRING

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Actions on list button
  member .listActions  is ARRAY

  --<wd>03nov2006<mds12>
  -- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
  --<wd>03nov2006<mds12>

  -- End form definition
exit

-- Actions to be taken on list gadget
!!mdsGuide.listActions[1] = |call !!mdsAddPlot(!!mdsGuide.standard, '',!!mdsGuide)|
!!mdsGuide.listActions[2] = |call !!mdsSupportForm(!!mdsGuide)|

-- Set icons
!!mdsSetIconBack(!!mdsGuide,'white')

--<wd>03nov2006<mds12>
-- Set the DEFAULT settings for the form Members
!this.error = TRUE
!this.emess = 'No MDS Guide/Stop Ancillaries available.'
--<wd>03nov2006<mds12>

-- Added method for defect 10598
define method .find(!gadget is GADGET,!string is STRING)

  -- Try and find string in selection list

  do !loop from 1 to !gadget.dtext.size()
    if !gadget.dtext[$!loop].matchwild('*$!string*') then
      -- Set found index
      !gadget.val = !loop
      -- Get callback and call
      !callback = !gadget.callback
      $!callback
      handle any
      endhandle
      if !callback.eq('!this.setmaster()') then
        !!mdsFrame.setmaster()
      endif
      return
    endif
  enddo

  !!alert.error('Unable to find string ' + !string)

endmethod
define method .fromExistingAtta ()
  !!mdsIdPreliminarySupp(!this)
endmethod
define method .apply ()
  !preliminary = object DBREF('/' & !this.name.val)
  handle any
    call $!this.suppFunction
  elsehandle none
    -- test if the selected item has the same support function as the preliminary support
    -- if no then show warning - if the answer is 'YES' then replace :mdssuppfunc of new atta
    !!ce = !preliminary
    !listChoice = !this.standard.selection()

    --try and find the SUPF entry for !listChoice in the MDS/APPDEFAULTS db
    !appDefName = '/MDS/ATTA/DEFAULTS/' + '$!listChoice' + '/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !ancilSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !ancilSuppFunc = $!appDefRef.ppro
    endhandle

    !prelimSuppFunc = !preliminary.:mdssuppfunc

    if ((!ancilSuppFunc neq !prelimSuppFunc) and (!prelimSuppFunc.unset().not() and !prelimSuppFunc.neq(''))) then
      !result = !!alert.confirm('The wrong Ancillary Type has been chosen. The preliminary support has a support function of ' + !prelimSuppFunc + ' but the chosen support function is ' + !ancilSuppFunc + '. Do you want to continue?')
      if (!result eq 'YES') then
        call $!this.suppFunction
      endif
    else
      call $!this.suppFunction
    endif
  endhandle
endmethod
