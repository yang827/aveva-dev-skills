--
-- File:		Mdshanger.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FCRACK
--
-- Author:		N.Morris
-- Created:		Thu Sept 4
--
--
-- Description:
-- Form Definition for Frameworks
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsHanger

-- Define Form
Setup Form !!MdsHanger

  !!MdsHanger.formtitle    = |Hangers|
  !!MdsHanger.icontitle    = ||
  !!MdsHanger.callback     = |call !!MdsIhanger()|
  !!MdsHanger.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    text .Name     |Name of support   | call |CALLIB NAMECHK _MdsHanger_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
call !!MdsSupportForm(!!MdsHanger)
call !!MdsSetSupp(!!MdsHanger)| width 20 name

    menu .autonamemenu
      add 'Select Naming File...' call |show !!Mdsautoname|
    exit

    button .Autoname |MDS Autoname| call |!!MdsAutoName.GetNextName(!This)|
    !This.AutoName.SetPopup(!This.autonamemenu)


    path down
    vdist 0.1
    list .Standard |Standard support type:| at x0 ymax+0.5 call |call !!KActionCommands(!!MdsHanger.ListActions)| width 62 length 14

  -- Bottom Line
    button .Ok     |   OK   | at xmin           ymax call |$$_SuppFunction|
    button .View   | View...| at xmax+1         ymin Call |call !!MdsAddPlot(!!MdsHanger.Standard, 'show',!!MdsHanger)|
    button .Set |Select Creation Zone...| at xmax+1 ymin call |Call !!MdsIDfltSite()|
    button .Cancel | Cancel | at xmax form-size ymin cancel

  -- Form Members
    -- Form Name of Support
    member .SuppFunction is STRING

    -- Form Name of Support
    member .SuppForm     is FORM

    -- User replacement text for support name
    member .Replacement  is STRING

    -- Actions on list button
    member .ListActions  is ARRAY

-- End form definition
exit

  -- Actions to be taken on list gadget
    !!MdsHanger.ListActions[1] = |call !!MdsAddPlot(!!MdsHanger.Standard, '',!!MdsHanger)|
    !!MdsHanger.ListActions[2] = |call !!MdsSupportForm(!!MdsHanger)|

-- End of file Mdshanger.frm
