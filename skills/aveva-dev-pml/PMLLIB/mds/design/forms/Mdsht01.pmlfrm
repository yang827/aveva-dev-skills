--
-- File:		Mdsht01.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Form Definition for Hangers
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsHt01

-- Define Form
setup form  !!MdsHt01 at xr0 yr0 noquit

  !!MdsHt01.formtitle    = ||
  !!MdsHt01.icontitle    = ||
  !!MdsHt01.Callback     = ||
  !!MdsHt01.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatHt01()|

    exit

    frame .FMisc |Options| at x0 ymax width 31

      para .PRodLength at x1 Ymax+0.2 text |Rod Length  |
      path right
      text .RodLength    || call |Call !!MdsModHang(!!MdsHt01,'LENGTH',!!MdsHt01.support.atta[1])| width 14 is real format !!DistanceFmt

      option .Clevis   |Clevis Size  | call |Call !!MdsModClevis(!!MdsHt01,!!MdsHt01.support.atta[1])| at x1 ymax+0.2  width 13

      option .Washer   |Spherical Washers |           at x1 ymax+0.2 call |call !!Mdssphwash(!!Mdsht01)| width 6
      button .SetSteel |    Set Height to Steel    | at x1 Ymax+0.2 call |Call !!MdsModHang(!!MdsHt01,'STEEL',!!MdsHt01.support.atta[1])|

      halign left

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
      button .Flip   at xmax+0.1 ymin tooltip 'Mirror Frame' pixmap width 18 height 18 call |Call !!MdsMirrorHt01()|
      button .Hand   at xmax+0.1 ymin tooltip 'Rotate Frame' pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsHt01)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsHt01)|
      button .ModSctn at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsHt01)|

-- Icons Row 2

      button .AddPack at x1 ymax+0.25 tooltip 'Add Packer' pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsHt01)|
      button .DelPack at xmax+0.1 ymin tooltip 'Delete Packer' pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsHt01)|
      button .Rotate at xmax+0.1 ymin tooltip 'Rotate Atta' pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsHt01,'!!MdsRotateHt01()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat at xmax+0.1 ymin tooltip 'Modify Datum Atta' pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsHt01)|
      button .Bedplate  at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsHt01,'ATTA')|
      button .Associate at xmax+0.1 ymin tooltip 'Associate Atta' pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsHt01)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations' pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsHt01)|

-- Icons Row 3

      button .FlipFw  at x1 ymax+0.3 tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsHt01,'FLIP')|
      button .ModAtta  at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsHt01,!!MdsModAt)|
      button .DeleteAtta  at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsHt01)|
      button .Nudge  at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsHt01)|
      button .Spool  at xmax+0.1 ymin tooltip 'Spooling' pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsHt01)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsHt01)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd  at xmax+0.1 ymin tooltip 'View Standard' pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsHt01,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsHt01,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsHt01,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsHt01,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsHt01)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdsht01)|
      button .Mdsadp at xmax+0.1 ymin tooltip 'ADP Drawlist' pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsHt01,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call ||

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptHt01()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,4,6,7,9,11,12,13,14,15,19,20,21,22,24,28,33,34,35,37,38,41,42,56,58'

-- End form definition
exit

---------------------------------------------------------------------------------------
-- Populate Option Gadget .Washer

   !dtext = array()
   !rtext = array()
   !dtext.Clear()
   !rtext.Clear()
   !dtext[1] = |No |
   !dtext[2] = |Yes   |
   !rtext[1] = |NO|
   !rtext[2] = |YES|
   !!Mdsht01.washer.dtext = !dtext
   !!Mdsht01.Washer.Rtext = !rtext


  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsHt01,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsht01,true)

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdsht01.frm
