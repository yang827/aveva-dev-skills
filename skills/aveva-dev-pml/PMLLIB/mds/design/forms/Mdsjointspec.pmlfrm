--
-- File: Mdsjointspec.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Mon 22nd June 1998
--
--
-- Description:
-- Form Definition for Spec selection for joints, specific to the MDS spec.
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsJointSpec

-- Define Form
setup form  !!mdsJointSpec at xr0 yr0

  !!mdsJointSpec.formtitle    = |Joint Specification|
  !!mdsJointSpec.icontitle    = |JOINTS|
  !!mdsJointSpec.callback     = ||
  !!mdsJointSpec.formrevision = | $Revision: 1.1.19.1 $ |


-- Option gadget showing joints to connect

   frame .jframe at x0.5 y 0  |Joint List| width 34
     button .jpick |Pick| at xmin+1 ymax call |!!mdsPickJoint()|
     option .jlist | | at xmax+1 ymin  call |!!mdsIJointSpec(_Jlist)| width 28
   exit

-- Spec Selection
   frame .sframe at x0.5 ymax+0.2 |MDS Joint Specification|

-- Available Specs
    button .load |Specification| at x1 y0.9 call |!!mdsIJointSpec(_Spec)|
    option .spec | | at xmax+1 ymin  call |!!mdsIJointSpec(_Spec)| width 19

-- Available Sections Types
    path down
    halign right
    option .styp |Sub-Type |  call |!!mdsIJointSpec(_Styp)| width19

-- Available Sections
    list .spre call |!!mdssetJGadgets()| width 36 length 4

  exit

-- Settings
    frame .pframe at x0.5 ymax_sframe+0.2 |Joint Alignment|

-- Justification Line
     para .jtex at x1 y1 text |Justification|
     option .just at xmax-8 ymin+1 call |!!mdsSetjointSpec('JUST')| width 4
     -- option .just |Justification | at x1 y1 call |!!mdsSetjointSpec('JUST')| width 4

--<dwaug2008-Dun979 Option to flip plate joints
-- Flip
     button .flip | Flip | at xmax+3 ymin tooltip 'Flip orientation' call |!!mdsSetjointSpec('FLIP')|
--<dwaug2008-Dun979 end of plate joint option

-- Cutback
      text   .cutb |Cutback| at xmax+1 ymin width 7 is REAL format !!distanceFmt

-- Loop option

    para .loopText at x1 ymax+0.5 text 'Loop: '

    button .left 'L' at xmax+1 ymin call |!!mdsLoopJline('LEFT')|
    button .centre 'C' at xmax+1 ymin call |!!mdsLoopJline('CENTRE')|
    button .right 'R' at xmax+1 ymin call |!!mdsLoopJline('RIGHT')|

-- Beta Angle
    text   .bang |Beta Angle| at xmax+3.25 ymin width 7 numeric min -180 max 180

--<wd>jan2001
-- show jlines
--      toggle .showj |Display| at xmin-23 ymin call |!!mdsShowJlines(!!mdsJointSpec.jlist.selection())|
--<wd>jan2001
    exit

-- esign Parameters
    frame .dframe at x0.5 ymax_PFRAME+0.2 |Joint Dimensions|

  -- Dimensions

--<dwaug2008-Dun979 Option to set plate joint angle added below
-- PANG added

      text   .leng |Length    | at x1 ymax width 7 is REAL format !!distanceFmt
      text   .widt |Width     | width 7 is REAL format !!distanceFmt
      text   .thkn |Thickness | width 7 is REAL format !!distanceFmt
      text   .owcc |O-Beam c/c | at xmax+1 ymin.leng width 7 is REAL format !!distanceFmt
      text   .atcc |A-Beam c/c | width 7 is REAL format !!distanceFmt
      text   .bdia |Bolt Dia.  | width 7 is REAL format !!distanceFmt
      text   .pang |Plate Angle| width 7 is REAL format !!distanceFmt
      button .default  | Default  | at x1 ymax-1  call |!!mdsDtseDefs()|

    exit

  -- Bottom Line
     button .dismiss  | Dismiss | at xmax form-size ymax+0.5 call |!!mdsjointCheck()|
     button .apply      | Apply | at x0             ymin     Call |Call !!mdsSetjointSpec('APPLY')| apply
     button .plot      |View...|  at xmax+2         ymin     Call |Call !!mdsShowJoinFile()|

-- joints in support

   member .joints is ARRAY
   member .support is MDSSUPPORT
-- form called from
   member .form    is FORM
-- mode form is in (modify/Create)
   member .mode    is STRING

-- End form definition
exit

      !!mdsJointSpec.cutb.val = 0
      !!mdsJointSpec.bang.val = |0|
      !!mdsJointSpec.leng.val = 0
      !!mdsJointSpec.widt.val = 0
      !!mdsJointSpec.thkn.val = 0
