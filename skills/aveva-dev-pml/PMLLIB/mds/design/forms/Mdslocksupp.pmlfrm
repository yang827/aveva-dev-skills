--
--
-- Description:
-- Form Definition for locking supports
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!Mdslocksupp

-- Define Form
Setup Form  !!Mdslocksupp

  !!Mdslocksupp.formtitle    = |Lock/Unlock Support|
  !!Mdslocksupp.icontitle    = ||
  !!Mdslocksupp.callback     = ||
  !!Mdslocksupp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    frame .Option |Lock/Unlock Options| at x0 ymax
      text   .Name   |Support Name |    at x0.5 y1   Call |Call !!MdsSelectSupp('LOCK', 'NAME','VERBOSE')| width 20 name
      !!Mdslocksupp.Name.val = 'unset'
      halign right
      path down
      button .Cursor | Identify By Cursor |  Call |Call !!MdsSelectSupp('LOCK', 'CURSOR','VERBOSE')|
      button .Ce | CE |  at x0.5 ymin Call |Call !!MdsSelectSupp('LOCK', 'CE','VERBOSE')|
    exit

  -- Bottom Line
    button .Ok     | Apply | at x0 ymax+0.5         Call |Call !!KActionCommands(!!Mdslocksupp.ApplyForm)|
    button .Cancel | Dismiss | at xmax form-size ymin Call |Call !!KActionCommands(!!Mdslocksupp.DismissForm)| cancel
    button .zoom     at xmax.ce+2.5 ymin.ce-0.2 tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdslocksupp)|

  -- Form Members
    -- List of support members
    member .SupportMem   is ARRAY

    -- List of actions to be taken on applying form
    member .ApplyForm    is ARRAY

    -- List of actions to be taken on dismissing form
    member .DismissForm  is ARRAY

-- End form definition
exit

-- Populate option gadgets
  -- Actions on dismiss button
    !!Mdslocksupp.DismissForm[1] = |UNENHANCE ALL|
    !!Mdslocksupp.DismissForm[2] = |!!MdsModifyCheck()|
    !!Mdslocksupp.DismissForm[3] = |!!Mdslocksupp.Name.val = 'unset'|
    !!Mdslocksupp.DismissForm[4] = |!!Mdslocksupp.SupportMem.clear()|
    !!Mdslocksupp.DismissForm[5] = |!!Mdslocksupp.ApplyForm[1] = ''|
    !!Mdslocksupp.DismissForm[6] = |!!Mdslocksupp.ApplyForm.remove(5)|

  -- Action on apply button
--< Modified - <ab> - 04mar2002
-- With current code, The Cancel button cannot be enabled
-- see below suggest code.
    !!Mdslocksupp.ApplyForm[1] = ||
    !!Mdslocksupp.ApplyForm[2] = |!!Mdslocksupp.Name.val = 'unset'|
    !!Mdslocksupp.ApplyForm[3] = |!!Mdslocksupp.SupportMem.clear()|
    !!Mdslocksupp.ApplyForm[4] = |!!Mdslocksupp.Cancel.active = false|
    !!Mdslocksupp.ApplyForm[4] = |!!Mdslocksupp.ApplyForm[1] = ''|
    !This.Zoom.addPixmap(!!PML.getPathName('zoomsupp.png'))
       handle any
       endhandle

----------------------------------------------------------------------
define method .action(!name is STRING)
----------------------------------------------------------------------

-- Find out if we want to lock or unlock the support

  !!ce = !name.dbref()
  !lock = lock

  if !lock then
    if !!alert.confirm('Are you sure you want to unlock the support $!name').eq('YES') then
      !This.unlock(!Name)
    endif
  else
    if !!alert.confirm('Are you sure you want to lock the support $!name').eq('YES') then
      !This.lock(!Name)
    endif
  endif

endmethod

----------------------------------------------------------------------
define method .lock(!name is STRING)
----------------------------------------------------------------------

  !!ce = !name.dbref()

  if !!ce.owner.type.eq('BRAN') then
    if !!ce.owner.:MDSTrun then
-- Only need to lock support belonging to branch name because another support
-- may be on the trunnion
      bran
      !mem = mem count
      !Supportmem = Array()
      do !ListMem from 1 to $!mem
        bran
        $!ListMem
        !tempName = !!mdsgetsuppname(!!ce)
        if !!ce.owner.name.match(!tempname).gt(0) then
          !Supportmem.append(!!ce)
        endif
      enddo
      do !lockmem values !supportmem
      lock
        handle any
          !!Alert.Error(!!Error.text)
        endhandle
      enddo
    else
      lock all
        handle any
          !!Alert.Error(!!Error.text)
        endhandle
    endif
  else
    do !Loop values !This.SupportMem
      !!CE = !Loop
      lock all
      !nam = !!CE.name
      -- add code to lock all trunnions and associated tees for VT19
      if (!!ce.type.eq('STRU')) then
        if (!!ce.:mdssupptype.eq('VT19')) then
          -- lock the guide trunnions and tees
          !!ce = $!<Nam>/DATUM
          handle any
          elsehandle none
            PIPE
            !pName = !!ce.name
            do !ii from 1 to 4
              !bName = !pName + !nam + '/' + !ii.string()
              !!ce = $!bName
              handle any
              elsehandle none
                GOTO HREF
                handle any
                elsehandle none
                  LOCK
                endhandle
                !!ce = $!bName
                LOCK ALL
              endhandle
            enddo
          endhandle
        endif
      endif
    enddo
  endif

  $!name

endmethod

----------------------------------------------------------------------
define method .unlock(!name is STRING)
----------------------------------------------------------------------

  !!ce = !name.dbref()

  if !!ce.owner.type.eq('BRAN') then
    if !!ce.owner.:MDSTrun then
      bran
      unlock all
        handle any
          !!Alert.Error(!!Error.text)
        endhandle
    else
      unlock all
        handle any
          !!Alert.Error(!!Error.text)
        endhandle
    endif
  else
   do !Loop values !This.SupportMem
      !!CE = !Loop
      unlock all
      !nam = !!CE.name
      -- add code to lock all trunnions and associated tees for VT19
      if (!!ce.type.eq('STRU')) then
        if (!!ce.:mdssupptype.eq('VT19')) then
          -- lock the guide trunnions and tees
          !!ce = $!<Nam>/DATUM
          handle any
          elsehandle none
            PIPE
            !pName = !!ce.name
            do !ii from 1 to 4
              !bName = !pName + !nam + '/' + !ii.string()
              !!ce = $!bName
              handle any
              elsehandle none
                GOTO HREF
                handle any
                elsehandle none
                  UNLOCK
                endhandle
                !!ce = $!bName
                UNLOCK ALL
              endhandle
            enddo
          endhandle
        endif
        unlock all
      endif
    enddo
  endif

  $!name

endmethod

-- End of file Mdslocksupp.frm
