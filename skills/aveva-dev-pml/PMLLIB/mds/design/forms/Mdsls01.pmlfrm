-- Define Form
Setup Form  !!Mdsls01 at xr0 yr0 noquit


-- Body of Form

  frame .Fsupport 'Support' at x0 y0 width 31

    text .name 'Name:' call '!!Mdsls01.CheckName()'  width 22 name
--    button .CreateMode 'Create Mode' at xmin ymax+0.25 tooltip 'Switch to Create Mode' call '!this.CreateMode()'
    button .Create 'Create' at xmin ymax+0.25 tooltip 'Create new support' call '!this.Create()'
    button .Autoname at xmax+1 ymin tooltip 'Autoname' pixmap width 19 height 19 call |!this.SetAutoname()|
    button .Set  at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!MdsIDfltSite()|

  exit

--  frame .FLighting |Supported Lighting| at x0 ymax+0.5 width 31

--    paragraph .NameLight at x1 y0.7 width 29 lines 1
    button .IDLighting | Identify lighting | at xmin ymax+0.5 Call |!this.IDlighting()|

--  exit

    button .sctncopy   at x1 ymax+0.5   tooltip 'Copy Section'         pixmap width 18 height 18 call |!this.CopyMemb()|
    button .tempcopy   at xmax+0.1 ymin tooltip 'Copy support from template' pixmap width 18 height 18 call |!this.ShowTemplates()|
    button .movejoin   at xmax+0.1 ymin tooltip 'Connect Support to Ceiling/Wall' pixmap width 18 height 18 call |!this.edgentry()|
    button .inclsctn   at xmax+0.1 ymin tooltip 'Include Section into Special' pixmap width 18 height 18 call |!this.inclsctn()|
    button .CreateByDim at xmax+1.5 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |!this.heig()|

    text .Heig 'Height' at x1 ymax+0.5 callback '!this.CheckHeig()' width 10 is REAL format !!distanceFMT

  frame .FMisc |Options| at x0 ymax+0.1 width 31


-- Icons Row 1

    button .AddPipe  at x1       ymax tooltip 'Add Pipe'       pixmap width 18 height 18 Call ||
    button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 Call ||
    button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 Call ||
    button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 Call ||
    button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 Call |!this.mirror()|
    button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 Call |!this.rotate()|
    button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 Call ||
    button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 Call |!!mdseditspsctn.init(!this)|

-- Icons Row 2

    button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'          pixmap width 18 height 18 Call ||
    button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 Call ||
    button .Rotate        at xmax+0.1 ymin tooltip 'Rotate All Atta'    pixmap width 18 height 18 Call ||
    button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 Call ||
    button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call ||
    button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 Call ||
    button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 Call ||
    button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 Call ||

-- Icons Row 3

    button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 Call ||
    button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 Call ||
    button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 Call ||
    button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 Call ||
    button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 Call ||
    button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 Call |!!MdsSetMat(!this)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call ||
    button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 Call ||

-- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Dimensions' pixmap width 18 height 18 call |!this.GraphicalDim()|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!this)|
    button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 Call |Call !!MdsIMdsAdp(!this,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call ||
    button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call ||
    button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call ||
    button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call ||
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call ||
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call ||
    button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6

    button .flipatta at x1 ymax+0.25  tooltip 'Flip Atta' pixmap width 18 height 18 call ||
    button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call ||
    button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call ||
    button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call ||
    button .addweld   at xmax+0.1 ymin tooltip 'Create Weld'              pixmap width 18 height 18 call |!!MdsSpecialWelds.init(!this)|
    button .repeat    at xmax+0.1 ymin tooltip 'Repeat Atta'              pixmap width 18 height 18 call ||
    button .cutsect  at xmax+0.1 ymin tooltip 'Trim SCTN End To Surface' pixmap width 18 height 18 call ||

  exit


-- Bottom Line
  button .Cancel  |Cancel| at xmax form-size ymax+0.5 callback '!this.Cancel()'
  button .Ok      |  OK  | at x0 ymin callback '!this.OK()'

-- Form Members
-- Support object
  member .Support     is MdsLSUPPORT

-- Support object storage for support regeneration
  member .Backup      is MdsLSUPPORT

-- dimension flag
  member .GraphicalDim is BOOLEAN

-- dimension aid number
  member .DimAidNumber is REAL

-- tagging aid number
  member .TagAidNumber is REAL

--
-- End form definition
exit


-- default settings
---------------------------------------------------------------------------------------------
define method .MdsLs01()

  !this.formrevision = | $Revision: 1.1.1.1 $ |

-- Set pixmap buttons
  !!MdsSetIconBack(!this,'white')

-- Block icons with no callback
   !allgadget = !this.attributes()
   !gadget = object GADGET()
   do !val values !allgadget
      !gadget = !this.$!val
        handle ANY
          skip
        endhandle
      skip if !gadget.unset()
      skip if !gadget.type().neq('BUTTON')
      !gname = !gadget.name()
      skip if !gname.eq('CANCEL')
      skip if !gadget.callback.empty().not()
      !gadget.active = false
   enddo

   !this.Newmenu('AUTONAMEMENU','POPUP')
   !this.autonamemenu.add('FORM','Select Naming File...','MDSAUTONAME')
   !This.AutoName.SetPopup(!This.autonamemenu)

   -- create global instance of MDSLSUPPDEFS object
   !!MDSLsuppDefs = object MDSLSUPPDEFS()


endmethod


-- initialize form (called externally) - it will show form if not shown
------------------------------------------------------------------------------------------
define method .Init(!Mode is STRING)

    if !!MDSLsuppDefs.Error.set() then
       !Error = !!MDSLsuppDefs.Error
       return error 1 '$!Error'
    endif

    !this.support.gadgetheig = !this.heig
    if !Mode.Upcase().eq('CREATE') then
       if !this.Shown().and(!this.Create.Active.Not().or(!this.create.active)) then
          return error 1 'Cannot create lighting support while another one is being modified!'
       endif
       !this.support.Mdslsupport()
       !this.backup.Mdslsupport()
       !this.name.val = 'unset'
       !this.Idlighting.active = false
       !Active = true
       !title = 'Create Lighting Support'
    else
       !this.support.Mdslsupport(stru)
       !this.backup = !this.support
       !this.Idlighting.active = !this.support.light.badref()
       !this.Name.val = !this.support.stru.name
       !Active = false
       !title = 'Modify Lighting Support'
    endif

    !this.name.seteditable(!Active)
    !this.create.active = false
    !this.autoname.active = !active
    !this.set.active = !active


    -- set buttons
    !this.setButtons()

    !this.formtitle = !title
    -- register aid graphic numbers
    !this.DimAidNumber = !!AidNumbers.Add('Graphical Dimension of Lighting Support')
    !this.TagAidNumber = !!AidNumbers.Add('Tagging of Lighting Support')
    !this.GraphicalDim = FALSE

    if !Mode.Upcase().eq('MODIFY') then
       aid text number $!this.tagaidnumber ('$!this.support.stru.namn') at $!this.support.origin
    endif

    -- display form
    if !this.Shown().Not() then
       !this.show()
    endif

endmethod

-- set buttons active/inactive
--------------------------------------------------------------------------------------------
define method .SetButtons()


    if !this.support.stru.badref() then
       !StruMembExist = FALSE
    else
       !StruMembExist = !this.support.tmpl.badref().not()
    endif

    !this.createbydim.active = !this.heig.active
    !this.movejoin.active = !this.heig.active
    !this.tempcopy.active = !this.support.light.badref().not()
    !this.inclsctn.active = !StruMembExist
    !this.sctncopy.active = !StruMembExist

    !this.ok.active = !StruMembExist
    !this.dim.active = !this.heig.active
    !this.flip.active = !StruMembExist
    !this.hand.active = !StruMembExist
    !this.ancnote.active = !StruMembExist
    !this.zoom.active = !StruMembExist
    !this.mdsadp.active = !StruMembExist
    !this.adploc.active = !StruMembExist
    !this.addweld.active = !StruMembExist
    !this.setmat.active = !StruMembExist
    !this.modsctn.active = !StruMembExist

endmethod


-- select lighting and support
--------------------------------------------------------------------------------------------
define method .IDlighting()


   !Light = !!Mdslsuppdefs.IdLighting()
   if !light.badref() then
      return
   endif

   -- update object .support
   !this.support.getdatafrom(!light)

   -- update form gadgets
   --!this.namelight.val = !light.namn
   !this.IDlighting.active = FALSE
   !this.tempcopy.active = TRUE

   !this.Showtemplates()

endmethod



-- create new support
---------------------------------------------------------------------------------------------
define method .Create()

      !name = !this.name.val
      if !name.eq('unset') then
         return
      endif

      !this.support.create(!name)
      handle ANY
        !!alert.error(!!error.text)
        return
      endhandle

      !this.init('modify')
      !this.backup.Mdslsupport()

      !this.idlighting()

endmethod

-- method to enhance/unenhance support
---------------------------------------------------------------------------------------------
define method .Enhance(!OnOff is BOOLEAN)

    if !this.support.stru.badref() then
       return
    endif

    unenhance $!this.support.stru

    if !onOff then
       !Col = !!gphColOpt.Highlight.Code
       enhance $!this.support.stru colour $!Col
    endif

endmethod


-- display list of templates to select
---------------------------------------------------------------------------------------------
define method .ShowTemplates()

   if !this.support.stru.badref() then
      !!alert.error('Support is not yet created!')
      return
   elseif !this.support.light.badref() then
      !!alert.error('Select the lighting first!')
      return
   endif

   !FormName = 'mdsselectls'

   !Dir = !this.support.endplane.direction().wrt(worl)
      handle ANY
        !Filtertype = 3
      elsehandle NONE
        if !Dir.Up.eq(0) then
           !Filtertype = 1
        elseif !Dir.Up.eq(1) then
           !Filtertype = 2
        else
           !Filtertype = 3
        endif
      endhandle

   !form = !!fmsys.loadform(!formname)
   !form.tmpllist = !this.support.getsupports()
   !form.CurrentTmpl = !this.support.tmpl
   !form.Mirror.val = !this.support.mirror
   !form.filtertype.val = !filtertype
   !form.show()

endmethod

-- check entered name
---------------------------------------------------------------------------------------------
define method .CheckName()

   !name = !this.name.val

   if !name.unset() then
      !name = 'unset'
   endif

   !name = !name.trim()

   if !name.empty().or(!name.eq('/')).or(!name.lowcase().eq('unset')) then
      !name = 'unset'
      !active = false
   else
      if !name.match('/').neq(1) then
         !name = '/' + !name
      endif
      !name.dbref()
          handle NONE
             !!alert.error('Name ($!name) already exists.')
             !name = 'unset'
             !active = false
          elsehandle ANY
             !active = true
          endhandle
   endif



   !this.name.val = !name
   !this.Create.active = !active

endmethod

-- set autoname
---------------------------------------------------------------------------------------------
define method .SetAutoName()

    !!MdsAutoName.GetNextName(!!mdsls01)

    !this.Create.active = !this.name.val.neq('unset')

endmethod

-- set support heig
---------------------------------------------------------------------------------------------
define method .Heig()

   !heig = !this.heig.val
   !this.support.Heig(!heig)

   if !this.graphicalDim then
      !this.Support.GraphicalDim(TRUE,!this.DimAidNumber)
   endif

   !!ce = !this.support.stru

   -- keep support highlighted
   !this.Enhance(on)

endmethod


-- check heig
---------------------------------------------------------------------------------------------
define method .CheckHeig()

    !heig = !this.heig.val
    !oldHeig = !this.support.heig

    if !heig.unset() then
       !this.heig.val = !oldHeig
       return
    endif

    !this.support.checkheig(!heig)
       handle ANY
         !!alert.error(!!error.text)
         !this.heig.val = !oldHeig
         return
       endhandle

endmethod


-- invoke EDG mode to pick surface
---------------------------------------------------------------------------------------------
define method .EdgEntry()

   if !this.support.stru.badref() then
      return
   endif

   if !this.support.light.badref() then
      !!alert.error('Select the lighting first')
      return
   endif

   if !this.support.tmpl.badref() then
      !!alert.error('Select template of support first')
      return
   endif

   !Form = !this.Fullname()

   !packet = object EDGPACKET()
   !packet.Description = 'setAncref'
   !packet.initialisation = '!this.input[1] = ce'
   !Packet.action = '$!<form>.Heig(!this.return[1])'
   !packet.close = '$!<Form>.setactive(true)'
   !packet.remove = true
   !pickpacket = object EDGPICKPACKET()
   !pickpacket.stdgraphic('Pick surface of ceiling/wall to connect to')
   !packet.pickpacket = !pickpacket

   !this.setactive(false)
   !!edgCntrl.add(!packet)

endmethod

-- set height and reference to ceiling/wall - run by callback of EDG pick
---------------------------------------------------------------------------------------------
define method .Heig(!Edgpick is EDGPICKDATA)

   if undefined(!this.support.rod[1]) or (!this.support.heig.unset()) then
     !!Alert.error('This support cannot be connected - template is not properly defined')
     return
   endif

   !this.support.Heig(!Edgpick)
      handle ANY
        !!Alert.error('Cannot connect support! ' + !!Error.text)
        return
      endhandle

   if !this.graphicalDim then
      !this.Support.GraphicalDim(TRUE,!this.DimAidNumber)
   endif

   !!ce = !this.support.stru

   !this.Enhance(on)

endmethod


-- mirror support
---------------------------------------------------------------------------------------------
define method .Mirror()

  !this.support.mirror()

   if !this.graphicalDim then
      !this.Support.GraphicalDim(TRUE,!this.DimAidNumber)
         handle ANY
         endhandle
   endif

   !this.enhance(on)

endmethod


-- display form to enter rotation angle
---------------------------------------------------------------------------------------------
define method .Rotate()


  !form = !!MdsRotan

  !form.angle.val = 90
  !form.formtitle = 'Rotate Support'
  !form.OK.callback = '!!$!<this>.Rotate(!this.angle)'
  !form.cancelcall = '!this.formtitle = ''Rotate All Attas'' !this.cancelcall = '''''
  !form.name.val = !this.support.stru.name

  !form.show()

endmethod


-- rotate support
---------------------------------------------------------------------------------------------
define method .Rotate(!Angle is GADGET)


  !Angle.val = !angle.val - (360 * int(!angle.val / 360))

  !this.support.rotate(!Angle.Val)

  !!ce = !this.support.stru

  !this.enhance(on)

endmethod


-- graphical dimension on/off
---------------------------------------------------------------------------------------------
define method .GraphicalDim()

      !Numb = !this.DimAidNumber
      !Onoff = !this.GraphicalDim.Not()

      !this.support.GraphicalDim(!Onoff,!Numb)
         handle 1
            !!Alert.error(!!error.text)
         endhandle
      !this.GraphicalDim = !Onoff


endmethod

-- OK button callback
---------------------------------------------------------------------------------------------
define method .OK()

      if !this.support.stru.badref().or(!this.support.light.badref()).or(!this.support.tmpl.badref()) then
         !!alert.error('Support is not completed or has not been created yet! Use "Cancel" button.')
         return
      endif

      !this.support.setatt()

      -- hide form
      !this.hidecall()

endmethod


-- Cancel button callback
---------------------------------------------------------------------------------------------
define method .Cancel()

   !support = !this.support
   !backup = !this.backup

   if !support.stru.badref().not() then
      if !backup.stru.badref() then
         if !support.light.badref().not().and(!support.tmpl.badref().not()) then
            !tobedeleted = !!alert.confirm('OK to cancel support "$!support.stru.namn"? This will DELETE the support!').Boolean()
         else
            !tobedeleted = true
         endif
         if !tobedeleted then
            !this.support.deleteSupp()
         else
            return
         endif
      else
         if !support.neq(!backup) then
            if !!alert.confirm('OK to cancel support "$!support.stru.namn"? This will reset the support prior to modifying!').boolean().not() then
               return
            endif
            !backup.restore()
         endif
      endif
   endif

   !this.Hidecall()

endmethod

-- common block executed when form is made hidden
--------------------------------------------------------------------------------------------------------------
define method .Hidecall()

   if !this.support.stru.badref().not() then
      !this.Enhance(off)
   endif

   -- reset callback on calling form
   !Owner = !this.owner()
   if !owner.set() then
      if !owner.name().eq('MDSMODIFYSUPP') then
        !owner.applyform[5].delete()
        !this.owner().cancel.active = TRUE
      endif
   endif

   -- unregister aidnumbers
   !!AidNumbers.Remove(!This.DimAidNumber)
   !!AidNumbers.Remove(!This.TagAidNumber)

   -- remove reference to height displayed gadget
   !this.support.gadgetheig = object GADGET()

   -- hide form
   !this.hide()

endmethod

--------------------------------------------------------------------------------------------------------------
define method .inclsctn()

-- Identify section

  prompt off
  prompt load escape 'Identify section to include into support'
  ID sctn @
    handle (61,528)
      prompt on
      return false
    endhandle
  prompt on

-- Get the poss and pose of the section in world coordinates to reset then so it is always in the same place
-- when it is included

  !SctnToInclude = !!ce

-- Is it part of another support

  !!MdsSilent = TRUE
  !CouldBeASupport = !!MdsGetSuppName(!!CE)
  !!MdsSilent.delete()
  if !CouldBeASupport.neq('ABORT') then
    if !Couldbeasupport.eq(!this.support.stru.name) then
      !!Alert.Error('Cannot include section as it is already part of this support')
      return
    else
      !!Alert.Error('Cannot include section as it is already part of a another support')
      return
    endif
  endif

  !!ce = !SctnToInclude

  !MemOfSctn = mem count
  if !MemOfSctn.neq(0) then
    !!Alert.Error('Cannot include section as it owns members')
    return
  endif
  !poss = poss wrt world
  !pose = pose wrt world

-- Goto out support frmw

  !!ce = frmw 1 of $!this.support.stru

-- Can we include it into the support

  !!MdsDacControl(TRUE)

  incl $!SctnToInclude
    handle ANY
      !!Alert.Error('Unable to include section into support because : ' + !!Error.text)
      return
    elsehandle NONE
      !!ce = !SctnToInclude
      poss $!poss
      pose $!pose
      unname
        handle ANY
        endhandle
    endhandle

  !!MdsDacControl(FALSE)

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .CopyMemb()


  -- Initialise variables
    !Support = !this.Support
    !Stru    = !this.Support.Stru


  -- Does the special contain any members yet
    var !Members coll all sctn for $!Stru
    if !members.unset() then
      !!Alert.Error('The support does not contain any members to copy')
      return
    endif

  -- Identify the section to copy
    prompt off
    prompt load escape 'Identify section to copy'
    !id = ref of ID SCTN @
      handle (61,528)
        prompt on
        return
      endhandle
    prompt on

  -- Does the section belong to the special

    if !id.ownls[3].neq(!Stru) then
      !!Alert.Error('The section identified does not belong to this support ' + !Stru.name)
      return
    endif


    !units = object COMUNITS(TRUE)

-- Turn DAC control on
    !!MdsDacControl(true)

    !!ce = !id
    !OldSuffix = !!ce.name.after('-V')
    !prevsctn = !!ce
    if (!!isImperialLength('DIST').not()) then
      new sctn copy prev by u 300mm wrt /*
    else
      new sctn copy prev by u 12IN wrt /*
    endif


-- dtf >>> Mod to copy joints 30.09.04
   !NewSctn = !!ce

    end
    reorder same after last mem
    stru
    !StruName = Name
    !!ce = !NewSctn
    do !Rename from 1 to 100
      name $!StruName-V$!Rename
        handle any
          skip
        elsehandle NONE
          !NewSuffix = !Rename
          break
        endhandle
    enddo

   !NewSctnName = !!CE.Name
   if !prevsctn.jois.unset().not() then
     new pnod
     if !prevsctn.joie.unset().not() then
        name $!NewSctnName/PNOD2
     else
        name $!NewSctnName/PNOD
     endif
     !pnods = !prevsctn.jois.owner
     copy  $!pnods
     pjoi 1
     if !prevsctn.joie.unset().not() then
        name $!NewSctnName/PJOI2
     else
        name $!NewSctnName/PJOI
     endif
     !pjois = !!ce
     !!ce = !NewSctn
     jois $!pjois

   endif
  if !prevsctn.joie.unset().not() then
     new pnod
     if !prevsctn.jois.unset().not() then
        name $!NewSctnName/PNOD1
     else
        name $!NewSctnName/PNOD
     endif
     !pnode = !prevsctn.joie.owner
     copy  $!pnode
     pjoi 1
     if !prevsctn.jois.unset().not() then
        name $!NewSctnName/PJOI1
     else
        name $!NewSctnName/PJOI
     endif
     !pjoie = !!ce
     !!ce = !NewSctn
     joie $!pjoie
   endif
   !!ce = !NewSctn
-- dtf <<< End of Mod



   !newname = name
    --end
    --reorder same after last mem
    --$!newname

-- Copy weld locally for new section

   !MdsWeldData = :MdsWeldData
   !NewMdsWeldData = ARRAY()

   do !CopyWelds values :MdsWelddata
     !!ce = !CopyWelds
     !Oldname = !!ce.name
     end
     last mem
       handle ANY
       endhandle
     !NewDdseName = !CopyWelds.name.replace('-V$!OldSuffix','-V$!NewSuffix')
     new ddse $!NewDdsename copy $!CopyWelds rename $!OldName $!Newddsename
       handle (41,12)
         delete ddse
         $!NewDdsename
         delete ddse
         !!ce = !CopyWelds
         end
         last mem
           handle ANY
           endhandle
         new ddse $!NewDdsename copy $!CopyWelds rename $!Oldname $!Newddsename
       endhandle
     !NewMdsWeldData.append(!!ce)
   enddo

   $!Newname
   !!ce.:MdsWeldData = !NewMdsWeldData
     handle any
     endhandle

-- Turn DAC control off

    !!MdsDacControl(false)

    if (!!isImperialLength('DIST').not()) then
      !!Alert.Message('The indentified section has been copied , moved up 300mm and named $!NewName')
    else
      !!Alert.Message('The indentified section has been copied , moved up 1FT and named $!NewName')
    endif

endmethod

