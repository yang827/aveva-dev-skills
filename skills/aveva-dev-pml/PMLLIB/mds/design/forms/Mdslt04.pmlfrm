--
--
-- Description:
-- Form Definition for General Ancillary Type 01
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  enhance()                        -
--  modat(BORE)                      -
--  rPad(FORM,GADGET)                -
--
kill !!mdsLT04

-- Define Form
setup form  !!mdsLT04 at xr0 yr0 noquit

  !!mdsLT04.formTitle    = ||
  !!mdsLT04.iconTitle    = ||
  !!mdsLT04.callBack     = ||
  !!mdsLT04.formRevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1

  -- Create Datum
  frame .fDatum |Datum| at x0 ymax width 31

    button .datum | Create datum support atta | at x1 y1 call |Call !!mdsSetDatLT04()|
    --<wd> .button .bDist | Distance | at xmin   ymax+0.25       Call |Call !!mdsPosDOnly(!!mdsLT04)|
    button .bDist | Distance | at xmin   ymax+0.25       call |Call !!mdsPosDist(!!mdsLT04)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    --<wd> button .bThro | Through |  at x1     ymax+0.2        Call |Call !!mdsPosTOnly(!!mdsLT04)|
    button .bThro | Through |  at x1     ymax+0.2        call |Call !!mdsPosThro(!!mdsLT04)|
    option .select             at xmax+1 ymin            call |Call !!mdsThroSelect(!!mdsLT04)| width 13
    para   .p                  at x1     ymax+0.2 width 25 lines 1

  exit

  frame .fMisc |Options| at x0 ymax width 31
    toggle .rPad | Reinforcing Pad | at x1 ymax call |!this.rPad(!this,!this.rPad)|

    -- Icons Row 1
    button .addPipe  at x1       ymax+0.5 tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorLT04()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsLT04)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsXAlign(!!mdsLT04)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call ||

    -- Icons Row 2
    button .addPack       at x1 ymax+0.25 tooltip  'Add Packer'         pixmap width 18 height 18 call ||
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate All Attas'   pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsLT04,'!!mdsRotateLT04()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |!!mdsRotateAtta.rotateOnly(!this)|
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call | !!mdsnewdatum(!this)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsLT04,'ATTA')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call ||

    -- Icons Row 3
    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |!!mdsIModAt(!this,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |!!mdsDeleteAtta(!this)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsLT04)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call ||
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsLT04)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

    -- Icons Row 4
    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call ||
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call ||
    button .forceCon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call ||
    button .disConn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call ||
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsLT04)|
    button .mdsAdp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call ||
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsLT04)|
    button .adpLoc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call ||

    -- Icons Row 5
    button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
    button .ancMat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
    button .ancCopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
    button .ancNudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setLen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunMat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
    button .ancNote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
    button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

    -- Icons Row 6
    button .flipAtta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
    button .suppData at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .editAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|

  exit

  -- Bottom Line
  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptLT04()|

  -- Form Members
  -- Support object
  member .support     is MDSSUPPORT

  -- Graphical representation
  member .repre       is ARRAY

  -- Form Storage for support restoration
  member .store       is ARRAY

  -- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

  -- Support Regeneration function
  member .regen       is STRING

  -- BedPlate Reference
  member .struBpref   is ARRAY

  -- BedPlate Reference
  member .storeBpref  is ARRAY

  -- Graphical dimensions
  member .graphicalDim is BOOLEAN

  -- Blocked icons
  member .blockedIcons is STRING
  !this.blockedIcons = '1,2,3,4,6,7,11,12,13,15,19,20,21,22,24,28,34,35,41,42,56,58,62'

  -- End form definition
exit

-- Set background colour of pixmaps to white
!!mdsSetIconBack(!!mdsLT04,'white')

-- Turn off blocked icons
!!kResetActive(!!mdsLT04,TRUE)

-- Populate option gadgets
call !!mdsLoadOption(!!mdsLT04.select)

-- End of FORM Members Definition

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
------------------------
define method .rPad(!form is FORM, !gadget is GADGET)
  ------------------------

  -- Check if DATUM exists before Proceeding
  if (!form.support.datum.unset()) then
    !gadget.val = FALSE
    !!alert.error('The Datum ATTA must exist before adding a Reinforcing Pad')
    return
  endif

  -- Find current units and set the distance unit to metric
  !isImperial   = !!isImperialLength('DIST')
  !currentunits = !!kgetsetunits()

  -- Initialise Variables
  !alias = 'AC34'
  !datum = !form.support.datum
  !dName = !datum.name
  !ceOri = !!ce
  !!ce   = !datum
  !rPNam = !dName & '.1'

  -- Set DACs Control
  !!mdsdaccontrol(TRUE)

  -- Create New REINFORCING PAD ATTA - AC34 - if Toggle is TRUE
  -------------------------------------------------------------
  if (!gadget.val) then
    -- Select ancillary
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

    -- Set Bore Units for Error Message Only
    $!boreUnits
    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

    -- Create the ATTA
    new ATTA
    spkbrk TRUE
    --$P SELECT SPEC /MDS WITH STYP '$!alias'
    !choice = SELECT SPEC /MDS WITH STYP '$!alias'
    handle ANY
      delete ATTA
      !projStandard = !this.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    units mm bore
    spref $!choice[1]
    !rPadAtta = !!ce

    -- Set the Despars
    !!mdsSetDespars(!!ce)

    -- Get the FDEP property from the datum that is the distance between the flanges
    -- and set it as FDEP of the pad
    !desp1 = (prop FDEP of $!form.support.datum )
    handle ANY
      !desp1 = (prop CTHK of $!form.support.datum )
    endhandle
    despar n1 $!desp1

    -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
    -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
    -- the OBJECT MDSCHECKSTD method .insu() will return 'TRUE' and skip the code shown below
    !mdsattaobj  = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!bore.real())
    if (!mdsattadefs.not()) then
      !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
      !!kRestoreUnits(!currentunits)
      delete atta
      !!mdsdaccontrol(FALSE)
      return
    endif
    !check = object MDSCHECKSTD(!mdsattaobj)
    --!check = object MDSCHECKSTD()
    !min = STRING()
    !max = STRING()
    !matError = STRING()

    !!ce = !rPadAtta
    if (!check.material(!matError).not()) then
      !!alert.error (!matError)
      !!kRestoreUnits(!currentunits)
      delete ATTA
      return
    endif

    !!ce = !rPadAtta
    if (!check.insu(!alias,!min,!max).not()) then
      var !insu insu
      if( !isImperial ) then
        !units = 'in'
      else
        !units = 'mm'
      endif
      !!kFormatText.text.val  = $!max$n
      !maxVal = !!kFormatText.text.val.string(!!distanceFmt)
      !!kFormatText.text.val = $!min$n
      !minVal = !!kFormatText.text.val.string(!!distanceFmt)
      !!kFormatText.text.val = $!insu$n
      !insVal = !!kFormatText.text.val.string(!!distanceFmt)
      !projStandard = !this.support.replace
      !!alert.message ('The INSULATION on the identified pipe ($!<insVal>$!<units>) is not within the MIN ($!<minVal>$!<units>) and MAX ($!<maxVal>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!projStandard')
      !!kRestoreUnits(!currentunits)
      !this.rPad.val = FALSE
      delete ATTA
      return
    endif

    -- Set the ATTA material
    !!ce = !rPadAtta
    !!mdsSetMatref(!!ce)

    -- Name support
    !!ce = !rPadAtta
    name $!rPNam
    --Temporarily Set the Form Support Type
    !form.support.type  = 'AC34'

    !!mdsSetIspe()
    !!mdsSelLstu(!!ce)

    -- <sk> 10/07/2012 Check user criteria with AC34
    !criteria = !check.criteria()
    if (!criteria.empty().not()) then
      !!alert.error (!criteria)
      !!kRestoreUnits(!currentunits)
      !this.rPad.val = FALSE
      delete ATTA
      return
    endif
    -- <sk> 10/07/2012
    --  Add stex for isometrics
    !sAtta = !!ce
    !!mdsTransport(!sAtta,!rPNam)

    -- Position RPAD ATTA
    pos at prev
    handle ANY
      pos at ph
    endhandle
    ori

    -- Always add ATTA to support object
    !!ce = !rPadAtta
    !this.support.atta.append(!!ce)
    !this.support.paDir  = pa dir wrt world
    !this.support.plDir  = pl dir wrt world
    !this.support.p9Dir  = p9 dir wrt world

    -- Add marker text
    !!mdsAidText(!this)

    -- Enhance LT04 Support
    !this.enhance()

    -- Invoke the Modify ATTA Form for the RPAD Atta Dimensions
    !!ce = !rPadAtta
    !this.modat(!bore)
    -- Reset the Form Support Member back to the Owning Support Lug Form Type
    -- from the temporary type of the RPAD ATTA
    !form.support.type = 'LT04'

    -- This is applicable for LT04, LT07 & LT08
    -- Change desp[9] of LT04 to Y for code
    !!ce = !datum
    despar n9 Y

    --><wd>18mar2009 - Defect No. P16924
    -- Reset the Pipe NWeld Values to 0<zero> at the LT04 DATUM Support ATTA after the RPAD ATTA has been CREATED
    -- The NWELDS Value for the RPAD ATTA is set via the PML function !!mdsTransport.pmlfnc above when the STEX is set for the ISOMETRIC
    !!ce = !datum
    NWELDS 0
    --><wd>18mar2009 - Defect No. P16924
  else
    -- Delete Existing REINFORCING PAD Atta -AC34 - if Toggle is FALSE
    ------------------------------------------------------------------
    -- Change desp[9] of LT04 to N for code
    !!ce = !datum
    despar n9 N

    !this.support.atta.removelast()
    !rPNam = !dName & '.1'
    !rPAtt = !rPNam.dbref()
    handle NONE
      !!ce = !rPAtt
      delete ATTA
    elsehandle ANY
    endhandle

    --><wd>18mar2009 - Defect No. P16924
    -- Reset the Pipe NWeld Values at the LT04 DATUM Support ATTA after the RPAD ATTA has been DELETED
    !!ce = !datum
    !!mdsNWelds(!datum)
    --><wd>18mar2009 - Defect No. P16924

    -- Remove Graphical Aid Text for the RPAD Atta -<DATUM ATTA is always 210>-
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211

    -- Enhance LT04 Support
    !this.enhance()

    -- Hide !!mdsModAt form
    !!mdsModAt.hide()
  endif

  -- Navigate Back to Original Component
  !!ce = !ceOri
  handle ANY
    !!ce = !datum
    handle ANY
      -- Could not find the Original Component
    endhandle
  endhandle

  -- Reset the Project Units
  !!kRestoreUnits(!currentunits)

  -- UnSet DACs Control
  !!mdsdaccontrol(FALSE)

  ------------------------
endmethod
------------------------

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

------------------------
define method .enhance()
  ------------------------

  -- Enhance ALL Ancillaries in the set Graphical Highlight Colour
  !ancills = !this.support.atta
  do !indx values !ancills
    enhance $!indx col $!!gphcolopt.highlight.code
  enddo

  ------------------------
endmethod
------------------------

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

------------------------
define method .modat(!bore is BORE)
  ------------------------

  -- This method simulates the initialisation function !!mdsIModAt
  -- for the Modify Ancillary Form, without having to IDENTIFY GRAPHICALLY
  -- the reinforcing pad atta 'AC34'

  -- Get Alias of The RPAD ATTA
  !alias = !!ce.styp

  -- Set the Necessary gadgets on the Modify Ancillary Form
  !!mdsModAt.support           = !this.support
  !!mdsModAt.modifyType.active = FALSE
  !!mdsModAt.name.val          = !!ce.name
  !!mdsModAt.atta              = !!ce
  !!mdsModAt.setSteel.active   = FALSE
  !!mdsModAt.setDefault.active = TRUE
  !!mdsModAt.support.alias     = !alias
  -- Set the Default AC34 Parameters for the Current Bore Size
  ------------------------------------------------------------------------------
  -- mjb >>> 02.05.06 <mds12>
  --!!mdsModAt.length.val        = !!mdsparac34[!bore.real()].despars[2].real()
  --!!mdsModAt.thickness.val     = !!mdsparac34[!bore.real()].despars[3].real()
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real())
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    --    !!kRestoreUnits(!currentunits)
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !!mdsModAt.length.val        = !mdsattaobj.despars[2].real()
  !!mdsModAt.thickness.val     = !mdsattaobj.despars[3].real()
  -- mjb 02.05.06 <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsModAt.angle.val     = '0'
  !!mdsModAt.height.val     = 0
  !!mdsModAt.angle.active     = FALSE
  !!mdsModAt.height.active     = FALSE

  --  Set the Modify Ancillary Form gadgets
  !!mdsSetGadgets(!this,!!ce,!alias)

  -- Show the Modify Ancillary Form
  -- !!kShowForm(!!mdsModAt)

  ------------------------
endmethod
------------------------

