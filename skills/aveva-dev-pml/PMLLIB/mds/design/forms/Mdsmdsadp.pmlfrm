--
-- File:      Mdsmdsadp.pmlfrm
-- Type:      Form Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    Design
-- Replaces:
--
-- Author:    Neale Morris
-- Created:   Mon 17th Aug 1998
--
--
-- Description:
-- Form to add, remove and view elements to be added to the MDS ADP drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -
--  swaplists(STRING)                -
--

-- Kill existing form definition
kill !!mdsMdsAdp

-- Define Form
setup form  !!mdsMdsAdp

  !!mdsMdsAdp.formtitle    = |MDS ADP Drawlist|
  !!mdsMdsAdp.icontitle    = ||
  !!mdsMdsAdp.callback     = ||
  !!mdsMdsAdp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .tag text |Support Name:|
  para .name at xmax+2 ymin width 20 lines 1

  rgroup .addrem  at xmin.tag ymax call |!this.swaplists(!this.addrem.selection())|
    add tag 'Add List ' select 'ADD'
    add tag 'Remove List ' select 'REMOVE'
  exit

  list .eleList  | Add list Contents    | at x0 ymax+0.5 width 50 length 10

  button .add    | Add |   at x1 ymax+0.5 call |Call !!mdsMMdsAdp('ADD')|
  path right
  hdist 0.5
  button .remove | Remove | call |!!mdsMMdsAdp('REMOVE')|
  button .clear  | Clear | call |!this.clear()|
  path down
  toggle .signif |Significant Element| at xmax+2 ymin

  -- NEMC Floquet: added AddCE button
  button .addCe | AddCE |   at x1 ymax+0.2 call |Call !!mdsMMdsAdp('ADDCE')|

  button .dismiss  | Dismiss | call |!!mdsIMdsAdp(!!mdsMdsAdp,'DISMISS')| at xmax form-size ymax-0.5 ok

-- Create form members

  member .form is FORM

  member .enhance is ARRAY

-- End form definition
exit

define method .swaplists(!type is STRING)

if !type eq 'ADD' then
    !this.eleList.tag = | Add list Contents    |
else
    !this.eleList.tag = | Remove list Contents |
endif
  !!mdsIMdsAdp(!!mdsMdsAdp.form,'INIT')

endmethod

define method .clear()

  --<kp>jul07
  --!!ce = !this.form.support.datum
  !!ce = !this.form.support.getelemforUDA()

  if !this.eleList.tag.eq(' Add list Contents    ') then
    if !!alert.confirm('Are you sure you want to clear the add list').eq('YES') then
      !!mdsDacControl(TRUE)
      :MdsAdp default
      !this.eleList.clear()
      do !unenhance values !this.enhance
        unenhance $!unenhance
      enddo
      !this.enhance.clear()
      !!mdsDacControl(FALSE)
    endif
  else
    if !!alert.confirm('Are you sure you want to clear the remove list').eq('YES') then
      !!mdsDacControl(TRUE)
      :MdsAdpRem default
      !this.eleList.clear()
      !!mdsDacControl(FALSE)
    endif
  endif

endmethod
