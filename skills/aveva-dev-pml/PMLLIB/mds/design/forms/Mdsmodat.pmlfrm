--
-- File:		Mdsmodat.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Form Definition for General Ancillary Type 01
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsModAt

-- Define Form
Setup Form  !!MdsModAt at xr0 yr0 noquit

  !!MdsModAt.formtitle    = |Modify Ancillary|
  !!MdsModAt.icontitle    = |Mod Ancill|
  !!MdsModAt.Callback     = ||
  !!MdsModAt.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    frame .FMisc |Options| at x0 ymax width 31

      para .PHeight at x1 Ymax+0.2 text |Height      |
      path right
      text .Height    || call |!!kactioncommands(!!Mdsmodat.actionheight)| width 14 is real format !!DistanceFmt
      para .Plength at x1 Ymax+0.2 text |Length      |
      text .Length    || call |!!kactioncommands(!!Mdsmodat.actionlength)| width 14 is real format !!DistanceFmt
      para .PThickness at x1 Ymax+0.2 text |Thickness   |
      text .Thickness || call |!!kactioncommands(!!Mdsmodat.actionthickness)| width 14 is real format !!DistanceFmt
      para .PAngle at x1 Ymax+0.2 text |Angle       |
      text .Angle     || call |!!kactioncommands(!!Mdsmodat.actionangle)| width 14 integer

   --  button .SetDefault | Set Parameters to Default  | at x1 Ymax+0.2 call |!!MdsSetDef(!!MdsModAt.Support.Alias,!!MdsModat.atta,'CONFIRM')|
   --  button .SetSteel   |Set Height to Steel/Bedplate| at x1 Ymax+0.2 call |Call !!MdsModShoe(!!MdsModAt,'STEEL',!!MdsModat.atta)|
   --  button .ModifyType |Modify Ancillary Type...    | at x1 Ymax+0.2 call |Call !!MdsModAnc('Combined')|
   --  button .Edit       |Modify Ancillary            | at x1 Ymax+0.2 call |!this.editatta()|

      button .SetDefault at x1       ymax+0.2 tooltip |Set Parameters to Default|    pixmap width 18 height 18 call |!!MdsSetDef(!!MdsModAt.Support.Alias,!!MdsModat.atta,'CONFIRM')|
      button .SetSteel   at xmax+2 ymin     tooltip |Set Height to Steel/Bedplate| pixmap width 18 height 18 call |Call !!MdsModShoe(!!MdsModAt,'STEEL',!!MdsModat.atta)|
      button .ModifyType at xmax+2 ymin     tooltip |Modify Ancillary Type|        pixmap width 18 height 18 call |Call !!MdsModAnc('Combined')|
      button .Edit       at xmax+2 ymin     tooltip |Modify Ancillary|             pixmap width 18 height 18 call |!this.editatta()|

    exit

  -- Bottom Line
    button .Cancel  | Dismiss | at xmax form-size ymax+0.5 call |Call !!MdsCheckDesp()|

    -- Form Members
    member .Atta is DBREF
    member .actionheight is ARRAY
    member .actionlength is ARRAY
    member .actionthickness is ARRAY
    member .actionangle is ARRAY
    member .CallingForm is FORM

-- Populate Form Members with Default Callbacks
   !!Mdsmodat.actionheight[1]    = |call !!Mdsmodshoe(!!Mdsmodat,'HEIGHT',!!Mdsmodat.atta)|
   !!Mdsmodat.actionheight[2]    = ||
   !!Mdsmodat.actionlength[1]    = |call !!Mdsmodshoe(!!Mdsmodat,'LENGTH',!!Mdsmodat.atta)|
   !!Mdsmodat.actionlength[2]    = ||
   !!Mdsmodat.actionthickness[1] = |call !!Mdsmodshoe(!!Mdsmodat,'THICKNESS',!!Mdsmodat.atta)|
   !!Mdsmodat.actionthickness[2] = ||
   !!Mdsmodat.actionangle[1] = |call !!Mdsmodshoe(!!Mdsmodat,'ANGLE',!!Mdsmodat.atta)|
   !!Mdsmodat.actionangle[2] = ||

    -- Support object
    member .Support     is MdsSUPPORT


    -- Graphical representation
    -- member .Repre       is ARRAY
    -- Form Storage for support restoration
    member .Store       is ARRAY
    -- Support object storage for support regeneration
    -- member .Backup      is MdsSUPPORT
    -- Support Regeneration function
    -- member .Regen       is STRING
    -- BedPlate Reference
    -- member .StruBpref   is ARRAY
    -- BedPlate Reference
    -- member .StoreBpref  is ARRAY

-- Extra members for edit button
-- Shoe Reference
    member .shoeref is DBREF
-- Shoe Existing Height
    member .shoehei is REAL
-- Associated Trunnion Length
    member .tlength is real
-- Store for the Initialised OK callback
    member .storeaction is ARRAY
-- Define the 'AT60' Specific Object Members Required.
    member .offset is REAL
    member .flan   is DBREF

-- End form definition
exit

-- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsModAt,'white')

-----------------------------------------------------------------------------------------------
-- Method to edit attas on the support that have extra parameters

define method .editatta()

-- Get the styp of the atta being edited

  !!ce = !this.atta
  !StypOfAtta = styp

-- Perform Any actions required BEFORE the modification of a MDS ANCILLARY Standard ATTA

  -- !where = ''
  !set   = object mdsframeancills()

  -- !set.before(!!MdsModAt,!StypOfAtta)
  --if (!set.return) then

  !idcomp = !!CE.:mdsguideref.string()

    -- !where  = !set.where
  --else
-- Creation Aborted by USER during Identification via the Graphical View
    -- return
  --endif

----------------------------------------------------------------------------------------------
-- Perform ANY actions required AFTER the Creation of a MDS ANCILLARY Standard ATTA
  --if (!set.return) then
    !set.form = !!mdsmodat
    !set.after(!idcomp,!this.atta)
  -- endif

----------------------------------------------------------------------------------------------

endmethod


-- End of file Mdsmodat.frm
