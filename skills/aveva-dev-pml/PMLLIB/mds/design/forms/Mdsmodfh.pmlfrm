---------------------------------------------------------------------------------------------------------------------------
define method .tagHangers(!hangerForm is FORM)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !support = !hangerForm.support
  if(!support.unset()) then
    !!kRestoreUnits(!currentunits)
    return
  endif
  !oRest = !support.rest
  if(!oRest.unset()) then
    -- rest not set
    !!kRestoreUnits(!currentunits)
    return
  endif
  !hangers = !oRest.hangers
  !ce = !!ce
  aid clear text 300
  handle any
  endhandle
  if(!hangers.set() and !hangers.size() gt 1) then
    -- we have more than one hanger
    do !oHangI indices !hangers
      -- skip the first hanger which is not part of the double hangers
      skip if(!oHangI eq 1)
      !oHang = !hangers[!oHangI]
      !hangRef = !oHang.ref
      !!ce = !hangRef
      !hpos = hpos
      !tpos = tpos
      !midPoint = !hpos.midPoint(!tpos)
      !hangNo = !oHangI - 1
      aid text num 300 'Hanger $!hangNo' at $!midPoint
    enddo
  endif
  !!ce = !ce
  !!kRestoreUnits(!currentunits)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .unTagHangers()
  aid clear text 300
  handle any
  endhandle
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
-- called from SetRodsToModify just once
define method .rodsToModify(!hangerForm is FORM) is ARRAY
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  !!mdsModFH.restRods = ARRAY()
  !support = !hangerForm.support
  if(!support.unset()) then  $* support not set so return an empty array
    !!kRestoreUnits(!currentunits)
    return !!mdsModFH.restRods
  endif
  !atta = !support.datum
  if(!atta.unset()) then    $* datum not set so return an empty array
    !!kRestoreUnits(!currentunits)
    return !!mdsModFH.restRods
  endif
  !oRest = !support.rest
  if(!oRest.unset()) then   $* rest not set so return an empty array
    !!kRestoreUnits(!currentunits)
    return !!mdsModFH.restRods
  endif

  !hangers = !oRest.hangers
  do !oHangI indices !hangers
    --skip if(!hangers.size() gt 1 and !oHangI eq 1)
    -- mod to allow constants with 2 hangers through
    skip if(!hangers.size() eq 3 and !oHangI eq 1)
    !oHang = !hangers[!oHangI]
    !hangerRods = ARRAY()
    !hangMem = !oHang.hangMem
    do !oHangMem values !hangMem
      !!ce = !oHangMem.ref
      !maxHeight = :MDSMaxHeight of catref
      !minHeight = :MDSMinHeight of catref
      if(!maxHeight.set() and !minHeight.set() and (!maxHeight gt !minHeight) and !!ce.type eq 'HROD' ) then
        !hangerRods.append(!!ce.string())
      elseif(!!ce.type inset ('EYRD')) then
        !hangerRods.append(!!ce.string() + '_FIXEDLENGTH')
      endif
    enddo
    !oHang.rods = !hangerRods
    !!mdsModFH.restRods.append(!oHang.rods)
  enddo
  !!ce = !ce

  !!kRestoreUnits(!currentunits)
  return !!mdsModFH.restRods
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
-- callback method resulting from a change in the rod lengths
-- called directly from the gadgets and no where else
define method .setRodLength(!hangerNo is REAL, !rodID is STRING)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  !rods = !!mdsModFH.restRods[!hangerNo]

  -- set up the max/minimum lengths
  if(!rodID eq 'TOP') then
    !rod = !rods[2].dbref()
    !other = !rods[1].dbref()
    !otherGadget = !!mdsModFH.bottomRodLength$!hangerNo
    !gadget = !!mdsModFH.topRodLength$!hangerNo
    -- set the new rod length variable
    !action = '!newCeRodLength = !!mdsModFH.topRodLength$!hangerNo' + '.val'
    $!action
    !otherMaxHeight = !!mdsModFH.maxBottomRodLength[!hangerNo]
    !otherMinHeight = !!mdsModFH.minBottomRodLength[!hangerNo]
  elseif(!rodID eq 'BOTTOM') then
    !rod = !rods[1].dbref()
    !other = !rods[2].dbref()
    !otherGadget = !!mdsModFH.topRodLength$!hangerNo
    -- set the new rod length variable
    !gadget = !!mdsModFH.bottomRodLength$!hangerNo
    !action = '!newCeRodLength = !!mdsModFH.bottomRodLength$!hangerNo' + '.val'
    $!action
    !otherMaxHeight = !!mdsModFH.maxTopRodLength[!hangerNo]
    !otherMinHeight = !!mdsModFH.minTopRodLength[!hangerNo]
  else
    !!kRestoreUnits(!currentunits)
    return
  endif
  !!ce = !rod
  -- Setting new length to the required rod
  !ceOrder = order
  -- remember the old rod length
  !oldCeRodLength = heigh + despar[1] + despar[2]
  handle (2,752)
    !oldCeRodLength = heigh + despar[1]
  endhandle

  -- find the difference
  !diff = !newCeRodLength - !oldCeRodLength
  -- Adjusting the length of the other rod to keep the total hanger length constant
  !!ce = !other
  !otherOrder = order
  -- remember the othe rod length original
  !oldOtherRodLength = heigh + !!ce.despar[1] + !!ce.despar[2]
  handle (2,752)
    !oldOtherRodLength = heigh + despar[1]
  endhandle

  -- work out the new other rod length is within limits
  !otherHeigh = !oldOtherRodLength - !diff
  -- work out if the new length
  if(!otherHeigh lt !otherMinHeight) then
    !otherHeigh = !otherMinHeight
    !newCeRodLength = !oldCeRodLength + !oldOtherRodLength - !otherMinHeight
    !outlen = !newCeRodLength.string(!!distanceFmt)
    !!alert.message('Setting value to Maximum possible: $!outlen')
  elseif(!otherHeigh gt !otherMaxHeight) then
    !otherHeigh = !otherMaxHeight
    !newCeRodLength = !oldCeRodLength + !oldOtherRodLength - !otherMaxHeight
    !outlen = !newCeRodLength.string(!!distanceFmt)
    !!alert.message('Setting value to Minimum possible: $!outlen')
  endif
  !!ce = !rod
  !newheight = !newCeRodLength - (!!ce.despar[1] + !!ce.despar[2])
  handle (2,752)
    !newheight = !newCeRodLength - !!ce.despar[1]
  endhandle
  heigh $!newheight

  !!ce = !other
  !otherheight = !otherHeigh  - (!!ce.despar[1] + !!ce.despar[2])
  handle (2,752)
    !otherheight = !otherHeigh  - !!ce.despar[1]
  endhandle

  heigh $!otherheight

  -- Reconnect hanger members starting from the lower member index
  !!mdsModFH.reconnectHanger(!!ce.owner, min(!ceOrder, !otherOrder))
  !otherGadget.val = !otherHeigh
  !gadget.val = !newCeRodLength
  !gadget.setfocus()
  !!ce = !ce

  -- Show dimensions on graphics if required
  !!kRestoreUnits(!currentunits)
  if !!mdsFH01.graphicalDim then
    !!mdsshowdim(!!mdsFH01)
  endif

endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .reconnectHanger(!hangerRef is DBREF, !startIndex is REAL)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  !!ce = !hangerRef
  do !i from !startIndex
    $!i
    handle any
      break
    endhandle
    !ori = ori
    fconn
    ori $!ori
    hang
  enddo
  !!ce = !ce
  !!kRestoreUnits(!currentunits)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .setEqualRodLength(!hangerNo is REAL)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !rods = !!mdsModFH.restRods[!hangerNo]
  if(!rods.size() eq 1 or !!mdsModFH.fixedTopRod[!hangerNo]) then
    !!kRestoreUnits(!currentunits)
    return
  endif
  !ce = !!ce
  !bottomRod = !rods[1]
  !topRod = !rods[2]
  -- !totalRodLength = Heigh of $!bottomRod + Heigh of $!topRod
  !totalRodLength = REAL(prop olen of $!bottomRod) + real(prop olen of $!topRod)

  --
  -- Check if new length will be in allowable length limits
  -- Bottom rod
  !minLength = :MDSMinHeight of catref of $!bottomRod
  !maxLength = :MDSMaxHeight of catref of $!bottomRod
  !newLength = (!totalRodLength / 2)
  if(!newLength lt !minLength) then
    !!alert.error('Required length for bottom rod $!newLength is less the minimum allowed $!minLength')
    return
  endif
  if(!newLength gt !maxLength) then
    !!alert.error('Required length for bottom rod $!newLength is more the maximum allowed $!maxLength')
    return
  endif
  -- Top rod
  !minLength = :MDSMinHeight of catref of $!topRod
  !maxLength = :MDSMaxHeight of catref of $!topRod
  !newLength = (!totalRodLength / 2)
  if(!newLength lt !minLength) then
    !!alert.error('Required length for top rod $!newLength is less the minimum allowed $!minLength')
    return
  endif
  if(!newLength gt !maxLength) then
    !!alert.error('Required length for top rod $!newLength is more the maximum allowed $!maxLength')
    return
  endif
  !rods[1].dbref().heigh = (!newLength - (!rods[1].dbref().despar[1] + !rods[1].dbref().despar[2]))
  handle (2,752)
    !rods[1].dbref().heigh = (!newLength - !rods[1].dbref().despar[1])
  endhandle
  !rods[2].dbref().heigh = (!newLength - (!rods[2].dbref().despar[1] + !rods[2].dbref().despar[2]))
  handle (2,752)
    !rods[2].dbref().heigh = (!newLength - !rods[2].dbref().despar[1])
  endhandle
  -- Reconnect hanger members starting from the lower member index
  !!mdsModFH.reconnectHanger(!rods[2].dbref().owner, min(!rods[1].dbref().order, !rods[2].dbref().order))
  !action = '!!mdsModFH.bottomRodLength$!hangerNo' + '.val = !rods[1].dbref().heigh'
  $!action
  !action = '!!mdsModFH.topRodLength$!hangerNo' + '.val = !rods[2].dbref().heigh'
  $!action
  !!ce = !ce
  -- go and set the gadgets back again
  !!mdsModFH.setRodsLimits()
  -- Show dimensions on graphics if required

  if !!mdsFH01.graphicalDim then
    !!mdsshowdim(!!mdsFH01)
  endif
  !!kRestoreUnits(!currentunits)

endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .changeType(!basicChange is BOOLEAN)
  -- Changes type of hanger within a given general type (Fixed Hanger/Variable Hanger) and vice versa.
  -- e.g from FH01 to FH12 or from VH01 to VH04
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIN(1, '$!!mdsModFH' + '.changeType($!basicChange is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !styp = !!mdsFH01.support.rest.styp

  -- Defining the selection form for the hanger types (!!mdsFHanger)
  if(!styp.match('FH') gt 0) then
    -- Current type is Fixed Hanger
    if(!basicChange) then
      -- Show the Variable Hanger selection form
      !!mdsFHanger.sitecheck('VH')
    else
      -- Show the Fixed Hanger selection form
      !!mdsFHanger.sitecheck('FH')
    endif
  elseif(!styp.match('VH') gt 0) then
    -- Current type is Fixed Hanger
    if(!basicChange) then
      -- Show the Fixed Hanger selection form
      !!mdsFHanger.sitecheck('FH')
    else
      -- Show the Variable Hanger selection form
      !!mdsFHanger.sitecheck('VH')
    endif
  endif


  !formString = '!!' & 'MdsFHanger'
  !form = $!formString
  -- Fill in the support/datum name rather than having to use the autonaming feature since its an existing support
  -- that we want to modify
  -- since we replace the manual or autonaming feature, we need to call the name gadget callback function explicitly.
  -- call the name gadget callback function of the hanger type selection form  (!!mdsFHanger)
  call !!mdsSupportForm(!form)
  call !!mdsSetSupp(!form)
  -- set the tubref of the form so the activate filter will not prompt the user to identify
  -- a pipe.
  !form.tubeRef = !!mdsModFH.atta

  !oHangerType = !!mdsAllHangerTypes.gethangertype(!!mdsFH01.support.rest.styp)

  !rest = !!mdsFH01.support.rest.ref
  !oRest = object MDSREST(!rest, false)
  -- Retrieve the hangers beams
  !beamRefArr = !oRest.getBeamRefArray()

  !form.beamRef = !beamRefArr

  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(1, 'Activate the filter for the current hanger styp $!!mdsFH01.support.rest.styp group $!oHangerType.group')
  endif
  !form.activateFilter(!oHangerType.group, false, false)
  -- Highlight the current configuration
  !!mdsFHanger.standard.select('RTEXT',!styp)
  handle any
  endhandle

  !function = '!!' & 'MdsMODFH.changeTypeApplied(' & !formString & ')'
  -- override the support function (.suppFunction) set by !!mdsSetSupp to allow 'MODIFY' mode rather than 'CREATE' mode
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(1, 'Set OK callback function to $!function')
  endif
  -- saves the Mdsfhanger form ok callback function
  !!mdsModFH.okCallback = !form.ok.callback
  !form.ok.callback = !function
  !form.name.val = !!mdsModFH.atta.name.after('/')
  -- Disable support name modification
  !form.name.active = false
  !form.ok.active = true
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!!mdsModFH' + '.changeType($!basicChange is BOOLEAN)')
  endif


endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .changeTypeApplied(!form is FORM)


  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIN(1, '$!!mdsModFH.changeTypeApplied($!form is FORM)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !!mdsDacControl(true)

  !beamRefArray = !!mdsFHanger.beamRef
  !tubeRef = !!mdsFHanger.tubeRef
  -- !form is the hanger type selection form
  !form.oldFunction = ||
  !form.hide()
  !suppType = !form.standard.selection('Rtext')
  !alias = !!mdsAliasList(!suppType)
  !!mdsModFH.atta.:MDSSuppType = |$!suppType|
  -- setup the initialization function for the support form (e.g. !!mdsIFH01)
  !function = '!!' & 'MdsI' & !alias
  -- setup the support form (e.g. !!mdsFH01)
  !formName = '!!' & 'Mds' & !alias
  !initFormFunction = !function & '(''MODIFY'', ''$!form.name.val'',''$!suppType'')'
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(2, |Calling $!initFormFunction|)
  endif

  $!initFormFunction
  -- update the beam and tube references to the new selected one
  -- setup the OK button callback function for the hanger type selection form - (!!mdsFHanger)
  !changeTypeFunction = '$!formName' + '.support.rest.modify(' + '$!formName' + ', !!mdsFHanger)'
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(2, |Calling $!changeTypeFunction|)
  endif
  !!mdsFH01.support.rest.beamRefArray = !beamRefArray
  !!mdsFH01.support.rest.tubeRef = !tubeRef

  $!changeTypeFunction
  handle 99
    -- restore the Mdsfhanger form ok callback function to the old (default) value
    !form.ok.callback = !!mdsModFH.okCallback
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsFH01.restoreHanger(false, false)
    !!kRestoreUnits(!currentunits)
    return
  elsehandle any
    -- restore the Mdsfhanger form ok callback function to the old (default) value
    !form.ok.callback = !!mdsModFH.okCallback
    -- delete the hanger and all associated elements including atta
    -- Don't issue a confirm prompt
    !!alert.message(!!error.text)
    !!mdsFH01.restoreHanger(false, false)
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  -- restore the Mdsfhanger form ok callback function to the old (default) value
  !form.ok.callback = !!mdsModFH.okCallback
  !!mdsModFH.unTagHangers()
  -- Show dimensions on graphics if required

  if !!mdsFH01.graphicalDim then
    !!mdsshowdim(!!mdsFH01)
  endif

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!!mdsModFH.changeTypeApplied($!form is FORM)')
  endif

endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
-- method simply checks the passed input length against the stored values
define method .validateRodLength(!hangerNo is REAL, !inputLength is REAL, !rodPos is STRING)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !inputLengthConv = !inputLength
  !rods = !!mdsModFH.restRods[!hangerNo]
  if(!rodPos.upcase().eq('TOP')) then
    !maxHeight = !!mdsModFH.maxTopRodLength[!hangerNo]
    !minHeight = !!mdsModFH.minTopRodLength[!hangerNo]
  else
    !maxHeight = !!mdsModFH.maxBottomRodLength[!hangerNo]
    !minHeight = !!mdsModFH.minBottomRodLength[!hangerNo]
  endif
  if((!inputLengthConv lt !minHeight) or (!inputLengthConv gt !maxHeight)) then
    !!alert.error('Length ' + !inputLengthConv.string(!!distanceFmt) + ' is not in the allowed range of ' + !minHeight.string(!!distanceFmt) + ' to ' + !maxHeight.string(!!distanceFmt))
    !action = '!!mdsModFH.bottomRodLength$!hangerNo' + '.val = heigh of $!rods[1]'
    $!action
    !action = '!!mdsModFH.topRodLength$!hangerNo' + '.val = 0'
    $!action
    if(!rods.size() eq 2) then
      !action = '!!mdsModFH.topRodLength$!hangerNo' + '.val = heigh of $!rods[2]'
      $!action
    endif
  endif
  !!kRestoreUnits(!currentunits)
  return
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .modifySpringType(!hangerNo is REAL, !useChoose is BOOLEAN)

  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIN(1, '$!!mdsModFH' + '.modifySpringType($!hangerNo is REAL)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- Allows the user to select a new spring using the choice feature
  -- Checks if size of spring can fit into hanger.
  -- If spring size is OK, adjust the rods length accordingly.
  -- The difference in the spring size is compensated by adding/subtracting half of it in each rod.
  -- If the top rod is a fixed length rod then the whole difference of the spring size is added/subtracted to/from the bottom rod

  !ce = !!ce

  !rods = !!mdsModFH.restRods[!hangerNo]


  -- Going to the hanger level
  !support = !!mdsFH01.support
  !oRest = !support.rest
  --!hangertypes = object MDSHANGERTYPES()

  if(!oRest.hangers.size() eq 1 or !oRest.styp inset$!!mdsAllHangerTypes.dSSpring) then
    -- Only one hanger or a double hanger with one double spring
    if(!hangerNo gt 1) then
      !!alert.error('Hangers has only one spring. Invalid hanger no. $!hangerNo')
      golabel /exit
    endif
    !hangerIndex = 1
    !!ce = !oRest.hangers[!hangerIndex].ref
  elseif (!oRest.hangers.size() eq 2 and !!mdsAllHangerTypes.m5Constant.findfirst(!oRest.styp).set() ) then
    -- Constant hanger c50 type k
    !hangerIndex = 1
    !!ce = !oRest.hangers[!hangerIndex].ref
  else
    -- Double hangers
    -- Index of first hanger in db starts from 2
    !hangerIndex = !hangerNo + 1

    !!ce = !oRest.hangers[!hangerIndex].ref
  endif
  !hangRef = !!ce
  !fittRef = tref
  -- goto the spring
  VSPR 1
  !spring = !!ce
  -- Saves the spref in case spring can not be fitted
  !oldSpref = spref
  -- Set the current spring length
  !operand = 1
  !springOnTopOfBeam = false
  if(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.tASpring or $
    !!mdsFH01.support.alias inset$!!mdsAllHangerTypes.eSSpring) then
    -- Spring is on top of beam. HT of hanger moves up and rod needs to be longer
    -- by the difference in spring length
    !springOnTopOfBeam = true
    !operand = -1
    !!mdspushpin(1)
    !!mdspushpin(2)
    pin1 at ce
    pin1 dir u
    pin1 clea 0 infr ce
    pin2 copy pin1
    pin2 clea 0 behi ce
    var !oldSpringlength const dist pin1 to pin2
    !!mdspoppin(1)
    !!mdspoppin(2)
  elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.tS2Spring) then

    var !oldSpringlength const dist pa to pl of next bwld
    handle (2,113)
      -- dtf >>> 21-07-04 handle because next is a slug for PIHASA
      var !oldSpringlength const dist pa to pl of next slug
    endhandle
    --- dtf <<<
  else
    var !oldSpringlength const dist pa to pl
  endif
  -- grinnel !choice = :MDSChoice
  !styp = styp
  -- apply the choice command stored in :MDSChoice
  if(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.dSSpring) then
    -- Pa bore of the spring is equal to the pipe bore and can have various values
    -- The choose command selects the list using the bore of the hanger.
    -- we temporarily set the hbor to be equal to the pl bore (rod size) of the spring.
    -- This will enable us to choose the springs having the same rod sizes
    -- Save the hbore
    !hangBore = !!ce.owner.hbor
    -- Change it to be equal to the arrive leave bore of the spring
    --DTF RETURNS VALUE OF 10 WHEN ROD SIZE IS 12
    -- SO I CHANGED IT
    --!!ce.owner.hbor = p2 bore
    --!lbore = p2 bore
    var !lbore  Lbore
    END
    HBOR $!lbore
    SAM

    --var !mdsChoice :MDSCHOICE
    -- display the list
    -- grinnel $!choice
    if(!useChoose) then
      !curSpref = spref
      !arrive = arri
      !leave = leav
      -- save current span for Double springs with a channel (B13, B14)
      !span = prop span
      handle any
        -- spring does not have this property
      endhandle
      !!mdsDacControl(true)
      choose with styp |$!styp|
      handle (41,52)
      elsehandle any
        !!alert.message('Unable to choose other spring types for size: $!lbore')
        -- Restore the hbor value
        arrive $!arrive
        leav $!leave
        !!ce.owner.hbor = !hangBore
        conn and p2 is U
        handle any
          -- Grinnel springs
          Fconn
        endhandle
        golabel /exit
      endhandle
      arrive $!arrive
      leav $!leave
      !!ce.owner.hbor = !hangBore
      !span = prop span
      !!ce.owner.hbor = !hangBore
      -- Check to see if the current span is not more than the maximum span allowed for the new spring type.
      !maxSpan = prop mxsp
      handle any
        -- spring does not have this property
      elsehandle none
        if(defined(!span)) then
          !minRequiredSpan = !!mdsFH01.support.rest.getMinRequiredSpan()
          if(!minRequiredSpan gt !maxSpan.real()) then
            !!alert.message('Minimum required span ' + !minRequiredSpan.string(!!distanceFmt) + ' is larger than the maximum available ' + !maxSpan.string(!!distanceFmt))
            !!ce.spref = !curSpref
            golabel /exit
          endif

          if(!span.real() gt !maxSpan.real()) then
            !!alert.message('Current channel span ' + !span.string(!!distanceFmt) + ' is larger than the maximum ' + !maxSpan.string(!!distanceFmt) + '. Please change span first')
            !!ce.spref = !curSpref
            golabel /exit
          endif

        endif
      endhandle
    endif
    -- Restore the hbor value
    !!ce.owner.hbor = !hangBore
    conn and p2 is U
    handle any
      -- Grinnel springs
      fconn
    endhandle

    -- dtf >>> Rods are different length for PIHASA
    if ( Hspec of hang neq /PIHASA ) then
      -- Rods lengths are not affected
      golabel /exit
    else
      !orice = !!ce
      end
      pos ht at pl of last mem
      hang 2 of rest
      pos hh at p10 of vspr 1 of hang 1
      hang 3 of rest
      pos hh at p2 of vspr 1 of  hang 1
      !!ce = !orice
    endif
    -- dtf <<< end of mod
  elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.bM1Spring or $
    !!mdsFH01.support.alias inset$!!mdsAllHangerTypes.doubleBM1Spring) then
    -- Pa bore of the spring is equal to the pipe bore and can have various values
    -- The choose command selects the list using the bore of the hanger.
    -- we temporarily set the hbor to be equal to the pl bore (rod size) of the spring.
    -- This will enable us to choose the springs having the same rod sizes
    -- Save the hbore
    !hangBore = !!ce.owner.hbor
    -- Change it to be equal to the arrive leave bore of the spring
    !arrive = arrive
    !leave = leave
    arrive 1
    leave 2
    -- dtf >>> 19-07-04 when reselecting different hanger configuration we need to know
    -- the new bore size this also works for the current configuration
    var !vcoll coll all vspr for /MDS/$!!mdsFH01.support.alias
    !!ce.owner.hbor = (pa bore of $!vcoll[1])
    handle ANY
      -- temp fix richard martin 21/04/06
      !!ce.owner.hbor = (pL bore of $!vcoll[1])
    endhandle
    -- dtf <<<
    --!!ce.owner.hbor = pa bore
    var !p3Dir p3 dir

    -- display the list
    -- grinnel $!choice
    if(!useChoose) then
      !!mdsDacControl(TRUE)
      choose with styp |$!styp|
      handle ANY
        !hspec = hspec of hang
        if !hspec.name.eq('/PSL') then
          hang
          hspec /MDS-PSL
          same
          choose with styp |$!styp|
          handle ANY
            !!alert.message('No other spring types')
            arrive $!arrive
            leav $!leave
            !!ce.owner.hbor = !hangBore
            golabel /exit
          endhandle
        elseif !hspec.name.eq('/MDS-PSL') then
          hang
          hspec /PSL
          same
          choose with styp |$!styp|
          handle ANY
            !!alert.message('No other spring types')
            arrive $!arrive
            leav $!leave
            !!ce.owner.hbor = !hangBore
            golabel /exit
          endhandle
        elseif !hspec.name.eq('/PIHASA') then
          hang
          hspec /PIHASA
          same
          VAR !ttype TANS OF OWNER OF SPREF
          choose with styp |$!styp| ttype $!ttype
          handle (41,52)
          elsehandle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        else
          !!alert.message('No other spring types')
          arrive $!arrive
          leav $!leave
          !!ce.owner.hbor = !hangBore
          golabel /exit
        endif
      endhandle
    endif
    -- Restore the hbor value
    if(!hangBore.set()) then
      !!ce.owner.hbor = !hangBore
    else
      !ceVSPR = !!ce
      -- go to hanger
      !!ce = !!ce.owner
      hbor 0
      -- back to vspr
      !!ce = !ceVSPR
    endif
    arrive $!arrive
    leave $!leave
    conn and p3 is $!p3Dir
    handle any
      conn
      handle ANY

        -- dtf>>> 14.07.04  Pa of VSPR not always the same as pipe bore
        !temphangbore = pa bore
        !!ce.owner.hbor = !temphangbore
        conn
        if(!hangBore.set()) then
          !!ce.owner.hbor = !hangBore
        else
          !ceVSPR = !!ce
          -- go to hanger
          !!ce = !!ce.owner
          hbor 0
          -- back to vspr
          !!ce = !ceVSPR
        endif
      endhandle
      -- dtf <<<
    endhandle

    -- Rods lengths are not affected
    golabel /exit
  elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.tS2Spring) then
    -- The pin size for the spring may have changed.
    -- we need to reselect the beam attachment
    var !p3newDir p3 dir
    if(!useChoose) then
      !!mdsDacControl(TRUE)
      choose with styp |$!styp|
      handle ANY
        !hspec = hspec of hang
        if !hspec.name.eq('/PSL') then
          hang
          hspec /MDS-PSL
          same
          choose with styp |$!styp|
          handle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        elseif !hspec.name.eq('/MDS-PSL') then
          hang
          hspec /PSL
          same
          choose with styp |$!styp|
          handle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        elseif !hspec.name.eq('/PIHASA') then
          hang
          hspec /PIHASA
          same
          VAR !ttype TANS OF OWNER OF SPREF
          choose with styp |$!styp| ttype $!ttype
          handle (41,52)
          elsehandle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        else
          !!alert.message('No other spring types')
          golabel /exit
        endif
      endhandle
    endif
    -- The pin size for the spring may have changed.
    -- we need to reselect the beam attachment
    !ceVSPR = !!ce
    next bwld
    handle (2,113)
      -- dtf >>> 21-07-04 handle because next is a slug for PIHASA
      next slug
    endhandle
    -- dtf <<<

    !elem = object MDSHANGMEM()
    -- Gets the leave bore of the spring
    !vsprLBore = pl bore of prev
    var !nextp3newDir p3 dir
    !!ce.spref = !elem.reselectBore(!vsprLBore.real())
    handle any
      if(!!alert.confirm('There is no matching beam attachment for that spring size. Do you want to continue with the new spring size?') eq 'YES') then
      else
        !ceVSPR.spref = !oldSpref
        golabel /exit
      endif
    endhandle
    --fconn
    conn and p3 is $!nextp3newDir

    !!ce = !ceVSPR
$(    -- The pin size for the spring may have changed.
    -- we need to reselect the beam attachment
    !ceVSPR = !!ce
    next bwld
    !elem = object MDSHANGMEM()
    -- Gets the leave bore of the spring
    !vsprLBore = pl bore of prev

    !!ce.spref = !elem.reselectBore(!vsprLBore.real())
    handle any
      if(!!alert.confirm('There is no matching beam attachment for that spring size. Do you want to continue with the new spring size?') eq 'YES') then
      else
        !ceVSPR.spref = !oldSpref
        golabel /exit
      endif
    endhandle
    fconn
    !!ce = !ceVSPR
$)
  elseif (!!mdsAllHangerTypes.m5Constant.findfirst(!!mdsFH01.support.alias).set()  ) then
    var !p3newDir  ppline na y dir of sctn of tref of hang
    if(!useChoose) then
      !!mdsDacControl(TRUE)
      --var !p3Dir  dir p3
      var !p3newDir  ppline na y dir of sctn of tref of hang
      VAR !ttype TANS OF OWNER OF SPREF
      choose with styp |$!styp| ttype |$!ttype|
      handle ANY
        !hspec = hspec of hang
        if !hspec.name.eq('/PIHASA') then
          hang
          hspec /PIHASA
          same
          VAR !ttype TANS OF OWNER OF SPREF
          choose with styp |$!styp| ttype |$!ttype|
          handle (41,52)
          elsehandle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        else
          !!alert.message('No other spring types')
          golabel /exit
        endif
      endhandle

    endif
    --fconn
    conn and p3 is $!p3newDir

  else
    -- grinnel $!choice
    if(!useChoose) then
      !!mdsDacControl(TRUE)
      !hspec = hspec of hang
      if !hspec.name.neq('/PIHASA') then
        choose with styp |$!styp|
        handle ANY
          !hspec = hspec of hang
          if !hspec.name.eq('/PSL') then
            hang
            hspec /MDS-PSL
            same
            choose with styp |$!styp|
            handle ANY
              !!alert.message('No other spring types')
              golabel /exit
            endhandle
          elseif !hspec.name.eq('/MDS-PSL') then
            hang
            hspec /PSL
            same
            choose with styp |$!styp|
            handle ANY
              !!alert.message('No other spring types')
              golabel /exit
            endhandle

          else
            !!alert.message('No other spring types')
            golabel /exit
          endif
        endhandle
      elseif !hspec.name.eq('/PIHASA') then
        !choice = :MDSChoice
        $!choice
        handle (47,15)
          -- syntax error
          !vsprname = !!ce.name
          !!alert.message('Check :MDSChoice of the VSPR $!vsprname in the template')
          golabel /exit

        elsehandle any
          hang
          hspec /PIHASA
          same
          VAR !ttype TANS OF OWNER OF SPREF
          choose with styp |$!styp| ttype |$!ttype|
          handle (41,52)
          elsehandle ANY
            !!alert.message('No other spring types')
            golabel /exit
          endhandle
        endhandle
      endif
    endif

  endif

  -- dtf 3-08-04
  --for constants set up design parameters for the selection
  !vsprDkey = prop TRAV
  handle (2,207)
    -- prop not available for this type
    !vTravel = FALSE
  elsehandle NONE
    !vTravel = TRUE
  endhandle

  --if (!!mdsAllHangerTypes.m5Constant.findfirst(!!mdsFH01.support.alias).set()  ) then
  if (!vTravel eq TRUE ) then

    -- dtf End of mod
    var !p3newDir  dir p3
    !olddesp  = (desp num 1)
    !travel = !olddesp[1]
    -- find !travel with new selection otherwise choose first value
    !values = ARRAY()
    !flag = (0)
    !minHeight = !!ce.cATREF.:MDSMinHeight
    !travelval = !minHeight
    do !loop from 1 to 3
      !mdsCP$!loop = !!ce.cATREF.:MDSCp$!loop
      !temp = !mdsCP$N$!loop
      !split = !temp.split(',')
      do !ind ind !split
        if !split[$!ind] neq 'unset' then
          if (!travel eq !travelval ) then
            !desp = '$!travelval$N $!split[$!ind]'
            !flag = (1)
            break
          elseif(!travelval eq !minHeight ) then
            !desp = '$!travelval$N $!split[$!ind]'
          endif
          !values.append('$!travelval $!split[$!ind]')
          !travelval = ($!travelval + 10)
        endif
      enddo
      if !flag eq 1 then
        break
      endif

    enddo
    DESP $!desp
    conn and p3 is $!p3newDir
    if (!!mdsAllHangerTypes.m5Constant.findfirst(!!mdsFH01.support.alias).set()  ) then
      -- Now we need to realign the fittings and Hanger 2

      -- this will hopefully reconnect the hanger 2 to the changed constant size
      -- for m5constant
      !oriref = !!ce
      nex
      conn
      nex hang
      conn hh to p10 of vspr1 of prev hang
      !hangMem = !!ce.ref.mem
      do !i indices !hangMem
        $!hangMem[$!i]
        if !!ce.type eq 'HROD' then
          -- reset HROD height same as HROD 2 in HANG 1
          !height = (height of HROD 2 of prev HANG)
          height $!height
          var !desp desp of HROD 2 of prev HANG
          desp $!desp
        endif
        !ori = ori wrt /*
        fconn
        !pos = pos wrt /*
        if ($!i neq 1 ) then
          ori $!ori
        endif
        at $!pos
      enddo
      !!ce = $!oriref
    endif
  endif

  -- Preferred solution but does not work since hanger heigh is calculated relatively to the
  -- template's hanger height. Need to update the resize method to allow the use of the current hanger height as a base for
  -- resizing the hanger
  --!!mdsFH01.resizeHanger('MODIFY', !hangRef, !fittRef)

  -- Set the new spring length
  if(!springOnTopOfBeam) then
    -- Spring is on top of beam. HT of hanger moves up and rod needs to be longer
    -- by the difference in spring length
    !operand = -1
    !!mdspushpin(1)
    !!mdspushpin(2)
    pin1 at ce
    pin1 dir u
    pin1 clea 0 infr ce
    pin2 copy pin1
    pin2 clea 0 behi ce
    var !newSpringlength const dist pin1 to pin2
    !!mdspoppin(1)
    !!mdspoppin(2)
  elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.tS2Spring) then
    var !newSpringlength const dist pa to pl of next bwld
    handle (2,113)
      -- dtf >>> 21-07-04 handle because next is a slug for PIHASA
      var !newSpringlength const dist pa to pl of next slug
    endhandle
    -- dtf <<<
    -- dtf >>> mod for PIHASA dsspring because pl moves for each size
  elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.dSSpring) then
    !decref = !!ce
    var !diff  const dist pl to pa of hnut 1 of hang 3
    var !ldir  const dir  pl to pa of hnut 1 of hang 3
    if (!ldir eq 'U' or !ldir eq 'Z') then
      !calc  = |+|
    else
      !calc = |-|
    endif
    do !i from 2 to 3
      hang $!i
      hnut 1
      conn
      nex
      !heigh = heigh
      heigh  ($!heigh $!calc $!diff)
      conn
    enddo
    !!ce = !decref

    golabel /exit
    -- dtf <<< end of mod
  else
    var !newSpringlength const dist pa to pl
  endif
  -- difference in spring current length and new length
  !diff = !newSpringlength.real() - !oldSpringlength.real()
  !startHangIndex = 1
  !endHangIndex = 1
  -- if(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.riserClamp) then
  if !!mdsAllHangerTypes.riserClamp.find(!!mdsFH01.support.alias).size().gt(0) then
    !startHangIndex = 2
    !endHangIndex = 3
  elseif (!!mdsAllHangerTypes.m5Constant.find(!!mdsFH01.support.alias).size().gt(0)) then
    !startHangIndex = 1
    !endHangIndex = 2
  endif

  --  do !hangIndex from !startHangIndex to !endHangIndex
  -- Loop on hangers
  --      !rods = !!mdsModFH.restRods[!hangIndex]
  !rods = !!mdsModFH.restRods[!hangerNo]
  if(!rods.size() eq 0) then
    -- no rods in this hanger
    return
  endif
  -- Calculate the total span available from the top of the top rod to the bottom of the bottom rod
  -- The maximum spring length allowed will be the total span less the sum of the minimum rods lengths.
  -- The minimum spring length allowed will be the total span less the sum of the maximum rods lengths.

  -- current bottom rod length
  !botRodLength = !rods[1].dbref().heigh

  -- current top rod length
  -- Check if top rod is a fixed length rod
  !mintoplength = 0
  !maxTopLength = 0
  !topRodLength  = 0
  if(!rods.size() eq 2) then
    if(!!mdsModFH.fixedTopRod[!hangerNo]) then
      -- top rod is a fixed length rod
      !rods[2] = !rods[2].before('_FIXEDLENGTH')
      var !topRodLengthStr const dist pa of $!rods[2] to pl of $!rods[2]
      !topRodLength = !topRodLengthStr.real()
      !maxTopLength = !topRodLength
      !mintoplength = !topRodLength
    else
      !topRodLength = !rods[2].dbref().heigh
      !maxTopLength = :MDSMaxHeight of catref of $!rods[2]
      !mintoplength = :MDSMinHeight of catref of $!rods[2]
    endif
  endif
  !minBotLength = :MDSMinHeight of catref of $!rods[1]
  !maxBotLength = :MDSMaxHeight of catref of $!rods[1]

  if(not !springOnTopOfBeam) then
    --if(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionFixed or $
    --   !!mdsFH01.support.alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionVariable) then
    if( !!mdsAllHangerTypes.doubleChannelRodConnectionFixed.find(!!mdsFH01.support.alias).size().gt(0) or $
      !!mdsAllHangerTypes.doubleChannelRodConnectionVariable.find(!!mdsFH01.support.alias).size().gt(0) ) then
      -- top rod is connected to the top of the beam
      -- minimum top rod length is the maximum between the beam height and the actual allowed minimum rod length
      !beamRef = !fittRef.owner
      !beamHeigh = !!mdsFH01.getBeamHeight(!beamRef)
      !minBotLength = !beamHeigh.max(!minBotLength)
    endif

    !totalSpan = !botRodLength + !topRodLength + !oldSpringlength.real()
    !minSpringAllowed = !totalSpan - (!maxBotLength + !maxTopLength)
    !maxSpringAllowed = !totalSpan - (!minBotLength + !mintoplength)
    if(!newSpringlength.real() lt !minSpringAllowed) then
      !!alert.message('Spring is too small to fit in this hanger')
      !!ce = !spring
      spref $!oldSpref
      golabel /exit
    endif
    if(!newSpringlength.real() gt !maxSpringAllowed) then
      !!alert.message('Spring is too large to fit in this hanger')
      !!ce = !spring
      spref $!oldSpref
      golabel /exit
    endif
  else
    !totalSpan = !botRodLength + !topRodLength
    !maxSpanAllowed = !maxBotLength + !maxTopLength
    !minSpanAllowed = !minBotLength + !mintoplength
    !newTotalSpan = !totalSpan  + !diff
    if(!newTotalSpan lt !minSpanAllowed) then
      !!alert.message('Spring is too small to fit in this hanger')
      !!ce = !spring
      spref $!oldSpref
      golabel /exit
    endif
    if(!newTotalSpan gt !maxSpanAllowed) then
      !!alert.message('Spring is too large to fit in this hanger')
      !!ce = !spring
      spref $!oldSpref
      golabel /exit
    endif
  endif
  if(!!mdsModFH.fixedTopRod[!hangerNo]) then
    -- Top rod has a fixed length
    -- change only bottom rod length with the full spring height difference
    !!ce = !rods[1].dbref()
    !newBotRodLength = !botRodLength - (!operand * !diff)
    heig $!newBotRodLength
    !action = '!!mdsModFH.bottomRodLength$!hangerNo' + '.val = !newBotRodLength '
    $!action
  else
    -- Top rod has a variable length
    -- change length of bottom & top rods
    !!ce = !rods[2].dbref()
    !newTopRodLength = !topRodLength - (!operand * !diff / 2)
    heig $!newTopRodLength
    !action = '!!mdsModFH.topRodLength$!hangerNo' + '.val = !newTopRodLength'
    $!action
    !!ce = !rods[1].dbref()
    !newBotRodLength = !botRodLength - (!operand * !diff / 2)
    heig $!newBotRodLength
    !action = '!!mdsModFH.bottomRodLength$!hangerNo' + '.val = !newBotRodLength'
    $!action

  endif
  fconn
  do
    next
    handle any
      hang
      pos pt at pl of last mem
      break
    endhandle
    !ori = ori wrt /*
    fconn
    !pos = pos wrt /*
    ori $!ori
    at $!pos
  enddo

  --dtf
  -- this will hopefully reconnect the hanger 2 to the changed constant size
  -- for m5constant
  if (!!mdsAllHangerTypes.m5Constant.findfirst(!!mdsFH01.support.alias).set()  ) then
    !hnum = !!ce.name.substring(-1,1).real()
    if !hnum eq 2 then
      !oriref = !!ce

      conn hh to p10 of vspr1 of prev hang

      !hangMem = !!ce.ref.mem
      do !i values !hangMem
        $!i
        if !!ce.type eq 'HROD' then
          -- reset HROD height same as HROD 2 in HANG 1
          !height = (height of HROD 2 of prev HANG)
          height $!height
          var !desp desp of HROD 2 of prev HANG
          desp $!desp
        endif
        !ori = ori wrt /*
        fconn
        !pos = pos wrt /*
        ori $!ori
        at $!pos
      enddo
      !!ce = $!oriref
    elseif !hnum eq 1 then
      -- rest tref fitt to align with new pos of ht
      var !opin9pos pin 9 pos
      var !opin9dir pin 9 dir
      var !tpos tpos
      pin9 at $!tpos
      var !pin9dir ppline na y dir of sctn of tref
      pin 9 dir $!pin9dir
      !steelRef = !!ce.tref.owner
      var !distToBeamStart const dist  pplin na of $!steelRef start to plane pin9
      goto tref
      zdist $!distToBeamStart
      sam
      pin 9 at $!opin9pos
      pin 9 dir $!opin9dir

      -- double check Height of HROD 2 same as HROD 1 of next hang since it
      -- may have changed if the spring type changed

      !oriref = !!ce
      next hang
      conn hh to p10 of vspr1 of prev hang

      !hangMem = !!ce.ref.mem
      do !i values !hangMem
        $!i
        if !!ce.type eq 'HROD' then
          -- reset HROD height same as HROD 2 in HANG 1
          !height = (height of HROD 2 of prev HANG)
          height $!height
          var !desp desp of HROD 2 of prev HANG
          desp $!desp
        endif
        !ori = ori wrt /*
        fconn
        !pos = pos wrt /*
        ori $!ori
        at $!pos
      enddo
      end
      pos ht at pl of last mem

      -- Now re align fitting on hanger tail
      var !opin9pos pin 9 pos
      var !opin9dir pin 9 dir
      var !tpos tpos
      pin9 at $!tpos
      var !pin9dir ppline na y dir of sctn of tref
      handle ANY
      elsehandle NONE
        pin 9 dir $!pin9dir
        !steelRef = !!ce.tref.owner
        var !distToBeamStart const dist  pplin na of $!steelRef start to plane pin9
        goto tref
        zdist $!distToBeamStart
        sam
        pin 9 at $!opin9pos
        pin 9 dir $!opin9dir

        !!ce = $!oriref
      endhandle
    endif
  endif

  --  enddo

  label /exit
  -- dtf 3-08-04
  --for constants set up design parameters for the selection
  !vsprDkey = prop TRAV
  handle (2,207)
    -- prop not available for this type
    !vTravel = FALSE
  elsehandle NONE
    !vTravel = TRUE
  endhandle

  --if (!!mdsAllHangerTypes.m5Constant.findfirst(!!mdsFH01.support.alias).set()  ) then
  if (!vTravel eq TRUE ) then

    -- dtf End of mod
    var !p3newDir  dir p3
    !olddesp  = (desp num 1)
    var !desp  desp
    !travel = !olddesp[1]
    -- find !travel with new selection otherwise choose first value
    !values = ARRAY()
    !flag = (0)
    !minHeight = !!ce.cATREF.:MDSMinHeight
    !travelval = !minHeight
    do !loop from 1 to 3
      !mdsCP$!loop = !!ce.cATREF.:MDSCp$!loop
      !temp = !mdsCP$N$!loop
      !split = !temp.split(',')
      do !ind ind !split
        if !split[$!ind] neq 'unset' then
          if (!travel eq !travelval ) then
            !desp = '$!travelval$N $!split[$!ind]'
            !flag = (1)
          elseif(!travelval eq !minHeight ) then
            !desp = '$!travelval$N $!split[$!ind]'
          endif
          !values.append('$!travelval $!split[$!ind]')
          !travelval = ($!travelval + 10)
        else
          --
          !desp = '$!desp'
        endif
      enddo
      if !flag eq 1 then
        break
      endif

    enddo
    DESP $!desp
    var !p3Dir p3 dir
    conn and p3 is $!p3Dir
    handle ANY
      fconn
    endhandle
  endif

  -- Show dimensions on graphics if required
  if !!mdsFH01.graphicalDim then
    !!mdsshowdim(!!mdsFH01)
  endif
  !!mdsModFH.setRodsLimits()
  --<tm addition to get rid of the dotted lines on a spring hanger
  !!ce = !rods[1].dbref()
  handle NONE
    tail
    !tref = !!ce.tref
    if (!tref EQ 'Nulref') then
      !!mdsDacControl(TRUE)
      conn pt to last mem
      tref $!tref
      !!mdsDacControl(FALSE)
    endif
    handle any $* in case the tref has been deleted
    elsehandle none
      !!mdsModFH.resetdelp(!!ce,!tref)
    endhandle
  elsehandle ANY
  endhandle
  --<end of tm addition
  !!ce = !ce
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!!mdsModFH' + '.modifySpringType($!hangerNo is REAL)')
  endif
  !!mdsDacControl(FALSE)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .resetdelp(!hanger is DBREF,!fitting is DBREF)
  -- method to recalculate the fitting delp when the spring is changed
  !tpos = !hanger.tpos.wrt(/* )
  !!ce = !fitting
  delp n0 e0 u0
  !delp = !tpos.wrt(!fitting)
  delp e $!delp.east n$!delp.north U$!delp.up
  !!ce = !hanger

endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .setAvailableRodSizes(!hangerForm is FORM) is ARRAY
  -- Returns the available rod sizes for the current rest.
  -- this is based on the intersection of three arrays as follows
  -- 1. Array of available rod sizes in the catalog (which is also an intersection of all the rest component available rod sizes)
  -- 2. Array of allowable rod sizes for the current pipe bore
  -- 3. The pipe clamp gap for the rod connection. This set the max allowed rod size if it is lower than the max of the previous two arrays.
  -- item no. 3 is ignored if the rest does not have a pipe clamp
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !oRest = !hangerForm.support.rest
  -- Get the available rod sizes in the catalog
  -- for the current Rest. All rest's components available rods are checked and the intersection result is returned.
  !availableRodSizes = !oRest.getAvailableReselectBores()
  !pipeBore = !oRest.bore.real()
  !allowableStdRodSizes = !!mdsAllHangerTypes.allowedRodSizesPerPipe[!pipeBore]
  !possibleRodSizes = !allowableStdRodSizes.intersect(!availableRodSizes)

  -- check pipe clamp clearance gap
  !newPossibleRodSizes = !possibleRodSizes
  do !pipeClampsI indices !!mdsModFH.pipeClampsRefs
    !pipeClampClearanceGap = prop cgap of $!!mdsModFH.pipeClampsRefs[$!pipeClampsI]
    !newPossibleRodSizes = ARRAY()
    do !index indices !possibleRodSizes
      -- Check each rod size
      if(!possibleRodSizes[!index] gt !pipeClampClearanceGap) then
        -- rod size is too big to fit in the pipe clamp
        --  elseif(!possibleRodSizes[!index] eq !oRest.rodSize) then
        -- rod size is the same as the current rod size.
        -- there is no need to display it in the selection list
      else
        !newPossibleRodSizes.append(!possibleRodSizes[!index])
      endif
    enddo
    !possibleRodSizes = !newPossibleRodSizes
  enddo

  !!mdsModFH.allowedRodSizes = !newPossibleRodSizes.sort()
  !!kRestoreUnits(!currentunits)
  return !!mdsModFH.allowedRodSizes
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .changeRodSize(!hangerForm is FORM)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  if(!!mdsModFH.allowedRodSizes.empty()) then
    -- To avoid re-creating of the list, we do it only if the list is empty
    !!mdsModFH.setAvailableRodSizes(!hangerForm)
  endif
  if(undefined(!!mdsChangeRodSize)) then
    pml load form !!mdsChangeRodSize
  endif
  if(not !!mdsChangeRodSize.shown()) then
    !!kShowForm(!!mdsChangeRodSize)
  endif

  -- Transforms rod sizes values from real to string
  !toStringInch = object BLOCK('!!mdsModFH.allowedRodSizes[!evalindex].string(!!distanceFmt)')
  !!mdsChangeRodSize.rodSizes.dtext = !!mdsModFH.allowedRodSizes.evaluate(!toStringInch)
  !toStringMM = object BLOCK('string(!!mdsModFH.allowedRodSizes[!evalindex])')
  !!mdsChangeRodSize.rodSizes.rtext = !!mdsModFH.allowedRodSizes.evaluate(!toStringMM)
  !!mdsChangeRodSize.currentRodSize.val = !hangerForm.support.rest.rodSize
  !!mdsChangeRodSize.modifyForm = !!mdsModFH
  !!mdsChangeRodSize.hangerForm = !hangerForm
  !!kRestoreUnits(!currentunits)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .changeChannelSpan(!hangerForm is FORM)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  if(undefined(!!mdsChangeChannelSpan)) then
    pml load form !!mdsChangeChannelSpan
  endif
  if(not !!mdsChangeChannelSpan.shown()) then
    !!kShowForm(!!mdsChangeChannelSpan)
  endif
  --  !!mdsChangeChannelSpan.currentChannelSpan.val = !hangerForm.support.rest.channelSpan
  !!mdsChangeChannelSpan.currentChannelSpan.val = !hangerForm.support.rest.getCurrentSpan()
  !!mdsChangeChannelSpan.channelOlap.val = !hangerForm.support.rest.getCurrentOlap()
  if (!!mdsChangeChannelSpan.channelOlap.val ge 0 ) then
    !!mdsChangeChannelSpan.channelOlap.active = TRUE
  else
    !!mdsChangeChannelSpan.channelOlap.clear()
    !!mdsChangeChannelSpan.channelOlap.active = FALSE
  endif
  -- get span limits

  !minSpan = !hangerForm.support.rest.getMinRequiredSpan()

  !maxSpan = !hangerForm.support.rest.getMaxAvailableSpan()


  if(!maxSpan gt -1) then
    !minSpan = min(!minSpan, !maxSpan)
    !maxSpanStr = !maxSpan.string(!!distanceFmt)
    !!mdsChangeChannelSpan.spanLimits.val = 'Allowed Span Range: ' + !minSpan.string(!!distanceFmt) + ' - ' + !maxSpanStr
  else
    !!mdsChangeChannelSpan.spanLimits.val = 'Minimum Span: ' + !minSpan.string(!!distanceFmt)
  endif
  !!mdsChangeChannelSpan.modifyForm = !!mdsModFH
  !!mdsChangeChannelSpan.hangerForm = !hangerForm
  !!kRestoreUnits(!currentunits)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .changeChannelHeight(!hangerForm is FORM)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !ce = !!ce
  !oRest = !hangerForm.support.rest
  if(not !oRest.styp inset$!!mdsAllHangerTypes.channelAssembly) then
    -- not a channel assembly
    -- only channel assemblies can change height using design parameters
    -- The height of the Double springs (DSSpring (B13 & B14) components is changed as a result of the catalog definitions
    return
  endif
  !!ce = !oRest.hangers[1].ref
  -- Saves the hang hbor
  var !hbor hbor
  -- Change the hbor to be the same as the rod size (pbor0 of the beam)
  -- for the choose command to work
  !!ce.hbor = !!ce.tbor
  handle (2,796)
    -- dtf >>> tbor 0 in PIHASA angle and HEB so get it from pl of 1 of hang 2
    !!ce.hbor = (pl bore of 1 of next hang)
  endhandle
  -- dtf <<<
  1
  !styp = styp
  -- save the current arrive and leave values.
  -- Somehow the choose command changes it
  !arrive = arriv
  !leave = leav

  --<wd>-->>>aug2003
  -- Store the ORI wrt /* for the HELE 1 - Channel Assembly to rest after the CHOOSE command
  !heleori = !!ce.ori.wrt(/* )
  --<wd>--<<<aug2003

  choose all with styp '$!styp'
  arrive $!arrive
  leave $!leave
  hang
  hbor $!hbor

  --<wd>-->>>aug2003
  -- Reconnect the HANGER HEADS for:
  -- (1) - <support-name>/H2 -- Connect HH to the P3 of HELE 1 of <support-name>/H1
  --    and
  -- (2) - <support-name>/H3 -- Connect HH to the HT of <support-name>/H1 -- (Located at PPoint P2 of HELE 1 of <support-name>/H1
  --
  do !x indices !oRest.hangers
    !!ce = !oRest.hangers[!x].ref
    if (!!ce.fullname.match('/H1').gt(0)) then
      hele 1
      ori $!heleori
      !!ce = !oRest.hangers[!x].ref
      conn pt to last mem
    elseif (!!ce.fullname.match('/H2').gt(0)) then
      conn hh to p3 of HELE 1 of $!oRest.hangers[1].ref
      --conn hh to p3 of HELE 1 of HANG 1
    elseif (!!ce.fullname.match('/H3').gt(0)) then
      conn hh to ht of $!oRest.hangers[1].ref
      --conn hh to ht of HANG 1
    endif
  enddo

  -- Now Recalculate and Set the HROD1/EYRD1 height and Reconnect HNUT1, HNUT2, HNUT3 and EYRD1/HROD1
  do !x indices !oRest.hangers
    skip if (!x.eq(1))
    !!ce = !oRest.hangers[!x].ref
    var !heig cons dist hh to pleave of HROD1 of $!oRest.hangers[$!x].ref
    handle none
      HROD 1
      !xrod = !!ce
    elsehandle (2,113) $* List Exhausted
      var !heig cons dist hh to pleave of EYRD1 of $!oRest.hangers[$!x].ref
      EYRD 1
      !xrod = !!ce
    endhandle
    height $!heig
    HNUT 1
    conn
    HNUT 2
    conn
    HNUT 3
    conn
    !!ce = !xrod
    conn
  enddo
  --<wd>--<<<aug2003

  !!ce = !ce

  !!kRestoreUnits(!currentunits)
endmethod
