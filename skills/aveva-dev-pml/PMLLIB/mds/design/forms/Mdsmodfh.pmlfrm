-- Description:
-- Form Definition for Fixed & Variable Hangers
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  changeChannelHeight(FORM)        -
--  changeChannelSpan(FORM)          -
--  changeRodSize(FORM)              -
--  changeType(BOOLEAN)              -
--  changeTypeApplied(FORM)          -
--  init()                           -
--  modifySpringType(REAL,BOOLEAN)   -
--  reconnectHanger(DBREF,REAL)      -
--  resetdelp(DBREF,DBREF)           -
--  rodsToModify(FORM)               ARRAY
--  setAvailableRodSizes(FORM)       ARRAY
--  setEqualRodLength(REAL)          -
--  setRodLength(REAL,STRING)        -
--  setRodsLimits()                  -
--  setRodsToModify(FORM)            -
--  tagHangers(FORM)                 -
--  unTagHangers()                   -
--  validateRodLength(REAL,REAL,STRING) -
--

-- Kill existing form definition
Kill !!mdsModFH

-- Define Form
setup form  !!mdsModFH at xr0 yr0

  !!mdsModFH.formtitle    = |Modify Hanger|
  !!mdsModFH.icontitle    = |Mod Hanger|
  !!mdsModFH.callback     = ||
  !!mdsModFH.formrevision = | $Revision: 1 $ |

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1
  frame .fMisc |Options| at x0 ymax width 35
    frame .fMisc1 |Hanger 1| at x2 ymax width 35

      para .pTopRodLength1 at x1 Ymax+0.2 text    |Top Rod Length    |
      path right
      text .topRodLength1    || call |!!mdsModFH.setRodLength(1,'TOP')| width 16 is REAL format !!distanceFmt
      para .topRodLimits1    at x1 Ymax+0.2 text  || width 40
      para .pBottomRodLength1 at x1 Ymax+0.2 text |Bottom Rod Length |
      text .bottomRodLength1    || call |!!mdsModFH.setRodLength(1,'BOTTOM')| width 16 is REAL format !!distanceFmt
      para .bottomRodLimits1   at x1 Ymax+0.2  text  || width 40

      button .setEqual1      at x1 Ymax+0.2 tooltip 'Set Equal Length Rods'       pixmap width 18 height 18 call |!!mdsModFH.setEqualRodLength(1)|
      path right
      vdist 0.5
      button .modifySpring1                 tooltip 'Change Spring Type'          pixmap width 18 height 18 call |!!mdsModFH.modifySpringType(1,true)|
      button .modifyTrav1                   tooltip 'Change Spring Travel'        pixmap width 18 height 18 call |!!mdseditvprop.init(1)|

    exit
    frame .fMisc2 |Hanger 2| at x2 ymax+.2 width 35

      para .pTopRodLength2 at x1 Ymax+0.2 text    |Top Rod Length    |
      path right
      text .topRodLength2    || call |!!mdsModFH.setRodLength(2,'TOP')| width 16 is REAL format !!distanceFmt
      para .topRodLimits2    at x1 Ymax+0.2 text  || width 40
      para .pBottomRodLength2 at x1 Ymax+0.2 text |Bottom Rod Length |
      text .bottomRodLength2    || call |!!mdsModFH.setRodLength(2,'BOTTOM')| width 16 is REAL format !!distanceFmt
      para .bottomRodLimits2   at x1 Ymax+0.2  text  || width 40

      button .setEqual2      at x1 Ymax+0.2 tooltip 'Set Equal Length Rods'       pixmap width 18 height 18 call |!!mdsModFH.setEqualRodLength(2)|
      path right
      vdist 0.5
      button .modifySpring2                 tooltip 'Change Spring Type'          pixmap width 18 height 18 call |!!mdsModFH.modifySpringType(2,true)|
      button .modifyTrav2                   tooltip 'Change Spring Travel'        pixmap width 18 height 18 call |!!mdseditvprop.init(2)|

    exit
    button .modifyType  at x3 ymax+.2  tooltip 'Modify Hanger Configuration' pixmap width 18 height 18 call |!!mdsModFH.changeType(false)|
    button .fixedVariable              tooltip 'Change Hanger Type'          pixmap width 18 height 18 call |!!mdsModFH.changeType(true)|
    button .changeRodSize              tooltip 'Change Rod Size'             pixmap width 18 height 18 call |!!mdsModFH.changeRodSize(!!mdsFH01)|
    button .changeChannelSpan          tooltip 'Change Assembly Span'   pixmap width 18 height 18 call |!!mdsModFH.changeChannelSpan(!!mdsFH01)|
    button .changeChannelHeight        tooltip 'Change Assembly Height' pixmap width 18 height 18 call |!!mdsModFH.changeChannelHeight(!!mdsFH01)|
  exit
  -- Bottom Line
  button .cancel  | Dismiss | at xmax form-size ymax+0.5 call |!!mdsModFH.cancel()|

  -- Form Members
  member .atta is DBREF

  member .restRods is ARRAY
  member .fixedTopRod is ARRAY
  member .minTopRodLength is ARRAY
  member .maxTopRodLength is ARRAY
  member .minBottomRodLength is ARRAY
  member .maxBottomRodLength is ARRAY
  member .hangertypes is MDSHANGERTYPES
  member .allowedRodSizes is ARRAY
  member .okCallback is STRING

  !!mdsModFH.hangertypes = object MDSHANGERTYPES()

  !!mdsModFH.setEqual1.addPixmap(!!pML.getPathName('hequalrods.png'))
  handle any
  endhandle
  !!mdsModFH.modifySpring1.addPixmap(!!pML.getPathName('hspringmod.png'))
  handle any
  endhandle
  !!mdsModFH.modifyTrav1.addPixmap(!!pML.getPathName('hspringtravmod.png'))
  handle any
  endhandle
  !!mdsModFH.setEqual2.addPixmap(!!pML.getPathName('hequalrods.png'))
  handle any
  endhandle
  !!mdsModFH.modifySpring2.addPixmap(!!pML.getPathName('hspringmod.png'))
  handle any
  endhandle
  !!mdsModFH.modifyTrav2.addPixmap(!!pML.getPathName('hspringtravmod.png'))
  handle any
  endhandle


  !!mdsModFH.modifyType.addPixmap(!!pML.getPathName('hmodtype.png'))
  handle any
  endhandle
  !!mdsModFH.fixedVariable.addPixmap(!!pML.getPathName('hchangetype.png'))
  handle any
  endhandle
  !!mdsModFH.changeRodSize.addPixmap(!!pML.getPathName('hchangerodsize.png'))
  handle any
  endhandle
  !!mdsModFH.changeChannelSpan.addPixmap(!!pML.getPathName('hchangechspan.png'))
  handle any
  endhandle
  !!mdsModFH.changeChannelHeight.addPixmap(!!pML.getPathName('hchangechheight.png'))
  handle any
  endhandle

  -- End form definition

exit
--=========================================================================================================================

---------------------------------------------------------------------------------------------------------------------------
define method .cancel()
  !!mdsModFH.unTagHangers()
  !!mdsModFH.hide()
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
define method .init()
  --< tm fix for clearing gadgets
  !!mdsModFH.bottomRodLength1.val = object REAL()
  !!mdsModFH.bottomRodLength2.val = object REAL()
  !!mdsModFH.topRodLength1.val = object REAL()
  !!mdsModFH.topRodLength2.val = object REAL()
  !!mdsModFH.bottomRodLimits1.val = ''
  !!mdsModFH.bottomRodLimits2.val = ''
  !!mdsModFH.bottomRodLimits1.val = ''
  !!mdsModFH.bottomRodLimits2.val = ''
  --< end of tm fix
  !!mdsImodfh(!!mdsFH01,!!mdsModFH, false)
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
-- method to gather the rods to be modified and set up the form variables
define method .setRodsToModify(!hangerForm is FORM)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIN(1, '$!!mdsModFH' + '.setRodsToModify($!hangerForm is FORM)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !restRods = !!mdsModFH.rodsToModify(!hangerForm )
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(1, 'Size of Restraint rods is :' + !restRods.size().string())
  endif

  -- set the form gadget active status
  !!mdsModFH.setEqual1.active = false
  !!mdsModFH.bottomRodLength1.active = false
  !!mdsModFH.topRodLength1.active = false
  !!mdsModFH.modifySpring1.active = false
  !!mdsModFH.setEqual2.active = false
  !!mdsModFH.bottomRodLength2.active = false
  !!mdsModFH.topRodLength2.active = false
  !!mdsModFH.modifySpring2.active = false

  -- loop through the hanger rods and set the gadgets
  do !hangerNo indices !restRods
    !rods = !restRods[!hangerNo]
    skip if(!rods.unset() or !rods.size() eq 0)
    !hangIndex = !hangerNo
    -- set the top rod limits to blank
    !action = '!!mdsModFH.topRodLimits$!hangIndex' + '.val = ||'
    $!action
    !!mdsModFH.fixedTopRod[!hangIndex] = false
    if(!rods.size() eq 2) then
      if(defined(!!mdsDEBUG)) then
        !!mdsDEBUG.trace(1, 'Size of hanger no. hangerNo rods is :' + !restRods.size().string())
      endif
      !action = '!!mdsModFH.setEqual$!hangIndex' + '.active = true'
      $!action
      !action = '!!mdsModFH.topRodLength$!hangIndex' + '.active = true'
      $!action
      !action = '!!mdsModFH.bottomRodLength$!hangIndex' + '.active = true'
      $!action
      if(!rods[2].match('_FIXEDLENGTH') gt 0) then
        !!mdsModFH.fixedTopRod[!hangIndex] = true
        !action = '!!mdsModFH.setEqual$!hangIndex' + '.active = false'
        $!action
        !action = '!!mdsModFH.topRodLength$!hangIndex' + '.active = false'
        $!action
        !action = '!!mdsModFH.bottomRodLength$!hangIndex' + '.active = false'
        $!action
      endif
    elseif(!rods.size() eq 1) then
      -- this probably gets the wrong value
      !!mdsModFH.fixedTopRod[!hangIndex] = TRUE
      !rods[1]= !rods[1].before('_')
      !action = '!!mdsModFH.bottomRodLength$!hangIndex' + '.val = heigh of $!rods[1]'
      $!action
      !action = '!!mdsModFH.topRodLength$!hangIndex' + '.val = 0'
      $!action
    endif
  enddo
  !!mdsModFH.setRodsLimits()
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!!mdsModFH' + '.setRodsToModify($!hangerForm is FORM)')
  endif
endmethod
---------------------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------------------------
-- method to work out the rod limits
-- maximum and minimum values should all come from here
define method .setRodsLimits()
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIN(1, '$!!mdsModFH' + '.setRodsLimits()')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- Calculates and displays the rods heights limits
  !restRods = !!mdsModFH.restRods
  !hangIndex = 0
  do !hangerNo indices !restRods
    !rods = !restRods[!hangerNo]
    skip if(!rods.unset() or !rods.size() eq 0)
    !hangIndex = !hangerNo
    --      !hangIndex = !hangIndex + 1
    !rods[1] = !rods[1].before('_FIXEDLENGTH')

    !minBotL = :MDSMinHeight of catref of $!rods[1]
    --< tm change to set the minimum length of bolt to be inclusive of threads
    !minBotL = !minBotL + !rods[1].dbref().despar[1] + !rods[1].dbref().despar[2]
    handle (2,752)
      !minBotL = !minBotL + !rods[1].dbref().despar[1]
    endhandle
    --< end of tm modification
    !maxBotL = :MDSMaxHeight of catref of $!rods[1]
    !rodlen = !rods[1].dbref().height + !rods[1].dbref().despar[1] + !rods[1].dbref().despar[2]
    handle (2,752)
      !rodlen = !rods[1].dbref().height + !rods[1].dbref().despar[1]
    endhandle
    !bottrodlength = !rodlen
    !action = '!!mdsModFH.bottomRodLength$!hangIndex' + '.val = !rodlen'
    $!action


    !mintopl = 0
    !maxTopL = 0

    --<tm mod to get different top and bottom rod lengths due to minimum closure value and maximum length inc threads
    if(!rods.size() eq 2) then  $* fixed
      if(!!mdsModFH.fixedTopRod[!hangIndex]) then
        !rods[2] = !rods[2].before('_FIXEDLENGTH')
        -- var !topRodLengthStr const dist pa of $!rods[2] to pl of $!rods[2]
        --< tm mod to get length of eyerods
        var !topRodLengthStr prop olen OF $!rods[2]
        --   !topRodLengthStr = STRING(!topRodLengthStr.real() + !rods[2].dbref().despar[1])
        --< end of tm mod
        !action = '!!mdsModFH.topRodLength$!hangIndex' + '.val = !topRodLengthStr.real()'
        $!action

        !mintopl = !topRodLengthStr.real()
        !maxTopL = !topRodLengthStr.real()
      else
        !mintopl = :MDSMinHeight of catref of $!rods[2]
        --< tm change to set the minimum length of bolt to be inclusive of threads
        !mintopl = !mintopl + !rods[2].dbref().despar[1] + !rods[2].dbref().despar[2]
        handle (2,752)
          !mintopl = !mintopl + !rods[2].dbref().despar[1]
        endhandle
        --< end of tm modification

        if(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.tASpring or $
          !!mdsFH01.support.alias inset$!!mdsAllHangerTypes.eSSpring) then
          -- Top rod is connected to the top of the spring.
          -- Minimum length can not be shorter than the beam height.
          !beamHeight = !!mdsFH01.getMaxBeamHeight(!rods[2].dbref().owner)
          !springHeight = !!mdsFH01.getSpringHeight(!rods[2].dbref().owner)
          !mintopl = max(!mintopl,!springHeight + !beamHeight ) + 100 $( add some space to be able to tighten the spring nut $)
          --elseif(!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionFixed or $
          --!!mdsFH01.support.alias inset$!!mdsAllHangerTypes.doubleChannelRodConnectionVariable) then
        elseif( !!mdsAllHangerTypes.doubleChannelRodConnectionFixed.find(!!mdsFH01.support.alias).size().gt(0) or $
          !!mdsAllHangerTypes.doubleChannelRodConnectionVariable.find(!!mdsFH01.support.alias).size().gt(0) ) then
          -- Top rod is connected to the top of the beam.
          -- Minimum length can not be shorter than the beam height.
          !beamHeight = !!mdsFH01.getMaxBeamHeight(!rods[2].dbref().owner)
          !mintopl = max(!mintopl,!beamHeight) + 100 $( add some space to be able to tighten the spring nut $)
        endif
        !maxTopL = :MDSMaxHeight of catref of $!rods[2]
        if !rods[2].dbref().type.eq('EYRD') then
          !rodlen = !rods[2].dbref().height + !rods[2].dbref().despar[1]
        else
          !rodlen = !rods[2].dbref().height + !rods[2].dbref().despar[1] + !rods[2].dbref().despar[2]
        endif
        !action = '!!mdsModFH.topRodLength$!hangIndex' + '.val = !rodlen'
        $!action
        !topRodLength = !rodlen
      endif
    endif

    -- ******************************************************************************************
    -- need to calculate the minimum rod length based on the maximum length of the bottom rod
    -- giving the minimum length based on the standard error message
    -- ******************************************************************************************

    -- Set Bottom rod maximum length based on the total length of both rods and the minimum length of the bottom rod.
    !action = '!maxBotLActual = !!mdsModFH.topRodLength$!hangIndex' + '.val + !!mdsModFH.bottomRodLength$!hangIndex' + '.val - !mintopl'
    $!action
    !maxBotLActual = min(!maxBotL,!maxBotLActual)
    ---!maxBotLActual = !maxBotL
    -- Set Top rod maximum length based on the total length of both rods and the minimum length of the top rod.
    !action = '!maxTopLActual = !!mdsModFH.topRodLength$!hangIndex' + '.val + !!mdsModFH.bottomRodLength$!hangIndex' + '.val - !minBotL'
    $!action
    !maxTopLActual = min(!maxTopL,!maxTopLActual)
    !maxTopLActual = min(!maxTopL,!maxTopLActual)
    if defined(!topRodLength) and defined(!bottrodlength) then
      !totallength = !topRodLength + !bottrodlength
      !mintoplActual = !totallength - !maxBotLActual
    else
      !action = '!mintoplActual = !!mdsModFH.topRodLength$!hangIndex' + '.val + !!mdsModFH.bottomRodLength$!hangIndex' + '.val - !minBotL'
      $!action
    endif
    !!mdsModFH.minBottomRodLength[!hangIndex] = $!minBotL
    !!mdsModFH.maxBottomRodLength[!hangIndex] = $!maxBotLActual
    !action = '!!mdsModFH.bottomRodLimits$!hangIndex' + '.val = |Length Limits: ' + !minBotL.string(!!distanceFmt) + ' - ' + !!mdsModFH.maxBottomRodLength[$!hangIndex].string(!!distanceFmt) + '|'
    $!action

    !mintopl = max(!mintoplActual,!mintopl)
    !!mdsModFH.minTopRodLength[!hangIndex] = $!mintopl
    !!mdsModFH.maxTopRodLength[!hangIndex] = $!maxTopLActual
    !action = '!!mdsModFH.topRodLimits$!hangIndex' + '.val = |Length Limits: ' + !mintopl.string(!!distanceFmt) + ' - ' + !!mdsModFH.maxTopRodLength[$!hangIndex].string(!!distanceFmt) + '|'
    $!action
  enddo

  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!!mdsModFH' + '.setRodsLimits()')
  endif
endmethod
