--
-- File:		Mdsmodifyname.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 22nd January 1998
--
--
-- Description:
-- Form Definition for Modifying Name of a Support
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdsmodifyname
  handle any
    kill !!Mdsmodifyname
  endhandle

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Argument 1 is either - 'BLOCKING' - or ''
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Form

  if (not defined(!!FormType)) then
    !!FormType = ''
  endif

  setup form !!Mdsmodifyname $!!FormType

    !!Mdsmodifyname.formtitle    = |Modify Support Name|
    !!Mdsmodifyname.icontitle    = |ModSuppName|
    !!Mdsmodifyname.callback     = ||
    !!Mdsmodifyname.formrevision = | $Revision: 1.1.19.1 $ |

--------------------------------------------------------------------------------
-- Body of Form
    frame .option |Modify Support Name| at x0 ymax
      text .name |Existing  Support Name | at x0.5 y1       call |call !!Mdsselectsupp('MODIFYNAME', 'NAME','VERBOSE')| width 20 name

--xxx      text   .newname |Change to Support Name | at x0.5 ymax+0.5 call |CALLIB NAMECHK _Mdsmodifyname_name $$<$$_cdsysnam_case$$> $$<$$_cdsysnam_name$$>| width 20 name
      text .newname  |Change to Support Name | at x0.5 ymax+0.5 call |!!kactioncommands(!!Mdsmodifyname.anewname)| width 20 name

      halign right
      path down
      button .cursor | Identify By Cursor |  call |call !!Mdsselectsupp('MODIFYNAME', 'CURSOR','VERBOSE')|
      button .ce     | CE |     at x0.5 ymin call |call !!Mdsselectsupp('MODIFYNAME', 'CE','VERBOSE')|
    exit

-- Bottom Line
    if ('$!!Formtype' eq 'BLOCKING') then
      button .ok     |   OK   |   at x0 ymax+0.5       call |call !!kactioncommands(!!Mdsmodifyname.applyform)| ok
      button .Autoname |MDS Autoname| at xmax+1 ymin call |!!MdsAutoName.GetNextName(!This)|
      button .cancel |Cancel| at xmax form-size ymin call |call !!kactioncommands(!!Mdsmodifyname.dismissform)| cancel
    elseif ('$!!Formtype' eq '') then
      button .ok     | Apply |   at x0 ymax+0.5         call |call !!kactioncommands(!!Mdsmodifyname.applyform)|
      button .Autoname |MDS Autoname| at xmax+1 ymin call |!!MdsAutoName.GetNextName(!This)|
      button .AddGroup   | | at xmax+1 ymin-.25 tooltip 'Add to Support Group' pixmap width 19 height 19 call |Call !!MdsGroup('ADD',!this)|
      button .RemGroup   | | at xmax+1 ymin tooltip 'Remove Support from Group' pixmap width 19 height 19 call |Call !!MdsGroup('REM',!this)|
      button .cancel | Dismiss | at xmax form-size ymin+.25 call |call !!kactioncommands(!!Mdsmodifyname.dismissform)| cancel
    endif

--------------------------------------------------------------------------------
-- Form Members

-- List of actions on '.newname' gadget
    member .anewname     is ARRAY

-- Support Members
    member .supportmem   is ARRAY

-- List of actions to be taken on applying form
    member .applyform    is ARRAY

-- List of actions to be taken on dismissing form
    member .dismissform  is ARRAY

-- For Group Supports
    member .IsPartOfGroup is BOOLEAN
    member .ReNameHanger is BOOLEAN
    member .ConnectedHangers is ARRAY

--<wd>oct2005
-- ADD to GROUP or REMOVE from GROUP Button has been used to SET the NEW NAME gadget
-- Permissible STRINGS are 'ADD', 'REMOVE' and '' or unset
    member .addremgroup is STRING
--<wd>oct2005

-- End form definition
exit

--<wd>oct2005
-- Default Setting
    !!mdsmodifyname.addremgroup = ''
--<wd>oct2005

    !!Mdsmodifyname.IsPartOfGroup = FALSE
    !!Mdsmodifyname.ReNameHanger = FALSE

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Set form text gadgets for the first time the form is shown
    !!Mdsmodifyname.name.val    = 'unset'
    !!Mdsmodifyname.newname.val = 'unset'

-- Actions on '.newname' text gadget
    !!Mdsmodifyname.anewname[1] = |$M/%PDMSUI%/CLIB/FILES/NAMECHK _Mdsmodifyname_newname $$<$$_cdsysnam_case$$> $$<$$_cdsysnam_name$$>|
    !!Mdsmodifyname.anewname[2] = |!!MdsGroup('CHECKSTRUN',!!Mdsmodifyname)|
    !!Mdsmodifyname.anewname[3] = |!!Mdssupportform(!!Mdsmodifyname)|
    !!Mdsmodifyname.anewname[4] = |!!MdsGroup('HIGHLIGHT',!!Mdsmodifyname)|

-- Actions on dismiss button
    !!Mdsmodifyname.dismissform[1] = |UNENHANCE ALL|
    !!Mdsmodifyname.dismissform[2] = |!!Mdsmodifyname.name.val = 'unset'|
    !!Mdsmodifyname.dismissform[3] = |!!Mdsmodifyname.applyform[1] = ''|
    !!Mdsmodifyname.dismissform[4] = |!!Mdsmodifyname.applyform.remove(5)|


-- Action on apply button
    !!Mdsmodifyname.applyform[1] = ||
    !!Mdsmodifyname.applyform[2] = |!!Mdsmodifyname.name.val = 'unset'|
    !!Mdsmodifyname.applyForm[3] = ||

-- Set icons
  !!MdsSetIconBack(!!Mdsmodifyname,'white')

--------------------------------------------------------------------------------
-- End of file Mdsmodifyname.frm
