--
-- File:    Mdsmodifysupp.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    I.osborne
-- Created:   Wed May 14
--
--
-- Description:
-- Form Definition for Deleting supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyMethod()                    -
--  resetRepre()                     -
--  showForm()                       -
--

-- Kill existing form definition
kill !!mdsModifySupp

-- Define Form
setup form  !!mdsModifySupp

  !!mdsModifySupp.formtitle    = |Modify Support|
  !!mdsModifySupp.icontitle    = ||
  !!mdsModifySupp.callback     = ||
  -- !!mdsModifySupp.callback     = |!this.showForm()|
  !!mdsModifySupp.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  frame .option |Modify Options| at x0 ymax
    text   .name   |Support Name |    at x0.5 y1   Call |Call !!mdsSelectSupp('MODIFY', 'NAME','VERBOSE')| width 20 name
    !!mdsModifySupp.name.val = 'unset'
    halign right
    path down
    button .cursor | Identify By Cursor |  Call |Call !!mdsSelectSupp('MODIFY', 'CURSOR','VERBOSE')|
    button .ce | CE |  at x0.5 ymin Call |Call !!mdsSelectSupp('MODIFY', 'CE','VERBOSE')|
  exit

  -- Bottom Line
  button .ok     | Apply | at x0 ymax+0.5         Call |!!mdsModifySupp.applyMethod()|
  -- toggle .mif    |Enter Manu. I/F| at xmax+1 ymin
  button .cancel | Dismiss | at xmax form-size ymin Call |Call !!kActionCommands(!!mdsModifySupp.dismissForm)| cancel
  button .zoom     at xmax.ce+2.5 ymin.ce-0.2 tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsModifySupp)|

  -- Form Members
  -- List of support members
  member .supportMem   is ARRAY

  -- List of actions to be taken on applying form
  member .applyForm    is ARRAY

  -- List of actions to be taken on dismissing form
  member .dismissForm  is ARRAY

  --
  member .childForm is FORM

  -- End form definition
exit

-- Populate option gadgets
-- Actions on dismiss button

!!mdsModifySupp.dismissForm[1] = |UNENHANCE ALL|
!!mdsModifySupp.dismissForm[2] = |!!mdsModifySupp.resetRepre()|
!!mdsModifySupp.dismissForm[3] = |!!mdsModifyCheck()|
!!mdsModifySupp.dismissForm[4] = |!!mdsModifySupp.name.val = 'unset'|
!!mdsModifySupp.dismissForm[5] = |!!mdsModifySupp.supportMem.clear()|
!!mdsModifySupp.dismissForm[6] = |!!mdsModifySupp.applyForm[1] = ''|
!!mdsModifySupp.dismissForm[7] = |!!mdsModifySupp.applyForm.remove(5)|

-- Action on apply button
--< Modified - <ab> - 04mar2002
-- With current code, The Cancel button cannot be enabled
-- see below suggest code.
!!mdsModifySupp.applyForm[1] = ||
!!mdsModifySupp.applyForm[2] = |!!mdsModifySupp.name.val = 'unset'|
!!mdsModifySupp.applyForm[3] = |!!mdsModifySupp.supportMem.clear()|
--!!mdsModifySupp.applyForm[4] = |!!mdsModifySupp.cancel.active = false|
!!mdsModifySupp.applyForm[4] = |!!mdsModifySupp.applyForm[1] = ''|
--  !!mdsModifySupp.applyForm[1] = |!!mdsModifySupp.cancel.active = false|
--  !!mdsModifySupp.applyForm[2] = ||
--  !!mdsModifySupp.applyForm[3] = |!!mdsModifySupp.name.val = 'unset'|
--  !!mdsModifySupp.applyForm[4] = |!!mdsModifySupp.supportMem.clear()|
--  !!mdsModifySupp.applyForm[5] = |!!mdsModifySupp.applyForm[2] = ''|
--< Modified - <ab> - 04mar2002
!!mdsModifySupp.zoom.addPixmap(!!pml.getPathName('zoomsupp.png'))
handle any
endhandle

define method .showForm()

  -- If we are using the MDS interface then turn off the Enter I/F toggle and set it to false
$(
  if !!mdsHangIf.eq('MDS') then
    !this.mif.val = false
    !this.mif.active = false
    !this.mif.visible = false
    handle any
    endhandle
  else
    -- !this.mif.val = false
    !this.mif.active = TRUE
    !this.mif.visible = TRUE
    handle any
    endhandle
  endif
$)
  -- if the current element is a support then activate it

  !!mdsSilent = TRUE
  !currentSupportName = !!mdsGetSuppName(!!ce)
  !!mdsSilent.delete()

  if !currentSupportName.neq('ABORT') then
    !!mdsModifySupp.name.val = !currentSupportName
    !!mdsSelectSupp('MODIFY', 'NAME','VERBOSE')
  endif

  !!mdsModifySupp.show('At',0,0.07)
  handle (61,498)
  endhandle

endmethod

define method .applyMethod()

 --method on apply button, finds child form so this can be closed cleanly with restoration of drawing levels
 --if child form exists

  Call !!kActionCommands(!!mdsModifySupp.applyForm)

  !arrayOfForms = !!fmsys.shownforms()

  do !form values !arrayOfForms
    if !form.owner().eq(!!mdsModifySupp) then
      !this.childForm = !form
      break
    endif
  enddo

  !!mdsModifySupp.applyForm[1] = ||
  !!mdsModifySupp.applyForm[2] = |!!mdsModifySupp.name.val = 'unset'|
  !!mdsModifySupp.applyForm[3] = |!!mdsModifySupp.supportMem.clear()|
  !!mdsModifySupp.applyForm[4] = |!!mdsModifySupp.applyForm[1] = ''|
  !!mdsModifySupp.applyForm[5] = ||
endmethod

define method .resetRepre()
  --loop through displayed forms, if find form where .owner() is !!mdsModifySupp, then store name of form
  --if !!namedform.repre exists, run this as e.g. call !!kActionCommands(!!mdsFt09.repre)
  if !this.childForm.unset().not() then
    if (defined(!this.childForm.repre)) then
      if !this.childForm.repre.unset().not() then
        call !!kActionCommands(!this.childForm.repre)
      endif
    endif
  endif
endmethod
