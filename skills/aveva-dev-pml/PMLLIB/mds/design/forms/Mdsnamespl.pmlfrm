--
-- File:  Mdsnamespl.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Wed Dec 10
--
--
-- Description:
-- Form Definition for naming a special
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fromExistingAtta ()              -
--

-- Kill existing form definition
kill !!mdsNameSpl

-- Define Form
setup form !!mdsNameSpl

  !!mdsNameSpl.formtitle    = |Special Support|
  !!mdsNameSpl.icontitle    = ||
  !!mdsNameSpl.formrevision = | $Revision: 1.1.19.1 $ |

  frame .frame |Details| at x0 y0

    -- Body of Form

    text .name     |Name   | at x0.3 Ymax+0.2 call |CALLIB NAMECHK _mdsNameSpl_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
    | width 29 name

    text .number   |Number | at x0.3 Ymax+0.2 call |!!mdsCheckNum()| width 29 name

  exit

  frame .option |Options| at x0 ymax+0.5
    option .type   |Type   |  at x1 y1        width 26
    option .create |Create |  at x1 ymax+0.2 call |call !!mdsNameSplok(!!mdsNameSpl.create.selection())| width 26
  exit

  button .ok     |   OK   | at xmin           ymax+0.5 call |!!mdsIspecial('NEW','$$!!mdsNameSpl.name','$$!!mdsNameSpl.number')|

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsAutoName|
  exit

  path right
  hdist 4

  button .autoname | | at xmax+4 ymin-0.25 tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsAutoName.getNextName(!this)|
  !this.autoname.setPopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!mdsIDfltSite()|

  button .startGroup | | at xmax+1 ymin tooltip 'New Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('NEW',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|

  button .cancel | Cancel | at xmax form-size ymin_ok call |call !!mdsResetAutoName(!this)|

  -- End form definition
exit

-- Populate .type option gadget

!dtext = ARRAY()
!rtext = ARRAY()

!dtext[1] = |Multi Discipline Support  |
!dtext[2] = |HVAC Support|
!dtext[3] = |Racking Support|
!rtext[1] = |MULTI|
!rtext[2] = |HVAC|
!rtext[3] = |RACK|
!!mdsNameSpl.type.dtext = !dtext
!!mdsNameSpl.type.rtext = !rtext

-- Populate .create option gadget

!dtext.clear()
!rtext.clear()
!dtext[1] = |Support Attas Only|
!dtext[2] =      |From Existing MDS Supports|
!rtext[1] = |ATTA|
!rtext[2] = |STRU|
!!mdsNameSpl.create.dtext = !dtext
!!mdsNameSpl.create.rtext = !rtext

-- Set icons

!!mdsSetIconBack(!!mdsNameSpl,'white')

define method .fromExistingAtta ()
  !!mdsIdPreliminarySupp(!this)
  if (!this.name.val.neq('unset') and !this.name.val.substring(1,1).neq('/')) then
    !this.name.val = '/' & !this.name.val
  endif

endmethod
