--
-- Description:
-- Form Definition for the nudge facility
--------------------------------------------------------------------------------

-- Kill existing form definition

Kill !!Mdsnudge

-- Define Form

Setup Form !!Mdsnudge

  !!Mdsnudge.formtitle    = |Nudge Support|
  !!Mdsnudge.icontitle    = ||
  !!Mdsnudge.Callback     = ||
  !!Mdsnudge.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

  text .Distance |Distance| width 14 is real format !!DistanceFmt
  button .Plus  at xmax+1 ymin   tooltip 'Nudge Forward'  pixmap height 16 width 16
  button .Minus at xmax+0.5 ymin tooltip 'Nudge Backward' pixmap height 16 width 16

  button .Cancel | Dismiss | at x0 Ymax+0.5 CANCEL

  -- Members

  member .form is form

exit

  !!mdsnudge.plus.addPixmap(!!PML.getPathName('leftarrow9x12.png'))
  !!mdsnudge.minus.addPixmap(!!PML.getPathName('rightarrow9x12.png'))

----------------------------------------------------------------------
define method .INIT(!form is form)

  -- Check that Datum atta has been created
  !Datum = !Form.Support.datum
  if !Datum.Set().not() then
    !!Alert.message('Datum support atta has not created')
    return
  endif

  -- Check that Datum atta has been positioned
  if (!Form.Support.Position.not())then
    !!Alert.message('Cannot nudge support as the datum has not been positioned')
    return
  endif

  !!MdsNudge.Form = !Form
  !!MdsNudge.Distance.val = 0

  -- Set the +/- icons to use the correct form

  !!MdsNudge.plus.callback  = |Call !!MdsplusDist(!!MdsNudge.form)|
  !!MdsNudge.minus.callback = |Call !!MdsminusDist(!!MdsNudge.form)|

  show !!MdsNudge

endmethod
----------------------------------------------------------------------

-- End form definition
