--
-- File:  Mdsoptions.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FPSOPTION
--
-- Author:  I.osborne
-- Created:   Tue Apr 29
--
--
-- Description:
-- Form Definition for modifying support options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeHangerIface()              -                   On change option callback - change active hanger interface to selected
--  inactiveforuser()                -                   Switch some gadgets to inactive if user is not in DESADMIN team
--  init()                           -                   On show callback method - populates hanger interface option & selects current
--  mdsOptions()                     -
--  save()                           -
--

-- Kill existing form definition
Kill !!mdsOptions

-- Define Form
setup form !!mdsOptions

  !!mdsOptions.formtitle    = |MDS Application Defaults|
  !!mdsOptions.icontitle    = ||
  !!mdsOptions.callback     = ||
  !!mdsOptions.formrevision = | $Revision: 1.1.19.1 $ |
  !!mdsOptions.initcall     = |!!mdsOptions.init()|

-- Body of Form
  frame .sitet |Creation Zone|  at x0 ymax
    para .lblSite at x1 y1 text |Supports:|
    para .site at x10 y1 width 28 lines 1
    para .lblSiteForHangers at x1 y2 text |Hangers:|
    para .siteForHangers at x10 y2 width 28 lines 1
    button .set |Select...| at x1 y3 call |Call !!mdsIDfltSite()|
  exit

  path down
  vdist 0.3

  frame .tol  |Application Tolerances| at x0 ymax
    text .clear     |Pipe Clearance       | at x1 y.5                          width 14 is REAL format !!distanceFmt
    text .slope     |Max. Pipe Slope      | call |!!mdsslope(!!mdsOptions)| width 14 string
    text .overlap   |Steelwork Overlap    |                                   width 14 is REAL format !!distanceFmt
    text .packing   |Max. Packing Dist.   |                                   width 14 is REAL format !!distanceFmt
    text .maxPack   |Max. Packing Overlap |                                   width 14 is REAL format !!distanceFmt
    text .trunnlen  |Max. Trunnion Length |                                   width 14 is REAL format !!distanceFmt
  exit

  vdist 0.3
  frame .hanger |Hangers| at x0 ymax
    para .pMaxPiva width 36 lines 1
    para .pMaxPwar width 36 lines 1
    text .pMinHangRod |Min. Rod Length      | width 14 is REAL format !!distanceFmt
    option .oHangerIface tagWidth 22 |Hanger Interface in Use| call |!!mdsOptions.changeHangerIface()| width 12
  exit

  path down
  vdist 0.1

  frame .misc |Miscellaneous| at xmax_sitet+1.5 y0
    para .pMaxAng at x1 y0.7 width 36 lines 1
    para .pSpecPre width 36 lines 1
    para .pSpecFla width 36 lines 1
    para .pTranPref width 36 lines 1
    para .pLevChange width 36 lines 1
    para .pPTranText width 16 lines 1
    para .pTranText at xmax ymin width 14 lines 2
  exit

  frame .setting |ID Settings| at xmax.hanger+1.5 ymax
    --para .pipe at x1 ymax+0.1 text |Pipework type:    |
    para .pipe at x1 y0.5 text |Pipework type:    |
    rgroup .ptype at xmax+0.5 ymin call |Call !!mdsSetPipe()|
    add tag |  Normal    |
    add tag |  Lined     |
  exit

  exit

  frame .connections |Steelwork Connection Details| at xmax.hanger+1.5 ymax
    option .createCons |Create       |   at x1 ymax call |!!mdsActiveConns(!!mdsOptions.createCons.selection())| width 20
    option .connMods |Modify Support         |   at x1 ymax call || width 10
    option .autoPads |Automatic Pads         |   at x1 ymax call || width 10
    text .offset |Joint Offset         | width 14 is REAL format !!distanceFmt
  exit

  --Button .default |Default| at x0 ymax+0.5 call |!load = ARRAY()
--!load.append('MDS')
  --Call !!mdsReadDefs(!!mdsOptions,!load)|

  button .default |Default| at x0 ymax form+0.5 call |!!mdsoptiondefs = object MDSOPTIONDEFS()|


  -- Button for !!mdsFlangeGaps

  button .flangeGaps |Flange Gaps...| call |Show !!mdsFlangeGaps free| at xmax+5 ymin

  button .compensationOptions 'Compensation Options...' width 17 callback 'show !!mdsdesCompensationOptions free' at xmax+4 ymin

-- Bottom Line
  button .cancel | Dismiss | at xmax form-size ymin ok

-- Form members
  member .structure  is STRING
  member .pipes      is STRING
  member .maxAng     is REAL
  member .maxPiva    is REAL
  member .maxPwar    is REAL
  member .minHangRod is REAL
  member .specPre is STRING
  member .tranPref is STRING
  member .tranText is STRING
  member .specFla is BOOLEAN
  member .levChange is REAL
  member .mdsuniquenames is BOOLEAN
  member .prevHangIface is STRING

-- End form definition
exit

---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- Constructor Method
-- .mdsOptions()
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
define method .mdsOptions()

-- If an error has occurred when loading the compensation defaults, disable the compensation options button
  !error = !!mdsCompplateDflts.loaderror
  if !error.set() then
    !this.compensationOptions.visible = FALSE
  endif

-- Populate gadgets
-- Creation Site Name
  !!mdsOptions.site.val = 'Not Set'
  !!mdsOptions.siteForHangers.val = 'Not Set'

  !!mdsOptions.slope.val = '1/10'

-- Piping setting
  Call !!mdsSetPipe()

-- populate CreateCons option

  !dstring = 'Without Connections\With Connections\With Geometry'
  !rString = '1\2\3'

  !dtext = !dstring.split('\')
  !rText = !rString.split('\')

  !!mdsOptions.createCons.dtext = !dtext
  !!mdsOptions.createCons.rText = !rText

-- populate ModsCon option

  !dstring = 'Warning\Error\Ignore'
  !rString = 'WARNING\ERROR\IGNORE'

  !dtext.clear()
  !rText.clear()
  !dtext = !dstring.split('\')
  !rText = !rString.split('\')

  !!mdsOptions.connMods.dtext = !dtext
  !!mdsOptions.connMods.rText = !rText

  !dstring = 'On\Off'
  !rString = 'ON\OFF'

  !dtext.clear()
  !rText.clear()
  !dtext = !dstring.split('\')
  !rText = !rString.split('\')

  !!mdsOptions.autoPads.dtext = !dtext
  !!mdsOptions.autoPads.rText = !rText

-- populate Project Hanger Interface
  !!mdsOptions.prevHangIface = ''
endmethod
------------------------------------------------------------------------
--
-- Method:      changeHangerIface()
--
-- Description: On change option callback - change active hanger interface to selected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeHangerIface()

  !val = !!mdsOptions.oHangerIface.selection()
  if (!!mdsOptions.prevHangIface.neq(!val)) then
    if !!mdsSwitchHangerIf(!val) then
      !this.prevHangIface = !val
    else
      --reinstate the previous interface because we could not change it
      !this.oHangerIface.select('RTEXT', !this.prevHangIface)
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: On show callback method - populates hanger interface option & selects current
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !!mdsoptiondefs.populateHangerIfaceOption()

  if (!this.oHangerIface.rText.size() neq 0) then
    !this.oHangerIface.select('RTEXT', !!mdsHangIf)
    handle ANY
    endhandle
  else
    !!mdsHangIf = ''
  endif

  -- Switch some gadgets off if no Admin
  !this.inactiveforuser()

endmethod

define method .save()

endmethod


------------------------------------------------------------------------
--
-- Method:      inactiveforuser()
--
-- Description: Switch some gadgets to inactive if user is not in DESADMIN team
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .inactiveforuser()

   !isAdmin = FALSE
   !sess = current session
   if !sess.user().string().eq('SYSTEM') then
      !isAdmin = TRUE
   else
      do !team values !sess.user().teamlist()
         if !team.string().eq('DESADMIN') then
            !isAdmin = TRUE
            break
         endif
      enddo
   endif

   if !isAdmin then
      !this.sitet.active       = TRUE
      !this.tol.active         = TRUE
      !this.hanger.active      = TRUE
      !this.misc.active        = TRUE
      !this.setting.active     = TRUE
      !this.connections.active = TRUE
   else
      !this.sitet.active       = TRUE
      !this.tol.active         = FALSE
      !this.hanger.active      = TRUE
      !this.misc.active        = FALSE
      !this.setting.active     = FALSE
      !this.connections.active = FALSE
   endif

endmethod
