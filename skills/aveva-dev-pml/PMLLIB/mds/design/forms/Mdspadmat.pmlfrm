--
-- File:		MdsPadMat.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		19 March 1998
--
--
-- Description:
-- Form Definition for selecting pad material
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Init(FORM)                       -
--  Set(FORM)                        -
--

-- Kill existing form definition
  kill !!MdsPadMat

-- Define Form
  setup form  !!MdsPadMat

    !!MdsPadMat.formtitle    = |Reinforcing Pad Material Selection|
    !!MdsPadMat.icontitle    = |PadMatl|
    !!MdsPadMat.callback     = ||
    !!MdsPadMat.formrevision = ||


-- Body of Form
    list .Items |Select Material:| at x1 y0.5 width 60 length 10

    path down
    vdist 1


-- Bottom Line
    button .OK     |   OK   | at x0 ymax call || ok

    path right

    button .Cancel | Cancel | at xmax form-8 cancel

  exit
-- End form definition

define method .Init(!Form is FORM)

  !CurrentUnits = !!KGetSetUnits()

-- Save db position

  !Origin = !!ce

-- We need to find the connecting type as so to collect either elbow or tube

  !!CE = !Form.Support.Datum

  bran
  goto href
  !Type = !!CE.type
  !ConnectedElement = !!CE
  !CurrentSpref = !!ce.spref
  !BranSpec = !Form.Support.datum.owner.owner.pspe

-- get all pipe specs

  !Worl  = object dbref()
  !Specs = !!kcollectAllFor('SPEC','purp eq |PIPE|',!Worl)

-- get all elbows or tube of correct bore

  !List = Array()
  !Desc = Array()
  !!CE = !ConnectedElement

  if !Type.eq('ELBO') then
    do !GetList values !specs
     !FoundItems = select spec $!GetList
     handle ANY
       skip
     endhandle
      do !Add values !FoundItems
        !List.Append(!Add.string())
        if !Add.eq(!CurrentSpref) then
          !Desc.append('(Parent Elbow) ' & (name of $!GetList) & ' '  & (rtext of detref) & ' ' & (xtex of matxt of $!Add))
        else
          !Desc.append('               ' & (name of $!GetList) & ' '  & (rtext of detref) & ' ' & (xtex of matxt of $!Add))
        endif
      enddo
    enddo
  else
    do !FoundSpecs values !Specs
      !!ce = !FoundSpecs
      !mem = mcount
      do !count from 1 to !mem
        $!Count
        if !!CE.type.eq('SELE') then
          if !!CE.tans.eq('TUBE') then
-- Find all spcoms for the tube selector
            var !Spcoms coll all spcom for ce
-- Loop through spcoms and get the correct bore
            !Bore = pa bore of $!ConnectedElement
            do !GetBore values !Spcoms
              !!CE = !GetBore.dbref()
--<wd>dec2002
              !Params = para of catref
              !testforbore = !Params[1].bore()
              handle (2,473)  $* NOMBORE: Nominal bore not found for this value
                skip
              endhandle
--<wd>dec2002
              if !Params[1].bore().eq(!Bore) then
                 !TubeDesc = rtext of detref
                 !TubeMatl = xtex of matxt
                 !List.Append(!GetBore.string())
                 if !FoundSpecs.eq(!BranSpec) then
                   !Desc.append('(Parent Pipe)' + !FoundSpecs.name & ' ' & !TubeDesc & ' ' & !TubeMatl)
                 else
                   !Desc.append('             ' + !FoundSpecs.name & ' ' & !TubeDesc & ' ' & !TubeMatl)
                 endif
              endif
            enddo
          endif
        endif
        spec
      enddo
    enddo
  endif

-- load the items into the form

  !!MdsPadMat.Items.clear()

  !!MdsPadMat.Items.Dtext = !Desc
  !!MdsPadMat.Items.Rtext = !List

-- Get current selection and select it

   !MtoRef = !Form.Support.Datum.MtoRef[1].String()
   handle ANY
   elsehandle NONE
     !This.Items.select('RTEXT','$!MtoRef')
   endhandle

-- set action for form

   !!KShowForm(!!MdsPadMat)

-- Modify OK callback to use correct calling form

   !!MdsPadMat.Ok.callback = '!!MdsPadMat.Set(!!$!Form)'

   !!CE = !Origin

-- Reset units back
  !!kRestoreUnits(!currentunits)

endmethod

define method .Set(!Form is FORM)

-- Navigate to branch and set hstu and all element to set lstu

  !!ce = !Form.support.datum
  !Selected = !!MdsPadMat.Items.Selection()
  mtoref $!Selected

endmethod

-- End of file MdsPadMat.frm
