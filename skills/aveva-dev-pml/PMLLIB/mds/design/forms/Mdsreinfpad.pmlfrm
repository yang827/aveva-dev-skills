--
-- Description:
-- HIDDEN Form Definition for General Ancillary Type Reinfpad and AT40* AT41*
--
--------------------------------------------------------------------------------
-- Define Form

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- This is a HIDDEN FORM from the USERS
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

  setup form  !!mdsreinfpad at xr0 yr0 noquit blocking

    !!mdsreinfpad.formtitle    = |Add Reinforcing Pad to: |
    !!mdsreinfpad.icontitle    = ||
    !!mdsreinfpad.Callback     = ||
    !!mdsreinfpad.formrevision = | $Revision: $ |

-- Get Type of Support Required
    rgroup .type | Select Type to Identify| at x0 y0 call || horizontal
      add tag ' Existing Shoe ' select 'SHOE'
      add tag ' Pipe Only '     select 'PIPE'
    exit

-- Bottom Line
    --button .cancel  | Cancel | at xmax form-size ymax+0.5 CANCEL
    button .ok      |   OK   | at xmin ymax+0.5 OK

  exit
-- End form definition

-- End of file Mdsreinfpad.pmlfrm
