--
-- File:		Mdsreports.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          REPORTER Driven MDS Reports Menu
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 31st August 1999
--
--
-- Description:
-- Form Definition for MDS Reports Menu
--
-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------
-- Methods Defined
--
-- [Mdsreports]     [constructor]
-- [init]            [form initialisation]
-----------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------
-- Define Form
    Setup Form  !!Mdsreports at xr0.3 yr0.07
    !!Mdsreports.formtitle = 'MDS Reports Menu'
    !!Mdsreports.icontitle = 'MDSREP'
    !!Mdsreports.callback  = '!!Mdsreports.init()'

--  MDS Report Creation
    frame .ftype ' Report Type '
      rgroup .type '' at x1 ymax call '!this.control(' vertical
        add tag ' Overall Support Index '     select '!this.overall()'
        add tag ' Bed Plate Index '           select '!this.bedplate()'
        add tag ' Support Index by AREACODE ' select '!this.areacode()'
        add tag ' ADP Support Index '         select '!this.adpindex()'
        add tag ' Support Index Summary '     select '!this.summary()'
      exit
    exit

    path down
    frame .farea ' Site, Zone... and Areacode '
      button .ce  | CE |      at x1 ymax+0.2 call |!this.ce()|
      text .gidnm |Name     | at x1 ymax+0.2 call |callib NAMECHK _Mdsreports_gidnm $$<$$_cdsysnam_case$$> $$<$$_cdsysnam_name$$> $$<$$> false| width 20 name
      text .areac |AreaCode | at x1 ymax+0.2 call |!this.callb()| width 8 is string
    exit

-- Bottom Line
    button .dismiss | Dismiss | at xmax form-size ymax+0.5  call ||  CANCEL
    button .apply   | Apply |   at x0             ymin  call  ''

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

-- End form definition
exit

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
   define method .init()

--Deactivate and Unset AREACODE Gadgets
     !this.gidnm.active = false
     !this.ce.active    = false
     !this.areac.active = false
     !this.gidnm.val    = 'unset'
     !this.areac.val    = 'unset'
     !this.farea.active = false

-- Set the callback on the .apply button at initialisation
     !this.control(!this.type,'SELECT')

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: mdsnames
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     FALSE if MDS UDAS do NOT Exist or TRUE if they do
------------------------------------------------------------------------
-- Define method
   define method .mdsnames() is BOOLEAN

-- Check if the MDS Uda's exist before proceeding
   !mdsudas = array()
--   !mdsudas[1] = ':areacode'
   !mdsudas[2] = ':MDSSuppType'
   !mdsudas[3] = ':MDSSuppDesc'
   !mdsudas[4] = ':MDSBpref1'
   !mdsudas[5] = ':MDSComment'
--   !mdsudas[6] = ':hold'

   !return = TRUE

   do !x values !mdsudas
     q uda $!x
     handle any
       !uda = !x
       !return = FALSE
       golabel /MDSUDAS
     endhandle
   enddo

-- Delete Global Variables
     if (defined(!!kmdb)) then
       !!kmdb.delete()
     endif
     if (defined(!!Mdsreplnames)) then
       !!Mdsreplnames.delete()
     endif
     if (defined(!!Mdsaltdnames)) then
       !!Mdsaltdnames.delete()
     endif

-- Read the MDS Replacement names into a global variable
     !Mdsreplreadf  = !!readfile('$!!MDSFILES.DESCRIPTION')
     !!Mdsreplnames = ARRAY()
     do !rname values !Mdsreplreadf
       skip if (!rname.trim().length().eq(0))
       skip if (!rname.match('#').gt(0))
       skip if (!rname.match('MDS').eq(1))
       !!Mdsreplnames.append(!rname)
     enddo

-- Read the MDS Alternate Replacement names into a global variable
     !Mdsaltdreadf  = !!readfile('$!!MDSFILES.ALTD')
     !!Mdsaltdnames = ARRAY()
     do !value values !Mdsaltdreadf
       skip if (!value.trim().length().eq(0))
       skip if (!value.match('#').gt(0))
       skip if (!value.match('\*').gt(0))
       !!Mdsaltdnames.append(!value)
     enddo

-- Check if the MDB Directory Exists, If NOT then create it
    !kproject = current project
    !kprjcode = !kproject.code()
    var !kinfodir evar $!<kprjcode>INFO
    if (!!nt) then
      !!delim = '\'
    else
      !!delim = '/'
    endif
--
    !infobj = object file (!kinfodir)
    if (!infobj.unset()) then
      var !kprjdir evar '$!<kprjcode>000'
      !kprjdir  = !kprjdir.substring(-7)
      !kinfodir = !kprjdir & !kprjcode & 'INFO'
      !infobj   = object file (!kinfodir)
      if (!infobj.exists().not()) then
        syscom 'mkdir $!<kinfodir>'
      endif
    endif
--
    !kprjinforepdir = !kinfodir + !!delim + 'REPORTS' + !!delim + 'MDS'
    !repobj  = object file (!kprjinforepdir)
    if (!repobj.exists().not()) then
      if (!!nt) then
        syscom 'mkdir $!<kprjinforepdir>'
      endif
    endif
    !session = current session
    !kmdb    = !session.mdb().name.after('/')

    !!kmdbdir = !kprjinforepdir + !!delim + !kmdb
    !kmdbobj = object file(!!kmdbdir)
    if (!kmdbobj.exists().not()) then
      if (!!nt) then
        syscom 'mkdir $!!<kmdbdir>'
      else
        syscom 'mkdir -p $!!<kmdbdir>'
      endif
    endif

-- Set Variable for the Date Time Stamp
    !dtc   = object datetime()
    !!kdts = !dtc.date() & '-' & !dtc.monthstring() & '-' & !dtc.year() & '+' & !dtc.hour() & '-' & !dtc.minute() & '-' & !dtc.second()

-- Return Boolean
    return $!return

-- MDS Udas Not Available Label
    label /MDSUDAS
    !!alert.error('The MDS Application UDAs do NOT exist eg: ''$!uda''. Aborting the Generation of the selected MDS Report.
Contact your PDMS System Administrator.')
    return $!return


   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: control
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
   define method .control(!object is GADGET, !action is STRING)

-- Set the callback on the .apply button when selecting the MDS REPORT type
     if (!action eq 'SELECT') then
       !form   = !object.owner()
       !type   = !object.type()
       !name   = !object.name()
       !select = !object.selection()

       if (!select.eq('!this.areacode()')) then
--Activate AREACODE Gadgets
         !this.farea.active = true
         !this.ce.active    = true
         !this.gidnm.active = true
         !this.areac.active = true
         !this.gidnm.val    = 'unset'
         !this.areac.val    = 'unset'
       else
--Deactivate and Unset AREACODE Gadgets
         !this.farea.active = false
         !this.ce.active    = false
         !this.gidnm.active = false
         !this.areac.active = false
         !this.gidnm.val    = 'unset'
         !this.areac.val    = 'unset'
       endif

       !form.apply.callback = !select

--       !!alert.warning('You have SELECTED $!<form>.$!<name> $!type - Button selection $!select')
--        !!alert.warning('You have SET the APPLY callback to ''$!select''')

       !currprj      = current project
       !project      = !currprj.code()
--       !!kprojrepdir = '%$!<project>REP%'
     endif

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: callb
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .callb()

-- Set the Areacode Gadget if an empty value is entered and Remove all Spaces
     !this.areac.val = !this.areac.val.trim()
     !this.areac.val = !this.areac.val.replace(' ','')
     if (!this.areac.val.eq('')) then
       !this.areac.val = 'unset'
     endif

   endmethod
-- End of method definition
----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method: kcolvars
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .kcolvars()

-- Reset the !!kcol<#> REPORT Column Variables to ZERO
   !!kcol1  = 0
   !!kcol2  = 0
   !!kcol3  = 0
   !!kcol4  = 0
   !!kcol5  = 0
   !!kcol6  = 0
   !!kcol7  = 0
   !!kcol8  = 0
   !!kcol9  = 0
   !!kcol10 = 0

   endmethod
-- End of method definition
----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: ce
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .ce()

-- Select the Current Element
     !this.gidnm.val = !!ce.name

-- Set the Areacode of the Current Element
     !this.areac.val = !!ce.:areacode
     handle any
     endhandle

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: overall
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .overall()

-- Check if MDS Udas Exist
     if (!this.mdsnames().not()) then
       return
     endif

-- Warn User
     if (!!alert.confirm('This Report Type will search the whole of the current MDB, which may take some time. Do you wish to Continue?') eq 'NO') then
       return
     endif

     !this.kcolvars()

-- Create the Overall Support Index for MDS Supports and MDS BedPlates
     --$M/$!!kprojrepdir/Mdsoverall.tmp
     !ovfile = !!pml.getpathname('Mdsoverall.pmlfnc')
     $M/$!ovfile

-- Edit the Report Generated by the above REPORT template
-- to reflect the Project Settings etc. in the MDS Default Files
-- 1) $!!<kmdbdir>$!<!!delim>MDS-OAINDEX1-$!!<kdts>

     !index1 = !!readfile('$!!<kmdbdir>$!!<delim>MDS-OAINDEX1-$!!<kdts>')

-- Rebuild Line for BedPlate Supports Onlyz
     !units = object COMUNITS(TRUE)
     do !val index !index1
       !sval = !index1[!val].split()
         handle any
           skip
         endhandle
       !mval = '/' & !sval[1]
         handle any
           skip
         endhandle
       !oval = '/' & !sval[3]
         handle any
           skip
         endhandle
       !mtest = !mval.dbref()
         handle (2,109)
           skip
         endhandle
       !otest = !oval.dbref()
         handle (2,109)
           skip
         endhandle
       skip if !mval.dbref().type.neq('STRU')
       if (!mval.dbref().type.eq('STRU') and !oval.dbref().type.eq('SITE')) then
         !mtyp = !mval.dbref().:MDSSuppType
         !mdes = 'See BedPlate Index'
         if (!mtyp.length().eq(0) or !mtyp.unset()) then
           !mtyp = 'UnKnown'
           !mdes = 'UnKnown Type of BedPlate'
         endif
-- Determine Existing Column Widths of the FIRST Report
         !wid1 = !!kcol2 - 2
         !wid2 = !!kcol3 - !!kcol2
         !wid3 = !!kcol4 - !!kcol3 - 2
         !wid4 = !!kcol5 - !!kcol4
         !wid5 = !!kcol6 - !!kcol5
         !wid6 = !!kcol7 - !!kcol6

-- MODIFY the lines for any BED PLATES found in the FIRST Report
         var !line compose spa 2 ('$!sval[1]') wid $!wid1 ('$!mtyp') wid $!wid2 ('---') wid $!<wid3> R  spa 2 ('BEDPLATE') wid $!wid4 ('---') wid $!wid5 ('---') wid $!wid6 ('$!mdes') wid 25

         !index1[$!val] = !line[1]
       else
         skip
       endif
     enddo
     if (defined(!!kindex)) then
       !!kindex.delete()
     endif
     !!kindex = !index1

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Modify ALL LINES in the OVERALL Report to REFLECT the DATA stored in :-
------------------------------------------------------------------------
-- (a) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsaltdnames'
------------------------------------------------------------------------
------------------------------------------------------------------------
-- (b) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsreplnames'
------------------------------------------------------------------------

-- Get the Alternative STANDARD Name ONLY
     !!kcol10 = !index1.width()
     !index2  = ARRAY()
-- Declare 7 arrays for the 7 columns in the report to store the data
     !arr1 = ARRAY()
     !arr2 = ARRAY()
     !arr3 = ARRAY()
     !arr4 = ARRAY()
     !arr5 = ARRAY()
     !arr6 = ARRAY()
     !arr7 = ARRAY()
     do !andx index !index1
-- Set the Values for the First Page Heading and Last Page Footer
       if (!index1[!andx].match('???').eq(1)) then
         !ival1 = !index1[!andx]
         !ival2 = ''
         !ival3 = ''
         !ival4 = ''
         !ival5 = ''
         !ival6 = ''
         !ival7 = ''
       else
-- Set the values for each column heading
         !ival1 = !index1[!andx].substring(!!kcol1,(!!kcol2 - !!kcol1)).trim()
         !ival2 = !index1[!andx].substring(!!kcol2,(!!kcol3 - !!kcol2)).trim()
         !ival3 = !index1[!andx].substring(!!kcol3,(!!kcol4 - !!kcol3)).trim()
         !ival4 = !index1[!andx].substring(!!kcol4,(!!kcol5 - !!kcol4)).trim()
         !ival5 = !index1[!andx].substring(!!kcol5,(!!kcol6 - !!kcol5)).trim()
         !ival6 = !index1[!andx].substring(!!kcol6,(!!kcol7 - !!kcol6)).trim()
         !ival7 = !index1[!andx].substring(!!kcol7).trim()
       endif

-- Append Current Values to Each Array
       !arr1[!andx] = !ival1
       !arr2[!andx] = !ival2
       !arr3[!andx] = !ival3
       !arr4[!andx] = !ival4
       !arr5[!andx] = !ival5
       !arr6[!andx] = !ival6
       !arr7[!andx] = !ival7
----------------------------------------------------------------
-- Alternative Names ONLY Apply to STRUCTURAL FRAMEWORK SUPPORTS
-- Remove Size Code(ie. FT09-1-4.12 where '.12' is the Size Code) and Substitute Alternative STANDARD
       !inumb = 0
       !ital2 = !ival2.trim().before('.')
       !altn2 = false
       do !aval values !!Mdsaltdnames
         if (!ival2.match('FT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('CT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('DT').eq(1)) then
           !inumb = !inumb + 1
         endif
         skip if (!inumb.eq(0))
         skip if (!aval.match(!ital2).neq(1))
         !alin  = !aval.split('\')
         !altn  = !alin[2].trim()
         skip if !altn.eq('*')
         !arr2[!andx] = !altn
         !altn2 = true
       enddo
----------------------------------------------------------------
-- Determine the REPLACEMENT 'Standard'(!ival2) and 'Description'(!ival4)
       do !rval values !!Mdsreplnames
         !rval1 = !rval.part(1,'\').trim()
         !rval2 = !rval.part(2,'\').trim()
         !rval3 = !rval.part(3,'\').trim()

         if (!ival2.match(!rval1).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
               !arr2[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr4[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr4[!andx] = !rval3.after('-','')
             else
               !arr4[!andx] = !rval3
            endif
            !arr4[!andx] = !arr4[!andx].replace(|'|,|''|)
           endif
-- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
         elseif (!ival2.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
              !arr2[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr4[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr4[!andx] = !rval3.after('-','')
             else
               !arr4[!andx] = !rval3
            endif
            !arr4[!andx] = !arr4[!andx].replace(|'|,|''|)
           endif
         endif
       enddo
     enddo
----------------------------------------------------------------

-- COMPOSE the FINAL Report Array '!index3' from the 8 other arrays
--
-- Unable to use the '.width()' method because the FIRST LINE  of the HEADING has SEVERAL MORE characters
--     !wid1 = !arr1.width()
--
     !wid1 = 0
     do !xwid values !arr1
       if (!xwid.match('???').eq(1)) then
         skip
       else
         !dwid1 = !xwid.length()
       endif
       if (!dwid1.gt(!wid1)) then
         !wid1 = !dwid1
       endif
     enddo
     if (!wid1.lt(4)) then
       !wid1 = 4
     endif
     !wid2 = !arr2.width()
     !wid3 = !arr3.width()
     !wid4 = !arr4.width()
     !wid5 = !arr5.width()
     !wid6 = !arr6.width()
     !wid7 = !arr7.width()

     do !fx indices !arr1
       if (!arr1[!fx].match('???').eq(1)) then
         !index2[!fx] = !arr1[!fx].after('???')
       elseif (!arr1[!fx].trim().length().eq(0)) then
         !index2[!fx] = ''
       else
         var !nlin compose spa 2 ('$!arr1[$!fx]') wid $!wid1 spa 2 ('$!arr2[$!fx]') wid $!wid2 spa 2 ('$!arr3[$!fx]') wid $!wid3 R  spa 2 ('$!arr4[$!fx]') wid $!wid4 spa 2 ('$!arr5[$!fx]') wid $!wid5 spa 2 ('$!arr6[$!fx]') wid $!wid6 spa 2 ('$!arr7[$!fx]') wid $!wid7
         !index2[!fx] = !nlin[1]
       endif
     enddo

------------------------------------------------------------------------
------------------------------------------------------------------------


------------------------------------------------------------------------
------------------------------------------------------------------------

-- Write the FINAL Report File for a 'MDS Overall Support Index'
     !!writefile('$!!<kmdbdir>$!!<delim>MDS-OVERALL-INDEX-$!!<kdts>' , 'WRITE', !index2)

------------------------------------------------------------------------
------------------------------------------------------------------------

-- Delete the Temporary File
     !fileobj1 = object file ('$!!<kmdbdir>$!!<delim>MDS-OAINDEX1-$!!<kdts>')
     !fileobj1.deletefile()

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: bedplate
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .bedplate()

     !this.kcolvars()
     if (!this.mdsnames().not()) then
       return
     endif

-- Create the BedPlate Support Index for the MDS BedPlates
     --$M/$!!kprojrepdir/Mdsbp.tmp
     !bpfile = !!pml.getpathname('Mdsbp.pmlfnc')
     $M/$!bpfile

-- Edit the Report Generated by the above REPORT template
-- to reflect the Project Settings etc. in the MDS Default Files
-- 1) $!!<kmdbdir>$!<!!delim>MDS-BPINDEX1-$!!<kdts>

     !index1 = !!readfile('$!!<kmdbdir>$!!<delim>MDS-BPINDEX1-$!!<kdts>')

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Modify ALL LINES in the BEDPLATE Report to REFLECT the DATA stored in :-
------------------------------------------------------------------------
-- (a) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsaltdnames'
------------------------------------------------------------------------
------------------------------------------------------------------------
-- (b) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsreplnames'
------------------------------------------------------------------------
-- Get the Alternative STANDARD Name ONLY
     !index2 = ARRAY()
-- Declare all arrays for the columns in the report to store the data
     !arr1 = ARRAY()
     !arr2 = ARRAY()
     !arr3 = ARRAY()
     !arr4 = ARRAY()
     !arr5 = ARRAY()
     !arr6 = ARRAY()
     do !andx index !index1
-- Set the Values for the First Page Heading and Last Page Footer
       if (!index1[!andx].match('???').eq(1)) then
         !ival1 = !index1[!andx]
         !ival2 = ''
         !ival3 = ''
         !ival4 = ''
         !ival5 = ''
         !ival6 = ''
       else
-- Set the values for each column heading
         !ival1 = !index1[!andx].substring(!!kcol1,(!!kcol2 - !!kcol1)).trim()
         !ival2 = !index1[!andx].substring(!!kcol2,(!!kcol3 - !!kcol2)).trim()
         !ival3 = !index1[!andx].substring(!!kcol3,(!!kcol4 - !!kcol3)).trim()
         !ival4 = !index1[!andx].substring(!!kcol4,(!!kcol5 - !!kcol4)).trim()
         !ival5 = !index1[!andx].substring(!!kcol5,(!!kcol6 - !!kcol5)).trim()
         !ival6 = !index1[!andx].substring(!!kcol6).trim()
         if (!ival6.eq('')) then
           !ival6 = 'unset'
         endif
       endif

-- Append Current Values to Each Array
       !arr1[!andx] = !ival1
       !arr2[!andx] = !ival2
       !arr3[!andx] = !ival3
       !arr4[!andx] = !ival4
       !arr5[!andx] = !ival5
       !arr6[!andx] = !ival6

----------------------------------------------------------------
       !altn2 = false
       !altn4 = false

----------------------------------------------------------------
$(
----------------------------------------------------------------
 UNABLE TO GET ALTERNATE NAMES for BEDPLATES etc.
 Therefore LINES 704 to 744 inclusive are NOT REQUIREDa for BEDPLATES
----------------------------------------------------------------

-- Alternative Names ONLY Apply to STRUCTURAL FRAMEWORK SUPPORTS
-- Remove Size Code(ie. FT09-1-4.12 where '.12' is the Size Code) and Substitute Alternative STANDARD
       !inumb = 0
       !ital2 = !ival2.trim().before('.')
       !altn2 = false
       do !bval values !!Mdsaltdnames
         if (!ival2.match('FT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('CT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('DT').eq(1)) then
           !inumb = !inumb + 1
         endif
         skip if (!inumb.eq(0))
         skip if (!bval.match(!ital2).neq(1))
         !alin  = !bval.split('\')
         !altn  = !alin[2].trim()
         skip if !altn.eq('*')
         !arr2[!andx] = !altn
         !altn2 = true
       enddo

       !inumb = 0
       !ital4 = !ival4.trim().before('.')
       !altn4 = false
       do !aval values !!Mdsaltdnames
         if (!ival4.match('FT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival4.match('CT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival4.match('DT').eq(1)) then
           !inumb = !inumb + 1
         endif
         skip if (!inumb.eq(0))
         skip if (!aval.match(!ital4).neq(1))
         !alin  = !aval.split('\')
         !altn  = !alin[2].trim()
         skip if !altn.eq('*')
         !arr4[!andx] = !altn
         !altn4 = true
       enddo

----------------------------------------------------------------
$)
----------------------------------------------------------------

----------------------------------------------------------------
-- Determine the REPLACEMENT 'Standard'( !ival2 and !ival4) and 'Description'(!ival6 for !ival4 ONLY)
       do !rval values !!Mdsreplnames
         !rval1 = !rval.part(1,'\').trim()
         !rval2 = !rval.part(2,'\').trim()
         !rval3 = !rval.part(3,'\').trim()

-- Replace Column 2 (!ival2) with the REPLACEMENT STANDARD
         if (!ival2.match(!rval1).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
               !arr2[!andx] = !rval1
             endif
           endif
-- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
         elseif (!ival2.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
              !arr2[!andx] = !rval1
             endif
           endif
         endif

-- Replace Column 4 (!ival4) with the REPLACEMENT STANDARD
         if (!ival4.match(!rval1).eq(1)) then
           if (!altn4.not()) then
             if (!rval2.empty().not()) then
               !arr4[!andx] = !rval2
             else
               !arr4[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr6[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr6[!andx] = !rval3.after('-','')
             else
               !arr6[!andx] = !rval3
             endif
             !arr6[!andx] = !arr6[!andx].replace(|'|,|''|)
           endif
-- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
         elseif (!ival4.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
           if (!altn4.not()) then
             if (!rval2.empty().not()) then
               !arr4[!andx] = !rval2
             else
              !arr4[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr6[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr6[!andx] = !rval3.after('-','')
             else
               !arr6[!andx] = !rval3
             endif
             !arr6[!andx] = !arr6[!andx].replace(|'|,|''|)
           endif
         endif
       enddo
     enddo
----------------------------------------------------------------

-- COMPOSE the FINAL Report Array '!index2' from the other arrays
--
-- Unable to use the '.width()' method because the FIRST LINE  of the HEADING has SEVERAL MORE characters
--     !wid1 = !arr1.width()
--
     !wid1 = 0
     do !xwid values !arr1
       if (!xwid.match('???').eq(1)) then
         skip
       else
         !dwid1 = !xwid.length()
       endif
       if (!dwid1.gt(!wid1)) then
         !wid1 = !dwid1
       endif
     enddo
     if (!wid1.lt(14)) then
       !wid1 = 14
     endif
     !wid2 = !arr2.width()
     !wid3 = !arr3.width()
     !wid4 = !arr4.width()
     !wid5 = !arr5.width()
     !wid6 = !arr6.width()

     do !fx indices !arr1
       if (!arr1[!fx].match('???').eq(1)) then
         !index2[!fx] = !arr1[!fx].after('???')
       elseif (!arr1[!fx].trim().length().eq(0)) then
         !index2[!fx] = ''
       else
         var !nlin compose spa 2 ('$!arr1[$!fx]') wid $!wid1 spa 2 ('$!arr2[$!fx]') wid $!wid2 spa 2 ('$!arr3[$!fx]') wid $!wid3 spa 2 ('$!arr4[$!fx]') wid $!wid4 spa 2 ('$!arr5[$!fx]') wid $!wid5 spa 2 ('$!arr6[$!fx]') wid $!wid6
         !index2[!fx] = !nlin[1]
       endif
     enddo

------------------------------------------------------------------------
------------------------------------------------------------------------


------------------------------------------------------------------------
------------------------------------------------------------------------

-- Write the FINAL Report File for a 'MDS Bedplate Support Index'
     !!writefile('$!!<kmdbdir>$!!<delim>MDS-BEDPLATE-INDEX-$!!<kdts>' , 'WRITE', !index2)

------------------------------------------------------------------------
------------------------------------------------------------------------

-- Delete the Temporary File
     !fileobj1 = object file ('$!!<kmdbdir>$!!<delim>MDS-BPINDEX1-$!!<kdts>')
     !fileobj1.deletefile()
------------------------------------------------------------------------
------------------------------------------------------------------------


   endmethod
-- End of method definition


----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: areacode
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .areacode()


     !this.kcolvars()
     if (!this.mdsnames().not()) then
       return
     endif

-- Ensure a valid PDMS Element has been entered
     if (!this.gidnm.val.eq('unset')) then
       if (!!alert.confirm('The PDMS Element is set set to ''unset''. This will select from the whole of the MDB. Do you wish to continue?') eq 'NO') then
         return
       else
         !!Mdsreports.gidnm.val = ''
       endif
-- Ensure a DESIGN Database Element has been Entered
     elseif (!this.gidnm.val.dbref().dbtype.neq('DESI')) then
       !!alert.error('The selected PDMS Element Name MUST belong to a DESIGN database. Aborting the Generation of the MDS Support Index by AREACODE.')
       return
     endif
-- Check if user wants to continue with the AreaCode set to 'unset'
     if (!this.areac.val.eq('unset') or !this.areac.val.eq('')) then
       if (!!alert.confirm('The AreaCode is set to ''unset''. Do you wish to continue?') eq 'NO') then
         return
       endif
     endif
-- Create the :Areacode Support Index for the MDS Supports
     --$M/$!!kprojrepdir/Mdsareacode.tmp
     !acfile = !!pml.getpathname('Mdsareacode.pmlfnc')
     $M/$!acfile

-- Reset PDMS Element gadget to 'unset'
     if (!!Mdsreports.gidnm.val.eq('')) then
       !!Mdsreports.gidnm.val = 'unset'
     endif

     !index1 = !!readfile('$!!<kmdbdir>$!!<delim>MDS-AREACODE1-$!!<Mdsreports.areac.val>-$!!<kdts>')

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Modify ALL LINES in the AREACODE Report to REFLECT the DATA stored in :-
------------------------------------------------------------------------
-- (a) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsaltdnames'
------------------------------------------------------------------------
------------------------------------------------------------------------
-- (b) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsreplnames'
------------------------------------------------------------------------

-- Get the Alternative STANDARD Name ONLY
     !!kcol10 = !index1.width()
     !index2  = ARRAY()
-- Declare 9 arrays for the 9 columns in the report to store the data
     !arr1 = ARRAY()
     !arr2 = ARRAY()
     !arr3 = ARRAY()
     !arr4 = ARRAY()
     !arr5 = ARRAY()
     !arr6 = ARRAY()
     !arr7 = ARRAY()
     !arr8 = ARRAY()
     !arr9 = ARRAY()
     do !andx index !index1
-- Set the Values for the First Page Heading and Last Page Footer
       if (!index1[!andx].match('???').eq(1)) then
         !ival1 = !index1[!andx]
         !ival2 = ''
         !ival3 = ''
         !ival4 = ''
         !ival5 = ''
         !ival6 = ''
         !ival7 = ''
         !ival8 = ''
         !ival9 = ''
       else
-- Set the values for each column heading
         !ival1 = !index1[!andx].substring(!!kcol1,(!!kcol2 - !!kcol1)).trim()
         !ival2 = !index1[!andx].substring(!!kcol2,(!!kcol3 - !!kcol2)).trim()
         !ival3 = !index1[!andx].substring(!!kcol3,(!!kcol4 - !!kcol3)).trim()
         !ival4 = !index1[!andx].substring(!!kcol4,(!!kcol5 - !!kcol4)).trim()
         !ival5 = !index1[!andx].substring(!!kcol5,(!!kcol6 - !!kcol5)).trim()
         !ival6 = !index1[!andx].substring(!!kcol6,(!!kcol7 - !!kcol6)).trim()
         !ival7 = !index1[!andx].substring(!!kcol7,(!!kcol8 - !!kcol7)).trim()
         !ival8 = !index1[!andx].substring(!!kcol8,(!!kcol9 - !!kcol8)).trim()
         !ival9 = !index1[!andx].substring(!!kcol9).trim()
       endif

-- Append Current Values to Each Array
       !arr1[!andx] = !ival1
       !arr2[!andx] = !ival2
       !arr3[!andx] = !ival3
       !arr4[!andx] = !ival4
       !arr5[!andx] = !ival5
       !arr6[!andx] = !ival6
       !arr7[!andx] = !ival7
       !arr8[!andx] = !ival8
       !arr9[!andx] = !ival9
-- Substitute values for columns 7(ISPEC) and 9(HOLD)
       if (!arr7[!andx].eq('=0/0')) then
          !arr7[!andx] = 'unset'
       endif
       if (!arr9[!andx].eq('false')) then
          !arr9[!andx] = 'NO'
       elseif (!arr9[!andx].eq('true')) then
          !arr9[!andx] = 'YES'
       endif
----------------------------------------------------------------
-- Alternative Names ONLY Apply to STRUCTURAL FRAMEWORK SUPPORTS
-- Remove Size Code(ie. FT09-1-4.12 where '.12' is the Size Code) and Substitute Alternative STANDARD
       !inumb = 0
       !ital2 = !ival2.trim().before('.')
       !altn2 = false
       do !aval values !!Mdsaltdnames
         if (!ival2.match('FT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('CT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival2.match('DT').eq(1)) then
           !inumb = !inumb + 1
         endif
         skip if (!inumb.eq(0))
         skip if (!aval.match(!ital2).neq(1))
         !alin  = !aval.split('\')
         !altn  = !alin[2].trim()
         skip if !altn.eq('*')
         !arr2[!andx] = !altn
         !altn2 = true
       enddo
----------------------------------------------------------------
-- Determine the REPLACEMENT 'Standard'(!ival2) and 'Description'(!ival4)
       do !rval values !!Mdsreplnames
         !rval1 = !rval.part(1,'\').trim()
         !rval2 = !rval.part(2,'\').trim()
         !rval3 = !rval.part(3,'\').trim()

         if (!ival2.match(!rval1).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
               !arr2[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr4[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr4[!andx] = !rval3.after('-','')
             else
               !arr4[!andx] = !rval3
            endif
            !arr4[!andx] = !arr4[!andx].replace(|'|,|''|)
           endif
-- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
         elseif (!ival2.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
           if (!altn2.not()) then
             if (!rval2.empty().not()) then
               !arr2[!andx] = !rval2
             else
              !arr2[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr4[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr4[!andx] = !rval3.after('-','')
             else
               !arr4[!andx] = !rval3
            endif
            !arr4[!andx] = !arr4[!andx].replace(|'|,|''|)
           endif
         endif
       enddo
     enddo
----------------------------------------------------------------

-- COMPOSE the FINAL Report Array '!index3' from the 8 other arrays
--
-- Unable to use the '.width()' method because the FIRST LINE  of the HEADING has SEVERAL MORE characters
--     !wid1 = !arr1.width()
--
     !wid1 = 0
     do !xwid values !arr1
       if (!xwid.match('???').eq(1)) then
         skip
       else
         !dwid1 = !xwid.length()
       endif
       if (!dwid1.gt(!wid1)) then
         !wid1 = !dwid1
       endif
     enddo
     if (!wid1.lt(4)) then
       !wid1 = 4
     endif
     !wid2 = !arr2.width()
     !wid3 = !arr3.width()
     !wid4 = !arr4.width()
     !wid5 = !arr5.width()
     !wid6 = !arr6.width()
     !wid7 = !arr7.width()
     !wid8 = !arr8.width()
     !wid9 = !arr9.width()

     do !fx indices !arr1
       if (!arr1[!fx].match('???').eq(1)) then
         !index2[!fx] = !arr1[!fx].after('???')
       elseif (!arr1[!fx].trim().length().eq(0)) then
         !index2[!fx] = ''
       else
         var !nlin compose spa 2 ('$!arr1[$!fx]') wid $!wid1 spa 2 ('$!arr2[$!fx]') wid $!wid2 spa 2 ('$!arr3[$!fx]') wid $!wid3 R  spa 2 ('$!arr4[$!fx]') wid $!wid4 spa 2 ('$!arr5[$!fx]') wid $!wid5 spa 2 ('$!arr6[$!fx]') wid $!wid6 spa 2 ('$!arr7[$!fx]') wid $!wid7 spa 2 ('$!arr8[$!fx]') wid $!wid8 spa 2 ('$!arr9[$!fx]') wid $!wid9
         !index2[!fx] = !nlin[1]
       endif
     enddo

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Write the FINAL REPORT for a 'MDS SUPPORTS by PDMS GID and/or AREACODE ' File
     !!writefile('$!!<kmdbdir>$!!<delim>MDS-AREACODE-$!!<Mdsreports.areac.val>-$!!<kdts>' , 'WRITE', !index2)

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Delete the Temporary File
     !fileobj1 = object file ('$!!<kmdbdir>$!!<delim>MDS-AREACODE1-$!!<Mdsreports.areac.val>-$!!<kdts>')
     !fileobj1.deletefile()

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: adpindex
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .adpindex()

     !this.kcolvars()
     if (!this.mdsnames().not()) then
       return
     endif

-- Check if Any DRAFT databases can be read from within the CURRENT Module(eg. DESIGN )
     !sess = current session
     !mdb  = !sess.mdb().name
     !mdbs = mdbs
     do !indx index !mdbs
       skip if (!mdbs[!indx].name.neq(!mdb))
       !dbs = !mdbs[!indx].current()
       !mod = !mdbs[!indx].mode()
       !numb = 0
       do !dbtyp index !dbs
         skip if (!dbs[!dbtyp].type.neq('PADD'))
------------
------------
-- This CODE is NOT WORKING because ALL the DB modes are SET to either 'R' or 'RW' in the '!mod' variable,
-- even when the DRAFT databases have an access of 'N'(None) from DESIGN.
--         skip if (!mod[!dbtyp].match('N').eq(1))
------------
-- Therefore attempt to access the ADP Department for MDS
-- Try to navigate to the DRAFT - ADP Dept. for MDS Drawings
         !curr = !!ce
         /MDS-Drawings-Department
         handle (2,109) $* Undefined name
           skip
         elsehandle none
           if (!!ce.type.neq('DEPT')) then
             !!ce = !curr
             skip
           endif
         endhandle
         !!ce = !curr
------------
------------
         !numb = !numb + 1
       enddo
     enddo
     if (!numb.eq(0)) then
       !!alert.error('Unable to find any MDS drawings. Aborting the Generation of the MDS ADP Support Index.')
       return
     endif

-- Create an ADP Index
     --$M/$!!kprojrepdir/Mdsadp.tmp
     !adpfile = !!pml.getpathname('Mdsadp.pmlfnc')
     $M/$!adpfile

   endmethod
-- End of method definition

----------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: summary
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
   define method .summary()

     !this.kcolvars()
     if (!this.mdsnames().not()) then
       return
     endif

-- Create an ADP Index
     --$M/$!!kprojrepdir/Mdssummary.tmp
     !sumfile = !!pml.getpathname('Mdssummary.pmlfnc')
     $M/$!sumfile

     !index1 = !!readfile('$!!<kmdbdir>$!!<delim>MDS-SUMMARY1-$!!<kdts>')

------------------------------------------------------------------------
------------------------------------------------------------------------
-- Modify ALL LINES in the FIRST Report to REFLECT the DATA stored in :-
------------------------------------------------------------------------
-- (a) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsaltdnames'
------------------------------------------------------------------------
------------------------------------------------------------------------
-- (b) The Default File - Alternative Support Names
--     Currently Stored in the Global Variable Array '!!Mdsreplnames'
------------------------------------------------------------------------

-- Get the Alternative STANDARD Name ONLY
     !index2  = ARRAY()
-- Declare the arrays for all the columns in the report to store the data
     !arr1 = ARRAY()
     !arr2 = ARRAY()
     !arr3 = ARRAY()
     !arr4 = ARRAY()
     !arr5 = ARRAY()
     do !andx index !index1
-- Set the Values for the First Page Heading and Last Page Footer
       if (!index1[!andx].match('???').eq(1)) then
         !ival1 = !index1[!andx]
         !ival2 = ''
         !ival3 = ''
         !ival4 = ''
         !ival5 = ''
       else
-- Set the values for each column heading
         !ival1 = !index1[!andx].substring(!!kcol1,(!!kcol2 - !!kcol1)).trim()
         !ival2 = !index1[!andx].substring(!!kcol2,(!!kcol3 - !!kcol2)).trim()
         !ival3 = !index1[!andx].substring(!!kcol3,(!!kcol4 - !!kcol3)).trim()
         !ival4 = !index1[!andx].substring(!!kcol4,(!!kcol5 - !!kcol4)).trim()
         !ival5 = !index1[!andx].substring(!!kcol5).trim()
       endif

-- Append Current Values to Each Array
       !arr1[!andx] = !ival1
       !arr2[!andx] = !ival2
       !arr3[!andx] = !ival3
       !arr4[!andx] = !ival4
       !arr5[!andx] = !ival5
----------------------------------------------------------------
-- Alternative Names ONLY Apply to STRUCTURAL FRAMEWORK SUPPORTS
-- Remove Size Code(ie. FT09-1-4.12 where '.12' is the Size Code) and Substitute Alternative STANDARD
       !inumb = 0
       !ital1 = !ival1.trim().before('.')
       !altn1 = false
       do !aval values !!Mdsaltdnames
         if (!ival1.match('FT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival1.match('CT').eq(1)) then
           !inumb = !inumb + 1
         elseif (!ival1.match('DT').eq(1)) then
           !inumb = !inumb + 1
         endif
         skip if (!inumb.eq(0))
         skip if (!aval.match(!ital1).neq(1))
         !alin  = !aval.split('\')
         !altn  = !alin[2].trim()
         skip if !altn.eq('*')
         !arr1[!andx] = !altn
         !altn1 = true
       enddo
----------------------------------------------------------------
-- Determine the REPLACEMENT 'Standard'(!ival2) and 'Description'(!ival4)
       do !rval values !!Mdsreplnames
         !rval1 = !rval.part(1,'\').trim()
         !rval2 = !rval.part(2,'\').trim()
         !rval3 = !rval.part(3,'\').trim()

         if (!ival1.match(!rval1).eq(1)) then
           if (!altn1.not()) then
             if (!rval2.empty().not()) then
               !arr1[!andx] = !rval2
             else
               !arr1[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr3[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr3[!andx] = !rval3.after('-','')
             else
               !arr3[!andx] = !rval3
            endif
            !arr3[!andx] = !arr3[!andx].replace(|'|,|''|)
           endif
-- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
         elseif (!ival1.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
           if (!altn1.not()) then
             if (!rval2.empty().not()) then
               !arr1[!andx] = !rval2
             else
              !arr1[!andx] = !rval1
             endif
           endif
           if (!rval3.neq('')) then
             if (!rval3.match('- ').eq(1)) then
               !arr3[!andx] = !rval3.after('- ')
             elseif (!rval3.match('-').eq(1)) then
               !arr3[!andx] = !rval3.after('-','')
             else
               !arr3[!andx] = !rval3
            endif
            !arr3[!andx] = !arr3[!andx].replace(|'|,|''|)
           endif
         endif
       enddo
     enddo
----------------------------------------------------------------

-- COMPOSE the FINAL Report Array '!index3' from the 8 other arrays
--
-- Unable to use the '.width()' method because the FIRST LINE  of the HEADING has SEVERAL MORE characters
--     !wid1 = !arr1.width()
--
     !wid1 = 0
     do !xwid values !arr1
       if (!xwid.match('???').eq(1)) then
         skip
       else
         !dwid1 = !xwid.length()
       endif
       if (!dwid1.gt(!wid1)) then
         !wid1 = !dwid1
       endif
     enddo
     if (!wid1.lt(4)) then
       !wid1 = 4
     endif
     !wid2 = !arr2.width()
     !wid3 = !arr3.width()
     !wid4 = !arr4.width()
     !wid5 = !arr5.width()

     do !fx indices !arr1
       if (!arr1[!fx].match('???').eq(1)) then
         !index2[!fx] = !arr1[!fx].after('???')
       elseif (!arr1[!fx].trim().length().eq(0)) then
         !index2[!fx] = ''
       else
         var !nlin compose spa 2 ('$!arr1[$!fx]') wid $!wid1 spa 2 ('$!arr2[$!fx]') wid $!wid2 spa 2 ('$!arr3[$!fx]') wid $!wid3 spa 2 ('$!arr4[$!fx]') wid $!wid4 R spa 2 ('$!arr5[$!fx]') wid $!wid5 R
         !index2[!fx] = !nlin[1]
       endif
     enddo

------------------------------------------------------------------------
------------------------------------------------------------------------

-- Write the FINAL Report File for a 'MDS Overall Support Index'
     !!writefile('$!!<kmdbdir>$!!<delim>MDS-SUMMARY-$!!<kdts>' , 'WRITE', !index2)

------------------------------------------------------------------------
------------------------------------------------------------------------

-- Delete the Temporary File
     !fileobj1 = object file ('$!!<kmdbdir>$!!<delim>MDS-SUMMARY1-$!!<kdts>')
     !fileobj1.deletefile()

------------------------------------------------------------------------
------------------------------------------------------------------------

   endmethod
-- End of method definition


-- End of file Mdsreports.pmlfrm

----------------------------------------------------------
