--
-- Description:
-- Rotate single atta
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel(FORM)                     -
--  edgentry()                       -
--  mdsRotateAtta()                  -
--  returnfromedg(ARRAY)             -
--  rotate(FORM)                     -
--  rotateOnly(FORM)                 -
--

-- Kill existing form definition
Kill !!mdsRotateAtta

-- Define Form
setup form  !!mdsRotateAtta

  !this.formtitle    = |Rotate Atta|
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .tag text |Name |
    para .name at xmax+2 ymin width 20 lines 1

    text .angle |Angle | at x0 Ymax+0.5 width 10 is REAL
    button .align ' Align ' at xmax+2 ymin call |!this.edgentry()|

  -- Bottom Line
  --  button .cancel | Dismiss | at xmax form-size ymax+0.5 CANCEL
    button .cancel | Dismiss | at xmax form-size ymax+0.5 call |!this.cancel(!this.form)| CANCEL
    button .ok     |  Apply  | at x0 ymin call |!this.rotate(!this.form)|

  -- Members

    member .atta is DBREF
    member .form is FORM
    member .plane is PLANE

-- End form definition
exit

--------------------------------------------------------------------------
define method .mdsRotateAtta()

--<dw>aug2008 dun979 - Now stated under Method RotateOnly as dynamic
--  !this.angle.val = 90

endmethod
--------------------------------------------------------------------------

define method .rotate(!form is FORM)

-- We need to set a flag to tell the integrity checker that this atta has been rotated
-- and store its original direction so to set the flag back

  !!ce = !this.atta
  !!mdsDacControl(true)
--<dw>aug2008 dun979 - Addition to allow for rotation of branch reinforcing
  if (!!ce.styp inset ('BR07','BR08','BR09')) then
     !despara = despara
     if (!!ce.styp eq 'BR08') then
        if (!despara[6] eq 1) then
           set desp num6  0mm
           set desp num7  1mm
           set desp num13 2mm
        elseif (!despara[7] eq 1) then
           set desp num6  1mm
           set desp num7  0mm
           set desp num13 1mm
        endif
     else
        if (!this.angle.val lt 0) then
           !this.angle.val = -90
           if (!despara[6] eq 1 and !despara[12] eq 1) then
              set desp num12 0mm
              set desp num13 1mm
              set desp num15 4mm
           elseif (!despara[7] eq 1 and !despara[12] eq 1) then
              set desp num6  1mm
              set desp num7  0mm
              set desp num15 1mm
           elseif (!despara[7] eq 1 and !despara[13] eq 1) then
              set desp num12 1mm
              set desp num13 0mm
              set desp num15 2mm
           elseif (!despara[6] eq 1 and !despara[13] eq 1) then
              set desp num6  0mm
              set desp num7  1mm
              set desp num15 3mm
           endif
        else
           !this.angle.val = 90
           if (!despara[6] eq 1 and !despara[12] eq 1) then
              set desp num6  0mm
              set desp num7  1mm
              set desp num15 2mm
           elseif (!despara[7] eq 1 and !despara[12] eq 1) then
              set desp num12 0mm
              set desp num13 1mm
              set desp num15 3mm
           elseif (!despara[7] eq 1 and !despara[13] eq 1) then
              set desp num7  0mm
              set desp num6  1mm
              set desp num15 4mm
           elseif (!despara[6] eq 1 and !despara[13] eq 1) then
              set desp num13 0mm
              set desp num12 1mm
              set desp num15 1mm
           endif
        endif
     endif
     return
  endif
--<dw>aug2008 dun979 - End of addition branch reinforcing
  if !!ce.:MDSRotated.not() then
    :MDSRotated true
    :MDSRotDir p9 dir
  endif
  rotate through ce about pl of ce by $!this.angle

--<wd>22jun2004
-- For AT65 ONLY
-- Determine the ANGLE of PPOINT P10 ** FROM **:-
-- (a) -- the UP Direction for Horizontal Pipes  i.e. The default of 90 degrees is ALWAYS a default direction of WEST
-- (b) -- the NORTH Direction for Vertical Pipes i.e. The default of 90 degrees is ALWAYS a default direction of WEST
  if (!!ce.prop.desc inset ('AT65')) then
    pin 1 at p0
    !ldir = !!ce.ldir.wrt(/* )
    if ((!ldir.up.eq(1)) or (!ldir.up.eq(-1)))then
-- Vertical Pipe
      pin 1 dir NORTH
    else
-- Horizontal Pipe
      pin 1 dir UP
    endif
    pin 1 dist ( param 2 / 2 )
    var !pin1str pin1 dir
    !pin1dir = !pin1str.direction()
    !p10dir  = !!ce.pdir[10]
    !xangle  = !pin1dir.angle(!p10dir)
-- Check if P10 Direction is WEST(East -xxx) or EAST(East xxx) and Set DESPAR NUM 7
    if (!p10dir.east.lt(0)) then
-- P10 direction is ON the WEST Side of UP or NORTH
      !!ce.desp[7] = !xangle
    else
-- P10 direction is ON the EAST Side of UP or NORTH
      !xangle      = 180 - !xangle
      if (!xangle.eq(180)) then
        !xangle = 0
      endif
      !!ce.desp[7] = !xangle
    endif
  endif
--<wd>22jun2004

-- If its a bedplate/bearing plate then the bedplate needs rotating too
-- Valid bearing plate types are TT05,TT07,TT09,TT11,TT13,TT19,TT28
  if !!ce.owner.:MdsTrun then

    -- Find baseplate/bearing plates

      bran
      !membersOfBran = members
      do !find values !membersOfBran
        !!ce = !find
        if (!!ce.styp inset ('AC18A','AC18B','AC30')) then
          !basePlate = !!ce
        elseif (!!ce.styp inset ('AC19A','AC19B')) then
          !bearingPlate = !!ce
        endif
      enddo

      !!ce = !this.atta

      if (!!ce.styp inset ('AC18A','AC18B','AC30')) then
        !!ce = !bearingPlate
          handle NONE
            rotate through ce about pl of ce by $!this.angle
            !!ce = !this.atta
            goto :MdsGuideRef
              handle NONE
                rotate through ce about pl of ce by $!this.angle
              elsehandle ANY
              endhandle
          elsehandle ANY
          endhandle
      elseif (!!ce.styp inset ('AC19A','AC19B')) then
        !!ce = !basePlate
          handle NONE
            rotate through ce about pl of ce by $!this.angle
            !!ce = !this.atta
            goto :MdsGuideRef
              handle NONE
                rotate through ce about pl of ce by $!this.angle
              elsehandle ANY
              endhandle
          elsehandle ANY
          endhandle
      elseif (!!ce.styp inset ('GT11','GT12A','GT12B','ST07','ST08','AN05')) then
        goto :MdsGuideRef
          handle NONE
            rotate through ce about pl of ce by $!this.angle
          elsehandle ANY
          endhandle
          !!ce = !bearingPlate
          handle NONE
            rotate through ce about pl of ce by $!this.angle
          elsehandle ANY
          endhandle
      endif

  endif

  !!ce = !this.atta

  $( if (!!ce.styp inset ('AC18A','AC18B','AC19A','AC19B','AC30','GT11')) then
     if !!ce.:mdsguideref.badref().not() then
        goto :mdsguideref
        rotate through ce about pl of ce by $!this.angle
        same
     endif
  endif
  $)

-- After we have rotated the atta check to see if it in it original direction to set
-- the flag back to false

  if :MDSRotated then
    !newDir = p9 dir
    !origDir = :MDSRotDir
    if !newDir.eq(!origDir) then
      :MDSRotated false
      :MDSRotDir def
    endif
  endif

--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
  if !this.atta.type.eq('ATTA') then
    !!mdstransport(!this.atta,!this.atta.name)
  endif
--<wd>may2003

-- Update the Graphical Aid Text
-- q var !form.name()
  !!mdsaidtext(!form)
    handle any
    endhandle

$(
    !!ce = !this.atta
    var !apos ppos9 wrt world
    !aname = after(!!ce.name, '.')
    var !anum (210 + $!aname)
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!anum $!aname $<$!apos$>
$)

-- Check the elements needs resizing

  -- !!mdsCheckBp(!!ce)

-- If the component has associated lugs then rotate them as well.
  !!mdsDacControl(TRUE)
  !attaname = !this.atta.name
  do !loop from 1 to 4
    $!attaname$n/LUG$!loop
      handle NONE
        rotate about pl by $!this.angle
      elsehandle ANY
      endhandle
  enddo

  !srefName = !attaname.before('/DATUM') & '/SREF'
  $!srefName
  handle ANY
  elsehandle NONE
    conn
    --$P conn
  endhandle

  !!ce = !this.atta

--<wd>oct2004
-- Modify/Restate the Form Support Object Data if the DATUM ATTA has been Rotated
    !support = !form.support
    !angle   = !this.angle.val.real()
    !!ce     = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    handle ANY
    endhandle
    !support.p11dir = p11 dir wrt world
    handle ANY
    endhandle
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle
    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif
    !support.rotated = !newdeg
    !form.support    = !support
--<wd>oct2004

  !!mdsDacControl(false)

endmethod

--------------------------------------------------------------------------
define method .rotateOnly(!form is FORM)

-- Check that Datum atta has been created
  if (!form.support.datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    return
  endif

-- If a HVAC special then cannot rotate atta
  if (!form.support.datum.styp.eq('HVAC-REST')) then
    !!alert.message('HVAC support attas cannot be rotated')
    return
  endif

--<wd>oct2004
-- The DATUM ATTA may now be ROTATED on HORIZONTAL PIPES
$(
-- Of only the datum atta is created the abort as you cannot rotate the datum
-- atta unless it is a special
  if !form.support.type.neq('SPECIAL') and !form.support.type.neq('FT23') then
    if (!form.support.stru.set())then
      if (!form.support.atta.size().lt(3)) then
        if !!mdsCheckTrun(!form,'DATUM').not() then
          !!alert.message('The datum atta cannot be rotated and no other attas exist')
          return
        endif
      endif
    endif
  endif
$)
--<wd>oct2004

-- If the current support only has one atta then rotate that
  !attasOnSupport = !form.support.atta

  if !attasOnSupport.size().gt(1) then

    if !attasOnSupport.size().eq(2) then
-- Are the datum and sref attas if so no id needed
      if !form.support.atta[1].name.match('/DATUM').gt(1) and !form.support.atta[2].name.match('/SREF').gt(1) then
        !!ce = !form.support.atta[1]
      else
-- Identify atta on current support only
        prompt off
        prompt load escape |Identify ancillary to rotate|
        id atta plat @
        handle (61,528)
          prompt dismiss
          prompt on
          return
        endhandle
        prompt dismiss
        prompt on
      endif
    else
      -- navigate to the base plate on the bottom of a TT42, 43 and 44 trunnion to rotate it
      if (!form.support.type.eq('TT42') or !form.support.type.eq('TT43') or !form.support.type.eq('TT44')) then
        !!ce = !form.support.datum
      endif
    endif

  else
    !!ce = !form.support.atta[1]
  endif

-- Is it on this support
    if !!mdsCheckatta(!form).not() then
      !!alert.error('Identified atta is not part of this support')
      return
    endif

-- Can only modify the atta if we can write to it
    if !!mdsComClaimDac(!!ce,'DACMOD','POS').not() then
      !!alert.error('Unable to rotate the identified atta as write access is not available')
      return
    endif

--<wd>oct2004
-- The DATUM ATTA may now be ROTATED on HORIZONTAL PIPES
$(
-- Is it the datum or sref atta
    if !form.support.type.neq('SPECIAL') and !form.support.type.neq('FT23') then
      if !!ce.name.match('/DATUM').gt(0) then
        if !!mdsCheckTrun(!form,'CE').not() then
          !!alert.error('The datum atta cannot be rotated')
          return
        endif
      elseif !!ce.name.match('/SREF').gt(0) then
        if !!mdsCheckTrun(!form,'CE').not() then
          !!alert.error('The datum atta cannot be rotated')
          return
        endif
      endif
    endif
$)
--<wd>oct2004

    !this.atta = !!ce
    !this.name.val = !this.atta.name
    !this.form = !form
--<dw>aug2008 dun979 - Addition to set and fix angle of rotation for branch reinforcing
  if (!!ce.styp eq 'BR08') then
     !this.angle.val = 180
  else
     !this.angle.val = 90
  endif

  if (!!ce.styp eq 'BR08') then
     !this.angle.active = false
  else
     !this.angle.active = true
  endif
--<dw>aug2008 dun979 - End of addition to set and fix angle of rotation for branch reinforcing

    show !!mdsRotateAtta
    !!mdsDacControl(false)
endmethod

------------------------------------------------------------------------------------
 -- method to kick off an EDG pick
define method .edgentry()


    -- now we have found the end to be extended we need an EDG pick to find the plane we want to align with
    prompt  'Pick Surface To Align with'

    -- simulate a blocking form
    !this.form.setactive(false)

    -- Define event packet
    !packet = object EDGPACKET()
    !packet.description = 'setclear'

    -- Remember the element when the packet was first placed in the event system
    !packet.initialisation = '!this.input[1] = !!ce'

    -- set the callback to be run when the packet has found a surface
    !formname = '!!' & !this.string()
    !packet.action = '$!<formname>.returnfromedg(!this.return)'

    -- Set the close sequence to reactivate the calling form ( This is run if the user presses escape)
    !packet.close = '$!<formname>.setactive(true)'

    !packet.remove = true $* set packet so that it deletes itself when it finished
    !pickpacket = object EDGPICKPACKET()
    !pickpacket.stdgraphic('Pick a Surface to Align With')
    -- add the new picktype to the edgpacket currently defined
    !packet.pickpacket = !pickpacket

    -- Add event packet to the system
    !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method which deals with the return from the EDG event
define method .returnfromedg(!input is ARRAY)

  -- first of all, tidy up
  !this.form.setactive(true)
  prompt dismiss
  -- this method is called when the EDG returns from a valid pick
  -- first of all check to see if we have found a plane as a result of picking a surface
  !this.plane = !input[1].positiondata().plane
  if !this.plane.unset() then
    !!alert.error('Please identify a Surface - Not an Edge or PPoint')
    return
  endif

  -- remember the item
  -- item identified is !input[1].item

  !unuseddir = !this.plane.orientation.zdir().wrt(/* )
  !pv  = object POINTVECTOR()
  !pv.position = !this.atta.position.wrt(/* )
  !pv.direction = !this.atta.adir.wrt(/* )
  !attaline  = !pv.plane().intersection(!this.plane)
  !nearpos = !attaline.near(!this.atta.position.wrt(/* ))
  !pv.direction = !this.atta.position.wrt(/* ).direction(!nearpos).wrt(/* )
  !rotate = !this.atta.pdir[9].wrt(/* ).angle(!pv.direction)

  -- it seems that angle always returns a positive number now we need to sort out the sense
  !arc = object ARC()
  -- create an arc centred on the atta orientated around the atta
  !arc.position = !this.atta.position.wrt(/* )
  !z = !this.atta.adir.wrt(/* )
  !x = !this.atta.pdir[9].wrt(/* )
  !arc.orientation = z is $!z and x is $!x
  -- set the radius as the distance between the atta and the point on the plane
  !arc.radius = !this.atta.position.wrt(/* ).distance(!nearpos)
  !arc.startangle = 0
  !arc.endangle = !rotate
  !arc.sense = TRUE
  !pos1 = !arc.angleposition(!rotate)
  !pos2 = !arc.angleposition(- !rotate)
  -- solve the sense by rotating in both senses and seeing which is closest
  -- q var !pos1.distance(!nearpos)
  -- q var !pos2.distance(!nearpos)
  if !pos1.distance(!nearpos).lt(!pos2.distance(!nearpos)) then
     !this.angle.val = -!rotate
  else
     !this.angle.val = !rotate
  endif
  !string = !this.angle.val.string('d0')
  !unusedreal = !string.real()

  --!this.rotate(!this.form)
  --!this.angle.val = 0

endmethod
---------------------------------------------------------------------------------------------------

--<GE> 10/01/07 Method added which deals with the cancel of the mdsroteatta
-- and reactivate the calling form icons for defect 10041
define method .cancel(!form is FORM)

  !this.angle.clear()
  !this.form.setactive(true)

endmethod


