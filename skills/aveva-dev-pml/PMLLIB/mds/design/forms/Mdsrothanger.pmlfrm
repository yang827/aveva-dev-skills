--
-- Description:
-- Rotate hanger's members
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsRotHanger

-- Define Form
Setup Form  !!MdsRotHanger

  !!MdsRotHanger.formtitle    = |Rotate All Hanger members|
  !!MdsRotHanger.icontitle    = ||
  !!MdsRotHanger.callback     = ||
  !!MdsRotHanger.formrevision = | $Revision: 1.0 $ |

-- Body of Form
  para .Tag text |Name|
  para .Name at xmax+2 ymin width 20 lines 1
  text .Angle |Angle         | at x0 Ymax+0.5 width 10 is real

-- Bottom Line
  button .Cancel | Dismiss | at xmax form-size ymax+0.5 CANCEL
  button .Ok     |  Apply  | at x0 ymin call ||

-- End form definition
exit

-- End of file MdsRotHanger.frm
