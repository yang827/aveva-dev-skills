-- Kill existing form definition
Kill !!MdsRotSpecial

-- Define Form
Setup Form  !!MdsRotSpecial

  !!MdsRotSpecial.formtitle    = |Rotate Special Framework|
  !!MdsRotSpecial.icontitle    = ||
  !!MdsRotSpecial.callback     = |!this.init()|
  !!MdsRotSpecial.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    -- para .Tag text |Name|
    -- para .Name at xmax+2 ymin width 20 lines 1

    text .Angle |Angle               | at x0 Ymax+0.5 width 10 is real

  -- Bottom Line
    button .Cancel | Dismiss | at xmax form-size ymax+0.5 CANCEL
    button .Ok     |  Apply  | at x0 ymin call |!!MdsRotateSpecial()|

-- End form definition
exit

define method .init()

-- Access the DATUM atta so we can determine if its a HVAC special

  !!ce = !!MdsSpecial.Support.Datum
    handle ANY
      !!Alert.Error('Datum atta not yet created')
      return
    endhandle

  !!MdsRotSpecial.angle.active = TRUE

  !!ce = !!MdsSpecial.Support.Stru


-- Get Angle from project special template if HVAC template

  if !!ce.:MdsProjSpec.badref().not() then
    -- if !!ce.:MdsProjSpec.owner.name.eq('/MDS/SPECIALS/HVAC') then
    if !!ce.:MdsProjSpec.owner.name.matchwild('*HVAC*') then
      if !!ce.:MdsProjSpec.owner.function.eq('FRAMATOME HVAC') then
        if !!ce.:MdsProjSpec.:mdsdtype.eq('CIRC') and !!ce.:MdsProjSpec.:mdshv.eq('VERT') then
          !this.angle.val = 90
          !!MdsRotSpecial.angle.active = TRUE
        else
          -- its a horizontal duct and we can only rotate 180 degrees
          -- the :MdsSplRot attribute of the template structure defines the rotation
          !this.angle.val = !!ce.:MdsProjSpec.:MdsSplRot
          !!MdsRotSpecial.angle.active = FALSE
        endif
      else
        !this.angle.val = 90
        !!MdsRotSpecial.angle.active = TRUE
      endif
    else
      !this.angle.val = 90
      !!MdsRotSpecial.angle.active = TRUE
    endif
  else
    !This.angle.val = 90
    !!MdsRotSpecial.angle.active = TRUE
  endif

endmethod

-- End of file MdsRotSpecial.frm
