--
-- Description:
-- Form Definition for Steelwork Setting
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(STRING,FORM,STRING,STRING)  -
--  setTitle()                       -
--

-- Kill existing form definition
kill !!mdsSetSteel

-- Define Form
setup form  !!mdsSetSteel

  !this.formTitle = 'Select Required Template'

  list .size || call |Call !!mdsReSize(!this.form)| height 8 width 40

  button .dismiss | Dismiss | at xmax-10 ymax+0.5 OK

  -- End form definition
exit

--------------------------------------------------
-- Method to initialize the template selection form
--------------------------------------------------

define method .init(!mode is STRING,!form is FORM,!cross is STRING,!vert is STRING)

  -- Current DB position

  !ce = !!ce

  -- In order to display this FORM you must have write access to the SREF atta

  if !mode.eq('SHOW') then
    !datumAtta = !form.support.datum
    if !datumAtta.badref().not() then
      !srefName = !datumAtta.name.before('/DATUM') + '/SREF'
      !!ce = !srefName.dbref()
      if !!mdsComClaimDac(!!ce,'DACMOD','SPREF').not() then
        !!ce = !ce
        !!alert.error('Unable to modify the steelwork as write access to the SREF atta is not available')
        return
      endif
    endif
  endif

  -- Access correct template zone

  !alias = !form.support.alias
  -- This may fail because the templates have a -HORI and -VERT extension, if this fails use the -HORI template
  -- If alias is FT25 it has A and B extension which is controlled from the main form

  if !alias.eq('FT25') then
    if !!mdsFT25.type.val.eq(1) then
      !!ce = /MDS/FRAMES/FT25A
    else
      !!ce = /MDS/FRAMES/FT25B
    endif
  else
    !!ce = /MDS/FRAMES/$!alias
    handle (2,109)
      --<wd>apr2004
      --!vAlias = !alias + '-HORI'
      --!!ce = /MDS/FRAMES/$!vAlias
      if ((!alias inset ('FT03','FT04')) and (!form.support.config.eq(2))) then
        !vAlias = !alias + '-VERT'
        !!ce = /MDS/FRAMES/$!vAlias
      else
        !vAlias = !alias + '-HORI'
        !!ce = /MDS/FRAMES/$!vAlias
      endif
      --<wd>apr2004
    endhandle
  endif

  -- Set callback on list gadget

  !formName = '!!' + !form.string()
  !this.size.callback = |Call !!mdsReSize($!formName)|

  -- Clear List

  !this.size.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- The description will be taken from the stru desc attribute if set and then the sizes of the first cross bar
  -- and first vertical if not

  -- Collect bar sizes

  !bTypes = !!kCollectAllFor('SCTN', '((match(name, |$!cross|) gt 0) and type of owner eq |FRMW|)', !!ce)
  !block = object BLOCK('!bTypes[!evalIndex].spref.catref.:MDSSizeTag')
  !bDText = !bTypes.evaluate(!block)
  handle ANY
    !bDText = object ARRAY()
    do !i from 1 to !bTypes.size()
      !bDTextTemp = !bTypes[!i].spref.catref.:MDSSizeTag
      handle ANY
        !vDTextTemp = 'Error in bar member catref'
      endhandle
      !bDText[!i] = !bDTextTemp
    enddo
  endhandle

  -- Collect vert sizes
  !vTypes = !!kCollectAllFor('SCTN', '((match(name, |$!vert|) gt 0) and type of owner eq |FRMW|)', !!ce)
  !vBlock = object BLOCK('!vTypes[!evalIndex].spref.catref.:MDSSizeTag')
  !vDText = !vTypes.evaluate(!vBlock)
  handle ANY
    !vDText = object ARRAY()
    do !i from 1 to !vTypes.size()
      !vDTextTemp = !vTypes[!i].spref.catref.:MDSSizeTag
      handle ANY
        !vDTextTemp = 'Error in vertical member catref'
      endhandle
      !vDText[!i] = !vDTextTemp
    enddo
  endhandle
  -- If the sizes are the same display one size if not display both sizes
  -- in the display text. Set the rtext values to a numerical list.
  -- Opened up this LIST to 100

  if !bDText.size().gt(100) then
    !to = 100
  else
    !to = !bDText.size()
  endif

  do !i from 1 to !to
    if !bTypes[!i].owner.owner.desc.unset() or !bTypes[!i].owner.owner.desc.eq('') then
      if !bDText[!i] eq !vDText[!i] then
        !dtext.append(!bDText[!i].string())
      else
        !dtext.append(!bDText[!i].string() + ' & ' + !vDText[!i].string())
      endif
    else
      !dtext.append(!bTypes[!i].owner.owner.desc)
    endif
    !rtext.append(!i.string())
  enddo

  -- If the template is an FT24 then make the arrays unique
  if (!alias.eq('FT24')) then
    !dtext = !dtext.unique()
    !dtextSize = !dtext.size()
    !rtext.clear()
    do !set from 1 to !dtextSize
      !rtext.append('$!set')
    enddo
  endif

  -- If the template is an FT52 then make the arrays unique
  if (!alias.eq('FT52')) then
    !dtext = !dtext.unique()
    !dtextSize = !dtext.size()
    !rtext.clear()
    do !set from 1 to !dtextSize
      !rtext.append('$!set')
    enddo
  endif

  !this.size.dtext = !dtext
  !this.size.rtext = !rtext

  -- If the framework exists then try to select the correct template being used, if not select the first

  !!ce = !form.support.stru
  !members = mem count
  if !members.gt(0) then
    !description = desc
    if !description.neq('') then
      !this.size.select('DTEXT','$!description')
      handle ANY
      endhandle
    else
      !selectedSize = :MDSSizeTag of catref of sctn 1 of frmw 1
      !this.size.select('DTEXT',!selectedSize)
      handle ANY
      endhandle
    endif
  else
    !this.size.select('RTEXT','1')
  endif

  ---------------------------------------------------------
  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle
  if !desc.eq('Zimmer Templates') then
    if !alias.eq('FT23') then
      !this.size.val = !!mdsFT23.cap.selection('Rtext').real()
      handle ANY
      endhandle
    elseif !alias.eq('FT48A')  then
      !this.size.val = !!mdsFT48.cap.selection('Rtext').real()
      handle ANY
      endhandle
    endif
  endif


  if (!form.support.alias inset ('CT09','CT10','CT11')) or !desc.eq('Zimmer Templates') then
    --<dw>jan2009 dun1081 - if statement reverted back to selection from CT06 to CT11 - HPD0038695.
    --if !desc.eq('Zimmer Templates') and (!form.support.alias inset ('CT06','CT07','CT08')) then
    if (!form.support.alias inset ('CT06','CT09','CT07','CT10','CT08','CT11')) then
      if (!form.support.datum.set()) then
        !bore = !form.support.datum.abor
        if (!alias eq 'CT06') then
          var !stru coll all stru with matchwild(name,'*CT06*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT09') then
          var !stru coll all stru with matchwild(name,'*CT09*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT07') then
          var !stru coll all stru with matchwild(name,'*CT07*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT10') then
          var !stru coll all stru with matchwild(name,'*CT10*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT08') then
          var !stru coll all stru with matchwild(name,'*CT08*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT11') then
          var !stru coll all stru with matchwild(name,'*CT11*') for /MDS/TEMPLATES
        endif
        do !remove from 1 to !stru.size()
          !tempMinBore = !stru[$!remove].dbref().:MdsMinBore
          !tempMaxBore = !stru[$!remove].dbref().:MdsMaxBore
          !realBore = !bore.real()
          if !realBore.lt(!tempMinBore) then
            !stru[$!remove].delete()
          endif
          if !realBore.gt(!tempMaxBore) then
            !stru[$!remove].delete()
          endif
        enddo
        -- Error if no strus are found
        if !stru.size().eq(0) then
          !!alert.error('Unable to find any supports suitable for selected type')
          return
        endif
        !stru.compress()
        var !desc eval desc for all from !stru
        !this.size.dtext = !desc
      endif
      !this.size.active = FALSE
    endif
  endif

  ---------------------------------------------------------

  -- Modify the title

  !this.setTitle()

  -- Access starting DB position

  !!ce = !ce

  -- Show form if necessary

  if !mode.eq('SHOW') then
    show !!mdsSetSteel
  endif

endmethod

define method .setTitle()

  !numberOfTemplates = !this.size.dtext.size()
  !currentValue = !this.size.selection()
  -----------------------------------------------
  -- Check this in orig
  !currentValue = !this.size.val.string()
  -----------------------------------------------

  !this.formTitle = 'Set Steelwork Size ($!currentValue / $!numberOfTemplates)'


endmethod
