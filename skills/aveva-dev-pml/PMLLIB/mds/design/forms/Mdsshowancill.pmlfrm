--
-- File:    Mdsshowancill.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FSHOWPLOT
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Form Definition for Showing MDS plotfiles
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsshowancill

-- Define Form
setup form !!mdsshowancill resize $* blocking

  !!mdsshowancill.formtitle    = |View Multi Discipline Standard|
  !!mdsshowancill.icontitle    = ||
  !!mdsshowancill.callback     = ||
  !!mdsshowancill.formrevision = | $Revision: 1.1.19.1 $ |

  button _prev at x0 y0 pixmap height 12 width 9 call |call !!mdsShowNextancill('PREV')|

  path right
  hdist0

  button _next at xmax ymin pixmap height 12 width 9 call |call !!mdsShowNextancill('NEXT')|
  para .sheets width 30 lines 1

  !!mdsshowancill.prev.addPixmap(!!PML.getPathName('leftarrow9x12.png'))
  !!mdsshowancill.next.addPixmap(!!PML.getPathName('rightarrow9x12.png'))


  -- Body of Form
  frame .plotFrame at x0 ymax+0.2 anchor all
    view .plot PLOT
      bord on
      height 20
--      handle ANY
--endhandle
      width 42
--       handle ANY
--endhandle
      setc 15
    exit
  exit

    path down
    vdist 0.5

  -- Bottom Line
    button .dismiss | Dismiss | anchor B + L cancel

    path right

  -- Project Type para
    para .projType at xmax+0.5 ymin anchor B + L width 30 lines 1

  -- Page member
    member .sheet is REAL
    member .plots is ARRAY

-- End form definition
exit
