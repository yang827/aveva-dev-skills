--
-- File:    Mdsshowplot.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FSHOWPLOT
--
-- Author:    I.Osborne
-- Created:   Thu Apr 24
--
--
-- Description:
-- Form Definition for Showing MDS plotfiles
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsShowPlot

-- Define Form
setup form !!mdsShowPlot resize

  !!mdsShowPlot.formtitle    = |View Multi Discipline Standard|
  !!mdsShowPlot.icontitle    = ||
  !!mdsShowPlot.callback     = ||
  !!mdsShowPlot.formrevision = | $Revision: 1.1.19.1 $ |

  button _prev at x0 y0 pixmap height 12 width 9 call |call !!mdsShowNextPlot('PREV')|

  path right
  hdist0

  button _next at xmax ymin pixmap height 12 width 9 call |call !!mdsShowNextPlot('NEXT')|
  para .sheets width 30 lines 1

  !!mdsShowPlot.prev.addPixmap(!!pML.getPathName('leftarrow9x12.png'))
  !!mdsShowPlot.next.addPixmap(!!pML.getPathName('rightarrow9x12.png'))

  menu .ppopup
    add 'Reset Limits' call |!!mdsShowPlot.plot.add(!!mdsShowPlot.plot.val)|
   exit

  frame .plotFrame at x0 ymax+0.2 anchor all
  -- Body of Form
    view .plot PLOT
      bord on
      height 30
      width 70
      setc 15
    exit
  exit

  -- Add popup
  !this.plot.setPopup(!this.ppopup)

  path down
  vdist 0.5

  -- Bottom Line
  button .dismiss | Dismiss | anchor B + L cancel

  path right

  -- Project Type para
  para .projType at xmax+0.5 ymin anchor B + L width 30 lines 1

  -- Page member

  member .sheet is REAL
  member .plots is ARRAY

-- End form definition
exit
