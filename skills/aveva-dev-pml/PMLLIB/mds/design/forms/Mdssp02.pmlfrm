--
-- File:		Mdssp02.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 26th May 1998
--
--
-- Description:
-- Form Definition for Variable Spring  Supports
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!Mdssp02

-- Define Form
setup form  !!Mdssp02 at xr0 yr0 noquit

  !!Mdssp02.formtitle    = ||
  !!Mdssp02.icontitle    = ||
  !!Mdssp02.callback     = ||
  !!Mdssp02.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatsp02()|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDonly(!!Mdssp02)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosTonly(!!Mdssp02)|
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!Mdssp02)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

      text   .Height  |Overall Height  | call |!!MdsModSpring(!!MdsSP02,'HEIGHT',!!MdsSP02.support.atta[1])| at x1 ymax+0.2 width 11 is real format !!DistanceFmt
      path down
       halign right
       text   .CaseDia |Casing Diameter | call |!!MdsModSpring(!!MdsSP02,'CASEDIA',!!MdsSP02.support.atta[1])| at xmin ymax width 11 is real format !!DistanceFmt
       text   .Rod     |Rod Diameter    | call |!!MdsModSpring(!!MdsSP02,'RODD',!!MdsSP02.support.atta[1])| at xmin ymax width 11 is real format !!DistanceFmt
       text   .TopRod  |Top Rod Length  | call |!!MdsModSpring(!!MdsSP02,'RODL',!!MdsSP02.support.atta[1])| at xmin ymax width 11 is real format !!DistanceFmt
       text   .Case    |Casing Height   | call |!!MdsModSpring(!!MdsSP02,'CASEH',!!MdsSP02.support.atta[1])| at xmin ymax width 11 is real format !!DistanceFmt

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

      button .SetDefault | Set Parameters to Default  | at x1 Ymax+0.2 call |!!MdsSetDef(!!MdsSP02.Support.Alias,!!MdsSP02.support.atta[1],'CONFIRM')|
      button .SetSteel |Set Height to Steel/Bedplate| at x1 Ymax+0.2 call |Call !!MdsModSpring(!!MdsSP02,'STEEL',!!MdsSP02.support.atta[1])|
      button .Align    |   Re-Align with Pedestal   | at x1 Ymax+0.2 call |Call !!MdsAlignSpring(!!MdsSP02,!!MdsSP02.support.atta[1])|

      halign left

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame' pixmap width 18 height 18 call |Call !!MdsMirrorSp02()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame' pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsSp02)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsSp02)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsSp02)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer' pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsSp02)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer' pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsSp02)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta' pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsSp02,'!!MdsRotateSp02()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta' pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsSp02)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsSp02,'ATTA')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta' pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsSp02)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations' pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsSp02)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.3   tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsSp02,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsSp02,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsSp02)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsSp02)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsSp02)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsSp02)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp02,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp02,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsSp02,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp02,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsSp02)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsSp02)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist' pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsSp02,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptsp02()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Stype
    member .Stype is string

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,4,6,7,8,9,11,12,13,14,15,19,20,21,22,24,28,33,35,37,38,41,42,56,58,62'

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsSp02,'white')

  -- Turn off blocked icons
    !!KResetActive(!!MdsSp02,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!Mdssp02.Select)

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdssp02.frm
