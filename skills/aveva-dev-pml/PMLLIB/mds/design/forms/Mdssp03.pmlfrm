--
-- File:		Mdssp03.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Mon 1st June  1998
--
--
-- Description:
-- Form Definition for Constant Effort  Supports
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!Mdssp03

-- Define Form
setup form  !!Mdssp03 at xr0 yr0 noquit

  !!Mdssp03.formtitle    = ||
  !!Mdssp03.icontitle    = ||
  !!Mdssp03.callback     = ||
  !!Mdssp03.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 call |Call !!MdsSetDatsp03()|
--< Modified -<wd>- 17sep1998
--xxx      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDist(!!Mdssp03)|
      button .Bdist | Distance | at xmin   ymax+0.25       call |Call !!MdsPosDonly(!!Mdssp03)|
      text   .Dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
--xxx      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosThro(!!Mdssp03)|
      button .Bthro | Through |  at x1     ymax+0.2        call |Call !!MdsPosTonly(!!Mdssp03)|
--> Modified -<wd>- 17sep1998
      option .Select             at xmax+1 ymin            call |Call !!MdsThroSelect(!!Mdssp03)| width 13
      para   .P                  at x1     ymax+0.2 width 25 lines 1

    exit

    -- Creation
    frame .FCreate |Create| at x0 ymax width 31

--      option .Type  |Support Type | at      ymax+0.2 call |call !!Mdstypesp03(!!Mdssp03.Type.Selection())| width 10
      option .Type  |Support Type | at      ymax+0.2 call |call !!Mdstypesp03()| width 10

      text   .Height  |Overall Height    | call |!!MdsModSpring(!!MdsSP03,'HEIGHT',!!MdsSP03.support.atta[1])| at x1   ymax+0.2 width 10 is real format !!DistanceFmt
      text   .CaseLen |Casing Length     | call |!!MdsModSpring(!!MdsSP03,'CASELEN',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .CaseDia |Casing Diameter   | call |!!MdsModSpring(!!MdsSP03,'CASEDIA',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .HouWid  |Housing Width     | call |!!MdsModSpring(!!MdsSP03,'HWID',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .HouThk  |Housing Thickness | call |!!MdsModSpring(!!MdsSP03,'HTHK',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .HouDep  |Housing Depth     | call |!!MdsModSpring(!!MdsSP03,'HDEP',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .HouLen  |Housing Length    | call |!!MdsModSpring(!!MdsSP03,'HLEN',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .Arm     |Armature Length   | call |!!MdsModSpring(!!MdsSP03,'ARM',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .CentreL |Casing/Pivot CL's | call |!!MdsModSpring(!!MdsSP03,'CENL',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real format !!DistanceFmt
      text   .Angle   |Can Rotation Angle| call |!!MdsModSpring(!!MdsSP03,'ANG',!!MdsSP03.support.atta[1])| at xmin ymax width 10 is real

    exit

    frame .FMisc |Options| at x0 ymax+0.1 width 31

      button .SetDefault | Set Parameters to Default  | at x1 Ymax+0.2 call |!!MdsSetDef(!!MdsSP03.Support.Alias,!!MdsSP03.support.atta[1],'CONFIRM')|
      button .SetSteel |Set Height to Steel/Bedplate| at x1 Ymax+0.2 call |Call !!MdsModSpring(!!MdsSP03,'STEEL',!!MdsSP03.support.atta[1])|
      button .Align    |   Re-Align with Pedestal   | at x1 Ymax+0.2 call |Call !!MdsAlignSpring(!!MdsSP03,!!MdsSP03.support.atta[1])|

      halign left

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame' pixmap width 18 height 18 call |Call !!MdsMirrorSp03()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame' pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsSp03)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |call !!Mdsxalign(!!MdsSp03)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsSp03)|

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25  tooltip 'Add Packer' pixmap width 18 height 18 call |call !!Mdscrft25(!!MdsSp03)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer' pixmap width 18 height 18 call |call !!Mdsdelft25(!!MdsSp03)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta' pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsSp03,'!!MdsRotateSp03()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta' pixmap width 18 height 18 call |call !!Mdsnewdatum(!!MdsSp03)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsSp03,'ATTA')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta' pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsSp03)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations' pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsSp03)|

-- Icons Row 3

      button .FlipFw      at x1 ymax+0.25     tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsSp03,'FLIP')|
      button .ModAtta     at xmax+0.1 ymin tooltip 'Modify Atta' pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsSp03,!!MdsModAt)|
      button .DeleteAtta  at xmax+0.1 ymin tooltip 'Delete Atta' pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsSp03)|
      button .Nudge       at xmax+0.1 ymin tooltip 'Nudge Support' pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsSp03)|
      button .Spool       at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsSp03)|
      button .SetMat      at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsSp03)|
      button .copylike    at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd     at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp03,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp03,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!MdsSp03,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!MdsSp03,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsSp03)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsSp03)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist' pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsSp03,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptsp03()|

  -- Form Members
    -- Support object
    member .Support     is MdsSUPPORT

    -- Graphical representation
    member .Repre       is array

    -- Form Storage for support restoration
    member .Store       is array

    -- Form Storage for Packing Pieces for Support restoration
    member .Ppack       is array

    -- Support object storage for support regeneration
    member .Backup      is MdsSUPPORT

    -- Support Regeneration function
    member .Regen       is string

    -- BedPlate Reference
    member .StruBpref   is array

    -- BedPlate Reference
    member .StoreBpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Stype
    member .Stype is string

    member .Flips is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24,28,33,35,37,38,41,42,56,58,62'

-- End form definition
exit

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsSp03,'white')

  -- Turn off blocked icons
    !!KResetActive(!!MdsSp03,true)

  -- Populate option gadgets
    call !!MdsLoadOption(!!Mdssp03.Select)

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

 -- Set the Trimmer Button to INACTIVE
 --<GE> 05/02/02 Fix Defect Number:
    !This.trimmer.active = false

-- End of file Mdssp03.frm
