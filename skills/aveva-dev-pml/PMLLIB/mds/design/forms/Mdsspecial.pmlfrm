--------------------------------------------------------------------------------------------------------------
define method .inclsctn()

-- Identify section

  prompt off
  prompt load escape 'Identify section to include into support'
  ID sctn @
    handle (61,528)
      prompt on
      return false
    endhandle
  prompt on

-- Get the poss and pose of the section in world coordinates to reset then so it is always in the same place
-- when it is included

  !sctnToInclude = !!ce

-- Is it part of another support

  !!mdsSilent = TRUE
  !couldBeASupport = !!mdsGetSuppName(!!ce)
  !!mdsSilent.delete()
  if !couldBeASupport.neq('ABORT') then
    if !couldBeASupport.eq(!!mdsSpecial.support.stru.name) then
      !!alert.error('Cannot include section as it is already part of this support')
      return
    else
      if !couldBeASupport.dbref().:MdsSuppType.eq('SPECIAL') then
        if !!alert.confirm('Identified section is part of another special. Are you sure you want to include it into this special').eq('NO') then
          return
        endif
      else
        !!alert.error('Cannot include section as it is already part of a support')
        return
      endif
    endif
  endif

  !!ce = !sctnToInclude

  !memOfSctn = mem count
  if !memOfSctn.neq(0) then
    !!alert.error('Cannot include section as it owns members')
    return
  endif
  !poss = poss wrt world
  !pose = pose wrt world

-- Goto out support frmw

  !!ce = frmw 1 of $!!mdsSpecial.support.stru

-- Can we include it into the support

  !!mdsDacControl(TRUE)

  incl $!sctnToInclude
    handle ANY
    !!alert.error('Unable to include section into support because : ' + !!error.text)
    return
  elsehandle NONE
    !!ce = !sctnToInclude
      poss $!poss
      pose $!pose
      unname
        handle ANY
        endhandle
    endhandle

  !!mdsDacControl(FALSE)

endmethod
----------------------------------------------------------------------------------------------------


----------------------------------------------------------------------------------------------------
define method .createsubs()

  !!ce = !!mdsSpecial.support.stru
    handle ANY
    !!alert.error('Support structure has not been created')
      return
    endhandle

  !nameOfStru = !!ce.name
  last subs
    handle ANY
      last mem
    endhandle
  new subs purp S
  do !nameSubs from 1 to 1000
    name $!nameOfStru/SUBS$!nameSubs
      handle ANY
        skip
      elsehandle NONE
        break
      endhandle
  enddo
  new box xlen 100mm ylen 100mm zlen 100mm
  matref /CARBON/STEEL
    handle ANY
      :mdsmatref /CARBON/STEEL
        handle ANY
        endhandle
    endhandle

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .modmat(!form is FORM)

-- Do any stiffeners exist

  !!ce = !form.support.stru
  var !coll coll all box with purp of subs eq 'S' for ce
  if !coll.size().eq(0) then
    !!alert.error('No stiffener plates exist')
    return
  endif

  if !coll.size().eq(1) then
    !!ce = !coll[1].dbref()
    !id = FALSE
  else
    !id = TRUE
  endif

-- Identify box

  if !id then
    prompt off
    prompt load escape |Identify stiffener plate (BOX)|
      id box @
        handle (61,528)
          prompt on
          return
        endhandle
    prompt dismiss
    prompt on
  endif

  !box = !!ce

  stru
    handle ANY
    !!alert.error('Identified box is not owned by a support')
      return
    endhandle

  !identifiedStru = !!ce.name

  !!ce = !!mdsSpecial.support.stru
    handle ANY
    !!alert.error('Support structure has not been created')
    return
  endhandle

  !supportStru = !!ce.name

  if !supportStru.neq(!identifiedStru) then
    !!alert.error('Identified stiffener does not belong to this support')
    return
  endif

  !!ce = !box

  subs
  handle ANY
    !!alert.error('Identified box is not a stiffener')
    return
  endhandle

  if !!ce.purp.neq('S') then
    !!alert.error('Identified box is not a stiffener')
    return
  endif

  !!mdsStiffMat.init(!this,!box)

endmethod
----------------------------------------------------------------------------------------------------


----------------------------------------------------------------------------------------------------
define method .stiffdel(!form is FORM)

  -- Do any stiffeners exist

  !!ce = !form.support.stru
  var !coll coll all box with purp of subs eq 'S' for ce
  if !coll.size().eq(0) then
    !!alert.error('No stiffener plates exist to delete')
    return
  endif

  if !coll.size().eq(1) then
    !!ce = !coll[1].dbref()
    !id = FALSE
  else
    !id = TRUE
  endif

-- Identify box

  if !id then
    prompt off
    prompt load escape |Identify stiffener plate to delete (BOX)|
      id box @
        handle (61,528)
          prompt on
          return
        endhandle
    prompt dismiss
    prompt on
  endif

  !box = !!ce

  stru
    handle ANY
    !!alert.error('Identified box is not owned by a support')
      return
    endhandle

  !identifiedStru = !!ce.name

  !!ce = !!mdsSpecial.support.stru
    handle ANY
    !!alert.error('Support structure has not been created')
    return
  endhandle

  !supportStru = !!ce.name

  if !supportStru.neq(!identifiedStru) then
    !!alert.error('Identified stiffener does not belong to this support')
    return
  endif

  !!ce = !box

  subs
  handle ANY
    !!alert.error('Identified box is not a stiffener')
    return
  endhandle

  if !!ce.purp.neq('S') then
    !!alert.error('Identified box is not a stiffener')
    return
  endif

-- Confirm to user that he is sure

  if !!alert.confirm('Are you sure you want to delete the stiffener').eq('YES') then
    !!ce = !box
    !!mdsDacControl(TRUE)
    delete box
    !mem = mem count
    if !mem.eq(0) then
      delete subs
    endif
    !!mdsDacControl(FALSE)
  endif

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .copyfrasctn(!form is FORM)

  if !this.support.datum.badref() then
    !!alert.error('Unable to create a section when the datum atta has not been created')
    return
  endif

  if !this.support.position.not() then
    !!alert.error('Unable to create a section when the datum atta has not been positioned')
    return
  endif

-- The available sections will be stored in a site called /MDS/FRA/STEELWORK
-- Check to see if it exists

  /MDS/FRA/STEELWORK
    handle ANY
    !!alert.error('The site /MDS/FRA/STEELWORK does not exist')
      return
    elsehandle NONE
      same
    endhandle
  --<wd>16feb2010 - DUN1233 - Reload the form !!mdsCopyFraSctn as it may be TOTALLY DEACTIVATED after using the form !!mdseditspsctn
  pml reload form !!mdsCopyFraSctn
  --<wd>16feb2010
  !!mdsCopyFraSctn.init()

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .createplate(!form is FORM)

  if !form.support.datum.badref() then
    !!alert.error('Unable to create a plate when the datum atta has not been created')
    return
  endif

  if !form.support.position.not() then
    !!alert.error('Unable to create a plate when the datum atta has not been positioned')
    return
  endif

  !!ce = !form.support.stru
  var !sctns coll all sctn for ce

  if !sctns.size().eq(0) then
    !!alert.error('Unable to create a plate when no sections have been created')
    return
  endif

-- The available sections will be stored in a site called /MDS/FRA/STEELWORK
-- Check to see if it exists

  /MDS/FRA/STEELWORK
    handle ANY
    !!alert.error('The site /MDS/FRA/STEELWORK does not exist')
      return
    elsehandle NONE
      same
    endhandle

  !!mdsCreatePlate.form = !form

  !!mdsCreatePlate.init()

endmethod
----------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
define method .edgentry()

  !this.mdstrimsctn = object MDSTRIMSCTN(!this)

endmethod
