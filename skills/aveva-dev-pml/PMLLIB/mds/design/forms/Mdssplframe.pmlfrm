--
-- File:		Mdssplframe.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	       	Tuesday 21st April 1998
--
--
-- Description:
-- Form Definition for Selecting Standard Framework Supports
-- to create a Special Support ie. Combined Structure and Attas
--
--------------------------------------------------------------------------------

-- Kill existing form definition
kill !!Mdssplframe

-- Define Form
Setup Form  !!Mdssplframe

  !!Mdssplframe.formtitle    = |Create a Special Support|
  !!Mdssplframe.icontitle    = |SPLFRAME|
  !!Mdssplframe.callback     = ||
  !!Mdssplframe.formrevision = | $Revision: 1.1.19.1 $ |

--------------------------------------------------------------------------------

-- Body of Form
    frame .special |Special Support| at x0 y0
      para .sttname at x0.5 ymax text |Name:   |
      para .strname at xmax.sttname+1 ymin width 27 lines 1
      para .sttnumb at x0.5 ymax text |Number: |
      para .strnumb at xmax.sttnumb+1 ymin width 27 lines 1
    exit

    frame .select |Select Existing Support| at x0 ymax+0.5
      text   .name   |Support Name | at x1 ymax call |call !!Mdsselectsupp('SPECIAL','NAME','VERBOSE')| width 21 name
      !!Mdssplframe.name.val = 'unset'
      halign right
      path down
      button .cursor | Identify By Cursor | call |call !!Mdsselectsupp('SPECIAL','CURSOR','VERBOSE')|
      button .ce     | CE | at x0.5 ymin    call |call !!Mdsselectsupp('SPECIAL','CE','VERBOSE')|
    exit

    frame .option |Options| at x0 ymax+0.5
      button .add    |  Add Support   | at x0.5 ymax call |call !!Mdsspllist('ADD')|
      button .remove | Remove Support | at xmax+2.25 ymin call |call !!Mdsspllist('REMOVE')|
      list   .list   | Support List to Create a Special| at x1.25 ymax+0.5 call || width 33 length 8
      para   .pmaster at x0.5 ymax text |Master Support is:- |
      para   .tmaster at x0.5 ymax  width 27 lines 1
      button .master |  Use Selected Support as Master  | at x1.5  ymax call |call !!Mdssplmaster()|
    exit

-- Bottom Line
    button .ok     |   OK   |    at x0 ymax+0.5 call |call !!kactioncommands(!!Mdssplframe.applyform)|
    button .cancel |  Cancel | at xmax form-size ymin call |call !!kactioncommands(!!Mdssplframe.dismissform)|

--------------------------------------------------------------------------------

--  Other Form Members
    ------------------

-- Set Support Object
    member .support      is MdsSUPPORT

-- List of current support members
    member .supportmem   is ARRAY

-- Reset all Structural Original Data ( NOT Currently Used)
    member .reset        is ARRAY

-- Store Original Data for Structural SCTNs and SUBS
    member .store        is ARRAY

-- List of all special support members
    member .specialmem   is ARRAY

-- List of SCTN Original Orientations all special support SCTN members
    member .sctnori      is ARRAY

-- List of actions to be taken on applying form
    member .applyform    is ARRAY

-- List of actions to be taken on dismissing form
    member .dismissform  is ARRAY

-- Support Model Graphical Representation
    member .repre        is ARRAY

exit

-- End Form Definition


--------------------------------------------------------------------------------

-- Populate gadgets

-- Action on 'OK' button
    !!Mdssplframe.applyform[1] = |!!Mdssplframecr()|
    !!Mdssplframe.applyform[2] = |!!Mdscleargadgets(!!Mdssplframe)|
    !!Mdssplframe.applyform[3] = |!!Mdsclearspl(!!Mdssplframe)|

-- Action on 'CANCEL' button
    !!Mdssplframe.dismissform[1] = |!!Mdscancelsupp(!!Mdssplframe)|
    !!Mdssplframe.dismissform[2] = |!!Mdsclearspl(!!Mdssplframe)|

-- End of file Mdssplframe.frm
