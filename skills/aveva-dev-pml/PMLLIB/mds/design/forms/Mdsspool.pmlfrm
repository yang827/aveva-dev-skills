--
-- Description:
-- Form definition for the spooling
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsSpool

-- Define Form
Setup Form !!MdsSpool

  !This.formtitle    = |Framework Spooling|
  !This.icontitle    = |Spooling|
  !This.callback     = ||
  !This.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form

  option .SpoolNum |Spool                     |   call |!This.Selected()| at x1  ymax+0.2 width 4
  path right
  list .SpoolMem |Members| at x1 ymax+0.2 width 30 height 4

  path down

  para .text text 'Spool'
  path right
  button .Add | New | call |!This.add()|
  button .Remove | Remove | call |!This.remove()|
  button .AddTo | Add | call |!This.addspool()|
  button .Renumber | Renumber | at xmin.Add ymax+0.2 call |!This.renumber()|

  -- Bottom Line

  toggle .highlight 'Highlight' at x1 Ymax+1 call '!this.highlight()'
  path right
  button .Dismiss  at xmax+11 ymin | Dismiss | call |!This.Cancel()|

  -- Form Members

  member .form is FORM

-- End form definition
exit

define method .init(!form is FORM)

  -- Check to see if any steelwork has been created yet

  !Stru = !Form.Support.Stru.name
  !Sctns = Array()

  var !Sctns coll all sctn for $!Stru

  if !Sctns.empty() then
    !!Alert.error('Unable to create spools as no steelwork has been created!')
    return
  endif

  -- Set form member

  !This.Form = !Form

-- Set highlight toggle to false

  !This.highlight.val = false

  -- Set the spools and sctns lists

  !This.Set(!form)

  -- Show form

  !This.show()

endmethod

define method .set(!form is FORM)

-- Obtain all steelwork section from stru

  !Stru = !Form.Support.Stru.name
  !Sctns = Array()

  var !Sctns coll all sctn for $!Stru

  var !spools eval :mdsspool for all from !Sctns
  !SpoolNum = Array()

  do !SetSpool values !Sctns

    !SpoolNum.append (!SetSpool.dbref().:MdsSpool)

  enddo

  !SpoolNum.sort()
  !SpoolNum.sortunique()

  -- Add the spool numbers to the spool list

  !This.SpoolNum.Dtext = !SpoolNum

  -- Select the first spool number

  !This.SpoolNum.Val = 1

  -- Generate the list of sctns for the selected spool

  !This.Selected()

endmethod

define method .selected()

-- Get form name

  !Form = !This.form

-- Add all the names of sctns that belong to the section

  !Stru = !Form.Support.Stru.name
  !Sctns = Array()
  var !Sctns coll all sctn for $!Stru
  !SctnList = Array()

  do !AddSctn values !Sctns

    if !AddSctn.dbref().:MdsSpool.string().eq(!This.spoolnum.selection().string()) then
      !SctnList.append(!Addsctn.dbref().name)
    endif

  enddo

  -- Set list of sctns that belong to the spool

  !This.SpoolMem.Dtext = !SctnList

  -- Rset highlighting if needed

  !This.Highlight()

endmethod

define method .highlight()

-- Highlight elements in current spool selection if toggle is true

  !Form = !This.form

  !Sctns = !This.SpoolMem.dtext
  !TextNum = 300

  !CE = !!CE
  do !SpoolText from 300 to 320
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!SpoolText
    !Colour = !!GphColOpt.highlight().code
    !!CE = !Form.Support.Stru
    enhance ce col $!Colour
  enddo
  !!CE = !CE

  if !This.highlight.val then

    do !HighLight values !Sctns
      !SpoolNum = !HighLight.dbref().:MDSSpool
      var !Mid midp of $!Highlight wrt /*
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!TextNum $<Spool $!SpoolNum$>  $<$!MID$>
      !Textnum = !textnum + 1
      !CE = !!CE
      !!CE = !HighLight.dbref()
      enhance ce col 2
      !!CE = !CE
    enddo

  endif

endmethod

define method .add()

-- Add a num spool number, obtain the last number used from the list

  !ValuesUsed = !This.SpoolNum.Dtext.size()
  !NewValue = !ValuesUsed + 1
  !Dtext = !This.SpoolNum.Dtext
  !Dtext.append('$!NewValue')
  !This.SpoolNum.Dtext = !Dtext

-- Select the new spool number

  !This.SpoolNum.Select('DTEXT',!NewValue.String())

  !This.selected()

-- reset highlighting

  !This.HighLight()


endmethod

define method .remove()

-- Is there only one spool therefore cannot remove it

  if !This.Spoolnum.Dtext.size().eq(1) then
    !!Alert.error('Unable to remove spool as there is only one')
    return
  endif

-- Remove currently selected spool number, it must be the last spool number

  !Spools = !This.SpoolNum.dtext.size()
  !LastOne = !This.SpoolNum.Dtext[$!Spools]

  if !LastOne.neq(!This.SpoolNum.Selection()) then
    !!Alert.error('Unable to remove spool as it is not the last spool')
    return
  endif

-- So its the last spool number, if it has no members associated withit then remove it
-- without asking the user.

  if !This.SpoolMem.Dtext.size().eq(0) then
   !Dtext = !This.SpoolNum.Dtext
   !Dtext.RemoveLast()
   !NewSize = !Dtext.size()
   !This.SpoolNum.Dtext = !Dtext
   !This.SpoolNum.select('DTEXT','$!NewSize')
  else
    if !!Alert.Confirm('Are you sure that you want to remove spool ' + !This.SpoolNum.Selection() + '. It will be added to spool 1').eq('YES') then
      do !SetAsOne values !This.SpoolMem.dtext
        !!CE = !SetAsOne.dbref()
        :MdsSpool '1'
      enddo
    endif
  endif

  !This.set(!This.Form)

endmethod

define method .cancel()

-- Remove spool numbers from graphical view if toggle set

  !Num = !This.SpoolMem.dtext.size()
  !TextNum = 300
  if !This.HighLight.val then
    do from 1 to $!Num
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!TextNum
      !Textnum = !textnum + 1
    enddo
  endif

-- Repaint the stru with the highlight colour

  !ce = !!CE
  !Colour = !!GphColOpt.highlight().code
  !!CE = !This.Form.Support.Stru
  enhance ce col $!Colour
  !!CE = !CE

-- Obtain all steelwork section from stru

  !Form = !This.form
  !Stru = !Form.Support.Stru.name
  !Sctns = Array()

  var !Sctns coll all sctn for $!Stru

  var !spools eval :mdsspool for all from !Sctns
  !spools.sort()
  !spools.sortunique()

-- Does the spool list start at 1

  if !Spools[1].real().neq(1) then
    !!Alert.error('Spool number 1 if missing or has no members, unable to dismiss form. Please use renumber!.')
    return
  endif

-- Check to see if all the spools have members

  do !TestMembers values !This.SpoolNum.Dtext
    if !Spools.Find(!TestMembers).unset() then
      !!Alert.error('A Spool number is allocated but does not contain any members, unable to dismiss form. Please use renumber or add a section to the spool.')
      return
    endif
  enddo

  !This.hide()

endmethod

define method .AddSpool()

-- Identify sctn that is required to be added to the selected spool

  id sctn @
    handle (61,528)
      return
    endhandle

  !Sctn = !!CE

-- Does the section belong to the selected support

  !Form = !This.form

  !Stru = !!ce.owner.owner
  if !Stru.neq(!Form.support.stru) then
    !!Alert.error('Selected section does not belong to support ' + !Form.Support.Stru.name)
    return
  endif

-- Can only modify the sctn if we can write to it

  if !!MdsComClaimDac(!!ce,'DACMOD','POS').not() then
    !!Alert.Error('Unable to modify the spool identifier as write access is not available to the section')
    return
  endif

-- Is the sctn already a member of the spool

  if !!CE.:MdsSpool.eq(!This.SpoolNum.Selection()) then
    !!Alert.error('Selected section already belongs to spool ' + !This.SpoolNum.Selection())
    return
  endif

-- Add the sctn to the spool number, save old spool number to
-- see if its the last member of that spool

  !Num = !This.SpoolNum.Selection().string()
  !OldSpoolNum = :MdsSpool
  :MdsSpool '$!Num'

-- Generate the list of sctns for the selected spool

  !This.Selected()

-- Check of old spool number

  var !Sctns coll all sctn for $!Stru
  var !Spools eval :MdsSpool for all from !sctns
  if !Spools.Find(!Num).unset() then
    !!Alert.Error('no spools remaining')
  endif

  !This.HighLight()

endmethod

define method .Renumber()

-- Method to renumber spools in the correct order

  !Stru = !This.form.support.stru
  !Form = !This.form
  var !Sctns coll all sctn for $!Stru
  var !Dtext eval :MdsSpool for all from !sctns
  !Dtext.sort()
  !Dtext.sortunique()
  !Rtext = Array()
  do !SetRtext from 1 to !Dtext.size()
    !Rtext.Append(!SetRtext)
  enddo

-- Reset spool numbers

  do !SetSpool values !Sctns
    !!CE = !SetSpool.dbref()
    !OSpool = :MDSSpool
    !NSpool = !Dtext.find(!OSpool)
    :MdsSpool '$!NSpool[1]'
  enddo

-- Select spool 1

  !This.SpoolNum.val = 1

-- Reset list gadget

  !This.set(!form)

-- Redisplay aidtext if selected

  !This.highlight()

endmethod

-- End of file MdsSpool.frm
