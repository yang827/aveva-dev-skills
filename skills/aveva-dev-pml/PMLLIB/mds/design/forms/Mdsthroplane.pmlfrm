--
-- File:		Mdsthroplane.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FPLANE
--
-- Author:		I.Osborne
-- Created:		Fri May 23
--
--
-- Description:
-- Form Definition movement through a plane
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsThroPlane

-- Define Form
Setup Form  !!MdsThroPlane at xr0 yr0

  !!MdsThroPlane.formtitle    = |Plane Through|
  !!MdsThroPlane.icontitle    = ||
  !!MdsThroPlane.callback     = ||
  !!MdsThroPlane.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    para .Name     at x0 text |Name:|
    para .DbPos at xmax+2 ymin width 20 lines 1

    -- Plane Creation
    frame .PlaneData |Creation|   at x0 ymax
      text .Plan     |Direction | at x1 y1 Call |CALLG UCHKDIR $<$$_PLAN$> _PLAN| width 15 string
      halign right
      path down
      option .Select |Through | Call |Call !!MdsThroSelect(!!MdsThroPlane)| width 13

      para .P        at x1 ymax+0.2         width 20 lines 1
    exit

  -- Bottom line
    button .Ok     at x0 ymax+0.2          | Apply | Call |Call !!MdsCreatePlane(!!MdsThroPlane.SuppForm)|ok
    button .Dismiss at xmax form-size ymin |Dismiss| Call |AXES DELETE| cancel

  -- Form Members
    -- Support form calling this action
    member .SuppForm   is FORM

    -- Position of support
    member .Position   is POSITION

-- End form definition
exit

  -- Populate option gadgets
    !Dtext = ARRAY()
    !Dtext.append(|Cursor|)
    !Dtext.append(|ID Cursor|)
    !Dtext.append(|ID P-Point|)
    !Dtext.append(|Name...|)
    !Dtext.append(|Coordinate...|)
    !Dtext.append(|Pin...|)
    !Dtext.append(|Next|)
    !Dtext.append(|Tail|)
    !Dtext.append(|Previous|)
    !Dtext.append(|Head|)
    !Dtext.append(|Current|)

    !Rtext = ARRAY()
    !Rtext.append(|CUR|)
    !Rtext.append(|IDCUR|)
    !Rtext.append(|IDP|)
    !Rtext.append(|NAME|)
    !Rtext.append(|COORD|)
    !Rtext.append(|PIN|)
    !Rtext.append(|NEXT|)
    !Rtext.append(|TAIL|)
    !Rtext.append(|PREV|)
    !Rtext.append(|HEAD|)
    !Rtext.append(|CE|)

    !!MdsThroPlane.Select.Dtext = !Dtext
    !!MdsThroPlane.Select.Rtext = !Rtext

-- End of file Mdsthroplane.frm
