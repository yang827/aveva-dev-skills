--
-- File:    Mdstrunmat.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:
--
--
-- Description:
-- Form Definition for selecting trunnion material
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(FORM)                       -
--  selectTube(STRING)               -
--  set(FORM)                        -
--

-- Kill existing form definition
kill !!mdsTrunMat

-- Define Form
setup form  !!mdsTrunMat
  !!mdsTrunMat.formtitle    = |Select Trunnion Material|
  !!mdsTrunMat.icontitle    = |TrunMat|
  !!mdsTrunMat.callback     = ||
  !!mdsTrunMat.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  list .specs |Select Material:| at x1 y0.5 width 60 length 10
  path down
  vdist 1
  -- Bottom Line
  button .ok     |   OK   | at x0 ymax call || ok
  path right
  button .cancel | Cancel | at xmax form-8 cancel

  --------------------------------------------------------------------------------
  --<wd>mar2003
  -- Form members added to enable Upper and Lower Trunnion Material Selection
  -- for Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28'
  --<wd>may2003
  -- for Trunnion Types 'TT08','TT09' and 'TT20'
  --<wd>may2003
  member .actions is ARRAY
  member .selelowtrun is BOOLEAN

  member .arrayMulti is  ARRAY
  member .arrayStyp is ARRAY

  --<wd>mar2003
  --------------------------------------------------------------------------------

exit
-- End form definition

--------------------------------------------------------------------------------
define method .init(!form is FORM)

  !currentUnits = !!kGetSetUnits()

  -- Set the Form Title Back to Default
  !this.formtitle = |Select Trunnion Material|

  -- Save db position
  !origin = !!ce

  -- If a specifications exist with a purp of TRUN use these instead of the piping specs
  !worl  = object DBREF()
  !tSpecs = !!kcollectAllFor('SPEC','purp eq |TRUN|',!worl)
  if !tSpecs.size().eq(0) then
    !specs = !!kcollectAllFor('SPEC','purp eq |PIPE|',!worl)
  else
    !specs = !tSpecs
  endif

  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Go to each spec and find the tube component
  --!ce = !!ce
  !atta = !form.support.datum
  !branSpec = !form.support.datum.owner.owner.pspe

  -- Find out what the SHOP flag of the STANDARD is and only load that TYPE
  !bore     = pa bore of $!atta
  !phBore   = ph bore of owner of $!atta
  !standard = !form.support.type

  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --!shopFlag = !!mdsPar$!standard[$!phBore].shop
  --
  -- Determine the Trunnion DEFAULTS DATA
  !mdstrunobj  = object MDSREADTRUNDATA()
  !mdstrundata = !mdstrunobj.mdstrundata(!standard, !phBore.real())

  -- TEMPORARY GLOBAL VARUIABLE used for QUERYING etc...
  !!matobj = !mdstrunobj

  -- CHECK if Trunnion DEFAULTS DATA OK in the MDS DEFAULTS PARAGON DATABASE CATA
  if (!mdstrundata.not()) then
    -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
    if (!mdstrunobj.mdsstd.sactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
      !errormessage = !mdstrunobj.mdsstd.smess
    elseif (!mdstrunobj.mdsstd.cactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
      !errormessage = !mdstrunobj.mdsstd.cmess
    endif
    return

  else
    -- Trunnion DATA is OK, so GET and SET the Trunnion SHOP Flag
    !unusedshopFlag = !mdstrunobj.shop

  endif
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------

  !this.arrayMulti = ARRAY()
  !this.arrayStyp = ARRAY()
  do !foundSpecs values !specs
    !!ce = !foundSpecs
    !mem = mcount
    do !count from 1 to !mem
      $!count
      if !!ce.type.eq('SELE') then
        if !!ce.tans.eq('TUBE') then
          -- Find all spcoms for the tube selector
          var !spcoms coll all spcom for ce
          var !styps eval styp for all from !spcoms
          if !styps.sortunique().size().gt(1) then
            !multi = TRUE
          else
            !multi = FALSE
          endif
          -- Loop through spcoms and get the correct bore
          do !getBore values !spcoms
            !!ce = !getBore.dbref()
            !params = para of catref
            -- Convert param 1 to nearest bore to take account of bores being set to actual bores
            -- and not nominal
            !nearestBore = !params[1].nearestBore()
            --<dw>mar2009 dun1119 - Ignore spcoms where params unset.
            handle any
              skip
            endhandle
            --<dw>mar2009 dun1119 - End ignore spcoms.
            -- if !params[1].string().eq(!bore.string().before('mm')) then
            if !nearestBore.string().before('mm').eq(!bore.string().before('mm')) then
              !desc = rtext of detref
              handle (2,102)
                --<wd>17apr2003
                -- handle (2,102) added for SPCO for TUBE which has NO DETAIL REFERENCE SET in the PIPING SPEC
                skip
              endhandle
              --<wd>17apr2003
              !matl = xtex of matxt
              handle any
                !matl = ' '
              endhandle
              !this.arrayMulti.append(!multi)
              !styp = styp
              !this.arrayStyp.append(!styp)
              if !foundSpecs.eq(!branSpec) then
                !dtext.append('(Parent Pipe)' + !foundSpecs.name & ' ' & !desc & ' ' & !matl)
                !rtext.append(!foundSpecs.name)
              else
                !dtext.append('             ' + !foundSpecs.name & ' ' & !desc & ' ' & !matl)
                !rtext.append(!foundSpecs.name)
              endif
            endif
          enddo
        endif
      endif
      spec
    enddo
  enddo
  -- load the specs into the form
  !!mdsTrunMat.specs.clear()
  !!mdsTrunMat.specs.clear()
  !dtextSave = !dtext
  !rtextSave = !rtext
  !dtext.unique()
  !rtext.unique()

  -- Check if the dtext and rtext sizes are the same, if not then there are duplicate spec name in the
  -- current mdb, therefore reset back before they were made unique
  if !dtext.size().neq(!rtext.size()) then
    !dtext = !dtextSave
    !rtext = !rtextSave
  endif
  !!mdsTrunMat.specs.dtext = !dtext
  !!mdsTrunMat.specs.rtext = !rtext

  -- set action for form
  !!kShowForm(!!mdsTrunMat)

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  --<wd>feb2003
  if (!form.eq(!!mdstt23)) then
    -- Set the Form Title Back to Suit MDSTT23
    !this.formtitle = |Select Lower Trunnion Material|
    -- Get the Spec of the LSTU of the Lower 'CS' Break Out Plate(AC48) and Select it if Possible
    do !indx indices !form.support.atta
      if (!form.support.atta[!indx].styp.eq('AC48')) then
        !lstu = !form.support.atta[!indx].lstu
        !spec = name of spec of $!lstu
        !this.specs.select('rtext','$!spec')
        handle any
        endhandle
        break
      endif
    enddo

    --------------------------------------------------------------------------------
    --<wd>mar2003
    --<wd>may2003
    --elseif (!form inset (!!mdstt06,!!mdstt07,!!mdstt10,!!mdstt11,!!mdstt22)) then
  elseif (!form inset (!!mdstt06,!!mdstt07,!!mdstt08,!!mdstt09,!!mdstt10,!!mdstt11,!!mdstt20,!!mdstt22,!!mdstt28)) then
    --<wd>may2003

    -- Ensure Variable !this.selelowtrun is set
    if (!this.selelowtrun.unset()) then
      !this.selelowtrun = false
    endif

    if (!this.selelowtrun.not()) then
      -- Select the Upper Trunnion Material

      -- Set the Form Title Back to Suit MDSTT06, MDSTT07, MDSTT10, MDSTT11, MDSTT22, MDSTT28
      --<wd>may2003
      -- Set the Form Title Back to Suit MDSTT08, MDSTT09, MDSTT20
      --<wd>may2003
      !this.formtitle = |Select Upper Trunnion Material|

      -- Get the Spec of the HSTU of the Trunnion Branch and Select it if Possible
      !hstu = !form.support.datum.owner.pspe.name
      !this.specs.select('rtext','$!hstu')
      handle any
      endhandle

      -- Set LOWER Trunnion Material Selector to FALSE
      !this.selelowtrun = false

    else

      -- Select the Lower Trunnion Material
      -- Set the Form Title Back to Suit MDSTT06, MDSTT07, MDSTT10, MDSTT11, MDSTT22, MDSTT28
      --<wd>may2003
      -- Set the Form Title Back to Suit MDSTT08, MDSTT09, MDSTT20
      --<wd>may2003
      !this.formtitle = |Select Lower Trunnion Material|

      --<wd>may2003
      if (!form inset (!!mdstt06,!!mdstt07,!!mdstt10,!!mdstt11,!!mdstt22,!!mdstt28)) then
        --<wd>may2003
        -- Get the Spec of the LSTU of the Collar Plate(AC20) and Select it if Possible
        do !indx indices !form.support.atta
          if (!form.support.atta[!indx].styp.eq('AC20')) then
            !lstu = !form.support.atta[!indx].lstu
            !spec = name of spec of $!lstu
            !this.specs.select('rtext','$!spec')
            handle any
            endhandle
            break
          endif
        enddo
        --<wd>may2003
      elseif (!form inset (!!mdstt08,!!mdstt09)) then
        -- Get the Spec of the LSTU of the Breaking Plate(AC27) and Select it if Possible
        do !indx indices !form.support.atta
          if (!form.support.atta[!indx].styp.eq('AC27')) then
            !lstu = !form.support.atta[!indx].lstu
            !spec = name of spec of $!lstu
            !this.specs.select('rtext','$!spec')
            handle any
            endhandle
            break
          endif
        enddo
      elseif (!form inset (!!mdstt20)) then
        -- Get the Spec of the LSTU of the Breaking Plate(AC32) and Select it if Possible
        do !indx indices !form.support.atta
          if (!form.support.atta[!indx].styp.eq('AC32')) then
            !lstu = !form.support.atta[!indx].lstu
            !spec = name of spec of $!lstu
            !this.specs.select('rtext','$!spec')
            handle any
            endhandle
            break
          endif
        enddo
      endif
      --<wd>may2003

      -- Set LOWER Trunnion Material Selector to TRUE
      !this.selelowtrun = TRUE

    endif
    --<wd>mar2003
    --------------------------------------------------------------------------------

  else

    --  Otherwise Get the Spec of the Trunnion branch HSTU and set it if possible
    !hstu = !form.support.datum.owner.pspe.name
    !this.specs.select('RTEXT','$!hstu')
    handle any
    endhandle

  endif
  --<wd>feb2003
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------

  -- Modify OK callback to use correct calling form
  !!mdsTrunMat.ok.callback = '!!mdsTrunMat.set(!!$!form)'

  --------------------------------------------------------------------------------
  --<wd>mar2003
  -- Check for Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28'
  --<wd>may2003
  -- Check for Trunnion Types 'TT08','TT09' and 'TT20'
  -- Change OK Callback accordingly
  --if (!form inset (!!mdstt06,!!mdstt07,!!mdstt10,!!mdstt11,!!mdstt22)) then
  if (!form inset (!!mdstt06,!!mdstt07,!!mdstt08,!!mdstt09,!!mdstt10,!!mdstt11,!!mdstt20,!!mdstt22,!!mdstt28)) then
    --<wd>may2003
    if (!this.selelowtrun.not()) then
      -- Modify OK callback to set the Upper Trunnion Material and then re-Show this FORM
      -- to Select the Lower Trunnion Material
      !this.actions[1]  = '!!mdsTrunMat.set(!!$!form)'
      !this.actions[2]  = '!!mdsTrunMat.init(!!$!form)'
      !this.ok.callback = '!!kactioncommands(!this.actions)'

    else
      -- Modify OK callback to set the LOWER Trunnion Material and Reset it to the Standard Callback
      !this.ok.callback = '!!mdsTrunMat.set(!!$!form)'

    endif
  endif
  --<wd>mar2003
  --------------------------------------------------------------------------------

  !!ce = !origin

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

endmethod

--------------------------------------------------------------------------------
define method .set(!form is FORM)

  --------------------------------------------------------------------------------
  --<wd>feb2003
  -- Trunnion Type 'TT23' is in TWO PARTS:
  -- The Upper Trunnion Pipe Material - WELDED to the MAIN Pipe MUST be the SAME MATERIAL as the MAIN PARENT Pipe
  -- The Upper Trunnion Pipe Material - is FIXED and set AUTOMATICALLY on Creation to the Parent Pipe
  -- The Lower Trunnion Pipe Material - SHOULD be STD WT. Carbon Steel Pipe, BOLTED via the COLD Isolation Block and Plates(AC46,41,47) to the Upper Trunnion Pipe
  -- The Lower Trunnion Pipe Material - MUST be SELECTED by the USER from the !!mdsTrunMat form
  --<wd>feb2003
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  --<wd>mar2003
  -- Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28' are in TWO PARTS:
  --<wd>may2003
  -- Trunnion Types 'TT08','TT09' and 'TT20' are in TWO PARTS:
  --<wd>may2003

  -- The Upper Trunnion Pipe Material - WELDED to the MAIN Pipe and Defaults to the SAME MATERIAL as the MAIN PARENT Pipe
  -- The Upper Trunnion Pipe Material - Defaults to the MAIN PARENT PIPE Material, but the USER has the Option to RESELECT the Material

  -- Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28' are in TWO PARTS:
  -- The Lower Trunnion Pipe Material - SHOULD be STD WT. Carbon Steel Pipe, WELDED via the COLLAR(AC20) to the Upper Trunnion Pipe

  --<wd>may2003
  -- Trunnion Types 'TT08' and 'TT09' are in TWO PARTS:
  -- The Lower Trunnion Pipe Material - Pipe Material, WELDED via the Plate(AC27) to the Upper Trunnion Pipe

  -- Trunnion Type  'TT20' is in TWO PARTS:
  -- The Lower Trunnion Pipe Material - Pipe Material, WELDED via the Plate(AC32) to the Upper Trunnion Pipe
  --<wd>may2003

  -- The Lower Trunnion Pipe Material - MUST be SELECTED by the USER from the !!mdsTrunMat form
  --<wd>mar2003
  --------------------------------------------------------------------------------

  -- Navigate to branch and set hstu and all elements to set lstu
  !!ce = !form.support.datum
  handle ANY
    return
  endhandle
  branch
  !selectedSpec = !!mdsTrunMat.specs.selection()
  !!mdsDacControl(true)

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  --<wd>feb2003
  -- Trunnion Type TT23 Only - Reset LSTU from Branch Member - ATTA #4 to Last Member
  if (!form.eq(!!mdstt23)) then
    !bmc = !!ce.mcount()
    do !indx from 4 to !bmc
      branch
      $!indx
      !this.selectTube('lstu')
    enddo
    -- Set the Form Title Back to Default
    !this.formtitle = |Select Trunnion Material|

    --------------------------------------------------------------------------------
    --<wd>mar2003
  elseif (!form inset (!!mdstt06,!!mdstt07,!!mdstt10,!!mdstt11,!!mdstt22,!!mdstt28)) then

    -- Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28' are in TWO PARTS:
    -- Reset LSTU from Branch Member - #3 to Last Member
    if (!this.selelowtrun) then
      !bmc = !!ce.mcount()
      do !indx from 3 to !bmc
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Default
      !this.formtitle = |Select Trunnion Material|

      -- Set LOWER Trunnion Material Selector to FALSE
      !this.selelowtrun = false

      -- Clear the !this.actions form member array
      --      !this.actions.clear()

    else

      -- Set the HSTU of the Trunnion Branch and the LSTU of ONLY Branch Members #1 and #2
      -- for Trunnion Types 'TT06','TT07','TT10','TT11','TT22' and 'TT28' ONLY:
      pspe $!selectedSpec
      !this.selectTube('hstu')
      --do !branMem values !!ce.members
      --  !!ce = !branMem
      do !indx from 1 to 2
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Suit MDSTT06, MDSTT07, MDSTT10, MDSTT11, MDSTT22, MDSTT28
      --!this.formtitle = |Select Lower Trunnion Material - (STD Weight CS Pipe?)|
      !this.formtitle = |Select Lower Trunnion Material|

      -- Set LOWER Trunnion Material Selector to TRUE
      !this.selelowtrun = true

    endif

    --<wd>mar2003
    --------------------------------------------------------------------------------

    --------------------------------------------------------------------------------
    --<wd>may2003
  elseif (!form inset (!!mdstt08,!!mdstt09)) then

    -- Trunnion Types 'TT08' and 'TT09' are in TWO PARTS:
    -- Reset LSTU from Branch Member - #4 to Last Member
    if (!this.selelowtrun) then
      !bmc = !!ce.mcount()
      do !indx from 4 to !bmc
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Default
      !this.formtitle = |Select Trunnion Material|

      -- Set LOWER Trunnion Material Selector to FALSE
      !this.selelowtrun = false

      -- Clear the !this.actions form member array
      --      !this.actions.clear()

    else

      -- Set the HSTU of the Trunnion Branch and the LSTU of ONLY Branch Members #1, #2 and #3
      -- for Trunnion Types 'TT08 'and 'TT09' ONLY:
      pspe $!selectedSpec
      !this.selectTube('hstu')
      do !indx from 1 to 3
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Suit MDSTT08, MDSTT09
      !this.formtitle = |Select Lower Trunnion Material|

      -- Set LOWER Trunnion Material Selector to TRUE
      !this.selelowtrun = true

    endif

    --<wd>may2003
    --------------------------------------------------------------------------------

    --------------------------------------------------------------------------------
    --<wd>may2003
  elseif (!form inset (!!mdstt20)) then

    -- Trunnion Typs 'TT20' is in TWO PARTS:
    -- Reset LSTU from Branch Member - #4 to Last Member
    if (!this.selelowtrun) then
      !bmc = !!ce.mcount()
      do !indx from 4 to !bmc
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Default
      !this.formtitle = |Select Trunnion Material|

      -- Set LOWER Trunnion Material Selector to FALSE
      !this.selelowtrun = false

      -- Clear the !this.actions form member array
      --      !this.actions.clear()

    else

      -- Set the HSTU of the Trunnion Branch and the LSTU of ONLY Branch Members #1, #2 and #3
      -- for Trunnion Type 'TT20' ONLY:
      pspe $!selectedSpec
      !this.selectTube('hstu')
      do !indx from 1 to 3
        branch
        $!indx
        !this.selectTube('lstu')
      enddo

      -- Set the Form Title Back to Suit MDSTT20
      !this.formtitle = |Select Lower Trunnion Material|

      -- Set LOWER Trunnion Material Selector to TRUE
      !this.selelowtrun = true

    endif

    --<wd>may2003
    --------------------------------------------------------------------------------


  else

    !this.selectTube('hstu')
    --!this.selectTube('hstu')
    pspe $!selectedSpec
    do !branMem values !!ce.members
      !!ce = !branMem
      --!this.selectTube('lstu')
      !this.selectTube('lstu')
    enddo

  endif
  --<wd>feb2003
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------

  !!mdsDacControl(false)

endmethod

--------------------------------------------------------------------------------
define method .selectTube(!type is STRING)

  --!type is hstu or lstu

  -- method to set e.g. sel lstu with spec /A150 styp C
  -- this method added as specs may have more than one styp

  !selectedSpec = !!mdsTrunMat.specs.selection()

  !index = !!mdsTrunMat.specs.val

  -- check if !this.arrayMulti is true for selected spec
  -- if true then set styp, if not then no multiple styps and just select spec as previously
  if !this.arrayMulti[!index] then

    !styp = !this.arrayStyp[!index]

    sel $!type with spec $!selectedSpec styp $!styp
  else
    sel $!type with spec $!selectedSpec
  endif
endmethod
