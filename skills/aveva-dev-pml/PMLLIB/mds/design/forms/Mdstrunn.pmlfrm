--
-- Author:  I.osborne
-- Created:  Thu Apr 24
--
--
-- Description:
-- Form Definition for Trunnions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply ()                         -
--  find(GADGET,STRING)              -
--  fromExistingAtta ()              -
--

-- Kill existing form definition
kill !!mdsTrunn

-- Define Form
setup form !!mdsTrunn

  !!mdsTrunn.formtitle    = |Trunnions|
  !!mdsTrunn.icontitle    = ||
  !!mdsTrunn.callback     = |call !!mdsItrunn()|
  !!mdsTrunn.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
  text .name     |Name: | at x0 y0.5 call |CALLIB NAMECHK _mdsTrunn_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
  call !!mdsSupportForm(!!mdsTrunn)
  call !!mdsSetSupp(!!mdsTrunn)| width 20 name

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsAutoName|
  exit

  button .autoname | |  tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsAutoName.getNextName(!this)|
  !this.autoname.setPopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip 'Default Creation Zone' pixmap width 19 height 19 call |Call !!mdsIDfltSite()|

  button .startGroup | | at xmax+1 ymin tooltip 'New Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('NEW',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|
  !this.startGroup.active = FALSE

  path down
  vdist 0.1
  !length = !!mdsFormTru
  handle NONE
  elsehandle ANY
    !length = 23
  endhandle
  list .standard |Standard support type:| at x0 ymax+0.5 call |call !!kActionCommands(!!mdsTrunn.listActions)| width 62 length $!length

  -- Bottom Line
  button .ok     |   OK   | at xmin           ymax call |!this.apply()|
  button .view   | View...| at xmax+1         ymin Call |call !!mdsAddPlot(!!mdsTrunn.standard, 'show',!!mdsTrunn)|
  path right
  -- Modified for defect 10598
  text .find 'Find ' call |!this.find(!this.standard,!this.find.val)| width 10 string
  button .cancel | Cancel | at xmax form-size ymin call |call !!mdsResetAutoName(!this)|

  -- Form Members
  -- Form Name of Support
  member .suppFunction is STRING

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Actions on list button
  member .listActions  is ARRAY

  --<wd>03nov2006<mds12>
  -- Form Loading Members etc...
  member .error is BOOLEAN
  member .emess is STRING
  --<wd>03nov2006<mds12>

  -- End form definition
exit

-- Actions to be taken on list gadget
!!mdsTrunn.listActions[1] = |call !!mdsAddPlot(!!mdsTrunn.standard, '',!!mdsTrunn)|
!!mdsTrunn.listActions[2] = |call !!mdsSupportForm(!!mdsTrunn)|

-- Set icons
!!mdsSetIconBack(!!mdsTrunn,'white')

--<wd>03nov2006<mds12>
-- Set the DEFAULT settings for the form Members
!this.error = TRUE
!this.emess = 'No MDS Trunnions available.'
--<wd>03nov2006<mds12>
-- Added method for defect 10598
define method .find(!gadget is GADGET,!string is STRING)

  -- Try and find string in selection list

  do !loop from 1 to !gadget.dtext.size()
    if !gadget.dtext[$!loop].matchwild('*$!string*') then
      -- Set found index
      !gadget.val = !loop
      -- Get callback and call
      !callback = !gadget.callback
      $!callback
      handle any
      endhandle
      if !callback.eq('!this.setmaster()') then
        !!mdsFrame.setmaster()
      endif
      return
    endif
  enddo

  !!alert.error('Unable to find string ' + !string)

endmethod

define method .fromExistingAtta ()
  !!mdsIdPreliminarySupp(!this)
endmethod

define method .apply ()

  !preliminary = object DBREF('/' & !this.name.val)
  handle any
    call $!this.suppFunction
  elsehandle none
    -- test if the selected item has the same support function as the preliminary support
    -- if no then show warning - if the answer is 'YES' then replace :mdssuppfunc of new atta
    !!ce = !preliminary
    !listChoice = !this.standard.selection()

    --try and find the SUPF entry for !listChoice in the MDS/APPDEFAULTS db
    !appDefName = '/MDS/TRUNNION/DEFAULTS/' + '$!listChoice' + '/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !trunnSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !trunnSuppFunc = $!appDefRef.ppro
    endhandle

    !prelimSuppFunc = !preliminary.:mdssuppfunc

    if ((!trunnSuppFunc neq !prelimSuppFunc) and (!prelimSuppFunc.unset().not() and !prelimSuppFunc.neq(''))) then
      !result = !!alert.confirm('The wrong Ancillary Type has been chosen. The preliminary support has a support function of ' + !prelimSuppFunc + ' but the chosen support function is ' + !trunnSuppFunc + '. Do you want to continue?')
      if (!result eq 'YES') then
        call $!this.suppFunction
      endif
    else
      call $!this.suppFunction
    endif
  endhandle

endmethod
