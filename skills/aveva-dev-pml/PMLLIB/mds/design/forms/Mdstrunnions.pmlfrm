-- Created:		Thursday 11th December 1997
--
--
-- Description:
-- Hidden NONE USER Form stores All Trunnions Types & Sizes foound in spec /MDS
-- This is a SYSTEM form used by the MDS Appware & is NOT generally available to the USERS
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdstrunnions

-- Define Form
  setup form  !!Mdstrunnions noquit

    !!Mdstrunnions.formtitle    = |Spec. MDS|
    !!Mdstrunnions.icontitle    = ||
    !!Mdstrunnions.callback     = ||
    !!Mdstrunnions.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    list .standard |All Trunnion Types:| at x1 y0.5 width 20 length 18

    path down
    vdist 1

-- Bottom Line
    button .cancel | Dismiss | at xmax form-8 ok

-- Additional Form Members to All Store available Trunnions Sizes
-- for All available Pipe Sizes
    member .pdia2   is ARRAY
    member .pdia3   is ARRAY
    member .pdia4   is ARRAY
    member .pdia5   is ARRAY
    member .pdia6   is ARRAY
    member .pdia8   is ARRAY
    member .pdia10  is ARRAY
    member .pdia12  is ARRAY
    member .pdia14  is ARRAY
    member .pdia16  is ARRAY
    member .pdia18  is ARRAY
    member .pdia20  is ARRAY
    member .pdia22  is ARRAY
    member .pdia24  is ARRAY
    member .pdia30  is ARRAY
    member .pdia36  is ARRAY
    member .pdia42  is ARRAY
    member .pdia48  is ARRAY

  exit
-- End form definition

--xxx-- Load ALL Trunnion Types and Sizes into the list gadget .Standard
--xxx  call !!Mdsitrunnions()

-- End of file Mdstrunnions.frm
