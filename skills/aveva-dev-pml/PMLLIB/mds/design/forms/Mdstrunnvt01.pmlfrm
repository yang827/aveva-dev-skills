--
-- Description:
-- BLOCKING-Form Definition for selecting Trunnion items on Vessel Framework Type 'Vt01'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdstrunnvt01

-- Define Form
  setup form  !!Mdstrunnvt01 BLOCKING
--xxx  setup form  !!Mdstrunnvt01

    !!Mdstrunnvt01.formtitle    = |Trunnion Selection|
    !!Mdstrunnvt01.icontitle    = |VT01-Trunnions|
    !!Mdstrunnvt01.callback     = ||
    !!Mdstrunnvt01.formrevision = | $Revision: 1.1.19.1 $ |

--------------------------------------------------------------------------------
-- Body of Form
    list .standard |Select Trunnion Type:| at x1 y0.5 width 60 length 10

    path down
    vdist 1

--------------------------------------------------------------------------------
-- Bottom Line
    button .ok     |   OK   | at x0 ymax call |!!kactioncommands(!!Mdstrunnvt01.action)| ok
--xxx    button .view   | View...| at xmax+1 ymin call |call !!Mdsaddplot(!!Mdstrunnvt01.Standard, 'show',!!Mdstrunnvt01)|

    path right

    button .cancel | Cancel | at xmax form-8 cancel

--------------------------------------------------------------------------------
-- Form Members
-- Actions to be taken on applying form
    member .action  is ARRAY

-- Member to save design parameters in when modifying the type
    member .savedpars is ARRAY

-- Populate gadget
    !!Mdstrunnvt01.action[1] = ||

  exit
-- End form definition
--------------------------------------------------------------------------------

--xxx-- set view gadget inactive until plots are in place...
--xxx   !!Mdstrunnvt01.View.Active   = false

-- End of file Mdstrunnvt01.frm
