--
--
-- Description:
-- Form Definition for selecting TRUNNION Type 'tt27'
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdstt27

--------------------------------------------------------------------------------
-- Define Form
  setup form  !!Mdstt27 at xr0 yr0 noquit

    !!Mdstt27.formtitle    = ||
    !!Mdstt27.icontitle    = |MDS-TT27|
    !!Mdstt27.callback     = ||
    !!Mdstt27.formrevision = | $Revision: 1.1.19.1 $ |

--------------------------------------------------------------------------------
-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------
-- Create Trunnion Atta
    frame .fdatum |Datum| at x0 ymax width 31

      -- button .crelbo at x1 y1         tooltip 'Create on Elbow' pixmap width 18 height 18 call |call !!Mdssetdattt27(!!Mdstt27,'CREATE','ELBO')|
      button .crtube at x1 y1 tooltip 'Create on Tube'  pixmap width 18 height 18 call |call !!Mdssetdattt27(!!Mdstt27,'CREATE','TUBE')|
      -- button .crredu at xmax+0.1 y1 tooltip 'Create on Reducer' pixmap width 18 height 18 call |call !!Mdssetdattt27(!!Mdstt27,'CREATE','REDU')|
      -- button .crcros at xmax+0.1 y1 tooltip 'Create on Cross'   pixmap width 18 height 18 call |call !!Mdssetdattt27(!!Mdstt27,'CREATE','CROS')|
      button .bdist      | Distance | at x1   ymax+0.25       call |call !!Mdsposdtrun(!!Mdstt27)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .bthro      | Through  |  at x1     ymax+0.2        call |call !!Mdsposttrun(!!Mdstt27)|
      option .select             at xmax+1 ymin                  call |call !!Mdsthroselect(!!Mdstt27)| width 13
      button .Bdirection | Direction| at x1 ymax                 call |call !!MdsTrunDir(!!MdsTT27)|
      text   .direction          at xmax+1 ymin     width 14 is string
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------
-- Creation
    frame .fcreate |Dimensions| at x0 ymax width 31

      option .member 'Member      '    at x1 ymax+0.2            call |call !!Mdsselectatta(!!Mdstt27)| width 14
      !Dtext = array()
      !Rtext = array()
      !Dtext.Append('End Plate')
      !Dtext.Append('Bearing Plate')
      !Dtext.Append('Stiffener')
      !Rtext.Append('!!Mdstt27.support.atta[6]')
      !Rtext.Append('!!Mdstt27.support.atta[7]')
      !Rtext.Append('!!Mdstt27.support.atta[8]')
      !This.member.Dtext = !Dtext
      !This.member.Rtext = !Rtext

      text   .plength |Plate Height| at x1   ymax+0.2  call |Call !!MdsModPlate(!!Mdstt27,'PLEN',!!Mdstt27.plength)| width 16 is real format !!distancefmt
      text   .pwidth  |Plate Width | at xmin ymax      call |Call !!MdsModPlate(!!Mdstt27,'PWID',!!Mdstt27.pwidth)| width 16 is real format !!distancefmt
      text   .pthk    |Plate Thk.  | at xmin ymax      call |Call !!MdsModPlate(!!Mdstt27,'PTHK',!!Mdstt27.pthk)| width 16 is real format !!distancefmt
      text   .pdepth  |Fillet Depth| at xmin ymax      call |Call !!MdsModPlate(!!Mdstt27,'DPTH',!!Mdstt27.pdepth)| width 16 is real format !!distancefmt
      text   .tlength |Trun Length | at xmin ymax      call |call !!MdsSetTrunLen('GADGET',!!Mdstt27.tlength.val.real(),!!Mdstt27.support.datum,!!Mdstt27.support.datum.owner.hdir.string(),'TT27',!!Mdstt27)| width 16 is real format !!distancefmt
      para   .mainbore at xmin ymax width 25 lines 1
      option .Bore 'Trunnion Bore       '  at xmin Ymax   call |call !!MdsResetBore(!!Mdstt27)| width 6

    exit

--------------------------------------------------------------------------------
-- Miscellaneous
    frame .fmisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call ||
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call ||
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call ||
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call ||
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call ||
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call ||
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call ||
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call ||

-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call ||
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call ||
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!Mdstt27,'!!MdsRotatett27()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call ||
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call ||
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call ||
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call ||

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call ||
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |call !!Mdssetdattt27(!!Mdstt27,'MODIFY')|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call ||
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!Mdstt27)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call ||
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!Mdstt27)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdstt27,'CONNECT','')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdstt27,'MODIFY','')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |call !!MdsSelectJoints(!!Mdstt27,'FORCECONNECT','')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |call !!Mdsselectjoints(!!Mdstt27,'DISCONNECT','ERROR')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!Mdstt27)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdstt27)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call ||
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25  tooltip 'Trimmer Required'        pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!MdsSetTrunLen('STEEL',!This.tlength.val,!!Mdstt27.Support.Datum,!!Mdstt27.Support.Datum.owner.hdir.string(),'TT27',!!Mdstt27)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!MdsTrunMat.Init(!!Mdstt27)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|


    exit

--------------------------------------------------------------------------------
-- Bottom Line

    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAccepttt27()|

--------------------------------------------------------------------------------
-- Form Members
-- Actions to be taken on applying form
    member .action      is array

-- Support object
    member .support     is MdsSUPPORT

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .ppack       is array

-- Support object storage for support regeneration
    member .backup      is MdsSUPPORT

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

-- Graphical dimensions
    member .GraphicalDim is boolean

-- Members member

    member .setup is array
    !This.Setup.Append('0')
    !This.Setup.Append('0')
    !This.Setup.Append('-100')
    !This.Setup.Append('-0')
    !This.Setup.Append('-0')
    !This.Setup.Append('-0')
    !This.Setup.Append('-0')
    !This.Setup.Append('-0')

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,4,5,6,7,9,10,13,14,15,19,20,21,22,24,29,30,31,32,34,35,36,37,38,41,42,56,57,58,60,61,62'

  exit

--------------------------------------------------------------------------------
-- Populate option gadgets
    call !!Mdsloadoption(!!Mdstt27.select)
-- Matl
$(
   !Dtext = array()
   !Rtext = array()
   !Dtext.append(|Parent|)
   !Dtext.append(|Other|)
   !Rtext.append(|INSPEC|)
   !Rtext.append(|OUTSPEC|)

   !!Mdstt27.Material.Dtext = !Dtext
   !!Mdstt27.Material.Rtext = !Rtext
$)


-- Populate gadget
    !!Mdstt27.action[1] = ||

-- Set background colour of pixmap white

    !!MdsSetIconBack(!!Mdstt27,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdstt27,true)

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false


--------------------------------------------------------------------------------
-- End form definition

-- End of file Mdstt27.frm
