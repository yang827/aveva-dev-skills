--
--
-- Description:
-- Form Definition TRUNNION Type 'tt36' direction selection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  beenPressed(REAL)                -
--


-- Kill existing form definition

kill !!mdstt36sel

-- Define Form

setup form  !!mdstt36sel at xr0 yr0 noquit blocking

  !!mdstt36sel.formtitle    = |Trunnion Direction|
  !!mdstt36sel.icontitle    = |Trun Dir|
  !!mdstt36sel.callback     = ||
  !!mdstt36sel.formrevision = ||

  --------------------------------------------------------------------------------
  -- Body of Form

  button .direction1 '                 ' at x0 y0.5 call |!this.beenPressed(1)|
  path down
  button .direction2 '                 ' call |!this.beenPressed(2)|

  button .cancel  ' Cancel ' at x16 ymax+.5 call |!this.beenPressed(0)|

  --------------------------------------------------------------------------------
  -- Form Members


  -- Which button was pressed
  member .pressed is REAL
  member .direction is STRING

exit

define method .beenPressed(!whichOne is REAL)

  !this.pressed = !whichOne
  !!mdstt36sel.hide()
  !this.direction = (trim(!!mdstt36sel.direction$!whichOne$n.tag))
  handle ANY
  endhandle

endmethod
