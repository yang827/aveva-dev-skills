--
--
-- Description:
-- Form Definition TRUNNION Type 'tt36' direction selection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  beenPressed(REAL)                -
--


-- Kill existing form definition

kill !!mdstt36selprelim

-- Define Form

setup form  !!mdstt36selprelim at xr0 yr0 noquit

  !!mdsTT36selPrelim.formtitle    = |Trunnion Direction|
  !!mdsTT36selPrelim.icontitle    = |Trun Dir|
  !!mdsTT36selPrelim.callback     = ||
  !!mdsTT36selPrelim.formrevision = ||

  --------------------------------------------------------------------------------
  -- Body of Form

  button .direction1 '                 ' at x0 y0.5 call |!this.beenPressed(1)|
  path down
  button .direction2 '                 ' call |!this.beenPressed(2)|

  button .cancel  ' Cancel ' at x16 ymax+.5 call |!this.beenPressed(0)|

  --------------------------------------------------------------------------------
  -- Form Members


  -- Which button was pressed
  member .pressed is REAL
  member .direction is STRING

exit

define method .beenPressed(!whichOne is REAL)

  !this.pressed = !whichOne
  !!mdsTT36selPrelim.hide()
  !this.direction = (trim(!!mdsTT36selPrelim.direction$!whichOne$n.tag))
  handle ANY
  endhandle

  if !whichOne.neq(0) then
    !!mdsTrunnionTypePicker.callElbow()
  endif

endmethod
