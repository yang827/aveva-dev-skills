--
-- File:		MdsTubeSel.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		19 March 1998
--
--
-- Description:
-- Blocking-Form Definition for selecting Tubing for trunnions if their is more
-- than one schedule in the spec for the bore size requested.
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!MdsTubeSel

-- Define Form
  setup form  !!MdsTubeSel BLOCKING

    !!MdsTubeSel.formtitle    = |Tube Material Selection|
    !!MdsTubeSel.icontitle    = |TubeMatl|
    !!MdsTubeSel.callback     = ||
    !!MdsTubeSel.formrevision = | $Revision: 1.1.19.1 $ |


-- Body of Form
    list .Specs |Select Tubing Material:| at x1 y0.5 width 60 length 10

    path down
    vdist 1


-- Bottom Line
    button .OK     |   OK   | at x0 ymax call |!!kactioncommands(!!MdsTubeSel.action)| ok

    path right

    button .Cancel | Cancel | at xmax form-8 cancel


-- Form Members
-- Actions to be taken on applying form
    member .action  is ARRAY

-- Dummy member for passing to !!Mdssetmtor as UNSET

    member .SpecDbref is dbref

-- Populate gadget
    !!MdsTubeSel.action[1] = ||

  exit
-- End form definition



-- End of file MdsTubeSel.frm
