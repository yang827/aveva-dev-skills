--
-- File:		MdsVHanger.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--
-- Author:		A.Boudjnah
-- Created:		Wed March 20  2002
--
--
-- Description:
-- Form Definition for Variable Hangers
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!MdsVHanger

-- Define Form
Setup Form !!MdsVHanger

  !!MdsVHanger.formtitle    = |Variable Hangers|
  !!MdsVHanger.icontitle    = ||
  !!MdsVHanger.callback     = |call !!MdsIvhanger()|
  !!MdsVHanger.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    text .Name     |Name of support   | call |CALLIB NAMECHK _MdsVHanger_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
call !!MdsSupportForm(!!MdsVHanger)
call !!MdsSetSupp(!!MdsVHanger)| width 20 name

    menu .autonamemenu
      add 'Select Naming File...' call |show !!Mdsautoname|
    exit

    button .Autoname |MDS Autoname| call |!!MdsAutoName.GetNextName(!This)|
    !This.AutoName.SetPopup(!This.autonamemenu)


    path down
    vdist 0.1
    list .Standard |Standard support type:| at x0 ymax+0.5 call |!this.setListActions()| width 62 length 14

  -- Bottom Line
    button .Ok     |   OK   | at xmin           ymax call |$$_SuppFunction|
    button .View   | View...| at xmax+1         ymin Call |call !!MdsAddPlot(!!MdsVHanger.Standard, 'show',!!MdsVHanger)|
    button .Filter |Filter List...| at xmax+1 ymin call |!this.formHangerTypes.setFilter(!this)|
    button .Cancel | Cancel | at xmax form-size ymin cancel

  -- Form Members
    -- Form Name of Support
    member .SuppFunction is STRING

    -- Form Name of Support
    member .SuppForm     is FORM

    -- User replacement text for support name
    member .Replacement  is STRING

    -- Save suppFunction for later on list button
    member .OldFunction  is STRING

    -- variable hanger types container
    member.formHangerTypes is MdsHangerTypes

    -- variable filtered hanger types container
    member.filteredHangerTypes is MdsHangerTypes

    -- backup of the standard list dtext
    member.standardDtexBackup is ARRAY

    -- backup of the standard list rtext
    member.standardRtexBackup is ARRAY

--<wd>03nov2006<mds12>
-- Form Loading Members etc...
    member .error is BOOLEAN
    member .emess is STRING
--<wd>03nov2006<mds12>

-- End form definition
exit

--<wd>03nov2006<mds12>
-- Set the DEFAULT settings for the form Members
    !this.error = TRUE
    !this.emess = 'No MDS Variable Hangers available.'
--<wd>03nov2006<mds12>

define method .setListActions()
  call !!MdsAddPlot(!this.Standard, '',!this)
  call !!MdsSupportForm(!this)
  if(!this.oldfunction.set() and !this.oldfunction.neq(||) ) then
    !this.suppfunction = !this.oldfunction
  endif
endmethod


-- End of file MdsVHanger.frm
