--
-- File:		Mdsvt03.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FVS103
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 13th January 1998
--
--
-- Description:
-- Form Definition for Vessel Frameworks Type 'VT03'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdsvt03

-- Define Form
setup form  !!Mdsvt03 at xr0 yr0 noquit

  !!Mdsvt03.formtitle    = ||
  !!Mdsvt03.icontitle    = |MDS - VT03|
  !!Mdsvt03.callback     = ||
  !!Mdsvt03.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatvt03()|
      button .bdist | Distance | at xmin   ymax+0.25       call |call !!kactioncommands(!!Mdsvt03.actionbdist)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |call !!kactioncommands(!!Mdsvt03.actionbthro)|
      option .select             at xmax+1 ymin            call |call !!Mdsthroselect(!!Mdsvt03)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------

-- Creation
    frame .fcreate |Create| at x0 ymax width 31

      -- option .size   |Size | at x1 y1 call |call !!Mdsresize(!!Mdsvt03)| width 20

      -- path down
      -- para .create text |Create by      |
      -- path right

      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsVt03,'-BAR-1','-TIE-1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateVt03('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateVt03('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateVt03('CLEARANCE')|

      path down
      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt
      text   .dim2   |Dim 2     | at xmin ymax call |call !!Mdsclearvt(!!Mdsvt03)| width 16 is real format !!DistanceFmt

    exit

--------------------------------------------------------------------------------

-- Miscellaneous
    frame .fmisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsVt03)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsVt03)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsVt03)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarVt03(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorVt03()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsVt03)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!MdsVt03)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsVt03)|


-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!MdsVt03)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!MdsVt03)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |call !!kactioncommands(!!Mdsvt03.actionrotate)|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!MdsVt03)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsVt03,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsVt03)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsVt03)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsVt03,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |call !!kactioncommands(!!Mdsvt03.actionmodatta)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsVt03)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsVt03)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsVt03)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsVt03)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .dim      at xmax+0.1 ymin pixmap width 18 height 18 call ||
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!Mdsvt03)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsVt03,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
--<GE> 12/02/07 Fix for Defect: 10240
      -- button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
--<GE> 12/02/07
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|

    exit

--------------------------------------------------------------------------------

-- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptVt03()|

--------------------------------------------------------------------------------

-- Form Members
-- Support object
    member .support     is MdsSUPPORT

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .ppack       is array

-- Support object storage for support regeneration
    member .backup      is MdsSUPPORT

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

-- Distance Callback
    member .actionbdist is array

-- Position Through Callback
    member .actionbthro is array

-- Plus Nudge Callback
   member .actionplus   is array

-- Minus Nudge Callback
   member .actionminus   is array

-- Modatta Button Callback
   member .actionmodatta is array

-- Rotate Button Callback
   member .actionrotate is array

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,6,7,8,9,10,13,15,18,19,20,21,22,27,28,29,30,31,32,34,35,37,38,41,42,56,58'

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

-- Set Callbacks for '.actionbdist' and '.actionbthro' form Gadgets
    !!Mdsvt03.actionbdist[1] = |call !!Mdsposdist(!!Mdsvt03)|
    !!Mdsvt03.actionbdist[2] = |call !!Mdsaidtext(!!Mdsvt03)|

    !!Mdsvt03.actionbthro[1] = |call !!Mdsposthro(!!Mdsvt03)|
    !!Mdsvt03.actionbthro[2] = |call !!Mdsaidtext(!!Mdsvt03)|

-- Set Callbacks for '.actionplus' and '.actionminus' form Gadgets
    !!Mdsvt03.actionplus[1] = |call !!Mdsplusdist(!!Mdsvt03)|
    !!Mdsvt03.actionplus[2] = |call !!Mdsaidtext(!!Mdsvt03)|

    !!Mdsvt03.actionminus[1] = |call !!Mdsminusdist(!!Mdsvt03)|
    !!Mdsvt03.actionminus[2] = |call !!Mdsaidtext(!!Mdsvt03)|

-- Set Callback for '.actionmodatta' form Gadget
    !!Mdsvt03.actionmodatta[1] = |call !!Mdsimodat(!!Mdsvt03,!!Mdsmodat)|
    !!Mdsvt03.actionmodatta[2] = |call !!Mdssetgadgets(!!Mdsvt03,!!Mdsmodat.atta,!!Mdsmodat.support.alias)|

-- Set Callback for '.actionmodatta' form Gadget

    !!Mdsvt03.actionrotate[1] = |call !!Mdsrotatevt03()|
    !!Mdsvt03.actionrotate[2] = |call !!Mdsaidtext(!!Mdsvt03)|

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsVt03,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsvt03,true)

--------------------------------------------------------------------------------

-- Populate option gadgets
    call !!Mdsloadoption(!!Mdsvt03.select)

    !!Mdsvt03.regen = |call !!Mdscreatevt03('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdsvt03.frm
