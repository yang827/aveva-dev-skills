--
-- File:		Mdsvt06.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FVS105
--
-- Author:		Andrew Kirkland
-- Created:		Wednesday 13th May 1998
--
--
-- Description:
-- Form Definition for Vessel Frameworks Type 'VT06'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdsvt06

-- Define Form
setup form  !!Mdsvt06 at xr0 yr0 noquit

  !!Mdsvt06.formtitle    = ||
  !!Mdsvt06.icontitle    = |MDS - VT06|
  !!Mdsvt06.callback     = ||
  !!Mdsvt06.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatvt06()|
      button .bdist | Distance | at xmin   ymax+0.25       call |call !!Mdsposdist(!!Mdsvt06)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |call !!Mdsposthro(!!Mdsvt06)|
      option .select             at xmax+1 ymin            call |call !!Mdsthroselect(!!Mdsvt06)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------

-- Creation
    frame .fcreate |Create| at x0 ymax width 31

      -- option .size   |Size | at x1 y1 call |call !!Mdsresize(!!Mdsvt06)| width 20

      -- path down
      -- para .create text |Create by      |
      -- path right

      -- button .CreateByCur tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateVt06('CURSOR')|
      -- button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateVt06('DIMENSION')|
      -- button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateVt06('CLEARANCE')|

      button .SetSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsVt06,'-BAR-1','-BAR-1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateVt06('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateVt06('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateVt06('CLEARANCE')|


      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt

    exit

--------------------------------------------------------------------------------

-- Miscellaneous
    frame .fmisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsVt06)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsVt06)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsVt06)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarVt06(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorVt06()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsVt06)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!MdsVt06)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsVt06)|


-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!MdsVt06)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!MdsVt06)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsVt06,'!!MdsRotateVt06()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!MdsVt06)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsVt06,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsVt06)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsVt06)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsVt06,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsVt06,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsVt06)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsVt06)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsVt06)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsVt06)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .dim      at xmax+0.1 ymin pixmap width 18 height 18 call ||
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsVt06)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsVt06,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
--<GE> 12/02/07 Fix for Defect: 10240
      -- button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!!MdsFormConvSpec(!this)|
--<GE> 12/02/07
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|

    exit

--------------------------------------------------------------------------------

-- Bottom Line

    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptVt06()|

--------------------------------------------------------------------------------

-- Form Members
-- Support object
    member .support     is MdsSUPPORT

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .ppack       is array

-- Support object storage for support regeneration
    member .backup      is MdsSUPPORT

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '2,6,7,9,10,11,13,14,15,18,19,20,21,22,24,27,28,29,30,31,32,34,35,37,38,41,42,56,58'

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsVt06,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsvt06,true)

--------------------------------------------------------------------------------

-- Populate option gadgets
    call !!Mdsloadoption(!!Mdsvt06.select)

--------------------------------------------------------------------------------

    !!Mdsvt06.regen = |call !!Mdscreatevt06('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false

-- End of file Mdsvt06.frm
