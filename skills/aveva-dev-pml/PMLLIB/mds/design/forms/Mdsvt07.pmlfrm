--
-- File:		Mdsvt07.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:          FVS105
--
-- Author:		Andrew Kirkland
-- Created:		Wednesday 13th May 1998
--
--
-- Description:
-- Form Definition for Vessel Frameworks Type 'VT07'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!Mdsvt07

-- Define Form
setup form  !!Mdsvt07 at xr0 yr0 noquit

  !!Mdsvt07.formtitle    = ||
  !!Mdsvt07.icontitle    = |MDS - VT07|
  !!Mdsvt07.callback     = ||
  !!Mdsvt07.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31

      button .datum | Create datum support atta | at x1 y1 call |call !!Mdssetdatvt07()|
      button .bdist | Distance | at xmin   ymax+0.25       call |call !!Mdsposdist(!!Mdsvt07)|
      text   .dist               at xmax+1 ymin     width 14 is real format !!DistanceFmt
      button .bthro | Through |  at x1     ymax+0.2        call |call !!Mdsposthro(!!Mdsvt07)|
      option .select             at xmax+1 ymin            call |call !!Mdsthroselect(!!Mdsvt07)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------

-- Creation
    frame .fcreate |Create| at x0 ymax width 31

      -- option .size   |Size | at x1 y1 call |call !!Mdsresize(!!Mdsvt07)| width 20

      path down
      -- para .create text |Create by      |
      -- path right

      -- button .CreateByCur tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateVt07('CURSOR')|
      -- button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateVt07('DIMENSION')|
      -- button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateVt07('CLEARANCE')|

--<kp>feb07 Old "radio" syntax replaced by "rtoggle"
--
--    radio
--      toggle .Lug     at x1 y1 'Create under Lug'
--      toggle .DummyLeg 'Create under Dummy Leg'
--    exit
      rtoggle .lug at x1 y1 'Create under Lug'
      rtoggle .Dummyleg at ymax-.1 'Create under Dummy Leg'
--<kp>feb07 Old "radio" syntax replaced by "rtoggle"

      button .SetSize     at x1 ymax+0.5 tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!MdsSetSteel.init('SHOW',!!MdsVt07,'-BAR-1','-BAR-1')|
      button .CreateByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!MdsCreateVt07('CURSOR')|
      button .CreateByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!MdsCreateVt07('DIMENSION')|
      button .CreateByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!MdsCreateVt07('CLEARANCE')|


      text   .dim1   |Dim 1     | at x1 ymax+0.2 width 16 is real format !!DistanceFmt

    exit

--------------------------------------------------------------------------------

-- Miscellaneous
    frame .fmisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

      button .AddPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!MdsAddPipe(!!MdsVt07)|
      button .AddHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!MdsAddHvac(!!MdsVt07)|
      button .AddRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!MdsAddRack(!!MdsVt07)|
      button .AddBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!MdsAddBarVt07(_Support, 'NEW')|
      button .Flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!MdsMirrorVt07()|
      button .Hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!MdsRotateFrame(!!MdsVt07)|
      button .AlignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!Mdsxalign(!!MdsVt07)|
      button .ModSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!MdsPosse(!!MdsVt07)|


-- Icons Row 2

      button .AddPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!Mdscrft25(!!MdsVt07)|
      button .DelPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!Mdsdelft25(!!MdsVt07)|
      button .Rotate        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |Call !!MdsIRotan(!!MdsVt07,'!!MdsRotateVt07()')|
      button .RotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
      button .Newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!Mdsnewdatum(!!MdsVt07)|
      button .Bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!MdsIBedPlate(!!MdsVt07,'FRAME')|
      button .Associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!MdsLinkAtta(!!MdsVt07)|
      button .ViewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!MdsShowLinks(!!MdsVt07)|

-- Icons Row 3

      button .FlipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!MdsFieldWeld(!!MdsVt07,'FLIP')|
      button .ModAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!MdsIModAt(!!MdsVt07,!!MdsModAt)|
      button .DeleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!MdsDeleteAtta(!!MdsVt07)|
      button .Nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!MdsNudge.Init(!!MdsVt07)|
      button .Spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!MdsSpool.Init(!!MdsVt07)|
      button .SetMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!MdsSetMat(!!MdsVt07)|
      button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!MdsCopyLike(!This)|
      button .ViewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!MdsShowPlotFile(_Support)|

-- Icons Row 4

      button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |!!Alert.Error('To Complete')|
      button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!MdsSetDim(!!MdsVt07)|
      button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!MdsZoomSupp(!!MdsVt07)|
      button .Mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!MdsIMdsAdp(!!MdsVt07,'INIT')|
      button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!MdsSetLocation(!This)|

-- Icons Row 5

      button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!Mdsselecttrim(!This)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
      button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!Mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
      button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!Mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
      -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!MdsEditProp.init(!this)|
      button .ViewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!MdsViewFlip(!this)|
      button .ConvSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
      button .Mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!MdsMtoc.init(!this)|

    exit

--------------------------------------------------------------------------------

-- Bottom Line

    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!MdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     call |Call !!MdsAcceptVt07()|

--------------------------------------------------------------------------------

-- Form Members
-- Support object
    member .support     is MdsSUPPORT

-- Graphical representation
    member .repre       is array

-- Form Storage for support restoration
    member .store       is array

-- Form Storage for Packing Pieces for Support restoration
    member .ppack       is array

-- Support object storage for support regeneration
    member .backup      is MdsSUPPORT

-- Support Regeneration function
    member .regen       is string

-- BedPlate Reference
    member .strubpref   is array

-- BedPlate Reference
    member .storebpref  is array

    -- Graphical dimensions
    member .GraphicalDim is boolean

    -- Blocked icons
    member .BlockedIcons is string
    !This.BlockedIcons = '1,2,3,6,7,8,9,10,11,13,14,15,17,18,19,20,21,22,23,27,29,30,31,32,34,35,37,38,41,42,43,44,45,46,47,56,58'

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

  -- Set background colour of pixmaps to white

    !!MdsSetIconBack(!!MdsVt07,'white')

  -- Turn off blocked icons
    !!KResetActive(!!Mdsvt07,true)

--------------------------------------------------------------------------------

-- Populate option gadgets
    call !!Mdsloadoption(!!Mdsvt07.select)

--------------------------------------------------------------------------------

    !!Mdsvt07.regen = |call !!Mdscreatevt07('DIMENSION')|

-- Set the Hiddencancel Button to INACTIVE
    -- !This.hiddencancel.active = false


-- End of file Mdsvt07.frm
