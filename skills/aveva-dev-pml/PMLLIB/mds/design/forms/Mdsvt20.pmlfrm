--------------------------------------------------------------------------------
--
-- File:    Mdsvt20.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:          FVS105
--
-- Author:    Gordon Evans
-- Created:   Wednesday 22nd Oct 2003
--
--
-- Description:
-- Form Definition for Vessel Frameworks Type 'vt20'
--
--------------------------------------------------------------------------------

-- Kill existing form definition
kill !!mdsvt20

-- Define Form
setup form  !!mdsvt20 at xr0 yr0 noquit

  !!mdsvt20.formtitle    = ||
  !!mdsvt20.icontitle    = |MDS - VT20|
  !!mdsvt20.callback     = ||
  !!mdsvt20.formrevision = | $Revision: 1.1.19.1 $ |

-- Body of Form
    para .tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

--------------------------------------------------------------------------------

-- Create Datum
    frame .fdatum |Datum| at x0 ymax width 31
    button .datum | Create datum support atta | at x1 ymax+0.2 call |call !!mdssetdatvt20()|
    button .bdist | Distance | at xmin   ymax+0.25       call |call !!mdsposdist(!!mdsvt20)|
    text   .dist               at xmax+1 ymin     width 14 is REAL format !!distanceFmt
    button .bthro | Through |  at x1     ymax+0.2        call |call !!mdsposthro(!!mdsvt20)|
    option .select             at xmax+1 ymin            call |call !!mdsthroselect(!!mdsvt20)| width 13
      para   .p                  at x1     ymax+0.2 width 25 lines 1

    exit

--------------------------------------------------------------------------------

-- Creation
    frame .fcreate |Create| at x0 ymax width 31

    button .setSize     at x1 ymax tooltip 'Choose Steelwork Template' pixmap width 19 height 19 call |!!mdsSetSteel.init('SHOW',!!mdsvt20,'-BAR-1','-BAR-1')|
    button .createByCur at xmax+0.1 ymin tooltip 'Cursor' pixmap width 19 height 19 call |Call !!mdsCreatevt20('CURSOR')|
    button .createByDim at xmax+0.1 ymin tooltip 'Dimensions' pixmap width 19 height 19 call |Call !!mdsCreatevt20('DIMENSION')|
    button .createByCle at xmax+0.1 ymin tooltip 'Clearance' pixmap width 19 height 19 call |Call !!mdsCreatevt20('CLEARANCE')|

    --<dw>mar2009 dun1119 - HPD0038602 To allow Dim1 to be re-set
    text   .dim1   |Dim 1     | at x1 ymax+0.2 call |!!mdsCreatevt20('DIMENSION')| width 16 is REAL format !!distanceFmt

    exit

--------------------------------------------------------------------------------

-- Miscellaneous
    frame .fmisc |Options| at x0 ymax+0.1 width 31

-- Icons Row 1

    button .addPipe  at x1 ymax+0.3   tooltip 'Add Pipe'       pixmap width 18 height 18 call |Call !!mdsAddPipe(!!mdsvt20)|
    button .addHVAC  at xmax+0.1 ymin tooltip 'Add HVAC'       pixmap width 18 height 18 call |Call !!mdsAddHvac(!!mdsvt20)|
    button .addRack  at xmax+0.1 ymin tooltip 'Add Rack'       pixmap width 18 height 18 call |Call !!mdsAddRack(!!mdsvt20)|
    button .addBar   at xmax+0.1 ymin tooltip 'Add Cross Bar'  pixmap width 18 height 18 call |Call !!mdsAddBarvt20(_Support, 'NEW')|
    button .flip     at xmax+0.1 ymin tooltip 'Mirror Frame'   pixmap width 18 height 18 call |Call !!mdsMirrorvt20()|
    button .hand     at xmax+0.1 ymin tooltip 'Rotate Frame'   pixmap width 18 height 18 call |Call !!mdsRotateFrame(!!mdsvt20)|
    button .alignSup at xmax+0.1 ymin tooltip 'Align Support'  pixmap width 18 height 18 call |Call !!mdsxalign(!!mdsvt20)|
    button .modSctn  at xmax+0.1 ymin tooltip 'Modify Section' pixmap width 18 height 18 call |Call !!mdsPosse(!!mdsvt20)|


-- Icons Row 2

    button .addPack       at x1 ymax+0.25 tooltip 'Add Packer'         pixmap width 18 height 18 call |Call !!mdscrft25(!!mdsvt20)|
    button .delPack       at xmax+0.1 ymin tooltip 'Delete Packer'      pixmap width 18 height 18 call |Call !!mdsdelft25(!!mdsvt20)|
    button .rotate        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call |Call !!mdsIRotan(!!mdsvt20,'!!mdsRotatevt20()')|
    button .rotAtt        at xmax+0.1 ymin tooltip 'Rotate Atta'        pixmap width 18 height 18 call ||
    button .newdat        at xmax+0.1 ymin tooltip 'Modify Datum Atta'  pixmap width 18 height 18 call |Call !!mdsnewdatum(!!mdsvt20)|
    button .bedplate      at xmax+0.1 ymin tooltip 'Reference Bed/Anchor Plate' pixmap width 18 height 18 call |Call !!mdsIBedPlate(!!mdsvt20,'FRAME')|
    button .associate     at xmax+0.1 ymin tooltip 'Associate Atta'     pixmap width 18 height 18 call |Call !!mdsLinkAtta(!!mdsvt20)|
    button .viewAssociate at xmax+0.1 ymin tooltip 'View Associations'   pixmap width 18 height 18 call |Call !!mdsShowLinks(!!mdsvt20)|

-- Icons Row 3

    button .flipFw     at x1 ymax+0.25  tooltip 'Flip Field Weld' pixmap width 18 height 18 call |Call !!mdsFieldWeld(!!mdsvt20,'FLIP')|
    button .modAtta    at xmax+0.1 ymin tooltip 'Modify Atta'     pixmap width 18 height 18 call |Call !!mdsIModAt(!!mdsvt20,!!mdsModAt)|
    button .deleteAtta at xmax+0.1 ymin tooltip 'Delete Atta'     pixmap width 18 height 18 call |Call !!mdsDeleteAtta(!!mdsvt20)|
    button .nudge      at xmax+0.1 ymin tooltip 'Nudge Support'   pixmap width 18 height 18 call |!!mdsNudge.init(!!mdsvt20)|
    button .spool      at xmax+0.1 ymin tooltip 'Spooling'        pixmap width 18 height 18 call |!!mdsSpool.init(!!mdsvt20)|
    button .setMat     at xmax+0.1 ymin tooltip 'Set Section Material' pixmap width 18 height 18 call |!!mdsSetMat(!!mdsvt20)|
    button .copylike   at xmax+0.1 ymin tooltip 'Copy Like' pixmap width 18 height 18 call |call !!mdsCopyLike(!this)|
    button .viewStd    at xmax+0.1 ymin tooltip 'View Standard'   pixmap width 18 height 18 call |Call !!mdsShowPlotFile(_Support)|

-- Icons Row 4

    button .connect  at x1 ymax+0.25 tooltip 'Create Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .modify   at xmax+0.1 ymin tooltip 'Modify Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .forcecon at xmax+0.1 ymin tooltip 'Force Connection to a Pline'  pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .disconn  at xmax+0.1 ymin tooltip 'Delete Connections' pixmap width 18 height 18 call |!!alert.error('To Complete')|
    button .dim      at xmax+0.1 ymin tooltip 'Show/Hide Framework Dimensions' pixmap width 18 height 18 call |call !!mdsSetDim(!!mdsvt20)|
    button .zoom     at xmax+0.1 ymin tooltip 'Centre on Support' pixmap width 18 height 18 call |call !!mdsZoomSupp(!!mdsvt20)|
    button .mdsadp   at xmax+0.1 ymin tooltip 'ADP Drawlist'       pixmap width 18 height 18 call |Call !!mdsIMdsAdp(!!mdsvt20,'INIT')|
    button .adploc   at xmax+0.1 ymin tooltip 'Modify ADP Location Position' pixmap width 18 height 18 call |call !!mdsSetLocation(!this)|

-- Icons Row 5

    button .trimmer  at x1 ymax+0.25 tooltip 'Trimmer Required' pixmap width 18 height 18 call |call !!mdsselecttrim(!this)|
      button .ancmat   at xmax+0.1 ymin tooltip 'Set Ancillary Material' pixmap width 18 height 18 call |!!mdsancmat.init(!this)|
      button .anccopy  at xmax+0.1 ymin tooltip 'Copy Ancillary'  pixmap width 18 height 18 call |!!mdsanccopy(!this)|
      button .ancnudge at xmax+0.1 ymin tooltip 'Nudge Ancillaries' pixmap width 18 height 18 call |!!mdsancnudge.init(!this)|
    button .setlen   at xmax+0.1 ymin tooltip 'Set Length to Steelwork' pixmap width 18 height 18 call |call !!mdssettrunlen('STEEL',!this.tlength.val,!this.support.datum,'D WRT /*','TT04',!this)|
    button .trunmat  at xmax+0.1 ymin tooltip 'Set Trunnion Material'   pixmap width 18 height 18 call |!!mdstrunmat.init(!this)|
      button .ancnote  at xmax+0.1 ymin tooltip 'Add Notes'               pixmap width 18 height 18 call |!!mdsancnote.init(!this)|
      button .reconnect at xmax+0.1 ymin tooltip '' pixmap width 18 height 18 call ||

-- Icons Row 6
      button .flipatta at x1 ymax+0.25  tooltip '' pixmap width 18 height 18 call ||
      button .suppdata at xmax+0.1 ymin tooltip 'Data' pixmap width 18 height 18 call |!!mdssuppdata.init(!this)|
    -- button .EditAtta at xmax+0.1 ymin tooltip 'Modify Atta Properties' pixmap width 18 height 18 call |!!mdsEditProp.init(!this)|
    button .viewFlip at xmax+0.1 ymin tooltip 'Flip ADP View Directions' pixmap width 18 height 18 call |!!mdsViewFlip(!this)|
--<GE> 12/02/07 Fix for Defect: 10240
    -- button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call ||
    button .convSpec at xmax+0.1 ymin tooltip 'Convert to Special'       pixmap width 18 height 18 call |!!mdsFormConvSpec(!this)|
--<GE> 12/02/07
    button .mtoc     at xmax+0.1 ymin tooltip 'Isometric Control'        pixmap width 18 height 18 call |!!mdsMtoc.init(!this)|

    exit

--------------------------------------------------------------------------------

-- Bottom Line

  button .cancel  | Cancel | at xmax form-size ymax+0.5
  -- button .hiddencancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
  button .ok      |   OK   | at x0             ymin     call |Call !!mdsAcceptvt20()|

--------------------------------------------------------------------------------

-- Form Members
-- Support object
  member .support     is MDSSUPPORT

-- Graphical representation
  member .repre       is ARRAY

-- Form Storage for support restoration
  member .store       is ARRAY

-- Form Storage for Packing Pieces for Support restoration
  member .ppack       is ARRAY

-- Support object storage for support regeneration
  member .backup      is MDSSUPPORT

-- Support Regeneration function
  member .regen       is STRING

-- BedPlate Reference
  member .strubpref   is ARRAY

-- BedPlate Reference
  member .storebpref  is ARRAY

    -- Graphical dimensions
  member .graphicalDim is BOOLEAN

    -- Blocked icons
  member .blockedIcons is STRING
  !this.blockedIcons = '2,6,7,8,9,10,11,13,14,15,17,18,19,20,21,22,23,27,29,30,31,32,34,35,37,38,41,42,43,44,45,46,47,56,58'

  exit

--------------------------------------------------------------------------------
-- End form definition
--------------------------------------------------------------------------------

  -- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsvt20,'white')

  -- Turn off blocked icons
!!kResetActive(!!mdsvt20,true)

--------------------------------------------------------------------------------

-- Populate option gadgets
call !!mdsloadoption(!!mdsvt20.select)

--------------------------------------------------------------------------------

!!mdsvt20.regen = |call !!mdsCreatevt20('DIMENSION')|

-- Set the hiddencancel Button to INACTIVE
-- !this.hiddencancel.active = false
