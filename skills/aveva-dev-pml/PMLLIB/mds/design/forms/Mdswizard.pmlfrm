--
-- Description:
-- Form Definition for The MDS Wizard
--
--------------------------------------------------------------------------------


-- Kill existing form definition
Kill !!MdsWizard

-- Define Form
Setup Form  !!MdsWizard at xr0 yr0

  !!MdsWizard.formtitle    = |MDS Wizard|
  !!MdsWizard.icontitle    = |Wizard|
  !!MdsWizard.Callback     = |!!MdsIWizard()|
  !!MdsWizard.formrevision = | $Revision: 1.1.19.1 $ |

  button .Choose tooltip 'Choose Working Element' pixmap width 16 height 19 call |!!MdsWidSctn('ID')|
  button .Add tooltip 'Add elements within reach' pixmap width 16 height 19 call |!!MdsWFindPipes()|
--<kp>feb07 Old "radio" syntax replaced by "rtoggle"
--  para .ptag at xmax ymin+0.3 text '   Add Type'
--  radio
--    toggle .PIPE |Pipes| states |OFF| |ON|
--    toggle .STEEL |Steelwork| states |OFF| |ON|
--    toggle .EQUIP |Equipment| states |OFF| |ON|
--    -- toggle .ALL |All| states |OFF| |ON|
--  exit
    frame .ptag '   Add Type' at xmax ymin+0.3
       rtoggle .PIPE |Pipes| states |OFF| |ON|
       rtoggle .STEEL |Steelwork| states |OFF| |ON|
       rtoggle .EQUIP |Equipment| states |OFF| |ON|
    exit
--<kp>feb07 Old "radio" syntax replaced by "rtoggle"

  -- path down
  -- button .SetSection  |Section| call |call !!MdsWidSctn('SCTN')|
  -- path right
  -- button .SetTube     |Tube| call |call !!MdsWidSctn('TUBE')|
  -- button .SetStraight |Tray/HVAC| call |call !!MdsWidSctn('TRAY')|

-- From coordinates

  para _txt1 at x0 ymax text |From|
  option   _Fx at x0 ymax call || width 5
  var list _Fx pairs |East| ||
                     |West| |-|
  exit
  text _FxVal  at xmax+1 ymin call || width 14 isou
  option   _Fy at x0 ymax call || width 5
  var list _Fy pairs |North| ||
  exit
  text _FyVal  at xmax+1 ymin call || width 14 isou
  option   _Fz at x0 ymax call || width 5
  var list _Fz pairs |Up| ||
                     |Down| |-|
  exit
  text _FzVal  at xmax+1 ymin call || width 14 isou

-- To coordinates

  para _txt2 at xmax+1 ymin_txt1 text |To|
  option   _Tx at xmin_txt2 ymax call || width 5
  var list _Tx pairs |East| ||
                     |West| |-|
  exit
  text _TxVal  at xmax+1 ymin call || width 14 isou
  option   _Ty at xmin_txt2 ymax call || width 5
  var list _Ty pairs |North| ||
  exit
  text _TyVal  at xmax+1 ymin call || width 14 isou
  option   _Tz at xmin_txt2 ymax call || width 5
  var list _Tz pairs |Up| ||
                     |Down| |-|
  exit
  text _TzVal  at xmax+1 ymin call || width 14 isou

  text   .Reach   |Reach    | at x0 ymax+0.5 call |!!MdsWidSctn('REACH')| width 14 is real format !!DistanceFmt
  path down
  -- button .Find |Add elements within reach| call |Call !!MdsWFindPipes()|
  button .Dismiss | Dismiss | call |Call !!MdsWDismiss()| at xmax form-size ymax+0.5 CANCEL
  member .Element is DBREF
  member .Limits is ARRAY
  member .LastReach is REAL
  member .SetElement is BOOLEAN

exit

-- Set button pixmaps

!!MdsWizard.Choose.addPixmap(!!PML.getPathName('navigate16.png'))
!!MdsWizard.Add.addPixmap(!!PML.getPathName('addce16.png'))

-- Deactivate limits gadgets as they cannot be changed by the user

!!MdsWizard.Fx.active = false
!!MdsWizard.Fy.active = false
!!MdsWizard.Fz.active = false
!!MdsWizard.Tx.active = false
!!MdsWizard.Ty.active = false
!!MdsWizard.Tz.active = false
!!MdsWizard.FxVal.active = false
!!MdsWizard.FyVal.active = false
!!MdsWizard.FzVal.active = false
!!MdsWizard.TxVal.active = false
!!MdsWizard.TyVal.active = false
!!MdsWizard.TzVal.active = false

return
-- End of file MdsWizard.frm
