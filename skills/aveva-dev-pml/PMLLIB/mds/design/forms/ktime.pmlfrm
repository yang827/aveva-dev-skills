-- Created:		Mon 9th Nov 1998
--
--
-- Description:
-- Form Definition for late start of Isorun
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!KTime

-- Define Form
Setup Form  !!KTime blocking

  !!KTime.formtitle    = 'Late Start'
  !!KTime.icontitle    = 'Late'
  !!KTime.Callback     = ''
  !!KTime.formrevision = ''

  -- Body of Form

  -- Current time

  -- para .Text1 text 'Current Time           '
  button .Text1 'Current Time' call '!This.update()'

  path right

  para .NowHour at xmax+11 ymin width 2 lines 1

  para .Text2 text ' : '

  para .NowMinute width 2 lines 1

  -- Time to run batch

  text .NewHour 'Time to run batch       ' at x0 ymax+0.5 call '!This.Delay()' width 2 integer min 0 max 23

  para .Text3 text ':'

  text .NewMinute call '!This.Delay()' width 2 integer min 0 max 59

  -- Time to delay batch run

  para .Text4 at x0 ymax+0.5 text 'Time Delay             '

  path right

  para .DelayHour width 2 lines 1

  para .Text5 text ' : '

  para .DelayMinute width 2 lines 1

  -- bottom line

  button .OK at x0 ymax+0.5 '   OK   ' call '!This.Action = true'

  button .Cancel at xmax.NowMinute-9 ymin call '!This.Action = false' ' Cancel ' CANCEL

  member .Action is boolean

 -- End form definition
exit

-- Method to initialise form

define method .Init()

  !Time = object datetime()

  if !Time.hour().string().length().eq(1) then
    !This.NowHour.val = '0' + !Time.hour().string()
    !This.NewHour.val = '0' + !Time.hour().string()
  else
    !This.NowHour.val = !Time.hour().string()
    !This.NewHour.val = !Time.hour().string()
  endif

  if !Time.minute().string().length().eq(1) then
    !This.NowMinute.val = '0' + !Time.minute().string()
    !This.NewMinute.val = '0' + !Time.minute().string()
  else
    !This.NowMinute.val = !Time.minute().string()
    !This.NewMinute.val = !Time.minute().string()
  endif

  !This.Action = true

  !This.delay()

  !This.show()

endmethod

-- Method to initilize form

define method .Update()

  !Time = object datetime()

  if !Time.hour().string().length().eq(1) then
    !This.NowHour.val = '0' + !Time.hour().string()
  else
    !This.NowHour.val = !Time.hour().string()
  endif

  if !Time.minute().string().length().eq(1) then
    !This.NowMinute.val = '0' + !Time.minute().string()
  else
    !This.NowMinute.val = !Time.minute().string()
  endif

  !This.show()

endmethod

-- Method to work out how long to run starts

define method .Delay()

  if !This.NowHour.val.real().lt(!This.NewHour.val.real()) then
    !Hours = !This.NewHour.val.real() - !This.NowHour.val.real()
  elseif !This.NowHour.val.real().gt(!This.NewHour.val.real()) then
    !Hours = 24 - !This.NowHour.val.real() + !This.NewHour.val.real()
  else
    !Hours = 0
  endif

  if !This.NowMinute.val.real().lt(!This.NewMinute.val.real()) then
    !Minutes = !This.NewMinute.val.real() - !This.NowMinute.val.real()
  elseif !This.NowMinute.val.real().gt(!This.NewMinute.val.real()) then
    !Minutes = 60 - !This.NowMinute.val.real() + !This.NewMinute.val.real()
    !Hours = !Hours - 1
  else
    !Minutes = 0
  endif

  if !Hours.string().length().eq(1) then
    !This.DelayHour.val = '0' + !Hours.string()
  else
    !This.DelayHour.val = !Hours.string()
  endif

  if !Minutes.string().length().eq(1) then
    !This.DelayMinute.val = '0' + !Minutes.string()
  else
    !This.DelayMinute.val = !Minutes.string()
  endif

endmethod

-- End of file KTime.frm
