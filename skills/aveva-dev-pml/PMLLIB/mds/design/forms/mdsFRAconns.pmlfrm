--
--
-- Description:
-- Multi Discipline support form
-- Purpose: To set connections for Framatome supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  deleteconnection()               -
--  dismiss()                        -
--  display(BOOLEAN)                 -
--  init()                           -
--  saveconnections(STRING,real)     -
--  selectsctn()                     -
--  setconnection(BOOLEAN)           -
--
Kill !!mdsFRAconns

-- Define Form
setup form  !!mdsFRAconns

  title        |Set Anchor Plate Connections|
  icontitle    |Conns|
  Initcall     |!this.init()|
  revision     | $Revision: 1.1.19.1 $ |

  -- Body of Form
  para .Tag text |Name:|
  para .name at xmax+2 ymin width 25 lines 1
  option .Sctns 'Sections ' at xmin.tag ymax call |!this.selectsctn()| width 30
  -- option .Sctns 'Sections' at xmin.tag ymax call || width 20
  --list .connectionlist at xmin.tag ymax call |!this.setconnection()| width 35 hei 6
  list .connectionlist 'Fitting               Connection'     at xmin.tag ymax+0.4 call || width 45 hei 4
  button .connect ' Connect ' at xmin.tag ymax call |!this.setconnection(TRUE)|
  button.disconnect ' Disconnect ' at xmax+2 ymin call |!this.setconnection(FALSE)|

  button .dismiss ' Dismiss '  at xmax form -size ymin call |!this.dismiss()| cancel
  menu .connmenu
  !this.connmenu.add('callback',' Connect ','!this.setconnection(true)')
  !this.connmenu.add('callback',' Disconnect ','!this.setconnection(false)')
  !this.connectionlist.setpopup(!this.connmenu)

  member .form is form
  member .brackets is ARRAY
  member .stru is dbref

exit
--------------------------------------------------------------------------------
-- method to go and find the fittings for the current selected sctn and show their connections
define method .init()

  !this.name.val = !this.form.name.val
  !this.stru = !this.form.support.stru

  if !this.form inset (!!MDSFR01,!!MDSFR02,!!MDSFR03,!!MDSFR04,!!MDSFR09,!!MDSFR10,!!MDSFR12) THEN
     var !sctns coll all sctn with match(name,'-V') gt 0 for $!this.stru
  else
     -- for fr11 the connections are on the horizontal members
     var !sctns coll all sctn with match(name,'-H') gt 0 for $!this.stru
  endif

  -- if there are no sections its pointless
  if !sctns.unset() then
    !!alert.error('No sections defined')
    return
  endif


  var !names eval name for all from !sctns
  !ind = !names.sortedindices()
  !sctns.reindex(!ind)
  !names.reindex(!ind)
  !this.sctns.dtext = !names
  !this.sctns.rtext = !sctns
  !this.sctns.val = 1
  -- go and ensure that the :mdspconn attributes are up to date
  var !fitt coll all fitt for $!sctns[1]
  $(
  do !a values !fitt
   !order = !a.dbref().tysequ
   !this.saveconnections(!a,!order)
  enddo
  $)
  !this.selectsctn()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .selectsctn()

   !Sctn = !this.sctns.selection('rtext')
   var !fitt coll all fitt for $!sctn
   -- empty the current brackets array
   !this.brackets = !fitt
   -- go and set the :mdsconn attribute for each of the fittings
   $(
   do !a index !this.brackets
     !this.saveconnections(!this.brackets[!a],!a)
   enddo
   $)
   !this.display(TRUE)

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .dismiss()

-- set support object connections
  !!mdsFRAsaveconns(!this.form,'READ')
  !this.display(FALSE)

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .setconnection(!action is BOOLEAN)

  !save = !!ce
  !fitting = !this.connectionlist.selection().dbref()
  -- create or delete the connection true or false
  !a = object mdsBPlateconn(!this.form,!fitting,!action)

   -- set the support object plate connections for restating
   !this.form.support.plateconns = object mdsBPlateConn(!this.form.support)
   !this.display(TRUE)
   !!ce = !save

endmethod
--------------------------------------------------------------------------------

$(
--------------------------------------------------------------------------------
define method .deleteconnection()

   !save = !!ce
   !fitting = !this.connectionlist.selection().dbref()
   handle ANY
        $p error in disconnect
        return
    endhandle
    -- do the disconnect
    !a = object mdsBPlateconn(!this.form,!fitting,FALSE)

   -- set the support object plate connections for restating
   !this.form.support.plateconns = object mdsBPlateConn(!this.form.support)

   !this.display(TRUE)
!!ce = !save


endmethod

--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to look at a fitting - see if it is connected and set the
-- :mdspconn attribute of the owning section
define method .saveconnections(!fitting is STRING,!order is real)

   !cref = !fitting.dbref().cref
   !sctn = !fitting.dbref().owner
   var !fittingcount mcount FITT for $!sctn
   !mdspcon = !sctn.:mdspconn
   !mdspcon[!order] = !cref
   !connectionstring = ''
   do !a from 1 to !fittingcount.real()
     if undefined(!mdspcon[!a]) then
        !mdspcon[!a] = object dbref()
     endif
      --q var !mdspcon[!a].string()
     !connectionstring = !connectionstring & ' ' & !mdspcon[!a].string()
   enddo
    --q var !connectionstring
   !connectionstring = !connectionstring.replace('Unset','=0')
   !!ce = !sctn
    -- q var !connectionstring
   :mdspconn $!connectionstring
   handle ANY
     $p $!!error.text
     -- !!alert.error('One or more previous connections is unset - please connect fittings in order')
   endhandle

endmethod
--------------------------------------------------------------------------------
$)


--------------------------------------------------------------------------------
define method .display(!action is BOOLEAN)

   !cref = object dbref()
   !save = !!ce
   !basenumber = !this.stru.refno.string().after('/').real()
   -- if action is true then display the aid lines
   !dtext = ARRAY()
   !rtext = ARRAY()
   do !a index !this.brackets
     !number = !basenumber + !A
     !!ce = !this.brackets[!a].dbref()
     handle ANY
        aid clear text all
        return
     endhandle
     $(
     !cref = !!ce.cref
     !name = !cref.name
     handle ANY
     endhandle
     $)
     !cref = !!ce.:mdsancref[1]
     handle ANY
         !cref = object dbref()
     endhandle
     !name = !cref.flnm
     handle ANY
     endhandle
     if !action then
        -- display aid text at the fitting
        if !cref.unset() or !cref.badref() then
          !dtext.append('Fitt $!a Not Connected')
          !rtext.append(!this.brackets[!a])
          aid clear text $!number
          handle ANY
          endhandle
          aid text number $!number 'Fitt $!a Not Connected' at $!!ce.position
        else
          !dtext.append('Fitt $!a Connected to $!name')
          !rtext.append(!this.brackets[!a])
          aid clear text $!number
          handle ANY
          endhandle

          aid text number $!number 'Fitt $!a Connected to $!name' at $!!ce.position
          --unenhance $!cref
          enhance $!cref
        endif
     else
      -- hide aid text at the fitting
      aid clear text $!number
      handle ANY
      endhandle
      unenhance $!cref
      handle ANY
      endhandle

     endif
   enddo

   !this.connectionlist.dtext = !dtext
   !this.connectionlist.rtext = !rtext

   -- !!mdsFRAsaveconns(!this.form,'READ')
   !!ce = !save

endmethod
--------------------------------------------------------------------------------


