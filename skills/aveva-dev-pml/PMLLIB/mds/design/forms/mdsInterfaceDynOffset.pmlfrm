--   Replaces:
--
-- Author:          N.morris
-- Created:         Mon 13th Sept 2004
--
-- Description:
-- 3D location for notes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkAngle()                     -                   Checks to see if max/min angle has been exceeded
--  close()                          -
--  default()                        -
--  defaulttpos(POINTVECTOR)         POINTVECTOR         Work out default tail position
--  init(FORM)                       -
--  inithide(FORM)                   -
--  setByAngle()                     -                   Work out distance from angle value
--  setByDist()                      -
--  setByID()                        -                   Checks to see if max/min angle has been exceeded
--  showLine()                       -
--
------------------------------------------------------------------------

setup form !!mdsInterfaceDynOffset

  !!mdsInterfaceDynOffset.formTitle     = 'Dynamic Hanger Offset'
  !!mdsInterfaceDynOffset.iconTitle     = 'Dyn Off'
  !!mdsInterfaceDynOffset.callback      = ''
  !!mdsInterfaceDynOffset.formRevision  = ''

  -- Body of form definition
  -- Element name

  paragraph .ceName at xmin ymin width 34 lines 1

  -- Positioning Gadgets

  frame .positionFrame 'Offset' at xmin.ceName ymax width 34

    text .offsetX 'X Distance    +/-   ' at x1 y1 call '!this.setByDist()' width 14 is REAL format !!distanceFmt
    path down
    text .angleX  'X Angle       +/-   '          call '!this.setByAngle()' width 14 is REAL

    text .offsetY 'Y Distance    +/-   '          call '!this.setByDist()' width 14 is REAL format !!distanceFmt
    path down
    text .angleY  'Y Angle       +/-   '          call '!this.setByAngle()' width 14 is REAL

    button .id   ''                   tooltip 'Set offset/angle by ID' pixmap width 18 height 18 callback '!this.setByID()'

  exit

  -- Apply/Dismiss

  button .default 'Default' at xmin form-0                                     ymax form+0.25                 callback '!this.default()'
  button .dismiss 'Dismiss' at xmax form-size                                  ymin                           callback '!this.close()' OK


  -- Form Members

  member .hanger         is DBREF
  member .form           is FORM
  member .currentUnits   is STRING

exit
-- End of form definition for !!mdsInterfaceDynOffset

-- Set icon background

!!mdsInterfaceDynOffset.id.addPixmap(!!pML.getPathName('bycur.png'))
handle any
endhandle

------------------------------------------------------------------------
--
-- Method:      MdsDynOffset
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!form is FORM)

  !this.form = !form
  var !units units
  !this.currentUnits = !units
  !!kGetSetUnits()

  -- Put the offset distance value in the distance gadget

  !hanger = !form.support.datum.cref
  !this.offsetX.val = !hanger.:mdsdynoffset
  !this.offsetY.val = !hanger.:mdsdynoffy
  !this.ceName.val = 'Name: ' + !hanger.namn
  !this.hanger = !hanger

  -- Work out angle from dist value stored in :MdsDynOffset

  !this.setByDist()

  -- Make angle negative if dist is

  --  if !this.offsetX.val.lt(0) then
  --    !this.angleX.val = $!this.angleX.val
  --      handle ANY
  --      endhandle
  --  endif

  --  if !this.offsetY.val.lt(0) then
  --    !this.angleY.val = $!this.angleY.val
  --      handle ANY
  --      endhandle
  --  endif

  -- Make sure both value are set to 0 if the dist is 0

  if !this.offsetX.val.eq(0) then
    !this.angleX.val = 0
  endif

  if !this.offsetY.val.eq(0) then
    !this.angleY.val = 0
  endif

  if !!mdsInterfaceDynOffset.shown().not() then
    show !!mdsInterfaceDynOffset
  endif

endmethod

define method .inithide(!form is FORM)

  !this.form = !form
  var !units units
  !this.currentUnits = !units
  !!kGetSetUnits()

  -- Put the offset distance value in the distance gadget

  !hanger = !form.support.datum.cref
  !this.offsetX.val = !hanger.:mdsdynoffset
  !this.offsetY.val = !hanger.:mdsdynoffy
  !this.ceName.val = 'Name: ' + !hanger.namn
  !this.hanger = !hanger

  -- Work out angle from dist value stored in :MdsDynOffset

  !this.setByDist()

  -- Make angle negative if dist is

  --  if !this.offsetX.val.lt(0) then
  --    !this.angleX.val = $!this.angleX.val
  --      handle ANY
  --      endhandle
  --  endif

  --  if !this.offsetY.val.lt(0) then
  --    !this.angleY.val = $!this.angleY.val
  --      handle ANY
  --      endhandle
  --  endif

  -- Make sure both value are set to 0 if the dist is 0

  if !this.offsetX.val.eq(0) then
    !this.angleX.val = 0
  endif

  if !this.offsetY.val.eq(0) then
    !this.angleY.val = 0
  endif

  --show !!mdsInterfaceDynOffset
  !units = !this.currentUnits
  $!units

endmethod


-- End of method definition for .mdsDynOffset()

------------------------------------------------------------------------
--
-- Method:      Default
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default()

  -- Set offset to 0 and execute setbydist method

  !this.offsetX.val = 0
  !this.offsetY.val = 0
  !this.setByDist()

  -- Redefine the graphical aid line

  !this.showLine()

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      ShowLine
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showLine()

  -- Declare variables

  !datumPoint  = object POINTVECTOR()
  !tailPosition  = object POINTVECTOR()
  !hangerEnd  = object POINTVECTOR()
  !tailPosition.direction = !this.form.support.offsetY

  -- Set datum position

  !datumPoint.position = !this.hanger.href.ppos[0].wrt(/* )

  -- Find default datum position

  !defaulttpos = !this.defaulttpos(!datumPoint)
  !tailPosition.position = !defaulttpos.position
  !tailPosition.direction = !this.form.support.offsetY

  -- !hangerStart          = !this.hanger.hpos.wrt(/* )
  !hangerStart          = !this.hanger.href.pos.wrt(/* )
  !hangerEnd.position   = !defaulttpos.position
  !tailPos              = tpos of $!this.hanger wrt /*
  !datumPoint.direction = !this.form.support.offsetY
  !yoffset              = !tailPosition.offset(!this.offsetY.val)
  !yPosition            = !yoffset.position
  !yDef                 = !hangerEnd
  !yDef.direction       = !this.form.support.offsetX
  if !this.offsetX.val.lt(0) then
    !offset  = !this.offsetX.val.abs()
    !yDefPos = !yDef.offset(!offset)
  else
    !yDefPos = !yDef.offset(!this.offsetX.val)
  endif

  -- Hide lines in case it has been drawn before

  !this.close()

  aid line number 2999 $!hangerStart to $!hangerEnd.position linestyle dotted
  aid line number 3000 $!hangerEnd.position to $!tailPos linestyle dotted
  aid line number 3001 $!hangerEnd.position to $!yPosition linestyle dotted
  aid line number 3002 $!yPosition to $!tailPos linestyle dotted
  aid line number 3003 $!hangerStart to $!yPosition linestyle dotted
  aid arrow number 3004 at $!hangerEnd.position dir $!this.form.support.offsetX hei 300mm
  aid arrow number 3005 at $!hangerEnd.position dir $!this.form.support.offsetY hei 300mm
  !end = object POINTVECTOR()
  !end.position = !hangerEnd.position
  !end.direction = !this.form.support.offsetX
  !xPos = !end.offset(300mm)
  !end.direction = !this.form.support.offsetY
  !yPos = !end.offset(300mm)
  aid text number 3006 'X' at $!xPos.position
  aid text number 3007 'Y' at $!yPos.position


  var !xangle const angle $!yDefPos.position to $!hangerStart to $!hangerEnd.position
  var !yangle const angle $!hangerEnd.position to $!hangerStart to $!yPosition
  if !this.offsetX.val.lt(0) then
    !this.angleX.val = -$!xangle
  else
    !this.angleX.val = $!xangle
  endif
  if !this.offsetY.val.lt(0) then
    !this.angleY.val = -$!yangle
  else
    !this.angleY.val = $!yangle
  endif
  !this.angleX.val = !this.angleX.val.distance(FALSE,FALSE,FALSE,2,FALSE).real()
  !this.angleY.val = !this.angleY.val.distance(FALSE,FALSE,FALSE,2,FALSE).real()

endmethod
-- End of method definition for .showLine()

------------------------------------------------------------------------
--
-- Method:      Close
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !units = !this.currentUnits
  $!units

  -- Hide graphical line

  do !clear from 2999 to 3003
    aid clear line $!clear
    handle ANY
    endhandle
  enddo

  do !clear from 3004 to 3005
    aid clear arrow $!clear
    handle ANY
    endhandle
  enddo

  do !clear from 3006 to 3007
    aid clear text $!clear
    handle ANY
    endhandle
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      SetByDist
--
-- Description:
--   Work out angle from distance value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setByDist()

  !!kGetSetUnits()
  -- Declare variables

  !datumPoint  = object POINTVECTOR()
  !dynamicparallel = FALSE

  -- Set datum position
  !this = !!mdsInterfaceDynOffset
  !datumPoint.position = !this.hanger.href.ppos[0].wrt(/* )

  -- Find default datum position

  !defaulttpos = !this.defaulttpos(!datumPoint)
  pin 3 at $!defaulttpos.position
  pin 3 dir $!defaulttpos.direction
  !!ce = !this.hanger

  if !!ce.members.size().eq(0) then
    tpos $!defaulttpos.position
  endif

  var !phtoptdir const direction ph to pt

  !attadirs = !!mdsremovegrad(!this.hanger.href)
  !testtdir = !this.hanger.tdir.wrt( /* )
  if (!attadirs[1].angle(!testtdir).gt(179.9) and !attadirs[1].angle(!testtdir).lt(180.1)) or (!attadirs[1].angle(!testtdir).lt(.1) and !attadirs[1].angle(!testtdir).gt(-.1)) then
    !dynamicparallel = TRUE
    -- <RM 31/07/08> restricted the test below to non-licad interfaces
    if !!mdsHangIf.neq('LISEGA') then
      if !this.offsetY.val.lt(0) then
        !this.offsetY.val = 0
        !this.angleY.val = 0
        return error 1 |The value must be positive for a support of this type.|
      endif
    endif
  else

    -- If the pipe is vertical we need to direct the atta on the pipe towards the tail
    if !!ce.href.adir.string().before(' WRT').eq('U') or !!ce.href.adir.string().before(' WRT').eq('D') or !!ce.href.adir.string().before(' WRT').eq('Z') or !!ce.href.adir.string().before(' WRT').eq('-Z') then
      var !tdir pt dir
      goto href
      --ori and p9 is $!tdir
      ori and p9 is $!phtoptdir
      handle ANY
        -- not for a riser clamp
      elsehandle NONE
        rotate by 180
      endhandle
      !optdir = !tdir.direction().opposite().string()
    elseif  !this.form.hangertypes.stwallconn.eq(TRUE) then
      goto href
      ori and p9 is $!phtoptdir
    else
      var !tdir pt dir
      !optdir = !tdir.direction().opposite().string()
    endif
  endif

  !!ce = !this.hanger

  -- Move pin 3 to new position as declared in x and Y values

  if !this.form.support.offsetX.unset().not() then
    --!!mdsInterfaceSetOffsetDir(!this.hanger.href, !this.form)
    pin 3 direction $!this.form.support.offsetX
    pin 3 dist $!!mdsInterfaceDynOffset.offsetX.val
    pin 3 direction $!this.form.support.offsetY
    pin 3 dist $!!mdsInterfaceDynOffset.offsetY.val
    pos pt at pin 3
    pin 3 off

    !!mdsResetPins(3,3)
  else
    !!mdsInterfaceSetOffsetDir(!this.hanger.href, !this.form)
    -- <RM 31/07/08> included the test below for when !this.form.support.offsetX is unset
    -- because the hanger tail was sometimes not being offset in modify mode
    if !this.offsetX.val.neq(0) or !this.offsetY.val.neq(0) then
      pin 3 direction $!this.form.support.offsetX
      pin 3 dist $!!mdsInterfaceDynOffset.offsetX.val
      pin 3 direction $!this.form.support.offsetY
      pin 3 dist $!!mdsInterfaceDynOffset.offsetY.val
      pos pt at pin 3
      pin 3 off
    endif
  endif
  -- Successful setting of distance or angle reset the :mdsdynoffset attribute

  !this.hanger.:MdsDynOffset = !this.offsetX.val
  !this.hanger.:MdsDynOffY = !this.offsetY.val

  -- Set the angle gadgets

  -- Head Tail distance
  var !headTailDist const dist $!defaulttpos.position to $!datumPoint.position
  !angleX = (ATAN($!this.offsetX.val / !headTailDist.real()))
  !this.angleX.val = !angleX
  !angleX = (ATAN($!this.offsetY.val / !headTailDist.real()))
  !this.angleY.val = !angleX

  -- Check if maximum angle has been exceeded
  !interface = !!mdsHangIf
  if !interface.neq('LISEGA') then
    !this.checkAngle()
  endif

  !this.showLine()

endmethod

------------------------------------------------------------------------
--
-- Method:      setByAngle
--
-- Description:
--   Work out distance from angle value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setByAngle()

  !!kGetSetUnits()
  -- Declare variables

  !datumPoint  = object POINTVECTOR()

  -- Set datum position

  !datumPoint.position = !this.hanger.href.ppos[0].wrt(/* )

  -- Find default datum position

  !defaulttpos = !this.defaulttpos(!datumPoint)
  var !htDist const distance $!defaulttpos.position to $!datumPoint.position
  var !xdist (TAN ($!this.angleX) * $!htDist)
  var !ydist (TAN ($!this.angleY) * $!htDist)

  !this.offsetX.val = !xdist.real()
  !this.offsetY.val = !ydist.real()

  !this.setByDist()

endmethod

------------------------------------------------------------------------
--
-- Method:      defaulttpos
--
-- Description:
--   Work out default tail position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaulttpos(!dummyDatumPos is POINTVECTOR) is POINTVECTOR

  !return = object POINTVECTOR()

  !original = object POINTVECTOR()
  !original.direction = !this.form.support.tdir
  -- !original.position = hpos of $!this.hanger wrt /*
  !original.position = pos of href of $!this.hanger wrt /*

  !tpos = tpos of $!this.hanger wrt /*
  !return = !original.through(!tpos)

  return !return

endmethod

------------------------------------------------------------------------
--
-- Method:      checkAngle
--
-- Description:
--   Checks to see if max/min angle has been exceeded
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkAngle()

  !angleX = !this.angleX.val
  !angleX = !this.angleY.val

  if (!this.hanger.href.:MDSHconfig inset ('21V','21H','25V','25H') ) then
    !maxAngle = 180
  else
    !maxAngle = 75
  endif

  if !angleX.abs().gt($!maxAngle) then
    if !this.offsetX.val.lt(0) then
      !!alert.error('Angle X $!angleX exceeds maximum allowed of -$!maxAngle , resetting to 0')
      !this.angleX.val = 0
      !this.offsetX.val = 0
    else
      !!alert.error('Angle X $!angleX exceeds maximum allowed of $!maxAngle, resetting to 0')
      !this.angleX.val = 0
      !this.offsetX.val = 0
    endif
    !this.setByAngle()
  endif
  if !angleX.abs().gt($!maxAngle) then
    if !this.offsetY.val.lt(0) then
      !!alert.error('Angle Y $!angleX exceeds maximum allowed of -$!maxAngle, resetting to 0')
      !this.angleY.val = 0
      !this.offsetY.val = 0
    else
      !!alert.error('Angle Y $!angleX exceeds maximum allowed of $!maxAngle, resetting to 0')
      !this.angleY.val = 0
      !this.offsetY.val = 0
    endif
    !this.setByAngle()
  endif

  -- check for angle gt 6 degrees if both set
  --  if !angleX.abs().gt(6) and !angleX.abs().gt(6) then
  -- dtf we need to confirm which of the angles will dominate. I have used X
  -- if Y is used we may have to look at lisega object when setting  ang of strut
  --    !!alert.error('Angle Y $!angleX exceeds maximum allowed of 6 degrees if Angle X exceeds 6 degrees, resetting to 0')
  --    !this.angleY.val = 0
  --    !this.offsetY.val = 0
  --  endif

endmethod

-- End of method definition for .checkAngle()

------------------------------------------------------------------------
--
-- Method:      setByID
--
-- Description:
--   Checks to see if max/min angle has been exceeded
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setByID()

  !!kGetSetUnits()
  !ce = !!ce

  -- Identify element to set offset to

  PROMPT OFF
  PROMPT LOAD ESCAPE |Identify element to set distance/angle to|
  ID SBFI @
  handle (61,528)
    PROMPT ON
    return
  endhandle
  PROMPT DISMISS
  PROMPT ON
  !picked = !!ce

  -- Is identified sbfi in the panel of the trefs panel

  panel
  handle ANY
    floor
    handle ANY
      gwall
      handle ANY
        screed
        handle ANY
          stwall
          handle ANY
            sctn
            handle ANY
            endhandle
          endhandle
        endhandle
      endhandle
    endhandle
  endhandle

  !identifiedPanel = !!ce

  !!ce = !this.hanger
  goto tref

  panel
  handle ANY
    floor
    handle ANY
      gwall
      handle ANY
        screed
        handle ANY
          stwall
          handle ANY
            sctn
            handle ANY
            endhandle
          endhandle
        endhandle
      endhandle
    endhandle
  endhandle

  !trefsPanel = !!ce

  if !identifiedPanel.neq(!trefsPanel) then
    !!ce = !ce
    !!alert.error('Identified element is not owned by the hanger connection')
    return
  endif

  -- Find offset and put into offset gadget and reset by dist
  -- Find default datum position

  !datumPoint  = object POINTVECTOR()

  -- Set datum position

  !datumPoint.position = !this.hanger.href.ppos[0].wrt(/* )

  !defaulttpos = !this.defaulttpos(!datumPoint)

  !!ce = !this.hanger

  if !!ce.members.size().eq(0) then
    tpos $!defaulttpos.position
  endif
  pin 9 copy pt of $!this.hanger
  pin 9 at $!defaulttpos.position
  pin 8 copy pin 9
  pin 8 dir $!this.form.support.offsetX
  pin 8 plane pin 8 thro p1 of $!picked
  var !xdist const dist pin 9 to pin 8

  -- Check if xdist should be negative
  pin 9 dir from pin 9 to pin 8
  var !pin9Dir pin 9 dir
  var !pin8Dir pin 8 dir
  --$P p8dir $!pin8Dir
  --$P p9dir $!pin9Dir
  if !pin8Dir.neq(!pin9Dir) then
    !newXdist = !xdist.real() - !xdist.real() - !xdist.real()
    !xdist = !newXdist.string()
  endif

  pin 9 copy pt of $!this.hanger
  pin 9 at $!defaulttpos.position
  pin 8 copy pin 9
  pin 8 dir $!this.form.support.offsetY
  pin 8 plane pin 8 thro p1 of $!picked
  var !ydist const dist pin 9 to pin 8

  -- Check if ydist should be negative
  pin 9 dir from pin 9 to pin 8
  handle ANY
    --$P ydist $!ydist
    --$P xdist $!xdist

  elsehandle NONE
    var !pin9Dir pin 9 dir
    var !pin8Dir pin 8 dir
    if !pin8Dir.neq(!pin9Dir) then
      !newYdist = !ydist.real() - !ydist.real() - !ydist.real()
      !ydist = !newYdist.string()
    endif
  endhandle

  -- Set form distance gadgets

  if !xdist.real().lt(1) and !xdist.real().gt(-1) then
    !xdist = '0'
  endif

  if !ydist.real().lt(1) and !ydist.real().gt(-1) then
    !ydist = '0'
  endif

  !this.offsetX.val = !xdist.real()
  !this.offsetY.val = !ydist.real()

  !this.setByDist()

  pin 9 off
  pin 8 off

  -- dtf >> mod to automatically set :mdsancref
  --if !picked.catref.gtyp.eq('PLAT') then
  --  if !this.hanger.href.styp.eq('MH01') then
  -- set bedplate ref
  --    !this.hanger.:mdsancref !picked
  --    !a = object MDSBPLATECONN(!this.hanger ,!picked )
  --  endif
  --endif


endmethod

return

-- End of method definition for .setByID()
