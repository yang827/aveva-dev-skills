------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAccessRights()                -
--  checkConnectionUpdate(FILE,FILE) BOOLEAN
--  checkDelete(FILE,FILE)           BOOLEAN
--  checkrename(FILE,FILE)           BOOLEAN
--  collectHangerMacroSets()         -
--  deleteMacro()                    -
--  deleteMacroSet()                 -
--  deleteMacros()                   -
--  getMacrofileList()               -
--  getName(FILE)                    STRING
--  getStatus(FILE)                  STRING
--  getType(FILE)                    STRING
--  init()                           -
--  isThisANewMacroSet(FILE,REAL)    BOOLEAN
--  prepareToRunMacro(STRING)        -
--  runMacro()                       -
--  runMacroFile(STRING)             -
--  runMacroSet()                    -
--  runMacros()                      -
--  selectMacro(GADGET,STRING)       -
--  sortIntoDateTimeOrder(ARRAY)     ARRAY
--  updateForm()                     -
--  userHasWriteAccessForSomeMacros() BOOLEAN
--

-- Kill existing form definition
Kill !!mdsInterfaceManageMacros

-- Define Form
setup form  !!mdsInterfaceManageMacros DIALOG DOCK RIGHT size 40 8

  !this.formTitle = 'MDS Hanger Connection Macro Management'
  !this.initcall = '!this.init()'

  list .macroList || call |!this.selectMacro(| anchor left + right + top + bottom  SINGLE COLUMNS height 7 width 40

  button .runMacroSet | Run Set | anchor left + bottom call |!this.runMacroSet()| tooltip |Run all pending macros in the selected set| at x0 ymax form-2.4
  button .deleteMacroSet | Delete Set | anchor left + bottom call |!this.deleteMacroSet()| tooltip |Delete all executed macros in the selected set| at xmax.runMacroSet+1 ymin

  --add buttons that run and delete macros in bulk
  button .runMacros | Run all | anchor left + bottom call |!this.runMacros()| tooltip |Run all pending macros| at x0 ymax form-1.2
  button .deleteMacros | Delete all | anchor left + bottom call |!this.deleteMacros()| tooltip |Delete all executed macros| at xmax.runMacroSet+1 ymin

  --macrofileList is an array of arrays containing [1] a set number that the macro belongs to [2] A FILE representing the macro held in the <project>MAC\hangermacros directory
  --[3] a flag which tells us if the macro has been run (EXECUTED or PENDING) this is populated in !this.getMacrofileList
  member .macrofileList is ARRAY
  member .macrofileListRtext is ARRAY
  member .macroSets is ARRAY

  --setup the listbox headings
  !headings = object ARRAY()
  !headings.append('Macro Set')
  !headings.append('Macro Name')
  !headings.append('Macro Status')
  !headings.append('Macro Type')
  !headings.append('Macro Access Control')
  !this.macroList.setHeadings(!headings)

exit

define method .init()

  var !hangMacDir evar mdsHangerMacros
  !hangMacDirObj = object FILE(!hangMacDir)
  !valid = !hangMacDirObj.exists()
  handle(160,46)
    !!alert.error('the current mdsHangerMacros environment variable is not set to a valid directory for storing hanger macros')
    return error 99 noalert
  elsehandle NONE
    if !valid.not() then
      !!alert.error('the current mdsHangerMacros environment variable is not set to a valid directory for storing hanger macros')
      return error 99 noalert
    endif
  endhandle

  --get list of macros and populate list
  !this.updateForm()

endmethod

define method .prepareToRunMacro(!mode is STRING)

  if !mode.eq('BATCH') then
    --this needs to be returned to the runmacros method that called it
    !this.runMacro()
    handle 99
      return error 99
    endhandle
  else
    --just handle the error
    !this.runMacro()
    handle 99
    endhandle
  endif

endmethod

define method .runMacro()

  --get the selection
  !selectedMacro = !this.macroList.selection('RTEXT')

  --if file exists
  !macroFile = object FILE(!selectedMacro)
  if !macroFile.exists().not() then
    --if the file doesn't exist now then it is likely that it has been deleted by another user who is running in macros
    !!alert.message('the selected macro file does not exist, this may have been deleted by another user process')
    return
  endif

  !fileLines = !macroFile.readfile()
  handle ANY
    --handle any file error (i.e. the file must have been opened by another user so just quit out)
    !!alert.message('the selected macro file is locked by another user process')
    --!tempFile.deleteFile()
    return error 99
  endhandle

  if !fileLines.size().eq(0) then
    !!alert.message('the selected macro file is empty, cannot continue')
    --!macroFile.close()
    --!tempFile.deleteFile()
    return error 99
  endif

  !status = !fileLines[1].after('!macrostatus = ').trim()
  !status = $!status
  handle ANY
    !status = ''
  endhandle

  --if status is set such that macro has been run then take no further action
  if !status.eq('EXECUTED') then
    !!alert.message('the selected macro file has already been run into MDS, no further action is necessary')
    --!macroFile.close()
    --!tempFile.deleteFile()
    --we need to run !fileLines back into the file because the open command deletes everything inside of it
    --!macroFile.writeFile('OVERWRITE', !fileLines)
    return
  elseif !status.eq('PENDING') then
    --if status is set such that macro has not been run then:-
    !owningSteel = object ARRAY()
    !dbwrite = object ARRAY()
    !lock = object ARRAY()
    !claimable = object ARRAY()

    --check the dbwrite, lock and claim status of the owning steelwork
    !writeAccessCount = 0
    do !i from 1 to !fileLines.size()
      if !fileLines[!i].trim().match('--owning steelwork').gt(0) then
        !j = !i + 1
        $!fileLines[!j]
        handle ANY
          skip
        endhandle
        !owningSteel.append(!!ce.name)
        !currentSteel = !owningSteel.size()
        if !owningSteel[!currentSteel].dbref().dbwrite and !owningSteel[!currentSteel].dbref().lock.not() and !owningSteel[!currentSteel].dbref().okclh then
          !writeAccessCount = !writeAccessCount + 1
        else
          !dbwrite.append(!owningSteel[!currentSteel].dbref().dbwrite)
          !lock.append(!owningSteel[!currentSteel].dbref().lock)
          !claimable.append(!owningSteel[!currentSteel].dbref().okclh)
        endif
      endif
    enddo

    if !writeAccessCount.eq(!owningSteel.size()) then
      !writable = TRUE
    else
      !writable = FALSE
    endif

    if !writable then

      --set up an undo point
      markdb

      !this.runMacroFile(!selectedMacro)
      handle ANY
        --undo any changes done by the macro
        undodb
        !!alert.error('macro execution has produced the following error: $!!error.text, any changes made by the macro have been undone')
        return error 99
      elsehandle NONE
        --the macro ran in ok so savework, this will clear the undo mark
        savework
      endhandle

      --if we get here then all should be well. change the status of the macro file to'EXECUTED' and close it
      !status = '!macrostatus = |EXECUTED|'
      !fileLines[1] = !status
      !macroFile.writeFile('OVERWRITE', !fileLines)

    else

      do !i from 1 to !owningSteel.size()
        if !dbwrite[!i].not() then
          !dbwritetext = 'user has no write access'
        else
          !dbwritetext = 'user has write access'
        endif
        if !lock[!i] then
          !locktext = ', the element is locked'
        else
          !locktext = ', the element is not locked'
        endif
        if !claimable[!i].not() then
          !claimtext = ', the element cannot be claimed'
        else
          !claimtext = ', the element can be claimed'
        endif
        !name = !owningSteel[!i].dbref().name
        !!alert.error('the owning steelwork $!name status is:- ' + !dbwritetext + !locktext + !claimtext + '. Cannot complete macro execution')
      enddo

      --we need to run !fileLines back into the file because the open command deletes everything inside of it
      !macroFile.writeFile('OVERWRITE', !fileLines)
      return error 99
    endif

  else
    !!alert.error('the status of this input macro cannot be determined, cannot continue')
    --!macroFile.close()
    --!tempFile.deleteFile()
    --we need to run !fileLines back into the file because the open command deletes everything inside of it
    --!macroFile.writeFile('OVERWRITE', !fileLines)
    return error 99
  endif

endmethod

define method .deleteMacro()

  --get the selection
  !selectedMacro = !this.macroList.selection('RTEXT')

  --if file exists
  !macroFile = object FILE(!selectedMacro)
  if !macroFile.exists().not() then
    --if the file doesn't exist now then it is likely that it has been deleted by another user who is running in macros
    !!alert.warning('the selected macro file does not exist, this may have been deleted by another user process')
    !this.updateForm()
    return
  endif

  --read macro status
  !fileLines = !macroFile.readfile()

  if !fileLines.size().eq(0) then
    --if status is set such that macro has been run then prompt to confirm deletion
    !answer = !!alert.confirm('are you sure you wish to delete this FILE?')
    if !answer.eq('YES') then
      --delete file
      !macroFile.deleteFile()
    else
      !this.updateForm()
      return
    endif
  endif

  !status = !fileLines[1].after('!macrostatus = ').trim()
  !status = $!status
  handle ANY
    !status = ''
  endhandle

  --if status is set such that macro has been run then take no further action
  if !status.eq('PENDING') then
    !!alert.message('the selected macro file has not yet been executed, cannot continue')
    !this.updateForm()
    return
  else
    --if status is set such that macro has been run then prompt to confirm deletion
    !answer = !!alert.confirm('are you sure you wish to delete this FILE?')
    if !answer.eq('YES') then
      --delete file
      !macroFile.deleteFile()
    else
      !this.updateForm()
      return
    endif
  endif

  --update the form
  !this.updateForm()

endmethod

define method .updateForm()

  --update the file list from the hangermacros directory
  !this.getMacrofileList()

  --update the list box with the items in the MacrofileList member
  !this.macroList.clear()

  !this.macroList.setrows(!this.macrofileList)

  --now setup the rtexts for the list
  !this.macroList.rtext = !this.macrofileListRtext

  !this.macroList.val = 1
  handle ANY
    --in case there are no entries
  endhandle

  --lock gadgets if there are no files to operate on
  if !this.macrofileList.size().eq(0) then
    !this.runMacroSet.active = FALSE
    !this.deleteMacroSet.active = FALSE
    !this.runMacros.active = FALSE
    !this.deleteMacros.active = FALSE
  endif

  --navigate to the first item in the list with a PENDING status and set the buttons active
  !pendingFiles = FALSE
  !pendingNumber = 0
  do !i from 1 to !this.macrofileList.size()
    !set = !this.macrofileList[!i][1]
    !access = !this.macroSets[!set.real()].access
    if !this.macrofileList[!i][3].eq('PENDING') and !access then
      !pendingNumber = !i
      !pendingFiles = TRUE
      break
    endif
  enddo

  !executedFiles = FALSE
  do !i from 1 to !this.macrofileList.size()
    if !this.macrofileList[!i][3].eq('EXECUTED') then
      !executedFiles = TRUE
      break
    endif
  enddo

  --we have a pending macro file to run in so navigate to it and activate the macro run button.
  if !pendingFiles and !pendingNumber.neq(0) then
    !this.macroList.val = !pendingNumber
    if !this.macrofileList[!pendingNumber][3].eq('PENDING') then
      !this.runMacroSet.active = TRUE
      !this.runMacros.active = TRUE
      !this.deleteMacroSet.active = FALSE
    else
      !this.runMacroSet.active = FALSE
      !this.runMacros.active = FALSE
      !this.deleteMacroSet.active = TRUE
    endif
    if !executedFiles then
      !this.deleteMacros.active = TRUE
    else
      !this.deleteMacros.active = FALSE
    endif
  elseif !this.macrofileList.size().gt(0) then
    if !executedFiles then
      --we have a list of executed macros so only allow a delete
      !this.runMacroSet.active = FALSE
      !this.runMacros.active = FALSE
      !this.deleteMacroSet.active = TRUE
      !this.deleteMacros.active = TRUE
    else
      --we have no allowable actions
      !this.runMacroSet.active = FALSE
      !this.runMacros.active = FALSE
      !this.deleteMacroSet.active = FALSE
      !this.deleteMacros.active = FALSE
    endif
  endif

endmethod

define method .getMacrofileList()

  !this.macrofileList = object ARRAY()
  !this.macrofileListRtext = object ARRAY()
  !this.collectHangerMacroSets()

  --1 get the macro name
  --2 get the status
  --3 get the macro type
  --4 get the macro set that this macro belongs to
  do !i from 1 to !this.macroSets.size()

    !access = !this.macroSets[!i].access

    do !j from 1 to !this.macroSets[!i].fileList.size()
      !tempArray = object ARRAY()
      !macroName = !this.macroSets[!i].fileList[!j].entry()
      --now find out what the file status is
      !fileLines = !this.macroSets[!i].fileList[!j].readfile()
      if !fileLines.size().eq(0) then
        !status = ''
      else
        !status = !fileLines[1].after('!macrostatus = ').trim()
        --remove the string marks from the line
        !status = $!status
        handle ANY
          !status = ''
        endhandle
      endif

      do !k from 2 to !fileLines.size()
        if !fileLines[!k].trim().match('!macrotype = ').gt(0) then
          !macrotype = !fileLines[!k].after('!macrotype = ').trim()
          --remove the string marks from the line
          !macrotype = $!macrotype
          handle ANY
            !macrotype = ''
          endhandle
        endif
      enddo

      !macroSet = !i

      !tempArray.append(!macroSet.string())
      !tempArray.append(!macroName)
      !tempArray.append(!status)
      !tempArray.append(!macrotype)

      if !access then
        !tempArray.append('current user can run this set')
      else
        !tempArray.append('current user cannot run this set')
      endif

      !this.macrofileList.append(!tempArray)
      !this.macrofileListRtext.append(!this.macroSets[!i].fileList[!j].fullname())
    enddo
  enddo

endmethod

define method .userHasWriteAccessForSomeMacros() is BOOLEAN

  !this.getMacrofileList()
  !canRun = 0
  do !i from 1 to !this.macroSets.size()
    if !this.macroSets[!i].access then
      !canRun = !canRun + 1
    endif
  enddo

  if !canRun.gt(0) then
    return TRUE
  else
    return FALSE
  endif

endmethod

define method .runMacroFile(!path is STRING)
  $m '/$!path'
endmethod

--method to sort a list of files into ascending date and time order
define method .sortIntoDateTimeOrder(!fileList is ARRAY) is ARRAY

  --first get the file list into another array where array[1][1] is the filename and array[1][2] is the files date time
  !filesAndDateTimes = object ARRAY()
  do !i from 1 to !fileList.size()
    !tempArray = object ARRAY()
    !tempArray.append(!fileList[!i])
    --!tempArray.append(!fileList[!i].dtm())

    --we will also sort into executed and pending order as the file gets modified when it is run and
    --will be returned ahead of a pending file in the datetime sort we therefore need to read each file and extract the !macrostatus line
    !fileLines = !fileList[!i].readfile()
    !gotStatus = FALSE
    !gotDateTime = FALSE
    do !j from 1 to !fileLines.size()
      if !fileLines[!j].match('!macrostatus = ').gt(0) then
        !status = !fileLines[!j].after('!macrostatus = ').trim()
        !gotStatus = TRUE
      endif

      if !fileLines[!j].match('!dateTime = ').gt(0) then
        !dateTimeTempString = !fileLines[!j].after('!dateTime = ').trim()
        !dateTimeString = $!dateTimeTempString
        !dateTimeValues = !dateTimeString.split(',')
        !dateTime = object DATETIME(!dateTimeValues[1].real(),!dateTimeValues[2].real(),!dateTimeValues[3].real(),!dateTimeValues[4].real(),!dateTimeValues[5].real(),!dateTimeValues[6].real())
        !gotDateTime = TRUE
      endif

      --don't loop through to the end
      if !gotStatus and !gotDateTime then
        break
      endif

      if !j.eq(!fileLines.size()) then
        !status = ''
      endif
    enddo

    --add the datetime object
    !tempArray.append(!dateTime)

    --add the status line
    !tempArray.append(!status)

    !filesAndDateTimes.append(!tempArray)
  enddo

  --now sort the !filesAndDateTimes array into date time order
  !failsafeSize = !fileList.size() * !fileList.size()

  !sortFail = FALSE
  !size = !filesAndDateTimes.size()
  do !j from 1 to !failsafeSize
    !newSize = 0

    do !i from 1 to !size - 1
      if !filesAndDateTimes[!i][2].gt(!filesAndDateTimes[!i + 1][2]) then
        !arrayItem1 = !filesAndDateTimes[!i]
        !arrayItem2 = !filesAndDateTimes[!i + 1]
        !filesAndDateTimes[!i] = !arrayItem2
        !filesAndDateTimes[!i + 1] = !arrayItem1
        !newSize = !i
      endif
    enddo

    !size = !newSize
    if !size.leq(0) then
      break
    endif

    if !j.eq(!failsafeSize) then
      !sortFail = TRUE
      break
    endif
  enddo

  --now that the file list is sorted into date and time order return the sorted array
  !outputArray = object ARRAY()
  !null = object ARRAY()
  !pending = object ARRAY()
  !executed = object ARRAY()
  do !i from 1 to !filesAndDateTimes.size()
    if !filesAndDateTimes[!i][3].eq('|PENDING|') then
      !pending.append(!filesAndDateTimes[!i][1])
    elseif !filesAndDateTimes[!i][3].eq('|EXECUTED|') then
      !executed.append(!filesAndDateTimes[!i][1])
    else
      !null.append(!filesAndDateTimes[!i][1])
    endif
  enddo

  --now add the sorted file list in null,executed and pending order
  if !null.set() then
    !outputArray.appendArray(!null)
  endif

  if !executed.set() then
    !outputArray.appendArray(!executed)
  endif

  if !pending.set() then
    !outputArray.appendArray(!pending)
  endif

  if !sortFail then
    return object ARRAY()
  else
    return !outputArray
  endif

endmethod

--method to perform actions on the selected row of the macro list. if the selection is valid then it will
--allow the user to run the macro otherwise it will make the run buttons inactive
define method .selectMacro(!list is GADGET, !action is STRING)

  if !action.neq('SELECT') then
    return
  endif
  !selectedRow = !list.val

  !set = !this.macrofileList[!selectedRow][1]
  !access = !this.macroSets[!set.real()].access

  if !this.macrofileList[!selectedRow][3].eq('PENDING') and !access then
    !this.runMacroSet.active = TRUE
    !this.deleteMacroSet.active = FALSE
  elseif !this.macrofileList[!selectedRow][3].eq('PENDING') and !access.not() then
    !this.runMacroSet.active = FALSE
    !this.deleteMacroSet.active = FALSE
  else
    !this.runMacroSet.active = FALSE
    !this.deleteMacroSet.active = TRUE
  endif

  --now find out if there are any files (pending or executed so that we can set the status of the bulk processing command buttons)
  !pendingFiles = FALSE
  do !i from 1 to !this.macrofileList.size()
    !set = !this.macrofileList[!i][1]
    !access = !this.macroSets[!set.real()].access
    if !this.macrofileList[!i][3].eq('PENDING') and !access then
      !pendingFiles = TRUE
      break
    endif
  enddo

  !executedFiles = FALSE
  do !i from 1 to !this.macrofileList.size()
    if !this.macrofileList[!i][3].eq('EXECUTED') then
      !executedFiles = TRUE
      break
    endif
  enddo

  if !pendingFiles then
    !this.runMacros.active = TRUE
  else
    !this.runMacros.active = FALSE
  endif

  if !executedFiles then
    !this.deleteMacros.active = TRUE
  else
    !this.deleteMacros.active = FALSE
  endif

endmethod

define method .runMacros()

  --just bring up a confirm box to start off with
  !answer = !!alert.confirm('are you sure you wish to run all pending macros?')
  if !answer.eq('NO') then
    return
  endif

  --move to first pending macro in the list
  do !i from 1 to !this.macrofileList.size()
    !set = !this.macrofileList[!i][1]
    !access = !this.macroSets[!set.real()].access
    if !this.macrofileList[!i][3].eq('PENDING') and !access then
      !this.macroList.val = !i
      !this.prepareToRunMacro('BATCH')
      handle 99
        !!alert.error('an error has occurred during bulk macro processing - cannot continue')
        break
      endhandle
    else
      skip
    endif
  enddo

  !this.updateForm()

endmethod

define method .runMacroSet()

  --just bring up a confirm box to start off with
  !set = !this.macroList.dtext[!this.macroList.val].split()[1]
  !access = !this.macroSets[!set.real()].access

  if !access.not() then
    --should never get here as the buttons should be greyed out for this case
    !!alert.error('you do not have access to run this macro at present')
  endif

  !answer = !!alert.confirm('are you sure you wish to run all pending macros in macro set $!set?')
  if !answer.eq('NO') then
    return
  endif

  --move to first pending macro in the list
  do !i from 1 to !this.macrofileList.size()
    if !this.macrofileList[!i][1].eq(!set) and !this.macrofileList[!i][3].eq('PENDING') then
      !this.macroList.val = !i
      !this.prepareToRunMacro('BATCH')
      handle 99
        !!alert.error('an error has occurred during bulk macro processing - cannot continue')
        break
      endhandle
    else
      skip
    endif
  enddo

  !this.updateForm()

endmethod

define method .deleteMacros()

  --just bring up a confirm box to start off with
  !answer = !!alert.confirm('are you sure you wish to delete all executed macros?')
  if !answer.eq('NO') then
    return
  endif

  --loop through the macrolist and delete valid macros
  do !i from 1 to !this.macrofileList.size()

    --if file exists
    !macroFile = object FILE(!this.macrofileListRtext[!i])
    if !macroFile.exists().not() then
      skip
    endif

    if !this.macrofileList[!i][3].eq('EXECUTED') then
      !macroFile.deleteFile()
      handle ANY
        skip
      endhandle
    else
      skip
    endif

  enddo

  !this.updateForm()

endmethod

define method .deleteMacroSet()

  --just bring up a confirm box to start off with
  !set = !this.macroList.dtext[!this.macroList.val].split()[1]
  !answer = !!alert.confirm('are you sure you wish to delete all executed macros in macro set $!set?')
  if !answer.eq('NO') then
    return
  endif

  --loop through the macrolist and delete valid macros
  do !i from 1 to !this.macrofileList.size()

    --if file exists
    !macroFile = object FILE(!this.macrofileListRtext[!i])
    if !macroFile.exists().not() then
      skip
    endif

    if !this.macrofileList[!i][1].eq(!set) and !this.macrofileList[!i][3].eq('EXECUTED') then
      !macroFile.deleteFile()
      handle ANY
        skip
      endhandle
    else
      skip
    endif

  enddo

  !this.updateForm()

endmethod

--create a method that scans through the hanger macros directory and scans for operations carried out on each hanger
--these are then combined into macro sets that can be executed without fear of affecting anything else
define method .collectHangerMacroSets()

  !this.macroSets = object ARRAY()

  var !hangMacDir evar mdsHangerMacros
  !hangMacDirObj = object FILE(!hangMacDir)
  !fileList = !hangMacDirObj.files()

  if !fileList.unset() then
    return
  endif

  --sort the file list into date and time order so that we can be sure what order the macros need to be run in
  !fileList = !this.sortIntoDateTimeOrder(!fileList)
  if !fileList.unset() then
    !!alert.error('An unexpected error has occurred when sorting the macro list into date/time order please contact Aveva support')
  endif

  do !i from 1 to !fileList.size()

    --now find out what the file status is and add to the array
    !fileLines = !fileList[!i].readfile()
    if !fileLines.size().eq(0) then
      !status = ''
    else
      !status = !fileLines[1].after('!macrostatus = ').trim()
      --remove the string marks from the line
      !status = $!status
      handle ANY
        !status = ''
      endhandle

      --check if this is a new set. if the check routine returns true then we will populate the new !macroSet object
      --if the check returns false then the macroSet that this FILE belongs to will be returned
      !existingSet = object REAL()
      !newSet = !this.isThisANewMacroSet(!fileList[!i], !existingSet)
      if !newSet then
        !newMacroSet = object MDSINTERFACEHANGERMACROSET(!fileList[!i])
        !this.macroSets.append(!newMacroSet)
      else
        !this.macroSets[!existingSet].append(!fileList[!i])
        --we may have new names in the nameList as a result of the appended file so run the update method to check this
        !this.macroSets[!existingSet].updateNameList()
      endif

    endif
  enddo

  !this.addAccessRights()

endmethod

define method .isThisANewMacroSet(!file is FILE, !existingSet is REAL) is BOOLEAN

  --first get the hanger name (create a dummy mdsinterfacehangermacroset object so that we can use the getName method
  !hangerName = !this.getName(!file)
  --now loop through each of the !this.macroSets objects and check against their namelists to see if the current macro
  --belongs to one of these sets
  !thisIsNew = TRUE
  do !i from 1 to !this.macroSets.size()
    do !j from 1 to !this.macroSets[!i].nameList.size()
      if !hangerName.eq(!this.macroSets[!i].nameList[!j]) then
        !existingSet = !i
        !thisIsNew = FALSE
        break
      endif
    enddo
  enddo

  return !thisIsNew

endmethod

define method .getName(!file is FILE) is STRING

  !attaname = object STRING()

  !fileLines = !file.readfile()
  do !i from 1 to !fileLines.size()
    if !fileLines[!i].trim().match('!attaname = ').gt(0) then
      !attaname = !fileLines[!i].after('!attaname = ').trim()
      --remove the string marks from the line
      !attaname = !attaname
    endif
  enddo

  if !attaname.unset() then
    --this needs to be set so this could be an old style macro that does not have the !attaname line in the macros
    --if this is not set then try and re-scan the file to figure out what the attaname is
    do !i from 1 to !fileLines.size()
      if (!fileLines[!i].trim().match('/SBFI/H1').gt(0) or !fileLines[!i].trim().match('/FITT/H1').gt(0) or !fileLines[!i].trim().match('/CMPF').gt(0)) and !fileLines[!i].match('!!ce = ').gt(0) then
        !attaname = !fileLines[!i].before('/SBFI/H1').before('/FITT/H1').before('/CMPF').after('!!ce = ').trim()
        break
      endif
    enddo
  endif

  return !attaname

endmethod

define method .getStatus(!file is FILE) is STRING

  !fileLines = !file.readfile()
  !status = !fileLines[1].after('!macrostatus = ').trim()
  !status = $!status
  handle ANY
    !status = ''
  endhandle

  return !status

endmethod

define method .getType(!file is FILE) is STRING

  !fileLines = !file.readfile()
  do !k from 1 to !fileLines.size()
    if !fileLines[!k].trim().match('!macrotype = ').gt(0) then
      !macrotype = !fileLines[!k].after('!macrotype = ').trim()
      --remove the string marks from the line
      !macrotype = $!macrotype
      handle ANY
        !macrotype = ''
      endhandle
    endif
  enddo

  return !macrotype

endmethod

define method .addAccessRights()

  do !i from 1 to !this.macroSets.size()
    !statusNum = 0
    do !j from 1 to !this.macroSets[!i].fileList.size()
      if !j.eq(1) then
        !firstFile = !this.macroSets[!i].fileList[!j]
      endif
      if !j.eq(!this.macroSets[!i].fileList.size()) then
        !lastFile = !this.macroSets[!i].fileList[!j]
      endif
      if !this.getStatus(!this.macroSets[!i].fileList[!j]).eq('EXECUTED') then
        !statusNum = !statusNum + 1
      endif
    enddo

    --if any of the fileList files has a status of executed then we cannot run this set as there must be a problem, the user will have to do it manually
    if !statusNum.gt(0) then
      !this.macroSets[!i].access = FALSE
      skip
    endif

    !firstFileType = !this.getType(!firstFile)

    if !firstFile.entry().eq(!lastFile.entry()) then
      !lastFileType = !firstFileType
    else
      !lastFileType = !this.getType(!lastFile)
    endif

    if !firstFileType.eq('CONNECTION UPDATE') then
      !access = !this.checkConnectionUpdate(!firstFile, !lastFile)
    elseif !firstFileType.eq('RENAME') then
      !access = !this.checkrename(!firstFile, !lastFile)
    else
      --it's delete
      !access = !this.checkDelete(!firstFile, !lastFile)
    endif

    !this.macroSets[!i].access = !access

  enddo

endmethod

define method .checkConnectionUpdate(!firstFile is FILE, !lastFile is FILE) is BOOLEAN
  --check that the references to the owning steelwork are reachable and writable by the user
  !firstFileLines = !firstFile.readfile()
  !owningSteel = object ARRAY()
  do !i from 1 to !firstFileLines.size()
    if !firstFileLines[!i].match('owning steel').gt(0) then
      !j = !i + 1
      !owningSteel.append(!firstFileLines[!j])
    endif
  enddo

  !access = 0
  do !i from 1 to !owningSteel.size()
    $!owningSteel[$!i]
    handle (2,109)
      --the owning steelwork does not exist so access is not available
      skip
    endhandle

    if !!ce.dbwrite and  !!ce.lock.not() then
      !access = !access + 1
    endif
  enddo

  if !access.eq(!owningSteel.size()) then
    return TRUE
  else
    return FALSE
  endif
endmethod

define method .checkrename(!firstFile is FILE, !lastFile is FILE) is BOOLEAN
  --check that the references to the owning steelwork or existing fitting are reachable and writable by the user
  !firstFileLines = !firstFile.readfile()
  !fittingToRename = object ARRAY()
  do !i from 1 to !firstFileLines.size()
    if !firstFileLines[!i].match('!!ce = ').gt(0) then
      !fittingToRename.append(!firstFileLines[!i])
    endif
  enddo

  !access = 0
  do !i from 1 to !fittingToRename.size()
    $!fittingToRename[$!i]
    handle (2,109)
      --the owning steelwork does not exist so access is not available
      skip
    endhandle

    if !!ce.dbwrite and  !!ce.lock.not() then
      !access = !access + 1
    endif
  enddo

  if !access.eq(!fittingToRename.size()) then
    return TRUE
  else
    return FALSE
  endif
endmethod

define method .checkDelete(!firstFile is FILE, !lastFile is FILE) is BOOLEAN
  --check that the references to the owning steelwork or existing fitting are reachable and writable by the user
  !firstFileLines = !firstFile.readfile()
  !fittingToDelete = object ARRAY()
  do !i from 1 to !firstFileLines.size()
    if !firstFileLines[!i].match('!!ce = ').gt(0) then
      !fittingToDelete.append(!firstFileLines[!i])
    endif
  enddo

  !access = 0
  do !i from 1 to !fittingToDelete.size()
    $!fittingToDelete[$!i]
    handle (2,109)
      --the owning steelwork does not exist so access is not available
      skip
    endhandle

    if !!ce.dbwrite and  !!ce.lock.not() then
      !access = !access + 1
    endif
  enddo

  if !access.eq(!fittingToDelete.size()) then
    return TRUE
  else
    return FALSE
  endif
endmethod
