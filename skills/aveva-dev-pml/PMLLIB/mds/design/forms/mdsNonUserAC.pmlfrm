--
-- File: mdsNonUserAC.pmlfrm
--    Type: Form Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--      Module: Design
--
-- Author: Wayne Dodwell
-- Created: Friday 13th March 2009
--
-- Description:
-- Non User Form Definition for storing ALL the NON USER ANCILLARY "AC"
-- Standard Support Types found in the MDS defaults file, DES-SUPP DEFS
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsNonUserAC()                   -
--
kill !!mdsNonUserAC

-- Define Form
setup form  !!mdsNonUserAC
  !this.formTitle    = |Ancillary "AC" Support Types - Non User SYSTEM FORM...|

  -- Body of Form
  list .standard |"AC" Types Only:                          | at x1 y0.5 width 60 length 18
  path down
  vdist 1

  -- Bottom Line
  button .cancel | Dismiss | at xmax form-8 ok

  -- Members
  member .sizes is ARRAY
  member .error is BOOLEAN
  member .emess is STRING

  -- End form definition
exit
--
--------------------------------------------------------------------------------
--
-- Method: .init()
--
-- Load ALL the NON USER ANCILLARY "AC" Standard Support Types found in the
-- MDS application defaults file for the current Project, e.g. DES-SUPP DEFS
--------------------------------------------------------------------------------
-- Define Method
define method .mdsNonUserAC()

  -- Clear existing list entries
  !this.standard.clear()
  !this.error = FALSE

  -- <RM> 23/07/09 upgraded the original code to work in the 12 environment
$(
-- Only load the "AC" Support Types - Integral MDS Non User Ancillaries
!pref = ARRAY()
!pref.append('AC')

-- Populate list with required attachments
!!mdsReaddefs(!this,!pref)
$)

  -- Determine the MDS ANCILLARIES where :MDSACTIVE is TRUE for each SECTION element in the PARAGON /MDS/ATTA/DEFAULTS Catalogue
  !ctype = |SECTION|
  !scope = /MDS/ATTA/DEFAULTS
  !filtr = object EXPRESSION(|:mdsactive eq TRUE|)
  -- Collect ALL of the SECTION Elements
  !sect  = object COLLECTION()
  !sect.filter(!filtr)
  !sect.scope(!scope)
  !sect.type(!ctype)
  -- SECTION Collection Results Array
  !sectresults = !sect.results()

  -- Determine the MDS ANCILLARY types to LOAD into the !!mdsAllAncill form
  !mdsstds = ARRAY()
  do !vald value !sectresults
    if (!vald.description.matchwild('AC*')) then
      if (!vald.description.match('AC17').gt(0)) then
        if (!vald.description.length().gt(4)) then
          -- do not add this reference for AC17 if there are more than 4 characters in the string
          -- this is to remove references in the form list for long ac17 codes such as AC171126
          skip
        endif
      endif
      !mdsstds.append(!vald)
    else
      skip
    endif
  enddo

  -- Remove any Duplicate Entries in the ARRAY
  !mdsstds.unique()

  -- SORT ARRAY into ALPHABETICAL and NUMBER order
  !sindices = !mdsstds.sortedindices()
  !mdsstds.reindex(!sindices)

  -- Load the form list gadget !!mdsAllAncill.standard with the ACTIVE MDS ANCILLARY SUPPORT types
  -- ABORT MDS Application and FORM list gadget LOADING if the ARRAY !mdsstds is EMPTY
  if (!mdsstds.empty()) then
    -- ???ABORT MDS Loading??? - Default ERROR and Message set in loading of the FORM !!mdsAllAncill
    return
  else
    !unusedMdsloadAncDefs = object MDSLOADSTDDEFS(!this, !mdsstds)
    if (!this.error) then
      !!alert.error('error in compiling ancillary list')
      return
    endif
  endif

  -- Set Form Gadget
  --!this.standard.dtext = !mdsstds
  --handle NONE
  --  !this.standard.rtext = !mdsstds
  --elsehandle ANY
  --endhandle
  -- <RM> 23/07/09 upgraded the original code to work in the 12 environment - end

  -- Put number of available standards on form
  !size = !this.standard.dtext.size()
  !this.standard.tag = 'Available "AC" Types = ' & !size

endmethod
