--
-- File: mdsSelectionList.pmlfrm
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: R.Martin
-- Created: 31/07/09
--
--
-- Description:
-- displays valid selections for components that are identified from the SELE list in /ATTA/DEFAULTS
-- see mdsValidComponent for usage
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  populate(STRING,STRING,ARRAY)    -
--
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

kill !!mdsSelectionList

setup form !!mdsSelectionList size 30 5

  !!mdsSelectionList.formtitle      = |Message|
  !!mdsSelectionList.icontitle      = ||
  !!mdsSelectionList.callback       = ||
  !!mdsSelectionList.initcall       = ||

  -- Body of Form
  para .messageIcon at x1 ymin+0.2 pixmap width 33 height 34
  para .message1 at x7 ymin.messageIcon text '' width 20
  para .message2 at x7 ymax+0.2 text '' width 20
  list .selections at x1 ymax+0.2 width 26 height 4
  button .ok     '   OK   ' at xmin+9 ymax+0.2 ok

exit

!!mdsSelectionList.messageIcon.addpixmap(!!pml.getPathName('message.png'))

define method .populate(!requiredComponent is STRING, !currentComponent is STRING, !allowableComponents is ARRAY)

  -- !requiredComponent -> alias of component we want to create i.e. ST43
  -- !currentComponent -> dbref of component we want to create against i.e. a pipe shoe
  -- !allowableComponents -> list of valid items in a selection list

  !message1 = 'Incompatible type ' & !currentComponent
  !message2 = 'Allowable selections for ' & !requiredComponent & ' are:'
  !this.message1.val = !message1
  !this.message2.val = !message2
  !this.selections.dtext = !allowableComponents

endmethod
