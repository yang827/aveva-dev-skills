--
-- File:  mdsTrunnionTypePicker.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--
-- Author:  Richard Martin
-- Created:  13/05/13
--
--
-- Description:
-- Form Definition for trunnion selection when creating from a preliminary support
--
-- this FORM is called during the mdsCreateGeneralFromPS function and is used when creating a trunnion from a preliminary support atta.
-- this is required because multiple trunnion types may be available when generating the support from the prelim atta. it is therefore necessary
-- to require the user to input their preference before moving into the creation form automatically.

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply (STRING)                   -
--  callElbow()                      -
--  cancel ()                        -
--  finalise()                       -
--  findvalidoptions (BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN) -
--  idElbow()                        -
--  init (FORM,STRING,DBREF,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,STRING) -
--  mdsTrunnionTypePicker()          -
--

-- Kill existing form definition
kill !!mdsTrunnionTypePicker

-- Define Form
setup form !!mdsTrunnionTypePicker at xr0 yr0 noquit

  !!mdsTrunnionTypePicker.formtitle    = |Pick Type|
  !!mdsTrunnionTypePicker.icontitle    = ||
  !!mdsTrunnionTypePicker.callback     = ||

  para .tag text |Select Component Type To Support|

  frame .fdatum |Datum| at x0 ymax width 31

    button .crelbo at x1 ymin       tooltip 'Create on Elbow'   pixmap width 18 height 18 call |!this.apply('CRELBO')|
    button .crtube at xmax+0.5 ymin tooltip 'Create on Tube'    pixmap width 18 height 18 call |!this.apply('CRTUBE')|
    button .crredu at xmax+0.5 ymin tooltip 'Create on Reducer' pixmap width 18 height 18 call |!this.apply('CRREDU')|
    button .crcros at xmax+0.5 ymin tooltip 'Create on Cross'   pixmap width 18 height 18 call |!this.apply('CRCROS')|

  exit

  button .cancel | Cancel | at xmax.fdatum-size ymax.fdatum+0.1 call |!this.cancel()|

  member .form is FORM
  member .name is STRING
  member .datum is DBREF
  member .preSuppFunc is STRING

exit

define method .mdsTrunnionTypePicker()

  !!mdsSetIconBack(!!mdsTrunnionTypePicker,'white')

endmethod

--init method
define method .init (!form is FORM, !name is STRING, !datum is DBREF, !crelbo is BOOLEAN, !crtube is BOOLEAN, !crcros is BOOLEAN, !crredu is BOOLEAN, !preSuppFunc is STRING)

  --show the form
  !!kshowform(!!mdsTrunnionTypePicker)

  --populate members
  !this.form = !form
  !this.name = !name
  !this.datum = !datum
  !this.preSuppFunc = !preSuppFunc

  --look for valid options based upon the current prelim support location
  !this.findvalidoptions(!crelbo, !crtube, !crcros, !crredu)

endmethod

--scan to make sure that options should be available. for instance do not activate an ELBO pick if no elbows exist in the line
define method .findvalidoptions (!crelbo is BOOLEAN, !crtube is BOOLEAN, !crcros is BOOLEAN, !crredu is BOOLEAN)

  --crtube does not rely upon components so just set active if it should be
  if !crtube then
    !this.crtube.active = $!crelbo
  else
    !this.crtube.active = FALSE
  endif

  --do some simple tests for now i.e. are there any of this component type in the branch
  if !crelbo then
    var !elbo collect all ELBO for owner of $!this.datum
    if !elbo.size().gt(0) then
      !this.crelbo.active = $!crelbo
    else
      !this.crelbo.active = FALSE
    endif
  else
    !this.crelbo.active = FALSE
  endif

  if !crcros then
    var !tee collect all TEE for owner of $!this.datum
    if !tee.size().gt(0) then
      !this.crcros.active = $!crcros
    else
      !this.crcros.active = FALSE
    endif
  else
    !this.crcros.active = FALSE
  endif

  if !crredu then
    var !redu collect all REDU for owner of $!this.datum
    if !redu.size().gt(0) then
      !this.crredu.active = $!crredu
    else
      !this.crredu.active = FALSE
    endif
  else
    !this.crredu.active = FALSE
  endif

  --if the icon is available just set the tube option
  !this.crtube.active = $!crtube

  --auto call the correct option if only one is available
  !activeCount = 0
  if !this.crtube.active then
    !activeCount = !activeCount + 1
  endif

  if !this.crelbo.active then
    !activeCount = !activeCount + 1
  endif

  if !this.crredu.active then
    !activeCount = !activeCount + 1
  endif

  if !this.crcros.active then
    !activeCount = !activeCount + 1
  endif

  if !activeCount.eq(1) then
    --we only have one callback available so fire it
    if !this.crelbo.active then
      !this.apply('CRELBO')
    elseif !this.crtube.active then
      !this.apply('CRTUBE')
    elseif !this.crredu.active then
      !this.apply('CRREDU')
    else
      !this.apply('CRCROS')
    endif
  elseif !activeCount.eq(0) then
    !!alert.message('no valid selections currently exist for this type')
  endif

endmethod

--run the host form's creation callback
define method .apply (!type is STRING)

  !!mdsTrunnionTypePicker.hide()

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  !!kshowform(!this.form)

  if !type.eq('CRELBO') then
    --we need to intercept the command waiton !!mdsTT36selPrelim before we get to any of the mdssetdat routines in !this.form.crelbo.callback
    --this is because there is a flaw in the pml core command process that prevents waiton being used when called from a form or object method like this.
    --so instead we need to id the elbow, setup the appropriate options within mdsTT36selPrelim and then call mdssetdatfunction as part of mdsTT36selPrelim
    !trunnionType = !this.form.fullname().upcase().after('MDS')
    if (!trunnionType inset ('TT36', 'TT37', 'TT42', 'TT43', 'TT44')) then
      !this.idElbow()
      --processing is complete for these types here so return
      return
    else
      $!this.form.crelbo.callback
    endif
  elseif !type.eq('CRTUBE') then
    $!this.form.crtube.callback
  elseif !type.eq('CRREDU') then
    $!this.form.crredu.callback
  elseif !type.eq('CRCROS') then
    $!this.form.crcros.callback
  endif

  --hide the form, delete the prelim atta and perform any other final actions
  !this.finalise()

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endmethod

define method .cancel ()

  --this means that the user has pressed escape during the selection process. return and reset the prelim name
  !this.datum.name = !this.name
  !this.hide()
  return

endmethod

define method .idElbow()

  prompt off
  prompt load escape 'Identify Elbow to create trunnion'
  ID ELBO @
  handle (61,528)
    prompt on
    !!mdsCancelSupp(!this.form)
    return FALSE
  endhandle
  prompt on
  !!mdsTT36selPrelim.direction1.tag = !!ce.adir.opposite().string()
  !!mdsTT36selPrelim.direction2.tag = !!ce.ldir.opposite().string()
  --show the !!mdsTT36selPrelim form
  show !!mdsTT36selPrelim

endmethod

define method .finalise()

  !!ce = !this.name.dbref()
  handle (2,109)
    --this means that the user has pressed escape during the selection process. return and reset the prelim name
    !this.datum.name = !this.name
    !this.form.hide()
    return
  endhandle

  bran
  !isTrunnion = !!ce.:MDSTrun
  handle any
  elsehandle none
    if (!isTrunnion) then
      var !attas collect all atta for ce
      do !atta values !attas
        !atta.dbref().:mdssuppfunc = !this.preSuppFunc
      enddo
      !!ce = !this.datum
      if !this.form.support.alias.substring(1,2).eq('TT') then
        --delete the original atta because a trunnion does not contain a datum or geometry atta
        --other trunnion based supports such as LT's do require the atta so don't delete it
        delete atta
      endif
    endif
  endhandle

endmethod

define method .callElbow()

  $!this.form.crelbo.callback
  !this.finalise()

endmethod
