--
-- File:    mdsancmat.pmlfrm
--   Type:    Form
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Tuesday 10th August 2004
--
--
-- Description:
-- Form Definition for selecting the Material Reference on
-- MDS Pipe Ancillary supports (ATTAs) - UDA :MDSMatRef /Matref at 12.0
-- Updated to Matref at PDMS12.0
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ancill(FORM)                     -
--  apply()                          -
--  cancel()                         -
--  enhance()                        -
--  init(FORM)                       -
--  matref()                         -
--  name(FORM)                       -
--  rpadmatref()                     -
--  select()                         -
--  select(GADGET,STRING)            -
--  selmat()                         -
--  setall()                         -
--  setrpadmtoref()                  -
--  unenhance()                      -
--

-- Kill existing form definition
kill !!mdsancmat

-- Define form
setup form !!mdsancmat

  !this.formtitle  = 'Set Ancillary Material'
  !this.cancelcall = '!this.cancel()'

  -- Display Support Name
  paragraph .name at xmax+1 ymin text |!this.name()| width 60 lines 1

  -- Selection Frame
  frame .selframe | Select | at x1 ymax

    -- List of Ancillaries on the Support
    list .ancill |Ancillaries| at x1 ymax call |!this.select(| multi width 25 length 10

    -- List of Available Materials
    list .matref |Materials|   at xmax ymin width 40 length 10

    --  Set Material to all ancillaries on the Support
    toggle .setall |Select All Ancillaries | at x1 ymax call |!this.setall()|

  exit

  -- Apply Form
  button .apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|
  -- Dismiss Form
  button .cancel | Dismiss | at xmax form-size ymin call |!this.cancel()| cancel


  -- Additional Form Members
  member .rpadattas is ARRAY
  member .rpaddtext is ARRAY
  member .rpadrtext is ARRAY

  member .mainattas is ARRAY
  member .maindtext is ARRAY
  member .mainrtext is ARRAY
  -- Exit form definition
exit

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------
--
--------------------------------------------------------------------
define method .init(!form is FORM)
  --------------------------------------------------------------------

  if (!form.support.atta.size().lt(1)) then
    !!alert.warning('Ancillary supports have to exist to be able to set the Material')
    return
  endif

  -- Clear All Values from ALL of the Form Array members for the "RPAD attas" and the "MAIN attas"
  !this.rpadattas.clear()
  !this.rpaddtext.clear()
  !this.rpadrtext.clear()
  !this.mainattas.clear()
  !this.maindtext.clear()
  !this.mainrtext.clear()

  -- Populate Form Ancillaries List
  !this.name(!form)
  !this.ancill(!form)
  if (!this.ancill.dtext.size().eq(0)) then
    !!alert.message('The Material for each Ancillary on the Current Support has been fixed to its default and may NOT be modified')
    return
  endif

  -- Always Select the FIRST ATTA in the list on INITIALISATION
  !this.ancill.clearselection()
  !this.ancill.select('dtext', !this.ancill.dtext[1])

  -- Populate Form Material List Array for MAIN Attas with the available PROPCON Materials
  !this.matref()

  -- Populate Form Material List Arrays for RPAD Attas with the available PIPE and/or PLATE Specification Materials
  !this.rpadmatref()

  -- The FIRST atta in the list .ancill is always selected on initialisation of this FORM.
  -- Ensure that the CORRECT Materials are displayed in the Materials List (MAIN or RPAD atta materials)
  -- and the correct material is selected for the FIRST atta in the list.
  !selatta = !this.ancill.selection()[1]

  -- Determine if Selected Atta is a MAIN or a RPAD Atta
  if (!this.rpadattas.findfirst(!selatta).set()) then
    -- First Atta is a RPAD Atta so Populate the Material list gadget .matref with PDMS Pipe & Plate Specifications
    !this.setall.val    = FALSE
    !this.setall.active = FALSE
    if (!this.rpaddtext.size().eq(0)) then
      !!alert.message('PIPE and/or PLATE Specification Materials are NOT available for the RPAD type of Ancillary supports. Unable to display the Ancillary Material form.')
      return
    endif
    -- Select the PIPE or PLATE Specification of the First Atta Selected in the List i.e. a RPAD Atta
    !this.selmat()
  elseif (!this.mainattas.findfirst(!selatta).set()) then
    -- First Atta is a MAIN Atta so Populate the Material list gadget .matref with PROPCON Materials
    -- This is the DEFAULT and has already been done at approx. line 100 above i.e.
    -- Populate Form Materials List Arrays for Main Attas
    !this.setall.val    = FALSE
    !this.setall.active = TRUE
    if (!this.maindtext.size().eq(0)) then
      !!alert.message('PROPCON Materials are NOT available for the Non-RPAD type of Ancillary supports. Unable to display the Ancillary Material form.')
      return
    endif
    -- Select the PROPCON Material of the First MAtta Selected in the List i.e. a Non-RPAD Atta
    !this.selmat()
  endif

  -- Unenhance ALL Ancillaries - whatever is being done
  !this.unenhance()
  -- Enhance the SELECTED Ancillaries in the Colour RED <Colour N0.2>
  enhance $!selatta col 2

  -- Show Form if Ancillary and Materials Exist
  !this.show()

  -- Make select all toggle inactive if only 1 atta in list
  if !this.ancill.dtext.size().eq(1) then
    !this.setall.active = FALSE
  endif

endmethod

--------------------------------------------------------------------
define method .name(!form is FORM)
  --------------------------------------------------------------------

  !this.name.val = 'Support Name: ' & !form.name.val

endmethod

--------------------------------------------------------------------
define method .ancill(!form is FORM)
  --------------------------------------------------------------------

  !ancill = !form.support.atta
  !dtext  = ARRAY()
  !rtext  = ARRAY()

  !orig = !!ce

  -- Check All Support Attas
  do !atta values !ancill
    skip if (!atta.name.match('/SREF').gt(0))
    skip if (!atta.name.match('/SREF').gt(0))
    skip if (!atta.name.matchwild('*/NOTE*'))
    skip if (!atta.name.match('/MAKEUP').gt(0))
    !!ce = !atta
    ---------------------------------------------------------------------------------------------------
    --<wd>mar2006<mds12>
    -- Determine the MATERIAL DYNAMICALLY for each MDS ANCILLARY on the MDS SUPPORT
    --!chkmat   = object MDSCHECKSTD()
    !lbor = !atta.lbor.real().value()
    !mdsattaobj  = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype, !lbor)
    if (!mdsattadefs.not()) then
      --!!alert.warning('Unable to modify the material for the MDS ANCILLARY $!atta.name, as it is NOT ACTIVE in the current PDMS project ')
      skip
    endif
    !chkmat = object MDSCHECKSTD(!mdsattaobj)
    !!ce   = !atta
    --<wd>mar2006<mds12>
    ---------------------------------------------------------------------------------------------------

    skip if (!chkmat.modmaterial().not())
    !dtext.append(!atta.name)

    -- Load the TWO Form Member Arrays --> (1) for .rpadattas and (2) for .mainattas <--
    if (!atta.catref.owner.:mdsrpad) then
      -- All of the RPAD Attas on the Support are stored in the form member array ".rpadattas"
      !this.rpadattas.append(!atta.name)
    else
      -- The rest of the Attas on the Support are stored in the form member array ".mainattas"
      !this.mainattas.append(!atta.name)
    endif
  enddo

  !this.ancill.dtext = !dtext.unique()
  !!ce = !orig

endmethod

--------------------------------------------------------------------
define method .matref()
  --------------------------------------------------------------------

  -- Initialise variable
  !matexist = false
  !dtext = ARRAY()
  --!dtext.append(' unset')
  !rtext = ARRAY()
  --!rtext.append(' default')

  -- Get all the Materials available in the Propcon Database
  !desc = (desc of /MDS/TEMPLATES )
  handle ANY
    !desc = 'MDS'
  endhandle

  if !desc.eq('Framatome Templates') then
    !sden = !!kcollectallfor('SDEN', ':MdsMts of owner of owner eq |ANCILL|', =0/0)
  else
    !sden = !!kcollectallfor('SDEN', 'sref of owner eq |STD| and pres eq -100000 and temp eq -100000 and pqual of owner eq |MDS|', =0/0)
  endif

  if (defined(!sden) or !sden.size().neq(0)) then
    !bsoli = object BLOCK('!sden[!evalindex].owner.owner')
    !solid = !sden.evaluate(!bsoli)

    !bdesc = object BLOCK('!sden[!evalindex].owner.owner.description')
    !descr = !sden.evaluate(!bdesc)

    !bdens = object BLOCK('!sden[!evalindex].density')
    !dens  = !sden.evaluate(!bdens)

    !altdesc = object BLOCK('!sden[!evalindex].owner.owner.:MDSMatDesc')
    !altd    = !sden.evaluate(!altdesc)

    !matexist = true
  endif


  -- Load the list with the available materials
  if (!matexist) then

    !dsiz  = (!dens.width() + 15)
    !order = !descr.sortedindices()

    do !indx values !order
      !denx = !dens[!indx].string('d2')
      if !descr[$!indx].neq('') then
        !csiz  = !descr.width()
        var !dprt compose space 1 |$!descr[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      else
        !csiz  = !altd.width()
        var !dprt compose space 1 |$!altd[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      endif
      !dtext.append(!dprt[1])
      !rtext.append(!solid[!indx].string())
    enddo

    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext

    -- Load the Main Material Arrays
    !this.maindtext = !dtext
    !this.mainrtext = !rtext
  endif

endmethod

--------------------------------------------------------------------
define method .setall()
  --------------------------------------------------------------------

  if (!this.setall.val) then
    --!ancill = !this.ancill.dtext
    !ancill = !this.mainattas
    do !count indices !ancill
      --!this.ancill.select('dtext', !this.ancill.dtext[!count])
      !this.ancill.select('dtext', !this.mainattas[!count])
    enddo
  else
    !this.ancill.clearselection()
    !this.ancill.select('dtext', !this.ancill.dtext[1])
  endif

  -- Enhance Graphically the selected Ancillaries
  !this.select()

endmethod


--------------------------------------------------------------------
define method .select(!object is GADGET, !action is  STRING)
  if !action.eq('SELECT') OR !action.eq('UNSELECT') then
    !this.select()
  endif
endmethod

--------------------------------------------------------------------
define method .select()
  --------------------------------------------------------------------

  if !this.ancill.pickedfield.eq(0) then
    !pickedfield = 1
  else
    !pickedfield = !this.ancill.pickedfield
  endif

  if (!this.ancill.dtext[!pickedfield].dbref().catref.owner.:mdsrpad) then
    -- Selected Atta is a RPAD Atta, so UNSELECT all other Attas, as RPAD Materials are ONLY available for Each Individual RPAD Atta
    !this.ancill.clearselection()

    !this.ancill.select('dtext',!this.ancill.dtext[!pickedfield])
    !this.setall.val    = FALSE
    !this.setall.active = FALSE

  else
    -- Selected Atta is a Non-RPAD Atta, so UNSELECT a RPAD Atta if currently highlighted/selected in the list.
    if (undefined(!this.ancill.selection()[1])) then
      !this.unenhance()
      return
    endif

    -- However if ONLY Non-RPAD Attas are currently highlighted/selected in the list,
    -- then APPEND the selected ATTA to the highlighted list
    if (!this.ancill.selection()[1].dbref().catref.owner.:mdsrpad) then
      -- ONLY a RPAD Atta was previously selected so UNSELECT all Previously Selected ATTAs
      !this.ancill.clearselection()
      !this.ancill.select('dtext',!this.ancill.dtext[!pickedfield])
    endif
    if !this.ancill.dtext.size().gt(1) then
      !this.setall.val    = FALSE
      !this.setall.active = TRUE
    endif
  endif

  !vals = !this.ancill.val
  !sels = !this.ancill.selection()

  -- Unenhance ALL Ancillaries - whatever is being done
  !this.unenhance()

  if (!vals.unset()) then
    -- No Ancillaries selected - so leave the display list unenhanced
    !this.setall.val = false
  else
    -- Enhance ONLY the Selected Ancillaries in RED<Colour No.2>
    do !indx values !sels
      enhance $!indx col 2
    enddo

    --    if (!vals.size().eq(!this.ancill.dtext.size())) then
    if (!vals.size().eq(!this.mainattas.size())) AND !this.ancill.dtext.size().gt(1) then
      !this.setall.val = true
    else
      !this.setall.val = false
    endif

  endif

  -- Select the Material of the First Selected in the List
  if (undefined(!this.ancill.selection()[1])) then
    !this.unenhance()
  else
    !this.selmat()
  endif

endmethod

--------------------------------------------------------------------
define method .selmat()
  --------------------------------------------------------------------

  -- Select the CORRECT type of Ancillary material
  !vals = !this.ancill.val
  !sels = !this.ancill.selection()
  !last = !this.ancill.pickedfield

  if (!vals.unset()) then
    !this.matref.clearselection()
  endif

  if (!this.ancill.selection()[1].dbref().catref.owner.:mdsrpad.not()) then
    -- Load and Select the Non-RPAD Ancillary PROPCON Material if SET and it Exists in the List
    if (!vals.unset()) then
      !this.matref.clearselection()
    endif

    -- Clear .matref DTEXT and RTEXT values
    !dtext = ARRAY()
    !rtext = ARRAY()
    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext
    !real = !this.mainattas.findfirst(!this.ancill.selection()[1])
    -- Load and Select the Non-RPAD Ancillary Propcon Materials if HIGHLIGHT it if it Exists in the .matref List gadget
    !dtext = !this.maindtext
    !this.matref.dtext = !dtext
    !rtext = !this.mainrtext
    !this.matref.rtext = !rtext

    -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
    -- the matref attribute has been added to atta. Find the correct attribute to use
    -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref

    if (!vals.size().eq(1)) then
      !valx = !this.ancill.val
      !valu = !valx[1]
      !atta = !this.ancill.dtext[!valu].dbref()
      !matrefAtt = !!mdsUseMatref(!atta)
      if !matrefAtt.eq('UDA') then
        if (!atta.:mdsmatref.set()) then
          !this.matref.select('rtext', !atta.:mdsmatref.string())
          handle any
          endhandle
        else
          !this.matref.clearselection()
        endif
      else
        if (!atta.matref.set()) then
          !this.matref.select('rtext', !atta.matref.string())
          handle any
          endhandle
        else
          !this.matref.clearselection()
        endif
      endif

    else
      if (!last.neq(0)) then
        !atta = !this.ancill.dtext[!last].dbref()
      else
        !atta = !this.ancill.dtext[1].dbref()
      endif
      !matrefAtt = !!mdsUseMatref(!atta)
      if !matrefAtt.eq('UDA') then
        if (!atta.:mdsmatref.set()) then
          !this.matref.select('rtext', !atta.:mdsmatref.string())
        else
          !this.matref.clearselection()
        endif
      else
        if (!atta.matref.set()) then
          !this.matref.select('rtext', !atta.matref.string())
        else
          !this.matref.clearselection()
        endif
      endif
    endif

  elseif (!this.ancill.selection()[1].dbref().catref.owner.:mdsrpad) then
    -- Clear .matref DTEXT and RTEXT values
    !dtext = ARRAY()
    !rtext = ARRAY()
    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext
    -- Get the Selected RPAD Atta iteration in the .rpadattas Array
    !real = !this.rpadattas.findfirst(!this.ancill.selection()[1])
    -- Load and Select the RPAD Ancillary PIPE and/or PLATE Specification Material if SET and it Exists in the List
    !dtext = !this.rpaddtext[!real]
    !this.matref.dtext = !dtext
    !rtext = !this.rpadrtext[!real]
    !this.matref.rtext = !rtext

    -- Select the Spec currently stored at the ATTA MTOREF attribute of the RPAD Atta
    -- Get the Specification NAME of the RPAD Material from the MTOREF and Select it if Possible
    !mtoref = !this.rpadattas[!real].dbref().mtoref[1].name
    handle ANY
      return
    endhandle
    !mtospc = name of spec of $!mtoref
    !this.matref.select('rtext','$!mtospc')
    handle any
    endhandle

  endif

endmethod

--------------------------------------------------------------------
define method .unenhance()
  --------------------------------------------------------------------

  -- Unenhance ALL Ancillaries
  --!ancills = !this.ancill.dtext
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    unenhance $!indx
  enddo

  -- Re-Enhance ALL Ancillaries in the User-Defined Graphical Highlight Colour
  !this.enhance()

endmethod

--------------------------------------------------------------------
define method .enhance()
  --------------------------------------------------------------------

  -- Enhance ALL Ancillaries in the Graphical Highlight Colour
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    unenhance $!indx
    enhance $!indx col $!!gphcolopt.highlight.code
  enddo

  -- Enhance Support STRUCTURE if one Exists or Redoes the Single ATTA support
  !name = !this.name.val.after('Support Name: ').trim()
  if (!name.match('/').neq(1)) then
    !name = '/' & !name
  endif

  unenhance $!name
  enhance $!name col $!!gphcolopt.highlight.code
endmethod

--------------------------------------------------------------------
define method .apply()
  --------------------------------------------------------------------

  -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
  -- the matref attribute has been added to atta. Find the correct attribute to use
  -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref

  !ancills = !this.ancill.selection()
  !matr = !this.matref.selection().dbref()
  handle (2,813)
    -- (2,813)   Cannot convert string to DBREF
    -- Set to be a STRING ('default')
    !matr = !this.matref.selection().trim()
  endhandle

  !!mdsdaccontrol(true)

  if (!ancills.set()) then
    if (!this.ancill.selection()[1].dbref().catref.owner.:mdsrpad.not()) then
      -- Set ALL of the SELECTED Attas uda :MDSMATREF to the Non-RPAD Ancillary PROPCON Material selected in the .matref list gadget
      do !indx values !ancills
        !atta = !indx.dbref()
        !matrefAtt = !!mdsUseMatref(!atta)
        if !matrefAtt.eq('UDA') then
          !atta.:mdsmatref = !matr
          handle (2,794)
            -- (2,794)   Cannot assign to attribute.  Object must be of type <DBREF>
            -- Setting value to 'default' i.e. 'unset'
            !!ce = !atta
            :mdsmatref $!matr
          elsehandle any
            !!ce = !atta
            !nameofatta = !!ce.name
            !!alert.error('Unable to modify the material of $!nameofatta as write access is not available')
            skip
          endhandle
        else
          !atta.matref = !matr
          handle (2,794)
            -- (2,794)   Cannot assign to attribute.  Object must be of type <DBREF>
            -- Setting value to 'default' i.e. 'unset'
            !!ce = !atta
            matref $!matr
          elsehandle any
            !!ce = !atta
            !nameofatta = !!ce.name
            !!alert.error('Unable to modify the material of $!nameofatta as write access is not available')
            skip
          endhandle
        endif
      enddo

    elseif (!this.ancill.selection()[1].dbref().catref.owner.:mdsrpad) then
      -- Set the SELECTED Atta attribute MTOREF to the RPAD Ancillary PIPE/PLATE Specification Material selected in the .matref list gadget
      !this.setrpadmtoref()
      !!ce = !this.ancill.selection()[1].dbref()
      unenhance ce
      enhance ce col 2
    endif

  endif

  !!mdsdaccontrol(false)

endmethod

--------------------------------------------------------------------
define method .cancel()
  --------------------------------------------------------------------

  -- Unenhance ALL Ancillaries and Return to the Set Highlight Colour
  !this.unenhance()

endmethod

--------------------------------------------------------------------------------
define method .rpadmatref()
  --------------------------------------------------------------------------------

  -- Store Units etc...
  !currentUnits = !!kgetsetunits()

  -- Save db position
  !origin = !!ce

  -- When Piping Specifications exist with a purp of PLAT - Add these to the list of Piping Specs with a PURPOSE of PIPE
  !worl  = object DBREF()
  !pltspc = !!kcollectallfor('SPEC','purp eq |PLAT|',!worl)
  !pipspc = !!kcollectallfor('SPEC','purp eq |PIPE|',!worl)
  -- Combine List of Pipe and RPAD Plate - Piping Specifications
  !specs  = !pltspc
  !specs.appendarray(!pipspc)

  -- Loop Through ALL of the RPAD attas on the Support
  do !indx indices !this.rpadattas
    -- Initialise/Reset Variables
    !dtext = ARRAY()
    !rtext = ARRAY()

    -- Go to each spec and find the tube component for each RPAD ATTA at its CORRECT BORE Size
    !ce    = !!ce
    !atta  = !this.rpadattas[!indx].dbref()
    !brspc = !atta.owner.owner.pspe
    handle ANY
      !brspc = !atta.owner.pspe
    endhandle

    -- Find out what the shop flag of the standard is and only load that type
    !bore     = pl bore of $!atta

    ---------------------------------------------------------------------------------------------------
    --<wd>mar2006<mds12>
    -- The TWO variables "!standard" and "!shopflag" are NOT USED ANY WHERE ELSE in this PML METHOD
    -- and therefore are NOT REQUIRED at MDS12 <or MDS11.6>
    --!standard = !atta.styp
    --!shopflag = !!mdspar$!standard[$!bore].shop
    --<wd>mar2006<mds12>
    ---------------------------------------------------------------------------------------------------


    -- Compile a list of Valid Specifications from which, the RPAD ATTA material may selected
    do !foundspecs values !specs
      !!ce = !foundspecs
      !mem = mcount
      do !count from 1 to !mem
        $!count
        if !!ce.type.eq('SELE') then
          if !!ce.tans.eq('TUBE') then
            -- Find all spcoms for the tube selector
            var !spcoms coll all spcom for ce
            -- Loop through spcoms and get the correct bore
            do !getbore values !spcoms
              !!ce = !getbore.dbref()
              !params = para of catref
              -- Convert param 1 to nearest bore to take account of bores being
              -- set to actual bores and not nominal bores
              !nearestbore = !params[1].nearestbore()
              if !nearestbore.string().before('mm').eq(!bore.string().before('mm')) then
                !desc = rtext of detref
                handle (2,102)
                  -- handle (2,102) for SPCO for TUBE which has NO DETAIL REFERENCE SET in the PIPING SPEC
                  skip
                endhandle
                !matl = xtex of matxt
                handle any
                  !matl = ' '
                endhandle
                if !foundspecs.eq(!brspc) then
                  !dtext.append('(Parent Pipe)' + !foundspecs.name & ' ' & !desc & ' ' & !matl)
                  !rtext.append(!foundspecs.name)
                else
                  !dtext.append('             ' + !foundspecs.name & ' ' & !desc & ' ' & !matl)
                  !rtext.append(!foundspecs.name)
                endif
              endif
            enddo
          endif
        endif
        spec
      enddo
    enddo

    -- Save the RPAD !dtext and !rtext arrays from the Check shown immediately below
    !dtextsave = !dtext
    !rtextsave = !rtext
    !dtext.unique()
    !rtext.unique()

    -- Check if the dtext and rtext sizes are the same, if not then there are duplicate spec name in the
    -- current mdb, therefore reset back before they were made unique
    if !dtext.size().neq(!rtext.size()) then
      !dtext = !dtextsave
      !rtext = !rtextsave
    endif

    -- Load the Piping Specs into the Form RPAD Material Arrays
    !this.rpaddtext[!indx] = !dtext
    !this.rpadrtext[!indx] = !rtext
  enddo

  -- Navigate to Original Component
  !!ce = !origin

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endmethod

--------------------------------------------------------------------------------
define method .setrpadmtoref()
  --------------------------------------------------------------------------------

  -- The RPAD Atta MTOREF Material - is  SELECTED by the USER from the !!mdsNCMATNEW form
  -- Navigate to the Selected RPAD Atta and set the attribute MTOREF
  !!ce = !this.ancill.selection()[1].dbref()
  -- Get the RTEXT value of the Selected Spec for the selected Pipe LSTU or PLATE Material
  !selectedspec = !this.matref.selection()

  !!mdsdaccontrol(true)

  -- Set the MTOREF of the Selected RPAD ATTA in the MDS Support
  !mtoref = select spec $!selectedspec lstu
  -- Navigate back to the Atta - This command leaves you at the Selected Spec
  !!ce.mtoref = !mtoref

  -- Get the purpose of the Selected Spec
  var !mattyp  purpose of spec of $!mtoref[1]
  -- For MDS Standard 'AT65' ONLY - Set the DESPAR Num 8 i.e. Property 'ASSY' :-
  -- to either: 'A' for Pipe where DESPAR NUM 9 is ALWAYS set to ZERO '0'
  --        or: 'Bx' for Plate where 'x' is the Plate thickness, the same value as DESPAR NUM 1
  if (!!ce.prop.desc inset ('AT65')) then
    if (!mattyp.eq('PIPE')) then
      desp num 8 A
      !!ce.desp[9] = 0
    elseif (!mattyp.eq('PLAT')) then
      desp num 8 B
      !!ce.desp[9] = !!ce.desp[1]
    endif
  endif

  -- Navigate back to the Selected RPAD Atta
  !!ce = !this.ancill.selection()[1].dbref()

  !!mdsdaccontrol(false)

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------
-- End of Form Definition & Methods for - !!mdsancmat
--------------------------------------------------------------------
