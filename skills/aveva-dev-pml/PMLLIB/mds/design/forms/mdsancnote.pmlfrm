--
-- File:		mdsancnote.pmlfrm
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Martin Wright
-- Created:		Monday 14th January 2002
--
--
-- Description:
-- Form Definition for selecting the Text References on
-- MDS Pipe Ancillary supports (ATTAs) - UDA :Txtref
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ancill(form)                     -
--  apply()                          -
--  cancel()                         -
--  enhance()                        -
--  gettext()                        -
--  init(form)                       -
--  name(form)                       -
--  noteref()                        -
--  remove()                         -
--  select()                         -
--  unenhance()                      -
--

-- Kill existing form definition
  kill !!mdsancnote

-- Define form
  setup form !!mdsancnote

    !this.formtitle  = 'Notes'
    !this.cancelcall = '!this.cancel()'

-- Display Support Name
    paragraph .name at xmax+1 ymin text |!this.name()| width 60 lines 1

-- Selection Frame
    frame .selframe | Select | at x1 ymax

-- List of Ancillaries on the Support
      list .ancill |Member| at x1 ymax call |!this.select()| single width 25 length 10

-- List of Available Notes
      textpane .noteref |Note|   at xmax ymin - .2 width 40 length 12

-- Button to modify position

      button .Position |Modify Note Position...| at x1 ymax call |!!MdsSetNote(!This)|

-- Button to remove note

      button .remove |Remove Note| at xmax+4 ymin call |!This.remove()|

    exit

-- Apply Form
    button _apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|
-- Dismiss Form
    button .cancel | Dismiss | at xmax form-size ymin call |!this.cancel()| cancel


-- Exit form definition
  exit

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------
--
--------------------------------------------------------------------
define method .init(!form is form)
--------------------------------------------------------------------

  if (!form.support.atta.size().lt(1)) then
    !!alert.warning('Ancillaries have to exist to be able to set notes')
    return
  endif

  !this.name(!form)
  !this.ancill(!form)
  !this.noteref()

-- Show Form if Ancillary and Materials Exist
  !this.show()

-- Enhance the first element in the list.
  !this.select()

endmethod

--------------------------------------------------------------------
define method .name(!form is form)
--------------------------------------------------------------------

  !this.name.val = 'Support Name: ' & !form.name.val

endmethod

--------------------------------------------------------------------
define method .ancill(!form is form)
--------------------------------------------------------------------

  !ancill = !form.support.atta
--<kp>jan07
-- handle lighting support
  if !form.support.type.eq(!!Mdslsuppdefs.type) then
     !ancill.clear()
  endif

-- Go off and get all SCTN for owning STRU for the support frame.
-- if a stru exists
  if !Form.Support.Stru.Badref().not() then
    var !sctn coll all sctn for $!form.support.stru
    do !addsctn value !sctn
       !ancill.append(!addsctn.dbref())
    enddo
  endif

  !dtext  = array()
  !rtext  = array()

  do !atta values !ancill
    skip if (!atta.name.match('/SREF').gt(0))
    skip if (!atta.name.match('/MAKEUP').gt(0))
    skip if (!atta.name.match('/NOTE1').gt(0))
    skip if (!atta.name.match('/NOTE2').gt(0))
    skip if (!atta.name.match('/NOTE3').gt(0))
    !dtext.append(!atta.name)
  enddo

  !this.ancill.dtext = !dtext

endmethod

--------------------------------------------------------------------
define method .noteref()
--------------------------------------------------------------------

endmethod

--------------------------------------------------------------------
define method .gettext()
--------------------------------------------------------------------

   var !txt :MdsNote of $!this.ancill

 -- If note has double semi colon in then it is mutiple lines of text.
    !txtarray = !txt.split(';')

 -- Load array to textpane for selected ancillary.
    !this.noteref.val = !txtarray

endmethod

--------------------------------------------------------------------
define method .select()
--------------------------------------------------------------------

  !vals    = !this.ancill.val
  !sels    = !this.ancill.selection()

-- Unenhance ALL Ancillaries - whatever is being done
  !this.unenhance()

  if (!vals.unset()) then
-- No Ancillaries selected - so leave the display list unenhanced
    !this.setall.val = false
  else
-- Enhance ONLY the Selected Ancillary in RED
   enhance $!this.ancill colour red
-- If the note is set then highlight the position
    if !Sels.dbref().:MDSNote.neq('unset') then
      aid clear sphere 1000
        handle any
        endhandle
      if !sels.dbref().:MDSNotePos.up.string().eq('Unset') then
        !pos = !Sels.dbref().poss
          handle any
            !Pos = !Sels.dbref().pos
          endhandle
      else
        !pos = !Sels.dbref().:MDSNotePos
        if !pos.up.unset() then
          !pos = !sels.dbref().pos
        endif
      endif
      aid sphere num 1000 $!Pos diam 100mm
    else
      aid clear sphere 1000
        handle any
        endhandle
    endif
  endif

-- Clear and Grab the current note from the UDA :notref for the selected element.
   !this.gettext()

endmethod

--------------------------------------------------------------------
define method .unenhance()
--------------------------------------------------------------------

-- Unenhance ALL Ancillaries
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    unenhance $!indx
  enddo

-- Enhance ALL Ancillaries in the set Graphical Highlight Colour
  !this.enhance()

endmethod

--------------------------------------------------------------------
define method .enhance()
--------------------------------------------------------------------

-- Enhance ALL Ancillaries in the set Graphical Highlight Colour
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    enhance $!indx col $!!gphcolopt.highlight.code
  enddo

-- Enhance Support STRUCTURE if one Exists or Redoes the Single ATTA support
   !name = !this.name.val.after('Support Name: ').trim()
   if (!name.match('/').neq(1)) then
     !name = '/' & !name
   endif
   unenhance $!name
     handle any
     endhandle
   enhance $!name col $!!gphcolopt.highlight.code
     handle any
     endhandle
endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------

-- Set the Ancillary UDA :MDSNote
  !ancills = !this.ancill.selection()
  !note = !this.noteref.val
  !atta = !ancills.dbref()
  !txt = !note[1]


  if (!note.size() NE 1) then
    do !indx index !note
        skip if (!indx EQ 1)
        !txt = !txt & ';' & !note[!indx]
    enddo
  endif

-- Set the attribute on the current ancillary or frame element.
  !!MdsDacControl(true)
  !atta.:MDSNote = !txt

    handle (2,9)
-- Too many characters for the UDA.
      !!MdsDacControl(false)
      !!alert.error('Too many characters (max 120) to store on UDA :MDSNote')
      return
    elsehandle any
 -- Can only modify the note if we can write to it
      !!Alert.Error('Unable to modify the note text as write access is not available')
      return
    --endif????
    endHandle

-- Set the default position to start or position

  !!Ce = !Atta

-- If the note position uda has already been set then do not reset it

  -- if !!CE.:MDSNotePos.up.unset() then

    -- !NotePos = Poss wrt /*
      -- handle any
        -- !NotePos = Pos wrt /*
      -- endhandle

    -- :MDSNotePos $!NotePos
  -- endif

  same

  !!MdsDacControl(false)

-- Unenhance and Return to the Set Highlight Colour
  !this.select()

endmethod

--------------------------------------------------------------------
define method .cancel()
--------------------------------------------------------------------

-- Unenhance ALL Ancillaries and Return to the Set Highlight Colour
  !this.unenhance()

  aid clear sphere 1000
    handle any
    endhandle

-- If the edg has been used for the note position close the form

  !!Note3dExplicit.close()

endmethod

--------------------------------------------------------------------
define method .remove()
--------------------------------------------------------------------

-- Move to ancill

  !!ce = !this.ancill.selection().dbref()

  if !!CE.:MDSNote.eq('unset') then
    !!Alert.Error('No note to remove!')
    return
  endif

  if !!Alert.Confirm('Are you sure you want to remove the note from ' + !This.ancill.selection()).eq('YES') then
    !!MdsDacControl(true)
    :MDSNote 'unset'
    :MDSNotePos def
    !!MdsDacControl(false)
    aid clear sphere 1000
      handle any
      endhandle
  endif

  same

  !This.select()

endmethod

--------------------------------------------------------------------
-- End of Form Definition - !!mdsancnote
--------------------------------------------------------------------
