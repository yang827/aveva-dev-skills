-- Created:             Thursday 29th November 2001
--
--
-- Description:
-- Form Definition for the  Ancillary Nudge facility
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  enhance(DBREF)                   -
--  finish(ARRAY,FORM)               -
--  getce(FORM)                      ARRAY
--  init(FORM)                       -
--  move(ARRAY,STRING)               -
--  pick(FORM)                       ARRAY
--  reset()                          -
--  select(FORM)                     -
--  selectce(FORM)                   -
--  thro()                           -
--  unenhance(DBREF)                 -
--

-- Kill existing form definition
kill !!mdsancnudge

-- Define Form
setup form !!mdsancnudge
  !!mdsancnudge.formtitle    = |Nudge Ancillaries|
  !!mdsancnudge.icontitle    = ||
  !!mdsancnudge.callback     = ||
  !!mdsancnudge.formrevision = | $Revision: 1.1.19.1 $ |

  -- Pick Ancillaries button
  button .choose | Pick |  at x0 ymax+0.2 tooltip 'Select Ancillaries' call |!this.select(!this.form)|
  path right
  button .ce | CE |  at x9 call |!this.selectce(!this.form)|
  path down

  -- Movement Gadgets
  frame .frame  || at x0 ymax
    text .distance at x1 ymax+0.25 |Distance | width 14 is REAL format !!distancefmt
    button .plus   at xmax+1.5 ymin tooltip 'Nudge Forwards'  pixmap height 16 width 16
    button .minus  at xmax+0.5 ymin tooltip 'Nudge Backwards' pixmap height 16 width 16
    button .thro   | Through | at x1 ymax+0.5 tooltip 'Plane Selected Ancillaries Through Identified Elements' call |!this.thro()|
    button .reset   | Reset | at xmax+1 ymin tooltip 'Reset to Default Position' call |!this.reset()|
  exit

  -- Dismis BUTTON
  button .cancel | Dismiss | at xmax form-size ymax form+0.5 call |!this.finish(!this.attas, !this.form)| cancel

  -- Members
  member .form is FORM
  member .attas is ARRAY

exit

!formobj = !this
!formobj.plus.addpixmap(!!pml.getpathname('leftarrow9x12.png'))
!formobj.minus.addpixmap(!!pml.getpathname('rightarrow9x12.png'))

-- End of form definition mdsancnudge.pmlfrm

----------------------------------------------------------------------
define method .init(!form is FORM)
  ----------------------------------------------------------------------

  -- Check that Datum atta has been created
  !datum = !form.support.datum
  if (!datum.set().not()) then
    !!alert.message('Datum support atta has not created')
    return
  endif

  -- Check that Datum atta has been positioned
  if (!form.support.position.not())then
    !!alert.message('Cannot nudge ancillary as the Datum support atta has not been positioned')
    return
  endif

  -- Initialise Variables
  !this.form = !form
  !this.distance.val = 0

  -- Set the '<' Forwards and '>' Backwards icons to use the correct form
  !this.plus.callback  = |!this.move(!this.attas, 'plus')|
  !this.minus.callback = |!this.move(!this.attas, 'minus')|

  -- Clear the previous list of attas if any
  !this.attas.clear()

  --Show Form
  !this.show()

endmethod

----------------------------------------------------------------------
define method .select(!form is FORM)
  ----------------------------------------------------------------------

  -- Pick Ancillaries to Nudge and Enhance in RED
  !attas = !this.pick(!form)
  if (!attas.empty()) then
    return
  endif
  !this.attas = !attas

endmethod

----------------------------------------------------------------------
define method .pick(!form is FORM) is ARRAY
  ----------------------------------------------------------------------

  -- Initialise and Empty Variables
  !support = !form.support

  -- Check if Support is a MDS Framework or Ancillary Standard
  if (!support.stru.set()) then
    !name = !support.stru.name
  else
    !name = !support.datum.name
  endif

  if (undefined(!attas)) then
    !attas   = ARRAY()
  else
    !attas.clear()
  endif
  if (!this.attas.empty().not()) then
    do !vala values !this.attas
      !this.unenhance(!vala)
    enddo
    !this.attas.clear()
  endif

  -- Pick Ancillaries to Nudge and Enhance in RED
  do
    prompt off
    prompt load escape |Identify ancillary to nudge...|
    id atta @
    handle (61,528)
      if (!attas.empty()) then
        prompt dismiss
        prompt on
        return !attas
      else
        break
      endif
    endhandle
    prompt dismiss
    prompt on

    -- Check to see if the identified atta is part of the current support
    !pick = !!ce
    if !!mdsCheckTrun(!this,'CE') then
      !!alert.message('The selected ancillary cannot be nudged it is on a trunnion')
      skip
    endif
    if (!support.atta.findfirst(!pick).set().not())then
      !!alert.message('The selected ancillary does not belong to this support')
    elseif (!attas.find(!pick).size().gt(0)) then
      !this.unenhance(!pick)
      !real = !attas.find(!pick)
      !attas.remove(!real[1])
    $( !list does not exist so this test is invalid
      -- Check the SREF atta as if the DATUM atta has been selected,
    elseif (!pick.name.eq(!name & '/SREF')) then
      !pick = !support.datum
      if (!list.find(!pick).size().gt(0))then
        !this unenhance(!pick)
        !attas.remove(!attas.find(!pick))
      endif
    $)
    else
      -- Check to see if you can copy the identified ancillary
      if !!mdsComClaimDac(!!ce,'DACMOD','POS').not() then
        prompt dismiss
        prompt on
        !!alert.error(!!error.text)
        skip
      endif
      !attas.append(!pick)
      !this.enhance(!pick)
    endif
  enddo

  -- Remove any Empty/Unset Indices
  !attas.compress()

  -- Return Array of the Selected Ancillaries
  return !attas

endmethod

----------------------------------------------------------------------
-- Added method for CE button HPD0031130 GE 10/04/05
define method .selectce(!form is FORM)
  ----------------------------------------------------------------------

  -- Pick Ancillaries to Nudge and Enhance in RED
  !attas = !this.getce(!form)
  if (!attas.empty()) then
    return
  endif
  !this.attas = !attas

endmethod


----------------------------------------------------------------------
-- Added method for CE button HPD0031130 GE 10/04/05
define method .getce(!form is FORM) is ARRAY
  ----------------------------------------------------------------------

  -- Initialise and Empty Variables
  !support = !form.support

  -- Check if Support is a MDS Framework or Ancillary Standard
  if (!support.stru.set()) then
    !name = !support.stru.name
  else
    !name = !support.datum.name
  endif

  if (undefined(!attas)) then
    !attas   = ARRAY()
  else
    !attas.clear()
  endif

  unenhance all

  -- Check to see if the identified atta is part of the current support and a valid atta
  !pick = !!ce

  if !pick.type.neq('ATTA') then
    unenhance all
    !!alert.error('The Current Element must be an Ancillary')
    !attas.clear()
    return !attas
  endif

  if (matchwild (!pick.spref.name,'/MDS/*')) or (matchwild (!pick.spref.name,'/MDF/*')) or (matchwild (!pick.spref.name,'/MDP/*')) then
    if !!mdsCheckTrun(!this,'CE') then
      !!alert.message('The selected ancillary cannot be nudged it is on a trunnion')
      !attas.clear()
      return !attas
    endif
    if (!support.atta.findfirst(!pick).set().not())then
      !!alert.message('The selected ancillary does not belong to this support')
      !attas.clear()
      return !attas
      -- Check the SREF atta as if the DATUM atta has been selected,
    elseif (!pick.name.eq(!name & '/SREF')) then
      !pick = !support.datum
    else
      -- Check to see if you can copy the identified ancillary
      if !!mdsComClaimDac(!!ce,'DACMOD','POS').not() then
        !!alert.error(!!error.text)
        !attas.clear()
        return !attas
      endif
      !attas.append(!pick)
      !this.enhance(!pick)
    endif

    -- Return Array of the Selected Ancillary
    return !attas

  else
    unenhance all
    !!alert.error('The Current Element must be an Ancillary')
    !attas.clear()
    return !attas
  endif

endmethod

--------------------------------------------------------------------
define method .unenhance(!pick is DBREF)
  --------------------------------------------------------------------

  -- Unenhance Ancillary
  unenhance $!pick
  refresh

  -- Re-Enhance Ancillary in the set Graphical Highlight Colour
  enhance $!pick col $!!gphcolopt.highlight.code
  refresh

endmethod

--------------------------------------------------------------------
define method .enhance(!pick is DBREF)
  --------------------------------------------------------------------

  -- Enhance Ancillary in the Colour RED
  unenhance $!pick
  refresh
  enhance $!pick col 2
  refresh

endmethod

--------------------------------------------------------------------
define method .move(!attas is ARRAY, !sign is STRING)
  --------------------------------------------------------------------

  -- Find out if user has selected any attas

  if !attas.size().eq(0) then
    !!alert.error('No elements have been identified to nudge. Please use the pick button to identify the elements to move')
    return
  endif

  -- Get Nudge Distance and PLeave Direction of Datum Atta WRT /*
  if !!mdsCheckTrun(!this.form,'DATUM') then
    !pldir = !this.form.support.stru.:MdsFrameDir
    !dist  = !this.distance.val
  else
    !pldir = !this.form.support.pldir
    !dist  = !this.distance.val
  endif

  --Set the Direction - Forwards or Backwards along Datum's Pipe
  if (!sign.eq('plus')) then
    -- !mark = ''
    if !dist.string().match('-').eq(1) then
      !mark = ''
    else
      !mark = ''
    endif
  elseif (!sign.eq('minus')) then
    if !dist.string().match('-').eq(1) then
      !mark = ''
      !dist = !dist.string().after('-').real()
    else
      !mark = '-'
    endif
  endif
  !!mdsDacControl(true)
  -- Move the Selected Ancillaries the Set Distance
  do !val values !attas
    !!ce   = !val
    if (!!ce.name.match('/DATUM').gt(0)) then
      !currdistval = !this.form.dist.val
    endif
    !xdist = :mdsnudgedist
    -- move $!pldir dist $!<mark>$!dist
    move pl dist $!<mark>$!dist
    !!ce.:mdsnudgedist = $!<mark>$!dist + $!xdist

    --  Move the associated SREF with the DATUM Atta
    if (!!ce.name.match('/DATUM').gt(0)) then
      !sref  = !!ce.name.before('/DATUM') & '/SREF'
      !!ce   = !sref.dbref()
      !xdist = :mdsnudgedist
      move $!pldir dist $!<mark>$!dist
      !!ce.:mdsnudgedist = $!<mark>$!dist + $!xdist
      !!ce = !val
    endif

    -- Update Form Distance Gadget for the Datum Atta Only
    if (!!ce.name.match('/DATUM').gt(0)) then
      !newdistval = !currdistval + $!<mark>$!dist
      !this.form.dist.val = !newdistval
    endif

    -- Move any Associated Guide Reference
    -- Asking the user first

    if (!!ce.:MDSGuideRef.badref().not()) then
      if !!alert.confirm('Do you want to move the associated support as well?').eq('YES') then
        !!ce = !!ce.:MDSGuideRef
        move $!pldir dist $!<mark>$!dist
        !!ce.:mdsnudgedist = $!<mark>$!dist + $!xdist
        !!ce = !val
      endif
    endif

    -- Update the Graphical Aid Text
    !apos = ppos9 wrt world
    if (!!ce.name.match('/DATUM').gt(0)) then
      !aname = 'Datum'
      var !anum (210)
    else
      if (!!ce.name.match('.').eq(0)) then
        !aname = 'Datum'
        var !anum (210)
      else
        !aname = after(!!ce.name, '.')
        var !anum (210 + $!aname)
      endif
    endif
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!anum $!aname $<$!apos$>
  enddo
  !!mdsDacControl(false)
  -- On supports that are attas only reset the distance gadget
  !!ce = !this.form.support.datum
  if !!ce.name.match('/DATUM').eq(0) then
    !formString = !this.form.string()
    !!mdsDistance(!!$!formString)
  endif


  -- ReOrder All of the Attas on Every Branch on the current MDS Support
  !reorder = object MDSCHECKDATUM()
  !reorder.branchattas(!this.form)

  -- Enhance All of the Attas on the Support
  !this.finish(!this.form.support.atta, !this.form)

  -- Enhance Ancillary in RED
  do !indx values !attas
    unenhance $!indx
    enhance $!indx col 2
    --refresh
  enddo

  -- Navigate to Branch of Datum Atta
  if !attas.size().gt(1) then
    !!ce = !this.form.support.datum.owner
  else
    !!ce = !this.form.support.datum
  endif

  -- adjust the weld position for framatome beams
  if !this.form.eq(!!mdsspecial) then
    !!mdsSpecialAdjust(!this.form)
  else
    !!mdsWeldAdjust(!this.form)
  endif

endmethod

--------------------------------------------------------------------
define method .finish(!attas is ARRAY, !form is FORM)
  --------------------------------------------------------------------

  -- Unenhance Ancillary in RED
  do !indx values !form.support.atta
    unenhance $!indx
    refresh
  enddo

  -- Enhance Ancillary in the set Graphical Highlight Colour
  do !indx values !form.support.atta
    enhance $!indx col $!!gphcolopt.highlight.code
    refresh
  enddo

  -- Enhance Support STRUCTURE if one Exists or Redoes the Single ATTA support
  !name = !this.form.name.val
  if (!name.match('/').neq(1)) then
    !name = '/' & !name
  endif

  unenhance $!name
  refresh
  enhance $!name col $!!gphcolopt.highlight.code
  refresh

endmethod
--------------------------------------------------------------------

--------------------------------------------------------------------
define method .thro()
  --------------------------------------------------------------------

  -- Find out if user has selected any attas

  if !this.attas.size().eq(0) then
    !!alert.error('No elements have been identified to nudge. Please use the pick button to identify the elements to move thro an identified element')
    return
  endif

  -- Get Move Direction

  if !!mdsCheckTrun(!this.form,'DATUM') then
    !pldir = !this.form.support.stru.:MdsFrameDir
  else
    !pldir = !this.form.support.pldir
  endif

  -- Identify the element to move thro

  Prompt off
  prompt load escape |Identify element to move selected attas through...|
  id @
  handle (61,528)
    prompt dismiss
    prompt on
    return
  endhandle
  prompt dismiss
  prompt on

  !identifiedElement = !!ce

  !!mdsDacControl(TRUE)

  do !moveAttas values !this.attas
    !!ce = !moveAttas
    plane $!pldir thro $!identifiedElement
    -- Need to set the :MdsNudgeDist value now it has moved
    -- Get pl of ce
    pin 1 copy pl
    pin 2 copy pl
    pin 1 plane pin 1 thro $!this.form.support.stru
    pin 2 plane pin 2 thro ce
    pin 1 dir from pin 1 to pin 2
    --q pin 1 dir
    --q pin 2 dir
    var !pin1dir pin 1 dir
    var !pin2dir pin 2 dir
    if !pin1dir.direction().angle(!pin2dir.direction()).gt(0) then
      !sign = '-'
    else
      !sign = ''
    endif
    var !dist const dist pin 1 to pin 2
    :MdsNudgeDist $!sign$!dist

    --  Move the associated SREF with the DATUM Atta
    if (!!ce.name.match('/DATUM').gt(0)) then
      !sref  = !!ce.name.before('/DATUM') & '/SREF'
      !!ce   = !sref.dbref()
      plane $!pldir thro $!identifiedElement
      :mdsnudgedist $!sign$!dist
    endif

    !!ce = !moveAttas
    -- Move any Associated Guide Reference
    if (!!ce.:MDSGuideRef.badref().not()) then
      !!ce = !!ce.:MDSGuideRef
      plane $!pldir thro $!identifiedElement
      :mdsnudgedist $!sign$!dist
    endif

    -- Update the Graphical Aid Text
    !apos = ppos9 wrt world
    if (!!ce.name.match('/DATUM').gt(0)) then
      !aname = 'Datum'
      var !anum (210)
    else
      if (!!ce.name.match('.').eq(0)) then
        !aname = 'Datum'
        var !anum (210)
      else
        !aname = after(!!ce.name, '.')
        var !anum (210 + $!aname)
      endif
    endif
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!anum $!aname $<$!apos$>

  enddo

  !!mdsDacControl(FALSE)

  -- On supports that are attas only reset the distance gadget
  !!ce = !this.form.support.datum
  if !!ce.name.match('/DATUM').eq(0) then
    !formString = !this.form.string()
    !!mdsDistance(!!$!formString)
  endif


  -- ReOrder All of the Attas on Every Branch on the current MDS Support
  !reorder = object MDSCHECKDATUM()
  !reorder.branchattas(!this.form)

  -- Enhance All of the Attas on the Support
  !this.finish(!this.form.support.atta, !this.form)

  -- Enhance Ancillary in RED
  do !indx values !this.attas
    unenhance $!indx
    enhance $!indx col 2
    --refresh
  enddo

  -- Navigate to Branch of Datum Atta
  if !this.attas.size().gt(1) then
    !!ce = !this.form.support.datum.owner
  else
    !!ce = !this.form.support.datum
  endif

endmethod

--------------------------------------------------------------------
define method .reset()
  --------------------------------------------------------------------

  -- Find out if user has selected any attas

  if !this.attas.size().eq(0) then
    !!alert.error('No elements have been identified to nudge. Please use the pick button to identify the elements to move thro an identified element')
    return
  endif

  if !!alert.confirm('Are you sure you want to reset the selected elements to their default position?').eq('NO') then
    return
  endif

  -- Get Move Direction

  if !!mdsCheckTrun(!this.form,'DATUM') then
    !pldir = !this.form.support.stru.:MdsFrameDir
  else
    !pldir = !this.form.support.pldir
  endif

  !!mdsDacControl(TRUE)

  do !moveAttas values !this.attas
    !!ce = !moveAttas
    plane $!pldir thro $!this.form.support.stru
    --<GE> 01/02/07 Defect No: 10182
    handle (47,15)
      !dist = :mdsnudgedist
      move $!pldir dist -$!dist
    endhandle
    --<GE> 01/02/07
    :MdsNudgeDist 0

    --  Move the associated SREF with the DATUM Atta
    if (!!ce.name.match('/DATUM').gt(0)) then
      !sref  = !!ce.name.before('/DATUM') & '/SREF'
      !!ce   = !sref.dbref()
      plane $!pldir thro $!this.form.support.stru
      :mdsnudgedist 0
    endif

    !!ce = !moveAttas
    -- Move any Associated Guide Reference
    if (!!ce.:MDSGuideRef.badref().not()) then
      !nudgeDistVal = :MdsNudgeDist
      !!ce = !!ce.:MDSGuideRef
      plane $!pldir thro same
      :mdsnudgedist $!nudgeDistVal
    endif

    -- Update the Graphical Aid Text
    !apos = ppos9 wrt world
    if (!!ce.name.match('/DATUM').gt(0)) then
      !aname = 'Datum'
      var !anum (210)
    else
      if (!!ce.name.match('.').eq(0)) then
        !aname = 'Datum'
        var !anum (210)
      else
        !aname = after(!!ce.name, '.')
        var !anum (210 + $!aname)
      endif
    endif
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!anum $!aname $<$!apos$>

  enddo

  !!mdsDacControl(FALSE)

  -- On supports that are attas only reset the distance gadget
  !!ce = !this.form.support.datum
  if !!ce.name.match('/DATUM').eq(0) then
    !formString = !this.form.string()
    !!mdsDistance(!!$!formString)
  endif


  -- ReOrder All of the Attas on Every Branch on the current MDS Support
  !reorder = object MDSCHECKDATUM()
  !reorder.branchattas(!this.form)

  -- Enhance All of the Attas on the Support
  !this.finish(!this.form.support.atta, !this.form)

  -- Enhance Ancillary in RED
  do !indx values !this.attas
    unenhance $!indx
    enhance $!indx col 2
    --refresh
  enddo

  -- Navigate to Branch of Datum Atta
  if !this.attas.size().gt(1) then
    !!ce = !this.form.support.datum.owner
  else
    !!ce = !this.form.support.datum
  endif

endmethod
