-- Description:
-- Form Definition for a command line form with added functionality
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!MdsBth

--------------------------------------------------------------------------------
-- Define Form
  setup form  !!MdsBth resize

    title 'MDS Developers Command Input and Output'

    view .Alpha alpha
      channel requests
      channel commands
    exit

    menu .AlphaPopUpMenu
      !This.AlphaPopUpMenu.add('CALLBACK','Clear','Alpha Requests Clear')
      !This.AlphaPopUpMenu.add('TOGGLE','Tracing','!This.Tracing(')
      !This.AlphaPopUpMenu.add('CALLBACK','Get Error','!This.GetError(')

    !This.Alpha.SetPopup(!This.AlphaPopUpMenu)


  exit

  define method .Tracing(!menu is menu, !Action is string)

    $R
    $R
    $R
    $R
    $R
    $R

    if !Action.eq('SELECT') then
      $R
      $R
      $R
      $R
      $R
      $R
      $R
      $R110
    else
      $R
      $R
      $R
      $R
      $R
      $R
      $R
    endif

    alpha req clear

  endmethod

  define method .GetError(!menu is menu, !Action is string)

    !Function = !!Error.line.after('function ').before('.')
    !line = !!Error.line.after('In line ').before(' ')

    $p $!Function $!Line

    !Path = !!PML.GetPathName('$!Function$n.pmlfnc')
      handle any
        !Path = !!PML.GetPathName('$!Function$n.pmlfrm')
      endhandle

    syscom 'C:\tools\vi\winvi32.exe $!Path &'
    -- syscom 'pmledit /l $!line $!Path &'

  endmethod

-- End form definition

-- End of file mdsbth.frm
