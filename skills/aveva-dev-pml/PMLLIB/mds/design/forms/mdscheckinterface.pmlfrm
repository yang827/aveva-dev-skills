--
-- File:    mdscheckinterface.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    R.Martin
-- Created:   01/2012
--
-- Description:
-- displays any errors in the setup of the current manufacturers hanger interface as generated by function !!mdscheckinterface.pmlfnc
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initmessages(STRING,ARRAY)       -                   write the error messages that have been returned from the mdsCheckInterface function to the grid control on the form
--  netPopupMainCallback(ARRAY)      -                   Popup callback
--  output()                         -                   output the messages from the grid control to an excel spreadsheet stored in pdmsuser
--

-- Kill existing form definition
kill !!mdscheckinterface

import 'GridControl'
handle any
endhandle

-- Define Form
setup form !!mdscheckinterface dialog dock size 160 15

  !this.formtitle    = |MDS Hangers Manufacturers Interface Check|
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = | $Revision: 1.0 $ |

  using namespace 'Aveva.Pdms.Presentation'

  para .label anchor L+T at x1 y0.5 text || height 2 width 50

  frame .errorListFrame |Interface Setup Errors| anchor L+T+R at xmin.label ymax.label+0.1 width 159 height 12.5
    -- PML Container to host .Net control
    container .netErrorlistFrame nobox PMLNETCONTROL |errorlist| dock fill
  exit

  menu .popmenumain
  !this.popmenumain.add( 'CALLBACK', 'Save List to Excel', '!this.output()' )

  -- .Net grid controls
  member .errorListGrid      is NETGRIDCONTROL

exit

define method .initmessages(!interface is STRING, !errorList is ARRAY)

  using namespace 'Aveva.Pdms.Presentation'

  -- Add instances of .Net control
  !this.errorListGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netErrorlistFrame.control = !this.errorListGrid.handle()

  -- Set errorlist grid parameters
  !this.errorListGrid.columnExcelFilter(FALSE)
  !this.errorListGrid.outlookGroupStyle(FALSE)
  !this.errorListGrid.fixedHeaders(FALSE)
  !this.errorListGrid.fixedRows(FALSE)
  !this.errorListGrid.gridHeight(1000.0)
  !this.errorListGrid.columnSummaries(FALSE)

  !text = 'Problems have been detected with your ' + !interface + 'Interface setup.                           Please contact your administrator quoting the following:'
  !this.label.val = !text

  -- Set headings
  !title = '$!interface configuration errors'
  !headings    = ARRAY()
  !headings[1] = 'Configuration Area'
  !headings[2] = 'Error Description'
  !headings[3] = 'Setup Notes'

  -- Populate drawlist with standard TOOLTIP text (name, type & description)
  !nds = object NETDATASOURCE(!title, !headings, !errorList)
  !this.errorListGrid.bindToDataSource(!nds)
  !this.errorListGrid.addEventHandler('OnPopup', !this, 'netPopupMainCallback')

endmethod

define method .output()

  var !pdmsuser evar pdmsuser
  if !pdmsuser.eq('') then
    !!alert.error('The PDMSUSER environment variable is not set, cannot save to this location')
    return
  else
    !testFile = object FILE(!pdmsuser)
    if !testFile.exists().not() then
      !!alert.error('The PDMSUSER folder $!testFile cannot be found, cannot save to this location')
      return
    endif
  endif

  !fileName = !pdmsuser + '\mdsHangerInterfaceErrors.xls'
  !this.errorListGrid.saveGridToExcel(!fileName)
  !!alert.message('Output of the above error conditions has been stored in $!fileName')

endmethod

------------------------------------------------------------------------
--
-- Method:  netPopupMainCallback
--
-- Description: Popup callback
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupMainCallback(!a is ARRAY)

  !this.netErrorlistFrame.popup = !this.popmenumain
  !this.netErrorlistFrame.showPopup(!a[0], !a[1])

endmethod
