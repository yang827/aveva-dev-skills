--
-- File:		MdsClampMatl.pmlfrm
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 20th November 2001
--
--
-- Description:
-- Form Definition for selecting the Material Reference on
-- a hanger pipe clamp
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ancill(form)                     -
--  apply()                          -
--  cancel()                         -
--  enhance()                        -
--  init(form)                       -
--  matref()                         -
--  name(form)                       -
--  select()                         -
--  selmat()                         -
--  setall()                         -
--  unenhance()                      -
--

-- Kill existing form definition
  kill !!MdsClampMatl

-- Define form
  setup form !!MdsClampMatl

    !this.formtitle  = 'Set Pipe Clamp Material'
    !this.cancelcall = '!this.cancel()'

-- Display Support Name
    paragraph .name at xmax+1 ymin text |!this.name()| width 30 lines 1

    path down

    frame .selframe | Select | at x1 ymax

-- List of Ancillaries on the Support
      list .ancill |Pipe Clamps| at x1 ymax call |!this.select()| multi width 25 length 10

-- List of Available Materials
      list .matref |Materials|   at xmax ymin width 40 length 10

--  Set Material to all ancillaries on the Support
      toggle .setall |Select All Ancillaries | at x1 ymax call |!this.setall()|

    exit

-- Apply Form
    button _apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|
-- Dismiss Form
    button .cancel | Dismiss | at xmax form-size ymin call |!this.cancel()| cancel

-- Exit form definition


  exit

--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
define method .init(!form is form)
--------------------------------------------------------------------

-- Do any pipe clamps exist

  if (!form.support.atta.size().lt(1)) then
    !!alert.warning('Hanger has to exist to be able to set the material of the pipe clamp/s')
    return
  endif

-- Set the name of the hanger

  !this.name(!Form)

  -- !this.name.val = !form.name.val

-- Find and load the pipe clamps

  !!ce = /$!form.name.val
  goto cref
  rest
  var !coll coll all pcla for ce

  if !Coll.size().eq(0) then
    !!Alert.Error('Cannot find a pipe clamp to set the material')
    return
  else
    !Dtext = ARRAY()
    !Rtext = ARRAY()
    do !Loop values !Coll
      !!ce = !Loop.dbref()
      !Name = name
      if !name.match('/').eq(1) then
        !Dtext.append(!!ce.name)
        !Rtext.append(!!ce.ref.string())
      else
        !Dtext.append(!!ce.name.before(' of'))
        !Rtext.append(!!ce.ref.string())
      endif
    enddo
    !this.Ancill.dtext = !Dtext
    !this.Ancill.rtext = !Rtext
  endif

  !this.matref()
  !this.setall.val = false
  !this.setall()

-- Show Form if Ancillary and Materials Exist
  !this.show()

endmethod

--------------------------------------------------------------------
define method .name(!form is form)
--------------------------------------------------------------------

  !this.name.val = 'Support Name: ' & !form.name.val

endmethod

--------------------------------------------------------------------
define method .ancill(!form is form)
--------------------------------------------------------------------

  !ancill = !form.support.atta
  !dtext  = array()
  !rtext  = array()

  !orig = !!ce

  do !atta values !ancill
    skip if (!atta.name.match('/SREF').gt(0))
--<wd>feb2003
-- Added for Trunnion TT23 Ancillary Plate and Isolation Block Materials
    skip if (!atta.name.match('/SREF').gt(0))
    skip if (!atta.name.matchwild('*/NOTE*'))
    skip if (!atta.name.match('/MAKEUP').gt(0))
--<wd>feb2003
    !!ce = !atta
------------------------------------------------------------------------------
-- mjb >>> 05.05.06 <mds12>
  !mdsattaobj  = object mdsreadparsdata()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!atta.lbor.real())

  !chkmat = object mdscheckstd(!mdsattaobj)
  --!chkmat   = object Mdscheckstd()
-- mjb <<< 05.05.06 end of mod
------------------------------------------------------------------------------
    skip if (!chkmat.modmaterial().not())
    !dtext.append(!atta.name)
  enddo

  !this.ancill.dtext = !dtext.unique()
  !!ce = !orig

endmethod

--------------------------------------------------------------------
define method .matref()
--------------------------------------------------------------------

-- Initialise variable
  !matexist = false
  !dtext = array()
  --!dtext.append(' unset')
  !rtext = array()
  --!rtext.append(' default')

-- Get all the Materials available in the Propcon Database
  -- !sden = !!kcollectallfor('SDEN', 'sref of owner eq |STD| and pres eq -100000 and temp eq -100000 and pqual of owner eq |MDS|', =0/0)

  !sden = ARRAY()
  var !ProjCode proj code
  !filename = '%$!ProjCode$ndflts%/DES-SUPP-PCLA'
  !Lines = !!ReadPdmsFile('/$!Filename')
  do !Setref values !Lines
    !!ce = !Setref.dbref()
      handle ANY
        skip
      endhandle
    1
      handle ANY
        skip
      endhandle
    1
      handle ANY
        skip
      endhandle
    !Sden.append(!!ce)
  enddo

  if (defined(!sden) or !sden.size().neq(0)) then
    !bsoli = object block('!sden[!evalindex].owner.owner')
    !solid = !sden.evaluate(!bsoli)

    !bdesc = object block('!sden[!evalindex].owner.owner.description')
    !descr = !sden.evaluate(!bdesc)

    !bdens = object block('!sden[!evalindex].density')
    !dens  = !sden.evaluate(!bdens)

    !altdesc = object block ('!sden[!evalindex].owner.owner.:MDSMatDesc')
    !altd    = !sden.evaluate(!altdesc)

    !matexist = true
  endif

  -- Load the available materials from the DES-SUPP-PCLA file

  !this.matref.dtext = !lines
  !this.matref.rtext = !lines


-- Load the list with the available materials
  if (!matexist) then

    !dsiz  = (!dens.width() + 15)
    !order = !descr.sortedindices()

    do !indx values !order
      !denx = !dens[!indx].string('d2')
      if !descr[$!indx].neq('') then
        !csiz  = !descr.width()
        var !dprt compose space 1 |$!descr[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      else
        !csiz  = !altd.width()
        var !dprt compose space 1 |$!altd[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      endif
      !dtext.append(!dprt[1])
      !rtext.append(!solid[!indx].string())
    enddo

    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext
  endif

endmethod

--------------------------------------------------------------------
define method .setall()
--------------------------------------------------------------------

  if (!this.setall.val) then
    !ancill =!this.ancill.dtext
    do !count indices !ancill
      !this.ancill.select('dtext', !this.ancill.dtext[!count])
    enddo
  else
    !this.ancill.clearselection()
    !this.ancill.select('dtext', !this.ancill.dtext[1])
  endif

-- Enhance Graphically the selected Ancillaries
  !this.select()

endmethod

--------------------------------------------------------------------
define method .select()
--------------------------------------------------------------------

  !vals = !this.ancill.val
  !sels = !this.ancill.selection()

-- Unenhance ALL Ancillaries - whatever is being done
  !this.unenhance()

  if (!vals.unset()) then
-- No Ancillaries selected - so leave the display list unenhanced
    !this.setall.val = false
  else
-- Enhance ONLY the Selected Ancillaries in RED
    do !indx values !sels
      enhance $!indx col 2
    enddo
    if (!vals.size().eq(!this.ancill.dtext.size())) then
      !this.setall.val = true
    else
      !this.setall.val = false
    endif
  endif

-- Select the Material of the First Selected in the List
  !this.selmat()

endmethod

--------------------------------------------------------------------
define method .selmat()
--------------------------------------------------------------------

-- Select the Ancillary Material if SET and it Exists in the List
  !vals = !this.ancill.val
  !sels = !this.ancill.selection()
  !last = !this.ancill.pickedfield
  if (!vals.unset()) then
    !this.matref.clearselection()
  elseif (!vals.size().eq(1)) then
    !valx = !this.ancill.val
    !valu = !valx[1]
    !atta = !this.ancill.dtext[!valu].dbref()
-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
-- The variable !MatrefAtt will be set to either REF for matref or UDA for :MdsMatref

    !MatrefAtt = !!MdsUseMatref(!atta)

    if !MatrefAtt.eq('UDA') then
      if (!atta.:MDSMatRef.set()) then
        !this.matref.select('rtext', !atta.:MDSMatRef.string())
          handle ANY
          endhandle
      else
        !this.matref.clearselection()
      endif
    else
      if (!atta.MatRef.set()) then
        !this.matref.select('rtext', !atta.MatRef.string())
          handle ANY
          endhandle
      else
        !this.matref.clearselection()
      endif
    endif
  else
    if (!last.neq(0)) then
      !atta = !this.ancill.dtext[!last].dbref()
    else
      !atta = !this.ancill.dtext[1].dbref()
    endif
    !MatrefAtt = !!MdsUseMatref(!atta)
    if !MatrefAtt.eq('UDA') then
      if (!atta.:MDSMatRef.set()) then
       !this.matref.select('rtext', !atta.:MDSMatRef.string())
      else
       !this.matref.clearselection()
      endif
    else
      if (!atta.MatRef.set()) then
       !this.matref.select('rtext', !atta.MatRef.string())
      else
       !this.matref.clearselection()
      endif
    endif
  endif

endmethod

--------------------------------------------------------------------
define method .unenhance()
--------------------------------------------------------------------

-- Unenhance ALL Ancillaries
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    unenhance $!indx
  enddo

-- Enhance ALL Ancillaries in the set Graphical Highlight Colour
  !this.enhance()

endmethod

--------------------------------------------------------------------
define method .enhance()
--------------------------------------------------------------------

-- Enhance ALL Ancillaries in the set Graphical Highlight Colour
  !ancills = !this.ancill.dtext
  do !indx values !ancills
    enhance $!indx col $!!gphcolopt.highlight.code
  enddo

-- Enhance Support STRUCTURE if one Exists or Redoes the Single ATTA support
   !name = !this.name.val.after('Support Name: ').trim()
   if (!name.match('/').neq(1)) then
     !name = '/' & !name
   endif
   unenhance $!name
   enhance $!name col $!!gphcolopt.highlight.code
endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------

-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
-- The variable !MatrefAtt will be set to either REF for matref or UDA for :MdsMatref

  !ancills = !this.ancill.selection()
  !matr = !this.matref.selection().dbref()
  handle (2,813)
-- (2,813)   Cannot convert string to DBREF
-- Set to be a STRING ('default')
    !matr = !this.matref.selection().trim()
  endhandle
!!MdsDacControl(true)
  if (!ancills.set()) then
    do !indx values !ancills
      !atta = !indx.dbref()
      !MatrefAtt = !!MdsUseMatref(!atta)
      if !MatrefAtt.eq('UDA') then
        !atta.:MDSMatRef = !matr
          handle (2,794)
-- (2,794)   Cannot assign to attribute.  Object must be of type <DBREF>
-- Setting value to 'default' i.e. 'unset'
            !!ce = !atta
            :MDSMatRef $!matr
          elsehandle any
            !!ce = !atta
            !nameofatta = !!ce.name
            !!Alert.Error('Unable to modify the material of $!nameofatta as write access is not available')
            skip
          endhandle
      else
        !atta.MatRef = !matr
          handle (2,794)
-- (2,794)   Cannot assign to attribute.  Object must be of type <DBREF>
-- Setting value to 'default' i.e. 'unset'
            !!ce = !atta
            MatRef $!matr
          elsehandle any
            !!ce = !atta
            !nameofatta = !!ce.name
            !!Alert.Error('Unable to modify the material of $!nameofatta as write access is not available')
            skip
          endhandle
      endif
    enddo
  endif
  !!MdsDacControl(false)
-- Unenhance and Return to the Set Highlight Colour
  !this.unenhance()

endmethod

--------------------------------------------------------------------
define method .cancel()
--------------------------------------------------------------------

-- Unenhance ALL Ancillaries and Return to the Set Highlight Colour
  !this.unenhance()

endmethod

--------------------------------------------------------------------
-- End of Form Definition - !!MdsClampMatl
--------------------------------------------------------------------
