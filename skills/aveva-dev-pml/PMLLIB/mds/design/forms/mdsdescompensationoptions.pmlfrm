------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  mdsDesCompensationOptions()      -
--

setup form !!mdsDesCompensationOptions

  frame .gaps 'Gap'
    text .mingap 'Minimum:' tagwidth 14 width 20 is REAL format !!distanceFmt
    text .maxgap 'Maximum for Plates:' tagwidth 14 at xmin ymax+0.1  width 20 is REAL format !!distanceFmt
    text .maxgapPrfl 'Maximum for Profile:' tagwidth 14 at xmin ymax+0.1  width 20 is REAL format !!distanceFmt
  exit
  frame .thickness 'Plate Thickness' at xmin ymax
    text .thkncalcmethod 'Calculation Method:' tagwidth 14 at xmin.mingap ymax width 20 is STRING
    paragraph .para1 at xmin.mingap ymax text 'Visually Accommodate:' width 14
    paragraph .accommodate at xmax ymin width 4
  exit
  frame .rounding 'Rounding' at xmin ymax
    text .roundingMethod 'Calculation Method:' tagwidth 14 at xmin.mingap ymax width 20 is STRING
    text .xrounding 'X-size Value:' tagwidth 14 at xmin.mingap ymax+0.1 width 20 is REAL format !!distanceFmt
    text .yrounding 'Y-size Value:' tagwidth 14 at xmin ymax+0.1 width 20 is REAL format !!distanceFmt
  exit

exit

-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsDesCompensationOptions()

  !this.formtitle = 'MDS Compensation Options'
  !this.initcall = '!this.init()'

  !this.mingap.seteditable(false)
  !this.maxgap.seteditable(false)
  !this.maxgapPrfl.seteditable(false)
  !this.thkncalcmethod.seteditable(false)
  !this.roundingMethod.seteditable(false)
  !this.xrounding.seteditable(false)
  !this.yrounding.seteditable(false)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !error = !!mdsCompplateDflts.loaderror
  if !error.set() then
    return error 1 '$!error'
  endif

  !this.mingap.val = !!mdsCompplateDflts.mingap
  !this.maxgap.val = !!mdsCompplateDflts.maxgap
  !this.maxgapPrfl.val = !!mdsCompplateDflts.maxgapPrfl
  !this.thkncalcmethod.val = !!mdsCompplateDflts.thknMethodDesc(!!mdsCompplateDflts.thknCalculationMethod)
  !this.roundingMethod.val = !!mdsCompplateDflts.roundingMethodDesc(!!mdsCompplateDflts.roundingMethod)
  !this.xrounding.val = !!mdsCompplateDflts.xrounding
  !this.yrounding.val = !!mdsCompplateDflts.yrounding
  if !!mdsCompplateDflts.accommodateThkn then
    !accommodate = 'On'
  else
    !accommodate = 'Off'
  endif
  !this.accommodate.val = !accommodate

endmethod
-- End of method
