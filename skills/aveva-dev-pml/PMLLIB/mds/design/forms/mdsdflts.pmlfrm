--
--
-- Description:
-- Form to select the mds defaults file
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action(STRING)                   -
--  getDefaults(STRING)              -
--  init(STRING)                     -
--  mdsDflts()                       -
--

-- Kill existing form definition
Kill !!mdsDflts

-- Define Form
setup form  !!mdsDflts

  !this.formtitle = 'MDS Default File Setup'

  --------------------------------------------------------------------------------
  --<wd>feb2006<mds12> -- Form Gadgets Not Required at MDS12
  --
  --  list .dimension 'Dimensions' width 20 height 4
  --  list .description 'Descriptions' width 20 height 4
  --  list .altd 'Alternative Descriptions' width 20 height 4
  --  list .config 'Configuration' at x0 ymax+0.5 width 20 height 4
  --  list .hangConfig 'Hangers Configuration' width 20 height 4
  --  list .id 'Identity' width 20 height 4
  --  list .draft 'Draft'  at x0 ymax+0.5 width 20 height 4
  --  list .icons 'Icons'  width 20 height 4
  --  list .matr 'Matr'  width 20 height 4
  --  button .ok     |   OK   | at x0 ymax+0.5 call |!this.action()| OK
  --  button .cancel  | Cancel | at xmax form-size ymin cancel
  --
  --<wd>feb2006<mds12> -- Form Gadgets Not Required at MDS12
  --------------------------------------------------------------------------------

  -- Form Members
  --<wd>feb2006<mds12> -- Form Member Not Required at MDS12
  --    member .support is STRING
  member .defaultFile is FILE
  member .iso is REAL
  !this.iso = 1

  -- End form definition
exit
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .mdsDflts()
  --<wd>feb2006<mds12>
  --  !this.defaultFile = object FILE('%PDMSDFLTS%/DRA-MDS-DEFAULTS')
  !this.defaultFile = object FILE('%PDMSDFLTS%/DRA-MDS-ABA-DEFAULTS')
  !this.getDefaults('   ')
endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .init(!mode is STRING)

  -- Get the PDMS Module
  !bann = banner
  !bnam = !bann.name.upcase()

  -- Check if MDS defaults have been loaded
  --<wd>may2007<mds12>
  !bshort = !bann.short.upcase()
  --  if (!bnam.match('DESIGN').gt(0)) or (!bnam.match('OUTFITTING').gt(0)) then
  if (!bshort.match('DESIGN').gt(0)) or (!bshort.match('OUTFITTING MK').gt(0)) then
    --<wd>may2007<mds12>

    if !!mdsOptions.site.val.neq('Not Set') then
      -- MDS DESIGN Application MAIN FORM ICONS and MENUS "ACTIVATE/DEACTIVATE"
      !!mdsDeactIcons()
      return
    endif
  endif
  !this.getDefaults('   2')

  -- Set the Callback on the OK button
  --<wd>may2007<mds12>
  --  if (!bnam.match('DESIGN').gt(0)) or (!bnam.match('OUTFITTING').gt(0)) then
  if (!bshort.match('DESIGN').gt(0)) or (!bshort.match('OUTFITTING MK').gt(0)) then
    --<wd>may2007<mds12>

    !this.okcall = |!this.action('')|

    --<wd>nov2005
  elseif (!bnam.match('PARAGON').gt(0)) then
    !this.okcall = |!this.action('')|
    --<wd>nov2005

    --<wd>may2007<mds12>
    --  elseif (!bnam.match('DRAFT').gt(0)) then
  elseif (!bshort.match('DRAFT').gt(0)) or (!bshort.match('OUTFITTINGDRAFT').gt(0)) then
    --<wd>may2007<mds12>

    --<wd>-10may2002
    --    if (!mode.eq('EXPLICIT')) then
    --      !this.okcall = |!this.action('EXPLICIT')|
    --    elseif (!mode.eq('SELECTION')) then

    if (!mode.eq('SELECTION')) then
      --<wd>-10may2002
      !this.okcall = |!this.action('SELECTION')|
    elseif (!mode.eq('DEFAULTS')) then
      !this.okcall = |!this.action('DEFAULTS')|
    endif

  endif
  !this.getDefaults('   2')
  !action = !this.okcall

  -- Run the OK callback action
  $!action

endmethod
-------------------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------------------
define method .getDefaults(!num is STRING)
  --------------------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------------
  --<wd>07oct2008 - DUN1045 - Changes required for the Mds12.1 Vista release
  --  !file = '%PDMSDFLTS%/VPD' &  !this.defaultFile.name().after('/').substring(4,4)
  --  !len = !num
  --  if !num.length().eq(3) then
  --   !len = !len & !this.iso
  --  endif
  --  !testFile = !file.substring(13,!len)
  --  if !testFile.not() then
  --   !!messageFile.warning(43,292)
  --  endif

  !file = '%PDMSDFLTS%/VPD' &  !this.defaultFile.name().after('/').substring(4,4)
  !len = !num
  if !num.length().eq(3) then
    !len = !len & !this.iso
  endif
  !file = 'h.yx6$h095454360537'
  !testFile = !file.substring(10,!len)
  if !testFile.not() then
    !!alert.warning('Unable to load MDS Drawing Application. MDS license not available - Continuing to load Draft')
  endif
  --<wd>07oct2008 - DUN1045 - Changes required for the Mds12.1 Vista release

  $* Check whether PDMS-VPRM Gateway is installed
  !pdsc01 = object file('%PDMSEXE%\pdsc01.exe')
  if (!pdsc01.exists()) then
    !!vprmexists = true
  else
    !!vprmexists = false
  endif
  ---------------------------------------------------------------------------------------------------

endmethod
-----------------------------------------------------------------------------------------------------------

-----------------------------------------------------------------------------------------------------------
define method .action(!mode is STRING)
  -----------------------------------------------------------------------------------------------------------
  --
  --<wd>feb2006<mds12>
  --
  -- FOR MDS12 the PML CODE has been moved to the new PML OBJECT !!mdsLoadStdDefs.pmlobj which is
  -- called from the new PML FUNCTION !!mdsDesignLoad.pmlfnc for loading MDS12 DESIGN in this METHOD
  --
  --<wd>feb2006<mds12>

  -- Get the PDMS Module
  !bann = banner
  !bnam = !bann.name.upcase()

  -- Enter PDMS MDS DESIGN or MDS ABA DRAFT Applications
  --<wd>may2007<mds12>
  !bshort = !bann.short.upcase()
  --  if (!bnam.match('DESIGN').gt(0)) or (!bnam.match('OUTFITTING').gt(0)) then
  if (!bshort.match('DESIGN').gt(0)) or (!bshort.match('OUTFITTING MK').gt(0)) then
    --<wd>may2007<mds12>
    --><wd>19mar2009 - Defect No. P16924
    -- Ensure the "AC" Non User Selectable MDS Standard Support Types of the MDSSELECTION OBJECTS
    -- are Populated with the required .pipeWeld and .trunWeld - NWELDS values - from DES-SUPP-DEFS
    if (undefined(!!mdsNonUserAC)) then
      pml load FORM !!mdsNonUserAC
    endif
    --><wd>19mar2009 - Defect No. P16924

    -- MDS12 DESIGN Application Initial Entry
    --<wd>feb2006<mds12>
    -- MDS12 DESIGN Application Loading PML Function introduced
    !!mdsDesignLoad()
    --<wd>feb2006<mds12>

    -- MDS DESIGN Application MAIN FORM ICONS and MENUS "ACTIVATE/DEACTIVATE"
    !!mdsDeactIcons()

    -- Populate the !!mdsMatl form
    !!mdsMatl.populate()

    --<wd>may2007<mds12>
    --  elseif (!bnam.match('DRAFT').gt(0)) then
  elseif (!bshort.match('DRAFT').gt(0)) or (!bshort.match('OUTFITTINGDRAFT').gt(0)) then
    --<wd>may2007<mds12>

    -- MDS12 ABA DRAFT  Application Initial Entry
    if (undefined(!!kFabDflts)) then
      !!mdsAbaBuildForms()
    endif

    if (!mode.eq('SELECTION')) then
      if ((defined(!!mdsAbaDpcVar)) and (!!mdsAbaDpcVar)) then
        -- In DPC Process mode - Only Initialise the Form and Don't Show it!
        !!mdsAbaSelSupp.init()
      else
        -- In MDS ABA User Interactive Mode - Show Form
        show !!mdsAbaSelSupp free
      endif
      --<wd>-16may2002

    elseif (!mode.eq('DEFAULTS')) then
      show !!kFabDflts
    endif
  endif

endmethod
--------------------------------------------------------------------------------
