--
-- File:    mdseditprop.pmlfrm
--   Type:    Form
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   Wednesday 5th May 2004
--
--
-- Description:
-- Form Definition for editing the properties of a ancillary
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actionProp(STRING)               -
--  editatta()                       -
--  init(FORM)                       -
--

-- Kill existing form definition

kill !!mdsEditProp

-- Define form

!test = !!mdsEditableProps
handle ANY
  !!mdsEditableProps = 0
endhandle

--<RM> P-43000 now ptypes of each user editable design parameters are provided so that the edit prop form can be set up with the correct format objects - start
!mdsEditablePropsPtyp = !!mdsEditablePropsPtyp
handle ANY
  --the above statement will fail during application load as there will be no defined calling arguments
  --we can just handle this and all will be ok.
elsehandle NONE
  !mdsEditablePropsPtyp.compress()
endhandle
--<RM> P-43000 now ptypes of each user editable design parameters are provided so that the edit prop form can be set up with the correct format objects - end
setup form !!mdsEditProp

  !!mdsEditProp.formtitle    = |Modify Atta Properties|
  !!mdsEditProp.icontitle    = |Mod Ancill|
  !!mdsEditProp.callback     = ||
  !!mdsEditProp.formrevision = ||

  -- Body of Form

  para .tag text | Name:|
  para .name at xmax+2 ymin width 20 lines 1
  path right

  do !createProp from 1 to !!mdsEditableProps
    --<RM> P-43000 set the correct format object against the newly created gadgets - start
    if !mdsEditablePropsPtyp[$!createProp].eq('DIST') then
      !!fmt$!createProp = !!distanceFmt
    elseif !mdsEditablePropsPtyp[$!createProp].eq('BORE') then
      !!fmt$!createProp = !!boreFmt
    elseif !mdsEditablePropsPtyp[$!createProp].eq('ANGL') then
      !!fmt$!createProp = !!angleFmt
    elseif !mdsEditablePropsPtyp[$!createProp].eq('MASS') then
      !!fmt$!createProp = !!massFmt
    elseif !mdsEditablePropsPtyp[$!createProp].eq('TEMP') then
      !!fmt$!createProp = !!temperatureFmt
    else
      --if no ptyp has been defined we need a default value of distance, this will not be correct for all cases but will
      --be better than having hard crashes when there is unset data in the catalogue
      !!fmt$!createProp = !!distanceFmt
    endif

    para .pProp$!createProp at x1 Ymax text '12345678901234567890123456789012'
    text .prop$!createProp    || call |!!mdsEditProp.actionProp('$!createProp')| width 14 is REAL format !!fmt$!createProp
    --<RM> P-43000 set the correct format object against the newly created gadgets - end
    para .prop$!createProp$nMinMax at x1 ymax text '12345678901234567890123456789012'
  enddo

  --<dw>Mar2008 Dun1119 - To display change to temperature range resulting from change to other property, typically height
  para .rangtemp at x1 ymax text '                 '
  para .notetemp at xmax+16 ymin width 14 lines 1
  --<dw>Mar2008 Dun1119 - End of temperature range display

  button .setDefault at x1     ymax tooltip |Set Parameters to Default|    pixmap width 18 height 18 call |!!mdsSetDef(!!mdsEditProp.support.alias,!!mdsEditProp.atta,'CONFIRM')|
  button .setSteel   at xmax+2 ymin tooltip |Set Height to Steel/Bedplate| pixmap width 18 height 18 call |Call !!mdsModShoe(!!mdsEditProp,'STEEL',!!mdsEditProp.atta)|
  button .modifyType at xmax+2 ymin tooltip |Modify Ancillary Type|        pixmap width 18 height 18 call |Call !!mdsModAnc('Combined')|
  button .edit       at xmax+2 ymin tooltip |Modify Ancillary|             pixmap width 18 height 18 call |!!mdsEditProp.editatta()|

  -- Bottom Line
  --<dw>jan2009 dun1081 global variable deletion when form dismissed - HPD0038589
  button .cancel  | Dismiss | at xmax form-size ymax+0.5 call |!!frameForm.delete()| OK
  button .ce      | CE | at x0 ymin call |!!doNotID = TRUE
  !!mdsEditProp.init(!!mdsEditProp.callingForm)|

  -- Form Members

  -- data storage for properties

  do !createmem from 1 to $!!mdsEditableProps
    member .prop$!createmem$nMin is REAL
    member .prop$!createmem$nMax is REAL
    member .prop$!createmem$nDpNum is REAL
    --<RM> P-43000 add a new member to contain the ptyp of each property - start
    member .prop$!createmem$nPtyp is STRING
    --<RM> P-43000 add a new member to contain the ptyp of each property - end
  enddo

  member .atta is DBREF
  member .actionheight is ARRAY
  member .actionlength is ARRAY
  member .actionthickness is ARRAY
  member .actionangle is ARRAY
  member .callingForm is FORM
  member .heightGadget is GADGET
  member .lengthGadget is GADGET

  --<wd>28jun2004
  member .thicknessGadget is GADGET

  -- Populate Form Members with Default Callbacks

  !!mdsEditProp.actionheight[1]    = |call !!mdsModShoe(!!mdsEditProp,'HEIGHT',!!mdsEditProp.atta)|
  !!mdsEditProp.actionheight[2]    = ||
  !!mdsEditProp.actionlength[1]    = |call !!mdsModShoe(!!mdsEditProp,'LENGTH',!!mdsEditProp.atta)|
  !!mdsEditProp.actionlength[2]    = ||
  !!mdsEditProp.actionthickness[1] = |call !!mdsModShoe(!!mdsEditProp,'THICKNESS',!!mdsEditProp.atta)|
  !!mdsEditProp.actionthickness[2] = ||
  !!mdsEditProp.actionangle[1] = |call !!mdsModShoe(!!mdsEditProp,'ANGLE',!!mdsEditProp.atta)|
  !!mdsEditProp.actionangle[2] = ||

  -- Support object
  member .support     is MDSSUPPORT
  -- Form Storage for support restoration
  member .store       is ARRAY
  -- Extra members for edit button
  -- Shoe Reference
  member .shoeref is DBREF
  -- Shoe Existing Height
  member .shoehei is REAL
  -- Associated Trunnion Length
  member .tlength is REAL
  -- Store for the Initialised OK callback
  member .storeaction is ARRAY
  -- Define the 'AT60' Specific Object Members Required.
  member .offset is REAL
  member .flan   is DBREF

  -- End form definition

exit

-- Set background colour of pixmaps to white

!!mdsSetIconBack(!!mdsEditProp,'white')

--
-- Form Methods are Defined below:
--
-----------------------------------------------------------------------------------------------------
define method .init(!frameForm is FORM)
  -----------------------------------------------------------------------------------------------------

  -- Do not show this FORM if the old !!mdsmodat is shown

  !oldFormShown = !!mdsmodat.shown()
  if !oldFormShown then
    !!alert.error('Unable to show modify atta properties form while modify atta form is displayed')
    return
  endif

  !!frameForm = !frameForm

  -- Set calling form in member

  !!mdsEditProp.callingForm = !!frameForm

  -- Test if any atta's have been created

  if !!frameForm.support.datum.unset() then
    !!alert.error('Unable to modify an ancillary as none have been created')
    return
  endif

  -- Set Units

  !currentunits = !!kgetsetunits()

  if defined(!!doNotID) then
    if !!doNotID then
      !!doNotID = FALSE
      golabel /SkipID
    endif
  endif

  -- Check if Calling Support Form is a MDS Framework or Ancillary Standard

  if (!!frameForm.support.stru.set()) then
    !num = 2
  else
    !num = 1
  endif

  -- If only the datum atta has been created default to that
  -- rather than id the atta

  if !!frameForm.support.datum.set() and !!frameForm.support.atta.size().eq(!num) then
    !!ce = !!frameForm.support.datum
    !picked = !!ce
  else

    -- Identify ancillary by cursor
    prompt off
    prompt load escape |Identify ancillary to modify|
    label /again
    id atta plat ctsupp@
    handle (61,528)
      prompt dismiss
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle

    !picked = !!ce

    -- Is picked atta on support
    -- Create list of atta's on support

    if (!!frameForm.support.atta.findfirst(!picked).set().not())then
      !!alert.error('Ancillary picked is not on this support')
      golabel /again
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Check to see if the SREF has been hit, if it has goto the DATUM atta

    if (match(!!ce.name,'/SREF') gt 0) then
      !srefName = !!ce.name
      var !strip (Before(!srefName,'/SREF'))
      !datumName = !strip & '/DATUM'
      !!ce = !datumName.dbref()
    endif

  endif

  label /SkipID

  !picked = !!ce

  -- Now find if the atta has any editable properties

  --!currentStyp = styp

  !bore = !!ce.abor.real()
  handle ANY
    !bore = !!ce.ppbor[1].real()
  endhandle
  ------------------------------------------------------------------------------------------------
  -- mjb >>> 10.03.06 <mds12>

  !atta = !!ce

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!bore)

  !editableProperties = !mdsattaobj.userdps

  --!editableProperties = !!mdsPar$!currentStyp[$!bore].userdps
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------------------------
  handle NONE
    !!mdsEditableProps = !editableProperties.size()
    !!mdsEditablePropsPtyp = object ARRAY()
    do !i index !editableProperties
      !dpNum   = !editableProperties[$!i].dpNum
      var !whichData coll all data with num eq $!dpNum and purp eq 'DESP' for dtre
      --<RM> P-43000 include ptype in the data that is passed to form setup - start
      var !dataPtyp eval ptyp for all from !whichData
      handle ANY
        !dataPtyp = object ARRAY()
        !dataPtyp[1] = NONE
      endhandle
      !!mdsEditablePropsPtyp[$!dpNum] = !dataPtyp[1]
      --<RM> P-43000 include ptype in the data that is passed to form setup - end
    enddo

  elsehandle ANY
    !!mdsEditableProps = 0
  endhandle

  -- Save calling form if set
  !saveForm = !!frameForm
  pml reload form !!mdsEditProp

  -- Set calling form in member

  !!mdsEditProp.callingForm = !saveForm
  !!frameForm = !saveForm

  -- Put type of identified support in support.alias object

  !ceAlias = !!mdsAliasList(!!ce.styp)
  !!mdsEditProp.support.alias = !ceAlias
  !!mdsEditProp.atta = !!ce

  --<dw>Mar2008 Dun1119 - To display change to temperature range resulting from change to other property, typically height
  if !!ce.prop.desc inset ('AT140','AT141','AT144','AT145','AT146','AT147','AT148','AT149','AT150','AT151') then
    !mintemp   = !!mdsEditProp.atta.prop.minT
    !maxTemp   = !!mdsEditProp.atta.prop.maxT
    !!mdsEditProp.rangtemp.val = 'Temperature Range'
    !!mdsEditProp.notetemp.val = 'Min $!mintemp Max $!maxTemp'
  endif
  --<dw>Mar2008 Dun1119 - End of temperature range display

  -- Set name on form

  !!mdsEditProp.name.val = !picked.name

  -- Copy support object from calling form

  !prop = 1

  do !loopThrough index !editableProperties

    !minimum = !editableProperties[$!loopThrough].min
    !maximum = !editableProperties[$!loopThrough].max
    !dpNum   = !editableProperties[$!loopThrough].dpNum
    var !whichData coll all data with num eq $!dpNum and purp eq 'DESP' for dtre
    var !dataDesc eval dtitle for all from !whichData
    --<RM> P-43000 populate the new property ptyp member with the ptyp of each despar - start
    var !dataPtyp eval ptyp for all from !whichData
    !!mdsEditProp.pProp$!prop$n.val = '$!dataDesc[1]'
    !ptyp = !dataPtyp[1]
    !currentDesp = despar
    !!mdsEditProp.prop$!prop$n.val = !currentDesp[$!dpNum]
    !!mdsEditProp.prop$!prop$nmin = !minimum
    !!mdsEditProp.prop$!prop$nmax = !maximum
    !!mdsEditProp.prop$!prop$ndpnum = !dpNum
    !!mdsEditProp.prop$!prop$nptyp = !ptyp
    --<RM> P-43000 populate the new property ptyp member with the ptyp of each despar - end

    --<RM> P-43000 format the minimum and maximum gadget label for each property with the appropriate format object for its ptype - start
    if !ptyp.eq('DIST') then
      !fmt = !!distanceFmt
    elseif !ptyp.eq('BORE') then
      !fmt = !!boreFmt
    elseif !ptyp.eq('ANGL') then
      !fmt = !!angleFmt
    elseif !ptyp.eq('MASS') then
      !fmt = !!massFmt
    elseif !ptyp.eq('TEMP') then
      !fmt = !!temperatureFmt
    else
      --if no ptyp has been defined we need a default value of distance, this will not be correct for all cases but will
      --be better than having hard crashes when there is unset data in the catalogue
      !fmt = !!distanceFmt
    endif

    !!mdsEditProp.prop$!prop$nMinMax.val = !minimum.string(!fmt) + ' - ' + !maximum.string(!fmt)
    --<RM> P-43000 format the minimum and maximum gadget label for each property with the appropriate format object for its ptype - end

    -- Turn off gadget if min/max same

    if !minimum.eq(!maximum) then
      !!mdsEditProp.prop$!prop$n.active = FALSE
    else
      !!mdsEditProp.prop$!prop$n.active = TRUE
    endif

    !prop = !prop + 1

  enddo

  -- We need to store the height/length gadgets for the set height icon

  var !collData coll all data with dkey eq 'HEI' for dtre
  if !collData.size().eq(0) then
    !!mdsEditProp.setSteel.active = FALSE
  else
    var !heiNum eval num for all from !collData
    !gadgetCounter = 1
    do !whichGadget indices !editableProperties
      if !whichGadget.eq(!heiNum[1].real()) then
        !gadgetNum = $!whichGadget
        break
      else
        !gadgetCounter = !gadgetCounter + 1
        skip
      endif
    enddo
    -- Handle if it is not editable
    !!mdsEditProp.heightGadget = !!mdsEditProp.prop$!gadgetCounter
    handle ANY
    endhandle
  endif

  var !collData coll all data with dkey eq 'LEN' for dtre
  if !collData.size().eq(0) then
    !!mdsEditProp.setSteel.active = FALSE
  else
    var !lenNum eval num for all from !collData
    !gadgetCounter = 1
    do !whichGadget indices !editableProperties
      if !whichGadget.eq(!lenNum[1].real()) then
        !gadgetNum = $!whichGadget
        break
      else
        !gadgetCounter = !gadgetCounter + 1
        skip
      endif
    enddo
    -- Handle if it is not editable
    !!mdsEditProp.lengthGadget = !!mdsEditProp.prop$!gadgetCounter
    handle ANY
    endhandle
  endif

  --<wd>28jun2004
  -- ThicknessGadget added
  var !collData coll all data with dkey eq 'THK' for dtre
  if !collData.size().neq(0) then
    var !thkNum eval num for all from !collData
    !gadgetCounter = 1
    do !whichGadget indices !editableProperties
      if !whichGadget.eq(!thkNum[1].real()) then
        !gadgetNum = $!whichGadget
        break
      else
        !gadgetCounter = !gadgetCounter + 1
        skip
      endif
    enddo
    -- Handle if it is not editable
    !!mdsEditProp.thicknessGadget = !!mdsEditProp.prop$!gadgetCounter
    handle ANY
    endhandle
  endif
  --<wd>28jun2004

  -- Check if Calling Support Form is a MDS Framework or Ancillary Standard

  if (!!frameForm.support.stru.set()) then
    !!mdsEditProp.modifyType.active = TRUE
    !num = 2
  else
    !!mdsEditProp.modifyType.active = FALSE
    !num = 1
  endif

  -- Certain standard do not require the set height to steelwork button showing
  -- The :MdsSetHeight uda at cate level in the catalog will be set to true/false

  !mdsSetHeight = !picked.catref.owner.:mdssethei
  !!mdsEditProp.setSteel.active = $!mdsSetHeight

  -- Check to see if you can write or its locked to the desp if not then block out all buttons

  !!mdsDacControl(TRUE)
  !dacBoolean = DACMOD DESP
  !locked = !picked.lock
  !!mdsDacControl(FALSE)
  if !dacBoolean.not() or !locked then
    !!mdsEditProp.setDefault.active = FALSE
    !!mdsEditProp.setSteel.active = FALSE
    !!mdsEditProp.modifyType.active = FALSE
    !!mdsEditProp.edit.active = FALSE
  endif

  -- If the standard is an AT25 then the height is controlled via the insulation so therefore
  -- block out the modification of the height

  if !!frameForm.support.alias.eq('AT25') or !!frameForm.support.alias.eq('AN06') then
    !!mdsEditProp.height.active = FALSE
    handle ANY
      --<tm>22/04/2005 09:45 for AT25 there is no height gadget on the form so handle the error and get on with it
    endhandle
  endif

  --<dw>jan2009 dun1081 - Check AC46 identified as height to isolation block for TT23 controlled by property Pdist - HPD0038589
  if !!frameForm.support.alias.eq('TT23') then
    if !!ce.prop.desc.neq('AC46') then
      plat1
      !replacename = !!ce.prop.rnam
      !!alert.error('Top plate ' & !replacename & ' must be identified')
      return
    endif
  endif
  --<dw>jan2009 dun1081 global variable now deleted when form dismissed
  --as required in method 'actionprop' to identify TT23
  --!!frameForm.delete()
  --<dw>jan2009 dun1081 - End check that AC46 identified

  show !!mdsEditProp


  -- Reset Project Units
  !!kRestoreUnits(!currentunits)


endmethod
---------------------------------------------------------------------------------------------------------------
--
--
--
---------------------------------------------------------------------------------------------------------------
define method .actionProp(!prop is STRING)

  -- Goto atta
  !!ce = !!mdsEditProp.atta
  !atta = !!ce
  -- Set dpnum to be edited and value to set

  !dpNum = !!mdsEditProp.prop$!prop$ndpnum
  !value = !!mdsEditProp.prop$!prop$n.val
  --<RM> P-43000 get the current property ptyp value so we can properly format the return data - start
  !ptyp = !!mdsEditProp.prop$!prop$nptyp

  if !ptyp.eq('DIST') then
    !fmt = !!distanceFmt
  elseif !ptyp.eq('BORE') then
    !fmt = !!boreFmt
  elseif !ptyp.eq('ANGL') then
    !fmt = !!angleFmt
  elseif !ptyp.eq('MASS') then
    !fmt = !!massFmt
  elseif !ptyp.eq('TEMP') then
    !fmt = !!temperatureFmt
  else
    --if no ptyp has been defined we need a default value of distance, this will not be correct for all cases but will
    --be better than having hard crashes when there is unset data in the catalogue
    !fmt = !!distanceFmt
  endif
  --<RM> P-43000 get the current property ptyp value so we can properly format the return data - end

  -- !value is the value typed into the text gadget
  -- if the units are set to finch then the value is in inches
  -- assuming that the property is not going to be a bore size then
  -- we need to manually convert the value

  !units = object COMUNITS(TRUE)

  -- the units variable is FORMATted like this 'INCH Bore FINC Distance'

  if (!!isImperialLength('DIST')) then
    units mm dist
    --!value = !value * 25.4
  endif

  -- Check if value exceeds the min/max value.

  !min = !!mdsEditProp.prop$!prop$nmin
  if !value.lt(!min) then
    !dispValue = !value.string(!fmt)
    !dispMin = !min.string(!fmt)
    !!alert.error(|Value of $!dispValue is less than minimum $!dispMin allowed|)
    !desp = despar
    !!mdsEditProp.prop$!prop$n.val = $!desp[$!dpNum]
    !units.restoreSavedUnitsByPtype('DIST')
    return
  endif

  !max = !!mdsEditProp.prop$!prop$nmax
  if !value.gt(!max) then
    !dispValue = !value.string(!fmt)
    !dispMax = !max.string(!fmt)
    !!alert.error(|Value of $!dispValue is more than maximum $!dispMax allowed|)
    !desp = despar
    !!mdsEditProp.prop$!prop$n.val = $!desp[$!dpNum]
    !units.restoreSavedUnitsByPtype('DIST')
    return
  endif
  !units.restoreSavedUnitsByPtype('DIST')

  !!mdsDacControl(TRUE)
  -----------------------------
  --<wd>28jun2004 - get the Original RPAD thickness before Changing it
  if (!!mdsEditProp.thicknessGadget.set()) then
    if (!!mdsEditProp.thicknessGadget.name().after('PROP').eq(!prop)) then
      if (!!ce.prop.desc inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
        !dpNum  = !!mdsGetDesp('THK')
        !currentdespars = despar
        !beforethk = !currentdespars[$!dpNum]
      endif
    endif
  endif
  --<wd>28jun2004
  ----------------------------

  despar n$!dpNum  $!value
  handle (2,18)
    !desp = despar
    !!mdsEditProp.prop$!prop$n.val = $!desp[$!dpNum]
    !!alert.error('Unable to modify atta as it is locked')
    return
  endhandle

  --<wd>21jun2004 - Test for AT65 Wrapper Plate etc...
  -- For MDS Standard 'AT65' - Set the DESPAR Num 8 i.e. Property 'ASSY' :-
  -- to either: 'A' for Pipe where DESPAR NUM 9 is ALWAYS set to ZERO '0'
  --        or: 'Bx' for Plate where 'x' is the Plate thickness same as DESPAR NUM 1
  if (!!ce.prop.desc inset ('AT65')) then
    !mattyp = purpose of spec of mtoref
    if (!mattyp.eq('PIPE')) then
      desp num 8 A
      !!ce.desp[9] = 0
    elseif (!mattyp.eq('PLAT')) then
      desp num 8 B
      !!ce.desp[9] = !!ce.desp[1]
    endif
  endif
  --<wd>21jun2004

  --<dw>jan2009 dun1081 - To allow height to isolation block for TT23 to be controlled by property Pdist for AC46 - HPD0038589
  if (!!ce.prop.desc inset ('AC46') and !!frameForm.support.alias.eq('TT23')) then
    !!mdsSetTrunLen('GADGET',!!mdsTT23.tlength.val.real(),!!mdsTT23.support.datum,'D WRT /*','TT23',!!mdsTT23)
    return
  endif
  --<dw>jan2009 dun1081 - End of allowing height to isolation block to be controlled by property Pdist for AC46
  -----------------------
  --<wd>28jun2004
  -- Modifying the RPAD Thickness means that An Associated Pipe Shoe Height Attribute needs changing
  if (!!mdsEditProp.thicknessGadget.set()) then
    if (!!mdsEditProp.thicknessGadget.name().after('PROP').eq(!prop)) then
      if (!!ce.prop.desc inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then

        ------------------------------------------------------------------------------------------------
        -- mjb >>> 10.03.06 <mds12>

        --!parVar = '!!mdspar' & !!ce.styp
        !bore   = !!ce.abor

        !realbore = !bore.real()
        !mdsattaobj  = object MDSREADPARSDATA()
        !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)
        !dpNum  = !!mdsGetDesp('THK')
        !min = !mdsattaobj.userdps[$!dpNum].min
        !max = !mdsattaobj.userdps[$!dpNum].max
        --!min    = $!parVar[$!bore].userdps[$!dpNum].min
        --!max    = $!parVar[$!bore].userdps[$!dpNum].max

        -- mjb >>> end of mod
        ------------------------------------------------------------------------------------------------

        -- Check :MDSSREF is TRUE and VALID
        if (!!ce.:mdssref.badref().not() and !!ce.:mdscp3.eq('SHOE')) then
          !currentdespars = despar
          !afterthk    = !currentdespars[$!dpNum]
          !thkchange   = !beforethk - !afterthk
          !originalmem = !!ce
          --Modify the Pipe Shoe HEI and PTHK as required
          goto :mdssref

          ------------------------------------------------------------------------------------------------
          -- mjb >>> 10.03.06 <mds12>
          !shoeref = !!ce
          !dpNum = !!mdsGetDesp('HEI')
          if (!dpNum.neq(0)) then
            !currentvalue = prop HEI
            !newvalue = !currentvalue.real() + !thkchange
            --!shoestyp = styp
            -- mjb   ***SET OBJECT WITH SHOE VALUES***
            !realbore = !bore.real()
            !mdsattaobjshoe  = object MDSREADPARSDATA()
            !mdsattadefs = !mdsattaobjshoe.mdsdefsdata(!shoeref.stype,!realbore)

            !min = !mdsattaobjshoe.userdps[$!dpNum].min
            !max = !mdsattaobjshoe.userdps[$!dpNum].max

            --!shoeparvar = '!!mdspar' + !shoestyp
            --!min = $!shoeparvar[$!bore].userdps[$!dpNum].min
            --!max = $!shoeparvar[$!bore].userdps[$!dpNum].max
            -- mjb >>> end of mod
            ------------------------------------------------------------------------------------------------
            if (!newvalue.nint() lt !min.nint()) then
              !newvalue = !min
            endif
            if (!newvalue.nint() gt !max.nint()) then
              !newvalue = !max
            endif
            !!mdsSetDespar(!!ce,!dpNum,!newvalue)
            !dpNum = !!mdsGetDesp('PTHK')
            if (!dpNum.neq(0)) then
              !!mdsSetDespar(!!ce,!dpNum,!!mdsEditProp.thicknessGadget.val.real())
            endif
          endif
          !!ce = !originalmem
        endif
      endif
    endif
  endif

  --<wd>28jun2004
  -----------------------------
  -- Need to set any alternative representation expressions if set

  !units = object COMUNITS(TRUE)
  if (!!isImperialLength('BORE')) then $* its inch bore
    units mm bore
    units mm dist
    !bore = pa bore
  else
    !bore = pa bore
  endif
  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 10.03.06 <mds12> Changes from old object mdsparxxxx (where xxxx is e.g. at01) to new object mdsreadparsdata
  -- mjb >>> (Old code left in, commented out)
  !realbore = !bore.real()
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)

  --!suppType = !!ce.styp

  --!parVar = '!!mdsPar' + !suppType
  --!expr = $!parVar[$!bore].altexpr
  --!altdespar = $!parVar[$!bore].altdespars

  !expr = !mdsattaobj.altexpr
  !altdespar = !mdsattaobj.altdespars

  --!expr is ARRAY of strings

  if !expr.set() then

    --mjb-- if !expr.size().eq(1) then
    --if !expr.match(',').eq(0) then
    --var !test ($!expr)
    --mjb-- var !test ($!expr[1])
    --if (!test.boolean()) then
    -- Set The Alternate Despar Expressions to the value stored in the pars
    -- (Set to alternative expression = true values)
    --do !xSet values !altdespar
    --mjb-- do !xSet values !altdespar[1]
    --   !!mdsSetDespar(!!ce,!xSet.dpNum,!xSet.altval.real())
    -- enddo
    --else
    -- Set The Despar to the value stored in the parvar
    -- (Set to alternative expression = false values (defaults from !mdsattaobj)
    --do !xSet values !altdespar
    --mjb-- do !xSet values !altdespar[1]
    --mjb--   !aRealValue = !mdsattaobj.despars[$!xSet.dpNum]
    --!aRealValue = $!parVar[$!bore].despars[$!xSet.dpNum]
    --   !brealvalue = $!aRealValue
    --   !!mdsSetDespar(!!ce,!xSet.dpNum,!brealvalue)
    --  enddo
    --endif
    -------------------------------------------------------------------------------
    --MJB *** THis BLOCK COMMENTED OUT FOR NOW - WHY WAS IT THERE?

    --!dpNum = !!mdsGetDesp('LEN')
    --if (!!mdsEditProp.lengthGadget.val.unset()) then
    --  !!mdsEditProp.lengthGadget.val = 0
    --endif
    --!!mdsSetDespar(!!ce,!dpNum,!!mdsEditProp.lengthGadget.val.real())

    --!dpNum = !!mdsGetDesp('HEI')
    --if (!!mdsEditProp.heightGadget.val.unset()) then
    --  !!mdsEditProp.heightGadget.val = 0
    --endif
    --!!mdsSetDespar(!!ce,!dpNum,!!mdsEditProp.heightGadget.val.real())

    --!deslen = despar[!dpNum]
    --!desint = !deslen.nint()
    --desp num $!dpNum $!desint
    ----------------------------------------------------------------------------------
    -- else

    !sExpr = !expr
    --!sExpr = !expr.split(',')
    !exprCounter = 1

    !alreadySet = ARRAY()

    do !testForExpr values !sExpr
      !saltdespar = !altdespar

      if (!testForExpr.set()) then
        var !test ($!testForExpr)
        if (!test.boolean()) then
          --alt expression true so set alt despars
          --do over all alt despars for each alt expression
          do !xSet values !saltdespar[!exprCounter]
            --alt expr TRUE setting alt despars to alt despar values
            --append des par number set to AlreadySet array
            !alreadySet.append(!xSet.dpNum)
            --!!mdsSetDespar(!!ce,!saltdespar[$!exprCounter][1].dpNum,!saltdespar[$!exprCounter][1].altval.real())
            !!mdsSetDespar(!!ce,!xSet.dpNum,!xSet.altval.real())
            --!!mdsSetDespar(!!ce,!saltdespar[$!exprCounter].dpNum,!saltdespar[$!exprCounter].altval.real())
          enddo
        else
          --set despar values from alt despars back to defaults if alt expr not true
          do !xSet values !saltdespar[!exprCounter]
            --alt expr not TRUE setting alt despars to defaults if not set previously by an alt despar (so in AlreadySet array)
            if !alreadySet.find(!xSet.dpNum).unset() then
              !aRealValue = !mdsattaobj.despars[$!xSet.dpNum]
              !brealvalue = $!aRealValue
              !!mdsSetDespar(!!ce,!xSet.dpNum,!brealvalue)
            endif
          enddo
        endif
      endif
      !exprCounter = !exprCounter + 1
    enddo
    -------------------------------------------------------------------------
    --mjb Why is this section here? Why just LEN and HEI?

    !dpNum = !!mdsGetDesp('LEN')
    if (!!mdsEditProp.lengthGadget.val.unset()) then
      !!mdsEditProp.lengthGadget.val = 0
    endif
    !!mdsSetDespar(!!ce,!dpNum,!!mdsEditProp.lengthGadget.val.real())

    !dpNum = !!mdsGetDesp('HEI')
    if (!!mdsEditProp.heightGadget.val.unset()) then
      !!mdsEditProp.heightGadget.val = 0
    endif
    !!mdsSetDespar(!!ce,!dpNum,!!mdsEditProp.heightGadget.val.real())

    !deslen = despar[!dpNum]
    !desint = !deslen.nint()
    desp num $!dpNum $!desint
    ---------------------------------------------------------------------------
    -- endif
  endif

  !units.restoreSavedBoreDist()
  if !this.callingForm.eq(!!mdsgt02)then
    !this.callingForm.resetdims()
  endif

  -- If any despars set are set to another design para i.e des par n8 is set to (DESP[2]) reevaluate them
  !parsFromFile = !mdsattaobj.despars
  --!parsFromFile = $!parVar[$!bore].despars
  do !loop from 1 to !parsFromFile.size()
    if !parsFromFile[$!loop].match('(').gt(0) then
      despar n$!loop $!parsFromFile[$!loop]
    endif
  enddo
  -- mjb >>> 10.03.06 <mds12> end of mod
  ---------------------------------------------------------------------------------------------------------------

  --<dw>Mar2008 Dun1119 - To display change to temperature range resulting from change to other property, typically height
  if !!ce.prop.desc inset ('AT141','AT146','AT147','AT148','AT150') then
    !heidpnum  = !!mdsEditProp.atta.prop.hei
    if (!heidpnum.real() ge 150) then
      desp n20 -130
    else
      desp n20 -46
    endif
    !mintemp   = !!mdsEditProp.atta.prop.minT
    !maxTemp   = !!mdsEditProp.atta.prop.maxT
    !!mdsEditProp.notetemp.val = 'Min $!mintemp Max $!maxTemp'
  endif
  --<dw>Mar2008 Dun1119 - End of temperature range display

  --<dw>mar2009 DFN P-16883 Branch reinforcing pad adjustment added.
  !adjbranreinf  = FALSE
  if !!ce.prop.desc.eq('BR04') then
    if !dpNum.eq(4) or !dpNum.eq(14) then
      !adjbranreinf  = TRUE
      !dpNumrad      = 14
    endif
  elseif !!ce.prop.desc.eq('BR06') then
    if !dpNum.eq(5) or !dpNum.eq(14) then
      !adjbranreinf  = TRUE
      !dpNumrad      = 14
    endif
  elseif !!ce.prop.desc.eq('BR07') then
    if !dpNum.eq(4) or !dpNum.eq(17) then
      !adjbranreinf  = TRUE
      !dpNumrad      = 17
    endif
  elseif !!ce.prop.desc.eq('BR09') then
    if !dpNum.eq(5) or !dpNum.eq(17) then
      !adjbranreinf  = TRUE
      !dpNumrad      = 17
    endif
  endif
  if !adjbranreinf then
    !dpNumcut   = (!dpNumrad + 1)
    !rdisdpnum  = !!mdsEditProp.atta.prop.rdis
    !rpaddpnum  = !!mdsEditProp.atta.prop.hei
    !cleadpnum  = !!mdsEditProp.atta.prop.clea
    !p21dirn    = p21dir
    !p36dirn    = p36dir
    var !ang const ang $!p21dirn and $!p36dirn
    if (!ang.real() ge 60) then
      !answer = !!alert.confirm('Gusset plate parallel to surface of pad?')
      if !answer.eq('YES') then
        !rdisnew = (!rdisdpnum.real() + (90 - !ang.real()))
        desp n$!dpNumrad  $!rdisnew
        !!mdsEditProp.prop6.val = $!rdisnew
        var !cut construct distance P21 to P36
        !cutback = (!cut.real() - !rpaddpnum.real() / 2 - !cleadpnum.real())
        !cutback = !cutback.nint()
        desp n$!dpNumcut  $!cutback
      else
        desp n$!dpNumcut 0
      endif
    endif
  endif
  --<dw>mar2009 DFN P-16883 End Branch reinforcing pad adjustment

$(
  !bore = !!ce.abor.real()
  !styp = styp
  !altExpr = !!mdsPar$!styp[$!bore].altexpr
  !altExprS = !altExpt.split(',')

$)

  -- GE 19/08/04 Investigating HPD0025386
  if (!!ce.:MDSGuideRef.badref().not() and !!ce.:MDSGuideRef.neq(Nulref)) then
    !!mdsresetguide()
  endif
  -- GE 19/08/04

  !!mdsDacControl(FALSE)

endmethod
-----------------------------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------------------------
define method .editatta()

  -- Get the styp of the atta being edited

  !!ce = !this.atta
  --!stypOfAtta = styp

  -- Perform Any actions required BEFORE the modification of a MDS ANCILLARY Standard ATTA

  !set   = object MDSFRAMEANCILLS()

  !idcomp = !!ce.:mdsguideref.string()

  ------------------------------------------
  -- Perform ANY actions required AFTER the Creation of a MDS ANCILLARY Standard ATTA

  !set.form = !!mdsEditProp
  !set.after(!idcomp,!this.atta)

endmethod
