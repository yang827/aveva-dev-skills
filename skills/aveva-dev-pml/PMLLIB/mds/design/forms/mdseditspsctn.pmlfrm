------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addPad()                         -
--  cancel()                         -
--  checkrotvalue(REAL)              -
--  delPad()                         -
--  extend(STRING,STRING)            -
--  flip()                           -
--  getSctnEnd(STRING)               ARRAY
--  init()                           -
--  init(FORM)                       -
--  initialiseSnipes(DBREF)          -
--  justSctn()                       -
--  mdsEditSpSctn()                  -
--  modPad()                         -
--  moveFeedBack()                   -
--  moveSctn(STRING)                 -
--  reconn()                         -
--  rotate(STRING,REAL)              -
--  sctnSpref()                      -
--  setAxes()                        -
--  setBang(DBREF)                   -
--  setExtent(REAL)                  -
--  snipe()                          -
--  tagStart(REAL)                   -
--  zDistId()                        -
--

-- Kill existing form definition

kill !!mdsEditSpSctn

setup form !!mdsEditSpSctn noquit

  !!mdsEditSpSctn.formtitle    = |Modify Section|
  !!mdsEditSpSctn.icontitle   =  |Mod sctn|
  !!mdsEditSpSctn.callback     = |!!mdsEditSpSctn.init()|
  !!mdsEditSpSctn.formrevision = ||

  button .ce  | CE |  at x.1 y.1 call |!this.init()|
  para .tag at xmax+2 ymin text |Name:|
  para .name at xmax+1 ymin width 30 lines 1


  frame .increment |Increment| at xmin form +1  ymax width 20
    path down
-- <kp>feb07 obsolete syntax "radio" removed
    rtoggle .fine     at xmin+1 Ymax+0.1      'Fine    ' call |!this.setExtent(!this.fineValue.val)|
    rtoggle .medium   at ymax-.1 'Medium  ' call |!this.setExtent(!this.mediumValue.val)|
    rtoggle .coarse   at ymax-.1 'Coarse  ' call |!this.setExtent(!this.coarseValue.val)|
    rtoggle .default  at ymax-.1 'Default ' call |!this.setExtent(!this.defaultValue.val)|

    text .fineValue    at xmax+.5 ymin.fine call |!this.setExtent(!this.fineValue.val)| width 3 is REAL
    para .fineValuePer at xmax ymin text |%|
    text .mediumValue  at xmin.fineValue ymin.medium call |!this.setExtent(!this.mediumValue.val)| width 3 is REAL
    para .mediumValuePer at xmax ymin text |%|
    text .coarseValue  at xmin.fineValue ymin.coarse call |!this.setExtent(!this.coarseValue.val)| width 3 is REAL
    para .coarseValuePer at xmax ymin text |%|
    text .defaultValue at xmin.fineValue ymin.default call |!this.setExtent(!this.defaultValue.val)| width 3 is REAL
    para .defaultValuePer at xmax ymin text |%|
  exit


  frame .move |Move         | at xmax.increment+2  ymin width 19
    button .moveN |N| at xmin.move+6.2   ymax  tooltip 'Move North'  pixmap width 24 height 24 call |!this.moveSctn('N')|
    button .moveU |U| at xmax+2  ymin tooltip 'Move Up'     pixmap width 16 height 16 call |!this.moveSctn('U')|
    button .moveE |E| at xmax.move-.75   ymin.moveN tooltip 'Move East'   pixmap width 24 height 24 call |!this.moveSctn('E')|

    frame .frex |Extend| at xmin.move+1 ymin.moveN+1.5 width 20
      button .extends  at x1 ymax tooltip  |Extend Start| pixmap width 24 height 24 call |!this.extend('START','')|
      button .shortens  at xmax ymin tooltip |Shorten Start| pixmap width 24 height 24 call |!this.extend('START','-')|
      text .value at xmax+.25 ymin+.15 call |!this.moveFeedBack()| width 6 is REAL format !!distanceFmt
      button .shortene  at  xmin.moveE ymin-.25 tooltip  |Shorten End| pixmap width 24 height 24 call |!this.extend('END','-')|
      button .extende  at xmax ymin   tooltip  |Extend End| pixmap width 24 height 24 call |!this.extend('END','')|
    exit

    button .moveW |W| at xmin.moveN  ymax.4  tooltip 'Move West'   pixmap width 24 height 24 call |!this.moveSctn('W')|
    button .moveD |D| at xmin.moveU  ymin     tooltip 'Move Down' pixmap width 16 height 16 call |!this.moveSctn('D')|
    button .moveS |S| at xmin.moveE  ymin     tooltip 'Move South'  pixmap width 24 height 24 call |!this.moveSctn('S')|

    path right
    hdist 0

-- <kp>feb07 obsolete syntax "radio" removed
      rtoggle .by at x1 ymax+.5 'By '
      rtoggle .in 'Inf '
      rtoggle .th 'Thro '
      rtoggle .be 'Beh '

    path right

-- <kp>feb07 obsolete syntax "radio" removed
      rtoggle .local at x1 ymax+.5 call |!this.setAxes()| 'Local '
      rtoggle .world call |!this.setAxes()| 'World '

  exit

  frame .bangle |Bangle| at xmin.increment  ymax.increment+.5 width 20
    button .rotminus  at x.5 ymax tooltip  |Rotate -| pixmap width 16 height 16 call |!this.rotate('-',!this.rotValue.val)|
    text .rotValue at xmax+.5 ymin+.15 tooltip '0 to 180' call |!this.checkrotvalue(!this.rotValue.val)| width 6 is REAL
    button .rotplus  at xmax+.5 ymin-.15  tooltip  |Rotate +| pixmap width 16 height 16 call |!this.rotate('+',!this.rotValue.val)|
  exit

--<GE> 31/01/07 Fix for HPD0034311
  button .modSctn  at x1 ymax+.5 tooltip 'Modify Section Explicit' pixmap width 18 height 18 Call |Call !!mdsPosse(!this.callingForm)|
--<GE> 31/01/07
  button .flip  at xmax+.5 ymin tooltip 'Flip' pixmap width 18 height 18 Call |!this.flip()|
  button .just  at xmax+.5 ymin tooltip 'Modify Section Justification' pixmap width 18 height 18 Call |!this.justSctn()|
  button .spref  at xmax+.5 ymin tooltip 'Modify Section Size' pixmap width 18 height 18 Call |!this.sctnSpref()|
   button .snipesctn at xmax+.5 ymin tooltip 'Snipe Section' pixmap width 18 height 18 Call |!this.snipe()|
  button .reconrecalc  at x1 ymax+.25 tooltip 'Realign Support' pixmap width 18 height 18 Call |!this.reconn()|
  button .snodzdist  at xmax+.5 ymin tooltip 'Align Node' pixmap width 18 height 18 Call |!this.zDistId()|
  button .addPad  at xmax+.5 ymin tooltip 'Add Pad' pixmap width 18 height 18 Call |!this.addPad()|
  button .delPad  at xmax+.5 ymin tooltip 'Delete Pad' pixmap width 18 height 18 Call |!this.delPad()|
  button .modPad at xmax+.5 ymin tooltip 'Modify Pad Size' pixmap width 18 height 18 Call |!this.modPad()|

  button .cancel  | Dismiss | at xmax form-size ymin+.75 call |!this.cancel()| OK

  -- Setup form members
  member .sctn is DBREF
  member .extent is REAL
  member .axes is DBREF
  member .callingForm is FORM

-- End form definition
exit

--
-- Form Methods are Defined below:
--
-----------------------------------------------------------------------------------------------------
define method .mdsEditSpSctn()
-----------------------------------------------------------------------------------------------------
-- Initialise pixmaps, use ENU pixmaps if not in marine, otherwise use XYZ

  -- Setup pixmap pointers
  !this.extends.addpixmap(!!pml.getPathName('extendsections24.png'))
  !this.shortens.addpixmap(!!pml.getPathName('shortensections24.png'))
  !this.extende.addpixmap(!!pml.getPathName('extendsection24.png'))
  !this.shortene.addpixmap(!!pml.getPathName('shortensection24.png'))
  !this.rotminus.addpixmap(!!pml.getPathName('rotateright16.png'))
  !this.rotplus.addpixmap(!!pml.getPathName('rotateleft16.png'))

  !mod = !!module()
  if (!mod.modkey neq 'marodes') then
  	!this.moveD.addpixmap(!!pml.getPathName('moved24.png'))
    !this.moveU.addpixmap(!!pml.getPathName('moveu24.png'))
    !this.moveE.addpixmap(!!pml.getPathName('movee24.png'))
    !this.moveN.addpixmap(!!pml.getPathName('moven24.png'))
    !this.moveS.addpixmap(!!pml.getPathName('moves24.png'))
    !this.moveW.addpixmap(!!pml.getPathName('movew24.png'))
  else
  	!this.moveD.addpixmap(!!pml.getPathName('movenegz24.png'))
    !this.moveU.addpixmap(!!pml.getPathName('movez24.png'))
  	!this.moveE.addpixmap(!!pml.getPathName('movex24.png'))
    !this.moveN.addpixmap(!!pml.getPathName('movey24.png'))
    !this.moveS.addpixmap(!!pml.getPathName('movenegy24.png'))
    !this.moveW.addpixmap(!!pml.getPathName('movenegx24.png'))

    !this.moveD.settooltip('Move -Z')
    !this.moveU.settooltip('Move Z')
  	!this.moveE.settooltip('Move X')
    !this.moveN.settooltip('Move Y')
    !this.moveS.settooltip('Move -Y')
    !this.moveW.settooltip('Move -X')
  endif

  !this.modSctn.addpixmap(!!pml.getPathName('modsctn24.png'))
  !this.flip.addpixmap(!!pml.getPathName('flip24.png'))
  !this.just.addpixmap(!!pml.getPathName('just24.png'))
  !this.spref.addpixmap(!!pml.getPathName('modsctnspref24.png'))
  !this.reconrecalc.addpixmap(!!pml.getPathName('reconrecalc24.png'))
  !this.snodzdist.addpixmap(!!pml.getPathName('snodzdist24.png'))
  !this.addPad.addpixmap(!!pml.getPathName('addplate24.png'))
  !this.delPad.addpixmap(!!pml.getPathName('delplate24.png'))
  !this.snipesctn.addpixmap(!!pml.getPathName('snipemember24.png'))
  !this.modPad.addpixmap(!!pml.getPathName('modpad24.png'))
  !this.default.val = TRUE
  !this.extent = 100

endmethod
-----------------------------------------------------------------------------------------------------
define method .init(!form is FORM)
-----------------------------------------------------------------------------------------------------
-- If the form is already displayed then tell the user to use the CE button

  if (!this.shown()) then
    hide !!mdsEditSpSctn
  endif
-- Does any steelwork exists yet

  !this.callingForm = !form
  !stru = !form.support.stru.name
  !sctns = ARRAY()

  var !sctns coll all sctn for $!stru

  if (!sctns.empty()) then
    !!alert.error('Unable to modify a section as none have been created')
    return
  endif

-- Check if standard can be modified by this icon

  !stdType = !form.support.type
  !editable = :MDSEdit of /MDS/FRAMES/$!stdType
  handle ANY
      !editable = :MDSEdit of /MDS/FRAMES/$!stdType-HORI
    handle ANY
      !editable = TRUE
        endhandle
    endhandle

  if (!editable.not()) then
    !!alert.error('This standard may not be modified from the standard configuration and dimensions by modifying a section')
    return
  endif

-- Identify support steelwork member but if only one exists go straight to it

  var !listOfSctns coll all sctn for $!stru
  !noOfSctns = !listOfSctns.size()

  if (!noOfSctns.gt(1)) then

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify steelwork member to modify the position of the start or end|
    ID SCTN @
      handle (61,528)
        return
      endhandle
    prompt dismiss
    prompt on
-- Can only modify the section if we can write to it

    if (!!mdsComClaimDac(!!ce,'DACMOD','POS').not()) then
      !!alert.error('Unable to modify the identified section as write access is not available')
      return
    endif

 -- Does it belong to the support

    !supportStru = !form.support.stru
    !idStru = STRU

    if (!supportStru.name eq !idStru.name) then
      if (!form.name().upcase().eq('MDSSPECIAL')) then
        show !!mdsEditSpSctn
      else
        if (!!alert.confirm('If you modify a section with this option, the change will NOT be reflected in any modification of the support. The dimensions on the form will NOT be updated! SHOULD THIS SUPPORT BE A SPECIAL?. Do you want to continue?').eq('YES')) then
        show !!mdsEditSpSctn
        else
          return
        endif
      endif
    else
      return error 1 |Identified steelwork member does not belong to support $!form.name|
    endif

  else

    sctn 1 of frmw 1 of $!form.support.stru

    if (!form.name().upcase().eq('MDSSPECIAL')) then
         show !!mdsEditSpSctn

    else
      if (!!alert.confirm('If you modify a section with this option, the change will NOT be reflected in any modification of the support. The dimensions on the form will NOT be updated! SHOULD THIS SUPPORT BE A SPECIAL?. Do you want to continue?').eq('YES')) then
        show !!mdsEditSpSctn
      endif
    endif

  endif

-- Turn on aid text, locally by default

  !this.axes = !this.sctn
  !this.world.val = TRUE
  !this.setAxes()
  !this.tagStart(1)

endmethod


-----------------------------------------------------------------------------------------------------
define method .init()
-----------------------------------------------------------------------------------------------------

  --!supportStru = !!mdsSpecial.support.stru

  !supportStru = !this.callingForm.support.stru
  !idStru = STRU
    handle ANY
      !!alert.error('Unable to access support from this level')
      return
    endhandle

  if (!supportStru.name eq !idStru.name) then
 -- Does it belong to the support
    !this.sctn = !!ce
    if (!!ce.type neq 'SCTN' ) then
      return error 1 |You must be at a Support Sctn to use this functionality.|
    endif
  else
    return error 1 |Identified steelwork member does not belong to support $!!mdsSpecial.name|
  endif


  -- Set default values on the form first time shown, otherwise leave them
  !this.name.val = !this.sctn.name
  if (!this.value.val.unset()) then
    !this.value.val = 0
  endif
  if (!this.rotValue.val.unset()) then
    !this.rotValue.val = (90)
  endif
  if (!this.fineValue.val.unset()) then
    !this.fineValue.val = 1
  endif
  if (!this.mediumValue.val.unset()) then
    !this.mediumValue.val = 5
  endif
  if (!this.coarseValue.val.unset()) then
    !this.coarseValue.val = 50
  endif
  !this.defaultValue.val = 100
  !this.defaultValue.seteditable(FALSE)
  !this.default.val = TRUE


  hide !!mdsCopyFraSctn
    handle ANY
    endhandle

-- Turn on aid text, locally by default

  !this.axes = !this.sctn
  !this.world.val = TRUE
  !this.setAxes()
  !this.tagStart(1)

  !ce = !!ce
  var !a coll all pnod for $!supportStru
  do !i from 1 to !a.size()
    !!ce = $!a[$!i]
    var !rule rule
    if (!rule.match('NPOS Dynamic Rule ( ATTRIB POSS OF').gt(0)) then
      !end = 'POSS'
      !cutb = cutb of 1
      if !cutb.gt(0) then
        !sign = '-'
      else
        !sign = '+'
      endif
      !sctn = cref of 1
      handle any
        --no pjoi...do nothing
      elsehandle none
        rule set npos dynam (e(comp e of $!end of $!sctn wrt $!sctn) n(comp n of $!end of $!sctn wrt $!sctn) u(comp u of $!end of $!sctn wrt $!sctn $!sign cutb of 1) wrt $!sctn)
      endhandle
    elseif (!rule.match('NPOS Dynamic Rule ( ATTRIB POSE OF').gt(0)) then
      !cutb = cutb of 1
      if !cutb.gt(0) then
        !sign = '+'
      else
        !sign = '-'
      endif
      !end = 'POSE'
      !sctn = cref of 1
      handle any
        --no pjoi...do nothing
      elsehandle none
        rule set npos dynam (e(comp e of $!end of $!sctn wrt $!sctn) n(comp n of $!end of $!sctn wrt $!sctn) u(comp u of $!end of $!sctn wrt $!sctn $!sign cutb of 1) wrt $!sctn)
      endhandle
    endif
  enddo
  !!ce = !ce

  !this.initialiseSnipes(!this.sctn)

endmethod


-----------------------------------------------------------------------------------------------------
define method .extend(!endType is STRING, !plusOrMinus is STRING )
-----------------------------------------------------------------------------------------------------

  !!ce = !this.sctn

  !extent = !this.extent
  !value = (!this.value.val * ( $!extent / 100 ))

  if (!this.by.val) then
    extend $!endType $!plusOrMinus$!value recalculate
  elseif (!this.in.val) then
    extend $!endType inf id @ recalculate
      handle (61,528)
      endhandle
  elseif (!this.be.val) then
    extend $!endType beh id @ recalculate
      handle (61,528)
      endhandle
  else
    extend $!endType thro id @ recalculate
      handle (61,528)
      endhandle
  endif

-- In case any static rules are present for snod positions reexecute them

  !!ce = !this.sctn
  var !snod coll all snod for ce
  do !rule values !snod
    !!ce = !rule.dbref()
    rule execute all
      handle ANY
      endhandle
    --<wd>19feb2010 - DUN1233 - SCTN types Q3O and Q5O have a 2nd SCTN connected to SJOI 1 of SNOD 1 of !this.sctn
    -- Move the 2nd SCTN automatically to align with the NEW POSITION of SJOI 1 of SNOD 1 of !this.sctn
    !snode = !!ce
    var !sjoi coll all SJOI for $!snode
    do !connect indices !sjoi
      $!sjoi[$!connect]
      if (!!ce.cref.unset()) then
        skip
      else
        -- The CODE below ONLY applies the 2nd SCTN at the SNOD/SJOI nearest the START
        -- of the MAIN SCTN of a Q3O or a Q5O  type
        skip if (!endType.upcase().trim().neq('START'))
        if ((!sjoi[!connect].dbref().cref.type.eq('SCTN'))and (!sjoi[!connect].dbref().cref.function.eq(!this.sctn.function))) then
          -- Valid 2nd SCTN for the current Q3O or Q5O type, so move the 2nd SCTN to be inline with its JOIS ref SJOI
          !!mdsResetPins(1,10)
          !secondSection = !!ce.cref
          !mainZDirection = !this.sctn.zdir.wrt( /* )
          -- Navigate back to the current SNODE
          !!ce = !snode
          pin 10 at $!snode
          pin 10 dir $!mainZDirection
          pin 9 copy pin 10
          pin 9 plane pin 9 thro $!secondSection
          pin 9 dire to pin 10
          var !p9d pin 9 direction wrt /*
          !pin9Direction = !p9d.direction()
          !pin9ToPin10 = !!kStrReal('cons dist pin 9 to pin 10')
          -- Navigate back to the current SJOI and DISCONNECT
          $!sjoi[$!connect]
          DISCONNECT
          -- Navigate to the current "2nd SCTN, MOVE it and the reset the JOIS ref
          !!ce = !secondSection
          move along $!pin9Direction distance $!pin9ToPin10
          JOIS $!sjoi[$!connect]
          RECONNECT
          !!mdsResetPins(1,10)
          break
        else
          skip
        endif
      endif
    enddo
    --<wd>19feb2010 - DUN1233 - SCTN types Q3O and Q5O have a 2nd SCTN connected to SJOI 1 of SNOD 1 of !this.sctn
  enddo
  !!ce = !this.sctn

-- Turn on aid text

  !this.tagStart(1)

endmethod


-----------------------------------------------------------------------------------------------------
define method .setExtent(!extType is REAL )
-----------------------------------------------------------------------------------------------------

  !this.extent = !extType

  !this.moveFeedBack()

endmethod

define method .moveFeedBack()

-- Modify the tag of the frame to feedback to the user the movement being used

  !movement = !this.value.val / 100 * !this.extent
  if (!this.value.val.lt(0)) then
    -- we only move in positive values
    !this.value.val = !this.value.val * -1
    !movement = !movement * -1
  endif

  !this.move.tag = 'Move ($!movement)'


endmethod


-----------------------------------------------------------------------------------------------------
define method .checkrotvalue(!rotValue is REAL )
-----------------------------------------------------------------------------------------------------

  if (!rotValue lt 0 or !rotValue gt 180 ) then
    !this.rotValue.val = 0
    return error 1 |Value must be in the range 0 to 180|
  endif

endmethod


-----------------------------------------------------------------------------------------------------
define method .rotate(!plusOrMinus is STRING, !rotValue is REAL)
-----------------------------------------------------------------------------------------------------

  !!ce = !this.sctn

-- Get current Bangle
  !bangle = !!ce.bangle

  !newBangle = ( !bangle $!plusOrMinus !rotValue )
  if (!newBangle.gt(180)) then
     !newBangle = -180 + !newBangle - 180
  elseif (!newBangle.lt(-180)) then
     !newBangle = 180 - abs(!newBangle + 180)
  endif


  BANG $!newBangle
-- Section may have joints on the end, we must rotate these too
      !!ce = !this.sctn
      goto jois
        handle NONE
    if (!!ce.gtyp.eq('APAD')) then
             !this.setBang(!!ce)
          else
             !bangle = !!ce.bangle
             !newBangle = ( !bangle $!plusOrMinus !rotValue )
             BANG $!newBangle
               handle ANY
               elsehandle NONE
-- We need to test if na dir of the section has the same direction as the p1 of joint
-- This is caused by the opdi being different, if so we need to reverse the sign of the
-- beta angle
                 !!ce = !this.sctn
                 var !nadir ppline na dir wrt /*
                 same
                 do !loopThroughBangle from -180 to 180
                   bangle $!loopThroughBangle
                   var !p1dir p1 dir wrt /*
          if (!nadir.eq(!p1dir)) then
                     break
                   endif
                 enddo
               endhandle
          endif
        elsehandle ANY
        endhandle
      !!ce = !this.sctn
      goto joie
        handle NONE
    if (!!ce.gtyp.eq('APAD')) then
              !this.setBang(!!ce)
           else
                !bangle = !!ce.bangle
                !newBangle = ( !bangle $!plusOrMinus !rotValue )
                BANG $!newBangle
                  handle ANY
                  elsehandle NONE
-- We need to test if na dir of the section has the same direction as the p1 of joint
-- This is caused by the opdi being different, if so we need to reverse the sign of the
-- beta angle
                    !!ce = !this.sctn
                    var !nadir ppline na dir wrt /*
                    same
                    do !loopThroughBangle from -180 to 180
                      bangle $!loopThroughBangle
                      var !p1dir p1 dir wrt /*
          if (!nadir.eq(!p1dir)) then
                        break
                      endif
                    enddo
                  endhandle
           endif
        elsehandle ANY
        endhandle

endmethod


-----------------------------------------------------------------------------------------------------
define method .moveSctn(!direction is STRING)
-----------------------------------------------------------------------------------------------------

  !!ce = !this.sctn

-- Check to see if the section has a joint/end, if so save the delp

  if (!!ce.jois.badref().not()) then
    !joisDelp = !!ce.jois.delp
  endif

  if (!!ce.joie.badref().not()) then
    !joieDelp = !!ce.joie.delp
  endif

  !extent = !this.extent
  !value = (!this.value.val * ( $!extent / 100 ))

  if (!this.by.val) then
    by $!direction $!value wrt $!this.axes
  elseif (!this.in.val) then
    move $!direction wrt $!this.axes clear 0 inf id @
      handle (61,528)
      endhandle
  elseif (!this.be.val) then
    move $!direction wrt $!this.axes clear 0 beh id @
      handle (61,528)
      endhandle
  else
    move $!direction wrt $!this.axes thro id @
      handle (61,528)
      endhandle
  endif

  --<wd>15feb2010 - DUN1233 - The NEW SCTN Support Types "Q3O" and Q5O" have an additional 2nd SCTN
  -- Also MOVE the 2nd SCTN for the SCTN types "Q3O" and "Q5O"
  -- Store the MAIN SCTN of the SCTN type being MOVED
  !sctn = !!ce
  -- Test and handle ANY for the existence of a 2nd SCTN when the selected type is "Q3O", "Q5O" etc...
  if (!!ce.function.matchwild('Q*O*')) then
    -- Check for Navigate to the 2nd SCTN and MOVE as per the MAIN SCTN
    !mainSection = !!ce
    --    !secondSectionName = !mainSection.name & '-2'
    !secondSection = !mainSection.mem[1].mem[1].cref
    handle ANY
    endhandle
    !!ce = !secondSection
    handle NONE
      if (!this.by.val) then
        by $!direction $!value wrt $!this.axes
      elseif (!this.in.val) then
        move $!direction wrt $!this.axes clear 0 inf id @
        handle (61,528)
        endhandle
      elseif (!this.be.val) then
        move $!direction wrt $!this.axes clear 0 beh id @
        handle (61,528)
        endhandle
      else
        move $!direction wrt $!this.axes thro id @
        handle (61,528)
        endhandle
      endif
    elsehandle ANY
      -- The 2nd SCTN - !secondSectionName.dbref() - DOES NOT EXIST
    endhandle
  endif
  -- Navigate back to the MAIN SCTN of the SCTN type being MOVED
  !!ce = !sctn
  --<wd>15feb2010 - DUN1233 - The NEW SCTN Support Types "Q3_O" and Q5_O" require an additional SCTN
-- Check to see if the section has a joint/end, if so reset the delp

  if (!!ce.jois.badref().not()) then
    goto jois
    !set = !joisDelp.string().before(' WRT')
    delp $!set
    same
  endif

  if (!!ce.joie.badref().not()) then
    goto joie
    !set = !joieDelp.string().before(' WRT')
    delp $!set
    same
  endif

-- Realign the snod of the jois/joie if it exists

  !ce = !!ce
  if (!!ce.jois.badref().not()) then
    goto jois
    end
    zdist thro cref of same
      handle ANY
      endhandle
  endif

  !!ce = !ce

  if (!!ce.joie.badref().not()) then
    goto joie
    end
    zdist thro cref of same
      handle ANY
      endhandle
  endif

  !!ce = !ce

  -- Recalculate should align SCTNS with any SNODS moved
  stru
  reconn recalculate
  handle ANY
  endhandle
  same

-- Turn on aid text

  !this.tagStart(1)

endmethod


-----------------------------------------------------------------------------------------------------
define method .justSctn()
-----------------------------------------------------------------------------------------------------

  !!ce = !this.sctn
  $M /%pdmsui%/DES/STLWRK/FSETPLINE
  $M /%pdmsui%/DES/STLWRK/XSETPLINE $<Section Justification$> JUSL $<SCTN GENSEC$> $<SCTN GENSEC$> NULL $<Identify section.$>

-- Turn on aid text

  !this.tagStart(1)

endmethod

-----------------------------------------------------------------------------------------------------
define method .sctnSpref()
-----------------------------------------------------------------------------------------------------

  !!ce = !this.sctn

-- Cannot modify the section if it contains fitting for hangers

  !members = mcount
  if (!members.gt(0)) then
  	var !fittColl coll all fitt for ce
  	var !crefColl eval typ of cref for all from !fittColl
  	do !index values !crefColl
          if (!index.eq('HANG')) then
        !!alert.error('Unable to modify the steelwork size because the section is connected to one or more MDS hangers')
        return
      endif
    enddo
  endif

 -- If it's FRAMATONE show FRAMATONE form

 /MDS/FRA/STEELWORK
   handle ANY
-- Else show main steel application form
     $m /%pdmsui%/DES/STLWRK/FSTLSPEC
     $m /%pdmsui%/DES/STLWRK/FSTLSPECD
     $m /%pdmsui%/DES/STLWRK/FSTLPLOT
     $m /%pdmsui%/DES/STLWRK/XSTLSPEC
   elsehandle NONE
    if (!!mdsSpecial.type.eq('MULTI') or !!mdsSpecial.type.eq('HVAC')) then
       !!mdsCopyFraSctn.init(|MODIFY|,!this.sctn)
     else
-- Else show main steel application form
       $m /%pdmsui%/DES/STLWRK/FSTLSPEC
       $m /%pdmsui%/DES/STLWRK/FSTLSPECD
       $m /%pdmsui%/DES/STLWRK/FSTLPLOT
       $m /%pdmsui%/DES/STLWRK/XSTLSPEC
     endif
   endhandle


endmethod

-----------------------------------------------------------------------------------------------------
define method .tagStart(!option is REAL)
-----------------------------------------------------------------------------------------------------
-- Option 0 is remove
-- option 1 is add/reposition

  !!ce = !this.sctn

-- Update the Graphical Aid Text num 2870

  if (!option.eq(0)) then
    -- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 2870
    aid clear arrow 2870
    handle ANY
    endhandle
    aid clear text 2870
    handle ANY
    endhandle
  else
    aid clear arrow 2870
      handle ANY
      endhandle
    aid clear text 2870
      handle ANY
      endhandle
    !posstart = !!ce.poss
    !xdir = x wrt $!this.axes
    !ydir = y wrt $!this.axes
    !zdir = z wrt $!this.axes
    !arrow = object ARROW()
    !arrow.ratio = .1
    !arrow.length = 200mm
    !arrow.dir = !xdir
    !arrow.pos = !posstart
    !!drawAidArrow(2870,!arrow)
    !arrow.dir = !ydir
    !!drawAidArrow(2870,!arrow)
    !arrow.dir = !zdir
    !!drawAidArrow(2870,!arrow)
    !tagX = object POINTVECTOR()
    !tagX.position = !posstart
    !tagX.direction = !xdir
    !tagXPos = !tagX.line(200mm)
    !tagY = object POINTVECTOR()
    !tagY.position = !posstart
    !tagY.direction = !ydir
    !tagYPos = !tagY.line(200mm)
    !tagZ = object POINTVECTOR()
    !tagZ.position = !posstart
    !tagZ.direction = !zdir
    !tagZPos = !tagZ.line(200mm)

-- Add text aids

    if (!this.axes.name.eq('/*')) then
      !!drawAidText('Start',!posstart,2870)
      !!drawAidText('East (World)',!tagXPos.endposition,2870)
      !!drawAidText('North (World)',!tagYPos.endposition,2870)
      !!drawAidText('Up (World)',!tagZPos.endposition,2870)
    else
      !!drawAidText('Start',!posstart,2870)
      !!drawAidText('East (Local)',!tagXPos.endposition,2870)
      !!drawAidText('North (Local)',!tagYPos.endposition,2870)
      !!drawAidText('Up (Local)',!tagZPos.endposition,2870)
    endif
  endif

endmethod

-----------------------------------------------------------------------------------------------------
define method .cancel()
-----------------------------------------------------------------------------------------------------

-- Remove aid text

  !this.tagStart(0)

endmethod

-----------------------------------------------------------------------------------------------------
define method .setAxes()
-----------------------------------------------------------------------------------------------------

  if (!this.local.val) then
    !this.axes = !this.sctn
  else
    !this.axes = world
  endif

-- Reset aid text

  !this.tagStart(1)

endmethod

-----------------------------------------------------------------------------------------------------
define method .reconn()
-----------------------------------------------------------------------------------------------------

  !!ce = !this.callingForm.support.stru

  reconn recalculate
  handle ANY
  endhandle

  same

endmethod


-----------------------------------------------------------------------------------------------------
define method .zDistId()
-----------------------------------------------------------------------------------------------------
    !oriCE = !!ce

    -- turn off SCTN aid because its confusing
    !this.tagStart(0)

    !!ce = !oriCE

  if (!!ce.type.neq(|SNOD|)) then

      PROMPT OFF
      PROMPT LOAD ESCAPE |Identify SNOD to align|
      ID SNOD @
        handle (61,528)
          -- Turn back on
          !this.tagStart(1)
          return
        endhandle
      prompt dismiss
      prompt on

    endif

-- Can only modify the section if we can write to it

  if (!!mdsComClaimDac(!!ce,'DACMOD','POS').not()) then
      !!alert.error('Unable to modify the identified SNOD as write access is not available')
      return
    endif

 -- Does it belong to the support
    !snod = !!ce
    !supportStru = !!mdsSpecial.support.stru
    !idStru = STRU

  if (!supportStru.name neq !idStru.name) then
      return error 1 |Identified SNOD does not belong to support $!!mdsSpecial.name|
    endif

    !zdist = !!ce.zdist

    -- Turn of aid for SNOD
    !!ce = !snod
    !pos = !!ce.pos.wrt(world)

    -- Turn on aids for SNOD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 2871 ZDIST=$!zdist  $<$!pos$>
    !xdir = x
    !ydir = y
    !zdir = z
    !arrow = object ARROW()
    !arrow.ratio = .1
    !arrow.length = 200mm
    !arrow.dir = !xdir
    !arrow.pos = !pos
    !!drawAidArrow(2871,!arrow)
    !arrow.dir = !ydir
    !!drawAidArrow(2871,!arrow)
    !arrow.dir = !zdir
    !!drawAidArrow(2871,!arrow)

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify Element to align SNOD with|

    -- position SNOD

    ZDIST thro ID@
    handle (61,528)
      -- User used Escape button
    elsehandle NONE
      !!ce = !snod
      !newPos = !!ce.pos.wrt(world)
      !newZDist = ZDIST
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 2871 ZDIST=$!newZDist  $<$!newPos$>
      aid clear arrow 2871
      handle ANY
      endhandle

      !arrow.pos = !newPos
      !!drawAidArrow(2871,!arrow)
      !arrow.dir = !ydir
      !!drawAidArrow(2871,!arrow)
      !arrow.dir = !zdir
      !!drawAidArrow(2871,!arrow)

    if (!!alert.confirm('Do you want to Accept new position?').eq('NO')) then
        ZDIST $!zdist
      endif


    endhandle
    prompt dismiss
    prompt on

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 2871

     -- Switch off local aid arrow
     aid clear arrow 2871
     handle ANY
     endhandle

    -- Turn back on Sctn aid arrow
    !this.tagStart(1)

    !!ce = !oriCE
endmethod

-----------------------------------------------------------------------------------------------------
--define method .flip()
-----------------------------------------------------------------------------------------------------
define method .flip()

  !!ce = !this.sctn
  if (!!ce.func.match('Q3M').eq(1) or !!ce.func.match('Q4').eq(1)) then
    !!alert.error('Unable to flip selected section')
    return
  elseif (!!ce.func.match('Q3').eq(1)) then
    return

  endif

  !jois = jois
  !joie = joie

  --<RM> 30/08/11 if this is an auto pad joint then we must remove the rules from the joint and node so that evaluation problems do not arise from a lack of connection ref
  --the rule sets are re-initialised anyway during the execute phase of this function - start
  !curr = !!ce
  !!ce = !joie.owne
  handle ANY
  elsehandle NONE
    !gtypJoie = !joie.gtyp
    handle ANY
      !gtypJoie = ''
    endhandle
    if (!gtypJoie.eq('APAD')) then
      rule delete all
      !!ce = !joie
      rule delete all
    endif
  endhandle
  !!ce = !jois.owne
  handle ANY
  elsehandle NONE
    !gtypJois = !jois.gtyp
    handle ANY
      !gtypJois = ''
    endhandle
    if (!gtypJois.eq('APAD')) then
      rule delete all
      !!ce = !jois
      rule delete all
    endif
  endhandle
  !!ce = !curr
  --<RM> 30/08/11 if this is an auto pad joint then we must remove the rules from the joint and node so that evaluation problems do not arise from a lack of connection ref
  --the rule sets are re-initialised anyway during the execute phase of this function - start

  flip

  !jois = jois
  !joie = joie
  if (!jois.badref().not()) then
    if (!jois.gtyp.eq('APAD')) then
        !!ce = !jois.owne
        rule set npos dynam (e(comp e of POSS of cref of 1 wrt cref of 1) n(comp n of POSS of cref of 1 wrt cref of 1) u(comp u of POSS of cref of 1 wrt cref of 1 - cutb of 1) wrt cref of 1)
        !!ce = !jois
        rule set cutp dynam (drns of cref)
        rule set opdi dynam (drns of cref)
     else
        --!!ce = !jois
        --reconnect recalculate
     endif

     !this.setBang(!jois)

  endif


  if (!joie.badref().not()) then
    if (!joie.gtyp.eq('APAD')) then
        !!ce = !joie.owne
        rule set npos dynam (e(comp e of POSE of cref of 1 wrt cref of 1) n(comp n of POSE of cref of 1 wrt cref of 1) u(comp u of POSE of cref of 1 wrt cref of 1 + cutb of 1) wrt cref of 1)
        !!ce = !joie
        rule set cutp dynam (drne of cref)
        rule set opdi dynam (drne of cref)
     else
        --!!ce = !joie
        --reconnect recalculate
     endif

     !this.setBang(!joie)

  endif

-- update aid graphic

     !this.setAxes()

  !!ce = !this.sctn

endmethod
-----------------------------------------------------------------------------------------------------


-----------------------------------------------------------------------------------------------------
--define method .addPad()
-----------------------------------------------------------------------------------------------------
define method .addPad()

  --set units as mm
  !currentUnits = !!kgetsetunits()

  prompt off
    prompt load escape |Identify End of SCTN to add the pad to.|

label /nosctn
    var !idSctn pick
      handle (61,528)
        prompt on
    !!kRestoreUnits(!currentUnits)
        return
      endhandle
  if (!idSctn[1].dbref().type.neq('SCTN')) then
      golabel /nosctn
    endif

    -- check to see if current sctn identified

    prompt dismiss
    prompt on

-- Find out which end of the sctn was identified
    !!ce = !idSctn[1].dbref()
    !posText = !idSctn[2].after('Through')
--<<wd>04feb2009 - DFN - P-15438 (SI-6596)
--    !position = $!posText wrt /*
    !position = !posText.position().wrt(/* )
--<<wd>04feb2009 - DFN - P-15438 (SI-6596)

    !dirText = !idSctn[2].after('Line').before('Through')
--><wd>04feb2009 - DFN - P-15438 (SI-6596)
--    !direction = $!dirText
    !direction = !dirText.direction().wrt(/* )
--<<wd>04feb2009 - DFN - P-15438 (SI-6596)

-- create a vector along the line of the pick
    !vector = object POINTVECTOR()
    !vector.position = !position
    !vector.direction = !direction
-- create a line along the length of the idSctn
    !pidSctn = object LINE()
    !pidSctn.startPosition = !idSctn[1].dbref().poss.wrt(/* )
    !pidSctn.endposition   = !idSctn[1].dbref().pose.wrt(/* )
-- find the intersection point of the vector and the idSctn
    !intersection = !vector.intersection(!pidSctn)
-- get the position of the intersection on the idSctn
    !prop = !pidSctn.near(!intersection)
-- calculate the distance of the intersection from the poss of the idSctn
    !startDist = !pidSctn.startPosition.distance(!prop)
-- if the distance from the start of the idSctn is gt half the length its the end
  if (!startDist.gt(0.5 * !pidSctn.length())) then
      !end = 'END'
      !endPos = 'POSE'
      !endDir = 'DRNE'
      !sign = '+'
    else
      !end = 'START'
      !endPos = 'POSS'
      !endDir = 'DRNS'
      !sign  = '-'
    endif

    !size = !!ce.para[1]
    !para2 = !!ce.para[2]
    !para3 = !!ce.para[3]
    !para4 = !!ce.para[4]

    !root = '/MDS-Internal_Joints-Spec/'

    -- choose the spref of the pad (i.e. shape for different section types)
    -- and choose design parameters
  if (!!ce.catr.gtyp.eq('ANG')) then
      --use generic ANG spref (with despars)
    !spref = $!<root>End_pad_for_Angle

    if (!size.leq(30)) then
        !desp1 = 50
        !desp2 = 8
        !desp3 = 11
        --!spref = $!<root>50x8
    elseif (  !size.leq(40)) then
        !desp1 = 60
        !desp2 = 8
        !desp3 = 10
        --!spref = $!<root>60x8
    elseif (  !size.leq(50)) then
        !desp1 = 70
        !desp2 = 8
        !desp3 = 10
        --!spref = $!<root>70x8
    elseif (  !size.leq(65)) then
        !desp1 = 90
        !desp2 = 8
        !desp3 = 12.5
        --!spref = $!<root>90x8
    elseif (  !size.leq(75)) then
        !desp1 = 100
        !desp2 = 10
        !desp3 = 12.5
        --!spref = $!<root>100x10
    elseif (  !size.leq(90)) then
        !desp1 = 120
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>120x10
    elseif (  !size.leq(100)) then
        !desp1 = 130
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>130x10
    elseif (  !size.leq(130)) then
        !desp1 = 160
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>160x10
    elseif (  !size.leq(150)) then
        !desp1 = 180
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>180x10
    elseif (  !size.leq(200)) then
        !desp1 = 230
        !desp2 = 15
        !desp3 = 20
      else
        --!!alert.error('Section size is too big for pad!')
      !!kRestoreUnits(!currentUnits)
        return
      endif

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3
  elseif (!!ce.catr.gtyp.eq('DINU') OR !!ce.catr.gtyp.eq('BSC')) then

    if (!endDir.eq('DRNS')) then
      !spref = $!<root>End_pad_for_Channel
        !desp1 = !para2 + 40
        !desp2 = 10
        !desp3 = 25
        !desp4 = !size + 40

      else
      !spref = $!<root>End_pad_for_Channel_D
        !desp1 = !para2 + 30
        !desp2 = 10
        !desp3 = 25
        !desp4 = !size + 30
      endif
      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4

  elseif (!!ce.catr.gtyp.eq('FBAR')) then

    !spref = $!<root>End_pad_for_Flatbar
      !desp1 = !size + 20
      !desp2 = 10
      !desp3 = 25
      !desp4 = !para2 * 4

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
  elseif (!!ce.catr.gtyp.eq('BEAM')) then

    !spref = $!<root>End_pad_for_Flatbar
      !desp1 = !size + 20
      !desp2 = 10
      !desp3 = 25
      !desp4 = !size + 20

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
  elseif (!!ce.catr.gtyp.eq('TUBE')) then

    !spref = $!<root>End_pad_for_Tube
      !desp1 = !size + 20
      !desp2 = 10
      !desp3 = 25
      !desp4 = !size + 20

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
    else

      --put one in? or just leave it?
    !spref = $!<root>End_pad_for_Flatbar
      !desp1 = 90
      !desp2 = 14
      !desp3 = 25
      !desp4 = 40

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
    endif

    !sctnName = !!ce.name
    !ce = !!ce
    var !fittColl coll all PJOI with gtyp eq 'APAD' for stru
    do !ii values !fittColl
      $!ii
      end
      var !pnodRule rule
      if (!ii.dbref().cref.eq(!sctnName.dbref()) and match(!pnodRule, '$!endPos') gt 0)  then
      if (!!alert.confirm('Identified SCTN $!end already has a PAD, Do you want it to be recreated?').eq('YES')) then
          $!ii
          rule delete all
          end
          !npos = !!ce.npos
          rule delete all
          delete PNOD
            !!ce = !ce
            extend $!end through $!npos recalculate
         else
        !!kRestoreUnits(!currentUnits)
           return
         endif
      endif
    enddo

    !!ce = !ce
    new PNOD
    handle ANY
    elsehandle NONE
      do !i to 20
        name $!sctnName/pnod$!i
        handle ANY
          skip
        elsehandle NONE
         at $!endPos of prev sctn
         SET
         new pjoi
         Name */pjoi1
         break
        endhandle
      enddo
      --spref /End_Pad_for_Angle_Fitt
      spref $!spref
      gtype APAD
      jlin na
      cref  $!sctnName $!end
      --q var !!ce.rpro.tHKN
      --q desp[3]
      --!!ce.cutb = !!ce.rpro.tHKN
      !!ce.cutb = !desp2
      rule set  cutplane dynamic $!endDir of cref
      rule set  opdir dynamic $!endDir of cref
      rule set  delp dynamic (e 0 n 0 u 0 )
      reconn
      -- set bang of join
      !!mdssetjoinbang(ce)
      --!this.setBang(ce)
      -- set despars
      desp $!despString
      pnod
      --rule set npos dynamic $!endPos of cref of 1
      rule set npos (e(comp e of $!endPos of cref of 1 wrt cref of 1) n(comp n of $!endPos of cref of 1 wrt cref of 1) u(comp u of $!endPos of cref of 1 wrt cref of 1 $!sign cutb of 1) wrt cref of 1)
      rule set npos dynamic

    endhandle

  --reset the units
  !!kRestoreUnits(!currentUnits)

endmethod


--------------------------------------------------------------------------------------------
-- method to set bangle of attached joint
--------------------------------------------------------------------------------------------
define method .setBang(!join is DBREF)

  if (!join.badref()) then
     return
  endif

  !sctn = !join.cref
  if (!join.cend.eq('START')) then
     !endPos = !sctn.poss.wrt(worl)
     !dir = 'Ydir'
  else
     !endPos = !sctn.pose.wrt(worl)
     !dir = 'Xdir().opposite'
  endif

  !plane = object PLANE(!endPos,!sctn.ori.wrt(worl))

  !unusedJoinYdir = !join.ori.$!<dir>().wrt(worl)
  !angle = !sctn.plori.na.zdir().wrt(worl).angle(!join.ori.$!<dir>().wrt(worl).projected(!plane))

  if (!angle.lt(1)) then
     return
  endif

   !bang = !join.bang


   do from 1 to 10
-- to avoid endless loop (it should not happen but to be absolutely sure)\

          !join.cref.bang = !join.cref.bang
          -- first trial
          !newBang = !bang + !angle
    if (!newBang.gt(180)) then
      if (!newBang.gt(181)) then
                  !newBang = -180 + !newBang - 180
               else
                  !newBang = 180
               endif
            endif
          !join.bang = !newBang


--           q var !sctn.plori.na.zdir().wrt(worl).angle(!join.ori.$!<dir>().wrt(worl).projected(!plane))
          if !sctn.plori.na.zdir().wrt(worl).angle(!join.ori.$!<dir>().wrt(worl).projected(!plane)).lt(1) then
--           $p Section bangle = $!sctn.bang
--           $p Joint bangle = $!join.bang
            break
          endif

          -- second trial
          !newBang = !bang - !angle
    if (!newBang.lt(-180)) then
      if (!newBang.lt(-181)) then
                  !newBang = 180 - abs(!newBang + 180)
               else
                  !newBang = -180
               endif
            endif
            !join.bang = !newBang

--             q var !sctn.plori.na.zdir().wrt(worl).angle(!join.ori.$!<dir>().wrt(worl).projected(!plane))

           if !sctn.plori.na.zdir().wrt(worl).angle(!join.ori.$!<dir>().wrt(worl).projected(!plane)).lt(1) then
--           $p Section bangle = $!sctn.bang
--           $p Joint bangle = $!join.bang
               break
           endif
   enddo

   !this.setBang(!join)

endmethod

-- method to delete pad
--------------------------------------------------------------------------------------------
define method .delPad()

  if (!!ce.type.eq('PJOI').or(!!ce.type.eq('SJOI'))) then
      !join = !!ce
   else
      !picked = !this.getSctnEnd('Pick the section end where the pad is connected to')
        handle ANY
           return
        endhandle
    if (!picked[2].eq('START')) then
         !join = !picked[1].jois
      else
         !join = !picked[1].joie
      endif
   endif

  if (!join.badref()) then
      !!alert.error('No pad connected to the picked end of section')
      return
   endif

  if (!join.gtyp.neq('APAD')) then
      !!alert.error('This joint is not a PAD')
      return
   endif

  if (!!alert.confirm('OK to delete PAD?').boolean()) then
      !sctn = !join.cref
      !end = !join.cend
      !!ce = !join.owner
      !npos = !!ce.npos
      rule delete all on all for ce
      delete $!!ce.type
      !!ce = !sctn
      extend $!end through $!npos recalculate

   endif

endmethod

-- method to modify pad size
--------------------------------------------------------------------------------------------
define method .modPad()

  if (!!ce.type.eq('PJOI').or(!!ce.type.eq('SJOI'))) then
      !join = !!ce
   else
      !picked = !this.getSctnEnd('Pick the section end where the pad is connected to')
        handle ANY
           return
        endhandle
    if (!picked[2].eq('START')) then
         !join = !picked[1].jois
      else
         !join = !picked[1].joie
      endif
   endif

  if (!join.badref()) then
      !!alert.error('No pad connected to the picked end of section')
      return
   endif

  if (!join.gtyp.neq('APAD')) then
      !!alert.error('This joint is not a PAD')
      return
   endif

   show !!mdsModPad
   !!mdsModPad.init(!join)

   --if !!alert.confirm('OK to delete PAD?').boolean() then
      --!sctn = !join.cref
      --!end = !join.cend
      --!!ce = !join.owner
      --!npos = !!ce.npos
      --rule delete all on all for ce
      --delete $!!ce.type
      --!!ce = !sctn
      --extend $!end through $!npos recalculate

   --endif

endmethod

-- method to get picked section end (1st component of array) and section ref (2nd comp. of arr.)
--------------------------------------------------------------------------------------------
define method .getSctnEnd(!prompt is STRING) is ARRAY

    !result = ARRAY()

    prompt off

    do
    prompt load escape |$!prompt|
      var !idSctn pick
        handle (61,528)
          prompt on
          return
        endhandle
    break if (!idSctn[1].dbref().type.eq('SCTN'))
    enddo

    prompt on

    !result[1] = !idSctn[1].dbref()

    !position = !idSctn[2].after('Through').position()
    !direction = !idSctn[2].after('Line').before('Through').direction()
    !pickedVector = object POINTVECTOR(!position,!direction)
    !sctnCl = object LINE(!result[1].poss.wrt(worl),!result[1].pose.wrt(worl))
    !halfLeng = !sctnCl.length() * 0.5
    !intersection = !sctnCl.near(!pickedVector.intersection(!sctnCl))

  if (!sctnCl.startPosition.distance(!intersection).lt(!halfLeng)) then
       !result[2] = 'START'
    else
       !result[2] = 'END'
    endif

    return !result

endmethod


-- method to call the snipe sctn form
-------------------------------------
define method .snipe()

  !form = !!mdsSnipe
  handle ANY
    show !!mdsSnipe
  elsehandle NONE
    kill !!mdsSnipe
    show !!mdsSnipe
  endhandle
endmethod

--method to check whether or not a sctn is valid for a snipe
--if not disable the snipe button
define method .initialiseSnipes(!sctn is DBREF)

  --check that the connected sctn is an angle
  !connectedSctn = !sctn.:mdsconn
  if !connectedSctn.set() then
    --check that the sctn has 'RTTA' and 'LBOA' plines
    !pl1 = !connectedSctn.plori.rtta
    handle (2,224)
      !pl1 = object ORIENTATION()
    endhandle
    !pl2 = !connectedSctn.plori.lboa
    handle (2,224)
      !pl2 = object ORIENTATION()
    endhandle

    if !pl1.unset() or !pl2.unset() then
      !this.snipesctn.active = FALSE
    else
      --the connected sctn is an angle so activate the snipe button
      !this.snipesctn.active = TRUE
    endif

  else
    !this.snipesctn.active = FALSE
  endif

endmethod
