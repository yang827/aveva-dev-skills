--
--
-- Description:
-- Form Definition for editing the properties of a vspr
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actionProp(STRING)               -
--  init(REAL)                       -
--

-- Kill existing form definition

kill !!mdsEditVProp

setup form !!mdsEditVProp

  !!mdsEditVProp.formtitle    = |Modify Spring/Constant Travel|
  !!mdsEditVProp.icontitle    = |Mod Vspr Tr|
  --!!mdsEditVProp.callback     = |!!mdsEditVProp.init(99)|
  !!mdsEditVProp.formrevision = ||

  -- Body of Form

  para .tag text | Name: |
  para .name at xmax+2 ymin width 30 lines 1
  path right

  do !createProp from 1 to 1
    para .pProp$!createProp at x1 Ymax text '12345678901234567890123456789012'
    text .prop$!createProp    || call |!!mdsEditVProp.actionProp('$!createProp')| width 14 is REAL format !!distanceFmt
    para .prop$!createProp$nMinMax at x1 ymax text '12345678901234567890123456789012'
  enddo

  -- Bottom Line

  button .cancel  | Dismiss | at xmax form-size ymax+0.5 call || OK

  -- Form Members

  -- data storage for properties

  do !createmem from 1 to 1
    member .prop$!createmem$nMin is REAL
    member .prop$!createmem$nMax is REAL
    member .prop$!createmem$nDpNum is REAL
  enddo

  member .vspr is DBREF
  member .callingForm is FORM
  member .travelGadget is GADGET
  member .hangerNo is REAL

  -- Populate Form Members with Default Callbacks

  --!!mdsEditVProp.actiontravel[1]    = |call !!mdsmodshoe(!!mdsEditVProp,'TRAVEL',!!mdsEditVProp.vspr)|
  --!!mdsEditVProp.actiontravel[2]    = ||

  -- Support object
  member .support     is MDSSUPPORT
  -- Form Storage for support restoration
  member .store       is ARRAY
  -- Extra members for edit button

  -- End form definition

exit


--
-- Form Methods are Defined below:
--
-----------------------------------------------------------------------------------------------------
define method .init(!hangerNo is REAL)
  -----------------------------------------------------------------------------------------------------
  !!mdsEditVProp.hangerNo = !hangerNo
  --!currentunits = !!kgetsetunits()
  mm bore mm dist
  -- Allows the user to change DESP of spring for TRAVEL

  -- Going to the hanger level
  !support = !!mdsfh01.support
  !oRest = !support.rest

  if(!oRest.hangers.size() eq 1 or !oRest.styp inset$!!mdsallhangertypes.dSSpring) then
    -- Only one hanger or a double hanger with one double spring
    if(!hangerNo gt 1) then
      !!alert.error('Hangers have only one spring. Invalid hanger no. $!hangerNo')
      golabel /exit
    endif
    !hangerIndex = 1
    !!ce = !oRest.hangers[!hangerIndex].ref
  elseif (!oRest.hangers.size() eq 2 and !!mdsallhangertypes.m5Constant.findfirst(!oRest.styp).set() ) then
    -- Constant hanger c50 type k
    !hangerIndex = 1
    !!ce = !oRest.hangers[!hangerIndex].ref
    --!!mdsmodfh.modifytrav2.active = FALSE
  else
    -- Double hangers
    -- Index of first hanger in db starts from 2
    !hangerIndex = !hangerNo + 1

    !!ce = !oRest.hangers[!hangerIndex].ref
  endif

  -- goto the spring
  VSPR 1
  handle ANY
    return error 1 |Hanger configuration has no VSpr elements|
  endhandle


  -- kill !!mdsEditVProp
  -- PML RELOAD form !!mdsEditVProp

  !!mdsEditVProp.name.val = | $!!ce.fullname|
  !spring = !!ce
  !!mdsEditVProp.vspr = !!ce
  !dpNum = |1|
  var !whichDesp coll all data with  purp eq 'DESP' and  dkey eq 'TRAV' for dtre
  if !whichDesp.size() gt 0 then
    !dpNum1 = !whichDesp[1].dbref().number
    !!ce = $!spring
    var !despnum despara num $!dpNum1
  else
    -- no data to edit return error
    !!mdsmodfh.modifytrav1.active = FALSE
    !!mdsmodfh.modifytrav2.active = FALSE

    return error 1 |No Travel property to modify|
  endif


  !!mdsEditVProp.travelGadget = !!mdsEditVProp.prop$!dpNum1
  handle ANY
  endhandle

  !!mdsEditVProp.prop1Min = !!ce.catref.:MDSMinHeight.real()
  !!mdsEditVProp.prop1Max = !!ce.catref.:MDSMAXHeight.real()
  !!mdsEditVProp.prop1DpNum = !dpNum1

  !!mdsEditVProp.pProp1.val = 'TRAVEL'
  -- if value already too small ie selected larger spring, reset value to be min of new VSPR
  if (!despnum.real() lt !!mdsEditVProp.prop1Min ) then
    !!mdsEditVProp.prop1.val = !!mdsEditVProp.prop1Min
    -- esleif value already too slarge ie selected smaller spring, reset value to be max of new VSPR
  elseif (!despnum.real() gt !!mdsEditVProp.prop1Max ) then
    !!mdsEditVProp.prop1.val = !!mdsEditVProp.prop1Max
  else
    !!mdsEditVProp.prop1.val = !despnum.real()
  endif
  !!mdsEditVProp.prop1MinMax.val = 'Min travel $!!mdsEditVProp.prop1Min to Max travel  $!!mdsEditVProp.prop1Max'

  show !!mdsEditVProp

  label /exit

endmethod


---------------------------------------------------------------------------------------------------------------
--
--
--
---------------------------------------------------------------------------------------------------------------
define method .actionProp(!prop is STRING)

  -- Goto vspr
  !!ce = !!mdsEditVProp.vspr

  -- Set dpnum to be edited and value to to set

  !dpNum = !!mdsEditVProp.prop$!prop$ndpnum
  !value = !!mdsEditVProp.prop$!prop$n.val

  -- !value is the value typed into the text gadget
  -- if the units are set to finch then the value is in inches
  -- assuming that the property is not going to be a bore size then
  -- we need to manually convert the value

  !units = object COMUNITS(TRUE)

  -- the units variable is FORMATted like this 'INCH Bore FINC Distance'

  if (!!isImperialLength('DIST').not())  then
    units mm dist
    --!value = !value * 25.4
  endif

  -- Check if value exceeds the min/max value.

  !min = !!mdsEditVProp.prop$!prop$nmin
  if !value.lt(!min) then
    !dispValue = !value.string(!!distanceFmt)
    !dispMin = !min.string(!!distanceFmt)
    !!alert.error(|Value of $!dispValue is less than minimum $!dispMin allowed|)
    !desp = despar
    !!mdsEditVProp.prop$!prop$n.val = $!desp[$!dpNum]
    !units.restoreSavedUnitsByPtype('DIST')
    return
  endif

  !max = !!mdsEditVProp.prop$!prop$nmax
  if !value.gt(!max) then
    !dispValue = !value.string(!!distanceFmt)
    !dispMax = !max.string(!!distanceFmt)
    !!alert.error(|Value of $!dispValue is more than maximum $!dispMax allowed|)
    !desp = despar
    !!mdsEditVProp.prop$!prop$n.val = $!desp[$!dpNum]
    !units.restoreSavedUnitsByPtype('DIST')
    return
  endif
  !units.restoreSavedUnitsByPtype('DIST')
  -- Set the despar num  here
  !!ce = !!mdsEditVProp.vspr

  despara num $!dpNum $!!mdsEditVProp.travelGadget.val
  --q desp
  var !p3dir p3 dir
  conn and p3 is $!p3dir
  handle ANY
    fconn
  endhandle
  -- Rebuild hanger


  !!mdsmodfh.modifyspringtype( !!mdsEditVProp.hangerNo , false)

endmethod
