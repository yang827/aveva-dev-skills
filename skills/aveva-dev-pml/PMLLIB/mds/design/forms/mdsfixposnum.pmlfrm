--
--
-- Description:
-- Multi Discipline support form
-- Purpose: To set position numbers for Framatome supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Apply()                          -
--  Clear()                          -
--  ComparePosNum(dbref)             -
--  IsPartOfGroup(dbref)             BOOLEAN
--  dismiss()                        -
--  getposnum(dbref)                 ARRAY
--  init(STRING)                     -
--  select(STRING)                   -
--  selection()                      -
--  storeposnumbers(dbref)           -
--
Kill !!mdsfixposnum

-- Define Form
setup form  !!mdsfixposnum

  title        |Fix Position Numbers|
  icontitle    |Fix PosNo|
  Initcall     |!this.init('CE')|
  revision     | $Revision: 1.00 |


  -- Body of form definition

  -- Bar Menu
  bar
  exit

  -- Body of Form


  button .ce 'CE' at xmin + 0.5 ymax+0.2 call |!this.init('CE')|
  para .cename at xmax +2 ymin text || width 50
  list .componentlist |No.  Qty Support Component Description| at xmin.ce+ 1 ymax+0.2  call |!this.selection()| single  width 50 hei 15
  para .notset at xmin form +1.5 Ymax text '* :- Items with Position No. not yet set in Design'
  button .apply ' Apply ' at xmin.ce ymax form call |!this.Apply()|
  button .Clear ' Reset ' at xmax+3 ymin call |!this.Clear()|
  button .dismiss 'Dismiss'  at xmax form -size ymin call |!this.dismiss()| cancel

  --menu .selmenu
  --!this.selmenu.add('callback','Select all','!this.select(|all|)')
  --!this.selmenu.add('callback','Clear Selections','!this.select(|clear|)')
  --!this.componentlist.setpopup(!this.selmenu)

  member .form is form
  member .stru is dbref
  member .Discipline is STRING
  member .support is dbref
  member .mdsvprmmtoobj is mdsvprmmto
  member .CompAr is ARRAY
  member .PosNumAr is ARRAY
  member .DescAr is ARRAY
  member .StoredCompAr is ARRAY
  member .StoredNameAr is ARRAY
  member .StoredPosNumAr is ARRAY
  member .StoredDescAr is ARRAY
  member .MaxPosNum is real
  member .config is STRING


exit
--------------------------------------------------------------------------------
-- method to go and find the fittings for the current selected sctn and show their connections
define method .init(!Mode is STRING )


  if !mode.neq('CE') then
    !this.discipline = !Mode
  endif
  !DescAr = ARRAY()
  !QtyAr = ARRAY()
  !test = ARRAY()
  !SetInDesign = FALSE


  !SupportName = !!mdsgetsuppname(!!ce)
  -- Always use the Master group support   PS1234[1]
  if !Supportname.matchwild('*[*]') then
    if !Supportname.match('[1]').gt(1) then
    else
      !SupportName = !SupportName.before('[') & '[1]'
    endif
  endif

  !this.cename.val = !SupportName
  !this.Support = !SupportName.dbref()
  handle ANY
    return error 1 |Cannot navigate to support from selected element.|
  endhandle
  !maxposnum = !this.support.:MDSPosNumMax.real()
  !!mdsfixposnum.maxposnum = !maxposnum


$(  -- Get support data from mdsvprmmto object
  !this.mdsvprmmtoobj = object mdsvprmmto(!this.support)
!!dtf =  !this.mdsvprmmtoobj

  !classarray  = !!mdsfragettext(!this.mdsvprmmtoobj,'SC')
  !this.mdsvprmmtoobj.qualityclass = !classarray[1]
  !this.mdsvprmmtoobj.safetyclass  = !classarray[2]


  -- get mdspartlistdata

  !returnarray = !!mdsgetpartlistdata(!this.mdsvprmmtoobj.allmem, !this.mdsvprmmtoobj.safetyclass, !this.mdsvprmmtoobj.support.name)
$)

  !returnarray = !this.getposnum(!this.support)


  !CompAr   = !returnarray[1]
  !AtexAr   = !returnarray[2]
  !PosNumAr = !returnarray[3]

  !this.CompAr   = !returnarray[1]
  !this.PosNumAr = !returnarray[3]
  !this.DescAr   = !returnarray[2]
--Q VAR !POSNUMAR


  if !this.support.:MDSSuppType.eq('MH01') then
     !this.config = !this.support.cref.owner.:USTHCFGKEY.replace('.','').substring(1,4)
  endif

  do !Loop indices !CompAr
   !split = !AtexAr[!loop].split('\')
   !PosNum = !PosNumAr[!loop].string()
   if !PosNum.length().eq(1) then
     !PosNum = !PosNum & ' '
   endif
   !DescString = !PosNum & '   ' & !split[1] & '  ' & !split[2].trim('R')  & ' ' & !split[3].trim('R') & ' ' & !split[4]
--   !DescAr.append(!Descstring)
--   !qtyAr.append(!split[1])
   --if !SetInDesign.not() and !CompAr[!loop].dbref().type.neq('TUBI') then
   if !CompAr[!loop].dbref().type.neq('TUBI') then
     if !CompAr[!loop].dbref().:MDSPosNum.size().neq(0) then
       --!SetInDesign = TRUE
       !test.append(TRUE)
       !DescString = ' ' & !descstring
     else
       !test.append(FALSE)
       !DescString = '*' & !descstring
     endif
   else
--     q var !maxposnum
     if !maxposnum.real().gt(0) then
       !DescString = ' ' & !descstring
     else
       !DescString = '*' & !descstring
     endif
   endif
   !DescAr.append(!Descstring)
   !qtyAr.append(!split[1])
  enddo

  !this.componentlist.dtext = !DescAr
  !this.componentlist.rtext = !CompAr
  if !CompAr.size().eq(1) then $* select it
    !x[1] = 1
    !this.componentlist.val = !x
  endif


  !test.sortunique()
  if !test.size().eq(2) then
     !SetInDesign = FALSE
  elseif !test.size().eq(1) then
     !SetInDesign = !test[1]
  else
     !SetInDesign = FALSE
  endif

  if !SetInDesign.not() then
    !this.apply.active = TRUE
    !this.notset.val =  '* :- Items with Position No. not yet set in Design'
  else
    !this.apply.active = FALSE
    !this.notset.val =  ''
  endif


endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .select(!type is STRING)

 if !type eq 'all' then
    do !a from 1 to !this.supportlist.dtext.size()
      !select[!a] = !a
    enddo
    !this.supportlist.val = !select
 else
    !this.supportlist.clearSelection()
 endif

endmethod
--------------------------------------------------------------------------------

define method .dismiss()



endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .selection()

  -- Navigate to the element in the list
  !element = !this.componentlist.rtext[!this.componentlist.val]
  !!ce = !element.dbref()
  unmark all
  mark ce
endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .Apply()

  !Maxnumused = 0
  !PosNum = ARRAY()
-- Set PosNum for all from list
  do !loop indices !this.CompAr
    !PosNum.clear()
    !extrapara = FALSE
    !!ce = !this.CompAr[!loop].dbref()
    if !this.DescAr[!loop].upcase().match('AUSTENITIC SHIELD').gt(0) then
      !Posnum.append(!!ce.:mdsposnum[1])
      !extrapara = TRUE
    elseif !this.DescAr[!loop].upcase().match('HEXAGON NUT').gt(0) then
      if !!ce.:MDSposnum.unset().not() then
        !Posnum.append(!!ce.:mdsposnum[1])
        !extrapara = TRUE
      endif
    elseif !!ce.spref.name.upcase().match('/MDS-FRA-PNODS-FRP').gt(0) then
      if !!ce.:MDSposnum.unset().not() then
        !Posnum.append(!!ce.:mdsposnum[1])
        !extrapara = TRUE
      endif
    elseif !!ce.type.eq('TUBI') then
-- Threaded Rod. Append the PosNum to prev component
      !Element = !this.CompAr[!loop].after('IL TUB OF ').dbref()
      !!ce = !element
      if !!ce.:mdsposnum.unset().not() then
        !Posnum.append(!!ce.:mdsposnum[1])
        !extrapara = TRUE
      else
-- some elements may not have :MDSPosNum set, so always store Rod in 2nd field
        !posnum.append(0)
        !extrapara = TRUE
      endif
    endif
    !posnum.append(!this.PosNumAr[!loop])
-- mjb >>> 24.02.06 sort unique added to avoid e.g. :Mdsposnum 7 7
    !posnum = !posnum.sortunique()
-- mjb <<< end of mod
    if !!ce.:MDSPosnum.unset() or !extrapara then
      !!ce.:MDSPosNum = !PosNum
    endif

    if !this.PosNumAr[!loop].gt(!Maxnumused) then
     !MaxNumUsed = !this.PosNumAr[!loop]
    endif
  enddo

  if !Maxnumused.gt(!!mdsfixposnum.maxposnum)  then
    !This.support.:mdsposnummax = !Maxnumused.string()
  endif

  !this.init('CE')
endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .Clear()


  -- Set PosNum for all from list
  do !loop indices !this.CompAr
    !!ce = !this.CompAr[!loop].dbref()
    :MDSPosNum unset
  enddo
  !this.support.:MDSPosNumMax = '0'
  !this.init('')

endmethod
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
define method .getposnum(!supportpassed is dbref ) is ARRAY

  if !!mdsfixposnum.IsPartOfGroup(!supportpassed) then
    !supportemp = !supportpassed.name.string().before('[')
    !supportemp = !supportemp & '[1]'
    !support = !supportemp.dbref()
  else
    !support = !supportpassed
  endif

  -- Get support data from mdsvprmmto object
  !!mdsfixposnum.mdsvprmmtoobj = object mdsvprmmto(!support)

  !classarray  = !!mdsfragettext(!this.mdsvprmmtoobj,'SC')
  !!mdsfixposnum.mdsvprmmtoobj.qualityclass = !classarray[1]
  !!mdsfixposnum.mdsvprmmtoobj.safetyclass  = !classarray[2]

  -- get mdspartlistdata

  !returnarray = !!mdsgetpartlistdata(!!mdsfixposnum.mdsvprmmtoobj.allmem, !!mdsfixposnum.mdsvprmmtoobj.safetyclass, !!mdsfixposnum.mdsvprmmtoobj.support.name)

  return !returnarray
endmethod
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
define method .storeposnumbers(!supportpassed is dbref )

  if !!mdsfixposnum.IsPartOfGroup(!supportpassed) then
    !supportemp = !supportpassed.name.string().before('[')
    !supportemp = !supportemp & '[1]'
    !support = !supportemp.dbref()
  else
    !support = !supportpassed
  endif

  !maxposnum = !support.:MDSPosNumMax.real()
  !!mdsfixposnum.maxposnum = !maxposnum

  !!MDSFixPosNum.StoredCompar.clear()
  !!MDSFixPosNum.StoredPosNumAr.clear()
  !!MDSFixPosNum.StoredDescAr.clear()

  !NumberData = !!MDSFixPosNum.GetPosNum(!support)
  !!MDSFixPosNum.Storedcompar   = !NumberData[1]
  !!MDSFixPosNum.StoredDescAr   = !NumberData[2]
  !!MDSFixPosNum.StoredPosNumAr = !NumberData[3]

  !NameAr = ARRAY()
  do !I indices !!MDSFixPosNum.Storedcompar
    !NameAr.append(!!MDSFixPosNum.Storedcompar[!i].dbref().fullname)
  enddo
  !!MDSFixPosNum.StoredNameAr = !NameAr

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .ComparePosNum(!supportpassed is dbref )

  !momstatus = 1
  !rename = FALSE
  !ReuseNum = TRUE

  if !!mdsfixposnum.IsPartOfGroup(!supportpassed) then
    !supportemp = !supportpassed.name.string().before('[')
    !supportemp = !supportemp & '[1]'
    !support = !supportemp.dbref()
  else
    !support = !supportpassed
  endif
  if !this.support.:mdssupptype.eq('MH01') or !this.support.:mdssupptype.eq('SPECIAL')then
    if !this.support.:mdssupptype.eq('MH01') then
      !config = !this.support.cref.owner.:USTHCFGKEY.replace('.','').substring(1,4)
    else
      !config = !this.support.:mdssupptype
    endif
    if !config.eq(!this.config) then
      !ReuseNum = TRUE
    else
      !ReuseNum = FALSE
    endif
  endif

  !loopcounter = !!MDSFixPosNum.StoredDescAr.size()

  if !ReuseNum then
    do !loop from 1 to !loopcounter
      !posnumar = ARRAY()
      !posnumar.append(!!MDSFixPosNum.storedposnumAr[!loop])

      !testformdsposnum = !!MDSFixPosNum.StoredNameAr[!loop].dbref().:MDSPosnum.unset()
      handle ANY
        --element deleted
      elsehandle NONE
        if !!MDSFixPosNum.StoredNameAr[!loop].dbref().:MDSPosnum.unset() then
          !!MDSFixPosNum.storedNameAr[!loop].dbref().:MDSPosnum  = !posnumar
-- mjb >>> 24.02.06 i leave rod mdsposnum stored at previous element (as 2nd item in array)
        elseif !!MDSFixPosNum.StoredNameAr[!loop].match('ileave rod').gt(0) then
          --i leave rod found
          !loopprev = !loop - 1
          !posnumofprev = ARRAY()
          !posnumofprev.append(!!MDSFixPosNum.storedposnumAr[!loopprev])
          !posnumofprev.append(!posnumar[1])
          !!MDSFixPosNum.storedNameAr[!loopprev].dbref().:MDSPosnum  = !posnumofprev
-- mjb <<< end of mod
        endif
      endhandle
      !rename = TRUE
    enddo
  endif

-- set up new component numbers
  !returnarray = !!mdsgetpartlistdata(!this.mdsvprmmtoobj.allmem, !this.mdsvprmmtoobj.safetyclass, !this.mdsvprmmtoobj.support.name)
  !CompAr   = !returnarray[1]
  !AtexAr   = !returnarray[2]
  !PosNumAr = !returnarray[3]

  !this.CompAr   = !returnarray[1]
  !this.PosNumAr = !returnarray[3]
  !this.DescAr   = !returnarray[2]

  if !rename then
    !!MDSFixPosNum.Apply()

  endif
endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .IsPartOfGroup(!support is dbref ) is BOOLEAN

  -- check to see if support part of a group
  -- if so pass the master support name ie PS1234[1]


  !return = FALSE


  if !support.name.matchwild('*[*]') then
    !return = TRUE
  endif



  return !return

endmethod
