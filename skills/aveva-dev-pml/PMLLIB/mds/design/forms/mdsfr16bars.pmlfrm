--
--
-- Description:
-- Form Definition for Framework bars Type FR09 10 and 11
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -
--  calcdim()                        -
--  calcelev()                       -
--  cancel()                         -
--  deletebar()                      -
--  display()                        -
--  init()                           -
--  ok()                             -
--  replace()                        -
--  select()                         -
--  swap(STRING)                     -
--  testexisting()                   BOOLEAN
--

-- Kill existing form definition
Kill !!MdsFR16Bars

-- Define Form
setup form  !!MdsFR16Bars at xr0 yr0

  !!MdsFR16Bars.formtitle      = |Edit Bars|
  !!MdsFR16Bars.icontitle      = ||
  !!MdsFR16Bars.Callback       = ||
  !!mdsFR16Bars.initcall       = |!this.init()|


  -- Body of Form
    para .a at 1 0 text 'Height of Support = '
    para .av at xmax ymin width 8 lines 1
    para .b at xmin .a ymax text 'Top Bar to Top Mounting = '
    para .bv at xmax ymin width 8 lines 1
    para .c at xmin .a ymax text 'Floor to bottom Bar  = '
    para .cv at xmax ymin width 8 lines 1

    frame .edit 'Edit Bar Heights' at xmin.a ymax

       button .add 'Insert Bar' at 1 1           call '!this.add()'

       button .replace 'Replace Bar' at xmax+2 ymin call '!this.replace()'
       button .delete 'Delete Bar'   at xmax+2 ymin call '!this.deletebar()'
       option .side 'Bar Side ' at xmin.add ymax+0.3  width 9
       !a[1] = 'Standard'
       !a[2] = 'Reversed'
       !a[3] = 'Both'
       !b[1] = 'S'
       !b[2] = 'R'
       !b[3] = 'B'

       !this.side.dtext = !a
       !this.side.rtext = !b
       text .Elevation 'Elevation ' at xmax+1 ymin call '!this.calcdim()'  width 5 is real
       text .Dimension 'Dim ' at xmax+1 ymin  call '!this.calcelev()' width 5 is real

       list .list '' at xmin.add ymax+0.2 call '!this.select()' width 45 height 10

    exit

    button .ok     '   OK   ' at xmin.a ymax+0.5 call      '!this.ok()' ok
    button .cancel ' Cancel ' at xmax form -size ymin call '!this.cancel()' cancel

     menu .selmenu
     !this.selmenu.add('callback','Swap Sides','!this.swap(!this.list.selection())')
--  !this.selmenu.add('callback','Clear Selections','!this.select(|clear|)')
     !this.list.setpopup(!this.selmenu)


    member .form is form
    member .gadget is gadget
    -- oldbardims saves the current world elevation of the bars
    member .oldbardims is ARRAY
    -- bardims are the new world elevation of the bars
    member .bardims is ARRAY
    -- barsides are the settings of the bars (single,both,???)
    member .barsides is ARRAY
    -- oldbarsides are the settings prior to modification
    member .oldbarsides is ARRAY

    member .CE is dbref

    exit
----------------------------------------------------------------------------
define method .init()

    -- remember the form values before they change
    if !this.form.bardims.unset() then
        !this.form.bardims[1] = !this.form.support.datum.position.wrt(/* ).up
    endif
    if !this.form.barsides.unset() then
       !this.form.barsides[1] = 'S'
    endif
    -- get the forms bar settings
    !this.oldbardims  = !this.form.bardims
    !this.bardims     = !this.form.bardims
    !this.barsides    = !this.form.barsides
    !this.oldbarsides = !this.form.barsides
    -- display the current bars
    !this.display()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .swap(!input is STRING)

--q var !input

endmethod
----------------------------------------------------------------------------




----------------------------------------------------------------------------
define method .display()

    -- calculate the height of the support
    !this.av.val = STRING(!this.form.upoffs.val + !this.form.lowoffs.val)
    !this.list.clear()
    !dtext = ARRAY()
    !rtext = ARRAY()
    !datum = !this.form.support.datum.position.wrt(/* ).up
    !this.bv.val = STRING(!datum + !this.form.upoffs.val - !this.bardims[!this.bardims.size()])


    do !a index !this.bardims
      if !a eq 1 then
        !dim = !this.bardims[1] - (!datum - !this.form.lowoffs.val)
        !this.cv.val = !dim.string()
      else
        !dim = !this.bardims[!a] - !this.bardims[!a - 1]
      endif
      if !this.bardims[!a] eq !datum then
         !dtext.append(!this.barsides[!a].replace('S','Std ').replace('R','Rev ').replace('B','Both') & ' Elevation = ,' & !this.bardims[!a] & ' Dimension = ,' & !dim & ', *Datum' )
      else
         !dtext.append(!this.barsides[!a].replace('S','Std ').replace('R','Rev ').replace('B','Both') & ' Elevation = ,' & !this.bardims[!a] & ' Dimension = ,' & !dim )
      endif
      !rtext.append(!this.barsides[!a] & ',' & !this.bardims[!a] & ',' & !dim)
    enddo
   !this.list.dtext = !dtext
   !this.list.rtext = !rtext
   !this.select()
   !this.form.clearaids()
   !this.form.drawaids()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .select()
   !this.elevation.val = !this.list.selection('RTEXT').SPLIT(',')[2].real()
   !this.dimension.val = !this.list.selection('RTEXT').SPLIT(',')[3].real()
   if !this.list.selection('RTEXT').SPLIT(',')[1].eq('S') then
     !this.side.val = 1
   elseif !this.list.selection('RTEXT').SPLIT(',')[1].eq('R') then
     !this.side.val = 2
   else
     !this.side.val = 3
   endif

endmethod
----------------------------------------------------------------------------




----------------------------------------------------------------------------
define method .add()

    -- insert a new bar
    if !this.testexisting()then
         return
    endif

    !newarray = !this.bardims
    !newarray.insert(1,!this.elevation.val)
    !sidearray = !this.barsides
    !sidearray.insert(1,!this.side.selection())
    !index = !newarray.sortedindices()
    !newarray.reindex(!index)
    !sidearray.reindex(!index)
    !this.bardims = !newarray
    !this.barsides = !sidearray
    !this.form.bardims = !this.bardims
    !this.form.barsides = !this.barsides
    !this.display()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .replace()

       if !this.testexisting()then
         return
       endif
       -- check to see if you are trying to modify the datum
       if !this.list.selection('Dtext').match('*Datum').gt(0) then
          if !this.barsides[!this.list.val] eq !this.side.selection() then
              !!alert.error('Cannot Reposition Datum Atta with this Form')
              return
          elseif !this.side.selection().eq('R') then
              !!alert.error('Cannot reverse the Datum Atta')
              return
          else
             !this.barsides[!this.list.val] = !this.side.selection()
             !this.form.barsides = !this.barsides
             !this.display()
             return
          endif
       endif
       -- check if we are trying to move a bar beyond the bar above or below
       if !this.list.val lt !this.bardims.size() then
        -- check for going above the next one
        if !this.elevation.val.real() gt !this.bardims[!this.list.val + 1] then
            !!alert.error('Elevation is greater than next bar - Use Insert Bar to Create at this level')
            !this.display()
            return
        endif
       endif
       if !this.list.val gt 1 then
        -- check for going below the previous one
        if !this.elevation.val.real() lt !this.bardims[!this.list.val - 1] then
            !!alert.error('Elevation is below the previous bar - Use Insert Bar to Create at this level')
            !this.display()
            return
        endif
       endif

       !this.bardims[!this.list.val] = !this.elevation.val.real()
       !this.barsides[!this.list.val] = !this.side.selection()
       !this.form.bardims = !this.bardims
       !this.form.barsides = !this.barsides
       !this.display()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .deletebar()

       -- check to see if you are trying to modify the datum
       if !this.list.selection('Dtext').match('*Datum').gt(0) then
         !!alert.error('Cannot Delete Datum Atta')
         return
       endif

       --!this.form
       -- check to make sure that you want to delete the bar
       if !!alert.confirm('OK to delete bar').eq('NO') then
        return
       endif

       !newarray = !this.bardims
       !sidearray = !this.barsides
       !find = !newarray.findfirst(!this.elevation.val.real())
       if !find.gt(0) then
         !newarray.removefrom(!find,1)
         !sidearray.removefrom(!find,1)
       endif
       !this.bardims = !newarray
       !this.barsides = !sidearray
       !this.form.bardims = !this.bardims
       !this.form.barsides = !this.barsides
       !this.display()

endmethod
----------------------------------------------------------------------------



----------------------------------------------------------------------------
define method .calcdim()
-- method to calculate the appropriate dimension from a given elevation

  !test = !this.bardims
  -- replace existing selection
  !test = !test.removefrom(!this.list.val,1)
  !test.insert(1,!this.elevation.val.real())
  !test.sort()
  !datum = !this.form.support.datum.position.wrt(/* ).up
  !item = !test.findfirst(!this.elevation.val.real())
  if !item eq 1 then
    !this.dimension.val = !this.elevation.val.real() - (!datum - !this.form.lowoffs.val.real())
  else
    !this.dimension.val = !this.elevation.val.real() - !test[!item - 1]
  endif

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .calcelev()
  -- method to calculate the appropriate  elevation from a given dimension
  !datum = !this.form.support.datum.position.wrt(/* ).up
  !test = !this.bardims
  !item = !test.findfirst(!this.elevation.val.real())

  if !item eq 1 then
    !current = !this.elevation.val.real() - (!datum - !this.form.lowoffs.val.real())
  else
    !current = !this.elevation.val.real() - !test[!item - 1]
  endif

  if !this.dimension.val.geq( !current ) then
    !this.elevation.val = !this.elevation.val - (!current - !this.dimension.val)
  else
    !this.elevation.val = !this.elevation.val + (!this.dimension.val - !current )
  endif

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .testexisting()is BOOLEAN

       !teststring = !this.side.selection() & ',' & !this.elevation.val & ',' & !this.dimension.val
       -- check if replaced item is the same as an existing one
       do !a values !this.list.rtext
          if !a eq !teststring then
            !!alert.error('Bar data matches Existing Values')
            return TRUE
          endif
       enddo
      return FALSE

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .ok()

    !this.form.bardims = !this.bardims
    !this.form.barsides = !this.barsides
    !this.form.drawaids()
    !this.form.nbars.val = !this.barsides.size()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .cancel()


    !this.form.bardims = !this.oldbardims
    !this.form.barsides = !this.oldbarsides
    !this.form.drawaids()

endmethod
----------------------------------------------------------------------------
