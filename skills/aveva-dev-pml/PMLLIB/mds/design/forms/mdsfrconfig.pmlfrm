--
-- File:		MdsFRConfig.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--   Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		T .Martin
-- Created:		28/01/2004 16:24
--
--
-- Description:
-- Form Definition for Frameworks Frame Type FR07
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  pixmaps(real)                    -
--

-- Kill existing form definition
Kill !!MdsFRConfig

-- Define Form
setup form !!MdsFRConfig at xr0 yr0
!this.initcall = |!this.init()|

 -- para .c text |Configuration: |
 -- para .number text |1|
 path down
 vdist 1
 rgroup .options at  'Configuration  ' horizontal
   add tag ' 1 ' call |!this.pixmaps(1)|
   add tag ' 2 ' call |!this.pixmaps(2)|
   add tag ' 3 ' call |!this.pixmaps(3)|
   add tag ' 4 ' call |!this.pixmaps(4)|
 para .config at xmin ymax+0.5 pixmap width 336 height 336

 button .ok     '   OK   '  call |!this.gadget.val = !this.options.val.string()
 !this.form.support.config = !this.options.val|  ok
 button .cancel ' Cancel ' at xmax form -size ymin cancel

 !this.config.addPixmap(!!PML.getPathName('fr07-1.png'))
 !this.options.val = 1
 member .form is form
 member .gadget is gadget

exit

-------------------------------------------------------------------------
-- init method (make sure that the correct pixmap is shown
define method .init()

     !this.pixmaps(!this.options.val)
     !this.gadget.val = !this.options.val.string()
     handle ANY
        !this.gadget.val = 1
        handle ANY
        endhandle
     endhandle

endmethod
-------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to swap the pixmaps according to the selected value
define method .pixmaps(!number is real)

if !number eq 1 then
  !this.config.val = !!PML.getPathName('fr07-1.png')
elseif !number eq 2 then
  !this.config.val = !!PML.getPathName('fr07-2.png')
elseif !number eq 3 then
  !this.config.val = !!PML.getPathName('fr07-3.png')
else
  !this.config.val = !!PML.getPathName('fr07-4.png')
endif

endmethod
------------------------------------------------------------------------
