--
-- Description:
-- Form Definition for Framework bars Type FR09 10 and 11
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -
--  auto()                           -
--  calcdim()                        -
--  calcelev()                       -
--  cancel()                         -
--  deletebar()                      -
--  display()                        -
--  init()                           -
--  ok()                             -
--  replace()                        -
--  select()                         -
--  selectpost(real)                 -
--  setsame()                        -
--  testexisting()                   BOOLEAN
--

-- Kill existing form definition
Kill !!MDSFRWallBars

-- Define Form
setup form  !!MDSFRWallBars at xr0 yr0

  !!MDSFRWallBars.formtitle      = |Edit Wall Connections|
  !!MDSFRWallBars.icontitle      = ||
  !!MDSFRWallBars.Callback       = ||
  !!MDSFRWallBars.initcall       = |!this.init()|


  -- Body of Form
    para .a at 1 0 text 'Height of Support = '
    para .av at xmax ymin width 8 lines 1

    button .allp at at xmin .a ymax |Set All Connections To Same Height| call |!this.setsame()|
    button .auto at  at xmin .a ymax+ 0.4  ' Auto '  call |!this.auto()|
    option .postnumber 'Select Post ' at xmax + 8 ymin call '!this.selectpost(!this.postnumber.val)'   width 3
    para   .nconn  at xmin .a ymax text |Number of Wall Connections = |
    para   .nconns at xmax ymin width 4 lines 1

    frame .edit 'Edit Connection Heights' at xmin.a ymax

       button .add     ' Insert ' at 1 1           call '!this.add()'
       button .replace ' Replace ' at xmax+2 ymin call '!this.replace()'
       button .delete  ' Delete '   at xmax+2 ymin call '!this.deletebar()'
       text .Elevation 'Elevation' at xmin.add ymax+0.5 call '!this.calcdim()'  width 10 is real
       text .Dimension 'Dimension' at xmax ymin  call '!this.calcelev()' width 10 is real
       list .pane '' at xmin.add ymax call '!this.select()' width 40 height 15
 --      list .pane '' at xmin.add ymax  width 40 height 15

    exit

    button .ok     '   OK   ' at xmin.a ymax+0.5 call      '!this.ok()'
    button .cancel ' Cancel ' at xmax form -size ymin call '!this.cancel()' cancel


    member .form is form
    -- member oldsuppdims stores the array of array connections for restore
    member .oldsupdims is ARRAY
    -- member suppdims stores one level of bars for one post
    member .suppdims is ARRAY
    -- member alldims is used for all of the bars on each of the posts
    member .alldims is ARRAY
    member .CE is dbref
    member .current is real

    exit
----------------------------------------------------------------------------
define method .init()

      !localfitt = !this.form.localfitt

      if !localfitt.size() lt !this.form.nposts.val.real() then
        do !a from !localfitt.size() + 1 to !this.form.nposts.val.real()
          !localfitt[!a] = ARRAY()
        enddo
      elseif !localfitt.size() gt !this.form.nposts.val.real() then
          !localfitt.deletefrom(!this.form.nposts.val.real() + 1)
      endif

      -- loop through the fittings array
      do !a index !this.form.localfitt
        if !localfitt[!a].size().eq(0) then
          !datum = !this.form.support.datum.position.wrt(/* ).up
          handle ANY
            !!alert.error('Datum atta not created')
            return
          endhandle
          if !a.eq(1) then
            !localfitt[!a][1] = !datum
          else
            !localfitt[!a] = !localfitt[!a - 1]
          endif
        endif
      enddo


    -- remember the form values before they change

     !this.alldims = !localfitt
     !this.oldsupdims = !this.form.localfitt
     !this.suppdims = !localfitt[1]
     !this.form.localfitt = !localfitt

     !this.current = 1
      -- initalise the number of verticals in the support
     do !a from 1 to !this.form.nposts.val.real()
         !po[!a] = !A.string()
     enddo
     !this.postnumber.dtext = !po
      --localfitt

     !this.display()

endmethod
----------------------------------------------------------------------------



----------------------------------------------------------------------------
define method .display()

    -- calculate the height of the support
    !this.av.val = STRING(!this.form.upoffs.val + !this.form.lowoffs.val)
    !this.pane.clear()
    !dtext = ARRAY()
    !rtext = ARRAY()
    !datum = !this.form.support.datum.position.wrt(/* ).up
    --!this.bv.val = STRING(!datum + !this.form.upoffs.val - !this.suppdims[!this.suppdims.size()])
    do !a index !this.suppdims
      if !a eq 1 then
        !dim = !this.suppdims[1] - (!datum - !this.form.lowoffs.val)
      else
        !dim = !this.suppdims[!a] - !this.suppdims[!a - 1]
      endif
      !dtext.append('Elevation = ' & !this.suppdims[!a] & ' Dimension = ' & !dim )
      !rtext.append(!this.suppdims[!a] & ',' & !dim)
    enddo

   !this.pane.dtext = !dtext
   !this.pane.rtext = !rtext
   !this.select()

   !this.form.clearaids()
   !this.form.localfitt = !this.alldims
   !this.form.drawaids()
   -- !this.form.drawconns(!this.alldims,FALSE)
   !this.nconns.val = !dtext.size().string()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .select()

   !this.elevation.val = !this.pane.selection('RTEXT').SPLIT(',')[1].real()
   !this.dimension.val = !this.pane.selection('RTEXT').SPLIT(',')[2].real()

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .add()
    -- insert the
    if !this.testexisting()then
         return
    endif

    !newarray = !this.suppdims
    !newarray.insert(1,!this.elevation.val)
    !newarray.sort()
    !this.suppdims = !newarray
    !this.alldims[!this.postnumber.val] = !this.suppdims

    !this.display()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .replace()

       if !this.testexisting()then
         return
       endif
       -- check to see if you are trying to modify the datum
       if !this.pane.selection('Dtext').match('*Datum').gt(0) then
         !!alert.error('Cannot Reposition Datum Atta with this Form')
         return
       endif
       -- check if we are trying to move a bar beyond the bar above or below
       if !this.pane.val lt !this.suppdims.size() then
        -- check fro going above the next one
        if !this.elevation.val.real() gt !this.suppdims[!this.pane.val + 1] then
            !!alert.error('Elevation is greater than next bar - Use Insert Bar to Create at this level')
            !this.display()
            return
        endif
       endif
       if !this.pane.val gt 1 then
        -- check for going below the previous one
        if !this.elevation.val.real() lt !this.suppdims[!this.pane.val - 1] then
            !!alert.error('Elevation is below the previous bar - Use Insert Bar to Create at this level')
            !this.display()
            return
        endif
       endif

       !this.suppdims[!this.pane.val] = !this.elevation.val.real()
       !this.alldims[!this.postnumber.val] = !this.suppdims
       !this.display()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .deletebar()

       !newarray = !this.suppdims
       !find = !newarray.findfirst(!this.elevation.val.real())
       if !find.gt(0) then
         !newarray.removefrom(!find,1)
       endif
       !this.suppdims = !newarray
       !this.alldims[!this.postnumber.val] = !this.suppdims
       !this.display()

endmethod
----------------------------------------------------------------------------



----------------------------------------------------------------------------
define method .calcdim()
-- method to calculate the appropriate dimension from a given elevation

  !test = !this.suppdims
  -- replace existing selection
  !test = !test.removefrom(!this.pane.val,1)
  !test.insert(1,!this.elevation.val.real())
  !test.sort()
  !datum = !this.form.support.datum.position.wrt(/* ).up
  !item = !test.findfirst(!this.elevation.val.real())
  if !item eq 1 then
    !this.dimension.val = !this.elevation.val.real() - (!datum - !this.form.lowoffs.val.real())
  else
    !this.dimension.val = !this.elevation.val.real() - !test[!item - 1]
  endif

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .calcelev()
  -- method to calculate the appropriate  elevation from a given dimension

  !test = !this.suppdims
  !item = !test.findfirst(!this.elevation.val.real())
  !datum = !this.form.support.datum.position.wrt(/* ).up
  if !item eq 1 then
    !current = !this.elevation.val.real() - (!datum - !this.form.lowoffs.val.real())
  else
    !current = !this.elevation.val.real() - !test[!item - 1]
  endif

  if !this.dimension.val.geq( !current ) then
    !this.elevation.val = !this.elevation.val - (!current - !this.dimension.val)
  else
    !this.elevation.val = !this.elevation.val + (!this.dimension.val - !current )
  endif

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .testexisting()is BOOLEAN

       !teststring = !this.elevation.val & ',' & !this.dimension.val
       -- check if replaced item is the same as an existing one
       do !a values !this.pane.rtext
          if !a eq !teststring then
            !!alert.error('Bar data matches Existing Values')
            return TRUE
          endif
       enddo
      return FALSE

endmethod
----------------------------------------------------------------------------


----------------------------------------------------------------------------
define method .selectpost(!postno is real)

  -- save the values currently in focus
  !this.alldims[!this.current] = !this.suppdims
  !this.suppdims = !this.alldims[!postno]
  !this.current = !postno
  !this.display()

  --if the posts have not been set yet then
  --  grey out everything except the auto button
  --elseif the posts have different connections,

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
-- method to set all of the bars at the same height
define method .setsame()

   if !!alert.confirm('Do you want to set all of the bars to the current settings?').eq('YES') then
    !rtex = !this.pane.rtext
    !new = ARRAY()
    do !a values !rtex
      !new.append(!a.split(',')[1].real())
    enddo
    !temp = ARRAY()
    do !a index !this.alldims
      !temp[!a] = !new
    enddo
    !this.alldims = !temp
   endif
   !this.display()
endmethod
----------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .auto()

   !lowbars = 0
   !highbars = 0
   -- clear the old values
   !this.form.suppdims = ARRAY()
   -- get the length of the available space
   !memlen = !this.form.lowoffs.val + !this.form.upoffs.val - (!this.form.topoverlap.val + !this.form.bottoverlap.val)
   -- nominal spacing is 500mm
   if !memlen lt 1000 then
    !nbars = 1
    !space = 0
   elseif !memlen gt 1000 and !memlen lt 1500 then
    !nbars = 2
    !space = !memlen
   else
    !nbars = int(!memlen / 500)
    !space = nint(!memlen / (!nbars - 1))
    -- !nbars = !nbars
   endif

   !connections = ARRAY()
   !datup = !this.form.support.datum.position.wrt(/* ).up
   !lowpos = !datup - !this.form.lowoffs.val + !this.form.bottoverlap.val
   !uppos  = !datup + !this.form.upoffs.val - !this.form.topoverlap.val

   if !nbars eq 1 then
     !connections[1] = !lowpos + ((!uppos - !lowpos) / 2)
   elseif !nbars eq 2 then
     !connections[1] = !lowpos
     !connections[2] = !uppos
   else
     !connections[1] = !lowpos
     !npos = !lowpos
     do !a from 2 to !nbars - 1
      !npos = !npos + !space
      !connections[!a] = !npos
     enddo
     !connections.append(!uppos)
   endif

   !this.suppdims = !connections
   !this.alldims[!this.postnumber.val] = !connections
   --!this.nconns.val = !this.suppdims.size()
   -- set the form fittings so that they will draw properly
   !this.form.localfitt = !this.alldims
   !this.form.drawaids()
   -- draws only the
   -- !this.form.drawconns(!this.alldims,TRUE)
   !this.selectpost(!this.postnumber.val)

endmethod
-------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------
define method .ok()

    !this.form.localfitt = !this.alldims
    if !this.form.checkconns() then
        return
    else
       -- !this.form.localfitt = !this.alldims
       !this.form.drawaids()
    endif
    !this.hide()

endmethod
----------------------------------------------------------------------------

----------------------------------------------------------------------------
define method .cancel()

    !this.form.localfitt = !this.oldsupdims
    --!this.form.localfitt = !this.alldims
    !this.form.drawaids()

endmethod
----------------------------------------------------------------------------
