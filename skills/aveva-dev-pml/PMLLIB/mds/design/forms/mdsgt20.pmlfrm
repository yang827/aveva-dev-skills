--
-- File:		mdsGt20.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Form Definition for Guide Type 04
--
--------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!mdsGt20

-- Define Form
Setup Form  !!mdsGt20 at xr0 yr0

  !!mdsGt20.formtitle    = ||
  !!mdsGt20.icontitle    = ||
  !!mdsGt20.Callback     = ||
  !!mdsGt20.formrevision = | $Revision$ |

  -- Body of Form
    para .Tag text |Name:|
    para .name at xmax+2 ymin width 20 lines 1

    -- Create Datum
    frame .FDatum |Datum| at x0 ymax width 31

      button .Datum | Create datum support atta | at x1 y1 Call |Call !!mdsSetDatGt20()|

    exit

    frame .FMisc |Miscellaneous Options| at x0 ymax width 31

      -- Guide options
     -- option .GuideDir |Guided   | at x1 ymax+0.2 Call |Call !!mdsSetGuideDir('MODI')| width 16

      -- para .PHeight at x1 Ymax+0.2 text |Height      |
      path right
      -- text .Height    || call |Call !!mdsModGuide(!!mdsGt20,'HEIGHT',!!mdsGt20.support.atta[1])| width 14 is real format !!DistanceFmt
      para .PClearance at x1 Ymax+0.2 text |Clearance   |
      text .Clearance    || call |Call !!mdsModGuide(!!mdsGt20,'CLEARANCE',!!mdsGt20.support.atta[1])| width 14 is real format !!DistanceFmt
      para .PLength at x1 Ymax+0.2 text    |Length      |
      text .Length    || call |Call !!mdsModGuide(!!mdsGt20,'LENGTH',!!mdsGt20.support.atta[1])| width 14 is real format !!DistanceFmt

      button .SetDefault | Set Parameters to Default  | at x1 Ymax+0.2 call |!!mdsSetDef(!!mdsGt20.Support.Alias,!!mdsGt20.support.atta[1])|

      halign left

    exit

  -- Bottom Line
    button .Cancel  | Cancel | at xmax form-size ymax+0.5
    -- button .HiddenCancel || at x0 ymin call |call !!mdsDontHitThis()| cancel
    button .Ok      |   OK   | at x0             ymin     Call |Call !!mdsAcceptGt20()|
    button .Plot    |View...|  at xmax+2         ymin     Call |Call !!mdsShowPlotFile(_Support)|

  -- Form Members
    -- Support object
    member .Support     is mdsSUPPORT

    -- Graphical representation
    member .Repre       is ARRAY

    -- Form Storage for support restoration
    member .Store       is ARRAY

    -- Support object storage for support regeneration
    member .Backup      is mdsSUPPORT

    -- Support Regeneration function
    member .Regen       is STRING

    -- BedPlate Reference
    member .StruBpref   is ARRAY

    -- BedPlate Reference
    member .StoreBpref  is ARRAY
$(
    -- Populate guide direction gadget
    !Dtext[1] = |Both Directions|
    !Dtext[2] = |With Flow|
    !Dtext[3] = |Parallel to Flow|
    !Rtext[1] = |3|
    !Rtext[2] = |4|
    !Rtext[3] = |4|
    !!mdsGt20.GuideDir.Dtext = !Dtext
    !!mdsGt20.GuideDir.Rtext = !Rtext
$)
-- End form definition
exit


-- Set the Hiddencancel Button to INACTIVE
    -- !formobj = !this
    -- !formobj.hiddencancel.active = false


-- End of file mdsGt20.frm
