--
-- File:    mdshangview.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   Thursday 26th October 2002 at 2:50
--
-- Description:
-- Form Definition for user view of hanger configuration
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  hide()                           -
--  init(FORM)                       -
--

-- Kill existing form definition
kill !!mdshangview

-- Define Form
setup form  !!mdshangview resize noquit

  !this.formtitle = |Hanger Configuration Viewer|

  frame .plotFrame at x0 ymax+0.2 anchor all
    view .view volume
    hei 20
    wid 40
    look n
  exit
exit

-- Bottom Line
path down
vdist 0.5

button .cancel | Dismiss | anchor B + L callback |!this.hide()| cancel

para .pstandard at xmax+0.5 ymin anchor B + L width 25 lines 1

member .hanger is DBREF


-- End form definition
exit

define method .init(!form is FORM)

!!mdshangview.view.shaded = TRUE

!selected = !!mdsfhanger.standard.selection()

!ce = !!ce

!template = !!mdsAllHangertypes.getTemplateName('$!selected')

/MDS/$!template
handle ANY
  !!alert.error('Unable to find selected hanger configuration ' + !form.standard.selection())
  return
elsehandle NONE
  -- Hide any previous configuration

  !ce = !!ce
  !!ce = !!mdshangview.hanger
  handle NONE
    rem ce
  elsehandle ANY
  endhandle
  !!ce = !ce
  rest 1
  handle NONE
    !currentunits = !!kgetsetunits()
    var !limits volume ce
    !splitLimits = !limits.split()
    !volumeArray = ARRAY()
    if !splitLimits[1].eq('E') or !splitLimits[1].eq('X') then
      !volumeArray.append(!splitLimits[2].real())
    else
      !volumeArray.append(!splitLimits[2].real() * -1)
    endif
    if !splitLimits[8].eq('E') or !splitLimits[8].eq('X') then
      !volumeArray.append(!splitLimits[9].real())
    else
      !volumeArray.append(!splitLimits[9].real() * -1)
    endif
    if !splitLimits[3].eq('N') or !splitLimits[3].eq('Y') then
      !volumeArray.append(!splitLimits[4].real())
    else
      !volumeArray.append(!splitLimits[4].real() * -1)
    endif
    if !splitLimits[10].eq('N') or !splitLimits[10].eq('Y') then
      !volumeArray.append(!splitLimits[11].real())
    else
      !volumeArray.append(!splitLimits[11].real() * -1)
    endif
    if !splitLimits[5].eq('U') or !splitLimits[5].eq('Z') then
      !volumeArray.append(!splitLimits[6].real())
    else
      !volumeArray.append(!splitLimits[6].real() * -1)
    endif
    if !splitLimits[12].eq('U') or !splitLimits[12].eq('Z') then
      !volumeArray.append(!splitLimits[13].real())
    else
      !volumeArray.append(!splitLimits[13].real() * -1)
    endif
    !!mdshangview.view.limits = !volumeArray
    !!mdshangview.hanger = !!ce
    add ce
    !!mdshangview.pstandard.val = 'Configuration = ' + !!mdsfhanger.standard.selection()
    !!kRestoreUnits(!currentunits)
  elsehandle ANY
    return
  endhandle
  show !!mdshangview free
endhandle

!!ce = !ce

endmethod

define method .hide()

!ce = !!ce
!!ce = !!mdshangview.hanger
handle NONE
  rem ce
elsehandle ANY
endhandle
!!ce = !ce

endmethod
