-------------------------------------------------------------------------------

setup form !!mdshealthchk

  !this.initcall = '!this.init()'

  !this.formtitle = 'MDS Health Check Utility'

-- Bar Menu
    bar
      !this.bar.add('Add','menu1')
      !this.bar.add('Remove','menu2')
      !this.bar.add('View Report','menu3')

    menu .menu1
      !this.menu1.add('callback', 'All Supports' , |!this.loadsupports('ALL')|)
      !this.menu1.add('callback', 'CE and Below' , |!this.loadsupports('CE')|)

    menu .menu2
      !this.menu2.add('callback', 'All Supports' , |!this.removesupports('ALL')|)
      !this.menu2.add('callback', 'Selected' ,     |!this.removesupports('SELECTED')|)

    --!this.menu1.add('callback', 'Load Hangers' , |!this.loadsupports('hang')|)
    --!this.menu1.add('callback', 'Load Trunnions' , |!this.loadsupports('trunn')|)
    --!this.newmenu('menu1').add('callback', 'Reload Default Reports' , '!!mdsnewreports.init(''reload'')')

    menu .menu3

    !this.menu3.add('callback', 'Load Errors Only' , |!this.viewreports('LOADONLY')|,'field1')
    !this.menu3.add('callback', 'Complete Health Check' , |!this.viewreports('COMPLETE')|,'field2')

    --filter for loading supports (append to collection 'where ...' - commented out for now
    --text .filtertext 'Filter:' call |!this.checkexprn()| width 25 is STRING

    path down

  -- MDS Report Output Format
    frame .foutput ' Output Format '
      path right
    --at x1 ymax
      rgroup .output '' at xmin+0.5 ymax+0.03
        add tag 'text file'
        add tag 'csv file'
        add tag 'screen'
      exit
      path down
      text .filenametext 'Directory' call '!this.checkdirectory()' at xmin .output width 23 is STRING
    exit

    --path down

  --para .supstandardtitle text 'Support Standard'

  list .supportlist 'Supports' at xmin .foutput multiple width 33 hei 16

  path right

  path down

  --button .CE 'CE' call '!this.CEmethod()' at xmin .allancil ymax .allancil

  --apply and dismiss buttons

  button .apply 'Apply' call '!this.applybutton()' at xmin form
  path right
  button .dismiss 'Dismiss' at xmax form -size cancel

  --form members

  member .outputmessage is ARRAY
  member .totalsupporterrors is REAL
  member .numsupportschecked is REAL
  member .supporterrorflag is BOOLEAN
  member .supporterrors is REAL
  member .totalerrors is REAL
  member .ancilerrors is REAL
  member .health is mdshealthchkdata
  member .defaultdirectory is STRING
  member .loadfilename is STRING
  member .mainfilename is STRING

exit

-------------------------------------------------------------------------

define method .mdshealthchk()
  --validate calls on text gadgets
  --e.g. !this.datadescription.validatecall = '!this.writedescriptionvalid('
  --set initial value for directory name gadget
  !projobj = current project
  !currentprojectcode = !projobj.code()

  !projectcodeinfodirectory = '%' & !currentprojectcode & 'info%'

  --check this directory exists, if not use pdmswk

  !dirobject = object file(!projectcodeinfodirectory)

  !type = !dirobject.type()
  handle ANY
    !this.defaultdirectory = '%pdmswk%'
  elsehandle NONE
    !this.defaultdirectory = !projectcodeinfodirectory
  endhandle
  --set at !this.defaultdirectory to use in applybutton method

  !this.filenametext.val = !this.defaultdirectory
  !this.menu3.setfieldproperty('field1','ACTIVE',FALSE)
  !this.menu3.setfieldproperty('field2','ACTIVE',FALSE)

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .init()

  --!this.setcounter()

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .applybutton()

  !storedce = !!ce

  !dateandtimeobj = object mdsdatetimeobj()

  --run runcheck() method on object (runs checks and creates output array)

  !this.health.runcheck()

 -------------------------------------------------------------------------------
 --OUTPUT SECTION

  --!combinedoutputmessage = !this.health.loadmessage

  --!combinedoutputmessage.appendarray(!this.health.outputmessage)

  --temp file output for viewing using view option on menu bar

  --format output for screen or file output

  !outputarray = ARRAY()

  !totalerrors = 0
  !totalwarnings = 0
  !numsuppswitherrors = 0
  !numsuppswithwarnings = 0

  !projobj = current project
  !currentprojectcode = !projobj.code()

  !sess = current session

  !currentprojmessage = 'Project: ' & !projobj.code()

  !usermessage = 'User: ' & !sess.user().name

  !processidmessage = 'Process ID: ' & !sess.uniqueid

  !usernamemessage = 'User Name: ' & !sess.name

  !userloginmessage = 'User Login: ' & !sess.login

  !hostmessage =  'Host: ' & !sess.host

  !datemessage = 'Date: ' & !dateandtimeobj.daystring & '-' & !dateandtimeobj.monthstrabb & '-' & !dateandtimeobj.year
  !timemessage = 'Time: ' & !dateandtimeobj.hourstring & ':' & !dateandtimeobj.minutestring & ':' & !dateandtimeobj.secondstring

  !outputarray.append('************************************************************')

  !reportheader = ARRAY()

  !reportheader.append('MDS Health Check Utility Report')
  --!reportheader.append('')
  --Date
  !reportheader.append(!datemessage)
  --Time
  !reportheader.append(!timemessage)
  --User
  !reportheader.append(!usermessage)
  --Project
  !reportheader.append(!currentprojmessage)
  --User name
  !reportheader.append(!usernamemessage)
  --User login
  !reportheader.append(!userloginmessage)
  --Host
  !reportheader.append(!hostmessage)
  --Process ID
  !reportheader.append(!processidmessage)

  !outputarray.appendarray(!reportheader)

  !numsuppswitherrors = 0
  !numsuppswithwarnings = 0

  --!sizeoferrorobjarray = !this.health.supporterrorarray.size()
  !outputarray.append('************************************************************')

  !numloaderrors = !this.health.loadmessage.size()

  !outputarray.append('Load Errors')
  !outputarray.appendarray(!this.health.loadmessage)
  !outputarray.append('Number of load errors = $!numloaderrors')
  !outputarray.append('************************************************************')

  do !i index !this.health.supporterrorarray
    !namemessage = 'Support Name ' & !this.health.supporterrorarray[!i].name
    !typemessage = 'Support Type ' & !this.health.supporterrorarray[!i].type

    !outputarray.append(!namemessage)
    !outputarray.append(!typemessage)
    --$p Support name $!this.health.supporterrorarray[!i].name
    --$p Support type $!this.health.supporterrorarray[!i].type
    do !j index !this.health.supporterrorarray[!i].errorarray
      if !this.health.supporterrorarray[!i].errorarray[!j].match('----------').eq(0) then
        !error = !this.health.supporterrorarray[!i].errorarray[!j]
        !outputarray.append(!error)
        --$p $!this.health.supporterrorarray[!i].errorarray[!j]
      endif
    enddo

    !totalerrors = !totalerrors + !this.health.supporterrorarray[!i].numerrors
    !totalwarnings = !totalwarnings +  !this.health.supporterrorarray[!i].numwarnings

    !numerrorsmessage = 'Number of errors with support = ' & !this.health.supporterrorarray[!i].numerrors
    !numwarningsmessage = 'Number of warnings with support = ' & !this.health.supporterrorarray[!i].numwarnings

    if !this.health.supporterrorarray[!i].numerrors.gt(0) then
      !numsuppswitherrors = !numsuppswitherrors + 1
    endif
    if !this.health.supporterrorarray[!i].numwarnings.gt(0) then
      !numsuppswithwarnings = !numsuppswithwarnings + 1
    endif

    !outputarray.append(!numerrorsmessage)
    !outputarray.append(!numwarningsmessage)

    !outputarray.append('************************************************************')
  enddo

  !reportsummary = ARRAY()

  !reportsummary.append('Report Summary')

  !numsuppscheckedmessage = 'Number of supports checked = ' & !this.health.supporterrorarray.size()

  !numsuppswitherrorsmessage = 'Number of supports with errors = ' & !numsuppswitherrors

  !numsuppswithwarningsmessage = 'Number of supports with warnings = ' & !numsuppswithwarnings

  !totalerrorsmessage = 'Total number of errors = ' & !totalerrors

  !totalwarningsmessage = 'Total number of warnings = ' & !totalwarnings

  !reportsummary.append(!numsuppscheckedmessage)

  !reportsummary.append(!numsuppswitherrorsmessage)

  !reportsummary.append(!totalerrorsmessage)

  !reportsummary.append(!numsuppswithwarningsmessage)

  !reportsummary.append(!totalwarningsmessage)

  !outputarray.appendarray(!reportsummary)

  !outputarray.append('************************************************************')
  !outputarray.append('End of report')
  !outputarray.append('************************************************************')

  --!filenametemp = '%pdmswk%/MDS-HEALTH-CHECK-TEMP-REPORT.dat'
  --!fileobjecttemp  = object file(!filenametemp)

  --!fileobjecttemp.writefile('OVERWRITE',!outputarray)

  --!fileobjecttemp.close()

  if !this.output.val.eq(2) then

    --format output for csv file

    !csvoutputarray = ARRAY()

    !csvreportheader = ARRAY()

    do !x index !reportheader
      !csvreportheader.append(!reportheader[!x].replace(': ',',',1,1))
    enddo

    !csvoutputarray.appendarray(!csvreportheader)

    !csvoutputarray.append('')

    !csvoutputarray.append('Load Errors')
    !csvoutputarray.appendarray(!this.health.loadmessage)
    !csvoutputarray.append('Number of load errors = $!numloaderrors')
    !csvoutputarray.append('')

    !columnheadings = 'Name,Type,Errors and Warnings'

    !csvoutputarray.append(!columnheadings)
    do !i index !this.health.supporterrorarray

    !numerrorsmessage = 'Number of errors with support = ' & !this.health.supporterrorarray[!i].numerrors
    !numwarningsmessage = 'Number of warnings with support = ' & !this.health.supporterrorarray[!i].numwarnings

      !test = !this.health.supporterrorarray[!i].errorarray[1]
      handle ANY
        !lineone = !this.health.supporterrorarray[!i].name & ',' & !this.health.supporterrorarray[!i].type & ',' & !numerrorsmessage

        !linetwo = ',,' & !numwarningsmessage
        !csvoutputarray.append(!lineone)
        !csvoutputarray.append(!linetwo)

      elsehandle NONE
        !lineone = !this.health.supporterrorarray[!i].name & ',' & !this.health.supporterrorarray[!i].type & ',' & !this.health.supporterrorarray[!i].errorarray[1]

        !csvoutputarray.append(!lineone)

        if !this.health.supporterrorarray[!i].errorarray.size().gt(1) then
          do !j from 2 to !this.health.supporterrorarray[!i].errorarray.size() by 1
            !errorline = ',,' & !this.health.supporterrorarray[!i].errorarray[!j]
            if !errorline.match('----------').eq(0) then
              !csvoutputarray.append(!errorline)
            endif
          enddo
        endif

        !lineoneerrors = ',,' & !numerrorsmessage
        !linetwowarnings = ',,' & !numwarningsmessage

        !csvoutputarray.append(!lineoneerrors)
        !csvoutputarray.append(!linetwowarnings)
      endhandle
      --!csvoutputarray.append(!errorsandwarnings)
    enddo

    !csvoutputarray.append('')
    !csvoutputarray.appendarray(!reportsummary)
    !csvoutputarray.append('')
    !csvoutputarray.append('End of report')

    !dateandtime = !dateandtimeobj.datetimestr

    !directoryname = !this.filenametext.val

    --**************************
    !defaultdirectoryname = !this.defaultdirectory

    if !directoryname.eq('') then

      !!alert.error('No directory name entered, defaulting to $!defaultdirectoryname')
      --return
      !this.filenametext.val = !defaultdirectoryname
      --!this.filenametext.val = '%pdmswk%'

      !directoryname = !defaultdirectoryname
      --!directoryname = '%pdmswk%'

    endif

    --check a valid directory name has been entered

    !dirobject = object file(!directoryname)

    !type = !dirobject.type()
    handle ANY
      !!alert.error('Invalid directory name entered')
    elsehandle NONE
      if !type.eq('FILE') then
        !!alert.error('File name entered, valid directory name required')
      else
        --valid directory name, so write output to file

        !filename = !directoryname & '/MDS-HEALTH-CHECK-REPORT-' & !dateandtime & '.csv'

        --$P Writing MDS Health Check report to file $!filename

        !fileobject  = object file(!filename)

        --write file

        !fileobject.writefile('WRITE',!csvoutputarray)

        --close file object
        !fileobject.close()

        !this.mainfilename = !filename

        --Writing MDS Health Check LOAD REPORT ONLY to file

        --!filenameload = !directoryname & '/MDS-HEALTH-CHECK-LOADREPORTONLY-' & !dateandtime & '.csv'

        --!fileobjectload  = object file(!filenameload)

        --!loaderrorstemparray = ARRAY()

        --!loaderrorstemparray.append('************************************************************')
        --!loaderrorstemparray.append('MDS Health Check Utility Loading Errors Report')
        --!loaderrorstemparray.appendarray(!this.health.loadmessageheader)
        --!loaderrorstemparray.append('')
        --!loaderrorstemparray.appendarray(!this.health.loadmessage)
        --!loaderrorstemparray.append('Number of load errors = $!numloaderrors')
        --!loaderrorstemparray.append('')
        --!loaderrorstemparray.append('End of report')
        --!loaderrorstemparray.append('************************************************************')

        --!fileobjectload.writefile('WRITE',!loaderrorstemparray)

        --!fileobjectload.close()

        !this.menu3.setfieldproperty('field2','ACTIVE',TRUE)

      endif
    endhandle
    --endif
    --*************************************

    --!filename = !directoryname & '/MDS-HEALTH-CHECK-REPORT-' & !dateandtime & '.csv'

    --$P Writing MDS Health Check report to file $!filename

    --!fileobject  = object file(!filename)

    --write file

    --!fileobject.writefile('WRITE',!csvoutputarray)

    --close file object
    --!fileobject.close()

    --!this.menu3.setfieldproperty('field2','ACTIVE',TRUE)

  elseif !this.output.val.eq(3) OR !this.output.val.eq(1) then

    --format output for screen or file output

    !outputarray = ARRAY()

    !totalerrors = 0
    !totalwarnings = 0
    !numsuppswitherrors = 0
    !numsuppswithwarnings = 0

    --!projobj = current project
    --!currentprojectcode = !projobj.code()

    --!sess = current session

    --!currentprojmessage = 'Project: ' & !projobj.code()

    --!usermessage = 'User: ' & !sess.user().name

    --!processidmessage = 'Process ID: ' & !sess.uniqueid

    --!usernamemessage = 'User Name: ' & !sess.name

    --!userloginmessage = 'User Login: ' & !sess.login

    --!hostmessage =  'Host: ' & !sess.host

    --!datemessage = 'Date: ' & !dateandtimeobj.daystring & '-' & !dateandtimeobj.monthstrabb & '-' & !dateandtimeobj.year
    --!timemessage = 'Time: ' & !dateandtimeobj.hourstring & ':' & !dateandtimeobj.minutestring & ':' & !dateandtimeobj.secondstring

    !outputarray.append('************************************************************')
    --!outputarray.append('MDS Health Check Utility Report')
    --Date
    --!outputarray.append(!datemessage)
    --Time
    --!outputarray.append(!timemessage)
    --User
    --!outputarray.append(!usermessage)
    --Project
    --!outputarray.append(!currentprojmessage)
    --User name
    --!outputarray.append(!usernamemessage)
    --User login
    --!outputarray.append(!userloginmessage)
    --Host
    --!outputarray.append(!hostmessage)
    --Process ID
    --!outputarray.append(!processidmessage)

    !outputarray.appendarray(!reportheader)

    !numsuppswitherrors = 0
    !numsuppswithwarnings = 0

    !outputarray.append('************************************************************')

    !numloaderrors = !this.health.loadmessage.size()

    !outputarray.append('Load Errors')
    !outputarray.appendarray(!this.health.loadmessage)
    !outputarray.append('Number of load errors = $!numloaderrors')

    --!sizeoferrorobjarray = !this.health.supporterrorarray.size()
    !outputarray.append('************************************************************')
    do !i index !this.health.supporterrorarray
      !namemessage = 'Support Name ' & !this.health.supporterrorarray[!i].name
      !typemessage = 'Support Type ' & !this.health.supporterrorarray[!i].type

      !outputarray.append(!namemessage)
      !outputarray.append(!typemessage)
      --$p Support name $!this.health.supporterrorarray[!i].name
      --$p Support type $!this.health.supporterrorarray[!i].type
      do !j index !this.health.supporterrorarray[!i].errorarray
        if !this.health.supporterrorarray[!i].errorarray[!j].match('----------').eq(0) then
          !error = !this.health.supporterrorarray[!i].errorarray[!j]
          !outputarray.append(!error)
          --$p $!this.health.supporterrorarray[!i].errorarray[!j]
        endif
      enddo

      !totalerrors = !totalerrors + !this.health.supporterrorarray[!i].numerrors
      !totalwarnings = !totalwarnings +  !this.health.supporterrorarray[!i].numwarnings

      !numerrorsmessage = 'Number of errors with support = ' & !this.health.supporterrorarray[!i].numerrors
      !numwarningsmessage = 'Number of warnings with support = ' & !this.health.supporterrorarray[!i].numwarnings

      if !this.health.supporterrorarray[!i].numerrors.gt(0) then
        !numsuppswitherrors = !numsuppswitherrors + 1
      endif
      if !this.health.supporterrorarray[!i].numwarnings.gt(0) then
        !numsuppswithwarnings = !numsuppswithwarnings + 1
      endif

      !outputarray.append(!numerrorsmessage)
      !outputarray.append(!numwarningsmessage)

      !outputarray.append('************************************************************')
    enddo

    !outputarray.append('Report Summary')

    !numsuppscheckedmessage = 'Number of supports checked = ' & !this.health.supporterrorarray.size()

    !numsuppswitherrorsmessage = 'Number of supports with errors = ' & !numsuppswitherrors

    !numsuppswithwarningsmessage = 'Number of supports with warnings = ' & !numsuppswithwarnings

    !totalerrorsmessage = 'Total number of errors = ' & !totalerrors

    !totalwarningsmessage = 'Total number of warnings = ' & !totalwarnings

    !outputarray.append(!numsuppscheckedmessage)

    !outputarray.append(!numsuppswitherrorsmessage)

    !outputarray.append(!totalerrorsmessage)

    !outputarray.append(!numsuppswithwarningsmessage)

    !outputarray.append(!totalwarningsmessage)

    !outputarray.append('************************************************************')
    !outputarray.append('End of report')
    !outputarray.append('************************************************************')
    if !this.output.val.eq(3) then
      --write output to screen
      do !value values !outputarray
        $P $!value
      enddo

      --write temp file to pdmswk
      !filenametemp = '%pdmswk%/MDS-HEALTH-CHECK-TEMP-REPORT.dat'
      !fileobjecttemp  = object file(!filenametemp)

      !fileobjecttemp.writefile('OVERWRITE',!outputarray)

      !fileobjecttemp.close()

      !this.mainfilename = !filenametemp

      !this.menu3.setfieldproperty('field2','ACTIVE',TRUE)
    elseif !this.output.val.eq(1) then
      --file output of load report and error report, date and time stamped, to directory chosen
      --by user

      --create file object

      !directoryname = !this.filenametext.val
      --!filename = !this.filenametext.val

      !dateandtime = !dateandtimeobj.datetimestr

      --!projobj = current project
      --!currentprojectcode = !projobj.code()

      --!projectcodeinfodirectory = '%' & !currentprojectcode & 'info%'

      !defaultdirectoryname = !this.defaultdirectory

      if !directoryname.eq('') then

        !!alert.error('No directory name entered, defaulting to $!defaultdirectoryname')
        --return
        !this.filenametext.val = !defaultdirectoryname
        --!this.filenametext.val = '%pdmswk%'

        !directoryname = !defaultdirectoryname
        --!directoryname = '%pdmswk%'

      endif

      --check a valid directory name has been entered

      !dirobject = object file(!directoryname)

      !type = !dirobject.type()
      handle ANY
        !!alert.error('Invalid directory name entered')
      elsehandle NONE
        if !type.eq('FILE') then
          !!alert.error('File name entered, valid directory name required')
        else
          --valid directory name, so write output to file

          !filename = !directoryname & '/MDS-HEALTH-CHECK-REPORT-' & !dateandtime & '.dat'

          --$P Writing MDS Health Check report to file $!filename

          !fileobject  = object file(!filename)

          --write file

          !fileobject.writefile('WRITE',!outputarray)

          --close file object
          !fileobject.close()

          !this.mainfilename = !filename

          --Writing MDS Health Check LOAD REPORT ONLY to file

          --!filenameload = !directoryname & '/MDS-HEALTH-CHECK-LOADREPORTONLY-' & !dateandtime & '.dat'

          --!fileobjectload  = object file(!filenameload)

          --!loaderrorstemparray = ARRAY()

          --!loaderrorstemparray.append('************************************************************')
          --!loaderrorstemparray.append('MDS Health Check Utility Loading Errors Report')
          --!loaderrorstemparray.appendarray(!this.health.loadmessageheader)
          --!loaderrorstemparray.append('************************************************************')
          --!loaderrorstemparray.appendarray(!this.health.loadmessage)
          --!loaderrorstemparray.append('Number of load errors = $!numloaderrors')
          --!loaderrorstemparray.append('************************************************************')
          --!loaderrorstemparray.append('End of report')
          --!loaderrorstemparray.append('************************************************************')

          --!fileobjectload.writefile('WRITE',!loaderrorstemparray)

          --!fileobjectload.close()

          !this.menu3.setfieldproperty('field2','ACTIVE',TRUE)

        endif
      endhandle
    endif
  endif

  !!ce = !storedce

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .CEmethod()
  !SuppName = !!MdsGetSuppName(!!CE)

  if !suppname.neq('ABORT') then
    --select CE support in relevant list (ancillaries/frames/hangers/trunnions)
    !type = !suppname.dbref().type

    !SuppName = !SuppName.after('/')

    if !type.eq('ATTA') then
      !this.ancillist.val = !SuppName
      handle ANY
        !!alert.warning('CE support not currently in ancillary list')
      endhandle
    elseif !type.eq('STRU') then
      !this.framelist.val = !SuppName
      handle ANY
        !!alert.warning('CE support not currently in framework list')
      endhandle
    --elseif !type.eq('HANG') then
    --elseif !type.eq('TRUN') then
    endif

  endif

endmethod
