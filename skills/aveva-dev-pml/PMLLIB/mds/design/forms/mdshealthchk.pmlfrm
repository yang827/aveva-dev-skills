-------------------------------------------------------------------------
define method .loadsupports(!mode is STRING)

  !this.health.loadsupports(!mode)

  --write to temporary file in pdsmwk
  --name MDS-HEALTH-CHECK-LOADREPORT-DATE-TIME
  --(other report to be named MDS-HEALTH-CHECK-REPORT-DATE-TIME

  !loaderrorstemparray = ARRAY()

  !numloaderrors = !this.health.loadmessage.size()

  !dateandtimeobj = object mdsdatetimeobj()

  !dateandtime = !dateandtimeobj.datetimestr

   if !this.output.val.eq(1) then
     --text
     --write to file in directory named
     !directoryname = !this.filenametext.val

     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.append('MDS Health Check Utility Loading Errors Report')
     !loaderrorstemparray.appendarray(!this.health.loadmessageheader)
     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.appendarray(!this.health.loadmessage)
     !loaderrorstemparray.append('Number of load errors = $!numloaderrors')
     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.append('End of report')
     !loaderrorstemparray.append('************************************************************')

     !filenameload = !directoryname & '/MDS-HEALTH-CHECK-LOADREPORTONLY-' & !dateandtime & '.dat'

     !fileobjectload  = object file(!filenameload)

     !fileobjectload.writefile('WRITE',!loaderrorstemparray)

     !fileobjectload.close()

     --write !this.loadfilewrittento for reading file from menu (.viewreports)
     !this.loadfilename = !filenameload
   elseif !this.output.val.eq(2) then
     --csv
     --write to file in directory named

     !directoryname = !this.filenametext.val

     !csvloadmessageheader = ARRAY()

     do !x index !this.health.loadmessageheader
       !csvloadmessageheader.append(!this.health.loadmessageheader[!x].replace(': ',',',1,1))
     enddo

     --!loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.append('MDS Health Check Utility Loading Errors Report')
     !loaderrorstemparray.appendarray(!csvloadmessageheader)
     !loaderrorstemparray.append('')
     !loaderrorstemparray.appendarray(!this.health.loadmessage)
     !loaderrorstemparray.append('Number of load errors = $!numloaderrors')
     !loaderrorstemparray.append('')
     !loaderrorstemparray.append('End of report')
     --!loaderrorstemparray.append('************************************************************')

     !filenameload = !directoryname & '/MDS-HEALTH-CHECK-LOADREPORTONLY-' & !dateandtime & '.csv'

     !fileobjectload  = object file(!filenameload)

     !fileobjectload.writefile('WRITE',!loaderrorstemparray)

     !fileobjectload.close()

     --write !this.loadfilewrittento for reading file from menu (.viewreports)

     !this.loadfilename = !filenameload
   elseif !this.output.val.eq(3) then
     --screen
     --output to temp file in pdmswk

     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.append('MDS Health Check Utility Loading Errors Report')
     !loaderrorstemparray.appendarray(!this.health.loadmessageheader)
     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.appendarray(!this.health.loadmessage)
     !loaderrorstemparray.append('Number of load errors = $!numloaderrors')
     !loaderrorstemparray.append('************************************************************')
     !loaderrorstemparray.append('End of report')
     !loaderrorstemparray.append('************************************************************')

     !filename = '%pdmswk%/MDS-HEALTH-CHECK-TEMP-LOADREPORT.dat'
     !fileobject  = object file(!filename)

     !fileobject.writefile('OVERWRITE',!loaderrorstemparray)

     !fileobject.close()

     --write !this.loadfilewrittento for reading file from menu (.viewreports)
     !this.loadfilename = !filename
   endif




-- If a framework is part of a group then remove the [?] from the display text
  --!FrameDisplayText = !this.health.fsupports

  --do !RemoveBrackets from 1 to !FrameDisplayText.size()
  --  if !FrameDisplayText[$!RemoveBrackets].match('[').gt(0) and !FrameDisplayText[$!RemoveBrackets].match(']').gt(0) then
       --!FrameDisplayText[$!RemoveBrackets] = !FrameDisplayText[$!RemoveBrackets].before('[') + ' (Group)'
-- Remove
  --     !FrameDisplayText[$!RemoveBrackets] = !FrameDisplayText[$!RemoveBrackets].before('[')
  --  endif
  --enddo

  --if !type.eq('ancil') then

  !this.supportlist.dtext = !this.health.supports

  !this.menu3.setfieldproperty('field1','ACTIVE',TRUE)
  !this.menu3.setfieldproperty('field2','ACTIVE',FALSE)

  --elseif !type.eq('frame') then
    --!this.framelist.dtext  = !framedisplaytext
    --!this.frame.rtext  = !fsupports
  --elseif !type.eq('hang') then

    ---!this.hanglist.dtext = !this.health.hsupports
    --!this.hanger.rtext = !hsupports

  --elseif !type.eq('trunn') then

  --endif

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .viewreports(!mode is STRING)
--method to view reports in notepad
  if !mode.eq('COMPLETE') then
    --q var !mode
    --load temporary health check report from %pdmswk%
    --!filename = '%pdmswk%/MDS-HEALTH-CHECK-TEMP-REPORT.dat'
    !filename = !this.mainfilename

    syscom 'c:/windows/system32/notepad.exe $!filename &'

  else

    --load temporary load report from %pdmswk%
    --q var !mode
    --!filename = '%pdmswk%/MDS-HEALTH-CHECK-TEMP-LOADREPORT.dat'

    !filename = !this.loadfilename

    syscom 'c:/windows/system32/notepad.exe $!filename &'
  endif
endmethod
-------------------------------------------------------------------------
----------------------------------------------------------------------
define method .checkexprn()
  -- Check Expression is valid before Proceeding
  -- This method original version in mdsnewreports.pmlfrm

    !runtime = !this.filtertext.val
    if (!runtime.trim().neq(||)) then
      --!textin.val = !textin.val.replace('|','''')
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all with ($!runtime) from !empty
      handle any
       !syntax = !!error.command.after('with ').before(' from').trim()
       return error 1 'Enter a valid expression'
      endhandle
    endif

endmethod
----------------------------------------------------------------------
----------------------------------------------------------------------
define method .checkdirectory()

  --method to check valid directory entered
  !directoryname = !this.filenametext.val

    --**************************
    !defaultdirectoryname = !this.defaultdirectory

    if !directoryname.eq('') then

      !!alert.error('No directory name entered, defaulting to $!defaultdirectoryname')
      --return
      !this.filenametext.val = !defaultdirectoryname
      --!this.filenametext.val = '%pdmswk%'

      !directoryname = !defaultdirectoryname
      --!directoryname = '%pdmswk%'

    endif

    --check a valid directory name has been entered

    !dirobject = object file(!directoryname)

    !type = !dirobject.type()
    handle ANY
      !!alert.error('Invalid directory name entered')
    elsehandle NONE
      if !type.eq('FILE') then
        !!alert.error('File name entered, valid directory name required')
      else
        --valid directory name entered - OK to continue
      endif
    endhandle
endmethod
----------------------------------------------------------------------

define method .removesupports(!Mode is STRING)

-- The menu will pass either ALL to remove all supports from list
-- or CE for the current element

  if !Mode.eq('ALL') then
    if !this.supportlist.dtext.size().eq(0) then
      !!alert.Error('No support/s selected')
      return
    endif
    !this.supportlist.clear()
    !this.menu3.setfieldproperty('field1','ACTIVE',FALSE)
  elseif !Mode.eq('SELECTED') then
    !Selected = !this.supportlist.val
    if !Selected.size().eq(0) then
      !!alert.error('No support/s selected')
      return
    endif
    !Dtext = !this.supportlist.dtext
    !Rtext = !this.supportlist.rtext
    do !remove values !Selected
      !Dtext[$!remove].delete()
      !Rtext[$!remove].delete()
    enddo
    !Dtext.compress()
    !Rtext.compress()
    if !Dtext.size().gt(0) then
      !this.supportlist.dtext = !Dtext
      !this.supportlist.rtext = !Rtext
    else
      !this.menu3.setfieldproperty('field1','ACTIVE',FALSE)
    endif
  else
    !!alert.error('Invalid mode passed')
  endif


endmethod
