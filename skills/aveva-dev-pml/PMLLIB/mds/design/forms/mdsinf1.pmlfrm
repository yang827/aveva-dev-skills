--
-- File:		MdsInf1.frm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Wed Jun 18
--
--
-- Description:
-- Form Definition for Mds Interface 1
--
--------------------------------------------------------------------------------

-- Kill existing form definition

Kill !!MdsInf1

-- Define Form

setup form  !!MdsInf1

  !!MdsInf1.formtitle    = |MDS/LICAD Interface Data|
  !!MdsInf1.icontitle    = ||
  !!MdsInf1.callback     = ||
  !!MdsInf1.formrevision = ||

  -- Body of Form

  path down
  vdist 0.5

  para .PSupport     text |Support name :  |
  para .PDiameter    text |Pipe Diameter:  |
  para .PTemperature text |Temperature  :  |
  para .PInsulation  text |Insulation   :  |
  para .PLoad        text |Load         :  |
  para .PMoveX       text |Movement X   :  |
  para .PMoveY       text |Movement Y   :  |
  para .PMoveZ       text |Movement Z   :  |

  para .Support      at xmax_PSupport ymin_PSupport width 14 lines 1
  para .Diameter     width 14 lines 1
vdist 0.6
  text .Temperature  width 14 type real
  para .Insulation   width 14 lines 1
  text .Load        width 14 type real
  text .MoveX       width 14 type real
  text .MoveY       width 14 type real
  text .MoveZ       width 14 type real

  !This.Support.val = 'PS100'
  !This.Diameter.val = '219.1'
  !This.Temperature.val = 25
  !This.Insulation.val = '40'
  !This.Load.val = 50
  !This.MoveX.val = 100
  !This.MoveY.val = 100
  !This.MoveZ.val = 100

  -- Bottom Line
  button .Cancel  | Dismiss | at xmax form-size ymax+0.5
  button .Ok      | Enter LICAD | at x0 ymin call ||

-- End form definition
exit
