--
-- File:        MdsInfill.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:	MDS
--   Module:	Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Friday 2nd September 2005
--
--
-- Description:
-- Form Definition for the autonaming infill utility
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(form)                       -
--  ok()                             -
--

-- Kill existing form definition

kill !!MdsInfill

-- Define Form
setup form !!MdsInfill

  !!MdsInfill.formtitle    = |Support Name Infill|
  !!MdsInfill.icontitle    = ||
  !!MdsInfill.callback     = ||
  !!MdsInfill.formrevision = ||

-- Support Names List

  list   .Name   |Names Available| width 32 lines 20

-- Bottom Row

  button .OK     |   OK   | at x0 ymax+1 call |!this.ok()| OK
  button .cancel | Cancel | at xmax form-size ymin cancel

  member .form is form

exit

-- End of form definition MdsInfill.pmlfrm

----------------------------------------------------------------------
define method .init(!form is form)
----------------------------------------------------------------------

  !this.form = !form

-- Get the lower and upper index number

  !LowerIndex = !!MdsAutoName.MinIndex.val
  !UpperIndex = !!MdsAutoName.Index.val

-- Start from the lower index to the current index to get the support name available

  !Prefix = !!MdsAutoName.Prefix.val
  !Suffix = !!MdsAutoName.Suffix.val

  if !Prefix.eq('unset') then
    !Prefix = ''
  endif

  if !Suffix.eq('unset') then
    !Suffix = ''
  endif

  if !Prefix.neq('') then
    !NPrefix = ($!Prefix)
      handle any
        !NPrefix = |$!Prefix|
      endhandle
  else
    !NPrefix = ''
  endif

  if !Suffix.neq('') then
    !NSuffix = ($!Suffix)
      handle any
        !NSuffix = |$!Suffix|
      endhandle
  else
    !NSuffix = ''
  endif

  !Dtext = ARRAY()
  do !Index from !LowerIndex.real() to !UpperIndex.real()
    !NameToTest = '/' + !NPrefix + !Index.string() + !NSuffix
    !TestName = $!NameToTest
      handle none
        !Dtext.append('$!NameToTest')
      elsehandle any
      endhandle
  enddo

  if !Dtext.size().gt(0) then
    !this.name.dtext = !Dtext
    show !!MdsInfill
  else
    !!Alert.Error('No missing names found!')
  endif

endmethod

define method .ok()

  !this.form.name = !this.name.dtext[!this.name.val].after('/')

endmethod


--
-- End of file MdsInfill.pmlfrm
--
