define method .apply()

  !continue = !this.checkPrelim()
  if !continue.not() then
    return
  endif

  if(!this.name.val.upcase().eq('UNSET') or !this.name.val.eq('')) then
    !this.ok.active = FALSE
    !!alert.error('The Name of the Hanger is unset' )
    return error 1 noalert
  endif

  -- initialise the appropriate form
  if (!this.type.eq('TYPE1')) then
    !!mdsVendorHangerType1.steelmem = !this.beamRef
    !!lisgroup = 1
    !this.configNumber = 1
    !!mdsiHangerType1('CREATE', !this.name.val, 'MH01', 1, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE2')) then
    !!mdsVendorHangerType2.steelmem = !this.beamRef
    !!lisgroup = 2
    !this.configNumber = 2
    !!mdsiHangerType2('CREATE', !this.name.val, 'MH01', 2, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE31')) then
    !!mdsVendorHangerType31.steelmem = !this.beamRef
    !!lisgroup = 31
    !this.configNumber = 31
    !!mdsiHangerType31('CREATE', !this.name.val, 'MH01', 31, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE32')) then
    !!mdsVendorHangerType32.steelmem = !this.beamRef
    !!lisgroup = 32
    !this.configNumber = 32
    !!mdsiHangerType32('CREATE', !this.name.val, 'MH01', 32, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE7')) then
    !!mdsVendorHangerType7.steelmem = !this.beamRef
    !!lisgroup = 7
    !this.configNumber = 7
    !!mdsiHangerType7('CREATE', !this.name.val, 'MH01', 7, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE21')) then
    !!mdsVendorHangerType21.steelmem = !this.beamRef
    !!lisgroup = 21
    !this.configNumber = 21
    !!mdsiHangerType21('CREATE', !this.name.val, 'MH01', 21, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE18')) then
    !!mdsVendorHangerType18.steelmem = !this.beamRef
    !!lisgroup = 18
    !this.configNumber = 18
    !!mdsiHangerType18('CREATE', !this.name.val, 'MH01', 18, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE19')) then
    !!mdsVendorHangerType19.steelmem = !this.beamRef
    !!lisgroup = 19
    !this.configNumber = 19
    !!mdsiHangerType19('CREATE', !this.name.val, 'MH01', 19, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE20')) then
    !!mdsVendorHangerType20.steelmem = !this.beamRef
    !!lisgroup = 20
    !this.configNumber = 20
    !!mdsiHangerType20('CREATE', !this.name.val, 'MH01', 20, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE25')) then
    !!mdsVendorHangerType25.steelmem = !this.beamRef
    !!lisgroup = 25
    !this.configNumber = 25
    !!mdsiHangerType25('CREATE', !this.name.val, 'MH01', 25, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE6')) then
    !!mdsVendorHangerType6.steelmem = !this.beamRef
    !!lisgroup = 6
    !this.configNumber = 6
    !!mdsiHangerType6('CREATE', !this.name.val, 'MH01', 6, !this.tubeRef, !this.beamRef)
  elseif (!this.type.eq('TYPE600')) then
    !!mdsVendorHangerType600.steelmem = !this.beamRef
    !!lisgroup = 600
    !this.configNumber = 600
    !!mdsiHangerType600('CREATE', !this.name.val, 'MH01', 600, !this.tubeRef, !this.beamRef)
  endif

endmethod

define method .siteCheck(!hangerCategory is STRING)
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !this.hangerCategory = !hangerCategory
  !!mdssitecheck(!!mdsInterfaceHanger)
  !!mdsInterfaceHanger.ok.callback = |!this.apply()|
  !!kRestoreUnits(!currentUnits)
endmethod

define method .cancel()

  if(!this.tubeRef.set() and (not !this.tubeRef.badref())) then
    !toUnEnhance = !this.tubeRef
    unenhance pipe of $!toUnEnhance
  endif

  if(!this.beamRef.set() and !this.beamRef.size() gt 0) then
    -- un enhance previous beams
    do !beamToUnEnhance values !this.beamRef
      if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
        unenhance $!beamToUnEnhance
      endif
    enddo
  endif
  !!mdsResetAutoName(!this)

endmethod

-- Deactivate menu when using the interface mode
define method .manifActions()

  if (!!mdsHangIf.upcase().eq('LISEGA')) then

    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      -- AREVA MDS-LICAD Hanger Interface Only
      !this.filt6.active = FALSE
      !this.filt6.val    = FALSE
      !this.filt600.active = FALSE
      !this.filt600.val    = FALSE
    else
      -- STANDARD MDS-LICAD HANGER Interface
      !this.filt6.active = TRUE
      !this.filt6.val    = FALSE
      !this.filt600.active = TRUE
      !this.filt600.val    = FALSE
    endif

    !this.filt17.active = TRUE
    !this.filt1.val = FALSE
    !this.filt2.val = FALSE
    !this.filt31.val = FALSE
    !this.filt32.val = FALSE
    !this.filt17.val = FALSE
    !this.filt21.val = FALSE
    !this.filt18.val = FALSE
    !this.filt19.val = FALSE
    !this.filt20.val = FALSE
    !this.filt25.val = FALSE
    !this.ok.active = FALSE

    --angulating supports are active in Licad for all versions
    !this.filt21.active = TRUE
    !this.filt25.active = TRUE

  elseif (!!mdsHangIf.upcase().eq('PSL')) then

    --<RM>REFACTOR removed !this.standard.active = FALSE

    --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
    !this.filt6.active = TRUE
    !this.filt6.val    = FALSE
    !this.filt600.active = FALSE
    !this.filt600.val    = FALSE
    !this.filt21.active = FALSE
    !this.filt25.active = FALSE
    --<wd>04nov2009 - DFN P-26451 - SI-18252

    --<RM>REFACTOR removed !this.view.active = FALSE
    --<RM>REFACTOR removed !this.viewC.active = FALSE
    !this.filt17.active = TRUE
    --<RM>REFACTOR removed !this.standard.active = FALSE
    !this.filt1.val = FALSE
    !this.filt2.val = FALSE
    !this.filt31.val = FALSE
    !this.filt32.val = FALSE
    !this.filt17.val = FALSE
    !this.filt21.val = FALSE
    !this.filt18.val = FALSE
    !this.filt19.val = FALSE
    !this.filt20.val = FALSE
    !this.filt25.val = FALSE
    !this.ok.active = FALSE

  elseif (!!mdsHangIf.upcase().eq('CPL')) then

    --<RM>REFACTOR removed !this.standard.active = FALSE

    --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
    !this.filt6.active = TRUE
    !this.filt6.val    = FALSE
    !this.filt600.active = FALSE
    !this.filt600.val    = FALSE
    --<wd>04nov2009 - DFN P-26451 - SI-18252

    --<RM>REFACTOR removed !this.view.active = FALSE
    --<RM>REFACTOR removed !this.viewC.active = FALSE
    !this.filt17.active = TRUE
    --<RM>REFACTOR removed !this.standard.active = FALSE
    !this.filt21.active = FALSE
    !this.filt25.active = FALSE
    !this.filt1.val = FALSE
    !this.filt2.val = FALSE
    !this.filt31.val = FALSE
    !this.filt32.val = FALSE
    !this.filt17.val = FALSE
    !this.filt21.val = FALSE
    !this.filt18.val = FALSE
    !this.filt19.val = FALSE
    !this.filt20.val = FALSE
    !this.filt25.val = FALSE
    !this.ok.active = FALSE

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      testPreliminarySupportName
--
-- Description: Check if preliminary support name in name box.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------
define method .testPreliminarySupportName() is BOOLEAN

  -- check if support with given name exists already (can be preliminary support)
  !fromAtta = false
  if (!this.name.val.neq('unset')) then
    !datum = object DBREF('/' & !this.name.val)
    handle ANY
    elsehandle NONE
      !isPreliminarySupp = !!mdsaliaslist(!datum.:MDSSuppType).match('PR').eq(1)
      handle ANY
      elsehandle NONE
        !fromAtta = !isPreliminarySupp
      endhandle
    endhandle
  endif
  return !fromAtta

endmethod

define method .fromExistingAtta()

  --clear down any existing selections before updating the tuberef
  unenhance pipe of $!this.tubeRef
  handle ANY
  endhandle
  refresh

  !!mdsIdPreliminarySupp(!this)
  if (!!mdsInterfaceHanger.name.val NEQ 'unset') then
    !!mdsInterfaceHanger.tubeRef = object DBREF('/' & !!mdsInterfaceHanger.name.val)
  endif

endmethod

define method .checkPrelim() is BOOLEAN

  !preliminary = object DBREF('/' & !this.name.val)
  handle ANY
    --the prelim data does not exist so just run the hanger creation
    return TRUE
  elsehandle none
    -- test if the selected item has the same support function as the preliminary support
    -- if no then show warning - if the answer is 'YES' then replace :mdssuppfunc of new atta

    --try and find the SUPF entry for 'MH01' in the MDS/APPDEFAULTS db
    !appDefName = '/MDS/ATTA/DEFAULTS/MH01/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !hangSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !hangSuppFunc = $!appDefRef.ppro
    endhandle

    !prelimSuppFunc = !preliminary.:mdssuppfunc

    if (!hangSuppFunc neq !prelimSuppFunc) then
      !result = !!alert.confirm('The selected preliminary support has a support function of ' + !prelimSuppFunc + ' but the chosen vessel support function is ' + !hangSuppFunc + '. Do you want to continue?')
      if (!result eq 'YES') then
        return TRUE
      else
        return FALSE
      endif
    else
      return TRUE
    endif

  endhandle

endmethod
