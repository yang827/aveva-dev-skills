--
-- File:    mdsinterfacehanger.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--
-- Author:    R.martin
-- Created:   Wed December 01 2009
--
-- Description:
-- Form Definition for Hangers that are created by a manufacturers interface (LICAD,PSL,WITCHANGER)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  checkPrelim()                    BOOLEAN
--  createAngulatingHangerToCivilsType25() -
--  createAngulatingHangerType21()   -
--  createDoubleBackToBackChannelHangerType32() -
--  createDoubleBeamHangerType31()   -
--  createDoubleChannelHangerType2() -
--  createDoubleHangerToCivilsType19() -
--  createDynamicHangerToCivilsType20() -
--  createDynamicHangerType7()       -
--  createFixedHangerToCivilsType18() -
--  createFixedHangerType1()         -
--  createPedestalSupportType6()     -
--  createSpringSupportType600()     -
--  fromExistingAtta()               -
--  manifActions()                   -
--  siteCheck(STRING)                -
--  testPreliminarySupportName()     BOOLEAN             Check if preliminary support name in name box.
--

-- Kill existing form definition
kill !!mdsInterfaceHanger

-- Define Form
setup form !!mdsInterfaceHanger

  !!mdsInterfaceHanger.formtitle    = ||
  !!mdsInterfaceHanger.icontitle    = ||
  !!mdsInterfaceHanger.callback     = |call !!mdsiInterfaceHanger()|
  !!mdsInterfaceHanger.formrevision = | $Revision: 1.0$ |

  -- Body of Form
  text .name     |Name :| at x0 y0.5 call |CALLIB NAMECHK _mdsInterfaceHanger_Name $$<$$_CDSYSNAM_CASE$$> $$<$$_CDSYSNAM_NAME$$>
  call !!mdsSupportForm(!!mdsInterfaceHanger)
  call !!mdsSetSuppInterface(!!mdsInterfaceHanger)| width 20 name

  menu .autonamemenu
    add 'Select Naming File...' call |show !!mdsautoname|
  exit

  button .autoname | | tooltip 'Autoname' pixmap width 19 height 19 call |!!mdsautoname.getNextName(!this)|
  !this.autoname.setPopup(!this.autonamemenu)

  button .set | | at xmax+1 ymin tooltip '' pixmap width 19 height 19 call ||
  !this.set.active = FALSE

  button .addGroup   | | at xmax+1 ymin tooltip 'Add to Support Group' pixmap width 19 height 19 call |Call !!mdsGroup('ADD',!this)|
  button .fromexisting | | at xmax+1 ymin tooltip 'From existing preliminary support' pixmap width 19 height 19 call |!this.fromExistingAtta ()|

  path right

  path down
  vdist 0.1

  !length = !!mdsFormFix
  handle NONE
  elsehandle ANY
    !length = '14'
  endhandle

  path down

  --if !length.eq('1') then
  --  list .standard || at xmin_name ymax+0.5 call |!this.setListActions()| width 40 length $!length
  --else
  --  list .standard |Standard support type:| at xmin_name ymax+0.5 call |!this.setListActions()| width 58 length $!length
  --endif
  -- The global variable !!mdsHangIf should be set to LISEGA/PSL/CPL/MDS enabling the correct interface to use
  -- If not set default to MDS

  !unusedTestForInfVar = !!mdsHangIf
  handle ANY
    !!mdsHangIf = 'MDS'
  endhandle

  -- OK we have decided what interface set the members to tell to use set the active variables
  path down

  frame .filterFrame 'Available Support Types' at XMIN FORM width 40
    paragraph .filterByMsg   at ymin+0.8 text 'Type:'
    path right
    hdist .75
    button .filt1 toggle tooltip 'Single Hanger connected to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.createFixedHangerType1()|
    button .filt2 toggle tooltip 'Single Hanger connected the top of a Double Channel Beam' pixmap width 18 height 18 call |!this.createDoubleChannelHangerType2()|
    button .filt31 toggle tooltip 'Two hangers connected to One/Two Beams' pixmap width 18 height 18 call |!this.createDoubleBeamHangerType31()|
    button .filt32 toggle tooltip 'Two hangers connected to One/Two Double Channel Beams' pixmap width 18 height 18 call |!this.createDoubleBackToBackChannelHangerType32()|
    button .filt17 toggle tooltip 'Dynamic Hanger connected to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.createDynamicHangerType7()|
    button .filt21 toggle tooltip 'Angulating Spring Supports to the bottom of a Single Beam' pixmap width 18 height 18 call |!this.createAngulatingHangerType21()|
    hdist 2
    button .filt18 toggle tooltip 'Single Hanger connected to Civils' pixmap width 18 height 18 call |!this.createFixedHangerToCivilsType18()|
    hdist .75
    button .filt19 toggle tooltip 'Two hangers connected to Civils' pixmap width 18 height 18 call |!this.createDoubleHangerToCivilsType19()|
    button .filt20 toggle tooltip 'Dynamic Hanger connected to Civils' pixmap width 18 height 18 call |!this.createDynamicHangerToCivilsType20()|
    button .filt25 toggle tooltip 'Angulating Spring Supports to Civils' pixmap width 18 height 18 call |!this.createAngulatingHangerToCivilsType25()|
    hdist 2
    button .filt6 toggle tooltip 'Bottom of Pipe Supports to Steelwork' pixmap width 18 height 18 call |!this.createPedestalSupportType6()|
    button .filt600 toggle tooltip 'Bottom of Pipe Spring Supports' pixmap width 18 height 18 call |!this.createSpringSupportType600()|

  exit

  path down
  vdist 0.1

  -- Bottom Line

  button .ok     |   OK   | at xmin           ymax+0.5 call ||
  button .cancel | Cancel | at xmax FORM-size ymin call |!this.cancel()|

  -- Form Members

  -- Form Name of Support
  member .suppForm     is FORM

  -- User replacement text for support name
  member .replacement  is STRING

  -- Save suppFunction for later on list button
  member .oldFunction  is STRING

  -- fixed hanger types container
  member .formHangerTypes is MDSINTERFACEHANGERTYPES

  -- fixed filtered hanger types container
  member .filteredHangerTypes is MDSINTERFACEHANGERTYPES

  -- backup of the standard list dtext
  member .standardDtexBackup is ARRAY

  -- backup of the standard list rtext
  member .standardRtexBackup is ARRAY

  -- Index of the active filter. if zero (0) no active filter
  member .oRadio  is MDSTOGGLEBUTTONRADIO
  member .oMenuRadio is MDSMENUTOGGLERADIO

  -- Defines filter modes
  member .activeFilterMode is STRING

  -- filter numbers
  member .oneHangerSingleBeamFilterNumber is REAL
  member .oneHangerDoubleBeamFilterNumber is REAL
  member .doubleHangerSingleBeamFilterNumber is REAL
  member .doubleHangerDoubleBeamFilterNumber is REAL
  member .doubleHangerCompoundFilterNumber is REAL
  member .offsetHangerFilterNumber is REAL
  member .pipeHangerFilterNumber is REAL
  member .bottomSupportedFilterNumber is REAL
  member .bottomSupportedSpringFilterNumber is REAL
  member .dynamicFilterNumber is REAL
  member .anyFilterNumber is REAL
  member .civilPlateFilterNumber is REAL
  member .civilPlateDoubleFilterNumber is REAL
  member .noFilterNumber is REAL
  member .angulatingSpringsSteelFilterNumber is REAL
  member .angulatingSpringsCivilFilterNumber is REAL

  -- Support Manufacturers Interface
  member .configNumber is REAL
  member .tubeRef is DBREF
  member .beamRef is ARRAY

  member .lastActivatedTubeRef is DBREF
  member .lastActivatedBeamRef is ARRAY
  member .hangerCategory is STRING


  --<RM> -- REFACTOR ADDED MEMBERS
  member .type is STRING

exit

-- Configure icons dependant on interface being used
if ( defined(!!manif.exe)) then
  if (!!manif.exe.exists()) then
    if  (!!mdsHangIf.eq('LISEGA')) then

      --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
      !tempDesc = (desc of /MDS/TEMPLATES )
      if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
        -- AREVA MDS-LICAD Hanger Interface Only
        !this.filt6.active = FALSE
        !this.filt6.val    = FALSE
        !this.filt600.active = FALSE
        !this.filt600.val    = FALSE
      else
        -- STANDARD MDS-LICAD HANGER Interface
        !this.filt600.active = TRUE
        !this.filt600.val    = FALSE
      endif
      --<wd>04nov2009 - DFN P-26451 - SI-18252
			
    elseif  (!!mdsHangIf.eq('PSL')) then

      --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
      !this.filt6.active = TRUE
      !this.filt6.val    = FALSE
      !this.filt600.active = FALSE
      !this.filt600.val    = FALSE
      !this.filt21.active = FALSE
      !this.filt21.val    = FALSE
      !this.filt25.active = FALSE
      !this.filt25.val    = FALSE
      --<wd>04nov2009 - DFN P-26451 - SI-18252

    elseif  (!!mdsHangIf.eq('CPL')) then

      --<wd>04nov2009 - DFN P-26451 - SI-18252 - Activate / Deactivate the buttons .filt6 and .filt600
      !this.filt6.active = TRUE
      !this.filt6.val    = FALSE
      !this.filt600.active = FALSE
      !this.filt600.val    = FALSE
      !this.filt21.active = FALSE
      !this.filt21.val    = FALSE
      !this.filt25.active = FALSE
      !this.filt25.val    = FALSE
      --<wd>04nov2009 - DFN P-26451 - SI-18252

    endif
  endif
endif

-- Set the pix maps for the icons
!this.filt1.addPixmap(!!pml.getPathName('hfilt1.png'), !!pml.getPathName('hfilt1.png'), !!pml.getPathName('hfilt1off.png'))
handle ANY
endhandle
!this.filt2.addPixmap(!!pml.getPathName('hfilt2.png'), !!pml.getPathName('hfilt2.png'), !!pml.getPathName('hfilt2off.png'))
handle ANY
endhandle
