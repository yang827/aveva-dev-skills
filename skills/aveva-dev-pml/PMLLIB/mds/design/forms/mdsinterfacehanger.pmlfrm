handle ANY
endhandle
!this.filt33.addPixmap(!!pml.getPathName('hfilt33.png'), !!pml.getPathName('hfilt33.png'), !!pml.getPathName('hfilt33off.png'))
handle ANY
endhandle
!this.filt4.addPixmap(!!pml.getPathName('hfilt4.png'), !!pml.getPathName('hfilt4.png'), !!pml.getPathName('hfilt4off.png'))
handle ANY
endhandle
!this.filt5.addPixmap(!!pml.getPathName('hfilt5.png'), !!pml.getPathName('hfilt5.png'), !!pml.getPathName('hfilt5off.png'))
handle ANY
endhandle
!this.filt6.addPixmap(!!pml.getPathName('hfilt6.png'), !!pml.getPathName('hfilt6.png'), !!pml.getPathName('hfilt6off.png'))
handle ANY
endhandle
!this.filt600.addPixmap(!!pml.getPathName('hfilt600.png'), !!pml.getPathName('hfilt600.png'), !!pml.getPathName('hfilt600off.png'))
handle ANY
endhandle
!this.filt17.addPixmap(!!pml.getPathName('hfilt17.png'), !!pml.getPathName('hfilt17.png'), !!pml.getPathName('hfilt17off.png'))
handle ANY
endhandle
!this.filt18.addPixmap(!!pml.getPathName('hfilt18.png'), !!pml.getPathName('hfilt18.png'), !!pml.getPathName('hfilt18off.png'))
handle ANY
endhandle
!this.filt19.addPixmap(!!pml.getPathName('hfilt19.png'), !!pml.getPathName('hfilt19.png'), !!pml.getPathName('hfilt19off.png'))
handle ANY
endhandle
!this.filt20.addPixmap(!!pml.getPathName('hfilt20.png'), !!pml.getPathName('hfilt20.png'), !!pml.getPathName('hfilt20off.png'))
handle ANY
endhandle
!this.filt21.addPixmap(!!pml.getPathName('hfilt21.png'), !!pml.getPathName('hfilt21.png'), !!pml.getPathName('hfilt21off.png'))
handle ANY
endhandle
!this.filt25.addPixmap(!!pml.getPathName('hfilt25.png'), !!pml.getPathName('hfilt25.png'), !!pml.getPathName('hfilt25off.png'))
handle ANY
endhandle

-- Set icons
!!mdsSetIconBack(!!mdsInterfaceHanger,'white')

define method .createFixedHangerType1()

  --test to see whether or not this support is being created from an existing preliminary support
  --if it is then the following actions will be taken
  --1) the selection function will not require the user to make a tube selection
  --2) this.tubeRef will be set as the prelim support owner
  !fromAtta = !this.testPreliminarySupportName()

  --dun1218 run manifactions() to clear down any buttons that are set active
  !this.manifActions()

  --only unenhance and clear the tuberef if we are not creating from a preliminary support atta
  if !fromAtta.not() then
    --dun1218 unenhance the previous selections if set
    unenhance pipe of $!this.tubeRef
    handle ANY
    endhandle
    !this.tubeRef = object DBREF()
  else
    --check the validity of the tube selection implied by the preliminary atta
    !hangerType = 1
    !valid = !!mdscheckinterfacetube(!this.tubeRef, !hangerType)
    handle 1
      !valid = FALSE
    elsehandle 2
      !valid = FALSE
    endhandle

    if !valid.not() then
      --exit, no messages are required because they have already been displayed during the check
      return
    endif
  endif

  do !i from 1 to !this.beamRef.size()
    unenhance $!this.beamRef[$!i]
    handle ANY
    endhandle
  enddo
  !this.beamRef = object ARRAY()
  refresh


  --reset the pin data to make sure we are not picking up any erroneous data from a previous run
  !!mdsResetPins(1,10)

  !this.type = 'TYPE1'
  !selectFixedHanger = object MDSINTERFACEHANGERTYPES()

  --make the required selections
  !selectionData = !selectFixedHanger.type1Selection(!fromAtta)

  --if the selectionData is unset then the user has exited from the selection process
  --via the escape key therefore just quit out here
  if !selectionData.unset() then
    !this.manifActions()
    return
  endif

  --if we are creating the support from a preliminary support atta then tuberef has already been set during the .fromExistingAtta method
  if !fromAtta.not() then
  !tubeRef = !selectionData[1]
  if !tubeRef.unset() then
    !this.manifActions()
    return
  endif
  endif

  !beamRef1 = !selectionData[2]
  if !beamRef1.unset() then
    !this.tubeRef = object DBREF()
    !this.manifActions()
    return
  endif

  !beamarray = ARRAY()
  !beamarray.append(!beamRef1)
  --if we are creating the support from a preliminary support atta then tuberef has already been set during the .fromExistingAtta method
  if !fromAtta.not() then
    !this.tubeRef = !tubeRef
  endif
  !this.beamRef = !beamarray

  --dun1218 enhance the selected elements if set
  enhance bran of $!this.tubeRef
  handle ANY
  endhandle
  do !i from 1 to !this.beamRef.size()
    enhance $!this.beamRef[$!i]
    handle ANY
    endhandle
  enddo

  --set the ok button to active or not
  if(!this.name.val.upcase().eq('UNSET') or !this.name.val.eq('')) then
    !this.ok.active = FALSE
  else
    !this.ok.active = TRUE
  endif

endmethod

