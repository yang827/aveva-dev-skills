--
-- File: mdsjointangle.pmlfrm
--   Type: Form Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Design
--   Replaces:
--
-- Author: David Whiteside
-- Created: Tues 8th January 2008
--
--
-- Description:
-- Form Definition for angle of rotation of joint.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  rotate()                         -
--

-- Kill existing form definition
Kill !!mdsjointangle

-- Define Form
setup form  !!mdsjointangle at xr0 yr0

  !!mdsjointangle.formtitle    = |Joint Angle|
  !!mdsjointangle.icontitle    = |JOINTS|
  !!mdsjointangle.callback     = ||
  !!mdsjointangle.formrevision = | $Revision: 1 $ |
  !jointname = !!ce.fullname.after('/')
  !betangle  = !!ce.bangle

   para .name at x0.5 y0.5 text 'Joint   $!jointname'
   path down
   halign left
   text   .bang |Beta Angle | call |!this.rotate()| width 7 numeric min -180 max 180

   button .dismiss  | Dismiss | at xmax form-size ymax+0.5 call |!this.cancel()| OK

   !!mdsjointangle.bang.val = |$!betangle|
exit


-----------------------------------------------------------------------------------------------------
define method .rotate()
-----------------------------------------------------------------------------------------------------

  !bangle = !this.bang.val
   bangle $!bangle

endmethod

-----------------------------------------------------------------------------------------------------
define method .cancel()
-----------------------------------------------------------------------------------------------------

  kill !!mdsjointangle

endmethod
