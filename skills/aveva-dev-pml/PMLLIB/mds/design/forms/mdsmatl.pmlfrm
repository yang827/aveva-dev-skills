-- Description:
-- Ancillary Selection Filtered by Material - Non User Form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  SetList()                        -
--  addstd(STRING,STRING,STRING)     -
--  findmat(STRING)                  GADGET
--  populate()                       -
--  totals()                         -
--

Kill !!MdsMatl

setup form  !!MdsMatl
  member .NumberOfMaterials is real
  !this.NumberOfMaterials = 50
  !this.formtitle = 'Ancillaries available filtered by material'
  do !Count from 1 to $!this.Numberofmaterials
    list .l$!count  '          ' at x10 y0 width 80 length 20
  enddo
  para .total at x10 ymax width 25
  list .list 'Materials' at x0 y0 callback '!This.setlist()' width 5 length 20
-- End form definition

exit

---------------------------------------------------------------------------------------

do !Deactivate from 1 to $!this.Numberofmaterials
  !Gadget = !!MdsMatl.L$!Deactivate
  !Gadget.active = FALSE
enddo

define method .addstd(!MatlString is STRING,!Rtext is STRING,!Dtext is STRING)

  !Gadget = object gadget()
  !TrimmedString = !MatlString.trim()

-- Find a gadget with the passed string

  do !Loop from 1 to $!this.Numberofmaterials
    !testGadget = !this.L$!Loop
    if !testGadget.tag.trim().eq(!TrimmedString) then
      !Gadget = !this.L$!Loop
    endif
  enddo

-- If you cannot find one add it

  if !Gadget.unset() then
    do !Loop from 1 to $!this.Numberofmaterials
      !testGadget = !this.L$!Loop
      if !testGadget.tag.trim().eq('') then
        !testgadget.tag = !TrimmedString
        !Gadget = !testgadget
        !Gadget.active = TRUE
        !!MdsMatlD$!TrimmedString = ARRAY()
        !!MdsMatlR$!TrimmedString = ARRAY()
        break
      endif
    enddo
  endif

-- Add to the material list
  !CurrentList =!this.list.dtext
  !CurrentList.append(!TrimmedString)
  !CurrentList.unique()
  !this.list.dtext = !CurrentList

  !!MdsMatlD$!TrimmedString$n.Append(!dtext)
  !!MdsMatlR$!TrimmedString$n.Append(!rtext)

  --!ExistingDtext = !Gadget.dtext
  --!ExistingRtext = !Gadget.rtext
  --!ExistingDtext.Append(!Dtext)
  --!ExistingRtext.Append(!Rtext)
  --!Gadget.Dtext = !ExistingDtext
  --!Gadget.Rtext = !ExistingRtext

  return !Gadget

endmethod

define method .totals()

  !Selected = !this.list.val
  !this.total.val = 'Total Available =' + !this.L$!Selected$n.dtext.size().string()

endmethod

define method .populate()
  -- clear down global arrays
  do !I to $!this.Numberofmaterials
    !Gadget = !this.L$!I
    if !Gadget.active then
      !Tag = !Gadget.tag.trim()
      !!MdsMatlD$!Tag = ARRAY()
      !!MdsMatlR$!Tag = ARRAY()
    endif
  enddo

  !AllDtext = ARRAY()
  !AllRtext = ARRAY()
  !StdDtext = ARRAY()
  !StdRtext = ARRAY()
  !Counter = 1
  do !LoopThrough values !!MdsAllAncill.Standard.Rtext
    if !LoopThrough.eq('PIPE-REST') or !LoopThrough.eq('PIPE-REST-INLINE') or !LoopThrough.eq('RACK-REST') or !LoopThrough.eq('SPECIAL') then
      !StdDtext.append(!!MdsAllAncill.Standard.Dtext[$!Counter])
      !StdRtext.append(!!MdsAllAncill.Standard.Rtext[$!Counter])
      !Counter = !Counter + 1
      skip
    endif

---------------------------------------------------------------------------------------------------
--<wd>mar2006<mds12>
--
-- At MDS12 the MDS ANCILLARY Standards AT29, AT31 and AT105 now exist as AT29A and
-- AT29B, AT31A and AT31B, AT105A and AT105A, therefore this PMLCODE is NOT REQUIRED
--
--    if !LoopThrough.eq('AT29') or !LoopThrough.eq('AT31') or !LoopThrough.eq('AT105')then
--      !Suffix = 'A'
--    else
--      !Suffix = ''
--    endif
--
-- MDS12 The PIPE material values are now determined from the NEW PARAGON
-- "/MDS/ATTA/DEFAULTS" -- MDS ANCILLARY Defaults Catalogue
--
    --!Materials = !!MDSPar$!LoopThrough$!Suffix$n[0].pipematerial
    --handle ANY
    --  $P !!MDSPar$!LoopThrough[0].pipematerial
    --  $P $!!Error.text
    --  !Counter = !Counter + 1
    --  skip
    --elsehandle NONE
    --endhandle

-- Check if the ZERO BORE PIPEMATERIAL Data Element EXISTS in the MDS DEFAULTS Catalogue
    !zeroborepmat = /MDS/ATTA/DEFAULTS/$!<loopthrough>/0/PIPEMATERIAL
    handle ANY
-- Echo ERROR to the Command Window & SKIP
      $P /MDS/ATTA/DEFAULTS/$!<loopthrough>/0/PIPEMATERIAL
      $P $!!error.text
      !counter = !counter + 1
      skip

    elsehandle NONE
-- Determine the MDS ANCILLARY ZERO BORE -- PIPE Material Data Element -- Property Value
      !materials = $!zeroborepmat.pprop

    endhandle
--
--<wd>mar2006<mds12>
---------------------------------------------------------------------------------------------------

    !SplitMaterials = !Materials.split(',')

    if !SplitMaterials[1].eq('ALL') then
      !AllDtext.append(!!MdsAllAncill.Standard.Dtext[$!Counter])
      !AllRtext.append(!!MdsAllAncill.Standard.Rtext[$!Counter])
    else
      do !AddMaterials values !SplitMaterials
        !!MdsMatl.addstd(!AddMaterials.trim(),!!MdsAllAncill.Standard.Rtext[$!Counter],!!MdsAllAncill.Standard.Dtext[$!Counter])
      enddo
    endif
    !Counter = !Counter + 1
  enddo

  do !AddToAll from 1 to $!this.Numberofmaterials
    !Gadget = !this.L$!AddToAll
    if !Gadget.active then
      !Tag = !Gadget.tag.trim()
      !ExistingDtext = !StdDtext
      !ExistingRtext = !StdRtext
-- Add the found elements to the all list and sort
      !ToBeSortedDtext = ARRAY()
      !ToBeSortedRtext = ARRAY()
      !ToBeSortedDtext.appendArray(!!MdsMatlD$!Tag)
      !ToBeSortedRtext.appendArray(!!MdsMatlR$!Tag)
      !ToBeSortedDtext.appendArray(!AllDtext)
      !ToBeSortedRtext.appendArray(!AllRtext)
      !SortedIndexDtext = !ToBeSortedDtext.sortedindices()
      !SortedDtext = ARRAY()
      !SortedRtext = ARRAY()
      do !SortedDtextVal values !SortedIndexDtext
        !SortedDtext.append(!ToBeSortedDtext[$!SortedDtextVal])
        !SortedRtext.append(!ToBeSortedRtext[$!SortedDtextVal])
      enddo
      !ExistingDtext.AppendArray(!SortedDtext)
      !ExistingRtext.AppendArray(!SortedRtext)
      !Gadget.Dtext = !ExistingDtext
      !Gadget.Rtext = !ExistingRtext
    endif
  enddo

  !this.totals()

endmethod

define method .findmat(!MatlString is STRING) is GADGET

  !Gadget = object gadget()
  !TrimmedString = !MatlString.trim()
-- Find a gadget with the passed string

  do !Loop from 1 to $!this.Numberofmaterials
    !testGadget = !this.L$!Loop
    if !testGadget.tag.trim().eq(!TrimmedString) then
      !Gadget = !this.L$!Loop
    endif
  enddo

  return !Gadget

endmethod

define method .SetList()
-- Hide all lists
  do !hide from 1 to $!this.Numberofmaterials
    !this.L$!Hide$n.visible = FALSE
  enddo
-- Show selected
  !Selected = !this.list.val
  !this.L$!Selected$n.visible = TRUE
  !this.totals()
endmethod


-- End of file MdsMatl.pmlfrm
