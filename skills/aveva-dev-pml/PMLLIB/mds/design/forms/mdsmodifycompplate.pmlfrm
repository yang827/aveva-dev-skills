------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  default()                        -
--  dimension()                      -
--  getIndex()                       REAL
--  init()                           -
--  init(FORM)                       -
--  markPlate(REAL)                  -
--  matref()                         -
--  mdsModifyCompPlate()             -
--  reset()                          -
--  selectPlate()                    -
--  setFormsActive(BOOLEAN)          -
--  size(REAL)                       -
--  track(FORM,STRING)               -
--

setup form !!mdsModifyCompPlate

  option .plate at xmin ymin callback '!this.selectPlate()' width 24
  text .xsize tagwidth 6 at xmin ymax+0.1 callback '!this.size(1)' width 20 is REAL format !!distanceFmt
  text .ysize 'Y-Size' tagwidth 6 at xmin ymax+0.1 callback '!this.size(2)' width 20 is REAL format !!distanceFmt
  option .matref 'Matref' tagwidth 6 at xmin ymax+0.1 callback '!this.matref()' width 17.7
  toggle .dimension 'Display Dimensions' tagwidth 13 at xmin ymax+0.1 callback '!this.dimension()'
  button .default 'Default' width 6 at xmin ymax+0.1 callback '!this.default()'
  button .reset 'Reset' width 6 at xmax ymin callback '!this.reset()'
  button .cancel 'Dismiss' width 6 at xmax form-size ymin callback '!this.cancel()' CANCEL

  --button .dismiss 'Dismiss' width 5 at xcen.plate ymax.yoffset+0.5 OK

  -- form members
  member .forms is ARRAY
  member .plates is ARRAY
  member .aidNumber is REAL
  member .storedim is BOOLEAN
  member .backupPlates is ARRAY

  track 'DESICE'

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsModifyCompPlate()

  !this.formtitle = 'Compensation'
  !this.initcall = '!this.init()'
  !this.okcall = '!this.cancel()'
  !this.cancelcall = '!this.cancel()'
  !this.autoCall = '!this.track('
  !this.storedim = true

  !dtext = ARRAY()
  do !i indices !!mdsCompplateDflts.matref
    !matr = !!mdsCompplateDflts.matref[!i]
    !desc = !matr.desc
    if !desc.empty() then
      !desc = !matr.namn
    endif
    if !i.eq(!!mdsCompplateDflts.dfltMatrefIndex) then
      !desc = !desc + ' (Default)'
    endif
    !dtext.append(!desc)
  enddo
  !this.matref.dtext = !dtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.aidNumber = !!aidNumbers.add(!this.formtitle)
  !this.dimension.val = !this.storedim

  !setsteel = !!fmsys.loadform('mdssetsteel')
  if !this.forms[1].name().eq('MDSFT71') then
    !setsteel = !!fmsys.loadform('mdsft71steel')
  endif
  if !setsteel.shown().and(!setsteel.owner().eq(!this.forms[1])) then
    !this.forms.append(!setsteel)
  endif
  if !this.forms[1].name().eq('MDSSPECIAL') then
    if !!mdsEditSpsctn.shown().and(!!mdsEditSpsctn.owner().eq(!this.forms[1])) then
      !this.forms.append(!!mdsEditSpsctn)
      if !!cdStlspec.shown().and(!!cdStlspec.owner().eq(!!mdsEditSpsctn)) then
        !this.forms.append(!!cdStlspec)
      endif
      if !!cdSetpline.shown().and(!!cdSetpline.owner().eq(!!mdsEditSpsctn)) then
        !this.forms.append(!!cdSetpline)
      endif
    endif
  endif

  !this.setFormsActive(false)

  !dtext = ARRAY()
  do !plate values !this.plates
    !dtext.append(!plate.atta.namn)
  enddo

  !this.plate.dtext = !dtext
  !this.plate.active = !dtext.size().gt(1)

  !this.plate.val = !this.getIndex()
  handle ANY
    !this.plate.val = 1
  endhandle
  !this.selectPlate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!form is FORM)

  !this.forms.clear()
  !this.forms[1] = !form

  !this.plates = !!mdsCompplateDflts.compensatingPlates(!form)
  if !this.plates.unset() then
    !name = !form.support.stru.name
    return error 1 'No compensation found within support $!name'
  endif
  !this.backupPlates = !this.plates

  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFormsActive(!active is BOOLEAN)

  do !form values !this.forms
    !form.setActive(!active)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectPlate()

  !index = !this.plate.val
  !plate = !this.plates[!index]
  !this.xsize.val = !plate.size[1]

  !platesonly = !plate.pane.set()
  if !platesonly then
    !this.ysize.val = !plate.size[2]
    !this.matref.val = !!mdsCompplateDflts.matref.findfirst(!plate.matref)
    handle ANY
      !!alert.warning('The previously selected material option has been removed or is no longer available - the material has been reset to the default option')
      !matref = !!mdsCompplateDflts.matref[!!mdsCompplateDflts.dfltMatrefIndex]
      !plate.matref(!matref)
      !this.plates[!index] = !plate
    endhandle
    !xtag = 'X-Size'
    !ytag = 'Y-Size'
  else
    !this.ysize.val = !plate.fitt.fprop.widt
    !xtag = 'Length'
    !ytag = 'Width'
  endif
  !this.xsize.tag = !xtag
  !this.ysize.tag = !ytag
  !this.ysize.active = !platesonly
  !this.matref.visible = !platesonly

  !this.dimension()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .size(!entry is REAL)

  !index = !this.plate.val
  !plate = !this.plates[!index]

  !size = !plate.size
  if !entry.eq(1) then
    !field = !this.xsize
  else
    !field = !this.ysize
  endif
  !newval = !field.val
  if !newval.unset() then
    !newval = 0
  endif
  if !newval.leq(0) then
    !field.val = !size[!entry]
    return
  endif

  !size[!entry] = !newval
  !plate.size(!size)
  !this.plates[!index] = !plate

  !this.dimension()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track(!form is FORM, !dummyDbtype is STRING)

  if !this.plates.size().eq(1) then
    return
  endif

  !index = !this.getIndex()
  if !index.set() then
    !this.plate.val = !index
    !this.selectPlate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getIndex() is REAL

  !index = REAL()

  !fitt = object DBREF('FIXING')
  handle ANY
    !fitt = nulref
  endhandle
  !atta = object DBREF('ATTA')
  handle ANY
    !atta = nulref
  endhandle
  if !atta.unset().and(!fitt.unset()) then
    return !index
  endif

  do !c indices !this.plates
    if !this.plates[!c].fitt.eq(!fitt).or(!this.plates[!c].atta.eq(!atta)) then
      !index = !c
    endif
  enddo

  return !index

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  !this.setFormsActive(true)

  !!aidNumbers.remove(!this.aidNumber)
  !this.aidNumber = REAL()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markPlate(!index is REAL)

  !number = !this.aidNumber
  aid clear all $!number

  !!drawAidText('CP',!this.plates[!index].fitt.pos,!number)
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .matref()

  !index = !this.plate.val
  !plate = !this.plates[!index]

  !matref = !!mdsCompplateDflts.matref[!this.matref.val]

  !plate.matref(!matref)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.plates[!index] = !plate


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dimension()

  !aidnumb = !this.aidNumber
  aid clear all $!aidnumb
  !this.storedim = !this.dimension.val
  if !this.dimension.val.not() then
    return
  endif

  !col = !!gphcolopt.aids.code
  !comp = !this.plates[!this.plate.val]
  !pos = !comp.fitt.pos
  !xdir = !comp.fitt.ori.ydir()
  !ydir = !comp.fitt.ori.xdir()
  !zdir = !comp.fitt.ori.zdir()

  !xlen = !this.xsize.val * 0.5
  !ylen = !this.ysize.val * 0.5
  !offset = 80mm
  !elev = !comp.gap()
  !aleng = 13mm

  !xdim = !pos.offset(!xdir, -!xlen).line(!pos.offset(!xdir, !xlen)).offset(!ydir,!offset + !ylen).offset(!zdir,!elev)
  !ydim = !pos.offset(!ydir, -!ylen).line(!pos.offset(!ydir, !ylen)).offset(!xdir,!offset + !xlen).offset(!zdir,!elev)
  !corner = !xdim.endPosition.offset(!ydir, -!offset)
  !xproj1 = !corner.line(!corner.offset(!ydir, !offset  + !aleng))
  !xproj2 = !xproj1.offset(!xdir.opposite(),2 * !xlen)
  !yproj1 = !corner.line(!corner.offset(!xdir, !offset + !aleng))
  !yproj2 = !yproj1.offset(!ydir.opposite(),2 * !ylen)
  !xarrow1 = object ARROW()
  !xarrow1.pos = !xdim.startPosition.offset(!xdir,!aleng)
  !xarrow1.length = !aleng
  !xarrow1.dir = !xdir.opposite()
  !xarrow1.ratio = 1
  !xarrow2 = !xarrow1
  !xarrow2.pos = !xdim.endPosition.offset(!xdir.opposite(),!aleng)
  !xarrow2.dir = !xdir
  !yarrow1 = !xarrow1
  !yarrow1.pos = !ydim.startPosition.offset(!ydir,!aleng)
  !yarrow1.dir = !ydir.opposite()
  !yarrow2 = !xarrow1
  !yarrow2.pos = !ydim.endPosition.offset(!ydir.opposite(),!aleng)
  !yarrow2.dir = !ydir

  !xdim.draw(!aidnumb,1,!col)
  !xproj1.draw(!aidnumb,1,!col)
  !xproj2.draw(!aidnumb,1,!col)
  !ydim.draw(!aidnumb,1,!col)
  !yproj1.draw(!aidnumb,1,!col)
  !yproj2.draw(!aidnumb,1,!col)

  !!drawAidArrow(!aidnumb,!xarrow1)
  !!drawAidArrow(!aidnumb,!xarrow2)
  !!drawAidArrow(!aidnumb,!yarrow1)
  !!drawAidArrow(!aidnumb,!yarrow2)
  !!drawAidText(!this.xsize.val.string(),!xdim.proportion(0.5),!aidnumb)
  !!drawAidText(!this.ysize.val.string(),!ydim.proportion(0.5),!aidnumb)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .default()

  if !!alert.confirm('O.K. to reset it back to default value(s)?').boolean().not() then
    return
  endif

  !index = !this.plate.val
  !comp = !this.plates[!index]
  -- recalculate dimensions
  !size = !comp.size()
  !size[1] = !!mdsCompplateDflts.size('x',!comp.atta,!comp.sctn())
  if !comp.pane.set() then
    !size[2] = !!mdsCompplateDflts.size('y',!comp.atta,!comp.sctn())
  endif
  !comp.size(!size)

  -- reset matref
  !matref = !!mdsCompplateDflts.matref()
  !comp.matref(!matref)

  !this.plates[!index] = !comp

  !this.selectPlate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reset()

  if !!alert.confirm('O.K. to reset?').boolean().not() then
    return
  endif

  !index = !this.plate.val
  !comp = !this.plates[!index]
  !size = !this.backupPlates[!index].size()
  !matr = !this.backupPlates[!index].matref

  !comp.size(!size)
  !comp.matref(!matr)

  !this.plates[!index] = !comp
  !this.selectPlate()

endmethod
-- End of method
