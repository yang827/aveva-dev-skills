--
-- File:  mdsmodpad.pmlfrm
--   Type:  Form Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:          FPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Form to modify pads
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  init(DBREF)                      -
--  setDesp()                        -
--


-- Define Form
setup form  !!mdsmodpad at xr0 yr0 noquit

  !this.formtitle    = |Modify Pad|
  !this.icontitle    = ||
  !this.callback     = ||

  -- Body of Form
  para .tag text |Name:|
  para .name at xmax+2 ymin width 20 lines 1


  text   .dim1   |Desp 1       |     at x1   ymax+0.2 call |!!mdsmodpad.setDesp()| width 14 is REAL
  text   .dim2   |Desp 2       |     at xmin ymax call |!!mdsmodpad.setDesp()|  width 14 is REAL
  text   .dim3   |Desp 3       |     at xmin ymax call |!!mdsmodpad.setDesp()|  width 14 is REAL
  text   .dim4   |Desp 4       |     at xmin ymax call |!!mdsmodpad.setDesp()|  width 14 is REAL

  -- Bottom Line
  button .dismiss  | Dismiss | at xmax form-size ymax+0.5 OK
  button .ok      |   Apply   | at x0             ymin     call |!!mdsmodpad.apply()|

  -- Form Members
  -- Pad object
  member .pad    is MDSPAD


  -- End form definition
exit

------------------------------------------------------------------------------------
define method .init(!join is DBREF)

  !this.pad = object MDSPAD(!join)

  !this.name.val = !this.pad.dbelement.namn

  !this.dim1.visible = F
  !this.dim2.visible = F
  !this.dim3.visible = F
  !this.dim4.visible = F

  do !num from 1 to !this.pad.numDespars

    !string = '!this.dim' & !num.string() & '.visible'
    $!string = T

    -- set text descriptions to despar descriptions
    !string = '!this.dim' & !num.string() & '.tag'
    $!string = !this.pad.despdesc[!num]

    -- put despar values into text values

    !string = '!this.dim' & !num.string() & '.val'

    $!string = !this.pad.despVal[!num]

  enddo

endmethod
------------------------------------------------------------------------------------
------------------------------------------------------------------------------------
define method .setDesp()

  do !num from 1 to !this.pad.numDespars

    !dim = '!this.dim' & !num.string() & '.val'

    !this.pad.despVal[!num] = $!dim

  enddo

endmethod
------------------------------------------------------------------------------------
define method .apply()

  !this.pad.modify()

endmethod
------------------------------------------------------------------------------------
