--
-- File:		MdsMtoc.pmlfrm
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Monday 2nd August 2004
--
--
-- Description:
-- Form definition for selecting if a ancillary is shown on the isometric or not
-- MTOC ON/OFF/DOTD/DOTU
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  init(FORM)                       -
--  setall()                         -
--

-- Kill existing form definition

kill !!mdsMtoc

-- Define form

setup form !!mdsMtoc

  !this.formtitle  = 'Isometric Material List Control'
  !this.cancelcall = '!this.cancel()'

-- Display Support Name

  paragraph .name at xmax+1 ymin text |!this.name()| width 30 lines 1

  path down
  vdist 0.5

  frame .selframe | Ancillaries - Material - Support Tag| at x1 ymax

-- List of Ancillaries on the Support

    if (defined(!!numberofAttas)) then
    else
      !!numberOfAttas = 1
      !!namesOfAttas[1] = 'DUMMY'
    endif

    do !loop from 1 to !!numberofAttas
      path down
      para .atta$!loop at x1 ymax+0.3 text '$!!NamesOfAttas[$!Loop] '
      path right
      rgroup .tatta$!loop horizontal
        add tag 'On '
        add tag 'Off '
        add tag 'Dotted with Dims '
        add tag 'Dotted without Dims '
      exit
      rgroup .tag$!loop horizontal
        add tag 'On '
        add tag 'Off '
      exit
    enddo

  exit

  rgroup .all 'Set all to' at x10 ymax call '!This.SetAll()' horizontal
    add tag 'On '
    add tag 'Off '
    add tag 'Dotted with Dims '
    add tag 'Dotted without Dims '
  exit

-- Apply Form
  button _apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|
-- Dismiss Form
  button .cancel | Dismiss | at xmax form-size ymin call || cancel

-- Calling form member

  member .form is FORM

-- Exit form definition

exit

--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
define method .init(!form is FORM)
--------------------------------------------------------------------

-- Do any members exist

  if (!form.support.atta.size().lt(1)) then
    !!alert.warning('Support ancillaries have to exist to be able to set the material list visibility')
    return
  endif

-- Number of attas

  !!numberOfAttas = !form.support.atta.size()
  !!namesOfAttas = ARRAY()
  !currentValues = ARRAY()
  do !addNames from 1 to !!numberOfAttas
    !nameOfAtta = !form.support.atta[$!addNames]
    if (!nameOfAtta.name.match('/DATUM').gt(0)) then
      !!namesOfAttas.append(' DATUM')
    elseif (!nameOfAtta.name.match('/SREF').gt(0)) then
      !!namesOfAttas.append('  SREF')
    elseif (!nameOfAtta.namn.match('/').gt(0)) then
      !string = !nameOfAtta.namn.after('/')
      if (!string.length().eq(1)) then
        !!namesOfAttas.append('     $!String')
      elseif (!string.length().eq(2)) then
        !!namesOfAttas.append('    $!String')
      elseif (!string.length().eq(3)) then
        !!namesOfAttas.append('   $!String')
      elseif (!string.length().eq(4)) then
        !!namesOfAttas.append('  $!String')
      elseif (!string.length().eq(5)) then
        !!namesOfAttas.append(' $!String')
      else
        !!namesOfAttas.append('$!String')
      endif
    elseif (!nameOfAtta.namn.match('.').gt(0)) then
      !string = !nameOfAtta.namn.after('.')
      if (!string.length().eq(1)) then
        !!namesOfAttas.append('     $!String')
      else
        !!namesOfAttas.append('    $!String')
      endif
    else
      !!namesOfAttas.append(' DATUM')
    endif
    !currentValues.append(!form.support.atta[$!addNames].mtoc)
  enddo

-- Recall form to set size

  pml reload form !!mdsMtoc

-- Set form member to calling form

  !!mdsMtoc.form = !form

-- Read current setting of MTOC attribute set on form

  do !setAtt from 1 to !currentValues.size()
    if (!currentValues[$!setAtt].eq('ON')) then
      !value = 1
    elseif (!currentValues[$!setAtt].eq('OFF')) then
      !value = 2
    elseif (!currentValues[$!setAtt].eq('DOTD')) then
      !value = 3
    elseif (!currentValues[$!setAtt].eq('DOTU')) then
      !value = 4
    else
      !value = 1
    endif
    !!mdsMtoc.tatta$!setAtt$n.val = !value
  enddo

-- Deactivate the sref support tag toggle if found and set toggle if not

  do !loopToFindSref from 1 to !!numberOfAttas
    if (!!mdsMtoc.atta$!loopToFindSref$n.val.match('SREF').gt(0)) then
      !!mdsMtoc.tag$!loopToFindSref$n.active = FALSE
      !!mdsMtoc.tag$!loopToFindSref$n.val = 2
    else
      !!mdsMtoc.tag$!loopToFindSref$n.active = TRUE
      --<wd>jan2007 -- HANDLE the ERROR and SKIP the NON ATTA type elements that don't have an STEX attribute
      !stex = !form.support.atta[$!loopToFindSref].stex
      handle NONE

        if (!stex.eq('')) then
          !!mdsMtoc.tag$!loopToFindSref$n.val = 2
        else
          !!mdsMtoc.tag$!loopToFindSref$n.val = 1
        endif

      elsehandle ANY
--<wd>jan2007 -- HANDLE the ERROR and SKIP the NON ATTA type elements that don't have an STEX attribute
        skip
      endhandle

--<wd>jan2007
    endif
  enddo

  !!numberOfAttas.delete()
  !!namesOfAttas.delete()

  show !!mdsmtoc

-- Set the name of the support

  !!mdsmtoc.name.val = !form.support.datum.name.before('/DATUM')

endmethod

--------------------------------------------------------------------
define method .setall()
--------------------------------------------------------------------

  do !loop from 1
    !this.tatta$!loop$n.val = !this.all.val
      handle ANY
        break
      endhandle
  enddo

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------

-- Set the Ancillary mtoc#

  !!mdsDacControl(true)

  do !loop from 1 to !this.form.support.atta.size()

    skip if (!this.form.support.atta[$!loop].type.neq('ATTA'))

    if (!!mdsMtoc.tatta$!loop$n.val.eq(1)) then
      !mtoc = 'ON'
    elseif (!!mdsMtoc.tatta$!loop$n.val.eq(2)) then
      !mtoc = 'OFF'
    elseif (!!mdsMtoc.tatta$!loop$n.val.eq(3)) then
      !mtoc = 'DOTD'
    else
      !mtoc = 'DOTU'
    endif
    !this.form.support.atta[$!loop].mtoc = '$!Mtoc'

    if (!!mdsMtoc.tag$!loop$n.val.eq(1)) then
      !ce = !!ce
      !!ce = !this.form.support.atta[$!loop]
      !!mdsSilent = TRUE
      !supportName = !!mdsGetSuppName(!!ce)
      !!mdsSilent = FALSE
      atty unset
      if (!!ce.name.match('DATUM').gt(0)) then
        -- set atty on SREF atta
        !srefatta = !supportName & '/SREF'
        !count = 1
        do !i values !this.form.support.atta
          if (!i.name.eq(!srefatta)) then
            !gadget = '!!MdsMtoc.tag' & !count  & '.val'
             $!gadget = 1
          endif
          !count = !count + 1
        enddo
      endif
      !!mdsTransport(!!ce,!supportName)
      !!ce = !ce
    else
      !ce = !!ce
      !!ce = !this.form.support.atta[$!loop]
      stex ''
      atty CCNN
      !!mdsSilent = TRUE
      !supportName = !!mdsGetSuppName(!!ce)
      !!mdsSilent = FALSE
      if (!!ce.name.match('DATUM').gt(0)) then
        -- set atty on SREF atta
        !srefatta = !supportName & '/SREF'
        !count = 1
        do !i values !this.form.support.atta
          if (!i.name.eq(!srefatta)) then
            !gadget = '!!MdsMtoc.tag' & !count  & '.val'
             $!gadget = 2
          endif
          !count = !count + 1
        enddo
      endif
      !!ce = !ce
    endif
  enddo

  !!mdsDacControl(FALSE)

endmethod

--------------------------------------------------------------------
-- End of Form Definition - !!MdsMtoc
--------------------------------------------------------------------
define method .cancel()
endmethod
--------------------------------------------------------------------
