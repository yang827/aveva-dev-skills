--
-- File:		mdsnewhdgdata.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 29th January 2002
--
--
-- Description:
-- Form Definition for New MDS Reports Individual Column Heading Data
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Define Form
    kill !!mdsnewhdgdata
    Setup Form  !!mdsnewhdgdata at xr0.6 yr0.07
      !!mdsnewhdgdata.formtitle = ' MDS Column Heading Data '
      !!mdsnewhdgdata.icontitle = 'MDSDAT'

-- Frame for Heading Data
      frame .fhdg | Column Heading Data |
        text .hdgnumber   |Heading Number : | at x1       ymax call || width  7 is real
        text .hdgorder    |Order : |      at xmax+1.75    ymin call || width  7 is real
        text .hdgtitle    |Heading Title  : | at x1       ymax call || width 25 is string
        text .hdgdescr    |Description    : | at x1       ymax call || width 25 is string
        text .hdgexprn    |Expression     : | at x1       ymax call || width 25 scroll 256 is string
        text .hdgfuncn    |Function       : | at x1       ymax call || width 25 is string
        text .hdgunset    |Unset Text     : | at x1       ymax call || width 25 is string
        toggle .hdgccode  ||                  at x1       ymax call ||  states 'false' 'true'
        para   .hdgpcode                      at xmax+0.5 ymin text |Client Code|
        toggle .hdgcdesc  ||                  at xmax+3.5 ymin call ||  states 'false' 'true'
        para   .hdgpdesc                      at xmax+0.5 ymin text |Client Description|
        frame .fhdgdata | Data Type | at x1 ymax-0.2
          rgroup .hdgdata ''                  at xmin+0.5 ymax+0.03
            add tag 'ascii'
            add tag 'numeric'
          exit
        exit
        halign right
        option .hdgjustf  |Justify : |        at xmax+2 ymin.hdgdata   call || width 8
      exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL
--      button .apply   | Save |    at x0             ymin  call ||

    exit
-- End of form definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .init()

-- Set Option Gadget Values
     !dtext[1] = 'Left'
     !dtext[2] = 'Centre'
     !dtext[3] = 'Right'
     !rtext[1] = 'L'
     !rtext[2] = 'C'
     !rtext[3] = 'R'
     !this.hdgjustf.dtext = !dtext
     !this.hdgjustf.rtext = !rtext

-- Set the Output Data Type

-- Make all the gadgets read only
     !this.hdgnumber.seteditable(false)
     !this.hdgorder.seteditable(false)
     !this.hdgtitle.seteditable(false)
     !this.hdgdescr.seteditable(false)
     !this.hdgexprn.seteditable(false)
     !this.hdgfuncn.seteditable(false)
     !this.hdgunset.seteditable(false)
     !this.hdgccode.active = false
     !this.hdgcdesc.active = false
     !this.hdgjustf.active = false
     !this.hdgdata.active  = false

-- Show the form
     if (!this.shown().not()) then
       !this.show('at',0.63,0.05)
     endif

   endmethod
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: index
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .index(!hdgnum is real,!index is real)

-- Leave the Headings Data Form if Shown already
     !shown =!this.shown()
     !this.init()
     if (!shown.not()) then
       !this.hide()
     endif

-- Load the form gadgets
     !this.hdgnumber.val = !hdgnum
     !this.hdgorder.val  = !index
     !this.hdgdescr.val  = !!mdsnewreports.validhdgs.headings[!hdgnum].description
     !this.hdgtitle.val  = !!mdsnewreports.validhdgs.headings[!hdgnum].title
     !this.hdgexprn.val  = !!mdsnewreports.validhdgs.headings[!hdgnum].expression
     !this.hdgfuncn.val  = !!mdsnewreports.validhdgs.headings[!hdgnum].function

     if (!!mdsnewreports.validhdgs.headings[!hdgnum].justify.trim().eq('') or !!mdsnewreports.validhdgs.headings[!hdgnum].justify.unset()) then
       !this.hdgjustf.select('rtext','L')
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].justify.trim() inset( 'L','C','R')) then
       !this.hdgjustf.select('rtext',!!mdsnewreports.validhdgs.headings[!hdgnum].justify.trim())
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].justify.trim() inset( 'Left','Centre','Right')) then
       !this.hdgjustf.select('dtext',!!mdsnewreports.validhdgs.headings[!hdgnum].justify.trim())
     else
       !this.hdgjustf.val = 1
     endif

     if (!!mdsnewreports.validhdgs.headings[!hdgnum].ccode.unset() or !!mdsnewreports.validhdgs.headings[!hdgnum].ccode.trim().eq('')) then
       !this.hdgccode.val = false
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].ccode.trim().lowcase() inset ('false','true')) then
       !this.hdgccode.val = !!mdsnewreports.validhdgs.headings[!hdgnum].ccode.trim().boolean()
     else
       !this.hdgccode.val = false
     endif

     if (!!mdsnewreports.validhdgs.headings[!hdgnum].cdesc.unset() or !!mdsnewreports.validhdgs.headings[!hdgnum].cdesc.trim().eq('')) then
       !this.hdgcdesc.val = false
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].cdesc.trim().lowcase() inset ('false','true')) then
       !this.hdgcdesc.val = !!mdsnewreports.validhdgs.headings[!hdgnum].cdesc.trim().boolean()
     else
       !this.hdgcdesc.val = false
     endif

     if (!!mdsnewreports.validhdgs.headings[!hdgnum].data.unset() or !!mdsnewreports.validhdgs.headings[!hdgnum].data.trim().eq('')) then
       !this.hdgdata.val = 1
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].data.trim().lowcase() inset ('a','ascii')) then
       !this.hdgdata.val = 1
     elseif (!!mdsnewreports.validhdgs.headings[!hdgnum].data.trim().lowcase() inset ('n','numeric')) then
       !this.hdgdata.val = 2
     else
       !this.hdgdata.val = 1
     endif

     if (!!mdsnewreports.validhdgs.headings[!hdgnum].unset.unset() or !!mdsnewreports.validhdgs.headings[!hdgnum].unset.trim().eq('')) then
       !this.hdgunset.val  = '---'
     else
       !this.hdgunset.val  = !!mdsnewreports.validhdgs.headings[!hdgnum].unset
     endif

   endmethod

------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .cancel()

-- Hide the form
     !this.hide()

   endmethod

------------------------------------------------------------------------------------------------
