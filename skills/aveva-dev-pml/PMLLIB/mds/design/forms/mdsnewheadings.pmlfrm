--
--
-- Description:
-- Form Definition for New MDS Reports Available Column Headings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(STRING)                    -                   Check if Run Time Filter Expression can be Validated
--  checkexprn(STRING)               BOOLEAN             Check if Run Time Filter Expression can be Validated
--  checklist(STRING)                BOOLEAN             Check if Run Time Filter Expression can be Validated
--  headings()                       ARRAY
--  text(REAL)                       -
--  toggle(REAL)                     -
--
------------------------------------------------------------------------------------------------
--
-- Define Form

    kill !!mdsnewheadings
setup form  !!mdsnewheadings at xr0.6 yr0.07
      !!mdsnewheadings.formtitle = ' MDS Report Headings '
      !!mdsnewheadings.icontitle = 'MDSHDG'

-- Bar Menu
      bar

-- MDS Report file name
      frame .frepfile ' Output Report '
    text .repname  |Name   :|      at x1     ymax      call || width 25 is STRING
    text .repdesc  |Description :| at xmax+1 ymin      call || width 30 is STRING
    text .reporder |Order  :|      at x1     ymax+0.25 call |!this.hdgorder()| width 70 is STRING
    text .replist  |List   :|      at x1     ymax+0.25 call |!this.check('replist')| width 70 scroll 256 is STRING
    text .repfilt  |Filter :|      at x1     ymax+0.25 call |!this.check('repfilt')| width 70 scroll 256 is STRING
      exit

      path down

-- MDS Reports - Available Column Headings
      frame .fhdglist ' Available Column Heading Nos. - Titles '
        !hdgsarray = !!mdsnewreports.validheadings
        !hdgssize  = !hdgsarray.size()
        !hdgscols  = (!hdgssize / 30)
        !hdgsvalu  = !hdgscols.string().after('.').real()
        if (!hdgsvalu.set()) then
          !hdgscols = !hdgscols.string().before('.').real() + 1
        endif

-- Define the Toggle Gadgets and Column Headings
        do !indx indices !hdgsarray
          !heading = !hdgsarray[!indx][2].trim()
          if (!heading.length().eq(0)) then
            !heading = '$!indx-Heading'
          endif
          if (!indx.lt(31)) then
            toggle .hdg$!indx |$!indx - $!heading| at x1 ymax call|!this.toggle($!indx)|
          elseif (!indx.gt(30) and !indx.lt(61)) then
            if (!indx.eq(31)) then
              toggle .hdg$!indx |$!indx - $!heading| at xmax.hdg$!!<mdsnewreports.maxwid30>+1 ymin.hdg1 call |!this.toggle($!indx)|
            else
              toggle .hdg$!indx |$!indx - $!heading| at xmin ymax call |!this.toggle($!indx)|
            endif
          elseif (!indx.gt(60) and !indx.lt(91)) then
            if (!indx.eq(61)) then
              toggle .hdg$!indx |$!indx - $!heading| at xmax.hdg$!!<mdsnewreports.maxwid60>+1 ymin.hdg1 call |!this.toggle($!indx)|
            else
              toggle .hdg$!indx |$!indx - $!heading| at xmin ymax call |!this.toggle($!indx)|
            endif
          elseif (!indx.gt(90) and !indx.lt(121)) then
            if (!indx.eq(91)) then
              toggle .hdg$!indx |$!indx - $!heading| at xmax.hdg$!!<mdsnewreports.maxwid90>+1 ymin.hdg1 call |!this.toggle($!indx)|
            else
              toggle .hdg$!indx |$!indx - $!heading| at xmin ymax call |!this.toggle($!indx)|
            endif
          elseif (!indx.gt(120) and !indx.lt(151)) then
            if (!indx.eq(121)) then
              toggle .hdg$!indx |$!indx - $!heading| at xmax.hdg$!!<mdsnewreports.maxwid120>+1 ymin.hdg1 call |!this.toggle($!indx)|
            else
              toggle .hdg$!indx |$!indx - $!heading| at xmin ymax call |!this.toggle($!indx)|
            endif
          endif
        enddo
      exit

      path down

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL

-- Form Members
  member .order is ARRAY

    exit

-- End of form definition

-- Populate Bar menu
    !!mdsnewheadings.bar.add('Control', 'Control')
    !!mdsnewheadings.newmenu('Control').add('callback', 'Save as Default Report...' , '!!mdsnewheadings.saveas()')
    !!mdsnewheadings.control.add('callback', 'Close' , '!!mdsnewheadings.cancel()')

------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description: Initialises form in Read only mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .init()

-- Show the selected Report Headings from those available
-- in the !!mdsnewreports.validheadings array member
     !reportnum = !!mdsnewreports.replist.val
     !!mdsnewreports.init('initial')
     !!mdsnewreports.replist.val = !reportnum
     -- reinitialise the heading form for the selected report definition
-->>-<wd>jan2003
     --!!mdsnewreports.headinglist(!!mdsnewreports.replist.pickedfield)
     if (!!mdsnewreports.replist.pickedfield.neq(0))then
       !!mdsnewreports.headinglist(!!mdsnewreports.replist.pickedfield)
     else
       !!mdsnewreports.headinglist(1)
     endif
--<<-<wd>jan2003

-- Load the Text gadgets
     !this.text(!reportnum)

-- Load the Member
     !this.order.clear()
     !this.order = !!mdsnewreports.validreports.reports[!reportnum].headings

-- Show the form
     if (!this.shown().not()) then
       !this.show('at',0.05,0.15)
     endif

   endmethod
-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: userdef
--
-- Description: Initialises form in User Defined mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .userdef()

  -- Initialise the form as the standard initialisation
     !this.init()

-- Modify the display of the MDS Report forms for a User Defined Report definition
-- Inactivate the gadgets on the main MDS Report form
     !!mdsnewreports.replist.active = false
     !!mdsnewreports.hdglist.active = false

-- Activate ALL of the gadgets on the MDS Report Headings form
     !this.control.setactive('save as default report...',true)
     !this.repname.seteditable(true)
     !this.repdesc.seteditable(true)
     !this.reporder.seteditable(true)
     !this.replist.seteditable(true)
     !this.repfilt.seteditable(true)
     do !indx from 1 to !!mdsnewreports.validheadings.size()
       !this.hdg$!<indx>.active = true
     enddo

-- Load the form !!mdsnewhdgdata with the first heading in the list
     !hdgtxt = !!mdsnewreports.hdglist.dtext
     !hdgnum = !hdgtxt[1].before(' -- ').after(' ').trim().real()
     !!mdsnewhdgdata.index(!hdgnum,1)

-- Activate the Heading Order Gadget
--     !!mdsnewhdgdata.hdgorder.active = true

   endmethod
-- End of method definition

------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: toggle
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL        Index number of the array member !!mdsnewreports.validheadings
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .toggle(!hdgnum is REAL)

-- Set the Heading Order of the Selected Toggle on the mdsheadingsdata form
     !repnum = !!mdsnewreports.replist.pickedfield
     if (!repnum.eq(0)) then
       !repnum = 1
     endif
  --!hdgsiz   = !!mdsnewreports.validreports.reports[!repnum].headings.size()
     !reporder = !this.reporder.val.split(',')
  !repreals = ARRAY()
     do !cnt index !reporder
       !repreals.append(!reporder[!cnt].real())
     enddo

-- Need to manipulate this ARRAY when a new/old toggle is 'checked' to redefine the ORDER
-----------------------------------------------------------------
-----------------------------------------------------------------
-- Get All the Forms Toggle Gadgets and append in Numerical Order to an ARRAY if TRUE
--    !select = !this.headings()
-- Text GADGET
--HEADINGS in  an array derived from TEXT GADGET
-- q var !repreals
------------------
-- Toggle Gadgets TRUE
--REQUIRED HEADINGS
-- q var !select
--    !new = !select.difference(!repreals)
------------------
-- Headings in Toggles but NOT in Text Gadget
--ADD to  ARRAY and form new TEXT STRING
-- q var !new
------------------
-- Headings in Text Gadget BUT NOT in Toggles
--    !text = !repreals.difference(!select)
--REMOVE from ARRAY and form new TEXT STRING
-- q var !text
-----------------------------------------------------------------
-----------------------------------------------------------------

-- Determine if a Heading is to be REMOVED or APPENDED -- Toggle Number is !hdgnum
    if (!this.hdg$!<hdgnum>.val) then
      !action = 'append'
    else
      !action = 'remove'
    endif

-- Append/Remove the Selected Toggle Heading Number to/from
-- the Order Text and Put the Order in the hdg Data form
    if (!action.eq('append')) then
      !repreals.append(!hdgnum)
    elseif (!action.eq('remove')) then
      !find = !repreals.findfirst(!hdgnum)
      !repreals.remove(!find)
    endif
-- Re Order the Headings Order
    if (!repreals.empty()) then
      !this.reporder.val = ''
    else
      do !indx indices !repreals
        if (!indx.eq(1)) then
          !this.reporder.val = !repreals[!indx].string()
        else
          !this.reporder.val = !this.reporder.val & ',' & !repreals[!indx].string()
        endif
      enddo
    endif

-- Show the Heading Data form if the toggle is 'On'
     if (!action.eq('append')) then
       !order = !repreals.findfirst(!hdgnum)
       if (!this.hdg$!<hdgnum>.val) then
         if (!!mdsnewhdgdata.shown().not()) then
           !!mdsnewhdgdata.init()
         endif
         !!mdsnewhdgdata.index(!hdgnum,!order)
       else
         !!mdsnewhdgdata.hide()
       endif
     elseif (!action.eq('remove')) then
       if (!!mdsnewhdgdata.shown()) then
         !!mdsnewhdgdata.hide()
       endif
     endif

   endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: hdgorder()
--
-- Description: Callback on Text ORDER gadget to REDEFINE Column Headings and Order
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .hdgorder()

-- Test if String is Valid in TEXT Order Gadget
     !maxhdg = !!mdsnewreports.validhdgs.headings.size() + 1
     !text = !this.reporder.val.trim()

-- Replace Multiple Commas with Single Commas
     do !indx
       !text = !text.replace(',,',',')
       if (!text.match(',,').gt(0).not()) then
         break
       endif
     enddo

-- Remove Any Commas at the First and Last Characters
     if (!text.match(',').eq(1)) then
       !text = !text.after(',')
     endif

     !tlen = !text.length()
     if(!text.substring(!tlen).eq(',')) then
       !text = !text.substring(1,!tlen - 1)
     endif

-- Replace TWO Spaces by ONE
     !text   = !text.replace('  ',' ')

-- Check for Illegal characters etc... ,and if NONE found
-- build the Correct Order Text and Set the Toggles
     !string = !text.split(',')
     !string.unique()
     !count  = 0
  !order  = ARRAY()
  !rtext = STRING()
     do !valu values !string
       !count = !count + 1
       !xstr  = !valu.trim()
       if (!xstr.match(' ').gt(0) or !xstr.eq('')) then
         !!alert.error('Illegal ''space'' character(s) found in the required headings. Only Integers and Commas are allowed')
         return
         break
       endif
       !real = !valu.real()
       handle any
         !!alert.error('Illegal characters found in the required headings. Only Integers and Commas are allowed')
         return
         break
       endhandle
       if (!real.sbetween(0,!maxhdg).not()) then
         !maxnum = !maxhdg - 1
         !!alert.error('Illegal heading number ''$!real'' found. Available heading numbers are 1 to $!maxnum')
         return
         break
       endif
-- Build Order Text Correctly and Array
       if (!count.eq(1)) then
         !rtext = !xstr
       else
         !rtext = !rtext & ',' & !xstr
       endif
       !order.append(!real)
     enddo

-- Set Order Text gadget to !rtext
     if (defined(!rtext) and !rtext.set()) then
       !this.reporder.val = !rtext
     else
       !!alert.warning('The Order gadget is empty. All of the Heading Toggle gadgets will be unset/off')
       !!mdsnewhdgdata.hide()
     endif

-- Clear ALL Toggle GADGETS
     do !indx from 1 to !!mdsnewreports.validheadings.size()
       !this.hdg$!<indx>.val = false
     enddo

-- Set to True All the Toggle Gadgets as Defined in the TEXT Order Gadget
     do !indx values !order
       !this.hdg$!<indx>.val = true
     enddo

   endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: text(!repnum is real)
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      REAL       Selected report number from mdsnewreports
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .text(!repnum is REAL)

-- Load forms Text gadgets
     !this.repname.val = !!mdsnewreports.validreports.reports[!repnum].name
     !this.repdesc.val = !!mdsnewreports.validreports.reports[!repnum].title
     !hdgorder = !!mdsnewreports.validreports.reports[!repnum].headings
     do !indx indices !hdgorder
       if (!indx.eq(1)) then
         !this.reporder.val = !hdgorder[!indx].string()
       else
         !this.reporder.val = !this.reporder.val & ',' & !hdgorder[!indx].string()
       endif
     enddo
     !this.replist.val = !!mdsnewreports.validreports.reports[!repnum].list
     !this.repfilt.val = !!mdsnewreports.validreports.reports[!repnum].filter


   endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: headings
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--     ARRAY       Array of Toggle Headings (REALS) Set to TRUE on the form
--
------------------------------------------------------------------------------------------------
-- Define method
define method .headings() is ARRAY

-- Get All the Forms Toggle Gadgets and append in Numerical Order to an ARRAY if TRUE
  !select = ARRAY()
    !array  = !this.attributes()
    do !indx index !array
      !gname  = '!!' & !this & '.' & !array[!indx]
      !gadget = $!<gname>
      handle any
        skip
      endhandle
      skip if !gadget.type().neq('TOGGLE')
      handle any
        skip
      endhandle
      skip if !gadget.val.not()
      !select.append(!gadget.tag.before(' - ').real())
    enddo

-- Return Array of Toggle Heading Numbers Set to True or an Empty Array
    return !select

  endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: saveas
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
  define method .saveas()

-- Test for Empty Gadgets
    !name = !this.repname.val
    !desc = !this.repdesc.val
    --!arry = !this.headings()
    !arry = !this.reporder.val.split(',')
-- q var !arry
    !filt = !this.repfilt.val
    !list = !this.replist.val

    if (!name.trim().eq('') or !name.unset()) then
      !!alert.error('The Output Report File Name is unset. Unable to save/append the User Defined Default Report.')
      return
    else
-- Check if Output Report Name exists
      !name = !name.trim()
      !name = !name.trim('M')
      !namu = !name.upcase()
-- Get an Array of Existing Output Report names
      !narr = !!mdsnewreports.validreports.reports
      do !indx indices !narr
        if (!namu.eq(!narr[!indx].name.upcase().trim().trim('m'))) then
          !!alert.error('The Output Report File Name already exists. Modify the Name and try again.')
          return
        else
          skip
        endif
      enddo
    endif

    if (!list.trim().eq('') or !list.unset()) then
    !!alert.error('The Output Report Selection List is unset. Unable to save the User Defined Default Report without a Selection List')
      return
    else
      !error = ''
      if (!this.checklist(!error).not()) then
        !!alert.error(!error)
        return
      endif
    endif

    if (!arry.empty()) then
      !!alert.error('No Report Column Headings have been selected. Unable to save the User Defined Default Report.')
      return
    else
      do !indx indices !arry

        -- get the sort and total options for this heading column
        !sortprec   = !!mdsnewreports.validhdgs.headings[$!arry[$!indx]].sortprec
        !sortascend = !!mdsnewreports.validhdgs.headings[$!arry[$!indx]].sortascend
        !subSortCol = !!mdsnewreports.validhdgs.headings[$!arry[$!indx]].subSortCol
        !subValues  = !!mdsnewreports.validhdgs.headings[$!arry[$!indx]].subValues
        !total      = !!mdsnewreports.validhdgs.headings[$!arry[$!indx]].total

        -- check if we need to output sort/total options (ONLY OUTPUT IF VALUES ARE DIFFERENT FROM DEFAULTS)
        if (!sortprec.neq(0) or !total or !subSortCol.neq(0)) then
          if (!sortascend) then
            !sa = 'T'
          else
            !sa = 'F'
          endif
          if (!total) then
            !tot = 'T'
          else
            !tot = 'F'
          endif
          !sortTotOpt = '(' + !tot + '/' + !sortprec.string() + '/' + !sa + '/' + !subSortCol.string() + '/' + !subValues + ')'
        else
          !sortTotOpt = ''
        endif

        if (!indx.eq(1)) then
          !hdgs = !arry[!indx].string() + !sortTotOpt
        else
          !hdgs = !hdgs & ',' & !arry[!indx].string() + !sortTotOpt
        endif
      enddo
    endif

    if (!desc.trim().eq('') or !desc.unset()) then
    if (!!alert.confirm('The Output Report Description/Title is unset. Do you want to save the User Defined Default Report without a Description?').eq('NO')) then
        return
      endif
    endif

    if (!filt.trim().eq('') or !filt.unset()) then
      if (!!alert.confirm('The Output Report Filter is unset. Do you want to save the User Defined Default Report without a Filter?').eq('NO')) then
        return
      endif
    else
      !error = ''
      if (!this.checkexprn(!error).not()) then
        !!alert.error(!error)
        return
      endif
    endif

-- Save and Append the User Defined report to the project Default File MDS REPORTS-DEFS
    !proj = current project
    !code = !proj.code()
    !dstr = '%' & !code & 'dflts' & '%'
    !fnam =  '/MDS-REPORT-DEFS'

-- Set File Object and Append User Defined Report to the Default file
  !file = object FILE(!dstr & !fnam)
    if (!file.exists()) then
      !report[1] = ''
    !report[2] = !name & | \ | & !desc & | \ | & !hdgs & | \ | & !filt & |\| & !list
      !file.writefile('append', !report)
      handle any
        !!alert.error('Unable to Write to the default file - ' & !!error.text)
        return
      elsehandle none
        !!alert.message('The User Defined Report has been appended to the default file $!file, and the MDS Default Reports will be RELOADED')
        !!mdsnewreports.init('reload')
        return
      endhandle
    else
    !!alert.error(|The default file | & |$!file | & | does NOT exist. Unable to save and append the User Defined Report to the Reports default file. |)
      return
    endif

  endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
-- Method:      check
--
-- Description:  Check if Run Time Filter Expression can be Validated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Gadget Name
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define Method
define method .check(!string is STRING)

-- Check Selection List Types/Filter are valid
    !error = ''
    if (!string.eq('replist')) then
      if (!this.checklist(!error).not()) then
        !error = !error.before('Unable')
        !!alert.error(!error)
        return
      endif
    elseif (!string.eq('repfilt')) then
      if (!this.checkexprn(!error).not()) then
        !error = !error.before('Unable')
        !!alert.error(!error)
        return
      endif
    endif

  endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
-- Method:      checklist
--
-- Description:  Check if Run Time Filter Expression can be Validated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define Method
define method .checklist(!error is STRING) is BOOLEAN

-- Check Selection List Types are valid before Proceeding
    !list = !this.replist.val.trim()
    if (!list.trim().neq(||)) then
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all ($!list) from !empty
      handle any
        !syntax = !!error.command.after(' (').before(') ').trim()
        !error  = 'Selection List Type(s) NOT valid:
*** $!!error.text
$!syntax ***
Unable to save the Report.'
        return false
      elsehandle none
        return true
      endhandle
    endif

  endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
-- Method:      checkexprn
--
-- Description:  Check if Run Time Filter Expression can be Validated
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define Method
define method .checkexprn(!error is STRING) is BOOLEAN

-- Check Filter Expression is valid before Proceeding
    !filter = !this.repfilt.val
    if (!filter.trim().neq(||)) then
      !this.repfilt.val = !this.repfilt.val.replace('|','''')
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all with ($!filter) from !empty
      handle any
        !syntax = !!error.command.after('with ').before(' from').trim()
        !error  = |The Filter Expression is Incorrect:
*** $!!error.text
$!syntax ***
Unable to save the Report.|
        return false
      elsehandle none
        return true
      endhandle
    endif

  endmethod

-- End of method definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
   define method .cancel()

-- Hide the MDS Headings form
     !this.hide()

-- Activate list gadgets onmain form
     !!mdsnewreports.replist.active =true
     !!mdsnewreports.hdglist.active =true

   endmethod

-- End of method definition
------------------------------------------------------------------------------------------------

return
