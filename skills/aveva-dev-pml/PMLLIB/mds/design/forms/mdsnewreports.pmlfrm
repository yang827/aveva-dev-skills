--
--
-- Description:
-- Form Definition for New MDS Reports Menu
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------------------------------
--
-- Define Form
kill !!mdsnewreports
setup form  !!mdsnewreports at xr0.3 yr0.07
  !!mdsnewreports.formtitle = ' MDS Reports Menu '
  !!mdsnewreports.icontitle = 'MDSREP'

  -- Bar Menu
  bar

    -- MDS Report Output Format
    frame .foutput ' Output Format ' at x1 ymax
      rgroup .output '' at xmin+0.5 ymax+0.03
        add tag 'text'
        add tag 'csv'
        add tag 'screen'
      exit
    exit

    -- MDS Search Component Types
    frame .flist ' Report Output ' at xmax+0.5 ymin
      text .list | List : |        at xmin+0.5 ymax call || width 40 is STRING
    exit

    -- MDS Report Output Heading Titles On/Off
    frame .fhead ' Headings ' at xmax+0.5 ymin
      rgroup .head '' at xmin+0.5 ymax+0.03
        add tag 'On'
        add tag 'Off'
      exit
    exit

    -- MDS Report Output Format
    frame .ffilter ' Main Report ' at x1 ymax
      text .filter | Filter : |    at xmin+0.5 ymax call || width 76 scroll 256 is STRING
      --  frame .ffilter ' Main Report Output ' at xmax+0.5 ymin
      --    text .filter | Filter : |           at xmin+0.5 ymax call || width 51 scroll 256 is STRING
    exit

    -- MDS Report Creation/Definitions
    frame .freplist ' Output Report Name --- Description             Column Heading No. -- Title ' at x1 ymax+0.1
      list .replist '' at x1   ymax call '!this.headinglist(!this.replist.pickedfield)' width 45 length 10
      list .hdglist '' at xmax+0.25 ymin call '!this.headings(!this.hdglist.pickedfield)' width 35 length 10
    exit

    path down

    -- Hierarchy
    frame .fhierarchy ' Hierarchy ' at x1 ymax
      button .ce   | CE | at x1        ymax call |!this.ce()|
      text   .hier ||     at xmax+1.25 ymin call |!this.checkname()| width 52 is STRING
    exit

    -- Sorting and totalling
    button .sorting |Sorting and Totalling...| at xmax+2 ymin.hier call |kill !!mdsreportsort
    show !!mdsreportsort|

    -- RunTime Filter
    frame .frtfilter ' Extra Run Time ' at x1 ymax.fhierarchy
      text .rtfilter | Filter : | at xmin+0.5 ymax call |!this.checkexprn()| width 76 scroll 256 is STRING
    exit

    -- Bottom Line
    button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()| CANCEL
    button .apply   | Apply | tooltip |Generate the Selected MDS report| at x1 ymin call |!this.createreport()|

    -- Form Members
    -- Stores all the Valid Report Definitions
    member .validlines is ARRAY
    member .validreports is MDSREPORTS

    -- Stores all the Headings for each Valid Report Definition
    member .validheadings is ARRAY
    member .validhdgs is MDSHEADINGS

    -- Heading Error True or False
    member .hdgerror is BOOLEAN

    -- Data Error True or False
    member .dataerror is BOOLEAN

    -- None Found Error True or False
    member .founderror is BOOLEAN

    -- Report Date member
    member .datereport is STRING
    member .datefile is STRING

    -- Stores the DBREFS for the Currently Applied Report
    member .selection is ARRAY

    -- Store the Maximum Width of the Headings in their Columns i.e 1 to 20; 21 to 40 etc...
    member .maxwid30  is REAL
    member .maxwid60  is REAL
    member .maxwid90 is REAL
    member .maxwid120 is REAL

    -- store the distance arguments for units conversion
    member .distargs is STRING

  exit

  -- End of form definition

  -- Populate the forms' Bar menu
  -- 1st Bar Heading
  !!mdsnewreports.bar.add('Control', 'CNTRL')
  -- Add menu list
  !!mdsnewreports.newmenu('CNTRL').add('callback', 'Reload Default Reports' , '!!mdsnewreports.init(''reload'')')
  !!mdsnewreports.cntrl.add('callback', 'Close' , '!!mdsnewreports.cancel()')
  -- 2nd Bar Heading
  !!mdsnewreports.bar.add('Report', 'COLUMNS')
  -- Add menu list
  !!mdsnewreports.newmenu('COLUMNS').add('callback', 'Column Headings...' , '!!mdsnewheadings.init()')
  !!mdsnewreports.columns.add('callback', 'User Defined...' , '!!mdsnewheadings.userdef()')



  -- End of Form Definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  --
  -- Method: init
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R      STRING    Pass 'initial' to just initialise the loaded data
  --                       or Pass 'reload'  to redefine the Reports and Headings Forms
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .init(!method is STRING)

    -- Clear the form members '.validlines' and 'validheadings'
    !this.validlines.clear()
    !this.validheadings.clear()

    -- Clear the Form Selection Member
    !this.selection.clear()

    -- Select the Headings On as the Default Option
    !this.head.val = 1

    -- Select the Screen Output as the Default Option
    !this.output.val = 3

    -- Heading Error member
    !this.hdgerror = false

    -- Data Error member
    !this.dataerror = false

    -- None Found  Error member
    !this.founderror = false

    -- Load the ARRAY form member '.validheadings' with the list of valid available headings
    !error = STRING()
    if (!this.headings(!error).not()) then
      !!alert.error(!error)
      !this.hide()
      return
    endif

    -- Load the ARRAY form member '.validlines' with the list of valid pre defined reports
    !error = STRING()
    if (!this.reports(!error).not()) then
      !!alert.error(!error)
      !this.hide()
      return
    endif

    -- Load the Column Headings Form and/or Reload Defaults
    if (undefined(!!mdsnewheadings)) then
      pml load form !!mdsnewheadings
    endif

    if (undefined(!!mdsnewhdgdata)) then
      pml load form !!mdsnewhdgdata
    endif

    if (!method.lowcase().eq('reload')) then
      pml load form !!mdsnewheadings
      pml load form !!mdsnewhdgdata
    endif

    -- Load the valid Pre Defined Default MDS Reports and the Available
    -- Column Headings associated with each of these MDS Reports
    !this.reportlist(!this.validlines)

    -- Show the form
    if (!this.shown().not()) then
      !this.show('at',0.05,0.05)
    endif

    -- Activate BOTH List gadgets
    !this.replist.active = true
    !this.hdglist.active = true
    -- Select the first in the list '.replist' and display the correct headings
    !this.replist.select('dtext',!this.replist.dtext[1])
    !this.headinglist(1)
    -- Set List gadget text and read only
    !this.list.val = !this.validreports.reports[1].list
    !this.list.seteditable(false)
    -- Set Filter gadget text and read only
    !this.filter.val = !this.validreports.reports[1].filter
    !this.filter.seteditable(false)

    -- Hide the form !!mdsnewhdgdata
    if (!method.lowcase().eq('initial')) then
      !!mdsnewhdgdata.hide()
    endif

    -- Set the Precision for the Report Output
    !this.precision()

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: precision
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .precision()

    -- Get Units
    !units = object COMUNITS(TRUE)

    -- Set the Precision for Metric  Units
    if (!!isImperialLength('DIST').not()) then
      preci to     3dp
      preci output 3dp
      preci dist   3dp
      preci var    3dp
      !this.distargs = 'false,false,false,2,true'
    else
      -- Set the Precision for Imperial Units
      preci to     1/16
      preci output 1/16
      preci dist   1/16
      preci var    1/16
      -- set distance argument string for units conversion
      !this.distargs = 'true,true,true,16,true'
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: ce
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .ce()

    -- Select the Current Element
    !this.hier.val = !!ce.name

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: reports
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R     STRING      Set by association to return the correct error
  -- Return:
  --   [Data Type] [Description]
  --    BOOLEAN      Returns FALSE if file doesn't exist or no creditable data found in the file
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .reports(!error is STRING)is BOOLEAN

    -- Read the PDMS project MDS default file MDS-REPORT-DEFS
    !project = current project
    !prjcode = !project.code()
    !reports = object FILE('%$!<prjcode>dflts%/MDS-REPORT-DEFS')
    if (!reports.exists().not()) then
      !error ='The project MDS default reports file ''/%$!<prjcode>dflts%/MDS-REPORT-DEFS'' does not exist. Unable to proceed.'
      return false
    endif

    -- Get the list of Default MDS Reports, Headings etc...
    !lines = !reports.readfile()
    do !indx indices !lines
      skip if (!lines[!indx].trim().match('#').eq(1))
      !linesplit = !lines[!indx].trim().split('\')
      skip if (!linesplit.size().neq(5))
      !this.validlines.append(!linesplit)
    enddo

    if (!this.validlines.size().lt(1)) then
      !error = |No valid MDS report definitions found in the MDS default reports file ''/%$!<prjcode>dflts%/MDS-REPORT-DEFS''. Unable to proceed.|
      return false
    else
      --Load the objects mdsreports() and mdsreportdata()
      do !indx indices !this.validlines
        !this.validreports.set(!indx,!this.validlines[!indx])
        !this.validreports.reports[!indx] = !this.validreports.definition
      enddo
      return true
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: reportlist
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R     ARRAY      Array of the valid pre defined MDS reports
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .reportlist(!dummyReparray is ARRAY)

    -- Set the dtext of List gadgets for '.replist' and '.hdglist'
    !repdtext = ARRAY()
    !indexnum = 0
    do !vals values !this.validlines
      !indexnum = !indexnum + 1
      do !xvals indices !vals
        if (!xvals.eq(1)) then
          !repdtext.append(!vals[!xvals].trim() & ' --- ' & !vals[!xvals + 1].trim())
        elseif (!xvals.eq(3)) then
          !this.headinglist(!indexnum)
        endif
      enddo
    enddo

    !this.replist.dtext = !repdtext

    return true

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: headings
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R      STRING      Set by association to return the correct error
  --
  -- Return:
  --   [Data Type] [Description]
  --    BOOLEAN      Returns FALSE if file doesn't exist or no creditable data found in the file
  --
  ------------------------------------------------------------------------
  -- Define method
  define method .headings(!error is STRING) is BOOLEAN

    -- Read the PDMS project MDS default file MDS-REPORT-HEADINGS
    !project = current project
    !prjcode = !project.code()
    !reports = object FILE('%$!<prjcode>dflts%/MDS-REPORT-HEADINGS')
    if (!reports.exists().not()) then
      !error ='The project MDS default reports file ''/%$!<prjcode>dflts%/MDS-REPORT-HEADINGS'' does not exist. Unable to proceed.'
      return false
    endif

    -- Get the list of Column Headings from the Passed Data
    !lines = !reports.readfile()
    do !indx indices !lines
      skip if (!lines[!indx].trim().match('#').eq(1))
      !linesplit = !lines[!indx].trim().split('\')
      skip if (!linesplit.size().neq(9))
      -- Check if BOTH the Client Code and Client Description are Set to 'true'
      -- ONLY ONE of these is ALLOWED to be SET to 'true' for EACH Heading.
      !ccode = !linesplit[6].trim().boolean()
      !cdesc = !linesplit[8].trim().boolean()
      if (!ccode.unset().not() and !cdesc.unset().not()) then
        if (!ccode and !cdesc) then
          !error = 'Invalid Heading - No. $!<indx>, found in the ''/%$!<prjcode>dflts%/MDS-REPORT-HEADINGS'' default file . ONLY ONE of the Client Code or Client Description fields may be set to ''true''. Unable to proceed.'
          return false
        endif
      endif
      !this.validheadings.append(!linesplit)
    enddo

    if (!this.validheadings.size().lt(1)) then
      !error = 'No valid column heading definitions found in the MDS default file ''/%$!<prjcode>dflts%/MDS-REPORT-HEADINGS''. Unable to proceed.'
      return false
    else

      -- Load the Heading Width Form Members with the Heading Number with the Maximum Length
      -- Index [2] of Each Array contains the Heading Text

      do !numb indices !this.validheadings
        if (!numb.leq(30)) then
          if (!numb.eq(1)) then
            !maxwid = 5
            !maxnum = 1
          endif
          !hwid = !this.validheadings[!numb][2].trim().length()
          if (!hwid.geq(!maxwid)) then
            !maxwid = !hwid
            !maxnum = !numb
          endif
          !this.maxwid30 = !maxnum
        elseif (!numb.leq(60)) then
          if (!numb.eq(31)) then
            !maxwid = 5
            !maxnum = 31
          endif
          !hwid = !this.validheadings[!numb][2].trim().length()
          !maxwid =(max(!maxwid,!hwid))
          if (!hwid.eq(!maxwid)) then
            !maxnum = !numb
          endif
          !this.maxwid60 = !maxnum
        elseif (!numb.leq(90)) then
          if (!numb.eq(61)) then
            !maxwid = 5
            !maxnum = 61
          endif
          !hwid = !this.validheadings[!numb][2].trim().length()
          !maxwid =(max(!maxwid,!hwid))
          if (!hwid.eq(!maxwid)) then
            !maxnum = !numb
          endif
          !this.maxwid90 = !maxnum
        elseif (!numb.leq(120)) then
          if (!numb.eq(121)) then
            !maxwid = 5
            !maxnum = 121
          endif
          !hwid = !this.validheadings[!numb][2].trim().length()
          !maxwid =(max(!maxwid,!hwid))
          if (!hwid.eq(!maxwid)) then
            !maxnum = !numb
          endif
          !this.maxwid120 = !maxnum
        endif
      enddo

      -- Load the object MDSHEADINGS()
      do !indx indices !this.validheadings
        !this.validhdgs.set(!indx,!this.validheadings[!indx])
        !this.validhdgs.headings[!indx] = !this.validhdgs.definition
      enddo
      return true
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: headings
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R      REAL       Pickedfield Value of the list Gadget !this.hdglist
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------
  -- Define method
  define method .headings(!indexnum is REAL)

    -- Display Form with Details of Selected Column Heading
    !hdgnum = !this.hdglist.dtext[!indexnum].before(' -- ').trim().real()
    !!mdsnewhdgdata.index(!hdgnum,!indexnum)
    if (!!mdsnewhdgdata.shown().not()) then
      !!mdsnewhdgdata.init()
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: headinglist
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --    1    R      REAL       Index number of the member .validlines array being processed
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------
  -- Define method
  define method .headinglist(!indexnum is REAL) is ARRAY

    -- The Column Heading Numbers for each Report are always stored in Index[3]
    -- of each iteration of the ARRAY member .validlines
    !hdgdtxt = ARRAY()
    !hdgarry = ARRAY()
    !rephdgs = !this.validlines[!indexnum][3].split(',')
    do !val values !rephdgs
      -- check for column sorting and totalling options
      if (!val.match('(').neq(0)) then
        -- get the column sort/total options
        !val = !val.before('(')
      endif
      !hdgarry.append(!val.trim().real())
    enddo

    -- Set List gadget text and read only
    !this.list.val = !this.validreports.reports[!indexnum].list

    -- Set Filter gadget text and read only
    !this.filter.val = !this.validreports.reports[!indexnum].filter

    -- Get the heading text display values for each heading number
    !hdgarry.unique()
    do !indx indices !hdgarry
      if (!hdgarry[!indx].string().length().eq(1)) then
        !extra = '  '
      elseif (!hdgarry[!indx].string().length().eq(2)) then
        !extra = ' '
      elseif (!hdgarry[!indx].string().length().eq(3)) then
        !extra = ''
      endif

      if (!hdgarry[!indx].unset().not()) then
        !hdgdtxt.append(!extra & !hdgarry[!indx] & ' -- ' & !this.validheadings[!hdgarry[!indx]][2])
      else
        !hdgdtxt.append(!extra & !hdgarry[!indx] & ' -- ' & !this.validheadings[!hdgarry[!indx]][1])
      endif
    enddo

    -- Set the Heading Numbers and Heading Text Display values
    !this.hdglist.dtext = !hdgdtxt

    -- Check if the Column headings have been defined
    if (defined(!!mdsnewheadings.hdg1)) then
      do !indx from 1 to !this.validheadings.size()
        -- Clear/Set All Toggle Gadgets to FALSE and INACTIVE
        !!mdsnewheadings.hdg$!<indx>.val = false
        !!mdsnewheadings.hdg$!<indx>.active = false
      enddo
      -- Inactivate the gadgets on the form
      !!mdsnewheadings.control.setactive('save as default report...',false)
      !!mdsnewheadings.repname.seteditable(false)
      !!mdsnewheadings.repdesc.seteditable(false)
      !!mdsnewheadings.reporder.seteditable(false)
      !!mdsnewheadings.replist.seteditable(false)
      !!mdsnewheadings.repfilt.seteditable(false)

      -- Set to TRUE all of the relevant Toggle Gadgets on the
      -- !!mdsheadings form when each MDS report is Selected
      do !indx indices !hdgdtxt
        !hdgnum = !hdgdtxt[!indx].before(' -- ').after(' ').trim().real()
        !!mdsnewheadings.hdg$!<hdgnum>.val = true
      enddo

      -- Load the Text gadgets
      !!mdsnewheadings.text(!indexnum)

    endif

    -- Load the form !!mdsnewhdgdata with the first heading in the list
    !hdgnum = !hdgdtxt[1].before(' -- ').after(' ').trim().real()
    !!mdsnewhdgdata.index(!hdgnum,1)


    -- load the heading data for this REPORT
    !this.validreports.set(!indexnum,!this.validlines[!indexnum])
    !this.validreports.reports[!indexnum] = !this.validreports.definition

    -- kill the existing report sort/total options form
    kill !!mdsreportsort
    kill !!mdsreperr
    -- reload the sort/total options form and check the values are valid
    pml load form !!mdsreportsort
    if (!!mdsreportsort.checkValues(FALSE).not()) then
      !!alert.error('The sorting/totalling options for this REPORT are invalid, please see error report form and resolve')
      show !!mdsreportsort at xr 1 yr 0
      !!mdsreportsort.checkValues(TRUE)
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: cancel
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .cancel()

    -- Hide ALL the MDS Reports/Headings forms
    !this.hide()
    if (defined(!!mdsnewheadings)) then
      !!mdsnewheadings.hide()
    endif
    if (defined(!!mdsnewhdgdata)) then
      !!mdsnewhdgdata.hide()
    endif

  endmethod

  -- End of method definition

  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method:      checkname
  --
  -- Description:  Check if Entered name EXISTS in MDB
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------
  -- Define Method
  define method .checkname()

    -----------------------------------------------
    -----------------------------------------------
    -->>> ORIGINAL CODE before October 2002
    -----------------------------------------------
    -----------------------------------------------
    -- Check Hierarchy Name
    --    !name = !!checkname(!this.hier.val,'OLD')
    --    !this.hier.val =  !name
    -----------------------------------------------
    -----------------------------------------------
    --<<< ORIGINAL CODE before October 2002
    -----------------------------------------------
    -----------------------------------------------

    --<wd>oct2002
    -- Enhance Hierarchy to use Multiple Valid PDMS Named Elements
    !hierarr = !this.hier.val.trim().split()
    !hierarr.unique()

    -- Check Hierarchy Name if ONLY a Single NAME is entered into the Gadget
    if (!hierarr.size().leq(1)) then
      !name = !!checkname(!this.hier.val,'OLD')
      !this.hier.val =  !name
      return
    endif

    -- Check Names are VALID PDMS Elements for those entered into the Hierarchy Gadget
    !validnames = ''
    !invalnames = ''
    do !val values !hierarr
      -- Check if First character is a '/'<slash> or is an '='<equals>
      if ( (!val.match('/').eq(1)) or (!val.match('=').neq(1)) ) then
        -- PDMS Name has an OBJECTTYPE of STRING()
        !unuseddbref = !val.dbref()
        handle any
          -- Add a '/'<slash> character as the First Character and Test if PDMS Name is Valid
          !nval = '/' & !val
          !unusedndbref = !nval.dbref()
          handle any
            -- Invalid Names for PDMS Elements
            !invalnames = !invalnames & ' ' & !val
          elsehandle none
            -- Valid Names for PDMS Elements
            !validnames = !validnames & ' ' & !nval
          endhandle
        elsehandle none
          -- Valid Names for PDMS Elements
          !validnames = !validnames & ' ' & !val
        endhandle
      elseif (!val.match('=').eq(1)) then
        -- PDMS Reference has an OBJECTTYPE of DBREF()
        !name = !val.name
        handle any
          -- Invalid Names for PDMS Elements
          !invalnames = !invalnames & ' ' & !val
        elsehandle none
          -- Valid Names for PDMS Elements
          !validnames = !validnames & ' ' & !name
        endhandle

      endif
    enddo

    -- Unique the Valid PDMS Element Names to remove any DUPLICATE Entries
    !newinvalnames = ''
    !invalnamesarr = !invalnames.trim().split()
    !invalnamesarr.unique()
    do !inval values !invalnamesarr
      !newinvalnames = !newinvalnames & ' ' & !inval
    enddo
    !newinvalnames = !newinvalnames.trim()
    -- Reset the Hierarchy Gadget Value to show ONLY the Valid PDMS Names of those ORIGINALLY Entered
    if (!newinvalnames.neq('')) then
      !!alert.message('The following PDMS Elements DO NOT EXIST, i.e. [$!<newinvalnames>], and have therefore been REMOVED from the list entered into the Hierarchy Gadget')
    endif

    -- Unique the Valid PDMS Element Names to remove any DUPLICATE Entries
    !newvalidnames = ''
    !validnamesarr = !validnames.split()
    !validnamesarr.unique()
    do !valid values !validnamesarr
      !newvalidnames = !newvalidnames & ' ' & !valid
    enddo
    if (!newvalidnames.trim().eq('')) then
      !this.hier.val = 'Unset'
    else
      !this.hier.val = !newvalidnames.trim()
    endif
    --<wd>oct2002

  endmethod

  -- End of method definition

  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method:      checklist
  --
  -- Description:  Check if Run Time Filter Expression can be Validated
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------
  -- Define Method
  define method .checklist(!error is STRING) is BOOLEAN

    -- Check Selection List Types are valid before Proceeding
    !list = !this.list.val.trim()
    if (!list.trim().neq(||)) then
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all ($!list) from !empty
      handle any
        !syntax = !!error.command.after(' (').before(') ').trim()
        !error  = 'Selection List Type(s) NOT valid:
        *** $!!error.text
        $!syntax ***'
        return false
      elsehandle none
        return true
      endhandle
    endif

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method:      checkexprn
  --
  -- Description:  Check if Run Time Filter Expression can be Validated
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------
  -- Define Method
  define method .checkexprn()

    -- Check Run Time Filter Expression is valid before Proceeding
    !runtime = !this.rtfilter.val
    if (!runtime.trim().neq(||)) then
      !this.rtfilter.val = !this.rtfilter.val.replace('|','''')
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all with ($!runtime) from !empty
      handle any
        !syntax = !!error.command.after('with ').before(' from').trim()
        !!alert.error(|Run Time Filter Expression is Incorrect:
        *** $!!error.text
        $!syntax ***|)
        return
      endhandle
    endif

  endmethod

  -- End of method definition


  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: createreport
  --
  -- Description: Create the Selected Report
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type] [Description]
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .createreport()

    -- Get the Current PDMS Project Code
    !proj = current project
    !code = !proj.code()

    -- Check to see if the project env has been set for the reports directory

    var !evarReports evar $!<code>REPORTS
    if (!evarReports.eq('')) then
      !!alert.error('The environment variable $!<code>REPORTS does NOT exist. Unable to continue')
      return
    endif

    -- Allow Report to be Generated if ONLY Screen Output is Required and MDDREPORTS evar Does NOT Exist
    if (!this.output.val.neq(3)) then
      -- Check if the evar <project code>REPORTS is defined and the Directory Exists
      var !evar evar $!<code>REPORTS
      !dobj = object FILE(!evar)
      if (!dobj.exists().not()) then
        !!alert.error('The directory defined in the environment variable $!<code>REPORTS does NOT exist. Unable to continue')
        return
      endif
      if (!dobj.type().neq('DIRECTORY')) then
        !!alert.error('The environment variable $!<code>REPORTS does NOT exist as a Directory. Unable to continue')
        return
      endif
    endif

    -- Check the Selection List Types are Valid
    !error = ''
    if (!this.checklist(!error).not()) then
      !!alert.error(!error)
      return
    endif

    -- Check if User wants to Report on the MDB
    if (!this.hier.val.unset() or !this.hier.val.eq('')) then
      if (!!alert.confirm('The Hierarchy is ''Unset'', this will ''Report on the whole of the current MDB''. Do you want to continue?').eq('NO') ) then
        return
      endif
    elseif (!this.hier.val.eq('/*')) then
      if (!!alert.confirm('The Hierarchy is ''/*'', this will ''Report on the whole of the current MDB''. Do you want to continue?').eq('NO') ) then
        return
      endif
    endif


    -- Get the Object Details of the Selected Report
    !report = !this.validreports.reports[!this.replist.val]

    -- Get the Report Headings from the MDSHEADINGSDATA Object for the Selected report
    do !indx indices !report.headings
      !headings[!indx] = !this.validhdgs.headings[!this.validreports.reports[!this.replist.val].headings[!indx]]
    enddo

    -- Set the Precision for the Report Output
    !this.precision()

    -- Run the Selected Report
    !this.runreport(!report,!headings)

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: runreport
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]      [Description]
  --    1    R     MDSREPORTDATA   Object containing ALL the Data to Run The MDS Report
  --    2    R        ARRAY        Array of Heading Objects MDSHEADINGDATA needed for the MDS Report
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .runreport(!report is MDSREPORTDATA, !headings is ARRAY)

    ------------------------------------------------------------------------------------------------
    -- All the Data Required to Generate the report is contained in the Passed variables:
    ------------------------------------------------------------------------------------------------
    -- <1> !report   -> contains the Selected Report MDSREPORTDATA object data
    -- <2> !headings -> is an ARRAY of MDSHEADINGSDATA objects containing the data for each Heading in the Selected Report
    ------------------------------------------------------------------------------------------------

    ------------------------------------------------------------------------------------------------
    -- The MDS Element (List) Types to be Reported on are  Currently:
    ------------------------------------------------------------------------------------------------
    -- <1> <atta>  -> Used for ALL Support Types(All Pipe Attachments + SREF Attas for Frameworks and Trunnion Branches Only
    -- <2> <stru>  -> Used for FRAMEWORK 'Standards' and 'Special' Supports
    -- <3> <bran>  -> Used for TRUNNION type supports ONLY only
    -- <4> <sctn>  -> Members of Framework owned by the MDS Framework Structure - 'Standards' and 'Special' Supports
    -- <5> <sjoi>  -> Sjoint Members of Framework owned by the MDS Framework Structure
    -- <6> <sheet> -> Drawing Sheets for MDS Drawings/Tables
    ------------------------------------------------------------------------------------------------

    -- Get Project Code
    !proj = current project
    !code = !proj.code()
    var !evar evar $!<code>REPORTS

    -- Get the Required Output Format
    !format = !this.output.selection()

    -- Get the Report and Headings Data Required
    !hier = !this.hier.val
    !list = !report.list.trim()
    !filt = !report.filter
    !runtime = !this.rtfilter.val
    if (!runtime.neq('')) then
      !runtime = ' and ' & '(' & !runtime & ')'
    endif
    do !indx indices !headings
      !hdg$!<indx>titl  = !headings[!indx].title
      !hdg$!<indx>numb  = !headings[!indx].number
      !hdg$!<indx>xprn  = !headings[!indx].expression
      !hdg$!<indx>func  = !headings[!indx].function
      !hdg$!<indx>unset = !headings[!indx].unset
    enddo
    !hdgsize = !headings.size()

    -- Build Up the Commands for the Report
    --    !crit = 'all (atta stru bran sctn sjoi sheet)'
    !crit = 'all (' & !list & ')'
    --!crit = !crit & ' where ' & !filt & !runtime
    !crit = !crit & ' where ' & '(' & !filt & ')' & !runtime
    if (!hier.unset().not() and !hier.neq('') and !hier.neq('/*')) then
      !crit = !crit & ' for ' & !hier
    endif

    -- Generate the Collection
    var !selection collect $!crit
    handle any
      -- Handle an Invalid Selection
      !!alert.error(|Invalid Selection Criteria:
      *** $!!error.text
      $!!error.command ***|)
      return
    elsehandle none
      !this.selection.appendarray(!selection)
    endhandle

    --Column Headings Evaluation from Expression and/or PML Function
    !columns = ARRAY()
    do !indx from 1 to $!hdgsize
      -- Set temporary variables
      !hdgn = !hdg$!<indx>numb
      !hdgt = !hdg$!<indx>titl.trim()
      !hdgx = !hdg$!<indx>xprn.trim()
      !hdgf = !hdg$!<indx>func.trim().lowcase()
      !hdgu = !hdg$!<indx>unset.trim()
      --  Set the Alternative Unset Text if it is NOT Set
      if (!hdgu.eq('')) then
        !hdgu = '---'
      endif

      -- Evaluate the Column Heading Expression, if Specified, for the SELECTED Elements
      !xprn = false
      if (!hdgx.neq('')) then
        var !colm$!<indx> eval $!hdgx for all from !selection ignore any '$!hdgu'
        handle any
          !!alert.error('Unable to evaluate expression for Column Heading No. $!<hdgn> -- $!<hdgt>.
          *** $!!error.text
          $!!error.command ***
          Aborting Report generation')
          return
        elsehandle none
          !xprn = true
        endhandle
      endif

      -- Evaluate the Heading PML Function, if Specified, for the SELECTED Elements
      !func = false
      if (!hdgf.neq('')) then
        !unusedpmlfile = !!pml.getpathname('$!<hdgf>.pmlfnc')
        handle any
          !!alert.error ('PML Function Location Error for ''$!<hdgf>'':
          *** $!!error.text ***
          Aborting Report generation')
          return
        elsehandle none
          !func = true
        endhandle

        -- Concatenate Function Call String and Execute
        !ffile = '!!' & !hdgf
        if (!xprn and !func) then
          !farry = $!<ffile>(!selection, !colm$!<indx>)
          handle any
            !!alert.error ('The PML Function ''$!<hdgf>'' for Heading No. $!<hdgn> - MUST accept TWO Arguments, BOTH object types to be ARRAY and also return an ARRAY.
            *** $!!error.text ***
            Aborting Report generation')
            return
          endhandle
        elseif (!xprn.not() and !func) then
          !farry = $!<ffile>(!selection)
          handle any
            !!alert.error ('The PML Function ''$!<hdgf>'' for Heading No. $!<hdgn> - MUST accept only ONE Argument, of object type ARRAY and also return an ARRAY.
            *** $!!error.text ***
            Aborting Report generation')
            return
          endhandle
        elseif (!xprn.not() and !func.not()) then
          !!alert.error('Neither an ''Expression'' nor a ''PML Function'' has been evaluated for Heading No. $!<hdgn>
          Aborting Report generation')
          return
        endif

        -- Reset Column Heading Array to the Regenerated PML Function Data Array
        if (!farry.objecttype().neq('ARRAY')) then
          !!alert.error ('The PML Function ''$!<hdgf>'' for Heading No. $!<hdgn> - does NOT return an OBJECT TYPE of ARRAY.
          Aborting Report generation')
          return
        elseif (!selection.size().neq(!farry.size())) then
          !ssiz = !selection.size()
          !fsiz = !farry.size()
          !!alert.error ('The PML Function ''$!hdgf'' for Heading No. $!<hdgn> - does NOT return the Same Number of values [$!<fsiz>] as the Selected Components[$!<ssiz>] in the Report.
          Aborting Report generation')
          return
        endif
        !colm$!<indx> = !farry
      else
        if (!xprn.not() and !func.not()) then
          !!alert.error('Neither an ''Expression'' nor a ''PML Function'' has been evaluated for Heading No. $!<hdgn>
          Aborting Report generation')
          return
        endif
      endif
      -- Append Each Column Heading Expression Returns into an Array
      !columns.append(!colm$!<indx>)
    enddo

    -- Format the Report
    !this.formatreport(!columns, !headings)

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: formatreport
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]        [Description]
  --    1    R         ARRAY      Array of Arrays containing the Extracted Data for the Heading Values
  --    2    R         ARRAY      Array containing the Heading Data for the Report
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .formatreport(!columns is ARRAY, !headings is ARRAY)
    !!cl = !columns

    -- Set the Array of Reals Storing the Column Headings on the Report
    --!hdgarr = !this.validreports.reports[!this.replist.val].headings

    -- Split the !columns Array of Arrays into Separate Arrays for each Column Heading
    !colSize = !columns.size()
    do !indx indices !columns
      !col$!<indx> = !columns[!indx]
    enddo

    -- Headings Data
    do !indx indices !headings
      !hdgt$!<indx> = !headings[!indx].title
      !hdgn$!<indx> = !headings[!indx].number

      -- Determine if the Column Needs to Replace the MDS Standard Codes with the Client Codes
      if (!headings[!indx].ccode.trim().eq('') or !headings[!indx].ccode.unset()) then
        !hdgc$!<indx> = false
      else
        !hdgc$!<indx> = !headings[!indx].ccode.trim().boolean()
        handle any
          !hdgc$!<indx> = false
        endhandle
      endif

      -- Determine if the Column Needs to Replace the MDS Standard Description with the Client Description
      if (!headings[!indx].cdesc.trim().eq('') or !headings[!indx].cdesc.unset()) then
        !hdgz$!<indx> = false
      else
        !hdgz$!<indx> = !headings[!indx].cdesc.trim().boolean()
        handle any
          !hdgz$!<indx> = false
        endhandle
      endif
    enddo

    -- Get the MDS Replacement Names - Client Codes and Descriptions for All Support Types
    !replnames = !this.replacement()

    -- Get the MDS Alternate Names - Client Codes for Framework Support Types Only
    !altdnames = !this.alternate()

    -- Replace the Extracted Data with the Client Descriptions in the Nominated Column Headings Data Arrays
    !selarr = !this.selection

    do !ndx
      if (defined(!hdgz$!<ndx>)) then
        skip if (!hdgz$!<ndx>.not())

        do !cnt indices !col$!<ndx>
          -- Determine the Support Type for Each Iteration in the Selection Array
          !supt = !selarr[!cnt].dbref().:mdssupptype
          if (!supt.eq('') or !supt.unset()) then
            --<wd>may2003
            --            if (!selarr[!cnt].dbref().type.eq('ATTA')) then
            if ((!selarr[!cnt].dbref().type.eq('ATTA')) or (!selarr[!cnt].dbref().type.eq('PLAT'))) then
              --<wd>may2003
              !supt = !selarr[!cnt].dbref().styp

            endif
          endif

          do !rval values !replnames
            -- Set the Value of the FIRST and THIRD parts of Each Index in the Array !replnames,
            -- i.e. PART 1 is The MDS Standard CODE, e.g. AT01, FT09 etc...,
            -- and PART 2 The MDS Standard Client Description, e.g. ' - Pipe Shoe for Pipe Sizes NPS2"-36" '
            !rval1 = !rval.part(1,'\').trim()
            !rval3 = !rval.part(3,'\').trim()

            -- Replace the MDS Standard Description (i.e.the :MDSSUPPDESC of DETREF) with the Client Description
            if (!supt.match(!rval1).eq(1)) then
              if (!rval3.neq('')) then
                if (!rval3.match('- ').eq(1)) then
                  !col$!<ndx>[!cnt] = !rval3.after('- ')
                elseif (!rval3.match('-').eq(1)) then
                  !col$!<ndx>[!cnt] = !rval3.after('-','')
                else
                  !col$!<ndx>[!cnt] = !rval3
                endif
                !col$!<ndx>[!cnt] = !col$!<ndx>[!cnt].replace(|'|,|''|)
              endif
            endif
          enddo
        enddo

      else
        break
      endif
    enddo


    -- Replace the Extracted Data with the Client Codes in the Nominated Column Headings Data Arrays
    do !indx
      if (defined(!hdgc$!<indx>)) then
        skip if (!hdgc$!<indx>.not())
        -- Determine the Alternative Codes which Only Apply to MDS FRAMEWORKS
        -- Remove Size Code (eg: FT09-1-4.12 where '.12' is the size code) and
        -- Substitute the Alternative Client Code
        do !cnt indices !col$!<indx>
          !numb        = 0
          !cval$!<cnt> = !col$!<indx>[!cnt].trim().before('.')
          !altn$!<cnt> = false
          do !aval values !altdnames
            if (!cval$!<cnt>.match('FT').eq(1)) then
              !numb = !numb + 1
            elseif (!cval$!<cnt>.match('CT').eq(1)) then
              !numb = !numb + 1
            elseif (!cval$!<cnt>.match('DT').eq(1)) then
              !numb = !numb + 1
            endif

            skip if (!numb.eq(0))
            skip if (!aval.match(!cval$!<cnt>).neq(1))
            !alin  = !aval.split('\')
            !altn  = !alin[2].trim()
            skip if (!altn.eq('*'))
            !col$!<indx>[!cnt] = !altn
            !altn$!<cnt>       = true
          enddo


          -- Determine the Replacement Client Codes for ALL MDS Supports, EXCEPT where an ALTERNATE Client Code applies
          do !rval values !replnames
            -- Set the Values of the First 3 Parts of Each Index in the Array !replnames
            !rval1       = !rval.part(1,'\').trim()
            !rval2       = !rval.part(2,'\').trim()
            !rval3       = !rval.part(3,'\').trim()
            !xval$!<cnt> = !col$!<indx>[!cnt].trim()
            -- Replace MDS Standard Codes with Client Codes
            if (!xval$!<cnt>.match(!rval1).eq(1)) then
              if (!altn$!<cnt>.not()) then
                if (!rval2.empty().not()) then
                  !col$!<indx>[!cnt] = !rval2
                else
                  !col$!<indx>[!cnt] = !rval1
                endif
              endif
              -- DEF-SUPP-DEFS name = 'AN01A' - and - MDS' Spec Ref = 'AN01-A...'
            elseif (!xval$!<cnt>.match(!rval1.part(1,'\').trim().substring(1,4) & '-' & !rval1.part(1,'\').trim().substring(5,1)).eq(1)) then
              if (!altn$!<cnt>.not()) then
                if (!rval2.empty().not()) then
                  !col$!<indx>[!cnt] = !rval2
                else
                  !col$!<indx>[!cnt] = !rval1
                endif
              endif
            endif
          enddo
        enddo
      else
        break
      endif
    enddo

    --  Copy the Arrays of the Extracted Data
    !rcolarr = ARRAY()
    do !indx
      !rcol$!<indx> = !col$!<indx>
      handle any
        break
      endhandle
      !rcolarr[!indx] = !rcol$!<indx>
    enddo

    -----------------------------------
    -- Get Information to Output Report
    -----------------------------------
    -- Get the Required Output Format
    !format = !this.output.selection()

    -- Get Project Code
    !proj = current project
    !code = !proj.code()
    var !evar evar $!<code>REPORTS

    -- Get the Date for the Report
    !this.date()

    -- Set the Start of the Report Data
    if (!this.head.selection().boolean()) then
      !start = !this.startofrep()
    else
      !start[1] = ''
    endif

    -- Set the End of Report Data
    if (!this.head.selection().boolean()) then
      !end = !this.endofrep()
    else
      !end[1] = ''
    endif

    ---------------------------------------------------------------------------------------------------------------
    --<wd>nov2003>>>

    -- Compose Report Data
    --    !data = !this.repdata(!rcolarr,!headings)

    -- ONLY Compose the Report Data if the COLUMN ARRAYS in the ARRAY !rcolarr contain ONE ore MORE ELEMENTS i.e.
    -- CHECK for the ERROR (2,752)   Array element 0 does not exist
    if (!rcolarr.size().lt(1)) then
      !this.founderror = true
    else
      if (!rcolarr[1].size().lt(1)) then
        !this.founderror = true
      else
        -- Compose Report Data
        !data = !this.repdata(!rcolarr,!headings)
      endif
    endif
    --<wd>nov2003<<<
    ---------------------------------------------------------------------------------------------------------------


    if (!this.hdgerror) then
      !!alert.error('The Report Headings exceed 256 characters - Aborting Report Generation. [$!!error.text]')
      !this.hdgerror = false
      return
    elseif (!this.dataerror) then
      !!alert.error('The Report Data to be Output exceeds 256 characters - Aborting Report Generation - [$!!error.text]')
      !this.dataerror = false
      return
    elseif (!this.founderror) then
      --<wd>nov2003>>>
      --!!alert.error('*** NONE FOUND *** - Aborting Report Generation')
      !data[1] = '  ******************'
      !data[2] = '  *** NONE FOUND ***'
      !data[3] = '  ******************'
      !data[4] = ''
      !this.founderror = false
      --return
      --<wd>nov2003<<<
    endif

    -- Output Report in the Required Format
    !report = ARRAY()
    !report.appendarray(!start)
    !report.appendarray(!data)
    --q var !report
    !report.appendarray(!end)
    !this.repoutput(!report)

    -- Clear the Form Selection Member
    !this.selection.clear()

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: repoutput
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]  [Description]
  --    1    R        ARRAY      Array of Report Output data
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .repoutput(!report is ARRAY)

    -- Get the Date Time Stamp for the filename
    !date = !this.datefile

    -- Get Project Code
    !proj = current project
    !code = !proj.code()
    var !evar evar $!<code>REPORTS

    -- Get the Required Output Format
    !format = !this.output.selection().trim()

    -- Get Report File Suffix
    if (!format.eq('text')) then
      --!suffix = '.txt'
      !suffix = '.rep'
    elseif (!format.eq('csv')) then
      !suffix = '.csv'
    else
      -- Screen Output Required
      if (!!cadcbth.shown().not()) then
        show !!cadcbth
      endif
      -- Write All Report Data to the Screen
      do !value values !report
        write !value
      enddo
      return
    endif

    -- Get the Name of theOutput Report
    !fnam = !this.validreports.reports[!this.replist.val].name

    -- Write All Data to a '.txt' or a '.csv' File
    !fobj = object FILE('$!<evar>\$!<fnam>-$!<date>$!<suffix>')
    !option = 'WRITE'
    if (!fobj.exists()) then
      if (!!alert.confirm('The MDS report file ** $!fobj ** already exists. Do you want to Overwrite the existing file?').eq('NO')) then
        return
      else
        !option = 'OVERWRITE'
      endif
    endif

    -- Write the FINAL MDS Report File requested
    --!!writeFile('$!fobj','$!option', !report)
    !fobj.writeFile('$!option', !report)

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: date
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]   [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .date() is STRING

    -- Get Variables for the Date Time Stamp
    !dobj  = object DATETIME()
    !dday  = !dobj.date()
    !zday = REAL()
    if (!dday.lt(10)) then
      !zday = 0
    endif
    !dmon  = !dobj.monthstring()
    !dyear = !dobj.year()
    !dhour = !dobj.hour()
    !zhour = REAL()
    if (!dhour.lt(10)) then
      !zhour = 0
    endif
    !dmin  = !dobj.minute()
    !zmin = REAL()
    if (!dmin.lt(10)) then
      !zmin = 0
    endif
    !dsec  = !dobj.second()
    !zsec = REAL()
    if (!dsec.lt(10)) then
      !zsec = 0
    endif

    -- Set the Report Date Members
    --!this.datefile   = !dobj.date() & !dobj.monthstring().substring(1,3) & !dobj.year().string().substring(3,2) & '+' & !dobj.hour() & '-' & !dobj.minute() & '-' & !dobj.second()
    --!this.datereport = !dobj.date() & '-' & !dobj.monthstring() & '-' & !dobj.year() & ' ' & !dobj.hour() & ':' & !dobj.minute()

    !this.datefile   = !zday & !dday & !dmon.substring(1,3) & !dyear.string().substring(3,2) & '+' & !zhour & !dhour & '-' & !zmin & !dmin & '-' & !zsec & !dsec
    !this.datereport = !zday & !dday & '-' & !dmon & '-' & !dyear &' ' & !zhour & !dhour & ':' & !zmin & !dmin & ':' & !zsec & !dsec

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: replacement
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]        [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --      ARRAY    MDS Standard Names, Replacement Names and Client Descriptions for all MDS Support Types
  --
  ------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  -- Get the MDS Replacement Names - Client Codes and Descriptions for All Support Types
  -- Define method
  define method .replacement() is ARRAY

    -- Delete Global Variables
    if (defined(!replnames)) then
      !replnames.delete()
    endif
    --
    ---------------------------------------------------------------------------------------------------
    --<wd>jan2007<mds12>
    --
    ---- Read the MDS Standard Replacement names into a global variable
    --    !replreadf = !!readfile('$!!mdsfiles.description')
    --    !replnames  = ARRAY()
    --    do !rname values !replreadf
    --      skip if (!rname.trim().length().eq(0))
    --      skip if (!rname.match('#').gt(0))
    --      skip if (!rname.match('MDS').eq(1))
    --      !replnames.append(!rname)
    --    enddo
    --

    -- This METHOD has been RE-WRITTEN at MDS12 to extract the DATA from the
    -- NEW MDS12 PARAGON CATALOGUE DEFAULTS DATABASE
    --
    -- FROM the 5<five> PARAGON CATALOGUES for the PDMS Project MDS DESIGN APPLICATION DEFAULTS
    -- LOAD ALL of the "ACTIVE" PARAGON CATALOGUE DATA elements representing the MDS STANDARDS "GENERAL" defaults
    -- e.g. .../CODE <MDS Standard Code>, .../CCOD <MDS Client Code> and .../DESC <MDS Client Description>
    -- and LOAD the ARRAY !replnames accordingly for each MDS STANDARD type <AT*, FT*, GT*, TT*, FH* etc...>

    -- Initialise Variable Array for the 5 PARAGON CATALOGUES
    !mdscatas = ARRAY()
    !mdscatas.append(/MDS/STRUCTURE/DEFAULTS )
    handle ANY
    endhandle
    !mdscatas.append(/MDS/ATTA/DEFAULTS )
    handle ANY
    endhandle
    !mdscatas.append(/MDS/TRUNNION/DEFAULTS )
    handle ANY
    endhandle
    !mdscatas.append(/MDS/PRELIMINARY/DEFAULTS )
    handle ANY
    endhandle
    !mdscatas.append(/MDS/HANGER/DEFAULTS )
    handle ANY
    endhandle

    -- Initialise the Collection Object data for the "ACTIVE" PARAGON
    -- CATALOGUE SECTION elements in the current PDMS Project
    !type  = |SECTION|
    !filt  = object EXPRESSION(':mdsactive eq TRUE')
    !scope = ARRAY()
    !scope.appendarray(!mdscatas)

    -- Collect ALL of the DESPARS DATA Elements
    !sect  = object COLLECTION()
    !sect.filter(!filt)
    !sect.scope(!scope)
    !sect.type(!type)

    -- Collection Results Array
    !results = !sect.results()

    -- Determine the MDS DEFAULT values for the DKEYS CODE, CCOD and DESC from the MDS DEFAULT DTSE DATA elements with the appropriate DKEYS
    !replnames = ARRAY()
    if (!results.size().gt(0)) then
      -- Process the "ACTIVE" PARAGON CATALOGUE SECTION elements
      do !indx indices !results

        -- Determine the MDS Standard CODES, CLIENT CODES and CLIENT DESCRIPTIONS from the !results Array
        -- SKIP the SECTION if ANY ERROR is raised, e.g. Any ONE of the THREE DTSE DATA elements does NOT exist
        !sectname = !results[!indx].name
        -- Determine the MDS Standard CODE Property Value
        !dataname = !sectname & '/GEN/CODE'
        !datadbrf = $!<dataname>
        handle NONE
          !datacode = pprop of $!<dataname>
          !datacode = $!<datacode>
        elsehandle ANY
          skip
        endhandle

        -- Determine the MDS Standard CCOD Property Value
        !dataname = !sectname & '/GEN/CCOD'
        !datadbrf = $!<dataname>
        handle NONE
          !dataccod = pprop of $!<dataname>
          !dataccod = $!<dataccod>
        elsehandle ANY
          skip
        endhandle

        -- Determine the MDS Standard DESC Property Value
        !dataname = !sectname & '/GEN/DESC'
        !datadbrf = $!<dataname>
        handle NONE
          !datadesc = pprop of $!<dataname>
          !datadesc = $!<datadesc>
          !datadesc = !datadesc.trim()
        elsehandle ANY
          skip
        endhandle

        -- ALL of the DATA elements EXIST in the SECTION, so ADD the CONCATENATION of each Property Value to the !replnames ARRAY
        !replnames[!indx] = !datacode & ' \ ' & !dataccod & ' \ ' & !datadesc

      enddo

    endif
    --<wd>jan2007<mds12>
    ---------------------------------------------------------------------------------------------------

    return !replnames
  endmethod
  --
  -- End of method definition
  --

  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: alternate
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]        [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --      ARRAY    MDS Standard Alternate Names (Frameworka Only)
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .alternate() is ARRAY

    ---------------------------------------------------------------------------------------------------
    --<wd>jan2007<mds12>
    --
    -- Read the MDS Framework Alternate Replacement names into a global variable
    --    !altdreadf = !!readfile('$!!mdsfiles.aLTD')
    --
    -- Determine the "current" MDS12 Framework Alternate Replacement VARIABLE "NAMES" via the new MDS12 PML OBJECT MDSALTDDEFS
    -- e.g at MDS12 -- !altdreadf.altdarray[1] = !!mdsaltdCT01C11, !altdreadf.altdarray[1700] = !!mdsaltdFT0924
    -- and !altdreadf.altdarray[4436] = !!mdsaltdGT10C20' etc...
    !altdreadf = object MDSALTDDEFS()

    --
    --<wd>jan2007<mds12>
    ---------------------------------------------------------------------------------------------------

    !altdnames = ARRAY()
    ---------------------------------------------------------------------------------------------------
    --<wd>jan2007<mds12>
    -- Now Determine the "current" MDS12 Framework Alternate Replacement VARIABLE "VALUE" from the PML OBJECT member !altdreadf.altdarray
    --
    !altd = !altdreadf.altdarray
    do !value values !altd
      --      skip if (!value.trim().length().eq(0))
      --      skip if (!value.match('#').gt(0))
      --      skip if (!value.match('\*').gt(0))
      --      !altdnames.append(!value)
      --

      !altdval = |$!value|
      skip if (!altdval.trim().length().eq(0))
      skip if (!altdval.trim().match('#').gt(0))
      skip if (!altdval.trim().match('*').gt(0))
      !altdnames.append(!altdval)
      --
      --<wd>jan2007<mds12>
      ---------------------------------------------------------------------------------------------------
    enddo

    return !altdnames

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------


  ------------------------------------------------------------------------------------------------
  -- Method: repdata
  --
  -- Description: Method to sort the report output based on the sorting, sub-totalling
  -- and totalling options defined for the report. This code is based on the original
  -- standard report PML application written by JJ. I've added internal comments
  -- to help explain what's going on... The code makes use of SORT, EVAL, COMPOSE
  -- and SUBTOTAL command line syntax (all PML1) and some parts of these are not documented;
  -- EVAL and COMPOSE contains specific syntax to allow for sub-totalling and totalling
  -- which is not documented anywhere I can find.
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW] [Data Type]  [Description]
  --    1     R     ARRAY       Array of arrays of Extracted Data for each column heading
  --    2     R     ARRAY       Array of Column Heading Objects MDSHEADINGSDATA
  --
  -- Return:
  --   [Data Type] [Description]
  --      ARRAY      Composed Lines Output Report Data
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .repdata(!rcolarr is ARRAY,!headings is ARRAY) is ARRAY

    -- define the results variable
    !output = object ARRAY()

    ------------------------------------------------------------------------------
    -- The following code is taken from the standard reports facility in PDMS
    -- The code has been modified for MDS and I have preserved the original
    -- variable names from the PML1 reports code. However the global definitions
    -- of these variables have been changed to locals. Some variables remain
    -- global as it is necessary to execute the main sorting and compose command
    -- syntax as a $ continuation external macro to get around 256 char limit
    -- of string variables (SJR)
    ------------------------------------------------------------------------------

    -----------------------------------------------------
    -- Handling FINCH format values in numeric columns --
    -----------------------------------------------------
    -- To handle columns holding imperial units (FINCH) we need to
    -- check all numeric columns for a foot mark ' or fraction division symbol '/'
    -- and convert these values to inches before any sorting/totalling/sub-totalling
    -- is performed otherwise the COMPOSE syntax will not recognise these values and
    -- totals/subtotals will be incorrect

    -- copy the column arrays to a new array that will be re-formatted to inch
    -- values for sorting
    !urcolarr = !rcolarr
    !convertCol = object ARRAY() $* array of booleans for all columns that need converting back to distance units
    !units = object COMUNITS(TRUE)
    if (!!isImperialLength('DIST')) then
      UNITS INCH DIST
      -- check all numeric columns for ' and / and convert to inches
      do !col index !urcolarr
        if (!headings[!col].data.trim().upcase().substring(1,1).eq('N')) then
          -- this is a numeric field
          -- process all the row values
          !convertCol[!col] = false
          do !row index !urcolarr[!col]
            if (!urcolarr[!col][!row].match(|'|).neq(0).or(!urcolarr[!col][!row].match(|/|).neq(0))) then
              !urcolarr[!col][!row] = dist($!urcolarr[$!col][$!row])
              !convertCol[!col] = true
            endif
          enddo
        endif
      enddo
      !units.restoreSavedUnitsByPtype('DIST')
    else
      do !col index !rcolarr
        !convertCol[!col] = false
      enddo
    endif

    ------------------------------------------------------------------------------
    -- SETUP LOCAL VARIABLES TO SUIT EXITING REPORT CODE (See notes above)
    ------------------------------------------------------------------------------

    -- csv specific controls
    !!sep = ',' $* field separator for csv output
    --<wd>jun2003
    --!!del = '"' $* text delimiter for csv output
    !!del = '' $* text delimiter for csv output
    --<wd>jun2003

    if (!!mdsnewreports.output.selection().upcase().eq('CSV')) then
      !spaceVal = '0'
      !csv = ','
      !isCSV = true
    else
      !spaceVal = '2'
      !csv = ''
      !isCSV = false
    endif

    -- break the column array of arrays into individual numbered arrays
    -- to work with the existing code
    do !x index !rcolarr
      !!col$!x = !rcolarr[!x]
    enddo
    do !x index !urcolarr
      !!ucol$!x = !urcolarr[!x]
    enddo

    -- selection size
    !selsize = !rcolarr[1].size()

    -- number of columns to be processed
    !colSize = !rcolarr.size()

    -- get sort order/precedence
    !cdcArepPREC = object ARRAY() $* array of sorting precedence values
    do !head values !headings
      if (!head.sortprec.eq(0)) then
        !precedence = ''
      else
        !precedence = !head.sortprec.string()
      endif
      !cdcArepPREC.append(!precedence)
    enddo

    -- get subtotal-on-column array
    !cdcArepDSUB = object ARRAY() $* array of subtotal-on-column values
    do !head values !headings
      !sscol = 'Off'
      if (!head.subSortCol.eq(0)) then
        !sscol = 'Off'
      else
        do !x index !headings
          if (!headings[$!x].number.eq(!head.subSortCol)) then
            !sscol = !x.string()
            break
          endif
        enddo
      endif
      !cdcArepDSUB.append(!sscol)
    enddo

    -- get total on/off array
    !cdcArepDTOT = object ARRAY() $* array of total on/off flags
    do !head values !headings
      if (!head.total) then
        !totf = 'On'
      else
        !totf = 'Off'
      endif
      !cdcArepDTOT.append(!totf)
    enddo

    -- get subtotal output option values array
    !cdcArepDVAL = object ARRAY() $* array of subtotal output option values
    do !head values !headings
      if (!head.subValues.eq('ON')) then
        !sval = 'On'
      elseif (!head.subValues.eq('OFF')) then
        !sval = 'Off'
      elseif (!head.subValues.eq('SUB')) then
        !sval = 'Sub'
      elseif (!head.subValues.eq('FIRST')) then
        !sval = '1st'
      endif
      !cdcArepDVAL.append(!sval)
    enddo

    -- setup justifications for each columns
    !headJust = object ARRAY()
    do !head values !headings
      if (!head.justify.trim().upcase().eq('')) then
        !headJust.append('L')
      elseif (!head.justify.trim().upcase().eq('LEFT')) then
        !headJust.append('L')
      elseif (!head.justify.trim().upcase().eq('RIGHT')) then
        !headJust.append('R')
      elseif (!head.justify.trim().upcase().eq('CENTRE')) then
        !headJust.append('C')
      else
        !headJust.append('L')
      endif
    enddo

    -- setup data types for each columns
    !dataType = object ARRAY()
    do !head values !headings
      if (!head.data.upcase().substring(1,1).eq('N')) then
        !dataType.append('NUMERIC')
      else
        !dataType.append('CIASCII')
      endif
    enddo

    -- calculate max column widths from the max value of the column width
    -- and the column title text, if values are OFF for this COLUMN
    -- then just use the title text width
    !xx = 0
    do !head values !headings
      !xx = !xx + 1
      if(|$!cdcArepDVAL[$!xx]| ne |Off|) then
        !cdcArepWID[!xx] = STRING(max(!head.title.trim().length(),!!col$!xx$n.width()))
      else
        !cdcArepWID[!xx] = !head.title.trim().length().string()
      endif
    enddo

    ------------------------------------------------------------------------------
    -- PERFORM ARRAY SORTING BASED ON REQUESTED SORT AND SUBTOTAL OPTIONS
    ------------------------------------------------------------------------------
    -- do sorting if the sort precedence array has any values
    if (arraywidth(!cdcArepPREC) gt 0) then

      -- get the order for the sort
      var !colindex sort noempty !cdcArepPREC numeric ascending

      -- start to build the sorting command line
      !lineArr = object ARRAY()
      !lineArr[1] = |var !!sortorder sort $$|

      -- go through all columns to be sorted in sort precedence
      -- and build command line to sort the individual columns
      do !i values !colindex

        !lineArr.append(|!!col$!i $$|)

        -- determine sort direction
        if (!headings[$!i].sortascend) then
          !direction = 'ASCENDING'
        else
          !direction = 'DESCENDING'
        endif

        -- get column data type (NUMERIC or CIASCII)
        !sortMode = !dataType[$!i]

        -- construct sort command line for this COLUMN
        !lineArr.append(|$!sortMode $!direction $$|)

        -- check if we are subtotaling on this COLUMN
        do !colno indexes !cdcArepDSUB
          if('$!cdcArepDSUB[$!colno]' eq '$!i') then
            !lineArr.append(|LASTINGROUP !!lastingroup$!i $$|)
            break
          endif
        enddo

        -- set the subtotal values output options
        if('$!cdcArepDVAL[$!i]' eq '1st') then
          !lineArr.append(|FIRSTINGROUP !!firstingroup$!i $$|)
        endif
      enddo

      -- Execute the sorting command string:
      -- This is written to an external file to get around the 256 char
      -- limit of string variables
      var !pdmswkDir evar PDMSWK
      !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file1')
      !lineArr.append('')
      !lineArr.append('return')
      !tmpFile.writeFile('OVERWRITE',!lineArr)
      $m/$!pdmswkDir/mds-temp-report-file1

    else

      -- no sorting to be done but set up index anyway
      -- based on the index numbers of the first column
      var !!sortorder evaluate (vval(!selno)) indices !!col1 count !selno

    endif

    ------------------------------------------------------------------------------
    -- FORMAT REPORT
    ------------------------------------------------------------------------------

    do !colno indexes !cdcArepWID

      var !maxwid[$!colno] $!cdcArepWID[$!colno]

      -- any values required?
      if(|$!cdcArepDVAL[$!colno]| eq |On|) then
        var !unusedAnyValues 'True'
      endif

      -- do any subtotalling required
      if(|$!cdcArepDSUB[$!colno]| ne |Off|) then
        -- check if we need to use unformatted values for this COLUMN
        if (!convertCol[!colno]) then
          var !!subtotals$!colno subtotal !!ucol$!colno !!sortorder !!lastingroup$!cdcArepDSUB[$!colno]
          do !st index !!subtotals$!colno
            !val = !!subtotals$!colno$n[$!st]
            !!subtotals$!colno$n[!st] = dist($!val)
          enddo
        else
          var !!subtotals$!colno subtotal !!col$!colno !!sortorder !!lastingroup$!cdcArepDSUB[$!colno]
        endif
        var !maxwid[$!colno] (max($!maxwid[$!colno],(arraywidth(!!subtotals$!colno))))
      endif

      -- do any totalling required
      if(|$!cdcArepDTOT[$!colno]| eq |On|) then
        var !anytotals 'True'
        var !lastentry delete
        var !lastentry[$!selsize] '1'
        -- check if we need to use unformatted values for this COLUMN
        if (!convertCol[!colno]) then
          var !!totals$!colno subtotal !!ucol$!colno !!sortorder !lastentry
          do !st index !!totals$!colno
            !val = !!totals$!colno$n[$!st]
            !!totals$!colno$n[!st] = dist($!val)
          enddo
        else
          var !!totals$!colno subtotal !!col$!colno !!sortorder !lastentry
        endif
        var !maxwid[$!colno] (max($!maxwid[$!colno],(arraywidth(!!totals$!colno))))
      endif

    enddo

    -- set up the column headers
    -- now put the column headers into lines
    !lineArr = object ARRAY()
    do !colno indexes !headings
      !maxw  = !maxwid[$!colno]
      !headj = !headJust[$!colno]
      if (!isCSV) then
        if (!colno.eq(1)) then
          -- first column
          !lineArr.append(|var !!headArray compose ||$!!del$!headings[$!colno].title$n$!!del$n$!!sep|| $$|)
        elseif (!colno.eq(!headings.size())) then
          -- last column
          !lineArr.append(| ||$!!del$!headings[$!colno].title$n$!!del|| |)
        else
          -- all other columns
          !lineArr.append(| ||$!!del$!headings[$!colno].title$n$!!del$n$!!sep|| $$|)
        endif
      else
        if (!colno.eq(1)) then
          -- first column
          !lineArr.append(|var !!headArray compose spa $!spaceVal ||$!headings[$!colno].title|| wid $!maxw $!headj $$|)
        elseif (!colno.eq(!headings.size())) then
          -- last column
          !lineArr.append(| spa $!spaceVal ||$!headings[$!colno].title|| wid $!maxw $!headj|)
        else
          -- all other columns
          !lineArr.append(| spa $!spaceVal ||$!headings[$!colno].title|| wid $!maxw $!headj $$|)
        endif
      endif
    enddo

    -- compose the heading line
    -- This is written to an external file to get around the 256 char
    -- limit of string variables
    var !pdmswkDir evar PDMSWK
    !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file2')
    !lineArr.append('')
    !lineArr.append('return')
    !tmpFile.writeFile('OVERWRITE',!lineArr)
    $m/$!pdmswkDir/mds-temp-report-file2

    -- output heading underline records if not in csv mode
    if (!isCSV.not()) then

      -- compose the heading underline bar
      !lineArr = object ARRAY()
      !lineArr.append(|var !!lines compose $$|)
      do !colno indexes !headings
        !maxw  = !maxwid[$!colno]
        !headj = !headJust[$!colno]
        !uline = (substr('---------------------------------------------------------------------------------------------------',1,$!maxw))
        !lineArr.append(| spa $!spaceVal ||$!uline|| wid $!maxw $!headj $$|)
      enddo

      -- execute the compose command
      -- This is written to an external file to get around the 256 char
      -- limit of string variables
      var !pdmswkDir evar PDMSWK
      !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file3')
      !lineArr.append('')
      !lineArr.append('return')
      !tmpFile.writeFile('OVERWRITE',!lineArr)
      $m/$!pdmswkDir/mds-temp-report-file3

    endif

    ------------------------------------------------------------------------------
    -- GENERATE REPORT
    ------------------------------------------------------------------------------

    -- output the headings
    !output.append(!!headArray[1])

    if (!isCSV.not()) then
      -- append composed report underline bar to output array
      do !line values !!lines
        !output.append(!line)
      enddo
    endif

    -- put the report data into columns and output it
    !lineArr = object ARRAY()
    if (!isCSV) then
      !lineArr.append(|var !!lines compose sort !!sortorder quote (vtext(!!del)) nosuml $$|)
    else
      !lineArr.append(|var !!lines compose sort !!sortorder $$|)
    endif
    !firstline = true
    do !colno indexes !cdcArepDVAL

      if (!isCSV) then
        if(!firstline.not()) then
          !lineArr.append(|sep (vtext(!!sep)) $$|)
        else
          !firstline = false
        endif
      else
        !lineArr.append(| spa 2 $$|)
      endif

      !maxw  = !maxwid[$!colno]
      !headj = !headJust[$!colno]

      if (!isCSV) then
        if (!dataType[$!colno].eq('CIASCII')) then
          var !quote |q|
        else
          var !quote ||
        endif
      endif

      if(|$!cdcArepDSUB[$!colno]| eq |Off|) then
        if(|$!cdcArepDVAL[$!colno]| eq |1st|) then
          if (!isCSV) then
            !lineArr.append(| col val !!col$!colno first !!firstingroup$!colno $!quote $$|)
          else
            !lineArr.append(| col val !!col$!colno first !!firstingroup$!colno wid $!maxw $!headj $$|)
          endif
        elseif(|$!cdcArepDVAL[$!colno]| eq |On|) then
          if (!isCSV) then
            !lineArr.append(| col val !!col$!colno $!quote $$|)
          else
            !lineArr.append(| col val !!col$!colno wid $!maxw $!headj $$|)
          endif
        elseif(|$!cdcArepDVAL[$!colno]| eq |Sub|) then
          if (!isCSV) then
            !lineArr.append(| col val !!col$!colno atsub $!quote $$|)
          else
            !lineArr.append(| col val !!col$!colno atsub wid $!maxw $!headj $$|)
          endif
        elseif(|$!cdcArepDVAL[$!colno]| eq |Off|) then
          if (!isCSV) then
            -- do nothing
          else
            !lineArr.append(| spa $!maxw $$|)
          endif
        else
          if (!isCSV) then
            !lineArr.append(||)
          else
            !lineArr.append(||)
          endif
        endif
      else
        if(|$!cdcArepDVAL[$!colno]| eq |On|) then
          if (!isCSV) then
            !lineArr.append(| col val !!col$!colno sub !!subtotals$!colno $!quote $$|)
          else
            !lineArr.append(| col val !!col$!colno sub !!subtotals$!colno wid $!maxw $!headj $$|)
          endif
        else
          if (!isCSV) then
            !lineArr.append(| col sub !!subtotals$!colno $!quote $$|)
          else
            !lineArr.append(| col sub !!subtotals$!colno wid $!maxw $!headj $$|)
          endif
        endif
      endif
    enddo

    -- execute the compose command
    -- This is written to an external file to get around the 256 char
    -- limit of string variables
    var !pdmswkDir evar PDMSWK
    !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file4')
    !lineArr.append('')
    !lineArr.append('return')
    !tmpFile.writeFile('OVERWRITE',!lineArr)
    $m/$!pdmswkDir/mds-temp-report-file4

    -- append composed report lines to output array
    do !line values !!lines
      !output.append(!line)
    enddo

    ------------------------------------------------------------------------------
    -- GENERATE ANY TOTALS
    ------------------------------------------------------------------------------

    if(defined(!anytotals)) then

      -- output total underline records if not in csv mode
      if (!isCSV.not()) then

        -- compose the total value underline bar
        !lineArr = object ARRAY()
        !lineArr.append(|var !!lines compose $$|)
        do !colno indexes !cdcArepDTOT
          !maxw  = !maxwid[$!colno]
          !headj = !headJust[$!colno]
          if(|$!cdcArepDTOT[$!colno]| eq |Off|) then
            !lineArr.append(| spa $!spaceVal spa $!maxw $$|)
          else
            !uline = (substr('=====================',1,$!maxw))
            !lineArr.append(| spa $!spaceVal ||$!uline|| wid $!maxw $!headj $$|)
          endif
        enddo

        -- execute the compose command
        -- This is written to an external file to get around the 256 char
        -- limit of string variables
        var !pdmswkDir evar PDMSWK
        !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file5')
        !lineArr.append('')
        !lineArr.append('return')
        !tmpFile.writeFile('OVERWRITE',!lineArr)
        $m/$!pdmswkDir/mds-temp-report-file5

        -- append composed report total underline bar to output array
        do !line values !!lines
          !output.append(!line)
        enddo

      endif

      -- compose the total values
      !lineArr = object ARRAY()
      !lineArr.append(|var !!lines compose $$|)
      do !colno indexes !cdcArepDTOT
        !maxw  = !maxwid[$!colno]
        !headj = !headJust[$!colno]
        if (!isCSV) then
          if(|$!cdcArepDTOT[$!colno]| eq |Off|) then
            !lineArr.append(| ||$!!sep|| $$|)
          else
            !tots  = !!totals$!colno$n[$!selsize]
            if (!colno.eq(!colSize)) then
              -- last column
              !lineArr.append(| ||$!tots|| |)
            else
              -- all other columns
              !lineArr.append(| ||$!tots$n$!!sep|| $$|)
            endif
          endif
        else
          if(|$!cdcArepDTOT[$!colno]| eq |Off|) then
            !lineArr.append(| spa $!spaceVal spa $!maxw $$|)
          else
            !tots  = !!totals$!colno$n[$!selsize]
            !lineArr.append(| spa $!spaceVal ||$!tots|| wid $!maxw $!headj $$|)
          endif
        endif
      enddo

      -- execute the compose command
      -- This is written to an external file to get around the 256 char
      -- limit of string variables
      var !pdmswkDir evar PDMSWK
      !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file5')
      !lineArr.append('')
      !lineArr.append('return')
      !tmpFile.writeFile('OVERWRITE',!lineArr)
      $m/$!pdmswkDir/mds-temp-report-file5

      -- append composed report total values to output array
      do !line values !!lines
        !output.append(!line)
      enddo

    endif

    -- if we are in csv mode then process all
    -- lines to remove double space and trailing commas
    if (!isCSV) then
      !op = object ARRAY()
      do !opLine values !output
        !opLine = !opLine.trim()
        !opLine = !opLine.replace('  ',' ')
        !opLine = !opLine.replace('  ',' ')
        !opLine = !opLine.replace('  ',' ')
        !opLine = !opLine.replace('  ',' ')
        !op.append(!opLine)
      enddo
      !output = !op
    endif
    -- add a final space record at end of output array
    !output.append('')

    -- remove all temporary files
    do !i to 5
      !tmpFile = object FILE('$!pdmswkDir/mds-temp-report-file$!i')
      !tmpFile.deleteFile()
      handle any
      endhandle
    enddo

    -- be kind and delete all globals
    var !!sep delete
    handle any
    endhandle
    var !!del delete
    handle any
    endhandle
    var !!sortorder delete
    handle any
    endhandle
    var !!headArray delete
    handle any
    endhandle
    var !!lines delete
    handle any
    endhandle
    do !i to !colSize
      var !!col$n$!i delete
      handle any
      endhandle
      var !!lastingroup$n$!i delete
      handle any
      endhandle
      var !!firstingroup$n$!i delete
      handle any
      endhandle
      var !!subtotals$n$!i delete
      handle any
      endhandle
      var !!totals$n$!i delete
      handle any
      endhandle
    enddo

    -- return the results
    return(!output)

  endmethod


  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: startofrep
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]        [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --      ARRAY     Report Title Data
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .startofrep () is ARRAY

    -- Get Report Object data
    !report = !this.validreports.reports[!this.replist.val]

    -- Get the Date Time Stamp for the FILEname
    !date = !this.datereport

    -- Get Project Code and User Info
    !proj = current project
    !code = !proj.code()
    !ptxt = !code & ' ' & 'Project'
    !sess = current session
    !user = !sess.user().name
    --<wd>oct2002
    !mdbn = !sess.mdb().name
    !mdbd = '(' & !sess.mdb().description.trim() & ')'
    --<wd>oct2002

    -- Title of Report
    !repobj = !this.validreports.reports[!this.replist.val]
    !reptit = !repobj.title
    !titlen = !reptit.length()
    -- Assume Portrait Output and 100 characters available
    !linlen = 100
    !aspa   = ''
    !spaces = (!linlen / 2 ) - (!titlen / 2)
    do !x from 1 to !spaces
      !aspa = !aspa & ' '
    enddo
    -- Concatenate the Report title text
    !title = !aspa & !reptit

    -- Get the Correct Project Text
    !ptxlen = !ptxt.length()
    !aspa   = ''
    !spaces = (!linlen / 2 ) - (!ptxlen / 2)
    do !x from 1 to !spaces
      !aspa = !aspa & ' '
    enddo
    -- Concatenate the Report Project text
    !ptxt = !aspa & !ptxt

    -- Run Time Filter Text
    if (!this.rtfilter.val.trim().neq('')) then
      !rttext = !this.rtfilter.val.trim()
      !rtfilt = '(Extra Run Time Filter : ' & !rttext.replace('''','|') & ')'
      !rtflen = !rtfilt.length()
      !rpaces = (!linlen / 2 ) - (!rtflen / 2)
      !rspa   = ''
      do !x from 1 to !rpaces
        !rspa = !rspa & ' '
      enddo
      -- Concatenate the Report title text
      !rtfilt = !rspa & !rtfilt
    endif


    --<wd>oct2002
    -- Report Generated from the Database Hierarchy
    !rephier = '  REPORTING on: '
    !hiertxt = ARRAY()
    if (!this.hier.val.unset()) then
      -- Reporting on the Current contents of the entire MDB
      if (!mdbd.length().eq(2)) then
        !mdbd =''
      endif
      !hiertxt[1] = !rephier & 'Current MDB ' & !mdbn & ' ' & !mdbd
    else
      -- Reporting on the PDMS Element Name(s) in the gadget !this.hier
      !reptype = ARRAY()
      !hierarr = !this.hier.val.trim().split()
      do !indx indices !hierarr
        --!reptype = !this.hier.val.dbref().type
        --!hiertxt = !reptype & ' ' & !this.hier.val
        !reptype[!indx] = !hierarr[!indx].dbref().type
        -- Concatenate the Report title text array
        if (!indx.eq(1)) then
          !hiertxt[!indx] = !rephier & ' ' & !reptype[!indx] & ' ' & !hierarr[!indx]
        else
          !rephier = '                '
          !hiertxt[!indx] = !rephier & ' ' & !reptype[!indx] & ' ' & !hierarr[!indx]
        endif
      enddo
    endif
    -- Concatenate the Report title text
    --    !hiertxt = !rephier & !hiertxt.trim()
    --<wd>oct2002

    -- Set the Start of Report Data
    !startofrep = ARRAY()
    !startofrep.append('Date: $!date')
    !startofrep.append('User: $!user')
    !startofrep.append('')
    !startofrep.append('$!title')
    !startofrep.append('$!ptxt')
    if (defined(!rtfilt)) then
      !startofrep.append('$!rtfilt')
    endif
    --!startofrep.append('$!sortxt')
    --<wd>oct2002
    !startofrep.append('')
    if (defined(!hiertxt)) then
      do !cnt indices !hiertxt
        !startofrep.append(|$!hiertxt[$!cnt]|)
      enddo
    endif
    --<wd>oct2002

    !startofrep.append('')

    return !startofrep

  endmethod

  -- End of method definition
  ------------------------------------------------------------------------------------------------
  ------------------------------------------------------------------------------------------------
  -- Method: endofrep
  --
  -- Description:
  --
  -- Method Type: Function/Procedure
  -- Arguments:
  --   [#] [R/RW]   [Data Type]        [Description]
  --
  -- Return:
  --   [Data Type] [Description]
  --      ARRAY      Standard End of Report Lines
  --
  ------------------------------------------------------------------------------------------------
  -- Define method
  define method .endofrep() is ARRAY

    -- Set the End of Report Data
    !endofrep = ARRAY()
    !endofrep.append('  =============')
    !endofrep.append('  End of Report')
    !endofrep.append('  =============')

    return !endofrep

  endmethod
