--
-- File:		mdsreportsort.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--
-- Author:		Steve Robinson
-- Created:		06/12/2002 11:46
--
--
-- Description:
-- MDS report form to allow user to select sort/totalling/sub-totalling options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  reperr(STRING)                   -
--  sortascend(REAL)                 -
--  sortprec(REAL)                   -
--  subSortCol(REAL)                 -
--  subValues(REAL)                  -
--  total(REAL)                      -
--
------------------------------------------------------------------------------------------------
--
-- Define Form

Setup Form !!mdsreportsort

  !this.formtitle = ' MDS Report Sorting and Totalling '
  !this.icontitle = 'MDSREPSORT'
  !this.initcall  = '!this.init()'

  -- array of headings for this report
  member .head is ARRAY

  -- build the form based on the currently selected report columns

  para .col1a at x 0.5 y 0.5 text   |Column|            width 6  lines 1
  para .p1 at xmax ymin text        |                 | width 17 lines 1
  para .col2a at xmax ymin text     |Sort|              width 4  lines 1
  para .p2 at xmax ymin text        |       |           width 7  lines 1
  para .col3a at xmax ymin text     |Sort|              width 4  lines 1
  para .p3 at xmax ymin text        |     |             width 5  lines 1
  para .col4a at xmax ymin text     |Subtotal|          width 8  lines 1
  para .p4 at xmax ymin text        |    |              width 4  lines 1
  para .col5a at xmax ymin text     |Sort|              width 4  lines 1
  para .p5 at xmax ymin text        |     |             width 5  lines 1
  para .col6a at xmax ymin text     |Total|             width 5  lines 1

  para .col1b at x 0.5 y 1.5 text   |Header|            width 6  lines 1
  para .p6 at xmax ymin text        |              |    width 14 lines 1
  para .col2b at xmax ymin text     |Precedence|        width 10 lines 1
  para .p7 at xmax ymin text        |  |                width 2  lines 1
  para .col3b at xmax ymin text     |Ascending|         width 9  lines 1
  para .p8 at xmax ymin text        |  |                width 2  lines 1
  para .col4b at xmax ymin text     |On Column|         width 9  lines 1
  para .p9 at xmax ymin text        |  |                width 2  lines 1
  para .col5b at xmax ymin text     |Values|            width 6  lines 1
  para .p10 at xmax ymin text       |    |              width 4  lines 1
  para .col6b at xmax ymin text     |Column|            width 6  lines 1

  !paraXpos     = 0.5
  !paraYpos     = 2.5
  !sortPrecXpos = 23
  !sortAscXpos  = 36
  !subtotXpos   = 46
  !subtotVXpos  = 55
  !totalXpos    = 67

  do !column values !!mdsnewreports.hdglist.dtext

    !colNum = !column.part(1)

    -- build gadgets for this column
    path right
    hdist 0.5

    !title = !!mdsnewreports.validhdgs.headings[$!colNum].title.substring(1,16)
    !num = |$!colNum| + |               |
    !num = !num.substring(1,3)
    para   .para$!colNum at X $!paraXpos Y $!paraYpos text |$!num $!title| width 20 lines 1
    text   .sortprec$!colNum     || call |!this.sortprec($!colNum)| at X $!sortPrecXpos Y $!paraYpos width 3 string
    toggle .sortascend$!colNum   || call |!this.sortascend($!colNum)| at X $!sortAscXpos  Y $!paraYpos
    text   .subSortCol$!colNum   || call |!this.subSortCol($!colNum)| at X $!subtotXpos   Y $!paraYpos width 3 string
    option .subValues$!colNum    || call |!this.subValues($!colNum)| at X $!subtotVXpos  Y $!paraYpos width 5
    !this.subValues$!colNum$n.dtext = split('ON OFF SUB FIRST')
    toggle .total$!colNum        || call |!this.total($!colNum)| at X $!totalXpos    Y $!paraYpos

    !paraYpos = !paraYpos + 1

    !this.head[$!colNum] = !!mdsnewreports.validhdgs.headings[$!colNum]

  enddo

  button .ok | OK | at x0.5 ymax+1 call |!this.ok()|
  !this.ok.active = false

  button .cancel |Cancel| at xmax form-size ymin call |!this.cancel()|


exit

define method .mdsreportsort()

  !this.init()

endmethod

define method .init()

  -- populate the gadgets from the sorted column data

  do !head values !this.head

    !colNum = !head.number

    !this.sortprec$!colNum$n.val   = !head.sortprec.string()
    !this.sortascend$!colNum$n.val = !head.sortascend.boolean()
    !this.subSortCol$!colNum$n.val = !head.subSortCol.string()
    !this.subValues$!colNum$n.select('DTEXT',!head.subValues.string())
    !this.total$!colNum$n.val      = !head.total.boolean()

  enddo

endmethod

-------------------------------------------
-- Form OK button callback
-------------------------------------------
define method .ok()
  -- check that form values are valid
  if (!this.checkValues(TRUE)) then
    -- save the modified values in the report form members
    !this.saveValues()
    !this.hide()
  else
    -- do nothing
  endif
endmethod

-------------------------------------------
-- Save values in main report form members
-------------------------------------------
define method .saveValues()

  do !head values !this.head

    !colNum = !head.number

    !!mdsnewreports.validhdgs.headings[$!colNum].sortprec   = !head.sortprec
    !!mdsnewreports.validhdgs.headings[$!colNum].sortascend = !head.sortascend
    !!mdsnewreports.validhdgs.headings[$!colNum].subSortCol = !head.subSortCol
    !!mdsnewreports.validhdgs.headings[$!colNum].subValues  = !head.subValues
    !!mdsnewreports.validhdgs.headings[$!colNum].total      = !head.total

  enddo

endmethod

-------------------------------------------
-- Form CANCEL button callback
-------------------------------------------
define method .cancel()
  !this.hide()
  !!mdsreperr.hide()
  handle any
  endhandle
endmethod

-------------------------------------------
-- Check values in all fields are valid
-------------------------------------------
define method .checkValues(!display is BOOLEAN) is BOOLEAN

  -- check report message array
  !report = object ARRAY()
  !refNos = object ARRAY()
  !eCnt = 0

  -------------
  -- Check 1 --
  -------------
  -- Column sort precedence values must be unique
  -----------------------------------------------
  !precVals = object ARRAY()
  !foundDuplicate = false
  !dupVals = ''
  do !head values !this.head
    if (!head.sortprec.eq(0)) then
      skip
    endif
    if (!precVals.findfirst(!head.sortprec).unset().not()) then
      -- found a duplicate precedence order value
      !foundDuplicate = true
      if (!dupVals.length().eq(0)) then
       !dupVals = !head.sortprec.string()
     else
      !dupVals = !dupVals + ',' + !head.sortprec.string()
      endif
    else
      !precVals.append(!head.sortprec)
    endif
  enddo
  if (!foundDuplicate) then
    !eCnt = !eCnt + 1
    if (!eCnt.leq(9)) then
      !pad = ' '
    else
      !pad = ''
    endif
    !report.append('[$!eCnt$!pad] Error: Duplicate values are not allowed "$!dupVals"')
    !refNos.append('2\0')
  endif

  -------------
  -- Check 2 --
  -------------
  -- Column subtotals must reference a header number in this report
  -----------------------------------------------------------------
  !headNums = object ARRAY()
  do !head values !this.head
    !headNums.append(!head.number)
  enddo
  do !head values !this.head
    if (!head.subsortcol.eq(0)) then
      skip
    endif
    if (!headNums.findfirst(!head.subsortcol).unset()) then
      !eCnt = !eCnt + 1
      if (!eCnt.leq(9)) then
        !pad = ' '
      else
        !pad = ''
      endif
      !scol = !head.subsortcol
      !num = !head.number
      !report.append('[$!eCnt$!pad] Error: Reference to column header $!scol which is not in this report')
      !refNos.append('4\$!num')
    endif
  enddo


  -------------
  -- Check 3 --
  -------------
  -- Column subtotals can only refer to a header number that is sorted
  --------------------------------------------------------------------
  do !head values !this.head
    if (!head.subsortcol.eq(0)) then
      skip
    endif
    !headsortprec = !this.head[!head.subsortcol].sortprec
    handle any
      skip
    endhandle
    if (!headsortprec.eq(0)) then
      !eCnt = !eCnt + 1
      if (!eCnt.leq(9)) then
        !pad = ' '
      else
        !pad = ''
      endif
      !num = !head.number
      !scol = !head.subsortcol
      !report.append('[$!eCnt$!pad] Error: Cannot subtotal on unsorted column header "$!scol"')
      !refNos.append('4\$!num')
    endif
  enddo

  -------------
  -- Check 4 --
  -------------
  -- Column can only be subtotaled if header is numeric
  -----------------------------------------------------
  do !head values !this.head
    if (!head.subsortcol.eq(0)) then
      skip
    endif
    if (!head.data.trim().upcase().substring(1,1).neq('N')) then
      !eCnt = !eCnt + 1
      if (!eCnt.leq(9)) then
        !pad = ' '
      else
        !pad = ''
      endif
      !num = !head.number
      !scol = !head.subsortcol
      !report.append('[$!eCnt$!pad] Error: Sub-totalling is not valid for ASCII column headers, set "$!scol" to "0"')
      !refNos.append('4\$!num')
    endif
  enddo

  -------------
  -- Check 5 --
  -------------
  -- Column sortvalues can only be set to SUB/FIRST if this header is sorted
  ---------------------------------------------------------------------------
  do !head values !this.head
    if (!head.subvalues.trim().upcase().eq('ON') or !head.subvalues.trim().upcase().eq('OFF')) then
      skip
    endif
    if (!head.sortprec.eq(0)) then
      !eCnt = !eCnt + 1
      if (!eCnt.leq(9)) then
        !pad = ' '
      else
        !pad = ''
      endif
      !num = !head.number
      !scol = !head.subsortcol
      !report.append('[$!eCnt$!pad] Error: Sort values cannot be SUB/FIRST for this column, set to "ON or "OFF"')
      !refNos.append('5\$!num')
    endif
  enddo

  -------------
  -- Check 6 --
  -------------
  -- Column can only be totaled if header is numeric
  --------------------------------------------------
  do !head values !this.head
    if (!head.total.not()) then
      skip
    endif
    if (!head.data.trim().upcase().substring(1,1).neq('N')) then
      !eCnt = !eCnt + 1
      if (!eCnt.leq(9)) then
        !pad = ' '
      else
        !pad = ''
      endif
      !num = !head.number
      !report.append('[$!eCnt$!pad] Error: Totaling is not valid for ASCII column headers')
      !refNos.append('6\$!num')
    endif
  enddo


  if (!report.size().neq(0)) then
    kill !!mdsreperr
    setup form !!mdsreperr
      title |MDS Report Sorting and Totaling|
      !!mdsreperr.cancelcall = |!!mdsreportsort.reperr('0')|
      list .errors |Please Resolve These Errors:| call |!!mdsreportsort.reperr(!!mdsreperr.errors.rtext[!!mdsreperr.errors.val])| width 80 length 10
      button .cancel |Dismiss| at xmax form-size ymax call |!!mdsreportsort.reperr('0')| cancel
    exit
    !!mdsreperr.errors.dtext = !report
    !!mdsreperr.errors.rtext = !refNos
    if (!display) then
      show !!mdsreperr at xr 1 yr 0.25
      !!mdsreportsort.reperr(!!mdsreperr.errors.rtext[!!mdsreperr.errors.val])
    endif
    return (false)
  else
    return (true)
  endif


endmethod

-- method to handle highlighting for report sort errors
define method .reperr(!colrow is STRING)

  -- reset all colours
  !this.col1a.background = 205
  !this.col2a.background = 205
  !this.col3a.background = 205
  !this.col4a.background = 205
  !this.col5a.background = 205
  !this.col6a.background = 205
  !this.col1b.background = 205
  !this.col2b.background = 205
  !this.col3b.background = 205
  !this.col4b.background = 205
  !this.col5b.background = 205
  !this.col6b.background = 205

  do !head values !this.head
    !num = !head.number
    !this.para$!num$n.background = 205
  enddo

  !col = !colrow.part(1,'\')
  !row = !colrow.part(2,'\')
  if (!col.eq('0')) then
    return
  else
    !!mdsreportsort.col$!col$na.background = 2
    !!mdsreportsort.col$!col$nb.background = 2
    if (!row.neq('0')) then
      !this.para$!row$n.background = 2
    endif
  endif

endmethod

-- methods to handle user action with individual gadgets:

-------------------------------------------
-- Form colNum button callback
-------------------------------------------
define method .sortprec(!colNum is REAL)
  !this.ok.active = true
  -- update the heading in the form member array
  !this.head[$!colnum].sortprec = !this.sortprec$!colNum$n.val.real()
endmethod

-------------------------------------------
-- Form sortascend button callback
-------------------------------------------
define method .sortascend(!colNum is REAL)
  !this.ok.active = true
  -- update the heading in the form member array
  !this.head[$!colnum].sortascend = !this.sortascend$!colNum$n.val
endmethod

-------------------------------------------
-- Form subSortCol button callback
-------------------------------------------
define method .subSortCol(!colNum is REAL)
  !this.ok.active = true
  -- update the heading in the form member array
  !this.head[$!colnum].subSortCol = !this.subSortCol$!colNum$n.val.real()
endmethod

-------------------------------------------
-- Form subValues button callback
-------------------------------------------
define method .subValues(!colNum is REAL)
  !this.ok.active = true
  -- update the heading in the form member array
  !this.head[$!colnum].subValues = !this.subValues$!colNum$n.selection('DTEXT')
endmethod

-------------------------------------------
-- Form total button callback
-------------------------------------------
define method .total(!colNum is REAL)
  !this.ok.active = true
  -- update the heading in the form member array
  !this.head[$!colnum].total = !this.total$!colNum$n.val
endmethod
