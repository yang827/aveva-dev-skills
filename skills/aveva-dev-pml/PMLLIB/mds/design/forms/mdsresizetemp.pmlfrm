--
-- File:		MdsResizeTemp.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Thursday 18th December 2003
--
--
-- Description:
-- Form Definition to set a framework templates steelwork size to another size
-- or even standard
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  selstdtype()                     -
--  selstru()                        -
--  setcurrentsize()                 -
--  setgtyp()                        -
--  setintstd()                      -
--  setsize()                        -
--

-- Kill existing form definition
Kill !!MdsResizeTemp

-- Define Form
setup form  !!MdsResizeTemp

  !this.initcall = '!this.init()'

  option .StandardType 'Standard Type               ' at x0 y.5  call |!this.selstdtype()|     width 11

  option .ZoneName     'Standard Name               ' at x0 y2   call |!this.selstru()|        width 11

  option .StruName     'Selection                   ' at x0 Y3.5 call |!this.setcurrentsize()| width 11

  option .SPEC         'International Std. '          at x0 Y5   call |!this.setgtyp()|  width 20

  option .GTYP         'Generic Type       '          at x0 Y6.5 call |!this.setsize()|  width 20

  list   .SPRE         'Size'                         at X0 Y8   call |CALLSTL ISTLSPEC SPCO|  width 39 length 10

  -- Para   .CurrentSize                               at x0 y4.5 width 20 lines 1

-- End form definition
exit

define method .init()

-- Can we find a template set to modify

  !!ce = /MDS/TEMPLATES
    handle ANY
      !!Alert.Error('Cannot find /MDS/TEMPLATES to modify')
      return
    endhandle

-- Can I modify it

  if !!ce.dbwrite.not() then
    !!Alert.Error('Cannot write to /MDS/TEMPLATES to modify')
    return
  endif

-- Complete the standard type option gadget

  !Dtext = ARRAY()
  !Dtext.append('Cable Tray')
  !Dtext.append('HVAC')
  !Dtext.append('Piping')
  !Dtext.append('Vessels')
  !Rtext = ARRAY()
  !Rtext.append('CT')
  !Rtext.append('DT')
  !Rtext.append('FT')
  !Rtext.append('VT')

  !this.StandardType.Dtext = !Dtext
  !this.StandardType.Rtext = !Rtext

  !this.SelStdType()

  !this.SelStru()

-- Initilise the steelwork gadgets

  !this.setintstd()

  !this.setgtyp()

  !this.setsize()

  !this.setcurrentsize()

  /MDS/TEMPLATES

endmethod

define method .selstdtype()

-- Fill in standards from those available

  !!ce = /MDS/TEMPLATES

  !ZoneMembers = members
  !Type = !this.StandardType.val
  !TypeVal = !this.StandardType.Rtext[$!Type]

  !Dtext = ARRAY()
  !Rtext = ARRAY()

  do !SetList values !ZoneMembers
    if !SetList.name.match('/$!TypeVal').gt(0) then
      !Dtext.append(!SetList.name.after('/MDS/FRAMES/'))
      !Rtext.append(!SetList.string())
    endif
  enddo

  !this.ZoneName.dtext = !Dtext
  !this.ZoneName.rtext = !Rtext

endmethod

define method .selstru()

-- Fill in structures from those available

  !!ce = !this.Zonename.rtext[!this.Zonename.val].dbref()

  !Strus = members

  !Dtext = ARRAY()
  !Rtext = ARRAY()

  do !SetStru values !Strus
    !!ce = !SetStru
    !Dtext.Append(!!ce.order.string())
    !Rtext.Append(!!ce.string())
  enddo

  !this.StruName.Dtext = !Dtext
  !this.StruName.Rtext = !Rtext

endmethod

define method .setintstd()

-- Get STEEL Spec Worlds

   $m/%PDMSUI%/CLIB/FILES/RSPECS STL STL

-- !!CDPARTN - Names
-- !!CDCARTN - Descriptions
-- !!CDWARTN - Types

   !this.spec.dtext = !!CDCARTN
   !this.spec.rtext = !!CDPARTN

endmethod

define method .setgtyp()

-- Get gtypes


   !Spec = !this.Spec.rtext[!this.spec.val]
   $m/%PDMSUI%/CLIB/FILES/RSELE $<$!SPEC$> REFE DESC

-- !!CDPARTN - Names
-- !!CDCARTN - Results

   !this.gtyp.dtext = !!CDCARTN
   !this.gtyp.rtext = !!CDPARTN

endmethod

define method .setsize()

  !gtyp = !this.gtyp.rtext[!this.gtyp.val]

  $m/%PDMSUI%/CLIB/FILES/RSELE $<$!GTYP$> REFE CATR

-- !!CDPARTN - Names
-- !!CDCARTN - Answers

   !this.spre.dtext = !!CDCARTN
   !this.spre.rtext = !!CDPARTN

endmethod

define method .setcurrentsize()

  !!ce = !this.struname.rtext[!this.struname.val].dbref()
  frmw 1
  sctn 1

  !spref = !!ce.spref
  !gtyp  = !!ce.spref.owner.name
  !spec  = !!ce.spref.owner.owner.name

  !this.spec.select('RTEXT',!Spec)

  --q var !this.gtyp.rtext
  --q var !gtyp
  !this.gtyp.select('RTEXT',!Gtyp)
  !this.spre.select('RTEXT',!Spref)


endmethod

return
















  -- initialise Variables

  var !OPT  |$1|
  var !NAME |$2|
  var !REFE REFE
  var !OREF REFE
  var !FLAG false
  !defaultsForm = !!CDSTLSPECD
  !specForm = !this

  !specForm.currentPropUpdate = true


$* -------------------- Check Options --------------------

 if (!opt eq 'SPCO') then
   golabel /SPCO
 endif

$* -------------------- Current Form Settings --------------------
$* Specification
 var !SPEC  |$_CDSTLSPEC_SPEC|     $* New Spec
 var !CSPEC |$_CDSTLSPECD_SPEC|    $* (Form spec)

$* Generic Type
 var !GTYP  |$_CDSTLSPEC_GTYP|     $* New Gtype
 var !CGTYP |$_CDSTLSPECD_GTYP|    $* (Form Gtype)

$* Justification
 var !JUST  |$_CDSTLSPEC_JUST|     $* Justification
 var !CJUST |$_CDSTLSPECD_JUSTI|   $* (Form Just)

$* Member Line
 var !MEML  |$_CDSTLSPEC_MEML|     $* Member Line
 var !CMEML |$_CDSTLSPECD_MEMLI|   $* (Form Member Line)

$* Joint Line
 var !JLIN  |$_CDSTLSPEC_JLIN|     $* Joint Line
 var !CJLIN |$_CDSTLSPECD_JLINE|   $* (Form Joint Line)

$* SpecRef
 var !SPRE  |$_CDSTLSPEC_SPRE|     $* Spec ref
 var !CSPRE |$_CDSTLSPECD_SPREF|   $* (Form Spec Ref)

$* -------------------- Initialise Current Element --------------------

 if(|$!OPT| eq |CE|) then

  -- By default unset the 'Use as default profile' toggle
   var  _CDSTLSPEC_DFLG |false|

   edit _CDSTLSPEC_DFLG status active
   edit _CDSTLSPEC_CE   status active
   var !SCTN (REFE of SCTN )
   handle ANY
     var !SCTN (REFE of GENSEC )
     handle ANY
       CALLIBD RVECDATP ID $<Identify Section$> $<SCTN GENSEC $>
       if($!!CDRTNSTATUS neq 0) then
         return error 1 noalert
       endif
       var !SCTN |$!!CDPNRTN|
     endhandle
   endhandle
   var !OREF |$!SCTN|
   var !JUST (JUSL of $!SCTN )
   var !MEML (MEML of $!SCTN )
   handle ANY
   endhandle

   -- Attribute variations for SCTN and GENSEC
   if(!sctn.dbref().hardType eq 'SCTN') then
     var !JLIN (JLIN of $!SCTN )
   else
     var !JLIN (JLNS of $!SCTN )
   endif

   var !SPRE (NAME of SPRE of $!SCTN )
   handle ANY
     golabel /SPECSKIP
   endhandle
   golabel /SPECSKIP if(|$!SPRE| eq |unset|)

  $* If type is SPCO, then were can determine the SPEC, GTYP and LIST
   var !TYPE (TYPE of $!SPRE )
   handle ANY
   elsehandle NONE
     if(|$!TYPE| eq |SPCO|) then
       var !NLIST (CATR of $!SPRE )
       var !NLIST (substr(|$!NLIST|,2))
       var !GTYP  (REFE of OWNER of $!SPRE )
       var !NGTYP (TANS of $!GTYP )
       var !SPEC  (NAME of SPEC of $!SPRE )
       var !FLAG  |true|
    $* SPRE doesn't point to a SPCO
     else
       var !RREF (SPRE of $!SCTN eq Nulref)
       if(not $!RREF) then
         var !RNAM (FLNN of SPRE of $!SCTN )
         error |Spec Reference points directly to the "Catalogue Profile $!RNAM". Unable to determine a specification entry.|
       endif
     endif
   endhandle

  label /SPECSKIP
   $!REFE
   var _CDSTLSPEC_CENAME (FULLNAME of $!SCTN )

$* ----------- Load Specs if No Current Spec has been loaded before ------------

label /SPECBUILD


 endif

$* Set Name of Spec

 var list _CDSTLSPEC_SPEC sel repl |$!SPEC| exit
 handle ANY
   var list _CDSTLSPEC_SPEC sel 1 exit
   handle ANY
     return error 1 |No Structural Profile Specifications have been found.|
   endhandle
 endhandle
 var _CDSTLSPECD_SPEC |$_CDSTLSPEC_SPEC|
 var !SPEC |$_CDSTLSPEC_SPEC|

$* -------------------- Check if Gtypes need loading -------------------------
label /GTYPBUILD
 if(|$!CSPEC| neq |$!SPEC| or |$!CSPEC| eq ||) then

   CALLIB RSELE $<$!SPEC$> REFE DESC
  $* CDPARTN - Names
  $* CDCARTN - Results
   var !SORT sort !!CDCARTN

   var list _CDSTLSPEC_GTYP clear
   exit

   do !INDX values !SORT
     var list _CDSTLSPEC_GTYP pairs |$!!CDCARTN[$!INDX]| |$!!CDPARTN[$!INDX]| exit
   enddo

 endif

$* Set Generic Type
 var list _CDSTLSPEC_GTYP sel repl |$!GTYP| exit
 handle ANY
   var list _CDSTLSPEC_GTYP sel 1 exit
   handle ANY
   endhandle
 endhandle
 var _CDSTLSPECD_GTYP |$_CDSTLSPEC_GTYP|
 var !GTYP |$_CDSTLSPEC_GTYP|

$* --------------------- Check if List need loading -------------------------
label /LISTBUILD

 if(|$!CGTYP| neq |$!GTYP| or |$!CGTYP| eq ||) then

   CALLIB RSELE $<$!GTYP$> REFE CATR
   $* CDPARTN - Names
   $* CDCARTN - Answers

  $* Sort returns into order (use parameter of CATR)
   var !PAR1 eval (PARA[1] of CATR ) for all from !!CDPARTN ignore ANY |0|
   var !PAR2 eval (PARA[2] of CATR ) for all from !!CDPARTN ignore ANY |0|
   var !PAR3 eval (PARA[5] of CATR ) for all from !!CDPARTN ignore ANY |0|
   var !SORT sort !PAR1 numeric !PAR2 numeric !PAR3 numeric

   var list _CDSTLSPEC_SPRE clear
   exit

   do !INDX values !SORT
     var !DETAIL (substr(|$!!CDCARTN[$!INDX]|,2))
     var list _CDSTLSPEC_SPRE pairs |$!DETAIL| (NAME of $!!CDPARTN[$!INDX] ) exit
   enddo

  $* Build Justification

  $(
   CALLSTL DSETPLINE _CDSTLSPEC_JUST $<$_CDSTLSPEC_SPRE$> NULL
   CALLSTL DSETPLINE _CDSTLSPEC_MEML $<$_CDSTLSPEC_SPRE$> NULL
   CALLSTL DSETPLINE _CDSTLSPEC_JLIN $<$_CDSTLSPEC_SPRE$> NULL
  $)
   $* Get Plines
   CALLIB RPLINES $<$_CDSTLSPEC_SPRE$> NULL
   if($!!CDRTNSTATUS ne 0) then
     var !!CDWAPLIN[1] |NA|
     var !!CDCAPLIN[1] |NA|
   endif
   !!cdSTLSPEC.JUST.dtext = !!CDCAPLIN
   !!cdSTLSPEC.JUST.rtext = !!CDWAPLIN
   !!cdSTLSPEC.MEML.dtext = !!CDCAPLIN
   !!cdSTLSPEC.MEML.rtext = !!CDWAPLIN
   !!cdSTLSPEC.JLIN.dtext = !!CDCAPLIN
   !!cdSTLSPEC.JLIN.rtext = !!CDWAPLIN

 endif

$* Set List
 var list _CDSTLSPEC_SPRE sel repl |$!SPRE| exit
 handle ANY
   var list _CDSTLSPEC_SPRE sel 1 exit
   var !SPRE |$_CDSTLSPEC_SPRE|
 endhandle
 var _CDSTLSPECD_SPREF |$!SPRE|

$* -------------------- Set User Data --------------------
label /END
 $!REFE

   var _CDSTLSPECD_CE |$_CDSTLSPEC_CE|
   var USER _CDSTLSPEC |$!OREF| 1

$* ---------- Set Justification
 var list _CDSTLSPEC_JUST sel repl |$!JUST| exit
 handle ANY
   var list _CDSTLSPEC_JUST sel repl |NA| exit
   handle ANY
   endhandle
 endhandle
 var _CDSTLSPECD_JUSTI |$_CDSTLSPEC_JUST|

$* ---------- Set Member Line
 var list _CDSTLSPEC_MEML sel repl |$!MEML| exit
 handle ANY
   var list _CDSTLSPEC_MEML sel repl |NA| exit
   handle ANY
   endhandle
 endhandle
 var _CDSTLSPECD_MEMLI |$_CDSTLSPEC_MEML|

$* ---------- Set Joint Line
 var list _CDSTLSPEC_JLIN sel repl |$!JLIN| exit
 handle ANY
   var list _CDSTLSPEC_JLIN sel repl |NA| exit
   handle ANY
   endhandle
 endhandle
 var _CDSTLSPECD_JLINE |$_CDSTLSPEC_JLIN|

$* -------------------- End --------------------


label /SPCO

CALLSTL XSTLPLOT $<$_CDSTLSPEC_SPRE$> false false

$(
!desiElement = !specForm.cename.val.dbref()
handle ANY
  !desiElement = object DBREF()
endhandle

if (!desiElement.set()) then
  if (!desiElement.spref eq !specForm.SPRE.selection().dbref()) then
    !specForm.currentProp.initialise(!desiElement)
    !specForm.currentProp.unsetDesiElement()
  else
    !specForm.currentProp.initialise(!specForm.SPRE.selection().dbref())
    -- if the properties are edited cache them
    !specForm.currentProp.autoCacheValues(true)
  endif
else
  !specForm.currentProp.initialise(!specForm.SPRE.selection().dbref())
    -- if the properties are edited cache them
    !specForm.currentProp.autoCacheValues(true)
endif
!specForm.prop.active = !specForm.currentProp.editable()

$)

$* -------------------- Abort End --------------------
label /ABORT

$* End of Code
$.

endmethod

----------------------------------------------------------------------------------------
