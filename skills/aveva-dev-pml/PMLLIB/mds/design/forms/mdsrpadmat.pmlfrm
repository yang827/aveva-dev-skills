--
-- File: mdsrpadmat.pmlfrm
--   Type:    Form Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created: Wednesday - 29th October 2003
--
--
-- Description:
-- Form Definition for Selecting the MATERIAL of a Reinforcing Pad ATTA
-- from a PDMS Piping Specification with a PURPOSE of PIPE or PLAT
--
------------------------------------------------------------------------
--
--  init(FORM)                       -
--  set(FORM)                        -

-- Kill existing form definition
  kill !!mdsrpadmat

-- Define Form
  setup form  !!mdsrpadmat
    !!mdsrpadmat.formtitle    = |Select Pad Material|
    !!mdsrpadmat.icontitle    = |RPADMAT|
    !!mdsrpadmat.callback     = ||
    !!mdsrpadmat.formrevision = | $Revision: $ |

  -- Body of Form
    list .specs |Select Pad Material:| at x1 y0.5 width 60 length 10
    path down
    vdist 1
-- Bottom Line
    button .ok     |   OK   | at x0 ymax call || ok
    path right
  button .cancel | Cancel | at xmax form-8 cancel

  exit

-- End form definition

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  define method .init(!form is FORM)
--------------------------------------------------------------------------------

  !currentUnits = !!kgetsetunits()

  -- Set the Form Title Back to Default
    !this.formtitle = |Select Pad Material|

-- Set the callback for the OK Button
    !!mdsrpadmat.ok.callback = '!!mdsrpadmat.set(!!$!form)'

-- Save db position
    !origin = !!ce

-- When Piping Specifications exist with a purp of PLAT - Add these to the list of Piping Specs with a PURPOSE of PIPE
    !worl  = object DBREF()
    !pltspc = !!kcollectallfor('SPEC','purp eq |PLAT|',!worl)
    !pipspc = !!kcollectallfor('SPEC','purp eq |PIPE|',!worl)
-- Combine List of Pipe and RPAD Plate - Piping Specifications
    !specs  = !pltspc
--q var !specs
    !specs.appendarray(!pipspc)
--q var !specs

-- Initialise Variables
    !dtext = ARRAY()
    !rtext = ARRAY()

-- Go to each spec and find the tube component

--<wd>oct2007    !ce    = !!ce

    !atta  = !form.support.datum

  --<RM 10/09/08> included this to fix defect in which an error occurs if the datum atta is unset
  if !atta.unset() then
    !!alert.message('datum support atta has not been created')
    return
  endif
  --<RM 10/09/08> end of fix

    !brspc = !form.support.datum.owner.owner.pspe
    handle ANY
      !brspc = !form.support.datum.owner.pspe
    endhandle

-- Find out what the shop flag of the standard is and only load that type
   !bore     = pl bore of $!atta

--<wd>oct2007 !standard = !form.support.type

---------------------------------------------------------------------------------------------------------------
-- mjb >>> 09.03.06 <mds12> variable !shopflag not used, so commented out (!!mdspar no longer
-- mjb >>> exists at 12 so was causing error)
    --!shopflag = !!mdspar$!standard[$!bore].shop
-- mjb >>> end of mod
---------------------------------------------------------------------------------------------------------------

-- Compile a list of Valid Specifications from which, the RPAD material may selected
    do !foundspecs values !specs
      !!ce = !foundspecs
--       q name
      !mem = mcount
      do !count from 1 to !mem
        $!count
        if !!ce.type.eq('SELE') then
          if !!ce.tans.eq('TUBE') then
-- Find all spcoms for the tube selector
            var !spcoms coll all spcom for ce
-- Loop through spcoms and get the correct bore
            do !getbore values !spcoms
              !!ce = !getbore.dbref()
              !params = para of catref
--<wd>oct2007
              handle ANY
              -- HPD0036409 -- HANDLE and SKIP any SPCOM from a PIPING SPECIFICATION where the CATREF of the TUBI element is INVALID/UNSET etc...
                skip
              endhandle
--<wd>oct2007

-- Convert param 1 to nearest bore to take account of bores being
-- set to actual bores and not nominal bores
              !nearestbore = !params[1].nearestbore()
              if !nearestbore.string().before('mm').eq(!bore.string().before('mm')) then
                !desc = rtext of detref
                handle (2,102)
-- handle (2,102) for SPCO for TUBE which has NO DETAIL REFERENCE SET in the PIPING SPEC
                  skip
                endhandle
                !matl = xtex of matxt
                handle any
                  !matl = ' '
                endhandle
                if !foundspecs.eq(!brspc) then
                  !dtext.append('(Parent Pipe)' + !foundspecs.name & ' ' & !desc & ' ' & !matl)
                  !rtext.append(!foundspecs.name)
                else
                  !dtext.append('             ' + !foundspecs.name & ' ' & !desc & ' ' & !matl)
                  !rtext.append(!foundspecs.name)
                endif
              endif
            enddo
          endif
        endif
        spec
      enddo
    enddo

-- Clear The Specs List Gadget
    !!mdsrpadmat.specs.clear()

  -- Save the !dtext and !rtext arrays for the Check shown immediately below
    !dtextsave = !dtext
    !rtextsave = !rtext
    !dtext.unique()
    !rtext.unique()

-- Check if the dtext and rtext sizes are the same, if not then there are duplicate spec name in the
-- current mdb, therefore reset back before they were made unique
    if !dtext.size().neq(!rtext.size()) then
      !dtext = !dtextsave
      !rtext = !rtextsave
    endif

  -- Load the Piping Specs into the form
    !!mdsrpadmat.specs.dtext = !dtext
    !!mdsrpadmat.specs.rtext = !rtext

  -- Set action for form
    !!kshowform(!!mdsrpadmat)

-- Select the Spec currently stored at the ATTA MTOREF attribute
    if (!form inset (!!mdsat23)) then
-- Get the Specification NAME of the RPAD Material from the MTOREF and Select it if Possible
      !mtoref = !form.support.datum.mtoref[1].name
      !mtospc = name of spec of $!mtoref
      !this.specs.select('rtext','$!mtospc')
      handle any
      endhandle
    endif

-- Navigate to Original Component
    !!ce = !origin

-- Reset Units
  !!kRestoreUnits(!currentunits)

  endmethod

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  define method .set(!form is FORM)
--------------------------------------------------------------------------------

  -- The RPAD Atta MTOREF Material - is  SELECTED by the USER from the !!MDSRPADMAT form
-- Navigate to the DATUM Atta and set all of this MDS support components MTOREF
    !!ce = !form.support.datum
    branch
    !brspc = !!ce.pspe
-- Get the RTEXT value of the Selected Spec for the selected Pipe LSTU or PLATE Material
    !selectedspec = !!mdsrpadmat.specs.selection()

    !!mdsdaccontrol(true)

-- Set the MTOREF of each RPAD ATTA in the MDS Support
    do !suppmem values !form.support.atta
      !!ce    = !suppmem
      !mtoref = select spec $!selectedspec lstu
-- Navigate back to the Atta - This command leaves you at the Selected Spec

      !!ce    = !suppmem
      !!ce.mtoref = !mtoref

--<wd>18jun2004
-- Get the purpose of the Selected Spec
      var !mattyp  purpose of spec of $!mtoref[1]
    -- For MDS Standard 'AT65' - Set the DESPAR Num 8 i.e. Property 'ASSY' :-
-- to either: 'A' for Pipe where DESPAR NUM 9 is ALWAYS set to ZERO '0'
--        or: 'Bx' for Plate where 'x' is the Plate thickness, the same value as DESPAR NUM 1
      if (!!ce.prop.desc inset ('AT65')) then
        if (!mattyp.eq('PIPE')) then
          desp num 8 A
          !!ce.desp[9] = 0
        elseif (!mattyp.eq('PLAT')) then
          desp num 8 B
          !!ce.desp[9] = !!ce.desp[1]
        endif
      endif
--<wd>18jun2004

    enddo

-- Navigate to the DATUM atta
    !!ce = !form.support.datum

    !!mdsdaccontrol(false)

  endmethod
