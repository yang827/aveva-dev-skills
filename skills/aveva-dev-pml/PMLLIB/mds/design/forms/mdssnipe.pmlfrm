--
-- Description:
-- Form Definition for Snipe creation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidlines()                       -
--  allfoursnipes(STRING)            -
--  auto()                           -
--  create()                         -
--  deletefitt()                     -
--  dismiss()                        -
--  edgentry()                       -
--  foursnipes()                     -
--  init()                           -
--  mdssnipe()                       -
--  modify()                         -
--  pick(EDGPICKDATA)                -
--  setbuttons()                     -
--  setsize(GADGET)                  -
--  storesnipe()                     -
--  update(BOOLEAN)                  -
--

-- Define Form
setup form !!mdssnipe

  text .currmember 'Modifying Section:' at x1 tagwid 13 wid 26 is STRING
  button .ce 'CE' callback |!this.init()| at xmax+1.7

  frame .endframe 'Select Sniped End' at x1 ymax.ce
    rtoggle .start 'Start'
    rtoggle .end 'End'
  exit

  frame .legframe 'Select Angle Leg'
    rtoggle .top 'Top'
    rtoggle .left 'Left'
  exit

  button .pick toggle pixmap width 16 height 16 at xmax+0.7 ymin+0.25 callback '!this.edgentry()' tooltip 'Pick section end'
  button .auto 'Auto' toggle width 3 height 0.8 at xmax+0.5 ymin callback '!this.auto()' tooltip 'Enable/Disable automatic creation of snipes'
  button .create 'Create' width 6.2 at xmin.pick ymax.auto+0.1 callback |!this.create()|

  button .modify 'Modify' width 6.2 at xmin ymax+0.1 callback |!this.modify()|
  button .deletefitt 'Delete' width 6.2 at xmin ymax+0.1 callback |!this.deletefitt()|

  text .len 'Snipe Length' callback |!this.setsize(!this.len)| at x1 ymax.legframe+0.2 tagwid 10 wid 7 is REAL format !!distanceFMT
  text .hei 'Snipe Height' callback |!this.setsize(!this.hei)| at x1 ymax+0.2 tagwid 10 width 7 is REAL format !!distanceFMT
  button .locksize 'Lock' toggle pixmap width 16 heig 16 at xmax+0.2 ymin-0.5

--<wd>25oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
  frame .allcorners 'Apply to All' at xmax+0.3 ymin.len-0.1
    toggle .allfour 'Four Snipes' callback |!this.foursnipes()|
  exit
--<wd>25oct2007<mds12>

  button .dismiss 'Dismiss' width 6.2  at xmax form-size ymax.deletefitt + 0.3 CANCEL

  -- define members
  -- holds the current member element being manipulated
  member .member is DBREF
  member .snipe is ARRAY
  member .current is MDSSNIPE
  member .aidnumber is REAL


exit

-----------------------------------------------------------------------------------------------------------
define method .mdssnipe()

  !this.formtitle    = |Snipes|
  !this.icontitle    = ||
  !this.callback     = |!this.init()|
  !this.formrevision = | $Revision: 1.1.19.1 $ |
  !this.cancelcall = '!this.dismiss()'

-- Set the callback on the specified FRAME/RTOGGLE gadgets
  !this.endframe.callback = '!this.update(true)'
  !this.legframe.callback = '!this.update(true)'

  !pickicon = !!pml.getpathname('navigate16.png')
  !this.pick.addpixmap(!pickicon)

  !this.aidnumber = !!aidnumbers.add(!this)

  !this.currmember.seteditable(FALSE)

  !this.locksize.addpixmap(!!pml.getpathname('lock_16.png'))


endmethod


-------------------------------------------------------------------------------------------------------------
define method .init()

  -- get the current element and check if the item is valid
  !sctn = sctn
     handle ANY
       return error 1 'Must be a SCTN!'
     endhandle

  if !sctn.gtyp.neq('ANG') then
    return error 1 'SCTN must be of gtype ANG'
  endif

  !this.snipe[1][1] = object MDSSNIPE(!sctn,'START','RTTA')
  !this.snipe[1][2] = object MDSSNIPE(!sctn,'START','LBOA')
  !this.snipe[2][1] = object MDSSNIPE(!sctn,'END','RTTA')
  !this.snipe[2][2] = object MDSSNIPE(!sctn,'END','LBOA')

  !this.member = !sctn
  !this.currmember.val = !sctn.namtyp
  !this.endframe.val = 1
  !this.legframe.val = 1

  !this.auto.active = !this.pick.val

--<wd>25oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- Add an 'APPLY to ALL SNIPES' facility
  !this.allfour.val = FALSE
  !this.foursnipes()
--<wd>25oct2007<mds12>

  !this.update(TRUE)


endmethod


--------------------------------------------------------------------------------------------------------------
define method .update(!aidgraphic is BOOLEAN)

   !end = !this.endframe.val
   !pline = !this.legframe.val

   !this.current = !this.snipe[!end][!pline]

   -- if snipe doesn't exist then calculate size
   if !this.current.snipe.badref() then
      !this.current.calculate()
      -- if zero size hase been calculated remove reference to stiffener and calculate it again
      if !this.current.leng.eq(0).or(!this.current.widt.eq(0)) then
         !this.current.stiff = nulref
         !this.current.calculate()
      endif
   endif

   !this.len.val = !this.current.leng
   !this.hei.val = !this.current.widt

   !this.setbuttons()

   if !aidgraphic then
      !this.aidlines()
   endif


endmethod


---------------------------------------------------------------------------------------------------------------
define method .setbuttons()

   !cractive = !this.current.snipe.badref()

   !modactive = !cractive.not()
   !delactive = !modactive
   !sizeactive = TRUE


   !this.len.active = !modactive
   !this.hei.active = !modactive

   !applicable = TRUE
   if !this.endframe.val.eq(1) then
      !join = 'jois'
      !perpendicularend = !this.member.zdir.isparallel(!this.member.drns)
   else
      !join = 'joie'
      !perpendicularend = !this.member.zdir.isparallel(!this.member.drne)
   endif

   if !this.member.$!<join>.badref().not() then
      !nojoint = !this.member.$!<join>.catr.badref()
   else
      !nojoint = TRUE
   endif

   !applicable = !nojoint.and(!perpendicularend)

   !nozerosize = !this.current.leng.eq(0).or(!this.current.widt.eq(0)).not()

   if !cractive then
      !cractive = !applicable
   endif

   if !cractive then
      !cractive = !nozerosize
   endif

   if !modactive then
      !modactive = !nozerosize
   endif

   !this.create.active = !cractive
   !this.modify.active = !modactive
   !this.deletefitt.active = !delactive
   !this.hei.active = !sizeactive
   !this.len.active = !sizeactive

endmethod


---------------------------------------------------------------------------------------------------------------
define method .create()

--<wd>25oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
  if (!this.allfour.val) then
-- Create ALL FOUR SNIPES
    !this.allfoursnipes('CREATE')

  else

--<wd>31oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- Original CODE for CREATING a SINGLE MDS SNIPE
    !this.current.create()
    !this.storesnipe()
    !this.setbuttons()
    !this.aidlines()

--<wd>aug2007<mds12>
-- Set the PURPOSE attribute to 'XGUI' to INDICATE the EXTRA(X) MDS SNIPE
-- has been created MANUALLY via the MDSSNIPE FORM(GUI)
    PURP XGUI
--<wd>31oct2007<mds12>

  endif
--<wd>aug2007<mds12>

endmethod

---------------------------------------------------------------------------------------------------------------
define method .storesnipe()

  !pline = !this.legframe.val
  !end = !this.endframe.val

  !this.snipe[!end][!pline] = !this.current

endmethod

---------------------------------------------------------------------------------------------------------------
define method .modify()


--<wd>26oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
  if (!this.allfour.val) then
-- Create ALL FOUR SNIPES
    !this.allfoursnipes('MODIFY')

  else

--<wd>31oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- Original CODE for MODIFYING a SINGLE MDS SNIPE
    !this.current.modify()

    !this.storesnipe()
--<wd>31oct2007<mds12>

  endif
--<wd>26oct2007<mds12>

endmethod

---------------------------------------------------------------------------------------------------------------
define method .setsize(!size is GADGET)


    !dist = !size.val
    !minsize = !this.current.minsize

    -- check length if set and correct
    if !dist.unset() then
       !dist = 0
    endif
    !sizeerror = !this.current.checksize(!dist,!this.current.pline)
    if !sizeerror.eq(1) then
    -- value is too small
        !dist = !minsize
    elseif !sizeerror.eq(2) then
    -- value is too big
        if !size.name().eq('LEN').or(!this.locksize.val) then
           !dist = !this.current.leng
        endif
    endif

    if !this.locksize.val then
       !this.len.val = !dist
       !this.hei.val = !dist
    else
       !size.val = !dist
    endif

    !this.current.setsize(!this.len.val,!this.hei.val)

    !this.setbuttons()

    !this.aidlines()

endmethod


---------------------------------------------------------------------------------------------------------------
define method .deletefitt()

--<wd>26oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
  if (!this.allfour.val) then
-- DELETE ALL FOUR SNIPES
    !this.allfoursnipes('DELETE')

  else

--<wd>31oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- Original CODE for DELETING a SINGLE MDS SNIPE
    !this.current.deletesnipe()
    !this.storesnipe()

    !this.setbuttons()
    !this.aidlines()
--<wd>31oct2007<mds12>

  endif
--<wd>26oct2007<mds12>

endmethod


---------------------------------------------------------------------------------------------------------------
define method .aidlines()

  !numb = !this.aidnumber

  -- clear any existing aidlines
  !!aidnumbers.hide(!numb)

  -- calculate data to draw snipe
  !leng = !this.current.leng
  !heig = !this.current.widt
  !pline = !this.current.pline
  !sctn = !this.current.sctn
  if !this.current.end.eq('START') then
     !pos = !sctn.plst.$!pline
     !heigdir = !sctn.zdir
  else
     !pos = !sctn.plen.$!pline
     !heigdir = !sctn.zdir.opposite()
  endif
  !lengdir = !sctn.plori.$!<pline>.zdir().opposite()

  -- tag snipe
  if !this.current.snipe.badref() then
      !text = 'Snipe Not Built'
      !diam = 5mm
  else
      !text = 'Snipe'
      !diam = 3mm
  endif
  aid text number $!numb '$!text' at $!pos

  -- escape if zero snipe
  if !leng.eq(0).or(!heig.eq(0)) then
     return
  endif

  if !pline.eq('LBOA') then
     !extrdir = !sctn.plori.toax.zdir()
  else
     !extrdir = !sctn.plori.toay.zdir()
  endif
  !extrheig = $!sctn.para[3] mm

  !lengpos = !pos.offset(!lengdir,!leng)
  !heigpos = !pos.offset(!heigdir,!heig)
  !snipedir = !lengpos.direction(!heigpos)

  !cyli[1] = object PLANE(!pos.midpoint(!lengpos),z is $!lengdir )
  !cyliheig[1] = !leng
  !cyli[2] = object PLANE(!pos.midpoint(!heigpos),z is $!heigdir )
  !cyliheig[2] = !heig
  !cyli[3] = object PLANE(!lengpos.midpoint(!heigpos),z is $!snipedir )
  !cyliheig[3] = !lengpos.distance(!heigpos)
  !corner[1] = !pos
  !corner[2] = !lengpos
  !corner[3] = !heigpos


  -- draw snipe
  do !c from 1 to 3
    !tmppos = !corner[!c].offset(!extrdir,!extrheig / 2 )
    aid cylinder number $!numb pos $!cyli[$!c].position ori $!cyli[$!c].orientation diameter $!diam heig $!cyliheig[$!c] filled on
    aid cylinder number $!numb pos $!tmppos ori z is $!extrdir diameter $!diam heig $!extrheig filled on
    aid sphere number $!numb $!corner[$!c] diameter $!diam
    !cyli[!c].position = !cyli[!c].position.offset(!extrdir,!extrheig)
    !corner[!c] = !corner[!c].offset(!extrdir,!extrheig)
    aid cylinder number $!numb pos $!cyli[$!c].position ori $!cyli[$!c].orientation diameter $!diam heig $!cyliheig[$!c] filled on
    aid sphere number $!numb $!corner[$!c] diameter $!diam
  enddo


endmethod

-- invoke EDG mode to select end and leg of section to create snipe on
---------------------------------------------------------------------------------------------
define method .edgentry()

   if !this.pick.val.not() then
      --!this.auto.active = FALSE
      --!this.auto()
      !!edgcntrl.remove('SelectSctnEnd&Edge')
      return
   endif

   !this.auto.active = TRUE
   !this.auto()
   !form = !this.fullname()

   !packet = object EDGPACKET()
   !packet.description = 'SelectSctnEnd&Edge'
   !packet.initialisation = '!this.input[1] = ce'
   !packet.action = '$!<form>.pick(!this.return[1])'
   !packet.close = '$!<form>.pick.val = false $!<form>.auto.active = false $!<form>.auto()'
   !packet.remove = FALSE
   !pickpacket = object EDGPICKPACKET()
   !pickpacket.stdelement('Pick SNIPE edge or end of leg of angle where you want it to be created')
   !packet.pickpacket = !pickpacket

   !!edgcntrl.add(!packet)

endmethod


-- re-initialise form after EDG pick
---------------------------------------------------------------------------------------------------------------
define method .pick(!edgpick is EDGPICKDATA)

  !sctn = !edgpick.item

--<wd>jul2007mds12> -- MARINE element is HSTIFF and not HSTI
--  if !sctn.type.eq('SCTN').or(!sctn.type.eq('HSTI')).not() then
  if !sctn.type.eq('SCTN').or(!sctn.type.eq('HSTIFF')).not() then
     return
  endif
--<wd>jul2007mds12>

--<wd>jul2007mds12> -- MARINE element HSTIFF element GTYPs added etc..
--  if !sctn.catr.gtyp.neq('ANG') then
  if (!sctn.catr.gtyp.neq('ANG')) and (!sctn.catr.gtyp.neq('EANG')) and (!sctn.catr.gtyp.neq('UEAN'))then
     return
  endif
--<wd>jul2007mds12>

 !lboa = object LINE(!sctn.plst.lboa,!sctn.plen.lboa)
  !rtta = object LINE(!sctn.plst.rtta,!sctn.plen.rtta)
  !pickline = !edgpick.pickline.line(1000)


  if !lboa.distance(!edgpick.pickline.line(100)).lt(!rtta.distance(!edgpick.pickline.line(100))) then
      !pline = 'LBOA'
      !leg = 2
  else
      !pline = 'RTTA'
      !leg = 1
  endif

  !plinexpick = !$!<pline>.intersection(!pickline)
  if !plinexpick.distance(!$!<pline>.startposition).lt(!plinexpick.distance(!$!<pline>.endposition)) then
     !end = 1
  else
     !end = 2
  endif

  !this.endframe.val = !end
  !this.legframe.val = !leg


  !this.snipe[1][1] = object MDSSNIPE(!sctn,'START','RTTA')
  !this.snipe[1][2] = object MDSSNIPE(!sctn,'START','LBOA')
  !this.snipe[2][1] = object MDSSNIPE(!sctn,'END','RTTA')
  !this.snipe[2][2] = object MDSSNIPE(!sctn,'END','LBOA')

  !this.member = !sctn
  !this.currmember.val = !sctn.name
  !!ce = !sctn
  !this.update(FALSE)

  if !this.current.snipe.badref().and(!this.auto.val).and(!this.create.active) then
     !this.create()
     !this.setbuttons()
  else
     !this.update(TRUE)
  endif

endmethod

---------------------------------------------------------------------------------------------------------------
define method .dismiss()

  -- unregister form from !!aidnumbers
  !!aidnumbers.remove(!this.aidnumber)

  -- close EDG graphical mode
  !!edgcntrl.remove('SelectSctnEnd&Edge')

endmethod



--temporary method to fix toggle button bug
-- toggle is colored orange/normal to indicate on/off state
-------------------------------------------------------------
define method .auto()

  -- store original value of col 128
  var !col128 colour 128

  --temporary reset colour 128
  if !this.auto.val.and(!this.auto.active) then
     colour 128 Mix Red 100 Green 79 Blue 47
  else
     colour 128 Mix Red 96 Green 96 Blue 94
  endif

  !this.auto.background = 128

  -- reset colour 128 back to its original value
  colour 128 $!col128

  !this.auto.refresh()

endmethod

---------------------------------------------------------------------------------------------------
--<wd>25oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
-- Method to TOGGLE between Activate and Deactivate the FRAMES .endframe and .legframe
---------------------------------------------------------------------------------------------------
define method .foursnipes()

-- Alternately Deactivate/Activate the Single Snipe FRAMES .endframe and .legframe
-- when the TOGGLE .allfour gadget value is set to TRUE or FALSE
  if (!this.allfour.val) then
    !this.endframe.active = FALSE
    !this.legframe.active = FALSE
    !!aidnumbers.remove(!this.aidnumber)
  else
    !this.endframe.active = TRUE
    !this.legframe.active = TRUE
    !this.update(TRUE)
  endif

endmethod
--<wd>25oct2007<mds12>

---------------------------------------------------------------------------------------------------
--<wd>25oct2007<mds12>
-- DUN767 -- Defect No. P-2890 -- ADD an 'APPLY to ALL SNIPES' facility to the FORM
-- Method to CREATE, MODIFY or DELETE all FOUR SNIPES on the ANGLE SCTN
---------------------------------------------------------------------------------------------------------------
define method .allfoursnipes(!mode is STRING)
--$P
--$P
--$P ================= STARTS HERE ==============================
-- All of the MDS SNIPE objects are stored in the FORM member ARRAY !this.snipe,
-- i.e.
-- !this.snipe[1][1] = object MDSSNIPE(!sctn,'START','RTTA')
-- !this.snipe[1][2] = object MDSSNIPE(!sctn,'START','LBOA')
-- !this.snipe[2][1] = object MDSSNIPE(!sctn,'END','RTTA')
-- !this.snipe[2][2] = object MDSSNIPE(!sctn,'END','LBOA')

-- Initialise Variables and Store Current FORM Settings
  !snipes = !this.snipe
  !xcurr  = !this.current
  !xstart = !this.start.val
  !xtop   = !this.top.val

  !leng = !this.len.val
  !heig = !this.hei.val


-- LOOP through ALL FOUR of the MDS SNIPE OBJECTS and CREATE the SNIPES
  do !value values !snipes
    do !indx indices !value
-- Update the FORM FRAME RTOGGLE gadgets for the Current SNIPE Object
      !this.current = !value[!indx]
      !this.current.leng = !leng
      !this.current.widt = !heig

--$P ************* q var !this.current !this.member.fullname !this.current.snipe.fullname (FITTING)*************
--q var !this.current !this.member.fullname !this.current.snipe.fullname

-- Update the FORM RTOGGLE .start or .end gadgets
      if (!value[!indx].end.upcase().eq('START')) then
        !this.start.val = TRUE
      elseif (!value[!indx].end.upcase().eq('END')) then
        !this.end.val = TRUE
      endif
-- Update the FORM RTOGGLE .top or .left gadgets
      if (!value[!indx].pline.upcase().eq('RTTA')) then
        !this.top.val = TRUE
      elseif (!value[!indx].pline.upcase().eq('LBOA')) then
        !this.left.val = TRUE
      endif

      if (!mode.upcase().eq('CREATE')) or (!mode.upcase().eq('MODIFY'))then
-- Delete the existing MDS SNIPE(FITTING) before CREATING or MODIFYING a NEW SNIPE(FITTING)
-- The 'MODIFY' mode for ALL FOUR SNIPES has to operate the same as the 'CREATE' mode, as
-- ONLY ONE SNIPE may exist on the ANGLE SCTN member
        !!ce = !this.current.snipe
        handle ANY
-- IGNORE the ERROR as the SNIPE (FITTING) may be unset or a badref etc...
        elsehandle NONE
          delete fitt
        endhandle

-- Emulate the existing .create() method
        !this.current.create()
        !this.storesnipe()
        !this.setbuttons()
        !this.aidlines()
-- Set the PURPOSE attribute to 'XGUI' to INDICATE ALL FOUR of the EXTRA(X)
-- MDS SNIPES have been created MANUALLY via the MDSSNIPE FORM(GUI)
        PURP XGUI

      elseif (!mode.upcase().eq('DELETE')) then
-- Skip if the MDS SNIPE does NOT exist
        skip if !this.current.snipe.badref()

-- Emulate the existing .deletefitt() method
        !this.current.deletesnipe()
        !this.storesnipe()
        !this.setbuttons()
        !this.aidlines()

      endif
    enddo
  enddo

-- Restore the Existing Settings of the FORM gadgets and members
  !this.current = !xcurr

  if (!xstart) then
    !this.start.val = TRUE
  else
    !this.end.val = TRUE
  endif

  if (!xtop) then
    !this.top.val = TRUE
  else
    !this.left.val = TRUE
  endif

-- Update FORM gadgets and members
  !this.update(TRUE)

--$P
--$P ================= ENDS HERE ==============================
--$P
--$P

endmethod
--<wd>25oct2007<mds12>

---------------------------------------------------------------------------------------------------------------
