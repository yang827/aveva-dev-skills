--
-- Author:		Neale Morris
-- Created:		Tuesday 8th March 2005
--
--
-- Description:
-- Form Definition for selecting the Material Reference on
-- MDS Structure members (matref)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  enhance()                        -
--  init(form)                       -
--  matref()                         -
--  matset()                         -
--  name(form)                       -
--  select()                         -
--  setall()                         -
--  setsctn(form)                    -
--  unenhance()                      -
--

-- Kill existing form definition

kill !!MdsSteelMat

-- Define form
setup form !!MdsSteelMat

  !this.formtitle  = 'Set Section/Joint/Plate Material'
  !this.cancelcall = '!this.cancel()'

-- Display Support Name

  paragraph .name at xmax+1 ymin text |!this.name()| width 60 lines 1

-- Selection Frame
  frame .selframe | Select | at x1 ymax

-- List of sections/joints on the Support
    list .sctn |Sections/Joints/Plates| at x1 ymax call |!this.select()| multi width 25 length 10

-- List of Available Materials
    list .matref |Materials           |   at xmax ymin width 40 length 10

--  Set Material to all sections/joints on the Support
    toggle .setall |Select All Sections/Joints | at x1 ymax call |!this.setall()|

  exit

-- Apply Form
  button .apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|

-- Dismiss Form
  button .cancel | Dismiss | at xmax form-size ymin call |!this.cancel()| cancel

-- Exit form definition
  exit

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------
--
--------------------------------------------------------------------
define method .init(!form is form)
--------------------------------------------------------------------

-- Collect all sections/joints

  if !Form.string().eq('MDSFH01') then
    !rest = !Form.Support.datum.cref.owner
    var !wpads coll all wpad for $!rest
    if (!wpads.size().lt(1)) then
      !!alert.warning('Plates have to exist to be able to set the material')
      return
    endif
  else
    var !sctns coll all (sctn pjoi sjoi) for $!Form.Support.Stru
    if (!sctns.size().lt(1)) then
      !!alert.warning('Steelwork has to exist to be able to set the material')
      return
    endif
  endif


-- Populate the forms sctns/joints list

  !this.name(!form)
  !this.setsctn(!form)

-- Always select the first section/joint

  !this.sctn.clearselection()
  !this.sctn.select('dtext', !this.sctn.dtext[1])

-- Populate form material

  !this.matref()

-- Select the material of the selected atta

  !this.matset()


-- Unenhance all sections/joints - whatever is being done
  !this.unenhance()
-- Enhance the selected sections/joints in the Colour RED <Colour N0.2>
  do !Enhance values !this.sctn.selection()
    enhance $!Enhance col 2
  enddo

-- Show Form if sections/joints and materials exist
  !this.show()

endmethod

--------------------------------------------------------------------
define method .name(!form is form)
--------------------------------------------------------------------

  !this.name.val = 'Support Name: ' & !form.name.val

endmethod

--------------------------------------------------------------------
define method .setsctn(!form is form)
--------------------------------------------------------------------

  if !Form.string().eq('MDSFH01') then
-- Collect all plates
    !Rest = !Form.Support.datum.cref.owner
    var !wpads coll all wpad for $!Rest
    !dtext  = array()
    !rtext  = array()
    !orig = !!ce
-- Check All Wpads
    do !wpad values !wpads
      !dtext.append(!wpad.dbref().name)
    enddo
    !this.sctn.dtext = !dtext.unique()
    !!ce = !orig
  else
-- Collect all sections/joints
    var !sctns coll all (sctn pjoi sjoi) for $!Form.Support.Stru
    !dtext  = array()
    !rtext  = array()
    !orig = !!ce
-- Check All Sctns/Joints
    do !sctn values !sctns
      !dtext.append(!sctn.dbref().name)
    enddo
    !this.sctn.dtext = !dtext.unique()
    !!ce = !orig
  endif

endmethod

--------------------------------------------------------------------
define method .matref()
--------------------------------------------------------------------

-- Initialise variable

  !matexist = false
  !dtext = array()
  !rtext = array()

-- Get all the Materials available in the Propcon Database
  !Desc = (desc of /MDS/TEMPLATES )
  if !Desc.eq('Framatome Templates') then
    !sden = !!kcollectallfor('SDEN', 'sref of owner eq |FRA| and pres eq -100000 and temp eq -100000', =0/0)
  else
    !sden = !!kcollectallfor('SDEN', 'sref of owner eq |STD| and pres eq -100000 and temp eq -100000 and pqual of owner eq |MDS|', =0/0)
  endif

  if (defined(!sden) or !sden.size().neq(0)) then
    !bsoli = object block('!sden[!evalindex].owner.owner')
    !solid = !sden.evaluate(!bsoli)
    !bdesc = object block('!sden[!evalindex].owner.owner.description')
    !descr = !sden.evaluate(!bdesc)
    !bdens = object block('!sden[!evalindex].density')
    !dens  = !sden.evaluate(!bdens)
    !altdesc = object block ('!sden[!evalindex].owner.owner.:MDSMatDesc')
    !altd    = !sden.evaluate(!altdesc)
    !matexist = true
  endif


-- Load the list with the available materials
  if (!matexist) then

    !dsiz  = (!dens.width() + 15)
    !order = !descr.sortedindices()

    do !indx values !order
      !denx = !dens[!indx].string('d2')
      if !descr[$!indx].neq('') then
        !csiz  = !descr.width()
        var !dprt compose space 1 |$!descr[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      else
        !csiz  = !altd.width()
        var !dprt compose space 1 |$!altd[$!indx]| width $!csiz space 2 |$!denx kg/m$X3| width $!dsiz R
      endif
      !dtext.append(!dprt[1])
      !rtext.append(!solid[!indx].string())
    enddo

    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext

  endif

endmethod

--------------------------------------------------------------------
define method .setall()
--------------------------------------------------------------------

  if (!this.setall.val) then
    do !count from 1 to !this.sctn.dtext.size()
      !this.sctn.select('dtext', !this.sctn.dtext[!count])
    enddo
  else
    !this.sctn.clearselection()
    !this.sctn.select('dtext', !this.sctn.dtext[1])
  endif

-- Enhance Graphically the selected sections/joints
  !this.select()

endmethod

--------------------------------------------------------------------
define method .select()
--------------------------------------------------------------------

  !vals = !this.sctn.val
  !sels = !this.sctn.selection()

-- Unenhance all sctns/joints - whatever is being done
  !this.unenhance()
  if (!vals.unset()) then
-- No sections/joints selected - so leave the display list unenhanced
    !this.setall.val = false
  else
-- Enhance only the Selected sctns/joints in red <Colour No.2>
    do !indx values !sels
      enhance $!indx col 2
    enddo
  endif

  if (!vals.size().eq(!this.sctn.dtext.size())) then
    !this.setall.val = true
  else
    !this.setall.val = false
  endif

-- Select the Material of the First Selected in the List

  !this.matset()

endmethod

--------------------------------------------------------------------
define method .unenhance()
--------------------------------------------------------------------

-- Unenhance all sections/joints

  !sctns = !this.sctn.dtext
  do !indx values !sctns
    unenhance $!indx
  enddo

-- Re-Enhance all sections/joints in the User-Defined Graphical Highlight Colour
  !this.enhance()

endmethod

--------------------------------------------------------------------
define method .enhance()
--------------------------------------------------------------------

-- Enhance all sections/joints in the Graphical Highlight Colour
  !sctns = !this.sctn.dtext
  do !indx values !sctns
    unenhance $!indx
    enhance $!indx col $!!gphcolopt.highlight.code
  enddo

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------

-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
-- The variable !MatrefAtt will be set to either REF for matref or UDA for :MdsMatref

-- Set the Selected MatRefs

  !Sctns = !this.sctn.selection()
  !Matr  = !this.matref.selection().dbref()
    handle (2,813)
      !matr = !this.matref.selection().trim()
        handle (2,201)
          !MatrefAtt = !!MdsUseMatref(!this.:mdsmatref.selection().dbref())
          if !MatrefAtt.eq('UDA') then
            !Matr  = !this.:mdsmatref.selection().dbref()
              handle (2,813)
                !matr = !this.:mdsmatref.selection().trim()
              endhandle
          else
            !Matr  = !this.matref.selection().dbref()
              handle (2,813)
                !matr = !this.matref.selection().trim()
              endhandle
          endif
        endhandle
    endhandle

  !!mdsdaccontrol(true)

  if (!sctns.set()) then
-- Set all of the selected sctns/joints MATREF
    do !indx values !sctns
      !sctn = !indx.dbref()
      !MatrefAtt = !!MdsUseMatref(!sctn)
      !sctn.matref = !matr
        handle (41,232)
          if !MatrefAtt.eq('UDA') then
            !sctn.:mdsmatref = !matr
              handle ANY
                !!ce = !sctn
                !nameofsctn = !!ce.name
                !!alert.error('Unable to modify the material of $!nameofsctn')
                skip
              endhandle
           else
             !sctn.matref = !matr
              handle ANY
                !!ce = !sctn
                !nameofsctn = !!ce.name
                !!alert.error('Unable to modify the material of $!nameofsctn')
                skip
              endhandle
           endif
        elsehandle ANY
          !!ce = !sctn
          !nameofsctn = !!ce.name
          !!alert.error('Unable to modify the material of $!nameofsctn')
          skip
        endhandle
    enddo
  endif

  !this.matref.tag = 'Materials'

  !!mdsdaccontrol(false)

endmethod

--------------------------------------------------------------------
define method .cancel()
--------------------------------------------------------------------

-- Unenhance sections/joints and Return to the Set Highlight Colour

  !this.unenhance()

endmethod

define method .matset()

-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
-- The variable !MatrefAtt will be set to either REF for matref or UDA for :MdsMatref


-- If the selection of the sections/joints is 1 then select the material if not
-- test to see if they ate the same if so select the material
-- if not then unset the material list

  if !this.sctn.selection().size().eq(1) then
    !Selected = !this.sctn.selection()
    !MatrefAtt = !!MdsUseMatref(!selected[1].dbref())
    !Matref = !Selected[1].dbref().matref.string()
      handle (2,201)
        if !Matrefatt.eq('UDA') then
          !Matref = !Selected[1].dbref().:mdsmatref.string()
        else
          !Matref = !Selected[1].dbref().matref.string()
        endif
      endhandle
    !Number = !this.matref.rtext.findfirst(!matref)
    !this.matref.val = !Number
      handle ANY
        !this.matref.val = 1
      endhandle
    !this.matref.tag = 'Materials'
  elseif !this.sctn.selection().size().eq(0) then
    !this.matref.clearselection()
    !this.matref.tag = 'Materials'
  else
-- Multiple sections/joints selected
    !Matrefs = ARRAY()
    do !ListMatrefs values !this.sctn.selection()
      !NameOfSelection = !ListMatrefs.dbref()
      !Matref = !NameOfSelection.matref.string()
        handle (2,201)
          !MatrefAtt = !!MdsUseMatref(!NameOfSelection)
          if !Matrefatt.eq('UDA') then
            !Matref = !NameOfSelection.:mdsmatref.string()
          else
            !Matref = !NameOfSelection.matref.string()
          endif
        endhandle
      !MatRefs.append(!Matref)
    enddo
    !Matrefs.unique()
    if !matrefs.size().eq(1) then
      !this.matref.tag = 'Materials'
      !Matref = !this.sctn.dtext[1].dbref().matref.string()
        handle (2,201)
          !MatrefAtt = !!MdsUseMatref(!NameOfSelection)
          if !Matrefatt.eq('UDA') then
            !Matref = !NameOfSelection.:mdsmatref.string()
          else
            !Matref = !NameOfSelection.matref.string()
          endif
        endhandle
      !Number = !this.matref.rtext.findfirst(!matref)
      !this.matref.val = !Number
      handle ANY
--<wd>nov2005
      endhandle
    else
      !this.matref.tag = 'Materials (Multiple)'
      !this.matref.clearselection()
    endif
  endif


endmethod

--------------------------------------------------------------------
-- End of Form Definition & Methods for - !!MdsSteelMat
--------------------------------------------------------------------
