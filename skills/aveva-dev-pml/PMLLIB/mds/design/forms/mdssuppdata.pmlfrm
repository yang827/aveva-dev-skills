-- Created:		Sunday 9th May 2004
--
--
-- Description:
-- Form Definition for string support data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  FuncCheck()                      -
--  OK()                             -
--  ResetValues()                    -
--  init(form)                       -
--

-- Kill existing form definition

kill !!mdssuppdata

-- Define form

setup form !!mdssuppdata

  !!mdssuppdata.formtitle    = |Data|
  !!mdssuppdata.icontitle    = |Data|
  !!mdssuppdata.Callback     = ||
  !!mdssuppdata.formrevision = ||

-- Body of Form

  para .Tag text | Name:|
  para .name at xmax+2 ymin width 20 lines 1

  path down

  text .CalcNo |Stress Calc. No.  | at x0 ymax+0.5 call || width 15 STRING
  text .Config |Configuration     | call || width 15 STRING
  text .NodeNo |Node No.          | call || width 15 STRING
  text .Temp   |Temperature       | call || width 15 NUMERIC
  text .Load   |Load              | call || width 15 NUMERIC
  para .Force text  |Force        |
  text .ForceX |              X   | call || width 15 NUMERIC
  text .ForceY |              Y   | call || width 15 NUMERIC
  text .ForceZ |              Z   | call || width 15 NUMERIC
  para .Move text  |Movement      |
  text .MoveX  |              X   | call || width 15 NUMERIC
  text .MoveY  |              Y   | call || width 15 NUMERIC
  text .MoveZ  |              Z   | call || width 15 NUMERIC
  text .Hload  |Hydraulic  Load   | call || width 15 NUMERIC
  para .AT text |AT               |
  text .Atn    |           North  | call || width 15 NUMERIC
  text .Ate    |           East   | call || width 15 NUMERIC
  para .AE text |AE               |
  text .Aen    |           North  | call || width 15 NUMERIC
  text .Aee    |           East   | call || width 15 NUMERIC
  text .SuppF  |Support Function  | call |!This.funccheck()| width 15 SCROLL 0 STRING
  para .TypeT  text |Standard Type           |
  path right
  list .Type width 7 length 3

  !dtext = ARRAY()
  !dtext.append('unset')
  !dtext.append('Yes')
  !dtext.append('No')

  !this.type.dtext = !dtext

-- Bottom Line

  button .OK      |   OK   | at x0 ymax+0.5 call |!this.Ok()| OK
  button .Cancel  | Cancel | at xmax form-size ymin call || CANCEL

-- Form Members

-- data storage

  member .Atta is DBREF
  member .CallingForm is FORM
  member .ResetValues is ARRAY

 -- End form definition
exit

-- Set background colour of pixmaps to white

  !!MdsSetIconBack(!!mdssuppdata,'white')

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------
--
--------------------------------------------------------------------
define method .init(!Frameform is form)
--------------------------------------------------------------------

-- Set calling form in member

  !!mdssuppdata.CallingForm = !FrameForm

-- Test if any atta's have been created

  if !FrameForm.support.Datum.unset() then
    !!Alert.Error('Unable to modify an ancillary as none have been created')
    return
  endif

-- Check if Calling Support Form is a MDS Framework or Ancillary Standard

  if (!FrameForm.support.stru.set()) then
    --!!mdssuppdata.modifytype.active = true
    !num = 2
  else
    --!!mdssuppdata.modifytype.active = false
    !num = 1
  endif

-- If only the datum atta has been created default to that
-- rather than id the atta

  if !FrameForm.support.Datum.set() and !Frameform.support.atta.size().eq(!num) then
    !!CE = !FrameForm.support.datum
    !Picked = !!CE
  else

-- Identify ancillary by cursor
    prompt off
    prompt load escape |Identify ancillary to modify|
label /again
    id atta plat @
       handle (61,528)
         prompt dismiss
         prompt on
         return
       endhandle

    !Picked = !!CE

-- Is picked atta on support
-- Create list of atta's on support

    if (!FrameForm.Support.Atta.findfirst(!Picked).set().not())then
      !!Alert.error('Ancillary picked is not on this support')
      golabel /again
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Check to see if the SREF has been hit, if it has goto the DATUM atta

    if (match(!!CE.Name,'/SREF') gt 0) then
      !SrefName = !!CE.name
      var !Strip (Before(!SrefName,'/SREF'))
      !DatumName = !Strip & '/DATUM'
      !!CE = !DatumName.dbref()
    endif

  endif

  !Picked = !!CE

-- Read the current setting for the atta/plat

  !!mdssuppdata.name.val = !!ce.name
  !!mdssuppdata.atta     = !!ce

  !this.CalcNo.val  = !!ce.:MdsCalcNo
  !this.Config.val  = !!ce.:MdsConfig
  !this.NodeNo.val  = !!ce.:MdsNodeNo
  !this.Temp.val    = !!ce.owner.temp.string()
  !this.temp.active = FALSE
  !this.Load.val    = !!ce.:Mdsload.string()
  !this.ForceX.val  = !!ce.:MdsForceX.string()
  !this.ForceY.val  = !!ce.:MdsForceY.string()
  !this.ForceZ.val  = !!ce.:MdsForceZ.string()
  !this.MoveX.val   = !!ce.:MdsMoveX.string()
  !this.MoveY.val   = !!ce.:MdsMoveY.string()
  !this.MoveZ.val   = !!ce.:MdsMoveZ.string()
  !this.Hload.val   = !!ce.:MdsHload.string()
  !this.Atn.val     = !!ce.:MdsAtn.string()
  !this.Ate.val     = !!ce.:MdsAte.string()
  !this.Aen.val     = !!ce.:MdsAen.string()
  !this.Aee.val     = !!ce.:MdsAee.string()
  !this.SuppF.val   = !!ce.:MdsSuppFunc

  !this.ResetValues.clear()
  !this.ResetValues.append(|:MdsCalcNo '|   + !!ce.:MdsCalcNo.string() + |'|)
  !this.ResetValues.append(|:MdsConfig '|   + !!ce.:MdsConfig.string() + |'|)
  !this.ResetValues.append(|:MdsNodeNo '|   + !!ce.:MdsNodeNo.string() + |'|)
  !this.ResetValues.append(|:Mdsload |     + !!ce.:Mdsload.string())
  !this.ResetValues.append(|:MdsForceX |   + !!ce.:MdsForceX.string())
  !this.ResetValues.append(|:MdsForceY |   + !!ce.:MdsForceY.string())
  !this.ResetValues.append(|:MdsForceZ |   + !!ce.:MdsForceZ.string())
  !this.ResetValues.append(|:MdsMoveX |    + !!ce.:MdsMoveX.string())
  !this.ResetValues.append(|:MdsMoveY |    + !!ce.:MdsMoveY.string())
  !this.ResetValues.append(|:MdsMoveZ |    + !!ce.:MdsMoveZ.string())
  !this.ResetValues.append(|:MdsHload |    + !!ce.:MdsHload.string())
  !this.ResetValues.append(|:MdsAtn |      + !!ce.:MdsAtn.string())
  !this.ResetValues.append(|:MdsAte |      + !!ce.:MdsAte.string())
  !this.ResetValues.append(|:MdsAen |      + !!ce.:MdsAen.string())
  !this.ResetValues.append(|:MdsAee |      + !!ce.:MdsAee.string())
  !this.ResetValues.append(|:MdsSuppFunc '| + !!ce.:MdsSuppFunc.string() + |'|)

  !desc = (desc of /MDS/TEMPLATES )
    handle ANY
      !desc = 'MDS'
    endhandle

  if !Desc.eq('Framatome Templates') then
    !this.calcno.active = FALSE
  else
    !this.calcno.active = TRUE
  endif

-- Set support type

  !StandardType = !!ce.:MdsStandType
    handle none
      if !StandardType.upcase().eq('UNSET') then
        !this.type.val = 1
      elseif  !StandardType.upcase().eq('YES') then
        !this.type.val = 2
      elseif  !StandardType.upcase().eq('NO') then
        !this.type.val = 3
      endif
    elsehandle any
      !this.type.val = 1
    endhandle

  show !!mdssuppdata

  !!KShowForm(!!mdssuppdata)

endmethod

define method .OK()

-- Goto atta

  !!ce = !!mdssuppdata.atta

  !!MdsDacControl(true)

  !!ce.:MdsCalcNo = !this.CalcNo.val
  !!ce.:MdsConfig = !this.Config.val
  !!ce.:MdsNodeNo = !this.NodeNo.val
  !!ce.:MdsLoad   = !this.Load.val.real()
  !!ce.:MdsForceX = !this.ForceX.val.real()
  !!ce.:MdsForceY = !this.ForceY.val.real()
  !!ce.:MdsForceZ = !this.ForceZ.val.real()
  !!ce.:MdsMoveX  = !this.MoveX.val.real()
  !!ce.:MdsMoveY  = !this.MoveY.val.real()
  !!ce.:MdsMoveZ  = !this.MoveZ.val.real()
  !!ce.:MdsHload  = !this.Hload.val.real()
  !!ce.:MdsAtn    = !this.Atn.val.real()
  !!ce.:MdsAte    = !this.Ate.val.real()
  !!ce.:MdsAen    = !this.Aen.val.real()
  !!ce.:MdsAee    = !this.Aee.val.real()
  !!ce.:MdsSuppFunc = !this.SuppF.val

  -- Reset the stex to include the :MdsSuppFunc
  -- get original :MdsSuppFunc from member .resetvalues
  do !I values !this.resetvalues
    if !I.match(':MdsSuppFunc').gt(0) then
      !oldfunc = |-| & !i.after(|:MdsSuppFunc '|).before(|'|)
      break
    endif
  enddo
  !stex = !!ce.stex
  !newfunc = |-| & !this.SuppF.val
  !newstex = !stex.replace(!oldfunc , !newfunc)
  !!ce.stex = !newstex
--<GE> 31/01/07 Fix for HPD0034318
    handle any
    endhandle
--<GE> 31/01/07
  if !this.type.val.eq(1) then
    !!ce.:MdsStandType = 'unset'
      handle any
      endhandle
  elseif !this.type.val.eq(2) then
    !!ce.:MdsStandType = 'Yes'
      handle any
      endhandle
  elseif !this.type.val.eq(3) then
    !!ce.:MdsStandType = 'No'
      handle any
      endhandle
  endif

  !!MdsDacControl(FALSE)

endmethod

define method .FuncCheck()

-- Goto atta

  !!ce = !!mdssuppdata.atta

  if !!ce.styp.match('PR').eq(1) then
    !!Alert.Error('Unable to modify the support function of a preliminary support')
    !This.Suppf.val = !!ce.:MdsSuppFunc
  endif

endmethod

define method .ResetValues()

  !!ce = !!mdssuppdata.atta
    handle NONE
      do !reset values !this.resetvalues
        $!reset
      enddo
      same
    elsehandle ANY
    endhandle
  !this.resetvalues.clear()

endmethod

--------------------------------------------------------------------
-- End of Form Definition - !!mdssuppdata
--------------------------------------------------------------------
