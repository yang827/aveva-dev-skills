-- Define form

setup form !!mdssuppinfodata

  !!mdssuppinfodata.formtitle    = |Data|
  !!mdssuppinfodata.icontitle    = |Data|


  if !!MDSSuppInfo.ElevenSix then
     !Columns = 'columns'
     !Widt = 25
     !Heig = 18
  else
     !Columns = ''
     !Widt = 35
     !Heig = 17
  endif

  list .Data at xmin ymin $!Columns width $!Widt height $!Heig

  button .Cancel 'Cancel' at xmax form-size ymax CANCEL

   if !!MDSSuppInfo.ElevenSix then
    !Head[1] = ''
    !Head[2] = ''
    !This.Data.SetHeadings(!Head)
   endif

  exit
