------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkName()                      -
--  init()                           -
--  mdsSupportName()                 -
--

setup form !!mdsSupportName BLOCKING

  text .name 'Name:' tagwidth 5 at xmin callback '!!mdsSupportName.checkName()' width 20 name
  button .autoname at xmax+0.2 ymin tooltip 'Autoname' pixmap width 19 height 19 call '!!mdsautoname.getnextname(!this)'

  button .ok 'OK' width 4 at xmin.name ymax+0.5 callback '' OK
  button .cancel 'Cancel' width 5 at xmax form-size ymin CANCEL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsSupportName()

  !this.formtitle = 'Support Name'
  !this.initcall = '!this.init()'
  !this.autoname.addPixmap(!!pml.getpathname('autoname.png'))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName()

  !name = !this.name.val
  !unset = 'unset'
  if !name.set() then
    !name = !name.trim()
    if !name.empty() then
  	  !name = !unset
  	else
  		!name = !name.replace(' ','')
  		if !name.match('/').eq(1) then
  			!name = !name.after('/')
  		endif
  		if !name.empty().or(!name.lowcase().eq('unset')) then
  			!name = !unset
  		else
  			!slashname = '/' & !name
  			!slashname.dbref()
  			handle NONE
  				!!alert.error('Name (' & !slashname & ') already exists.')
  				!name = !unset
  			elsehandle ANY
  			endhandle
  		endif
  	endif
  else
  	!name = !unset
  endif
  !this.name.val = !name
  !this.ok.active = !name.neq(!unset)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.name.val = 'unset'
  !!mdsautoname.getnextname(!this)
  !this.ok.val = false

endmethod
-- End of method
