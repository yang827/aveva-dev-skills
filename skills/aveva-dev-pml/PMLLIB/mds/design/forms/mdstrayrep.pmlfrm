--
--
-- Description:
-- Multi Discipline support form
-- Purpose: To set connections for Framatome supports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -
--  ifScreen()                       -                   Maintain the Screen or File Gadgets
--  init(STRING)                     -
--  inout()                          -                   Maintain the Screen for input or output
--  readdata(STRING)                 -
--  report()                         -
--  select(STRING)                   -
--  setFile()                        BOOLEAN             Set the Filename Gadget and Access Mode
--
Kill !!mdsTrayRep

-- Define Form
setup form  !!mdsTrayRep

  title        |Electrical Tray Support Report|
  icontitle    |Trayrep|
  Initcall     |!this.init('SITE')|
  revision     | $Revision: 1.00 |


  -- Body of form definition

  -- Bar Menu
  bar
  exit

  frame .destination 'Destination/Input file' at x0 ymax width 50

    rgroup .InOrOut  '' at x1 ymax call '!this.inout()' Horizontal
      add tag 'Output Mode   '  select 'OUTPUT'
      add tag 'Read Mode '      select 'READ'
    exit
    rgroup .fileOrTer  '' at x1 ymax call '!this.ifScreen()' Horizontal
      add tag 'File          '  select 'FILE'
      add tag 'Screen   '       select 'SCREEN'
    exit

    toggle .Heading 'Add Line Heading ' at xmax.fileorter+ 2 ymin+0.25

    rgroup .fileType   '' at x1 ymax.fileorter call '' Horizontal
      add tag 'New File      '  select 'WRITE'
      add tag 'Overwrite     '  select 'OVERWRITE'
      add tag 'Append      '    select 'APPEND'
    exit

    --para   .filep     at x1 ymax+0.5  text      'Filename '
    --path right
    text   .filename 'Filename ' at x1 ymax+0.5 call '' width 28 scroll 80 string
    button .browser 'Browse...' at xmax+1.5 ymin call |!!fileBrowser('c:\temp', 'TrayDataOutput', 'Tray Report Output', false, '!!mdsTrayRep.filename.val = !!fileBrowser.file.name()')|
    button .readfile ' Read Modified Report File ' at xmin .filename ymax+0.5 call |!this.readdata(!this.filename.val)|
  exit

  -- Body of Form

  path down

  button .ce 'CE' at xmin .destination+ 0.5 ymax+0.2 call |!this.init('CE')|
  list .supportlist at xmin ymax+0.2  call || multiple width 50 hei 6
  button .report 'Report on selected supports' at xmin ymax call |!this.report()|

  --button.disconnect 'Disconnect' at xmax+2 ymin call |!this.deleteconnection()|

  button .dismiss 'Dismiss'  at xmax form -size ymin call |!this.dismiss()| cancel
  menu .selmenu
  !this.selmenu.add('callback','Select all','!this.select(|all|)')
  !this.selmenu.add('callback','Clear Selections','!this.select(|clear|)')
  !this.supportlist.setpopup(!this.selmenu)

  member .form is form
  member .reports is ARRAY
  member .stru is dbref
  member .file is file
  -- !this.file = object file('C:\temp\TrayDataOutput')
  !this.filename.val = 'C:\temp\TrayDataOutput'
  member .currentmode is STRING

exit
--------------------------------------------------------------------------------
-- method to go and find the fittings for the current selected sctn and show their connections
define method .init(!type is STRING)

    $!type
    handle ANY
    endhandle
    if !!ce.ddepth.gt(3) then
       stru
       handle any
       endhandle
    endif
    var !supports coll all stru with matchwild(:mdssupptype,'FR*' ) for ce
    var !names eval namn for all from !supports
    !index = !names.sortedindices()
    !names.reindex(!index)
    !supports.reindex(!index)
    !this.supportlist.dtext = !names
    !this.supportlist.rtext = !supports
    if !names.size().eq(1) then $* select it
      !x[1] = 1
      !this.supportlist.val = !x
    endif

   !this.inorout.select('OUTPUT')
   !this.inout()


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .report()

 !this.reports = ARRAY()
 if !this.supportlist.selection().size().eq(0) then
       !!alert.error('No Supports Selected')
       return
 endif

 do !a values !this.supportlist.selection()

   !obj = object mdstraysupreport(!a.dbref())
   handle ANY
    $p $!!error.text
    $p $!!error.line
   endhandle
   !rep = !obj.getoutput(!this.heading.val)

   !this.reports.appendarray(!rep)

 enddo

 if (!this.fileOrTer.selection() eq 'SCREEN') then
    -- print the output to the screen
    do !line values !this.reports
      $p $!line
    enddo
    -- q var !this.reports
 else
     -- Filename must be set in correct mode then open alpha file
    if (!this.setFile()) then
      !this.file.writefile(!this.fileType.selection(),!this.reports)
      !this.fileType.select(!this.currentmode)
    else
      return
    endif
 endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to read a modified stress report file and implement changes
define method .readdata(!filename is STRING)


    !this.reports.clear()
    -- open file
    !this.file = object file(!filename)
    !lines = !this.file.readfile()
    !supports = ARRAY()
    -- read lines
    do !line values !lines
      -- filter out lines containing supports only
      if !line.match('SUP|').eq(1) then
        !rep = object mdstraysupreport(!line)
        if !rep.modified then
            !this.reports.append(!rep)
        endif
      endif
    enddo


    -- list the affected supports
    -- list them on the form
    -- write the changes back to the database
    !dtext = ARRAY()
    if !this.reports.size().gt(0) then
       do !x values !this.reports
          !x.applymods()
          !dtext.append(!x.supportnumber & ' Modified')
       enddo
       !this.supportlist.dtext = !dtext
    else
      !this.supportlist.clear()
    endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .select(!type is STRING)

 if !type eq 'all' then
    do !a from 1 to !this.supportlist.dtext.size()
      !select[!a] = !a
    enddo
    !this.supportlist.val = !select
 else
    !this.supportlist.clearSelection()
 endif

endmethod
--------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      setFile
--
-- Description: Set the Filename Gadget and Access Mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN    Validated write mode
--
---------------------------------------------------------------------------------

define method .setFile() is BOOLEAN

  if (!this.filename.val.length() eq 0) then
    !!messageFile.warning(146,028)
    !returnValue = false
    return !returnValue
  endif
  !fileTypeSele = !this.fileType.selection()
  !inputFile = !!file(!this.filename.val)
  !inputFile.open(!fileTypeSele)
  !this.currentmode = !fileTypeSele
  !labelCounter = !inputFile.size()
  -- if option is new file then WRITE must be ''
  if (!inputFile.accessMode() eq 'WRITE') then
    !inputFile.close()
    !inputFile.deleteFile()
    !fileTypeSele = ''
    !this.fileType.select('APPEND')
  elseif (!inputFile.accessMode() eq 'OVERWRITE') then
    !inputFile.close()
    !fileTypeSele = 'OVERWRITE'
    !this.fileType.select('APPEND')
  else
    -- must be file access mode must be append
    !inputFile.close()
    !fileTypeSele = 'APPEND'
    !this.fileType.select('APPEND')
  endif

  ALPHA FILE /$!this.filename.val $!fileTypeSele
    handle (61,273)
      -- Trying to open a new file that already exists
      !!alert.message(!!error.text )
      !returnValue = false
      return !returnValue
    endhandle


  !returnValue = TRUE
  !this.file = !inputfile
  return !returnValue

endmethod
-- End of method definition for .setFile() BOOLEAN



--------------------------------------------------------------------------------
define method .dismiss()



endmethod
--------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      ifScreen
--
-- Description: Maintain the Screen or File Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ifScreen()

  if !this.fileOrTer.selection().eq('SCREEN') then
    !this.fileType.active = false
    !this.filename.active = false
  else
    !this.fileType.active = true
    !this.filename.active = true
  endif

endmethod
-- End of method definition for .ifScreen()

------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      inout
--
-- Description: Maintain the Screen for input or output
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .inout()

  if (!this.InOrOut.selection() eq 'OUTPUT') then
    !this.fileType.active  = TRUE
    !this.filename.active  = TRUE
    !this.report.active    = TRUE
    !this.readfile.active  = FALSE
    !this.report.active    = TRUE
    !this.fileorter.active = TRUE
    !this.heading.active   = TRUE
  else
    !this.fileType.active  = FALSE
    !this.filename.active  = TRUE
    !this.report.active    = FALSE
    !this.readfile.active  = TRUE
    !this.report.active    = FALSE
    !this.fileorter.active = FALSE
    !this.heading.active   = FALSE
  endif

endmethod
-- End of method definition for .ifScreen()

------------------------------------------------------------------------



