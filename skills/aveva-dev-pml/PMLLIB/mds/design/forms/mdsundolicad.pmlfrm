--
-- File:    mdsundolicad.pmlfrm
--   Type:    Form Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    r.martin
-- Created:   August 2008
--
--
-- Description:
-- stores the hanger definition in its unmodified state so that it can be reinstated if there is an error
-- when running the licad interface.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  restoreHanger(BOOLEAN)           -
--

-- Kill existing form definition
Kill !!mdsundolicad

-- Define Form
setup form !!mdsundolicad at xr0 yr0 noquit

    !this.formtitle    = ||
    !this.icontitle    = ||
    !this.callback     = ||
    !this.formrevision = | $Revision: 1.0 $ |

  -- Form Members
  -- Support object
  member .support     is MDSINTERFACESUPPORT

  -- Support object
  member .oldSupport     is MDSINTERFACESUPPORT

  -- Form Storage for support restoration
  member .store       is ARRAY

exit

define method .restoreHanger(!showConfirm is BOOLEAN)

  if(define(!!mdsdebug)) then
    !!mdsdebug.traceIn(1, '$!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  --!usrSuppName = !this.support.rest.attaRef.name

  -- Test Decision
  if(!showConfirm) then
    if (!!alert.confirm(|An interface error has been encountered, do you wish to reset the support to a state prior to modification?|) eq 'NO')then
      !!kRestoreUnits(!currentunits)
      if(define(!!mdsdebug)) then
        !!mdsdebug.traceOut(1, 'No Restore in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
      endif
      return
    endif
  endif

  -- Saves the current support object before the restore state function overrides the support object with the oldsupport object
  !tempSupport = !this.support

  !!mdsRestorehangerstate(!this)

  -- Does datum exist yet?
  if (!this.support.datum.unset()) then
    !!alert.message('Unable to restore hanger as no atta have been created')
     !!kRestoreUnits(!currentunits)
     if(define(!!mdsdebug)) then
      !!mdsdebug.traceError('Unable to restore hanger (No Atta) in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
     endif
    return
  elseif (!this.support.rest.ref.unset()) then
    !!alert.message('Unable to restore hanger. Reference to Original restraint is unset')
     !!kRestoreUnits(!currentunits)
     if(define(!!mdsdebug)) then
      !!mdsdebug.traceError('Unable to restore hanger. Reference to Original restraint is unset in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
     endif
    return
  endif

  !support = !this.support
  !datum = !support.datum
  !attaname = !datum.name
  !unusedhang = !datum.cref
    handle any
      !!alert.message('Unable to restore hanger as there is no hanger connected to the atta')
      !!kRestoreUnits(!currentunits)
      if(define(!!mdsdebug)) then
      !!mdsdebug.traceError('Unable to restore hanger (No Hanger) in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
      endif
      return
    endhandle

    !here = !!ce

-- Put back the original tail position
    $!attaname/H1
      handle NONE
        tpos $!this.support.tposition
        handle ANY
        endhandle
      elsehandle ANY
      endhandle

    -- Put back atta if ot has been moved by slope
    $!attaname
      handle NONE
        thro ph of cref
      elsehandle ANY
      endhandle

    !!ce = !here

  !support.rest.reconnected = false

  if(!tempSupport.rest.ref eq !support.rest.ref) then
    -- There is no temporary restr
    -- do nothing
    golabel /exit
  else
    -- There is a temporary rest
    -- we need to delete its fittings
    do !hangerNo indices !tempSupport.rest.hangers
      !oTempHang = !tempSupport.rest.hangers[!hangerNo]
      !oFitt = !oTempHang.fitt
      if(!oFitt.set()) then
        if(!oFitt.ref.set() and (not !oFitt.ref.badref()))then
          if(!oFitt.ref.type.eq('FITT')) then
            -- check if this fitting is not used by the original rest
            !flag = !support.rest.hangers[!hangerNo].fitt.set() and  !oFitt.ref.set() and (!support.rest.hangers[!hangerNo].fitt.ref neq !oFitt.ref)
              handle any
                skip
              endhandle
            if(!flag) then
              -- original rest is pointing to another fitting
              -- we can delete the temporary rest's fitting
              !!ce = !oFitt.ref
              !fittName = !!ce.name
              delete fitt
              if(define(!!mdsdebug)) then
                !!mdsdebug.trace(2, 'Deleted fitting $!fittName')
              endif
            endif
          endif
        endif
      endif
    enddo
-- we need to delete the curr modified rest
  !oTempRest = !tempSupport.rest
  !!ce = !oTempRest.ref
  delete restr


-- delete the temporary rest
  $!attaname$n/REST/TEMP
    handle any
-- no Temporary temp
    elsehandle none
      delete rest
    endhandle

  !oOrigRest = !support.rest
  !!ce = !oOrigRest.ref
    handle any
      !!alert.message('Unable to restore hanger. Reference to Original restraint is unset. Original Rest name is $!attaname/BACKUP ')
      !!kRestoreUnits(!currentunits)
      if(define(!!mdsdebug)) then
        !!mdsdebug.traceError('Unable to restore hanger. Reference to Original restraint is unset in $!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
      endif
      return
    elsehandle none
      ren all $!attaname/BACKUP $!attaname
      name $!attaname$n/REST
    endhandle

    if(!oOrigRest.set() and !oOrigRest.new.set() and !oOrigRest.new and !hideForm) then
        -- newly created rest
        -- delete it
        !this.cancelHanger(false)
      else
        if(!this.graphicalDim)then
          -- update the dimensions to the restored position
          !!mdsSetDim(!this)
          !!mdsSetDim(!this)
        endif
      endif
      if(define(!!mdsdebug)) then
        !!mdsdebug.trace(2, 'Deleted Restraint: $!attaname$n/REST and renamed $!attaname$n/REST/BACKUP to $!attaname$n/REST')
      endif
      -- Add the restr to the drawing list
      add ce
    endif

label /exit

  -- Clear form gadgets
  --  Call !!mdsClearGadgets(!this)
  -- Reactivate cancel button on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.cancel.active = true
  endif

  !!ce = !datum
    handle any
    endhandle

  if(!hideForm) then
    -- Hide the dimensions
    !!mdsClearDim()
    -- Hide forms
    if(!!mdsModfh.shown()) then
         !!mdsModfh.cancel()
    endif
    -- Unsetting the oldsupport member variable
    !this.oldSupport = object MDSINTERFACESUPPORT()

    -- Unsetting the support member variable
    !this.support = object MDSINTERFACESUPPORT()


    !this.hide()
  else
    if(undefined(!oOrigRest))then
      -- skipped to /EXIT label
      !oOrigRest = !support.rest
    endif
    -- update the rest object to be for the original rest
    !support = !this.setRestObject()

    !this.support = !support
    !this.support.rest.ref = !oOrigRest.ref
    -- update the rest packs for rotation to be for the original rest
    !this.setSupportPacks()

  endif

  -- If the support is a hanger then reset any values that may have changed and then clear the saved values

  if !attaname.dbref().styp.eq('MH01') then
    !!ce = !attaname.dbref()
    !!mdsSuppData.resetValues()
    same
  endif

  !!kRestoreUnits(!currentunits)
  if(define(!!mdsdebug)) then
    !!mdsdebug.traceOut(1, '$!this' + '.restoreHanger($!showConfirm is BOOLEAN, $!hideForm is BOOLEAN)')
  endif

endmethod
