-- Kill existing form definition
Kill !!MdsViewStds

-- Define Form
Setup Form !!MdsViewStds resize

  !!MdsViewStds.formtitle    = |MDS - Available Standards|
  !!MdsViewStds.icontitle    = ||
  !!MdsViewStds.callback     = ||
  !!MdsViewStds.formrevision = ||

-- Body of Form

  list .standards 'Available standards:' width 100 length 40

-- End form definition
exit

define method .init()

-- Load available standards into form
  !this.loadstandards()

endmethod

------------------------------------------------------------------------
--
-- Method:      loadStandards
--
-- Description: Load standards into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadStandards()

-- Collect all available standards
  var !standards collect all sect with :MdsActive eq TRUE for /MDS/ATTA/DEFAULTS

-- Setup progress increment
  !Increment = 100 / !standards.size()

-- Find Columns
  !MdsCodes = ARRAY()
  !ClientCodes = ARRAY()
  !Desc = ARRAY()
  !Pmat = ARRAY()
  do !Code from 1 to !standards.size()
    !!Fmsys.setprogress(!code * !Increment)
    !name = !standards[$!code].dbref().name + '/GEN'
    !sect = !standards[$!code].dbref().name
    !zeroline = !standards[$!code].dbref().name + '/0'
-- MDS Code
    var !coll coll all data with dkey eq 'CODE' for $!name
    !Text = pprop of $!Coll[1]
    !TextS = !text.after(|'|).before(|'|)
    !MdsCodes.append(!texts)
-- Client code
    var !coll coll all data with dkey eq 'CCOD' for $!name
    !Text = pprop of $!Coll[1]
    !TextS = !text.after(|'|).before(|'|)
    !ClientCodes.append(!texts)
-- Description
    var !coll coll all data with dkey eq 'DESC' for $!name
    !Text = pprop of $!Coll[1]
    !TextS = !text.after(|'|).before(|'|)
    !Desc.append(!texts)
-- Material Code
    var !coll coll all data with dkey eq 'PMAT' for $!zeroline
      handle ANY
      	!Pmat.append('---')
      elsehandle NONE
        !Text = pprop of $!Coll[1]
        !TextS = !text.after(|'|).before(|'|)
        !Pmat.append(!texts)
      endhandle
  enddo

  !!Fmsys.setprogress(0)

-- Set Headings

  !headings = ARRAY()
  !headings.append('MDS Name')
  !headings.append('Client Name')
  !headings.append('Description')
  !headings.append('Pipe Material')


  !column[1] = !MDSCodes
  !column[2] = !ClientCodes
  !column[3] = !Desc
  !column[4] = !Pmat

  !dtext = ARRAY()

  !this.standards.setheadings ( !headings )
  !this.standards.setcolumns ( !column )
  -- !this.standards.dtext[2] = !column2
  -- !dtext.appendarray(!column2)
  --do !count from 1 to !standards.size()
    --!dtext.append(!column1[$!count] + ',' + !column2[$!count])
  --enddo

  -- !this.standards.dtext = !dtext

-- Show form
  show !!mdsviewstds

endmethod


return
