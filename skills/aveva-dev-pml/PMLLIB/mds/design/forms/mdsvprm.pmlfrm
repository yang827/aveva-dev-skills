--
-- File:		MdsVprm.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon March 22
--
--
-- Description:
-- Form Definition for MDS / Vprm Interface
-- User Defined Part Number File Creation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  init()                           -
--

-- Kill existing form definition
Kill !!MdsVprm

-- Define Form
setup form  !!MdsVprm

  !!MdsVprm.formtitle    = |MDS/VPRM User Defined Part Number Transfer|
  !!MdsVprm.icontitle    = ||
  !!MdsVprm.Callback     = ||
  !!MdsVprm.formrevision = ||

  option .Steelwork  'Steelwork Specification    '   at x0 y1 width 20

  option .Hangers    'Hanger Specification       '      at x0 ymax width 20

-- Bottom Line
  button .Cancel  | Dismiss | at xmax form-size ymax+0.5 CANCEL
  button .Ok      | Apply |   at x0 ymin call |!this.Create()|

-- Form Members

-- Descriptions file
  member .Descriptions is file

-- Dimensions file
  member .Dimensions is file

-- Steelwork Spec
  member .SteelSpecs is STRING

-- Hanger Specification
  member .HangerSpecs is STRING

-- End form definition
exit

define method .create()

-- Read description file
  !DescFile = !!ReadPdmsFile('/' + !this.descriptions.string())

-- Make all the standards required from the desc file unique
-- Remove all lines starting with the following

  do !RemoveMDS from 1 to !DescFile.size()
    if !DescFile[$!RemoveMDS].match('MDS').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('VH').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('FH').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('SPECIAL').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('TT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('MPU').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('FT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('VT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('CT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('DT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('PIPE-REST').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('RACK-REST').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('HT').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('SP').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('CA').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    elseif !DescFile[$!RemoveMDS].match('PR').eq(1) then
      !DescFile[$!RemoveMDS].delete()
    endif
  enddo

  !DescFile.Compress()


-- Open dimensions file
  !DimsFile = !!ReadPdmsFile('/' + !this.dimensions.string())

-- Open output file

  !OutputFile = object file()
  !OutputFile.file('C:\temp\mds-vprm.dat')
  !Delimiter = '^'
  !HeaderLine = '$B$!Delimiter'
  !LinesOfFile = ARRAY()
  !LinesOfFile.Append(!HeaderLine)

  var !ProjCode proj code

  do !LinesOfDescFile values !DescFile

-- Extract wanted data from desc file
    !SplitDescLine = !LinesOfDescFile.split('\')
    !MdsCode = !SplitDescLine[1].trim()
    !ClientCode = !SplitDescLine[2].trim()
    !Description = !SplitDescLine[3].after('-').trim()

-- Loop through values found in desc file to get bore specific lines
    do !GetBores values !DimsFile
      if !GetBores.match(!MdSCode).eq(1) then
        if !GetBores.matchwild('*VENDOR*') then
          skip
        endif
        !SplitDimLine = !GetBores.split(' ')
        do !Remove from 1 to !SplitDimLine.size()
          if !SplitDimLine[$!Remove].eq('') then
            !SplitDimLine[$!Remove].delete()
          endif
        enddo
        !SplitDimLine.compress()
        !Bore = !SplitDimLine[3]
        if !Bore.eq('0') then
          skip
        endif
        !SplitDim = !GetBores.split('\')
        !Parameters = !SplitDim[5].trim().split(',')
        !FromCounter = 1
        !ToCounter = 1
        do !Par values !Parameters
          !TempMinMax = !SplitDim[2].trim().split(' ')
          do !Loop from 1 to !TempMinMax.size()
            !MinMax = !TempMinMax[$!Loop].split(',')
            if !Par.eq(!MinMax[1]) then
              !From[!FromCounter] = !MinMax[3]
              !To[!ToCounter] = !MinMax[2]
              !FromCounter = !FromCounter + 1
              !ToCounter = !ToCounter + 1
            endif
          enddo
        enddo

        do !printa from !to[1].real() to !from[1].real()
          do !printb from !to[2].real() to !from[2].real()
            !PartA = '$!ProjCode$n-$!ClientCode$n-$!Bore-$!PrintA-$!PrintB'
            !PartB = (!Delimiter + 'Y' + !Delimiter + 'off' + !Delimiter + 'I' + !Delimiter + 'ZZ' + !Delimiter + 'ZZ' + !Delimiter + 'ZZ' + !Delimiter + !Delimiter + !Description )
            !LinesOfFile.Append(!PartA + !PartB)
          enddo
        enddo

      endif
      if !Getbores.matchwild('*AT02*') then
        break
      endif
    enddo

-- Write lines to file

  enddo

  !Outputfile.writefile('OVERWRITE',!LinesOfFile)

endmethod

define method .init()

-- Set desc/dims file pointers
  !this.Descriptions = !!MdsFiles.description
  !this.dimensions   = !!MdsFiles.dimension

-- Collect all available steelwork specs
  var !SteelSpecs coll all spec with purpose eq 'STL'
  var !Steelname eval name for all from !SteelSpecs

  !this.steelwork.dtext = !Steelname
  !this.steelwork.rtext = !Steelspecs

-- Collect all available steelwork specs
  var !HangerSpecs coll all spec with purpose eq 'HANG'
  var !Hangername eval name for all from !HangerSpecs

  !this.Hangers.dtext = !Hangername
  !this.Hangers.rtext = !Hangerspecs

-- Finally show form

  !this.show()

endmethod
