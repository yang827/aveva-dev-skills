--
-- Description:
-- Function to return PDMS is 11.6 or PDMS is version 12
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!IsPDMS116() is BOOLEAN

  !Banner = banner

--<wd>aug2006<mds12> -- Check NOW the PDMS MODULE BANNER for VERSION 12 as well!!!--
  --if !Banner.short.match('11.6').gt(0) then
  if ( (!banner.short.match('11.6').gt(0)) or  (!banner.short.match('12.').gt(0)) ) then
--<wd>aug2006<mds12>
    return TRUE
  else
    return FALSE
  endif

endfunction
-- End function

-- End of file IsPDMS116.pmlfnc
