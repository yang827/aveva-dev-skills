--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Mon 11th November 2002
--
--
-- Description:
-- Function to delete a support from 3Dmm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mds3dmmDelete(!Support is STRING) is REAL

-- If the MDS application has not been entered then reject the request to delete a support.

  if undefined(!!MDSIdSatt) then
    !!Error.text = 'Unable to delete support $!Support as the MDS application has not been entered'
    return 0
  endif

  !!MdsSilent = true

-- Set the value of the support name in delete master delete form
-- Check if the mds application has been loaded and if not load the mdsdeletesupp form

  !!MdsDeleteSupp.name.val = !Support
    handle (2,765)
      pml load form !!MdsDeleteSupp
      !!MdsDeleteSupp.name.val = !Support
    endhandle
  !return = !!MdsSelectSupp('DELETE','NAME','BRIEF')

  if !return.eq(1) then
    !!MdsDeleteSupp(!!MdsDeleteSupp,'BRIEF')
  endif

  !!MdsSilent.delete()

  Return $!Return

-- End function
endfunction

-- End of file Mds3dmmDelete.pml
