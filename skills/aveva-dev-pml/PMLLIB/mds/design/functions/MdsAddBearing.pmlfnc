--
-- File:                MdsAddBearing.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              Neale Morris
-- Created:             Fir 25th June
--
-- Description:
-- function to create a bearing plate if required
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsAddBearing(!datum is DBREF)

  var !sctns coll all sctn for ce

  !hereIAm = !!ce

  !desc = desc of /MDS/TEMPLATES
  if !desc.eq('Framatome Templates') then
    do !loop values !sctns
      !!ce = !loop.dbref()
      !mdsAttaRef = :MdsAttaRef
      do !loop1 values !mdsAttaRef
        !!ce = !loop1
        !!mdsCreatePlate.silentBearing(!!ce,!loop.dbref())
      enddo
    enddo

-- Move cross bar sections that have bearing plate on them only once

    !!ce = !hereIAm

    stru
    var !sctns coll all sctn for ce
-- If called from the add bar macro we only need to adjust the last bar
    if defined(!!mdsBarOnly) then
      !sctns = !sctns.invert()
    endif
    do !mdsAttaRefs values !sctns
      !bearingPlates = ARRAY()
      !!ce = !mdsAttaRefs.dbref()
      !mdsAttaRef = :MdsAttaRef
      do !coll values !mdsAttaRef
        if !coll.:MdsPlate.badref().not() then
          !bearingPlates.append(!coll.:MdsPlate)
          !zlen = !coll.:MdsPlate.prop.zlen
        endif
      enddo
      if !bearingPlates.size().neq(0) then
        !!ce = !mdsAttaRefs.dbref()
        !p9dir = p9 dir of $!datum wrt /*

        move $!p9dir dist $!zlen
-- On certain templates we also need to adjust the V1 member
-- These are FT03/FT04
        !supportName = !datum.name.before('/DATUM')
        if !supportName.dbref().type.eq('STRU') then
          if !supportName.dbref().:MdsSupptype.eq('FT03') then
            !!ce = $!supportName-V1
              handle NONE
-- If the padir of the support object is U or down then we need to move the whole sctn the p9dir
              if !!mdsFt03.support.padir.string().eq('U WRT /*') or !!mdsFt03.support.padir.string().eq('D WRT /*') or !!mdsFt03.support.padir.string().eq('Z WRT /*') or !!mdsFt03.support.padir.string().eq('-Z WRT /*') then
                move $!p9dir dist $!zlen
                else
                  extend start -$!zlen
                endif
                same
              elsehandle ANY
              endhandle
          elseif !supportName.dbref().:MdsSupptype.eq('FT04') then
            !!ce = $!supportName-V1
              handle NONE
-- If the padir of the support object is U or down then we need to move the whole sctn the p9dir
              if !!mdsFt04.support.padir.string().eq('U WRT /*') or !!mdsFt04.support.padir.string().eq('D WRT /*') or !!mdsFt04.support.padir.string().eq('Z WRT /*') or !!mdsFt04.support.padir.string().eq('-Z WRT /*') then
                move $!p9dir dist $!zlen
                else
                  extend start $!zlen
                endif
                same
              elsehandle ANY
              endhandle
          elseif !supportName.dbref().:MdsSupptype.eq('FT17') then
            !!ce = $!supportName-V1
              handle NONE
                extend end -$!zlen
                same
              elsehandle ANY
              endhandle
          endif
        endif
-- Because we have moved the bars end plates we need to set the delp back to n0e0u0
        var !pjoi coll all pjoi for $!supportName
        !iAmHere = !!ce
        do !resetDelp values !pjoi
          !!ce = !resetDelp.dbref()
          delp n0e0u0
        enddo
        !!ce = !iAmHere
      endif
      if defined(!!mdsBarOnly) then
        break
      endif

      !ce = !!ce

-- Put plate directly onto sctn

      !!ce = !mdsAttaRefs.dbref()
      if !!ce.:mdsattaref.size().neq(0) then
        !poss = poss
        !pose = pose
        pin 9 at $!poss
        pin 8 at $!pose
        pin 9 dir from pin 9 to pin 8
        pin 8 dir from pin 8 to pin 9
        pin 9 plane pin 9 thro $!datum
        pin 8 at $!datum
        pin 9 dir from pin 9 to pin 8
        var !moveDir pin 9 dir wrt /*
        !sctn = !!ce
        do !loopThroughAttas values !mdsAttaRef
          !!ce = !loopThroughAttas

--<wd>13aug2004
-- Skip ATTA if the uda :MdsPlate is a bad/unset reference
          skip if (!loopThroughAttas.:mdsplate.badref())
--<wd>13aug2004

          goto :MdsPlate
          !!mdsResetPins(8,9)
          pnod
          move $!moveDir wrt /* clear 0 beh $!sctn
        enddo
      endif

      !!mdsResetPins(8,9)
      !!ce = !ce

    enddo

  endif

endfunction
