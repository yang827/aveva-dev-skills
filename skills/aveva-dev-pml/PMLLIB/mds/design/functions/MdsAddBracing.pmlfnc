--
-- File:		MdsAddBracing.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Monday 2nd December 2002
--
--
-- Description:
-- Function to create a bracing section. This uses the bracing configurations
-- form from the steelwkr application. it back fills the form for use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddBracing(!Form is form)

-- Force into forwards mode
  FORWARDS

-- Setup the !!CDBRACING form with support data

  !Frmw = !Form.Support.stru.name + '/MAIN'
  if (undefined(!!cdbracing)) then
    $M/%PDMSUI%/DES/STLWRK/FBRACING
    $M/%PDMSUI%/DES/STLWRK/IBRACING
    $M/%PDMSUI%/DES/STLWRK/FBRACDATA
    $M/%PDMSUI%/DES/STLWRK/FBRACIN2
    $M/%PDMSUI%/DES/STLWRK/FSREFTOL
    pml load form !!KgphAlign
    show !!cdbracing
    hide !!cdbracing
  endif

  !!cdbracing.store.val = !Frmw
     handle any
       !!Alert.error('Support framework does not exists!. Unable to add bracing')
     endhandle

-- Define the bracing the same as a previously created brace or as per V1 and if not exist BAR-1

  !DefinedBrace = !Form.Support.stru.name + '-BRACE1'
  !Vertical     = !Form.Support.stru.name + '-V1'
  !Bar          = !Form.Support.stru.name + '-BAR-1'

  !Spref = !DefinedBrace.dbref().spref
    handle any
      !Spref = !Vertical.dbref().spref
        handle any
          !Spref = !Bar.dbref().spref
        elsehandle none
        endhandle
    elsehandle none
    endhandle

  !list = Array()
  !list.append('NA')

  !!cdbracing.spre.val = !Spref.name
  !!cdbracing.jlin.dtext = !List
  !!cdbracing.just.dtext = !List
  !!cdbracing.meml.dtext = !List

-- Find knee brace option

  !FindKnee = !!cdbracing.type.dtext.find(' 8.  Knee Bracing(2)               ')
  !!cdbracing.type.val = !FindKnee[1]

-- Set the callback on the bracing form to name the bracing created

  $m/%PDMSUI%/DES/STLWRK/MBRACING
  !!CdBracin2.Dismiss.callback = '!!MdsNameBrace(!!$!Form)'

endfunction

-- End of file MdsAddBracing.pml
