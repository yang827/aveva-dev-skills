--
-- File:    MdsAddFrRack.pmlfnc
-- Type:    Function Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  design
--
-- Author:  T.martin
-- Created: Thu Mar 08
--
--
-- Description:
-- function to add rack support to FR framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsaddfrrack(!form is FORM)

  -- Initialise variables
  !datum = !form.support.datum
  !stru  = !form.support.stru
  !name  = !stru.name

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
  if (!form.support.position.not())then
    !!alert.message('Position atta before adding Rack')
      return
    endif

    label /label

  -- Select tube
  if (!!mdsIdTube('FTUB', 'Identify straight of RACK to support','TRAY').not())then
      return
    endif

  !write = STRING()
  !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the RACK
      if (!write.eq('R')) then
        !!alert.error('The Identified RACK is in a READ ONLY Database. Select another RACK.')
        golabel /label
        return
-- WRITE Access to the RACK, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified RACK is LOCKED. Select another RACK.')
        golabel /label
        return
      endif
    endif

    !name   = !form.support.stru.name
    !picked = !!ce
    if (!picked eq !form.support.datum)then
      !!alert.message('Datum Rack cannot be selected')
      golabel /label
    elseif (!picked.name.eq(!name & '/SREF')) then
      !!alert.message('Datum Rack cannot be selected')
      golabel /label
    elseif (!form.support.datum.owner.eq(!picked)) then
        !!alert.message('Datum Rack cannot be selected')
        golabel /label
    elseif (!form.support.datum.owner.eq(!picked.owner)) then
        !!alert.message('Datum Rack cannot be selected')
        golabel /label
    endif

-- Check that an atta for this element doesn't already exist

  if (!!mdsCheckAtta(!form))then
    if (!!alert.confirm('This Rack is already being supported on $!<form.name.val>. Ok to continue') eq 'NO')then
        return
      endif
    endif

-- Check if Selected Rack is in the same ORI (Horizontal or Vertical Pipe) as the Datum Atta.

    !currcomp = !!ce

    !!ce = !datum
    !datpldir = pl dir wrt world
    !datpadir = pa dir wrt world

    !!ce = !currcomp


    !cepldir  = pl dir wrt world
    handle (61,2) (2,201) (2,252)
      !cepldir = ph dir wrt world
    endhandle

    if (!datpldir.up.abs() neq 1) then
--  Datum Pipe is Horizontal.

--  Now Check if Selected Rack is Horizontal or Vertical
      if (!cepldir eq u or !cepldir eq d) then
-- Selected Rack is Vertical
        !!alert.message ('Unable to Mix Horizontal and Vertical rack on the same Framework')
        !!ce = !currcomp
        return
      else
--  Selected Rack is Horizontal so Check if it is within the Allowable Slope
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsOptions.slope.val)')
          !!ce = !currcomp
          return
        endif
      endif

    else
--  Datum Pipe is Vertical
      if (!cepldir.up.abs() neq !datpldir.up.abs() or !cepldir.up.abs() neq !datpadir.up.abs()) then
-- Selected Pipe is Horizontal
      !!alert.error  ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!ce = !currcomp
        return
      endif
    endif
  if !form neq !!mdsFR09 and !form neq !!mdsFR10 and !form neq !!mdsFR11 and !form neq !!mdsFR16 and !form neq !!mdsFR14 and !form neq !!mdsFR15 then
      !sctnname = !form.support.stru.name & '-V1'
      !sctn = !sctnname.dbref()
      -- create the support stack before creating the atta
    !form.support.stack = object MDSLEVELSTACK(!sctn,!form)
    else
      !sctnname = !form.support.stru.name & '-BAR-1'
      !sctn = !sctnname.dbref()
    endif
-- Add rack to support
-- this goes and creates the atta

  if (!!mdsRack(!form , !name).not())then
      return
    endif
  !newAtta = !!ce
    spkbrk $!form.sspkbrk
    handle ANY
    endhandle


       FCONN AND P30 IS P30 OF PREV
  handle ANY
         fconn
         ori and p9 is $!form.support.p9dir
       endhandle
       !ldir = !!ce.ldir

  if !form neq !!mdsFR10 and !form neq !!mdsFR11 and !form neq !!mdsFR09 and !form neq !!mdsFR16 and !form neq !!mdsFR14 and !form neq !!mdsFR15 then
          !ldir.up = 0
       endif
       plane $!ldir THRO $!sctn
   -- endif

   -- plane PL THRO $!sctn
  !attaName = !!ce.name
    !atta = !!ce

  if !form neq !!mdsFR09 and !form neq !!mdsFR10 and !form neq !!mdsFR11 and !form neq !!mdsFR16 and !form neq !!mdsFR14 and !form neq !!mdsFR15 then
    -- check that the proposed joint does not clash with any of the others
    !obj = object MDSPLINES(!sctn,!newAtta)
    !len = !obj.getbarlength(!newAtta)
       if !len.gt(915) then
           !!alert.error('Proposed Support Beam length ($!len) is longer than maximum allowed (915) - Atta Deleted')
      !form.support.bars[1].deletefrom(!form.support.bars[1].size())
      !form.support.atta.deletefrom(!form.support.atta.findfirst(!atta))
           delete atta
           return
       endif
       !test = !obj.clashcheck(!sctn,!atta)
       if !test.eq(1) then   $* it clashes
           !!alert.error('Proposed Support Beam Clashes with Existing Joint - Atta Deleted')
         -- option to override the clash removed TM 10-12-03
         -- if  !!alert.confirm('Proposed Support Beam Clashes with Existing Joint - Do You Want to Override?')  neq 'YES' then
      !form.support.bars[1].deletefrom(!form.support.bars[1].size())
      !form.support.atta.deletefrom(!form.support.atta.findfirst(!atta))
           delete atta
           return
         -- endif
       endif

       -- test if the new atta exceeds a level
    if !form.support.stack.testitem(!newAtta).not() then $* the atta exceeds the levels
          -- delete the atta
      !form.support.atta.deletefrom(!form.support.atta.findfirst(!atta))
      !form.support.bars[1].deletefrom(!form.support.bars[1].size())
          delete atta
          return
       endif
    endif
  -- Add aid text to rack

  !!ce = !newAtta
    !pos = pos wrt /*
  !tName = after(!!ce.name, '.')
  !num = (210 + !tName.real())
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!num $!tName $<$!pos$>

    -- Add atta to cross-bar 1
  !newAtta = !!ce
  !list = !form.support.bars[1]
  !references = ''
  do !i indices !list
      if !list[!i].badref() then
        skip
      endif
    !references = !references & ' ' & !list[!i].string()
    enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  handle ANY
  elsehandle NONE
    :MDSAttaRef $!references !newAtta.string()
        same
      endhandle

  -- Store representation level in form so that it can be reset later
  !colour = !!kFindDrawColour(!!ce)
  !ceName = !!ce.string()
  !form.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance atta using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!attaName.dbref())
  call !!kEnhanceList(!colourList)

    refresh

endfunction
