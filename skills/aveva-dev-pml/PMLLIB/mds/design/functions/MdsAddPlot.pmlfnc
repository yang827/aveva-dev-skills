--
-- File:		Mdsaddplot.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSHOWPLOT
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- show plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          GADGET     Gadget identifying support number to be shown
--     2     R          STRING     Text to determine if form should be shown
--                                 'Show' will activate the form.
--     3     R          FORM       Form name to get selection from.
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddPlot(!Gadget is GADGET, !String is STRING, !Form is FORM)

  -- Initialise variables
  if (!String.upcase() eq 'SHOW')then
    !Show = True
  else
    !Show = False
  endif

  -- Store Current Support Form name and required function in Main form for use later

  !!MdsSetSupp(!Form)

  !ProjectStand = !Gadget.Dtext[!Gadget.Val]
  !ProjectStandard = !ProjectStand.before(' ')

  -- If the standard is a VH* ot FH* then use VH01 as the standard

  if !Gadget.Rtext[!Gadget.Val].match('FH').gt(0) then
    !StandardName = 'VH01'
  elseif !Gadget.Rtext[!Gadget.Val].match('VH').gt(0) then
-->>-<wd>july2003
-- Code modified to suit above statement and now finds the plot files OK
    --!StandardName = 'FH01'
    !StandardName = 'VH01'
--<<-<wd>july2003
  elseif !Gadget.Rtext[!Gadget.Val].match('PIPE-REST').gt(0) then
    !StandardName = 'RT01'
  elseif !Gadget.Rtext[!Gadget.Val].match('PIPE-REST-INLINE').gt(0) then
    !StandardName = 'RT02'
  elseif !Gadget.Rtext[!Gadget.Val].match('RACK-REST').gt(0) then
    !StandardName = 'CA01'
  else
    !StandardName = !Gadget.Rtext[!Gadget.Val]
  endif
  if(!StandardName eq 'FH01' and (not !!mdsfh01.ListofPlotfiles.empty())) then
    -- Retrieves the previously saved list
    !ListofPlotfiles = !!mdsfh01.ListofPlotfiles
    -- skip the regeneration of the list
    golabel /HANGERSAPP
  endif

-- Create an array of all the plotfiles associated with the standard

  !listofplotfiles = !!mdsgetplot(!Standardname)

  if !Listofplotfiles.size().eq(0) then
    !!Alert.Warning(|Cannot access plotfile for reading?|)
    return
  endif

  edit !!MdsShowPlot.Plot PLOT
    add /$!Listofplotfiles[1]
      handle (61,251)
        !!Alert.Warning(|Cannot access plotfile for reading?|)
        return
      endhandle
  exit

  if !ListOfPlotfiles.size().eq(1) then
    !!Mdsshowplot.prev.active = false
    !!Mdsshowplot.next.active = false
  else
    !!Mdsshowplot.prev.active = false
    !!Mdsshowplot.next.active = true
  endif
  if(!StandardName eq 'FH01') then
    -- Saves the plotfile list to avoid regenerating it next time
    !!mdsfh01.ListofPlotfiles = !ListofPlotfiles
  endif

  label /HANGERSAPP

  !Listofplotfiles = !!Mdsgetplot(!StandardName)

  !!Mdsshowplot.plots.clear()
  !!Mdsshowplot.plots.append(!ListofPlotfiles)
  !!Mdsshowplot.sheet = 1
  !Sheets = !ListOfPlotFiles.size()

  edit !!MdsShowPlot.Plot PLOT
    add /$!Listofplotfiles[1]
      handle (61,251)
        !!Alert.Warning(|Cannot access plotfile for reading?|)
        return
      endhandle
  exit

  !!Mdsshowplot.sheets.val = 'Displaying Sheet $!!Mdsshowplot.sheet of $!Sheets'

  -- Modify project support type para gadget

  !!Mdsshowplot.projtype.val = 'Project Standard = $!ProjectStandard'

  -- Display Plotfile form
  if (!Show)then
    call !!KshowForm(!!MdsShowPlot)
  endif

-- End function
endfunction

-- End of file Mdsaddplot.pml

return
