--
--
-- Description:
-- function to modify a pmlfnc and configure layout
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Function Name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAppLayout(!File is STRING)

-- See if we can open the file

  !FullName = !!pml.getpathname(!File)
    handle (44,33)
      !!Alert.error('Cannot file file $!File')
      return
    endhandle

-- OK can we open it

  !OpenFile = object file(!FullName)
  q var !openfile

  !OpenFile.open('WRITE')


-- End function
endfunction

-- End of file MdsAppLayout.pmlfnc
