--
-- File:		MdsCheckAccess.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Thursday 7th August 2003
--
--
-- Description:
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM         FORM  of Current MDS Support
--
-- Return:
--    [Data Type]   [Description]
--     1     R       Is access to all componets of support available
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
--
define function !!mdsCheckAccess(!Form is FORM,!Type is STRING,!DacType is STRING) is BOOLEAN

  !Access = true

  !Atta = !Form.Support.Atta
  !Stru = !Form.Support.Stru

  do !Attas values !Atta

    if !!MdsComClaimDac(!Attas,!Type,!DacType).not() then
      !Access = false
    endif

  enddo

  if !Stru.badref().not() then
    if !!MdsComClaimDac(!Stru,!Type,!DacType).not() then
      !Access = false
    endif
  endif

  if !Access.not() then
    !!Alert.Error('Unable to modify the support as write access to all support elements is not available')
  endif

  return !Access


endfunction
-- End of function
--
-- End of file MdsCheckAccess.pmlfnc
