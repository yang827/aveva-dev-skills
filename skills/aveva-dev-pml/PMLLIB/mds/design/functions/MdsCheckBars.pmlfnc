--
--
-- Description:
--  Function to Check if the selected template can have cross bars created or not
--  Modified by the MDS Application.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        OBJECT       Support Object of the passed support
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      Returns TRUE if a cross bar can be created FALSE if not
--------------------------------------------------------------------------------
--
--Define Function
define function !!mdscheckbars(!SupportObject is MDSSUPPORT) is BOOLEAN

-- Check the :mdsbars attribute stored at the stru level

  !TestForBarCreation = !SupportObject.Stru.:MdsBars

  if !testForBarCreation.not() then
    !!Alert.Error('The selected template cannot have additional cross bars created. Convert to a special to create extra cross bars')
    return FALSE
  else
    return TRUE
  endif

endfunction

-- End of Function Definition for mdscheckbars.pmlfnc
