--
-- Author:		Neale Morris
-- Created:		Tues July 8
--
--
-- Description:
-- Checks to see if there are any gaps in the naming
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       FORM          Form Name
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckGap(!Form is FORM) is boolean

  !return = false

-- Get the number of the last atta
    !List = !Form.Support.Atta
    !List.Invert()

-- The last number must be the length of the array - 2
    if !List[1].name.after('.').real().neq(!List.size() - 2) then
      !return = true
    endif

  return $!return

-- End function

endfunction
-- End of file MdsCheckGap.pmlfnc
return
