--------------------------------------------------------------------------------
--
-- File:    MdsCheckPar.pmlfnc
-- Type:    Function Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  design
-- Replaces:
--
-- Author:  N.morris
-- Created: Thur Sept 18 1997
--
--
-- Description:
-- Function to check a single support atta i.e at01
-- exceeded
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCheckPar(!form is FORM)

-- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

-- Initialise Variables
  !!mdsCheckLen.ok.active = true
  !errors   = 0
  !warnings = 0
  !messages = 0

  !error     = ARRAY()
  !suppattas = !form.support.atta
  do !indx indices !suppattas
  -- Move to support
    !!ce  = !suppattas[!indx]
    !atta = !suppattas[!indx].name
    !!mdsCheckLen.errorList.clear()
    if (!!ce.:MDSBpref1.badref().not()) then
      if (!suppattas[!indx].:MDSSuppType inset ('AT10A','AT10B','AT11A','AT11B','AN01A','AN01B')) then
        pin 9 copy p3 of $!suppattas[$!indx]
      else
        pin 9 copy p9 of $!suppattas[$!indx]
      endif
      pin 8 copy pin 9
      pin 8 plane pin 8 clear 0 inf box 1 of subs 1 of $!!ce.:MDSBpref1
        handle ANY
        pin 8 plane pin 8 clear 0 inf $!!ce.:MDSBpref1
        endhandle
-- Pedestal TRUNNION Point 'P9' does NOT ADJUST with DESPAR NUM 1, hence move PIN9
      -- to the CORRECT Position BEFORE calculating the variable '!dist'
      if (!suppattas[!indx].:MDSSuppType inset ('AT10A','AT10B','AT11A','AT11B','AN01A','AN01B')) then
        pin 9 dist 0 clear 0 beh $!!ce
        !dist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
        pin 8 dir from pin 9 to pin 8
          handle (2,357)
            pin 8 dir pin 9
          endhandle
        var !pin8Dir pin 8 dir wrt world
        var !p9Dir pin 9 dir wrt world
      else
        !dist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
        pin 8 dir from p9 to pin 8
        handle (2,357)
--(2,357)   Undefined direction: the FROM and TO positions are equal
          pin 8 dir pin 9
        endhandle
        var !pin8Dir pin 8 dir wrt world
        var !p9Dir p9 dir wrt world
      endif
-- Omit Hangers 'HT*' - from outputting any Messages re 'Packing Pieces'...
--      if (!suppattas[!indx].:MDSSuppType.matchwild('HT*').not() ) then
-- Omit Springs 'SP*' - from outputting any Messages re 'Packing Pieces'...
      if (!suppattas[!indx].:MDSSuppType.matchwild('HT*').not() and !suppattas[!indx].:MDSSuppType.matchwild('SP*').not()) then
    -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !pin8Dir.direction()
        !direction.directionB = !p9Dir.direction()
        !direction.tolerance  = 0.05
        if (!!kDirEqualDir(!direction).not()) then
          !distreal = !dist - !dist - !dist
--> Anything UNDER -2mm is NOW IGNORED (Default Clearance for CLASHER)
         if (!distreal.lt(-2)) then
            !error.append(||)
            !error.append(|**    Error    ** - Packing distance between ancillary and bedplate is a negative|)
            !error.append(|                  - value, therefore the ancillary is not supported correctly|)
            !error.append(| Atta Name                   = $!atta|)
            !!kFormatText.text.val = !distreal
            !packdist = !distreal.string(!!distancefmt)
            !error.append(| Actual  Distance            = $!packdist|)
            !error.append(|--------------------------------------------------------------------------------|)
            !!mdsCheckLen.ok.active = false
            !errors = !errors + 1
          endif
        else
          !distreal = !dist
--> Anything UNDER 2mm is NOW IGNORED (Default Clearance for CLASHER)
          if (!distreal.gt(2)) then
            if (!distreal gt !!mdsOptions.packing.val) then
              !error.append(||)
              !error.append(|**   Warning   ** - Packing distance between ancillary and bedplate exceeds the|)
              !error.append(|                  - allowable maximum distance|)
              !error.append(| Atta Name                   = $!atta|)
              !!kFormatText.text.val = !distreal
              !packdist = !distreal.string(!!distancefmt)
              !error.append(| Actual  Distance            = $!packdist|)
              !!kFormatText.text.val = !!mdsOptions.packing.val
              !maxpackdist = !!mdsOptions.packing.val.string(!!distancefmt)
              !error.append(| Maximum Distance            = $!maxpackdist|)
              !error.append(|--------------------------------------------------------------------------------|)
              !warnings = !warnings + 1
            else
              !error.append(||)
              !error.append(|**   Message   ** - Packing distance between ancillary and bedplate|)
              !!kFormatText.text.val = !distreal
              !error.append(| Atta Name                   = $!atta|)
              !packdist = !distreal.string(!!distancefmt)
              !error.append(| Distance                    = $!packdist|)
              !error.append(|--------------------------------------------------------------------------------|)
              !messages    = !messages + 1
            endif
--< Anything UNDER 2mm is NOW IGNORED (Default Clearance for CLASHER)
          endif
        endif
-- Omit Springs 'SP*' - from outputting any Messages re 'Packing Pieces'...
-- Omit Hangers 'HT*' - from outputting any Messages re 'Packing Pieces'...
      endif
-- Check to see if support is associated with another bedplate
      !bedPlateRefs1 = !!kCollectAllFor('STRU', '(name of :MDSBpref1 eq |$!atta|)', =0/0 )
      !bedPlateRefs2 = !!kCollectAllFor('STRU', '(name of :MDSBpref2 eq |$!atta|)', =0/0 )
      if (defined(!bedPlateRefs1[2])) then
        !error.append(||)
        !error.append(|**    Error    ** - Support is referenced by more than one bedplate|)
        !error.append(| Atta Name                   = $!atta|)
        do !list values !bedPlateRefs1
          !error.append(| Bedplate Reference          = $!list.name|)
        enddo
        !error.append(|--------------------------------------------------------------------------------|)
        !!mdsCheckLen.ok.active = false
        !errors = !errors + 1
      endif
      if (defined(!bedPlateRefs2[2])) then
        !error.append(||)
        !error.append(|**    Error    ** - Support is referenced by more than one bedplate|)
        !error.append(| Atta Name                   = $!atta|)
        do !list values !bedPlateRefs1
          !error.append(| Bedplate Reference          = $!list.name|)
        enddo
        !error.append(|--------------------------------------------------------------------------------|)
        !!mdsCheckLen.ok.active = false
        !errors = !errors + 1
      endif
    else
-- Bedplate Reference is a 'Badref' or 'Unset' etc...
-- Omit  Lugs 'LT*' - from outputting any messages etc...
-- Omit All Guides 'GT*', Slip-Units 'SU*' - from outputting this Warning.
      if (!suppattas[!indx].:MDSSuppType.matchwild('LT*').not()) then
        if (!suppattas[!indx].:MDSSuppType.matchwild('GT*').not() and !suppattas[!indx].:MDSSuppType.matchwild('SU*').not())then
          --          !error.append(||)
          --          !error.append(|**   Warning   ** - Ancillary is not associated with a bedplate|)
          --          !error.append(| Atta Name                   = $!atta|)
          --          !error.append(|--------------------------------------------------------------------------------|)
          --          !warnings = !warnings + 1
        else
--<wd>feb2003
          skip  if (!suppattas[!indx].:MDSSuppType inset ('GT16','GT17','GT22', 'GT23A', 'GT23B', 'GT24', 'GT40'))
--<wd>feb2003
          if (!suppattas[!indx].:MDSGuideRef.badref() and !suppattas[!indx].:MDSGuideRef.unset()) then
            !error.append(||)
            !error.append(|**   Warning   ** - Ancillary is not associated with a Support|)
            !error.append(| Atta Name                   = $!atta|)
            !error.append(|--------------------------------------------------------------------------------|)
            !warnings = !warnings + 1
          endif

        endif
      endif
    endif
-- Check if SPRING is Floor Mounted ie, STYPE is'SP03E* (C54-E)' or 'SP03F* (C55-F)'
    if (!suppattas[!indx].stype.matchwild('SP03E*') or !suppattas[!indx].stype.matchwild('SP03F*')) then
      if (!suppattas[!indx].:MDSGuideRef.badref() and !suppattas[!indx].:MDSGuideRef.unset()) then
        !error.append(||)
        !error.append(|**   Warning   ** - Ancillary is not associated with a Support|)
        !error.append(| Atta Name                   = $!atta|)
        !error.append(|--------------------------------------------------------------------------------|)
        !warnings = !warnings + 1
      endif
    endif
    --<kp>nov2010
    -- Check if support ST62 is "stuck" to supported PCOM (styp FIPO)
    if !!ce.:mdsSuppType.eq('ST62') then
      !errmess = STRING()
      if !!ce.sequ.gt(1) then
        !pcom = !!ce.owner.memb[!!ce.sequ - 1]
        !dist2prev = !!ce.pos.distance(!pcom.pos)
        if !dist2prev.gt(1mm) then
          !errmess = '**    Error    ** - Ancillary is not attached to previous PCOM (distance = $!dist2prev)'
        endif
      else
        !errmess = '**    Error    ** - Ancillary is not associated with a supported PCOM (stype = FIPO)'
      endif
      if !errmess.set() then
        !error.append('')
        !error.append(!errmess)
        !error.append(' Atta Name                   = $!atta')
        !error.append('--------------------------------------------------------------------------------')
        !errors = !errors + 1
        !!mdsCheckLen.ok.active = false
      endif
    elseif !!ce.:mdsSuppType.eq('AT185') then
      !errmess = STRING()
      !warmess = STRING()
      if !!ce.sequ.gt(1) then
        !valv = !!ce.owner.memb[!!ce.sequ - 1]
        !dist2prev = !!ce.apos.distance(!valv.lpos)
        if !dist2prev.gt(1mm) then
          !errmess = '**    Error    ** - Ancillary is not stuck to previous VALV (distance = $!dist2prev)'
        endif
        !vlen = !valv.apos.distance(!valv.lpos)
        if !!ce.rpro.dimm.lt(!vlen) then
          !warmess = '**   Warning   ** - Support length is shorter than VALV supported'
        endif
      else
        !errmess = '**    Error    ** - Ancillary is not associated with a supported VALV (wafer)'
      endif
      if !errmess.set() then
        !error.append('')
        !error.append(!errmess)
        !error.append(' Atta Name                   = $!atta')
        !error.append('--------------------------------------------------------------------------------')
        !errors = !errors + 1
        !!mdsCheckLen.ok.active = false
      endif
      if !warmess.set() then
        !error.append('')
        !error.append(!warmess)
        !error.append(' Atta Name                   = $!atta')
        !error.append('--------------------------------------------------------------------------------')
        !warnings = !warnings + 1
      endif
    endif
  enddo

  !!mdsCheckLen.summary.val = 'Errors = $!errors,   Warnings = $!warnings,   Messages = $!messages   '

-- Only Add if All 'messages' are equal to 0(zer0)
  if (!errors + !warnings + !messages eq 0) then
    --do !cbar values !suppattas
      --!!ce = !cbar
      --!memname = !!ce.name
      --!error.append(||)
      --!error.append(|**   Message   ** - No problems with this Support Ancillary|)
      --!error.append(|Atta Name                     = $!memname|)
      --!error.append(|--------------------------------------------------------------------------------|)
    --enddo
  else
-- Output Data for Support Sections with NO Problems, BUT Only if NO Other Errors/Warnings/Messages exist
    do !cbar values !suppattas
      !sctnmess = false
      !!ce = !cbar
      skip if (!form.string() inset('MdsVT01','MdsVT02','MdsVT03','MdsVT04','MdsTT01','MdsTT02','MdsTT03'))
      !memname = !!ce.name

      do !xerr values !error
        if (!xerr.string().match('Atta Name').gt(0) and !xerr.string().match(!memname).gt(0)) then
-- Error for Support Section already exists
          !sctnmess = false
          break
        elseif (!xerr.match('Atta Name').gt(0)) then
-- Check if the text 'Atta Name' exists in the Error message
          if (!xerr.string().match(!memname).gt(0)) then
-- Check if the name of the Support Atta '!memname' exists in the Error message
            skip
          else
-- Set to 'true' to Output Error for the Current Support Atta as NO other Error message exists
            !sctnmess = true
          endif
        else
-- Ignore Any Other Error message
          skip
        endif
      enddo

--      if (!sctnmess) then
--        !error.append(||)
--        !error.append(|**   Message   ** - No problems with this Support Ancillary|)
--        !error.append(|Atta Name                     = $!memname|)
--        !error.append(|--------------------------------------------------------------------------------|)
--        !messages = !messages + 1
--      endif
    enddo
  endif

  !error.append('Summary')
  !error.append('-------')
  !error.append('Errors      = $!errors')
  !error.append('Warnings    = $!warnings')
  !error.append('Messages    = $!messages')
  !error.append(' ')
  !error.append('End of Report')
  !error.append('-------------')

  !!mdsResetPins(8,9)
  !!mdsCheckLen.errorList.dtext = !error
-- Set paragraph gadget to the DATUM ATTA Name
  !!mdsCheckLen.name.val = !form.support.datum.name

  if (!errors + !warnings + !messages gt 0) then
    waiton !!mdsCheckLen
  else
    !!mdsCheckLen.ok.active = TRUE
    !!mdsCheckLen.accept = TRUE
  endif

-- Reset Units
  !!kRestoreUnits(!currentUnits)

-- End function
endfunction
