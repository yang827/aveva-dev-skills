--
--
-- Description:
-- Function to check if any non planer members have been added to a function
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckTrun(!Form is form,!Type is STRING) is BOOLEAN

-- Type may be set to ALL, DATUM or CE
-- All with check all atta
-- DATUM will check datum only

  !SaveRef = !!CE

  !return = FALSE
  if !Type.eq('ALL') then
    do !Check values !Form.Support.Atta
    if !Check.badref().not() then
      if !Check.catref.owner.:mdstrun then
          handle ANY
          endhandle
          !return = TRUE
      endif
     endif
    enddo
  elseif !Type.eq('DATUM') then
    if !Form.Support.Datum.catref.owner.:mdstrun then
       !return = TRUE
    endif
  elseif !Type.eq('CE') then
    if !!ce.catref.owner.:mdstrun then
       !return = TRUE
    endif
  elseif !Type.eq('DATUMONLY') then
    !SuppName = !!MdsGetSuppName(!!CE)
    !Datumname = '$!SuppName/DATUM'
    !!ce = !DatumName.dbref()
    if !!ce.catref.owner.:mdstrun then
      !return = TRUE
    endif
    Same
  endif

return !return

-- End function
endfunction

-- End of file MdsCheckTrun.pmlfnc
