--
-- File:		MdsCopyJois.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thurs Jan 20
--
--
-- Description:
-- function to copy joints (PNOD/PJOI) for a new cross bar
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Name of Support
--     2     R        STRING        Number of Cross Bar
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCopyJois(!Name is STRING,!Next is REAL,!Sctn is DBREF)

  !!CE = $!Name-BAR-1

  !Jois = Jois
  !Joie = Joie

  if !Jois.badref().not() then
    goto jois
    snod
      handle ANY
        pnod
          handle ANY
          elsehandle NONE
            !Pnod = !!ce
            !!ce = !Sctn
            new pnod copy $!Pnod
            1
            delp n0
            !barName = name of prev sctn
            name $!BarName/PJOI
            prev sctn
            jois same
            same
            pnod
            name $!BarName/PNOD
          endhandle
      elsehandle NONE
        !Sctnname = !!CE.owner.name
        new snod $!<SctnName>/S$!<Next> copy prev rename $!<SctnName>/S1 $!<SctnName>/S$!<Next>
        zdist thro $!<Name>-BAR-$!<Next>
        sjoi 1
        cref $!<Name>-BAR-$!<Next>
        $!<Name>-BAR-$!<Next>
       jois same
      endhandle
  endif

  !!CE = $!Name-BAR-1

  if !joie.badref().not() then
    goto joie
    snod
      handle ANY
        pnod
          handle ANY
          elsehandle NONE
            !Pnod = !!ce
            !!ce = !Sctn
            new pnod copy $!Pnod
            1
            delp n0
            !barName = name of prev sctn
            name $!BarName/PJOI
            prev sctn
            joie same
            same
            pnod
            name $!BarName/PNOD
          endhandle
      elsehandle NONE
        !Sctnname = !!CE.owner.name
        new snod $!<SctnName>/S$!<Next> copy prev rename $!<SctnName>/S1 $!<SctnName>/S$!<Next>
        zdist thro $!<Name>-BAR-$!<Next>
        sjoi 1
        cref $!<Name>-BAR-$!<Next>
        $!<Name>-BAR-$!<Next>
        joie same
      endhandle
  endif

  !!CE =  $!<Name>-BAR-$!<Next>
  reconn recalc
  handle ANY
    --$P error in joint $!next
  endhandle

-- Reset the zdist of cross bar 1 because the bar may have been moved if the datum is on a higher cross bar

  if !Jois.badref().not() then
    !!CE = $!Name-BAR-1
    goto jois
    snod
      handle ANY
      elsehandle NONE
        zdist thro $!Name-BAR-1
      endhandle
  endif

  if !Joie.badref().not() then
    !!CE = $!Name-BAR-1
    goto joie
    snod
      handle ANY
      elsehandle NONE
        zdist thro $!Name-BAR-1
      endhandle
  endif

endfunction
