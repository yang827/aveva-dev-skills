--
-- File:		MdsCopySpecMem.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Thurs March 13
--
--
-- Description:
-- function to copy an existing special member
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCopySpecMem()

  -- Initialise variables
    !Support = !!MdsSpecial.Support
    !Stru    = !!MdsSpecial.Support.Stru


  -- Does the special contain any members yet
    var !Members coll all sctn for $!Stru
    if !members.unset() then
      !!Alert.Error('The special does not contain any members to copy')
      return
    endif

  -- Identify the section to copy
    prompt off
    prompt load escape 'Identify section to copy'
    ID SCTN @
      handle (61,528)
        prompt on
        return
      endhandle
    prompt on

  -- Does the section belong to the special

    stru
    if !!ce.name.neq(!Stru.name) then
      !!Alert.Error('The section identified does not belong to the special ' + !Stru.name)
      return
    endif

    same

    !units = object COMUNITS(TRUE)

-- Turn DAC control on
    !!MdsDacControl(true)

    !OldSuffix = !!ce.name.after('-V')
    !prevsctn = !!ce
    if (!!isImperialLength('DIST').not()) then
      new sctn copy prev by u 300mm wrt /*
    else
      new sctn copy prev by u 12IN wrt /*
    endif


-- dtf >>> Mod to copy joints 30.09.04
   !NewSctn = !!ce

    end
    reorder same after last mem
    stru
    !StruName = Name
    !!ce = !NewSctn
    do !Rename from 1 to 100
      name $!StruName-V$!Rename
        handle any
          skip
        elsehandle NONE
          !NewSuffix = !Rename
          break
        endhandle
    enddo

   !NewSctnName = !!CE.Name
   if !prevsctn.jois.unset().not() then
     new pnod
     if !prevsctn.joie.unset().not() then
        name $!NewSctnName/PNOD2
     else
        name $!NewSctnName/PNOD
     endif
     !pnods = !prevsctn.jois.owner
     copy  $!pnods
     pjoi 1
     if !prevsctn.joie.unset().not() then
        name $!NewSctnName/PJOI2
     else
        name $!NewSctnName/PJOI
     endif
     !pjois = !!ce
     !!ce = !NewSctn
     jois $!pjois

   endif
   if !prevsctn.joie.unset().not() then
     new pnod
     if !prevsctn.jois.unset().not() then
        name $!NewSctnName/PNOD1
     else
        name $!NewSctnName/PNOD
     endif
     !pnode = !prevsctn.joie.owner
     copy  $!pnode
     pjoi 1
     if !prevsctn.jois.unset().not() then
        name $!NewSctnName/PJOI1
     else
        name $!NewSctnName/PJOI
     endif
     !pjoie = !!ce
     !!ce = !NewSctn
     joie $!pjoie
   endif
   !!ce = !NewSctn
-- dtf <<< End of Mod



   !newname = name
    --end
    --reorder same after last mem
    --$!newname

-- Copy weld locally for new section

   !MdsWeldData = :MdsWeldData
   !NewMdsWeldData = ARRAY()

   do !CopyWelds values :MdsWelddata
     !!ce = !CopyWelds
     !Oldname = !!ce.name
     end
     last mem
       handle ANY
       endhandle
     !NewDdseName = !CopyWelds.name.replace('-V$!OldSuffix','-V$!NewSuffix')
     new ddse $!NewDdsename copy $!CopyWelds rename $!OldName $!Newddsename
       handle (41,12)
         delete ddse
         $!NewDdsename
         delete ddse
         !!ce = !CopyWelds
         end
         last mem
           handle ANY
           endhandle
         new ddse $!NewDdsename copy $!CopyWelds rename $!Oldname $!Newddsename
       endhandle
     !NewMdsWeldData.append(!!ce)
   enddo

   $!Newname
   !!ce.:MdsWeldData = !NewMdsWeldData
     handle any
     endhandle

-- Turn DAC control off

    !!MdsDacControl(false)

    if (!!isImperialLength('DIST').not()) then
      !!Alert.Message('The indentified section has been copied , moved up 300mm and named $!NewName')
    else
      !!Alert.Message('The indentified section has been copied , moved up 1FT and named $!NewName')
    endif

-- End function
endfunction

-- End of file MdsCopySpecMem.pmlfnc
