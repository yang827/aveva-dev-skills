/MDS-CPL

var !coll coll all spco with matchwild(tans,'*SPRING SIZE*') for ce

do !Loop values !Coll

  !!ce = !Loop.dbref()
  goto detref

  !Part1 = '/MDS-CPL-'
  !Part2 = !!ce.dtxr.substring(1,5)
  same
  !Part3 = !!ce.tans.after('SPRING SIZE ').trim()

  if !part2.matchwild('*TYPE*') then
        skip
  endif

  !part4 = !!ce.dtxr.after('TYPE ').substring(1,1)

  !ce = !!ce
  do from 1 to 10
    end
    if !!ce.ddepth.eq(4) then
      break
    else
      skip
    endif
  enddo

  !Part5 = !!ce.name.after('/MDS-CPL/HELE/')

  !!ce = !ce

  if !part2.eq('DV75 ') then
      goto detref
      !!ce.rtext = !!ce.rtext.replace('DV75','DV075')
      !!ce.stext = !!ce.stext.replace('DV75','DV075')
      same
      !Part2 = 'DV075'
  endif
  -- q var !part2

  if !Part3.length().eq(1) then
    !Part3 = '0' + !Part3
  endif

  if !!ce.name.neq('$!part1$!part2-$!part4-$!part3-$!Part5') then

    $p $!part1$!part2-$!part4-$!part3-$!Part5
    name $!part1$!part2-$!part4-$!part3-$!Part5
  endif
enddo



return
