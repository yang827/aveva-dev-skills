--
-- File:    MdsCreateLugs.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:   Tue Aug 3rd 2004
--
-- Description:
-- Creation function for lugs
-- Standards ST19, ST21, ST22 and ST23 require the automatic generation of LUGS
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateLugs()

  !!MDSDacControl(TRUE)

-- only applies to the following atta types

-- DUN836 - ST42 added to list
  if (not !!ce.styp inset('ST19','ST21','ST22','ST23','ST27','ST35','ST42')) then
    return
  endif

  !ce = !!ce
  !nameOfAtta = !!ce.name
  !refOfAtta = !!ce.refno

  if !!ce.styp.eq('ST23') then
    !angle = 25
  elseif !!ce.styp.eq('ST27') or !!ce.styp.eq('ST34') then
    !angle = 90
  else
    !angle = 45
  endif

  $!nameOfAtta/LUG1
    handle ANY
      prev
-- handle for start of branch
      handle ANY
        new olet $!nameOfAtta/LUG1 before choose with styp LUF
        handle ANY
          !!alert.error('Unable to select lugs for ancillary')
          if !!ce.type.eq('OLET') then
            delete olet
          endif
          !!MDSDacControl(FALSE)
          return
        endhandle
      elsehandle NONE
        new olet $!nameOfAtta/LUG1 choose with styp LUF
          handle ANY
            !!alert.error('Unable to select lugs for ancillary')
            if !!ce.type.eq('OLET') then
              delete olet
            endif
            !!MDSDacControl(FALSE)
            return
          endhandle
      endhandle
      flip
      fconn to next
    endhandle
  ori and p3 is p9 of next atta
  rotate about pl by $!angle
  rule set pos dynamic pp80 pos of $!refOfAtta
  nweld 1

  $!nameOfAtta/LUG2
    handle ANY
      new olet $!nameOfAtta/LUG2
    endhandle
  copy prev
  nweld 1

  rotate about pl by -$!angle
  rotate about pl by -$!angle
  move along pl clear 0 inf P80 of next
  rule set pos dynamic pp80 pos of $!refOfAtta

  $!nameOfAtta/LUG3
    handle ANY
      !srefname = !nameOfAtta.before('DATUM') & 'SREF'
      $!srefname
      handle ANY
        nex
      endhandle
      new olet $!nameOfAtta/LUG3 choose with styp LUF
    endhandle
  fconn
  ori and p3 is p9 of $!refOfAtta
  rotate about pl by $!angle
  move along pa clear 0 inf p81 of $!refOfAtta
  rule set pos dynamic pp81 pos of $!refOfAtta
  nweld 1

  $!nameOfAtta/LUG4
    handle ANY
      new olet $!nameOfAtta/LUG4
    endhandle
  copy prev
  rotate about pl by -$!angle
  rotate about pl by -$!angle
  rule set pos dynamic pp81 pos of $!refOfAtta
  nweld 1
  !!ce = !ce

  !!MDSDacControl(FALSE)

-- End function
endfunction
