--
-- File:    MdsDeleteSpecMem.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Derek Flannery
-- Created:		Fri 1 October 04
--
--
-- Description:
-- function to delete an existing special member
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsDeleteSpecMem()
  -- Initialise variables
  --!support = !!mdsSpecial.support
  !stru    = !!mdsSpecial.support.stru
  -- Does the special contain any members yet
  var !members coll all sctn for $!stru
    if !members.unset() then
    !!alert.error('The special does not contain ANY members to Delete')
      return
    endif
  -- Identify the section to delete
    prompt off
    prompt load escape 'Identify section to Delete'
    ID SCTN @
      handle (61,528)
        prompt on
        return
      endhandle
    prompt on
  -- Does the section belong to the special
    stru
  !struName = Name
  if !!ce.name.neq(!stru.name) then
    !!alert.error('The section identified does not belong to the special ' + !stru.name)
      return
    endif
    same
-- Turn DAC control on
  !!mdsDacControl(TRUE)
  -- Remove any references before deletion
    !ce = !!ce
  !x = object MDSBPLATECONN()
  !x.disconnect(!!ce)
    !!ce= !ce
  --!oldSuffix = !!ce.name.after('-V')
  --<wd>15feb2010 - DUN1233 - The SCTN Support Types "Q3O" and Q5O" have an additional 2nd SCTN to DELETE
  -- Before DELETING the MAIN SCTN for the SCTN types "Q3O" and "Q5O" test for these SCTN types
  -- Store the MAIN SCTN of the SCTN type being DELETED
  !second = FALSE
  !mainSection = !!ce
  if (!!ce.function.matchwild('Q*O*')) then
    -- Get the name of the possible 2nd SCTN as per the MAIN SCTN for the SCTN types "Q3O" and "Q5O"
    !second = TRUE
    !secondSection = !mainSection.mem[1].mem[1].cref
    handle ANY
    endhandle
  endif
  -- Navigate back to the MAIN SCTN of the SCTN type being MOVED
  !!ce = !mainSection
  --<wd>15feb2010 - DUN1233 - The NEW SCTN Support Types "Q3_O" and Q5_O" require an additional SCTN
    -- Delete SCTN
    $m /%pdmsui%/clib/files/MDELCE CE TRUE
  --<wd>15feb2010 - DUN1233 - The SCTN Support Types "Q3O" and Q5O" have an additional 2nd SCTN to DELETE
  -- Test for the existence of a 2nd SCTN when the selected type is "Q3O", "Q5O" etc...
  if (!second) then
    !!ce = !secondSection
    handle NONE
      -- Now DELETE the 2nd SCTN that exists for the SCTN types "Q3O" and "Q5O"
      $m /%pdmsui%/clib/files/MDELCE CE TRUE
    elsehandle ANY
      -- DO NOTHING as a 2nd SCTN - !secondSectionName.dbref() - DOES NOT EXIST
    endhandle
  endif
  --<wd>15feb2010 - DUN1233 - The SCTN Support Types "Q3O" and Q5O" have an additional 2nd SCTN to DELETE
    -- Delete Any PNOD with no members
  var !pnodColl coll all PNOD with mem count eq 0 for stru
  do !pnod values !pnodColl
    $!pnod
      delete PNOD
    enddo
    -- Coll all sctn for stru & ddse to rename
  var !sctnColl coll all sctn for stru
    --var !coll append coll all ddse for stru
    -- Unname first
  do !i values !sctnColl
    $!i
      unname
      handle (41,25)
        -- Element already unnamed
      endhandle
    enddo
  do !i values !sctnColl
    do !rename from 1 to 100
      $!i
      name $!struName-V$!rename
      handle ANY
          skip
        elsehandle NONE
        !weldData = !!ce.:MDSWELDDATA
          --$p Rename the weld stuff here
        do !ii indices !weldData
          $!weldData[$!ii]
          !oldName = !!ce.name
          --<wd>17feb2010 - commented Out as it does NOTHING
          --!struName
          !newName = !oldName.before('/WELD').before('-V') + '-V$!rename/WELD$N$!ii'
          --q var !newName !oldName
          -- Only rename if name changed
          if !newName neq !oldName then
            rename all $!oldName $!newName
            handle ANY
              $!newName
                delete ddse
              $!weldData[$!ii]
              rename all $!oldName $!newName
              endhandle
            endif
            handle ANY
              -- name unchanged
            endhandle
          enddo
          break
        endhandle
      enddo
    enddo
  --<wd>17feb2010 - DUN1233 - Now RENAME all SNODE and SJOI and FITT members below the current SCTN with the new name prefix
  -- 1st - Unname ALL the SNOD, SJOI and FITT element members below all the SCTN members
  do !section values !sctnColl
    $!section
    var !sctnMembers coll all (SNOD SJOI FITT) for ce
    do !member values !sctnMembers
      $!member
      unname
      handle ANY
      endhandle
    enddo
  enddo
  -- 2nd - RENAME all SNODE, SJOI and FITT members below the current SCTN with the new name prefix
  do !section values !sctnColl
    !!ce = !section.dbref()
    !sctnName = !!ce.name
    do !loop from 1 to 5
      snod $!loop
      handle NONE
        name $!sctnName/SNOD$!loop
        do !index from 1 to 5
          sjoi $!index
          handle ANY
          elsehandle NONE
            name $!sctnName/SNOD$!loop/SJOI$!index
          endhandle
        enddo
      elsehandle ANY
      endhandle
      FITT $!loop
      handle NONE
        !crefName = !!ce.cref.name
        handle NONE
          !split = !crefName.split('/')
          if(!split.size().gt(1)) then
            !suffix = !split[!split.size()]
            name $!sctnName/FITT/$!suffix
          else
            name $!sctnName/FITT/$!loop
          endif
        elsehandle ANY
          name $!sctnName/FITT/$!loop
        endhandle
      elsehandle ANY
      endhandle
    enddo
  enddo
  --<wd>17feb2010 - DUN1233
    -- Get all pjoi and rename
  -- unname first
  var !pjoiColl coll all pjoi for stru
  do !pjoi values !pjoiColl
      $!pjoi
      unname
      handle (41,25)
        -- Element already unnamed
      endhandle
      end
      unname
      handle (41,25)
        -- Element already unnamed
      endhandle
  enddo
  do !pjoi values !pjoiColl
    $!pjoi
      if !!ce.cend.eq(|START|) then
        if !!ce.cref.joie.unset().not() then
        !crefName = !!ce.cref.name
        name $!crefName/PJOI2
        else
        !crefName = !!ce.cref.name
        name $!crefName/PJOI
      endif
      if !!ce.cref.joie.unset().not()  then
        END
        name $!crefName/PNOD2
      else
        END
        name $!crefName/PNOD
        endif
      elseif !!ce.cend.eq(|END|) then
        if !!ce.cref.jois.unset().not() then
        !crefName = !!ce.cref.name
        name $!crefName/PJOI1
        else
        !crefName = !!ce.cref.name
        name $!crefName/PJOI
      endif
      if !!ce.cref.jois.unset().not() then
        END
        name $!crefName/PNOD1
      else
        END
        name $!crefName/PNOD
      endif
    endif
  enddo
    $!stru
-- Turn DAC control off
  !!mdsDacControl(FALSE)
-- End function
endfunction
