--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        !Formname
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsExportDespars()

-- Write current despars to inputable file for paragon

  !Despars = despar
    handle any
      !!Alert.error('No despars to export')
    endhandle

  !Counter = 1
  openfile /c:\temp\dp.mac overwrite !file

  do !desp from 1 to !despars.size()
    writefile $!file 'MODEL SET DESIGN PARA $!Counter $!Despars[$!Desp]'
    !Counter = !counter + 1
  enddo

  closefile $!file

return

-- End of file MdsExportDespars.pml
