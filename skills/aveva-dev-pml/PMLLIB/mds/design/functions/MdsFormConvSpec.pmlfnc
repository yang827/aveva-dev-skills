--
-- Author:		Neale Morris
-- Created:		Tues 27th July 2004
--
--
-- Description:
-- Function to convert a standard to a special, form an icon of the form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM         Current form name
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsFormConvSpec(!Form is form)

-- Does the support contain structural members and attas

  if !Form.Support.barlen.size().eq(0) then
    !!Alert.Error('Support does not contain any structural members and cannot be converted into a special')
    return
  endif

-- If the special form is shown then we cannot convert

  if !!MdsSpecial.shown() then
    !!Alert.Error('Unable to convert to a special as the special form is being used for support' + !!MdsSpecial.Support.Stru.Name)
    return
  endif

-- If the modify form is shown and the name gadget is not set to unset we cannot to a special
-- unless its the current support

  if !!MdsModifySupp.shown() and !!MdsModifySupp.Name.val.neq('unset') then
    !StringNameInModifySupportGadget = '/' + !!MdsModifySupp.Name.val
    !NameInModifySupportGadget = !StringNameInModifySupportGadget.dbref()
    !SupportToBeConverted = !Form.Support.Stru
    if !NameInModifySupportGadget.neq(!SupportToBeConverted) then
      !!Alert.Error('Unable to convert to a special as the modify support form is shown and being used for support ' + !StringNameInModifySupportGadget)
      return
    endif
  endif

-- Show the convert to special form with the name of the support

  !!ce = !Form.Support.Stru
  !!FormToHide = !form
  !!MdsConvToSpec.init(!!CE)


-- End function
endfunction

-- End of file MdsFormConvSpec.pmlfnc
