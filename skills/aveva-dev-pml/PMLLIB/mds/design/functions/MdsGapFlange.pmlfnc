--
-- File:    MdsGapFlange.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   May 13 2005
--
--
-- Description:
-- function to adjust framework if the gap flange toggle is used.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsGapFlange(!form is FORM,!pick1 is DBREF,!pick2 is DBREF, !flipped is BOOLEAN)

  -- This positions the frameworks with respect to either the geometry of the identified sctn or
  -- gensec. Geometry uses the geometry of the section/gensec where as origin uses the origin of
  -- the sctn of gensec.

  -- Return if toggle for gap flange is not on

  if !!mdsFlangeGaps.gapToggle1.val.eq(1) and !!mdsFlangeGaps.gapToggle2.val.eq(1) then
    return
  endif

  -- Set the gap distance

  !gap1 = !!mdsFlangeGaps.gap1.val.real()
  !gap2 = !!mdsFlangeGaps.gap2.val.real()

  ----------------------
  -- Using Geometry ID 1
  ----------------------

  if !!mdsFlangeGaps.flangeGapType.val.eq(1) then

    --<wd>may2007<mds12>
    --    if !pick1.type.eq('SCTN') or !pick1.type.eq('GENSEC') then
    if !pick1.type.eq('SCTN') or !pick1.type.eq('GENSEC') or !pick1.type.eq('HSTIFF') then
      --<wd>may2007<mds12>
      if !!mdsFlangeGaps.gapToggle1.val.neq(1) then
        -- Pick 1 Inside
        if !!mdsFlangeGaps.gapToggle1.val.eq(2) then
          if !flipped then
            !!mdsGetPline(9,!pick1,'INF')
            !pin = 9
          else
            !!mdsGetPline(8,!pick1,'INF')
            !pin = 8
          endif
          pin $!pin dist $!gap1
          -- Pick 1 Outside
        elseif !!mdsFlangeGaps.gapToggle1.val.eq(3) then
          if !flipped then
            !!mdsGetPline(9,!pick1,'BEH')
            !pin = 9
          else
            !!mdsGetPline(8,!pick1,'BEH')
            !pin = 8
          endif
          pin $!pin dist -$!gap1
          handle ANY
            !newGap = !gap1.abs()
            pin $!pin dist $!newGap
          endhandle
        endif

        -- we now want to find out how wide the template leg is so we need to copy it, remove any members from the copy
        -- and send the appropriate pin 0 clear in front and behind of it so that we can get a distance
        !xce = !!ce
        !steel = !form.support.stru.name + '-V1'
        !!ce = !steel.dbref()
        new sctn copy prev
        delete sctn mem
        handle ANY
        endhandle

        var !pin1dir pin 1 dir wrt /*
        var !pin1pos pin 1 pos wrt /*
        pin 1 copy pin $!pin
        pin 1 plane pin 1 clear 0 inf ce
        var !startPos pin 1 pos
        pin 1 plane pin 1 clear 0 beh ce
        var !endPos pin 1 pos
        var !dist const dist $!startPos to $!endPos
        !moveDist = !dist.real() / 2
        pin 1 at $!pin1Pos wrt /*
        pin 1 dir $!pin1Dir
        if !!mdsFlangeGaps.gapToggle1.val.eq(2) then
          pin $!pin dist $!moveDist
        elseif !!mdsFlangeGaps.gapToggle1.val.eq(3) then
          pin $!pin dist -$!moveDist
        endif
        delete sctn
        !!ce = !xce
      endif
    endif
  endif

  ----------------------
  -- Using Geometry ID 2
  ----------------------

  if !pick1.neq(!pick2) then
    if !!mdsFlangeGaps.flangeGapType.val.eq(1) then

      --<wd>may2007<mds12>
      --      if !pick2.type.eq('SCTN') or !pick2.type.eq('GENSEC') then
      if !pick2.type.eq('SCTN') or !pick2.type.eq('GENSEC') or !pick2.type.eq('HSTIFF') then
        --<wd>may2007<mds12>
        if !!mdsFlangeGaps.gapToggle2.val.neq(1) then
          -- Pick 2 Inside
          if !!mdsFlangeGaps.gapToggle2.val.eq(2) then
            if !flipped then
              !!mdsGetPline(8,!pick2,'INF')
              !pin = 8
            else
              !!mdsGetPline(9,!pick2,'INF')
              !pin = 9
            endif
            pin $!pin dist $!gap2
            -- Pick 1 Outside
          elseif !!mdsFlangeGaps.gapToggle2.val.eq(3) then
            if !flipped then
              !!mdsGetPline(8,!pick2,'BEH')
              !pin = 8
            else
              !!mdsGetPline(9,!pick2,'BEH')
              !pin = 9
            endif
            pin $!pin dist -$!gap2
            handle ANY
              !newGap = !gap2.abs()
              pin $!pin dist $!newGap
            endhandle
          endif

          -- we now want to find out how wide the template leg is so we need to copy it, remove any members from the copy
          -- and send the appropriate pin 0 clear in front and behind of it so that we can get a distance
          !xce = !!ce
          !steel = !form.support.stru.name + '-V2'
          !!ce = !steel.dbref()
          new sctn copy prev
          delete sctn mem
          handle ANY
          endhandle

          var !pin1dir pin 1 dir wrt /*
          var !pin1pos pin 1 pos wrt /*
          pin 1 copy pin $!pin
          pin 1 plane pin 1 clear 0 inf ce
          var !startPos pin 1 pos
          pin 1 plane pin 1 clear 0 beh ce
          var !endPos pin 1 pos
          var !dist const dist $!startPos to $!endPos
          !moveDist = !dist.real() / 2
          pin 1 at $!pin1Pos wrt /*
          pin 1 dir $!pin1Dir
          if !!mdsFlangeGaps.gapToggle2.val.eq(2) then
            pin $!pin dist $!moveDist
          elseif !!mdsFlangeGaps.gapToggle2.val.eq(3) then
            pin $!pin dist -$!moveDist
          endif
          delete sctn
          !!ce = !xce
        endif
      endif
    endif
  endif

  --------------------
  -- Using Origin ID 1
  --------------------

  if !!mdsFlangeGaps.flangeGapType.val.eq(2) then

    --<wd>may2007<mds12>
    --    if !pick1.type.eq('SCTN') or !pick1.type.eq('GENSEC') then
    if !pick1.type.eq('SCTN') or !pick1.type.eq('GENSEC') or !pick1.type.eq('HSTIFF') then
      --<wd>may2007<mds12>
      if !!mdsFlangeGaps.gapToggle1.val.neq(1) then
        -- Pick 1 Inside
        if !!mdsFlangeGaps.gapToggle1.val.eq(2) then
          if !flipped then
            !!mdsGetPline(9,!pick1,'INF')
            !pin = 9
          else
            !!mdsGetPline(8,!pick1,'INF')
            !pin = 8
          endif
          pin $!pin dist -$!gap1
          -- Pick 1 Outside
        elseif !!mdsFlangeGaps.gapToggle1.val.eq(3) then
          if !flipped then
            !!mdsGetPline(9,!pick1,'BEH')
            !pin = 9
          else
            !!mdsGetPline(8,!pick1,'BEH')
            !pin = 8
          endif
          pin $!pin dist $!gap1
          handle ANY
            !newGap = !gap1.abs()
            pin $!pin dist $!newGap
          endhandle
        endif

        -- we now want to find out how wide the template leg is so we need to copy it, remove any members from the copy
        -- and send the appropriate pin 0 clear in front and behind of it so that we can get a distance
        !xce = !!ce
        !steel = !form.support.stru.name + '-V1'
        !!ce = !steel.dbref()
        new sctn copy prev
        delete sctn mem
        handle ANY
        endhandle

        var !pin1dir pin 1 dir wrt /*
        var !pin1pos pin 1 pos wrt /*
        pin 1 copy pin $!pin
        pin 1 plane pin 1 clear 0 inf ce
        var !startPos pin 1 pos
        pin 1 plane pin 1 clear 0 beh ce
        var !endPos pin 1 pos
        var !dist const dist $!startPos to $!endPos
        !moveDist = !dist.real() / 2
        pin 1 at $!pin1Pos wrt /*
        pin 1 dir $!pin1Dir
        if !!mdsFlangeGaps.gapToggle1.val.eq(2) then
          pin $!pin dist $!moveDist
        elseif !!mdsFlangeGaps.gapToggle1.val.eq(3) then
          pin $!pin dist -$!moveDist
        endif
        -- Using this method the flange of the angle is the dimension point
        !v1 = ce
        if !v1.gtyp.eq('ANG') and !!mdsFlangeGaps.flangeGapType.val.eq(2) then
          var !savePinPos pin $!pin pos wrt /*
          pin $!pin thro $!form.support.stru.name
          var !pinPosStru pin $!pin pos wrt /*
          pin $!pin plane pin $!pin thro ppline TOAX of $!v1
          var !pinPosToax pin $!pin pos wrt /*
          var !checkDistOfToax const dist $!pinPosToax to $!pinPosStru
          !distOfToax = !checkDistOfToax.real().int()
          pin $!pin at $!savePinPos wrt /*
          if !!mdsFlangeGaps.gapToggle1.val.eq(2) then
            if !distOfToax.gt(0) then
              pin $!pin dist -$!distOfToax
            endif
          elseif !!mdsFlangeGaps.gapToggle1.val.eq(3) then
            if !distOfToax.eq(0) then
              pin $!pin dist $!dist
            endif
          endif
        endif
        delete sctn
        !!ce = !xce
      endif
    endif
  endif

  --------------------
  -- Using Origin ID 2
  --------------------

  if !pick1.neq(!pick2) then
    if !!mdsFlangeGaps.flangeGapType.val.eq(2) then

      --<wd>may2007<mds12>
      --      if !pick2.type.eq('SCTN') or !pick2.type.eq('GENSEC') then
      if !pick2.type.eq('SCTN') or !pick2.type.eq('GENSEC') or !pick2.type.eq('HSTIFF') then
        --<wd>may2007<mds12>

        -- Pick 2 Inside
        if !!mdsFlangeGaps.gapToggle2.val.eq(2) then
          if !flipped then
            !!mdsGetPline(8,!pick2,'INF')
            !pin = 8
          else
            !!mdsGetPline(9,!pick2,'INF')
            !pin = 9
          endif
          pin $!pin dist -$!gap2
          -- Pick 1 Outside
        elseif !!mdsFlangeGaps.gapToggle2.val.eq(3) then
          if !flipped then
            !!mdsGetPline(8,!pick2,'BEH')
            !pin = 8
          else
            !!mdsGetPline(9,!pick2,'BEH')
            !pin = 9
          endif
          pin $!pin dist $!gap2
          handle ANY
            !newGap = !gap2.abs()
            pin $!pin dist $!newGap
          endhandle
        endif

        -- we now want to find out how wide the template leg is so we need to copy it, remove any members from the copy
        -- and send the appropriate pin 0 clear in front and behind of it so that we can get a distance
        !xce = !!ce
        !steel = !form.support.stru.name + '-V2'
        !!ce = !steel.dbref()
        new sctn copy prev
        delete sctn mem
        handle ANY
        endhandle

        var !pin1dir pin 1 dir wrt /*
        var !pin1pos pin 1 pos wrt /*
        pin 1 copy pin $!pin
        pin 1 plane pin 1 clear 0 inf ce
        var !startPos pin 1 pos
        pin 1 plane pin 1 clear 0 beh ce
        var !endPos pin 1 pos
        var !dist const dist $!startPos to $!endPos
        !moveDist = !dist.real() / 2
        pin 1 at $!pin1Pos wrt /*
        pin 1 dir $!pin1Dir
        if !!mdsFlangeGaps.gapToggle2.val.eq(2) then
          pin $!pin dist $!moveDist
        elseif !!mdsFlangeGaps.gapToggle2.val.eq(3) then
          pin $!pin dist -$!moveDist
        endif
        -- Using this method the flange of the angle is the dimension point
        !v1 = !!ce
        if !v1.gtyp.eq('ANG') and !!mdsFlangeGaps.flangeGapType.val.eq(2) then
          var !savePinPos pin $!pin pos wrt /*
          pin $!pin thro $!form.support.stru.name
          var !pinPosStru pin $!pin pos wrt /*
          pin $!pin plane pin $!pin thro ppline TOAX of $!v1
          var !pinPosToax pin $!pin pos wrt /*
          var !checkDistOfToax const dist $!pinPosToax to $!pinPosStru
          !distOfToax = !checkDistOfToax.real().int()
          pin $!pin at $!savePinPos wrt /*
          if !!mdsFlangeGaps.gapToggle2.val.eq(2) then
            if !distOfToax.gt(0) then
              pin $!pin dist -$!distOfToax
            endif
          elseif !!mdsFlangeGaps.gapToggle2.val.eq(3) then
            if !distOfToax.eq(0) then
              pin $!pin dist $!dist
            endif
          endif
        endif
        delete sctn
        !!ce = !xce
      endif
    endif
  endif
endfunction
