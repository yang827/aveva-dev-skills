--
--
-- Description:
-- function to find the face of a gwall
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetFace(!Ploo is DBREF,!Hanger is dbref) is Position

  !ce = !!ce
  !members = mcount
  !Distance = 1000000

  !HeadPosition = object PointVector()
  !HeadPosition.position  = hpos of $!Hanger wrt /*
  !HeadPosition.direction = tdir of $!Hanger wrt /*
  !HeadPos = !HeadPosition.position.wrt(/* )
  !HeadPosUp = !headpos.up
  !PaveArray = ARRAY()
  !Xdirs = ARRAY()

  do !LoopThroughFaces from 1 to !Members
-- Create a line
    !Pave = pave $!LoopThroughFaces
    !Line = object line()
    if !LoopThroughFaces.neq(!Members) then
      !Line.StartPosition = position of pave $!LoopThroughFaces wrt /*
      !NexPave = !LoopThroughFaces + 1
      !Line.EndPosition = position of pave $!NexPave wrt /*
      !Line.StartPosition.up = !HeadPosUp
      !Line.EndPosition.up = !HeadPosUp
      !Xdir = !Line.Direction()
    else
      !Line.StartPosition = position of pave $!LoopThroughFaces wrt /*
      !Line.EndPosition = position of pave 1 wrt /*
      !Line.StartPosition.up = !HeadPosUp
      !Line.EndPosition.up = !HeadPosUp
      !Xdir = !Line.Direction()
    endif
-- Does the line pass over the line

    !Intersection = !Line.OnProjected(!HeadPos)

    if !InterSection then
      !PaveArray.append(!Pave)
      !Xdirs.append(!Xdir)
    endif

  enddo

  q var !pavearray
  q var !xdirs

  do !LoopToFindNearest from 1 to !PaveArray.size()

-- Create Plane to find out distance from PH

    !PosPav = !PaveArray[$!LoopToFindNearest].position.wrt(/* )
    !Plane = object plane()
    !Plane.Position = !PosPav

    !Plane.Orientation = y is u and x is $!Xdirs[$!LoopToFindNearest]
    !ThroPos = !Plane.Intersection(!HeadPosition)
    !ThisDistance = !ThroPos.distance(!HeadPos)

    $P -- $!distance
    $P -- $!thisdistance

    if !ThisDistance.lt(!Distance) then
      !Distance = !ThisDistance
      !ThroPosition = !ThroPos
    endif

  enddo

  $P $!distance
  $P $!throposition

  !!ce = !ce

  return !ThroPosition

endfunction

-- End function

-- End of file MdsGetFace.pmlfnc
