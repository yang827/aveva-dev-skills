define function !!mdsgetpline(!pin is REAL,!pick is DBREF,!option is STRING)

-- !option of INF is the nearest pline
-- !option of BEH is the furthest pline

-- Make sure the pin is on the correct side of the element

  !ce = !!ce
  !!ce = !pick

  pin $!pin plane pin $!pin thro $!pick
  pin $!pin dist -10000

  if !!mdsFlangeGaps.flangeGapType.val.eq(2) then
    pin $!pin thro $!pick
    !!ce = !ce
    return
  endif

-- get ppline list
--<wd>may2007<mds12>
--  !plines = plna of $!pick
  if (!pick.type inset('SCTN', 'GENSEC')) then
    !plines = plna of $!pick
  elseif(!pick.type inset('HSTIFF')) then
    var !plnames plna of $!pick
    !plines = !plnames.split()
  endif
--<wd>may2007<mds12>

-- Create a series of lines between each pline start and end

  !lines = ARRAY()
  !counter = 1
  do !loop values !plines
    if !loop.neq('NA') then
      !lines[$!counter] = object LINE()
      var !plst plst $!loop wrt /*
      var !plen plen $!loop wrt /*
      !lines[$!counter].startPosition = $!plst
      handle (2,779)
        !lines[$!counter].startPosition = !plst.position()
      endhandle
      !lines[$!counter].endposition = $!plen
      handle (2,779)
        !lines[$!counter].endposition = !plen.position()
      endhandle
    endif
    !counter = !counter + 1
  enddo

  var !startPosition pin $!pin pos wrt /*
  var !startDirection pin $!pin dir wrt /*
  !startPoint = object POINTVECTOR()
  !startPoint.position = $!startPosition
  handle (2,779)
    !startPoint.position = !startPosition.position()
  endhandle
  !startPoint.direction = $!startDirection
  handle (2,779)
    !startPoint.direction = !startDirection.direction()
  endhandle
  if !option.eq('INF') then
    !distance = 100000
  else
    !distance = -100000
  endif

  do !nearest values !lines
    !midPoint = !nearest.proportion(0.5)
    !plane = object PLANE()
    !plane.position = $!midPoint
    !plane.orientation = z is $!startDirection wrt /*
    !calcDist = !startPoint.position.distance(!plane)
    if !option.eq('INF') then
      if !calcDist.lt(!distance) then
        !distance = !calcDist
      endif
    else
      if !calcDist.gt(!distance) then
        !distance = !calcDist
      endif
    endif
  enddo

  pin $!pin dist $!distance

  !!ce = !ce

endfunction
