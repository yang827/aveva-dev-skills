--
-- File:  MdsGetPlot.pmlfnc
--   Type:
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Mon Aug 18
--
--
-- Description:
-- Macro to get the plot files for a MDS standard
--
--------------------------------------------------------------------------------
define function !!mdsGetPlot(!std is STRING) is ARRAY

  !stdNoSuffix = 'NULL'
  do !i from !std.length() to 1 by -1
    --try and convert character !i to a real, the first real should denote the standard name without any suffix i.e. AT29A becomes AT29
    !char = !std.substring(!i, 1)
    !unusedcharReal = !char.real()
    handle ANY
      skip
    elsehandle NONE
      !stdNoSuffix = !std.substring(1, !i)
      break
    endhandle
  enddo

  -- The standard required will be passed as a string
  -- The plot files found will be returned as a array
  !files = ARRAY()

  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH
  --var !plotSearchString evar MDSPLOTS
  --!plotSearchStrings = !plotSearchString.split(' ')
  !plotSearchString = 'MDSPLOTS'
  !plotSearchStrings = !!evarSplit(!plotSearchString)
  --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH

  -- Loop through each file plotsearchstring backwards until an error is found
  do !loop1 from !plotSearchStrings.size() to 1 by -1
    do !loop2 from 1 to 20 by 1
      -- Create a file object of the file we are looking for
      !fileObject = object FILE('$!plotSearchStrings[$!loop1]/MDS-Standards-$!std-$!loop2$n.plt')
      !fileObject1 = object FILE('$!plotSearchStrings[$!loop1]/MDS-Standards-$!stdNoSuffix-$!loop2$n.plt')
      if !fileObject.exists() then
        !files[$!loop2] = !fileObject
      elseif !fileObject1.exists() then
        !files[$!loop2] = !fileObject1
      endif
      -- Also add the plofiles with an alphabetic extension
      !alpha = 'A B C D E F G H I J K L m N O P Q R S T U V W X Y Z'
      !alphaS = !alpha.split()
      do !alphaChar values !alphaS
        !fileObject = object FILE('$!plotSearchStrings[$!loop1]/MDS-Standards-$!std$!alphaChar-$!loop2$n.plt')
        if !fileObject.exists() then
          !files[$!loop2] = !fileObject
        else
          break
        endif
      enddo

    enddo
  enddo

  return !files

endfunction
