--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetSizeRange(!Form is FORM) is STRING

  !Standard = !Form.Support.Alias
  !String = ''

  !ArrayOfSizes = !!MDSPar$!Standard
    Handle Any
      return !String
    Endhandle

  !ArrayOfSizes[0].delete()
    Handle Any
    Endhandle

  !Indices = !ArrayOfSizes.indices()

  !FromSize = !Indices[1].string()
  !ToSize = !Indices[!Indices.size()]

q units

  -- !FromSizeInUnits = !From.real().string(

  !String = '$!FromSize - $!ToSize'

  return !String

endfunction

-- End of file MdsGetSizeRange.pml
