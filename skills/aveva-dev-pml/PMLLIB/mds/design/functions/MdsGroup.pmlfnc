--
-- File:		MdsGroup.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thurs 2nd Sept 2004
--
--
-- Description:
-- Function to create / add a support to a group
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Option NEW/ADD/IS
--                                  NEW to create a new group
--                                  ADD to add to a group
--                                  IS to check if it is a group
--     2     R        FORM          Calling form
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGroup(!Option is STRING,!Form is FORM)

-- A group will be recognised by the fact that it is suffixed with [val], where
-- val is a number, Maximum number of members of a support group is 10

-- Create a new support group
  if !Option.upcase().eq('NEW') then

-- Create a new support to a group
-- We cannot create a group unless the name of the support has been set
    if !form.name.val.lowcase().eq('unset') then
      !!Alert.Error('Unable to create a support group without setting the name first')
      return
    endif

-- Has the user already hit the new group button
    if !Form.name.val.match('[').gt(0) and !Form.name.val.match('[').gt(0) then
      !!Alert.error('Name of support is already a group member')
      return
    endif

-- Check to see if any support group members have been already created, if so abort
    !Exists = FALSE
    !ce = !!ce
    do !Check from 1 to 10
      !TestName = !Form.name.val + '[' + !Check.string() + ']'
      !!ce = !TestName.dbref()
        handle ANY
        elsehandle NONE
          !Exists = TRUE
        endhandle
    enddo
    !!ce = !ce

-- If it doesn't exist then reset the gadget with the prefix
    !Form.name.val = !Form.name.val + '[1]'

-- Abort if already exists
    if !Exists then
      !!Alert.Error('Unable to create a group as members already exist')
      return
    endif

  elseif !Option.upcase().eq('ADD') then

    !Orice = !!ce
    if (!form.eq(!!mdsmodifyname) ) then
-- Check that gadget !!Mdsmodifyname.newname.val is not set to 'unset'
      if (!!Mdsmodifyname.name.val.lowcase() eq 'unset') then
        !!alert.error(|The Name of the Existing Support may NOT be 'unset'.Please Select support to modify name.|)
        return
      elseif (!!Mdsmodifyname.name.val.matchwild('*[*]') ) then
        !!alert.error(|The Existing Support is already part of a Group. Please remove it, before adding to the new Group|)
        !!Mdsmodifyname.newname.val = 'unset'
        return
      endif
      !!ce = !form.supportmem[1]
      handle ANY
        --!!alert.error(|Please Select a Support|)
        --return
      elsehandle NONE
        if !!ce.type.eq(|STRU|) then
          !!mdsconvertgroup(|CONVERT|, !!CE , ||)
          return
        endif
      endhandle
     endif
     !!ce = !Orice

-- Add support to an existing group
-- Identify support to add new support to as an addition member
      prompt off
      prompt load escape |Identify support group to add new support to|
      id @
        handle (61,528)
          prompt on
          return
        endhandle
      prompt dismiss
      prompt on

-- Is the identified support a support
      !!MdsSilent = TRUE
      !IsASupport = !!MdsGetSuppName(!!ce)
      if !IsASupport.eq('ABORT') then
        !!Alert.Error('Identified element is not a support')
        !!MdsSilent.delete()
        return
      endif

      rest
      handle ANY
        stru
      endhandle
-- So the identified element is a support, is it already a group member
      if !!ce.name.match('[').eq(0) and !!ce.name.match(']').eq(0) then
        !!Alert.error('Identified support is not a group member')
        return
      endif

-- Check to see if already part of that support
      if !form.eq(!!mdsmodifyname) then
        if !Form.name.val.match('[').gt(0) then
          if !Form.name.val.before('[').eq(!!ce.namn.before('[')) then
            !!Alert.error('Support $!Form.name.val is already a member of $!!ce.namn')
            !Form.newname.val = |unset|
            return
          endif
        endif
      endif

-- OK everything seems to be OK add the support as a group
      !ce = !!ce
      do !Check from 1 to 10
        !TestName = !IsASupport.before('[') + '[' + !Check.string() + ']'
--    q var !testname
        !!ce = !TestName.dbref()
          handle ANY
-- If it doesnt exist then reset the gadget with the prefix
--dtf >>> if form is modify used .newname
            if !form.eq(!!mdsmodifyname) then
              !Form.newname.val = !IsASupport.after('/').before('[') + '[$!Check]'
            else
              !Form.name.val = !IsASupport.after('/').before('[') + '[$!Check]'
            endif
            break
          elsehandle NONE
          endhandle
      enddo
      !!ce = !ce

--<wd>oct2005
-- Set the Modify Name Form Member .addremgroup
      if (!form.eq(!!mdsmodifyname)) then
        !form.addremgroup = 'ADD'
      endif
--<wd>oct2005


  elseif !Option.upcase().eq('REM') then

-- Check that gadget !!Mdsmodifyname.newname.val is not set to 'unset'
    if (!!Mdsmodifyname.name.val.lowcase() eq 'unset') then
      !!alert.error(|The Name of the Existing Support may NOT be 'unset'.Please Select support to modify name.|)
      return
    endif
-- Check to see if !Form.supportmem[1] exist
    !Supportname = !form.supportmem[1].name
    handle ANY
      !!Alert.error(|Please Select support to modify name|)
      return
    endhandle

-- Check to see if support a group type first
    if (!Supportname.match('[').gt(0) and !Supportname.match(']').gt(0)) then
      !GroupMemberlist = ARRAY()
      if !SupportName.dbref().type.eq(|STRU|) then
        --$P Group Support is STRU
        !stru = !SupportName.dbref()
        !Rootname = !SupportName.before('[')
        do !Gindex from 2 to 20
          $!RootName[$!Gindex]
          handle (2,109)
          elsehandle NONE
            !GroupMemberlist.append(!!ce)
          endhandle
        enddo
        if !GroupMemberlist.size().gt(0) then
          !!Alert.error('You must remove any other Group Members before removing Support $!SupportName from Group.')
          !!mdsmodifyname.newname.val = |unset|
          return
        else
          !!MDSModifyname.newname.val = !!mdsmodifyname.name.val.before('[')
          --!!MdsAutoName.GetNextName(!form)
        endif
      elseif   !SupportName.dbref().type.eq(|PLAT|) then
-- Group Support is trunnion, used MDSAutoname to give it a new name
        !!MdsAutoName.GetNextName(!form)

      elseif !SupportName.dbref().cref.unset() then
-- Group Support is Hanger, used MDSAutoname to give it a new name
        !!MdsAutoName.GetNextName(!form)

      elseif !SupportName.dbref().cref.type.eq(|HANG|) then
        -- Group Support is Hanger, used MDSAutoname to give it a new name
        !!MdsAutoName.GetNextName(!form)
        !!ce = !SupportName.dbref()
        --!!Mdsselectsupp('MODIFYNAME', 'CE','VERBOSE')

      endif

    else
      !!Alert.error(|$!SupportName is not a Group Support|)
      return
    endif

--<wd>oct2005
-- Set the Modify Name Form Member .addremgroup
      if (!form.eq(!!mdsmodifyname)) then
        !form.addremgroup = 'REMOVE'
      endif
--<wd>oct2005

  elseif !Option.upcase().eq('HIGHLIGHT') then
    if !form.name.val.matchwild('*[*]') and !form.newname.val.matchwild('*[*]').not() then
        !Support = '/' & !form.name.val & '/REST'
        UNENHANCE   $!Support
        handle NONE
          enhance $!Support col 2
        elsehandle ANY
        endhandle
    endif
  elseif !Option.upcase().eq('CHECKSTRUN') then
    if  !form.newname.val.matchwild('*[*]') then
      if !form.name.val.substring(1,1).neq('/') then
        !SupportName = '/' & !form.name.val
      else
        !SupportName = !form.name.val
      endif
      if !supportname.dbref().type.eq('STRU') then
        !Rootname = !form.newname.val.before('[')
        if !rootname.substring(1,1).neq('/') then
          !rootname = '/' & !rootname
        endif
        !MasterSupportName = !rootname & '[1]'
        !MasterSupport = !MasterSupportName.dbref()
        handle ANY
         elsehandle NONE
          !form.newname.val = 'unset'
          !!Alert.error(|$!MasterSupportName already exist as a Master Group support. Only 1 Structure allowed in a Group.|)
        endhandle
      endif
    endif
  else

    !!Alert.Error('Invalid option ($!Option) passed to !!MdsGroup.pmlnc')
    return

  endif
-- Call function to check if the OK gadget can be opened
  !!MdsNameGadget(!form)

-- End function
endfunction
