define function !!MdsHangBoreCheck()

rem all

/MDS/HANGERS

var !hang coll all hang for ce

!Counter = 0

do !check values !hang

-- Access Hanger

  !!ce = !check.dbref()

-- Get bore of hanger from name

  !Bore = !check.dbref().name.part(4,'/').real().bore()

-- Get head bore of hanger

  !hbore = hbore

-- get arrive bore from first pipe clamp if it exists

   pcla 1
    handle any
      skip
    endhandle

-- Check it is the first members in the list

  if !!ce.order.neq(1) then
    skip
  endif

  !pbore = pa bore

-- Compare bores are all the same

  hang
  !name = name

  if !Bore.string().eq(!hbore.string()) and !bore.string().eq(!pbore.string()) then
    -- $P ----
    $P $!bore $!hbore $!pbore
    -- $P $!name is OK
    -- $P ----
    skip
  else
    $P ----
    $P $!bore $!hbore $!pbore
    $P $!name is WRONG
    $P ----
-- Add to drawlist
    !Counter = !Counter + 1
    rest
    add ce
  endif

enddo

  $P There are $!counter errors

return
