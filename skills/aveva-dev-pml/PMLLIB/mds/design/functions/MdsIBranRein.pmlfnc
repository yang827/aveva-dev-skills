--
-- File:		MdsiBranRein.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for MdsBranRein.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIBranRein()

-- Reset Gadgets
  !!MdsBranRein.Name.val = 'unset'
  !!MdsBranRein.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsBranRein,'BRANREIN')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsBranRein.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsBranRein.view.active = false
      !!MdsBranRein.name.active = false
      !!MdsBranRein.autoname.active = false
      return
    elsehandle none
      !!MdsBranRein.view.active = true
      !!MdsBranRein.name.active = true
      !!MdsBranRein.autoname.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsBranRein)

-- Set the name gadget as the focus

  !!MdsBranRein.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file MdsiBranRein.pml
