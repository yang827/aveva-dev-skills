--
-- AVEVA Ltd Copyright feb 2005
--
-- File:      MdsInterfaceModAttaPos.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:   Fab 24 2005
--
--
-- Description:
-- function to reset a atta to its default position
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceModAttaPos(!attaref is DBREF,!mode is STRING, !form is FORM)

  !dynamicflag = FALSE

  !!ce = !attaref
  !config = !!ce.cref.owner.:USTHcfgKey
  handle ANY
    !licadconfig = 'UNSET'
  elsehandle NONE
    !split = !config.split('.')
    !licadconfig = !split[1] & !split[2]
    handle ANY
      !licadconfig = 'UNSET'
    endhandle
  endhandle

  PCLA 1 OF CREF
  handle NONE

    var !distance construct dist pa to pl
    !plcapos = !!ce.lposition.wrt( /* )
    -- dtf   >>> Mod to place clamp at correct position on a sloping line
    same
    !attapos = !!ce.position.wrt( /* )
    !extradist = '-1'
    !noOfHangers = !!ce.cref.owner.members.size()
    -- for   supports with cradle get the extra dist pa to pl of hanger element2
    if !noOfHangers.eq(2) and !licadconfig inset('LD10','LD12','LS73')then
      -- dynamic supports add offset for struts
      !dynamicflag = TRUE
      pin 3 at pa of last SCLA of Hang of cref of $!!ce
      !pclaldir = ldir of 1 of Hang of cref of $!!ce
      !mdir = !pclaldir.opposite()
      pin 1 copy pl of 1 of Hang of cref of $!!ce
      pin 1 dir $!mdir
      pin 2 copy pin 1
      pin 2 plane pin 2 thr pin 3
      var !extradist constr dist pin 1 to pin 2
    elseif !noOfHangers.eq(2) and !licadconfig inset('LD07','LD11','LS74')then
      -- dynamic supports add offset for struts
      !dynamicflag = TRUE
      pin 3 at pa of last SCLA of Hang of cref of $!!ce
      !mdir = ldir of 1 of Hang of cref of $!!ce
      pin 1 copy pl of 1 of Hang of cref of $!!ce
      pin 1 dir $!mdir
      pin 2 copy pin 1
      pin 2 plane pin 2 thr pin 3
      var !extradist constr dist pin 1 to pin 2
      !extradist  = '-' & !extradist
    elseif !noOfHangers.eq(2) then
      if type of 2 of Hang of cref of $!!ce neq ('EYNT') then
        pin 1 copy pa of 2 of Hang of cref of $!!ce
        pin 2 copy pl of 2 of Hang of cref of $!!ce
        var !p5dir p5 dir of 2 of hang of cref of $!!ce
        handle NONE
          pin 2 dir $!p5dir
          pin 2 plane $!p5dir thr pin 1
          var !extradist constr dist pin 1 to pin 2
        elsehandle ANY
        endhandle
      else
        !extradist = '-1'
      endif
    elseif !licadconfig inset('LD01')  then

      --if !!ce.cref.:MDSDynOffset.gt(0) then
      -- <RM> 30 Oct 06 -- fix 1 -- This gets the correct length to move the clamp by
      -- when we have an x offset for LD01s
      if !mode.upcase().eq('CREATE') then

        -- if a pad exists at the end of the hanger then
        -- account for this extra length in the calculation
        var !lastmemtype type of last mem of cref of $!!ce
        if !lastmemtype.upcase().eq('WPAD') then
          var !padheight desp 4 of last mem of cref of $!!ce
          !extralength = !padheight.real()
        else
          !extralength = 0
        endif
        var !clampdist para 5 of 3 of cref of $!!ce
        PIN 3 at $!form.support.tposition
        pin 3 dir $!form.support.tdir
        !clampmovedist = !clampdist.real() + !extralength
        pin 3 dist $!clampmovedist
        pin 5 copy pl of $!attaref
        pin 3 dir towards pin 5
        var !originaldist const dist pin 3 to pin 5
        var !pin3dir dir pin 3
        var !pldirect dir pin 5
        !offang = !pin3dir.direction().angle(!pldirect.direction())

        if !offang.real().gt(90) then
          !oang = 180 - !offang.real()
        else
          !oang = !offang.real()
        endif

        !b = !originaldist.real()
        !test = !b * !oang.cosine()
        !strutlength = !b * !oang.sine()
      else

        -- we find the intersection point on the pipe which is in a plane defined by the welded bracket
        pin 1 copy pa of 3 of cref of $!!ce
        var !sclampdir dir pin 1

        !tdir = !form.support.tdir
        !cross = !tdir.cross(!form.support.offsetx)
        !pv = object POINTVECTOR(!form.support.tposition,!cross)

        pin 2 copy pl of $!attaref
        var !attadir dir pin 2
        !pv1 = object POINTVECTOR(!attapos,!attadir.direction())
        !intersection = !pv1.intersection(!pv.plane())

        var !dist const dist $!attapos to $!intersection
        -- get a distance to move the atta from the current atta position to the intersection
        !test = !dist.real()

      endif
      -- <RM> 30 Oct 06 -- end of fix 1

      !angle = !!mdsInterfaceDynOffset.angleX.val

      if !!ce.cref.:MDSDynOffset.gt(0) then
        !amhere = !!ce
        if !angle.eq(0) then
          !!mdsInterfaceDynOffset.init(!form)
          hide !!mdsInterfaceDynOffset
          !angle = !!mdsInterfaceDynOffset.angleX.val
        endif
        !!ce = !amhere
      endif
      !extradist = '0'

    elseif !licadconfig inset('LD09') then
      -- dynamic supports add offset for struts ld09 and dynoffset set

      -- test copied from vendor -- may have to update
      !tdir = !form.support.tdir
      !upang = !tdir.angle( U wrt /* ).real()
      if !upang.gt(90) then
        !upang = 180 - !upang
      endif
      if !upang.gt(45) then
        !suppdir = 'VERT'
      else
        !suppdir = 'HORZ'
      endif

      if !mode.upcase().eq('CREATE') then

        -- if a pad exists at the end of the hanger then
        -- account for this extra length in the calculation
        var !lastmemtype type of last mem of cref of $!!ce
        if !lastmemtype.upcase().eq('WPAD') then
          var !padheight desp 4 of last mem of cref of $!!ce
          !extralength = !padheight.real()
        else
          !extralength = 0
        endif

        -- <RM> 12 Dec 06 -- TEST CODE TO TRY AND GET LD09 Y-OFFSET working
        -- if we have a y-offset then we need to go through the movement calculation
        -- as if the y-offset does not exist. therefore the existing movement code should
        -- already handle the clamp displacement in create mode.
        --if !suppdir.eq('VERT') then

        if !attaref.cref.:MdsDynOffY.gt(0.1) or !attaref.cref.:MdsDynOffY.lt(-0.1) and !attaref.cref.:MdsDynOffSet.gt(0.1) or !attaref.cref.:MdsDynOffSet.lt(-0.1) then

          -- work out where the tpos is without the y-offset
          !currentyoffset = !attaref.cref.:MdsDynOffY
          !currentxoffset = !attaref.cref.:MdsDynOffSet

          !offdir = !form.support.offsety
          !offdirpv = object POINTVECTOR(!form.support.tposition,!offdir)
          if !currentyoffset.gt(0) then
            !temppospv = !offdirpv.offset( -1 * !currentyoffset)
          else
            !temppospv = !offdirpv.offset( -1 * !currentyoffset )
          endif
          !temppos = !temppospv.position

          !offdir = !form.support.offsetx
          !offdirpv = object POINTVECTOR(!temppos,!offdir)
          if !currentxoffset.gt(0) then
            !derivedtpospv = !offdirpv.offset( -1 * !currentxoffset)
          else
            !derivedtpospv = !offdirpv.offset( -1 * !currentxoffset)
          endif
          !derivedtpos = !derivedtpospv.position

        elseif !attaref.cref.:MdsDynOffY.gt(0.1) or !attaref.cref.:MdsDynOffY.lt(-0.1) then

          -- work out where the tpos is without the y-offset
          !currentyoffset = !attaref.cref.:MdsDynOffY

          !offdir = !form.support.offsety
          !offdirpv = object POINTVECTOR(!form.support.tposition,!offdir)
          if !currentyoffset.gt(0) then
            !derivedtpospv = !offdirpv.offset( -1 * !currentyoffset)
          else
            !derivedtpospv = !offdirpv.offset( -1 * !currentyoffset )
          endif
          !derivedtpos = !derivedtpospv.position

          -- now check if we have an x-offset value

        elseif !attaref.cref.:MdsDynOffSet.gt(0.1) or !attaref.cref.:MdsDynOffSet.lt(-0.1) then

          -- work out where the tpos is without the x-offset
          !currentxoffset = !attaref.cref.:MdsDynOffSet

          !offdir = !form.support.offsetx
          !offdirpv = object POINTVECTOR(!form.support.tposition,!offdir)
          if !currentxoffset.gt(0) then
            !derivedtpospv = !offdirpv.offset( -1 * !currentxoffset)
          else
            !derivedtpospv = !offdirpv.offset( -1 * !currentxoffset)
          endif
          !derivedtpos = !derivedtpospv.position

        else

          !derivedtpos = !form.support.tposition

        endif

        var !clampdist para 5 of 3 of cref of $!!ce
        PIN 3 at $!derivedtpos
        -- <RM> 12 Dec 06 -- END OF TEST CODE TO TRY AND GET LD09 Y-OFFSET working
        pin 3 dir $!form.support.tdir
        !clampmovedist = !clampdist.real() + !extralength
        pin 3 dist $!clampmovedist
        pin 5 copy pl of $!attaref

        -- test to see if we have a vertical pipe
        var !pldirect dir pin 5 wrt /*
        !pipeupang = !pldirect.direction().angle( U wrt /* ).real()
        if !pipeupang.gt(90) then
          !pipeupang = 180 - !pipeupang
        endif
        if !pipeupang.gt(45) then
          !pipedir = 'HORZ'
        else
          !pipedir = 'VERT'
        endif

        if !pipedir.eq('HORZ') then
          -- we need a test to see if the ld09 is connecting to a horizontal surface (i.e. ceiling or floor)
          if !suppdir.eq('VERT') then
            -- this is the original code and needs to stay in
            pin 3 dir towards pin 5
            var !originaldist const dist pin 3 to pin 5
            var !pin3dir dir pin 3
            var !pldirect dir pin 5
            !offang = !pin3dir.direction().angle(!pldirect.direction())

            if !offang.real().gt(90) then
              !oang = 180 - !offang.real()
            else
              !oang = !offang.real()
            endif
            !b = !originaldist.real()
            !test = !b * !oang.cosine()
            !strutlength = !b * !oang.sine()
          else
            -- we have an ld09 connecting to a ceiling which is treated differently
            var !pldirect dir pin 5
            var !plpos pos pin 5 wrt /*
            var !pin3pos pos pin 3 wrt /*

            pin 3 dir towards pin 5
            var !pin3dir dir pin 3
            !offang = !pin3dir.direction().angle(!pldirect.direction())
            if !offang.real().gt(90) then
              !oang = 180 - !offang.real()
            else
              !oang = !offang.real()
            endif
            var !clampdist para 3 of 1 of cref of $!!ce

            !b = !clampdist.real()
            !extramovedist = !b / !oang.tangent()
            !test = !extramovedist
          endif
        else
          -- strut and welded bracket in line with pipe clamp rotated for all cases

          var !pldirect dir pin 5
          var !plpos pos pin 5 wrt /*
          var !pin3pos pos pin 3 wrt /*

          pin 3 dir towards pin 5
          var !pin3dir dir pin 3
          !offang = !pin3dir.direction().angle(!pldirect.direction())
          if !offang.real().gt(90) then
            !oang = 180 - !offang.real()
          else
            !oang = !offang.real()
          endif
          var !clampdist para 3 of 1 of cref of $!!ce

          !b = !clampdist.real()
          !extramovedist = !b / !oang.tangent()
          !test = !extramovedist

        endif
      else

        -- <RM> 12 Dec 06 -- TEST CODE TO TRY AND GET LD09 Y-OFFSET working
        -- if we have a y-offset then we need to go through the movement calculation
        -- as if the y-offset does not exist. therefore the existing movement code should
        -- already handle the clamp displacement in create mode.
        if !attaref.cref.:MdsDynOffY.gt(0.1) or !attaref.cref.:MdsDynOffY.lt(-0.1) then

          -- work out where the tpos is without the y-offset
          !currentyoffset = !attaref.cref.:MdsDynOffY

          !offdir = !form.support.offsety
          !offdirpv = object POINTVECTOR(!form.support.tposition,!offdir)
          if !currentyoffset.gt(0) then
            !derivedtpospv = !offdirpv.offset( -1 * !currentyoffset)
          else
            !derivedtpospv = !offdirpv.offset( -1 * !currentyoffset )
          endif
          !derivedtpos = !derivedtpospv.position
        else

          !derivedtpos = !form.support.tposition

        endif

        -- we find the intersection point on the pipe which is in a plane defined by the welded bracket
        pin 1 copy pa of 3 of cref of $!!ce
        var !sclampdir dir pin 1

        !tdir = !form.support.tdir
        !cross = !tdir.cross(!form.support.offsetx)
        !pv = object POINTVECTOR(!derivedtpos,!cross)

        pin 2 copy pl of $!attaref
        var !attadir dir pin 2
        !pv1 = object POINTVECTOR(!attapos,!attadir.direction())
        !intersection = !pv1.intersection(!pv.plane())

        var !dist const dist $!attapos to $!intersection
        -- get a distance to move the atta from the current atta position to the intersection
        !test = !dist.real()

      endif
      -- <RM> 30 Oct 06 -- end of fix 1

      !angle = !!mdsInterfaceDynOffset.angleX.val

      if !!ce.cref.:MDSDynOffset.gt(0) then
        !amhere = !!ce
        if !angle.eq(0) then
          !!mdsInterfaceDynOffset.init(!form)
          hide !!mdsInterfaceDynOffset
          !angle = !!mdsInterfaceDynOffset.angleX.val
        endif
        !!ce = !amhere
      endif
      !extradist = '0'
    else
      !extradist = '0'
    endif

    if !mode.eq('MODIFY') then
      !direction = !!mdsInterfaceGetMoveDir(!!ce,!mode,!form)
      !movedir = !direction[2].direction().string()
    elseif !mode.eq('CREATE') then
      -- CREATE mode
      !rotated = FALSE
      !ldTest = !licadconfig.match('LD').gt(0)
      handle ANY
      elsehandle NONE
        if !form.support.tposition.up.nint().lt(!attaref.up.nint()) and !ldTest then
          pcla 1 of cref
          rotate about pa by 180
          !plcapos = !!ce.lposition.wrt( /* )
          same
          !rotated = TRUE
        elseif !form.support.tposition.up.nint().eq(!attaref.up.nint()) then
          --$P equal
        endif
      endhandle
      !direction = !!mdsInterfaceGetMoveDir(!!ce,!mode,!form)
      !movedir = !direction[2]

    endif

    if !dynamicflag then
      !movedir = !movedir.direction().opposite().string().before('WRT')
      handle ANY
      endhandle
    endif

    if !extradist.real().neq(-1) then
      !!ce = !attaref
      !pipeAngle = !direction[3]
      if !pipeAngle.lt(.1) then
        -- if pipe running parallel to wall etc but on a slope
        !splitldir = !!ce.ldir.string().before(' WRT').split(' ')
        if !splitldir.size().eq(5) then
          !pipeAngle = !splitldir[4].real()
        elseif !splitldir.size().eq(3) then
          !pipeAngle = !splitldir[2].real()
        else
          !pipeAngle = 0
        endif
      endif

      if !pipeAngle.unset().not() then

        !aDist = ((!distance.real() + !extradist.real()) * (tan ($!pipeAngle) ) )
        if !aDist.lt(0) then
          !aDist = !aDist * -1
        endif
        -- <RM> 30 Oct 06 -- fix 2 -- apply calculated atta move distance from fix 1 when we have an LD01 with an X-Offset
        if !licadconfig inset('LD01') or !licadconfig inset('LD09') then
          !aDist = !test
          if !mode.upcase().eq('CREATE') then
            -- get the correct direction to move based upon which is nearer to the correct strut length required
            pin 5 copy pl of $!attaref
            pin 6 copy pa of $!attaref
            PIN 3 at $!form.support.tposition
            -- <RM> 27 January 2007 -- included this fix to stop ld09 y-offsets
            -- causing the atta  to move the wrong way along the pipe
            if !licadconfig inset('LD09') then
              PIN 3 at $!derivedtpos
            endif
            -- <RM> 27 January 2007 -- end of fix
            pin 3 dir $!form.support.tdir
            PIN 3 dist $!clampdist
            pin 5 dist $!aDist
            pin 6 dist $!aDist
            var !dist1 const dist pin 3 to pin 5
            var !dist2 const dist pin 3 to pin 6
            !unusedTestStrut = !strutlength
            handle ANY
              !strutlength = 0
            endhandle

            !diff1 = !strutlength - !dist1.real()
            !diff2 = !strutlength - !dist2.real()

            if !diff1.abs().lt(!diff2.abs()) then
              var !movedir dir pl of $!attaref
            else
              var !movedir dir pa of $!attaref
            endif
          endif
        endif
        -- <RM> 30 Oct 06 -- end of fix 2
        move $!movedir dist $!aDist
        handle ANY
          -- hanger tail direction is not up or down
        elsehandle NONE
          pin 5 at ce
          !q = !!ce.cref.tposition
          pin 6 at $!q
        endhandle
      endif
    endif

    if !mode.eq('CREATE') then
      !attaname = !attaref.name
      do !loopThroughHangers from 1 to 5
        $!attaname/H$!loopThroughHangers
        handle NONE
          move ph $!movedir dist $!aDist
          handle ANY
            -- hanger tail direction is not up or down
          elsehandle NONE
            !members = mcount
            --$P $!mode HANG $!movedir, $!aDist  $!distance $!extradist
            do !moveMem from 1 to !members
              hang
              $!moveMem
              move $!movedir dist $!aDist
            enddo
            end
            pos ht at PL OF last mem
          endhandle
        elsehandle ANY
        endhandle
      enddo
    endif

  elsehandle ANY
  endhandle

endfunction
