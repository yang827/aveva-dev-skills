--
-- File:    MdsInterfaceSetOffsetDir.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   Tues 22 Feb
--
--
-- Description:
-- function to set the offset directions
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R       DBREF         atta of the hanger being created
--     2      R       FORM          the current mdsinterfaceform i.e. mdshangertype1
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceSetOffsetDir(!atta is DBREF, !form is FORM)

  !supportName = name of $!atta
  !dynamicparallel = FALSE

  -- <RM> 22/02/07 -- need a test for dynamic parallel, the following was taken from mdsvendor and may need refinement
  !directions = !!mdsremovegrad(!atta)
  if !form.support.tdir.set() then
    if !directions[1].eq(!form.support.tdir) or !directions[1].eq(!form.support.tdir.opposite()) then
       !dynamicparallel =  TRUE
    elseif !directions[1].angle(!form.support.tdir).gt(179.9) and !directions[1].angle(!form.support.tdir).lt(180.1) then
       !dynamicparallel =  TRUE
    elseif !directions[1].angle(!form.support.tdir).gt(-0.1) and !directions[1].angle(!form.support.tdir).lt(0.1) then
       !dynamicparallel =  TRUE
    endif
  endif
  -- <RM> 22/02/07 -- end of fix

$(
  -------------------------------------------------------------------------------
  --START OF TEST CODE TO TRY AND GENERALISE THE X-Y OFFSET DIRECTION ALLOCATION--
  -------------------------------------------------------------------------------

  -- we need a pointvector at tpos with orientation tdir so we can define a plane from it

  !tpos = tpos of $!supportName/H1 wrt /*
  !tdir = pt dir of $!supportName/H1 wrt /*

  !pvtdir = object POINTVECTOR( !tpos, !tdir)

  -- we need a pointvector at the datum atta with orientation pleave so we can define a plane from it

  !attapos = pos of $!atta wrt /*
  !pleavedir = pl dir of $!atta wrt /*

  !pvpldir = object POINTVECTOR( !attapos, !pleavedir )

  -- get the line intersect on the plane, this will give us the x-direction

  !intline = !pvtdir.plane().intersection(!pvpldir.plane())

  !form.support.offsetx = !intline.direction()

  -- cross the x-direction with the tdir and this gives us y-direction

  !form.support.offsety = !intline.direction().cross(!tdir)
  $)
  -------------------------------------------------------------------------------
  --END OF TEST CODE-------------------------------------------------------------
  -------------------------------------------------------------------------------
  -- NOTE THE ABOVE CODE SHOULD WORK FINE BUT THERE SEEMS TO BE A PROBLEM -------
  -- WITH THE PLANE.INTERSECTION(PLANE) COMMAND WHICH IS PRODUCING ERRORS -------
  -------------------------------------------------------------------------------


  ------------------------------------------------------------------------------------
  -- NOTE THE FOLLOWING IS NOT FINAL CODE AND MUST BE REMOVED FOLLOWING SUCCESSFUL
  -- IMPLEMENTATION OF THE PLANE INTERSECTION FIX THAT MAY APPEAR
  ------------------------------------------------------------------------------------

  ------------------------------------------------------------------------------------
  -- TEMPORARY CODE TO TRY AND MAKE THIS FUNCTION WORK BEFORE THE CORE CODE IS FIXED--
  ------------------------------------------------------------------------------------

  -- we need a pointvector at tpos with orientation tdir so we can define a plane from it

  !tpos = tpos of $!supportName/H1 wrt /*
  !tdir = pt dir of $!supportName/H1 wrt /*
  !pvtdir = object POINTVECTOR( !tpos, !tdir)

  -- we need a pointvector at the datum atta with orientation pleave so we can define a plane from it

  !attapos = pos of $!atta wrt /*
  !pleavedir = pa dir of $!atta wrt /*

  if !dynamicparallel.not() then
    !pvpldir = object POINTVECTOR( !attapos, !pleavedir )
  else
    -- get the p9 direction of the atta
    var !p9dir p9 dir of $!atta wrt /*
    !p9plcross = !p9dir.direction().cross(!pleavedir)
    !pvpldir = object POINTVECTOR( !attapos, !p9plcross )
  endif

  -- get the line intersect on the plane, this will give us the x-direction

  --!intline = !pvtdir.plane().intersection(!pvpldir.plane())

  --!form.support.offsetx = !intline.direction()
  --handle any
    -- we are picking up a dodgy error that looks like core pml2 problem with the plane
    -- so we will use a non preffered method of getting x-direction
    !pvplplaneori = !pvpldir.plane().orientation

    !xdir = !pvplplaneori.xdir()
    !ydir = !pvplplaneori.ydir()

    !planedirs = ARRAY()

    !planedirs.append(!xdir)
    !planedirs.append(!ydir)
    !planedirs.append(!xdir.opposite())
    !planedirs.append(!ydir.opposite())

    -- bisect these values to create a number of directions we can project onto the
    -- tdir plane
    !arrayvals = ARRAY()

    -- do this loop twice so we get 16 directions
    do from 1 to 2 by 1
      !size = !planedirs.size()
      !newindex = !size * 2
      !k = 0
      -- loop through the original array values and where we have an odd
      -- index value we add the old array value to the new array
      -- where we have an even value we bisect between the current array value
      -- and the next
      do !j from 1 to !newindex by 1
        !eventest = !j / 2
        !eventestint = !eventest.nint()
        if !eventest.eq(!eventestint) then
          !test = !k + 1
          if !test.gt(!size) then
            !arrayvals[!j] = !planedirs[!k].bisect(!planedirs[1])
          else
            !arrayvals[!j] = !planedirs[!k].bisect(!planedirs[!k + 1])
          endif
        else
          !k = !k + 1
          !arrayvals[!j] = !planedirs[!k]
        endif
      enddo

      --assign arrayvals to !planedirs therefore storing the new values
      !planedirs = !arrayvals

    enddo

    do !a values !planedirs
      !num = 1
      !projectiondir = !a

      -- create pointvector at !attapos with direction !projectiondir
      !pv1 = object POINTVECTOR(!attapos, !projectiondir)

      -- project pv onto the tdir plane
      !inter1 = !pv1.intersection(!pvtdir.plane())
      handle ANY
        !num = !num + 1
        skip
      elsehandle none
        break
      endhandle
    enddo

    !flip = FALSE

    do !a from 1 to !planedirs.size()

      !projectiondir2 = !planedirs[!a]
      if !projectiondir2.eq(!projectiondir) then
        skip
      endif
      -- create pointvector at !attapos with direction !projectiondir
      !pv2 = object POINTVECTOR(!attapos, !projectiondir2)

      -- project pv onto the tdir plane
      !inter2 = !pv2.intersection(!pvtdir.plane())
      handle ANY
        skip
      elsehandle none
        if !a.neq(!num + 1) then
          !flip = TRUE
        endif
        break
      endhandle

    enddo

    -- we will have to flip the direction of the offset if the test above uses
    -- non-consecutive index values
    if !flip.eq(FALSE) then
      !xoffdir = !inter2.direction(!inter1)
    else
      !xoffdir = !inter1.direction(!inter2)
    endif

    if !dynamicparallel then
      -- we need to swap directions in case of a dynamic parallel case
      !form.support.offsety = !xoffdir
      !form.support.offsetx = !xoffdir.cross(!tdir)
    else
      !form.support.offsetx = !xoffdir
      !form.support.offsety = !xoffdir.cross(!tdir)
    endif

  --elsehandle NONE
    -- cross the x-direction with the tdir and this gives us y-direction
  --  !form.support.offsety = !intline.direction().cross(!tdir)
  --endhandle


  -----------------------------------------------------------------------------------------
  -- END TEMPORARY CODE TO TRY AND MAKE THIS FUNCTION WORK BEFORE THE CORE CODE IS FIXED --
  -----------------------------------------------------------------------------------------

  if !form.support.tdir.unset() then
    !form.support.tdir.unset() = !atta.cref.tdir.wrt( /* )
  endif

  !!mdsResetPins(6,9)

-- End function
endfunction
