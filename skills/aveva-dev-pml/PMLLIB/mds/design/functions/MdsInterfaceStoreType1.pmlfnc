--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceStoreType1()

  -- Initialise variables
  !!mdsHangerType1.store.clear()

  -- Store original atta despars, orientation
  !!mdssaveattainf(!!mdsHangerType1)

  -- Store relevant gadget information
  !!mdsHangerType1.store.append(|!!mdsHangerType1.dist.val = $!!mdsHangerType1.dist.val|)
  !!mdsHangerType1.store.append(|Call !!mdsInterfacePosDist(!!mdsHangerType1)|)

  -- Store support object
  !!mdsHangerType1.backup = !!mdsHangerType1.support

  -- End function
endfunction
