-- Define Function
define function !!mdsInterfaceStoretype20()

  -- Initialise variables
  !!mdsHangertype20.store.clear()

  -- Store original atta despars, orientation
  !!mdssaveattainf(!!mdsHangertype20)

  -- Store relevant gadget information
  !!mdsHangertype20.store.append(|!!mdsHangertype20.dist.val = $!!mdsHangertype20.dist.val|)
  !!mdsHangertype20.store.append(|Call !!mdsInterfacePosDist(!!mdsHangertype20)|)

  -- Store support object
  !!mdsHangertype20.backup = !!mdsHangertype20.support

  -- End function
endfunction
