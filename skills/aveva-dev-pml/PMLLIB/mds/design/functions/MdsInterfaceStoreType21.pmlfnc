-- Define Function
define function !!mdsInterfaceStoretype21()

  -- Initialise variables
  !!mdsHangertype21.store.clear()

  -- Store original atta despars, orientation
  !!mdssaveattainf(!!mdsHangertype21)

  -- Store relevant gadget information
  !!mdsHangertype21.store.append(|!!mdsHangertype21.dist.val = $!!mdsHangertype21.dist.val|)
  !!mdsHangertype21.store.append(|Call !!mdsInterfacePosDist(!!mdsHangertype21)|)

  -- Store support object
  !!mdsHangertype21.backup = !!mdsHangertype21.support

  -- End function
endfunction
