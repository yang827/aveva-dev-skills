--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceStoretype6()

  -- Initialise variables
  !!mdsHangertype6.store.clear()

  -- Store original atta despars, orientation
  !!mdssaveattainf(!!mdsHangertype6)

  -- Store relevant gadget information
  !!mdsHangertype6.store.append(|!!mdsHangertype6.dist.val = $!!mdsHangertype6.dist.val|)
  !!mdsHangertype6.store.append(|Call !!mdsInterfacePosDist(!!mdsHangertype6)|)

  -- Store support object
  !!mdsHangertype6.backup = !!mdsHangertype6.support

  -- End function
endfunction
