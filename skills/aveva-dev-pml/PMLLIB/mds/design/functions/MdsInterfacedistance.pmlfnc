--
-- File:  MdsInterfacedistance.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          UDIST
--
-- Author:  I.osborne
-- Created:  Tue May 27
--
--
-- Description:
-- function to determine distance from ce to prev
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceDistance(!form is FORM)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  var !mode MODE

  -- dtf >>> 16.09.04
  -- Get prev component not associated with support

  !datum = !form.support.datum
  !suppName = !datum.name.before('/DATUM')

  !ceref = !!ce
  do to 10
    if (!mode eq |Forwards|) then
      prev
      handle ANY
        if (!form.support.datum.stype inset ('LT08B','LT08C')) then
          end
          goto href
          prev
          handle ANY
            !prev = ref of bran
            !!ce = !ceref
            !dist = !!kStrReal('CONST DIST P0 OF CE TO PH')
            break
          elsehandle NONE
            !!mdsSilent = TRUE
            !prevSuppName = !!mdsGetSuppName(!!ce)
            !!mdsSilent.delete()
            if (!prevSuppName NEQ !suppName ) then
              !prev = !!ce
              !!ce = !ceref
              !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!prev')
              break
            endif
          endhandle
        else
          !prev = ref of bran
          !!ce = !ceref
          !dist = !!kStrReal('CONST DIST P0 OF CE TO PH')
          break
        endif
      elsehandle NONE
        !!mdsSilent = TRUE
        !prevSuppName = !!mdsGetSuppName(!!ce)
        !!mdsSilent.delete()
        if (!prevSuppName NEQ !suppName ) then
          !prev = !!ce
          !!ce = !ceref
          !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!prev')
          break
        endif
      endhandle
    else
      next
      handle ANY
        !next = ref of bran
        !!ce = !ceref
        !dist = !!kStrReal('CONST DIST P0 OF CE TO PT')
        break
      elsehandle NONE
        !nextSuppName = !!mdsGetSuppName(!!ce)
        if (!nextSuppName NEQ !suppName ) then
          !next = !!ce
          !!ce = !ceref
          !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!next')
          break
        endif
      endhandle
    endif
  enddo

$(
if (!mode eq |Forwards|) then
!dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF PREV')
handle any
!dist = !!kStrReal('CONST DIST P0 OF CE TO PH')
endhandle
else
!dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF NEXT')
handle any
!dist = !!kStrReal('CONST DIST P0 OF CE TO PT')
endhandle
endif
$)

  -- dtf <<< End of mod
  if (!form.support.datum.stype inset ('AT60')) then
    golabel /labelat60
  else
    if (!dist eq 0) then
      !form.dist.val = 0
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- In case with a thro command for instance the atta might
  -- be behind the orign therefore we have to negate the value

  if !!ce.order.neq(1) then
    PIN 9 COPY PL OF PREV
    PIN 9 AT P0 OF PREV
  else
    PIN 9 COPY PH
    PIN 9 AT PH
  endif

  PIN 8 COPY PL

  var !dir CONST DIR PIN 9 TO PIN 8
  if (!dir eq ||) then
    !form.dist.val = !dist
    !!kRestoreUnits(!currentUnits)
    return
  endif

  PIN 9 DIR $!dir WRT WORLD
  var !p8dir PIN 8 DIR WRT WORLD

  !checkDir = object KEQUALDIR()
  !checkDir.directionA = !dir.direction()
  !checkDir.directionB = !p8dir.direction()
  !checkDir.tolerance  = 0.05

  if (!!kDirEqualDir(!checkDir)) then
    !form.dist.val = !dist
  else
    !form.dist.val = !dist - !dist - !dist
  endif

  label /labelat60

  Call !!mdsResetPins(8,9)

  -- reset units
  !!kRestoreUnits(!currentUnits)
  -- End function
endfunction
