--
--
-- Description:
-- function to navigate to the main support member
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMainMember()

-- Get support name of ce

  !SupportName = !!MdsGetSuppName(!!CE)

-- Is it a support

  if !SupportName.eq('ABORT') then
    --!!Alert.Error('Current Element is not a support')
    return
  endif

-- Navigate to support, but if a group navigate to [1]

  if !SupportName.match('[').gt(1) then
    !SupportName = !Supportname.before('[') & '[1]'
  endif

  !!ce = !SupportName.dbref()
    handle any
      !!Alert.Error('Unable to navigate to master support member $!Supportname')
    endhandle

-- End function
endfunction

-- End of file MdsMainMember.pmlfnc
