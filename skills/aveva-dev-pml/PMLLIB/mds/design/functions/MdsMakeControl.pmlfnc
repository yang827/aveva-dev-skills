--
--
-- Description:
-- function to make a support controlled in Model Manager
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMakeControl()

-- Check if the current element is a support

  !NameOfSupport = !!MdsGetSuppName(!!CE)
  if !NameOfSupport.eq('ABORT') then
    !!Alert.Error('Unable to locate a support from current element')
    return
  endif

-- Is model manager loaded

  if (undefined(!!MmsInterface)) then
    !!Alert.Error('Unable to make support $!NameOfSupport controlled as the model manager application is not loaded.')
    return
  endif

-- OK send it to model manager

  !!MdsDacControl(TRUE)
  !!mmsinterface.MakeObjectControlled(!NameOfSupport)
  !!MdsDacControl(FALSE)

-- End function
endfunction

-- End of file MdsMakeControl.pmlfnc
