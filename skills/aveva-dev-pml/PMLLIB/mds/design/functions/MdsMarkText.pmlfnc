--
-- File:		MdsMarkText.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Tues July 8
--
--
-- Description:
-- Adds the graphical markers to a support and create the !Form.Support.Atta list
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       FORM          Form Name
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMarkText(!Form is FORM)

-- User is positioned at the datum atta when this function is activated

  var !pos pos wrt world

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  do !count from 211 to 259

    var !num ($!count - 210)
    !SupportName = !Form.Support.Stru.Name
    !AttaName = !SupportName & '.' & !Num
    !!CE = !AttaName.dbref()
      handle any
        skip
      endhandle

-- Store Atta reference in form

    !Form.Support.Atta.append(!!CE)
    var !pos pos wrt world
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

  enddo

-- End function

endfunction
-- End of file MdsMarkText.pmlfnc
return
