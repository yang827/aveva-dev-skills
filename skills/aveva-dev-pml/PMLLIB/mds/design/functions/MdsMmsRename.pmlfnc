--
--
-- Description:
-- Function to rename a support from Model Manager
--
-- This function is called from Model Manager mmsMdsRename.pmlfnc when renaming an MDS support
-- It is in MDS so that it can be maintained in future in line with the MDS rename form callbacks
-- The MM function has code to rename the support which it will use if this MDS function is not yet available
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         MDS structure
--     2     R        STRING        New name
--
-- Return:
--    [Data Type]   [Description]
--     REAL          Flag =0 failure =1 success
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMmsRename(!support is DBREF, !newName is STRING) is REAL

  -- If the MDS application has not been entered then reject the request to rename a support.
  if undefined(!!mDSIdSatt) then
    !!error.text = 'Unable to rename support $!support as the MDS application has not been entered'
    return 0
  endif

  -- Show MDS rename form
  !!ce = !support
  !!mdsimodifyname('NAMEONLY')

  -- Set old name and run callback
  !oldName = !support.name
  !!mdsmodifyname.name.val = !support.namn
  !!mdsselectsupp('MODIFYNAME', 'NAME','VERBOSE')

  -- Set new name and run callback
  !!mdsmodifyname.newName.val = !newName.after('/')
  !!kactioncommands(!!mdsmodifyname.anewname)

  -- Apply form and then dismiss it
  !!kactioncommands(!!mdsmodifyname.applyform)
  !!kactioncommands(!!mdsmodifyname.dismissform)
  hide !!mdsmodifyname

  -- Check if rename has worked
  !!ce = !support
  if (!!ce.name eq !oldName) then
    !!error.text = 'Support $!support has not been renamed'
    !return = 0
  else
    !return = 1
  endif
  return !return

-- End function
endfunction
