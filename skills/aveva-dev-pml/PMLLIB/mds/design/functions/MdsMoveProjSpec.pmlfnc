--
-- File:  MdsMoveProjSpec.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Neale Morris
-- Created:  Monday 21st Jan 2004
--
--
-- Description:
-- function to move an exist special member of joint
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMoveProjSpec(!form is FORM)

  -- Initialise variables
  !stru    = !form.support.stru

  -- Does the special contain any members yet

  var !members coll all sctn for $!stru
  if !members.unset() then
    !!alert.error('The special does not contain any members to move')
    return
  endif

  -- Identify the joint/section to copy if there is more than one

  !!ce = !stru
  !mirror = !!ce.:MDSFraMirror
  if !mirror then
    !whichEnd = 'drns'
    !extendEnd = 'start'
  else
    !whichEnd = 'drne'
    !extendEnd = 'end'
  endif
  var !coll coll all sctn with :MdsSplAdjust neq -1 for ce

  if !coll.size().eq(1) then
    !joint = !coll[1].dbref()
    !mdsSplAdjust = :MdsSplAdjust of $!joint
  else

    prompt off
    prompt load escape 'Identify section/joint to move'
    ID SCTN @
    handle (61,528)
      prompt on
      return
    endhandle
    prompt on
    !joint = !!ce
    !mdsSplAdjust = :MdsSplAdjust
  endif

  -- Does the section belong to the special

  stru
  if !!ce.name.neq(!stru.name) then
    !!alert.error('The section/joint identified does not belong to the special ' + !stru.name)
    return
  endif

  !!ce = !joint

  if !!ce.:MdsSplAdjust.eq(-1) then
    !!alert.error('The section/joint identified cannot be moved')
    return
  endif

  --!units = object COMUNITS(TRUE)

  -- Turn DAC control on
  !!mdsDacControl(true)

  -- Identify the element to move the joint to using the stru z direction
  label /identify

  !!ce = !stru
  prompt off
  prompt load escape 'Identify element to move to'
  ID @
  handle (61,528)
    prompt on
    return
  endhandle
  prompt on
  !moveTo = !!ce

  --<ge>03Nov2004
  -- Navigate to PLOO of Identified Element if the hard type is PANE.
  -- If the PANE has SBFI that extend past the PANE then the SCTN's
  -- were extending to these. Fix for Framatome
  if (!!ce.hardtype EQ 'PANE') then
    ploo 1
    !moveTo = !!ce
  endif
  --<ge>03Nov2004


  --<wd>18mar2004
  -- Navigate to STRU of Identified Element if possible.
  stru
  handle NONE
    -- Check & Reject if Identified Element - !moveTo - belongs to the Current SPECIAL Structure
    !idstru = !!ce
    if (!idstru.eq(!stru)) then
      !!alert.error('Identified element belongs to the current SPECIAL structure being created. Identify another element.')
      golabel /identify
    endif
  elsehandle ANY
    -- Identified element - !moveTo - does NOT belong to a STRUCTURE
    -- Therefore allow the process to continue.
  endhandle
  --<wd>18mar2004


  -- Navigate to the Current SPECIAL Structure.
  !!ce = !stru

  if !mdsSplAdjust.eq(3) then
    -- If its 3 then we need to find the direction from the section and the nearest
    -- end
    !!ce = !joint
    !poss = poss
    !pose = pose
    !drns = drns wrt /*
    !drne = drne wrt /*
    --<tm> 09/09/2004 mod to enable mirrored sections to extend
    if !mirror then
      pin 8 at $!pose
      pin 9 at $!poss
      pin 7 dir $!drne
    else
      pin 8 at $!poss
      pin 9 at $!pose
      pin 7 dir $!drns
    endif
    pin 7 at pin 8
    pin 7 plane pin 7 thro $!moveTo
    var !pin78dist const dist pin 7 to pin 8
    var !pin79dist const dist pin 7 to pin 9
    --<tm> 09/09/2004
    if !pin78dist.real().lt(!pin79dist.real()) then
      !!alert.error('Unable to move selected section, you may need to rotate the support first')
      !!mdsResetPins(7,9)
      return
    else
      --<tm> 09/09/2004 mirror mod
      if !mirror then
        !whichEnd = 'drns'
        !extendEnd = 'start'
      else
        !whichEnd = 'drne'
        !extendEnd = 'end'
      endif
      --<tm> 09/09/2004
    endif
    !moveDirection = $!whichEnd wrt /*
    handle (2,779)
      !moveDirection = axis $!whichEnd wrt /*
    endhandle
  else
    !!ce = !joint
    if !mdsSplAdjust.eq(1)   then
      if !mirror then
        !moveDirection = drne of $!joint wrt /*
        pin 8 at pose
      else
        !moveDirection = drns of $!joint wrt /*
        pin 8 at poss
      endif
    elseif !mdsSplAdjust.eq(2) then
      if !mirror then
        !moveDirection = drns of $!joint wrt /*
        pin 8 at poss
      else
        !moveDirection = drne of $!joint wrt /*
        pin 8 at pose
      endif
    else
      !moveDirection = z wrt /*
      pin 8 at ce
    endif
    pin 8 dir $!moveDirection
    pin 8 plane pin 8 clear 0 behind ce
    pin 9 copy pin 8
    pin 8 plane pin 8 clear 0 inf $!moveTo
    var !distToMove const dist pin 9 to pin 8
    var !pin9Pos pin 9 pos wrt /*
    var !pin8pos pin 8 pos wrt /*
  endif

  if !mdsSplAdjust.eq(0) then
    if !pin9Pos.part(5).eq('U') then
      if !pin9Pos.part(6).real().gt(!pin8pos.part(6).real()) then
        move $!moveDirection dist -$!distToMove
      else
        move $!moveDirection dist $!distToMove
      endif
    else
      if !pin9Pos.part(6).real().gt(!pin8pos.part(6).real()) then
        move $!moveDirection dist $!distToMove
      else
        move $!moveDirection dist -$!distToMove
      endif
    endif
  elseif !mdsSplAdjust.eq(1) then
    -- Check to see if we are not trying to move it the opposite size of where it is supposed to go
    if !mirror then
      pin 9 at pose
      pin 8 at poss
      pin 9 dir drns
      pin 8 dir drne
      !extendEnd = 'end'
    else
      pin 9 at poss
      pin 8 at pose
      pin 9 dir drne
      pin 8 dir drns
      !extendEnd = 'start'
    endif
    pin 9 plane pin 9 clear 0 inf $!moveTo
    var !pin8pin9dir const direction pin 8 to pin 9
    var !pin8dir pin 8 dir wrt /*
    if !pin8pin9dir.eq(!pin8dir) then
      !!alert.error('Unable to reposition section start as it is on other side of support, you may need to rotate the support')
      return
    endif
    --    extend start inf $!moveTo
    if !mirror then
      extend $!extendEnd inf $!moveTo
    else
      extend $!extendEnd beh $!moveTo
    endif
  elseif !mdsSplAdjust.eq(2) then
    -- Check to see if we are not trying to move it the opposite size of where it is supposed to go
    if !mirror then
      pin 9 at poss
      pin 8 at pose
      pin 9 dir drne
      pin 8 dir drns
      --!extendEnd = end
    else
      pin 9 at pose
      pin 8 at poss
      pin 9 dir drns
      pin 8 dir drne
      --!extendEnd = start
    endif
    pin 9 plane pin 9 clear 0 inf $!moveTo
    var !pin8pin9dir const direction pin 8 to pin 9
    var !pin8dir pin 8 dir wrt /*
    if !pin8pin9dir.eq(!pin8dir) then
      !!alert.error('Unable to reposition section end as it is on other side of support, you may need to rotate the support')
      return
    endif
    --    extend end inf $!moveTo
    if !mirror then
      extend $!extendEnd beh $!moveTo
    else
      extend $!extendEnd inf $!moveTo
    endif
  elseif !mdsSplAdjust.eq(3) then
    if !mirror then
      extend $!extendEnd beh $!moveTo
    else
      extend $!extendEnd inf $!moveTo
    endif
  elseif !mdsSplAdjust.eq(4) then
    --Moves with another member
    if !pin9Pos.part(6).real().gt(!pin8pos.part(6).real()) then
      move $!moveDirection dist -$!distToMove
      !moveString = 'move $!moveDirection dist -$!distToMove'
    else
      move $!moveDirection dist $!distToMove
      !moveString = 'move $!moveDirection dist $!distToMove'
    endif
    sjoi 1 of snod 1
    handle NONE
      goto cref
      handle NONE
        $!moveString
      elsehandle ANY
      endhandle
    elsehandle ANY
    endhandle
  endif

  stru
  reconn recalc
  handle ANY
  endhandle

  -- Reset Pins
  !!mdsResetPins(7,9)

  -- If the user selects a SBFI (subfitting) then ask him if he wants to make the connection

  !!mdsSbfiConn('CREATE',!joint,!moveTo,'VERBOSE')

  !!ce = !stru

  -- Turn DAC control off
  !!mdsDacControl(false)

  -- End function
endfunction
