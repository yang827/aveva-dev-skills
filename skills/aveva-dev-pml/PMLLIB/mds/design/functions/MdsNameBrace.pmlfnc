--
-- File:		MdsNameBrace.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Monday 2nd December 2002
--
--
-- Description:
-- Function to create a bracing section. This uses the bracing configurations
-- form from the steelwkr application. it back fills the form for use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsNameBrace(!Form is form)

-- Close down EDG packet

  !!edgCntrl.canvasPick( !!GPH3DDESIGN1.VIEW, |ESCAPE| )

-- Force into forwards mode
  FORWARDS

-- Access structure

  !!ce = !Form.Support.Stru
  !SupportName = !form.Support.Stru.name

-- Find unnamed sections

  var !sctns coll all sctn for ce

  do !name values !sctns
    !!ce = !name.dbref()
    if !!ce.name.substring(1,1).eq('=') then
      do !Count from 1 to 20
        name $!SupportName$n-BRACE-$!Count
          handle any
            skip
          elsehandle none
            break
          endhandle
      enddo
    endif
  enddo

  !!cdBracin2.Dismiss.callback = ''

  stru

endfunction

-- End of file MdsNameBrace.pml
