define function !!MdsNewComp(!Type is STRING, !newname is STRING, !oldname is STRING)

  !Range = ARRAY()

  !Range.append('6')
  !Range.append('8')
  !Range.append('10')
  !Range.append('15')
  !Range.append('20')
  !Range.append('25')
  !Range.append('32')
  !Range.append('40')
  !Range.append('50')
  !Range.append('65')
  !Range.append('80')
  !Range.append('100')
  !Range.append('125')
  !Range.append('150')
  !Range.append('200')
  !Range.append('250')
  !Range.append('300')
  !Range.append('350')
  !Range.append('400')
  !Range.append('450')
  !Range.append('500')
  !Range.append('550')
  !Range.append('600')
  !Range.append('650')
  !Range.append('700')
  !Range.append('750')
  !Range.append('800')
  !Range.append('850')
  !Range.append('900')
  !Range.append('950')
  !Range.append('1000')
  !Range.append('1050')
  !Range.append('1100')
  !Range.append('1150')
  !Range.append('1200')

  !Sizes = ARRAY()

  !Sizes.Append('6 10 ATT')
  !Sizes.Append('8 14 ATT')
  !Sizes.Append('10 17 ATT')
  !Sizes.Append('15 21 ATT')
  !Sizes.Append('20 26 ATT')
  !Sizes.Append('25 33 ATT')
  !Sizes.Append('32 42 ATT')
  !Sizes.Append('40 48 ATT')
  !Sizes.Append('50 61 ATT')
  !Sizes.Append('65 73 ATT')
  !Sizes.Append('80 89 ATT')
  !Sizes.Append('100 115 ATT')
  !Sizes.Append('125 141 ATT')
  !Sizes.Append('150 169 ATT')
  !Sizes.Append('200 220 ATT')
  !Sizes.Append('250 273 ATT')
  !Sizes.Append('300 324 ATT')
  !Sizes.Append('350 356 ATT')
  !Sizes.Append('400 406 ATT')
  !Sizes.Append('450 457 ATT')
  !Sizes.Append('500 508 ATT')
  !Sizes.Append('550 559 ATT')
  !Sizes.Append('600 610 ATT')
  !Sizes.Append('650 660 ATT')
  !Sizes.Append('700 711 ATT')
  !Sizes.Append('750 762 ATT')
  !Sizes.Append('800 813 ATT')
  !Sizes.Append('850 864 ATT')
  !Sizes.Append('900 914 ATT')
  !Sizes.Append('950 965 ATT')
  !Sizes.Append('1000 1016 ATT')
  !Sizes.Append('1050 1067 ATT')
  !Sizes.Append('1100 1118 ATT')
  !Sizes.Append('1150 1168 ATT')
  !Sizes.Append('1200 1219 ATT')

-- Point Set

  /PTSE-$!Type
    handle ANY
      !!Alert.Error('Unable to find point sets for type requested')
      return
    endhandle

  last mem
  new ptse /PTSE-$!NewName copy /PTSE-$!oldname rename /PTSE-$!oldname /PTSE-$!NewName
  !ptse = !!ce

-- Geometry Set

  /GMSE-$!Type
    handle ANY
      !!Alert.Error('Unable to find geometry sets for type requested')
      return
    endhandle

  last mem
  new gmse /GMSE-$!NewName copy /GMSE-$!oldname rename /GMSE-$!oldname /GMSE-$!NewName
  !gmse = !!ce


-- DataSet

  /MDS-DTSE-$!Type
    handle ANY
      !!Alert.Error('Unable to find datasets for type requested')
      return
    endhandle

  last mem
  new dtse /$!NewName-DATA copy /$!oldname-DATA rename /$!oldname /$!NewName
  !dtse = !!ce

-- Detref

  /MDS-SDTE-$!Type
    handle ANY
      !!Alert.Error('Unable to find detrefs for type requested')
      return
    endhandle

  last mem
  new sdte /SDTE-$!newname
--<wd>jan2007<mds12>
--  Rtext ( VTEXT ( !!DESC$!newname ) + ' ' + ATTRIB PROP CODE + ' ' + ATTRIB PROP MATR )
  rtext ( ATTRIB PROP CDES + ' ' + ATTRIB PROP CODE + ' ' + ATTRIB PROP MATR )
--<wd>jan2007<mds12>
  !sdte = !!ce

-- Components

  /MDS-$!Type
    handle ANY
      !!Alert.Error('Unable to find section for type requested')
      return
    endhandle

  last mem

  new cate /ATTA-$!NewName

  do !AddRange from 1 to !Range.size()
    new scom /$!NewName-$!Range[$!AddRange]
    para $!Sizes[$!AddRange]
    ptre $!ptse
    gmre $!gmse
    dtre $!dtse
    gtype atta
  enddo

-- Spec creation



  do !AddSpec from 1 to !range.size()

    /MDS/SELE/ATTA/$!range[$!AddSpec]
    new spco /MDS/$!newname-$!range[$!AddSpec]
    tans '$!Newname'
    catref /$!NewName-$!Range[$!AddRange]
    detref $!sdte
    $p spco /MDS/$!newname-$!range[$!AddSpec] created
  enddo

$P New atta $!newname created

endfunction
