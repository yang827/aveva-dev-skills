define function !!MdsPslSetDia(!Type is STRING)

  if !Type.eq('PCLA') then

    if !!PslSpref.namn.matchwild('*CM*') then
      !LoadGroup = !!PSLSpref.namn.after('/').after('-').after('-').after('-')
        handle ANY
          return
        endhandle
    else
      !LoadGroup = !!PSLSpref.namn.after('/').after('-').after('-').before('-')
        handle ANY
          return
        endhandle
    endif

    if !LoadGroup.real().eq(0) then
      DESPAR 12
    elseif !LoadGroup.real().eq(1) or !LoadGroup.real().eq(2) then
      DESPAR 16
    elseif !LoadGroup.real().eq(3) then
      DESPAR 20
    elseif !LoadGroup.real().eq(4) then
      DESPAR 24
    elseif !LoadGroup.real().eq(5) then
      DESPAR 30
    elseif !LoadGroup.real().eq(6) then
      DESPAR 36
    elseif !LoadGroup.real().eq(7) then
      DESPAR 42
    elseif !LoadGroup.real().eq(8) then
      DESPAR 48
    elseif !LoadGroup.real().eq(9) then
      DESPAR 56
    elseif !LoadGroup.real().eq(10) then
      DESPAR 64
    elseif !LoadGroup.real().eq(11) then
      DESPAR 72
    elseif !LoadGroup.real().eq(12) or !LoadGroup.real().eq(13)then
      DESPAR 80
    endif

    !!PslSpref.delete()

  elseif !Type.eq('HNUT') or !Type.eq('HPIN') then

    prev
      handle ANY
        !NutPl = ph bore
      elsehandle NONE
        !NutPl = pl bore
        nex
      endhandle
    despar $!NutPl

  endif

return
