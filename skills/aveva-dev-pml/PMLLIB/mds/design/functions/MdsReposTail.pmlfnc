--
-- File:  MdsReposTail.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--   Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Neale Morris
-- Created:  09/03/2005 09:43
--
--
-- Description:
-- Function to adjust the tail position on a sloping line
-----------------------------------------------------------------------------------

-- Define Function
define function !!mdsReposTail(!atta is DBREF,!defaulttpos is POSITION)

  !offsetSet = FALSE
  !dynhozriser = FALSE


  !!mdsDacControl(TRUE)

  do !loopThroHangs from 1 to 10

    !!ce = !atta
    --!attaldir = !!ce.ldir
    !supportName = !!ce.name
    $!supportName/H$!loopThroHangs
    handle ANY
      break
    endhandle
    var !taildir pt dir
    --!tDir = !taildir.direction().string().before(' WRT')
    !tpos = !!ce.tposition.wrt(/* )

    !configNumber = :MdsHConfig of $!supportName
    if !configNumber.upcase().eq('UNSET') or !configNumber.eq('') then
      !configNumber = !!mdsfhanger.configNumber.string()
    endif
    -- Remove any alpha chars H and V from confignumber
    !configNumber = !configNumber.replace('V','').replace('H','')
    !dynOffset = :MdsDynOffset of $!supportName/H1
    if !configNumber.real().eq(7) or !configNumber.real().eq(20) or !configNumber.real().eq(25) or !configNumber.real().eq(21)then
      -- Type 7 dynamic to steel , Type 20 dynamic to civils
      -- Type 25 Angulating to civils, Type 21 Angulating to steel
      if !dynOffset.eq(0) then
        !offsetSet = FALSE
      else
        !offsetSet = TRUE
      endif

      -- the following two if-else blocks seems to be an older test for when walls are in orthogonal directions
      -- i have replaced this with another test after the comment block. this will check if the tdir and atta dir
      -- are approximately in the same direction within a tolerance, Richard Martin [21/08/08]

      ---------------------------------------------------------------------------------
      --------------------- start of commented code see note above --------------------
      ---------------------------------------------------------------------------------
$(
      -- Get absolute leave dir of atta because if its a dynamic riser clamp the tdir may not be UP or DOWN
      !split = !attaldir.string().before(' WRT').split(' ')
      if !split.size().eq(5) then
        !tempdir = !split[1] & !split[2] & !split[3]
      elseif !split.size().eq(3) then
        if !split[2].real().lt(45) then
          !tempdir = !split[1]
        else
          !tempdir = !split[3]
        endif
      else
        !tempdir = !split[1]
      endif
      !hhDir = !tempdir.direction()

      -- Only reposition if the hanger is vertical or a dynamic riser clamp
      var !taildir pt dir
      !tDir.delete()
      handle ANY
      endhandle

      !tDir = !taildir.string().before(' WRT')
      -- Get absolute leave tdir of atta
      !tDirsplit = !taildir.string().before(' WRT').split(' ')
      if !tDirsplit.size().eq(5) then
        !temptdirdir = !tDirsplit[1] & !tDirsplit[2] & !tDirsplit[3]
      elseif !tDirsplit.size().eq(3) then
        if !tDirsplit[2].real().lt(45) then
          !temptdirdir = !tDirsplit[1]
        else
          !temptdirdir = !tDirsplit[3]
        endif
      else
        !temptdirdir = !tDirsplit[1]
      endif
      !ttdir = !temptdirdir.direction()
      if !ttdir.string().before(' WRT').eq(!hhDir.opposite().string().before(' WRT') ) or !ttdir.string().before(' WRT').eq(!hhDir.string().before(' WRT') ) then
        !dynhozriser = TRUE
      else
        !dynhozriser = FALSE
      endif
$)
      ---------------------------------------------------------------------------------
      --------------------- end of commented code see note above ----------------------
      ---------------------------------------------------------------------------------

      -- get the leave dir of the pipe
      !attaremgrad = !!mdsremovegrad(!atta)

      -- get the tdir of the hanger
      var !taildir pt dir

      -- get the angle between the two directions
      !angle = !attaremgrad[1].angle(!taildir.direction())

      -- if we have approx 0 or 180 then we are dynhozriser true
      if !angle.abs().between(179.9,180.1) or !angle.abs().leq(0.1) then
        !dynhozriser = TRUE
      else
        !dynhozriser = FALSE
      endif

    endif

    --    if !tDir.eq('D') or !tDir.eq('U') or !dynhozriser.eq(TRUE) then
    -- Hanger to beam

    move pt thro $!supportName/FITT/H1
    handle ANY
      -- Hanger to civil
      $!supportName/CMPF
      handle NONE
        move n thro pt of $!supportName/H1
        handle ANY
        endhandle
        move e thro pt of $!supportName/H1
        handle ANY
        endhandle
        move u thro pt of $!supportName/H1
        handle ANY
        endhandle
        pin 1 at ce
        $!supportName/H1
        pin 2 at pt of ce
        --var !dist const dist pin 1 to pin 2
        $!supportName/CMPF
        -- Move the cmpf will set the delp of the sbfi members reset them to 0
        do !reset from 1 to !!ce.mcount()
          $!reset
          delp n0
          end
        enddo
        $!supportName/H1
        do !from from 1 to 5
          $!supportName/H$!from
          handle NONE
            move pt thro $!supportName/CMPF
            pin 9 copy pt
            pin 8 copy pt
            pin 8 direction from pin 8 to ph
            pin 8 plane pin 8 thro href
            var !hangerDirection const direction pin 8 to pin 9
            if !hangerDirection.direction().eq(D) then
              move pt d clear 0 inf ploo 1 of owner of $!supportName/CMPF
              handle ANY
              endhandle
            elseif !hangerDirection.direction().eq(U) then
              move pt u clear 0 inf ploo 1 of owner of $!supportName/CMPF
              handle ANY
              endhandle
            elseif !dynhozriser.eq(TRUE) then
              move pt $!hhDir clear 0 inf $!defaulttpos
              handle ANY
              endhandle
            else
              $!supportName/CMPF
              pin 9 at ce
              pin 9 dir e
              pin 9 plane e thro ph of $!supportName/H1
              pin 9 dir n
              pin 9 plane n thro ph of $!supportName/H1
              pin 9 dir u
              pin 9 plane u thro ph of $!supportName/H1
              !tDir.delete()
              handle ANY
              endhandle
              !tDir = tdir of $!supportName/H1
              pin 9 dir $!tDir
              pin 9 plane $!tDir thro $!supportName/CMPF
              pin 9 dir from ce to ph of $!supportName/H1
              pin 8 copy pin 9
              $!supportName/H$!from
              pin 8 direction from pin 9 to ph
              handle ANY
                pin 9 plane pin 9 thro $!supportName/CMPF
                pin 8 direction from pin 9 to ph
              endhandle
              pin 8 plane pin 8 thro href
              var !hangerDirection const direction pin 8 to pin 9
              if !tDir.string()neq('D') or !tDir.neq('U') or !tDir.neq('-Z') or !tDir.neq('Z') and !dynhozriser.eq(FALSE) then
                -- horizontal dynamic hangers
                move pt $!hangerDirection clear 0 inf $!defaulttpos
              else
                move pt $!hangerDirection clear 0 inf ploo 1 of owner of $!supportName/CMPF
              endif
            endif
            tconn lose
          elsehandle ANY
            break
          endhandle
        enddo
        !!mdsResetPins(1,2)
        !!mdsResetPins(8,9)
      elsehandle ANY
      endhandle
    elsehandle NONE
      if !dynhozriser.eq(TRUE) then
        move pt $!hhDir clear 0 inf $!defaulttpos
        handle ANY
        endhandle
      endif

      if !configNumber.real().eq(20) or !configNumber.real().eq(25) then
        if !!ce.tpos.neq(!defaulttpos)  then
          --q var !!ce.hpos.wrt( /* )
          --q var !!ce.tpos.wrt( /* )
          --q var !defaulttpos
          !linea = object LINE(!!ce.tpos.wrt( /* ) , !defaulttpos.wrt( /* ) )
          !lineb = object LINE(!!ce.hpos.wrt( /* ) , !!ce.tpos.wrt( /* ) )
          !inter = !linea.intersection(!lineb)
          handle ANY
            pin 9 copy pt
            pin 9 plane pin 9 clear 0 beh owner of $!supportName/FITT/H1
          elsehandle NONE
            pin 9 copy pt
            pin 9 plane pin 9 thro $!inter
          endhandle
        else
          pin 9 copy pt
        endif
      else
        pin 9 copy pt
        -- dtf >>> 20.06.06 mod
        pin 8 copy hh
        --pin 9 plane pin 9 clear 0 beh owner of $!supportName/FITT/H1
        --var !pin9dir pin 9 dir
        var !pin9dir construct dir pin 9 to pin 8
        if !pin9dir.direction().angle(U).lt(.1) and !pin9dir.direction().angle(U).gt(-.1) then
          !pin9dir = 'U'
        elseif !pin9dir.direction().angle(D).lt(.1) and !pin9dir.direction().angle(D).gt(-.1) then
          !pin9dir = 'D'
        endif

        --$p this should be done with planes and intersect
        -- with vector or line because steel may not be in EW NS UD direction
        !fitt = $!supportName/FITT/H1
        !fittori = !fitt.orientation
        --!fittdir = !fittori.zdir()
        !line = object POINTVECTOR(!!ce.hposition.wrt( /* ), !pin9dir.direction())
        !plane = object PLANE(!!ce.tposition.wrt( /* ), !fittori )
        !intline = !plane.intersection(!line)
        pin 9 at $!intline

        !hangerStart = !!ce.hposition.wrt( /* )
        !hangerEnd   = !intline
        aid clear line 2999
        handle ANY
        endhandle
        aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

        -- dtf <<< end of mod
      endif
      pos pt at pin 9
      --       xxxxxxxx
      pin 9 off
    endhandle

    -- CMPF does not exist in create mode so we will have to work it out
    --endif

    -- If the hanger has a :MdsAncRef make sure the tail is adjusted accordingly

    !!ce = !atta
    handle NONE
      goto cref
      !connected = !!ce.:MdsAncRef
      if !connected.size().neq(0) then
        move pt clear 0 beh $!connected[1]
      endif
    elsehandle ANY
    endhandle

    -- tconn needs setting for civils supports not U dir or D dir for Dynamic type 20
    if !configNumber.real().eq(20) then
      tconn LOSE
    endif

$(
    -- dtf >>> Mod to set the tail direction towards the hh
    -- we need this later to orientate the plca
    -- dont worry it gets reset to the ppline z dir after
    if !configNumber.real().eq(7) then
      --!lisegaNumber = !!ce.owner.:USTHCFGKEY.after('.').substring(1,2)
      --if !lisegaNumber.real().eq(1) or !lisegaNumber.real().eq(9) then
      if !!ce.owner.members.size().eq(1) then
        if !offsetSet eq FALSE then
          var !hthhdir construct direction ht to hh
          --tdir  $!hthhdir
        endif
      endif
      -- dtf <<< End of mod
    endif
$)
  enddo

  !!ce = !atta
  --$p Configno $!configNumber
  if !!mdsfhanger.configNumber.string().eq('32H') then
    --if !configNumber.real().eq(32) then
    !tpos = !!ce.cref.tposition
    plane $!!ce.ldir thro $!tpos
  elseif !configNumber.real().eq(32) then
    !tpos = !!ce.cref.tposition
  endif
  !gradient = !!ce.ldir
  if !gradient.up.eq(0) then
    -- Horizontal line
  elseif !gradient.up.abs().eq(1) then
    -- Vertical line
  else
    !tailDirection = !!ce.cref.tDir.up.nint()
    if !tailDirection.eq(-1) or !tailDirection.eq(1) then
      -- Move the atta under ht if sloping line if modifying, otherwise incorrect elevations
      -- sent to vendor software in modify mode
      --  !!mdsModAttaPos(!!ce)
    endif
  endif

  !!mdsDacControl(FALSE)

endfunction
