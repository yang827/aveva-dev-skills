-- Created:		2nd February 2006
--
--
-- Description:
-- function to rewind the autoname index
-- only if the current index is the same as the support name being cancelled
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsResetAutoname(!FormName is form)

-- If the name gadget is unset then return

  !SupportName = !Formname.name.val

  if !Supportname.eq('') or !Supportname.upcase().eq('UNSET') or !SupportName.unset() then
    !FormName.hide()
    return
  endif

-- Get the index number of the support

  !Index = !!MdsAutoName.GetFileIndex()
  !Prefix = !!MdsAutoName.prefix.val
  !Suffix = !!MdsAutoname.suffix.val
  !SupportIndex = !Supportname.after(!Prefix).before(!Suffix)

-- Only if the support index and the file index are the same can we write back to the file
-- to reset the index number

  if !SupportIndex.trim().eq(!Index.trim()) then
    !ResetTo = !Index.trim().real() - 1
    !!MdsAutoName.reset.val = !ResetTo.string()
    !!MdsAutoName.ResetIndex()
  endif

  !FormName.hide()

-- End function
endfunction

-- End of file MdsResetAutoname.pmlfnc
