-- Created:             Tue Jul 01
--
--
-- Description:
-- function to create support frame type 09
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsResetDims(!Form is FORM,!Despars is ARRAY)

  do !Reset from 1 to 8
    !Form.dim$!Reset$n.val = !Despars[$!Reset]
       handle any
         !Form.dim$!Reset.val = 0
           handle any
           endhandle
       endhandle
  enddo


-- End function
endfunction

-- End of file MdsResetDims.pml
