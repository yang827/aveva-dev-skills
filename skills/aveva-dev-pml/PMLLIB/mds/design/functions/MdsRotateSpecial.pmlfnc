--
-- File:		MdsRotateSpecial.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Thursday 20th March
--
--
-- Description:
-- function to rotate the steelwork of a special about the datum atta position and direction
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support frame form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRotateSpecial()

-- Turn DAC control on

  !!mdsDacControl(true)

-- Initialise variables

  !support  = !!mdsSpecial.support.stru
  !datum  = !!mdsSpecial.support.datum

-- Can only rotate framwork if we can write to the stru

  if !!mdsComClaimDac(!support,'DACMOD','POS').not() then
    !!alert.error('Unable to rotate support as write access to the support structure is not available')
    return
  endif

-- Find position of datum point
-- If the duct is vertical copy the pa

  !padir = pa dir of $!datum
  if !padir.string().before(' WRT').eq('U') or !padir.string().before(' WRT').eq('D') or !padir.string().before(' WRT').eq('-Z') or !padir.string().before(' WRT').eq('Z') then
    pin 9 copy pa of $!datum
  else
    pin 9 copy p9 of $!datum
  endif

  !!ce = !support

  !angle = !!mdsRotSpecial.angle
  rotate about pin 9 by $!angle

  !!mdsCopyProjSpec.copy('ROTATE')

-- Rotate lugs if needed

  !attas = !!mdsSpecial.support.atta
  do !loopAtta values !attas
    !!ce = !loopAtta
    !attaName = !!ce.name
    do !loop from 1 to 4
      $!attaName$n/LUG$!loop
        handle NONE
        rotate about pl by $!angle
        elsehandle ANY
        endhandle
    enddo
  enddo

  !!ce = !support

-- Turn DAC control off
  !!mdsDacControl(false)

-- Reset Pins
  !!mdsResetPins(9,9)

-- End function
endfunction
