--
-- Author:		Neale Morris
-- Created:		Tuesday March 2nd 2004
--
--
-- Description:
-- function to make the connection between a support and a civil plate
-- plate must be a sbfi
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsSbfiConn(!Mode is STRING,!Section is DBREF,!Sbfi is DBREF,!Type is STRING)

-- Exit straight away if it is not a sbfi

  if !Sbfi.type.neq('SBFI') then
    return
  endif

-- Create connection

  if !Mode.eq('CREATE') then

-- Set the :MdsAncRef connection

    !ce = !!ce
    !x = object mdsbplateconn(!section,!sbfi)
    !!ce = !ce

-- Is the section already connected to the sbfi

    !SbfiConnections = !Sbfi.:MdsPconn
    if !SbfiConnections.size().gt(0) then
      !FindIt = !SbfiConnections.findfirst(!Section)
      if !findit.unset() then
      else
        if !SbfiConnections.findfirst(!Section).gt(0) then
          return
        endif
      endif
    endif

-- Set the sections plate reference

    !!ce = !Section
    !IsItConnected = :MdsPConn
    if !IsItConnected.size().gt(0) then
      if !!ce.:MdsPConn[1].badref().Not() then
        goto :MdsPconn Num 1
        !CurrentConnections = :MdsPconn
        -- clean up any badrefs
        do !I indices !CurrentConnections
          if !CurrentConnections[!i].badref() then
            !CurrentConnections[!i].delete()
          endif
        enddo
        if !CurrentConnections.size().eq(1) then
          :MdsPConn default
        elseif !CurrentConnections.size().eq(0) then
          :MdsPConn default
        else
          !ThisConnection = !CurrentConnections.find(!Section)
          !CurrentConnections[$!ThisConnection[1]].delete()
          !CurrentConnections.compress()
          :MdsPconn !CurrentConnections
          do !Reset from 1 to !CurrentConnections.size()
            :MdsPConn num $!Reset $!CurrentConnections[$!Reset]
          enddo
        endif
        same
      endif
    endif
    :MdsPConn $!Sbfi

-- Set the plates reference back to the support section

    !!ce = !Sbfi
    !MdsPconn = :MdsPconn
    !Size = !MdsPconn.size()
    !NewEntry = !Size + 1
    :MdsPconn num $!NewEntry $!Section
    handle (41,52)
      do !I indices !mdspconn
        if !MdsPconn[!I].badref() then
          !!ce.:mdspconn[!i].delete()
        endif
      enddo
      !MdsPconn = !MdsPconn.compress()
      :MdsPConn default
      !!ce.:mdspconn = !MdsPconn
      !MdsPconn = :MdsPconn
      !Size = !MdsPconn.size()
      !NewEntry = !Size + 1
      :MdsPconn num $!NewEntry $!Section
    endhandle

  else

-- Clear connection

    !!ce = !Section
    !IsItConnected = :MdsPConn
    if !IsItConnected.size().gt(0) then
      if !!ce.:MdsPConn[1].badref().Not() then
        goto :MdsPconn Num 1
        !CurrentConnections = :MdsPconn
        if !CurrentConnections.size().eq(1) then
          :MdsPConn default
        else
          !ThisConnection = !CurrentConnections.find(!Section)
          !CurrentConnections[$!ThisConnection[1]].delete()
          !CurrentConnections.compress()
          :MdsPconn def
          do !Reset from 1 to !CurrentConnections.size()
            if !CurrentConnections[$!Reset].badref().not() then
              :MdsPConn num $!Reset $!CurrentConnections[$!Reset]
            endif
          enddo
        endif
        same
      endif
    endif
  endif

return
