--
-- File:		MdsSetOffsetDir.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Tues 22 Feb
--
--
-- Description:
-- function to set the offset directions
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetOffsetDir(!atta is DBREF)

  !supportName = name of $!atta
  !dynamicparallel = FALSE
-- Check that creation is complete

  pin 9 copy pl of $!supportName
  pin 8 copy pl of $!supportName
  pin 8 dist 100
  !ptDir = pt dir of $!supportName/H1 wrt /*
  pin 9 dir $!ptDir
  pin 8 dir $!ptDir
  pin 9 thro pt of $!supportName/H1
  pin 8 thro pin 9
-- If the pl dir is not u then set the elevation the same

  if !supportName.dbref().adir.wrt(/* ).string().eq('U WRT /*') or !supportName.dbref().adir.wrt(/* ).string().eq('D WRT /*') or !supportName.dbref().adir.wrt(/* ).string().eq('Z WRT /*') or !supportName.dbref().adir.wrt(/* ).string().eq('-Z WRT /*') then
-- we need to cater for vertical pipes
    var !oppXdir p11 dir of $!supportName wrt /*
    --var !ydir    p9 dir of $!supportName
    var !p9dir    p9 dir of $!supportName wrt /*

    -- added new offset direction based on the cross product of tdir and up, this is introduced
    -- to cater for vertical pipes with diagonal walls (Richard Martin 02/08/2006)
    --!!mdsFh01.support.offsetx = !ptDir.cross( u wrt /* )
    --!!mdsFh01.support.offsetx = !oppXdir.direction()
    !cross = !p9dir.direction().cross(!oppXdir.direction())

    if !ptDir.eq(D) or !ptDir.eq(U) then
      var !ydir p9 dir of $!supportName
      !!mdsFh01.support.offsety = !ydir.direction()
      !!mdsFh01.support.offsetx = !ptDir.cross((!p9dir.direction().opposite().wrt( /* )))
    else
      !!mdsFh01.support.offsety = !cross
      !!mdsFh01.support.offsetx = !ptDir.cross( u wrt /* )
    endif
    --!!mdsFh01.support.offsety = !ydir.direction()
    !!mdsFh01.support.tdir = !ptDir
    !!mdsResetPins(6,9)
    return
  elseif !supportName.dbref().adir.wrt(/* ).up.abs().gt(0.5) then
    -- <RM> 22 November 2006 -- added this case for when we have near vertical sloping pipes
    -- we need to cater for vertical pipes
    var !oppXdir p11 dir of $!supportName wrt /*
    --var !ydir    p9 dir of $!supportName
    var !p9dir    p9 dir of $!supportName wrt /*

    -- added new offset direction based on the cross product of tdir and up, this is introduced
    -- to cater for vertical pipes with diagonal walls (Richard Martin 02/08/2006)
    --!!mdsFh01.support.offsetx = !ptDir.cross( u wrt /* )
    --!!mdsFh01.support.offsetx = !oppXdir.direction()
    !cross = !p9dir.direction().cross(!oppXdir.direction())

    if !ptDir.eq(D) or !ptDir.eq(U) then
      var !ydir p9 dir of $!supportName
      !!mdsFh01.support.offsety = !ydir.direction()
      !!mdsFh01.support.offsetx = !ptDir.cross((!p9dir.direction().opposite().wrt( /* )))
    else
      !!mdsFh01.support.offsety = !cross
      !!mdsFh01.support.offsetx = !ptDir.cross( u wrt /* )
    endif
    --!!mdsFh01.support.offsety = !ydir.direction()
    !!mdsFh01.support.tdir = !ptDir
    !!mdsResetPins(6,9)
    return
    -- <RM> 22 November 2006 -- end of fix
  else
    do !pin from 6 to 9
      pin $!pin dir u
      pin $!pin plane pin $!pin thro $!supportName
    enddo
  endif

  pin 7 copy pin 9
  pin 6 copy pin 8
  pin 7 plane pin 7 thro $!supportName
  var !movedDist const dist pin 9 to pin 7
  pin 6 dist $!movedDist

  !attadirs = !!mdsremovegrad(!supportName.dbref())
  if (!attadirs[1].angle(!ptDir).gt(179.9) and !attadirs[1].angle(!ptDir).lt(180.1))  or (!attadirs[1].angle(!ptDir).gt(-.1) and !attadirs[1].angle(!ptDir).lt(.1)) then
  -- support dynamic and parallel to pipe
    !dynamicparallel = TRUE
    !ydir = !attadirs[4].string()
  else
    var !ydir const direction pin 7 to pin 6
    if !ydir.eq('') then
      !ydir = 'U WRT /*'
    endif
  endif

  !tailDirection = pt dir of $!supportName/H1 wrt /*
  !oppTailDir    = !tailDirection.opposite()

  !plane = object PLANE()
  !plane.orientation = y is $!ydir and x is $!oppTailDir
  !xdir = !plane.orientation.zdir()

  if !xdir.string().eq('D WRT /*') or !xdir.string().eq('-Z WRT /*') then
    !oppXdir = !xdir.opposite()
  elseif !xdir.string().match('D WRT /*').gt(0) or !xdir.string().match('-Z WRT /*').gt(0) then
    !oppXdir = !xdir.opposite()
  else
    !oppXdir = !xdir
  endif

  if !dynamicparallel then
  -- support dynamic and parallel to pipe
    !ydir = !attadirs[4].string()
  else
-- Reset xdir because of slope

    pin 6 dir $!oppXdir
    pin 7 dir $!oppXdir
    pin 6 plane pin 6 thro $!supportName
    pin 7 plane pin 7 thro $!supportName
    var !ydir const direction pin 7 to pin 6
    if !ydir.eq('') then
      !ydir = 'U WRT /*'
    endif
  endif
  !!mdsFh01.support.offsetx = !oppXdir
  !!mdsFh01.support.offsety = !ydir.direction()
  --q var !oppTailDir
  if !oppTailDir.angle(U).lt(.1) and !oppTailDir.angle(U).gt(-.1) then
    !oppTailDir = U
    !atta.cref.tdir = D
  elseif !oppTailDir.angle(D).lt(.1) and !oppTailDir.angle(D).gt(-.1) then
    !oppTailDir = D
    !atta.cref.tdir = U
  endif
  !!mdsFh01.support.tdir = !atta.cref.tdir.wrt( /* )

  !!mdsResetPins(6,9)

endfunction
