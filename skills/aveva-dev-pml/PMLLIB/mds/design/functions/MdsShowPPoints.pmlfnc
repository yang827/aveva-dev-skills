--
--
-- Description:
-- store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt04()

-- Initialise variables
    !!Mdsvt04.store.clear()

-- Required option gadgets
    -- !size  = !!Mdsvt04.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt04)

-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsvt04)

-- Store relavent gadget information
    !!Mdsvt04.store.append(|!!Mdsvt04.dist.val = $!!Mdsvt04.dist.val|)
    !!Mdsvt04.store.append(|call !!Mdsposdist(!!Mdsvt04)|)
    -- !!Mdsvt04.store.append(|!!Mdsvt04.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt04.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt04.store.append(|!!Mdsvt04.Dim1.val = $!!Mdsvt04.Dim1.val|)
    !!Mdsvt04.store.append(|!!Mdsvt04.Dim2.val = $!!Mdsvt04.Dim2.val|)

-- Store support object
    !!Mdsvt04.backup = !!Mdsvt04.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt04.support.stru
    !!Mdsvt04.store.append(|$!!Mdsvt04.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt04.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt04.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt04.pml
