--
-- File: MdsShowSplash.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Wednesday 27th April 2005
--
--
-- Description:
-- Function to display the splash screen
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsshowsplash(!mode is BOOLEAN)

-- The splashscreen for marine and plant are different so determine
-- which one to use.
--
--<wd>30jan2008
-- DUN808 P-125 -- All instances of the evars "PDMS_MARINE and "MARINE" changed to "AVEVA_MARINE"
--  var !whichproduct evar 'PDMS_MARINE'
  var !whichproduct evar 'AVEVA_MARINE'
--<wd>30jan2008

  if !whichproduct.upcase().eq('YES') then
    !pngFileName = 'MDSSplashMarine.jpg'
  else
    !pngFileName = 'MDSSplashPlant.jpg'
  endif

  if !mode then

-- Display splash screen if it not already displayed
-- The splashscreen exe will be in the PDMSEXE area
-- The bmp/png file is in the MDS software directory in a directory splash called MDSSplashScreen.png

    if (undefined(!!mdsSplash)) then
      var !splashbitmap file /%pmllib%\..\splash\$!pngFileName
        handle ANY
          return
        endhandle
      !filename = object FILE(!splashbitmap)
      !unusedfullname = !filename.fullname()
      var !splashProgram file /%pmllib%\..\splash\splashscreen.exe
        handle ANY
          return
        endhandle
-- dtf >>> 20.07.06 Mod to stop errors in console window when PDMSEXE is a search path
-- error in code !splashProgram exists therefore use it
-- ref HPD0032748 KBR
      --syscom '%pdmsexe%/splashscreen $!splashbitmap &'
      syscom '$!splashProgram $!splashbitmap &'
-- dtf <<< End of mod
      !!mdsSplash = TRUE
    endif

  else

-- In the unlikely event of MDS loading before the splashscreen times out then
-- kill it
--
-- dtf >>> 20.07.06 Mod to stop errors in console window when PDMSEXE is a search path
-- error in code !splashProgram exists therefore use it
-- ref HPD0032748 KBR
    --syscom '%pdmsexe%/splashscreen -kill &'

    var !splashProgram file /%pmllib%\..\splash\splashscreen.exe
    handle ANY
      return
    endhandle
    syscom '$!splashProgram -kill &'
-- dtf <<< End of mod

  endif

endfunction
-- End of function definition for !!mdsshowsplash
