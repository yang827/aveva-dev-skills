--
--
-- Description:
-- function to switch FH01 form to another hanger
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSwitchTo(!Form is FORM)

-- Identify the support to try and switch to

  PROMPT OFF
  PROMPT LOAD ESCAPE |Identify hanger to switch to|
  ID @
    handle (61,528)
      PROMPT ON
      return
    endhandle
  PROMPT DISMISS
  PROMPT ON

-- Is a support

  !!MdsSilent = TRUE
  !HangerName = !!MdsGetSuppName(!!CE)
  !!MdsSilent.delete()

  if !HangerName.eq('ABORT') then
    !!Alert.error('Identified element is not a support')
    return
  endif

-- Is it a hanger

  !ce = !!ce
  !!ce = !HangerName.dbref()
  if !!ce.type.eq('STRU') then
    !!ce = !ce
    !!Alert.error('Identified element is not a hanger')
    return
  endif

-- Is it the same hanger

  if !!Mdsfh01.support.datum.name.eq(!HangerName) then
    !!ce = !ce
    !!Alert.error('Identified element is the hanger you are currently modifying')
    return
  endif

  !HangerNamn = !HangerName.dbref().namn

-- OK we have found a hanger, save the initial hanger name

  !NameOfCurrentHanger = !!MdsFh01.support

-- OK load the new hanger into mdsfh01

  hide !!mdsfh01
  !SuppType = !Hangername.dbref().:MdsSuppType
  !!MdsIfh01('MODIFY',!hangerNamn,!SuppType)

-- End function
endfunction

