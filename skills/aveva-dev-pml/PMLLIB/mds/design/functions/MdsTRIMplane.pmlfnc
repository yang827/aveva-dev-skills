--
-- File:		Mdstrimplane.pmlfnc
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		T .Martin
-- Created:		31/05/2005 09:45
--
--
-- Description:
-- method to trim or extend a sctn to sit on an element
--
--------------------------------------------------------------------------------
-- Define Function
-- arguments are:
-- 1 !sctn is the sctn to be aligned
-- 2 !planestring is the plane to cut the section
-- 3 !end is the sctn end to be cutback
-------------------------------------------------------------------------------------------

define function  !!Mdstrimplane(!sctn is DBREF,!mirror is BOOLEAN,!planestring is STRING,!end is STRING)

  --  planestring is in the old pml1 format so needs converting
  -- 'PLANE W 7.99824 N 12.6496 U  through E 471800.28125 N 117809.320312 U 3269.427001 '
  !pv = object pointvector()
  !pv.position  = !planestring.after('through ').position()
  !pv.direction = !planestring.after('PLANE ').before('through ').direction()
  !plane = !pv.plane()

  !!ce = !sctn
  !pvstart = !!ce.poss.wrt(/* ).line(!!ce.pose.wrt(/* )).pointvector()
  !planeposition = !pvstart.intersection(!plane)
  handle ANY
     !!alert.error(!!error.text)
     return
  endhandle
  !cutdirection = !plane.direction()

  if !mirror then
    if !end.eq('start') then
      !cutend = 'end'
    else
      !cutend = 'start'
    endif
  else
     !cutend = !end
  endif

  if !cutend.eq('start') then   $* its the start
    -- extend the start
    extend start thro $!planeposition
    drns $!cutdirection
  else
    -- extend the end
    extend end thro $!planeposition
    drne $!cutdirection
  endif


 -- End of file mdstrimplane
