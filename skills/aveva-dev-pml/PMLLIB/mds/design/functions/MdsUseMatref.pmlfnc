--
-- File: MdsUseMatref.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.Morris
-- Created: Sat 20th Jan 2007
--
--
-- Description:
-- function to set which matref attribute to use
-- pre pdms12.0 the uda :MdsMatref is used but
-- at 12.0 the matref attribute has been added
-- to atta
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsusematref(!dbref is DBREF) is STRING

  -- Check to see if passed dbref has the matref attribute
  -- if not use the uda :mdsMatref

  -- The behaviour of the MATREF attribute has changed
  -- the syntax --> !CheckForMatref = !DBREF.Matref now returns 'Unset' when the attribute
  -- Matref does NOT exist at the element defined in !DBREF instead of an ERROR as before.
  --
  -- Therefore a NEW 'GENERIC' TEST has been inserted below to determine if the 'Matref' attribute exists
  -- at the element !DBREF
  --
  -- *** IMPORTANT NOTE ***
  -- The PLAT (hardtype REDU) element used for MDS TRUNNION PLATES does NOT have the 'Matref' attribute,
  -- so the UDA :MDSMatRef is used to store its PROPCON Material Reference

  -- Initialise Variables
  -- NOTE: the attribute 'Matref' is ONLY recognised in OUTFITTING/PDMS12.0 as 'Matref' in the list of valid
  -- attributes, e.g. any other string, i.e. 'matref' or 'MATREF' will NOT be found, so always look for 'Matref'
  !attlist = !dbref.attributes()
  !findmat = !attlist.find('Matref')

  -- Determine the value of !string to return
  if (!findmat.empty().not() or !findmat.unset().not()) then
    -- The element !DBREF does have the attribute --> Matref, so use it.
    !string = 'REF'
  else
    -- The element !DBREF does NOT have the attribute --> Matref, so use the UDA :MDSMatref
    !string = 'UDA'
  endif

  -- Return string of attribute to use
  return !string

endfunction
