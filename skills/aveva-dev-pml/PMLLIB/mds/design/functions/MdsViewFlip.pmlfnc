--
--
-- Description:
-- Function to set the ADP view flip uda
-- The ADP drawing will then be drawn at 180 degrees from default
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function

define function !!MdsViewFlip(!form is form)

-- Check that datum atta has been created

  if !Form.Support.Datum.badref() then
    !!alert.error('Datum atta not created, unable to set the ADP view flip control')
    return
  else
-- Is the datum cref pointing to a hang, so its a hanger
    if !Form.Support.Datum.cref.badref() then
-- Drawing are currently available for framework (stru) and hangers (rest)
-- if the datum is a atta and the stru is not set then its an individual atta so abort
      if !Form.Support.Stru.badref() then
        !!alert.error('This functionality is currently unavailable for supports not containing any steelwork.')
        return
      endif
    endif
  endif

--<kp>july06
  --!!ce = !Form.support.datum
  !!ce = !Form.support.GetElemForUDA()

  !Flip = :MdsViewFlip

  !!MdsDacControl(TRUE)

    if !Flip.not() then
      if !!Alert.confirm('Are you sure you want to set the ADP view directions at 180 degrees from default?').eq('YES') then
        :MdsViewFlip TRUE
          handle ANY
            !!Alert.Error(!!Error.text)
          endhandle
      endif
    else
      if !!Alert.confirm('Are you sure you want to set the ADP view directions to default?').eq('YES') then
        :MdsViewFlip FALSE
          handle ANY
            !!Alert.Error(!!Error.text)
          endhandle
      endif
    endif

  !!MdsDacControl(FALSE)

endfunction
