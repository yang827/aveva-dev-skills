--
-- File:  MdsWeldAdjust.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--   Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Tony Martin
-- Created:  08/12/2004 14:14
--
--
-- Description:
-- function to adjust the weld positions on an ancillary with ppoints 301 onwards
-----------------------------------------------------------------------------------
-- method
-- from the bar, check to see if the ancillary is close to the bar and if it
-- needs to be cut back. This is defined by the length along the pipe compared
-- with the width of the supporting bar.
-- Assumptions
-- 1) The bar is 90 degrees to the pipe direction
-- 2) The atta has properties bwid and boff for bearing width and bearing offset
-- 3) bwid and boff use despar 7 and 8 respectively
-- 4) bwid is set to the full length of the atta by default
-- 5) if the position of the atta does not lie near the beam, no values are set


-- Define Function
define function !!mdsWeldAdjust(!form is FORM)

  !save = !!ce

  !stru = !form.support.stru

  !attalist = ARRAY()
  do !bar index !form.support.bars
    !barname = !stru.name & '-BAR-' & !bar
    !test = !barname.dbref()
    handle ANY
      -- !!alert.error('Cannot find bars for this support')
      return
    endhandle
    !refs = !form.support.bars[!bar]
    handle(2,759)
      skip
    endhandle
    do !atta values !refs
      if !atta.name.match('SREF').gt(0) then
        skip
      endif

      --<RM> 13/10/09 the mdsweldajust function was meant to be used in conjunction with a very specific
      --set of Areva (Framatome) components. when used on generic components errors have occured
      --specifically on AN09 due to the incorrect overwrite of the despar with dkey BWID
      --the fix is therefore to limit acess to this function except to Areva
      !desparray = !atta.desp
      !pp301 = FALSE
      !pp302 = FALSE
      !pp303 = FALSE
      !pp304 = FALSE
      do !i from 1 to !desparray.size()
        if !desparray[!i].eq(301) then
          !pp301 = TRUE
        elseif !desparray[!i].eq(302) then
          !pp302 = TRUE
        elseif !desparray[!i].eq(303) then
          !pp303 = TRUE
        elseif !desparray[!i].eq(304) then
          !pp304 = TRUE
        endif
      enddo

      !framatome = FALSE
      !desc = desc of /MDS/TEMPLATES
      if !desc.eq('Framatome Templates') then
        !framatome = TRUE
      endif

      if !pp301 and !pp302 and !pp303 and !pp304 and !framatome then
        --if the above conditions are met then we have a valid component for weld adjustment otherwise do nothing
      else
        skip
      endif
      --<RM> 13/10/09 -- end of fix

      !list[1] = !test
      !list[2] = !atta
      !attalist.append(!list)
    enddo
  enddo

  !barlist = ARRAY()
  do !a values !attalist
    -- go and get the offset and weld length values from the section
    !obj = object MDSPLINES(!a)
    !barlist.append(!obj)
  enddo
  -- q var !barlist
  -- need to check if the weld is on the plate or less than the width of the steel
  do !b values !barlist
    !!ce = !b.atta
    !lenpar = !!mdsGetDesp('BWID')
    if !lenpar eq 0 then
      skip
    endif
    --<dw>mar2009 DFN P-16885 DAC control added.
    !!mdsDacControl(TRUE)
    desp n$!lenpar  $!b.bearinglength
    --$p desp n$!lenpar $!b.bearinglength
    !offspar =  !!mdsGetDesp('BWOF')
    if !offspar eq 0 then
      skip
    endif
    --$p   desp n$!offspar $!b.bearingoffset
    desp n$!offspar  $!b.bearingoffset
  enddo

  -- go back to where we started
  !!ce = !save
  --<dw>mar2009 DFN P-16885 End of DAC control addition.
  !!mdsDacControl(FALSE)
  -- End function
endfunction
