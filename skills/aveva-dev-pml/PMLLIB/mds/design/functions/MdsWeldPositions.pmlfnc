-- Author:		Neale Morris
-- Created:		05/08/2004 09:04
--
--
-- Description:
-- function to reverse the weld positions if a standard template is mirrored
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsWeldPositions(!Form is Form,!Stru is DBREF,!Mirror is BOOLEAN)

  !!ce = !Stru


  tmpl1
    handle ANY
      return
    elsehandle NONE
      if (!Form.Support.Alias inset ('FT03','FT04','FT05','FT06','FT07','FT08','FT09','FT10','FT11','FT13','FT14','FT18','FT19','FT28','FT29','FT31','FT32','FT33','FT34A','FT34B','FT34C','FT35','FT36','FT37','FT38','FT39','FT40','FT42','FT43')) then
        var !ddat coll all DDAT with matchwild(name,'*START') for ce
        var !ddat append coll all DDAT with matchwild(name,'*END') for ce
        do !Loop values !ddat
          !!ce = !Loop.dbref()
          !ddpr = ddpr
          if !ddpr.match('START').gt(0) then
            !ddpr = !ddpr.replace('START','END')
          elseif !ddpr.match('END').gt(0) then
            !ddpr = !ddpr.replace('END','START')
          endif
          ddpr $!ddpr
        enddo
      endif
    endhandle


-- End function
endfunction

-- End of file MdsWeldPositions.pmlfnc
