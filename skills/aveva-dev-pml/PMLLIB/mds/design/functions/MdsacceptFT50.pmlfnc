--
-- File:		MdsacceptFT50.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Wednesday 13th May 1998
--
--
-- Description:
-- function to check that created 'FT50' support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsAcceptFT50()

-- Initialise variables
    !support = !!MdsFT50.support
    !stru    = !!MdsFT50.support.stru
    !name    = !stru.name
    !frame   = !name & '/MAIN'
    var !supportframe exists $!frame

--------------------------------------------------------------------------------

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Support frame and datum atta have to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Support datum has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Support frame has to exist before creation can be ended')
      return
    endif

--------------------------------------------------------------------------------

    !!MdsDacControl(true)
    !!ce = !support.datum
    :MDSCp1 'unused'

-- check that no dimension errors have occured, if so display then to the user
   if (!!mdsFT50.dimerrors.size().gt(0)) then
     !!alert.error('Support frame cannot be built until the following dimensional inconsistencies have been resolved:')
     !i = 0
     do !error values !!mdsFT50.dimerrors
       !!alert.error(!error)
     enddo
     return
   endif

-- Check if length of steelwork members exceed maximum of template
    !!Mdschecklen(!!MdsFT50)

    if (!!Mdschecklen.accept.not()) then
      return
    endif

  -- Clear graphical tags

    !!MdsClearTags()

--------------------------------------------------------------------------------

-- Reset design representation if required
    call !!kactioncommands(!!MdsFT50.repre)

-- Clear form gadgets for form
    call !!Mdscleargadgets(!!MdsFT50)

--------------------------------------------------------------------------------

    !!ce = !support.stru

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

--------------------------------------------------------------------------------

-- Hide Form
    !!MdsFT50.hide()
    !!MdsDacControl(false)
    call !!mdscleardim()
  endfunction
-- End function

-- End of file MdsacceptFT50.pml
