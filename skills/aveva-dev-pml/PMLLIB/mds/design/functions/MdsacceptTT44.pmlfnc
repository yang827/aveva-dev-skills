--
--   File: MdsacceptTT44.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Friday 20th February 1998
--
--
-- Description:
-- function to check that created 'TT44' support is acceptable.  Dun979 MDS12 addition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsacceptTT44()

  -- Initialise variables
  !support = !!mdsTT44.support
  !datum   = !!mdsTT44.support.datum
  !name    = !datum.name
  var !supportframe exists $!name

  --------------------------------------------------------------------------------

  -- Check that creation is complete
  if (!support.datum.badref() and !supportframe eq 'FALSEA')then
    !!alert.message('Trunnion atta has to exist before creation can be ended')
    return
  endif

  if (!support.datum.badref())then
    !!alert.message('Trunnion atta has to exist before creation can be ended')
    return
  endif

  if (!supportframe eq 'FALSEA')then
    !!alert.message('Trunnion atta has to exist before creation can be ended')
    return
  endif

  --------------------------------------------------------------------------------

  -- Store specific data to Trunnion type 'TT44' in uda :MDSCp1
  if (!support.rotatecur)then
    !rcur = 'T'
  else
    !rcur = 'F'
  endif
  if (!support.handedcur)then
    !hcur = 'T'
  else
    !hcur = 'F'
  endif
  if (!support.mirror)then
    !mirror = 'T'
  else
    !mirror = 'F'
  endif
  !!ce = !support.datum

  !!mdsDacControl(true)
  :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

  ---------------------------------------------------------------------------------------
  -- HPD0032137 GE (10/05/06) Added an extension to the STEX text stored at the SREF ATTA
  -- The previous STEX value = The trunnion NAME e.g. Stext PS01234
  -- The new STEX value = The trunnion NAME
  --                PIPE CL TO END OF PLATE INCL. = 500


  !srefString = !name + '/SREF'
  !!ce = !srefString.dbref()

  if (!name.match('/').eq(1)) then
    !aname = !name.after('/').before('.')
  endif

  !tlen = !!mdsTT44.tlength.val
  --<dw>mar2009 dun1119 - Text split for improved presentation
  STEX '$!aname
  PIPE CL TO END OF
  PLATE INCL. = $!tlen '

  !!ce = !support.datum

  ---------------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  -- Check if length of TRUNNION exceeds Maximum Allowable Length in description file
  --   !!mdschecklen(!!mdsTT44)
  -- if (!!mdschecklen.accept.not()) then
  -- return
  -- endif

  --------------------------------------------------------------------------------
  -- Clear graphical tags

  !!mdsClearTags()

  --------------------------------------------------------------------------------

  -- Reset design representation if required
  call !!kactioncommands(!!mdsTT44.repre)

  -- Clear form gadgets for form TRunnion Type 'TT44'
  call !!mdscleargadgets(!!mdsTT44)

  --------------------------------------------------------------------------------

  !!ce = !support.datum

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsmodifysupp.cancel.active.not())then
    !!mdsmodifysupp.applyform.remove(5)
    handle (2,752)
    endhandle
    !!mdsmodifysupp.cancel.active = true
  endif

  --------------------------------------------------------------------------------

  -- Lock the trunnion automatically so as to stop the main pipe being dragged and the height of the
  -- trunnion exceeding the maximum height
  -- Removed 20/11/02 Ncm

  -- !!ce = !support.datum
  -- bran
  -- lock all


  -- Hide Form
  !!mdsTT44.hide()
  !!mdsDacControl(false)
endfunction
-- End function
