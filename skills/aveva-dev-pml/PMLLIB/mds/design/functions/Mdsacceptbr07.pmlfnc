--
--   File: Mdsacceptbr07.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: D.Whiteside
-- Created: Tue Apr 01 2008
--
--
-- Description: Dun979-As for type Br04 but 2 stiffeners only.
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAcceptBr07()

  -- Initialise variables
    !support = !!mdsBr07.support

  -- Check that creation is complete
    if (not defined(!support.atta[1]))then
      !!alert.message('Support has to exist before creation can be ended')
      return
    endif

  -- Check if length of steelwork members exceed maximum of template
    !!mdsCheckPar(!!mdsBr07)
    if (!!mdsCheckLen.accept.not()) then
      return
    endif

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
    call !!mdsClearGadgets(!!mdsBr07)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
    if (!!mdsModifySupp.cancel.active.not())then
      !!mdsModifySupp.applyForm.remove(5)
        handle (2,752)
        endhandle
      !!mdsModifySupp.cancel.active = true
    endif

  -- Hide Form
    !!mdsBr07.hide()
    !!mdsDacControl(false)
-- End function
endfunction
