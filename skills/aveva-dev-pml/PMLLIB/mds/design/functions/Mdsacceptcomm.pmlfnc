--
-- File:		Mdsacceptcomm.pml
--   Type:		Result Macro
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon Aug 18
--
--
-- Description:
-- Macro to set the :MDSComment attribute, this will be displayed above the
-- line ident table on the Fabgen drawing.
--
--------------------------------------------------------------------------------

define function !!MdsAcceptComm()

-- Is the name gadget have a valid name

  if (!!MdsComm.Name.Val.upcase() eq |UNSET|)then
    !!Alert.Error ('Support has not been selected to add a drawing comment to')
    return
  endif

-- Initilise gadgets

  !Ref = '/' & !!MdsComm.Name & '/DATUM'
  !!CE = !Ref.dbref()
    handle (2,109)
      !Ref = '/' & !!MdsComm.Name
      !!CE = !Ref.dbref()
    endhandle

-- Set the :MDSComment attribute after checking the number of characters does
-- exceed the maximum of 120 characters

  !total = 0

  !array = !!MdsComm.Comment.val

  do !readarray values !array
    !length = (length(!readarray))
    !total = !total + !length
  enddo

-- Add the number of lines - 1 to add the carriage returns

  !lines = !array.size()
  !subtotal = !total
  !sublines = !lines - 1
  !total = !total + !lines - 1

  if (!total gt 120) then
    !!Alert.Error('The length of the comment exceeds the maximum of 120 characters, Current length is $!subtotal characters and $!sublines carriage returns')
    return
  endif

-- Set the :MDSComment uda but first set the first line

  !!MdsDacControl(TRUE)

  :MDSComment ''

  do !writearray values !array
    !text = !!CE.:MDSComment
    if ('$!text' eq 'unset') then
      :MDSComment '$!writearray'
    else
      :MDSComment '$!text
$!writearray'
    endif
  enddo

  !!MdsDacControl(false)

endfunction

return

-- End of file Mdsicomm.pml
