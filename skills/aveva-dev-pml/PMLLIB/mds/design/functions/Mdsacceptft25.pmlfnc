--
-- File:		Mdsacceptft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 28th November 1997
--
--
-- Description:
-- function to check that created support/packing piece(s) is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING       FRAME - If form 'FT25' initialised from ANOTHER
--                                          Framework Type form eg: 'FT18'
--                                  OWNER - If form 'FT25' initialised from
--                                          (i)  - The Create>Framework>MDS.. option/icon
--                                     or - (ii) - The Modify>Support... option/icon
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsacceptft25(!method is STRING)

--------------------------------------------------------------------------------
-- If form FT25 Initialised from Another Framework Type, just Hide the Form
-- All necessary data is stored in the calling framework's MdsSUPPORT object

    if (!method.upcase() eq 'FRAME') then

-- Hide Form
      !!Mdsft25.Hide()

--------------------------------------------------------------------------------

    elseif (!method.upcase() eq 'OWNER') then

-- Initialise variables
    !support = !!Mdsft25.support
    !stru    = !!Mdsft25.support.stru
    !name    = !stru.name
    !frame   = !name & '/MAIN'
    var !supportframe EXISTS $!frame

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Support frame and datum atta have to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Support datum has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Support frame has to exist before creation can be ended')
      return
    endif

-- Store specific data to frame type 21 in uda :MDSCp1
    if (!support.rotatecur)then
      !rcur = 'T'
    else
      !rcur = 'F'
    endif
    if (!support.handedcur)then
      !hcur = 'T'
    else
      !hcur = 'F'
    endif
    if (!support.mirror)then
      !mirror = 'T'
    else
      !mirror = 'F'
    endif
    !!ce = !support.datum
    !!MdsDacControl(true)
    :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

-- Check if length of steelwork members exceed maximum of template
    !!Mdschecklen(!!Mdsft25)
    if (!!Mdschecklen.accept.not()) then
      return
    endif

  -- Clear graphical tags

    !!MdsClearTags()

-- Reset design representation if required
    call !!kactioncommands(!!Mdsft25.repre)

-- Clear form gadgets for form frame type 25
    call !!Mdscleargadgets(!!Mdsft25)

    !!ce = !support.stru

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

-- Hide Form
    !!Mdsft25.hide()

    endif

   !!MdsDacControl(false)
-- End function
  endfunction

-- End of file Mdsacceptft25.pml
