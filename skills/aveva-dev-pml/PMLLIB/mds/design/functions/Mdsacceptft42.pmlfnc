--
-- File:		Mdsacceptft42.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MCPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAcceptFt42()

-- Initialise variables
  !Support = !!MdsFt42.Support
  !Stru    = !!MdsFt42.Support.Stru
  !Name    = !Stru.name
  !frame   = !Name & '/MAIN'
  VAR !SupportFrame  EXISTS $!frame

-- Check that creation is complete
  if (!Support.Datum.badref() and !SupportFrame eq 'FALSEA')then
    !!Alert.message('Support frame and datum atta have to exist before creation can be ended')
    return
  endif

  if (!Support.Datum.badref())then
    !!Alert.message('Support datum has to exist before creation can be ended')
    return
  endif

  if (!SupportFrame eq 'FALSEA')then
    !!Alert.message('Support frame has to exist before creation can be ended')
    return
  endif

-- Store specific data to frame type 42 in uda :MDSCp1
  if (!Support.RotateCur)then
    !RCur = 'T'
  else
    !RCur = 'F'
  endif
  if (!Support.HandedCur)then
    !HCur = 'T'
  else
    !HCur = 'F'
  endif
  if (!Support.Mirror)then
    !Mirror = 'T'
  else
    !Mirror = 'F'
  endif

-- Check it can be changed and if it's been claimed out

  !!MdsDacControl(true)
  !!CE = !Support.Datum
  :MDSCp1 '$!RCur;$!HCur;$!Support.Rotated;$!Mirror'

-- Check if length of steelwork members exceed maximum of template
  !!MdsCheckLen(!!MdsFt42)
  if (!!MdsCheckLen.accept.not()) then
    return
  endif

-- Clear tags

  !!MdsClearTags()

-- Reset design representation if required
  call !!KActionCommands(!!MdsFt42.Repre)

-- Clear form gadgets for form frame type 42
  call !!MdsClearGadgets(!!MdsFt42)

  !!CE = !Support.Stru

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
  if (!!MdsModifySupp.Cancel.active.not())then
    !!MdsModifySupp.ApplyForm.remove(5)
      handle (2,752)
      endhandle
    !!MdsModifySupp.Cancel.active = true
  endif

-- Clear dimensions if shown

  !!MdsClearDim()

-- Hide Form
  !!MdsFt42.Hide()

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsacceptft42.pml
