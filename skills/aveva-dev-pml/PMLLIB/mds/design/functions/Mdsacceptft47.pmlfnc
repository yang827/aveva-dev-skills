--
-- File:		MdsacceptFT47.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MCPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAcceptFT47()

  -- Initialise variables
    !Support = !!MdsFT47.Support
    !Stru    = !!MdsFT47.Support.Stru
    !Name    = !Stru.name
    !Frame   = !Name & '/MAIN'
    VAR !SupportFrame  EXISTS $!Frame

  -- Check that creation is complete
    if (!Support.Datum.badref() and !SupportFrame eq 'FALSEA')then
      !!Alert.message('Support frame and datum atta have to exist before creation can be ended')
      return
    endif

    if (!Support.Datum.badref())then
      !!Alert.message('Support datum has to exist before creation can be ended')
      return
    endif

    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support frame has to exist before creation can be ended')
      return
    endif


    !!CE = !Support.Datum
    !!MdsDacControl(TRUE)

-- Fill in the :mdscp1 attribute so the modify does not fail
-- although we do not use it to store anything

    :MDSCp1 'F;F;0;F'

  -- Check if length of steelwork members exceed maximum of template
    !!MdsCheckLen(!!MdsFT47)
    if (!!MdsCheckLen.accept.not()) then
      return
    endif

  -- Clear graphical tags

    !!MdsClearTags()

  -- Reset design representation if required
    Call !!KActionCommands(!!MdsFT47.Repre)

  -- Clear form gadgets for form frame type FT47
    Call !!MdsClearGadgets(!!MdsFT47)

    !!CE = !Support.Stru

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
    if (!!MdsModifySupp.Cancel.active.not())then
      !!MdsModifySupp.ApplyForm.remove(5)
        handle (2,752)
        endhandle
      !!MdsModifySupp.Cancel.active = true
    endif

  -- Hide dimensions if shown

    !!MdsClearDim()

  -- Hide Form
    !!MdsFT47.Hide()
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file MdsacceptFT47.pml
