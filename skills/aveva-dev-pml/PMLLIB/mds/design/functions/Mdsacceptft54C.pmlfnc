--
-- File:  Mdsacceptft54C.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Richard Martin
-- Created:  January 2006
--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAcceptFT54C()

  -- check that no dimension errors have occured, if so display then to the user
  if (!!mdsFT54C.dimerrors.size().gt(0)) then
    !!alert.error('Support frame cannot be built until the following dimensional inconsistencies have been resolved:')
    do !error values !!mdsFT54C.dimerrors
      !!alert.error(!error)
    enddo
    return
  endif

  -- Initialise variables
  !support = !!mdsFT54C.support
  /$!!mdsFT54C.name.val
  handle any
    !!alert.message('Support has to exist before creation can be ended')
    return
  elsehandle none
    if !!ce.mcount eq 0 then
      !!alert.message('Support Steel Member Not Yet Created')
      return
    endif
  endhandle

  -- Check that creation is complete
  if (not defined(!support.atta[1]))then
    !!alert.message('Support has to exist before creation can be ended')
    return
  endif

  -- Store specific data to frame type 09 in uda :MDSCp1
  if (!support.rotateCur)then
    !rCur = 'T'
  else
    !rCur = 'F'
  endif
  if (!support.handedCur)then
    !hCur = 'T'
  else
    !hCur = 'F'
  endif
  if (!support.mirror)then
    !mirror = 'T'
  else
    !mirror = 'F'
  endif

  -- store despars
  !srefName = !support.datum.name.before('/DATUM') + '/SREF'
  !!ce = $!srefName
  !!mdsDacControl(true)
  DESPAR n 1 $!!mdsFT54C.dims[1]
  DESPAR n 2 $!!mdsFT54C.dims[2]
  DESPAR n 3 $!!mdsFT54C.dims[3]
  !!mdsDacControl(FALSE)

  -- Check it can be changed and if it's been claimed out
  !!mdsDacControl(true)
  !!ce = !support.datum
  :MDSCp1 '$!rCur;$!hCur;$!support.rotated;$!mirror'


  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
  call !!mdsClearGadgets(!!mdsFT54C)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    handle (2,752)
    endhandle
    !!mdsModifySupp.cancel.active = true
  endif

  !!ce = !support.stru

  -- Hide Form
  !!mdsFT54C.hide()
  call !!mdscleardim()
  !!mdsDacControl(false)

  -- End function
endfunction
