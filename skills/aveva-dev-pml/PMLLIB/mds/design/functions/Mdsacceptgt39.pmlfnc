--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAcceptGt39()

  -- Initialise variables
    !Support = !!MdsGt39.Support

  -- Check that creation is complete
    if (not defined(!Support.Atta[1]))then
      !!Alert.message('Support has to exist before creation can be ended')
      return
    endif

  -- Check if length of steelwork members exceed maximum of template
    !!MdsCheckPar(!!MdsGt39)
    if (!!MdsCheckLen.accept.not()) then
      return
    endif

--> Modified - <wd> - 10sep1998
-- Set the UDA ':MDSGuideRef' if PREVIOUS or NEXT Support Atta is
-- in the SAME Position as the GUIDE Datum Atta, at BOTH Attas

    call !!Mdssetguideref(!support)

--< Modified - <wd> - 10sep1998

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
    Call !!MdsClearGadgets(!!MdsGt39)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
    if (!!MdsModifySupp.Cancel.active.not())then
      !!MdsModifySupp.ApplyForm.remove(5)
        handle (2,752)
        endhandle
      !!MdsModifySupp.Cancel.active = true
    endif

  -- Hide Form
    !!MdsGt39.Hide()
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsacceptgt01.pml
