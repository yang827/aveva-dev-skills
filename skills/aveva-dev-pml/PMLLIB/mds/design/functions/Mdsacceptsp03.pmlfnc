--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAcceptsp03()

  -- Initialise variables
    !Support = !!MdsSp03.Support

  -- Check that creation is complete
    if (not defined(!Support.Atta[1]))then
      !!Alert.message('Support has to exist before creation can be ended')
      return
    endif

 -- Store specific data for mirror/rotation in :MDSCp1
    if (!Support.RotateCur)then
      !RCur = 'T'
    else
      !RCur = 'F'
    endif
    if (!Support.HandedCur)then
      !HCur = 'T'
    else
      !HCur = 'F'
    endif
    if (!Support.Mirror)then
      !Mirror = 'T'
    else
      !Mirror = 'F'
    endif
    !!CE = !Support.Datum
    !!MdsDacControl(true)
    :MDSCp1 '$!RCur;$!HCur;$!Support.Rotated;$!Mirror'

--> Modified - <wd> - 23sep1998
  -- Check if length of steelwork members exceed maximum of template
    !!MdsCheckPar(!!Mdssp03)
    if (!!MdsCheckLen.accept.not()) then
      return
    endif

-- Set the UDA ':MDSGuideRef' if PREVIOUS or NEXT Support Atta is
-- in the SAME Position as the GUIDE Datum Atta, at BOTH Attas

    call !!Mdssetguideref(!support)

--< Modified - <wd> - 23sep1998

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
    Call !!MdsClearGadgets(!!MdsSp03)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
    if (!!MdsModifySupp.Cancel.active.not())then
      !!MdsModifySupp.ApplyForm.remove(5)
        handle (2,752)
        endhandle
      !!MdsModifySupp.Cancel.active = true
    endif

  -- Hide Form
    !!MdsSp03.Hide()
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsacceptsp03.pml
