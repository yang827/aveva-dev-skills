--
-- File:		Mdsacceptspl.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MCPS126
--
-- Author:		I.Osborne
-- Created:		Tue Jun 17
--
--
-- Description:
-- function to check that created support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAcceptSpl()

-- Initialise variables
  !Support = !!MdsSpecial.Support
  !Stru   = !!MdsSpecial.Support.Stru
  !Name   = !Stru.name

-- Check that creation is complete
  if (!Support.Datum.badref())then
    !!Alert.message('Support datum has to exist before creation can be ended')
    return
  endif

-- Check if length of steelwork members exceed maximum of template
  !!MdsCheckLen(!!MdsSpecial)
  if (!!MdsCheckLen.accept.not()) then
    return
  endif

-- Clear graphical tags

  !!MdsClearTags()

-- Reset design representation if required
  Call !!KActionCommands(!!MdsSpecial.Repre)

-- Clear form gadgets for form frame type 03
  Call !!MdsClearGadgets(!!MdsSpecial)

  !!CE = !Support.Stru

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
  if (!!MdsModifySupp.Cancel.active.not())then
    !!MdsModifySupp.ApplyForm.remove(5)
      handle (2,752)
      endhandle
    !!MdsModifySupp.Cancel.active = true
  endif

-- Ask user if he wants the special to be a special, not a framatome std

  !TemplateUsed = !Stru.:MdsProjSpec
  if !TemplateUsed.badref().not() then
    if !TemplateUsed.owner.function.eq('FRAMATOME HVAC') then
      if !TemplateUsed.desc.eq(!Stru.desc) then
        kill !!MDSFramSpec
        setup form !!MDSFramSpec blocking noquit
        title 'HVAC - Support Definition'
        path down
        button .standard at x0 y0.5 'HVAC - Standard Support => Duct Support List' call |!this.answer = 1 hide !!mdsframspec|
        --button .standard at x0 y0.5 pixmap width 100 height 50 call |!this.answer = 1 hide !!mdsframspec|
        para .std width 30 lines 1
        vdist 1
        button .special             'HVAC - Special Support  => Drawing Necessary' call |!this.answer = 2 hide !!mdsframspec|
        --button .special             pixmap width 100 height 50 call |!this.answer = 2 hide !!mdsframspec|
        member .answer is real
        exit
        !!MdsFramSpec.std.val = ' HVAC Standard = ' + !Stru.desc
        waiton !!MdsFramSpec
        if !!MdsFramSpec.answer.eq(2) then
          !!MdsDacControl(TRUE)
          !!ce = !stru
          desc ''
          :MdsProjSpec default
          same
          !!MdsDacControl(false)
        endif
      endif
    endif
  endif

-- Hide Form
  !!MdsSpecial.Hide()
  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsacceptspl.pml
