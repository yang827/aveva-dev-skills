--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    D.Whiteside
-- Created:   6 November 2008
--
--
-- Description:
-- function to check that created support is acceptable  (dun1052)
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAcceptST43()

  -- Initialise variables
  !support = !!mdsST43.support

  -- Check that creation is complete
  if (not defined(!support.atta[1]))then
    !!alert.message('Support has to exist before creation can be ended')
    return
  endif

  -- Check if length of steelwork members exceed maximum of template
  !!mdsCheckPar(!!mdsST43)
  if (!!mdsCheckLen.accept.not()) then
    return
  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

  -- Clear form gadgets
  Call !!mdsClearGadgets(!!mdsST43)

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    handle (2,752)
    endhandle
    !!mdsModifySupp.cancel.active = true
  endif

  -- Hide Form
  !!mdsST43.hide()
  !!mdsDacControl(false)
  -- End function
endfunction
