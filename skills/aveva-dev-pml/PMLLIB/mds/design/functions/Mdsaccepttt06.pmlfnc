--
-- File:		Mdsaccepttt06.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 20th February 1998
--
--
-- Description:
-- function to check that created 'tt06' support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsaccepttt06()

-- Initialise variables
    !support = !!Mdstt06.support
    !datum   = !!Mdstt06.support.datum
    !name    = !datum.name
    var !supportframe exists $!name

--------------------------------------------------------------------------------

-- Check that the material setting form is not displayed and if so reject finishing

    if !!MdsTrunMat.shown() then
      !!Alert.message('The form for setting the tube material is displayed and therefore the creation cannot be ended')
      return
    endif

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

--------------------------------------------------------------------------------

-- Store specific data to Trunnion type 'tt06' in uda :MDSCp1
    if (!support.rotatecur)then
      !rcur = 'T'
    else
      !rcur = 'F'
    endif
    if (!support.handedcur)then
      !hcur = 'T'
    else
      !hcur = 'F'
    endif
    if (!support.mirror)then
      !mirror = 'T'
    else
      !mirror = 'F'
    endif
    !!ce = !support.datum

    !!MdsDacControl(true)
    :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

--------------------------------------------------------------------------------
-- Check if length of TRUNNION exceeds Maximum Allowable Length in description file
  --   !!Mdschecklen(!!Mdstt06)
    -- if (!!Mdschecklen.accept.not()) then
      -- return
    -- endif

--------------------------------------------------------------------------------
  -- Clear graphical tags

    !!MdsClearTags()

--------------------------------------------------------------------------------

-- Reset design representation if required
    call !!kactioncommands(!!Mdstt06.repre)

-- Clear form gadgets for form TRunnion Type 'tt06'
    call !!Mdscleargadgets(!!Mdstt06)

--------------------------------------------------------------------------------

    !!ce = !support.datum

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

--------------------------------------------------------------------------------

-- Lock the trunnion automatically so as to stop the main pipe being dragged and the height oif the
-- trunnion exceeding the maximun height
-- Removed 20/11/02 Ncm

   -- !!ce = !support.datum
   -- bran
   -- lock all


-- Hide Form
    !!Mdstt06.hide()
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsaccepttt06.pml
