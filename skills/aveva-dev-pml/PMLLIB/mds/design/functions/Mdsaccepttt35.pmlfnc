--
-- File:		Mdsaccepttt35.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Barry Cheetham
-- Created:		Monday 2nd February 2004
--
--
-- Description:
-- function to check that created 'tt35' support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsaccepttt35()

-- Initialise variables
    !support = !!Mdstt35.support
    !datum   = !!Mdstt35.support.datum
    !name    = !datum.name
    var !supportframe exists $!name

--------------------------------------------------------------------------------

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

--------------------------------------------------------------------------------

-- Store specific data to Trunnion type 'tt35' in uda :MDSCp1
    if (!support.rotatecur)then
      !rcur = 'T'
    else
      !rcur = 'F'
    endif
    if (!support.handedcur)then
      !hcur = 'T'
    else
      !hcur = 'F'
    endif
    if (!support.mirror)then
      !mirror = 'T'
    else
      !mirror = 'F'
    endif
    !!ce = !support.datum

    !!MdsDacControl(true)
    :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

--------------------------------------------------------------------------------
-- Check if length of TRUNNION exceeds Maximum Allowable Length in description file
  --   !!Mdschecklen(!!Mdstt35)
    -- if (!!Mdschecklen.accept.not()) then
      -- return
    -- endif

--------------------------------------------------------------------------------
  -- Clear graphical tags

    !!MdsClearTags()

--------------------------------------------------------------------------------

-- Reset design representation if required
    call !!kactioncommands(!!Mdstt35.repre)

-- Clear form gadgets for form TRunnion Type 'tt35'
    call !!Mdscleargadgets(!!Mdstt35)

--------------------------------------------------------------------------------

    !!ce = !support.datum

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

--------------------------------------------------------------------------------

-- Lock the trunnion automatically so as to stop the main pipe being dragged and the height oif the
-- trunnion exceeding the maximun height
-- Removed 20/11/02 Ncm

   -- !!ce = !support.datum
   -- bran
   -- lock all


-- Hide Form
    !!Mdstt35.hide()
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsaccepttt35.pml
