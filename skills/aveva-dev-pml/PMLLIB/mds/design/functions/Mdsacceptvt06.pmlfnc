--
-- File:		Mdsacceptvt06.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Wednesday 13th May 1998
--
--
-- Description:
-- function to check that created 'VT06' support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsAcceptvt06()

-- Initialise variables
    !support = !!Mdsvt06.support
    !stru    = !!Mdsvt06.support.stru
    !name    = !stru.name
    !frame   = !name & '/MAIN'
    var !supportframe exists $!frame

--------------------------------------------------------------------------------

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Support frame and datum atta have to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Support datum has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Support frame has to exist before creation can be ended')
      return
    endif

--------------------------------------------------------------------------------

-- Store specific data to frame type 13 in uda :MDSCp1
    if (!support.rotatecur)then
      !rcur = 'T'
    else
      !rcur = 'F'
    endif
    if (!support.handedcur)then
      !hcur = 'T'
    else
      !hcur = 'F'
    endif
    if (!support.mirror)then
      !mirror = 'T'
    else
      !mirror = 'F'
    endif
    !!ce = !support.datum

    !!MdsDacControl(true)
    :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

--------------------------------------------------------------------------------

-- Check if length of steelwork members exceed maximum of template
    !!Mdschecklen(!!Mdsvt06)

    if (!!Mdschecklen.accept.not()) then
      return
    endif

  -- Clear graphical tags

    !!MdsClearTags()

--------------------------------------------------------------------------------

-- Reset design representation if required
    call !!kactioncommands(!!Mdsvt06.repre)

-- Clear form gadgets for form frame type 13
    call !!Mdscleargadgets(!!Mdsvt06)

--------------------------------------------------------------------------------

    !!ce = !support.stru

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

--------------------------------------------------------------------------------

-- Hide Form
    !!Mdsvt06.hide()
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsacceptvt06.pml
