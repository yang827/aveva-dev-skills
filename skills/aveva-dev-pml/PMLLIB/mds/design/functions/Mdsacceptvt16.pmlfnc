--
-- File:		MdsacceptVT16.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 20th February 1998
--
--
-- Description:
-- function to check that created 'VT16' support is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsacceptVT16()

-- Initialise variables
    !support = !!MdsVT16.support
    !datum   = !!MdsVT16.support.datum
    !name    = !datum.name
    var !supportframe exists $!name

--------------------------------------------------------------------------------

-- Check that creation is complete
    if (!support.datum.badref() and !supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!support.datum.badref())then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

    if (!supportframe eq 'FALSEA')then
      !!alert.message('Trunnion atta has to exist before creation can be ended')
      return
    endif

-- check that no dimension errors have occured, if so display then to the user
   if (!!mdsVT16.dimerrors.size().gt(0)) then
     !!alert.error('Support frame cannot be built until the following dimensional inconsistencies have been resolved:')
     !i = 0
     do !error values !!mdsVT16.dimerrors
       !!alert.error(!error)
     enddo
     return
   endif

--------------------------------------------------------------------------------

-- Store specific data to Trunnion type 'VT16' in uda :MDSCp1
    if (!support.rotatecur)then
      !rcur = 'T'
    else
      !rcur = 'F'
    endif
    if (!support.handedcur)then
      !hcur = 'T'
    else
      !hcur = 'F'
    endif
    if (!support.mirror)then
      !mirror = 'T'
    else
      !mirror = 'F'
    endif
    !!ce = !support.datum

    !!MdsDacControl(true)
    :MDSCp1 '$!rcur;$!hcur;$!support.rotated;$!mirror'

  --   !!Mdschecklen(!!MdsVT16)
    -- if (!!Mdschecklen.accept.not()) then
      -- return
    -- endif

--------------------------------------------------------------------------------
  -- Clear graphical tags

    !!MdsClearTags()

  -- clear dims
    call !!mdscleardim()

--------------------------------------------------------------------------------

-- Reset design representation if required
    call !!kactioncommands(!!MdsVT16.repre)

-- Clear form gadgets for form TRunnion Type 'VT16'
    call !!Mdscleargadgets(!!MdsVT16)

--------------------------------------------------------------------------------

    !!ce = !support.datum

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!Mdsmodifysupp.cancel.active = true
    endif

--------------------------------------------------------------------------------

-- Lock the trunnion automatically so as to stop the main pipe being dragged and the height oif the
-- trunnion exceeding the maximun height
-- Removed 20/11/02 Ncm

   -- !!ce = !support.datum
   -- bran
   -- lock all


-- Hide Form
    !!MdsVT16.hide()
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file MdsacceptVT16.pml
