--
-- File:		MdsActiveConns.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 23rd June 1998
--
--
-- Description:
-- Function to activate connection gadgets on forms that are already displayed.
-- This function is mainly called from the defaults form MdsOPTIONS, to activate
-- the said gadgets if the form is displayed.
--
-- There is no easy way to find out what forms are displayed which would make it efficient.
--
--  This function is the easiest way to do it, without changes to the existing cancel and
--  apply functions for each form. A better way would be to populate a global
--  each time the form is displayed and removed from the global when cancelled/dismissed,
--  but this would require changes to all form functions.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [String]      [Activate gadgets or not , passed 1,2 or 3 depending on option gadget selection]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsActiveConns(!Option is string)

  -- Initialise variables
    if(!Option.eq('3')) then
        !TRUEorFALSE1 = TRUE
        !TRUEorFALSE2 = TRUE
        !TRUEorFALSE3 = TRUE
    elseif(!Option.eq('2')) then
        !TRUEorFALSE1 = TRUE
        !TRUEorFALSE2 = FALSE
        !TRUEorFALSE3 = TRUE
    else
        !TRUEorFALSE1 = FALSE
        !TRUEorFALSE2 = FALSE
        !TRUEorFALSE3 = FALSE
    endif

-- list of support forms which may be used for steelwork connections

!FormList = Array()

-- !FormList.append(!!Mdsan01)
-- !FormList.append(!!Mdsat01)
-- !FormList.append(!!Mdsft01)
-- !FormList.append(!!Mdsft02)
!FormList.append(!!Mdsft03)
!FormList.append(!!Mdsft04)
!FormList.append(!!Mdsft05)
!FormList.append(!!Mdsft06)
!FormList.append(!!Mdsft07)
!FormList.append(!!Mdsft08)
!FormList.append(!!Mdsft09)
!FormList.append(!!Mdsft10)
!FormList.append(!!Mdsft11)
!FormList.append(!!Mdsft12)
!FormList.append(!!Mdsft13)
!FormList.append(!!Mdsft14)
!FormList.append(!!Mdsft15)
!FormList.append(!!Mdsft17)
!FormList.append(!!Mdsft18)
!FormList.append(!!Mdsft19)
-- !FormList.append(!!Mdsft21)
-- !FormList.append(!!Mdsft22)
!FormList.append(!!Mdsft23)
!FormList.append(!!Mdsft24)
-- !FormList.append(!!Mdsft25)
-- !FormList.append(!!Mdsft28)
!FormList.append(!!Mdsft35)
--<GE> 08/01/07 Defect 10046
-- !FormList.append(!!Mdsft38)
--<GE> 08/01/07
-- !FormList.append(!!Mdsgt01)
-- !FormList.append(!!Mdsgt02)
-- !FormList.append(!!Mdsgt03)
-- !FormList.append(!!Mdsgt04)
!FormList.append(!!Mdsgt05)
-- !FormList.append(!!Mdssp01)
-- !FormList.append(!!Mdssp02)
-- !FormList.append(!!Mdssp03)
-- !FormList.append(!!Mdsht01)
-- !FormList.append(!!Mdsht03)
-- !FormList.append(!!Mdsst01)
-- !FormList.append(!!Mdsst02)
-- !FormList.append(!!Mdsst03)
-- !FormList.append(!!Mdsst04)
-- !FormList.append(!!Mdsst05)
-- !FormList.append(!!Mdstrunnvt01)
-- !FormList.append(!!Mdstt01)
-- !FormList.append(!!Mdstt02)
-- !FormList.append(!!Mdstt03)
-- !FormList.append(!!Mdsvt01)
-- !FormList.append(!!Mdsvt02)
-- !FormList.append(!!Mdsvt03)
-- !FormList.append(!!Mdsvt04)
-- !FormList.append(!!Mdsvt05)
-- !FormList.append(!!Mdsvt06)

  do !form values !FormList
     if(!form.shown()) then
       -- activate connection gadgets
       !Form.Connect.Active = !TRUEorFALSE1
         handle any
           -- in case connection gadget do not exist on form
           elsehandle none
             !Form.Modify.Active    = !TRUEorFALSE2
             !Form.ForceCon.Active  = !TRUEorFALSE2
             !Form.DisConn.Active   = !TRUEorFALSE3
           endhandle
     endif
  enddo

-- End function
endfunction

-- End of file MdsActiveConns.pml
