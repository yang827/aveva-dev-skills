--
-- File:    MdsAddall.pml
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Andrew Kirkland
-- Created:   Tues 23rd June 1998
--
--
-- Description:
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [String]      name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddAll(!Name is STRING)

  IF (|$!Name| EQ ||) THEN

    VAR !NAME |$_NAME|

  ELSE

    VAR !NAME |$!Name|

  ENDIF

$****************************************************
$* Macro to add a support structure and all its pipes
$****************************************************

  IF (|$!NAME| EQ |unset|) THEN
    RETURN
  ENDIF

  ADD /$!NAME

$*************************
$* Add additional supports
$*************************

  DO !COUNT FROM 1 TO 40
    /$!NAME$N.$N$!COUNT
      HANDLE (41,69) (2,109) (2,109)
        skip
      ENDHANDLE
    ADD CE
  ENDDO

$*******************
$* Add datum support
$*******************

  ADD /$!NAME/DATUM
    HANDLE (41,69) (2,109) (2,109)
      /$!NAME
      RETURN
    ENDHANDLE

--------------------------------****** connexions ******* -------------------------------
--<wd>19dec2000
-- Determine the Connected Joints for the MDS support, if any exist,
-- so that they can be added to to the Graphical Display
--
    !fname = '/' & !name
    !!ce   = !fname.dbref()
    !cenam = !!ce.name
--Skip if type is NOT a STRUCTURE, or type is a STRUCTURE but is a BedPlate Type - FT22
    -- skip if (!!ce.type.neq('STRU'))
    -- skip if (!!ce.:MDSSuppType.eq('FT22'))

    !VertDbref    = array()
    !Vert1        = !cenam & '-V1'
    !Vertdbref[1] = !Vert1.dbref()
    handle any
-- incase  no Verts (bed plate) (may be (-BAR-1 ft07))
      !Vert1        = !cenam & '-BAR-1'
      !Vertdbref[1] = !Vert1.dbref()
      handle any
      endhandle
    elsehandle none
      !Vert2        = !cenam & '-V2'
      !Vertdbref[2] = !Vert2.dbref()
      handle any
-- Supports where ONE Cross Bar may also be connected (FT10,FT11,FT13,FT15,DT02,FT38)
        !Vert2        = '/' & !Name & '-BAR-1'
        !Vertdbref[2] = !Vert2.dbref()
        handle any
-- incase only one SCTN exists
        endhandle
      endhandle
    endhandle
-- Add the External Connected Joints, if any EXIST, to the Graphical Display
    !joints = !!Mdsgetnodes(!vertdbref)
      handle none
        do !conn values !joints
          add $!conn
        enddo
      elsehandle any
      -- no EXTERNAL joints
      endhandle
--<wd>19dec2000
-----------------------------------------------------------------------------------------

$***********************************************
$* Leave user at support structure or attachment
$***********************************************

  /$!NAME

RETURN
