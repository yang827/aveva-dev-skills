------------------------------------------------------------------------------
--
-- File:		Mdsaddallsupp.pmlfnc
--   Type:		Result Macro
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon Aug 18
--
--
-- Description:
-- Macro to add all support from the current element using the
-- colour from the member list or all supports
------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [String]      Option of 'CE'or 'ALL'
--    [2]   [R]      [Array ]      DBREF array of SCTNS on the Support which MAY be
--                                 EXTERNALLY connected to Supporting Steelwork
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!MdsAddAllSupp(!option is string)

-- Confirm that the user really requires this operation and set the element
-- name if he returns a yes

  if (!option eq 'CE') then
    !yesno = !!Alert.confirm('Are you sure you want to add all supports under the current element to the drawlist')
    if (!yesno eq 'YES') then
      !Element = !!CE.name
    else
      return
    endif
  else
    !yesno = !!Alert.confirm('Are you sure you want to add all supports to the drawlist')
    if (!yesno neq 'YES') then
      return
    endif
  endif

  !Origin = !!CE

-- Collect all restraints, attas and strus that belong to a support

   if (!option eq 'CE') then
     -- var !Support eval (NAME) for all STRU with (PURP OF ZONE eq 'SUPP') for ce
     var !Support eval (NAME) for all STRU with ($!!mdsidsatt of zone eq '$!!mdsidsval') for ce
   else
     --var !Support eval (NAME) for all STRU with (PURP OF ZONE eq 'SUPP')
     var !Support eval (NAME) for all STRU with ($!!mdsidsatt of zone eq '$!!mdsidsval')
   endif


  -- Collect all support attachments from design database
   if (!option eq 'CE') then
     var !Support append eval (NAME) for all ATTA wi ((match(NAME OF SPREF,'/MDS') neq 0) and (match(NAME,'/SREF') eq 0)) for ce
   else
     var !Support append eval (NAME) for all ATTA wi ((match(NAME OF SPREF,'/MDS') neq 0) and (match(NAME,'/SREF') eq 0))
   endif

-- Collect all Restraints/Hangers from the Design Database
    if (!option eq 'CE') then
      if (!!ce.owne.type.eq('HANG')) then
        !!ce = !!ce.owne.owne
      elseif (!!ce.owne.type.eq('REST')) then
        !!ce = !!ce.owne
      endif
-- CE is a Restraint
      !rname = !!ce.name
      var !support append(!rname)
    else

    endif

--<kp>feb07 Collect all lights from design database
    if !!Mdslsuppdefs.Error.Unset() then
    -- lighting defaults loaded
       if !Option.eq('CE') then
          !Ownls = !!ce.ownls !Ownls.append(ce)
          if !Ownls.size().lt(3) then
             var !Support append eval (NAME) for all $!!Mdslsuppdefs.Idtype with $!!MdslsuppDefs.Idfilter for ce
          elseif !Ownls[3].type.eq('EQUI') then
             !Support.append(!ownls[3].name)
          endif
       else
         var !support append eval (NAME) for all $!!Mdslsuppdefs.Idtype with $!!MdslsuppDefs.Idfilter
       endif
    endif
--<kp>feb07


-- Loop through each element found and obtain the support name
  !suppname = array()
  do !a values !Support
    !!CE = !a.dbref()
    !name = !!CE.Name
    if (match(!name,|/DATUM|) gt 0) then
      var !suppname append (before(!name,'/DATUM'))
    elseif (match(!name,|/SREF|) gt 0) then
      var !suppname append (before(!name,'/SREF'))
    else
      if (!!ce.type.eq('ATTA')) then
        var !suppname append (before(!name,'.'))
      elseif (!!ce.type.eq('STRU')) then
        var !suppname append name
--<kp>feb07 Add supported light if lighting support
          if !!ce.:MdsSuppType.eq(!!MdslsuppDefs.type) then
             !LightName = !!ce.:MdsSref.Name
                handle NONE
                  !suppname.append(!LightName)
                elsehandle ANY
                endhandle
          endif
      elseif !!ce.type.eq(!!MdsLsuppdefs.idtype).and( $!!Mdslsuppdefs.idfilter ) then
      -- add support and light if there is any
         if !!ce.:mdssref.badref().not() then
            !suppname.append(!!ce.name)
            !suppname.append(!!ce.:mdssref.name)
         endif
      endif
    endif
--<kp>feb07


-- Add Restraints
    if (!!ce.type.eq('REST')) then
      !rname = !!ce.name
      var !suppname append(!rname)
      !aname = !rname.before('/REST')
      var !suppname append(!aname)
    endif

-- Add Restraints referenced by MDS Attas
    if (!!ce.type.eq('ATTA')and (!!ce.cref.set())) then
      if (!!ce.cref.type.eq('HANG'))then
        !hang = !!ce.cref.owne.name
        var !suppname append(!hang)
        !aname = !!ce.name
        var !suppname append(!aname)
      endif
    elseif (!!ce.type.eq('ATTA')and (!!ce.cref.unset())) then
-- Check if ATTA is Associated to a Restraint by Name ONLY
-- e.g. Second Hanger on a Twin Hanger Assembly does NOt have its 'CREF' attribute set
      !aname = !!ce.name
      !xname = !aname & '/REST'
      !!ce   = !xname.dbref()
      handle none
        var !suppname append(!xname)
        var !suppname append(!aname)
      elsehandle any
-- No Restraint Exists for the ATTA
      endhandle
    endif
  enddo

  !suppname.unique()

-- Obtain the current colour
  !Visible = !!GphColOpt.Visible().Code
-- Sort the array to get rid of any duplicates
  !suppname.unique()
  !suppname.sort()

-- OK we have found all the support names now add them with the current
-- add colour
  if ( !Suppname.empty() ) then
    !!Alert.message('No support found to add to the drawlist')
    return
  endif

  do !add values !Suppname
-- Add the support -- (The Restraints are Added Here)
    !!MdsRemAdd(|$!add|,!Visible)
-- Add the datum atta if it exists
    !!MdsRemAdd(|$!add$n/DATUM|,!Visible)

-- Add the extra pipes if they exist
    do !num from 1 to 30
      !!MdsRemAdd(|$!add$n.$!num|,!Visible)
    enddo
--------------------------------****** connexions ******* -------------------------------
--<wd>19dec2000
-- Determine the Connected Joints for the MDS support, if any exist,
-- so that they can be added to to the Graphical Display
    !!ce = !add.dbref()
    !cenam = !!ce.name
--Skip if type is NOT a STRUCTURE, or is a STRUCTURE but is a BedPlate Type - FT22
    skip if (!!ce.type.neq('STRU'))
    skip if (!!ce.:MDSSuppType.eq('FT22'))
    !VertDbref    = array()
    !Vert1        = !cenam & '-V1'
    !Vertdbref[1] = !Vert1.dbref()
    handle any
-- incase  no Verts (bed plate) (may be (-BAR-1 ft07))
      !Vert1        = !cenam & '-BAR-1'
      !Vertdbref[1] = !Vert1.dbref()
       handle any
       endhandle
    elsehandle none
      !Vert2        = !cenam & '-V2'
      !Vertdbref[2] = !Vert2.dbref()
      handle any
-- Supports where ONE Cross Bar may also be connected (FT10,FT11,FT13,FT15,DT02,FT38)
        !Vert2        = '/' & !Name & '-BAR-1'
        !Vertdbref[2] = !Vert2.dbref()
        handle any
-- incase only one SCTN exists
        endhandle
      endhandle
    endhandle
-- Add the External Connected Joints, if any EXIST, to the Graphical Display
    !joints = !!Mdsgetnodes(!vertdbref)
      handle none
        do !conn values !joints
          !!Mdsremadd('$!conn',!visible)
        enddo
      elsehandle any
      -- no EXTERNAL joints
      endhandle
--<wd>19dec2000
-----------------------------------------------------------------------------------------
  enddo

  !!CE = !Origin

endfunction
