--
-- File:		Mdsaddancill.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- show plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          GADGET     Gadget identifying support number to be shown
--     2     R          STRING     Text to determine if form should be shown
--                                 'Show' wil activate the form.
--     3     R          FORM       Form name to get selection from.
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsaddancill(!Gadget is GADGET, !String is STRING, !Form is FORM)

  -- Initialise variables
  if (!String.upcase() eq 'SHOW')then
    !Show = True
  else
    !Show = False
  endif

  -- Store Current Support Form name and required function in Main form for use later

  !!MdsSetSupp(!Form)
    handle any
    endhandle


  -- Load required plotfile
  -- !PlotFileName = 'P-' & !Gadget.Rtext[!Gadget.Val]
  !PlotFileName = 'MDS-Standards-' & !Gadget.Rtext[!Gadget.Val] & '-1.plt'
  if !Gadget.Rtext[!Gadget.Val].eq('PIPE-REST') then
    !PlotFileName = 'MDS-Standards-' & 'RT01' & '-1.plt'
  elseif !Gadget.Rtext[!Gadget.Val].eq('PIPE-REST-INLINE') then
    !PlotFileName = 'MDS-Standards-' & 'RT02' & '-1.plt'
  elseif !Gadget.Rtext[!Gadget.Val].eq('RACK-REST') then
    !PlotFileName = 'MDS-Standards-' & 'CA01' & '-1.plt'
  endif
  !SearchPath = 'MDS-Standards-' & !Gadget.Rtext[!Gadget.Val]

  !ProjectStand = !Gadget.Dtext[!Gadget.Val]
  !ProjectStandard = !ProjectStand.before(' ')

  !StandardName = !gadget.rtext[!gadget.val]
  if !Gadget.Rtext[!Gadget.Val].eq('PIPE-REST') then
    !StandardName = 'RT01'
  elseif !Gadget.Rtext[!Gadget.Val].eq('RACK-REST') then
    !StandardName = 'CA01'
  elseif !Gadget.Rtext[!Gadget.Val].eq('PIPE-REST-INLINE') then
    !StandardName = 'RT02'
  endif

  var !PlotPath file /%MDSPLOTS%/$!PlotFileName
    handle any
      var !PlotPath file /%PDMSUI%/DES/MDS/PLOT/$!PlotFileName
        handle any
          !!Alert.Warning(|Cannot access plotfile for reading?|)
          return
        endhandle
    endhandle


  edit !!MdsShowAncill.Plot PLOT
    -- add /%PDMSUI%/DES/MDS/PLOT/$!PlotFileName
    add /$!PlotPath
      handle (61,251)
        !!Alert.Warning(|Cannot access plotfile for reading?|)
        return
      endhandle
  exit

  !listofplotfiles = !!mdsgetplot(!Standardname)

  if !ListOfPlotfiles.size().eq(1) then
    !!Mdsshowancill.prev.active = false
    !!Mdsshowancill.next.active = false
  else
    !!Mdsshowancill.prev.active = false
    !!Mdsshowancill.next.active = true
  endif

  !!Mdsshowancill.plots.clear()
  !!Mdsshowancill.plots.append(!ListofPlotfiles)
  !!Mdsshowancill.sheet = 1
  !Sheets = !ListOfPlotFiles.size()
  !!Mdsshowancill.sheets.val = 'Displaying Sheet $!!Mdsshowancill.sheet of $!Sheets'

-- Modify project support type para gadget
  !!MdsShowAncill.projtype.val = 'Project Standard = $!ProjectStandard'

-- Display Plotfile form
  if (!Show)then
    call !!KshowForm(!!MdsShowAncill)
  endif

-- End function
endfunction

-- End of file Mdsaddancill.pml

return
