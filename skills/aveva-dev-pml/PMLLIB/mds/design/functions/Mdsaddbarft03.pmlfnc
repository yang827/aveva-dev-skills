--
-- File:    Mdsaddbarft03.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MBARPS126
--
-- Author:    I.osborne
-- Created:		Tue Jun 10
--
--
-- Description:
-- function to create support cross-bars on frame type 03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT   Support object
--     2     R        STRING        Method of adding bars. NEW or OLD
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAddBarFt03(!support is MDSSUPPORT, !method is STRING, !createBy is STRING)

-- The stru will now store the :mdsbars attribute of true/false allowing the creation of bars or not

  if not !!mdsCheckBars(!support) then
    return
  endif

-- Find current units and set the distance unit to metric

    !currentUnits = !!kGetSetUnits()

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  !form      = !!mdsFt03
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
      if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
        !despars = !srefName.dbref().despar
        !!mdsResetDims(!form,!despars)
        !!kRestoreUnits(!currentunits)
        !!alert.error('Unable to add a cross bar as write access to the SREF atta is not available')
        return
      endif
  endif


  -- Initialise variables
    !name      = !support.stru.name
    --<k.pleschner>May06
    --!clearance = !!mdsOptions.clear.val
    !overlap   = !!mdsOptions.overlap.val
    -- !creation  = !!mdsFt03.create.selection('Rtext')
    -- !selection = !!mdsFt03.size.selection('Rtext')
    !selection = !!mdsSetSteel.size.selection('Rtext')
    !alias     = !!mdsFt03.support.alias

  -- Check that a support has been created
    if (!support.stru.mcount() eq 0)then
      !!alert.error('Create framework before adding bars.')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- This facility is not available on configuration 2
    if (!support.config eq 2)then
      !!alert.message('This facility is not available for this configuration')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- Navigate to structure
    !!ce = !support.stru

  -- Check current number of bars
    if (!method eq |NEW|)then
      if (!support.bars.size() eq 6)then
        !!alert.error('Maximum number of cross bars already used')
        !!kRestoreUnits(!currentunits)
      return
      endif
    endif

  -- Get list of all attas already associated with bars
    !associated = ARRAY()
    if (!support.bars.empty().not())then
      do !i indices !support.bars
        !associated.appendarray(!support.bars[!i])
      enddo
    endif

    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)
    !last = !bars.size()
    !next = !bars.size() + 1

        --***
    !!ce = $!<name>-BAR-1
    !drnsOfCrossbar = !!ce.drns
    drns e

    !!ce = $!<name>-BAR-$!last
    end
    last mem
    NEW SCTN COPY $!<name>-BAR-1
    NAME $!name-BAR-$!next
    !sctn = !!ce

    --***MJB
    drns e
    --***

  -- ************************************************
  --  Identify attas to be associated with cross bar
  -- ************************************************

    !references = ''

    if (!method eq |NEW|)then
      !colourList = ARRAY()
      !list       = ARRAY()
      !barNumber  = ARRAY()
      do
        PROMPT OFF
        PROMPT LOAD ESCAPE |Identify atta to support|
        ID ATTA CTSUPP@
          handle (61,528)
            if (!list.empty())then
              PROMPT DISMISS
              PROMPT ON
              !!ce = !sctn
              DELETE SCTN
              !!ce = !support.stru
              !!kRestoreUnits(!currentunits)
              return
            else
              break
            endif
          endhandle
        !picked = !!ce
        if !list.find(!picked).size() gt 0 then
          !!alert.message('Atta already selected')
        elseif (!picked eq !support.datum)then
          !!alert.message('Datum atta cannot be selected')
-----------------------------------------------------------------------
--> Added - <wd> - 26aug1998
-- Reject the SREF atta as if the DATUM atta has been selected,
-- if picked by identifying the LSTU of the BRANCH
      elseif (!picked.name.eq(!name & '/SREF')) then
          !!alert.message('Datum atta cannot be selected')
--< Added - <wd> - 26aug1998
-----------------------------------------------------------------------
        elseif (!associated.find(!picked).size() gt 0)then

        -- Disassociate picked atta with existing bar
          !barNumber.append(!!mdsunlinkAtta(!!mdsFt03, !picked))

          !list.append(!picked)
        -- Colour Attas
          Enhance ce colour 2
          refresh
        else
          !list.append(!picked)
        -- Colour Attas
          Enhance ce colour 2
          refresh
        endif
      enddo
      PROMPT DISMISS
      PROMPT ON

      -- Adjust length of bar
      !barNumber.unique()
      do !indx indices !barNumber
        Call !!mdsAdjustBar(!!mdsFt03, !barNumber[!indx])
      enddo

      do !i indices !list
        !references = !references & ' ' & !list[!i].string()
      enddo

    else
      !list = !support.bars[$!next]
      do !i indices !list
        !references = !references & ' ' & !list[!i].string()
      enddo
    endif

  -- Set atta reference to section
    !!ce = !sctn
    :MDSAttaRef $!references

  -- Take additional highlight colour off attas
    Call !!kEnhanceList(!list)

  -- ************************************
  --  Get direction that bar has to move
  -- ************************************

    !!ce = !support.datum
    PIN 1 COPY P10 of CE
    PIN 1 PLANE PIN1 CLEAR 0 BEH $!<name>-V1
    VAR !dir CONS DIR P10 TO PIN 1

  -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !support.p10Dir
    !direction.directionB = !dir.direction()
    !direction.tolerance  = 0.05

  -- Check directions
    if (!!kDirEqualDir(!direction)) then
      PIN 1 PLANE PIN1 CLEAR 0 INF $!<name>-V1
    endif
     !dist = !!kstrReal('CONST DIST P0 TO PIN 1')
    PIN 1 DIR FROM P0 TO PIN 1
    PIN 1 AT P9
    PIN 1 PLANE PIN 1 DIST $!dist

    !start = posstart of $!<name>-V1
    !end   = posend of $!<name>-V1
    var !lineA CONS Line JOIN $!start to $!end
    var !lineB CONS Line JOIN $!end to $!start
    var !inter CONS POS NEAR PIN 1 ON $!lineA
    PIN 2 COPY PIN 1
    PIN 2 AT $!inter wrt worl
     !d1 = !!kstrReal('CONST DIST PIN 2 to $!start')
     !d2 = !!kstrReal('CONST DIST PIN 2 to $!end')
    !max = MAX(!d1, !d2)

    if (!max.eq(!d1))then
      VAR !p2Dir CONS DIR $!lineB
    elseif (!max.eq(!d2))then
      VAR !p2Dir CONS DIR $!lineA
    endif
    PIN 2 DIR $!p2Dir

    PIN 1 OFF
    PIN 2 OFF

  -- *****************************************************
  --  Work out distance to move new cross bar and move it
  -- *****************************************************

    !distance = 0
    !sign = ARRAY()
    !barDist = ARRAY()
    do !v values !list
      PIN 9 COPY PIN 2
      PIN 9 PLANE PIN 9 THRO P9 OF $!v
      VAR !p9P2Dir CONST DIR PIN9 TO PIN 2

      if (!p9P2Dir eq '')then
        !!alert.error('Cross Bar is in the same place as an existing member')
        !!ce = !sctn
        DELETE SCTN
      endif

   -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !p9P2Dir.direction()
      !direction.directionB = !p2Dir.direction()
      !direction.tolerance  = 0.05

      if (!!kDirEqualDir(!direction))then
        !sign.append('ABOVE')
      else
        !sign.append('BELOW')
      endif

       !cDist = !!kstrReal('CONST DIST PIN 2 TO PIN 9')
      !barDist.append(!cDist)

    enddo
    !!ce = !sctn

    !below = !sign.find('BELOW')
    !above = !sign.find('ABOVE')

    if (!above.size() eq !barDist.size())then
    -- All attas are above the datum. Take the smallest distance to move
      !barDist.sort()
      !distance = !barDist.first()
      !pin9Dist = !distance * -1
    elseif (!below.size() eq !barDist.size())then
    -- All attas are below the datum. Take the largest distance to move
      !barDist.sort()
      !distance = !barDist.last()
      !pin9Dist = !distance
    else

    -- Work out largest distance for those attas below the datum
      !belowDist = ARRAY()
      do !v values !below
        !belowDist.append(!barDist[!v])
      enddo
      !belowDist.sort()
      !distance = !belowDist.last()
      !pin9Dist = !distance
    endif

  -- Reposition PIN 9 to end of crossbar and define direction bar has to move
    PIN 9 COPY PIN 2
    PIN 9 DIST $!pin9Dist
    VAR !dir CONST DIR PIN 2 TO PIN 9

  -- Move section to correct place
    if (!distance.neq(0)) then
-- If first member of cross bar list is 180 degrees opposite to datum atta +- 1 degree
-- move bar extra distance
      !p9DirOfDatum = p9 dir of $!support.datum
      !p9DirOfMem1 = p9 dir of $!list[1]
      !angle = !p9dirofdatum.angle(!p9dirOfMem1)
      if !angle.geq(175) and !angle.leq(185) then
        pin 3 copy p9 of $!list[1]
        pin 5 copy pin 3
        pin 3 plane pin 3 clear 0 inf ce
        pin 5 plane pin 5 clear 0 beh ce
        var !extraDist const dist pin 3 to pin 5
        !distance = !distance + !extraDist.real()
      endif
      MOVE $!dir WRT WORLD DIST $!distance
      !bDir = !dir
      !bdist = !distance
    else
      !!alert.error('Cross Bar is in the same place as an existing member')
      !!ce = !sctn
      DELETE SCTN
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- ************************************
  --  Extend End past attas by clearance
  -- ************************************
    VAR !slide CONS DIR P9 OF $!support.datum TO PIN 1
    PIN 6 COPY PIN 2
    PIN 6 AT PIN 1
    PIN 6 PLANE PIN 6 THRO PIN 9
    PIN 9 COPY PIN 6
    PIN 8 AT PIN 6
    PIN 6 PLANE PIN 6 CLEAR 0 INF CE
    PIN 8 DIR $!slide wrt world
    PIN 8 PLANE $!slide wrt world THRO P9 OF $!list[1]
    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

    !dim = 0

    do !i values !list
--<k.pleschner>Apr06 to construct length of bar use value taken from ancillaries instead of default clearance
      !ancgeom = object MDSANCGEOMDFLTS(!i)
      PIN 4 COPY PIN 9
--      PIN 4 PLANE PIN 4 CLEAR $!clearance INF $!i
      if !ancgeom.clge.eq('GEOM') then
         -- use clearance from geometry
         PIN 4 PLANE PIN 4 CLEAR $!ancgeom.oend INF $!i
      else
         --use distance from centreline
         PIN 4 PLANE PIN4 thr $!ancgeom
         PIN 4 PLANE PIN 4 DISTANCE -$!ancgeom.oend
      endif
        handle (2,109)
          break
        endhandle
      !cdim = !!kstrReal('CONST DIST PIN 9 TO PIN 4')
      if (!cdim.gt(!dim)) then
        !dim = !cdim
      endif
    enddo
    PIN 4 COPY PIN 9
    PIN 4 DIST -$!dim


  -- Get correct end to extend
    VAR !sctnDir PIN 8 DIR WRT WORLD
    !startDir = !!ce.drnstart.wrt(world)
    !endDir   = !!ce.drnend.wrt(world)

  -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !sctnDir.direction()
    !direction.directionB = !startDir
    !direction.tolerance  = 0.05

    if (!!kDirEqualDir(!direction)) then
      !sctnEnd = 'END'
      !subsDir = !endDir
    else
      !sctnEnd = 'START'
      !subsDir = !startDir
    endif



--> Modified - <wd> - 25aug1998
--    EXTEND $!sctnEnd THRO PIN 4
      EXTEND $!sctnEnd THRO PIN 4
--< Modified - <wd> - 25aug1998

$(
    if (!method eq |OLD| and !createBy eq |DIMENSION|)then

    !newLen = deri length

      if (!support.barLen[$!next] gt !newLen)then
        !diff = !support.barLen[$!next] - !newLen
        PIN4 PLANE PIN 8 DIST $!diff
        EXTEND $!sctnEnd THRO PIN 4
          -- handle (73,214)
            -- extend $!sctnend -10
            -- EXTEND $!sctnEnd THRO PIN 4
          -- endhandle

      endif
    endif
$)

    !!ce = $!<name>/SUBS1
      handle none
        NEW SUBS $!<name>/SUBS$!<next> COPY PREV
        MOVE $!bDir WRT WORLD DIST $!bdist
        MOVE $!subsDir THRO PIN 4
        PIN3 COPY PIN4
        PIN3 PLANE PIN3 CLEAR 0 INF CE
        MOVE $!subsDir thro pin3
      elsehandle any
      endhandle

  -- ********************************************
  --  Set correct spref for number of cross bars
  -- ********************************************

    !!ce = $!<name>/SREF

    !!mdsDacControl(true)
    --SEL SPREF WITH STYP '$!Alias-C-$!Next-$!Selection' SPEC /MDF
    !styp = !alias & '-C-' & !next & '-' & !selection
    !!mdsSelectAttaSpref(!styp, /MDF )
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-C-1-1')
    !!mdsDacControl(false)

  -- Update form data

  -- Get data to update support info held in form
    !!ce = !sctn
    !barLen = deri length

  -- Update form data
    if (!method eq |NEW|)then
      !!mdsFt03.support.bars.append(!list)
      !!mdsFt03.support.barLen.append(!barLen)

    -- Enhance elements using colour set for highlight
      !!ce = !support.stru
      !colourList = ARRAY()
      !colourList.append(!!ce)
      !colourList.append(!list)

    -- Colour Support
      Call !!kEnhanceList(!colourList)
    else
      !!mdsFt03.support.barLen[!next] = !barLen
    endif

  -- *******************************************
  --  Do the connecting sections need extending
  -- *******************************************

  !!ce = $!<name>-V1

  !wAS = DERI LENG

  if (!support.mirror)then
    !sTEN =  'END'
    !end = Posend wrt world
  else
    !sTEN = 'START'
    !end = Posstart wrt world
  endif

  EXTEND $!sTEN THRO PIN 6
  if !!ce.:MdsOlap.eq('OVERLAP') then
    !overlap = !!ce.:MDSOnum
  elseif !!ce.:MdsOlap.eq('FLUSH') then
    !overlap = 0
  endif
  if !overlap.string().match('-').eq(1) then
    !overlap = !overlap.abs()
  endif
  EXTEND $!sTEN -$!overlap
  --EXTEND $!sTEN $!overlap

  PIN 7 AT $!end

  !iS = DERI LENG

  if (!wAS.gt(!iS)) then
    EXTEND $!sTEN THRO PIN 7
  endif

  -- Adjust for slope on horizontal lines only

  if (!support.config.eq(1))then

  -- Check to see if the line is sloping
    !adjust = 0
    do !v values !list
      !!ce = !v
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      handle ANY
        !grad = p2 grad
      endhandle
      if (!grad.neq(0))then
        !strucElement = ARRAY()
        !ref = $!name-BAR-$!next
        !strucElement.append(!ref)
        !vHeight = !!mdsAdjustSlope(!strucElement, !v)
      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

  -- Adjust required elements
    !!ce = $!<name>-BAR-$!<next>
    MOVE D WRT WORLD DIST $!adjust
    if (!alias eq 'FT03') then
      !!ce = $!<name>/SUBS$!<next>
      handle none
        BY D $!adjust
      elsehandle any
      endhandle
    endif

    !!ce = $!<name>-V1

    !start = Posend wrt world
    !end   = Posstart wrt world

    if (!support.mirror)then
      PIN 7 AT $!end
      PIN 8 AT $!start
    else
      PIN 7 AT $!start
      PIN 8 AT $!end
    endif

    PIN 7 DIR TO PIN 8
    !toBar = 0
    do !count from 1 to !next
      PIN 8 COPY PIN 7
      PIN 8 PLANE PIN 8 THRO $!<name>-BAR-$!count
       !toBar1 = !!kstrReal('CONST DIST PIN 7 TO PIN 8')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !count
      endif
    enddo
    PIN 8 PLANE PIN 8 CLEAR 0 BEH $!<name>-BAR-$!index

    if (!support.mirror)then
      EXTEND END THRO pin 8
      if !!ce.:MdsOlap.eq('OVERLAP') then
        !overlap = !!ce.:MDSOnum
      elseif !!ce.:MdsOlap.eq('FLUSH') then
        !overlap = 0
      endif
      if !overlap.string().match('-').eq(1) then
        !overlap = !overlap.abs()
      endif
      EXTEND END -$!overlap
    else
      EXTEND START THRO pin 8
      if !!ce.:MdsOlap.eq('OVERLAP') then
        !overlap = !!ce.:MDSOnum
      elseif !!ce.:MdsOlap.eq('FLUSH') then
        !overlap = 0
      endif
      if !overlap.string().match('-').eq(1) then
        !overlap = !overlap.abs()
      endif
        EXTEND START $!overlap
    endif

  endif

-- Code added for internal connections
-- Has the cross bar any connections

  !!mdsCopyJois(!name,!next,!sctn)

-- Reset all pins associated with this support

  Call !!mdsResetPins(1,9)

-- Does the item require bearing plates (Framatome Only)

  !!ce = !support.stru
  !!mdsBarOnly = TRUE
  !!mdsAddBearing(!support.datum)
  !!mdsBarOnly.delete()
  !!ce = !support.stru

  !!ce = !sctn

-- Create weld data

  !createWelds = object MDSWELDLIST(!!ce,!!mdsFt03)

-- Reset Units

   !!kRestoreUnits(!currentunits)

  !ref = !!ce
  -- loop through all crossbars, re-set DRNS
  do !i from 1 to !next
    !!ce = $!<name>-BAR-$!i
    drns $!drnsOfCrossbar
  enddo
  !!ce = !ref

  -- Check if template is mitred, if it is run check mitre function to leave mitre only on bottom cross bar
  !vref = $!<name>-V1
  if !vref.purp.eq('MITR') then
    !!mdscheckmitre(!support)
  endif

-- End function
endfunction
