--------------------------------------------------------------------------------
--
-- File:    Mdsaddbarft19.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MBARPS143
--
-- Author:    Wayne Dodwell
-- Created:   Monday 15 September 1997
--
--
-- Description:
-- function to create support cross-bars on frame type 19
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT   Support object
--     2     R        STRING        Method of adding bars. NEW or OLD
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAddBarFt19(!support is MDSSUPPORT, !method is STRING)
  -- The stru will now store the :mdsbars attribute of true/false allowing the createion of bars or not

  if not !!mdsCheckBars(!support) then
    return
  endif


  !tempdesc = desc of /MDS/TEMPLATES
  handle ANY
    !tempdesc = ''
  endhandle

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  !form      = !!mdsft19
  if !support.datum.badref().not() then
    !srefname = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefname.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefname.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to add a cross bar as write access to the SREF atta is not available')
      return
    endif
  endif


  -- Reset all pins associated with this support
  Call !!mdsResetPins(1,10)

  -- Initialise variables
  !stru      = !support.stru
  !name      = !support.stru.name
  !clearance = !!mdsOptions.clear.val
  !overlap   = !!mdsOptions.overlap.val
  -- !selection = !!mdsft19.size.selection('Rtext')
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !alias     = !!mdsft19.support.alias

  -- Check that a support has been created
  if (!support.stru.mcount().eq(0))then
    !!alert.error('Create framework before adding bars.')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- This facility is not available on configuration 2
  if (!support.config.eq(2))then
    !!alert.message('This facility is not available for this configuration')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Navigate to structure
  !!ce = !support.stru

  -- Check current number of bars
  if (!method eq |NEW|)then
    if (!support.bars.size().eq(6))then
      !!alert.error('Maximum number of cross bars already used')
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif

  -- Get list of all attas already associated with bars
  !associated = ARRAY()

  if (!support.bars.empty().not())then

    do !i indices !support.bars
      !associated.appendarray(!support.bars[!i])
    enddo

  endif

  !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)
  !!testbars = !bars

  !last = !bars.size()
  !next = !bars.size() + 1

  !!ce = $!<name>-BAR-$!last

  if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
    -- if !tempdesc.neq('Zimmer Templates') then
    --xxx Copy the TOP CROSS BAR section.
    --xxx********************************
    NEW SCTN COPY $!<name>-BAR-1

    --xxx Creates Additional CROSS BAR

    NAME $!name-BAR-$!next

    !sctn = !!ce
  endif

  -- ************************************************
  --  Identify attas to be associated with cross bar
  -- ************************************************

  !references = ''

  if (!method eq |NEW|)then

    --xxx CREATE mode for a NEW Cross Bar associate attas
    --xxx *************************************************

    !colourList = ARRAY()
    !list       = ARRAY()
    !barNumber  = ARRAY()

    --xxx -- Create a List of Attas to be Supported on the NEW Cross-Bar
    --xxx***************************************************************

    do
      PROMPT OFF
      PROMPT LOAD ESCAPE |Identify atta to support|
      ID ATTA CTSUPP@
      handle (61,528)
        if (!list.empty())then
          PROMPT DISMISS
          PROMPT ON
          !!ce = !sctn
          DELETE SCTN
          !!ce = !support.stru
          !!kRestoreUnits(!currentunits)
          return
        else
          break
        endif
      endhandle
      !picked = !!ce
      if (!list.find(!picked).size() gt 0)then
        !!alert.message('Atta already selected')
      elseif (!picked eq !support.datum)then
        !!alert.message('Datum atta cannot be selected')
        -----------------------------------------------------------------------
        --> Added - <wd> - 26aug1998
        -- Reject the SREF atta as if the DATUM atta has been selected,
        -- if picked by identifying the LSTU of the BRANCH
      elseif (!picked.name.eq(!name & '/SREF')) then
        !!alert.message('Datum atta cannot be selected')
        --< Added - <wd> - 26aug1998
        -----------------------------------------------------------------------
      elseif (!associated.find(!picked).size() gt 0)then

        -- Disassociate picked atta with existing bar
        !barNumber.append(!!mdsunlinkAtta(!!mdsft19, !picked))

        !list.append(!picked)
        -- Colour Attas
        Enhance ce colour 2
        refresh
      else
        !list.append(!picked)
        -- Colour Attas
        Enhance ce colour 2
        refresh
      endif
    enddo

    PROMPT DISMISS
    PROMPT ON


    if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
      if (!alias inset ('CT07','CT10')) then
        !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!form.support.alias , !!ce.lbor)
        !length = desp 1 of /MDS/$!form.support.alias/$!supseq-BAR-1
        PIN 2 COPY P10 of CE
        PIN 4 COPY P10 of CE
        PIN 5 COPY P11 of CE
        PIN 2 PLANE PIN 2 CLEAR 0 INF $!<name>-V1
        !dim24 = !!kStrReal('CONST DIST PIN 2 TO PIN 4')
        !dim25 = !!kStrReal('CONST DIST PIN 2 TO PIN 5')
        if (!dim24.gt(!dim25)) then
          !dimtray = !dim24
        else
          !dimtray = !dim25
        endif
        call !!mdsResetPins(2,5)
        !dim3 = !dimtray + !clearance
        if (!alias eq 'CT07') then
          var !strucoll coll all stru with matchwild(name,'*CT07*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT10') then
          var !strucoll coll all stru with matchwild(name,'*CT10*') for /MDS/TEMPLATES
        endif
        var !strunames eval name for all from !strucoll
        !lengarray = ARRAY()
        do !index indices !strunames
          !leng = desp 1 of $!strunames[$!index]-BAR-1
          if (!dim3.leq(!leng[1])) then
            !struname = !strunames[$!index]
            !selection = !index.string()
            !dim3 = !leng[1]
            !flag = TRUE
            break
          else
            !flag = FALSE
          endif
        enddo
        if (!flag.eq(FALSE)) then
          !!alert.error('Unable to find any wall brackets long enough to support this width')
          !!mdsft19.dim1.val = 0
          !!mdsft19.dim2.val = 0
          STRU
          delete STRU MEM
          handle (41,66) (2,113) (2,113)
          endhandle
          return
        endif
      endif
      --    endif

      --xxx Copy the TOP CROSS BAR section.
      --xxx********************************
      --    NEW SCTN COPY $!<name>-BAR-1
      !!ce = $!<name>-BAR-$!last

      if (!alias eq 'CT07') then
        NEW SCTN COPY /MDS/CT07/$!selection-BAR-1
      elseif (!alias eq 'CT10') then
        NEW SCTN COPY /MDS/CT10/$!selection-BAR-1
      endif

      --xxx Creates Additional CROSS BAR

      NAME $!name-BAR-$!next

      !sctn = !!ce
    endif
    -- Adjust length of bar
    !barNumber.unique()

    if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10')  then
      -- if !tempdesc.neq('Zimmer Templates') then
      do !indx indices !barNumber
        Call !!mdsAdjusttBar(!!mdsft19, !barNumber[!indx])
      enddo
    endif

    do !i indices !list
      !references = !references & ' ' & !list[!i].string()
    enddo

    --xxx ** END of NEW CROSS BAR creation **
    -- ************************************

  else

    -- ************************************

    --xxx MODIFY(OLD) mode for an EXISTING Cross Bar
    -- ************************************

    !list = !support.bars[$!next]

    do !i indices !list
      !references = !references & ' ' & !list[!i].string()
    enddo

    if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
      if (!alias inset ('CT07','CT10')) then
        !list = !support.bars[$!next]
        handle ANY
          -- !!list = !support.atta
          !list = !support.atta
          !list[1].delete()
          !list.compress()
          -- Does this work every time?
        endhandle

        do !i indices !list
          !list[$!i].spkbrk = FALSE
          handle ANY
          endhandle
          !references = !references & ' ' & !list[!i].string()
        enddo
      endif
    endif

  endif

  --xxx END of MODIFY(OLD) mode for an EXISTING Cross Bar
  -------------------------------------------------------

  -- ************************************
  -- ************************************
  -- ************************************

  --xxx Moving the Structure etc.

  -- Set atta reference to section
  !!ce = !sctn
  handle ANY
  elsehandle NONE
    :MDSAttaRef $!references
  endhandle

  -- Take additional highlight colour off attas
  Call !!kEnhanceList(!list)

  -- ************************************
  --  Get direction that bar has to move
  -- ************************************

  !!ce = !support.datum
  PIN 1 COPY P10 of CE
  PIN 1 PLANE PIN1 CLEAR 0 INF $!<name>-V1
  VAR !dir CONS DIR P10 TO PIN 1

  -- Set object definition
  !direction = object KEQUALDIR()
  !direction.directionA = !support.p10Dir
  !direction.directionB = !dir.direction()
  !direction.tolerance  = 0.05

  -- Check directions
  if (!!kDirEqualDir(!direction)) then
    PIN 1 PLANE PIN1 CLEAR 0 INF $!<name>-V1
  endif
  !dist = !!kStrReal('CONSt DIST P0 TO PIN 1')
  PIN 1 DIR FROM P0 TO PIN 1
  PIN 1 AT P9
  PIN 1 PLANE PIN 1 DIST $!dist

  !start = posstart of $!<name>-V1
  !end   = posend of $!<name>-V1

  var !lineA CONS Line JOIN $!start to $!end
  var !lineB CONS Line JOIN $!end to $!start
  var !inter CONS POS NEAR PIN 1 ON $!lineA

  PIN 2 COPY PIN 1
  pin 2 at $!inter wrt worl
  !d1 = !!kStrReal('CONSt DIST PIN 2 to $!start')
  !d2 = !!kStrReal('CONSt DIST PIN 2 to $!end')

  !max = MAX(!d1, !d2)

  if (!max.eq(!d1))then
    VAR !p2Dir CONS DIR $!lineB
  elseif (!max.eq(!d2))then
    VAR !p2Dir CONS DIR $!lineA
  endif

  PIN 2 DIR $!p2Dir

  -- *****************************************************
  --  Work out distance to move new cross bar and move it
  -- *****************************************************
  !distance = 0
  !sign = ARRAY()
  !barDist = ARRAY()
  do !v values !list
    PIN 9 COPY PIN 2
    PIN 9 PLANE PIN 9 THRO P9 OF $!v
    VAR !p9P2Dir CONST DIR PIN 9 TO PIN 2

    if !tempdesc.eq('Zimmer Templates') or !alias inset ('CT10') then
      if (!alias inset ('CT07','CT10')) then
        VAR !p9P2Dir DIR PIN 2
        VAR !p2P9Dir CONST DIR PIN 2 TO PIN 9
      endif
    endif

    if (!p9P2Dir eq '')then
      !!alert.error('Cross Bar is in the same place as an existing member')
      !!ce = !sctn
      handle ANY
      elsehandle NONE
        DELETE SCTN
      endhandle
    endif

    -- Set object definition
    !direction = object KEQUALDIR()
    if !tempdesc.eq('Zimmer Templates') or !alias inset ('CT10') then
      if (!alias inset ('CT07','CT10')) then
        !direction.directionA = !p9P2Dir.direction().opposite()
        !direction.directionB = !p2Dir.direction()
        !direction.tolerance  = 0.05
      endif
    else
      !direction.directionA = !p9P2Dir.direction()
      !direction.directionB = !p2Dir.direction()
      !direction.tolerance  = 0.05
    endif

    if (!!kDirEqualDir(!direction))then
      !sign.append('BELOW')
    else
      !sign.append('ABOVE')
    endif

    !cdist = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
    !barDist.append(!cdist)

  enddo
  !!ce = !sctn
  handle ANY
  elsehandle NONE
  endhandle

  !below = !sign.find('BELOW')
  !above = !sign.find('ABOVE')


  if (!above.size().eq(!barDist.size()))then

    -- All attas are above the datum. Take the smallest distance to move
    --xxx **********************************************************
    !barDist.sort()
    !distance = !barDist.first()
    !pin9Dist = !distance

  elseif (!below.size().eq(!barDist.size()))then

    -- All attas are below the datum. Take the largest distance to move
    --xxx **********************************************************

    !barDist.sort()
    !distance = !barDist.last()
    !pin9Dist = !distance * -1

  else

    -- Work out largest distance for those attas below the datum
    --xxx **********************************************************
    !belowDist = ARRAY()
    do !v values !below
      !belowDist.append(!barDist[!v])
    enddo
    !belowDist.sort()
    !distance = !belowDist.last()
    !pin9Dist = !distance * -1

  endif



  -- Reposition PIN 9 to end of crossbar and define direction bar has to move
  --xxx **********************************************************
  PIN 9 COPY PIN 2
  PIN 9 DIST $!pin9Dist
  VAR !dir CONST DIR PIN 2 TO PIN 9

  -- Move section to correct place
  --xxx **********************************************************
  if (!distance.neq(0)) then
    if !tempdesc.eq('Zimmer Templates') or !alias inset ('CT10') then
      if (!alias inset ('CT07','CT10')) then
        MOVE $!p2P9Dir WRT WORLD DIST $!distance
      endif
    else
      MOVE $!dir WRT WORLD DIST $!distance
    endif
    !bdir = !dir
    !bdist = !distance
  else
    if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
      -- if !tempdesc.neq('Zimmer Templates') then
      !!alert.error('Cross Bar is in the same place as an existing member')
      !!ce = !sctn
      handle ANY
      elsehandle NONE
        DELETE SCTN
      endhandle
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif

  --xxx*********************************************************************
  --xxx Position of Cross Bar on the Vertical Leg <$!name>-V1 is now CORRECT
  --xxx for Associated ATTAs.  --- ^^^ ---
  --xxx*********************************************************************


  --xxx*********************************************************************
  --xxx Position Both Ends of Cross Bar
  --xxx for the Associated ATTAs.  --- vvv ---
  --xxx*********************************************************************



  -- *****************************************
  --  Extend First End past attas by clearance
  -- *****************************************


  VAR !slide CONS DIR P9 OF $!support.datum TO PIN 1
  PIN 6 COPY PIN 2
  PIN 6 AT PIN 1
  PIN 6 PLANE PIN 6 THRO PIN 9
  PIN 9 COPY PIN 6
  PIN 8 AT PIN 6

  -------------------------------------
  --if (!support.mirror) then
  --    PIN 6 PLANE PIN 6 CLEAR 0 beh CE
  --else
  PIN 6 PLANE PIN 6 CLEAR 0 INF CE
  --endif
  -------------------------------------
  -- above commented out doesn't seem to be needed.

  PIN 8 DIR $!slide wrt world
  PIN 8 PLANE $!slide wrt world THRO P9 OF $!list[1]
  PIN 9 DIR FROM PIN 8 TO PIN 9
  PIN 8 DIR FROM PIN 9 TO PIN 8


  ---------------------------------------------------------------------
  ---------------------------------------------------------------------
  --xxx Check Mode of Creation and if Dimension 1 equals '0'

  -- !crtxt = !!mdsft19.create.val
  -- !cdtxt = !!mdsft19.create.dtext[!crtxt]
  !cdtxt = !!mdsft19.method.upcase()
  handle any
    -- Cross Bar has been added in MODIFY mode before any Re-GENERATION of the support
    !!mdsft19.method = 'DIMENSION'
    !cdtxt = 'DIMENSION'
  endhandle
  if (match(!cdtxt,'CLEARANCE') gt 0 ) then
    !!mdsft19.support.rotatecur = false
  elseif (match(!cdtxt,'DIMENSION') gt 0 ) and (!!mdsft19.dim1.val.eq(0)) then
    !!mdsft19.support.rotatecur = false
  endif

  if (!support.rotatecur) then
    var !temppin8dir pin9 dir wrt /*
    var !temppin9dir pin8 dir wrt /*
  else
    var !temppin8dir pin8 dir wrt /*
    var !temppin9dir pin9 dir wrt /*
  endif

  !dim = 0

  do !i values !list
    --<k.pleschner>jun06 to construct length of bar use value taken from ancillaries instead of default clearance
    !ancgeom = object MDSANCGEOMDFLTS(!i)
    PIN 4 COPY PIN 8
    pin 4 at $!i
    pin 5 copy pin 4
    --PIN 4 PLANE PIN 4 CLEAR $!clearance BEH $!i
    if !ancgeom.clge.eq('GEOM') then
      -- use clearance from geometry
      PIN 4 PLANE PIN 4 CLEAR $!ancgeom.oend BEH $!i
    else
      --use distance from centreline
      PIN 4 PLANE PIN 4 thr $!ancgeom
      PIN 4 PLANE PIN 4 DISTANCE $!ancgeom.oend
    endif
    handle (2,109)
      break
    endhandle
    pin 10 copy pin 2
    pin 10 plane pin 10 thro pin 4
    pin 5 plane pin 5 thro pin 10
    pin 10 at pin 5
    pin 10 dir to pin 4

    !cdim = !!kStrReal('CONST DIST pin10 TO plane PIN 4')

    if (!support.rotatecur) then
      VAR !cDIR CONST DIR pin 4 to pin 10
    else
      VAR !cDIR CONST DIR pin 10 to pin 4
    endif

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !cDIR.direction()
    !direction.directionB = !temppin8dir.direction()
    !direction.tolerance  = 0.05

    if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
      PIN 4 AT pin 10
      PIN 4 DIST $!cdim
      !dim = !cdim
    else
      PIN 4 AT pin 10
      PIN 4 DIST $!dim
    endif

  enddo

  PIN 4 DIR FROM PIN 8 TO PIN 9

  --xxx ********************************************************
  --xxx ********************************************************

  !dim = 0

  do !i values !list
    --<k.pleschner>jun06 to construct length of bar use value taken from ancillaries instead of default clearance
    !ancgeom = object MDSANCGEOMDFLTS(!i)
    PIN 3 COPY PIN 9
    pin 3 at $!i
    pin 5 copy pin 3
    --PIN 3 PLANE PIN 3 CLEAR $!clearance BEH $!i
    if !ancgeom.clge.eq('GEOM') then
      -- use clearance from geometry
      PIN 3 PLANE PIN 3 CLEAR $!ancgeom.oend BEH $!i
    else
      --use distance from centreline
      PIN 3 PLANE PIN 3 thr $!ancgeom
      PIN 3 PLANE PIN 3 DISTANCE $!ancgeom.oend
    endif
    handle (2,109)
      break
    endhandle
    pin 10 copy pin 2
    pin 10 plane pin 10 thro pin 3
    pin 5 plane pin 5 thro pin 10
    pin 10 at pin 5
    pin 10 dir to pin 3
    handle ANY
    endhandle

    !cdim = !!kStrReal('CONST DIST pin 10 to plane pin 3')
    if (!support.rotatecur) then
      VAR !cDIR CONST DIR pin 3 to pin 10
    else
      VAR !cDIR CONST DIR pin 10 to pin 3
    endif

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !cDIR.direction()
    !direction.directionB = !temppin9dir.direction()
    !direction.tolerance  = 0.05

    if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
      pin 3 at pin 10
      PIN 3 DIST $!cdim
      !dim = !cdim
    else
      pin 3 at pin 10
      PIN 3 DIST $!dim
    endif
  enddo

  if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
    if (!alias inset ('CT07','CT10')) then
      !!ce = !sctn
      handle ANY
      elsehandle NONE
        PIN 4 AT POSS
        PIN 4 DIR PIN 2
        PIN 4 PLANE PIN 4 THRO PIN 8
        !distdim = !!kStrReal('CONST DIST PIN 4 TO PIN 9')
        VAR !dir49 CONST DIR PIN 4 TO PIN 9
        VAR !dir94 CONST DIR PIN 9 TO PIN 4
        MOVE $!dir49 WRT WORLD DIST $!distdim
        !drnsdir = !!ce.drns
        var !dir dir pin 8
        !pin8dir = !dir.direction()
        if (!drnsdir.neq(!pin8dir)) then
          flip
          !derlen = der len
          !newdist = !derlen - !dim3
          MOVE $!dir94 WRT WORLD DIST $!derlen
          !distdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')
          MOVE $!dir94 WRT WORLD DIST $!distdim
          MOVE $!dir94 WRT WORLD DIST $!distdim
        endif
        Call !!mdsResetPins(1,10)
      endhandle
      -- return
    else
      --  endif
      --  endif

      pin 3 dir from pin 9 to pin 8

      --xxx-----------------------------------------


      -- Extend Section Ends of Additional Cross-Bars
      --
      !!ce = !sctn
      PIN 9 PLANE PIN 9 CLEAR $!overlap INF $!name-V1

      !pd49 = !!kStrReal('const dist pin 4 to plane pin 9')
      !pd43 = !!kStrReal('const dist pin 4 to plane pin 3')

      if (!pd43.leq(!pd49)) then
        pin 9 plane pin 9 thro pin 3
      else
        pin 9 plane pin 9 clear $!overlap BEH $!name-V1
        !pd49 = !!kStrReal('const dist pin 4 to plane pin 9')
        if (!pd43.geq(!pd49)) then
          pin 9 plane pin 9 thro pin 3
        endif
      endif

      if (!support.rotatecur and !support.mirror.not()) then
        !posstart = poss wrt /*
        extend start thro pin 9
        handle (73,214) $*  Structural geometry error - zero length Section
          poss $!posstart
          extend end thro pin 4
        elsehandle none
          extend end thro pin 4
          handle (73,214) $* Structural Geometry Error - Zero Length Section
            var !setpose pose wrt /*
            var !setposd drne wrt /*
            pin 5 at $!setpose wrt /*
            pin 5 dir $!setposd wrt /*
            pin 5 dist 10
            var !setpose pin 5 pos wrt /*
            pose $!setpose wrt /*
            extend end thro pin 4
          endhandle
        endhandle
      elseif (!support.rotatecur.not() and !support.mirror) then
        !posstart = poss wrt /*
        extend start thro pin 4
        handle (73,214) $*  Structural geometry error - zero length Section
          poss $!posstart
          extend end thro pin 9
        elsehandle none
          extend end thro pin 9
          handle (73,214) $* Structural Geometry Error - Zero Length Section
            var !setpose pose wrt /*
            var !setposd drne wrt /*
            pin 5 at $!setpose wrt /*
            pin 5 dir $!setposd wrt /*
            pin 5 dist 10
            var !setpose pin 5 pos wrt /*
            pose $!setpose wrt /*
            extend end thro pin 9
          endhandle
        endhandle
      elseif (!support.rotatecur and !support.mirror) then
        !posstart = poss wrt /*
        extend start thro pin 4
        handle (73,214) $*  Structural geometry error - zero length Section
          poss $!posstart
          extend end thro pin 9
        elsehandle none
          extend end thro pin 9
          handle (73,214) $* Structural Geometry Error - Zero Length Section
            var !setpose pose wrt /*
            var !setposd drne wrt /*
            pin 5 at $!setpose wrt /*
            pin 5 dir $!setposd wrt /*
            pin 5 dist 10
            var !setpose pin 5 pos wrt /*
            pose $!setpose wrt /*
            extend end thro pin 9
          endhandle
        endhandle
      else
        !posstart = poss wrt /*
        extend start thro pin 9
        handle (73,214) $*  Structural geometry error - zero length Section
          poss $!posstart
          extend end thro pin 4
        elsehandle none
          extend end thro pin 4
          handle (73,214) $* Structural Geometry Error - Zero Length Section
            var !setpose pose wrt /*
            var !setposd drne wrt /*
            pin 5 at $!setpose wrt /*
            pin 5 dir $!setposd wrt /*
            pin 5 dist 10
            var !setpose pin 5 pos wrt /*
            pose $!setpose wrt /*
            extend end thro pin 4
          endhandle
        endhandle
      endif
    endif
  endif

  --xxx*********************************************************************
  --xxx Position Both Ends of Cross Bar
  --xxx for the Associated ATTAs.  --- ^^^ ---
  --xxx*********************************************************************

  -- ********************************************
  --  Set correct spref for number of cross bars
  -- ********************************************

  !!ce = $!<name>/SREF

  !!mdsDacControl(true)

  if (!alias inset ('CT07','CT10')) and !method.eq('OLD') then
    -- if !tempdesc.eq('Zimmer Templates') and !method.eq('OLD') then
    --   if (!alias inset ('CT07','CT10')) then
    if !tempdesc.eq('Zimmer Templates') or (!alias eq 'CT10') then
      return
    endif
  else
    --SEL SPREF WITH STYP '$!alias-$!next-$!selection' SPEC /MDF
    !styp = !alias & '-' & !next & '-' & !selection
    !!mdsSelectAttaSpref(!styp, /MDF )
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  endif
  !!mdsDacControl(false)

  -- Update form data

  if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
    -- if !tempdesc.neq('Zimmer Templates') then
    -- Get data to update support info held in form
    !!ce = !sctn
    !barLen = deri length

    -- Update form data
    if (!method eq |NEW|)then

      !!mdsft19.support.bars.append(!list)
      !!mdsft19.support.barLen.append(!barLen)

      -- Enhance elements using colour set for highlight
      !!ce = !support.stru
      !colourList = ARRAY()
      !colourList.append(!!ce)
      !colourList.append(!list)

      -- Colour Support
      Call !!kEnhanceList(!colourList)

    else

      !!mdsft19.support.barLen[!next] = !barLen

    endif

    -- *******************************************
    --  Do the connecting sections need extending
    -- *******************************************
    !!ce = $!<name>-V1

    !wAS = DERI LENG

    if (!support.mirror)then
      VAR !sTEN |END|
      !end = Posend wrt world
    else
      VAR !sTEN |START|
      !end = Posstart wrt world
    endif

    EXTEND $!sTEN THRO PIN 6
    if !!ce.:MdsOlap.eq('OVERLAP') then
      !overlap = !!ce.:MDSOnum
    elseif !!ce.:MdsOlap.eq('FLUSH') then
      !overlap = 0
    endif
    EXTEND $!sTEN $!overlap

    PIN 7 AT $!end

    !iS = DERI LENG

    if (!wAS.gt(!iS)) then
      EXTEND $!sTEN THRO PIN 7
    endif


    -- Adjust for slope on horizontal lines only

    if (!support.config.eq(1))then

      -- Check to see if the line is sloping
      !adjust = 0

      do !v values !list
        !!ce = !v
        skip if !!ce.:mdsrotdir.east.set()
        !grad = pl grad
        handle ANY
          !grad = p2 grad
        endhandle
        if (!grad.neq(0))then
          !strucElement = ARRAY()
          !ref = $!name-BAR-$!next
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)
        else
          !vHeight = 0
        endif
        if (!vHeight.gt(!adjust))then
          !adjust = !vHeight
        endif
      enddo

      -- Adjust required elements
      --xxx************************

      --xxx Adjust Cross Bar Height on Vertical Leg
      --xxx****************************************

      !!ce = $!<name>-BAR-$!<next>
      MOVE D WRT WORLD DIST $!adjust

    endif
  endif

  --xxx Adjust Vertical Leg.
  --xxx*********************
  !!ce = $!<name>-V1

  !start = Posend wrt world
  !end   = Posstart wrt world

  if (!support.mirror)then
    PIN 7 AT $!end
    PIN 8 AT $!start
  else
    PIN 7 AT $!start
    PIN 8 AT $!end
  endif

  PIN 7 DIR TO PIN 8
  !tobar = 0
  do !count from 1 to !next
    PIN 8 COPY PIN 7
    PIN 8 PLANE PIN 8 THRO $!<name>-BAR-$!count
    !tobar1 = !!kStrReal('CONST DIST PIN 7 TO PIN 8')
    if (!tobar1.gt(!tobar))then
      !tobar = !tobar1
      !index = !count
    endif
  enddo
  PIN 8 PLANE PIN 8 CLEAR 0 BEH $!<name>-BAR-$!index
  --xxxPIN 8 PLANE PIN 8 CLEAR 0 INF $!<name>-BAR-$!index

  if (!support.mirror)then
    EXTEND END THRO pin 8
    if !!ce.:MdsOlap.eq('OVERLAP') then
      !overlap = !!ce.:MDSOnum
    elseif !!ce.:MdsOlap.eq('FLUSH') then
      !overlap = 0
    endif
    EXTEND END $!overlap
  else
    EXTEND START THRO pin 8
    if !!ce.:MdsOlap.eq('OVERLAP') then
      !overlap = !!ce.:MDSOnum
    elseif !!ce.:MdsOlap.eq('FLUSH') then
      !overlap = 0
    endif
    EXTEND START $!overlap
  endif

  if !tempdesc.eq('Zimmer Templates') or (!alias eq 'CT10') then
    -- if !tempdesc.eq('Zimmer Templates') then
    if (!alias inset ('CT08','CT11')) then
      EXTEND START $!overlap
      EXTEND START $!overlap
    endif
  endif


  -- Ensure  all Horizontal Cross Bars are Orientated the same way as the
  -- Main Cross Bar ie., '/{struname}-BAR-1'
  if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
    -- if !tempdesc.neq('Zimmer Templates') then
    if (!support.bars.size() gt 1) then
      call !!mdsflip( !stru , !support )
    endif
  endif

  !!ce = !sctn
  -- Create weld data
  !createWelds = object MDSWELDLIST(!!ce,!!mdsft19)


  -- If internal joints are there the we will need to create another

  !!ce = $!<name>-V1
  var !sjoi coll all sjoi for ce
  if !sjoi.size().gt(0) then
    sjoi 1 of snod 1
    end
    !sctnname = !!ce.owner.owner.name
    new snod $!<sctnname>/S$!<next> copy prev rename $!<sctnname>/S1 $!<sctnname>/S$!<next>
    1
    cref $!sctn
  endif

  -- The vertical member holds the internal joints and therefore has to be realigned
  -- with the crossbars, it needs to be planed through the centre of the cross bar

  !!ce = $!<name>-V1
  !poss = poss
  !pose = pose
  !drns = drns
  var !sjoi coll all sjoi for ce
  do !resetZdist values !sjoi
    pin 9 at $!poss
    pin 8 at $!pose
    pin 9 dir $!drns
    pin 8 dir $!drns
    !!ce = !resetZdist.dbref()
    !cref = cref
    end
    pin 9 clear 0 inf $!cref
    pin 8 clear 0 beh $!cref
    var !pdist const dist pin 9 to pin 8
    pin 9 dir from pin 9 to pin 8
    pin 9 dist ($!pdist 2 d)
    zdist thro pin 9
  enddo

  -- Reset all pins associated with this support
  Call !!mdsResetPins(1,10)

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
