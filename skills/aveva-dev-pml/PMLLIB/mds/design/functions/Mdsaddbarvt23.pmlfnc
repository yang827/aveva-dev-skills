--
-- File:		MdsaddbarVT23.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MBARPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- function to create support cross-bars on frame type 09
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT   Support object
--     2     R        STRING        Method of adding bars. NEW or OLD
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddBarVT23(!Support is MdsSUPPORT, !Method is STRING)


 -- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()


-- Can we write to the spref attribute of the SREF atta
-- and the stru

  !Form      = !!MdsVT23
  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to add a cross bar as write access to the SREF atta is not available')
        return
      endif
  endif

  -- Initialise variables
    !Name      = !Support.Stru.name
    !Clearance = !!MdsOptions.Clear.val
    !Overlap   = !!MdsOptions.Overlap.val
    -- !Selection = !!MdsVT23.Size.Selection('Rtext')
    !Selection = !!MdsSetSteel.Size.Selection('Rtext')
    !Alias     = !!MdsVT23.Support.Alias

  -- Check that a support has been created
    if (!Support.Stru.Mcount() eq 0)then
      !!kRestoreUnits(!currentunits)
      !!Alert.error('Create framework before adding bars.')
      return
    endif

  -- Navigate to structure
    !!CE = !Support.Stru

  -- Check current number of bars
    if (!Method eq |NEW|)then
      if (!Support.Bars.size() eq 6)then
        !!kRestoreUnits(!currentunits)
        !!Alert.error('Maximum number of cross bars already used')
        return
      endif
    endif

  -- Get list of all attas already associated with bars
    !Associated = ARRAY()
    if (!Support.Bars.empty().not())then
      do !I indices !Support.Bars
        !Associated.appendarray(!Support.Bars[!I])
      enddo
    endif

    !Bars = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!CE)
    !Last = !Bars.Size()
    !Next = !Bars.Size() + 1
    !!CE = $!<Name>-BAR-$!Last
    NEW SCTN $!Name-BAR-$!Next COPY $!<Name>-BAR-1 RENAME $!<Name>-BAR-1 $!NAME-BAR-$!Next
    !Sctn = !!CE

  -- ************************************************
  --  Identify attas to be associated with cross bar
  -- ************************************************

    !References = ''

    if (!Method eq |NEW|)then
      !ColourList = ARRAY()
      !List       = ARRAY()
      !BarNumber  = ARRAY()
      do
        PROMPT OFF
        PROMPT LOAD ESCAPE |Identify atta to support|
        ID ATTA @
          handle (61,528)
            if (!List.empty())then
              PROMPT DISMISS
              PROMPT ON
              !!CE = !Sctn
              DELETE SCTN
              !!CE = !Support.Stru
              !!kRestoreUnits(!currentunits)
              return
            else
              break
            endif
          endhandle
        !Picked = !!CE
        if (!List.find(!Picked).size() gt 0)then
          !!Alert.message('Atta already selected')
        elseif (!Picked eq !Support.Datum)then
          !!Alert.message('Datum atta cannot be selected')
-----------------------------------------------------------------------
--> Added - <wd> - 26aug1998
-- Reject the SREF atta as if the DATUM atta has been selected,
-- if picked by identifying the LSTU of the BRANCH
      elseif (!picked.name.eq(!name & '/SREF')) then
          !!Alert.message('Datum atta cannot be selected')
--< Added - <wd> - 26aug1998
-----------------------------------------------------------------------
        elseif (!Associated.find(!Picked).size() gt 0)then

        -- Disassociate picked atta with existing bar
          !BarNumber.append(!!MdsunlinkAtta(!!MdsVT23, !Picked))

          !List.append(!Picked)
        -- Colour Attas
          Enhance ce colour 2
          refresh
        else
          !List.append(!Picked)
        -- Colour Attas
          Enhance ce colour 2
          refresh
        endif
      enddo
      PROMPT DISMISS
      PROMPT ON

      do !I Indices !List
        !References = !References & ' ' & !List[!I].string()
      enddo

    else
      !List = !Support.Bars[$!Next]
      do !I Indices !List
        !References = !References & ' ' & !List[!I].string()
      enddo
    endif

  -- Set atta reference to section
    !!CE = !Sctn
    :MDSAttaRef $!References

  -- Take additional highlight colour off attas
    Call !!KEnhanceList(!List)

  -- ************************************
  --  Get direction that bar has to move
  -- ************************************

    !!CE = !Support.Datum
    PIN 1 COPY P10 of CE
    PIN 1 PLANE PIN1 CLEAR 0 BEH $!<Name>-V1
    VAR !Dir CONS DIR P10 TO PIN 1

  -- Set object definition
    !Direction = object KEQUALDIR()
    !Direction.DirectionA = !Support.P10Dir
    !Direction.DirectionB = !Dir.direction()
    !Direction.Tolerance  = 0.05

  -- Check directions
    if (!!KDirEqualDir(!Direction)) then
      PIN 1 PLANE PIN1 CLEAR 0 INF $!<Name>-V1
    endif
     !Dist = !!KStrReal('CONS DIST P0 TO PIN 1')
    PIN 1 DIR FROM P0 TO PIN 1
    PIN 1 AT P9
    PIN 1 PLANE PIN 1 DIST $!Dist
    !Start = posstart of $!<Name>-V1
    !End   = posend of $!<Name>-V1
    var !LineA CONS Line JOIN $!Start to $!End
    var !LineB CONS Line JOIN $!End to $!Start
    var !Inter CONS POS NEAR PIN 1 ON $!LineA
    PIN 2 COPY PIN 1
    PIN 2 AT $!INTER wrt worl
     !D1 = !!KStrReal('CONS DIST PIN 2 to $!Start')
     !D2 = !!KStrReal('CONS DIST PIN 2 to $!End')
     !Max = MAX(!D1, !D2)

    if (!Max.eq(!D1))then
      VAR !P2Dir CONS DIR $!LineB
    elseif (!Max.eq(!D2))then
      VAR !P2Dir CONS DIR $!LineA
    endif
    PIN 2 DIR $!P2Dir

    PIN 1 OFF
    PIN 2 OFF

  -- *****************************************************
  --  Work out distance to move new cross bar and move it
  -- *****************************************************

    !Distance = 0
    !Sign = ARRAY()
    !BarDist = ARRAY()
    do !V Values !List
      PIN 9 COPY PIN 2
      PIN 9 PLANE PIN 9 THRO P9 OF $!V
      VAR !P9P2Dir CONST DIR PIN9 TO PIN 2

      if (!P9P2Dir.eq(''))then
        !!Alert.error('Cross Bar is in the same place as an existing member')
        !!CE = !Sctn
        DELETE SCTN
      endif

   -- Set object definition
      !Direction = object KEQUALDIR()
      !Direction.DirectionA = !P9P2Dir.direction()
      !Direction.DirectionB = !P2Dir.direction()
      !Direction.Tolerance  = 0.05

      if (!!KDirEqualDir(!Direction))then
        !Sign.append('ABOVE')
      else
        !Sign.append('BELOW')
      endif
       !CDist = !!KStrReal('CONS DIST PIN 2 TO PIN 9')
       !BarDist.append(!CDist)

    enddo
    !!CE = !Sctn
    !Below = !Sign.find('BELOW')
    !Above = !Sign.find('ABOVE')

    if (!Above.size() eq !BarDist.Size())then
    -- All attas are above the datum. Take the smallest distance to move
      !BarDist.sort()
      !Distance = !BarDist.last()
      !Pin9Dist = !Distance * -1
    elseif (!Below.size() eq !BarDist.Size())then
    -- All attas are below the datum. Take the largest distance to move
      !BarDist.sort()
      !Distance = !BarDist.first()
      !Pin9Dist = !Distance
    else

    -- Work out largest distance for those attas below the datum
      !BelowDist = ARRAY()
      do !V values !Below
        !BelowDist.append(!BarDist[!V])
      enddo
      !BelowDist.sort()
      !Distance = !BelowDist.last()
      !Pin9Dist = !Distance
    endif

  -- Reposition PIN 9 to end of crossbar and define direction bar has to move
    PIN 9 COPY PIN 2
    PIN 9 DIST $!Pin9Dist
    VAR !Dir CONST DIR PIN 2 TO PIN 9

  -- Move section to correct place
    if (!Distance neq 0) then
      MOVE $!Dir WRT WORLD DIST $!Distance
      !Bdir = !Dir
      !Bdist = !Distance
    else
      !!Alert.error('Cross Bar is in the same place as an existing member')
      !!CE = !Sctn
      DELETE SCTN
      !!kRestoreUnits(!currentunits)
      return
    endif

    PIN 6 COPY PIN 9
    PIN 6 PLANE PIN 6 CLEAR 0 INF CE

  -- ********************************************
  --  Set correct spref for number of cross bars
  -- ********************************************

    !!CE = $!<Name>/SREF

    !!MdsDacControl(true)
    SEL SPREF WITH STYP '$!Alias-$!Next-$!Selection' SPEC /MDF
    !!MdsSetSuppCode('MODIFY',!Name,!Alias,'$!Alias-1-1')
    !!MdsDacControl(false)

  -- Update form data

  -- Get data to update support info held in form
    !!CE = !Sctn
    !BarLen = deri length

  -- Update form data
    if (!Method eq |NEW|)then
      !!MdsVT23.Support.Bars.append(!List)
      !!MdsVT23.Support.BarLen.append(!BarLen)

    -- Enhance elements using colour set for highlight
      !!CE = !Support.Stru
      !ColourList = ARRAY()
      !ColourList.append(!!CE)
      !ColourList.append(!List)

    -- Colour Support
      Call !!KEnhanceList(!ColourList)
    else
      !!MdsVT23.Support.BarLen[!Next] = !BarLen
    endif

  -- *******************************************
  --  Do the connecting sections need extending
  -- *******************************************

    !!CE = $!<Name>-V1

    VAR !TmpWAS DERI LENG
    !WAS = !TmpWAS.real()

    if (!Support.Mirror)then
      !SctnEnd = 'END'
      !End     = Posend wrt world
    else
      !SctnEnd = 'START'
      !End     = Posstart wrt world
    endif

    EXTEND $!SctnEnd THRO PIN 6
    if !!CE.:MdsOlap.eq('OVERLAP') then
      !OverLap = !!CE.:MDSOnum
    elseif !!CE.:MdsOlap.eq('FLUSH') then
      !OverLap = 0
    endif
    EXTEND $!SctnEnd $!Overlap
    PIN 7 AT $!End

    VAR !TmpIS DERI LENG
    !IS = !TmpIS.real()


    IF (!WAS.gt(!IS)) THEN
      EXTEND $!SctnEnd THRO PIN 7
    ENDIF

    !!CE = $!<Name>-V2

    VAR !TmpWAS DERI LENG
    !WAS = !TmpWAS.real()

    if (!Support.Mirror)then
      !SctnEnd = 'END'
      !End     = Posend wrt world
    else
      !SctnEnd = 'START'
      !End     = Posstart wrt world
    endif

    EXTEND $!SctnEnd THRO PIN 6
    if !!CE.:MdsOlap.eq('OVERLAP') then
      !OverLap = !!CE.:MDSOnum
    elseif !!CE.:MdsOlap.eq('FLUSH') then
      !OverLap = 0
    endif
    EXTEND $!SctnEnd $!Overlap
    PIN 7 AT $!End

    VAR !TmpIS DERI LENG
    !IS = !TmpIS.real()

    IF (!WAS.gt(!IS)) THEN
      EXTEND $!SctnEnd THRO PIN 7
    ENDIF

  -- Adjust for slope on horizontal lines only

    if (!Support.PADir neq U and !Support.PLDir neq U)then

    -- Check to see if the line is sloping
      !Adjust = 0
      do !V values !List
        !!CE = !V
        skip if !!ce.:mdsrotdir.east.set()
        !Grad = pl grad
        if (!grad neq 0)then
          !StrucElement = ARRAY()
          !Ref = $!Name-BAR-$!Next
          !StrucElement.append(!Ref)
          !VHeight = !!MdsAdjustSlope(!StrucElement, !V)
        else
          !VHeight = 0
        endif
        if (!VHeight gt !Adjust)then
          !Adjust = !VHeight
        endif
      enddo

    -- Adjust required elements
      !!CE = $!<Name>-BAR-$!<Next>
      MOVE D WRT WORLD DIST $!Adjust

      do !Indx from 1 to 2
        !!CE = $!<Name>-V$!<Indx>

        !End   = Posend wrt world
        !Start = Posstart wrt world

        if (!Support.Mirror)then
          PIN 7 AT $!Start
          PIN 8 AT $!End
        else
          PIN 7 AT $!End
          PIN 8 AT $!Start
        endif

        PIN 7 DIR TO PIN 8
        !ToBar = 0
        do !Count from 1 to !Next
          PIN 8 COPY PIN 7
          PIN 8 PLANE PIN 8 THRO $!<Name>-BAR-$!Count
           !ToBar1 = !!KStrReal('CONS DIST PIN 7 TO PIN 8')
          if (!ToBar1.gt(!ToBar))then
            !ToBar = !ToBar1
            !Index = !Count
          endif
        enddo
        PIN 8 PLANE PIN 8 CLEAR 0 BEH $!<Name>-BAR-$!Index

        if (!Support.Mirror)then
          EXTEND END THRO pin 8
          if !!CE.:MdsOlap.eq('OVERLAP') then
            !OverLap = !!CE.:MDSOnum
          elseif !!CE.:MdsOlap.eq('FLUSH') then
            !OverLap = 0
          endif
          EXTEND END $!Overlap
        else
          EXTEND START THRO pin 8
          if !!CE.:MdsOlap.eq('OVERLAP') then
            !OverLap = !!CE.:MDSOnum
          elseif !!CE.:MdsOlap.eq('FLUSH') then
            !OverLap = 0
          endif
          EXTEND START $!Overlap
        endif

      enddo
    endif

  -- Code added for internal connections
  -- Has the cross bar any connections

    !!CE = $!Name-BAR-1

    !Jois = Jois
    !Joie = Joie

    if !Jois.badref().not() then
      goto jois
      snod
      !Sctnname = !!CE.owner.name
      new snod $!<SctnName>/S$!<Next> copy prev rename $!<SctnName>/S1 $!<SctnName>/S$!<Next>
      zdist thro $!<Name>-BAR-$!<Next>
      sjoi 1
      cref $!<Name>-BAR-$!<Next>
      $!<Name>-BAR-$!<Next>
      jois same
    endif

    !!CE = $!Name-BAR-1

    if !joie.badref().not() then
      goto joie
      snod
      !Sctnname = !!CE.owner.name
      new snod $!<SctnName>/S$!<Next> copy prev rename $!<SctnName>/S1 $!<SctnName>/S$!<Next>
      zdist thro $!<Name>-BAR-$!<Next>
      sjoi 1
      cref $!<Name>-BAR-$!<Next>
      $!<Name>-BAR-$!<Next>
      joie same
    endif

    !!CE =  $!<Name>-BAR-$!<Next>
    reconn recalc

  -- Reset the zdist of cross bar 1 because the bar may have been moved if the datum is on a higher cross bar

    if !Jois.badref().not() then
      !!CE = $!Name-BAR-1
      goto jois
      snod
      zdist thro $!Name-BAR-1
    endif

    if !Joie.badref().not() then
      !!CE = $!Name-BAR-1
      goto joie
      snod
      zdist thro $!Name-BAR-1
    endif

  -- Reset all pins associated with this support
    Call !!MdsResetPins(1,9)

  !!CE = !Sctn

-- reset units
   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsaddbarVT23.pml
