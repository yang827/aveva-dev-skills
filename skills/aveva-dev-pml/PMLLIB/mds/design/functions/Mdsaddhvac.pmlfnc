--
-- File:		Mdsaddhvac.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MADDHVAC
--
-- Author:		I.Osborne
-- Created:		Thu Mar 08
--
--
-- Description:
-- function to add hvac support to framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddHvac(!Form is FORM)

  -- Initialise variables
    !Datum = !Form.Support.Datum
    !Stru  = !Form.Support.Stru
    !Name  = !Stru.name

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
    if (!Form.Support.Position.not())then
      !!Alert.message('Position atta before adding HVAC')
      return
    endif

--> Modified - <wd> - 26aug1998
    label /label
--< Modified - <wd> - 26aug1998

  -- Select tube
    if (!!MdsIdTube('FTUB', 'Identify duct of HVAC to support','HVAC').not())then
      return
    endif

------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the HVAC Duct
      if (!write.eq('R')) then
        !!alert.error('The Identified HVAC Duct is in a READ ONLY Database. Select another HVAC Duct.')
        golabel /label
        return
-- WRITE Access to the HVAC Duct, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified HVAC Duct is LOCKED. Select another HVAC Duct.')
        golabel /label
        return
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------

-----------------------------------------------------------------------
--> Modified - <wd> - 26aug1998
-- Reject the DATUM atta if selected, the SREF atta as if the DATUM atta has been selected,
-- if picked by identifying the LSTU of the BRANCH
-- Reject if the selected PIPE BRANCH or BRANCH member is the same as the DATUM atta owner.
    !name   = !form.support.stru.name
    !picked = !!ce
    if (!picked eq !form.support.datum)then
      !!alert.message('Datum Duct cannot be selected')
      golabel /label
    elseif (!picked.name.eq(!name & '/SREF')) then
      !!alert.message('Datum Duct cannot be selected')
      golabel /label
    elseif (!form.support.datum.owner.eq(!picked)) then
        !!alert.message('Datum Duct cannot be selected')
        golabel /label
    elseif (!form.support.datum.owner.eq(!picked.owner)) then
        !!alert.message('Datum Duct cannot be selected')
        golabel /label
    endif
--< Modified - <wd> - 26aug1998
-----------------------------------------------------------------------

  -- Check that an atta for this element doesn't already exist
    if (!!MdsCheckAtta(!Form))then
      if (!!Alert.confirm('This Duct is already being supported on $!<Form.Name.val>. Ok to continue') eq 'NO')then
        return
      endif
    endif

--xxx--xxx--xxx--xxx--xxx--xxx
-- Check if Selected HVAC is in the same ORI (Horizontal or Vertical Pipe) as the Datum Atta.
    !currcomp = !!ce

    !!ce = !datum
    !datpldir = pl dir wrt world
    !datpadir = pa dir wrt world

    !!ce = !currcomp
    !cepldir  = pl dir wrt world
    handle (61,2) (2,201) (2,252)
      !cepldir = ph dir wrt world
    endhandle

    if (!datpldir.up.abs() neq 1) then
--  Datum Pipe is Horizontal.

--  Now Check if Selected HVAC is Horizontal or Vertical
      if (!cepldir eq u or !cepldir eq d) then
-- Selected Pipe is Vertical
        !!alert.message ('Unable to Mix Horizontal and Vertical HVAC on the same Framework')
        !!ce = !currcomp
        return
      else
    endif
    $(
--  Selected HVAC is Horizontal so Check if it is within the Allowable Slope
        if (!!Mdsgradient(!currcomp)) then
          !!alert.message ('The HVAC identified is not within the maximum slope for horizontal HVAC as defined in the application defaults ($!!Mdsoptions.slope.val)')
          !!ce = !currcomp
          return
        endif
      endif
     $)
    else
--  Datum Pipe is Vertical
      if (!cepldir.up.abs() neq !datpldir.up.abs() or !cepldir.up.abs() neq !datpadir.up.abs()) then
-- Selected Pipe is Horizontal
        !!alert.error  ('Unable to Mix Horizontal and Vertical HVAC on the same Framework')
        !!ce = !currcomp
        return
      endif
    endif

--xxx--xxx--xxx--xxx--xxx--xxx

  -- Add bran same incase we have accessed the implied tube
    bran same
  -- Add HVAC to support. the following function replaces MHVAC
    Call !!MdsHvac(!Form)

    PLANE PL THRO $!Datum
    !AttaName = !!CE.Name

  -- Add aid text to rack

    !pos = pos wrt /*
    !TName = after(!!CE.name, '.')
    !NUM = (210 + !TName.real())
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!NUM $!TName $<$!POS$>

  -- Add atta to cross-bar 1
    !NewAtta = !!CE
    !List = !Form.Support.Bars[1]
    !References = ''
    do !I Indices !List
      !References = !References & ' ' & !List[!I].string()
    enddo

    -- Set atta reference to datum cross bar, but not if special
    !!CE = $!<Name>-BAR-1
      handle any
      elsehandle NONE
        if !Form.Support.type.neq('SPECIAL') then
          :MDSAttaRef $!References !NewAtta.string()
          same
        endif
      endhandle

    !AliasName = !!MdsAliasList(!Form.support.type)
    if (!AliasName inset('FT17' , 'FT18' , 'FT19')) then
      if (!Form.support.stru.mcount() neq 0) then
        !FormName = '!!' & !Form
        Call !!MdsAdjustTbar($!FormName, 1)
        !callb = '!!Mdscreate' & !Aliasname
        Call $!callb('DIMENSION')
      endif
    elseif (!AliasName inset('FT03','FT04','FT05','FT06')) then
      if (!Form.support.stru.mcount() neq 0) then
        !FormName = '!!' & !Form
        Call !!MdsAdjustbar($!FormName, 1)
        !callb = '!!Mdscreate' & !Aliasname
        Call $!callb('DIMENSION')
      endif
    endif

  -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.string()
    !Form.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Add to model at level set by !!MdsOptions.LevChange value
    Call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = ARRAY()
    !ColourList.append(!AttaName.dbref())
    Call !!KEnhanceList(!ColourList)

-- End function
endfunction

-- End of file Mdsaddhvac.pml
