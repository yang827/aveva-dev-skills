--
-- File: Mdsaddpipe.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MADDPIPE
--
-- Author:    I.Osborne
-- Created:   Thu Mar 08
--
--
-- Description:
-- function to add pipe support to framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAddPipe(!form is FORM)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !form.support.datum

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    return
  endif

  -- Check that Datum atta has been positioned
  if (!form.support.position.not())then
    !!alert.message('Position atta before adding Pipe')
    return
  endif

  -- If the datum atta is a trunnion type then the stru must have been created previously

  if !!mdsCheckTrun(!form,'DATUM') then
    if !form.support.stru.members.size().eq(0) then
      !!alert.message('The datum atta is on a trunnion so the framework must be created before adding more members')
      return
    endif
  endif

  -- Check the maximum number of pipes available on the standard and
  -- if this has been reached deactivate the add pipes icon. This will be stored
  -- at the zone of the template under the uda :mdsmaxpipes
  !aliasName = !!mdsAliasList(!form.support.type)
  if !aliasName.neq('SPECIAL') then

    VAR !sites COLL ALL SITE WITH NAME eq '/MDS/TEMPLATES '
    do !loopThroughZones values !sites
      var !zone append coll all zone with :MDSCp1 eq '$!aliasName' for $!loopThroughZones
    enddo

    !numOfAttas = !form.support.atta.size() - 1

    if !numOfAttas.geq(!zone[1].dbref().:mDSMaxPipes) then
      !!alert.message('Maximum number of pipes ($!numOfAttas) allowed on this standard exceeded')
      return
    endif
  endif

  label /label
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube/shoe'
  endif
  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of pipe to add','PIPE').not())then
    return
  endif

  ------------------------------
  --> Modified - <wd> - 14sep1998
  !write = STRING()
  !lock  = STRING()
  if (!!kcheckwrite(!!ce, !lock , !write).not()) then
    -- READ ONLY Access to the PIPE
    if (!write.eq('R')) then
      !!alert.error('The Identified PIPE is in a READ ONLY Database. select another PIPE.')
      golabel /label
      return
      -- WRITE Access to the PIPE, BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The Identified PIPE is LOCKED. select another PIPE.')
      golabel /label
      return
    endif
  endif
  --< Modified - <wd> - 14sep1998
  ------------------------------

  --<wd>oct2002
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  if !aliasName.neq('SPECIAL') then
    !unusedCecomp = !!ce
    !error  = STRING()
    !unusedSelection = !!mdssetsteel.size.selection('rtext')
    !pipecomp  = !!ce
    !currboreunits = object COMUNITS()
    !currboreunits.savedUnits[!currboreunits.getDimensionIndex('BORE')] = !!borefmt.units
    if (!!mdscheckpbores(!form,!pipecomp,!error,!currboreunits)) then
      !!alert.error(!error)
      !!kRestoreUnits(!currentUnits)
      return
    endif
    !!ce = !pipecomp
  endif
  --<wd>oct2002

  -----------------------------------------------------------------------
  --> Modified - <wd> - 26aug1998
  -- Reject the DATUM atta if selected, AND the SREF atta as if the DATUM atta has been selected,
  -- if picked by identifying the LSTU of the BRANCH
  -- Reject if the selected PIPE BRANCH or BRANCH member is the same as the DATUM atta owner.
  !unusedName   = !form.support.stru.name
  !unusedPicked = !!ce
$(
if (!picked eq !form.support.datum)then
!!alert.message('Datum Pipe cannot be selected')
golabel /label
elseif (!picked.name.eq(!name & '/SREF')) then
!!alert.message('Datum Pipe cannot be selected')
golabel /label
elseif (!form.support.datum.owner.eq(!picked)) then
!!alert.message('Datum Pipe cannot be selected')
golabel /label
elseif (!form.support.datum.owner.eq(!picked.owner)) then
!!alert.message('Datum Pipe cannot be selected')
golabel /label
endif
$)
  --< Modified - <wd> - 26aug1998
  -----------------------------------------------------------------------

  !rotateAtta = FALSE
  -- Check that an atta for this element doesn't already exist
  if (!!mdsCheckAtta(!form))then
    --<wd>feb2004 - Now Continues Silently without the Confirm alert shown below!!

    --      if (!!alert.confirm('This Pipe is already being supported on $!<form.name.val>. Ok to continue') eq 'NO')then
    --        return
    --      else

    !rotateAtta = TRUE
    --      endif
    --<wd>feb2004
  endif

  -----------------------------------------------------------------------
  --<wd>jan2004 -- Set the Support Object members '.idbran' and '.idcomp'
  -- to the DBREF of the Identified Branch and the Identified Component
  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !form.support.idcomp = !idcomp
  !form.support.idbran = !idbran

  --<wd>jan2004
  -----------------------------------------------------------------------

  -- Check direction of pipe. Cannot select a vertical pipe for certain
  -- configurations of pipe support

  if (!form.support.type inset('FT01', 'FT02', 'FT05', 'FT06', 'FT07' , 'FT17'))then
    !pldir = pl dir wrt world
    handle (61,2) (2,201) (2,252)
      !pldir = ph dir wrt world
    endhandle
    if (!pldir eq U or !pldir eq D)then
      !!alert.error('Cannot select a vertical pipe')
      return
    endif
  endif

  --<wd>oct2002
  !purp = PURP of PSPE of OWNER
  handle (2,102)
    !!alert.error('Pipe specification of pipe not set for identified pipe')
    return
  endhandle
  if (!purp neq |PIPE|) then
    --<wd>oct2002
    !!alert.error('Identified element is not a piping component')
    return
  endif

  -- Check if Selected Pipe is in the same ORI (Horizontal or Vertical Pipe) as the Datum Atta.
  !currcomp = !!ce
  !!ce = !datum
  !datpldir = pl dir wrt world
  !datpadir = pa dir wrt world

  !!ce = !currcomp
  !cepldir  = pl dir wrt world
  handle (61,2) (2,201) (2,252)
    !cepldir = ph dir wrt world
  endhandle

  -- If the identified element is a baseplate for trunnions, then ignore the mixing check
  --<dw>oct2008 dun979 - Also to allow for additional trunnion base plates types AC60 to AC67

  !stypOfIdentifiedElement = styp
  handle ANY
    !inLineOnly = FALSE
  elsehandle NONE
    !inLineOnly = FALSE
    if (!stypOfIdentifiedElement inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
      !inLineOnly = TRUE
    endif

    --<wd>jan2004>
    -- MDS Specials may NOW own Vertical and Horizontal Pipes
    if (!aliasName.neq('SPECIAL')) and !inLineOnly.not() then

      if (!datpldir.up.abs() neq 1) then
        --  Datum Pipe is Horizontal.
        --  Now Check if Selected Pipe is Horizontal or Vertical
        if (!cepldir eq u or !cepldir eq d) then
          -- Selected Pipe is Vertical
          if !!mdsCheckTrun(!form,'ALL') then
          else
            !!alert.message ('Unable to Mix Horizontal and Vertical Pipes on the same Framework')
            !!ce = !currcomp
            return
          endif
        else
$(
-- Selected Pipe is Horizontal so Check if it is within the Allowable Slope
if (!!mdsgradient(!currcomp)) then
!!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
!!ce = !currcomp
return
endif
$)
        endif

      else
        -- Datum Pipe is Vertical
        if (!cepldir.up.abs() neq !datpldir.up.abs() or !cepldir.up.abs() neq !datpadir.up.abs()) then
          -- Selected Pipe is Horizontal
          if !!mdsCheckTrun(!form,'ALL') then
          else
            !!alert.error  ('Unable to Mix Horizontal and Vertical Pipes on the same Framework')
            !!ce = !currcomp
            return
          endif
        endif
      endif

    endif

  endhandle
  --<wd>jan2004

  -- Check to see if there is an angle between the
  -- datum atta and the selected pipe

  if (not !!mdsCheckAng(!datum,!currcomp)) then
    !!ce = !currcomp
    return
  endif

  !type  = TYPE
  !units = object COMUNITS(TRUE)
  units MM BORE
  if (!type eq |BRAN|) then
    !bore = HBOR
    --    VAR !bore HBOR
  else
    --    VAR !bore PL boRE
    !bore = PL BORE
  endif
  !units.restoreSavedUnitsByPtype('BORE')

  --    if (!bore inset(15, 20, 25, 40, 50)) then
  --      $M/%PDMSUI%/DES/JBSUPP/MFIELD
  --      Call !!mdsCrAddPipe(!form)
  --    else

  -- Change callback on apply button then show ancillary form
  !formName = '!!' & !form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill($!formName)|
  !!mdsAncill.action[2] = |Call !!mdsCrAddPipe($!formName)|
  !aliasName = !!mdsAliasList(!form.support.type)
  if (!aliasName inset('FT17' , 'FT18' , 'FT19')) then
    if (!form.support.stru.mcount() neq 0) then
      !!mdsAncill.action[3] = |Call !!mdsAdjustTbar($!formName, 1)|
      !callb = '!!mdsCreate' & !aliasName
      !!mdsAncill.action[4] = |Call $!callb('DIMENSION')|
    endif
  elseif (!aliasName inset('FT03','FT04','FT05','FT06')) then
    !!mdsAncill.action[3] = |Call !!mdsAdjustBar($!formName, 1)|
    if (!form.support.stru.mcount() neq 0) then
      !!mdsAncill.action[4] = |Call !!mdsCreate$!aliasName('DIMENSION')|
    endif
  elseif (!aliasName inset('FT07')) then
    !exists = !form.support.stru.name & '-BAR-1'
    !!ce = !exists
    handle NONE
      !!mdsAncill.action[3] = |Call !!mdsCreate$!aliasName('DIMENSION')|
    elsehandle ANY
    endhandle
  elseif (!aliasName inset('FT21')) then
    !!ce = !currcomp
    !!mdsAncill.action[3] = |call !!mdsuboltft21()|
    !!mdsAncill.action[4] = |call !!mdsCreateft21('MdsADDPIPE')|
  endif
  !!kshowForm(!!mdsAncill)
  !!mdsIAncill(!form.support.type)
  --    endif

  if !rotateAtta then
    !!mdsAncill.action.append('!!mdsRotateAtta.atta = !!ce')
    !!mdsAncill.action.append('!!mdsRotateAtta.form = !!$!form')
    !!mdsAncill.action.append('!!mdsRotateAtta.name.val = !!ce.name')
    !!mdsAncill.action.append('show !!mdsRotateAtta')
  endif

  -- End function
endfunction
