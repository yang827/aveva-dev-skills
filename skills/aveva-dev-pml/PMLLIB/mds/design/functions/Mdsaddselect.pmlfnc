--
-- File:		Mdsaddselect.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:
-- Function to select a support for addition to the drawlist
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Method of selecting 'CURSOR or NAME'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAddSelect(!SelectBy is STRING)

  !Origin = !!CE

-- Select support
  if (!SelectBy.upcase() eq 'CURSOR')then

-- Pick support by identifying support atta or structure
    prompt off
    prompt load escape 'Identify support to add to the drawlist'
    id @
      handle (61,528)
        prompt dismiss
        return
      endhandle
    prompt dismiss
    prompt on
    !Element = !!CE

  elseif (!SelectBy.upcase() eq 'NAME')then

-- Check to see if the name is valid
    if (!!MdsAddSupp.Name.Val.upcase() eq |UNSET|)then
      return
    endif

-- Test to see if the Element exists
    if (subs(!!MdsAddSupp.Name.Val,1,1) eq '/')then
      !Name = after(!!MdsAddSupp.Name.Val, '/')
    else
      !Name = !!MdsAddSupp.Name.Val
    endif

    !Ref = '/' & !Name
    !!MdsAddSupp.Name.Val = !Name

-- Navigate to element
    !Element = !Ref.dbref()
      handle any
        !!MdsAddSupp.Name.Val = 'unset'
        !!MdsAddSupp.Name.Setfocus()
        !!Alert.error('Support $!Name does not exist.')
        return
      endhandle

  elseif (!SelectBy.upcase() eq 'CE')then

    !Element = !!CE

  else
    !!MdsAddSupp.Name.Setfocus()
    !!Alert.error('Incorrect selection argument passed. Contact your MDS Administrator.')
    return
  endif

  !!CE = !Element.Name.dbref()

-- Check Element Picked by trying to obtain its support name
-- The following function returns the name of the support if found
-- or ABORT if an error occurs

  !Support = !!MdsGetSuppName(!!CE.Name.dbref())

  if (!Support eq 'ABORT') then
    !!CE = !Origin
    !!MdsAddSupp.Name.val = 'unset'
    !!MdsAddSupp.Name.SetFocus()
    return
  endif

-- Check what type of element is now we have found it to be a support

  !!CE = !Support.dbref()
    handle (2,109)
      !!Alert.Error('Cannot find support associated with picked element')
      !!MdsAddSupp.Name.val = 'unset'
      !!MdsAddSupp.Name.SetFocus()
      !!CE = !Origin
      return
    endhandle

  if (!Support.dbref().type eq |STRU|)then
    !!CE = !Support.dbref()
  elseif (!Support.dbref().type eq |ATTA|)then

 -- This is a lone atta support (no steelwork associated). Add to selection list
    !Data[1] = !!CE
    golabel /End
  else
    !!MdsAddSupp.Name.Setfocus()
    !!Alert.error('Cannot add support. Type of support reference is unknown.')
    golabel /Reset
  endif

-- Check type of structure
  if (!!CE.owner.purp neq |SUPP|)then
    !!MdsAddSupp.Name.Setfocus()
    !!Alert.error('Selected element is not a support.')
    golabel /Reset
  endif

  !Support = !!CE.name
  !Stru    = !!CE

-- Get support type of framework
  !SuppType = !!CE.:MDSSuppType
  if (!SuppType eq '')then
    !!MdsAddSupp.Name.Setfocus()
    !!Alert.error('Cannot add support. Type is unknown.')
    golabel /Reset
  endif

label /End

-- Get all components associated with this support
  !Name = after(!!CE.name, '/')
  !Data = !!KCollectAllFor('ATTA', 'STEXT eq |$!Name|', =0/0)

-- See if there is an SREF atta
  !SrefName = '/' & !Name & '/SREF'
  !!CE = !SrefName.dbref()
    handle none
      !Sref = !!CE
    elsehandle any
    endhandle

-- Set form gadgets

-- Navigate to support and set name gadget to support name
  !!CE = !Support.dbref()
  !!MdsAddSupp.Name.Val = after(!!CE.Name, '/')

-- return to origin

  !!CE = !Origin

return

label /Reset
  !!CE = !Origin
  !!MdsAddSupp.Name.Val = 'unset'
  !!MdsAddSupp.Name.SetFocus()

-- End function
endfunction

-- End of file Mdsaddsupp.pml
