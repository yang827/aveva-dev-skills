--
-- File:		Mdsadjustbar.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Jun 12
--
--
-- Description:
-- function to adjust a cross bars length.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support Form
--     2     R        REAL          Bar to adjust in length
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsAdjustBar(!Form is FORM, !BarNumber is real)
 -- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    !Origin    = !!CE
    --!Clearance = !!MdsOptions.Clear.val
    !Support   = !Form.Support
    !Name      = !Support.Stru.name
    !Sctn      = !Name & '-BAR-' & !BarNumber
    !Attas     = !Support.Bars[!BarNumber]
    !Dim       = 0
    !vert      = true

--<k.pleschner>Apr06 create array of MDSANCGEOMDFLTS objects
    !attaDflts = ARRAY()
    do !C indices !attas
       !AttaDflts[!C] = object MDSANCGEOMDFLTS(!attas[!c])
    enddo
--<k.pleschner>Apr06

  -- Navigate to bar
    !!CE = $!Sctn
      handle any
        !!kRestoreUnits(!currentunits)
        return
      endhandle
    !StartDir = !!CE.Drns.wrt(world)
    !EndDir   = !!CE.Drne.wrt(world)
    !PosStart = !!CE.Posstart.wrt(world)
    !PosEnd   = !!CE.Posend.wrt(world)
    PIN 3 at $!PosEnd
    PIN 3 DIR $!EndDir
    PIN 4 at $!PosStart
    PIN 4 DIR $!StartDir
    PIN 5 copy PIN 3
    PIN 5 plane PIN 5 CLEAR 0 INF $!<Name>-V1
--xxx
      handle (2,109)
-- Vertical Section eg. '<name>-V1' Does NOT Exist (eg. FT14 , FT15)
        pin 5 copy pin 3
        pin 5 plane pin 5 thro $!origin
        !vert = false
      endhandle
--xxx

      !dist34 = !!KStrReal('cons dist pin 3 to pin 4')
--xxx
      !Dist35 = !!KStrReal('CONS DIST PIN 3 to PIN 5')
      !Dist45 = !!KStrReal('CONS DIST PIN 4 to PIN 5')

    if (!Dist35 lt !Dist45)then
      !PinNumber = 3
      !SctnEnd = 'START'
      !Dir    = !EndDir
    else
      !PinNumber = 4
      !SctnEnd = 'END'
      !Dir    = !StartDir
    endif


--xxx--xxx--xxx--xxx--xxx--xxx
-- Framework does NOT have a Vertical Section eg. '<name>-V1' (FT14 , FT15 )
    if (!vert.not() and !support.type eq 'FT15' and !support.config eq 1 ) then
      if (!dist35 + !dist45 gt !dist34) then
        !!alert.warning ('The Selected Pipe is outside the limits of the structure ** $!name ** and cannot be supported on this Framework')
        call !!Mdsunlinkatta(!form , !origin)
        !!ce = !origin
        !posd = pos wrt /*
        do !count from 211 to 259
          var !aidtext aid text $!count
          handle any
            skip
          elsehandle none
            var !aidposd (after(|$!aidtext|,|At |) )
            !aidposid = !aidposd & ' WRT /*'
            if (!aidposid eq !posd.string()) then
              $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count
            endif
          endhandle
        enddo
        delete atta
        !form.support.atta.removelast()
        !!kRestoreUnits(!currentunits)
        return
      else
-- Modify value of the Bar Length in the object MdsSUPPORT for Frame Type 'FT15'
-- If Additional Pipe etc. is within the Limits of the Framework Cross-Bar
-- Do NOT adjust length of Cross-Bar to suit all attas if Configuration is '1'.
        if (!support.type eq 'FT15' and !support.config eq 1) then
          golabel /SUPPORT
        endif
      endif
    endif
--xxx--xxx--xxx--xxx--xxx--xxx



  -- Position pins
    do !V values !AttaDflts

--<k.pleschner> Apr06  Use ancillary specific default instead of general !clearance

      PIN 9 COPY PIN $!PinNumber
      --PIN 9 plane PIN 9 CLEAR $!Clearance BEH $!V
      if !V.Clge.eq('GEOM') then
         PIN 9 plane PIN 9 CLEAR $!V.Oend BEH $!V
      else
         PIN 9 plane PIN 9 thr $!V
         PIN 9 plane PIN 9 DISTANCE $!V.Oend
      endif
        handle (2,109)
          BREAK
        endhandle
      !Cdim = !!KStrReal('CONST DIST PIN $!PinNumber TO PIN 9')
      if (!Cdim gt !Dim) then
        !Dim = !Cdim
      endif
    enddo

    PIN 9 COPY PIN $!PinNumber
    PIN 9 DIST $!Dim
  if !support.type  neq 'FR01' then
     -- Extend correct end thro pin 9
     EXTEND $!SctnEnd THRO PIN 9
  endif
  -- Navigate to subs if necessary but not with ft01 and ft02
    if (!support.type  neq 'FT14') then
      if (!support.type inset('FT01','FT02')) then
      else
      !!CE = $!<Name>/SUBS$!<BarNumber>
      handle none
        MOVE $!Dir thro pin 9
        PIN8 COPY PIN9
        pin8 plane pin8 clear 0 beh ce
        MOVE $!Dir thro pin8
      elsehandle any
      -- FT14 SUBS is a Beam Stiffener positioned on the Supporting Beam and NOT on the Cantilevered
      -- of the Framework as other Frameworks.
      endhandle
      endif
    endif

--xxx--xxx--xxx--xxx--xxx--xxx
label /SUPPORT
--xxx--xxx--xxx--xxx--xxx--xxx

  -- Update form data
    !BarLen = deri length of $!<Name>-BAR-$!<BarNumber>
    !Form.Support.BarLen[!BarNumber] = !BarLen

    !!CE = !Origin

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdsadjustbar.pml
