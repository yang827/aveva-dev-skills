--
-- File:		Mdsadjustslope.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed May 28
--
--
-- Description:
-- function to get adjustment required for supports on sloping lines
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          ARRAY       An array of support frame members
--     2     R          DBREF       Support datum point
--
-- Return:
--    [Data Type]   [Description]
--       REAL        Amount of adjustment required on support
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAdjustSlope(!Support is ARRAY, !Datum is DBREF) is REAL

-- Find current units and set the distance unit to metric
  !CurrentUnits = !!KGetSetUnits()

  prec var 5dp

-- Initialise variables
  !Origin = !!CE
  !Move   = ARRAY()

--<wd>oct2004
-- Use the TRUE Atta P9 direction now that the DATUM ATTAS on HORIZONTAL PIPES
-- may be rotated thro 0 to 360 degrees, and the MDS Framework is rotated to suit.
  !p9dir = !datum.pdir[9].wrt(/* )
--<wd>oct2004

-- Navigate to structural element passed
  do !V values !Support

    !!CE = !V

-- If the bar is BAR-1 and the atta is not DATUM the set to 0
    if !!ce.name.match('-BAR-1').gt(0) and !Datum.name.match('/DATUM').eq(0) then
      !!kRestoreUnits(!currentunits)
      return 0
    endif

    pin 1 copy p9 of $!Datum
    pin 1 clear 0 inf ce
    pin 2 copy p9 of $!Datum
    pin 3 copy pin 1

--<wd>oct2004
-- Use the TRUE Atta P9 direction now that the DATUM ATTAS on HORIZONTAL PIPES
-- may be rotated thro 0 to 360 degrees, and the MDS Framework is rotated to suit.
    --pin 3 dir d wrt /*
    pin 3 dir $!p9dir
--<wd>oct2004

    pin 3 dist 100mm
    var !Ang const ang pin 3 to pin 1 to pin 2

    if !ang.eq('') then
      !!MdsResetPins(1,3)
      !!CE = !Origin
      return 0
    endif

    !Dist = !!KStrReal('const dist pin 1 to pin 2')
    !Move.append($!dist / (cos ($!Ang)))
-- HPD0020871 GE 09/05/06 Cosine function error when adding packer in falling line
      handle (2,780)
        !!MdsResetPins(1,3)
        !!CE = !Origin
        return 0
      endhandle
-- EOF
  enddo

  if (!Move.size() eq 1)then
    !Value = !Move[1]
  elseif (!Move.size() eq 2)then
    !Value = max(!Move[1], !Move[2])
  else
    !!Alert.error('Too many values being processed.')
    !Value = 0
  endif

  prec var 0 dp

-- Reset units and pins
  !!kRestoreUnits(!currentunits)

  !!MdsResetPins(1,3)

  !!CE = !Origin

-- Before returning the values check if the comp has a yfp prop (y foot print) if so check
-- that the comp is wider than the member if not only give a proportion of the value

  !yfp = !Datum.prop.yfp
  handle ANY
    return !Value
  elsehandle NONE
    !width = !Support[1].prop.widt
    handle ANY
      return !Value
    elsehandle NONE
      !DivideBy = !Width.real() / !yfp.real()
      if !DivideBy.gt(1) then
        !NewValue = !Value / !DivideBy
        return !NewValue
      endif
    endhandle
  endhandle
  !!CE = !Origin

  return !Value

-- End function
endfunction

-- End of file Mdsadjustslope.pmlfnc
