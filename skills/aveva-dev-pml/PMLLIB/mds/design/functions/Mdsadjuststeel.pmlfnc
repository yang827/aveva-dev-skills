--
-- File: Mdsadjuststeel.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Tuesday 26th March 2002
--
--
-- Description:
-- Function to reset the width of a stop over a piece of steel
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Passing form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------


-- Define Function
define function !!mdsadjuststeel(!form is FORM)

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetsetunits()

  -- Initialise variables

  !unusedsupport = !form.support
  !datum = !form.support.datum
  !alias = !form.support.alias

  --------------------------------------------------------------------------------
  -- Identify steelwork

  if (!alias.eq('AN04')) then

    !!ce = !datum

    -- Identify beam to bolt guide to
    prompt off
    prompt load escape 'Identify section to bolt guide to'
    --<wd>10jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>10jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt on

    -- TBHL to TBHR for the cross centres
    -- Also the flange thickness is needed

    var !cc const dist ppline TBHL start to ppline TBHR start
    handle any
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to find bolt cross centres from identified section')
      return
    endhandle


    !flanThk = (prop FLG)
    handle any
      !flanThk = 10
    endhandle

    same

    var !prop coll all data with dkey eq 'SBFT' for dtre
    var !ccprop coll all data with dkey eq 'BLEN' for dtre
    var !num1 eval num for all from !ccprop
    var !num2 eval num for all from !prop
    !!mdsDacControl(true)
    despar n$!num1[1]  $!cc
    despar n$!num2[1]  $!flanThk

    --Anand 1/3/05
    ---Added for GT46,gt49
  elseif (!alias inset('GT46','GT49')) then

    !!ce = !datum

    -- Identify beam to bolt guide to
    prompt off
    prompt load escape 'Identify section to set height to'
    --<wd>10jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>10jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt on

    !sctn = !!ce

    pin 9 copy p9 of $!datum
    pin 8 copy pin 9
    pin 8 plane pin 8 clear 0 inf $!sctn
    !dist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
    $!datum
    !dpnuma = !!mdsGetDesp('PTHK')
    !data = 'Plate thickness'
    if (!alias inset('GT49')) then

      if (!dist.eq(0)) then
        !pod = pl od
        !dpnumfwid = !!mdsGetDesp('FWID')
        despa numb $!dpnumfwid   $!pod
      endif

      !dpnuma = !!mdsGetDesp('DIST')
      !data = 'Height'
    endif

    if (!alias inset('GT46')) then
      !supptype = !!ce.styp
      ------------------------------------------------------------------------------
      -- mjb >>> 10.05.06 <mds12>
      --!parvar = '!!mdspar' + !supptype
      !bore = pa bore

      !realbore = !bore.real().value()
      !mdsattaobj  = object MDSREADPARSDATA()
      !unusedMdsattadefs = !mdsattaobj.mdsdefsdata(!supptype,!realbore)

      !min = !mdsattaobj.userdps[$!dpnuma].min
      !max = !mdsattaobj.userdps[$!dpnuma].max

      --!min = $!parvar[$!bore].userdps[$!dpnuma].min
      --!max = $!parvar[$!bore].userdps[$!dpnuma].max
      -- mjb <<< 10.05.06 end of mod
      ------------------------------------------------------------------------------
      if (!dist.nint() lt !min.nint()) then
        !!alert.error(|$!data is less than the minimum allowed. Setting $!data to min of $!min|)
        !dist = !min
      elseif (!dist.nint() gt !max.nint()) then
        !!alert.error(|$!data is greater than the maximum allowed. Setting $!data to max of $!max|)
        !dist = !max
      endif
    endif

    --<dw>oct2008 dun979 - Dac control added to allow despara to be reset
    !!mdsDacControl(true)

    despa numb $!dpnuma  $!dist

    !!mdsresetpins(8,9)

    -- New Test to see if the Standard can be resized to include a BOX GTYPE

    -- elseif !!MdsAn01.support.type.eq('AN11') or !!MdsAn01.support.type.eq('AN10') then
  elseif (!alias inset ('AN11','AN10','ST06')) then
    -- Identify beam to use as stop
    prompt off
    prompt load escape 'Identify section or box to use as stop'
    --<wd>10jan2008 -- Defect No. P-4407
    --    ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>10jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      return
      -- golabel /end
    endhandle
    prompt on

    --<dw>oct2008 dun979 - Dac control added to allow despara to be reset
    !!mdsDacControl(true)

    --<wd>10jan2008 -- Defect No. P-4407
    --   if !!CE.type EQ 'SCTN'and !alias inset ('AN11','AN10') then
    if (!!ce.type inset('SCTN','HSTIFF') and !alias inset ('AN11','AN10')) then
      --<wd>10jan2008 -- Defect No. P-4407
      !beamWidth = (prop WIDT)
      $!datum
      var !ccprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccprop
      despar n$!num1[1]  $!beamWidth
    endif

    --<wd>10jan2008 -- Defect No. P-4407
    --   if !!CE.type EQ 'SCTN'and !alias inset ('ST06') then
    if (!!ce.type inset('SCTN','HSTIFF') and !alias inset ('ST06')) then
      --<wd>10jan2008 -- Defect No. P-4407
      !width = prop widt
      $!datum
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !num1 eval num for all from !prop
      despar n$!num1[1]  $!width
    endif

    if (!!ce.type EQ 'BOX' and !alias inset ('AN11','AN10')) then
      !box = !!ce
      $!datum
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !width = !!kStrReal('const dist pin 2 to pin 3')
      var !ccprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccprop
      despar n$!num1[1]  $!width
      !!mdsresetpins(2,3)
    endif

    if (!!ce.type EQ 'BOX' and !alias inset ('ST06')) then
      !box = !!ce
      $!datum
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !width = !!kStrReal('const dist pin 2 to pin 3')
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !num1 eval num for all from !prop
      despar n$!num1[1]  $!width
      !!mdsresetpins(2,3)
    endif
    -- End of Test

  else

    prompt off
    prompt load escape 'Identify section to reset steelwork gap'
    --<wd>10jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>10jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt on

    !steelwidth = (prop WIDT)
    handle any
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to find member width property WIDT')
      return
    endhandle

    !!ce = !form.support.datum

    !desp = !!mdsGetDesp('SBFW')
    if (!desp.eq(0)) then
      !desp = !!mdsGetDesp('SSMW')
    endif
    if (!desp.eq(0)) then
      !desp = !!mdsGetDesp('WID')
    endif

    !!mdsDacControl(TRUE)

    despar n$!desp $!steelwidth

  endif

  -- Reset Units

  --<dw>oct2008 dun979 - Dac control reset
  !!mdsDacControl(false)
  !!kRestoreUnits(!currentunits)

endfunction
