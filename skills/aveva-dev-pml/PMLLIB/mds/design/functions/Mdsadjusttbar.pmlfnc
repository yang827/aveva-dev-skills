--
-- File:		Mdsadjusttbar.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Jun 12
--
--
-- Description:
-- function to adjust a cross bars length.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support Form
--     2     R        REAL          Bar to adjust in length
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAdjusttbar(!Form is FORM, !BarNumber is REAL)

-- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    !Origin    = !!CE
    !Clearance = !!MdsOptions.Clear.val
    !Overlap   = !!MdsOptions.overlap.val
    !Support   = !Form.Support
    !Name      = !Support.Stru.name
    !Sctn      = !Name & '-BAR-' & !BarNumber
    !Attas     = !Support.Bars[!BarNumber]
    !dim  = 0

  -- Navigate to bar
    !!CE = $!Sctn
      handle any
        !!kRestoreUnits(!currentunits)
        return
      endhandle
    !StartDir = !!CE.Drns.wrt(world)
    !EndDir   = !!CE.Drne.wrt(world)
    !PosStart = !!CE.Posstart.wrt(world)
    !PosEnd   = !!CE.Posend.wrt(world)
    PIN 3 at $!PosEnd
    PIN 3 DIR $!EndDir
    PIN 4 at $!PosStart
    PIN 4 DIR $!StartDir
    PIN 5 copy PIN 3
    PIN 5 plane PIN 5 CLEAR 0 INF $!<Name>-V1



-- Position Pin 4

   !dim = 0
----------------------------------------------------------------------------
   do !val values !attas

--  Check if Current Pipe and Datum Pipe 'P10' points have the SAME direction.
-- Set object definition
     !valp10dir = p10 dir of $!val wrt /*
     !direction = object KEQUALDIR()
     !direction.directionA = !support.p10dir
     !direction.directionB = !valp10dir
     !direction.tolerance  = 0.05

     if (!!kdirequaldir(!direction)) then
       !desc = 'BEH'
       pin 4 copy p10 of $!val
       pin 4 at $!val
       pin 2 copy p10 of $!val
       var !temppin4dir pin 4 dir wrt /*
     else
       !desc = 'BEH'
       pin 4 copy p11 of $!val
       pin 4 at $!val
       pin 2 copy p11 of $!val
       var !temppin4dir pin 4 dir wrt /*
     endif

     pin 2 plane pin 2 clear $!clearance $!desc $!val
       handle (2,109)
         break
       endhandle
     pin 1 copy pin 4
     pin 1 plane pin 1 thro $!<Name>-V1

      !pd12 = !!KStrReal('cons dist pin 1 to plane pin 2')
      !pd14 = !!KStrReal('cons dist pin 1 to plane pin 4')

-- Temporarily move Pin1 off CL of Vertical leg
     if (!pd14.eq(0)) then
       pin 1 dist -20
     endif

     var !p12dir cons dir pin 1 to pin 2
     var !p14dir cons dir pin 1 to pin 4

-- Reposition Pin1 on cl of Vertical leg
     pin 1 plane pin 1 thro $!<Name>-V1

-- Set object definition
     !direction = object KEQUALDIR()
     !direction.directionA = !p12dir.direction()
     !direction.directionB = !temppin4dir.direction()
     !direction.tolerance  = 0.05

     if (!pd12.gt(!dim) and !!kdirequaldir(!direction)) then
       pin 4 at $!val
       pin 4 dist $!pd12 from pin 1
       !dim = !pd12
     else
       pin 4 at $!val
       pin 4 dist $!dim from pin 1
     endif
   enddo

   pin 4 dir from pin 2 to pin 1
----------------------------------------------------------------------------


-- Position Pin 3

   !dim = 0
----------------------------------------------------------------------------
   do !val values !attas

--  Check if Current Pipe and Datum Pipe 'P10' points have the SAME direction.
-- Set object definition
     !valp10dir = p10 dir of $!val wrt /*
     !direction = object KEQUALDIR()
     !direction.directionA = !support.p10dir
     !direction.directionB = !valp10dir
     !direction.tolerance  = 0.05

     if (!!kdirequaldir(!direction)) then
       !desc = 'BEH'
       pin 3 copy p11 of $!val
       pin 3 at $!val
       pin 6 copy p11 of $!val
       var !temppin3dir pin 3 dir wrt /*
     else
       !desc = 'BEH'
       pin 3 copy p10 of $!val
       pin 3 at $!val
       pin 6 copy p10 of $!val
       var !temppin3dir pin 3 dir wrt /*
     endif

     pin 6 plane pin 6 clear $!clearance $!desc $!val
       handle (2,109)
         break
       endhandle
     pin 1 copy pin 3
     pin 1 plane pin 1 thro $!<Name>-V1

      !pd16 = !!KStrReal('cons dist pin 1 to plane pin 6')
      !pd13 = !!KStrReal('cons dist pin 1 to plane pin 3')

-- Temporarily move Pin1 off CL of Vertical leg
     if (!pd13.eq(0)) then
       pin 1 dist -20
     endif

     var !p16dir cons dir pin 1 to pin 6
     var !p13dir cons dir pin 1 to pin 3

-- Reposition Pin1 on CL of Vertical leg
     pin 1 plane pin 1 thro $!<Name>-V1

-- Set object definition
     !direction = object kequaldir()
     !direction.directionA = !p16dir.direction()
     !direction.directionB = !temppin3dir.direction()
     !direction.tolerance  = 0.05

     if (!pd16.gt(!dim) and !!kdirequaldir(!direction)) then
       pin 3 at $!val
       pin 3 dist $!pd16 from pin 1
       !dim = !pd16
     else
       pin 3 at $!val
       pin 3 dist $!dim from pin 1
     endif

   enddo

   pin 3 dir from pin 1 to pin 6
----------------------------------------------------------------------------
----------------------------------------------------------------------------
----------------------------------------------------------------------------
----------------------------------------------------------------------------
-- Extend Cross Bar (Passed as Argument 2)
--xxx**************

    pin 9 copy pin 1

    PIN 9 PLANE PIN 9 CLEAR $!Overlap BEH $!NAME-V1

    !pd49 = !!KStrReal('cons dist pin 4 to plane pin 9')
    !pd39 = !!KStrReal('cons dist pin 3 to plane pin 9')
    !pd34 = !!KStrReal('cons dist pin 3 to plane pin 4')

--xxx     if (!support.mirror) then
     if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then

       if (!pd34.geq(!pd39)) then
         pin 9 plane pin 9 thro pin 3
       else
         pin 9 plane pin 9 clear $!overlap beh $!name-V1
         !pd49 = !!KStrReal('cons dist pin 4 to plane pin 9')
         if (!pd34.geq(!pd49)) then
           pin 9 plane pin 9 thro pin 3
         endif
       endif

     else

       if (!pd34.geq(!pd49)) then
         pin 9 plane pin 9 thro pin 4
       else
         pin 9 plane pin 9 clear $!overlap beh $!name-V1
         !pd49 = !!KStrReal('cons dist pin 4 to plane pin 9')
         if (!pd34.geq(!pd49)) then
           pin 9 plane pin 9 thro pin 4
         endif
       endif

    endif
----------------------------------------------------------------------------
----------------------------------------------------------------------------
----------------------------------------------------------------------------
----------------------------------------------------------------------------
----------------------------------------------------------------------------

-- Extend END and START of Additional Cross Bar to suit Attas

--xxx    if (!support.mirror) then
    if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
--xxx      extend start thro pin 4
      extend start thro pin 9
      handle (73,214) $* Structural Geometry Error - Zero Length Section
        poss $!posstart
        pose $!posend
        extend start thro pin 4
        extend end thro pin 9
      elsehandle none
--xxx        extend end thro pin 9
        extend end thro pin 4
        --<tm>15/07/2005 10:09
        handle ANY
        endhandle
      endhandle
--

    elseif (!support.mirror and !support.rotatecur) then
      extend start thro pin 4
      handle (73,214) $* Structural Geometry Error - Zero Length Section
        poss $!posstart
        pose $!posend
        extend start thro pin 9
        extend end thro pin 4
      elsehandle none
        extend end thro pin 9
      endhandle

--
    else

--xxx      extend start thro pin 3
      extend start thro pin 9
      handle (73,214) $* Structural Geometry Error - Zero Length Section
        poss $!posstart
        pose $!posend
        extend start thro pin 3
        extend end thro pin 9
      elsehandle none
--xxx        extend end thro pin 9
        extend end thro pin 3
      endhandle

    endif

  -- Update form data
    !BarLen = deri length of $!<Name>-BAR-$!<BarNumber>
    !Form.Support.BarLen[!BarNumber] = !BarLen

    !!CE = !Origin

-- Reset all Pins
   Call !!Mdsresetpins(1,10)

-- reset units
   !!kRestoreUnits(!currentunits)


-- End function
endfunction

-- End of file Mdsadjusttbar.pml
