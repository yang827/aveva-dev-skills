   var !!CDCArepDHEAD[2] raw |Page|
   var !!CDCArepDHEAD[3] raw |Page|
   var !!CDCArepSAMEHEAD[1] raw |OFF|
   var !!CDCArepSAMEHEAD[2] raw |OFF|
   var !!CDCArepSAMEHEAD[3] raw |OFF|
   var !!CDCArepOLDHEAD[1] raw |OFF|
   var !!CDCArepOLDHEAD[2] raw |OFF|
   var !!CDCArepOLDHEAD[3] raw |OFF|
