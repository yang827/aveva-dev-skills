--
-- File:  Mdsaidtext.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:   design
--   Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Friday 16th January 1998
--
--
-- Description:
-- Adds Marker Text to All Attas at 'P9' Position
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         FORM         Form Name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsaidtext(!form is FORM)

  -- Initialise Variables
  !support = !form.support
  -- Check if MDS Framework or Ancillary Standard
  if (!support.stru.set()) then
    !stru = !support.stru.name
  else
    !stru = !support.datum.name
  endif

  aid clear text 210
  handle ANY
  endhandle
  !!drawAidText('Datum',!support.datum.ppos[9],210)
  do !c from 3
    !atta = !support.atta[!c]
    handle ANY
      break
    endhandle
    !numb = !c + 208
    aid clear text $!numb
    handle ANY
    endhandle
    !!drawAidText(!atta.namn, !atta.ppos[9],210)
  enddo

endfunction
-- End function
