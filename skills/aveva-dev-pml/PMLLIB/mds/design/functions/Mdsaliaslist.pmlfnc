-- Author:    N.Morris
-- Created:   Fri 5 Dec 1997
--
--
-- Description:
-- Function to return a framework/ancillary name if it has an alias
--
--<dw>mar2009 dun1119 - AT145 to AT151, AT174 & AT175, GT61 to GT69, GT83 to GT88, ST43 to ST50, ST57 to ST59 added
--<wd>28jan2010 - DUN1233 Added Support Types -> 'GT90', 'GT91', 'GT92', 'GT93', 'GT94', 'GT95'
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       STRING        Alias to check
-- Return:
--    [Data Type]   [Description]
--    STRING        Alias Name
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsaliaslist(!passedName is STRING) is STRING
-- Determine if you are looking at a user defined support from MDU
-- AN500 - AN700
-- AT500 - AT700
-- BT500 - BT700
-- GT500 - GT700
-- LT500 - LT700
-- ST500 - ST700
-- Get std alpha/numerical characters
  !std = !!mdsGetStdNum(!passedName)
-- Check if passed std is a user standard
  if !std[1].eq('AN') or !std[1].eq('GT') or !std[1].eq('ST') then
    if !std[2].real().geq(500) and !std[2].real().leq(569) then
      !aliasName = 'AN500'
      return !aliasName
    elseif !std[2].real().geq(570) and !std[2].real().leq(639) then
      !aliasName = 'AN500'
      return !aliasName
    elseif !std[2].real().geq(640) and !std[2].real().leq(700) then
      !aliasName = 'AN640'
      return !aliasName
    endif
  elseif !std[1].eq('AT') or !std[1].eq('BT') or !std[1].eq('LT') then
    if !std[2].real().geq(500) and !std[2].real().leq(700) then
      !aliasName = 'AT500'
      return !aliasName
    endif
  endif
 -- End of Determine if you are looking at a user defined support from MDU

  if (!passedName eq 'CT01' or !passedName eq 'DT04') then
    !aliasName = 'FT04'
  elseif (!passedName eq 'CT02') then
    !aliasName = 'FT03'
  elseif (!passedName eq 'CT03') then
    !aliasName = 'FT05'
  elseif (!passedName eq 'CT04' or !passedName eq 'FT37') then
    !aliasName = 'FT08'
  elseif (!passedName eq 'CT05' or !passedName eq 'DT01' or !passedName eq 'FT36' or !passedName eq 'FT64' or !passedName eq 'FT65') then
    !aliasName = 'FT09'
  elseif (!passedName inset('CT06','CT09','DT03','DT03A','DT03B','DT03C','DT03D')) then
    !aliasName = 'FT14'
  elseif (!passedName inset('FT34A','FT34B','FT34C')) then
    !aliasName = 'FT34'
  elseif (!passedName inset('CT07','CT10')) then
    !aliasName = 'FT19'
  elseif (!passedName inset('CT08','CT11')) then
    !aliasName = 'FT18'
  elseif (!passedName eq 'DT02') then
    !aliasName = 'FT11'
  elseif (!passedName eq 'FT38' or  !passedName eq 'FT62' or !passedName eq 'FT63') then
    !aliasName = 'FT11'
  elseif (!passedName eq 'FT39') or (!passedName eq 'FT68') then
    !aliasName = 'FT13'
  elseif (!passedName inset('AT02','AT03','AT04','AT06','AT07','AT08','AT10A','AT10B','AT11A','AT11B', 'AT12')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT13' ,'AT14','AT15','AT16','AT17','AT18','AT53A','AT53B','AT54','AT55A','AT55B','AT55C')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT19','AT20','AT21','AT22','AT24','AT25','AT26','AT27','AT28','GT13')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('GT22','GT23A','GT23B','GT24','GT25','GT29','GT38','GT40','GT52','GT88','AN19','AT36','AT37','AT38','AT39')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('GT30', 'GT31', 'GT32', 'GT33', 'GT34', 'GT35', 'GT36', 'GT37', 'GT50','GT56','GT57','GT58','GT59')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('GT90', 'GT91', 'GT92', 'GT93', 'GT94', 'GT95')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT43','AT44','AT45','AT46','AT47','AT48','AT49')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT50','AT51','AT56','AT57','AT58','AT66','AT67','AT72','AT76','AT87','AT73','AT74A','AT74B','AT75A','AT75B','AT93','AT94','AT95A','AT95B')) then
    !aliasName = 'AT01'
  --<kp>may2011 AT185 added
  elseif (!passedName inset('AT77','AT78','AT79','AT80','AT81','AT82','AT83','AT84','AT85','AT86','AT88','AT161','AT162','AT163','AT164','AT165','AT168','AT185')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('GT41','GT42','GT43','GT51','GT77','GT78','GT79','GT80','GT81','GT82')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('ST25','ST26','ST27','ST28','ST29','ST31','ST35','ST39','ST51','ST52','ST53','ST54','ST55','ST56')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('ST30','ST32')) then
    !aliasName = 'ST01'
  elseif (!passedName inset('AT96','AT97','AT98','AT99')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT108A','AT108B','AT108C','AT108D','AT108E','AT108F','AT108G','AT108H')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT108AX','AT108BX','AT108CX','AT108DX','AT108EX','AT108FX','AT108GX','AT108HX')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT110','AT111','AT114','AT115')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F')) then
    !aliasName = 'AT40'
  elseif (!passedName inset('AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35')) then
    !aliasName = 'AT40'
  elseif (!passedName inset('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F')) then
    !aliasName = 'AT40'
  elseif (!passedName inset('AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42')) then
    !aliasName = 'AT40'
  elseif (!passedName inset('AT100A','AT100B','AT101A','AT101B')) then
    !aliasName = 'AT40'
  elseif (!passedName inset('AT103A','AT103B','AT103C','AT103D')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT104A','AT104B')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT59','AT68')) then
    !aliasName = 'AT59'
  elseif (!passedName inset('AT05','AT09','AT23','AT65')) then
    !aliasName = 'AT23'
  elseif (!passedName inset('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F')) then
    !aliasName = 'AT23'
  elseif (!passedName inset('AT29', 'AT29A', 'AT29B')) then
    !aliasName = 'AT29'
  elseif (!passedName inset('AT31', 'AT31A', 'AT31B')) then
    !aliasName = 'AT29'
  elseif (!passedName inset('AT105', 'AT105A', 'AT105B')) then
    !aliasName = 'AT29'
  elseif (!passedName inset('BT01A','BT01B','BT02','BT03')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('BT04A','BT04B','BT04C','BT05','BT06','BT07','BT09','BT10','BT11','BT12','BT13','BT14','BT15','BT16','BT17','BT18','BT19','BT21','BT22','BT23','BT24')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AN07A','AN07B','AN07C','AN08','AN09','AN17','AN18','AT32', 'AT63', 'AT64', 'AT102','AT106','AT107','AT109','AT112','AT113','AT133','AT134','AT135','AT136','AT137','AT138','AT139')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT152','AT153','AT154','AT155','AT156','AT157','AT158','AT159','AT160A','AT160B','AT166','AT167','AT183','AT184')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT140','AT141','AT144','AT145','AT146','AT147','AT148','AT149','AT150','AT151','AT174','AT175', 'AT181','AT182')) then
    !aliasName = 'AT144'
  elseif (!passedName inset('LT01A','LT01B','LT01C','LT02')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('LT10','LT11','LT12')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('AT128','AT129','AT130','AT131','AT132')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('LT03A','LT03B','LT03C','LT03D')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('LT06','AT61','AT116','AT117','AT118','AT119','AT120','AT121','AT122','AT123','AT124','AT125','AT126','AT127','LT13A','LT13B','LT14A','LT14B','LT15','LT16A','LT16B','LT17')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('LT04')) then
    !aliasName = 'LT04'
  elseif (!passedName inset('LT07','LT09')) then
    !aliasName = 'LT04'
  elseif (!passedName inset('AN01A','AN01B','AN02','AN03','AN04','AN06','AN10','AN11','AN12A','AN12B','AN13')) then
    !aliasName = 'AN01'
  elseif (!passedName inset('HT03A','HT03B','HT04A','HT04B','HT05A','HT05B','HT06A','HT06B','HT07','HT08','HT09','HT10')) then
    !aliasName = 'HT03'
  elseif (!passedName inset('HT02')) then
    !aliasName = 'HT01'
  elseif(!passedName.trim().upcase().substring(1,2).eq('FH') or !passedName.trim().upcase().substring(1,2).eq('VH') or !passedName.trim().upcase().substring(1,2).eq('MH') or !passedName.trim().upcase().substring(1,2).eq('LI')) then
    !aliasName = 'FH01'
  elseif (!passedName inset('GT06','GT07','GT08','GT14','ST06','AN04','GT18','GT19','GT44','GT46','GT47','GT48','GT49','GT60A','GT60B')) then
    !aliasName = 'GT01'
  elseif (!passedName inset('GT62','GT63','GT64','GT70','GT71','GT72','GT73','GT74','GT75','GT76')) then
    !aliasName = 'GT01'
  elseif (!passedName.matchwild('SU01*')) then
    !aliasName = 'SU01'
    elseif (!passedName.matchwild('SU02*')) then
    !aliasName = 'SU02'
  elseif (!passedName inset('SU03','SU04','AT30')) then
    !aliasName = 'SU01'
  elseif (!passedName inset('GT12A','GT12B','GT11','ST07','GT27A','GT27B','ST33','GT55','ST38')) then
    !aliasName = 'GT12'
  elseif (!passedName inset('GT65','GT66','GT67','GT68','GT69','GT84','ST45','ST46','ST47','ST48','ST49','ST50')) then
    !aliasName = 'GT12'
  elseif (!passedName inset('AN05','ST14','ST15','ST16')) then
    !aliasName = 'ST08'
  elseif (!passedName inset('GT15','GT45','GT54','GT61','GT83')) then
    !aliasName = 'GT02'
  elseif (!passedName inset('GT17')) then
    !aliasName = 'GT16'
  elseif (!passedName inset('VT08','VT09')) then
    !aliasName = 'VT07'
  elseif (!passedName inset('LT05A','LT05B','LT05C','LT05D','LT05E','LT05F','LT05G','LT05H')) then
    !aliasName = 'LT05'
  elseif (!passedName inset('LT08A','LT08B','LT08C','LT08D','LT08E','LT08F','LT08G','LT08H')) then
    !aliasName = 'LT05'
  elseif (!passedName inset('ST09A','ST09B','ST10A','ST10B','ST11A','ST11B','ST13A','ST13B','ST12','ST20')) then
    !aliasName = 'ST01'
  elseif (!passedName inset('ST24A','ST24B','ST24C','ST24D','ST34','ST36','ST37','ST40','ST41')) then
    !aliasName = 'ST24'
  elseif (!passedName inset('ST17','ST18','ST19','ST21','ST22','ST23','ST42','ST60','ST61','ST62')) then
    !aliasName = 'AT01'
  elseif (!passedName inset('ST43','ST44','ST57','ST58','ST59','GT85','GT86A','GT86B','GT87A','GT87B','GT87C','GT87D')) then
    !aliasName = 'ST43'
  elseif (!passedName inset('PIPE-REST')) then
    !aliasName = 'RT01'
  elseif (!passedName inset('PIPE-REST-INLINE')) then
    !aliasName = 'RT01'
  elseif (!passedName inset('RACK-REST')) then
    !aliasName = 'CA01'
  elseif (!passedName inset('CA02A')) then
    !aliasName = 'CA01'
  elseif (!passedName inset('CA02B')) then
    !aliasName = 'CA01'
  elseif (!passedName inset('GT21')) then
    !aliasName = 'GT01'
  elseif (!passedName inset('GT28')) then
    !aliasName = 'GT26'
  elseif (!passedName inset('AT69','AT70','AT71')) then
    !aliasName = 'AT62'
  elseif (!passedName inset('FT48A','FT48B','FT48C','FT48D')) then
    !aliasName = 'FT48'
  elseif (!passedName inset('PR02','PR03','PR04','PR05','PR06','PR07','PR08','PR09','PR10','PR11','PR12','PR13','PR14','PR15','PR16','PR17','PR18')) then
    !aliasName = 'PR01'
  elseif (!passedName inset('PR19','PR20','PR21','PR22','PR23','PR24','PR25','PR26','PR27','PR28','PR29','PR30')) then
    !aliasName = 'PR01'
  elseif (!passedName inset('FT53')) then
    !aliasName = 'FT52'
  elseif (!passedName inset('FT56')) then
    !aliasName = 'FT42'
  elseif (!passedName inset('FT58','FT59','FT60')) then
    !aliasName = 'FT50'
  else
    !aliasName = !passedName
  endif

return !aliasName

endfunction

return
