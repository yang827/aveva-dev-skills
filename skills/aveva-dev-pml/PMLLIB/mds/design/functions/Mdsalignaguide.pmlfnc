--
-- File:  Mdsalignaguide.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  30 Thu Apr 1998
--
--
-- Description:
-- Align adjustable guide with element
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAlignAGuide(!form is FORM)

  -- Identify the element you wish to align to it HEI/SHEI property
  -- HEI for shoes
  -- OHEI for slip unit heights

  prompt off
  prompt load escape 'Identify element you wish to align the adjustable guide to'
  ID @
  handle (61,528)
    prompt on
    return false
  endhandle
  prompt on

  -- Force into forwards mode
  FORWARDS

  -- Is the identified element in the same branch

  !guide = !form.support.datum.owner
  if !!ce.owner.neq(!guide) then
    !!alert.error('Identified element must be in the same branch as the guide')
    return
  endif

  -- make sure its not another AT62

  if !!ce.styp.eq('AT62') then
    !!alert.error('Cannot identify an adjustable guide insert')
    return
  endif

  -- Find the identified elements HEI/SHEI property

  !height = (prop HEI)
  handle any
    !height = (prop OHEI)
    handle any
      !!alert.error('Identified element does not have a height')
      return
    elsehandle none
      !type = 'SLIP'
    endhandle
  elsehandle none
    !type = 'SHOE'
  endhandle

  -- If the height was identified then it might have a slip unit attached

  if !type.eq('SHOE') then
    !!ce = !!ce.:MdsGuideref
    handle any
    elsehandle none
      !height = (prop OHEI)
      handle any
      endhandle
    endhandle
  endif

  !currentunits = !!kgetsetunits()

  -- Set the height in the AT62 hei design parameter 1

  !!mdsDacControl(true)
  !!ce = !form.support.datum
  despar n1 $!height

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
