--
-- File:		Mdsaligndist.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 30th September 1998
--
--
-- Description:
-- Facility to ALIGN Pipe Support along the path of the DATUM Attas'
-- ORTHOGONAL 'Pleave' Direction.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--     2     R        STRING        'PLUS' or 'MINUS'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsaligndist(!form is FORM, !move is STRING, !dist is REAL)

-- Initialise variables
    !support      = !form.support
    !!currentdist = !form.dist.val

-- If value set to 0 return
    if (!dist eq 0) then
      return
    endif

-- Negative or Positive?
    if (!move.eq('PLUS')) then
      !sign = '+'
    else
      !sign = '-'
    endif

-- Work out new distance from previous component
--    !distance = !currentdist $!sign !dist.abs()
--<wd>jan2001 - Global variable now declared instead of a local variable
    !distance = !!currentdist $!sign !dist.abs()

-- Update forms distance gadget
    !form.dist.val = !distance

-- Run function to move support
    !!Mdsposdist(!form)

  endfunction
-- End function

-- End of file Mdsaligndist.pml
