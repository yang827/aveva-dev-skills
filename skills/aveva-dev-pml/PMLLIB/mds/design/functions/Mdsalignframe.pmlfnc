--
-- File:		MdsAlignFrame.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 9th June 1998
--
--
-- Description:
-- Function to calculate the distance required to move frame to line up with
-- connecting Beam.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         Form        Form function is called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAlignFrame(!Form is form)

-- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()
    !Refe = !!ce

-- Can't do it if cursor was used unless the frame is certain types (FT11,FT10 and others)
   if(not (!Form.Support.type inset('FT10','FT11','FT07','FT06','FT38','FT62','FT63')) and !Form.Support.Connections[1].neq(!Form.Support.Connections[2])) then
      !!Alert.Error('Can only align Frame with supporting beam perpendicular to pipes')
      !!kRestoreUnits(!currentunits)
      Return
   endif

-- Initialise Variables
   !Connected = !Form.Support.Connections[1]
     handle (2,752)
       !!Alert.Error('No connections available to align!')
       !!kRestoreUnits(!currentunits)
       return
     endhandle
   --!SctnPos   = !Connected.position.wrt(WORL)
   !SctnPos   = !!MdsBeamCentre(!Connected)
   !Atta      = !Form.Support.Datum
   !VertName  = !Form.Name.Val & '-V1'
   if(!Vertname.substring(1,1).neq('/')) then
      !Vertname  = '/' & !Vertname
   endif
   !Vertical  = !VertName.Dbref()
   Handle Any
     !VertName  = !Form.Name.Val & '-BAR-1'
     if(!Vertname.substring(1,1).neq('/')) then
        !Vertname  = '/' & !Vertname
     endif
     !Vertical  = !VertName.Dbref()
    handle any
    -- Vertical does exist
       !!Alert.Error('Unable to align Support Uprights with Steelwork')
       Return
    Endhandle
   endhandle
-- Calculate atta direction

   !Pldir = !!KCalcOrthDir(!Atta)

-- Calculate centre of Vertical Sctn Member

   !Pos = !!MdsBeamCentre(!Vertical)

-- Calculate the Plane/dist to move support

   var !plane const plane $!Pldir thro $!SctnPos

   var !LineDir const line $!PlDir thro $!Pos
   var !Inter const pos inter $!LineDir $!Plane
   var !Dist const dist $!Pos to $!Inter
   if(!dist.real().eq(0)) then
      -- do nothing
         !!CE = !Refe
         return
   endif

   var !WhichDir const dir $!pos to $!inter
   !PDir      = !WhichDir.Direction()
   !ExistDist = !Form.Dist.Val

-- calculate which way to move support

   if(!Pdir.eq(!Pldir)) then
      !NewDist   = !ExistDist + !Dist.real()
   else
      !NewDist   = !ExistDist - !Dist.real()
   endif

   !Form.Dist.Val = !NewDist

-- Reposition support

   !!MdsPosDist(!Form)

-- Reset Units

   !!kRestoreUnits(!currentunits)

!!CE = !Refe

-- End function
endfunction

-- End of file MdsAlignFrame.pml
