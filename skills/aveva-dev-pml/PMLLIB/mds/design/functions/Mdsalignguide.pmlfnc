--
-- File:		Mdsalignguide.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Friday 6th February 1998	
--
--
-- Description:
-- Function to Align Guide Atta to the Bottom of the Associated Support Atta.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function
  define function !!Mdsalignguide()

--------------------------------------------------------------------------------
-- Check that Current Element is an ATTA
    if (!!ce.type.string().neq('ATTA')) then
      !!alert.error('Current Element MUST be a Support ATTA')
      return
    endif

--------------------------------------------------------------------------------
-- Check that Current ATTA Element is a Support ATTA
    !spec = (purp of spec of spref)
    if (!spec neq |MDS|) then
      !!alert.error('Current Element MUST be a Support ATTA')
      return
    endif

--------------------------------------------------------------------------------
-- Check that Current Support ATTA has a valid :MDSGuideRef Reference
    if (!!ce.:MDSGuideRef.unset() or !!ce.:MDSGuideRef.badref()) then
      !!alert.error('Current Support ATTA does not have a Valid Guide Reference')
      return
    endif

    !gdbref = :MDSGuideRef
    handle any
      !!alert.error('Current Support ATTA does not have a Valid Guide Reference')
      return
    endhandle

-- Support Atta is 'referencing' an Unknown Guide Atta
    !!ce = !gdbref
    handle any
      !!alert.error('Current Support ATTA does not have a Valid Guide Reference')
      return
    endhandle

--------------------------------------------------------------------------------
-- Everything appears to be OK, therefore:
-- Align the Guide to the Bottom of the Associated Support
   call !!Mdsresetguide()

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdsalignguide.pml
