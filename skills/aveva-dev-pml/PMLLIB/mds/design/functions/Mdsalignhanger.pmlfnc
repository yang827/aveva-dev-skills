--
-- File:    Mdsalignhanger.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:  Wed Mar 19 2002
--
--
-- Description:
-- Align the hanger and the supporting fitting to the new position of the atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         The DBREF of the atta
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsalignhanger(!attaRef is DBREF)

  !ce = !!ce
  !!ce = !attaRef
  !paDir = pl dir wrt /*
  goto cref
  handle NONE
    -- Save the current state of pin 1 & 2
    !!mdspushpin(1)
    !!mdspushpin(2)
    !ceHang = !!ce
    -- Calculating the offset between the hanger head and the atta
    !defaulttpos = !!ce.tpos
    pin1 at hh
    pin2 at hh
    pin2 dir $!paDir
    pin2 thro $!attaRef
    var !planDir const dir pin1 to pin2

    var !distToMove const dist pin1 to pin2
    if(!planDir eq '' or !distToMove eq '0') then
      if defined(!!licadautotestenabled) then
        -- do nothing
      elseif (!!mdsfh01.support.set() and !!mdsfh01.support.preliminaryStore.set()) then
        -- no message
      else
        !!alert.message('Nowhere to move')
      endif
      golabel /exit
    endif
    -- Move the restr. This will align it with the atta

    rest
    !hangers = mem count
    do !count from 1 to !hangers
      rest
      hang $!count
      move ph $!planDir dist $!distToMove
      -- dtf >>> mod 11.05.06
      !tdir = !!ce.tdir.wrt( /* )
      !pvjhot = object POINTVECTOR(!!ce.hposition , !tdir)
      --move pt $!planDir dist $!distToMove
      !pv = object POINTVECTOR(!!ce.tposition, !tdir)
      !plane = !pv.plane()
      !intersect = !plane.intersection(!pvjhot)
      pin 6 at $!intersect
      !!ce.tposition = !intersect
      --!hangerStart = !!ce.hposition
      --!hangerEnd   = !intersect
      --aid clear line 2999
      --handle ANY
      --endhandle
      --aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted
      pin 6 off
      -- dtf <<< end of mod
      do !i
        $!i
        handle ANY
          break
        endhandle
        move $!planDir dist $!distToMove
        hang
      enddo
    enddo
    handle (61,41)
      !!alert.message('No intersection between Direction of movement and selected Pline')
      golabel /exit
      return
    endhandle
    !!ce = !ceHang
    -- Move the fitting
    goto tref
    -- handle NONE
    handle ANY
    endhandle
    if (!!ce.type eq 'FITT') then
      -- Goto the fitting
      zDist thro $!attaRef
      if !!mdsfh01.hangertypes.stwallconn.eq(TRUE) then
        zdist thro ht of cref
        !plineName = POSL
        delp n0
        pin 1 at ce
        pin 2 at ht of cref
        var !xdist const dist pin 1 to pin 2
        var !xdir ppline NA x dir of owner wrt owner
        var !nAXdir ppline NA x dir of owner
        var !ddist const dist ppline na start of owner to ppline $!plineName start of owner
        var !thk cpara num 1 of owner
        var !zdir ppline $!plineName z dir of owner
        if ( !ddist.real().int() le !thk.real().int()) then
          if ( $!nAXdir neq $!zdir ) then
            !xdir = !xdir.direction().opposite().string().before('WRT')
          endif
        else
          var !olen desp num 1 of owner
          !newdist = ( !olen.real() - !ddist.real())
          !ddist =  !newdist.string()
          if ( $!nAXdir eq $!zdir )  then
            !xdir = !xdir.direction().opposite().string().before('WRT')
          endif
        endif
        --q var !ddist !nAXdir !zdir

        delpos $!xdir $!xdist
        zdist thro ht of cref
      endif
      handle ANY
      endhandle
    endif
    if (!!ce.type eq 'SBFI') then
      -- It must be a SBFI
      goto cref
      var !delpos tpos wrt /*
      goto tref
      delpos $!delpos wrt /*
      handle ANY
      endhandle
    endif

    !!mdsReposTail(!attaRef,!defaulttpos)

    label /exit
    -- Restore the previous state of the pins
    !!mdspoppin(1)
    !!mdspoppin(2)
    !!mdspoppin(6)
  elsehandle ANY
  endhandle
  !!ce = !ce

endfunction
