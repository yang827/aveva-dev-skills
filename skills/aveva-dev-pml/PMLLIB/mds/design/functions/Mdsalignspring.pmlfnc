--
-- File:		MdsalignSpring.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:	        Thurs 21st May 1998	
--
--
-- Description:
-- Function to Align Spring Atta to the Bottom of the Associated Support Atta.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function
  define function !!MdsalignSpring(!Form is form, !Atta is DBref)

------------------------------------
  !currentunits = !!kgetsetunits()
------------------------------------

  !Refe = !!CE

--------------------------------------------------------------------------------
-- Check that passed Element is an ATTA
    if (!Atta.type.string().neq('ATTA')) then
      !!alert.error('Current Element MUST be a Support ATTA')
      !!kRestoreUnits(!currentunits)
      return
    endif

--------------------------------------------------------------------------------
-- Check that passed ATTA Element is a Support ATTA

    if (!Atta.spref.name.match('/MDS').eq(0)) then
      !!alert.error('Current Element MUST be a Support ATTA')
      !!kRestoreUnits(!currentunits)
      return
    endif

--------------------------------------------------------------------------------
-- Check that Current Support ATTA has a valid :MDSGuideRef Reference
--xxx    if (!!ce.:guide.unset() or (!!ce.:guide.string().lowcase().eq('unset')) ) then
    if (!Atta.:MDSGuideRef.unset() or !Atta.:MDSGuideRef.badref()) then
      !!alert.error('Current Support ATTA does not have a Valid Support Reference')
      !!kRestoreUnits(!currentunits)
      return
    endif

    !gdbref = !Atta.:MDSGuideRef
    handle any
      !!alert.error('Current Support ATTA does not have a Valid Support Reference')
      !!kRestoreUnits(!currentunits)
      return
    endhandle

-- Support Atta is 'referencing' an Unknown Guide Atta
    !!ce = !gdbref
    handle any
      !!alert.error('Current Support ATTA does not have a Valid Support Reference')
      !!kRestoreUnits(!currentunits)
      return
    endhandle

--------------------------------------------------------------------------------
-- Everything appears to be OK, therefore:
-- Align the Guide to the Bottom of the Associated Support

-- at supported atta (at10/11)

   if(!!CE.stype.match('B').neq(0)) then

      !Offset = despar[1] + param[2] / 2
   else
      !Offset = despar[1] + despar[2]

   endif
   !!CE = !Atta

   if(!Atta.Stype.match('SP02').neq(0)) then
    despar n 6 $!Offset
     handle ANY
     endhandle
    !TrunDia = !Atta.:MDSGuideRef.para[5]
    handle any
    -- SP02 don't use DEsp7 or have a :MDSGuideRef
    elsehandle none
        despar n 7 $!TrunDia
    endhandle
   else
    despar n 5 $!Offset
     handle ANY
     endhandle
   endif

   !!CE = !Refe

   !!kRestoreUnits(!currentunits)

  endfunction
-- End function

-- End of file MdsalignSpring.pml
