--
-- File:  Mdsalignsunit.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  30 Thu Apr 1998
--
--
-- Description:
-- Align slip with shoe (and set despar for height)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsAlignSUnit(!form is FORM)

  ------------------------------------
  !currentunits = !!kgetsetunits()
  ------------------------------------

  -- Force into forwards mode
  FORWARDS

  !refe = !!ce

  -- function run from SU01/02 form

  if(!form.unset().not()) then
    !!ce = !form.support.datum
    !slip = !!ce
    !atta = !slip.:MDSGuideRef
    -- function run to set height or default of shoe
  else
    !slip = !refe.:MDSGuideRef
    if(!slip.eq(nulref)) then
      !!kRestoreUnits(!currentunits)
      return
    endif
    !atta = !!ce
  endif

  -- Get shoe height stored in prop hei
  -- For su03 and su04 also get length in prop len and width in prop fwid
  !!ce = !atta
  !tempDesPar1 = prop hei
  handle any
    !tempDesPar1 = prop hei of :MDSGuideRef
  endhandle
  !despar1 = !tempDesPar1.real()
  if !slip.stype.eq('SU03') or !slip.stype.eq('SU04') then
    !tempDesPar2 = prop len
    handle any
      !tempDesPar2 = prop len of :MDSGuideRef
    endhandle
    !despar2 = !tempDesPar2.real()

    !tempDesPar3 = prop fwid
    handle any
      !tempDesPar3 = prop fwid of :MDSGuideRef
      handle ANY
        !tempDesPar3 = prop Bwid
        handle ANY
          !tempDesPar3 = prop bwid of :MDSGuideRef
        endhandle
      endhandle
    endhandle
    !despar3 = !tempDesPar3.real()
  elseif !slip.stype.eq('AT30') then
    !tempDesPar2 = prop fwid
    handle any
      !tempDesPar2 = prop fwid of :MDSGuideRef
    endhandle
    !despar2 = !tempDesPar2.real()
  endif

  -- Position the atta


  !!ce = !slip
  desp n1 $!despar1
  if !slip.stype.eq('SU03') or !slip.stype.eq('SU04') then
    desp n1 $!despar1
    Despar n2  $!despar2
    Despar n3  $!despar3
  elseif !slip.stype.eq('AT30') then
    Despar n1  $!despar1
    Despar n2  $!despar2
  endif
  POS AT $!atta
  ori and p3 is p3 of $!atta
  handle any
    ori p3 is p3 of $!atta
  endhandle

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  !!ce = !refe

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
