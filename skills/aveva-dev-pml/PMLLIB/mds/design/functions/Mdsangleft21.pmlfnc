--
-- File:		Mdsangleft21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS130
--
-- Author:		Wayne Dodwell
-- Created:		Monday 3rd November 1997
--
--
-- Description:
-- function to Check angle of Rotation for Framework Type 'FT21'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      RW        form
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsangleft21(!form is FORM)

-- Initialise variables
    !support = !form.support
    !origin  = !!ce

-- If more than ONE Support Atta on *-BAR-1
-- Angle may ONLY be '180'
    if (!support.bars[1].size().gt(1) ) then

      if (!!Mdsft21.rotan.val.real() neq 180) then
        if (!!Mdsft21.rotan.val.real() neq 0) then
          !!alert.message('Angle of Rotation  may ONLY be 180 degrees if more than ONE Pipe is being supported on the Cross Bar')
          !!Mdsft21.rotan.val = '0'
          return
        endif
      endif

-- If Only ONE atta is currently on Cross Bar the Angle of Rotation may be '0' to '180'

    endif

    !!ce = !origin

-- Update support data held in form
    !!Mdsft21.support = !support

-- End function
endfunction

-- End of file Mdsangleft21.pml
