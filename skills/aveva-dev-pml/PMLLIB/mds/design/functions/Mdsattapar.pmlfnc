--
-- File:  Mdsattapar.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:         Monday 9th February 1998
--
--
-- Description:
-- Function to Reset an Individual Support Atta's Design Parameters back to Default,
-- BUT maintain the values of the USER DEFINED Design Parameters for the Support Atta
-- ie: 'HEI', 'LEN', 'WID', 'CLR', 'OVER' and 'SDIS' Properties of the Atta's DATASET.
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function
define function !!mdsattapar()

  !currentunits = !!kgetsetunits()

  --------------------------------------------------------------------------------
  -- Check that Current Element is an ATTA
  if (!!ce.type.string().neq('ATTA')) then
    !!alert.error('Current Element MUST be a Support ATTA')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Check that Current Element has a valid Support ATTA Spec. Ref.
  if (!!ce.spref.badref()) then
    !!alert.error('Current Element MUST be a Support ATTA')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Check that Current ATTA Element is a Support ATTA
  !spec = (purp of spec of spref)
  if (!spec neq |MDS|) then
    !!alert.error('Current Element MUST be a Support ATTA')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Everything appears to be OK for the Current Support Atta therefore:
  -- Reset DESPARS to DEFAULT but Maintain Original VALUES of User Defined DESPARS
  --------------------------------------------------------------------------------

  if (!!alert.confirm('Are you sure you want to set the Support Atta to it''s DEFAULT parameters?') eq 'YES') then
    -- Save Existing Despar Values of Current Support Atta into an Array
    !currentunits = !!kgetsetunits()
    !atta   = !!ce
    !values = despar

    -- Now Determine which Despar Numbers are allowed to be User Defined and RESET
    -- them to their Original Values saved in the despar array '!values' set above

    !array = ARRAY()

    !hei  = !!mdsgetdesp('HEI')
    handle none
      !array.append(!hei)
    elsehandle any
    endhandle

    !wid  = !!mdsgetdesp('WID')
    handle none
      !array.append(!wid)
    elsehandle any
    endhandle

    !len  = !!mdsgetdesp('LEN')
    handle none
      !array.append(!len)
    elsehandle any
    endhandle

    !clr  = !!mdsgetdesp('CLR')
    handle none
      !array.append(!clr)
    elsehandle any
    endhandle

    !over = !!mdsgetdesp('OVER')
    handle none
      !array.append(!over)
    elsehandle any
    endhandle

    !sdis = !!mdsgetdesp('SDIS')
    handle none
      !array.append(!sdis)
    elsehandle any
    endhandle

    -- Reset Despar Values to the DEFAULTS already Loaded into the MDS Application
    !!mdssetdespars(!atta)

    -- Reset Despar Values to MAINTAIN the Original Values for the USER DEFINED Despars
    do !index values !array
      skip if (!index eq 0)
      despar numb $!index  $!values[$!index]
    enddo

    -- Reset Units
    !!kRestoreUnits(!currentunits)

    -- Navigate Back to Original Atta
    !!ce = !atta

  endif

endfunction
