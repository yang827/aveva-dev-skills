--
-- File:  Mdsattavt04.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Thursday 15th January 1998
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING        Name of Gadget on the form 'MdsMODAT'
--
--     2      R         FORM         Form where 'MdsMODAT' form is called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsattavt04(!gname is STRING,!form is FORM)

  --------------------------------------------------------------------------------
  -- Initialise variables
  !support   = !form.support
  !gadget    = '!!mdsmodat.' & '$!gname'
  !atta      = !support.atta
  !origin    = !!ce

  --------------------------------------------------------------------------------
  -- Ensure all the Attas on the Support have the SAME Dimensions and SPREF
  -- For Ancillaries at the SAME Position as the DATUM ATTA (ie: Support Type 'vt04')

  -- Get the Relavent Despar Number to Adjust on the Current Atta in the 'do' loop below
  !!ce = !!mdsmodat.atta
  if (!gname eq 'HEIGHT') then
    !dpnum = !!mdsgetdesp('HEI')
  elseif (!gname eq 'LENGTH') then
    !dpnum = !!mdsgetdesp('LEN')
  elseif (!gname eq 'THICKNESS') then
    !dpnum = !!mdsgetdesp('THK')
  endif

  do !numb index !atta
    !!ce = !atta[!numb]
    skip if (!atta[!numb].name.match('/SREF') gt 1)

    -- Reselect SPREF of Current Atta to Correspond with the SELECETED
    -- Atta from the form gadget "Mdsancill.standard.selection('rtext')"
    !selection = !!mdsancill.standard.selection('rtext')
    sel with stype '$!selection' spec /MDS

    -- Set the Despar !dpnum for the current atta
    !!mdssetdespar(!atta[!numb],!dpnum,$!<gadget>.val)
  enddo

  --------------------------------------------------------------------------------
  !!ce = !support.datum

  --------------------------------------------------------------------------------
  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!form.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !form.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  !!ce = !origin
  --------------------------------------------------------------------------------

endfunction
