--
-- File:		Mdsautopar.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Tue Oct 28th 1997
--
--
-- Description:
-- Function to reload support design defaults and parameters
-- BUT only if associated file's date&time stamp has changed
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsAutoPar()
clock init
--------------------------------------------------------------------------------
  -- check if defaults file date&time stamp has changed
  var !FileDtm FILE /$!!MDSFILES.DESCRIPTION DTM
  handle any
    !!Alert.error('File $!!MDSFILES.DESCRIPTION could not be found in the project defaults directory. Pleas contact your PDMS Administrator')
    return error 1 || noalert
  endhandle
  -- check that date&time stamp global is defined
  if (Defined(!!MdsDefFileDate)) then
    if (!FileDtm neq !!MdsDefFileDate) then
      -- reload the support defaults for the ancillary system form
      -- if we are in DESIGN (this function can also be called from PARAGON!)
      var !Banner BANNER
      if (!Banner.upcase().Match('DESIGN') neq 0) or (!Banner.upcase().Match('OUTFITTING') neq 0) then
        call !!MdsIAllAncill()
-- Reload the support defaults for the Trunnion system form
--xxx $P Reloading Trunnions ** 1 **
--xxx--xxx        call !!Mdsitrunn()
--<wd>feb2006-<mds12>
      call !!Mdsitrunnions()
        -- store the latest date&time stamp
        !!MdsDefFileDate = !FileDtm
        Prompt Dismiss
      endif
    endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  else
    -- Load/Reload the support defaults for the ancillary system form
    -- if we are in DESIGN (this function can also be called from PARAGON!)
    var !Banner BANNER
    if (!Banner.upcase().Match('DESIGN') neq 0) or (!Banner.upcase().Match('OUTFITTING') neq 0) then
--xxx      prompt 'Loading Support Defaults...'
--xxx      $P Loading Support Defaults...

      -- if (!!kppdmstime) then
        -- call !!kwritetimes('APPEND','JBSUPP','Mdsiallancill')
      -- endif

      call !!MdsIAllAncill()

      -- if (!!kppdmstime) then
        -- call !!kwritetimes('CLOSE','JBSUPP','Mdsiallancill')
      -- endif

-- Reload the support defaults for the Trunnion system form
--xxx $P Reloading Trunnions ** 2 **
--xxx      call !!Mdsitrunn()

      -- if (!!kppdmstime) then
        -- call !!kwritetimes('APPEND','JBSUPP','Mdsitrunnions')
      -- endif

--<wd>feb2006-<mds12>
      call !!Mdsitrunnions()

      -- if (!!kppdmstime) then
        -- call !!kwritetimes('CLOSE','JBSUPP','Mdsitrunnions')
      -- endif

--------------------------------------------------------------------------------
--xxx-- Uncomment the TWO lines below if automatic UPDATES are REQUIRED
--xxx      -- store the latest date&time stamp
--xxx      !!MdsDefFileDate = !FileDtm
--------------------------------------------------------------------------------
--xxx      Prompt Dismiss
   endif
  endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

  -- check if parameters file date&time stamp has changed
  var !FileDtm FILE /$!!MdsFiles.Dimension DTM
  handle any
    !!Alert.error('File $!!MdsFiles.Dimension could not be found in the project defaults directory. Pleas contact your PDMS Administrator')
    return error 1 || noalert
  endhandle
--------------------------------------------------------------------------------
  -- check that date&time stamp global is defined
  if (Defined(!!MdsParFileDate)) then
    if (!FileDtm neq !!MdsParFileDate) then
      -- reload the support parameters
      if (!!MdsParFileDate eq '') then
        $p Loading Support Parameters...
        !Prompt = 'Loading Support Parameters...'
      else
        $p Reloading Support Parameters as date&time stamp has changed...
        !Prompt = 'Reloading Support Parameters as date&time stamp has changed...'
      endif
--<wd>feb2006-<mds12>
      call !!MdsReadPars(!Prompt,'FULL')
      -- store the latest date&time stamp
      !!MdsParFileDate = !FileDtm
      Prompt Dismiss
    endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  else
    -- load the support parameters
--xxx    $p Loading Support Parameters...
    !Prompt = 'Loading Support Parameters...'
--xxx$P Loading Support Parameters...

    -- if (!banner.match('DESIGN').gt(0)) then
      -- if (!!kppdmstime) then
        -- call !!kwritetimes('APPEND','JBSUPP','Mdsreadpars')
      -- endif
    -- endif

--<wd>feb2006-<mds12>
    call !!MdsReadPars(!Prompt,'FULL')

    -- if (!banner.match('DESIGN').gt(0)) then
      -- if (!!kppdmstime) then
        -- call !!kwritetimes('CLOSE','JBSUPP','Mdsreadpars')
      -- endif
    -- endif

--------------------------------------------------------------------------------
-- Uncomment the TWO lines below if automatic UPDATES are REQUIRED
--xxx    -- store the latest date&time stamp
--xxx    !!MdsParFileDate = !FileDtm
--------------------------------------------------------------------------------
--xxx    Prompt Dismiss
  endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
