--
-- File:		MdsBeamCentre.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 15th Apr 1998
--
--
-- Description:
-- function to find the midline of a beam regardless of the NA
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1    [R]      [DBREF]       [Beam DBref]
-- Return:
--    [Data Type]   [Description]
--
--    [POSITION]        [pos of the beam volume centre ]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsBeamCentre(!Beam is dbref) is position

   !Refe = !!CE

-- GE 07/04/05 Test to see if the last element was a stop being aligned to a beam
   !ST = same
   if !ST.set() then
    if !ST.type.eq('ATTA') and !ST.spref.name.matchwild('*ST*') then
     same
    endif
   endif
-- End of fix

   !Type = !!CE

   !!CE = !Beam
   !POSS = !Beam.PosS.wrt(worl)
   !POSE = !Beam.PosE.wrt(worl)

-- Get box point extremities (new pml "!vol = lvol wrt ce" does not work)

   var !Dumvol lvol wrt ce
   !VolPoints = !Dumvol.split()

-- put pins at points so geometric calculator can find line wrt world

--<wd>oct2004
--*** IMPORTANT NOTE ***--
-- Pins 1 and 2 have been repositioned to account for the Z dir of a SCTN always along its LENGTH
-- The pseudo attribute 'var !Dumvol LVOL wrt ce' at a SCTN uses the JUSL attribute as the ORIGIN of the SCTN,
-- in this case the JUSL attrib is set to TOS, and returns a string in the variable !Dumvol e.g -->
-- <STRING> '-82 -303 0 83 0 6000' --(These figures INCLUDE the GEOMETRY for any SCTN members e.g. SNODES & SJOIS)--
-- which normally means the LOCAL VOLUME of the SCTN is--> From 'E-82 N-303 U0' To 'E83 NO U6000'
--** HOWEVER **--
-- To get Pin 1 and Pin 2 in the CORRECT positions (i.e. the FROM and TO positions of the LVOL LIMITS BOX of the SCTN)
-- The SIX indices in the resulting array variable--> !VolPoints = !Dumvol.split() have to be manipulated as shown
-- in the code shown below, i.e. WRT the SCTN owner's ORIENTATION so that the NORTHING and UPPING values are swapped
-- in BOTH of the FROM and TO values to position Pin 1 and Pin2.
--<wd>oct2004
--------------------------------------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------------------------------------

-- Put pins at points so geometric calculator can find line wrt worl
--<ge>apr2005 STOP's were not being positioned

  if !Type.spref.name.matchwild('*ST*') then
   pin 1 at e$!VolPoints[1] n$!VolPoints[2] u$!VolPoints[3] wrt ce
   -- This was before WD pin 1 at e$!VolPoints[1] n$!VolPoints[2] u$!VolPoints[3]
   -- orig WD pin 1 at e$!VolPoints[1] n$!VolPoints[3] u$!VolPoints[2] wrt ce
   pin 2 at e$!VolPoints[4] n$!VolPoints[5] u$!VolPoints[6] wrt ce
   -- This was before WD pin 2 at e$!VolPoints[4] n$!VolPoints[5] u$!VolPoints[6] wrt ce
   -- orig WD pin 2 at e$!VolPoints[4] n$!VolPoints[6] u$!VolPoints[5] wrt ce
  else
   pin 1 at e$!VolPoints[1] n$!VolPoints[3] u$!VolPoints[2] wrt ce
   pin 2 at e$!VolPoints[4] n$!VolPoints[6] u$!VolPoints[5] wrt ce
  endif

--<ge>apr2005
-------------------------------------------------------------------------------

   var !VolLine const line join pin 1 to pin 2
   var !SctnLine const line join $!POSS to $!POSE
       !Midp = der midp wrt worl

       !BeamDir = !Beam.ori.zdir().wrt(worl)
   var !plane const plane $!beamdir thro $!midp

   var !Centre const pos inter $!VolLine $!Plane

  -- dont need this cos guide assumes the beam is normal to the pipe cl
   -- var !Line const line para $!sctnline thro $!centre

-- reset the pins
  -- !!MdsResetPins(1,2)

   Return !Centre.position()
   !!CE = !Refe
  endfunction
-- End function

-- End of file MdsBeamCentre.pml
