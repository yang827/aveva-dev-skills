--
-- File:    Mdscanceldflt.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDEFCAN
--
-- Author:    I.Osborne
-- Created:   Fri May 16
--
--
-- Description:
-- Cancel default site creation form and swap main menu
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscanceldflt()

-- Initialise variables
    !site = !!mdsoptions.site.val

-- Check if USER has SELECTED a MDS FRAMEWORK creation site
    if(!site.upcase() eq |NOT SET| or !site eq ||)then

--<wd>11oct2006--<mds12>
      if (!!alert.confirm('No default MDS FRAMEWORK creation site selected. Do you want to ABORT entry to the MDS application').eq('YES')) then
-- RETURN to the PDMS GENERAL Application
--<wd>11oct2006--<mds12>

--<wd>--feb2006--<mds12>
      --$M/%PDMSUI%/CLIB/FILES/UFORMS MAIN _CDSYSTEM
        !!appxload('DES','GEN', FALSE)
--<wd>--feb2006--<mds12>

--<wd>11oct2006--<mds12>
        --!!alert.error('No default creation site selected. ABORTING entry to the MDS application')
        --return

      else
-- Ensure that the 'picked' default MDS FRAMEWORK creation site is set in the !!mdsoptions form
        if (!!mdsdefaultsite.site.pickedfield.gt(0)) then
           !!mdsoptions.site.val =  '/' & !!mdsdefaultsite.site.rtext[!!mdsdefaultsite.site.pickedfield]
           !!alert.message('The default MDS FRAMEWORK creation site $!!mdsoptions.site.val has been selected.')
        else
           show !!mdsdefaultsite
        endif
      endif
--<wd>11oct2006--<mds12>

    endif

-- End function
endfunction
