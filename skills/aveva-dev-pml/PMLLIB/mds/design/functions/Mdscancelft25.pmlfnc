--
-- File:		Mdscancelft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 1st December 1997
--
--
-- Description:
-- Cancel support creation form FT25 when called from a 'foreign'
-- Framework Type eg. 'FT18'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of support form to be cancelled
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- define function
  define function !!Mdscancelft25(!Form is FORM)


-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()



-- Initialise variables
    !attaname = !!Mdsft25.name.val
    !repack   = !!Mdsft25.ppack

--------------------------------------------------------------------

-- Test Decision
    if (!!Mdsft25.ok.active) then
      if (!!alert.confirm(|Ok to cancel Packing Piece for atta "$!attaname"?  -  This will reset the Packing Piece data etc.|) eq 'NO')then
        !!kRestoreUnits(!currentunits)
        return
      endif

-- Delete Packing Piece and Reset its Data to when the form was
-- Initialised for its Associated Atta .
      !!ce = !attaname.dbref().:MDSPackRef
      delete sctn


-- Regenerate Original Packing Pieces after Original Support Regenerated
      do !indx index !repack
       $!repack[$!indx]
      enddo

    endif

--------------------------------------------------------------------

-- Clear Stored data from Form Member .Ppack
    !!Mdsft25.ppack.clear()
-- Reset to the DEFAULT Callback for the !!Mdsft25.create button
    !!Mdsft25.create.callback = |call !!Mdscreateft25()|

-- Hide Form
    !!Mdsft25.hide()


-- Reset Units

   !!kRestoreUnits(!currentunits)


-- End function
  endfunction

-- End of file Mdscancelft25.pml
