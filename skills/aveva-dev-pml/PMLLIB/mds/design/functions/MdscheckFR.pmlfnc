--
-- File:		MdscheckFR.pmlnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		T.Martin
-- Created:		26/01/2004 11:59
--
--
-- Description:
-- Function to check the maximun length stored in the template is not
-- exceeded
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckFR(!Form is FORM)

  -- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()
    units mm dist mm bore

    !Origin    = !!CE
    !!MdsCheckLen.ok.active = true
    !Errors      = 0
    !Warnings    = 0
    !Messages    = 0

  -- Move to structure

    !!CE = !Form.Support.Stru
    !type = !!CE.:MDSSuppType

-------------------------------
--> Modified - <wd> - 11sep1998
    if (!!ce.type.eq('STRU')) then
      !mdschk = !!ce.:mdscheck
      if (!mdschk) then
        !errorflag = 'Error'
      else
        !errorflag = 'Warning'
      endif
    endif
--< Modified - <wd> - 11sep1998
-------------------------------

  -- Collect sctns for overlength sizes check

    !Verticals = !!KCollectAllFor(|SCTN|, '(MATCHWILD(NAME,|*-V*|))', CE)
    !CrossBars = !!KCollectAllFor(|SCTN|, '(MATCHWILD(NAME,|*-BAR-*|))', CE)

    !Bars = Array()
    !Bars.appendarray(!Verticals)
    !Bars.appendarray(!CrossBars)
    !Error = ARRAY()

    !!MdsCheckLen.ErrorList.Clear()

     -- check support connection
     !name = !form.name.val
     if !name.match('/').neq(1) then
        !name = '/' & !name
     endif
     !!ce = $!<name>-V1
     if !form eq !!mdsfr01 or !form eq !!mdsfr01 then
        -- check the top or bottom bracket
        -- check the brackets for clashes
     elseif !form eq !!mdsfr04 then
        -- check the top and bottom brackets
        -- check the brackets for clashes
     elseif !form eq !!mdsfr03 then
        -- check the fitting against the side plate
        -- check bracket within the connection
     endif



  -- Check to see if any of the cross bars exceed the maximun length
  -- as defined by the template design parameters which are stored in mm
  -- but want displaying in the project units
  do !check1 index !Bars
      !!CE = !Bars[$!check1]

      -- check bar lengths
      -- check if they are on the trays

  enddo


    -- Clean any bad refernce from the attaref attribute
    !CleanedList = array()
    do !clean values !Associated
        !!CE = !Clean
        handle none
          !CleanedList.append(!Clean)
        elsehandle any
          skip
        endhandle
    enddo

-------------------------------------------***** connexions *****------------------------------

-- initialise variables

    !ODesc = array()
    !ADesc = array()

-- run function to check joints are valid against the spec.

    !JointTest = !!MdsJointInvalid(!Form.support.Joints,!Odesc,!Adesc)

    !Adesc.compress()
    !ODesc.compress()

    if(!JointTest.unset().not()) then
       !Errors = !Errors +  !ODesc.size() + !ADesc.size()
       !Error.append(|**    Connections Error    ** |)
       !Error.appendarray(!Odesc)
       !Error.appendarray(!Adesc)
       !Error.append(|--------------------------------------------------------------------------------|)
       !!Mdschecklen.ok.active = false
    endif


--------------------------------------------------------------------------------------------------------------
-- run function to check whether joint is over (or under) connecting sctn..
-- initialise variables

    !jdesc = array()
    !JointPos = !!MdsCheckJntPos(!Form.support.Joints, !jdesc)

-- Check if the Connected EXTERNAL joints offset does not EXCEED the Default value of the
-- ALLOWABLE Joint Offset set in the !!MdsOPTIONS.OFFSET gadget on the MDS default settings form.

    !joints = !jdesc.size()
    !jerror = false
    !indx   = 1

    do !jnum from 1 to !joints
      if (!jnum.eq(1)) then
        !indx = 1
      else
        !indx = !indx + 3
      endif
      if(!JointPos[!indx].not()) then
        !Errors = !Errors + 1
        if (!jerror.not()) then
          !Error.append(|**    Connections Error    ** |)
          !Error.append(|Joint(s) NOT within the allowable offset|)
          !Error.append(|with the attached support steel section.|)
          !jerror = true
        endif

        if (!jerror) then
          !cnt2 = !indx + 1
          !cnt3 = !indx + 2

          !Error.append(|-- Error --|)
          !jtext = !jdesc[!jnum].after('"').before('"')
          !Error.append(|Joint Name                 = $!jtext|)
          !!Kformattext.text.val = !jointpos[!cnt2]
          !actualoffset = !jointpos[!cnt2].string(!!distancefmt)
          !Error.append(|Actual Offset              = $!actualoffset|)
          !!KFormatText.Text.Val = !jointpos[!cnt3]
          !allowoffset = !jointpos[!cnt3].string(!!distancefmt)
          !Error.append(|Maximum Allowable Offset   = $!allowoffset|)
        endif
      endif
    enddo

    if (!jerror) then
      !Error.append(|--------------------------------------------------------------------------------|)
      !!Mdschecklen.ok.active = false
    endif

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

--xxx  !!MdsCheckLen.Summary.Val = 'Errors = $!Errors,   Warnings = $!Warnings,   Messages = $!Messages'
--xxx
--xxx  !Error.append('Summary')
--xxx  !Error.append('-------')

  if (!Errors + !Warnings + !Messages eq 0) then
    !Error.append(' ')
    !Error.append('No problems found with this support')
    !Error.append(' ')
  else
-- Output Data for Support Sections with NO Problems, BUT Only if NO Other Errors/Warnings/Messages exist

    do !cbar values !bars
      !sctnmess = false
      !!ce = !cbar
      !memname = !!ce.name

      do !xerr values !error
        if (!xerr.match('Section Name').gt(0) and !xerr.string().match(!memname).gt(0)) then
-- Error for Support Section already exists
          !sctnmess = false
          break
        elseif (!xerr.match('Section Name').gt(0)) then
-- Check if the text 'Section Name' exists in the Error message
          if (!xerr.string().match(!memname).gt(0)) then
-- Check if the name of the Support Section '!memname' exists in the Error message
            skip
          else
-- Set to 'true' to Output Error for the Current Support Section as NO other Error message exists
            !sctnmess = true
          endif
        else
-- Ignore Any Other Error message
          skip
        endif
      enddo

      if (!sctnmess) then
        !error.append(|**   Message   ** - No problems with this Support Section|)
        !error.append(|Section Name               = $!memname|)
        !error.append(||)
        !error.append(|--------------------------------------------------------------------------------|)
        !messages = !messages + 1
      endif

    enddo

  endif

  !!MdsCheckLen.Summary.Val = 'Errors = $!Errors,   Warnings = $!Warnings,   Messages = $!Messages'

  !Error.append('Summary')
  !Error.append('-------')

  !Error.append('Errors      = $!Errors')
  !Error.append('Warnings    = $!Warnings')
  !Error.append('Messages    = $!Messages')
  !Error.append(' ')
  !Error.append('End of Report')
  !Error.append('-------------')

  !!MdsResetPins(7,9)

  !!kRestoreUnits(!currentunits)


  !!MdsCheckLen.ErrorList.Dtext = !Error

  -- Set paragraph gadget

  !!MdsCheckLen.Name.val = !Form.Support.Stru.Namn

  waiton !!MdsCheckLen
  !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdschecklen.pml
