--
-- File:		Mdscheckang.pml
-- Type:		Function Definition
-- Group:		Multi Discipline Supports Application
-- Keyword:		MDS
-- Module:		design
-- Replaces:
--
-- Author:		Neale Morris
-- Created:		Wed Nov 26
--
--
-- Description:         Function to test the horizontal angle
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBRef        Datum Atta
--     2     R        DBRef        Identified element
-- Return:
--    [Data Type]   [Description]
--     Boolean       Returns true if angle has been approved
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdscheckang(!Datum is dbref,!Identified is dbref) is boolean

  !!CE = !Datum
  !DatumPldir = pl dir wrt world of $!Datum
  !!CE = !Identified
  !IdentifiedPldir = pl dir wrt world of $!Identified
    handle (2,201) (2,252)
      !IdentifiedPldir = ph dir wrt world of $!Identified
    endhandle

  var !datline const line $!DatumPldir thro pl of $!Datum.name
  var !atline  const line $!IdentifiedPldir thro pl of $!Identified.name
    handle (2,252)
      var !atline const line $!Identifiedpldir thro ph
    endhandle
  var !ndat const line project $!datline on plane u wrt /* thro e0n0u0 wrt /*

 var !nat const line project $!atline on plane u wrt /* thro e0n0u0 wrt /*
  var !angle const angle $!ndat $!nat
  handle any
-- put this in to test for vertical pipes, because they cannot be
-- projected onto an u plane, and give a null string
   return true
  endhandle


  if (!Angle.real() lt 90) then
    !Hang = !angle.real()
  elseif (!Angle.real().between(135,180)) then
    !Hang = !angle.real() - 180
  else
    !Hang = !angle.real() - 90
  endif

  if (!Hang.real().abs() eq 0) then
    return true
  elseif (!Hang.real().abs() gt 0 and !Hang.real().abs() le 3)  then
    return true
  elseif (!Hang.real().abs() gt 0 and !Hang.real().abs() le !!MdsOptions.Maxang) then
    !DispHang = !Hang.real().abs()
    if (!!Alert.confirm('Horizontal angle of identified pipe is $!DispHang degrees. Are you sure you want to add this pipe to the support?') eq 'NO')then
       return false
    else
       return true
    endif
  else
    !DispHang = !Hang.real().abs()
    !!alert.error ('Unable to add the identified pipe as the horizontal angle is greater than $!!MdsOptions.Maxang degrees. (Actual Angle = $!DispHang)')
    return false
  endif

-- End function
endfunction

-- End of file Mdscheckang.pml
