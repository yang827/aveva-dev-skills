--
-- File:		Mdscheckatta.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MCHECKP
--
-- Author:		I.Osborne
-- Created:		Thu May 22
--
--
-- Description:
-- function to check if pipe hvac or rack is already being supported
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckAtta(!Form is FORM) is BOOLEAN

  -- Initialise variables
    !Attas = !Form.Support.Atta
    !Bran  = !!CE.owner

  -- Make sure all reference are valid
    !Counter = 1
    !NewList = ARRAY()
    do !CheckValid values !Attas
      !Test = !Checkvalid.name
        handle NONE
          !NewList.append(!CheckValid)
        elsehandle ANY
        endhandle
      !Counter = !Counter + 1
    enddo
    !Attas = !NewList


  -- Get branches for all currently supported elements
    !Block = object block ('!Attas[!EvalIndex].owner')
    !Branches = !Attas.evaluate(!Block)
    !Branches.unique()

  -- Check current branch against existing supported branches
    !Position = !Branches.findfirst(!Bran)

    if (!Position.set())then
      return TRUE
    else
      return FALSE
    endif

-- End function
endfunction

-- End of file Mdscheckatta.pml
