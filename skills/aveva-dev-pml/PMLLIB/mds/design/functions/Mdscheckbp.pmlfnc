--
-- File:  Mdscheckbp.pmlfnc
-- Type:  Function Definition
-- Group:  Multi Discipline Supports Application
-- Keyword:  MDS
-- Module:  design
-- Replaces:
--
-- Author:  Neale Morris
-- Created:  Thursday 26th Feb 2004
--
--
-- Description:         Function to test if a baseplate has differnt lengths and widths
--                      therefore requiring a guideref to need adjustment
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBRef        Datum Atta
-- Return:
--    [Data Type]   [Description]
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscheckbp(!datum is DBREF)

  -- List of attas that need checking

  if not (!!ce.styp inset('GT12A','GT12B','GT11','ST07','ST08','AN05')) then
    return
  endif

  -- Goto passed element

  !!ce = !datum

  -- Does the passed elemnt have a reference to a baseplate

  if !!ce.:MdsGuideRef.badref() then
    return
  endif

  -- Is the :MdsGuideRef a baseplate (this will be a plat element)

  if !!ce.:MdsGuideRef.type.eq('PLAT').not() then
    return
  endif

  -- Does the baseplate have differnt lengths/widths

  !pWid = ( prop PWID of :MdsGuideRef )
  !pLen = ( prop PLEN of :MdsGuideRef )
  if !pWid.eq(!pLen) then
    return
  endif

  -- OK we need to change the size

  if !!ce.styp.eq('ST07') then

    -- ST07, swap desp1 and 2

    !despars = despar
    despar n1 $!despars[2]
    despar n2 $!despars[1]

  elseif !!ce.styp.eq('ST08') then

    -- ST08, swap desp3 and 4

    !despars = despar
    despar n3 $!despars[4]
    despar n4 $!despars[3]

  elseif !!ce.styp.eq('AN05') then

    -- AN05, swap desp3 and 4

    !despars = despar
    despar n3 $!despars[4]
    despar n4 $!despars[3]


  else

    -- Not ST07

    !property = 'BPWD'
    !bpwd = ( prop $!property )
    handle ANY
      !bpwd = ( prop PLEN )
      !property = 'PLEN'
    endhandle
    !dtre = dtre
    var !dataSetElements coll all data for $!dtre
    var !dkeys eval dkey for all from !dataSetElements ignore ANY
    !desp = !dkeys.findfirst('$!property')
    !despNum = num of $!dataSetElements[$!desp]
    if !desp.unset() then
      return
    else
      if !bpwd.eq(!pLen) then
        despar n$!despNum  $!pWid
      else
        despar n$!despNum  $!pLen
      endif
    endif

  endif

endfunction
