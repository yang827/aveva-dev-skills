--
-- File:		MdsCheckConns.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Mon 29th June 1998
--
--
-- Description:
-- Function to find out what to do when the framework is connected
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM         [Form function is called from]
--     2     RW       STRING       [Error message to use.]
-- Return:
--    [Data Type]   [Description]
--     1            [whether to continue,warn or error when framework is connected]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckConns(!Form is form, !Message is String) is string

  -- Initialise Variables

      !Option  = !!Mdsoptions.ConnMods.Selection()
      !Jointed = !Form.Support.Joints

    if(!Jointed.unset()) then
       !ACTION = 'UNJOINTED'
    else
      if(!Option.eq('IGNORE')) then
         !Action = 'CONTINUE'
      elseif(!Option.eq('WARNING')) then
         !Action = 'WARNING'
         !Message = 'Support is connected and connections will be lost, do you wish to continue?'
      else
         !Action = 'ERROR'
         !Message = 'Delete connections before modifying the support.'
      endif
    endif

  Return !ACTION


-- End function
endfunction

-- End of file MdsCheckConns.pml
