-- Created:		Thur Sept 18 1997
--
--
-- Description:
-- Function to check the set design pars do not conflict with the default file
-- exceeded
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckDesp()

  -- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()
    units mm dist mm bore

    !Origin    = !!CE

    !!CE = !!MdsModAt.Atta

  -- Check to see if the atta does not agree with the min and max in the default file

  -- Check height stored in dataset with a dkey of HEI
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
    var !CheckHei (prop HEI of ce )
      handle none
        !Parvar = '!!MdsPar' & !!CE.styp
        !Bore = pa bore
        !DpNum = !!MdsGetDesp('HEI')
        !CurrVal = desp[$!Dpnum]
        !Min = $!ParVar[$!Bore].userdps[$!DpNum].min
        !Max = $!ParVar[$!Bore].userdps[$!DpNum].max
        if (!Currval.nint() lt !Min.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Min

          !currhei = !currval.string(!!distancefmt)
          !minhei  = !min.string(!!distancefmt)
          !!Alert.error(|The current height of $!currhei is less than $!minhei which the parameters file states as the minimum allowed.|)

          !!kRestoreUnits(!currentunits)
--        !!Alert.error(|The current height of $!!KFormatText.Text.val is less than $!!KFormatText.Text1.val which the parameters file states as the minimum allowed.|)
          return
        elseif (!Currval.nint() gt !Max.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Max

          !currhei = !currval.string(!!distancefmt)
          !maxhei  = !max.string(!!distancefmt)
          !!Alert.error(|The current height of $!currhei is greater than $!maxhei which the parameters file states as the maximum allowed.|)

          !!kRestoreUnits(!currentunits)
--          !!Alert.error(|The current height of $!!KFormatText.Text.val is greater than $!!KFormatText.Text1.val which the parameters file states as the maximum allowed.|)
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------
          return
        endif
      elsehandle any
      endhandle

  -- Check length stored in dataset with a dkey of LEN

----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
    var !CheckLen (prop LEN of ce )
      handle none
        !Parvar = '!!MdsPar' & !!CE.styp
        !Bore = pa bore
        !DpNum = !!MdsGetDesp('LEN')
        !CurrVal = desp[$!Dpnum]
        !Min = $!ParVar[$!Bore].userdps[$!DpNum].min
        !Max = $!ParVar[$!Bore].userdps[$!DpNum].max
        if (!Currval.nint() lt !Min.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Min

          !currlen = !currval.string(!!distancefmt)
          !minlen  = !min.string(!!distancefmt)
          !!Alert.error(|The current length of $!currlen is less than $!minlen which the parameters file states as the minimum allowed.|)

          !!kRestoreUnits(!currentunits)
--          !!Alert.error(|The current length of $!!KFormatText.Text.val is less than $!!KFormatText.Text1.val which the parameters file states as the minimum allowed.|)
          return
        elseif (!Currval.nint() gt !Max.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Max

          !currlen = !currval.string(!!distancefmt)
          !maxlen  = !max.string(!!distancefmt)
          !!Alert.error(|The current length of $!currlen is greater than $!maxlen which the parameters file states as the maximum allowed.|)

          !!kRestoreUnits(!currentunits)
--          !!Alert.error(|The current length of $!!KFormatText.Text.val is greater than $!!KFormatText.Text1.val which the parameters file states as the maximum allowed.|)
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------
          return
        endif
      elsehandle any
      endhandle

  -- Check thickness stored in dataset with a dkey of THK

----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
    var !CheckThk (prop THK of ce )
      handle none
        !Parvar = '!!MdsPar' & !!CE.styp
        !Bore = pa bore
        !DpNum = !!MdsGetDesp('THK')
        !CurrVal = desp[$!Dpnum]
        !Min = $!ParVar[$!Bore].userdps[$!DpNum].min
        !Max = $!ParVar[$!Bore].userdps[$!DpNum].max
        if (!Currval.nint() lt !Min.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Min

          !currthk = !currval.string(!!distancefmt)
          !minthk  = !min.string(!!distancefmt)
          !!Alert.error(|The current length of $!currthk is less than $!minthk which the parameters file states as the minimum allowed.|)

          !!kRestoreUnits(!currentunits)
--          !!Alert.error(|The current thickness of $!!KFormatText.Text.val is less than $!!KFormatText.Text1.val which the parameters file states as the minimum allowed.|)
          return
        elseif (!Currval.nint() gt !Max.nint()) then
--          !!kRestoreUnits(!currentunits)
          !!KFormatText.Text.val = !Currval
          !!KFormatText.Text1.val = !Min

          !currthk = !currval.string(!!distancefmt)
          !maxthk  = !max.string(!!distancefmt)
          !!Alert.error(|The current length of $!currthk is less than $!maxthk which the parameters file states as the minimum allowed.|)

          !!kRestoreUnits(!currentunits)
--          !!Alert.error(|The current thickness of $!!KFormatText.Text.val is greater than $!!KFormatText.Text1.val which the parameters file states as the maximum allowed.|)
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------
          return
        endif
      elsehandle any
      endhandle
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------
  !!kRestoreUnits(!currentunits)

  !!MdsModAt.hide()

-- End function
endfunction

-- End of file Mdschecklen.pml
