--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to check if a dimension is within the min/max value
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Qualifer 'HEIGHT' 'LENGTH' 'THICKNESS' 'STEEL'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckDim(!Form is FORM, !Dim is GADGET, !Num is REAL)

-- Initialise Variables
  !Support = !Form.support
  !CurrentUnits = !!KGetSetUnits()
  !!CE = !Support.datum

----------------------------------------------------------------
--<wd>mar2006<mds12>
  --!Bore = pa bore
--
-- Determine the MDS ANCILLARY DEFAULTS OBJECT DATA for the BORE SIZE
  !lbor = !!ce.lbor.real().value()

  !mdsattaobj  = object mdsreadparsdata()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!Support.Type, !lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
--
  --!Min = !!MdsPar$!Support.Type[$!Bore].userdps[$!Num].Min
  --!Max = !!MdsPar$!Support.Type[$!Bore].userdps[$!Num].Max
--

-- Determine the MDS ANCILLARY OBJECT USER DESPARS DATA for the BORE SIZE
  !min = !mdsattaobj.userdps[$!num].min
  !max = !mdsattaobj.userdps[$!num].max
--<wd>mar2006<mds12>
----------------------------------------------------------------

  if !Dim.val.gt(!Max) then
    !!KFormatText.Text.Val = !Max
    !Maxval = true
    !WasDim = !dim.val.string(!!distancefmt)
    !MaxDim = !Max.string(!!distancefmt)
    !!Alert.error(|Value entered ($!WasDim) is more than the maximum allowed. Setting dimension to maximum of $!MaxDim|)
    !Dim.val = !Max
  elseif !Dim.val.lt(!Min) then
    !!KFormatText.Text.Val = !Min
    !Minval = true
    !WasDim = !dim.val.string(!!distancefmt)
    !MinDim = !Min.string(!!distancefmt)
    !!Alert.error(|Value entered ($!WasDim) is less than the minimum allowed. Setting dimension to minimum of $!MinDim|)
    !Dim.val = !Min
  endif

-- Reset units back
  !!kRestoreUnits(!currentunits)

endfunction
