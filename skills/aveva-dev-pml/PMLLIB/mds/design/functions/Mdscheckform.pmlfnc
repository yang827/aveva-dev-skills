--
-- File:		Mdscheckform.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS127
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- Check to see if a form or forms are shown
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         ARRAY       List of forms that can't be shown together
--     2     R         STRING      Form that is requested to show
--     3     R         ARRAY      Description of form for error message
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckForm(!List is ARRAY,!Form is FORM,!Desc is ARRAY) is boolean

    !Counter = 0

    do !shown values !List
      !Displayed = !Shown.shown()
      !Counter = ($!Counter + 1)
      skip if (!Shown eq !Form)
      if (!Displayed) then
        !!Alert.error('The requested form cannot be shown while the $!Desc[$!Counter] form is shown')
        return true
      endif
    enddo

    return false

-- End function
endfunction

-- End of file Mdscheckform.pml
