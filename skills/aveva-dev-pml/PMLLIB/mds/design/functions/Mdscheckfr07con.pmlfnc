--
-- File:		MdscheckFR07con.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- function to check which configuration for frame type 04 is to be created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckFR07Con(!Method is string)

  -- Initialise variables
    call !!MdsResetPins(1,9)
    !Datum  = !!MdsFR07.Support.Datum
  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
    if (!!MdsFR07.Support.position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      return
    endif

  -- Navigate to Datum
  !!CE = !Datum

  call !!MdsCreateFR07(!Method)

-- End function
endfunction

-- End of file MdscheckFR07con.pml
