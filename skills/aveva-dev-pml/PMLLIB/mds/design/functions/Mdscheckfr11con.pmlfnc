--
-- File:		MdscheckFR11con.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		T.Martin
-- Created:		23/02/2004 16:40
--
--
-- Description:
-- function to check which configuration for frame type 04 is to be created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckFR11Con(!Method is string)

  -- Initialise variables
    call !!MdsResetPins(1,9)
    !Datum  = !!MdsFR11.Support.Datum
  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
    if (!!MdsFR11.Support.position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      return
    endif

   if !!mdsfr11.walloffset.val.leq(20) then
    !!alert.error('Wall offset must be Set')
    return
  endif

  -- Navigate to Datum
  !!CE = !Datum

  !!MdsFR11.Support.config = 1
  -- clear the drawing aids
  !!mdsFR11.clearaids()
  call !!MdsCreateFR11(!Method)

-- End function
endfunction

-- End of file MdscheckFR11con.pml
