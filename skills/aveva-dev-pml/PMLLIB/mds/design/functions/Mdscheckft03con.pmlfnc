--
-- File:		Mdscheckft03con.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed Jun 04
--
--
-- Description:
-- function to check which configuration for frame type 03 is to be created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckFt03Con(!Method is STRING)

  -- Initialise variables
    Call !!MdsResetPins(1,9)
    !Datum  = !!MdsFt03.Support.Datum
    !Alias  = !!MdsFt03.Support.Alias

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
    if (!!MdsFt03.Support.Position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      return
    endif

  -- If datum atta is vertical three types of support can be created
  -- 1. Vertical off the top of a member with a hori cross bar.
  -- 2. Hori off a beam with a hori cross bar
  -- 3. Hori off a column with a hori cross bar

  -- Navigate to Datum
    !!CE = !Datum

  if (!Alias eq 'FT03') then
    if (!!MdsFt03.Support.config.set())then
      Call !!MdsCreateFt03(!Method)
    else
      !PaDir = pa dir wrt world
      !PlDir = pl dir wrt world
      !P9Dir = p9 dir wrt world

      if (!PaDir eq U or !PlDir eq U)then
        if (!P9Dir eq D or !P9Dir eq D)then
          !!MdsFt03.Support.config = 1
          Call !!MdsCreateFt03(!Method)
        else
          !!MdsFt03.Method = !Method
          !!KShowForm(!!MdsFt03Configs)
        endif
      else
        !!MdsFt03.Support.config = 1
        Call !!MdsCreateFt03(!Method)
      endif
    endif
  elseif (!Alias eq 'CT02') then
    !!MdsFt03.Support.config = 1
    Call !!MdsCreateFt03(!Method)
  endif

-- End function
endfunction

-- End of file Mdscheckft03con.pml
