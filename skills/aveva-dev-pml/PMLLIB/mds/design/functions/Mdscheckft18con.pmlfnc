--
-- File:    Mdscheckft18con.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 27 August 1997
--
--
-- Description:
-- function to check which configuration for frame type 18 is to be created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCheckFt18Con(!method is STRING)

  -- Initialise variables
  Call !!mdsResetPins(1,9)
  !datum  = !!mdsFt18.support.datum
  !alias  = !!mdsFt18.support.alias

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
  if (!!mdsFt18.support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
      return
    endif

  -- Set method that is required to create standard

  !!mdsFt18.method = !method

  -- If datum atta is vertical three types of support can be created
  -- 1. Vertical off the top of a member with a hori cross bar.
  -- 2. Hori off a beam with a hori cross bar
  -- 3. Hori off a column with a hori cross bar

  -- Navigate to Datum
  !!ce = !datum

  if (!alias eq 'FT18') then
    if (!!mdsFt18.support.config.set())then
      Call !!mdsCreateFt18(!method)
    else
      !paDir = pa dir wrt world
      !plDir = pl dir wrt world
      !p9Dir = p9 dir wrt world

      if (!paDir eq U or !plDir eq U)then
        if (!p9Dir eq D or !p9Dir eq D)then
          !!mdsFt18.support.config = 1
          Call !!mdsCreateFt18(!method)
        else
          !!mdsFt18.method = !method
          !!kShowForm(!!mdsFt18Configs)
        endif
      else
        !!mdsFt18.support.config = 1
        Call !!mdsCreateFt18(!method)
      endif
    endif
  elseif (!alias eq 'CT08') then
    !!mdsFt19.support.config = 1
    Call !!mdsCreateFt18(!method)
  elseif (!alias eq 'CT11') then
    !!mdsFt19.support.config = 1
    Call !!mdsCreateFt18(!method)
    endif

-- End function
endfunction
