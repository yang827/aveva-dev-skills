--
-- File:		Mdscheckft19con.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 15 September 1997
--
--
-- Description:
-- function to check which configuration for frame type 19 is to be created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckFt19Con(!Method is STRING)

  -- Initialise variables
    Call !!MdsResetPins(1,9)
    !Datum  = !!MdsFt19.Support.Datum
    !Alias  = !!MdsFt19.Support.Alias

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Check that Datum atta has been positioned
    if (!!MdsFt19.Support.Position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      return
    endif

  -- Set method that is required to create standard

    !!MdsFt19.Method = !Method

  -- If datum atta is vertical three types of support can be created
  -- 1. Vertical off the top of a member with a hori cross bar.
  -- 2. Hori off a beam with a hori cross bar
  -- 3. Hori off a column with a hori cross bar

  -- Navigate to Datum
    !!CE = !Datum

  if (!Alias eq 'FT19') then
    if (!!MdsFt19.Support.config.set())then
      Call !!MdsCreateFt19(!Method)
    else
      !PaDir = pa dir wrt world
      !PlDir = pl dir wrt world
      !P9Dir = p9 dir wrt world

      if (!PaDir eq U or !PlDir eq U)then
        if (!P9Dir eq D or !P9Dir eq D)then
          !!MdsFt19.Support.config = 1
          Call !!MdsCreateFt19(!Method)
        else
          !!MdsFt19.Method = !Method
          !!KShowForm(!!MdsFt19Configs)
        endif
      else
        !!MdsFt19.Support.config = 1
        Call !!MdsCreateFt19(!Method)
      endif
    endif
  elseif (!Alias eq 'CT07') then
    !!MdsFt19.Support.config = 1
    Call !!MdsCreateFt19(!Method)
  elseif (!Alias eq 'CT10') then
    !!MdsFt19.Support.config = 1
    Call !!MdsCreateFt19(!Method)
  endif

-- End function
endfunction

-- End of file Mdscheckft19con.pml
