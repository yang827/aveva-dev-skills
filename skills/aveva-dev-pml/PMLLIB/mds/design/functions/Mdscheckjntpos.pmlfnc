--
-- File:    Mdscheckjntpos.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Andrew Kirkland
-- Created:   Wed 22nd July 98
--
--
-- Description:
-- Function to check the joint is on the owning sctn
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Array        [joints]
-- Return:
--    [Data Type]   [Description]
--     Boolean      [true if joints are ok]
--     ARRAY        [1] Boolean - TRUE if Joints are OK
--                  [2] real    - DISTANCE of Actual Offset
--                  [3] real    - DISTANCE of Maximum Allowable Offset
--
--------------------------------------------------------------------------------

-- Define Function
--  define function !!mdsCheckJntPos(!joints is ARRAY , !jdesc is ARRAY) is BOOLEAN
define function !!mdsCheckJntPos(!joints is ARRAY , !jdesc is ARRAY) is ARRAY

  !refe = !!ce

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Get the Number of Joints
  !asiz = !joints.size()

  -- Reindex joints as array may not start indexed at 1
  !joints = !joints.compress()

  -- Initialise Variables
  !ok = ARRAY()
  !count = 1
  !jnum  = 0
  --q var !joints
  do !joint values !joints
    --q var !joint
    !ok[!count] = true
    !jnum = !jnum + 1
    !sctn = !joint.owner.owner
    !pos = !joint.position.wrt(worl)

    -- Use the eccentricity value from the application defaults form
    !width = !!mdsOptions.offset.val
    if (!width.eq(0)) then
      -- to avoid a zero divde error - make !width = 1
      !width = 1
    endif

    !posl = !joint.posl
    !sNodePos = !joint.owner.position.wrt(worl)
    !sctnDir = !sctn.ori.zdir().wrt(worl)
    var !plane const plane $!sctnDir thro $!sNodePos
    !!ce = !sctn
    var !plinS const pos ppline $!posl start
    var !pline const pos ppline $!posl end
    var !pline const line join $!plinS to $!pline
    var !roundAbout  const pos inter $!pline $!plane
    !dist = !!kStrReal('const dist $!roundAbout to  $!pos').int()
    !ok[!count + 1] = !dist
    !ok[!count + 2] = !!mdsOptions.offset.val

    !check = !dist / !width
    if (!check.gt(1)) then
      !ok[!count] = FALSE
    endif
    -- Add the Joint Name to the !jdesc variable
    !jdesc[!jnum] = '"' & !joints[!jnum].name & '"'

    -- Set up !count variable for Next Joint in the Loop
    !count = !count + 3

  enddo

  !!ce = !refe

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- Return the ARRAY
  return !ok

  -- End function
endfunction
