--
-- File:    Mdscheckmitre.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--
-- Author:    I.Osborne
-- Created:   Wed Jul 02
--
--
-- Description:
-- function to check and remove mitres where necessary on FT supports
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT   Support object
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscheckmitre(!support is MDSSUPPORT)

  !name      = !support.stru.name
  !datumAtta = !support.datum

  --get direction 'up' from atta, using opposite of p9 direction
  if !support.type.eq('FT08') OR !support.type.eq('FT03') then
    !dir = !datumAtta.pdir[9].wrt(!datumAtta)
  else
    !dir = !datumAtta.pdir[9].wrt(!datumAtta).opposite()
  endif

  -- if more than 1 bar then need to collect bars, then order from bottom to top
  -- then remove mitre and trim all bars apart from bottom bar
  !arrayOfPositions = object ARRAY()

  !bar1RefString = !name & '-BAR-1'
  !bar1Ref = !bar1RefString.dbref()

  do !num from 1 to !support.bars.size()
    !barRefString = !name & '-BAR-' & !num.string()
    !barRef = !barRefString.dbref()
    handle any
      --can error here but this is not an issue as mdscheckmitre will be run again when support object and number of bars in db are in sync
      return
    endhandle
    !pos = !barRef.position.component(!dir)
    !arrayOfPositions.append(!pos)
  enddo

  !sortedIndices = !arrayOfPositions.sortedIndices()

  !v1RefString = !name & '-V1'
  !v1Ref = !v1RefString.dbref()
  if !v1Ref.purp.neq('MITR') then
  	return
  endif
  if !support.type.eq('FT08') OR !support.type.eq('FT09') OR !support.type.eq('FT42') then
    !v2RefString = !name & '-V2'
    !v2Ref = !v2RefString.dbref()
  endif

  PIN 1 COPY P10 of $!datumAtta
  PIN 2 COPY P11 of $!datumAtta

  if !support.type.eq('FT08') AND !v1Ref.gtyp.eq('ANG') then
    PIN 1 PLANE PIN 1 CLEAR 0 BEH $!v2Ref
    PIN 2 PLANE PIN 2 CLEAR 0 BEH $!v1Ref
    !shortenBy = prop athk of $!v1Ref
  elseif !support.type.eq('FT04') OR !support.type.eq('FT06') then
  	PIN 1 PLANE PIN 1 CLEAR 0 INF $!v1Ref
  elseif !support.type.eq('FT03') AND !v1Ref.gtyp.eq('ANG') then
    PIN 1 PLANE PIN 1 CLEAR 0 BEH $!v1Ref
    !shortenBy = prop athk of $!v1Ref
  elseif !support.type.eq('FT05') AND !v1Ref.gtyp.eq('ANG') then
    PIN 1 PLANE PIN 1 CLEAR 0 BEH $!v1Ref
    !shortenBy = prop athk of $!v1Ref
  else
    PIN 1 PLANE PIN 1 CLEAR 0 INF $!v2Ref
    PIN 2 PLANE PIN 2 CLEAR 0 INF $!v1Ref
  endif

  if !support.type.eq('FT06') then
    PIN 3 PLANE PIN 2 CLEAR 0 BEH $!bar1Ref
  endif

  !ref = !!ce

  do !indice from 2 to !sortedIndices.size()

    !sctnRefString = !name & '-BAR-' & !sortedIndices[!indice].string()
    !sctn = !sctnRefString.dbref()
    !!ce = !sctn
    drns d
    drne d
    if !support.type.eq('FT05') then
    	extend end 100
    	extend end thro pin 1
    elseif !support.type.eq('FT06') then
    	extend end thro pin 1
    else
      extend start thro pin 1
    endif

    if !support.type.eq('FT06') then
      extend start thro pin 3
    endif

    if !support.type.eq('FT08') OR !support.type.eq('FT09') OR !support.type.eq('FT42') then
      extend end thro pin 2
    endif
    if !support.type.eq('FT08') AND !v1Ref.gtyp.eq('ANG') then
      extend start -$!shortenBy
      extend end -$!shortenBy
    endif
    if !support.type.eq('FT03') AND !v1Ref.gtyp.eq('ANG') then
      extend start -$!shortenBy  	
    endif
    if !support.type.eq('FT05') AND !v1Ref.gtyp.eq('ANG') then
      extend end -$!shortenBy  	
    endif
  enddo

  !!ce = !ref

  !!mdsResetPins(1,3)

-- End function
endfunction
