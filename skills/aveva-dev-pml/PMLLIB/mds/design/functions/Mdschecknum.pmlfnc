--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Dec 11
--
--
-- Description:
-- function to check if the special support number has been used before
-- only if the default form support number uniqueness is true
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckNum()

  if (!!MdsOptions.SpecFla) then
    !Special = !!MdsNameSpl.Number
    !Data = !!KCollectAllFor('STRU', |:MDSSpecialNo eq '$!Special'|, =0/0)
    !!CE = !Data[1]
      handle none
        same
        !!Alert.error('The number entered ($!Special) has been used before and cannot be used again. Please enter a unique support number')
        !!MdsNameSpl.Number.val = !!MdsOptions.SpecPre
      elsehandle any
      -- Check to see if the prefix has been used
        !Check = (match(!Special.string(),!!MdsOptions.SpecPre) eq 1)
        if (!check.not()) then
          !!Alert.error('The number entered ($!Special) does not start with the special number prefix ($!!MdsOptions.SpecPre).')
          !!MdsNameSpl.Number.val = !!MdsOptions.SpecPre
        endif
      endhandle
  endif



-- End function
endfunction

-- End of file Mdschecknum.pml
