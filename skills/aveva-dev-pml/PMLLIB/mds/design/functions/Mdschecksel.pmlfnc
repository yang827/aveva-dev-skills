--
-- File:		Mdschecksel.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thu Sep 4
--
--
-- Description:
-- Function to check if a ancill is allowed in a particular framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1    R        String         Passed Ancill Type
--     2    R        String         Passed Support Type
--
-- Return:
--    [Data Type]   [Description]
--    logical       is the passed ancill a vaild type
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCheckSel(!Ancill is STRING, !Type is STRING) is BOOLEAN

-----------------------------------------------------------------------------------
--mjb >>> 20.03.06 <mds12> Function modified to get selection and restriction lists
--                         from /MDS/STRUCTURE/DEFAULTS (not MdsSelection object created
--                         in mdsreaddefs as previously)

  --Is the passed ancill in selection list

  --!FrameObject = '!!MdsSel' & !Type
  --!Object = $!FrameObject

-----------------------------------------------------------
--<wd>may2006<mds12> -- Added the Check for the MDS Ancillary ANCHOR Standard "AN04"
  --!sectref = '/MDS/STRUCTURE/DEFAULTS/' & !type
  if (!type.eq(|AN04|)) then
-- For this CONDITION the MDS ANCILLARY "AN04" is represented by the variable !type,
-- and the variable !ancill represents the MDS ANCILLARY "Pipe Shoe STANDARD"(e.g. "AT12", "AT13" etc..)
    !sectref = '/MDS/ATTA/DEFAULTS/' & !type

  else
-- For this CONDITION the the variable !type represents the MDS FRAMEWORK STANDARD type, and
-- the variable !ancill represents the MDS ANCILLARY STANDARD type to be added to the FRAMEWORK
    !sectref = '/MDS/STRUCTURE/DEFAULTS/' & !type

  endif
--<wd>may2006<mds12>
-----------------------------------------------------------

  var !selectioncoll coll all data with dkey eq 'SELE' for $!sectref
  var !Selectionarray eval pprop for all from !selectioncoll
  !Selection = !selectionarray[1].after(|( '|).before(|' )|).split(',')

  --!Selection = !Object.selection

  !Selected = false
  do !SelList values !Selection
    if (!Ancill.matchwild(!SelList)) then
      !Selected = true
    endif
  enddo

-- Is the passed ancill in the restriction list
  var !restrictioncoll coll all data with dkey eq 'RSTR' for $!sectref
  var !Restrictionarray eval pprop for all from !restrictioncoll
  !Restriction = !restrictionarray[1].after(|( '|).before(|' )|).split(',')

--TWO SECTIONS BELOW FROM MDSREADDEFS.pmlfnc
  !Restriction.append('AT43*') $* Pipe Penetration Single Seal
  !Restriction.append('AT44*') $* Pipe Penetration Single Seal
  !Restriction.append('AT45*') $* Pipe Penetration Double Seal
  !Restriction.append('AT46*') $* Pipe Penetration Double Seal

-- RESTRICT the OLD TRUNNION ATTA Pedestals and GUIDE
  !Restriction.append('GT20')  $* Pedestal Base Plate Guide
  !Restriction.append('AT10A') $* Pedestal Atta
  !Restriction.append('AT10B') $* Pedestal Atta
  !Restriction.append('AT11A') $* Pedestal Atta
  !Restriction.append('AT11B') $* Pedestal Atta
  !Restriction.append('AN01*') $* Anchor Type Pedestal Atta

--!Restriction = !Object.restriction

--mjb << 20.03.06 <mds12> end of mods
-----------------------------------------------------------------------------------

  !Restricted = false
  do !RestList values !Restriction
    if (!Ancill.matchwild(!Restlist)) then
      !Restricted = true
    endif
  enddo

  -- Therefore the logic is but the returned value is opposite
  -- Selected          Restricted
  -- true              true           = false
  -- true              false          = true
  -- false             true           = false
  -- false             false          = false

  if (!Selected) and (!Restricted.not()) then
    return false
  else
    return true
  endif

-- End function
endfunction

-- End of file Mdschecksel.pml
