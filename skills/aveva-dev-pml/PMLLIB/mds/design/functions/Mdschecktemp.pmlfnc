--
-- File:  Mdschecktemp.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:  N.morris
-- Created:		Fri 14 Aug
--
--
-- Description:
-- Function to check if a pipe identified is suitable for supporting
-- The :MdsHV attribute of the template can be set to
-- BOTH - Support horizontal and vertical pipes
-- VERT - Support vertical pipes only
-- HORI - Support horizontal pipes only
-- if the :MdsHV is unset then BOTH will be assumed
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCheckTemp(!tempZone is STRING,!dir is STRING) is BOOLEAN

  !testVert = :MdsHV of $!tempZone

  if (!dir eq 'U WRT /*' or !dir eq 'D WRT /*' or !dir eq 'Z WRT /*' or !dir eq '-Z WRT /*') then
-- Pipe is vertical test for hori only
    if !testVert eq 'HORI' then
      !!alert.error('This configuration is not allowed to support vertical pipes')
        return false
      endif
    else
-- Pipe is horizontal check for vert only
    if !testVert eq 'VERT' then
      !!alert.error('This configuration is not allowed to support horizontal pipes')
        return false
      endif
    endif

    return true

endfunction
