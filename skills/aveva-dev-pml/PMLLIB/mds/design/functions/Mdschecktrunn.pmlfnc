--
-- File:  Mdschecktrunn.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Wednesday 18th February 1998
--
--
-- Description:
-- Function to check the Trunnion 'Length' and 'Pad Thickness' are OK
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         FORM         FORM being used to Create/Modify Trunnion
--     2      R        STRING        LEN - Check the Length of the Trunnion
--                                   PAD - Check Pad Thickness and if Required
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdschecktrunn(!form is FORM, !mode is STRING)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  !support = !form.support
  !datum   = !form.support.datum
  !name    = '/' & !form.name.val
  !maxlen  = !!mdsoptions.trunnlen.val
  var !trunnion exists $!name

  --------------------------------------------------------------------------------
  -- Check Entered Value is Positive
  if (!mode.string().upcase().eq('LEN')) then
    !attrib = 'Length'
    !value  = !form.length.val

    if (!value.unset()) then
      !form.length.val = !maxlen
      !!alert.message('Nothing Entered  - ' & !attrib & ' MUST be a Positive Value')
      !!kRestoreUnits(!currentunits)
      return
    endif

    if (!form.length.val.string().trim().match('-').eq(1)) then
      !form.length.val = !maxlen
      !!alert.message('Entered ' & !attrib & ' MUST be a Positive Value')
      !!kRestoreUnits(!currentunits)
      return
    endif

    if (!form.length.val.real().eq(0)) then
      !!ce = !datum
      desp 0mm 0mm 0mm 0mm 0mm
      !!kRestoreUnits(!currentunits)
      return
    endif
    --------------------------------------------------------------------------------
  elseif (!mode.string().upcase().eq('PAD')) then
    !attrib = 'Pad Thickness'
    !value  = !form.plate.val
    if (!value.unset()) then
      !form.plate.val = 0
      !!alert.message('Nothing Entered - ' & !attrib & ' MUST be a Positive Value')
      !!kRestoreUnits(!currentunits)
      return
    endif

    if (!form.plate.val.string().trim().match('-').eq(1)) then
      !form.plate.val = 0
      !!alert.message('Entered ' & !attrib & ' MUST be a Positive Value')
      !!kRestoreUnits(!currentunits)
      return
    endif

  endif

  --------------------------------------------------------------------------------
  -- Check Trunnion Atta Exists
  if (!support.datum.badref())then
    !!alert.message('Create Trunnion atta before modifying (' & !attrib & ') ')
    !!kRestoreUnits(!currentunits)
    return
  endif

  if (!trunnion eq 'FALSEA')then
    !!alert.message('Create Trunnion atta before modifying (' & !attrib & ' ) ')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  -- Navigate to Trunnion Atta
  !!ce = !datum

  -- Check Trunnion **$!attrib**
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  if (!mode.string().upcase().eq('LEN')) then
    -- Check for type 'TT02' attaching to Elbows
    !legl = 0
    !desp2 = !datum.despar[2]
    if (!form.support.alias.match('TT02').eq(1)) then
      !legl = !!kstrreal('cons dist p0 of :MDSSref to plane pl of :MDSSref')

      --------------------------------------------
      if (!datum.spref.string().match('TT02-A').gt(0) or !datum.spref.string().match('TT02-C').gt(0)) then
        -- Calculate Offset to Position Trunnion BOP at Elbo BOP for Types 'A' and 'C' Only
        -- Trunnion Atta Catref > Para Num 3 = Pipe O/D and Para Num 4 = Trunnion O/D
        var !offset  ((para num 3 of catref - para num 4 of catref) / 2)
        !desp2  = !offset.real()
      endif
      --------------------------------------------
    endif

    if (!form.length.val gt !maxlen) then
      !!kformattext.text.val = !form.length.val
      !tlen = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !!kformattext.text.val = !maxlen
      !tmax = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !!alert.error('Length entered (' & !tlen & ') is greater than the Maximum Allowable Trunnion Length. $
      Setting Length to the maximum of ' & !tmax & ' ')
      !form.length.val = !maxlen

      -- Set the Despars for the Maximum Trunnion Length
      --------------------------------------------------------------------------------
      --------------------------------------------------------------------------------

      !hpod = pl od / 2
      !half = !hpod

      !desp4 = !form.length.val
      !desp1 = !desp4 + !half + !legl
      !desp5 = !half + !legl

      despar num 1 $!desp1
      despar num 2 $!desp2
      despar num 4 $!desp4
      despar num 5 $!desp5
      !!kRestoreUnits(!currentunits)
      return

      --------------------------------------------------------------------------------
    else
      -- Set the Correct Despars for the Trunnion Length etc
      !hpod = pl od / 2
      !half = !hpod

      !desp4 = !form.length.val
      !desp1 = !desp4 + !half + !legl
      !desp5 = !half + !legl

      despar num 1 $!desp1
      despar num 2 $!desp2
      despar num 4 $!desp4
      despar num 5 $!desp5
    endif

    --------------------------------------------------------------------------------
  elseif (!mode.string().upcase().eq('PAD')) then
    !!alert.warning('IMPORTANT NOTE: The Pad Thickness used for Reinforcement would normally be the same Thickness/Schedule as the Main Pipe')
    !desp2 = !form.plate.val
    despar num 2 $!desp2
  endif

  --------------------------------------------------------------------------------

  --<wd> July2001
  --  Modify stex for isometrics
  !atta = !!ce
  call !!mdstransport(!atta,!name)
  !!ce = !atta
  var !trundir p3 dir
  !trunlen = despar

  -- Twin or Single Trunnions
  !selection = !!ce.spref.name.string()
  if (matchwild(!selection,'*TT01-A*') or matchwild(!selection,'*TT01-C*')) then
    !length = (!trunlen[4] + !trunlen[5]) * 2
  elseif (matchwild(!selection,'*TT03-A*') or matchwild(!selection,'*TT01-B*')) then
    !length = (!trunlen[4] + !trunlen[5]) * 2
  elseif (matchwild(!selection,'*TT02*')) then
    var !stdist cons dist pa to p0
    !dist = !stdist.real()
    !length = !trunlen[4] + !dist
  else
    !length = 0
  endif

  stex '$!form.name
  Direction = $!trundir
  O/A Trun. CL Length = $!length
  Offset = 0
  WELDED ATTACHMENT DO
  NOT CUT HOLE IN PIPE'

  --<wd> July2001
  --------------------------------------------------------------------------------

  -- Navigate to Trunnion Atta
  !!ce = !datum

  -- Reset Project Units
  !!kRestoreUnits(!currentunits)

endfunction
