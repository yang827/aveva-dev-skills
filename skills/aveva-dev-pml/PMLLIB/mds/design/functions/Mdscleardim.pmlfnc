--
--
-- Description:
-- Function to clear the standards dimensions from the graphical aids
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function

define function !!MdsClearDim()

-- The dimension facility uses numbers 260 to 360

  do !Clear from 260 to 360

    aid clear text $!Clear
      handle any
      endhandle
    aid clear arrow $!Clear
      handle any
      endhandle
    aid clear line $!Clear
      handle any
      endhandle

  enddo

-- The tags used by MDS for tagging the datum etc are from 210 to 230

  do !Clear from 210 to 259

    aid clear text $!Clear
      handle any
      endhandle
    aid clear arrow $!Clear
      handle any
      endhandle
    aid clear line $!Clear
      handle any
      endhandle

  enddo

-- Remove the dynamic hanger offset aid

  do !ClearHang from 2999 to 3003
    aid clear line $!ClearHang
      handle ANY
      endhandle
  enddo

  do !ClearHang from 3004 to 3005
    aid clear arrow $!ClearHang
      handle ANY
      endhandle
  enddo

  do !ClearHang from 3006 to 3007
    aid clear text $!ClearHang
      handle ANY
      endhandle
  enddo

-- Clear edit section aids

  aid clear text 2870
    handle ANY
    endhandle
  aid clear arrow 2870
    handle ANY
    endhandle

endfunction

-- End function

-- End of file Mdscleardim.pml
