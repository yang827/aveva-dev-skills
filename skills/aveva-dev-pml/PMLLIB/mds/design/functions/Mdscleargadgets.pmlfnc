--
-- File:		Mdscleargadgets.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed May 07
--
--
-- Description:
-- Function to clear standard pipe support form gadgets
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of pipe support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsClearGadgets(!Form is FORM)

  -- Clear Support object
  !Form.Support = object MdsSUPPORT()
-- Clear Packing Piece Form Support Object
  !!Mdsft25.support = object MdsSUPPORT()
  handle any
--> add <ab>. Needed when object MdsSUPPORT definition has changed. Tue 9 Apr 2002
    kill !!Mdsft25
    pml load form !!Mdsft25
    !!Mdsft25.support = object MdsSUPPORT()
--> add <ab> Tue 9 Apr 2002
  endhandle

  -- Clear Array Gadgets
  !Form.Repre.Clear()
  handle any
  endhandle
  !Form.Store.Clear()
  handle any
  endhandle
  !Form.StoreBpref.Clear()
  handle any
  endhandle
  !Form.StruBpref.Clear()
  handle any
  endhandle
  !Form.Ppack.Clear()
  handle any
  endhandle
  !Form.Stiffener.Clear()
  handle any
  endhandle
  !Form.OldStiffener.Clear()
  handle any
  endhandle

-- Reset to DEFAULT Callback on the .Create button
-- on the form !!Mdsft25
  !!Mdsft25.create.callback = |call !!Mdscreateft25()|
  !!Mdsft25.Ppack.Clear()

-- Reset Index No. 2 of the ARRAYS to DEFAULT Callback on the form gadgets
-- '!!Mdsmodat.height, .length and .thickness'
  !!Mdsmodat.actionheight[2]    = ||
  !!Mdsmodat.actionlength[2]    = ||
  !!Mdsmodat.actionthickness[2] = ||

  -- Clear String Gadgets
  !Form.Name.Val = ||

  -- Clear form userdata
  VAR USER _$!Form CLEAR

  -- Remove highlighted colours
  UNENHANCE ALL

  -- Remove aid text
  do !count from 210 to 259
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT
  enddo

--> Modified -<wd>29sep1998
-- Dismiss the EDG forms for the Alignment Utility, if they are shown
  if (!!Mdsalign.shown()) then
    !!kactioncommands(!!Mdsalign.dismissform)
  endif
--< Modified -<wd>29sep1998

-- End function
endfunction

-- End of file Mdscleargadgets.pml
