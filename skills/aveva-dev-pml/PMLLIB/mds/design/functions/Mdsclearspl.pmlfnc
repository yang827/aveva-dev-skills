--
-- File:		Mdsclearspl.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 17th June 1998
--
--
-- Description:
-- Clears all Arrays in the passed form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM          Name of form being called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsclearspl(!form is FORM)

--------------------------------------------------------------------------------
 -- Initialise Variables
    !array = !form.attributes()

-- Clear All the Forms Gadgets of type 'ARRAY' only
    do !index index !array
      !gname = '!!' & !form & '.' & !array[!index]
      skip if ($!<gname>.objecttype().neq('ARRAY'))
      skip if ('$!<array[$!index]>' inset ('APPLYFORM', 'DISMISSFORM'))
      $!<gname>.clear()
    enddo


  endfunction
-- End function

-- End of file Mdsclearspl.pml
