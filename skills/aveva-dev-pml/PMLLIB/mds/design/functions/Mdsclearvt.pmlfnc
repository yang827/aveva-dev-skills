--
-- File:		Mdsclearvt.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 23rd december 1997
--
--
-- Description:
-- facility to Check the Clearance Between Pipe Support Member and the
-- Pipe Outside Diameter, including any Insulation Thickness
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsclearvt(!form is FORM) is STRING

-- Initialise variables
    !dim2val = !form.dim2.val
-- Minval is the value Calculated from the MDS Support Standards 'VT01' and 'VT02'
    !minval  = 25
    !maxval  = !!mdsoptions.clear.val

-- Special Minval and Maxval values for Framework GUIDE Types 'VT03' and 'VT04'
    if ('$!form' inset ('MDSVT03','MDSVT04')) then
      !minval = 0
      !maxval = !!mdsoptions.clear.val
    endif

--------------------------------------------------------------------------------

-- Get format
    !!kformattext.text.val = !minval
    !fminval = !!kformattext.text.val.string(!!$!!kformattext.text.format)
    !!kformattext.text.val = !maxval
    !fmaxval = !!kformattext.text.val.string(!!$!!kformattext.text.format)

-- If value set to less than '!minval' return '!minval'
    if (!dim2val.lt(!minval)) then
      !!alert.error('Minimum Clearance allowed is ' & !Fminval & ' $
                     - Dim 2 has been reset to ' & !Fminval)
      !form.dim2.val = !minval
      return

    elseif (!dim2val.gt(!maxval)) then
-- If value set to greater than '!maxval' then return '!maxval'
      !!alert.error('Maximum Clearance allowed is ' & !Fmaxval & ' $
                     - Dim 2 has been reset to ' &  !Fmaxval)
      !form.dim2.val = !maxval
      return
    endif

  endfunction
-- End function

-- End of file Mdsclearvt.pml
