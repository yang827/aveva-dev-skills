--
-- File:		Mdscommselect.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:         Fixed problem with modify drawing comment selection
-- function to select existing support for the modification of the drawing
-- comment
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Method of selecting 'CURSOR or NAME'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCommSelect(!SelectBy is STRING)

  -- Initialise Variables
    !Origin = !!CE

  -- make the texp uneditable

    !!MdsComm.Comment.SetEditable(false)

  -- Select support
    if (!SelectBy.upcase() eq 'CURSOR')then

    -- Pick support by identifying support atta or structure
      prompt off
      prompt load escape 'Identify support to modify the drawing comment'
      id @
        handle (61,528)
          prompt dismiss
          return
        endhandle
      prompt dismiss
      prompt on
      !Element = !!CE

    elseif (!SelectBy.upcase() eq 'NAME')then

    -- Check to see if the name is valid
      if (!!MdsComm.Name.Val.upcase() eq |UNSET|)then
        return
      endif

    -- Test to see if the Element exists
      if (subs(!!MdsComm.Name.Val,1,1) eq '/')then
        !Name = after(!!MdsComm.Name.Val, '/')
      else
        !Name = !!MdsComm.Name.Val
      endif

      !Ref = '/' & !Name
      !!MdsComm.Name.Val = !Name

    -- Navigate to element
      !Element = !Ref.dbref()
      handle any
        !!MdsComm.Name.Val = 'unset'
        !Temp[1] = 'unset'
        !!MdsComm.Comment.val = !Temp
        !!MdsComm.Comment.SetEditable(false)
        !!MdsComm.Name.Setfocus()
        !!Alert.error('Support $!Name does not exist.')
        return
      endhandle

    elseif (!SelectBy.upcase() eq 'CE')then

      !Element = !!CE

    else
      !!MdsComm.Name.Setfocus()
      !!Alert.error('Incorrect selection argument passed. Contact your MDS Administrator.')
      return
    endif

    !!CE = !Element.Name.dbref()

--<wd>18mar2002
    !form     = !!Mdscomm
    !suppname = !!ce.name
    !error    = ''
    if (!!mdscheckstatus(!form, !suppname, !error)) then
      !!alert.error(!error)
      return
    endif
--<wd>18mar2002

  -- Check Element Picked
    Stru
      handle(2,111)
        HANG
        handle(2,111)
        elsehandle NONE
          goto href
        endhandle
        if (!!CE.type ne 'ATTA')then
          !!MdsComm.Name.Val = 'unset'
          !Temp[1] = 'unset'
          !!MdsComm.Comment.val = !Temp
          !!MdsComm.Comment.SetEditable(false)
          !!MdsComm.Name.Setfocus()
          !!Alert.error('Cannot navigate to support from picked element.')
          return
        else
          if (!!CE.stext eq '')then
            if (match(!!CE.name, 'SREF') gt 0)then
              -- move to datum atta
              !DatumName = !!CE.Name.Before('/SREF') + '/DATUM'
              !!CE = !DatumName.Dbref()
              if (!!CE.stext eq '')then
                !!MdsComm.Name.Setfocus()
                !!Alert.error('Cannot find support to modify drawing comment. Are you sure it is a support.')
                return
              else
                !Support = '/' & !!CE.stext
                !SupportArray = !Support.split()
                !Support = !SupportArray[1]
              endif
            else
              !!MdsComm.Name.Setfocus()
              !!Alert.error(|Cannot find support to modify drawing comment. Are you sure it is a support.|)
              golabel /Reset
            endif
          else
            !MDSSuppFunc = :MDSSuppFunc
            if !MDSSuppFunc.neq('') then
              !Support = '/' & !!CE.stext.before('-$!MDSSuppFunc')

            else
              !Support = '/' & !!CE.stext
            endif
            !SupportArray = !Support.split()
            !Support = !SupportArray[1]
          endif

        -- Check the support reference
          !TestRef = !Support.dbref()
            handle (2,109)
              !!MdsComm.Name.Setfocus()
              !!Alert.error(|The stext of the selected element is referencing an undefined support.|)
              golabel /Reset
            endhandle

        -- Check what type of element the support is
          if (!Support.dbref().type eq |STRU|)then
            !!CE = !Support.dbref()
          elseif (!Support.dbref().type eq |ATTA|)then

          -- This is a lone atta support (no steelwork associated). Add to selection list
            !Data[1] = !!CE
            golabel /End
          else
            !!MdsComm.Name.Setfocus()
            !!Alert.error('Cannot modify drawing comment. Type of support reference is unknown.')
            golabel /Reset
          endif
        endif
      endhandle
    !Support = !!CE.name
    !Stru    = !!CE

  -- Check type of structure
    if (!!CE.owner.purp neq |SUPP|)then
      !!MdsComm.Name.Setfocus()
      !!Alert.error('Selected element is not a support.')
      golabel /Reset
    endif

  -- Get support type of framework
    !SuppType = !!CE.:MDSSuppType
    if (!SuppType eq '')then
      !!MdsComm.Name.Setfocus()
      !!Alert.error('Cannot modify drawing comment. Type is unknown.')
      golabel /Reset
    endif

  -- Get all components associated with this support
    !Name = after(!!CE.name, '/')
    !Data = !!KCollectAllFor('ATTA', 'STEXT eq |$!Name|', =0/0)

  -- See if there is an SREF atta
    !SrefName = '/' & !Name & '/SREF'
    !!CE = !SrefName.dbref()
      handle none
        !Sref = !!CE
      elsehandle any
      endhandle

  label /End

  -- Set form gadgets

  -- Navigate to support and set name gadget to support name
    !!CE = !Support.dbref()
    !!MdsComm.Name.Val = after(!!CE.Name, '/')

  -- If the macro is sucessful and you are able to edit the :MDSComment attribute
  -- then make the gadget editable and set to the current value

    !!MdsComm.Comment.SetEditable(true)
    !datumatta = '/' & !!MdsComm.Name.Val & '/DATUM'
    !Temp[1] = !datumatta.dbref().:MDSComment
      handle (2,109)
        !datumatta = '/' & !!MdsComm.Name.Val
        !Temp[1] = !datumatta.dbref().:MDSComment
      endhandle
    !!MdsComm.Comment.val = !Temp
    !!MdsComm.Comment.SetFocus()

return

  label /Reset
    !!CE = !Origin
    !!MdsComm.Name.Val = 'unset'
    !!MdsComm.Comment.SetEditable(false)
    !!MdsComm.Cancel.active = true
    !!MdsComm.Name.SetFocus()

-- End function
endfunction

-- End of file Mdscommselect.pml
