--
-- File:  Mdsconfigft15.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Wednesday 13th October 1997
--
--
-- Description:
-- function to deactivate form gadget 'Mdsft15.dim4' for Build configurations
-- '1' and '2' (ie. 'WEBWEB' and 'WEBCOL') or
-- activate form gadget 'Mdsft15.dim4' for Build configurations '3' and '4' (ie. 'BELCOM' and 'BELUNC')
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Textural string to determine whether to activate or
--                                  deactivate form gadget 'Mdsft15.dim4'
--                                  'WEBWEB' , 'WEBCOL' , 'BELCOM' , 'BELUNC'
--                                  'WEBWEB' - Web of First Beam to Web of Second Beam
--                                  'WEBBEL' - Web of First Beam to Underside of Second Beam
--                                  'BELCOM' - Underside of Common Size Beams and/or Beams
--                                             with a COMMON 'BOS' elevation
--                                  'BELUNC' - Underside of Common/UnCommon Size Beams and/or Beams
--                                             with an UNCOMMON 'BOS' elevation
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsconfigft15(!slide is STRING)

  -- Initialise variables
  !build = !slide
  !supp  = !!mdsft15.support
  !xconf = !supp.config

  -- If the MDS Structure has NO members then it hasn't been created yet so exit this function
  if (!supp.stru.mcount.eq(0)) then
    return
  endif

  -- Set the Config Required
  if (!slide.eq('WEBWEB')) then
    !nconf = 1
  elseif (!slide.eq('WEBBEL')) then
    !nconf = 2
  elseif (!slide.eq('BELCOM')) then
    !nconf = 3
  elseif (!slide.eq('BELUNC')) then
    !nconf = 4
  endif

  -- Check if Existing Config is same as New Config
  if (!xconf.eq(!nconf)) then
    return
  else
    -- Check if External Joints Exist before Proceeding
    if (!supp.joints.empty().not()) then

      --        if (!!alert.confirm('This MDS framework contains External Connections, Do you want to continue?').eq('NO')) then
      --          !!mdsft15.slide.val = !xconf
      --          return
      --        endif

      -- Store the SPREF Reference of the EXISTING 'SREF' Atta
      do !sref index !supp.atta
        skip if !supp.atta[!sref].name.match('/SREF').eq(0)
        !!mdsft15xsref = !supp.atta[!sref].spref
        !!mdsft15xconf = !xconf
        break
      enddo
    endif

    -- Deactivate/Activate Form Gadget 'Mdsft15.dim4'
    if (!build inset ('WEBWEB' , 'WEBBEL') ) then
      !!mdsft15.dim4.active = false
      !!mdsft15.dim5.active = false
    elseif (!build inset ('BELCOM') ) then
      !!mdsft15.dim4.active = true
      !!mdsft15.dim5.active = false
    elseif (!build inset ('BELUNC') ) then
      !!mdsft15.dim4.active = true
      !!mdsft15.dim5.active = true
    endif

    -- if sref exists modify spref
    if (!build eq 'WEBWEB') then
      !styp = 'N'
    elseif (!build eq 'WEBBEL') then
      !styp = 'P'
    elseif (!build eq 'BELCOM') then
      !styp = 'R'
    else
      !styp = 'S'
    endif

    !srefAtta = !!mdsft15.support.stru.name + '/SREF'
    !!ce = !srefAtta.dbref()
    handle none
      !size = !!mdsSetSteel.size.selection('Rtext')
      SEL SPREF WITH STYP 'FT15-$!styp-$!size' SPEC /MDF
      !!mdsSetSuppCode('MODIFY',!!mdsft15.support.stru.name,'FT15','FT15-N-1')
    elsehandle any
      !!mdsSetSuppCode('SELECT',!!mdsft15.support.stru.name,'FT15','FT15-N-1')
      return
    endhandle

    -- Rebuild if possible
    if (!supp.joints.empty().not()) then
      !!mdsCreateFt15('CURSOR')
    else
      !!mdsCreateFt15('DIMENSION')
    endif
  endif

endfunction
