--
--
-- Description:
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Type
--                                  'MID' , 'BACK' , 'FRONT' , 'SIDE' , 'UNDER'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsconfigFT34(!Slide is string)

-- Initialise variables
    !build = !slide

-- if sref exists modify spref

    if (!build eq 'MID') then
      !Styp = 'L'
    elseif (!build eq 'BACK') then
      !Styp = 'M'
    elseif (!build eq 'FRONT') then
      !Styp = 'M'
    elseif (!build eq 'SIDE') then
      !Styp = 'N'
--<wd>dec1999-- Last 3 Styp's added for FT22 BedPlate Connection
--    else
    elseif (!build.eq('UNDER')) then
      !Styp = 'P'
    elseif (!build.eq('FACEVERT')) then
      !styp = 'M'
    elseif (!build.eq('ENDVERT')) then
      !styp = 'L'
    elseif (!build.eq('FACEHORI')) then
      !styp = 'P'
    endif

    !SrefAtta = !!MdsFT34.support.stru.name + '/SREF'
    !!CE = !SrefAtta.dbref()
      handle none
        !alias = !!MdsFT34.support.alias
        SEL SPREF WITH STYP '$!alias-$!Styp-$!!Mdssetsteel.size.val' SPEC /MDF
        handle any
          return
        elsehandle none
          !!MdsSetSuppCode('MODIFY',!!MdsFT34.support.stru.name,'FT34','FT34-N-1')
        endhandle
      elsehandle any
         return
      endhandle

--<wd>jun2001 -- If statement added around Rebuild Syntax so as NOT to REBUILD
-- FT34 framework by using DIMENSIONS when Joints exist.
-- Rebuild if possible
    if (!!MdsFT34.support.joints.unset()) then
      !!MdsCreateFT34('DIMENSION')
    endif
--<wd>jun2001

-- End function
endfunction

-- End of file MdsconfigFT34.pml
