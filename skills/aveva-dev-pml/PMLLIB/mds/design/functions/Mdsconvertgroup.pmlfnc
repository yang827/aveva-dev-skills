--
-- File:		MdsConvertGroup.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		D Flannery
-- Created:		09.10.04
--
--
-- Description:
-- function to connect mds hanger to group / rename
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsConvertGroup(!mode is STRING , !AttaRef is dbref, !NewName is STRING ) is BOOLEAN

-- Initialise Variables
  !Return = FALSE

  if (!mode.eq('CONVERT') ) then

    !!mdsmodifyname.newname.val = |unset|
    !!MdsSilent = TRUE
    !!MdsSelectSupp(|MODIFYNAME|, |CE|, |VERBOSE| )

-- Get support
    !!MdsSilent = TRUE
    !SuppName = !!MDSGetSuppName(!!ce)
    !!MdsSilent.delete()
    if !SuppName.eq(|ABORT|) then
      !!Alert.error(|Cannot navigate to support from current element|)
      return
    else
      if !SuppName.dbref().type.eq(|STRU|) then
-- Check to see if it is a framatome electrical support
        if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
          !Sref = !SuppName + '/SREF'
          if !Sref.dbref().spref.name.match('/MDF/FR').eq(1) then
            !!Alert.Error('Selected support is a electrical support and cannot be converted to a group')
            return
          endif
          !datum = !SuppName + '/DATUM'
          if !Datum.dbref().spref.name.match('/MDS/.HVAC-REST').eq(1) then
            !!Alert.Error('Selected support is a HVAC support and cannot be converted to a group')
            return
          endif
        endif
        !!Mdsmodifyname.formtitle = |Convert to Group Support|
        !!Mdsmodifyname.name.val = !attaref.namn

        if (!SuppName.match('[').gt(0) and !SuppName.match(']').gt(0) ) then
          !!Alert.error(|Support is already part of a group|)
          --unenhance all
          return
        else
          !NewSuppName = !SuppName & '[1]'
          handle (2,756)
            show !!mdsmodifyname
          endhandle
          !!mdsmodifyname.newname.val = |$!NewSuppName|
          !!Mdsmodifyname.applyform[1] =|!!Mdsmodifyname(1,1,'NAMEONLY')|
          !!Mdsmodifyname.applyform[4] =|!!Mdsmodifyname.newname.val = 'unset'|
          !!Mdsmodifyname.applyform[5] =|!!Mdsmodifyname.formtitle   = 'Modify Support Name'|
        endif
      else
        -- Hanger, therefore add to existing support
        if (!SuppName.match('[').gt(0) and !SuppName.match(']').gt(0) ) then
          !!Alert.error(|Hanger is already part of a group|)
          return
        else
          !!Mdsmodifyname.formtitle = |Convert to Group Support|
          !!Mdsmodifyname.name.val = !SuppName.after('/')
          !!Mdsmodifyname.applyform[1] = |!!Mdsmodifyname(1,1,'NAMEONLY')|
          !!Mdsmodifyname.applyform[5] = |!!Mdsmodifyname.formtitle = 'Modify Support Name'|
          !!mdsgroup(|ADD|, !!mdsmodifyname)
        endif
      endif
    endif


    if !!mdsmodifyname.newname.val.neq('unset') then
      show !!mdsmodifyname
    endif

  elseif (!mode.eq('RENAME') ) then
    -- Rename only, used when other group hangers
    -- owned by support deleted therefore tidying up
    !!mdsmodifyname.name.val = !attaref.namn
    handle (2,756)
      show !!mdsmodifyname
      hide !!mdsmodifyname
      !!mdsmodifyname.name.val = !attaref.namn
    endhandle
    !!mdsmodifyname.newname.val = |$!NewName|
    !!Mdsmodifyname.applyform[1] =|!!Mdsmodifyname(1,1,'NAMEONLY')|
    call !!kactioncommands(!!Mdsmodifyname.applyform)
    handle ANY

    elsehandle NONE
      -- reset the gadgets on modifynameform
      --!!Mdsmodifyname.applyform[1] = ||
      !!mdsmodifyname.name.val = |unset|
      !!mdsmodifyname.newname.val = |unset|
      !return = TRUE

    endhandle

  endif

  return !Return

-- End function
endfunction

-- End of file MdsConvertGroup.pmlfnc
