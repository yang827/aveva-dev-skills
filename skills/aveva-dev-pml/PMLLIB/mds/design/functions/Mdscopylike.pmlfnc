--
-- File:		Mdscopylike.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Nov 16 2000
--
--
-- Description:
-- function to obtain the dimension from another support of the same type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCopyLike(!Form is FORM)

-- Can we move all components of the support

  if !!MdsCheckAccess(!Form,'DACMOD','POS').not() then
    !!CE = !Form.Support.Datum
      handle any
      endhandle
    return
  endif

-- Save DB position

  !Origin = !!CE

-- Identify support

  prompt off
  prompt load escape 'Identify support to copy framework attributes from'
  id @
    handle (61,528)
      prompt on
      return
    endhandle
  prompt dismiss
  prompt on

-- Find support name

  !SuppName = !!MdsGetSuppName(!!CE.Name.dbref())

  if (!SuppName eq 'ABORT') then
      !!CE = !Origin
      return
  endif

-- Check if the user has identified the same support

  if !Form.Support.Stru.Name.eq(!SuppName) then
    !!Alert.Error('Identified support is the current support. Aborting Framework As')
    return
  endif

-- OK if its a valid support with a framework, then look for the SREF atta

  $!SuppName/SREF
    handle any
      !!Alert.Error('Selected element is not a valid support')
      return
    endhandle

-- Find the support type

  !TypeNoAlias = !Form.Support.Type
  !CurrentType = !!MdsAliasList(!TypeNoAlias)

-- Is it the same type of support

  !IdentifiedType = :MDSSuppType of $!Suppname

  if !TypeNoAlias.neq(!IdentifiedType) then
    !!Alert.Error('Selected support is not the same type of support')
    return
  endif

  if !IdentifiedType.neq('SPECIAL') then

-- Looks OK set the design parameters

    !Despar = despar

    !Form.dim1.val = $!Despar[1]
      --handle any
      --endhandle
    !Form.dim2.val = $!Despar[2]
      handle any
      endhandle
    !Form.dim3.val = $!Despar[3]
      handle any
      endhandle
    !Form.dim4.val = $!Despar[4]
      handle any
      endhandle

-- Execute the dimension create function to rebuild the support

    !!MdsCreate$!CurrentType('DIMENSION')

  else

-- Access stru element

    !!ce = !!MdsSpecial.Support.Stru

-- If it already has members confirm deletion

    if !!Alert.Confirm('Are you sure you wish to copy the identified support').eq('NO') then
      return
    endif

    delete stru mem
      handle any
      endhandle

    copy mem of $!SuppName
    !Datum = !!MdsSpecial.Support.datum
    at p9 of $!Datum

  endif

return

endfunction
