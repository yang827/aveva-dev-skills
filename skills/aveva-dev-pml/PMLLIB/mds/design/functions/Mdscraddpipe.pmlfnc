--
-- File:  Mdscraddpipe.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MADDPIPE
--
-- Author:  I.osborne
-- Created:		Thu Mar 08
--
--
-- Description:
-- function to add pipe support to framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrAddPipe(!form is FORM)

-- Activate MDS DAC control variable

  !!mdsDacControl(true)

-- Initialise variables
  !datum = !form.support.datum
  !stru  = !form.support.stru
  !suppName  = !stru.name

--<wd>feb2004>

  if (not !!ce.styp inset ('AT61')) then
    !!mdsMConn('3','D')
  endif

  if !!mdsCheckTrun(!form,'DATUM').not() then
    !pldir = PL DIR of $!datum wrt /*
  else
    !pldir = :MDSFrameDir of $!stru
    if !pldir.up.unset() then
      !pldir = PL DIR of $!datum wrt /*
    endif
  endif

-------------------------------------------------
--<wd>nov2004
-- Need to calculate/use the "TRUE" orthogonal PLeave Direction/Plane Direction of the DATUM ATTA
  -- or the uda :mdsframedir value of the STRU as shown immediately above.
  if (defined(!form.support.datumorthdirs.set())) then
    if (!form.support.datumorthdirs.set()) then
-- Set !planedir to the ORTHOGONAL PLeave Direction of the DATUM Atta
      !planedir = !form.support.datumorthdirs[1]
    else

-->>> ORIGINAL CODE used for calculating the Plane Direction(!planedir)
-- Plane direction is nearest value to 1
      !up = (abs(!pldir.up))
      !east = (abs(!pldir.east))
      !north = (abs(!pldir.north))
      !max = max((abs(!up)), (abs(!east)), (abs(!north)))
      if (!max eq !up)then
        !planedir = U wrt /*
      elseif (!max eq !east)then
        !planedir = E wrt /*
      else
        !planedir = N wrt /*
      endif
      --<<< ORIGINAL CODE used for calculating the Plane Direction(!planedir) to use
    endif

  else
    -->>> ORIGINAL CODE used for calculating the Plane Direction(!planedir)
    -- Plane direction is nearest value to 1
    !up = (abs(!pldir.up))
    !east = (abs(!pldir.east))
    !north = (abs(!pldir.north))
    !max = max((abs(!up)), (abs(!east)), (abs(!north)))
    if (!max eq !up)then
      !planedir = U wrt /*
    elseif (!max eq !east)then
      !planedir = E wrt /*
    else
      !planedir = N wrt /*
      endif
  endif
--<<< ORIGINAL CODE used for calculating the Plane Direction(!planedir) to use
--<wd>nov2004
-------------------------------------------------

------------------------------------------------------------------------
-- Move Thro STRU Origin if Structural Members Exist as the DATUM ATTA may NOW be OFFSET from the STRU
--<wd>jan2004>

  if (not !!ce.styp inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F',$
    'AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT60','AT61','AT68','AT100A','AT100B')) then
    if (!stru.mcount.eq(0)) then
      !attaldir = !!ce.ldir.wrt(/* )
      PLANE $!attaldir THRO $!datum
    else
      PLANE $!planedir THRO $!stru
    endif

  endif
--<wd>jan2004>

  if !form.support.type.eq('SPECIAL') then
    --PLANE $!pldir THRO $!datum
--<wd>jan2004>
--<ge 16/12/04 Added GT11 and ST14 fix for HPD0026997
    if (not !!ce.styp inset('GT11','ST14','AT33A','AT33B','AT33C','AT33D','AT33E','AT33F',$
      'AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT60','AT61','AT68','AT100A','AT100B')) then
      !attaldir = !!ce.ldir.wrt(/* )
      plane $!attaldir thro $!datum
    endif
  endif

------------------------------------------------------------------------
--<wd>jan2004
-- This CODE has been added to ENSURE that any GUIDE now available on MDS Frameworks
-- is in the SAME LOCATION/POSITION as its :MDSGUIDEREF
--if ((!cratta.stype inset ('AT30','SU03','SU04')) or (!cratta.stype.matchwild('SU01*')) or (!cratta.stype.matchwild('SU02*')) ) then
    if ((!!ce.stype inset ('GT01','GT06','GT07','GT08','GT14','GT18','GT19','GT21','GT26','GT28','GT39','AT30','SU03','SU04'))$
      or (!!ce.stype.matchwild('SU01*')) or (!!ce.stype.matchwild('SU02*'))) then
      if (!!ce.:mdsguideref.badref().not()) then
        !ldir = !!ce.:mdsguideref.ldir.wrt(/* )
        plane $!ldir thro $!!ce.:mdsguideref
      endif
    elseif (!!ce.stype inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42')) then
      if (!!ce.:mdsguideref.badref().not()) then
        !ldir = !!ce.:mdsguideref.ldir.wrt(/* )
        plane $!ldir thro $!!ce.:mdsguideref
      endif
    elseif (!!ce.stype inset ('AT62','AT69' )) then
      if (!form.support.idcomp.badref().not()) then
        !ldir = !form.support.idcomp.ldir.wrt(/* )
        plane $!ldir thro $!form.support.idcomp
      endif
    endif
--<wd>jan2004
------------------------------------------------------------------------

------------------------------------------------------------------------
--<wd>jan2004
-- Do NOT Orientate P3 of the ATTA to be the same as DATUM Atta if stype is a
  -- MDS Trunnion Base Plate Guide or STOP i.e. 'GT11','GT12A','GT12B','GT27A','GT27B','ST07'
  --<wd>22oct2009 - DFN P-25095 SI-14745 - MDS Guide types GT68 and GT69 added to the "if" statement
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added the following MDS TRUNNION B/Plate
  -- GUIDES and STOPS - GT65,GT84,GT66,GT67,ST45,ST46,ST47,ST48,ST49 and ST50
    if (not !!ce.styp inset('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST08','AN05', $
    'AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35', $
    'AT59','AT68','AT61','PIPE-REST-INLINE','AT100A','AT100B','ST14','ST33','ST15','ST16','GT68','GT69', $
    'GT65','GT84','GT66','GT67','ST45','ST46','ST47','ST48','ST49','ST50')) then
    !!ce = !datum
    VAR !dIR P3 DIR
      SAME
    ORI AND P3 IS $!dIR
    endif
--<wd>jan2004
------------------------------------------------------------------------

-- Add Marker Text to P9 of ATTAs for Clarity
  !!mdsaidtext(!form)

    -- Add atta to cross-bar 1
  !newAtta = !!ce

  !list = !form.support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
    enddo

    -- Set atta reference to datum cross bar
  !!ce = $!<suppName>-BAR-1
      handle any
      elsehandle none
    :MDSAttaRef $!references !newAtta.string()
        same
      endhandle

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  if (defined (!stru))then
    !colourList.append(!stru)
    endif
  !colourList.appendarray(!form.support.atta)

-- Because the atta may have been reorientated recall the transport function

  !newAtta = !!ce
  if (!!ce.type.eq('ATTA')) then
    Call !!mdsTransport(!newAtta,!suppName)
  endif

-- Colour Support
  Call !!kEnhanceList(!colourList)

-- Standards ST19, ST21, ST22 and ST23 require the automatic generation of LUGS

  !!mdsCreateLugs()

-- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

-- End function
endfunction
