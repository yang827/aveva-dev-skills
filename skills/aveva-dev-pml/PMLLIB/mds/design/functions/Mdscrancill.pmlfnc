--
-- File:    Mdscrancill.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MANCILL
--
-- Author:    I.osborne
-- Created:   Tue May 06
--
--
-- Description:
-- Function to create ancillary component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrAncill(!form is FORM)

  -- activate MDS DAC control variable
  !!mdsDacControl(true)

  -- Initialise variables
  !stru = !form.support.stru
  !name = !stru.name
  !selection = !!mdsAncill.standard.selection('Rtext')
  !type = !!ce.type

  -- retrieve preliminary support reference from !!mdsAncill and set it to nulref as its a single usage from variable
  !preliminary = !!mdsAncill.preliminarySupp
  !!mdsAncill.preliminarySupp = nulref

  --<kp> 31/05/2012 16:15:16
  if (!form.support.alias inset ('FT30')) then
    !isDatum = FALSE
  else
    !isDatum = !form.support.datum.badref()
  endif

  --<KP> Oct 2008  CTSUPP added
  if !type.eq('CTRAY') then
    !atta = 'CTSUPP'
  else
    !atta ='ATTA'
  endif
  ----------------------------------------------------------------------------------------------
  --<wd>jan2004

  -- Perform Any actions required BEFORE the Creation of a MDS ANCILLARY Standard ATTA
  !where = ''
  !set   = object MDSFRAMEANCILLS()
  !set.before(!form,!selection)
  if (!set.return) then
    !idcomp = !set.idcomp
    !where  = !set.where
  else
    -- Creation Aborted by USER during Identification via the Graphical View
    return
  endif

  -- Check if Identified Element is a DATUM Atta for Certain Types of MDS Ancillary
  --  if ( (!selection.matchwild('SU0*')) or  (!selection.matchwild('AT40*')) or (!selection.matchwild('AT41*')) or (!selection.matchwild('AT42*')) ) then
  --
  --  endif

  --<wd>jan2004
  ----------------------------------------------------------------------------------------------

  --<wd>feb2004
  -- New Functionality adding ALL Ancillary Types to MDS Frameworks requires a CHECK for the
  -- Type of ANCILLARY to be created for selecting from the /MDS Specification

  if (!selection inset ('AT59','AT68')) then
    !!ce = !form.support.idcomp
    -- Create the Selected PLAT type etc... on a TRUNNION Base Plates ONLY
    NEW PLAT SEL SPREF WITH STYP '$!selection' SPEC /MDS
    handle any
      DELETE PLAT
      !!alert.error('Support could not be selected. Check size is available at the type required')
      return
    endhandle

  else
    -- Determine Where to Create the Atta
    if (!selection inset ('AT60')) then
      !cecomp = !!mdsAncill.flan
    else
      !cecomp = ''
    endif

    -- Create the Selected ATTA type etc... on all other selected pipe branches
    if (!selection inset ('AT60')) then
      -- Navigate to the BRANCH as AT60 is created BEFORE or AFTER an Identified FLANGE
      branch
    else
      if !preliminary.set() then
        !!ce = !preliminary
      else
        !!ce = !form.support.idcomp
      endif
    endif

    --$P *** NEW ATTA $!where $!cecomp SEL SPREF WITH STYP '$!selection' SPEC /MDS  ***
    !selected = TRUE
    if !preliminary.badref() then
      --<kp> 31/05/2012 14:01:29
      if !form.support.preliminaryStore.set().and(!isDatum) then
        !!ce = object DBREF(!name & '_Pre')
        :mdssupptype default
        :mdssuppfunc default
      else
        NEW $!atta $!where $!cecomp
      endif
      --<kp> 31/05/2012 14:02:04
    endif

    if !atta.eq('CTSUPP') then
      !!ce.spref = !!mdsSelectSpref('ATTA',!!ce.owner.ppbo[1],!selection,/MDS )[1]
      handle ANY
        !selected = false
      endhandle
    else
      SEL SPREF WITH STYP '$!selection' SPEC /MDS
      handle any
        !selected = false
      endhandle
    endif
    if !selected.not() then
      if !preliminary.badref() then
        delete $!atta
      endif
      !!alert.error('Support could not be selected. Check size is available at the type required')
      return
    endif
  endif
  --<wd>feb2004

  -- Turn off pipe rest from material list
  if !selection.eq('PIPE-REST') then
    MTOC OFF
  elseif !selection.eq('PIPE-REST-INLINE') then
    MTOC OFF
  elseif !selection.eq('RACK-REST') then
    MTOC OFF
    handle ANY
    endhandle
  endif

  --<wd>feb2004
  if (!!ce.type.eq('ATTA')) then
    SPKBRK TRUE
  endif

  -- set the design parameters for the selected atta
  if (!!mdsSetDesPars(!!ce).not()) then
    return
  endif

  !!mdsDacControl(true)

  -- set Insulation spec...?
  !!mdsSetIspe()

  --  *************************
  --  Add stex for isometrics
  --  *************************

  !newAtta = !!ce
  --<wd>feb2004

  !!mdsSelLstu(!!ce)

  --  var !plbor PL BORE
  !!mdsDacControl(true)

  ----------------------------------------------------------------------------------------------
  --<wd>jan2004
  -- Perform ANY actions required AFTER the Creation of a MDS ANCILLARY Standard ATTA
  if (!set.return) then
    !set.form = !!mdsAncill
    !set.after(!idcomp,!newAtta)
  endif
  --<wd>jan2004

  ----------------------------------------------------------------------------------------------
  !!mdsDacControl(true)

  -- <kp>may2012
  -- give name to newly created atta
  !newAtta = !!ce
  !uniquenames = !!mdsoptions.mdsuniquenames
  if !isDatum.not() then
    --cannot unique name an FT30 ancillary because mdscrdatft30 relies upon the created line ancillary being named with a .1 suffix
    if !uniquenames and !form.support.alias.neq('FT30') then
      !attaname = '/' & !!mdsAncill.name.val
      !assoc = object MDSASSOCIATION(!stru,false)
      !assoc.addAssociation(!newAtta)
    else
      do !indx from 1
        !attaname = !name & '.' & !indx
        !attaname.dbref()
        handle NONE
          skip
        elsehandle ANY
          break
        endhandle
      enddo
    endif
    if !newAtta.isNamed.not() then
      !newAtta.name = !attaname
    endif
  endif

  if (!newAtta.type.eq('ATTA')) then
    if !uniquenames.and(!isDatum.not()) then
      !tname = !newAtta.namn
    else
      !tname = !name
    endif
    !!mdsTransport(!newAtta,!tname)
  endif

  if !preliminary.badref().not() then
    !newAtta.:mdssupptype = ''
  endif

  !form.support.atta.append(!newAtta)

  -- Always add atta to datum cross bar
  if (!form.support.bars.empty())then
    !form.support.bars[1][1] = !newAtta
  else
    !form.support.bars[1].append(!newAtta)
  endif


  -- Set the ATTA material
  !!mdssetmatref(!newAtta)

  -- Where the largest bore is part of the code then rest the bore
  if (!form.support.alias inset ('FT32', 'FT33', 'FT35' , 'FT36' , 'FT37' , 'FT38' , 'FT39' , 'FT40' )) then

    if (!form.support.alias inset ('FT33' , 'FT38' , 'FT39' )) then
      !dpNum = '4'
    elseif (!form.support.alias inset ('FT32')) then
      !dpNum = '3'
    else
      !dpNum = '5'
    endif
    !whereIWas = !!ce
    !srefname = !form.support.stru.name + '/SREF'
    !!ce = !srefname.dbref()
    handle none
      !largestbore = object BORE()
      !largestbore = !form.support.datum.ppbo[1]
      do !loop values !form.support.atta
        !largestbore = !loop.ppbo[1]
        if !loop.abore.gt(!largestbore) then
          !largestbore = !loop.ppbo[1]
        endif
      enddo
      !!mdsDacControl(true)
      -- Only set it if the bore is greater than the bore already stored
      !isNow = !!ce.desp[$!dpNum]
      if !largestbore.real().gt(!isNow) then
        DESPAR N$!dpNum $!largestbore
      endif
      !!ce = !whereIWas
    elsehandle any
    endhandle
  endif


  -- Check if type created is 'AT60'
  if (!newAtta.stype inset ('AT60')) then
    !xce  = !!ce
    !!ce  = !newAtta
    !flan = !set.idcomp.dbref()
    at $!flan
    !!ce = !xce
  endif

  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  -- Test user criteria
  !check = object MDSCHECKFRAME()
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    -- Remove atta from support object
    !form.support.atta.removeLast()
    if (!form.support.bars[1][1] EQ !newAtta)then
      !form.support.bars = ARRAY()
    else
      !form.support.bars[1].removeLast()
    endif
    -- Remove all actions calls executed after this function
    !!mdsAncill.action.clear()
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      -- Restore form state - done in cancel action
      !cancelAction = !!mdsAncill.cancelcall.replace('!this.', '!!mdsAncill.')
      $!cancelAction
      -- hide form
      !!mdsAncill.hide()
      return
    endif
    delete atta
    return
  else
    --criteria checks pass
    !!kRestoreUnits(!currentunits)
  endif

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

endfunction
