--
-- File:  MdscrdatFT50.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFT50()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsFT50.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsFT50.support.alias
  !fromAtta  = !!mdsFT50.support.preliminaryStore.set()
  !isDatum   = !!mdsFT50.support.datum.badref()

  -- if this is a prelim support conversion then select with the existing atta
  if !fromAtta and !isDatum then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
  else
    NEW ATTA
  endif
  SEL SPREF WITH STYP 'AC55' SPEC /MDS

  !units = object COMUNITS(TRUE)
  units mm bore
  units mm dist
  var !bore pl bore

  --get design parameters for the AC55
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattaobj.mdsdefsdata('AC55',!bore.real().value())
  !despars = !mdsattaobj.despars
  desp $!despars[1] $!despars[2] $!despars[3] $!despars[4] $!despars[5]  $!despars[6] $!despars[7] $!despars[8] $!despars[9] $!despars[10] $!despars[11]  $!despars[12] $!despars[13] $!despars[14]

  var !bore delete
  !!mdssetmatref(!!ce)
  !units.restoreSavedBoreDist()

  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  if (!!mdsFT50.support.idcomp.type.eq('BRAN')) then
    -- At a Branch Head
    if (!!mdsFT50.support.idcomp.hdir.up.abs().eq(1)) then
      -- Identified Pipe is VERTICAL
      !vertpipe = TRUE
    else
      -- Identified Pipe is HORIZ/SLOPING
      !vertpipe = FALSE
    endif
  else
    -- At a Branch Member component
    if (!!mdsFT50.support.idcomp.ldir.up.abs().eq(1)) then
      -- Identified Pipe is VERTICAL
      !vertpipe = TRUE
    else
      -- Identified Pipe is HORIZ/SLOPING
      !vertpipe = FALSE
    endif
  endif

  if (!vertpipe) then
    -- Identified Pipe is VERTICAL
    !!mdsMConn('10','N')
  else
    -- Identified Pipe is HORIZ/SLOPING
    !!mdsMConn('9','d')
  endif
  --<wd>dec2004
  -------------------------------------------------

  !!mdsDacControl(true)
  NAME $!datumName

  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- Create sref atta <tm select correct framework
  !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!alias , !!ce.lbor)
  if !supseq eq 0 then
    NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF
    handle any
      delete atta
      SAME
      delete ATTA
      !projStandard = !!mdsFT50.support.replace
      !!alert.error('Unable to select support ' & !projStandard & ' at this bore(' & !bore & ')')
      return
    endhandle
  else
    NEW ATTA SEL SPREF WITH STYP '$!alias-$!supseq' SPEC /MDF
    handle any
      delete atta
      SAME
      delete ATTA
      !projStandard = !!mdsFT50.support.replace
      !!alert.error('Unable to select support ' & !projStandard & ' at this bore(' & !bore & ')')
      return
    endhandle
  endif

  SPKBRK TRUE

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)
  !!mdsDacControl(true)

  PREV

  -- Store Datum in Support form
  !!mdsFT50.support.datum  = !!ce
  !!mdsFT50.support.paDir  = Pa Dir wrt world
  !!mdsFT50.support.plDir  = Pl Dir wrt world
  !!mdsFT50.support.p9Dir  = P9 Dir wrt world
  !!mdsFT50.support.p10Dir = P10 Dir wrt world
  !!mdsFT50.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsFT50.support.atta.clear()
  !!mdsFT50.support.atta.append(!!ce)

  NEXT

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsFT50.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')

  POS PA AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pOS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsFT50.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsFT50.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsFT50.datum.active = false

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

endfunction
