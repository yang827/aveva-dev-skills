--
-- File:  Mdscrdatfr02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
-- Author:  T.martin
-- Created:  28-11-03
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFR02()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
  !name = !!mdsFR02.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'

  !!mdsMConn('3','D')
  !!mdsDacControl(true)
  NAME $!datumName

  if !!ce.styp.eq('RACK-REST') then
    despar 0mm 0mm
  endif

  -- Store Datum in Support form
  !!mdsFR02.support.datum  = !!ce
  !!mdsFR02.support.pADir  = Pa Dir wrt world
  !!mdsFR02.support.pLDir  = Pl Dir wrt world
  !!mdsFR02.support.p9Dir  = P9 Dir wrt world
  !!mdsFR02.support.p10Dir = P10 Dir wrt world
  !!mdsFR02.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsFR02.support.atta.clear()
  !!mdsFR02.support.atta.append(!!ce)

  -- Create sref atta

  NEW ATTA SEL SPREF WITH STYP 'FR02-1' SPEC /MDF
  spkbrk $!!mdsFR02.sspkbrk
  handle ANY
  endhandle

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)

  NAME $!srefName
  !!mdsFR02.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  POS PA AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pos POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsFR02.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Check orientation of datum
  ----------------------------------------------------

  !!ce   = !datumName.dbref()
  --    spkbrk true
  !order = order
  if (!order.eq(1)) then
    dist 10
    head
    ileave tube
    !ori = ori wrt /*
    !!ce   = !datumName.dbref()
    ori $!ori
  else
    fconn and p30 is p30 of prev
    !ori = ori wrt /*
  endif

  !!ce = !srefName.dbref()
  sel lstu
  fconn and p30 is p30 of $!datumName
  !!ce = !datumName.dbref()
  !xat = !!ce
  !order = order

  -- Store the Identified Element DBREF

  prev
  handle any
    bran
    !xce = !!ce
  elsehandle none
    !xce = !!ce
  endhandle

  if (!xce.type.eq('FTUB')) then
    !!ce    = !xce
    !width  = !!mdsSetWid()
    !height = 0
  else
    !!ce = !datumName.dbref()
    if (!order.eq(1)) then
      dist 100
    else
      dist 100 from pl of prev
    endif

    !!ce = !xce
    if (!xce.type.eq('BRAN')) then
      head
      !hdir = hdir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori.delete()
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce = !xat
      !!ce = !datumName.dbref()
      ori $!ori
      -- this bit needs to be modified if the item is a bend
$(
    elseif  !xce.type.eq('BEND') then

      !av = object MDSPLINES()
      !orivals = !av.getangle(!xce)
      -- we need to decide if the datum is at the start of the bend
      -- after it or somewhere in the middle
      -- first of all we need to pop up a message asking where we want to place the atta.
      -- this needs to be a form which returns
      -- !!ce  = !currcomp
      !hdir = !orivals[4]
      -- position the atta at the centre of the bend
      !!ce   = !datumName.dbref()
      !!ce.position = !orivals[3]
      !!mdsFR02.support.position = TRUE
      !ori.delete()
      !ori  = 'ori PL is ' & !hdir & ' and Z ' & !orivals[6]
      !!ce = !datumName.dbref()
      ori $!ori
      !!ce = !xce
      next ftub
      var !dumvol lvol wrt ce
      !width = !dumvol.split()[1].real().abs() + !dumvol.split()[4].real().abs()
      -- need to use the width routine to work out the width on the bend
      -- got to the sref att and position it
      !!ce = !srefName.dbref()
      fconn and p30 is p30 of $!datumName
      same
$)
    else   $* ce type is not a branch or ftub
      -- !!ce  = !currcomp
      !hdir = ldir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori.delete()
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce  = !xat
      !!ce = !datumName.dbref()
      ori $!ori
    endif


    !!ce = !xce
    !height = 0
    -- if !xce.type.neq('BEND') then
    !width  = !!mdstraywidth(!xat, !xce, !height)
    -- endif
  endif
  !!ce = !xat

  !!mdsDacControl(true)
  !!ce = !datumName.dbref()
  despar n1 $!width
  despar n2 $!height

  if (!order.eq(1)) then
    fconn
    ori $!ori
    sel lstu
  else
    -- elseif !xce.type.neq('BEND') then
    fconn and p30 is p30 of prev
  endif
  ---------------------------------------------------------------------------

  !!mdsSelLstu(!!ce)

  !!ce = !!mdsFR02.support.datum
  !!mdsFR02.support.pADir  = Pa Dir wrt world
  !!mdsFR02.support.pLDir  = Pl Dir wrt world
  !!mdsFR02.support.p9Dir  = P9 Dir wrt world
  !!mdsFR02.support.p10Dir = P10 Dir wrt world
  !!mdsFR02.support.p11Dir = P11 Dir wrt world

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsFR02.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

  !!mdsFR02.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

endfunction
