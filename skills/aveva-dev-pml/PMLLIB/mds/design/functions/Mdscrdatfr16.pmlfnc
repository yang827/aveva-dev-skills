--
-- File:  Mdscrdatfr16.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
-- Author:  T.martin
-- Created:  23/02/2004 16:39
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFR16()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
  !name = !!mdsFR16.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'

  !!mdsMConn('3','D')
  !!mdsDacControl(true)
  NAME $!datumName

  if !!ce.styp.eq('RACK-REST') then
    despar 0mm 0mm
  endif

  -- Store Datum in Support form
  !!mdsFR16.support.datum  = !!ce
  !!mdsFR16.support.pADir  = Pa Dir wrt world
  !!mdsFR16.support.pLDir  = Pl Dir wrt world
  !!mdsFR16.support.p9Dir  = P9 Dir wrt world
  !!mdsFR16.support.p10Dir = P10 Dir wrt world
  !!mdsFR16.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsFR16.support.atta.clear()
  !!mdsFR16.support.atta.append(!!ce)

  -- Create sref atta

  NEW ATTA SEL SPREF WITH STYP 'FR16-1' SPEC /MDF
  spkbrk $!!mdsFR16.sspkbrk
  handle ANY
  endhandle



  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)

  NAME $!srefName
  !!mdsFR16.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  POS PA AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pOS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsFR16.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Check orientation of datum
  ----------------------------------------------------

  !!ce   = !datumName.dbref()
  !order = order
  if (!order.eq(1)) then
    dist 10
    head
    ileave tube
    !ori = ori wrt /*
    !!ce   = !datumName.dbref()
    ori $!ori
  else
    fconn and p30 is p30 of prev
    !ori = ori wrt /*
  endif

  !!ce = !srefName.dbref()
  sel lstu
  fconn and p30 is p30 of $!datumName
  !!ce = !datumName.dbref()
  !xat = !!ce
  !order = order

  -- Store the Identified Element DBREF

  prev
  handle any
    bran
    !xce = !!ce
  elsehandle none
    !xce = !!ce
  endhandle

  if (!xce.type.eq('FTUB')) then
    !!ce    = !xce
    !width  = !!mdsSetWid()
    !height = 0
  else
    !!ce = !datumName.dbref()
    if (!order.eq(1)) then
      dist 100
    else
      dist 100 from pl of prev
    endif

    !!ce = !xce
    if (!xce.type.eq('BRAN')) then
      head
      !hdir = hdir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori.delete()
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce = !xat
      !!ce = !datumName.dbref()
      ori $!ori
    else
      -- !!ce  = !currcomp
      !hdir = ldir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori.delete()
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce  = !xat
      !!ce = !datumName.dbref()
      ori $!ori
    endif
    !!ce = !xce
    !height = 0
    !width  = !!mdstraywidth(!xat, !xce, !height)
  endif
  !!ce = !xat

  !!mdsDacControl(true)
  !!ce = !datumName.dbref()
  despar n1 $!width
  despar n2 $!height

  if (!order.eq(1)) then
    fconn
    ori $!ori
    sel lstu
  else
    fconn and p30 is p30 of prev
  endif
  ---------------------------------------------------------------------------

  !!mdsSelLstu(!!ce)

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsFR16.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

  !!mdsFR16.datum.active = FALSE

  -- set default values for the connection heights
  !!mdsFR16.localfitt[1] = ARRAY()
  !elevation1 = 750
  !elevation2 = 750
  !elevation3 = !!mdsFR16.support.datum.position.wrt(/* ).up + !elevation1
  !elevation4 = !!mdsFR16.support.datum.position.wrt(/* ).up - !elevation2
  !!mdsFR16.localfitt[1][1] = !elevation3
  !!mdsFR16.localfitt[1][2] = !elevation4
  !!mdsFR16.conntop.val = !elevation1
  !!mdsFR16.connbot.val = !elevation2

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

endfunction
