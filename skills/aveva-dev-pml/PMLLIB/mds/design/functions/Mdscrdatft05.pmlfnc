--
-- File:    Mdscrdatft05.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS128
--
-- Author:    I.osborne
-- Created:   Tue Jun 24
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFt05()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
  !name = !!mdsft05.support.stru.name
  !datumname = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsft05.support.alias

  if (!alias eq 'FT05') then
    !!mdsMConn('3','D')
  endif
  !!mdsDacControl(true)

  NAME $!datumname

  if !!ce.styp.eq('RACK-REST') then
    despar 0mm 0mm
  endif
  !datum = !!ce

  -- Create sref atta
  !spec = /MDF
  !styp = !alias + '-C-1-1'
  !errmess = 'Cannot select ATTA with styp $!styp from /MDF spec. Contact your MDS administrator'

  !!mdsCreateAtta(!styp,!spec)
  handle ANY
    !error = !errmess
  endhandle

  if defined(!error) then
    delete $!!<ce.type>
    !!ce = !datum
    delete $!!<ce.type>
    !!mdsDacControl(true)
    !!alert.error(!error)
    return
  endif

  -- Store Datum in Support form
  !!mdsft05.support.datum  = !datum
  !adir = !datum.adir
  handle ANY
    !adir = !datum.pdir[1]
  endhandle
  !ldir = !datum.ldir
  handle ANY
    !ldir = !datum.pdir[2]
  endhandle
  !!mdsft05.support.pADir  = !adir.wrt(world)
  !!mdsft05.support.pLDir  = !ldir.wrt(world)
  !!mdsft05.support.p9Dir  = !datum.pdir[9].wrt(world)
  !!mdsft05.support.p10Dir = !datum.pdir[10].wrt(world)
  !!mdsft05.support.p11Dir = !datum.pdir[11].wrt(world)

  -- Store datum atta in Support form
  !!mdsft05.support.atta.clear()
  !!mdsft05.support.atta.append(!datum)

  SPKBRK TRUE
  handle ANY
  endhandle

  --<ge>Oct2005
  if !alias.eq('CT03').and(!!ce.type.eq('ATTA')) then
    SPKBRK FALSE
  endif
  --<ge>Oct2005


  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsft05.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  handle any
  endhandle
  POS P1 AT $!datumname
  !!ce = !datumname.dbref()

  -- Add marker text

  VAR !pOS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  if (!alias eq 'FT05') then
    !!mdsAncill.action[2] = ||
    !!mdsAncill.action[3] = ||
  endif

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  if !datum.type.eq('CTSUPP') then
    !levelGroup = 'CABLE'
  else
    !levelGroup = 'PIPE'
  endif
  call !!krepreLevel(!!ce, !levelGroup, !!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsft05.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Orientate datum support in correct orientation
  if (!alias eq 'FT05') then
    --<wd>feb2004
    --call !!mdsIBopDir(!!ce, !!mdsft05)
    if (not !!mdsft05.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
      call !!mdsIBopDir(!!ce, !!mdsft05)
    endif
    --<wd>feb2004
    ----------------------------------------------------
  elseif (!alias eq 'CT03' and !!ce.type eq 'ATTA') then
    !!ce   = !datumname.dbref()
    -- spkbrk TRUE
    spkbrk FALSE
    --<ge>Oct2005
    !order = order
    if (!order.eq(1)) then
      dist 10
      head
      ileave tube
      !ori = ori wrt /*
      !!ce   = !datumname.dbref()
      ori $!ori
    else
      fconn and p30 is p30 of prev
    endif

    !!ce = !srefName.dbref()
    sel lstu
    fconn and p30 is p30 of $!datumname
    !!ce = !datumname.dbref()
    !xat = !!ce
    !order = order

    -- Store the Identified Element DBREF

    prev
    handle any
      bran
      !xce = !!ce
    elsehandle none
      !xce = !!ce
    endhandle

    if (!xce.type.eq('FTUB')) then
      !!ce    = !xce
      !width  = !!mdsSetWid()
      !height = 0
    else
      !!ce = !datumname.dbref()
      if (!order.eq(1)) then
        dist 100
      else
        dist 100 from pl of prev
      endif

      !!ce = !xce
      if (!xce.type.eq('BRAN')) then
        head
        !hdir = hdir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori.delete()
        handle any
        endhandle
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce = !xat
        !!ce = !datumname.dbref()
        ori $!ori
      else
        -- !!ce  = !currcomp
        !hdir = ldir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori.delete()
        handle any
        endhandle
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce  = !xat
        !!ce = !datumname.dbref()
        ori $!ori
      endif
      !!ce = !xce
      !height = 0
      !width  = !!mdstraywidth(!xat, !xce, !height)
    endif
    !!ce = !xat

    !!mdsDacControl(true)
    !!ce = !datumname.dbref()
    despar n1 $!width
    despar n2 $!height

    if (!order.eq(1)) then
      fconn
      ori $!ori
      sel lstu
    else
      fconn and p30 is p30 of prev
    endif
    ---------------------------------------------------------------------------

    !!mdsSelLstu(!!ce)
  elseif (!alias eq 'CT03' and !!ce.type eq 'CTSUPP') then
    !width = !!ce.own.own.trayw
    !height = 0
    despar n1 $!width
    despar n2 $!height
  endif

  --<tm>25/08/2004 go and create lugs if it needs them
  !!ce = !datumname.dbref()
  !!mdsCreateLugs()


  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsft05.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

  !!mdsft05.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)


  -- End function
endfunction
