--
-- File:    Mdscrdatft06.pmlfnc
--   Type:    Function Definition
--   Group:    Multi Discipline Supports Application
--     Keyword:    MDS
--   Module:    design
--   Replaces:          MDATPS129
--
-- Author:    I.Osborne
-- Created:    Thu June 26
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFt06()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsFT06.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'

  !!mdsMConn('3','D')
  NAME $!datumName

  -- Store Datum in Support form
  !!mdsFT06.support.datum  = !!ce
  !!mdsFT06.support.pADir  = Pa Dir wrt world
  !!mdsFT06.support.pLDir  = Pl Dir wrt world
  !!mdsFT06.support.p9Dir  = P9 Dir wrt world
  !!mdsFT06.support.p10Dir = P10 Dir wrt world
  !!mdsFT06.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsFT06.support.atta.clear()
  !!mdsFT06.support.atta.append(!!ce)

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP 'FT06-C-1-1' SPEC /MDF

  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsFT06.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  POS PA AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pos POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  --  Clear Blocking form gadget Ancillary form
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsFT06.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Orientate datum support in correct orientation
  if (not !!mdsFT06.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
    call !!mdsIBopDir(!!ce, !!mdsFT06)
  endif

  --create lugs if it needs them
  !!ce = !datumName.dbref()
  !!mdsCreateLugs()

  -- Store representation level in form so that it can be reset later
  !colour = !!kFindDrawColour(!!ce)
  !ceName = !!ce.string()
  !!mdsFT06.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsFT06.datum.active = false

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

endfunction
