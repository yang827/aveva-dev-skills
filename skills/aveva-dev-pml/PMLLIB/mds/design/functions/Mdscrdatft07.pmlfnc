--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt07()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsFt07.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsFt07.Support.Datum  = !!CE
    !!MdsFt07.Support.PADir  = Pa Dir wrt world
    !!MdsFt07.Support.PLDir  = Pl Dir wrt world
    !!MdsFt07.Support.P9Dir  = P9 Dir wrt world
    !!MdsFt07.Support.P10Dir = P10 Dir wrt world
    !!MdsFt07.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFt07.Support.Atta.clear()
    !!MdsFt07.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'FT07-C-1' SPEC /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    VAR !TUBE (LSTU OF PREV)
      handle (2,470) (2,113)
        VAR !TUBE (HSTU OF BRAN)
      endhandle

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFt07.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFt07.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Orientate datum support in correct orientation
--<wd>feb2004                                                                                                                                                                  )
  --call !!MdsIBopDir(!!CE, !!MdsFt07)
    if (not !!mdsft07.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
      call !!MdsIBopDir(!!CE, !!MdsFt07)
    endif
--<wd>feb2004

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.string()
    !!MdsFT07.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFt07.datum.active = FALSE

    --<tm>25/08/2004 go and create lugs if it needs them
    !!ce = !datumname.dbref()
    !!MdsCreateLugs()

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatft07.pml
