--
-- File: Mdscrdatft11.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS134
--
-- Author:    I.Osborne
-- Created:   Mon Jul 14
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFt11()

-- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
    !name = !!mdsFt11.support.stru.name
    !datumName = !name & '/' & 'DATUM'
    !srefName  = !name & '/' & 'SREF'
    !alias     = !!mdsFt11.support.alias

    if (!alias eq 'FT11' or !alias eq 'FT38') then
      !!mdsMConn('3','D')
    elseif (!alias eq 'FT62' or !alias eq 'FT63') then
      !!mdsMConn('3','U')
    endif
    NAME $!datumName

  -- Store Datum in Support form
    !!mdsFt11.support.datum  = !!ce
    !!mdsFt11.support.paDir  = Pa Dir wrt world
    !!mdsFt11.support.plDir  = Pl Dir wrt world
    !!mdsFt11.support.p9Dir  = P9 Dir wrt world
    !!mdsFt11.support.p10Dir = P10 Dir wrt world
    !!mdsFt11.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!mdsFt11.support.atta.clear()
    !!mdsFt11.support.atta.append(!!ce)

  -- Create sref atta
    if (!alias eq 'FT11') then
      NEW ATTA SEL SPREF WITH STYP '$!alias-C-1' SPEC /MDF
      SPKBRK TRUE
    elseif (!alias eq 'FT38') then
      NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF
      spkbrk TRUE
      !pabore = !!ce.abore
      despar 0mm 0mm 0mm $!pabore 0mm
    elseif (!alias eq 'DT02') then
      NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF
      handle (42,64) (42,66)
        spref /MDF/DT02-1
      endhandle
      spkbrk FALSE
    elseif (!alias eq 'FT62' or !alias eq 'FT63') then
      NEW ATTA SEL SPREF WITH STYP '$!alias-1-1' SPEC /MDF
      SPKBRK TRUE
    endif

   !!mdsSetIspe()

    !!mdsSelLstu(!!ce)
    !!mdsDacControl(true)
    NAME $!srefName
    !!mdsFt11.support.atta.append(!!ce)

    !!mdsMConn('ORI','ORI')
    POS PA AT $!datumName
    !!ce = !datumName.dbref()

  -- Add marker text

    VAR !poS poS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!poS$>

  --  Clear Blocking form gadget Ancillary.frm
    if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
      !!mdsAncill.action[2] = ||
      !!mdsAncill.action[3] = ||
    endif

    !colour = !!kfindDrawcolour(!!ce)
    -- Add to model at level set by !!mdsOptions.levChange value
    call !!krepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
    !colourList = ARRAY()
    !colourList.appendarray(!!mdsFt11.support.atta)

  -- Colour Support
    call !!kenhanceList(!colourList)

  -- Check orientation of datum
    if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
      if (!!mdsFt11.support.paDir eq U or !!mdsFt11.support.plDir eq U) then
--<wd>feb2004
      --call !!mdsIBopDir(!!ce, !!mdsFt11)
      if (not !!mdsFt11.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!mdsIBopDir(!!ce, !!mdsFt11)
      endif
--<wd>feb2004
      endif
    endif

--<wd>jan2004
-- Check if type created is 'AT60'
    if (!datumName.dbref().stype inset ('AT60')) then
      !xce = !!ce
      !!ce = !datumName.dbref()
      at $!!mdsAncill.flan
      !!ce = !srefName.dbref()
      at $!!mdsAncill.flan
      !!ce = !xce
      !!mdsaidtext(!!mdsFt11)
      !!mdsFt11.support.position = TRUE
    endif
--<wd>jan2004

 -- Store representation level in form so that it can be reset later
    !ceName = !!ce.string()
    !!mdsFt11.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

    !!mdsFt11.datum.active = FALSE

-- If the element being created is an inline rest and the previous element is a baseplate get the thickness
-- of the baseplate and set the distance gadget to the thickness and execute the dist gadget

  if !alias eq 'FT11' then
    !form = !!mdsFt11
    if !!mdsCheckTrun(!form,'ALL') then
      prev
--<wd>oct2004 -- Added 'AC57' to the inset list and also the sub-check inset for 'AC30','AC57'
--<dw>oct2008 dun979 - Also to allow for additional trunnion base plates types AC60 to AC67
      if (!!ce.styp inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46','AC56','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
        --><wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
        --if (!!ce.styp inset('AC30','AC57')) then
        if (!!ce.styp inset('AC30','AC57', 'AC67')) then
          --<<wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
          !basePlateThickness = '0'
        else
          var !basePlateThickness const dist pa to pl
        endif
        !form.dist.val = $!basePlateThickness
        !callBack = !form.bdist.callBack
        $!callBack
      endif
      next
      !form.dist.active = FALSE
      !form.bdist.active = FALSE
      !form.select.active = FALSE
      !form.bthro.active = FALSE
    else
--<wd>jan2004
      if (!datumName.dbref().stype inset ('AT60')) then
        !!ce = !datumName.dbref()
        if (!!ce.order.eq(1)) then
          !at60dist = !!kstrreal('cons dist p0 to ph')
        else
          !at60dist = !!kstrreal('cons dist p0 to p0 of previous')
        endif
        !form.dist.val      = $!at60dist
        !form.support.position = TRUE
        !form.dist.active   = FALSE
        !form.bdist.active  = FALSE
        !form.select.active = FALSE
        !form.bthro.active  = FALSE
--<wd>jan2004
      else
        !form.dist.active = TRUE
        !form.bdist.active = TRUE
        !form.select.active = TRUE
        !form.bthro.active = TRUE
      endif
    endif
  endif


 --<tm>25/08/2004 go and create lugs if it needs them
  !!ce = !datumName.dbref()
  !!mdsCreateLugs()

-- Deactivate MDS DAC control variable

  !!mdsDacControl(false)


-- End function
endfunction
