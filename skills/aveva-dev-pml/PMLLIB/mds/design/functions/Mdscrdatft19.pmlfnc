--------------------------------------------------------------------------------
--
-- File: Mdscrdatft19.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS143
--
-- Author:    Wayne Dodwell
-- Created:   Monday 15 September 1997
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFt19()

  -- Activate MDS DAC control variable
  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsFt19.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsFt19.support.alias

  !!mdsMConn('3','D')
  !!mdsDacControl(true)
  NAME $!datumName

  if !!ce.styp.eq('RACK-REST') then
    despar 0mm 0mm
  endif
  !datum = !!ce

  -- Store Datum in Support form
  !!mdsFt19.support.datum  = !!ce
  !adir = !datum.adir
  handle ANY
    !adir = !datum.pdir[1]
  endhandle
  !ldir = !datum.ldir
  handle ANY
    !ldir = !datum.pdir[2]
  endhandle
  !!mdsFt19.support.paDir  = !adir.wrt(world)
  !!mdsFt19.support.plDir  = !ldir.wrt(world)
  !!mdsFt19.support.p9Dir  = !datum.pdir[9].wrt(world)
  !!mdsFt19.support.p10Dir = !datum.pdir[10].wrt(world)
  !!mdsFt19.support.p11Dir = !datum.pdir[11].wrt(world)

  -- Store datum atta in Support form
  !!mdsFt19.support.atta.clear()
  !!mdsFt19.support.atta.append(!!ce)

  -- Create sref atta
  !spec = /MDF
  !styp = !alias + '-1-1'
  !errmess = 'Cannot select ATTA with styp $!styp from /MDF spec. Contact your MDS administrator'

  !!mdsCreateAtta(!styp,!spec)
  handle ANY
    !error = !errmess
  endhandle

  if defined(!error) then
    delete $!!<ce.type>
    !!ce = !datum
    delete $!!<ce.type>
    !!mdsDacControl(true)
    !!alert.error(!error)
    return
  endif

  SPKBRK TRUE
  handle ANY
  endhandle

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsFt19.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  handle any
  endhandle
  POS P1 AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !poS poS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!poS$>

  --  Clear Blocking form gadget Ancillary.frm
  if (!alias eq 'FT19') then
    !!mdsAncill.action[2] = ||
    !!mdsAncill.action[3] = ||
  endif

  !colour = !!kfindDrawcolour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  if !datum.type.eq('CTSUPP') then
    !levelGroup = 'CABLE'
  else
    !levelGroup = 'PIPE'
  endif
  call !!krepreLevel(!!ce, !levelGroup, !!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsFt19.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- Check orientation of datum
  ----------------------------------------------------
  if (!alias eq 'FT19') then
    if (!!mdsFt19.support.paDir eq U or !!mdsFt19.support.plDir eq U) then
      --<wd>feb2004
      --call !!mdsIBopDir(!!ce, !!mdsFt19)
      if (not !!mdsFt19.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!mdsIBopDir(!!ce, !!mdsFt19)
      endif
      --<wd>feb2004
    endif
  elseif (!alias eq 'CT07' and !!ce.type eq 'ATTA') then
$(
    !!ce   = !datumName.dbref()
    !order = order
    if (!order.eq(1)) then
      dist 10
      head
      ileave tube
      !ori = ori wrt /*
      !!ce   = !datumName.dbref()
      ori $!ori
    else
      fconn and p30 is p30 of prev
    endif
$)

    !!ce = !srefName.dbref()
    sel lstu
    fconn and p30 is p30 of $!datumName
    --<ge>Oct2005
    -- spkbrk TRUE
    spkbrk FALSE
    --<ge>Oct2005
    !!ce = !datumName.dbref()
    --<ge>Oct2005
    spkbrk FALSE
    --<ge>Oct2005
    !xat = !!ce
    !order = order
    -- Store the Identified Element DBREF

    prev
    handle any
      bran
      !xce = !!ce
    elsehandle none
      !xce = !!ce
    endhandle

    if (!xce.type.eq('FTUB')) then
      !!ce    = !xce
      !width  = !!mdsSetWid()
      !height = 0
    else
      !!ce = !datumName.dbref()
      if (!order.eq(1)) then
        dist 100
      else
        dist 100 from pl of prev
      endif

      !!ce = !xce
      if (!xce.type.eq('BRAN')) then
        head
        !hdir = hdir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori.delete()
        handle any
        endhandle
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce = !xat
        !!ce = !datumName.dbref()
        ori $!ori
      else
        -- !!ce  = !currcomp
        !hdir = ldir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori.delete()
        handle any
        endhandle
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce  = !xat
        !!ce = !datumName.dbref()
        ori $!ori
      endif
      !!ce = !xce
      !height = 0
      !width  = !!mdstraywidth(!xat, !xce, !height)
    endif
    !!ce = !xat

    !!mdsDacControl(true)
    !!ce = !datumName.dbref()
    despar n1 $!width
    despar n2 $!height

    if (!order.eq(1)) then
      fconn
      ori $!ori
      sel lstu
    else
      fconn and p30 is p30 of prev
    endif
    ---------------------------------------------------------------------------

    !!mdsSelLstu(!!ce)
  elseif (!alias eq 'CT07' and !!ce.type eq 'CTSUPP') then
    !width = !!ce.own.own.trayw
    !height = 0
    despar n1 $!width
    despar n2 $!height
  endif
  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsFt19.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

  !!mdsFt19.datum.active = false

  -- Deactivate MDS DAC control variable

  -- If the element being created is an inline rest and the previous element is a baseplate get the thickness
  -- of the baseplate and set the distance gadget to the thickness and execute the dist gadget
  !form = !!mdsFt19
  if !!mdsCheckTrun(!form,'ALL') then
    prev
    --<wd>oct2004 -- Added 'AC57' to the inset list and also the sub-check inset for 'AC30','AC57'
    --<dw>oct2008 dun979 - Also to allow for additional trunnion base plates types AC60 to AC67
    if (!!ce.styp inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46','AC56','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
      --><wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
      --if (!!ce.styp inset('AC30','AC57')) then
      if (!!ce.styp inset('AC30','AC57', 'AC67')) then
        --<<wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
        !basePlateThickness = '0'
      else
        var !basePlateThickness const dist pa to pl
      endif
      !form.dist.val = $!basePlateThickness
      !callBack = !form.bdist.callBack
      $!callBack
    endif
    next
    !form.dist.active = FALSE
    !form.bdist.active = FALSE
    !form.select.active = FALSE
    !form.bthro.active = FALSE
  else
    --<wd>jan2004
    if (!datumName.dbref().stype inset ('AT60')) then
      !!ce = !datumName.dbref()
      if (!!ce.order.eq(1)) then
        !at60dist = !!kstrreal('cons dist p0 to ph')
      else
        !at60dist = !!kstrreal('cons dist p0 to p0 of previous')
      endif
      !form.dist.val      = $!at60dist
      !form.support.position = TRUE
      !form.dist.active   = FALSE
      !form.bdist.active  = FALSE
      !form.select.active = FALSE
      !form.bthro.active  = FALSE
      --<wd>jan2004
    else
      !form.dist.active = TRUE
      !form.bdist.active = TRUE
      !form.select.active = TRUE
      !form.bthro.active = TRUE
    endif
  endif

  !!mdsDacControl(false)

  -- End function
endfunction
