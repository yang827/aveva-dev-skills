--
-- File:		Mdscrdatft24.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS148
--
-- Author:		I.Osborne
-- Created:		Wed Aug 06
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt24()


-- Activate MDS DAC control variable

  !!MdsDacControl(true)



  -- Initialise variables
    !Name = !!MdsFt24.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsFt24.Support.Datum  = !!CE
    !!MdsFt24.Support.PADir  = Pa Dir wrt world
    !!MdsFt24.Support.PLDir  = Pl Dir wrt world
    !!MdsFt24.Support.P9Dir  = P9 Dir wrt world
    !!MdsFt24.Support.P10Dir = P10 Dir wrt world
    !!MdsFt24.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFt24.Support.Atta.clear()
    !!MdsFt24.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'FT24-A-1' SPEC /MDF

    SPKBRK TRUE

    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFt24.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFt24.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.name
    !!MdsFt24.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFt24.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatft24.pml
