--
-- File:		Mdscrdatft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          5
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 3rd December 1997
--
--
-- Description:
-- Create Datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscrdatft25()

-- Activate MDS DAC control variable

    !!MdsDacControl(true)



  -- Initialise variables
    !name = !!Mdsft25.support.stru.name
    !datumname = !name & '/' & 'DATUM'
    !srefname  = !name & '/' & 'SREF'

    !!MdsMConn('3','D')
    name $!datumname

-- Store Datum in Support form
    !!Mdsft25.support.datum  = !!ce
    !!Mdsft25.support.padir  = pa dir wrt world
    !!Mdsft25.support.pldir  = pl dir wrt world
    !!Mdsft25.support.p9dir  = p9 dir wrt world
    !!Mdsft25.support.p10dir = p10 dir wrt world
    !!Mdsft25.support.p11dir = p11 dir wrt world

-- Store datum atta in Support form
    !!Mdsft25.support.atta.clear()
    !!Mdsft25.support.atta.append(!!ce)

-- Create sref atta
    new atta sel spref with styp 'FT25-A-1' spec /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    name $!srefname
    !!Mdsft25.support.atta.append(!!ce)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

-- Add marker text
    var !pos pos wrt world

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

--  Clear Blocking form gadget Ancillary.frm
    !!Mdsancill.action[2] = ||
    !!Mdsancill.action[3] = ||

-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.appendarray(!!Mdsft25.support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Check orientation of datum
    if (!!Mdsft25.support.padir eq U or !!Mdsft25.support.pldir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt25)
      if (not !!mdsft25.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt25)
      endif
--<wd>feb2004
    endif

-- Store representation level in form so that it can be reset later
    !colour = !!kfinddrawcolour(!!ce)
    !cename = !!ce.name
    !!Mdsft25.repre.append('!!Mdsremadd(|$!cename|,$!colour)')

-- Set Form Member .fatta to the Datum Atta
    !!Mdsft25.fatta = !datumname.dbref()
-- Set Form Member .crbar to 'unset'
    !!Mdsft25.crbar = =0/0

-- Now datum has been created datum button is now made 'inactive'
    !!Mdsft25.datum.active = false

-- Set default clearance obtained from datum atta defaults and make gadget active
    !Dflts = object MDSANCGEOMDFLTS(!!Mdsft25.support.datum)
    !!Mdsft25.clear.val = !Dflts.Oend
    !!Mdsft25.clear.active = TRUE

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
  endfunction

-- End of file Mdscrdatft25.pml
