--
-- File:		Mdscrdatft28.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDAT152
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 4th November 1997
--
--
-- Description:
-- Create Datum atta for Framework type 'FT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdscrdatft28()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!Mdsft28.support.stru.name
    !datumname = !name & '/' & 'DATUM'
    !srefname  = !name & '/' & 'SREF'

    !!MdsMConn('3','D')
    name $!Datumname

-- Store Datum in Support form
    !!Mdsft28.support.datum  = !!ce
    !!Mdsft28.support.padir  = pa Dir wrt world
    !!Mdsft28.support.pldir  = pl dir wrt world
    !!Mdsft28.support.p9dir  = p9 dir wrt world
    !!Mdsft28.support.p10dir = p10 dir wrt world
    !!Mdsft28.support.p11dir = p11 dir wrt world

-- Store datum atta in Support form
    !!Mdsft28.support.atta.clear()
    !!Mdsft28.support.atta.append(!!ce)

-- Create sref atta
    new atta sel spref with styp 'FT28-1' spec /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    name $!srefname
    !!Mdsft28.support.atta.append(!!ce)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()


-- Add marker text
    var !pos pos wrt world

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

--  Clear Blocking form gadget Ancillary.frm
    !!Mdsancill.action[2] = ||
    !!Mdsancill.action[3] = ||

-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.appendarray(!!Mdsft28.support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Check orientation of datum
    if (!!Mdsft28.support.padir eq U or !!Mdsft28.support.pldir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt28)
      if (not !!mdsft28.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt28)
      endif
--<wd>feb2004
    endif

-- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.name
    !!MdsFt28.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

-- Now datum has been created datum button is now made 'inactive'
    !!Mdsft28.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatft28.pml
