--
-- File:		MdscrdatFt29.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS142
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 27 August 1997
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt29()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


-- Initialise variables
  !Name = !!MdsFt29.Support.Stru.name
  !DatumName = !Name & '/' & 'DATUM'
  !SrefName  = !Name & '/' & 'SREF'
  !Alias     = !!MdsFt29.Support.Alias

  !!MdsMConn('3','D')
  NAME $!DatumName

-- Store Datum in Support form
  !!MdsFt29.Support.Datum  = !!CE
  !!MdsFt29.Support.PADir  = Pa Dir wrt world
  !!MdsFt29.Support.PLDir  = Pl Dir wrt world
  !!MdsFt29.Support.P9Dir  = P9 Dir wrt world
  !!MdsFt29.Support.P10Dir = P10 Dir wrt world
  !!MdsFt29.Support.P11Dir = P11 Dir wrt world

-- Store datum atta in Support form
  !!MdsFt29.Support.Atta.clear()
  !!MdsFt29.Support.Atta.append(!!CE)

-- Create sref atta
  NEW ATTA SEL SPREF WITH STYP '$!Alias-1' SPEC /MDF
    handle (42,501)(42,64)
      prev
      !Bore = pl bore
--<wd>jan2006<mds12> -- This should be for !!CODEFT29 and NOT !!CODEAT29 as shown below!
--    !!Alert.Error('Unable to create support $!!CODEAT29 on this size line ($!Bore)')
--
-- Get the Client CODE of the MDS STRUCTURE FRAMEWORK
      !stype = '$!alias'
      !ctype = !!mdsgetdefprop('STRUCTURE', !stype, 'CCOD')
      !!alert.error('$!!error.text <STYPE $!<alias>-1 is NOT available> ** Unable to create support $!ctype on this line ($!Bore)')
--<wd>jan2006<mds12>
      next
      delete atta
      same
      !!CE = !!MdsFt29.Support.Datum
      delete atta
      !!MdsFt29.Support.datum = =0/0
      return
    endhandle

  SPKBRK TRUE

  !!MdsSetIspe()

  !!MdsSelLstu(!!CE)
  !!MdsDacControl(true)
  NAME $!SrefName
  !!MdsFt29.Support.Atta.append(!!CE)

  !!MdsMConn('ORI','ORI')
  POS PA AT $!DatumName
  !!CE = !DatumName.dbref()

-- Add marker text

  VAR !POS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

--  Clear Blocking form gadget Ancillary.frm

  !!MdsAncill.Action[2] = ||
  !!MdsAncill.Action[3] = ||

  !Colour = !!KFindDrawColour(!!CE)
  -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

-- Enhance elements using colour set for highlight
  !ColourList = array()
  !ColourList.appendarray(!!MdsFt29.Support.Atta)

-- Colour Support
  call !!KEnhanceList(!ColourList)

-- Check orientation of datum
  if (!!MdsFt29.Support.PaDir eq U or !!MdsFt29.Support.PlDir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt29)
      if (not !!mdsft29.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt29)
      endif
--<wd>feb2004
  endif

-- Store representation level in form so that it can be reset later
  !CeName = !!CE.string()
  !!MdsFt29.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

-- Now datum has been created freeze datum button
  !!MdsFt29.datum.active = false

-- Modified <wd - 17aug1998>
-- Now datum has been created Activate CHANGE datum button
  !!MdsFt29.newdat.active = true
-- Modified <wd - 17aug1998>

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file MdscrdatFt29.pml
