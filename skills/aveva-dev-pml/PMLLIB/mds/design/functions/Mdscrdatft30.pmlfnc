--------------------------------------------------------------------------------
--
-- File: Mdscrdatft30.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:          MDATPS133
--
-- Author: I.Osborne
-- Created: Thu Jul 03
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatft30()

  !currentunits = !!kgetsetunits()

-- Activate MDS DAC control variable

  !unusedType     = !!mdsft30.support.type
  !!mdsDacControl(true)
  !elbo = !!mdsft30.support.atta[1]
  !unusedTube = !!mdsft30.support.atta[1]
  !!mdsft30.support.atta.removefirst()
  !!mdsft30.support.atta.removefirst()

  !!ce = !elbo
  var !radius const dist p0 to p1

-- orientate the elbo so that p3 is in the right direction

  !patest = pa dir wrt /*
  !pltest = pl dir wrt /*
  if !!ce.ppos[3].up.lt(!!ce.ppos[2].up) then
    flip ori
    ori pa is $!patest and pl is $!pltest
    !unusedWhere = 'beh'
  endif

-- Current position is the tube atta
  same
  !vert = !!ce
  pipe
  !pipeName = name
  same
  !lugSelected = !!mdsAncill.standard.selection()
  sel with styp '$!lugSelected' spec /MDS
  dist 0
  ori
  thro $!elbo
  !dist = !!ce.position.distance(!elbo.position)
  !hdir = !!ce.position.direction(!elbo.position)
  !unusedTdir = !hdir.opposite()
  move u dist $!dist inf $!elbo

-- If the lug is higher that the elbo we need to make it lower

  if !!ce.position.up.gt(!elbo.position.up) then
    move d dist $!dist inf $!elbo
  endif

-- create tee for lug
  new tee
  if !!mdsselectcomp('TEE').not() then
    delete tee
    !!alert.error('Cannot Select set on tee for Lug Generation')
    return
  endif

  !tee = !!ce
  !!mdsDacControl(true)
  conn and p3 is $!hdir
    handle any
      fconn and p3 is $!hdir
    endhandle
  sel lstu

--<dw>aug2008 dun979 - flow direction turned off
  new bran flowdir OFF
  :MDSTrun true
  connect ph to p3 of same
  handle (42,64)
  endhandle
  name $!pipeName/$!!mdsft30.name$n/2
  include $!vert
  !!ce = !vert
  conn to ph and p5 is u
  tail
  conn pt to last mem

 -- go and do the elbo lug

  !!ce = !elbo

-- Find elevation of elbo and work out elevation of tube lug
--<dw>aug2008 dun979 - flow direction turned off
  new bran flowdir OFF
  :MDSTrun true
  connect ph to p3 of same
  handle (42,64)
  endhandle

  hdir d tdir u
  sel hstu
  name $!pipeName/$!!mdsft30.name$n/1
  !unusedTod = ph od
  !phBore = ph bore

  -- !Hyp = !radius.real() + (!od / 2)
  -- !Side1 = !radius.real() + (!tod / 2)
  -- !Offset = (sqrt ((!Hyp * !Hyp) - (!Side1 * !Side1)))

-- makeup piece

  new redu select spref with styp 'MAKEUP' spec /MDS
  -- spkbrk true
  despar $!phBore  $!radius 0mm
  sel lstu
  connect to ph
    handle (7,3)
      fconnect to ph
    endhandle
  -- atty CCNN
  name /$!!mdsft30.name.val/MAKEUP
  !!mdsft30.support.atta.append(!!ce)

-- Sref atta

  new atta select spref with styp 'FT30-1' spec /MDF
  handle any
    !!alert.error('Unable to create support for identified pipe bores')
    !!kRestoreUnits(!currentunits)
    $!pipeName/$!!mdsft30.name$n/1
    delete bran
    $!pipeName/$!!mdsft30.name$n/2
    delete bran
    /$!!mdsft30.name
    delete stru
    $!tee
    delete tee
    hide !!mdsft30
    return
  endhandle
  sel lstu
  connect to prev
    handle (7,3)
      fconnect to prev
    endhandle
  atty CCNN
  name /$!!mdsft30.name.val/SREF
  !!mdsft30.support.atta.append(!!ce)

-- Lug atta

  new atta despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
  stext '$!!mdsft30.name.val'
  !!mdsft30.support.datum = !!ce
  spkbrk true
  select spref with styp '$!lugSelected' spec /MDS
  sel lstu
  -- $p  connect and p5 is $!patest
  connect and p5 is $!patest
  handle any
    -- $p  fconnect and p5 is $!patest
     fconnect and p5 is $!patest
     handle any
     -- $p  connect and p5 is $!pltest
      connect and p5 is $!pltest
        handle any
       -- $p   fconnect and p5 is $!pltest
         fconnect and p5 is $!pltest
        endhandle
     endhandle
  endhandle
  name /$!!mdsft30.name.val/DATUM
  !!mdsft30.support.atta.append(!!ce)
  :MDSSuppType 'FT30'
  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)
  despar n9 0mm
  bran
  conn pt to last mem
  tconn clos

  !!mdsDacControl(true)

-- Set the material and shop flags for all comps except the notes
-- and remove the insulation automatically

  bran
  ispe =0
  !members = mem count
  do !set from 1 to !members
    bran
    $!set
    !!mdssetmatref(!!ce)
      handle any
      endhandle
    ispe =0
  enddo

  bran

------------------------------------------------------------------------------------------------
-- mjb >>> 31.03.06 <mds12>

  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedMdsattadefs = !mdsattaobj.mdsdefsdata(!!mdsft30.support.datum.stype,!phBore.real().value())
  !shop = !mdsattaobj.shop

  --!shop = !!mdspar$!lugSelected[$!phBore].shop

  shop $!shop
-- mjb >>> end of mod
------------------------------------------------------------------------------------------------

  do !set from 1 to !members
    bran
    $!set
    shop $!shop
  enddo

  -- adjust the lugs to get 45 degrees based on the positions of p4 of each lug

  pin 1 at p4 of $!vert
  pin 1 dir u
  pin 2 copy pin 1
  pin 2 throu p4 of /$!!mdsft30.name.val/DATUM
  pin 3 at p4 of /$!!mdsft30.name.val/DATUM
  var !dist1 const dist pin 1 to pin 2
  var !dist2 const dist pin 3 to pin 2
  !move = !dist1.real() - !dist2.real()
  !!ce = !tee
  !od = !!ce.pod[1]
  by u $!move
  goto cref
  conn ph to p3 of href
  !!ce = !vert
  conn to ph and p5 is u
  !despars = !!ce.despar
  !!ce.desp[3] = !despars[4] + !despars[5] - !od / 2
  tail
  conn pt to last mem


  -- set the Dim1 gadget
  !dim = !elbo.position.up - !vert.ppos[4].up
  !!mdsft30.dim1.val = !dim

  call !!mdsResetPins(1,3)
  -- Initialise variables
    !name = !!mdsft30.support.stru.name
    !unusedDatumName = !name & '/' & 'DATUM'
    !unusedSrefName  = !name & '/' & 'SREF'
    /$!!mdsft30.name.val/SREF
   desp $!dim
 -- NAME $!datumName
  /$!!mdsft30.name.val/DATUM
  -- Store Datum in Support form
    !!mdsft30.support.datum  = !!ce
    !!mdsft30.support.paDir  = Pa Dir wrt world
    !!mdsft30.support.plDir  = Pl Dir wrt world
    !!mdsft30.support.p9Dir  = P9 Dir wrt world
    --!!mdsft30.support.p10Dir = P10 Dir wrt world
    --!!mdsft30.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
 --   !!mdsft30.support.atta.clear()
  --  !!mdsft30.support.atta.append(!!ce)

  -- Add marker text

    VAR !pos POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  --  Clear Blocking form gadget Ancillary.frm
    !!mdsAncill.action[2] = ||
    !!mdsAncill.action[3] = ||

  -- Enhance elements using colour set for highlight
    !colourList = ARRAY()
    !colourList.appendarray(!!mdsft30.support.atta)

  -- Colour Support
    call !!kenhanceList(!colourList)

 -- Store representation level in form so that it can be reset later
    !colour = !!kfindDrawColour(!!ce)
    !ceName = !!ce.name
    !!mdsft30.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- go and create the support
  !!kRestoreUnits(!currentunits)
  !!mdsCreateFT30('CURSOR')

  -- Now datum has been created freeze datum button
    !!mdsft30.datum.active = false

-- Deactivate MDS DAC control variable

  !!mdsDacControl(false)
  !!kRestoreUnits(!currentunits)
-- End function
endfunction
