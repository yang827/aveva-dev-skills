--
-- File:		Mdscrdatft31.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS127
--
-- Author:		I.Osborne
-- Created:		Tue Jun 23
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt31()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsFt31.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias = !!MdsFt31.Support.Alias

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsFt31.Support.Datum  = !!CE
    !!MdsFt31.Support.PADir  = Pa Dir wrt world
    !!MdsFt31.Support.PLDir  = Pl Dir wrt world
    !!MdsFt31.Support.P9Dir  = P9 Dir wrt world
    !!MdsFt31.Support.P10Dir = P10 Dir wrt world
    !!MdsFt31.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFt31.Support.Atta.clear()
    !!MdsFt31.Support.Atta.append(!!CE)

  -- Create sref atta

    NEW ATTA SEL SPREF WITH STYP '$!Alias' SPEC /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFt31.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    if (!Alias eq 'FT31') then
      !!MdsAncill.Action[2] = ||
      !!MdsAncill.Action[3] = ||
    endif

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFt31.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!MdsFt31.Support.PaDir eq U or !!MdsFt31.Support.PlDir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt31)
      if (not !!mdsft31.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt31)
      endif
--<wd>feb2004
    endif

  -- Store representation level in form so that it can be reset later
    !CeName = !!CE.string()
    !!MdsFt31.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFt31.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatft31.pml
