--
-- File:		Mdscrdatft33.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS138
--
-- Author:		I.Osborne
-- Created:		Tue Jul 22
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt33()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsFt33.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!MdsFt33.Support.Alias

    if (!Alias eq 'FT33') then
      !!MdsMConn('3','D')
    endif
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsFt33.Support.Datum  = !!CE
    !!MdsFt33.Support.PADir  = Pa Dir wrt world
    !!MdsFt33.Support.PLDir  = Pl Dir wrt world
    !!MdsFt33.Support.P9Dir  = P9 Dir wrt world
    !!MdsFt33.Support.P10Dir = P10 Dir wrt world
    !!MdsFt33.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFt33.Support.Atta.clear()
    !!MdsFt33.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP '$!Alias-1' SPEC /MDF

    if !Alias.eq('FT33') then
      !Pabore = !!ce.abore
      despar 0mm 0mm 0mm $!Pabore 0mm
    endif
    SPKBRK TRUE

    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)

    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFt33.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    if (!Alias eq 'FT33') then
      !!MdsAncill.Action[2] = ||
      !!MdsAncill.Action[3] = ||
    endif

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFt33.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!Alias eq 'FT33') then
      if (!!MdsFt33.Support.PaDir eq U or !!MdsFt33.Support.PlDir eq U) then
--<wd>feb2004
        --call !!MdsIBopDir(!!CE, !!MdsFt33)
        if (not !!mdsft33.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
          call !!MdsIBopDir(!!CE, !!MdsFt33)
        endif
--<wd>feb2004
      endif
    endif

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.string()
    !!MdsFt33.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFt33.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdscrdatft33.pml
