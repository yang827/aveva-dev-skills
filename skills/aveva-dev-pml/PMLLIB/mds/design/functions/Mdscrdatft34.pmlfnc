--
-- File:		MdscrdatFT34.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS138
--
-- Author:		I.Osborne
-- Created:		Tue Jul 22
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFT34()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsFT34.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!MdsFT34.Support.Alias

    !!MdsMConn('3','D')
    NAME $!DatumName

    -- if we are are creating type C ori P10 U
    if (!Alias.eq('FT34C')) then
      ori and p10 is U wrt world
    endif

  -- Store Datum in Support form
    !!MdsFT34.Support.Datum  = !!CE
    !!MdsFT34.Support.PADir  = Pa Dir wrt world
    !!MdsFT34.Support.PLDir  = Pl Dir wrt world
    !!MdsFT34.Support.P9Dir  = P9 Dir wrt world
    !!MdsFT34.Support.P10Dir = P10 Dir wrt world
    !!MdsFT34.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFT34.Support.Atta.clear()
    !!MdsFT34.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA
    -- attempt to find a suitable template for this bore
    SEL SPREF WITH STYP '$!Alias-1' SPEC /MDF
    handle any
      SEL SPREF WITH STYP '$!Alias-2' SPEC /MDF
      handle any
        SEL SPREF WITH STYP '$!Alias-3' SPEC /MDF
        handle any
          !!alert.error('Unable to support this pipe NB')
          delete atta
          $!DatumName
          delete atta
          !!MdsFT34.Support.Datum  = =0/0
          return
        elsehandle none
          !!MdsSetSteel.Size.val = 3
        endhandle
      elsehandle none
        !!MdsSetSteel.Size.val = 2
      endhandle
    elsehandle none
      !!MdsSetSteel.Size.val = 1
    endhandle

    -- if we are are creating type C ori P10 U
    if (!Alias.eq('FT34C')) then
      ori and p10 is U wrt world
    endif

    SPKBRK TRUE

    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)

    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFT34.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFT34.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!MdsFT34.Support.PaDir eq U or !!MdsFT34.Support.PlDir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt34)
      if (not !!mdsft34.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt34)
      endif
--<wd>feb2004
    endif

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.string()
    !!MdsFT34.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFT34.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file MdscrdatFT34.pml
