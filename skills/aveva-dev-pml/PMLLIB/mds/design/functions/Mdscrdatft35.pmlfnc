--
-- File:		Mdscrdatft35.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS131
--
-- Author:		I.Osborne
-- Created:		Tue Jul 01
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatft35()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!Mdsft35.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!Mdsft35.Support.Alias

    !!MdsMConn('3','D')
    !!MdsDacControl(true)
    NAME $!DatumName

  -- Store Datum in Support form
    !!Mdsft35.Support.Datum  = !!CE
    !!Mdsft35.Support.PADir  = Pa Dir wrt world
    !!Mdsft35.Support.PLDir  = Pl Dir wrt world
    !!Mdsft35.Support.P9Dir  = P9 Dir wrt world
    !!Mdsft35.Support.P10Dir = P10 Dir wrt world
    !!Mdsft35.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!Mdsft35.Support.Atta.clear()
    !!Mdsft35.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP '$!Alias-1' SPEC /MDF
    !Pabore = !!ce.abore
    despar 0mm 0mm 0mm 0mm $!Pabore

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!Mdsft35.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!Mdsft35.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!Mdsft35.Support.PaDir eq U or !!Mdsft35.Support.PlDir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt35)
      if (not !!mdsft35.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt35)
      endif
--<wd>feb2004
    endif

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.string()
    !!Mdsft35.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!Mdsft35.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatft35.pml
