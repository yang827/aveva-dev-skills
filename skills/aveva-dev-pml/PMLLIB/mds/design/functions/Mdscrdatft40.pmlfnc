--
-- File:		Mdscrdatft40.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS135
--
-- Author:		Wayne Dodwell
-- Created:		Friday 18th July 1997
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatft40()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)

  -- Initialise variables
    !Name = !!Mdsft40.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!Mdsft40.Support.Datum  = !!CE
    !!Mdsft40.Support.PADir  = Pa Dir wrt world
    !!Mdsft40.Support.PLDir  = Pl Dir wrt world
    !!Mdsft40.Support.P9Dir  = P9 Dir wrt world
    !!Mdsft40.Support.P10Dir = P10 Dir wrt world
    !!Mdsft40.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!Mdsft40.Support.Atta.clear()
    !!Mdsft40.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'FT40-1' SPEC /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    !Pabore = !!ce.abore
    despar 0mm 0mm 0mm 0mm $!Pabore
    NAME $!SrefName
    !!Mdsft40.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!Mdsft40.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!Mdsft40.Support.PaDir eq U or !!Mdsft40.Support.PlDir eq U) then
--<wd>feb2004
      --call !!MdsIBopDir(!!CE, !!MdsFt40)
      if (not !!mdsft40.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
        call !!MdsIBopDir(!!CE, !!MdsFt40)
      endif
--<wd>feb2004
    endif

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.name
    !!Mdsft40.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!Mdsft40.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdscrdatft40.pml
