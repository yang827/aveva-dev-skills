--
-- File:		mdscrdatft41.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFt41()

-- Activate MDS DAC control variable
    !!MdsDacControl(true)

  -- Initialise variables
    !Name = !!mdsFt41.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'

    !!mdsMConn('3','U')
    !!MdsDacControl(true)
    NAME $!DatumName

  -- Store Datum in Support form
    !!mdsFt41.Support.Datum  = !!CE
    !!mdsFt41.Support.PADir  = Pa Dir wrt world
    !!mdsFt41.Support.PLDir  = Pl Dir wrt world
    !!mdsFt41.Support.P9Dir  = P9 Dir wrt world
    !!mdsFt41.Support.P10Dir = P10 Dir wrt world
    !!mdsFt41.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!mdsFt41.Support.Atta.clear()
    !!mdsFt41.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'FT41-1-A' SPEC /MDF

    SPKBRK TRUE

    !!mdsSetIspe()
    !!mdsSelLstu(!!CE)

    !!MdsDacControl(true)

    NAME $!SrefName
    !!mdsFt41.Support.Atta.append(!!CE)

    !!mdsMConn('3','U')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!mdsAncill.Action[2] = ||
    !!mdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!mdsFt41.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.name
    !!mdsFt41.Repre.append('!!mdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!mdsFt41.datum.active = false

-- Deactivate MDS DAC control variable
  !!MdsDacControl(false)


-- End function
endfunction

-- End of file mdscrdatft41.pml
