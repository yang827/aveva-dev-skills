--
-- File:		Mdscrdatft46.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFt46()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)

  -- Initialise variables
    !Name = !!MdsFt46.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Where = ''
    !!MdsMConn('3','D')
    NAME $!DatumName

  --Check Atta is in correct order of list. Bit messy but did not want to change mdscrancill
    --Navigate back to flange
    !CurrComp= !!Ce
    Prev
    !Flan =!!ce
    !leave = !!ce.leave
    if !leave eq 2 then $* its the back face of the flange
       !where = ' after '
    else                $* is leaving at 1 so the atta needs to be before the flange
       !where = ' before '
       BRAN
       REORDER $!DatumName BEFORE $!Flan
       $!DatumName
       at pa of next
       ori
    endif
    --Navigate back to Atta
    !!Ce = !CurrComp
  -- Store Datum in Support form
    !!MdsFt46.Support.Datum  = !!CE
    !!MdsFt46.Support.PADir  = Pa Dir wrt world
    !!MdsFt46.Support.PLDir  = Pl Dir wrt world
    !!MdsFt46.Support.P9Dir  = P9 Dir wrt world
    !!MdsFt46.Support.P10Dir = P10 Dir wrt world
    !!MdsFt46.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFt46.Support.Atta.clear()
    !!MdsFt46.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'FT46-1' SPEC /MDF

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsFt46.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
    !!MdsAncill.Action[2] = ||
    !!MdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFt46.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

 -- Store representation level in form so that it can be reset later
    !Colour = !!KFindDrawColour(!!CE)
    !CeName = !!CE.name
    !!MdsFt46.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsFt46.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdscrdatft46.pml
