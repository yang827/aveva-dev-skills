--
-- File:  Mdscrdatft47.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
-- Author:  Wayne Dodwell
-- Created:  Monday 10th may 2004
--
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatft47()

  -- Activate MDS DAC control variable
  !!mdsdaccontrol(TRUE)

  -- Initialise variables
  !name = !!mdsFT47.support.stru.name
  !datumname = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
  !stex = !!mdsFT47.support.stru.name.after('/')
  !fromAtta = !!mdsFT47.support.preliminaryStore.set()

  -- Create the PIPE REST Datum Atta automatically -i.e. DO NOT show the MDSANCILL form to select from
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    sel spref with styp 'PIPE-REST' spec /MDS
  else
    NEW ATTA SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
  endif
  SPKBRK FALSE

  !!mdssetispe()
  !!mdssellstu(!!ce)
  !!mdsdaccontrol(TRUE)

  !!mdsmconn('3','D')
  !!mdsdaccontrol(TRUE)
  name $!datumname
  stex '$!stex'

  if(!!kgetboreunits()) then
    !boreunits = 'INCH BORE'
  else
    !boreunits = ''
  endif

  $!boreunits
  !bore = pl bore
  handle any
    !bore = ph bore
  endhandle

  -- Store Datum in Support form
  !!mdsFT47.support.datum  = !!ce
  !!mdsFT47.support.padir  = pa dir wrt world
  !!mdsFT47.support.pldir  = pl dir wrt world
  !!mdsFT47.support.p9dir  = p9 dir wrt world
  !!mdsFT47.support.p10dir = p10 dir wrt world
  !!mdsFT47.support.p11dir = p11 dir wrt world

  -- Store datum atta in Support form
  !!mdsFT47.support.atta.clear()
  !!mdsFT47.support.atta.append(!!ce)

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP 'FT47-1' SPEC /MDF
  SPKBRK FALSE

  !!mdssetispe()
  !!mdssellstu(!!ce)

  !!mdsdaccontrol(TRUE)
  name $!srefname
  !!mdsFT47.support.atta.append(!!ce)

  !!mdsmconn('ORI','ORI')
  pos pa at $!datumname
  !!ce = !datumname.dbref()

  -- Add marker text
  var !pos pos wrt world
  $m/%pdmsui%/des/clib/gaidtext 210 Datum $<$!pos$>

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsFT47.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !!mdsFT47.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsFT47.datum.active = FALSE

  --DeActivate / Activate the Other Form Gadgets
  !form = !!mdsFT47
  !form.dist.active   = FALSE
  !form.bdist.active  = FALSE
  !form.select.active = TRUE
  !form.bthro.active  = FALSE

  -- Deactivate MDS DAC control variable
  !!mdsdaccontrol(FALSE)

endfunction
