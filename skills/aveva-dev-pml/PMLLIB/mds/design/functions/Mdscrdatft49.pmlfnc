--
-- File:		MdscrdatFT49.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFT49()

-- Activate MDS DAC control variable
    !!MdsDacControl(true)

  -- Initialise variables
    !Name = !!MdsFT49.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!MdsFT49.Support.Alias

    NEW ATTA
    SEL WITH STYP 'PIPE-REST' SPEC /MDS
    DESPAR 0mm 0mm

    !!MdsMConn('3','D')

    !!MdsDacControl(true)
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsFT49.Support.Datum  = !!CE
    !!MdsFT49.Support.PADir  = Pa Dir wrt world
    !!MdsFT49.Support.PLDir  = Pl Dir wrt world
    !!MdsFT49.Support.P9Dir  = P9 Dir wrt world
    !!MdsFT49.Support.P10Dir = P10 Dir wrt world
    !!MdsFT49.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsFT49.Support.Atta.clear()
    !!MdsFT49.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP '$!Alias-1-1' SPEC /MDF

    SPKBRK TRUE

    !!MdsSetIspe()
    !!MdsSelLstu(!!CE)

    !!MdsDacControl(true)

    NAME $!SrefName
    !!MdsFT49.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
      handle any
      endhandle

    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
      !!MdsAncill.Action[2] = ||
      !!MdsAncill.Action[3] = ||

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsFT49.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
  --  if (!Alias eq 'FT49' or !Alias.eq('FT36')) then
      if (!!MdsFT49.Support.PaDir eq U or !!MdsFT49.Support.PlDir eq U) then
--<wd>feb2004
        --call !!MdsIBopDir(!!CE, !!MdsFT49)
        if (not !!mdsFT49.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
          call !!MdsIBopDir(!!CE, !!MdsFT49)
        endif
--<wd>feb2004
      endif
  $(  elseif (!Alias eq 'CT05') then
------------------------------------------------------------------------------
      !!ce   = !srefname.dbref()
      ori and p9 is $!!MdsFT49.support.p9dir
        handle any
        endhandle
      fconn and p30 is p30 of prev

      !!CE = !SrefName.dbref()
      sel lstu
      fconn and p30 is p30 of $!DatumName
      spkbrk true
      !!CE = !DatumName.dbref()
      !xat = !!ce
      !order = order
-- Store the Identified Element DBREF
      prev
        handle any
          bran
          !xce = !!ce
        elsehandle none
          !xce = !!ce
        endhandle

      if (!xce.type.eq('FTUB')) then
        !!ce    = !xce
        !Width  = !!MdsSetWid()
        !height = 0
      else
        !!CE = !DatumName.dbref()
        if (!order.eq(1)) then
          dist 100
        else
          dist 100 from pl of prev
        endif

        !!ce = !xce
        if (!xce.type.eq('BRAN')) then
          head
          !hdir = hdir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori.delete()
             handle any
             endhandle
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce = !xat
          !!CE = !DatumName.dbref()
          ori $!ori
        else
          -- !!ce  = !currcomp
          !hdir = ldir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori.delete()
             handle any
             endhandle
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce  = !xat
          !!CE = !DatumName.dbref()
          ori $!ori
        endif
        !!ce = !xce
        !height = 0
        !width  = !!mdstraywidth(!xat, !xce, !height)
      endif
      !!ce = !xat

      !!MdsDacControl(true)
      !!CE = !DatumName.dbref()
      despar n1 $!Width
      despar n2 $!Height

      if (!order.eq(1)) then
        fconn
        ori $!ori
        sel lstu
      else
       fconn and p30 is p30 of prev
      endif
 ---------------------------------------------------------------------------

      !!MdsSelLstu(!!CE)
    endif
    $)
 ---------------------------------------------------------------------------

 -- Store representation level in form so that it can be reset later
    !CeName = !!CE.string()
    !!MdsFT49.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

-- Now datum has been created freeze datum button
    !!MdsFT49.datum.active = FALSE

-- If the element being created is an inline rest and the previous element is a baseplate get the thickness
-- of the baseplate and set the distance gadget to the thickness and execute the dist gadget

    !Form = !!MdsFT49
    !form.dist.active = TRUE
    !form.bdist.active = TRUE
    !form.select.active = TRUE
    !form.bthro.active = TRUE

-- Deactivate MDS DAC control variable
  !!MdsDacControl(FALSE)


-- End function
endfunction

-- End of file MdscrdatFT49.pml
