--
-- File: Mdscrdatft52.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS132
--
-- Author:    I.Osborne
-- Created:   Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatFT52()

-- Activate MDS DAC control variable
    !!mdsDacControl(true)

  -- Initialise variables
    !name = !!mdsFt52.support.stru.name
    !datumName = !name & '/' & 'DATUM'
    !srefName  = !name & '/' & 'SREF'
    !alias     = !!mdsFt52.support.alias

    if !alias eq 'FT52' or !alias eq 'FT53' then
      !!mdsMConn('3','D')
    endif
    !!mdsDacControl(true)
    NAME $!datumName

    if !!ce.styp.eq('RACK-REST') then
      despar 0mm 0mm
    endif
  -- Store Datum in Support form
    !!mdsFt52.support.datum  = !!ce
    !!mdsFt52.support.paDir  = Pa Dir wrt world
    !!mdsFt52.support.plDir  = Pl Dir wrt world
    !!mdsFt52.support.p9Dir  = P9 Dir wrt world
    !!mdsFt52.support.p10Dir = P10 Dir wrt world
    !!mdsFt52.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!mdsFt52.support.atta.clear()
    !!mdsFt52.support.atta.append(!!ce)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF

    SPKBRK TRUE

    !!mdsSetIspe()
    !!mdsSelLstu(!!ce)

    !!mdsDacControl(true)

    NAME $!srefName
    !!mdsFt52.support.atta.append(!!ce)

    !!mdsMConn('ORI','ORI')
      handle any
      endhandle

    POS PA AT $!datumName
    !!ce = !datumName.dbref()

  -- Add marker text

    VAR !poS poS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!poS$>

  --  Clear Blocking form gadget Ancillary.frm
    if (!alias eq 'FT52' or !alias.eq('FT53')) then
      !!mdsAncill.action[2] = ||
      !!mdsAncill.action[3] = ||
    endif

    !colour = !!kfindDrawcolour(!!ce)
    -- Add to model at level set by !!mdsOptions.levChange value
    call !!krepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
    !colourList = ARRAY()
    !colourList.appendarray(!!mdsFt52.support.atta)

  -- Colour Support
    call !!kenhanceList(!colourList)

  -- Check orientation of datum
    if (!alias eq 'FT52' or !alias.eq('FT53')) then
      if (!!mdsFt52.support.paDir eq U or !!mdsFt52.support.plDir eq U) then
--<wd>feb2004
        --call !!mdsIBopDir(!!ce, !!mdsFt52)
        if (not !!mdsFt52.support.datum.stype inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68')) then
          call !!mdsIBopDir(!!ce, !!mdsFt52)
        endif
--<wd>feb2004
      endif
    elseif (!alias eq 'CT05') then
------------------------------------------------------------------------------
      !!ce   = !srefName.dbref()
      ori and p9 is $!!mdsFt52.support.p9dir
        handle any
        endhandle
      fconn and p30 is p30 of prev

      !!ce = !srefName.dbref()
      sel lstu
      fconn and p30 is p30 of $!datumName
--<ge>Oct2005
-- spkbrk TRUE
      spkbrk FALSE
--<ge>Oct2005
      !!ce = !datumName.dbref()
--<ge>Oct2005
      spkbrk FALSE
--<ge>Oct2005
      !xat = !!ce
      !order = order
-- Store the Identified Element DBREF
      prev
        handle any
          bran
          !xce = !!ce
        elsehandle none
          !xce = !!ce
        endhandle

      if (!xce.type.eq('FTUB')) then
        !!ce    = !xce
        !width  = !!mdsSetWid()
        !height = 0
      else
        !!ce = !datumName.dbref()
        if (!order.eq(1)) then
          dist 100
        else
          dist 100 from pl of prev
        endif

        !!ce = !xce
        if (!xce.type.eq('BRAN')) then
          head
          !hdir = hdir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori.delete()
             handle any
             endhandle
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce = !xat
          !!ce = !datumName.dbref()
          ori $!ori
        else
          -- !!ce  = !currcomp
          !hdir = ldir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori.delete()
             handle any
             endhandle
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce  = !xat
          !!ce = !datumName.dbref()
          ori $!ori
        endif
        !!ce = !xce
        !height = 0
        !width  = !!mdstraywidth(!xat, !xce, !height)
      endif
      !!ce = !xat

      !!mdsDacControl(true)
      !!ce = !datumName.dbref()
      despar n1 $!width
      despar n2 $!height

      if (!order.eq(1)) then
        fconn
        ori $!ori
        sel lstu
      else
       fconn and p30 is p30 of prev
      endif
 ---------------------------------------------------------------------------

      !!mdsSelLstu(!!ce)
    endif
 ---------------------------------------------------------------------------

--<wd>jan2004
-- Check if type created is 'AT60'
  if (!datumName.dbref().stype inset ('AT60')) then
    !xce = !!ce
    !!ce = !datumName.dbref()
    at $!!mdsAncill.flan
    !!ce = !srefName.dbref()
    at $!!mdsAncill.flan
    !!ce = !xce
    !!mdsaidtext(!!mdsFt52)
    !!mdsFt52.support.position = TRUE
  endif
--<wd>jan2004
 ---------------------------------------------------------------------------

 -- Store representation level in form so that it can be reset later
    !ceName = !!ce.string()
    !!mdsFt52.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

-- Now datum has been created freeze datum button
    !!mdsFt52.datum.active = FALSE

-- If the element being created is an inline rest and the previous element is a baseplate get the thickness
-- of the baseplate and set the distance gadget to the thickness and execute the dist gadget

  if !alias eq 'FT52' or !alias eq 'FT53' then
    !form = !!mdsFt52
    if !!mdsCheckTrun(!form,'ALL') then
      prev
--<wd>oct2004 -- Added 'AC57' to the inset list and also the sub-check inset for 'AC30','AC57'
--<dw>oct2008 dun979 - Also to allow for additional trunnion base plates types AC60 to AC67
      if (!!ce.styp inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46','AC56','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
        --><wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
        --if (!!ce.styp inset('AC30','AC57')) then
        if (!!ce.styp inset('AC30','AC57', 'AC67')) then
          --<<wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
        --if (!!ce.styp inset('AC30','AC57')) then
          !basePlateThickness = '0'
        else
          var !basePlateThickness const dist pa to pl
        endif
        !form.dist.val = $!basePlateThickness
        !callBack = !form.bdist.callBack
        $!callBack
      endif
      next
      !form.dist.active = FALSE
      !form.bdist.active = FALSE
      !form.select.active = FALSE
      !form.bthro.active = FALSE
    else
--<wd>jan2004
      if (!datumName.dbref().stype inset ('AT60')) then
        !!ce = !datumName.dbref()
        if (!!ce.order.eq(1)) then
          !at60dist = !!kstrreal('cons dist p0 to ph')
        else
          !at60dist = !!kstrreal('cons dist p0 to p0 of previous')
        endif
        !form.dist.val      = $!at60dist
        !form.support.position = TRUE
        !form.dist.active   = FALSE
        !form.bdist.active  = FALSE
        !form.select.active = FALSE
        !form.bthro.active  = FALSE
--<wd>jan2004
      else
        !form.dist.active = TRUE
        !form.bdist.active = TRUE
        !form.select.active = TRUE
        !form.bthro.active = TRUE
      endif
    endif
  endif

  -- set initec constant values for dim 2 and dim 3 and disable the input boxes rm 20/04/06
  !desc = desc of /MDS/TEMPLATES
  if !desc eq 'Initec Industrial Templates' then
    if !alias eq 'FT52' then
      !!mdsFt52.dim2.val = 50
      !!mdsFt52.dim3.val = 2
    else
      !!mdsFt52.dim2.val = 50
      !!mdsFt52.dim3.val = 102
    endif

    !!mdsFt52.dim2.active = FALSE
    !!mdsFt52.dim3.active = FALSE

  endif


-- Standards ST19, ST21, ST22 and ST23 require the automatic generation of LUGS

  !!mdsCreateLugs()

-- Deactivate MDS DAC control variable
  !!mdsDacControl(FALSE)


-- End function
endfunction
