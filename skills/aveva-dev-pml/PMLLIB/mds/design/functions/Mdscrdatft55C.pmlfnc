--
-- File:		MdscrdatFT55C.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS133
--
-- Author:		I.Osborne
-- Created:		Thu Jul 03
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatFT55C()

  !currentunits = !!kgetsetunits()

  -- Activate MDS DAC control variable
  !!MdsDacControl(true)

  -- Initialise variables
  !Name = !!MdsFT55C.Support.Stru.name
  !DatumName = !Name & '/' & 'DATUM'
  !SrefName  = !Name & '/' & 'SREF'
  !Alias = !!MdsFT55C.Support.Alias
  !Selection = !!MdsSetSteel.Size.Selection('Rtext')
  !!MdsMConn('3','D')
  NAME $!DatumName

  -- Store Datum in Support form
  !!MdsFT55C.Support.Datum  = !!CE
  !!MdsFT55C.Support.PADir  = Pa Dir wrt world
  !!MdsFT55C.Support.PLDir  = Pl Dir wrt world
  !!MdsFT55C.Support.P9Dir  = P9 Dir wrt world

  -- Store datum atta in Support form
  !!MdsFT55C.Support.Atta.clear()
  !!MdsFT55C.Support.Atta.append(!!CE)

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP 'FT55C-$!Selection' SPEC /MDF
  spkbrk $!!MdsFT55C.sspkbrk
  handle ANY
  endhandle

  -- MOVE THE ATTA THROUGH THE CENTRE OF THE TEE OR OLET
  SPKBRK FALSE
  MOVE THROUGH P0 OF PREV

  !!MdsSetIspe()
  !!MdsSelLstu(!!CE)
  !!MdsDacControl(true)

  NAME $!SrefName
  !!MdsFT55C.Support.Atta.append(!!CE)

  !!MdsMConn('ORI','ORI')
  POS PA AT $!DatumName
  !!CE = !DatumName.dbref()

  !!MdsDacControl(true)

  -- Set the material and shop flags for all comps except the notes
  -- and remove the insulation automatically

  $(
  bran
  ispe =0
  !Members = mem count
  do !Set from 1 to !Members
    bran
    $!Set
    !!Mdssetmatref(!!ce)
      handle any
      endhandle
    ispe =0
  enddo

  bran
  !Shop = !!Mdspar$!LugSelected[$!PhBore].shop
  shop $!shop

  do !Set from 1 to !Members
    bran
    $!Set
    shop $!Shop
  enddo
  $)

  call !!MdsResetPins(1,3)

  -- Initialise variables
  !Name = !!MdsFT55C.Support.Stru.name
  !DatumName = !Name & '/' & 'DATUM'
  !SrefName  = !Name & '/' & 'SREF'
  /$!!MdsFT55C.name.val/SREF
  /$!!MdsFT55C.name.val/DATUM

  -- Store Datum in Support form
  !!MdsFT55C.Support.Datum  = !!CE
  !!MdsFT55C.Support.PADir  = Pa Dir wrt world
  !!MdsFT55C.Support.PLDir  = Pl Dir wrt world
  !!MdsFT55C.Support.P9Dir  = P9 Dir wrt world

  -- Store datum atta in Support form
  --   !!MdsFT55C.Support.Atta.clear()
  --  !!MdsFT55C.Support.Atta.append(!!CE)

  -- Add marker text
  VAR !POS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!MdsAncill.Action[2] = ||
  !!MdsAncill.Action[3] = ||

  -- Enhance elements using colour set for highlight
  !ColourList = array()
  !ColourList.appendarray(!!MdsFT55C.Support.Atta)

  -- Colour Support
  call !!KEnhanceList(!ColourList)

  -- Store representation level in form so that it can be reset later
  !Colour = !!KFindDrawColour(!!CE)
  !CeName = !!CE.name
  !!MdsFT55C.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- go and create the support
  !!kRestoreUnits(!currentunits)

  -- Now datum has been created freeze datum button
  !!MdsFT55C.CreateByCur.active = TRUE
  !!MdsFT55C.datum.active = FALSE
  !!MdsFT55C.Bdist.active = FALSE
  !!MdsFT55C.Dist.active = FALSE
  !!MdsFT55C.Bthro.active = FALSE
  !!MdsFT55C.Select.active = FALSE
  !!MdsFT55C.dim1.active = TRUE

  !!MdsDacControl(FALSE)
  -- Deactivate MDS DAC control variable
  !!MdsDacControl(false)
  !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdscrdatFT55C.pml
