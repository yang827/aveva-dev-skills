--
-- File: Mdscrdatft61.pmlfnc
--   Type:		Function Definition
--   Group:	Multi Discipline Supports Application
--     Keyword:	MDS
--   Module:	design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Tues 3rd April 2007
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatft61()

-- Activate MDS DAC control variable

  !!mdsdaccontrol(true)

-- Initialise variables

  !name = !!mdsft61.support.stru.name
  !datumname = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
--<dw>aug2008 Dun979 - set name for additional comment atta
  !commname  = !name & '/' & 'NOTE1'

  NEW ATTA SEL WITH STYP 'PIPE-REST' SPEC /MDS
  !!mdsmconn('3','D')
  NAME $!datumname

-- Store Datum in Support form
  !!mdsft61.support.datum  = !!ce
  !!mdsft61.support.padir  = Pa Dir wrt world
  !!mdsft61.support.pldir  = Pl Dir wrt world
  !!mdsft61.support.p9dir  = P9 Dir wrt world
  !!mdsft61.support.p10dir = P10 Dir wrt world
  !!mdsft61.support.p11dir = P11 Dir wrt world

-- Store datum atta in Support form
  !!mdsft61.support.atta.clear()
  !!mdsft61.support.atta.append(!!ce)

-- Create sref atta
  NEW ATTA SEL SPREF WITH STYP 'FT61-1' SPEC /MDF

  !!mdssetispe()
  !!mdssellstu(!!ce)
  !!mdsdaccontrol(true)
  NAME $!srefname
  !!mdsft61.support.atta.append(!!ce)
  !!mdsmconn('ORI','ORI')
  POS PA AT $!datumname

-- Cut hole comment atta

  NEW ATTA SELECT SPREF WITH STYP 'COMMENT' SPEC /MDS

  !!mdssetispe()
  !!mdssellstu(!!ce)
  !!mdsdaccontrol(true)

--<dw>aug2008 Dun979 - new atta to apply additional note
  if !!mdstrunnotes.boolean() then
     stex 'DO NOT CUT HOLE IN PIPE'
  endif
  atty CCNN
  NAME $!commname
  !!mdsft61.support.atta.append(!!ce)
  !!mdsmconn('ORI','ORI')
  POS PA AT $!srefname
--<dw>aug2008 Dun979 - end note addition

  !!ce = !datumname.dbref()

-- Add marker text

  var !pos pos wrt world

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

-- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsft61.support.atta)

-- Colour Support
  call !!kenhancelist(!colourlist)

-- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !!mdsft61.repre.append('!!mdsremadd(|$!cename|,$!colour)')

-- Now datum has been created freeze datum button

  !!mdsft61.datum.active  = FALSE
  !!mdsft61.dist.active   = TRUE
  !!mdsft61.bdist.active  = TRUE
  !!mdsft61.select.active = TRUE
  !!mdsft61.bthro.active  = TRUE

  --<tm>25/08/2004 go and create lugs if it needs them
  !!ce = !datumname.dbref()

-- Deactivate MDS DAC control variable

  !!mdsdaccontrol(false)

-- End function
endfunction
