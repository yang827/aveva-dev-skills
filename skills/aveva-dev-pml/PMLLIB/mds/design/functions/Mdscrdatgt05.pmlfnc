--
-- File:		Mdscrdatgt05.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatGt05(!Insu is real)

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsGt05.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!MdsGt05.Support.Alias

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsGt05.Support.Datum  = !!CE
    !!MdsGt05.Support.PADir  = Pa Dir wrt world
    !!MdsGt05.Support.PLDir  = Pl Dir wrt world
    !!MdsGt05.Support.P9Dir  = P9 Dir wrt world
    !!MdsGt05.Support.P10Dir = P10 Dir wrt world
    !!MdsGt05.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsGt05.Support.Atta.clear()
    !!MdsGt05.Support.Atta.append(!!CE)

  -- Create sref atta
    if (!Insu eq 0) then
      NEW ATTA SEL SPREF WITH STYP 'GT05-B-1' SPEC /MDF
    else
      NEW ATTA SEL SPREF WITH STYP 'GT05-A-1' SPEC /MDF
    endif

    SPKBRK TRUE

   !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsGt05.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsGt05.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!MdsGt05.Support.PaDir eq U or !!MdsGt05.Support.PlDir eq U) then
      call !!MdsIBopDir(!!CE, !!MdsGt05)
    endif

 -- Store representation level in form so that it can be reset later
    !CeName = !!CE.string()
    !!MdsGt05.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsGt05.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdscrdatgt05.pml
