--
-- File:		MdscrdatGt09.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatGt09()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)


  -- Initialise variables
    !Name = !!MdsGt09.Support.Stru.name
    !DatumName = !Name & '/' & 'DATUM'
    !SrefName  = !Name & '/' & 'SREF'
    !Alias     = !!MdsGt09.Support.Alias

    !!MdsMConn('3','D')
    NAME $!DatumName

  -- Store Datum in Support form
    !!MdsGt09.Support.Datum  = !!CE
    !!MdsGt09.Support.PADir  = Pa Dir wrt world
    !!MdsGt09.Support.PLDir  = Pl Dir wrt world
    !!MdsGt09.Support.P9Dir  = P9 Dir wrt world
    !!MdsGt09.Support.P10Dir = P10 Dir wrt world
    !!MdsGt09.Support.P11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
    !!MdsGt09.Support.Atta.clear()
    !!MdsGt09.Support.Atta.append(!!CE)

  -- Create sref atta
    NEW ATTA SEL SPREF WITH STYP 'GT09-C-1' SPEC /MDF
      handle (42,64) (42,501)
        !Bore = pa bor of prev
        !ProjStandard = !!MdsGt09.support.replace

        !!Alert.Error('Unable to select guide $!ProjStandard at this bore($!Bore)')
        prev
        delete atta
        same
        delete atta
        !!MdsGt09.Support.Datum = =0/0
        return
      endhandle

    SPKBRK TRUE

    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(true)
    NAME $!SrefName
    !!MdsGt09.Support.Atta.append(!!CE)

    !!MdsMConn('ORI','ORI')
    POS PA AT $!DatumName
    !!CE = !DatumName.dbref()

  -- Add marker text

    VAR !POS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    !Colour = !!KFindDrawColour(!!CE)
    -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.appendarray(!!MdsGt09.Support.Atta)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Check orientation of datum
    if (!!MdsGt09.Support.PaDir eq U or !!MdsGt09.Support.PlDir eq U) then
      call !!MdsIBopDir(!!CE, !!MdsGt09)
    endif

 -- Store representation level in form so that it can be reset later
    !CeName = !!CE.string()
    !!MdsGt09.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

  -- Now datum has been created freeze datum button

    !!MdsGt09.datum.active = false

-- Deactivate MDS DAC control variable

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file MdscrdatGt09.pml
