--
-- File: Mdscrdatspl.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:   Thu 11 Dec
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatSpl()

  ---------------------------------------------------
  --<wd>oct2004
  -- Test and Initialise Variable to CHECK if the DATUM ATTA belongs to Cable Trays/Racking

  !racking = FALSE
  !purparray = !!mdsidtval.split(',')
  -- <RM> 30 Oct 06 > -- the next line has been commented out to solve an orientation problem for hvac
  -- <RM> 8 Dec 06 > -- problems occurred with vertical ducting attas not being orientated properly so i took out the commenting
  -- added an extra test to see if the ducting is vertical or horizontal if it is vertical then we need to run the line below
  -- which will enable !!mdsMConn('3','D') to be run in line 80. this correctly orientates the atta
  var !testup dir Pa wrt world
  if !testup.eq('U') or !testup.eq('D') or !testup.eq('Z') or !testup.eq('-Z') then
    !purparray = !!mdsidhval.split(',')
  endif
  -- <RM> 8 Dec 06 > -- end of fix
  -- < if any problems occur then we will have to look at this further

  do !value values !purparray
    if (($!!mdsidtatt of zone) eq (!value)) then
      !racking = TRUE
      break
    endif
  enddo

  --  !racking = (($!!mdsidtatt of zone) eq (!!mdsidtval))
  --<wd>oct2004
  ---------------------------------------------------

  -- Activate MDS DAC control variable
  !!mdsDacControl(TRUE)

  -- Initialise variables
  !name      = !!mdsSpecial.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unusedAlias = !!mdsSpecial.support.alias

  ---------------------------------------------------
  --<wd>oct2004

  --!!mdsMConn('3','D')

  -- The DATUM ATTA belongs to Cable Trays/Racking and has already been
  -- Correctly ORIENTATED in the PML function mdssetdatspl.pmlfnc
  -- Therefore Do Nothing HERE! for a Cable Tray DATUM Atta.
  if (!racking.not()) then
    !!mdsMConn('3','D')
  endif
  --<wd>oct2004
  ---------------------------------------------------

  !!mdsDacControl(TRUE)
  NAME $!datumName

  -- Store Datum in Support form
  !!mdsSpecial.support.datum  = !!ce
  !!mdsSpecial.support.paDir  = Pa Dir wrt world
  !!mdsSpecial.support.plDir  = Pl Dir wrt world
  !!mdsSpecial.support.p9Dir  = P9 Dir wrt world
  !!mdsSpecial.support.p10Dir = P10 Dir wrt world
  !!mdsSpecial.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsSpecial.support.atta.clear()
  !!mdsSpecial.support.atta.append(!!ce)

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP 'SPECIAL' SPEC /MDS

  if (!datumName.dbref().spref.name.upcase().match('/MDS/.HVAC-REST').eq(1)) then
    -- MDS DATUM ATTA is an MDS HVAC Support
    SPKBRK FALSE
  else
    -- MDS DATUM ATTA is EITHER a MDS TRAY/RACK or a MDS PIPE Support
    SPKBRK TRUE
  endif

  -- GE 02/02/05 Fix for HPD0027839 where the MTOC was unset
  if (!datumName.dbref().spref.name.upcase().match('/MDS/.RACK-REST').eq(1)) then
    MTOC ON
  endif

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)
  NAME $!srefName
  !!mdsSpecial.support.atta.append(!!ce)

  ---------------------------------------------------
  --<wd>oct2004

  --  !!mdsMConn('ORI','ORI')

  -- The SREF ATTA belongs to Cable Trays/Racking
  -- Therefore Connect to the DATUM ATTA to suit a Cable Tray DATUM Atta.
  if (!racking) then
    fconn and p30 is p30 of prev
    handle ANY
      fconn and p30 is p31 of prev
      handle ANY
        fconn
      endhandle
    endhandle
  else
    !!mdsMConn('3','D')
  endif
  --<wd>oct2004
  ---------------------------------------------------

  POS PA AT $!datumName
  !!ce = !datumName.dbref()

  -- Add marker text
  VAR !poS poS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!poS$>

  --<wd>jan2004
  -- Check if type created is 'AT60'
  if (!datumName.dbref().stype inset ('AT60')) then
    !xce = !!ce
    !!ce = !datumName.dbref()
    at $!!mdsAncill.flan
    !!ce = !srefName.dbref()
    at $!!mdsAncill.flan
    !!ce = !xce
    !!mdsaidtext(!!mdsSpecial)
    !!mdsSpecial.support.position = TRUE
  endif

  --<wd>jan2004
  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kfindDrawcolour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  Call !!krepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsSpecial.support.atta)

  -- Colour Support
  Call !!kenhanceList(!colourList)

  -- Check orientation of datum
  if (!!mdsSpecial.support.paDir eq U or !!mdsSpecial.support.plDir eq U) then
    Call !!mdsIBopDir(!!ce, !!mdsSpecial)
  endif

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsSpecial.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsSpecial.datum.active = FALSE

  -- Now the datum has been created we can position the stru at p9 of datum
  !!ce = !!mdsSpecial.support.stru
  at p9 of $!datumName
  same

  -- If the element being created is an inline rest and the previous element is a baseplate get the thickness
  -- of the baseplate and set the distance gadget to the thickness and execute the dist gadget

  !form = !!mdsSpecial
  if !!mdsCheckTrun(!form,'ALL') then
    prev
    --<wd>oct2004 -- Added 'AC57' to the inset list and also the sub-check inset for 'AC30','AC57'
    --<dw>oct2008 dun979 - Also to allow for additional trunnion base plates types AC60 to AC67
    if (!!ce.styp inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46','AC56','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
      --><wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
      --if (!!ce.styp inset('AC30','AC57')) then
      if (!!ce.styp inset('AC30','AC57', 'AC67')) then
        --<<wd>19oct2009 - DFN P-25097 - SI-15410 - AC67 Adjustable Trunnion Base Plate type added to the INSET test.
        !basePlateThickness = '0'
      else
        var !basePlateThickness const dist pa to pl
      endif
      !form.dist.val = $!basePlateThickness
      !callBack = !form.bdist.callBack
      $!callBack
    endif
    next
    !form.dist.active = FALSE
    !form.bdist.active = FALSE
    !form.select.active = FALSE
    !form.bthro.active = FALSE
  else
    if (!datumName.dbref().stype inset ('AT60')) then
      !!ce = !datumName.dbref()
      if (!!ce.order.eq(1)) then
        !at60dist = !!kstrreal('cons dist p0 to ph')
      else
        !at60dist = !!kstrreal('cons dist p0 to p0 of previous')
      endif
      !form.dist.val      = $!at60dist
      !form.support.position = TRUE
      !form.dist.active   = FALSE
      !form.bdist.active  = FALSE
      !form.select.active = FALSE
      !form.bthro.active  = FALSE
    else
      !form.dist.active = TRUE
      !form.bdist.active = TRUE
      !form.select.active = TRUE
      !form.bthro.active = TRUE
    endif
  endif

  --<wd>02jun2004
  -- Get the DATA to be able ORIENTATE the MDS SPECIAL Structure element
  !!mdsDacControl(TRUE)
  !ece = !!ce
  !dat = !!mdsSpecial.support.datum
  var !zdir const dir p3 of $!dat to p9 of $!dat
  -- DATUM Atta has already been ORIENTATED
  !oriz = !zdir.direction().wrt(/* )
  !orix = !!mdsSpecial.support.datum.pdir[11].wrt(/* )

  -- Orientate the MDS SPECIAL STRUCTURE element and Set the uda :MDSFRAMEDIR
  !!ce = !!mdsSpecial.support.stru
  ori x is $!orix and z is $!oriz
  !struori = !!ce.orientation.wrt(/* )
  !ydir    = !struori.ydir().wrt(/* )
  :mdsframedir $!ydir

  -- When the datum is created on a sloping line the stru need snapping to the horizontal orthogonal plane. i.e. remove up component if
  -- pipe is not up

  !!ce = !!mdsSpecial.support.stru
  !ori = ori wrt /*
  if !!mdsSpecial.support.datum.ldir.string().neq('U') or !!mdsSpecial.support.datum.ldir.string().neq('D') or !!mdsSpecial.support.datum.ldir.string().neq('Z') or !!mdsSpecial.support.datum.ldir.string().neq('-Z') then
    !ori.alpha = 0
    ori $!ori
  endif

  !!ce = !!mdsSpecial.support.datum
  !!mdsCreateLugs()

  -- Navigate Back to the Original Component
  !!ce = !ece

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(FALSE)


  -- End function
endfunction
