--
-- File:  Mdscrdatvt02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS102
--
-- Author:  Wayne Dodwell
-- Created:  Friday 9th January 1998
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatvt02()

  -- Activate MDS DAC control variable
  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsVT02.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
  !form = !!mdsVT02
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()


  --------------------------------------------------------------------------------
  -- Create the DATUM Atta

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
    handle any
      !!alert.error('Question SPRE cannot be answered')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT02, true)
      !!mdsVT02.hide()
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    endhandle

    -- set datum in the form for distance
    !!mdsVT02.support.datum = !!ce
    !!mdsDistance(!!mdsVT02)
    !form.support.position = true
  else
    NEW ATTA SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
  endif
  -- </ak> 20/06/2012

  MTOC OFF
  SPKBRK TRUE

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  if !fromAtta.not() then
    !!mdsMConn('3','D')
  endif
  name $!datumName

  -- Test user criteria
  !check = object MDSCHECKFRAME()
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!form, true)
      !form.hide()
      !!alert.error (!criteria)
      return
    endif
    delete atta
    !!alert.error (!criteria)
    return
  endif

  --------------------------------------------------------------------------------
  -- The PL of the DATUM Atta must always point D so if its not flip it
  !pldir = pdir 2
  if !pldir.string().before('WRT').trim().eq('U') or !pldir.string().before('WRT').trim().eq('Z') then
    flip ori
  endif

  -- Store Datum in Support form
  !!mdsVT02.support.datum  = !!ce
  !!mdsVT02.support.padir  = pa dir wrt world
  !!mdsVT02.support.pldir  = pl dir wrt world
  !!mdsVT02.support.p9dir  = p9 dir wrt world
  !!mdsVT02.support.p10dir = p10 dir wrt world
  !!mdsVT02.support.p11dir = p11 dir wrt world
  !!mdsVT02.support.bars[1] = !!mdsVT02.support.datum

  -- Store datum atta in Support form
  !!mdsVT02.support.atta.clear()
  !!mdsVT02.support.atta.append(!!ce)

  -- Create sref atta
  new atta sel spref with styp 'VT02' spec /MDF
  handle any
    if (!fromAtta) then
      delete atta
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT02, true)
      !!mdsVT02.hide()
      !!mdsDacControl(false)
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Question SPRE cannot be answered'
  endhandle
  SPKBRK TRUE
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  name $!srefname
  !!mdsVT02.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif

  -- Set stex for the SREF Atta
  !satta = !!ce
  !!mdstransport(!satta,!name)
  !!mdsDacControl(true)
  !!ce = !datumName.dbref()

  -- Add marker text
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Get the colour !!ce was originally added to the drawlist.
  !colour = !!kfinddrawcolour(!!ce)

  -- Add to model at level set by !!mdsOptions.levchange value
  !!kreprelevel(!!ce, 'PIPE',!!mdsOptions.levchange, $!colour)
  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsVT02.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !cename = !!ce.name
  !!mdsVT02.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  -- Now datum has been created 'Deactivate' datum button
  !!mdsVT02.datum.active = false

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
