--
-- File:  Mdscrdatvt03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS103
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 13th January 1998
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatvt03()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)

  -- Initialise variables
  !name      = !!mdsvt03.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
  !form = !!mdsvt03
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  --------------------------------------------------------------------------------
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
  	!form.support.datum = !!ce
    !!mdsDistance(!!mdsvt03)
    !form.support.position = true
  endif

  if !fromAtta.not() then
  !!mdsMConn('3','D')
  endif
  name $!datumName

  --------------------------------------------------------------------------------

  -- Store Datum in Support form
  !!mdsvt03.support.datum  = !!ce
  !!mdsvt03.support.padir  = pa dir wrt world
  !!mdsvt03.support.pldir  = pl dir wrt world
  !!mdsvt03.support.p9dir  = p9 dir wrt world
  !!mdsvt03.support.p10dir = p10 dir wrt world
  !!mdsvt03.support.p11dir = p11 dir wrt world

  -- Store datum atta in Support form
  !!mdsvt03.support.atta.clear()
  !!mdsvt03.support.atta.append(!!ce)

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------

  -- Create SREF atta
  new atta sel spref with styp 'VT03' spec /MDF
  handle any
    if (!fromAtta) then
      delete atta
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsvt03, true)
      !!mdsvt03.hide()
      !!mdsDacControl(false)
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Question SPRE cannot be answered'
  endhandle
  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  name $!srefname
  !!mdsvt03.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  if (!fromAtta.not()) then
  POS PA AT $!datumName
  endif
  !!ce = !datumName.dbref()
  --<wd>may2003
  !!mdstransport(!!ce,!datumName)
  --<wd>may2003

  --------------------------------------------------------------------------------
  -- Create The Other Three(3) Attas as Identical Copies of the Datum Atta
  -- Rotate Each One by 90 degrees and add to the MdsSUPPORT object
  !!ce = !srefname.dbref()
  do !numb from 1 to 3
    new atta copy $!datumName
    SPKBRK TRUE
    rotate by ($!numb * 90)
    name $!<name>.$!<numb>
    pos at $!datumName
    !!mdsvt03.support.atta.append(!!ce)
    !!mdsvt03.support.bars[1].append(!!ce)
    --<wd>may2003
    !anam = '$!<name>.$!<numb>'
    !!mdstransport(!!ce,!anam)
    --<wd>may2003
  enddo


  --------------------------------------------------------------------------------

  -- Add marker text
  !!mdsaidtext(!!mdsvt03)
  !!ce = !datumName.dbref()

  --------------------------------------------------------------------------------
  -- Clear Callback on Blocking Ancillary form gadget '.action' on form 'Mdsancill'
  !!mdsancill.action[2] = ||
  !!mdsancill.action[3] = ||

  --------------------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsvt03.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !!mdsvt03.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  --------------------------------------------------------------------------------

  -- Now datum has been created 'Inactivate' datum button
  !!mdsvt03.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
