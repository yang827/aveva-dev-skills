--
-- File:  Mdscrdatvt04.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS104
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 20th January 1998
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatvt04()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
  !name      = !!mdsVT04.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
  !form = !!mdsVT04
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  --------------------------------------------------------------------------------
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
  	!form.support.datum = !!ce
    !!mdsDistance(!!mdsVT04)
    !form.support.position = true
  endif

  if !fromAtta.not() then
    !!mdsMConn('3','D')
  endif
  name $!datumName

  --------------------------------------------------------------------------------

  -- Store Datum in Support form
  !!mdsVT04.support.datum  = !!ce
  !!mdsVT04.support.padir  = pa dir wrt world
  !!mdsVT04.support.pldir  = pl dir wrt world
  !!mdsVT04.support.p9dir  = p9 dir wrt world
  !!mdsVT04.support.p10dir = p10 dir wrt world
  !!mdsVT04.support.p11dir = p11 dir wrt world

  -- Store datum atta in Support form
  !!mdsVT04.support.atta.clear()
  !!mdsVT04.support.atta.append(!!ce)

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------

  -- Create SREF atta
  new atta sel spref with styp 'VT04' spec /MDF
  handle any
    if (!fromAtta) then
      delete atta
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT04, true)
      !!mdsVT04.hide()
      !!mdsDacControl(false)
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Question SPRE cannot be answered'
  endhandle
  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  name $!srefname
  !!mdsVT04.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif
  !!ce = !datumName.dbref()

  -- Add marker text
  !!mdsaidtext(!!mdsVT04)
  !!ce = !datumName.dbref()

  --------------------------------------------------------------------------------
  -- Clear Callback on Blocking Ancillary form gadget '.action' on form 'Mdsancill'
  !!mdsancill.action[2] = ||
  !!mdsancill.action[3] = ||

  --------------------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsVT04.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !!mdsVT04.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  --------------------------------------------------------------------------------

-- Now datum has been created 'Deactivate' datum button
  !!mdsVT04.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
