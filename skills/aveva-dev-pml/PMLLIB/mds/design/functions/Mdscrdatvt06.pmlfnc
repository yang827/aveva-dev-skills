--
-- File:  Mdscrdatvt06.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS105
--
-- Author:  Andrew Kirkland
-- Created:  Wednesday 13th May 1998
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrdatvt06()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)


  -- Initialise variables
  !name = !!mdsvt06.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefname  = !name & '/' & 'SREF'
  !form = !!mdsvt05
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  --------------------------------------------------------------------------------
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !form.support.datum = !!ce
  endif

  if !fromAtta.not() then
    !!mdsMConn('3','D')
  else
    ori
    !!mdsDistance(!!mdsvt05)
    !form.support.position = true
  endif
  name $!datumName

  --------------------------------------------------------------------------------

  -- Store Datum in Support form
  !!mdsvt06.support.datum  = !!ce
  !!mdsvt06.support.padir  = pa dir wrt world
  !!mdsvt06.support.pldir  = pl dir wrt world
  !!mdsvt06.support.p9dir  = p9 dir wrt world
  !!mdsvt06.support.p10dir = p10 dir wrt world
  !!mdsvt06.support.p11dir = p11 dir wrt world

  -- Store datum atta in Support form
  !!mdsvt06.support.atta.clear()
  !!mdsvt06.support.atta.append(!!ce)

  --------------------------------------------------------------------------------

  -- Create sref atta
  !type = 'VT06'

  -- Get Bore size in inches
  !units = object COMUNITS(TRUE)
  units inch bores
  units inch dist
  !boreSize = pl bore
  handle any
    !boreSize = hbor
  endhandle
  -- Convert the bore size into a string
  !newBoreSize = !boreSize.real().distance(false,false,true,32,false).trim()
  !units.restoreSavedBoreDist()

  -- Get Support size
  -- !selection = !!mdsvt06.size.selection()
  !selection = !!mdsSetSteel.size.selection('Rtext')

  !units.restoreSavedBoreDist()

  -- Create the atta Component
  new atta sel spref with styp '$!type-$!newBoreSize-$!selection' spec /MDF
  handle any
    if (!fromAtta) then
      delete atta
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsvt05, true)
      !!mdsvt05.hide()
      !!mdsDacControl(false)
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Question SPRE cannot be answered'
  endhandle

  SPKBRK TRUE


  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  name $!srefname
  !!mdsvt06.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif

  !!ce = !datumName.dbref()

  -- Add marker text
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  --------------------------------------------------------------------------------
  --  Clear Action gadget for 'Mdstrunnvt06' BLOCKING form
  --aa    !!mdstrunnvt06.action[2] = ||
  --aa    !!mdstrunnvt06.action[3] = ||

  --------------------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsvt06.support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Store representation level in form so that it can be reset later
  !colour = !!kfinddrawcolour(!!ce)
  !cename = !!ce.name
  !!mdsvt06.repre.append('!!mdsremadd(|$!cename|,$!colour)')

  --------------------------------------------------------------------------------

  -- Now datum has been created 'Deactivate' datum button
  !!mdsvt06.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)
endfunction
