--
-- File:  Mdscrdatvt07.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatVt07()

  -- Activate MDS DAC control variable
  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsVT07.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsVT07.support.alias
  !form = !!mdsVT07
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
    handle any
      !!alert.error('Question SPRE cannot be answered')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT07, true)
      !!mdsVT07.hide()
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !!mdsVT07.support.datum = !!ce
    !!mdsDistance(!!mdsVT07)
  else
    NEW ATTA SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
  endif
  -- </ak> 20/06/2012

  MTOC OFF
  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  !!mdsMConn('3','D')
  !!mdsDacControl(true)
  NAME $!datumName

  -- Test user criteria
  !check = object MDSCHECKFRAME()
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!form, true)
      !form.hide()
      !!alert.error (!criteria)
      return
    endif
    delete atta
    !!alert.error (!criteria)
    return
  endif

  -- The PL of the atta must always point D so if its not flip it
  !plDir = pdir 2
  if !plDir.string().before('WRT').trim().eq('U') or !plDir.string().before('WRT').trim().eq('Z') then
    flip ori
  endif

  -- Store Datum in Support form
  !!mdsVT07.support.datum  = !!ce
  !!mdsVT07.support.paDir  = Pa Dir wrt world
  !!mdsVT07.support.plDir  = Pl Dir wrt world
  !!mdsVT07.support.p9Dir  = P9 Dir wrt world
  !!mdsVT07.support.p10Dir = P10 Dir wrt world
  !!mdsVT07.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsVT07.support.atta.clear()
  !!mdsVT07.support.atta.append(!!ce)

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF
  handle any
    if (!fromAtta) then
      delete atta
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT07, true)
      !!mdsVT07.hide()
      !!mdsDacControl(false)
    endif
    !!kRestoreUnits(!currentunits)
    return error 1 'Question SPRE cannot be answered'
  endhandle
  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsVT07.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')
  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif

  -- set stex for atta
  !sAtta = !!ce
  call !!mdsTransport(!sAtta,!name)
  !!mdsDacControl(true)

  !!ce = !datumName.dbref()

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsVT07.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsVT07.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsVT07.datum.active = false

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
