--
-- File:  Mdscrdatvt14.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatVT14()

  -- Activate MDS DAC control variable

  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsVT14.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsVT14.support.alias
  !form = !!mdsVT14
  !currentunits = !!kGetSetUnits()
  !fromAtta = !form.support.preliminaryStore.set()

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    SEL SPREF WITH STYP 'AC36' SPEC /MDS
    handle any
      !!alert.error('Question SPRE cannot be answered')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT14, true)
      !!mdsVT14.hide()
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    -- set datum in the form for distance
    !!mdsVT14.support.datum = !!ce
    !!mdsDistance(!!mdsVT14)
  else
    NEW ATTA SEL SPREF WITH STYP 'AC36' SPEC /MDS
  endif
  -- </ak> 20/06/2012
  !units = object COMUNITS(TRUE)
  units mm bore
  units mm dist
  var !bore pl bore

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata('AC36',!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$nAC36[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  desp $!despars[1] $!despars[2] $!despars[3] $!despars[4] $!despars[5]  $!despars[6]  $!despars[7]
  !!mdssetmatref(!!ce)
  var !bore delete
  !units.restoreSavedBoreDist()

  SPKBRK TRUE

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  !!mdsMConn('10','N')
  !!mdsDacControl(true)
  NAME $!datumName

  -- Test user criteria
  !check = object MDSCHECKFRAME()
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!form, true)
      !form.hide()
      !!alert.error (!criteria)
      return
    endif
    delete atta
    !!alert.error (!criteria)
    return
  endif

  -- The PL of the atta must always point D so if its not flip it
  !pLDir = pdir 2
  if !pLDir.string().before('WRT').trim().eq('U') or !pLDir.string().before('WRT').trim().eq('Z') then
    flip ori
  endif



  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- Create sref atta
  NEW ATTA SEL SPREF WITH STYP '$!alias-1' SPEC /MDF
  handle any
    delete atta
    SAME
    delete ATTA
    !projStandard = !!mdsVT14.support.replace
    !!alert.error('Unable to select vessel support ' & !projStandard & ' at this bore(' & !bore & ')')
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  SPKBRK TRUE

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)
  !!mdsDacControl(true)

  PREV

  -- Store Datum in Support form
  !!mdsVT14.support.datum  = !!ce
  !!mdsVT14.support.pADir  = Pa Dir wrt world
  !!mdsVT14.support.pLDir  = Pl Dir wrt world
  !!mdsVT14.support.p9Dir  = P9 Dir wrt world
  !!mdsVT14.support.p10Dir = P10 Dir wrt world
  !!mdsVT14.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsVT14.support.atta.clear()
  !!mdsVT14.support.atta.append(!!ce)

  NEXT

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  NAME $!srefName
  !!mdsVT14.support.atta.append(!!ce)

  !!mdsMConn('ORI','ORI')

  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pOS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsVT14.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Check orientation of datum
  -- Call !!mdsIBopDir(!!ce, !!mdsVT14)

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsVT14.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button

  !!mdsVT14.datum.active = false

  -- Deactivate MDS DAC control variable

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
