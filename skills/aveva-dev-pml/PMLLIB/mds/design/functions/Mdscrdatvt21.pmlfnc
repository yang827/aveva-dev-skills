--
-- File:		Mdscrdatvt21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS132
--
-- Author:		Gordon Evans
-- Created:		Wednesday 22nd Oct 2003
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCrDatvt21()

-- Activate MDS DAC control variable

  !!MdsDacControl(true)

-- Initialise variables
  !Name = !!Mdsvt21.Support.Stru.name
  !DatumName = !Name & '/' & 'DATUM'
  !SrefName  = !Name & '/' & 'SREF'
  !Alias     = !!Mdsvt21.Support.Alias

  !!MdsMConn('3','D')
  NAME $!DatumName

-- Store Datum in Support form
  !!Mdsvt21.Support.Datum  = !!CE
  !!Mdsvt21.Support.PADir  = Pa Dir wrt world
  !!Mdsvt21.Support.PLDir  = Pl Dir wrt world
  !!Mdsvt21.Support.P9Dir  = P9 Dir wrt world
  !!Mdsvt21.Support.P10Dir = P10 Dir wrt world
  !!Mdsvt21.Support.P11Dir = P11 Dir wrt world

-- Store datum atta in Support form
  !!Mdsvt21.Support.Atta.clear()
  !!Mdsvt21.Support.Atta.append(!!CE)

-- Create sref atta
  NEW ATTA SEL SPREF WITH STYP '$!Alias-1' SPEC /MDF
  SPKBRK TRUE

-- set stex for atta
  !SAtta = !!CE
--<wd>nov2003
--  SREF Attas DO NOT Require the STEX to be SET for ISODRAFT
--  Call !!MdsTransport(!SAtta,!Name)
--<wd>nov2003
  !!MdsDacControl(true)

  !!MdsSetIspe()
  !!MdsSelLstu(!!CE)
  !!MdsDacControl(true)

  NAME $!SrefName
  !!Mdsvt21.Support.Atta.append(!!CE)

  !!MdsMConn('ORI','ORI')

  POS PA AT $!DatumName
  !!CE = !DatumName.dbref()

-- Add marker text
  VAR !POS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

--  Clear Blocking form gadget Ancillary.frm
  !!MdsAncill.Action[2] = ||
  !!MdsAncill.Action[3] = ||

-- Enhance elements using colour set for highlight
  !ColourList = array()
  !ColourList.appendarray(!!Mdsvt21.Support.Atta)

-- Colour Support
  call !!KEnhanceList(!ColourList)

-- Store representation level in form so that it can be reset later
  !Colour = !!KFindDrawColour(!!CE)
  !CeName = !!CE.string()
  !!Mdsvt21.Repre.append('!!MdsRemAdd(|$!CeName|,$!Colour)')

-- Now datum has been created freeze datum button
  !!Mdsvt21.datum.active = false

--<wd>oct2002
-- DeActivate the Pipe Type once the DATUM Atta has been created
--  !!mdsvt21.type.active = false
--<wd>oct2002

-- Deactivate MDS DAC control variable
  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdscrdatvt21.pml
