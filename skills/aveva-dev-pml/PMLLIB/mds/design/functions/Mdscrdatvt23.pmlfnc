--
-- File:  Mdscrdatvt23.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Create datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCrDatVT23()

  !currentunits = !!kGetSetUnits()
  -- Activate MDS DAC control variable
  !!mdsDacControl(true)

  -- Initialise variables
  !name = !!mdsVT23.support.stru.name
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !alias     = !!mdsVT23.support.alias
  !form = !!mdsVT23
  !fromAtta = !form.support.preliminaryStore.set()


  --------------------------------------------------------------------------------
  -- Create the DATUM Atta

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
    handle any
      !!alert.error('Question SPRE cannot be answered')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT23, true)
      !!mdsVT23.hide()
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    endhandle

    -- set datum in the form for distance
    !!mdsVT23.support.datum = !!ce
    !!mdsDistance(!!mdsVT23)
    !form.support.position = true
  else
    NEW ATTA SEL SPREF WITH STYP 'PIPE-REST' SPEC /MDS
  endif
  -- </ak> 20/06/2012

  MTOC OFF
  SPKBRK TRUE

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  if !fromAtta.not() then
    !!mdsMConn('3','D')
  endif

  NAME $!datumName

  -- Test user criteria
  !check = object MDSCHECKFRAME()
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!form, true)
      !form.hide()
      !!alert.error (!criteria)
      return
    endif
    delete atta
    !!alert.error (!criteria)
    return
  endif

  -- Store Datum in Support form
  !!mdsVT23.support.datum  = !!ce
  !!mdsVT23.support.pADir  = Pa Dir wrt world
  !!mdsVT23.support.pLDir  = Pl Dir wrt world
  !!mdsVT23.support.p9Dir  = P9 Dir wrt world
  !!mdsVT23.support.p10Dir = P10 Dir wrt world
  !!mdsVT23.support.p11Dir = P11 Dir wrt world

  -- Store datum atta in Support form
  !!mdsVT23.support.atta.clear()
  !!mdsVT23.support.atta.append(!!ce)


  -- Create sref atta
  !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!alias , !!ce.lbor)
  if !supseq eq 0 then
    NEW ATTA SEL SPREF WITH STYP '$!alias-1-1' SPEC /MDF
    handle any
      if (!fromAtta) then
        delete atta
        !!ce = object DBREF(!name)
        delete stru
        !!mdsRestorePre(!!mdsVT23, true)
        !!mdsVT23.hide()
        !!mdsDacControl(false)
      endif
      !!kRestoreUnits(!currentunits)
      return error 1 'Question SPRE cannot be answered'
    endhandle

  else
    NEW ATTA SEL SPREF WITH STYP '$!alias-1-$!supseq' SPEC /MDF
    handle any
      if (!fromAtta) then
        delete atta
        !!ce = object DBREF(!name)
        delete stru
        !!mdsRestorePre(!!mdsVT23, true)
        !!mdsVT23.hide()
        !!mdsDacControl(false)
      endif
      !!kRestoreUnits(!currentunits)
      return error 1 'Question SPRE cannot be answered'
    endhandle

  endif

  SPKBRK TRUE

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)

  NAME $!srefName
  !!mdsVT23.support.atta.append(!!ce)

  !!mdssetsteel.size.val = !supseq
  handle ANY
    write |error in setsteel|
  endhandle
  !!mdsMConn('ORI','ORI')
  handle any
  endhandle

  if (!fromAtta.not()) then
    POS PA AT $!datumName
  endif
  !!ce = !datumName.dbref()

  -- Add marker text

  VAR !pOS POS WRT WORLD

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  --  Clear Blocking form gadget Ancillary.frm
  !!mdsAncill.action[2] = ||
  !!mdsAncill.action[3] = ||

  !colour = !!kFindDrawColour(!!ce)
  -- Add to model at level set by !!mdsOptions.levChange value
  call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsVT23.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  ---------------------------------------------------------------------------

  -- Store representation level in form so that it can be reset later
  !ceName = !!ce.string()
  !!mdsVT23.repre.append('!!mdsRemAdd(|$!ceName|,$!colour)')

  -- Now datum has been created freeze datum button
  !!mdsVT23.datum.active = FALSE

  -- If the element being created is an inline rest and the previous element is a baseplate get the thickness
  -- of the baseplate and set the distance gadget to the thickness and execute the dist gadget

  !form = !!mdsVT23
  !form.dist.active = TRUE
  !form.bdist.active = TRUE
  !form.select.active = TRUE
  !form.bthro.active = TRUE

  -- Deactivate MDS DAC control variable
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentunits)

endfunction
