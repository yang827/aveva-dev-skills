--
-- File:  MdscreateFRjoint.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  T.martin
-- Created:  Thu 18th December 2003
--
--
-- Description:
-- Function to createjoint between fitting and subfitting
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM         [current form]
--     2     R        DBREF        [mode of call]
--
--------------------------------------------------------------------------------
-- for to connect a section fitting to wall plate (SBFI)
-- Define Function
define function !!mdsCreateFRJoint(!form is FORM, !dummyMode is STRING)


  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  !refe          = !!ce
  !iDType        = 'SBFI'
  !support       = !form.support
  !name          = !form.name.val

  if !name.match('/')neq(1) then
    !name = '/' & !name
  endif
  !datum         = !support.datum
  !clearance     = '25'

  if !support.connections.set() then
    !connection = !support.connections[1]
    handle ANY
    endhandle
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  ---------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  if !support.type eq 'FR02' then
    !above = 'BELOW'
    !plate = 'Bottom'
  elseif !support.type eq 'FR03' then
    !above = 'ABOVE'
    !plate = 'Wall'
  else
    !above = 'ABOVE'
    !plate = 'Top'
  endif


  label /Element1

  PROMPT OFF
  PROMPT LOAD ESCAPE |Identify $!plate Plate to support from|
  ID $!iDType @
  handle (61,528)
    PROMPT ON
    !!ce = !refe
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  PROMPT DISMISS
  PROMPT ON
  -- Set up Orientation
  !ddir = U wrt world
  !udir = D wrt world

  !pick = !!ce
  !testCe = !!mdsRelToDatum(!datum, !pick, !ddir, !clearance.real())
  if (!testCe[1].upcase() eq 'UNSET')then
    !!alert.error('Identified element is unsuitable to support from.')
    golabel /Element1
  elseif (!testCe[1].upcase() eq '')then
    golabel /Element1
  endif

  if (!pick.type neq 'SBFI')then
    !!alert.error('Identified element is unsuitable to support from.')
    golabel /Element1
  endif

  -- pick element to hang from
  !!ce = !pick
  !connection = !!ce
  !support.connections[1] = !!ce
  -- Make sure item picked is a plate

  !!ce = !pick
  -- Go to the vertical
  if !form eq !!mdsfr07 then
    !!ce = $!<name>-H1
    handle ANY
      !!alert.error('Horizontal member does not exist')
      return
    endhandle
  else
    !!ce = $!<name>-V1
    handle ANY
      !!alert.error('Vertical member does not exist')
      return
    endhandle
  endif
  :mdsconn $!pick
  handle ANY
    -- the connection does not exist
    golabel /Element1
  endhandle
  if !form eq !!mdsfr05 or !form eq !!mdsfr06 or !form eq !!mdsfr08 then
    !!ce = $!<name>-H1
    :mdsconn $!pick
  endif
  fitt 1 $* go to the fitting to set its connection

  cref $!pick

  if !form eq !!mdsfr08 then $* we need to pick the second plate
    label /Element2
    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify Bottom Plate to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !refe
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    -- Set up Orientation
    !ddir = U wrt world
    !udir = D wrt world

    !pick = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick, !ddir, !clearance.real())
    if (!testCe[1].upcase() eq 'UNSET' or !form eq !!mdsfr03 )then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element2
    endif


    !!ce = $!<name>-H2
    :mdsconn $!pick
    fitt 1 $* go to the fitting to set its connection

    -- check to see if the top bracket is inside the ceiling plate
    --if !!mdscheckfitting(!form,!!ce,!pick).not() then
    --    !!alert.warning('Section Brackets are Not Within the Plate')
    -- endif

    cref $!pick

  endif

  !!ce = $!<name>-V1

  !form.support.connections = !support.connections
  handle ANY
  endhandle

  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  !!ce = !refe

endfunction
