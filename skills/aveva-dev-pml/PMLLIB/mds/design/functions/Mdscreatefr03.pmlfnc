--------------------------------------------------------------------------------
--
-- File:                MdscreateFR03.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              T.Martin
-- Created:             19-nov-2003
--
--
-- Description:
-- function to create support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFR03(!Method is string)

-- Find current units and set the distance unit to metric
  !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    call !!MdsResetPins(1,9)
    !Support    = !!MdsFR03.Support
    -- !Clearance  = !!MdsOptions.Clear.val
    !Clearance  = 25
    !Overlap    = !!MdsOptions.Overlap.val
    !Selection  = !!MdsSetSteel.Size.Selection('Rtext')
    !Datum      = !Support.Datum
    !Stru       = !Support.Stru
    !Name       = !Stru.name
    !P10Dir     = !Support.P10Dir
    !P11Dir     = !Support.P11Dir
    !Alias      = !Support.Alias
----------------------------- **** connections **** -----------------------------
    !Refe       = !!CE
    !Form       = !!MdsFR03


  if !support.connections.set() then
     !connection = !support.connections[1]
  else
     !connection = object dbref()
  endif
-- Can we write to the spref attribute of the SREF atta
-- and the stru
  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

  !HaveJoints = FALSE
  if(!Form.Support.Joints.unset().not()) then
     !Joints     = !Support.Joints
     !Attributes = array()
     !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
      handle ANY
       !HaveJoints = FALSE
       !Support.Joints.Clear()
       -- in case they have been deleted and cancel is used
      endhandle
  endif
---------------------------------------------------------------------------------
   -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

   -- Check that Datum atta has been positioned
    if (!Support.position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      !!kRestoreUnits(!currentunits)
      return
    endif

    !NoEquiv = false

   -- Check which attas to work from
    if (!Support.Bars.size().leq(1))then
      !Atta = !Support.Atta
    else
      !Atta = !Support.Bars[1]
    endif

   -- Set up Orientation
    !Ddir = U wrt world
    !Udir = D wrt world

   -- Store section name and matref for each member
   -- for reseting later
    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)

    -- Check for framework orientation
    -- get the horizontal direction to and from the vertical member
    if (!Support.RotateCur)then
      !ToVert   = !P11Dir
      !FromVert = !p10Dir
    else
      !ToVert   = !P10Dir
      !fromVert = !p11Dir
    endif


if !method eq |PICK| then

   ------------ *** Connection Warnings *** -------------
       !ErrorMessage = string()
       !DummyS       = ''

    if(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('UNJOINTED')) then
       -- nothing to do
    elseif(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('WARNING')) then
       !Continue = !!Alert.Confirm(!ErrorMessage)
       if(!Continue.eq('NO')) then
          !!kRestoreUnits(!currentunits)
          return
       endif
    elseif(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('ERROR')) then
        !!Alert.Error(!ErrorMessage)
        !!kRestoreUnits(!currentunits)
        return
    endif


     !connection = !!mdsfr03.sbfi
     !support.connections[1] = !!ce

     !!ce = !!MdsFR03.Support.Stru

     !frameType = !!CE.:MDSSuppType
     !suppattas = ARRAY()
     if !!mdsFR03.support.stack.stack1.size() eq 0 then
       -- the support has not been built yet
       !suppattas = !support.atta
     else
       -- the support is in modify mode
       do !a values !!mdsFR03.support.stack.stack1
          !suppattas.append(!a.atta)
       enddo
     endif

      -- Set object definition
      !Direction = object KEQUALDIR()
      !Direction.DirectionA = !!mdsfr03.plane.orientation.zdir()
      !Direction.DirectionB = !Support.P10dir
      !Direction.Tolerance  = 0.05

      -- Check directions
      if (!!KDirEqualDir(!Direction)) then
        !Support.RotateCur = TRUE
      else
        !Support.RotateCur = FALSE
      endif

     if (!Support.RotateCur)then
      !ToVert   = !P11Dir
      !FromVert = !p10Dir
     else
      !ToVert   = !P10Dir
      !fromVert = !p11Dir
     endif

      -- work out the offset from the plate
      !vector = object pointvector()
      !datumpos = !datum.position.wrt(/* )
      !vector.position = !!mdsfr03.plane.position.wrt(/* )
      !vector.direction = !!mdsfr03.plane.orientation.zdir()
      !offsetposition = !vector.through(!datumpos).position
      !!MdsFR03.Dim1.Val = !!mdsfr03.plane.position.wrt(/* ).distance(!offsetposition) - 90
      -- work out the vertical offset from the plate
      !locationpos = !!mdsfr03.sbfi.position.wrt(/* )
      !vertoffset = !locationpos.up - !datumpos.up
      !!MdsFR03.Dim2.Val = !vertoffset
      -- PIN 4 DIR FROM PIN 8 TO PIN 9

endif

--------------------------------- dimension generation -------------------------------------------
-- elseif (!Method eq |DIMENSION|)then

      -- Initialise variables for dimension check
      !D1 = !!MdsFR03.Dim1.Val
      !D2 = !!MdsFR03.Dim2.Val

      if (!D1.eq(0))then
        !!Alert.error('Dimension 1 Unset')
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsCreateMess(true)

    -- Position pins
      !!CE = !Datum
      -- PIN 9 TAKES P9 OF THE DATUM ATTA (DATUM ATTA POSITION POINTING DOWN)
      PIN 9 COPY P9
      -- PIN 9 DIRECTION SET TO P1O OF THE DATUM ATTA (NORTH IF NOT ROTATED)
      PIN 9 DIR $!ToVert
      PIN 8 COPY PIN9
      -- PIN 8 SET TO THE P11 DIR (SOUTH IF NOT ROTATED)
      PIN 8 DIR $!FromVert
      -- THE FOLLOWING PLANE COMMANDS APPEAR TO DO NOTHING
      PIN 9 plane PIN 9 THRO CE
      PIN 8 plane PIN 8 THRO CE
      -- POSITION PIN 9 DIMENSION 1 DISTANCE AWAY FROM THE DATUM
      PIN 9 DIST $!D1
      -- SET THE PIN 9 DIRECTION TO !DDIR (UP)????????????????????
      PIN 9 DIR $!Ddir
      PIN 7 COPY PIN 9
      PIN 7 DIST $!D2
      PIN 7 DIR $!Udir
      -- PIN 7 IS SET AT DIMENSION 2 UP FROM THE DATUM ATTA AND SHOULD BE THE POSITION OF THE FITTING

      -- NOW SWAP THE DIRECTIONS OF PIN8 AND 9
      PIN 9 DIR FROM PIN 8 TO PIN 9
      -- PIN 9 IS NOW POINTING TOWARDS THE VERTICAL MEMBER BACK TOWARDS THE DATUM ATTA
      PIN 8 DIR FROM PIN 9 TO PIN 8
      -- PIN 8 IS NOW POINTING AWAY FROM THE VERTICAL MEMBER


      -- LOOP THROUGH THE ATTAS AND FIND THE LARGEST DIMENSION
      !Dim = 0
      do !I values !Atta
        PIN 4 COPY PIN 8
        PIN 4 AT $!Datum
        PIN 4 plane PIN 4 CLEAR $!Clearance BEH $!I
          handle (2,109)
            BREAK
          endhandle
        VAR !CDIR CONST DIR P0 of $!Datum TO PIN 4
         !Cdim = !!KStrReal('CONST DIST P0 of $!Datum TO PIN 4')

        -- Set object definition
        !Direction = object KEQUALDIR()
        !Direction.DirectionA = !CDIR.direction()
        !Direction.DirectionB = !FromVert
        !Direction.Tolerance  = 0.05

        if (!Cdim.gt(!Dim) and !!KDirEqualDir(!Direction)) then
          PIN 4 AT $!Datum
          PIN 4 DIST $!CDIM
          !Dim = !Cdim
        else
          PIN 4 AT $!Datum
          PIN 4 DIST $!DIM
        endif
      enddo
      -- PIN 4 IS NOW AT THE POSITION OF THE GREATEST OFFSET AWAY FROM THE DATUM
      -- SET PIN 4 DIRECTION TO PIN 9 DIR
      PIN 4 DIR FROM PIN 8 TO PIN 9

-- endif
-- end of if statement to set pin positions
-- pins should now be in position and we can begin

  !!CE = !Stru

  -- Pins now in position create framework

    delete STRU MEM
      handle (41,66) (2,113) (2,113)
      endhandle

    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    AT $!Datum

    NEW FRMW $!NAME/MAIN
    !FrmwSupport = !!CE

    !!CE = /MDS/$!Alias/$!Selection
    !Desc = desc of /MDS/$!Alias/$!Selection
    !Type = 'HORI'

    !Subs = !!KCollectAllFor('SUBS', '', !!CE)
    !Frmw = !!KCollectAllFor('FRMW', '', !!CE)
    !FrameFormat = before(!Frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
    !!CE = !FrmwSupport
    COPY ATTRIB OF $!Frmw[1]
    COPY MEM OF $!Frmw[1] RENAME $!FrameFormat $!NAME
    do !I indices !Subs
      NEW SUBS $!NAME/SUBS$!I COPY ATTRIB OF $!Subs[$!I]
      COPY MEM OF $!Subs[$!I] RENAME $!FrameFormat $!NAME
    enddo

    -- Get direction of P9 of datum atta and dist between p9 and p0
    !!CE = !Stru

    -- Set stru description for template recognition
    desc '$!desc'

    -- move thr stru u thro the datum
    MOVE $!Udir THRO P9 OF $!Datum

    -- set the structure orientation
    VAR !ORIX CONST DIR PIN 9 TO PIN 8
    -- if !Support.RotateCur then
    --   VAR !ORIX CONST DIR PIN 8 TO PIN 9
    -- endif
    !ORIZ = !Ddir
    ORI X IS $!ORIX wrt world AND Z IS $!ORIZ

    -- Extend and move V1
    !!CE = $!<Name>-V1
    :mdsconn $!connection $* connect to the panel
    handle ANY
        -- the connection does not exist
    endhandle

    !adjustpl = object mdsplines(!!ce)
    !moveamount = !adjustpl.setdistance($!datum,!!Mdsfr03.Dim1.val.real() )
    move $!moveamount

    !Flush = :MdsOlap
    if !Flush neq 'FLUSH' then
      EXTEND end $!Overlap
    endif

    -- Extend and move bar 1
    !!CE = $!<Name>-BAR-1
    !Flush = :MDSOlap

    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      PIN 9 plane PIN 9 CLEAR $!Onum inf $!NAME-V1
    else
      PIN 9 plane PIN 9 CLEAR $!Overlap inf $!NAME-V1
    endif
    pin 4 copy pin 8
    PIN 4 plane PIN 4 CLEAR 0 beh $!datum

    -- extend bar
    EXTEND START THRO PIN 9
    reconn recalc
    EXTEND END THRO PIN 4

   ---*********************************************8
   !sctnlen = !!Mdsgetsctnlen(!!ce,'OLD')
   reconnect recalc
   -- bar 1
   -- if the required section length is too long for bar1 we need to put something in
   if !sctnlen eq 0 then
     extend end dist 100 from posstart
   else
     extend end dist $!sctnlen from posstart
     -- $p sctnlen = $!sctnlen
   endif
   reconnect recalc
  -- Select correct spref
    !!CE = $!<Name>/SREF
    !!MdsDacControl(true)

    SEL SPREF WITH STYP 'FR03-$!Selection' SPEC /MDF
    !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR03-$!Selection')
    !!MdsSetIspe()
    !!MdsSelLstu(!!CE)
    !!MdsDacControl(false)
    !!CE = !Stru

  -- If cross-bars existed replace them
    if (!Support.Bars.empty().not())then
      if !support.bars.size() eq 1 then
        $!NAME-V1
        extend start dist 20 inf $!<Name>-BAR-1
        -- extend end dist 20 behind  $!<Name>-BAR-1
        !!CE = !Stru
      else
      -- line up the attas with the vertical bar
      do !I indices !Support.Bars
       if !i eq 1 then
        $!NAME-V1
          extend start dist 20 inf $!<Name>-BAR-1
          extend end dist 20 behind  $!<Name>-BAR-1
        else
          call !!MdsAddBarFR03(!Support, 'OLD', !Method)
        endif
      enddo
    endif
      !Support.BarLen = !!MdsFR03.Support.BarLen
    endif
    !list = !Support.Bars[1]
    !References = ''
    do !I Indices !list
      !References = !References & ' ' & !list[!I].string()
    enddo

    -- Set atta reference to datum cross bar
    !!CE = $!<Name>-BAR-1
    :MDSAttaRef $!References
    handle any
    endhandle
    !Support.BarLen[1] = deri length of CE
    !!CE = !Stru

    -- Adjust for slope on horizontal lines only
    if (!Type eq |HORI|)then

       -- Check to see if the line is sloping
      !Adjust = 0
      do !V values !Atta
        !!CE = !V
         skip if !!ce.:mdsrotdir.east.set()
        !Grad = pl grad
        if (!grad neq 0)then
          !StrucElement = array()
          !Ref = $!Name-BAR-1
          !StrucElement.append(!Ref)
          !VHeight = !!MdsAdjustSlope(!StrucElement, !V)
        else
          !VHeight = 0
        endif
        if (!VHeight gt !Adjust)then
          !Adjust = !VHeight
        endif
      enddo

      -- Adjust required elements
      !!CE = $!<Name>-BAR-1
      MOVE D WRT WORLD DIST $!Adjust

      !!CE = $!<Name>-V1
      !Start = Posstart wrt world
      !End   = Posend wrt world

      PIN 7 AT $!End
      PIN 8 AT $!Start
      PIN 7 DIR TO PIN 8
      !ToBar = 0
      do !Indx indices !Support.Bars
        PIN 8 COPY PIN 7
        PIN 8 plane PIN 8 THRO $!<Name>-BAR-$!Indx
         !Tobar1 = !!KStrReal('CONST DIST PIN 7 TO PIN 8')
        if (!ToBar1 gt !ToBar)then
          !ToBar = !ToBar1
          !index = !Indx
        endif
      enddo
      PIN 8 plane PIN 8 CLEAR 0 BEH $!<Name>-BAR-$!index

      !Flush = :MDSOlap
     -- This line has been added by Michel to satisfy the Overlap
      if !!ce.:MdsOnum.neq(0) then
        !OverLap = :MDSOnum
      endif
  endif
  ---- if type = 'hori' endif

    !!CE = $!<Name>/SREF
    !!MdsDacControl(true)
    DESPAR $!!MdsFR03.Dim1.Val $!!MdsFR03.Dim2.Val
    !!MdsDacControl(false)

  -- Reset materials of sections
--<wd>29mar2004    !!MdsResetMat(!StoreMat)

    !!CE = !Stru

-- Reset the zdist for all joints
   var !Sjois coll all sjoi for $!Name

   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     snod
     zdist thro cref of same
   enddo

-- Navigate to Main Structure of Framework
    !!CE = !Stru

------------------------***** connexions *****--------------------------
 if(!HaveJoints) then
    do !index indices !Joints
     if(!Joints[!index].badref().not() and !Attributes[!index][8].dbref().:MDSConn.eq(!Joints[!index].owner.owner)) then
        !Mainstl = !Attributes[!index][8].dbref().:MDSConn
        !Support.Joints[!index] =  !!MdsCreateJoint(!MainStl, !Attributes[!index][8].dbref(),!Joints[!index],!Attributes[!index])
     else
        !Dummy = object dbref()
        !DummyA = array()
        !Mainstl = !Support.Connections[!index]
        !Support.Joints[!index] =  !!MdsCreateJoint(!MainStl, !Attributes[!index][8].dbref(),!Dummy,!DummyA)
     endif
    enddo
 endif
----------------------------------------------------------------------
-- Creation is complete, so we now need to extend the start and ends to suit the bracket and the bars.
-- Check that the fitting is inside the existing section length
-- if it is then do nothing
-- else adjust the appropriate length to suit
-- might as well adjust the top and bottom to suit the bars at the same time


-- find out if the bracket is higher or lower than the current members
-- take the volume of the bracket and check to see if its within the start and end points of the
-- main section


-- if it does, do nothing
-- if its above, extend the end clearance xxx above the bracket
-- if its below, extend the start clearance xxx above the bracket
   !!CE = $!<Name>-V1

   if !connection.unset().not() and !connection.badref().not() then
      if !connection.type.eq('SBFI') then
         :mdsconn $!connection
         handle ANY
            -- the connection does not exist
         endhandle
      else
        :mdsconn =0
      endif
    else
      :mdsconn =0
    endif
  -- calculate the up position of the fitting
  !pos = !datum.position.wrt(/* )
  !pos.up = !pos.up + !!mdsfr03.dim2.val.real()

  -- get fitting volume to identify the up and down limits

  fitt 1
  !bracket = !!ce
  zdist thro $!pos
  !fittvol = object volume(!!ce)
  same

  if !!ce.poss.wrt(/* ).up lt !fittvol.to.up and !!ce.pose.wrt(/* ).up lt !fittvol.from.up  then $* need to extend the start past the bracket
     !up = !fittvol.to.up + 20
     extend start thro u $!up wrt /*
  elseif !!ce.pose.wrt(/* ).up gt !fittvol.from.up and !!ce.poss.wrt(/* ).up gt !fittvol.to.up  then $* need to extend the start past the bracket
     !up = !fittvol.from.up - 20
     extend end thro u $!up wrt /*
  endif

  -- reposition the fitting because the section length might have changed and the zdist is wrong
  fitt 1
  zdist thro $!pos

  cref $!connection
  handle ANY
    -- unable to set connection
  endhandle
  if !connection.unset().not() then
    if !connection.type.eq('SBFI') then
     -- connect the fitting using :mdsancref
       !obj = object mdsbplateconn(!!ce,!connection)
    endif
  endif


  -- now that we have done the major part of everthing we need to extend V1 beyond the bottom bracket
  !!CE = $!<Name>-V1
  var !platejoints coll all sjoi for ce
  var !platejoints append coll all fitt for ce
  !ja = ARRAY()
  do !jo values !platejoints
    !ja.append(!jo.dbref().position.wrt(/* ).up)
  enddo
  !ind = !ja.sortedindices()
  !platejoints.reindex(!ind)
  !lowbracket = !platejoints[1].dbref()
  !highbracket = !platejoints[!platejoints.size()].dbref()
  extend end distance 20 behind $!lowbracket
  extend start distance 20 inf $!highbracket
  -- end of extend bit
  -- reposition fitting becuase section length has changed
  fitt 1
  zdist thro $!pos
  same


  !testp = object mdsplines()
  -- clash check the bracket
  if !testp.clashfr03bracket($!<Name>-V1 , !bracket)then
    !!alert.error('Welded Plates Clash with Bracket Ubolt - Modify Dimension 2 and Rebuild Using Dimensions')
  endif

  !!ce = !stru

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.append(!!CE)
    !ColourList.appendarray(!Support.Atta)
    !colourlist.appendarray(!support.joints)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Reset all pins associated with this support
   call !!MdsResetPins(1,9)

  -- reset :mdsancref attributes if set
  !Support.plateconns.restoreconns()

  -- Update support data held in form
  !!MdsFR03.Support = !Support

  -- remove the create message
  !!MdsCreateMess(false)

-- Show dimensions on graphics if required
   if !!MdsFR03.GraphicalDim then
     !!Mdsshowdim(!!MdsFR03)
   endif

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdscreateFR03.pml
