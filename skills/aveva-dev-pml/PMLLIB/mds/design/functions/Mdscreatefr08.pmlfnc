--------------------------------------------------------------------------------
--
-- File:                MdscreateFR08.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              T.Martin
-- Created:             19-nov-2003
--
--
-- Description:
-- function to create support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFR08(!Method is string)

-- Find current units and set the distance unit to metric
  !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    call !!MdsResetPins(1,9)
    !Support    = !!MdsFR08.Support
    -- !Clearance  = !!MdsOptions.Clear.val
    !Clearance  = 25
    !Overlap    = !!MdsOptions.Overlap.val
    !Selection  = !!MdsSetSteel.Size.Selection('Rtext')
    !Datum      = !Support.Datum
    !Stru       = !Support.Stru
    !Name       = !Stru.name
    !P10Dir     = !Support.P10Dir
    !P11Dir     = !Support.P11Dir
    !Alias      = !Support.Alias
----------------------------- **** connections **** -----------------------------
    !Refe       = !!CE
    !Form       = !!MdsFR08

  if !!mdsFr08.support.config.unset() then
    !!mdsFr08.support.config = 1
  endif

  if !support.connections.set() then
     !topconnection = !support.connections[1]
     handle ANY
     endhandle
     !bottomconnection = !support.connections[2]
     handle ANY
     endhandle
  endif
-- Can we write to the spref attribute of the SREF atta
-- and the stru
  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

  !HaveJoints = FALSE
  if(!Form.Support.Joints.unset().not()) then
     !Joints     = !Support.Joints
     !Attributes = array()
     !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
      handle ANY
       !HaveJoints = FALSE
       !Support.Joints.Clear()
       -- in case they have been deleted and cancel is used
      endhandle
  endif
---------------------------------------------------------------------------------
   -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

   -- Check that Datum atta has been positioned
    if (!Support.position.not())then
      !!Alert.message('Position atta before identifying supporting steelwork')
      !!kRestoreUnits(!currentunits)
      return
    endif

    !NoEquiv = false

   -- Check which attas to work from
    if (!Support.Bars.size().leq(1))then
      !Atta = !Support.Atta
    else
      !Atta = !Support.Bars[1]
    endif

   -- Set up Orientation
    !Ddir = U wrt world
    !Udir = D wrt world

   -- Store section name and matref for each member
   -- for reseting later
    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)

    -- Check for framework orientation
    -- get the horizontal direction to and from the vertical member
    if (!Support.RotateCur)then
      !ToVert   = !P11Dir
      !FromVert = !p10Dir
    else
      !ToVert   = !P10Dir
      !fromVert = !p11Dir
    endif


if !method eq |PICK| then

   ------------ *** Connection Warnings *** -------------
       !ErrorMessage = string()
       !DummyS       = ''

    if(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('UNJOINTED')) then
       -- nothing to do
    elseif(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('WARNING')) then
       !Continue = !!Alert.Confirm(!ErrorMessage)
       if(!Continue.eq('NO')) then
          !!kRestoreUnits(!currentunits)
          return
       endif
    elseif(!!kErrorsForConns(!Form, !ErrorMessage, !DummyS).eq('ERROR')) then
        !!Alert.Error(!ErrorMessage)
        !!kRestoreUnits(!currentunits)
        return
    endif


     --!topconnection = !!mdsFR08.topsbfi
     --!support.connections[1] = !!mdsFR08.topsbfi
     if !!mdsFR08.topsbfi.set() then
       if !!mdsFR08.topsbfi.type.eq('SBFI') then
          !topconnection = !!mdsFR08.topsbfi
       else
          !topconnection = object dbref()
       endif
     else
       !topconnection = object dbref()
     endif
     !support.connections[1] = !topconnection

     -- !bottomconnection  = !!mdsFR08.bottomsbfi
     -- !support.connections[2] = !!mdsFR08.bottomsbfi
     if !!mdsFR08.bottomsbfi.set() then
       if !!mdsFR08.bottomsbfi.type.eq('SBFI') then
          !bottomconnection = !!mdsFR08.bottomsbfi
       else
          !bottomconnection = object dbref()
       endif
     else
       !bottomconnection = object dbref()
     endif
     !support.connections[2] = !bottomconnection


     !!ce = !!MdsFR08.Support.Stru

     !frameType = !!CE.:MDSSuppType
     !suppattas = array()
     if !!mdsFR08.support.stack.stack1.size() eq 0 then
       -- the support has not been built yet
       !suppattas = !support.atta
     else
       -- the support is in modify mode
       do !a values !!mdsFR08.support.stack.stack1
          !suppattas.append(!a.atta)
       enddo
     endif

      -- Set object definition
      !Direction = object KEQUALDIR()
      !Direction.DirectionA = !!mdsFR08.topplane.orientation.zdir()
      !Direction.DirectionB = !Support.P10dir
      !Direction.Tolerance  = 0.05

      -- Check directions
      if (!!KDirEqualDir(!Direction)) then
        !Support.RotateCur = TRUE
      else
        !Support.RotateCur = FALSE
      endif

      if (!Support.RotateCur)then
       !ToVert   = !P11Dir
       !FromVert = !p10Dir
      else
       !ToVert   = !P10Dir
       !fromVert = !p11Dir
      endif


      -- work out the offset from the plate
      !vector = object pointvector()
      !datumpos = !datum.position.wrt(/* )
      !vector.position = !!mdsFR08.topplane.position.wrt(/* )
      !vector.direction = D WRT /*
      pin 9 at $!vector.position
      pin 9 dir d
      pin 9 clear behind $!!mdsFR08.topsbfi
      var !vpos pin 9 position wrt /*
      pin 9 off
      !vector.position = !vpos.position()
      -- !vector.direction = !!mdsFR08.topplane.orientation.zdir()
      !offsetposition = !vector.through(!datumpos).position
      --<tm> fix to try and sort out incorrect dimensions
      --!fitting = fitt 1 of sctn 1 of frmw 1 of $!support.stru
      --!posup = !fitting.ppos[9].wrt(/* )
      -- work out the vertical offsets from the plate
      --!locationpos = !!mdsFR08.topsbfi.position.wrt(/* )
      -- !locationpos = !!mdsfr08.topplane.position.wrt(/* )
      !vertoffset = !vector.position.up - !datumpos.up
      --!vertoffset = !posup.up - !datumpos.up
      !!MdsFR08.Dim2.Val = !vertoffset
      !locationpos = !!mdsFR08.bottomsbfi.position.wrt(/* )
      -- mod due to the incorrect positioning of the plane
      -- !vertoffset = !datumpos.up - !!mdsFR08.Bottomplane.position.wrt(/* ).up
      -- !!MdsFR08.Dim4.Val = !vertoffset


      -- can't calculate dimension 3 because we dont have a member yet
      !!CE = !Stru

  -- Pins now in position create framework

    delete STRU MEM
      handle (41,66) (2,113) (2,113)
      endhandle

    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    AT $!Datum

    NEW FRMW $!NAME/MAIN
    !FrmwSupport = !!CE

    !!CE = /MDS/$!Alias/$!Selection
    !Desc = desc of /MDS/$!Alias/$!Selection
    !Type = 'HORI'

    !Subs = !!KCollectAllFor('SUBS', '', !!CE)
    !Frmw = !!KCollectAllFor('FRMW', '', !!CE)
    !FrameFormat = before(!Frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
    !!CE = !FrmwSupport
    COPY ATTRIB OF $!Frmw[1]
    COPY MEM OF $!Frmw[1] RENAME $!FrameFormat $!NAME
    do !I indices !Subs
      NEW SUBS $!NAME/SUBS$!I COPY ATTRIB OF $!Subs[$!I]
      COPY MEM OF $!Subs[$!I] RENAME $!FrameFormat $!NAME
    enddo

    -- Get direction of P9 of datum atta and dist between p9 and p0
    !!CE = !Stru

    -- Set stru description for template recognition
    desc '$!desc'

    -- move thr stru u thro the datum
    MOVE $!Udir THRO P9 OF $!Datum
    !ORIZ = !Ddir
    -- set the structure orientation
    VAR !ORIX CONST DIR PIN 9 TO PIN 8
    if !Support.RotateCur then
        ORI X IS p10 of $!Datum  AND Z IS $!ORIZ
    else
        ORI X IS p11 of $!Datum  AND Z IS $!ORIZ
    endif
    -- Extend and move V1
    !!CE = $!<Name>-V1
    :mdsconn $!topconnection $!bottomconnection $* connect to the panel
    handle ANY
        -- the connection does not exist
    endhandle

    !adjustpl = object mdsplines($!<Name>-V1 )
    -- current element is
    !!CE = $!<Name>-V1
    !moveamount = !adjustpl.setclearance($!datum,!clearance )
    move $!moveamount
    !!MdsFR08.Dim1.Val = !adjustpl.getdistance($!datum)

    -- at this point, we have a bar and the vertical in the correct position
    -- now we need to work out the offset direction and value for dimension 3
    !!CE = $!<Name>-V1
    !aobj = object mdsplines(!!ce)

    -- get minimum and maximum lengths fro the horizontal bars
    !!ce = $!<Name>-H1
    !maxlen = !!ce.desp[1]
    !minlen = !!ce.desp[2]

    !aobj.setH81offset(!form.topsbfi,!minlen,!maxlen)
    !!MdsFR08.Dim3.Val = !aobj.dim1
    !!ce = $!<Name>-H1
    !!ce.poss = !aobj.start
    !!ce.pose = !aobj.end
    !!ce.drns = !aobj.drns
    !!ce.drne = !aobj.drne
    -- get the nearest pline to the section to reset the joint
    !jvec = object pointvector()
    !jvec.position = !aobj.end
    !jvec.direction = !aobj.drne
    !jplane = !jvec.plane()
    !jointpline = !aobj.getnearest(!jplane)
    goto jois
    posl $!jointpline

    !!mdsFR08.support.stack = object mdslevelstack($!<Name>-V1 , !form )

    if !aobj.drns eq !!mdsFR08.support.stack.directions[3] then $* its a straight line
       !val = 1
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[2] then $* its to the left
       !val = 2
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[1] then $* its over the top of the datum
       !val = 3
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[4] then $* its a straight line
       !val = 4
    else
        !!alert.error('Support.config invalid')
    endif

    !!mdsFR08.support.config = !val
    !!mdsFR08.tconfig.val = !val.string()
    !!mdsfrconfig.options.val = !val
    !!ce = $!<Name>-H1
    fitt 1
    zdist prop1
    cref $!topconnection
    handle ANY
    elsehandle NONE
       if !topconnection.type.eq('SBFI') then
          -- connect the fitting using :mdsancref
          !obj = object mdsbplateconn(!!ce,!topconnection)
       endif
    endhandle
    !!ce = $!<Name>-H1
    :mdsconn $!topconnection
    handle ANY
    endhandle
    move p9 of fitt 1 u clear 0 inf $!form.topsbfi
    !!ce = $!<Name>-V1
    extend start thro ppli bos start of $!<Name>-H1
    reconn recalc

    -- now do the bottom bar
    !!ce = $!<Name>-H2
    !minlen = !!ce.desp[2]
    !maxlen = !!ce.desp[1]

    !aobj.setH81offset(!form.bottomsbfi,!minlen,!maxlen)
    !!MdsFR08.Dim5.Val = !aobj.dim1
    !!ce = $!<Name>-H2
    !!ce.poss = !aobj.start
    !!ce.pose = !aobj.end
    !!ce.drns = !aobj.drns
    !!ce.drne = !aobj.drne

    -- get the nearest pline to the section to reset the joint
    !jvec = object pointvector()
    !jvec.position = !aobj.end
    !jvec.direction = !aobj.drne
    !jplane = !jvec.plane()
    !jointpline = !aobj.getnearest(!jplane)
    goto jois
    posl $!jointpline

    !!mdsFR08.support.stack = object mdslevelstack($!<Name>-V1 , !form )

    if !aobj.drns eq !!mdsFR08.support.stack.directions[3] then $* its a straight line
       !val = 1
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[2] then $* its to the left
       !val = 2
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[1] then $* its over the top of the datum
       !val = 3
    elseif !aobj.drns eq !!mdsFR08.support.stack.directions[4] then $* its a straight line
       !val = 4
    else
        !!alert.error('Support.config invalid')
    endif

    !!mdsFR08.support.config = !val
    !!mdsFR08.bconfig.val = !val.string()
    !!mdsfrconfig.options.val = !val
    !!ce = $!<Name>-H2
    fitt 1
    zdist prop1
    cref $!bottomconnection
    handle ANY
    elsehandle NONE
       if !bottomconnection.type.eq('SBFI') then
          -- connect the fitting using :mdsancref
          !obj = object mdsbplateconn(!!ce,!bottomconnection)
        endif
    endhandle
    -- get the appropriate jline for the end connection
    !!ce = $!<Name>-H2
    :mdsconn $!bottomconnection
    handle ANY
    endhandle
    move p9 of fitt 1 d clear 0 inf $!form.bottomsbfi
    !!ce = fitt 1
    !vertoffset = !datumpos.up - !!ce.ppos[9].wrt(/* ).up
    !!MdsFR08.Dim4.Val = !vertoffset

    !!ce = $!<Name>-V1
    extend end thro ppli bos start of $!<Name>-H2
    reconn recalc
--------------------------------- dimension generation -------------------------------------------
elseif (!Method eq |DIMENSION|)then

      -- Initialise variables for dimension check
      !D1 = !!MdsFR08.Dim1.Val
      !D2 = !!MdsFR08.Dim2.Val
      !D3 = !!MdsFR08.Dim3.Val
      !D4 = !!MdsFR08.Dim4.Val
      !D5 = !!MdsFR08.Dim5.Val

      if (!D1.eq(0) or !D2.eq(0) )then
        !!Alert.error('Not all of the dimensions have been completed.')
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsCreateMess(true)

    -- Position pins
      !!CE = !Datum

      -- PIN 9 TAKES P9 OF THE DATUM ATTA (DATUM ATTA POSITION POINTING DOWN)
      PIN 9 COPY P9
      -- PIN 9 DIRECTION SET TO P1O OF THE DATUM ATTA (NORTH IF NOT ROTATED)
      PIN 9 DIR $!ToVert
      PIN 8 COPY PIN9
      -- PIN 8 SET TO THE P11 DIR (SOUTH IF NOT ROTATED)
      PIN 8 DIR $!FromVert
      -- THE FOLLOWING PLANE COMMANDS APPEAR TO DO NOTHING
      PIN 9 plane PIN 9 THRO CE
      PIN 8 plane PIN 8 THRO CE
      -- POSITION PIN 9 DIMENSION 1 DISTANCE AWAY FROM THE DATUM
      PIN 9 DIST $!D1
      -- SET THE PIN 9 DIRECTION TO !DDIR (UP)????????????????????
      PIN 9 DIR $!Ddir
      PIN 7 COPY PIN 9
      PIN 7 DIST $!D2
      PIN 7 DIR $!Udir
      -- PIN 7 IS SET AT DIMENSION 2 UP FROM THE DATUM ATTA AND SHOULD BE THE POSITION OF THE FITTING

      -- NOW SWAP THE DIRECTIONS OF PIN8 AND 9
      PIN 9 DIR FROM PIN 8 TO PIN 9
      -- PIN 9 IS NOW POINTING TOWARDS THE VERTICAL MEMBER BACK TOWARDS THE DATUM ATTA
      PIN 8 DIR FROM PIN 9 TO PIN 8
      -- PIN 8 IS NOW POINTING AWAY FROM THE VERTICAL MEMBER


      -- LOOP THROUGH THE ATTAS AND FIND THE LARGEST DIMENSION
      !Dim = 0
      do !I values !Atta
        PIN 4 COPY PIN 8
        PIN 4 AT $!Datum
        PIN 4 plane PIN 4 CLEAR $!Clearance BEH $!I
          handle (2,109)
            BREAK
          endhandle
        VAR !CDIR CONST DIR P0 of $!Datum TO PIN 4
         !Cdim = !!KStrReal('CONST DIST P0 of $!Datum TO PIN 4')

        -- Set object definition
        !Direction = object KEQUALDIR()
        !Direction.DirectionA = !CDIR.direction()
        !Direction.DirectionB = !FromVert
        !Direction.Tolerance  = 0.05

        if (!Cdim.gt(!Dim) and !!KDirEqualDir(!Direction)) then
          PIN 4 AT $!Datum
          PIN 4 DIST $!CDIM
          !Dim = !Cdim
        else
          PIN 4 AT $!Datum
          PIN 4 DIST $!DIM
        endif
      enddo
      -- PIN 4 IS NOW AT THE POSITION OF THE GREATEST OFFSET AWAY FROM THE DATUM
      -- SET PIN 4 DIRECTION TO PIN 9 DIR
      PIN 4 DIR FROM PIN 8 TO PIN 9

-- endif
-- end of if statement to set pin positions
-- pins should now be in position and we can begin

  !!CE = !Stru

  -- Pins now in position create framework

    delete STRU MEM
      handle (41,66) (2,113) (2,113)
      endhandle

    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    AT $!Datum

    NEW FRMW $!NAME/MAIN
    !FrmwSupport = !!CE

    !!CE = /MDS/$!Alias/$!Selection
    !Desc = desc of /MDS/$!Alias/$!Selection
    !Type = 'HORI'

    !Subs = !!KCollectAllFor('SUBS', '', !!CE)
    !Frmw = !!KCollectAllFor('FRMW', '', !!CE)
    !FrameFormat = before(!Frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
    !!CE = !FrmwSupport
    COPY ATTRIB OF $!Frmw[1]
    COPY MEM OF $!Frmw[1] RENAME $!FrameFormat $!NAME
    do !I indices !Subs
      NEW SUBS $!NAME/SUBS$!I COPY ATTRIB OF $!Subs[$!I]
      COPY MEM OF $!Subs[$!I] RENAME $!FrameFormat $!NAME
    enddo

    -- Get direction of P9 of datum atta and dist between p9 and p0
    !!CE = !Stru

    -- Set stru description for template recognition
    desc '$!desc'

    -- move thr stru u thro the datum
    MOVE $!Udir THRO P9 OF $!Datum

    if !Support.RotateCur then
        ORI X IS p10 of $!Datum  AND Z IS u
    else
        ORI X IS p11 of $!Datum  AND Z IS u
    endif


    -- Extend and move V1
    !!CE = $!<Name>-V1
    :mdsconn $!topconnection $!bottomconnection $* connect to the panel
    handle ANY
        -- the connection does not exist
    endhandle


    -- do the top member
    !adjustpl = object mdsplines($!<Name>-V1 )
    !!CE = $!<Name>-V1
    !moveamount = !adjustpl.setdistance($!datum,!!MdsFR08.Dim1.val.real() )
     move $!moveamount
    !!MdsFR08.Dim1.Val = !adjustpl.getdistance($!datum)

    !!mdsFR08.support.stack = object mdslevelstack($!<Name>-V1 , !form )
    -- now we need to work out the direction of the support beam according to the stack
    -- should we make this a method of the stack?
    if !!mdsFR08.tconfig.val.real() eq 1 then $* its a straight line
       !ydir = !!mdsFR08.support.stack.directions[3]
    elseif !!mdsFR08.tconfig.val.real() eq 2 then $* its to the left
       !ydir = !!mdsFR08.support.stack.directions[2]
    elseif !!mdsFR08.tconfig.val.real() eq 3 then $* its over the top of the datum
       !ydir = !!mdsFR08.support.stack.directions[1]
    elseif !!mdsFR08.tconfig.val.real() eq 4 then $* its a straight line
       !ydir = !!mdsFR08.support.stack.directions[4]
    else
        !!alert.error('Support.config not set')
    endif

    !!CE = $!<Name>-V1
    -- construct plane
    !pv = object pointvector()
    !pv.position = !!ce.poss.wrt(/* )
    !pv.direction = !ydir
    !pv = !pv.offset(!!MdsFR08.Dim3.Val)
    !pv.direction = !pv.direction.opposite()
    !plane = !pv.plane()
    !uppos = !datum.position.up + !!MdsFR08.Dim2.Val - 70

    -- position and orientate H1
    !aobj = object mdsplines(!!ce,!plane,!uppos)
    !!ce = $!<Name>-H1
    !!ce.poss = !aobj.start
    !!ce.pose = !aobj.end
    !!ce.drns = !aobj.drns
    !!ce.drne = !aobj.drne
    extend end dist 60
    -- get the nearest pline to the section to reset the joint
    !jvec = object pointvector()
    !jvec.position = !aobj.end
    !jvec.direction = !aobj.drne
    !jplane = !jvec.plane()
    !jointpline = !aobj.getnearest(!jplane)
    goto jois
    posl $!jointpline
    cutplane drns of cref
    !!ce = $!<Name>-H1
    --extend start dist -100

    fitt 1
    zdist prop 1
    cref $!topconnection
    handle ANY
        -- cref not set
    elsehandle NONE
       if !topconnection.type.eq('SBFI') then
          -- connect the fitting using :mdsancref
          !obj = object mdsbplateconn(!!ce,!topconnection)
       endif
    endhandle
    !!ce = $!<Name>-V1
    extend start thro ppli tos start of $!<Name>-H1

    !!ce = $!<Name>-H1
    :mdsconn $!topconnection
    handle ANY
       -- cref not set
    endhandle
    reconn recalc

     -- do the bottom member
     --!adjustpl = object mdsplines(!!ce)
    -- !moveamount = !adjustpl.setdistance($!datum,!!MdsFR08.Dim1.val.real() )
    --  move $!moveamount
    -- !!MdsFR08.Dim1.Val = !adjustpl.getdistance($!datum)

    --!!mdsFR08.support.stack = object mdslevelstack($!<Name>-V1 , !form )
    -- now we need to work out the direction of the support beam according to the stack
    -- should we make this a method of the stack?
    if !!mdsFR08.bconfig.val.real() eq 1 then $* its a straight line
       !ydir = !!mdsFR08.support.stack.directions[3]
    elseif !!mdsFR08.bconfig.val.real() eq 2 then $* its to the left
       !ydir = !!mdsFR08.support.stack.directions[2]
    elseif !!mdsFR08.bconfig.val.real() eq 3 then $* its over the top of the datum
       !ydir = !!mdsFR08.support.stack.directions[1]
    elseif !!mdsFR08.bconfig.val.real() eq 4 then $* its a straight line
       !ydir = !!mdsFR08.support.stack.directions[4]
    else
        !!alert.error('Support.config not set')
    endif

    !!CE = $!<Name>-V1
    -- construct plane
    !pv = object pointvector()
    !pv.position = !!ce.poss.wrt(/* )
    !pv.direction = !ydir
    !pv = !pv.offset(!!MdsFR08.Dim5.Val)
    !pv.direction = !pv.direction.opposite()
    !plane = !pv.plane()
    !uppos = !datum.position.up - !!MdsFR08.Dim4.Val + 70

    -- position and orientate H1
    !aobj = object mdsplines(!!ce,!plane,!uppos)
    !!ce = $!<Name>-H2
    !!ce.poss = !aobj.start
    !!ce.pose = !aobj.end
    !!ce.drns = !aobj.drns
    !!ce.drne = !aobj.drne
    extend end dist 60
    -- get the nearest pline to the section to reset the joint
    !jvec = object pointvector()
    !jvec.position = !aobj.end
    !jvec.direction = !aobj.drne
    !jplane = !jvec.plane()
    !jointpline = !aobj.getnearest(!jplane)
    goto jois
    posl $!jointpline
    cutplane drns of cref

    !!ce = $!<Name>-H2
    --extend start dist -100

    fitt 1
    zdist prop 1
    cref $!bottomconnection
    handle ANY
    elsehandle NONE
       if !bottomconnection.type.eq('SBFI') then
          -- connect the fitting using :mdsancref
          !obj = object mdsbplateconn(!!ce,!bottomconnection)
       endif
    endhandle

    !!ce = $!<Name>-V1
    extend end thro ppli bos start of $!<Name>-H2

    !!ce = $!<Name>-H2
    :mdsconn $!bottomconnection
    handle ANY
       -- cref not set
    endhandle
    reconn recalc

endif
-- end of dimension settings

    -- Extend and move bar 1
    !!CE = $!<Name>-BAR-1
    !Flush = :MDSOlap

    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      PIN 9 plane PIN 9 CLEAR $!Onum inf $!NAME-V1
    else
      PIN 9 plane PIN 9 CLEAR $!Overlap inf $!NAME-V1
    endif
    pin 4 copy pin 8
    PIN 4 plane PIN 4 CLEAR 0 beh $!datum

    -- extend bar
    EXTEND START THRO PIN 9
    reconn recalc
    if !Support.RotateCur then
        EXTEND END THRO p10 of $!Datum
    else
        EXTEND END THRO p11 of $!Datum
    endif
    reconn recalc


   ---*********************************************8
   !sctnlen = !!Mdsgetsctnlen(!!ce,'OLD')
   reconnect recalc
   -- bar 1
   -- if the required section length is too long for bar1 we need to put something in
   if !sctnlen eq 0 then
     extend end dist 100 from posstart
   else
     extend end dist $!sctnlen from posstart
   endif
   reconnect recalc
  -- Select correct spref
    !!CE = $!<Name>/SREF
    !!MdsDacControl(true)

    SEL SPREF WITH STYP 'FR08-$!Selection' SPEC /MDF
    !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR08-$!Selection')
    !!MdsSetIspe()
    !!MdsSelLstu(!!CE)
    !!MdsDacControl(false)
    !!CE = !Stru

  -- If cross-bars existed replace them
    if (!Support.Bars.empty().not())then
      if !support.bars.size() eq 1 then
        $!NAME-V1
        -- extend start dist 20 inf $!<Name>-BAR-1
        -- extend end dist 20 behind  $!<Name>-BAR-1
        !!CE = !Stru
      else
      -- line up the attas with the vertical bar
      do !I indices !Support.Bars
       if !i eq 1 then
          -- do nothing
          --extend start dist 20 inf $!<Name>-BAR-1
          --extend end dist 20 behind  $!<Name>-BAR-1
        else
          call !!MdsAddBarFR08(!Support, 'OLD', !Method)
        endif
      enddo
    endif
      !Support.BarLen = !!MdsFR08.Support.BarLen
    endif
    !list = !Support.Bars[1]
    !References = ''

    do !I Indices !list
      !References = !References & ' ' & !list[!I].string()
    enddo

    -- Set atta reference to datum cross bar
    !!CE = $!<Name>-BAR-1
    :MDSAttaRef $!References
    handle any
    endhandle
    !Support.BarLen[1] = deri length of CE
    !!CE = !Stru

    -- Adjust for slope on horizontal lines only
    if (!Type eq |HORI|)then

       -- Check to see if the line is sloping
      !Adjust = 0
      do !V values !Atta
        !!CE = !V
         skip if !!ce.:mdsrotdir.east.set()
        !Grad = pl grad
        if (!grad neq 0)then
          !StrucElement = array()
          !Ref = $!Name-BAR-1
          !StrucElement.append(!Ref)
          !VHeight = !!MdsAdjustSlope(!StrucElement, !V)
        else
          !VHeight = 0
        endif
        if (!VHeight gt !Adjust)then
          !Adjust = !VHeight
        endif
      enddo

      -- Adjust required elements
      !!CE = $!<Name>-BAR-1
      MOVE D WRT WORLD DIST $!Adjust

      !!CE = $!<Name>-V1
      !Start = Posstart wrt world
      !End   = Posend wrt world

      PIN 7 AT $!End
      PIN 8 AT $!Start
      PIN 7 DIR TO PIN 8
      !ToBar = 0
      do !Indx indices !Support.Bars
        PIN 8 COPY PIN 7
        PIN 8 plane PIN 8 THRO $!<Name>-BAR-$!Indx
         !Tobar1 = !!KStrReal('CONST DIST PIN 7 TO PIN 8')
        if (!ToBar1 gt !ToBar)then
          !ToBar = !ToBar1
          !index = !Indx
        endif
      enddo
      PIN 8 plane PIN 8 CLEAR 0 BEH $!<Name>-BAR-$!index

  endif


  ---- if type = 'hori' endif

    !!CE = $!<Name>/SREF
    !!MdsDacControl(true)
    DESPAR $!!MdsFR08.Dim1.Val $!!MdsFR08.Dim2.Val $!!MdsFR08.Dim3.Val $!!MdsFR08.Dim4.Val $!!MdsFR08.Dim5.Val
    !!MdsDacControl(false)

  -- Reset materials of sections
--<wd>29mar2004    !!MdsResetMat(!StoreMat)

    !!CE = !Stru

-- Reset the zdist for all joints
   var !Sjois coll all sjoi for $!Name

   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     snod
     zdist thro cref of same
     handle ANY
     endhandle
   enddo

-- Navigate to Main Structure of Framework
    !!CE = !Stru

------------------------***** connexions *****--------------------------
 if(!HaveJoints) then
    do !index indices !Joints
     if(!Joints[!index].badref().not() and !Attributes[!index][8].dbref().:MDSConn.eq(!Joints[!index].owner.owner)) then
        !Mainstl = !Attributes[!index][8].dbref().:MDSConn
        !Support.Joints[!index] =  !!MdsCreateJoint(!MainStl, !Attributes[!index][8].dbref(),!Joints[!index],!Attributes[!index])
     else
        !Dummy = object dbref()
        !DummyA = array()
        !Mainstl = !Support.Connections[!index]
        !Support.Joints[!index] =  !!MdsCreateJoint(!MainStl, !Attributes[!index][8].dbref(),!Dummy,!DummyA)
     endif
    enddo
 endif
----------------------------------------------------------------------
-- Creation is complete, so we now need to extend the start and ends to suit the bracket and the bars.
-- Check that the fitting is inside the existing section length
-- might as well adjust the top and bottom to suit the bars at the same time
-- find out if the bracket is higher or lower than the current members
-- take the volume of the bracket and check to see if its within the start and end points of the
-- main section


-- if it does, do nothing
-- if its above, extend the end clearance xxx above the bracket
-- if its below, extend the start clearance xxx above the bracket
  !!CE = $!<Name>-V1

  -- calculate the up position of the fitting
  --!pos = !datum.position.wrt(/* )
  --!pos.up = !pos.up + !!mdsFR08.dim2.val.real()


  -- get fitting volume to identify the up and down limits
  -- extend the start thro the top fitting
  !!CE = $!<Name>-H1
  goto jois
  !fittvol = object volume(!!ce)
  !!CE = $!<Name>-V1
  !up = !fittvol.to.up - 10
  extend start thro u $!up wrt /*

  -- extend the start past the bottom fitting
  !!CE = $!<Name>-H2
  goto jois
  !fittvol = object volume(!!ce)
  !!CE = $!<Name>-V1
  !up = !fittvol.from.up + 10
  extend end thro u $!up wrt /*


  -- do a clash check on the brackets
  $(
  !testp = object mdsplines()
  -- clash check the bracket
  if !testp.clashFR08bracket($!<Name>-V1 , !bracket)then
    !!alert.error('Welded Plates Clash with Bracket Ubolt - Modify Dimension 2 and Rebuild Using Dimensions')
  endif
  $)
  !!ce = !stru
  -- Reset the zdist for all joints
  var !Sjois coll all sjoi for $!Name

   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     snod
     zdist thro cref of same
     handle ANY
     endhandle
   enddo

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.append(!!CE)
    !ColourList.appendarray(!Support.Atta)
    !colourlist.appendarray(!support.joints)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Reset all pins associated with this support
   call !!MdsResetPins(1,9)

  -- reset :mdsancref attributes if set
  !Support.plateconns.restoreconns()

  -- Update support data held in form
  !!MdsFR08.Support = !Support

  -- remove the create message
  !!MdsCreateMess(false)

-- Show dimensions on graphics if required
   if !!MdsFR08.GraphicalDim then
     !!Mdsshowdim(!!MdsFR08)
   endif

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdscreateFR08.pml
