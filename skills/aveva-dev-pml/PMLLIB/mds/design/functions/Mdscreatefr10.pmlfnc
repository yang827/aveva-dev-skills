--
-- File:                Mdscreatefr10.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              T.martin
-- Created:             23/02/2004 16:39
--
--
-- Description:
-- function to create support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFR10(!dummyMethod is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)
  !support    = !!mdsFR10.support
  !selection  = !!mdsSetSteel.size.selection('Rtext')
  !datum      = !support.datum
  !stru       = !support.stru
  !name       = !stru.name
  !p10Dir     = !support.p10Dir
  !p11Dir     = !support.p11Dir
  !alias      = !support.alias
  ----------------------------- **** connections **** -----------------------------
  !form       = !!mdsFR10


  -- Can we write to the spref attribute of the SREF atta
  -- and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  ---------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- set the local fittings array if its not set
  if !!mdsFR10.localfitt.set().not() then
    -- set form connections so that the save despars does not fall over
    !!mdsFR10.localfitt[1] = ARRAY()
    !elevation = !!mdsFR10.support.datum.position.wrt(/* ).up
    !!mdsFR10.localfitt[1][1] = !elevation
  endif


  -- Check which ATTAS to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -- Store section name and matref for each member
  -- for resetting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Check for framework orientation
  -- get the horizontal direction to and from the vertical member
  if (!support.rotateCur)then
    !toVert   = !p11Dir
    !fromVert = !p10Dir
  else
    !toVert   = !p10Dir
    !fromVert = !p11Dir
  endif

  --------------------------------- dimension generation -------------------------------------------

  !!mdsCreateMess(TRUE)
  !!ce = !stru

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  AT $!datum

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  !!ce = /MDS/$!alias/$!selection
  !desc = desc of /MDS/$!alias/$!selection

  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name

  -- Get direction of P9 of datum atta and dist between p9 and p0
  !!ce = !stru

  -- Set stru description for template recognition
  desc '$!desc'

  -- set the structure orientation
  ORI X IS p30 of $!datum AND Z IS u
  !!ce = $!<name>-V1
  !startdist = abs(!!mdsFR10.upoffs.val - 200)
  !enddist = abs(!!mdsFR10.lowoffs.val - 200)
  extend start dist -$!startdist
  extend end dist $!enddist
  fitt 1
  zdist prop 0.5

  end
  snod 1
  zdist thro $!datum

  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>15jan2009>- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------
  --   --if the direction is left then use p10 of the atta else use p11
  --   if !!mdsFR10.sense.val eq 1 then $* its left
  --     !strudir = !!mdsFR10.support.datum.pdir[10].wrt(/* ).string().before('WRT')
  --   else
  --     !strudir = !!mdsFR10.support.datum.pdir[11].wrt(/* ).string().before('WRT')
  --   endif

  -- Determine the P-Leave Direction of the DATUM ATTA is it UP or DOWN wrt /*
  !datumLeaveDirection = !form.support.datum.ldir.wrt(/* )

  -- Check if the DATUM ATTA Leave Direction is UP or DOWN
  if (!datumLeaveDirection.up.eq(1)) then
    -- DATUM ATTA Leave Direction is UP
    --if the direction is left then use p10 of the atta else use p11
    if !form.sense.val eq 1 then
      -- Build Direction is LEFT
      !strudir = !form.support.datum.pdir[10].wrt(/* ).string().before('WRT')
    else
      -- Build Direction is RIGHT
      !strudir = !form.support.datum.pdir[11].wrt(/* ).string().before('WRT')
    endif

  elseif (!datumLeaveDirection.up.eq(-1)) then
    -- DATUM ATTA Leave Direction is DOWN
    --if the direction is left then use p11 of the atta else use p10
    if !form.sense.val eq 1 then
      -- Build Direction is LEFT
      !strudir = !form.support.datum.pdir[11].wrt(/* ).string().before('WRT')
    else
      -- Build Direction is RIGHT
      !strudir = !form.support.datum.pdir[10].wrt(/* ).string().before('WRT')
    endif

  endif
  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>15jan2009<- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------

  -- build v1
  !!ce = $!<name>-V1
  do !a from 1 to !!mdsFR10.bardims.size()
    !up = !!mdsFR10.bardims[!a]
    if !a eq 1 then
      snod 1
      zdist thro u $!up wrt /*
    else
      !!ce = $!<name>-V1
      new snod after last mem copy snod1
      zdist thro u $!up wrt /*
    endif
  enddo
$(
  -- now do the fittings
  do !a from 1 to !!mdsFR10.suppdims.size()
    !up = !!mdsFR10.suppdims[!a]
    !!ce = $!<name>-V1
    if !a eq 1 then
      fitt1
      zdist thro u $!up wrt /*
    else
      last fitt
      new fitt copy prev
      zdist thro u $!up wrt /*
    endif
  enddo
$)

  !!ce = $!<name>-V1
  do !a from 1 to !!mdsFR10.localfitt[1].size()
    !desp = !a + 2
    desp n $!desp  $!!mdsFR10.localfitt[1][$!a]
  enddo


  !!ce = $!<name>-V1
  move $!strudir wrt /* dist $!!mdsFR10.postoffset

  -- by $!strudir $!!mdsFR10.postoffset wrt /*
  do !vert from 1 to !!mdsFR10.nposts.val.real() - 1
    !namenum = !vert + 1
    new SCTN $!<name>-V$!<namenum> copy prev
    !dim = !!mdsFR10.dim$!<vert>.val
    move $!strudir wrt /* dist $!dim
    -- by $!strudir $!dim wrt /*
    -- get rid of the old despars except 1 and 2
    !desp1 = !!ce.desp
    !!ce.desp = !desp1.deleteto(2)
    do !a from 1 to !!mdsFR10.localfitt[!namenum].size()
      !desp = !a + 2
      desp n $!desp  $!!mdsFR10.localfitt[$!namenum][$!a]
    enddo
  enddo

  -- now do the bars
  !boxlen = !!mdsFR10.l2.val + !!mdsFR10.l3.val

  -- loop through the vertical posts to find the total distance
  do !a from 1 to !!mdsFR10.nposts.val.real()
    if !a eq 1 then
      skip
    endif
    !dim = !a - 1
    !boxlen = !boxlen + !!mdsFR10.dim$!<dim>.val
  enddo

  -- we have calculated the length of the horizontal bars.
  -- now we need to build them.
  -- there is always one bar built from the template

  -- we need to know how many bars there are and what their positions are
  -- this will be stored on a form

  !p9dir = !form.support.datum.pdir[9].wrt(/* )
  !datpos = !form.support.datum.position.wrt(/* )
  -- place a pointvector at the datum
  !pv = object POINTVECTOR()
  !pv.position = !datpos
  -- move the pointvector to the vertical centreline of V1
  !pv.direction = !p9dir
  !pv = !pv.offset(30)
  -- point the point vector in the direction of the offset
  !pv.direction = $!strudir wrt /*
  handle (2,779)
    !pv.direction = axis $!strudir wrt /*
  endhandle
  -- move the pointvector to the offset position
  !startpos = !pv.offset(!!mdsFR10.postoffset.val - !!mdsFR10.l2.val)

  ------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009>- HPD0037875 - Existing Code Fix by <RM> below commented out. See the NEW Code below by <wd>.
  ------------------------------------------------------------------------------------------------------------------------------------
  -- <RM> 27 Sept 2006 >
  -- included an additional check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit

  --   VAR !attadir dir pl of $!datum
  --
  --  if !!mdsFR10.sense.val eq 1 then $* its left
  --    if !attadir.upcase().eq('U') then
  --      !flip = TRUE
  --    else
  --      !flip = FALSE
  --    endif
  --  else
  --    if !attadir.upcase().eq('U') then
  --      !flip = FALSE
  --    else
  --      !flip = TRUE
  --    endif
  --  endif
  --  ------------< end of fix
  ------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009<- HPD0037875 - Existing Code Fix by <RM> above commented out. See the NEW Code below by <wd>.
  ------------------------------------------------------------------------------------------------------------------------------------

  ------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009>- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  ------------------------------------------------------------------------------------------------------------------------------------
  !!ce = $!<name>-BAR-1
  -- Check if the DATUM ATTA Leave Direction is UP or DOWN
  if (!datumLeaveDirection.up.eq(1)) then
    -- DATUM ATTA Leave Direction is UP
    --if the direction is left then use p10 of the atta else use p11
    if !form.sense.val eq 1 then
      -- BUILD DIRECTION is LEFT
      !flip = TRUE
    else
      -- BUILD DIRECTION is RIGHT
      !flip = FALSE
    endif
  elseif (!datumLeaveDirection.up.eq(-1)) then
    -- DATUM ATTA Leave Direction is DOWN
    --if the direction is left then use p11 of the atta else use p10
    if !form.sense.val eq 1 then
      -- BUILD DIRECTION is LEFT
      !flip = TRUE
    else
      -- BUILD DIRECTION is RIGHT
      !flip = FALSE
    endif
  endif

  --   !boxdir = !startpos.direction.opposite()
  --------------------------------------------------------------------------------------------------------------------------------------
  --<wd>20jan2009<- HPD0037875 -- BUILD DIRECTION LEFT and RIGHT to FUNCTION Correctly when TRAY PLEAVE Direction is either UP or DOWN
  --------------------------------------------------------------------------------------------------------------------------------------

  !pos = !startpos.position.wrt(/* )
  !boxpos = !startpos.offset(!boxlen / 2).position
  !!ce = $!<name>-BAR-1
  if !flip then
    flip
    bang -90
  endif
  position poss at $!pos

  extend end dist $!boxlen from posstart

  if !!mdsFR10.bardims.size() eq 0 then
    -- aid box number 400 position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
  else
    !barnum = 2
    do !a from 1 to !!mdsFR10.bardims.size()
      !boxpos.up = !!mdsFR10.bardims[!a]
      if !boxpos.up eq !pos.up then
        skip
      else
        new sctn $!<name>-BAR-$!<barnum> copy $!<name>-BAR-1
        move u thro u $!boxpos.up wrt /*
        !barnum = !barnum + 1
        -- aid box number $!boxnum position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
      endif
    enddo
  endif

  -- set the current design parameters

  !!ce = $!<name>/SREF
  !!mdsDacControl(TRUE)


  --<wd>23mar2004
  -- Select correct spref
  SEL SPREF WITH STYP 'FR10-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,!alias,'FR10-$!selection')
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  --<wd>23mar2004


  desp unset

  despar n1 $!!mdsFR10.nposts.val               $* Number of Vertical Members
  despar n2 $!!mdsFR10.upoffs.val            $* Post Top Offset
  despar n3 $!!mdsFR10.lowoffs.val           $* Post Lower Offset
  despar n4 $!!mdsFR10.nbars.val                $* Number of Bars
  despar n5 $!!mdsFR10.l2.val                   $* Dimension L2
  despar n6 $!!mdsFR10.l3.val                   $* Dimension L3
  despar n7 $!!mdsFR10.postoffset.val        $* Post 1 Offset
  despar n8 $!!mdsFR10.sense.val             $* left or right build direction
  despar n9 $!!mdsFR10.topoverlap.val
  despar n10 $!!mdsFR10.bottoverlap.val
  do !a from 1 to 20
    !num = 10 + !a
    !val = !!mdsFR10$n.dim$!<a>.val
    despar n $!num  $!val   $*dim 1 to 20
  enddo

  do !b from 1 to !!mdsFR10.bardims.size()
    !num = 30 + !b
    despar n $!num  $!!mdsFR10.bardims[$!b]
  enddo


  -- now position all of the support sections
  do !a from 1 to !!mdsFR10.nposts.val.real()
    !!ce = $!<name>-V$!<a>
    !despar = !!ce.despar
    do !b from 3 to !despar.size()
      if !b eq 3 then
        fitt1
        zdist thro u $!despar[$!b] wrt /*
      else
        last fitt
        new fitt copy prev
        zdist thro u $!despar[$!b] wrt /*
      endif
    enddo
  enddo



  !!mdsDacControl(FALSE)

  -- Reset materials of sections
  --<wd>29mar2004    !!mdsResetMat(!storeMat)

  !!ce = !stru

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- Update support data held in form
  !!mdsFR10.support = !support

  -- set support connections
  !!mdsFRAsaveconns(!!mdsFR10,'WRITE')

  !!mdsCreateMess(FALSE)

  -- Show dimensions on graphics if required
  if !!mdsFR10.graphicalDim then
    !!mdsshowdim(!!mdsFR10)
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
