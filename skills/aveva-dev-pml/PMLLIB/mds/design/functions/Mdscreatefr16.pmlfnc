--
-- File:                Mdscreatefr16.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              T.martin
-- Created:             23/02/2004 16:39
--
--
-- Description:
-- function to create support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFR16(!dummymethod is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)
  !support    = !!mdsFR16.support
  !selection  = !!mdsSetSteel.size.selection('Rtext')
  !datum      = !support.datum
  !stru       = !support.stru
  !name       = !stru.name
  !p10Dir     = !support.p10Dir
  !p11Dir     = !support.p11Dir
  !alias      = !support.alias
  ----------------------------- **** connections **** -----------------------------
  !form       = !!mdsFR16

  !form.setplane()

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  ---------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- set the local fittings array if its not set
  if !!mdsFR16.localfitt.set().not() then
    -- set form connections so that the save despars does not fall over
    !!mdsFR16.localfitt[1] = ARRAY()
    !elevation1 = 750
    !elevation2 = 750
    !elevation3 = !!mdsFR16.support.datum.position.wrt(/* ).up + !elevation1
    !elevation4 = !!mdsFR16.support.datum.position.wrt(/* ).up + !elevation2
    !!mdsFR16.localfitt[1][1] = !elevation3
    !!mdsFR16.localfitt[1][2] = !elevation4
    !!mdsFR16.conntop.val = !elevation1
    !!mdsFR16.connbot.val = !elevation2
  endif

  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -- Store section name and matref for each member
  -- for reseting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Check for framework orientation
  -- get the horizontal direction to and from the vertical member
  if (!support.rotateCur)then
    !toVert   = !p11Dir
    !fromVert = !p10Dir
  else
    !toVert   = !p10Dir
    !fromVert = !p11Dir
  endif

  --------------------------------- dimension generation -------------------------------------------

  !!mdsCreateMess(true)
  !!ce = !stru

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  AT $!datum

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  !!ce = /MDS/$!alias/$!selection
  !desc = desc of /MDS/$!alias/$!selection

  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  -- Get direction of P9 of datum atta and dist between p9 and p0
  !!ce = !stru

  -- Set stru description for template recognition
  desc '$!desc'

  -- set the structure orientation
  ORI X IS p30 of $!datum AND Z IS u
  !!ce = $!<name>-V1

  -- FIND THE DATUM LEVEL AND THEN EXTEND THE VERTICAL POST TO SUIT THE UPPER AND LOWER OFFSETS
  !topelev = !!mdsFR16.support.datum.position.wrt(/* ).up + !!mdsFR16.upoffs.val
  !botelev = !!mdsFR16.support.datum.position.wrt(/* ).up - !!mdsFR16.lowoffs.val
  --!startdist = abs(!!mdsFR16.upoffs.val - 200)
  --!enddist = abs(!!mdsFR16.lowoffs.val - 200)

  extend start to u $!topelev wrt /*
  extend end  to u $!botelev wrt /*
  --- we are not dealing with fittings on FR16 so all references to fittings need to be removed

  --  fitt 1
  --  zdist prop 0.5

  --end
  --snod 1
  --zdist thro $!datum

  -- <RM> 27 Sept 2006 > -- fix 1
  -- included an additional check to see if the trays have been created from top to bottom
  -- in this case the atta dir will not be up and we need to treat the crossbar appropriately by
  -- flipping it and rotating it to suit
  VAR !attadir dir pl of $!datum
  --if the direction is left then use p10 of the atta else use p11

  if !attadir.eq('U') then
    if !!mdsFR16.sense.val eq 1 then $* its left
      !strudir = !!mdsFR16.support.datum.pdir[11].wrt(/* ).string().before('WRT')
    else
      !strudir = !!mdsFR16.support.datum.pdir[10].wrt(/* ).string().before('WRT')
    endif
  else
    if !!mdsFR16.sense.val eq 1 then $* its left
      !strudir = !!mdsFR16.support.datum.pdir[10].wrt(/* ).string().before('WRT')
    else
      !strudir = !!mdsFR16.support.datum.pdir[11].wrt(/* ).string().before('WRT')
    endif
  endif
  -- <RM> 27 Sept 2006 > -- end of fix 1

  -- build v1
  !!ce = $!<name>-V1
  do !a from 1 to !!mdsFR16.bardims.size()
    !up = !!mdsFR16.bardims[!a]
    if !a eq 1 then
      snod1
    else
      !!ce = $!<name>-V1
      new snod after last mem copy snod1
    endif
    zdist thro u $!up wrt /*
    Sjoi 1
    handle ANY
      skip
    endhandle
    if !!mdsFR16.barsides[!a].eq('R') then
      Spref /FRA/CHANNEL/UBOLT
      Posline RIGH
    elseif  !!mdsFR16.barsides[!a].eq('B') then
      Spref /FRA/CHANNEL/BOLT
    else
      Spref /FRA/CHANNEL/UBOLT
      Posline LEFT
    endif
  enddo

  -- SET CONNECTION DESPARS FROM VALUES HELD IN GADGETS
  !!mdsFR16.localfitt[1][1] = !!mdsFR16.support.datum.position.wrt(/* ).up + !!mdsFR16.conntop.val
  !!mdsFR16.localfitt[1][2] = !!mdsFR16.support.datum.position.wrt(/* ).up + !!mdsFR16.connbot.val
  !!mdsFR16.dRAWAIDS()

  !!ce = $!<name>-V1
  do !a from 1 to !!mdsFR16.localfitt[1].size()
    !desp = !a + 2
    desp n $!desp  $!!mdsFR16.localfitt[1][$!a]
  enddo

  !!ce = $!<name>-V1
  move $!strudir wrt /* dist $!!mdsFR16.postoffset
  do !vert from 1 to !!mdsFR16.nposts.val.real() - 1
    !namenum = !vert + 1
    new SCTN $!<name>-V$!<namenum> copy prev
    !dim = !!mdsFR16.dim$!<vert>.val
    move $!strudir wrt /* dist $!dim
    --by $!strudir $!dim wrt /*
    -- get rid of the old despars except 1 and 2
    !desp1 = !!ce.desp
    !!ce.desp = !desp1.deleteto(2)
    do !a from 1 to !!mdsFR16.localfitt[!namenum].size()
      !desp = !a + 2
      desp n $!desp  $!!mdsFR16.localfitt[$!namenum][$!a]
    enddo
  enddo

  -- now do the bars
  !boxlen = !!mdsFR16.l2.val + !!mdsFR16.l3.val

  -- loop through the vertical posts to find the total distance
  do !a from 1 to !!mdsFR16.nposts.val.real()
    if !a eq 1 then
      skip
    endif
    !dim = !a - 1
    !boxlen = !boxlen + !!mdsFR16.dim$!<dim>.val
  enddo

  -- we have calculated the length of the horizontal bars.
  -- now we need to build them.
  -- there is always one bar built from the template

  -- we need to know how many bars there are and what their positions are
  -- this will be stored on a form

  !p9dir = !form.support.datum.pdir[9].wrt(/* )
  !p9diropp = !form.support.datum.pdir[9].opposite().wrt(/* )
  !datpos = !form.support.datum.position.wrt(/* )
  -- place a pointvector at the datum
  !pv = object POINTVECTOR()
  !pv.position = !datpos
  -- move the pointvector to the vertical centreline of V1
  !pv.direction = !p9dir
  !pv = !pv.offset(30)
  -- point the pontvector in the direction of the offset
  !pv.direction = $!strudir wrt /*
  -- move the pointvector to the offset position
  !startpos = !pv.offset(!!mdsFR16.postoffset.val - !!mdsFR16.l2.val)

  if !!mdsFR16.sense.val eq 1 then $* its left
    !flip = FALSE
  else
    !flip = TRUE
  endif

  --!boxdir = !startpos.direction.opposite()
  !pos = !startpos.position.wrt(/* )
  !boxpos = !startpos.offset(!boxlen / 2).position
  !!ce = $!<name>-BAR-1
  if !flip then
    flip
    bang -90
  endif
  !barnum = 2
  position poss at $!pos
  extend end dist $!boxlen from posstart

  -- <RM> 27 Sept 2006 > -- fix 2 -- added check to make sure bardims is populated
  if !!mdsFR16.bardims.size() neq 0 then
    move u thro u $!!mdsFR16.bardims[1] wrt /*
    if !!mdsFR16.barsides[1].eq('B') then
      new sctn $!<name>-BAR-$!<barnum> copy $!<name>-BAR-1
      move u thro u $!!mdsFR16.bardims[1] wrt /*
      flip
      move $!p9dir dist 80
      !barnum = !barnum + 1
    elseif !!mdsFR16.barsides[1].eq('R') then
      move u thro u $!!mdsFR16.bardims[1] wrt /*
      flip
      move $!p9dir dist 80
      !barnum = !barnum + 1
    endif
  endif
  -- <RM> 27 Sept 2006 > -- end of fix 2

  if !!mdsFR16.bardims.size() eq 0 then
    -- aid box number 400 position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
  else
    do !a from 2 to !!mdsFR16.bardims.size()
      !boxpos.up = !!mdsFR16.bardims[!a]
      new sctn $!<name>-BAR-$!<barnum> copy $!<name>-BAR-1
      move u thro u $!boxpos.up wrt /*
      !barnum = !barnum + 1
      if !!mdsFR16.barsides[!a].eq('R') then
        if !!mdsFR16.barsides[1].eq('S') then
          flip
          move $!p9dir dist 80
          -- <RM> 27 Sept 2006 > -- fix 3 -- added additional logic tests to abbount for the 'B' case
        elseif !!mdsFR16.barsides[1].eq('B') then
          flip
          move $!p9dir dist 80
        endif
      elseif !!mdsFR16.barsides[!a].eq('S') then
        if !!mdsFR16.barsides[1].eq('R') then
          flip
          move $!p9diropp dist 80
        elseif !!mdsFR16.barsides[1].eq('B') then
          -- do nothing
        endif
        -- <RM> 27 Sept 2006 > -- end of fix 3
      elseif !!mdsFR16.barsides[!a].eq('B') then
        new sctn $!<name>-BAR-$!<barnum> copy $!<name>-BAR-1
        move u thro u $!boxpos.up wrt /*
        flip
        move $!p9dir dist 80
        !barnum = !barnum + 1
      endif
      -- aid box number $!boxnum position $!boxpos ori z is $!boxdir ylen 30 xlen 50 zlen $!boxlen filled off
    enddo
  endif

  -- set the current design parameters

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)

  --<wd>23mar2004
  -- Select correct spref
  SEL SPREF WITH STYP 'FR16-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,!alias,'FR16-$!selection')
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  --<wd>23mar2004

  desp unset

  despar n1 $!!mdsFR16.nposts.val      $* Number of Vertical Members
  despar n2 $!!mdsFR16.upoffs.val         $* Post Top Offset
  despar n3 $!!mdsFR16.lowoffs.val        $* Post Lower Offset
  despar n4 $!!mdsFR16.nbars.val       $* Number of Bars
  despar n5 $!!mdsFR16.l2.val             $* Dimension L2
  despar n6 $!!mdsFR16.l3.val             $* Dimension L3
  despar n7 $!!mdsFR16.postoffset.val     $* Post 1 Offset
  despar n8 $!!mdsFR16.sense.val          $* left or right build direction
  despar n9 0mm
  despar n10 0mm
  despar n11 $!!mdsFR16.walloffset.val
  despar n12 $!!mdsFR16.conndir.val
  despar n13 $!!mdsFR16.localfitt[1][1]
  despar n14 $!!mdsFR16.localfitt[1][2]

  -- variable is set to 1 only after the the create by dimension button is pressed, this allows us to force creation
  -- after a datum level change in !!mdsFR16.distcall() and through()
  !created    = 1
  despar n15 $!created

  --do !a from 1 to 20
  --  !num = 11 + !a
  -- !val = !!mdsFR16$n.dim$!<a>.val
  --  despar n $!num $!val   $*dim 1 to 20
  --enddo

  do !b from 1 to !!mdsFR16.bardims.size()
    !num = 31 + !b
    despar n $!num  $!!mdsFR16.bardims[$!b]
  enddo

  do !c from 1 to !!mdsFR16.barsides.size()
    !val = !num + !c
    despar n $!val  $!!mdsFR16.barsides[$!c]
  enddo

  if !!mdsFR16.sideplane.unset() then
    !pv = object POINTVECTOR()
    !pv.direction = !p9dir
    !pv.position = !!mdsFR16.support.datum.position.wrt(/* )
    !pp = !pv.offset(!!mdsFR16.walloffset.val + 110)
    -- <RM> 27 Sept 06 -- Fix 4 -- made the following change to correct a vector direction problem
    --!pp.direction = !pp.direction.opposite()
    !pp.direction = !pp.direction
    -- <RM> 27 Sept 06 -- End of fix 4
    !!mdsFR16.sideplane = !pp.plane()
  endif

  do !a from 1 to !!mdsFR16.nposts.val.real()
    !!ce = $!<name>-V$!<a>
    !bdesp = !!ce.desp
    !bdesp = !bdesp.removefrom(3)
    do !b from 1 to !bdesp.size()
      if !b eq 1 and !a eq 1 then $* use the bar that there already
        !!ce = $!<name>-H1
        name $!<name>-V$!<a>-H1
        !aobj = object MDSPLINES($!<name>-V$!<a> ,!form.sideplane,!bdesp[!b] )
      else
        !!ce = $!<name>-H2
        name $!<name>-V$!<a>-H2
        !aobj = object MDSPLINES($!<name>-V$!<a> ,!form.sideplane,!bdesp[!b] )
        --new sctn $!<name>-V$!<a>-H$!<b> copy $!<name>-V1-H1
        --!aobj = object MDSPLINES($!<name>-V$!<a> ,!form.sideplane,!bdesp[!b])
      endif

      !!ce.pose = !aobj.start
      !!ce.poss = !aobj.end
      !!ce.drne = !aobj.drns
      !!ce.drns = !aobj.drne
      extend end dist -80
      extend start dist 20
      handle ANY
      endhandle
      fitt 1
      zdist 0
    enddo
  enddo

  -- construct the joints for top and bottom support
  if !!mdsFR16.conndir.val eq 1 then
    !conndir = 'tos'
  else
    !conndir = 'bos'
  endif

  !!ce = $!<name>-V1
  snod2
  zdist thro u $!!mdsFR16.localfitt[1][1] wrt /*
  1
  Posline $!conndir

  !!ce = $!<name>-V1
  snod3
  zdist thro u $!!mdsFR16.localfitt[1][2] wrt /*
  1
  Posline $!conndir

  !!mdsDacControl(false)

  -- Reset materials of sections
  --<wd>29mar2004    !!mdsResetMat(!storeMat)

  !!ce = !stru


  -- Navigate to Main Structure of Framework
  !!ce = !stru


  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- Update support data held in form
  !!mdsFR16.support = !support

  -- set support connections
  !!mdsFRAsaveconns(!!mdsFR16,'WRITE')


  !!mdsCreateMess(false)

  -- Show dimensions on graphics if required
  if !!mdsFR16.graphicalDim then
    !!mdsshowdim(!!mdsFR16)
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
