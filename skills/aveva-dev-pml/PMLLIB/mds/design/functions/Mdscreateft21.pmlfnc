--------------------------------------------------------------------------------
--
-- File:		Mdscreateft21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPS145
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 28th October 1997
--
--
-- Description:
-- function to create Framework type FT21
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFt21(!method is string)

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

-- Initialise variables
    call !!Mdsresetpins(1,9)
    !support   = !!Mdsft21.support
    --!clearance = !!Mdsoptions.clear.val
    -- !selection = !!Mdsft21.size.selection('rtext')
    !Selection = !!MdsSetSteel.Size.Selection('Rtext')
    !type      = !!Mdsft21.type.selection()
    !Stru      = !Support.Stru
    !datum     = !support.datum
    --<k.pleschner>May06
    !DatumDflts = object MDSANCGEOMDFLTS(!Datum)
    !Clearance = !DatumDflts.Cend
    --<k.pleschner>May06

-- Does the support have attached/Associated supports

   if !!mdsgetconnectedsupp(!stru) then
     !!kRestoreUnits(!currentunits)
     return
   endif

    !Form = !!mdsft21

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

-- Check that Datum atta has been created
-- Moved here because of the datum atta is not created the the Bars[1]
-- variable set below is not set and the function fails
    if (!datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

    !stru      = !support.stru
    !name      = !stru.name
    !atta      = !support.bars[1]

-- Set DATUM Atta Directions
    !p9dir     = !support.p9dir
    !p10dir    = !support.p10dir
    !p11dir    = !support.p11dir

-- Store section name and matref for each member
-- for reseting later

    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)


--------------------------------------------------------------------------------------
--<GE> 25/01/07 Navigate to the correct element
    !!ce = !atta[1]
--<GE> 25/01/07
--------------------------------------------------------------------------------------
    if (!method eq 'MdsADDPIPE') then
      if (!!ce.type eq 'BRAN') then
        !currcomp  = !!ce
      elseif (!!ce.owner eq BRAN) then
        !currcomp  =  !!ce
      endif
    endif

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Check that Datum atta has been positioned
    if (!support.position.not())then
      !!alert.message('Position Datum support atta before proceeding')
      !!kRestoreUnits(!currentunits)
      return
    endif

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

------------------------------
--> Modified - <wd> - 3sep1998

$(
--> Commented Out - <wd> -24aug2001

-- Check if ONLY the DATUM Exists, and DELETE All Stru Members if 'TRUE'
   if (!support.atta.size().lt(3)) then
     !!ce = !stru
     delete stru mem
     return
   endif
$)

-- The following code has been added if the 'Type' - 'True' is selected on the form.
-- Determine Which Atta on the Support is the FURTHEST distance from the DATUM Atta,
-- and USE this Atta to DETERMINE the 'TRUE' Angle of ALL the ATTA's and the
-- Supporting Structure

   if (!type eq 'T') then
--------

-- Determine the Furthest Atta from the DATUM Atta on the P10 side of the DATUM Atta
     !p10dim = 0

     do !x10atta values !atta
       skip if (!x10atta eq !datum)

       pin 3 copy p10 of $!datum
       pin 3 plane pin 3 thro $!x10atta
       var !x10dir cons dire p0 of $!datum to pin 3

-- Set object definition and Determine if Atta is on the
-- P10 side of the DATUM Atta
       !direction = object KEQUALDIR()
       !direction.directionA = !x10dir.direction()
       !direction.directionB = !p10dir
       !direction.tolerance  = 0.05

       if (!!kdirequaldir(!direction)) then

-- Calculate Maximum Distance from the DATUM Atta to the FURTHEST Atta
-- away from the DATUM Atta on the P10 side of the DATUM Atta

         pin 1 at $!datum
         pin 2 at $!x10atta
         pin 1 dir to pin 2
         pin 2 dir to pin 1

         !x10dim = !!kstrreal('const dist pin 1 to plane pin 2')

         if (!x10dim gt !p10dim) then
           !p10dim = !x10dim
           !xatta  = !x10atta
           var !xpin1dir pin 1 dir wrt /*
           !xdir   = !xpin1dir.direction()
         endif

       endif

     enddo

-- Determine the Furthest Atta from the DATUM Atta on the P11 side of the DATUM Atta
     !p11dim = 0

     do !z11atta values !atta
       skip if (!z11atta eq !datum)

       pin 3 copy p11 of $!datum
       pin 3 plane pin 3 thro $!z11atta
       var !z11dir cons dire p0 of $!datum to pin 3

-- Set object definition and Determine if Atta is on the
-- P11 side of the DATUM Atta
       !direction = object KEQUALDIR()
       !direction.directionA = !z11dir.direction()
       !direction.directionB = !p11dir
       !direction.tolerance  = 0.05

       if (!!kdirequaldir(!direction)) then

-- Calculate Maximum Distance from the DATUM Atta to the FURTHEST Atta
-- away from the DATUM Atta on the P11 side of the DATUM Atta

         pin 1 at $!datum
         pin 2 at $!z11atta
         pin 1 dir to pin 2
         pin 2 dir to pin 1

         !z11dim = !!kstrreal('const dist pin 1 to plane pin 2')

         if (!z11dim gt !p11dim) then
           !p11dim  = !z11dim
           !zatta   = !z11atta
           var !zpin1dir pin 1 dir wrt /*
           !zdir    = !zpin1dir.direction()
         endif

       endif

     enddo

-- Now Determine Which Atta is Furthest Away from the DATUM Atta between the
-- Atta on the P10 side, '!xatta', and  the Atta on the P11 side, '!zatta'.

     !xdef = (defined(!xatta))
     !zdef = (defined(!zatta))

     if (!xdef and !zdef) then
-- Attas exist on BOTH sides of the DATUM Atta
       if (!p10dim ge !p11dim) then
         !usedire = !xdir
         !useppt  = 'p10'
       elseif (!p11dim gt !p10dim) then
         !usedire = !zdir
         !useppt  = 'p11'
       endif
     elseif (!xdef and !zdef.not()) then
-- Atta ONLY Exists on the P10 side of the DATUM Atta
       !usedire = !xdir
       !useppt  = 'p10'
     elseif (!xdef.not() and !zdef) then
-- Atta ONLY Exists on the P11 side of the DATUM Atta
       !usedire = !zdir
       !useppt  = 'p11'
     else
-- Only the DATUM Atta Exists, so Use the P10 side
       !usedire = !p10dir
       !useppt  = 'p10'
     endif

-- Then RE-Orientate the DATUM ATTA and All Other Attas on the Support
     do !dbref values !support.atta
       !!ce = !dbref
       ori and $!useppt is $!usedire
     enddo

-- Reset Direction Members held in the object MdsSUPPORT
     !support.p9dir  = p9  dir of $!datum wrt /*
     !support.p10dir = p10 dir of $!datum wrt /*
     !support.p11dir = p11 dir of $!datum wrt /*
     !p9dir          = !support.p9dir
     !p10dir         = !support.p10dir
     !p11dir         = !support.p11dir

--------
   elseif (!type eq 'S') then

-- Re-Orientate All Attas to be the same as the DATUM Atta
     do !dbref values !support.atta
       !!ce = !dbref
       ori and p9 is $!p9dir
     enddo

--------
   endif

-- Reset All Pins before Positioning Pins for the Structural Layout
   call !!Mdsresetpins(1,10)

--< Modified - <wd> - 3sep1998
------------------------------

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Generate Creation Prompt..
    !!Mdscreatemess(true)

-- Set initial orientation
    pin 1 copy p9 of $!support.datum
    pin 1 dist 100
    pin 1 dir to p9 of $!support.datum
    var !p1dir dir pin 1 wrt /*
    !ddir = !p1dir.direction()

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Generate Pin Positions

-- Position Pins 3 and 8 at P9 of Datum Atta
    pin 8 copy p10 of $!datum
    pin 8 at p9 of $!datum
    pin 3 copy p11 of $!datum
    pin 3 at p9 of $!datum

    !dim  = 0
    !pin1 = 0

-- Set First Direction
-- Position Pin 4 Clear of Furthest Atta away from Datum in P10dir direction
--<k.pleschner>May06
      --do !I values !Atta
      do !Iref values !Atta
        -- avoid SREF atta
        skip if !Iref.name.Substring(-1,-5).eq('/SREF')
        !I = object MDSANCGEOMDFLTS(!Iref)
        pin 4 copy pin 8
        pin 4 at $!datum
        pin 1 copy pin 4
        --pin 4 plane pin 4 clear $!clearance beh $!I
        if !I.Clge.eq('GEOM') then
           -- use clearance from geometry
           PIN 4 plane PIN 4 CLEAR $!I.Oend BEH $!I
        else
           -- use distance from centreline
           PIN 4 plane PIN 4 THR $!I
           PIN 4 plane PIN 4 DIST $!I.Oend
        endif
          handle (2,109)
            break
          endhandle
        pin 1 plane pin 1 thro $!I
        var !cdir const dir p0 of $!datum to pin 4
        !Cdim = !!KStrReal('const dist p0 of $!datum to plane pin 4')
        !Cpn1 = !!KStrReal('const dist p0 of $!datum to plane pin 1')

--------------------------------------------------------------------------------------

-- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !cdir.direction()
        !direction.directionB = !p10dir
        !direction.tolerance  = 0.05

        if (!cdim.gt(!dim) and !!kdirequaldir(!direction)) then
          pin 4 at $!datum
          pin 4 dist $!cdim
          !Dim = !cdim
          pin 1 at $!datum
          pin 1 dist $!cpn1
          !pin1 = !cpn1
        else
          pin 4 at $!datum
          pin 4 dist $!dim
          pin 1 at $!datum
          pin 1 dist $!pin1
        endif
      enddo

      pin 4 dir $!ddir
      pin 4 plane pin 4 thro pin 8
      pin 4 dir to pin 8

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

      !dim  = 0
      !pin2 = 0

-- Set Second Direction
-- Position Pin 9 Clear of Furthest Atta away from Datum in P11dir direction
--<k.pleschner>May06
      --do !I values !Atta
      do !Iref values !atta
        -- avoid SREF atta
        skip if !Iref.name.Substring(-1,-5).eq('/SREF')
        !I = object MDSANCGEOMDFLTS(!Iref)
        pin 9 copy pin 3
        pin 9 at $!datum
        pin 2 copy pin 9
        --pin 9 plane pin 9 clear $!clearance beh $!I
        if !I.Clge.eq('GEOM') then
           -- use clearance from geometry
           PIN 9 plane PIN 9 CLEAR $!I.Oend BEH $!I
        else
           -- use distance from centreline
           PIN 9 plane PIN 9 THR $!I
           PIN 9 plane PIN 9 DIST $!I.Oend
        endif
          handle (2,109)
            break
          endhandle
        pin 2 plane pin 2 thro $!I
        var !cdir const dir p0 of $!datum to pin 9
        !cdim = !!kstrreal('const dist p0 of $!datum to pin 9')
        !cpn2 = !!kstrreal('const dist p0 of $!datum to plane pin 2')

--------------------------------------------------------------------------------------

-- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !cdir.direction()
        !direction.directionB = !p11dir
        !direction.tolerance  = 0.05

        if (!cdim.gt(!dim) and !!kdirequaldir(!direction)) then
          pin 9 at $!datum
          pin 9 dist $!cdim
          !Dim = !cdim
          pin 2 at $!datum
          pin 2 dist $!cpn2
          !pin2 = !cpn2
        else
          pin 9 at $!datum
          pin 9 dist $!dim
          pin 2 at $!datum
          pin 2 dist $!pin2
        endif
      enddo

      pin 9 dir $!ddir
      pin 9 plane pin 9 thro pin 3
      pin 9 dir to pin 3

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

--xxx      if (!d1.eq(0))then
--xxx        !!Alert.error('Dimension 1 has to be set.')
--xxx        !!kRestoreUnits(!currentunits)
--xxx        return
--xxx      endif

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

----------------------------------------------------------------------
----------------------------------------------------------------------

-- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
-- and the Type and Size of the Packing Pieces to Recreate
    !attapp = !!Mdspackers(!support)

----------------------------------------------------------------------
----------------------------------------------------------------------

    !!ce = !stru

-- Pins now in position create framework

    delete stru mem
      handle (41,66) (2,113) (2,113)
      endhandle

--<wd>oct2000
    !mdstemp = /MDS/FT21/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

--<wd>oct2000

    at $!datum

    new frmw $!name/MAIN
    !frmwsupport = !!ce

-- Copy required template/s
    !!ce = /MDS/FT21/$!selection
    !frmw = !!kcollectallfor('FRMW', '', !!CE)
    !frameformat = before(!frmw[1].name, '-FRMW')
    !desc = desc
    !Mdsbars = :MdsBars

-- Navigate back to support and create template elements
    !!ce = !frmwsupport
    copy attrib of $!frmw[1]
    copy mem oF $!frmw[1] rename $!frameformat $!name

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Get direction of P9 of datum atta and dist between p9 and p0

    !!ce = !stru

-- Set stru description for template recognition

    desc '$!Desc'
    :Mdsbars $!Mdsbars


    move $!P9dir thro p9 of $!datum

    !orix = !p11dir
    !oriz = !ddir

    ori x is $!orix and z is $!oriz
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Set dimensions
-- Dimension 1
    !Dim1 = !!KStrReal('const dist pin 1 to pin 2')
      !!KFormatText.text.Val = !Dim1
      !!Mdsft21.dim1.val = !!kformattext.text.val.string(!!$!!kFormattext.text.format)


--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Extend and move bar 1

    !!ce = $!<name>-BAR-1

    extend start thro pin 4
    extend end thro pin 9

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Select correct spref

    !!ce = $!<name>/SREF

-- Select the CORRECT SREF atta depending on Pipe size
    !!MdsDacControl(true)
    sel spref with styp 'FT21-$!Selection' spec /MDF
    !!MdsSetSuppCode('MODIFY',!Name,'FT21','FT21-1')

    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(TRUE)
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

    !!ce = !stru

-- Associate attas to bar

    !list = !support.bars[1]
    !references = ''
    do !I indices !list
      !references = !references & ' ' & !list[!I].string()
    enddo

-- Set atta references
    !!ce = $!<name>-BAR-1
    :MDSAttaRef $!references
    !support.barlen[1] = deri length of ce
    !!ce = !stru

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------


    !!ce = $!<name>/SREF

-- Remove space from imperial line if they exist

    !Space = !!Mdsft21.dim1.val.string().replace(' ','')
    !!MdsDacControl(true)
    despar $!Space $!type
    handle any
    endhandle
    !!MdsDacControl(false)
    --despar $!!Mdsft21.dim1.val $!type

  -- Reset materials of sections

    !!MdsResetMat(!StoreMat)


--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Navigate to structure
    !!ce = !stru
    if (!support.mirror)then
      call !!Mdsmirrorft21()
      !support.mirror = true
    endif

----------------------------------------------------------------------
----------------------------------------------------------------------

-- Set 'FT25' form Support Object to be the same as 'FT21' form Support Object
    !!Mdsft25.support = !support

-- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
-- During the Framework Creation above
    !!Mdsft25.support.packs.clear()
    !support.packs.clear()

-- Create Required Packing Pieces(SCTNs) at the Necessary Attas
    call !!Mdscrpacksft25(!attapp, !!Mdsft21)

-- Update 'FT21' support.packs data to that held in form 'FT25'
    !support.packs = !!Mdsft25.support.packs

-- Navigate to Main Structure of Framework
    !!CE = !Stru

----------------------------------------------------------------------
----------------------------------------------------------------------

-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.append(!!ce)
    !colourlist.appendarray(!support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Reset all pins associated with this support
    call !!Mdsresetpins(1,9)

-- Update support data held in form
    !!Mdsft21.support = !support

--------------------------------------------------------------------------------------
-- Navigate back to Original Element
    if (!method eq 'MdsADDPIPE') then
      !!ce = !currcomp
    endif
--------------------------------------------------------------------------------------

--> Modified - <wd> - 3sep1998
-- Reset to the DEFAULT Callback on the '.apply' button on the form 'MdsBOPDIR'
    !!Mdsbopdir.apply.callback = 'call !!Mdssetbopdir(_form)'
--< Modified - <wd> - 3sep1998
--------------------------------------------------------------------------------------

  !!Mdscreatemess(false)

  -- Show dimensions on graphics if required

    if !!MdsFt21.GraphicalDim then
      !!Mdsshowdim(!!Mdsft21)
    endif

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdscreateft21.pml
