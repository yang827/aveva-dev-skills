--
-- File:  Mdscreateft22.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS146
--
-- Author:  I.osborne
-- Created:  Wed Jun 18
--
--
-- Description:
-- function to create support frame type 22
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt22(!support is MDSSUPPORT)

  -- Initialise variables
  !name    = !support.stru.name
  !type    = !!mdsFT22.type.selection('Rtext').trim()
  !size    = !!mdsFT22.size.selection('Rtext')

  !!mdsCreateMess(true)

  -- Navigate to structure
  !!ce = !support.stru

  DELETE STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !desc = desc of /MDS/TEMPLATES
  !!ce.desc = desc of /MDS/FT22/$!<size>$!<type>
  !!ce.func = func of /MDS/FT22/$!<size>$!<type>
  !!ce.purp = purp of /MDS/FT22/$!<size>$!<type>

  -- Create Bed Plate
  -- rm dec 2005
  if (!desc eq 'Initec Industrial Templates') then
    handle ANY
    elsehandle NONE
      COPY mem OF /MDS/FT22/$!<size>$!<type>
      subs 1
      PRFL '$!type'
      RENAME $!<name>/MAIN
      !memNum = !!ce.mcount('subs')
      do !i from 2 to !memNum by 1
        subs $!i
        !j = !i - 1
        RENAME $!<name>/SUBS$!<j>
      enddo
      stru
    endhandle
    -- else we create the bedplate normally
  else
    NEW SUBS $!name/MAIN
    PRFL '$!type'

    COPY MEM OF /MDS/FT22/$!<size>$!<type>-SUBS1
    box 2
    handle ANY
    elsehandle NONE
      if !!mdsFT22.height.val.unset().not() then
        !dist = !!mdsFT22.height.val
        RULE SET POS DYNAMIC (D ( $!dist - ( 0.5 * ATTRIB ZLEN ) ) FROM PP 3 OF BOX 1 OF SUBSTRUCTURE )
        rule execute all
        SUBS
        LENGTH  $!!mdsFT22.height.val
        stru
      endif
      --rule execute all
    endhandle
  endif

  !!ce = !support.stru
  SKEY 'BEDP'
  :MdsComment 'Type $!type'

  --<RM> have expanded this with catch all cases for the type G case
  --this was obviously designed to allow a user to include a framework alongside the
  --bedplate but i can't find any specific records. i have therefore updated the code to
  --work for all cases.
  if (!desc neq 'Initec Industrial Templates') then
    if (!type EQ 'G' ) then
      !current = !!ce
      /MDS/FT22/$!<size>$!<type>-FRMW
      handle ANY
        -- do nothing
        !!ce = !current
      elsehandle NONE
        !!ce = !current
        NEW FRMW $!name-FRMW
        COPY MEM OF /MDS/FT22/$!<size>$!<type>-FRMW
        STRU
        RULE EXECUTE ALL
      endhandle
    endif
  else
    if (!type EQ 'G' ) then
      !current = !!ce
      /MDS/FT22/$!<size>$!<type>-FRMW
      handle ANY
        -- do nothing
        !!ce = !current
      elsehandle NONE
        !!ce = !current
        NEW FRMW $!name-FRMW
        COPY MEM OF /MDS/FT22/$!<size>$!<type>-FRMW
        STRU
        RULE EXECUTE ALL
      endhandle
    endif
  endif

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    !!mdsModifySupp.cancel.active = true
  endif

  -- If the purp of the stru is set to EDIT open up the dim gadgets
  if !support.stru.purp.eq('EDIT') then
    if (!desc eq 'Initec Industrial Templates') then
      if !type eq 'A' or !type eq 'B' then
        !!mdsFT22.xlen.active = TRUE
        !!mdsFT22.ylen.active = TRUE
        !!mdsFT22.zlen.active = FALSE
      else
        !!mdsFT22.xlen.active = TRUE
        !!mdsFT22.ylen.active = TRUE
        !!mdsFT22.zlen.active = TRUE
      endif
    else
      !!mdsFT22.xlen.active = TRUE
      !!mdsFT22.ylen.active = TRUE
      !!mdsFT22.zlen.active = TRUE
    endif
  else
    !!mdsFT22.xlen.active = FALSE
    !!mdsFT22.ylen.active = FALSE
    !!mdsFT22.zlen.active = FALSE
  endif

  !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of $!name
  handle any
  endhandle
  !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of $!name
  handle any
  endhandle
  !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of $!name
  handle any
  endhandle

  !!mdsCreateMess(false)

endfunction
