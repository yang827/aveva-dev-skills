--
-- File:    Mdscreateft24.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:   Thursday 27 November
--
--
-- Description:
-- function to create support frame type 24
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt24(!dummyMethod is STRING)

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !support    = !!mdsft24.support
  !datum      = !support.datum
  !selection  = !!mdsSetSteel.size.selection('Rtext')
  !stru       = !support.stru
  !name       = !stru.name

  !form = !!mdsft24

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before creating supporting steelwork')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Initialise variables for dimension check
  !d2 = !!mdsft24.dim2.val
  if (!d2.eq(0)) then
    !!alert.error('Dimension 2 cannot be set to 0')
    !!kRestoreUnits(!currentunits)
    return
  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of ATTAS with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attaPack = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------
  -- Create Framework

  !!ce = !stru

  !!mdsCreateMess(true)

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  if (!selection eq '1') then
    !selTag = 'A'
  elseif (!selection eq '2') then
    !selTag = 'B'
  elseif (!selection eq '3') then
    !selTag = 'C'
  elseif (!selection eq '4') then
    !selTag = 'D'
  elseif (!selection eq '5') then
    !selTag = 'E'
  elseif (!selection eq '6') then
    !selTag = 'F'
  elseif (!selection eq '7') then
    !selTag = 'G'
  endif
  !value = !!mdsft24.dim1.val
  !mdsTemp = /MDS/FT24/$!selTag$!value
  :mdsCheck $!mdsTemp.:mdsCheck
  :mdsFraMirror $!mdsTemp.:mdsFraMirror

  --<wd>oct2000

  AT p9 of $!datum

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  if (!selection eq '1') then
    !selTag = 'A'
  elseif (!selection eq '2') then
    !selTag = 'B'
  elseif (!selection eq '3') then
    !selTag = 'C'
  elseif (!selection eq '4') then
    !selTag = 'D'
  elseif (!selection eq '5') then
    !selTag = 'E'
  elseif (!selection eq '6') then
    !selTag = 'F'
  elseif (!selection eq '7') then
    !selTag = 'G'
  endif

  -- Copy required template
  !value = !!mdsft24.dim1.val
  !!ce = /MDS/FT24/$!selTag$!value
  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')
  !desc = desc
  !mdsBars = :mdsBars

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  pin 9 copy pa of $!datum
  pin 8 copy pa of $!datum
  pin 9 dist 100mm
  pin 9 dir d wrt /*
  pin 9 plane pin 9 thro pin 8
  var !dir const dir pin 9 to pin 8

  -- ori the frmw to the atta
  --!pldir = pl dir of $!datum wrt worl
  !!ce = !stru
  ori y is $!dir wrt /* and z is u wrt world

  ----------------------------------
  $!name/SREF
  !!mdsDacControl(true)
  SEL SPREF WITH STYP 'FT24-$!selTag-$!value' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,'FT24','FT24-A-1')
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- store compensations
  !complates = !!mdsCompplateDflts.compensatingPlates(!form)

  -- Adjust position for dimension depending on rotateCur

  if (!support.rotateCur)then
    !negate  = '-'
  else
    !negate  = ''
  endif

  !adjustPos = !!mdsft24.dim1.selection('RTEXT').real() / 2 - !!mdsft24.dim2.val
  !!mdsDacControl(false)
  if (!adjustPos neq 0) then
    !!ce = !stru
    ------------------
    --> Modified - <wd> - 4sep1998
    !sMem = !stru.mcount()
    do !all  from 1 to !sMem
      $!all
      --        !adjustPos = !adjustPos.abs()
      --        by x $!<negate>$!adjustPos wrt stru
      !apos = $!<negate>!adjustPos
      by x $!apos wrt stru
      !!ce = !stru
    enddo
    --< Modified - <wd> - 4sep1998
    ------------------
  endif
  !!mdsDacControl(false)

  -- Check to see if the line is sloping
  !!ce = !datum
  !grad = pl grad
  if (!grad neq 0)then
    !strucElement = ARRAY()
    !ref = $!name-BAR-1
    !strucElement.append(!ref)
    !ref = $!name-BAR-2
    handle none
      !strucElement.append(!ref)
    elsehandle (2,109)
    endhandle
    !adjust = !!mdsAdjustSlope(!strucElement, !datum)
    --!half   = !adjust / 2
    -- Navigate to supporting structure
    !!ce = !stru
    by D $!adjust
  endif

  -- Store dimensions in design parameters

  $!name/SREF
  !!mdsDacControl(true)
  DESPAR  $!!mdsft24.dim1.val  $!!mdsft24.dim2.val
  !!mdsDacControl(TRUE)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)
  !!ce = !stru
  if (!support.mirror)then
    call !!mdsMirrorFt24()
    !support.mirror = true
  endif

  -- Adding atta's to :MDSAttaRef of cross bar 1

  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE
  !!ce = !stru

  -- Set stru description for template recognition

  desc '$!desc'
  :mdsBars $!mdsBars

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'FT24' form Support Object
  !!mdsft25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsft25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNS) at the Necessary ATTAS
  call !!mdscrpacksft25(!attaPack, !!mdsft24)

  -- Update 'FT24' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsft25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Update support data held in form
  !!mdsft24.support = !support

  !!ce = !support.stru
  -- Copy welds locally
  --!copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru

  !!mdsCreateMess(false)

  -- restore compensation
  -- We only need to restore the compensations if were re creating the framework by e.g. cursor, and not when were cancelling the form.
  -- The global variable !!cancellingForm is set in !!mdsRestoreForm as this was the only way to do the check
  if defined(!!cancellingForm) then
    if !!cancellingForm.not() then
      !!mdsCompplateDflts.compensatingPlates(!complates)
    endif
  else
    !!mdsCompplateDflts.compensatingPlates(!complates)
  endif

  -- Show dimensions on graphics if required

  if !!mdsft24.graphicalDim then
    !!mdsshowdim(!!mdsft24)
  endif

  !!mdsResetPins(8,9)

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
