--
-- File:                Mdscreateft30.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              I.Osborne
-- Created:             Mon Jun 23
--
--
-- Description:
-- function to create support frame type 31
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFt30(!Method is string)

-- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()

-- Initialise variables
    call !!MdsResetPins(1,10)
    !Support    = !!Mdsft30.Support
    !Clearance  = !!MdsOptions.Clear.val
    !Overlap    = !!MdsOptions.Overlap.val
    !Selection  = !!MdsSetSteel.Size.Selection('Rtext')
    !Datum      = !Support.Datum
    !Stru       = !Support.Stru
    !Name       = !Stru.name
    !Namn       = !Stru.namn
    !P10Dir     = !Support.P10Dir
    !P11Dir     = !Support.P11Dir
    !Alias      = !Support.Alias
    !Type       = 'HORI'
    !Refe         = !!CE
    !Form      = !!MdsFT30

-- Does the support have attached/Associated supports

   if !!mdsgetconnectedsupp(!stru) then
     !!kRestoreUnits(!currentunits)
     return
   endif

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- !Atta = !!ce
    !Atta = !Support.Bars[1][1]
    -- framework goes between datum atta and !atta

    -- copy the correct structure according to bore size
    !bore = !datum.abore
    var !strucoll collect all stru for /MDS/FRAMES/FT30
    handle any
      !!Alert.message('/MDS/FRAMES/FT30 Does not exist - Aborting Creation')
      return
    endhandle

    -- if the calling method is CURSOR select the first template size that matches
    -- this pipe bore otherwise use passed selection number

    if (!method.eq('CURSOR')) then


      do !st values !strucoll
       if !bore.leq(!st.dbref().:mdsmaxbore.bore() ) and !bore.geq(!st.dbref().:mdsminbore.bore() ) then $* its the one
           -- Navigate to Stru
          !!ce = !stru
          -- Pins now in position create Framework
          delete stru mem
           handle (41,66) (2,113) (2,113)
           endhandle
          !mdstemp = /MDS/$!Alias/$!Selection
          :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror


         -- Temporarily Position Structure at Datum Atta
         at p4 of $!datum
         new frmw $!name/MAIN
         !frmwsupport = !!ce

         -- Copy required template/s
         !!ce         = !st.dbref()
         !frmw        = !!kcollectallfor('FRMW', '', !!ce)
         !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
         !frameformat = before(!frmw[1].name, '-FRMW')
         break
       endif
      enddo


    else

      -- check selection is valid for this bore
      if !bore.leq(!strucoll[$!selection].dbref().:mdsmaxbore.bore() ) and !bore.geq(!strucoll[$!selection].dbref().:mdsminbore.bore() ) then
      else
        -- bore not in range for selected framework
        !!alert.error('Selected template is not suitable for this pipe bore')
        return
      endif

       -- Navigate to Stru
      !!ce = !stru
      -- Pins now in position create Framework
      delete stru mem
       handle (41,66) (2,113) (2,113)
       endhandle
      !mdstemp = /MDS/$!Alias/$!Selection
      :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror


     -- Temporarily Position Structure at Datum Atta
     at p4 of $!datum
     new frmw $!name/MAIN
     !frmwsupport = !!ce

     -- Copy required template/s
     !!ce         = !strucoll[$!selection].dbref()
     !frmw        = !!kcollectallfor('FRMW', '', !!ce)
     !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
     !frameformat = before(!frmw[1].name, '-FRMW')

   endif

   --------------------------------------------------------------------------------------
   -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!Alias/$!Selection
  !MdsBars = :mdsbars of /MDS/$!Alias/$!Selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!Desc'
  :mdsbars $!mdsbars

  stru

-- Orientate stru
  ori y is p5 of $!datum and z is U wrt /*
  !dir = !datum.pdir[4].opposite().string()
  !dist = !datum.desparam[2] / 2
  var !sctn coll all sctn for ce
  !!ce = !sctn[1].dbref()
  name $!name$n-BAR-1
  handle any
  endhandle
  !param = !!ce.param[3]
  !ofsetparam = !!ce.param[5]
  !extendparam = !!ce.param[8]
  :MDSAttaRef  $!atta $!datum
  stru
  move along $!dir dist ($!dist + $!param)
  same

  extend end plane p5 of $!datum dist $!extendparam beh  p4 of $!atta
  extend start plane p5 of $!datum dist $!ofsetparam inf $!datum

  -- determine dimension H
  pin 7 at $!atta
  pin 7 dir d
  pin 8 copy pin 7
  pin 8 plan d thr $!datum
  var !dimH construct distance pin 7 to pin 8

  !!CE = $!<Name>-BAR-1


-- Store section name and matref for each member
-- for reseting later

    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)




    -- Check for framework orientation
      if (!Support.RotateCur)then
        !ToVert   = !P11Dir
        !FromVert = !P10Dir
      else
        !ToVert   = !P10Dir
        !FromVert = !P11Dir
      endif

      !!MdsCreateMess(true)


  -- Select correct spref

    !!ce = !stru

  -- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.append(!!CE)
    !ColourList.appendarray(!Support.Atta)
    !colourlist.appendarray(!support.joints)

  -- Colour Support
    call !!KEnhanceList(!ColourList)

  -- Reset all pins associated with this support
    call !!MdsResetPins(1,10)

  -- Update support data held in form
    !!Mdsft30.Support = !Support

  -- clear any dimension errors from previous support build and determine
  -- if any min/max errors exist for this build
   !!mdsFT30.dimerrors.clear()

  -- check if the created framework's H dimension (dim 1) is greater than max
  -- this cannot be checked as part of consistency report as there is no way
  -- at present to calculate the dim checks separate from the sctn length checks
  if ($!dimH gt 1300mm) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimHD dist(1300mm)
    units mm bore mm dist
    !error = |Support dimension 1 is greater than allow maximum of $!dimHD|
    !!alert.warning(!error)
    !!mdsFT30.dimerrors.append(!error)
  endif

  !!MdsDacControl(true)

  --<kp>july06
  --!!ce = !Datum
  !!ce = !support.GetelemforUDA()
  !MdsAdp = :MdsAdp
  !MdsAdp.Append(bran of href of bran of $!name/DATUM )
  !MdsAdp.Append(bran of href of bran of $!name$n.1 )
  !MdsAdp.unique()

  do !add from 1 to !MdsAdp.size()
    :MdsAdp number $!add $!MdsAdp[$!add]
  enddo

  $!Name$n.1
  var !p3Dir const direction p0 to p3

  stex '$!namn
ORI = $!p3dir'

  !!MdsCreateMess(false)

-- Show dimensions on graphics if required
   if !!Mdsft30.GraphicalDim then
     !!Mdsshowdim(!!Mdsft30)
   endif

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- set position flag to true (the support has been positioned)
   !!Mdsft30.Support.position = true

-- Set bar length
   !!CE = $!<Name>-BAR-1
   !!Mdsft30.Support.BarLen[1] = deri length of CE

-- End function
endfunction

-- End of file Mdscreateft30.pml
