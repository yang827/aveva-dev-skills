--
-- File:                MdscreateFT54B.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              Richard Martin
-- Created:             January 2006
--
--
-- Description:
-- function to create support frame FT54B
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFT54B(!Method is string)

  -- Find current units and set the distance unit to metric
  !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
  call !!MdsResetPins(1,10)
  !IDType     = 'ELBOW'
  !Support    = !!MdsFT54B.Support
  !Clearance  = !!MdsOptions.Clear.val
  !Overlap    = !!MdsOptions.Overlap.val
  !Selection  = !!MdsSetSteel.Size.Selection('Rtext')
  !Datum      = !Support.Datum
  !Stru       = !Support.Stru
  !Name       = !Stru.name
  !Namn       = !Stru.namn
  !Alias      = !Support.Alias
  !Type       = 'HORI'
  !Refe       = !!CE
  !Form       = !!MdsFT54B

  !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
  !Sref = !SrefName.dbref()

  if !support.mirror then
    !DatumDir = 'pl'
  else
    !DatumDir = 'pa'
  endif

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

  -- Check that Datum atta has been created
  if (!Datum.set().not())then
    !!Alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- framework goes between datum atta and !atta
  -- copy the correct structure according to bore size
  !bore = !datum.abore
  var !strucoll /MDS/FT54B/$!SELECTION
  handle any
    !!Alert.message('/MDS/FRAMES/FT54B Does not exist - Aborting Creation')
    return
  endhandle

  if (!method.eq('CURSOR')) then
    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!Strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!Strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!Alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    -- select the elbow to connect to
    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify Elbow to Support|
    ID $!IDType @
      handle (61,528)
        PROMPT ON
        !!CE = !Stru
        !!kRestoreUnits(!currentunits)
        return
      endhandle
    PROMPT DISMISS
    PROMPT ON
    !Pick1 = !!CE

    -- create support elements
    pin 6 at p0
    pin 7 at p1
    pin 8 at p2
    pin 1 at p0 of $!datum

    -- get the direction from the datum origin to the elbow origin of pick1
    PIN 5 COPY P1 OF $!DATUM
    PIN 5 THROUGH P0 OF $!PICK1

    -- check that the elbow is orientated correctly wrt the supporting pipe, and find the direction from appropriate p point to the origin
    var !TempDir1 dir from pin 7 to pin 6
    var !TempDir2 dir from pin 8 to pin 6

    var !pldir dir pl of $!datum
    var !padir dir pa of $!datum

    if (!TempDir1 eq !pldir) or (!TempDir1 eq !padir) then
      !strudir = !TempDir1
      pin 6 dir from pin 6 to pin 7
    elseif (!TempDir2 eq !pldir) or (!TempDir2 eq !padir) then
      !strudir = !TempDir2
      pin 6 dir from pin 6 to pin 8
    else
      !!Alert.error('Supported Elbow is not aligned with the Supporting pipe - Cannot continue')
      return
    endif
    handle any
      call !!MDSResetPins(1,10)
      !!Alert.message('Atta Position is Unsuitable')
      return
    endhandle

    var !elbdist cons dist pin 6 to pin 7
    !dist = ( 2 * !elbdist.real()) / 5
    pin 6 dist $!dist

    -- Position p9 of the datum so it faces the origin of the elbow
    !!ce = !datum
    ori and p9 is up

    PIN 9 COPY P9 OF $!DATUM

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle
    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    -- Temporarily Position Structure at Datum Atta
    at p9 of $!datum
    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
    !frameformat = before(!frmw[1].name, '-FRMW')
  else
    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!Strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!Strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!Alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    if !method.eq('DIMENSION') then
      !dim1 = !!MdsFT54B.Dims[1]
      !dim2 = !!MdsFT54B.Dims[2]
      !dim3 = !!MdsFT54B.Dims[3]
    else
      !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      !Despars = !Srefname.dbref().despar
      !dim1 = !Despars[1]
      !dim2 = !Despars[2]
      !dim3 = !Despars[3]
    endif

    -- locate pin 6 using dim 1 and dim 2
    pin 5 copy p0 of $!datum
    pin 5 dir p9 of $!datum
    pin 5 dist $!dim1
    pin 6 copy pin 5
    pin 6 dir $!datumdir of $!datum
    pin 6 dist $!dim2
    pin 6 dir to pin 5
    pin 9 copy p9 of $!datum

    var !StruDir dir $!datumdir OF $!datum

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem

    handle (41,66) (2,113) (2,113)
      call !!MDSResetPins(1,10)
    endhandle

    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    -- Temporarily Position Structure at Datum Atta
    at P9 of $!datum
    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
    !frameformat = before(!frmw[1].name, '-FRMW')
  endif
  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition
  !desc = desc of /MDS/$!Alias/$!Selection
  !MdsBars = :mdsbars of /MDS/$!Alias/$!Selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!Desc'
  :mdsbars $!mdsbars

  if (!method.eq('CURSOR')) then
    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!StruDir

    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !BarDist cons dist pin 10 to pin 6

    -- find the od of the picked component
    var !tempod pl od of $!pick1
    !od = !tempod.real()
    -- adjust the centre point based upon the angle and od of the picked pipe
    !adjust = ( !od / 2 ) / sin ( !angle )
    !BDist = ( !BarDist.real() - !adjust ) / 2
    pin 10 dist $!BDist

    -- get the dim1 and dim2 values
    pin 1 copy pin 6 through p0 of $!datum

    var !dimA const dist pin 1 to p0 of $!datum
    var !dimB const dist pin 6 to pin 1
    !dim1 = !dimA.real()
    !dim2 = !dimB.real()
  else
    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!StruDir
    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)
    !od = !dim3

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !BarDist cons dist pin 10 to pin 6
    !adjust = ( !od / 2 ) / sin ( !angle )
    !BDist = ( !BarDist.real() - !adjust ) / 2
    pin 10 dist $!BDist
  endif

  move from pin 9 to pin 6 through pin 10

  -- navigate to the first angle section in the framework and extend through pin 6 at the supported elbow
  !mem1 = $!name-BAR-1
  !mem2 = $!name-BAR-2
  !!ce = !mem1
  extend end through pin 6

  -- set the joint end
  --joie PJOI 1 OF PNODE 1 of FRMWORK $!NAME/MAIN

  pin 6 dIR D WRT /*
  PIN 1 AT POSEND
  PIN 1 DIR TO POSSTART
  PIN 1 PLANE PIN 6 THROUGH pin 6
  extend end through pin 1
  var !dir pin 6 dir
  Drnend $!dir

  !!ce = !mem2
  extend end through p0 of $!datum

  -- set the joint end
  joie PJOI 1 OF PNODE 2 of FRMWORK $!NAME/MAIN

  PIN 1 AT POSEND
  PIN 1 DIR TO POSSTART
  PIN 2 copy p9 of $!datum
  PIN 1 PLANE PIN 2 THROUGH p0 of $!datum
  extend end through pin 1
  var !dir pin 2 dir
  Drnend $!dir

-------------------------------------------------------------------
---------- CODE FOR THE NEGATIVE JOINTS ---------------------------
-------------------------------------------------------------------

  VAR !DATDIR PL DIR OF $!DATUM WRT /*

  -- NAVIGATE TO PJOI 1 OF PNODE 1
  --PJOI 1 OF PNODE 1 of FRMWORK $!NAME/MAIN

  -- ORIENTATE TO THE SELECTED PIPE
  --OPDIR U WRT /*

  --VAR !Bang Bangle

  -- SET DESPARS
  --!component = !PICK1
  --!adir = !component.adir
  --!ldir = !component.ldir
  --!angle = !adir.angle(!ldir) / 2
  --!adj = !component.apos.distance(!component.pos)
  --!radius = tan( !angle ) * !adj

  --DESP $!od $!radius 90

  -- NAVIGATE TO PJOI 1 OF PNODE 2
  PJOI 1 OF PNODE 2 of FRMWORK $!NAME/MAIN

  -- ORIENTATE TO THE PL OF THE DATUM ATTA
  OPDIR $!DATDIR WRT /*

  -- SET DESPARS
  var !datod cons dist p9 of $!datum to p0 of $!datum
  !odtemp = !datod.real() + !datod.real()
  !datod = !odtemp.string()

  DESP $!datod 1000mm

  -- NAVIGATE TO PNODE 1
  --PNODE 1 of FRMWORK $!NAME/MAIN
  --AT PIN 8

  -- NAVIGATE TO PNODE 2
  PNODE 2 of FRMWORK $!NAME/MAIN
  AT P0 OF $!DATUM

  !!MdsCreateMess(false)

  -- Show dimensions on graphics if required
  if !!MdsFT54B.GraphicalDim then
    !!Mdsshowdim(!!MdsFT54B)
  endif

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- set position flag to true (the support has been positioned)
  !!MdsFT54B.Support.position = true
  !!MdsFT54B.dims[1] = !dim1
  !!MdsFT54B.dims[2] = !dim2
  !!MdsFT54B.dims[3] = !od

  call !!MDSResetPins(1,10)

-- End function
endfunction

-- End of file MdscreateFT54B.pml
