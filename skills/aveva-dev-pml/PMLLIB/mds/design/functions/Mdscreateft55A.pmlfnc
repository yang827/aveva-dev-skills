--
-- File:                Mdscreateft55A.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              Richard Martin
-- Created:             January 2006
--
--
-- Description:
-- function to create support frame type FT55A
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFT55A(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,10)
  !iDType     = 'TUBE'
  !support    = !!mdsFT55A.support
  !selection  = !!mdsSetSteel.size.selection('Rtext')
  !datum      = !support.datum
  !stru       = !support.stru
  !name       = !stru.name
  !p10Dir     = !support.p10Dir
  !p11Dir     = !support.p11Dir
  !alias      = !support.alias
  !form       = !!mdsFT55A

  -- allows us to align the frame with the outside of the atta clamp
  !!ce = !datum
  VAR !p9Dist desp[10]

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- framework goes between datum atta and !atta
  -- copy the correct structure according to bore size
  !bore = !datum.abore
  var !strucoll /MDS/FT55A/$!selection
  handle any
    !!alert.message('/MDS/FT55A Does not exist - Aborting Creation')
    return
  endhandle

  if (!method.eq('CURSOR')) then
    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    -- select the elbow to connect to
    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify Pipe to Support|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick1 = !!ce

    -- create support elements
    pin 6 copy pl
    handle (2,252)
      pin 6 at ph
      pin 6 dir hdir
    endhandle

    -- get the direction from the datum origin to the elbow origin of pick1
    PIN 5 AT P0 OF $!datum
    PIN 5 THROUGH Pl OF $!pick1
    handle (2,252)
      PIN 5 THROUGH PH OF $!pick1
    endhandle
    pin 5 dir to pin 6

    var !struDir dir from PIN 5 to pin 6

    pin 6 dir pin 5
    pin 6 at pin 5
    if !!mdsFT55A.dim1.val neq 0 then
      !dist = !!mdsFT55A.dim1.val
    else
      call !!mdsResetPins(1,10)
      !!alert.error('Dim 1 value must be entered')
      return
    endif
    pin 6 dist $!dist

    -- Position p9 of the datum so it faces the origin of the elbow
    !!ce = !datum
    ori and p9 is $!struDir

    PIN 9 COPY P9 OF $!datum
    pin 9 dist $!p9Dist

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle
    !mdstemp = /MDS/$!alias/$!selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    -- Temporarily Position Structure at Datum Atta
    at pin 9
    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
    !subs        = !!kCollectAllFor('SUBS', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')
  else
    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    if !method.eq('DIMENSION') then
      !dim1 = !!mdsFT55A.dims[1]
      !dim2 = !!mdsFT55A.dim1.val
      !dim3 = !!mdsFT55A.dims[3]
    else
      !srefName = !support.datum.name.before('/DATUM') + '/SREF'
      !despars = !srefName.dbref().despar
      !dim1 = !despars[1]
      !dim2 = !despars[2]
      !dim3 = !despars[3]
    endif

    -- locate pin 6 using dim 1 and dim 2
    pin 6 copy p0 of $!datum
    pin 6 dir u wrt /*
    pin 6 dist $!dim1
    pin 6 dir p9 of $!datum
    pin 6 dist $!dim2

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle
    !mdstemp = /MDS/$!alias/$!selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    var !struDir dir p9 of $!datum
    pin 9 copy p9 of $!datum
    pin 9 dist $!p9Dist

    -- Temporarily Position Structure at Datum Atta
    at pin 9
    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
    !subs        = !!kCollectAllFor('SUBS', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')
  endif

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition
  !desc = desc of /MDS/$!alias/$!selection
  !mdsBars = :mdsbars of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'
  :mdsbars $!mdsBars
  if (!method.eq('CURSOR')) then
    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!struDir

    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !barDist cons dist pin 10 to pin 6

    -- find the od of the picked component
    var !tempod pl od of $!pick1
    handle (2,252)
      var !tempod phod of $!pick1
    endhandle
    !od = !tempod.real()
    -- adjust the centre point based upon the angle and od of the picked pipe
    !adjust = ( !od / 2 ) / sin ( !angle )
    !bDist = ( !barDist.real() - !adjust ) / 2
    pin 10 dist $!bDist

    -- get the dim1 and dim2 values
    pin 1 copy pin 6 through p0 of $!datum

    var !dimA const dist pin 1 to p0 of $!datum
    var !dimB const dist pin 6 to pin 1
    !dim1 = !dimA.real()
    !dim2 = !dimB.real()
  else
    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!struDir
    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)
    !od = !dim3

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !barDist cons dist pin 10 to pin 6
    !adjust = ( !od / 2 ) / sin ( !angle )
    !bDist = ( !barDist.real() - !adjust ) / 2
    pin 10 dist $!bDist
  endif

  move from pin 9 to pin 6 through pin 10

  -- navigate to the first angle section in the framework and extend through pin 6 at the supported elbow
  !mem1 = $!name-BAR-1
  !mem2 = $!name-BAR-2
  !!ce = !mem1
  extend end through pin 6

  -- set the joint end
  joie PJOI 1 OF PNODE 1 of FRMWORK $!name/MAIN

  pin 6 dIR D WRT /*
  PIN 1 AT POSEND
  PIN 1 DIR TO POSSTART
  PIN 1 PLANE PIN 6 THROUGH pin 6
  extend end through pin 1
  var !dir pin 6 dir
  Drnend $!dir

  !!ce = !mem2
  --extend end through p9 of $!datum
  extend end through p0 OF $!datum

  -- set the joint end
  joie PJOI 1 OF PNODE 2 of FRMWORK $!name/MAIN

  PIN 1 AT POSEND
  PIN 1 DIR TO POSSTART
  PIN 2 copy pin 9
  PIN 1 PLANE PIN 2 THROUGH p0 of $!datum
  extend end through pin 1
  var !dir pin 2 dir
  Drnend $!dir

  -------------------------------------------------------------------
  ---------- CODE FOR THE NEGATIVE JOINTS ---------------------------
  -------------------------------------------------------------------

  VAR !oPDIR P9 DIR OF $!datum WRT /*
  VAR !dATDIR PL DIR OF $!datum WRT /*

  -- NAVIGATE TO PJOI 1 OF PNODE 1
  PJOI 1 OF PNODE 1 of FRMWORK $!name/MAIN

  -- ORIENTATE TO THE SELECTED PIPE
  OPDIR $!oPDIR WRT /*

  -- SET DESPARS
  DESP $!od 1000mm

  -- NAVIGATE TO PJOI 1 OF PNODE 2
  PJOI 1 OF PNODE 2 of FRMWORK $!name/MAIN

  -- ORIENTATE TO THE PL OF THE DATUM ATTA
  OPDIR $!dATDIR WRT /*

  -- SET DESPARS
  var !datod pl od of $!datum
  var !platethk desp[10] of $!datum
  !odtemp = !datod.real() + !platethk.real() + !platethk.real()
  !datod = !odtemp.string()
  DESP $!datod 1000mm

  -- NAVIGATE TO PNODE 1
  PNODE 1 of FRMWORK $!name/MAIN
  AT PIN 6

  -- NAVIGATE TO PNODE 2
  PNODE 2 of FRMWORK $!name/MAIN
  AT P0 OF $!datum

  !!mdsCreateMess(false)

  -- Show dimensions on graphics if required
  if !!mdsFT55A.graphicalDim then
    !!mdsshowdim(!!mdsFT55A)
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set position flag to true (the support has been positioned)
  !!mdsFT55A.support.position = true
  !!mdsFT55A.dim1.val = !dim2
  !!mdsFT55A.dims[1] = !dim1
  !!mdsFT55A.dims[2] = !dim2
  !!mdsFT55A.dims[3] = !od

  !!mdsFT55A.dim1.callback = |Call !!mdsCreateFT55A('DIMENSION')|
  !!mdsFT55A.createByDim.active = TRUE

  call !!mdsResetPins(1,10)

endfunction
