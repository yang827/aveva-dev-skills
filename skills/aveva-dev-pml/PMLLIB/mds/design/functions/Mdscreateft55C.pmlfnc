--
-- File:                MdscreateFT55C.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              I.Osborne
-- Created:             Mon Jun 23
--
--
-- Description:
-- function to create support frame type 31
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateFT55C(!Method is string)

-- Find current units and set the distance unit to metric
  !CurrentUnits = !!KGetSetUnits()

-- Initialise variables
  call !!MdsResetPins(1,10)
  !IDType     = 'TUBE'
  !Support    = !!MdsFT55C.Support
  !Clearance  = !!MdsOptions.Clear.val
  !Overlap    = !!MdsOptions.Overlap.val
  !Selection  = !!MdsSetSteel.Size.Selection('Rtext')
  !Datum      = !Support.Datum
  !Stru       = !Support.Stru
  !Name       = !Stru.name
  !Namn       = !Stru.namn
--  !P10Dir     = !Support.P10Dir
--  !P11Dir     = !Support.P11Dir
  !Alias      = !Support.Alias
  !Type       = 'HORI'
  !Refe       = !!CE
  !Form       = !!MdsFT55C

  !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
  !Sref = !SrefName.dbref()

-- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentunits)
    return
  endif

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

  -- Check that Datum atta has been created
  if (!Datum.set().not())then
    !!Alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

-- !Atta = !!ce

  -- framework goes between datum atta and !atta

  -- copy the correct structure according to bore size
  !bore = !datum.abore
  var !strucoll /MDS/FT55C/$!SELECTION
  handle any
    !!Alert.message('/MDS/FRAMES/FT55C Does not exist - Aborting Creation')
    return
  endhandle

  if (!method.eq('CURSOR')) then

    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!Strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!Strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!Alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    -- select the elbow to connect to
    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify Pipe to Support|
    ID $!IDType @
      handle (61,528)
        PROMPT ON
        !!CE = !Stru
        !!kRestoreUnits(!currentunits)
        return
      endhandle
    PROMPT DISMISS
    PROMPT ON
    !Pick1 = !!CE

    -- NEED TO MOVE THE ATTAS THROUGH THE CENTRELINE OF THE TEE, WE CAN DO THIS BY REFERENCE TO THE PICKED ELBOW
    !!CE = !DATUM
    SPKBRK FALSE
    MOVE THROUGH P0 OF $!PICK1
    MARK CE
    !!CE = !Sref
    SPKBRK FALSE
    MOVE THROUGH P0 OF $!PICK1

    -- orientate p9 orthogonally towards the pipe
    !!ce = !datum
    pin 5 copy p0 dir up
    pin 5 through pl of $!pick1
    pin 5 dir to pl of $!pick1
    var !p9dir dir pin 5
    ori and p9 is $!p9dir
    !!CE = !PICK1

    var !struDir dir p9 of $!datum

    if !!mdsft55c.dim1.val neq 0 then
      !dist = !!mdsft55c.dim1.val
    else
      call !!MdsResetPins(1,10)
      !!Alert.Error('Dim 1 value must be entered')
      return
    endif

    pin 6 copy pl
    pin 6 dir p9 of $!datum
    pin 6 at pin 5
    pin 6 dist $!dist

    -- determine which side of the atta to connect to
--    var !p10dir p10 dir of $!datum
--    var !p11dir p11 dir of $!datum

    $(
    if !StruDir eq !p10dir then
      !Ppoi = 'p10'
      !!CE = $!<Name>/SREF
      !!MdsDacControl(true)
      DESPAR n 3 10
      !!MdsDacControl(FALSE)
    elseif !StruDir eq !p11dir then
      !Ppoi = 'p11'
      !!CE = $!<Name>/SREF
      !!MdsDacControl(true)
      DESPAR n 3 11
      !!MdsDacControl(FALSE)
    else
      -- elbow not perpendicular to connected pipe
      !!alert.error('Elbow not perpendicular to connected pipe')
      return
    endif
    $)

    PIN 9 COPY P9 OF $!DATUM

    PIN 9 DIR TO P0 OF $!DATUM
    VAR !P9DIST CONST DIST PIN 9 TO P0 OF $!DATUM
    !Bdist = ( !P9DIST.real()) / 3
    PIN 9 DIST $!Bdist

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle
    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    -- Temporarily Position Structure at Datum Atta
    at PIN 9
    new frmw $!name/MAIN
    !frmwsupport = !!ce
    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
    !frameformat = before(!frmw[1].name, '-FRMW')

  else

    -- First check that both dim 1 and dim 2 are filled in otherwise return
    $(
    if !!mdsFT55C.dim1.val eq 0 then
      !!Alert.Error('Dim 1 value must be entered')
      return
    elseif !!mdsFT55C.dim2.val eq 0 then
      !!Alert.Error('Dim 2 value must be entered')
      return
    endif
    $)

    -- get the structure attachment point
    $(
    if !despars[3] eq 10 then
      !ppoidir = 'p10'
    elseif !despars[3] eq 11 then
      !ppoidir = 'p11'
    endif
    $)

    -- CHECK THAT THE BORE IS APPROPRIATE FOR THE FRAME
    if !bore.leq(!Strucoll.dbref().:mdsmaxbore.bore() ) and !bore.geq(!Strucoll.dbref().:mdsminbore.bore() ) then $* its suitable
      -- do nothing
    else
      !!Alert.message('Steelwork Size is not suitable for this pipe bore')
      return
    endif

    if !method.eq('DIMENSION') then
      !dim1 = !!MdsFT55C.Dims[1]
      !dim2 = !!MdsFT55C.Dim1.val
      !dim3 = !!MdsFT55C.Dims[3]

      --!dim1 = !!MDSFT55C.dim1.val
      --!dim2 = !!MDSFT55C.dim2.val
    else
      !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      !Despars = !Srefname.dbref().despar
      !dim1 = !Despars[1]
      !dim2 = !Despars[2]
      !dim3 = !Despars[3]
    endif

    -- locate pin 6 using dim 1 and dim 2
    pin 6 copy p0 of $!datum
    pin 6 dir u wrt /*
    pin 6 dist $!dim1
    pin 6 dir P9 OF $!DATUM
    pin 6 dist $!dim2

    -- Navigate to Stru
    !!ce = !stru
    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle
    !mdstemp = /MDS/$!Alias/$!Selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    var !StruDir dir P9 of $!datum
    pin 9 at P9 of $!datum

    PIN 9 DIR TO P0 OF $!DATUM
    VAR !P9DIST CONST DIST PIN 9 TO P0 OF $!DATUM
    !Bdist = ( !P9DIST.real()) / 3
    PIN 9 DIST $!Bdist
    -- Temporarily Position Structure at Datum Atta
    at PIN 9
    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = !strucoll.dbref()
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !Subs        = !!KCollectAllFor('SUBS', '', !!CE)
    !frameformat = before(!frmw[1].name, '-FRMW')

  endif
  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition
  !desc = desc of /MDS/$!Alias/$!Selection
  !MdsBars = :mdsbars of /MDS/$!Alias/$!Selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!Desc'
  :mdsbars $!mdsbars

  if (!method.eq('CURSOR')) then
    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!StruDir

    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !BarDist cons dist pin 10 to pin 6

    -- find the od of the picked component
    var !tempod pl od of $!pick1
    !od = !tempod.real()
    -- adjust the centre point based upon the angle and od of the picked pipe
    !adjust = ( !od / 2 ) / sin ( !angle )
    !BDist = ( !BarDist.real() - !adjust ) / 2
    pin 10 dist $!BDist

    -- get the dim1 and dim2 values
    pin 1 copy pin 6 through p0 of $!datum

    var !dimA const dist pin 1 to p0 of $!datum
    var !dimB const dist pin 6 to pin 1
    !dim1 = !dimA.real()
    !dim2 = !dimB.real()

  else

    var !dir from pin 9 to pin 6
    var !dir2 dir pin 6
    ori z is $!dir and y is $!StruDir
    !temp = !dir.direction()
    !temp2 = !dir2.direction()
    !angle = !temp.angle(!temp2)
    !od = !dim3

    -- create a pin at the midpoint between pin 9 and pin 6
    pin 10 copy pin 9
    pin 10 dir to pin 6
    var !BarDist cons dist pin 10 to pin 6
    !adjust = ( !od / 2 ) / sin ( !angle )
    !BDist = ( !BarDist.real() - !adjust ) / 2
    pin 10 dist $!BDist

  endif

  move from pin 9 to pin 6 through pin 10

  -- navigate to the first angle section in the framework and extend through pin 6 at the supported elbow
  !mem1 = $!name-BAR-1
  !mem2 = $!name-BAR-2
  !!ce = !mem1
  extend end through pin 6

  -- set the joint end
  joie PJOI 1 OF PNODE 1 of FRMWORK $!NAME/MAIN

  pin 6 dIR D WRT /*
  PIN 1 AT POSEND
  PIN 1 DIR TO POSSTART
  PIN 1 PLANE PIN 6 THROUGH pin 6
  extend end through pin 1
  var !dir pin 6 dir
  Drnend $!dir

  !!ce = !mem2
  extend end through p0 of $!datum

  -- set the joint end
  joie PJOI 1 OF PNODE 2 of FRMWORK $!NAME/MAIN

-------------------------------------------------------------------
---------- CODE FOR THE NEGATIVE JOINTS ---------------------------
-------------------------------------------------------------------

  VAR !OPDIR P9 DIR OF $!DATUM WRT /*
  VAR !DATDIR PL DIR OF $!DATUM WRT /*

  -- NAVIGATE TO PJOI 1 OF PNODE 1
  PJOI 1 OF PNODE 1 of FRMWORK $!NAME/MAIN

  -- ORIENTATE TO THE SELECTED PIPE
  OPDIR $!OPDIR WRT /*

  -- SET DESPARS
  DESP $!od 1000mm

  -- NAVIGATE TO PJOI 1 OF PNODE 2
  PJOI 1 OF PNODE 2 of FRMWORK $!NAME/MAIN

  -- ORIENTATE TO THE PL OF THE DATUM ATTA
  OPDIR $!DATDIR WRT /*

  -- SET DESPARS
  var !datod pl od of $!datum
  !odtemp = !datod.real()
  !datod = !odtemp.string()
  DESP $!datod 1000mm

  -- NAVIGATE TO PNODE 1
  PNODE 1 of FRMWORK $!NAME/MAIN
  AT PIN 6

  -- NAVIGATE TO PNODE 2
  PNODE 2 of FRMWORK $!NAME/MAIN
  AT P0 OF $!DATUM

  !!MdsCreateMess(false)

-- Show dimensions on graphics if required
  if !!MdsFT55C.GraphicalDim then
    !!Mdsshowdim(!!MdsFT55C)
  endif

-- Reset Units

  !!kRestoreUnits(!currentunits)

-- set position flag to true (the support has been positioned)
  !!MdsFT55C.Support.position = TRUE
  !!mdsft55C.dim1.val = !dim2
  !!MdsFT55C.dims[1] = !dim1
  !!MdsFT55C.dims[2] = !dim2
  !!MdsFT55C.dims[3] = !od

  !!mdsft55C.dim1.callback = |Call !!MdsCreateFT55c('DIMENSION')|
  !!mdsft55C.CreateByDim.active = TRUE

  call !!MDSResetPins(1,10)

-- End function
endfunction

-- End of file MdscreateFT55C.pml
