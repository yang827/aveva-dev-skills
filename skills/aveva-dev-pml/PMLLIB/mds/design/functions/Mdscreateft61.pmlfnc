--------------------------------------------------------------------------------
--
-- File: Mdscreateft61.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS147
--
-- Author:  Neale Morris
-- Created:  Tue 2rd April 2007
--
-- Description:
-- function to create support frame type FT61
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreateft61(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsResetPins(1,9)
  --<dw>Aug2008 Dun979 IDType expanded
  !idtype    = 'SBFI FIXING BOX SCTN PANE FLOOR GENSEC GWALL STWALL SCREED'
  !support   = !!mdsft61.support
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Update support object for P9dir/p10dir/p11dir in case it has been rotated
  !!ce = !datum
  !support.p9dir  = P9 Dir wrt world
  !support.p10dir = P10 Dir wrt world
  !support.p11dir = P11 Dir wrt world
  same

  ----------------------------- **** connexions **** -----------------------------
  !unusedrefe      = !!ce
  !form      = !!mdsft61

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = 'CURSOR'
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta and the stru
  if !support.datum.badref().not() then
    !srefname = !support.datum.name.before('/DATUM') + '/SREF'

    --<dw>May2008 Dun935 EDF request that olet should be named LUG1. Note atta also added.
    --!oletname = !support.datum.name.before('/DATUM') + '/OLET'
    !oletname = !support.datum.name.before('/DATUM') + '/LUG1'
    !commname = !support.datum.name.before('/DATUM') + '/NOTE1'

    if !!mdscomclaimdac(!support.stru,'DACMOD','POS').not() or !!mdscomclaimdac(!srefname.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefname.dbref().despar
      !!mdsresetdims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- There are no joints associated with this FRAMEwork
  !havejoints = FALSE
  !support.joints.clear()
  ---------------------------------------------------------------------------------

  -- Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- HORIZONTAL and VERTICAL PIPES + SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS
  !ddir = !support.p9dir
  var !p3p9dir const dir p3 of $!datum to p9 of $!datum
  !udir = !p3p9dir.direction()
  -------------------------------------------------
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !udir = !directions[4]
  !ddir = !directions[3]

  -- Orientate Structure of MDS Support
  if (!support.rotatecur)then
    !orix = !directions[5]
  else
    !orix = !directions[6]
  endif
  !oriz = !directions[3]

  -- Store section name and matref for each member for reseting later
  !storeMat = ARRAY()
  !storeMat = !!mdsstoremat(!name)

  -- Check the MDS Template Structure according to the ALLOWABLE Min/Max bore sizes
  !bore = !datum.abore
  !borereal = !bore.real()
  var !unusedstrucoll collect all stru for /MDS/FRAMES/FT61
  handle any
    !!alert.message('The MDS Framework Templates for the MDS support standard ''FT61'' do not exist - Aborting Creation')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  -- Generate pin positions for each creation type

  -- Select the right template for this bore
  var !coll coll all stru with ((:mdsminbore eq $!borereal) and (:mdsmaxbore eq $!borereal)) for /MDS/FRAMES/FT61
  if !coll.size().eq(0) then
    !!alert.error('Unable to find template for selected bore')
    return
  endif
  !indexpos = !coll[1].dbref().order
  !!mdssetsteel.size.val = !indexpos
  !selection = !!mdssetsteel.size.selection('Rtext')
  -- <RM> 06/07/07 added this method so that we can use the cancel function to reset the original support
  if !method.eq('DIMENSION') then
    --  Reposition datum thro identified plate
    --  The zdir od the plate should give the surface direction
    !!ce = !srefname.dbref()
    at $!datum
    --  Add marker text
    var !pos pos wrt world
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>
    var !dir dir pl of $!datum
    !!ce = !stru
    move $!dir wrt world through $!datum

    --<dw>May2008 Dun935 EDF request olet now named LUG1
    --$!<name>/OLET
    $!<name>/LUG1

    move $!dir wrt world through $!datum

    !!ce = !datum
    var !insulations insu
    !insulation = !insulations.real()

    !cutplaneref = true
    !!ce = !stru
    sctn2 of frmw1
    handle(2,113)
      !cutplaneref = false
    endhandle
    if (!cutplaneref) then
      !drns = 'drns'
      !conn = :mdsconn
    else
      !drns = 'perp'
      !conn = 'unset'
    endif
    stru
    --   Pins now in position create framework
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle

    !mdstemp = /MDS/FT61/$!selection
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

    --   Position the olet p3 position
    at p3 of $!oletname

    NEW FRMW $!name/MAIN
    !frmwsupport = !!ce

    --   Copy required template/s Framework
    !!ce = /MDS/FT61/$!selection
    !frmw = !!kcollectallfor('FRMW', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')
    !desc = desc

    --   Navigate back to support and create template elements
    !!ce = !frmwsupport
    COPY ATTRIB OF $!frmw[1]
    COPY MEM OF $!frmw[1] RENAME $!frameformat $!name

    !frmw = !!kcollectallfor('FRMW', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')

    --   Navigate back to support
    !!ce = !stru

    --   Set stru description for template recognition
    desc '$!desc'

    --   Extend section to plate
    --   There are a set of rules to adhere to.
    --   Up to 40mm bore and cl of pipe to civil less than a distance
    --   This will be stored on desp[4] of the V1 section

    --   In addition the support has a min and max value for the overall height from the square plate to the supporting plate this these are stored in:-
    --   min - desp[5] of the template v1 section
    --   max - desp[6] of the template v1 section

    --   In addition the support has a min and max value for the overall height from the pipe centreline to the supporting plate this these are stored in:-
    --   min - desp[7] of the template v1 section
    --   max - desp[8] of the template v1 section

    --   the constructed heights will be checked against the template values as part of the integrity check during the apply method of the mdsft61 form
    sctn 1 of frmw 1 of $!stru

    if !bore.lt(50) then

      !desp = desp
      if (defined(!desp[4])) then
        !maxlengthv1 = !!ce.length
      endif

      pin 8 at $!datum
      pin 9 copy p3 of $!datum
      pin 9 dist $!!mdsft61.dim1.val
      var !dist const dist pin 9 to pin 8
      if !dist.real().leq(!maxlengthv1) then
        $!name-V2
        delete sctn
        $!name-PNOD1
        delete pnod
        $!name-V1
        !washere = !!ce.poss
        extend start to pin 9
      else
        if !insulation.gt(0) then
          $!name-V2
          extend start to pin 9
          drns $!drns
          :mdsconn $!conn
        else
          $!name-V1
          delete sctn
          $!name-PNOD1
          npos n0
          $!name-V2
          name $!name-V1
          extend end inf $!name-PJOI1
          extend start to pin 9
        endif
      endif
    elseif !bore.lt(800) then
      pin 8 at $!datum
      pin 9 copy p3 of $!datum
      pin 9 dist $!!mdsft61.dim1.val
      var !dist const dist pin 9 to pin 8
      $!name-V1
      delete sctn
      $!name-PNOD1
      npos n0
      $!name-V2
      name $!name-V1
      extend end inf $!name-PJOI1
      extend start to pin 9
    endif

    var !dim1 const dist pin 9 to p3 of $!datum
    !!mdsft61.dim1.val = !dim1.real()
    !!mdsResetPins(1,9)

    !!ce = $!<name>/SREF
    !!mdsDacControl(true)
    DESPAR $!!mdsft61.dim1.val
    !!mdsDacControl(false)
    return
  else

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify plate to support from|
    ID $!idtype @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle

    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !type = !pick.type
    !support.connections[1] = !pick

    --<dw>Aug2008 Dun979 - Start check Zdir from expanded list of types
    if (!type inset('PANE','FLOOR','GENSEC','GWALL','STWALL','SCREED')) then
      !typori = ORIENTATION
      !zopp   = !typori.zdir()
      !zdir   = !zopp.opposite()
    elseif (!type eq 'SCTN') then
      !gtype = gtype
      if (!gtype eq 'BEAM') then
        var !plindir ppline tos dir
      elseif (!gtype inset('BSC','PFC','CHAN')) then
        var !plindir ppline toc dir
      endif
      !zdir = !plindir.direction()
    else
      !zdir = !pick.zdir.wrt(/* )
    endif
    --<dw>Aug2008 Dun979 - End check Zdir

    -- <dw>Aug2008 Dun979 - Start supress RelToDatum 'EQUAL' + 'ABOVE' test to allow support to be attached at any angle
    !supatbase = true
    !testce = !!mdsreltodatum(!datum, !pick, !ddir, 0)
    if (!testce[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      return
    elseif (!testce[1].upcase() eq '')then
      !!alert.error('Identified element is unsuitable to support from.')
      return
    elseif (!testce[1].upcase() eq 'EQUAL')then
      !supatbase = false
    elseif (!testce[1].upcase() eq 'ABOVE')then
      !supatbase = false
    endif
    --<dw>Aug2008 Dun979 End of supress RelToDatum test

    !!mdsCreateMess(true)

    -- Reposition datum thro identifed plate
    -- The zdir of the plate should give the surface direction

    !!ce = !datum
    var !insulations insu
    !insulation = !insulations.real()

    !incline = pl dir wrt world
    handle any
      !incline = ph dir wrt world
    endhandle

    --<dw>Aug2008 Dun979 - Align inclined support with sbfi where gradient > 6deg for base attachment
    -- or at any angle if not a base attachment.

    !inclpt = !incline.string().before('WRT').split()
    if (!inclpt.size() eq 3 and !incline.string().match('D') eq 0 or !inclpt.size() eq 3 and !incline.string().match('-Z') eq 0) then
      !supatbase = false
    elseif (!inclpt.size() gt 3) then
      !supatbase = false
    endif

    if (!!mdsgradient(!!ce) and !type eq 'SBFI' or !supatbase eq false and !type eq 'SBFI') then
      plane pl thro $!pick
    endif
    --<dw>Aug2008 Dun979 - End align inclined support.

    !!ce = !srefname.dbref()
    at $!datum
    -- Add marker text
    var !pos pos wrt world
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    -- Create the olet/tee

    !!ce = !oletname.dbref()
    handle ANY
      new olet $!oletname choose with styp 'LUP'
      handle ANY
        delete olet
        !!ce = !srefname.dbref()
        new tee $!oletname choose with styp 'ST'
      endhandle
      pos p0 at prev

      --<dw>Aug2008 Dun979 Start account for expanded list of types
      if (!type inset('PANE','FLOOR','GENSEC','GWALL','STWALL','SCREED')) then
        ori and p3 is $!zopp
      else
        ori and p3 is tow $!pick
      endif
      --<dw>Aug2008 Dun979 End account for expanded list of types
    elsehandle NONE

      pos p0 at prev
      --<dw>Aug2008 Dun979 Start account for expanded list of types
      if (!type inset('PANE','FLOOR','GENSEC','GWALL','STWALL','SCREED')) then
        ori and p3 is $!zopp
      else
        ori and p3 is tow $!pick
      endif
      --<dw>Aug2008 Dun979 End account for expanded list of types

    endhandle

    -- Orientate all in same direction
    !!ce = !datum
    ori and p3 is p3 of same
    !!ce = !srefname.dbref()
    ori and p3 is p3 of same
    !!ce = !commname.dbref()
    pos pa at pl of prev
    ori and p3 is p3 of same
    !!ce = !oletname.dbref()

    !!ce = !stru
  endif
  -- Orientate the stru

  --<wd>jun2007<mds12>
  -- Save !pick for Association
  !mdsassoc.pick1 = !pick
  --<wd>jun2007<mds12>

  -- Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- HORIZONTAL and VERTICAL PIPES + SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS
  !ddir = !support.p9dir
  var !p3p9dir const dir p3 of $!datum to p9 of $!datum
  !udir = !p3p9dir.direction()
  -------------------------------------------------
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !udir = !directions[4]
  !ddir = !directions[3]

  -- Orientate Structure of MDS Support
  if (!support.rotatecur)then
    !orix = !directions[5]
  else
    !orix = !directions[6]
  endif
  -- !oriz = !directions[3]
  !oriz = !directions[4]

  ori x is $!orix and z is $!oriz

  -- Pins now in position create framework
  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/FT61/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  -- Position the olet p3 position
  at p3 of $!oletname

  NEW FRMW $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s Framework
  !!ce = /MDS/FT61/$!selection
  !frmw = !!kcollectallfor('FRMW', '', !!ce)
  !frameformat = before(!frmw[1].name, '-FRMW')
  !desc = desc
  !unusedmdsBars = :MdsBars

  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameformat $!name

  !frmw = !!kcollectallfor('FRMW', '', !!ce)
  !frameformat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support
  !!ce = !stru

  -- Set stru description for template recognition
  desc '$!desc'

  -- Extend section to plate
  -- There are a set of rules to adhere to.
  -- Up to 40mm bore and cl of pipe to civil less than a distance
  -- This will be stored on desp[4] of the V1 section

  -- In addition the support has a min and max value for the overall height from the square plate to the supporting plate this these are stored in:-
  -- min - desp[5] of the template v1 section
  -- max - desp[6] of the template v1 section

  -- In addition the support has a min and max value for the overall height from the pipe centreline to the supporting plate this these are stored in:-
  -- min - desp[7] of the template v1 section
  -- max - desp[8] of the template v1 section

  -- the constructed heights will be checked against the template values as part of the integrity check during the apply method of the mdsft61 form
  sctn 1 of frmw 1 of $!stru

  if !bore.lt(50) then

    !desp = desp
    if (defined(!desp[4])) then
      !maxlengthv1 = !!ce.length
    endif

    pin 9 at $!oletname
    !ozdir = !zdir.opposite()
    --<dw>Aug2008 Dun979 - To improve interface positioning (+ extend start thr pin 9)
    pin 9 direction $!ddir

    pin 8 copy pin 9
    pin 9 plane pin 9 clear 0 inf $!pick
    pin 9 direction $!ozdir
    pin 9 plane $!ozdir clear 0 inf $!pick
    var !dist const dist pin 9 to pin 8
    if !dist.real().leq(!maxlengthv1) then
      $!name-V2
      delete sctn
      $!name-PNOD1
      delete pnod
      $!name-V1
      !washere = !!ce.poss
      extend start beh $!pick
    else
      if !insulation.gt(0) then
        $!name-V2
        -- extend start beh $!pick
        extend start thr pin 9
        drns $!zdir
      else
        $!name-V1
        delete sctn
        $!name-PNOD1
        npos n0
        $!name-V2
        name $!name-V1
        extend end inf $!name-PJOI1
        -- extend start  beh $!pick
        extend start thr pin 9
        drns $!zdir
      endif
    endif
  elseif !bore.lt(800) then
    pin 9 at $!oletname
    !ozdir = !zdir.opposite()

    --<dw>Aug2008 Dun979 - To improve interface positioning (+ extend start thr pin 9)
    pin 9 direction $!ddir

    pin 8 copy pin 9
    pin 9 plane pin 9 clear 0 inf $!pick
    pin 9 direction $!ozdir
    pin 9 plane $!ozdir clear 0 inf $!pick
    var !dist const dist pin 9 to pin 8
    $!name-V1
    delete sctn
    $!name-PNOD1
    npos n0
    $!name-V2
    name $!name-V1
    extend end inf $!name-PJOI1
    -- extend start beh $!pick
    extend start thr pin 9
  endif

  -- <RM> 06/07/07 -- save dim 1 which is the height from the supporting plate to p3 of the datum atta
  var !dim1 const dist pin 9 to p3 of $!datum
  !!mdsft61.dim1.val = !dim1.real()

  !!mdsResetPins(1,9)

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick -- or -- <b> CLEARANCE mode !pick
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  !!mdsCreateMess(FALSE)
  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  ------------------****** connexions *******----------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default

  else
    !vertical1 = !!ce
    !connected = !!mdsgetbeamconn(!support,!vertical1)
    :MDSConn $!connected
    handle any
    endhandle
  endif
  --------------------*******************--------------------------

  !!ce = $!<name>-V1
  -- Set atta references
  :MDSAttaRef $!<name>/DATUM
  !support.barLen[1] = deri length of CE

  !!ce = !stru
  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  DESPAR $!!mdsft61.dim1.val
  !!mdsDacControl(false)

  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  !!ce = !stru
  ----------------------***** connexions *****--------------------------
  if(!havejoints) then
    do !index indices !joints
      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummD   = object DBREF()
        !dummA   = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummD,!dummA)
      endif
    enddo
  endif
  ----------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  -- Update support data held in form
  !!mdsft61.support = !support

  !!mdsCreateMess(false)

  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  DESPAR $!!mdsft61.dim1.val
  !!mdsDacControl(false)

  -- Show dimensions on graphics if required
  if !!mdsft61.graphicalDim then
    !!mdsshowdim(!!mdsft61)
  endif

  !!ce = !support.stru
  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
