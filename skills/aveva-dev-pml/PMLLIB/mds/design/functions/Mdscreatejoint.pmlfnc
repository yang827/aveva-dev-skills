--
-- File:  Mdscreatejoint.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Andrew Kirkland
-- Created:   Thu 11th June 1998
--
--
-- Description:
-- Function to create snode and joint betwix to sctns
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Sctn to connect to]
--     2     R        DBREF        [Support vertical to connect]
--     3     R        DBREF        [Existing joint to regenerate]
--     4     R        ARRAY        [Stored attributes of existing joint]
-- Return:
--    [Data Type]   [Description]
--     DBREF        [ Joint Created ]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateJoint(!mainStl is DBREF, !upright is DBREF, !existingJoint is DBREF, !attributes is ARRAY) is DBREF

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  !refe          = !!ce
  !!ce           = !mainStl
  !nameOfUpright = !upright.name

  -- Find out type of MDS Framework
  -- Set up the MDS Framework Support Object
  !supptype   = !upright.owner.owner.:MDSSuppType

  -- Incase the support being created has an alias get the alias name

  !supptype = !!mdsaliaslist(!supptype)

  !supptxt    = '!!mds' & !supptype &'.support'
  !support    = $!supptxt

  -- in order to name the joint (looks better in the form option gadget)
  if (!supptype.neq('FT28')) then
    if(!nameOfUpright.match('V1').neq(0) ) then
      !numb = 1
    elseif(!nameOfUpright.match('V2').neq(0)) then
      !numb = 2
    else
      !numb = 1
    endif
  endif

  -- Get the Correct Number for the Joint being Created for FT15 and FT28
  if (!supptype.eq('FT15') and !support.config.neq(4)) then
    var !jexist exists $!nameOfUpright/J$!numb
    if (!jexist.eq('TRUEA')) then
      !numb = 2
    endif

  elseif (!supptype.eq('FT28')) then
    if (!nameOfUpright.match('-V1').gt(0)) then
      !numb = 1
      !whichEnd = 'START'
      var !jexist exists $!nameOfUpright/J$!numb
      if (!jexist.eq('TRUEA')) then
        !numb = 3
        !whichEnd = 'END'
      endif

    elseif (!nameOfUpright.match('-V2').gt(0)) then
      !numb = 2
      !whichEnd = 'START'
      var !jexist exists $!nameOfUpright/J$!numb
      if (!jexist.eq('TRUEA')) then
        !numb = 4
        !whichEnd = 'END'
      endif
    endif

  endif

  -- Calculate Joint position
  !snodePos = !!mdsPosInterSctn(!mainStl,!upright)

  !!mdsDacControl(TRUE)


  -- Create Snode
  if(!existingJoint.unset()) then

    --NEW SNODE ZDIST THRO $!snodePos
    NEW SNODE ZDIST THRO $!snodePos wrt /*
    --pin 10 at $!snodePos
    NEW SJOINT

    name $!nameOfUpright/J$!numb
    handle ANY
      !newJoint = !!ce
      -- for now just go to it and use it.
      $!nameOfUpright/J$!numb
      -- get details of old joint
      --!posl = posl
      -- best as a string
      var !desp Desp
      !bang  = Bang
      !spre  = spref
      !jlin  = Jline
      if(!jlin.eq('')) then
        !jlin = 'unset'
      endif
      !cutp = cutp
      !cutb  = cutb
      --- end details of old joint
      snode
      delete snod
      -------------------------------------------------------remove when graphics works----------------
      !newString = !!mdsRedraw(!!ce)
      $!newString
      -------------------------------------------------------------------------------------------------
      --!sctn = !!ce.owner.owner
      --!!mdstidynodes(!sctn,'NOERROR')
      !!ce = !newJoint
      name $!nameOfUpright/J$!numb
      handle ANY
        $!nameOfUpright/J$!numb
        unname
        !!ce = !newJoint
      endhandle
      -- reset attributes to old details
      -- POSL $!posl  -- done by calcs

      DESP $!desp
      BANG $!bang
      SPRE $!spre
      JLIN $!jlin
      CUTP $!cutp
      CUTB $!cutb
    endhandle

    !joint = !!ce
    -- CREF $!upright (set by setting the jois/joie of connecting sctn)

    -----------------------------------------------------------------------------
    -- Set the Joint to the Correct End of the Vertical SCTNs for FT28
    if (!supptype.eq('FT28')) then
      -- set Sctn joie/jois to joint
      !!ce = !upright
      if(!whichEnd.eq('START')) then
        JOIS $!joint
        !position = POSS wrt worl
      elseif (!whichEnd.eq('END'))then
        JOIE $!joint
        !position = POSE wrt worl
      endif

    else

      -- Get nearest end
      !whichEnd = !!mdsNearestEnd(!joint, !upright)
      -- set Sctn joie/jois to joint
      !!ce = !upright
      if(!whichEnd.eq('START')) then
        JOIS $!joint
        !position = POSS wrt worl
      else
        JOIE $!joint
        !position = POSE wrt worl
      endif
    endif
    -----------------------------------------------------------------------------

    -- Get nearest pline to connected sctn
    !!ce = !joint


    -- Find Nearest Pline to Sctn end/start (whichever appl) :Note arg 3 set to MID will use the centre of the attached sctn and not the NA
    !pline = !!mdsNearestPline(!joint,!position,'MID')

    POSL $!pline
    var !plindir ppline $!pline of sctn dir wrt worl
    CUTP $!plindir wrt worl

  else

    -- regenerate using existing joint
    !!ce = !existingJoint.owner
    ZDIST THRO $!snodePos
    !!ce = !existingJoint
    !joint = !!ce
    POSL  $!attributes[1]
    DESP  $!attributes[2]
    BANG  $!attributes[3]
    SPREF $!attributes[4]
    JLINE $!attributes[5]
    handle ANY
      -- errors if var jlin is unset
    endhandle
    CUTP  $!attributes[6]
    CUTB  $!attributes[7]

    !!ce = !joint

    $!attributes[8]
    JOIE $!attributes[9]
    handle ANY
      -- in case joints are in support
    endhandle
    JOIS $!attributes[10]
    handle ANY
      -- in case joints are in support
    endhandle
  endif

  !!mdsDacControl(FALSE)

  RECONN RECALC

  handle ANY
    -- incase the pline calculated gives an error
  endhandle

  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  !!ce = !refe

  -- Return DBref of joint created
  return !joint

endfunction
