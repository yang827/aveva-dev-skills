--
--
-- Description:
-- Function to display or remove a create message to the user
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        BOOLEAN      Display or remove the message
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreateMess(!DoWhat is BOOLEAN)

  if (!DoWhat) then
    prompt off
    prompt |Please Wait... Generating Support.|
  else
    prompt dismiss
    prompt on
  endif

-- End function
endfunction

-- End of file Mdscreatemess.pml
