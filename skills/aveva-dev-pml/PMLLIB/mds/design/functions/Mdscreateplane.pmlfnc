--
-- File:		Mdscreateplane.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPLANE
--
-- Author:		I.Osborne
-- Created:		Tue May 27
--
--
-- Description:
-- Function to get syntax for creating a plane
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form to store plane information
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsCreatePlane(!Form is FORM)

  -- Initialise variables
    var !Mode MODE
    !Selection = !!MdsThroPlane.Select.selection('RTEXT')
    !Direction = !!MdsThroPlane.Plan.Val

    if (!Selection eq |NAME| and |$_CDNNAME_NAME| eq |unset|) then
      -- Name Option must have a valid name
      !!Alert.warning('Name left unset.')
      return
    elseif (!Selection eq |NAME|) then
      !Nameoref = substring(|$_CDNNAME_NAME|,1,1)
      if (!Nameoref eq |=| or !Nameoref eq |/|) then
        -- move wrt dbref
        !Form.P.val = |$!Direction THRO $_CDNNAME_NAME|
--        PLANE $_PLAN THRO $_CDNNAME_NAME
      else
        -- move wrt name
        !Form.P.val = |$!Direction THRO /$_CDNNAME_NAME|
--        PLANE $_PLAN THRO /$_CDNNAME_NAME
      endif
    elseif (!Selection eq |COORD|) then
      -- move through coord
      if ($_CDCOORD_WRTZ)then
        !Wrt = 'WRT ZONE'
      elseif ($_CDCOORD_WRTS)then
        !Wrt = 'WRT SITE'
      else
        !Wrt = 'WRT /*'
      endif
      !Form.P.val = |$!Direction THRO $_CDCOORD_DIR $_CDCOORD_DIST $!Wrt|
--      PLANE $_PLAN THRO $_CDCOORD_DIR $_CDCOORD_DIST
    elseif (!Selection eq |PIN|) then
      -- move wrt to a pin
      !Form.P.val = |$!Direction THRO PIN $_CDEPIN_PIN|
--      PLANE $_PLAN THRO PIN $_CDEPIN_PIN
    elseif (!Selection eq |CUR|) then
      -- move wrt cursor
      !Form.P.val = |$!Direction THRO CURSOR|
--      PLANE $_PLAN THRO @
--   HANDLE (61,528)
--      RETURN
--   ENDHANDLE
    elseif (!Selection eq |IDCUR|) then
      -- move wrt ID cursor
      ID@
      !Element = !!CE
      same
      !Form.P.val = |$!Direction THRO $!Element|
--      PLANE $_PLAN THRO ID@
--   HANDLE (61,528)
--      RETURN
--   ENDHANDLE
    elseif (!Selection eq |IDP|) then
      -- move wrt point
      var !Point IDP@
      !Split = split(!Point)
      !Form.P.val = |$!Direction THRO ppoint $!Split[2] of $!Split[3]|
--      PLANE $_PLAN THRO IDP@
--   HANDLE (61,528)
--      RETURN
--   ENDHANDLE
    elseif (!Selection eq |NEXT|) then
      -- move wrt point
      !Form.P.val = |$!Direction THRO NEXT|
--      PLANE $_PLAN THRO NEXT
--   HANDLE (41,66) (2,113)
--      IF (|$!MODE| EQ |Forwards|) THEN
--         PLANE $_PLAN THRO PT
--      ELSE
--         PLANE $_PLAN THRO PH
--      ENDIF
--   ENDHANDLE
    elseif (!Selection eq |TAIL|) then
      -- move wrt point
      !Form.P.val = |$!Direction THRO PT|
--      PLANE $_PLAN THRO PT
    elseif (!Selection eq |PREV|) then
      -- move wrt point
      !Form.P.val = |$!Direction THRO PREV|
--      PLANE $_PLAN THRO PREV
--   HANDLE (41,66) (2,113)
--      IF (|$!MODE| EQ |Forwards|) THEN
--         PLANE $_PLAN THRO PH
--      ELSE
--         PLANE $_PLAN THRO PT
--      ENDIF
--   ENDHANDLE
    elseif (!Selection eq |HEAD|) then
      -- move wrt point
      !Form.P.val = |$!Direction THRO PH|
--      PLANE $_PLAN THRO PH
    elseif (!Selection eq |CE|) then
      -- move wrt current element
      !Form.P.val = |$!Direction THRO CE|
--      PLANE $_PLAN THRO CE
    endif

    AXES DELETE

-- End function
endfunction

-- End of file Mdscreateplane.pml
