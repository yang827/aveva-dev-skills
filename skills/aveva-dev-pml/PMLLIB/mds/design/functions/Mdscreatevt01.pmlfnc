--
--------------------------------------------------------------------------------
--
-- File:                Mdscreatevt01.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MVS101
--
-- Author:              Wayne Dodwell
-- Created:             Tuesday 16th December 1997
--
--
-- Description:
-- function to create Vessel support frame type 'VT01'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscreatevt01(!method is string)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

-- Initialise variables
    call !!mdsresetpins(1,10)
    !form      = !!mdsvt01
    !idtype    = 'CYLI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL'
    !support   = !!mdsvt01.support
    !clearance = !!mdsoptions.clear.val
    !overlap   = !!mdsoptions.overlap.val
    !selection = !!mdssetsteel.size.selection('rtext')
    !datum     = !support.datum
    !stru      = !support.stru
    !name      = !stru.name
    !p9dir     = !support.p9dir
    !p10dir    = !support.p10dir
    !p11dir    = !support.p11dir
    !pldir     = !support.pldir
    !padir     = !support.padir
    !datumname = !name & '/' & 'DATUM'
    !srefname  = !name & '/' & 'SREF'
    !unlocked  = array()
    !resetlock = FALSE

--------------------------------------------------------------------------------
-- Check that Datum atta has been created
    if (!datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Can we write to the spref attribute of the SREF atta and the STRU
  if !support.datum.badref().not() then
    !srefname = !support.datum.name.before('/DATUM') + '/SREF'
      if !!mdscomclaimdac(!support.stru,'DACMOD','POS').not() or !!mdscomclaimdac(!srefname.dbref(),'DACMOD','SPREF').not() then
        !despars = !srefname.dbref().despar
        !!mdsresetdims(!form,!despars)
        !!kRestoreUnits(!currentunits)
        !!alert.error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

-- Check that Datum atta has been positioned
    if (!support.position.not())then
      !!alert.message('Position Datum Atta before Identifying Dummy Legs')
      !!kRestoreUnits(!currentunits)
        return
    endif

$(
-- Check which attas to work from
    !atta = !support.bars[1]
$)

--------------------------------------------------------------------------------
-- Set orientation - 'VT01' is  Only Allowed on Vertical Pipes
    !ddir = D wrt world
    !udir = U wrt world

-- Get original ORI for Datum Atta
    !!ce       = !datum
    !oridatum  = ori wrt /*

--------------------------------------------------------------------------------
-- Identify the TWO Trunnion Branches to be Supported - These MUST be type TT17
-- and belong to the Same Branch as the previously created DATUM ATTA

-- Use the Support object ARRAY member .packs to store the Identified Trunnion Dummy Leg Branches 1 & 2
    !form.support.packs.clear()

-- Delete Trunnion SREF Attas from !support.atta array
    !removetrun = ARRAY()
    do !ind indices !support.atta
      if (!support.atta[!ind].:mdssupptype.eq('TT17')) then
        !removetrun.append(!ind)
      endif
    enddo
    do !num values !removetrun
      !support.atta.deletefrom(!num,1)
    enddo

-- Delete Vt01 SREF Attas from !support.bars array
    !support.bars = !support.atta
    !removesref = ARRAY()
    do !indz indices !support.bars
      if (!support.bars[!indz].name.eq(!srefname)) then
        !removesref.append(!indz)
      endif
    enddo
    do !numz values !removesref
      !support.bars.remove(!numz)
    enddo

-- Reset Support object members
    !form.support.atta = !support.atta
    !form.support.bars = !support.bars

-- Identify dummy legs/TT17-trunnion branches ONLY

    !dummyleg  = ARRAY()
    !dummysref = ARRAY()
    do !indx from 1 to 2
      label /ATTA
      prompt off
      prompt load escape |Identify Dummy Leg No. $!indx|
      id bran @
      handle (61,528)
        prompt on
        !form.support.packs.clear()
        !!kRestoreUnits(!currentunits)
        return
      endhandle
      prompt dismiss
      prompt on
-- Set Identified Branch to !idbran
      !idbran = !!ce

-- Is it a dummy branch
      branch
      !bran = !!ce
      if !!ce.:mdstrun.not() then
        !!alert.error('Identified branch is not a dummy leg')
        golabel /ATTA
        --return
      endif

-- Find the support name of the dummy leg branch no.$!indx and access the SREF Atta
      !suppnameofbranch = !!mdsgetsuppname(!!ce)
      !!ce = $!suppnameofbranch/SREF
      !trunsref = !!ce
      !styp = !!ce.styp
      if !styp.match('TT17').eq(0) then

--<wd>jan2007<mds12>
--        !!alert.error('Incorrect type of Dummy Leg identified for Dummy Leg No. $!indx - It must be of the type $!!codett17')
-- Get the Client CODE of the MDS TRUNNION TYPE
        !truntype = !!mdsgetdefprop('TRUNNION', 'TT17', 'CCOD')
        !!alert.error('Incorrect type of Dummy Leg identified for Dummy Leg No. $!indx - It must be of the type $!truntype')
--<wd>jan2007<mds12>

        golabel /ATTA
        --return
      endif

-- Check if the identified dummy leg branch no. $!indx is on the same branch as the VT01 Datum Atta
     !!ce = !idbran
     if !!ce.lock then
       unlock all
       !resetlock = true
       !unlocked.append(!!ce)
     endif
     !datumbranch = !datum.owner.owner
     !idbranch = !!ce.owner
     if !datumbranch.neq(!idbranch) then
       !!alert.error('The identified element is not in the same pipe as the datum atta.')
       golabel /ATTA
       --return
     endif

-- Check the SECOND Identified Dummy Leg is NOT the Same as No. 1
     !!ce = !bran
     if (!indx.eq(2)) then
       if (!dummyleg[1].eq(!!ce)) then
         !!alert.error('Identified Dummy Leg No.$!indx is the same as Dummy Leg No.1 - This is NOT allowed - Please identify another Trunnion/Dummy Leg.')
         golabel /ATTA
       endif
-- Ensure the Dummy Legs 1 & 2 are the same Pipe ODia.
       if (!dummysref[1].abor.real().neq(!trunsref.abor.real())) then
         !!alert.error('Identified Dummy Leg No.$!indx MUST be the same BORE size as Dummy Leg No.1 - Please identify another Trunnion/Dummy Leg.')
         golabel /ATTA
       endif
     endif

-- Populate the Array and Support Object Members
     !dummyleg[!indx]  = !!ce
     !dummysref[!indx] = !trunsref

-- Store the Identified Trunnion Dummy Leg SREF Attas in the Forms Support object member .atta
     !form.support.packs[!indx] = !!ce
     !form.support.bars.append(!trunsref)
     !form.support.atta.append(!trunsref)

   enddo

----------------------------------------------------------------------
-- Reset !support to the Form Support Object
   !support = !form.support

--------------------------------------------------------------------------------
-- Determine HALF the Trunnion SREF Atta Pipe Odia
   !htrunodia = !trunsref.aod / 2

--------------------------------------------------------------------------------
-- Half Width of Framework - Using Pipe O/Dia(half), Insulation Thickness,
--                           Width of Top Cross Bars and Clearance set in '.Dim2' gadget of form
    !!ce = !datum
    var !insu insulation
    !pipodia   = !datum.aod
    !pipclear  = !!Mdsvt01.dim2.val

-- Navigate to Template  Member '*-BAR-1'
-- Determine the Main Channel Cross Bar Depth
    !!ce = /MDS/$!<support.type>/$!<selection>-BAR-1
    pin 1 at stru
    pin 2 copy pin 1
    pin 2 dir n wrt /*
    pin 2 plane pin 2 clear 0 beh ce

    !widt = !!kstrreal('cons dist pin 1 to plane pin 2')
-- Half Width of Vessel Framework Structure
    !calcwidth = !insu.real() + !pipodia / 2  + !pipclear + !widt.real()
    !halfwidth = !calcwidth.nint()
-- Minimum Distance Required Between Pipe and Identified Element
    !calcdist = !insu.real() + !pipodia / 2  + !pipclear
    !mindist  = !calcdist.nint() + 1

-- Store section name and matref for each member
-- for reseting later
    !storemat = array()
    !storemat = !!mdsstoremat(!name)

--------------------------------------------------------------------------------
-- Generate pin positions for each creation type
--------------------------------------------------------------------------------
    if (!method eq |CURSOR|) then
-- Create Framework by Cursor
--------------------------------------------------------------------------------

-- Identify the Higher Element First and Check if Framework Cross Bars and Lower
-- Bracings will Fit and/or Intersect Higher Element with the correct Clearance

    label /Element1

      !!ce = !datum
      ori $!oridatum
      prompt off
      prompt load escape |Identify element to support from|
      id $!idtype @
        handle (61,528)
          prompt on
          !!ce = !datum
          ori $!oridatum
          !!ce = !stru
          !!kRestoreUnits(!currentunits)
        return
        endhandle
      prompt dismiss
      prompt on

      !pick1 = !!ce
      !picknum = 'FIRST'

--------------------------------------------------------------------------------------
-- Orientate Trunnion Dummy Legs relative to the Identified Element Type
-- For Cylinders - Trunnions must be 'Tangential' to the Identified Cylinder
--------------------------------------------------------------------------------------
      if (!pick1.type.string().eq('CYLI')) then
        !cyldir = p0 dir of $!pick1 wrt /*
--------------------------------------------------------------------------------------
        if (!cyldir eq U or !cyldir eq D) then
          pin 1 copy p1 of $!datum
          pin 2 copy p2 of $!datum
          pin 2 plane pin 2 thro p0 of $!pick1
          pin 2 dir to p0 of $!pick1
          pin 10 copy pin 2
          pin 10 plane pin 10 thro p0 of $!pick1
          pin 10 dir to pin 2
          pin 9 copy pin 10
          pin 9 plane pin 9 clear 0 beh $!pick1
          pin 8 copy pin 9
          pin 8 dir $!ddir
          pin 7 copy pin 8
          pin 7 dir $!ddir
          pin 8 plane pin 8 clear 0 inf $!pick1
          pin 7 plane pin 7 clear 0 beh $!pick1
          var !pin2dir pin 2 dir wrt /*
          !pin2pin9dist  = !!kstrreal('const dist pin 2 to plane pin 9')
          !pin9pin10dist = !!kstrreal('const dist pin 9 to plane pin 10')

--------------------------------------------------------------------------------------------
-- Orientate Atta and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Cylinder
          !!ce = !datum
          ori and p10 is $!pin2dir wrt /*
          !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
          !support.p10dir = p10 dir of $!datum wrt /*
          !p10dir         = !support.p10dir
          !support.p11dir = p11 dir of $!datum wrt /*
          !p11dir         = !support.p11dir

        else

          !!alert.error('If this framework type is to be attached to a Vessel it may only be supported from a VERTICAL Vessel')
          golabel /Element1
       endif

--------------------------------------------------------------------------------------

      else
-- For Panels  - Trunnions must be 'Parallel' to the Identified Element
-------------------------------------------------------------------------------------------
-- Element Types 'SCTN' and 'BOX' have been EXCLUDED for this Type of Support - wd/nm - jan1998
--------------------------------------------------------------------------------------
        if (!pick1.hardtype.string().eq('PANE')) then
          !panlori  = ori of $!pick1 wrt /*
          !panlxdir = !panlori.xdir()
          !panlydir = !panlori.ydir()
          !panlzdir = !panlori.zdir()

-- Check if Panel is Vertical ie. Wall
--------------------------------------------------------------------------------------
          if (!panlydir.up.abs() eq 1 or !panlxdir.up.abs() eq 1) then
            pin 1 at $!pick1
            pin 1 dir $!panlzdir
            pin 2 copy pin 1
            pin 2 at $!datum
            pin 10 copy pin 2
            pin 10 plane pin 10 thro pin 1
            pin 2 dir to pin 10
            var !pin2dir pin 2 dir wrt /*
            pin 9 copy pin 2
            pin 9 plane pin 9 clear 0 inf $!pick1
            !pin2pin9dist = !!kstrreal('const dist pin 2 to plane pin 9')

-- Position Pins 5 and 6 on the Vertical Edges of the Panel
-- Position Pin 7 at Bottom of Panel
-- Position Pin 8 at Top of Panel
--------------------------------------------------------------------------------------
            if (!panlydir.up eq 1) then
-- Ydir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlydir.up eq -1) then
-- Ydir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            elseif (!panlxdir.up eq 1) then
-- Xdir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlxdir.up eq -1) then
-- Xdir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            endif

-- Orientate Atta and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Vertical Panel
            !!ce = !datum
            ori and p10 is $!pin2dir wrt /*
            !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
            !support.p10dir = p10 dir of $!datum wrt /*
            !p10dir         = !support.p10dir
            !support.p11dir = p11 dir of $!datum wrt /*
            !p11dir         = !support.p11dir

          else
            !!alert.error('If this framework type is to be attached to a Panel it may only be supported from a VERTICAL Panel')
            golabel /Element1

          endif

        endif

      endif

-- Determine if Identified element is suitable to support from
        !single = FALSE
--------------------------------------------------------------------------------------
        !picknum = 'FIRST'
        !testce  = !!mdsreltocomp(!datum, !pick1, !p10dir, !clearance, !form, !picknum, !halfwidth )


--------------------------------------------------------------------------------------
       if (!testce[1].upcase() eq 'UNSET')then
          !!mdsresetpins(1,10)
          !!alert.error('Identified element is unsuitable to support from.')
          golabel /Element1
        elseif (!testce[1].upcase() eq '')then
          golabel /Element1
          !!mdsresetpins(1,10)
--------------------------------------------------------------------------------------

        elseif (!testce[1].upcase() eq 'LOWER')then
-- Ask if USER wants to Identify a LOWER Cylinder to BRACE From
          if (!!alert.confirm('Identified element is NOT suitable for Bracing the Framework.  Do You want to Support the Bracing off a LOWER $!pick1.fulltype') eq 'NO') then
            golabel /Element1
          else
            !single     = FALSE
            !vessenddir = !p10dir
            !freeenddir = !p11dir
            golabel /Element2
          endif

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'UPPER')then
          !!mdsresetpins(1,10)
          !!alert.error('Identified element is NOT suitable for Supporting the Top Members of the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'DIAMETER')then
          !!mdsresetpins(1,10)
          !!alert.error('Identified Cylinder is NOT of Sufficient Diameter to Support the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'WIDTH')then
          !!alert.error('Identified Panel will NOT Support the Framework along its Width ')
          !!mdsresetpins(1,10)
-- Ask if USER to Identify Panel again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'OK')then

-- Check Distance from  Face of Vessel Cylinder or Panel to 'P0' of Datum Atta is
-- GREATER than the Distance from 'P0' of the Datum Atta to the Outside of the INSIDE
-- Cross Tie Angle of the Framework, ie. '/<struname>-TIE-2'

          if (!pin2pin9dist.lt(!mindist)) then
          !!MdsResetPins(1,10)
            !!alert.error('Insufficent Space between the Pipe and the Identified ''$!pick1.fulltype'' to build the Framework')
            golabel /Element1
          endif

-- Set ANY data as a Single Element is OK to Support Framework/Trunnion
          !single  = TRUE
          !vessenddir = !p10dir
          !freeenddir = !p11dir
          golabel /SINGLE

        endif

--------------------------------------------------------------------------------------
-- Identify Second Element if Required and Check its Suitability

      label /Element2
      if (!single.not()) then

        !picknum = 'SECOND'
        prompt off
        prompt load escape |Identify SECOND element to Support BRACING from|
        id $!idtype @
        handle (61,528)
          prompt on
          !!ce = !stru
          !!kRestoreUnits(!currentunits)
        return
        endhandle
        prompt dismiss
        prompt on

        !pick2 = !!ce

-- Check Both Picked Elements are of the Same Type
        if (!pick2.type neq !pick1.type) then
          !!alert.error('The SECOND Identified element type MUST be the same type as the FIRST element')
          golabel /Element2
        endif

        if (!pick2.type eq 'CYLI') then
          !nam1  = namn of equipment of $!pick1
          !nam2  = namn of equipment of $!pick2
          if (!nam1 neq !nam2) then
            !!alert.error('The SECOND element MUST belong to the same VERTICAL Vessel')
            golabel /Element2
          endif
        else
          !nam1  = namn of structure of $!pick1
          !nam2  = namn of structure of $!pick2
          if (!nam1 neq !nam2) then
            !!alert.error('The SECOND element MUST belong to the same STRUCTURE')
            golabel /Element2
          endif
        endif

        !pick2 = !!ce
        !picknum = 'SECOND'
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

        if (!pick2.type.string().eq('CYLI')) then
          !cyl2dir = p0 dir of $!pick2 wrt /*
          if (!cyl2dir eq U or !cyl2dir eq D) then
-- Position Pins On 'SECOND' Pick for 'Vertical Bracing'
            pin 2 copy p2 of $!datum
            pin 2 plane pin 2 thro p0 of $!pick2
            pin 2 dir to p0 of $!pick2
            pin 3 copy pin 2
            pin 3 plane pin 3 thro p0 of $!pick2
            pin 3 dir to pin 2
            pin 4 copy pin 3
            pin 4 plane pin 4 clear 0 beh $!pick2
            pin 8 copy pin 4
            pin 8 dir $!ddir
            pin 8 plane pin 8 clear 0 beh $!pick2

            var !pin2dir pin 2 dir wrt /*
            !pin3pin4dist = !!KStrReal('const dist pin 3 to plane pin 4')

          else
            !!alert.error('If this framework type is to be attached to a Vessel it may only be supported from a VERTICAL Vessel')
            golabel /Element2
          endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
        else
-- For Panels  - Trunnions must be 'Parallel' to the Identified Element
-------------------------------------------------------------------------------------------

          if (!pick2.hardtype.string().eq('PANE')) then
            !panlori  = ori of $!pick2 wrt /*
            !panlxdir = !panlori.xdir()
            !panlydir = !panlori.ydir()
            !panlzdir = !panlori.zdir()

-- Check if Panel is Vertical ie. Wall
            if (!panlydir.up.abs() eq 1 or !panlxdir.up.abs() eq 1) then
              pin 1 at $!pick2
              pin 1 dir $!panlzdir
              pin 2 copy pin 1
              pin 2 at $!datum
              pin 10 copy pin 2
              pin 10 plane pin 10 thro pin 1
              pin 2 dir to pin 10
              var !pin2dir pin 2 dir wrt /*
              pin 9 copy pin 2
              pin 9 plane pin 9 clear 0 inf $!pick2
              pin 4 copy pin 2
              pin 4 plane pin 4 clear 0 inf $!pick2

-- Position Pins 5 and 6 on the Vertical Edges of the SECOND Panel
-- Position Pin 8 at Bottom of SECOND Panel

              if (!panlydir.up eq 1) then
-- Ydir is UP wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlxdir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlydir
                pin 8 plane pin 8 clear 0 inf $!pick2

              elseif (!panlydir.up eq -1) then
-- Ydir is DOWN wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlxdir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlydir
                pin 8 plane pin 8 clear 0 beh $!pick2

              elseif (!panlxdir.up eq 1) then
-- Xdir is UP wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlydir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlxdir
                pin 8 plane pin 8 clear 0 inf $!pick2

              elseif (!panlxdir.up eq -1) then
-- Xdir is DOWN wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlydir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlxdir
                pin 8 plane pin 8 clear 0 beh $!pick2

              endif

            else
              !!alert.error('If this framework type is to be attached to a Panel it may only be supported from a VERTICAL Panel')
              golabel /Element2

            endif

          endif

        endif

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
        !testce  = !!Mdsreltocomp(!datum, !pick2, !p10dir, !clearance, !form , !picknum, !halfwidth )

        if (!testce[1].upcase() eq 'UNSET')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework.')
          golabel /Element2
        elseif (!testce[1].upcase() eq '')then
          golabel /Element2
-------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'DIAMETER')then
          !!alert.error('Identified Cylinder is NOT of Sufficient Diameter to Support the Bracing of the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'WIDTH')then
          !!alert.error('Identified Panel will NOT Support the Framework along its Width ')
-- Ask if USER to Identify Panel again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'LOWER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework.')
-- Ask if USER to Identify Element again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'UPPER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework ')
-- Ask if USER to Identify Element again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'OK')then
-- Set ANY data as the LOWER Element is OK to Support the Bracing of The Framework
          !single     = FALSE
          !vessenddir = !p10dir
          !freeenddir = !p11dir
        endif

--------------------------------------------------------------------------------------
-- end of if(!single.not()) - BLOCK at line 355
      endif
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- Carry On Building Support Framework Attached to a Single Element
-- Set !pick2 to be the same as !pick1 if the Whole Framework
-- will fit onto a Single Element
    label /SINGLE
      if (!single) then
        !pick2 = !pick1
      endif

--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Position Pins for Pick1 and Pick2 if required
      !!ce = !pick1

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
      if (!pick1.hardtype eq 'PANE') then
-- Pins are in Position Relative to the 'FIRST' Panel Pick
        !!ce = !datum
-- Temporarily orientate Trunnion to Position Pins 1 and 2 in the Correct Directions
        rotate by 90
        pin 1 copy p10 of $!datum
        pin 1 at $!datum
        pin 2 copy p11 of $!datum
        pin 2 at $!datum

-- Put Trunnion Back to the Correct Ori
        rotate by -90
        pin 3 copy p11 of $!datum
        pin 3 at $!datum

-- Position Pins
        pin 1 dist $!halfwidth
        pin 2 dist $!halfwidth
        pin 3 dist $!halfwidth

        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p10
        pin 5 copy p10
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy p11 of $!datum
        pin 9 plane pin 9 clear 0 beh $!pick1
        var !pin9pos pin 9 pos wrt /*

-- Dimension1(Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Cross Bar(s) and Panel)
        !dim1 = !!KStrReal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Panel
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Panel has been Identified
-- If a SECOND Panel is NOT Required then !pick2 is set to !pick1 - See Above
        pin 8 copy p11 of $!datum
        pin 8 plane pin 8 clear 0 beh $!pick2
        pin 10 copy pin 8
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10
        var !pin8pos pin 8 pos wrt /*

-- Dimension3 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Vertical Bracing(s) and Panel)
        !dim3 = !!KStrReal('const dist p0 of $!datum to plane pin 8 ')

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Panel
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1, *-BAR-2'
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*

-- Attached to Vessel End of Framework - pin 8 and pin 9 - for Vertical Bracings '*-V1, *-V2'
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly -- see line 342 above
--------------------------------------------------------------------------------------

      elseif (!pick1.type eq 'CYLI') then

-- Pins are in Position Relative to the 'FIRST' Cylinder Pick
        !!ce = !datum
-- Temporarily orientate Trunnion to Position Pins 1 and 2 in the Correct Directions
        rotate by 90
        pin 1 copy p10 of $!datum
        pin 1 at $!datum
        pin 2 copy p11 of $!datum
        pin 2 at $!datum

-- Put Trunnion Back to the Correct Ori
        rotate by -90
        pin 3 copy p11 of $!datum
        pin 3 at $!datum

-- Position Pins
        pin 1 dist $!halfwidth
        pin 2 dist $!halfwidth
        pin 3 dist $!halfwidth

        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p10
        pin 5 copy p10
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy p11 of $!datum
        pin 9 plane pin 9 thro pin 10

-- Calculate Pin 9 position to construct line
        !asqre = !pin9pin10dist.power(2) - !halfwidth.power(2)
        !adist = !asqre.sqrt()
        pin 9 dist $!adist
        var !pin9pos pin 9 pos wrt /*
-- Dimension1 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
-- '!halfwidth' position of Cross Bar(s) and Cylinder Diameter)
        !dim1 = !!kstrreal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Cylinder
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Cylinder has been Identified
        pin 8 copy p11 of $!datum
        pin 8 plane pin 8 thro p0 of $!pick2
        pin 10 copy pin 8
        pin 10 at $!pick2
        pin 8 plane pin 8 clear 0 beh $!pick2
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10

-- Calculate Pin 8 position to construct line
        !bsqre = !pin8pin10dist.power(2) - !halfwidth.power(2)
        !bdist = !bsqre.sqrt()
        pin 8 dist $!bdist
        var !pin8pos pin 8 pos wrt /*
-- Dimension3 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Vertical Bracing(s) and Cylinder Diameter)
        !dim3 = !!KStrReal('const dist p0 of $!datum to plane pin 8 ')

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Cylinder
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1, *-BAR-2'
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*
-- Attached to Vessel End of Framework - pin 8 and pin 9 - for Vertical Bracings '*-V1, *-V2'
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly --

      endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
-- Set Rotation to '0' for CURSOR mode
      !support.rotated     = 0

--------------------------------------------------------------------------------
    elseif (!Method eq |DIMENSION|)then
-- Create  Framework by Dimensions
-- Initialise variables for dimension check
      !d1 = !!mdsvt01.dim1.val
      !d2 = !!mdsvt01.dim2.val
      !d3 = !!mdsvt01.dim3.val

      if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0)) then
        !!alert.error('Not all of the dimensions have been completed.')
        !!kRestoreUnits(!currentunits)
        return
      endif

      if (!d2.gt(!d1)) then
        !!alert.error('Cannot create from given dimensions. Dim 2 must be less that Dim 1.')
        !!kRestoreUnits(!currentunits)
        return
      endif

      if (!d2.gt(!d3)) then
        !!alert.error('Cannot create from given dimensions. Dim 2 must be less that Dim 3.')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Check Distance Dimension -'Dim 1' is GREATER than the Distance '!mindist' which is the Minimum
-- Distance from the 'P0' of the Datum Atta to the Outside Edge of the Inside Cross Tie Angle of the
-- Framework, ie. '/<struname>-TIE-2'
      !halfpipe = !pipodia / 2
      if (!d1.lt(!mindist)) then
        !!kformattext.text.val = !mindist
-- and the stru
        !fmindist = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !!alert.error('The Dimension - ** Dim 1 ** - must be a Minimum of ' & !fmindist & ' $
                       for the Current Pipe Size and the Dimension ** Dim 2 ** shown in the form')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Get Atta Orientation
      !vessenddir  = !p10dir
      !freeenddir  = !p11dir

--------------------------------------------------------------------------------------
-- Position pins
      !!ce = !datum
-- Temporarily orientate Trunnion to Position Pins 1 and 2 in the Correct Directions
      rotate by 90
      pin 1 copy p10 of $!datum
      pin 1 at $!datum
      pin 2 copy p11 of $!datum
      pin 2 at $!datum
-- Put Trunnion Back to the Correct Ori
      rotate by -90
      pin 3 copy p11 of $!datum
      pin 3 at $!datum
-- Position Pins
      pin 1 dist $!halfwidth
      pin 2 dist $!halfwidth
      pin 3 dist $!halfwidth

      var !pin1dir pin 1 dir wrt /*
      var !pin2dir pin 2 dir wrt /*
      var !pin3dir pin 3 dir wrt /*

      pin 4 copy p10 of $!datum
      pin 4 at pin 1
      pin 5 copy p10 of $!datum
      pin 5 at pin 2

-- Position Pins 4 and 5 for Top Cross Bars
      pin 4 dist $!!Mdsvt01.dim1.val
      pin 5 dist $!!Mdsvt01.dim1.val

-- Get Position on Atta CL Distance 'Dim 1' from Atta
      pin 9 copy p10 of $!datum
      pin 9 dist $!!Mdsvt01.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

--------------------------------------------------------------------------------------
-- Get Position on Atta CL Distance 'Dim 3' from Atta
      pin 9 copy p10 of $!datum
      pin 9 dist $!!Mdsvt01.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

-- Position Pins 6 and 9 for Vertical Bracings
      pin 6 copy p10 of $!datum
      pin 6 at pin 1
      pin 9 copy p10 of $!datum
      pin 9 at pin 2

-- Position Pins 6 and 9 for Top Cross Bars
      pin 6 dist $!!Mdsvt01.dim3.val
      pin 9 dist $!!Mdsvt01.dim3.val

--------------------------------------------------------------------------------------
-- Construct Lines
      var !line1 cons line pin 1
      var !line4 cons line pin 4
      var !line5 cons line pin 5
      var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

    endif

----------------------------------------------------------------------
$(
-- Create an ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
-- and the Type and Size of the Packing Pieces to Recreate
    !attapp = !!Mdspackers(!support)

$)
----------------------------------------------------------------------

----------------------------------------------------------------------
-- Navigate to Stru
    !!ce = !stru

-- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle

    !mdstemp = /MDS/VT01/$!Selection
    :mdscheck $!mdstemp.:mdscheck

-- Temporarily Position Structure at Datum Atta
    at $!datum
    new frmw $!name/MAIN
    !frmwsupport = !!ce

-- Copy required template/s
    !!ce         = /MDS/VT01/$!selection

    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')

--------------------------------------------------------------------------------------
-- Navigate back to support and create template elements
    !!ce = !frmwsupport
    copy attrib of $!frmw[1]
    copy mem of $!frmw[1] rename $!frameformat $!name

-- Set stru description for template recognition
    !desc = desc of /MDS/VT01/$!Selection

-- Position and Orientate Structure
    !!ce = !stru
    desc '$!Desc'

-------------------------------------------------------------------------------------
$(
-- the move below depends on which way round the atta is
-- ie flow u (p9 is at the top) therefore the stru is positioned incorrectly
-- AK
-- *** This CODE NOT REQUIRED *** <wd>dec2003
    !LowestPpoint = !!MdsLowestPPoint(!Datum,'LOWER')

    move $!ddir thro P$!LowestPpoint of $!datum
-- *** This CODE NOT REQUIRED *** <wd>dec2003
$)

-------------------------------------------------------------------------------------
-- Move the Dummy Legs 1 and 2 to the Elevation of the P0 of the VT01 Datum Atta
    !datump9dir = !datum.pdir[9].wrt(/* )
    !opposp9dir = !datump9dir.opposite()
    !count      = 0
    do !trun values !dummyleg
      !!ce  = !trun
      !hdir = !trun.hdir.wrt(/* )
      !href = !trun.href
      !!ce  = !href
-- Ensure thet the P3 of the TEE and the BRANCH HDIR start in the same DIRECTION
      ori and p3 is $!hdir

      !!ce  = !trun
      !count = !count + 1
      !disttomove = !!kstrreal('cons dist p0 of $!href to p0 of $!datum')
      var !dirtomove const dir p0 of $!href to p0 of $!datum
      !datumpos  = !datum.position
      !uposdatum = !datum.position.up
      !uposhref  = !href.position.up
-- Only move Dummy leg if it is NOT in the SAME UPPING Position as the VT01 Datum Atta
      if (!!krealequalreal(!uposdatum,!uposhref,1).not()) then
        !!ce = !href
        --drag move $!dirtomove thro $!datum
        move $!dirtomove thro $!datum
        !!ce = !trun
        move ph $!dirtomove thro $!datum
      endif

      if (!count.eq(1)) then
-- Dummy Leg No.1
        !!ce = !href
-- Calculate Angle Difference 1
        !origtee1p3dir = !href.pdir[3].wrt(/* )
--        !anglediff1    = !datump9dir.angle(!origtee1p3dir)
-- Orientate Tee 1 and Connect Dummy Leg 1
        ori and p3 is $!datump9dir
        !!ce = !trun
        conn ph to p3 of href
        hdir $!datump9dir
        tdir $!opposp9dir
        !amem = !trun.mem
        do !zmem indices !amem
          if (!zmem.eq(1) or !zmem.eq(2)) then
            !!ce = !amem[!zmem]
            conn
          elseif (!amem[!zmem].name.match('/SREF').gt(0) and !amem[!zmem].:mdssupptype.eq('TT17')) then
            !!ce = !amem[!zmem]
            ori
            dist 100 from pl of prev
          else
            !!ce = !amem[!zmem]
            ori
            thro ce
          endif
        enddo
        tail
        conn pt to last mem
$(
-----------------------------------------------------------------------------------------------
        rotate thro $!datumpos about D wrt /* by $!anglediff1

-- Set object definition to Check Tee 1 and Dummy Leg 1 Head Direction are the same - i.e within 1 degree tolerance
        !direction = object kequaldir()
        !direction.directiona = !trun.hdir.wrt(/* )
        !direction.directionb = !href.pdir[3].wrt(/* )
        !direction.tolerance  = 0.5

if (!!mdsvtequaldir(!direction).not()) then
do !loop1 from 1 to 1000
-- Set object definition to Check Tee 1 and Dummy Leg 1 Head Direction are the same - i.e within 1 degree tolerance
        !direction = object kequaldir()
        !direction.directiona = !trun.hdir.wrt(/* )
        !direction.directionb = !href.pdir[3].wrt(/* )
        !direction.tolerance  = 0.5

        if (!!mdsvtequaldir(!direction).not()) then
-- Rotated the Dummy Leg No.1 the WRONG way
-- So Rotate in the "OPPOSITE" direction Dummy Leg 1 by TWICE the !anglediff1
          --rotate thro $!datumpos about D wrt /* by (2 * -$!anglediff1 )
          rotate thro $!datumpos about D wrt /* by 1
        else
          break
        endif

enddo
endif
$)
-----------------------------------------------------------------------------------------------

      elseif(!count.eq(2)) then
-- Dummy Leg No.2
        !!ce = !href
-- Calculate Angle Difference 2
        !origtee2p3dir = !href.pdir[3].wrt(/* )
--        !anglediff2    = !opposp9dir.angle(!origtee2p3dir)
-- Orientate Tee 2 and Connect Dummy Leg 2
        ori and p3 is $!opposp9dir
        !!ce = !trun
        conn ph to p3 of href
        hdir $!opposp9dir
        tdir $!datump9dir
        !bmem = !trun.mem
        do !xmem indices !bmem
          if (!xmem.eq(1) or !xmem.eq(2)) then
            !!ce = !bmem[!xmem]
            conn
          elseif (!bmem[!xmem].name.match('/SREF').gt(0) and !bmem[!xmem].:mdssupptype.eq('TT17')) then
            !!ce = !bmem[!xmem]
            ori
            dist 100 from pl of prev
          else
            !!ce = !bmem[!xmem]
            ori
            thro ce
          endif
        enddo
        tail
       conn pt to last mem
-----------------------------------------------------------------
$(
        rotate thro $!datumpos about D wrt /* by $!anglediff2

-- Set object definition to Check Tee 1 and Dummy Leg 1 Head Direction are the same - i.e within 1 degree tolerance
        !direction = object kequaldir()
        !direction.directionb = !trun.hdir.wrt(/* )
        !direction.directiona = !href.pdir[3].wrt(/* )
        !direction.tolerance  = 0.5
!dir2 = !!mdsvtequaldir(!direction)
$P !dir2 is $!dir2
--$R110
if (!!mdsvtequaldir(!direction).not()) then
        $R
do !loop2
-- Set object definition to Check Tee 2 and Dummy Leg 2 Head Direction are the same - i.e within 1 degree tolerance
        !direction = object kequaldir()
        !direction.directionb = !trun.hdir.wrt(/* )
        !direction.directiona = !href.pdir[3].wrt(/* )
        !direction.tolerance  = 0.5
!dir2loop = !!mdsvtequaldir(!direction)
$P !dir2loop is $!dir2loop
        if (!!mdsvtequaldir(!direction).not()) then
-- Rotated the Dummy Leg No.2 the WRONG way
-- So Rotate in the "OPPOSITE" direction Dummy Leg 2 by TWICE the !anglediff2
          --rotate thro $!datumpos about D wrt /* by (2 * -$!anglediff2 )
          rotate thro $!datumpos about D wrt /* by 1
        else
          break
        endif

        break if !loop2 eq (5000)
$P !loop2 is $!loop2
enddo
endif
!!dd = !direction
$)
-----------------------------------------------------------------
      endif
    enddo

-- Reset the Distance Gadget to ZERO because the DATUM Atta is in the Position as the Dummy legs
    !!ce = !datum
    prev
    handle ANY
      !distprev = !!kstrreal('cons dist p0 to ph')
    elsehandle NONE
      !!ce = !datum
      !distprev = !!kstrreal('cons dist p0 to pl of prev')
    endhandle
    !form.dist.val = !distprev

-- Move STRU to BOP of Dummy Legs 1 and 2
    !!ce = !stru
    move $!ddir thro P 0 of $!datum
    move $!ddir dist $!htrunodia
    !orix = !freeenddir
    !oriz = !udir
    ori x is $!orix and z is $!oriz

--------------------------------------------------------------------------------------
-- Extend and move Cross Bar *-BAR-1
    !!ce = $!<name>-BAR-1
    move $!pin2dir wrt /* clear 0 inf pin 2
    extend start thro pin 3
    extend end thro pin 5
    !Flush = :MDSOlap
    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      extend start $!ONum
    endif

-- Extend and move Cross Bar *-BAR-2
    !!ce = $!<name>-BAR-2
    move $!pin1dir wrt /* clear 0 inf pin 1
    extend start thro pin 3
    extend end thro pin 4
    !Flush = :MDSOlap
    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      extend start $!ONum
    endif

-- Extend and move Cross Bars Tie *-TIE-1
    !!ce = $!<name>-TIE-1
    extend start thro pin 2
    extend end thro pin 1
    move $!freeenddir clear 0 inf pin 3
    !Flush = :MDSOlap
    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      extend start $!ONum
      extend end $!ONum
    endif

-- Extend and move Vertical Bracing *-V1
    !!ce = $!<name>-V1
    move $!pin2dir wrt /* clear 0 inf pin 2
    pin 9 dir $!ddir
    var !line9 cons line pin 9
    pin 7 at ppline na start
    pin 8 at ppline na end
    pin 7 dir to pin 8
    pin 8 dir to pin 7
    var !line7 cons line pin 7
    var !line7intline9 cons pos intersect $!line7 wrt /* $!line9 wrt /*
    pin 8 at $!line7intline9 wrt /*
    extend end thro pin 8

-- Extend and move Vertical Bracing *-V2
    !!ce = $!<name>-V2
    move $!pin1dir wrt /* clear 0 inf pin 1
    pin 6 dir $!ddir
    var !line6 cons line pin 6
    pin 7 at ppline na start
    pin 8 at ppline na end
    pin 7 dir to pin 8
    pin 8 dir to pin 7
    var !line7 cons line pin 7
    var !line7intline6 cons pos intersect $!line7 wrt /* $!line6 wrt /*
    pin 8 at $!line7intline6 wrt /*
    extend end thro pin 8

--------------------------------------------------------------------------------------
$(
-- Adjust Length of Trunnion to suit Framework
    !!ce = !datum
    !tlen = !!KStrReal('const dist p0 to plane pin 2')
    !!MdsDacControl(true)
    despar number 1 ($!tlen + 50
$)

--------------------------------------------------------------------------------------
-- Adjust Length of Trunnion to suit Framework
    !!mdsdaccontrol(true)
    !!ce = !datum
    !tlen = !!kstrreal('const dist p0 to plane pin 2')
-- Add the HARD Coded 50mm Overhang to the Trunnion Length - View MDS Standard Plot File
    !tlen = !tlen + 50
    do !x indices !dummyleg
      !tbran = !dummyleg[!x]
      !tsref = !dummysref[!x]
      !!mdsvtdummylen(!tlen,!tbran,!tsref)
    enddo
    !!mdsdaccontrol(false)

--------------------------------------------------------------------------------------
-- Set dimensions
    if (!Method eq |CURSOR|)then
-- Dimension 1
      !dimr1 = !dim1.nint()
      !!Mdsvt01.dim1.val = !dimr1
-- Dimension 2
-- Is Already Set to Determine the !halfwidth structure
--xxx      !!Mdsvt01.Dim2.Val = !Dim2
-- Dimension 3
      !dimr3 = !dim3.nint()
      !!Mdsvt01.dim3.val = !dimr3
    endif

--------------------------------------------------------------------------------------
-- Select correct spref - SREF of VT01 Support
    !!ce = $!<name>/SREF
    !!mdsdaccontrol(true)
    sel spref with styp 'VT01' spec /MDF
    !!mdssetispe()
    !!mdssellstu(!!ce)
    !!mdsdaccontrol(false)
    !!ce = !stru

-- Associate attas to bar
    !list = !form.support.bars
    !references = ''
    do !I indices !list
      !references = !references & ' ' & !list[!I].string()
    enddo

-- Set atta references to datum cross bar
    !!ce = $!<name>-BAR-1
    :mdsattaref $!references
    !support.barlen[1] = deri length of ce

--------------------------------------------------------------------------------------
-- Store dimensions in design parameters
    !!ce = $!<name>/SREF
    !!MdsDacControl(true)
    despar $!!mdsvt01.dim1.val $!!mdsvt01.dim2.val $!!mdsvt01.dim3.val
    !!mdsdaccontrol(false)

-- Reset materials of sections
    !!mdsresetmat(!storemat)

--------------------------------------------------------------------------------------
-- Navigate to Structure
    !!ce = !stru

--------------------------------------------------------------------------------------
$(
--<wd>dec2003
-- Set 'FT25' form Support Object to be the same as 'vt01' form Support Object
    !!Mdsft25.support = !support

-- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
-- During the Framework Creation above
    !!Mdsft25.support.packs.clear()
    !support.packs.clear()

-- Create Required Packing Pieces(SCTNs) at the Necessary Attas
    call !!Mdscrpacksft25(!attapp, !!Mdsvt01)

-- Update 'vt01' support.packs data to that held in form 'FT25'
    !support.packs = !!Mdsft25.support.packs

-- Navigate to Main Structure of Framework
    !!ce = !stru
$)

----------------------------------------------------------------------
-- If a joint is being used and it is handed then their will be a alternative spref of the
 -- opposite hand joint and the bang to set seperated by a ,

    -- !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

-- Reset the zdist for all joints
    var !sjois coll all sjoi for $!name
    do !resetzdist values !sjois
      !!ce = !resetzdist.dbref()
      snod
      zdist thro cref of same
    enddo

----------------------------------------------------------------------
-- Remove the Dummy Leg SREF Attas from the !form.support object members .atta and .bars
-- So that it doesn't DELETE them, if the User 'Cancels' the Support in "NEW SUPPORT CREATE MODE"
    !rematta = ARRAY()
    do !ax indices !support.atta
      if (!support.atta[!ax].:mdssupptype.eq('TT17')) then
        !rematta.append(!ax)
      endif
    enddo
    do !anx values !rematta
      !support.atta.deletefrom(!anx,1)
    enddo

    !rembars = ARRAY()
    do !bx indices !support.bars
      if (!support.bars[!bx].:mdssupptype.eq('TT17')) then
        !rembars.append(!bx)
      endif
    enddo
    do !bnx values !rembars
      !support.bars.deletefrom(!bnx,1)
    enddo
----------------------------------------------------------------------
-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.append(!!ce)
    !colourlist.appendarray(!support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Reset all pins associated with this support
    call !!Mdsresetpins(1,10)

-- Update support data held in form
    !!Mdsvt01.support = !support

--------------------------------------------------------------------------------------
-- Remove Wait.. Prompt from Screen
    !!Mdscreatemess(false)

-- Reset Units
   !!kRestoreUnits(!currentunits)

--------------------------------------------------------------------------------------
  endfunction
-- End function

-- End of file Mdscreatevt01.pml
