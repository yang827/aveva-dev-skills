--
--------------------------------------------------------------------------------
--
-- File:                Mdscreatevt04.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MVS104
--
-- Author:              Wayne Dodwell
-- Created:             Tuesday 20th January 1998
--
--
-- Description:
-- function to create Vessel support frame type 'VT04'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscreatevt04(!method is string)

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()




-- Initialise variables
    call !!Mdsresetpins(1,10)
    !form      = !!Mdsvt04
    !idtype    = 'PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL CYLI'
    !support   = !!Mdsvt04.support
    !clearance = !!Mdsoptions.clear.val
    !overlap   = !!Mdsoptions.overlap.val
    -- !selection = !!Mdsvt04.size.selection('rtext')
    !Selection = !!MdsSetSteel.Size.Selection('Rtext')
    !datum     = !support.datum
    !stru      = !support.stru
    !name      = !stru.name
    !p9dir     = !support.p9dir
    !xp9dir    = !support.p9dir
    !p10dir    = !support.p10dir
    !p11dir    = !support.p11dir
    !pldir     = !support.pldir
    !padir     = !support.padir

--------------------------------------------------------------------------------
-- Check that Datum atta has been created
    if (!datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
        return
    endif

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

-- Check that Datum atta has been positioned
    if (!support.position.not())then
      !!alert.message('Position atta before Identifying supporting element')
      !!kRestoreUnits(!currentunits)
        return
    endif

-- Check which attas to work from
    !atta = !support.bars[1]

--------------------------------------------------------------------------------
-- Set orientation - 'VT04' is  Only Allowed on Vertical Pipes
    !ddir = D wrt world
    !udir = U wrt world
-- Get original ORI for Datum Atta
    !!ce       = !datum
    !oridatum  = ori wrt /*

--------------------------------------------------------------------------------
-- Half Width of Framework - Using the Calculated Shoe Height against the Pipe O/Dia(half) + Insulation Thickness,
--                           plus the Width of Top Cross Bars and Clearance set in '.Dim2' gadget of form
    var !insu insulation
    !pipodia   = !datum.lstu.catref.param[2]
    !pipclear  = !!Mdsvt04.dim2.val
    !shei = !!KStrReal('const dist p0 to plane p9 ')
    --!shoehei   = !shei + 1
    -- dtf 6sep04
    --not sure why we add 1 to this here but the clearance is 1 mm out at the end
    !shoehei   = !shei

--$P shoehei is **$!shoehei**
--$P insu    is **$!insu**
!halpip = !pipodia / 2
--$P Half Pipe O/Dia. is **$!halpip**
--$P pipe od is **$!pipodia **

-- Ensure the Shoe Height is Greater than 'Half the Pipe ODia. + Insulation Thickness'
    if (!shoehei.lt(!insu.real() + !pipodia / 2)) then
      !!alert.error('The Height of the Pipe-Shoe/Guide MUST be greater than ''Half the Pipe O/Dia. + Insulation Thickness.''')
      !!kRestoreUnits(!currentunits)
        return
    endif

-- Navigate to Template  Member '*-BAR-2'
-- Determine the Main Channel Cross Bar Width
    !!ce = /MDS/$!<support.type>/$!<selection>-BAR-2
--xxx
    pin 1 at stru
    pin 2 copy pin 1
    pin 2 dir n wrt /*
    pin 2 plane pin 2 clear 0 beh ce

    !widt = !!kstrreal('cons dist pin 1 to plane pin 2')
--xxx
--xxx    var !widt (prop WIDT of ce)
--xxx    handle any
--xxx      !!alert.error('Contact your PDMS Administrator - The Selected Section Size 'DATASET' is NOT defined correctly in the Catalogue.')
--xxx      !!kRestoreUnits(!currentunits)
--xxx        return
--xxx    endhandle
--xxx
-- Navigate to Template  Member '*-TIE-1'
-- Determine the Main Angle Tie Horiz Leg Length
    !!ce = /MDS/$!<support.type>/$!<selection>-TIE-1
--xxx
    pin 1 at stru
    pin 2 copy pin 1
    pin 2 dir e wrt /*
    pin 2 plane pin 2 clear 0 beh ce

    !yleg = !!kstrreal('cons dist pin 1 to plane pin 2')
--xxx
--xxx    var !yleg (prop YLEG of ce)
--xxx    handle any
--xxx      !!alert.error('Contact your PDMS Administrator - The Selected Section Size 'DATASET' is NOT defined correctly in the Catalogue.')
--xxx      !!kRestoreUnits(!currentunits)
--xxx        return
--xxx    endhandle

-- Half Width of Vessel Framework Structure
---$P !insu is **$!insu**
---$P ODia is **$!pipodia**
---$P Clear is **$!pipclear**
---$P !widt is **$!widt**
---$P !yleg is **$!yleg**

    !calcwidth = !shoehei + !pipclear + !widt.real()
    !halfwidth = !calcwidth.nint()
--$P halfwidth is **$!halfwidth**

    !calctie = !shoehei + !pipclear + !yleg.real()
    !halftie = !calctie.nint()
--$P !halftie is **$!halftie**

-- Store section name and matref for each member
-- for reseting later

    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)

--------------------------------------------------------------------------------
-- Generate pin positions for each creation type
--------------------------------------------------------------------------------

    if (!method eq |CURSOR|) then
-- Create Framework by Cursor
--------------------------------------------------------------------------------
--################################## CURSOR ##################################
--------------------------------------------------------------------------------

-- Identify the Element First and Check if Framework Cross Bars
-- will Fit and Intersect Element with the correct Clearance

    label /Element1

      !!ce = !datum
      ori $!oridatum
--------------------------------------------------------------------------------------
-- Position All Attas in the Correct Orientation relative to the Datum Atta
      do !numb index !support.atta
        !!ce = !support.atta[!numb]
        skip if (!support.atta[!numb].name.match('/SREF').gt(1))
        skip if (!support.atta[!numb].name.match('/DATUM').gt(1))
        at $!datum
        ori and p9 is $!xp9dir
        !split = !support.atta[!numb].name.split('.')
        !count = !split.last()
        rotate by ($!count * 90)
      enddo
-- Add Marker Aid Text at P9 of Each Atta
      !!Mdsaidtext(!!Mdsvt04)
--------------------------------------------------------------------------------------
      prompt off
      prompt load escape |Identify element to support from|
      id $!idtype @
        handle (61,528)
          prompt on
          !!ce = !datum
          ori $!oridatum
--------------------------------------------------------------------------------------
-- Position All Attas in the Correct Orientation relative to the Datum Atta
          do !numb index !support.atta
            !!ce = !support.atta[!numb]
            skip if (!support.atta[!numb].name.match('/SREF').gt(1))
            skip if (!support.atta[!numb].name.match('/DATUM').gt(1))
            at $!datum
            ori and p9 is $!xp9dir
            !split = !support.atta[!numb].name.split('.')
            !count = !split.last()
            rotate by ($!count * 90)
          enddo
-- Add Marker Aid Text at P9 of Each Atta
          !!Mdsaidtext(!!Mdsvt04)
--------------------------------------------------------------------------------------
          !!ce = !stru
          !!kRestoreUnits(!currentunits)
        return
        endhandle
      prompt dismiss
      prompt on

      !pick1 = !!ce
      !picknum = 'FIRST'

--------------------------------------------------------------------------------------

-- Orientate the DATUM Pipe-Shoe relative to the Identified Element Type
-- For Cylinders - DATUM Pipe-Shoe must be 'Tangential' to the Identified Cylinder

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
--################################## CYLINDERS ##################################
--------------------------------------------------------------------------------------
      if (!pick1.type.string().eq('CYLI')) then
        !cyldir = p0 dir of $!pick1 wrt /*
--------------------------------------------------------------------------------------
        if (!cyldir eq U or !cyldir eq D) then
          pin 1 copy p1 of $!datum
          pin 2 copy p2 of $!datum
          pin 2 plane pin 2 thro p0 of $!pick1
          pin 2 dir to p0 of $!pick1
          pin 10 copy pin 2
          pin 10 plane pin 10 thro p0 of $!pick1
          pin 10 dir to pin 2
          pin 9 copy pin 10
          pin 9 plane pin 9 clear 0 beh $!pick1
          pin 8 copy pin 9
          pin 8 dir $!ddir
          pin 7 copy pin 8
          pin 7 dir $!ddir
          pin 8 plane pin 8 clear 0 inf $!pick1
          pin 7 plane pin 7 clear 0 beh $!pick1
          var !pin2dir pin 2 dir wrt /*
          !pin2pin9dist = !!KStrReal('const dist pin 2 to plane pin 9')
          !pin9pin10dist = !!KStrReal('const dist pin 9 to plane pin 10')

-- Orientate DATUM Atta and the other 3 Attas and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Cylinder
          !!ce = !datum
          ori and p9 is $!pin2dir
          !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
          !support.p9dir  = p9 dir of $!datum wrt /*
          !p9dir          = !support.p9dir
          !support.p10dir = p9 dir of $!datum wrt /*
          !p10dir         = !support.p10dir
          !support.p11dir = p11 dir of $!datum wrt /*
          !p11dir         = !support.p11dir

        else

          !!alert.error('If this framework type is to be attached to a Vessel it may only be supported from a VERTICAL Vessel')
          golabel /Element1
        endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

      else

-- For Panels  - The DATUM Pipe-Shoe must be 'Parallel' to the Identified Element
-------------------------------------------------------------------------------------------
-- Element Types 'SCTN' and 'BOX' have been EXCLUDED for this Type of Support - wd/nm - jan1998
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
--################################## PANELS ##################################
--------------------------------------------------------------------------------------
        if (!pick1.hardtype.string().eq('PANE')) then
          !panlori  = ori of $!pick1 wrt /*
          !panlxdir = !panlori.xdir()
          !panlydir = !panlori.ydir()
          !panlzdir = !panlori.zdir()

-- Check if Panel is Vertical ie. Wall
--------------------------------------------------------------------------------------
          if (!panlydir.up.abs().eq(1) or !panlxdir.up.abs().eq(1)) then
            pin 1 at $!pick1
            pin 1 dir $!panlzdir
            pin 2 copy pin 1
            pin 2 at $!datum
            pin 10 copy pin 2
            pin 10 plane pin 10 thro pin 1
            pin 2 dir to pin 10
            var !pin2dir pin 2 dir wrt /*
            pin 9 copy pin 2
            pin 9 plane pin 9 clear 0 inf $!pick1
            !pin2pin9dist = !!KStrReal('const dist pin 2 to plane pin 9')

-- Position Pins 5 and 6 on the Vertical Edges of the Panel
-- Position Pin 7 at Bottom of Panel
-- Position Pin 8 at Top of Panel

--------------------------------------------------------------------------------------
            if (!panlydir.up.eq( 1)) then
-- Ydir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlydir.up.eq( -1)) then
-- Ydir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            elseif (!panlxdir.up.eq( 1)) then
-- Xdir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlxdir.up.eq( -1)) then
-- Xdir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            endif
--------------------------------------------------------------------------------------

-- Orientate Atta and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Vertical Panel
            !!ce = !datum
            ori and p9 is $!pin2dir
            !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
            !support.p9dir  = p9 dir of $!datum wrt /*
            !p9dir          = !support.p9dir
            !support.p10dir = p10 dir of $!datum wrt /*
            !p10dir         = !support.p10dir
            !support.p11dir = p11 dir of $!datum wrt /*
            !p11dir         = !support.p11dir

          else

            !!alert.error('If this framework type is to be attached to a Panel it may only be supported from a VERTICAL Panel')
            golabel /Element1

          endif

        endif

      endif

--------------------------------------------------------------------------------------
-- Position All Attas in the Correct Orientation relative to the Datum Atta
      do !numb index !support.atta
        !!ce = !support.atta[!numb]
        skip if (!support.atta[!numb].name.match('/SREF').gt(1))
        skip if (!support.atta[!numb].name.match('/DATUM').gt(1))
        at $!datum
        ori and p9 is $!p9dir
        !split = !support.atta[!numb].name.split('.')
        !count = !split.last()
        rotate by ($!count * 90)
      enddo
-- Add Marker Aid Text at P9 of Each Atta
      !!Mdsaidtext(!!Mdsvt04)

--------------------------------------------------------------------------------------
        !picknum = 'FIRST'
        !testce  = !!Mdsreltocomp(!datum, !pick1, !p9dir, !clearance, !form , !picknum, !halfwidth )
--xxxq var !testce

--------------------------------------------------------------------------------------

        if (!testce[1].upcase() eq 'UNSET')then
          !!alert.error('Identified element is unsuitable to support from.')
          golabel /Element1
        elseif (!testce[1].upcase() eq '')then
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'LOWER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Framework.')
-- Ask if USER wants to Identify another Element
            golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'UPPER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'DIAMETER')then
          !!alert.error('Identified Cylinder is NOT of Sufficient Diameter to Support the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'WIDTH')then
          !!alert.error('Identified Panel will NOT Support the Framework along its Width ')
-- Ask if USER to Identify Panel again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'OK')then
-- Set ANY data as a Single Element is OK to Support Framework/Pipe-Shoes
          !vessenddir = !p9dir
          var !op9dir cons dir pin 9 to pin 2
          !freeenddir = !op9dir.direction()
        endif

--------------------------------------------------------------------------------------
-- Check Distance from  Face of Vessel Cylinder or Panel to 'P0' of Datum Atta is
-- GREATER than the Distance from 'P0' of the Datum Atta to the Outside of the INSIDE
-- Cross Tie Angle of the Framework, ie. '/<struname>-TIE-2'

      if (!pin2pin9dist.lt(!halftie + !overlap)) then
        !!alert.error('Insufficent Space between the Pipe and the Identified ''$!pick1.fulltype'' to build the Framework')
        golabel /Element1
      endif

--------------------------------------------------------------------------------------
-- Carry On Building Support Framework Attached to a Single Element
--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Position Pins for Pick1
      !!ce = !pick1

--------------------------------------------------------------------------------------
--################################## PANELS ##################################
--------------------------------------------------------------------------------------
      if (!pick1.hardtype eq 'PANE') then
-- Pins are in Position Relative to the 'FIRST' Panel Pick

        !!ce = !datum
-- Position Pins 1, 2 and 3 in the Correct Directions
        pin 1 copy p10 of $!datum
        pin 1 at $!datum
        pin 2 copy p11 of $!datum
        pin 2 at $!datum
        pin 3 copy p9 of $!datum
        pin 3 dir to p0 of $!datum
        pin 3 at $!datum
-- Position Pins
        pin 1 dist $!halfwidth
        pin 2 dist $!halfwidth
        pin 3 dist $!halftie

        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p9 of $!datum
        pin 5 copy p9 of $!datum
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy pin 3
        pin 9 at $!datum
        pin 9 plane pin 9 clear 0 beh $!pick1
        var !pin9pos pin 9 pos wrt /*

-- Dimension1(Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Cross Bar(s) and Panel)
        !dim1 = !!KStrReal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Panel
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Panel has been Identified
        pin 8 copy pin 3
        pin 8 at $!datum
        pin 8 plane pin 8 clear 0 beh $!pick1
        pin 10 copy pin 8
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10
        var !pin8pos pin 8 pos wrt /*

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Panel
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1, *-BAR-2'
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly -- see above

--------------------------------------------------------------------------------------
--################################## CYLINDERS ##################################
--------------------------------------------------------------------------------------
      elseif (!pick1.type eq 'CYLI') then

-- Pins are in Position Relative to the 'FIRST' Cylinder Pick

        !!ce = !datum
-- Position Pins 1, 2 and 3 in the Correct Directions
        pin 1 copy p10 of $!datum
        pin 1 at $!datum
        pin 2 copy p11 of $!datum
        pin 2 at $!datum
        pin 3 copy p9 of $!datum
        pin 3 dir to p0 of $!datum
        pin 3 at $!datum
-- Position Pins
        pin 1 dist $!halfwidth
        pin 2 dist $!halfwidth
        pin 3 dist $!halftie

        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p9 of $!datum
        pin 5 copy p9 of $!datum
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy pin 3
        pin 9 at $!datum
        pin 9 plane pin 9 thro pin 10

-- Calculate Pin 9 position to construct line
        !asqre = !pin9pin10dist.power(2) - !halfwidth.power(2)
        !adist = !asqre.sqrt()
        pin 9 dist $!adist
        var !pin9pos pin 9 pos wrt /*
-- Dimension1 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Cross Bar(s) and Cylinder Diameter)
        !dim1 = !!KStrReal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Cylinder
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Cylinder has been Identified
        pin 8 copy pin 3
        pin 9 at $!datum
        pin 8 plane pin 8 thro p0 of $!pick1
        pin 10 copy pin 8
        pin 10 at $!pick1
        pin 8 plane pin 8 clear 0 beh $!pick1
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10

-- Calculate Pin 8 position to construct line
        !bsqre = !pin8pin10dist.power(2) - !halfwidth.power(2)
        !bdist = !bsqre.sqrt()
        pin 8 dist $!bdist
        var !pin8pos pin 8 pos wrt /*

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Cylinder
-- and behind the Trunnion ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1, *-BAR-2'
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly --

      endif


--------------------------------------------------------------------------------------
-- Set Rotation to '0' for CURSOR mode
      -- !!Mdsvt04.rotan.val = '0'
      !support.rotated     = 0

--------------------------------------------------------------------------------
    elseif (!Method eq |DIMENSION|)then
--------------------------------------------------------------------------------
--################################## DIMENSION ##################################
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Create  Framework by Dimensions

-- Initialise variables for dimension check
      !d1 = !!Mdsvt04.dim1.val
      !d2 = !!Mdsvt04.dim2.val

      if (!d1.eq(0) or !d2.eq(0)) then
        !!alert.error('Not all of the dimensions have been completed.')
        !!kRestoreUnits(!currentunits)
        return
      endif

      if (!d2.gt(!d1)) then
        !!alert.error('Cannot create from given dimensions. Dim 2 must be less that Dim 1.')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Check Distance Dimension -'Dim 1' is GREATER than the Distance '!halftie + !overlap' which is the Minimum
-- Distance from the 'P0' of the Datum Atta to the Outside Edge of the Inside Cross Tie Angle of thei
-- Framework, ie. '/<struname>-TIE-2'

      if (!d1.lt(!halftie + !overlap)) then
        !!kformattext.text.val = !halftie + !overlap
         !FDisp = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!alert.error('The Dimension - ** Dim 1 ** - must be a Minimum of ' & $
                      !FDisp & ' for the Current Pipe Size.')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Get Atta Orientation
      !vessenddir  = !p9dir
      var !op9dir cons dir p9 of $!datum to p0 of $!datum
      !freeenddir = !op9dir.direction()

--------------------------------------------------------------------------------------
-- Position pins
      !!ce = !datum
-- Position Pins 1, 2 and 3 in the Correct Directions
      pin 1 copy p10 of $!datum
      pin 1 at $!datum
      pin 2 copy p11 of $!datum
      pin 2 at $!datum
      pin 3 copy p9 of $!datum
      pin 3 dir to p0 of $!datum
      pin 3 at $!datum
-- Position Pins
      pin 1 dist $!halfwidth
      pin 2 dist $!halfwidth
      pin 3 dist $!halftie

      var !pin1dir pin 1 dir wrt /*
      var !pin2dir pin 2 dir wrt /*
      var !pin3dir pin 3 dir wrt /*

      pin 4 copy p9 of $!datum
      pin 4 at pin 1
      pin 5 copy p9 of $!datum
      pin 5 at pin 2

-- Position Pins 4 and 5 for Top Cross Bars
      pin 4 dist $!!Mdsvt04.dim1.val
      pin 5 dist $!!Mdsvt04.dim1.val

-- Get Position on Atta CL Distance 'Dim 1' from Atta
      pin 9 copy p9 of $!datum
      pin 9 at $!datum
      pin 9 dist $!!Mdsvt04.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

--------------------------------------------------------------------------------------
-- Get Position on Atta CL Distance 'Dim 1' from Atta
      pin 9 copy p10 of $!datum
      pin 9 dist $!!Mdsvt04.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

-- Position Pins 6 and 9 for Vertical Bracings
      pin 6 copy pin 4
      pin 6 at pin 1
      pin 9 copy pin 5
      pin 9 at pin 2

--------------------------------------------------------------------------------------
-- Construct Lines
      var !line1 cons line pin 1
      var !line4 cons line pin 4
      var !line5 cons line pin 5
      var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

    endif

----------------------------------------------------------------------
-- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
-- and the Type and Size of the Packing Pieces to Recreate
    !attapp = !!Mdspackers(!support)

----------------------------------------------------------------------
-- Navigate to Stru
    !!ce = !stru

-- Pins now in position create Framework
    delete stru mem
      handle (41,66) (2,113) (2,113)
      endhandle

--<wd>oct2000
    !mdstemp = /MDS/VT04/$!Selection
    :mdscheck $!mdstemp.:mdscheck
--<wd>oct2000


-- Temporarily Position Structure at Datum Atta
    at $!datum

    new frmw $!name/MAIN
    !frmwsupport = !!ce

-- Copy required template/s
    !!ce         = /MDS/VT04/$!selection
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')

--------------------------------------------------------------------------------------
-- Navigate back to support and create template elements
    !!ce = !frmwsupport
    copy attrib of $!frmw[1]
    copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition

    !desc = desc of /MDS/VT04/$!Selection

-- Position and Orientate Structure
    !!ce = !stru
    desc '$!Desc'


    move $!ddir thro p9 of $!datum
    !orix = !freeenddir
    !oriz = !udir
    ori x is $!orix and z is $!oriz

--------------------------------------------------------------------------------------
-- Extend and move Cross Bar *-BAR-1
    !!ce = $!<name>-BAR-1
--> Modified -<wd>- 14oct1998
    if (!pldir.up.eq(1)) then
      extend start thro pin 3
      extend end thro pin 4
      !Flush = :MDSOlap
      if !Flush eq 'OVERLAP' then
        !ONum = :MDSOnum
        extend start $!ONum
      endif

    elseif (!pldir.up.eq(-1)) then
      extend start thro pin 4
      extend end thro pin 3
      !Flush = :MDSOlap
      if !Flush eq 'OVERLAP' then
        !ONum = :MDSOnum
        extend end $!ONum
      endif
    endif
    move $!pin1dir wrt /* clear 0 inf pin 1
--< Modified -<wd>- 14oct1998

-- Extend and move Cross Bar *-BAR-2
    !!ce = $!<name>-BAR-2
--> Modified -<wd>- 14oct1998
    if (!pldir.up.eq(1)) then
      extend start thro pin 3
      extend end thro pin 5
      !Flush = :MDSOlap
      if !Flush eq 'OVERLAP' then
        !ONum = :MDSOnum
        extend start $!ONum
      endif
    elseif (!pldir.up.eq(-1)) then
      extend start thro pin 5
      extend end thro pin 3
      !Flush = :MDSOlap
      if !Flush eq 'OVERLAP' then
        !ONum = :MDSOnum
        extend end $!ONum
      endif
    endif
    move $!pin2dir wrt /* clear 0 inf pin 2
--< Modified -<wd>- 14oct1998

-- Extend and move Cross Bars Tie *-TIE-1
    !!ce = $!<name>-TIE-1
--> Modified -<wd>- 14oct1998
    if (!pldir.up.eq(1)) then
      extend start thro pin 2
      extend end thro pin 1
      !Flush = :MDSOlap
    elseif (!pldir.up.eq(-1)) then
      extend start thro pin 1
      extend end thro pin 2
      !Flush = :MDSOlap
    endif
    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      extend start $!ONum
      extend end $!ONum
    endif
--< Modified -<wd>- 14oct1998
    !p0datumpin3 = !!KStrReal('const dist p0 of $!datum to pin 3  ')
    pin 4 copy pin 3
    pin 4 dir $!vessenddir
    pin 4 at $!datum
    pin 4 dist $!p0datumpin3
    move $!vessenddir clear 0 beh pin 3

-- Extend and move Cross Bars Tie *-TIE-2
    !!ce = $!<name>-TIE-2
--> Modified -<wd>- 14oct1998
    if (!pldir.up.eq(1)) then
      extend start thro pin 1
      extend end thro pin 2
    elseif (!pldir.up.eq(-1)) then
      extend start thro pin 2
      extend end thro pin 1
    endif
    if !Flush eq 'OVERLAP' then
      !ONum = :MDSOnum
      extend start $!ONum
      extend end $!ONum
    endif
--< Modified -<wd>- 14oct1998
    move $!freeenddir clear 0 beh pin 4

--------------------------------------------------------------------------------------
-- Set dimensions
--------------------------------------------------------------------------------
--################################## CURSOR ##################################
--------------------------------------------------------------------------------
    if (!Method eq |CURSOR|)then

-- Dimension 1

      !!Mdsvt04.dim1.val = !dim1.nint()
-- Dimension 2
-- Is Already Set to Determine the !halfwidth structure
--xxx      !!Mdsvt04.Dim2.Val = !Dim2
    endif

--------------------------------------------------------------------------------------
-- Select correct spref
    !!ce = $!<name>/SREF
    !!MdsDacControl(true)
    sel spref with styp 'VT04' spec /MDF

    !!MdsSetIspe()

    var !tube (lstu of $!Datum )
      handle (2,470) (2,113)
        var !tube (hstu of bran)
      endhandle

    if (!tube.unset())then
      lstu $!tube
    else
      !!MdsSelLstu(!!CE)
    endif
    !!MdsDacControl(false)
--------------------------------------------------------------------------------------
    !!ce = !stru
-- Associate attas to bar
    !list = !support.Bars[1]
    !references = ''
    do !I indices !list
      !references = !references & ' ' & !list[!I].string()
    enddo

-- Set atta references to datum cross bar
    !!ce = $!<name>-BAR-1
    :MDSAttaRef $!references
    !support.barlen[1] = deri length of ce

--------------------------------------------------------------------------------------
-- Store dimensions in design parameters
    !!ce = $!<name>/SREF


    !!MdsDacControl(true)
    despar  $!!Mdsvt04.dim1.val  $!!Mdsvt04.dim2.val
    !!MdsDacControl(false)

  -- Reset materials of sections

    !!MdsResetMat(!StoreMat)


--------------------------------------------------------------------------------------
-- Navigate to Structure
    !!ce = !stru

-- Set 'FT25' form Support Object to be the same as 'VT04' form Support Object
    !!Mdsft25.support = !support

-- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
-- During the Framework Creation above
    !!Mdsft25.support.packs.clear()
    !support.packs.clear()

-- Create Required Packing Pieces(SCTNs) at the Necessary Attas
    call !!Mdscrpacksft25(!attapp, !!Mdsvt04)

-- Update 'VT04' support.packs data to that held in form 'FT25'
    !support.packs = !!Mdsft25.support.packs

-- Navigate to Main Structure of Framework
    !!ce = !stru

-- If a joint is being used and it is handed then their will be a alternative spref of the
-- opposite hand joint

    -- !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

-- Reset the zdist for all joints

   var !Sjois coll all sjoi for $!Name

   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     snod
     zdist thro cref of same
   enddo


----------------------------------------------------------------------
-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.append(!!ce)
    !colourlist.appendarray(!support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Reset all pins associated with this support
    call !!Mdsresetpins(1,10)

-- Update support data held in form
    !!Mdsvt04.support = !support

--------------------------------------------------------------------------------------
-- Remove Wait.. Prompt from Screen
    !!Mdscreatemess(false)

--------------------------------------------------------------------------------------

-- Reset Units

   !!kRestoreUnits(!currentunits)

  endfunction
-- End function

-- End of file Mdscreatevt04.pml
