--------------------------------------------------------------------------------
--
-- File:                Mdscreatevt05.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MVS101
--
-- Author:              Andrew Kirkland
-- Created:             Wednesday 6th May 1998
--
--
-- Description:
-- function to create Vessel support frame type 'VT05'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscreatevt05(!method is string)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

-- Initialise variables
    call !!Mdsresetpins(1,10)
    !form      = !!MdsVT05
    !idtype    = 'PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL CYLI'
    !support   = !!Mdsvt05.support
    !clearance = !!Mdsoptions.clear.val
    !overlap   = !!Mdsoptions.overlap.val
    -- !selection = !!Mdsvt05.size.selection('rtext')
    !Selection = !!MdsSetSteel.Size.Selection('Rtext')
    !datum     = !support.datum
    !stru      = !support.stru
    !name      = !stru.name
    !p9dir     = !support.p9dir
    !p10dir    = !support.p10dir
    !p11dir    = !support.p11dir
    !pldir     = !support.pldir
    !padir     = !support.padir

--------------------------------------------------------------------------------
-- Check that Datum atta has been created
    if (!datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
        return
    endif

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

-- Check that Datum atta has been positioned
    if (!support.position.not())then
      !!alert.message('Position atta before Identifying supporting element')
      !!kRestoreUnits(!currentunits)
        return
    endif

-- Check which attas to work from
    !atta = !support.bars[1]

--------------------------------------------------------------------------------
-- Set orientation - 'VT05' is  Only Allowed on Vertical Pipes
    !ddir = D wrt world
    !udir = U wrt world
-- Get original ORI for Datum Atta
    !!ce       = !datum
    !oridatum  = ori wrt /*


      !pipodia   = !datum.catref.param[3]
      !plateWidth   = !datum.desp[3]

-- Minimum Distance Required Between Pipe and Identified Element (estimated attwice the lug length

    !mindist  = (!Datum.desp[1] * 2 )

-- Navigate to Template  Member '*-BAR-1'
-- Determine the Main Channel Cross Bar Depth
  !!ce = /MDS/$!<support.type>/$!<selection>-BAR-1

--xxx
    pin 1 at ce
    pin 2 copy pin 1
    pin 2 dir n wrt /*
    pin 1 dir s wrt /*
    pin 2 plane pin 2 clear 0 beh ce
    pin 1 plane pin 1 clear 0 beh ce

    !widt = !!kstrreal('cons dist pin 1 to plane pin 2')

-- Half Width of Vessel Framework Structure
    !calcwidth =  !plateWidth / 2   + !widt
    !halfwidth = !calcwidth.nint()

-- Store section name and matref for each member
-- for reseting later

    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)


--------------------------------------------------------------------------------
-- Generate pin positions for each creation type
--------------------------------------------------------------------------------

    if (!method eq |CURSOR|) then
-- Create Framework by Cursor
--------------------------------------------------------------------------------

-- Identify the Higher Element First and Check if Framework Cross Bars and Lower
-- Bracings will Fit and/or Intersect Higher Element with the correct Clearance

    label /Element1

      !!ce = !datum
      ori $!oridatum
      prompt off
      prompt load escape |Identify element to support from|
      id $!idtype @
        handle (61,528)
          prompt on
          !!ce = !datum
          ori $!oridatum
          !!ce = !stru
          !!kRestoreUnits(!currentunits)
        return
        endhandle
      prompt dismiss
      prompt on

      !pick1 = !!ce
      !picknum = 'FIRST'

--------------------------------------------------------------------------------------

-- Orientate atta relative to the Identified Element Type

--------------------------------------------------------------------------------------
      if (!pick1.type.string().eq('CYLI')) then
        !cyldir = p0 dir of $!pick1 wrt /*
--------------------------------------------------------------------------------------
        if (!cyldir eq U or !cyldir eq D) then
          pin 1 copy p1 of $!datum
          pin 2 copy p2 of $!datum
          pin 2 plane pin 2 thro p0 of $!pick1
          pin 2 dir to p0 of $!pick1
          pin 10 copy pin 2
          pin 10 plane pin 10 thro p0 of $!pick1
          pin 10 dir to pin 2
          pin 9 copy pin 10
          pin 9 plane pin 9 clear 0 beh $!pick1
          pin 8 copy pin 9
          pin 8 dir $!ddir
          pin 7 copy pin 8
          pin 7 dir $!ddir
          pin 8 plane pin 8 clear 0 inf $!pick1
          pin 7 plane pin 7 clear 0 beh $!pick1
          var !pin2dir pin 2 dir wrt /*
          !pin2pin9dist = !!KStrReal('const dist pin 2 to plane pin 9')
          !pin9pin10dist = !!KStrReal('const dist pin 9 to plane pin 10')

-- Orientate Atta and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Cylinder
          !!ce = !datum
          ori and p3 is $!pin2dir wrt /*
          !!ce = $!<name>/SREF
          ori and p3 is $!pin2dir wrt /*
          !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
          !support.p10dir = p10 dir of $!datum wrt /*
          !p10dir         = !support.p10dir
          !support.p11dir = p11 dir of $!datum wrt /*
          !p11dir         = !support.p11dir

        else

          !!alert.error('If this framework type is to be attached to a Vessel it may only be supported from a VERTICAL Vessel')
          golabel /Element1
        endif
--------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------

      else

        if (!pick1.hardtype.string().eq('PANE')) then
          !panlori  = ori of $!pick1 wrt /*
          !panlxdir = !panlori.xdir()
          !panlydir = !panlori.ydir()
          !panlzdir = !panlori.zdir()

-- Check if Panel is Vertical ie. Wall
--------------------------------------------------------------------------------------
          if (!panlydir.up.abs() eq 1 or !panlxdir.up.abs() eq 1) then
            pin 1 at $!pick1
            pin 1 dir $!panlzdir
            pin 2 copy pin 1
            pin 2 at $!datum
            pin 10 copy pin 2
            pin 10 plane pin 10 thro pin 1
            pin 2 dir to pin 10
            var !pin2dir pin 2 dir wrt /*
            pin 9 copy pin 2
            pin 9 plane pin 9 clear 0 inf $!pick1
            !pin2pin9dist = !!KStrReal('const dist pin 2 to plane pin 9')

--------------------------------------------------------------------------------------
            if (!panlydir.up eq 1) then
-- Ydir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlydir.up eq -1) then
-- Ydir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlxdir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlydir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            elseif (!panlxdir.up eq 1) then
-- Xdir is UP wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 inf $!pick1
              pin 8 plane pin 8 clear 0 beh $!pick1

            elseif (!panlxdir.up eq -1) then
-- Xdir is DOWN wrt /*
              pin 5 copy pin 1
              pin 5 dir $!panlydir
              pin 6 copy pin 5
              pin 5 plane pin 5 clear 0 inf $!pick1
              pin 6 plane pin 6 clear 0 beh $!pick1
              pin 7 copy pin 1
              pin 7 dir $!panlxdir
              pin 8 copy pin 7
              pin 7 plane pin 7 clear 0 beh $!pick1
              pin 8 plane pin 8 clear 0 inf $!pick1

            endif
--------------------------------------------------------------------------------------

-- Orientate Atta and Determine
-- Dimension1 - CL of Atta to 'Normal' Face of Vertical Panel
            !!ce = !datum
            ori and p10 is $!pin2dir wrt /*
            !!ce = !pick1

-- Modify '.Support' Object Members to Reflect New Orientation
-- of the Datum Atta
            !support.p10dir = p10 dir of $!datum wrt /*
            !p10dir         = !support.p10dir
            !support.p11dir = p11 dir of $!datum wrt /*
            !p11dir         = !support.p11dir

          else

            !!alert.error('If this framework type is to be attached to a Panel it may only be supported from a VERTICAL Panel')
            golabel /Element1

          endif
--------------------------------------------------------------------------------------

        endif
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
      endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Determine if Identified element is suitable to support from
      !single = FALSE

--------------------------------------------------------------------------------------
        !picknum = 'FIRST'
        !testce  = !!Mdsreltocomp(!datum, !pick1, !p10dir, !clearance, !form , !picknum, !halfwidth )


--------------------------------------------------------------------------------------
       if (!testce[1].upcase() eq 'UNSET')then
          !!alert.error('Identified element is unsuitable to support from.')
          golabel /Element1
        elseif (!testce[1].upcase() eq '')then
          golabel /Element1
--------------------------------------------------------------------------------------

        elseif (!testce[1].upcase() eq 'LOWER')then
-- Ask if USER wants to Identify a LOWER Cylinder to BRACE From
          if (!!alert.confirm('Identified element is NOT suitable for Bracing the Framework.  Do You want to Support the Bracing off a LOWER $!pick1.fulltype') eq 'NO') then
            golabel /Element1
          else
            !single     = FALSE
            !vessenddir = !p10dir
            !freeenddir = !p11dir
            golabel /Element2
          endif

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'UPPER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Top Members of the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'DIAMETER')then
          !!alert.error('Identified Cylinder is NOT of Sufficient Diameter to Support the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'WIDTH')then
          !!alert.error('Identified Panel will NOT Support the Framework along its Width ')
-- Ask if USER to Identify Panel again
          golabel /Element1

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'OK')then

-- Check Distance from  Face of Vessel Cylinder or Panel to 'P0' of Datum Atta is
-- GREATER than the Distance from 'P0' of the Datum Atta to the Outside of the INSIDE
-- Cross Tie Angle of the Framework, ie. '/<struname>-TIE-2'

          if (!pin2pin9dist.lt(!mindist)) then
            !!alert.error('Insufficent Space between the Pipe and the Identified ''$!pick1.fulltype'' to build the Framework')
            golabel /Element1
          endif

-- Set ANY data as a Single Element is OK to Support Framework/Atta
          !single  = TRUE
          !vessenddir = !p10dir
          !freeenddir = !p11dir
          golabel /Single

        endif

--------------------------------------------------------------------------------------

-- Identify Second Element if Required and Check its Suitability

      label /Element2
      if (!single.not()) then

        !picknum = 'SECOND'
        prompt off
        prompt load escape |Identify SECOND element to Support BRACING from|
        id $!idtype @
        handle (61,528)
          prompt on
          !!ce = !stru
          !!kRestoreUnits(!currentunits)
        return
        endhandle
        prompt dismiss
        prompt on

        !pick2 = !!ce

-- Check Both Picked Elements are of the Same Type
        if (!pick2.type neq !pick1.type) then
          !!alert.error('The SECOND Identified element type MUST be the same type as the FIRST element')
          golabel /Element2
        endif

        if (!pick2.type eq 'CYLI') then
          !nam1  = namn of equipment of $!pick1
          !nam2  = namn of equipment of $!pick2
          if (!nam1 neq !nam2) then
            !!alert.error('The SECOND element MUST belong to the same VERTICAL Vessel')
            golabel /Element2
          endif
        else
          !nam1  = namn of structure of $!pick1
          !nam2  = namn of structure of $!pick2
          if (!nam1 neq !nam2) then
            !!alert.error('The SECOND element MUST belong to the same STRUCTURE')
            golabel /Element2
          endif
        endif

        !pick2 = !!ce
        !picknum = 'SECOND'
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

        if (!pick2.type.string().eq('CYLI')) then
          !cyl2dir = p0 dir of $!pick2 wrt /*
          if (!cyl2dir eq U or !cyl2dir eq D) then
-- Position Pins On 'SECOND' Pick for 'Vertical Bracing'
            pin 2 copy p2 of $!datum
            pin 2 plane pin 2 thro p0 of $!pick2
            pin 2 dir to p0 of $!pick2
            pin 3 copy pin 2
            pin 3 plane pin 3 thro p0 of $!pick2
            pin 3 dir to pin 2
            pin 4 copy pin 3
            pin 4 plane pin 4 clear 0 beh $!pick2
            pin 8 copy pin 4
            pin 8 dir $!ddir
            pin 8 plane pin 8 clear 0 beh $!pick2

            var !pin2dir pin 2 dir wrt /*
            !pin3pin4dist = !!KStrReal('const dist pin 3 to plane pin 4')

          else
            !!alert.error('If this framework type is to be attached to a Vessel it may only be supported from a VERTICAL Vessel')
            golabel /Element2
          endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
        else
-- For Panels  - atta p10/p11 must be 'Parallel' to the Identified Element
-------------------------------------------------------------------------------------------

          if (!pick2.hardtype.string().eq('PANE')) then
            !panlori  = ori of $!pick2 wrt /*
            !panlxdir = !panlori.xdir()
            !panlydir = !panlori.ydir()
            !panlzdir = !panlori.zdir()

-- Check if Panel is Vertical ie. Wall
            if (!panlydir.up.abs() eq 1 or !panlxdir.up.abs() eq 1) then
              pin 1 at $!pick2
              pin 1 dir $!panlzdir
              pin 2 copy pin 1
              pin 2 at $!datum
              pin 10 copy pin 2
              pin 10 plane pin 10 thro pin 1
              pin 2 dir to pin 10
              var !pin2dir pin 2 dir wrt /*
              pin 9 copy pin 2
              pin 9 plane pin 9 clear 0 inf $!pick2
              pin 4 copy pin 2
              pin 4 plane pin 4 clear 0 inf $!pick2

-- Position Pins 5 and 6 on the Vertical Edges of the SECOND Panel
-- Position Pin 8 at Bottom of SECOND Panel

              if (!panlydir.up eq 1) then
-- Ydir is UP wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlxdir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlydir
                pin 8 plane pin 8 clear 0 inf $!pick2

              elseif (!panlydir.up eq -1) then
-- Ydir is DOWN wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlxdir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlydir
                pin 8 plane pin 8 clear 0 beh $!pick2

              elseif (!panlxdir.up eq 1) then
-- Xdir is UP wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlydir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlxdir
                pin 8 plane pin 8 clear 0 inf $!pick2

              elseif (!panlxdir.up eq -1) then
-- Xdir is DOWN wrt /*
                pin 5 copy pin 1
                pin 5 dir $!panlydir
                pin 6 copy pin 5
                pin 5 plane pin 5 clear 0 inf $!pick2
                pin 6 plane pin 6 clear 0 beh $!pick2
                pin 8 copy pin 1
                pin 8 dir $!panlxdir
                pin 8 plane pin 8 clear 0 beh $!pick2

              endif

            else

              !!alert.error('If this framework type is to be attached to a Panel it may only be supported from a VERTICAL Panel')
              golabel /Element2

            endif

          endif

        endif

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
        !testce  = !!Mdsreltocomp(!datum, !pick2, !p10dir, !clearance, !form , !picknum, !halfwidth )

        if (!testce[1].upcase() eq 'UNSET')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework.')
          golabel /Element2
        elseif (!testce[1].upcase() eq '')then
          golabel /Element2
-------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'DIAMETER')then
          !!alert.error('Identified Cylinder is NOT of Sufficient Diameter to Support the Bracing of the Framework ')
-- Ask if USER to Identify Cylinder again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'WIDTH')then
          !!alert.error('Identified Panel will NOT Support the Framework along its Width ')
-- Ask if USER to Identify Panel again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'LOWER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework.')
-- Ask if USER to Identify Element again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'UPPER')then
          !!alert.error('Identified element is NOT suitable for Supporting the Bracing of the Framework ')
-- Ask if USER to Identify Element again
          golabel /Element2

--------------------------------------------------------------------------------------
        elseif (!testce[1].upcase() eq 'OK')then
-- Set ANY data as the LOWER Element is OK to Support the Bracing of The Framework
          !single     = FALSE
          !vessenddir = !p10dir
          !freeenddir = !p11dir
        endif

--------------------------------------------------------------------------------------
-- end of if(!single.not()) - BLOCK at line 355
      endif
--------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------
-- Carry On Building Support Framework Attached to a Single Element
-- Set !pick2 to be the same as !pick1 if the Whole Framework
-- will fit onto a Single Element
    label /Single
      if (!single) then
        !pick2 = !pick1
      endif

--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Position Pins for Pick1 and Pick2 if required
      !!ce = !pick1

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
      if (!pick1.hardtype eq 'PANE') then
-- Pins are in Position Relative to the 'FIRST' Panel Pick

        !!ce = !datum
        !Clearance = !datum.desp[4]
-- Temporarily orientate atta to Position Pins 1 and 2 in the Correct Directions
        rotate by 90
        pin 1 copy p10 of $!datum
        pin 2 copy p11 of $!datum
-- Put Atta Back to the Correct Ori
        rotate by -90
        !p10dir =  p10 dir of $!datum wrt /*
        pin 3 copy p10 of $!datum
-- Position Pins
          pin 1 plane pin 1 thro $!datum
          pin 1 dist ($!datum.desp[3] / 2)
          pin 2 plane pin 2 thro $!datum
          pin 2 dist ($!datum.desp[3] / 2)

-- position pin for clearance of bar-1

        pin 3 dist $!Clearance
        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p10
        pin 5 copy p10
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy p11 of $!datum
        pin 9 plane pin 9 clear 0 beh $!pick1
        var !pin9pos pin 9 pos wrt /*

-- Dimension1(Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Cross Bar(s) and Panel)
        !dim1 = !!KStrReal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Panel
-- and behind the Atta ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Panel has been Identified
-- If a SECOND Panel is NOT Required then !pick2 is set to !pick1 - See Above
        pin 8 copy p11 of $!datum
        pin 8 plane pin 8 clear 0 beh $!pick2
        pin 10 copy pin 8
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10
        var !pin8pos pin 8 pos wrt /*

-- Dimension3 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Vertical Bracing(s) and Panel)
        !dim2 = !!KStrReal('const dist p0 of $!datum to plane pin 8 ')

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Panel
-- and behind the Atta ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1,
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*
-- Attached to Vessel End of Framework - pin 8 and pin 9 - for Vertical Bracings '*-V1,
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly -- see line 342 above

--------------------------------------------------------------------------------------

      elseif (!pick1.type eq 'CYLI') then

-- Pins are in Position Relative to the 'FIRST' Cylinder Pick

        !!ce = !datum
        !Clearance = !Datum.desp[4]
-- Temporarily orientate Atta to Position Pins 1 and 2 in the Correct Directions
        rotate by 90
        pin 1 copy p10 of $!datum
        pin 2 copy p11 of $!datum
-- Put Atta Back to the Correct Ori
        rotate by -90
        !p10dir =  p10 dir of $!datum wrt /*
        pin 3 copy p10 of $!datum
-- Position Pins
          pin 1 plane pin 1 thro $!datum
          pin 1 dist ($!Datum.desp[3] / 2 )
          pin 2 plane pin 2 thro $!datum
          pin 2 dist ($!datum.desp[3] / 2)

-- position pin for clearance of bar-1 from pipe
        pin 3 dist $!Clearance

        var !pin1dir pin 1 dir wrt /*
        var !pin2dir pin 2 dir wrt /*
        var !pin3dir pin 3 dir wrt /*

        pin 4 copy p10
        pin 5 copy p10
        pin 4 at pin 1
        pin 5 at pin 2

-- Construct Lines
        var !line1 cons line pin 1
        var !line4 cons line pin 4
        var !line5 cons line pin 5
        var !line10 cons line p10

        pin 9 copy p11 of $!datum
        pin 9 plane pin 9 thro pin 10

-- Calculate Pin 9 position to construct line
        !asqre = !pin9pin10dist.power(2) - !halfwidth.power(2)
        !adist = !asqre.sqrt()
        pin 9 dist $!adist
        var !pin9pos pin 9 pos wrt /*
-- Dimension1 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Cross Bar(s) and Cylinder Diameter)
        !dim1 = !!KStrReal('const dist p0 of $!datum to plane pin 9 ')

-- Construct parallel line
        var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'FIRST' Cylinder
-- and behind the Atta ready to determine Section Start and End Positions
        var !line4intline9 cons pos intersect $!line4 wrt /* $!line9 wrt /*
        var !line5intline9 cons pos intersect $!line5 wrt /* $!line9 wrt /*

-- Position Pins for Bottom of Vertical Bracings if 'SECOND' Cylinder has been Identified
        pin 8 copy p11 of $!datum
        pin 8 plane pin 8 thro p0 of $!pick2
        pin 10 copy pin 8
        pin 10 at $!pick2
        pin 8 plane pin 8 clear 0 beh $!pick2
        !pin8pin10dist = !!KStrReal('const dist pin 8 to plane pin 10')
        pin 8 at pin 10

-- Calculate Pin 8 position to construct line
        !bsqre = !pin8pin10dist.power(2) - !halfwidth.power(2)
        !bdist = !bsqre.sqrt()
        pin 8 dist $!bdist
        var !pin8pos pin 8 pos wrt /*
-- Dimension3 (Distance from Datum Atta Origin 'P0' to the Intersection Point of the
--            '!halfwidth' position of Vertical Bracing(s) and Cylinder Diameter)
        !dim2 = !!KStrReal('const dist p0 of $!datum to plane pin 8 ')

-- Construct parallel line
        var !line8 cons line parallel $!line1 wrt /* through $!pin8pos wrt /*

-- Position Pins on Intersection Points of Stru width and Face of 'SECOND' Cylinder
-- and behind the Atta ready to determine Section Start and End Positions
        var !line4intline8 cons pos intersect $!line4 wrt /* $!line8 wrt /*
        var !line5intline8 cons pos intersect $!line5 wrt /* $!line8 wrt /*

-- Attached to Vessel End of Framework - pin 4 and pin 5 - for Top Cross Bars '*-BAR-1,
        pin 4 at $!line4intline9 wrt /*
        pin 5 at $!line5intline9 wrt /*
-- Attached to Vessel End of Framework - pin 8 and pin 9 - for Vertical Bracings '*-V1, *-V2'
        pin 6 copy pin 4
        pin 9 copy pin 5
        pin 6 at $!line4intline8 wrt /*
        pin 9 at $!line5intline8 wrt /*

-- Free End of Framework - pin 3
-- pin 3 ia ALREADY positioned correctly --

--------------------------------------------------------------------------------------
      endif
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------
-- Set Rotation to '0' for CURSOR mode
      -- !!Mdsvt05.rotan.val = '0'
      !support.rotated     = 0

--------------------------------------------------------------------------------
    elseif (!Method eq |DIMENSION|)then
-- Create  Framework by Dimensions

-- Initialise variables for dimension check
      !d1 = !!Mdsvt05.dim1.val

      !d2 = !!Mdsvt05.dim2.val

      if (!d1.eq(0) or !d2.eq(0)) then
        !!alert.error('Not all of the dimensions have been completed.')
        !!kRestoreUnits(!currentunits)
        return
      endif

      if (!d2.gt(!d1)) then
        !!alert.error('Cannot create from given dimensions. Dim 2 must be less that Dim 1.')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Check Distance Dimension -'Dim 1' is GREATER than the Distance '!mindist' which is the Minimum
-- Distance from the 'P0' of the Datum Atta to the Outside Edge of the Inside Cross Tie Angle of the
-- Framework, ie. '/<struname>-TIE-2'
-- ************to look at AK ****************
      !halfpipe = !pipodia / 2

      if (!d1.lt(!mindist)) then
        !!kformattext.text.val = !mindist
        !fmindist = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !!alert.error('The Dimension - ** Dim 1 ** - must be a Minimum of ' & !fmindist & ' $
                       for the Current Pipe Size and the Dimension ** Dim 2 ** shown in the form')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------------
-- Generate Please Wait... Prompt
      !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Get Atta Orientation
      !vessenddir  = !p10dir
      !freeenddir  = !p11dir

--------------------------------------------------------------------------------------
-- Position pins
      !!ce = !datum
        !Clearance = !Datum.desp[4]
-- Temporarily orientate Atta to Position Pins 1 and 2 in the Correct Directions
      rotate by 90
      pin 1 copy p10 of $!datum
      pin 2 copy p11 of $!datum
-- Put Atta Back to the Correct Ori
      rotate by -90
        !p10dir =  p10 dir of $!datum wrt /*
      pin 3 copy p10 of $!datum
-- Position Pins
          pin 1 plane pin 1 thro $!datum
          pin 1 dist ($!datum.desp[3] / 2)
          pin 2 plane pin 2 thro $!datum
          pin 2 dist ($!datum.desp[3] / 2)
--      pin 1 dist $!halfwidth
--      pin 2 dist $!halfwidth
--      pin 3 dist $!halfwidth
      pin 3 dist $!Clearance
      var !pin1dir pin 1 dir wrt /*
      var !pin2dir pin 2 dir wrt /*
      var !pin3dir pin 3 dir wrt /*

      pin 4 copy p10 of $!datum
      pin 4 at pin 1
      pin 5 copy p10 of $!datum
      pin 5 at pin 2

-- Position Pins 4 and 5 for Top Cross Bars
      pin 4 dist $!!Mdsvt05.dim1.val
      pin 5 dist $!!Mdsvt05.dim1.val

-- Get Position on Atta CL Distance 'Dim 1' from Atta
      pin 9 copy p10 of $!datum
      pin 9 dist $!!Mdsvt05.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
-- Get Position on Atta CL Distance 'Dim 3' from Atta
      pin 9 copy p10 of $!datum
      pin 9 dist $!!Mdsvt05.dim1.val
      pin 9 dir $!ddir
      var !pin9pos pin 9 pos wrt /*

-- Position Pins 6 and 9 for Vertical Bracings
--xxx      pin 6 copy pin 4
      pin 6 copy p10 of $!datum
      pin 6 at pin 1
--xxx      pin 9 copy pin 5
      pin 9 copy p10 of $!datum
      pin 9 at pin 2

-- Position Pins 6 and 9 for Top Cross Bars
      pin 6 dist $!!Mdsvt05.dim2.val
      pin 9 dist $!!Mdsvt05.dim2.val
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

-- Construct Lines
      var !line1 cons line pin 1
      var !line4 cons line pin 4
      var !line5 cons line pin 5
      var !line9 cons line parallel $!line1 wrt /* through $!pin9pos wrt /*

--------------------------------------------------------------------------------------
    endif

----------------------------------------------------------------------
-- Create an ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
-- and the Type and Size of the Packing Pieces to Recreate
--    !attapp = !!Mdspackers(!support)

----------------------------------------------------------------------
----------------------------------------------------------------------

-- Navigate to Stru
    !!ce = !stru

-- Pins now in position create Framework
    delete stru mem
      handle (41,66) (2,113) (2,113)
      endhandle

--<wd>oct2000
    !mdstemp = /MDS/VT05/$!Selection
    :mdscheck $!mdstemp.:mdscheck
--<wd>oct2000


-- Temporarily Position Structure at Datum Atta
    at $!datum

    new frmw $!name/MAIN
    !frmwsupport = !!ce

-- Copy required template/s
    !!ce         = /MDS/VT05/$!selection
    !frmw        = !!kcollectallfor('FRMW', '', !!ce)
    !frameformat = before(!frmw[1].name, '-FRMW')

--------------------------------------------------------------------------------------
-- Navigate back to support and create template elements
    !!ce = !frmwsupport
    copy attrib of $!frmw[1]
    copy mem of $!frmw[1] rename $!frameformat $!name

  -- Set stru description for template recognition

    !desc = desc of /MDS/VT05/$!Selection

-- Position and Orientate Structure
    !!ce = !stru
    desc '$!Desc'


--aa    not reqd    move $!ddir thro P$!LowestPpoint of $!datum

    !orix = !freeenddir
    !oriz = !udir
     ori x is $!orix and z is $!oriz

--------------------------------------------------------------------------------------

-- Extend and move Cross Bar *-BAR-1
    !!ce = $!<name>-BAR-1

-- find out how far its moved
    !Posbefore = !!Ce.position.wrt(owner).North
    move $!pin1dir wrt /* clear 0 beh pin 1
    !posafter = !!Ce.position.wrt(owner).North
    !dlen = der len
    extend end thro pin 3
    !elen = der len
    extend start thro pin 5
    !posmoved = !Posafter - !PosBefore

    !Support.Bars.append(!!CE)
    !Support.BarLen[1] = deri length of CE

-- Extend and move Vertical Bracing *-V1
    !!ce = $!<name>-V1
   -- move $!pin2dir wrt /* thro owner
    move $!pin2dir wrt /* dist $!posmoved
    move $!p10dir  dist ($!dlen - $!elen)
    pin 9 dir $!ddir
    var !line9 cons line pin 9
    pin 7 at ppline na start
    pin 8 at ppline na end
    pin 7 dir to pin 8
    pin 8 dir to pin 7
    var !line7 cons line pin 7
    var !line7intline9 cons pos intersect $!line7 wrt /* $!line9 wrt /*
    pin 8 at $!line7intline9 wrt /*
    !drne = drne
    extend end plane $!drne  thro pin 8

      if(!!Mdsvt05.support.mirror) then
         !!CE = !Name.dbref()
         mirror plane n wrt stru thro ce
         !!CE = $!<name>-BAR-1
         flip
         !!CE = $!<name>-V1
         flip
      endif

--------------------------------------------------------------------------------------
-- Set dimensions
    if (!Method eq |CURSOR|)then

-- Dimension 1
      !dimr1 = !dim1.nint()
      !!Mdsvt05.dim1.val = !dimr1
-- Dimension 2
      !dimr2 = !dim2.nint()
      !!Mdsvt05.dim2.val = !dimr2

    endif

--------------------------------------------------------------------------------------
-- Select correct spref
    !!ce = $!<name>/SREF
    !!MdsDacControl(true)
-- Get Bore size in inches
     !units = object COMUNITS(TRUE)
     units inch bores
     !BoreSizeIN = pl bore
       handle any
         !BoreSizeIN = hbor
       endhandle
-- Convert the bore size into a string
     !boresize = !boresizeIN.string().before('in')

    !units.restoreSavedUnitsByPtype('BORE')

    sel spref with styp 'VT05-$!BoreSize-$!selection' spec /MDF

    !!ce = $!<name>/DATUM

    sel spref with styp 'AC17-$!BoreSize-$!selection' spec /MDS
    --sel spref with styp 'VT05' spec /MDF

--<wd>may2003
      !!mdstransport(!!ce,!!ce.name)
--<wd>may2003


    !!ce = $!<name>/SREF
    !!MdsSetIspe()

    !!MdsSelLstu(!!CE)
    !!MdsDacControl(false)

-- Store dimensions in design parameters
    !!ce = $!<name>/SREF
    !!MdsDacControl(true)
    despar $!!Mdsvt05.dim1.val  $!!Mdsvt05.dim2.val
    !!MdsDacControl(false)
  -- Reset materials of sections

    !!MdsResetMat(!StoreMat)

-- If a joint is being used and it is handed then their will be a alternative spref of the
-- opposite hand joint

    -- !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

-- Reset the zdist for all joints

   var !Sjois coll all sjoi for $!Name

   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     snod
     zdist thro cref of same
   enddo


--------------------------------------------------------------------------------------
-- Navigate to Structure
    !!ce = !stru
----------------------------------------------------------------------

-- Enhance elements using colour set for highlight
    !colourlist = array()
    !colourlist.append(!!ce)
    !colourlist.appendarray(!support.atta)

-- Colour Support
    call !!kenhancelist(!colourlist)

-- Reset all pins associated with this support
    call !!Mdsresetpins(1,10)

-- Update support data held in form
    !!Mdsvt05.support = !support

--------------------------------------------------------------------------------------
-- Remove Wait.. Prompt from Screen
    !!Mdscreatemess(false)


-- Reset Units
   !!kRestoreUnits(!currentunits)

--------------------------------------------------------------------------------------
  endfunction
-- End function

-- End of file Mdscreatevt05.pml
