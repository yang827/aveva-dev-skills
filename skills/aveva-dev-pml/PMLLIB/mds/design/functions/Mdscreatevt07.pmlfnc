--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt07.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'VT07'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt07(!dummyMethod is STRING)

  -- Save current db position

  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsVT07
  !support   = !!mdsVT07.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false


  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if (!support.datum.badref().not()) then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if (!!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not()) then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify both brackets on equipment

  label /Element1

  prompt off
  prompt load escape |Identify first support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box1 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle


  label /Element2

  prompt off
  prompt load escape |Identify second support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box2 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip2 = !!ce
  endhandle

  -- Are the two brackets identified the same

  if (!box1.name.eq(!box2.name)) then
    !!alert.error('Identified boxes are the same. Please retry')
    golabel /Element1
  endif

  -- The boxes must be owned by the same equipment

  if (!equip1.name.neq(!equip2.name)) then
    !!alert.error('Identified boxes not owned by the same equipment. Aborting!')
    return
  endif

  label /Element3

  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element3
  elsehandle none
    !equip3 = !!ce
  endhandle

  -- Is the identified cyli owned by the same piece of equipment

  if (!equip1.name.neq(!equip3.name)) then
    !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
    return
  endif

  -- Identify lug or dummy leg

  label /Atta

  prompt off
  if (!!mdsVT07.lug.val) then
    prompt load escape |Identify Lug|
    id atta @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
  else
    prompt load escape |Identify First Dummy Leg|
    id bran @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
  endif
  prompt dismiss
  prompt on

  !atta = !!ce


  -- Identify second dummy branch

  label /Atta1

  if (!!mdsVT07.lug.val.not()) then

    prompt off
    prompt load escape |Identify Second Dummy Leg|
    id bran @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    prompt dismiss
    prompt on

    !atta1 = !!ce

  endif


  -- Check if lug or dummy leg

  if (!!mdsVT07.lug.val) then
    !!ce = !atta

    -->>>-<wd>aug2002
    -- Check if RPAD atta exists for the Support LUG, and/or has been identified
    !attaname = !!ce.name
    if (!attaname.match('.1').gt(1)) then
      -- RPad Atta has been identified
      !lugName = !attaname.before('.1')
      !atta    = !lugName.dbref()
      !padName = !attaname
      !padatta = !padName.dbref()
      -- Navigate to the Lug Atta
      !!ce = !atta
    else
      -- Support Lug Atta has been identified
      !lugName = !attaname
      !padName = !attaname & '.1'
      !padatta = !padName.dbref()
      handle (2,109)
        -- Undefined Name - RPad Atta Does NOT Exist for the Identified Support Lug
      endhandle
    endif
    --<<<-<wd>aug2002

    !lugStyp = !!ce.styp

    if (!!mdsVT07.support.type.eq('VT07') or !!mdsVT07.support.type.eq('VT09')) then
      if (!lugStyp.match('LT03').eq(0)) then
        !!alert.error('Incorrect type of lug identified')
        return
      endif
    else
      if (!lugStyp.match('LT03').eq(0) and !lugStyp.match('LT04').eq(0)) then
        !!alert.error('Incorrect type of lug identified')
        return
      endif
    endif

  else

    !!ce = !atta
    branch
    -- Is it a dummy branch
    if (!!ce.:mdsTrun.not()) then
      !!alert.error('Identified branch is not a dummy leg')
      return
    endif
    -- Find the support name of the branch and access the sref
    !suppNameOfBranch = !!mdsGetSuppName(!!ce)
    !!ce = $!suppNameOfBranch/SREF
    !lugStyp = !!ce.styp
    if (!!mdsVT07.support.type.eq('VT07')) then
      if (!lugStyp.match('TT17').eq(0)) then
        !!alert.error('Incorrect type of dummy leg identified')
        return
      endif
    endif

    !!ce = !atta1
    branch
    -- Is it a dummy branch
    if (!!ce.:mdsTrun.not()) then
      !!alert.error('Identified branch is not a dummy leg')
      return
    endif
    -- Find the support name of the branch and access the sref
    !suppNameOfBranch = !!mdsGetSuppName(!!ce)
    !!ce = $!suppNameOfBranch/SREF
    !lugStyp = !!ce.styp
    if (!!mdsVT07.support.type.eq('VT07')) then
      if (!lugStyp.match('TT17').eq(0)) then
        !!alert.error('Incorrect type of dummy leg identified')
        return
      endif
    endif

  endif

  -- Check if the identified lug is on the same branch as the datum atta

  if (!!mdsVT07.lug.val) then
    !datumBranch = !datum.owner
    !idBranch = !!ce.owner
    if (!datumBranch.neq(!idBranch)) then
      !!alert.error('The identified element is not in the same branch as the datum atta. Aborting creation!')
      return
    endif
  else
    !!ce = !atta
    if (!!ce.lock) then
      unlock all
      !resetLock = true
      !unlocked.append(!!ce)
    endif
    !datumBranch = !datum.owner.owner
    !idBranch = !!ce.owner
    if (!datumBranch.neq(!idBranch)) then
      !!alert.error('The identified element is not in the same pipe as the datum atta. Aborting creation!')
      return
    endif
    !!ce = !atta1
    if (!!ce.lock) then
      unlock all
      !resetLock = true
      !unlocked.append(!!ce)
    endif
    !datumBranch = !datum.owner.owner
    !idBranch = !!ce.owner
    if (!datumBranch.neq(!idBranch)) then
      !!alert.error('The identified element is not in the same pipe as the datum atta. Aborting creation!')
      return
    endif
  endif

  !lug = !!ce

  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- Set elevation to top of bracket

  !!ce = !lug
  -- !!ce = !datum
  if (!!mdsVT07.lug.val) then
    !bore = pa bore
  else
    !bore = ph bore
  endif

  -- Get design parameters
  !!mdsDacControl(true)

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  if (!!mdsVT07.lug.val) then
    pin 9 at ce
  else
    pin 9 at ph
  endif
  pin 9 dir d wrt /*
  pin 9 plane pin 9 clear 0 inf $!box1
  pin 9 dist $!despars[4]
  if (!!mdsVT07.lug.val) then
    -- At the  Support Lug<see line 348 - above>
    thro pin 9
    pos p5 plane pl clear 0 inf pin 9

    -->>>-<wd>aug2002
    -- Locate RPad, if it exists, at the Support Lug
    if (defined(!padatta)) then
      !!ce = !padatta
      at $!atta
      !!ce = !atta
    endif
    --<<<-<wd>aug2002

  else
    pin 9 dist (-$!bore / 2)
    !!ce = !atta
    bran
    goto href
    drag move d wrt /* thro pin 9
    pin 9 dist ($!bore / 2)
  endif
  !!mdsDacControl(true)
  !!ce = !datum
  thro pin 9
  !!ce = !srefName.dbref()
  thro pin 9

  -- Direct lug to identified brackets

  pin 8 at $!box1
  pin 7 at $!box2
  !line = object LINE()
  !line.startPosition = (!box1.pos )
  !line.endPosition = (!box2.pos )

  !midp = !line.proportion(0.5)
  pin 6 at $!midp
  pin 6 dir u wrt /*
  pin 6 plane pin 6 thro pin 9
  pin 9 dir from pin 9 to pin 6
  pin 6 dir from pin 6 to pin 9

  !!mdsDacControl(true)

  !!ce = !lug
  if (!!mdsVT07.lug.val) then
    ori and p3 is pin 9
  endif

  !!ce = !datum
  ori and p3 is pin 9

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdsCheck $!mdstemp.:mdsCheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  ori x is pin 6 and z is U wrt /*

  --------------------------------------------------------------------------------------

  -- Extend and move verticals V1 and V2

  !!ce = $!<name>-V1
  !!mdsDacControl(true)
  by s ($!despars[3] / 2) wrt stru
  pin 6 plane pin 6 clear 0 beh $!box1
  pin 5 copy pin 6
  pin 5 plane pin 5 clear $!despars[2] beh $!wall
  var !moveDir pin 5 dir
  move $!moveDir wrt stru clear 0 inf pin 5
  !!ce = $!<name>-V2
  move $!moveDir wrt stru clear 0 inf pin 5
  by n ($!despars[3] / 2) wrt stru

  -- Extend and move cross bars BAR-1 and BAR-2
  !!ce = $!<name>-BAR-1
  extend start thro pin 5
  by s ($!despars[3] / 2) wrt stru
  move n wrt stru clear 0 beh ce
  !!ce = $!<name>-BAR-2
  extend start thro pin 5
  by n ($!despars[3] / 2) wrt stru
  move s wrt stru clear 0 beh ce

  !!ce = $!<name>-V1
  pin 6 dir s
  pin 6 plane pin 6 clear 0 beh $!<name>-BAR-1
  move s wrt stru clear 0 inf pin 6
  by s $!despars[4] wrt stru

  !!ce = $!<name>-V2
  pin 6 dir n
  pin 6 plane pin 6 clear 0 beh $!<name>-BAR-2
  move n wrt stru clear 0 inf pin 6
  by n $!despars[4] wrt stru

  !!ce = $!<name>-SUBS2/PLATE1
  handle none
    by s ($!despars[3] / 2) wrt stru
    move n wrt stru clear 0 beh ce
  elsehandle any
  endhandle

  !!ce = $!<name>-SUBS2/PLATE2
  handle none
    by n ($!despars[3] / 2) wrt stru
    move s wrt stru clear 0 beh ce
  elsehandle any
  endhandle

  !!ce = $!<name>/SREF
  !plod = pl od

  !!ce = $!<name>-SUBS1/PLATE1
  handle none
    ylen $!despars[3]
    move w wrt stru clear $!despars[5] beh $!<name>/SREF
    by w ($!plod / 2) wrt stru
  elsehandle any
  endhandle
  !!ce = $!<name>-SUBS1/PLATE2
  handle none
    ylen $!despars[3]
    move w wrt stru clear $!despars[5] beh $!<name>/SREF
    by w ($!plod / 2) wrt stru
  elsehandle any
  endhandle

  -- Reset distance gadget to new position

  !!ce = !datum
  call !!mdsDistance(!!mdsVT07)

  -- Set dimensions into srefs despars

  pin 9 copy pin 5
  pin 5 plane pin 5 thro $!<name>/DATUM
  pin 6 copy pin 5
  pin 6 plane pin 6 clear 0 beh $!wall
  var !dim1 const dist pin 5 to pin 6
  !!mdsVT07.dim1.val = $!dim1
  !!mdsDacControl(false)
  -- Select correct spref for sref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag

  !support.position = true

  -- Store design parameters

  !!mdsDacControl(true)
  despar $!dim1 $!despars[2]  $!despars[3]  $!despars[4]  $!despars[5]  $!despars[6]

  -- In order to use minimum dimensions for different sizes these have to be stored as a
  -- property called MINA

  -- !min = !despars[6]
  !min = (prop MINA)
  !!ce = $!<name>-BAR-1
  despar n2 $!min
  !!ce = $!<name>-BAR-2
  despar n2 $!min

  -->>>-<wd>aug2002
  -- Adjust the Support Lug Length <LT04> to suit the Vessel Support <VT08>
  -- Despar No. 3 of SREF Atta of Framework <'M' Dimension of VT08 - Property 'DIMM'>
  -- Despar No. 5 of LUG Atta <'L' Dimension of LT04 - Property 'LEN'>
  if (!lugStyp.eq('LT04')) then
    !!ce  = !srefName.dbref()
    !dimm = (prop  DIMM)
    !half = (!dimm.real() / 2 )

    !!ce  = !lug
    !ldim = (!half)
    despar num 5 $!ldim
    --<<<-<wd>aug2002

    -- Adjust Length of Trunnion to suit Vessel Support
  elseif (!!mdsVT07.lug.val.not()) then

    -- Get half width of framework using
    -- Despar No. 3 of SREF Atta of Framework <'M' Dimension of VT08 - Property 'DIMM'>
    !!ce  = !srefName.dbref()
    !dimm = (prop  DIMM)
    !half = (!dimm.real() / 2 )

    -- Get branch and ATTA/SREF for both dummy legs
    !suppNameOfBranch = !!mdsGetSuppName(!atta)
    !legSref = $!suppNameOfBranch/SREF
    !suppNameOfBranch1 = !!mdsGetSuppName(!atta1)
    !legSref1 = $!suppNameOfBranch1/SREF

    -- Adjust length
    !!mdsvtdummylen(!half,!atta,!legSref)
    !!mdsvtdummylen(!half,!atta1,!legSref1)
  endif


  !!mdsDacControl(TRUE)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- In order to add the pipe to the adp drawing we need to set the :mdsattaref of the first bar

  !!mdsDacControl(true)
  !!ce = $!name-BAR-1
  :MdsAttaRef num 1 $!name/DATUM

  -- Reset datum tag

  !!ce = !datum
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourList)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsVT07.support = !support

  -- Show dimensions on graphics if required

  if (!!mdsVT07.graphicalDim) then
    !!mdsshowdim(!!mdsVT07)
  endif

  -- Lock any items that have been locked

  if (!resetLock) then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!wall )
  handle any
  endhandle
  !mdsAdp.append($!atta )
  !mdsAdp.append($!atta1 )
  handle any
  endhandle
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  !!ce = !ce
  --------------------------------------------------------------------------------------

endfunction
