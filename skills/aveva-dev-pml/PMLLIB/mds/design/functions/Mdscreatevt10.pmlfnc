--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt10.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'VT10'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreateVT10(!dummymethod is STRING)

  -- Save current db position

  !unusedCe = !!ce

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsVT10
  !unusedIdtype    = 'PYRA'
  !support   = !!mdsVT10.support
  !unusedClearance = !!mdsoptions.clear.val
  !selection       = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !alias           = !support.alias
  !datumname       = !name & '/' & 'DATUM'
  !srefname        = !name & '/' & 'SREF'
  !unlocked        = ARRAY()
  !resetLock       = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefname = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefname.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefname.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !bore      = !!mdsVT10.support.atta[1].abore
  -- Store section name and matref for each member
  -- for resetting later

  !storemat = ARRAY()
  !storemat = !!mdsStoreMat(!name)

  -- Identify existing support atta (P4501/P4502)

  label /Element0

  prompt off
  prompt load escape |Identify existing support lugs on pipe|
  id ATTA @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !suplug = !!ce

  -- Is the identified atta owned by same branch as the datum atta

  bran
  !suplugbran = !!ce.name
  $!datum
  bran
  !datumBran = !!ce.name
  if (!suplugbran.neq(!datumBran)) then
    !!alert.error('Identified ATTA is not owned by same branch as datum ATTA. Please retry')
    golabel /Element0
  endif

  -- Identify four brackets on equipment

  label /Element1

  prompt off
  prompt load escape |Identify first top support bracket|
  id pyra box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb1 = !!ce

  -- Is the identified pyra owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified pyra is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle


  label /Element2

  prompt off
  prompt load escape |Identify second top support bracket|
  id pyra box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb2 = !!ce

  -- Is the identified pyra owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified pyra is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip2 = !!ce
  endhandle

  -- Are the two brackets identified the same

  if !sb1.name.eq(!sb2.name) then
    !!alert.error('Identified pyras are the same. Please retry')
    golabel /Element1
  endif

  label /Element3

  prompt off
  prompt load escape |Identify first bottom support bracket|
  id pyra box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb3 = !!ce

  -- Is the identified pyra owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified pyra is not owned by a piece of equipment. Please retry')
    golabel /Element3
  elsehandle none
    !equip3 = !!ce
  endhandle


  label /Element4

  prompt off
  prompt load escape |Identify second bottom support bracket|
  id pyra box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb4 = !!ce

  -- Is the identified pyra owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified pyra is not owned by a piece of equipment. Please retry')
    golabel /Element4
  elsehandle none
    !equip4 = !!ce
  endhandle

  -- Are any of the four brackets identified the same

  if (!sb1.name.eq(!sb2.name) or $
    !sb1.name.eq(!sb3.name) or $
    !sb1.name.eq(!sb4.name) or $
    !sb2.name.eq(!sb3.name) or $
    !sb2.name.eq(!sb4.name) or $
    !sb3.name.eq(!sb4.name)) then
    !!alert.error('One or more of the identified pyras are the same. Please retry')
    golabel /Element1
  endif

  -- The pyras must be owned by the same equipment

  if (not(!equip1.name.eq(!equip2.name) and $
    !equip1.name.eq(!equip3.name) and $
    !equip1.name.eq(!equip4.name))) then
    !!alert.error('Identified pyras not owned by the same equipment. Aborting!')
    return
  endif

  label /Element5

  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element5
  elsehandle none
    !equip5 = !!ce
  endhandle

  -- Is the identified cyli owned by the same piece of equipment

  if !equip1.name.neq(!equip5.name) then
    !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- Set elevation of attas in line with bracket

  !!ce = $!datumname
  through $!sb1
  !!ce = $!srefname
  through $!sb1
  !!ce = $!suplug
  through $!sb1

  !!mdsDacControl(true)

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  -- DP 1 = standards sheet dimension L actual distance (initially 0 in params file)
  -- DP 2 = standards sheet dimension X actual distance (initially 0 in params file)
  -- DP 3 = standards sheet dimension M actual distance (initially 0 in params file)
  -- DP 4 = distance from face of pipe to flat cross bar (38mm)
  !flatBarDist = $!despars[4]
  -- DP 5 = min distance from bolt centre to face of vessel wall (125mm)
  !unusedMinBoltDist = $!despars[5]
  -- DP 6 = distance from end of support to centre of support datum atta (250mm)
  !supOverHang       = $!despars[6]

  -- initialise enumerated
  -- reference variables
  !getL = 1
  !getX = 2
  !getA = 3
  !getB = 4
  !getC = 5
  !getD = 6
  !getE = 7
  !getF = 8
  !getG = 9
  !getNumBolts = 10

  -- Load variable from DES-SUPP-VT10 located in the project defaults area

  var !projcode proj code
  --<dw>Aug2008 Dun979 - Now reading file DES-SUPP-VT10
  -- $M/%$!projcode$nDFLTS%/DES-SUPP-VT10
  !rfile = object FILE('%$!projcode$nDFLTS%/DES-SUPP-VT10')
  handle ANY
    !!alert.error('Unable to locate the VT10 dimensions file DES-SUPP-VT10 in the MDS defaults directory')
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  !rarray = !rfile.readfile()
  --<dw>Aug2008 Dun979 - End reading file


  -- initialise enumerated
  -- reference variables
  !getM  = 1
  !getWt = 2


  -- get dimensional data for selected load type
  --<dw>Aug2008 Dun979 - Now reading file DES-SUPP-VT10 to set dimensions and weights
  --!dimLMax = !!cdata[$!selection][!getL]
  --!dimXMin = !!cdata[$!selection][!getX]
  --!dimA = !!cdata[$!selection][!getA]
  --!dimB = !!cdata[$!selection][!getB]
  --!dimC = !!cdata[$!selection][!getC]
  --!dimD = !!cdata[$!selection][!getD]
  --!dimE = !!cdata[$!selection][!getE]
  --!dimF = !!cdata[$!selection][!getF]
  --!dimG = !!cdata[$!selection][!getG]
  --!numBolts = !!cdata[$!selection][!getNumBolts]

  do !x values !rarray
    !xspl = !x.split()
    break if (!xspl.size() eq 0)
    skip if (!xspl[1] eq '#')
    if (!xspl[1] eq !selection) then
      !dimLMax    = !xspl[!getL + 1]
      !dimXMin    = !xspl[!getX + 1]
      !dimA       = !xspl[!getA + 1]
      !dimB       = !xspl[!getB + 1]
      !dimC       = !xspl[!getC + 1]
      !unusedDimD = !xspl[!getD + 1]
      !unusedDimE = !xspl[!getE + 1]
      !dimF       = !xspl[!getF + 1]
      !dimG       = !xspl[!getG + 1]
      !numBolts   = !xspl[!getNumBolts + 1]
    endif
  enddo

  -- get dim M and weight for bore and selected load type
  --!weight   = !!adata[$!bore][$!selection][!getWt]
  --!dimM     = !!adata[$!bore][$!selection][!getM]

  do !x values !rarray
    !xspl = !x.split()
    skip if (!xspl.size() eq 0)
    skip if (!xspl[1] eq '#')
    if (!xspl[1].real() eq !bore) then
      if (!xspl[2] eq !selection) then
        !unusedWeight = !xspl[!getWt + 2]
        !dimM         = !xspl[!getM + 2]
      endif
    endif
  enddo
  --<dw>Aug2008 Dun979 - Now reading file

  -- get direction from datum to face of vessel wall
  pin 1 at $!wall
  pin 1 dir d wrt /*
  pin 1 thro $!suplug
  pin 2 copy p9 of $!suplug
  pin 2 thro $!suplug
  pin 2 dir tow pin 1
  -- pin 2 now holds direction for X-axis of support frame
  -- and the p9 directions for the support attas

  -- go to the attas and reorientate p9 to suit
  var !p2d pin 2 dir wrt /*
  !!ce = $!suplug
  ori and p9 is $!p2d wrt /*
  !!ce = $!datumname
  ori and p9 is $!p2d wrt /*
  !!ce = $!srefname
  ori and p9 is $!p2d wrt /*
  !support.p9dir = p9 dir

  -- now reset pin 2 to match p9 of datum (this may have been rotated)
  !!ce = $!datumname
  pin 2 copy p9

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !loadType    = before(after(upcase(descr),'TYPE '),',')
  !frmw        = !!kcollectallfor('FRMW', '', !!ce)
  !subs        = !!kcollectallfor('SUBS', '', !!ce)
  !frameformat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy $!frmw[1] rename $!frameformat $!name
  SJOI 1 of SNOD 1 of $!<name>-BAR-1
  var !spref1 SPREF
  spref unset
  SJOI 1 of SNOD 1 of $!<name>-BAR-2
  var !spref2 SPREF
  spref unset

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameformat $!name
  enddo

  stru

  -- Orientate stru
  ori -x is $!p2d wrt /*


  -- position horizontal member's centreline (defined by dimension A)
  -- at centre of top support bracket and move all attas to this new
  -- elevation (this assumes the top brackets to be the datum location
  -- for the support)

  -- move the structure to align centre of BAR-1 with top support bracket centre
  !!ce = $!stru
  BY U $!dimA wrt /*

  -- now move all attas
  !!ce = $!datumname
  BY U $!dimA wrt /*
  !!ce = $!srefname
  BY U $!dimA wrt /*
  !!ce = $!suplug
  BY U $!dimA wrt /*

  -- get start and end positions for horizontal bars
  !halfDimM = $!dimM / 2

  -- get NA offset to top of bar 1
  !!ce = $!datumname
  pin 8 at CE
  pin 8 dir d
  pin 8 plane pin 8 through $!<name>-BAR-1
  pin 9 copy pin 8
  pin 9 plan pin 9 clear 0 inf $!<name>-BAR-1
  var !naoffset construct distance pin 8 to pin 9

  -- bar 1
  !!ce = $!datumname
  pin 3 copy P10
  pin 3 by d $!naoffset
  pin 4 copy pin 3
  pin 4 through $!<name>-BAR-1
  pin 5 copy pin4
  pin 5 clear 0 beh $!<name>-BAR-1
  var !naoffset construct distance pin 4 to pin 5
  pin 4 copy pin 3
  pin 4 thro $!datum
  pin 4 dist $!halfDimM
  pin 4 dist -$!naoffset
  pin 3 copy pin2
  pin 3 dist 100
  pin 3 dir tow pin 2
  pin 4 dir pin 3
  pin 4 dist $!supOverHang
  pin 1 copy pin4
  -- pin 1 is now on NA at start of bar 1

  -- get NA offset to top of bar 2
  !!ce = $!datumname
  pin 8 at CE
  pin 8 dir d
  pin 8 plane pin 8 through $!<name>-BAR-2
  pin 9 copy pin 8
  pin 9 plan pin 9 clear 0 inf $!<name>-BAR-2
  var !naoffset construct distance pin 8 to pin 9

  -- bar 2
  pin 3 copy P11
  pin 3 by d $!naoffset
  pin 4 copy pin 3
  pin 4 through $!<name>-BAR-2
  pin 5 copy pin4
  pin 5 clear 0 beh $!<name>-BAR-2
  var !naoffset construct distance pin 4 to pin 5
  pin 4 copy pin 3
  pin 4 thro $!datum
  pin 4 dist $!halfDimM
  pin 4 dist -$!naoffset
  pin 3 copy pin2
  pin 3 dist 100
  pin 3 dir tow pin 2
  pin 4 dir pin 3
  pin 4 dist $!supOverHang
  pin 2 copy pin4
  -- pin 2 is now on NA at end of bar 2

  -- Now get end pos for bar 1 based on outset position of bracket 1
  -- We assume bracket 1,2 (top) and 3,4 (bot) have same outset from vessel wall)
  pin 3 copy pin 1
  pin 3 clear 0 beh $!sb1
  -- move the pin back (2 * dimC + (dimB * number-bolts))
  !dist = 2 * $!dimC + ($!dimB * $!numBolts)
  pin 3 dist -$!dist
  -- pin 3 is now on NA at end of bar 1

  -- Now get start pos for bar 2 based on outset position of bracket 1
  pin 4 copy pin 2
  pin 4 clear 0 beh $!sb1
  -- move the pin back (2 * dimC + (dimB * number-bolts))
  pin 4 dist -$!dist
  -- pin 4 is now on NA at start of bar 2

  -- now set the POSS and POSE for bar 1 & 2
  $!<name>-BAR-1 POSS pin 1
  $!<name>-BAR-1 POSE pin 3
  SNOD 1
  !v1Pose = POS WRT WORLD
  $!<name>-BAR-2 POSE pin 2
  $!<name>-BAR-2 POSS pin 4
  SNOD 1 ZDIST (DERLEN OF OWNER - $!supOverHang )
  !v2Poss = POS WRT WORLD

  -- get direction for bracing members
  !!ce = $!<name>-V1
  pin 1 at pose
  pin 2 at poss
  pin 1 dir tow pin 2

  -- relocate the brace members

  -- V1
  !!ce = $!<name>-V1
  POSE $!v1Pose
  pin 2 at POSE
  pin 2 dir pin 1
  pin 2 clear 0 inf $!sb3
  -- move the pin back (2 * dimC + (dimB * number-bolts))
  pin 2 dist $!dist
  POSS pin 2
  var !xoff param num 5 of $!<name>-V1
  var !thk  param num 3 of $!<name>-V1
  by N ($!xoff - $!thk)

  -- V2
  !!ce = $!<name>-V2
  POSS $!v2Poss
  pin 2 at POSS
  pin 2 dir pin 1
  pin 2 clear 0 inf $!sb3
  -- move the pin back (2 * dimC + (dimB * number-bolts))
  pin 2 dist $!dist
  POSE pin 2
  var !xoff param num 5 of $!<name>-V2
  var !thk  param num 3 of $!<name>-V2
  by S ($!xoff - $!thk)

  -- move flat bar subs
  !!ce = $!<name>/SUBS1
  BOX 1
  XLEN $!dimF
  YLEN $!dimM
  ZLEN $!dimG
  pin 1 copy P9 of $!datum
  pin 1 dist $!flatBarDist
  pin 1 dist ($!dimF / 2)
  pin 1 by u ($!dimG / 2)
  at pin 1

  -- Reset distance gadget to new position

  !!ce = !datum
  call !!mdsDistance(!!mdsVT10)

  -- Set dimensions into srefs despars
  !!ce = !datum
  pin 1 at ce
  pin 1 dir $!p2d wrt /*
  pin 2 copy pin 1
  pin 2 clear 0 inf $!wall
  var !dim1 const dist pin 1 to pin 2
  pin 1 copy p9
  var !dim3 const dist pin 1 to pin 2
  !!mdsVT10.dim1.val = $!dim1
  !!mdsVT10.dim2.val = $!dimM
  !!mdsVT10.dim3.val = $!dim3
  !!mdsDacControl(false)

  -- check if the bracing members are required
  if ($!dim1 geq 1350mm and $!dim3 gt $!dimXMin) then
    -- position bracing members
    !!ce = $!<name>-B1
    handle any
    elsehandle none
      -- position start and end
      pin 1 at pose of $!<name>-BAR-2
      pin 2 at poss of $!<name>-BAR-2
      pin 3 copy p11 of $!datum
      pin 1 dir tow pin 2
      pin 4 copy pin 1
      pin 1 dir pin 3
      pin 1 dist -30mm
      pin 1 dir pin 4
      pin 1 clear 0 beh $!<name>/SUBS1
      pin 1 dist 25mm
      pin 1 dir u
      pin 1 clear 0 beh $!<name>-BAR-2
      poss pin 1
      pin 1 at pose of $!<name>-BAR-1
      pin 2 at poss of $!<name>-BAR-1
      pin 1 dir tow pin 2
      pin 1 clear 0 beh $!sb1
      pin 1 dist 25mm
      pin 1 dir u
      pin 1 clear 0 beh $!<name>-BAR-1
      pose pin 1
      drns perp
      drne perp
    endhandle
    !!ce = $!<name>-B2
    handle any
    elsehandle none
      -- position start and end
      var !thk param num 3 of $!<name>-BAR-1
      pin 1 at poss of $!<name>-BAR-1
      pin 2 at pose of $!<name>-BAR-1
      pin 3 copy p10 of $!datum
      pin 1 dir tow pin 2
      pin 1 clear 0 beh $!<name>/SUBS1
      pin 1 dist 25mm
      pin 1 dir u
      pin 1 clear 0 beh $!<name>-BAR-1
      pin 1 dist -$!thk
      poss pin 1
      pin 1 at poss of $!<name>-BAR-2
      pin 2 at pose of $!<name>-BAR-2
      pin 1 dir tow pin 2
      pin 1 clear 0 beh $!sb1
      pin 1 dist 25mm
      pin 1 dir pin 3
      pin 1 dist 30mm
      pin 1 dir u
      pin 1 clear 0 beh $!<name>-BAR-1
      var !thk param num 3 of $!<name>-BAR-1
      pin 1 dist -$!thk
      pose pin 1
      drns perp
      drne perp
    endhandle
  else
    -- remove bracing members
    !!ce = $!<name>-B1
    handle any
    elsehandle none
      delete SCTN
    endhandle
    !!ce = $!<name>-B2
    handle any
    elsehandle none
      delete SCTN
    endhandle
  endif

  -- reset the joint sprefs
  SJOI 1 of SNOD 1 of $!<name>-BAR-1
  SPREF $!spref1
  SJOI 1 of SNOD 1 of $!<name>-BAR-2
  SPREF $!spref2


  !!ce = $!<name>-V2
  -- extend start -ve to allow for bolted joint
  var !extDist param num 2 of SJOI 1 of SNOD 1 of $!<name>-BAR-2
  extend start -$!extDist

  !!ce = $!<name>-V1
  -- extend end -ve to allow for bolted joint
  var !extDist param num 2 of SJOI 1 of SNOD 1 of $!<name>-BAR-1
  extend end -$!extDist

  -- Select correct spref for sref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag

  !support.position = true

  !!mdsDacControl(true)

  -- Store design parameters
  despar $!dim1 $!dimM $!dim3 $!loadType

  !!mdsDacControl(false)

  -- Reset materials of sections

  !!mdsResetMat(!storemat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Update support data held in form
  !!mdsVT10.support = !support

  -- Show dimensions on graphics if required

  if !!mdsVT10.graphicalDim then
    !!mdsshowdim(!!mdsVT10)
  endif

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Lock any items that have been locked

  !!mdsDacControl(true)

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsadp = :MdsAdp
  !mdsadp.append(equi of $!sb1 )
  !mdsadp.append(bran of $!suplug )
  !mdsadp.unique()

  do !add from 1 to !mdsadp.size()
    :MdsAdp number $!add $!mdsadp[$!add]
  enddo


  !!ce = !stru

  -- clear any dimension errors from previous support build and determine
  -- if any min/max errors exist for this build
  !!mdsVT10.dimerrors.clear()

  -- check if the created framework's X dimension (dim 3) is less then minimum
  -- this cannot be checked as part of consistency report as there is no way
  -- at present to calculate the min sctn length taking the pipe OD into account
  if ($!dim3 lt $!dimXMin) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimXMinD dist($!dimXMin)
    units mm bore mm dist
    !error = |Support dimension 3 is less than allow minimum of $!dimXMinD|
    !!alert.warning(!error)
    !!mdsVT10.dimerrors.append(!error)
  endif

  -- check if the created framework's L dimension (dim 1) is greater than maximum
  if ($!dim1 gt $!dimLMax) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimLMaxD dist($!dimLMax)
    units mm bore mm dist
    !error = |Support dimension 1 is greater than allow maximum of $!dimLMaxD|
    !!alert.warning(!error)
    !!mdsVT10.dimerrors.append(!error)
  endif



  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  --------------------------------------------------------------------------------------

endfunction
-- End function
