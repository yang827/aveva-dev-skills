--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt12.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'VT12'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt12(!dummymethod is STRING)

  -- Save current db position

  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsVT12
  !support   = !!mdsVT12.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !bore      = !!mdsVT12.support.atta[1].abore
  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify both brackets on equipment

  label /Element1

  prompt off
  prompt load escape |Identify first support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box1 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle


  label /Element2

  prompt off
  prompt load escape |Identify second support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box2 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip2 = !!ce
  endhandle

  -- Are the two brackets identified the same

  if !box1.name.eq(!box2.name) then
    !!alert.error('Identified boxes are the same. Please retry')
    golabel /Element1
  endif

  -- The boxes must be owned by the same equipment

  if !equip1.name.neq(!equip2.name) then
    !!alert.error('Identified boxes not owned by the same equipment. Aborting!')
    return
  endif

  label /Element3

  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element3
  elsehandle none
    !equip3 = !!ce
  endhandle

  -- Is the identified cyli owned by the same piece of equipment

  if !equip1.name.neq(!equip3.name) then
    !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
    return
  endif

  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- Set elevation of attas in line with bracket

  !!ce = $!datumName
  through $!box1
  !!ce = $!srefName
  through $!box1

  -- Get design parameters
  !!mdsDacControl(true)

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  !dimLmin = !despars[5]
  !dimLmax = 1275mm

  pin 9 at $!!mdsVT12.support.atta[1]
  pin 9 dir d wrt /*
  pin 9 plane pin 9 through $!box1
  pin 8 at $!box1
  pin 7 at $!box2
  !line = object LINE()
  !line.startPosition = (!box1.pos )
  !line.endPosition = (!box2.pos )

  !midp = !line.proportion(0.5)
  pin 6 at $!midp
  pin 6 dir u wrt /*
  pin 6 plane pin 6 thro pin 9
  pin 9 dir from pin 9 to pin 6
  pin 6 dir from pin 6 to pin 9

  pin 5 copy pin6
  pin 5 dir from pin5 to $!!mdsVT12.support.atta[1]
  pin5 clear (175 - $!despars[3]) beh $!wall

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  ori x is pin 6 and z is U wrt /*

  -- go to the attas and reorientate p9 to suit
  !!ce = $!datumName
  ori and p9 is tow pin6
  !!ce = $!srefName
  ori and p9 is tow pin6
  !support.p9dir = p9 dir

  -- find the material to see if we need to use alternative dimensioning
  bran
  !matl = :mdspipemat of pspe
  if !matl.match('SS').gt(0) then $* we need to use wear plates
    !index = 2
  else
    !index = 4
  endif
  --------------------------------------------------------------------------------------

  -- Extend and move verticals V1 and V2

  -- Extend and move cross bars BAR-1 and BAR-2
  !!ce = $!<name>-BAR-1
  extend end thro pin 5
  extend start $!despars[$!index]
  by n $!despars[$!index]

  !!ce = $!<name>-BAR-2
  extend end thro pin 5
  extend start $!despars[$!index]
  by s $!despars[$!index]

  !!ce = $!<name>-BAR-4
  by w $!despars[$!index]
  -- beam goes south to north
  reconnect
  !!ce = $!<name>-BAR-3
  by e $!despars[$!index]
  extend start $!despars[$!index]
  extend end $!despars[$!index]

  reconnect

  -- tidy the nodes
  !!ce = $!<name>-BAR-1
  snode 1
  zdist through cref of sjoi1
  !!ce = $!<name>-BAR-2
  snode 1
  zdist through cref of sjoi1
  !!ce = $!<name>-BAR-3
  snode 1
  zdist through cref of sjoi1
  snode 2
  zdist through cref of sjoi1

  if !index.eq(4) then $* no wear plates required
    !!ce = $!<name>/SUBS1
    delete subs
    !plates = 'N'
  else
    -- move the boxes for the wear plates
    !!ce = $!<name>-BOX-E
    by e $!despars[$!index]
    !!ce = $!<name>-BOX-W
    by w $!despars[$!index]
    !!ce = $!<name>-BOX-N
    by n $!despars[$!index]
    !!ce = $!<name>-BOX-S
    by s $!despars[$!index]
    !plates = 'Y'
  endif

  -- Reset distance gadget to new position

  !!ce = !datum
  call !!mdsDistance(!!mdsVT12)

  -- Set dimensions into srefs despars

  pin 9 copy pin 5
  pin 5 plane pin 5 thro $!<name>/DATUM
  pin 6 copy pin 5
  pin 6 plane pin 6 clear 0 beh $!wall
  var !dim1 const dist pin 5 to pin 6
  !!mdsVT12.dim1.val = $!dim1
  --!!mdsVT12.dim2.val = $!despars[$!index]
  --!!mdsVT12.dim3.val = $!despars[3]
  !!mdsDacControl(false)
  -- Select correct spref for sref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag

  !support.position = true

  -- Store design parameters

  !!mdsDacControl(true)

  despar $!dim1 $!despars[$!index] $!despars[3] $!plates

  -- In order to use minimum dimensions for different sizes these have to be stored as a
  -- property called MINA
$(
  -- !min = !desPars[6]
  !min = (prop MINA)
  !!ce = $!<name>-BAR-1
  despar n2 $!min
  !!ce = $!<name>-BAR-2
  despar n2 $!min
$)
  !!mdsDacControl(false)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsVT12.support = !support

  -- Show dimensions on graphics if required

  if !!mdsVT12.graphicalDim then
    !!mdsshowdim(!!mdsVT12)
  endif

  !!mdsDacControl(true)

  -- Lock any items that have been locked

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!wall )
  !mdsAdp.append(bran of $!datumName )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

  !!ce = !stru


  -- clear any dimension errors from previous support build and determine
  -- if any min/max errors exist for this build
  !!mdsVT12.dimerrors.clear()

  -- check if the created framework's L dimension (dim 1) is less then minimum
  -- this cannot be checked as part of consistency report as there is no way
  -- at present to calculate the min sctn length taking the pipe OD into account
  if ($!dim1 lt $!dimLmin) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimLminD dist($!dimLmin)
    units mm bore mm dist
    !error = |Support dimension 1 is less than allow minimum of $!dimLminD|
    !!alert.warning(!error)
    !!mdsVT12.dimerrors.append(!error)
  endif

  -- check if the created framework's L dimension (dim 1) is greater than maximum
  if ($!dim1 gt $!dimLmax) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimLmaxD dist($!dimLmax)
    units mm bore mm dist
    !error = |Support dimension 1 is greater than allow maximum of $!dimLmaxD|
    !!alert.warning(!error)
    !!mdsVT12.dimerrors.append(!error)
  endif

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!ce = !ce
  --------------------------------------------------------------------------------------

endfunction
