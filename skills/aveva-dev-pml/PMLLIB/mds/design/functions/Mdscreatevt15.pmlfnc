--
-- File:    Mdscreatevt15.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MVS101
--
-- Author:    Neale Morris
-- Created:   Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'vt15'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt15(!method is STRING)

  -- Save current db position

  --!ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsvt15
  --!idtype    = 'BOX'
  !support   = !!mdsvt15.support
  --!clearance = !!mdsoptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  --!pldir     = !support.pldir
  --!padir     = !support.padir
  !alias     = !support.alias
  --!datumName = !name & '/' & 'DATUM'
  !sRefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !sRefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!sRefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !sRefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify bracket

  if !method.eq('CURSOR') then

    label /Element1

    prompt off
    prompt load escape |Identify support bracket|
    id box @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    prompt dismiss
    prompt on
    !box1 = !!ce

    -- Is the identified box owned by a piece of equipment

    equi
    handle any
      !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
      golabel /Element1
    elsehandle none
      !equip1 = !!ce
    endhandle

    label /Element3

    prompt off
    prompt load escape |Identify vessel wall|
    id cyli @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    prompt dismiss
    prompt on
    !wall = !!ce

    -- Is the identified cyli owned by a piece of equipment

    equi
    handle any
      !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
      golabel /Element3
    elsehandle none
      !equip3 = !!ce
    endhandle

    -- Is the identified cyli owned by the same piece of equipment

    if !equip1.name.neq(!equip3.name) then
      !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
      return
    endif

  endif

  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  --id the connecting u-bolt
  label /Element0

  prompt off
  prompt load escape |Identify existing u-bolt on pipe|
  id ATTA @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !ubolt = !!ce

  -- Is the identified atta owned by same branch as the datum atta
  bran
  !uboltBran = !!ce.name
  $!datum
  bran
  !datumBran = !!ce.name
  if (!uboltBran.neq(!datumBran)) then
    !!alert.error('Identified ATTA is not owned by same branch as datum ATTA. Please retry')
    golabel /Element0
  endif

  -- Get design parameters
  !!ce = !ubolt
  !bore = pl bore

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  -- Find the top of the bracket

  if !method.eq('CURSOR') then

    pin 9 copy pl of $!ubolt
    pin 9 dir u wrt /*
    pin 9 plane pin 9 clear 0 beh $!box1
    pin 8 copy pin 9
    pin 8 dist -$!despars[4]
    pin 8 dist $!despars[5]

    -- Place components through derived position

    !!ce = !ubolt
    plane u thro pin 8
    !!ce = $!name/SREF
    plane u thro pin 8
    !!ce = $!name/DATUM
    plane u thro pin 8

    -- Direct ubolt/SREF atta to cylinder

    !!ce = !ubolt
    ori and p3 is towards $!wall

  else

    pin 9 copy pl of $!ubolt
    pin 9 dir u wrt /*
    -- pin 9 plane pin 9 clear 0 beh $!box1
    pin 8 copy pin 9
    pin 8 dist -$!despars[4]
    pin 8 dist $!despars[5]

  endif

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  pin 6 copy p9 of $!ubolt
  pin 5 copy p3 of $!ubolt
  var !dir const dir pin 5 to pin 6
  pin 6 dir $!dir wrt /*

  -- Orientate stru
  stru
  ori x is pin 6 and z is U wrt /*

  -- Move stru to p9 of u-bolt
  move $!dir thro pin 6

  -- Work out direction and distance to move sctn and plate

  !drns = drns of $!name-BAR-1 wrt /*
  !drne = drne of $!name-BAR-1 wrt /*
  !poss = poss of $!name-BAR-1 wrt /*

  if !method.eq('CURSOR') then
    pin 9 at $!poss
    pin 9 dir $!drns
    pin 8 copy pin 9
    pin 8 plane pin 8 clear $!despars[3] beh $!wall
  else
    pin 9 at $!name/DATUM
    pin 9 dir $!drne
    pin 8 copy pin 9
    pin 8 dist $!!mdsvt15.dim1.val
    pin 8 dist -$!despars[3]
    pin 9 plane pin 9 thro $!poss
  endif
  --var !dist const dist pin 9 to pin 8

  -- Set dimensions into srefs despars

  if !method.eq('CURSOR') then
    pin 9 copy p9 of $!ubolt
    pin 9 plane pin 9 thro $!ubolt
    pin 8 copy pin 9
    pin 8 plane pin 8 clear 0 inf $!wall
    var !dim1 const dist pin 9 to pin 8
    pin 8 dist -$!despars[3]
    pin 8 dist -$!despars[7]
  else
    pin 9 copy p9 of $!ubolt
    pin 9 plane pin 9 thro $!ubolt
    pin 8 copy pin 9
    pin 8 plane pin 8 dist $!!mdsvt15.dim1.val
    var !dim1 const dist pin 9 to pin 8
    pin 8 dist -$!despars[3]
    pin 8 dist -$!despars[7]
  endif

  -- Reset distance gadget to new position

  !!ce = !datum
  call !!mdsDistance(!!mdsvt15)

  $!name-BAR-1
  -- extend start $!dist
  extend start thro pin 8

  $!name/SUBS1
  handle any
  elsehandle none
    move $!drns thro pin 8
    move $!drne dist -$!despars[6]
  endhandle

  -- Align bracket with vessel bracket
  pin 8 plane pin 8 clear 0 inf $!name/SUBS1
  pin 9 plane pin 9 clear 0 inf $!box1
  var !moveDist const dist pin 9 to pin 8
  $!name-BAR-1
  extend start -$!moveDist
  $!name/SUBS1
  handle any
  elsehandle none
    move $!drns clear 0 inf pin 9
  endhandle

  !!mdsvt15.dim1.val = $!dim1
  !!mdsDacControl(false)

  -- Select correct spref for sref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag

  !support.position = true

  -- Store design parameters

  !!mdsDacControl(true)
  despar $!dim1 $!despars[2] $!despars[3] $!despars[4] $!despars[5]
  !!mdsDacControl(false)
  -- In order to use minimum dimensions for different sizes these have to be stored as a
  -- property called MINA

  -- !min = (prop MINA)
  -- !!ce = $!<name>-BAR-1
  -- despar n2 $!min

  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsvt15.support = !support

  -- Show dimensions on graphics if required

  if !!mdsvt15.graphicalDim then
    !!mdsshowdim(!!mdsvt15)
  endif

  -- Lock any items that have been locked

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!box1 )
  !mdsAdp.append(bran of $!datum )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  --------------------------------------------------------------------------------------

endfunction
