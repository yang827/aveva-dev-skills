--
-- File:  Mdscreatevt17.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'vt17'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt17(!dummymethod is STRING)

  -- Save current db position

  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsvt17
  !support   = !!mdsvt17.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !pldir     = !support.pldir
  !alias     = !support.alias
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --<wd>2002
  -- Set Pipe Creation Type, 'SHOE' for Insulated and 'PIPE' for UNINSULATED Pipe
  !insutype = !form.type.selection()
  --<wd>2002


  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify both brackets on equipment

  label /Element1
  prompt off
  prompt load escape |Identify support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box1 = !!ce

  -- Is the identified box owned by a piece of equipment
  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle

  label /Element3
  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment
  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element3
  elsehandle none
    !equip3 = !!ce
  endhandle

  -- Is the identified cyli owned by the same piece of equipment
  if !equip1.name.neq(!equip3.name) then
    !!kRestoreUnits(!currentunits)
    !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
    return
  endif

  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------
  -->>>-<wd>oct2002
  -- The DATUM and SREF Attas have already been created - Check if the DATUM Atta is on an INSULATED Pipe
  -- Either -(1) Identify Pipe SHOE if Pipe is INSULATED
  -- Or     -(2) Identify PIPE if PIPE is UNINSULATED

  -- Identify SHOE or PIPE
  if (!insutype.eq('SHOE')) then
    !id = 'Pipe Shoe'

    label /Atta
    prompt off
    prompt load escape |Identify $!id|
    id atta @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    !atta = !!ce
    -- Is it a shoe
    if !!ce.catref.owner.:MdsType.neq('SHOE')then
      !!kRestoreUnits(!currentunits)
      !!alert.error('Identified element is not a shoe')
      return
    endif

  elseif (!insutype.eq('PIPE')) then
    --!id = 'Pipe'
    -- Do NOT have to RE-IDENTIFY the SAME PIPE to Proceed
    -- The VT17 Support is to be positioned at the BOP of the DATUM ATTA
    !atta = !datum
  endif


  -- Slide DATUM atta through identified bracket
  !!ce = !datum
  --plane pl thro $!box1
  if (!support.mirror) then
    plane pl clear 0 beh $!box1
  else
    plane pl clear 0 inf $!box1
  endif

  --  Also Slide SREF atta through identified bracket
  !!ce  = !srefName.dbref()
  --plane pl thro $!box1
  at prev

  --<<<-<wd>oct2002
  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------

  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- Set elevation to top of bracket
  !bore = pl bore

  -- Get design parameters

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Position Structure at:
  --<wd>oct2002
  --  Variable !atta is either the Identified PIPE SHOE or the current DATUM ATTA
  -- Either - (1) P9 of Identified Pipe Shoe on an INSULATED Pipe
  -- Or     - (2) P9 of Identified DATUM Atta on an UNINSULATED Pipe
  at p9 of $!atta
  --<wd>oct2002

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements
  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition
  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Orientate stru
  stru
  pin 6 copy p5 of $!box1
  ori x is pin 6 and z is U wrt /*

  --------------------------------------------------------------------------------------

  !!ce = !atta
  !!mdsDacControl(true)

  -- Find out which end is furthest away from the vessel and extend by design para 3
  !poss = poss of $!name-BAR-1 wrt /*
  !pose = pose of $!name-BAR-1 wrt /*
  !drns = drns of $!name-BAR-1
  pin 9 at $!poss
  pin 9 dir $!drns
  pin 8 at $!pose
  pin 8 dir $!drns
  pin 7 copy pin 8
  pin 7 plane pin 7 thro $!wall
  var !p7p9dist const dist pin 7 to pin 9
  var !p7p8dist const dist pin 7 to pin 8
  if !p7p9dist.real().gt(!p7p8dist.real()) then
    !nearest  = 'END'
    !furthest = 'START'
    !nearestEnd  = 'POSE'
    !furthestEnd = 'POSS'
  else
    !nearest  = 'START'
    !furthest = 'END'
    !nearestEnd  = 'POSS'
    !furthestEnd = 'POSE'
  endif

  !!ce = $!name-BAR-1

  extend $!furthest thro p9 of $!atta
  extend $!furthest $!despars[3]

  -- Extend the other end despar 2 infront of wall
  pin 7 plane pin 7 clear $!despars[2] beh $!wall
  extend $!nearest thro pin 7

  -- Move plate thro furthest end
  var !direction const direction pin 7 to pin 9
  !!ce = $!name/SUBS1
  handle none
    move $!direction thro $!furthestEnd of $!name-BAR-1
    move $!direction dist -$!despars[4]
  elsehandle any
  endhandle

  -- Reset distance gadget to new position
  !!ce = !datum
  call !!mdsDistance(!!mdsvt17)

  -- Set dimensions into srefs despars
  pin 9 direction $!direction
  pin 9 plane pin 9 clear 0 beh $!wall
  pin 8 copy pin 9
  pin 8 plane pin 8 thro $!<name>/DATUM
  var !dim1 const dist pin 9 to pin 8
  !!mdsvt17.dim1.val = $!dim1
  !!mdsDacControl(false)

  -- Select correct spref for sref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag
  !support.position = true

  -- Store design parameters
  !!mdsDacControl(true)
  despar $!dim1 $!despars[2] $!despars[3]
  !!mdsDacControl(false)

  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  -- Reset datum tag
  !!ce = !datum
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Navigate to Structure
  !!ce = !stru
  --<wd>2002
  -- Slide STRU to side of Vessel Clip(BOX)
  at p9 of $!atta
  if (!support.mirror) then
    !!mdsmirrorvt17()
    move $!pldir clear 0 beh $!box1
  else
    move $!pldir clear 0 inf $!box1
  endif
  --<wd>2002

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsvt17.support = !support

  -- Show dimensions on graphics if required
  if !!mdsvt17.graphicalDim then
    !!mdsshowdim(!!mdsvt17)
  endif

  -- Lock any items that have been locked
  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!box1 )
  !mdsAdp.append(bran of $!datum )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!ce = !ce

endfunction
