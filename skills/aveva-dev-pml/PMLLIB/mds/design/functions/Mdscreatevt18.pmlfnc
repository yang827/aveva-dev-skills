--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt18.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'vt18'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt18(!dummymethod is STRING)

  -- Save current db position

  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsVT18
  !support   = !!mdsVT18.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !bore      = !!mdsVT18.support.atta[1].abore
  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify both brackets on equipment

  label /Element1

  prompt off
  prompt load escape |Identify support bracket|
  id pyra box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !box1 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified pyra is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle

  label /Element2

  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip3 = !!ce
  endhandle

  -- Is the identified cyli owned by the same piece of equipment

  if !equip1.name.neq(!equip3.name) then
    !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
    return
  endif


  label /Element3

  prompt off
  prompt load escape |Identify Pipe Shoe|
  id atta @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !shoe = !!ce

  -- Check the shoe is the correct type
$(
  equi
  handle any
    !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip3 = !!ce
  endhandle
$)


  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- Set elevation of attas in line with bracket

  !!ce = $!datumName
  through $!box1
  !!ce = $!srefName
  through $!box1

  -- Get design parameters
  !!mdsDacControl(true)

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  !dimLmax  = !despars[2]
  !insul1   = !despars[3]
  !dimLmin1 = !despars[4]
  !insul2   = !despars[5]
  !dimLmin2 = !despars[6]

  -- insulation thickness and determine L min value
  var !ithk INSUL
  if ($!ithk gt $!insul1) then
    !dimLmin = $!dimLmin2
  else
    !dimLmin = $!dimLmin1
  endif

  pin 9 at $!!mdsVT18.support.atta[1]
  pin 9 dir d wrt /*
  pin 9 plane pin 9 through $!box1
  pin 6 at $!box1

  pin 6 dir u wrt /*
  pin 6 plane pin 6 thro pin 9
  pin 9 dir from pin 9 to pin 6
  pin 6 dir from pin 6 to pin 9

  pin 5 copy pin6
  pin 5 dir from pin5 to $!!mdsVT18.support.atta[1]
  pin5 clear 0 behind $!box1
  pin 5 dist -219
  --  pin 5 dist -$!despars[3]
  pin 7 copy pin 5
  pin 7 clear 0 behind $!wall

  !!ce = $!datumName
  ori and p9 is tow pin6
  !!ce = $!srefName
  ori and p9 is tow pin6
  !support.p9dir = p9 dir

  --<wd>nov2003
  -- Need to Reset the STEX and ORI of P9 of the SHOE Atta
  !!ce = !shoe
  ori and p9 is tow pin6
  !!mdstransport(!shoe,!shoe.name)
  --<wd>nov2003

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at p9 of $!shoe

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy attrib of $!frmw[1]
  copy mem of $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  -- ori x is pin 6 and z is U
  ori -x is p9 of $!datum
  -- go to the attas and reorientate p9 to suit



  -- find the material to see if we need to use alternative dimensioning
$(
  bran
  !matl = :mdspipemat of pspe
  if !matl.match('SS').gt(0) then $* we need to use wear plates
    !index = 2
  else
    !index = 4
  endif
$)
  --------------------------------------------------------------------------------------


  -- go to stru and set the design parameters
  -- need the property fthk from the shoe + 3mm
  -- plus the prop fwid to work out the shoe width
  var !width prop fwid of $!shoe
  var !thickness prop fthk of $!shoe
  !byy = !width.real() / 2
  -- calculate the design parameters of the stru
  !byx = !thickness.real() + 3
  -- move the bars in the x
  !!ce = $!<name>-A-1
  by x $!byx
  by y -$!byy
  var !cut desp[1]
  !newcutback = !cut.real() - !byx.real()
  desparam n1 $!newcutback
  !!ce = $!<name>-A-2
  by x $!byx
  by y $!byy
  desparam n1 $!newcutback

  !!ce = $!<name>-BAR-1

  -- Extend and move cross bars BAR-2
  extend end thro pin 5

  -- Select correct spref for sref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF
  !!ce = $!<name>/SREF
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  -- Set position flag

  !support.position = true

  -- calculate design parameters
  var !dim1 const dist pin7 to pin 9
  var !dim2 despar 5 of $!shoe

  !!mdsVT18.dim1.val = $!dim1 $* dimension L
  --!!mdsVT18.dim2.val = $!dim2 $* dimension H

  -- Store design parameters

  !!mdsDacControl(true)

  despar $!dim1  $!dim2

  -- In order to use minimum dimensions for different sizes these have to be stored as a
  -- property called MINA
$(
  -- !min = !desPars[6]
  !min = (prop MINA)
  !!ce = $!<name>-BAR-1
  despar n2 $!min
  !!ce = $!<name>-BAR-2
  despar n2 $!min
$)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  !!mdsDacControl(true)

  -- move the support stru and attas to bottom of bracket
  pin 1 at $!box1
  pin 1 dir d
  pin 1 clear 0 beh $!box1
  pin 2 copy pin 1
  pin 2 clear 0 inf $!<name>-BAR-1
  pin 3 copy pin 2
  pin 3 plan d thr $!<name>
  var !dist construct distance pin 2 to pin 3
  pin 1 dist $!dist
  $!<name>/SREF
  PLAN D THR PIN 1
  $!<name>/DATUM
  PLAN D THR PIN 1
  $!shoe
  PLAN D THR PIN 1
  $!<name>
  AT p9 of $!shoe

  -- Reset datum tag

  !!ce = !datum
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsVT18.support = !support

  -- Show dimensions on graphics if required

  if !!mdsVT18.graphicalDim then
    !!mdsshowdim(!!mdsVT18)
  endif

  -- Lock any items that have been locked

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!box1 )
  !mdsAdp.append(bran of $!datum )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo


  !!ce = !stru

  -- clear any dimension errors from previous support build and determine
  -- if any min/max errors exist for this build
  !!mdsVT18.dimerrors.clear()

  -- check if the created framework's L dimension (dim 1) is less then minimum
  -- this cannot be checked as part of consistency report as there is no way
  -- at present to calculate the min sctn length taking the pipe OD into account
  if ($!dim1 lt $!dimLmin) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimLminD dist($!dimLmin)
    units mm bore mm dist
    !error = |Support dimension 1 is less than allow minimum of $!dimLminD|
    !!alert.warning(!error)
    !!mdsVT18.dimerrors.append(!error)
  endif

  -- check if the created framework's L dimension (dim 1) is greater than maximum
  if ($!dim1 gt $!dimLmax) then
    !!kRestoreUnits(!currentunits)
    prec var 1/16
    var !dimLmaxD dist($!dimLmax)
    units mm bore mm dist
    !error = |Support dimension 1 is greater than allow maximum of $!dimLmaxD|
    !!alert.warning(!error)
    !!mdsVT18.dimerrors.append(!error)
  endif

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!ce = !ce
  --------------------------------------------------------------------------------------

endfunction
