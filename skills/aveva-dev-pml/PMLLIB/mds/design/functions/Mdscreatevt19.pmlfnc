--
-- File:  Mdscreatevt19.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Neale Morris
-- Created:  Tuesday 16th April 2002
--
--
-- Description:
-- function to create Vessel support frame type 'VT19'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreateVT19(!dummymethod is STRING)

  -- Save current db position
  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsVT19
  !support   = !!mdsVT19.support
  !clearance = !!mdsoptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !bore      = !!mdsVT19.support.atta[1].abore
  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify two brackets on equipment

  label /Element1

  prompt off
  prompt load escape |Identify first support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb1 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element1
  elsehandle none
    !equip1 = !!ce
  endhandle


  label /Element2

  prompt off
  prompt load escape |Identify second support bracket|
  id box @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !sb2 = !!ce

  -- Is the identified box owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
    golabel /Element2
  elsehandle none
    !equip2 = !!ce
  endhandle

  -- Are the two brackets identified the same

  if !sb1.name.eq(!sb2.name) then
    !!alert.error('Identified boxes are the same. Please retry')
    golabel /Element1
  endif

  label /Element3

  prompt off
  prompt load escape |Identify Vessel Wall|
  id cyli @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt dismiss
  prompt on
  !wall = !!ce

  -- Is the identified cyli owned by a piece of equipment

  equi
  handle any
    !!alert.error('Identified cyli is not owned by a piece of equipment. Please retry')
    golabel /Element3
  elsehandle none
    !equip3 = !!ce
  endhandle

  -- Is the equipment the same?

  if !equip1.name.neq(!equip2.name).and(!equip1.name.neq(!equip3.name)) then
    !!alert.error('Identified items are not owned by the same equipment. Please retry')
    golabel /Element1
  endif


  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- get despars
  !!mdsDacControl(true)

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())
  !despars = !mdsattaobj.despars
  --!despars = !!mdsPar$!alias[$!bore].despars
  --<dw>sep2008 dun979 - End of mod

  -- DP 1 = standards sheet dimension L actual distance (initially 0 in params file)
  !dimL = $!despars[1]
  -- DP 2 = dimension L maximum value
  !dimLMax = $!despars[2]
  -- DP 3 = distance from vessel wall to bolt centre
  !wallBlt = $!despars[3]
  -- DP 4 = clearance between guide and support base plates
  !clearance = $!despars[4]
  -- DP 5 = distance from bolt centres to end of support steel
  !bltStl = $!despars[5]
  -- DP 6 = distance from bolt centres to end of support bracket
  !bltBkt = $!despars[6]
  -- DP 7 = 1st max insulation thickness
  !maxInsul1 = $!despars[7]
  -- DP 8 = 1st Lmin dimension
  !lmin1 = $!despars[8]
  -- DP 9 = 1st N dimension
  !n1 = $!despars[9]
  -- DP 10 = 2nd max insulation thickness
  !maxInsul2 = $!despars[10]
  -- DP 11 = 2nd Lmin dimension
  !lmin2 = $!despars[11]
  -- DP 12 = 2nd N dimension
  !n2 = $!despars[12]

  -- get direction from datum to face of vessel
  pin 1 copy p1 of $!wall
  pin 1 thro $!sb1
  pin 2 copy p1 of $!datum
  pin 2 thro $!sb1
  pin 2 dir tow pin 1
  -- pin 2 now holds direction for X-axis of support frame
  -- and the p9 directions for the support attas

  -- go to the attas and reorientate p9 to suit and position them
  var !p2d pin 2 dir wrt /*
  !!ce = $!datumName
  plan D thr pin1
  ori and p9 is $!p2d wrt /*
  !!ce = $!srefName
  plan D thr pin1
  ori and p9 is $!p2d wrt /*
  -- set guide standout from design parameters and insulation thickness
  var !ithk INSUL
  if ($!ithk gt $!maxInsul1) then
    !standout = $!n2 - 6 - $!clearance
    !dimLmin = $!lmin2
    !dimN = $!n2
  else
    !standout = $!n1 - 6 - $!clearance
    !dimLmin = $!lmin1
    !dimN = $!n1
  endif
  DESP $!standout
  !support.p9dir = p9 dir
  !support.p10dir = p10 dir
  !support.p11dir = p11 dir

  -- now reset pin 2 to match p9 of datum (this may have been rotated)
  !!ce = $!datumName
  pin 2 copy p9

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'

  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  pin 9 at $!datum
  AT pin 9
  ori -x is $!p2d wrt /*

  -- now set the stru item positions
  -- Bar 1 (and end of bar 4)
  pin 1 copy p0 of $!datum
  var 1 P10dir of $!datum wrt world
  pin 1 dir $v1 wrt world
  pin 2 copy pin 1
  pin 2 thro $!<name>-BAR-1
  pin 1 dir to pin 2
  var !width1 prop WIDTH of $!<name>-BAR-1
  pin 1 dist $!dimN
  pin 4 copy pin 1
  pin 4 dist -3mm
  var !guidePos pin 4 pos in world
  !!ce = BOX 1 of $!<name>/SUBS2
  AT $!guidePos wrt world
  pin 1 dist ($!width1 / 2)
  pin 1 dir $!p2d wrt /*
  pin 1 clear ($!wallBlt - $!bltStl) inf $!wall
  var !startPos pin 1 pos in world
  pin 2 copy pin 1
  pin 2 dist 100
  pin 2 dir to pin 1
  pin 2 thro $!datum
  pin 3 copy pin 2
  pin 3 dist -$!dimN
  pin 3 dist ($!width1 / -2)
  var !bar4end pin 3 pos in world
  pin 2 dist $!dimN
  pin 2 dist ($!width1 / 2)
  var !endPos pin 2 pos in world
  !!ce = $!<name>-BAR-1
  POSS $!startPos wrt /*
  POSE $!endPos wrt /*
  !!ce = $!<name>-BAR-4
  POSE $!bar4end wrt /*
  goto joie
  end
  zdist thr sjoi 1

  -- Bar 2 (and start of bar 4)
  pin 1 copy p0 of $!datum
  var 1 P10dir of $!datum wrt world
  pin 1 dir $v1 wrt world
  pin 2 copy pin 1
  pin 2 thro $!<name>-BAR-2
  pin 1 dir to pin 2
  var !width2 prop WIDTH of $!<name>-BAR-2
  pin 1 dist $!dimN
  pin 4 copy pin 1
  pin 4 dist -3mm
  var !guidePos pin 4 pos in world
  !!ce = BOX 1 of $!<name>/SUBS1
  AT $!guidePos wrt world
  pin 1 dist ($!width2 / 2)
  pin 1 dir $!p2d wrt /*
  pin 1 clear ($!wallBlt - $!bltStl) inf $!wall
  var !startPos pin 1 pos in world
  pin 2 copy pin 1
  pin 2 dist 100
  pin 2 dir to pin 1
  pin 2 thro $!datum
  pin 3 copy pin 2
  pin 3 dist -$!dimN
  pin 3 dist ($!width2 / -2)
  var !bar4start pin 3 pos in world
  pin 2 dist $!dimN
  pin 2 dist ($!width2 / 2)
  var !endPos pin 2 pos in world
  !!ce = $!<name>-BAR-2
  POSS $!startPos wrt /*
  POSE $!endPos wrt /*
  !!ce = $!<name>-BAR-4
  POSS $!bar4start wrt /*
  goto jois
  end
  zdist thr sjoi 1

  -- bar 3
  pin 1 at POSE of $!<name>-BAR-1
  pin 2 at POSE of $!<name>-BAR-2
  !!ce = $!<name>-BAR-3
  POSE pin 1
  POSS pin 2
  extend start 4.5inch
  extend end 4.5inch

  -- reconnect all
  !!ce = $!<name>-BAR-1
  goto joie
  end
  zdist thr sjoi 1
  !!ce = $!<name>-BAR-1
  reconnect
  !!ce = $!<name>-BAR-2
  goto joie
  end
  zdist thr sjoi 1
  !!ce = $!<name>-BAR-2
  reconnect
  !!ce = $!<name>-BAR-4
  reconnect

  -- position the remaining guides
  pin 1 copy p0 of $!datum
  var 1 p9dir of $!datum wrt world
  pin 1 dir $v1 wrt world
  pin 1 dist $!dimN
  pin 1 dist -3mm
  var !guidePos pin 1 pos in world
  !!ce = BOX 1 of $!<name>/SUBS4
  AT $!guidePos wrt world
  pin 2 copy p0 of $!datum
  var 1 p9dir of $!datum wrt world
  pin 2 dir $v1 wrt world
  pin 1 copy pin 2
  pin 1 dist 100
  pin 1 dir to pin 2
  pin 1 dist 100
  pin 1 dist $!dimN
  pin 1 dist -3mm
  var !guidePos pin 1 pos in world
  !!ce = BOX 1 of $!<name>/SUBS3
  AT $!guidePos wrt world

  -- Reset distance gadget to new position

  !!ce = !datum
  call !!mdsDistance(!!mdsVT19)

  -- Set dimensions into srefs despars
  !!ce = !datum
  pin 1 at ce
  pin 1 dir $!p2d wrt /*
  pin 2 copy pin 1
  pin 2 clear 0 inf $!wall
  var !dim1 const dist pin 1 to pin 2
  pin 1 copy p9
  !!mdsVT19.dim1.val = $!dim1
  !!mdsDacControl(false)

  -- Select correct spref for sref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF

  !!ce = $!<name>/DATUM
  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

  !!mdsDacControl(false)

  -- Set position flag

  !support.position = true

  -- Store design parameters
  !dimL = $!despars[1]
  -- DP 2 = dimension L maximum value
  !dimLMax = $!despars[2]
  -- DP 3 = distance from vessel wall to bolt centre
  !wallBlt = $!despars[3]
  -- DP 4 = clearance between guide and support base plates
  !clearance = $!despars[4]
  -- DP 5 = distance from bolt centres to end of support steel
  !bltStl = $!despars[5]
  -- DP 6 = distance from bolt centres to end of support bracket
  !bltBkt = $!despars[6]
  -- DP 7 = 1st max insulation thickness
  !maxInsul1 = $!despars[7]
  -- DP 8 = 1st Lmin dimension
  !lmin1 = $!despars[8]
  -- DP 9 = 1st N dimension
  !n1 = $!despars[9]
  -- DP 10 = 2nd max insulation thickness
  !maxInsul2 = $!despars[10]
  -- DP 11 = 2nd Lmin dimension
  !lmin2 = $!despars[11]
  -- DP 12 = 2nd N dimension
  !n2 = $!despars[12]


  !!mdsDacControl(true)
  !!ce = $!<name>/SREF
  despar $!dim1  $!dimLMax $!wallBlt $!clearance $!bltStl $!bltBkt $!maxInsul1 $!lmin1 $!n1  $!maxInsul2 $!lmin2  $!n2  $!dimN
  !!mdsDacControl(false)

  !units = object COMUNITS(TRUE)
  UNITS MM DIST
  UNITS MM BORE
  -- Create 4 trunnions

  -- get directions for trunnion branches
  !tdirs = object ARRAY()
  !tdirs[1] = !p9dir
  !tdirs[2] = !p10dir
  !tdirs[3] = !p9dir.opposite()
  !tdirs[4] = !p10dir.opposite()

  !pipeName = !datum.owner.owner.name.replace('=','/')

  -- determine trunnion NB
  !branBore = !datum.lbore
  if (!branBore.real().nint().geq(400) and !branBore.real().nint().leq(450)) then
    !trunBore = 150
  elseif (!branBore.real().nint().geq(500) and !branBore.real().nint().leq(600)) then
    !trunBore = 200
  else
    -- invalid main branch NB - default to equal tee (THIS SHOULD NEVER HAPPEN!)
    !trunBore = !branBore.real().nint()
  endif
  -- get DPs for AC38 end plate for trunnions
  !endPlateDP = !!mdsPar$nAC38[$!trunBore].despars

  !mainBore = !branBore.real().nint()

  -- determine trunnion branch naming prefix
  !tbranName = !pipeName + !name

  -- get PSPE from main branch
  !!ce = !datum
  bran
  !pspe = !!ce.pspe

  -- initialise other vars
  !i = 0
  -- array of trunnion branches
  !tBrans = object ARRAY()
  -- array of trunnion branch tees
  !tTees  = object ARRAY()

  -->> process each trunnion <<--
  !!mdsDacControl(true)


  ---------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------
  --<wd>nov2003
  ---------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------

  do !tdir values !tdirs
    !i = !i + 1
    -- check if trunnion branch already exists, if so then use existing elements
    --<dw>aug2008 dun979 - flow direction turned off
    $!<tbranName>/$!i
    handle any
      NEW BRAN $!tbranName$n/$!i
      flowdir OFF
      !createTee = true
      !tBrans[!i] = !!ce
    elsehandle none
      !tBrans[!i] = !!ce
      -- check we have a valid href to a tee
      goto HREF
      handle any
        !createTee = true
      elsehandle none
        !tTees[!i] = !!ce
        !createTee = false
      endhandle
    endhandle

    -- create tee in main branch if required
    if (!createTee) then
      !!ce = $!<name>/SREF
      NEW TEE
      !tTees[!i] = !!ce
    else
      -- move to tee
      $!tTees[$!i]
    endif

    -- set Tee direction, bore etc.
    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable tee in the current specification')
      delete tee
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentUnits)
      return
    endif

    ----------------------------------------------------------------------------------------------------
    -- SEL WITH PBORE3 $!trunBore STYP STUB
    -- handle any
    -- !!alert.error('Unable to find a suitable tee in the current specification')
    -- delete tee
    -- golabel /continue
    -- endhandle
    ----------------------------------------------------------------------------------------------------

    !!mdsDacControl(true)

    -- position and orientate the tee
    DIST 0
    SEL LSTU
    ORI and P3 is $!tdir

    -- set pipe spec to same as datum branch
    $!tbranName$n/$!i
    PSPE $!pspe

    -- connect to tee
    CONN PH TO P3 of $!tTees[$!i]
    SEL HSTU

    -- set tbore, tcon, tdir etc.
    TBORE $!trunBore
    !tdiropp = !tdir.opposite()
    TDIR $!tdiropp
    pin 1 copy ph
    pin 1 dist ($!standout - $!endPlateDP[1] )
    TPOS PIN 1
    TCON ATT
    :MDSTrun TRUE

    delete BRAN MEM
    handle any
    endhandle

    -- create comment atta in 1st bran
    if (!i.eq(1)) then
      new atta select spref with styp 'COMMENT' spec /MDS
      NAME $!<name>/NOTE1/$!i
      DIST 0
      ORI
      ATTY CCNN
      if !!mdsTRUNNOTES.boolean() then
        STEXT 'DO NOT CUT HOLE IN MAIN PIPE'
      endif
    endif

    -- makeup piece
    --new atta select spref with styp 'MAKEUP' spec /MDS
    new redu select spref with styp 'MAKEUP' spec /MDS
    despar $!trunBore 0mm 0mm
    sel lstu

    !tod = pl od
    !od = !mainBore

    -- Work out the adjustment needed for the exact length to be added to the iso
    !hyp = (!od / 2)
    !side1 = (!tod / 2)
    !makeUp = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

    despar $!trunBore $!makeUp 0mm
    --spkbrk true
    connect and p3 is d
    --atty CCNN
    mtoc OFF
    name $!<name>/MAKEUP/$!i

    -- create end plate atta
    --NEW ATTA sel spref with styp 'AC38' spec /MDS
    NEW PLAT sel spref with styp 'AC38' spec /MDS
    despar $!endPlateDP[1] $!endPlateDP[2] $!endPlateDP[3]
    --spkbrk true
    sel lstu
    name $!<name>/ENDPLATE/$!i
    DIST ($!standout - $!endPlateDP[1])
    ORI
    -- The end cap is part of the IPMSCODE so turn off the material output
    --MTOC OFF
    BRAN
    CONN PT TO LAST MEM
    tconn CLOS

    -- Set the material and shop flags for all comps except the notes
    -- And remove insulation automatically
    ispe =0
    SHOP TRUE
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
      handle any
      endhandle
      ispe =0
      SHOP TRUE
    enddo

  enddo

  ---------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------
  --<wd>nov2003
  ---------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------

  label /continue
  !!mdsDacControl(false)
  !units.restoreSavedBoreDist()

  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)


  -- Update support data held in form
  !!mdsVT19.support = !support

  -- Show dimensions on graphics if required

  if !!mdsVT19.graphicalDim then
    !!mdsshowdim(!!mdsVT19)
  endif

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  !!mdsDacControl(true)

  -- Lock any items that have been locked

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  !!ce = !stru

  -- clear any dimension errors from previous support build and determine
  -- if any min/max errors exist for this build
  !!mdsVT19.dimerrors.clear()

  -- check if the created framework's L dimension (dim 1) is less then minimum
  -- this cannot be checked as part of consistency report as there is no way
  -- at present to calculate the min sctn length taking the pipe OD into account
  if ($!dim1 lt $!dimLmin) then
    !!kRestoreUnits(!currentUnits)
    prec var 1/16
    var !dimLminD dist($!dimLmin)
    units mm bore mm dist
    !error = |Support dimension 1 is less than allow minimum of $!dimLminD|
    !!alert.warning(!error)
    !!mdsVT19.dimerrors.append(!error)
  endif

  -- check if the created framework's L dimension (dim 1) is greater than maximum
  if ($!dim1 gt $!dimLMax) then
    !!kRestoreUnits(!currentUnits)
    prec var 1/16
    var !dimLMaxD dist($!dimLMax)
    units mm bore mm dist
    !error = |Support dimension 1 is greater than allowed maximum of $!dimLMaxD|
    !!alert.warning(!error)
    !!mdsVT19.dimerrors.append(!error)
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing

  !!mdsDacControl(true)

  !!ce = !datum
  !mdsAdp = :MdsAdp
  do !addBran from 1 to 4
    !mdsAdp.append($!tbranName$n/$!addBran )
  enddo
  !mdsAdp.append(bran of $!datum )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  !!ce = !ce

endfunction
