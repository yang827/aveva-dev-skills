--------------------------------------------------------------------------------
--
-- File:    Mdscreatevt20.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Gordon Evans
-- Created:  Wed 22nd Oct 2003
--
--
-- Description:
-- function to create Vessel support frame type 'vt20'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreatevt20(!method is STRING)

  -- Save current db position

  !unusedCe = !!ce

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsresetpins(1,10)
  !form      = !!mdsvt20
  !unusedIdtype    = 'BOX'
  !support   = !!mdsvt20.support
  !unusedClearance = !!mdsoptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !pldir     = !support.pldir
  !unusedPadir     = !support.padir
  !alias     = !support.alias
  !unusedDatumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --<wd>2002
  -- Set Pipe Creation Type, 'SHOE' for Insulated and 'PIPE' for UNINSULATED Pipe
  --  !insutype = !form.type.selection()
  --<wd>2002


  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify both brackets on equipment

  label /Element1
  --<dw>mar2009 dun1119 - HPD0038603 If statement introduced to allow Dim1 to be re-set when method equals DIMENSION
  if (!method neq |DIMENSION|)then
    prompt off
    prompt load escape |Identify support bracket|
    id box @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    prompt dismiss
    prompt on
    !box1 = !!ce
    var !dirp4 dir p4

    -- Is the identified box owned by a piece of equipment
    equi
    handle any
      !!alert.error('Identified box is not owned by a piece of equipment. Please retry')
      golabel /Element1
    elsehandle none
      !equip1 = !!ce
    endhandle

    label /Element3
    prompt off
    prompt load escape |Identify vessel wall|
    id cyli @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    prompt dismiss
    prompt on
    !wall = !!ce


    -- Is the identified cyli owned by a piece of equipment
    equi
    handle any
      !!alert.error('Identified cylinder is not owned by a piece of equipment. Please retry')
      golabel /Element3
    elsehandle none
      !equip3 = !!ce
    endhandle

    -- Is the identified cyli owned by the same piece of equipment
    if !equip1.name.neq(!equip3.name) then
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Identified cylinder is not owned by the same equipment. Aborting!')
      return
    endif

    !atta = !datum

    -- Slide DATUM atta through identified bracket
    !!ce = !datum
    ori
    plane pl clear 0 beh $!box1

    --  Also Slide SREF atta through identified bracket
    !!ce  = !srefName.dbref()
    at prev

    -- Generate Please Wait... Prompt
    !!mdscreatemess(true)

    -- Get design parameters
    !bore = ph bore

    ------------------------------------------------------------------------------------------
    -- mjb >>> 28.04.06 <mds12>

    !mdsattaobj  = object MDSREADPARSDATA()
    !unusedMdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())

    --!despars = !!mdsPar$!alias[$!bore].despars

    !despars = !mdsattaobj.despars
    -- mjb <<< 28.04.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------

    -- Navigate to Stru
    !!ce = !stru

    -- Pins now in position create Framework
    delete stru mem
    handle (41,66) (2,113) (2,113)
    endhandle

    !!ce = !datum

    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    !mdsvert = false

    if (!hdir neq U and !hdir neq D ) then
      !mdstemp = '/MDS/VT20H/$!selection'
    else
      !mdstemp = '/MDS/VT20V/$!selection'
      !mdsvert = true
    endif

    if  (!mdsvert) then
      !!ce = !datum
      ori and p9 is $!dirp4 wrt /*
    endif

    !!ce = !stru

    -- Position Structure at:
    at p9 of $!atta

    new frmw $!name/MAIN
    !frmwsupport = !!ce

    -- Copy required template/s
    !!ce         = $!mdstemp
    !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
    !subs        = !!kCollectAllFor('SUBS', '', !!ce)
    !frameFormat = before(!frmw[1].name, '-FRMW')

    --------------------------------------------------------------------------------------
    -- Navigate back to support and create template elements
    !!ce = !frmwsupport
    copy attrib of $!frmw[1]
    copy mem of $!frmw[1] rename $!frameFormat $!name

    -- Set stru description for template recognition
    !desc = desc of $!mdstemp

    -- Position and Orientate Structure
    !!ce = !stru
    desc '$!desc'

    -- Navigate back to support and create template elements
    do !i indices !subs
      NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
      COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
    enddo

    -- Orientate stru
    stru
    pin 6 copy p2 of $!box1
    ori x is pin 6 and z is U wrt /*

    !!ce = !atta
    !!mdsDacControl(true)

    -- Orientate datum
    if  (!mdsvert) then
      !!ce = $!<name>-SUBS1/PLATE1
      pin 6 at p6
      pin 6 dir p6
      var !pin6dir pin 6 dir WRT /*
      !!ce = !datum
      ori and P9 dir is $!pin6dir
      !ldir = pl dir wrt /*
    endif

    -- Find out which end is furthest away from the vessel and extend by design para 3
    !poss = poss of $!name-BAR-1 wrt /*
    !pose = pose of $!name-BAR-1 wrt /*
    !drns = drns of $!name-BAR-1
    pin 9 at $!poss
    pin 9 dir $!drns
    pin 8 at $!pose
    pin 8 dir $!drns
    pin 7 copy pin 8
    pin 7 plane pin 7 thro $!wall
    var !p7p9dist const dist pin 7 to pin 9
    var !p7p8dist const dist pin 7 to pin 8
    if !p7p9dist.real().gt(!p7p8dist.real()) then
      !nearest  = 'END'
      !furthest = 'START'
      !nearestEnd  = 'POSE'
      !furthestEnd = 'POSS'
    else
      !nearest  = 'START'
      !furthest = 'END'
      !nearestEnd  = 'POSS'
      !furthestEnd = 'POSE'
    endif

    !!ce = $!name-BAR-1

    extend $!furthest thro p9 of $!atta
    extend $!furthest $!despars[3]
    pin 7 plane pin 7 clear -$!despars[2] inf $!box1
    extend $!nearest thro pin 7
    !unusedDeriLength = deri leng

    -- Set atta references to datum cross bar

    !!ce.:MDSAttaRef[1] = !support.datum
    !support.barLen[1] = deri length of CE

    -- Move plate thro furthest end
    var !direction const direction pin 7 to pin 9
    var !otherDirection const direction pin 9 to pin 7

    -- Subs Box/Plate at End of Cross Bar
    !!ce = $!<name>-SUBS1/PLATE1
    handle none
      var !pin7dir pin 7 dir wrt /*
      move $!pin7dir wrt /* clear 0 beh pin 7
      move $!direction wrt world dist $!despars[2]
    elsehandle any
    endhandle

    -- Reset distance gadget to new position
    !!ce = !datum
    call !!mdsDistance(!!mdsvt20)

    -- Set dimensions into srefs despars
    pin 9 direction $!direction
    pin 9 plane pin 9 clear 0 beh $!wall
    pin 8 copy pin 9
    pin 8 plane pin 8 thro $!<name>/DATUM
    var !dim1 const dist pin 9 to pin 8
    !!mdsvt20.dim1.val = $!dim1
    !!mdsDacControl(false)

    -- Select correct spref for sref
    !!ce = $!<name>/SREF
    !!mdsDacControl(true)
    sel spref with styp '$!alias-$!selection' spec /MDF
    !despars[4] = $!selection
    !!ce = $!<name>/SREF
    !!mdsSetIspe()
    !!mdsSelLstu(!!ce)

    -- Set position flag
    !support.position = true

    -- Need to store an additional design parameter to work out the dimension stored in the property code

    pin 10 copy pin 7
    pin 10 direction $!otherDirection wrt /*
    pin 10 plane pin 10 clear 0 inf $!name-BAR-1
    var !beforePosition pin 10 position
    pin 10 plane pin 10 thro $!name-SUBS1/PLATE1
    var !afterPosition pin 10 position
    !despars[5] = !beforePosition.position().distance(!afterPosition.position())

    -- Put despar 5 into dim1 field
    !!mdsvt20.dim1.val = $!despars[5]

    -- Store design parameters
    !!mdsDacControl(true)
    despar $!despars[5]  $!despars[2]  $!despars[3]  $!despars[4]  $!despars[5]

    -- Reset materials of sections
    !!mdsResetMat(!storeMat)

    -- Reset datum tag
    !!ce = !datum
    VAR !pos POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    -- Navigate to Structure
    !!ce = !stru
    --<wd>2002
    -- Slide STRU to side of Vessel Clip(BOX)
    at p9 of $!atta
    move $!pldir clear 0 beh $!box1

    --<dw>mar2009 dun1119 - To align support with vessel clip
    move $!dirp4 wrt site clear0 inf $!box1
    -- Slide DATUM atta through STRU position
    !atta = !datum
    !!ce = !datum
    plane pl through $!stru

    --  Also Slide SREF atta through identified bracket
    !!ce  = !srefName.dbref()
    at prev

    !behind = false

    if  (!mdsvert.not()) then
      !!ce = !datum
      pin 1 at pl
      pin 1 dir pl
      pin 2 copy pin 1
      pin 5 at p5 of $!box1
      !!ce = $!<name>-SUBS1/PLATE1
      pin 3 at p3
      pin 3 dir p3
      pin 4 copy p3
      pin 2 plane pin 2 thro pin 5
      pin 4 plane pin 4 thro pin 5
      var !p1p2dist const dist pin 1 to pin 2
      var !p3p4dist const dist pin 3 to pin 4
      if !p3p4dist.real().gt(!p1p2dist.real()) then
        !behind = true
      endif
    endif

    -- Navigate to Structure
    !!ce = !stru

    if (!behind) then
      move $!pldir clear 0 inf $!box1
    endif


    -- Slide DATUM atta through STRU position

    !atta = !datum
    !!ce = !datum

    plane pl through $!stru

    if  (!mdsvert) then
      !!ce = $!<name>-SUBS1/PLATE1
      !ylen = Ylen
      !!ce = !stru
      if (!ldir neq U) then
        by u $!ylen
      else
        by d $!ylen
      endif
      !atta = !datum
      !!ce = !datum
      plane pl through $!stru
    endif

    --  Also Slide SREF atta through identified bracket
    !!ce  = !srefName.dbref()
    at prev

    --<dw>mar2009 dun1119 - HPD0038602 To allow Dim1 to be re-set when method equals DIMENSION
    !!mdsvt20.dim1.active  = true

  else
    !!ce      = $!<name>/SREF
    !desp     = desp
    !olap     = !desp[2]
    !!ce      = $!<name>-SUBS1/PLATE1
    !platelen = xlen
    !!ce      = $!<name>-BAR-1
    !currderl = derlen
    !dim1     = !!mdsvt20.dim1.val
    !reqdderl = ($!dim1 + $!olap - ($!platelen / 2))
    extend start ($!reqdderl - $!currderl)
    !!ce      = $!<name>/SREF
    desp $!dim1 $!olap $!desp[3] $!dim1
  endif
  --<dw>mar2009 dun1119 - HPD0038602 End of method allowing Dim1 to be re-set.
  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Reset all pins associated with this support
  call !!mdsresetpins(1,10)

  -- Update support data held in form
  !!mdsvt20.support = !support

  -- Show dimensions on graphics if required
  if !!mdsvt20.graphicalDim then
    !!mdsshowdim(!!mdsvt20)
  endif

  -- Lock any items that have been locked
  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  !!mdsDacControl(false)

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  --------------------------------------------------------------------------------------

endfunction
