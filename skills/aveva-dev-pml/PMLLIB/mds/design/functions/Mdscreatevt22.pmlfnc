--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt22.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Tony Martin
-- Created:  15/04/2004 12:23
--
--
-- Description:
-- function to create support frame type 'VT22'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreateVT22(!method is STRING)

  -- Save current db position
  !ce = !!ce

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsResetPins(1,10)
  !form      = !!mdsVT22
  !support   = !!mdsVT22.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  -- Store section name and matref for each member
  -- for reseting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify existing support atta (P4501/P4502)

  if !method eq 'CURSOR' then

    label /Element0

    prompt off
    prompt load escape |Identify existing support lugs on pipe|
    id ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    !supLug = !!ce

    -- Is the identified atta owned by same branch as the datum atta

    bran
    !supLugBran = !!ce.name
    $!datum
    bran
    !datumBran = !!ce.name
    if (!supLugBran.neq(!datumBran)) then
      !!alert.error('Identified ATTA is not owned by same branch as datum ATTA. Please retry')
      golabel /Element0
    endif

    -- Identify vessel Cylinder or Pad

    label /Element1
    prompt off
    prompt load escape |Identify Vessel Cylinder to Connect to|
    var !pl pick
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    -- pline format is 'PPline NALO OF =16388/32752'
    !cyl = !pl[1].dbref()
    if !cyl.type.neq('CYLI') and !cyl.type.neq('RTOR') then
      !!alert.error('Picked Item is Not a Cylinder or RTOR - Please try again')
      golabel /Element1
    endif

    if !cyl.type eq 'CYLI' then
      !rad = !cyl.dia / 2
      !irad = !rad
    else
      !rad = !cyl.routs
      !irad = !cyl.rins
    endif
    !cvec = object POINTVECTOR()
    !cvec.position = !cyl.position.wrt(/* )
    !cvec.direction = up wrt /*

    !newvec = !cvec.through(!datum.position.wrt(/* ))

    -- !newvec.direction = !newvec.towards(!datum.position.wrt(/* ))

    !xvec = !newvec.towards(!datum.position.wrt(/* ))

    !p9dir = !xvec.direction
    --$p p9 dir is $!p9dir
    --!p9dir = !sctn.plor.$!<pline>.zdir().wrt(/* )


    -- check to see if the pline picked is suitable to connect to
    -- poss = !sctn.poss.wrt(/* )
    !pv = object POINTVECTOR()
    !pv.position = !datum.position.wrt(/* )
    !pv.direction = !p9dir.opposite()
    !!mdsVT22.dim1.val = !pv.position.distance(!newvec.position)
    !!mdsVT22.dim2.val = !supLug.prop.hei.real() * 2 + !supLug.lod + 4
    --  const the cutback based on the diameter of the cylinder and the width of the support
    -- first find the overall width of the support
    if !datum.lbore.geq(object bore(65)) and !datum.lbore.leq(object bore(80)) then
      !adjust = 50
    elseif !datum.lbore.eq(object bore(100))  then
      !adjust = 55
    elseif  !datum.lbore.geq(object bore(150)) and !datum.lbore.leq(object bore(200)) then
      !adjust = 60
    else  $*  !datum.lbore.geq(250) and !datum.lbore.leq(500) then
      !adjust = 75
    endif
    -- calculate the outside dimension of the support
    !dim2 = !!mdsVT22.dim2.val + 2 * !adjust
    !maindia = 2 * !rad
    if !dim2 gt !maindia then
      !!alert.error('Cylinder Diameter is too small for this support')
      return
    endif
    !offs = !dim2 / 2
    !cutback = sqrt(!rad.power(2) - !offs.power(2))
    !!mdsVT22.dim1.val = !!mdsVT22.dim1.val - !cutback

  endif $* end of building by cursor(setting dimensions)


  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- go to the attas and reorientate p9 to suit
  !!ce = $!datumName
  ori and p9 is $!p9dir
  !!ce = $!srefName
  ori and p9 is $!p9dir
  !support.p9dir = p9 dir

  -- now reset pin 2 to match p9 of datum (this may have been rotated)
  !!ce = $!datumName
  pin 2 copy p9

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'
  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  ori y is d and z is $!p9dir


  -- position horizontal member's centreline (defined by dimension A)
  -- at centre of top support bracket and move all attas to this new
  -- elevation (this assumes the top brackets to be the datum location
  -- for the support)


  -- get direction for bracing members
  !!ce = $!<name>-V1
  !maxlen = !!ce.desp[1] + 0.5 * !!mdsVT22.dim2.val
  desp $!maxlen
  extend start thro $!datum
  extend start $!!mdsVT22.dim1.val
  !half = !!mdsVT22.dim2.val / 2
  move w dist $!half
  extend end thro $!datum
  extend end $!half

  !!ce = $!<name>-V2
  desp $!maxlen
  extend start thro $!datum
  extend start $!!mdsVT22.dim1.val
  move e dist $!half
  extend end thro $!datum
  extend end $!half

  !!ce = $!<name>-BAR-1
  extend start $!half
  extend end $!half
  move d dist $!half
  !flush = :MDSOlap
  if !flush eq 'OVERLAP' then
    !oNum = :MDSOnum
    extend end $!oNum
    extend start $!oNum
  endif

  !!ce = $!<name>-BAR-2
  extend start $!half
  extend end $!half
  move u dist $!half
  !flush = :MDSOlap
  if !flush eq 'OVERLAP' then
    !oNum = :MDSOnum
    extend end $!oNum
    extend start $!oNum
  endif

  -- now reset V1 an V2 to clear the bar
  !!ce = $!<name>-V1
  extend end beh $!<name>-BAR-2
  -- not required if using overlap
  --extend end 25

  -- extend sections to overlap values if defined
  -- dtf 13sep04
  !flush = :MDSOlap
  if !flush eq 'OVERLAP' then
    !oNum = :MDSOnum
    extend end $!oNum
  endif

  !!ce = $!<name>-V2
  extend end beh $!<name>-BAR-2
  -- not required if using overlap
  --extend end 25

  -- extend sections to overlap values if defined
  -- dtf 13sep04
  !flush = :MDSOlap
  if !flush eq 'OVERLAP' then
    !oNum = :MDSOnum
    extend end $!oNum
  endif

  -- Reset distance gadget to new position
  !!ce = !datum
  call !!mdsDistance(!!mdsVT22)
  !!mdsDacControl(false)

$(
  -- Select correct spref for sref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
$)

  -- Set position flag

  !support.position = true
  !!mdsDacControl(true)

  !!ce = $!<name>/SREF

  if !method eq 'DIMENSION' then
    !despars = !srefName.dbref().despar
    !irad = !despars[3]
  endif

  -- Store design parameters
  despar $!!mdsVT22.dim1.val $!!mdsVT22.dim2.val $!irad

  !!mdsDacControl(false)

  ------------------------------------------------------------------------------------------------------
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentunits)) then
    !!alert.error(!error)
    !!ce = !stru
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 5 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdscreatemess(false)
    !!kRestoreUnits(!currentunits)
    return
  endif

  ------------------------------------------------------------------------------------------------------


  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Update support data held in form
  !!mdsVT22.support = !support

  -- Show dimensions on graphics if required

  if !!mdsVT22.graphicalDim then
    !!mdsshowdim(!!mdsVT22)
  endif

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- Lock any items that have been locked

  !!mdsDacControl(true)

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

$(
  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!sb1 )
  !mdsAdp.append(bran of $!supLug )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

$)

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!ce = !ce
  --------------------------------------------------------------------------------------

endfunction
