--------------------------------------------------------------------------------
--
-- File:  Mdscreatevt23.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MVS101
--
-- Author:  Tony Martin
-- Created:  15/04/2004 12:23
--
--
-- Description:
-- function to create support frame type 'VT23'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscreateVT23(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  call !!mdsResetPins(1,10)
  !form      = !!mdsVT23
  !support   = !!mdsVT23.support
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p9dir     = !support.p9dir
  !p10dir    = !support.p10dir
  !p11dir    = !support.p11dir
  !alias     = !support.alias
  !datumName = !name & '/' & 'DATUM'
  !srefName  = !name & '/' & 'SREF'
  !unlocked  = ARRAY()
  !resetLock = false

  --------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !bore = !!mdsVT23.support.atta[1].abore
  -- Store section name and matref for each member
  -- for reseting later

  -- check to see if the selected type is correct for the bore
  !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!alias , !bore)
  if !supseq neq !!mdsSetSteel.size.val then
    if !supseq neq (0) then
      !!mdsSetSteel.size.val = !supseq
    else
      !!alert.error('Standard not available at this bore ($!bore)')
      return
    endif
  endif

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Identify existing support atta (P4501/P4502)

  if !method eq 'CURSOR' then

    label /Element0
    prompt off
    prompt load escape |Identify Trunnion to Support|
    id ATTA PLAT  @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    !supLug = !!ce
    -- !truntest = !supLug.owner.:mdstrun
    if !supLug.type.neq('ATTA') and !supLug.type.neq('PLAT') then
      !!alert.error('Picked Item is Not a Trunnion - Please try again')
      golabel /Element0
    endif
    if !supLug.type.eq('PLAT') then
      !atname = !!ce.name
      !!ce = $!<atname>/SREF
      handle ANY
        !!alert.error('Cannot get trunnion Type')
        return
      endhandle
      !supLug = !!ce
    endif
    !uppos = !supLug.lbop.wrt(/* )
    if !supLug.:MDSSuppType.eq('TT17') or !supLug.:MDSSuppType.eq('TT24') then
      label /Element1
      prompt off
      prompt load escape |Identify Second Trunnion Leg to Support|
      id ATTA PLAT @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return
      endhandle
      prompt dismiss
      prompt on
      !supLugext = !!ce
      -- !truntest = !supLug.owner.:mdstrun
      if !supLug.type.neq('ATTA') and !supLug.type.neq('PLAT')then
        !!alert.error('Picked Item is Not a Trunnion - Please try again')
        golabel /Element1
      endif
      if !supLugext.type.eq('PLAT') then
        !atname = !!ce.name
        !!ce = $!<atname>/SREF
        handle ANY
          !!alert.error('Cannot get Trunnion Type')
          return
        endhandle
        !supLugext = !!ce
      endif
    endif
    --  !supLug.:MDSSuppType.eq('LT14A')
    -- Identify  brackets on equipment

    --- if !method eq 'CURSOR' then

    label /Element2
    prompt off
    prompt load escape |Identify Vessel Lug to Connect to|
    var !pl pick
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    -- pline format is 'PPline NALO OF =16388/32752'
    !box = !pl[1].dbref()
    if !box.type.neq('BOX') then
      !!alert.error('Picked Item is Not a BOX - Please try again')
      golabel /Element2
    endif
    -- loop through the ppoints of the box and find the nearest to the datum atta
    -- this will set the direction of the support
    !dist = !box.position.wrt(/* ).distance(!datum.position.wrt(/* ))
    do !a from 1 to 6
      !newdist = !box.ppos[!a].wrt(/* ).distance(!datum.position.wrt(/* ))
      if !newdist lt !dist then
        !dist = !newdist
        !ppoint = !a
      endif
    enddo
    !p9dir = !box.pdir[!ppoint].wrt(/* )
    !vec1 = object POINTVECTOR()
    !vec1.position = !box.ppos[!ppoint].wrt(/* )
    !vec1.direction = !p9dir
    !vec2 = !vec1.through(!datum.position.wrt(/* ))
    !dist = !vec1.position.distance(!vec2.position)
    !!mdsVT23.dim1.val = !dist + 150
    !!ce = $!datumName
    Through $!uppos
    -- now check if the previous item is above the datum
    -- if so, reorder the datum before the tee
    do
      !!ce = $!datumName
      if !!ce.owner.members[!!ce.order - 1].apos.up.gt(!!ce.lpos.up) and !!ce.ldir.string().match('U').eq(1) or !!ce.owner.members[!!ce.order - 1].apos.up.gt(!!ce.lpos.up) and !!ce.ldir.string().match('Z').eq(1) then
        !order = !!ce.order
        !prevorder = !order - 1
        bran
        reorder $!order before $!prevorder
      else
        break
      endif
    enddo
    !!ce =  $!srefName
    bran
    reorder $!srefName after $!datumName
    !!ce = $!srefName
    Through $!uppos
    bran rem ce add ce

    -- Identify vessel Cylinder or Pad

    label /Element3
    prompt off
    prompt load escape |Identify Vessel Cylinder to Connect to|
    var !pl pick
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    -- pline format is 'PPline NALO OF =16388/32752'
    !cyl = !pl[1].dbref()
    if !cyl.type.neq('CYLI') and !cyl.type.neq('RTOR') then
      !!alert.error('Picked Item is Not a Cylinder or RTOR - Please try again')
      golabel /Element3
    endif

    if !cyl.type eq 'CYLI' then
      !rad = !cyl.dia / 2
      !irad = !rad
    else
      !irad = !cyl.rins
      !rad = !cyl.rout
    endif


  endif $* end of building by cursor(setting dimensions)


  -- Generate Please Wait... Prompt
  !!mdscreatemess(true)

  -- go to the attas and reorientate p9 to suit
  !!ce = $!datumName
  ori and p9 is $!p9dir
  !!ce = $!srefName
  ori and p9 is $!p9dir
  !support.p9dir = p9 dir

  -- now reset pin 2 to match p9 of datum (this may have been rotated)
  !!ce = $!datumName
  pin 2 copy p9

  -- Navigate to Stru
  !!ce = !stru

  -- Pins now in position create Framework
  delete stru mem
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck

  -- Temporarily Position Structure at Datum Atta
  at $!datum

  new frmw $!name/MAIN
  !frmwsupport = !!ce

  -- Copy required template/s
  !!ce         = /MDS/$!alias/$!selection
  !frmw        = !!kCollectAllFor('FRMW', '', !!ce)
  !subs        = !!kCollectAllFor('SUBS', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  --------------------------------------------------------------------------------------
  -- Navigate back to support and create template elements

  !!ce = !frmwsupport
  copy $!frmw[1] rename $!frameFormat $!name

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection

  -- Position and Orientate Structure
  !!ce = !stru
  desc '$!desc'
  -- Navigate back to support and create template elements
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  stru

  -- Orientate stru
  ori y is U and z is $!p9dir

  if !method eq 'CURSOR' then $* set dim 2
    !b1 = $!<name>-V1
    !b2 = $!<name>-V2
    !!mdsVT23.dim2.val = !b1.position.distance(!b2.position)
  endif

  -- position horizontal member's centreline (defined by dimension A)
  -- at centre of top support bracket and move all attas to this new
  -- elevation (this assumes the top brackets to be the datum location
  -- for the support)


  -- get direction for bracing members
  !!ce = $!<name>-V1
  !width = !!ce.prop.widt.real()
  !maxlen = !!ce.desp[1] + 0.5 * !!mdsVT23.dim2.val
  desp $!maxlen
  extend start thro $!datum
  extend start $!!mdsVT23.dim1.val

  !!ce = $!<name>-V2
  desp $!maxlen
  extend start thro $!datum
  extend start $!!mdsVT23.dim1.val


  -- Reset distance gadget to new position
  !!ce = !datum
  call !!mdsDistance(!!mdsVT23)
  -- if !!mdsVT23.dist.val.lt(0) then
  --   !!mdsreoatta(!datum.owner)
  -- endif

  !!mdsDacControl(false)

$(
  -- Select correct spref for sref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  sel spref with styp '$!alias-$!selection' spec /MDF

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
$)

  -- Set position flag

  !support.position = true
  !!mdsDacControl(true)

  if !method eq 'DIMENSION' then
    !despars = !srefName.dbref().despar
    !irad = !despars[3]
  endif

  !!ce = $!<name>/SREF
  -- Store design parameters
  despar $!!mdsVT23.dim1.val $!!mdsVT23.dim2.val $!irad
  -- now go and adjust the trunnion to suit the dimensions

  !!mdsDacControl(false)

  ------------------------------------------------------------------------------------------------------
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentunits)) then
    !!alert.error(!error)
    !!ce = !stru
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED

    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 5 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdscreatemess(false)
    !!kRestoreUnits(!currentunits)
    return
  endif

  ------------------------------------------------------------------------------------------------------

  -- trim associated trunnions to suit
  if !!alert.confirm('Do You Want to Reset the length of the associated Trunnions?') eq 'YES' then
    if !method neq 'CURSOR' then
      label /Element4
      prompt off
      prompt load escape |Identify Trunnion to Support|
      id ATTA PLAT  @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return
      endhandle
      prompt dismiss
      prompt on
      !supLug = !!ce
      -- !truntest = !supLug.owner.:mdstrun
      if !supLug.type.neq('ATTA') and !supLug.type.neq('PLAT') then
        !!alert.error('Picked Item is Not a Trunnion - Please try again')
        golabel /Element4
      endif
      if !supLug.type.eq('PLAT') then
        !atname = !!ce.name
        !!ce = $!<atname>/SREF
        handle ANY
          !!alert.error('Cannot get trunnion Type')
          return
        endhandle
        !supLug = !!ce
      endif
      !uppos = !supLug.lbop.wrt(/* )
      if !supLug.:MDSSuppType.eq('TT17') or !supLug.:MDSSuppType.eq('TT24') then
        label /Element5
        prompt off
        prompt load escape |Identify Second Trunnion Leg to Support|
        id ATTA PLAT @
        handle (61,528)
          prompt on
          !!kRestoreUnits(!currentunits)
          return
        endhandle
        prompt dismiss
        prompt on
        !supLugext = !!ce
        -- !truntest = !supLug.owner.:mdstrun
        if !supLug.type.neq('ATTA') and !supLug.type.neq('PLAT')then
          !!alert.error('Picked Item is Not a Trunnion - Please try again')
          golabel /Element5
        endif
        if !supLugext.type.eq('PLAT') then
          !atname = !!ce.name
          !!ce = $!<atname>/SREF
          handle ANY
            !!alert.error('Cannot get Trunnion Type')
            return
          endhandle
          !supLugext = !!ce
        endif
      endif
    endif
    !supparray[1] = !supLug
    if defined(!supLugext)then
      !supparray[2] = !supLugext
    endif
    !!mdsresettrunlen(!supparray,!!mdsVT23.dim2.val,!width,100)
  endif
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  -- Reset datum tag

  !!ce = !datum
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Navigate to Structure
  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

  -- Colour Support
  call !!kenhancelist(!colourlist)

  -- Update support data held in form
  !!mdsVT23.support = !support
  -- reset createbydim after the support has been created by cursor
  !!mdsVT23.createByDim.active = TRUE
  -- Show dimensions on graphics if required

  if !!mdsVT23.graphicalDim then
    !!mdsshowdim(!!mdsVT23)
  endif

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- Lock any items that have been locked

  !!mdsDacControl(true)

  if !resetLock then
    do !lock values !unlocked
      !!ce = !lock
      lock all
    enddo
  endif

  -- We need to add the associated branches to the ADP drawlist so they draw on the ADP drawing
  -- plus the equipment

  !!mdsDacControl(true)

$(
  !!ce = !datum
  !mdsAdp = :MdsAdp
  !mdsAdp.append(equi of $!sb1 )
  !mdsAdp.append(bran of $!supLug )
  !mdsAdp.unique()

  do !add from 1 to !mdsAdp.size()
    :MdsAdp number $!add $!mdsAdp[$!add]
  enddo

$)

  !!ce = !stru

  --------------------------------------------------------------------------------------
  -- Remove Wait.. Prompt from Screen
  !!mdscreatemess(false)

  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  --------------------------------------------------------------------------------------

endfunction
