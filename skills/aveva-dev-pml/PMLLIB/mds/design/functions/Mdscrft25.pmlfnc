---------------------------------------------------------------------------------
--
-- File:		Mdscrft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPS149
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 18th November 1997
--
--
-- Description:
-- function to create support Packing Piece 'FT25'
-- for a Support Atta on ANY Standard Framework Cross Bar
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM         Name of Form called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscrft25(!form is FORM)

-- Find current units and set the distance unit to metric

   !CurrentUnits = !!KgetSetUnits()

-- Check to see if form 'Mdsft25' is already shown
-- Then check to see which form it has been called from
    if (!!Mdsft25.shown()) then
      !callb = !!Mdsft25.create.callback
      !xform = !callb.split('!!')
      !yform = !xform[5].split(')')

      if ('$!yform[1]' ne '$!form') then
        !!alert.warning ('The Form for Creating Packing Pieces is already shown and associated with support ''$!!Mdsft25.name.val'' ')
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif

----------------------------------------------------------------------

-- Initialise Variables
  call !!Mdsresetpins(1,10)
    !origin = !!ce
    !support    = !form.support
    !stru       = !support.stru
    !name       = !stru.name
    !datum      = !support.datum
    !clearance  = !!Mdsoptions.clear.val
    !overlap    = !!Mdsoptions.overlap.val
    !frame      = !name & '/MAIN'
    var !supportframe exists $!frame

-- Check if called from Another Framework
    if (!form neq !!Mdsft25) then
      !crtyp = 'frame'
    else
      !crtyp = string()
    endif

--------------------------------------------------------------------------------
-- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Check that Datum atta has been positioned
    if (!Support.Position.not())then
      !!Alert.message('Position Datum support atta before proceeding')
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Check that Framework exists
    if (!supportframe eq 'FALSEA')then
      !!alert.message('Support frame has to exist before Packing Pieces can be added')
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Store section name and matref for each member
-- for reseting later
--)
    !StoreMat = Array()
    !StoreMat = !!MdsStoreMat(!Name)


--> Added - <wd> - 27aug1998
-- Check if More than DATUM exists before continuing
    if (!support.atta.size() lt 3) then
      !!alert.error('Only The DATUM Atta Exists and it cannot have a Packing Piece.')
      !!kRestoreUnits(!currentunits)
      return
    endif
--< Added - <wd> - 27aug1998

--------------------------------------------------------------------------------

-- Identify Support Atta wher Packing Piece is Required
    label /Pick1
    prompt off
    prompt load escape |Identify Support Atta to Add Packing Piece to|
    id atta @
    handle (61,528)
      prompt on
      !!ce = !origin
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    !pick = !!ce

-- Check if Picked Atta is on the Current Framework
    !atta = !support.atta.find(!pick)
    if (!atta.size() lt 1) then
      !!alert.error('The Selected Support Atta is NOT Supported on the Framework - ''$!name'' ')
      golabel /Pick1
    endif

-- Check if the DATUM or the SREF Atta has been picked
    if ((match(!pick.name,'SREF') gt 0) or (match(!pick.name,'DATUM') gt 0)) then
      !!alert.error('The DATUM Support Atta may NOT be selected')
      golabel /Pick1
    endif

-- Cannot add a packer to a trunnion type support

    if !!MDSCheckTrun(!Form,'CE') then
      !!alert.error('You may not add a packer to a trunnion type support member')
      golabel /Pick1
    endif

-- Check if the atta selected is a cable rack or HVAC atta. These cannot have
-- packing pieces.

    !Spec = (purp of spec of pspe of branch)
      handle any
        !!alert.error('Unable to determine branch type from the specification of the branch')
        golabel /Pick1
      endhandle

    if !Spec.eq('HVAC') or !Spec.eq('DUCT') then
      !!alert.error('Unable to create a packing piece beneath a HVAC element')
        golabel /Pick1
    elseif !Spec.eq('TRAY') then
      !!alert.error('Unable to create a packing piece beneath a Cable Rack element')
        golabel /Pick1
    endif


--------------------------------------------------------------------------------

-- Get Correct Cross Bar the Picked Atta is Associated
-- with on the Current Framework
    if (!support.bars.size() leq 1)then
      !xbar = '$!name' & '-BAR-1'
      !!ce  = !xbar.dbref()
    else
      do !index index !support.bars
        !xbar  = '$!name' & '-BAR-$!index'
        !!ce   = !xbar.dbref()
        do !refe index !support.bars[!index]
          if (!support.bars[!index][!refe] eq !pick) then
            !cbar = true
            break
          else
            !cbar = false
          endif
        enddo

        if (!cbar) then
          break
        endif
      enddo
    endif

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Set up Orientation
    !ddir = !support.p9dir
    var !p3p9dir const dir p3 of $!datum to p9 of $!datum
    !udir = !p3p9dir.direction()

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Check the Picked Atta(!pick) is above it's Associated Cross Bar(!xbar)
--<wd>mar03
-- NOTE: - The Packer may now be level with the TOP of the associated Cross Bar
--<wd>mar03
-- Goto Cross Bar
    !!ce = !xbar.dbref()
    !start = poss wrt world
    !end   = pose wrt world
    pin 9 at $!start
    pin 8 at $!end
-- Goto Picked Atta
    !!ce  = !pick
    !anam = !pick.name
    pin 7 copy p9
    pin 7 plane pin 7 thro $!start
-- Check Dimensions
    !checkdist = !!KStrReal('const dist pin 9 to pin 8')
    !dist1 = !!KStrReal('const dist pin 9 to pin 7')
    !dist2 = !!KStrReal('const dist pin 8 to pin 7')
    if (!dist1.gt(!checkdist) or !dist2.gt(!checkdist)) then
      !!alert.error('**Mdscrft25**Atta $!anam is NOT located within the Length of the Associated Cross Bar $!xbar')
      !!kRestoreUnits(!currentunits)
      !!Mdsresetpins(7,9)
      return
    endif

--------------------------------------------------------------------------------

-- Get Distance from the Bottom of the Picked Atta(!pick)
-- to the Top of the Associated Cross Bar(!xbar.dbref())
--<wd>mar03
-- Set Packer Creation Variable
    !createpack = false
--<wd>mar03
    pin 7 copy p9
    pin 7 plane pin 7 clear 0 inf $!xbar
    !dist = !!KStrReal('const dist p9 to pin 7')
    pin 7 dir from p9 to pin 7
      handle (2,357)
        !!Mdsresetpins(7,9)
--<wd>mar03
        --!!alert.error('Atta is sitting directly on the associated cross bar, unable to create a packing piece')
        if (!!alert.confirm('Selected Atta is sitting directly on the associated cross bar. Do you want to continue?').eq('NO')) then
          !!kRestoreUnits(!currentunits)
          return
        else
          !createpack = true
        endif
--<wd>mar03
      endhandle
    var !pin7dir pin 7 dir wrt world
    var !p9dir p9 dir wrt world

-- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !pin7dir.direction()
    !direction.directionB = !p9dir.direction()
    !direction.tolerance  = 0.05

    --if (!!KDirEqualDir(!Direction).not()) then
    if ((!!KDirEqualDir(!Direction).not()) and (!createpack.not())) then
--------------------------------------------------------------------------------
-- Reject Packing Piece Creation if '0'(zero) or a NEGATIVE Value is Calculated
--------------------------------------------------------------------------------
      !distreal = !dist - !dist - !dist
      if (!distreal eq 0) then
        !!alert.error('Packing Distance between Atta $!anam and Cross Bar $!xbar is ''0''-(zero) - Packing Piece is NOT required')
        !!kRestoreUnits(!currentunits)
        !!Mdsresetpins(7,9)
        return
      else
        if (!distreal.abs() gt !!Mdsoptions.maxpack.val.real()) then
          !!alert.error('Atta $!anam and Cross Bar $!xbar Overlap each other by ''$!distreal'' - Packing Piece is NOT required')
          !!kRestoreUnits(!currentunits)
          !!Mdsresetpins(7,9)
          return
        else
          !!alert.error('Atta $!anam and Cross Bar $!xbar Overlap each other by ''$!distreal'' - Packing Piece is NOT required')
          !!kRestoreUnits(!currentunits)
          !!Mdsresetpins(7,9)
          return
        endif
      endif
    else
--------------------------------------------------------------------------------
-- Allow Packing Piece to be Created on the FOREIGN Main FRAMEWORK
-- Present Form to User to Select Size and Type of Packing Piece
--------------------------------------------------------------------------------
      !!ce = !frame.dbref()
      !distreal = !dist

      !!Mdsift25(!crtyp, !name, ||, !form, !pick, !xbar.dbref())

    endif
--------------------------------------------------------------------------------

-- Update support data held in form
    !!Mdsft25.support = !support

--    !!Mdsresetpins(7,9)

  -- Reset materials of sections

    !!MdsResetMat(!StoreMat)

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
  endfunction

-- End of file Mdscrft25.pml
