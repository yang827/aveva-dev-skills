--
-- File:		Mdscrpacksft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 27th November 1997
--
--
-- Description:
--
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R      ARRAY          Atta and Packing Piece Data in sets of five(5)
--                                  in the passed ARRAY
--     2      R      FORM           Name of form this function called from
--
--
-- Return:
--    [Data Type]    [Description]
--
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscrpacksft25(!attapp is ARRAY, !form is FORM)

    !asize = !attapp.size()

    do !data from 1 to $!asize by 5

-- Navigate to Atta
      !!ce = !attapp[!data].dbref()

-- Set Form 'MdsFT25' Data ready to create Required Packing Pieces
-- on the Selected Atta
      !!Mdsft25.fatta = !attapp[!data].dbref()
      !xbar = !attapp[!data + 4].dbref()
      !!Mdsft25.crbar = !xbar

-- Set Type and Size of Packing Piece on form 'MdsFT25'
      !desp2 = !attapp[!data + 2]
      !!Mdsft25.type.select(!desp2.string())
      !!Mdsft25.size.clear()
      !!Mdstagft25(!desp2.string())

      !!Mdsft25.size.select('rtext', !attapp[!data + 3].string())

-- Create Required Packing Pieces at the Current Atta
      call !!Mdscreateft25(!form)

      !!ce = !attapp[!data].dbref()

    enddo

-- End function
  endfunction

-- End of file Mdscrpacksft25.pml
