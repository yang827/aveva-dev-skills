--
-- File:  Mdscrtattavt06.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Wednesday 6th May  1998
--
--
-- Description:
-- Function to create an atta component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdscrtattavt06(!form is FORM)

  -- Initialise variables
  !stru      = !form.support.stru
  !name      = !stru.name
  !fromAtta = !form.support.preliminaryStore.set()

  -- Create the atta Component
  !!mdsDacControl(true)
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    sel spref with styp 'BT01B' spec /MDS
    handle any
      !!alert.error('Question SPRE cannot be answered')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsRestorePre(!!mdsVT06, true)
      !!mdsVT06.hide()
      !!mdsDacControl(false)
      return
    endhandle
  else
    new atta sel spref with styp 'BT01B' spec /MDS
    handle any
      delete atta
      !!alert.error('Support could not be selected. Check size is available at the type required')
      !!mdsDacControl(false)
      return
    endhandle
  endif

  SPKBRK TRUE
  !atta = !!ce
  !!mdsDacControl(false)
  -- set the design parameters for the selected atta
  if (!!mdssetdespars(!atta).not()) then
    return
  endif

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- set Insulation spec...?
  !!mdsSetIspe()

  --  *************************
  --  Add stex for isometrics
  --  *************************

  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  !!mdsSelLstu(!!ce)

  if !fromAtta then
    !newatta = !!ce
  else
    do !count from 1
      name $!<name>.$!count
      handle (41,12)
        skip
      endhandle
      -- Add atta to Form Member atta
      !newatta = !!ce
      !form.support.atta.append(!newatta)
      break
    enddo
  endif

  -- Always add atta to datum cross bar
  if (!form.support.bars.empty())then
    !form.support.bars[1][1] = !newatta
  else
    !form.support.bars[1].append(!newatta)
  endif

endfunction
