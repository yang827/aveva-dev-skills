--
-- File:		Mdscrtrunnvt01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 16th December 1997
--
--
-- Description:
-- Function to create a Trunnion atta component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscrtrunnvt01(!form is FORM)

-- Initialise variables
    !stru      = !form.support.stru
    !name      = !stru.name
    !selection = !!Mdstrunnvt01.standard.selection('rtext')
    !type      = !!ce.type

-- Create the Trunnion Component
    !!MdsDacControl(true)
    new atta sel spref with styp '$!selection' spec /MDS
      handle any
        delete atta
        !!alert.error('Support could not be selected. Check size is available at the type required')
        !!MdsDacControl(false)
        return
      endhandle
    SPKBRK TRUE
    !atta = !!ce
    !!MdsDacControl(false)
-- set the design parameters for the selected atta
    if (!!Mdssetdespars(!atta).not()) then
      return
    endif

-- set despar to 0 0 if not set

   !Despars = despar
   if !Despars.empty() then
   !!MdsDacControl(true)
     despar 0mm 0mm
   !!MdsDacControl(false)
   endif


-- set Insulation spec...?
    !!MdsSetIspe()

--  *************************
--  Add stex for isometrics
--  *************************

    !SAtta = !!CE
    Call !!MdsTransport(!SAtta,!Name)

    !!MdsSelLstu(!!CE)

    var !plbor pl bore

    do !count from 1
      name $!<name>.$!count
        handle (41,12)
          skip
        endhandle
-- Add atta to Form Member atta
      !newatta = !!ce
      !form.support.atta.append(!newatta)
      break
    enddo

-- Always add atta to datum cross bar
      if (!form.support.bars.empty())then
        !form.support.bars[1][1] = !newatta
      else
        !form.support.bars[1].append(!newatta)
      endif

  endfunction
-- End function

-- End of file Mdscrtrunnvt01.pml
