--
-- File:		Mdscrtrunnvt02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 9th January 1998
--
--
-- Description:
-- Function to create a Trunnion atta component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscrtrunnvt02(!form is FORM)

-- Trunnion Selection Form 'Mdstrunnvt01' is Common for all 'VT' type Frameworks
-- Initialise variables
    !stru      = !form.support.stru
    !name      = !stru.name
-- Trunnion Selection Form 'Mdstrunnvt01' is Common for all 'VT' type Frameworks
    !selection = !!Mdstrunnvt01.standard.selection('rtext')
    !type      = !!ce.type

-- Create the Trunnion Component
    !!MdsDacControl(true)
    new atta sel spref with styp '$!selection' spec /MDS
      handle any
        delete atta
        !!alert.error('Support could not be selected. Check size is available at the type required')
        !!MdsDacControl(false)
        return
      endhandle
    SPKBRK TRUE
    !!MdsDacControl(false)
-- set the design parameters for the selected atta
    if (!!Mdssetdespars(!!ce).not()) then
      return
    endif

-- set despar to 0 0 if not set

   !Despars = despar
   if !Despars.empty() then
     !!MdsDacControl(true)
     despar 0mm 0mm
     !!MdsDacControl(false)
   endif



-- set Insulation spec...?
    !!MdsSetIspe()

--  *************************
--  Add stex for isometrics
--  *************************

    !SAtta = !!CE
    Call !!MdsTransport(!SAtta,!Name)

    !!MdsSelLstu(!!CE)

    var !plbor pl bore

    do !count from 1
      name $!<name>.$!count
        handle (41,12)
          skip
        endhandle
-- Add atta to Form Member atta
      !newatta = !!ce
      !form.support.atta.append(!newatta)
      break
    enddo

-- Always add atta to datum cross bar
      if (!form.support.bars.empty())then
        !form.support.bars[1][1] = !newatta
      else
        !form.support.bars[1].append(!newatta)
      endif

  endfunction
-- End function

-- End of file Mdscrtrunnvt02.pml
