--
-- File:		Mdscurrsuppname.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 30th September 1998
--
--
-- Description:
-- Function to CHECK if the FIRST Picked Item Belongs to the Current
-- Type of MDS Framework Type Support
--
-------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF()       Database Reference
--     2      R        FORM          Current Form for the MDS Support
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN()      TRUE or FALSE
-------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscurrsuppname(!dbref is DBREF, !form is FORM) is BOOLEAN

-- Initialise Variables
    !support  = !form.support
    !struname = !form.support.stru.name
    !dbname   = !dbref.name

-- Navigate to STRUCTURE if Possible from Picked Item
    !!ce = !dbref
    stru
    handle (2,111) $* Cannot access element type STRU etc...
      if (!dbref.type.neq('ATTA')) then
        return false
      endif
    elsehandle none
      if (!dbref.owner.type.eq('SUBS')) then
        !dbname = !dbref.owner.name
-- If SUBS is unnamed then get the name of the STRU
        if (!dbname.match('=').eq(1)) then
          !dbname = !!ce.name
        endif
      endif
    endhandle

-- Check if '!dbref' belongs to the Current Support held in '!form'
    if (!dbname.match(!struname).gt(0)) then
      return true
    else
      return false
    endif

  endfunction
-- End of Function

-- End of file Mdscurrsuppname.pml
