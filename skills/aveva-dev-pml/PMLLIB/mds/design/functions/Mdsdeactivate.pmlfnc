--
-- File:                Mdsdeactivate.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              N.Morris
-- Created:             Mon Aug 24
--
--
-- Description:
-- Deactivates the icons that are never used and change their colour
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Comma seperated list of the icons to change
--     2     R         FORM        Calling form
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function

define function !!mdsDeActivate(!form is FORM,!list is STRING)

-- The number of the icon is identified by its grid position as follows

  !icons = ARRAY()

-- Icon Numbers 1 to 5
  !icons.append('Flip')
  !icons.append('Hand')
  !icons.append('AlignSup')
  !icons.append('ModSctn')
  !icons.append('Mdsadp')

-- Icon Numbers 6 to 10
  !icons.append('AddPack')
  !icons.append('DelPack')
  !icons.append('Rotate')
  !icons.append('Newdat')
  !icons.append('Bedplate')

-- Icon Numbers 11 to 15
  !icons.append('Associate')
  !icons.append('ViewAssociate')
  !icons.append('FlipFw')
  !icons.append('ModAtta')
  !icons.append('DeleteAtta')

-- Icon Numbers 16 to 20
  !icons.append('CreateByCur')
  !icons.append('CreateByDim')
  !icons.append('CreateByCle')
  !icons.append('AddPipe')
  !icons.append('AddHVAC')

-- Icon Numbers 21 to 25
  !icons.append('AddRACK')
  !icons.append('AddBar')
  !icons.append('Nudge')
  !icons.append('Spool')
  !icons.append('ViewStd')

-- Icon Numbers 26 to 30
  !icons.append('SetMat')
  !icons.append('CopyLike')
  !icons.append('Dim')
  !icons.append('connect')
  !icons.append('modify')

-- Icon Numbers 31 to 35
  !icons.append('forcecon')
  !icons.append('disconn')
  !icons.append('adploc')
  !icons.append('trimmer')
  !icons.append('rotatt')

-- Icon Numbers 36 to 40
  !icons.append('ancmat')
  !icons.append('anccopy')
  !icons.append('ancnudge')
  !icons.append('trunelbo')
  !icons.append('truntube')

-- Icon Numbers 41 to 45
  !icons.append('setlen')
  !icons.append('trunmat')
  !icons.append('bdist')
  !icons.append('dist')
  !icons.append('bthro')

-- Icon Numbers 46 to 50
  !icons.append('select')
  !icons.append('dim1')
  !icons.append('dim2')
  !icons.append('dim3')
  !icons.append('dim4')

-- Icon Numbers 51 to 55
  !icons.append('revd1')
  !icons.append('revd2')
  !icons.append('setsize')
  !icons.append('newdat')
  !icons.append('cancel')

-- Icon Numbers 56 to 60
  !icons.append('reconnect')
  !icons.append('ancnote')
  !icons.append('flipatta')
  !icons.append('suppdata')
  !icons.append('editatta')

-- Icon Numbers 61 to 65 Misc

  !icons.append('viewflip')
  !icons.append('convspec')
  !icons.append('mtoc')
  !icons.append('addweld')
  !icons.append('repeat')

--<dw>aug2008 Dun979 - Additional icons
-- Icon Numbers 66 to 70

  !icons.append('zoom')
  !icons.append('cutsect')
  !icons.append('bracing')


-- Deactivate list of icons passed to function
  !listAsArray = !list.split(',')

  do !greyOut values !listAsArray
    !gadget = '!!' + !form.name() + '.' + !icons[$!greyOut] + '.active'
    handle ANY
      skip
    endhandle
    $!gadget = false
      handle any
        skip
      endhandle
-- If icon 22 is deactivated add cross bar then the associations 11 and 12
-- will need deactivating as well
    if !greyOut.eq('22') then
      !gadget1 = '!!' + !form.name() + '.' + !icons[11] + '.active'
      !gadget2 = '!!' + !form.name() + '.' + !icons[12] + '.active'
      $!gadget1 = false
      $!gadget2 = false
    endif
-- If icon 24 is deactivated, spooling then the set material can be deactivated
-- as well as the "dimension as" if type is not FT01 FT02

    if !greyOut.eq('24') then
      if !form.name().neq('MDSFT01') and !form.name().neq('MDSFT02') then
        !gadget1 = '!!' + !form.name() + '.' + !icons[26] + '.active'
          handle any
          elsehandle none
            $!gadget1 = false
          endhandle
        !gadget2 = '!!' + !form.name() + '.' + !icons[27] + '.active'
          handle any
          elsehandle none
            $!gadget2 = false
          endhandle
      endif
    endif

  enddo

endfunction
