--
-- File: Mdsdeleteatta.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:   Wed Sept 17
--
--
-- Description:
-- Delete's an atta from a framework support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form Name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsDeleteAtta(!form is FORM)

  --<RM 09/09/08> moved this statement to the start of the function to do the atta check first
  -- Check that Datum atta has been created
  if (!form.support.datum.set().not())then
    !!alert.message('Cannot delete atta as the support has no atta''s to delete')
    return
  endif
  --<RM 09/09/08> end of fix

  -- Check if Support is a MDS FRamework or Ancillary Standard
  -- and Initialise Variables
  if (!form.support.stru.set()) then
    !xstr = TRUE
    !name = !form.support.stru.name
    !namn = !form.support.stru.namn
    !numb = 2
  else
    !xstr = FALSE
    !name = !form.support.datum.name
    !namn = !form.support.datum.namn
    !numb = 1
  endif
  !list = ARRAY()
  !alias = !form.support.alias

  -- Is the datum atta the only one that exists. This will means that only two
  -- elements are in the support object member atta. The DATUM and the SREF.

  if (!form.support.atta.size().leq(!numb)) then
    !!alert.message('Only the datum atta exists, cannot delete an atta')
    return
  endif

  --> Modified - <wd> - 1998
  -- Show Any REST Attas on REAL Pipes at Level 10, so it can be Selected
  if !form.support.datum.type.eq('CTSUPP') then
    !specPurp = 'TRAY'
  else
    !specPurp = !form.support.datum.owner.pspe.purp
  endif

  if (!specPurp.eq('PIPE')) then

    !repremem = ARRAY()
    !reprebra = ARRAY()
    do !val values !form.support.atta
      skip if (!val.owner.pspe.purp.neq('PIPE'))
      handle ANY
      endhandle
      skip if (!val.name.match('SREF').gt(0))
      handle ANY
        skip
      endhandle
      skip if (!val.spre.name.match('REST').eq(0))
      var !repre repre level pipe
      repre level pipe 10
      rem $!val
      add $!val
      !repremem.append(!val)
      !reprebra.append(!val.owner)
    enddo

  endif
  --< Modified - <wd> - 1998

  -- Identify the atta or atta's to delete

  -- do

  label /id

  !list.clear()

  prompt off
  --<wd>feb2004
  --    prompt load escape |Identify atta to delete|
  --    id atta @
  prompt load escape |Identify atta/plat to delete|
  id atta ctsupp plat @
  handle (61,528)

    --> Modified - <wd> - 1998
    -- Show Any REST Attas on REAL Pipes at their Original Drawing Level.
    if (!specPurp.eq('PIPE')) then
      do !nval values !repremem
        repre level pipe $!repre
        rem $!nval
        add $!nval
      enddo
    endif
    --< Modified - <wd> - 1998

    if (!list.set().not()) then
      return
      -- else
      -- break
    endif
  endhandle
  prompt dismiss
  prompt on
  !picked = !!ce
  !pktype = !!ce.type
  --<wd>feb2004
  -- Check If Item is a PLAT and it is a valid type of Cold Isolation Block PLAT
  if ((!picked.type.eq('PLAT')) and (not !picked.styp inset ('AT59','AT68'))) then
    !!alert.message('The selected PLAT is not part of the support or it belongs to a Trunnion')
    golabel /id
  endif
  --<wd>feb2004

  -- Check to see if the identified atta is part of the support
  if (!form.support.atta.findFirst(!picked).set().not())then
    !!alert.message('This atta is not part of the support')
    golabel /id
  elseif (!list.find(!picked).size() gt 0)then
    !!alert.message('Atta already selected')
  elseif (!picked eq !form.support.datum)then
    !!alert.message('Datum atta cannot be deleted')
    golabel /id
  elseif (!picked.name.match('/SREF').gt(0))then
    !!alert.message('Datum atta cannot be deleted')
    golabel /id
  else

    -- Can only delete the atta if we can write to it

    if !!mdsComClaimDac(!!ce,'DACDEL','').not() then
      !!alert.error('Unable to delete the identified atta as write access is not available')
      return
    endif

    !list.append(!picked)
    -- Can we actually delete the atta
    !!mdsDacControl(TRUE)
    if not DACDEL then
      !dacError  = DACERR DELETE
      !!error.text = !picked.fullname & ' can not be claimed as ' & !dacError
      !!alert.error(!!error.text)
      !!mdsDacControl(FALSE)
      return
    endif
    !!mdsDacControl(FALSE)


    -- Colour Attas
    Enhance ce colour 2
    refresh
  endif
  -- enddo

  -- Check to see if the user is sure

  !areyousure = !!alert.confirm('Are you sure you want to delete the selected $!pktype?')

  if (!areyousure eq 'NO') then

    --> Modified - <wd> - 1998
    -- Show Any REST Attas on REAL Pipes at their Original Drawing Level.
    if (!specPurp.eq('PIPE')) then
      do !nval values !repremem
        repre level pipe $!repre
        rem $!nval
        add $!nval
      enddo
    endif
    --< Modified - <wd> - 1998

    unenhance ce
    return

    --------------------------------------------------------------------------------------------

    --------------------------------
    --> Modified - <wd> - 10sep1998
    --------------------------------
  else
    --> Check if referenced GUIDE or BASEPLATE is to be DELETED along with the Selected Atta

    -- Declare ARRAY Variables for GUIDES
    !deleteguide = ARRAY()
    !resetguide  = ARRAY()
    !readguide   = ARRAY()

    -- Declare ARRAY Variables for BASEPLATES
    !deletebpref = ARRAY()
    !resetbpref  = ARRAY()
    !readbpref   = ARRAY()

    -- If Atta has a GUIDE, go to GUIDE reference and DELETE it or RESET the ':MDSGuideRef' attribute to default

    --<wd>jan2004
    if (not !picked.stype inset ('GT01','GT06','GT07','GT08','GT18','GT19','GT01','GT21','GT26','GT28','GT60A','GT60B','GT73','GT74','GT75','GT76')) then
      --<wd>jan2004

      if (!picked.:mDSGuideRef.badRef().not()) then

        !gname = !picked.:mDSGuideRef.name
        enhance $!gname col 2

        -- Check if GUIDE is in a READ ONLY Database
        -- Confirm whether to DELETE or Just RESET to default the ':MDSGuideRef' Atta

        !lock  = STRING()
        !write = STRING()

        if (!!kcheckwrite(!picked.:mDSGuideRef, !lock, !write)) then

          -- WRITE Access to the GUIDE
          if (!write.eq('RW')) then

            --<wd>30jul2004 -- Ignore :MDSGUIDEREF when its the dATUM Atta on the MDS FRAMEWORK - i.e. dATUM ATTA CANNOT be DELETED!
            if (!picked.:mdsGuideRef.neq(!form.support.datum)) then
              -- Fix for HPD0029304 ge 21/07/05
              if !picked.:mDSGuideRef.type NEQ 'PLAT' then
                --if (!!alert.confirm('The Support Atta $!picked.name references a SUPPORT/GUIDE. Do you want to DELETE the SUPPORT/GUIDE $!<gname> highlighted.') eq 'YES')then
                if (!!alert.confirm('The SELECTED ATTA $!picked.name references another ATTA. do you want to DELETE the OTHER ATTA $!<gname> HIGHLIGHTED in RED?') eq 'YES')then
                  --<wd>30jul2004
                  -- GUIDEREF is to BE DELETE
                  !deleteguide.append(!picked.:mDSGuideRef)
                else
                  -- GUIDEREF is NOT to be DELETED, so reset the GUIDES ':MDSGuideRef' attribute to default
                  !resetguide.append(!picked.:mDSGuideRef)
                endif
              endif

              -- WRITE Access to the GUIDE, but it is LOCKED
            elseif (!lock.eq('Locked')) then
              --<wd>30jul2004
              --if (!!alert.confirm('The Support Atta $!picked.name references a SUPPORT/GUIDE. Do you want to DELETE the SUPPORT/GUIDE $!<gname> highlighted.') eq 'YES')then
              if (!!alert.confirm('The SELECTED ATTA $!picked.name references another ATTA. do you want to DELETE the OTHER ATTA $!<gname> HIGHLIGHTED in RED?') eq 'YES')then
                --<wd>30jul2004

                -- GUIDEREF is to BE DELETED
                !deleteguide.append(!picked.:mDSGuideRef)
              else
                -- GUIDEREF is NOT to be DELETED, so reset the GUIDES ':MDSGuideRef' attribute to default
                !resetguide.append(!picked.:mDSGuideRef)
              endif

            endif

            --<wd>30jul2004
          endif
          --<wd>30jul2004

        else
          -- GUIDE is in a READ ONLY Database, and cannot be DELETED or MODIFIED
          !readguide.append(!picked.:mDSGuideRef)
        endif

        -- Unenhance GUIDE
        unenhance $!gname

      endif

      --<wd>jan2004
    endif
    --<wd>jan2004


    --------------------------------------------------------------------------------
    -- If Atta has a BASEPLATE, go to BASEPLATE reference and DELETE it or RESET the ':MDSBpref1' attribute to default
    if (!picked.:mDSBpref1.badRef().not()) then

      !bname = !picked.:mDSBpref1.name
      enhance mem of $!bname col 2

      -- Check if BASEPLATE is in a READ ONLY Database
      -- Confirm whether to DELETE or Just RESET to default the ':MDSBpref1' Atta

      !lock  = STRING()
      !write = STRING()

      if (!!kcheckwrite(!picked.:mDSBpref1, !lock, !write)) then

        -- WRITE Access to the BASEPLATE
        if (!write.eq('RW')) then

          if (!!alert.confirm('The Support Atta $!picked.name references a BASEPLATE. Do you want to DELETE the BASEPLATE $!<bname> highlighted.') eq 'YES')then
            -- BASEPLATE is to BE DELETED
            !deletebpref.append(!picked.:mDSBpref1)
          else
            -- BASEPLATE is NOT to be DELETED, so reset the BASEPLATE ':MDSBpref1' attribute to default
            !resetbpref.append(!picked.:mDSBpref1)
          endif

          -- WRITE Access to the BASEPLATE, but it is LOCKED
        elseif (!lock.eq('Locked')) then

          if (!!alert.confirm('The Support Atta $!picked.name references a BASEPLATE. Do you want to DELETE the BASEPLATE $!<bname> highlighted.') eq 'YES')then
            -- BASEPLATE is to BE DELETED
            !deletebpref.append(!picked.:mDSBpref1)
          else
            -- BASEPLATE is NOT to be DELETED, so reset the BASEPLATE ':MDSBpref1' attribute to default
            !resetbpref.append(!picked.:mDSBpref1)
          endif

        endif

      else
        -- BASEPLATE is in a READ ONLY Database, and cannot be DELETED or MODIFIED
        !readbpref.append(!picked.:mDSBpref1)
      endif

      -- Unenhance BASEPLATE
      unenhance mem of $!bname

    endif

    -- Check if User wants to Continue if GUIDES or BASEPLATES are found in READ ONLY Databases
    if (!readguide.size().gt(0) and !readbpref.size().gt(0)) then

      if (!!alert.confirm('There are references to GUIDES and BASEPLATES on this Support, which are in a READ ONLY Database, and cannot presently be DELETED or MODIFIED. do you wish to Continue?') eq 'NO') then
        return
      else
        !gstring = STRING()
        !gstring = ''
        do !gde values !readguide
          !gstring = !gstring & !gde.name & '; '
        enddo

        !bstring = STRING()
        !bstring = ''
        do !bpr values !readbpref
          !bstring = !bstring & !bpr.name & '; '
        enddo

        !!alert.message('Please Note: The following GUIDES: **  $!gstring  ** and the following BASEPLATES: **  $!bstring  ** are in a READ ONLY Database.')

      endif

    elseif (!readguide.size().gt(0) and !readbpref.size().eq(0)) then

      if (!!alert.confirm('There are references to GUIDES on this Support, which are in a READ ONLY Database, and cannot presently be DELETED or MODIFIED. do you wish to Continue?') eq 'NO') then
        return
      else
        !gstring = STRING()
        !gstring = ''
        do !gde values !readguide
          !gstring = !gstring & !gde.name & '; '
        enddo

        !!alert.message('Please Note: The following GUIDES: **  $!gstring  ** are in a READ ONLY Database.')

      endif

    elseif (!readguide.size().eq(0) and !readbpref.size().gt(0)) then

      if (!!alert.confirm('There are references to BASEPLATES on this Support, which are in a READ ONLY Database, and cannot presently be DELETED or MODIFIED. do you wish to Continue?') eq 'NO') then
        return
      else
        !bstring = STRING()
        !bstring = ''
        do !bpr values !readbpref
          !bstring = !bstring & !bpr.name & '; '
        enddo

        !!alert.message('Please Note: The following BASEPLATES: **  $!bstring  ** are in a READ ONLY Database.')

      endif

    endif

  endif
  --------------------------------------------
  --------------------------------------------

  -- Loop through All GUIDES and/or BASEPLATES stored in the ARRAYS '!deleteguide' and '!deletebpref' and DELETE.
  !deleterefs = ARRAY()
  !deleterefs.appendarray(!deleteguide)
  !deleterefs.appendarray(!deletebpref)

  -- Activate MDS DAC control variable
  !!mdsDacControl(TRUE)

  do !dgde values !deleterefs
    !!ce   = !dgde
    !dtype = !dgde.type
    unlock
    DELETE $!dtype
  enddo

  -- Loop through All GUIDES and/or BASEPLATES stored in the ARRAYS and MODIFY attributes to default.
  -- i.e. '!resetguide', '!resetbpref'
  !resetrefs = ARRAY()
  !resetrefs.append(!resetguide)
  !resetrefs.append(!resetbpref)

  do !indx indices !resetrefs
    if (!indx.eq(1)) then
      !attr = ':MDSGuideRef'
    elseif (!indx.eq(2)) then
      !attr = ':MDSBpref1'
    endif

    do !rgde values !resetrefs[!indx]
      !!ce  = !rgde
      !lok  = !rgde.lock
      if (!lok) then
        unlock
        $!attr default
        lock
      else
        $!attr default
      endif
    enddo

  enddo

  -- Show Any REAL Pipes where the REST Attas have been DELETED at their Original Drawing Level.
  if  !form.support.datum.type.eq('CTSUPP') then
    --do nothing
  elseif (!form.support.datum.owner.pspe.purp.eq('PIPE')) then
    do !bran values !reprebra
      repre level pipe $!repre
      rem $!bran
      add $!bran
    enddo
  endif

  -------------------------------
  --< Modified - <wd> - 10sep1998
  -------------------------------

  -- If the user deletes an atta from the support we cannot restore the frame
  -- work back to it's original dimensions. Issue a warning to the user and
  -- grey out the cancel gadget. First check if it's not already greyed out.
  -- This is only be issued if the support is in modify mode

  if (!form.support.modify) then
    if (!form.cancel.active) then
      !test = !!alert.confirm('If you delete an atta you will not be able to cancel the changes. Do you wish to continue?')
      if (!test eq 'YES') then
        !form.cancel.active = FALSE
      else
        unenhance ce
        !!mdsDacControl(FALSE)
        return
      endif
    endif
  endif

  -- Unlink and delete the selected atta's
  do !del values !list
    -- Unlink the attas from the crossbars
    !!ce = !del
    !attaName = !del.name
    if (!xstr) then
      !!mdsunlinkAtta(!form, !del)
      --<kp>may2012 - MDSSIE04
      !assoc = object MDSASSOCIATION(!form.support.stru,false)
      !assoc.remAssociation(!del)
    endif

    ------------------------------------------------------------------------------------------------------------
    -->>>-<wd>dec2002
    -- Code Added to handle DELETION of Cradle/Wear Pads or Reinforcing Plates
    -- MDS Standards - AT05, AT09 and AT23 + AT65
    if (!del.type.eq('ATTA') and (!del.stype inset ('AT05', 'AT09', 'AT23', 'AT65'))) then
      if (!del.:mdscp3.eq('SHOE')) then
        ------------------------------------------------------------------------------
        -- mjb >>> 04.05.06 <mds12>

        !mdsattaobj  = object MDSREADPARSDATA()
        !mdsattadefs = !mdsattaobj.mdsdefsdata(!del.stype,!del.lbor.real().value())

        !check = object MDSCHECKSTD(!mdsattaobj)

        --!check       = object mdscheckstd()
        -- mjb <<< 04.05.06 end of mod
        ------------------------------------------------------------------------------
        !shoewarning = STRING()
        -- Pad is associated with a SHOE atta by the uda :mdssref and needs to be unset
        -- plus the associated SHOE Height and PAD thickness DESPARS need to be adjusted before DELETION of the PAD
        if (!del.:mdssref.badRef().not()) then
          !shoeref = !del.:mdssref
          -- Shoe Atta Height is always CHECKED and MODIFIED in the <!checkshoeheight(x,y,z) method> below
          -- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
          if (!check.shoeheight(!shoeref,!del,!shoewarning).not()) then
            !!alert.warning(!shoewarning)
          endif
        endif
      endif
    endif
    -- Unset PAD uda :mdssref if the Associated SHOE Atta is being DELETED and NOT the PAD Atta
    if ((!del.type.eq('ATTA')) and (!del.:mdssref.badRef().not())) then
      if (!del.:mdscp3.neq('SHOE')) then
        !!ce  = !del.:mdssref
        !rpad = !!ce
        :mdssref unset
        -- When type.eq('PIPE') reset Property 'OLAP'<dkey> DESPAR to be ZERO
        !dpnum              = !!mdsgetdesp('OLAP')
        !rpad.desp[$!dpnum] = 0
        !rpad.:mdscp3       = 'PIPE'
      endif
    endif
    -- Navigate to Item to be Deleted
    !!ce = !del
    --<<<-<wd>dec2002
    ------------------------------------------------------------------------------------------------------------

    ------------------------------------------------------------------------------------------------------------
    -->>>-<wd>feb2003
    -- Code Added to handle DELETION of Isolation/SlideUnit Pads
    -- MDS Standards - AT40* and AT41*
    if (!del.type.eq('ATTA') and (!del.stype inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F'))) then
      if (!del.:mdscp3.eq('SHOE')) then

        ------------------------------------------------------------------------------
        -- mjb >>> 04.05.06 <mds12>
        !mdsattaobj  = object MDSREADPARSDATA()
        !mdsattadefs = !mdsattaobj.mdsdefsdata(!del.stype,!del.lbor.real().value())

        !check = object MDSCHECKSTD(!mdsattaobj)
        --!check       = object MDSCHECKSTD()
        -- mjb <<< 04.05.06 end of mod
        ------------------------------------------------------------------------------
        !shoewarning = STRING()
        -- Isolation/SlideUnit Pad is associated with a SHOE atta by the uda :mdsguideref and needs to be unset
        -- plus the associated SHOE Height and PAD thickness DESPARS need to be adjusted before DELETION of the PAD
        if (!del.:mdsguideref.badRef().not()) then
          !shoeref = !del.:mdsguideref
          -- Shoe Atta Height is always CHECKED and MODIFIED in the <!checkshoeheight(x,y,z) method> below
          -- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
          if (!check.shoeheight(!shoeref,!del,!shoewarning).not()) then
            !!alert.warning(!shoewarning)
          endif
        endif
      endif
    endif
    -- Unset PAD uda :mdssref if the Associated SHOE Atta is being DELETED and NOT the PAD Atta
    if ((!del.type.eq('ATTA')) and (!del.:mdsguideref.badRef().not())) then

      --<wd>jan2004
      --if (!del.:mdscp3.neq('SHOE')) then
      if (!del.:mdscp3.eq('PIPE')) then
        --<wd>jan2004

        !!ce  = !del.:mdsguideref
        !rpad = !!ce
        :mdssref unset
        -- When type.eq('PIPE') reset Property 'XHEI'<dkey> DESPAR to be ZERO
        !dpnum              = !!mdsgetdesp('XHEI')
        !rpad.desp[$!dpnum] = 0
        !rpad.:mdscp3       = 'PIPE'
      endif
    endif
    ------------------------------------------------------------------------------------------------------------


    --<wd>jan2004
    -- Unset the Guide Reference UDA :mdsguideref from the Pipe Shoe
    if (!del.stype inset ('GT01','GT06','GT07','GT08','GT18','GT19','GT01','GT21','GT26','GT28','GT60A','GT60B','GT73','GT74','GT75','GT76')) then
      !!mdsDacControl(TRUE)
      !!ce = !del.:mdsguideref
      handle ANY
      elsehandle NONE
        :mdsguideref unset
      endhandle
      !!mdsDacControl(FALSE)
    endif
    --<wd>jan2004

    --<<<-<wd>feb2003
    ------------------------------------------------------------------------------------------------------------

    --<wd>feb2004
    -- Code Added to handle DELETION of Cold Isolation Blocks on Trunnion Base Plates
    -- i.e. MDS Standards - AT59/AT68 and READJUST the Associated Trunnion Length correctly
    -- and within the Permitted Trunnion MINIMUM and MAXIMUM Lengths

    -- Get Necessary Information BEFORE AT59 is DELETED
    if (!del.type.eq('PLAT') and (!del.stype inset ('AT59','AT68'))) then
      -- Navigate to Cold Isolation Block - 'PLAT'
      !!ce  = !del
      !vlen = !!kstrreal('cons dist p1 to p2')
      !styp = !del.stype
      -- Navigate to Trunnion Base Plate - 'PLAT'
      prev plat
      !bplt   = !!ce
      !unusedBpltln = !!kstrreal('cons dist p1 to p2')
      -- Identify the Trunnion SREF Atta - Trunnion DESPARS are STORED here
      bran
      !trunname = !!mdsGetSuppname(!!ce)
      same
      !srefname = !trunname & '/SREF'
      !srefatta = !srefname.dbref()
      -- Get the Trunnion Type from the SREF Atta
      !trntyp = !srefatta.styp
      !branch = !srefatta.owner
    endif
    --<wd>feb2004


    -- Navigate to Item to be Deleted
    !!ce = !del


    --<tm> 25/08/2004 check if there are associated lug attas and delete them
    if !pktype.neq('CTSUPP') then
      !!mdsDacControl(TRUE)
      var !olet coll all olet with match(name,'$!del.name') gt 0 for branch
      do !b values !olet
        !!ce = !b.dbref()
        delete olet
      enddo
    endif

    --<tm> 25/08/2004
    -- dtf >>> 02.08.06 check to see if atta has :mdsplate and delete it
    if !pktype.eq('ATTA') then
      !plat = !!ce.:mdsplate
      handle ANY
      elsehandle NONE
        if !plat.unset().not() then
          if !plat.owner.type.eq('PNOD') then
            !!ce = !plat.owner
            delete PNOD
            handle ANY
            endhandle
          endif
        endif
      endhandle
    endif
    -- dtf <<< 02.08.06 end of mod
    !!ce = !del

    !!mdsDacControl(TRUE)
    --    delete atta
    delete $!pktype
    !!mdsDacControl(FALSE)

    --<wd>feb2004
    if (defined(!styp)) then
      if (!styp inset ('AT59','AT68')) then
        -- Now Adjust the Trunnion length etc... after DELETING the AT59/AT68
        -- Having DELETED the AT59/AT68 'PLAT' - We are now automatically at the Owning Trunnion Branch
        if ((!!ce.type.eq('BRAN')) and (!!ce.:mdstrun)) then
          -- Get the Min and Max Length Values of the Trunnion Bore Length
          -- When determining the MIN and MAX trunnion lengths the MAIN BRANCH HBOR size MUST be USED.
          !brahbor = !branch.hbor

          -------------------------------------------------------------------------------
          -- mjb >>> 24.04.06 <mds12>

          !mdstrunobj  = object MDSREADTRUNDATA()

          !mdstrundata = !mdstrunobj.mdstrundata(!trntyp,!brahbor.real().value())
          --true check
          if (!mdstrundata.not()) then
            -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
            if (!mdstrunobj.mdsstd.sactive.not()) then
              -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
              !errormessage = !mdstrunobj.mdsstd.smess
            elseif (!mdstrunobj.mdsstd.cactive.not()) then
              -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
              !errormessage = !mdstrunobj.mdsstd.cmess
            endif
            !!alert.error(!errormessage)
            return
          endif

          !minlen = !mdstrunobj.minlength
          !maxlen = !mdstrunobj.maxlength

          --!minlen  = !!mdspar$!trntyp[$!brahbor].minimum
          --!maxlen  = !!mdspar$!trntyp[$!brahbor].maximum

          -- mjb <<< end of mod
          ------------------------------------------------------------------------------

          -- Determine the Trunnion SREF Atta Despar used to store the Trunnion Length -
          -- The MDS Trunnions DO NOT have a DATA element with a DKEY in order to extract the Trunnion Length DESPAR NUMBER
          --<dw>oct2008 dun979 - Also to allow for additional trunnion types TT42 to TT44
          if (!trntyp.eq('TT25')) then
            !dpnum = 3
          elseif (!trntyp inset ('TT04','TT05','TT06','TT07','TT08','TT09','TT10','TT11','TT12','TT13','TT22','TT28','TT26','TT36','TT42','TT43','TT44')) then
            !dpnum = 5
          endif
          -- Get the Existing Trunnion Length Before Deleting the AT59/AT68
          --<dw>oct2008 dun979 - Also to allow for additional trunnion types TT42 to TT44
          branch
          if (!trntyp inset ('TT04','TT06','TT08','TT10','TT12','TT22','TT25','TT26','TT05','TT07','TT09','TT11','TT13','TT28','TT36','TT42','TT43','TT44')) then
            if (!!ce.href.type.eq('ELBO')) then
              pin 9 copy ph
              pin 9 plane pin 9 thro p0 of $!!ce.href
            else
              -- SET-ON TEE for PIPE, REDU or CROSS
              pin 9 copy ph
            endif
            pin 8 copy pl of $!bplt
            -- Existing trunnion length
            !xtrlen = !!kstrreal('cons dist pin 9 to plane pin 8')
            -- Determine the value of the Modified Trunnion Length
            !ntrlen = (!xtrlen + !vlen)
            --Check if New Trunnion Length is within the MIN/MAX Limits
            if(!ntrlen.lt(!minlen)) then
              !!kformattext.text.val = !minlen
              !minval = TRUE
              !frmlen = !ntrlen.string(!!distancefmt)
              !minfmt = !minlen.string(!!distancefmt)
              !trunlenwarn = |The Required Trunnion Length $!frmlen is less than the minimum allowed. setting Trunnion Length to the minimum of $!<minfmt>|
              -- Set the SREF Atta Despar !dpnum to the Trunnion Length Minimum
              !!mdssetdespar(!srefatta,!dpnum,!minlen)
              !!alert.warning(!trunlenwarn)
            else
              !minval = FALSE
            endif
            --   Check New Trunnion Length Against the Permissible MAXIMUM Height
            if (!ntrlen.gt(!maxlen)) then
              !!kformattext.text.val = !maxlen
              !maxval = TRUE
              !frmlen = !ntrlen.string(!!distancefmt)
              !maxfmt = !maxlen.string(!!distancefmt)
              !trunlenwarn = |The Required Trunnion Length $!frmlen is greater than the maximum allowed. setting Trunnion Length to the maximum of $!<maxfmt>|
              -- Set the SREF Atta Despar !dpnum to the Trunnion Length Maximum
              !!mdssetdespar(!srefatta,!dpnum,!maxlen)
              !!alert.warning(!trunlenwarn)
            else
              !maxval = FALSE
            endif
            -- Trunnion Length is within the Permissible Min/Max Trunnion Length limits,
            -- so silently set the despar for the Trunnion Length at the Trunnion SREF Atta
            if (!minval.not() and !maxval.not()) then
              !!mdssetdespar(!srefatta,!dpnum,!ntrlen)
            endif
            -- Place Pin 8 at Pin 9 - Starting Point for the Trunnion Length
            pin 8 copy pin 9
            -- Place Pin 8 at the NEW Position for the Pleave of the trunnion Base Plate
            if (!minval) then
              pin 8 plane pin 8 dist $!minlen
            elseif (!maxval) then
              pin 8 plane pin 8 dist $!maxlen
            elseif (!minval.not() and !maxval.not()) then
              pin 8 plane pin 8 dist $!ntrlen
            endif
            -- Now Adjust the Trunnion Branch members etc.. as required due to the AT59/AT68 being deleted
            --<dw>oct2008 dun979 - Also to allow for additional trunnion types TT42 to TT44
            !!ce = !bplt
            move pl thro pin 8
            if (!trntyp inset ('TT04','TT08','TT12','TT25','TT26','TT36','TT42','TT43','TT44')) then
              -- Base Plate Only
              tail
              last mem
              if (!!ce.:mdsguideref.badRef().not()) then
                -- Last Member is a Guide Atta
                move pl thro pin 8
              endif
              tail
              conn pt to last mem
              handle ANY
                fconn pt to last mem
              endhandle
              -- Move the last 2 Attas to avoid DATACON Errors
              last atta
              if (!!ce.:mdsguideref.badRef().not()) then
                -- Goto the Trunnion SREF Atta
                prev atta
                at pa of next
              endif
              prev atta
              conn to next
            elseif (!trntyp inset ('TT06','TT10','TT22')) then
              -- Base Plate + Collar Plate etc...
              tail
              last mem
              if (!!ce.:mdsguideref.badRef().not()) then
                -- Last Member is a Guide Atta
                move pl thro pin 8
              endif
              tail
              conn pt to last mem
              handle ANY
                fconn pt to last mem
              endhandle
              -- Move the last 4 Attas to avoid DATACON Errors
              last atta
              prev atta
              at pa of next
              prev atta
              conn to next
              prev atta
              conn to next
              by u 50
              -- Goto the Collar Plate
              !!ce = !bplt
              prev plat
              pin 7 copy pin 8
              pin 7 dist -230
              plane pa thro pin 7
              prev
              conn to next
              atta 1
              conn
            elseif (!trntyp inset ('TT05','TT09','TT13')) then
              -- Bearing Plate + Base Plate
              -- Goto the Bearing Plate and get Thickness
              next plat
              !bearln = !!kstrreal('cons dist p1 to p2')
              move pa up thro pin 8
              tail
              conn pt to last mem
              handle ANY
                fconn pt to last mem
              endhandle
              -- Move the last 3 Attas to avoid DATACON Errors
              last atta
              at pa of next
              prev atta
              conn to next
              prev atta
              conn to next
              by u 50
            elseif (!trntyp inset ('TT07','TT11','TT28')) then
              -- Bearing Plate + Base Plate + Collar Plate etc...
              -- Goto the Bearing Plate and get Thickness
              next plat
              !bearln = !!kstrreal('cons dist p1 to p2')
              move pa up thro pin 8
              tail
              conn pt to last mem
              handle ANY
                fconn pt to last mem
              endhandle
              -- Move the last 3 Attas to avoid DATACON Errors
              last atta
              at pa of next
              prev atta
              conn to next
              prev atta
              conn to next
              by u 50
              -- Goto the Collar Plate
              prev plat
              pin 7 copy pin 8
              pin 7 dist -230
              plane pa thro pin 7
              prev
              conn to next
            endif
          endif
        endif
        !!mdsresetpins(7,9)
      endif
      branch
      tail
      tcon CLOS
    endif
    --<wd>feb2004

    -- remove the deleted atta from forms support.atta object
    !arrayNum = !form.support.atta.findFirst(!del)
    !form.support.atta.remove(!arrayNum)
  enddo

  -- Rename the remaining atta's

  !counter = 1

  do !rename values !form.support.atta

    !!ce = !rename
    handle ANY
      skip
    endhandle
    skip if (match(Name,|/DATUM|) gt 0) or (match(Name,|/SREF|) gt 0)
    !attaName = !!ce.name
    skip if (!attaName.match('.').eq(0))

    !unusedSuffix = (After(Name,|.|))

    !!mdsDacControl(TRUE)
    if (match('$!form.name','/') eq 1) then
      name $!form.name$n.$n$!counter
      handle (41,12)
        !counter = !counter + 1
        skip
      endhandle
    else
      name /$!form.name$n.$n$!counter
      handle (41,12)
        !counter = !counter + 1
        skip
      endhandle
    endif

    !pos = pos wrt /*
    !aidTextNum = 210 + !counter
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!aidTextNum
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!aidTextNum $!counter $<$!pos$>
    !counter = !counter + 1

  enddo

  -- How many atta's have we deleted to remove the extra aidtext
  !howMany = !list.size()
  !firstText = !aidTextNum + 1
  handle (2,751)
    -- If aidtextnum does not exists then you have just deleted the last support
    do !clear from 211 to 259
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!clear
    enddo
  elsehandle NONE
    !lastText = !aidTextNum + !howMany
    do !removeText from !firstText to !lastText
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!removeText
    enddo
  endhandle

  do !del values !list
    -- remove from forms repre member
    !to = !form.repre.size()
    !from   = !to - 1
    !form.repre.removefrom(!from,!to)
    handle ANY
    endhandle
  enddo

  -- Clear all aid text but the datums and redraw

  do !clearAidText from 211 to 259
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!clearAidText
  enddo

  !acounter = 1
  !aidTextNum = 211
  --do !addAidText from 3 to !form.support.atta.size()
  do from 3 to !form.support.atta.size()
    !!ce = /$!form.name$n.$n$!acounter
    handle NONE
      !pos = pos
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!aidTextNum $!acounter $<$!pos$>
    elsehandle ANY
      break
    endhandle
    !acounter = !acounter + 1
    !aidTextNum = !aidTextNum + 1
  enddo

  -- Aid Text
  !!mdsaidtext(!form)

  ------------------------------------------------------
  -->> Only do this BELOW here when a MDS Framework exists
  if (!xstr) then

    -- Check all the cross bars and see if they no longer have any atta's on them
    var !bars coll all sctn with (matchwild(name,'*-BAR-*')) for $!form.support.stru

    -- When we delete an atta and a cross bar has an :MDSAttaRef pointing to it will
    -- display an unknown ref in the :MDSAttaRef attribute therefore we will have to
    -- reset the :MDSAttaRef attribute

    do !reset values !bars
      !!ce = !reset.dbref()
      !refs = :MDSAttaRef
      !size = !refs.size()
      by n 0
      :MDSAttaRef def
      handle ANY
      endhandle
      !sorted = ARRAY()
      do !sort from 1 to !size
        if (!refs[$!sort].badRef()) then
          skip
        else
          !sorted.append($!refs[$!sort])
        endif
      enddo
      !newSize = !sorted.size()
      do !set from 1 to !newSize
        :MDSAttaRef num $!set $!sorted[$!set]
      enddo
    enddo

    do !barsTest values !bars
      !!ce = !barsTest.dbref()
      !barNum = (After(Name,|-BAR-|))
      if (!!ce.:mDSAttaRef.set().not()) then
        !deletedSctn = !!ce.name
        -- Do not delete if framework is a special
        if !form.support.type.neq('SPECIAL') then
          delete sctn
        endif
        -- Remove array variable concerning the deleted cross-bar
        !form.support.bars.remove(!barNum.real())
        handle ANY
          skip
        endhandle
        -- Rename cross bars before adjusting support
        !deletedNum = (After(|$!deletedSctn|,|-BAR-|))
        !from = !deletedNum.real() + 1
        do !rename from !from
          !barCE = !form.support.stru & '-BAR-' & !rename
          !!ce = !barCE.dbref()
          handle ANY
            break
          endhandle
          !newSuff = !rename - 1
          !newSuffName = !form.support.stru & '-BAR-' & !newSuff
          Name $!newSuffName
        enddo
      endif
    enddo

    -- Rebuild Support now we have deleted the atta and maybe a cross-bar

    !type = !!mdsaliasList('$!alias')
    if (!type eq 'Unset') then
      !type = !form.support.type
    endif

    if (!form.support.barlen.empty().not()) then
      !rebuild = '!!mdsCreate' & !type
      $!rebuild('DIMENSION')
    endif

    !!mdsDacControl(TRUE)
    -- Redefine barlen support mem
    var !bars coll all sctn with (matchwild(name,'*-BAR-*')) for $!form.support.stru
    !form.support.barlen.clear()
    !count = 1
    do !setBarLen values !bars
      !!ce = !setBarLen.dbref()
      var !length Deri length
      !newLength = !length.real()
      !form.support.barlen.append(!newLength)
      !count = !count + 1
    enddo

  endif
  --<< Only do this ABOVE here when a MDS Framework exists
  ------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  if (defined (!form.support.stru))then
    !colourList.append(!form.support.stru)
  endif
  if (!form.support.atta.empty().not())then
    !colourList.appendarray(!form.support.atta)
  endif

  -- Colour Support
  Call !!kenhanceList(!colourList)

  !!mdsDacControl(FALSE)

  return

endfunction
