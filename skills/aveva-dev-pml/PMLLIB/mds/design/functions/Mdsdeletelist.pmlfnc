--
-- Author:    A.Boudjnah
-- Created:   Thu March 14 2002
--
--
-- Description:
-- function to delete the element in the given list
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Array        A list of database references to be deleted
--
--
-- Return:
--    [Data Type]   [Description]
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsdeletelist(!list is Array)
   !origin = !!CE
-- Initialise Variables
   !!MdsDacControl(true)
   do !element values !list
      !!CE = !element
      !type = !!CE.type

      delete $!type
   enddo
   !!CE = !origin
   handle any
   endhandle
   !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsdeletelist.pml
