--
-- File:		MdsDeleteSnode.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 23rd June 1998
--
--
-- Description:
-- Function to delete unwanted snodes for a support.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM         [Form  to clear stored joint info]
--     2     R        DBREF        [Snode to delete. May pass sjoi in which case go up a level]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsDeleteSnode(!Form is form, !Sjoi is dbref)

  -- Initialise Variables

  !Refe = !!CE

  !!CE = !Sjoi
  !Name = !Sjoi.name

  SNODE
  handle any
   -- in case sjoi  has not been passed
      !!Alert.Error('Cannot delete a ' & !Sjoi.type & ' using this function')
      return
      -- this should never 'appen
  endhandle

     -- mark joint for deletion
        !Pos = !Sjoi.owner.pos.wrt(worl)
        aid text number 1004 'Joint Unwanted ?' at $!Pos


    -- Enhance elements using colour set for highlight
       !ColourList = ARRAY()
       !ColourList.append(!Sjoi)


    -- Colour Joint to delete
       !!KEnhanceList(!ColourList)

    !Query = !!Alert.Confirm('Joint Highlighted is no longer attached to support, do you wish to delete it?')

    if(!Query.eq('NO')) then
         !!KAidClear('1004','ALL')
         !!CE = !Refe
         handle ANY
         -- incase ce was the deleted element
         endhandle
         return
    else
       DELETE SNODE
-------------------------------------------------------remove when graphics works----------------
       !String = !!MdsRedraw(!!CE)
       $!String
-------------------------------------------------------------------------------------------------

       !!KAidClear('1004','ALL')

-- remove stored info from form

      !Index = !Form.Store.findfirst(!Name)
        !Form.Store.remove(!Index)
        handle any
         -- incase !name is not in the store
        elsehandle none
          do from 1 to 7
           -- remove attributes of !name from the store (this will need changing if the support store is changed)
           !Form.Store.remove(!Index)
          enddo

        endhandle


    endif


  !!CE = !Refe
  handle ANY
    -- incase ce was the deleted element
  endhandle




-- End function
endfunction

-- End of file MdsDeleteSnode.pml
