--
-- File:		Mdsdelft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 18th March 1998
--
--
-- Description:
-- function to delete a support Packing Piece 'FT25'
-- for ANY Standard Framework Cross Bar
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM         Name of Form called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsdelft25(!form is FORM)

-- Initialise Variables
    call !!Mdsresetpins(1,10)
    !origin     = !!ce
    !support    = !form.support
    !stru       = !support.stru
    !name       = !stru.name
    !datum      = !support.datum
    !pldir      = !support.pldir
    !clearance  = !!Mdsoptions.clear.val
    !overlap    = !!Mdsoptions.overlap.val
    !frame      = !name & '/MAIN'
    var !supportframe exists $!frame

--------------------------------------------------------------------------------

-- Check if Current Framework has ANY Valid Packing Piece references
    if (!support.packs.unset()) then
      !novalidpacks = true
    else
      do !numb index !support.packs
        if (!support.packs[!numb].badref()) then
          !novalidpacks = true
        else
          !novalidpacks = false
        endif
      enddo
    endif
    if (!novalidpacks) then
      !!alert.message('The Support ''$!name'' does NOT have any Packing Pieces')
      return
    endif

-- Check if Current Framework has ANY Packing Pieces at all
    if (!support.packs.size().lt(1)) then
      !!alert.message('The Support ''$!name'' does NOT have any Packing Pieces')
      return
    endif

-- Check that Framework exists
    if (!supportframe eq 'FALSEA')then
      !!alert.message('Support frame has to exist before Packing Pieces can be deleted')
      return
    endif

--------------------------------------------------------------------------------

-- Identify Support Section Packing Piece to be deleted
    label /Pick1
    prompt off
    prompt load escape |Identify Support Packing Piece to Delete|
    id sctn @
    handle (61,528)
      prompt on
      !!ce = !origin
      return
    endhandle
    prompt dismiss
    prompt on
    !pick = !!ce

-- Check if Picked Sctn is on the Current Framework and is a Packing Piece
    !pack = !support.packs.find(!pick)
    if (!pack.size() lt 1) then
      !!alert.error('The Selected Section is NOT a Packing Piece Supported on the Framework - ''$!name'' ')
      !!ce = !origin
      golabel /Pick1
    endif

--------------------------------------------------------------------------------

    enhance $!pick col 2

-- Check Atta Ref. associated with the Packing Piece is valid
    if (!pick.:MDSAttaRef[1].badref() or !pick.:MDSAttaRef[1].unset()) then
-- Associated Atta has been deleted or is unset so safe to delete Packing Piece
      if (!!alert.confirm('Are you sure you want to DELETE the selected Packing Piece?') eq 'YES') then
        !pick = !!ce
        delete sctn
        do !index index !support.packs
          if (!pick eq !support.packs[!index]) then
            !support.packs.remove(!index)
          else
            skip
          endif
        enddo
        !!ce = !origin
        handle any
          !!ce = !support.stru
        endhandle
        unenhance $!pick
      else
        unenhance $!pick
        return
      endif
    else
-- Packing Piece has a valid Associated Atta
      if (!!alert.confirm('Are you sure you want to DELETE the selected Packing Piece?') eq 'YES') then
        !atta = !pick.:MDSAttaRef[1]
        enhance $!atta col 2
        !pick = !!ce
        delete sctn
        do !index index !support.packs
          if (!pick eq !support.packs[!index]) then
            !support.packs.remove(!index)
          else
            skip
          endif
        enddo
-- Move Atta back to the same position as the origin of the Support Structure
        !!ce = !atta
        :MDSPackRef default
--xxx        plane pl thro $!support.stru
        plane $!pldir thro $!datum
        !!ce = !origin
        handle any
          !!ce = !support.stru
        endhandle
        unenhance $!atta
      else
        !atta = !pick.:MDSAttaRef[1]
        !!ce = !origin
        unenhance $!pick
        unenhance $!atta
        return
      endif
    endif
--------------------------------------------------------------------------------

-- Update support data held in form
    !!Mdsft25.support = !support
    !form.support      = !!Mdsft25.support

-- Hide Form !!Mdsft25
    !!Mdsft25.hide()

  endfunction
-- End function

-- End of file Mdsdelft25.pml
