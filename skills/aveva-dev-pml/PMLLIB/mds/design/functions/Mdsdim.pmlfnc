-- Description:
-- Function to show the standards dimensions with the graphical aids
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function

define function !!MdsDim(!Form is form)

  -- The val of the button will be set to ON/OFF

  if !Form.GraphicalDim then
  -- First check if datum atta has been created
    if !Form.Support.datum.badref() then
      !!Alert.Error('Datum atta must be created in order to display dimensions')
      return
    endif
    !Form.GraphicalDim = true
    !!MdsShowDim(!Form)
  else
    !Form.GraphicalDim = false
    !!MdsClearDim()
  endif

endfunction

-- End function

-- End of file MdsDim.pml
