--
-- File: Mdsdimline.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Friday 15th Dec 2000
--
--
-- Description:
-- Function to show the standards dimensions with the graphical aids
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function

define function !!mdsdimline(!point1 is POINTVECTOR, !point2 is POINTVECTOR, !osht is REAL, !standout is REAL, !text is STRING,!num is REAL,!prop is REAL)

-- Point1 and Point2 are supplied as the start and end point of the dimension with the
-- direction set to the direction of the projection line.

-- Setup the numbers to be used
  !num1 = !num
  !num2 = !num + 1
  !num3 = !num + 2
  !num4 = !num + 3
  !num5 = !num + 4
  !num6 = !num + 5


-- Set the first projection line start using the supplied point1
    !projline1s = !point1

-- Set the first projection line end using the standout and osht value from the projection line start
    !projline1e = !projline1s.offset(!standout + !osht)

-- Set the second projection line start using the supplied point2
    !projline2s = !point2

-- Set the second projection line end using the standout and osht value from the projection line start
    !projline2e = !projline2s.offset(!standout + !osht)

-- Create projection lines
    aid line num $!num1 $!projline1s.position to $!projline1e.position
    aid line num $!num2 $!projline2s.position to $!projline2e.position

-- Set start point for dimension line
    !dimlines = !point1.line(!standout)
    !dimlinee = !point2.line(!standout)
    var !startarrowdir const direction $!dimlines.endposition to $!dimlinee.endposition
    if !startarrowdir.eq('') then
      var !startarrowdir const direction $!dimlines.startposition to $!dimlinee.endposition
    endif
    var !endarrowdir const direction $!dimlinee.endposition to $!dimlines.endposition
    if !endarrowdir.eq('') then
      var !endarrowdir const direction $!dimlines.endposition to $!dimlinee.startposition
    endif
    !dimarrowst = object POINTVECTOR()
    !dimarrowst.position = !dimlines.endposition

--<wd>27sep2007 -- Defect No. P-2330
-- Using COORD XYZ the POINTVECTOR object ERRORS when the STRING DIRECTION is set to a NEGATIVE value, e.g. '-Y',
-- and is set using the syntax --> !dimarrowst.direction = $!startarrowdir <-- etc...
    --!dimarrowst.direction = $!startarrowdir
    !dimarrowst.direction = !startarrowdir.direction()
--<wd>27sep2007-- Defect No. P-2330

    !dimarrow1 = !dimarrowst.offset(50mm)
    !dimarrowet = object POINTVECTOR()
    !dimarrowet.position = !dimlinee.endposition

--<wd>27sep2007-- Defect No. P-2330
    --!dimarrowet.direction = $!endarrowdir
    !dimarrowet.direction = !endarrowdir.direction()
--<wd>27sep2007-- Defect No. P-2330

    !dimarrow2 = !dimarrowet.offset(50mm)

-- Create dimension line and arrows
    aid line num $!num3 $!dimlines.endposition to $!dimlinee.endposition
    aid arrow num $!num4 at $!dimarrow1.position direction $!endarrowdir height 50mm prop 0.5
    aid arrow num $!num5 at $!dimarrow2.position direction $!startarrowdir height 50mm prop 0.5

-- Find mid point of dimension line and create text
    !textpoint = object LINE()
    !textpoint.startposition = !projline1e.position
    !textpoint.endposition = !projline2e.position
    -- return if the start and endpoints are equal Richard Martin (09/05/06)
    if !textpoint.startposition.eq(!textpoint.endposition) then
      return
    endif
    !textpos = !textpoint.proportion(!prop)
    aid text num $!num6 |$!text| at $!textpos

endfunction
