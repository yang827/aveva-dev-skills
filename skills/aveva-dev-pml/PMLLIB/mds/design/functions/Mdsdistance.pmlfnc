--
-- File: Mdsdistance.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          UDIST
--
-- Author:    I.osborne
-- Created:   Tue May 27
--
--
-- Description:
-- function to determine distance from ce to prev
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsDistance(!form is FORM)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  var !mode MODE

  -- dtf >>> 16.09.04
  -- Get prev component not associated with support
  !datum = !form.support.datum
  !suppName = !datum.name.before('/DATUM')

  --<kp>jan2012 no longer relies that CE is datum atta
  !oldref = !!ce
  !!ce = !datum
  !ceRef = !!ce
  do to 10

    if !datum.type.eq('CTSUPP') then
      !dist = !datum.ppos[1].distance(!datum.owner.ppos[1])
      break
    endif
    if (!mode eq |Forwards|) then
      prev
      handle ANY
        if (!form.support.datum.stype inset ('LT08B','LT08C')) then
          end
          goto href
          prev
          handle ANY
            !prev = ref of bran
            !!ce = !ceRef
            !dist = !!kStrReal('CONST DIST P0 OF CE TO PH')
            break
          elsehandle NONE
            !!mdsSilent = TRUE
            !prevSuppName = !!mdsGetSuppName(!!ce)
            !!mdsSilent.delete()
            if (!prevSuppName NEQ !suppName ) then
              !prev = !!ce
              !!ce = !ceRef
              !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!prev')
              break
            endif
          endhandle
        else
          !prev = ref of bran
          !!ce = !ceRef
          !dist = !!kStrReal('CONST DIST P0 OF CE TO PH')
          break
        endif
      elsehandle NONE
        !!mdsSilent = TRUE
        !prevSuppName = !!mdsGetSuppName(!!ce)
        !!mdsSilent.delete()
        if (!prevSuppName NEQ !suppName ) then
          !prev = !!ce
          !!ce = !ceRef
          !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!prev')
          break
        endif

      endhandle
    else
      next
      handle ANY
        !next = ref of bran
        !!ce = !ceRef
        !dist = !!kStrReal('CONST DIST P0 OF CE TO PT')
        break
      elsehandle NONE
        !nextSuppName = !!mdsGetSuppName(!!ce)
        if (!nextSuppName NEQ !suppName ) then
          !next = !!ce
          !!ce = !ceRef
          !dist = !!kStrReal('CONST DIST P0 OF CE TO P0 OF $!next')
          break
        endif
      endhandle
    endif
  enddo

  -- dtf <<< End of mod
  if (!form.support.datum.stype inset ('AT60')) then
    golabel /labelat60
  else
    if (!dist eq 0) then
      !form.dist.val = 0
      !!kRestoreUnits(!currentunits)
      !!ce = !oldref
      return
    endif
  endif

  -- In case with a thro command for instance the atta might
  -- be behind the origin therefore we have to negate the value
  if !datum.type.eq('CTSUPP') then
    pin 9 connect to p1 of owner of $!datum
    pin 8 copy p2
  else
    if !!ce.order.neq(1) then
      PIN 9 COPY PL OF PREV
      --<jw>29apr2009 - P-16921
      --      PIN 9 AT P0 OF PREV
      PIN 9 PLANE PIN 9 THRO P0 OF PREV
      --<jw>26apr2009
    else
      PIN 9 COPY PH
      PIN 9 AT PH
    endif
    PIN 8 COPY PL
  endif

  var !dir CONST DIR PIN 9 TO PIN 8
  if (!dir eq ||) then
    !form.dist.val = !dist
    !!kRestoreUnits(!currentunits)
    !!ce = !oldref
    return
  endif

  PIN 9 DIR $!dir WRT WORLD
  var !p8dir PIN 8 DIR WRT WORLD

  !checkDir = object KEQUALDIR()
  !checkDir.directionA = !dir.direction()
  !checkDir.directionB = !p8dir.direction()
  !checkDir.tolerance  = 0.05

  if (!!kDirEqualDir(!checkDir)) then
    !form.dist.val = !dist
  else
    !form.dist.val = !dist - !dist - !dist
  endif

  label /labelat60

  call !!mdsResetPins(8,9)

  --<wd>12jul2004
  if (not !form inset (!!mdsFH01)) then
    -- The Hanger Form !!mdsFH01 has already been checked & the form gadgets set - so ignore the code below
    --<wd>12jul2004

    -- In a non planer element has been added to a trunnion then we need to block the distance gadgets
    -- but first turn them all on
    !form.dist.active = TRUE
    handle ANY
    endhandle
    !form.bdist.active = TRUE
    handle ANY
    endhandle
    !form.select.active = TRUE
    handle ANY
    endhandle
    !form.bthro.active = TRUE
    handle ANY
    endhandle
    if !!mdsCheckTrun(!form,'ALL') then
      !form.dist.active = FALSE
      handle ANY
      endhandle
      !form.bdist.active = FALSE
      handle ANY
      endhandle
      !form.select.active = FALSE
      handle ANY
      endhandle
      !form.bthro.active = FALSE
      handle ANY
      endhandle
    else
      if (!form.support.datum.stype inset ('AT60')) then
        !!ce = !form.support.datum
        if (!!ce.order.eq(1)) then
          !at60dist = !!kStrReal('cons dist p0 to ph')
        else
          !at60dist = !!kStrReal('cons dist p0 to p0 of previous')
        endif
        !form.dist.val      = $!at60dist
        !form.support.position = TRUE
        !form.dist.active   = FALSE
        !form.bdist.active  = FALSE
        !form.select.active = FALSE
        !form.bthro.active  = FALSE
      else
        !form.dist.active = TRUE
        handle ANY
        endhandle
        !form.bdist.active = TRUE
        handle ANY
        endhandle
        !form.select.active = TRUE
        handle ANY
        endhandle
        !form.bthro.active = TRUE
        handle ANY
        endhandle
      endif

    endif

    --<wd>12jul2004
    -- The Hanger Form !!mdsFH01 has already been checked & the form gadgets set - so ignore the code above
  endif
  --<wd>12jul2004

  --<kp>jan2012
  !!ce = !oldref
  -- reset units
  !!kRestoreUnits(!currentunits)

endfunction
