--
-- Description:
-- Function to check if a support is being modified
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
---    3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsdonthitthis()

  !!Alert.error('Double clicking a form to remove it, can cause the support to be incomplete. Please do not use this method to remove a form. Use the appropriate button.')

-- End function
endfunction

