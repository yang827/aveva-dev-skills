--
-- File:		Mdselbott02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 23rd February 1998
--
--
-- Description:
-- Function to check suitability of the selected ELBO  against the
-- selection from the 'TT02' Trunnion atta component form '!!Mdstrunnvt01'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          DBREF       Selected Elbow DBREF to which the Selected Trunnion
--                                  is to be attached
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdselbott02(!elbo is DBREF)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

-- Common Trunnion Selection Form Used
    !selection = !!Mdstrunnvt01.standard.selection('rtext')

-- Check Suitability of Selected Trunnion to ELBO
    !!ce   = !elbo
    !padir = pa dir wrt /*
    !pldir = pl dir wrt /*

    if (!selection.match('TT02-C').eq(1)) then
-- Elbo may NOT be VERTICAL to HORIZONTAL or vice versa
      if (!padir eq U or !padir eq D or !pldir eq U or !pldir eq D) then
        !!Mdstrunnvt01.action.clear()
        !!alert.error('The Selected Trunnion type is NOT suitable for the Orientation of the Selected Elbo')
        !!kRestoreUnits(!currentunits)
        return
      endif
-- Elbo MUST be VERTICAL to HORIZONTAL or vice versa for all other Types
    elseif (!selection.match('TT02-A').eq(1)) then
      if (!padir.up neq 1 or !pldir.up neq 1) then
        !!Mdstrunnvt01.action.clear()
        !!alert.error('The Selected Trunnion type is NOT suitable for the Orientation of the Selected Elbo')
        !!kRestoreUnits(!currentunits)
        return
      endif
    elseif (!selection.match('TT02-B').eq(1)) then
      if (!padir.up neq -1 or !pldir.up neq -1) then
        !!Mdstrunnvt01.action.clear()
        !!alert.error('The Selected Trunnion type is NOT suitable for the Orientation of the Selected Elbo')
        !!kRestoreUnits(!currentunits)
        return
      endif
    elseif (!selection.match('TT02-D').eq(1)) then
      if (!padir.up neq -1 or !pldir.up neq -1) then
        !!Mdstrunnvt01.action.clear()
        !!alert.error('The Selected Trunnion type is NOT suitable for the Orientation of the Selected Elbo')
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif

  endfunction
-- End function

-- End of file Mdselbott02.pml
