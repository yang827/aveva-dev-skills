--
-- File:		MdsEndFt22.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPS146
--
-- Author:		I.Osborne
-- Created:		Wed Jun 18
--
--
-- Description:
-- function to create support frame type 22
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsEndFt22(!Support is MdsSUPPORT)

-- Navigate to structure
  !!CE = !Support.Stru

  -- Initialise variables
  !supp = !support.stru
  !!ce = !supp
  handle any
    !!Alert.message('Support has to exist before creation can be ended')
    return
  elsehandle none
    if !!ce.mcount eq 0 then
      !!Alert.message('Support Steel Member Not Yet Created')
      return
    endif
  endhandle

-- Show user message

  if !Support.modify.not() then
    !!Alert.Message('Bedplate is now created. Please position/orientate the structure!!!')
  endif

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
  if (!!MdsModifySupp.Cancel.active.not())then
    !!MdsModifySupp.ApplyForm.remove(5)
    !!MdsModifySupp.Cancel.active = true
  endif

  UNENHANCE ALL FOR CE

  -- Hide Form
  !!Mdsft22.Hide()
  call !!mdscleardim()
  !!MdsDacControl(false)

-- End function
endfunction

-- End of file MdsEndFt22.pml
