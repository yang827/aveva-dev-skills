--
-- File:		Mdsfieldweld.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Jun 26
--
--
-- Description:
-- function to flip the field weld to the other end of the support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Calling form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsFieldWeld(!Form is FORM,!Action is STRING)

  -- If the field weld is at the start, flip to the end and visa versa

  !!CE = !Form.Support.Stru

-- Can only modify the field weld position if we can write to the stru

  if !!MdsComClaimDac(!!ce,'DACMOD','POS').not() then
    !!Alert.Error('Unable to modify the field weld position as write access is not available to the support structure')
    return
  endif


  !Where = :MDSOrigin
  !Sctn  = !Form.support.stru.name & '-BAR-1'

  -- Does cross bar exists yet

  !!CE = !Sctn.dbref()
    handle (41,69) (2,109) (2,109)
      !!Alert.message('Support structure has not been created')
      return
    endhandle

--<wd>jan2001
----------------------------- **** connexions **** -----------------------------
   !Refe         = !!CE
   !HaveJoints = FALSE

   if(!Form.Support.Joints.unset().not()) then
      !Joints     = !form.Support.Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
       handle ANY
        !HaveJoints = FALSE
        !Support.Joints.Clear()
        -- in case they have been deleted and cancel is used
       endhandle
   endif

-- Field Weld NOT required if the MDS SUPPORT is Connected to Steelwork
-- delete aidtext and exit
   if(!havejoints) then
     $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300
     !!ce = !refe
     return
   endif

   !desc = desc of /MDS/TEMPLATES
   if !desc.eq('Framatome Templates') then
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300
     !!ce = !refe
     return
   endif

---------------------------------------------------------------------------------
--<wd>jan2001

  !!CE = !Form.support.stru

  if (!Action eq 'FLIP') then

    if (!Where eq 'START') then
      :MDSOrigin 'END'
      var !Pos ( pose of $!Sctn wrt world )
    else
      :MDSOrigin 'START'
      var !Pos ( poss of $!Sctn wrt world )
    endif

  else

   if (!!CE.:MDSOrigin eq 'START') then
     var !Pos ( poss of $!Sctn wrt world )
   else
     var !Pos ( pose of $!Sctn wrt world )
   endif

  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300 $<Field Weld$> $<$!Pos$>

-- End function
endfunction

-- End of file Mdsfieldweld.pml
