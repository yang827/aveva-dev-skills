--
-- File:		Mdsflip.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 18 September 1997
--
--
-- Description:
-- Function to flip Horizontal Cross Bars (SCTN's) if required. The Main Cross
-- Bar '/{struname}-BAR-1' always supports the datum atta and its orientation
-- is taken as the default for other cross bars on the same framework.
-- Therefore all cross bars MUST have the same Orientation as the
-- Main Cross Bar cross bar '/<struname>-BAR-1'.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]    [Description]
--     1     R        DBREF          Framework Structure Element
--     2     R        MdsSUPPORT    Framework Object
--
-- Return:
--    [Data Type]   [Description]
--
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsflip( !stru is dbref , !Object is MdsSUPPORT )

-- Initialise variables
    call !!Mdsresetpins(1,10)
    !Support = !Object
    !Name    = !Stru

-- Navigate to the Main (Datum Atta's) Cross Bar

    !bar = !stru.name & '-BAR-1'
    !!CE = !bar.dbref()

-- Get Orientation of the Main (Datum Atta's) Cross Bar
    pin 9 at ppline na start
    pin 8 at ppline na end

    pin 9 dir from pin 9 to pin 8
      handle any
          extend end 10
          extend start 10
          pin 9 at ppline na start
          pin 8 at ppline na end
          pin 9 dir from pin 9 to pin 8
          extend end -10
          extend start -10
      endhandle
    var !pindir pin 9 dir wrt /*

-- Check if the Other Cross Bars have the same Orientation as the
-- Main (Datum Atta's) Cross Bar.

    do !bars index !support.bars

      skip if ( !bars eq 1 )

      !barname = !stru.name & '-BAR-' & !bars
      !!CE = !barname.dbref()
      handle any
        break
      endhandle

      pin 9 at ppline na start
      pin 8 at ppline na end

      pin 9 dir from pin 9 to pin 8
        handle any
          extend end 10
          extend start 10
          pin 9 at ppline na start
          pin 8 at ppline na end
          pin 9 dir from pin 9 to pin 8
          extend end -10
          extend start -10
        endhandle

      var !testdir pin 9 dir wrt /*

-- Flip Cross Bar if it does not have the same Orientation as the
-- Main (Datum Atta's) Cross Bar.

          !Direction = object KEQUALDIR()
          !Direction.DirectionA = !TestDir.direction()
          !Direction.DirectionB = !pindir.direction()
          !Direction.Tolerance  = 0.05
          if (!!KDirEqualDir(!Direction).not()) then
            flip
          endif

    enddo

-- Reset all Pins
    Call !!MdsResetPins(1,10)


-- End function

endfunction

