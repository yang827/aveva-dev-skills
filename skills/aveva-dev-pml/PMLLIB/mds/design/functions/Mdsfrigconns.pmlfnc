--
-- Author:		Andrew Kirkland
-- Created:		Thur 16th July 1998
--
--
-- Description:
-- Function to frig the connections after the rotate command because the mirror
-- frame does not use the flip command  and therefore the joint ends are lost
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Sctn that have been rotated]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsfrigconns(!SCTN is dbref)

  -- Initialise Variables
     !Refe = !!CE
     !!CE  = !Sctn
     !Joie = joie
     !jois = jois

  -- flip the end connections around
     JOIE   $!jois
     JOIS   $!joie
  -- repeat this line because restating jois as nulref clears joie as well ---- suspected bug
     JOIE   $!jois

     !!CE = !Refe

-- End function
endfunction

-- End of file Mdsfrigconns.pml
