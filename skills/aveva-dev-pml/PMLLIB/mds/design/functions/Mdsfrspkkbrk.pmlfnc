-- Define function
define function !!Mdsfrspkkbrk(!form is form)is boolean

   if !form.sspkbrk then
      !return = false
   else
      !return = true
   endif

   do !a values !form.support.atta
       $!a
       spkbrk $!return
   enddo
   return !return

endfunction
