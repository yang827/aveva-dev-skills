--
-- File:		MdsFT34tobpl.pmlfnc
--   Type:		Function Definition
--   Group:		MDS Application
--     Keyword:	        MDS	
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 21st December 1999
--
--
-- Description: Function to Determine if the selected FT22 BedPlate is
--              Suitable for the Current FT34 Support Configuration
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsFT34tobpl(!form is FORM, !datum is DBREF, !bedplate is DBREF, !dir is DIRECTION, !tol is REAL, !rtnPick is ARRAY) is ARRAY

-- Initialise Variables
    !array = ARRAY()
    !array[1] = ''
    !array[2] = 'UNSET'
    !pldir = pl dir of $!datum
    !padir = p2 dir of $!datum
    !p9dir = p9 dir of $!datum
    !currentunits = !!kgetsetunits()

-- Get configuration support is to be built to.
    !config = !form.slide.val.real()
    handle any
      !!kRestoreUnits(!currentunits)
      !!Mdsresetpins(9,10)
      return !array
    endhandle
    !configType = !form.slide.selection('RTEXT')

-- Determine if Selected BedPlate is Suitable for the FT34 Configuration
    prompt off
    prompt load escape |Identify Ppoint on FACE of Selected Bed Plate|
    var !point pick ppoint
      handle (61,528)
        prompt dismiss
        prompt on
        !array[1] = ''
        !!kRestoreUnits(!currentunits)
        return !array
      endhandle
    prompt dismiss
    prompt on

    -- set the return pick info
    !rtnPick = !point

    var !pdir dir $!point[1] wrt world
    var !ppos pos $!point[1] wrt world

-- Create Plane on surface
    !planepos   = !ppos.position()
    !surfacedir = !pdir.direction()
    var !plane const plane $!surfacedir thro $!planepos


    if (!configType.eq('ENDVERT') or !configType.eq('ENDHORI')) then

      pin 9 copy p9 of $!datum
      pin 10 at $!ppos wrt world
      var !linea cons line $!p9dir thro pin 9
      var !lineb cons line $!surfacedir thro pin 10
      var !inter const pos inter $!linea $!lineb

      if (!inter.neq('')) then
-- Check ORI of the Selected BedPlate
        if (!form.support.alias.eq('FT34C')) then

          if (!surfacedir.up.eq(0) ) then
  -- Selected BedPlate is PARALLEL to Support SCTN
            !!kRestoreUnits(!currentunits)
            !!Mdsresetpins(9,10)
            return !array
          else
            !array[1] = 'RIGHTANGLE'
            !array[3] = !plane
            var !linea cons line $!pldir thro p0 of $!bedplate
            var !lineb cons line $!p9dir thro p9 of $!datum
            var !inter1 cons pos inter $!linea $!lineb
            pin 10 at $!inter1 wrt world
            var !rldir cons dir pin 10 to p0 of $!datum

            !distance = !!kstrreal('const dist pin 10 to p0 of $!datum')
            if (!distance.leq(!tol))then
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            endif

  -- Set object definition
            !direction = object kequaldir()
            !direction.directiona = !rldir.direction()
            !direction.directionb = !dir
            !direction.tolerance  = 0.05

            if (!!kdirequaldir(!direction)) then
              !array[2] = 'LEFT'
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            else
              !array[2] = 'RIGHT'
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            endif
          endif


        else

          if (!surfacedir.up.eq(1) or !surfacedir.up.eq(-1)) then
  -- Selected BedPlate is PARALLEL to Support SCTN
            !!kRestoreUnits(!currentunits)
            !!Mdsresetpins(9,10)
            return !array
          else
            !array[1] = 'RIGHTANGLE'
            !array[3] = !plane
            var !linea cons line $!pldir thro p0 of $!bedplate
            var !lineb cons line $!p9dir thro p9 of $!datum
            var !inter1 cons pos inter $!linea $!lineb
            pin 10 at $!inter1 wrt world
            var !rldir cons dir pin 10 to p0 of $!datum

            !distance = !!kstrreal('const dist pin 10 to p0 of $!datum')
            if (!distance.leq(!tol))then
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            endif

  -- Set object definition
            !direction = object kequaldir()
            !direction.directiona = !rldir.direction()
            !direction.directionb = !dir
            !direction.tolerance  = 0.05

            if (!!kdirequaldir(!direction)) then
              !array[2] = 'LEFT'
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            else
              !array[2] = 'RIGHT'
              !!kRestoreUnits(!currentunits)
              !!Mdsresetpins(9,10)
              return !array
            endif
          endif

        endif


      else
-- Selected BedPlate is PARALLEL to Support SCTN
        !!kRestoreUnits(!currentunits)
        !!Mdsresetpins(9,10)
        return !array
      endif

    endif

  endfunction
-- End function

-- End of file MdsFT34tobpl()
