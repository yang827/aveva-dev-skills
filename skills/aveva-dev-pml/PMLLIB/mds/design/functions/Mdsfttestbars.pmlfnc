--
--
-- Description:
-- Test Atta and Bars array objects on the ft support forms
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      [support number]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsFtTestBars(!Number is string)

alp req clear
 if(!Number.eq('')) then
    !!alert.error('No value given')
 endif

$p------------------------------------------
$p Support Atta values
$p------------------------------------------
$p Support Bars[1] attas
$p------------------------------------------


 do !i indices !!Mdsft$!Number$n.Support.Bars

   skip if(!i.eq(1))

   $p Support Bar $!i

   q  var !!Mdsft$!Number$n.Support.Bars[$!i]

  enddo

$p------------------------------------------


-- set focus
   !!MdsFtTestBars.number.setfocus()
-- End function

endfunction

-- End of file MdsFtTestBars.pml
