--
-- File:		Mdsgetangletubesctn.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		A.Boudjnah
-- Created:		Wed Mar 13 2002
--
--
-- Description:
-- Returns the angle between a sctnand a pipe tube
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        dbref         branch or branch member
--     2     R        dbref         steel section (SCTN)
--
-- Return:
--    [Data Type]   [Description]
--     Real          angle between the section and the tube.
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsgetangletubesctn(!comp is DBREF, !sctn is DBREF) is Real

-- Save pin1 dir, pos and status (ON/OFF)
--    !!Mdspushpin(1)
-- Save pin2 dir and pos
--    !!Mdspushpin(2)

    $!sctn
    handle (2,107)
    !angle = 0
    return !angle.real()
    -- The CMPF has been deleted
    endhandle
    !type = !!CE.hardtype
    same

    if (!type neq 'CMPF') then

      var !pin1dir dir ppline na of $!sctn wrt /*
      --handle ANY
      --  !angle = 0
      --  return !angle
      --endhandle
      pin1 dir $!pin1dir
      pin1 at pl of $!comp
      handle any
        -- comp is a bran
        pin1 at ph of $!comp
        pin2 copy ph of $!comp
      elsehandle none
        pin2 copy pl of $!comp
      endhandle

-- Get general direction of pleave of datum atta
-- Plane direction is nearest value to 1

      !PLdir = pl dir of $!comp

      if !comp.styp.eq('MH01') then
-- dtf >> Mod to look at absolute directions not in EW NS UD
        !directions = !!mdsremovegrad(!comp)
        !planedir = !directions[1]
      else
        !Up = (abs(!PLDir.up))
        !East = (abs(!PLDir.East))
        !North = (abs(!PLDir.North))
        !Max = max((abs(!Up)), (abs(!East)), (abs(!North)))
        if (!Max.eq(!Up))then
          !PlaneDir = U wrt world
        elseif (!Max.eq(!East))then
         !PlaneDir = E wrt world
        else
          !PlaneDir = N wrt world
        endif
      endif
-- dtf End of Mod

      pin 2 dir $!Planedir
      pin1 dist 10000
      pin2 dist 10000
      var !angle const angle pin1 to p0 of $!comp to pin2
      handle any
        var !angle const angle pin1 to ph of $!comp to pin2
      endhandle

-- Restore pin1
      !!Mdspoppin(1)

-- Restore pin2
      !!Mdspoppin(2)
    endif

    if (!type eq 'CMPF') then
      !angle = 0
    endif

    return !angle.real()

-- End function
  endfunction

-- End of file Mdsgetangletubesctn.pml
