--
-- File:		MdsGetBeamConn.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Thu 11th June 1998
--
--
-- Description:
-- Function to find the main beam to support MDS frame Vertical or the Cross Bar member.
-- Vertical member or Cross Bar Member is passes as argument 2
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT  [Support form object]
--     2     R        DBREF        [Vertical sctn or Cross Bar Sctn]
--
-- Return:
--    [Data Type]   [Description]
--      DBREF       [Supporting Sctn]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetBeamConn(!Supp is Mdssupport, !Upright is dbref) is dbref

--  If passed element is not a section or gensec return nothing
   if !Upright.type.neq('SCTN') and !Upright.type.neq('GENSEC') then
     !nulref = =0/0
     return !nulref
   endif

-- Find current units and set the distance unit to metric
   !CurrentUnits = !!KGetSetUnits()

-- Initialise variables
   !SupportingBeam = object dbref()
   !Refe = !!CE
   !MainBeam[1] = !Supp.Connections[1]
   !MainBeam[2] = !Supp.Connections[2]
   handle ANY
    -- incase clearance pick is used
    -- note: one sctn means both are supported by the same sctn
       Return !MainBeam[1]
   endhandle

  -- if !Supp.type.eq('FT42') then
       -- Return !MainBeam[1]
  -- endif
   !!CE = !Upright

-- calculate line of vertical sctn or cross bar sctn
   !Poss = poss wrt worl
   !Pose = pose wrt worl

   var !VertLine const line join $!Poss to  $!pose
$(
$P
$P
$P
$P======================================================================================
$P*****************-  !!MdsGetBeamConn -- START -*************************
$P=================================
$P !upright sctn name is:
q var !upright.fullname
$P------------------------
$P
$)


-- calculate line of supporting beams
   do !ind indices !MainBeam

--if (!upright.:mdsconn.name.eq(!MainBeam[1].name))
--endif

      !!CE = !MainBeam[!ind]
      !Poss = poss wrt worl
-- Added handle incase passed element is not a sctn/gensec
        handle ANY
          !nulref = =0/0
          return !nulref
        endhandle
      !Pose = pose wrt worl

-- get sctn width for tolerance for position check
      !Width = !!MdsGetSctnWidth(!MainBeam[!Ind])

-- Determine MAINBEAM DEPTH from its Dataset
-----------------------------------------------------------------------------------------------
--<wd>-jan2004->>>
-- Check if Identified SCTNs for the Connections have a DATASET reference
      !edata = ARRAY()
      !edept = ARRAY()

--<wd>may2007<mds12>
-- Check if the DATASET REFERENCE EXISTS
!xce = !!ce
!!ce = !mainbeam[!ind].dtref
handle NONE
  !!ce = !xce
--<wd>may2007<mds12>

      if (!mainbeam[!ind].dtref.badref().not()) then
--<wd>-jan2004-<<<
        !edata = !!kcollectallfor('DATA', 'DKEY eq |DEPT|' , !mainbeam[!ind].dtref )
        if !edata.empty() then
          !edata = !!kcollectallfor('DATA', 'DKEY eq |YLEG|' , !mainbeam[!ind].dtref )
        endif
--<wd>-jan2004->>>
      endif
--<wd>-jan2004-<<<
-----------------------------------------------------------------------------------------------

--<wd>may2007<mds12>
elsehandle ANY
-- DATASET REFERENCE does NOT EXIST
endhandle
--<wd>may2007<mds12>

-- When !edata is empty there is no data member with a DEPT/YLEG dkey, therefore calculate depth
      if !edata.size().eq(0) then
        var !SavePin9Pos pin 9 pos wrt /*
        var !SavePin9Dir pin 9 dir wrt /*

        var !SavePin8Pos pin 8 pos wrt /*
        var !SavePin8Dir pin 8 dir wrt /*

        pin 9 copy p9 of $!Supp.Datum
        pin 8 copy pin 9
        pin 9 plane pin 9 clear 0 inf $!mainbeam[$!ind]
        pin 8 plane pin 8 clear 0 beh $!mainbeam[$!Ind]
        var !depth const dist pin 9 to pin 8
        !edept[1] = '$!Depth'
        pin 9 dir $!SavePin9Dir wrt /*
        pin 9 at $!SavePin9Pos wrt /*
        pin 8 dir $!SavePin8Dir wrt /*
        pin 8 at $!SavePin8Pos wrt /*
--<wd>oct2004
        --!!ce   = !mainbeam[1]
        !!ce   = !mainbeam[!ind]
--<wd>oct2004
      else

        !edkey = object block('!edata[!evalindex].dkey')
        !edval = !edata.evaluate(!edkey)
        !epurp = object block('!edata[!evalindex].purp')
        !epval = !edata.evaluate(!epurp)
        !enumb = object block('!edata[!evalindex].numb')
        !enval = !edata.evaluate(!enumb)
--<wd>oct2004
        --!!ce   = !mainbeam[1]
        !!ce   = !mainbeam[!ind]
--<wd>oct2004
        !edept = $!epval[1] number $!enval[1]

      endif

      var !MBLine[!ind] const line join $!Poss to $!Pose
      var !PosTest const pos inter $!MBLine[$!ind] $!VertLine
      -- var !PosTest const pos inter $!vertline $!MBLine[$!ind]

--$P---  !posTest = position intersection of !mbline !vertline ---
--q var !postest !mbline !vertline

        !inter = !postest.position()

--<wd>nov2004 -- Only DO this if the variable "!inter" has been set.
-- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance of 0.05
-- If TRUE then set the "!inter" variable to "unset" which will in turn automatically
-- set and FORCE the !Parallel variable to TRUE
        if (!inter.set())then
          !dira = !mbline[!ind].after('line ').before( 'through').direction()
          !dirb = !vertline.after('line ').before( 'through').direction()
-- Set KEQUALDIR object definition
          !checkdir = object kequaldir()
          !checkdir.directiona = !dira
          !checkdir.directionb = !dirb
          !checkdir.tolerance  = 5
--$P===================
          if (!!mdsdirequaldir(!checkdir)) then
-- If TRUE then set the "!inter" variable to "unset"
            !inter = object position()

          endif
--q var !inter
        endif
--<wd>nov2004

--$P === q var !mbline[!ind] !vertline
--q var !mbline[!ind] !vertline
--$Pxxx -- after !inter =
--q var !inter

-- The Iteration of the "!Mainbeam" array is Skipped if the "!inter" variable is UNSET
      if (!inter.unset()) then
--$P
--$P Skipping INDEX $!ind in the do Loop...................................
--$P
       skip
      endif
--<wd>nov2004


--<wd>nov2004 --ORIGINAL CODE uses a STRING to TEST
      if(!PosTest.eq('')) then
         skip
      endif

-------------------------------------------------------------------------------------------------
      var !PosTestnear const pos near $!PosTest on $!VertLine

-- Convert to Position objects in World Co-Ordinates
--<wd>oct2004
      --!PosTestPML2     = !PosTest.position()
      --!PosTestNearPML2 = !PosTestNear.position()
      !PosTestPML2     = !PosTest.position().wrt(/* )
      !PosTestNearPML2 = !PosTestNear.position().wrt(/* )
--<wd>oct2004

      if (!supp.type inset ('FT15')) then
       !EastChk  = (abs(!PosTestPML2.East - !PosTestnearPML2.East) / !edept[1])
        !NorthChk = (abs(!PosTestPML2.North - !PosTestnearPML2.North) / !edept[1])
        !UpChk    = (abs(!PosTestPML2.Up - !PosTestnearPML2.Up) / !edept[1])
        if(!EastChk.lt(1) and !NorthChk.lt(1) and !UpChk.lt(1)) then
          !SupportingBeam = !MainBeam[!ind]
          break
        endif
      else

        !EastChk  = (abs(!PosTestPML2.East - !PosTestnearPML2.East) / !Width)
        !NorthChk = (abs(!PosTestPML2.North - !PosTestnearPML2.North) / !Width)
        !UpChk    = (abs(!PosTestPML2.Up - !PosTestnearPML2.Up) / !Width)
        if (!EastChk.lt(1) and !NorthChk.lt(1) and !UpChk.lt(1)) then
          !SupportingBeam = !MainBeam[!ind]
          break
        endif
      endif

      !SupportingBeam = !MainBeam[!ind]

   enddo

$(
$P *** !SupportingBeam = !MainBeam[!ind]
q var !ind !supportingbeam.fullname
$P============================================================================
$P=============================== FINISH =====================================
$P
$P
$P
$)

--  if(!SupportingBeam.unset()) then
-- not needed really
  --   !!alert.error('not able to determine supporting beam')
  --endif

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- return to original
   !!CE = !Refe

-- Return the SCTN to which the connection is to be made.
   Return !SupportingBeam

-- End function
endfunction

-- End of file MdsGetBeamConn.pml
