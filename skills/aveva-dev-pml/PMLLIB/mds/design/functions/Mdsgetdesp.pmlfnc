-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to return the design parameter number of a certain DKEY
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        DKEY Value
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetDesp(!Dkey is STRING) is REAL

  -- Returns the despar number of the DKEY supplied

  -- Initialise Variables
    var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq '$!Dkey') for dtref
    var !numbers eval num for all from !mem

    !Value = !numbers[1].real()
      handle none
        return !Value.real()
      elsehandle (2,752)
        return 0
      endhandle

return

endfunction
