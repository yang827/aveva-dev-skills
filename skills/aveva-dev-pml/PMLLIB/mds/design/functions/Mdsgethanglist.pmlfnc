--
-- File:    Mdsgethanglist.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Thu March 14 2002
--
--
-- Description:
-- function to return an array containing the Rest and the Fitt of the current atta (supptype: FH01, VH01...)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        The database reference to the atta
--
--
-- Return:
--    [Data Type]   [Description]
--      Array         Array contains the Rest and the steelwork fitting associated with the atta
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsgethanglist(!atta is DBREF) is ARRAY

  --dun1218 add the attaName variable
  !attaName = !atta.name

  -- Initialise Variables
  !ce = !!ce

  !list = ARRAY()
  !!ce = !atta
      goto cref
      handle none
        -- we have a valid connection to an hanger
        -- Go to rest
        rest
        golabel /CONT
      elsehandle any
        -- No connection to an Hanger
        -- try using rest name
    !restName = !!ce.name & '/REST'
    !!ce = !restName.dbref()
        handle none
          --found restr
          golabel /CONT
        elsehandle any
        endhandle
      endhandle
      return !list

label /CONT
        -- append the fittings
        !hangers = mem hangers
        do !hanger values !hangers
    !!ce = !hanger
          goto tref
    handle ANY
      --dun1218 we may have a situation where the hanger tref is unset but a fitting exists, this is most likely when we are creating
      --hangers in situations where we have no write access to supporting steelwork and we are using the virtual fitting mechanism to create the hanger
      --in this case we search for the appropriate fitting/sbfi using the atta name
      !hangerName = !!ce.name
      !hangerCode = !attaName + '/H'
      !hangerNum = !hangerName.after(!hangerCode)
      !fittName = !attaName + '/FITT/H' + !hangerNum
      !sbfiName = !attaName + '/SBFI/H' + !hangerNum

      !!ce = !fittName.dbref()
      handle ANY
        !!ce = !sbfiName.dbref()
        handle ANY
          --dun1218 can't find anything so do nothing
        elsehandle NONE
          -- hanger is connected to a sctn fitting which need also to be modified/deleted/copied/moved
          if(not !!ce.type eq 'HANG') then
            !list.append(!!ce)
          endif
          same
        endhandle
      elsehandle NONE
        -- hanger is connected to a sctn fitting which need also to be modified/deleted/copied/moved
        if(not !!ce.type eq 'HANG') then
          !list.append(!!ce)
        endif
        same
      endhandle
          elsehandle none
            -- hanger is connected to a sctn fitting which need also to be modified/deleted/copied/moved
      if(not !!ce.type eq 'HANG') then
        !list.append(!!ce)
            endif
            same
          endhandle
        enddo
        rest

  !list.append(!!ce)

  !!ce = !ce
  handle any
  endhandle
  return !list

endfunction
