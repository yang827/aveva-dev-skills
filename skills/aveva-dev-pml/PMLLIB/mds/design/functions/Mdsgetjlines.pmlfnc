--
--
-- Description:
-- Function to extract available jlines to use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [joint spco selected in form list]
-- Return:
--    [Data Type]   [Description]
--     ARRAY        [Array of jlines available, return straight into gadget]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsgetjlines(!Joint is dbref) is array

  -- Initialise Variables

     !Jlines = plname of $!Joint

     Return !Jlines


-- End function
endfunction

-- End of file Mdsgetjlines.pml
