--
-- File:		MdsGetJoints.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 23rd June 1998
--
--
-- Description:
-- Function to find out the joints of connected sctns and pass them to the support.joints array
-- when modifying
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [ARRAY]       [Array of Steel sctn members connected]
-- Return:
--    [Data Type]   [Description]
--     ARRAY        [Array of joints found ]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetJoints(!Verts is array) is array

  -- Initialise Variables
  !Joints = Array()
  !ceref = !!ce

  do !Indv indices !Verts
    !!ce = !verts[!indv]
    !stru = !!ce.owner.owner
    skip if (!stru.type.neq('STRU'))
    !supptype = !!ce.owner.owner.:MDSSuppType

    !Ends = Array()
    !Ends[1] = jois of $!Verts[$!Indv]
    !Ends[2] = joie of $!Verts[$!Indv]

    if (!supptype.eq('FT15')) then
      do !Ind indices !Ends
        if(!Ends[!Ind].Unset()) then
          skip
        elseif(!Ends[!Ind].owner.owner.eq(!Verts[!Indv].:MDSConn)) then
          !joints[!ind] = !ends[!ind]
        elseif(!Ends[!Ind].owner.owner.eq(!Verts[!Indv].:MDSXConn)) then
          !joints[!ind] = !ends[!ind]
        endif
      enddo

    elseif (!supptype.eq('FT28')) then
      do !Ind indices !Ends
        if(!Ends[!Ind].Unset()) then
          skip
        else
          if (!indv.eq(1)) then
            !joints[1] = !ends[1]
            !joints[3] = !ends[2]
          else
            !joints[2] = !ends[1]
            !joints[4] = !ends[2]
          endif
        endif
      enddo

    else
      do !Ind indices !Ends
        if(!Ends[!Ind].Unset()) then
          skip
        elseif(!Ends[!Ind].owner.owner.neq(!Verts[!Indv].:MDSConn)) then
          skip
        elseif(!Ends[!Ind].owner.owner.eq(!Verts[!Indv].:MDSConn)) then
          !joints[!indv] = !ends[!ind]
        endif
      enddo
    endif

  enddo



-- Set CE back
  !!ce = !ceref
-- Return External Joints
Return !Joints

-- End function
endfunction

-- End of file MdsGetJoints.pml
