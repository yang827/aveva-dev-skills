-- Author:		Andrew Kirkland
-- Created:		Mon 13th July 1998
--
--
-- Description:
-- Function to find out the snodes of joints of connected sctns
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   [R]      [ARRAY]       [Array of Steel sctn members connected]
-- Return:
--    [Data Type]   [Description]
--     ARRAY        [Array of Snodes found ]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetNodes(!Verts is array) is array

  -- Initialise Variables
  !Nodes  = Array()
  !Joints = !!Mdsgetjoints(!Verts)

-- do loop is quicker than an extract block

  do !Js indices !Joints
     !Nodes[!Js] = !Joints[!Js].owner
  enddo

   Return !Nodes

-- End function
endfunction

-- End of file MdsGetNodes.pml
