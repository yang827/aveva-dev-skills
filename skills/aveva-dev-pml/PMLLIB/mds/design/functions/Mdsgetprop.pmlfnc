--
-- File: Mdsgetprop.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to return the design parameter number of a certain DKEY
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        DKEY Value
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsGetProp(!gadget is GADGET,!pGadget is GADGET,!dKey is STRING,!bore is BORE,!type is STRING)

  -- A gadget name is passed along with the appropriate dkey for the purpose
  -- this is then checked for the current element and three situation are
  -- returned
  -- 1. The element has the property and the min and max value are different
  --    This means the property may be modified by the user
  --    Set the gadget to the value and activate it
  -- 2. The element has the property and the min and max value are the same
  --    This means the property may not be modified
  --    Set the gadget to the value and deactivate it
  -- 3. The element does not contain the property
  --    Set the gadget to 0 and deactivate it

  !currentUnits = !!kGetSetUnits()

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- Determine if the passed MDS SUPPORT Type is a TRUNNION, e.g "TT04"
--><wd>03jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>03jun09 - DFN P-17079
  !stype = !type.upcase().trim()
  if (!stype.matchwild('TT*')) then
-- The Passed TYPE is a "MDS TRUNNION" Type Support
    !mdsObject = object MDSREADTRUNDATA()
    !mdsActive = !mdsObject.mdsTrunData(!stype, !rBore)

  else
-- The Passed TYPE is "NOT a MDS TRUNNION", but an "ATTA" or "PLAT" Type Support
    !mdsObject = object MDSREADPARSDATA()
    !mdsActive = !mdsObject.mdsDefsData(!stype, !rBore)

  endif

-- Alert User of the ERROR
  if (!mdsActive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsObject.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsObject.mdsStd.smess

      elseif (!mdsObject.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsObject.mdsStd.cmess

      endif
      !!alert.error (!errormessage)
      return
  endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

  if (match(!type,|GT04|) gt 0) then
      !type = !!ce.styp
  elseif (!type eq '') then
      !type = !!ce.styp
  endif

-- Initialise Variables
  var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq '$!dKey') for dtref
  var !numbers eval num for all from !mem
    !value = !numbers[1]
    handle NONE
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- MDS now gets the DEFAULTS from the MDS DEFAULTS PARAGON CATALOGUE DATABASE
      --!min = !!mdsPar$!type[$!bore].userdps[$!value].min
      !min = !mdsObject.userdps[$!value].min
-- Array element not found
      handle ANY
        !min = 0
      endhandle
      --!max = !!mdsPar$!type[$!bore].userdps[$!value].max
      !max = !mdsObject.userdps[$!value].max
      handle ANY
        !max = 0
      endhandle
      if (!min eq !max) then
        !gadget.active = false
        !pGadget.active = FALSE
        -- !gadget.val = !min
        --!gadget.val = !!mdsPar$!type[$!bore].despars[$!value].real()
        !gadget.val = !mdsObject.despars[$!value].real()
        handle ANY
          --!gadget.val = !!mdsPar$!type[$!bore].despars[$!value].string()
          !gadget.val = !mdsObject.despars[$!value].string()
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

        endhandle

      else
        !gadget.active = true
        !pGadget.active = true
        !set = despar[$!value]
        !gadget.val = !set
           handle ANY
             !gadget.val = !set.string()
           endhandle
-- It may be that you cannot write to the design parameters because of dacs, if so deactivate the gadget
-- if you can activate them
        !!mdsDacControl(true)
        !dacBoolean = DACMOD DESP
        !!mdsDacControl(false)
        !gadget.active = $!dacBoolean
        !pGadget.active = $!dacBoolean
      endif

    elsehandle (2,752)
      !gadget.active = false
      !pGadget.active = false
      !gadget.val = 0
    endhandle

  !!kRestoreUnits(!currentunits)

endfunction
