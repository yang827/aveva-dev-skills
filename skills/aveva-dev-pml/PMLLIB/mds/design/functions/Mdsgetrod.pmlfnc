--
-- File:		Mdsgetrod.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Tue 10th Dec
--
--
-- Description:
-- function to return rod id letter to be used for passed ATTAs rod length
-- (P41 to P42 of ATTA)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       DBREF of ATTA
--
--     2       RW      STRING      Return keyword to indicate success of finding suitable
--                                 stock rod length from passed ATTAs actual rod length:
--                                     'OK'    - if suitable stock rod length found
--                                 or  'OVER'  - if rod length was over maximum allowed stock length
--                                 or  'UNDER' - if rod length was under minimum allowed stock length
--
--     3       RW      STRING      Returned rod ID letter for stock rod length
--
--     4       RW      REAL        Actual length of this rod (P41 to P42)
--
--     5       RW      REAL        Minimum stock order length for this rod type
--
--     6       RW      REAL        Maximum stock order length for this rod type
--
-- Return:
--    [Data Type]   [Description]
--     BOOLOEAN      True is rod length checking was successfull, false is errors have occurred
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetRod(!Atta is DBREF, !RtnCheck is STRING, !RtnIdent is STRING, !RtnLen is REAL, !RtnMin is REAL, !RtnMax is Real) is BOOLEAN

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()




  -- initialise return variables
  !RtnCheck = ''
  !RtnIdent = ''
  !RtnLen   = 0
  !RtnMin   = 0
  !RtnMax   = 0

  -- move to atta
  $!Atta
  handle any
    !!Alert.Error('ATTA $!ATTA does not exist!')
    !!kRestoreUnits(!currentunits)
    return false
  endhandle

  -- check we are at an ATTA
  if (!Atta.Type.String().Neq('ATTA')) then
    !!Alert.Error('You must be at an attachment!')
    !!kRestoreUnits(!currentunits)
    return false
  endif

  -- get config object for this ATTA
  !Config = object MdsCONFIG()
  if (!!MdsGetCfg(!Atta,!Config).Not()) then
    !!kRestoreUnits(!currentunits)
    return False
  endif

  !RodDetail = ''
  -- search through the ancill array for the hanger rod details (AC01 or AC02)
  do !Ancill values !Config.Ancill
    if (!Ancill.Substring(1,4).Eq('AC01') or !Ancill.Substring(1,4).Eq('AC02')) then
      !RodDetail = !Ancill
      break
    endif
  enddo

  -- check we have found a rod ancill description
  if (!RodDetail.Eq('')) then
    !!Alert.Error('The Hanger STYPE $!Stype has no rod defined in the configuration defaults!')
    !!kRestoreUnits(!currentunits)
    return false
  endif

  -- get current rod length (distance from P41 to P42)
   !RodLen = !!KStrReal('CONST DISTANCE P41 TO P42')
  handle (2,256) $* illegal ppoint number
    !!Alert.Error('This Hanger has no ppoints (P41 or P42) for rod length calculations!')
    !!kRestoreUnits(!currentunits)
    return false
  endhandle

  -- get rod type and diameter
  !Split = !RodDetail.Split()
  !RodType = !Split[1]
  !RodDiam = !Split[2]
  !CurrentId = !Split[3]

  -- get array of rod lengths from parameter defaults
  !Rods = !!MdsPAR$!RodType[$!RodDiam].Rods
  handle any
    !!Alert.Error('The Hanger Rod $!RodType M$!RodDiam is not defined in the parameter defaults file!')
    !!kRestoreUnits(!currentunits)
    return false
  endhandle

  -- check there are rods defined
  if (!Rods.Unset()) then
    !!Alert.Error('The Hanger Rod $!RodType M$!RodDiam has no rod defaults defined in  parameter defaults file!')
    !!kRestoreUnits(!currentunits)
    return false
  endif

  -- initialise vars
  !RodMax = 0
  !RodMin = 999999
  !MinIdent = ''
  !MaxIdent = ''
  !RodIdent = ''
  !RtnCheck = ''
  !FoundRod = False

  -- check rod length against standard rod lengths defined in hanger config defaults
  do !Rod values !Rods
    !Min = !Rod.Min
    !Max = !Rod.Max
    !Id  = !Rod.Id
    if (!Min.Eq(0) and !Max.Eq(0)) then
       -- ignore this rod
    else
      -- check if we are at the smallest rod minimum
      if (!Min.Lt(!RodMin)) then
        !RodMin = !Min
        !MinIdent = !Id
      endif
      -- check if we are at the largest rod maximum
      if (!Max.Gt(!RodMax)) then
        !RodMax = !Max
        !MaxIdent = !Id
      endif
      -- check rod length against range
      if (!RodLen.Geq(!Min) and !RodLen.Leq(!Max)) then
        -- this is the rod for me....
        !FoundRod = True
        -- set return variables
        !RtnCheck = 'OK'
        !RtnIdent = !Id
      endif
    endif
  enddo

  -- check if a suitable rod length has been found
  if (!FoundRod.Not()) then
    -- check if current rod length is too long or too short
    if (!RodLen.Lt(!RodMin)) then
      -- set return variables
      !RtnCheck = 'UNDER'
      !RtnIdent = !MinIdent
    elseif (!RodLen.gt(!RodMax)) then
      -- set return variables
      !RtnCheck = 'OVER'
      !RtnIdent = !MaxIdent
    endif
  endif

  -- set return rod len, min and max values
  !RtnLen = !RodLen
  !RtnMin = !RodMin
  !RtnMax = !RodMax

   !!kRestoreUnits(!currentunits)
   Return True


-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdsgetrod.pml
