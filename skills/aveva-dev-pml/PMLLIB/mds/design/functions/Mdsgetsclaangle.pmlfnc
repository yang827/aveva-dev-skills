--
--
-- Description:
-- Function to get the Pivot angle and Non pivot angle of the SCLA element to component before
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsgetsclaangle(!SCLA is dbref) is ARRAY
    !return = ARRAY()
    !Originalce = !!ce

    $!Scla
    if !!ce.type.neq(|SCLA|) then
        return error 1 |Error, not at scla|
    endif


    pin 1 copy PL
    var !pin1dir construct dir p2 to p1
    pin 1 dir $!pin1dir
    !SclaAdir = !!ce.adir.wrt( /* )
    !SclaAdirStr = !SclaAdir.string()
    !SclaLdir = !!ce.ldir.wrt( /* )
    pin 1 plane pin 1 thro p2
    pin 2 copy PA of prev
    pin 3 copy pin 1
    pin 3 plane $!pin1dir thr pin 2
    pin 4 copy pin 3
    pin 3 dir $!SclaAdirstr
--    pin 3 plane $!SclaAdirstr thr pin 1
    pin 3 plane pin 3 thr pin 1
    !newdir = !SclaAdir.cross(!SclaLdir).string().before(|WRT|)
    pin 4 dir $!newdir
    pin 4 plane pin 4 thr pin 2
    pin 5 copy pin 2
    pin 5 dir $!newdir
    pin 5 plane pin 5 thr pin 1
    var !AngleNoPivot construct angle pin 5 to pin 1 to pin 3
    var !AnglePivot construct angle pin 4 to pin 1 to pin 3

    --!!mdsresetpins(1,4)

    !return.append(!AnglePivot.real().string('D1').real())
    !return.append(!AngleNopivot.real().string('D1').real())

   return !return

  endfunction
-- End of function

