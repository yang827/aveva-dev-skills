--
-- File:                Mdsgetsctnlen.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS127
--
-- Author:              T.martin
-- Created:             19-nov-2003
--
--
-- Description:
-- function to create support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       section to bew resized
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- function to select the appropriate bracket for a given section
-- Define Function
define function !!Mdsgetsctnlen(!sctn is dbref,!method is STRING)is real

!range = !sctn.catref.:mdssizerange
if !range.size().eq(0) then
  !!alert.error('Size Range Not Defined for This Section')
  return 0
endif

!len = !sctn.derlen
if !sctn.name.match('BAR-1').eq( 0 ) then
 !len = !len - 10
endif
if !len.gt(615) then
     if !method eq 'NEW' then
     !!alert.warning('Required section Length is larger than 615mm')
     -- swap the spref of the section and the joint
     endif
     !spref = !!ce.spref.name
     if !spref.match('/LONG').eq(0) then
        !!ce.spref = /LONG-BRACKET
        goto jois
        if !!ce.spref.name.match('L').neq(!!ce.spref.name.length()) then
          !jointname = !!ce.spref.name & '/L'
          !!ce.spref = !jointname.dbref()
          handle ANY
            !!alert.error('Error in joint name')
          endhandle
        endif
        goto cref
     endif
else
    -- check to see if the spref is wrong in case it was greater than 615 at one time
     if !!ce.spref.name.match('/LONG').neq(0) then
        !!ce.spref = /STD-BRACKET
        goto jois
        if !!ce.spref.name.match('L').eq(!!ce.spref.name.length()) then
          !jointname = !!ce.spref.name.replace('/L','')
          !!ce.spref = !jointname.dbref()
          handle ANY
            !!alert.error('Error in joint name')
          endhandle
        endif
        goto cref
     endif
endif

!range.append(!len)
!range.sort()
!selection = !Range.findfirst(!len) + 1

if !selection.gt(!range.size()) then
  if !method eq 'NEW' then
    !!alert.error('Required section Length is larger than maximum Available')
    --return 0
  endif
  !selection = !range.size() - 1
endif

return !range[!selection]

endfunction
