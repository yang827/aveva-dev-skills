--------------------------------------------------------------------------------
--
-- File:    Mdsgetsctnwidth.pmlfnc
-- Type:    Function Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  design
-- Replaces:
--
-- Author:    Andrew Kirkland
-- Created:   Thu 11th June 1998
--
--
-- Description:
-- Function to calculate the width of the passed sctn, not relying on the DTRE
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        Sctn passed to calc width
--
-- Return:
--    [Data Type]   [Description]
--      REAL        [Width of SCTN]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsGetSctnWidth(!beam is DBREF) is REAL

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  !refe = !!ce

  -- Initialise variables
  !!ce = !beam

  !type = !beam.type
  --REFACTOR added this to compensate for any fittings on the beam that may compromise the volume
  --this makes a local copy of the sctn and deletes any members under it this means that we won't pick any
  --anomalies from it - start

  new $!type /localVolSctnTemp copy prev
  handle ANY
  elsehandle NONE
    delete $!type mem
  endhandle

  --REFACTOR added this to compensate for any fittings on the beam that may comprimise the volume
  --this makes a local copy of the sctn and deletes any members under it this means that we won't pick any
  --anomalies from it - end

  if (!beam.type.neq('GENSEC')) then

    ------------------------------------------------------------------------------
    -- Get box point extremities (new pml "!vol = lvol wrt ce" does not work)
    var !dumvol lvol wrt ce
    !volPoints = !dumvol.split()

    --------------------------------------------------------------------------------------------------------------------
    --------------------------------------------------------------------------------------------------------------------
    --<wd>oct2004
    --*** IMPORTANT NOTE ***--
    -- Pins 1 and 2 have been repositioned to account for the Z dir of a SCTN always along its LENGTH
    -- The pseudo attribute 'var !dumvol LVOL wrt ce' at a SCTN uses the JUSL attribute as the ORIGIN of the SCTN,
    -- in this case the JUSL attrib is set to TOS, and returns a string in the variable !dumvol e.g -->
    -- <STRING> '-82 -303 0 83 0 6000' --(These figures INCLUDE the GEOMETRY for any SCTN members e.g. SNODES & SJOIS)--
    -- which normally means the LOCAL VOLUME of the SCTN is--> From 'E-82 N-303 U0' To 'E83 NO U6000'
    --** HOWEVER **--
    -- To get Pin 1 and Pin 2 in the CORRECT positions (i.e. the FROM and TO positions of the LVOL LIMITS BOX of the SCTN)
    -- The SIX indices in the resulting array variable--> !volPoints = !dumvol.split() have to be manipulated as shown
    -- in the code shown below, i.e. WRT the SCTN owner's ORIENTATION so that the NORTHING and UPPING values are swapped
    -- in BOTH of the FROM and TO values to position Pin 1 and Pin2.
    --<wd>oct2004
    --------------------------------------------------------------------------------------------------------------------
    --------------------------------------------------------------------------------------------------------------------

    -- Put pins at points so geometric calculator can find line wrt worl
    --<wd>oct2004
    --pin 1 at e$!volPoints[1] n$!volPoints[2] u$!volPoints[3]
    pin 1 at e$!volPoints[1] n$!volPoints[3] u$!volPoints[2] wrt ce
    --pin 2 at e$!volPoints[4] n$!volPoints[5] u$!volPoints[6]
    pin 2 at e$!volPoints[4] n$!volPoints[6] u$!volPoints[5] wrt ce
    --<wd>oct2004

    -------------------------------------------------------------------------------
    !dir  = !beam.ori.zdir().wrt(worl)
    !udir = !beam.ori.ydir().wrt(worl)

    -- position pin 1 to calculate width of sctn
    pin 1 dir $!dir
    pin 1 plane pin 1 thro pin 2
    pin 1 dir $!udir
    pin 1 plane pin 1 thro pin 2
    !width = !!kStrReal('Const dist pin 1 to pin 2')

  else

    !vol = object LOCALVOLUME(!beam, !beam)
    pin 1 at $!<vol.from>
    pin 2 at $!<vol.to>

    !dir  = !beam.members[1].yDirection.wrt(worl)
    !udir = !beam.members[1].drnStart.wrt(worl)

    -- position pin 1 to calculate width of gensec
    pin 1 dir $!dir
    pin 1 plane pin 1 thro pin 2
    pin 1 dir $!udir
    pin 1 plane pin 1 thro pin 2
    !width = !!kStrReal('Const dist pin 1 to pin 2')

  endif

  /localVolSctnTemp
  handle ANY
  elsehandle NONE
    delete $!type
  endhandle

  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  !!ce = !refe

  return !width

endfunction
