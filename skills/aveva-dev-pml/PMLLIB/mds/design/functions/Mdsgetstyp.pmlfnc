--
-- Author:		N.Morris
-- Created:		Fri Jan 23
--
--
-- Description:
-- function to return the support type of a support atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       Atta name
--
-- Return:
--    [Data Type]   [Description]
--    STRING        Support type
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGetStyp(!Atta is DBREF) is STRING

   !Origin = !!CE
   !!CE = !Atta

   !StypString = !!CE.styp

   if (!!CE.styp.match('-') gt 0) then
     !SupportType = !!CE.styp.before('-')
   else
     !SupportType = !!CE.styp
   endif

   !!CE = !Origin

   return !SupportType

-- End function
endfunction

