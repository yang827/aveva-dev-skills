--
-- File:		Mdsgettempwelds.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		T.martin
-- Created:		21/12/2004 10:24
--
--
-- Description:
-- goes to the structure and finds the original template then copies the
-- individual bar welds
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF       Structure ref
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsGettempwelds(!stru is dbref)
   -- first get some basic data

   -- get the support type
   !type = !stru.:MDSSuppType
   -- get the support description
   !desc = !stru.desc

   -- get the list of templates available for this name
   var !strulist coll all stru with match(name,'/MDS/$!type') gt 0 for /MDS/TEMPLATES
   var !descs evaluate desc for all from !strulist

   --search for the description in the list of templates
   !index = !descs.findfirst(!desc)
   if !index.unset() then
     !!Error.text = 'Unable to find template for support $!stru'
     return error 99
   endif

   -- now we have found a matching template so we can continue
   !template = !strulist[!index].dbref()

   -- loop through the members and do something????
   -- get the sctns
   var !sects coll all sctn for $!template

   -- loop through the sections and match them up with the standard
   do !a values !sects
      if !a.dbref().name.match('-V').gt(0) then $* its a vertical
         !swapname = !a.dbref().name.replace(!template.name,!stru.name)
         !dessctn = !swapname.dbref()
         handle ANY
            !!alert.error('cannot find vertical $!swapname')
         endhandle
         !templatewelds = !a.dbref().:mdswelddata
         !dessctn.:mdswelddata = !templatewelds
      elseif !a.dbref().name.match('-BAR-').gt(0) then $* its a bar
         !swapname = !a.dbref().name.replace(!template.name,!stru.name)
         !dessctn = !swapname.dbref()
         handle ANY
            !!alert.error('cannot bar find $!swapname')
         endhandle
         !templatewelds = !a.dbref().:mdswelddata
         !dessctn.:mdswelddata = !templatewelds
         !bar1 = !dessctn
      endif
   enddo

   -- now tidy up the bars

   do !i from 2
     !newbarname =  !bar1.name.replace('-BAR-1','-BAR-' & !i)
       handle ANY
        --$p cannot find  $!newbarname
         break
       endhandle
     !newbar = !newbarname.dbref()
     handle ANY
        --$p cannot find  $!newbarname
        break
     endhandle
     !newbar.:mdswelddata = !bar1.:mdswelddata
   enddo

   -- now we have set the correct welds, we can delete the template
   !!ce = !stru
   tmpl 1
   handle ANY
   elsehandle NONE
     delete tmpl
   endhandle

   !!ce = !stru

   !form = '!!MDS' & !type

   !CopyWelds = object MdsWeldList(!stru,$!form)

   -- return to stru
   stru

endfunction
