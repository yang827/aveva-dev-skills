--
-- File:  Mdsgradient.pmlfnc
-- Type:  Function Definition
-- Group:  Multi Discipline Supports Application
-- Keyword:  MDS
-- Module:  design
-- Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Tue Aug 26
--
--
-- Description:         Function to test for the Max Slope allowed on HORIZ Pipes
--                      for MDS frameworks where ONLY horizontal pipes are allowed.
--                      Check the gradient of the ILEAVE/IARRIVE TUBE of the Identified
--                      Piping Component/Branch where the DATUM atta is to be positioned.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          ILEAVE/IARRIVE tube of Identified Component/Branch.
--
-- Return:
--    [Data Type]   [Description]
--     Boolean       Returns 'True' if Slope exceeds Allowable Default Slope
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsgradient(!currcomp is DBREF) is BOOLEAN


  -- If its a baseplate we are on a trunnion and it OK

  if !currcomp.type.neq('BRAN').and(!currcomp.type.neq('CTRAY')) then
    !unusedStypOfCE = !currcomp.styp
    handle NONE
      if (!currcomp.styp inset('AC18A','AC18B','AC19A','AC19B','AC30','AC46')) then
        return FALSE
      endif
    elsehandle ANY   $* no stype for component
    endhandle
  endif


  -- Get Current Element's gradient.

  !slope = !currcomp.ldir.wrt(world)
  handle any
    !slope = !currcomp.hdir.wrt(world)
    handle ANY
      !slope = !currcomp.pdir[2].wrt(world)
    endhandle
  endhandle

  !slopePos = !slope.up.abs()

  -- Check the gradient of CE against the Max. Allowed Slope on the Options form.

  !splslope = !!mdsoptions.slope.val.split('/')

  -- Max. Allowed Slope
  !maxGrad  = ( !splslope[1].real() / !splslope[2].real() )
  handle ANY
    !!alert.error('Error in default slope value - Please Check your defaults')
    return TRUE
  endhandle

  return !slopePos.gt(!maxGrad)

  -- End function
endfunction
