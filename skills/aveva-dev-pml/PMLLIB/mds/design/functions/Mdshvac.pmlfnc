--------------------------------------------------------------------------------
--
-- File:      Mdshvac.pmlfnc
-- Type:      Function Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    design
-- Replaces:  MHVAC
--
-- Author:    I.osborne
-- Created:   Thu Mar 08
--
--
-- Description:
-- function to add hvac support to framework
-- This function needs to be converted to PML2
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsHvac(!form is FORM)

  -- Initialise variables
  !pSName = !form.support.stru.name
  !type = !!ce.type

  -- THERE IS A BUG THAT CREATES THE ATTA AFTER THE LAST MEM WHEN A BRAN IS SELECTED SO CHECK THE ITEM IS IN THE RIGHT PLACE

  !conn = pa conn
  --VAR !thickness INSU
  --!insu = !thickness.real()
  !readHVAC = !!ce

    NEW ATTA
    SEL SPREF WITH STYP 'HVAC-REST' SPEC /MDS
      handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
      endhandle
--<wd>17apr03
    --SPKBRK TRUE
    SPKBRK FALSE
--<wd>17apr03
  !writeHVAC = !!ce

-- Call routine to set the correct des pars for the support atta

  if (!conn eq |HVAC|) then
-- Circ Duct type
    !!mdsSetHvac(!readHVAC,!writeHVAC)
  elseif (!conn eq |HVAR|) then
-- Rect Duct type
    !!mdsSetHvac(!readHVAC,!writeHVAC)
  elseif (!conn eq |RECT|) then
-- CADC Rect Duct type
    !!mdsSetHvac(!readHVAC,!writeHVAC)
  elseif (!conn eq |CIRC|) then
-- CADC Circ Duct type
    !!mdsSetHvac(!readHVAC,!writeHVAC)
  elseif (!conn eq |OVAL|) then
-- CADC Oval Duct Type
    !!mdsSetHvac(!readHVAC,!writeHVAC)
    else
      DELETE ATTA
    !!alert.error(|Support could not be selected as the element is not a standard HVAC duct|)
      return
    endif

  STEX '$!form.name.val'

    -- Orientate new hvac as per the datum atta
  !datumAtta = !form.support.datum.string()

    -- Check if element has p30
  !ppointList = ppls
  if !ppointList.find(30).size() gt 0 then
    !dirP3 = p3 dir of $!datumAtta
    !dirP3 = !!oppositeDir(!dirP3)
    fconn and p30 is $!dirP3
    --fconn and p30 is p3 of $!datumAtta
  else
    fconn and p3 is p3 of $!datumAtta
  endif

  if (defined(!!hVACONLY))then
    PLANE PL THRO $!datumAtta
  endif

  !!mdsSelLstu(!!ce)

  !order = ORDER

  if (!type eq |BRAN| and !order neq 1) then
    !name = !!ce.name
      BRAN
    REORDER $!name BEFORE 1
    !!ce = !name.dbref()
    endif


  do !count from 1
-- Fix for HPD002008 for some reason DAC's is off at this point
    !!mdsDacControl(true)
    !support = !pSName & '.' & !count
    NAME $!support
        handle (41,12)
      skip
        endhandle
    -- Add atta to Form Member atta
    !newAtta = !!ce
    !form.support.atta.append(!newAtta)
      break
    enddo

  -- Always add atta to datum cross bar
  if (!form.support.bars.empty())then
    !form.support.bars[1][1] = !newAtta
    else
    !form.support.bars[1].append(!newAtta)
    endif

endfunction
