--------------------------------------------------------------------------------
--
-- File:		MdsiVT13.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IVS105
--
-- Author:		Andrew Kirkland
-- Created:		Wednesday 13th May 1998
--
--
-- Description:
-- Initialisation for form VT13
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsiVT13(!Modify is string, !TextName is string,!Alias is string)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsVT13.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------
-- Initialise Variables
    !Name = '/' & !TextName

-- Initialise Standard gadgets
    !!MdsVT13.Select.select('RTEXT', 'IDCUR')
    !!MdsVT13.Datum.Active = true
    !!MdsVT13.Cancel.Active = true
    !!MdsVT13.Dim1.active = false

--------------------------------------------------------------------------------

-- Create Support object
    !Support = object MdsSUPPORT()
    !Support.position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 0
    !Support.Alias     = !Alias

--------------------------------------------------------------------------------

    if (!Modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Vessel Framework Type 'VT13'

-- Set callback on cancel button
      !!MdsVT13.cancel.callback = |Call !!Mdscancelsupp(!!MdsVT13)|
      !Support.modify = false

-- Initialise variables for new supports
      !Support.Replace = !!Mdsvess.Replacement
      !Support.Type    = !!Mdsvess.standard.selection()
      !StruName        = !!Mdsvess.Name.Val

-- Navigate to correct area
      if (!!MdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsDacControl(true)

-- Create Stru
      NEW STRU /$!StruName
      !Support.Stru = !!CE
      :MDSSuppType |$!Support.Type|

-- Set Paragraph gadget on form
      !!MdsVT13.Name.Val = !StruName

      !!MdsVT13.dim1.val = 0
      !!MdsVT13.dist.val = 0
      !!MdsVT13.p.val = ''


      !!Mdsvess.Hide()

--------------------------------------------------------------------------------

    else
-- Modify an Existing Vessel Framework Type 'VT13'
--------------------------------------------------------------------------------

-- Set callback on cancel button
      -- !!MdsVT13.Cancel.callback = |Call !!MdsRestoreForm(!!MdsVT13)|
      !!MdsVT13.Cancel.active = false
      !Support.modify = true
      !!MdsVT13.Datum.Active = false

-- Initialise variables for existing supports
      !DatumName = !Name & '/DATUM'
      !Sref      = !Name & '/SREF'

-- Store Data in support object
      !Support.Type     = '$!Alias'
      !Support.position = true
      !Support.Datum    = !DatumName.dbref()
        handle (2,109)
          !!Alert.error('Support Datum does not exist')
          unenhance all
          !!MdsModifySupp.Cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !Support.Stru = !Name.dbref()

--> Modified - <wd> - 15sep1998
      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!Mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif
--< Modified - <wd> - 15sep1998


-- Store Atta reference's in object
      !Support.Atta.append(!DatumName.dbref())
      !Support.Atta.append(!Sref.dbref())

-- Navigate to existing support datum
      !!CE = !Support.Datum
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.P10Dir = P10 Dir wrt world
      !Support.P11Dir = P11 Dir wrt world

-- Apply Data for existing cross bar
      !!CE  = !Support.Stru
      !strn = !Support.Stru.namn
      !bar = !Name & '-BAR-1'

      !References = !Support.Atta
      !index = !References.findfirst(!Sref.dbref())
      !References.remove(!index)

-- Store Data in support object
      !Support.Bars[1] = !References

-- Get length of existing crossbar
      !Length = deri length of $!bar
      !Support.Barlen.append(!Length)

-- Set Form Gadgets
      !!MdsVT13.name.val  = !strn
      !!MdsVT13.dim1.val  = 0

      !!MdsVT13.p.val     = ''

      -- Store section name and matref for each member

      !StoreMat = array()
      !StoreMat = !!MdsStoreMat(!Name)
      !Support.Material = !StoreMat



      !!MdsAddAll('$!TextName')

    endif
--------------------------------------------------------------------------------


-- Store support object in form
    !!MdsVT13.Support = !Support

-- Store Current representations in form for use later
    var !Repre repre level
    !!MdsVT13.repre.clear()
    !!MdsVT13.repre.append(|Call !!KRepreLevel(Nulref, '', $!Repre,0)|)
    var !Repre repre level pipe
    !!MdsVT13.repre.append(|Call !!KRepreLevel(Nulref, 'PIPE', $!Repre,0)|)
    var !Repre repre level nozz
    !!MdsVT13.repre.append(|Call !!KRepreLevel(Nulref, 'NOZZ', $!Repre,0)|)
    var !Repre repre level stru
    !!MdsVT13.repre.append(|Call !!KRepreLevel(Nulref, 'STRU', $!Repre,0)|)

--------------------------------------------------------------------------------

--------------------------------------------------------------------------------

-- Collect all supports for Vessel Framework Type 'VT13'
    !!CE = /MDS/FRAMES/$!Alias
      handle (2,109)
        !!Alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!Modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle


  -- Generate Steel Size List

    !Dtext = array()
    !Rtext = array()
    -- !!MdsSetSize('CREATE',!!MdsVT13,'-BAR-1','-BAR-1')
    !!MdsSetSteel.init('HIDE',!!MdsVT13,'-BAR-1','-BAR-1')

    !!CE = !Support.Stru

--------------------------------------------------------------------------------

    if (!Modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!MdsVT13,'-BAR-1','-BAR-1')
      !!MdsSetSteel.init('HIDE',!!MdsVT13,'-BAR-1','-BAR-1')

      !!CE = !!MdsVT13.Support.Datum

--------------------------------------------------------------------------------

-- Set distance gadget

      !!MdsDistance(!!MdsVT13)

--------------------------------------------------------------------------------

-- Add marker text markers

      VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

      do !COUNT FROM 211 TO 259

        VAR !NUM ($!COUNT - 210)
        !AttaName = !Name & '.' & !Num
        !!CE = !AttaName.dbref()
          handle ANY
            SKIP
          endhandle

--------------------------------------------------------------------------------

-- Store Atta reference in form
        !!MdsVT13.Support.Atta.append(!!CE)

        VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

      enddo

-- Fill in dimensions from SREF atta (Stored in mm)

      !!CE = !Sref.dbref()
       !Despars = despar

      !!MdsVT13.Dim1.Val = !Despars[1]
        handle any
          !!Alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle

    endif

--------------------------------------------------------------------------------

  label /CONT

-- Redefine standard support name on form title

    !index = !!Mdsvess.Standard.Rtext.findfirst('$!Alias')
    !text  = !!Mdsvess.Standard.Dtext[!index]
      handle (61,567) (61,615)
        !!Mdspopulate(!!Mdsvess,'VESS')
        !index = !!Mdsvess.Standard.Rtext.findfirst('$!Alias')
        !text  = !!Mdsvess.Standard.Dtext[!index]
      endhandle
    !SuppNumber = before(!text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsVT13.Support.Replace = !FormName

    call !!MdsSetFormName(!!MdsVT13, 'PIPE', '$!FormName')

    !!CE = !!MdsVT13.Support.Stru

--------------------------------------------------------------------------------
-- Store current form information
    call !!MdsstoreVT13()

--------------------------------------------------------------------------------

-- Set dimensions toggle

    !!MdsVT13.GraphicalDim = false

-- Show Form for Vessel Framework Type 'VT13'
    !!KShowForm(!!MdsVT13)

    !!kRestoreUnits(!currentunits)

-- End function
  endfunction

--------------------------------------------------------------------------------

-- End of file MdsiVT13.pml
