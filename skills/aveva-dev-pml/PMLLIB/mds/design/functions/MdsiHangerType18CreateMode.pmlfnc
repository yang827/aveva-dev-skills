----------------------------------------------------------------------
-- File:    MdsiHangerType18CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType18CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  ----------------------
  -- Create a NEW HANGER
  ----------------------
  !!mdsHangerType18.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support .position  = FALSE
  !support .mirror    = FALSE
  !support .rotateCur = FALSE
  !support .handedCur = FALSE
  !support .rotated   = 0
  !support .bPNum     = 1
  !support .alias     = !styp
  !support .modify = FALSE
  -- <sk> 04/06/2012
  !fromAtta = false
  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE
    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'
  elsehandle ANY
  endhandle
  --<sk> 06/06/2012

  -------------------------------
  --- mds Manufacturers interface
  -------------------------------

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
      if  (!!mdsHangIf.eq('LISEGA')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1 or !plDir.up eq -1 ) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType18.type = 'V'
          !selType = !configNumber.string() + 'V'
          !!mdsVendorHangerType18.hangerSelType.val = !selType
        else
          !!mdsVendorHangerType18.type = 'H'
          !selType = !configNumber.string() + 'H'
          !!mdsVendorHangerType18.hangerSelType.val = !selType
        endif
      elseif  (!!mdsHangIf.eq('PSL')) then
        !!mdsVendorHangerType18.type = ''
      elseif  (!!mdsHangIf.eq('CPL')) then
        !!mdsVendorHangerType18.type = ''
      endif
    endif
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType18.bthro.active  = TRUE
        !!mdsHangerType18.select.active = TRUE
        !!mdsHangerType18.bdist.active  = TRUE
        !!mdsHangerType18.dist.active   = TRUE
      endif
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType18.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType18.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType18.name.val = !callingForm.name.val
  !!mdsHangerType18.dist.val = 0
  !!mdsHangerType18.p.val = ''
  !!mdsHangerType18.datum.active = TRUE

  if !!mdsHangerType18.support.preliminaryStore.set() then
    !!mdsHangerType18.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType18 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType18.support.rest = !oRest
  !oRest.create(!!mdsHangerType18,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType18.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType18.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType18.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType18 form
  !!kShowForm(!!mdsHangerType18)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning

  !!mdsHangerType18.setGadgets()

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle
  !ce = name
  !!mdsDacControl(TRUE)
  $!ce/H1
  pos pt at $!ce/CMPF
  handle ANY
  endhandle
  tref $!ce/SBFI/H1
  handle ANY
  endhandle
  move pt u clear 0 inf owner of $!ce/CMPF
  handle ANY
  elsehandle NONE
  endhandle
  tdir d wrt /*
  !!ce = !ce.dbref()

  !callingForm.name.val = 'unset'
  !!mdsHangerType18.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType18.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  -- Put the tail direction in the support object
  !!mdsHangerType18.support.tdir = tdir of $!attaName/H1 wrt /*

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType18.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType18.support.tposition = tposition of $!attaName/H1 wrt /*

  !support  = !!mdsHangerType18.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType18.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType18.hangerSelType.val
    !!ce = !exist
  endif
  !!mdsVendorHangerType18.steelMem = !support.rest.beamRefArray
  !!mdsHangerType18.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType18.name.val = !attaName.after('/')
  !!mdsHangerType18.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType18 form gadgets
  !!ce = !attaRef
  !!mdsHangerType18.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType18)

  !!mdsHangerType18.bthro.active = TRUE
  !!mdsHangerType18.select.active = TRUE
  !!mdsHangerType18.bdist.active = TRUE
  !!mdsHangerType18.dist.active = TRUE

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        --DTF feb 05
        !!mdsHangerType18.reconnect.active = FALSE
        -- open distance for all types item 189
        !!mdsHangerType18.bthro.active = TRUE
        !!mdsHangerType18.select.active = TRUE
        !!mdsHangerType18.bdist.active = TRUE
        !!mdsHangerType18.dist.active = TRUE
      endif
    endif
  endif

  ------------------------------------------------------------------------
  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType18)
  !hangerStart = !!mdsHangerType18.support.datum.position
  !hangerEnd   = !!mdsHangerType18.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType18.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType18.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType18.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType18)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
-- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
if (!!mdsHangIf.eq('LISEGA')) then
pml load FORM !!mdsundolicad
!!mdsundolicad.support = !!mdsHangerType1.support
!!mdsSaveHangerState(!!mdsundolicad)
endif
-- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END

  return !support

endfunction
