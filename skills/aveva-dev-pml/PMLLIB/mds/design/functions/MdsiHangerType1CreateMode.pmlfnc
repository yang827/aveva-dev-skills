--
----------------------------------------------------------------------
-- File:    MdsiHangerType1CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType1CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  ----------------------
  -- Create a NEW HANGER
  ----------------------
  !!mdsHangerType1.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support .position  = FALSE
  !support .mirror    = FALSE
  !support .rotateCur = FALSE
  !support .handedCur = FALSE
  !support .rotated   = 0
  !support .bPNum     = 1
  !support .alias     = !styp
  !support .modify = FALSE

  -- <sk> 04/06/2012
  !fromAtta = false

  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE

    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'

  elsehandle ANY
  endhandle
  --<sk> 06/06/2012

  -------------------------------
  --- mds Manufacturers interface
  -------------------------------

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
      if  (!!mdsHangIf.eq('LISEGA')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1 or !plDir.up eq -1 ) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType1.type = 'V'
          !selType = !configNumber.string() + 'V'
          !!mdsVendorHangerType1.hangerSelType.val = !selType
        else
          !!mdsVendorHangerType1.type = 'H'
          !selType = !configNumber.string() + 'H'
          !!mdsVendorHangerType1.hangerSelType.val = !selType
        endif
      elseif  (!!mdsHangIf.eq('PSL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType1.type = 'V'
        else
          !!mdsVendorHangerType1.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType1.type
        !!mdsVendorHangerType1.hangerSelType.val = !selType
      elseif  (!!mdsHangIf.eq('CPL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle

        --><wd>04aug2009 - DFN P-22111 (SI-13209)
        -- Added the check here for BOTH of the VERTICAL PIPE Directions, i.e.cHECK for -1(DOWN) or +1(UP) values by using the object REAL.abs() (ABSOLUTE) method
        --            if (!plDir.up EQ 1) then
        if (!plDir.up.abs() eq 1) then
          --<<wd>04aug2009 - DFN P-22111 (SI-13209)
          !support.alias = 'MH01'
          !!mdsVendorHangerType1.type = 'V'
        else
          !!mdsVendorHangerType1.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType1.type
        !!mdsVendorHangerType1.hangerSelType.val = !selType
      endif
    endif
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType1.bthro.active  = TRUE
        !!mdsHangerType1.select.active = TRUE
        !!mdsHangerType1.bdist.active  = TRUE
        !!mdsHangerType1.dist.active   = TRUE
      endif
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType1.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType1.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType1.name.val = !callingForm.name.val
  !!mdsHangerType1.dist.val = 0
  !!mdsHangerType1.p.val = ''
  !!mdsHangerType1.datum.active = TRUE

  if !!mdsHangerType1.support.preliminaryStore.set() then
    !!mdsHangerType1.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType1 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType1.support.rest = !oRest
  !oRest.create(!!mdsHangerType1,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType1.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType1.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType1.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType1 form
  !!kShowForm(!!mdsHangerType1)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning

  !!mdsHangerType1.setGadgets()

  if (!!manIf.exe.exists()) then
    if (!!mdsVendorHangerType1.type eq 'H') then
      -----------------------------------------
      -- HORIZONTAL PIPES
      -----------------------------------------
      !!ce = !attaName.dbref()
      !ce = !!ce.name
      $!ce/REST
      $!ce/H1
      conn hh to $!ce
      $!ce
      prev
      handle ANY
      elsehandle NONE
        !paDir = pa dir wrt /*
        handle ANY
        elsehandle NONE
          !plDir = pl dir wrt /*
          if ((!paDir.up eq 1 or !paDir.up eq -1) and !paDir.opposite().eq(!plDir)) then
            $!ce
            flip
            conn
            $!ce/H1
            conn hh to $!ce
            $!ce
          endif
        endhandle
      endhandle
      $!ce
      pin 9 copy pl
      pin 8 copy pin 9
      pin 8 dir d wrt /*
      $!!mdsInterfaceHanger.beamRef[1]
      pin1 at ppline na start
      Pin1 dir d
      pin1 throu pin8
      !zDirOfSctn = zdir wrt world
      pin 9 at ce
      pin 9 dir $!zDirOfSctn
      pin 9 PLANE pin 9 thro $!ce
      pin 9 dir from pin 8 to pin 9
      -- pin1 direction parallel to beam axis
      var !pin1dir pplin NA y dir wrt world
      pin1 dir $!pin1dir wrt world
      -- calculate the offset the fitting along the beam axis from its start

      var !zdist const dist pin8 to plan pin1
      var !pin9dir pin 9 dir
      !pin9dirOpp = !pin9dir.direction().opposite()

      var !hdir pin 9 dir wrt /*
      --<wd>sep2005
      !hpos = hpos of $!ce/H1 wrt /*
      !closestPline = !!kClosestPline(!!ce,!hpos,!hdir.direction())

      -- We only need the pline that can be connected to, these are
      -- TOS, BOS, TOC, BOC, LEFT, RIGH
      do !getPlineNumber from 1 to !closestPline.size() by 2
        if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
          !plineNumber = !getPlineNumber
          break
        endif
      enddo
      !plineName = pkey of $!closestPline[$!plineNumber]

      pin 1 off
      pin 2 off

      --DUN1218 if we have a virtual fitting object member set on the mdsHangerType1 form then readOnly = true
      if !!mdsHangerType1.virtualFitting.set() then
        !readonly = TRUE
      else
        !readonly = FALSE
      endif

      if !readonly then
        !!mdsHangerType1.virtualFitting.spref = /MDS/LUG-HANG
        !!mdsHangerType1.virtualFitting.setzdist(!zdist.real())
        !currentDelpos = !!mdsHangerType1.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType1.virtualFitting.delPosition = !currentDelpos
        !!mdsHangerType1.virtualFitting.posline = !plineName
        !!mdsHangerType1.virtualFitting.setdelpos(!!mdsHangerType1.virtualFitting.getPosition())
        !sctnPoss = !!mdsHangerType1.virtualFitting.owner.posstart.wrt( /* )
        !sctnPose = !!mdsHangerType1.virtualFitting.owner.posend.wrt( /* )
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        var !pin9position pos pin 9 wrt /*
        --zdist thro pin 9
        !!mdsHangerType1.virtualFitting.zDistThrough(!pin9position.position())
        !currentDelpos = !!mdsHangerType1.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType1.virtualFitting.delPosition = !currentDelpos
        $!ce/H1
        --conn ht to $!ce/FITT/H1
        !!ce.tpos = !!mdsHangerType1.virtualFitting.getPosition()
        !!ce.tdir = !!mdsHangerType1.virtualFitting.getposLineZdir()
      else
        -- Create the fitting for the 1 hanger if not already created
        !!mdsDacControl(TRUE)
        new fitt $!ce/FITT/H1
        handle NONE
        elsehandle ANY
          delete fitt
        endhandle
        $!ce/FITT/H1
        Spref /MDS/LUG-HANG
        zdist $!zdist
        delp n0
        posl $!plineName
        !sctnPoss = poss of owner of $!ce/FITT/H1 wrt /*
        !sctnPose = pose of owner of $!ce/FITT/H1 wrt /*
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        zdist thro pin 9
        delp n0
        $!ce/H1
        conn ht to $!ce/FITT/H1
      endif

      --<RM> 11/08/08 modified the code below because i was having trouble with old hangers being built with an incorrect tdir
      -- as a result when modifying the hanger tail would be built in the wrong orientation.
      var !htdir const DIRECTION ht to hh
      pin 9 copy pt
      !pin9dir = !!ce.tdir.wrt( /* ).string()

      if !pin9dir.direction().dot(!htdir.direction()).lt(0.99) then
        !pin9dirOpp = !pin9dir.direction().opposite()
        tdir $!pin9dirOpp
      else
        tdir $!pin9dir
      endif

      !pin9dirOpp = !pin9dir.direction().opposite()
      --<RM> 11/08/08 end of fix

      !attaDirs = !!mdsRemoveGrad(!attaName.dbref())
      $!ce
      -- test to see if we have a vertical pipe
      var !plDirect dir pl of $!ce
      !pipeUpAng = !plDirect.direction().angle( U wrt /* ).real()
      if !pipeUpAng.gt(90) then
        !pipeUpAng = 180 - !pipeUpAng
      endif

      if !pipeUpAng.gt(45) then
        !pipeDir = 'HORZ'
      else
        !pipeDir = 'VERT'
      endif

      if !pipeDir.eq('HORZ') then
        --if pipe direction is predominantly horizontal

        -- <RM> 01 Dec 06 -- re-wrote the commented lines from line 599 this is so that the intersections
        -- between pipe and section is handled via plane / vector intersections instead of through statements
        !sctnCrossDir = !sctnDirection.direction().cross(!pin9dir.direction())
        !sctnPV = object POINTVECTOR(!sctnPoss, !sctnCrossDir)

        pin 1 at $!sctnPoss
        pin 1 dir $!sctnCrossDir

        var !attaDir dir pl of $!attaName wrt /*
        var !attaPos pos pl of $!attaName wrt /*

        pin 2 at $!attaPos wrt /*
        pin 2 dir $!attaDir

        !attaPV = object POINTVECTOR(!attaPos.position(), !attaDir.direction())
        !attaSctnInter = !attaPV.intersection(!sctnPV.plane())
        handle ANY
          -- if we hit this error then the sctn and pipe are in parallel directions
          -- we therefore apply a POINTVECTOR that corresponds to the start of the sctn
          -- in the direction of the section to the atta and intersect a plane through the steelwork.

          -- get the steel POINTVECTOR
          if !readonly then
            !owner = !!mdsHangerType1.virtualFitting.owner
            var !posLPoss pos ppli $!plineName start of $!owner wrt /*
            var !posLPose pos ppli $!plineName end of $!owner wrt /*
          else
            var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
            var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
          endif
          var !posLDir const dir $!posLPoss to $!posLPose

          -- position the POINTVECTOR at the atta
          !posLDirAttaPV = object POINTVECTOR(!attaPos.position(), !posLDir.direction())
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!posLDirAttaPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif

          if !readonly then
            !!mdsHangerType1.virtualFitting.setZdist(!newZDist)
          else
            $!ce/FITT/H1 zdist $!newZDist
          endif

        elsehandle NONE

          !pipeSctnPV = object POINTVECTOR(!attaSctnInter, !sctnDirection.direction())

          if !readonly then
            !owner = !!mdsHangerType1.virtualFitting.owner
            var !posLPoss pos ppli $!plineName start of $!owner wrt /*
            var !posLPose pos ppli $!plineName end of $!owner wrt /*
          else
            var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
            var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
          endif

          var !posLDir const dir $!posLPoss to $!posLPose
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!pipeSctnPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          -- reposition the atta and fitting position in lieu of the adjustments above
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif

          if !readonly then
            !!mdsHangerType1.virtualFitting.setZdist(!newZDist)
          else
            $!ce/FITT/H1 zdist $!newZDist
          endif
          $!attaName pos $!attaSctnInter
        endhandle
      else
        --if pipe direction is predominantly vertical

        !sctnPV = object POINTVECTOR(!sctnPoss, up)
        var !attaDir dir pl of $!attaName wrt /*
        var !attaPos pos pl of $!attaName wrt /*
        !attaPV = object POINTVECTOR(!attaPos.position(), !attaDir.direction())
        !attaSctnInter = !attaPV.intersection(!sctnPV.plane())

        -- we need to make sure we have the correct pline on the sctn
        if !readonly then
          !owner = !!mdsHangerType1.virtualFitting.owner
          var !pipeToSteelDir const dir $!attaSctnInter to ppli na start of $!owner
          var !steelRef $!owner
        else
          var !pipeToSteelDir const dir $!attaSctnInter to ppli na start of owner of $!ce/FITT/H1
          var !steelRef owner of $!ce/FITT/H1
        endif
        !closestPline = !!kClosestPline(!steelRef.dbref(),!attaSctnInter,!pipeToSteelDir.direction())
        handle ANY
          !hpos = hpos of $!ce/H1 wrt /*
          if !readonly then
            !owner = !!mdsHangerType1.virtualFitting.owner
            var !pipeToSteelDir const dir $!hpos to ppli na start of $!owner
          else
            var !pipeToSteelDir const dir $!hpos to ppli na start of owner of $!ce/FITT/H1
          endif
          !closestPline = !!kClosestPline(!steelRef.dbref(),!hpos,!pipeToSteelDir.direction())
        endhandle

        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]
        $!ce/FITT/H1 posl $!plineName

        --we now need to adjust the atta position if the supporting steelwork is rotated
        var !naToPoss const dir ppli na start of owner of $!ce/FITT/H1 to ppli $!plineName start of owner of $!ce/FITT/H1
        if !readonly then
          !owner = !!mdsHangerType1.virtualFitting.owner
          var !posLPoss pos ppli $!plineName start of $!owner wrt /*
          var !posLPose pos ppli $!plineName end of $!owner wrt /*
        else
          var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
          var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
        endif
        var !posLDir const dir $!posLPoss to $!posLPose
        !attaPlaneDir = !posLDir.direction().cross(!naToPoss.direction())
        !attaPlaneDirPV = object POINTVECTOR(!posLPoss.position(),!attaPlaneDir)
        !attaSctnInter = !attaPV.intersection(!attaPlaneDirPV.plane())
        handle ANY
          --<RM> 20/08/08, included this handle block because i was having trouble with vertical pipes with vertical sections
        elsehandle NONE
          !pipeSctnPV = object POINTVECTOR(!attaSctnInter, !sctnDirection.direction())
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!pipeSctnPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          -- reposition the atta and fitting position in lieu of the adjustments above
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif
          $!ce/FITT/H1 zdist $!newZDist
          $!attaName pos $!attaSctnInter
        endhandle
      endif

      $!ce/H1

      conn hh to $!ce
      --<RM> 11/08/08 put a test in for these lines because they were causing build problems for LICAD type hangers
      if (!!mdsHangIf.upcase().neq('LISEGA')) then
        if !readonly then
          --conn ht to $!ce/FITT/H1
          !!ce.tpos = !!mdsHangerType1.virtualFitting.getPosition()
          !!ce.tdir = !!mdsHangerType1.virtualFitting.getposLineZdir()
        else
          conn ht to $!ce/FITT/H1
        endif
      endif
      --<RM> 11/08/08 end of fix
      !hangerStart = !!ce.hpos.wrt( /* )
      !hangerEnd = !!ce.tpos.wrt( /* )
      $!ce
      -- now update the aid lines
      !!mdsAidText(!!mdsHangerType1)
      aid clear line 2999
      handle ANY
      endhandle
      aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

      --<wd>11aug2009 -- DFN P-22111 (SI-13209)
      -- This *** NOTE *** is for Information Purposes ONLY *** PML CODE changes for VERTICAL PIPES below.
      -- This "else" block of PML CODE has been copied and added (and modified where required) to the VERTICAL PIPES condition shown below at approximately line no.1110
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Added the CODE below to Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
      !!ce = !attaName.dbref()

      !!ce.:MDSHConfig = !configNumber & !!mdsVendorHangerType1.type
      !!mdsVendorHangerType1.hangerSelType.val = !!ce.:MDSHConfig
      !ce = !!ce.name
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
      AT PL of PREVIOUS
      handle ANY
        AT PH
      endhandle
      !!mdsHangerType1.dist.val = 0
      $!ce/H1
      --<RM> 16/11/07 -- connect the hanger tail to the fitting or the hanger head will be
      -- projected to wherever the hang element was created.
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType1.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
        conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      --<RM> 16/11/07 -- end of fix
      pin 3 at ht
      var !xHTDir construct DIRECTION ht to hh
      pin 3 dir $!xHTDir
      handle ANY
      elsehandle NONE
        pin 3 PLANE pin 3 thr hh
        $!ce
        thro pin 3
      endhandle
      $!ce/H1
      conn hh to $!ce
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType1.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
        conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      pin 9 dir from pt to ph
      var !pin9dir pin 9 dir
      tdir $!pin9dir

      if (!!mdsHangerType1.dist.active eq FALSE) then
        $!ce
        -- Get general direction of pleave of datum atta
        -- Plane direction is nearest value to 1
        !plDir = pl dir of $!attaName
        --<RM> 26/06/07 -- removed the following !planeDir needs to be the pleave of the atta
        -- which has gone through !!mdsRemoveGrad
        !directions = !!mdsRemoveGrad(!attaName.dbref())
        !planeDir = !directions[1]

        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
        if !readonly then
          !tailPosition = !!mdsHangerType1.virtualFitting.getPosition()
          PLANE $!planeDir through $!tailPosition
        else
          PLANE $!planeDir through $!ce/FITT/H1
        endif
        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end

        !isWithinTube = !!mdsIsWithinTube(!ce.dbref())
        if (not !isWithinTube ) then
          Spkbrk FALSE
        endif
        $!ce/H1
        conn hh to $!ce
        $!ce
        -- If the type is a 7 then do not automatically show the i/f because they may want to set a offset
        !!mdsHangerType1.hide()
        !!mdsVendorHangerType1.jointrotate = TRUE
        --REFACTOR -- added so that we know if mds is going to start the interface without user action
        if defined(!!mdsautotestrunning) then
          !!mdsAutoTestNoOkMethodRequired = TRUE
        endif
        !!mdsVendorHangerType1.init()
      else
        !!mdsVendorHangerType1.jointrotate = FALSE
      endif
    elseif (!!mdsVendorHangerType1.type eq 'V') then
      -----------------------------------------
      -- VERTICAL PIPES
      -----------------------------------------
      if (!!mdsHangIf.upcase().eq('CPL')) then
        -- Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
        !!ce = !attaName.dbref()

        !!ce.:MDSHConfig = !configNumber & !!mdsVendorHangerType1.type
        !!mdsVendorHangerType1.hangerSelType.val = !!ce.:MDSHConfig
        !ce = !!ce.name
        -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
        AT PL of PREVIOUS
        handle ANY
          AT PH
        endhandle
        !!mdsHangerType1.dist.val = 0
        $!ce/H1
        conn hh to $!ce
        conn ht to $!ce/FITT/H1
        pin 9 dir from pt to ph
        var !pin9dir pin 9 dir
        tdir $!pin9dir
      endif
      --<<wd>11aug2009 - DFN P-22111 (SI-13209) - CURRENTLY this PML CODE is ONLY for the MDS-Witch Hanger(CPL) manufacturers interface
    endif
  endif

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle
  !ce = name
  !!mdsDacControl(TRUE)
  !!ce = !ce.dbref()

  !callingForm.name.val = 'unset'
  !!mdsHangerType1.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType1.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  -- Put the tail direction in the support object
  !!mdsHangerType1.support.tdir = tdir of $!attaName/H1 wrt /*

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType1.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType1.support.tposition = tposition of $!attaName/H1 wrt /*

  --REFACTOR this was extracted from the modify mode label - start
  -- need to be extracted to a separate function file
  !support  = !!mdsHangerType1.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType1.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType1.hangerSelType.val
    !!ce = !exist
  endif
  !!mdsVendorHangerType1.steelMem = !support.rest.beamRefArray
  !!mdsHangerType1.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType1.name.val = !attaName.after('/')
  !!mdsHangerType1.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType1 form gadgets
  !!ce = !attaRef
  !!mdsHangerType1.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType1)

  --<wd>22jul2004
  if (!!mdsVendorHangerType1.hangerSelType.val inset ('1V')) or (!support.datum.:MDSHConfig inset ('1V'))then
    --<<wd>19aug2009 -- DFN P-22111 (SI-13209)
    -- ACTIVATE the DISTANCE and THROUGH Gadgets when configNumber = 1
    !!mdsHangerType1.bthro.active  = TRUE
    !!mdsHangerType1.select.active = TRUE
    !!mdsHangerType1.bdist.active  = TRUE
    !!mdsHangerType1.dist.active   = TRUE
  endif
  --<wd>22jul2004

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        --DTF feb 05
        !!mdsHangerType1.reconnect.active = FALSE
        -- open distance for all types item 189
        !!mdsHangerType1.bthro.active = TRUE
        !!mdsHangerType1.select.active = TRUE
        !!mdsHangerType1.bdist.active = TRUE
        !!mdsHangerType1.dist.active = TRUE
      endif
    endif
  endif

  ------------------------------------------------------------------------
  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType1)
  !hangerStart = !!mdsHangerType1.support.datum.position
  !hangerEnd   = !!mdsHangerType1.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType1.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType1.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType1.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType1)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
-- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
if (!!mdsHangIf.eq('LISEGA')) then
pml load FORM !!mdsundolicad
!!mdsundolicad.support = !!mdsHangerType1.support
!!mdsSaveHangerState(!!mdsundolicad)
endif
-- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END

  return !support

endfunction
