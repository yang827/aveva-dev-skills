-- File:    MdsiHangerType20.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsiHangerType20(!modify is STRING, !textName is STRING,!styp is STRING, !configNumber is REAL, !dummytuberef is DBREF, !beamArray is ARRAY)

  !beamRefArray = !beamArray

  --initialise required forms
  !!initForms('TYPE20')

  --set the vendorform
  !!mdsHangerType20.vendorForm = !!mdsVendorHangerType20

  -- do an STWALL check and set the form members up appropriately, this is done here and may need to be done again if the form
  -- reconnect button is pressed. the STWALL member is only applicable to TYPE20 and 25 hangers.
  if !beamRefArray.set() then
    if !beamRefArray[1].hardType.eq('SCTN') then
      -- we have an STWALL connection set the form.hangertypes.stwallconn member to true
      !!mdsHangerType20.hangertypes.stwallconn = TRUE
    else
      -- we do not have an STWALL connection set the form.hangertypes.stwallconn member to false
      !!mdsHangerType20.hangertypes.stwallconn = FALSE
    endif
  else
    !connectionType = !attaName.dbref().cref.tref.owner.type
    handle ANY
      !connectionType = ''
    endhandle
    if !connectionType.eq('STWALL') then
      -- we have an STWALL connection set the form.hangertypes.stwallconn member to true
      !!mdsHangerType20.hangertypes.stwallconn = TRUE
    else
      -- we do not have an STWALL connection set the form.hangertypes.stwallconn member to false
      !!mdsHangerType20.hangertypes.stwallconn = FALSE
    endif
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  !mdsModeFHShown = !!mdsModFH.shown()

  if !!mdsHangerType20.shown() then
    if (!mdsModeFHShown) then
      -- The user asked to change the hanger type
      -- hide the form
      !!mdsHangerType20.hide()
    else
      !!alert.error('Unable to show form as it is already displayed')
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Init variables etc...
  !attaName = '/' & !textName
  !callingForm = !!mdsInterfaceHanger
  !title = 'Fixed Hanger'
  !initForm = |!!$!callingForm| + |.siteCheck('FH')|
  if (!styp.upcase().match('VH') gt 0) then
    !title = 'Variable Hanger'
    !initForm = |!!$!callingForm| + |.siteCheck('VH')|
  endif

  --REFACTOR if the beamref is unset then we are most likely in modify mode
  --we need to try and get the attached beam references from the hanger
  if !beamRefArray.unset() then
    !beamRefArray = !!mdsInterfaceGetBeamRefs(!attaName.dbref(), !configNumber)
  endif

  --pass the list of create mode beams on to the form
  !!mdsHangerType20.beamArray = !beamRefArray

  -- Initialise variables
  !name = '/' & !textName
  !attaName = '/' & !textName

  -- Initialise Standard gadgets
  !!mdsHangerType20.datum.active = TRUE
  !!mdsHangerType20.bdist.active = FALSE
  !!mdsHangerType20.dist.active = FALSE
  !!mdsHangerType20.bthro.active = FALSE
  !!mdsHangerType20.select.active = FALSE
  !!mdsHangerType20.cancel.active = TRUE
  !!mdsHangerType20.bedplate.active = TRUE
  !!mdsHangerType20.setmat.active = TRUE

  -- Icons Row 2
  !!mdsHangerType20.rotate.active = FALSE
  !!mdsHangerType20.rotatt.active = FALSE

  -- Icons Row 3
  !!mdsHangerType20.modatta.active = FALSE
  !!mdsHangerType20.viewstd.active = TRUE

  -- Icons Row 4
  !!mdsHangerType20.dim.active = FALSE
  !!mdsHangerType20.mdsadp.active = FALSE
  !!mdsHangerType20.zoom.active = FALSE
  !!mdsHangerType20.adploc.active = FALSE

  -- Icons Row 5
  !!mdsHangerType20.reconnect.active = FALSE

  -- Get the config number so we can set the offset coordinate icon availability
  !!mdsInterfaceDynOffset.offsetY.val = 0
  !!mdsInterfaceDynOffset.offsetX.val = 0
  !!mdsInterfaceDynOffset.angley.val = 0
  !!mdsInterfaceDynOffset.anglex.val = 0
  if !!mdsHangIf.eq('LISEGA') then
    !!mdsHangerType20.dynOffset.active = TRUE
  else
    !!mdsHangerType20.dynOffset.active = FALSE
  endif

  if (!modify.upcase() eq 'MODIFY')then
    !support = !!mdsiHangerType20ModifyMode(!name, !attaName, !textName, !styp, !initForm, !callingForm)
    handle 2
      !!kRestoreUnits(!currentUnits)
      return
    elsehandle ANY
      !!kRestoreUnits(!currentUnits)
      if undefined(!!mdsAutoTestRunning) then
        !!alert.message('hanger creation has terminated in an unexpected manner please contact the Aveva Support Team')
      endif
      return
    endhandle
  else $* its create mode
    if !!mdsHangIf.eq('CPL') then
      -- Store Defaults for when in New HANGER Mode, so the CONSTANT SPRING VSPR elements DO NOT EXIST yet!!!
      !!mdsHangerType20.constantNameOne = ||
      !!mdsHangerType20.constantDirectionOne = object DIRECTION()
      !!mdsHangerType20.constantNameTwo = ||
      !!mdsHangerType20.constantDirectionTwo = object DIRECTION()
    endif
    !support = !!mdsiHangerType20CreateMode(!attaName, !textName, !styp, !configNumber, !callingForm)
    handle 99
      !!kRestoreUnits(!currentUnits)
      !!alert.message('hanger creation has been terminated by the user')
      return
    elsehandle 1
      !!kRestoreUnits(!currentUnits)
      if undefined(!!mdsAutoTestRunning) then
        !!alert.message('hanger creation has terminated in an unexpected manner please contact the Aveva Support Team')
      endif
      return
    elsehandle ANY
      !!kRestoreUnits(!currentUnits)
      if undefined(!!mdsAutoTestRunning) then
        !errText = !!error.text
      	!errLine = !!error.line
      	!errCommand = !!error.command
      	!errString = 'hanger creation has terminated in an unexpected manner - ' + !errText + !errLine + ' whilst executing ' + !errCommand
        !!alert.error(!errString)
      endif
      return
    endhandle
  endif

  -- Show rotate icon for manufacturers vertical hangers
  if !attaName.dbref().ldir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().ldir.wrt(/* ).string().eq('Z WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('Z WRT /*') then
    if !attaName.dbref().cref.owner.members.size().eq(2) then
      !!mdsHangerType20.rotatt.active = TRUE
    elseif !attaName.dbref().cref.tdir.string().before(' WRT').eq('D') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('U') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('Z') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('-Z') then
      !!mdsHangerType20.rotatt.active = TRUE
    else
      !!mdsHangerType20.rotatt.active = FALSE
    endif
  else
    if !attaName.dbref().cref.unset().not() then
      if !!mdsRemoveGrad(!attaName.dbref())[1].eq(!attaName.dbref().cref.tdir.opposite()) or !!mdsRemoveGrad(!attaName.dbref())[1].eq(!attaName.dbref().cref.tdir)then
        -- for dynamic riser clamp on horizontal line
        !!mdsHangerType20.rotatt.active = TRUE
      else
        !!mdsHangerType20.rotatt.active = FALSE
      endif
    endif
  endif

  -- Store support object in form
  !!mdsHangerType20.support = !support

  -- Redefine standard support name on form title
  !index = !callingForm.standardRtexBackup.findfirst('$!styp')
  if(!index.unset()) then
    -- Calling form has not be initialized
    -- Populate the form
    -- Updating the callingForm hangers list
    !callingFormShown = !callingForm.shown()
    !callingForm.hide()
    handle ANY
    endhandle
    -- update the list of available hanger types for the current alias ('VH' or 'FH')
    -- The following command will show the form and therefore call the init function as well
    -- This will populate the form with the correct types of hangers.
    $!initForm
    -- if the form was shown, leave it shown, otherwise hide it.
    if(not !callingFormShown) then
      !callingForm.hide()
    endif
    !index = !callingForm.standardRtexBackup.findfirst('$!styp')
  endif

  !text  = !callingForm.standardDtexBackup[!index]
  handle (2,756)
  endhandle

  -- Set text for form title
  if (!!mdsHangIf.upcase().eq('LISEGA')) then
    !text = 'Lisega Hanger'
  elseif  (!!mdsHangIf.upcase().eq('PSL')) then
    !text = 'PSL Hanger'
  elseif  (!!mdsHangIf.upcase().eq('CPL')) then
    !text = 'WH Hanger'
  endif

  !suppNumber = before(!text, '-')
  !formName  = !suppNumber.trim()
  !!mdsHangerType20.support.replace = !formName

  call !!mdsSetFormName(!!mdsHangerType20, '$!title', '$!formName')

  -- Store current form information
  Call !!mdsInterfaceStoreType20()

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  if !!mdsHangIf.eq('CPL') then
    !!mdsHangerType20.rotate.active  = TRUE
  else
    !!mdsHangerType20.rotate.active  = FALSE
  endif
  !!mdsHangerType20.modatta.active = FALSE
  !!mdsHangerType20.viewstd.active = FALSE
  !!mdsHangerType20.dim.active     = FALSE

  -- If type is a civils, get the config number from the :MDSHConfig uda
  !!mdsHangerType20.bthro.active = TRUE
  !!mdsHangerType20.select.active = TRUE
  !!mdsHangerType20.bdist.active = TRUE
  !!mdsHangerType20.dist.active = TRUE
  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if  (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType20.reconnect.active = FALSE
      endif
    endif
  endif

  do !loop from 1 to 9
    pin $!loop off
  enddo

  --><wd>19aug2009 -- DFN P-22111 (SI-13209) -- Added FORM Title for LISEGA, PSL and CPL Interfaces ONLY
  -- This is the LAST place to set the FORM TITLE before the label /CONT code is exited by the return at approximately line 2041 below
  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType20.formTitle = 'MDS-LISEGA Hanger'
      elseif (!!mdsHangIf.upcase().eq('CPL')) then
        !!mdsHangerType20.formTitle = 'MDS-CPL Hanger'
      elseif (!!mdsHangIf.upcase().eq('PSL')) then
        !!mdsHangerType20.formTitle = 'MDS-PSL Hanger'
      endif
    endif
  endif
  --<<wd>19aug2009 -- DFN P-22111 (SI-13209) -- Added FORM Title for LISEGA, PSL and CPL Interfaces ONLY

endfunction
