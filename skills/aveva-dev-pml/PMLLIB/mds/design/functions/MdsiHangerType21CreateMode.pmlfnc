--
----------------------------------------------------------------------
-- File:    MdsiHangerType21CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType21CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  !dynamicParallel =  FALSE
  !!mdsHangerType21.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support .position  = FALSE
  !support .mirror    = FALSE
  !support .rotateCur = FALSE
  !support .handedCur = FALSE
  !support .rotated   = 0
  !support .bPNum     = 1
  !support .alias     = !styp
  !support .modify = FALSE
  -- <sk> 04/06/2012
  !fromAtta = false
  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE
    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'
  elsehandle ANY
  endhandle
  --<sk> 06/06/2012

  -------------------------------
  --- mds Manufacturers interface
  -------------------------------

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
      if  (!!mdsHangIf.eq('LISEGA')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1 or !plDir.up eq -1 ) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType21.type = 'V'
          !selType = !configNumber.string() + 'V'
          !!mdsVendorHangerType21.hangerSelType.val = !selType
        else
          !!mdsVendorHangerType21.type = 'H'
          !selType = !configNumber.string() + 'H'
          !!mdsVendorHangerType21.hangerSelType.val = !selType
        endif
      elseif  (!!mdsHangIf.eq('PSL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType21.type = 'V'
        else
          !!mdsVendorHangerType21.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType21.type
        !!mdsVendorHangerType21.hangerSelType.val = !selType
      elseif  (!!mdsHangIf.eq('CPL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle

        --><wd>04aug2009 - DFN P-22111 (SI-13209)
        -- Added the check here for BOTH of the VERTICAL PIPE Directions, i.e.cHECK for -1(DOWN) or +1(UP) values by using the object REAL.abs() (ABSOLUTE) method
        --            if (!plDir.up EQ 1) then
        if (!plDir.up.abs() eq 1) then
          --<<wd>04aug2009 - DFN P-22111 (SI-13209)

          !support.alias = 'MH01'
          !!mdsVendorHangerType21.type = 'V'
        else
          !!mdsVendorHangerType21.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType21.type
        !!mdsVendorHangerType21.hangerSelType.val = !selType
      endif
    endif
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType21.bthro.active  = TRUE
        !!mdsHangerType21.select.active = TRUE
        !!mdsHangerType21.bdist.active  = TRUE
        !!mdsHangerType21.dist.active   = TRUE
      endif
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType21.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType21.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType21.name.val = !callingForm.name.val
  !!mdsHangerType21.dist.val = 0
  !!mdsHangerType21.p.val = ''
  !!mdsHangerType21.datum.active = TRUE

  if !!mdsHangerType21.support.preliminaryStore.set() then
    !!mdsHangerType21.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType21 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType21.support.rest = !oRest
  !oRest.create(!!mdsHangerType21,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType21.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType21.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType21.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType21 form
  !!kShowForm(!!mdsHangerType21)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning

  !!mdsHangerType21.setGadgets()

  --DUN1218 if we have a virtual fitting object member set on the mdsHangerType21 form then readOnly = true
  if !!mdsHangerType21.virtualFitting.set() then
    !readonly = TRUE
  else
    !readonly = FALSE
  endif

  if (!!manIf.exe.exists()) then
    if (!!mdsVendorHangerType21.type eq 'H') then
      -----------------------------------------
      -- HORIZONTAL PIPES
      -----------------------------------------
      !!ce = !attaName.dbref()
      !ce = !!ce.name
      $!ce/REST
      $!ce/H1
      conn hh to $!ce
      $!ce
      prev
      handle ANY
      elsehandle NONE
        !paDir = pa dir wrt /*
        handle ANY
        elsehandle NONE
          !plDir = pl dir wrt /*
          if ((!paDir.up eq 1 or !paDir.up eq -1) and !paDir.opposite().eq(!plDir)) then
            $!ce
            flip
            conn
            $!ce/H1
            conn hh to $!ce
            $!ce
          endif
        endhandle
      endhandle
      $!ce
      pin 9 copy pl
      pin 8 copy pin 9
      pin 8 dir d wrt /*
      --pin 9 off
      --pin 8 off
      $!!mdsInterfaceHanger.beamRef[1]
      pin1 at ppline na start
      Pin1 dir d
      pin1 throu pin8
      !zDirOfSctn = zdir wrt world
      var !pplineZDir  ppline NA z dir wrt world
      if !!mdsHangerType21.hangertypes.stwallconn.eq(TRUE) then
        if !zDirOfSctn.string().before(' WRT').eq('U') or !zDirOfSctn.string().before(' WRT').eq('D') or !zDirOfSctn.string().before(' WRT').eq('Z') or !zDirOfSctn.string().before(' WRT').eq('-Z')  then
          pin 9 at ce
        else
          pin 9 at pin 1
        endif
      else
        pin 9 at ce
      endif
      pin 9 dir $!zDirOfSctn
      pin 9 PLANE pin 9 thro $!ce
      !tempDirs = !!mdsRemoveGrad(!ce.dbref())
      if !!mdsHangerType21.hangertypes.stwallconn.eq(TRUE) then
        if !pplineZDir.direction().eq(!tempDirs[1]) or !pplineZDir.direction().eq(!tempDirs[2]) then
          !paDir = !tempDirs[1].opposite()
          pin 8 dir $!paDir
          PIN 8 PLANE $!paDir THRO PIN 9
          pin 9 PLANE pin 9 thro pin 8
        else
          !paDir = !tempDirs[1].opposite()
          pin 8 dir $!paDir
          pin 9 dir $!pplineZDir
          pin 9 PLANE pin 9 thro pin 8
        endif
      endif
      pin 9 dir from pin 8 to pin 9
      -- pin1 direction parallel to beam axis
      var !pin1dir pplin NA y dir wrt world
      pin1 dir $!pin1dir wrt world
      -- calculate the offset the fitting along the beam axis from its start

      var !zdist const dist pin8 to plan pin1
      -- get the direction which is orthogonal to web face
      var !xDir PPLIN NA x dir wrt world
      --<wd>sep2005
      -- WRT /* added to "var !hdir pin 9 dir", as !!kClosestPline.pmlfnc <at line 455 below>
      -- was failing with an ERROR of INCOMPLETE COMMAND line at <line69>
      --VAR !hdir pin 9 dir
      var !pin9dir pin 9 dir
      !pin9dirOpp = !pin9dir.direction().opposite()

      if !tempDirs[1].eq(!pin9dirOpp) or !tempDirs[1].eq(!pin9dir.direction()) or !tempDirs[2].eq(!pin9dirOpp) or !tempDirs[2].eq(!pin9dir.direction()) then
        -- Pipe and support direction parallel dynamic
        !dynamicParallel =  TRUE
      elseif !tempDirs[1].angle(!pin9dirOpp).lt(1) or !tempDirs[1].angle(!pin9dir.direction()).lt(1) then
        -- Pipe and support direction parallel dynamic
        !dynamicParallel =  TRUE
      endif

      var !hdir pin 9 dir wrt /*

      --<wd>sep2005
      !tdir = tdir of $!ce/H1 wrt /*
      !hpos = hpos of $!ce/H1 wrt /*
      !closestPline = !!kClosestPline(!!ce,!hpos,!hdir.direction())

      -- We only need the pline that can be connected to, these are
      -- TOS, BOS, TOC, BOC, LEFT, RIGH
      do !getPlineNumber from 1 to !closestPline.size() by 2
        if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
          !plineNumber = !getPlineNumber
          break
        endif
      enddo
      !plineName = pkey of $!closestPline[$!plineNumber]

      var !offsetDist const dist ppline NA start to ppline $!plineName start
      var !offsetDir const dir ppline NA start to ppline $!plineName start
      pin 1 off
      pin 2 off

      if !readonly then
        !!mdsHangerType21.virtualFitting.spref = /MDS/LUG-HANG
        !!mdsHangerType21.virtualFitting.setZdist(!zdist.real())
        !currentDelpos = !!mdsHangerType21.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType21.virtualFitting.delPosition = !currentDelpos
        !!mdsHangerType21.virtualFitting.posline = !plineName
        !!mdsHangerType21.virtualFitting.setdelpos(!!mdsHangerType21.virtualFitting.getPosition())
        !sctnPoss = !!mdsHangerType21.virtualFitting.owner.posstart.wrt( /* )
        !sctnPose = !!mdsHangerType21.virtualFitting.owner.posend.wrt( /* )
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        var !pin9position pos pin 9 wrt /*
        --zdist thro pin 9
        !!mdsHangerType21.virtualFitting.zDistThrough(!pin9position.position())
        !currentDelpos = !!mdsHangerType7.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType7.virtualFitting.delPosition = !currentDelpos
        $!ce/H1
        --conn ht to $!ce/FITT/H1
        !!ce.tpos = !!mdsHangerType21.virtualFitting.getPosition()
        !!ce.tdir = !!mdsHangerType21.virtualFitting.getposLineZdir()
      else
        -- Create the fitting for the 1 hanger if not already created
        !!mdsDacControl(TRUE)
        new fitt $!ce/FITT/H1
        handle NONE
        elsehandle ANY
          delete fitt
        endhandle
        $!ce/FITT/H1
        Spref /MDS/LUG-HANG
        zdist $!zdist
        delp n0
        posl $!plineName
        !sctnPoss = poss of owner of $!ce/FITT/H1 wrt /*
        !sctnPose = pose of owner of $!ce/FITT/H1 wrt /*
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        zdist thro pin 9
        delp n0
        $!ce/H1
        conn ht to $!ce/FITT/H1
      endif

      --<RM> 11/08/08 modified the code below because i was having trouble with old hangers being built with an incorrect tdir
      -- as a result when modifying the hanger tail would be built in the wrong orientation.
      var !htdir const DIRECTION ht to hh
      pin 9 copy pt
      !pin9dir = !!ce.tdir.wrt( /* ).string()

      if !pin9dir.direction().dot(!htdir.direction()).lt(0.99) then
        !pin9dirOpp = !pin9dir.direction().opposite()
        tdir $!pin9dirOpp
      else
        tdir $!pin9dir
      endif

      !pin9dirOpp = !pin9dir.direction().opposite()
      --<RM> 11/08/08 end of fix

      !attaDirs = !!mdsRemoveGrad(!attaName.dbref())
      $!ce

      -- test to see if we have a vertical pipe
      var !plDirect dir pl of $!ce
      !pipeUpAng = !plDirect.direction().angle( U wrt /* ).real()
      if !pipeUpAng.gt(90) then
        !pipeUpAng = 180 - !pipeUpAng
      endif

      if !pipeUpAng.gt(45) then
        !pipeDir = 'HORZ'
      else
        !pipeDir = 'VERT'
      endif

      if !pipeDir.eq('HORZ') and !dynamicParallel.not() then
        --if pipe direction is predominantly horizontal

        -- <RM> 01 Dec 06 -- re-wrote the commented lines from line 599 this is so that the intersections
        -- between pipe and section is handled via plane / vector intersections instead of through statements
        !sctnCrossDir = !sctnDirection.direction().cross(!pin9dir.direction())
        !sctnPV = object POINTVECTOR(!sctnPoss, !sctnCrossDir)

        pin 1 at $!sctnPoss
        pin 1 dir $!sctnCrossDir

        var !attaDir dir pl of $!attaName wrt /*
        var !attaPos pos pl of $!attaName wrt /*

        pin 2 at $!attaPos wrt /*
        pin 2 dir $!attaDir

        !attaPV = object POINTVECTOR(!attaPos.position(), !attaDir.direction())
        !attaSctnInter = !attaPV.intersection(!sctnPV.plane())
        handle ANY
          -- if we hit this error then the sctn and pipe are in parallel directions
          -- we therefore apply a POINTVECTOR that corresponds to the start of the sctn
          -- in the direction of the section to the atta and intersect a plane through the steelwork.

          -- get the steel POINTVECTOR
          if !readonly then
            !owner = !!mdsHangerType21.virtualFitting.owner
            var !posLPoss pos ppli $!plineName start of $!owner wrt /*
            var !posLPose pos ppli $!plineName end of $!owner wrt /*
          else
            var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
            var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
          endif
          var !posLDir const dir $!posLPoss to $!posLPose

          -- position the POINTVECTOR at the atta
          !posLDirAttaPV = object POINTVECTOR(!attaPos.position(), !posLDir.direction())
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!posLDirAttaPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif

          if !readonly then
            !!mdsHangerType21.virtualFitting.setZdist(!newZDist)
          else
            $!ce/FITT/H1 zdist $!newZDist
          endif

        elsehandle NONE

          !pipeSctnPV = object POINTVECTOR(!attaSctnInter, !sctnDirection.direction())

          if !readonly then
            !owner = !!mdsHangerType21.virtualFitting.owner
            var !posLPoss pos ppli $!plineName start of $!owner wrt /*
            var !posLPose pos ppli $!plineName end of $!owner wrt /*
          else
            var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
            var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
          endif

          var !posLDir const dir $!posLPoss to $!posLPose
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!pipeSctnPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          -- reposition the atta and fitting position in lieu of the adjustments above
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif

          if !readonly then
            !!mdsHangerType21.virtualFitting.setZdist(!newZDist)
          else
            $!ce/FITT/H1 zdist $!newZDist
          endif

          $!attaName pos $!attaSctnInter

        endhandle
      elseif !dynamicParallel.not() then
        --if pipe direction is predominantly vertical

        !sctnPV = object POINTVECTOR(!sctnPoss, up)
        var !attaDir dir pl of $!attaName wrt /*
        var !attaPos pos pl of $!attaName wrt /*
        !attaPV = object POINTVECTOR(!attaPos.position(), !attaDir.direction())
        !attaSctnInter = !attaPV.intersection(!sctnPV.plane())

        -- we need to make sure we have the correct pline on the sctn
        if !readonly then
          !owner = !!mdsHangerType21.virtualFitting.owner
          var !pipeToSteelDir const dir $!attaSctnInter to ppli na start of $!owner
          var !steelRef $!owner
        else
          var !pipeToSteelDir const dir $!attaSctnInter to ppli na start of owner of $!ce/FITT/H1
          var !steelRef owner of $!ce/FITT/H1
        endif
        !closestPline = !!kClosestPline(!steelRef.dbref(),!attaSctnInter,!pipeToSteelDir.direction())
        handle ANY
          !hpos = hpos of $!ce/H1 wrt /*
          if !readonly then
            !owner = !!mdsHangerType21.virtualFitting.owner
            var !pipeToSteelDir const dir $!hpos to ppli na start of $!owner
          else
            var !pipeToSteelDir const dir $!hpos to ppli na start of owner of $!ce/FITT/H1
          endif
          !closestPline = !!kClosestPline(!steelRef.dbref(),!hpos,!pipeToSteelDir.direction())
        endhandle

        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]
        $!ce/FITT/H1 posl $!plineName

        --we now need to adjust the atta position if the supporting steelwork is rotated
        var !naToPoss const dir ppli na start of owner of $!ce/FITT/H1 to ppli $!plineName start of owner of $!ce/FITT/H1
        if !readonly then
          !owner = !!mdsHangerType21.virtualFitting.owner
          var !posLPoss pos ppli $!plineName start of $!owner wrt /*
          var !posLPose pos ppli $!plineName end of $!owner wrt /*
        else
          var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
          var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
        endif
        var !posLDir const dir $!posLPoss to $!posLPose
        !attaPlaneDir = !posLDir.direction().cross(!naToPoss.direction())
        !attaPlaneDirPV = object POINTVECTOR(!posLPoss.position(),!attaPlaneDir)
        !attaSctnInter = !attaPV.intersection(!attaPlaneDirPV.plane())
        handle ANY
          --<RM> 20/08/08, included this handle block because i was having trouble with vertical pipes with vertical sections
        elsehandle NONE
          !pipeSctnPV = object POINTVECTOR(!attaSctnInter, !sctnDirection.direction())
          !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
          !sctnPipeInter = !posLDirPV.intersection(!pipeSctnPV.plane())
          var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
          -- reposition the atta and fitting position in lieu of the adjustments above
          !newZDist = !posLPoss.position().distance(!sctnPipeInter)
          if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
            !newZDist = !newZDist * -1
          endif
          $!ce/FITT/H1 zdist $!newZDist
          $!attaName pos $!attaSctnInter
        endhandle
      endif

      $!ce/H1

      conn hh to $!ce
      --<RM> 11/08/08 put a test in for these lines because they were causing build problems for LICAD type hangers
      if (!!mdsHangIf.upcase().neq('LISEGA')) then
        if !readonly then
          --conn ht to $!ce/FITT/H1
        !!ce.tpos = !!mdsHangerType21.virtualFitting.getPosition()
        !!ce.tdir = !!mdsHangerType21.virtualFitting.getposLineZdir()
        else
          conn ht to $!ce/FITT/H1
        endif
      endif
      --<RM> 11/08/08 end of fix
      !hangerStart = !!ce.hpos.wrt( /* )
      !hangerEnd = !!ce.tpos.wrt( /* )
      $!ce

      -- now update the aid lines
      !!mdsAidText(!!mdsHangerType21)
      aid clear line 2999
      handle ANY
      endhandle
      aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted


      if (!!mdsHangerType21.dist.active eq FALSE) then
        $!ce
        -- Get general direction of pleave of datum atta
        -- Plane direction is nearest value to 1
        !plDir = pl dir of $!attaName
        --<RM> 26/06/07 -- removed the following !planeDir needs to be the pleave of the atta
        -- which has gone through !!mdsRemoveGrad
        !directions = !!mdsRemoveGrad(!attaName.dbref())
        !planeDir = !directions[1]

        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
        if !readonly then
          !tailPosition = !!mdsHangerType21.virtualFitting.getPosition()
          PLANE $!planeDir through $!tailPosition
        else
          PLANE $!planeDir through $!ce/FITT/H1
        endif
        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end

        !isWithinTube = !!mdsIsWithinTube(!ce.dbref())
        if (not !isWithinTube ) then
          Spkbrk FALSE
        endif
        $!ce/H1
        conn hh to $!ce
        $!ce
      else
        !!mdsVendorHangerType21.jointrotate = FALSE
      endif

    elseif (!!mdsVendorHangerType21.type eq 'V') then
      -----------------------------------------
      -- VERTICAL PIPES
      -----------------------------------------
      !!ce = !attaName.dbref()
      !ce = !!ce.name
      $!ce/REST
      $!ce/H1
      conn hh to $!ce
      $!ce
      prev
      handle ANY
      endhandle
      !paDir = pa dir wrt /*
      handle ANY
      endhandle
      pin 9 copy pl
      pin 8 copy pin 9
      pin 8 dir d wrt /*
      pin 9 off
      pin 8 off
      $!!mdsInterfaceHanger.beamRef[1]
      pin1 at ppline na start
      Pin1 dir d
      pin1 throu pin8
      -- pin1 direction parallel to beam axis
      pin1 dir pplin NA y dir
      -- calculate the offset the fitting along the beam axis from its start
      var !zdist const dist pin8 to plan pin1
      -- get the direction which is orthogonal to web face
      var !xDir PPLIN NA x dir
      -- Get closest pline to atta
      !hdir = hdir of $!ce/H1 wrt /*
      -- DTF removed next 2 lines tail not been positioned yet
      -- fitting not yet created
      --var !hhdir const dir hh of $!ce/H1 to ht of $!ce/H1
      --!hdir = !hhdir.direction()
      !hpos = hpos of $!ce/H1 wrt /*

      if !hdir.unset() then
        -- the atta and the tail are at the same place this is a riser type support
        !hdir = hdir of $!ce/H1 wrt /*
      endif
      if !attaName.dbref().ldir.string().before(' WRT').eq('U') or !attaName.dbref().ldir.string().before(' WRT').eq('D') or !attaName.dbref().ldir.string().before(' WRT').eq('Z') or !attaName.dbref().ldir.string().before(' WRT').eq('-Z') then
        var !hhdir const dir hh of $!ce/H1 to ht of $!ce/H1
        !hdir = !hhdir.direction()
      endif
      !closestPline = !!kClosestPline(!!ce,!hpos,!hdir)

      -- We only need the pline that can be connected to, these are
      -- TOS, BOS, TOC, BOC, LEFT, RIGH
      do !getPlineNumber from 1 to !closestPline.size() by 2
        if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
          !plineNumber = !getPlineNumber
          break
        endif
      enddo
      !plineName = pkey of $!closestPline[$!plineNumber]
      var !offsetDist const dist ppline NA start to ppline $!plineName start
      var !offsetDir const dir ppline NA start to ppline $!plineName start
      pin 1 off
      pin 2 off

      if !readonly then
        !owner = !!mdsHangerType21.virtualFitting.owner
        !!mdsHangerType21.virtualFitting.setZdist(!zdist)
        !currentDelpos = !!mdsHangerType7.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType7.virtualFitting.delPosition = !currentDelpos
        !!mdsHangerType21.virtualFitting.posline = !plineName
        !!mdsHangerType21.virtualFitting.setdelpos(!!mdsHangerType21.virtualFitting.getPosition())
        !sctnPoss = poss of $!owner wrt /*
        !sctnPose = pose of $!owner wrt /*
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        var !pin9position pos pin 9 wrt /*
        !!mdsHangerType21.virtualFitting.zDistThrough(!pin9position.position())
        !currentDelpos = !!mdsHangerType7.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType7.virtualFitting.delPosition = !currentDelpos
      else
        -- Create the fitting for the 1 hanger if not already created
        !!mdsDacControl(TRUE)
        new fitt $!ce/FITT/H1
        handle NONE
        elsehandle ANY
          delete fitt
        endhandle
        $!ce/FITT/H1
        Spref /MDS/LUG-HANG
        zdist $!zdist
        delp n0
        posl $!plineName

        !sctnPoss = poss of owner of $!ce/FITT/H1 wrt /*
        !sctnPose = pose of owner of $!ce/FITT/H1 wrt /*
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection wrt world
        pin 9 PLANE pin 9 thro $!ce
        zdist thro pin 9
        delp n0
        $!ce/H1
      endif

      if !readonly then
        --conn ht to $!ce/FITT/H1
        !!ce.tpos = !!mdsHangerType21.virtualFitting.getPosition()
        !!ce.tdir = !!mdsHangerType21.virtualFitting.getposLineZdir()
      else
        conn ht to $!ce/FITT/H1
      endif

      pin 9 copy pt
      !pin9dir = !!ce.tdir.wrt( /* ).string()
      !pin9dirOpp = !pin9dir.direction().opposite()
      tdir $!pin9dirOpp
      !attaDirs = !!mdsRemoveGrad(!attaName.dbref())
      $!ce

      -- <RM> 01 Dec 06 -- re-wrote the commented lines from line 599 this is so that the intersections
      -- between pipe and section is handled via plane / vector intersections instead of through statements
      !sctnCrossDir = !sctnDirection.direction().cross(!pin9dir.direction())
      !sctnPV = object POINTVECTOR(!sctnPoss, !sctnCrossDir)
      var !attaDir dir pl of $!attaName wrt /*
      var !attaPos pos pl of $!attaName wrt /*

      !attaPV = object POINTVECTOR(!attaPos.position(), !attaDir.direction())
      !attaSctnInter = !attaPV.intersection(!sctnPV.plane())
      handle ANY
        -- if we hit this error then the sctn and pipe are in parallel directions
        -- we therefore apply a POINTVECTOR that corresponds to the start of the sctn
        -- in the direction of the section to the atta and intersect a plane through the steelwork.

        -- get the steel POINTVECTOR
        if !readonly then
          !owner = !!mdsHangerType21.virtualFitting.owner
          var !posLPoss pos ppli $!plineName start of $!owner wrt /*
          var !posLPose pos ppli $!plineName end of $!owner wrt /*
        else
          var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
          var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
        endif
        var !posLDir const dir $!posLPoss to $!posLPose

        -- position the POINTVECTOR at the atta
        !posLDirAttaPV = object POINTVECTOR(!attaPos.position(), !posLDir.direction())
        !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
        !sctnPipeInter = !posLDirPV.intersection(!posLDirAttaPV.plane())
        !newZDist = !posLPoss.position().distance(!sctnPipeInter)
        if !readonly then
          !!mdsHangerType21.virtualFitting.setZdist(!newZDist)
        else
          $!ce/FITT/H1 zdist $!newZDist
        endif

      elsehandle NONE
        !pipeSctnPV = object POINTVECTOR(!attaSctnInter, !sctnDirection.direction())
        if !readonly then
          !owner = !!mdsHangerType21.virtualFitting.owner
          var !posLPoss pos ppli $!plineName start of $!owner wrt /*
          var !posLPose pos ppli $!plineName end of $!owner wrt /*
        else
          var !posLPoss pos ppli $!plineName start of owner of $!ce/FITT/H1 wrt /*
          var !posLPose pos ppli $!plineName end of owner of $!ce/FITT/H1 wrt /*
        endif
        var !posLDir const dir $!posLPoss to $!posLPose
        !posLDirPV = object POINTVECTOR(!posLPoss.position(), !posLDir.direction())
        !sctnPipeInter = !posLDirPV.intersection(!pipeSctnPV.plane())
        var !sctnInterDir const dir $!posLPoss to $!sctnPipeInter
        -- reposition the atta and fitting position in lieu of the adjustments above
        !newZDist = !posLPoss.position().distance(!sctnPipeInter)
        if !posLDir.direction().dot(!sctnInterDir.direction()).lt(0.5) then
          !newZDist = !newZDist * -1
        endif
        $!ce/FITT/H1 zdist $!newZDist
        $!attaName pos $!attaSctnInter

      endhandle

      $!ce/H1
      if !readonly then
        --conn ht to $!ce/FITT/H1
        !!ce.tpos = !!mdsHangerType21.virtualFitting.getPosition()
        !!ce.tdir = !!mdsHangerType21.virtualFitting.getposLineZdir()
      else
        conn ht to $!ce/FITT/H1
      endif
      conn hh to $!ce
      $!ce

      -- now update the aid lines
      !!mdsAidText(!!mdsHangerType21)
      var !attaPos pos pl of $!attaName wrt /*
      !hangerStart = !attaPos.position()
      !hangerEnd   = !sctnPipeInter
      aid clear line 2999
      handle ANY
      endhandle
      aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

    endif

  endif

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle
  !ce = name
  !!mdsDacControl(TRUE)
  $!ce/H1
  handle NONE
    if !dynamicParallel.not() then
      pin 1 at ph
      pin 2 at pt
      !tdir.delete()
      --var !tdir tdir wrt /*
      handle ANY
      endhandle
      var !tdir const dir pin 2 to pin 1
      if !tdir.direction().angle(U).gt(-.1) and !tdir.direction().angle(U).lt(.1) then
        tdir U wrt /*
      elseif !tdir.direction().angle(D).gt(-.1) and !tdir.direction().angle(D).lt(.1) then
        tdir D wrt /*
      else
        -- <RM 04/08/08> removed this LINE for the LICAD interface because it was causing problems in create mode for LISEGA hangers
        -- that are attached to vertical steelwork. the problem was that TDIR was not perpendicular to the face of the steelwork.
        -- TDIR is correctly defined earlier so this is not required.
        if  (!!mdsHangIf.neq('LISEGA')) then
          tdir $!tdir
        endif
        -- <RM 04/08/08> end of fix
      endif
      !!mdsResetPins(1,2)
    endif
  elsehandle ANY
  endhandle
  !!ce = !ce.dbref()

  !callingForm.name.val = 'unset'
  !!mdsHangerType21.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType21.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  -- Put the tail direction in the support object
  if !!mdsHangIf.eq('LISEGA') then
    --<RM 18/08/08> put in this check to correctly set the tdir of the hanger to the z direction of the closest pline
    -- some hangers were being created with garbage TDIRS which led to a failure in MDSDYNOFFSET
    !!ce = !attaRef
    if !readonly then
      !sctn = !!mdsHangerType21.virtualFitting.owner
    else
      var !stRef owner of tref of cref
      !sctn = !stRef.dbref()
    endif

    !!ce = !ce.dbref()
    if !sctn.type.eq('SCTN') then
      -- get the zdir of the closest pline
      var !plineTDir ppli $!plineName ori of $!sctn
      !current = !!ce
      $!attaName/H1
      !newPlineTDir = !plineTDir.orientation().zDir()
      tdir $!newPlineTDir
      !!ce = !current
    endif
    !!mdsHangerType21.support.tdir = tdir of $!attaName/H1 wrt /*
  else
    !!mdsHangerType21.support.tdir = tdir of $!attaName/H1 wrt /*
  endif

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType21.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType21.support.tposition = tposition of $!attaName/H1 wrt /*

  !support  = !!mdsHangerType21.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType21.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType21.hangerSelType.val
    !!ce = !exist
  endif
  !!mdsVendorHangerType21.steelMem = !support.rest.beamRefArray
  !!mdsHangerType21.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType21.name.val = !attaName.after('/')
  !!mdsHangerType21.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType21 form gadgets
  !!ce = !attaRef
  !!mdsHangerType21.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType21)

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        --DTF feb 05
        !!mdsHangerType21.reconnect.active = FALSE
        -- open distance for all types item 189
        !!mdsHangerType21.bthro.active = TRUE
        !!mdsHangerType21.select.active = TRUE
        !!mdsHangerType21.bdist.active = TRUE
        !!mdsHangerType21.dist.active = TRUE
      endif
    endif
  endif

  ------------------------------------------------------------------------
  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType21)
  !hangerStart = !!mdsHangerType21.support.datum.position
  !hangerEnd   = !!mdsHangerType21.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType21.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType21.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType21.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType21)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
-- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
if (!!mdsHangIf.eq('LISEGA')) then
pml load FORM !!mdsundolicad
!!mdsundolicad.support = !!mdsHangerType21.support
!!mdsSaveHangerState(!!mdsundolicad)
endif
-- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END

  return !support

endfunction
