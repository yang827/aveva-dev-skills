--
----------------------------------------------------------------------
-- File:    MdsiHangerType25CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType25CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  ----------------------
  -- Create a NEW HANGER
  ----------------------
  !dynamicParallel =  FALSE
  !!mdsHangerType25.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support .position  = FALSE
  !support .mirror    = FALSE
  !support .rotateCur = FALSE
  !support .handedCur = FALSE
  !support .rotated   = 0
  !support .bPNum     = 1
  !support .alias     = !styp
  !support .modify = FALSE
  -- <sk> 04/06/2012
  !fromAtta = false
  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE
    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'
  elsehandle ANY
  endhandle
  --<sk> 06/06/2012

  -------------------------------
  --- mds Manufacturers interface
  -------------------------------

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
      if  (!!mdsHangIf.eq('LISEGA')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1 or !plDir.up eq -1 ) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType25.type = 'V'
          !selType = !configNumber.string() + 'V'
          !!mdsVendorHangerType25.hangerSelType.val = !selType
        else
          !!mdsVendorHangerType25.type = 'H'
          !selType = !configNumber.string() + 'H'
          !!mdsVendorHangerType25.hangerSelType.val = !selType
        endif
      elseif  (!!mdsHangIf.eq('PSL')) then
        !!mdsVendorHangerType25.type = ''
      elseif  (!!mdsHangIf.eq('CPL')) then
        !!mdsVendorHangerType25.type = ''
      endif
    endif
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType25.bthro.active  = TRUE
        !!mdsHangerType25.select.active = TRUE
        !!mdsHangerType25.bdist.active  = TRUE
        !!mdsHangerType25.dist.active   = TRUE
      elseif (!!mdsHangIf.upcase().eq('PSL')) then
        !!mdsHangerType25.dist.active = TRUE
      elseif (!!mdsHangIf.upcase().eq('CPL')) then
        !!mdsHangerType25.dist.active = TRUE
      endif
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType25.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType25.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType25.name.val = !callingForm.name.val
  !!mdsHangerType25.dist.val = 0
  !!mdsHangerType25.p.val = ''
  !!mdsHangerType25.datum.active = TRUE

  if !!mdsHangerType25.support.preliminaryStore.set() then
    !!mdsHangerType25.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType25 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType25.support.rest = !oRest
  !oRest.create(!!mdsHangerType25,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType25.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType25.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType25.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType25 form
  !!kShowForm(!!mdsHangerType25)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning

  !!mdsHangerType25.setGadgets()

  if !!mdsHangerType25.virtualFitting.set() then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if (!!manIf.exe.exists()) then
    if (!!mdsHangerType25.hangertypes.stwallconn.eq(TRUE) ) then
      if (!!mdsVendorHangerType25.type eq 'H') then
        -----------------------------------------
        -- HORIZONTAL PIPES
        -----------------------------------------
        !!ce = !attaName.dbref()
        !ce = !!ce.name
        $!ce/REST
        $!ce/H1
        conn hh to $!ce
        $!ce
        prev
        handle ANY
        elsehandle NONE
          !paDir = pa dir wrt /*
          handle ANY
          elsehandle NONE
            !plDir = pl dir wrt /*
            if ((!paDir.up eq 1 or !paDir.up eq -1) and !paDir.opposite().eq(!plDir)) then
              $!ce
              flip
              conn
              $!ce/H1
              conn hh to $!ce
              $!ce
            endif
          endhandle
        endhandle
        $!ce
        pin 9 copy pl
        pin 8 copy pin 9
        pin 8 dir d wrt /*
        --pin 9 off
        --pin 8 off
        $!!mdsInterfaceHanger.beamRef[1]
        pin1 at ppline na start
        Pin1 dir d
        pin1 throu pin8
        !zDirOfSctn = zdir wrt world
        var !pplineZDir  ppline NA z dir wrt world
        if !zDirOfSctn.string().before(' WRT').eq('U') or !zDirOfSctn.string().before(' WRT').eq('D') or !zDirOfSctn.string().before(' WRT').eq('Z') or !zDirOfSctn.string().before(' WRT').eq('-Z') then
          pin 9 at ce
        else
          pin 9 at pin 1
        endif
        pin 9 dir $!zDirOfSctn
        pin 9 PLANE pin 9 thro $!ce
        !tempDirs = !!mdsRemoveGrad(!ce.dbref())
        if !pplineZDir.direction().eq(!tempDirs[1]) or !pplineZDir.direction().eq(!tempDirs[2]) then
          !paDir = !tempDirs[1].opposite()
          pin 8 dir $!paDir
          PIN 8 PLANE $!paDir THRO PIN 9
          pin 9 PLANE pin 9 thro pin 8
        else
          !paDir = !tempDirs[1].opposite()
          pin 8 dir $!paDir
          pin 9 dir $!pplineZDir
          pin 9 PLANE pin 9 thro pin 8
        endif
        pin 9 dir from pin 8 to pin 9
        -- pin1 direction parallel to beam axis
        var !pin1dir pplin NA y dir wrt world
        pin1 dir $!pin1dir wrt world
        -- calculate the offset the fitting along the beam axis from its start

        var !zdist const dist pin8 to plan pin1
        -- get the direction which is orthogonal to web face
        var !xDir PPLIN NA x dir wrt world
        --<wd>sep2005
        -- WRT /* added to "var !hdir pin 9 dir", as !!kClosestPline.pmlfnc <at line 455 below>
        -- was failing with an ERROR of INCOMPLETE COMMAND line at <line69>
        --VAR !hdir pin 9 dir
        var !pin9dir pin 9 dir
        !pin9dirOpp = !pin9dir.direction().opposite()

        if !tempDirs[1].eq(!pin9dirOpp) or !tempDirs[1].eq(!pin9dir.direction()) or !tempDirs[2].eq(!pin9dirOpp) or !tempDirs[2].eq(!pin9dir.direction()) then
          -- Pipe and support direction parallel dynamic
          !dynamicParallel =  TRUE
        elseif !tempDirs[1].angle(!pin9dirOpp).lt(1) or !tempDirs[1].angle(!pin9dir.direction()).lt(1) then
          -- Pipe and support direction parallel dynamic
          !dynamicParallel =  TRUE
        endif

        if !dynamicParallel then
          !hdir = !tempDirs[1].string()
        else
          var !hdir pin 9 dir wrt /*
        endif

        !hpos = hpos of $!ce/H1 wrt /*
        !closestPline = !!kClosestPline(!!ce,!hpos,!hdir.direction())

        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]

        var !offsetDist const dist ppline NA start to ppline $!plineName start
        var !offsetDir const dir ppline NA start to ppline $!plineName start
        pin 1 off
        pin 2 off
        -- Create the fitting for the 1 hanger if not already created
        !!mdsDacControl(TRUE)
        new fitt $!ce/FITT/H1
        handle NONE
        elsehandle ANY
          delete fitt
        endhandle
        $!ce/FITT/H1
        Spref /MDS/LUG-HANG
        zdist $!zdist
        delp n0
        posl $!plineName
        --!!mdsDacControl(FALSE)
        !sctnPoss = poss of owner of $!ce/FITT/H1
        !sctnPose = pose of owner of $!ce/FITT/H1
        var !sctnDirection const dir $!sctnPoss to $!sctnPose
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection
        pin 9 PLANE pin 9 thro $!ce
        zdist thro pin 9
        delp n0
        $!ce/H1
        conn ht to $!ce/FITT/H1
        pin 9 copy pt
        $!ce
        -- DTF >>>
        pin 7 copy pin 9
        !opdir = !sctnDirection.direction().opposite()
        pin 7 dir $!opdir
        pin 7 PLANE pin 7 dist 20000
        var !linea construct line pin 9 to pin 7
        pin 10 copy pl
        pin 6 copy pin 10
        pin 10 PLANE pin 10 dist 20000
        var !lineB construct line pin 6 to pin 10
        var !inter construct pos int $!lineB $!linea  wrt /*
        pin 10 at $!inter wrt /*
        handle ANY
          pin 10 PLANE pin 10 thro prev
          handle ANY
            pin 10 PLANE pin 10 thro ph
          endhandle
        endhandle
        --var !pin10pos pin 10 pos wrt /*
        --!posPin10 = !pin10pos.position() -- seemingly not used
        thro pin 10
        !!mdsResetPins(7,10)
        -- DTF <<< end
        --thro pin 9
        same
        pos hh at href
        -- reposition fitting again it may be a sloping line
        pin 9 at $!sctnPoss
        pin 9 dir $!sctnDirection
        pin 9 PLANE pin 9 thro $!ce
        $!ce/FITT/H1
        zdist thro pin 9
        $!ce/H1
        conn ht to $!ce/FITT/H1
        pin 9 copy pt
        pin 9 dir from ht to hh
        var !pin9dir pin 9 dir
        -- Var !htdir const direction pt to ph -- seemingly unused
        tdir $!pin9dir
        !!mdsResetPins(9,9)
        !!mdsDacControl(FALSE)

        if (!!mdsHangerType25.dist.active eq FALSE) then
          $!ce
          -- Get general direction of pleave of datum atta
          -- Plane direction is nearest value to 1
          !plDir = pl dir of $!attaName
          --<RM> 26/06/07 -- removed the following !planeDir needs to be the pleave of the atta
          -- which has gone through !!mdsRemoveGrad
          !directions = !!mdsRemoveGrad(!attaName.dbref())
          !planeDir = !directions[1]
          PLANE $!planeDir through $!ce/FITT/H1
          handle ANY
            PLANE $!planeDir through $!ce/CMPF
          endhandle

          !isWithinTube = !!mdsIsWithinTube(!ce.dbref())
          if (not !isWithinTube ) then
            Spkbrk FALSE
          endif
          $!ce/H1
          conn hh to $!ce
          $!ce
        else
          !!mdsVendorHangerType25.jointrotate = FALSE
        endif
      elseif (!!mdsVendorHangerType25.type eq 'V') then
        -----------------------------------------
        -- VERTICAL PIPES
        -----------------------------------------
        if (!!mdsHangerType25.hangertypes.stwallconn.eq(TRUE) ) then

          !!ce = !attaName.dbref()
          !ce = !!ce.name
          $!ce/REST
          $!ce/H1
          conn hh to $!ce
          $!ce
          prev
          handle ANY
          endhandle
          !paDir = pa dir wrt /*
          handle ANY
          endhandle
          pin 9 copy pl
          pin 8 copy pin 9
          pin 8 dir d wrt /*
          pin 9 off
          pin 8 off
          $!!mdsInterfaceHanger.beamRef[1]
          pin1 at ppline na start
          Pin1 dir d
          pin1 throu pin8
          -- pin1 direction parallel to beam axis
          pin1 dir pplin NA y dir
          -- calculate the offset the fitting along the beam axis from its start
          var !zdist const dist pin8 to plan pin1
          -- get the direction which is orthogonal to web face
          var !xDir PPLIN NA x dir
          -- Get closest pline to atta
          !hdir = hdir of $!ce/H1 wrt /*
          !hpos = hpos of $!ce/H1 wrt /*
          !closestPline = !!kClosestPline(!!ce,!hpos,!xDir.direction())
          -- We only need the pline that can be connected to, these are
          -- TOS, BOS, TOC, BOC, LEFT, RIGH
          do !getPlineNumber from 1 to !closestPline.size() by 2
            if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
              !plineNumber = !getPlineNumber
              break
            endif
          enddo
          !plineName = pkey of $!closestPline[$!plineNumber]
          var !offsetDist const dist ppline NA start to ppline $!plineName start
          var !offsetDir const dir ppline NA start to ppline $!plineName start
          pin 1 off
          pin 2 off
          -- Create the fitting for the 1 hanger if not already created
          !!mdsDacControl(TRUE)
          new fitt $!ce/FITT/H1
          handle NONE
          elsehandle ANY
            delete fitt
          endhandle
          $!ce/FITT/H1
          Spref /MDS/LUG-HANG
          zdist $!zdist
          posl $!plineName
          --><wd>11aug2009 - DFN P-22111 (SI-13209) - CURRENTLY the "else" block below PML CODE is ONLY for the MDS-Witch Hanger(CPL) manufacturers interface
          -- The "else" block of PML CODE ADDED here for VERTICAL PIPES from the HORIZONTAL PIPES PML CODE above, with some changes and deletions of CODE.
          -- The PML CODE ADDED for HANGER TYPES "2 and 32" for SINGLE or TWIN Hangers on ONE or TWO SETS of Double Channel ([ shape)SCTNS
          -- Also the PML CODE added for HANGER TYPE "31" for TWIN HANGERS from ONE or TWO normal BEAM (I shape) SCTNS
        else
          if (!!mdsHangIf.upcase().eq('CPL')) then
            -- Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
            !!ce = !attaName.dbref()

            !!ce.:MDSHConfig = !configNumber & !!mdsVendorHangerType25.type
            !!mdsVendorHangerType25.hangerSelType.val = !!ce.:MDSHConfig
            !ce = !!ce.name
            -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
            AT PL of PREVIOUS
            handle ANY
              AT PH
            endhandle
            !!mdsHangerType25.dist.val = 0
            $!ce/H1
            conn hh to $!ce
            conn ht to $!ce/FITT/H1
            pin 9 dir from pt to ph
            var !pin9dir pin 9 dir
            tdir $!pin9dir
          endif
          --<<wd>11aug2009 - DFN P-22111 (SI-13209) - CURRENTLY this PML CODE is ONLY for the MDS-Witch Hanger(CPL) manufacturers interface
        endif
      endif
    endif
  endif

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle
  !ce = name
  !!mdsDacControl(TRUE)
  $!ce/H1
  CONN HH TO $!ce

  if !virtualFitting then

    !cmpfPosition = !!mdsHangerType25.virtualFitting.getPosition()
    pos pt at $!cmpfPosition

    --$!ce/CMPF
    --handle ANY
    --REFACTOR, this is only true if we are connected to an STWALL, need to look at this in more detail
$(
    pin 1 at $!ce/FITT/H1
    pin 9 at $!ce/FITT/H1
    var !xDir ppline $!plineName x dir of owner of $!ce/FITT/H1 wrt world
    PIN 1 DIR $!xDir wrt world
    PIN 1 PLANE PIN 1 THRO ph of $!ce/H1
    var !attaDir dir pl of $!ce
    pin 2 copy pin 1
    pin 2 dir $!attaDir
    PIN 2 PLANE PIN 2 THRO ph of $!ce/H1
    handle ANY
    endhandle
    pos pt at pin 2
$)
    --REFACTOR, this is only true if we are connected to an STWALL, need to look at this in more detail
    --elsehandle NONE

    !!mdsDacControl(TRUE)
    --new cmpf
    --!nameOfCMPF = !!ce
    --new sbfi

    !localZDir = !!mdsHangerType25.virtualFitting.sbfi[1].zDirection
    !worldZDir = !!mdsHangerType25.virtualFitting.sbfi[1].zDirection.wrt( /* )
    --var !localZDir zdir
    --var !worldZDir zdir wrt /*
    if !localZDir.eq(!worldZDir) and ( !!ce.owner.owner.type.eq('GWALL') or !!ce.owner.owner.type.eq('PANE') ) then
      pin 1 at $!!mdsHangerType25.virtualFitting.owner
      !plDir = pl dir of $!ce
      pin 1 dir $!plDir
      pin 1 PLANE pin 1 thro ph of $!ce/H1
      pin 1 dir u
      pin 1 PLANE pin 1 thro $!ce
      pin 2 at pin 1
      $!ce
      pin 2 dir pl dir
      pin 2 PLANE pin 2 thro $!ce
      same
      pin 2 dir u
      pin 2 PLANE pin 2 thro pin 1
      pin 1 dir from pin 2 to pin 1
      handle ANY
      endhandle
      pin 1 PLANE pin 1 thro $!ce
      var !direction const dir p0 of $!ce to pin 1
      /*
      pin 1 dir $!direction
      same
      -- Access the ploo and find out which pline we need to push the tail to
      !!ce = !!mdsHangerType25.virtualFitting.owner
      ploo 1
      pin 1 PLANE pin 1 clear 0 inf ploo 1 of ce
      $!ce/H1
      pos pt at pin 1
      tdir from pt to ph
    else
      !hanger = $!ce/H1
      !cmpfPosition = !!mdsHangerType25.virtualFitting.getPosition()
      !dirE = object DIRECTION('E wrt /*')
      !dirN = object DIRECTION('N wrt /*')
      !dirU = object DIRECTION('U wrt /*')
      !cmpfPV = object POINTVECTOR(!cmpfPosition, !dirE)
      !cmpfPV.through(!hanger.hpos)
      !cmpfPV.direction = !dirN
      !cmpfPV.through(!hanger.hpos)
      !cmpfPV.direction = !dirU
      !cmpfPV.through(!hanger.hpos)
      !!mdsHangerType25.virtualFitting.setPosition(!cmpfPV.position)
      $!ce/H1
      pos pt at $!cmpfPV.position
      handle ANY
      endhandle
      pin 9 copy pt
      pin 8 copy pt
      pin 8 DIRECTION from pin 8 to ph
      pin 8 PLANE pin 8 thro href
      var !hangerDirection const DIRECTION pin 8 to pin 9
      move pt $!hangerDirection clear 0 inf ploo 1 of $!!mdsHangerType25.virtualFitting.owner
      handle ANY
      endhandle
      pin 8 off
      pin 9 off
    endif
    --endhandle
  else
  pos pt at $!ce/CMPF
  handle ANY
  endhandle
  tref $!ce/SBFI/H1
  handle ANY
    tref $!ce/FITT/H1
    handle ANY
    endhandle
  endhandle
  $!ce/CMPF
  handle ANY
    pin 1 at $!ce/FITT/H1
    pin 9 at $!ce/FITT/H1
    var !xDir ppline $!plineName x dir of owner of $!ce/FITT/H1 wrt world
    PIN 1 DIR $!xDir wrt world
    PIN 1 PLANE PIN 1 THRO ph of $!ce/H1
    var !attaDir dir pl of $!ce
    pin 2 copy pin 1
    pin 2 dir $!attaDir
    PIN 2 PLANE PIN 2 THRO ph of $!ce/H1
    handle ANY
    endhandle
    pos pt at pin 2
  elsehandle NONE
    !!mdsDacControl(TRUE)
    new cmpf
    !nameOfCMPF = !!ce
    new sbfi
    var !localZDir zdir
    var !worldZDir zdir wrt /*
    if !localZDir.eq(!worldZDir) and ( !!ce.owner.owner.type.eq('GWALL') or !!ce.owner.owner.type.eq('PANE') ) then
      pin 1 at owner of owner
      !plDir = pl dir of $!ce
      pin 1 dir $!plDir
      pin 1 PLANE pin 1 thro ph of $!ce/H1
      pin 1 dir u
      pin 1 PLANE pin 1 thro $!ce
      pin 2 at pin 1
      $!ce
      pin 2 dir pl dir
      pin 2 PLANE pin 2 thro $!ce
      same
      prec var 6 dp
      --var !pin1pos pin 1 position
      prec var 2 dp
      pin 2 dir u
      pin 2 PLANE pin 2 thro pin 1
      pin 1 dir from pin 2 to pin 1
      handle ANY
      endhandle
      pin 1 PLANE pin 1 thro $!ce
      var !direction const dir p0 of $!ce to pin 1
      /*
      pin 1 dir $!direction
      same
      !!ce = !nameOfCMPF
      delete cmpf
      -- Access the ploo and find out which pline we need to push the tail to
      ploo 1
      pin 1 PLANE pin 1 clear 0 inf ploo 1 of ce
      $!ce/H1
      pos pt at pin 1
      tdir from pt to ph
    else
      cmpf
      delete cmpf
      $!ce/CMPF
      move e thro ph of $!ce/H1
      move n thro ph of $!ce/H1
      move u thro ph of $!ce/H1
      $!ce/H1
      pos pt at $!ce/CMPF
      handle ANY
      endhandle
      pin 9 copy pt
      pin 8 copy pt
      pin 8 DIRECTION from pin 8 to ph
      pin 8 PLANE pin 8 thro href
      var !hangerDirection const DIRECTION pin 8 to pin 9
      move pt $!hangerDirection clear 0 inf ploo 1 of owner of $!ce/CMPF
      handle ANY
      endhandle
      pin 8 off
      pin 9 off
    endif
  endhandle
  endif

  -- Now we have determined the position of head/tail
  -- Set the tail direction, only if there are non members i.e create mode
  if !!ce.mcount.eq(0) then
    var !tailDirection const DIRECTION pt to ph
    tdir $!tailDirection
  endif
  if !!mdsHangerType25.hangertypes.stwallconn.eq(TRUE) then
    var !xDist const dist pin 1 to pin 9
    var !xDir ppline NA x dir of owner of tref wrt owner of tref
    var !tailDirection ppline NA x dir of owner of tref
    var !dDist const dist ppline na start of owner of tref to ppline $!plineName start of owner of tref
    var !thick cpara num 1 of owner of tref
    var !zDir ppline $!plineName z dir of owner of tref
    if ( !dDist.real().int() le !thick.real().int()) then
      if ( $!tailDirection neq $!zDir )  then
        !xDir = !xDir.direction().opposite().string().before('WRT')
      endif
    else
      var !oLen desp num 1 of owner of tref
      !newDist = ( !oLen.real() - !dDist.real())
      !dDist =  !newDist.string()
      if ( $!tailDirection eq $!zDir )  then
        !xDir = !xDir.direction().opposite().string().before('WRT')
      endif
    endif
    goto tref
    delpos $!xDir $!xDist
  endif
  !!ce = !ce.dbref()

  !callingForm.name.val = 'unset'
  !!mdsHangerType25.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType25.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  !!mdsHangerType25.support.tdir = tdir of $!attaName/H1 wrt /*

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType25.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType25.support.tposition = tposition of $!attaName/H1 wrt /*

  --REFACTOR this was extracted from the modify mode label - start
  -- need to be extracted to a separate function file
  !support  = !!mdsHangerType25.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType25.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType25.hangerSelType.val
    !!ce = !exist
  endif
  !!mdsVendorHangerType25.steelMem = !support.rest.beamRefArray
  !!mdsHangerType25.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType25.name.val = !attaName.after('/')
  !!mdsHangerType25.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType25 form gadgets
  !!ce = !attaRef
  !!mdsHangerType25.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType25)

  !!mdsHangerType25.bthro.active = TRUE
  !!mdsHangerType25.select.active = TRUE
  !!mdsHangerType25.bdist.active = TRUE
  !!mdsHangerType25.dist.active = TRUE

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        --DTF feb 05
        !!mdsHangerType25.reconnect.active = FALSE
        -- open distance for all types item 189
        !!mdsHangerType25.bthro.active = TRUE
        !!mdsHangerType25.select.active = TRUE
        !!mdsHangerType25.bdist.active = TRUE
        !!mdsHangerType25.dist.active = TRUE

      endif
    endif
  endif

  ------------------------------------------------------------------------
  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType25)
  !hangerStart = !!mdsHangerType25.support.datum.position
  !hangerEnd   = !!mdsHangerType25.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType25.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType25.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType25.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType25)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
-- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
if (!!mdsHangIf.eq('LISEGA')) then
pml load FORM !!mdsundolicad
!!mdsundolicad.support = !!mdsHangerType25.support
!!mdsSaveHangerState(!!mdsundolicad)
endif
-- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END

  if !!mdsHangIf.eq('LISEGA') then
    if !attaName.dbref().ldir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().ldir.wrt(/* ).string().eq('Z WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('Z WRT /*') then
      $!attaName/CMPF
      handle NONE
        if !!ce.owner.type.eq('GWALL') then
          !!zz.delete()
          handle ANY
          endhandle
          !!gwallHanger = $!attaName/H1
          !!zz = object MDSGETWALL(!!mdsHangerType25)
        elseif !!ce.owner.hardtype.eq('PANE') then
          !!mdsInterfaceSetOffsetDir(!attaName.dbref(), !!mdsHangerType25)
        endif
      elsehandle ANY
      endhandle
    else
      $!attaName/CMPF
      handle NONE
        if !!ce.owner.type.eq('GWALL') then
          ploo 1
          handle NONE
            !!zz.delete()
            handle ANY
            endhandle
            !!gwallHanger = $!attaName/H1
            !!zz = object MDSGETWALL(!!mdsHangerType25)
          elsehandle ANY
          endhandle
        elseif !!ce.owner.hardtype.eq('PANE') then
          !!mdsInterfaceSetOffsetDir(!attaName.dbref(), !!mdsHangerType25)
        endif
      elsehandle ANY
      endhandle
    endif
  endif

  return !support

endfunction
