-- File:    MdsiHangerType32CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType32CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  ----------------------
  -- Create a NEW HANGER
  ----------------------
  !!mdsHangerType32.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotateCur = FALSE
  !support.handedCur = FALSE
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !styp
  !support.modify = FALSE

  -- <sk> 04/06/2012
  !fromAtta = false
  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE
    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'
  elsehandle ANY
  endhandle
  --<sk> 06/06/2012
  -------------------------------
  --- mds Manufacturers interface
  -------------------------------
  --<wd>
  -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
  -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
  -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
  if  (!!mdsHangIf.eq('LISEGA')) then
    !support.alias = 'MH01'
    !x = !!mdsInterfaceHanger.tubeRef
    $!x
    !plDir = pl dir wrt /*
    handle ANY
      !plDir = ph dir wrt /*
    endhandle
    if (!plDir.up eq 1 or !plDir.up eq -1 ) then
      !support.alias = 'MH01'
      !!mdsVendorHangerType32.type = 'V'
      !selType = !configNumber.string() + 'V'
      !!mdsVendorHangerType32.hangerSelType.val = !selType
    else
      !!mdsVendorHangerType32.type = 'H'
      !selType = !configNumber.string() + 'H'
      !!mdsVendorHangerType32.hangerSelType.val = !selType
    endif
  elseif  (!!mdsHangIf.eq('PSL')) then
    !support.alias = 'MH01'
    !x = !!mdsInterfaceHanger.tubeRef
    $!x
    !plDir = pl dir wrt /*
    handle ANY
      !plDir = ph dir wrt /*
    endhandle
    if (!plDir.up eq 1) then
      !support.alias = 'MH01'
      !!mdsVendorHangerType32.type = 'V'
    else
      !!mdsVendorHangerType32.type = 'H'
    endif
    !selType = !configNumber.string() + !!mdsVendorHangerType32.type
    !!mdsVendorHangerType32.hangerSelType.val = !selType
  elseif  (!!mdsHangIf.eq('CPL')) then
    !support.alias = 'MH01'
    !x = !!mdsInterfaceHanger.tubeRef
    $!x
    !plDir = pl dir wrt /*
    handle ANY
      !plDir = ph dir wrt /*
    endhandle

    --><wd>04aug2009 - DFN P-22111 (SI-13209)
    -- Added the check here for BOTH of the VERTICAL PIPE Directions, i.e.cHECK for -1(DOWN) or +1(UP) values by using the object REAL.abs() (ABSOLUTE) method
    --            if (!plDir.up EQ 1) then
    if (!plDir.up.abs() eq 1) then
      --<<wd>04aug2009 - DFN P-22111 (SI-13209)
      !support.alias = 'MH01'
      !!mdsVendorHangerType32.type = 'V'
    else
      !!mdsVendorHangerType32.type = 'H'
    endif
    !selType = !configNumber.string() + !!mdsVendorHangerType32.type
    !!mdsVendorHangerType32.hangerSelType.val = !selType
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType32.bthro.active  = TRUE
        !!mdsHangerType32.select.active = TRUE
        !!mdsHangerType32.bdist.active  = TRUE
        !!mdsHangerType32.dist.active   = TRUE
      endif
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType32.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType32.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType32.name.val = !callingForm.name.val
  !!mdsHangerType32.dist.val = 0
  !!mdsHangerType32.p.val = ''
  --!!mdsHangerType32.datum.active = TRUE

  if !!mdsHangerType32.support.preliminaryStore.set() then
    !!mdsHangerType32.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType32 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType32.support.rest = !oRest
  !oRest.create(!!mdsHangerType32,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType32.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType32.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType32.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType32 form
  !!kShowForm(!!mdsHangerType32)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning
  --!!mdsHangerType32.setGadgets()

  if (!!manIf.exe.exists()) then
    if (!!mdsVendorHangerType32.type eq 'H') then
      -----------------------------------------
      -- HORIZONTAL PIPES
      -----------------------------------------
      !!ce = !attaName.dbref()
      !ce = !!ce.name
      $!ce/REST
      $!ce/H1
      conn hh to $!ce
      $!ce
      prev
      handle ANY
      elsehandle NONE
        !paDir = pa dir wrt /*
        handle ANY
        elsehandle NONE
          !plDir = pl dir wrt /*
          if ((!paDir.up eq 1 or !paDir.up eq -1) and !paDir.opposite().eq(!plDir)) then
            $!ce
            flip
            conn
            $!ce/H1
            conn hh to $!ce
            $!ce
          endif
        endhandle
      endhandle
      $!ce
      pin 9 copy pl
      pin 8 copy pin 9
      pin 8 dir d wrt /*
      $!!mdsInterfaceHanger.beamRef[2]
      pin1 at ppline na start
      Pin1 dir d
      pin1 throu pin8
      !zDirOfSctn = zdir wrt world
      pin 9 at ce
      pin 9 dir $!zDirOfSctn
      pin 9 PLANE pin 9 thro $!ce
      pin 9 dir from pin 8 to pin 9
      -- pin1 direction parallel to beam axis
      var !pin1dir pplin NA y dir wrt world
      pin1 dir $!pin1dir wrt world
      -- calculate the offset the fitting along the beam axis from its start

      --var !zdist const dist pin8 to plan pin1
      var !pin9dir pin 9 dir
      !pin9dirOpp = !pin9dir.direction().opposite()

      var !hdir pin 9 dir wrt /*
      !hpos = hpos of $!ce/H1 wrt /*
      !furthestPline = !!kFarPline(!!ce,!hpos,!hdir.direction())
      -- We only need the pline that can be connected to, these are
      -- TOS, BOS, TOC, BOC, LEFT, RIGH
      do !getPlineNumber from 1 to !furthestPline.size() by 2
        if !furthestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
          !plineNumber = !getPlineNumber
          break
        endif
      enddo
      !plineName = pkey of $!furthestPline[$!plineNumber]
      -- REFACTOR removed previous code and use the furthest pline from the atta instead for type 2 hangers - end

      pin 1 off
      pin 2 off

      --DUN1218 if we have a virtual fitting object member set on the mdsHangerType32 form then readOnly = true
      if !!mdsHangerType32.virtualFitting.set() then
        !readonly = TRUE
      else
        !readonly = FALSE
      endif

      if !readonly then
        !!mdsHangerType32.virtualFitting.spref = /MDS/LUG-HANG
        --!!mdsHangerType32.virtualFitting.setzdist(!zdist.real())
        !currentDelpos = !!mdsHangerType32.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType32.virtualFitting.delPosition = !currentDelpos
        !!mdsHangerType32.virtualFitting.posline = !plineName
        !!mdsHangerType32.virtualFitting.setdelpos(!!mdsHangerType32.virtualFitting.getPosition())
      else

        -- Create the fitting for the 1 hanger if not already created
        !!mdsDacControl(TRUE)
        new fitt $!ce/FITT/H1
        handle NONE
        elsehandle ANY
          delete fitt
        endhandle
        $!ce/FITT/H1
        Spref /MDS/LUG-HANG
        --zdist $!zdist
        delp n0
        posl $!plineName
      endif
      --!!mdsDacControl(FALSE)
      --<wd>11aug2009 -- DFN P-22111 (SI-13209)
      -- This *** NOTE *** is for Information Purposes ONLY *** PML CODE changes for VERTICAL PIPES below.
      -- This "else" block of PML CODE has been copied and added (and modified where required) to the VERTICAL PIPES condition shown below at approximately line no.1110
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Added the CODE below to Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
      !!ce = !attaName.dbref()

      !!ce.:MDSHConfig = !configNumber & !!mdsVendorHangerType32.type
      !!mdsVendorHangerType32.hangerSelType.val = !!ce.:MDSHConfig
      !ce = !!ce.name
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
      AT PL of PREVIOUS
      handle ANY
        AT PH
      endhandle
      !!mdsHangerType32.dist.val = 0

      if !readonly.not() then
        $!ce/FITT/H1
      endif

      -- DTF >>> double channel crossing we need the DELPOS to be set to allow the FITTING to be placed between channels
      !channel1dir = !!mdsInterfaceHanger.beamRef[1].plori.na.ydir().wrt( /* )
      !channel2dir = !!mdsInterfaceHanger.beamRef[2].plori.na.ydir().wrt( /* )

      if !channel1dir.eq(!channel2dir) then
        pin 3 at ppline NA start of $!!mdsInterfaceHanger.beamRef[1]
        pin 4 at ppline NA start of $!!mdsInterfaceHanger.beamRef[2]
      else
        pin 3 at ppline NA start of $!!mdsInterfaceHanger.beamRef[1]
        pin 4 at ppline NA end of $!!mdsInterfaceHanger.beamRef[2]
      endif
      var !xOffset constr dist pin 3 to pin 4
      !move = (!xOffset.real() * 0.5)
      var !tocDir ppline TOC z dir of $!!mdsInterfaceHanger.beamRef[2]

      --dun1218 deal with read only fittings - start
      if !readonly then
        --var !zDir ppline NA x dir of $!!mdsInterfaceHanger.beamRef[2] wrt ce
        var !zDir ppline NA x dir of $!!mdsInterfaceHanger.beamRef[2] wrt $!!mdsHangerType32.virtualFitting.owningstru
        !currentDelpos = !!mdsHangerType32.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !currentDelpos.east = 0
        !currentDelpos.up = 0
        !!mdsHangerType32.virtualFitting.delPosition = !currentDelpos
        !pos = !!mdsHangerType32.virtualFitting.getPosition()
        !pv = object POINTVECTOR(!pos, !zDir.direction())
        !pv = !pv.offset(!move)
        !!mdsHangerType32.virtualFitting.setdelpos(!pv.position)
      else
        var !zDir ppline NA x dir of $!!mdsInterfaceHanger.beamRef[2] wrt ce
        delp E 0 N 0 U 0
        delp $!zDir  $!move
      endif
      --dun1218 deal with read only fittings - end

      $!ce/H1
      --<RM> 16/11/07 -- connect the hanger tail to the fitting or the hanger head will be
      -- projected to wherever the hang element was created.
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType32.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
        conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      --<RM> 16/11/07 -- end of fix
      pin 3 at ht
      var !xHTDir construct DIRECTION ht to hh
      pin 3 dir $!xHTDir
      handle ANY
      elsehandle NONE
        pin 3 PLANE pin 3 thr hh
        $!ce
        thro pin 3
      endhandle
      $!ce/H1
      conn hh to $!ce
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType32.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
        conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      pin 9 dir from pt to ph
      var !pin9dir pin 9 dir
      tdir $!pin9dir

      if (!!mdsHangerType32.dist.active eq FALSE) then
        $!ce
        -- Get general direction of pleave of datum atta
        -- Plane direction is nearest value to 1
        !plDir = pl dir of $!attaName
        --<RM> 26/06/07 -- removed the following !planeDir needs to be the pleave of the atta
        -- which has gone through !!mdsRemoveGrad
        !directions = !!mdsRemoveGrad(!attaName.dbref())
        !planeDir = !directions[1]

        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
        if !readonly then
          !tailPosition = !!mdsHangerType32.virtualFitting.getPosition()
          PLANE $!planeDir through $!tailPosition
        else
          PLANE $!planeDir through $!ce/FITT/H1
        endif
        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end

        !isWithinTube = !!mdsIsWithinTube(!ce.dbref())
        if (not !isWithinTube ) then
          Spkbrk FALSE
        endif
        $!ce/H1
        conn hh to $!ce
        $!ce
        -- If the type is a 7 then do not automatically show the i/f because they may want to set a offset
        !!mdsHangerType32.hide()
        !!mdsVendorHangerType32.jointrotate = TRUE
        --REFACTOR -- added so that we know if mds is going to start the interface without user action
        if defined(!!mdsautotestrunning) then
          !!mdsAutoTestNoOkMethodRequired = TRUE
        endif
        !!mdsVendorHangerType32.init()
      else
        !!mdsVendorHangerType32.jointrotate = FALSE
      endif
    elseif (!!mdsVendorHangerType32.type eq 'V') then
      -----------------------------------------
      -- VERTICAL PIPES
      -----------------------------------------
      if (!!mdsHangIf.upcase().eq('CPL')) then
        -- Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
        !!ce = !attaName.dbref()

        !!ce.:MDSHConfig = !configNumber & !!mdsVendorHangerType32.type
        !!mdsVendorHangerType32.hangerSelType.val = !!ce.:MDSHConfig
        !ce = !!ce.name
        -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
        AT PL of PREVIOUS
        handle ANY
          AT PH
        endhandle
        !!mdsHangerType32.dist.val = 0
        $!ce/FITT/H1

        -- Hanger Types '2' or '32' are CONNECTED above a DOUBLE CHANNEL Arrangement at the PLINE TOC. The DELPOS is to be set to allow the FITTING to be placed between CHANNELS on the PPLINE 'NA'
        pin 3 at ppline NA start of $!!mdsInterfaceHanger.beamRef[1]
        pin 4 at ppline NA start of $!!mdsInterfaceHanger.beamRef[2]
        --><wd>13aug2009 - DFN P-22111 (SI-13209)
        -- The ppline NA START of each Channel SCTN beam reference could be at OPPOSITE ends of the Double Channel SCTN Arrangement
        -- To calculate the !xOffset distance accurately MOVE both pin 3 and pin 4 through the PLANE HANGER ATTA on the PIPE
        -- and then Calculate the DELPOS OFFSET of the FITTING element
        !section1dir = !!mdsInterfaceHanger.beamRef[1].zDir.wrt(/* )
        pin 3 direction $!section1dir
        !section2dir = !!mdsInterfaceHanger.beamRef[2].zDir.wrt(/* )
        pin 4 direction $!section2dir
        -- Plane both Pin 3 and Pin 4 through the ATTA position, so they are in the same plane
        !hangerAtta = !attaName.dbref()
        pin 3 plane pin 3 through $!hangerAtta
        pin 4 plane pin 4 through pin 3
        pin 3 direct pin 3 to pin 4
        --                    var !xOffset constr dist pin 3 to pin 4
        !xOffset = !!kStrReal('constr dist pin 3 to pin 4')
        POSL TOC
        --<<wd>13aug2009 - DFN P-22111 (SI-13209)
        !move = (!xOffset.real() * 0.5)
        var !tocDir ppline TOC z dir of $!!mdsInterfaceHanger.beamRef[1]
        if !tocDir eq 'U' or !tocDir eq 'Z'  then
          var !zDir ppline NA x dir of  $!!mdsInterfaceHanger.beamRef[2] wrt ce
        else
          var !zDir ppline NA -x dir of  $!!mdsInterfaceHanger.beamRef[1] wrt ce
        endif
        delp E 0 N 0 U 0
        delp $!zDir $!move
        $!ce/H1
        conn hh to $!ce
        conn ht to $!ce/FITT/H1
        pin 9 dir from pt to ph
        var !pin9dir pin 9 dir
        tdir $!pin9dir

      endif
      --<<wd>11aug2009 - DFN P-22111 (SI-13209) - CURRENTLY this PML CODE is ONLY for the MDS-Witch Hanger(CPL) manufacturers interface
    endif
  endif

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle
  !ce = name
  !!mdsDacControl(TRUE)
  !!ce = !ce.dbref()

  !callingForm.name.val = 'unset'
  --!!mdsHangerType32.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType32.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  -- Put the tail direction in the support object
  !!mdsHangerType32.support.tdir = tdir of $!attaName/H1 wrt /*

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType32.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType32.support.tposition = tposition of $!attaName/H1 wrt /*

  --REFACTOR this was extracted from the modify mode label - start
  -- need to be extracted to a separate function file
  !support  = !!mdsHangerType32.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType32.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType32.hangerSelType.val
    !!ce = !exist
  endif
  if (!!mdsHangIf.eq('CPL')) then
    -- MDS-CPL Witch Hanger Support Types '32H' and '32V' will always have the !!mdsHangerType32.support.tdir set to "D wrt /*"
    !!mdsHangerType32.support.tdir = D wrt /*
    -- In CREATE HANGER Mode - Reset the Hanger !support.rest <MDSINTERFACEREST> BEAM REFERENCE ARRAY
    --dun1218 removed the .unique() command otherwise we cannot attach to 1 set of twin channels on a vertical pipe - start
$(
    !support.rest.beamRefArray = !!mdsInterfaceHanger.beamRef.unique()
    handle ANY
      -- In MODIFY MODE - ONLY UNIQUE the ARRAY - and DO NOTHING else as the !support.rest <MDSINTERFACEREST> BEAM REFERENCE ARRAY values should be OK
      !support.rest.beamRefArray.unique()
    endhandle
$)
    --dun1218 removed the .unique() command otherwise we cannot attach to 1 set of twin channels on a vertical pipe - end
  endif
  !!mdsVendorHangerType32.steelMem = !support.rest.beamRefArray
  !!mdsHangerType32.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType32.name.val = !attaName.after('/')
  !!mdsHangerType32.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType32 form gadgets
  !!ce = !attaRef
  --!!mdsHangerType32.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType32)

  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType32)
  !hangerStart = !!mdsHangerType32.support.datum.position
  !hangerEnd   = !!mdsHangerType32.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType32.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType32.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType32.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType32)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
  -- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
  if (!!mdsHangIf.eq('LISEGA')) then
    pml load FORM !!mdsundolicad
    !!mdsundolicad.support = !!mdsHangerType32.support
    !!mdsSaveHangerState(!!mdsundolicad)
  endif
  -- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END
  return !support

endfunction
