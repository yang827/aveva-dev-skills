-- File:    MdsiHangerType6CreateMode.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    A.bOUDJNAH
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form FH01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
----------------------
-- Create a NEW HANGER
----------------------
define function !!mdsiHangerType6CreateMode(!attaName is STRING, !textName is STRING, !styp is STRING, !configNumber is REAL, !callingForm is FORM) is MDSINTERFACESUPPORT

  !!mdsHangerType6.graphicaldim = FALSE

  -- Create Support object
  !support  = object MDSINTERFACESUPPORT()
  !support .position  = FALSE
  !support .mirror    = FALSE
  !support .rotateCur = FALSE
  !support .handedCur = FALSE
  !support .rotated   = 0
  !support .bPNum     = 1
  !support .alias     = !styp
  !support .modify = FALSE

  -- <sk> 04/06/2012
  !fromAtta = false
  --<sk> 06/06/2012
  -- check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!attaName)
  handle NONE
    !fromAtta = true
    !support.preliminaryStore = !!mdsSavePreInf(!datum)
    !datum.name = !attaName & '_Pre'
  elsehandle ANY
  endhandle
  --<sk> 06/06/2012
  -------------------------------
  --- mds Manufacturers interface
  -------------------------------

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ?????
      if  (!!mdsHangIf.eq('LISEGA')) then
        !!mdsVendorHangerType6.type = ''
        !!mdsVendorHangerType6.hangerSelType.val = ''
      elseif  (!!mdsHangIf.eq('PSL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle
        if (!plDir.up eq 1) then
          !support.alias = 'MH01'
          !!mdsVendorHangerType6.type = 'V'
        else
          !!mdsVendorHangerType6.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType6.type
        !!mdsVendorHangerType6.hangerSelType.val = !selType
      elseif  (!!mdsHangIf.eq('CPL')) then
        !support.alias = 'MH01'
        !x = !!mdsInterfaceHanger.tubeRef
        $!x
        !plDir = pl dir wrt /*
        handle ANY
          !plDir = ph dir wrt /*
        endhandle

        --><wd>04aug2009 - DFN P-22111 (SI-13209)
        -- Added the check here for BOTH of the VERTICAL PIPE Directions, i.e.cHECK for -1(DOWN) or +1(UP) values by using the object REAL.abs() (ABSOLUTE) method
        --            if (!plDir.up EQ 1) then
        if (!plDir.up.abs() eq 1) then
          --<<wd>04aug2009 - DFN P-22111 (SI-13209)
          !support.alias = 'MH01'
          !!mdsVendorHangerType6.type = 'V'
        else
          !!mdsVendorHangerType6.type = 'H'
        endif
        !selType = !configNumber.string() + !!mdsVendorHangerType6.type
        !!mdsVendorHangerType6.hangerSelType.val = !selType
      endif
    endif
  endif

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      --<wd>
      -- Initialising !!mdsInterfaceHanger  Automatically SWITCH INTERFACE to ON
      -- What if USER has JUST SWITCHED it OFF and CREATED a mds standard HANGER & NOW wants to MODIFY it ????
      -- HE can't because the BUTTONS are DEACTIVATED and the INTERFACE has been switched ON AUTOMATICALLY ????
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        !!mdsHangerType6.bthro.active  = TRUE
        !!mdsHangerType6.select.active = TRUE
        !!mdsHangerType6.bdist.active  = TRUE
      endif
      !!mdsHangerType6.dist.active = TRUE
    endif
  endif

  ------------------------------------------
  --- End of the mds Manufacturers interface
  ------------------------------------------

  -- Initialise variables for new supports
  !support .replace = !callingForm.replacement
  --<RM>REFACTOR removed !support.type    = !callingForm.standard.selection('Rtext')
  !support.type = ''
  --<RM> refactor
  !!mdsHangerType6.support = !support

  -- Set callback on cancel button and set mode member of support object
  !!mdsHangerType6.cancel.callback = |!this.cancelHanger(TRUE)|

  -- Set Paragraph gadget on form
  !!mdsHangerType6.name.val = !callingForm.name.val
  !!mdsHangerType6.dist.val = 0
  !!mdsHangerType6.p.val = ''
  !!mdsHangerType6.datum.active = TRUE

  if !!mdsHangerType6.support.preliminaryStore.set() then
    !!mdsHangerType6.support.datum = !datum
  endif

  -- if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
  -- tube and beam have been selected when filter was activated
  -- Call the same callback function as in !!mdsHangerType6 but the calling form is different
  !oRest = object MDSINTERFACEREST(!styp)
  !oRest.mode = 'CREATE'

  !!mdsHangerType6.support.rest = !oRest
  !oRest.create(!!mdsHangerType6,!callingForm)
  handle 99
    -- user has exited by pressing the ESC key
    -- delete the hanger and all associated elements including atta
    -- Do not issue a confirm prompt
    !!mdsHangerType6.cancelHanger(FALSE)
    return error 99
  elsehandle ANY
  endhandle
  !attaName = !oRest.attaRef.name
  handle (2,754)
    !!mdsHangerType6.cancelHanger(FALSE)
    return error 1
  endhandle
  !support .datum = !oRest.attaRef
  !support .atta.append(!oRest.attaRef)
  !support .rest = !oRest
  !!mdsHangerType6.support = !support

  !callingForm.hide()
  -- Deactivate the create button from the !!mdsHangerType6 form
  !!kShowForm(!!mdsHangerType6)

  -- Tests to see if the hanger pos is fixed or non fixed
  -- Fixed displays the interface form
  -- Non fixed allows positioning

  !!mdsHangerType6.setGadgets()

  if (!!manIf.exe.exists()) then
    if (!!mdsVendorHangerType6.type eq 'H') then
      -----------------------------------------
      -- HORIZONTAL PIPES
      -----------------------------------------
      !!ce = !attaName.dbref()
      !ce = !!ce.name
      $!ce/REST
      $!ce/H1
      conn hh to $!ce
      $!ce
      prev
      handle ANY
      elsehandle NONE
        !paDir = pa dir wrt /*
        handle ANY
        elsehandle NONE
          !plDir = pl dir wrt /*
          if ((!paDir.up eq 1 or !paDir.up eq -1) and !paDir.opposite().eq(!plDir)) then
            $!ce
            flip
            conn
            $!ce/H1
            conn hh to $!ce
            $!ce
          endif
        endhandle
      endhandle
      $!ce
      pin 9 copy pl
      pin 8 copy pin 9
      pin 8 dir d wrt /*
      $!!mdsInterfaceHanger.beamRef[1]
      pin1 at ppline na start
      Pin1 dir d
      pin1 throu pin8
      !zDirOfSctn = zdir wrt world
      pin 9 at ce
      pin 9 dir $!zDirOfSctn
      pin 9 PLANE pin 9 thro $!ce
      pin 9 dir from pin 8 to pin 9
      -- pin1 direction parallel to beam axis
      var !pin1dir pplin NA y dir wrt world
      pin1 dir $!pin1dir wrt world
      -- calculate the offset the fitting along the beam axis from its start

      var !zdist const dist pin8 to plan pin1
      var !pin9dir pin 9 dir
      !pin9dirOpp = !pin9dir.direction().opposite()

      var !hdir pin 9 dir wrt /*
      --<wd>sep2005
      !hpos = hpos of $!ce/H1 wrt /*
      !closestPline = !!kClosestPline(!!ce,!hpos,!hdir.direction())

      -- We only need the pline that can be connected to, these are
      -- TOS, BOS, TOC, BOC, LEFT, RIGH
      do !getPlineNumber from 1 to !closestPline.size() by 2
        if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
          !plineNumber = !getPlineNumber
          break
        endif
      enddo
      !plineName = pkey of $!closestPline[$!plineNumber]
      pin 1 off
      pin 2 off

      --DUN1218 if we have a virtual fitting object member set on the mdsHangerType6 form then readOnly = true
      if !!mdsHangerType6.virtualFitting.set() then
        !readonly = TRUE
      else
        !readonly = FALSE
      endif

      if !readonly then
        !!mdsHangerType6.virtualFitting.spref = /MDS/LUG-HANG
        !!mdsHangerType6.virtualFitting.setzdist(!zdist.real())
        !currentDelpos = !!mdsHangerType6.virtualFitting.getdelpos()
        !currentDelpos.north = 0
        !!mdsHangerType6.virtualFitting.delPosition = !currentDelpos
        !!mdsHangerType6.virtualFitting.posline = !plineName
        !!mdsHangerType6.virtualFitting.setdelpos(!!mdsHangerType6.virtualFitting.getPosition())
      else
	      -- Create the fitting for the 6 hanger if not already created
	      !!mdsDacControl(TRUE)
	      new fitt $!ce/FITT/H1
	      handle NONE
	      elsehandle ANY
	        delete fitt
	      endhandle
	      $!ce/FITT/H1
	      Spref /MDS/LUG-HANG
	      zdist $!zdist
	      delp n0
	      posl $!plineName
      endif
      --!!mdsDacControl(FALSE)
      --<wd>11aug2009 -- DFN P-22111 (SI-13209)
      -- This *** NOTE *** is for Information Purposes ONLY *** PML CODE changes for VERTICAL PIPES below.
      -- This "else" block of PML CODE has been copied and added (and modified where required) to the VERTICAL PIPES condition shown below at approximately line no.1110
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Added the CODE below to Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
      !!ce = !attaName.dbref()

      -- The MDSFHAnger FORM Configuration Number is inset '6' or '600', i.e. Selected HANGER is a PEDESTAL SPRING type support
      !!ce.:MDSHConfig = !configNumber.string()

      !!mdsVendorHangerType6.hangerSelType.val = !!ce.:MDSHConfig
      !ce = !!ce.name
      --<wd>21aug2009 -- DFN P-22111 (SI-13209)
      -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
      AT PL of PREVIOUS
      handle ANY
        AT PH
      endhandle
      !!mdsHangerType6.dist.val = 0
      $!ce/H1
      --<RM> 16/11/07 -- connect the hanger tail to the fitting or the hanger head will be
      -- projected to wherever the hang element was created.
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType6.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
      	conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      --<RM> 16/11/07 -- end of fix
      pin 3 at ht
      var !xHTDir construct DIRECTION ht to hh
      pin 3 dir $!xHTDir
      handle ANY
      elsehandle NONE
        pin 3 PLANE pin 3 thr hh
        $!ce
        thro pin 3
      endhandle
      $!ce/H1
      conn hh to $!ce
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
      if !readonly then
        !tailPosition = !!mdsHangerType6.virtualFitting.getPosition()
        pos ht at $!tailPosition
      else
      	conn ht to $!ce/FITT/H1
      endif
      --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end
      pin 9 dir from pt to ph
      var !pin9dir pin 9 dir
      tdir $!pin9dir

      if (!!mdsHangerType6.dist.active eq FALSE) then
        $!ce
        -- Get general direction of pleave of datum atta
        -- Plane direction is nearest value to 1
        !plDir = pl dir of $!attaName
        --<RM> 26/06/07 -- removed the following !planeDir needs to be the pleave of the atta
        -- which has gone through !!mdsRemoveGrad
        !directions = !!mdsRemoveGrad(!attaName.dbref())
        !planeDir = !directions[1]

        --dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - start
        if !readonly then
          !tailPosition = !!mdsHangerType6.virtualFitting.getPosition()
          PLANE $!planeDir through $!tailPosition
        else
	        PLANE $!planeDir through $!ce/FITT/H1
	        handle ANY
	          PLANE $!planeDir through $!ce/CMPF
	        endhandle
				endif
				--dun1218 if we are readonly on the supporting steelwork then just position the hanger tail - end

        !isWithinTube = !!mdsIsWithinTube(!ce.dbref())
        if (not !isWithinTube ) then
          Spkbrk FALSE
        endif
        $!ce/H1
        conn hh to $!ce
        $!ce
        -- If the type is a 7 then do not automatically show the i/f because they may want to set a offset
        !!mdsHangerType6.hide()
        !!mdsVendorHangerType6.jointrotate = TRUE
        --REFACTOR -- added so that we know if mds is going to start the interface without user action
        if defined(!!mdsautotestrunning) then
          !!mdsAutoTestNoOkMethodRequired = TRUE
        endif
        !!mdsVendorHangerType6.init()
      else
        !!mdsVendorHangerType6.jointrotate = FALSE
      endif
    elseif (!!mdsVendorHangerType6.type eq 'V') then
      -----------------------------------------
      -- VERTICAL PIPES
      -----------------------------------------
      if (!!mdsHangIf.upcase().eq('CPL')) then
        -- Navigate to the HANGER DATUM ATTA and set the UDA :MDSHConfig with the HANGER TYPE SELECTED
        !!ce = !attaName.dbref()

        -- The MDSFHAnger FORM Configuration Number is inset '6' or '600', i.e. Selected HANGER is a PEDESTAL SPRING type support
        !!ce.:MDSHConfig = !configNumber.string()

        !!mdsVendorHangerType6.hangerSelType.val = !!ce.:MDSHConfig
        !ce = !!ce.name
        -- Position new ATTA at the PLEAVE of the PREVIOUS COMPONENT or the PHEAD of the BRANCH on a VERTICAL PIPE
        AT PL of PREVIOUS
        handle ANY
          AT PH
        endhandle
        !!mdsHangerType6.dist.val = 0
        $!ce/H1
        conn hh to $!ce

        --P-37906 need to make sure that the hanger tail is connected to the correct pline of the supporting steelwork pipe for vertical trunnions connecting to a type 6 spring pedestal support
        --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
        --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
        --i have tried to minimise the impact of this by doing the following
        --1) restricting to !!mdsHangIf = CPL only
        --2) ensuring that the atta pipe is a trunnion
        --3) ensuring that the atta pipe is vertical
        --4) ensuring that the config type is 6
        !trunnion = !attaName.dbref().owner.:MDSTrun
        handle ANY
          !trunnion = FALSE
        endhandle

        if !trunnion and !attaName.dbref().ldir.up.gt(0.95) or !attaName.dbref().ldir.up.lt(-0.95) then
          !current = !!ce
          $!ce/FITT/H1
          !trunAttaDir = !attaName.dbref().pdir[!attaName.dbref().leave]
          !closestPline = !!kClosestPline(!!ce.owner, !attaName.dbref().position,!trunAttaDir)
          -- We only need the pline that can be connected to, these are
          -- TOS, BOS, TOC, BOC, LEFT, RIGH
          do !getPlineNumber from 1 to !closestPline.size() by 2
            if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
              !plineNumber = !getPlineNumber
              break
            endif
          enddo
          !plineName = pkey of $!closestPline[$!plineNumber]
          $!ce/FITT/H1
          posl $!plineName
          !!ce = !current
        else
          --do nothing
        endif
        --P-37906 need to make sure that the hanger tail is connected to the correct pline of the supporting steelwork pipe for vertical trunnions connecting to a type 6 spring pedestal support
        --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
        --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end


        conn ht to $!ce/FITT/H1
        pin 9 dir from pt to ph
        var !pin9dir pin 9 dir
        tdir $!pin9dir

      endif
      --<<wd>11aug2009 - DFN P-22111 (SI-13209) - CURRENTLY this PML CODE is ONLY for the MDS-Witch Hanger(CPL) manufacturers interface
    endif
  endif

  -- Position the elevation at the CMPF, then adjust for the panel thickness
  !!ce = !attaName.dbref()
  handle ANY
    -- Must be because user cancelled from interface on initial create & therefore ATTA deleted
    return error 1
  endhandle

  !callingForm.name.val = 'unset'
  !!mdsHangerType6.datum.active = FALSE
  !reconnected = FALSE
  !attaName = '/' + !!mdsHangerType6.name.val
  !attaRef = !attaName.dbref()
  handle ANY
    return error 1
  endhandle

  -- Put the tail direction in the support object
  !!mdsHangerType6.support.tdir = tdir of $!attaName/H1 wrt /*

  -- >>> DTF mod to set tdir D if with tolerance
  !temptDir = tdir of $!attaName/H1 wrt /*
  if !temptDir.angle(D).lt(1.5) and !temptDir.angle(D).gt(-1.5) then
    !!mdsHangerType6.support.tdir = D wrt /*
    !hangNA = !attaName & '/H1'
    !hangDBREF = !hangNA.dbref()
    !hangDBREF.tdir = D
  endif
  -- <<< DTF end of mod
  !!mdsHangerType6.support.tposition = tposition of $!attaName/H1 wrt /*

  --REFACTOR this was extracted from the modify mode label - start
  -- need to be extracted to a separate function file
  !support  = !!mdsHangerType6.setRestObject()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendorHangerType6.steelMem FORM member etc...
  if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
    !exist = !!ce
    !!ce = !support.datum
    !!ce.:MDSHConfig = !!mdsVendorHangerType6.hangerSelType.val
    !!ce = !exist
  endif
  !!mdsVendorHangerType6.steelMem = !support.rest.beamRefArray
  !!mdsHangerType6.support.rest.beamRefArray = !support.rest.beamRefArray

  -- restore the rest reconnected flag
  !support.rest.reconnected = !reconnected
  !support.rest.mode = 'MODIFY'

  -- Set Form Gadgets
  !!mdsHangerType6.name.val = !attaName.after('/')
  !!mdsHangerType6.p.val    = ''
  !!mdsAddAll('$!textName')

  -- Activates /Deactivates the !!mdsHangerType6 form gadgets
  !!ce = !attaRef
  !!mdsHangerType6.setGadgets()
  -- Set distance gadget
  !!mdsInterfaceDistance(!!mdsHangerType6)

  if ( defined(!!manIf.exe)) then
    if (!!manIf.exe.exists()) then
      if (!!mdsHangIf.upcase().eq('LISEGA')) then
        --DTF feb 05
        !!mdsHangerType6.reconnect.active = FALSE
        -- open distance for all types item 189
        !!mdsHangerType6.bthro.active = TRUE
        !!mdsHangerType6.select.active = TRUE
        !!mdsHangerType6.bdist.active = TRUE
        !!mdsHangerType6.dist.active = TRUE
      endif
    endif
  endif

  ------------------------------------------------------------------------
  -- Add marker text markers
  !!mdsAidText(!!mdsHangerType6)
  !hangerStart = !!mdsHangerType6.support.datum.position
  !hangerEnd   = !!mdsHangerType6.support.tposition
  aid clear line 2999
  handle ANY
  endhandle
  aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

  -- Put members into repre member of form
  !colourList = ARRAY()

  do !addRepre values !!mdsHangerType6.support.atta
    !!ce = !addRepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsHangerType6.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo

  !colourList.append(!!mdsHangerType6.support.rest.name.dbref())
  call !!kEnhanceList(!colourList)
  !!ce = !support .datum
  -- Saving hanger state to be able to restore it later
  !!mdsSaveHangerState(!!mdsHangerType6)

  --REFACTOR EXCLUDED THIS FOR NOW START
$(
  -- <RM> 11/08/08 save the hanger state now so that we can reinitialise it if there are problems in LICAD
  if (!!mdsHangIf.eq('LISEGA')) then
    pml load FORM !!mdsundolicad
    !!mdsundolicad.support = !!mdsHangerType6.support
    !!mdsSaveHangerState(!!mdsundolicad)
  endif
  -- <RM> 11/08/08 end of fix
$)
  --REFACTOR EXCLUDED THIS FOR NOW END

  return !support

endfunction
