--------------------------------------------------------------------------------
--
-- File: MdsiTT43.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: David Whiteside
-- Created: Thursday 11th September 2008
--
--
-- Description:
-- Initialisation for form 'TT43'.  Dun979 MDS12 addition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt43(!modify is STRING,!textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsTT43.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !!mdsTT43.mainBore.val = 'Main     Bore'

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !pad  = FALSE

  -- Initialise Standard gadgets
  !!kResetActive(!!mdsTT43, FALSE)
  !!mdsTT43.tag.active     = TRUE
  !!mdsTT43.name.active    = TRUE
  !!mdsTT43.crtube.active   = TRUE
  !!mdsTT43.crredu.active   = TRUE
  !!mdsTT43.crcros.active   = TRUE
  !!mdsTT43.cancel.active  = TRUE
  !!mdsTT43.connect.active = FALSE
  !!mdsTT43.modify.active = FALSE
  !!mdsTT43.forcecon.active = FALSE
  !!mdsTT43.disconn.active = FALSE

  --------------------------------------------------------------------------------
  -- Create Support object
  !support           = object MDSSUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotatecur = FALSE
  !support.handedcur = FALSE
  !support.rotated   = 0
  !support.bpnum     = 0
  !support.alias     = !alias

  --------------------------------------------------------------------------------

  -- Select member option to 1

  !!mdsTT43.member.val = 1

  if (!modify.upcase() neq |MODIFY|)then
    --------------------------------------------------------------------------------
    -- Create a New Trunnion Type 'TT43'

    -- Set callback on cancel button
    !!mdsTT43.cancel.callback = |call !!mdsCancelSupp(!!mdsTT43)|
    !support.modify            = FALSE

    -- Initialise variables for new supports
    !support.replace = !!mdsTrunn.replacement
    !support.type    = !!mdsTrunn.standard.selection('Rtext')
    !struName        = !!mdsTrunn.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif

    -- Set gadgets on form
    !!mdsTT43.name.val    = !struName
    !!mdsTT43.pLength.val = 0
    !!mdsTT43.pWidth.val  = 0
    !!mdsTT43.pThk.val    = 0
    !!mdsTT43.tlength.val = 0
    !!mdsTT43.dist.val    = 0
    !!mdsTT43.poffset.val = 0
    !!mdsTT43.p.val       = ''
    !!mdsTT43.poffset.active = TRUE

    -- Clear bore gadget if previously used
    !!mdsTT43.bore.clear()

    -- Hide calling form

    hide !!mdsTrunn

    -- Activate relevant gadgets
    !!mdsTT43.viewstd.active = TRUE
    --------------------------------------------------------------------------------

  else
    -- Modify an Existing Trunnion Type 'TT43'
    --------------------------------------------------------------------------------

    -- Set callback on cancel button
    !!mdsTT43.cancel.active = FALSE
    !support.modify            = TRUE
    !!kResetActive(!!mdsTT43, FALSE)
    !!mdsTT43.crtube.active    = FALSE
    !!mdsTT43.crredu.active    = FALSE
    !!mdsTT43.crcros.active    = FALSE
    !!mdsTT43.rotatt.active    = TRUE

    -- Initialise variables for existing supports

    -- Store Data in support object
    !support.type     = 'TT43'
    !support.position = TRUE
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = TRUE
      !!kRestoreUnits(!currentUnits)
      return
    endhandle

    -- Navigate to existing support datum
    !datum = '/' + !!mdsModifySupp.name.val
    !!ce = !datum.dbref()
    !support.datum   = !datum.dbref()

    -- Complete support atta list

    !!ce = $!datum/NOTE1
    !support.atta.append(!!ce)
    !!ce = $!datum/MAKEUP
    !support.atta.append(!!ce)
    !!ce = $!datum/NOTE2
    !support.atta.append(!!ce)
    --<dw>mar2009 dun1119 - This note not relevant to client
    -- !!ce = $!datum/NOTE3
    -- !support.atta.append(!!ce)
    !!ce = $!datum/SREF
    !support.atta.append(!!ce)
    !!ce = $!datum
    !support.atta.append(!!ce)
    !!ce             = !support.datum

    -- Set Form Gadgets
    !!mdsTT43.name.val   = !support.datum.namn
    !!mdsTT43.p.val      = ''

    !!mdsAddAll('$!textName')

    -- If the trunnion is connected to an elbow hide the distance/through gadgets

    if !support.datum.owner.href.type.eq('ELBO') then
      !!mdsTT43.bdist.active = FALSE
      !!mdsTT43.bthro.active = FALSE
      !!mdsTT43.dist.active = FALSE
      !!mdsTT43.select.active = FALSE
      !!mdsTT43.dist.val = 0
    else
      !!mdsTT43.bdist.active = TRUE
      !!mdsTT43.bthro.active = TRUE
      !!mdsTT43.dist.active = TRUE
      !!mdsTT43.select.active = TRUE
      --        !saveRef = !!ce
      !!ce = !support.datum
      branch
      goto href
      var !dist const dist p0 to pl of prev
      handle (2,113)
        var !dist const dist p0 to ph
      endhandle
      !!mdsTT43.dist.val = !dist.real()
    endif
$(    -- Fill the parameters from the sref atta
-- Check the trunnion bore compared to the main bore.
-- Offset button can only be active if it is a line size trunnion

if !support.datum.owne.hbore.eq(!support.datum.lbore) Then
!!ce = $!datum/SREF
!despar = despar
!!mdsTT43.poffset.val = !despar[4]
!!mdsTT43.poffset.active = TRUE
else
!!mdsTT43.poffset.active = FALSE
!!mdsTT43.poffset.val = 0
endif
$)

    -- Extended the ability to add an offset on an elbow trunnion to include all sizes rather
    -- than just equal bores as it currently is HPD0027646 GE 13/01/04

    !!ce = $!datum/SREF
    !despar = despar
    !!mdsTT43.poffset.val = !despar[4]
    !!mdsTT43.poffset.active = TRUE

    !!ce = !support.datum
    !styp = styp
    !bore = pa bore
    !!mdsTT43.bdirection.active = TRUE
    !!mdsTT43.direction.active = TRUE
    !hdir = ph dir
    !!mdsTT43.direction.val = !hdir.string().before(' WRT')

    -- Read plate dimensions
    --<dw>feb2009 dun1081 - plength set to POD for circular base plate - P-15661
    if !!ce.stype.eq('AC66') then
      !!mdsTT43.pLength.tag = 'Base Diam'
      !pLength = prop POD
      !pWidth  = '0'
    else
      !!mdsTT43.pLength.tag = 'Base Length'
      !pLength = prop PLEN
      !pWidth = prop PWID
      handle(2,207)
        !pWidth = '0'
      endhandle
      !!mdsTT43.pLength.val = !pLength.real()
      !!mdsTT43.pWidth.val = !pWidth.real()
    endif
    --<dw>feb2009 dun1081 - end of update for circular base plate
    --      !pThk = prop PTHK
    !!mdsGetProp(!!mdsTT43.pLength,!!mdsTT43.pLength,'PLEN',!bore,!styp)
    !!mdsGetProp(!!mdsTT43.pWidth,!!mdsTT43.pWidth,'PWID',!bore,!styp)
    !!mdsGetProp(!!mdsTT43.pThk,!!mdsTT43.pThk,'PTHK',!bore,!styp)
    -- Read length
    branch
    !pTBore = pt bore
    pin 9 at ph
    pin 8 at pt
    pin 9 dir d
    if !!ce.href.type.eq('REDU') then
      !paBore = !!ce.href.abore
      !plBore = !!ce.href.lbore
      if !paBore.gt(!plBore) then
        pin 9 plane d thro pa of href
      else
        pin 9 plane d thro pl of href
      endif
    else
      pin 9 plane d thro p0 of href
    endif
    var !height const dist pin 9 to pin 8

    --<wd>oct2003
    last mem
    !at59 = '0'
    if !!ce.styp.match('AT59').gt(0) or !!ce.styp.match('AT68').gt(0) then
      var !at59 const dist p1 to p2
    endif
    !!mdsResetPins(8,9)
    --!!mdsTT43.tlength.val = !height.real()
    -- Measured from the Main Pipe CL to the bottom of the Trunnion BASE Plate
    !!ce =$!datum/SREF
    var !height DESP NUM 5
    !!mdsTT43.tlength.val = !height.real() - !at59.real()
    branch
    --<wd>oct2003

    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

    -- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

    --<wd>apr2006<mds12>
    -- The available bores will be stored in the object for TT43 !!mdsParTT43[Bore]
    -- Fill the selection gadget with these available bores and the styp to be used
    --!availBores = !!mdsParTT43[$!bore].bores
    --
    -- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
    !mdsStd = 'TT43'
    --><wd>04jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>04jun09 - DFN P-17079

    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

    -- Check if the Trunnion type and bore is ACTIVE for the current PDMS Project
    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      -- Advise USER and EXIT Trunnion Support Modification
      !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
      unenhance all
      !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
      !!kRestoreUnits(!currentUnits)
      return

    else
      -- List the Available Trunnion Bore Sizes for the Current TRUNNION
      !availBores = !mdsTrunObj.bores

    endif
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !!kRestoreUnits(!currentUnits)

    --><wd>15jun2009 - DFN - P-1709 -- Get the Trunnion BORE DTEXT in the Correct Bore Units (i.e. Inches or  or Millimetres )
    !selectBoreString = !pTBore.string().bore(!!boreFMT).string()
    --<<wd>15jun2009 - DFN - P-1709

    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmBore = !availBores[$!setUnitBores] & 'mm'
      !stype = !mdsTrunObj.stypes[!setUnitBores]
      !sData = '/' & !stype & '-DATA-RNAM'
      !pprop = !sData.dbref().pprop
      !scode = $!pprop
      !unitBore.append(!mmBore.bore(!!boreFMT).string() + ' ' + !scode)
    enddo
    !currentUnits = !!kGetSetUnits()
    !!mdsTT43.bore.dText = !unitBore
    !!mdsTT43.bore.rText = !availBores

    -- Try and select the existing bore

    !platExists = TRUE
    plat1
    handle(2,113)
      !platExists = FALSE
    endhandle

    if (!platExists eq TRUE) then
      !stype = !!ce.stype
      !sData = '/' & !stype & '-DATA-RNAM'
      !pprop = !sData.dbref().pprop
      !scode = $!pprop
    endif

    --!!mdsTT43.bore.select('RTEXT',!pTBore.string().before('mm'))
    --><wd>15jun2009 - DFN - P-1709 -- Select Trunnion in the Correct Bore Units (i.e. Inches or Millimetres )
    --      !!mdsTT43.bore.select('DTEXT',!pTBore.string() + ' ' + !scode)
    !!mdsTT43.bore.select('DTEXT',!selectBoreString + ' ' + !scode)
    --<<wd>15jun2009 - DFN - P-1709

    units mm bore
    !pHBore = ph bore
    !!kRestoreUnits(!currentUnits)
    !mainBore = !pHBore.string()
    !!mdsTT43.mainBore.val = 'Main     Bore =     $!mainBore'

    -- Show available gadgets
    !!mdsTT43.bore.active = TRUE
    !!mdsTT43.viewstd.active = TRUE
    !!mdsTT43.setLen.active = TRUE
    !!mdsTT43.trunmat.active = TRUE
    !!mdsTT43.zoom.active = TRUE
    !!mdsTT43.tlength.active = TRUE
    !!mdsTT43.ok.active = TRUE

  endif
  --------------------------------------------------------------------------------

  -- Store support object in form
  !!mdsTT43.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsTT43.repre.clear()
  !!mdsTT43.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsTT43.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsTT43.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsTT43.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

  --------------------------------------------------------------------------------

  if (!modify.upcase() eq |MODIFY|) then
    !!ce = !!mdsTT43.support.datum
    -- Set distance gadget
    -- !!mdsDistance(!!mdsTT43)
    --------------------------------------------------------------------------------
    -- Add marker text markers
    var !pos pos wrt world
    -- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle
      -- Store Atta reference in form
      -- !!mdsTT43.support.atta.append(!!ce)
      var !pos pos wrt world
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
    enddo

    ---------------------------------------------------------------------------------------
    -- Store Packing Pieces in the Support Object
    -- Derived from the 'ATTAS' :MDSPackRef references in the Support.atta array
    do !atta values !!mdsTT43.support.atta
      !!ce = !atta
      if (!atta.:MDSPackRef.badref().not()) then
        !!mdsTT43.support.packs.append(!atta.:MDSPackRef)
      else
        :MDSPackRef unset
        handle ANY
        endhandle
        skip
      endif
    enddo

    ---------------------------------------------------------------------------------------
    -- Fill in dimensions from atta (Stored in mm)
    !!ce = !!mdsTT43.support.datum
    --      !despars = despar

    -- Store pos.ori and despar in case user cancel form
    !!mdsTT43.support.oldPosition    = pos wrt /*
    !!mdsTT43.support.oldOrientation = ori wrt /*
    !!mdsTT43.support.oldDespars     = despar
    !!mdsTT43.support.oldSpref       = spref

    -- Check if Reinforcing Plate available with Selected Trunnion
    !selection = !support.datum.stype
    if (matchwild(!selection,'*TT43-A*')) then
      !!mdsTT43.plate.val = 0
      !pad = FALSE
    elseif (matchwild(!selection,'*TT43-C*')) then
      !!mdsTT43.plate.val = 0
      !pad = FALSE
    else
      !pad = TRUE
    endif

  endif

  --------------------------------------------------------------------------------
  -- label /CONT

  -- Redefine Trunnion support name on form title
  !index = !!mdsTrunn.standard.rText.findfirst('TT43')
  !text  = !!mdsTrunn.standard.dText[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsTrunn,'TRUNN')
    !index = !!mdsTrunn.standard.rText.findfirst('TT43')
    !text  = !!mdsTrunn.standard.dText[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsTT43.support.replace = !formName

  call !!mdsSetFormName(!!mdsTT43, 'TRUNNION', '$!formName')

  --------------------------------------------------------------------------------
  -- Store current form information
  call !!mdsStoreTT43()

  -- Set the Callback actions on the Common Trunnion Selection
  -- form '!!mdsTrunnVT01.ok'  - OK gadget
  !!mdsTrunnVT01.action.clear()
  !!mdsTrunnVT01.cancel.callback = ||

  -- Activate/Deactivate '.pad' gadget as required
  -- !!mdsTT43.plate.active = !pad

  -- Activate bedplate icon
  !!mdsTT43.bedPlate.active = TRUE

  -- Deactivate icons that are not used
  !!mdsDeActivate(!!mdsTT43,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
  !!mdsTT43.mtoc.active = TRUE
  !!mdsTT43.ancmat.active = TRUE

  -------------------------------------------------------------------------------
  --<wd>26jul2004
  if (!modify.upcase() eq |MODIFY|) then
    -- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
    branch
    !trunDir = !!ce.hdir.wrt(/* )
    !form    = !!mdsTT43
    !form.tdirection = !trunDir.string()
    !dbref   = !!ce
    !message = ''
    !!mdsModifyTrun(!dbref, !form, !message)
    if (!message.length().neq(0)) then
      -- An ERROR exists so do NOT continue
      !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
      !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif
  --<wd>26jul2004
  -------------------------------------------------------------------------------

  -- Show Form for Trunnion Type 'TT43'
  !!kShowForm(!!mdsTT43)

  !!mdsCreateGeneralFromPS (!!mdsTT43, !name)

  --------------------------------------------------------------------------------
  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  --------------------------------------------------------------------------------
endfunction
