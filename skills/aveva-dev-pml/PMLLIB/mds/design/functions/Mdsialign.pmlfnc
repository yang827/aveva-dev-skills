--
--
-- Description:
-- Function to Invoke the Alignment Utility for MDS Frameworks
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsialign(!form is FORM)

-- Initialise variables
    call !!Mdsresetpins(1,10)

-- Initialise Variables
    !support = !form.support
    !strunam = !form.name.val
    !!Mdsalign.name.val  = !strunam
    !!Mdsalign.pick1.clear()
    !!Mdsalign.pick2.clear()
    !line[1] = 'unset'
    !!Mdsalign.pick1.val = !line
    !!Mdsalign.pick2.val = !line

-- Ensure Text Pane gadgets on the Align Form are NOT User Editable
    !!Mdsalign.pick1.seteditable(false)
    !!Mdsalign.pick2.seteditable(false)

-- Set FIRST Callback on the 'APPLY' button
    !!Mdsalign.applyform[1] = |!!Mdsmalign(!!$!form)|

-- Set the Direction Gadget '!!kgphalign.direction' to reflect the ORTHOGONAL Direction
-- of The Current Supports' Datum Atta 'Pleave Direction'
   !planedir                 = !!kcalcorthdir(!form.support.datum)
   !!kgphalign.direction.val = !planedir.string()

  endfunction
-- End of function

-- End of function Mdsialign.pml
