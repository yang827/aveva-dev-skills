  --<wd>31oct2006 Code Removed --   !Pref.append('GT24')       $* Overstrap Guides with Damper Springs
  --<wd>31oct2006 Code Removed --   !Pref.append('GT25')       $* HALFEN Overstrap Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT26')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT27A')      $* Guide for Trunnion Base Plate
  --<wd>31oct2006 Code Removed --   !Pref.append('GT27B')      $* Guide for Trunnion Base Plate
  --<wd>31oct2006 Code Removed --   !Pref.append('GT28')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT29')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT30')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT31')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT32')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT33')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT34')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT35')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT36')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT37')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT38')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT39')       $* Guide for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT40')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT41')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT42')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT43')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT44')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT45')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT46')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT47')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT48')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT49')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT50')       $* Band Guides
  --<wd>31oct2006 Code Removed --   !Pref.append('GT51')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT52')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT53')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('GT54')       $* Guide for shoe
  --<wd>31oct2006 Code Removed --
  --<wd>31oct2006 Code Removed -- -- Add User Definable Guides to selectable list
  --<wd>31oct2006 Code Removed --   do !Add from 500 to 700
  --<wd>31oct2006 Code Removed --     !Pref.append('GT' + !Add.string())
  --<wd>31oct2006 Code Removed --   enddo
  --<wd>31oct2006 Code Removed --
  --<wd>31oct2006 Code Removed -- -- MDS GUIDE standards added to the list available on MDS Frameworks
  --<wd>31oct2006 Code Removed -- -- IMPORTANT: Trunnion BASE plate GUIDE standards are INCLUDED
  --<wd>31oct2006 Code Removed -- -- But they are ONLY available on MDS SPECIAL FRAMEWORKS
  --<wd>31oct2006 Code Removed --
  --<wd>31oct2006 Code Removed -- -- All Stops added to the list available on MDS Frameworks
  --<wd>31oct2006 Code Removed -- -- IMPORTANT: Trunnion BASE plate STOP standards are INCLUDED - But are ONLY available on MDS SPECIAL FRAMEWORKS
  --<wd>31oct2006 Code Removed --   !Pref.append('ST01')       $* Stop for Insulated pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST02')       $* Stop for Insulated pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST03')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST04')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST05')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST06')       $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST07')       $* Stop for Trunnion Base Plate
  --<wd>31oct2006 Code Removed --   !Pref.append('ST08')       $* Temporary Stop for Trunnion Base Plate
  --<wd>31oct2006 Code Removed --   !Pref.append('ST09A')      $* Stop clamped on pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST09B')      $* Stop clamped on pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST10A')      $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST10B')      $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST11A')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST11B')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST12')       $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST13A')      $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST13B')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST14')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST15')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST16')      $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST17')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST18')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST19')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST20')       $* Stop for shoe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST21')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST22')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST23')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST24A')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST24B')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST24C')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST24D')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST25')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST26')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   -- !Pref.append('ST26')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST27')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST28')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST29')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST30')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST31')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST32')       $* Stop for pipe  !Pref.append('ST33')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --   !Pref.append('ST34')       $* Stop for pipe
  --<wd>31oct2006 Code Removed --
  --<wd>31oct2006 Code Removed -- -- Add User Stops
  --<wd>31oct2006 Code Removed --   do !Add from 500 to 700
  --<wd>31oct2006 Code Removed --     !Pref.append('ST' + !Add.string())
  --<wd>31oct2006 Code Removed --   enddo
  --<wd>31oct2006 Code Removed --
  --<wd>31oct2006 Code Removed -- -- All Slip Units and Shims etc.. added to the list available on MDS Frameworks
  --<wd>31oct2006 Code Removed --   !Pref.append('SU')         $* Slip units for Pipe Shoes
  --<wd>31oct2006 Code Removed --   !Pref.append('LT')         $* Lugs/Riser-Clamps
  --<wd>31oct2006 Code Removed --   !Pref.append('AN')         $* Anchors            (based on selected attachments)
  --<wd>31oct2006 Code Removed --   !Pref.append('SPECIAL')    $* Specials
  --<wd>31oct2006 Code Removed --   !Pref.append('CA')         $* Cable Tray Ancillaries

  --
  ---------------------------------------------------------------------------------------------------
  --<wd>mar2006--<mds12>
  --
  -- Replaced the PML function that read the MDS11.6 DEFAULT FILE
  -- !!mdsFILES.DESCRIPTION, i.e. DES-SUPP-DEFS
  --
  -- Populate list with required attachments-`            -----*-/*/
  --  !!mdsReaddefs(!!mdsAllAncill,!Pref)

  -- Determine the MDS ANCILLARIES where :MDSACTIVE is TRUE for each SECTION element in the PARAGON /MDS/ATTA/DEFAULTS Catalogue
  !ctype = |SECTION|
  !scope = /MDS/ATTA/DEFAULTS
  !filtr = object EXPRESSION(|:mdsactive eq TRUE|)
  -- Collect ALL of the SECTION Elements
  !sect  = object COLLECTION()
  !sect.filter(!filtr)
  !sect.scope(!scope)
  !sect.type(!ctype)
  -- SECTION Collection Results Array
  !sectresults = !sect.results()

  -- Determine the MDS ANCILLARY types to LOAD into the !!mdsAllAncill form
  !mdsstds = ARRAY()
  do !vald value !sectresults
    if (!vald.description.matchwild('AC*')) then
      skip
    elseif (!vald.description.matchwild('MH*')) then
      skip
    elseif (!vald.description.matchwild('BR*')) then
      skip
    elseif (!vald.description.matchwild('SP03*')) then
      skip
    elseif (!vald.description.unset()) or (!vald.description.trim().eq('')) then
      skip
    else
      !mdsstds.append(!vald)
    endif
  enddo

  -- Remove any Duplicate Entries in the ARRAY
  !mdsstds.unique()

  -- SORT ARRAY into ALPHABETICAL and NUMBER order
  !sindices = !mdsstds.sortedindices()
  !mdsstds.reindex(!sindices)

  --$P-----------------------
  --$P q var !mdsstds.size()
  --q var !mdsstds.size()
  --$P-----------------------

  -- Load the form list gadget !!mdsAllAncill.standard with the ACTIVE MDS ANCILLARY SUPPORT types
  -- ABORT MDS Application and FORM list gadget LOADING if the ARRAY !mdsstds is EMPTY
  if (!mdsstds.empty()) then
    -- ???ABORT MDS Loading??? - Default ERROR and Message set in loading of the FORM !!mdsAllAncill
    return
  else
    !!mdsloadancdefs = object MDSLOADSTDDEFS(!!mdsAllAncill, !mdsstds)
    if (!!mdsAllAncill.error) then
      -- ABORT MDS loading with Default ERROR and Message set in loading of the FORM !!mdsAllAncill
      return
    endif

  endif
  --   !!mdsloadancdefs = object mdsloadstddefs(!!mdsAllAncill, !mdsstds)
  --
  --<wd>mar2006--<mds12>
  ---------------------------------------------------------------------------------------------------
  --

  -- Add the number of available MDS Standard ANCILLARIES on TOP of the form
  !size = !!mdsAllAncill.standard.dtext.size()
  !!mdsAllAncill.standard.tag = 'Available Types = $!size'

  --clock
  --clock read elapsed
  -- End function
endfunction
