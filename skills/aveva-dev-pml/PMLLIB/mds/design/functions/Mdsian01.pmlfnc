--
-- File:  Mdsian01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form An01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIAn01(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAn01.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsAn01
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsAn01.datum.active = true
  !!mdsAn01.cancel.active = true
  !!mdsAn01.rotate.active = true
  !!mdsAn01.bDist.active = true
  !!mdsAn01.dist.active = true
  !!mdsAn01.bThro.active = true
  !!mdsAn01.select.active = true
  !!mdsAn01.nudge.active = true
  !!mdsAn01.bedPlate.active = true
  !!mdsAn01.connect.active = false
  !!mdsAn01.modify.active = false
  !!mdsAn01.forcecon.active = false
  !!mdsAn01.disconn.active = false
  !!mdsAn01.ancmat.active = true
  !!mdsAn01.graphicaldim = false
  !!mdsAn01.reinPad.active = false
  !!mdsAn01.modatta.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsAn01.cancel.callback = |Call !!mdsCancelSupp(!!mdsAn01)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsAnchor.replacement
    !support.type    = !!mdsAnchor.standard.selection('Rtext')
    !struName        = !!mdsAnchor.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsAn01.name.val = !struName
    !!mdsAn01.dist.val = 0
    !!mdsAn01.p.val = ''

    -- Height
    !!mdsAn01.adjust.active = false
    -- !!mdsAn01.pHeight.active = false
    -- !!mdsAn01.height.val = 0
    -- Length
    -- !!mdsAn01.length.active = false
    -- !!mdsAn01.pLength.active = false
    -- !!mdsAn01.length.val = 0
    -- Thickness
    -- !!mdsAn01.thickness.active = false
    -- !!mdsAn01.pThickness.active = false
    -- !!mdsAn01.thickness.val = 0
    -- Set buttons
    -- !!mdsAn01.setSteel.active = false
    -- !!mdsAn01.setDefault.active = false
    if (!support.type inset('AN01A','AN01B')) then
      !!mdsAn01.bDist.active = false
      !!mdsAn01.dist.active = false
      !!mdsAn01.bThro.active = false
      !!mdsAn01.select.active = false
      --!!mdsAn01.nudge.active = false
      --!!mdsAn01.rotate.active = false
    endif
    if (!alias inset('AN01A','AN01B')) then
      !!mdsAn01.ancmat.active = false
    endif
    if (!alias inset('AN12A','AN12B')) then
      !!mdsAn01.adploc.active = false
    endif

    !!mdsAnchor.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsAn01.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAn01)|
    !support.modify = true
    !!mdsAn01.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsAn01.struBpref.clear()
      !!mdsAn01.struBpref.append(!name.dbref())
      !!mdsAn01.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAn01.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAn01.storebpref.append(|:MDSBpref1 $!string|)
    endif
    if (!alias inset('AN01A','AN01B')) then
      !!mdsAn01.ancmat.active = false
    endif

    -- Set Form Gadgets
    !!mdsAn01.name.val = !name
    !!mdsAn01.p.val    = ''

    !!mdsAddAll('$!textName')

    -- Activate adjust to steel button if type is AN06,AN10,AN11,AN04

    !!mdsAn01.adjust.active = false
    if !alias.eq('AN06') or !alias.eq('AN10') or !alias.eq('AN11') then
      !!mdsAn01.adjust.active = true
    elseif !alias.eq('AN04') then
      !!mdsAn01.adjust.active = true

    endif

  endif

  -- Store support object in form
  !!mdsAn01.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget

    !!mdsDistance(!!mdsAn01)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set height and length gadgets




    if (!support.type inset('AN01A')) then
      !!mdsAn01.bDist.active = false
      !!mdsAn01.dist.active = false
      !!mdsAn01.dist.val = 0
      !!mdsAn01.bThro.active = false
      !!mdsAn01.select.active = false
      --!!mdsAn01.nudge.active = false
      --!!mdsAn01.rotate.active = false
    elseif (!support.type inset('AN01B')) then
      !!mdsAn01.bDist.active = true
      !!mdsAn01.dist.active = true
      !!mdsAn01.bThro.active = true
      !!mdsAn01.select.active = true
      --!!mdsAn01.nudge.active = true
      --!mdsAn01.rotate.active = false
    endif

    -- Store pos.ori and despar in case user cancel form
    !!mdsAn01.support.oldposition = POS WRT /*
    !!mdsAn01.support.oldorientation = ORI WRT /*
    !!mdsAn01.support.olddespars = despar

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsAnchor.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsAnchor.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsAnchor,'ANCHOR')
    !index = !!mdsAnchor.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsAnchor.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAn01.support.replace = !formName

  call !!mdsSetFormName(!!mdsAn01, 'ANCHOR', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsAn01.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAn01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
    -- Turn on rein pad option if type is a AN06,AN10,AN11
    if !support.type.eq('AN06') or !alias.eq('AN10') or !alias.eq('AN11') then
      !!mdsAn01.reinPad.active = true
      if !!mdsAn01.support.datum.:MDSPad.eq('') then
        !!mdsAn01.reinPad.val = false
      else
        !!mdsAn01.reinPad.val = true
      endif
    endif
  else
    if !support.type.eq('AN06') then
      !!mdsAn01.reinPad.active = true
      !!mdsAn01.reinPad.val = false
    endif
  endif

  -- Store current form information
  call !!mdsStoreAn01()

  -- Show Form
  !!kShowForm(!!mdsAn01)

  -- End function

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
