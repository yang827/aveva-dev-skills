--
-- File:  Mdsian640.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form an640
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIan640(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAn640.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Set the standard type and name
  !std = !!mdsGetStdNum(!alias)
  if !std[1].eq('AN') then
    !callingForm = !!mdsAnchor
    !title = 'Anchor'
  elseif !std[1].eq('ST') then
    !callingForm = !!mdsGuide
    !title = 'Stop'
  elseif !std[1].eq('GT') then
    !callingForm = !!mdsGuide
    !title = 'Guide'
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsAn640
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsAn640.datum.active = true
  !!mdsAn640.cancel.active = true
  !!mdsAn640.rotAtt.active = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then
    --CREATE MODE

    -- Set callback on cancel button and set mode member of support object
    !!mdsAn640.cancel.callback = |Call !!mdsCancelSupp(!!mdsAn640)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsAn640.name.val = !struName

    !callingForm.hide()

  else
    -- MODIFY MODE

    -- Set callback on cancel button and set mode member of support object
    !!mdsAn640.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAn640)|
    !support.modify = true
    !!mdsAn640.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsAn640.struBpref.clear()
      !!mdsAn640.struBpref.append(!name.dbref())
      !!mdsAn640.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAn640.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAn640.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAn640.name.val = !name
    !!mdsAddAll('$!textName')

    -- Show rotate icon
    !!mdsAn640.rotAtt.active = true

  endif

  -- Store support object in form
  !!mdsAn640.support = !support

  if (!modify.upcase() eq 'MODIFY') then
    -- Add marker text markers
    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>
    -- Store pos.ori and despar in case user cancel form
    !!mdsAn640.support.oldposition = POS WRT /*
    !!mdsAn640.support.oldorientation = ORI WRT /*
    !!mdsAn640.support.olddespars = despar
    !!mdsAn640.modatta.active = TRUE
  else
    !!mdsAn640.modatta.active = FALSE
  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!callingForm,'GUIDE')
    !index = !callingForm.standard.rtext.findfirst('$!support.type')
    !text  = !callingForm.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAn640.support.replace = !formName

  call !!mdsSetFormName(!!mdsAn640, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsAn640.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAn640.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsAn640)

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
