--
-- File:		Mdsianchor.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsanchor.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIanchor()

-- Reset Gadgets
  !!MdsAnchor.Name.val = 'unset'
  !!MdsAnchor.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsAnchor,'ANCHOR')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsAnchor.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsAnchor.view.active = false
      !!MdsAnchor.name.active = false
      return
    elsehandle none
      !!MdsAnchor.view.active = true
      !!MdsAnchor.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsAnchor)

-- Make the filter list the same as the standard list

  !!MdsAnchor.FilterByPipe.dtext = !!MdsAnchor.Standard.dtext
  !!MdsAnchor.FilterByPipe.rtext = !!MdsAnchor.Standard.rtext

-- Display all available ancillaries by default
  !!MdsGeneral.nofilter(TRUE,!!MdsAnchor)

-- Set the name gadget as the focus

  !!MdsAnchor.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsianchor.pml
