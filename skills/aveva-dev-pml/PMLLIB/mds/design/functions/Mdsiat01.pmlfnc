--
-- File: Mdsiat01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author: N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form At01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsIAt01(!modify is STRING, !textName is STRING,!alias is STRING)
  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  !form = !!mdsAT01

  if !!mdsAT01.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  -- This FORM is also used for GT13, GT22, GT23A and GT23B (<wd>jan2003), which is initiated from !!mdsGuide and not !!mdsGeneral
  -- so we need to set a variable to talk to the correct form
  if !alias.eq('GT13') then
    !callingForm = !!mdsGuide
    --<wd>jan2003
  elseif !alias.eq('GT22') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT23A') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT23B') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT24') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT25') then
    !callingForm = !!mdsGuide
    --<wd>jan2003
  elseif !alias.eq('GT29') then
    !callingForm = !!mdsGuide
    --ge-feb2004
  elseif !alias.eq('GT30') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT31') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT32') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT33') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT34') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT35') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT36') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT37') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT38') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT40') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST17') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST18') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST19') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST21') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST22') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST23') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('ST42') then
    !callingForm = !!mdsGuide
    --ge 08/12/05 Added new Zimmer Standards SX--200 (GT52) & SY--200 (AN19)
  elseif !alias.eq('GT52') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('AN19') then
    !callingForm = !!mdsAnchor
    --ge-feb2004
    --<wd>feb2003
  elseif !alias inset('AN07A','AN07B','AN07C','AN08','AN09','AN17','AN18') then
    --<wd>feb2003
    !callingForm = !!mdsAnchor
  elseif !alias inset('GT41','GT42','GT43','GT50','GT51','GT77','GT78','GT79','GT80','GT81','GT82') then
    --<wd>feb2003
    !callingForm = !!mdsGuide
  elseif !alias inset('ST25','ST26','ST27','ST28','ST29','ST30','ST31','ST34','ST35','ST39','ST51','ST52','ST53','ST54','ST55','ST56') then
    --<wd>feb2003
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT56') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT57') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT58') then
    !callingForm = !!mdsGuide
  elseif !alias.eq('GT59') then
    !callingForm = !!mdsGuide
    --<wd>29jan2010 - DUN1233 - Additional NEW MDS GUIDES Support Types GT90, GT91, GT92, GT93, GT94 and GT95
  elseif (!alias inset ('GT90','GT91','GT92','GT93','GT94','GT95')) then
    !callingForm = !!mdsGuide
    --<wd>01feb2010 - DUN1233 - Additional NEW MDS STOPS Support Types ST60 and ST61
  elseif !!mdsGetStdNum(!alias)[1].eq('GT').and(!!mdsGetStdNum(!alias)[2].eq('96')) then
    !callingForm = !!mdsGuide
  elseif (!alias inset ('ST60','ST61')) then
    !callingForm = !!mdsGuide
  else
    !callingForm = !!mdsGeneral
  endif
  -- Initialise Variables
  !name = '/' & !textName
  -- Initialise Standard gadgets
  !!mdsAT01.datum.active = TRUE
  !!mdsAT01.cancel.active = TRUE
  !!mdsAT01.rotate.active = TRUE
  !!mdsAT01.bdist.active = TRUE
  !!mdsAT01.dist.active = TRUE
  !!mdsAT01.bthro.active = TRUE
  !!mdsAT01.select.active = TRUE
  !!mdsAT01.nudge.active = TRUE
  !!mdsAT01.bedplate.active = TRUE
  !!mdsAT01.connect.active = FALSE
  !!mdsAT01.modify.active = FALSE
  !!mdsAT01.forcecon.active = FALSE
  !!mdsAT01.disconn.active = FALSE
  !!mdsAT01.newdat.active = FALSE
  !!mdsAT01.adploc.active = FALSE
  !!mdsAT01.graphicaldim = FALSE
  --<wd>feb2003
  if (!alias inset ('AT43','AT44','AT45','AT46','GT24') ) then
    !!mdsAT01.flipatta.active = TRUE
    !!mdsAT01.anccopy.active  = FALSE
    !!mdsAT01.ancnudge.active = FALSE
  else
    !!mdsAT01.flipatta.active = FALSE
    !!mdsAT01.anccopy.active  = TRUE
    !!mdsAT01.ancnudge.active = TRUE
  endif
  --<wd>feb2003
  --<ge>Mar2004
  if (!alias inset ('ST31') ) then
    !!mdsAT01.flipatta.active = TRUE
  endif
  --<ge>Mar2004
  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotatecur = FALSE
  !support.handedcur = FALSE
  !support.rotated   = 0
  !support.bpnum     = 1
  !support.alias     = !alias
  if (!modify.upcase() neq 'MODIFY')then
    -- Set callback on cancel button and set mode member of support object
    !!mdsAT01.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT01)|
    !support.modify = FALSE
    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val
    -- Set Paragraph gadget on form
    !!mdsAT01.name.val = !struName
    !!mdsAT01.dist.val = 0
    !!mdsAT01.p.val = ''
    if (!support.type inset('AT10A','AT11A')) then
      !!mdsAT01.bdist.active = FALSE
      !!mdsAT01.dist.active = FALSE
      !!mdsAT01.bthro.active = FALSE
      !!mdsAT01.select.active = FALSE
      !!mdsAT01.mdsADP.active = TRUE
    else
      --<wd>feb2005 -- Individual Ancillaries may now be drawn via the "MDS ABA" utility in DRAFT
      --!!mdsAT01.mdsADP.active = false
      !!mdsAT01.mdsADP.active = TRUE
      --<wd>feb2005
    endif
    if (!support.type inset('LT01A','LT01B','LT01C','AT23','AT24','AT61','AT32','AT63','AT64','AT65','LT15','LT16A','LT16B')) then
      !!mdsAT01.bedplate.active = FALSE
    endif
    !callingForm.hide()
  else
    -- Set callback on cancel button and set mode member of support object
    !!mdsAT01.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT01)|
    !support.modify = TRUE
    !!mdsAT01.datum.active = FALSE
    -- Store Data in support object
    !support.type     = ( :MDSSUPPTYPE of $!name )
    !support.position = TRUE
    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())
    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.padir  = Pa Dir wrt world
    !support.pldir  = Pl Dir wrt world
    !support.p9dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()
    -- Get bedplate references if set
    var !bpRef1 :MDSBPREF1
    if (!!ce.:MDSBPREF1.badref().not()) then
      !support.bedplate1 = !bpRef1.dbref()
      !!mdsAT01.strubpref.clear()
      !!mdsAT01.strubpref.append(!name.dbref())
      !!mdsAT01.strubpref.append(!bpRef1.dbref())
      -- Store original ref
      !!mdsAT01.storeBPRef.clear()
      !string = !bpRef1.dbref()
      !!mdsAT01.storeBPRef.append(|:MDSBPREF1 $!string|)
    endif
    -- Set Form Gadgets
    !!mdsAT01.name.val = !name
    !!mdsAT01.p.val    = ''
    !!mdsAddAll('$!textName')
    if (!support.type inset('LT01A','LT01B','LT01C','AT23','AT24','AT61','AT32','AT63','AT64','AT65','LT15','LT16A','LT16B')) then
      !!mdsAT01.bedplate.active = FALSE
    endif
    --<wd>feb2005 -- Individual Ancillaries may now be drawn via the "MDS ABA" utility in DRAFT
    !!mdsAT01.mdsADP.active = TRUE
    --<wd>feb2005
  endif
  -- Store support object in form
  !!mdsAT01.support = !support
  if (!modify.upcase() eq 'MODIFY') then
    -- Set distance gadget
    !!mdsDistance(!!mdsAT01)
    -- Add marker text markers
    !!mdsaidtext(!!mdsAT01)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle ANY
        skip
      endhandle
      !!mdsAT01.support.atta.append(!!ce)
    enddo
    -- Set height and length gadgets
    !unusedBore = pa bore
    if (!support.type inset('AT10B','AT11B','AT10A','AT11A')) then
      -- Set buttons
      if (!support.type inset('AT10A','AT11A')) then
        !!mdsAT01.bdist.active = FALSE
        !!mdsAT01.dist.active = FALSE
        !!mdsAT01.dist.val = 0
        !!mdsAT01.bthro.active = FALSE
        !!mdsAT01.select.active = FALSE
      endif
    elseif (!support.type inset('LT01A','AT61','AT32','AT63','AT64','AT65')) then
      !!mdsAT01.bedplate.active = FALSE
    elseif (!support.type inset('LT01B','LT01C','AT24')) then
      !!mdsAT01.bedplate.active = FALSE
    endif
    ------------------------------------------------------------------------------------
    -- This CODE has been Replaced by the use of the function 'MdsSaveAttaInf.pmlfnc'
    -- called via the function 'MdsStoreAT01.pmlfnc' at the bottom of this function.
    -- Store pos.ori and despar in case user cancel form
    -- !!mdsAT01.support.oldPosition = POS WRT /*
    -- !!mdsAT01.support.oldOrientation = ORI WRT /*
    -- !!mdsAT01.support.oldDespars = despar
    ------------------------------------------------------------------------------------
  endif
  label /CONT
  -- Redefine standard support name on form title
  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    if !callingForm.string().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  if !!mdsAT01.support.alias.match('ST').gt(0) then
    !title = 'STOP'
  elseif !!mdsAT01.support.alias.match('GT').gt(0) then
    !title = 'GUIDE'
  else
    !title = 'GENERAL'
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAT01.support.replace = !formName
  call !!mdsSetFormName(!!mdsAT01, '$!title', '$!formName')
  -- If modify put members into repre member of form
  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addRepre values !!mdsAT01.support.atta
      !!ce = !addRepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kfinddrawcolour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAT01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kreprelevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif
  -- Store current form information
  call !!mdsStoreAt01()
  -- Show Form
  !!kShowForm(!!mdsAT01)
  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  !!mdsCreateGeneralFromPS (!form, !name)
  -- End function
endfunction
