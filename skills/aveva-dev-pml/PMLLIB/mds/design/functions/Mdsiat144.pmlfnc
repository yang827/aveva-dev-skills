--
--
-- Function for Shoe Type AT144-- Author: D.Whiteside
-- Created: 20 November 2008 Clearcase DUN1052
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIAt144(!modify is STRING, !textname is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT144.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()
  !callingform  = !!mdsGeneral

  -- Initialise Variables
  !name = '/' & !textname
  !form = !!mdsAT144

  -- Initialise Standard gadgets
  !!mdsAT144.datum.active    = TRUE
  !!mdsAT144.cancel.active   = TRUE
  !!mdsAT144.rotate.active   = TRUE
  !!mdsAT144.bdist.active    = TRUE
  !!mdsAT144.dist.active     = TRUE
  !!mdsAT144.bthro.active    = TRUE
  !!mdsAT144.select.active   = TRUE
  !!mdsAT144.nudge.active    = TRUE
  !!mdsAT144.connect.active  = FALSE
  !!mdsAT144.modify.active   = FALSE
  !!mdsAT144.forcecon.active = FALSE
  !!mdsAT144.disconn.active  = FALSE
  !!mdsAT144.newdat.active   = FALSE
  !!mdsAT144.adploc.active   = FALSE
  !!mdsAT144.graphicaldim    = FALSE
  !!mdsAT144.flipatta.active = FALSE
  --<dw>jan2009 dun1052 - Default Ancillary Material applied in all instances
  !!mdsAT144.ancmat.active   = FALSE

  !!mdsAT144.anccopy.active  = TRUE
  !!mdsAT144.ancnudge.active = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotatecur = FALSE
  !support.handedcur = FALSE
  !support.rotated   = 0
  !support.bpnum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT144.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT144)|
    !support.modify = FALSE

    -- Initialise variables for new supports
    !support.replace = !callingform.replacement
    !support.type    = !callingform.standard.selection('Rtext')
    !struname        = !callingform.name.val

    -- Set Paragraph gadget on form
    !!mdsAT144.name.val = !struname
    !!mdsAT144.dist.val = 0
    !!mdsAT144.p.val = ''

    !!mdsAT144.rpad.active     = FALSE
    !!mdsAT144.type.active     = FALSE
    !!mdsAT144.rpad.val        = FALSE

    -- Height
    !!mdsAT144.height.active   = FALSE
    !!mdsAT144.pheight.active  = FALSE
    !!mdsAT144.height.val      = 0

    -- Length
    !!mdsAT144.length.active   = FALSE
    !!mdsAT144.plength.active  = FALSE
    !!mdsAT144.length.val      = 0

    -- Temp range
    !!mdsAT144.rangtemp.active = FALSE
    !!mdsAT144.notetemp.val    = ' '
    !!mdsAT144.mdsadp.active   = TRUE

    !callingform.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT144.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT144)|
    !support.modify = TRUE
    !!mdsAT144.datum.active = FALSE
    if !alias inset('AT144','AT146','AT147','AT148','AT150','AT151') then
      --<dw>mar2009 DFN P-16466 Convert to metric for reference to mds defaults
      units mm bore
      !satta      = !!ce
      --       !parVar     = '!!mdsPar' & !satta.styp
      !abore      = !satta.abor
      !gussdpthk  = !!mdsGetDesp('STHK')
      --       !gussetthk  = $!parVar[$!abore].despars[$!gussdpthk].real()
      --<dw>mar2009 dun1119 - Object applied to extract design parameter
      !mdsattaobj = object MDSREADPARSDATA()
      !unusedMdsattadefs = !mdsattaobj.mdsdefsdata(!satta.stype,!abore.real().value())
      !gussetthk  = !mdsattaobj.despars[$!gussdpthk].real()
      if (!gussetthk gt 0) then
        !!mdsAT144.rpad.active  = TRUE
      else
        !!mdsAT144.rpad.active  = FALSE
        !!mdsAT144.type.active  = FALSE
        !!mdsAT144.rpad.val     = FALSE
      endif
      --<dw>mar2009 DFN P-16466 Convert back to original units.
      if(!!kgetBoreUnits()) then
        units in bore
      endif
    else
      !!mdsAT144.rpad.active  = FALSE
      !!mdsAT144.type.active  = FALSE
      !!mdsAT144.rpad.val     = FALSE
    endif

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = TRUE

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.padir  = Pa Dir wrt world
    !support.pldir  = Pl Dir wrt world
    !support.p9dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT144.strubpref.clear()
      !!mdsAT144.strubpref.append(!name.dbref())
      !!mdsAT144.strubpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT144.storebpref.clear()
      !bpString = !bpref1.dbref()
      !!mdsAT144.storebpref.append(|:MDSBpref1 $!bpString|)
    endif

    -- Set Form Gadgets
    !!mdsAT144.name.val = !name
    !!mdsAT144.p.val    = ''

    !!mdsAddAll('$!textname')

    --<wd>feb2005 -- Individual Ancillaries may now be drawn via the "MDS ABA" utility in DRAFT
    !!mdsAT144.mdsadp.active = TRUE
    --<wd>feb2005
  endif

  -- Store support object in form
  !!mdsAT144.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsAT144)

    -- Add marker text markers
    !!mdsaidtext(!!mdsAT144)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle ANY
        skip
      endhandle
      !!mdsAT144.support.atta.append(!!ce)
    enddo

    -- Set height and length gadgets
    !unusedBore = pa bore

  endif

  -- Redefine standard support name on form title

  !!mdsPopulate(!!mdsGeneral,'GENERAL')
  !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGeneral.standard.dtext[!index]
  if !alias inset('AT144','AT146','AT147','AT148','AT150','AT151') then
    !title      = 'Welded Shoe'
  elseif !alias inset('AT174','AT175') then
    !title      = 'Wrapper'
  else
    !title      = 'Clamped Shoe'
  endif
  !suppnumber = before(!text, '-')
  !formname   = !suppnumber.trim()
  !!mdsAT144.support.replace = !formname
  !!mdsAT144.formtitle = |$!title $!formname|


  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then

    !bore = pa bore
    !!mdsGetProp(!!mdsAT144.height,!!mdsAT144.pheight,'HEI',!bore,!support.type)
    !!mdsGetProp(!!mdsAT144.length,!!mdsAT144.plength,'LEN',!bore,!support.type)

    !satta = !!ce
    !mindpnum  = !satta.prop.mint
    !maxdpnum  = !satta.prop.maxt
    !!mdsAT144.notetemp.val    = 'Min. $!mindpnum  Max. $!maxdpnum'

    !colourlist = ARRAY()
    do !addrepre values !!mdsAT144.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kfinddrawcolour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsAT144.repre.append('!!mdsRemAdd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levchange value
      call !!kreprelevel(!!ce, 'PIPE',!!mdsOptions.levchange, $!colour)
      !colourlist.append(!!ce.name.dbref())
    enddo
    call !!kEnhanceList(!colourlist)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsStoreAt01()

  -- Show Form
  !!kShowForm(!!mdsAT144)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
