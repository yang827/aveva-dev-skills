--
-- File:  Mdsiat29.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form at29
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIat29(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT29.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsAT29

  -- Hide all gadgets
  !!kResetActive(!!mdsAT29 , FALSE)
  !!mdsAT29.datum.active = true
  !!mdsAT29.cancel.active = true
  !!mdsAT29.graphicaldim = false
  !!mdsAT29.graphicaldim = false
  !!mdsAT29.ok.active = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT29.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT29)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGeneral.replacement
    !support.type    = !!mdsGeneral.standard.selection('Rtext')
    !struName        = !!mdsGeneral.name.val

    -- Set Paragraph gadget on form
    !!mdsAT29.name.val = !struName
    !!mdsAT29.dist.val = 0
    !!mdsAT29.p.val = ''

    if (!support.type inset('AT10A','AT11A')) then
      !!mdsAT29.bDist.active = false
      !!mdsAT29.dist.active = false
      !!mdsAT29.bthro.active = false
      !!mdsAT29.select.active = false
      !!mdsAT29.mdsadp.active = true
    else
      !!mdsAT29.mdsadp.active = false
    endif

    if (!support.type inset('LT01A','LT01B','LT01C')) then
      !!mdsAT29.bedplate.active = false
    endif

    !!mdsGeneral.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT29.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT29)|
    !support.modify = true
    !!mdsAT29.datum.active = false
    !!mdsAT29.modAtta.active = true
    !!mdsAT29.ancMat.active = true
    !support.oldDespars = despar

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT29.struBpref.clear()
      !!mdsAT29.struBpref.append(!name.dbref())
      !!mdsAT29.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT29.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAT29.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAT29.name.val = !name
    !!mdsAT29.p.val    = ''

    !!mdsAddAll('$!textName')

  endif

  -- Activate note gadget
  !!mdsAT29.ancnote.active = true


  -- Store support object in form
  !!mdsAT29.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsAT29)

    -- Add marker text markers
    !!mdsaidtext(!!mdsAT29)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsAT29.support.atta.append(!!ce)
    enddo

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGeneral.standard.dtext[!index]
  handle (61,567) (61,615)
    if !!mdsGeneral.string().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAT29.support.replace = !formName

  call !!mdsSetFormName(!!mdsAT29, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsAT29.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAT29.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    Call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  Call !!mdsStoreat29()

  -- Show Form
  !!kShowForm(!!mdsAT29)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
