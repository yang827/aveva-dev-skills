--
-- Author:		N.Morris
-- Created:		Mon Sept 14
--
--
-- Description:
-- Initialisation for form Mdsbedplate
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        !Formname
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIBedPlate(!Form is FORM,!Type is STRING)

-- Check that framework/atta has been created

  if !Type eq 'FRAME' then
-- Initialise Variables
    !!MdsBedPlate.Name.val = !Form.Name.val
    if (!Form.Support.Stru.Mcount() eq 0)then
      !!Alert.error('Unable to set bedplate references as the support structure has not been created')
      return
    endif
  else
    if (!Form.Support.Datum.set())then
    else
      !!Alert.error('Unable to set bedplate references as the datum atta has not been created')
      return
    endif
  endif


 if !Type eq 'FRAME' then

  !!mdsbedplate.sctns.tag =  'Section                   Connection'


  if !form.support.stru.:MDSSuppType.eq('SPECIAL') or !Form.support.type inset('FT10','FT11','FT13','FT16','FT14','FT07') then
    var !sctns coll all sctn for $!form.support.stru
  else
    var !sctns coll all sctn with match (name,'-V')gt 0 for $!form.support.stru
  endif

 elseif !type eq 'ATTA' then
  !!mdsbedplate.sctns.tag =     'Ancillary                Connection'
  !sctns[1] = !form.support.datum.string()
  if !sctns[1].dbref().cref.set() then
     !s = !sctns[1].dbref().cref.type
     if !s eq 'HANG' then
       !!mdsbedplate.sctns.tag =  'Hanger                    Connection'
       !rest = !sctns[1].dbref().cref.owner
       var !sctns coll all Hang for $!rest
     endif
  endif
 elseif !type eq 'FITT' then
  !!mdsbedplate.sctns.tag =  'Fitting                   Connection'
     if !form inset(!!MDSFR01,!!MDSFR02,!!MDSFR03) then
        var !sctn coll all sctn with match (name,'-V')gt 0 for $!form.support.stru
        if !sctn.size().gt(0) then
          var !sctns coll all fitt with purp eq 'CONN' for $!sctn[1]
        else
          !!Alert.Error('No members found')
          return
        endif
     elseif !form inset(!!MDSFR05,!!MDSFR06,!!MDSFR07,!!MDSFR08,!!MDSFR13) then
        var !sctn coll all sctn with match (name,'-H')gt 0 for $!form.support.stru
        if !sctn.size().gt(0) then
          do !a values !sctn
            var !sctns append coll all fitt with purp eq 'CONN' for $!a
          enddo
        else
          !!Alert.Error('No members found')
          return
        endif
     endif
   --- fr04 fr08 fr09 fr10 fr11 fr12 use   other means of connection and need to be dealt with separately?????????????
 endif

if !sctns.size().eq(0) then
     !!alert.error('No Connecting Elements Found')
     return
endif

 -- Set form title
  if !sctns.size().eq( 1 ) then
    !!MdsBedPlate.FormTitle = 'Bed/Anchor Plate Reference'
  else
    !!MdsBedPlate.FormTitle = 'Bed/Anchor Plate References'
  endif

-- at this point, we have liste the sctn fitt or atta to be connected
-- now we need to add names of section to paragraph gadgets

    -- loop through the sctns and compile a list of connections
    !names = ARRAY()
    !connections = ARRAY()
    !sctnlist = ARRAY()

    do !a values !sctns
      !name = !a.dbref().flnn
      !connection = !a.dbref().:mdsancref[1].flnn
      handle ANY
        !connection = 'Unset'
      endhandle
      !names.append(!name)
      !connections.append(!connection)
      !sctnlist.append(!a)
      !connection2 = !a.dbref().:mdsancref[2].flnn
      handle ANY
      elsehandle NONE
        !names.append(!name)
        !connections.append(!connection2)
        !sctnlist.append(!a)
      endhandle

    enddo
    !width = !names.width() + 2
    do !d index !names
      var !line compose '$!names[$!d]' width $!width '$!connections[$!d]'
      !dtext[!d] = !line[1]
    enddo
    !!MdsBedPlate.sctns.dtext = !dtext
    --!!MdsBedPlate.sctns.rtext = !sctns
    !!MdsBedPlate.sctns.rtext = !sctnlist


    !!MdsBedPlate.formname = !Form

     -- Show Form
    !!MdsBedPlate.show()

-- End function
endfunction

-- End of file Mdsibedplate.pml
