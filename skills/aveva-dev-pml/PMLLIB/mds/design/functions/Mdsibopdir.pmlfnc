--
-- File:  Mdsibopdir.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IBOPDIR
--
-- Author:  I.osborne
-- Created:  Tue Jun 03
--
--
-- Description:
-- Initialisation for BOP Direction form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          DBREF       Element to be directed
--     2     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIBopDir(!element is DBREF, !form is FORM)

  -- If the styp is PIPE-REST-INLINE return

  if !!mdsCheckTrun(!form,'ALL') then
    -- if !element.styp.eq('PIPE-REST-INLINE') then
    return
  endif

  -- Initialise Variables
  !origin = !!ce

  -- Navigate to passed element
  !!ce = !element

  !!mdsBopDir.dirElement = !!ce

  if (!form.support.type inset('FT05','FT06','FT07')) then
    !direction = P11 DIR WRT WORLD
  else
    !direction = P3 DIR WRT WORLD
  endif
  Axes at ce

  -- Set gadget
  !!mdsBopDir.dir.val = trim(before (!direction.string(), 'WRT'))

  -- Populate Form gadet
  !!mdsBopDir.form = !form

  -- Return to original position in hierarchy
  !!ce = !origin

  -- Show blocking form
  --<wd>feb2004 - Form is NOW a NON BLOCKING FORM
  -- So the form MUST now be shown ONLY after successfully CREATING the Ancillary
  --    !!kShowForm(!!mdsBopDir)
  !!mdsancill.action.append('!!kShowForm(!!mdsBopDir)')
  --<wd>feb2004

endfunction
