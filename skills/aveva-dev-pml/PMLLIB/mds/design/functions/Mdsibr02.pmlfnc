--
-- File: Mdsibr02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Mon Oct 29
--
-- Revision:
--
-- Description:
-- Initialisation for form Br02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIBr02(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsBR02.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetSetUnits()

  -- Set calling form name

  !callingForm = !!mdsBranRein

  -- Initialise Variables

  !name = '/' & !textName

  -- Initialise Standard gadgets

  !!mdsBR02.datum.active = true
  !!mdsBR02.cancel.active = true
  !!mdsBR02.bdist.active = false
  !!mdsBR02.dist.active = false
  !!mdsBR02.bthro.active = false
  !!mdsBR02.select.active = false
  !!mdsBR02.nudge.active = true
  !!mdsBR02.bedPlate.active = false
  !!mdsBR02.connect.active = false
  !!mdsBR02.modify.active = false
  !!mdsBR02.forcecon.active = false
  !!mdsBR02.disconn.active = false
  !!mdsBR02.newdat.active = false
  !!mdsBR02.adploc.active = false
  !!mdsBR02.graphicalDim = false
  !!mdsBR02.flipAtta.active = false
  !!mdsBR02.ancCopy.active  = true
  !!mdsBR02.ancNudge.active = true
  !!mdsBR02.rotate.active = false
  !!mdsBR02.rotAtt.active = false
  !!mdsBR02.deleteAtta.active = false
  !!mdsBR02.nudge.active = false
  !!mdsBR02.ancMat.active = false
  !!mdsBR02.ancCopy.active = false
  !!mdsBR02.ancNudge.active = false
  !!mdsBR02.ancNote.active = false

  -- Create Support object

  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bpnum     = 1
  !support.alias     = !alias

  -- CREATE MODE

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object

    !!mdsBR02.cancel.callback = |Call !!mdsCancelSupp(!!mdsBR02)|
    !support.modify = false

    -- Initialise variables for new supports

    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    -- Set Paragraph gadget on form

    !!mdsBR02.name.val = !struName
    !!mdsBR02.dist.val = 0
    !!mdsBR02.p.val = ''
    !!mdsBR02.mdsadp.active = false
    --<dw>aug2008 dun979-default repad addition form display
    !!mdsBR02.rpad.active   = false
    !!mdsBR02.type.active   = false
    !!mdsBR02.thick.active  = false
    !!mdsBR02.clear.active  = false
    !!mdsBR02.rpad.val      = false
    !!mdsBR02.thick.val     = 0
    !!mdsBR02.clear.val     = 0
    --<dw>aug2008 dun979-end of default form display

    -- Hide calling form

    !callingForm.hide()

    -- MODIFY MODE

  else

    -- Set callback on cancel button and set mode member of support object

    !!mdsBR02.cancel.callback = |Call !!mdsRestoreShoe(!!mdsBR02)|
    !support.modify = true
    !!mdsBR02.datum.active = false

    -- Store Data in support object

    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object

    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum

    !!ce = !name.dbref()
    !support.paDir  = Pa Dir wrt world
    !support.plDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set

    var !bpRef1 :MDSBpref1
    if (!!ce.:mDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpRef1.dbref()
      !!mdsBR02.struBpref.clear()
      !!mdsBR02.struBpref.append(!name.dbref())
      !!mdsBR02.struBpref.append(!bpRef1.dbref())
      -- Store original ref
      !!mdsBR02.storeBpref.clear()
      !string = !bpRef1.dbref()
      !!mdsBR02.storeBpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets

    !!mdsBR02.name.val = !name
    !!mdsBR02.p.val    = ''
    !!mdsAddAll('$!textName')
    --<dw>aug2008 dun979-repad addition display settings
    !desp  = despara
    if !desp[10] eq 1 or !desp[11] eq 1 then
      !!mdsBR02.rpad.val     = true
      !!mdsBR02.type.active  = true
      !!mdsBR02.thick.active = true
      !!mdsBR02.clear.active = true
      if !desp[11] eq 1 then
        !!mdsBR02.type.val = 2
      endif
      !!mdsBR02.thick.val = !desp[9]
      !!mdsBR02.clear.val = !desp[8]
    endif
    --<dw>aug2008 dun979-end of repad display settings

  endif

  -- Store support object in form

  !!mdsBR02.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsBR02)

    -- Add marker text markers

    !!mdsaidtext(!!mdsBR02)

    -- Store Atta reference in form

    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsBR02.support.atta.append(!!ce)
    enddo

  endif

  label /CONT

  -- Redefine standard support name on form title

  --<dw>aug2008 dun979 - 'MdsGeneral.standard' replaced by 'MdsBranRein.standard' after error handle
  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsBranRein,'BRANREIN')
    !index = !!mdsBranRein.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsBranRein.standard.dtext[!index]
  endhandle
  --<dw>aug2008 dun979 - end of replacement
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsBR02.support.replace = !formName

  call !!mdsSetFormName(!!mdsBR02, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsBR02.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kfindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsBR02.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!krepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    call !!kenhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsStoreBr02()

  -- Show Form
  !!kshowForm(!!mdsBR02)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!mdsCreateGeneralFromPS (!!mdsBR02, !name)

  -- End function
endfunction
