--
-- File: Mdsibr03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Mon Oct 29
--
-- Revision:
--
-- Description:
-- Initialisation for form Br03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIBr03(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsBR03.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetSetUnits()

  -- Set calling form name

  !callingForm = !!mdsBranRein

  -- Initialise Variables

  !name = '/' & !textName

  -- Initialise Standard gadgets

  !!mdsBR03.datum.active = true
  !!mdsBR03.cancel.active = true
  !!mdsBR03.bdist.active = false
  !!mdsBR03.dist.active = false
  !!mdsBR03.bthro.active = false
  !!mdsBR03.select.active = false
  !!mdsBR03.nudge.active = true
  !!mdsBR03.bedPlate.active = false
  !!mdsBR03.connect.active = false
  !!mdsBR03.modify.active = false
  !!mdsBR03.forceCon.active = false
  !!mdsBR03.disConn.active = false
  !!mdsBR03.newDat.active = false
  !!mdsBR03.adpLoc.active = false
  !!mdsBR03.graphicalDim = false
  !!mdsBR03.flipAtta.active = false
  !!mdsBR03.ancCopy.active  = true
  !!mdsBR03.ancNudge.active = true
  !!mdsBR03.rotate.active = false
  !!mdsBR03.rotAtt.active = false
  !!mdsBR03.deleteAtta.active = false
  !!mdsBR03.nudge.active = false
  !!mdsBR03.ancMat.active = false
  !!mdsBR03.ancCopy.active = false
  !!mdsBR03.ancNudge.active = false
  !!mdsBR03.ancNote.active = false

  -- Create Support object

  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bpNum     = 1
  !support.alias     = !alias

  -- CREATE MODE

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object

    !!mdsBR03.cancel.callback = |Call !!mdscancelSupp(!!mdsBR03)|
    !support.modify = false

    -- Initialise variables for new supports

    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struname        = !callingForm.name.val

    -- Set Paragraph gadget on form

    !!mdsBR03.name.val = !struname
    !!mdsBR03.dist.val = 0
    !!mdsBR03.p.val = ''
    !!mdsBR03.mdsadp.active = false

    -- Hide calling form

    !callingForm.hide()

    -- MODIFY MODE

  else

    -- Set callback on cancel button and set mode member of support object

    !!mdsBR03.cancel.callback = |Call !!mdsRestoreShoe(!!mdsBR03)|
    !support.modify = true
    !!mdsBR03.datum.active = false

    -- Store Data in support object

    !support.type     = ( :MDSSupptype of $!name )
    !support.position = true

    -- Store Atta reference's in object

    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum

    !!ce = !name.dbref()
    !support.paDir  = Pa Dir wrt world
    !support.plDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set

    var !bpRef1 :MDSBpref1
    if (!!ce.:mDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpRef1.dbref()
      !!mdsBR03.struBpref.clear()
      !!mdsBR03.struBpref.append(!name.dbref())
      !!mdsBR03.struBpref.append(!bpRef1.dbref())
      -- Store original ref
      !!mdsBR03.storebpref.clear()
      !string = !bpRef1.dbref()
      !!mdsBR03.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets

    !!mdsBR03.name.val = !name
    !!mdsBR03.p.val    = ''
    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form

  !!mdsBR03.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsBR03)

    -- Add marker text markers

    !!mdsaidtext(!!mdsBR03)

    -- Store Atta reference in form

    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsBR03.support.atta.append(!!ce)
    enddo

  endif

  label /CONT

  -- Redefine standard support name on form title

  --<dw>aug2008 dun955 - 'MdsGeneral.standard' replaced by 'MdsBranRein.standard' after error handle
  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsBranRein,'BRANREIN')
    !index = !!mdsBranRein.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsBranRein.standard.dtext[!index]
  endhandle
  --<dw>aug2008 dun955 - end of replacement
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsBR03.support.replace = !formName

  call !!mdsSetFormName(!!mdsBR03, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsBR03.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kfinddrawcolour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsBR03.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!krepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    call !!kenhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsStoreBr03()

  -- Show Form
  !!kshowForm(!!mdsBR03)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!mdsCreateGeneralFromPS (!!mdsBR03, !name)

  -- End function
endfunction
