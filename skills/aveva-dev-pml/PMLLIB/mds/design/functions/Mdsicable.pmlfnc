--
-- File:		Mdsicable.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdscable.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIcable()

-- Reset Gadgets
  !!MdsCable.Name.val = 'unset'
  !!MdsCable.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsCable,'CABLE')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsCable.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsCable.view.active = false
      !!MdsCable.name.active = false
      return
    elsehandle none
      !!MdsCable.view.active = true
      !!MdsCable.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsCable)

-- Set the name gadget as the focus

  !!MdsCable.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsicable.pml
