--   Type:		Initialisation Macro
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Aug 14
--
--
-- Description:
-- Form to add a comment to the Fabgen drawing
-- The :MDSComment uda of the datum atta is used to store the comment
--
--------------------------------------------------------------------------------

define function !!MdsIComm()

-- Initilise gadgets

  !!MdsComm.Name.val = 'unset'
  !Temp[1] = 'unset'
  !!MdsComm.Comment.val = !Temp

-- Lock text pane until a support is selected

  !!MdsComm.Comment.SetEditable(false)

endfunction

return

-- End of file Mdsicomm.pml
