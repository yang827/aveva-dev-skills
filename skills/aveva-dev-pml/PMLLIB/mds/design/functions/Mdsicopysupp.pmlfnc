--
-- Description:
-- Form to copy a support
--
--------------------------------------------------------------------------------

define function !!MdsICopySupp()

-- Initialise Variables and Gadgets

-- Clear ARRAY of Names
  !!Mdscopysupp.copynames.clear()

-- Set Gadget Values
  !!MdsCopySupp.Name.val = 'unset'
  !!MdsCopySupp.Nooff.val = '1'
  !!MdsCopySupp.Distance.val = 0

-- if the current element is a support then activate it

  !!MdsSilent = TRUE
  !CurrentSupportName = !!MdsGetSuppName(!!CE)
  !!MdsSilent.delete()

  if !CurrentSupportName.neq('ABORT') then
    !!MdsCopySupp.name.val = !CurrentSupportName
    !!MdsSelectSupp('COPY', 'NAME','VERBOSE')
  endif

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)


endfunction

return

-- End of file Mdsicopysupp.pml
