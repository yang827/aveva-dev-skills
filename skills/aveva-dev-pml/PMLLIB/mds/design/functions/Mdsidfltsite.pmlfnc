--
-- File:  Mdsidfltsite.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IDEFSITE
--
-- Author:  I.osborne
-- Created:  Tue Apr 29
--
--
-- Description:
-- Initialisation for default site creation form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIDfltSite()

  -- If this is a reentry into the application do not display the
  -- site creation form
  !save = !!mdsOptions.site.val


  ---------------------------------------------------------------------------------------------------
  ----<wd>--feb2006--<mds12>
  --
  --> The identification of what is a "MDS SUPPORT STRUCTURE", "PIPING", "HVAC" or "TRAY" zone
  --> -- is controlled by a default file called $!!mdsFILES.iD
  --> -- These zones will exist within the PDMS DESIGN database.
  --> --
  -->   !iDLines = !!readPDMSFile('/$!!mdsFILES.iD')
  -->   do !setID values !iDLines
  -->     !setIds = !setID.split('\')
  -->     if (match(!setIds[1].trim(),'MDSIDPIPE') gt 0) then
  -->       !!mdsIdPatt = !setIds[2]
  -->       !!mdsIdPval = !setIds[3]
  -->     elseif (match(!setIds[1].trim(),'MDSIDTRAY') gt 0) then
  -->       !!mdsIdTatt = !setIds[2]
  -->       !!mdsIdTval = !setIds[3]
  -->     elseif (match(!setIds[1].trim(),'MDSIDHVAC') gt 0) then
  -->       !!mdsIdHatt = !setIds[2]
  -->       !!mdsIdHval = !setIds[3]
  -->     elseif (match(!setIds[1].trim(),'MDSIDSUPP') gt 0) then
  -->       !!mdsIdSatt = !setIds[2]
  -->       !!mdsIdSval = !setIds[3]
  -->     endif
  -->   enddo
  --
  ---------------------------------------------------------------------------------------------------
  --
  -- The IDENTIFICATION of what is a "MDS SUPPORT STRUCTURE", "PIPING", "HVAC" or "TRAY" zone
  -- is controlled by the settings found in the PDMS PARAGON Catalogue Database
  -- CATA element /MDS/ZONEID/DEFAULTS
  -- This CATA element stores the MDS APPLICATION ZONE ID DEFAULTS "DATASET DATA" elements
  -- These zones MUST exist within the PDMS DESIGN database to enter the MDS Application
  --
  -- Determine the MDS ZONE ID Attributes and Values from the CATA element /MDS/ZONEID/DEFAULTS
  !mdszoneids  = object MDSZONEIDDEFS()
  !zoneidcheck = !mdszoneids.zoneidcheck
  -- ABORT Entry to the MDS Application and SWITCH to the "Design>General..." application
  -- when the returned variable !zoneidcheck is FALSE
  if (!zoneidcheck.not()) then
    !!appxload('DES','GEN', FALSE)
    !!alert.error(|ABORTING entry to the MDS DESIGN Application. All of the MDS ZONE ID default DATA elements DO NOT exist.|)
    return error 999
  endif
  --<wd>--feb2006--<mds12>
  ---------------------------------------------------------------------------------------------------


  -- Check for the existence of MDS SUPPORT STRUCTURE zones
  !zones = ARRAY()
  !sval = !!mdsIdSval.split(',')
  do !x values !sval
    !zones.appendarray(!!kCollectAllFor('ZONE', '$!!mdsIdSatt EQ |$!x|', =0/0))
    handle any
      --<wd>--feb2006--<mds12>
      --$M/%PDMSUI%/CLIB/FILES/UFORMS MAIN _CDSYSTEM
      !!appxload('DES','GEN', FALSE)
      --<wd>--feb2006--<mds12>
      !!alert.error('Unable to find uda $!!mdsIdSatt to find any suitable MDS SUPPORT STRUCTURE zones')
      return error 999
    endhandle
  enddo

  -- No appropriate MDS SUPPORT STRUCTURE zones found
  if (!zones.size() eq 0)then
    --<wd>--feb2006--<mds12>
    --$M/%PDMSUI%/CLIB/FILES/UFORMS MAIN _CDSYSTEM
    !!appxload('DES','GEN', FALSE)
    --<wd>--feb2006--<mds12>
    !!alert.error('Cannot find any suitable MDS SUPPORT STRUCTURE zones')
    return error 999
  endif

  !block = object BLOCK('after (!zones[!evalIndex].name, |/|)')
  !zoneNames = !zones.evaluate(!block)
  !zoneNames.unique()

  -- Check for Claim and DACS only if DACS is switched on
  !!mdsDacControl(TRUE)
  !zoneNew = ARRAY()
  !skipped = 0
  do !x values !zoneNames
    !name = /$!x
    handle any
      !skipped = !skipped + 1
      skip
    endhandle

    if !name.type.neq('ZONE') then
      !skipped = !skipped + 1
      skip
    endif

    if !name.owner.isNamed.not() then
      !skipped = !skipped + 1
      skip
    endif

    if !name.dBAccess.eq('UPDATE') then
      if !name.dBWrite then
        !zoneNew.append(!x)
      endif
    else
      !createTest = DACCRE STRU of $!name
      if !createTest then
        -- if (!!mdsComClaimDac(!name,'DACCRE','STRU')) then
        !zoneNew.append(!x)
      endif
    endif
  enddo
  !!mdsDacControl(FALSE)
  !zoneNames = !zoneNew

  !!mdsDefaultSite.site.dtext = !zoneNames

  if !skipped.neq(0) then
    !!alert.error('$!skipped zone/s have been found but are unnamed or their owning site is unnamed. These have been excluded from the selection list')
  endif

  if (!save neq |Not Set|) then
    !option = (after(!save, '/'))
    !!mdsDefaultSite.site.select('DTEXT', !option)
    handle any
      !!mdsOptions.site.val = 'Not Set'
    endhandle
    !!mdsOptions.site.val = !save
  else

    !!mdsDefaultSite.site.val = 1
      handle any
-- No appropriate support zones found to write to
        !!alert.error('Cannot find any suitable MDS SUPPORT STRUCTURE zones to write to')
        return error 999
      endhandle
  endif


---------------------------------------------------------------------------------------------------
-- Check the existence of MDS HANGER zones

-- If this is a reentry into the application do not display the
-- site creation form

  !save = !!mdsOptions.siteForHangers.val
  !zones = ARRAY()
  !sval = !!mdsIdHangval.split(',')
  handle (2,751)
  elsehandle NONE
    do !x values !sval
     !zones.appendarray(!!kCollectAllFor('ZONE', '$!!MDSIDHANGATT EQ |$!x| and acttype eq |ZONE|', =0/0))
      handle any
      endhandle
    enddo

  endhandle

  !block = object BLOCK('after (!zones[!evalIndex].name, |/|)')
  !zoneNames = !zones.evaluate(!block)
  !zoneNames.unique()

-- Check for Claim and DACS only if DACS is switched on
  !!mdsDacControl(TRUE)
  !zoneNew = ARRAY()
  !skipped = 0
  do !x values !zoneNames
    !name = /$!x
    handle any
      !skipped = !skipped + 1
      skip
    endhandle
    if !name.type.neq('ZONE') then
     !skipped = !skipped + 1
     skip
    endif

    if !name.dBAccess.eq('UPDATE') then
      if !name.dBWrite then
        !zoneNew.append(!x)
      endif
    else
      !createTest = DACCRE STRU of $!name
      if !createTest then
        !zoneNew.append(!x)
      endif
    endif
  enddo
  !!mdsDacControl(FALSE)
  !zoneNames = !zoneNew

  !!mdsDefaultSite.siteForHangers.dtext = !zoneNames

  if !skipped.neq(0) then
    !!alert.error('$!skipped hanger zone/s have been found but are unnamed. These have been excluded from the selection list')
  endif

  -- if site for hangers was set, select it in the list
  if (!save neq |Not Set|) then
    !option = (after(!save, '/'))
    !!mdsDefaultSite.siteForHangers.select('DTEXT', !option)
      handle any
        !!mdsOptions.siteForHangers.val = 'Not Set'
      endhandle
     !!mdsOptions.siteForHangers.val = !save
  endif
  -- do not force the user to choose any hanger site if not set

  -- Show Form
  !!kShowForm(!!mdsDefaultSite)

endfunction
