----------------------------------------------------------------------
-- File:    Mdsifh01.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- Initialisation for form Fh01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsiFH01(!modify is STRING, !textName is STRING,!styp is STRING)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '!!mdsiFH01($!modify is STRING, $!textName is STRING,$!styp is STRING)')
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  !mdsModeFhShown = !!mdsModFH.shown()

  if !!mdsFH01.shown() then
    if (!mdsModeFhShown) then
      -- The user asked to change the hanger type
      -- hide the form
      !!mdsFH01.hide()
    else
      !!alert.error('Unable to show form as it is already displayed')
      golabel /ERROR
    endif
  endif

  -- Init Variables etc...
  !attaName = '/' & !textName
  !callingForm = !!mdsFHanger
  !title = 'Fixed Hanger'
  !initForm = |!!$!callingForm| + |.sitecheck('FH')|
  if (!styp.upcase().match('VH') gt 0) then
    !title = 'Variable Hanger'
    !initForm = |!!$!callingForm| + |.sitecheck('VH')|
  endif

  -- Initialise Variables
  !name = '/' & !textName
  !attaName = '/' & !textName
  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFH01.datum.active = TRUE
  !!mdsFH01.bdist.active = FALSE
  !!mdsFH01.dist.active = FALSE
  !!mdsFH01.bthro.active = FALSE
  !!mdsFH01.select.active = FALSE
  !!mdsFH01.cancel.active = TRUE
  !!mdsFH01.bedplate.active = TRUE
  !!mdsFH01.setmat.active = TRUE

  -- Icons Row 2
  !!mdsFH01.rotate.active = FALSE
  !!mdsFH01.rotAtt.active = FALSE

  -- Icons Row 3
  !!mdsFH01.modatta.active = FALSE
  !!mdsFH01.viewStd.active = TRUE

  -- Icons Row 4
  !!mdsFH01.dim.active = FALSE
  !!mdsFH01.mdsadp.active = FALSE
  !!mdsFH01.zoom.active = FALSE
  !!mdsFH01.adploc.active = FALSE

  -- Icons Row 5
  !!mdsFH01.reconnect.active = FALSE

  -- Get the config number so we can set the offset coordinate icon availability
  !!mdsDynOffset.offsety.val = 0
  !!mdsDynOffset.offsetx.val = 0
  !!mdsDynOffset.angley.val = 0
  !!mdsDynOffset.anglex.val = 0

  if !modify.upcase().eq('MODIFY') then
    !configNumber = !attaName.dbref().:MdsHconfig.replace('H','').replace('V','').real()
  else
    !configNumber = !!mdsFHanger.configNumber
    -- check for connection to stwall
    !!mdsFH01.hangertypes.stwallconn = !!mdsFHanger.formhangertypes.stwallconn
  endif

  !!mdsFH01.dynOffset.active = FALSE

  if (!modify.upcase() neq 'MODIFY')then

    ----------------------
    -- Create a NEW HANGER
    ----------------------

    -- Create mode
    -- Form members

    !!mdsFH01.graphicaldim = FALSE

    -- Create Support object
    !support = object MDSSUPPORT()
    !support.position  = FALSE
    !support.mirror    = FALSE
    !support.rotateCur = FALSE
    !support.handedCur = FALSE
    !support.rotated   = 0
    !support.bPNum     = 1
    !support.alias     = !styp
    !support.modify = FALSE

    --<sk> 06/06/2012
    -- check if support with given name exists already (can be preliminary support)

    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle

    --<sk> 06/06/2012
    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !!mdsFH01.support = !support

    -- Set callback on cancel button and set mode member of support object
    !!mdsFH01.cancel.callback = |!this.cancelHanger(TRUE)|
    if(define(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Set !!mdsFH01.cancel.callback to ''$!!mdsFH01.cancel.callback''')
    endif

    -- Set Paragraph gadget on form
    !!mdsFH01.name.val = !callingForm.name.val
    !!mdsFH01.dist.val = 0
    !!mdsFH01.p.val = ''
    !!mdsFH01.datum.active = TRUE

    --      if(!callingForm.tubeRef.set() and !callingForm.beamRef.set()) then
    -- tube and beam have been selected when filter was activated
    -- Call the same callback function as in !!mdsFH01 but the calling form is different
    if (define(!!mdsDebug)) then
      !!mdsDebug.trace(1, '$!callingForm has tubeRef set to $!callingForm.tubeRef and beamRef set to $!callingForm.beamRef')
    endif

    if !!mdsfh01.support.preliminaryStore.set() then
		!!mdsFH01.support.datum = !datum
    endif

    !oRest = object MDSREST(!styp)
    !oRest.mode = 'CREATE'

    !!mdsFH01.support.rest = !oRest
    !oRest.create(!!mdsFH01,!callingForm)
    handle 99
      -- user has exited by pressing the ESC key
      -- delete the hanger and all associated elements including atta
      -- Do not issue a confirm prompt
      !!mdsFH01.cancelHanger(FALSE)
      !!kRestoreUnits(!currentUnits)
      return
    elsehandle ANY
      -- delete the hanger and all associated elements including atta
      -- Don't issue a confirm prompt
        !!alert.message(!!error.text + ' ' + !!error.line.before('***'))
        !!mdsFH01.cancelHanger(FALSE)
        !!kRestoreUnits(!currentUnits)
        return
    endhandle
    !attaName = !oRest.attaRef.name
    handle (2,754)
      !!mdsFH01.cancelHanger(FALSE)
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    !support.datum = !oRest.attaRef
    !support.atta.append(!oRest.attaRef)
    !support.rest = !oRest
    !!mdsFH01.support = !support
    --<<< replaced by <ab> 5th June 2002

    -- Save the last activated filter
    !callingForm.lastActivatedFilter = !callingForm.oRadio.activeIndex
    -- Save the last activated flow mode
    !callingForm.lastActivatedToggle = !callingForm.oMenuRadio.names[!callingForm.oMenuRadio.activeIndex]
    -- Save the last selected tube
    !callingForm.lastActivatedTubeRef = !callingForm.tubeRef
    -- Save the last activated flow mode
    !callingForm.lastActivatedBeamRef = !callingForm.beamRef

    if(define(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Save the last activated filter ' + '$!callingForm.lastActivatedFilter')
      !!mdsDebug.trace(2, 'Save the last action mode ' + '$!callingForm.lastActivatedToggle')
    endif

    if(!callingForm.filterMode.selected('Multi-Create')) then
      -- Do not hide the calling form
      -- The use can select a new set of tube and beam for the same current filter group

      !!mdsFH01.accept(!callingForm)
      !callingForm.activateFilter(!callingForm.oRadio.activeIndex, TRUE, TRUE)
      !callingForm.name.val = 'unset'
      !!mdsAutoName.getNextName(!callingForm)
    elseif(!callingForm.filterMode.selected('Create and Modify')) then
      -- Hide the calling form
      -- Enable the user to modify the newly created hanger
      !callingForm.hide()
      -- Deactivate the create button from the !!mdsFH01 form
      !!kShowForm(!!mdsFH01)

      -- Tests to see if the hanger pos is fixed or non fixed
      -- Fixed displays the interface form
      -- Non fixed allows positioning

      !!mdsFH01.setGadgets()
    !callingForm.name.val = 'unset'
    !!mdsFH01.datum.active = FALSE
    !reconnected = FALSE
    !attaName = '/' + !!mdsFH01.name.val
    !attaRef = !attaName.dbref()
    handle ANY
      return
    endhandle

      !!mdsFH01.support.tdir = tdir of $!attaName/H1 wrt /*

    -- >>> dtf mod to set tdir D if with tolerance
    !temptdir = tdir of $!attaName/H1 wrt /*
    if !temptdir.angle(D).lt(1.5) and !temptdir.angle(D).gt(-1.5) then
      !!mdsFH01.support.tdir = D wrt /*
      !hangna = !attaName & '/H1'
      !hangdbref = !hangna.dbref()
      !hangdbref.tdir = D
    endif
    -- <<< dtf end of mod
    !!mdsFH01.support.tposition = tposition of $!attaName/H1 wrt /*

    golabel /MODIFYMODE

  else
    -- Reinitialize calling form
    -- The user can activate another filter
    -- Updating the callingform hangers list
    !callingFormShown = !callingForm.shown()
    !callingForm.hide()
    $!initForm

    -- if the form was shown, leave it shown, otherwise hide it.
    if(not !callingFormShown) then
      !callingForm.hide()
    endif

    golabel /CONT

  endif

  -- <RM> 02/02/07 -- i put this endif in after not being able to use modify mode
  -- i formatted the file properly and it seems the endif is missing from here i'm
  -- not sure its in the correct place but everything seems to work at the moment
  --endif
  -- <RM> 02/02/07 -- end of fix

  -------------------------------------
  -- End of create mode handling
  -------------------------------------

else $* its modify mode
  -----------------------------
  -- Modify an EXISTING  HANGER
  -----------------------------
  -- modify mode
  if(define(!!mdsDebug)) then
    !!mdsDebug.trace(1, 'Modify Mode')
  endif

  if(not !!mdsFH01.support.rest.set()) then
    !!mdsFH01.support.rest
  endif
  -- Updating the callingform hangers list
  !callingFormShown = !callingForm.shown()
  !callingForm.hide()
  -- update the list of available hanger types for the current alias ('VH' or 'FH')
  -- The following command will show the form and therefore call the init function as well
  -- This will populate the form with the correct types of hangers.
  $!initForm
  -- if the form was shown, leave it shown, otherwise hide it.
  if(not !callingFormShown) then
    !callingForm.hide()
  endif

  !attaName = !name
  !attaRef = !attaName.dbref()

  !reconnected = FALSE

  !suppobject = FALSE

  if !!mdsFH01.support.datum.badref().not() then
    if(!!mdsFH01.support.set() and !!mdsFH01.support.datum.set() and !!mdsFH01.support.datum.name.set() and !!mdsFH01.support.datum.name eq !attaName) then
      handle ANY
        !suppobject = FALSE
      elsehandle NONE
        -- The current form support object is of the current support
        -- no need to create a new support object
        !support = !!mdsFH01.support
        !support.alias     = !styp
        -- save the restraint reconnect flag
        !reconnected = !support.rest.reconnected
        !suppobject = TRUE
      endhandle
    endif
  else
    !suppobject = FALSE
  endif

  if !suppobject.not() then
    -- The current form support object is of the another support
    -- create new support. otherwise we might get the support of a previous hanger
    !support = object MDSSUPPORT()
    !support.position  = TRUE
    !support.mirror    = FALSE
    !support.rotateCur = FALSE
    !support.handedCur = FALSE
    !support.rotated   = 0
    !support.bPNum     = 1
    !support.modify = TRUE
    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!attaRef)
    -- Store Atta reference's in object
    !support.atta.append(!attaRef)
    !support.atta.unique()
    -- goto atta
    !support.datum  = !attaRef
    !!ce = !attaRef
    !support.padir  = Pa Dir wrt world
    !support.plDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.alias     = !styp
    -- Form members
    !!mdsFH01.graphicaldim = FALSE
  endif

  !restName = !attaName + '/REST'

  if(!!mdsFH01.support.rest.ref.set() and (not !!mdsFH01.support.rest.ref.badref()) and !!mdsFH01.support.rest.ref.name.eq(!restName)) then
    -- current Mdsrest object belongs to the current rest
    -- keep the same Mdsrest object
  else
    -- current Mdsrest object belongs to the another rest or is unset
    -- create a new Mdsrest object
    !support.rest = object MDSREST(!restName.dbref(),FALSE)
  endif

  -- set the connection object for using :mdsancref
  !support.plateconns = object MDSBPLATECONN(!support)

  -- Set callback on cancel button and set mode member of support object
  !!mdsFH01.cancel.callback = |!this.restoreHanger(TRUE, TRUE)|
  if(define(!!mdsDebug)) then
    !!mdsDebug.trace(2, 'Set !!mdsFH01.cancel.callback to ''$!!mdsFH01.cancel.callback''')
  endif

  !!mdsFH01.datum.active = FALSE
  !!mdsFH01.name.val = !support.datum.name
  -- Store support object in form
  !!mdsFH01.support = !support
  !!kShowForm(!!mdsFH01)

  var !configtype :MDSHConfig of $!attaName

  -- Put the tail direction/position in the support object
  !!mdsFH01.support.tdir = tdir of $!attaName/H1 wrt /*
  !!mdsFH01.support.tposition = tposition of $!attaName/H1 wrt /*
  var !hhtohtdir constr dir hh of $!attaName/H1 to ht of $!attaName/H1
  !!mdsFH01.support.headToTaildir = !hhtohtdir.direction()

  -- >>> dtf mod to set tdir D if with tolerance
  !temptdir = tdir of $!attaName/H1 wrt /*
  if !temptdir.angle(D).lt(1.5) and !temptdir.angle(D).gt(-1.5) then
    !!mdsFH01.support.tdir = D wrt /*
    !hangna = !attaName & '/H1'
    !hangdbref = !hangna.dbref()
    !hangdbref.tdir = D
  endif
  -- <<< end of mod

  !attadirs = !!mdsremovegrad(!attaName.dbref())
  !dir = !attaName.dbref().cref.tdir.wrt( /* )

  if !configtype inset ('7H','20H','21H','25H','7V','20V','21V','25V') then
    if ( !dir.angle(!attadirs[1]).lt(.1) and !dir.angle(!attadirs[1]).gt(-.1) ) or ( !dir.angle(!attadirs[1]).gt(179.9) and !dir.angle(!attadirs[1]).lt(180.1)) then
      -- Pipe and support direction parallel dynamic
    else
      -- Generate the two offset directions
      !!mdsSetOffsetDir(!attaName.dbref())
    endif
  endif

  -- if sloping pipe
  !!ce = !attaName.dbref()
  !gradient = !attaName.dbref().ldir
  if ( !dir.angle(!attadirs[1]).lt(.1) and !dir.angle(!attadirs[1]).gt(-.1) ) or ( !dir.angle(!attadirs[1]).gt(179.9) and !dir.angle(!attadirs[1]).lt(180.1)) then
    -- Pipe and support direction parallel dynamic
  else
    if !gradient.up.eq(0) then

      -- Horizontal line
      -- Test to see if pipe parallel to wall / floor etc
      !paralleltest = !!mdsgetmovedir(!!ce,'MODIFY')
      if !paralleltest[1].not() and !paralleltest[3].nint().neq(90) then
        -- if not parallel we may need to move clamp along pipe
        --if !attaName.dbref().cref.:mdsdynoffy.eq(0) then
        !!mdsModAttaPos(!!ce,'MODIFY')
        --endif
      endif
    endif
  endif

  if !configtype inset ('7H','20H','21H','25H','7V','20V','21V','25V') then
    -- initialise the dynoffset form to default the values
    if !attaName.dbref().cref.:mdsdynoffset.neq(0) or !attaName.dbref().cref.:mdsdynoffy.neq(0) then
      !!mdsDynOffset.init(!!mdsFH01)
      hide !!mdsDynOffset
    endif
  endif

  golabel /MODIFYMODE

  -------------------------------------
  -- End of modify mode handling
  -------------------------------------
endif

LABEL /CONT

-- Show rotate icon for manufacturers vertical hangers

if !attaName.dbref().styp.eq('MH01') then
  if !attaName.dbref().ldir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('U WRT /*') or !attaName.dbref().ldir.wrt(/* ).string().eq('Z WRT /*') or !attaName.dbref().adir.wrt(/* ).string().eq('Z WRT /*') then
    if !attaName.dbref().cref.owner.members.size().eq(2) then
      !!mdsFH01.rotAtt.active = TRUE
    elseif !attaName.dbref().cref.tdir.string().before(' WRT').eq('D') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('U') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('-Z') or !attaName.dbref().cref.tdir.string().before(' WRT').eq('Z') then
      !!mdsFH01.rotAtt.active = TRUE
    else
      !!mdsFH01.rotAtt.active = FALSE
    endif
  else
    if !attaName.dbref().cref.unset().not() then
      if !!mdsremovegrad(!attaName.dbref())[1].eq(!attaName.dbref().cref.tdir.opposite()) or !!mdsremovegrad(!attaName.dbref())[1].eq(!attaName.dbref().cref.tdir)then
        -- for dynamic riser clamp on horizontal line
        !!mdsFH01.rotAtt.active = TRUE
      else
        !!mdsFH01.rotAtt.active = FALSE
      endif
    endif
  endif
endif

if(define(!!mdsDebug)) then
  !!mdsDebug.trace(2, 'Label /CONT')
endif
-- Store support object in form
!!mdsFH01.support = !support

-- Redefine standard support name on form title
!index = !callingForm.standardRtexBackup.findfirst('$!styp')
if(!index.unset()) then
  -- Calling form has not be initialized
  -- Populate the form
  -- Updating the callingform hangers list
  !callingFormShown = !callingForm.shown()
  !callingForm.hide()
  handle ANY
  endhandle
  -- update the list of available hanger types for the current alias ('VH' or 'FH')
  -- The following command will show the form and therefore call the init function as well
  -- This will populate the form with the correct types of hangers.
  $!initForm
  -- if the form was shown, leave it shown, otherwise hide it.
  if(not !callingFormShown) then
    !callingForm.hide()
  endif
  !index = !callingForm.standardRtexBackup.findfirst('$!styp')
endif

!text  = !callingForm.standardDtexBackup[!index]
handle (2,756)
endhandle

!suppNumber = before(!text, '-')
!formName  = !suppNumber.trim()
!!mdsFH01.support.replace = !formName

call !!mdsSetFormName(!!mdsFH01, '$!title', '$!formName')

-- Store current form information
Call !!mdsStoreFh01()

-- Reset Units
!!kRestoreUnits(!currentUnits)
if(defined(!!mdsDebug)) then
  !!mdsDebug.traceOut(1, '!!mdsiFH01($!modify is STRING, $!textName is STRING,$!styp is STRING)')
endif

-- Detect if hang has a spring and if so display spring selection form, but not if created by manufacturers sw
--<GE> 08/01/07 Defect 10044
!!ce = !attaName.dbref()
--<GE> 08/01/07
!nameOfRest = !!ce.cref.owner
handle ANY
  !nameOfRest = !!ce.name & '/REST'
  !nameOfh1 = !!ce.name & '/H1'
  !!ce.cref = $!nameOfh1
endhandle
var !hangerMembers coll all hang mem for $!nameOfRest
var !hangerMembersTypes eval type for all from !hangerMembers
if !!ce.styp.eq('MH01') or !!ce.styp.eq('LI01') then
  -- do nothing
else
  if !hangerMembersTypes.find('VSPR').size().eq(1) then
    !!mdsIModFh(!!mdsFH01,!!mdsModFH, TRUE)
    !!mdsModFH.modifySpringType(1,TRUE)
    !!mdsModFH.hide()
  elseif !hangerMembersTypes.find('VSPR').size().eq(2) then
    !!mdsIModFh(!!mdsFH01,!!mdsModFH, TRUE)
    !!mdsModFH.modifySpringType(1,TRUE)
    !!mdsModFH.modifySpringType(2,TRUE)
    !!mdsModFH.cancel()
  endif
endif

  -- set appropriate MDS template interface buttons
  !!mdsFH01.rotate.active  = TRUE
  !!mdsFH01.modatta.active = TRUE
  !!mdsFH01.viewStd.active = TRUE
  !!mdsFH01.dim.active     = TRUE

-- If type is a civils, get the config number from the :mdshconfig uda
-- if the styp is set to MH01

-- !oHangerType = !!mdsAllHangertypes.gethangertype(!!ce.styp.upcase())
-- !group = !oHangerType.group

if !!ce.styp.eq('MH01') then
  !group = :MdsHconfig
  !group = !group.replace('H','')
  !group = !group.replace('V','')
else
  !group = '0'
endif

if (!group.real() inset('18','19','20','25')) then
  !!mdsFH01.bthro.active = TRUE
  !!mdsFH01.select.active = TRUE
  !!mdsFH01.bdist.active = TRUE
  !!mdsFH01.dist.active = TRUE
endif

do !loop from 1 to 9
  pin $!loop off
enddo

if !!mdsFHanger.configNumber.string() inset ('7','21') then

  -- Generate the two offset directions
  --dtf xxxxxxxxxxx
  !attadirs = !!mdsremovegrad(!attaName.dbref())
  !dir = !attaName.dbref().cref.tdir.wrt( /* )
  if ( !dir.angle(!attadirs[1]).lt(.1) and !dir.angle(!attadirs[1]).gt(-.1) ) or $
    ( !dir.angle(!attadirs[1]).gt(179.9) and !dir.angle(!attadirs[1]).lt(180.1)) then
    -- Pipe and support direction parallel dynamic
  else
    !!mdsSetOffsetDir($!attaName )
  endif
endif

return

label /MODIFYMODE

-- need to be extracted to a separate function file

if(define(!!mdsDebug)) then
  !!mdsDebug.trace(2, 'label /MODIFYMODE')
endif

!support = !!mdsFH01.setRestObject()
--><wd>17aug2009 -- DFN P-22111 (SI-13209) - Set the !!mdsVendor.steelMem FORM member etc...
if (!support.datum.:MDSHConfig.unset() or !support.datum.:MDSHConfig.trim().eq('')) then
  !exist = !!ce
  !!ce = !support.datum
  !!ce.:MDSHConfig = !!mdsVendor.hangerSelType.val
  !!ce = !exist
endif
!!mdsVendor.steelMem = !support.rest.beamRefArray
!!mdsFH01.support.rest.beamRefArray = !support.rest.beamRefArray

--><wd>17aug2009 -- DFN P-22111 (SI-13209)
!support = !!mdsFH01.setSupportPacks()

--21/06/02      !support = !!mdsFH01.setSupportPacks()
-- restore the rest reconnected flag
!support.rest.reconnected = !reconnected
!support.rest.mode = 'MODIFY'

-- Set Form Gadgets
!!mdsFH01.name.val = !attaName.after('/')
!!mdsFH01.p.val    = ''
!!mdsAddAll('$!textName')

-- Activates /Deactivates the !!mdsFH01 form gadgets
!!ce = !attaRef
!group = !!ce.:MDSHconfig
!!mdsFH01.setGadgets()
-- Set distance gadget
!!mdsDistance(!!mdsFH01)

--<wd>22jul2004
--><wd>19aug2009 -- DFN P-22111 (SI-13209) -- Added type Hanger Type '32V' to list 'inset'
--if (!!mdsVendor.hangerSelType.val inset ('1V','2V','31V')) then
if (!!mdsVendor.hangerSelType.val inset ('1V','2V','31V', '32V')) or (!support.datum.:MDSHConfig inset ('1V','2V','31V', '32V'))then
  --<<wd>19aug2009 -- DFN P-22111 (SI-13209)
  -- ACTIVATE the DISTANCE and THROUGH Gadgets when ConfigNumber = 1
  !!mdsFH01.bthro.active  = TRUE
  !!mdsFH01.select.active = TRUE
  !!mdsFH01.bdist.active  = TRUE
  !!mdsFH01.dist.active   = TRUE
endif
--<wd>22jul2004

if (!!mdsVendor.hangerSelType.val inset('18V','19V','20V','25V','18H','19H','20H','25H')) then
  !!mdsFH01.bthro.active = TRUE
  !!mdsFH01.select.active = TRUE
  !!mdsFH01.bdist.active = TRUE
  !!mdsFH01.dist.active = TRUE
endif

------------------------------------------------------------------------
-- Add marker text markers
!!mdsAidText(!!mdsFH01)
!hangerStart = !!mdsFH01.support.datum.position
!hangerEnd   = !!mdsFH01.support.tposition
aid clear line 2999
handle ANY
endhandle
aid line number 2999 $!hangerStart to $!hangerEnd linestyle dotted

-- Put members into repre member of form
!colourList = ARRAY()

do !addrepre values !!mdsFH01.support.atta
  !!ce = !addrepre
  skip if (match(Name,'SREF') gt 0)
  !colour = !!kFindDrawColour(!!ce)
  !branName = !!ce.owner.string()
  !!mdsFH01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
  -- Add to model at level set by !!mdsOptions.levChange value
  Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
  !colourList.append(!!ce.name.dbref())
enddo
!colourList.append(!!mdsFH01.support.rest.name.dbref())
Call !!kEnhanceList(!colourList)
!!ce = !support.datum
-- Saving hanger state to be able to restore it later
!!mdsSaveHangerState(!!mdsFH01)
golabel /CONT

label /ERROR
!!kRestoreUnits(!currentUnits)

if(defined(!!mdsDebug)) then
  !!mdsDebug.traceError('!!mdsiFH01($!modify is STRING, $!textName is STRING,$!styp is STRING)')
endif

endfunction
