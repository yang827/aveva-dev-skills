--
-- File:    Mdsifhanger.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MdsIHANGER
--
-- Author:    A.Boudjnah
-- Created:   Wed March 20 2002
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for mdsFHanger.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsiFHanger()

  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceIn(1, '!!mdsiFHanger()')
  endif

  !currentunits = !!kgetsetunits()
  units mm bore mm dist

  !!mdsFHanger.name.val = 'unset'
  !!mdsFHanger.ok.active = FALSE

  if(!!mdsFHanger.tubeRef.set() and (not !!mdsFHanger.tubeRef.badref())) then
    !toUnEnhance = !!mdsFHanger.tubeRef
    unenhance pipe of $!toUnEnhance
  endif

  !!mdsFHanger.tubeRef = object DBREF()

  if(!!mdsFHanger.beamRef.set() and !!mdsFHanger.beamRef.size() gt 0) then
    -- un enhance previous beams
    do !beamToUnEnhance values !!mdsFHanger.beamRef
      if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
        unenhance $!beamToUnEnhance
      endif
    enddo
  endif

  !!mdsFHanger.beamRef = ARRAY()
  -- Reactivate the 'ALL' button
  !!mdsFHanger.oRadio.toggleDefaultRadioOn()


  !!mdsFHanger.filterData.val = 'No Filter'
  -- Do not populate list
  !populateList = FALSE
  if(not defined(!!mdsAllHangerTypes)) then
    -- Create a hanger type container containing all available hanger types
    !prompt = 'Loading Hangers Configurations. Please Wait...'
    prompt '$!prompt'
    !!mdsAllHangerTypes = object MDSHANGERTYPES(TRUE)
    -- loads the DES-SUPP-HANG file
    -- Populate list
    !populateList = TRUE
  endif
  -- set the form variable member to point to that container
  -- Read defaults file to load selections
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.trace(1, 'Hanger Category is: $!!mdsFHanger.hangerCategory')
  endif

  if(!!mdsFHanger.hangerCategory.eq('FH'))then
    --    if(not defined(!!mdsstandardFHDtext)) then
    --if(not defined(!!mdsstandardFHDtext) or !populateList) then
    !prompt = 'Loading Fixed Hangers Configurations. Please Wait...'
    prompt '$!prompt'
    !!mdsFHanger.standard.dtext = ARRAY()
    !!mdsFHanger.standard.rtext = ARRAY()
    !!mdsPopulate(!!mdsFHanger,'FIXED HANGER')
    --!!mdsstandardFHDtext = !!mdsFHanger.standard.dtext
    --!!mdsstandardFHRtext = !!mdsFHanger.standard.rtext
    --endif
    !!mdsFHanger.standardDtexBackup = !!mdsFHanger.standard.dtext
    !!mdsFHanger.standardRtexBackup = !!mdsFHanger.standard.rtext
    -- get a filtered hanger type container object containing only variable hangers ('FH')
    !!mdsFHanger.formHangerTypes = !!mdsAllHangerTypes.getHangersForCategory('FH')
    handle ANY
      !!alert.error('No Hanger templates for Fixed hangers')
    endhandle
    !!mdsFHanger.formtitle    = |Fixed Hangers using MDS Interface|
  elseif(!!mdsFHanger.hangerCategory.eq('VH'))then
    --    if(not defined(!!mdsstandardVHDtext)) then
    --if(not defined(!!mdsstandardVHDtext) or !populateList) then
    !prompt = 'Loading Variable Hangers Configurations. Please Wait...'
    prompt '$!prompt'
    !!mdsFHanger.standard.dtext = ARRAY()
    !!mdsFHanger.standard.rtext = ARRAY()
    !!mdsPopulate(!!mdsFHanger,'VARIABLE HANGER')
    --!!mdsstandardVHDtext = !!mdsFHanger.standard.dtext
    --!!mdsstandardVHRtext = !!mdsFHanger.standard.rtext
    --endif
    --!!mdsFHanger.standardDtexBackup = !!mdsstandardVHDtext
    --!!mdsFHanger.standardRtexBackup = !!mdsstandardVHRtext
    !!mdsFHanger.standardDtexBackup = !!mdsFHanger.standard.dtext
    !!mdsFHanger.standardRtexBackup = !!mdsFHanger.standard.rtext
    -- get a filtered hanger type container object containing only variable hangers ('VH')
    !!mdsFHanger.formHangerTypes = !!mdsAllHangerTypes.getHangersForCategory('VH')
    handle ANY
      !!alert.error('No Hanger templates for Variable hangers')
    endhandle
    !!mdsFHanger.formtitle    = |Variable Hangers using MDS Interface|
  else
    !!alert.error('Hanger Category: $!!mdsFHanger.hangerCategory is unknown')
    !!kRestoreUnits(!currentunits)
    if(defined(!!mdsDEBUG))then

      !!mdsDEBUG.traceError(1, 'Hanger Category: $!!mdsFHanger.hangerCategory is unknown')
    endif
    return
  endif
  !prompt = 'Creating a List of Variable Hangers Configurations. Please Wait...'
  prompt '$!prompt'
  -- Activate the default filter (e.g. 'ALL')
  -- test 24/5/02 !!mdsFHanger.activateFilter(!!mdsFHanger.oRadio.defaultOn)
  -- re-added by <ab> 27/05/02

  !!mdsFHanger.activateFilter(!!mdsFHanger.oRadio.defaultOn, TRUE, TRUE)
  prompt ''
  ----- Read defaults file to load selections

  -- Check to see if all the standard for this type have been commented out
  !unusedCheckVal = !!mdsFHanger.standard.dtext[1]
  handle (61,567) (61,615)
    !!mdsFHanger.view.active = FALSE
    !!mdsFHanger.name.active = FALSE
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE
    !!mdsFHanger.view.active = TRUE
    !!mdsFHanger.name.active = TRUE
  endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!mdsSetSupp(!!mdsFHanger)

  -- Set the name gadget as the focus

  !!mdsFHanger.name.setFocus()
  -- Reset the DAC global variable in case it has been left set to true

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceOut(1, '!!mdsiFHanger()')
  endif

  !!mdsFHanger.manifactions()
  --<wd>24aug2004 - Deactivate .filt6 icon
  !!mdsFHanger.filt6.active = FALSE
  !!mdsFHanger.filt6.val    = FALSE
  --<wd>24aug2004

  -- End function
endfunction
