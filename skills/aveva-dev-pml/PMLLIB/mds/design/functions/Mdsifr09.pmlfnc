--------------------------------------------------------------------------------
--
-- File:		MdsiFR09.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS127
--
-- Author:		T.Martin
-- Created:		23/02/2004 16:39
--
--
-- Description:
-- Initialisation for form FR09
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFR09(!Modify is string, !TextName is string, !Alias is string)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsFR09.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsFR09.Datum.Active = true
    !!MdsFR09.Cancel.active = true

  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    !!mdsfr09.bardims = ARRAY()

    -- deactivate unwanted buttons
    !!mdsfr09.AddPipe.active        = false
    !!mdsfr09.AddHVAC.active        = false
    !!mdsfr09.AddBar.active         = false
    !!mdsfr09.Flip.active           = false
    !!mdsfr09.Hand.active           = false
    !!mdsfr09.AlignSup.active       = false
    !!mdsfr09.ModSctn.active        = false
    !!mdsfr09.AddPack.active        = false
    !!mdsfr09.DelPack.active        = false
    !!mdsfr09.Rotate.active         = false
    !!mdsfr09.RotAtt.active         = false
    !!mdsfr09.Newdat.active         = false
    !!mdsfr09.Bedplate.active       = false
    !!mdsfr09.Associate.active      = false
    !!mdsfr09.ViewAssociate.active  = false
    !!mdsfr09.FlipFw.active         = false
    !!mdsfr09.ModAtta.active        = false
    !!mdsfr09.Spool.active          = false
    !!mdsfr09.copylike.active       = false
    !!mdsfr09.connect.active        = TRUE
    !!mdsfr09.modify.active         = false
    !!mdsfr09.forcecon.active       = false
    !!mdsfr09.disconn.active        = false
    !!mdsfr09.Mdsadp.active         = false
    !!mdsfr09.trimmer.active        = false
    !!mdsfr09.ancmat.active         = false
    !!mdsfr09.anccopy.active        = false
    !!mdsfr09.ancnudge.active       = false
    !!mdsfr09.setlen.active         = false
    !!mdsfr09.trunmat.active        = false
    !!mdsfr09.reconnect.active      = false
    !!MdsFR09.sspkbrk               = TRUE

    if (!Modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR09.Cancel.callback = |Call !!MdsCancelSupp(!!MdsFR09)|
      !Support.Modify = false


     !!mdsfr09.bardims  = ARRAY()
     !!mdsfr09.barsides = ARRAY()

    -- Initialise variables for new supports

      !Support.Replace = !!MdsCable.Replacement
      !Support.Type    = !!MdsCable.standard.selection('Rtext')
      !StruName        = !!MdsCable.Name.Val

    -- Navigate to correct area
      if (!!MdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsDacControl(true)

    -- Create Stru
      NEW STRU /$!StruName
      !Support.Stru = !!CE
      :MDSSuppType |$!Support.Type|

    -- Set Paragraph gadget on form
      !!MdsFR09.Name.Val = !StruName

      !!mdsfr09.nposts.val  = '1'
      !!mdsfr09.upoffs.val  = 200
      !!mdsfr09.lowoffs.val = 200

      do !i from 1 to 20
        !!MdsFR09.Dim$!<i>.Val = 0
      enddo

      do !i from 1 to 20
        !!MdsFR09.Dim$!<i>.active = FALSE
      enddo

      !!MdsFR09.Dist.Val = 0
      !!MdsFR09.P.Val = ''
      !!mdsfr09.l2.val = 300
      !!mdsfr09.l3.val = 300
      !!mdsfr09.nbars.val = 1

      !!mdsfr09.sense.val = 1
      !!mdsfr09.postoffset.val = 0

      !!MdsCable.Hide()


    ------------------------------**** Connexions *****---------------------------
     -- in create mode have all three
        !!MdsFR09.CreateByDim.Active = true
    ------------------------------------------------------------------------------

    else  $* its modify mode

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR09.Cancel.callback = |Call !!MdsRestoreForm(!!MdsFR09)|
      !Support.Modify = true
      !!MdsFR09.Datum.Active = FALSE
      !!MdsFR09.Cancel.active = FALSE

    -- Initialise variables for existing supports
      !DatumName = !Name & '/DATUM'
      !Sref      = !Name & '/SREF'

    -- Store Data in support object
      !Support.Type     = '$!Alias'
      !Support.position = true
      !Support.Datum    = !DatumName.dbref()
        handle (2,109)
          !!Alert.error('Support Datum does not exist')
          unenhance all
          !!MdsModifySupp.Cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !Support.Stru = !Name.dbref()

      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!Mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif

      -- Store Atta reference's in object
      !Support.Atta.append(!DatumName.dbref())
      !Support.Atta.append(!Sref.dbref())

      -- Navigate to existing support datum
      !!CE = !Support.Datum
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.P10Dir = P10 Dir wrt world
      !Support.P11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 04 from :MDSCp1 on datum atta
      !Data = !!CE.:MDSCp1
      !Split = split(!Data, ';')
      !Support.Config = !Split[1].real()
      if (!Split[2] eq |T|)then
        !Support.RotateCur = TRUE
      else
        !Support.RotateCur = FALSE
      endif
      if (!Split[3] eq |T|)then
        !Support.HandedCur = TRUE
      else
        !Support.HandedCur = FALSE
      endif
      !Support.Rotated = !Split[4].real()
      if (!Split[5] eq |T|)then
        !Support.Mirror = TRUE
      else
        !Support.Mirror = FALSE
      endif

      -- Get number of existing crossbars
      !!CE  = !Support.Stru
      !Bars = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!CE)

      if (!Bars.size().gt(0))then
        do !I indices !Bars
          !!CE = !Bars[!I]
          var !Ref :MDSAttaRef
          !Split = split(!Ref)

          !References = array()
          do !index indices !Split
            !References.append(!Split[!index].dbref())
            handle(2,107) (2,813)
              -- Atta has been manually deleted
            endhandle
          enddo

        -- Store Data in support object
          !Support.Bars[!I] = !References
        enddo

      endif

      -- Get length of existing crossbars
      do !V values !Bars
        !Length = deri length of $!V
        !Support.Barlen.append(!Length)
      enddo

      -- Store section name and matref for each member

      !StoreMat = array()
      !StoreMat = !!MdsStoreMat(!Name)
      !Support.Material = !StoreMat

      -- Get bedplate references if set
      !!CE  = !Support.Stru
      var !BPRef1 :MDSBpref1
      var !BPRef2 :MDSBpref2
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
      endif
      if (!!CE.:MDSBpref2.badref().not()) then
        !Support.BedPlate2 = !BPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!MdsFR09.Name.Val = !Name
      !!MdsFR09.P.Val    = ''

      !!MdsAddAll('$!TextName')

------------------------------ ***** Connexions --------------------

      !Vert1 = !Name & '-V1'
      !Vertdbref[1] = !Vert1.dbref()
      !conn1 = !Vertdbref[1].:MDSConn
      !Support.Connections[1] = !Conn1

      -- set the connection object for using :mdsancref
      !support.plateconns = object mdsBPlateConn(!support)

    -- set support object for joints
    !Support.Joints = !!MdsGetJoints(!Vertdbref)


-------------------------------------------------------------------

  endif

  -- Store support object in form
    !!MdsFR09.Support = !Support

  -- Store Current representations in form for use later
    var !Repre repre level
    !!MdsFR09.repre.clear()
    !!MdsFR09.repre.append(|Call !!KRepreLevel(Nulref, '', $!Repre,0)|)
    var !Repre repre level pipe
    !!MdsFR09.repre.append(|Call !!KRepreLevel(Nulref, 'PIPE', $!Repre,0)|)
    var !Repre repre level nozz
    !!MdsFR09.repre.append(|Call !!KRepreLevel(Nulref, 'NOZZ', $!Repre,0)|)
    var !Repre repre level stru
    !!MdsFR09.repre.append(|Call !!KRepreLevel(Nulref, 'STRU', $!Repre,0)|)

  -- Collect all supports for frame type 4 or alias

    !!CE = /MDS/FRAMES/FR09
      handle (2,109)
        !!Alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!Modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle

  -- Generate Steel Size List

    !Dtext = array()
    !Rtext = array()
    !!MdsSetSteel.init('HIDE',!!MdsFR09,'-V1','-V1')

    !!CE = !Support.Stru

    if (!Modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!MdsFR09,'-BAR-1','-V1')
      !!MdsSetSteel.init('HIDE',!!MdsFR09,'-BAR-1','-V1')

      !!CE = !!MdsFR09.Support.Datum

    -- Set distance gadget

      !!MdsDistance(!!MdsFR09)

    -- Add marker text markers

      VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

      do !COUNT FROM 211 TO 259

        VAR !NUM ($!COUNT - 210)
        !AttaName = !Name & '.' & !Num
        !!CE = !AttaName.dbref()
          handle ANY
            SKIP
          endhandle

      -- Store Atta reference in form
        !!MdsFR09.Support.Atta.append(!!CE)

        VAR !POS POS WRT WORLD

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

      enddo
---------------------------------------------------------------------------------------

  -- Fill in dimensions from SREF atta (Stored in mm)

      !!CE = !Sref.dbref()
      !Despars = despar
     !wpar = wdespar

     !!mdsfr09.nposts.val     = !despars[1].string()     $* Number of Vertical Members
     !!mdsfr09.upoffs.val     = !despars[2]              $* Post Top Offset
     !!mdsfr09.lowoffs.val    = !despars[3]              $* Post Lower Offset
     !!mdsfr09.nbars.val      = !despars[4]              $* Number of Bars
     !!mdsfr09.L2.val         = !despars[5]              $* Dimension L2
     !!mdsfr09.L3.val         = !despars[6]              $* Dimension L3
     !!mdsfr09.postoffset.val = !despars[7]              $* Post 1 Offset
     !!mdsfr09.sense.val      = !despars[8]              $* left or right build direction
     do !a from 1 to 20
       !vnum = 8 + !a
       !!mdsfr09$n.Dim$!<a>.val = !despars[!vnum]
     enddo

     do !b from 29 to !despars.size()
       if !wpar[!b].eq('S') or !wpar[!b].eq('R') or !wpar[!b].eq('B') then
           !!mdsFr09.barsides.append( !wpar[!b] )
       else
       !!mdsfr09.bardims.append( !despars[!b])
       endif
     enddo

     if !!mdsFR09.barsides.size().eq(0).and(!!mdsFR09.bardims.size().gt(0))  then
        !!mdsFr09.barsides[1] = 'S'
     endif

     if !!mdsFR09.barsides.size().neq(!!mdsFR09.bardims.size()) then
       do !a from !!mdsFR09.barsides.size() to !!mdsFR09.bardims.size() - 1
          !!mdsFr09.barsides.append( 'S' )
       enddo
      endif


     -- set the active dimension gadgets to the number of posts
     --!!mdsfr09.setposts(!despars[1].string())

   endif

  label /CONT

  -- Redefine standard support name on form title

    !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
    !text  = !!MdsCable.Standard.Dtext[!index]
      handle (61,567) (61,615)
         !!MdsPopulate(!!MdsCable,'CABLE')
         !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
         !text  = !!MdsCable.Standard.Dtext[!index]
      endhandle

    !SuppNumber = before(!text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsFR09.Support.Replace = !FormName


    call !!MdsSetFormName(!!MdsFR09, 'TRAY', '$!FormName')


    !!CE = !!MdsFR09.Support.Stru

  -- Set Support Code
    if !Modify.upcase() neq 'MODIFY' then
      !!MdsSetSuppCode('CREATE',!Name,!Alias,'FR09-1-1')
    else
      !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR09-1-1')
    endif

  -- If modify put members into repre member of form

    if (!Modify.upcase() eq |MODIFY|)then
      do !addrepre values !!MdsFR09.support.atta
        !!CE = !addrepre
        skip if (match(Name,|SREF|)gt 0)
        !Colour = !!KFindDrawColour(!!CE)
        !BranName = !!CE.owner.string()
        !!MdsFR09.repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
        -- Add to model at level set by !!MdsOptions.LevChange value
        call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
        !ColourList = array()
        !ColourList.append(!!CE.Name.dbref())
        call !!KEnhanceList(!ColourList)
      enddo
    endif

---------------------------------------------------------------

    -- Store current form information
    call !!MdsStoreFR09()

    -- Set dimensions toggle
    !!MdsFR09.GraphicalDim = false

    -- Show Form for frame type FR09
    !!KShowForm(!!MdsFR09)

    if (!Modify.upcase() eq |MODIFY|) then
      -- set the active dimension gadgets to the number of posts
      !!mdsFR09.setposts(!despars[1].string())
    endif


    -- set support object connections
    !!mdsFRAsaveconns(!!MdsFR09,'READ')

    !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiFR09.pml
