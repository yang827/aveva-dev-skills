--------------------------------------------------------------------------------
--
-- File:		MdsiFR10.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS127
--
-- Author:		T.Martin
-- Created:		23/02/2004 16:39
--
--
-- Description:
-- Initialisation for form FR10
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFR10(!Modify is string, !TextName is string, !Alias is string)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsFR10.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsFR10.Datum.Active = true
    !!MdsFR10.Cancel.active = true

  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    !!mdsFR10.bardims = ARRAY()

    -- deactivate unwanted buttons
      !!mdsfr10.AddPipe.active        = false
      !!mdsfr10.AddHVAC.active        = false
      !!mdsfr10.AddBar.active         = false
      !!mdsfr10.Flip.active           = false
      !!mdsfr10.Hand.active           = false
      !!mdsfr10.AlignSup.active       = false
      !!mdsfr10.ModSctn.active        = false
      !!mdsfr10.AddPack.active        = false
      !!mdsfr10.DelPack.active        = false
      !!mdsfr10.Rotate.active         = false
      !!mdsfr10.RotAtt.active         = false
      !!mdsfr10.Newdat.active         = false
      !!mdsfr10.Bedplate.active       = false
      !!mdsfr10.Associate.active      = false
      !!mdsfr10.ViewAssociate.active  = false
      !!mdsfr10.FlipFw.active         = false
      !!mdsfr10.ModAtta.active        = false
      !!mdsfr10.Spool.active          = false
      !!mdsfr10.copylike.active       = false
      !!mdsfr10.connect.active        = TRUE
      !!mdsfr10.modify.active         = false
      !!mdsfr10.forcecon.active       = false
      !!mdsfr10.disconn.active        = false
      !!mdsfr10.Mdsadp.active         = false
      !!mdsfr10.trimmer.active        = false
      !!mdsfr10.ancmat.active         = false
      !!mdsfr10.anccopy.active        = false
      !!mdsfr10.ancnudge.active       = false
      !!mdsfr10.setlen.active         = false
      !!mdsfr10.trunmat.active        = false
      !!mdsfr10.reconnect.active      = false
      !!MdsFR10.sspkbrk               = TRUE


    if (!Modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR10.Cancel.callback = |Call !!MdsCancelSupp(!!MdsFR10)|
      !Support.Modify = false

    -- Initialise variables for new supports

      !Support.Replace = !!MdsCable.Replacement
      !Support.Type    = !!MdsCable.standard.selection('Rtext')
      !StruName        = !!MdsCable.Name.Val

    -- Navigate to correct area
      if (!!MdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsDacControl(true)

    -- Create Stru
      NEW STRU /$!StruName
      !Support.Stru = !!CE
      :MDSSuppType |$!Support.Type|

    -- Set Paragraph gadget on form
      !!MdsFR10.Name.Val = !StruName
-- set default support values
      !!mdsFR10.nposts.val      = '1'
      !!mdsFR10.upoffs.val      = 200
      !!mdsFR10.lowoffs.val     = 200
      !!mdsFR10.bottoverlap.val = 120
      !!mdsFR10.topoverlap.val  = 120

      do !i from 1 to 20
        !!MdsFR10.Dim$!<i>.Val = 0
      enddo

      do !i from 1 to 20
        !!MdsFR10.Dim$!<i>.active = FALSE
      enddo

      !!MdsFR10.Dist.Val = 0
      !!MdsFR10.P.Val = ''
      !!mdsFR10.l2.val = 300
      !!mdsFR10.l3.val = 300
      !!mdsFR10.nbars.val = 1
      !!mdsFR10.sense.val = 1
      !!mdsFR10.postoffset.val = 0
      -- clear the old level values
      !!mdsfr10.localfitt = ARRAY()

      !!MdsCable.Hide()


    ------------------------------**** Connexions *****---------------------------
     -- in create mode have all three
        !!MdsFR10.CreateByDim.Active = true
    ------------------------------------------------------------------------------

    else  $* its modify mode

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR10.Cancel.callback = |Call !!MdsRestoreForm(!!MdsFR10)|
      !Support.Modify = true
      !!MdsFR10.Datum.Active = FALSE
      !!MdsFR10.Cancel.active = FALSE


    -- Initialise variables for existing supports
      !DatumName = !Name & '/DATUM'
      !Sref      = !Name & '/SREF'

    -- Store Data in support object
      !Support.Type     = '$!Alias'
      !Support.position = true
      !Support.Datum    = !DatumName.dbref()
        handle (2,109)
          !!Alert.error('Support Datum does not exist')
          unenhance all
          !!MdsModifySupp.Cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !Support.Stru = !Name.dbref()

      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!Mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif

      -- Store Atta reference's in object
      !Support.Atta.append(!DatumName.dbref())
      !Support.Atta.append(!Sref.dbref())

      -- Navigate to existing support datum
      !!CE = !Support.Datum
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.P10Dir = P10 Dir wrt world
      !Support.P11Dir = P11 Dir wrt world


      -- Get number of existing crossbars
      !!CE  = !Support.Stru
      !Bars = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!CE)

      if (!Bars.size().gt(0))then
        do !I indices !Bars
          !!CE = !Bars[!I]
          var !Ref :MDSAttaRef
          !Split = split(!Ref)

          !References = array()
          do !index indices !Split
            !References.append(!Split[!index].dbref())
            handle(2,107) (2,813)
              -- Atta has been manually deleted
            endhandle
          enddo

        -- Store Data in support object
          !Support.Bars[!I] = !References
        enddo

      endif

      -- Get length of existing crossbars
      do !V values !Bars
        !Length = deri length of $!V
        !Support.Barlen.append(!Length)
      enddo

      -- Store section name and matref for each member

      !StoreMat = array()
      !StoreMat = !!MdsStoreMat(!Name)
      !Support.Material = !StoreMat

      -- Get bedplate references if set
      !!CE  = !Support.Stru
      var !BPRef1 :MDSBpref1
      var !BPRef2 :MDSBpref2
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
      endif
      if (!!CE.:MDSBpref2.badref().not()) then
        !Support.BedPlate2 = !BPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!MdsFR10.Name.Val = !Name
      !!MdsFR10.P.Val    = ''

      !!MdsAddAll('$!TextName')

------------------------------ ***** Connexions --------------------
      -- if(!Support.Connections.size().eq(1)) then
         -- !!MdsFR10.LineUp.Active = True
      -- endif

    -- set support object connections
      !VertDbref = array()
      !Vert1 = !Name & '-V1'
      !Vertdbref[1] = !Vert1.dbref()
      !conn1 = !Vertdbref[1].:MDSConn
      !Support.Connections[1] = !Conn1

      -- set the connection object for using :mdsancref
      !support.plateconns = object mdsBPlateConn(!support)

    -- set support object for joints
    !Support.Joints = !!MdsGetJoints(!Vertdbref)

-- hide dimension form the list if connected
       if(!Support.Joints.unset().not()) then
         !!MdsFR10.CreateByDim.Active = false
        else
         !!MdsFR10.CreateByDim.Active = true
       endif
-------------------------------------------------------------------

    endif

  -- Store support object in form
    !!MdsFR10.Support = !Support

  -- Store Current representations in form for use later
    var !Repre repre level
    !!MdsFR10.repre.clear()
    !!MdsFR10.repre.append(|Call !!KRepreLevel(Nulref, '', $!Repre,0)|)
    var !Repre repre level pipe
    !!MdsFR10.repre.append(|Call !!KRepreLevel(Nulref, 'PIPE', $!Repre,0)|)
    var !Repre repre level nozz
    !!MdsFR10.repre.append(|Call !!KRepreLevel(Nulref, 'NOZZ', $!Repre,0)|)
    var !Repre repre level stru
    !!MdsFR10.repre.append(|Call !!KRepreLevel(Nulref, 'STRU', $!Repre,0)|)

     !!CE = /MDS/FRAMES/FR10
      handle (2,109)
        !!Alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!Modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle

  -- Generate Steel Size List

    !Dtext = array()
    !Rtext = array()
    !!MdsSetSteel.init('HIDE',!!MdsFR10,'-V1','-V1')

    !!CE = !Support.Stru

    if (!Modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!MdsFR10,'-BAR-1','-V1')
      !!MdsSetSteel.init('HIDE',!!MdsFR10,'-BAR-1','-V1')

      !!CE = !!MdsFR10.Support.Datum

    -- Set distance gadget

      !!MdsDistance(!!MdsFR10)

    -- Add marker text markers

      VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

      do !COUNT FROM 211 TO 259

        VAR !NUM ($!COUNT - 210)
        !AttaName = !Name & '.' & !Num
        !!CE = !AttaName.dbref()
          handle ANY
            SKIP
          endhandle

      -- Store Atta reference in form
        !!MdsFR10.Support.Atta.append(!!CE)

        VAR !POS POS WRT WORLD

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

      enddo
---------------------------------------------------------------------------------------

  -- Fill in dimensions from SREF atta (Stored in mm)

      !!CE = !Sref.dbref()
      !Despars = despar

     !!mdsFR10.nposts.val      = !despars[1].string()     $* Number of Vertical Members
     !!mdsFR10.upoffs.val      = !despars[2]              $* Post Top Offset
     !!mdsFR10.lowoffs.val     = !despars[3]              $* Post Lower Offset
     !!mdsFR10.nbars.val       = !despars[4]              $* Number of Bars
     !!mdsFR10.L2.val          = !despars[5]              $* Dimension L2
     !!mdsFR10.L3.val          = !despars[6]              $* Dimension L3
     !!mdsFR10.postoffset.val  = !despars[7]              $* Post 1 Offset
     !!mdsFR10.sense.val       = !despars[8]              $* left or right build direction
     !!mdsFR10.topoverlap.val   = !despars[9]
     !!mdsFR10.bottoverlap.val = !despars[10]

     do !a from 1 to 20
       !vnum = 10 + !a
       !!mdsFR10$n.Dim$!<a>.val = !despars[!vnum]
       handle ANY
        break
       endhandle
     enddo

     do !b from 31 to !despars.size()
       !!mdsFR10.bardims.append( !despars[!b])
     enddo

     -- set the active dimension gadgets to the number of posts
     --!!mdsFR10.setposts(!despars[1].string())

     !desparray = ARRAY()
     -- loop through the posts and get the local design parameters for elevation
     do !a from 1 to !despars[1]
       !vname = !Name & '-V' & !a
       !desp = !vname.dbref().desp
       -- take out the standard despars
       !desp.removeto(2)
       !desparray.append(!desp)
     enddo

    !!mdsfr10.localfitt = !desparray
    endif

  -- Redefine standard support name on form title

    !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
    !text  = !!MdsCable.Standard.Dtext[!index]
      handle (61,567) (61,615)
         !!MdsPopulate(!!MdsCable,'CABLE')
         !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
         !text  = !!MdsCable.Standard.Dtext[!index]
      endhandle

    !SuppNumber = before(!text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsFR10.Support.Replace = !FormName


    call !!MdsSetFormName(!!MdsFR10, 'TRAY', '$!FormName')


    !!CE = !!MdsFR10.Support.Stru

  -- Set Support Code
    if !Modify.upcase() neq 'MODIFY' then
      !!MdsSetSuppCode('CREATE',!Name,!Alias,'FR10-1-1')
    else
      !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR10-1-1')
    endif

  -- If modify put members into repre member of form

    if (!Modify.upcase() eq |MODIFY|)then
      do !addrepre values !!MdsFR10.support.atta
        !!CE = !addrepre
        skip if (match(Name,|SREF|)gt 0)
        !Colour = !!KFindDrawColour(!!CE)
        !BranName = !!CE.owner.string()
        !!MdsFR10.repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
        -- Add to model at level set by !!MdsOptions.LevChange value
        call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
        !ColourList = array()
        !ColourList.append(!!CE.Name.dbref())
        call !!KEnhanceList(!ColourList)
      enddo
    endif

---------------------------------------------------------------


     -- Store current form information
     call !!MdsStoreFR10()

    -- Set dimensions toggle
     !!MdsFR10.GraphicalDim = FALSE

  if (!Modify.upcase() eq |MODIFY|) then
    -- set the active dimension gadgets to the number of posts
    !!mdsFR10.setposts(!despars[1].string())
  endif


  -- Show Form for frame type FR10
    !!KShowForm(!!MdsFR10)

-- set support object connections
    !!mdsFRAsaveconns(!!MdsFR10,'READ')
    !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiFR10.pml
