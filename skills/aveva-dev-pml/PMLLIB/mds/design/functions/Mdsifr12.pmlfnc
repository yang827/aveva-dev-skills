--------------------------------------------------------------------------------
--
-- File:		MdsiFR12.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS127
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- Initialisation for form FR12
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFR12(!Modify is string, !TextName is string, !Alias is string)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsFR12.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    -- !!MdsFR12.Create.select('Rtext', 'CURSOR')
    -- !!MdsFR12.Select.select('RTEXT', 'IDCUR')
    -- !!MdsFR12.Nudge.val = 0
    !!MdsFR12.Datum.Active = true
    !!MdsFR12.Cancel.active = true
    !!MdsFR12.ancmat.active = true

  -- FR12 has an alias from the cable rack frameworks called CT01
  -- and a alias from the HVAC frameworks called DT04

    !!MdsFR12.AddPipe.active  = false
    !!MdsFR12.AddHVAC.active  = false
    !!MdsFR12.AddRack.active  = true
    !!MdsFR12.AddBar.Active   = true
    !!MdsFR12.Rotate.active   = false
    !!MdsFR12.ModAtta.Active  = false
    !!MdsFR12.AddPack.Active  = false
    !!MdsFR12.DelPack.Active  = false
    !!MdsFR12.RotAtt.Active   = false
    !!MdsFR12.ancmat.active   = false
    !!MdsFR12.Bedplate.active = FALSE
    !!MdsFR12.sspkbrk         = TRUE


  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias


    if (!Modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR12.Cancel.callback = |Call !!MdsCancelSupp(!!MdsFR12)|
      !Support.Modify = false

    -- Initialise variables for new supports

      !Support.Replace = !!MdsCable.Replacement
      !Support.Type    = !!MdsCable.standard.selection('Rtext')
      !StruName        = !!MdsCable.Name.Val

    -- Navigate to correct area
      if (!!MdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsDacControl(true)

    -- Create Stru
      NEW STRU /$!StruName
      !Support.Stru = !!CE
      :MDSSuppType |$!Support.Type|

    -- Set Paragraph gadget on form
      !!MdsFR12.Name.Val = !StruName

      !!MdsFR12.Dim1.Val = 0
      !!MdsFR12.Dim2.Val = 0
      !!MdsFR12.Dim3.Val = 300
      !!MdsFR12.Dist.Val = 0
      !!MdsFR12.P.Val = ''

      !!MdsCable.Hide()

      -- remove createbyclearance option
      !!MdsFR12.CreateByCle.Active = FALSE
    ------------------------------**** Connexions *****---------------------------
     -- in create mode have all three
        !!MdsFR12.CreateByDim.Active = true
        --!!MdsFR12.CreateByCle.Active = true
        !!MdsFR12.CreateByCur.Active = true
    ------------------------------------------------------------------------------

    else  $* its modify mode

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR12.Cancel.callback = |Call !!MdsRestoreForm(!!MdsFR12)|
      !Support.Modify = true
      !!MdsFR12.Datum.Active = false

    -- Initialise variables for existing supports
      !DatumName = !Name & '/DATUM'
      !Sref      = !Name & '/SREF'

    -- Store Data in support object
      !Support.Type     = '$!Alias'
      !Support.position = true
      !Support.Datum    = !DatumName.dbref()
        handle (2,109)
          !!Alert.error('Support Datum does not exist')
          unenhance all
          !!MdsModifySupp.Cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !Support.Stru = !Name.dbref()

      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!Mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif

      -- Store Atta reference's in object
      !Support.Atta.append(!DatumName.dbref())
      !Support.Atta.append(!Sref.dbref())

      -- Navigate to existing support datum
      !!CE = !Support.Datum
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.P10Dir = P10 Dir wrt world
      !Support.P11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 04 from :MDSCp1 on datum atta
      !Data = !!CE.:MDSCp1
      !Split = split(!Data, ';')
      !Support.Config = !Split[1].real()
      if (!Split[2] eq |T|)then
        !Support.RotateCur = TRUE
      else
        !Support.RotateCur = FALSE
      endif
      if (!Split[3] eq |T|)then
        !Support.HandedCur = TRUE
      else
        !Support.HandedCur = FALSE
      endif
      !Support.Rotated = !Split[4].real()
      if (!Split[5] eq |T|)then
        !Support.Mirror = TRUE
      else
        !Support.Mirror = FALSE
      endif

      -- Get number of existing crossbars
      !!CE  = !Support.Stru
      !Bars = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!CE)

      if (!Bars.size().gt(0))then
        do !I indices !Bars
          !!CE = !Bars[!I]
          var !Ref :MDSAttaRef
          !Split = split(!Ref)

          !References = array()
          do !index indices !Split
            !References.append(!Split[!index].dbref())
            handle(2,107) (2,813)
              -- Atta has been manually deleted
            endhandle
          enddo

        -- Store Data in support object
          !Support.Bars[!I] = !References
        enddo

      endif

      -- Get length of existing crossbars
      do !V values !Bars
        !Length = deri length of $!V
        !Support.Barlen.append(!Length)
      enddo

      -- Store section name and matref for each member

      !StoreMat = array()
      !StoreMat = !!MdsStoreMat(!Name)
      !Support.Material = !StoreMat

      -- Get bedplate references if set
      !!CE  = !Support.Stru
      var !BPRef1 :MDSBpref1
      var !BPRef2 :MDSBpref2
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
      endif
      if (!!CE.:MDSBpref2.badref().not()) then
        !Support.BedPlate2 = !BPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!MdsFR12.Name.Val = !Name
      !!MdsFR12.Dim1.Val = 0
      !!MdsFR12.Dim2.Val = 0
      !!MdsFR12.Dim3.Val = 300

      !!MdsFR12.P.Val    = ''

      !!MdsAddAll('$!TextName')

------------------------------ ***** Connexions --------------------
      -- if(!Support.Connections.size().eq(1)) then
         -- !!MdsFR12.LineUp.Active = True
      -- endif

    -- set support object connections
      !VertDbref = array()
      !Vert1 = !Name & '-V1'
      !Vertdbref[1] = !Vert1.dbref()
      --<tm> 17/09/2004 09:01
      -- modified so that connections use the :mdspconn uda instead of :mdsconn
      if !Vertdbref[1].:MDSConn.set() then
        !conn[1] = !Vertdbref[1].:MDSConn
      else
        !conn = !Vertdbref[1].:MDSPConn
        -- check that the connections are valid
        do !a index !conn
          if !conn[!a].badref() then
            !conn.deletefrom(!a)
          endif
        enddo
        !Support.Connections = !Conn
      endif

      -- set the connection object for using :mdsancref
      !support.plateconns = object mdsBPlateConn(!support)


      -- set support object for joints
      !Support.Joints = !!MdsGetJoints(!Vertdbref)

-- hide dimension form the list if connected
       if(!Support.Joints.unset().not()) then
         !!MdsFR12.CreateByDim.Active = false
         --!!MdsFR12.CreateByCle.Active = true
         !!MdsFR12.CreateByCur.Active = true
       else
         !!MdsFR12.CreateByDim.Active = true
         --!!MdsFR12.CreateByCle.Active = true
         !!MdsFR12.CreateByCur.Active = true
       endif
-------------------------------------------------------------------

    endif

  -- Store support object in form
    !!MdsFR12.Support = !Support

  -- Store Current representations in form for use later
    var !Repre repre level
    !!MdsFR12.repre.clear()
    !!MdsFR12.repre.append(|Call !!KRepreLevel(Nulref, '', $!Repre,0)|)
    var !Repre repre level pipe
    !!MdsFR12.repre.append(|Call !!KRepreLevel(Nulref, 'PIPE', $!Repre,0)|)
    var !Repre repre level nozz
    !!MdsFR12.repre.append(|Call !!KRepreLevel(Nulref, 'NOZZ', $!Repre,0)|)
    var !Repre repre level stru
    !!MdsFR12.repre.append(|Call !!KRepreLevel(Nulref, 'STRU', $!Repre,0)|)

  -- Collect all supports for frame type 4 or alias

    !!CE = /MDS/FRAMES/FR12
      handle (2,109)
        !!Alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!Modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle

  -- Generate Steel Size List

    !Dtext = array()
    !Rtext = array()
    !!MdsSetSteel.init('HIDE',!!MdsFR12,'-V1','-V1')

    !!CE = !Support.Stru

    if (!Modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!MdsFR12,'-BAR-1','-V1')
      !!MdsSetSteel.init('HIDE',!!MdsFR12,'-BAR-1','-V1')

      !!CE = !!MdsFR12.Support.Datum

    -- Set distance gadget

      !!MdsDistance(!!MdsFR12)

    -- Add marker text markers

      VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

      do !COUNT FROM 211 TO 259

        VAR !NUM ($!COUNT - 210)
        !AttaName = !Name & '.' & !Num
        !!CE = !AttaName.dbref()
          handle ANY
            SKIP
          endhandle

      -- Store Atta reference in form
        !!MdsFR12.Support.Atta.append(!!CE)

        VAR !POS POS WRT WORLD

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

      enddo

---------------------------------------------------------------------------------------

-- Store Packing Pieces in the Support Object
-- Derived from the 'Attas' :MDSPackRef references in the Support.Atta array
      !!mdspackattas(!!MdsFR12.support)

---------------------------------------------------------------------------------------

  -- Fill in dimensions from SREF atta (Stored in mm)

      !!CE = !Sref.dbref()
      !Despars = despar


      !!MdsFR12.Dim1.Val = !Despars[1]
        handle any
          !!Alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!MdsFR12.Dim2.Val = !Despars[2]
        handle any
          !!MdsFR12.Dim2.Val = 0
          !!Alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
     !!MdsFR12.Dim3.Val = !Despars[3]
        handle any
          !!MdsFR12.Dim3.Val = 0
          !!Alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle

    endif

  label /CONT

  -- Redefine standard support name on form title

    !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
    !text  = !!MdsCable.Standard.Dtext[!index]
      handle (61,567) (61,615)
         !!MdsPopulate(!!MdsCable,'CABLE')
         !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
         !text  = !!MdsCable.Standard.Dtext[!index]
      endhandle

    !SuppNumber = before(!text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsFR12.Support.Replace = !FormName


    call !!MdsSetFormName(!!MdsFR12, 'TRAY', '$!FormName')


    !!CE = !!MdsFR12.Support.Stru

  -- Set Support Code
    if !Modify.upcase() neq 'MODIFY' then
      !!MdsSetSuppCode('CREATE',!Name,!Alias,'FR12-1-1')
    else
      !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR12-1-1')
    endif

  -- If modify put members into repre member of form

    if (!Modify.upcase() eq |MODIFY|)then
      do !addrepre values !!MdsFR12.support.atta
        !!CE = !addrepre
        skip if (match(Name,|SREF|)gt 0)
        !Colour = !!KFindDrawColour(!!CE)
        !BranName = !!CE.owner.string()
        !!MdsFR12.repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
        -- Add to model at level set by !!MdsOptions.LevChange value
    call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
        !ColourList = array()
        !ColourList.append(!!CE.Name.dbref())
        call !!KEnhanceList(!ColourList)
      enddo
    endif

------------------------ connexions ----------------------------
--$(
    -- grey out steelwork connections if not set in default & frame not created
       if(!!MdsOptions.CreateCons.Selection().real().eq(1)) then
          !!MdsFR12.Connect.Active = False
          !!MdsFR12.Modify.Active = False
       elseif(!!MdsOptions.CreateCons.Selection().real().neq(1) and !!MdsFR12.Support.Stru.unset()) then
          !!MdsFR12.Connect.Active = False
          !!MdsFR12.Modify.Active = False
       elseif(!!MdsOptions.CreateCons.Selection().real().eq(2)) then
          !!MdsFR12.Connect.Active = True
          !!MdsFR12.Modify.Active = False
       else
          !!MdsFR12.Connect.Active  = True
          !!MdsFR12.Modify.Active   = FALSE
        endif
--$)
----------------------------------------------------------------


  -- Store current form information
    call !!MdsStoreFR12()

  -- Set dimensions toggle

    !!MdsFR12.GraphicalDim = false


  if (!Modify.upcase() eq |MODIFY|)then

     !sctnname = !!mdsFR12.name & '-V1'
      !sctn = !sctnname.dbref()

      -- create the support stack
      !!mdsFR12.support.stack = object mdslevelstack(!sctn,!!mdsFR12)

  endif



  -- Show Form for frame type FR12
    !!KShowForm(!!MdsFR12)


  -- set support object connections
  !!mdsFRAsaveconns(!!MdsFR12,'READ')


    !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiFR12.pml
