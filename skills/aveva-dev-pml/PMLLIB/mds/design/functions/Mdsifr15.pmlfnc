--------------------------------------------------------------------------------
--
-- File:		MdsiFR15.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS127
--
-- Author:		T.Martin
-- Created:		23/02/2004 16:39
--
--
-- Description:
-- Initialisation for form FR15
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFR15(!Modify is string, !TextName is string, !Alias is string)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsFR15.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsFR15.Datum.Active = true
    !!MdsFR15.Cancel.active = true

  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    !!mdsFR15.bardims = ARRAY()
    !!mdsFR15.barsides = ARRAY()

    -- deactivate unwanted buttons
    !!mdsFR15.AddPipe.active        = false
    !!mdsFR15.AddHVAC.active        = false
    !!mdsFR15.AddBar.active         = false
    !!mdsFR15.Flip.active           = false
    !!mdsFR15.Hand.active           = false
    !!mdsFR15.AlignSup.active       = false
    !!mdsFR15.ModSctn.active        = false
    !!mdsFR15.AddPack.active        = false
    !!mdsFR15.DelPack.active        = false
    !!mdsFR15.Rotate.active         = false
    !!mdsFR15.RotAtt.active         = false
    !!mdsFR15.Newdat.active         = false
    !!mdsFR15.Bedplate.active       = false
    !!mdsFR15.Associate.active      = false
    !!mdsFR15.ViewAssociate.active  = false
    !!mdsFR15.FlipFw.active         = false
    !!mdsFR15.ModAtta.active        = false
    !!mdsFR15.Spool.active          = false
    !!mdsFR15.copylike.active       = false
    !!mdsFR15.connect.active        = TRUE
    !!mdsFR15.modify.active         = false
    !!mdsFR15.forcecon.active       = false
    !!mdsFR15.disconn.active        = false
    !!mdsFR15.Mdsadp.active         = false
    !!mdsFR15.trimmer.active        = false
    !!mdsFR15.ancmat.active         = false
    !!mdsFR15.anccopy.active        = false
    !!mdsFR15.ancnudge.active       = false
    !!mdsFR15.setlen.active         = false
    !!mdsFR15.trunmat.active        = false
    !!mdsFR15.reconnect.active      = false
    !!MdsFR15.sspkbrk               = TRUE


    if (!Modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR15.Cancel.callback = |Call !!MdsCancelSupp(!!MdsFR15)|
      !Support.Modify = false
      !!MdsFR15.Cancel.active = TRUE

    -- Initialise variables for new supports

      !Support.Replace = !!MdsCable.Replacement
      !Support.Type    = !!MdsCable.standard.selection('Rtext')
      !StruName        = !!MdsCable.Name.Val

    -- Navigate to correct area
      if (!!MdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsDacControl(true)

    -- Create Stru
      NEW STRU /$!StruName
      !Support.Stru = !!CE
      :MDSSuppType |$!Support.Type|

    -- Set Paragraph gadget on form
      !!MdsFR15.Name.Val = !StruName
-- set default support values
      !!mdsFR15.nposts.val      = '1'
      !!mdsFR15.upoffs.val      = 200
      !!mdsFR15.lowoffs.val     = 200
      !!mdsFR15.bottoverlap.val = 100
      !!mdsFR15.topoverlap.val  = 100
      !!mdsFR15.walloffset.val  = 0


      do !i from 1 to 20
        !!MdsFR15.Dim$!<i>.Val = 0
      enddo

      do !i from 1 to 20
        !!MdsFR15.Dim$!<i>.active = FALSE
      enddo

      !!MdsFR15.Dist.Val = 0
      !!MdsFR15.P.Val = ''
      !!mdsFR15.l2.val = 300
      !!mdsFR15.l3.val = 300
      !!mdsFR15.nbars.val = 1
      !!mdsFR15.sense.val = 1
      !!mdsFR15.postoffset.val = 0
      !!mdsFR15.localfitt = ARRAY()
      !!mdsFR15.localfitt[1] = ARRAY()
      !!mdsFR15.Sideplane = object plane()

      !!MdsCable.Hide()


    ------------------------------**** Connexions *****---------------------------
     -- in create mode have all three
        !!MdsFR15.CreateByDim.Active = true
    ------------------------------------------------------------------------------

    else  $* its modify mode

    -- Set callback on cancel button and set mode member of support object
      !!MdsFR15.Cancel.callback = |Call !!MdsRestoreForm(!!MdsFR15)|
      !Support.Modify = true
      !!MdsFR15.Datum.Active = FALSE
      !!MdsFR15.Cancel.active   = FALSE

    -- Initialise variables for existing supports
      !DatumName = !Name & '/DATUM'
      !Sref      = !Name & '/SREF'

    -- Store Data in support object
      !Support.Type     = '$!Alias'
      !Support.position = true
      !Support.Datum    = !DatumName.dbref()
        handle (2,109)
          !!Alert.error('Support Datum does not exist')
          unenhance all
          --!!MdsModifySupp.Cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !Support.Stru = !Name.dbref()

      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        --!!Mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif

      -- Store Atta reference's in object
      !Support.Atta.append(!DatumName.dbref())
      !Support.Atta.append(!Sref.dbref())

      -- Navigate to existing support datum
      !!CE = !Support.Datum
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.P10Dir = P10 Dir wrt world
      !Support.P11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 04 from :MDSCp1 on datum atta
      !Data = !!CE.:MDSCp1
      !Split = split(!Data, ';')
      !Support.Config = !Split[1].real()
      if (!Split[2] eq |T|)then
        !Support.RotateCur = TRUE
      else
        !Support.RotateCur = FALSE
      endif
      if (!Split[3] eq |T|)then
        !Support.HandedCur = TRUE
      else
        !Support.HandedCur = FALSE
      endif
      !Support.Rotated = !Split[4].real()
      if (!Split[5] eq |T|)then
        !Support.Mirror = TRUE
      else
        !Support.Mirror = FALSE
      endif

      -- Get number of existing crossbars
      !!CE  = !Support.Stru
      !Bars = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!CE)

      if (!Bars.size().gt(0))then
        do !I indices !Bars
          !!CE = !Bars[!I]
          var !Ref :MDSAttaRef
          !Split = split(!Ref)

          !References = array()
          do !index indices !Split
            !References.append(!Split[!index].dbref())
            handle(2,107) (2,813)
              -- Atta has been manually deleted
            endhandle
          enddo

        -- Store Data in support object
          !Support.Bars[!I] = !References
        enddo

      endif

      -- Get length of existing crossbars
      do !V values !Bars
        !Length = deri length of $!V
        !Support.Barlen.append(!Length)
      enddo

      -- Store section name and matref for each member

      !StoreMat = array()
      !StoreMat = !!MdsStoreMat(!Name)
      !Support.Material = !StoreMat

      -- Get bedplate references if set
      !!CE  = !Support.Stru
      var !BPRef1 :MDSBpref1
      var !BPRef2 :MDSBpref2
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
      endif
      if (!!CE.:MDSBpref2.badref().not()) then
        !Support.BedPlate2 = !BPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!MdsFR15.Name.Val = !Name
      !!MdsFR15.P.Val    = ''

      !!MdsAddAll('$!TextName')

------------------------------ ***** Connexions --------------------
      -- if(!Support.Connections.size().eq(1)) then
         -- !!MdsFR15.LineUp.Active = True
      -- endif

    -- set support object connections
      !VertDbref = array()
      !Vert1 = !Name & '-V1'
      !Vertdbref[1] = !Vert1.dbref()
      !conn1 = !Vertdbref[1].:MDSConn
      !Support.Connections[1] = !Conn1

      -- set the connection object for using :mdsancref
      !support.plateconns = object mdsBPlateConn(!support)

    -- set support object for joints
    !Support.Joints = !!MdsGetJoints(!Vertdbref)

-- hide dimension form the list if connected
       if(!Support.Joints.unset().not()) then
         !!MdsFR15.CreateByDim.Active = false
        else
         !!MdsFR15.CreateByDim.Active = true
       endif
-------------------------------------------------------------------

    endif

  -- Store support object in form
    !!MdsFR15.Support = !Support

  -- Store Current representations in form for use later
    var !Repre repre level
    !!MdsFR15.repre.clear()
    !!MdsFR15.repre.append(|Call !!KRepreLevel(Nulref, '', $!Repre,0)|)
    var !Repre repre level pipe
    !!MdsFR15.repre.append(|Call !!KRepreLevel(Nulref, 'PIPE', $!Repre,0)|)
    var !Repre repre level nozz
    !!MdsFR15.repre.append(|Call !!KRepreLevel(Nulref, 'NOZZ', $!Repre,0)|)
    var !Repre repre level stru
    !!MdsFR15.repre.append(|Call !!KRepreLevel(Nulref, 'STRU', $!Repre,0)|)

     !!CE = /MDS/FRAMES/FR15
      handle (2,109)
        !!Alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!Modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle

  -- Generate Steel Size List

    !Dtext = array()
    !Rtext = array()
    !!MdsSetSteel.init('HIDE',!!MdsFR15,'-V1','-V1')

    !!CE = !Support.Stru

    if (!Modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!MdsFR15,'-BAR-1','-V1')
      !!MdsSetSteel.init('HIDE',!!MdsFR15,'-BAR-1','-V1')

      !!CE = !!MdsFR15.Support.Datum

    -- Set distance gadget

      !!MdsDistance(!!MdsFR15)

    -- Add marker text markers

      VAR !POS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

      do !COUNT FROM 211 TO 259

        VAR !NUM ($!COUNT - 210)
        !AttaName = !Name & '.' & !Num
        !!CE = !AttaName.dbref()
          handle ANY
            SKIP
          endhandle

      -- Store Atta reference in form
        !!MdsFR15.Support.Atta.append(!!CE)

        VAR !POS POS WRT WORLD

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!COUNT $!NUM $<$!POS$>

      enddo
---------------------------------------------------------------------------------------

  -- Fill in dimensions from SREF atta (Stored in mm)
    onerror golabel /loaderror
     !!CE = !Sref.dbref()
     !Despars = despar
     !wpar = wdespar

     !!mdsFR15.nposts.val      = !despars[1].string()     $* Number of Vertical Members
     !!mdsFR15.upoffs.val      = !despars[2]              $* Post Top Offset
     !!mdsFR15.lowoffs.val     = !despars[3]              $* Post Lower Offset
     !!mdsFR15.nbars.val       = !despars[4]              $* Number of Bars
     !!mdsFR15.L2.val          = !despars[5]              $* Dimension L2
     !!mdsFR15.L3.val          = !despars[6]              $* Dimension L3
     !!mdsFR15.postoffset.val  = !despars[7]              $* Post 1 Offset
     !!mdsFR15.sense.val       = !despars[8]              $* left or right build direction
     !!mdsFR15.topoverlap.val  = !despars[9]
     !!mdsFR15.bottoverlap.val = !despars[10]
     !!mdsFR15.walloffset.val  = !despars[11]

     do !a from 1 to 20
       !vnum = 11 + !a
       !!mdsFR15$n.Dim$!<a>.val = !despars[!vnum]
       handle ANY
        break
       endhandle
     enddo

     do !b from 32 to !despars.size()
       if !wpar[!b].eq('S') or !wpar[!b].eq('R') or !wpar[!b].eq('B') then
           !!mdsFR15.barsides.append( !wpar[!b] )
       else
           !!mdsFR15.bardims.append( !despars[!b])
       endif
     enddo

     if !!mdsFR15.barsides.size().eq(0).and(!!mdsFR15.bardims.size().gt(0))  then
        !!mdsFR15.barsides[1] = 'S'
     endif
     if !!mdsFR15.barsides.size().neq(!!mdsFR15.bardims.size()) then
       do !a from !!mdsFR15.barsides.size() to !!mdsFR15.bardims.size()
          !!mdsFR15.barsides.append( 'S' )
       enddo
      endif


     golabel /continue

     label /loaderror
     !!alert.error('Error in Loading Parameters')
     onerror return

     label /continue
     -- set the active dimension gadgets to the number of posts
     --!!mdsFR15.setposts(!despars[1].string())

     !desparray = ARRAY()
     -- loop through the posts and get the local design parameters for elevation
     do !a from 1 to !despars[1]
       !vname = !Name & '-V' & !a
       !desp = !vname.dbref().desp
       -- take out the standard despars
       !desp.removeto(2)
       !desparray.append(!desp)
     enddo

    !!mdsFR15.localfitt = !desparray
    endif

  -- Redefine standard support name on form title

    !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
    !text  = !!MdsCable.Standard.Dtext[!index]
      handle (61,567) (61,615)
         !!MdsPopulate(!!MdsCable,'CABLE')
         !index = !!MdsCable.Standard.Rtext.findfirst('$!Alias')
         !text  = !!MdsCable.Standard.Dtext[!index]
      endhandle

    !SuppNumber = before(!text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsFR15.Support.Replace = !FormName


    call !!MdsSetFormName(!!MdsFR15, 'TRAY', '$!FormName')


    !!CE = !!MdsFR15.Support.Stru

  -- Set Support Code
    if !Modify.upcase() neq 'MODIFY' then
      !!MdsSetSuppCode('CREATE',!Name,!Alias,'FR15-1-1')
    else
      !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FR15-1-1')
    endif

  -- If modify put members into repre member of form

    if (!Modify.upcase() eq |MODIFY|)then
      do !addrepre values !!MdsFR15.support.atta
        !!CE = !addrepre
        skip if (match(Name,|SREF|)gt 0)
        !Colour = !!KFindDrawColour(!!CE)
        !BranName = !!CE.owner.string()
        !!MdsFR15.repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
        -- Add to model at level set by !!MdsOptions.LevChange value
        call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
        !ColourList = array()
        !ColourList.append(!!CE.Name.dbref())
        call !!KEnhanceList(!ColourList)
      enddo
    endif

---------------------------------------------------------------


  -- Store current form information
    call !!MdsStoreFR15()

    -- Set dimensions toggle
     !!MdsFR15.GraphicalDim = false


  -- Show Form for frame type FR15
    !!KShowForm(!!MdsFR15)

    -- set support object connections
    !!mdsFRAsaveconns(!!MdsFR15,'READ')

    if (!Modify.upcase() eq |MODIFY|) then
      -- set the active dimension gadgets to the number of posts
      !!mdsFR15.setposts(!despars[1].string())
    endif

    !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiFR15.pml
