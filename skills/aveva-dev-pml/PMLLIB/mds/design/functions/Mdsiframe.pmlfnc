--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsframe.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIframe()

-- Reset Gadgets
  !!MdsFrame.Name.val = 'unset'
  !!MdsFrame.Ok.active = False

-- Read PARAGON MDS Defaults Catalogue to load ACTIVE MDS FRAMEWORK Support Types
  !!MdsPopulate(!!MdsFrame,'FRAME')

-- Populate icons if exists
  --!UseIcons = !!MdsIcons.boolean()
  --  handle any
  --    !UseIcons = false
  --  endhandle

  --!UseIconsAsGroups = !!MdsIconsGroup.boolean()
  --  handle any
  --    !UseIconsAsGroups = false
  --  endhandle

-- Use icons but not as groups

  --if !UseIcons and !UseIconsAsGroups.not() then
  --  !FrameRtext = !!MdsFrame.Standard.Rtext
  --  !FrameDtext = !!MdsFrame.Standard.Dtext
  --  do !AddPixMaps from 1 to !FrameRtext.size()
  --    !UnselectedPixMap = !FrameRtext[$!AddPixMaps].lowcase() + 'u.png'
  --    !SelectedPixMap = !FrameRtext[$!AddPixMaps].lowcase() + '.png'
  --    !ToolTip = !FrameDtext[$!AddPixMaps]
  --    !!MdsFrame.B$!AddPixMaps$n.addPixmap(!!PML.getPathName(!UnSelectedPixmap),!!PML.getPathName(!SelectedPixmap))
  --      handle any
  --      endhandle
  --    !!MdsFrame.B$!AddPixMaps$n.settooltip(!ToolTip)
  --      handle any
  --      endhandle
  --  enddo
-- Set the correct icon to match the list of standards
  --  !!MdsFrame.unselect(!!MdsFrame.Standard.val)
  --endif

-- Use icons as groups
  --if !UseIcons and !UseIconsAsGroups then
-- Setup the group members
    !!MdsFrame.Groups()
    do !AddPixMaps from 1 to 10
      !PixMap = 'g' + !AddPixMaps.string() + '.png'
      !ToolTip = !!MdsFrame.GroupsDesc[$!AddPixMaps]
        handle any
        endhandle
-- Set pixmap
      !!MdsFrame.B$!AddPixMaps$n.addPixmap(!!PML.getPathName(!Pixmap))
        handle any
        endhandle
-- Set group tooltip
      !!MdsFrame.B$!AddPixMaps$n.settooltip(!ToolTip)
        handle any
        endhandle
-- Set Callback to add
    enddo
-- This only use 7 so hide last 3
    !!MdsFrame.B8.visible = FALSE
      handle any
      endhandle
    !!MdsFrame.B9.visible = FALSE
      handle any
      endhandle
    !!MdsFrame.B10.visible = FALSE
      handle any
      endhandle
  --endif

-- Set the group list if needed

  !TestGroupList = !!Mdsframe.listgroups.dtext.size()
    handle none
      if !TestGroupList.eq(0) then
        !!MdsFrame.unselect(1)
      endif
    elsehandle any
    endhandle

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsFrame.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsFrame.view.active = false
      !!MdsFrame.name.active = false
      return
    elsehandle none
      !!MdsFrame.view.active = true
      !!MdsFrame.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsFrame)

  -- Setup autonaming

  if !!MdsAutoName.FileName.unset() then
    !!MdsAutoname.Filename = object file('$!!PDMSDFLTS\DES-SUPP-NAMES')
  endif

-- Set the name gadget as the focus

  !!MdsFrame.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsiframe.pml
