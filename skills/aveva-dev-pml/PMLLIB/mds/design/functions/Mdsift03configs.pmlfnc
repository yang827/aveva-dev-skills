--
-- File:		Mdsift03configs.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS126W
--
-- Author:		I.Osborne
-- Created:		Tue Jun 03
--
--
-- Description:
-- Initialisation to frame type 03 configurations
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFt03Configs()

  -- Redefine standard support name on form title

    !Index = !!MdsFrame.Standard.Rtext.findfirst('FT03')
    !Text  = !!MdsFrame.Standard.Dtext[!Index]
       handle (61,567) (61,615)
         !!MdsPopulate(!!MdsFrame,'FRAME')
         !Index = !!MdsFrame.Standard.Rtext.findfirst('FT03')
         !Text  = !!MdsFrame.Standard.Dtext[!Index]
       endhandle
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()

    call !!MdsSetFormName(!!MdsFt03Configs, 'PIPE', '$!FormName')

-- End function
endfunction

-- End of file Mdsift03configs.pml
