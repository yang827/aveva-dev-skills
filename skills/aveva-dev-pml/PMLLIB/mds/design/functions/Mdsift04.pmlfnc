--------------------------------------------------------------------------------
--
-- File:    Mdsift04.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          IPS127
--
-- Author:    I.osborne
-- Created:   Mon Jun 23
--
--
-- Description:
-- Initialisation for form ft04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt04(!modify is STRING, !textName is STRING, !alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft04.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsOptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft04

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  -- !!mdsft04.create.select('Rtext', 'CURSOR')
  -- !!mdsft04.select.select('RTEXT', 'IDCUR')
  -- !!mdsft04.nudge.val = 0
  !!mdsft04.datum.active = true
  !!mdsft04.cancel.active = true
  !!mdsft04.ancmat.active = true

  -- FT04 has an alias from the cable rack frameworks called CT01
  -- and a alias from the HVAC frameworks called DT04

  if (!alias eq 'FT04') then
    !!mdsft04.addPipe.active = true
    !!mdsft04.addHVAC.active = true
    !!mdsft04.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/FT04-HORI ) then
      !!mdsft04.addBar.active = true
    else
      !!mdsft04.addBar.active = false
    endif
    -- Select Slide gadget for FT04
    !!mdsft04.slide.select('DTEXT', 'Top')
    !!mdsft04.slide.active = true
    !!mdsft04.rotate.active = true
    !!mdsft04.modAtta.active = true
    !!mdsft04.addPack.active = true
    !!mdsft04.delPack.active = true
    !!mdsft04.rotAtt.active = true
    !!mdsft04.flipAtta.active = TRUE
  elseif (!alias eq 'CT01') then
    !!mdsft04.addPipe.active = false
    !!mdsft04.addHVAC.active = false
    !!mdsft04.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/CT01 ) then
      !!mdsft04.addBar.active = true
    else
      !!mdsft04.addBar.active = false
    endif
    -- Grey out slide gadget because horizontal frame not allowed for cable
    !!mdsft04.slide.select('DTEXT', 'Top')
    !!mdsft04.slide.active = false
    !!mdsft04.rotate.active = false
    !!mdsft04.modAtta.active = TRUE
    !!mdsft04.addPack.active = false
    !!mdsft04.delPack.active = false
    !!mdsft04.rotAtt.active = false
    !!mdsft04.ancmat.active = false
    !!mdsft04.flipAtta.active = true
  elseif (!alias eq 'DT04') then
    !!mdsft04.addPipe.active = false
    !!mdsft04.addHVAC.active = true
    !!mdsft04.addRack.active = false
    if (:MdsBars of /MDS/FRAMES/DT01 ) then
      !!mdsft04.addBar.active = true
    else
      !!mdsft04.addBar.active = false
    endif
    -- Grey out slide gadget because horizontal frame not allowed for cable
    !!mdsft04.slide.select('DTEXT', 'Top')
    !!mdsft04.slide.active = false
    !!mdsft04.rotate.active = false
    !!mdsft04.modAtta.active = false
    !!mdsft04.addPack.active = false
    !!mdsft04.delPack.active = false
    !!mdsft04.rotAtt.active = false
    !!mdsft04.ancmat.active = false
    !!mdsft04.flipAtta.active = false
  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
    !!mdsft04.cancel.callback = |Call !!mdsCancelSupp(!!mdsft04)|
    !support.modify = false

    -- Initialise variables for new supports

    if (!alias eq 'FT04') then
      !support.replace = !!mdsFrame.replacement
      !support.type    = !!mdsFrame.standard.selection('Rtext')
      !struName        = !!mdsFrame.name.val
    elseif (!alias eq 'CT01') then
      !support.replace = !!mdsCable.replacement
      !support.type    = !!mdsCable.standard.selection('Rtext')
      !struName        = !!mdsCable.name.val
    elseif (!alias eq 'DT04') then
      !support.replace = !!mdsHvac.replacement
      !support.type    = !!mdsHvac.standard.selection('Rtext')
      !struName        = !!mdsHvac.name.val
    endif

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft04.name.val = !struName

    !!mdsft04.dim1.val = 0
    !!mdsft04.dim2.val = 0
    !!mdsft04.dist.val = 0
    !!mdsft04.p.val = ''

    if (!alias eq 'FT04') then
      !!mdsFrame.hide()
    elseif (!alias eq 'CT01') then
      !!mdsCable.hide()
    elseif (!alias eq 'DT04') then
      !!mdsHvac.hide()
    endif

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsft04.createByDim.active = true
    !!mdsft04.createByCle.active = true
    !!mdsft04.createByCur.active = true
    ------------------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!name & '-V1')

  else  $* its modify mode

    -- Set callback on cancel button and set mode member of support object
    !!mdsft04.cancel.callback = |Call !!mdsRestoreForm(!!mdsft04)|
    !support.modify = true
    !!mdsft04.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    if !!ce.type.eq('CTSUPP') then
      !pa = 'p1'
      !pl = 'p2'
    else
      !pa = 'pa'
      !pl = 'pl'
    endif
    !support.pADir  = $!pa Dir wrt world
    !support.pLDir  = $!pl Dir wrt world

    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 04 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    !support.config = !split[1].real()
    if (!split[2] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[3] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[4].real()
    if (!split[5] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft04.name.val = !name
    !!mdsft04.dim1.val = 0
    !!mdsft04.dim2.val = 0
    !!mdsft04.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft04.lineUp.active = True
    -- endif

    -- set support object connections
    !vertDbref[1] = object DBREF(!name & '-V1')
    !support.connections[1] = !vertDbref[1].:MDSConn

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints
    !support.joints = !!mdsGetJoints(!vertDbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft04.createByDim.active = false
      !!mdsft04.createByCle.active = true
      !!mdsft04.createByCur.active = true
    else
      !!mdsft04.createByDim.active = true
      !!mdsft04.createByCle.active = true
      !!mdsft04.createByCur.active = true
    endif
    -------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!vertDbref[1])

  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsft04.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft04)
  !!mdsft04.support.mdssctnsstore = !!mdsft04.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft04.repre.clear()
  !!mdsft04.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level cable
  !!mdsft04.repre.append(|Call !!kRepreLevel(Nulref, 'CABLE', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft04.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft04.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft04.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 4 or alias

  if (!alias eq 'FT04') then
    !!ce = /MDS/FRAMES/FT04-HORI
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT01') then
    !!ce = /MDS/FRAMES/CT01
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'DT04') then
    !!ce = /MDS/FRAMES/DT04
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  endif

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsft04,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsft04.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsft04.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsft04.select.active = TRUE
  handle ANY
  endhandle
  !!mdsft04.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft04,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft04,'-BAR-1','-V1')

    !!ce = !!mdsft04.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft04)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsft04.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar


    !!mdsft04.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft04.dim2.val = !despars[2]
    handle any
      !!mdsft04.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT04') then
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsFrame,'FRAME')
      !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
      !text  = !!mdsFrame.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT01') then
    !index = !!mdsCable.standard.rtext.findfirst('$!alias')
    !text  = !!mdsCable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsCable,'CABLE')
      !index = !!mdsCable.standard.rtext.findfirst('$!alias')
      !text  = !!mdsCable.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'DT04') then
    !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
    !text  = !!mdsHvac.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsHvac,'HVAC')
      !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
      !text  = !!mdsHvac.standard.dtext[!index]
    endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft04.support.replace = !formName

  if (!alias eq 'FT04') then
    call !!mdsSetFormName(!!mdsft04, 'PIPE', '$!formName')
  elseif (!alias eq 'CT01') then
    call !!mdsSetFormName(!!mdsft04, 'TRAY', '$!formName')
  elseif (!alias eq 'DT04') then
    call !!mdsSetFormName(!!mdsft04, 'HVAC', '$!formName')
  endif

  !!ce = !!mdsft04.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    if !alias neq 'DT04' then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-C-1-1')
    else
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-C-1')
    endif
  else
    if !alias neq 'DT04' then
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-C-1-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-C-1')
    endif
  endif

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft04.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsft04.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      if !!ce.type.eq('CTSUPP') then
        !!kRepreLevel(!!ce, 'CABLE',!!mdsOptions.levChange, $!colour)
      else
        !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      endif
      --call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft04.connect.active = False
    !!mdsft04.modify.active = False
    !!mdsft04.disconn.active = False
    !!mdsft04.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft04.support.stru.unset()) then
    !!mdsft04.connect.active = False
    !!mdsft04.modify.active = False
    !!mdsft04.forceCon.active = False
    !!mdsft04.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft04.connect.active = True
    !!mdsft04.forceCon.active = False
    !!mdsft04.modify.active = False
    !!mdsft04.disconn.active = True
  else
    !!mdsft04.connect.active  = True
    !!mdsft04.modify.active   = True
    !!mdsft04.forceCon.active = True
    !!mdsft04.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft04)
  --<dw>sep2007

  -- Store current form information
  !!mdsft04.support.storeFt(!!mdsft04)

  -- Set dimensions toggle

  !!mdsft04.graphicalDim = false

  -- Show Form for frame type FT04
  !!kShowForm(!!mdsft04)

  !!kRestoreUnits(!currentunits)
  !form.newdat.active = !uniquenames.not()

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
