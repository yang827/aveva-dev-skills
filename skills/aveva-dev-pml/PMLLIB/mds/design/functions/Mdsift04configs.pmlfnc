-- Created:		Mon Jun 23
--
--
-- Description:
-- Initialisation to frame type 04 configurations
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFt04Configs()

  -- Redefine standard support name on form title

    !Index = !!MdsFrame.Standard.Rtext.findfirst('FT04')
    !Text  = !!MdsFrame.Standard.Dtext[!Index]
      handle (61,567) (61,615)
           !!MdsPopulate(!!MdsFrame,'FRAME')
           !Index = !!MdsFrame.Standard.Rtext.findfirst('FT04')
           !Text  = !!MdsFrame.Standard.Dtext[!Index]
      endhandle
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()

    call !!MdsSetFormName(!!MdsFt04Configs, 'PIPE', '$!FormName')

-- End function
endfunction

-- End of file Mdsift04configs.pml
