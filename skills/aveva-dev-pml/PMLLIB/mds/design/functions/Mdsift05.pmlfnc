--------------------------------------------------------------------------------
--
-- File:    Mdsift05.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          IPS128
--
-- Author:    I.osborne
-- Created:   Mon Jun 23
--
--
-- Description:
-- Initialisation for form ft05
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt05(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft05.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft05

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  -- !!mdsft05.create.select('Rtext', 'CURSOR')
  -- !!mdsft05.select.select('RTEXT', 'IDCUR')
  -- !!mdsft05.nudge.val = 0
  !!mdsft05.datum.active = true
  !!mdsft05.cancel.active = true
  !!mdsft05.ancmat.active = true

  -- FT05 has an alias from the cable rack frameworks called CT03

  if (!alias eq 'FT05') then
    !!mdsft05.addPipe.active = true
    !!mdsft05.addHVAC.active = true
    !!mdsft05.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/FT05 ) then
      !!mdsft05.addBar.active = true
    else
      !!mdsft05.addBar.active = false
    endif
    !!mdsft05.rotate.active = true
    !!mdsft05.modAtta.active = true
    !!mdsft05.addPack.active = true
    !!mdsft05.delPack.active = true
    !!mdsft05.rotAtt.active = true
    !!mdsft05.flipAtta.active = TRUE
  elseif (!alias eq 'CT03') then
    !!mdsft05.addPipe.active = false
    !!mdsft05.addHVAC.active = false
    !!mdsft05.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/CT03 ) then
      !!mdsft05.addBar.active = true
    else
      !!mdsft05.addBar.active = false
    endif
    !!mdsft05.rotate.active = false
    !!mdsft05.modAtta.active = false
    !!mdsft05.addPack.active = false
    !!mdsft05.delPack.active = false
    !!mdsft05.rotAtt.active = false
    !!mdsft05.ancmat.active = false
    !!mdsft05.flipAtta.active = true
  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft05.cancel.callback = |Call !!mdsCancelSupp(!!mdsft05)|
    !support.modify = false

    -- Initialise variables for new supports

    if (!alias eq 'FT05') then
      !support.replace = !!mdsFrame.replacement
      !support.type    = !!mdsFrame.standard.selection('Rtext')
      !struName        = !!mdsFrame.name.val
    elseif (!alias eq 'CT03') then
      !support.replace = !!mdsCable.replacement
      !support.type    = !!mdsCable.standard.selection('Rtext')
      !struName        = !!mdsCable.name.val
    endif

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft05.name.val = !struName

    !!mdsft05.dim1.val = 0
    !!mdsft05.dim2.val = 0
    !!mdsft05.dist.val = 0
    !!mdsft05.p.val = ''

    if (!alias eq 'FT05') then
      !!mdsFrame.hide()
    elseif (!alias eq 'CT03') then
      !!mdsCable.hide()
    endif

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsft05.createByDim.active = true
    !!mdsft05.createByCle.active = true
    !!mdsft05.createByCur.active = true
    ------------------------------------------------------------------------------

  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsft05.cancel.callback = |Call !!mdsRestoreForm(!!mdsft05)|
    !support.modify = true
    !!mdsft05.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = !alias
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    if !!ce.type.eq('CTSUPP') then
      !pa = 'p1'
      !pl = 'p2'
    else
      !pa = 'pa'
      !pl = 'pl'
    endif
    !support.pADir  = $!pa Dir wrt world
    !support.pLDir  = $!pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 05 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo
    else

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft05.name.val = !name
    !!mdsft05.dim1.val = 0
    !!mdsft05.dim2.val = 0
    !!mdsft05.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft05.lineUp.active = True
    -- endif

    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !support.connections[1] = !conn1

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)



    -- set support object for joints
    !support.joints = !!mdsGetJoints(!vertDbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft05.createByDim.active = false
      !!mdsft05.createByCle.active = true
      !!mdsft05.createByCur.active = true
    else
      !!mdsft05.createByDim.active = true
      !!mdsft05.createByCle.active = true
      !!mdsft05.createByCur.active = true
    endif
    -------------------------------------------------------------------

  endif

  -- Store support object in form
  !!mdsft05.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft05)
  !!mdsft05.support.mdssctnsstore = !!mdsft05.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft05.repre.clear()
  !!mdsft05.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft05.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft05.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft05.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 5
  if (!alias eq 'FT05') then
    !!ce = /MDS/FRAMES/FT05
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT03') then
    !!ce = /MDS/FRAMES/CT03
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  endif

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsft05,'-BAR-1','-V1')

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft05,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft05,'-BAR-1','-V1')

    !!ce = !!mdsft05.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft05)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsft05.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsft05.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft05.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft05.dim2.val = !despars[2]
    handle any
      !!mdsft05.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT05') then
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsFrame,'FRAME')
      !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
      !text  = !!mdsFrame.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT03') then
    !index = !!mdsCable.standard.rtext.findfirst('$!alias')
    !text  = !!mdsCable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsCable,'CABLE')
      !index = !!mdsCable.standard.rtext.findfirst('$!alias')
      !text  = !!mdsCable.standard.dtext[!index]
    endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft05.support.replace = !formName

  if (!alias eq 'FT05') then
    call !!mdsSetFormName(!!mdsft05, 'PIPE', '$!formName')
  elseif (!alias eq 'CT03') then
    call !!mdsSetFormName(!!mdsft05, 'TRAY', '$!formName')
  endif

  !!ce = !!mdsft05.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-C-1-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-C-1-1')
  endif

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft05.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsft05.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      if !!ce.type.eq('CTSUPP') then
        !!kRepreLevel(!!ce, 'CABLE',!!mdsOptions.levChange, $!colour)
      else
        !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      endif
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft05.connect.active = False
    !!mdsft05.modify.active = False
    !!mdsft05.disconn.active = False
    !!mdsft05.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft05.support.stru.unset()) then
    !!mdsft05.connect.active = False
    !!mdsft05.modify.active = False
    !!mdsft05.forceCon.active = False
    !!mdsft05.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft05.connect.active = True
    !!mdsft05.forceCon.active = False
    !!mdsft05.modify.active = False
    !!mdsft05.disconn.active = True
  else
    !!mdsft05.connect.active  = True
    !!mdsft05.modify.active   = True
    !!mdsft05.forceCon.active = True
    !!mdsft05.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft05)
  --<dw>sep2007
  -- Store current form information
  call !!mdsStoreFt05()

  -- Set dimensions toggle

  !!mdsft05.graphicalDim = false

  -- Show Form for frame type FT05
  !!kShowForm(!!mdsft05)

  !!kRestoreUnits(!currentunits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
