--------------------------------------------------------------------------------
--
-- File: Mdsift09.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: DESIGN
--   Replaces: IPS132
--
-- Author: I.osborne
-- Created: Wed Jul 02
--
--
-- Description:
-- Initialisation for form ft09
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsift09(!modify is STRING, !textname is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft09.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsoptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Turn all form gadget active
  !!kresetactive(!!mdsft09 , TRUE)

  -- Initialise Variables
  !name = '/' & !textname
  !form = !!mdsft09

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft09.select.select('RTEXT', 'IDCUR')
  !!mdsft09.datum.active = TRUE
  !!mdsft09.cancel.active = TRUE

  -- FT09 has an alias from the cable rack frameworks called CT05 and
  -- from the HVAC frameworks called DT01

  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then

    !!mdsft09.addpipe.active = TRUE
    !!mdsft09.addhvac.active = TRUE
    !!mdsft09.addrack.active = TRUE
    if (:mdsbars of /MDS/FRAMES/$!alias ) then
      !!mdsft09.addbar.active = TRUE
    else
      !!mdsft09.addbar.active = false
    endif
    !!mdsft09.rotate.active = TRUE
    !!mdsft09.modatta.active = TRUE
    !!mdsft09.addpack.active = TRUE
    !!mdsft09.delpack.active = TRUE
    !!mdsft09.rotatt.active = TRUE
    !!mdsft09.flipatta.active = TRUE

  elseif (!alias eq 'CT05') then

    !!mdsft09.addpipe.active = false
    !!mdsft09.addhvac.active = false
    !!mdsft09.addrack.active = TRUE
    if (:mdsbars of /MDS/FRAMES/CT05 ) then
      !!mdsft09.addbar.active = TRUE
    else
      !!mdsft09.addbar.active = false
    endif
    !!mdsft09.rotate.active = false
    !!mdsft09.modatta.active = false
    !!mdsft09.addpack.active = false
    !!mdsft09.delpack.active = false
    !!mdsft09.rotatt.active = false
    !!mdsft09.ancmat.active = false
    !!mdsft09.flipatta.active = TRUE

  elseif (!alias eq 'DT01') then

    !!mdsft09.addpipe.active = false
    !!mdsft09.addhvac.active = TRUE
    !!mdsft09.addrack.active = false
    !!mdsft09.addbar.active = false
    !!mdsft09.rotate.active = false
    !!mdsft09.modatta.active = false
    !!mdsft09.addpack.active = false
    !!mdsft09.delpack.active = false
    !!mdsft09.rotatt.active = false
    !!mdsft09.ancmat.active = false
    !!mdsft09.flipatta.active = false

  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotatecur = false
  !support.handedcur = false
  !support.rotated   = 0
  !support.bpnum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft09.cancel.callback = |call !!mdscancelsupp(!!mdsft09)|
    !support.modify = false

    -- Initialise variables for new supports
    if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
      !support.replace = !!mdsframe.replacement
      !support.type    = !!mdsframe.standard.selection('Rtext')
      !struname        = !!mdsframe.name.val
    elseif (!alias eq 'CT05') then
      !support.replace = !!mdscable.replacement
      !support.type    = !!mdscable.standard.selection('Rtext')
      !struname        = !!mdscable.name.val
    elseif (!alias eq 'DT01') then
      !support.replace = !!mdshvac.replacement
      !support.type    = !!mdshvac.standard.selection('Rtext')
      !struname        = !!mdshvac.name.val
    endif

    -- Navigate to correct area
    if (!!mdsmovetosite('').not())then
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endif

    !!mdsdaccontrol(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struname

    !support.stru = !!ce
    :mdssupptype |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft09.name.val = !struname

    !!mdsft09.dim1.val = 0
    !!mdsft09.dim2.val = 0
    !!mdsft09.dim3.val = 0
    !!mdsft09.dim4.val = 0
    !!mdsft09.dist.val = 0
    !!mdsft09.p.val = ''

    if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
      !!mdsframe.hide()
    elseif (!alias eq 'CT05') then
      !!mdscable.hide()
    elseif (!alias eq 'DT01') then
      !!mdshvac.hide()
    endif
    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsft09.createbydim.active = true
    !!mdsft09.createbycle.active = true
    !!mdsft09.createbycur.active = true
    ------------------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!support.stru.name & '-V1')
    !association[2] = object MDSASSOCIATION(!support.stru.name & '-V2')

  else   $* its modify mode

    -- Set callback on cancel button
    !!mdsft09.cancel.callback = |call !!mdsrestoreform(!!mdsft09)|
    !support.modify = TRUE
    !!mdsft09.datum.active = false

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = TRUE
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:mdscp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    if !!ce.type.eq('CTSUPP') then
      !pa = 'p1'
      !pl = 'p2'
    else
      !pa = 'pa'
      !pl = 'pl'
    endif
    !support.pADir  = $!pa Dir wrt world
    !support.pLDir  = $!pl Dir wrt world
    !support.p9dir  = P9 dir wrt world
    !support.p10dir = P10 dir wrt world
    !support.p11dir = P11 dir wrt world

    -- Get Specific data to frame type 09 from :MDSCp1 on datum atta
    !data = !!ce.:mdscp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotatecur = TRUE
    else
      !support.rotatecur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedcur = TRUE
    else
      !support.handedcur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kcollectallfor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :mdsattaref
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Store section name and matref for each member

    !storemat = ARRAY()
    !storemat = !!mdsstoremat(!name)
    !support.material = !storemat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bpref1 :mdsbpref1
    var !bpref2 :mdsbpref2
    if (!!ce.:mdsbpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
    endif
    if (!!ce.:mdsbpref2.badref().not()) then
      !support.bedplate2 = !bpref2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft09.name.val = !name
    !!mdsft09.dim1.val = 0
    !!mdsft09.dim2.val = 0
    !!mdsft09.dim3.val = 0
    !!mdsft09.dim4.val = 0
    !!mdsft09.p.val    = ''

    !!mdsaddall('$!textname')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft09.lineup.active = TRUE
    -- endif

    -- set support object connections
    --<kp>jan2012
    !vertDbref = !support.verticals()
    !support.connections[1] = !vertDbref[1].:MDSConn
    !support.connections[2] = !vertDbref[2].:MDSConn

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints
    !support.joints = !!mdsgetjoints(!vertDbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft09.createbydim.active = false
      !!mdsft09.createbycle.active = TRUE
      !!mdsft09.createbycur.active = TRUE
    else
      !!mdsft09.createbydim.active = TRUE
      !!mdsft09.createbycle.active = TRUE
      !!mdsft09.createbycur.active = TRUE
    endif

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!vertDbref[1])
    !association[2] = object MDSASSOCIATION(!vertDbref[2])

    -------------------------------------------------------------------
  endif

   --<kp>jan2012
   -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsft09.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft09)
  !!mdsft09.support.mdssctnsstore = !!mdsft09.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft09.repre.clear()
  !!mdsft09.repre.append(|Call !!kRepreLevel(nulref, '', $!repre,0)|)
  var !repre repre level cable
  !!mdsft09.repre.append(|Call !!kRepreLevel(Nulref, 'CABLE', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft09.repre.append(|Call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft09.repre.append(|Call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft09.repre.append(|Call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)


  -- Collect all supports for frame type 9
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    --------------------------------------------
    !!kRestoreUnits(!currentunits)
    --------------------------------------------
    return
  endhandle

  -- Generate Steel Size List

  !!mdssetsteel.init('HIDE',!!mdsft09,'-BAR-1','-V1')

  !!ce = !support.stru

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsft09.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsft09.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsft09.select.active = TRUE
  handle ANY
  endhandle
  !!mdsft09.bthro.active = TRUE
  handle ANY
  endhandle

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdssetsize('SELECT',!!mdsft09,'-BAR-1','-V1')
    !!mdssetsteel.init('HIDE',!!mdsft09,'-BAR-1','-V1')

    !!ce = !!mdsft09.support.datum

    -- Set distance gadget

    !!mdsdistance(!!mdsft09)


    -- Store Atta reference in form
    if !uniquenames then
    	!form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    ---------------------------------------------------------------------------------------
    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the support.atta array

    !!mdspackattas(!!mdsft09.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()

    !despars = despar
    !!mdsft09.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft09.dim2.val = !despars[2]
    handle any
      !!mdsft09.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft09.dim3.val = !despars[3]
    handle any
      !!mdsft09.dim1.val = 0
      !!mdsft09.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft09.dim4.val = !despars[4]
    handle any
      !!mdsft09.dim1.val = 0
      !!mdsft09.dim2.val = 0
      !!mdsft09.dim3.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdspopulate(!!mdsframe,'FRAME')
      !index = !!mdsframe.standard.rtext.findfirst('$!alias')
      !text  = !!mdsframe.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT05') then
    !index = !!mdscable.standard.rtext.findfirst('$!alias')
    !text  = !!mdscable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdspopulate(!!mdscable,'CABLE')
      !index = !!mdscable.standard.rtext.findfirst('$!alias')
      !text  = !!mdscable.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'DT01') then
    !index = !!mdshvac.standard.rtext.findfirst('$!alias')
    !text  = !!mdshvac.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdspopulate(!!mdshvac,'HVAC')
      !index = !!mdshvac.standard.rtext.findfirst('$!alias')
      !text  = !!mdshvac.standard.dtext[!index]
    endhandle
  endif
  !suppnumber = before(!text, '-')
  !formname   = !suppnumber.trim()
  !!mdsft09.support.replace = !formname

  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
    call !!mdssetformname(!!mdsft09, 'PIPE', '$!formname')
  elseif (!alias eq 'CT05') then
    call !!mdssetformname(!!mdsft09, 'TRAY', '$!formname')
  elseif (!alias eq 'DT01') then
    call !!mdssetformname(!!mdsft09, 'HVAC', '$!formname')
  endif

  !!ce = !!mdsft09.support.stru

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft09.support.atta
      !!ce = !addrepre
      skip if (match(name,|SREF|)gt 0)
      !colour = !!kfinddrawcolour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsft09.repre.append('!!mdsremadd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsoptions.levchange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsoptions.levchange, $!colour)
      !colourlist = ARRAY()
      !colourlist.append(!!ce.name.dbref())
      call !!kenhancelist(!colourlist)
    enddo
  endif

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    if !alias neq 'DT01' then
      !!mdssetsuppcode('CREATE',!name,!alias,'$!alias-1-1')
    else
      !!mdssetsuppcode('CREATE',!name,!alias,'$!alias-1')
    endif
  else
    if !alias neq 'DT01' then
      !!mdssetsuppcode('MODIFY',!name,!alias,'$!alias-1-1')
    else
      !!mdssetsuppcode('MODIFY',!name,!alias,'$!alias-1')
    endif
  endif

  --

  ----------------------------------------------------------------

  -- Set dimensions toggle
  !!mdsft09.graphicaldim = false

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft09)
  --<dw>sep2007
  -- Store current form information
  !!mdsft09.support.storeFt(!!mdsft09)

  -- now generic to all supports
  -- Change for Claim & DACs
  -- if (!modify.upcase() eq |MODIFY|)then
  --   !!mdsShowConns(!!mdsft09)
  -- endif

  -- Show Form for frame type FT09
  !!kshowform(!!mdsft09)

  --------------------------------------------
  !!kRestoreUnits(!currentunits)
  --------------------------------------------

  !form.newdat.active = !uniquenames.not()

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
-- End of function definition for !!mdsift09
