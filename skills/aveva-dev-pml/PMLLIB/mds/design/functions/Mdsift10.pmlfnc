--------------------------------------------------------------------------------
--
-- File:  Mdsift10.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS133
--
-- Author:  I.osborne
-- Created:  Thu Jul 03
--
--
-- Description:
-- Initialisation for form ft10
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt10(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT10.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  !uniquenames = !!mdsOptions.mdsuniquenames

  !form = !!mdsFT10

  -- <sk> 04/06/2012
  !fromAtta = false

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName

  -- Initialise Standard gadgets
  !!mdsFT10.select.select('RTEXT', 'IDCUR')
  !!mdsFT10.datum.active = true
  !!mdsFT10.cancel.active = true
  !!mdsFT10.rotate.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFT10.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT10)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT10.name.val = !struName

    !!mdsFT10.dim1.val = 0
    !!mdsFT10.dim2.val = 0
    !!mdsFT10.dim3.val = 0
    !!mdsFT10.dist.val = 0
    !!mdsFT10.p.val = ''

    !!mdsFrame.hide()

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    --<<ge 15/04/05 Deactivated Clearance option

    !!mdsFT10.createByDim.active = true
    !!mdsFT10.createByCle.active = FALSE
    !!mdsFT10.createByCur.active = true
    ------------------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!name & '-V1')
    !association[2] = object MDSASSOCIATION(!name & '-BAR-1')

  else   $* its modify mode

    -- Set callback on cancel button
    !!mdsFT10.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT10)|
    !support.modify = true
    !!mdsFT10.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT10'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 10 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce = !support.stru
    !bar = !name & '-BAR-1'

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT10.name.val = !name
    !!mdsFT10.dim1.val = 0
    !!mdsFT10.dim2.val = 0
    !!mdsFT10.dim3.val = 0
    !!mdsFT10.p.val    = ''

    !!mdsAddAll('$!textName')
    --$(
    ------------------------------ ***** Connexions --------------------

    -- if(!support.connections.size().eq(1)) then
    -- !!mdsFT10.lineUp.active = True
    -- endif

    -- set support object connections
    !connectedSctns[1] = object DBREF(!name & '-V1')
    !connectedSctns[2] = object DBREF(!name & '-BAR-1')
    !support.connections[1] = !connectedSctns[1].:MDSConn
    !support.connections[2] = !connectedSctns[2].:MDSConn

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!connectedSctns)
    --$)
    -------------------------------------------------------------------

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT10.createByDim.active = false
      !!mdsFT10.createByCle.active = FALSE
      !!mdsFT10.createByCur.active = true
    else
      !!mdsFT10.createByDim.active = true
      !!mdsFT10.createByCle.active = FALSE
      !!mdsFT10.createByCur.active = true
    endif

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!connectedSctns[1])
    !association[2] = object MDSASSOCIATION(!connectedSctns[2])

    -------------------------------------------------------------------
  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsFT10.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsFT10)
  !!mdsFT10.support.mdssctnsstore = !!mdsFT10.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT10.repre.clear()
  !!mdsFT10.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT10.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT10.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT10.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 10
  !!ce = /MDS/FRAMES/FT10
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsFT10,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT10.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT10.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT10.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT10.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT10,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT10,'-BAR-1','-V1')

    !!ce = !!mdsFT10.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT10)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT10.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar


    !!mdsFT10.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT10.dim2.val = !despars[2]
    handle any
      !!mdsFT10.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT10.dim3.val = !despars[3]
    handle any
      !!mdsFT10.dim1.val = 0
      !!mdsFT10.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT10')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT10')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT10.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT10, 'PIPE', '$!formName')

  !!ce = !!mdsFT10.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT10-C-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT10-C-1')
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT10.connect.active = False
    !!mdsFT10.modify.active = False
    !!mdsFT10.disconn.active = False
    !!mdsFT10.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT10.support.stru.unset()) then
    !!mdsFT10.connect.active = False
    !!mdsFT10.modify.active = False
    !!mdsFT10.forceCon.active = False
    !!mdsFT10.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT10.connect.active = True
    !!mdsFT10.forceCon.active = False
    !!mdsFT10.modify.active = False
    !!mdsFT10.disconn.active = True
  else
    !!mdsFT10.connect.active  = True
    !!mdsFT10.modify.active   = True
    !!mdsFT10.forceCon.active = True
    !!mdsFT10.disconn.active  = True
  endif
  ----------------------------------------------------------------
  --$)

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsFT10)
  --<dw>sep2007
  -- Store current form information
  !!mdsFT10.support.storeFt(!!mdsFT10)

  -- Set dimensions toggle

  !!mdsFT10.graphicalDim = false

  -- Show Form for frame type FT10
  !!kShowForm(!!mdsFT10)

  !!kRestoreUnits(!currentunits)
  !form.newdat.active = !uniquenames.not()

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
