--------------------------------------------------------------------------------
--
-- File:  Mdsift11.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS134
--
-- Author:  I.osborne
-- Created:  Mon Jul 14
--
--
-- Description:
-- Initialisation for form ft11
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt11(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------
  !form = !!mdsFT11

  if !!mdsFT11.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  !uniquenames = !!mdsOptions.mdsuniquenames

  -- <sk> 04/06/2012
  !fromAtta = false


  !form.dim1.active = true
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName

  -- Initialise Standard gadgets
  !!mdsFT11.select.select('RTEXT', 'IDCUR')
  !!mdsFT11.datum.active = true
  !!mdsFT11.cancel.active = true
  !!mdsFT11.ancmat.active = true

  -- FT11 has an alias from the HVAC frameworks called DT02

  if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then

    !!mdsFT11.addPipe.active = true
    !!mdsFT11.addHVAC.active = true
    !!mdsFT11.addRack.active = true
    !!mdsFT11.rotate.active = true
    !!mdsFT11.modAtta.active = true
    !!mdsFT11.rotAtt.active = true
    if (!alias.eq('FT11')) then
      !!mdsFT11.addPack.active = true
      !!mdsFT11.delPack.active = true
    elseif (!alias.eq('FT38') or !alias.eq('FT62') or !alias.eq ('FT63')) then
      !!mdsFT11.addPack.active = false
      !!mdsFT11.delPack.active = false
    endif
  elseif (!alias eq 'DT02') then

    !!mdsFT11.addPipe.active = false
    !!mdsFT11.addHVAC.active = true
    !!mdsFT11.addRack.active = false
    !!mdsFT11.rotate.active = false
    !!mdsFT11.modAtta.active = false
    !!mdsFT11.addPack.active = false
    !!mdsFT11.delPack.active = false
    !!mdsFT11.rotAtt.active = false
    !!mdsFT11.ancmat.active = false

  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFT11.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT11)|
    !support.modify = false

    -- Initialise variables for new supports
    if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
      !support.replace = !!mdsFrame.replacement
      !support.type    = !!mdsFrame.standard.selection('Rtext')
      !struName        = !!mdsFrame.name.val
    elseif (!alias eq 'DT02') then
      !support.replace = !!mdsHvac.replacement
      !support.type    = !!mdsHvac.standard.selection('Rtext')
      !struName        = !!mdsHvac.name.val
    endif

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT11.name.val = !struName

    !!mdsFT11.dim1.val = 0
    !!mdsFT11.dim2.val = 0
    !!mdsFT11.dim3.val = 0
    !!mdsFT11.dist.val = 0
    !!mdsFT11.p.val = ''

    if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
      !!mdsFrame.hide()
    elseif (!alias eq 'DT02') then
      !!mdsHvac.hide()
    endif

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsFT11.createByDim.active = true
    !!mdsFT11.createByCle.active = false
    !!mdsFT11.createByCur.active = true
    ------------------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!name & '-V1')
    !association[2] = object MDSASSOCIATION(!name & '-BAR-1')

  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsFT11.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT11)|
    !support.modify = true
    !!mdsFT11.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 11 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce = !support.stru
    !bar = !name & '-BAR-1'

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT11.name.val = !name
    !!mdsFT11.dim1.val = 0
    !!mdsFT11.dim2.val = 0
    !!mdsFT11.dim3.val = 0
    !!mdsFT11.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    --$(
    -- set support object connections
    !connectedSctns[1] = object DBREF(!name & '-V1')
    !connectedSctns[2] = object DBREF(!name & '-BAR-1')
    if !connectedSctns[1].:MDSConn.badref().not() then
      !support.connections[1] = !connectedSctns[1].:MDSConn
    endif
    if !connectedSctns[2].:MDSConn.badref().not() then
      !support.connections[2] = !connectedSctns[2].:MDSConn
    endif

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)


    -- set support object for joints

    !support.joints = !!mdsGetJoints(!connectedSctns)
    --$)
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT11.createByDim.active = false
      !!mdsFT11.createByCle.active = false
      !!mdsFT11.createByCur.active = true
    else
      !!mdsFT11.createByDim.active = true
      !!mdsFT11.createByCle.active = false
      !!mdsFT11.createByCur.active = true
    endif

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!connectedSctns[1])
    !association[2] = object MDSASSOCIATION(!connectedSctns[2])

    -------------------------------------------------------------------
  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsFT11.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsFT11)
  !!mdsFT11.support.mdssctnsstore = !!mdsFT11.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT11.repre.clear()
  !!mdsFT11.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT11.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT11.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT11.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 11
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  !!mdsSetSteel.init('HIDE',!!mdsFT11,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT11.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT11.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT11.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT11.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT11,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT11,'-BAR-1','-V1')

    !!ce = !!mdsFT11.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT11)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT11.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT11.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT11.dim2.val = !despars[2]
    handle any
      !!mdsFT11.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT11.dim3.val = !despars[3]
    handle any
      !!mdsFT11.dim1.val = 0
      !!mdsFT11.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsFrame,'FRAME')
      !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
      !text  = !!mdsFrame.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'DT02') then
    !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
    !text  = !!mdsHvac.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsHvac,'HVAC')
      !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
      !text  = !!mdsHvac.standard.dtext[!index]
    endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT11.support.replace = !formName

  if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
    call !!mdsSetFormName(!!mdsFT11, 'PIPE', '$!formName')
  elseif (!alias eq 'DT02') then
    call !!mdsSetFormName(!!mdsFT11, 'HVAC', '$!formName')
  endif

  !!ce = !!mdsFT11.support.stru

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsFT11.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsFT11.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    if !alias.eq('DT02') or !alias.eq('FT38') then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1')
    elseif !alias.eq('FT62') or !alias.eq('FT63') then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1-1')
    else
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-C-1')
    endif
  else
    if !alias.eq('DT02') or !alias.eq('FT38') then
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1')
    elseif !alias.eq('FT62') or !alias.eq('FT63') then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-C-1')
    endif
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT11.connect.active = False
    !!mdsFT11.modify.active = False
    !!mdsFT11.disconn.active = False
    !!mdsFT11.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT11.support.stru.unset()) then
    !!mdsFT11.connect.active = False
    !!mdsFT11.modify.active = False
    !!mdsFT11.forceCon.active = False
    !!mdsFT11.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT11.connect.active = True
    !!mdsFT11.forceCon.active = False
    !!mdsFT11.modify.active = False
    !!mdsFT11.disconn.active = True
  else
    !!mdsFT11.connect.active  = True
    !!mdsFT11.modify.active   = True
    !!mdsFT11.forceCon.active = True
    !!mdsFT11.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsFT11)
  --<dw>sep2007
  -- Store current form information
  !!mdsFT11.support.storeFt(!!mdsFT11)

  -- Show Form for frame type FT11
  !!kShowForm(!!mdsFT11)

  -- Set dimensions toggle

  !!mdsFT11.graphicalDim = false

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
