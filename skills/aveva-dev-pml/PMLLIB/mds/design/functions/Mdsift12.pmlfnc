--------------------------------------------------------------------------------
--
-- File:  Mdsift12.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS135
--
-- Author:  I.osborne
-- Created:  Tue Jul 15
--
--
-- Description:
-- Initialisation for form ft12
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt12(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT12.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT12

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT12.select.select('RTEXT', 'IDCUR')
  !!mdsFT12.slide.select('DTEXT', 'Centreline')
  !!mdsFT12.datum.active = true
  !!mdsFT12.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.offset    = 'MID'
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFT12.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT12)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)
    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT12.name.val = !struName

    !!mdsFT12.dim1.val = 0
    !!mdsFT12.dim2.val = 0
    !!mdsFT12.dim3.val = 0
    !!mdsFT12.dim4.val = 0
    !!mdsFT12.dist.val = 0
    !!mdsFT12.p.val = ''

    !!mdsFrame.hide()

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsFT12.createByDim.active = true
    !!mdsFT12.createByCle.active = true
    !!mdsFT12.createByCur.active = true
    ------------------------------------------------------------------------------

  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsFT12.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT12)|
    !support.modify = true
    !!mdsFT12.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT12'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 12 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif
    !support.offset = !split[5]

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar = !name & '-BAR-1'

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT12.name.val = !name
    !!mdsFT12.dim1.val = 0
    !!mdsFT12.dim2.val = 0
    !!mdsFT12.dim3.val = 0
    !!mdsFT12.dim4.val = 0
    !!mdsFT12.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    --$(
    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !vert2 = !name & '-V2'
    !vertDbref[2] = !vert2.dbref()
    !conn2 = !vertDbref[2].:MDSConn
    !support.connections[1] = !conn1
    !support.connections[2] = !conn2

    -- Set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)


    -- set support object for joints
    !support.joints = !!mdsGetJoints(!vertDbref)
    --$)
    -------------------------------------------------------------------
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT12.createByDim.active = false
      !!mdsFT12.createByCle.active = true
      !!mdsFT12.createByCur.active = true
    else
      !!mdsFT12.createByDim.active = true
      !!mdsFT12.createByCle.active = true
      !!mdsFT12.createByCur.active = true
    endif
    -------------------------------------------------------------------
  endif

  -- Store support object in form
  !!mdsFT12.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT12.repre.clear()
  !!mdsFT12.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT12.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT12.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT12.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 12
  !!ce = /MDS/FRAMES/FT12
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsFT12,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT12.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT12.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT12.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT12.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT12,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT12,'-BAR-1','-V1')

    !!ce = !!mdsFT12.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT12)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsFT12.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT12.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT12.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT12.dim2.val = !despars[2]
    handle any
      !!mdsFT12.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT12.dim3.val = !despars[3]
    handle any
      !!mdsFT12.dim1.val = 0
      !!mdsFT12.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT12.dim4.val = !despars[4]
    handle any
      !!mdsFT12.dim1.val = 0
      !!mdsFT12.dim2.val = 0
      !!mdsFT12.dim3.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT12')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT12')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT12.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT12, 'PIPE', '$!formName')

  !!ce = !!mdsFT12.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT12-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT12-1')
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT12.connect.active = False
    !!mdsFT12.modify.active = False
    !!mdsFT12.disconn.active = False
    !!mdsFT12.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT12.support.stru.unset()) then
    !!mdsFT12.connect.active = False
    !!mdsFT12.modify.active = False
    !!mdsFT12.forceCon.active = False
    !!mdsFT12.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT12.connect.active = True
    !!mdsFT12.forceCon.active = False
    !!mdsFT12.modify.active = False
    !!mdsFT12.disconn.active = True
  else
    !!mdsFT12.connect.active  = True
    !!mdsFT12.modify.active   = True
    !!mdsFT12.forceCon.active = True
    !!mdsFT12.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsFT12)
  --<dw>sep2007
  -- Store current form information
  call !!mdsStoreFt12()

  -- Show Form for frame type FT12
  !!kShowForm(!!mdsFT12)

  -- Set dimensions toggle

  !!mdsFT12.graphicalDim = false

  !!kRestoreUnits(!currentunits)

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
