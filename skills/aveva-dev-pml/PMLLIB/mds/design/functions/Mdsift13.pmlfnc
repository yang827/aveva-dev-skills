--------------------------------------------------------------------------------
--
-- File:  Mdsift13.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS137
--
-- Author:  I.osborne
-- Created:  Wed Jul 16
--
--
-- Description:
-- Initialisation for form ft13
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt13(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT13.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !form = !!mdsFT13
  !uniquenames = !!mdsoptions.mdsuniquenames
  -- <sk> 04/06/2012
  !fromAtta = false
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName

  -- Initialise Standard gadgets
  !!mdsFT13.select.select('RTEXT', 'IDCUR')
  !!mdsFT13.slide.select('RTEXT', 'MID')
  !!mdsFT13.datum.active = true
  !!mdsFT13.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  -- Remove packers icons from FT39 only
  if !support.alias.eq('FT39') then
    !!mdsFT13.addPack.active = false
    !!mdsFT13.delPack.active = false
  else
    !!mdsFT13.addPack.active = true
    !!mdsFT13.delPack.active = true
  endif

  -- make slide option inactive and DIM3 invisible if support is FT68
  !!mdsFT13.slide.active = !alias.neq('FT68')
  !!mdsFT13.dim3.visible = !alias.neq('FT68')
  if (!modify.upcase() neq |MODIFY|)then

    !support.config = 0

    -- Set callback on cancel button
    !!mdsFT13.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT13)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- Rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT13.name.val = !struName

    !!mdsFT13.dim1.val = 0
    !!mdsFT13.dim2.val = 0
    !!mdsFT13.dim3.val = 200
    if !alias.eq('FT13') then
      !!mdsFT13.dim3.active = TRUE
    else
      !!mdsFT13.dim3.active = false
    endif
    !!mdsFT13.dist.val = 0
    !!mdsFT13.p.val = ''

    !!mdsFrame.hide()

    ----------------------**** Connexions *****---------------------------
    -- in create mode have all three

    !!mdsFT13.createByDim.active = true
    !!mdsFT13.createByCle.active = false
    !!mdsFT13.createByCur.active = true
    ----------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!name & '-V1')
    !association[2] = object MDSASSOCIATION(!name & '-BAR-1')

  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsFT13.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT13)|
    !support.modify = true
    !!mdsFT13.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 13 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    --<wd>jun2001
    !support.config = !split[4].real()
    handle any
      -- assume config on CL of Column
      !support.config = 0
    endhandle

    if (!support.config.eq(0)) then
      !!mdsFT13.slide.select('RTEXT', 'MID')
    elseif (!support.config.eq(4)) then
      !!mdsFT13.slide.select('RTEXT', 'FRONT')
    elseif (!support.config.eq(5)) then
      !!mdsFT13.slide.select('RTEXT', 'BACK')
    endif
    --<wd>jun2001

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    if (!split[3] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar = !name & '-BAR-1'

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107)  (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    -- Set Form Gadgets
    !!mdsFT13.name.val = !name
    !!mdsFT13.dim1.val = 0
    !!mdsFT13.dim2.val = 0
    !!mdsFT13.dim3.val = 0
    if !alias.eq('FT13') then
      !!mdsFT13.dim3.active = TRUE
    else
      !!mdsFT13.dim3.active = false
    endif
    !!mdsFT13.p.val    = ''

    !!mdsAddAll('$!textName')
    --$(
    ------------------------------ ***** Connexions --------------------

    -- if(!support.connections.size().eq(1)) then
    -- !!mdsFT13.lineUp.active = True
    -- endif

    -- set support object connections
    !connectedSctns[1] = object DBREF(!name & '-V1')
    !connectedSctns[2] = object DBREF(!name & '-BAR-1')
    if !connectedSctns[1].:MDSConn.badref().not() then
      !support.connections[1] = !connectedSctns[1].:MDSConn
    endif
    if !connectedSctns[2].:MDSConn.badref().not() then
      !support.connections[2] = !connectedSctns[2].:MDSConn
    endif

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)


    -- set support object for joints

    !support.joints = !!mdsGetJoints(!connectedSctns)
    --$)
    -------------------------------------------------------------------

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT13.createByDim.active = false
      !!mdsFT13.createByCle.active = false
      !!mdsFT13.createByCur.active = true
    else
      !!mdsFT13.createByDim.active = true
      !!mdsFT13.createByCle.active = false
      !!mdsFT13.createByCur.active = true

    endif

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!connectedSctns[1])
    !association[2] = object MDSASSOCIATION(!connectedSctns[2])

  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsFT13.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT13.repre.clear()
  !!mdsFT13.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT13.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT13.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT13.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 13
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  -- !!mdsSetSize('CREATE',!!mdsFT13,'-BAR-1','-V1')
  !!mdsSetSteel.init('HIDE',!!mdsFT13,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT13.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT13.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT13.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT13.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT13,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT13,'-BAR-1','-V1')

    !!ce = !!mdsFT13.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT13)

    -- Store Atta reference in form
    if !uniquenames then
    	!form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif


    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT13.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT13.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT13.dim2.val = !despars[2]
    handle any
      !!mdsFT13.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    if !alias.neq('FT68') then
      !!mdsFT13.dim3.val = !despars[3]
      handle any
        !!mdsFT13.dim3.val = 0
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        golabel /CONT
      endhandle
    endif

    endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT13.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT13, 'PIPE', '$!formName')

  !!ce = !!mdsFT13.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    if !alias.eq('FT13') then
      !!mdsSetSuppCode('CREATE',!name,!alias,'FT13-A-1')
    else
      !!mdsSetSuppCode('CREATE',!name,!alias,'FT39-1')
    endif
  else
    if !alias.eq('FT13') then
      !!mdsSetSuppCode('MODIFY',!name,!alias,'FT13-A-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'FT39-1')
    endif
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT13.connect.active = False
    !!mdsFT13.modify.active = False
    !!mdsFT13.disconn.active = False
    !!mdsFT13.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT13.support.stru.unset()) then
    !!mdsFT13.connect.active = False
    !!mdsFT13.modify.active = False
    !!mdsFT13.forceCon.active = False
    !!mdsFT13.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT13.connect.active = True
    !!mdsFT13.forceCon.active = False
    !!mdsFT13.modify.active = False
    !!mdsFT13.disconn.active = True
  else
    !!mdsFT13.connect.active  = True
    !!mdsFT13.modify.active   = True
    !!mdsFT13.forceCon.active = True
    !!mdsFT13.disconn.active  = True
  endif
  ----------------------------------------------------------------
  --$)


  -- Store current form information
  call !!mdsStoreFt13()

  -- Set dimensions toggle

  !!mdsFT13.graphicalDim = false

  -- Show Form for frame type FT13
  !!kShowForm(!!mdsFT13)

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
