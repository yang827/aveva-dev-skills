--------------------------------------------------------------------------------
--
-- File:    Mdsift14.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          IPS138
--
-- Author:    I.osborne
-- Created:   Tue Jul 22
--
--
-- Description:
-- Initialisation for form ft14
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt14(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft14.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsOptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft14

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft14.select.select('RTEXT', 'IDCUR')
  !!mdsft14.slide.select('RTEXT', 'MID')
  !!mdsft14.datum.active = true
  !!mdsft14.cancel.active = true
  !!mdsft14.ancmat.active = true

  -- FT14 has an alias from the cable rack frameworks called CT06
  -- and from the HVAC frameworks called DT03

  if (!alias eq 'FT14') then

    !!mdsft14.addPipe.active = true
    !!mdsft14.addHVAC.active = true
    !!mdsft14.addRack.active = true
    !!mdsft14.addBar.active = false
    !!mdsft14.rotate.active = true
    !!mdsft14.modAtta.active = true
    !!mdsft14.addPack.active = true
    !!mdsft14.delPack.active = true
    !!mdsft14.rotAtt.active = true
    !!mdsft14.flipAtta.active = TRUE

  elseif (!alias inset('CT06','CT09')) then

    !!mdsft14.addPipe.active = false
    !!mdsft14.addHVAC.active = false
    !!mdsft14.addRack.active = true
    !!mdsft14.addBar.active = false
    !!mdsft14.rotate.active = false
    !!mdsft14.modAtta.active = TRUE
    !!mdsft14.addPack.active = false
    !!mdsft14.delPack.active = false
    !!mdsft14.rotAtt.active = false
    !!mdsft14.ancmat.active = false
    !!mdsft14.flipAtta.active = TRUE

    !desc = desc of /MDS/TEMPLATES
    handle ANY
      !desc = ''
    endhandle
    if !desc.eq('Zimmer Templates') or (!alias inset('CT09')) then
      if (!alias inset('CT06','CT09')) then
        -- if !desc.eq('Zimmer Templates')and (!alias inset('CT06','CT09')) then
        -- !!mdsft14.dim1.callback = |Call !!mdsCreateFt14('DIMENSION')|
        !!mdsft14.dim2.active = FALSE
        !!mdsft14.flip.active = FALSE
      endif
    endif

  elseif (!alias eq 'DT03') then

    !!mdsft14.addPipe.active = false
    !!mdsft14.addHVAC.active = true
    !!mdsft14.addRack.active = false
    !!mdsft14.addBar.active = false
    !!mdsft14.rotate.active = false
    !!mdsft14.modAtta.active = false
    !!mdsft14.addPack.active = false
    !!mdsft14.delPack.active = false
    !!mdsft14.rotAtt.active = false
    !!mdsft14.ancmat.active = false
    !!mdsft14.flipAtta.active = false

  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.config    = 1
  !support.alias     = !alias
  !bar = !name & '-BAR-1'

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft14.cancel.callback = |Call !!mdsCancelSupp(!!mdsft14)|
    !support.modify = false

    -- Initialise variables for new supports
    if (!alias eq 'FT14') then
      !support.replace = !!mdsFrame.replacement
      !support.type    = !!mdsFrame.standard.selection('Rtext')
      !struName        = !!mdsFrame.name.val
    elseif (!alias inset('CT06','CT09')) then
      !support.replace = !!mdsCable.replacement
      !support.type    = !!mdsCable.standard.selection('Rtext')
      !struName        = !!mdsCable.name.val
    elseif (!alias eq 'DT03') then
      !support.replace = !!mdsHvac.replacement
      !support.type    = !!mdsHvac.standard.selection('Rtext')
      !struName        = !!mdsHvac.name.val
    endif

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft14.name.val = !struName

    !!mdsft14.dim1.val = 0
    !!mdsft14.dim2.val = 0
    !!mdsft14.dist.val = 0
    !!mdsft14.p.val = ''

    if (!alias eq 'FT14') then
      !!mdsFrame.hide()
    elseif (!alias eq 'CT06') then
      !!mdsCable.hide()
    elseif (!alias eq 'CT09') then
      !!mdsCable.hide()
    elseif (!alias eq 'DT03') then
      !!mdsHvac.hide()
    endif

    ----------------------**** Connexions *****---------------------------
    -- in create mode have all three

    !!mdsft14.createByDim.active = true
    !!mdsft14.createByCle.active = false
    !!mdsft14.createByCur.active = true
    ----------------------------------------------------------------------
    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!bar)

  else   $* its modify

    -- Set callback on cancel button
    !!mdsft14.cancel.callback = |Call !!mdsRestoreForm(!!mdsft14)|
    !support.modify = true
    !!mdsft14.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT14'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    if !!ce.type.eq('CTSUPP') then
      !pa = 'p1'
      !pl = 'p2'
    else
      !pa = 'pa'
      !pl = 'pl'
    endif
    !support.pADir  = $!pa Dir wrt world
    !support.pLDir  = $!pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 14 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    if (!split[3] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif
    !support.config  = !split[4].real()
    !support.rotated = !split[5].real()

    -- Reset slide gadget to pick up configuration
    !!mdsft14.slide.val = !support.config

    -- Apply Data for existing cross bar
    !!ce  = !support.stru

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107)  (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Set Form Gadgets
    !!mdsft14.name.val = !name
    !!mdsft14.dim1.val = 0
    !!mdsft14.dim2.val = 0
    !!mdsft14.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------

    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft14.lineUp.active = True
    -- endif

    -- set support object connections
    !bars[1] = !bar.dbref()
    !support.connections[1] = !bars[1].:MDSConn

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)



    -- set support object for joints

    !support.joints = !!mdsGetJoints(!bars)

    -------------------------------------------------------------------

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft14.createByDim.active = false
      !!mdsft14.createByCle.active = false
      !!mdsft14.createByCur.active = true
    else
      !!mdsft14.createByDim.active = true
      !!mdsft14.createByCle.active = false
      !!mdsft14.createByCur.active = true
    endif

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!bars[1])

  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association
  -- Store support object in form
  !!mdsft14.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft14)
  !!mdsft14.support.mdssctnsstore = !!mdsft14.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft14.repre.clear()
  !!mdsft14.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level cable
  !!mdsft14.repre.append(|Call !!kRepreLevel(Nulref, 'CABLE', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft14.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft14.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft14.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 14
  if (!alias eq 'FT14') then
    !!ce = /MDS/FRAMES/FT14-HORI
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT06') then
    !!ce = /MDS/FRAMES/CT06
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT09') then
    !!ce = /MDS/FRAMES/CT06
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'DT03') then
    !!ce = /MDS/FRAMES/DT03
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  endif

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsft14,'-BAR-1','')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsft14.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsft14.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsft14.select.active = TRUE
  handle ANY
  endhandle
  !!mdsft14.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft14,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsft14,'-BAR-1','')

    !!ce = !!mdsft14.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft14)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif
    -- Add field weld marker

    !where = !!mdsft14.support.stru.:MDSOrigin
    !bar1  = !!mdsft14.support.stru.name & '-BAR-1'

    if (!where eq 'START') then
      var !pos ( poss of $!bar1 wrt world )
    else
      var !pos ( pose of $!bar1 wrt world )
    endif

    --<wd>jun2001 -- If statement added around Field Weld macro
    if (!support.joints.unset()) then
      !desc = desc of /MDS/TEMPLATES
      if !desc.neq('Framatome Templates') then
        if !desc.neq('Zimmer Templates') then
          $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300 $<Field Weld$> $<$!pos$>
        elseif (!alias inset('CT09')) then
          $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300 $<Field Weld$> $<$!pos$>
        endif
      endif
    endif


    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsft14.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft14.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft14.dim2.val = !despars[2]
    handle any
      !!mdsft14.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT14') then
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsFrame,'FRAME')
      !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
      !text  = !!mdsFrame.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT06') then
    !index = !!mdsCable.standard.rtext.findfirst('$!alias')
    !text  = !!mdsCable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsCable,'CABLE')
      !index = !!mdsCable.standard.rtext.findfirst('$!alias')
      !text  = !!mdsCable.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT09') then
    !index = !!mdsCable.standard.rtext.findfirst('$!alias')
    !text  = !!mdsCable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsCable,'CABLE')
      !index = !!mdsCable.standard.rtext.findfirst('$!alias')
      !text  = !!mdsCable.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'DT03') then
    !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
    !text  = !!mdsHvac.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsHvac,'HVAC')
      !index = !!mdsHvac.standard.rtext.findfirst('$!alias')
      !text  = !!mdsHvac.standard.dtext[!index]
    endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft14.support.replace = !formName

  if (!alias eq 'FT14') then
    call !!mdsSetFormName(!!mdsft14, 'PIPE', '$!formName')
  elseif (!alias inset('CT06','CT09')) then
    call !!mdsSetFormName(!!mdsft14, 'TRAY', '$!formName')
  elseif (!alias eq 'DT03') then
    call !!mdsSetFormName(!!mdsft14, 'HVAC', '$!formName')
  endif

  !!ce = !!mdsft14.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    if !alias neq 'DT03' then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-L-1')
    else
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-A-1')
    endif
  else
    if !alias neq 'DT03' then
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-L-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-A-1')
    endif
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft14.connect.active = False
    !!mdsft14.modify.active = False
    !!mdsft14.disconn.active = False
    !!mdsft14.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft14.support.stru.unset()) then
    !!mdsft14.connect.active = False
    !!mdsft14.modify.active = False
    !!mdsft14.forceCon.active = False
    !!mdsft14.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft14.connect.active = True
    !!mdsft14.forceCon.active = False
    !!mdsft14.modify.active = False
    !!mdsft14.disconn.active = True
  else
    !!mdsft14.connect.active  = True
    !!mdsft14.modify.active   = True
    !!mdsft14.forceCon.active = True
    !!mdsft14.disconn.active  = True
  endif
  ----------------------------------------------------------------
  --$)


  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft14.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsft14.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      if !!ce.type.eq('CTSUPP') then
        !!kRepreLevel(!!ce, 'CABLE',!!mdsOptions.levChange, $!colour)
      else
        !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      endif
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif


  -- Select the wall selection bz default for Framatome

  if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
    !!mdsft14.slide.val = 9
    handle any
    endhandle
  endif

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft14)
  --<dw>sep2007
  -- Store current form information
  !!mdsft14.support.storeFt(!!mdsft14)

  -- Make the hand icon active

  !!mdsft14.hand.active = true

  -- Set dimensions toggle

  !!mdsft14.graphicalDim = false


  -- Show Form for frame type FT14
  !!kShowForm(!!mdsft14)

  !!kRestoreUnits(!currentunits)
  !form.newdat.active = !uniquenames.not()

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
