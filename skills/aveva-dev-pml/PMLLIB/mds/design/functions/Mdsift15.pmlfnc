--------------------------------------------------------------------------------
--
-- File:  Mdsift15.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS139
--
-- Author:  Wayne Dodwell
-- Created:  Monday 29th September 1997
--
--
-- Description:
-- Initialisation for Frame Type form 'FT15'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt15(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT15.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsOptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT15

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT15.select.select('RtexT', 'IDCUR')
  !!mdsFT15.slide.select('Rtext', 'WEBWEB')
  !!mdsFT15.datum.active = true
  !!mdsFT15.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.config    = 1
  !support.alias     = !alias
  !bar = !name & '-BAR-1'
  !vert = !name & '-V1'

  --<kp>jan2012
  -- associations
  !mdsassociation[1] = object MDSASSOCIATION(!bar)
  !mdsassociation[2] = object MDSASSOCIATION(!vert)

  --  Create a NEW Framework
  --------------------------
  if (!modify.upcase() neq |MODIFY|)then


    -- Set callback on cancel button
    !!mdsFT15.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT15)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form with Name
    !!mdsFT15.name.val = !struName

    -- Set Default dimensions
    !!mdsFT15.dist.val = 0
    !!mdsFT15.dim1.val = 0
    !!mdsFT15.dim2.val = 0
    !!mdsFT15.dim3.val = 0
    !!mdsFT15.dim4.val = 0
    !!mdsFT15.dim5.val = 0

    -- Set Through button descriptive text to default
    -- and Atta rotation gadget value to default
    !!mdsFT15.p.val = ''

    -- Hide Create Framework Type Selection Form
    !!mdsFrame.hide()

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three

    !!mdsFT15.createByDim.active = true
    !!mdsFT15.createByCle.active = false
    !!mdsFT15.createByCur.active = true
    ------------------------------------------------------------------------------


  else  $* its modify mode


    -- Modify Existing Framework
    ----------------------------

    -- Set callback on cancel button
    !!mdsFT15.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT15)|
    !support.modify = true
    !!mdsFT15.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT15'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world


    -- Get Specific data to frame type 'FT15' from UDA :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    if (!split[3] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    !support.config  = !split[4].real()
    !support.rotated = !split[5].real()

    -- Reset slide gadget to pick up Framework configuration
    !!mdsFT15.slide.val = !support.config


    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !references = ARRAY()
    do !aref values !bar.dbref().:MDSAttaRef
      skip if !aref.badref()
      !references.append(!aref)

    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !support.barlen.append(!bar.dbref().leng)

    -- Set Form Gadgets
    !!mdsFT15.name.val = !name
    !!mdsFT15.dim1.val = 0
    !!mdsFT15.dim2.val = 0
    !!mdsFT15.dim3.val = 0
    !!mdsFT15.dim4.val = 0
    !!mdsFT15.p.val    = ''

    -- Store section name and matref for each member
    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------


    -- set support object connections
    !connectedSctns[1] = !bar.dbref()
    !support.connections[1] = !connectedSctns[1].:MDSConn
    if (!support.config.eq(4)) then
      -- Vertical and the Cross bar are Connected
      --Lowest Beam (Cross Bar Support Beam) in Config 4 is always Joint[1]
      !connectedSctns[2] = !vert.dbref()
      !support.connections[2] = !connectedSctns[2].:MDSConn
    else
      -- Only the Cross bar is Connected, but at BOTH JOIS and JOIE Ends
      !support.connections[2] = !connectedSctns[1].:MDSXConn
    endif

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)



    -- set support object for joints
    !support.joints = !!mdsGetJoints(!connectedSctns)
    -------------------------------------------------------------------

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT15.createByDim.active = false
      !!mdsFT15.createByCle.active = false
      !!mdsFT15.createByCur.active = true
    else
      !!mdsFT15.createByDim.active = true
      !!mdsFT15.createByCle.active = false
      !!mdsFT15.createByCur.active = true
    endif

    --<kp>jan2012
    -- associations
    !mdsassociation[1] = object MDSASSOCIATION(!connectedSctns[1])
    !mdsassociation[2] = object MDSASSOCIATION(!connectedSctns[2])
    handle ANY
    endhandle

    -------------------------------------------------------------------

    -- End of Modify Existing Framework
    -------------------------------------
  endif

  -----------------------------------------------------

  --<kp>jan2012
  -- associations
  !support.associations = !mdsassociation

  -- Store support object in form
  !!mdsFT15.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT15.repre.clear()
  !!mdsFT15.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT15.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT15.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT15.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 'FT15'
  !!ce = /MDS/FRAMES/FT15-HORI
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsFT15,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT15.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT15.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT15.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT15.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  -----------------------------------------------------

  -- Determine Values for Existing Framework
  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT15,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsFT15,'-BAR-1','-V1')

    !!ce = !!mdsFT15.support.datum

    -- Set distance gadget
    !!mdsdistance(!!mdsFT15)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT15.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT15.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

    !!mdsFT15.dim2.val = !despars[2]
    handle any
      !!mdsFT15.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

    !!mdsFT15.dim3.val = !despars[3]
    handle any
      !!mdsFT15.dim1.val = 0
      !!mdsFT15.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

    if (!support.config.eq(3) or !support.config.eq(4)) then
      !!mdsFT15.dim4.val = !despars[4]
      handle any
        !!mdsFT15.dim1.val = 0
        !!mdsFT15.dim2.val = 0
        !!mdsFT15.dim3.val = 0
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        golabel /CONT
      endhandle
    endif

    if (!support.config.eq(4)) then
      !!mdsFT15.dim5.val = !despars[5]
      handle any
        !!mdsFT15.dim1.val = 0
        !!mdsFT15.dim2.val = 0
        !!mdsFT15.dim3.val = 0
        !!mdsFT15.dim4.val = 0
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        golabel /CONT
      endhandle
    endif
  endif

  -----------------------------------------------------


  label /CONT

  -- Redefine standard support name on form title
  !index = !!mdsFrame.standard.rtext.findfirst('FT15')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT15')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT15.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT15, 'PIPE', '$!formName')

  -- Set Dimension4 and Dimension5 gadget to suit Build Configuration
  if (!support.config.eq(1) or !support.config.eq(2) ) then
    !!mdsFT15.dim4.active = false
    !!mdsFT15.dim4.val    = 0
    !!mdsFT15.dim5.active = false
    !!mdsFT15.dim5.val    = 0
  else
    !!mdsFT15.dim4.active = true
    if (!support.config.eq(4)) then
      !!mdsFT15.dim5.active = true
    else
      !!mdsFT15.dim5.active = false
      !!mdsFT15.dim5.val    = 0
    endif
  endif

  !!ce = !!mdsFT15.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT15-N-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT15-N-1')
  endif

  ------------------------ connexions ----------------------------
  -- Grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT15.connect.active = False
    !!mdsFT15.modify.active = False
    !!mdsFT15.disconn.active = False
    !!mdsFT15.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT15.support.stru.unset()) then
    !!mdsFT15.connect.active = False
    !!mdsFT15.modify.active = False
    !!mdsFT15.forceCon.active = False
    !!mdsFT15.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT15.connect.active = True
    !!mdsFT15.forceCon.active = False
    !!mdsFT15.modify.active = False
    !!mdsFT15.disconn.active = True
  else
    !!mdsFT15.connect.active  = True
    !!mdsFT15.modify.active   = True
    !!mdsFT15.forceCon.active = True
    !!mdsFT15.disconn.active  = True
  endif

  if (!!mdsFT15.support.joints.unset()) then
    !!mdsFT15.connect.active = true
  else
    !!mdsFT15.connect.active = false
  endif
  ---------------------------------------------------------------


  -- Store current form information
  !!mdsFT15.support.storeFt(!!mdsFT15)

  -- Set dimensions toggle

  !!mdsFT15.graphicalDim = false

  -- Show Form for frame type FT15

  !!kShowForm(!!mdsFT15)

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
