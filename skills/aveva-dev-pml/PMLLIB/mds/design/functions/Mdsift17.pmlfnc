--
-- File:  Mdsift17.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS135
--
-- Author:  Wayne Dodwell
-- Created:  Monday 21 July 1997
--
--
-- Description:
-- Initialisation for form ft17
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIft17(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT17.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsOptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT17

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT17.select.select('RTEXT', 'IDCUR')
  !!mdsFT17.slide.select('DTEXT', 'Centreline')
  !!mdsFT17.datum.active = true
  !!mdsFT17.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.offset    = 'MID'
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFT17.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT17)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT17.name.val = !struName

    !!mdsFT17.dim1.val = 0
    !!mdsFT17.dim2.val = 0
    !!mdsFT17.dim3.val = 0
    !!mdsFT17.dim4.val = 0
    !!mdsFT17.dist.val = 0
    !!mdsFT17.p.val = ''

    -- Datum creation gadget ACTIVE for creation mode

    !!mdsFT17.datum.active = true

    !!mdsFrame.hide()
    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsFT17.createByDim.active = true
    !!mdsFT17.createByCle.active = true
    !!mdsFT17.createByCur.active = true
    -----------------------------------------------------------------------------

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!name & '-V1')

  else  $* its modify mode

    -- Initialise form in MODIFY mode

    -- Datum creation gadget INACTIVE for modify mode

    !!mdsFT17.datum.active = false

    -- Set callback on cancel button
    !!mdsFT17.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT17)|
    !support.modify = true
    !!mdsFT17.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT17'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type FT17 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif
    !support.offset = !split[5]

    --> Modified - <wd> - 11sep1998
    if (!support.offset.eq('MID')) then
      !!mdsFT17.slide.val = 1
    elseif (!support.offset.eq('FRONT')) then
      !!mdsFT17.slide.val = 2
    else
      !!mdsFT17.slide.val = 3
    endif
    --< Modified - <wd> - 11sep1998

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar = !name & '-BAR-1'

    !references = !support.atta
    !index = !references.findfirst(!sref.dbref())
    !references.remove(!index)

    -- Store Data in support object
    --      !support.bars[1] = !references

    --------------------------------------------------------------------------

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef

    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    --------------------------------------------------------------------------

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT17.name.val = !name
    !!mdsFT17.dim1.val = 0
    !!mdsFT17.dim2.val = 0
    !!mdsFT17.dim3.val = 0
    !!mdsFT17.dim4.val = 0
    !!mdsFT17.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------

    -- set support object connections
    !vertdbref[1] = object DBREF(!name & '-V1')
    !support.connections[1] = !vertdbref[1].:MDSConn

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)


    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertdbref)

    --<kp>jan2012
    -- associations
    !association[1] = object MDSASSOCIATION(!vertdbref[1])
    -------------------------------------------------------------------
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT17.createByDim.active = false
      !!mdsFT17.createByCle.active = true
      !!mdsFT17.createByCur.active = true
    else
      !!mdsFT17.createByDim.active = true
      !!mdsFT17.createByCle.active = true
      !!mdsFT17.createByCur.active = true
    endif

    -------------------------------------------------------------------

  endif

  --<kp>jan2012
  -- associations
  !support.associations = !association

  -- Store support object in form
  !!mdsFT17.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT17.repre.clear()
  !!mdsFT17.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT17.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT17.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT17.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type FT17
  !!ce = /MDS/FRAMES/FT17
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsFT17,'-BAR-1','-V1')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT17.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT17.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT17.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT17.bthro.active = TRUE
  handle ANY
  endhandle

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT17,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT17,'-BAR-1','-V1')

    !!ce = !!mdsFT17.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT17)

    -- Store Atta reference in form
    if !uniquenames then
      !form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsFT17.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT17.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT17.dim2.val = !despars[2]
    handle any
      !!mdsFT17.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT17.dim3.val = !despars[3]
    handle any
      !!mdsFT17.dim1.val = 0
      !!mdsFT17.dim2.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT17.dim4.val = !despars[4]
    handle any
      !!mdsFT17.dim1.val = 0
      !!mdsFT17.dim2.val = 0
      !!mdsFT17.dim3.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
    endhandle

  endif


  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT17')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT17')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT17.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT17, 'PIPE', '$!formName')

  !!ce = !!mdsFT17.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT17-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT17-1')
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT17.connect.active = False
    !!mdsFT17.modify.active = False
    !!mdsFT17.disconn.active = False
    !!mdsFT17.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT17.support.stru.unset()) then
    !!mdsFT17.connect.active = False
    !!mdsFT17.modify.active = False
    !!mdsFT17.forceCon.active = False
    !!mdsFT17.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT17.connect.active = True
    !!mdsFT17.forceCon.active = False
    !!mdsFT17.modify.active = False
    !!mdsFT17.disconn.active = True
  else
    !!mdsFT17.connect.active  = True
    !!mdsFT17.modify.active   = True
    !!mdsFT17.forceCon.active = True
    !!mdsFT17.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsFT17)
  --<dw>sep2007
  -- Store current form information
  call !!mdsStoreft17()

  -- Set dimensions toggle

  !!mdsFT17.graphicalDim = false

  -- Show Form for frame type FT17
  !!kShowForm(!!mdsFT17)

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
