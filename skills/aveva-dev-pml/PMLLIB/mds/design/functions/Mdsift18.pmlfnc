--------------------------------------------------------------------------------
--
-- File: Mdsift18.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces: IPS142
--
-- Author: Wayne Dodwell
-- Created: Wednesday 27 August 1997
--
--
-- Description:
-- Initialisation for form ft18
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt18(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft18.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft18

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft18.select.select('RTEXT', 'IDCUR')
  !!mdsft18.slide.select('DTEXT', 'Top')
  !!mdsft18.datum.active = true
  !!mdsft18.cancel.active = true
  !!mdsft18.ancmat.active = true

  -- FT18 has an alias from the cable rack frameworks called CT08

  if (!alias eq 'FT18') then

    !!mdsft18.addPipe.active = true
    !!mdsft18.addHVAC.active = true
    !!mdsft18.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/FT18-HORI ) then
      !!mdsft18.addBar.active = true
    else
      !!mdsft18.addBar.active = false
    endif
    !!mdsft18.rotate.active = true
    !!mdsft18.modAtta.active = true
    !!mdsft18.slide.active = true
    !!mdsft18.addPack.active = true
    !!mdsft18.delPack.active = true
    !!mdsft18.rotAtt.active = true
    !!mdsft18.flipAtta.active = TRUE

  elseif (!alias eq 'CT08') then

    !!mdsft18.addPipe.active = false
    !!mdsft18.addHVAC.active = false
    !!mdsft18.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/CT08 ) then
      !!mdsft18.addBar.active = true
    else
      !!mdsft18.addBar.active = false
    endif
    !!mdsft18.rotate.active = false
    !!mdsft18.modAtta.active = false
    !!mdsft18.slide.active = false
    !!mdsft18.addPack.active = false
    !!mdsft18.delPack.active = false
    !!mdsft18.rotAtt.active = false
    !!mdsft18.ancmat.active = false
    !!mdsft18.flipAtta.active = TRUE

  elseif (!alias eq 'CT11') then

    !!mdsft18.addPipe.active = false
    !!mdsft18.addHVAC.active = false
    !!mdsft18.addRack.active = true
    if (:MdsBars of /MDS/FRAMES/CT11 ) then
      !!mdsft18.addBar.active = true
    else
      !!mdsft18.addBar.active = false
    endif
    !!mdsft18.rotate.active = false
    !!mdsft18.modAtta.active = false
    !!mdsft18.slide.active = false
    !!mdsft18.addPack.active = false
    !!mdsft18.delPack.active = false
    !!mdsft18.rotAtt.active = false
    !!mdsft18.ancmat.active = false
    !!mdsft18.flipAtta.active = true

  endif

  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle
  if !desc.eq('Zimmer Templates') or (!alias inset('CT11')) then
    if (!alias inset('CT08','CT11')) then
      !!mdsft18.flip.active = FALSE
    endif
  endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft18.cancel.callback = |Call !!mdsCancelSupp(!!mdsft18)|
    !support.modify = false

    -- Initialise variables for new supports
    if (!alias eq 'FT18') then
      !support.replace = !!mdsframe.replacement
      !support.type    = !!mdsframe.standard.selection('Rtext')
      !struName        = !!mdsframe.name.val
    elseif (!alias inset ('CT08','CT11')) then
      !support.replace = !!mdscable.replacement
      !support.type    = !!mdscable.standard.selection('Rtext')
      !struName        = !!mdscable.name.val
    endif

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft18.name.val = !struName

    !!mdsft18.dim1.val = 0
    !!mdsft18.dim2.val = 0
    !!mdsft18.dist.val = 0
    !!mdsft18.p.val = ''

    -- Activate Datum Creation gadget for CREATE mode
    !!mdsft18.datum.active = true

    if (!alias eq 'FT18') then
      !!mdsframe.hide()
    elseif (!alias eq 'CT08') then
      !!mdscable.hide()
    elseif (!alias eq 'CT11') then
      !!mdscable.hide()
    endif
    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsft18.createByDim.active = true
    !!mdsft18.createByCle.active = true
    !!mdsft18.createByCur.active = true
    ------------------------------------------------------------------------------

  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsft18.cancel.callback = |Call !!mdsRestoreForm(!!mdsft18)|
    !support.modify = true
    !!mdsft18.datum.active = false

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    if !!ce.type.eq('CTSUPP') then
      !pa = 'p1'
      !pl = 'p2'
    else
      !pa = 'pa'
      !pl = 'pl'
    endif
    !support.pADir  = $!pa Dir wrt world
    !support.pLDir  = $!pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 18 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    !support.config = !split[1].real()
    if (!split[2] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[3] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[4].real()
    if (!split[5] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft18.name.val = !name
    !!mdsft18.dim1.val = 0
    !!mdsft18.dim2.val = 0
    !!mdsft18.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft18.lineup.active = True
    -- endif

    -- set support object connections
    !vertdbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertdbref[1] = !vert1.dbref()
    !conn1 = !vertdbref[1].:MDSConn
    !support.connections[1] = !conn1

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints
    !support.joints = !!mdsGetJoints(!vertdbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft18.createByDim.active = false
      !!mdsft18.createByCle.active = true
      !!mdsft18.createByCur.active = true
    else
      !!mdsft18.createByDim.active = true
      !!mdsft18.createByCle.active = true
      !!mdsft18.createByCur.active = true
    endif
    -------------------------------------------------------------------

  endif

  -- Store support object in form
  !!mdsft18.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft18)
  !!mdsft18.support.mdssctnsstore = !!mdsft18.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft18.repre.clear()
  !!mdsft18.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level cable
  !!mdsft18.repre.append(|Call !!kRepreLevel(Nulref, 'CABLE', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft18.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft18.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft18.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 3
  if (!alias eq 'FT18') then
    !!ce = /MDS/FRAMES/FT18-HORI
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT08') then
    !!ce = /MDS/FRAMES/CT08
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  elseif (!alias eq 'CT11') then
    !!ce = /MDS/FRAMES/CT11
    handle (2,109)
      !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
      if (!modify.upcase() neq |MODIFY|) then
        delete stru
      endif
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  endif

  -- Generate Steel Size List

  --    !dtext = ARRAY()
  --    !rtext = ARRAY()
  -- !!mdsSetSize('CREATE',!!mdsft18,'-BAR-1','-V1')
  !!mdsSetSteel.init('HIDE',!!mdsft18,'-BAR-1','-V1')

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft18,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft18,'-BAR-1','-V1')

    !!ce = !!mdsft18.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft18)

    -- Add Attas to Support Object and Graphics text markers

    VAR !pos POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    do !count from 211 TO 259

      VAR !num ($!count - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsft18.support.atta.append(!!ce)

      VAR !pos POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>

    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the support.atta array
    !!mdspackattas(!!mdsft18.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft18.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsft18.dim2.val = !despars[2]
    handle any
      !!mdsft18.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT18') then
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsframe,'FRAME')
      !index = !!mdsframe.standard.rtext.findfirst('$!alias')
      !text  = !!mdsframe.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT08') then
    !index = !!mdscable.standard.rtext.findfirst('$!alias')
    !text  = !!mdscable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdscable,'CABLE')
      !index = !!mdscable.standard.rtext.findfirst('$!alias')
      !text  = !!mdscable.standard.dtext[!index]
    endhandle
  elseif (!alias eq 'CT11') then
    !index = !!mdscable.standard.rtext.findfirst('$!alias')
    !text  = !!mdscable.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdscable,'CABLE')
      !index = !!mdscable.standard.rtext.findfirst('$!alias')
      !text  = !!mdscable.standard.dtext[!index]
    endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft18.support.replace = !formName

  if (!alias eq 'FT18') then
    call !!mdsSetFormName(!!mdsft18, 'PIPE', '$!formName')
  else
    call !!mdsSetFormName(!!mdsft18, 'TRAY', '$!formName')
  endif

  !!ce = !!mdsft18.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  endif

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft18.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsft18.repre.append('!!mdsRemAdd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      if !!ce.type.eq('CTSUPP') then
        !!kRepreLevel(!!ce, 'CABLE',!!mdsOptions.levChange, $!colour)
      else
        !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      endif
      !colourlist = ARRAY()
      !colourlist.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourlist)
    enddo
  endif

  ------------------------ connexions ----------------------------
  --

  ----------------------------------------------------------------

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft18)
  --<dw>sep2007
  -- Store current form information
  call !!mdsStoreFt18()

  -- Set dimensions toggle

  !!mdsft18.graphicalDim = false

  -- Show Form for frame type FT18
  !!kShowForm(!!mdsft18)

  !!kRestoreUnits(!currentunits)

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif
  -- End function
endfunction
