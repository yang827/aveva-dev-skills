-- Created:		Wednesday 27 August 1997
--
--
-- Description:
-- Initialisation to frame type 18 configurations
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFt18Configs()

  -- Redefine standard support name on form title

    !Index = !!MdsFrame.Standard.Rtext.findfirst('FT18')
    !Text  = !!MdsFrame.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsFrame,'FRAME')
        !Index = !!MdsFrame.Standard.Rtext.findfirst('FT18')
        !Text  = !!MdsFrame.Standard.Dtext[!Index]
      endhandle
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()

    call !!MdsSetFormName(!!MdsFt18Configs, 'PIPE', '$!FormName')

-- End function
endfunction

-- End of file Mdsift18configs.pml
