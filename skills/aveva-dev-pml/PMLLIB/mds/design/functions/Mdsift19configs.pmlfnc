--
-- File:		Mdsift19configs.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPS143W
--
-- Author:		Wayne Dodwell
-- Created:		Monday 15 September 1997
--
--
-- Description:
-- Initialisation to frame type 19 configurations
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIFt19Configs()

  -- Redefine standard support name on form title

    !Index = !!MdsFrame.Standard.Rtext.findfirst('FT19')
    !Text  = !!MdsFrame.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsFrame,'FRAME')
        !Index = !!MdsFrame.Standard.Rtext.findfirst('FT19')
        !Text  = !!MdsFrame.Standard.Dtext[!Index]
      endhandle
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()

    call !!MdsSetFormName(!!MdsFt19Configs, 'PIPE', '$!FormName')

-- End function
endfunction

-- End of file Mdsift19configs.pml
