--------------------------------------------------------------------------------
--
-- File:  Mdsift21.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS139
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 28th October 1997
--
--
-- Description:
-- Initialisation for Frame Type form 'FT21'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsift21(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFt21.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFt21

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFt21.select.select('RtexT', 'IDCUR')
  !!mdsFt21.datum.active = true
  !!mdsFt21.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 0
  !support.alias     = !alias

  --  Create a NEW Framework
  --------------------------
  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFt21.cancel.callback = |Call !!mdsCancelSupp(!!mdsFt21)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form with Name
    !!mdsFt21.name.val = !struName

    --> Modified - <wd> - 3sep1998
    -- Select 'Square' radio group option as default
    !!mdsFt21.type.select('S')
    --< Modified - <wd> - 3sep1998

    -- Set Default dimensions
    !!mdsFt21.dist.val = 0
    !!mdsFt21.dim1.val = '0'

    -- Set Through button descriptive text to default
    -- and Atta rotation gadget value to default
    !!mdsFt21.p.val = ''

    -- Hide Create Framework Type Selection Form
    !!mdsFrame.hide()

  else


    -- Modify Existing Framework
    ----------------------------

    -- Set callback on cancel button
    !!mdsFt21.cancel.callback = |Call !!mdsRestoreForm(!!mdsFt21)|
    !support.modify = true
    !!mdsFt21.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT21'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentUnits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world


    -- Get Specific data to frame type 'FT21' from UDA :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar = !name & '-BAR-1'

    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107)  (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsFt21.name.val = !name
    !!mdsFt21.dim1.val = '0'
    !!mdsFt21.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

  endif

  -- End of Modify Existing Framework
  -------------------------------------


  -----------------------------------------------------
  -----------------------------------------------------

  -- Store support object in form
  !!mdsFt21.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFt21.repre.clear()
  !!mdsFt21.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFt21.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFt21.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFt21.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 'FT21'
  !!ce = /MDS/FRAMES/FT21
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsFt21,'-BAR-1','')

  !!ce = !support.stru

  -----------------------------------------------------

  -- Determine Values for Existing Framework
  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFt21,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsFt21,'-BAR-1','')

    !!ce = !!mdsFt21.support.datum

    -- Set distance gadget
    !!mdsdistance(!!mdsFt21)

    -- Add marker text markers to Graphical Display
    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsFt21.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar
    !!kFormatText.text.val = !despars[1]
    !!mdsFt21.dim1.val = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

    --> Modified - <wd> - 3sep1998
    -- Select Type of Support 'Square' or 'True'
    !!mdsFt21.type.select(wdesp[2])
    handle any
      -- Select 'Square' radio group option as default
      -- (Only 'Square' type was available at 1st Production Release)
      !!mdsFt21.type.select('S')
    endhandle
    --< Modified - <wd> - 3sep1998

  endif

  -----------------------------------------------------


  label /CONT

  -- Redefine standard support name on form title
  !index = !!mdsFrame.standard.rtext.findfirst('FT21')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT21')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFt21.support.replace = !formName

  call !!mdsSetFormName(!!mdsFt21, 'PIPE', '$!formName')

  !!ce = !!mdsFt21.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT21-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT21-1')
  endif

  -- Store current form information
  call !!mdsStoreFt21()

  -- Show Form for frame type FT21
  !!kShowForm(!!mdsFt21)

  -- Set dimensions toggle

  !!mdsFt21.graphicalDim = false



  -- Reset Units

  !!kRestoreUnits(!currentUnits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
