--------------------------------------------------------------------------------
--
-- File:  Mdsift22.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS146
--
-- Author:  I.osborne
-- Created:  Wed Jun 18
--
--
-- Description:
-- Initialisation for form ft22
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIft22(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT22.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    !!mdsFT22.xlen.active = false
    !!mdsFT22.ylen.active = false
    !!mdsFT22.zlen.active = FALSE

    -- set the initial values of the template sizes
    -- rm dec 2005
    !desc = desc of /MDS/TEMPLATES
    if (!desc eq 'Initec Industrial Templates') then
      if !!mdsFT22.size.selection() eq '' then
        !tCode = '1' + !!mdsFT22.type.selection()
      else
        !tCode = !!mdsFT22.size.selection() + !!mdsFT22.type.selection()
      endif
      !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of /MDS/$!<alias>/$!<tCode>
      !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of /MDS/$!<alias>/$!<tCode>
      !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of /MDS/$!<alias>/$!<tCode>
    else
      !!mdsFT22.xlen.val = 0
      !!mdsFT22.ylen.val = 0
      !!mdsFT22.zlen.val = 0
    endif

    -- Set callback on cancel button
    !!mdsFT22.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT22)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !unuseddatum = object DBREF(!name)
    handle NONE
      --this is an existing preliminary support atta. prelim support atta conversion is not compatible with this type
      --since no atta is ever produced (we just create a support stru). for the time being this should just produce a warning message and return
      !!alert.message('Preliminary support conversion cannot be performed with this framework type')
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT22.name.val = !struName

    !!mdsFrame.hide()

  else

    -- Set callback on cancel button
    !!mdsFT22.cancel.callback = |Unenhance all !!mdsFT22.hide() !!mdsModifySupp.cancel.active = true|
    !support.modify = true
    --xxx      !!mdsFT22.datum.active = false

    -- Store Data in support object
    !support.type = 'FT22'
    !support.stru = !name.dbref()

    -- Set Form Gadgets
    !!mdsFT22.name.val = !name

    -- Can the sizes be modified (PURP set to EDIT)

    !desc = desc of $!<name>
    !strudesc = desc of /MDS/TEMPLATES
    if !support.stru.purp.eq('EDIT') then
      !struType    = !!mdsFT22.type.selection('Rtext').trim()
      if (!strudesc eq 'Initec Industrial Templates') then
        if !struType eq 'A' or !type eq 'B' or !type eq 'G' then
          !!mdsFT22.xlen.active = TRUE
          !!mdsFT22.ylen.active = TRUE
          !!mdsFT22.zlen.active = FALSE
          !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of $!support.stru
          !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of $!support.stru
          !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of $!support.stru
        else
          !!mdsFT22.xlen.active = TRUE
          !!mdsFT22.ylen.active = TRUE
          !!mdsFT22.zlen.active = TRUE
          !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of $!support.stru
          !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of $!support.stru
          !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of $!support.stru
        endif

      else
        !!mdsFT22.xlen.active = TRUE
        !!mdsFT22.ylen.active = TRUE
        !!mdsFT22.zlen.active = TRUE
        !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of $!support.stru
        !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of $!support.stru
        !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of $!support.stru
      endif
    else
      !!mdsFT22.xlen.active = FALSE
      !!mdsFT22.ylen.active = FALSE
      !!mdsFT22.zlen.active = FALSE
      !!mdsFT22.xlen.val = xlen of box 1 of subs 1 of $!support.stru
      !!mdsFT22.ylen.val = ylen of box 1 of subs 1 of $!support.stru
      !!mdsFT22.zlen.val = zlen of box 1 of subs 1 of $!support.stru
    endif

  endif

  -- Generate Size List
  !!mdsFT22.size.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- GET LIST OF DESC TO BUILD TYPES ON FORM IF SET
  !tDTEXT = ARRAY()
  !tRTEXT = ARRAY()

  /MDS/FRAMES/FT22
  handle any
  elsehandle NONE

    var !struColl COLL all STRU for CE
    do !i values !struColl
      $!i
      if (!!ce.descr EQ '' OR !!ce.descr.upcase() EQ 'UNSET') then
        if !tDTEXT.find(!!ce.name.aFTER('/MDS/FT22/').sUBSTRING(2,1)).size().eq(0) then
          !tDTEXT.append(!!ce.name.aFTER('/MDS/FT22/').sUBSTRING(2,1))
          !tRTEXT.append(!!ce.name.aFTER('/MDS/FT22/').sUBSTRING(2,1))
        endif
      else
        if !tDTEXT.find(!!ce.descr).size().eq(0) then
          !tDTEXT.append(!!ce.descr )
          !tRTEXT.append(!!ce.name.aFTER('/MDS/FT22/').sUBSTRING(2,1))
        endif
      endif
    enddo

    !!mdsFT22.type.dtext = !tDTEXT
    !!mdsFT22.type.rtext = !tRTEXT
    !type = !!mdsFT22.type.rtext[1]
  endhandle

  -- Collect all supports for the selected frame type
  do !count from 1 TO !struColl.size()

    /MDS/FT22/$!<count>$!<type>-SUBS1
    handle any
      skip
    endhandle

    !func = func of stru

    BOX1

    !xlen = XLEN
    -- get format
    !!kFormatText.text.val = !xlen
    !xFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !xFormat = !xFormat.replace('.00','')

    !ylen = YLEN
    -- get format
    !!kFormatText.text.val = !ylen
    !yFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !yFormat = !yFormat.replace('.00','')

    !zlen = ZLEN
    -- get format
    !!kFormatText.text.val = !zlen
    !zFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !zFormat = !zFormat.replace('.00','')

    if !func.eq('') then
      !dtext.append(!xFormat & ' x ' & !yFormat & ' x ' &  !zFormat & ' thk.')
    else
      !dtext.append(!xFormat & ' x ' & !yFormat & ' x ' &  !zFormat & ' thk.' + ' ($!func)')
    endif
    !rtext.append(!count.string())

  enddo

  !!mdsFT22.size.dtext = !dtext
  !!mdsFT22.size.rtext = !rtext

  !size = !dtext[1]

  !!ce =!support.stru

  if (!modify.upcase() eq |MODIFY|)then

    -- Navigate to SUBS to get bedplate type
    !!ce = $!<name>/MAIN
    !type = !!ce.prfl
    !length = !!ce.leng

    !func = func of stru

    BOX 1

    !xlen = XLEN
    -- get format
    !!kFormatText.text.val = !xlen
    !xFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !xFormat = !xFormat.replace('.00','')
    !ylen = YLEN
    -- get format
    !!kFormatText.text.val = !ylen
    !yFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !yFormat = !yFormat.replace('.00','')
    !zlen = ZLEN
    -- get format
    !!kFormatText.text.val = !zlen
    !zFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !zFormat = !zFormat.replace('.00','')

    !size = !xFormat & ' x ' & !yFormat & ' x ' &  !zFormat & ' thk.'

    if !func.neq('') then
      !size = !size + ' ($!func)'
    endif
  endif

  -- Store support object in form
  !!mdsFT22.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT22.repre.clear()
  !!mdsFT22.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT22.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT22.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT22.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT22')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT22')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT22.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT22, 'PIPE', '$!formName')

  !!ce = !!mdsFT22.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT22-A-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT22-A-1')
  endif

  -- Set form gadgets for available sizes for type selected
  !!mdssizeft22('FT22', !type )
  -- Select correct type and size on form
  !!mdsFT22.type.select('RTEXT', !type)
  handle ANY
  endhandle
  !!mdsFT22.size.select('DTEXT', !size)
  handle ANY
  endhandle

  if (!!mdsFT22.type.rtext[!!mdsFT22.type.val] eq 'G' ) then
    !struType    = !!mdsFT22.type.selection('Rtext').trim()
    if (!strudesc eq 'Initec Industrial Templates') then
      !!mdsFT22.height.active = FALSE
    else
      !!mdsFT22.height.active = TRUE
      !!mdsFT22.height.val = !length
    endif
  endif
  -- Show Form for frame type FT22
  !!kShowForm(!!mdsFT22)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!mdsDacControl(false)



endfunction
