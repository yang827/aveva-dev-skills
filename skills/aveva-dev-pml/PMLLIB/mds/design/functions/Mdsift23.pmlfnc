--------------------------------------------------------------------------------
--
--   File: Mdsift23.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--   Keyword: MDS
--   Module: design
--   Replaces: IPS147
--
-- Author: I.osborne
-- Created: Mon Aug 04
--
--
-- Description:
-- Initialisation for form ft23
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt23(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft23.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsoptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft23

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft23.select.select('RTEXT', 'IDCUR')
  !!mdsft23.datum.active = true
  !!mdsft23.cancel.active = TRUE
  !!mdsft23.setMat.active = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = FALSE
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  !vertical = !name & '-V1'

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft23.cancel.callback = |Call !!mdsCancelSupp(!!mdsft23)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsframe.replacement
    !support.type    = !!mdsframe.standard.selection('Rtext')
    !struName        = !!mdsframe.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft23.name.val = !struName

    !!mdsft23.dim1.val = 0
    !!mdsft23.dist.val = 0
    !!mdsft23.p.val = ''

    !!mdsframe.hide()

      --<kp>jan2012
      -- associations
      !association[1] = object MDSASSOCIATION(!vertical)

    ------------------------------ ***** Connexions --------------------
    --
  else

    -- Set callback on cancel button
    !!mdsft23.cancel.callback = |Call !!mdsRestoreForm(!!mdsft23)|
    !support.modify = true
    !!mdsft23.datum.active = false

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !post      = !name & '-V1'

    -- Get length of existing Post
    !length = deri length of $!post
    !support.barlen.append(!length)

    -- Store Data in support object
    !support.type     = 'FT23'
    !support.position = true
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 23 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft23.name.val = !name
    !!mdsft23.dim1.val = 0
    !!mdsft23.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    --
    --<kp>jan2012
    !verticals[1] = !vertical.dbref()

    -- set support object for joints
    !support.joints = !!mdsGetJoints(!verticals)
    --<kp>jan2012

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft23.createByCur.active = true
      !!mdsft23.createByDim.active = false
      !unusedhavejoints = true
    else
      !!mdsft23.createByCur.active = true
      !!mdsft23.createByDim.active = true
      endif
-------------------------------------------------------------------

      --<kp>jan2012
      -- associations
      !association[1] = object MDSASSOCIATION(!verticals[1])

    endif

     --<kp>jan2012
     -- associations
    !support.associations = !association

  -- Store support object in form
  !!mdsft23.support = !support

  -------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
  !!mdssupportsctns(!!mdsft23)
  !!mdsft23.support.mdssctnsstore = !!mdsft23.support.mdssctns
  --<wd>aug2007<mds12>
  -------------------------------------------------------------------

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft23.repre.clear()
  !!mdsft23.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft23.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft23.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft23.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 23
  --  !!ce = /MDS/FRAMES/FT23
  -- Mod to allow FT48 to be created dtf 01.03.04
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  --!dtext = ARRAY()
  --<wd>17jan2008n -- P-4655-- Support Incident 2418
  -- An ERROR was raised at lin 363 below because the variable !rtext was INCORRECTLY commented out here!
  !rtext = ARRAY()
  --<wd>17jan2008n -- P-4655 -- Support Incident 2418
  -- !!mdsSetSize('CREATE',!!mdsft23,'-V1','-V1')
  !!mdsSetSteel.init('HIDE',!!mdsft23,'-V1','')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsft23.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsft23.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsft23.select.active = TRUE
  handle ANY
  endhandle
  !!mdsft23.bthro.active = TRUE
  handle ANY
  endhandle

  -- Find current units and set the distance unit to metric

  --    !currentunits = !!kgetsetunits()

  -- sizes
  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle

  if !desc.eq('Zimmer Templates') then

    !subs1  = !!kCollectAllFor('SUBS', '((match(name, |SUBS1|) gt 0))', !!ce)
    !subs2  = !!kCollectAllFor('SUBS', '((match(name, |SUBS2|) gt 0))', !!ce)
    !frmw1  = !!kCollectAllFor('FRMW', '((match(name, |FRMW1|) gt 0))', !!ce)
    !display = ARRAY()
    do !i index !subs1

      !!ce = $!subs1[$!i]
      !!ce = first mem
      !subs1xlen = !!ce.xlen
      -- get format
      !!kformattext.text.val = !subs1xlen
      !subs1xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !subs1xformat = !subs1xformat.replace('.00','')
      !subs1zlen = !!ce.zlen
      -- get format
      !!kformattext.text.val = !subs1zlen
      !subs1zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !subs1zformat = !subs1zformat.replace('.00','')

      !!ce = $!subs2[$!i]
      !!ce = first mem
      !subs2xlen = !!ce.xlen
      -- get format
      !!kformattext.text.val = !subs2xlen
      !subs2xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !subs2xformat = !subs2xformat.replace('.00','')
      !subs2zlen = !!ce.zlen
      -- get format
      !!kformattext.text.val = !subs2zlen
      !subs2zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !subs2zformat = !subs2zformat.replace('.00','')

      !!ce = $!frmw1[$!i]
      !!ce = first mem
      !sctnsize = !!ce.spref.name.split('/')[3]

      -- !display.append(!subs1xformat & 'x' & !subs1yformat & 'x' &  !subs1zformat  & ' - ' & !subs2xformat & 'x' & !subs2yformat & 'x' &  !subs2zformat )
      !display.append(!subs1xformat & 'x' &  !subs1zformat  & ' - ' & !sctnsize & ' - ' & !subs2xformat  & 'x' &  !subs2zformat )
      -- !display.append(!subs1xformat & 'x' &  !subs1zformat  & ' - ' & !subs2xformat  & 'x' &  !subs2zformat )
    enddo
    !rtext.clear()
    do !i from 1 to !display.size()
      !rtext.append(!i.string())
    enddo
  else
    !subs  = !!kCollectAllFor('SUBS', '((match(name, |SUBS1|) gt 0))', !!ce)
    !display = ARRAY()
    do !v values !subs
      !!ce = !v
      !!ce = first mem
      !xlen = !!ce.xlen
      -- get format
      !!kformattext.text.val = !xlen
      !xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !xformat = !xformat.replace('.00','')
      !ylen = !!ce.ylen
      -- get format
      !!kformattext.text.val = !ylen
      !yformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !yformat = !yformat.replace('.00','')
      !zlen = !!ce.zlen
      -- get format
      !!kformattext.text.val = !zlen
      !zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !zformat = !zformat.replace('.00','')

      --   !display.append(!xlen & 'x' & !ylen & 'x' & !zlen)
      !display.append(!xformat & 'x' & !yformat & 'x' &  !zformat)
    enddo
    !rtext.clear()
    do !i from 1 to !display.size()
      !rtext.append(!i.string())
    enddo
  endif

  !!mdsft23.cap.dtext = !display
  !!mdsft23.cap.rtext = !rtext

  --<kp>nov2011
  !!mdsft23.cap.active = !rtext.set()

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft23,'-V1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft23,'-V1','')

    --<g.e.8/6/04 fix for Framatome i.e. no cap's
    !flag = TRUE
    !!ce = $!<name>/SUBS1

    handle (2,109)
      !flag = FALSE
      !!mdsft23.cap.active = FALSE
    endhandle

    if !flag then
      !desc = desc of /MDS/TEMPLATES
      handle ANY
        !desc = ''
      endhandle
      if !desc.eq('Zimmer Templates') then

        !!ce = $!<name>/SUBS1
        !!ce = first mem
        !subs1xlen = !!ce.xlen
        -- get format
        !!kformattext.text.val = !subs1xlen
        !subs1xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !subs1xformat = !subs1xformat.replace('.00','')
        !subs1zlen = !!ce.zlen
        -- get format
        !!kformattext.text.val = !subs1zlen
        !subs1zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !subs1zformat = !subs1zformat.replace('.00','')

        !!ce = $!<name>/SUBS2
        !!ce = first mem
        !subs2xlen = !!ce.xlen
        -- get format
        !!kformattext.text.val = !subs2xlen
        !subs2xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !subs2xformat = !subs2xformat.replace('.00','')
        !subs2zlen = !!ce.zlen
        -- get format
        !!kformattext.text.val = !subs2zlen
        !subs2zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !subs2zformat = !subs2zformat.replace('.00','')

        !!ce = $!<name>/MAIN
        !!ce = first mem
        !sctnsize = !!ce.spref.name.split('/')[3]

        !unusedx = !subs1xformat & 'x' &  !subs1zformat  & ' - ' & !sctnsize & ' - ' & !subs2xformat  & 'x' &  !subs2zformat

        !!mdsft23.cap.select('RTEXT', !!mdsft23.cap.dtext.findfirst(!subs1xformat & 'x' &  !subs1zformat  & ' - ' & !sctnsize & ' - ' & !subs2xformat  & 'x' &  !subs2zformat).string())

      else
        !!ce = first mem
        !xlen = !!ce.xlen
        -- get format
        !!kformattext.text.val = !xlen
        !xformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !xformat = !xformat.replace('.00','')
        !ylen = !!ce.ylen
        -- get format
        !!kformattext.text.val = !ylen
        !yformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !yformat = !yformat.replace('.00','')
        !zlen = !!ce.zlen
        -- get format
        !!kformattext.text.val = !zlen
        !zformat = !!kformattext.text.val.string(!!$!!kformattext.text.format)
        !zformat = !zformat.replace('.00','')

        !!mdsft23.cap.select('RTEXT', !!mdsft23.cap.dtext.findfirst(!xformat & 'x' & !yformat & 'x' & !zformat).string())
      endif
    endif
    -- end of test

    !!ce = !!mdsft23.support.datum

    -- Set distance gadget
    !!mdsDistance(!!mdsft23)

    -- Store Atta reference in form
    if !uniquenames then
    	!form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft23.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsframe.standard.rtext.findfirst('$!alias')
  !text  = !!mdsframe.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsframe,'FRAME')
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft23.support.replace = !formName

  call !!mdsSetFormName(!!mdsft23, 'PIPE', '$!formName')

  !!ce = !!mdsft23.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1-A')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-A')
  endif

  ------------------------ connexions ----------------------------
  --

  ----------------------------------------------------------------

  !!mdsft23.rotatt.active = true
  --<kp>nov2011
  --!!mdsft23.addpipe.active = TRUE
  !!mdsft23.addpipe.active = false

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft23)
  --<dw>sep2007

  -- Store current form information
  !!mdsft23.support.storeFt(!!mdsft23)

  -- Set dimensions toggle

  !!mdsft23.graphicalDim = false

  -- Show Form for frame type FT23
  !!kShowForm(!!mdsft23)


  -- Reset Units

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
-- End of function definition for !!mdsIFt23
