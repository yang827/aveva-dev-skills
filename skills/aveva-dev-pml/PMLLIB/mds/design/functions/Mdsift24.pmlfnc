--------------------------------------------------------------------------------
--
-- File:  Mdsift24.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS148
--
-- Author:  I.osborne
-- Created:  Tue Aug 05
--
--
-- Description:
-- Initialisation for form ft24
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt24(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft24.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !uniquenames = !!mdsoptions.mdsuniquenames
  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft24

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft24.select.select('RTEXT', 'IDCUR')
  !!mdsft24.datum.active = true
  !!mdsft24.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 0
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft24.cancel.callback = |Call !!mdsCancelSupp(!!mdsft24)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft24.name.val = !struName

    !!mdsft24.dist.val = 0
    !!mdsft24.p.val = ''

    !!mdsFrame.hide()

  else

    -- Set callback on cancel button
    !!mdsft24.cancel.callback = |Call !!mdsRestoreForm(!!mdsft24)|
    !support.modify = true
    !!mdsft24.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT24'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 24 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107)  (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo
    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Set Form Gadgets
    !!mdsft24.name.val = !name
    !!mdsft24.dim2.val = 0
    !!mdsft24.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsft24.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft24.repre.clear()
  !!mdsft24.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft24.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft24.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft24.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 24
  !!ce = /MDS/FRAMES/FT24
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  !dtext = ARRAY()
  !rtext = ARRAY()
  -- !!mdsSetSize('CREATE',!!mdsft24,'-BAR-1','-BAR-1')
  !!mdsSetSteel.init('HIDE',!!mdsft24,'-BAR-1','')

  !setDtext = !!mdsSetSteel.size.dtext
  !setDtext.unique()
  !!mdsSetSteel.size.clear()
  !!mdsSetSteel.size.dtext = !setDtext
  !rtext.clear()
  do !setRtext from 1 to !setDtext.size()
    !rtext.append(!setRtext.string())
  enddo
  !!mdsSetSteel.size.rtext = !rtext

  -- Length of steel members
  !dtext.clear()
  !rtext.clear()
  !types = !!kCollectAllFor('SCTN', '((match(name, |BAR-1|) gt 0) and type of owner eq |FRMW|)', !!ce)
  do !v values !types
    !!ce = !v
    !length = DERI LEN
    -- get format
    !!kFormatText.text.val = !length
    !lFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !dtext.append(!lFormat)
    !rtext.append(!length.string())
  enddo
  !dtext.unique()
  !rtext.unique()

  -- !rtext.clear()
  -- do !i from 1 to !dtext.size()
  -- !rtext.append(!i.string())
  -- enddo

  --<kp>dec2011
  -- if there is only one length use text gadget instead of option
  !fixedleng = !dtext.size().gt(1)
  !!mdsft24.dim1.visible = !fixedleng
  !!mdsft24.dim1text.visible = !fixedleng.not()

  !!mdsft24.dim1.dtext = !dtext
  !!mdsft24.dim1.rtext = !rtext
  !!mdsft24.dim1text.val = !length

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft24,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsft24,'-BAR-1','')

    !setDtext = !!mdsSetSteel.size.dtext
    !setDtext.unique()
    !!mdsSetSteel.size.clear()
    !!mdsSetSteel.size.dtext = !setDtext
    !rtext.clear()
    do !setRtext from 1 to !setDtext.size()
      !rtext.append(!setRtext.string())
    enddo
    !!mdsSetSteel.size.rtext = !rtext

    !!ce = $!<name>-BAR-1

    !length = DERI LENGTH

    if !fixedleng then
      !!mdsft24.dim1.val = (!!mdsft24.dim1.rtext.findfirst(!length.string()))
    else
      !!mdsft24.dim1text.val = !length
    endif

    !!ce = !!mdsft24.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft24)

    -- Store Atta reference in form
    if !uniquenames then
    	!form.support.atta.appendarray(!support.referenceAtta())
    else
      do !count from 211 to 259
        var !num ($!count - 210)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle ANY
          skip
        endhandle
        !form.support.atta.append(!!ce)
      enddo
    endif

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!form)

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsft24.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft24.dim2.val = !despars[2]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  -- In creation mode make dim2 half the value of dim 1



  if (!modify.upcase() neq |MODIFY|)then
    --<kp>dec2010
    if !fixedleng then
      !d1 = !length
    else
      !d1 = !!mdsft24.dim1.selection('RTEXT').real() / 2
    endif
    !!mdsft24.dim2.val = !d1
  endif


  -- Reset Units

  !!kRestoreUnits(!currentunits)


  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT24')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT24')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft24.support.replace = !formName

  call !!mdsSetFormName(!!mdsft24, 'PIPE', '$!formName')

  !!ce = !!mdsft24.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT24-A-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT24-A-1')
  endif

  !!mdsft24.connect.active = False
  !!mdsft24.modify.active = False
  !!mdsft24.disconn.active = False
  !!mdsft24.forceCon.active = False

  -- Store current form information
  call !!mdsStoreFt24()

  -- Show Form for frame type FT24
  !!kShowForm(!!mdsft24)

  -- Set dimensions toggle

  !!mdsft24.graphicalDim = false

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  !form.newdat.active = !uniquenames.not()
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
