--------------------------------------------------------------------------------
--
-- File:  Mdsift25.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS149
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 18th November 1997
--
--
-- Description:
-- Initialisation for Frame Type form 'FT25'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--                             or  ''       is passed if the support is being Created
--                             or  'Frame'  is passed if the support is to be Created on another Framework
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--     4     R         FORM        Form Name of FRAMEWORK called from
--     5     R         DBREF       Atta DBREF Selected to be Supported with a Packing Piece
--     6     R         DBREF       Cross Bar DBREF Selected Atta is Supported on
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsift25(!modify is STRING, !textname is STRING, !alias is STRING, !form is FORM, !pick is DBREF, !xbar is DBREF)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft25.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- <sk> 04/06/2012
  !fromAtta = false

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textname
  if (!modify eq ||) then
    !mode = 'CREATE'
  else
    !mode = !modify.upcase()
  endif

  ----------------------------------------------------------------------

  -- Check to see if form 'Mdsft25' is already shown
  -- Then check to see which form it has been called from
  if (!!mdsft25.shown()) then
    !callb = !!mdsft25.create.callback
    !xform = !callb.split('!!')
    !yform = !xform[5].split(')')
    if ('$!yform[1]' ne '$!form') then
      !!alert.warning ('The Form for Creating Packing Pieces is already shown and associated with support ''$!!mdsft25.name.val'' ')
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif

  ----------------------------------------------------------------------

  -- Initialise Standard gadgets
  !!mdsft25.select.select('RtexT', 'IDCUR')
  !!mdsft25.datum.active   = true
  !!mdsft25.bdist.active   = true
  !!mdsft25.dist.active    = true
  !!mdsft25.bthro.active   = true
  !!mdsft25.select.active  = true
  !!mdsft25.p.active       = true
  !!mdsft25.flip.active    = true
  !!mdsft25.modatta.active = true
  !!mdsft25.rotate.active  = true
  !!mdsft25.cancel.active  = true
  !!mdsft25.ok.active      = true
  --<k.pleschner>May06
  !!mdsft25.clear.active   = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotatecur = false
  !support.handedcur = false
  !support.rotated   = 0
  !support.bpnum     = 0
  !support.alias     = !alias


  --< Modified - <wd> - 2sep1998
  --  Initially Set Clearance Variable to default Pipe Clearance
  --!clear = !!mdsoptions.clear.val
  --<k.pleschner>May06
  !ancdef = object MDSANCGEOMDFLTS(!pick)
  !clear = !ancdef.oend
  --<k.pleschner>May06
  --< Modified - <wd> - 2sep1998


  --  Create a NEW Framework Structure if Independent of other FRAMEWORK
  ----------------------------------------------------------------------
  if (!mode eq |CREATE|) then

    -- Set callback on cancel button
    !!mdsft25.cancel.callback = |call !!mdscancelsupp(!!mdsft25)|
    !support.modify = false

    -- Set callback on OK button
    !!mdsft25.ok.callback = |call !!mdsacceptft25('OWNER')|

    -- Set clearance gadget to application default
    --<k.pleschner>May06 commented out - if mode is CREATE gadget is inactive and unset
    --!!mdsft25.clear.val = !clear
    !!mdsft25.clear.val = REAL()
    !!mdsft25.clear.active = FALSE
    --<k.pleschner>May06

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('rtext')
    !struname        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsmovetosite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru if NOT Part of another FRAMEWORK
    new stru /$!struname
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form with Name
    !!mdsft25.name.val = !struname

    -- Set Default dimensions
    !!mdsft25.dist.val = 0

    -- Set Through button descriptive text to default
    -- and Atta rotation gadget value to default
    !!mdsft25.p.val = ''

    -- Select Type 'A' Packing Piece
    !!mdsft25.type.select('A')
    !selection = 'A'

    -- Set Form Members
    !!mdsft25.crbar = nulref
    !!mdsft25.fatta = nulref

    -- Set callback on .create(Build) button
    !!mdsft25.create.callback = |call !!mdscreateft25(!!mdsft25)|

    -- Hide Create Framework Type Selection Form
    !!mdsFrame.hide()

    -- Create Packing Piece as a MEMBER of the 'foreign' FRAMEWORK it is Attached to
    ---------------------------------------------------------------------------------
  elseif (!mode eq |FRAME|) then

    -- Initialise Variables
    !support = !form.support
    !stru    = !support.stru
    !name    = !stru.name
    !namn    = !stru.namn
    !frame   = !name & '/MAIN'
    !fname   = '!!' & !form

    -- Set Form Member '.fatta' and '.crbar' to the Selected Atta and Cross Bar
    !!mdsft25.fatta = !pick
    !!mdsft25.crbar = !xbar

    -- Set clearance gadget to application default
    !!mdsft25.clear.val = !clear

    -- Set Form Name to Reflect Owning Structure's Name
    !!mdsft25.formtitle = 'Packing Piece for ''$!namn'''
    -- Set Paragraph gadget on form with the Name of Owning Framework Structure
    !!mdsft25.name.val = !pick.name
    -- Set Default dimensions
    !!mdsft25.dist.val = 0

    -- Set Datum Atta Gadgets to 'Inactive'
    !!mdsft25.datum.active   = false
    !!mdsft25.bdist.active   = false
    !!mdsft25.dist.active    = false
    !!mdsft25.bthro.active   = false
    !!mdsft25.select.active  = false
    !!mdsft25.p.active       = false
    !!mdsft25.nudge.active   = false
    !!mdsft25.flip.active    = false
    !!mdsft25.modatta.active = true
    !!mdsft25.rotate.active  = false

    -- Set callback on .create(Build) button
    !!mdsft25.create.callback = |call !!mdscreateft25($!fname)|

    -- Set OK button inactive until Packing Piece has been built
    !!mdsft25.ok.active = false
    -- Set callback on OK button
    !!mdsft25.ok.callback = |call !!mdsacceptft25('FRAME')|

    -- Set callback on cancel button
    !!mdsft25.cancel.callback = |call !!mdscancelft25($!fname)|

    -- Initial Selection Type 'A' Packing Piece
    !!mdsft25.type.select('A')
    !selection = 'A'

    -- Navigate to Framework of Owning Structure
    !!ce = !frame.dbref()

    -- Modify Existing Framework
    --------------------------------------------------------------------------------
  elseif (!mode eq |MODIFY|) then

    -- Set replacement name
    !support.replace = !!mdsFrame.replacement

    -- Set Form Gadgets to 'Active/Inactive'
    !!mdsft25.datum.active  = false

    -- Set callback on .create(Build) button
    !!mdsft25.create.callback = |call !!mdscreateft25(!!mdsft25)|

    -- Set callback on OK button
    !!mdsft25.ok.callback = |call !!mdsacceptft25('OWNER')|

    -- Set callback on cancel button
    !!mdsft25.cancel.callback = |Call !!mdsrestoreform(!!mdsft25)|
    !support.modify = true

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT25'
    !support.position = true
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    !!mdsft25.fatta = !support.datum
    !pick = !!mdsft25.fatta
    !!mdsft25.crbar = nulref

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 Dir wrt world

    -- Get Specific data to frame type 'FT25' from UDA :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|) then
      !support.rotatecur = TRUE
    else
      !support.rotatecur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedcur = TRUE
    else
      !support.handedcur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar  = !name & '-BAR-1'
    !support.packs.append(!bar.dbref())

    --------------------------------------------------------------------------

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    --------------------------------------------------------------------------

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsft25.name.val = !name
    !!mdsft25.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textname')

    -- XXXXXXXXXXXXXX

    -- !!ce = !datumname.dbref()
    -- !desp2 = !!ce.:MDSPackRef.wdesp[2]
    -- handle any
    -- !!mdsft25.type.select('A')
    -- !selection = 'A'
    -- !!mdstagft25('A')
    -- elsehandle none
    -- !!mdsft25.type.select('$!desp2')
    -- !selection = '$!desp2'
    -- !!mdsft25.size.clear()
    -- !!mdstagft25('$!desp2')
    -- endhandle

    -- !!ce = !support.stru

    -- XXXXXXXXXXXXXXXX

  endif
  -- End of 'CREATE' or 'FRAME' or 'MODIFY' - Framework or Packing Piece
  ---------------------------------------------------------------------------

  -- Store support object in form
  !!mdsft25.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft25.repre.clear()
  !!mdsft25.repre.append(|call !!kreprelevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft25.repre.append(|call !!kreprelevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft25.repre.append(|call !!kreprelevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft25.repre.append(|call !!kreprelevel(Nulref, 'STRU', $!repre,0)|)

$(


  -- Collect all supports for frame type 'FT25'
  !!ce = /MDS/FRAMES/FT25$!selection
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!mode eq |CREATE|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  !!ce = !support.stru

$)

  ---------------------------------------------------------------------------

  -- Select Type and Size of Packing Piece for 'MODIFY' and 'FRAME' modes Only
  if (!mode ne 'CREATE') then
    if (!pick.:MDSPackRef.badref().not()) then

      !desp2 = !pick.:MDSPackRef.wdesp[2]
      handle any
        !!mdsft25.type.select('A')
        !selection = 'A'
        !!mdstagft25('A')
      elsehandle none
        !!mdsft25.type.select('$!desp2')
        !selection = '$!desp2'
        !!mdsft25.size.clear()
        !!mdstagft25('$!desp2')
      endhandle

      !desp3 = !pick.:MDSPackRef.desp[3]
      handle any
        !!mdsft25.size.select('rtext','1')
      elsehandle none
        !!mdsft25.size.select('rtext',!desp3.string())
      endhandle

      --> Modified - <wd> - 2sep1998
      -- Get Clearance from despar number 4
      !desp4 = !pick.:MDSPackRef.desp[4]
      handle any
        -- Set Clearance gadget to default Pipe Clearance
        --!!mdsft25.clear.val = !clear
        --<k.pleschner>May06 - get clearance value from atta defaults
        !ancdef = object MDSANCGEOMDFLTS(!pick)
        !!mdsft25.clear.val = !ancdef.oend
      elsehandle none
        !!mdsft25.clear.val = !desp4
      endhandle
      --< Modified - <wd> - 2sep1998

    endif
  endif

  -- Collect all supports for frame type 'FT25'
  !!ce = /MDS/FRAMES/FT25$!selection
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!mode eq |CREATE|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSize('CREATE',!!mdsft25,'-BAR-1','-BAR-1')
  -- !!mdsSetSteel.init('HIDE',!!mdsft25,'-BAR-1','')
  !!ce = !support.stru

  ---------------------------------------------------------------------------
  -----------------------------------------------------------------------------

  -- Determine Values for Existing Framework
  if (!mode eq |MODIFY|) then
    !!mdsSetSize('SELECT',!!mdsft25,'-BAR-1','-BAR-1')
    -- !!mdsSetSteel.init('HIDE',!!mdsft25,'-BAR-1','')
    !!ce = !!mdsft25.support.datum
    -- Set distance gadget
    !!mdsdistance(!!mdsft25)
    -- Add marker text markers to Graphical Display
    var !pos pos wrt world
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      -- Store Atta reference in form
      !!mdsft25.support.atta.append(!!ce)
      var !pos pos wrt world
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
    enddo
  endif

  -->>>-<wd>nov2002
  -- Ensure that the Correct material Size is Selected for an EXISTING Packer
  !desp3 = !pick.:MDSPackRef.desp[3]
  handle any
    !!mdsft25.size.select('rtext','1')
  elsehandle none
    !!mdsft25.size.select('rtext',!desp3.string())
  endhandle
  --<<<-<wd>nov2002
  --------------------------------------------------------------------------------

  label /CONT

  -- Redefine standard support name on form title
  !index = !!mdsFrame.standard.rtext.findfirst('FT25')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT25')
    !text  = !!mdsFrame.standard.dtext[!index]
    handle any
      -- We are creating a packaging piece and this support is turned off??
      !text = !!mdsFrame.replacement & '-'
    endhandle
  endhandle
  !suppnumber = before(!text, '-')
  !formname   = !suppnumber.trim()

  if (!mode neq 'FRAME') then
    !!mdsft25.support.replace = !formname
    call !!mdssetformname(!!mdsft25, 'PIPE', '$!formname')
  endif

  !!ce = !!mdsft25.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,'FT25','FT25-A-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,'FT25','FT25-A-1')
  endif

  -- Store current form information
  call !!mdsstoreft25('$!modify')

  -- Set dimensions toggle

  !!mdsft25.graphicalDim = false


  -- Show Form for frame type FT25
  !!kshowform(!!mdsft25)

  !!kRestoreUnits(!currentunits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!!mdsft25, !datum)
  endif

endfunction
