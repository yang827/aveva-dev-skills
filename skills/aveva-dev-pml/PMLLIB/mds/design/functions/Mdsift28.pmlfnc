--------------------------------------------------------------------------------
--
-- File:  Mdsift28.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS152
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 4th November1997
--
--
-- Description:
-- Initialisation for Frame Type form 'FT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsift28(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT28.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT28

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT28.select.select('rtext', 'IDCUR')
  !!mdsFT28.datum.active = true
  !!mdsFT28.cancel.active = true
  !!mdsFT28.graphicaldim = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bpnum     = 0
  !support.alias     = !alias

  --  Create a NEW Framework
  --------------------------
  if (!modify.upcase() neq |MODIFY|)then


    -- Set callback on cancel button
    !!mdsFT28.cancel.callback = |call !!mdscancelsupp(!!mdsFT28)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('rtext')
    !struname        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsmovetosite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)
    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    new stru /$!struname
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form with Name
    !!mdsFT28.name.val = !struname

    -- Set Default Distance
    !!mdsFT28.dist.val = 0

    -- Set Through button descriptive text to default
    -- and Atta rotation gadget value to default
    !!mdsFT28.p.val = ''

    -- Set Default Clearances
    !!mdsFT28.clear.val = !!mdsOptions.clear.val
    !!mdsFT28.fcler.val = 125

    -- Hide Create Framework Type Selection Form
    !!mdsFrame.hide()

    ------------------------------**** Connexions *****---------------------------
    -- Only CURSOR available
    !!mdsFT28.createByDim.active = false
    !!mdsFT28.createByCle.active = false
    !!mdsFT28.createByCur.active = true
    ------------------------------------------------------------------------------

  else

    -- Modify Existing Framework
    ----------------------------

    -- Set callback on cancel button
    !!mdsFT28.cancel.callback = |call !!mdsrestoreform(!!mdsFT28)|
    !support.modify = true
    !!mdsFT28.datum.active = false

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT28'
    !support.position = true
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world


    -- Get Specific data to frame type 'FT28' from UDA :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get values from DESPARS of SREF Atta
    -- (Stored in mm)
    !!ce     = !sref.dbref()
    !despars = despar

    -- Clearance Despar 1 for Hole in Section
    !!mdsFT28.clear.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the MDS application. The Default Pipe/Hole Clearance value of ''$!!mdsOptions.clear.val'' has been entered on the form.')
      -- Framework Verticals Clearance from O/Dia of Hole
      !!mdsFT28.clear.val = !!mdsOptions.clear.val
    endhandle

    !!mdsFT28.fcler.val = !despars[2]
    handle any
      !!alert.error('Support created with a previous version of the MDS application. The Default Hole/Frame Clearance value of ''125'' has been entered on the form.')
      !!mdsFT28.fcler.val = 125
    endhandle

    !!mdsFT28.desp3 = !despars[3]
    handle any
      --> Modified - <wd> - 2sep1998
      --        !!alert.error('Support created with a previous version of the MDS application.')
      --< Modified - <wd> - 2sep1998
      !!mdsFT28.desp3 = 100
    endhandle

    --> Modified - <wd> - 2sep1998
    --      !!mdsFT28.desp4 = !despars[4].string()
    !!mdsFT28.desp4 = wdesp[4]
    handle any
      --        !!alert.error('Support created with a previous version of the MDS application.')
      --< Modified - <wd> - 2sep1998
      !!mdsFT28.desp4 = 'U'
    endhandle


    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !bar = !name & '-BAR-1'

    --------------------------------------------------------------------------
    --------------------------------------------------------------------------

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------
    --------------------------------------------------------------------------

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsFT28.name.val = !name
    !!mdsFT28.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsFT28.lineUp.active = True
    -- endif

    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !conn2 = !vertDbref[1].:MDSXConn

    !vert2 = !name & '-V2'
    !vertDbref[2] = !vert2.dbref()
    !conn3 = !vertDbref[2].:MDSConn
    !conn4 = !vertDbref[2].:MDSXConn

    !support.connections[1] = !conn1
    !support.connections[2] = !conn2
    !support.connections[3] = !conn3
    !support.connections[4] = !conn4

    -- set support object for joints
    !support.joints = !!mdsGetJoints(!vertDbref)

    -- hide dimension form the list if connected
    !!mdsFT28.createByDim.active = false
    !!mdsFT28.createByCle.active = false
    !!mdsFT28.createByCur.active = true
    -------------------------------------------------------------------

  endif

  -- End of Modify Existing Framework
  -------------------------------------


  -----------------------------------------------------
  -----------------------------------------------------

  -- Store support object in form
  !!mdsFT28.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT28.repre.clear()
  !!mdsFT28.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT28.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT28.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT28.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 'FT28'
  !!ce = /MDS/FRAMES/FT28
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsFT28,'-BAR-1','-V1')

  !!ce = !support.stru


  -----------------------------------------------------

  -- Determine Values for Existing Framework
  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT28,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT28,'-BAR-1','-V1')


    !!ce = !!mdsFT28.support.datum

    -- Set distance gadget
    !!mdsdistance(!!mdsFT28)

    -- Add marker text markers to Graphical Display
    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsFT28.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    --> Removed - <wd> - 2sep1998
    --xxx-- Fill in dimensions from SREF atta (Stored in mm)
    --xxx
    --xxx      !!ce = !sref.dbref()
    --xxx      var !despar despar
    --xxx
    --xxx      !despars = split(!despar)
    --xxx        handle any
    --xxx          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
    --xxx          GOLABEL /CONT
    --xxx        endhandle
    --xxx
    --< Removed - <wd> - 2sep1998

  endif

  -----------------------------------------------------


  --xxx  LABEL /CONT

  -- Redefine standard support name on form title
  !index = !!mdsFrame.standard.rtext.findfirst('FT28')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT28')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT28.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT28, 'PIPE', '$!formName')

  !!ce = !!mdsFT28.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT28-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT28-1')
  endif

  ------------------------ connexions ----------------------------
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT28.connect.active = False
    !!mdsFT28.modify.active = False
    !!mdsFT28.disconn.active = False
    !!mdsFT28.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT28.support.stru.unset()) then
    !!mdsFT28.connect.active = False
    !!mdsFT28.modify.active = False
    !!mdsFT28.forceCon.active = False
    !!mdsFT28.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT28.connect.active = True
    !!mdsFT28.forceCon.active = False
    !!mdsFT28.modify.active = False
    !!mdsFT28.disconn.active = True
  else
    !!mdsFT28.connect.active  = True
    !!mdsFT28.modify.active   = True
    !!mdsFT28.forceCon.active = True
    !!mdsFT28.disconn.active  = True
  endif
  ----------------------------------------------------------------

  -- Set dimensions toggle
  !!mdsFT28.graphicaldim = false

  -- Store current form information
  call !!mdsStoreft28()

  -- Show Form for frame type ft28
  !!kShowForm(!!mdsFT28)


  -- Reset Units

  !!kRestoreUnits(!currentunits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
