--------------------------------------------------------------------------------
--
-- File:  Mdsift30.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS133
--
-- Author:  I.osborne
-- Created:  Thu Jul 03
--
--
-- Description:
-- Initialisation for form ft30
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIft30(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft30.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Set Units
  !currentunits = !!kgetsetunits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft30

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  --  !!mdsft30.select.select('RTEXT', 'IDCUR')
  !!mdsft30.datum.active  = true
  !!mdsft30.cancel.active = true
  !!mdsft30.bdist.active  = false
  !!mdsft30.dist.active   = false
  !!mdsft30.bthro.active  = false
  !!mdsft30.select.active = false
  !!mdsft30.dim1.active   = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 0
  !support.alias     = !alias

  -- Create mode

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft30.cancel.callback = |Call !!mdsCancelSupp(!!mdsft30)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE

      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft30.name.val = !struName
    !!mdsft30.dim1.val = 0
    !!mdsft30.dist.val = 0
    !!mdsft30.p.val = ''

    !!mdsFrame.hide()

  else

    -- Set callback on cancel button
    !!mdsft30.cancel.callback = |Call !!mdsRestoreForm(!!mdsft30)|
    !support.modify = true
    !!mdsft30.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'FT30'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world


    -- Get Specific data to frame type 10 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce = !support.stru
    !bar = !name & '-BAR-1'

    -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
    !!ce = !bar.dbref()
    var !ref :MDSAttaRef
    !arefs = split(!ref)
    !references = ARRAY()

    do !index indices !arefs
      !references.append(!arefs[!index].dbref())
      handle(2,107) (2,813)
        -- Atta has been manually deleted
      endhandle
    enddo

    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft30.name.val = !textName
    !!mdsft30.dim1.val = 0
    !!mdsft30.p.val    = ''

    !!mdsAddAll('$!textName')
    --$(
    ------------------------------ ***** Connexions --------------------

    -- if(!support.connections.size().eq(1)) then
    -- !!mdsft30.lineUp.active = True
    -- endif

    -- set support object connections
    !connectedSctns = ARRAY()
    !vert1 = !name & '-BAR-1'
    !connectedSctns[1] = !vert1.dbref()
    !conn1 = !connectedSctns[1].:MDSConn
    !hori = !name & '-BAR-1'
    !connectedSctns[2] = !hori.dbref()
    !conn2 = !connectedSctns[2].:MDSConn
    !support.connections[1] = !conn1
    !support.connections[2] = !conn2

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!connectedSctns)
    --$)
    -------------------------------------------------------------------
$(
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      --       !!mdsft30.createByDim.active = false
      --       !!mdsft30.createByCle.active = true
      !!mdsft30.createByCur.active = true
    else
      !!mdsft30.createByDim.active = true
      !!mdsft30.createByCle.active = true
      !!mdsft30.createByCur.active = true
    endif
$)
    -------------------------------------------------------------------
  endif

  -- Set create mode icons

  !!mdsft30.createByDim.active = false
  !!mdsft30.createByCle.active = false
  -- !!mdsft30.createByCur.active = true

  -- Store support object in form
  !!mdsft30.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft30.repre.clear()
  !!mdsft30.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft30.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft30.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft30.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 30
  !!ce = /MDS/FRAMES/FT30
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsft30,'-BAR-1','-BAR-1')

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft30,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsft30,'-BAR-1','-BAR-1')

    !!ce = !!mdsft30.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft30)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsft30.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array
    !!mdspackattas(!!mdsft30.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar


    !!mdsft30.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT30')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT30')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft30.support.replace = !formName

  call !!mdsSetFormName(!!mdsft30, 'PIPE', '$!formName')

  !!ce = !!mdsft30.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT30-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT30-1')
  endif

  ------------------------ connexions ----------------------------
$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft30.connect.active = False
    !!mdsft30.modify.active = False
    !!mdsft30.disconn.active = False
    !!mdsft30.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft30.support.stru.unset()) then
    !!mdsft30.connect.active = False
    !!mdsft30.modify.active = False
    !!mdsft30.forceCon.active = False
    !!mdsft30.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft30.connect.active = True
    !!mdsft30.forceCon.active = False
    !!mdsft30.modify.active = False
    !!mdsft30.disconn.active = True
  else
    !!mdsft30.connect.active  = True
    !!mdsft30.modify.active   = True
    !!mdsft30.forceCon.active = True
    !!mdsft30.disconn.active  = True
  endif
  ----------------------------------------------------------------
$)

  -- Store current form information
  call !!mdsStoreft30()

  -- Set dimensions toggle

  !!mdsft30.graphicalDim = false

  -- Show Form for frame type ft30
  !!kShowForm(!!mdsft30)

  !!kRestoreUnits(!currentunits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
