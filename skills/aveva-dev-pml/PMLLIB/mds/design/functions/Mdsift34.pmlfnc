--------------------------------------------------------------------------------
--
-- File: Mdsift34.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--
-- Author: I.Osborne
-- Created: Tue July 22
--
--
-- Description:
-- Initialisation for form FT34
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFT34(!modify is STRING, !textName is STRING,!alias is STRING)

-- $p $!alias

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!mdsft34.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------
  -- Initialise Variables
    !name = '/' & !textName
    !form = !!mdsft34

    -- <sk> 04/06/2012
    !fromAtta = false

    -- load slide options dependent on type
    if (!alias eq 'FT34A' or !alias eq 'FT34B') then
      !!mdsft34.slide.dtext = split('On Column CL\To Web of Beam\End  to Vert B/Plt\Wall','\')
      !!mdsft34.slide.rtext = split('MID\SIDE\ENDVERT\WALL','\')
      !!mdsft34.slide.select('RTEXT', 'MID')
    elseif (!alias eq 'FT34C') then
      !!mdsft34.slide.dtext = split('Below Beam\End to Hori B/Plt','\')
      !!mdsft34.slide.rtext = split('UNDER\ENDHORI','\')
      !!mdsft34.slide.select('RTEXT', 'UNDER')
    endif

  -- Initialise Standard gadgets
    !!mdsft34.select.select('RTEXT', 'IDCUR')
    !!mdsft34.datum.active    = true
    !!mdsft34.cancel.active   = true
    !!mdsft34.ancmat.active   = true
    !!mdsft34.modAtta.active  = true
    if (!alias eq 'FT34B') then
      !!mdsft34.rotate.active = true
    else
      !!mdsft34.rotate.active = false
    endif

    -- deactivate gadgets not required
    !!mdsft34.rotAtt.active        = false
    !!mdsft34.addPipe.active       = false
    !!mdsft34.addHVAC.active       = false
    !!mdsft34.addRack.active       = false
    !!mdsft34.addBar.active        = false
    !!mdsft34.addpack.active       = false
    !!mdsft34.delpack.active       = false
    !!mdsft34.connect.active       = false
    !!mdsft34.modify.active        = false
    !!mdsft34.forcecon.active      = false
    !!mdsft34.disconn.active        = false
    !!mdsft34.addpack.active       = false
    !!mdsft34.delpack.active       = false
    !!mdsft34.newdat.active        = false
    !!mdsft34.associate.active     = false
    !!mdsft34.viewassociate.active = false
    !!mdsft34.flipfw.active        = false
    !!mdsft34.deleteatta.active    = false
    !!mdsft34.spool.active         = false
    !!mdsft34.trimmer.active       = false
    !!mdsft34.anccopy.active       = false
    !!mdsft34.ancnudge.active      = false

  -- Create Support object
    !support = object MDSSUPPORT()
    !support.position  = false
    !support.mirror    = false
    !support.rotateCur = false
    !support.handedCur = false
    !support.rotated   = 0
    !support.bPNum     = 1
    !support.config    = 1
    !support.alias     = !alias

 -------------------------------------------------------------
 -- CREATE MODE ----------------------------------------------
 -------------------------------------------------------------
    if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
      !!mdsft34.cancel.callback = |Call !!mdsCancelSupp(!!mdsft34)|
      !support.modify = false

    -- Initialise variables for new supports
      !support.replace = !!mdsframe.replacement
      !support.type    = !!mdsframe.standard.selection('Rtext')
      !struName        = !!mdsframe.name.val

    -- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!mdsDacControl(true)

      --<sk> 04/06/2012
      -- check if support with given name exists already (can be preliminary support)
      !datum = object DBREF(!name)
      handle NONE
        !fromAtta = true
        !support.preliminaryStore = !!mdsSavePreInf(!datum)
        !datum.name = !name & '_Pre'

      elsehandle ANY
      endhandle
      --<sk> 04/06/2012
    -- Create Stru
      NEW STRU /$!struName
      !support.stru = !!ce
      :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
      !!mdsft34.name.val = !struName

      !!mdsft34.dim1.val = 0
      !!mdsft34.dim2.val = 0
      !!mdsft34.dist.val = 0
      !!mdsft34.p.val = ''

      !!mdsframe.hide()

      !!mdsft34.createByDim.active = true
      !!mdsft34.createByCle.active = false
      !!mdsft34.createByCur.active = true

 -------------------------------------------------------------
 -- MODIFY MODE ----------------------------------------------
 -------------------------------------------------------------
    else

    -- Set callback on cancel button
      !!mdsft34.cancel.callback = |Call !!mdsRestoreForm(!!mdsft34)|
      !support.modify = true
      !!mdsft34.datum.active = false

    -- Initialise variables for existing supports
      !datumname = !name & '/DATUM'
      !sref      = !name & '/SREF'

    -- Store Data in support object
      !support.type     = 'FT34'
      !support.position = true
      !support.datum    = !datumname.dbref()
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsmodifysupp.cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !support.stru = !name.dbref()

      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif

      -- Store Atta reference's in object
      !support.atta.append(!datumname.dbref())
      !support.atta.append(!sref.dbref())

      -- Navigate to existing support datum
      !!ce = !support.datum
      !support.pADir  = Pa Dir wrt world
      !support.pLDir  = Pl Dir wrt world
      !support.p9Dir  = P9 Dir wrt world
      !support.p10Dir = P10 Dir wrt world
      !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 34 from :MDSCp1 on datum atta
      !data = !!ce.:MDSCp1
      !split = split(!data, ';')
      if (!split[1] eq |T|)then
        !support.rotateCur = TRUE
      else
        !support.rotateCur = FALSE
      endif
      if (!split[2] eq |T|)then
        !support.handedCur = TRUE
      else
        !support.handedCur = FALSE
      endif
      if (!split[3] eq |T|)then
        !support.mirror = TRUE
      else
        !support.mirror = FALSE
      endif
      !support.config  = !split[4].real()
      !support.rotated = !split[5].real()

    -- Reset slide gadget to pick up configuration
      !!mdsft34.slide.val = !support.config

      -- Apply Data for existing cross bar
      !!ce  = !support.stru
      !bar = !name & '-BAR-1'

   -- Set Cross Bar Atta References to Support Object Member '.bars[1]'
         !!ce = !bar.dbref()
         var !ref :MDSAttaRef
         !arefs = split(!ref)
         !references = ARRAY()

         do !index indices !arefs
           !references.append(!arefs[!index].dbref())
           handle(2,107) (2,813)
             -- Atta has been manually deleted
           endhandle
         enddo

         !support.bars[1] = !references

      -- Get length of existing crossbar
      !length = deri length of $!bar
      !support.barlen.append(!length)

      -- Store section name and matref for each member

      !storeMat = ARRAY()
      !storeMat = !!mdsStoreMat(!name)
      !support.material = !storeMat


      -- Set Form Gadgets
      !!mdsft34.name.val = !name
      !!mdsft34.dim1.val = 0
      !!mdsft34.dim2.val = 0
      !!mdsft34.p.val    = ''

      !!mdsAddAll('$!textName')

      !!mdsft34.createByDim.active = true
      !!mdsft34.createByCle.active = false
      !!mdsft34.createByCur.active = true

    endif
 ----------------------------------------------------------------
 -- End of Modification specific code
 ----------------------------------------------------------------


  -- Store support object in form
    !!mdsft34.support = !support

-------------------------------------------------------------------
--<wd>aug2007<mds12>
-- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
    !!mdssupportsctns(!!mdsft34)
    !!mdsft34.support.mdssctnsstore = !!mdsft34.support.mdssctns
--<wd>aug2007<mds12>
-------------------------------------------------------------------

  -- Store Current representations in form for use later
    var !repre repre level
    !!mdsft34.repre.clear()
    !!mdsft34.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsft34.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsft34.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsft34.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 34
    if (!alias eq 'FT34A') then
      !!ce = /MDS/FRAMES/FT34A
        handle (2,109)
          !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
          if (!modify.upcase() neq |MODIFY|) then
            delete stru
          endif
          !!kRestoreUnits(!currentunits)
          return
        endhandle
    elseif (!alias eq 'FT34B') then
      !!ce = /MDS/FRAMES/FT34B
        handle (2,109)
          !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
          if (!modify.upcase() neq |MODIFY|) then
            delete stru
          endif
          !!kRestoreUnits(!currentunits)
          return
        endhandle
    elseif (!alias eq 'FT34C') then
      !!ce = /MDS/FRAMES/FT34C
        handle (2,109)
          !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
          if (!modify.upcase() neq |MODIFY|) then
            delete stru
          endif
          !!kRestoreUnits(!currentunits)
          return
        endhandle
    endif

  -- Generate Steel Size List

    --!dtext = ARRAY()
    --!rtext = ARRAY()
    !!mdsSetSteel.init('HIDE',!!mdsft34,'-BAR-1','')

    !!ce = !support.stru

 -------------------------------------------------------------
 -- MODIFY MODE ----------------------------------------------
 -------------------------------------------------------------
    if (!modify.upcase() eq |MODIFY|) then

      !!mdsSetSteel.init('HIDE',!!mdsft34,'-BAR-1','')

      !!ce = !!mdsft34.support.datum

      -- Set distance gadget

      !!mdsDistance(!!mdsft34)

      -- Add marker text markers

      VAR !pos POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 211 TO 259

        VAR !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
        handle ANY
          skip
        endhandle

        -- Store Atta reference in form
        !!mdsft34.support.atta.append(!!ce)

        VAR !pos POS WRT WORLD

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>

      enddo

      -- Fill in dimensions from SREF atta (Stored in mm)

      !!ce = !sref.dbref()
      !despars = despar

      !!mdsft34.dim1.val = !despars[1]
      handle any
        !!mdsft34.dim1.val = 0
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      endhandle

      !!mdsft34.dim2.val = !despars[2]
      handle any
        !!mdsft34.dim2.val = 0
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      endhandle

    endif
 ----------------------------------------------------------------
 -- End of Modification specific code
 ----------------------------------------------------------------

  -- Redefine standard support name on form title

  if (!alias eq 'FT34A' or !alias eq 'FT34B' or !alias eq 'FT34C') then
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsframe,'FRAME')
        !index = !!mdsframe.standard.rtext.findfirst('$!alias')
        !text  = !!mdsframe.standard.dtext[!index]
      endhandle
  endif

  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft34.support.replace = !formName

  if (!alias eq 'FT34A' or !alias eq 'FT34B' or !alias eq 'FT34C') then
    call !!mdsSetFormName(!!mdsft34, 'PIPE', '$!formName')
  endif

  !!ce = !!mdsft34.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1')
  endif

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft34.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsft34.repre.append('!!mdsRemAdd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsoptions.levchange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsoptions.levchange, $!colour)
      !colourlist = ARRAY()
      !colourlist.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourlist)
    enddo
  endif

--<dw>sep2007
  -- Store bracing information
    !!mdsbracings(!!mdsft34)
--<dw>sep2007
  -- Store current form information
    call !!mdsStoreFT34()


  -- Set dimensions toggle

    !!mdsft34.graphicalDim = false


  -- Show Form for frame type FT34
    !!kShowForm(!!mdsft34)

    !!kRestoreUnits(!currentunits)

    --<sk> 04/06/2012
    if !fromAtta then
      -- call creation of support datum from given preliminary support
      !!mdsCrDatumFromPs(!form, !datum)
    endif
-- End function
endfunction
