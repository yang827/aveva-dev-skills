--
-- File: Mdsift40.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces: IPS135
--
-- Author: Wayne Dodwell
-- Created: Monday 21 July 1997
--
--
-- Description:
-- Initialisation for form ft40
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIft40(!modify is STRING, !textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!mdsft40.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Initialise Variables
    !name = '/' & !textName
    !form = !!mdsft40

    -- <sk> 04/06/2012
    !fromAtta = false

  -- Initialise Standard gadgets
    !!mdsft40.select.select('RTEXT', 'IDCUR')
    !!mdsft40.slide.select('DTEXT', 'Centreline')
    !!mdsft40.datum.active = true
    !!mdsft40.cancel.active = true

  -- Create Support object
    !support = object MDSSUPPORT()
    !support.position  = false
    !support.mirror    = false
    !support.rotateCur = false
    !support.handedCur = false
    !support.offset    = 'MID'
    !support.rotated   = 0
    !support.bPNum     = 1
    !support.alias     = !alias

    !!mdsft40.hand.active = false

    if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
      !!mdsft40.cancel.callback = |Call !!mdsCancelSupp(!!mdsft40)|
      !support.modify = false

    -- Initialise variables for new supports
      !support.replace = !!mdsframe.replacement
      !support.type    = !!mdsframe.standard.selection('Rtext')
      !struName        = !!mdsframe.name.val

    -- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!mdsDacControl(true)
      --<sk> 04/06/2012
      -- check if support with given name exists already (can be preliminary support)
      !datum = object DBREF(!name)
      handle NONE
        !fromAtta = true
        !support.preliminaryStore = !!mdsSavePreInf(!datum)
        !datum.name = !name & '_Pre'

      elsehandle ANY
      endhandle
      --<sk> 04/06/2012

    -- Create Stru
      NEW STRU /$!struName
      !support.stru = !!ce
      :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
      !!mdsft40.name.val = !struName

      !!mdsft40.dim1.val = 0
      !!mdsft40.dim2.val = 0
      !!mdsft40.dim3.val = 0
      !!mdsft40.dim4.val = 0
      !!mdsft40.dist.val = 0
      !!mdsft40.p.val = ''

    -- Datum creation gadget ACTIVE for creation mode

      !!mdsft40.datum.active = true

      !!mdsframe.hide()
------------------------------**** Connexions *****---------------------------
-- in create mode have all three
      !!mdsft40.createByDim.active = true
      !!mdsft40.createByCle.active = true
      !!mdsft40.createByCur.active = true
-----------------------------------------------------------------------------

    else  $* its modify mode
-- Initialise form in MODIFY mode

     -- Datum creation gadget INACTIVE for modify mode

      !!mdsft40.datum.active = false

    -- Set callback on cancel button
      !!mdsft40.cancel.callback = |Call !!mdsRestoreForm(!!mdsft40)|
      !support.modify = true
      !!mdsft40.datum.active = false

    -- Initialise variables for existing supports
      !datumname = !name & '/DATUM'
      !sref      = !name & '/SREF'

    -- Store Data in support object
      !support.type     = 'FT40'
      !support.position = true
      !support.datum    = !datumname.dbref()
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsmodifysupp.cancel.active = true
          !!kRestoreUnits(!currentunits)
          return
        endhandle
      !support.stru = !name.dbref()

--> Modified - <wd> - 15sep1998
      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!mdsmodifysupp.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      endif
--< Modified - <wd> - 15sep1998


      -- Store Atta reference's in object
      !support.atta.append(!datumname.dbref())
      !support.atta.append(!sref.dbref())

      -- Navigate to existing support datum
      !!ce = !support.datum
      !support.pADir  = Pa Dir wrt world
      !support.pLDir  = Pl Dir wrt world
      !support.p9Dir  = P9 Dir wrt world
      !support.p10Dir = P10 Dir wrt world
      !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type ft40 from :MDSCp1 on datum atta
      !data = !!ce.:MDSCp1
      !split = split(!data, ';')
      if (!split[1] eq |T|)then
        !support.rotateCur = TRUE
      else
        !support.rotateCur = FALSE
      endif
      if (!split[2] eq |T|)then
        !support.handedCur = TRUE
      else
        !support.handedCur = FALSE
      endif
      !support.rotated = !split[3].real()
      if (!split[4] eq |T|)then
        !support.mirror = TRUE
      else
        !support.mirror = FALSE
      endif
      !support.offset = !split[5]

--> Modified - <wd> - 11sep1998
      if (!support.offset.eq('MID')) then
        !!mdsft40.slide.val = 1
      elseif (!support.offset.eq('FRONT')) then
        !!mdsft40.slide.val = 2
      else
        !!mdsft40.slide.val = 3
      endif
--< Modified - <wd> - 11sep1998

      -- Apply Data for existing cross bar
      !!ce  = !support.stru
      !bar = !name & '-BAR-1'

      !references = !support.atta
      !index = !references.findfirst(!sref.dbref())
      !references.remove(!index)

      -- Store Data in support object
--      !support.bars[1] = !references

--------------------------------------------------------------------------

-- Set Cross Bar Atta References to Support Object Member '.bars[1]'
       !!ce = !bar.dbref()
      var !ref :MDSAttaRef

       !arefs = split(!ref)
       !references = ARRAY()

       do !index indices !arefs
         !references.append(!arefs[!index].dbref())
         handle(2,107) (2,813)
-- Atta has been manually deleted
         endhandle
       enddo

       !support.bars[1] = !references

--------------------------------------------------------------------------

      -- Get length of existing crossbar
      !length = deri length of $!bar
      !support.barlen.append(!length)

      -- Get bedplate references if set
      !!ce  = !support.stru
      var !bPRef1 :MDSBpref1
      var !bPRef2 :MDSBpref2
      if (!!ce.:MDSBpref1.badref().not()) then
        !support.bedPlate1 = !bPRef1.dbref()
      endif
      if (!!ce.:MDSBpref2.badref().not()) then
        !support.bedPlate2 = !bPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!mdsft40.name.val = !name
      !!mdsft40.dim1.val = 0
      !!mdsft40.dim2.val = 0
      !!mdsft40.dim3.val = 0
      !!mdsft40.dim4.val = 0
      !!mdsft40.p.val    = ''

      -- Store section name and matref for each member

      !storeMat = ARRAY()
      !storeMat = !!mdsStoreMat(!name)
      !support.material = !storeMat


      !!mdsAddAll('$!textName')

------------------------------ ***** Connexions --------------------
      -- if(!support.connections.size().eq(1)) then
         -- !!mdsft40.lineup.active = True
      -- endif

    -- set support object connections
      !vertdbref = ARRAY()
      !vert1 = !name & '-V1'
      !vertdbref[1] = !vert1.dbref()
      !conn1 = !vertdbref[1].:MDSConn
      !support.connections[1] = !conn1

      -- set the connection object for using :mdsancref
      !support.plateconns = object MDSBPLATECONN(!support)


    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertdbref)

-------------------------------------------------------------------
-- hide dimension form the list if connected
       if(!support.joints.unset().not()) then
         !!mdsft40.createByDim.active = false
         !!mdsft40.createByCle.active = true
         !!mdsft40.createByCur.active = true
       else
         !!mdsft40.createByDim.active = true
         !!mdsft40.createByCle.active = true
         !!mdsft40.createByCur.active = true
       endif

-------------------------------------------------------------------

    endif

  -- Store support object in form
    !!mdsft40.support = !support

-------------------------------------------------------------------
--<wd>aug2007<mds12>
-- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
    !!mdssupportsctns(!!mdsft40)
    !!mdsft40.support.mdssctnsstore = !!mdsft40.support.mdssctns
--<wd>aug2007<mds12>
-------------------------------------------------------------------

  -- Store Current representations in form for use later
    var !repre repre level
    !!mdsft40.repre.clear()
    !!mdsft40.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsft40.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsft40.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsft40.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type ft40
    !!ce = /MDS/FRAMES/FT40
      handle (2,109)
        !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!modify.upcase() neq |MODIFY|) then
          delete stru
        endif
        !!kRestoreUnits(!currentunits)
        return
      endhandle

  -- Generate Steel Size List

    --!dtext = ARRAY()
    --!rtext = ARRAY()
    -- !!MdsSetSize('CREATE',!!mdsft40,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft40,'-BAR-1','-V1')
    !!ce = !support.stru

    if (!modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!mdsft40,'-BAR-1','-V1')
      !!mdsSetSteel.init('HIDE',!!mdsft40,'-BAR-1','-V1')

      !!ce = !!mdsft40.support.datum

    -- Set distance gadget

      !!mdsDistance(!!mdsft40)

    -- Add marker text markers

      VAR !pos POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 211 TO 259

        VAR !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
          handle ANY
            skip
          endhandle

      -- Store Atta reference in form
        !!mdsft40.support.atta.append(!!ce)

        VAR !pos POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>

      enddo

---------------------------------------------------------------------------------------

-- Store Packing Pieces in the Support Object
-- Derived from the 'Attas' :MDSPackRef references in the support.atta array
      !!mdspackattas(!!mdsft40.support)

---------------------------------------------------------------------------------------

  -- Fill in dimensions from SREF atta (Stored in mm)

      !!ce = !sref.dbref()
      !despars = despar

      !!mdsft40.dim1.val = !despars[1]
        handle any
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!mdsft40.dim2.val = !despars[2]
        handle any
          !!mdsft40.dim1.val = 0
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!mdsft40.dim3.val = !despars[3]
        handle any
          !!mdsft40.dim1.val = 0
          !!mdsft40.dim2.val = 0
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!mdsft40.dim4.val = !despars[4]
        handle any
          !!mdsft40.dim1.val = 0
          !!mdsft40.dim2.val = 0
          !!mdsft40.dim3.val = 0
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        endhandle

    endif


  label /CONT

  -- Redefine standard support name on form title

    !index = !!mdsframe.standard.rtext.findfirst('FT40')
    !text  = !!mdsframe.standard.dtext[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsframe,'FRAME')
        !index = !!mdsframe.standard.rtext.findfirst('FT40')
        !text  = !!mdsframe.standard.dtext[!index]
      endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
    !!mdsft40.support.replace = !formName

    call !!mdsSetFormName(!!mdsft40, 'PIPE', '$!formName')

    !!ce = !!mdsft40.support.stru

  -- Set Support Code
    if !modify.upcase() neq 'MODIFY' then
      !!mdsSetSuppCode('CREATE',!name,!alias,'FT40-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'FT40-1')
    endif

------------------------ connexions ----------------------------
--

----------------------------------------------------------------

  -- Store current form information
    call !!mdsStoreft40()

  -- Set dimensions toggle

    !!mdsft40.graphicalDim = false

  -- Show Form for frame type ft40
    !!kShowForm(!!mdsft40)

    !!kRestoreUnits(!currentunits)

    --<sk> 04/06/2012
    if !fromAtta then
      -- call creation of support datum from given preliminary support
      !!mdsCrDatumFromPs(!form, !datum)
    endif
-- End function
endfunction
