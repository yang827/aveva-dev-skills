--------------------------------------------------------------------------------
--
-- File:  Mdsift41.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS147
--
-- Author:  I.osborne
-- Created:  Mon Aug 04
--
--
-- Description:
-- Initialisation for form ft41
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFt41(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsft41.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentUnits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsft41

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  -- !!mdsft41.create.select('Rtext', 'CURSOR')
  -- !!mdsft41.select.select('RTEXT', 'IDCUR')
  -- !!mdsft41.nudge.val = 0
  !!mdsft41.datum.active = true
  !!mdsft41.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft41.cancel.callback = |Call !!mdsCancelSupp(!!mdsft41)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsDacControl(true)
    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MdsSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft41.name.val = !struName

    !!mdsft41.dim1.val = 0
    !!mdsft41.dist.val = 0
    !!mdsft41.p.val = ''

    !!mdsFrame.hide()

    ------------------------------ ***** Connexions --------------------
    --$(
    -- in create mode
    !!mdsft41.createByCur.active = true
    !!mdsft41.createByDim.active = true
    --$)

  else

    -- Set callback on cancel button
    !!mdsft41.cancel.callback = |Call !!mdsRestoreForm(!!mdsft41)|
    !support.modify = true
    !!mdsft41.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !post      = !name & '-V1'

    -- Get length of existing crossbars
    !length = deri length of $!post
    !support.barlen.append(!length)

    -- Store Data in support object
    !support.type     = 'FT41'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:mdscp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentUnits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 41 from :mdscp1 on datum atta
    !data = !!ce.:mdsCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :mdsBPREF1
    var !bPRef2 :mdsBPREF2
    if (!!ce.:mdsBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:mdsBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft41.name.val = !name
    !!mdsft41.dim1.val = 0
    !!mdsft41.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    --$(
    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !support.connections[1] = !conn1

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertDbref)
    --$)
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft41.createByCur.active = true
      !!mdsft41.createByDim.active = false
      --!havejoints = true
    else
      !!mdsft41.createByCur.active = true
      !!mdsft41.createByDim.active = true
    endif
    -------------------------------------------------------------------


  endif

  -- Store support object in form
  !!mdsft41.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft41.repre.clear()
  !!mdsft41.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft41.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft41.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft41.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 41
  !!ce = /MDS/FRAMES/FT41
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  -- Generate Steel Size List

  --!dtext = ARRAY()
  !rtext = ARRAY()
  -- !!mdsSetSize('CREATE',!!mdsft41,'-V1','-V1')
  !!mdsSetSteel.init('HIDE',!!mdsft41,'-V1','-V1')

  -- Find current units and set the distance unit to metric

  --    !currentUnits = !!kgetsetunits()

  -- Cap sizes
  !subs  = !!kCollectAllFor('SUBS', '((match(name, |SUBS1|) gt 0))', !!ce)
  !display = ARRAY()
  do !v values !subs
    !!ce = !v
    !!ce = first mem
    !xlen = !!ce.xlen
    -- get format
    !!kFormatText.text.val = !xlen
    !xFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !xFormat = !xFormat.replace('.00','')
    !ylen = !!ce.ylen
    -- get format
    !!kFormatText.text.val = !ylen
    !yFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !yFormat = !yFormat.replace('.00','')
    !zlen = !!ce.zlen
    -- get format
    !!kFormatText.text.val = !zlen
    !zFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !zFormat = !zFormat.replace('.00','')

    --   !display.append(!xlen & 'x' & !ylen & 'x' & !zlen)
    !display.append(!xFormat & 'x' & !yFormat & 'x' &  !zFormat)
  enddo
  !rtext.clear()
  do !i from 1 to !display.size()
    !rtext.append(!i.string())
  enddo

  !!mdsft41.cap.dtext = !display
  !!mdsft41.cap.rtext = !rtext

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsft41,'-V1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsft41,'-V1','-V1')

    --<g.e.8/6/04 fix for Framatome i.e. no cap's
    !flag = TRUE

    !!ce = $!<name>/SUBS1
    handle (2,109)
      !flag = FALSE
      !!mdsft41.cap.active = FALSE
    endhandle

    if !flag then
      !!ce = first mem
      !xlen = !!ce.xlen
      !unitQualifier = !!ce.xlen.units().unitQualifier()
      -- get format
      !!kFormatText.text.val = !xlen
      !xFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !ylen = !!ce.ylen
      -- get format
      !!kFormatText.text.val = !ylen
      !yFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !zlen = !!ce.zlen
      -- get format
      !!kFormatText.text.val = !zlen
      !zFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

      --<wd>dec2004

      !xFormat = !xFormat.before('.00') + !unitQualifier
      !yFormat = !yFormat.before('.00') + !unitQualifier
      !zFormat = !zFormat.before('.00') + !unitQualifier
      !platesize = !xFormat & 'x' & !yFormat & 'x' & !zFormat

      --$P !platesize = $!platesize
      --$P============================================================
      --!!mdsft41.cap.select('RTEXT', !!mdsft41.cap.dtext.findfirst(!xFormat & 'x' & !yFormat & 'x' & !zFormat).string())
      !!mdsft41.cap.select('RTEXT', !!mdsft41.cap.dtext.findfirst(!platesize).string())
      --<wd>dec2004

    endif

    !!ce = !!mdsft41.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsft41)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !count from 211 to 259

      VAR !num ($!count - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsft41.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pOS$>

    enddo

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft41.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('FT41')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('FT41')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft41.support.replace = !formName

  call !!mdsSetFormName(!!mdsft41, 'PIPE', '$!formName')

  !!ce = !!mdsft41.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'FT41-1-A')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'FT41-1-A')
  endif


  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft41.connect.active = False
    !!mdsft41.modify.active = False
    !!mdsft41.disconn.active = False
    !!mdsft41.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft41.support.stru.unset()) then
    !!mdsft41.connect.active = False
    !!mdsft41.modify.active = False
    !!mdsft41.forceCon.active = False
    !!mdsft41.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft41.connect.active = True
    !!mdsft41.forceCon.active = False
    !!mdsft41.modify.active = False
    !!mdsft41.disconn.active = True
  else
    !!mdsft41.connect.active  = True
    !!mdsft41.modify.active   = True
    !!mdsft41.forceCon.active = True
    !!mdsft41.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------


  -- Set dimensions toggle
  !!mdsft41.graphicalDim = false

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsft41)
  --<dw>sep2007
  !!mdsft41.rotatt.active = TRUE
  -- Store current form information
  call !!mdsStoreFt41()

  -- Show Form for frame type FT41
  !!kShowForm(!!mdsft41)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

    --<sk> 04/06/2012
    if !fromAtta then
      -- call creation of support datum from given preliminary support
      !!mdsCrDatumFromPs(!form, !datum)
    endif
  -- End function
endfunction
