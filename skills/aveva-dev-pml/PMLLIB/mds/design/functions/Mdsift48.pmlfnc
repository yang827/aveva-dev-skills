--------------------------------------------------------------------------------
--
-- File:  Mdsift48.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS147
--
-- Author:  D.flannery
-- Created:  mar 1 04
--
--
-- Description:
-- Initialisation for form ft48
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFT48(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT48.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT48

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT48.select.select('RTEXT', 'IDCUR')
  !!mdsFT48.datum.active = true
  !!mdsFT48.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsFT48.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT48)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)
    --q var !!mdsaccess

    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|
    --:MDSComment |$!!mds
    -- Set Paragraph gadget on form
    !!mdsFT48.name.val = !struName

    !!mdsFT48.dim1.val = 0
    !!mdsFT48.dist.val = 0
    !!mdsFT48.p.val = ''
    !!mdsFrame.hide()

    ------------------------------ ***** Connexions --------------------
    --$(
    -- in create mode
    !!mdsFT48.createByCur.active = true
    !!mdsFT48.createByDim.active = true
    --$)
  else  $* its modify mode

    -- Set callback on cancel button
    !!mdsFT48.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT48)|
    !support.modify = true
    !!mdsFT48.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !post      = !name & '-V1'

    -- Get length of existing Post
    !length = deri length of $!post
    !support.barlen.append(!length)

    -- Store Data in support object
    !support.type     = 'FT48'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 23 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT48.name.val = !name
    !!mdsFT48.dim1.val = 0
    !!mdsFT48.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    --$(
    -- set support object connections
    !vertdbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertdbref[1] = !vert1.dbref()
    !conn1 = !vertdbref[1].:MDSConn
    !support.connections[1] = !conn1

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertdbref)
    --$)
    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT48.createByCur.active = true
      !!mdsFT48.createByDim.active = false
    else
      !!mdsFT48.createByCur.active = true
      !!mdsFT48.createByDim.active = true
    endif
    -------------------------------------------------------------------


  endif

  -- Store support object in form
  !!mdsFT48.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT48.repre.clear()
  !!mdsFT48.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT48.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT48.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT48.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 48
  --  !!ce = /MDS/FRAMES/FT48
  -- Mod to allow FT48 to be created dtf 01.03.04
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsFT48,'-V1','')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT48.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT48.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT48.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT48.bthro.active = TRUE
  handle ANY
  endhandle

  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle

  if !desc.eq('Zimmer Templates') then
    !subs1  = !!kCollectAllFor('SUBS', '((match(name, |SUBS1|) gt 0))', !!ce)
    !subs2  = !!kCollectAllFor('SUBS', '((match(name, |SUBS2|) gt 0))', !!ce)
    !frmw1  = !!kCollectAllFor('FRMW', '((match(name, |FRMW1|) gt 0))', !!ce)
    !display = ARRAY()
    do !i index !subs1

      !!ce = $!subs1[$!i]
      !!ce = first mem
      !subs1Xlen = !!ce.xlen
      -- get format
      !!kFormatText.text.val = !subs1Xlen
      !subs1Xformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !subs1Xformat = !subs1Xformat.replace('.00','')
      !subs1Zlen = !!ce.zlen
      -- get format
      !!kFormatText.text.val = !subs1Zlen
      !subs1Zformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !subs1Zformat = !subs1Zformat.replace('.00','')

      !!ce = $!subs2[$!i]
      !!ce = first mem
      !subs2Xlen = !!ce.xlen
      -- get format
      !!kFormatText.text.val = !subs2Xlen
      !subs2Xformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !subs2Xformat = !subs2Xformat.replace('.00','')
      !subs2Zlen = !!ce.zlen
      -- get format
      !!kFormatText.text.val = !subs2Zlen
      !subs2Zformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
      !subs2Zformat = !subs2Zformat.replace('.00','')

      !!ce = $!frmw1[$!i]
      !!ce = first mem
      !sctnSize = !!ce.spref.name.split('/')[3]

      -- !display.append(!subs1Xformat & 'x' & !subs1YFormat & 'x' &  !subs1Zformat  & ' - ' & !subs2Xformat & 'x' & !subs2YFormat & 'x' &  !subs2Zformat )
      !display.append(!subs1Xformat & 'x' &  !subs1Zformat  & ' - ' & !sctnSize & ' - ' & !subs2Xformat  & 'x' &  !subs2Zformat )
      -- !display.append(!subs1Xformat & 'x' &  !subs1Zformat  & ' - ' & !subs2Xformat  & 'x' &  !subs2Zformat )
    enddo
    !rtext.clear()
    do !i from 1 to !display.size()
      !rtext.append(!i.string())
    enddo

    !!mdsFT48.cap.dtext = !display
    !!mdsFT48.cap.rtext = !rtext

    -- deal with the initec industrial templates, cap plate size is dependant upon supported pipe bore (RM 06/12/05)
  elseif !desc.eq('Initec Industrial Templates') then
    /MDS/$!alias/1-SUBS1
    BOX1
    !xlen = !!ce.xlen
    !zlen = !!ce.zlen
    !!mdsFT48.dim2.val = (!xlen)
    !!mdsFT48.dim3.val = (!zlen)
  else
    -- Navigate to template & find sizes (note: initial cap plate sizes are controlled by the section height + 50)
    /MDS/$!alias/1-FRMW1
    SCTN1
    !xlen = !!ce.cATREF.pARA[1]
    /MDS/$!alias/1-SUBS1
    BOX1
    !zlen = !!ce.zlen
    !!mdsFT48.dim2.val = (!xlen + 50 )
    !!mdsFT48.dim3.val = (!zlen)
  endif

  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT48,'-V1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT48,'-V1','')
    !!ce = !!mdsFT48.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT48)

    -- Add marker text markers

    VAR !pOS POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsFT48.support.atta.append(!!ce)

      VAR !pOS POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsFT48.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    if !desc.neq('Zimmer Templates') then
      !!mdsFT48.dim2.val = !despars[2]
      handle any
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        golabel /CONT
      endhandle
      !!mdsFT48.dim3.val = !despars[3]
      handle any
        !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
        golabel /CONT
      endhandle
    endif
  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT48.support.replace = !formName

  call !!mdsSetFormName(!!mdsFT48, 'PIPE', '$!formName')

  !!ce = !!mdsFT48.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1')
  endif

  ------------------------ connexions ----------------------------
  --$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT48.connect.active = False
    !!mdsFT48.modify.active = False
    !!mdsFT48.disconn.active = False
    !!mdsFT48.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT48.support.stru.unset()) then
    !!mdsFT48.connect.active = False
    !!mdsFT48.modify.active = False
    !!mdsFT48.forceCon.active = False
    !!mdsFT48.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT48.connect.active = True
    !!mdsFT48.forceCon.active = False
    !!mdsFT48.modify.active = False
    !!mdsFT48.disconn.active = True
  else
    !!mdsFT48.connect.active  = True
    !!mdsFT48.modify.active   = True
    !!mdsFT48.forceCon.active = True
    !!mdsFT48.disconn.active  = True
  endif
  --$)
  ----------------------------------------------------------------
  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle
  if !desc.eq('Zimmer Templates') and !!mdsFT48.support.alias.eq('FT48C')  then
    !!mdsFT48.cap.active = false
  endif


  -- Store current form information
  call !!mdsStoreFT48()

  -- Set dimensions toggle

  !!mdsFT48.graphicalDim = false

  -- Show Form for frame type FT48
  !!kShowForm(!!mdsFT48)

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
