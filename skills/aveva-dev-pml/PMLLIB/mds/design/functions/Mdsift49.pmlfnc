--------------------------------------------------------------------------------
--
-- File:  Mdsift49.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Initialisation for form FT49
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFT49(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsFT49.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Turn all form gadget active
  !!kResetActive(!!mdsFT49 , TRUE)

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsFT49

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsFT49.select.select('RTEXT', 'IDCUR')
  !!mdsFT49.datum.active = true
  !!mdsFT49.cancel.active = true

  -- FT49 has an alias from the cable rack frameworks called CT05 and
  -- from the HVAC frameworks called DT01

  !!mdsFT49.addPipe.active = FALSE
  !!mdsFT49.addHVAC.active = FALSE
  !!mdsFT49.addRack.active = FALSE
  !!mdsFT49.addBar.active  = FALSE
  !!mdsFT49.rotate.active  = FALSE
  !!mdsFT49.modAtta.active = FALSE
  !!mdsFT49.addPack.active = FALSE
  !!mdsFT49.delPack.active = FALSE
  !!mdsFT49.rotAtt.active  = FALSE
  !!mdsFT49.flipAtta.active = TRUE
  !!mdsFT49.connect.active  = TRUE
  !!mdsFT49.modify.active   = TRUE
  !!mdsFT49.forceCon.active = TRUE
  !!mdsFT49.disconn.active  = TRUE
  !!mdsFT49.deleteAtta.active = FALSE
  !!mdsFT49.copyLike.active = FALSE
  !!mdsFT49.createByCle.active = FALSE
  !!mdsFT49.newdat.active    = FALSE
  !!mdsFT49.alignSup.active  = FALSE
  !!mdsFT49.anccopy.active  = FALSE
  !!mdsFT49.ancnudge.active  = FALSE
  !!mdsFT49.flipAtta.active = FALSE
  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then
    -- CREATE Mode
    -- Set callback on cancel button
    !!mdsFT49.cancel.callback = |Call !!mdsCancelSupp(!!mdsFT49)|
    !support.modify = false

    -- Initialise variables for new supports

    !support.replace = !!mdsFrame.replacement
    !support.type    = !!mdsFrame.standard.selection('Rtext')
    !struName        = !!mdsFrame.name.val


    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endif

    !!mdsDacControl(true)
    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struName

    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsFT49.name.val = !struName

    !!mdsFT49.dim1.val = 0
    !!mdsFT49.dim2.val = 0
    !!mdsFT49.dist.val = 0
    !!mdsFT49.p.val = ''

    !!mdsFrame.hide()

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsFT49.createByDim.active = TRUE
    !!mdsFT49.createByCur.active = true
    ------------------------------------------------------------------------------

  else   $* its modify mode

    -- Set callback on cancel button
    !!mdsFT49.cancel.callback = |Call !!mdsRestoreForm(!!mdsFT49)|
    !support.modify = true
    !!mdsFT49.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endhandle
    !support.stru = !name.dbref()

    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endif

    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 09 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsFT49.name.val = !name
    !!mdsFT49.dim1.val = 0
    !!mdsFT49.dim2.val = 0
    !!mdsFT49.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsFT49.lineUp.active = True
    -- endif

    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !vert2 = !name & '-V2'
    !vertDbref[2] = !vert2.dbref()
    !conn2 = !vertDbref[2].:MDSConn
    !support.connections[1] = !conn1
    !support.connections[2] = !conn2

    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertDbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsFT49.createByDim.active = false
      --!!mdsFT49.createByCur.active = FALSE
    else
      !!mdsFT49.createByDim.active = true
      !!mdsFT49.createByCur.active = true
    endif

    -- End of MODIFY Mode
    -------------------------------------------------------------------
  endif


  -- Store support object in form
  !!mdsFT49.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsFT49.repre.clear()
  !!mdsFT49.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsFT49.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsFT49.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsFT49.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)


  -- Collect all supports for frame type 9
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    --------------------------------------------
    !!kRestoreUnits(!currentunits)
    --------------------------------------------
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsFT49,'-BAR-1','-V1')

  !!ce = !support.stru

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsFT49.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT49.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsFT49.select.active = TRUE
  handle ANY
  endhandle
  !!mdsFT49.bthro.active = TRUE
  handle ANY
  endhandle

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsFT49,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsFT49,'-BAR-1','-V1')

    !!ce = !!mdsFT49.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsFT49)

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!!mdsFT49)

    -- Store Atta reference in form
    do !cOUNT from 211 TO 259
      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle
      !!mdsFT49.support.atta.append(!!ce)
    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array

    !!mdspackattas(!!mdsFT49.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()

    !despars = Despar
    !!mdsFT49.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsFT49.dim2.val = !despars[2]
    handle any
      !!mdsFT49.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title


  !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
  !text  = !!mdsFrame.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsFrame,'FRAME')
    !index = !!mdsFrame.standard.rtext.findfirst('$!alias')
    !text  = !!mdsFrame.standard.dtext[!index]
  endhandle

  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsFT49.support.replace = !formName


  call !!mdsSetFormName(!!mdsFT49, 'PIPE', '$!formName')


  !!ce = !!mdsFT49.support.stru

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsFT49.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsFT49.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1-1')
  else
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  endif

$(
  ------------------------ connexions ----------------------------
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsFT49.connect.active = False
    !!mdsFT49.modify.active = False
    !!mdsFT49.disconn.active = False
    !!mdsFT49.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsFT49.support.stru.unset()) then
    !!mdsFT49.connect.active = False
    !!mdsFT49.modify.active = False
    !!mdsFT49.forceCon.active = False
    !!mdsFT49.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsFT49.connect.active = True
    !!mdsFT49.forceCon.active = False
    !!mdsFT49.modify.active = False
    !!mdsFT49.disconn.active = True
  else
    !!mdsFT49.connect.active  = True
    !!mdsFT49.modify.active   = True
    !!mdsFT49.forceCon.active = True
    !!mdsFT49.disconn.active  = True
  endif

$)
  ----------------------------------------------------------------

  -- Set dimensions toggle
  !!mdsFT49.graphicalDim = false

  -- Store current form information
  call !!mdsStoreFT49()

  -- Show Form for frame type FT49
  !!kShowForm(!!mdsFT49)

  --------------------------------------------
  !!kRestoreUnits(!currentunits)
  --------------------------------------------
  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
