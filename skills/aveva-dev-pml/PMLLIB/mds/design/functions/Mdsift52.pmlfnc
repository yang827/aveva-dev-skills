--------------------------------------------------------------------------------
--
-- File: Mdsift52.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces: IPS132
--
-- Author: I.Osborne
-- Created: Wed Jul 02
--
--
-- Description:
-- Initialisation for form FT52
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIFT52(!modify is STRING, !textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!mdsft52.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  -- Turn all form gadget active
  !!kResetActive(!!mdsft52 , TRUE)

  -- Initialise Variables
    !name = '/' & !textName
    !form = !!mdsft52

    -- <sk> 04/06/2012
    !fromAtta = false

  -- Initialise Standard gadgets
    !!mdsft52.select.select('RTEXT', 'IDCUR')
    !!mdsft52.datum.active = TRUE
    !!mdsft52.cancel.active = TRUE

-- Icons Row 1
    !!mdsft52.addPipe.active = FALSE
    !!mdsft52.addHVAC.active = FALSE
    !!mdsft52.addRack.active = FALSE
    !!mdsft52.addBar.active = FALSE
    !!mdsft52.flip.active = TRUE
    !!mdsft52.hand.active = FALSE
    !!mdsft52.alignSup.active = TRUE
    !!mdsft52.modSctn.active = TRUE
-- Icons Row 2
    !!mdsft52.addPack.active = FALSE
    !!mdsft52.delPack.active = FALSE
    !!mdsft52.rotate.active = FALSE
    !!mdsft52.rotAtt.active = TRUE
    !!mdsft52.newdat.active = FALSE
    !!mdsft52.bedplate.active = TRUE
    !!mdsft52.associate.active = FALSE
    !!mdsft52.viewAssociate.active = FALSE
-- Icons Row 3
    !!mdsft52.flipFw.active = FALSE
    !!mdsft52.modAtta.active = TRUE
    !!mdsft52.deleteAtta.active = FALSE
    !!mdsft52.nudge.active = TRUE
    !!mdsft52.spool.active = FALSE
    !!mdsft52.setMat.active = TRUE
    !!mdsft52.copylike.active = TRUE
    !!mdsft52.viewStd.active = TRUE
-- Icons Row 4
    !!mdsft52.connect.active = TRUE
    !!mdsft52.modify.active = TRUE
    !!mdsft52.forcecon.active = TRUE
    !!mdsft52.disconn.active = TRUE
    !!mdsft52.dim.active = TRUE
    !!mdsft52.zoom.active = TRUE
    !!mdsft52.mdsadp.active = TRUE
    !!mdsft52.adploc.active = TRUE
-- Icons Row 5
    !!mdsft52.trimmer.active = TRUE
    !!mdsft52.ancmat.active = TRUE
    !!mdsft52.anccopy.active = FALSE
    !!mdsft52.ancnudge.active = FALSE
    !!mdsft52.setlen.active = FALSE
    !!mdsft52.trunmat.active = FALSE
    !!mdsft52.ancnote.active = TRUE
    !!mdsft52.reconnect.active = TRUE
-- Icons Row 6
    !!mdsft52.flipatta.active = FALSE
    !!mdsft52.suppdata.active = TRUE
    !!mdsft52.viewFlip.active = TRUE
    !!mdsft52.convSpec.active = TRUE
    !!mdsft52.mtoc.active = TRUE
    !!mdsft52.addweld.active = TRUE
    !!mdsft52.repeat.active = FALSE
    !!mdsft52.cutsect.active = TRUE

 -- populate list gadget
--    !typelist = ARRAY()
--    !typelist[1] = 'Bed Plate'
--    !typelist[2] = 'Beam Web'
--    !typelist[3] = 'Beam Bottom flange'
--    !typelist[4] = 'Beam Top flange'
--    !!mdsft52.SetType.dtext = !typelist

  -- Create Support object
    !support = object MDSSUPPORT()
    !support.position  = false
    !support.mirror    = false
    !support.rotateCur = false
    !support.handedCur = false
    !support.rotated   = 0
    !support.bPNum     = 2
    !support.alias     = !alias

    if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
      !!mdsft52.cancel.callback = |Call !!mdsCancelSupp(!!mdsft52)|
      !support.modify = false

    -- Initialise variables for new supports
      if (!alias eq 'FT52' OR !alias eq 'FT53') then
        !support.replace = !!mdsframe.replacement
        !support.type    = !!mdsframe.standard.selection('Rtext')
        !struName        = !!mdsframe.name.val
      endif

    -- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
        return
      endif

      !!mdsDacControl(true)

      --<sk> 04/06/2012
      -- check if support with given name exists already (can be preliminary support)
      !datum = object DBREF(!name)
      handle NONE
        !fromAtta = true
        !support.preliminaryStore = !!mdsSavePreInf(!datum)
        !datum.name = !name & '_Pre'

      elsehandle ANY
      endhandle
      --<sk> 04/06/2012
      -- Create Stru
      NEW STRU /$!struName

      !support.stru = !!ce
      :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
      !!mdsft52.name.val = !struName
      !!mdsft52.dim1.val = 0
      !!mdsft52.dim2.val = 0
      !!mdsft52.dim3.val = 0
      !!mdsft52.dist.val = 0
      !!mdsft52.p.val = ''

      if (!alias eq 'FT52' OR !alias eq 'FT53') then
        !!mdsframe.hide()
      endif
------------------------------**** Connexions *****---------------------------
-- in create mode have all three
      !!mdsft52.createByDim.active = TRUE
      !!mdsft52.createByCle.active = FALSE
      !!mdsft52.createByCur.active = TRUE
------------------------------------------------------------------------------

    else   $* its modify mode

    -- Set callback on cancel button
      !!mdsft52.cancel.callback = |Call !!mdsRestoreForm(!!mdsft52)|
      !support.modify = true
      !!mdsft52.datum.active = false

    -- Initialise variables for existing supports
      !datumname = !name & '/DATUM'
      !sref      = !name & '/SREF'

    -- Store Data in support object
      !support.type     = '$!alias'
      !support.position = true
      !support.datum    = !datumname.dbref()
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsmodifysupp.cancel.active = true
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
          return
        endhandle
      !support.stru = !name.dbref()

--> Modified - <wd> - 15sep1998
      if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
        !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
        unenhance all
        !!mdsmodifysupp.cancel.active = true
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
        return
      endif
--< Modified - <wd> - 15sep1998


      -- Store Atta reference's in object
      !support.atta.append(!datumname.dbref())
      !support.atta.append(!sref.dbref())

      -- Navigate to existing support datum
      !!ce = !support.datum
      !support.pADir  = Pa Dir wrt world
      !support.pLDir  = Pl Dir wrt world
      !support.p9Dir  = P9 Dir wrt world
      !support.p10Dir = P10 Dir wrt world
      !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 09 from :MDSCp1 on datum atta
      !data = !!ce.:MDSCp1
      !split = split(!data, ';')
      if (!split[1] eq |T|)then
        !support.rotateCur = TRUE
      else
        !support.rotateCur = FALSE
      endif
      if (!split[2] eq |T|)then
        !support.handedCur = TRUE
      else
        !support.handedCur = FALSE
      endif
      !support.rotated = !split[3].real()
      if (!split[4] eq |T|)then
        !support.mirror = TRUE
      else
        !support.mirror = FALSE
      endif

      -- Get number of existing crossbars
      !!ce  = !support.stru
      !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

      if (!bars.size().gt(0))then
        do !i indices !bars
          !!ce = !bars[!i]
          var !ref :MDSAttaRef
          !split = split(!ref)

          !references = ARRAY()
          do !index indices !split
            !references.append(!split[!index].dbref())
            handle(2,107) (2,813)
              -- Atta has been manually deleted
            endhandle
          enddo

        -- Store Data in support object
          !support.bars[!i] = !references
        enddo

      endif

      -- Get length of existing crossbars
      do !v values !bars
        !length = deri length of $!v
        !support.barlen.append(!length)
      enddo

      -- Store section name and matref for each member

      !storeMat = ARRAY()
      !storeMat = !!mdsStoreMat(!name)
      !support.material = !storeMat

      -- Get bedplate references if set
      !!ce  = !support.stru
      var !bPRef1 :MDSBpref1
      var !bPRef2 :MDSBpref2
      if (!!ce.:MDSBpref1.badref().not()) then
        !support.bedplate1 = !bPRef1.dbref()
      endif
      if (!!ce.:MDSBpref2.badref().not()) then
        !support.bedplate2 = !bPRef2.dbref()
      endif

      -- Set Form Gadgets
      !!mdsft52.name.val = !name
      !!mdsft52.dim1.val = 0
      !!mdsft52.dim2.val = 0
      !!mdsft52.dim3.val = 0
      !!mdsft52.p.val    = ''

      !!mdsAddAll('$!textName')

------------------------------ ***** Connexions --------------------
      -- if(!support.connections.size().eq(1)) then
         -- !!mdsft52.lineup.active = True
      -- endif

    -- set support object connections
      !vertdbref = ARRAY()
      !vert1 = !name & '-V1'
      !vertdbref[1] = !vert1.dbref()
      !conn1 = !vertdbref[1].:MDSConn
      !vert2 = !name & '-V2'
      !vertdbref[2] = !vert2.dbref()
      !conn2 = !vertdbref[2].:MDSConn
      !support.connections[1] = !conn1
      !support.connections[2] = !conn2

      -- set the connection object for using :mdsancref
      !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertdbref)

-- hide dimension form the list if connected
       if(!support.joints.unset().not()) then
         !!mdsft52.createByDim.active = TRUE
         !!mdsft52.createByCle.active = FALSE
         !!mdsft52.createByCur.active = TRUE
       else
         !!mdsft52.createByDim.active = TRUE
         !!mdsft52.createByCle.active = FALSE
         !!mdsft52.createByCur.active = TRUE
       endif

-------------------------------------------------------------------
    endif

  -- Store support object in form
    !!mdsft52.support = !support

-------------------------------------------------------------------
--<wd>aug2007<mds12>
-- Store ALL MDS Support SCTNS and ALL MDS SNIPE(FITTING) members
    !!mdssupportsctns(!!mdsft52)
    !!mdsft52.support.mdssctnsstore = !!mdsft52.support.mdssctns
--<wd>aug2007<mds12>
-------------------------------------------------------------------

  -- Store Current representations in form for use later
    var !repre repre level
    !!mdsft52.repre.clear()
    !!mdsft52.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsft52.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsft52.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsft52.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)


  -- Collect all supports for frame type 52
    !!ce = /MDS/FRAMES/$!alias
      handle (2,109)
        !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        if (!modify.upcase() neq |MODIFY|) then
          delete stru
        endif
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
        return
      endhandle

  -- Generate Steel Size List

    --!dtext = ARRAY()
    --!rtext = ARRAY()
    -- !!MdsSetSize('CREATE',!!mdsft52,'-BAR-1','-V1')



-- -----------------------------------------------------------------------------
    !!mdsSetSteel.init('HIDE',!!mdsft52,'','-V1')
-- -----------------------------------------------------------------------------

    !!ce = !support.stru

-- In a non planer element has been used before the distance gadgets may be deactivated
-- so turn them all on

    !!mdsft52.dist.active = TRUE
      handle ANY
      endhandle
    !!mdsft52.bdist.active = TRUE
      handle ANY
      endhandle
    !!mdsft52.select.active = TRUE
      handle ANY
      endhandle
    !!mdsft52.bthro.active = TRUE
      handle ANY
      endhandle

    if (!modify.upcase() eq |MODIFY|) then

      -- !!MdsSetSize('SELECT',!!mdsft52,'-BAR-1','-V1')

-- ------------------------------------------------------------------------
      !!mdsSetSteel.init('HIDE',!!mdsft52,'','-V1')
-- ------------------------------------------------------------------------

      !!ce = !!mdsft52.support.datum

    -- Set distance gadget

      !!mdsDistance(!!mdsft52)

---------------------------------------------------------------------------------------
-- Add marker text markers at P9 of ATTAS
      !!mdsaidtext(!!mdsft52)

-- Store Atta reference in form
      do !count from 211 TO 259
        VAR !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
          handle ANY
            skip
          endhandle
        !!mdsft52.support.atta.append(!!ce)
      enddo

---------------------------------------------------------------------------------------

-- Store Packing Pieces in the Support Object
-- Derived from the 'Attas' :MDSPackRef references in the support.atta array

      !!mdspackattas(!!mdsft52.support)

---------------------------------------------------------------------------------------

-- Fill in dimensions from SREF atta (Stored in mm)

      !!ce = !sref.dbref()

      !despars = Despar
      !!mdsft52.dim1.val = !despars[1]
        handle any
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!mdsft52.dim2.val = !despars[3]
        handle any
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle
      !!mdsft52.dim3.val = !despars[2]
        handle any
          !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
          golabel /CONT
        endhandle

      -- disable the input boxes for initec when modifying frames rm 20/04/06
      !desc = desc of /MDS/TEMPLATES
      if !desc eq 'Initec Industrial Templates' then
        !!mdsft52.dim2.active = FALSE
        !!mdsft52.dim3.active = FALSE
      endif
    endif

  label /CONT

  -- Redefine standard support name on form title

  if (!alias eq 'FT52' OR !alias eq 'FT53') then
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsframe,'FRAME')
        !index = !!mdsframe.standard.rtext.findfirst('$!alias')
        !text  = !!mdsframe.standard.dtext[!index]
      endhandle
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsft52.support.replace = !formName

  if (!alias eq 'FT52' OR !alias eq 'FT53') then
    call !!mdsSetFormName(!!mdsft52, 'PIPE', '$!formName')
  endif

  !!ce = !!mdsft52.support.stru

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsft52.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsft52.repre.append('!!mdsRemAdd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsoptions.levchange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsoptions.levchange, $!colour)
      !colourlist = ARRAY()
      !colourlist.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourlist)
    enddo
  endif

    -- Set Support Code
    if !modify.upcase() neq 'MODIFY' then
      !!mdsSetSuppCode('CREATE',!name,!alias,'$!alias-1')
    else
      !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1')
    endif

--

----------------------------------------------------------------

  -- Set dimensions toggle
    !!mdsft52.graphicalDim = FALSE

  -- Store current form information
    call !!mdsStoreFT52()

  -- now generic to all supports
  -- Change for Claim & DACs
  -- if (!modify.upcase() eq |MODIFY|)then
  --   !!mdsShowConns(!!mdsft52)
  -- endif

  -- Show Form for frame type FT52
    !!kShowForm(!!mdsft52)

--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
    --<sk> 04/06/2012
    if !fromAtta then
      -- call creation of support datum from given preliminary support
      !!mdsCrDatumFromPs(!form, !datum)
    endif
-- End function
endfunction
