--------------------------------------------------------------------------------
--
--   File: Mdsift61.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--   Keyword:  MDS
--   Module:  design
--   Replaces:          IPS147
--
-- Author:  I.osborne
-- Created:  Mon Aug 04
--
--
-- Description:
-- Initialisation for form FT61
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsift61(!modify is STRING, !textname is STRING,!alias is STRING)

  --------------------------------------------
  -- check to see if form is already shown
  --------------------------------------------

  if !!mdsft61.shown() then
    !!alert.error('unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textname
  !form = !!mdsft61

  -- <sk> 04/06/2012
  !fromAtta = false

  -- Initialise Standard gadgets
  !!mdsft61.select.select('RTEXT', 'IDCUR')
  !!mdsft61.datum.active   = TRUE
  !!mdsft61.cancel.active  = TRUE
  !!mdsft61.setmat.active  = TRUE
  !!mdsft61.setsize.active = FALSE
  --<dw>aug2008 Dun979 - Welds added
  !!mdsft61.addweld.active = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotatecur = FALSE
  !support.handedcur = FALSE
  !support.rotated   = 0
  !support.bpnum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsft61.cancel.callback = |call !!mdscancelsupp(!!mdsft61)|
    !support.modify = FALSE

    -- Initialise variables for new supports
    !support.replace = !!mdsframe.replacement
    !support.type    = !!mdsframe.standard.selection('Rtext')
    !struname        = !!mdsframe.name.val

    -- Navigate to correct area
    if (!!mdsmovetosite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsdaccontrol(true)
    --q var !!mdsaccess
    --<sk> 04/06/2012
    -- check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'

    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU /$!struname
    !support.stru = !!ce
    :mdssupptype |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsft61.name.val = !struname

    !!mdsft61.dim1.val = 0
    !!mdsft61.dist.val = 0
    !!mdsft61.p.val = ''

    !!mdsframe.hide()

    ------------------------------ ***** connexions --------------------

    -- in create mode
    !!mdsft61.createbycur.active = TRUE
    !!mdsft61.createbydim.active = FALSE


  else

    -- Set callback on cancel button
    !!mdsft61.cancel.callback = |call !!mdsrestoreform(!!mdsft61)|
    !support.modify        = TRUE
    !!mdsft61.datum.active = FALSE

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !post      = !name & '-V1'

    -- Get length of existing Post
    !length = deri length of $!post
    !support.barlen.append(!length)

    -- Store Data in support object
    !support.type     = 'FT61'
    !support.position = TRUE
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.padir  = Pa Dir wrt world
    !support.pldir  = Pl Dir wrt world
    !support.p9dir  = P9 Dir wrt world
    !support.p10dir = P10 Dir wrt world
    !support.p11dir = P11 Dir wrt world

    -- Get Specific data to frame type 23 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotatecur = TRUE
    else
      !support.rotatecur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedcur = TRUE
    else
      !support.handedcur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bpref1 :MDSBpref1
    var !bpref2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedplate2 = !bpref2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsft61.name.val = !name
    !!mdsft61.dim1.val = 0
    !!mdsft61.p.val    = ''

    -- Store section name and matref for each member

    !storemat = ARRAY()
    !storemat = !!mdsstoremat(!name)
    !support.material = !storemat


    !!mdsaddall('$!textname')

    ------------------------------ ***** Connexions --------------------

    -- set support object connections
    !vertdbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertdbref[1] = !vert1.dbref()
    !conn1 = !vertdbref[1].:MDSConn
    !support.connections[1] = !conn1
    -- set the connection object for using :mdsancref
    !support.plateconns = object MDSBPLATECONN(!support)

    -- set support object for joints

    !support.joints = !!mdsgetjoints(!vertdbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsft61.createbycur.active = TRUE
      !!mdsft61.createbydim.active = FALSE
    else
      !!mdsft61.createbycur.active = TRUE
      !!mdsft61.createbydim.active = FALSE
    endif
    -------------------------------------------------------------------


  endif

  -- Store support object in form
  !!mdsft61.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsft61.repre.clear()
  !!mdsft61.repre.append(|Call !!kreprelevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsft61.repre.append(|Call !!kreprelevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsft61.repre.append(|Call !!kreprelevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsft61.repre.append(|Call !!kreprelevel(Nulref, 'STRU', $!repre,0)|)

  -- Collect all supports for frame type 23
  --  !!ce = /MDS/FRAMES/FT61
  -- Mod to allow FT48 to be created dtf 01.03.04
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List

  !rtext = ARRAY()
  -- !!mdssetsize('CREATE',!!mdsft61,'-V1','-V1')
  !!mdssetsteel.init('HIDE',!!mdsft61,'-V1','')

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsft61.dist.active   = TRUE
  handle ANY
  endhandle
  !!mdsft61.bdist.active  = TRUE
  handle ANY
  endhandle
  !!mdsft61.select.active = TRUE
  handle ANY
  endhandle
  !!mdsft61.bthro.active  = TRUE
  handle ANY
  endhandle

  -- Find current units and set the distance unit to metric

  --    !currentunits = !!kgetsetunits()

  -- sizes
  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle

  !subs  = !!kcollectallfor('SUBS', '((match(name, |SUBS1|) gt 0))', !!ce)
  !display = ARRAY()
  do !v values !subs
    !!ce = !v
    !!ce = first mem
    !xlen = !!ce.xlen
    -- get format
    !!kFormatText.text.val = !xlen
    !xformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !xformat = !xformat.replace('.00','')
    !ylen = !!ce.ylen
    -- get format
    !!kFormatText.text.val = !ylen
    !yformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !yformat = !yformat.replace('.00','')
    !zlen = !!ce.zlen
    -- get format
    !!kFormatText.text.val = !zlen
    !zformat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !zformat = !zformat.replace('.00','')

    --   !display.append(!xlen & 'x' & !ylen & 'x' & !zlen)
    !display.append(!xformat & 'x' & !yformat & 'x' &  !zformat)
  enddo
  !rtext.clear()
  do !i from 1 to !display.size()
    !rtext.append(!i.string())
  enddo


  !!ce = !support.stru

  if (!modify.upcase() eq |MODIFY|) then

    !!mdssetsteel.init('HIDE',!!mdsft61,'-V1','')

    !!ce = $!<name>/SUBS1
    handle (2,109)
    endhandle

    !desc = desc of /MDS/TEMPLATES
    handle ANY
      !desc = ''
    endhandle

    !!ce = !!mdsft61.support.datum

    -- Set distance gadget
    !!mdsdistance(!!mdsft61)

    -- add marker text markers

    var !pos pos wrt world

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    do !count from 211 to 259

      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle ANY
        skip
      endhandle

      -- Store Atta reference in form
      !!mdsft61.support.atta.append(!!ce)

      var !pos pos wrt world

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>

    enddo

    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsft61.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
    endhandle

  endif

  -- Redefine standard support name on form title

  !index = !!mdsframe.standard.rtext.findfirst('$!alias')
  !text  = !!mdsframe.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdspopulate(!!mdsframe,'FRAME')
    !index = !!mdsframe.standard.rtext.findfirst('$!alias')
    !text  = !!mdsframe.standard.dtext[!index]
  endhandle
  !suppnumber = before(!text, '-')
  !formname   = !suppnumber.trim()
  !!mdsft61.support.replace = !formname

  call !!mdssetformname(!!mdsft61, 'PIPE', '$!formname')

  !!ce = !!mdsft61.support.stru

  -- Set Support Code
  if !modify.upcase() neq 'MODIFY' then
    !!mdssetsuppcode('CREATE',!name,!alias,'$!alias-1')
  else
    !!mdssetsuppcode('MODIFY',!name,!alias,'$!alias-1')
  endif

  ------------------------ connexions ----------------------------
$(
  -- grey out steelwork connections if not set in default & frame not created
  if(!!mdsOptions.createCons.selection().real().eq(1)) then
    !!mdsft61.connect.active = False
    !!mdsft61.modify.active = False
    !!mdsft61.disconn.active = False
    !!mdsft61.forceCon.active = False
  elseif(!!mdsOptions.createCons.selection().real().neq(1) and !!mdsft61.support.stru.unset()) then
    !!mdsft61.connect.active = False
    !!mdsft61.modify.active = False
    !!mdsft61.forceCon.active = False
    !!mdsft61.disconn.active = False
  elseif(!!mdsOptions.createCons.selection().real().eq(2)) then
    !!mdsft61.connect.active = True
    !!mdsft61.forceCon.active = False
    !!mdsft61.modify.active = False
    !!mdsft61.disconn.active = True
  else
    !!mdsft61.connect.active  = True
    !!mdsft61.modify.active   = True
    !!mdsft61.forceCon.active = True
    !!mdsft61.disconn.active  = True
  endif
$)
  ----------------------------------------------------------------

  --!!mdsft61.rotatt.active = TRUE
  !!mdsft61.cutsect.active = FALSE

  -- Store current form information
  call !!mdsstoreft61()

  -- Set dimensions toggle

  !!mdsft61.graphicaldim = false

  -- Show Form for frame type FT61
  !!kshowform(!!mdsft61)


  -- Reset Units

  !!kRestoreUnits(!currentunits)

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif
  -- End function
endfunction
