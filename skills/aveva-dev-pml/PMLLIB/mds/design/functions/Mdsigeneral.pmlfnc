--
-- File:		Mdsigeneral.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsgeneral.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIgeneral()

-- Reset Gadgets
  !!MdsGeneral.Name.val = 'unset'
  !!MdsGeneral.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsGeneral,'GENERAL')

-- We need to take out XRT02 the pipe support for in line trunnions

  !Dtext = !!MdsGeneral.standard.dtext
  !Rtext = !!MdsGeneral.standard.rtext
  !FindRT02 = !Rtext.find('PIPE-REST-INLINE')
    !Dtext[$!FindRT02[1]].delete()
      handle NONE
        !Rtext[$!FindRT02[1]].delete()
        !dtext.compress()
        !rtext.compress()
        !!MdsGeneral.standard.dtext = !dtext
        !!MdsGeneral.standard.rtext = !rtext
      elsehandle ANY
      endhandle

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsGeneral.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsGeneral.view.active = false
      !!MdsGeneral.name.active = false
      return
    elsehandle none
      !!MdsGeneral.view.active = true
      !!MdsGeneral.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsGeneral)

-- Make the filter list the same as the standard list

  !!MdsGeneral.FilterByPipe.dtext = !!MdsGeneral.Standard.dtext
  !!MdsGeneral.FilterByPipe.rtext = !!MdsGeneral.Standard.rtext

-- Display all available ancillaries by default
  !!Mdsgeneral.nofilter(TRUE,!!Mdsgeneral)

-- Set the name gadget as the focus

  !!MdsGeneral.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsigeneral.pml
