--
-- File:  Mdsigt01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form Gt01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIGt01(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsGT01.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsGT01
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsGT01.datum.active = true
  !!mdsGT01.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsGT01.cancel.callback = |Call !!mdsCancelSupp(!!mdsGT01)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsGT01.name.val = !struName

    -- Length
    !!mdsGT01.length.active = false
    !!mdsGT01.pLength.active = false
    !!mdsGT01.length.val = 0
    -- Clearance
    !!mdsGT01.clearance.active = false
    !!mdsGT01.pClearance.active = false
    !!mdsGT01.clearance.val = 0
    -- Set buttons
    !!mdsGT01.setDefault.active = false
    !!mdsGT01.adjust.active = FALSE

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsGT01.cancel.callback = |Call !!mdsRestoreShoe(!!mdsGT01)|
    !support.modify = true
    !!mdsGT01.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsGT01.struBpref.clear()
      !!mdsGT01.struBpref.append(!name.dbref())
      !!mdsGT01.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsGT01.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsGT01.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsGT01.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsGT01.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    if !!mdsGT01.support.type.eq('GT14').not() then
      !!mdsGetProp(!!mdsGT01.length,!!mdsGT01.pLength,'LEN',!bore,!support.type)
      !!mdsGetProp(!!mdsGT01.clearance,!!mdsGT01.pClearance,'CLR',!bore,!support.type)
    endif

    -- Set buttons

    !!mdsGT01.setDefault.active = true
    if !!mdsGT01.support.type.eq('GT06') or !!mdsGT01.support.type.eq('GT14') or !!mdsGT01.support.type.eq('ST06') or !!mdsGT01.support.type.eq('GT46') then
      !!mdsGT01.setDefault.active = false
    endif
    !!mdsGT01.adjust.active = false
    if (!!mdsGT01.support.type inset('ST06','GT46','GT49')) then
      !!mdsGT01.adjust.active = true
    endif

    -- Store pos.ori and despar in case user cancel form
    !!mdsGT01.support.oldposition = POS WRT /*
    !!mdsGT01.support.oldorientation = ORI WRT /*
    !!mdsGT01.support.olddespars = despar

  endif

  LABEL /CONT


  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !title = 'GUIDE'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsGT01.support.replace = !formName

  call !!mdsSetFormName(!!mdsGT01, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsGT01.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsGT01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- If using GT26 than change the first text box to height rather that length.

  if (!alias inset ('GT26','GT46')) then
    !!mdsGT01.pLength.val = 'Height'
  else
    !!mdsGT01.pLength.val = 'Length'
  endif



  -- Show Form
  !!kShowForm(!!mdsGT01)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPS(!form, !datum)
  endif

endfunction
