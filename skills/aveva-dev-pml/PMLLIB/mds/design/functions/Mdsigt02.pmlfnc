--
-- File:  Mdsigt02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form Gt02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIGt02(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsgt02.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsgt02
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsgt02.datum.active = true
  !!mdsgt02.cancel.active = true
  !!mdsgt02.select.select('RTEXT', 'IDCUR')

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias


  -- Change description on form for either GT16/GT17

  if !alias.eq('GT16') or !alias.eq('GT17') then
    !!mdsgt02.pHeight.val = |Dimension L |
    !!mdsgt02.pLength.val = |Dimension R |
    !!mdsgt02.pClearance.val = |Dimension Z |
  else
    !!mdsgt02.pHeight.val = |Height      |
    !!mdsgt02.pLength.val = |Length      |
    !!mdsgt02.pClearance.val = |Clearance   |
  endif

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsgt02.cancel.callback = |Call !!mdsCancelSupp(!!mdsgt02)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsgt02.name.val = !struName

    -- Height
    !!mdsgt02.height.active = false
    !!mdsgt02.pHeight.active = false
    !!mdsgt02.height.val = 0
    -- Length
    !!mdsgt02.length.active = false
    !!mdsgt02.pLength.active = false
    !!mdsgt02.length.val = 0
    -- Clearance
    !!mdsgt02.clearance.active = false
    !!mdsgt02.pClearance.active = false
    !!mdsgt02.clearance.val = 0
    -- Set buttons
    !!mdsgt02.setDefault.active = false
    !!mdsgt02.dist.val = 0

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsgt02.cancel.callback = |Call !!mdsRestoreShoe(!!mdsgt02)|
    !support.modify = true
    !!mdsgt02.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsgt02.struBpref.clear()
      !!mdsgt02.struBpref.append(!name.dbref())
      !!mdsgt02.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsgt02.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsgt02.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsgt02.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsgt02.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsgt02.length,!!mdsgt02.pLength,'LEN',!bore,!support.type)
    !!mdsGetProp(!!mdsgt02.clearance,!!mdsgt02.pClearance,'CLR',!bore,!support.type)
    !!mdsGetProp(!!mdsgt02.height,!!mdsgt02.pHeight,'HEI',!bore,!support.type)

    -- Set buttons
    !!mdsgt02.setDefault.active = true
    !!mdsDistance(!!mdsgt02)

    -- Store pos.ori and despar in case user cancel form
    !!mdsgt02.support.oldposition = POS WRT /*
    !!mdsgt02.support.oldorientation = ORI WRT /*
    !!mdsgt02.support.olddespars = despar
    !!mdsgt02.resetdims()
  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !title = 'GUIDE'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsgt02.support.replace = !formName

  call !!mdsSetFormName(!!mdsgt02, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsgt02.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsgt02.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsgt02)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
