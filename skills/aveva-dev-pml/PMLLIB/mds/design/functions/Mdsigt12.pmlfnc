--
-- File:  Mdsigt12.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form Gt12
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIGt12(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsgt12.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsgt12
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsgt12.datum.active = true
  !!mdsgt12.cancel.active = true
  !!mdsgt12.rotAtt.active = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then
    --CREATE MODE

    -- Set callback on cancel button and set mode member of support object
    !!mdsgt12.cancel.callback = |Call !!mdsCancelSupp(!!mdsgt12)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsgt12.name.val = !struName

    -- Length
    !!mdsgt12.length.active = false
    !!mdsgt12.pLength.active = false
    !!mdsgt12.length.val = 0
    -- Clearance
    !!mdsgt12.clearance.active = false
    !!mdsgt12.pClearance.active = false
    !!mdsgt12.clearance.val = 0
    -- Height
    !!mdsgt12.height.active = false
    !!mdsgt12.pHeight.active = false
    !!mdsgt12.height.val = 0
    -- Set buttons
    !!mdsgt12.setDefault.active = false

    !!mdsGuide.hide()

  else
    -- MODIFY MODE

    -- Set callback on cancel button and set mode member of support object
    !!mdsgt12.cancel.callback = |Call !!mdsRestoreShoe(!!mdsgt12)|
    !support.modify = true
    !!mdsgt12.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsgt12.struBpref.clear()
      !!mdsgt12.struBpref.append(!name.dbref())
      !!mdsgt12.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsgt12.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsgt12.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsgt12.name.val = !name

    !!mdsAddAll('$!textName')

    -- Show rotate icon
    !!mdsgt12.rotAtt.active = true

  endif

  -- Store support object in form
  !!mdsgt12.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    if !!mdsgt12.support.type.eq('GT11') or !!mdsgt12.support.type.eq('ST07') then
      -->>>-<wd>sep2003
      -- GT11 and ST07 - DTSE DKEY for LENGTH is 'LEN' and NOT 'PLEN'
      !!mdsGetProp(!!mdsgt12.length,!!mdsgt12.pLength,'LEN',!bore,!support.type)
      !!mdsGetProp(!!mdsgt12.clearance,!!mdsgt12.pClearance,'CLR',!bore,!support.type)
      !!mdsgt12.height.val = 0
      !!mdsgt12.height.active = false
      !!mdsGetProp(!!mdsgt12.height,!!mdsgt12.pHeight,'HEI',!bore,!support.type)
    else
      !!mdsGetProp(!!mdsgt12.length,!!mdsgt12.pLength,'LEN',!bore,!support.type)
      !!mdsGetProp(!!mdsgt12.clearance,!!mdsgt12.pClearance,'CLR',!bore,!support.type)
      !!mdsGetProp(!!mdsgt12.height,!!mdsgt12.pHeight,'HEI',!bore,!support.type)
    endif

    -- !!mdsGetProp(!!mdsgt12.length,!!mdsgt12.pLength,'CONH',!bore,!support.type)
    -- !!mdsGetProp(!!mdsgt12.clearance,!!mdsgt12.pClearance,'GCLR',!bore,!support.type)
    -- Set buttons
    !!mdsgt12.setDefault.active = true

    -- Store pos.ori and despar in case user cancel form
    !!mdsgt12.support.oldposition = POS WRT /*
    !!mdsgt12.support.oldorientation = ORI WRT /*
    !!mdsgt12.support.olddespars = despar

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  if !!mdsgt12.support.type.eq('ST33') then
    !title = 'STOP'
  else
    !title = 'GUIDE'
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsgt12.support.replace = !formName

  call !!mdsSetFormName(!!mdsgt12, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsgt12.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsgt12.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsgt12)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
