--
-- File:  Mdsigt39.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form Gt39
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIGt39(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsGt39.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsGt39
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsGt39.datum.active = true
  !!mdsGt39.cancel.active = true
  !!mdsGt39.select.select('RTEXT', 'IDCUR')
  !!mdsGt39.type.active = FALSE
  !!mdsGt39.select.active = TRUE
  !!mdsGt39.dist.active = TRUE
  !!mdsGt39.bthro.active = TRUE
  !!mdsGt39.bdist.active = TRUE

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  -- Activate .type if type GT39
  if (!modify.upcase() neq 'MODIFY' and  !alias eq 'GT39' ) then
    !!mdsGt39.type.active = TRUE
  else
    !!mdsGt39.select.active = FALSE
    !!mdsGt39.dist.active = FALSE
    !!mdsGt39.bthro.active = FALSE
    !!mdsGt39.bdist.active = FALSE
  endif


  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsGt39.cancel.callback = |Call !!mdsCancelSupp(!!mdsGt39)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    -- Set Paragraph gadget on form
    !!mdsGt39.name.val = !struName

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>
    -- Create Stru

    -- Height
    !!mdsGt39.height.active = false
    !!mdsGt39.pHeight.active = false
    !!mdsGt39.height.val = 0
    -- Length
    !!mdsGt39.length.active = false
    !!mdsGt39.pLength.active = false
    !!mdsGt39.length.val = 0
    -- Clearance
    !!mdsGt39.clearance.active = false
    !!mdsGt39.pClearance.active = false
    !!mdsGt39.clearance.val = 0
    -- Set buttons
    --!!mdsGt39.setDefault.active = false
    !!mdsGt39.dist.val = 0

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsGt39.cancel.callback = |Call !!mdsRestoreShoe(!!mdsGt39)|
    !support.modify = true
    !!mdsGt39.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsGt39.struBpref.clear()
      !!mdsGt39.struBpref.append(!name.dbref())
      !!mdsGt39.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsGt39.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsGt39.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsGt39.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsGt39.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsGt39.length,!!mdsGt39.pLength,'LEN',!bore,!support.type)
    !!mdsGetProp(!!mdsGt39.clearance,!!mdsGt39.pClearance,'CLR',!bore,!support.type)
    !!mdsGetProp(!!mdsGt39.height,!!mdsGt39.pHeight,'HEI',!bore,!support.type)

    -- Set buttons
    --!!mdsGt39.setDefault.active = true
    !!mdsDistance(!!mdsGt39)

    -- Store pos.ori and despar in case user cancel form
    !!mdsGt39.support.oldposition = POS WRT /*
    !!mdsGt39.support.oldorientation = ORI WRT /*
    !!mdsGt39.support.olddespars = despar

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !title = 'GUIDE'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsGt39.support.replace = !formName

  call !!mdsSetFormName(!!mdsGt39, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsGt39.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsGt39.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsGt39)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
