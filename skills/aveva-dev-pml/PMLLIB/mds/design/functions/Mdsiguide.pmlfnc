--
-- File:		Mdsiguide.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsguide.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIguide()

-- Reset Gadgets
  !!MdsGuide.Name.val = 'unset'
  !!MdsGuide.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsGuide,'GUIDE')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsGuide.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsGuide.view.active = false
      !!MdsGuide.name.active = false
      return
    elsehandle none
      !!MdsGuide.view.active = true
      !!MdsGuide.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsGuide)

-- Make the filter list the same as the standard list

  !!MdsGuide.FilterByPipe.dtext = !!MdsGuide.Standard.dtext
  !!MdsGuide.FilterByPipe.rtext = !!MdsGuide.Standard.rtext

-- Display all available ancillaries by default
  !!Mdsgeneral.nofilter(TRUE,!!MdsGuide)


-- Set the name gadget as the focus

  !!MdsGuide.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsiguide.pml
