--
-- File:		Mdsihanger.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdshanger.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIhanger()

-- Reset Gadgets
  !!MdsHanger.Name.val = 'unset'
  !!MdsHanger.Ok.active = False

-- Read defaults file to load selections
  !!MdsPopulate(!!MdsHanger,'HANGER')

-- Check to see if all the standard for this type have been commented out
  !CheckVal = !!MdsHanger.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsHanger.view.active = false
      !!MdsHanger.name.active = false
      return
    elsehandle none
      !!MdsHanger.view.active = true
      !!MdsHanger.name.active = true
    endhandle

-- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsHanger)

-- Set the name gadget as the focus
  !!MdsHanger.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true
  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsihanger.pml
