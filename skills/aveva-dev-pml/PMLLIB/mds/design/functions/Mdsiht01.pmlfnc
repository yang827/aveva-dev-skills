--
-- File:		MdsiHt01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Initialisation for form Ht01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!MdsIHt01(!Modify is STRING, !TextName is String,!Alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsHt01.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif


-- $P File HT01
-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsHt01.Datum.Active = true
    !!MdsHt01.Cancel.Active = true
    !!MdsHt01.Bedplate.active = true
    !!Mdsht01.washer.val = 1
    !!Mdsht01.washer.active = false
    !!Mdsht01.connect.active = false
    !!Mdsht01.modify.active = false
    !!Mdsht01.forcecon.active = false
    !!Mdsht01.disconn.active = false
    !!Mdsht01.ancmat.active = false


  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.Position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    if (!Modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
      !!MdsHt01.Cancel.callback = |Call !!MdsCancelSupp(!!MdsHt01)|
      !Support.Modify = false

    -- Initialise variables for new supports
      !Support.Replace = !!MdsHanger.Replacement
      !Support.Type    = !!MdsHanger.standard.selection('Rtext')
      !StruName        = !!MdsHanger.Name.Val

    -- Set Paragraph gadget on form
      !!MdsHt01.Name.Val = !StruName

    -- RodLength
      !!MdsHt01.RodLength.Active = false
      !!MdsHt01.PRodLength.Active = false
      !!MdsHt01.RodLength.val = 0

    -- Clevis
      !!MdsHt01.Clevis.Active = false
      !Empty = array()
      !!MdsHt01.Clevis.Dtext = !Empty
      !!MdsHt01.Clevis.Rtext = !Empty

    -- Rotate

      !!MdsHt01.Rotate.Active = false

      !!MdsHt01.SetSteel.Active = false
      !!MdsHt01.Bedplate.Active = false

      !!MdsHanger.Hide()

    else

    -- Set callback on cancel button and set mode member of support object
      !!MdsHt01.Cancel.callback = |Call !!MdsRestoreShoe(!!MdsHt01)|
      !Support.Modify = true
      !!MdsHt01.Datum.Active = false

    -- Store Data in support object
      !Support.Type     = ( :MDSSuppType of $!name )
      !Support.Position = true

      -- Store Atta reference's in object
      !Support.Atta.append(!Name.dbref())

      -- Navigate to existing support datum
      !!CE = !Name.dbref()
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.Datum  = !Name.dbref()

      -- Get bedplate references if set
      var !BPRef1 :MDSBpref1
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
        !!MdsHt01.StruBpref.clear()
        !!MdsHt01.StruBpref.append(!Name.dbref())
        !!MdsHt01.StruBpref.append(!Bpref1.dbref())
        -- Store original ref
        !!MdsHt01.Storebpref.clear()
        !String = !Bpref1.dbref()
        !!MdsHt01.Storebpref.append(|:MDSBpref1 $!String|)
      endif


      -- Set Form Gadgets
      !!MdsHt01.Name.Val = !Name

      !!ce = !support.datum
      !swash = :MDSSwasher
      !!Mdsht01.washer.active = true
      if (!swash) then
        !!Mdsht01.washer.val = 2
      else
        !!Mdsht01.washer.val = 1
      endif

      !!MdsAddAll('$!TextName')

    endif

  -- Store support object in form
    !!MdsHt01.Support = !Support

    if (!Modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

      VAR !POS POS WRT WORLD
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    -- Set RodLength and length gadgets

      !ParVar = '!!MdsPar$!Support.Type'
      !Bore = pa bore

    -- RodLength
      !!MdsHt01.RodLength.Active = true
      !!MdsHt01.PRodLength.Active = true
       !RodLength = !!KStrReal('const dist p41 to p42')
      !!MdsHt01.RodLength.val = !RodLength

    -- Store pos.ori and despar incase user cancel form
      !!MdsHt01.support.oldposition = POS WRT /*
      !!MdsHt01.support.oldorientation = ORI WRT /*
      !!MdsHt01.support.olddespars = despar
      !!MdsHt01.support.oldspref = spref
      !!Mdsht01.support.swasher  = !support.datum.:MDSSwasher

      !Trun = :MDSSref

      !TrunnionSize = !Trun.Styp.After('TT02-D-')
      !TrunnionSize = !TrunnionSize.Before('-')

-- The available clevis size can be worked out from the at08 standard
-- Load the appropiate suffix codes for ht01 or ht02

      !Codes = Array()

      if (!TrunnionSize eq '2') then
        !Codes.append('B')
        !Codes.append('C')
      elseif (!TrunnionSize eq '3') then
        !Codes.append('D')
        !Codes.append('E')
      elseif (!TrunnionSize eq '4') then
        !Codes.append('F')
        !Codes.append('G')
      elseif (!TrunnionSize eq '6') then
        !Codes.append('H')
        !Codes.append('J')
      elseif (!TrunnionSize eq '8') then
        !Codes.append('K')
        !Codes.append('L')
      elseif (!TrunnionSize eq '10') then
        !Codes.append('M')
      elseif (!TrunnionSize eq '12') then
        !Codes.append('N')
        !Codes.append('P')
      elseif (!TrunnionSize eq '14') then
        !Codes.append('Q')
      elseif (!TrunnionSize eq '16') then
        !Codes.append('R')
      elseif (!TrunnionSize eq '18') then
        !Codes.append('S')
      else
        !!Alert.error('Unable to find a clevis to match the trunnion bore')
        !!kRestoreUnits(!currentunits)
        return
      endif

      !!MdsHT01.Clevis.Dtext = !Codes
      !!MdsHT01.Clevis.Rtext = !Codes

      !Ht01styp = !!CE.styp.after('-')
      !Ht01styp = !Ht01styp.before('-')
      !!MdsHt01.clevis.select('DTEXT','$!Ht01styp')
      handle ANY
      -- if attached trunnion has changed the line above will fall over (AK)
      endhandle
    endif

  LABEL /CONT

  -- Redefine standard support name on form title

    !Index = !!MdsHanger.Standard.Rtext.findfirst('$!Support.Type')
    !Text  = !!MdsHanger.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsHanger,'HANGER')
        !Index = !!MdsHanger.Standard.Rtext.findfirst('$!Support.Type')
        !Text  = !!MdsHanger.Standard.Dtext[!Index]
      endhandle
    !Title = 'HANGER'
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsHt01.Support.Replace = !FormName

    call !!MdsSetFormName(!!MdsHt01, '$!Title', '$!FormName')

  -- If modify put members into repre member of form

  if (!Modify.upcase() eq 'MODIFY')then
    do !addrepre values !!MdsHt01.support.atta
      !!CE = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !Colour = !!KFindDrawColour(!!CE)
      !BranName = !!CE.owner.string()
      !!MdsHt01.Repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
      -- Add to model at level set by !!MdsOptions.LevChange value
    Call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
      !ColourList = ARRAY()
      !ColourList.append(!!CE.Name.dbref())
      Call !!KEnhanceList(!ColourList)
    enddo
  endif

  -- Store current form information
    Call !!MdsStoreHt01()

  -- Show Form
    !!KShowForm(!!MdsHt01)

--wd--aug2000
    !!Mdsht01.washer.active = false
    !!Mdsht01.washer.val = 1

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiHt01.pml
