--
-- File:		MdsiHt03.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Initialisation for form Ht03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIHt03(!Modify is STRING, !TextName is String,!Alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsHt03.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif


-- $P File HT03
-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsHt03.Datum.Active = true
    !!MdsHt03.Cancel.Active = true
    !!MdsHt03.BDist.active = true
    !!MdsHt03.Dist.active = true
    !!MdsHt03.BThro.active = true
    !!MdsHt03.Select.active = true
    !!MdsHt03.Nudge.active = true
    !!MdsHt03.Bedplate.active = true

    !!Mdsht03.washer.active = false
    !!Mdsht03.washer.val    = 1
    !!Mdsht03.connect.active = false
    !!Mdsht03.modify.active = false
    !!Mdsht03.forcecon.active = false
    !!Mdsht03.disconn.active = false
    !!Mdsht03.ancmat.active = false

  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.Position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    if (!Modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
      !!MdsHt03.Cancel.callback = |Call !!MdsCancelSupp(!!MdsHt03)|
      !Support.Modify = false

    -- Initialise variables for new supports
      !Support.Replace = !!MdsHanger.Replacement
      !Support.Type    = !!MdsHanger.standard.selection('Rtext')
      !StruName        = !!MdsHanger.Name.Val

    -- Set Paragraph gadget on form
      !!MdsHt03.Name.Val = !StruName
      !!MdsHt03.Dist.Val = 0
      !!MdsHt03.P.Val = ''

    -- Rod Length
      !!MdsHt03.RodLength.Active = false
      !!MdsHt03.PRodLength.Active = false
      !!MdsHt03.Rodlength.val = 0
    -- Clamp Angle
      !!MdsHt03.CAngle.Active = false
      !!MdsHt03.PCAngle.Active = false
      !!MdsHt03.CAngle.val = '0'

      !!MdsHt03.SetSteel.Active = false
      !!MdsHt03.Bedplate.Active = false

      !!MdsHanger.Hide()

    else

    -- Set callback on cancel button and set mode member of support object
      !!MdsHt03.Cancel.callback = |Call !!MdsRestoreShoe(!!MdsHt03)|
      !Support.Modify = true
      !!MdsHt03.Datum.Active = false

    -- Store Data in support object
      !Support.Type     = ( :MDSSuppType of $!name )
      !Support.Position = true

      -- Store Atta reference's in object
      !Support.Atta.append(!Name.dbref())

      -- Navigate to existing support datum
      !!CE = !Name.dbref()
      !Support.PADir  = Pa Dir wrt world
      !Support.PLDir  = Pl Dir wrt world
      !Support.P9Dir  = P9 Dir wrt world
      !Support.Datum  = !Name.dbref()

      -- Get bedplate references if set
      var !BPRef1 :MDSBpref1
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
        !!MdsHt03.StruBpref.clear()
        !!MdsHt03.StruBpref.append(!Name.dbref())
        !!MdsHt03.StruBpref.append(!Bpref1.dbref())
        -- Store original ref
        !!MdsHt03.Storebpref.clear()
        !String = !Bpref1.dbref()
        !!MdsHt03.Storebpref.append(|:MDSBpref1 $!String|)
      endif

      -- Set Form Gadgets
      !!MdsHt03.Name.Val = !Name
      !!MdsHt03.P.Val    = ''

      !!ce = !support.datum
      !swash = :MDSSwasher
      !!Mdsht03.washer.active = true
      if (!swash) then
        !!Mdsht03.washer.val = 2
      else
        !!Mdsht03.washer.val = 1
      endif

      !!MdsAddAll('$!TextName')

    endif

  -- Store support object in form
    !!MdsHt03.Support = !Support

    if (!Modify.upcase() eq 'MODIFY') then

    -- Set distance gadget

      !!MdsDistance(!!MdsHt03)

    -- Add marker text markers

      VAR !POS POS WRT WORLD
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    -- Set Rodlength and Clamp Angle gadgets

    -- RodLength is p41 to p42
      !!MdsHt03.RodLength.Active = true
      !!MdsHt03.PRodLength.Active = true
       !Rodlength = !!KStrReal('const dist p41 to p42')
      !!MdsHt03.Rodlength.val = !RodLength
    -- Clamp Angle
    -- Angle is design parameter 2
      !!MdsHt03.CAngle.Active = true
      !!MdsHt03.PCAngle.Active = true
      var !Angle despar 2
      !!MdsHt03.CAngle.val = '$!Angle'

    -- Store pos.ori and despar incase user cancel form
      !!MdsHt03.support.oldposition = POS WRT /*
      !!MdsHt03.support.oldorientation = ORI WRT /*
      !!MdsHt03.support.olddespars = despar
      !!Mdsht03.support.swasher    = !support.datum.:MDSSwasher

    endif

  LABEL /CONT

  -- Redefine standard support name on form title

    !Index = !!MdsHanger.Standard.Rtext.findfirst('$!Support.Type')
    !Text  = !!MdsHanger.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsHanger,'HANGER')
        !Index = !!MdsHanger.Standard.Rtext.findfirst('$!Support.Type')
        !Text  = !!MdsHanger.Standard.Dtext[!Index]
      endhandle
    !Title = 'HANGER'
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsHt03.Support.Replace = !FormName

    call !!MdsSetFormName(!!MdsHt03, '$!Title', '$!FormName')

  -- If modify put members into repre member of form

  if (!Modify.upcase() eq 'MODIFY')then
    do !addrepre values !!MdsHt03.support.atta
      !!CE = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !Colour = !!KFindDrawColour(!!CE)
      !BranName = !!CE.owner.string()
      !!MdsHt03.Repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
      -- Add to model at level set by !!MdsOptions.LevChange value
    Call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
      !ColourList = ARRAY()
      !ColourList.append(!!CE.Name.dbref())
      Call !!KEnhanceList(!ColourList)
    enddo
  endif

  -- Store current form information
    Call !!MdsStoreHt03(!Modify.upcase())

  -- Show Form
    !!KShowForm(!!MdsHt03)


-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiHt03.pml
