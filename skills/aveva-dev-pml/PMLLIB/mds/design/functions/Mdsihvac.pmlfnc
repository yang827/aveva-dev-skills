--
-- File:		Mdsihvac.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdshvac.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIhvac()

-- Reset Gadgets
  !!MdsHvac.Name.val = 'unset'
  !!MdsHvac.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsHvac,'HVAC')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsHvac.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsHvac.view.active = false
      !!MdsHvac.name.active = false
      return
    elsehandle none
      !!MdsHvac.view.active = true
      !!MdsHvac.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsHvac)

-- Set the name gadget as the focus

  !!MdsHvac.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsihvac.pml
