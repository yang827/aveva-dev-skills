--
-- File:		MdsiJointSpec.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Mon 22nd June 1998
--
--
-- Description:
-- Initialisation
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        ANY          [Support form called from or gadget called from ]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIJointSpec(!Form is Any)

  -- Initialise Variables
    if(!Form.Objecttype().eq('GADGET')) then
       !FormPassed = !!MdsJointSpec.Form
    else
       !FormPassed = !Form
    endif

    !Stypes                 = Array()
    !Spec                   = /MDS-External_Joints-Spec
    !Dtext                  = array()
    !SavedStyp              = !!MdsJointSpec.Styp.selection()
  -- Set form member to the joints of the support

    !!MdsJointSpec.Support  = !FormPassed.Support
    !Joints                 = !FormPassed.Support.Joints
    !JointsAsStrings        = !!KConvertArray(!Joints,'STRING','')
    !!MdsJointSpec.Form     = !FormPassed

-- Apply to all joints
    !JointsAsStrings.Append('ALL')

  -- load spec gadget only
    if(!Form.Name().neq('SPEC') and !Form.Name().neq('STYP') and !Form.Name().neq('JLIST')) then
  -- show Joint Positions on view
     do !i indices !Joints
        !Pos = !Joints[!i].pos.wrt(worl)
        aid text number 1001 'Joint[$!i]' at $!Pos
--        !Dtext.append('  ' &  !Joints[!I].name.string() & '  (Joint[$!I])  ')
        !Dtext.append(!Joints[!I].name.string() & ' (Joint[$!I])')
     enddo

-- Apply to all joints
--    !Dtext.Append('  Apply to All Joints')
    !Dtext.Append('Apply to All Joints')

-- set jlist gadget to list of joints
     !!MdsJointSpec.Jlist.Dtext = !Dtext
     !!MdsJointSpec.Jlist.Rtext = !JointsAsStrings

--<wd>jan2001
-- Select 'ALL' joints as default
    !!MdsJointSpec.Jlist.select('rtext','ALL')
--<wd>jan2001

-- load spec gadgets up with data from the /MDS/External_Joints spec
    endif

   !Joint = !!MdsJointSpec.Jlist.Selection().dbref()

     Handle ANY
      -- Apply to all joints
         !Joint = !!MdsJointSpec.Jlist.Rtext.first().dbref()
     endhandle

-- first find out what gtype of mainstl and vertical are
   !MAinType    = !Joint.owner.owner.gtype
   !UprightType = !Joint.Cref.gtype

   !Spref = !Joint.spref
     Handle ANY
      -- Apply to all joints
         !Spref = !!MdsJointSpec.Jlist.Rtext.first().dbref().spref
     endhandle
   !CurrentJline = !!MdsJointSpec.Jlist.Selection().dbref().jline
     Handle ANY
      -- Apply to all joints
         !CurrentJline = !!MdsJointSpec.Jlist.Rtext.first().dbref().jline
     endhandle

-- populate spec gadget with mds spec (could be extended to more)
  if(!Form.Name().neq('STYP')) then
   if(!Spec.Desc.eq('')) then
     !Specs[1] = !Spec.Flnn
     !!MdsjointSpec.Spec.Dtext = !Specs
   else
     !Specs[1] = !Spec.Desc
     !!MdsjointSpec.Spec.Dtext = !Specs
   endif
     !SpecsR[1] = !Spec.string()
     !!MdsjointSpec.Spec.Rtext = !SpecsR
     if(!Spref.Unset().not()) then
        -- assume modify and back fill spec gadgets with current spref
        var !CurrentSpec refe of spec of $!Spref
        !!MdsJointSpec.Spec.Select('Rtext',!CurrentSpec)
     endif
  endif

-- then collect the choices from the spec in the gadget above
   !Spec = !!MdsJointSpec.Spec.Selection().dbref()

-- collect the tans to owner type to match the support mainstl
   var !OwnerType coll all sele with owner eq $!Spec and tans eq '$!Maintype' for $!Spec

   if(!OwnerType.unset()) then
   -- none found (clear gadgets)
      !Dtext.clear()
      !Dtext[1] = 'None Available'
      !Rtext[1] = 'NONE'
      !!MdsJointSpec.Spec.Dtext = !Dtext
      !!MdsJointSpec.Spec.Rtext = !Rtext
      !!MdsJointSpec.Styp.Dtext = !Dtext
      !!MdsJointSpec.Styp.Rtext = !Rtext
      !!MdsJointSpec.Spre.Dtext = !Dtext
      !!MdsJointSpec.Spre.Rtext = !Rtext
      !!MdsJointSpec.Just.Dtext = !Rtext
      !!MdsJointSpec.Just.Rtext = !Rtext
      return
   endif

-- find the tans of ANY
--   if(!AttachedType.unset()) then
--       var !AttachedType coll all sele with owner eq $!Ownertype[1] and tans eq 'ANY' for $!OwnerType[1]
--   endif

--<wd>mar2000
-- Always ADD the Tans 'ANY' Connection types
     var !AttachedType coll all sele with owner eq $!Ownertype[1] and tans eq 'ANY' for $!OwnerType[1]

-- collect the tans to attached type from the ownertype
--   var !AttachedType coll all sele with owner eq $!Ownertype[1] and tans eq '$!UprightType' for $!OwnerType[1]

-- Append Owner Type Specific Joints
   var !AttachedType append coll all sele with owner eq $!Ownertype[1] and tans eq '$!UprightType' for $!OwnerType[1]
--<wd>mar2000


   if(!AttachedType.unset()) then
   -- none found (clear gadgets)
      !Dtext.clear()
      !Dtext[1] = 'None Available'
      !Rtext[1] = 'NONE'
      !!MdsJointSpec.Styp.Dtext = !Dtext
      !!MdsJointSpec.Styp.Rtext = !Rtext
      !!MdsJointSpec.Spre.Dtext = !Dtext
      !!MdsJointSpec.Spre.Rtext = !Rtext
      !!MdsJointSpec.Just.Dtext = !Rtext
      !!MdsJointSpec.Just.Rtext = !Rtext
      return
   endif


-- collect all choices from attached level to populate styp gadget
   do !AInd indices !AttachedType
      var !StypesA coll all sele with owner eq $!AttachedType[$!Aind] for $!AttachedType[$!Aind]
      !Stypes.appendarray(!StypesA)
   enddo
   if(!STypes.unset()) then
   -- none found (clear gadgets)
      !Dtext.clear()
      !Dtext[1] = 'None Available'
      !Rtext[1] = 'NONE'
      !!MdsJointSpec.Styp.Dtext = !Dtext
      !!MdsJointSpec.Styp.Rtext = !Rtext
      !!MdsJointSpec.Spre.Dtext = !Dtext
      !!MdsJointSpec.Spre.Rtext = !Rtext
      !!MdsJointSpec.Just.Dtext = !Rtext
      !!MdsJointSpec.Just.Rtext = !Rtext
      return
   endif

   var !StypeDesc eval desc for all from !Stypes

-- if called from jlist (the joint) the dont refresh if the data in the form is the same


   if(!Form.Name().eq('JLIST')  and !Spref.string().eq(!!MdsJointSpec.Spre.Selection())) then
   else
     if(!Form.Name().neq('STYP')) then
        !!MdsJointSpec.Styp.DTEXT = !StypeDesc
        !!MdsJointSpec.Styp.RTEXT = !Stypes
     endif
-- populate list with joints available

     !Stype = !!MdsJointSpec.Styp.selection()

-- set to selected styp

     if(!Form.Name().eq('STYP')) then
       !!MdsJointSpec.Styp.select('RTEXT',!Savedstyp)
       if(!Spref.Unset().Not()) then
         !CurrentStyp = !Spref.owner.string()
-- temp got this line out
          --!!MdsJointSpec.Styp.select('RTEXT',!CurrentStyp)

       endif
     endif


     var !Spcos coll all spco for $!Stype

     if(!Spcos.unset()) then
     -- none found (clear gadgets)
        !Dtext.clear()
        !Dtext[1] = 'None Available'
        !Rtext[1] = 'NONE'
        !!MdsJointSpec.Spre.Dtext = !Dtext
        !!MdsJointSpec.Spre.Rtext = !Rtext
        !!MdsJointSpec.Just.Dtext = !Rtext
        !!MdsJointSpec.Just.Rtext = !Rtext
        return
     endif

     var !JointDesc eval catr for all from !Spcos
--   var !JointName eval name for all from !Spcos

     !!MdsJointSpec.Spre.Dtext = !JointDesc
     !!MdsJointSpec.Spre.Rtext = !Spcos

   endif

-- set to current joint setting

     if(!Form.Name().neq('STYP')) then
      if(!Spref.Unset().Not()) then
        !!MdsJointSpec.Spre.select('RTEXT',!Spref.string())
          handle any
          -- if not in current list try another styp
             do !Index to !!MdsJointSpec.Styp.rtext.size()
                 !!MdsJointSpec.Styp.Val = !index
                 !Stype = !!MdsJointSpec.Styp.selection()

                 var !Spcos coll all spco for $!Stype

                 if(!Spcos.unset()) then
                 -- none found (clear gadgets)
                    !Dtext.clear()
                    !Dtext[1] = 'None Available'
                    !Rtext[1] = 'NONE'
                    !!MdsJointSpec.Spre.Dtext = !Dtext
                    !!MdsJointSpec.Spre.Rtext = !Rtext
                    !!MdsJointSpec.Just.Dtext = !Rtext
                    !!MdsJointSpec.Just.Rtext = !Rtext
                    return
                 endif

                 var !JointDesc eval catr for all from !Spcos
            --   var !JointName eval name for all from !Spcos

                 !!MdsJointSpec.Spre.Dtext = !JointDesc
                 !!MdsJointSpec.Spre.Rtext = !Spcos

                 !!MdsJointSpec.Spre.select('RTEXT',!Spref.string())
                  handle any
                  elsehandle NONE
                    break
                  endhandle
             enddo
          endhandle
      endif
     endif

-- populate justification gadget with available jlines for selected spco

   !!MdsJointSpec.JUST.DTEXT = !!MdsGetJlines(!!MdsJointSpec.Spre.Selection().dbref())
   handle ANY
   -- if no plines are available
      !Dtext.clear()

      !Dtext[1] = 'NA'
      !Rtext[1] = 'NA'
      !!MdsJointSpec.JUST.DTEXT = !Dtext
      !!MdsJointSpec.JUST.RTEXT = !Rtext
   elsehandle NONE
      !!MdsJointSpec.JUST.RTEXT = !!MdsGetJlines(!!MdsJointSpec.Spre.Selection().dbref())
      if(!Spref.unset().not()) then
         !!MdsJointSpec.JUST.Select('RTEXT',!CurrentJline)
         handle (61,567) (61,615) $* F&M: Cannot find required field in list/menu (Selecting a Joint NOT having the !currentjpline)
           !!MdsJointSpec.JUST.Select('RTEXT','NA')
         endhandle
      endif
   endhandle

-- Populate dimension details from the dataset
   !!MdsSetJGadgets()

-- End function
endfunction

-- End of file MdsiJointSpec.pml
