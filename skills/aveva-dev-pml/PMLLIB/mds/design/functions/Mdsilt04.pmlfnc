--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form lt04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIlt04(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsLT04.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Calling Form
  !callingForm = !!mdsGeneral

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsLT04
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsLT04.datum.active = true
  !!mdsLT04.cancel.active = true
  !!mdsLT04.rotate.active = true
  !!mdsLT04.bDist.active = true
  !!mdsLT04.dist.active = true
  !!mdsLT04.bThro.active = true
  !!mdsLT04.select.active = true
  !!mdsLT04.nudge.active = true
  !!mdsLT04.bedplate.active = true
  !!mdsLT04.connect.active = false
  !!mdsLT04.modify.active = false
  !!mdsLT04.forcecon.active = false
  !!mdsLT04.disconn.active = false
  !!mdsLT04.newdat.active = false
  !!mdsLT04.adploc.active = false

  !!mdsLT04.graphicaldim = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsLT04.cancel.callback = |Call !!mdsCancelSupp(!!mdsLT04)|
    !support.modify = false
    !!mdsLT04.rpad.val = FALSE

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsLT04.name.val = !struName
    !!mdsLT04.dist.val = 0
    !!mdsLT04.p.val = ''

    -- DeActivate gadgets
    !!mdsLT04.mdsadp.active = false
    !!mdsLT04.bedplate.active = false

    -- Hide Calling form
    !callingForm.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsLT04.cancel.callback = |Call !!mdsRestoreShoe(!!mdsLT04)|
    !support.modify = true
    !!mdsLT04.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Set Form Gadgets
    !!mdsLT04.name.val = !name
    !!mdsLT04.p.val    = ''
    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsLT04.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsLT04)

    -- Add marker text markers
    !!mdsaidtext(!!mdsLT04)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsLT04.support.atta.append(!!ce)
    enddo

    -- Set the Reinforcing Pad Toggle to TRUE if the ATTA exists
    if (!!mdsLT04.support.atta.size().gt(1)) then
      !!mdsLT04.rpad.val = TRUE
    else
      !!mdsLT04.rpad.val = FALSE
    endif

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGeneral,'GENERAL')
    !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGeneral.standard.dtext[!index]
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsLT04.support.replace = !formName

  call !!mdsSetFormName(!!mdsLT04, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsLT04.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsLT04.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    Call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif
  --Grey out reinforcing pad gadget if lt09
  if !support.alias eq 'LT09' then
    !!mdsLT04.rpad.active = FALSE
  else
    !!mdsLT04.rpad.active = TRUE
  endif
  -- Store current form information
  Call !!mdsStorelt04()

  -- Show Form
  !!kShowForm(!!mdsLT04)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCreateGeneralFromPS (!form, !name)
  endif

endfunction
