--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form lt05
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIlt05(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsLT05.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  !callingForm = !!mdsGeneral

  -- Initialise Variables
  !name = '/' & !textName

  --<ak> 21/06/2012
  !form = !!mdsLT05
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsLT05.crElbo.active = true
  !!mdsLT05.crTube.active = true
  !!mdsLT05.cancel.active = true
  !!mdsLT05.rotate.active = false
  !!mdsLT05.bDist.active = true
  !!mdsLT05.dist.active = true
  !!mdsLT05.bThro.active = true
  !!mdsLT05.select.active = true
  !!mdsLT05.nudge.active = true
  !!mdsLT05.bedPlate.active = false
  !!mdsLT05.connect.active = false
  !!mdsLT05.modify.active = false
  !!mdsLT05.forcecon.active = false
  !!mdsLT05.disconn.active = false
  !!mdsLT05.newdat.active = false
  !!mdsLT05.adploc.active = false

  !!mdsLT05.graphicaldim = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias



  if (!modify.upcase() neq 'MODIFY')then
    -- CREATE MODE
    if (!support.alias inset ('LT05A','LT05B','LT05C','LT05D','LT05E','LT05F','LT05G','LT05H')) then
      !!mdsLT05.crElbo.active = true
      !!mdsLT05.crTube.active = false
    elseif (!support.alias inset ('LT08A','LT08B','LT08C','LT08D','LT08E','LT08F','LT08G','LT08H')) then
      !!mdsLT05.crElbo.active = false
      !!mdsLT05.crTube.active = true
    endif

    -- Set callback on cancel button and set mode member of support object
    !!mdsLT05.cancel.callback = |Call !!mdsCancelSupp(!!mdsLT05)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsLT05.name.val = !struName
    !!mdsLT05.dist.val = 0
    !!mdsLT05.p.val = ''

    !!mdsLT05.mdsadp.active = false

    !!mdsLT05.bedPlate.active = false

    !callingForm.hide()

  else
    -- MODIFY MODE

    -- Set callback on cancel button and set mode member of support object
    !!mdsLT05.cancel.callback = |Call !!mdsRestoreShoe(!!mdsLT05)|
    !support.modify = true
    !!mdsLT05.crElbo.active = false
    !!mdsLT05.crTube.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsLT05.struBpref.clear()
      !!mdsLT05.struBpref.append(!name.dbref())
      !!mdsLT05.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsLT05.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsLT05.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsLT05.name.val = !name
    !!mdsLT05.p.val    = ''

    !!mdsAddAll('$!textName')

    !!mdsLT05.rotate.active = false
    !!mdsLT05.rotatt.active = false
    !!mdsLT05.bedPlate.active = false
    !!mdsLT05.modatta.active = false
    !!mdsLT05.deleteatta.active = false
    !!mdsLT05.nudge.active = false
    !!mdsLT05.anccopy.active = false
    !!mdsLT05.ancnudge.active = false
  endif

  -- Store support object in form
  !!mdsLT05.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    -->>>-<wd>oct2002
    !cecomp = !!ce
    if (!!ce.owner.href.type.eq('TEE')) then
      !cecomp = !!ce
      branch
      goto href
    endif
    !!mdsDistance(!!mdsLT05)
    !!ce = !cecomp
    --<<<-<wd>oct2002

    -- Add marker text markers
    !!mdsaidtext(!!mdsLT05)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsLT05.support.atta.append(!!ce)
    enddo

    if !!mdsLT05.support.datum.owner.href.type.eq('ELBO') then
      !!mdsLT05.bDist.active = false
      !!mdsLT05.dist.active = false
      !!mdsLT05.bThro.active = false
      !!mdsLT05.select.active = false
    else
      !!mdsLT05.bDist.active = true
      !!mdsLT05.dist.active = true
      !!mdsLT05.bThro.active = true
      !!mdsLT05.select.active = true
    endif
  endif

  LABEL /CONT

  -- Redefine standard support name on form title
  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle any
    if !callingForm.string().upcase().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
      handle any
        !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type$nA')
        !text  = !!mdsGeneral.standard.dtext[!index]
      endhandle
    endif
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsLT05.support.replace = !formName

  call !!mdsSetFormName(!!mdsLT05, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsLT05.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsLT05.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    Call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  Call !!mdsStorelt05()

  -- Show Form
  !!kShowForm(!!mdsLT05)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCreateGeneralFromPS (!form, !name)
  endif

endfunction
