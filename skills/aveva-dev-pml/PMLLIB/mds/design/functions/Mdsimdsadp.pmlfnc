--
-- File:		Mdsmdsadp.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon Aug 17
--
--
-- Description:
-- Initialisation or dismiss for the MDS ADP drawlist control form.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          FORM NAME
--     2     R        STRING        INIT or DISMISS
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIMdsAdp(!Form is FORM,!MODE is STRING)

-- MODE INIT

  if !MODE eq 'INIT' then

-- Store calling form in form member

    !!MdsMdsAdp.form = !form

--    !!MdsMdsAdp.addrem.val = 1

-- Set support name gadget

    !!MdsMdsAdp.Name.val = !Form.Support.Stru.name
      handle (2,754)
        !!MdsMdsAdp.Name.val = !Form.Support.datum.name
          handle (2,754)
            return error 1 |Datum atta not yet created!|
          endhandle
      endhandle

--<kp>july06
    --!!CE = !Form.Support.Datum
    --handle ANY
    --      return error 1 |Datum atta not yet created!|
    --endhandle
    if !Form.Support.Datum.Badref() then
          return error 1 |Datum atta not yet created!|
    endif
-- Load drawlist gadget


   if !!MdsMdsAdp.addrem.val eq 1 then
    !listtype = 'MdsAdp'
   else
    !listtype = 'MdsAdpRem'
   endif
--    !Atta = !Form.Support.datum.:MdsAdp
--    !Atta = !Form.Support.datum.:$!listtype
    !Atta = !Form.Support.GetElemforUDA().:$!listtype
      handle (2,754)
        return error 1 |Datum atta not yet created!|
      endhandle

-- Can only modify the target element (atta/stru/rest) if we can write to it

--<kp>july06
    !!CE = !Form.Support.GetElemForUDA()
--<kp>july06
    if !!MdsComClaimDac(!!ce,'DACMOD',':MdsAdp').not() then
      --!!Alert.Error('Unable to modify the adp drawlist as write access is not available to the datum atta')
      !!Alert.Error('Unable to modify the adp drawlist as write access is not available to ' + !!CE.namtyp)
      return
    endif

-- We need to clear out any unknown refs

    do !Count from 1 to !Atta.size()
      !Test = !Atta[$!Count].name
        handle any
          !Atta[$!Count].delete()
        endhandle
    enddo

-- Reset :mdsAdp

    !!MdsDacControl(true)

    !atta.compress()
    :$!listtype default
    do !reset from 1 to !atta.size()
      :$!listtype num $!Reset $!Atta[$!Reset]
    enddo

    same

    !Dtext = ARRAY()
    !Rtext = ARRAY()
    !!MdsMdsAdp.Enhance.clear()
    do !Set values !Atta
      !Dtext.append(!Set.fullname.string())
      !Rtext.append(!Set.ref.string())
      !Colour = !!GphColOpt.highlight().code
      ENHANCE $!Set.name COLOUR $!Colour
      !!MdsMdsAdp.Enhance.append(!Set.ref)
    enddo
    !!MdsMdsAdp.EleList.Dtext = !Dtext
    !!MdsMdsAdp.EleList.Rtext = !Rtext
    if !!MdsMdsAdp.shown().not() then
     !!MdsMdsAdp.show('AT',0,0)
    endif
    !!MdsDacControl(false)

  endif

-- MODE DISMISS

-- Loop through enhance member if unenhance graphics

  if !MODE eq 'DISMISS' then
    do !Unenhance values !!MdsMdsAdp.Enhance
      unenhance $!Unenhance
    enddo
  endif

endfunction

-- End of file Mdsmdsadp.pml
