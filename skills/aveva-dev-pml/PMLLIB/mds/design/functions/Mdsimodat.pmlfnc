--
-- File: Mdsimodat.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Init macro for a form to modify the design parameters of a ancillary
-- on a framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        framework form name
--     2     R         FORM        ancillary for name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsImodat(!frameForm is FORM,!ancillForm is FORM)

  !!mdsEditProp.init(!frameForm)

return
-- Do not show this form if the new !!mdsEditProp is shown

  !newFormShown = !!mdsEditProp.shown()
  if !newFormShown then
    !!alert.error('Unable to show modify atta form while modify atta properties form is displayed')
    return
  endif

-- Set calling form in member

   !!mdsmodat.callingForm = !frameForm

--------------------------------------------
-- Set Units
    !currentunits = !!kgetsetunits()
--------------------------------------------

  if defined(!!doNotId) then
    if !!doNotId then
        !!doNotId = FALSE
        golabel /SkipID
    endif
  endif


  -- Test if any atta's have been created
    if !frameForm.support.datum.unset() then
      !!kRestoreUnits(!currentunits)
      return error 1 |Unable to modify an atta as none have been created|
    endif

-- Check if Calling Support Form is a MDS Framework or Ancillary Standard
    if (!frameForm.support.stru.set()) then
      !!mdsmodat.modifytype.active = true
      !num = 2
    else
      !!mdsmodat.modifytype.active = false
      !num = 1
    endif

-- If only the datum atta has been created default to that
-- rather than id the atta
    if !frameForm.support.datum.set() and !frameForm.support.atta.size().eq(!num) then
      !!ce = !frameForm.support.datum
      !picked = !!ce
    else

-- Identify ancillary by cursor
    prompt off
    prompt load escape |Identify ancillary to modify|
label /again
    id atta plat @
       handle (61,528)
         prompt dismiss
         prompt on
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
         return
       endhandle

    !picked = !!ce

  -- Is picked atta on support
  -- Create list of atta's on support

    if (!frameForm.support.atta.findfirst(!picked).set().not())then
      !!alert.error('Ancillary picked is not on this support')
       golabel /again
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
      return
    endif

    -- Check to see if the SREF has been hit, if it has goto the DATUM atta

    if (match(!!ce.name,'/SREF') gt 0) then
      !srefName = !!ce.name
      var !strip (before(!srefName,'/SREF'))
      !datumName = !strip & '/DATUM'
      !!ce = !datumName.dbref()
    endif

  endif

label /SkipID
  !picked = !!ce

--<dw>aug2008 dun979 - BR07 to BR09 added below
  !!mdsmodat.setSteel.active = true
  if !frameForm.support.alias.eq('AT29') or !frameForm.support.alias.eq('AT28') then
    !!mdsmodat.setSteel.active = false
  elseif !frameForm.support.alias.eq('AN11') or !frameForm.support.alias.eq('AT24') then
    !!mdsmodat.setSteel.active = false
  elseif !frameForm.support.alias.eq('LT02') or !frameForm.support.alias.eq('AT21') then
    !!mdsmodat.setSteel.active = false
  elseif (!frameForm.support.alias Inset ('BR01','BR02','BR03','BR04','BR05','BR06','BR07','BR08','BR09','AT65')) then
    !!mdsmodat.setSteel.active = false
  endif

  if !frameForm.support.alias.unset().not() then
    if !frameForm.support.alias.match('LT03').gt(0) then
      !!mdsmodat.setSteel.active = false
    elseif !frameForm.support.alias.match('LT04').gt(0) then
      !!mdsmodat.setSteel.active = false
    endif
  endif


  !!mdsmodat.name.val = !!ce.name

  !!mdsmodat.atta = !!ce.name.dbref()

  !alias = !!ce.styp
  !!mdsSetGadgets(!ancillForm,!!ce,!alias)

-- If the standard is an AT25 then the height is controlled via the insulation so therefore
-- block out the modification of the height

  if !frameForm.support.alias.eq('AT25') or !frameForm.support.alias.eq('AN06') then
    !!mdsmodat.height.active = false
  endif

  !!mdsmodat.setdefault.active = true
-- AN04 is worked off the shoe so the height and length cannot be adjusted
--<wd>jan2003
-- Add 'AN09', 'GT22', 'GT24' OVERSTRAP GUIDES/ANCHORS because has NO ADJUSTABLE DIMENSIONS i.e USER DPs
--  if !frameForm.support.alias.eq('AN04')  then
  if (( !frameForm.support.alias inset ('AN04','AN09','GT22','GT24','GT40') ) ) then
--<wd>jan2003
    !!mdsmodat.height.active = false
    !!mdsmodat.length.active = false
    !!mdsmodat.setdefault.active = false
    !!mdsmodat.setSteel.active = false
  endif

--AT62/AT69/AT70/AT71 does not require the set height to steelwork icon

  if ((!frameForm.support.alias inset('AT62','AT69','AT70','AT71'))) then
    !!mdsmodat.setSteel.active = false
  endif

--<wd>feb2003
-- Deactivate the Set To Steel Gadget for the Types shown:
-----------------------------------------------------------------
-- Deactivate if These Support Types Belong to Pipes ** NOT ** on a MDS Framework
  if ((!frameForm.support.alias inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F', $
    'AT34A','AT34B','AT34C','AT34D','AT34E','AT34F', 'AT35', $
    'AT36','AT37','AT38','AT39','AT40A','AT40B','AT40C','AT40D','AT40E','AT40F', $
    'AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT43','AT44','AT45', $
    'AT46','AT47','AT48','AT49', 'AT50', 'AT51','GT23A','GT23B','LT06','AT57','AT58','AT59','AT68') ) ) then
--<wd>oct2003 -- AT59/AT68 added to above line
    !!mdsmodat.setSteel.active = false

-- Deactivate if These Support Types Belong to Pipes on a MDS Framework
  elseif ((!picked.styp inset('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F', $
    'AT34A','AT34B','AT34C','AT34D','AT34E','AT34F', 'AT35', $
    'AT36','AT37','AT38','AT39','AT40A','AT40B','AT40C','AT40D','AT40E','AT40F', $
    'AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT43','AT44','AT45', $
    'AT46','AT47','AT48','AT49', 'AT50', 'AT51','GT23A','GT23B','LT06','AT32','AT66','AT67','AT59','AT68','LT13A','LT13B','LT14A','LT14B','LT15','LT16A','LT16B') ) ) then
--<wd>oct2003 -- AT59/AT68 added to above line
    !!mdsmodat.setSteel.active = false
  endif

-- Deactivate the Set Parameters to Default Gadget for the Types shown:
  if (!frameForm.support.alias inset('AT40A','AT40B','AT40C','AT40D','AT40E','AT41A','AT41B','AT41C','AT41D','AT41E','AT42')) then
    !!mdsmodat.setdefault.active = false
  endif
--<wd>feb2003

-----------------------------------------------------------------------
--<wd>feb2004
-- Deactivate the '.setSteel' gadget for Slip Units and Reinforcing Pads
  if (!picked.stype.matchwild('SU*')) then
    !!mdsmodat.setSteel.active = FALSE
  elseif (!picked.styp inset ('AN05','AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
    !!mdsmodat.setSteel.active = FALSE
  elseif (!picked.styp inset ('AT21','AT22','AT32','AT54','AT63','AT64','AT67','AT68','GT21','GT22','GT23A','GT23B','GT24','GT40')) then
-- Overstraps and Clamps etc...
    !!mdsmodat.setSteel.active = FALSE
  endif
--<wd>feb2004

-- Check to see if you can write to the desp if not then block out all buttons

  !!mdsDacControl(true)
  !dacBoolean = DACMOD DESP
  !!mdsDacControl(false)
  if !dacBoolean.not() then
    !!mdsmodat.setdefault.active = false
    !!mdsmodat.setSteel.active = false
    !!mdsmodat.modifytype.active = false
  endif

-- If using a LT13A/B & LT15 the angle paragraph gadget can be used for the weld size

  if (!frameForm.support.alias inset('LT13A','LT13B','LT15')) then
    !!mdsmodat.pangle.val = 'Weld Size'
  elseif (!frameForm.support.alias inset('LT16A','LT16B')) then
    !!mdsmodat.pangle.val = 'Clearance'
  elseif (!frameForm.support.alias inset('LT12')) then
   !!mdsmodat.pangle.val = 'Gap'
  elseif (!frameForm.support.alias inset('AT100A','AT100B','AT101A','AT101B')) then
   !!mdsmodat.pheight.val    = 'StStl Length'
   !!mdsmodat.plength.val    = 'StStl Width'
   !!mdsmodat.pthickness.val = 'Ptfe Length'
   !!mdsmodat.pangle.val     = 'Ptfe Width'
  elseif (!frameForm.support.alias inset('AT75B')) then
   !!mdsmodat.plength.val = 'Offset'
  else
   !!mdsmodat.plength.val    = 'Length'
   !!mdsmodat.pheight.val    = 'Height'
   !!mdsmodat.pthickness.val = 'Thickness'
   !!mdsmodat.pangle.val     = 'Angle'
  endif
--<bc>April2004

  !!kshowForm(!!mdsmodat)

--------------------------------------------
-- Reset Project Units
        !!kRestoreUnits(!currentunits)
--------------------------------------------
return
