--
-- File:    MdsImodfh.pml
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:   Tue Oct 28
--
--
-- Description:
-- Init macro for a form to modify the design parameters of a ancillary
-- on a framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        framework form name
--     2     R         FORM        ancillary for name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsImodfh(!HangerForm is FORM,!ModifyForm is FORM, !SHOWFORM is BOOLEAN)

  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceIn(1, '!!MdsImodfh($!HangerForm is FORM,$!ModifyForm is FORM, $!SHOWFORM is BOOLEAN)')
  endif

--------------------------------------------
-- Set Units
     !currentunits = !!kgetsetunits()
     units mm bore mm dist
--------------------------------------------

  -- Test if any atta's have been created
    if !HangerForm.support.Datum.unset() then
      !!kRestoreUnits(!currentunits)
      return error 1 |Unable to modify an atta as none have been created|
    endif

-- If only the datum atta has been created default to that
-- rather than id the atta
    if !HangerForm.support.Datum.set() and !HangerForm.support.atta.size().eq(1) then
      !!CE = !HangerForm.support.datum
      !Picked = !!CE
    else
-- Identify ancillary by cursor
      prompt off
      prompt load escape |Identify hanger to modify|
label /again
      id atta hanger @
      handle (61,528)
        prompt dismiss
        prompt on
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
        return
      endhandle
      if(!!CE.type.eq('ATTA'))then
        !Picked = !!CE
      else
        goto href
        handle any
          !!kRestoreUnits(!currentunits)
          return error 2 |Identify hanger is not connected to an atta|
        endhandle
        if(!!CE.type.neq('ATTA'))then
          !!kRestoreUnits(!currentunits)
          return error 2 |Identify hanger is not connected to an atta|
        endif
        !Picked = !!CE
      endif
  --  Is picked atta on support
  --  Create list of atta's on support

      if (!HangerForm.Support.Atta.findfirst(!Picked).set().not())then
        !!Alert.error('Hanger/Atta picked is not on this support')
        golabel /again
--------------------------------------------
        !!kRestoreUnits(!currentunits)
--------------------------------------------
        return
      endif
    endif

  !ModifyForm.Name.val = !!CE.name.after('/')
  !ModifyForm.Atta = !!CE

  -- Unset the available rod sizes list
  -- This list will be created when the user click on the 'changerodsize' button
  !ModifyForm.allowedRodSizes = array()
  -- !ModifyForm.setAvailableRodSizes(!HangerForm)
  !ModifyForm.setRodsToModify(!HangerForm)
  !ModifyForm.ModifySpring1.active = false
  !ModifyForm.ModifySpring2.active = false
  !ModifyForm.ModifyTrav1.active = false
  !ModifyForm.ModifyTrav2.active = false

  if(!!CE.styp.match('FH') gt 0) then
    !ModifyForm.FixedVariable.settooltip(|Change to Variable Hanger|)

  else
    !ModifyForm.FixedVariable.settooltip(|Change to Fixed Hanger|)
    !ModifyForm.ModifySpring1.active = true
    !ModifyForm.ModifyTrav1.active = TRUE

    !hangertypes = object Mdshangertypes()
    !oRest = !hangerForm.support.rest
    !inset = !oRest.styp inset$!!Mdsallhangertypes.DSSpring

    if(!oRest.hangers.size() gt 1 and $
      (not !oRest.styp inset$!!Mdsallhangertypes.DSSpring) ) then
      -- this is a double hanger restr with two independent springs
      -- Not two springs connected with a beam (DS PSL type)
      !ModifyForm.ModifySpring2.active = true
      !ModifyForm.ModifyTrav2.active = TRUE
    endif
  endif

  !ModifyForm.changeRodSize.active = true

  if(!!CE.styp inset$!!Mdsallhangertypes.BM1Spring or $
    !!CE.styp inset$!!Mdsallhangertypes.BM2Spring or $
    !!CE.styp inset$!!Mdsallhangertypes.DoubleBM1Spring) then
    -- spring has no rods.
    -- Changing rod size is not applicable
    !ModifyForm.changeRodSize.active = false
  endif

  !ModifyForm.changeChannelSpan.active = false
  !ModifyForm.changeChannelHeight.active = false


-------------------------------------------------------------
-->>><wd>sep2003
  !alias = !hangerform.support.alias
--  if(!!CE.styp inset$!!Mdsallhangertypes.channelAssembly)then
  if(!alias inset$!!Mdsallhangertypes.channelAssembly)then
--<<<<wd>sep2003
-------------------------------------------------------------

    !ModifyForm.changeChannelSpan.active = true
    !ModifyForm.changeChannelHeight.active = true

  elseif(!!CE.styp inset$!!Mdsallhangertypes.DSSpring)then
    !ModifyForm.changeChannelSpan.active = true
-- >>> dtf to allow riser clamps to have variable clamp sizes
  elseif(!!Mdsallhangertypes.RiserClamp.find(!alias).size().gt(0)  ) then
    !ModifyForm.changeChannelSpan.active = true
--<<< dtf End of Mod
  endif

-->>> dtf 7 sep 04. Mod to allow travel to be set on vspr with prop of travel
  if(!!mdsallhangertypes.m5constant.find(!alias).size().gt(0)  ) then
    !ModifyForm.ModifyTrav1.active = TRUE
    !ModifyForm.ModifyTrav2.active = FALSE
    !ModifyForm.ModifySpring2.active = FALSE

  endif

  !ModifyForm.tagHangers(!HangerForm)

-------------------------------------------------------------
-->>><wd>sep2003
  --!Alias = !!CE.styp
  !alias = !hangerform.support.alias
--<<<<wd>sep2003
-------------------------------------------------------------

  !!MdsSetGadgets(!ModifyForm,!!CE,!Alias)

  if(!SHOWFORM and (not !ModifyForm.shown())) then
    !!KShowForm(!ModifyForm)
  endif

  !!kRestoreUnits(!currentunits)
  if(define(!!MdsDEBUG)) then
    !!MdsDEBUG.traceOut(1, '!!MdsImodfh($!HangerForm is FORM,$!ModifyForm is FORM, $!SHOWFORM is BOOLEAN)')
  endif
return

-- End of file MdsImodfh.pml
