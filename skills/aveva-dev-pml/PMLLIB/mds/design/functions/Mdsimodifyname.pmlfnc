--
-- File:		Mdsimodifyname.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Friday 22nd January 1998
--
--
-- Description:
-- Initialisation for form Mdsmodifyname
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- ***************
-- IMPORTANT NOTE:
-- ***************
--
-- Currently this function is NOT called by the function 'Mdsmcopysupp.pml'.
--
-- The Associated Modify Support Name FORM 'Mdsmodifyname.frm' is used for
-- Re-Naming Existing Individual Supports INDEPENDENTLY, and is called from
-- the 'Modify>Support Name...' option from the MDS Application TOP Bar Menu,
-- when Users want to Change the Name of a Single MDS Support and Associated Attas.
--
-- The Copy Support Form 'Mdscopysupp.frm' and function 'Mdsmcopysupp.pml'
-- do NOT CURRENTLY call this function. to Initialise the form 'Mdsmodifyname.frm'
-- when ReNaming Copied Supports. All the Necessary Actions for 'Mdsmodifyname.frm'
-- are SET in the calling function  'Mdsmcopysupp.pml' for the COPY option.
--
-- ***************
-- IMPORTANT NOTE:
-- ***************
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       NAMEONLY - For ONLY Modifying the Name of an Individual
--                                             MDS Support Structure and Associated Attas
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsimodifyname(!mode is STRING)

-- Load Modify Support Name Form in the Correct TYPE - 'Blocking' or 'Non Blocking'
    if (!mode eq 'COPY') then
-- Load form as type BLOCKING
      !!kloadftype('Mdsmodifyname','BLOCKING')
    elseif (!mode eq 'NAMEONLY') then
      !!kloadftype('Mdsmodifyname','')
    endif

-- Inactivate ALL Permissible Gadgets on the form 'Mdscopysupp'
    !!kresetactive(!!Mdsmodifyname,true)

--<wd>oct2005
-- Modified the "Apply" button callback for use with VPRM, but ONLY for the mode 'NAMEONLY'

-- Set the Callback for the 'Apply' button on the form 'Mdsmodifyname'
    --!!Mdsmodifyname.applyform[1] = |!!Mdsmodifyname(1,1,'$!<mode>')|
    --!!Mdsmodifyname.applyform[3] = |!!Mdsmodifyname.newname.val = 'unset'|
    if (!mode.eq('COPY')) then
      !!Mdsmodifyname.applyform[1] = |!!Mdsmodifyname(1,1,'$!<mode>')|
      !!Mdsmodifyname.applyform[2] = |!!Mdsmodifyname.name.val = 'unset'|
      !!Mdsmodifyname.applyform[3] = |!!Mdsmodifyname.newname.val = 'unset'|

    elseif (!mode.eq('NAMEONLY')) then
      !!mdsmodifyname.applyform[1] = |!!mdsvprmrename(1,1,'NAMEONLY')|
      !!mdsmodifyname.applyform[2] = |!!mdsmodifyname.name.val = 'unset'|
      !!mdsmodifyname.applyform[3] = |!!Mdsmodifyname.newname.val = 'unset'|
-- Default Setting
      !!mdsmodifyname.addremgroup = ''

    endif
--<wd>oct2005

-- Show Form to Modify Names of Structure and Associated Attas
    !!Mdsmodifyname.name.val    = 'unset'
    !!Mdsmodifyname.newname.val = 'unset'
    !!Mdsmodifyname.show()

-- Set focus of form
    !!Mdsmodifyname.newname.setfocus()

  endfunction
-- End function

-- End of file Mdsimodifyname.pml
