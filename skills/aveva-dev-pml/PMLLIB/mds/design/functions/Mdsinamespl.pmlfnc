--
--
-- Description:
-- Initialisation for the special naming form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsINameSpl()

  !formC = 'builtforms' + '2'

  -- Check if forms '!!mdssplframe' or '!!mdsNameSpl' or '!!mdsspecial' are already displayed
  if (!!mdssplframe.shown() or !!mdsNameSpl.shown() or !!mdsspecial.shown()) then
    !!alert.error('Unable to Initiate another Special Support whilst a SPECIAL Support is being Created or Modified')
    return
  endif

  -- Initialise Variables

  !!mdsNameSpl.name.val = 'unset'
  --<sk> 12/06/2012 Turn on preliminary support option (can be disabled by !!mdsNameSplok)
  !!mdsNameSpl.fromexisting.active = true

  !zyx = 'h.yx6$h095454360537'
  !!mdsNameSpl.number.val = !!mdsOptions.specPre

  -- If the default creation zone has the function set to 'PIPE' for piping
  -- HVAC for HVAC
  -- TRAY for Cable Tray set the type automatically
  !defaultSite = !!mdsOptions.site.val.dbref()
  if !defaultSite.func.eq('PIPE') then
    !!mdsNameSpl.type.select('RTEXT','MULTI')
  elseif !defaultSite.func.eq('HVAC') then
    !!mdsNameSpl.type.select('RTEXT','HVAC')
  elseif !defaultSite.func.eq('TRAY') then
    !!mdsNameSpl.type.select('RTEXT','RACK')
  else
    !!mdsNameSpl.type.select('RTEXT','MULTI')
  endif

  !return = !zyx.substring(10,!formC)
  !!mdsNameSpl.create.select('rtext','ATTA')
  !!mdsNameSpl.name.setfocus()

  -- Set Callback on OK button to align with '.create' Button
  !!mdsNameSpl.ok.callback = |!!mdsispecial('NEW','$$!!mdsNameSpl.name','$$!!mdsNameSpl.number')|

  if !return.not() then
    !!messageFile.warning(43,292)
    return error 9 noalert
  endif
  -- Show Form
  --<wd>13dec2000
  --    !!mdsNameSpl.show('At',0,0.07)
  !!mdssitecheck(!!mdsNameSpl)
  --<wd>13dec2000

  if defined(!!mdsSpecon) then
    if !!mdsSpecon.boolean() then
      !!mdsNameSpl.number.active = TRUE
    else
      !!mdsNameSpl.number.active = FALSE
    endif
  else
    !!mdsNameSpl.number.active = TRUE
  endif

endfunction
