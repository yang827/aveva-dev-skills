--
-- Author:  N.morris
-- Created:  11th March 2004
--
--
-- Description:
-- Initialisation for form MdsPr01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsIPr01(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsPr01.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  !callingForm = !!mdsPrelimSupp

  -- Initialise Variables

  !name = '/' & !textName

  -- Initialise Standard gadgets

  !!mdsPr01.datum.active = true
  !!mdsPr01.cancel.active = true
  !!mdsPr01.rotate.active = true
  !!mdsPr01.bDist.active = true
  !!mdsPr01.dist.active = true
  !!mdsPr01.bThro.active = true
  !!mdsPr01.select.active = true
  !!mdsPr01.nudge.active = true
  !!mdsPr01.bedPlate.active = true
  !!mdsPr01.connect.active = false
  !!mdsPr01.modify.active = false
  !!mdsPr01.forcecon.active = false
  !!mdsPr01.disconn.active = false
  !!mdsPr01.newdat.active = false
  !!mdsPr01.adploc.active = false
  !!mdsPr01.graphicaldim = false
  !!mdsPr01.flipatta.active = false
  !!mdsPr01.anccopy.active  = true
  !!mdsPr01.ancnudge.active = true
  -------------------------------------
  --<GE> 12/02/07 Fix for Defect: 10209
  !!mdsPr01.viewflip.active = false
  !!mdsPr01.ancnote.active = false
  !!mdsPr01.ancmat.active = false
  --<GE> 12/02/07
  -------------------------------------

  -- Create Support object

  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  -- Create Mode

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsPr01.cancel.callback = |Call !!mdsCancelSupp(!!mdsPr01)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    -- Set Paragraph gadget on form
    !!mdsPr01.name.val = !struName
    !!mdsPr01.dist.val = 0
    !!mdsPr01.p.val = ''

    !!mdsPr01.mdsadp.active = false

    !callingForm.hide()

    !!mdsPr01.modtype.active = FALSE

  else

    -- Modify Mode

    -- Set callback on cancel button and set mode member of support object
    !!mdsPr01.cancel.callback = |Call !!mdsRestoreShoe(!!mdsPr01)|
    !support.modify = true
    !!mdsPr01.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsPr01.struBpref.clear()
      !!mdsPr01.struBpref.append(!name.dbref())
      !!mdsPr01.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsPr01.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsPr01.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsPr01.name.val = !name
    !!mdsPr01.p.val    = ''

    !!mdsAddAll('$!textName')

    !!mdsPr01.modtype.active = TRUE

  endif

  -- Store support object in form

  !!mdsPr01.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsPr01)

    -- Add marker text markers
    !!mdsaidtext(!!mdsPr01)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsPr01.support.atta.append(!!ce)
    enddo

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsPrelimSupp,'PRELIMSUPP')
    !index = !!mdsPrelimSupp.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsPrelimSupp.standard.dtext[!index]
  endhandle

  !title = 'PRELIMSUPP'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsPr01.support.replace = !formName

  call !!mdsSetFormName(!!mdsPr01, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then

    !!mdsPr01.support.oldPosition = POS WRT /*
    !!mdsPr01.support.oldOrientation = ORI WRT /*
    !!mdsPr01.support.oldSuppFunc = !!ce.:MdsSuppFunc
    handle Any
    endhandle

    !colourList = ARRAY()
    do !addrepre values !!mdsPr01.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsPr01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsStorePr01()

  -- Show Form
  !!kShowForm(!!mdsPr01)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
