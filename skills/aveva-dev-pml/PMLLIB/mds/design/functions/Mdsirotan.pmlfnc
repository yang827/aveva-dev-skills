--
--
-- Description:
-- Rotate atta's
--
--------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM          Calling form
--     2     R         STRING        Callback
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIRotan(!Form is FORM,!CallBack is STRING)

-- Does datum exist yet

  if (!Form.Support.Datum.set().not())then
    !!Alert.message('Unable to rotate atta/s as none have been created')
    return
  endif

-- Cannot rotate all atta if a trunnion type exists

  if !!MdsCheckTrun(!Form,'ALL') then
    !!Alert.message('Unable to rotate atta/s when a trunnion type support exists')
    return
  endif

-- If a HVAC special then cannot rotate atta
  if (!Form.Support.Datum.styp.eq('HVAC-REST')) then
    !!Alert.message('HVAC support attas cannot be rotated')
    return
  endif


-- Can we move all components of the support

  if !!MdsCheckAccess(!Form,'DACMOD','POS').not() then
    !!CE = !Form.Support.Datum
      handle any
      endhandle
    return
  endif

  !!MdsRotan.Name.val = !Form.Support.Stru.name
    handle (2,754)
      !!MdsRotan.Name.val = !Form.Support.Datum.name
    endhandle

  if !Form.Support.Type eq 'FT21' then
    !!MdsRotan.Angle.val = 180
  else
    !!MdsRotan.Angle.val = 90
  endif

  !!MdsRotan.Ok.Callback = !CallBack

  !!MdsRotan.show()

endfunction
