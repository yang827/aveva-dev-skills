-- Description:
-- Rotate hanger members
--
--------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM          Calling form
--     2     R         STRING        Callback
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIRotHanger(!form is FORM,!callback is STRING)

  -- Does datum exist yet

  if (!form.support.datum.set().not())then
    !!alert.message('Unable to rotate hanger as no atta have been created')
    return
  endif

  !!mdsRothanger.name.val = !form.support.stru.name.after('/')
  handle (2,754)
    !!mdsRothanger.name.val = !form.support.datum.name.after('/')
  endhandle

  !!mdsRothanger.ok.callback = !callback
  if(!callback.upcase().match('FALSE') gt 0) then
    -- Rotate only one hanger component at a time
    if !form.support.datum.styp.eq('MH01') then
      if !form.support.datum.ldir.wrt(/* ).string().eq('U WRT /*') or !form.support.datum.adir.wrt(/* ).string().eq('U WRT /*') or !form.support.datum.ldir.wrt(/* ).string().eq('Z WRT /*') or !form.support.datum.adir.wrt(/* ).string().eq('Z WRT /*') then
        !!mdsRothanger.formtitle = 'Rotate Vertical Hanger'
      elseif  !!mdsremovegrad(!form.support.datum)[1].eq(!form.support.datum.cref.tdir.opposite()) or !!mdsremovegrad(!form.support.datum)[1].eq(!form.support.datum.cref.tdir) then
        !!mdsRothanger.formtitle = 'Rotate Horizontal Hanger'
      else
        !!alert.error('Unable to rotate non vertical hanger')
        return
      endif
    else
      !!mdsRothanger.formtitle = 'Rotate One Hanger member'
    endif
  else
    !!mdsRothanger.formtitle = 'Rotate All Hanger members'
  endif
  if(!!mdsRothanger.angle.val.unset()) then
    !!mdsRothanger.angle.val = 90
  endif
  !!kShowForm(!!mdsRothanger)
  --  !!mdsRothanger.show()

endfunction
