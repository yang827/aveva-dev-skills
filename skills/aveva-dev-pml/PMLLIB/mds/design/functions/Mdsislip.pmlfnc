--
-- File:		Mdsislip.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsslip.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIslip()

-- Reset Gadgets
  !!MdsSlip.Name.val = 'unset'
  !!MdsSlip.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsSlip,'SLIP')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsSlip.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsSlip.view.active = false
      !!MdsSlip.name.active = false
      return
    elsehandle none
      !!MdsSlip.view.active = true
      !!MdsSlip.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsSlip)

-- Make the filter list the same as the standard list

  !!MdsSlip.FilterByPipe.dtext = !!MdsSlip.Standard.dtext
  !!MdsSlip.FilterByPipe.rtext = !!MdsSlip.Standard.rtext

-- Display all available ancillaries by default
  !!Mdsgeneral.nofilter(TRUE,!!MdsSlip)

-- Set the name gadget as the focus

  !!MdsSlip.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdsislip.pml
