-- Author:		Andrew Kirkland
-- Created:		Mon 13 th July 1998
--
--
-- Description:
-- Function to find out whether passed snod is related to a support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Snod]
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN      [Is the snode related to a support (true it is)]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsISnodeSupp(!node is dbref) is boolean

  -- Initialise Variables



  !Return = False

  !Mem = !!Kcollectallfor('SJOI','',!Node)

  do !sj indices !Mem

   if(!Mem[!sj].cref.neq(nulref) and purp of zone of cref of $!Mem[$!sj] eq 'SUPP') then
      !Return = True
   endif

  enddo

  Return !Return

-- End function
endfunction

-- End of file MdsISnodeSupp.pml
