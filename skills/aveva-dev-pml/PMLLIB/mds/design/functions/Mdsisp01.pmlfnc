--
-- File:		MdsiSP01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 19 May 1998
--
--
-- Description:
-- Initialisation for form SP01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!MdsiSP01(!Modify is STRING, !TextName is String,!Alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsSp01.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsSP01.Datum.Active = true
    !!MdsSP01.Cancel.Active = true
    !!MdsSp01.connect.active = false
    !!MdsSp01.modify.active = false
    !!MdsSp01.forcecon.active = false
    !!MdsSp01.disconn.active = false


  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.Position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    if (!Modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
      !!MdsSP01.Cancel.callback = |Call !!MdsCancelSupp(!!MdsSP01)|
      !Support.Modify = false

    -- Initialise variables for new supports
      !Support.Replace = !!MdsSpring.Replacement
      !Support.Type    = !!MdsSpring.standard.selection('Rtext')
      !StruName        = !!MdsSpring.Name.Val

    -- Set Form member to the slip unit selected, in order to find out the stype
      !!MdsSP01.Stype = !!MdsSpring.Standard.selection('DTEXT')

    -- Set Paragraph gadget on form
      !!MdsSP01.Name.Val = !StruName

    -- Set buttons

      !!MdsSP01.Dist.Val    = 0
      !!MdsSP01.Height.Val  = 0
      !!MdsSP01.Case.Val    = 0
      !!MdsSP01.CaseDia.Val = 0
      !!MdsSP01.Squa.Val    = 0
     -- !!MdsSP01.Nudge.Val   = 0

      !!MdsSpring.Hide()

      !!MdsSP01.Dist.active       = false
      !!MdsSP01.BDist.active      = false
      !!MdsSP01.BThro.active      = false
      !!MdsSP01.Select.active     = false
      !!MdsSP01.Height.active     = false
      -- !!MdsSP01.Case.active       = false
      -- !!MdsSP01.CaseDia.active    = false
      -- !!MdsSP01.Squa.active       = false
      !!MdsSP01.SetDefault.active = false
      !!MdsSP01.SetSteel.active   = false
      !!MdsSP01.Align.active      = false
    else

-- activate dist/thro buttons if SP01

      if(!Name.Dbref().Stype.eq('SP01') and !Name.Dbref().:MDSGuideRef.unset()) then
         !!MdsSP01.Dist.active       = true
         !!MdsSP01.BDist.active      = true
         !!MdsSP01.BThro.active      = true
         !!MdsSP01.Select.active     = true
         !!MdsSP01.Align.active      = false
         !!MdsSP01.Store[1]          = !!MdsSP01.Dist.Val
         !!MdsDistance(!!MdsSp01)

      else
         !!MdsSP01.Dist.active       = false
         !!MdsSP01.BDist.active      = false
         !!MdsSP01.BThro.active      = false
         !!MdsSP01.Select.active     = false
         !!MdsSP01.Nudge.Active      = false
         !!MdsSP01.Align.active      = true
         -- If :MDSGuideRef is not a pedestal then deactivate the align
         if !Name.dbref().:MDSGuideRef.unset().not() then
           if !Name.dbref().:MDSGuideRef.Styp inset ('AT01','AT02','AT03','AT04','AT05','AT06','AT07','AT08','AT09') then
             !!MdsSP01.Align.active      = false
           endif
         endif
      endif

    -- Set callback on cancel button and set mode member of support object
      !!MdsSP01.Cancel.callback = |Call !!MdsRestoreShoe(!!MdsSP01)|
      !Support.Modify = true
      !!MdsSP01.Datum.Active = false
      -- !!MdsSP01.Nudge.Val   = 0

    -- Store Data in support object
      !Support.Type     = ( :MDSSuppType of $!name )
      !Support.Position = true

      -- Store Atta reference's in object
      !Support.Atta.append(!Name.dbref())

      !Support.Datum  = !Name.dbref()

      -- Get bedplate references if set
      var !BPRef1 :MDSBpref1
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
        !!MdsSP01.StruBpref.clear()
        !!MdsSP01.StruBpref.append(!Name.dbref())
        !!MdsSP01.StruBpref.append(!Bpref1.dbref())
        -- Store original ref
        !!MdsSP01.Storebpref.clear()
        !String = !Bpref1.dbref()
        !!MdsSP01.Storebpref.append(|:MDSBpref1 $!String|)
      endif

      -- Set Form Gadgets
      !!MdsSP01.Name.Val = !Name

      !!MdsAddAll('$!TextName')

    endif

  -- Store support object in form
    !!MdsSP01.Support = !Support

    if (!Modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

      VAR !POS POS WRT WORLD
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    -- Set Length and Clearance gadgets

      !Bore = pa bore

      !!MdsGetProp(!!MdsSP01.Height,!!MdsSP01.Height,'HEIG',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP01.Case,!!MdsSP01.Case,'CHEI',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP01.CaseDia,!!MdsSP01.CaseDia,'CDIA',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP01.Squa,!!MdsSP01.Squa,'SQUA',!Bore,!Support.Type)



    -- Set buttons
      !!MdsSP01.SetDefault.Active = true

    -- Store pos.ori and despar incase user cancel form
      !!MdsSP01.support.oldposition = POS WRT /*
      !!MdsSP01.support.oldorientation = ORI WRT /*
      !!MdsSP01.support.olddespars = despar
      !!MdsSP01.support.oldspref = !!CE.spref

    endif


  -- Redefine standard support name on form title
    !Index = !!MdsSpring.Standard.Rtext.findfirst('SP01')
    !Text  = !!MdsSpring.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsSpring,'SPRING')
        !Index = !!MdsSpring.Standard.Rtext.findfirst('SP01')
        !Text  = !!MdsSpring.Standard.Dtext[!Index]
      endhandle
    !Title = 'Spring'
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsSP01.Support.Replace = !FormName

    call !!MdsSetFormName(!!MdsSP01, '$!Title', '$!FormName')

  -- If modify put members into repre member of form

  if (!Modify.upcase() eq 'MODIFY')then
    do !addrepre values !!MdsSP01.support.atta
      !!CE = !addrepre
      skip if (!!CE.Name.match('SREF').gt(0))
--      skip if (match(Name,'SREF')gt 0)
      !Colour = !!KFindDrawColour(!!CE)
      !BranName = !!CE.owner.string()
      !!MdsSP01.Repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
      -- Add to model at level set by !!MdsOptions.LevChange value
    Call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
      !ColourList = ARRAY()
      !ColourList.append(!!CE.Name.dbref())
      Call !!KEnhanceList(!ColourList)
    enddo
  endif

  -- Show Form
    !!KShowForm(!!MdsSP01)


-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiSP01.pml
