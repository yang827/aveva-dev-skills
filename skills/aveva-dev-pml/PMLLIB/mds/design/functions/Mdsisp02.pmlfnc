--
-- File:		MdsiSP02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 26 May 1998
--
--
-- Description:
-- Initialisation for form SP02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!MdsiSP02(!Modify is STRING, !TextName is String,!Alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!MdsSp02.shown() then
    !!Alert.Error('Unable to show form as it is already displayed')
    return
  endif


-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

  -- Initialise Variables
    !Name = '/' & !TextName

  -- Initialise Standard gadgets
    !!MdsSP02.Datum.Active = true
    !!MdsSP02.Cancel.Active = true
    !!MdsSp02.connect.active = false
    !!MdsSp02.modify.active = false
    !!MdsSp02.forcecon.active = false
    !!MdsSp02.disconn.active = false

  -- Create Support object
    !Support = object MdsSUPPORT()
    !Support.Position  = false
    !Support.Mirror    = false
    !Support.RotateCur = false
    !Support.HandedCur = false
    !Support.Rotated   = 0
    !Support.BPNum     = 1
    !Support.Alias     = !Alias

    if (!Modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
      !!MdsSP02.Cancel.callback = |Call !!MdsCancelSupp(!!MdsSP02)|
      !Support.Modify = false

    -- Initialise variables for new supports
      !Support.Replace = !!MdsSpring.Replacement
      !Support.Type    = !!MdsSpring.standard.selection('Rtext')
      !StruName        = !!MdsSpring.Name.Val

    -- Set Form member to the slip unit selected, in order to find out the stype
      !!MdsSP02.Stype = !!MdsSpring.Standard.selection('DTEXT')

    -- Set Paragraph gadget on form
      !!MdsSP02.Name.Val = !StruName

    -- Set buttons

      !!MdsSP02.Dist.Val    = 0
      !!MdsSP02.Height.Val  = 0
      !!MdsSP02.Case.Val    = 0
      !!MdsSP02.CaseDia.Val = 0
      !!MdsSP02.Rod.Val    = 0
      !!MdsSP02.TopRod.Val    = 0
      -- !!MdsSP02.Nudge.Val   = 0

      !!MdsSpring.Hide()

      !!MdsSP02.Dist.active       = false
      !!MdsSP02.BDist.active      = false
      !!MdsSP02.BThro.active      = false
      !!MdsSP02.Select.active     = false
      !!MdsSP02.Height.active     = false
      !!MdsSP02.SetDefault.active = false
      !!MdsSP02.SetSteel.active   = false
      !!MdsSP02.Align.active      = false
    else

-- activate dist/thro buttons if SP02

      if(!Name.Dbref().Stype.eq('SP02') and !Name.Dbref().:MDSGuideRef.unset()) then
         !!MdsSP02.Dist.active       = true
         !!MdsSP02.BDist.active      = true
         !!MdsSP02.BThro.active      = true
         !!MdsSP02.Select.active     = true
         !!MdsSP02.Nudge.Active      = true
         !!MdsSP02.Align.active      = false
         !!MdsSP02.Store[1]          = !!MdsSP02.Dist.Val
      else
         !!MdsSP02.Dist.active       = false
         !!MdsSP02.BDist.active      = false
         !!MdsSP02.BThro.active      = false
         !!MdsSP02.Select.active     = false
         !!MdsSP02.Nudge.Active      = false
         !!MdsSP02.Align.active      = true
      endif

    -- Set callback on cancel button and set mode member of support object
      !!MdsSP02.Cancel.callback = |Call !!MdsRestoreShoe(!!MdsSP02)|
      !Support.Modify = true
      !!MdsSP02.Datum.Active = false
      -- !!MdsSP02.Nudge.Val   = 0

    -- Store Data in support object
      !Support.Type     = ( :MDSSuppType of $!name )
      !Support.Position = true

      -- Store Atta reference's in object
      !Support.Atta.append(!Name.dbref())

      !Support.Datum  = !Name.dbref()

      -- Get bedplate references if set
      var !BPRef1 :MDSBpref1
      if (!!CE.:MDSBpref1.badref().not()) then
        !Support.BedPlate1 = !BPRef1.dbref()
        !!MdsSP02.StruBpref.clear()
        !!MdsSP02.StruBpref.append(!Name.dbref())
        !!MdsSP02.StruBpref.append(!Bpref1.dbref())
        -- Store original ref
        !!MdsSP02.Storebpref.clear()
        !String = !Bpref1.dbref()
        !!MdsSP02.Storebpref.append(|:MDSBpref1 $!String|)
      endif

      -- Set Form Gadgets
      !!MdsSP02.Name.Val = !Name

      !!MdsAddAll('$!TextName')

    endif

  -- Store support object in form
    !!MdsSP02.Support = !Support

    if (!Modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

      VAR !POS POS WRT WORLD
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

    -- Set Length and Clearance gadgets

      !Bore = pa bore

      !!MdsGetProp(!!MdsSP02.Height,!!MdsSP02.Height,'HEIG',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP02.Case,!!MdsSP02.Case,'CHEI',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP02.CaseDia,!!MdsSP02.CaseDia,'CDIA',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP02.Rod,!!MdsSP02.Rod,'RODD',!Bore,!Support.Type)
      !!MdsGetProp(!!MdsSP02.TopRod,!!MdsSP02.TopRod,'RODL',!Bore,!Support.Type)



    -- Set buttons
      !!MdsSP02.SetDefault.Active = true

    -- Store pos.ori and despar incase user cancel form
      !!MdsSP02.support.oldposition = POS WRT /*
      !!MdsSP02.support.oldorientation = ORI WRT /*
      !!MdsSP02.support.olddespars = despar
      !!MdsSP02.support.oldspref = !!CE.spref

    endif


  -- Redefine standard support name on form title
    !Index = !!MdsSpring.Standard.Rtext.findfirst('SP02')
    !Text  = !!MdsSpring.Standard.Dtext[!Index]
      handle (61,567) (61,615)
        !!MdsPopulate(!!MdsSpring,'SPRING')
        !Index = !!MdsSpring.Standard.Rtext.findfirst('SP02')
        !Text  = !!MdsSpring.Standard.Dtext[!Index]
      endhandle
    !Title = 'Spring'
    !SuppNumber = before(!Text, '-')
    !FormName   = !SuppNumber.trim()
    !!MdsSP02.Support.Replace = !FormName

    call !!MdsSetFormName(!!MdsSP02, '$!Title', '$!FormName')

  -- If modify put members into repre member of form

  if (!Modify.upcase() eq 'MODIFY')then
    do !addrepre values !!MdsSP02.support.atta
      !!CE = !addrepre
      skip if (!!CE.Name.match('SREF').gt(0))
--      skip if (match(Name,'SREF')gt 0)
      !Colour = !!KFindDrawColour(!!CE)
      !BranName = !!CE.owner.string()
      !!MdsSP02.Repre.append('!!MdsRemAdd(|$!BranName|,$!Colour)')
      -- Add to model at level set by !!MdsOptions.LevChange value
    Call !!KRepreLevel(!!CE, 'PIPE',!!MdsOptions.LevChange, $!Colour)
      !ColourList = ARRAY()
      !ColourList.append(!!CE.Name.dbref())
      Call !!KEnhanceList(!ColourList)
    enddo
  endif

  -- Show Form
    !!KShowForm(!!MdsSP02)


-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file MdsiSP02.pml
