--------------------------------------------------------------------------------
--
-- File:    Mdsisp03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Mon 1 st June 1998
--
--
-- Description:
-- Initialisation for form SP03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsisp03(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsSP03.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName

  -- Initialise Standard gadgets
  !!mdsSP03.datum.active = true
  !!mdsSP03.cancel.active = true
  !!mdsSP03.connect.active = false
  !!mdsSP03.modify.active = false
  !!mdsSP03.forcecon.active = false
  !!mdsSP03.disconn.active = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.mirror    = false
  !support.position  = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then
    -- CREATE MODE for a SP03* Constant Spring Hanger

    -- Set callback on cancel button and set mode member of support object
    !!mdsSP03.cancel.callback = |Call !!mdsCancelSupp(!!mdsSP03)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsSpring.replacement
    !support.type    = !!mdsSpring.standard.selection('Rtext')
    !struName        = !!mdsSpring.name.val

    -- Set Form member to the spring selected, in order to find out the stype
    !!mdsSP03.stype = !!mdsSpring.standard.selection('DTEXT') & !!mdsSP03.type.selection()

    -- Set Paragraph gadget on form
    !!mdsSP03.name.val = !struName

    -- POPULATE option gadget for types available.
    -- The vendor number can be obtained from the default file
    --------------------
    --<wd>aug2006<mds12> -- Determine the SP03* MDS12 Default Values from the MDS12 Defaults PARAGON Database

    --!vendorA = !!mdsParSp03a[50].vendor
    --!vendorB = !!mdsParSp03b[50].vendor
    --!vendorC = !!mdsParSp03c[50].vendor
    --!vendorD = !!mdsParSp03d[50].vendor
    --!vendorE = !!mdsParSp03e[50].vendor
    --!vendorF = !!mdsParSp03f[50].vendor
    --!vendorG = !!mdsParSp03g[50].vendor

    -- Initialise the SP03* ARRAY Suffix Values
    !sparray = ARRAY()
    !sparray.append('A')
    !sparray.append('B')
    !sparray.append('C')
    !sparray.append('D')
    !sparray.append('E')
    !sparray.append('F')
    !sparray.append('G')

    -- Determine the VENDOR Code for ALL Sizes of the SP03* Constant Spring Hangers
    -- at 50 Bore Size as done previously at MDS11.6, as shown above but commented out!
    !sp03dtex = ARRAY()
    !sp03rtex = ARRAY()
    do !val values !sparray
      !sp03typ         = 'SP03' & !val.upcase()
      !$!<sp03typ>     = object MDSREADPARSDATA()
      !$!<sp03typ>defs = !$!<sp03typ>.mdsdefsdata(!sp03typ, 50)

      -- Check the MDS12 MDS Paragon Defaults are VALID (TRUE or FALSE)
      if (!$!<sp03typ>defs) then
        !vendor$!val = !$!<sp03typ>.vendor
        !vendortype  = !vendor$!val
        !sp03dtex.append('$!vendortype ($!<val>)')
        !sp03rtex.append('$!<val>')

      else
        -- SILENTLY Skip and DO NOT Load the FAILED SP03* Type into the FORM !!mdsSP03.type list GADGET
        skip

      endif

    enddo

    -- DO NOT SHOW the FORM if there are NO VALID SP03* MDS Defaults in the MDS Paragon Database
    if ((!sp03dtex.empty()) or (!sp03dtex.unset())) then
      !!alert.error('NO ACTIVE or VALID SP03* MDS Defaults available. Please contact your MDS administrator.')
      golabel /exit
    endif

    -- Load the FORM list gadget if the variable "!dtext" is NOT EMPTY.
    --!types = '$!vendorA (A)\$!vendorB (B)\$!vendorC (C)\$!vendorD (D)\$!vendorE (E)\$!vendorF (F)\$!vendorG (G)'
    --!type  = 'A B C D E F G'
    --!dtext = !types.split('\')
    --!rtext = !type.split()
    !dtext = !sp03dtex
    !rtext = !sp03rtex
    --<wd>aug2006<mds12>
    --------------------
    !!mdsSP03.type.dtext = !dtext
    !!mdsSP03.type.rtext = !rtext


    -- Set buttons
    !!mdsSP03.dist.val        = 0
    !!mdsSP03.height.val      = 0
    !!mdsSP03.caselen.val     = 0
    !!mdsSP03.caseDia.val     = 0
    !!mdsSP03.houwid.val      = 0
    !!mdsSP03.houThk.val      = 0
    !!mdsSP03.houdep.val      = 0
    !!mdsSP03.houLen.val      = 0
    !!mdsSP03.centreL.val     = 0
    !!mdsSP03.arm.val         = 0
    !!mdsSP03.angle.val       = 0
    -- !!mdsSP03.nudge.val       = 0

    !!mdsSpring.hide()

    !!mdsSP03.dist.active       = false
    !!mdsSP03.bDist.active      = false
    !!mdsSP03.bThro.active      = false
    !!mdsSP03.select.active     = false
    !!mdsSP03.height.active     = false
    --<RM 09/09/08> -- uncommented these lines because the gadgets they represent where available to modify
    -- prior to the datum atta being created and therefore caused problems
    !!mdsSP03.caselen.active    = false
    !!mdsSP03.caseDia.active    = false
    !!mdsSP03.houwid.active     = false
    !!mdsSP03.houThk.active     = false
    !!mdsSP03.houdep.active     = false
    !!mdsSP03.houLen.active     = false
    !!mdsSP03.centreL.active    = false
    !!mdsSP03.arm.active        = false
    !!mdsSP03.angle.active      = false
    --<RM 09/09/08> -- end of fix
    !!mdsSP03.setDefault.active = false
    !!mdsSP03.setsteel.active   = false
    !!mdsSP03.align.active      = false
    !!mdsSP03.flip.active       = True
    !!mdsSP03.rotate.active     = True

  else
    -- MODIFY MODE for a SP03* Constant Spring Hanger

    -- set type of SP03
    !optionType = !name.dbref().stype.after('SP03').substring(1,1)

    --> Modified - <wd> - 15sep1998
    !support.datum  = !name.dbref()
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentUnits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    --> Modified -<wd>-23sep1998
    --xxx      !!mdsSP03.type.select('RTEXT',!optionType)
    --xxx      handle ANY

    --------------------
    --<wd>aug2006<mds12> -- Determine the SP03* MDS12 Default Values from the MDS12 Defaults PARAGON Database


    -- In case list has been restricted
    --!vendorA = !!mdsParSp03a[50].vendor
    --!vendorB = !!mdsParSp03b[50].vendor
    --!vendorC = !!mdsParSp03c[50].vendor
    --!vendorD = !!mdsParSp03d[50].vendor
    --!vendorE = !!mdsParSp03e[50].vendor
    --!vendorF = !!mdsParSp03f[50].vendor
    --!vendorG = !!mdsParSp03g[50].vendor

    -- Initialise the SP03* ARRAY Suffix Values
    !sparray = ARRAY()
    !sparray.append('A')
    !sparray.append('B')
    !sparray.append('C')
    !sparray.append('D')
    !sparray.append('E')
    !sparray.append('F')
    !sparray.append('G')

    -- Determine the VENDOR Code for ALL Sizes of the SP03* Constant Spring Hangers
    -- at 50 Bore Size as done previously at MDS11.6, as shown above but commented out!
    !sp03dtex = ARRAY()
    !sp03rtex = ARRAY()
    do !val values !sparray
      !sp03typ         = 'SP03' & !val.upcase()
      !$!<sp03typ>     = object MDSREADPARSDATA()
      !$!<sp03typ>defs = !$!<sp03typ>.mdsdefsdata(!sp03typ, 50)

      -- Check the MDS12 MDS Paragon Defaults are VALID (TRUE or FALSE)
      if (!$!<sp03typ>defs) then
        !vendor$!val = !$!<sp03typ>.vendor
        !vendortype  = !vendor$!val
        !sp03dtex.append('$!vendortype ($!<val>)')
        !sp03rtex.append('$!<val>')

      else
        -- SILENTLY Skip and DO NOT Load the FAILED SP03* Type into the FORM !!mdsSP03.type list GADGET
        skip

      endif
    enddo

    -- DO NOT SHOW the FORM if there are NO VALID SP03* MDS Defaults in the MDS Paragon Database
    if ((!sp03dtex.empty()) or (!sp03dtex.unset())) then
      !!alert.error('NO ACTIVE or VALID SP03* MDS Defaults available. Please contact your MDS administrator.')
      golabel /exit
    endif

    -- Load the FORM list gadget if the variable "!dtext" is NOT EMPTY.
    --!types = '$!vendorA (A)\$!vendorB (B)\$!vendorC (C)\$!vendorD (D)\$!vendorE(E)\$!vendorF (F)\$!vendorG (G)'
    --!type  = 'A B C D E F G'
    --!dtext = !types.split('\')
    --!rtext = !type.split()
    !dtext = !sp03dtex
    !rtext = !sp03rtex
    --<wd>aug2006<mds12>
    --------------------

    !!mdsSP03.type.dtext = !dtext
    !!mdsSP03.type.rtext = !rtext
    !!mdsSP03.type.select('RTEXT',!optionType)
    --xxx      endhandle
    --< Modified -<wd>-23sep1998

    -- activate dist/thro buttons if SP03
    if(!name.dbref().:MDSSuppType inset('SP03') and !name.dbref().:MDSGuideRef.unset()) then
      !!mdsSP03.dist.active       = true
      !!mdsSP03.bDist.active      = true
      !!mdsSP03.bThro.active      = true
      !!mdsSP03.select.active     = true
      !!mdsSP03.nudge.active      = true
      !!mdsSP03.align.active      = false
      !!mdsSP03.store[1]          = !!mdsSP03.dist.val
      !!mdsSP03.flip.active       = True
      !!mdsSP03.rotate.active     = False
    else
$( <RM> 15/06/09 defunct code that handled the obsolete AT10 and 11 types i have left it in for reference
      !!mdsSP03.dist.active       = false
      !!mdsSP03.bDist.active      = false
      !!mdsSP03.bThro.active      = false
      !!mdsSP03.select.active     = false
      !!mdsSP03.nudge.active      = false
      !!mdsSP03.align.active      = true
      !!mdsSP03.flip.active       = False
      !!mdsSP03.rotate.active     = True

      -- Can only have E & F for Pedestals
      !validTypes = 'E F'
      !validDtext = '$!vendorE (E)\$!vendorF (F)'
      !dtext = !validDtext.split(|\|)
      !rtext = !validTypes.split()
      !!mdsSP03.type.dtext = !dtext
      !!mdsSP03.type.rtext = !rtext
      !!mdsSP03.type.select('rtext',!ctype)
      handle any
        -- in case not E or F
      endhandle
$)
    endif

    -------------------------------------
    --<GE> 12/02/07 Fix for Defect: 10208
    !!mdsSP03.viewflip.active = false
    --<GE> 12/02/07
    -------------------------------------

    -- Set callback on cancel button and set mode member of support object
    !!mdsSP03.cancel.callback = |Call !!mdsRestoreShoe(!!mdsSP03)|
    !support.modify = true
    !!mdsSP03.datum.active = false
    -- !!mdsSP03.nudge.val   = 0

    -- Get Specific data to sp03 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
      !!mdsSP03.flips = TRUE
    else
      !support.mirror = FALSE
      !!mdsSP03.flips = FALSE
    endif

    -- Store Data in support object
    !support.type     = ( !name.dbref().stype )
    !support.type     = !support.type.substring(1,5)
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpRef1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpRef1.dbref()
      !!mdsSP03.struBpref.clear()
      !!mdsSP03.struBpref.append(!name.dbref())
      !!mdsSP03.struBpref.append(!bpRef1.dbref())
      -- Store original ref
      !!mdsSP03.storebpref.clear()
      !string = !bpRef1.dbref()
      !!mdsSP03.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsSP03.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsSP03.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pos POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsSP03.height,!!mdsSP03.height,'HEIG',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.caselen,!!mdsSP03.caselen,'CLEN',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.caseDia,!!mdsSP03.caseDia,'CDIA',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.houwid,!!mdsSP03.houwid,'HWID',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.houThk,!!mdsSP03.houThk,'HTHK',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.houdep,!!mdsSP03.houdep,'HDEP',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.houLen,!!mdsSP03.houLen,'HLEN',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.centreL,!!mdsSP03.centreL,'CENL',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.arm,!!mdsSP03.arm,'ARM',!bore,!support.type)
    !!mdsGetProp(!!mdsSP03.angle,!!mdsSP03.angle,'ANG',!bore,!support.type)


    -- Set buttons
    !!mdsSP03.setDefault.active = TRUE
    --<wd>aug2006<mds12>-- Enable the USER to RESET the SPRING to STEEL if required
    !!mdsSP03.setsteel.active = TRUE
    --<wd>aug2006<mds12>

    -- Store pos.ori and despar in case user cancels form
    !!mdsSP03.support.oldposition = POS WRT /*
    !!mdsSP03.support.oldorientation = ORI WRT /*
    !!mdsSP03.support.olddespars = despar
    !!mdsSP03.support.oldspref = !!ce.spref

  endif


  -- Redefine standard support name on form title
  !index = !!mdsSpring.standard.rtext.findfirst('SP03')
  !text  = !!mdsSpring.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsSpring,'SPRING')
    !index = !!mdsSpring.standard.rtext.findfirst('SP03')
    !text  = !!mdsSpring.standard.dtext[!index]
  endhandle
  !title = 'Spring'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsSP03.support.replace = !formName

  call !!mdsSetFormName(!!mdsSP03, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsSP03.support.atta
      !!ce = !addrepre
      skip if (!!ce.name.match('SREF').gt(0))
      --      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsSP03.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsSP03)

  --<wd>aug2006<mds12>
  label /exit
  --<wd>aug2006<mds12>

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  !!mdsCreateGeneralFromPS (!!mdsSP03, !name)

endfunction
