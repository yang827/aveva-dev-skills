--
-- File:  Mdsispecial.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Thur 11 Dec
--
--
-- Description:
-- Initialisation for the special support form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Mode (NEW or MODIFY)
--     2     R         STRING      Support name
--     3     R         STRING      Special Support Number
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsISpecial(!modify is STRING, !textName is STRING,!number is STRING)

  !uniquenames = !!mdsOptions.mdsuniquenames
  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Deactivate connection icons

  !!mdsSpecial.connect.active = false
  !!mdsSpecial.modify.active = false
  !!mdsSpecial.forcecon.active = false
  !!mdsSpecial.disconn.active = false
  !fromAtta = false

  if (!modify.upcase() eq 'MODIFY') then

    if !textName.match('/').neq(1) then
      !name = '/' + !textName
    endif

    -- !name = !textName
    !!ce = !name.dbref()
    !!mdsSpecial.name.val = !!ce.namn
    !!mdsSpecial.number.val = !!ce.:MDSSpecialNo

    -- Pick up special type from PURP of the spref of the DATUM
    !datumAtta = !name + '/DATUM'
    !purp = (purp of pspe of bran of $!datumAtta )
    if (!purp.string() eq 'PIPE') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'MULTI'
      !!mdsSpecial.cancel.active = TRUE
    elseif (!purp.string() eq 'HVAC') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'HVAC'
    elseif (!purp.string() eq 'TRAY') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'RACK'
    endif

  else
    -- Create a NEW Special Support
    --------------------------------
    -- Added - 16june1998 - wd -

    -- Check for 'unset' in name gadget of form
    if (!textName.eq('unset')) then
      !!alert.error('Please enter a Special Support name before continuing')
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Added - 16june1998 - wd - END
    ------------------------------

    -- !name = '/' + !textName
    !name = !textName
    !form = !!mdsSpecial

    -- <sk> 04/06/2012
    if (!name eq 'unset' and !number eq !!mdsOptions.specPre) then
      !!alert.error('Please enter a Special Support name before continuing')
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Check to see if the user has set a special number if the MDSSPECON exists and is set to true
    if (defined(!!mdsSpecon)) then
      if !!mdsSpecon.boolean() then
        --<wd>09aug2004
        if (!!mdsNameSpl.number.val.eq('$!!mdsOptions.specPre')) then
          --<wd>09aug2004
          !!alert.error('Please set a Special Support number before continuing')
          return
        endif
      endif
    else
      --<wd>09aug2004
      if (!!mdsNameSpl.number.val.eq('$!!mdsOptions.specPre')) then
        --<wd>09aug2004
        !!alert.error('Please set a Special Support number before continuing')
        return
      endif
    endif

    -- Initialise Standard gadgets
    -- !!mdsSpecial.nudge.val = 0
    !!mdsSpecial.datum.active = true
    !!mdsSpecial.cancel.active = true

    if (!!mdsNameSpl.type.selection() eq 'MULTI') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'MULTI'
    elseif (!!mdsNameSpl.type.selection() eq 'HVAC') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'HVAC'
    elseif (!!mdsNameSpl.type.selection() eq 'RACK') then
      -- Redefine add gadget
      !!mdsSpecial.addPipe.active = TRUE
      !!mdsSpecial.addHVAC.active = TRUE
      !!mdsSpecial.addRack.active = TRUE
      !!mdsSpecial.modAtta.active = TRUE
      !!mdsSpecial.type = 'RACK'
    endif

  endif

  -- Deactivate set bedplate reference for HVAC FANP only
  -- Removed as HVAC now requires the bedplate form

  --if (desc of /MDS/TEMPLATES eq 'Framatome Templates' and !!mdsNameSpl.type.selection() eq 'HVAC') then
  --!!mdsSpecial.bedPlate.active = FALSE
  --else
  --!!mdsSpecial.bedPlate.active = TRUE
  --endif

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button and set mode member of support object
    !!mdsSpecial.cancel.callback = |Call !!mdsCancelSupp(!!mdsSpecial)|
    !support.modify = false

    -- Initialise variables for new supports

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = TRUE
      if (!!mdsNameSpl.type.selection() eq 'HVAC') or (!!mdsNameSpl.type.selection() eq 'RACK') then
        !!alert.message('the creation of HVAC and RACK type special supports are not available when converting an existing preliminary support to a special')
        return
      endif

      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    -- Create Stru
    NEW STRU $!name
    !support.stru = !!ce
    :MDSSuppType |SPECIAL|
    :MDSSpecialNo '$!!mdsNameSpl.number'
    !support.type    = 'SPECIAL'
    :MdsFraMirror FALSE
    -- Build framework as well for the user to build the steelwork under
    NEW FRMW $!name$n/MAIN

    -- Set Paragraph gadget on form
    !!mdsSpecial.name.val = !name
    !!mdsSpecial.number.val = !number
    !!mdsSpecial.dist.val = 0
    !!mdsSpecial.p.val = ''

    -- Hide special naming form
    !!mdsNameSpl.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsSpecial.cancel.callback = |Call !!mdsRestoreForm(!!mdsSpecial)|
    !support.modify = true
    !!mdsSpecial.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'SPECIAL'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsSpecial.p.val    = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsSpecial.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsSpecial.repre.clear()
  !!mdsSpecial.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsSpecial.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsSpecial.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsSpecial.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  if (!modify.upcase() eq |MODIFY|) then

    !!ce = !!mdsSpecial.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsSpecial)

    -- Add marker text markers
    -- Store Atta reference in form
    if !uniquenames then
      !!mdsSpecial.support.atta.appendarray(!!mdsSpecial.support.referenceAtta())
    else
      do !count from 1 to 49
        !attaref = object DBREF(!name & '.' & !count)
        handle ANY
          skip
        endhandle
        !!mdsSpecial.support.atta.append(!attaref)
      enddo
    endif

    !!mdsAidText(!!mdsSpecial)

  endif

  label /CONT

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsSpecial.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsSpecial.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Set form name

  call !!mdsSetFormName(!!mdsSpecial, 'PIPE', 'SPECIAL')

  --<dw>sep2007
  -- Store bracing information
  !!mdsbracings(!!mdsSpecial)
  --<dw>sep2007
  -- Store current form information
  call !!mdsStoreSpl()

  -- Set dimensions toggle

  !!mdsSpecial.graphicalDim = false

  -- Show Form
  !!mdsSpecial.show('At',0,0)

  !!kRestoreUnits(!currentunits)

  -- Activate/Deactivate copy section form

  !unusedtest = !!mdsSpecial.copyfrasctn.active
  handle ANY
  elsehandle NONE
    if !!mdsSpecial.type.eq('MULTI') then
      !!mdsSpecial.copyfrasctn.active = TRUE
    else
      !!mdsSpecial.copyfrasctn.active = FALSE
    endif
  endhandle

  -- Turn on bedplate icon

  !!mdsSpecial.bedPlate.active = TRUE

  -- Reset the DAC global variable in case it has been left set to true

  !!mdsDacControl(false)

  !!mdsSpecial.newdat.active = !uniquenames.not()
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
