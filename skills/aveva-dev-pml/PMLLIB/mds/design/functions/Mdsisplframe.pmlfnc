--
-- File:		Mdsisplframe.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 21st April 1998
--
--
-- Description:
-- Initialisation for the special support form 'Mdssplframe'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Mode is always 'NEW'
--                                 (SPECIAL Support 'SCTNs' created from Standard
--                                  Framework Types cannot be MODIFIED in the MDS Appware)
--     2     R         STRING      Support name
--     3     R         STRING      Special Support Number
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsisplframe(!modify is string,!textname is string,!number is string)

--------------------------------------------------------------------------------
-- Check if SPECIAL Support Data exists on form '!!Mdsnamespl'
    if (!textname.eq('unset')) then
      !!alert.error('Please enter a SPECIAL Support Name before continuing')
      return
    endif

--<wd>22aug2004
-- Check to see if the user has set a SPECIAL "SPS" number if the MDSSPECON exists and is set to true
    --if (!number eq !!Mdsoptions.specpre) then
      --!!alert.error('Please set a SPECIAL Support Number before continuing')
      --return
    --endif
    if (defined(!!mdsspecon)) then
      if !!mdsspecon.boolean() then
        if (!number eq !!mdsoptions.specpre) then
          !!alert.error('Please set a Special Support number before continuing')
          return
        endif
      endif
    else
      if (!number eq !!mdsoptions.specpre) then
        !!alert.error('Please set a Special Support number before continuing')
        return
      endif
    endif
--<wd>22aug2004

--------------------------------------------------------------------------------
-- Initialise Standard gadgets
    if (!textname.match('/') eq 1) then
      !text = !textname.after('/')
    else
      !text = !textname
    endif
    !name = '/' & !text
    !!Mdssplframe.strname.val = !text
    !!Mdssplframe.strnumb.val = !number
    !!Mdssplframe.name.val    = 'unset'
    !dtext = array()
    !!Mdssplframe.list.dtext  = !dtext
    !!Mdssplframe.tmaster.val =''
--xxx    !!Mdssplframe.supportmem.clear()
--xxx    !!Mdssplframe.specialmem.clear()

--------------------------------------------------------------------------------

-- Create Support object
    !support = object MdsSUPPORT()
    !support.position  = false
    !support.mirror    = false
    !support.rotateCur = false
    !support.handedCur = false
    !support.rotated   = 0
    !support.modify    = false

--------------------------------------------------------------------------------


-- Navigate to correct area
    if (!!MdsmovetoSite('').not())then
      return
    endif

--------------------------------------------------------------------------------

!!MdsDacControl(true)

-- Create Stru
    NEW STRU $!Name
    !support.stru = !!ce
    :MDSSuppType |SPECIAL|
    :MDSSpecialNo '$!!Mdsnamespl.number'
    !support.type    = 'SPECIAL'
-- Build framework for the SPECIAL Support SCTN elements
    NEW FRMW $!name$n/MAIN

--------------------------------------------------------------------------------

-- Hide special naming form
    !!Mdsnamespl.hide()

-- Store support object in form
    !!Mdssplframe.support = !support

--------------------------------------------------------------------------------

-- Store Current representations in form for use later
    var !repre repre level
    !!Mdssplframe.repre.clear()
    !!Mdssplframe.repre.append(|call !!KRepreLevel(Nulref, '', $!Repre,0)|)

    var !repre repre level pipe
    !!Mdssplframe.repre.append(|call !!krepreLevel(nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!Mdssplframe.repre.append(|call !!krepreLevel(nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!Mdssplframe.repre.append(|call !!krepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------
!!MdsDacControl(false)

-- Show Form
    !!Mdssplframe.show('at',0,0)

  endfunction
-- End function

-- End of file Mdsisplframe.pml
