--
-- File:		Mdsispring.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsspring.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIspring()

-- Reset Gadgets
  !!MdsSpring.Name.val = 'unset'
  !!MdsSpring.Ok.active = False

--------------------
--<wd>aug2006<mds12>
-- Read defaults file to load selections
  !!MdsPopulate(!!MdsSpring,'SPRING')
--<wd>aug2006<mds12>
--------------------

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsSpring.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsSpring.view.active = false
      !!MdsSpring.name.active = false
      return
    elsehandle none
      !!MdsSpring.view.active = true
      !!MdsSpring.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsSpring)

-- Set the name gadget as the focus

  !!MdsSpring.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdsispring.pml
