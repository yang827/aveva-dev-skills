--
-- Author:		Andrew Kirkland
-- Created:		Thur 9th July 1998
--
--
-- Description:
-- Function to extract available jlines to use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        ARRAY        [Array of support verticals]
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN      [is supported connected]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIsSuppConn(!Verticals is array) is boolean

-- Initialise Variables

     !IsItConnected = FALSE
  do !Ind values !Verticals
     do !Indx values !Ind
      if(!Indx.jois.unset().not()) then
         !IsItConnected = TRUE
      endif

      if(!Indx.joie.unset().not()) then
         !IsItConnected = TRUE
      endif
     enddo
  enddo

  Return !IsItConnected

-- End function
endfunction

-- End of file Mdsissuppconn.pml
