--
-- File:  Mdsist01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form St01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsISt01(!modify is STRING, !textName is STRING,!alias is STRING)
  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsst01.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  if !alias.eq('ST09A') or !alias.eq('ST09B') or !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') or !alias.eq('ST30') or !alias.eq('ST32') then
    !!mdsst01.setHeight.active = false
  else
    !!mdsst01.setHeight.active = true
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsst01
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsst01.datum.active = true
  !!mdsst01.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  -- grey out the height setting mechanism, because the height is fixed bt the standard.
  if !alias inset('ST10A','ST10B','ST13A','ST13B') then
    !!mdsst01.setHeight.active = false
  endif

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsst01.cancel.callback = |Call !!mdsCancelSupp(!!mdsst01)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsst01.name.val = !struName

    -- Height
    !!mdsst01.height.active = false
    !!mdsst01.pHeight.active = false
    !!mdsst01.height.val = 0
    -- Overlap
    !!mdsst01.overlap.active = false
    !!mdsst01.pOverlap.active = false
    !!mdsst01.overlap.val = 0
    -- Clearance
    !!mdsst01.clearance.active = false
    !!mdsst01.pClearance.active = false
    !!mdsst01.clearance.val = 0
    -- Set buttons
    !!mdsst01.setSteel.active = false
    !!mdsst01.setDefault.active = false

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsst01.cancel.callback = |Call !!mdsRestoreShoe(!!mdsst01)|
    !support.modify = true
    !!mdsst01.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Set Form Gadgets
    !!mdsst01.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsst01.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set height and length gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsst01.height,!!mdsst01.pHeight,'HEI',!bore,!support.type)
    !!mdsGetProp(!!mdsst01.overlap,!!mdsst01.pOverlap,'OVER',!bore,!support.type)
    !!mdsGetProp(!!mdsst01.clearance,!!mdsst01.pClearance,'CLR',!bore,!support.type)

    -- Set buttons
    !!mdsst01.setSteel.active = true
    !!mdsst01.setDefault.active = true
    if (!support.type inset('AT10A','AT11A')) then
      !!mdsst01.bDist.active = false
      !!mdsst01.dist.active = false
      !!mdsst01.dist.val = 0
      !!mdsst01.bthro.active = false
      !!mdsst01.select.active = false
      !!mdsst01.nudge.active = false
      !!mdsst01.plus.active = false
      !!mdsst01.minus.active = false
      !!mdsst01.rotate.active = false
      !!mdsst01.rotan.active = false
      !!mdsst01.rotanp.active = false
    endif
    -- Store pos.ori and despar in case user cancel form
    !!mdsst01.support.oldposition = POS WRT /*
    !!mdsst01.support.oldorientation = ORI WRT /*
    !!mdsst01.support.olddespars = despar

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsst01.support.replace = !formName

  call !!mdsSetFormName(!!mdsst01, 'STOP', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsst01.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsst01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Store current form information
  call !!mdsStoreSt01()

  -- Show Form
  !!kShowForm(!!mdsst01)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
