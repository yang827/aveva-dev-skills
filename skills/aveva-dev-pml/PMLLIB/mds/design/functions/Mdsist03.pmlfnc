--
-- File:  Mdsist03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form St03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsISt03(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsSt03.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsSt03
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsSt03.datum.active = true
  !!mdsSt03.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsSt03.cancel.callback = |Call !!mdsCancelSupp(!!mdsSt03)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsSt03.name.val = !struName

    -- Height
    !!mdsSt03.height.active = false
    !!mdsSt03.pHeight.active = false
    !!mdsSt03.height.val = 0
    -- Overlap
    !!mdsSt03.overlap.active = false
    !!mdsSt03.pOverlap.active = false
    !!mdsSt03.overlap.val = 0
    -- Clearance
    !!mdsSt03.clearance.active = false
    !!mdsSt03.pClearance.active = false
    !!mdsSt03.clearance.val = 0
    -- Set buttons
    !!mdsSt03.setSteel.active = false
    !!mdsSt03.setDefault.active = false

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsSt03.cancel.callback = |Call !!mdsRestoreShoe(!!mdsSt03)|
    !support.modify = true
    !!mdsSt03.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Set Form Gadgets
    !!mdsSt03.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsSt03.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set height and length gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsSt03.height,!!mdsSt03.pHeight,'HEI',!bore,!support.type)
    !!mdsGetProp(!!mdsSt03.overlap,!!mdsSt03.pOverlap,'OVER',!bore,!support.type)
    !!mdsGetProp(!!mdsSt03.clearance,!!mdsSt03.pClearance,'CLR',!bore,!support.type)

    -- Set buttons
    !!mdsSt03.setSteel.active = true
    !!mdsSt03.setDefault.active = true
    if (!support.type inset('AT10A','AT11A')) then
      !!mdsSt03.bDist.active = false
      !!mdsSt03.dist.active = false
      !!mdsSt03.dist.val = 0
      !!mdsSt03.bthro.active = false
      !!mdsSt03.select.active = false
      !!mdsSt03.nudge.active = false
      !!mdsSt03.plus.active = false
      !!mdsSt03.minus.active = false
      !!mdsSt03.rotate.active = false
      !!mdsSt03.rotan.active = false
      !!mdsSt03.rotanp.active = false
    endif
    -- Store pos.ori and despar in case user cancel form
    !!mdsSt03.support.oldposition = POS WRT /*
    !!mdsSt03.support.oldorientation = ORI WRT /*
    !!mdsSt03.support.olddespars = despar

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GENERAL')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsSt03.support.replace = !formName

  call !!mdsSetFormName(!!mdsSt03, 'STOP', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsSt03.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsSt03.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Store current form information
  Call !!mdsStoreSt03()

  -- Show Form
  !!kShowForm(!!mdsSt03)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
