--
-- File:  Mdsist08.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Thu 12 Feb
--
--
-- Description:
-- Initialisation for form St08
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsISt08(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsSt08.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsSt08
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsSt08.datum.active = true
  !!mdsSt08.cancel.active = true
  !!mdsSt08.rotAtt.active = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsSt08.cancel.callback = |Call !!mdsCancelSupp(!!mdsSt08)|
    !support.modify = false

    -- Initialise variables for new supports
    if !support.alias.eq('AN05') then
      !support.replace = !!mdsAnchor.replacement
      !support.type    = !!mdsAnchor.standard.selection('Rtext')
      !struName        = !!mdsAnchor.name.val
    else
      !support.replace = !!mdsGuide.replacement
      !support.type    = !!mdsGuide.standard.selection('Rtext')
      !struName        = !!mdsGuide.name.val
    endif

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsSt08.name.val = !struName

    -- Height
    !!mdsSt08.height.active = false
    !!mdsSt08.pHeight.active = false
    !!mdsSt08.height.val = 0
    -- Overlap
    !!mdsSt08.overlap.active = false
    !!mdsSt08.pOverlap.active = false
    !!mdsSt08.overlap.val = 0
    -- Set buttons
    !!mdsSt08.setDefault.active = false

    if !support.alias.eq('ST08') or !support.alias.eq('ST14') or !support.alias.eq('ST15') or !support.alias.eq('ST16') then
      !!mdsGuide.hide()
    else
      !!mdsAnchor.hide()
    endif

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsSt08.cancel.callback = |Call !!mdsRestoreShoe(!!mdsSt08)|
    !support.modify = true
    !!mdsSt08.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()
    !!mdsSt08.rotAtt.active = true

    -- Set Form Gadgets
    !!mdsSt08.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsSt08.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set height and length gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsSt08.height,!!mdsSt08.pHeight,'SWID',!bore,!support.type)
    !!mdsGetProp(!!mdsSt08.overlap,!!mdsSt08.pOverlap,'STHK',!bore,!support.type)

    -- Set buttons
    !!mdsSt08.setDefault.active = true
    -- Store pos.ori and despar in case user cancel form
    !!mdsSt08.support.oldposition = POS WRT /*
    !!mdsSt08.support.oldorientation = ORI WRT /*
    !!mdsSt08.support.olddespars = despar

  endif

  LABEL /CONT

  -- Redefine standard support name on form title

  if !alias.eq('ST08') or !alias.eq('ST14') or !alias.eq('ST15') or !alias.eq('ST16')then
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.alias')
    !text  = !!mdsGuide.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsGuide,'GENERAL')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.alias')
      !text  = !!mdsGuide.standard.dtext[!index]
    endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
  else
    !index = !!mdsAnchor.standard.rtext.findfirst('$!support.alias')
    !text  = !!mdsAnchor.standard.dtext[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsAnchor,'ANCHOR')
      !index = !!mdsAnchor.standard.rtext.findfirst('$!support.alias')
      !text  = !!mdsAnchor.standard.dtext[!index]
    endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
  endif

  !!mdsSt08.support.replace = !formName

  call !!mdsSetFormName(!!mdsSt08, 'STOP', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsSt08.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsSt08.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Set paragraph gadget texts

  if !!mdsSt08.support.alias.eq('ST14') OR !!mdsSt08.support.alias.eq('ST15') OR !!mdsSt08.support.alias.eq('ST16')then
    !!mdsSt08.pHeight.val = 'Height'
    !!mdsSt08.pOverlap.val = 'Clearance'
  else
    !!mdsSt08.pHeight.val = 'Width'
    !!mdsSt08.pOverlap.val = 'Thickness'
  endif
  if !support.alias.eq('ST14') then
    !!mdsSt08.rotAtt.active = true
  else
    !!mdsSt08.rotAtt.active = false
  endif

  -- Store current form information
  Call !!mdsStoreSt08()

  -- Show Form
  !!kShowForm(!!mdsSt08)

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
