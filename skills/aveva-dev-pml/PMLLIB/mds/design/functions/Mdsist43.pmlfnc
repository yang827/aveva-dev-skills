--
-- File: Mdsist43.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author:D.whiteside
-- Created:6 November 2008
--
--
-- Description:
-- Initialisation for form ST43  (dun1052)
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIST43(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsST43.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsST43
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsST43.datum.active  = true
  !!mdsST43.cancel.active = true
  !!mdsST43.rotAtt.active = true


  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bpNum     = 1
  !support.alias     = !alias

  !!mdsST43.shoelen.active = false
  !!mdsST43.shoeadj.active = false

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsST43.cancel.callback = |Call !!mdscancelSupp(!!mdsST43)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struname        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsST43.name.val = !struname

    -- Height
    !!mdsST43.height.active     = false
    !!mdsST43.pheight.active    = false
    !!mdsST43.height.val        = 0
    -- Clearance
    !!mdsST43.clearance.active  = false
    !!mdsST43.pclearance.active = false
    !!mdsST43.clearance.val     = 0
    -- bolted length
    !!mdsST43.boltedlen.active  = false
    !!mdsST43.pboltedlen.active = false
    !!mdsST43.boltedlen.val     = 0
    -- offset
    !!mdsST43.offset.active     = false
    !!mdsST43.poffset.active    = false
    !!mdsST43.offset.val        = 0
    -- Shoe/Stop length
    !!mdsST43.shoelen.val       = |Adjust Shoe where Stop = 0.00|
    !!mdsST43.shoeadj.val       = 0

    -- Set buttons
    -- !!mdsST43.setDefault.active = false
    -- !!mdsST43.adjust.active = false

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsST43.cancel.callback = |Call !!mdsRestoreShoe(!!mdsST43)|
    !support.modify = true
    !!mdsST43.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSupptype of $!name )
    !support.position = true
    if !support.type inset ('ST43','ST44') then
      -- Shoe/Stop length
      !!mdsST43.shoelen.active = true
      !!mdsST43.shoeadj.active = true
    endif

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.paDir  = Pa Dir wrt world
    !support.plDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpRef1 :MDSBpref1
    if (!!ce.:mDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpRef1.dbref()
      !!mdsST43.struBpref.clear()
      !!mdsST43.struBpref.append(!name.dbref())
      !!mdsST43.struBpref.append(!bpRef1.dbref())
      -- Store original ref
      !!mdsST43.storebpref.clear()
      !string = !bpRef1.dbref()
      !!mdsST43.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsST43.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsST43.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pos pos WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    -- Set Height and Clearance gadgets

    !bore = pa bore
    !!mdsGetProp(!!mdsST43.clearance,!!mdsST43.pclearance,'CLR',!bore,!support.type)
    !!mdsGetProp(!!mdsST43.height,!!mdsST43.pheight,'STLH',!bore,!support.type)
    if !support.type inset ('ST43','ST44','ST57','ST58') then
      --<dw>dec2008 dun1052 bolted length not applicable
    else
      !!mdsGetProp(!!mdsST43.boltedlen,!!mdsST43.pboltedlen,'WID',!bore,!support.type)
    endif
    !!mdsGetProp(!!mdsST43.offset,!!mdsST43.poffset,'OFFS',!bore,!support.type)

    -- Set buttons
    -- !!mdsST43.setDefault.active = false
    -- !!mdsST43.adjust.active     = false

    -- Store pos, ori and despar in case user cancels form
    !!mdsST43.support.oldposition = POS WRT /*
    !!mdsST43.support.oldorientation = ORI WRT /*
    !!mdsST43.support.olddespars = despar

  endif


  -- Redefine standard support name on form title

  !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  if (!support.type eq 'GT85') then
    !title = 'GUIDE'
  else
    !title = 'STOP'
  endif
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsST43.support.replace = !formName

  call !!mdsSetFormName(!!mdsST43, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsST43.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawcolour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsST43.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kenhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kshowForm(!!mdsST43)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif
  -- End function
endfunction
