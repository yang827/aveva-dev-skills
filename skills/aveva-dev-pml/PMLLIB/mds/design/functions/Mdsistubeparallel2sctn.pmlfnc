--
--
-- Description:
-- Returns true if tube and steel section are parallel and false if not.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        dbref         branch or branch member
--     2     R        dbref         steel section (SCTN)
--
-- Return:
--    [Data Type]   [Description]
--     Boolean        true if tube and steel section are parallel and false if not.
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsistubeparallel2sctn(!comp is DBREF, !sctn is DBREF) is Boolean
-- Calculating the angle between the beam and the tube.
    !angle = !!Mdsgetangletubesctn(!comp, !sctn)
    !diff = !angle.real() - 180
    !diff = !diff.abs()
-- dtf >> Mod  angle nearly 0 or 180 assume parallel
    --if(!angle.real() neq 0 and !angle.real().abs() neq 180 ) then
      -- beam is in an angle with the pipe
      --return false
    --else
      -- beam is parallel to the pipe
      --return true
    --endif
    if (!angle.real().gt(-.1) and !angle.real().lt(.1) or !angle.real().gt(179.9) and !angle.real().lt(180.1))   then
      -- beam is parallel to the pipe
      --q var !angle
      return TRUE
    else
      -- beam is in an angle with the pipe
      return FALSE
    endif
-- dtf << End of Mod


-- End function
endfunction

-- End of file Mdsistubeparallel2sctn.pml
