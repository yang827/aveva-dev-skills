--
-- File:		Mdsistubeslopeparallel2sctn.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		R.Martin
-- Created:		Thu June 29 2006
--
--
-- Description:
-- Returns true if tube slope and steel section are parallel and false if not.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        dbref         branch or branch member
--     2     R        dbref         steel section (SCTN)
--
-- Return:
--    [Data Type]   [Description]
--     Boolean        true if tube and steel section are parallel and false if not.
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsistubeslopeparallel2sctn(!tube is DBREF, !sctn is DBREF) is BOOLEAN

  -- Check to see if sctn has been passed if not return false
  if !sctn.hardtype.neq('SCTN') or !sctn.type.eq('STWALL') then
    return FALSE
  endif

  !current = !!ce

  -- check that the sctn is not vertical
  var !sctndir zdir of $!sctn wrt /*
  !updir = u wrt /*
  !sctncheck = !sctndir.direction().dot(!updir)
  if !sctncheck.abs().geq(0.75) then
    return FALSE
  endif

  --for the tube get the plane which is normal to the pa direction of the atta
  !!ce = $!tube
  var !pos1 pa pos
  var !dir1 pa dir

  -- create a pointvector at PArrive with direction up
  !position1 = object position()
  !position1.position(!pos1)
  !direction1 = object direction()
  !direction1.direction('U')
  !direction2 = object direction(!dir1)
  !pv1 = object pointvector(!position1,!direction1)

  --offset up by 500
  !pv1 = !pv1.offset(500)

  -- set direction as parrive direction
  !pv1.direction = !direction2

  --move through parrive so the pvector is perpendicular with the tube
  !pv1 = !pv1.through(!position1)

  -- pointvector direction towards pa, this gives us a basis for a checking plane
  !pv1 = !pv1.towards(!position1)
    handle ANY
      return FALSE
    endhandle
  -- now move through pa so we can establish the plane at parrive of the atta
  !pv1 = !pv1.through(!position1)
  !tubeplane = object plane()
  !tubeplane = !pv1.plane()

  -- now the section, same method as above but with poss and pose
  !!ce = $!sctn
  var !pos1 poss
  var !dir1 dir from poss to pose wrt /*

  !position1 = object position()
  !position1.position(!pos1)
  !direction1 = object direction()
  !direction1.direction('U')
  !direction2 = object direction(!dir1)
  !pv1 = object pointvector(!position1,!direction1)
  !pv1 = !pv1.offset(500)

  !pv1.direction = !direction2
  !pv1 = !pv1.through(!position1)

  !pv1 = !pv1.towards(!position1)
  !pv1 = !pv1.through(!position1)
  !sctnplane = object plane()
  !sctnplane = !pv1.plane()

  !!ce = !current

  -- run the plane intersection method to see if the planes intersect
  -- if not then they are parallel and we return true
  !INTERSECTION = object line()
  !INTERSECTION = !tubeplane.intersection(!sctnplane)
  handle ANY
    return TRUE
  elsehandle NONE
    -- if we do not have a true parallel plane then we do a dot product check on the plane definition directions
    -- in order to find out whether or not they are parallel in terms of tolerance RM 07/07/06

    var !pvtube dir pl of $!tube wrt /*

    !dot = !pvtube.direction().dot(!sctndir.direction())
    if !dot.real().between(0.999,1.0) then
      return TRUE
    endif
  endhandle

  return FALSE

endfunction

-- End of file Mdsistubeslopeparallel2sctn.pml
