--
-- File:  Mdsisu02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Wed 29 Apr
--
--
-- Description:
-- Initialisation for form SU02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsiSU02(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsSU02.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsSU02

  -- Initialise Standard gadgets
  !!mdsSU02.datum.active = true
  !!mdsSU02.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsSU02.cancel.callback = |Call !!mdsCancelSupp(!!mdsSU02)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsSlip.replacement
    !support.type    = !!mdsSlip.standard.selection('Rtext')
    !struName        = !!mdsSlip.name.val

    -- Set Form member to the slip unit selected, in order to find out the stype
    !!mdsSU02.stype = !!mdsSlip.standard.selection('DTEXT')

    -- Set Paragraph gadget on form
    !!mdsSU02.name.val = !struName

    -- Set buttons
    --xxx      !!mdsSU02.setDefault.active = false
    !!mdsSU02.align.active      = false
    !!mdsSlip.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsSU02.cancel.callback = |Call !!mdsRestoreShoe(!!mdsSU02)|
    !support.modify = true
    !!mdsSU02.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsSU02.struBpref.clear()
      !!mdsSU02.struBpref.append(!name.dbref())
      !!mdsSU02.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsSU02.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsSU02.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsSU02.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsSU02.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set buttons
    --xxx      !!mdsSU02.setDefault.active = true

    -- Store pos.ori and despar in case user cancel form
    !!mdsSU02.support.oldposition = POS WRT /*
    !!mdsSU02.support.oldorientation = ORI WRT /*
    !!mdsSU02.support.olddespars = despar
    !!mdsSU02.support.oldspref = !!ce.spref

  endif

  --q var !support.type

  -- Redefine standard support name on form title
  !index = !!mdsSlip.standard.rtext.findfirst(!support.type)
  !text  = !!mdsSlip.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsSlip,'SLIP')
    !index = !!mdsSlip.standard.rtext.findfirst(!support.type)
    !text  = !!mdsSlip.standard.dtext[!index]
  endhandle
  !title = 'Slip'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsSU02.support.replace = !formName

  call !!mdsSetFormName(!!mdsSU02, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsSU02.support.atta
      !!ce = !addrepre
      skip if (!!ce.name.match('SREF').gt(0))
      --      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsSU02.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsSU02)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)


  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
