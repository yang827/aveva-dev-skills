--
-- File:    Mdsiswithintube.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Wed Apr 02 2002
--
--
-- Description:
-- Returns true if the given pipe component is POSITION within the tube defined by the
-- previous pipe component (or branch PH) and the next pipe component (or branch PT) or false if not.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         The pipe component dbref to be checked
--
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN       See Description
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsisWithinTube(!comp is DBREF) is BOOLEAN

-- Let vertical pipes through this check if CPL i/f

  if !!mdsHangIf.eq('CPL') then
    var !pldir pl dir of $!comp wrt /*
      if !pldir.eq('U') or !pldir.eq('D') or !pldir.eq('Z') or !pldir.eq('-Z') then
        return TRUE
      endif
    endif

  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIn(1, '!!mdsisWithinTube($!comp is DBREF) is BOOLEAN')
    endif
  !ce = !!ce
  !!ce = !comp
  !!mdspushpin(1)
  !!mdspushpin(2)

  handle ANY
    if(defined(!!mdsDEBUG)) then
      !!mdsDEBUG.traceError('!!mdsisWithinTube($!comp is DBREF) is BOOLEAN')
    endif
     return error 1 'MdsisWithinTube function: Given component $!comp does no exist'
   endhandle

  !prevPL = 'pl of prev'
  !temp = $!prevPL dir
  handle ANY
     -- no previous component. Checking dist from PH
    !prevPL = 'ph'
   endhandle

  !nextPA = 'pa of next'
  !temp = $!nextPA dir
  handle ANY
     -- no next component. Checking dist to PT
    !nextPA = 'pt'
   endhandle
  !orderedWithNext = TRUE

  var !distToNext const dist pl to $!nextPA
   if(!distToNext.real() gt 0.99) then
   --if(!distToNext.real() gt 0.1) then
    var !dirToNext const dir pl to $!nextPA
     pin1 copy pl
     pin2 copy pin1
    -- <RM> 16/11/07 -- included wrt /* to fix a problem where the atta was within the tube but the function returned false
    --pin2 dir $!dirToNext
    pin2 dir $!dirToNext wrt /*
    -- <RM> 16/11/07 -- end of fix
     pin1 dist 100
     pin2 dist 100
     var !tolDist const dist pin1 to pin2
     if(!tolDist.real() gt 1) then
       -- given component pleave does not point to next element
       -- so its not in the normal pipe path
       !orderedWithNext = FALSE
     endif
   endif
  !orderedWithPrev = TRUE

  var !distToPrev const dist pa to $!prevPL
   if(!distToPrev.real() gt 0.1) then
    var !dirToPrev const dir pa to $!prevPL
     pin1 copy pa
     pin2 copy pin1
    -- <RM> 16/11/07 -- included wrt /* to fix a problem where the atta was within the tube but the function returned false
    --pin2 dir $!dirToPrev
    pin2 dir $!dirToPrev wrt /*
    -- <RM> 16/11/07 -- end of fix
     pin1 dist 100
     pin2 dist 100
     var !tolDist const dist pin1 to pin2
     if(!tolDist.real() gt 1) then
       -- given component pleave does not point to next element
       -- so its not in the normal pipe path
      !orderedWithPrev = FALSE
     endif
   endif
  !!ce = !ce
  !!mdspoppin(1)
  !!mdspoppin(2)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(1, '($!orderedWithNext and $!orderedWithPrev)')
    !!mdsDEBUG.traceOut(1, '!!mdsisWithinTube(!comp is DBREF) is BOOLEAN')
   endif
   return (!orderedWithNext and !orderedWithPrev)

endfunction
