--
-- File:		Mdsithroplane.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          IPLANE
--
-- Author:		I.Osborne
-- Created:		Fri May 23
--
--
-- Description:
-- initialisation for through plane form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM         Current Support Form
--     2     R         DBREF        Element to be moved
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIThroPlane(!Form is FORM, !Element is DBREF)

  -- Initialise variables
    !Datum = !Form.Support.Datum

  -- Check passed element
    if (!Element.owner.type ne |BRAN|)then
      !!CE = !datum
      handle (2,106)
        !!Alert.error('Datum support atta has not been created')
        return
      endhandle
    endif

  -- Position axis
    AXES AT CE
    var !Dir PL DIR

  -- Populate gadgets
    !!MdsThroPlane.SuppForm  = !Form
    !!MdsThroPlane.Plan.val  = !Dir
    !!MdsThroPlane.DbPos.val = !!CE.name
    !!MdsThroPlane.Position  = !!CE.pos
    !!MdsThroPlane.P.val     = ' '

    if (subs(!!CE.name ,1 ,1) eq |=|) then
      var !Fn fullname
      !!MdsThroPlane.DbPos.val = !Fn
    endif

  -- Show form
    !!KShowForm(!!MdsThroPlane)

-- End function
endfunction

-- End of file Mdsithroplane.pml
