--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdstrunn.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsItrunn()

-- Reset Gadgets
  !!MdsTrunn.Name.val = 'unset'
  !!MdsTrunn.Ok.active = FALSE

-- Read defaults file to load selections
  !!MdsPopulate(!!MdsTrunn,'TRUNN')

-- Check to see if all the STANDARDS for this type have been commented out
  !CheckVal = !!MdsTrunn.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsTrunn.view.active = FALSE
      !!MdsTrunn.name.active = FALSE
      return
    elsehandle none
      !!MdsTrunn.view.active = TRUE
      !!MdsTrunn.name.active = TRUE
    endhandle

-- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsTrunn)

-- Set the name gadget as the focus
  !!MdsTrunn.Name.SetFocus()

--xxx-- Load All Available Trunnions into Hidden Non-User Form and Gadget
--xxx-- 'Mdstrunnions.standard'
--xxx  call !!Mdsitrunnions()

-- Reset the DAC global variable incase it has been left set to true
  !!MdsDacControl(FALSE)

-- End function
endfunction

-- End of file mdsitrunn.pmlfnc
