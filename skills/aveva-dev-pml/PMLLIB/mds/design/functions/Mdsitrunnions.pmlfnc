--
-- File:		Mdsitrunnions.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 11th December 1997
--
--
-- Description:
-- Function to initialise Trunnion component types form (this is a system
-- form and is not shown to the user)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsitrunnions()

-- Clear existing list entries
    !!Mdstrunnions.standard.clear()

-- Define what support types will be loaded as defined in description file
-- Get All Available Trunnion Types for the Project as defined in the description file
-- file and then Stored in the Form Gadget '!!Mdstrunn.standard'

    !dtext = array()
    !rtext = array()
    !part  = array()

    do !index index !!Mdstrunn.standard.rtext
-- The new trunnions built as branches do not require to be loaded into the Mdstrunnions form so skip
      !test = !!Mdstrunn.standard.rtext[$!index].replace('TT','')
      if !test.real().gt(3) then
      -- if !!Mdstrunn.standard.rtext[$!index].eq('TT04') then
        skip
      endif
--xxxclock init
      !type  = !!kcollectallfor('SPCO','(matchwild(name,|*$!!Mdstrunn.standard.rtext[$!index]*|))' , /MDS )
--xxxclock read elapsed
      !block = object BLOCK('!type[!evalindex].styp')
      !styp  = !type.evaluate(!block)

      !rtext.clear()
      do !count index !styp
        !rtext[$!count] = !styp[$!count]
      enddo

      !part[$!index] = !rtext
      !dtext.appendarray(!part[$!index])

    enddo

-- Load 'Mdstrunnions.standard' List Gadget with all Available Trunnion Types
    !!Mdstrunnions.standard.clear()
    !!Mdstrunnions.standard.dtext = !dtext
    !!Mdstrunnions.standard.rtext = !dtext

-- Declare Array Variables
    !psize = array()
    !split = array()

-- Store All Trunnion Stypes found against each Pipe Size
-- in the form 'Mdstrunnions' member Arrays eg. 'Mdstrunnions.pdia10'

    do !size index !dtext
      !split         = !dtext[!size].split('-')
      !psize[$!size] = !split[4]
      if (!psize[$!size].real() eq 2) then
        !!Mdstrunnions.pdia2.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia2.unique()
      elseif (!psize[$!size].real() eq 3)  then
        !!Mdstrunnions.pdia3.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia3.unique()
      elseif (!psize[$!size].real() eq 4)  then
        !!Mdstrunnions.pdia4.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia4.unique()
      elseif (!psize[$!size].real() eq 5)  then
        !!Mdstrunnions.pdia5.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia5.unique()
      elseif (!psize[$!size].real() eq 6)  then
        !!Mdstrunnions.pdia6.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia6.unique()
      elseif (!psize[$!size].real() eq 8)  then
        !!Mdstrunnions.pdia8.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia8.unique()
      elseif (!psize[$!size].real() eq 10) then
        !!Mdstrunnions.pdia10.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia10.unique()
      elseif (!psize[$!size].real() eq 12) then
        !!Mdstrunnions.pdia12.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia12.unique()
      elseif (!psize[$!size].real() eq 14) then
        !!Mdstrunnions.pdia14.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia14.unique()
      elseif (!psize[$!size].real() eq 16) then
        !!Mdstrunnions.pdia16.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia16.unique()
      elseif (!psize[$!size].real() eq 18) then
        !!Mdstrunnions.pdia18.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia18.unique()
      elseif (!psize[$!size].real() eq 20) then
        !!Mdstrunnions.pdia20.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia20.unique()
      elseif (!psize[$!size].real() eq 22) then
        !!Mdstrunnions.pdia22.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia22.unique()
      elseif (!psize[$!size].real() eq 24) then
        !!Mdstrunnions.pdia24.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia24.unique()
      elseif (!psize[$!size].real() eq 30) then
        !!Mdstrunnions.pdia30.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia30.unique()
      elseif (!psize[$!size].real() eq 36) then
        !!Mdstrunnions.pdia36.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia36.unique()
      elseif (!psize[$!size].real() eq 42) then
        !!Mdstrunnions.pdia42.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia42.unique()
      elseif (!psize[$!size].real() eq 48) then
        !!Mdstrunnions.pdia48.append('$!dtext[$!size]')
        !!Mdstrunnions.pdia48.unique()
      endif

    enddo

-- Update Selection and Restriction List eg. 'Mdsselvt01' etc. for Vessel Frameworks
-- that are to use a selection of the Standard Trunnion Types
    !prefix = array()
    !prefix.append('VT01')
    !prefix.append('VT02')

    !!Mdsreaddefs(!!Mdstrunnvt01,!prefix)

  endfunction
-- End function

-- End of file Mdsitrunnions.pml
