--
-- File:		Mdsitrunnvt01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 11th December 1997
--
--
-- Description:
-- Function to initialise a Restricted list of Available Trunnions
-- for Vessel Framework Types 'VT01'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING        Type of Vessel Support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsitrunnvt01(!Type is STRING)
--xxx$P ** $!type** type in Mdsitrunnvt01

    !formstring = '!!Mds' & !type
    !formname   = $!formstring
    !saveref = !!ce

--------------------------------------------------------------------------------
-- Uncomment the TWO lines below if automatic UPDATES are REQUIRED
--xxx-- Reload design parameters and defaults, if files have been modified
--xxx    !!Mdsautopar()
--------------------------------------------------------------------------------

-- Clear existing list entries
    !!Mdstrunnvt01.standard.clear()
--------------------------------------------------------------------------------

-- Check we can create an atta - Temporarily
    new atta
      handle (2,614) (2,613)
        !!MdsTrunnvt01.hide()
        !!Alert.Error(!!Error.text)
        return error 1 || noalert
      elsehandle any
        !!MdsTrunnvt01.hide()
        !!alert.error('Unable to create a support ATTA in this branch')
        return error 1 || noalert
      endhandle
    SPKBRK TRUE
    !atta = !!ce

-- Gadget '!!Mdstrunnions.standard' contains list of ALL the Trunnions
-- defined in description file, and is initialised at start of MDS application
--------------------------------------------------------------------------------
-- Cycle through Trunnion list and attempt to select each type for
-- current line N.B. and only add valid attachment types into list gadget

    !dtext = ARRAY()
    !rtext = ARRAY()
    !foundSome = false

--------------------------------------------------------------------------------
-- Get the Current Pipe Size and Get the Array Name, eg: '!!Mdstrunnions.pdia12',
-- which is used to load the form gadget '!!Mdstrunnvt01.standard' from '!!Mdstrunnval()'
    !function = !!Mdstrunnval(!atta)
    if (!function eq 'false') then
      !!alert.error('Trunnions are NOT available for the Current Pipe Size')
        delete atta
      return
    else
      !list = $!function
      if (!list.empty()) then
        !!alert.error('Trunnions are NOT available for the Current Pipe Size')
        delete atta
        return
      endif
    endif

-- Need to Get Valid Stypes and Trunnion Sizes for Current Pipe Size
-- before trying to load form gadget 'Mdstrunnvt01.standard' with available
-- TRUNNIONS for Vessel Framework type 'VT01'
--------------------------------------------------------------------------------
-- Get Clients Name for the 'MDS Appware - Support Types' for TRUNNIONS ONLY from
-- the 'Create Trunnion form '!!Mdstrunn'
-- Trunnion Form Gadgets that Store a) dtext - 'MDS Appware Support Type' and
--                                  b) rtext - 'Client Name for the Support Type'
        !trunndtext = !!Mdstrunn.standard.dtext
        !trunnrtext = !!Mdstrunn.standard.rtext

        do !number index !trunnrtext
          if (!trunnrtext[!number].eq('TT01')) then
            !xpart1 = !trunndtext[!number].part(1,'-').trim()
          elseif (!trunnrtext[!number].eq('TT02')) then
            !ypart1 = !trunndtext[!number].part(1,'-').trim()
          elseif (!trunnrtext[!number].eq('TT03')) then
            !zpart1 = !trunndtext[!number].part(1,'-').trim()
          endif
        enddo

--------------------------------------------------------------------------------
--xxx$P **$!function**
-- The Array '!function' is '!!Mdstrunnions.pdia<pipesize'> determined above
-- by the code '!function = !!Mdstrunnval(!atta)'
    !array = $!function
--------------------------------------------------------------------------------
    do !index index !array
      !choice = select spec /MDS with styp '$!array[$!index]'
      handle any
        skip
      elsehandle none
--------------------------------------------------------------------------------
-- Check in selection and restriction rules for type
        skip if (!!Mdschecksel('$!array[$!index]',!type))
-- Skip past special selection
        !foundsome = true
        !rtext.append(!array[$!index])

--xxx        !dtext.append(!array[$!index])
-- Get Clients Name for the Support Type to display as the 'dtext' in the form
        !apart1 = !array[!index].part(1,'-')
        if (!apart1.eq('TT01')) then
          !part1 = !xpart1
        elseif (!apart1.eq('TT02')) then
          !part1 = !ypart1
        elseif (!apart1.eq('TT03')) then
          !part1 = !zpart1
        endif
        !part2 = !array[!index].part(2,'-')
        !part3 = !array[!index].part(3,'-')
        if (!!kgetboreunits()) then
-- Imperial bores
          !dtext.append(''& !part1 &' - Type ' & !part2 & ' - ' & !part3 & 'inch Diameter trunnion ')
        else
-- Metric Bores
          !impbore = !part3.real()
          !mmbore = !!kborelookup(!impbore,'MM')
          if (!mmbore.eq(0)) then
            !dtext.append(!array[!index])
          else
            !boremm = !mmbore.string()
            !dtext.append(''& !part1 &' - Type ' & !part2 & ' - ' & !boremm & 'mm Diameter trunnion ')
          endif
        endif

-- Ensure Metric Bore Units
--ak 8/5/98        mm bore

      endhandle
--------------------------------------------------------------------------------
    enddo

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Set the list gadget display and replacement texts with the valid Trunnion Types
    !!Mdstrunnvt01.standard.dtext = !dtext
    !!Mdstrunnvt01.standard.rtext = !rtext

    $!atta
    delete atta

    if (!foundSome.not()) then
      !!alert.error('No Support attas found in spec matching the Identified Pipe''s Nominal Bore Size')
      return error 1 || noalert
    endif

-- Edit Form title
     !!Mdstrunnvt01.formtitle = 'Trunnion Selection for Support Type - '& !formname.support.replace &' '

    $!saveref

--------------------------------------------------------------------------------
  endfunction
-- End function

-- End of file Mdsitrunnvt01.pml
