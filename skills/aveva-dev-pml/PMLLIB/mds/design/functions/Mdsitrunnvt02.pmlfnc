--
-- File:		Mdsitrunnvt02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 9th January 1998
--
--
-- Description:
-- Function to initialise a Restricted list of Available Trunnions
-- for Vessel Framework Types 'VT02'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING        Type of Vessel Support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsitrunnvt02(!Type is STRING)
--$P ** $!type** type in Mdsitrunnvt02

    !formstring = '!!Mds' & !type
    !formname   = $!formstring

    !saveref = !!ce

--------------------------------------------------------------------------------
-- Uncomment the TWO lines below if automatic UPDATES are REQUIRED
--xxx-- Reload design parameters and defaults, if files have been modified
--xxx    !!Mdsautopar()
--------------------------------------------------------------------------------

-- Clear existing list entries
    !!Mdstrunnvt01.standard.clear()
--------------------------------------------------------------------------------

-- Check we can create an atta
    new atta
    handle (2,614) (2,613)
      !!MdsTrunnVt02.hide()
      !!alert.error(!!Error.text)
      return error 1 || noalert
    elsehandle any
      !!MdsTrunnVt02.hide()
      !!alert.error('Unable to create a support ATTA in this branch')
      return error 1 || noalert
    endhandle
    SPKBRK TRUE
    !atta = !!ce

--------------------------------------------------------------------------------
-- Gadget '!!Mdstrunnions.standard' contains list of ALL the Trunnions
-- defined in description file, and is initialised at start of MDS application

--------------------------------------------------------------------------------
-- Cycle through Trunnion list and attempt to select each type for
-- current line N.B. and only add valid attachment types into list gadget

    !dtext = ARRAY()
    !rtext = ARRAY()
    !foundSome = false
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Get the Current Pipe Size and Set the Array to use to
-- load the form gadget '!!Mdstrunnvt01.standard'
    !function = !!Mdstrunnval(!atta)
    if (!function eq 'false') then
      !!alert.error('Trunnions are NOT available for the Current Pipe Size')
      return
    endif

-- Need to Get Valid Stypes and Trunnion Sizes for Current Pipe Size
-- before trying to load form gadget 'Mdstrunnvt01.standard' with available
-- TRUNNIONS for Vessel Framework type 'VT02'

--xxx$P **$!function**
    !array = $!function
    do !index index !array
      !choice = select spec /MDS with styp '$!array[$!index]'
      handle any
        skip
      elsehandle none
--------------------------------------------------------------------------------
-- Check in selection and restriction rules for type
        skip if (!!Mdschecksel('$!array[$!index]',!type))
-- Skip past special selection
        !foundsome = true
        !rtext.append(!array[$!index])
        !dtext.append(!array[$!index])
      endhandle
    enddo

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Set the list gadget display and replacement texts with the valid Trunnion Types
    !!Mdstrunnvt01.standard.dtext = !dtext
    !!Mdstrunnvt01.standard.rtext = !rtext

    $!atta
    delete atta

    if (!foundSome.not()) then
      !!alert.error('No Support attas found in spec matching this pipe''s nominal bore')
      return error 1 || noalert
    endif

-- Edit Form title
   !!Mdstrunnvt01.formtitle = 'Trunnion Selection for Support Type '& !formname.support.replace &''

    $!saveref

--------------------------------------------------------------------------------
  endfunction
-- End function

-- End of file Mdsitrunnvt02.pml
