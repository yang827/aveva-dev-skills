--------------------------------------------------------------------------------
--
--
-- File: Mdsitt04.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Initialisation for form 'TT04'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt04(!modify is STRING,!textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------
  if !!mdsTT04.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  !!mdsTT04.mainBore.val = 'Main     Bore'

-- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

-- Initialise Variables
  !name = '/' & !textName
  !pad  = FALSE

-- Initialise Standard gadgets
  !!kResetActive(!!mdsTT04, FALSE)
  !!mdsTT04.tag.active     = TRUE
  !!mdsTT04.name.active    = TRUE
  !!mdsTT04.crtube.active   = TRUE
  !!mdsTT04.crelbo.active   = TRUE
  !!mdsTT04.crredu.active   = TRUE
  !!mdsTT04.crcros.active   = TRUE
  !!mdsTT04.cancel.active  = TRUE
  !!mdsTT04.connect.active = FALSE
  !!mdsTT04.modify.active = FALSE
  !!mdsTT04.forcecon.active = FALSE
  !!mdsTT04.disconn.active = FALSE

--------------------------------------------------------------------------------
-- Create Support object
  !support           = object MDSSUPPORT()
  !support.position  = FALSE
  !support.mirror    = FALSE
  !support.rotatecur = FALSE
  !support.handedcur = FALSE
  !support.rotated   = 0
  !support.bpnum     = 0
  !support.alias     = !alias

--------------------------------------------------------------------------------

-- Select member option to 1
  !!mdsTT04.member.val = 1

  if (!modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Trunnion Type 'TT04'

-- Set callback on cancel button
    !!mdsTT04.cancel.callback = |call !!mdsCancelSupp(!!mdsTT04)|
    !support.modify            = FALSE

-- Initialise variables for new supports
    !support.replace = !!mdsTrunn.replacement
    !support.type    = !!mdsTrunn.standard.selection('Rtext')
    !struName        = !!mdsTrunn.name.val

-- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif

-- Set gadgets on form
    !!mdsTT04.name.val   = !struName
    !!mdsTT04.pLength.val = 0
    !!mdsTT04.pWidth.val = 0
    !!mdsTT04.pThk.val = 0
    !!mdsTT04.tlength.val  = 0
    !!mdsTT04.dist.val   = 0
    !!mdsTT04.p.val      = ''

-- Clear bore gadget if previously used
    !!mdsTT04.bore.clear()

-- Hide calling form
    hide !!mdsTrunn

-- Activate relevant gadgets
    !!mdsTT04.viewstd.active = TRUE
--------------------------------------------------------------------------------

  else
-- Modify an Existing Trunnion Type 'TT04'
--------------------------------------------------------------------------------

-- Set callback on cancel button
    !!mdsTT04.cancel.active = FALSE
    !support.modify            = TRUE
    !!kResetActive(!!mdsTT04, FALSE)
    !!mdsTT04.crtube.active    = FALSE
    !!mdsTT04.crelbo.active    = FALSE
    !!mdsTT04.crredu.active    = FALSE
    !!mdsTT04.crcros.active    = FALSE
    !!mdsTT04.rotatt.active    = TRUE

-- Initialise variables for existing supports
-- Store Data in support object
    !support.type     = 'TT04'
    !support.position = TRUE
      handle (2,109)
        !!alert.error('Support Datum does not exist')
        unenhance all
        !!mdsModifySupp.cancel.active = TRUE
        !!kRestoreUnits(!currentUnits)
        return
      endhandle

-- Navigate to existing support datum
    !datum = '/' + !!mdsModifySupp.name.val
    !!ce = !datum.dbref()
    !support.datum   = !datum.dbref()

-- Complete support atta list
    !!ce = $!datum/NOTE1
    !support.atta.append(!!ce)
    !!ce = $!datum/MAKEUP
    !support.atta.append(!!ce)
    !!ce = $!datum/NOTE2
    !support.atta.append(!!ce)
    !!ce = $!datum/NOTE3
    !support.atta.append(!!ce)
    !!ce = $!datum/SREF
    !support.atta.append(!!ce)
    !!ce = $!datum
    !support.atta.append(!!ce)
    !!ce             = !support.datum

-- Set Form Gadgets
    !!mdsTT04.name.val   = !support.datum.namn
    !!mdsTT04.p.val      = ''
    !!mdsAddAll('$!textName')

-- If the trunnion is connected to an elbow hide the distance/through gadgets

    if !support.datum.owner.href.type.eq('ELBO') then
      !!mdsTT04.bdist.active = FALSE
      !!mdsTT04.bthro.active = FALSE
      !!mdsTT04.dist.active = FALSE
      !!mdsTT04.select.active = FALSE
      !!mdsTT04.dist.val = 0
    else
      !!mdsTT04.bdist.active = TRUE
      !!mdsTT04.bthro.active = TRUE
      !!mdsTT04.dist.active = TRUE
      !!mdsTT04.select.active = TRUE
----    !saveRef= !!ce
      !!ce = !support.datum
      branch
      goto href
      var !dist const dist p0 to pl of prev
        handle (2,113)
          var !dist const dist p0 to ph
        endhandle
      !!mdsTT04.dist.val = !dist.real()
    endif

    !!ce = !support.datum
    !styp = styp
    !bore = pa bore

-- Read plate dimensions
    !pLength = prop PLEN
    !!mdsTT04.pLength.val = !pLength.real()
    !pWidth = prop PWID
    !!mdsTT04.pWidth.val = !pWidth.real()
    !pThk = prop PTHK
    !!mdsTT04.pThk.val = !pThk.real()
    !!mdsGetProp(!!mdsTT04.pLength,!!mdsTT04.pLength,'PLEN',!bore,!styp)
    !!mdsGetProp(!!mdsTT04.pWidth,!!mdsTT04.pWidth,'PWID',!bore,!styp)
    !!mdsGetProp(!!mdsTT04.pThk,!!mdsTT04.pThk,'PTHK',!bore,!styp)

-- Read length
    branch
    !pTBore = pt bore
    pin 9 at ph
    pin 8 at pt
    pin 9 dir d
    if !!ce.href.type.eq('REDU') then
      !paBore = !!ce.href.abore
      !plBore = !!ce.href.lbore
      if !paBore.gt(!plBore) then
        pin 9 plane d thro pa of href
      else
        pin 9 plane d thro pl of href
      endif
    else
      pin 9 plane d thro p0 of href
    endif
    var !height const dist pin 9 to pin 8

--<wd>oct2003
    last mem
    !at59 = '0'
    if !!ce.styp.match('AT59').gt(0) or !!ce.styp.match('AT68').gt(0) then
      var !at59 const dist p1 to p2
    endif
    !!mdsResetPins(8,9)
--!!mdsTT04.tlength.val = !height.real()
-- Measured from the Main Pipe CL to the bottom of the Trunnion BASE Plate
    !!mdsTT04.tlength.val = !height.real() - !at59.real()
    branch
--<wd>oct2003

-- Determine the MAIN PIPE bore
    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

-- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- The available bores will be stored in the object for TT04 !!mdsParTT04[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
    --!availBores = !!mdsParTT04[$!bore].bores
--
-- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
    !mdsStd = 'TT04'
--><wd>03jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>03jun09 - DFN P-17079
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

-- Check if the Trunnion type and bore is ACTIVE for the current PDMS Project
    if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

-- Advise USER and EXIT Trunnion Support Modification
      !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
      unenhance all
      !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
      !!kRestoreUnits(!currentUnits)
      return

    else
-- List the Available Trunnion Bore Sizes for the Current TRUNNION
      !availBores = !mdsTrunObj.bores

    endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

    !!kRestoreUnits(!currentUnits)
    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmBore = !availBores[$!setUnitBores]
      !mmBore = !mmBore & 'mm'
      !unitBore.append(!mmBore.bore(!!boreFmt).string())
    enddo
    !currentUnits = !!kGetSetUnits()
    !!mdsTT04.bore.dText = !unitBore
    !!mdsTT04.bore.rText = !availBores

-- Try and select the existing bore
    !!mdsTT04.bore.select('RTEXT',!pTBore.string().before('mm'))
    units mm bore
    !pHBore = ph bore
    !!kRestoreUnits(!currentUnits)
    !mainBore = !pHBore.string()
    !!mdsTT04.mainBore.val = 'Main     Bore =     $!mainBore'

-- Show available gadgets
     !!mdsTT04.bore.active = TRUE
     !!mdsTT04.viewstd.active = TRUE
     !!mdsTT04.setlen.active = TRUE
     !!mdsTT04.trunmat.active = TRUE
     !!mdsTT04.zoom.active = TRUE
     !!mdsTT04.tlength.active = TRUE
     !!mdsTT04.ok.active = TRUE

   endif
-- END of the INITIAL CREATE or MODIFY Condition for Trunnion TT04
--------------------------------------------------------------------------------

-- Store support object in form
   !!mdsTT04.support = !support

-- Store Current representations in form for use later
   var !repre repre level
   !!mdsTT04.repre.clear()
   !!mdsTT04.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
   var !repre repre level pipe
   !!mdsTT04.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
   var !repre repre level nozz
   !!mdsTT04.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
   var !repre repre level stru
   !!mdsTT04.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------

  if (!modify.upcase() eq |MODIFY|) then
    !!ce = !!mdsTT04.support.datum

-- Set distance gadget
-- !!mdsDistance(!!mdsTT04)

--------------------------------------------------------------------------------
-- Add marker text markers
    var !pos pos wrt world
-- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
        handle ANY
          skip
        endhandle
-- Store Atta reference in form
-- !!mdsTT04.support.atta.append(!!ce)
      var !pos pos wrt world
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
    enddo

---------------------------------------------------------------------------------------
-- Store Packing Pieces in the Support Object
-- Derived from the 'ATTAS' :MDSPackRef references in the support.atta array
    do !atta values !!mdsTT04.support.atta
      !!ce = !atta
      if (!atta.:MDSPackRef.badref().not()) then
        !!mdsTT04.support.packs.append(!atta.:MDSPackRef)
      else
        :MDSPackRef unset
          handle ANY
          endhandle
        skip
      endif
    enddo

---------------------------------------------------------------------------------------
-- Fill in dimensions from atta (Stored in mm)
    !!ce = !!mdsTT04.support.datum
--    --  !despars = despar

-- Store pos.ori and despar in case user cancel form
    !!mdsTT04.support.oldPosition    = pos wrt /*
    !!mdsTT04.support.oldOrientation = ori wrt /*
    !!mdsTT04.support.oldDespars     = despar
    !!mdsTT04.support.oldSpref       = spref

-- Check if Reinforcing Plate available with Selected Trunnion
    !selection = !support.datum.stype
    if (matchwild(!selection,'*TT04-A*')) then
      !!mdsTT04.plate.val = 0
      !pad = FALSE
    elseif (matchwild(!selection,'*TT04-C*')) then
      !!mdsTT04.plate.val = 0
      !pad = FALSE
    else
      !pad = TRUE
    endif

  endif

--------------------------------------------------------------------------------
-- Redefine Trunnion support name on form title
  !index = !!mdsTrunn.standard.rText.findfirst('TT04')
  !text  = !!mdsTrunn.standard.dText[!index]
    handle (61,567) (61,615)
      !!mdsPopulate(!!mdsTrunn,'TRUNN')
      !index = !!mdsTrunn.standard.rText.findfirst('TT04')
      !text  = !!mdsTrunn.standard.dText[!index]
    endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsTT04.support.replace = !formName

  call !!mdsSetFormName(!!mdsTT04, 'BASE SUPPORT', '$!formName')

--------------------------------------------------------------------------------
-- Store current form information
  call !!mdsStoreTT04()

-- Set the Callback actions on the Common Trunnion Selection
-- form '!!mdsTrunnVT01.ok'  - OK gadget
  !!mdsTrunnVT01.action.clear()
  !!mdsTrunnVT01.cancel.callback = ||

-- Activate/Deactivate '.pad' gadget as required
    -- !!mdsTT04.plate.active = !pad

-- Activate bedplate icon
  !!mdsTT04.bedPlate.active = TRUE

-- Deactivate icons that are not used
  !!mdsDeActivate(!!mdsTT04,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
  !!mdsTT04.mtoc.active = TRUE

-------------------------------------------------------------------------------
--<wd>26jul2004
  if (!modify.upcase() eq |MODIFY|) then
-- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
    branch
--    !trunDir = !!ce.hdir.wrt(/* )
    !form  = !!mdsTT04
    !dbref   = !!ce
    !message = ''
    !!mdsModifyTrun(!dbref, !form, !message)
    if (!message.length().neq(0)) then
-- An ERROR exists so do NOT continue
      !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
      !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif
--<wd>26jul2004
-------------------------------------------------------------------------------

-- Show Form for Trunnion Type 'TT04'
  !!kShowForm(!!mdsTT04)

  !!mdsCreateGeneralFromPS (!!mdsTT04, !name)

--------------------------------------------------------------------------------
-- Reset Units
   !!kRestoreUnits(!currentUnits)

--------------------------------------------------------------------------------
  endfunction
