--------------------------------------------------------------------------------
--
--
-- File: Mdsitt13.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Thursday 19th February
--
--
-- Description:
-- Initialisation for form 'TT13'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt13(!modify is STRING,!textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!mdsTT13.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !!mdsTT13.mainBore.val = 'Main     Bore'

-- Find current units and set the distance unit to metric
    !currentUnits = !!kGetSetUnits()

-- Initialise Variables
    !name = '/' & !textName
    !pad  = FALSE

-- Initialise Standard gadgets
    !!kResetActive(!!mdsTT13, FALSE)
    !!mdsTT13.tag.active     = TRUE
    !!mdsTT13.name.active    = TRUE
    !!mdsTT13.crtube.active   = TRUE
    !!mdsTT13.cancel.active  = TRUE
    !!mdsTT13.connect.active = FALSE
    !!mdsTT13.modify.active = FALSE
    !!mdsTT13.forcecon.active = FALSE
    !!mdsTT13.disconn.active = FALSE

--------------------------------------------------------------------------------
-- Create Support object
    !support           = object MDSSUPPORT()
    !support.position  = FALSE
    !support.mirror    = FALSE
    !support.rotatecur = FALSE
    !support.handedcur = FALSE
    !support.rotated   = 0
    !support.bpnum     = 0
    !support.alias     = !alias

--------------------------------------------------------------------------------

-- Select member option to 1

    !!mdsTT13.member.val = 1

    if (!modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Trunnion Type 'tt13'

-- Set callback on cancel button
      !!mdsTT13.cancel.callback = |call !!mdsCancelSupp(!!mdsTT13)|
      !support.modify            = FALSE

-- Initialise variables for new supports
      !support.replace = !!mdsTrunn.replacement
      !support.type    = !!mdsTrunn.standard.selection('Rtext')
      !struName        = !!mdsTrunn.name.val

-- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentUnits)
        return
      endif

-- Set gadgets on form
      !!mdsTT13.name.val   = !struName
      !!mdsTT13.pLength.val = 0
      !!mdsTT13.pWidth.val = 0
      !!mdsTT13.pThk.val = 0
      !!mdsTT13.tlength.val  = 0
      !!mdsTT13.dist.val   = 0
      !!mdsTT13.p.val      = ''

-- Clear bore gadget if previously used
      !!mdsTT13.bore.clear()

-- Hide calling form

      hide !!mdsTrunn

-- Activate relevant gadgets
      !!mdsTT13.viewstd.active = TRUE
--------------------------------------------------------------------------------

    else
-- Modify an Existing Trunnion Type 'tt13'
--------------------------------------------------------------------------------

-- Set callback on cancel button
      !!mdsTT13.cancel.active = FALSE
      !support.modify            = TRUE
      !!kResetActive(!!mdsTT13, FALSE)
      !!mdsTT13.crtube.active    = FALSE
      !!mdsTT13.rotatt.active    = TRUE

-- Initialise variables for existing supports

-- Store Data in support object
      !support.type     = 'TT13'
      !support.position = TRUE
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsModifySupp.cancel.active = TRUE
          !!kRestoreUnits(!currentUnits)
          return
        endhandle

-- Navigate to existing support datum
      !datum = '/' + !!mdsModifySupp.name.val
      !support.datum   = !datum.dbref()

-- Complete support atta list

      !!ce = $!datum/NOTE1
      !support.atta.append(!!ce)
      !!ce = $!datum$n.1
      !support.atta.append(!!ce)
      !!ce = $!datum/MAKEUP
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE2
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE3
      !support.atta.append(!!ce)
      !!ce = $!datum/SREF
      !support.atta.append(!!ce)
      !!ce = $!datum
      !support.atta.append(!!ce)
      !!ce = $!datum$n.2
      !support.atta.append(!!ce)
      !!ce             = !support.datum

-- Set Form Gadgets
      !!mdsTT13.name.val   = !support.datum.namn
      !!mdsTT13.p.val      = ''

      !!mdsAddAll('$!textName')

-- If the trunnion is connected to an elbow hide the distance/through gadgets

      if !support.datum.owner.href.type.eq('ELBO') then
        !!mdsTT13.bdist.active = FALSE
        !!mdsTT13.bthro.active = FALSE
        !!mdsTT13.dist.active = FALSE
        !!mdsTT13.select.active = FALSE
        !!mdsTT13.dist.val = 0
      else
        !!mdsTT13.bdist.active = TRUE
        !!mdsTT13.bthro.active = TRUE
        !!mdsTT13.dist.active = TRUE
        !!mdsTT13.select.active = TRUE
--        !saveRef = !!ce
        !!ce = !support.datum
        branch
        goto href
        var !dist const dist p0 to pl of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !!mdsTT13.dist.val = !dist.real()
      endif

      !!ce = !support.datum
      !styp = styp
      !bore = pa bore

-- Read plate dimensions
      !pLength = prop PLEN
      !!mdsTT13.pLength.val = !pLength.real()
      !pWidth = prop PWID
      !!mdsTT13.pWidth.val = !pWidth.real()
      !pThk = prop PTHK
      !!mdsTT13.pThk.val = !pThk.real()
      !!mdsGetProp(!!mdsTT13.pLength,!!mdsTT13.pLength,'PLEN',!bore,!styp)
      !!mdsGetProp(!!mdsTT13.pWidth,!!mdsTT13.pWidth,'PWID',!bore,!styp)
      !!mdsGetProp(!!mdsTT13.pThk,!!mdsTT13.pThk,'PTHK',!bore,!styp)

-- Read length
-- The length of the branch does not include the bearing plate so take that value off
      branch
      !pTBore = pt bore
      pin 9 at ph
      pin 8 at pt
      pin 9 dir d
      pin 9 plane d thro p0 of href
      var !height const dist pin 9 to pin 8
      branch
      last mem
      var !off '0'
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      endif
-- Goto Previous Branch Member if Last Member is NOT a Bearing Plate ('AC19*')
-- e.g. a TRUNNION GUIDE or STOP
      prev

--<wd>oct2003
      !at59 = '0'
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      --endif
      elseif !!ce.styp.match('AT59').gt(0) or !!ce.styp.match('AT68').gt(0) then
        var !at59 const dist p1 to p2
      endif
      !!mdsResetPins(8,9)
      --!!mdsTT13.tlength.val = !height.real() - !off.real()
-- Measured from the Main Pipe CL to the bottom of the Trunnion BASE Plate
      !!mdsTT13.tlength.val = !height.real() - !off.real() - !at59.real()
--<wd>oct2003

    branch

    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

-- Get Session Bore Units

    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- The available bores will be stored in the object for TT13 !!mdsParTT13[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
    --!availBores = !!mdsParTT13[$!bore].bores
--
-- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
    !mdsStd = 'TT13'
--><wd>04jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>04jun09 - DFN P-17079
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

-- Check if the Trunnion type and bore is ACTIVE for the current  PDMS Project
    if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

-- Advise USER and EXIT Trunnion Support Modification
      !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
      unenhance all
      !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
      !!kRestoreUnits(!currentUnits)
      return

   else
-- List the Available Trunnion Bore Sizes for the Current TRUNNION
     !availBores = !mdsTrunObj.bores

   endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

   !!kRestoreUnits(!currentUnits)
   !unitBore = ARRAY()
   do !setUnitBores from 1 to !availBores.size()
     !mmBore = !availBores[$!setUnitBores] & 'mm'
     !unitBore.append(!mmBore.bore(!!boreFmt).string())
   enddo
   !currentUnits = !!kGetSetUnits()
   !!mdsTT13.bore.dText = !unitBore
   !!mdsTT13.bore.rText = !availBores


-- Try and select the existing bore

   !!mdsTT13.bore.select('RTEXT',!pTBore.string().before('mm'))

   units mm bore
   !pHBore = ph bore
   !!kRestoreUnits(!currentUnits)
   !mainBore = !pHBore.string()
   !!mdsTT13.mainBore.val = 'Main     Bore =     $!mainBore'

-- Show available gadgets

      !!mdsTT13.bore.active = TRUE
      !!mdsTT13.viewstd.active = TRUE
      !!mdsTT13.setlen.active = TRUE
      !!mdsTT13.trunmat.active = TRUE
      !!mdsTT13.zoom.active = TRUE
      !!mdsTT13.tlength.active = TRUE
      !!mdsTT13.ok.active = TRUE
      !!mdsTT13.member.active = TRUE

    endif
--------------------------------------------------------------------------------

-- Store support object in form
    !!mdsTT13.support = !support

-- Store Current representations in form for use later
    var !repre repre level
    !!mdsTT13.repre.clear()
    !!mdsTT13.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsTT13.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsTT13.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsTT13.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------

    if (!modify.upcase() eq |MODIFY|) then
      !!ce = !!mdsTT13.support.datum

-- Set distance gadget
      -- !!mdsDistance(!!mdsTT13)

--------------------------------------------------------------------------------
-- Add marker text markers
      var !pos pos wrt world
      -- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 211 to 259
        var !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
          handle ANY
            skip
          endhandle
-- Store Atta reference in form
        -- !!mdsTT13.support.atta.append(!!ce)
        var !pos pos wrt world
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

---------------------------------------------------------------------------------------
-- Store Packing Pieces in the Support Object
-- Derived from the 'ATTAS' :MDSPackRef references in the Support.atta array
      do !atta values !!mdsTT13.support.atta
        !!ce = !atta
        if (!atta.:MDSPackRef.badref().not()) then
          !!mdsTT13.support.packs.append(!atta.:MDSPackRef)
        else
          :MDSPackRef unset
            handle ANY
            endhandle
          skip
        endif
      enddo

---------------------------------------------------------------------------------------
-- Fill in dimensions from atta (Stored in mm)
      !!ce = !!mdsTT13.support.datum
--      !despars = despar

-- Store pos.ori and despar in case user cancels form
      !!mdsTT13.support.oldPosition    = pos wrt /*
      !!mdsTT13.support.oldOrientation = ori wrt /*
      !!mdsTT13.support.oldDespars     = despar
      !!mdsTT13.support.oldSpref       = spref

-- Check if Reinforcing Plate available with Selected Trunnion
      !selection = !support.datum.stype
      if (matchwild(!selection,'*TT13-A*')) then
        !!mdsTT13.plate.val = 0
        !pad = FALSE
      elseif (matchwild(!selection,'*TT13-C*')) then
        !!mdsTT13.plate.val = 0
        !pad = FALSE
      else
        !pad = TRUE
      endif

    endif

--------------------------------------------------------------------------------
  -- label /CONT

-- Redefine Trunnion support name on form title

    !index = !!mdsTrunn.standard.rText.findfirst('TT13')
    !text  = !!mdsTrunn.standard.dText[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsTrunn,'TRUNN')
        !index = !!mdsTrunn.standard.rText.findfirst('TT13')
        !text  = !!mdsTrunn.standard.dText[!index]
      endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
    !!mdsTT13.support.replace = !formName

    call !!mdsSetFormName(!!mdsTT13, 'BASE SUPPORT', '$!formName')

--------------------------------------------------------------------------------
-- Store current form information
    call !!mdsStoreTT13()

-- Set the Callback actions on the Common Trunnion Selection
-- form '!!mdsTrunnVT01.ok'  - OK gadget
    !!mdsTrunnVT01.action.clear()
    !!mdsTrunnVT01.cancel.callback = ||

-- Activate/Deactivate '.pad' gadget as required
    -- !!mdsTT13.plate.active = !pad

-- Activate bedplate icon

    !!mdsTT13.bedPlate.active = TRUE

-- Deactivate icons that are not used

    !!mdsDeActivate(!!mdsTT13,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
    !!mdsTT13.mtoc.active = TRUE

-------------------------------------------------------------------------------
--<wd>26jul2004
    if (!modify.upcase() eq |MODIFY|) then
-- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
      branch
--      !trunDir = !!ce.hdir.wrt(/* )
      !form    = !!mdsTT13
      !dbref   = !!ce
      !message = ''
      !!mdsModifyTrun(!dbref, !form, !message)
      if (!message.length().neq(0)) then
-- An ERROR exists so do NOT continue
        !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
        !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
--<wd>26jul2004
-------------------------------------------------------------------------------

-- Show Form for Trunnion Type 'tt13'
    !!kShowForm(!!mdsTT13)

    !!mdsCreateGeneralFromPS (!!mdsTT13, !name)

--------------------------------------------------------------------------------
-- Reset Units
     !!kRestoreUnits(!currentUnits)

--------------------------------------------------------------------------------
  endfunction
