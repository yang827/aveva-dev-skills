--------------------------------------------------------------------------------
--
--
-- File: Mdsitt18.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Thursday 12th February
--
--
-- Description:
-- Initialisation for form 'TT18'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt18(!modify is STRING,!textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

  if !!mdsTT18.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !!mdsTT18.mainBore.val = 'Main     Bore'

-- Find current units and set the distance unit to metric
    !currentUnits = !!kGetSetUnits()

-- Initialise Variables
    !name = '/' & !textName
    !pad  = FALSE

-- Initialise Standard gadgets
    !!kResetActive(!!mdsTT18, FALSE)
    !!mdsTT18.tag.active     = TRUE
    !!mdsTT18.name.active    = TRUE
    !!mdsTT18.crtube.active   = TRUE
    !!mdsTT18.crelbo.active   = TRUE
    !!mdsTT18.crredu.active   = TRUE
    !!mdsTT18.crcros.active   = TRUE
    !!mdsTT18.cancel.active  = TRUE
    !!mdsTT18.connect.active = FALSE
    !!mdsTT18.modify.active = FALSE
    !!mdsTT18.forcecon.active = FALSE
    !!mdsTT18.disconn.active = FALSE

--------------------------------------------------------------------------------
-- Create Support object
    !support           = object MDSSUPPORT()
    !support.position  = FALSE
    !support.mirror    = FALSE
    !support.rotatecur = FALSE
    !support.handedcur = FALSE
    !support.rotated   = 0
    !support.bpnum     = 0
    !support.alias     = !alias

--------------------------------------------------------------------------------

-- Select member option to 1

    !!mdsTT18.member.val = 1

    if (!modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Trunnion Type 'tt18'

-- Set callback on cancel button
      !!mdsTT18.cancel.callback = |call !!mdsCancelSupp(!!mdsTT18)|
      !support.modify            = FALSE

-- Initialise variables for new supports
      !support.replace = !!mdsTrunn.replacement
      !support.type    = !!mdsTrunn.standard.selection('Rtext')
      !struName        = !!mdsTrunn.name.val

-- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentUnits)
        return
      endif

-- Set gadgets on form
      !!mdsTT18.name.val   = !struName
      !!mdsTT18.pLength.val = 0
      !!mdsTT18.pWidth.val = 0
      !!mdsTT18.pThk1.val = 0
      !!mdsTT18.pThk2.val = 0
      !!mdsTT18.tlength.val  = 0
      !!mdsTT18.dist.val   = 0
      !!mdsTT18.p.val      = ''

-- Clear bore gadget if previously used
      !!mdsTT18.bore.clear()

-- Hide calling form

      hide !!mdsTrunn

-- Activate relevant gadgets
      !!mdsTT18.viewstd.active = TRUE
--------------------------------------------------------------------------------

    else
-- Modify an Existing Trunnion Type 'tt18'
--------------------------------------------------------------------------------

-- Set callback on cancel button
      !!mdsTT18.cancel.active = FALSE
      !support.modify            = TRUE
      !!kResetActive(!!mdsTT18, FALSE)
      !!mdsTT18.crtube.active    = FALSE
      !!mdsTT18.crelbo.active    = FALSE
      !!mdsTT18.crredu.active    = FALSE
      !!mdsTT18.crcros.active    = FALSE
      !!mdsTT18.rotatt.active    = TRUE



-- Initialise variables for existing supports

-- Store Data in support object
      !support.type     = 'TT18'
      !support.position = TRUE
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsModifySupp.cancel.active = TRUE
          !!kRestoreUnits(!currentUnits)
          return
        endhandle

-- Navigate to existing support datum
      !datum = '/' + !!mdsModifySupp.name.val
      !!ce = !datum.dbref()
      !support.datum   = !datum.dbref()

-- Complete support atta list

      !!ce = $!datum/NOTE1
      !support.atta.append(!!ce)
      !!ce = $!datum/MAKEUP
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE2
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE3
      !support.atta.append(!!ce)
      !!ce = $!datum/SREF
      !support.atta.append(!!ce)
      !!ce = $!datum
      !support.atta.append(!!ce)
      !!ce             = !support.datum

-- Set Form Gadgets
      !!mdsTT18.name.val   = !support.datum.namn
      !!mdsTT18.p.val      = ''

      !!mdsAddAll('$!textName')

-- If the trunnion is connected to an elbow hide the distance/through gadgets

      if !support.datum.owner.href.type.eq('ELBO') then
        !!mdsTT18.bdist.active = FALSE
        !!mdsTT18.bthro.active = FALSE
        !!mdsTT18.dist.active = FALSE
        !!mdsTT18.select.active = FALSE
        !!mdsTT18.dist.val = 0
      else
        !!mdsTT18.bdist.active = TRUE
        !!mdsTT18.bthro.active = TRUE
        !!mdsTT18.dist.active = TRUE
        !!mdsTT18.select.active = TRUE
--        !saveRef = !!ce
        !!ce = !support.datum
        branch
        goto href
        var !dist const dist p0 to pl of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !!mdsTT18.dist.val = !dist.real()
      endif

      !!ce = !support.datum
      !styp = styp
      !bore = pa bore

-- Read plate dimensions
      !pLength = prop PLEN
      !!mdsTT18.pLength.val = !pLength.real()
      !pWidth = prop PWID
      !!mdsTT18.pWidth.val = !pWidth.real()
      !pThk1 = prop PTTK
        handle NONE
          !!mdsTT18.pThk1.val = !pThk1.real()
        elsehandle ANY
          !pThk = prop PTHK
          !!mdsTT18.pThk.val = !pThk.real()
        endhandle
      !pThk2 = prop PBTK
        handle NONE
          !!mdsTT18.pThk2.val = !pThk2.real()
        elsehandle ANY
        endhandle
      !!mdsTT18.pThk2.val = !pThk2.real()
        handle ANY
      endhandle
      !!mdsGetProp(!!mdsTT18.pLength,!!mdsTT18.pLength,'PLEN',!bore,!styp)
      !!mdsGetProp(!!mdsTT18.pWidth,!!mdsTT18.pWidth,'PWID',!bore,!styp)
      !!mdsGetProp(!!mdsTT18.pThk1,!!mdsTT18.pThk1,'PTTK',!bore,!styp)
        handle ANY
          !!mdsGetProp(!!mdsTT18.pThk,!!mdsTT18.pThk,'PTHK',!bore,!styp)
        elsehandle NONE
          !!mdsGetProp(!!mdsTT18.pThk2,!!mdsTT18.pThk2,'PBTK',!bore,!styp)
        endhandle

-- Read length
      branch
      !pTBore = pt bore
      pin 9 at ph
      pin 8 at pt
      pin 9 dir d
      if !!ce.href.type.eq('REDU') then
        !paBore = !!ce.href.abore
        !plBore = !!ce.href.lbore
        if !paBore.gt(!plBore) then
          pin 9 plane d thro pa of href
        else
          pin 9 plane d thro pl of href
        endif
      else
        pin 9 plane d thro p0 of href
      endif
      var !height const dist pin 9 to pin 8
      !!mdsResetPins(8,9)
      !!mdsTT18.tlength.val = !height.real()

    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

-- Get Session Bore Units

    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- The available bores will be stored in the object for TT18 !!mdsParTT18[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
-- Because the pt will be bigger, get the bore from the makeup piece
    --!availBores = !!mdsParTT18[$!bore].bores
--
-- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
    !mdsStd = 'TT18'
--><wd>04jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>04jun09 - DFN P-17079
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

-- Check if the Trunnion type and bore is ACTIVE for the current  PDMS Project
    if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

-- Advise USER and EXIT Trunnion Support Modification
      !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
      unenhance all
      !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
      !!kRestoreUnits(!currentUnits)
      return

   else
-- List the Available Trunnion Bore Sizes for the Current TRUNNION
     !availBores = !mdsTrunObj.bores

   endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

   !!kRestoreUnits(!currentUnits)
   !unitBore = ARRAY()
   do !setUnitBores from 1 to !availBores.size()
     !mmBore = !availBores[$!setUnitBores] & 'mm'
     !unitBore.append(!mmBore.bore(!!boreFmt).string())
   enddo
   !currentUnits = !!kGetSetUnits()
   !!mdsTT18.bore.dText = !unitBore
   !!mdsTT18.bore.rText = !availBores


-- Try and select the existing bore

   !!mdsTT18.bore.select('RTEXT',!pTBore.string().before('mm'))

   units mm bore
   !pHBore = ph bore
   !!kRestoreUnits(!currentUnits)
   !mainBore = !pHBore.string()
   !!mdsTT18.mainBore.val = 'Main     Bore =     $!mainBore'

-- Show available gadgets

      !!mdsTT18.bore.active = TRUE
      !!mdsTT18.viewstd.active = TRUE
      !!mdsTT18.setlen.active = TRUE
      !!mdsTT18.trunmat.active = TRUE
      !!mdsTT18.zoom.active = TRUE
      !!mdsTT18.tlength.active = TRUE
      !!mdsTT18.ok.active = TRUE

    endif
--------------------------------------------------------------------------------

-- Store support object in form
    !!mdsTT18.support = !support

-- Store Current representations in form for use later
    var !repre repre level
    !!mdsTT18.repre.clear()
    !!mdsTT18.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsTT18.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsTT18.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsTT18.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------

    if (!modify.upcase() eq |MODIFY|) then
      !!ce = !!mdsTT18.support.datum

-- Set distance gadget
      -- !!mdsDistance(!!mdsTT18)

--------------------------------------------------------------------------------
-- Add marker text markers
      var !pos pos wrt world
      -- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 211 to 259
        var !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
          handle ANY
            skip
          endhandle
-- Store Atta reference in form
        -- !!mdsTT18.support.atta.append(!!ce)
        var !pos pos wrt world
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

---------------------------------------------------------------------------------------
-- Store Packing Pieces in the Support Object
-- Derived from the 'ATTAS' :MDSPackRef references in the Support.atta array
      do !atta values !!mdsTT18.support.atta
        !!ce = !atta
        if (!atta.:MDSPackRef.badref().not()) then
          !!mdsTT18.support.packs.append(!atta.:MDSPackRef)
        else
          :MDSPackRef unset
            handle ANY
            endhandle
          skip
        endif
      enddo

---------------------------------------------------------------------------------------
-- Fill in dimensions from atta (Stored in mm)
      !!ce = !!mdsTT18.support.datum
--      !despars = despar

-- Store pos.ori and despar in case user cancels form
      !!mdsTT18.support.oldPosition    = pos wrt /*
      !!mdsTT18.support.oldOrientation = ori wrt /*
      !!mdsTT18.support.oldDespars     = despar
      !!mdsTT18.support.oldSpref       = spref

-- Check if Reinforcing Plate available with Selected Trunnion
      !selection = !support.datum.stype
      if (matchwild(!selection,'*TT18-A*')) then
        !!mdsTT18.plate.val = 0
        !pad = FALSE
      elseif (matchwild(!selection,'*TT18-C*')) then
        !!mdsTT18.plate.val = 0
        !pad = FALSE
      else
        !pad = TRUE
      endif

    endif

--------------------------------------------------------------------------------
  -- label /CONT

-- Redefine Trunnion support name on form title

    !index = !!mdsTrunn.standard.rText.findfirst('TT18')
    !text  = !!mdsTrunn.standard.dText[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsTrunn,'TRUNN')
        !index = !!mdsTrunn.standard.rText.findfirst('TT18')
        !text  = !!mdsTrunn.standard.dText[!index]
      endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
    !!mdsTT18.support.replace = !formName

    call !!mdsSetFormName(!!mdsTT18, 'BASE SUPPORT', '$!formName')

--------------------------------------------------------------------------------
-- Store current form information
    call !!mdsStoreTT18()

-- Set the Callback actions on the Common Trunnion Selection
-- form '!!mdsTrunnVT01.ok'  - OK gadget
    !!mdsTrunnVT01.action.clear()
    !!mdsTrunnVT01.cancel.callback = ||

-- Activate/Deactivate '.pad' gadget as required
    -- !!mdsTT18.plate.active = !pad

-- Activate bedplate icon

    !!mdsTT18.bedPlate.active = TRUE

-- Deactivate icons that are not used

    !!mdsDeActivate(!!mdsTT18,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
    !!mdsTT18.mtoc.active = TRUE

-------------------------------------------------------------------------------
--<wd>26jul2004
    if (!modify.upcase() eq |MODIFY|) then
-- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
      branch
--      !trunDir = !!ce.hdir.wrt(/* )
      !form    = !!mdsTT18
      !dbref   = !!ce
      !message = ''
      !!mdsModifyTrun(!dbref, !form, !message)
      if (!message.length().neq(0)) then
-- An ERROR exists so do NOT continue
        !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
        !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
--<wd>26jul2004
-------------------------------------------------------------------------------

-- Show Form for Trunnion Type 'tt18'
    !!kShowForm(!!mdsTT18)

    !!mdsCreateGeneralFromPS (!!mdsTT18, !name)

--------------------------------------------------------------------------------
-- Reset Units
     !!kRestoreUnits(!currentUnits)

--------------------------------------------------------------------------------
  endfunction
