--------------------------------------------------------------------------------
--
--
-- File: Mdsitt28.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Gordon Evans
-- Created: Monday 29th September 2003
--
--
-- Description:
-- Initialisation for form 'TT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt28(!modify is STRING,!textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------
  if !!mdsTT28.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  !!mdsTT28.mainBore.val = 'Main     Bore'

-- Find current units and set the distance unit to metric
    !currentUnits = !!kGetSetUnits()

-- Initialise Variables
    !name = '/' & !textName
    !pad  = FALSE

-- Initialise Standard gadgets
    !!kResetActive(!!mdsTT28, FALSE)
    !!mdsTT28.tag.active     = TRUE
    !!mdsTT28.name.active    = TRUE
    !!mdsTT28.crtube.active   = TRUE
    !!mdsTT28.cancel.active  = TRUE
    !!mdsTT28.connect.active = FALSE
    !!mdsTT28.modify.active = FALSE
    !!mdsTT28.forcecon.active = FALSE
    !!mdsTT28.disconn.active = FALSE

--------------------------------------------------------------------------------
-- Create Support object
    !support           = object MDSSUPPORT()
    !support.position  = FALSE
    !support.mirror    = FALSE
    !support.rotatecur = FALSE
    !support.handedcur = FALSE
    !support.rotated   = 0
    !support.bpnum     = 0
    !support.alias     = !alias

--------------------------------------------------------------------------------
-- Select member option to 1
    !!mdsTT28.member.val = 1

    if (!modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Trunnion Type 'TT28'
-- Set callback on cancel button
      !!mdsTT28.cancel.callback = |call !!mdsCancelSupp(!!mdsTT28)|
      !support.modify            = FALSE

-- Initialise variables for new supports
      !support.replace = !!mdsTrunn.replacement
      !support.type    = !!mdsTrunn.standard.selection('Rtext')
      !struName        = !!mdsTrunn.name.val

-- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentUnits)
        return
      endif

-- Set gadgets on form
      !!mdsTT28.name.val   = !struName
      !!mdsTT28.pLength.val = 0
      !!mdsTT28.pWidth.val = 0
      !!mdsTT28.pThk.val = 0
      !!mdsTT28.iLen.val  = 0
      !!mdsTT28.clea.val  = 0
      !!mdsTT28.tlength.val  = 0
      !!mdsTT28.dist.val   = 0
      !!mdsTT28.p.val      = ''

-- Clear bore gadget if previously used
      !!mdsTT28.bore.clear()

-- Hide calling form
      hide !!mdsTrunn

-- Activate relevant gadgets
      !!mdsTT28.viewstd.active = TRUE
--------------------------------------------------------------------------------

    else
-- Modify an Existing Trunnion Type 'TT28'
--------------------------------------------------------------------------------
-- Set callback on cancel button
      !!mdsTT28.cancel.active = FALSE
      !support.modify            = TRUE
      !!kResetActive(!!mdsTT28, FALSE)
      !!mdsTT28.crtube.active    = FALSE
      !!mdsTT28.rotatt.active    = TRUE

-- Initialise variables for existing supports
-- Store Data in support object
      !support.type     = 'TT28'
      !support.position = TRUE
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsModifySupp.cancel.active = TRUE
          !!kRestoreUnits(!currentUnits)
          return
        endhandle

-- Navigate to existing support datum
      !datum = '/' + !!mdsModifySupp.name.val
      !!ce = !datum.dbref()
      !support.datum   = !datum.dbref()

-- Complete support atta list
      !!ce = $!datum/NOTE1
      !support.atta.append(!!ce)
      !!ce = $!datum$n.1
      !support.atta.append(!!ce)
      !!ce = $!datum/MAKEUP
      !support.atta.append(!!ce)
      !!ce = $!datum/FFW
      !support.atta.append(!!ce)
      !!ce = $!datum$n.2
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE2
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE3
      !support.atta.append(!!ce)
      !!ce = $!datum/SREF
      !support.atta.append(!!ce)
      !!ce = $!datum
      !support.atta.append(!!ce)
      !!ce = $!datum$n.3
      !support.atta.append(!!ce)
      !!ce = !support.datum

-- Set Form Gadgets
      !!mdsTT28.name.val   = !support.datum.namn
      !!mdsTT28.p.val      = ''

      !!mdsAddAll('$!textName')

-- If the trunnion is connected to an elbow hide the distance/through gadgets
      if !support.datum.owner.href.type.eq('ELBO') then
        !!mdsTT28.bdist.active = FALSE
        !!mdsTT28.bthro.active = FALSE
        !!mdsTT28.dist.active = FALSE
        !!mdsTT28.select.active = FALSE
        !!mdsTT28.dist.val = 0
      else
        !!mdsTT28.bdist.active = TRUE
        !!mdsTT28.bthro.active = TRUE
        !!mdsTT28.dist.active = TRUE
        !!mdsTT28.select.active = TRUE
--        !saveRef = !!ce
        !!ce = !support.datum
        branch
        goto href
        var !dist const dist p0 to pl of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !!mdsTT28.dist.val = !dist.real()
      endif

      !!ce = !support.datum
      !styp = styp
      !bore = pa bore

-- Read plate dimensions
      !pLength = prop PLEN
      !!mdsTT28.pLength.val = !pLength.real()
      !pWidth = prop PWID
      !!mdsTT28.pWidth.val = !pWidth.real()
      !pThk = prop PTHK
      !!mdsTT28.pThk.val = !pThk.real()
      !iLen = prop ILEN
        handle ANY
        elsehandle NONE
          !!mdsTT28.iLen.val = !iLen.real()
        endhandle
      !clea = prop CLEA
        handle ANY
        elsehandle NONE
          !!mdsTT28.clea.val = !clea.real()
        endhandle
      !!mdsGetProp(!!mdsTT28.pLength,!!mdsTT28.pLength,'PLEN',!bore,!styp)
      !!mdsGetProp(!!mdsTT28.pWidth,!!mdsTT28.pWidth,'PWID',!bore,!styp)
      !!mdsGetProp(!!mdsTT28.pThk,!!mdsTT28.pThk,'PTHK',!bore,!styp)
      !!mdsGetProp(!!mdsTT28.iLen,!!mdsTT28.iLen,'ILEN',!bore,!styp)
      !!mdsGetProp(!!mdsTT28.clea,!!mdsTT28.clea,'CLEA',!bore,!styp)

-- Select baseplate
      !!mdsTT28.member.val = 2

-- Read length
      branch
      3
      !pTBore = pl bore
      branch
      pin 9 at ph
      pin 8 at pt
      pin 9 dir d
      pin 9 plane d thro p0 of href
      var !height const dist pin 9 to pin 8
      branch
      last mem
      var !off '0'
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      endif
-- Goto Previous Branch Member if Last Member is NOT a Bearing Plate ('AC19*')
-- e.g. a TRUNNION GUIDE or STOP
      prev

--<wd>oct2003
      !at59 = '0'
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      --endif
      elseif !!ce.styp.match('AT59').gt(0) or !!ce.styp.match('AT68').gt(0) then
        var !at59 const dist p1 to p2
      endif
      !!mdsResetPins(8,9)
      --!!mdsTT28.tlength.val = !height.real() - !off.real()
-- Measured from the Main Pipe CL to the bottom of the Trunnion BASE Plate
      !!mdsTT28.tlength.val = !height.real() - !off.real() - !at59.real()
--<wd>oct2003

    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

-- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- The available bores will be stored in the object for TT28 !!mdsParTT28[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
-- Because the pt will be bigger, get the bore from the makeup piece
    --!availBores = !!mdsParTT28[$!bore].bores
--
-- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
      !mdsStd = 'TT28'
--><wd>04jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>04jun09 - DFN P-17079
      !mdsTrunObj  = object MDSREADTRUNDATA()
      !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

-- Check if the Trunnion type and bore is ACTIVE for the current  PDMS Project
      if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
        if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
          !errormessage = !mdsTrunObj.mdsStd.smess
        elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
          !errormessage = !mdsTrunObj.mdsStd.cmess
        endif

-- Advise USER and EXIT Trunnion Support Modification
        !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
        unenhance all
        !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
        !!kRestoreUnits(!currentUnits)
        return

      else
-- List the Available Trunnion Bore Sizes for the Current TRUNNION
        !availBores = !mdsTrunObj.bores

      endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

   !!kRestoreUnits(!currentUnits)
   !unitBore = ARRAY()
   do !setUnitBores from 1 to !availBores.size()
     !mmBore = !availBores[$!setUnitBores] & 'mm'
     !unitBore.append(!mmBore.bore(!!boreFmt).string())
   enddo
   !currentUnits = !!kGetSetUnits()
   !!mdsTT28.bore.dText = !unitBore
   !!mdsTT28.bore.rText = !availBores

-- Try and select the existing bore
   !!mdsTT28.bore.select('RTEXT',!pTBore.string().before('mm'))
   units mm bore
   !pHBore = ph bore
   !!kRestoreUnits(!currentUnits)
   !mainBore = !pHBore.string()
   !!mdsTT28.mainBore.val = 'Main     Bore =     $!mainBore'

-- Show available gadgets
      !!mdsTT28.bore.active = TRUE
      !!mdsTT28.viewstd.active = TRUE
      !!mdsTT28.setlen.active = TRUE
      !!mdsTT28.trunmat.active = TRUE
      !!mdsTT28.zoom.active = TRUE
      !!mdsTT28.tlength.active = TRUE
      !!mdsTT28.ok.active = TRUE
      !!mdsTT28.member.active = TRUE

    endif
--------------------------------------------------------------------------------

-- Store support object in form
    !!mdsTT28.support = !support

-- Store Current representations in form for use later
    var !repre repre level
    !!mdsTT28.repre.clear()
    !!mdsTT28.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsTT28.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsTT28.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsTT28.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------
    if (!modify.upcase() eq |MODIFY|) then
      !!ce = !!mdsTT28.support.datum

-- Set distance gadget
      -- !!mdsDistance(!!mdsTT28)

--------------------------------------------------------------------------------
-- Add marker text markers
      var !pos pos wrt world
      -- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 211 to 259
        var !num ($!count - 210)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
          handle ANY
            skip
          endhandle
-- Store Atta reference in form
        -- !!mdsTT28.support.atta.append(!!ce)
        var !pos pos wrt world
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

---------------------------------------------------------------------------------------
-- Store Packing Pieces in the Support Object
-- Derived from the 'ATTAS' :MDSPackRef references in the Support.atta array
      do !atta values !!mdsTT28.support.atta
        !!ce = !atta
        if (!atta.:MDSPackRef.badref().not()) then
          !!mdsTT28.support.packs.append(!atta.:MDSPackRef)
        else
          :MDSPackRef unset
            handle ANY
            endhandle
          skip
        endif
      enddo

---------------------------------------------------------------------------------------
-- Fill in dimensions from atta (Stored in mm)
      !!ce = !!mdsTT28.support.datum
--      !despars = despar

-- Store pos.ori and despar in case user cancel form
      !!mdsTT28.support.oldPosition    = pos wrt /*
      !!mdsTT28.support.oldOrientation = ori wrt /*
      !!mdsTT28.support.oldDespars     = despar
      !!mdsTT28.support.oldSpref       = spref

-- Check if Reinforcing Plate available with Selected Trunnion
      !selection = !support.datum.stype
      if (matchwild(!selection,'*TT28-A*')) then
        !!mdsTT28.plate.val = 0
        !pad = FALSE
      elseif (matchwild(!selection,'*TT28-C*')) then
        !!mdsTT28.plate.val = 0
        !pad = FALSE
      else
        !pad = TRUE
      endif

    endif

--------------------------------------------------------------------------------
  -- label /CONT

-- Redefine Trunnion support name on form title
    !index = !!mdsTrunn.standard.rText.findfirst('TT28')
    !text  = !!mdsTrunn.standard.dText[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsTrunn,'TRUNN')
        !index = !!mdsTrunn.standard.rText.findfirst('TT28')
        !text  = !!mdsTrunn.standard.dText[!index]
      endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
    !!mdsTT28.support.replace = !formName

    call !!mdsSetFormName(!!mdsTT28, 'BASE SUPPORT', '$!formName')
--------------------------------------------------------------------------------
-- Store current form information
    call !!mdsStoreTT28()

-- Set the Callback actions on the Common Trunnion Selection
-- form '!!mdsTrunnVT01.ok'  - OK gadget
    !!mdsTrunnVT01.action.clear()
    !!mdsTrunnVT01.cancel.callback = ||

-- Activate/Deactivate '.pad' gadget as required
    -- !!mdsTT28.plate.active = !pad

-- Activate bedplate icon
    !!mdsTT28.bedPlate.active = TRUE

-- Deactivate icons that are not used
    !!mdsDeActivate(!!mdsTT28,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
    !!mdsTT28.mtoc.active = TRUE

-------------------------------------------------------------------------------
--<wd>26jul2004
    if (!modify.upcase() eq |MODIFY|) then
-- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
      branch
--      !trunDir = !!ce.hdir.wrt(/* )
      !form    = !!mdsTT28
      !dbref   = !!ce
      !message = ''
      !!mdsModifyTrun(!dbref, !form, !message)
      if (!message.length().neq(0)) then
-- An ERROR exists so do NOT continue
        !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
        !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
--<wd>26jul2004
-------------------------------------------------------------------------------

-- Show Form for Trunnion Type 'TT28'
    !!kShowForm(!!mdsTT28)

    !!mdsCreateGeneralFromPS (!!mdsTT28, !name)

--------------------------------------------------------------------------------
-- Reset Units
     !!kRestoreUnits(!currentUnits)

--------------------------------------------------------------------------------
  endfunction
