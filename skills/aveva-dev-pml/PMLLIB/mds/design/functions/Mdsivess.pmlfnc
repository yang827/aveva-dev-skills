--
-- File:		Mdsivess.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:		I.Osborne
-- Created:		Thu Apr 24
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for Mdsvess.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIvess()

-- Reset Gadgets
  !!MdsVess.Name.val = 'unset'
  !!MdsVess.Ok.active = False

-- Read defaults file to load selections

  !!MdsPopulate(!!MdsVess,'VESS')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsVess.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsVess.view.active = false
      !!MdsVess.name.active = false
      return
    elsehandle none
      !!MdsVess.view.active = true
      !!MdsVess.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsVess)

  -- Set the name gadget as the focus
  !!MdsVess.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdsivess.pml
