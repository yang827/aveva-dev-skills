--
-- File:		Mdsivhanger.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          kmdihanger
--
-- Author:		A.Boudjnah
-- Created:		Wed March 20 2002
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for MdsVHanger.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsIVhanger()

-- Reset Gadgets
  !!MdsVHanger.Name.val = 'unset'
  !!MdsVHanger.Ok.active = False
  if(not defined(!!MdsHangerTypes)) then
    -- Create a hanger type container will all available hanger types
    !!MdsHangerTypes = object Mdshangertypes(true)
  endif
  -- get a filtered hanger type container object containing only variable hangers ('VH')
  !!MdsVHanger.formHangerTypes = !!MdsHangerTypes.getHangersForCategory('VH')
  handle any
  endhandle
-- Read defaults file to load selections

  !!MdsPopulate(!!MdsVHanger,'VARIABLE HANGER')

-- Check to see if all the standard for this type have been commented out

  !CheckVal = !!MdsVHanger.Standard.Dtext[1]
    handle (61,567) (61,615)
      !!MdsVHanger.view.active = false
      !!MdsVHanger.name.active = false
      return
    elsehandle none
      !!MdsVHanger.view.active = true
      !!MdsVHanger.name.active = true
    endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!MdsSetSupp(!!MdsVHanger)

-- Set the name gadget as the focus

  !!MdsVHanger.Name.SetFocus()

-- Reset the DAC global variable incase it has been left set to true

  !!MdsDacControl(false)


-- End function
endfunction

-- End of file Mdsivhanger.pml
