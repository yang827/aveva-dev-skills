-------------------------------------------------------------------------------
--
-- File:  Mdsivt02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IVS102
--
-- Author:  Wayne Dodwell
-- Created:  Friday 9th January 1998
--
--
-- Description:
-- Initialisation for form vt02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIvt02(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------
  if !!mdsVT02.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Set units
  !currentunits = !!kgetsetunits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsVT02
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsVT02.select.select('RTEXT', 'IDCUR')
  !!mdsVT02.datum.active = true
  !!mdsVT02.cancel.active = true


  --------------------------------------------------------------------------------
  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 0
  !support.alias     = !alias

  --------------------------------------------------------------------------------

  if (!modify.upcase() neq |MODIFY|)then
    --------------------------------------------------------------------------------
    -- Create a New Vessel Framework Type 'VT02'

    -- Set callback on cancel button
    !!mdsVT02.cancel.callback = |Call !!mdsCancelSupp(!!mdsVT02)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsvess.replacement
    !support.type    = !!mdsvess.standard.selection('Rtext')
    !struName        = !!mdsvess.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsVT02.name.val = !struName
    !!mdsVT02.dim1.val = 0
    !!mdsVT02.dim2.val = 25
    !!mdsVT02.dim3.val = 0
    !!mdsVT02.dist.val = 0
    !!mdsVT02.p.val = ''

    !!mdsvess.hide()

  else
    -- Modify an Existing Vessel Framework Type 'VT02'
    --------------------------------------------------------------------------------

    -- Set callback on cancel button
    !!mdsVT02.cancel.callback = |Call !!mdsRestoreForm(!!mdsVT02)|
    !support.modify = true
    !!mdsVT02.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = 'VT02'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998

    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to Vessel Framework Type 'VT02' from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !strn = !support.stru.namn
    !bar = !name & '-BAR-1'
    !references = !support.atta
    !index = !references.findfirst(!sref.dbref())
    !references.remove(!index)

    -- Store Data in support object
    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsVT02.name.val  = !strn
    !!mdsVT02.dim1.val  = 0
    !!mdsVT02.dim2.val  = 25
    !!mdsVT02.dim3.val  = 0
    !!mdsVT02.p.val     = ''


    -- Store section name and matref for each member
    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    !!mdsAddAll('$!textName')

  endif
  --------------------------------------------------------------------------------

  -- Store support object in form
  !!mdsVT02.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsVT02.repre.clear()
  !!mdsVT02.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsVT02.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsVT02.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsVT02.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)
  --------------------------------------------------------------------------------

  -- Collect all supports for Vessel Framework Type 'VT02'
  !!ce = /MDS/FRAMES/VT02
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  -- Generate Steel Size List
  !!mdsSetSteel.init('HIDE',!!mdsVT02,'-BAR-1','-V1')

  !!ce = !support.stru

  --------------------------------------------------------------------------------

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsVT02,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsVT02,'-BAR-1','-V1')

    !!ce = !!mdsVT02.support.datum

    --------------------------------------------------------------------------------
    -- Set distance gadget
    !!mdsDistance(!!mdsVT02)

    -- Add marker text markers
    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259
      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle
      --------------------------------------------------------------------------------
      -- Store Atta reference in form
      !!mdsVT02.support.atta.append(!!ce)
      VAR !pOS POS WRT WORLD
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>
    enddo

    ---------------------------------------------------------------------------------------



    -- Fill in dimensions from SREF atta

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsVT02.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsVT02.dim2.val = !despars[2]
    handle any
      !!mdsVT02.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsVT02.dim3.val = !despars[3]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  --------------------------------------------------------------------------------

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsvess.standard.rtext.findfirst('VT02')
  !text  = !!mdsvess.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdspopulate(!!mdsvess,'VESS')
    !index = !!mdsvess.standard.rtext.findfirst('VT02')
    !text  = !!mdsvess.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsVT02.support.replace = !formName

  call !!mdsSetFormName(!!mdsVT02, 'PIPE', '$!formName')

  !!ce = !!mdsVT02.support.stru


  --------------------------------------------------------------------------------
  -- Store current form information
  call !!mdsstorevt02()

  --------------------------------------------------------------------------------

  -- Set dimensions toggle
  !!mdsVT02.graphicalDim = false

  -- Show Form for Vessel Framework Type 'VT02'
  !!kShowForm(!!mdsVT02)

  !!kRestoreUnits(!currentunits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
