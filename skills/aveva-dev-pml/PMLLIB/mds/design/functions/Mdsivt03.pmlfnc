-------------------------------------------------------------------------------
--
-- File:  Mdsivt03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IVS103
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 13th January 1998
--
--
-- Description:
-- Initialisation for form vt03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsivt03(!modify is STRING, !textName is STRING,!dummy is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsVT03.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsVT03
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsVT03.select.select('RTEXT', 'IDCUR')
  !!mdsVT03.datum.active = true
  !!mdsVT03.cancel.active = true

  --------------------------------------------------------------------------------

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bpnum     = 0
  !support.alias     = !dummy

  --------------------------------------------------------------------------------

  if (!modify.upcase() neq |MODIFY|)then
    -- Create a New Vessel Framework Type 'VT03'
    --------------------------------------------------------------------------------

    -- Set callback on cancel button
    !!mdsVT03.cancel.callback = |call !!mdscancelsupp(!!mdsVT03)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsvess.replacement
    !support.type    = !!mdsvess.standard.selection('Rtext')
    !struName        = !!mdsvess.name.val

    -- Navigate to correct area
    if (!!mdsmovetosite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Create Stru
    new stru /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsVT03.name.val = !struName

    !!mdsVT03.dim1.val = 0
    !!mdsVT03.dim2.val = 2
    !!mdsVT03.dist.val = 0
    !!mdsVT03.p.val = ''

    !!mdsvess.hide()

    --------------------------------------------------------------------------------

  else
    -- Modify an Existing Vessel Framework Type 'VT03'
    --------------------------------------------------------------------------------

    -- Set callback on cancel button
    !!mdsVT03.cancel.callback = |call !!mdsrestoreform(!!mdsVT03)|
    !support.modify = true
    !!mdsVT03.datum.active = false

    -- Initialise variables for existing supports
    !datumname = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !attaone   = !name & '.1'
    !attatwo   = !name & '.2'
    !attathree = !name & '.3'

    -- Store Data in support object
    !support.type     = 'VT03'
    !support.position = true
    !support.datum    = !datumname.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsmodifysupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998

    -- Store Atta reference's in object
    !support.atta.append(!datumname.dbref())
    !support.atta.append(!sref.dbref())
    -- Append Existing Attas to Object ie: $!<name>.1, $!<name>.2, $!<name>.3
    !support.atta.append(!attaone.dbref())
    !support.atta.append(!attatwo.dbref())
    !support.atta.append(!attathree.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world

    -- Get Specific data to Vessel Framework Type 'VT03' from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !strn = !support.stru.namn
    !bar = !name & '-BAR-1'

    !references = !support.atta
    !index = !references.findfirst(!sref.dbref())
    !references.remove(!index)

    -- Store Data in support object
    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsVT03.name.val  = !strn
    !!mdsVT03.dim1.val  = 0
    !!mdsVT03.dim2.val  = 2
    !!mdsVT03.p.val     = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat


    !!mdsAddAll('$!textName')

  endif
  --------------------------------------------------------------------------------


  -- Store support object in form
  !!mdsVT03.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsVT03.repre.clear()
  !!mdsVT03.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsVT03.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsVT03.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsVT03.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------

  -- Collect all supports for Vessel Framework Type 'VT03'
  !!ce = /MDS/FRAMES/VT03
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle


  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsVT03,'-BAR-1','-TIE-1')

  !!ce = !support.stru

  --------------------------------------------------------------------------------

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsVT03,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsVT03,'-BAR-1','-TIE-1')

    !!ce = !!mdsVT03.support.datum

    --------------------------------------------------------------------------------

    -- Set distance gadget

    !!mdsDistance(!!mdsVT03)

    --------------------------------------------------------------------------------

    -- Add marker text markers

    VAR !pOS POS P9 WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    do !cOUNT from 211 TO 259

      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      --------------------------------------------------------------------------------

      -- Store Atta reference in form
      !!mdsVT03.support.atta.append(!!ce)

      VAR !pOS POS P9 WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!cOUNT $!num $<$!pOS$>

    enddo

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsVT03.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsVT03.dim2.val = !despars[2]
    handle any
      !!mdsVT03.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
  endif

  --------------------------------------------------------------------------------

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsvess.standard.rtext.findfirst('VT03')
  !text  = !!mdsvess.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdspopulate(!!mdsvess,'VESS')
    !index = !!mdsvess.standard.rtext.findfirst('VT03')
    !text  = !!mdsvess.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsVT03.support.replace = !formName

  call !!mdsSetFormName(!!mdsVT03, 'PIPE', '$!formName')

  !!ce = !!mdsVT03.support.stru

  --------------------------------------------------------------------------------
  -- Store current form information
  call !!mdsstorevt03()

  --------------------------------------------------------------------------------

  -- Set dimensions toggle

  !!mdsVT03.graphicalDim = false


  -- Show Form for Vessel Framework Type 'VT03'
  !!kShowForm(!!mdsVT03)

  --------------------------------------------------------------------------------
  -- Change the Callback on the Three Gadgets 'HEIGHT', 'LENGTH' and 'THICKNESS'
  -- On the form '!!mdsMODAT'
  !!mdsmodat.actionheight[2]    = |call !!mdsattavt03('HEIGHT',!!mdsVT03)|
  !!mdsmodat.actionlength[2]    = |call !!mdsattavt03('LENGTH',!!mdsVT03)|
  !!mdsmodat.actionthickness[2] = |call !!mdsattavt03('THICKNESS',!!mdsVT03)|

  !!kRestoreUnits(!currentunits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
