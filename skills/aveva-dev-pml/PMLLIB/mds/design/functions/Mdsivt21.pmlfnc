--------------------------------------------------------------------------------
--
-- File:    Mdsivt21.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IVS105
--
-- Author:  Gordon Evans
-- Created:  Wednesday 22nd Oct 2003
--
--
-- Description:
-- Initialisation for form vt21
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsivt21(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsVT21.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------
  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsVT21
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsVT21.select.select('RTEXT', 'IDCUR')
  !!mdsVT21.datum.active = true
  !!mdsVT21.cancel.active = true
  !!mdsVT21.modatta.active = true
  --<dw>mar2009 dun1119 - HPD0038602 To allow Dim1 to be re-set after build
  !!mdsVT21.dim1.active    = false
  --------------------------------------------------------------------------------

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 0
  !support.alias     = !alias

  --------------------------------------------------------------------------------

  if (!modify.upcase() neq |MODIFY|)then
    --------------------------------------------------------------------------------
    -- Create a New Vessel Framework Type 'vt21'


    -- Set callback on cancel button
    !!mdsVT21.cancel.callback = |Call !!mdscancelsupp(!!mdsVT21)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsvess.replacement
    !support.type    = !!mdsvess.standard.selection()
    !struName        = !!mdsvess.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsDacControl(true)

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Create Stru
    NEW STRU /$!struName
    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsVT21.name.val = !struName

    !!mdsVT21.dim1.val = 0
    !!mdsVT21.dist.val = 0
    !!mdsVT21.p.val = ''

    !!mdsvess.hide()

    --------------------------------------------------------------------------------

  else
    -- Modify an Existing Vessel Framework Type 'vt21'
    --------------------------------------------------------------------------------

    !!mdsVT21.cancel.callback = |Call !!mdsRestoreForm(!!mdsVT21)|
    -- !!mdsVT21.cancel.active = false
    !support.modify = true
    !!mdsVT21.datum.active = false
    --<dw>mar2009 dun1119 - HPD0038602 To allow Dim1 to be re-set
    !!mdsVT21.dim1.active  = true

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'
    !!cecomp = !!ce
    !!ce = !sref.dbref()
    !!ce = !!cecomp

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    endif
    --< Modified - <wd> - 15sep1998


    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to Vessel Framework Type 'vt21' from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')

    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif

    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif

    !support.rotated = !split[3].real()

    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Apply Data for existing cross bar
    !!ce  = !support.stru
    !strn = !support.stru.namn
    !bar = !name & '-BAR-1'

    !references = !support.atta
    !index = !references.findfirst(!sref.dbref())
    !references.remove(!index)

    -- Store Data in support object
    !support.bars[1] = !references

    -- Get length of existing crossbar
    !length = deri length of $!bar
    !support.barlen.append(!length)

    -- Set Form Gadgets
    !!mdsVT21.name.val  = !strn
    !!mdsVT21.dim1.val  = 0
    !!mdsVT21.p.val     = ''

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat



    !!mdsAddAll('$!textName')

  endif
  --------------------------------------------------------------------------------


  -- Store support object in form
  !!mdsVT21.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsVT21.repre.clear()
  !!mdsVT21.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsVT21.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsVT21.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsVT21.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)

  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------

  -- Collect all supports for Vessel Framework Type 'vt21'
  !!ce = /MDS/FRAMES/VT21-HORI
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle


  -- Generate Steel Size List

  !unuseddtext = ARRAY()
  !unusedrtext = ARRAY()
  -- !!mdsSetSize('CREATE',!!mdsVT21,'-BAR-1','-BAR-1')
  !!mdsSetSteel.init('HIDE',!!mdsVT21,'-BAR-1','-BAR-1')

  !!ce = !support.stru

  --------------------------------------------------------------------------------

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsVT21,'-BAR-1','-BAR-1')
    !!mdsSetSteel.init('HIDE',!!mdsVT21,'-BAR-1','-BAR-1')

    !!ce = !!mdsVT21.support.datum

    --------------------------------------------------------------------------------

    -- Set distance gadget

    !!mdsDistance(!!mdsVT21)

    --------------------------------------------------------------------------------

    -- Add marker text markers

    VAR !pos POS WRT WORLD

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

    do !count from 211 to 259

      VAR !num ($!count - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle

      --------------------------------------------------------------------------------

      -- Store Atta reference in form
      !!mdsVT21.support.atta.append(!!ce)

      VAR !pos POS WRT WORLD

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>




    enddo


    --------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()
    !despars = despar

    !!mdsVT21.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  --------------------------------------------------------------------------------

  label /CONT

  -- Redefine standard support name on form title

  !index = !!mdsvess.standard.rtext.findfirst('$!alias')
  !text  = !!mdsvess.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdspopulate(!!mdsvess,'VESS')
    !index = !!mdsvess.standard.rtext.findfirst('$!alias')
    !text  = !!mdsvess.standard.dtext[!index]
  endhandle
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsVT21.support.replace = !formName

  call !!mdsSetFormName(!!mdsVT21, 'PIPE', '$!formName')

  !!ce = !!mdsVT21.support.stru

  --------------------------------------------------------------------------------
  -- Store current form information
  call !!mdsstorevt21()

  --------------------------------------------------------------------------------

  -- Set dimensions toggle

  !!mdsVT21.graphicalDim = false

  -- Show Form for Vessel Framework Type 'vt21'
  !!kShowForm(!!mdsVT21)

  !!kRestoreUnits(!currentunits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

  -- End function
endfunction
