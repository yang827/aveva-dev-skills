--------------------------------------------------------------------------------
--
-- File:  Mdsivt23.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Initialisation for form VT23
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIVT23(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsVT23.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  --------------------------------------------
  -- Set Units
  !currentunits = !!kgetsetunits()
  --------------------------------------------

  -- Turn all form gadget active
  !!kResetActive(!!mdsVT23 , TRUE)

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsVT23
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsVT23.select.select('RTEXT', 'IDCUR')
  !!mdsVT23.datum.active = true
  !!mdsVT23.cancel.active = true

  -- VT23 has an alias from the cable rack frameworks called CT05 and
  -- from the HVAC frameworks called DT01

  !!mdsVT23.addPipe.active = FALSE
  !!mdsVT23.addHVAC.active = FALSE
  !!mdsVT23.addRack.active = FALSE
  !!mdsVT23.addBar.active  = FALSE
  !!mdsVT23.rotate.active  = FALSE
  !!mdsVT23.modAtta.active = FALSE
  !!mdsVT23.addPack.active = FALSE
  !!mdsVT23.delPack.active = FALSE
  !!mdsVT23.rotAtt.active  = FALSE
  !!mdsVT23.flipAtta.active = TRUE
  !!mdsVT23.connect.active  = FALSE
  !!mdsVT23.modify.active   = FALSE
  !!mdsVT23.forceCon.active = FALSE
  !!mdsVT23.disconn.active  = FALSE
  !!mdsVT23.deleteAtta.active = FALSE
  !!mdsVT23.copyLike.active = FALSE
  !!mdsVT23.createByCle.active = FALSE
  !!mdsVT23.newdat.active    = FALSE
  !!mdsVT23.alignSup.active  = FALSE
  !!mdsVT23.dim2.active = FALSE
  !!mdsVT23.trimmer.active  = FALSE
  !!mdsVT23.ancmat.active  = FALSE
  !!mdsVT23.bedPlate.active  = FALSE
  !!mdsVT23.flipAtta.active  = FALSE
  !!mdsVT23.anccopy.active  = FALSE
  !!mdsVT23.ancnudge.active  = FALSE
  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 2
  !support.alias     = !alias

  if (!modify.upcase() neq |MODIFY|)then

    -- Set callback on cancel button
    !!mdsVT23.cancel.callback = |Call !!mdsCancelSupp(!!mdsVT23)|
    !support.modify = false


    -- Initialise variables for new supports
    !support.replace = !!mdsvess.replacement
    !support.type    = !!mdsvess.standard.selection()
    !struName        = !!mdsvess.name.val

    -- Navigate to correct area
    if (!!mdsMoveToSite('').not())then
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endif

    !!mdsDacControl(true)

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Create Stru
    NEW STRU /$!struName

    !support.stru = !!ce
    :MDSSuppType |$!support.type|

    -- Set Paragraph gadget on form
    !!mdsVT23.name.val = !struName

    !!mdsVT23.dim1.val = 0
    !!mdsVT23.dim2.val = 0
    !!mdsVT23.dist.val = 0
    !!mdsVT23.p.val = ''

    !!mdsvess.hide()

    ------------------------------**** Connexions *****---------------------------
    -- in create mode have all three
    !!mdsVT23.createByDim.active = FALSE

    !!mdsVT23.createByCur.active = true
    ------------------------------------------------------------------------------

  else

    -- Set callback on cancel button
    !!mdsVT23.cancel.callback = |Call !!mdsRestoreForm(!!mdsVT23)|
    !support.modify = true
    !!mdsVT23.datum.active = false

    -- Initialise variables for existing supports
    !datumName = !name & '/DATUM'
    !sref      = !name & '/SREF'

    -- Store Data in support object
    !support.type     = '$!alias'
    !support.position = true
    !support.datum    = !datumName.dbref()
    handle (2,109)
      !!alert.error('Support Datum does not exist')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      --------------------------------------------
      return
    endhandle
    !support.stru = !name.dbref()

    --> Modified - <wd> - 15sep1998
    if  (!support.datum.:MDSCp1.lowcase().eq('unset')) then
      !!alert.error('The Support $!name was NOT successfully completed by the MDS Application and cannot be MODIFIED. You should DELETE the Support and RECREATE it to Continue.')
      unenhance all
      !!mdsModifySupp.cancel.active = true
      --------------------------------------------
      !!kRestoreUnits(!currentunits)
      $r
      --------------------------------------------
      return
    endif

    -- Store Atta reference's in object
    !support.atta.append(!datumName.dbref())
    !support.atta.append(!sref.dbref())

    -- Navigate to existing support datum
    !!ce = !support.datum
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.p10Dir = P10 Dir wrt world
    !support.p11Dir = P11 Dir wrt world

    -- Get Specific data to frame type 09 from :MDSCp1 on datum atta
    !data = !!ce.:MDSCp1
    !split = split(!data, ';')
    if (!split[1] eq |T|)then
      !support.rotateCur = TRUE
    else
      !support.rotateCur = FALSE
    endif
    if (!split[2] eq |T|)then
      !support.handedCur = TRUE
    else
      !support.handedCur = FALSE
    endif
    !support.rotated = !split[3].real()
    if (!split[4] eq |T|)then
      !support.mirror = TRUE
    else
      !support.mirror = FALSE
    endif

    -- Get number of existing crossbars
    !!ce  = !support.stru
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)

    if (!bars.size().gt(0))then
      do !i indices !bars
        !!ce = !bars[!i]
        var !ref :MDSAttaRef
        !split = split(!ref)

        !references = ARRAY()
        do !index indices !split
          !references.append(!split[!index].dbref())
          handle(2,107) (2,813)
            -- Atta has been manually deleted
          endhandle
        enddo

        -- Store Data in support object
        !support.bars[!i] = !references
      enddo

    endif

    -- Get length of existing crossbars
    do !v values !bars
      !length = deri length of $!v
      !support.barlen.append(!length)
    enddo

    -- Store section name and matref for each member

    !storeMat = ARRAY()
    !storeMat = !!mdsStoreMat(!name)
    !support.material = !storeMat

    -- Get bedplate references if set
    !!ce  = !support.stru
    var !bPRef1 :MDSBpref1
    var !bPRef2 :MDSBpref2
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedPlate1 = !bPRef1.dbref()
    endif
    if (!!ce.:MDSBpref2.badref().not()) then
      !support.bedPlate2 = !bPRef2.dbref()
    endif

    -- Set Form Gadgets
    !!mdsVT23.name.val = !name
    !!mdsVT23.dim1.val = 0
    !!mdsVT23.dim2.val = 0
    !!mdsVT23.p.val    = ''

    !!mdsAddAll('$!textName')

    ------------------------------ ***** Connexions --------------------
    -- if(!support.connections.size().eq(1)) then
    -- !!mdsVT23.lineUp.active = True
    -- endif

    -- set support object connections
    !vertDbref = ARRAY()
    !vert1 = !name & '-V1'
    !vertDbref[1] = !vert1.dbref()
    !conn1 = !vertDbref[1].:MDSConn
    !vert2 = !name & '-V2'
    !vertDbref[2] = !vert2.dbref()
    !conn2 = !vertDbref[2].:MDSConn
    !support.connections[1] = !conn1
    !support.connections[2] = !conn2

    -- set support object for joints

    !support.joints = !!mdsGetJoints(!vertDbref)

    -- hide dimension form the list if connected
    if(!support.joints.unset().not()) then
      !!mdsVT23.createByDim.active = false
      !!mdsVT23.createByCur.active = FALSE
    else
      !!mdsVT23.createByDim.active = true
      !!mdsVT23.createByCur.active = true

    endif

    -------------------------------------------------------------------
  endif

  -- Store support object in form
  !!mdsVT23.support = !support

  -- Store Current representations in form for use later
  var !repre repre level
  !!mdsVT23.repre.clear()
  !!mdsVT23.repre.append(|Call !!kRepreLevel(Nulref, '', $!repre,0)|)
  var !repre repre level pipe
  !!mdsVT23.repre.append(|Call !!kRepreLevel(Nulref, 'PIPE', $!repre,0)|)
  var !repre repre level nozz
  !!mdsVT23.repre.append(|Call !!kRepreLevel(Nulref, 'NOZZ', $!repre,0)|)
  var !repre repre level stru
  !!mdsVT23.repre.append(|Call !!kRepreLevel(Nulref, 'STRU', $!repre,0)|)


  -- Collect all supports for frame type 9
  !!ce = /MDS/FRAMES/$!alias
  handle (2,109)
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    if (!modify.upcase() neq |MODIFY|) then
      delete stru
    endif
    --------------------------------------------
    !!kRestoreUnits(!currentunits)
    --------------------------------------------
    return
  endhandle

  -- Generate Steel Size List

  !!mdsSetSteel.init('HIDE',!!mdsVT23,'-BAR-1','-V1')

  !!ce = !support.stru

  -- In a non planer element has been used before the distance gadgets may be deactivated
  -- so turn them all on

  !!mdsVT23.dist.active = TRUE
  handle ANY
  endhandle
  !!mdsVT23.bdist.active = TRUE
  handle ANY
  endhandle
  !!mdsVT23.select.active = TRUE
  handle ANY
  endhandle
  !!mdsVT23.bthro.active = TRUE
  handle ANY
  endhandle

  if (!modify.upcase() eq |MODIFY|) then

    -- !!mdsSetSize('SELECT',!!mdsVT23,'-BAR-1','-V1')
    !!mdsSetSteel.init('HIDE',!!mdsVT23,'-BAR-1','-V1')

    !!ce = !!mdsVT23.support.datum

    -- Set distance gadget

    !!mdsDistance(!!mdsVT23)

    ---------------------------------------------------------------------------------------
    -- Add marker text markers at P9 of ATTAS
    !!mdsaidtext(!!mdsVT23)

    -- Store Atta reference in form
    do !cOUNT from 211 TO 259
      VAR !num ($!cOUNT - 210)
      !attaName = !name & '.' & !num
      !!ce = !attaName.dbref()
      handle ANY
        skip
      endhandle
      !!mdsVT23.support.atta.append(!!ce)
    enddo

    ---------------------------------------------------------------------------------------

    -- Store Packing Pieces in the Support Object
    -- Derived from the 'Attas' :MDSPackRef references in the Support.atta array

    !!mdspackattas(!!mdsVT23.support)

    ---------------------------------------------------------------------------------------

    -- Fill in dimensions from SREF atta (Stored in mm)

    !!ce = !sref.dbref()

    !despars = Despar
    !!mdsVT23.dim1.val = !despars[1]
    handle any
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle
    !!mdsVT23.dim2.val = !despars[2]
    handle any
      !!mdsVT23.dim1.val = 0
      !!alert.error('Support created with a previous version of the application. Cannot restore dimensions')
      golabel /CONT
    endhandle

  endif

  label /CONT

  -- Redefine standard support name on form title


  !index = !!mdsvess.standard.rtext.findfirst('$!alias')
  !text  = !!mdsvess.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsvess,'FRAME')
    !index = !!mdsvess.standard.rtext.findfirst('$!alias')
    !text  = !!mdsvess.standard.dtext[!index]
  endhandle

  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsVT23.support.replace = !formName


  call !!mdsSetFormName(!!mdsVT23, 'PIPE', '$!formName')


  !!ce = !!mdsVT23.support.stru

  -- If modify put members into repre member of form

  if (!modify.upcase() eq |MODIFY|)then
    do !addrepre values !!mdsVT23.support.atta
      !!ce = !addrepre
      skip if (match(Name,|SREF|)gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsVT23.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      call !!kEnhanceList(!colourList)
    enddo
  endif



  ----------------------------------------------------------------

  -- Set dimensions toggle
  !!mdsVT23.graphicalDim = false

  -- Store current form information
  call !!mdsStoreVT23()

  -- Show Form for frame type VT23
  !!kShowForm(!!mdsVT23)

  --------------------------------------------
  !!kRestoreUnits(!currentunits)
  --------------------------------------------
  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
