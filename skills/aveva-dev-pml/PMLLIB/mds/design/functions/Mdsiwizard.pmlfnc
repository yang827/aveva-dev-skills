--
--
-- Description:
-- function to select the working section for the MDS Wizard
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R      STRING        ID or RESET
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsiwizard()

  !Form = !!MdsWizard

-- Set default reach value

  !!MdsWizard.reach.val = 1000mm
  !!MdsWizard.lastreach = 1000mm

-- Set volume to default

  !Form.Fx.Val = 1
  !Form.Fy.Val = 1
  !Form.Fz.Val = 1
  !Form.Tx.Val = 1
  !Form.Ty.Val = 1
  !Form.Tz.Val = 1

  !Form.FxVal.val = '0'
  !Form.FyVal.val = '0'
  !Form.FzVal.val = '0'
  !Form.TxVal.val = '0'
  !Form.TyVal.val = '0'
  !Form.TzVal.val = '0'

  !Form.SetElement = false

-- End function
endfunction

-- End of file Mdsiwizard.pml
