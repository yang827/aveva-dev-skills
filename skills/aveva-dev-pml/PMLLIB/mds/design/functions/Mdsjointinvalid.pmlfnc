--
-- File:		MdsJointInValid.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 14th July 1998
--
--
-- Description:
-- Function to Check to see if joints are of the correct type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        ARRAY        [joints of the support]
--     2     RW       ARRAY        [array of desc of why badjoint is returned]
--     3     RW       ARRAY        [array of desc of why badjoint is returned]
-- Return:
--    [Data Type]   [Description]
--     ARRAY        [Array of bad joints (should be max of two)]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsJointInValid(!Joints is array, !ODescription is array, !Adescription is array) is array

-- Initialise Variables
  !Refe = !!CE
  !OK = false
  !Selector = array()
  !BadJoints = array()

  do !js indices !Joints
    !Spref = !Joints[!Js].spre
    if(!Spref.unset()) then
      skip
    else
-- get current jointing details
      !OwnerGtyp    = !Joints[!Js].owner.owner.gtyp
      !AttachedGtyp = !Joints[!Js].cref.gtyp
        handle any
-- in case cref is null
--<wd>oct2002
          --!Attached = string()
          !AttachedGtyp = ''
--<wd>oct2002
        endhandle
-- get valid details from the spec
      !!CE = !Spref
      do !i
        end
        !Selector.append(!!ce)
        if(!!Ce.type.eq('SPEC')) then
          break
        endif
      enddo
      !Size = !Selector.size()

      do !Ind from !Size to 1 by -1
        if(!Selector[!Ind].Ques.eq('OTYP')) then
          !VOwner = !Selector[!ind - 1].Tans
          !VAttached = !Selector[!Ind - 2].Tans
          break
        endif
      enddo
    endif

--------------------
--<wd>jan2001
$(
$P---------------
$P OWNERGTYP
 q var !ownergtyp
$P VOWNER
 q var !vowner
$P---------------
$P ATTACHEDGTYP
-- q var !attachedgtyp
$P VATTACHED
 q var !vattached
$P---------------
$P---------------
$P---------------
$P---------------
$)
--<wd>jan2001
--------------------

-- set same as current if valid typ is any.-----------------------
    if(!VOwner.upcase().eq('ANY')) then
      !VOwner = !OwnerGtyp
    endif
    if(!VAttached.upcase().eq('ANY')) then
      !VAttached = !AttachedGtyp
    endif

-- Set Error Messages for Incompatible Joint Types
    if(!VOwner.neq(!OwnerGtyp)) then
      !BadJoints[!Js] = (!Joints[!Js])
      !ODescription[!Js] = 'Supporting Beam of type "' & !OwnerGtyp & '" is invalid for joint "' & !Joints[!js].name & '"'
    endif
    if(!VAttached.neq(!AttachedGtyp)) then
      !BadJoints[!Js] = (!Joints[!Js])
      !ADescription[!Js] = 'Support Upright of type "' & !AttachedGtyp & '" is invalid for joint "' & !Joints[!js].name & '"'
    endif
  enddo

--  !Badjoints.unique()
--  !Desc.unique()

  !!CE = !REFE

$(
$P---------------
$P OWNERGTYP
 q var !ownergtyp
$P VOWNER
 q var !vowner
$P---------------
$P ATTACHEDGTYP
-- q var !attachedgtyp
$P VATTACHED
 q var !vattached
$P---------------
$P BADJOINTS
 q var !badjoints
$P---------------
$)

  Return !BadJoints

-- End function
endfunction

-- End of file MdsJointInValid.pml
