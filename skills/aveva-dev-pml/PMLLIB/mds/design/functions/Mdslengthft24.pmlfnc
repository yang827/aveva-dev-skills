--
--
-- Description:
-- Initialisation of length gadget for form ft24
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         GADGET       Size gadget for ft24
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsLengthFt24(!Gadget is GADGET)

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

    !Dim1 = !!Mdsft24.Dim1.val


  -- Initialise Variables
    !Selection = !Gadget.selection('RTEXT')
    !Dtext = ARRAY()
    !Rtext = ARRAY()

  -- Determine the alphabetical equivalent for the selection
    !SizeCode = !!KNumberLetter(!Selection.real())

  -- Get template name
    !Template = /MDS/FRAMES/FT24
    !Types = !!KCollectAllFor('SCTN', '((match(name, |MDS/FT24/$!SizeCode|) gt 0) and type of owner eq |FRMW|)', !Template)

    -- Length of steel members
    do !V values !Types
      !Length = DERI LEN of $!V
      !!KFormatText.Text.Val = !Length
         !Lformat = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
      !Dtext.append(!LFormat.string())
      !Rtext.append(!Length.string())
    enddo
    !Dtext.unique()
    !Rtext.unique()

--    !Rtext.clear()
--    do !I from 1 to !Dtext.size()
--      !Rtext.append(!I.string())
--    enddo

    !!MdsFt24.Dim1.Dtext = !Dtext
    !!MdsFt24.Dim1.Rtext = !Rtext

    !!MdsFt24.Dim1.Val = !Dim1

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdslengthft24.pml
