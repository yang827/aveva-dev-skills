--
-- File:		Mdslinkatta.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Tue Jun 17
--
--
-- Description:
-- function to associate an atta to a cross bar on a support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsLinkAtta(!Form is FORM)

  -- Initialise variables
    !Origin     = !!CE
    !Support    = !Form.support
    !Bars       = !Form.Support.Bars
    !Name       = !Form.Support.Stru.name
    !References = ''
    !ColourList = ARRAY()
    !List       = ARRAY()
    !BarNumber  = ARRAY()

  -- Check that framework has been created
    if (!Support.Stru.Mcount() eq 0)then
      !!Alert.error('Support structure has not been created')
      return
    endif

  -- Get list of all attas already associated with bars
    !Associated = ARRAY()
    if (!Support.Bars.empty().not())then
      do !I indices !Support.Bars
        !Associated.appendarray(!Support.Bars[!I])
      enddo
    endif

  -- ************************************************
  --  Identify attas to be associated with cross bar
  -- ************************************************

    do
      PROMPT OFF
      PROMPT LOAD ESCAPE |Identify atta to support|
      ID ATTA @
        handle (61,528)
          if (!List.empty())then
            PROMPT DISMISS
            PROMPT ON
            !!CE = !Support.Stru
  -- Enhance elements using colour set for highlight
            !ColourList = ARRAY()
            if (defined (!Form.support.stru))then
              !ColourList.append(!Form.support.stru)
            endif
            if (!Form.support.atta.empty().not())then
              !ColourList.appendarray(!Form.support.atta)
            endif
  -- Colour Support
            Call !!KEnhanceList(!ColourList)
            return
          else
            break
          endif
        endhandle
      PROMPT DISMISS
      PROMPT ON
      !Picked = !!CE
    -- Check to see if the identified atta is part of the support
      if (!Support.Atta.findfirst(!Picked).set().not())then
        !!Alert.message('This atta is not part of the support')
      elseif (!List.find(!Picked).size() gt 0)then
        !!Alert.message('Atta already selected')
      elseif (!Picked eq !Support.Datum)then
          !!Alert.message('Datum atta cannot be selected')
-----------------------------------------------------------------------
--> Added - <wd> - 26aug1998
-- Reject the SREF atta as if the DATUM atta has been selected,
-- if picked by identifying the LSTU of the BRANCH
      elseif (!picked.name.eq(!name & '/SREF')) then
          !!Alert.message('Datum atta cannot be selected')
--< Added - <wd> - 26aug1998
-----------------------------------------------------------------------
      elseif (!Associated.find(!Picked).size() gt 0)then

      -- Disassociate picked atta with existing bar
        !Result = (!!MdsunlinkAtta(!Form, !Picked))
        if (!Result eq 0)then
          !!Alert.error('Picked Atta is not associated with any cross bar on this support')
        elseif (!Result eq 100)then
          !!Alert.error('The last atta associated with a cross bar cannot be selected')
        else
          !BarNumber.append(!Result)
          !List.append(!Picked)
        -- Colour Attas
          Enhance ce colour 2
          refresh
        endif
      else
        !List.append(!Picked)
      -- Colour Attas
        Enhance ce colour 2
        refresh
      endif
    enddo

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify cross bar to support off|
    ID SCTN @
      handle (61,528)
        PROMPT DISMISS
        PROMPT ON
        !!CE = !Support.Stru
  -- Enhance elements using colour set for highlight
        !ColourList = ARRAY()
        if (defined (!Form.support.stru))then
          !ColourList.append(!Form.support.stru)
        endif
        if (!Form.support.atta.empty().not())then
          !ColourList.appendarray(!Form.support.atta)
        endif
  -- Colour Support
        Call !!KEnhanceList(!ColourList)
        RETURN
      endhandle
    PROMPT DISMISS
    PROMPT ON
    !Sctn = !!CE

-- Can only modify the reference if we can write to it

    if !!MdsComClaimDac(!!ce,'DACMOD','POS').not() then
      !!Alert.Error('Unable to set/unset the reference to the identified sctn as write access is not available')
      Call !!KEnhanceList(!List)
      return
    endif

  -- Test picked section
    if (!Support.Stru.name ne before(!!CE.name, '-BAR'))then
      !!Alert.error('Section picked is not part of support $!Support.Stru.name')
      Call !!KEnhanceList(!List)
      return
    endif

  -- ONLY ADJUST BAR LENGTH IF THERE IS ONLY ONE VERTICAL SUPPORT
    !!CE = !Support.Stru
    !Vertical = !!KCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    SAME
    if (!Vertical.size() lt 2)then

      -- Adjust length of bar that atta has been disassociated from
      !BarNumber.unique()

      do !Indx indices !BarNumber
        if (!support.type inset('FT18' , 'FT19')) then
          call !!MdsAdjusttBar(!Form, !BarNumber[!Indx])
        else
          Call !!MdsAdjustBar(!Form, !BarNumber[!Indx])
        endif
      enddo
    endif

  -- Get existing attas already referenced
    !!CE = !Sctn
    VAR !ExistRef :MDSAttaRef

    if (!ExistRef neq 'unset')then
      !SplitExist = split(!ExistRef)
      !Block = object block('!SplitExist[!EvalIndex].dbref()')
      !Existing = !SplitExist.evaluate(!Block)
      handle(2,757)
        !List.append(!ExistRef.dbref())
      elsehandle none

    -- Add existing refs to new list and make sure the references are unique
        !List.appendarray(!Existing)
        !List.unique()
      endhandle
    endif

    do !I Indices !List
      !References = !References & ' ' & !List[!I].string()
    enddo

  -- Re-set atta references to section
    :MDSAttaRef $!References

  -- Take additional highlight colour off attas
    Call !!KEnhanceList(!List)

  -- Update support data held on form
    !Number = after(!Sctn.name, '-BAR-')

    !Form.Support.Bars[!Number.real()] = !List

  -- Adjust length of bar that atta has been associated with
  -- only if one vertical exists

    if (!Vertical.size() lt 2)then
      if (!support.type inset('FT18' , 'FT19')) then
        call !!MdsAdjusttBar(!Form, !Number.real())
      else
        Call !!MdsAdjustBar(!Form, !Number.real())
      endif
    endif

  -- Reset all pins associated with this support
    Call !!MdsResetPins(1,10)

    !!CE = !Origin

-- End function
endfunction

-- End of file Mdslinkatta.pml
