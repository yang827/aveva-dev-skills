--
-- File:		Mdsloadoption.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          ULOADSEL
--
-- Author:		I.Osborne
-- Created:		Mon Apr 28
--
--
-- Description:
-- Loads standard option gadget for all forms
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         Gadget       Gadget to be populated
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsLoadOption(!Gadget is GADGET)

-- Initialise Variables
  !Dtext = ARRAY()
  !Rtext = ARRAY()

-- Set Data
  !Dtext.append(|ID Cursor|)
  !Rtext.append(|IDCUR|)
  !Dtext.append(|ID P-Point|)
  !Rtext.append(|IDP|)
  !Dtext.append(|Back Mark|)
  !Rtext.append(|BMA|)
  !Dtext.append(|ID Plin start|)
  !Rtext.append(|PLINE START|)
  !Dtext.append(|ID Plin end|)
  !Rtext.append(|PLINE END|)
  !Dtext.append(|ID Plin Intersection|)
  !Rtext.append(|PLINE INTERSECTION|)
  !Dtext.append(|Cursor|)
  !Rtext.append(|CUR|)
  !Dtext.append(|Coordinate...|)
  !Rtext.append(|COORD|)
  !Dtext.append(|Plane...|)
  !Rtext.append(|PLANE|)
  !Dtext.append(|Name...|)
  !Rtext.append(|NAME|)
  !Dtext.append(|Pin...|)
  !Rtext.append(|PIN|)
  !Dtext.append(|Next|)
  !Rtext.append(|NEXT|)
  !Dtext.append(|Tail|)
  !Rtext.append(|TAIL|)
  !Dtext.append(|Previous|)
  !Rtext.append(|PREV|)
  !Dtext.append(|Head|)
  !Rtext.append(|HEAD|)
  !Dtext.append(|Current|)
  !Rtext.append(|CE|)

-- Load Gadget
  !Gadget.Dtext = !Dtext
  !Gadget.Rtext = !Rtext

-- End function
endfunction

-- End of file Mdsloadoption.pml
