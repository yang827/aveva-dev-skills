--
-- File: MdsloadoptionA.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces: ULOADSEL
--
-- Author: D.Whiteside
-- Created: Mon Apr 28 2008
--
--
-- Description:
-- Loads repad option gadget for branch reinforcing forms
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         Gadget       Gadget to be populated
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsLoadOptionA(!gadget is GADGET)

-- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

-- Set Data
  !dtext.append(|Circular pad|)
  !rtext.append(|Circular pad|)
  !dtext.append(|Square plate|)
  !rtext.append(|Square plate|)

-- Load Gadget
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

-- End function
endfunction
