--
--
-- Description:
-- Loads standard option gadget for form MdsAT144-- Author: D.Whiteside
-- Created: 20 November 2008 Clearcase DUN1052
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         Gadget       Gadget to be populated
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsLoadOptionB(!gadget is GADGET)

-- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

-- Set Data
  !dtext.append(|ONE|)
  !rtext.append(|ONE|)
  !dtext.append(|TWO|)
  !rtext.append(|TWO|)

-- Load Gadget
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

-- End function
endfunction
