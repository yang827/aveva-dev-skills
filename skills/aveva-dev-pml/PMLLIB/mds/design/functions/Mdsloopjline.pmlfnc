--
--
-- Description:
-- Function to loop through a defined set of pline as ask the user to confirm
-- or skip to next.
--
--------------------------------------------------------------------------------

define function !!MdsLoopJline(!Option is STRING)

-- The option string will be set to either CENTRE, LEFT, or RIGHT
-- Where
-- Left will loop through all plines starting with L
-- Right will loop through all plines starting with R
-- and CENTRE will loop through all plines not starting with L or R

-- Get all possible plines

  !AllPlines = ARRAY()

  !AllPlines = !!MdsJointSpec.Just.Dtext

-- Sort out required plines

  !LPlines = ARRAY()
  !RPlines = ARRAY()
  !CPlines = ARRAY()
  do !AddPlines values !AllPlines
    if !AddPlines.match('L').eq(1) then
      !LPlines.Append(!AddPlines)
    elseif !AddPlines.match('R').eq(1) then
      !RPlines.Append(!AddPlines)
    else
      !CPlines.Append(!AddPlines)
    endif
  enddo

  if !Option.eq('LEFT') then
    !Plines = !LPlines
  elseif !Option.eq('RIGHT') then
    !Plines = !RPlines
  else
    !Plines = !CPlines
  endif

-- Put the joints to set in a list

  !Joints = ARRAY()
  !SelectedJoints = !!MdsJointSpec.Jlist.Rtext[$!!MdsJointSpec.Jlist.Val]

  if !SelectedJoints.eq('ALL') then
    !List = !!MdsJointSpec.Jlist.Rtext
    do !AddToList values !List
      if !AddToList.match('=').eq(1) then
        !Joints.Append(!AddToList)
      endif
    enddo
  else
    !Joints.Append(!!MdsJointSpec.Jlist.Rtext[$!!MdsJointSpec.Jlist.Val])
  endif

-- Save the current jline settings for the joints

  !SavedJline = ARRAY()

  do !Save values !Joints
    !!CE = !Save.dbref()
    !SavedJline.append(!!CE.jline)
  enddo

  !ConfirmedJline = false
  !Cancel = false

-- Loop through each value of jline and confirm with user to set it or skip or cancel

  do !LoopThrough values !Plines
-- Access Joints and set the jline
    do !SetJline values !Joints
      !!CE = !SetJline.dbref()
      jline $!LoopThrough
    enddo
-- Now confirm
    !Action = !!Alert.Question('Do you require the justification line to be set to ' & !LoopThrough & ' as shown?')
    if !Action.eq('NO') then
      skip
    elseif !Action.eq('YES') then
      !ConfirmedJline = true
      break
    else
      !Cancel = true
      break
    endif
  enddo

-- Reset main form with new jline if a new jline has been confirmed
  if !ConfirmedJline then
    !!CE = !Joints[1].dbref()
    !newjline = !!ce.jline
--    !!MdsJointSpec.Just.select('DTEXT','NA')
    !!MdsJointSpec.Just.select('DTEXT',!newjline)
  elseif !Cancel then
-- User selects cancel or the loop has finished without
-- the user selectibg a new jline
    do !Count from 1 to !Joints.size()
      !!CE = !Joints[$!Count].dbref()
      jline $!SavedJline[$!Count]
    enddo
  endif


endfunction

-- End of file MdsLoopJline.frm
