--
--
-- Description:
-- function to find the lowest/highest ppoint
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1    [R]      [DBREF]       [Atta datum]
--     2    [R]      [STRING]      [Upper/Lower ppoint required]
-- Return:
--    [Data Type]   [Description]
--
--    [REAL]        [Ppoint number]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsLowestPPoint(!Atta is dbref,!UpOrLow is string) is real

   !PPList = ppls of $!Atta

-- Set test for upper or lower point
   if(!UpOrLow.upcase().eq('LOWER')) then
      !WhichLev = 'lt'
   else
      !WhichLev = 'gt'
   endif

   do !ind values !PPList
       !position = p$!ind pos of $!Atta wrt worl
     if(undefined(!DatumPos)) then
       !ppointpos = p$!ind pos of $!Atta wrt worl
       !DatumPos = !ppointpos.up
     endif

     if(!Position.Up.$!WhichLev(!DatumPos)) then
        !PPoint = !ind
        !ppointpos = p$!ind pos of $!Atta wrt worl
        !DatumPos  = !ppointpos.up
     endif

     -- this is not what should happen if(!UpOrLow.upcase().eq('LOWER')) then
     --   !ppointpos = p$!ind pos of $!Atta wrt worl
     --   !DatumPos  = !ppointpos.up
     --endif
   enddo

   Return !Ppoint

  endfunction
-- End function

-- End of file MdsLowestPPoint.pml
