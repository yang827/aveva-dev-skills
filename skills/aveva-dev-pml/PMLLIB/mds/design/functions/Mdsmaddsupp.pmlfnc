--
-- File:		Mdsmaddsupp.pml
--   Type:		Result Macro
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Mon Aug 18
--
--
-- Description:
-- Macro to add an entire support to the drawlist with the currently selected
-- colour form the member list
--------------------------------------------------------------------------------

define function !!MdsMaddSupp(!name is GADGET)

-- Define variable for name

-- Is the name gadget a valid name
  if (!Name.val.upcase() eq |UNSET|)then
    !Name.setfocus()
    !!Alert.Error ('Support has not been selected to add to the drawlist')
    return
  endif

-- Obtain the current colour
  !Visible = !!GphColOpt.Visible().code

-- Add initial member
  !ref = '/' & !Name.Val
  !!MdsRemAdd(|$!ref|,!Visible)

-- Add datum atta
  !!MdsRemAdd(|$!ref$n/DATUM|,!Visible)

-- Add Restraint
  !rname = !ref & '/REST'
  !ceori = !!ce
  !!ce = !rname.dbref()
  handle none
    !!Mdsremadd(|$!rname|,!visible)
  elsehandle any
-- DBREF does not exist
  endhandle

--<kp>feb07 Add supported light
   !Light = !ref.dbref().:MdsSref.Name
      handle NONE
        !!Mdsremadd(!Light,!Visible)
      elsehandle ANY
        -- no link to light
      endhandle

-- Add all additional members
  do !count from 1 to 30
    !!MdsRemAdd(|$!ref$n.$n$!count|,!Visible)
 -- enddo
--------------------------------****** connexions ******* -------------------------------
--<wd>19dec2000
-- Determine the Connected Joints for the MDS support, if any exist,
-- so that they can be added to to the Graphical Display
--
    !!ce = !ref.dbref()
    !cenam = !!ce.name
--Skip if type is NOT a STRUCTURE, or is STRUCTURE but is a BedPlate Type - FT22
    skip if (!!ce.type.neq('STRU'))
    skip if (!!ce.:MDSSuppType.eq('FT22'))

    !VertDbref    = array()
    !Vert1        = !cenam & '-V1'
    !Vertdbref[1] = !Vert1.dbref()
    handle any
-- incase  no Verts (bed plate) (may be (-BAR-1 for FT14 or FT07))
      !Vert1        = !cenam & '-BAR-1'
      !Vertdbref[1] = !Vert1.dbref()
      handle any
      endhandle
    elsehandle none
      !Vert2        = !cenam & '-V2'
      !Vertdbref[2] = !Vert2.dbref()
      handle any
-- Supports where ONE Cross Bar may also be connected (FT10,FT11,FT13,FT15,DT02,FT38,FT62,FT63)
        !Vert2        = '/' & !Name & '-BAR-1'
        !Vertdbref[2] = !Vert2.dbref()
        handle any
-- incase only one SCTN exists
        endhandle
      endhandle
    endhandle
-- Add the External Connected Joints, if any EXIST, to the Graphical Display
    !joints = !!Mdsgetnodes(!vertdbref)
    handle none
      do !conn values !joints
        !!Mdsremadd('$!conn',!visible)
      enddo
    elsehandle any
      -- no EXTERNAL joints
    endhandle

  enddo
--<wd>19dec2000
-----------------------------------------------------------------------------------------

-- Leave user at support structure or attachment

  !!CE = !ref.dbref()

endfunction

return
