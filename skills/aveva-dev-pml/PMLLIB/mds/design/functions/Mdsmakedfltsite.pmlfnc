--
-- File:    Mdsmakedfltsite.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDEFSITE
--
-- Author:    I.osborne
-- Created:   Wed Apr 30
--
--
-- Description:
-- Creates or sets a default site for supports
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMakeDfltSite()

  !origin = !!ce

  -- Set the selected zone as the default creation zone

  !site = !!mdsDefaultSite.site.selection('Dtext')
  !!mdsOptions.site.val = '/' + !site

  !siteForHangers = !!mdsDefaultSite.siteForHangers.selection('Dtext')
  if (!siteForHangers.unset() or !siteForHangers.trim() eq '') then
    !!mdsOptions.siteForHangers.val = 'Not Set'
  else
    !!mdsOptions.siteForHangers.val = '/' + !siteForHangers
  endif

  !!ce = !origin
  handle any
  endhandle

  -- The main selection forms now are re sizeable. The DES-SUPP-DEFS file has a list
  -- with their sizes allocated. We need to reload the appropriate forms.

  if (undefined(!!mdsFormsLoaded)) then
    pml reload form !!mdsFrame
    pml reload form !!mdsGeneral
    pml reload form !!mdsCable
    pml reload form !!mdsHvac
    pml reload form !!mdsAnchor
    pml reload form !!mdsFhanger
    pml reload form !!mdsGuide
    pml reload form !!mdsSlip
    pml reload form !!mdsSpring
    pml reload form !!mdsTrunn
    pml reload form !!mdsVessel
    pml reload form !!mdsBranRein
    !!mdsFormsLoaded = true
  endif

  -- If the autonaming form is displayed then reset it

  !autoNameFile = !!mdsOptions.site.val.dbref().:MdsAutoFile
  if !autoNameFile.neq('unset') then
    !!mdsAutoName.showFiles()
    !!mdsAutoName.setFile()
  endif

  !!ce = !origin

  -- End function
endfunction
