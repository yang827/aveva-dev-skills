--
--
-- Description:
-- Function to Apply the Alignment Utility for MDS Frameworks
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsmalign(!form is FORM)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

-- Initialise Variables
    !support = !form.support

-- Check if the Form !!kgphalign gadgets are unset/blank
   if (!!kgphalign.x.val.unset()) then
     !!kgphalign.x.val = 0
   endif
   if (!!kgphalign.y.val.unset()) then
     !!kgphalign.y.val = 0
   endif
   if (!!kgphalign.z.val.unset()) then
     !!kgphalign.z.val = 0
   endif
   if (!!kgphalign.distance.val.unset()) then
     !!kgphalign.distance.val = 0
   endif

-- Get the ORTHOGONAL Plane Direction of the DATUM
-- Support Attas' - 'Pleave' Direction
    !planedir = !!kcalcorthdir(!support.datum)
   if (!!kgphalign.direction.val.unset()) then
     !!kgphalign.direction.val = !planedir.string()
   endif

-- Position Pin 10, Pins 1, 2 and 3 are to be Located by using
-- the 'EDG' object values defined via the - 'Alignment Utility'
-- Direct them in the ORTHOGONAL Plane Direction of the DATUM Atta 'Pleave Direction'.
--<wd>--june2000
-- Switch Back Temporarily to Correct Units when Reading (Hidden)
-- Form Object members NOT Displayed on the Screen
    !!kRestoreUnits(!currentunits)
    pin 1 at $!!kgphalign.dimension.from
    pin 2 at $!!kgphalign.dimension.to
    units mm dist
    units mm bores
--<wd>--june2000
    pin 1 direct $!planedir
    pin 2 direct $!planedir
    pin 10 copy pin 1
    pin 10 plane pin 10 thro pin 2

-- Determine the DISTANCE the Support has to move.
    !p1p10dist = !!kstrreal('const dist pin 1 to plane pin 10')

-- Determine the DIRECTION the Support has to move (+ve or -ve).
-- Set object definition
    if (!p1p10dist.eq(0)) then
      !p10p1dir = !planedir.string()
    else
      pin 10 direct to pin 1
      var !p10p1dir cons dire pin 10 to pin 1
    endif

    !direction = object KEQUALDIR()
    !direction.directionA = !planedir
    !direction.directionB = !p10p1dir.direction()
    !direction.tolerance  = 0.05

    if (!!kdirequaldir(!direction).not()) then
-- Support has to move Forwards (+ve)
      !!Mdsaligndist(!form,'PLUS',!p1p10dist)
    else
-- Support has to move Backwards (-ve)
      !!Mdsaligndist(!form,'MINUS',!p1p10dist)
    endif

-- Reset Units
    !!kRestoreUnits(!currentunits)

-- Reset Pins
    !!Mdsresetpins(1,10)

-- adjust anciliary welds to suit the beams they sit on
   !!MdsWeldAdjust(!form)
   handle ANY
    $p error in weld adjustment during MDS align function
   endhandle

  endfunction
-- End of function

-- End of function Mdsmalign.pml
