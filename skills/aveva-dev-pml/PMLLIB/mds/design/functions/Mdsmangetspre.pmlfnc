--
-- File:                MdsManGetSpre.pml
--   Type:              Process
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             19 Mar 1998
--
--
-- Description:
-- Function to set the mtor reference to the spre of the current pipe spec
-- or out of spec if reqd, for  extra details on the isometric.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [DBREF]       [Spec to search]
--     2     R       [STRING]      [generic type to find]
--     3     R       [REAL]        [Bore size of Trunnion]
--     4     RW      [ARRAY]       [Array of selections available]
-- Return:
--    [Data Type]   [Description]
--
--    [BOOLEAN]     [Successful search]
--
--------------------------------------------------------------------------------




define function !!MdsManGetSpre(!Spec is dbref,!Type is string,!Bore is real,!Selection is array)  is boolean


-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()





-- Goto Spec and search for criteria

   !GType     = !!KCollectAllFor('SELE','owner eq $!Spec and tans eq |TUBE|', !Spec)
   if(!Gtype.Unset()) then
      -- if no tube in spec
         Return False
   endif
   !BoreSele  = !!KCollectAllFor('SELE','owner eq $!Gtype[1] and answ eq $!Bore', !Gtype[1])
    if(!BoreSele.Unset()) then
      -- if no tube at the bore requested in spec
         Return False
   endif

-- This far will be successful

   !Selection = !!KCollectAllFor('SPCO','',!BoreSele[1])

-- go back to original element



-- Reset Units

   !!kRestoreUnits(!currentunits)



   Return True

endfunction

-- end function MdsManGetSpre
