define function !!mdsMConn(!point is STRING,!direction is STRING)

--$P****************
--q order name type
--$P****************

  !!mdsDacControl(true)

  if !!ce.type.eq('CTSUPP') then
    pos p1 at p1 of owner
    ori p1 is p1 of owner
    return
  else
    if !!ce.sequ.eq(1) then
      pos pa at PH
      ori
    else
      pos pa at pl of prev
      ori
    endif
  endif

  VAR !exists (DEFINED(!!hVACONLY))

  VAR !spref SPREF
  VAR !match (MATCH ('$!spref', '/DS') )
  VAR !spref ( (SUBS ('$!spref', $!match) ) )

  if (|$!spref| EQ |DS109-B-1| OR |$!spref| EQ |DS109-B-2| OR |$!spref| EQ |DS109-B-3|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS109-A-1.1| OR |$!spref| EQ |DS109-A-2.1| OR |$!spref| EQ |DS109-A-3.1|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS109-A-1.2| OR |$!spref| EQ |DS109-A-2.2| OR |$!spref| EQ |DS109-A-3.2|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS109-A-1.3| OR |$!spref| EQ |DS109-A-2.3| OR |$!spref| EQ |DS109-A-3.3|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS109-A-1.4| OR |$!spref| EQ |DS109-A-2.4| OR |$!spref| EQ |DS109-A-3.4|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS110-B.1| OR |$!spref| EQ |DS110-B.2| OR |$!spref| EQ |DS110-B.3| OR |$!spref| EQ |DS110-B.4|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS110-A.1| OR |$!spref| EQ |DS110-A.2| OR |$!spref| EQ |DS110-A.3| OR |$!spref| EQ |DS110-A.4|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS111-A.1| OR |$!spref| EQ |DS111-A.2| OR |$!spref| EQ |DS111-A.3| OR |$!spref| EQ |DS111-A.4|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  elseif (|$!spref| EQ |DS111-B.1| OR |$!spref| EQ |DS111-B.2| OR |$!spref| EQ |DS111-B.3| OR |$!spref| EQ |DS111-B.4|) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)
        ORI
      endhandle
    else
      ORI
    endif
  endif
  if (|$!exists| EQ |0| or !exists.boolean().not()) then
    if (|$!point| NEQ |ORI|) then
      ORI AND P$!point IS $!direction
      handle (61,7)(2,360)  $* (2,360) Cannot get position of ATTACHMENT <name> -- added by <wd>jan2004
        ORI
      endhandle
    else
      ORI
    endif
  endif

-- Set the mtoc attribute of the sref atta

  if !!ce.name.match('/SREF').gt(0) then
    !styp = !!mdsgetstyp(!!ce)
    !varString = '!!mdsSel$!styp$n.mtoc'
    if (defined($!varString)) then
      if $!varString then
        mtoc on
      else
        mtoc off
      endif
    endif
  endif
--  q name
  -- If the styp is a PIPE-REST-INLINE then we need to orientate the P12 in the direction of the support

  if !!ce.styp.eq('PIPE-REST-INLINE') then
    if !!ce.owner.href.badref().not() then
      if !!ce.owner.href.type.eq('TEE') then
        ori and p12 is pl of href of bran
      elseif !!ce.owner.href.type.eq('REDU') then
        ori and p12 is pl of href of bran
      elseif !!ce.owner.href.type.eq('ELBO') then
        !paofhref = !!ce.owner.href.apos
        !plofhref = !!ce.owner.href.lpos
        if !paofhref.up.gt(!plofhref.up) then
          ori and p12 is pl of href of bran
        else
          ori and p12 is pa of href of bran
        endif
      elseif !!ce.owner.href.type.eq('CROS') then
        ori and p12 is pl of href of bran
      endif
    endif
  endif

  --  !!mdsDacControl(false)
return
