--
-- File:		Mdsminusdist.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Aug 07
--
--
-- Description:
-- facility to nudge pipe support back along the path of the pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMinusDist(!Form is FORM)

  -- Initialise variables
    !Support = !Form.Support
    !CurrentDist = !Form.Dist.val
    !NudgeDist   = !!MdsNudge.Distance.val

  -- If value set to 0 return
    if (!NudgeDist eq 0) then
      return
    endif

  -- Work out new distance from previous component
    !Distance = !CurrentDist - !NudgeDist

-- Check Type of Framework
    if (!form.string() eq 'MdsFT28') then
      !!Mdsnudgeft28(!form, 'MINUS')
    else
-- Update forms distance gadget
      !Form.Dist.val = !Distance

-- Run function to move support
      !!MdsPosDist(!Form)
--<GE> 05/02/07 Fix for Defect: 10214
      handle ANY
      endhandle
--<GE> 05/02/07
    endif

-- End function
endfunction

-- End of file Mdsminusdist.pml
