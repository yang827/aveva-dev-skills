--
-- File:		MdsmirrorVT24.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorVT24()

  -- Initialise variables
    !Support  = !!MdsVT24.Support
    !Stru     = !Support.Stru
    !Name     = !Stru.name
    !Frame    = !Name & '/MAIN'
    !Origin   = !!CE
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Vertical = !!KCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    VAR !SupportFrame  EXISTS $!Frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif

    !!CE = $!<Name>-V1
    VAR !Drns DRNS WRT WORLD
    VAR !Drne DRNE WRT WORLD
    !Udir = !Drns

  -- Cross-Bars

  -- If the cross bar has joints then this will not need doing as the setting of jois and joie
  -- will sort the ori out

    do !V values !Bars

      !!CE = !V
      PIN 9 AT STRU
      PIN 9 DIR $!Support.P11DIR
      VAR !Midp DERI MIDP
      PIN 8 AT $!Midp
      PIN 9 PLANE PIN 9 THRO PIN 8
      PIN 9 DIR $!Udir WRT WORLD
      ROTATE THRO PIN 9 ABOUT $!Udir WRT WORLD BY 180

    enddo

  -- Vertical members

    do !V values !Vertical
      !Joie = !V.joie
      !Jois = !V.jois
-- temporarily remove joint ref
      !!CE = !V
      JOIS NULREF
      JOIE NULREF
      PIN 9 AT STRU
      PIN 9 DIR $!Support.P11DIR
      VAR !Midp DERI MIDP
      PIN 8 AT $!Midp
      PIN 9 PLANE PIN 9 THRO PIN 8
      PIN 9 DIR $!Udir WRT WORLD

      ROTATE THRO PIN 9 ABOUT $!Udir WRT WORLD BY 180
--$(
--------------------------------------***** connexions ***** ------------------------------
      JOIS $!JOIS
      JOIE $!JOIE
-------------------------------------------------------------------------------------------
--$)
      FLIP

  enddo

    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!MdsVT24, 'FRAME')

--$(

-------------------------------------------------------------
-------------------------------------------------------------
----------------------------- **** connexions **** -----------------------------

      !HaveJoints = FALSE

   if(!Support.Joints.unset().not()) then
      !Joints     = !Support.Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
       handle ANY
        !HaveJoints = FALSE
        !Support.Joints.Clear()
        -- in case they have been deleted and cancel is used
       endhandle
   endif

---------------------------------------------------------------------------------

 if(!HaveJoints) then
    do !Index indices !Joints
     -- if support cursor picking is too unlike the existing then the connections will fail
        if(!Joints[!Index].badref()) then
           !!alert.Error('Reconnection is not possible, connections will be deleted.')
           !!MdsSelectJoints(!!MdsVT24,'DISCONNECT','')
           !Support.Joints.clear()
           break
         endif

         if(!Attributes[!Index][8].dbref().:MDSConn.eq(!Joints[!index].owner.owner)) then
            !Mainstl = !Attributes[!Index][8].dbref().:MDSConn
            !Support.Joints[!Index] =  !!MdsCreateJoint(!MainStl, !Attributes[!Index][8].dbref(),!Joints[!Index],!Attributes[!Index])
         endif
    enddo
 endif
----------------------------------------------------------------------

--$)

  -- If the support is mirrored and contains joints because the joints remain on the same side then
  -- the cross bars will require and extra flip

   do !Flip values !Bars
     !!CE = !Flip
     if !!CE.jois.badref().not() or !!CE.joie.badref().not() then
       flip
     endif
     reconn recalc
   enddo

  -- Reset pins
    Call !!MdsResetPins(7,9)

  -- Reset Form Gadget
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

 -- If a joint is being used and it is handed then their will be a alternative spref of the
 -- opposite hand joint and the bang to set seperated by a ,

    !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

    !!CE = !Origin

  -- Update support data held in form
    !!MdsVT24.Support = !Support

-- End function
endfunction

-- End of file MdsmirrorVT24.pml
