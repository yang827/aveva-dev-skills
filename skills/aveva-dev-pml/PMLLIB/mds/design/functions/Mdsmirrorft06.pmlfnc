--
-- File:		Mdsmirrorft06.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS129
--
-- Author:		I.Osborne
-- Created:		Thu Jun 26
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorFt06()

  -- Initialise variables
    !Support = !!MdsFt06.Support
    !Stru    = !Support.Stru
    !Name    = !Stru.name
    !Frame   = !Name & '/MAIN'
    !Origin  = !!CE
    !Bars    = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    VAR !SupportFrame  EXISTS $!Frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif


    !!CE = $!<Name>-V1
--<kp>nov06
    --VAR !Drns DRNS WRT WORLD
    --!Udir = !Drns
    !Udir = !!ce.zdir.wrt(worl).string().before(' WRT')
    var !Drne drne
    var !Drns drns

  -- Vertical member

    !Joie = !!CE.joie
    !Jois = !!CE.jois


    PIN 9 AT STRU
    PIN 9 DIR U
    VAR !Midp DERI MIDP
    --<k.pleschner>nov06 - use pseudoatt MIDP in order the exact value to be regarded
    --PIN 8 AT $!Midp
    pin8 at midpoint
    PIN 9 PLANE PIN 9 THRO PIN 8
    PIN 9 DIR $!Udir WRT WORLD
    PIN 9 PLANE PIN 9 THRO PIN 8

--------------------------------------***** connexions ***** ------------------------------
-- for some reason the rotate command rotates the joints as well as the attached,
-- and I'm not sure it should do that. To get around this :-
   !Joie = !!CE.joie
   !Jois = !!CE.jois
-- temporarily remove joint ref
--<K.Pleschner> June 2005
-- handle pads of angle profiles
   !!MdsMirrorPads(ce,'PREPROCESS')
-------------------------------------------------------------------------------------------
-- Rotate Horizontal Sctn '$!<Name>-V1'
    ROTATE THRO PIN 9 about U wrt WORLD by 180
--------------------------------------***** connexions ***** ------------------------------
   JOIS $!JOIS
   JOIE $!JOIE

    --<kp>nov06
    -- flip cutplanes at both ends
    drne $!drns
    drns $!drne

--<kp>Mar07 Flip snipes
    !!mdsMirrorSnipes(ce)

---------------------------****** connexions *******----------------------------------
-- do a frig cos flip isnt used
        !!MdsFrigConns($!<Name>-V1 )
        !!MdsMirrorPads(ce,'EXECUTE')
--------------------------------------------------------------------------------------

  -- Cross-Bars
    do !V values !Bars
      !!CE = !V
      !Joie = !!CE.joie
      !Jois = !!CE.jois
--<k.pleschner>nov06
      var !drne drne
      var !drns drns

--<K.Pleschner> June 2005
-- handle pads of angle profiles
      !!MdsMirrorPads(!V,'PREPROCESS')

      PIN 9 AT STRU
      PIN 9 DIR U
      VAR !Midp DERI MIDP
      --<k.pleschner>nov06 - use pseudoatt MIDP in order the exact value to be regarded
      --PIN 8 AT $!Midp
      pin8 at midpoint
      PIN 9 PLANE PIN 9 THRO PIN 8
      PIN 9 DIR $!Udir WRT WORLD
      ROTATE THRO PIN 9 ABOUT $!Udir WRT WORLD BY 180
      JOIS $!JOIE
      JOIE $!JOIS

--<k.pleschner>nov06 flip cutting planes
      drne $!drns
      drns $!drne

--<kp>Mar07 Flip snipes
      !!mdsMirrorSnipes(!V)

      !!MdsMirrorPads(!V,'EXECUTE')

    enddo

    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsft06, 'FRAME')

----------------------------- **** connexions **** -----------------------------
--$(
      !HaveJoints = FALSE
   if(!Support.Joints.unset().not()) then
      !Joints     = !Support.Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
       handle ANY
        !HaveJoints = FALSE
        !Support.Joints.Clear()
        -- in case they have been deleted and cancel is used
       endhandle
   endif

   if(!HaveJoints) then

     do !Index indices !Joints
     -- if support cursor picking is too unlike the existing then the connections will fail
        if(!Joints[!Index].badref()) then
           !!alert.Error('Reconnection is not possible, connections will be deleted.')
           !!MdsSelectJoints(!Form,'DISCONNECT','')
           !Support.Joints.clear()
           break
         endif

         if(!Attributes[!Index][8].dbref().:MDSConn.eq(!Joints[!index].owner.owner)) then
            !Mainstl = !Attributes[!Index][8].dbref().:MDSConn
            !Support.Joints[!Index] =  !!MdsCreateJoint(!MainStl, !Attributes[!Index][8].dbref(),!Joints[!Index],!Attributes[!Index])
         endif
     enddo
   endif
--$)
----------------------------------------------------------------------

  -- Reset pins
    Call !!MdsResetPins(7,9)
    !!CE = !Origin

  -- Reset Form Gadget
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

-- If a joint is being used and it is handed then their will be a alternative spref of the
 -- opposite hand joint and the bang to set seperated by a ,
    !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

-- Move the snod of the V1 through the BAR
   !!CE = $!<Name>-V1
   var !Sjois coll all sjoi for ce
   do !ResetZdist values !Sjois
     !!CE = !ResetZdist.dbref()
     !Cref = !!CE.cref
     end
     zdist Through $!cref
   enddo

 -- Modify weld positions if needed

  !!MdsWeldPositions(!!MdsFt06,!Support.Stru,!Support.Mirror)

   !!CE = !Origin

  -- Update support data held in form
    !!MdsFt06.Support = !Support

-- End function
endfunction

-- End of file Mdsmirrorft06.pml
