--
-- File:		Mdsmirrorft07.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS130
--
-- Author:		I.Osborne
-- Created:		Thu Jun 26
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorFt07()

  -- Initialise variables
    !Support = !!MdsFt07.Support
    !Name    = !Support.Stru.name
    !Frame   = !Name & '/MAIN'
    !Origin  = !!CE
    !Bar     = !Name & '-BAR-1'
    !P9Dir   = !Support.P9Dir
    VAR !SupportFrame  EXISTS $!Frame

-- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

-- Check the template selected can be mirrored
    if !Support.Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru
    if !!MdsComClaimDac(!Name.dbref(),'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif

-- Get the current MIRROR status and set the !udir direction
    !!mdsresetpins(8,9)

--<wd>nov2004
-- Get the ORTHOGONAL P9 Direction for Correct ROTATION about Pin 9
    !datum = !support.datum
    !directions = !!mdsremovegrad(!datum)
    !p9dir = !directions[3]
    !p10dir = !directions[5]
    !p11dir = !directions[6]
    !!ce = $!bar
--<wd>nov2004

    if (!!mdsft07.support.mirror) then
      !udir = !p10dir
    else
      !udir = !p11dir
    endif

-- Cross-Bars
    !!CE = $!Bar
    PIN 9 AT STRU
    PIN 9 DIR $!Udir
    VAR !Midp DERI MIDP
    PIN 8 AT $!Midp
    PIN 9 PLANE PIN 9 THRO PIN 8
    PIN 9 DIR $!P9dir


--------------------------------------***** connexions ***** ------------------------------
-- for some reason the rotate command rotates the joints as well as the attached,
-- and I'm not sure it should do that. To get around this :-
   !Joie = !!CE.joie
   !Jois = !!CE.jois
-- temporarily remove joint ref
--<K.Pleschner> June 2005
-- handle pads of angle profiles
   !!MdsMirrorPads(ce,'PREPROCESS')

-------------------------------------------------------------------------------------------
   !SctnDrne = drne
   !SctnDrns = drns
-- Rotate Cross Bar to in effect 'MIRROR' the cross bar
    ROTATE THRO PIN 9 ABOUT PIN 9 BY 180

--------------------------------------***** connexions ***** ------------------------------
   JOIS $!JOIS
   JOIE $!JOIE
-- frig cos flip isnt used
   !!MdsFrigConns(!!CE)


   Drne $!SctnDrns
   Drns $!SctnDrne

--<kp>Mar07 Flip snipes
    !!mdsMirrorSnipes(ce)


   !!MdsMirrorPads(ce,'EXECUTE')

--------------------------------------------------------------------------------------

    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsft07, 'FRAME')
-------------------------------------------------------------
-------------------------------------------------------------

----------------------------- **** connexions **** -----------------------------
      !HaveJoints = FALSE
   if(!Support.Joints.unset().not()) then
     !Joints     = !Support.Joints
     !Attributes = array()
     !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
     handle ANY
       HaveJoints = FALSE
      !Support.Joints.Clear()
-- in case they have been deleted and cancel is used
     endhandle
   endif

   if(!HaveJoints) then
     do !Index indices !Joints
-- if support cursor picking is too unlike the existing then the connections will fail
       if(!Joints[!Index].badref()) then
         !!alert.Error('Reconnection is not possible, connections will be deleted.')
         !!MdsSelectJoints(!Form,'DISCONNECT','')
         !Support.Joints.clear()
         break
       endif

       if(!Attributes[!Index][8].dbref().:MDSConn.eq(!Joints[!index].owner.owner)) then
         !Mainstl = !Attributes[!Index][8].dbref().:MDSConn
         !Support.Joints[!Index] =  !!MdsCreateJoint(!MainStl, !Attributes[!Index][8].dbref(),!Joints[!Index],!Attributes[!Index])
       endif
     enddo
   endif
----------------------------------------------------------------------

-- Reset pins
   Call !!MdsResetPins(8,9)

-- Reset Form Gadget
   if (!Support.Mirror)then
     !Support.Mirror = false
   else
     !Support.Mirror = true
   endif

-- Update support data held in form
   !!MdsFt07.Support = !Support

-- Move the "Field Weld" from one end to the other
-- We have to set the :MDSOrigin attribute of the stru to START or END, this is
-- where the field weld unless it's already set

--> Added - <wd> - 25aug1998
-- Navigate to Support Structure
   !!CE = !Support.Stru
--< Added - <wd> - 25aug1998

   !ExOrigin = :MDSOrigin

   if (!ExOrigin eq 'START') then
     :MDSOrigin 'END'
     var !pos ( pose of sctn 1 of frmw 1 of $!Support.stru wrt world)
   else
     :MDSOrigin 'START'
     var !pos ( poss of sctn 1 of frmw 1 of $!Support.stru wrt world)
   endif

   !Desc = desc of /MDS/TEMPLATES
   if !Desc.eq('Framatome Templates') then
     !FieldText = ''
   else
     !FieldText = 'Field Weld'
   endif

   $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300 $<$!FieldText$> $<$!Pos$>

-- Modify weld positions if needed
   !!MdsWeldPositions(!!MdsFt07,!Support.Stru,!Support.Mirror)

   !!CE = !Origin

-- End function
endfunction

-- End of file Mdsmirrorft07.pmlfnc
