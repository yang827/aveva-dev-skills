--
-- File:  Mdsmirrorft13.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MMIRPS137
--
-- Author:  I.osborne
-- Created:  Mon Jul 21
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMirrorFT13()

  -- Initialise variables
  !support  = !!mdsFT13.support
  !stru     = !support.stru
  !name     = !stru.name
  !frame    = !name & '/MAIN'
  !origin   = !!ce
  VAR !supportFrame  EXISTS $!frame

  -- Check that support structure has been created
  if (!supportFrame eq 'FALSEA')then
    !!alert.message('Support structure has not been created')
    return
  endif

  -- Check the template selected can be mirrored

  if !stru.:mdsFraMirror.not() then
    !!alert.message('The currently selected template cannot be mirrored')
    return
  endif

  -- Can only mirror framwork if we can write to the stru

  if !!mdsComClaimDac(!stru,'DACMOD','POS').not() then
    !!alert.error('Unable to mirror support as write access to the support structure is not available')
    return
  endif

  -- Get Plane direction that attas have to move
  !pldir = !support.pldir

  -- Plane direction is nearest value to 1
  !up = (abs(!pldir.up))
  !east = (abs(!pldir.east))
  !north = (abs(!pldir.north))
  !max = max((abs(!up)), (abs(!east)), (abs(!north)))
  if (!max eq !up)then
    !planeDir = U wrt world
  elseif (!max eq !east)then
    !planeDir = E wrt world
  else
    !planeDir = N wrt world
  endif

  -- Get all required members
  !bars     = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !support.stru)
  !vertical = !!kCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !support.stru)
  !subs     = !!kCollectAllFor('SUBS', '((match(name, |/SUBS1|) gt 0))', !support.stru)

  !udir = D

  -- Cross-Bars

  do !v values !bars

    !!ce = !v
    !joie = !!ce.joie
    !jois = !!ce.jois
    !drns = !!ce.drns
    !drne = !!ce.drne
    --<K.pleschner> June 2005
    -- handle pads of angle profiles
    !!mdsMirrorPads(!v,'PREPROCESS')

    PIN 1 AT $!stru
    PIN 1 DIR $!support.p11DIR
    VAR !midp DERI MIDP
    PIN 2 AT $!midp
    PIN 1 PLANE PIN 1 THRO PIN 2
    PIN 1 DIR $!udir
    ROTATE THRO PIN 1 ABOUT $!udir BY 180

    JOIS $!joie
    JOIE $!jois
    DRNS $!drne
    DRNE $!drns


    --$(
    ---------------------------****** connexions *******----------------------------------
    -- do a frig cos flip isnt used
    -- !!mdsFrigConns(!v)
    ------------------------------------------------------
    --$)

    -- <K.pleschner>  June2005  PADs of angle profiles
    !!mdsMirrorPads(!v,'EXECUTE')

  enddo

  -- Subs

  do !v values !subs

    !!ce = !v
    PIN 1 AT $!stru
    PIN 1 DIR $!support.p11DIR
    PIN 2 AT CE
    PIN 1 PLANE PIN 1 THRO PIN 2
    PIN 1 DIR $!udir
    ROTATE THRO PIN 1 ABOUT $!udir BY 180

  enddo

  -- Vertical members

  do !v values !vertical

    !!ce = $!v
    PIN 1 AT $!stru
    PIN 1 DIR $!support.p11DIR
    VAR !midp DERI MIDP
    PIN 2 AT $!midp
    PIN 1 PLANE PIN 1 THRO PIN 2
    PIN 1 DIR $!udir
    ROTATE THRO PIN 1 ABOUT $!udir BY 180
    PIN 2 AT CE

    --------------------------------------***** connexions ***** ------------------------------
    -- for some reason the rotate command rotates the joints as well as the attached,
    -- and I'm not sure it should do that. To get around this :-

    !joie = !v.joie
    !jois = !v.jois
    --<K.pleschner> June 2005
    -- handle pads of angle profiles
    !!mdsMirrorPads(!v,'PREPROCESS')
    -------------------------------------------------------------------------------------------

    ROTATE THRO PIN 1 ABOUT $!udir BY 180

    --------------------------------------***** connexions ***** ------------------------------

    JOIS $!jois
    JOIE $!joie

    -------------------------------------------------------------------------------------------

    FLIP
    MOVE $!planeDir THRO PIN 2

    -- <K.pleschner>  June2005  PADs of angle profiles
    !!mdsMirrorPads(!v,'EXECUTE')

  enddo

  !!ce = !support.stru

  -------------------------------------------------------------
  -------------------------------------------------------------
  -- Mirror Packing Pieces if any Associated with the Framework
  call !!mdsMirrorFT25(!!mdsFT13, 'FRAME')

  -------------------------------------------------------------
  -------------------------------------------------------------

  -- Reset pins
  Call !!mdsResetPins(1,2)

  !!ce = !origin

  -- Reset Form Gadget
  if (!support.mirror)then
    !support.mirror = false
  else
    !support.mirror = true
  endif

  !alias = !support.alias

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set seperated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- Move the snod of the BAR through the V1

  if !alias.eq('FT13') then

    !!ce = $!<name>-BAR-1
    var !sjois coll all sjoi for ce
    do !resetZdist values !sjois
      !!ce = !resetZdist.dbref()
      !cref = !!ce.cref
      !!ce = !cref
      if !!ce.jois.eq(same) then
        !pos = poss
      else
        !pos = pose
      endif
      same
      end
      zdist through $!pos
    enddo

  else

    -- Reposition brace for FT39 only

    snod 1 of $!<name>-BAR-1
    handle none
      if !support.mirror then
        if !support.rotateCur then
          zdist 300mm
        else
          zdist 300mm from end
        endif
      else
        if !support.rotateCur then
          zdist 300mm from end
        else
          zdist 300mm
        endif
      endif
    elsehandle any
    endhandle

  endif

  -- Modify weld positions if needed

  !!mdsWeldPositions(!!mdsFT13,!support.stru,!support.mirror)

  -- Update support data held in form
  !!mdsFT13.support = !support

endfunction
