--
-- File:		Mdsmirrorft15.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIR139H/T/V/W
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 1st October 1997
--
--
-- Description:
-- function to Mirror Structural Framework of type 'Ft15'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorft15(!call is boolean)

-- Initialise variables
    !Support  = !!Mdsft15.Support
    !Stru     = !Support.Stru
    !Name     = !Stru.name
    !Frame    = !Name & '/MAIN'
    !Origin   = !!CE
    VAR !SupportFrame  EXISTS $!Frame

-- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif


    -- Check the template selected can be mirrored

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


-- Get all required members
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)

    if (!Support.PADir eq U or $!Support.PLDir eq U)then
      if (!Support.config neq 1 and !call) then
        !!alert.message ('Unable to Mirror this Framework Configuration. Rotate Atta(s) and Rebuild Framework via the - Create by Cursor - option')
        return
      else
        !Udir = !Support.P9dir
      endif
   else
      !Udir = D
    endif

-- Mirror Cross-Bars
    do !V values !Bars

      !!CE = !V
      !Joie = !!CE.joie
      !Jois = !!CE.jois
      --JOIE NULREF
      --JOIS NULREF
--<K.Pleschner> June 2005
-- handle pads of angle profiles
      !!MdsMirrorPads(!V,'PREPROCESS')


      PIN 1 AT STRU
      PIN 1 DIR $!Support.P11DIR
      VAR !Midp DERI MIDP
      PIN 2 AT $!Midp
      PIN 1 PLANE PIN 1 THRO PIN 2
      PIN 1 DIR $!Udir

--$(
--------------------------------------***** connexions ***** ------------------------------
-- for some reason the rotate command rotates the joints as well as the attached,
-- and I'm not sure it should do that. To get around this :-

-------------------------------------------------------------------------------------------
--$)
      ROTATE THRO PIN 1 ABOUT $!Udir BY 180

      JOIS $!JOIE
      JOIE $!JOIS

-- <K.Pleschner>  June2005  PADs of angle profiles
     !!MdsMirrorPads(!V,'EXECUTE')


    enddo

-------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------

-- Mirror Vertical Section on Config '4' ONLY
-- *** Horizontal Pipes Only ***
-- Navigate to Vertical Section
     if (!support.config eq 4 and !call ) then
       !!ce = $!<name>-V1
       pin 1 copy p10 of $!Support.datum
       pin 1 at p9 of $!support.datum
       pin 1 plane pin 1 thro $!<name>-V1
       rotate thro pin 1 about $!udir by 180
       flip
-- <K.Pleschner>  June2005  PADs of angle profiles
      !!MdsMirrorPads(CE,'EXECUTE')
     endif
-- Mirror Vertical Section on Config '4' ONLY

-------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------

-- Navigate to Structure
    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsft15, 'FRAME')

-------------------------------------------------------------
-------------------------------------------------------------

-- Reset pins
    Call !!MdsResetPins(1,2)

-- Navigate to Original Database Element
    !!CE = !Origin

-- Reset Form Gadget to Alternate Setting
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

-----------------------------------------------------------
-- If a joint is being used and it is handed then their will be a alternative spref of the
 -- opposite hand joint and the bang to set seperated by a ,

    !!MdsSwapIntJoi(!Support.Stru,!Support.Mirror,!Support.Alias)

-- If the cross bar has a joint then reset its zdist

    sjoi 1 of snod 1 of $!<Name>-BAR-1
      handle none
         !Cref = cref
         end
         zdist through $!cref
      elsehandle any
      endhandle
-----------------------------------------------------------

-- Modify weld positions if needed

  !!MdsWeldPositions(!!MdsFt15,!Support.Stru,!Support.Mirror)

-- Update support object data held in form
    !!Mdsft15.Support = !Support

-- End function
endfunction

-- End of file Mdsmirrorft15.pml
