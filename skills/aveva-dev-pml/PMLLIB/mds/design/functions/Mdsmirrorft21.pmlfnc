--
-- File:  Mdsmirrorft21.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MMIRPS130
--
-- Author:  Wayne Dodwell
-- Created:  Wednesday 29th October 1997
--
--
-- Description:
-- function to Reflect(Mirror) Framework Type 'Ft21'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMirrorFT21()

  -- Initialise variables
  !support = !!mdsft21.support
  !stru    = !support.stru
  !name    = !support.stru.name
  !frame   = !name & '/MAIN'
  !origin  = !!ce
  !bar     = !name & '-BAR-1'
  !p9dir   = !support.p9Dir
  VAR !supportFrame  EXISTS $!frame

  -- Check that support structure has been created
  if (!supportFrame eq 'FALSEA')then
    !!alert.message('Support structure has not been created')
    return
  endif


  -- Check the template selected can be mirrored

  if !stru.:mdsFraMirror.not() then
    !!alert.message('The currently selected template cannot be mirrored')
    return
  endif

  -- Can only mirror framwork if we can write to the stru

  if !!mdsComClaimDac(!stru,'DACMOD','POS').not() then
    !!alert.error('Unable to mirror support as write access to the support structure is not available')
    return
  endif


  !udir = !p9dir

  -- Cross-Bar
  !!ce = $!bar
  PIN 9 AT STRU
  PIN 9 DIR $!udir
  pin 8 copy pin 9
  VAR !midp DERI MIDP
  PIN 8 AT $!midp
  pin 9 dir $!support.p10dir
  PIN 9 PLANE PIN 9 THRO PIN 8
  PIN 9 DIR $!p9dir
  ROTATE THRO PIN 9 ABOUT PIN 9 BY 180

  !!ce = !support.stru

  -------------------------------------------------------------
  -------------------------------------------------------------
  -- Mirror Packing Pieces if any Associated with the Framework
  call !!mdsMirrorFT25(!!mdsft21, 'FRAME')

  -------------------------------------------------------------
  -------------------------------------------------------------

  -- Reset pins
  Call !!mdsResetPins(8,9)

  !!ce = !origin

  -- Reset Form Gadget
  if (!support.mirror)then
    !support.mirror = false
  else
    !support.mirror = true
  endif

  -- Update support data held in form
  !!mdsft21.support = !support

endfunction
