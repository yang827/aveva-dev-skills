--
-- File:		Mdsmirrorft24.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thu Nov 27
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorFt24()

  -- Initialise variables
    !Origin     = !!CE
    !Datum      = !!MdsFt24.Support.Datum
    !Stru       = !!MdsFt24.Support.Stru
    !Name       = !Stru.name
    !Frame      = !Name & '/MAIN'
    !Bar        = !Name & '-BAR-1'
    -- !Subs1      = !Name & '/SUBS1'
    -- !Subs2      = !Name & '/SUBS2'
    !P11Dir     = !!MdsFt24.Support.P11Dir

  -- Check that support structure has been created
    !!CE = !Frame.dbref()
    handle (41,69) (2,109) (2,109)
      !!Alert.message('Support structure has not been created')
      return
    endhandle

      -- Check the template selected can be mirrored

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


    !!CE = !Bar.dbref()

    PIN 9 AT STRU
    PIN 9 DIR $!P11DIR
    VAR !MIDP DERI MIDP
    PIN 8 AT $!MIDP
    PIN 9 PLANE PIN 9 THRO PIN 8
    PIN 9 DIR U WRT WORLD

    !!CE = !Stru

    ROTATE THRO PIN 9 BY 180

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsft24, 'FRAME')

-------------------------------------------------------------
-------------------------------------------------------------

  -- Clear Pins
    Call !!MdsResetPins(8,9)

    !!CE = !Origin

  -- Reset Form Gadget
    if (!!MdsFt24.Support.Mirror)then
      !!MdsFt24.Support.Mirror = false
    else
      !!MdsFt24.Support.Mirror = true
    endif



-- End function
endfunction

-- End of file Mdsmirrorft24.pml
