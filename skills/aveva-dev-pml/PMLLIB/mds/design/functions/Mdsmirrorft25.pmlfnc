---------------------------------------------------------------------------------
--
-- File:  Mdsmirrorft25.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 20th November 1997
--
--
-- Description:
-- function to MIRROR support Packing Piece 'FT25'
-- for a Support Atta on ANY Standard Framework Cross Bar
-- OR on its OWN as an Independent STRUCTURE for Framework type 'FT25'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Name of Calling Form
--     2     R         STRING      FRAME - If Packing Piece is associated an Atta on
--                                         another TYPE of FRAMEWORK e.g. 'FT18' etc.
--                                 OWNER - If Packing Piece is in its OWN Structure
--                                         for FRAMEWORK type 'FT25'and associated
--                                         with its own DATUM Atta  etc.
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsMirrorFT25(!form is FORM, !method is STRING)

-- Find current units and set the distance unit to metric
    !currentUnits = !!kGetSetUnits()

-- Initialise Variables
    !origin     = !!ce
    !support    = !form.support
    !stru       = !support.stru
    !name       = !stru.name
    !datum      = !support.datum
    !atta       = !support.atta
    !frame      = !name & '/MAIN'
    var !supportFrame exists $!frame

-- Exit function if NO Packers are Present
    if (!support.packs.unset()) then
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Can only mirror framework if we can write to the stru

    if !!mdsComClaimDac(!stru,'DACMOD','POS').not() then
      !!alert.error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


-- Need to Ensure All Pins are Reset
    call !!mdsResetPins(1,10)
--------------------------------------------------------------------------------

    if (!method eq 'OWNER') then
-- Check that Datum atta has been created
      if (!datum.set().not()) then
        !!kRestoreUnits(!currentunits)
        !!alert.message('Datum support atta has not been created')
        return
      endif

-- Check that Datum atta has been positioned
      if (!support.position.not()) then
 !!kRestoreUnits(!currentunits)
        !!alert.message('Position Datum support atta before proceeding')
        return
      endif

-- Check that Framework exists
      if (!supportFrame eq 'FALSEA') then
 !!kRestoreUnits(!currentunits)
        !!alert.message('Support frame has to exist before Packing Pieces can be added')
        return
      endif
    endif

--------------------------------------------------------------------------------

-- Set Direction of P9 of Datum Atta of Owning Framework
    if (!support.plDir eq U or !support.plDir eq D) then
      !dDir = !support.p9Dir
      var !p3p9dir const dir p3 of $!datum to p9 of $!datum
      !uDir = !p3p9dir.direction()
      !type = 'VERT'
    else

-- Need to ADD CHECK for FT21 Vertical Cross Bar Supporting Stacked HORIZONTAL Pipes
-- and determine the !dDir and !uDir to use

--> Modified -<wd>- 28aug1998
   if (!support.type inset ('FT05','FT06','FT07','FT21')) then
      !gDir = U wrt /*
      !dDir = !support.p9Dir
      var !p3p9dir const dir p3 of $!datum to p9 of $!datum
      !uDir = !p3p9dir.direction()
      !saP10dir = !support.p10dir
--      !saP11dir = !support.p11dir
--< Modified -<wd>- 28aug1998

    else
      !dDir = D wrt /*
      !uDir = U wrt /*
    endif

      !type = 'HORI'
    endif

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

    if (!method eq 'FRAME') then
-- Find ATTAS with a Packing Piece and Mirror about the CL of the OWNING Structure

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
      if (!support.type inset ('FT17')) then
        if (!support.rotatecur) then
          if (!form.dim1.val eq 0) then
            !form.support.rotatecur = false
            !!mdsFT25.support.rotatecur = false
            !support = !!mdsFT25.support
            !rotFT17 = true
          endif
        endif
      endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
      do !index index !atta
        if (!atta[!index].:MDSPackRef.badref().not()) then
          !!ce = !atta[!index].:MDSPackRef
---------------------
---------------------
-- Get general direction of pleave of datum atta
-- General Pleave direction is nearest value to 1 or -1
          !!ce   = !support.datum
          !plDir = pl dir wrt world
--          !paDir = pa dir wrt world
          !up    = (abs(!plDir.up))
          !east  = (abs(!plDir.east))
          !north = (abs(!plDir.north))
          !max   = max((abs(!up)), (abs(!east)), (abs(!north)))
          if (!max.eq(!up))then
            if (!plDir.up.lt(0)) then
              !planeDir = D wrt /*
            else
              !planeDir = U wrt /*
            endif
          elseif (!max.eq(!east))then
            if (!plDir.east.lt(0)) then
              !planeDir = W wrt /*
            else
              !planeDir = E wrt /*
            endif
          else
            if (!plDir.north.lt(0)) then
              !planeDir = S wrt /*
            else
              !planeDir = N wrt /*
            endif
          endif

-- Navigate to Selected Atta
-- Set up Orientation of Selected Atta
          !!ce      = !atta[!index]
          !saP10dir = p10 dire wrt world
--          !saP9Dir  = p9 dire wrt world
          !saPlDir  = pl dire wrt world
          !saPaDir  = pa dire wrt world

-- Get general direction of pleave of selected atta
-- General Pleave direction is nearest value to 1 or -1
          !saUp    = (abs(!saPlDir.up))
          !saEast  = (abs(!saPlDir.east))
          !saNorth = (abs(!saPlDir.north))
          !saMax   = max((abs(!saUp)), (abs(!saEast)) , (abs(!saNorth)))
          if (!saMax.eq(!saUp))then
            if (!saPlDir.up.lt(0)) then
              !saPlaneDir = D wrt /*
            else
              !saPlaneDir = U wrt /*
            endif
          elseif (!saMax.eq(!saEast))then
            if (!saPlDir.east.lt(0)) then
              !saPlaneDir = W wrt /*
            else
              !saPlaneDir = E wrt /*
            endif
          else
            if (!saPlDir.north.lt(0)) then
              !saPlaneDir = S wrt /*
            else
              !saPlaneDir = N wrt /*
            endif
          endif

 -- Set PL and PA directions of Atta
          !!ce = !atta[!index]
          if (!planeDir eq !saPlaneDir) then
            !saPaDir = pa dire wrt /*
            !saPlDir = pl dire wrt /*
          else
            !saPaDir = pl dire wrt /*
            !saPlDir = pa dire wrt /*
          endif
---------------------
---------------------
          pin 1 at $!stru
          pin 1 copy p10 of $!datum
          pin 1 plane pin 1 thro $!atta[$!index]
          pin 1 dir $!uDir

          pin 3 at p9 of $!atta[$!index]
          pin 3 dir $!saPaDir
          pin 4 copy pin 3
          pin 4 dir $!saPlDir

--> Modified - <wd> - 1sep1998
         if (!support.type inset ('FT05')) then
           if (!saP10dir eq !gDir) then
             pin 3 dir $!saPlDir
             pin 4 dir $!saPaDir
           endif
         elseif (!support.type inset ('FT06')) then
           if (!saP10dir neq !gDir) then
             pin 3 dir $!saPlDir
             pin 4 dir $!saPaDir
           endif
         endif
--< Modified - <wd> - 1sep1998

          pin 10 copy pin 3
          pin 10 plane $!saPaDir thro pin 1
          pin 1 at pin 10
          pin 1 plane pin 1 thro $!datum

          !p1p3dist = !!kStrReal('cons dist pin 1 to plane pin 3')
          !p1p4dist = !!kStrReal('cons dist pin 1 to plane pin 4')

-----------------------------------------------------------------------
-- Mirror the Packing Piece
          !!ce = !atta[!index].:MDSPackRef
          rotate thro pin 1 about pin 1 by 180

-----------------------------------------------------------------------
-- Reposition the Atta to the NEW position of the Packing Piece
-----------------------------------------------------------------------
-- Check if Structure Stype is in set FT01-C* or FT02-C* i.e. TWO Cross Bars
-- from the SREF Atta of the Support
          !!ce = !support.datum
          !!ce = next
          !styp = styp
          if (!styp.matchwild('FT01-C*') or !styp.matchwild('FT02-C*') ) then
-- Reverse Pin 3 and Pin 4 directions for type 'B' only
            if (!atta[!index].:MDSPackRef.wdesp[2].eq('B')) then
              pin 4 dir $!saPaDir
              pin 3 dir $!saPlDir
            endif
          endif

--Navigate to Atta to Reposition
          !!ce = !atta[!index]
----------------------------
--> Modified -<wd>-25sep1998
$( Commented out this CODE for FT14 <wd>-nov2002
          if (!form.name().matchwild('*FT14*') and !support.rotatecur) then
            if (!support.mirror) then
              if (!planeDir eq !saPlaneDir) then
                pin 4 dist ( 2 * $!p1p4dist )
                move along pl thro pin 4
              else
                pin 3 dist ( -2 * $!p1p3dist )
                move along pa thro pin 3
              endif
            else
              if (!planeDir eq !saPlaneDir) then
                pin 3 dist ( 2 * $!p1p3dist )
                move along pa thro pin 3
              else
                pin 4 dist ( -2 * $!p1p4dist )
                move along pl thro pin 4
              endif
            endif

          else
$)

            if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
              if (!planeDir eq !saPlaneDir) then
                pin 4 dist ( 2 * $!p1p4dist )
                move along pl thro pin 4
              else
                pin 3 dist ( -2 * $!p1p3dist )
                move along pa thro pin 3
              endif
            else
              if (!planeDir eq !saPlaneDir) then
                pin 3 dist ( 2 * $!p1p3dist )
                move along pa thro pin 3
              else
                pin 4 dist ( -2 * $!p1p4dist )
                move along pl thro pin 4
              endif
            endif

$( Commented out this CODE for FT14 <wd>-nov2002
          endif
$)
--> Modified -<wd>-25sep1998
----------------------------
        endif
      enddo
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
      if (!support.type inset ('FT17')) then
        if (!rotFT17) then
            !form.support.rotatecur = true
            !!mdsFT25.support.rotatecur = true
            !support = !!mdsFT25.support
            !rotFT17 = false
        endif
      endif
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--                 End of !method eq 'FRAME' test
--------------------------------------------------------------------------------

-- Mirror an Independent Structure for Framework Type 'FT25'

    elseif (!method eq 'OWNER') then

--Set Form Member .fatta
      !!mdsFT25.fatta = !datum

      pin 1 at $!stru
      pin 1 dir $!uDir
      pin 2 copy p9 of $!datum
      pin 2 dir $!dDir

-- Set Orthogonal PL ans PA directions of Datum Atta
      !!ce = !datum
      !saPlDir = pl dire wrt /*
      !saPaDir = pa dire wrt /*
      !xrPlDir = !saPlDir.string().split()
      !orPlDir = !xrPlDir[1].direction()
      !xrPaDir = !saPaDir.string().split()
      !orPaDir = !xrPaDir[1].direction()

--------------------------------------------------------------------------------

      if (!!mdsFT25.crBar.badref()) then
-- Identify Structural Section to Mirror Packing Piece about
--        label /Pick1
        prompt off
        prompt load escape |Identify Structural Section to Mirror Packing Piece about|
        id SCTN @
        handle (61,528)
          prompt on
          !!kRestoreUnits(!currentunits)
          !!ce = !origin
          return
        endhandle
        prompt dismiss
        prompt on
        !sctn = !!ce

--Set Form Members '.crBar'
        !!mdsFT25.crBar = !sctn
        !sctn = !!mdsFT25.crBar
      else
        !sctn = !!mdsFT25.crBar
      endif

--------------------------------------------------------------------------------

-- Get Distance between CL of Datum Atta/CL of STRU and the Centre of Picked Section
-- to Mirror the Support about
      !!ce = !sctn
      pin 3 at ppline na start
      pin 3 dir $!uDir
      pin 3 plane pin 3 thro pin 1
      pin 4 copy pin 3
      pin 5 copy pin 3
      pin 4 dir $!orPlDir
      pin 5 dir $!orPaDir
      pin 4 plane pin 4 clear 0 beh $!sctn
      pin 5 plane pin 5 clear 0 beh $!sctn
      pin 4 dir to pin 5
      pin 5 dir to pin 4
      !pin4pin5dist = !!kStrReal('cons dist pin 4 to plane pin 5')
      !cRot = !pin4pin5dist / 2
      pin 4 dist $!cRot
      pin 4 dir $!support.p11dir
      pin 4 plane pin 4 thro $!datum
      pin 4 dir $!uDir

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Navigate to the Stru and Rotate about Pin 4
      !!ce = !stru
      rotate thro pin 4 about pin 4 by 180

-- Navigate to the Datum Atta and Position at the Stru
      !!ce = !datum
      !datumName = !!ce.name
      !srefName = !datumName.before('/DATUM') + '/SREF'

      move along pa thro $!stru
      plane $!saPlDir thro ce
      !!ce = !srefName.dbref()
      at $!datumName
      ori
      thro ce
-- Move Aid Text
      !!ce = !datum
      !pos = !!ce.pos.wrt(world)
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>
-- Reset the Distance Gadget on the Form
      call !!mdsDistance(!!mdsFT25)

-- Navigate to the Stru and Position at Datum
      !!ce = !stru
      move $!uDir thro $!datum
      move $!dDir thro p9 of $!datum

--------------------------------------------------------------------------------

-- Adjust for slope on horizontal lines only
      if (!type eq 'HORI')then
-- Check to see if the line is sloping
        !adjust = 0
        !!ce = !datum
        !grad = pl grad

        if (!grad neq 0)then
          if !!ce.:MDSRotDir.east.unset() then
            !strucElement = ARRAY()
            !ref = !datum.:MDSPackRef
            !strucElement.append(!ref)
            !vHeight = !!mdsAdjustSlope(!strucElement, !datum)
          endif
        else
          !vHeight = 0
        endif

        if (!vHeight gt !adjust)then
          !adjust = !vHeight
        endif

-- Adjust Height of Packing Pieces
        !!ce = !datum.:MDSPackRef
        move d wrt world dist $!adjust

      endif

    endif

--------------------------------------------------------------------------------
-- End of !method eq 'OWNER' test
--------------------------------------------------------------------------------

    !!ce = !origin

-- Reset Form Gadget
    if (!support.mirror)then
      !support.mirror = false
    else
      !support.mirror = true
    endif

-- Update support data held in form
    !!mdsFT25.support = !support

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- Reset Pins
--   call !!mdsResetPins(1,10)

-- End function
endfunction
