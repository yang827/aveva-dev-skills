--
-- File:  Mdsmirrorft28.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MMIRPS152
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 11th November 1997
--
--
-- Description:
-- function to Reflect(Mirror) Framework Type 'FT28' about Beam Centreline
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R       STRING        CURSOR - Create by Cursor Option on Form
--                               or BUTTON - Mirror Button on Form
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsmirrorft28(!method is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !support = !!mdsFT28.support
  !datum   = !support.datum
  !stru    = !support.stru
  !name    = !support.stru.name
  !frame   = !name & '/MAIN'
  !origin  = !!ce
  !bar     = !name & '-BAR-1'
  !vert    = !name & '-V1'
  !verx    = !name & '-V2'
  !p9dir   = !support.p9dir
  var !supportframe exists $!frame

  -- Can only mirror framwork if we can write to the stru

  if !!mdsComClaimDac(!stru,'DACMOD','POS').not() then
    !!kRestoreUnits(!currentUnits)
    !!alert.error('Unable to mirror support as write access to the support structure is not available')
    return
  endif


  -- Distance from CL Beam to Stru Origin
  !despx   = !!mdsFT28.desp3
  !desp3   = !despx.abs()
  !!mdsFT28.desp3 = !desp3

  -- Direction of ppline 'NA' wrt /* of Picked Beam
  !desp4   = !!mdsFT28.desp4

  -- Check that support structure has been created
  if (!supportframe eq 'FALSEA')then
    !!alert.message('Support structure has NOT been created - Unable to Mirror the Support')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check the template selected can be mirrored

  if !stru.:mdsFraMirror.not() then
    !!alert.message('The currently selected template cannot be mirrored')
    return
  endif

  -- Get the Z direction of the Vertical '!name-V1'
  !udir = !desp4.direction()

  -- Set Pin 9 at Existing Datum Position
  pin 9 at $!datum
  pin 9 dire $!udir

  -- Mirror Stru about the Neutral Axis of the Position of the 'Picked' Beam CL
  -- Despar 3 of the SREF Atta stores the Distance from the STRU Origin to the
  -- 'NA' of the 'Picked' Beam CL
  !!ce = !bar.dbref()
  pin 1 at ppline na start
  pin 1 dire $!!ce.drns

  !!ce = !vert.dbref()
  pin 2 at ppline na start
  pin2 dire $!!ce.drns

  pin 1 plane pin 1 thro pin 2
  pin 2 plane pin 2 thro pin 1
  pin 1 dire to pin 2
  handle any
    $!name
    var !p1p2dir dir y wrt /*
  elsehandle none
    var !p1p2dir pin 1 dire wrt /*
  endhandle

  !!ce = !support.stru
  pin 3 at $!support.stru
  pin 3 dir $!p1p2dir wrt /*

  if (!bar.dbref().jois.unset().not() and !bar.dbref().joie.unset().not()) then
    !srefDespar = despar of $!name/SREF
    pin 3 dist $!srefDespar[3]
  else
    pin 3 dist $!desp3
  endif

  pin 3 dir $!udir

  rotate thro pin 3 about pin 3 by 180

  !!ce = !datum
  plane pl thro $!support.stru
  !!ce = $!<name>/SREF
  plane pl thro $!support.stru

  -- Adjust Structure Position - For Sloping Lines
  !!ce = !support.stru
  at p9 of $!datum
  pin 8 at $!datum
  !p8p9dist = !!kStrReal('const dist pin8 to plane pin 9')

  -- Reset Form Gadget
  -- Determine if Sections are to Move '+' or '-'
  if (!support.mirror)then
    !support.mirror = false
    if (!method eq 'BUTTON') then
      !sign = '-'
    elseif  (!method eq 'CURSOR') then
      !sign = ''
    endif
  else
    if (!method eq 'BUTTON') then
      !sign = ''
    elseif  (!method eq 'CURSOR') then
      !sign = '-'
    endif
    !support.mirror = true
  endif

  -- Navigate to Vertical 1 and Adjust Position
  !!ce = !vert.dbref()
  move $!udir dist $!<sign>$!p8p9dist
  -- Navigate to Vertical 2 and Adjust Position
  !!ce = !verx.dbref()
  move $!udir dist $!<sign>$!p8p9dist

  ----------------connexions--------------------
  if (!support.joints.unset().not()) then

    -- Reverse the 'JLINE' for each SJOI on each Vertical Sctn
    -- i.e. 'JLINE' of JOIS and JOIE of each Vertical Sctn to be swapped over
    -- Every time the Mirror button is clicked

    !verts = ARRAY()
    !snods = ARRAY()
    !zdist = ARRAY()
    !verts[1] = !vert.dbref()
    !verts[2] = !verx.dbref()
    !numb = 1

    do !jts values !verts
      !xjois = !jts.jois.jline
      !xjoie = !jts.joie.jline

      !!ce = !jts.jois
      !zdist[1] = !!ce.owner
      !zdist[2] = !!ce.owner.zdist
      !snods[!numb] = !zdist
      !zdist.clear()
      jlin $!xjoie

      !!ce = !jts.joie
      !zdist[1] = !!ce.owner
      !zdist[2] = !!ce.owner.zdist
      !snods[!numb + 1] = !zdist
      jlin $!xjois

      !numb = !numb + 2
    enddo

    -- Determine the Maximun and Minimum ZDIST values for each SNODE
    do !snum index !snods
      if (!snum.eq(1)) then
        !minz = !snods[!snum][2]
        !maxz = !snods[!snum][2]
      else
        !mins = !snods[!snum][2]
        !maxs = !snods[!snum][2]
        if (!mins.leq(!minz)) then
          !minz = !mins
        elseif (!maxs.geq(!maxz)) then
          !maxz = !maxs
        endif
      endif
    enddo

    -- Reverse the ZDIST of the SNODES on the SCTN for EACH JOINT
    do !sval values !snods
      !!ce = !sval[1]
      if (!sval[1].zdist.int().eq(!minz.int())) then
        zdist $!maxz
      elseif (!sval[1].zdist.int().eq(!maxz.int())) then
        zdist $!minz
      endif
    enddo
  endif
  ----------------connexions--------------------

  -- Set '+' or '-' at Desp 3 of the SREF atta
  !!ce = $!<name>/SREF
  if (!support.mirror) then
    -- Set Despar 3 to a MINUS value
    !desp3 = !desp3.abs()
    !despb = !desp3 * -1
    despar numb 3 $!despb
  else
    -- Set Despar 3 to a POSITIVE value
    !desp3 = !desp3.abs()
    despar numb 3 $!desp3
  endif

  -- Recalculate Distance of Datum Atta from Previous Component
  !!ce   = $!datum
  !order = order
  if (!order.eq(1)) then
    !dist = !!kStrReal('const dist ph to p0 ')
  else
    !dist = !!kStrReal('const dist p0 to p0 of prev')
  endif
  -- Write Distance back to form gadget.
  !!mdsFT28.dist.val = !dist

  -- Move Aid Text
  !pos = !!ce.pos.wrt(world)
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Update support data held in form
  !!mdsFT28.support = !support

  -- Modify weld positions if needed
  -- not needed
  -- !!mdsWeldPositions(!!mdsFT28,!support.stru,!support.mirror)

  -- Reset pins
  call !!mdsresetpins(1,10)

  -- Navigate Back to Original Element
  !!ce = !origin

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

endfunction
