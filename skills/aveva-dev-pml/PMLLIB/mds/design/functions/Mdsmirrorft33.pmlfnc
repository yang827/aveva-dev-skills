--
-- File:		Mdsmirrorft33.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS138
--
-- Author:		I.Osborne
-- Created:		Thu Jul 24
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorFt33()

  -- Initialise variables
    !Support  = !!MdsFt33.Support
    !Stru     = !Support.Stru
    !Name     = !Stru.name
    !Frame    = !Name & '/MAIN'
    !Origin   = !!CE
    VAR !SupportFrame  EXISTS $!Frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif


    -- Check the template selected can be mirrored

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


  -- Get all required members
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Subs     = !!KCollectAllFor('SUBS', '((match(name, |/SUBS1|) gt 0))', !Support.Stru)

    if (!Support.PADir eq U or $!Support.PLDir eq U)then
      !Udir = !Support.P9dir
    else
      !Udir = D
    endif

-- Cross-Bars
    do !V values !Bars
      !!CE = !V
      !Joie = !!CE.joie
      !Jois = !!CE.jois
--<K.Pleschner> June 2005
-- handle pads of angle profiles
      !!MdsMirrorPads(CE,'PREPROCESS')

      PIN 1 AT STRU
      PIN 1 DIR $!Support.P11DIR
      VAR !Midp DERI MIDP
      PIN 2 AT $!Midp
      PIN 1 PLANE PIN 1 THRO PIN 2
      PIN 1 DIR $!Udir
      ROTATE THRO PIN 1 ABOUT $!Udir BY 180
      JOIS $!JOIE
      JOIE $!JOIS
--$(
     ---------------------------****** connexions *******----------------------------------
     -- do a frig cos flip isnt used
        -- !!MdsFrigConns(!V)
     ------------------------------------------------------
--$)

--<kp>Mar07 Flip snipes
     !!mdsMirrorSnipes(!V)

-- <K.Pleschner>  June2005  PADs of angle profiles
    !!MdsMirrorPads(ce,'EXECUTE')

    enddo


-->>>-<wd>nov2002 - SUBS REMOVED from STANDARD FT33
$(
  -- Subs
    do !V values !Subs
      !!CE = !V
      PIN 1 AT STRU
      PIN 1 DIR $!Support.P11DIR
      PIN 2 AT CE
      PIN 1 PLANE PIN 1 THRO PIN 2
      PIN 1 DIR $!Udir
      ROTATE THRO PIN 1 ABOUT $!Udir BY 180
    enddo

-- Move stop plate to opposite end of field weld
  !!CE = $!<Name>-BAR-1
  !Drns = drns wrt /*
  !!CE = $!<Name>/SUBS1
  !MdsOrigin = !!CE.owner.:MDSOrigin
  box 1

  if (!Support.Mirror.not()) then
    -- if !MdsOrigin.eq('START') then
      -- move $!Drns thro pose of $!<Name>-BAR-1
      -- move $!Drns dist 13mm
    -- else
      move $!Drns thro poss of $!<Name>-BAR-1
      move $!Drns dist -13mm
    -- endif
  else
    -- if !MdsOrigin.eq('START') then
      -- move $!Drns thro poss of $!<Name>-BAR-1
      -- move $!Drns dist -13mm
    -- else
      move $!Drns thro pose of $!<Name>-BAR-1
      move $!Drns dist 13mm
    -- endif
  endif
$)
--<<<-<wd>nov2002 - SUBS REMOVED from STANDARD FT33


    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsft33, 'FRAME')
-------------------------------------------------------------
-------------------------------------------------------------

  -- Reset pins
    Call !!MdsResetPins(1,2)

    !!CE = !Origin

  -- Reset Form Gadget
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

  -- Update support data held in form
    !!MdsFt33.Support = !Support

-- Modify weld positions if needed
    !!MdsWeldPositions(!!MdsFt33,!Support.Stru,!Support.Mirror)

-- End function
endfunction

-- End of file Mdsmirrorft33.pml
