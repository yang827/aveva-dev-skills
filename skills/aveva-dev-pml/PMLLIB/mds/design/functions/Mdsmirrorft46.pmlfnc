--
-- File:		Mdsmirrorft46.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS131
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorft46()

  -- Initialise variables
    !Support  = !!Mdsft46.Support
    !Stru     = !Support.Stru
    !Name     = !Stru.name
    !Frame    = !Name & '/MAIN'
    !Origin   = !!CE
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Vertical = !!KCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    VAR !SupportFrame  EXISTS $!Frame


  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif


    -- Check the template selected can be mirrored

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


   !!Ce = !Stru
   ROTATE THROUGH BOX 1 OF $!Name/SUBS1 ABOUT UP WRT /* BY 180
   --Re-align any connections to steel
   !!Ce = $!Name-V1
   !!Ce = !!Ce.Jois.Owne.Owne
   handle ANY
   elsehandle NONE
   $M/%pdmsui%/DES/STLWRK/MNODEALIGN
   endhandle
-- End function
endfunction

-- End of file Mdsmirrorft46.pml
