--
-- File:		MdsmirrorFT54C.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS127
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorFT54C()

  -- Initialise variables
    !Support = !!MdsFT54C.Support
    !Stru    = !Support.Stru
    !Name    = !Stru.name
    !frame   = !Name & '/MAIN'
    !Origin  = !!CE
    !Datum   = !Support.Datum
    !Bars    = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    VAR !SupportFrame  EXISTS $!frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

      -- Check the template selected can be mirrored

    if !Stru.:mdsFraMirror.not() then
      !!Alert.message('The currently selected template cannot be mirrored')
      return
    endif

-- Can only mirror framwork if we can write to the stru

    if !!MdsComClaimDac(!Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to mirror support as write access to the support structure is not available')
      return
    endif


    !!CE = $!<Name>-BAR-1
    FLIP
    if !support.mirror then
      !dir = !datum.pdir[4].string().before('WRT')
      move along $!dir wrt /* clear inf $!datum
    else
      !dir = !datum.pdir[4].opposite().string().before('WRT')
      move along $!dir wrt /* clear inf $!datum
    endif
    !!CE = !Support.Stru

    -- Reset pins
    call !!MdsResetPins(7,9)

    !!CE = !Origin

  -- Reset Form Gadget
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

  -- Update support data held in form
    !!MdsFT54C.Support = !Support

-- End function
endfunction

-- End of file MdsmirrorFT54C.pml
