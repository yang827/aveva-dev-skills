--
-- File:  Mdsmirrorpads.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  K.pleschner
-- Created:  23/06/2005
--
--
-- Description:
-- function to handle pads(joints) after the profile is mirrored
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Section ref.
--     2     R        STRING        Process type (PREPROCESS or EXECUTE - there can be any string in latter case)
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMirrorPads(!section is DBREF,!processType is STRING)


  -- initialise variables
  !jois = !section.jois
  !joie = !section.joie

  if !jois.badref().not() then
    !joisGtyp = !jois.gtyp
  else
    !joisGtyp = ''
  endif

  if !joie.badref().not() then
    !joieGtyp = !joie.gtyp
  else
    !joieGtyp = ''
  endif


  -- preprocessing only
  if !processType.upcase().eq('PREPROCESS') then
    !current = !!ce
    if !joieGtyp.neq('APAD') and !joieGtyp.neq('APLT') then
      !!ce = !section
      Joie  nulref
    else
      --<RM> 15/08/11 if this is an auto pad joint then we must remove the rules from the joint and node so that evaluation problems do not arise from a lack of connection ref
      --the rule sets are re-initialised anyway during the execute phase of this function - start
      !!ce = !joie.owne
      rule delete all
      !!ce = !joie
      rule delete all
    endif

    if !joisGtyp.neq('APAD') and !joisGtyp.neq('APLT')then
      !!ce = !section
      jois  nulref
    else
      !!ce = !jois.owne
      rule delete all
      !!ce = !jois
      rule delete all
      --<RM> 15/08/11 if this is an auto pad joint then we must remove the rules from the joint and node so that evaluation problems do not arise from a lack of connection ref
      --the rule sets are re-initialised anyway during the execute phase of this function - end
    endif
    !!ce = !current
  else
    -- joint modification

    if !joisGtyp.eq('APAD') then
      !!ce = !jois.owne
      rule set npos dynam (e(comp e of POSS of cref of 1 wrt cref of 1) n(comp n of POSS of cref of 1 wrt cref of 1) u(comp u of POSS of cref of 1 wrt cref of 1 - cutb of 1) wrt cref of 1)
      !!ce = !jois
      rule set cutp dynam (drns of cref)
      rule set opdi dynam (drns of cref)
      rule execute delp
      handle ANY
        rule set delp dynamic (e 0 n 0 u 0)
      endhandle
      !!mdseditspsctn.setbang(!jois)
    elseif !joisGtyp.eq('APLT') then
      !!ce = !jois.owne
      rule set npos dynam (e(comp e of POSS of cref of 1 wrt cref of 1) n(comp n of POSS of cref of 1 wrt cref of 1) u(comp u of POSS of cref of 1 wrt cref of 1 - cutb of 1) wrt cref of 1)
      !!ce = !jois
      rule set cutp dynam (drns of cref)
      ------------------------------------------------------------------
      -- $P Joint Start
      -- q var !section.name
      -- $P***drne
      -- q drne of cref
      -- $P***drns
      -- q drns of cref
      if !section.name.matchwild('*BAR*') then
        rule set opdi dynam (drns of cref)
        !stru = stru
        if (!stru.:MDSSuppType inset('FT07')) then
          rule set opdi dynam (drne of cref)
        endif
        if (!stru.:MDSSuppType inset('FT34A')) then
          !!ce = !jois.owne
          rule set npos dynam (e(comp e of POSE of cref of 1 wrt cref of 1) n(comp n of POSE of cref of 1 wrt cref of 1) u(comp u of POSE of cref of 1 wrt cref of 1 - cutb of 1) wrt cref of 1)
          !!ce = !jois
          rule set cutp dynam (drns of cref)
          rule set opdi dynam (drne of cref)
        endif
      endif
      if !section.name.matchwild('*V*') then
        rule set opdi dynam (drne of cref)
        !stru = stru
        if (!stru.:MDSSuppType inset('FT03','FT04','FT18','FT19')) then
          rule set opdi dynam (opposite drne of cref)
        endif
      endif
      -- rule set opdi dynam (drne of cref)
      -- rule set opdi dynam (drns of cref)
      ------------------------------------------------------------------
      rule execute delp
      handle ANY
        rule set delp dynamic (e 0 n 0 u 0)
      endhandle
      !!mdseditspsctn.setbang(!jois)
    else
      if !jois.badref().not() then
        !!ce = !jois
        reconnect recalculate
      endif
    endif

    if !joieGtyp.eq('APAD') then
      !!ce = !joie.owne
      rule set npos dynam (e(comp e of POSE of cref of 1 wrt cref of 1) n(comp n of POSE of cref of 1 wrt cref of 1) u(comp u of POSE of cref of 1 wrt cref of 1 + cutb of 1) wrt cref of 1)
      !!ce = !joie
      rule set cutp dynam (drne of cref)
      rule set opdi dynam (drne of cref)
      rule execute delp
      handle ANY
        rule set delp dynamic (e 0 n 0 u 0)
      endhandle
      !!mdseditspsctn.setbang(!joie)
    elseif !joieGtyp.eq('APLT') then
      !!ce = !joie.owne
      rule set npos dynam (e(comp e of POSE of cref of 1 wrt cref of 1) n(comp n of POSE of cref of 1 wrt cref of 1) u(comp u of POSE of cref of 1 wrt cref of 1 + cutb of 1) wrt cref of 1)
      !!ce = !joie
      rule set cutp dynam (drne of cref)
      ------------------------------------------------------------------
      -- $P Joint End
      -- q var !section.name
      -- $P***drne
      -- q drne of cref
      -- $P***drns
      --  q drns of cref
      if !section.name.matchwild('*BAR*') then
        rule set opdi dynam (drns of cref)
        !stru = stru
        if (!stru.:MDSSuppType inset('FT14')) then
          rule set opdi dynam (opposite drne of cref)
        endif
        if (!stru.:MDSSuppType inset('FT34A')) then
          !!ce = !joie.owne
          rule set npos dynam (e(comp e of POSS of cref of 1 wrt cref of 1) n(comp n of POSS of cref of 1 wrt cref of 1) u(comp u of POSS of cref of 1 wrt cref of 1 - cutb of 1) wrt cref of 1)
          !!ce = !joie
          rule set cutp dynam (drns of cref)
          rule set opdi dynam (drns of cref)
        endif
      endif
      if !section.name.matchwild('*V*') then
        rule set opdi dynam (drns of cref)
        !stru = stru
        if (!stru.:MDSSuppType inset('FT03','FT04','FT18','FT19')) then
          rule set opdi dynam (opposite drne of cref)
        endif
      endif
      --rule set opdi dynam (drne of cref)
      ------------------------------------------------------------------
      rule execute delp
      handle ANY
        rule set delp dynamic (e 0 n 0 u 0)
      endhandle
      !!mdseditspsctn.setbang(!joie)
    else
      if !joie.badref().not() then
        !!ce = !joie
        reconnect recalculate
      endif
    endif

  endif

endfunction
