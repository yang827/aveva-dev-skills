--
-- File:		Mdsmirrorsnipes.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		K.Pleschner
-- Created:		08/07/2007
--
--
-- Description:
-- function to handle snipes(fitt) after the profile is mirrored
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Section ref.
--     2     R        MDSSUPPORT    Associated support object
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorSnipes(!Section is DBREF)

     !ce = !!ce

     -- get proper snipe spref
     !tmp = object MDSSNIPE()
     !Spref = !tmp.spref

-- section is CROSSBAR
     if !section.name.match('-BAR').gt(0) then
        var !AllSnipe collect all FITT with spref eq $!spref for $!section
        do !snipe values !Allsnipe
           !!ce = !snipe.dbref()
           rule rexe
             handle ANY
             endhandle
           if !!ce.zdis.eq(0) then
              rule set ZDIS dynamic (cutl of owner)
           elseif !!ce.zdis.gt(0) then
              rule set ZDIS dynamic (0)
           endif
        enddo

     endif

-- section is vertical
     if !Section.name.match('-V').gt(0) then
        var !AllSnipe collect all FITT with spref eq $!spref for $!section
        do !snipe values !Allsnipe
           !!ce = !snipe.dbref()
           rule rexe
              handle ANY
              endhandle
           if !!ce.zdis.eq(0) then
              rule set ZDIS dynamic (cutl of owner)
           elseif !!ce.zdis.gt(0) then
              rule set ZDIS dynamic (0)
           endif
        enddo
     endif


    !!ce = !ce

-- End function
endfunction

-- End of file Mdsmirrorsnipes.pmlfnc
