-- Define Function
define function !!MdsMirrorSP03()


    !Support = !!MdsSp03.Support

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif


-- Update Support Data
    !!ce = !support.datum
    mirror plane pl thro ce

    flip

    if(!Support.Mirror) then
       !!MdsSP03.Support.Mirror = false
    else
       !!MdsSP03.Support.Mirror = True
    endif

    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world


-- End function
endfunction

