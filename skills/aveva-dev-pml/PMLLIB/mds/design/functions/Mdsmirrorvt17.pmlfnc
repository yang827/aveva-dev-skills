--
-- File:		Mdsmirrorvt17.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MMIRPS138
--
-- Author:		I.Osborne
-- Created:		Thu Jul 24
--
--
-- Description:
-- function to reverse steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorvt17()

  -- Initialise variables
    !Support  = !!Mdsvt17.Support
    !Stru     = !Support.Stru
    !Name     = !Stru.name
    !Frame    = !Name & '/MAIN'
    !Origin   = !!CE
    VAR !SupportFrame  EXISTS $!Frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

  -- Get all required members
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Subs     = !!KCollectAllFor('SUBS', '((match(name, |/SUBS1|) gt 0))', !Support.Stru)

    if (!Support.PADir eq U or $!Support.PLDir eq U)then
      !Udir = !Support.P9dir
    else
      !Udir = D
    endif

  -- Cross-Bars

    do !V values !Bars

      !!CE = !V
      !Joie = !!CE.joie
      !Jois = !!CE.jois
      JOIS NULREF
      JOIE NULREF
      PIN 1 AT STRU
      PIN 1 DIR $!Support.P11DIR
      VAR !Midp DERI MIDP
      PIN 2 AT $!Midp
      PIN 1 PLANE PIN 1 THRO PIN 2
      PIN 1 DIR $!Udir
      ROTATE THRO PIN 1 ABOUT $!Udir BY 180
      JOIS $!JOIE
      JOIE $!JOIS

--$(
     ---------------------------****** connexions *******----------------------------------
     -- do a frig cos flip isnt used
        -- !!MdsFrigConns(!V)
     ------------------------------------------------------
--$)
    enddo

  -- Subs

    do !V values !Subs

      !!CE = !V
      PIN 1 AT STRU
      PIN 1 DIR $!Support.P11DIR
      PIN 2 AT CE
      PIN 1 PLANE PIN 1 THRO PIN 2
      PIN 1 DIR $!Udir
      ROTATE THRO PIN 1 ABOUT $!Udir BY 180

    enddo

    !!CE = !Support.Stru

-------------------------------------------------------------
-------------------------------------------------------------
-- Mirror Packing Pieces if any Associated with the Framework
    call !!Mdsmirrorft25(!!Mdsvt17, 'FRAME')

-------------------------------------------------------------
-------------------------------------------------------------

  -- Reset pins
    Call !!MdsResetPins(1,2)

    !!CE = !Origin

  -- Reset Form Gadget
    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif

  -- Update support data held in form
    !!Mdsvt17.Support = !Support

-- End function
endfunction

-- End of file Mdsmirrorvt17.pml
