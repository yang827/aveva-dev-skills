--
-- File:		Mdsmirrorvt21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Gordon Evans
-- Created:		Wed 22nd Oct 2003
--
--
-- Description:
-- function to mirror steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsMirrorvt21()

-- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Initialise variables
    !Support  = !!Mdsvt21.Support
    !Datum    = !Support.Datum
    !Name     = !Support.Stru.name
    !stru     = !support.stru
    !p9dir    = !support.p9dir
    !p10dir   = !support.p10dir
    !p11dir   = !support.p11dir
    !pldir    = !support.pldir
    !padir    = !support.padir
    !frame    = !Name & '/MAIN'
    !Origin   = !!CE
    !Bars     = !!KCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Vertical = !!KCollectAllFor('SCTN', '((match(name, |-V|) gt 0) and type of owner eq |FRMW|)', !Support.Stru)
    !Bars.appendarray(!Vertical)
    !ResetLock = false

    VAR !SupportFrame  EXISTS $!frame

  -- Check that support structure has been created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support structure has not been created')
      return
    endif

  -- rotate atta for mirror
     !!CE = !Datum

  -- Update support data held in form
    !!Mdsvt21.Support = !Support

--------------------------------------------------------------------------------
-- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

-- Can we write to the spref attribute of the SREF atta
-- and the stru

  if !Support.Datum.badref().not() then
    !SrefName = !Support.Datum.Name.before('/DATUM') + '/SREF'
      if !!MdsComClaimDac(!Support.Stru,'DACMOD','POS').not() or !!MdsComClaimDac(!SrefName.dbref(),'DACMOD','SPREF').not() then
        !Despars = !Srefname.dbref().despar
        !!MdsResetDims(!Form,!Despars)
        !!kRestoreUnits(!currentunits)
        !!Alert.Error('Unable to change the support as write access to the SREF atta is not available')
        return
      endif
  endif

 !Despars = !Srefname.dbref().despar

-- Store section name and matref for each member
-- for reseting later

  !StoreMat = array()
  !StoreMat = !!MdsStoreMat(!Name)


-- This for vertical pipes

  if (!!ce.type eq 'BRAN') then
     !hdir = hdir wrt /*
  else
     !hdir = pl dir wrt /*
  endif

  !mdsvert = false

  if (!hdir eq U or !hdir eq D ) then
   !mdsvert = true
  endif

  if  (!mdsvert) then
   rotate thro ce about pl by 180
  endif

  -- go to stru and mirror

     !!CE = !Support.Stru

  -- this will work in  any ori

   if  (!mdsvert) then
    at p9 of $!Datum
    mirror plane n wrt stru thro ce
    else
    mirror plane n wrt stru thro ce
  endif

  -- all sctns

    do !V values !Bars
      !!CE = !V
      flip
    enddo

     !!CE = !Origin

  -- Reset Form Gadget

    if (!Support.Mirror)then
      !Support.Mirror = false
    else
      !Support.Mirror = true
    endif


-- Not needed for vertical pipes
  if  (!mdsvert.not()) then

-- Identify both brackets on equipment

label /Element1
  prompt off
  prompt load escape |Identify support bracket|
  id box @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
  !Box1 = !!ce

-- Is the identified box owned by a piece of equipment
  equi
    handle any
      !!Alert.Error('Identified box is not owned by a piece of equipment. Please retry')
      golabel /Element1
    elsehandle none
      !Equip1 = !!ce
    endhandle

label /Element3
  prompt off
  prompt load escape |Identify vessel wall|
  id cyli @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
  !Wall = !!ce

-- Is the identified cyli owned by a piece of equipment
  equi
    handle any
      !!Alert.Error('Identified cylinder is not owned by a piece of equipment. Please retry')
      golabel /Element3
    elsehandle none
      !Equip3 = !!ce
    endhandle

-- Is the identified cyli owned by the same piece of equipment
  if !Equip1.name.neq(!Equip3.name) then
    !!kRestoreUnits(!currentunits)
    !!Alert.Error('Identified cylinder is not owned by the same equipment. Aborting!')
    return
  endif

  !atta = !datum

-- Slide DATUM atta through identified bracket
  !!CE = !Datum

  if (!Support.Mirror) then
     plane pl clear 0 inf $!box1
   else
     plane pl clear 0 beh $!box1
  endif

--  Also Slide SREF atta through identified bracket
  !!CE  = !srefname.dbref()
  --plane pl thro $!Box1
  at prev

-- Generate Please Wait... Prompt
  !!Mdscreatemess(true)

-- Set elevation to top of bracket
  !Bore = ph bore

-- Navigate to Stru
  !!ce = !stru

--<wd>2002
-- Slide STRU to side of Vessel Clip(BOX)

  at p9 of $!atta

  !behind = false

  move $!pldir clear 0 inf $!box1

  if  (!mdsvert.not()) then
   !!CE = !Datum
   pin 1 at pl
   pin 1 dir pl
   pin 2 copy pin 1
   pin 5 at p5 of $!box1
   !!ce = $!<name>-SUBS1/PLATE1
   pin 3 at p3
   pin 3 dir p3
   pin 4 copy p3
   pin 2 plane pin 2 thro pin 5
   pin 4 plane pin 4 thro pin 5
   var !P1p2dist const dist pin 1 to pin 2
   var !P3p4dist const dist pin 3 to pin 4
   if !P3p4dist.real().gt(!P1p2dist.real()) then
     !behind = true
   endif
  endif

  -- Navigate to Structure
  !!ce = !stru

    if (!behind) then
      move $!pldir clear 0 beh $!box1
    endif

-- Slide DATUM atta through STRU position

  !atta = !datum
  !!CE = !Datum

     plane pl through $!stru

--  Also Slide SREF atta through identified bracket
  !!CE  = !srefname.dbref()
  --plane pl thro $!Box1
  at prev

-- endif for the vertical
  endif


-- Navigate to Structure
  !!ce = !stru

-- Enhance elements using colour set for highlight
  !colourlist = array()
  !colourlist.append(!!ce)
  !colourlist.appendarray(!support.atta)

-- Colour Support
  call !!kenhancelist(!colourlist)

-- Reset all pins associated with this support
  call !!Mdsresetpins(1,10)

-- Update support data held in form
  !!Mdsvt21.support = !support

-- Show dimensions on graphics if required
  if !!Mdsvt21.GraphicalDim then
    !!Mdsshowdim(!!Mdsvt21)
  endif
-- Lock any items that have been locked
  if !ResetLock then
    do !Lock values !Unlocked
      !!ce = !Lock
      lock all
    enddo
  endif

  !!ce = !stru

--------------------------------------------------------------------------------------
-- Remove Wait.. Prompt from Screen
  !!Mdscreatemess(false)

-- Reset Units
  !!kRestoreUnits(!currentunits)
-----------------------------------------------------
-----------------------------------------------------


-- End function
endfunction

-- End of file Mdsmirrorvt21.pml
