--------------------------------------------------------------------------------
--
-- File:      Mdsmmdsadp.pmlfnc
-- Type:      Function Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    design
-- Replaces:
--
-- Author:    N.morris
-- Created:   Mon Aug 17
--
--
-- Description:
-- Function to add/rem elements to the ADP drawlist
-- Uses the :MdsAdp attribute of the datum atta to store the element names
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MODE          ADD, REMOVE
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMMdsAdp(!mode is STRING)

  !form = !!mdsMdsAdp.form

-- set up the type of list add or remove
  if !!mdsMdsAdp.addrem.val eq 1 then
    !listtype = 'MdsAdp'
   else
    !listtype = 'MdsAdpRem'
   endif
-- MODE ADD

  if !mode eq 'ADD' or !mode eq 'ADDCE' then
    -- NEMC Floquet: to run loop one time if ADDCE
    !done = false

    do
      break if !done

-- test number of elements already added

--<kp>july06
      --!test = !form.support.datum.:$!listtype
      !test = !form.support.getElemForUDA().:$!listtype
      if defined(!test[100]) then
       return error 1 |A maximum of 100 elements may be added to the MDS ADP drawlist. Remove an element first|
     endif

-- Identify element
      if !mode eq 'ADD' then
      prompt off
      prompt load escape |Identify element to add to the MDS ADP drawlist|
      id @
        handle (61,528)
          !!mdsDacControl(false)
          prompt on
          return
        endhandle

--<wd>july2003
      if (!!ce.owner.type.eq('BRAN')) then
        !pick = !!ce.owner
      elseif !!ce.owner.type.eq('HANG') then
        !pick = !!ce.owner
      else
          if !!mdsMdsAdp.signif.val then
-- Climb to signif element
            do from 1 to 20
            if !!ce.signif.not() then
              end
            else
              break
            endif
          enddo
        endif
        !pick = !!ce
      endif
--<wd>july2003

      else
        -- NEMC Floquet: ADDCE picks CE and sets Done to exit at next loop
        !pick = !!ce
        !done = true
      endif

-- Create form list (STRING)

--<kp>july06
      --!dBList = !form.support.datum.:$!listtype
      !dBList = !form.support.getElemForUDA().:$!listtype
      !stringList = ARRAY()
      do !sL values !dBList
        !stringList.append(!sL.fullname)
      enddo

-- Is it part of the support therefore already added to the drawlist by default
-- Search for BRAN or STRU

-- Add all branches to search list

      !searchList = ARRAY()

      do !addBranch values !form.support.atta
        !searchList.append(!addBranch.owner)
     enddo

-- Add stru to searchlist

      !searchList.append(!form.support.stru)
      !searchList.unique()

-- Generate list of bran and stru from identified element

      !testBran.delete()
       handle (2,751)
       endhandle
      !testBran = branch of ce
       handle (2,111)
        !testBran = STRING()
       endhandle

      !testStru.delete()
       handle (2,751)
       endhandle
      !testStru = stru of ce
       handle (2,111)
        !testStru = STRING()
       endhandle

      if !testBran.set() then
        !branch = !searchList.find(!testBran)
        if !branch.set() then
          !!alert.error('The identified element is already part of the drawlist because it is part of the support!')
          skip
       endif
     endif

      if !testStru.set() then
        !stru = !searchList.find(!testStru)
        if !stru.set() then
          !!alert.error('The identified element is already part of the drawlist because it is part of the support!')
          skip
       endif
     endif

      if !form.support.type.eq(!!mdslsuppdefs.type) then
     -- lighting support
        !light = !form.support.light
        !ancref = !form.support.ancref
        !pickOwner = $!light.type of $!pick
           handle ANY
          !pickOwner = nulref
           endhandle
        if !pickOwner.eq(!light) then
          !!alert.error('The identified element is already part of the drawlist because it is part of the support!')
          skip
        endif
        !pickOwner = $!ancref.typ of $!pick
        handle ANY
          !pickOwner = nulref
        endhandle
        if !pickOwner.eq(!ancref) then
          !!alert.error('The identified element is already part of the drawlist because the support is connected to!')
           skip
        endif
     endif

-- Is it already in the drawlist

      !testExists = !stringList.find(!!ce.fullname)
      if !testExists.set() then
        !!alert.error('Already in MDS ADP Drawlist!')
        skip
      endif

--<wd>july2003
      --!stringList.append(!!ce.fullname.string())
      !stringList.append(!pick.fullname.string())
--<wd>july2003

-- Create uda attribute list (DBREF)
--<wd>july2003
      --!dBList.append(!!ce.ref)
      !dBList.append(!pick.ref)
--<wd>july2003

-- Create string of refs for RTEXT

      !stringRtext = ARRAY()
      do !setRtext values !dBList
        !stringRtext.append(!setRtext.string())
      enddo

-- Set form list

--<wd>july2003
      --!!mdsMdsAdp.eleList.dtext = !stringList
      --!!mdsMdsAdp.eleList.rtext = !stringRtext
      !!mdsMdsAdp.eleList.dtext = !stringList.unique()
      !!mdsMdsAdp.eleList.rtext = !stringRtext.unique()
--<wd>july2003

-- Set :MdsAdp attribute

-- <kp>july06
      --!!ce = !form.support.datum
      !!ce = !form.support.getElemForUDA()
-- <kp>july06

      !!mdsDacControl(true)
      do !count
        :$!listtype num $!count $!dBList[$!count]
           handle (2,752)
             break
           endhandle
        !colour = !!gphColOpt.highlight().code
        ENHANCE $!dBList[$!count] COLOUR $!colour
        !!mdsMdsAdp.enhance.append(!dBList[$!count])
        refresh
      enddo

      !!mdsMdsAdp.enhance.unique()

    enddo

  endif

-- MODE REMOVE

  if !mode eq 'REMOVE' then

-- Is there anything selected to remove

    if !!mdsMdsAdp.eleList.val.unset() then
       return error 1 |No element selected to remove|
    endif

    if !!mdsMdsAdp.eleList.val.eq(0) then
       return error 1 |No elements in MDS ADP drawlist to remove|
    endif

-- Remove from form list

    !selected = !!mdsMdsAdp.eleList.val
    !displayed = !!mdsMdsAdp.eleList.dtext
    !removedRef = !!mdsMdsAdp.eleList.rtext[$!selected]
    !replacement = !!mdsMdsAdp.eleList.rtext
    !displayed.remove(!selected)
    !replacement.remove(!selected)
    !!mdsMdsAdp.eleList.dtext = !displayed
    !!mdsMdsAdp.eleList.rtext = !replacement

-- Clear enhance member and reset values

    !!mdsMdsAdp.enhance.clear()
    do !resetList values !!mdsMdsAdp.eleList.rtext
      !!mdsMdsAdp.enhance.append(!resetList.dbref())
    enddo

-- Clear :MdsAdp uda and reset

--<kp>jul06
    --!!ce = !form.support.datum
    !!ce = !form.support.getElemForUDA()

    !!mdsDacControl(true)
    :$!listtype def
    !count = 1
    do !resetUda values !!mdsMdsAdp.eleList.rtext
      :$!listtype num $!count $!resetUda
      !count = !count + 1
    enddo
    !!mdsDacControl(false)

-- Unenhance element

    unenhance $!removedRef

  endif

endfunction
