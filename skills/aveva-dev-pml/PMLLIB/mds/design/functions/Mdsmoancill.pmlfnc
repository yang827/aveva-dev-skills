--
-- File:       Mdsmoancill.pmlfnc
-- Type:       Function Definition
-- Group:      Multi Discipline Supports Application
-- Keyword:    MDS
-- Module:     design
-- Replaces:
--
-- Author:     N.Morris
-- Created:    Fri Nov 7
--
--
-- Description:
-- Function to modify ancillary component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsMoAncill()

  -- This can be called by two form !!mdsModanc or !!mdsEditProp
  -- These form cannot be shown at the same time so therefore one
  -- will be displayed. Find out which and set !callingForm to
  -- the calling form

  if (!!mdsEditProp.shown()) then
    !callingForm = !!mdsEditProp
  elseif (!!mdsModAt.shown()) then
    !callingForm = !!mdsModAt
  endif

  ------------------------------------
  !currentunits = !!kgetsetunits()
  ------------------------------------

  -- Check to see if the user has selected the same type

  !selection = !!mdsAncill.standard.selection('Rtext')
  !existType = !!ce.styp
  !existingDirection = p3 dir wrt /*

  if (!existType eq !selection) then
    !!alert.error('The ancillary is already of this type.')
    -- Redefine callback on ancill form not to continue
    !!mdsAncill.action[2] = ||
    !!mdsAncill.action[3] = |!!doNotId = TRUE|
    !!kRestoreUnits(!currentunits)
    return

    --<wd>jan2004
    -- Check if the Selected Support Type is a Pipe Shoe Guide - Advise User to DELETE the Existing Atta first then CREATE the REQUIRED Ancillary Type from NEW
  elseif (!selection inset ('GT01','GT06','GT07','GT08','GT18','GT19','GT01','GT21','GT26','GT28','GT60A','GT60B','GT73','GT74','GT75','GT76')) then
    !!alert.error('Unable to modify the existing ancillary to a GUIDE. Please DELETE the existing ancillary and then CREATE the GUIDE as required.')
    -- Redefine callback on ancill form not to continue
    !!mdsAncill.action[2] = ||
    !!mdsAncill.action[3] = ||
    !!kRestoreUnits(!currentunits)
    return
    --<wd>jan2004

  endif

  !!mdsDacControl(true)
  mtoref def
  handle ANY
  endhandle

  --<wd>oct2004
  -- In Modify Mode it is necessary to set the MDSSUPPORT object member .idbran to the Owning Branch of the !!CE
  !!mdsAncill.form.support.idbran = !!ce.owner
  --<wd>oct2004

  -- Perform Any actions required BEFORE the modification of a MDS ANCILLARY Standard ATTA
  !where = ''
  !set   = object MDSFRAMEANCILLS()

  --<wd>oct2004
  --!set.before(!!mdsAncill,!selection)
  !set.before(!!mdsAncill.form,!selection)
  --<wd>oct2004

  if (!set.return) then
    !idcomp = !set.idcomp
    !where  = !set.where
  else
    -- Creation Aborted by USER during Identification via the Graphical View
    return
  endif


  !!ce = !callingForm.atta
  --<ge 15/12/04 Turn DAC's on fix for HPD0027233
  !!mdsDacControl(true)

  if (!!ce.type.neq('CTSUPP')) then
    SEL SPREF WITH STYP '$!selection' SPEC /MDS
  else
    !cbore = !!ce.ppbor[1]
    -- compose list of ATTA sprefs of current bore
    !sprefList = !!mdsSelectSpref('ATTA',!cbore,'',/MDS )
    -- compose parallel list of stypes
    !stypList = ARRAY()
    do !spref values !sprefList
      !currStype = !spref.styp
      handle ANY
        !currStype = ''
      endhandle
      !stypList.append(!currStype)
    enddo
    !stypIndx = !stypList.findFirst(!selection)
    !!ce.spref = !sprefList[!stypIndx]
  endif

  if ((Desc of /MDS/TEMPLATES ) neq 'Framatome Templates') then
    :MDSSuppType '$!selection'
  else
    -- dtf >>> 02.09.06 mod to delete plate if :mdsplate set
    if (!!ce.type.eq('ATTA')) then
      !plat = !!ce.:mdsplate
      handle ANY
      elsehandle NONE
        if (!plat.unset().not()) then
          if (!plat.owner.type.eq('PNOD')) then
            !amhere = !!ce
            !!ce = !plat.owner
            delete PNOD
            handle ANY
            endhandle
            !!ce = !amhere
            :MDSPlate def
          endif
        endif
      endhandle
    endif
    -- dtf <<< 02.09.06 end of mod
  endif

  !!mdsDacControl(false)
  --<ge 15/12/04 Turn DAC's off fix for HPD0027233

  -- set the design parameters for the selected atta
  if (!!mdsSetDesPars(!!ce).not()) then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- if the element contains no design parameters then set the despar att to unset
  -- this may be that no dataset exists or no data elements exist with the

  if (!!ce.dtre.set().not()) then
    despar unset
  else
    !dtre = !!ce.dtre
    !despData = !!kCollectAllFor('DATA','(PURP EQ |DESP|)', !dtre)
    !!ce = !despData[1]
    handle any
      despar unset
    elsehandle none
      same
    endhandle
  endif

  -- When the user modifies the ancill type he may change it to a type that
  -- cannot accommodate a guide, and a guide may already be assigned. Check
  -- this and issue a warning

  !return = !!ce

  if (!!ce.type.neq('CTSUPP')) then
    if (!!ce.catref.owner.:MdsGuidable) then
      -- If the shoe has a guide attached to it we may have to update the guide
      -- design parameters
      !!mdsResetGuide()

      --<wd>oct2004
    elseif (!!ce.owner.:mdstrun) then
      -- Branch is a Trunnion Branch so reset the Guide REFERENCE etc..
      !!mdsResetGuide()
      --<wd>oct2004

    else
      !guide = :MDSGuideRef
      if (!guide.badref().not()) then
        !!alert.error('You have modified the support type to one which cannot accommodate a guide, but one has been assigned to the support. The guide will be deleted')
        !!mdsDacControl(true)
        :MDSGuideRef unset
        !!ce = !guide
        handle none
          delete atta
          !!ce = !return
          !!kRestoreUnits(!currentunits)
          return
        elsehandle any
          !!alert.error('The guide referenced to this support does not exist and therefore cannot be deleted')
          !!ce = !return
          !!kRestoreUnits(!currentunits)
          return
        endhandle
        !!mdsDacControl(false)
      endif
      !!ce = !return
    endif
  endif

  !alias = !!ce.styp
  !!mdsSetGadgets(!callingForm,!!ce,!alias)

  !!ce = !return

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(TRUE)

  -- If the p3 is not in the same direction, try and make it

  !newDir = p3 dir wrt /*
  if (!existingDirection.neq(!newDir)) then
    !cepos = pos wrt /*
    conn
    thro $!cepos wrt /*
  endif

  ----------------------------------------------------------------------------------------------
  -- Perform ANY actions required AFTER the Creation of a MDS ANCILLARY Standard ATTA
  if (!set.return) then
    !set.form = !!mdsAncill
    !set.after(!idcomp,!callingForm.atta)
  endif
  --<wd>jan2004

  -- Delete any lugs that may have existed and then recreate then

  !attaName = !!ce.name
  !atta = !!ce
  do !loop from 1 to 4
    $!attaName/LUG$!loop
    handle NONE
      delete olet
    elsehandle ANY
    endhandle
  enddo
  $!attaName
  !!mdsCreateLugs()

  -- Reset the stex if needed

  !!mdsTransport(!atta,!attaName)


  !!kRestoreUnits(!currentunits)
  !!mdsDacControl(false)

endfunction
