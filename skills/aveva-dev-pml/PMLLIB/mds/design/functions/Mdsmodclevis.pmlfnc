--   Replaces:
--
-- Author:  N.morris
-- Created:  Wed Oct 29
--
--
-- Description:
-- function to modify the height of an hanger
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        DBREF         Reference of atta
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsModClevis(!form is FORM, !atta is DBREF)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !alias = !form.support.alias

  !!ce = !atta

  var !savedSpref spref
  var !savedDespar despar

  -- Set the correct spref for the clevis size on the form
  -- and rod length

  !rodLength = !!kStrReal('const dist p41 to p42')
  --    !a = 500
  --    !b = 1000
  --    !c = 1500
  --    !d = 2000
  -- get format
  --         !!kFormatText.text.val = !d
  --         !dF = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

  --    if (!rodLength.leq(!a)) then
  --      !rodChar = 'A'
  --    elseif (!rodLength.leq(!b)) then
  --      !rodChar = 'B'
  --    elseif (!rodLength.leq(!c)) then
  --      !rodChar = 'C'
  --    elseif (!rodLength.leq(!d)) then
  --      !rodChar = 'D'
  --    endif


  -- Need to set the correct spref for the rod length

  !!ce = !atta
  !rtnCheck = ''
  !rtnIdent = ''
  !rtnLen = 0
  !rtnMin = 0
  !rtnMax = 0


  !!mdsGetRod(!atta,!rtnCheck,!rtnIdent,!rtnLen,!rtnMin,!rtnMax)

  !rodChar = !rtnIdent

  !!kFormatText.text.val = !rtnLen
  !fRtnLen = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
  !!kFormatText.text.val = !rtnMax
  !fRtnMax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

  if (!rtnCheck eq 'OVER') then


    !!alert.error('Rod length of ' & !fRtnLen  & ' exceeds the stated value in the default settings. $
    The maximum is ' & !fRtnMax  & ', no change to support rod length.')
    -- Reset hanger
    spref $!savedSpref

    despar $!savedDespar
    !resetRod = !!kStrReal('const dist p41 to p42')
    !form.rodLength.val = !resetRod
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Set spref

  -- Update rod length incase beam attachment has been modified
  !resetRod = !!kStrReal('const dist p41 to p42')
  !form.rodLength.val = !resetRod


  -- Set spref

  -- !part1 = !alias.substring(1,4)
  !part1 = (subs('$!alias',1,4))
  !styp = !part1 & '-' & !form.clevis.selection('DTEXT') & '-' & !rodChar
  !num = p3 bore of :MDSSref
  !realNum = !num.real()
  SELECT SPREF WITH STYP '$!styp' NUM $!realNum SPEC /MDS

  -- Set the correct rod length

  !rodLength = !!kStrReal('const dist p41 to p42')
  !form.rodLength.val = !rodLength
  -- get format
  !!kFormatText.text.val = !form.rodLength.val
  !fRodLength = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
  !!kFormatText.text.val = !!mdsOptions.minHangRod
  !fMinHangRod = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)


  -- Now check if the change in rod length put it over the min or max
  -- dummy variable needed cos the form gadget directly into .lt dont work
  !dummyRodL = !form.rodLength.val

  if (!dummyRodL.lt(!!mdsOptions.minHangRod)) then
    !!alert.error('The change in clevis size has decreased the length of the rod $
    to less than the minimum value as defined in the default settings.$
    (' & !fRodLength & ' entered, Minimum is ' & !fMinHangRod & ') Setting to previous value')
    spref $!savedSpref
    despar $!savedDespar
    !rodLength = !!kStrReal('const dist p41 to p42')
    !form.rodLength.val = !rodLength
    !bef  = :MDSSuppType

    !clevisChar = !savedSpref.after(!bef).substring(2,1)

    -- var !clevisChar (after('$!savedSpref','$!bef'))
    -- var !clevisChar (subs('$!clevisChar',2,1))
    !form.clevis.select('DTEXT', !clevisChar)
  elseif (!form.rodLength.val.gt(!rtnMax)) then
    !!alert.error('The change in clevis size has increased the length of the rod and it is more than the maximum allowed. ('$
    & !fRodLength & ' entered, Maximum is ' & !fRtnMax & '. Setting to previous value')
    spref $!savedSpref
    despar $!savedDespar
    !resetRod = !!kStrReal('const dist p41 to p42')
    !form.rodLength.val = !resetRod
    !bef = :MDSSuppType
    !clevisChar = !savedSpref.after(!bef).substring(2,1)
    --    var !clevisChar (after('$!savedSpref','$!bef'))
    --   var !clevisChar (subs('$!clevisChar',2,1))
    !form.clevis.select('DTEXT', !clevisChar)
  endif

  -- Reset Units

  !!kRestoreUnits(!currentUnits)


endfunction
