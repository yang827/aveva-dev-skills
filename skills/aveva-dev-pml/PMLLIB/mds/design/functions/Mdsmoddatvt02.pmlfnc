--
-- File:		Mdsmoddatvt02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 9th January 1998
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsmoddatvt02()

  -- Initialise variables
    !tubetype = !!Mdsoptions.pipes
    !support  = !!Mdsvt02.support
    !datum    = !support.datum
    !name     = !support.stru.name

--------------------------------------------------------------------------------
    if (!datum.set().not()) then
      !!alert.error('Datum atta for support MUST be Created before it can be modified')
      return
    endif

-- Navigate to Datum Atta
    !!ce = !datum
--------------------------------------------------------------------------------
-- Change callback on 'Mdstrunnvt01' form apply button
    !!Mdstrunnvt01.action.clear()
    !!Mdstrunnvt01.action[1] = |call !!Mdsmodtrunnvt02(!!Mdsvt02)|
    !!Mdstrunnvt01.action[2] = |call !!Mdscreatevt02('DIMENSION')|

-- Edit Form title
    !!Mdstrunnvt01.formtitle = 'Trunnion Selection for Support Type '& !support.replace &''

-- Show Available Trunnions in 'Mdstrunnvt01' form for Current Pipe Size Only
-- and Trunnions allowed for 'VT02' type of Vessel Framework
    !!kshowform(!!Mdstrunnvt01)
    !!Mdsitrunnvt01('VT02')

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdsmoddatvt02.pml
