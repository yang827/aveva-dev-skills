--
-- File:		Mdsmodguide.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to modify a guide
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Qualifer 'HEIGHT' 'CLEARANCE'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsModGuide(!Form is FORM, !Type is string,!Atta is dbref)

  !CurrentUnits = !!KGetSetUnits()

  -- Initialise Variables
    !Support = !Form.support
    !PassedType = !Type
    !SuppType = !Form.Support.Type
    !Alias = !Form.Support.Alias

    !!CE = !Atta

    !Bore = pa bore

    if (match(!SuppType,|GT04|) gt 0) then
      !SuppType = !!CE.styp
    endif
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
    if ('$!Supptype' eq 'Unset') then
      !SuppType = !!CE.styp
      --!ParVar = '!!MdsPar' + !SuppType
    else
      --!ParVar = '!!MdsPar' + !SuppType
    endif

    !realbore = !bore.real().value()
    !mdsattaobj  = object mdsreadparsdata()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)

--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

    if (!passedtype eq 'LENGTH') then

      !DpNum = !!MdsGetDesp('LEN')

------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>

      --!Expr = $!ParVar[$!Bore].altexpr
      --!Altdespar = $!ParVar[$!Bore].altdespars

      !Expr = !mdsattaobj.altexpr
      !Altdespar = !mdsattaobj.altdespars

      --!Min = $!ParVar[$!Bore].userdps[$!DpNum].min
      --!Max = $!ParVar[$!Bore].userdps[$!DpNum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max

--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

-- Get formats
        !!KFormatText.text.val = !Form.Length.val
        !FLength = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Min
        !FMin = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Max
        !FMax = !!kformattext.text.val.string(!!$!!kFormattext.text.format)

      if (!Form.Length.val.nint() lt !Min.nint()) then
        !!Alert.error('Length entered ' & !FLength & ' is less than the minimum allowed. Setting Length to minimum of ' $
                                        & !FMin)
        !Form.Length.val = !Min
        !!MdsSetDesPar(!!CE,!dpnum,!Min)
      endif

      if (!Form.Length.val.nint() gt !max.nint()) then
        !!Alert.error('Length entered ' & !FLength & ' is greater than the maximum allowed. Setting Length to maximum of ' $
                                        & !FMax)
        !Form.Length.val = !Max
        !!MdsSetDesPar(!!CE,!dpnum,!Max)
      endif

      !!MdsSetDesPar(!!CE,!dpnum,!Form.Length.val)

      if (!Expr.set()) then
        var !test ($!expr)
        if (!test.boolean()) then
          do !set values !Altdespar
            !!MdsSetDesPar(!!CE,!set.dpnum,!set.altval)
          enddo
        else
          !!MdsSetDespars(!!CE)
          !!MdsSetDespar(!!CE,!dpnum,!Form.Length.val)
        endif
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
        --!Dpnum = $!ParVar[$!Bore].userdps[1].dpnum
        !dpnum = !mdsattaobj.userdps[1].dpnum
--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

        !!MdsSetDespar(!!CE,!dpnum,!Form.length.val)
      endif

    elseif (!passedtype eq 'CLEARANCE') then

      !DpNum = !!MdsGetDesp('CLR')
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
      --!Min = $!ParVar[$!Bore].userdps[$!DpNum].min
      --!Max = $!ParVar[$!Bore].userdps[$!DpNum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max

--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------
-- Get formats
        !!KFormatText.text.val = !Form.Clearance.val
        !FClearance = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Min
        !FMin = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Max
        !FMax = !!kformattext.text.val.string(!!$!!kFormattext.text.format)

      if (!Form.Clearance.val.nint() lt !Min.nint()) then
          !!Alert.error('Clearance entered ' & !FClearance & ' is less than the minimum allowed. Setting Clearance to minimum of '$
                                           & !FMin)
        !Form.Clearance.val = !Min
        !!MdsSetDesPar(!!CE,!dpnum,!Min)
      endif

      if (!Form.Clearance.val.nint() gt !max.nint()) then

        !!Alert.error('Clearance entered ' & !FClearance & ' is greater than the maximum allowed. Setting Clearance to maximum of ' $
                                           & !FMax)
        !Form.Clearance.val = !Max
        !!MdsSetDesPar(!!CE,!dpnum,!Max)
      endif
      !!MdsSetDesPar(!!CE,!dpnum,!Form.Clearance.val)

    elseif (!passedtype eq 'ECLR') then

      !DpNum = !!MdsGetDesp('ECLR')
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
      --!Min = $!ParVar[$!Bore].userdps[$!DpNum].min
      --!Max = $!ParVar[$!Bore].userdps[$!DpNum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max
--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

-- Get formats
        !!KFormatText.text.val = !Form.Extra.val
        !FClearance = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Min
        !FMin = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Max
        !FMax = !!kformattext.text.val.string(!!$!!kFormattext.text.format)

      if (!Form.Extra.val.nint() lt !Min.nint()) then
          !!Alert.error('Extra Clearance entered ' & !FClearance & ' is less than the minimum allowed. Setting Extra Clearance to minimum of '$
                                           & !FMin)
        !Form.Extra.val = !Min
        !!MdsSetDesPar(!!CE,!dpnum,!Min)
      endif

      if (!Form.Extra.val.nint() gt !max.nint()) then

        !!Alert.error('Extra Clearance entered ' & !FClearance & ' is greater than the maximum allowed. Setting Extra Clearance to maximum of ' $
                                           & !FMax)
        !Form.Extra.val = !Max
        !!MdsSetDesPar(!!CE,!dpnum,!Max)
      endif
      !!MdsSetDesPar(!!CE,!dpnum,!Form.Extra.val)

    elseif (!passedtype eq 'HEIGHT') then

      !DpNum = !!MdsGetDesp('HEI')

------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
      --!Min = $!ParVar[$!Bore].userdps[$!DpNum].min
      --!Max = $!ParVar[$!Bore].userdps[$!DpNum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max
--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

-- Get formats
        !!KFormatText.text.val = !Form.Height.val
        !FHeight = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Min
        !FMin = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Max
        !FMax = !!kformattext.text.val.string(!!$!!kFormattext.text.format)

      if (!Form.Height.val.nint() lt !min.nint()) then
        !!Alert.error('Height entered ' & !FHeight & ' is less than the minimum allowed. Setting Height to minimum of ' $
                                        & !FMin)
        !Form.Height.val = !Min
        !!MdsSetDesPar(!!CE,!dpnum,!Min)
      endif

      if (!Form.Height.val.nint() gt !max.nint()) then
        !!Alert.error('Height entered ' & !FHeight & ' is greater than the maximum allowed. Setting Height to maximum of '$
                                        & !Fmax)
        !Form.Height.val = !Max
        !!MdsSetDesPar(!!CE,!dpnum,!Max)
      endif
      !!MdsSetDesPar(!!CE,!dpnum,!Form.Height.val)

    elseif (!passedtype eq 'PTHK') then

      !DpNum = !!MdsGetDesp('PTHK')
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
      --!Min = $!ParVar[$!Bore].userdps[$!DpNum].min
      --!Max = $!ParVar[$!Bore].userdps[$!DpNum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max
--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------
-- Get formats
        !!KFormatText.text.val = !Form.Thickness.val
        !FThickness = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Min
        !FMin = !!kformattext.text.val.string(!!$!!kFormattext.text.format)
        !!KFormatText.text.val = !Max
        !FMax = !!kformattext.text.val.string(!!$!!kFormattext.text.format)

      if (!Form.Thickness.val.nint() lt !min.nint()) then
        !!Alert.error('Thickness entered ' & !FThickness & ' is less than the minimum allowed. Setting Thickness to minimum of ' $
                                        & !FMin)
        !Form.Thickness.val = !Min
        !!MdsSetDesPar(!!CE,!dpnum,!Min)
      endif

      if (!Form.Thickness.val.nint() gt !max.nint()) then
        !!Alert.error('Thickness entered ' & !FThickness & ' is greater than the maximum allowed. Setting Thickness to maximum of '$
                                        & !Fmax)
        !Form.Thickness.val = !Max
        !!MdsSetDesPar(!!CE,!dpnum,!Max)
      endif
      !!MdsSetDesPar(!!CE,!dpnum,!Form.Thickness.val)

    endif


-- Reset Units

   !!kRestoreUnits(!currentunits)

return

endfunction
