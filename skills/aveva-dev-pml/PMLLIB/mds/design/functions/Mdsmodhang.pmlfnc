--
-- File: Mdsmodhang.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Wed Oct 29
--
--
-- Description:
-- function to modify the height of an hanger
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        DBREF         Reference of atta
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsModHang(!form is FORM, !modify is STRING, !atta is DBREF)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !unusedsupport = !form.support
  !alias = !form.support.alias

  !!ce = !atta

  -- Save existing spref and despars

  var !savedspref Spref
  var !saveddespar despar

  if (!modify eq 'STEEL') then

    -- Set height of hanger to identified steelwork

    prompt off
    prompt load escape 'Identify steelwork to support hanger from'
    --<wd>17jan2008 -- Defect No. P-4407
    --      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE @
    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE HSTIFF HPLATE @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
    !unusedsteel = !!ce.name
    if (!form.support.type inset('HT01','HT02')) then
      pin 9 copy p3 of $!atta
    else
      pin 9 copy p42 of $!atta
    endif
    pin 9 dir u wrt /*
    pin 8 copy pin 9
    pin 8 dir u wrt /*
    pin 8 plane pin 8 clear 0 inf CE
    !dist = !!kStrReal('const dist pin 9 to pin 8')

    -- If the dist between pin 8 and pin 8 is less than 150mm or 6in, then
    -- error Pin 8 to pin 9 is the distance between the pivot point and the
    -- under side of the steelwork. First check to see if pin 8 is below pin 9      -- i.e. the steel work is below the pipe

    var !pin8u pin 8 u wrt /*
    var !pin9u pin 9 u wrt /*

    --> Modified -<wd>12oct1998
    if (!pin8u.real().lt(!pin9u.real())) then
      --xxx      if (!pin8u.lt(!pin9u)) then
      --< Modified -<wd>12oct1998

      !!alert.error('Identified steel is below the hanger')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsResetPins(8,9)

    !toshort = false
    --   var !unit units
    --    var !units split |$!unit|

    --   if (!units[3] eq 'MM') then
    --   var !pindist (dist($!dist))
    if (!dist.lt(!!mdsoptions.minhangrod)) then
      !toshort = true
    endif
    --  else
    --   var !pindist (dist($!dist$nin))
    --   if (!pindist.real() lt !!mdsoptions.minhangrod) then
    --    !toshort = true
    --  endif
    --endif

    -- get format
    !!kformattext.text.val = !dist
    !fdist = !!kformattext.text.val.string(!!$!!kformattext.text.format)
    -- get format
    !!kformattext.text.val = !!mdsoptions.minhangrod
    !fMinHangRod = !!kformattext.text.val.string(!!$!!kformattext.text.format)


    if (!toshort) then
      !!alert.error('Identified steel is to near the pipe to support with this hanger. (' & $
      !fdist &  ' between pivot and under side of identified element, Minimum is ' & $
      !fMinHangRod & ')')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!ce = !atta

    despar n1 $!dist

    -- Reset form

    !rodlength = !!kStrReal('const dist p41 to p42')
    !form.rodlength.val = !rodlength

  elseif (!modify eq 'LENGTH') then

    -- Is value greater that the minimum length defined in the default file
    -- dummy cos form gadget directly into the lt method dont work
    !dummyrodlength =  !form.rodlength.val
    if (!dummyrodlength.lt(!!mdsoptions.minhangrod)) then

      !!kformattext.text.val = !form.rodlength.val
      !frodlength = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !!kformattext.text.val = !!mdsoptions.minhangrod
      !fMinHangRod = !!kformattext.text.val.string(!!$!!kformattext.text.format)
      !!alert.error('Rod length of ' & !frodlength & ' is less than the minimum value $
      as defined in the default settings. (Minimum is ' &  !fMinHangRod $
      & ') regenerating support to minimum rod length')
      !form.rodlength.val = !!mdsoptions.minhangrod
    endif

    -- Set rod length
    -- Current rod length is the dist between p41 and p42

    !!ce = !atta
    !existrodlength = !!kStrReal('const dist p41 to p42')
    !newrodlength = !form.rodlength.val
    !diff = !existrodlength - !newrodlength
    !dp1 = despar 1
    !newDp1 = !dp1[1] - !diff
    despar n1 $!newDp1

  endif

  -- Need to set the correct spref for the rod length

  !!ce = !atta
  !rtncheck = ''
  !rtnident = ''
  !rtnlen = 0
  !rtnmin = 0
  !rtnmax = 0

  !!mdsgetrod(!atta,!rtncheck,!rtnident,!rtnlen,!rtnmin,!rtnmax)

  !rodchar = !rtnident

  if (!rtncheck eq 'OVER') then

    !!kformattext.text.val = !rtnlen
    !fRtnLen = !!kformattext.text.val.string(!!$!!kformattext.text.format)
    !!kformattext.text.val = !rtnmax
    !fRtnMax = !!kformattext.text.val.string(!!$!!kformattext.text.format)
    !!alert.error('Rod length of ' & !fRtnLen  & ' exceeds the stated value in the default settings. $
    The maximum is ' & !fRtnMax  & ', no change to support rod length.')
    -- Reset hanger
    spref $!savedspref

    despar $!saveddespar
    !resetRod = !!kStrReal('const dist p41 to p42')
    !form.rodlength.val = !resetRod
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Set spref

  if (!alias inset('HT01','HT02')) then
    !part1 = (subs('$!alias',1,4))
    !styp = !part1 & '-' & !form.clevis.selection('DTEXT') & '-' & !rodchar
    !num = p3 bore of :MDSSref
    !realNum = !num.real()

    SELECT SPREF WITH STYP '$!styp' NUM $!realNum SPEC /MDS
  else
    !part1 = (subs('$!alias',1,4))
    !part2 = (subs('$!alias',5,5))
    if (!part2 eq '') then
      !styp = !part1
    else
      !styp = !part1 + '-' + !part2
    endif
    SELECT SPREF WITH STYP '$!styp-$!rodchar' SPEC /MDS
  endif

  -- Update rod length incase beam attachment has been modified
  !resetRod = !!kStrReal('const dist p41 to p42')
  !form.rodlength.val = !resetRod

  -- Reset Units

  !!kRestoreUnits(!currentUnits)


endfunction
-- End of function definition for !!mdsModHang
