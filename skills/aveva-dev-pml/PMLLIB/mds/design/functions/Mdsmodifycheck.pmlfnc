--
-- Author:		N.Morris
-- Created:		Mon Oct 1
--
--
-- Description:
-- Function to check if a support is being modified
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
---    3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsModifyCheck()

  -- Check if a support is being modified by seeing if the dismiss button is deactivated.

    if (!!MdsModifySupp.Cancel.Active.not()) then
      !!Alert.error('This form was being used as a parent form to a modify support process, the support form may have disappeared. The support modification may not have been complete!.')
      !!MdsModifySupp.Cancel.Active = true
    endif

-- End function
endfunction

-- End of file Mdsmodifycheck.pml
