--
--------------------------------------------------------------------------------
--
-- File:      Mdsmodifyname.pmlfnc
-- Type:      Result Macro
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    Design
-- Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Monday 26th January 1998
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         REAL         Index of Structure in the Mdscopysupp.copynames[!numb] array
--                                  Note: Will ALWAYS be 1 when Argument 3 is 'NAMEONLY'
--
--     2     R         REAL         Number of the ARRAY Mdscopysupp.copynames (Copy Number)
--                                  Note: Will ALWAYS be 1 when Argument 3 is 'NAMEONLY'
--
--     3     R         STRING       COPY - Function is called from the Copy Support Form
--                                  NAMEONLY - Function is Called from MDS Top BAr Menu option
--                                            'Modify>Support Name...'
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Description:
-- Function to Modify Support Name
--
-- Used on Callback of the '!!mdsmodifyname.ok' button for COPYING of SINGLE or MULTIPLE Supports
-- and for Individually Modifying the 'NAMEONLY' of a MDS Support Structure and Associated Attas
--
--------------------------------------------------------------------------------

define function !!mdsmodifyname(!dummyindex is REAL,!numb is REAL,!mode is STRING)

  --dun1218 these are required to make sure we have a proper hanger type when writing out connection macros
  !civilHanger = FALSE
  !sctnHanger = FALSE

  --dun1218 test whether or not this is a interface hanger connected to a sctn or civils
  !currentName = '/' + !!mdsmodifyname.name.val
  !currentDbref = !currentName.dbref()

  if (!currentDbref.type.eq('ATTA')) then
    !suppfunc = !!ce.:MDSSuppType
    handle ANY
      !suppfunc = ''
    endhandle

    !config = !!ce.:MDSHConfig
    handle ANY
      !config = ''
    elsehandle NONE
      !config = !config.before('H').before('V')
    endhandle

    if (!suppfunc.eq('MH01')) then
      if (!config inset ('1','2','31','32','7','21')) then
        !sctnHanger = TRUE
      elseif (!config inset ('18','19','20','25')) then
        !civilHanger = TRUE
      endif
    endif
  endif

--------------------------------------------------------------------------------

-- Initialise Variables
  !newnam = !!mdsmodifyname.newName.val
  !groupMemberList = ARRAY()
  !isPartOfGroup = FALSE

  -- Reset Value of '.newName' gadget to remove '/' character
-- if it is the first character in the displayed gadget
  if (!newnam.match('/').eq(1)) then
    !!mdsmodifyname.newName.val = !newnam.after('/')
  endif

--------------------------------------------------------------------------------

  if (!mode eq 'COPY') then

    -- Check that gadget !!mdsmodifyname.newName.val is not set to 'unset'
    if (!!mdsmodifyname.newName.val.lowcase() eq 'unset') then

      !!alert.error(|The New Name of the Existing Support may NOT be 'unset'. The Support Name is Unchanged.|)

      -- Temporary Name of Support is !!mdsmodifyname.name.val
---------------------------------------------------------
-- Modify Stex of Atta(s) to reflect the Temporary Name of the Support
----------------------------------------------------------------------
      do !count index !!mdscopysupp.copynames[!numb]
        !!ce = !!mdscopysupp.copynames[!numb][!count]
        if (!!ce.type.string().eq('ATTA') and !!ce.name.match('/SREF').eq(0)) then
          if (!!ce.name.match('/DATUM') gt 0) then
            !!mdsTransport(!!ce,!!ce.name.before('/DATUM').string())
          else
            !!mdsTransport(!!ce,!!ce.name.string())
          endif
        endif
      enddo
      return
    endif

-- get the datum pipe name associated with this support (for VT19 renaming)
    !ceref = !!ce
    !datum = '/' + !!mdsmodifyname.name.val + '/DATUM'
    $!datum
      handle none
        PIPE
          handle any
            HVAC
          endhandle
        !pipeName = !!ce.name
        $!ceref
      elsehandle any
      endhandle

-- mjb >>> 22.02.06 flag if lugs (OLETS) are to be created set
    !mdscreatelugsflag = FALSE
-- mjb <<< end of mod

-- Rename All Members of the Copied Support passed in the ARRAY
    -- variable !!mdscopysupp.copynames[!numb]
    !datumref = ARRAY()
    do !count index !!mdscopysupp.copynames[!numb]
      !!ce = !!mdscopysupp.copynames[!numb][!count]
      !!mdsDacControl(true)
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
        -- rename for Vt19 with pipe prefix
      rename all $!pipeName/$!!mdsmodifyname.name.val $!pipeName/$!!mdsmodifyname.newName.val
        handle any
        endhandle
      rename all /DDSE-$!!mdsmodifyname.name.val /DDSE-$!!mdsmodifyname.newName.val
        handle ANY
        endhandle
      rename all /DDAT-$!!mdsmodifyname.name.val /DDAT-$!!mdsmodifyname.newName.val
        handle ANY
        endhandle

      -- NEW Name of Support is !!mdsmodifyname.newName.val
------------------------------------------------------
-- Modify Stex of Atta to Reflect the New Name of The Support
-------------------------------------------------------------
      if (!!ce.type.string().eq('ATTA') and !!ce.name.match('/SREF').eq(0)) then
        if (!!ce.name.match('/DATUM') gt 0) then
          !!mdsTransport(!!ce,!!ce.name.before('/DATUM').string())
        else
          !!mdsTransport(!!ce,!!ce.name.string())
        endif
      endif
      if (!!ce.type.eq('ATTA')) then
-- mjb >>> 22.02.06 mdscreatelugsflag set to TRUE, datum atta ref stored
        -- mjb >>> !!mdsCreateLugs moved to outside of do loop (to correct hierarchy order)
        --!!mdsCreateLugs()
        !mdscreatelugsflag = TRUE
        if (!!ce.name.match('/DATUM') gt 0) then
          !datumref.append(!!ce)
        elseif (!!ce.name.match('/SREF') eq 0) then
-- must be stand alone ancillary or .1 .2 etc
          !datumref.append(!!ce)
        endif
      endif
    enddo

    do !loop values !datumref
      !!ce = !loop
      !!mdsCreateLugs()
    enddo
-- mjb <<< end mod
--------------------------------------------------------------------------------
  elseif (!mode eq 'NAMEONLY') then

    -- Check that gadget !!mdsmodifyname.name.val is not set to 'unset'
    if (!!mdsmodifyname.name.val.lowcase() eq 'unset') then
      !!alert.error(|An Existing Support Name MUST be specified|)
      return
    endif

    -- Check that gadget !!mdsmodifyname.newName.val is not set to 'unset'
    if (!!mdsmodifyname.newName.val.lowcase() eq 'unset') then
      !!alert.error(|The New Name of the Existing Support may NOT be 'unset'. The Support Name is Unchanged.|)
      return
    endif

    -- Navigate to Structure in gadget !!mdsmodifyname.name.val
    !stru = '/' & !!mdsmodifyname.name.val
    !!ce  = !stru.dbref()

-- dtf >>> Check to see if part of a support group
    if (!!ce.name.matchwild('*[*]')) then
      !isPartOfGroup = TRUE
-- If so build a list of hangers with the same name
-- If new name not a group name don't include master stru
      if (!!mdsmodifyname.newName.val.matchwild('*[*]').not()) then
        !count = 2
      else
        !count = 1
      endif
      !rootName = !!ce.name.before('[')
      !orice = !!ce
      do !gindex from !count to 20
        $!rootName[$!gindex]
        handle (2,109)
        elsehandle NONE
-- only add the atta if not already being renamed
          skip if (!!ce eq !stru.dbref())
          !groupMemberList.append(!!ce)
        endhandle
      enddo
      !!ce = !orice

    endif
-- Check to see if Stru has attached hangers
    if (!!ce.type.eq(|STRU|)) then
      if (!!mdsmodifyname.newName.val.matchwild('*[*]').not() and !groupMemberList.size().gt(0) ) then
        !!alert.error(|You Cannot rename a Group Hanger to None Group name, it has Other Group Members.|)
        unenhance all
        return
      endif
    endif
-- dtf <<< End of Mod


    -- NEW Name of Support is !!mdsmodifyname.newName.val
--------------------------------------------------------------------------------
-- Rename Structure and All Below
    !!mdsDacControl(true)
    rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
    !rstru = !!ce

    --<kp>feb07 If lighting support then edit rules and other non-reference atts that can hold the old name
    if (!!ce.type.eq('STRU').and(!!mdslsuppdefs.error.unset())) then
      if (!!ce.:mdssupptype.eq(!!mdslsuppdefs.type)) then
        !lsuppObj = object MDSLSUPPORT(!!ce)
        !lsuppObj.postrename('/$!!mdsmodifyname.name.val')
       endif
    endif
--<kp>feb07

-- rename all trunnion branches for VT19
-->>>-<sjr>jan2003
-- Check if support is a VT19 with four trunnion guide branches
    !saveRef = !!ce
    if (!!ce.:mdssupptype.eq('VT19')) then
-- rename the guide trunnion branches
      !!ce = $!<stru>/DATUM
        handle any
        elsehandle none
          PIPE
          !pName = !!ce.name
          do !ii from 1 to 4
          !oldName = !pName + '/' + !!mdsmodifyname.name.val    + '/' + !ii.string()
          !newName = !pName + '/' + !!mdsmodifyname.newName.val + '/' + !ii.string()
            !!ce = $!oldName
          enddo
        endhandle
    endif
    $!saveRef

-- Get all Attas associated with this support
    !getElementObject = object MDSGETSUPPORTELEMENTS(!currentName)
    !data = !getElementObject.getSupportElements(FALSE, 'ATTA,REDU,PLAT,OLET', 'STRING')

    !!mdsDacControl(true)
-- Rename All Associated Attas
    do !count index !data

      !currentData = !data[!count].dbref()
      if (not((!currentData.name.matchwild(|$!<stru>/*|)) or (!currentData.name.matchwild(|$!<stru>.*|)))) then
        skip
      else
        $!currentData
      endif

      !!mdsDacControl(true)
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val

      -- NEW Name of Support is !!mdsmodifyname.newName.val
-- Modify Stex of Atta if it is already set
--     if (!!ce.type.string().eq('ATTA') and !!ce.name.match('/SREF').eq(0)) then
      if (!!ce.type.string().eq('ATTA')) then
        if (!!ce.name.match('/DATUM') gt 0) then
          !!mdsTransport(!!ce,!!ce.name.before('/DATUM').string())
-- Fix for HPD0026233 GE 04/05/06 SREF -  stext still reflects old support number.
        elseif (!!ce.name.match('/SREF') gt 0) then
          if (!!ce.:MDSSuppType.matchwild('*TT*')) then
            !!mdsTransport(!!ce,!!ce.name.before('/SREF').string())
          endif
        else
          !!mdsTransport(!!ce,!!ce.name.string())
        endif
      endif
    enddo

    !!mdsDacControl(true)

-- ReName the BRANCH if a TRUNNION 'Dummy Leg' Support
    if (defined(!data[1])) then
      !data1 = !data[1].dbref()
      if (!data1.type.eq('ATTA')) then
        if (!data1.owner.:mdstrun) then
          !!ce  = !data1.owner
        !bnam = !!ce.name
        !newn = !bnam.replace('/$!!mdsmodifyname.name.val', '/$!!mdsmodifyname.newName.val')
        name $!newn
      endif
    endif
    endif

-- Rename all associated joints
    /$!!mdsmodifyname.name.val-V1/J1
      handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      elsehandle any
      endhandle
    /$!!mdsmodifyname.name.val-V2/J2
      handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      elsehandle any
      endhandle
    /$!!mdsmodifyname.name.val-BAR-1/J1
      handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      elsehandle any
      endhandle

    -- Rename all associated hangers/fittings
    /$!!mdsmodifyname.name.val/REST
      handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      elsehandle any
      endhandle
    /$!!mdsmodifyname.name.val/FITT/H1
      handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      handle (2,25)
        --dun1218 the fitting is in a readonly db so we need to write out a rename macro
        !fitt = object MDSINTERFACEVIRTUALFITTING()
        !completed = !fitt.renameMacro(!!mdsmodifyname.name.val, !!mdsmodifyname.newName.val)
      endhandle
    elsehandle (2,109)
      if (!sctnHanger) then
        --dun1218 the fitting is in a readonly db so we need to write out a rename macro
        !fitt = object MDSINTERFACEVIRTUALFITTING()
        !completed = !fitt.renameMacro(!!mdsmodifyname.name.val, !!mdsmodifyname.newName.val)
      endif
    elsehandle ANY
    endhandle
    /$!!mdsmodifyname.name.val/FITT/H2
    handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      handle (2,25)
        --dun1218 do nothing as this is handled during the FITT/H1 macro
      endhandle
    elsehandle any
    endhandle
    /$!!mdsmodifyname.name.val/CMPF
    handle none
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      handle (2,25)
        --dun1218 the fitting is in a readonly db so we need to write out a rename macro
        !cmpf = object MDSINTERFACEVIRTUALCMPF()
        !completed = !cmpf.renameMacro(!!mdsmodifyname.name.val, !!mdsmodifyname.newName.val)
      endhandle
    elsehandle (2,109)
      if (!civilHanger) then
        --dun1218 the fitting is in a readonly db so we need to write out a rename macro
        !cmpf = object MDSINTERFACEVIRTUALCMPF()
        !completed = !cmpf.renameMacro(!!mdsmodifyname.name.val, !!mdsmodifyname.newName.val)
      endif
      elsehandle any
      endhandle

-- Rename all associated lugs if they exist
    !!mdsDacControl(true)

    do !renameLugs index !data
      !!ce = !data[$!renameLugs].dbref()
      if (!!ce.stype inset ('ST19','ST21','ST22','ST23')) then
-- Delete associated lugs
        !nameOfMem = !!ce.name
        !oldName = !nameOfMem.replace('$!!mdsmodifyname.newName.val','$!!mdsmodifyname.name.val')
        $!oldName/LUG1
            handle NONE
          rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
        elsehandle ANY
        endhandle
        $!oldName/LUG2
        handle NONE
          rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
        elsehandle ANY
        endhandle
        $!oldName/LUG3
        handle NONE
          rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
        elsehandle ANY
        endhandle
        $!oldName/LUG4
        handle NONE
          rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
            elsehandle ANY
            endhandle
        endif
    enddo

-- Navigate to Renamed Structure
    !!ce  = !rstru

    if (!!ce.type.eq('ATTA') and !!ce.stex.set()) then
      !!mdsTransport(!!ce,!!ce.name.string())
    elseif (!!ce.type.eq('STRU')) then
-- Rename all the weld datasets
      rename all /DDSE-$!!mdsmodifyname.name.val /DDSE-$!!mdsmodifyname.newName.val
        handle ANY
        endhandle
      rename all /DDAT-$!!mdsmodifyname.name.val /DDAT-$!!mdsmodifyname.newName.val
        handle ANY
        endhandle
    endif

-- Unenhance Support
    unenhance all

--------------------------------------------------------------------------------

-- If the support is a manufacturers support we need to rename the support in the manufacturers software
    !!ce = /$!!mdsmodifyname.newName.val
    if (!!ce.type.eq('ATTA') and !!ce.styp.eq('MH01')) then
      if  (!!mdsHangIf.upcase().eq('LISEGA')) then
        if (defined(!!mANIF.exe)) then
          if (!!mANIF.set()) then
            if (!!mANIF.exe.exists()) then
              !cuproj = current project
              !proj = !cuproj.code()
              !dat = !proj & 'DAT'
              var !evardat evar $!dat
              !!mANIF.dat = object FILE(!evardat)

              var !lisExe evar LICADMDSEXE
              if (!lisExe.upCase().match('LICADV10').gt(0)) then
                SYSCOM |""%LICADMDSEXE%"" /MDS /R:$!!mdsmodifyname.name.val/$!!mdsmodifyname.newName.val /OF:$!!manif.dat/Exitcode |
              else
                SYSCOM |""%LICADMDSEXE%"" /R:$!!mdsmodifyname.name.val/$!!mdsmodifyname.newName.val /PD:$!!manif.dat /OF:$!!manif.dat/Exitcode |
              endif
-- Exitcode = 400   : Parameters not correct
              -- Exitcode = > 500 : An error occurred
-- Exitcode = 500   : Success

              !exitcode = object FILE(!!mANIF.dat & '\Exitcode')
              !code = !exitcode.readfile()

              if (!code[1].eq('1')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with LICAD')
              elseif (!code[1].eq('2')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with LICAD')
              elseif (!code[1].eq('3')) then
                !!alert.warning('Support /$!!mdsmodifyname.name.val could not be found in LICAD')
              elseif (!code[1].eq('0')) then
                -- In order to keep PDMS and LICAD upto date we need to savework
                savework
                handle ANY
                  !!alert.error(!!error.text)
                elsehandle NONE
                  write 'Support $!!mdsmodifyname.name.val renamed to $!!mdsmodifyname.newName.val in LICAD'
                  write 'Savework issued for renamed support $!!mdsmodifyname.newName.val'
                  handle ANY
                  endhandle
                endhandle
              endif
            endif
          endif
        endif
      elseif  (!!mdsHangIf.upcase().eq('PSL')) then
        !!alert.error('Rename for PSL required, mdsmodfyname.pmlfnc')
        golabel /skiprename
        if (defined(!!mANIF.exe)) then
          if (!!mANIF.set()) then
            if (!!mANIF.exe.exists()) then
              !cuproj = current project
              !proj = !cuproj.code()
              !dat = !proj & 'DAT'
              var !evardat evar $!dat
              !!mANIF.dat = object FILE(!evardat)
              SYSCOM |""%LICADMDSEXE%"" /R:$!!mdsmodifyname.name.val/$!!mdsmodifyname.newName.val /PD:$!!manif.dat /OF:$!!manif.dat/Exitcode |

              -- Exitcode = 400   : Parameters not correct
              -- Exitcode = > 500 : An error occurred
              -- Exitcode = 500   : Success

              !exitcode = object FILE(!!mANIF.dat & '\Exitcode')
              !code = !exitcode.readfile()

              if (!code[1].eq('1')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with PSL')
              elseif (!code[1].eq('2')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with PSL')
              elseif (!code[1].eq('3')) then
                !!alert.warning('Support /$!!mdsmodifyname.name.val could not be found in PSL')
              elseif (!code[1].eq('0')) then
                -- In order to keep PDMS and LICAD upto date we need to savework
                savework
                handle ANY
                  !!alert.error(!!error.text)
                elsehandle NONE
                  write 'Support $!!mdsmodifyname.name.val renamed to $!!mdsmodifyname.newName.val in PSL'
                  write 'Savework issued for renamed support $!!mdsmodifyname.newName.val'
                  handle ANY
                  endhandle
                endhandle
              endif
            endif
          endif
        endif
      elseif  (!!mdsHangIf.upcase().eq('CPL')) then
        !!alert.error('Rename for CAP required, mdsmodfyname.pmlfnc')
        golabel /skiprename
        if (defined(!!mANIF.exe)) then
          if (!!mANIF.set()) then
            if (!!mANIF.exe.exists()) then
              !cuproj = current project
              !proj = !cuproj.code()
              !dat = !proj & 'DAT'
              var !evardat evar $!dat
              !!mANIF.dat = object FILE(!evardat)
              SYSCOM |""%LICADMDSEXE%"" /R:$!!mdsmodifyname.name.val/$!!mdsmodifyname.newName.val /PD:$!!manif.dat /OF:$!!manif.dat/Exitcode |

              -- Exitcode = 400   : Parameters not correct
              -- Exitcode = > 500 : An error occurred
              -- Exitcode = 500   : Success

              !exitcode = object FILE(!!mANIF.dat & '\Exitcode')
              !code = !exitcode.readfile()

              if (!code[1].eq('1')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with C&P')
              elseif (!code[1].eq('2')) then
                !!alert.warning('Error in renaming support /$!!mdsmodifyname.name.val with C&P')
              elseif (!code[1].eq('3')) then
                !!alert.warning('Support /$!!mdsmodifyname.name.val could not be found in C&P')
              elseif (!code[1].eq('0')) then
                -- In order to keep PDMS and LICAD upto date we need to savework
                savework
                handle ANY
                  !!alert.error(!!error.text)
                elsehandle NONE
                  write 'Support $!!mdsmodifyname.name.val renamed to $!!mdsmodifyname.newName.val in C&P'
                  write 'Savework issued for renamed support $!!mdsmodifyname.newName.val'
                      handle ANY
                      endhandle
                  endhandle
              endif
            endif
          endif
        endif
      endif
    endif

label /skiprename

    if (!isPartOfGroup and !groupMemberList.size().gt(0)) then
      if (!!ce.type.eq(|STRU|)) then
        !struName = !!mdsmodifyname.newName.val
        -- dtf >>> 8.10.04 Check to see if Support is part of group
        -- If so make call to rename any hanger. Call the standard code to rename
        -- and Licad will be updated accordingly.
        do !hIndex values !groupMemberList
          !newHangerNum = !hIndex.name.after('[').before(']')
          !newName = !struName.replace(|[1]|, |[$!newHangerNum]|)
          !!mdsconvertgroup(|RENAME|, !hIndex , |$!newName|)
        enddo

      elseif (  !!ce.type.eq(|ATTA|) or !!ce.type.eq(|PLAT|)) then
        -- we need to rename any existing attached supports
        !struName = !!mdsmodifyname.name.val.before('[') & '[1]'
        do !hIndex indices !groupMemberList
          if (!groupMemberList[!hIndex].type.eq('STRU')) then
            !struName = !!mdsmodifyname.newName.val.before('[') & '[1]'
            !newName = !struName
            -- When the connecting hangers get renamed we don't need to rename master if rootname not changed
            if (!groupMemberList[!hIndex].namn.neq(!struName)) then
              !!mdsconvertgroup(|RENAME|, !groupMemberList[!hIndex] , |$!newName|)
            endif
          else
            !newHangerNum = (!hIndex + 1 )
            !newName = !struName.replace(|[1]|, |[$!newHangerNum]|)
            --!!mdsconvertgroup(|RENAME|, !groupMemberList[!hIndex] , |$!newName|)
          endif
        enddo

      endif
    endif

---------------------------------------------------------------------------------------------------
--<wd>jun2007<mds12>
-- ONLY MDS STRUCTURE Supporttypes may have "Cross Reference" Associations (ASSOCs) and an owning Association Group (ASSOGP)
-- <1> Typical ASSOGP name is /PS07600-FT09-MDS-ASSOGP
-- <2> Typical ASSOC names are /PS07600-FT09-MDS-ASSOC-CROSS-REF-1, /PS07600-FT09-MDS-ASSOC-CROSS-REF-2 etc...
--
    !!mdsDacControl(TRUE)
-- Navigate to ASSOGP for the MDS Structure and Rename ALL
    !xassogpname = '/' & !!mdsmodifyname.name.val & '-MDS-ASSOGP'
    !!ce  = !xassogpname.dbref()
    handle NONE
-- Rename the ASSOGP and all of the ASSOC elements
      rename all /$!!mdsmodifyname.name.val  /$!!mdsmodifyname.newName.val
      handle ANY
-- Unable to rename the ASSOGP and the ASSOC elements
        !!alert.error('ERROR: Unable to rename the Association Group and/or its Associations
        $!!error.text')
      endhandle
    elsehandle ANY
-- The current MDS STRUCTURE Support does NOT have any Associations - So DO NOTHING!!!
    endhandle
--<wd>jun2007<mds12>
---------------------------------------------------------------------------------------------------

-- Navigate to Renamed Structure/Support
    !!ce  = !rstru

  endif

  !!mdsDacControl(false)

endfunction
