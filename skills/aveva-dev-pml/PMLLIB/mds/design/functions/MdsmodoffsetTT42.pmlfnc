--
--   File: MdsmodoffsetTT42.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Wed Oct 29
--
--
-- Description:
-- function to modify TT42 branch offset.  Dun979 MDS12 addition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Key from dataset
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsmodoffsetTT42(!form is FORM, !dummykey is STRING,!gadget is GADGET)

  --Switch the value of the input
  !input = !gadget.val * -1

  -- Get the current units

  !currentUnits = !!kgetSetUnits()

  !delete = false
  if undefined(!!noOffsetMessage) then
    !!noOffsetMessage = true
    !delete = true
  endif

  !!mdsDacControl(true)

  -- Initialise Variables

  !support = !form.support

  -- Goto the datum and climb to branch

  !!ce = !support.datum
  branch

  -- Find the makeup piece

  !mem = mem count
  do !findMakeUp from 1 to $!mem
    branch
    $!findMakeUp
    if !!ce.styp.eq('MAKEUP') or !!ce.styp.eq('MAKEUPOFF') then
      break
    endif
  enddo

  !makeup = !!ce

  -- We are at the makeup piece so check to see if the value is more than the maximum allowed
  -- Main OD - Branch od / 2

  bran
  !hod = ph od
  !tod = pt od
  !maxOffset = ((!hod - !tod) / 2)
  !unusednegMaxOffset = !maxOffset * -1

  !unusedatMax = false
  !unusedatMin = false
$(
  if !input.gt(!maxOffset) then
    !soffset = !input.string(!!distancefmt)
    !moffset = !maxOffset.string(!!distancefmt)
    if !!noOffsetMessage then
      !!alert.error(|Offset stated of $!soffset exceeds the maximum offset of $!moffset$n. setting offset to maximum|)
    endif
    !input = !maxOffset
    !atMax = true
  endif

  if !input.lt(!negMaxOffset) then
    !soffset = !input.string(!!distancefmt)
    !moffset = !negMaxOffset.string(!!distancefmt)
    if !!noOffsetMessage then
      !!alert.error(|Offset stated of $!soffset exceeds the minimum offset of $!moffset$n. setting offset to minimum|)
    endif
    !input = !negMaxOffset
    !atMin = true
  endif
$)
  same
  !posInput = !input.abs()
  despar n3 $!posInput
  !!mdsTT42.poffset.val = $!posInput

  -- We need to change the makeup length to take into account of the offset

  !unusedcurrentMakeup = despar 2

  -- Work out the adjustment needed for the exact length to be added to the iso

  bran
  !saveBran = !!ce
  goto href

  var !radius const dist p0 to p1
  var !od pa od
  !hyp = !radius.real() + (!od.real() / 2)
  !side1 = !radius.real() + (!tod / 2) + !input


  if !!ce.type.eq('REDU') then
    !rb1 = pod 1
    !rb2 = pod 2
    !od.delete()
    handle ANY
    endhandle
    if !rb1.gt(!rb2) then
      !od = !rb2
    else
      !od = !rb1
    endif
    !hyp = (!od / 2)
    !side1 = (!tod / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  elseif !!ce.type.eq('CROS') then
    !hyp = (!od.real() / 2)
    !side1 = (!tod / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

  else
    !!ce = !makeup
    if !!ce.abor.eq(!!ce.lbor) then
      -- Offset will be 0 if there is not a offset set
      if !!mdsTT42.poffset.val.eq(0) then
        !offset = 0
      else
        !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
        handle ANY
          !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
          handle NONE
          endhandle
        endhandle
      endif
    else
      !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
      handle ANY
        !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
        handle NONE
        endhandle
      endhandle
    endif
  endif
  !!ce = !makeup
  despar n2 $!offset

  !!ce = !saveBran
  !mem = mem count
  do !reset from 1 to $!mem
    $!reset
    thro ce
    bran
  enddo

  !!mdsDacControl(true)
  --<dw>mar2009 dun1119 Reconnect not required a next component already positioned within MdsresetdummyTT42
$(
  !!ce = !makeup
  nex conn
  handle (7,3)
    fconn
  endhandle
$)
  bran
  conn pt to last mem
  tcon CLOS

  -- Despar 4 stores the branch offset so reset it

  $!form.support.datum.name$n/SREF
  despar n4 $!posInput

  bran

  !!mdsDacControl(false)

  if !delete then
    !!noOffsetMessage.delete()
  endif

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

  return

endfunction
