--
-- File:		Mdsmodoffsettt36.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to modify a dummy branch offset
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Key from dataset
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsmodoffsettt36(!Form is FORM, !Key is STRING,!Gadget is GADGET)

--Switch the value of the input
  !Input = !Gadget.val * -1

-- Get the current units

  !CurrentUnits = !!KGetSetUnits()

  !delete = false
  if undefined(!!NoOffsetMessage) then
    !!NoOffsetMessage = true
    !delete = true
  endif

  !!MdsDacControl(true)

-- Initialise Variables

  !Support = !Form.support

-- Goto the datum and climb to branch

  !!CE = !Support.Datum
  branch

-- Find the makeup piece

  !mem = mem count
  do !FindMakeUp from 1 to $!Mem
    branch
    $!FindMakeUp
    if !!CE.styp.eq('MAKEUP') or !!CE.styp.eq('MAKEUPOFF') then
      break
    endif
  enddo

  !Makeup = !!CE

-- We are at the makeup piece so check to see if the value is more than the maximum allowed
-- Main OD - Branch od / 2

  bran
  !Hod = ph od
  !Tod = pt od
  !MaxOffset = ((!Hod - !Tod) / 2)
  !NegMaxOffset = !MaxOffset * -1

  !AtMax = false
  !AtMin = false
$(
  if !Input.gt(!MaxOffset) then
    !SOffset = !Input.string(!!distancefmt)
    !MOffset = !MaxOffset.string(!!distancefmt)
    if !!NoOffsetMessage then
      !!Alert.Error(|Offset stated of $!SOffset exceeds the maximum offset of $!MOffset$n. Setting offset to maximum|)
    endif
    !Input = !MaxOffset
    !AtMax = true
  endif

  if !Input.lt(!NegMaxOffset) then
    !SOffset = !Input.string(!!distancefmt)
    !MOffset = !NegMaxOffset.string(!!distancefmt)
    if !!NoOffsetMessage then
      !!Alert.Error(|Offset stated of $!SOffset exceeds the minimum offset of $!MOffset$n. Setting offset to minimum|)
    endif
    !Input = !NegMaxOffset
    !AtMin = true
  endif
$)
  same
  !PosInput = !Input.abs()
  despar n3 $!PosInput
  !!MdsTT36.poffset.val = $!PosInput

-- We need to change the makeup length to take into account of the offset

  !CurrentMakeup = despar 2

-- Work out the adjustment needed for the exact length to be added to the iso

  bran
  !SaveBran = !!CE
  goto href

  var !radius const dist p0 to p1
  var !od pa od
  !Hyp = !radius.real() + (!od.real() / 2)
  !Side1 = !radius.real() + (!tod / 2) + !Input


  if !!ce.type.eq('REDU') then
    !Rb1 = pod 1
    !Rb2 = pod 2
    !od.delete()
      handle ANY
      endhandle
    if !Rb1.gt(!Rb2) then
      !od = !Rb2
    else
      !od = !Rb1
    endif
    !Hyp = (!od / 2)
    !Side1 = (!tod / 2)
    !Offset = (sqrt ((!Hyp * !Hyp) - (!Side1 * !Side1)))
  elseif !!ce.type.eq('CROS') then
    !Hyp = (!od.real() / 2)
    !Side1 = (!tod / 2)
    !Offset = (sqrt ((!Hyp * !Hyp) - (!Side1 * !Side1)))

  else
    !!ce = !makeup
    if !!ce.abor.eq(!!ce.lbor) then
-- Offset will be 0 if there is not a offset set
      if !!MdsTT36.poffset.val.eq(0) then
        !Offset = 0
      else
      !Offset = (sqrt ((!Hyp * !Hyp) - (!Side1 * !Side1)))
        handle ANY
          !Offset = (sqrt ((!Side1 * !Side1) - (!Hyp * !Hyp)))
            handle NONE
            endhandle
        endhandle
      endif
    else
      !Offset = (sqrt ((!Hyp * !Hyp) - (!Side1 * !Side1)))
        handle ANY
          !Offset = (sqrt ((!Side1 * !Side1) - (!Hyp * !Hyp)))
            handle NONE
            endhandle
        endhandle
    endif
  endif
!!ce = !makeup
   despar n2 $!offset

  !!CE = !SaveBran
  !mem = mem count
  do !Reset from 1 to $!mem
    $!reset
    thro ce
    bran
  enddo

  !!MdsDacControl(true)

  !!ce = !makeup
  nex conn
    handle (7,3)
      fconn
    endhandle

  bran
  conn pt to last mem
  tcon CLOS

-- Despar 4 stores the branch offset so reset it

  $!Form.Support.datum.Name$n/SREF
  despar n4 $!PosInput

  bran

  !!MdsDacControl(false)

  if !Delete then
    !!NoOffsetMessage.delete()
  endif

-- Reset units back
   !!kRestoreUnits(!currentunits)

return

endfunction
