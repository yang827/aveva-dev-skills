--
-- File:  Mdsmodplate.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Wed Oct 29
--
--
-- Description:
-- function to modify a pipe shoe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Key from dataset
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsmodplate(!form is FORM, !key is STRING,!gadget is GADGET)

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = !form.member.rtext[$!form.member.val]
  !atta = $!name
  !!ce = !atta
  !dpnum = !!mdsGetDesp('$!key')

  -- Check min/man values are not exceeded
  !styp = styp
  !bore = pa bore
  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --!min = !!mdspar$!styp[$!bore].userdps[$!dpnum].min
  --!max = !!mdspar$!styp[$!bore].userdps[$!dpnum].max
  --
  -- Check and Determine the PLATE MINIMUM and MAXIMUM Sizes for the Passed "DKEY" -- USERDP DEFAULTS DATA
  !mdsplatobj  = object MDSREADPARSDATA()
  !mdsplatdata = !mdsplatobj.mdsdefsdata(!styp, !bore.real().value())

  -- Check if the PLATE type and bore is ACTIVE for the current PDMS Project
  if (!mdsplatdata.not()) then
    -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
    if (!mdsplatobj.mdsstd.sactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
      !errormessage = !mdsplatobj.mdsstd.smess
    elseif (!mdsplatobj.mdsstd.cactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
      !errormessage = !mdsplatobj.mdsstd.cmess
    endif

    -- Advise USER and EXIT Trunnion Support Modification
    !!alert.error(!errormessage)
    unenhance all
    !!kRestoreUnits(!currentUnits)
    return

  else
    -- Set the PLATE MINIMUM and MAXIMUM Sizes for the Passed "DKEY"
    !min = !mdsplatobj.userdps[$!dpnum].min
    !max = !mdsplatobj.userdps[$!dpnum].max

  endif
  --<wd>apr2
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------

  if !gadget.val lt !min then
    !!kFormatText.text.val = !min
    !frmhei = !gadget.val.string(!!distancefmt)
    !minhei = !min.string(!!distancefmt)
    !!alert.error(|Value entered ($!frmhei) is less than the minimum allowed. Setting value to minimum of $!minhei|)
    !gadget.val = !min
  endif

  if !gadget.val gt !max then
    !!kFormatText.text.val = !max
    !frmhei = !gadget.val.string(!!distancefmt)
    !maxhei = !max.string(!!distancefmt)
    !!alert.error(|Height entered ($!frmhei) is greater than the maximum allowed. Setting value to maximum of $!maxhei|)
    !gadget.val = !max
  endif

  !!mdsDacControl(true)
  despar n$!dpnum $!gadget.val

  if !styp.eq('AC20').not() then
    !p3dir = p3 dir wrt world
    handle ANY
    elsehandle NONE
      conn to pt
      handle any
        conn to next
      endhandle
      ori and p3 is $!p3dir
    endhandle
  endif

  -- If the dkey is PTHK, then it is possible the branch will need to be reconnected therefore
  -- call the set height function
  if !key.eq('PTHK') and !styp.neq('AC25') and !styp.neq('AC50') and !styp.neq('AC51') and !styp.neq('AC52') and !styp.neq('AC32') then
    call !!mdsSetTrunLen('GADGET',!form.tlength.val.real(),!form.support.datum,'D WRT /*',!form.support.type,!form)
  elseif !key.eq('PTHK') and (!styp.eq('AC50') or !styp.eq('AC51')) then
    if !styp.eq('AC51') then
      next
      !!ce.despar[5] = despar[3] of prev
    endif
    call !!mdsSetTrunLen('GADGET',!form.tlength.val.real(),!form.support.datum,!form.support.datum.owner.hdir.wrt(/* ).string(),!form.support.type,!form)
  elseif !styp.eq('AC52') then
    -- maintain the plate offset which is defined by the thickness of the previous plate
    !!ce.despar[5] = despar[3] of prev
  endif

  !!mdsDacControl(true)
  if !styp.eq('AC25') then
    prev
    conn to next
  endif

  -- If its a AC18 and has a guideref then we need to modify the guide ref
  if !!ce.styp.matchwild('AC18*') and !key.eq('PWID') then
    !newDpNum = !!mdsGetDesp('PWID')
    !after = !gadget.val
    if !!ce.:Mdsguideref.badref().not() then
      goto :mdsguideref
      if !!ce.styp.eq('GT11') then
        !desPars = despar
        despar n$!newDpNum $!after
      elseif (!!ce.styp inset ('GT12A','GT12B')) then
        !newDpNum = !!mdsGetDesp('BPWD')
        !desPars = despar
        despar n2 $!after
      elseif (!!ce.styp inset ('ST07')) then
        !desPars = despar
        despar n1 $!after
      elseif (!!ce.styp inset ('ST08')) then
        !desPars = despar
        despar n3 $!after
      elseif (!!ce.styp inset ('AN05')) then
        !desPars = despar
        despar n3 $!after
      endif
    endif
  endif

  if !!ce.styp.matchwild('AC18*') and !key.eq('PLEN') then
    !newDpNum = !!mdsGetDesp('PLEN')
    !after = !gadget.val
    if !!ce.:Mdsguideref.badref().not() then
      goto :mdsguideref
      if (!!ce.styp inset ('ST07')) then
        !desPars = despar
        despar n2 $!after
      elseif (!!ce.styp inset ('AN05')) then
        !desPars = despar
        despar n4 $!after
      endif
    endif
  endif

  !!mdsDacControl(false)
  -- Reset units back
  !!kRestoreUnits(!currentUnits)

  return

endfunction
