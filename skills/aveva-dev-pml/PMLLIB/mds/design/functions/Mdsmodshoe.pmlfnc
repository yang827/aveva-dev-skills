--
--------------------------------------------------------------------------------
--
-- File: Mdsmodshoe.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.Morris
-- Created: Wed Oct 29
--
--
-- Description:
-- function to modify a pipe shoe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Qualifier 'HEIGHT' 'LENGTH' 'THICKNESS' 'STEEL'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsModShoe(!form is FORM, !type is STRING,!atta is DBREF)

  !currentunits = !!kgetsetunits()
  -- Initialise Variables

  !unusedsupport = !form.support
  !passedtype = !type
  !suppType = !form.support.type
  !alias = !form.support.alias
  !!ce = !atta

  -- Test for the existence of the height/length gedget and if not set to the
  -- !!mdseditprop for members

  !unusedtestForHeight = !form.height.val
  handle NONE
    !heightgadget = !form.height
  elsehandle ANY
    !heightgadget = !!mdseditprop.heightgadget
  endhandle

  !unusedtestForLength = !form.length.val
  handle NONE
    !lengthgadget = !form.length
  elsehandle ANY
    !lengthgadget = !!mdseditprop.lengthgadget
  endhandle

  --  Data Required for the Selected Atta
  !p9dir = p9dir wrt /*
  --<wd>feb2004
  if (!atta.stype inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST08','AN05',$
    'AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C',$
    'AT34D','AT34E','AT34F','AT35','AT59','AT68','AT100A','AT100B','AT101A','AT101B')) then
    -- Vertical Pipes Only - MDS Supports attached to the Bottom of Trunnion Base Plates etc...
    !halfp = 0
  else
    -- Vertical and Horizontal Pipes - MDS Supports attached to the Pipe Outside Diameter
    !halfp = !!ce.param[2] / 2
  endif
  --<wd>feb2004

  !unusedclear = !!mdsoptions.clear.val.real()

  --<wd>feb2004
  -- Let the MDS Ancillary take care of its Dimensions via its DESPAR Values and its Min & Max Limits etc...
  -- The !unusedclear variable has NOW been OMITTED from the !tol value as it was 'sometimes' returning INCORRECT 'errors'!!
  --   !tol   = !halfp + !unusedclear
  !tol = !halfp
  --<wd>feb2004

  -- If the standard has the height controlled via the insulation then save the insulation thickness to put back after
  !insuDpNum = !!mdsgetdesp('INSU')
  var !insuval insu

  label /tryagin

  ----------------------------------------------------------------
  ----------------------------------------------------------------
  if (!passedtype eq 'STEEL') then
    prompt off
    prompt load escape 'Identify steelwork to support shoe from'
    --<wd>10jan2008 -- Defect No. P-4407
    --      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE @
    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE HSTIFF HPLATE @
    --<wd>10jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on
    !unusedsteel = !!ce.name
    !id    = !!ce
    !stypOfAtta = !!mdsGetStyp(!atta)
    if !stypOfAtta.eq('GT01') or !stypOfAtta.eq('GT06') or !stypOfAtta.eq('GT07') or !stypOfAtta.eq('GT08') or !stypOfAtta.eq('GT18') or !stypOfAtta.eq('GT19') then
      !ppoint = 'P50'
    elseif !stypOfAtta.eq('GT02') or !stypOfAtta.eq('GT03') then
      !!alert.error('Unable to reset the height of the current guide type')
      !!kRestoreUnits(!currentunits)
      return
      ---
    elseif !stypOfAtta.eq('ST14') and !!ce.type EQ 'BOX' then

      !box = !!ce
      $!atta
      prev plat
      handle ANY
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
      !plat = !!ce
      bran
      goto href
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !boxWidth = !!kStrReal('const dist pin 2 to pin 3')
      $!atta
      despar n6 $!boxWidth
      !unusedwidth = !!kStrReal('const dist pin 2 to pin 3')
      var !dir const dir pin 2 to pin 3
      !!mdsresetpins(2,5)
      !zdir = !dir.direction()
      if !zdir.isParallel(!plat.pdir[10])  then
        !pwid = !plat.prop.pwid
        !plen = !plat.prop.plen
      else
        !pwid = !plat.prop.plen
        !plen = !plat.prop.pwid
      endif
      -- Orientate stop
      conn and p30 is $!dir
      handle ANY
      endhandle
      ---
    else
      !ppoint = 'P12'
    endif

    pin 9 copy $!ppoint of $!atta
    handle ANY
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle

    if !stypOfAtta.neq('ST14') then
      -- Test if Steel is in the Correct Orientation/Location for the Selected Atta
      !testce = !!mdsreltodatum(!atta, !id, !p9dir, !tol)
      if (!testce[1].lowcase().neq('below')) then
        !!alert.error('Identified element is unsuitable to support from.')
        !!kRestoreUnits(!currentunits)
        golabel /tryagin
      endif
    endif

    -- Get and Set Beam Width for Anchor Type AN10 when Setting Height to STEEL
    !xce = !!ce
    !!ce = !atta
    !xstyp = !!ce.styp
    if (!xstyp inset ('AN10')) then
      !!ce = !xce
      --<wd>17jan2008 -- Defect No. P-4407
      --        if !!ce.type EQ 'SCTN' then
      if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
        --<wd>17jan2008 -- Defect No. P-4407
        if (!!ce.gtype inset ('BEAM','TEE','DINI','DINT','BOX')) then
          -- this bit is not valid for an angle because it does not have a property widt
          -- and does not seem to be used anywhere anyhow ???
          !beamwidth = (prop WIDT)
        else
          !!ce = !atta
          pin 8 copy pl
          pin 9 copy pl
          pin 8 plane pin 8 clear 0 inf same
          pin 9 plane pin 9 clear 0 beh same
          var !beamwidth const dist pin 8 to pin 9
          !!mdsresetpins(8,9)
          var !prop coll all data with dkey eq 'WID' for dtre
          var !num1 eval num for all from !prop
          despar n$!num1[1] $!beamwidth
        endif
      endif

      if !!ce.type EQ 'BOX' then
        !box = !!ce
        same
        pin 2 copy pl
        pin 3 copy pl
        pin 2 plane pin 2 clear 0 infront $!box
        pin 3 plane pin 3 clear 0 behind $!box
        !beamwidth = !!kStrReal('const dist pin 2 to pin 3')
        var !ccprop coll all data with dkey eq 'WID' for dtre
        var !num1 eval num for all from !ccprop
        despar n$!num1[1] $!beamwidth
        !!mdsresetpins(2,3)
      endif
    endif

    !!ce = !xce
    -- Reset Pin 9 position, because 'Mdsreltodatum' function moves it./
    pin 9 copy $!ppoint of $!atta
    !passedtype = 'HEIGHT'

    --<wd>nov2000
    -- Set Stop Shoe Height to Steelwork Section
    if (!alias inset ('ST01','ST02')) then
      -------------------------------------------------------------------------------
      --<wd>may2006<mds12> -- Always Copy Position and Direction of PPOINTP9 of $!atta
      -- MDS ATTAS and most MDS FRAMEWORKS can now be ROTATED thro 360 deg.
      --
      --pin 9 at $!atta
      --pin 9 dir d wrt /*
      pin 9 copy p9 of $!atta
      --
      --<wd>may2006<mds12>
      -------------------------------------------------------------------------------

      !halfpipe = !atta.param[2] / 2
      pin 9 dist $!halfpipe
    endif
    --<wd>nov2000

    pin 8 copy pin 9
    -------------------------------------------------------------------------------
    --<wd>may2006<mds12> -- Always Copy Position and Direction of pin 9 set above
    -- MDS ATTAS and most MDS FRAMEWORKS can now be ROTATED now thro 360 deg.
    -- Therefore this ***CHECK*** is now ***OBSOLETE*** and ***NO longer REQUIRED***
    --
    --if !atta.:mdsrotated then
    --  pin 8 dir p9 of $!atta
    --else
    --  pin 8 dir d wrt /*
    --endif
    --
    --<wd>may2006<mds12> -- Always Copy Position and Direction P9 of $!atta
    -------------------------------------------------------------------------------

    pin 8 plane pin 8 clear 0 inf CE
    !dist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')

    --$P *** TEMPORARY return  by <wd>19may2006 *** at line 238 of mdsmodshoe.pmlfnc ***
    --return

    --<wd>jun2001
    -- Variables !pin8u and !p9  are now read from the UPPINGS of position objects,
    -- because the syntax commented out below is NOT working at PDMS11.3
    -- Is pin 8 above p9, if it is the steel is above the shoe
    var !pin8pos pin 8 pos wrt /*
    !pin8posobj = !pin8pos.position()
    !pin8u = !pin8posobj.up
    !!ce = !atta
    !p12pos = $!ppoint pos wrt /*
    !p9 = !p12pos.up
    same
    !!mdsresetpins(8,9)

    -- need to know whether there is a slip unit or not
    if(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.catref.owner.:Mdstype.eq('SLIP')) then
      !slipDist = !!kStrReal('Const dist $!ppoint of $!atta.:MDSGuideRef to p13 of $!atta.:MDSGuideRef')
    elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.:MDSSuppType inset('SP01')) then
      !slipDist = !atta.:MDSGuideRef.despar[1]
    else
      !slipDist = 0
    endif
    !dist = (!dist - !slipDist)

    -- if (lter!suppType inset('AT10A','AT11A','AN01A')) then
    -- !!ce = !atta
    -- !dp2 = DESP[2]
    -- !distance = !dist - !dp2
    -- !dist = !distance
    -- same
    -- endif
    ----------------------------------------------------------------
    --> Modified - <wd> - may2000
    ----------------------------------------------------------------
    -- This Code has been added to accommodate the changes
    -- in how the 'format object' deals with IMPERIAL units at PDMS11.2
    -- i.e. The text gadget values are now stored as INCHES instead of
    -- storing all values in MM as at PDMS11.1 when in IMPERIAL units.
    --var !units '!!kRestoreUnits(!currentunits)'
    if (!!isImperialLength('BORE')) then
      -- if (!units.upcase().after('BORE ').match('MM').gt(0).not()) then
      !!ce = !atta
      !bore = pa bore
      ------------------------------------------------------------------------------------------------
      --mjb >>> 15.03.06 <mds12>
      if (!suppType.unset()) then
        !suppType = !!ce.styp
        --!parvar = '!!mdspar' + !suppType
      else
        --!parvar = '!!mdspar' + !suppType
      endif

      !realbore = !bore.real().value()
      !mdsattaobj  = object MDSREADPARSDATA()
      !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)
      --mjb <<< 15.03.06 <mds12> end of mod
      ------------------------------------------------------------------------------------------------

      if (!suppType inset ('AN10')) then
        if (!atta.abor.leq(100)) then
          !option = 'PWID'
        else
          !option = 'FHEI'
        endif
      else
        !option = 'HEI'
      endif

      --!dpnum = !!mdsgetdesp('hei')
      !dpnum = !!mdsgetdesp(!option)
      ------------------------------------------------------------------------------------------------
      --mjb >>> 15.03.06 <mds12>
      --!min = $!parvar[$!bore].userdps[$!dpnum].min
      --!max = $!parvar[$!bore].userdps[$!dpnum].max

      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max
      --mjb <<< 15.03.06 <mds12> end of mod
      ------------------------------------------------------------------------------------------------

      if (!dist ge !min) then
        !dist =  !dist - 0.1/32in
      elseif (!dist le !max) then
        !dist = !dist + 0.1/32in
      endif
    endif


    --<tm bit to set to steel
    if !stypOfAtta.eq('GT15') then
      !heightgadget = !!mdseditprop.prop3
      -- !!mdsgt02.clearance.val = !!mdseditprop.PROP1.val
      -- !!mdsgt02.height.val    = !!mdseditprop.PROP2.val
      !!mdsgt02.length.val    = !dist
    endif
    --<tm bit to set to steel

    ----------------------------------------------------------------
    --< Modified - <wd> - may2000
    ----------------------------------------------------------------

    --<ge 03/04/05> Fix for HPD0028026 allowing the addition of MDS Isolation Pads and Slide Units for Trunnion Base Plates
    -- even if the :mdsguideref is set but not to a MDS Isolation Pads and Slide Units for Trunnion Base Plates
    -- When resetting the ST07 to the plate after the mod of the support due to the addition of AT101A !!mdseditprop fell over
    if !stypOfAtta.eq('ST07') then
      !heightgadget = !!mdseditprop.prop3
    elseif !stypOfAtta.eq('AN10') then
      !heightgadget = !!mdseditprop.prop2
    else
      !heightgadget.val = !dist
    endif

    --q var !heightgadget.val
    --    !heightgadget.val = !dist
    --    handle ANY
    --   endhandle

  endif
  ------------------End of 'STEEL'---------------
  ----------------------------------------------------------------
  ----------------------------------------------------------------

  !!ce = !atta
  !bore = pa bore

  if (!suppType.unset()) then
    !suppType = !!ce.styp
    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    --!parvar = '!!mdspar' + !suppType
  else
    --!parvar = '!!mdspar' + !suppType

  endif

  !realbore = !bore.real().value()
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)
  --mjb <<< 15.03.06 <mds12> end of mod
  ------------------------------------------------------------------------------------------------
  ----------------------------------------------------------------
  --> Modified - <wd> - may2000
  ----------------------------------------------------------------
  -- Set Min/Max Boolean variables
  !minval = false
  !maxval = false

  -------------------------------------------------------------------------------------------------------------------------------
  -->>>-<wd>dec2002
  -- When Atta is a SHOE - Welded to the Pipe <i.e. NOT Clamped> and has a valid Association with a Cradle/Reinforcing Pad
  !xce   = !!ce
  if (!atta.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19')) then
    if (!atta.:mdssref.badref().not()) then
      -- Get & Save the Pad Thickness DESPAR Number and Current Value of the SHOE when it is Associated with a Cradle/Reinforcing Pad
      !!ce    = !atta
      !pdpnum = !!mdsgetdesp('PTHK')
      !pdpval = !atta.desp[!pdpnum]
    endif
  endif
  !!ce = !xce
  --<<<-<wd>dec2002

  -------------------------------------------------------------------------------------------------------------------------------
  -------------------------------------------------------------------------------------------------------------------------------
  -->>>-<wd>feb2003
  -------------------------------------------------------------------------------------------------------------------------------
  -------------------------------------------------------------------------------------------------------------------------------
  -- When Atta is a SHOE - WELDED or CLAMPED to the Pipe and has a valid Association with a 'AT40*','AT41*' 0r 'AT42'
  !xce   = !!ce
  if (!atta.stype inset ('AT01','AT02','AT03','AT04','AT06','AT08','AT12','AT13','AT14','AT15','AT16','AT17','AT18','AT19','AT20','AT25','AT72','AT87','AT73')) then
    if (!atta.:mdsguideref.badref().not()) then
      -- ALL WELDED & CLAMPED SHOES
      -- Get & Save the SHOE HEI - DESPAR Number and Current Value of the SHOE when it is Associated with a 'AT40*' or 'AT41*'
      !!ce    = !atta
      !sdpnum = !!mdsgetdesp('HEI')
      !unusedsdpval = !atta.desp[!sdpnum]
      if (!atta.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19')) then
        -- WELDED SHOES ONLY
        -- Get & Save the SHOE OLAP - DESPAR Number and Current Value of the SHOE when it is Associated with a 'AT40*','AT41*' or 'AT42'
        !xdpnum = !!mdsgetdesp('OLAP')
        !unusedxdpval = !atta.desp[!xdpnum]
      endif
    endif
  endif
  !!ce = !xce
  -------------------------------------------------------------------------------------------------------------------------------
  -------------------------------------------------------------------------------------------------------------------------------
  --<<<-<wd>feb2003
  -------------------------------------------------------------------------------------------------------------------------------
  -------------------------------------------------------------------------------------------------------------------------------

  ----------------------------------------------------------------
  ----------------------------------------------------------------
  if (!passedtype.upcase() eq 'HEIGHT') then

    if (!heightgadget.val.unset()) then
      !heightgadget.val = 0
    endif

    if (!suppType inset ('AN10')) then
      if (!atta.abor.leq(100)) then
        !option = 'WID'
      else
        !option = 'FHEI'
      endif
      --<wd>feb2004
    elseif (!suppType inset ('ST07','GT11','GT15')) then
      !option = 'OFFS'
      --<wd>feb2004
    else
      !option = 'HEI'
    endif
    --!dpnum = !!mdsgetdesp('hei')
    !dpnum = !!mdsgetdesp(!option)

    -- !expr = $!parvar[$!bore].altexpr
    -- !altdespar = $!parvar[$!bore].altdespars
    --$p *** !min = $!parvar[$!bore].userdps[$!dpnum].min

    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    --mjb <<< 15.03.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------

    -- GE 17/08/04 Investigating HPD0025386
    if (!suppType inset ('GT26')) then
      -- Get the overlap and set it
      !over = !heightgadget.val
      !pdpnum = !!mdsgetdesp('HEI')
      !pdpval = !!ce.desp[!pdpnum]
      -- Reset the height Gadget as it is wrong
      !heightgadget.val = !pdpval
    endif
    --  GE 17/08/04

    if (!heightgadget.val.real().nint() lt !min.nint()) then
      !!kformattext.text.val = !min

      !minval = true
      !frmhei = !heightgadget.val.string(!!distancefmt)
      !minhei = !min.string(!!distancefmt)
      !!alert.error(|Height entered ($!frmhei) is less than the minimum allowed. Setting height to minimum of $!minhei|)

      --        !!alert.error(|Height entered ($!heightgadget.val) is less than the minimum allowed. Setting height to minimum of $!!kformattext.text.val|)
      !heightgadget.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min.real())
    endif

    if (!heightgadget.val.real().nint() gt !max.nint()) then
      !!kformattext.text.val = !max

      !maxval = true
      !frmhei = !heightgadget.val.string(!!distancefmt)
      !maxhei = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Height entered ($!frmhei) is greater than the maximum allowed. Setting height to maximum of $!maxhei|)

      --        !!alert.error(|Height entered ($!heightgadget.val) is greater than the maximum allowed. Setting height to maximum of $!!kformattext.text.val|)
      !heightgadget.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max.real())
    endif

    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then

      -- GE 17/08/04 Investigating HPD0025386
      if (!suppType inset ('GT26')) then
        !pdpnum = !!mdsgetdesp('HEI')
        !pdpval = !!ce.desp[!pdpnum]
        !overgadget = !!mdseditprop.prop6
        handle NONE
          !overgadget.val = !over
          -- Reset the height Gadget
          !heightgadget.val = !pdpval
          -- Get the overlap and set it
          !overnum = !!mdsgetdesp('OVER')
          !unusedoverval = !!ce.desp[!overnum]
          !!mdssetdespar(!!ce,!overnum,!overgadget.val.real())
        elsehandle ANY
        endhandle
      endif
      --  GE 17/08/04

      !!mdssetdespar(!!ce,!dpnum,!heightgadget.val.real())
    endif

    -- Get and Set Beam Width for Anchor Type AN10 when Setting Height to STEEL
    if (!suppType inset ('AN10')) then
      var !ccprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccprop
      if defined(!beamwidth) then
        despar n$!num1[1]  $!beamwidth
      endif
      !!mdseditprop.prop3.val = !beamwidth.real()
    endif

    ----------------------------------------------------------------
    ----------------------------------------------------------------

  elseif (!passedtype eq 'LENGTH') then

    !dpnum = !!mdsgetdesp('LEN')
    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max

    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --mjb <<< 15.03.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------
    ----------------------------------------------------------------
    --> Modified - <wd> - may2000
    ----------------------------------------------------------------
    if (!lengthgadget.val.unset()) then
      !lengthgadget.val = 0
    endif

    if (!lengthgadget.val.real().nint() lt !min.nint()) then
      !!kformattext.text.val = !min

      !minval = TRUE
      !frmlen = !lengthgadget.val.string(!!distancefmt)
      !minlen = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Length entered ($!frmlen) is less than the minimum allowed. Setting length to minimum of $!minlen|)

      --        !!alert.error(|Length entered ($!lengthgadget.val) is less than the minimum allowed. Setting length to minimum of $!!kformattext.text.val|)
      !lengthgadget.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min.real())
    endif

    if (!lengthgadget.val.real().nint() gt !max.nint()) then
      !!kformattext.text.val = !max

      !maxval = true
      !frmlen = !lengthgadget.val.string(!!distancefmt)
      !maxlen = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Length entered ($!frmlen) is greater than the maximum allowed. Setting length to maximum of $!maxlen|)

      --        !!alert.error(|Length entered ($!lengthgadget.val) is greater than the maximum allowed. Setting length to maximum of $!!kformattext.text.val|)
      !lengthgadget.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max.real())
    endif

    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!!ce,!dpnum,!lengthgadget.val.real())
    endif
    ----------------------------------------------------------------
    --< Modified - <wd> - may2000
    ----------------------------------------------------------------

    -- <tm> Check if type being modified is AT55A/B/C and modify next
    if !!ce.stype inset('AT55A','AT55B','AT55C') and (!!ce.order + 1) lt !!ce.owner.members.size() then
      -- check to see if the next atta is a type AT53A/B
      !nextstype = stype of next
      if !nextstype inset('AT53A','AT53B')then
        -- modify the length to suit
        next
        !dpnum = !!mdsgetdesp('LEN')
        !!mdssetdespar(!!ce,!dpnum,!lengthgadget.val.real())
        prev
      endif
    endif

    -- If the type is a BR04 then the angle will need resetting

    if !!ce.stype inset('BR04') then
      var !angle const angle p0 to p24 to p25
      !newangle = 90 - !angle.real()
      !newangle.abs()
      despar n4 $!newangle
    endif

  elseif (!passedtype eq 'THICKNESS') then

    !dpnum = !!mdsgetdesp('THK')
    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    !currentDespars = despar
    !beforethk = !currentDespars[$!dpnum]
    --mjb <<< 15.03.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------
    ----------------------------------------------------------------
    --> Modified - <wd> - may2000
    ----------------------------------------------------------------
    if (!form.thickness.val.unset()) then
      !form.thickness.val = 0
    endif

    if (!form.thickness.val.real().nint() lt !min.nint()) then
      !!kformattext.text.val = !min

      !minval = true
      !frmthk = !form.thickness.val.string(!!distancefmt)
      !minthk = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Thickness entered ($!frmthk) is less than the minimum allowed. Setting thickness to minimum of $!minthk|)

      --        !!alert.error(|Thickness entered ($!form.thickness.val) is less than the minimum allowed. Setting thickness to minimum of $!!kformattext.text.val|)
      !form.thickness.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min.real())
    endif

    if (!form.thickness.val.real().nint() gt !max.nint()) then
      !!kformattext.text.val = !max

      !maxval = true
      !frmthk = !form.thickness.val.string(!!distancefmt)
      !maxthk = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Thickness entered ($!frmthk) is greater than the maximum allowed. Setting thickness to maximum of $!maxthk|)

      --        !!alert.error(|Thickness entered ($!form.thickness.val) is greater than the maximum allowed. Setting thickness to maximum of $!!kformattext.text.val|)
      !form.thickness.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max.real())
    endif


    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!!ce,!dpnum,!form.thickness.val.real())
    endif

    --<wd>21jun2004 - Test for AT65 Wrapper Plate etc...
    -- For MDS Standard 'AT65' - Set the DESPAR Num 8 i.e. Property 'ASSY' :-
    -- to either: 'A' for Pipe where DESPAR NUM 9 is ALWAYS set to ZERO '0'
    --        or: 'Bx' for Plate where 'x' is the Plate thickness with same as DESPAR NUM 1
    if (!!ce.prop.desc inset ('AT65')) then
      !mattyp = purpose of spec of mtoref
      if (!mattyp.eq('PIPE')) then
        desp num 8 A
        !!ce.desp[9] = 0
      elseif (!mattyp.eq('PLAT')) then
        desp num 8 B
        !!ce.desp[9] = !!ce.desp[1]
      endif
    endif
    --<wd>21jun2004

    ----------------------------------------------------------------
    --< Modified - <wd> - may2000
    ----------------------------------------------------------------

    -- If the pad has an association with a shoe then adjust the shoe.
    if !!ce.:mdssref.badref().not() and !!ce.:mdscp3.eq('SHOE') then
      !currentDespars = despar
      !afterthk = !currentDespars[$!dpnum]
      !thkchange = !beforethk - !afterthk
      !originalMem = !!ce
      goto :MdsSref

      ------------------------------------------------------------------------------------------------
      --mjb >>> 15.03.06 <mds12>
      !shoeref = !!ce
      !dpnum = !!mdsgetdesp('HEI')
      if !dpnum.neq(0) then
        !currentvalue = prop HEI
        !newvalue = !currentvalue.real() + !thkchange
        !unusedshoestyp = styp
        -- mjb   ***SET OBJECT WITH SHOE VALUES***
        !realbore = !bore.real().value()
        !mdsattaobjshoe  = object MDSREADPARSDATA()
        !mdsattadefs = !mdsattaobjshoe.mdsdefsdata(!shoeref.stype,!realbore)

        !min = !mdsattaobjshoe.userdps[$!dpnum].min
        !max = !mdsattaobjshoe.userdps[$!dpnum].max

        --!shoeparvar = '!!mdspar' + !unusedshoestyp
        --!min = $!shoeparvar[$!bore].userdps[$!dpnum].min
        --!max = $!shoeparvar[$!bore].userdps[$!dpnum].max

        --mjb <<< 15.03.06 <mds12> end of mod
        ------------------------------------------------------------------------------------------------

        if (!newvalue.nint() lt !min.nint()) then
          !newvalue = !min
        endif
        if (!newvalue.nint() gt !max.nint()) then
          !newvalue = !max
        endif
        !!mdssetdespar(!!ce,!dpnum,!newvalue)
        !dpnum = !!mdsgetdesp('PTHK')
        if !dpnum.neq(0) then
          !!mdssetdespar(!!ce,!dpnum,!form.thickness.val.real())
        endif
      endif
      !!ce = !originalMem
    endif

  elseif (!passedtype eq 'ANGLE') then

    !displayText = 'Clamp Angle'
    !dpnum = !!mdsgetdesp('ADEG')
    if !dpnum.eq(0) then
      !dpnum = !!mdsgetdesp('WSIZ')
      !displayText = 'Weld Size'
    endif

    if (!suppType INSET('LT16A','LT16B')) then
      !displayText = 'Clearance'
    endif

    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max

    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --mjb <<< 15.03.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------
    if (!form.angle.val.unset()) then
      !form.angle.val = 0
    endif

    if (!form.angle.val.real() lt !min) then
      !minval = true
      !frmthk = !form.angle.val
      !!alert.error(|$!displayText entered ($!frmthk) is less than the minimum allowed. Setting $!displayText to minimum of $!min|)
      !form.angle.val = !min.string()
      !!mdssetdespar(!!ce,!dpnum,!min.real())
    endif

    if (!form.angle.val.real() gt !max) then
      !maxval = true
      !frmthk = !form.angle.val
      !!alert.error(|$!displayText entered ($!frmthk) is greater than the maximum allowed. Setting $!displayText to maximum of $!max|)
      !form.angle.val = !max.string()
      !!mdssetdespar(!!ce,!dpnum,!max.real())
    endif

    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!!ce,!dpnum,!form.angle.val.real())
    endif

    return

  elseif (!passedtype eq 'RODCL') then

    !dpnum = !!mdsgetdesp('SDIS')

    ------------------------------------------------------------------------------------------------
    --mjb >>> 15.03.06 <mds12>
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    --mjb <<< 15.03.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------

    ----------------------------------------------------------------
    --> Modified - <wd> - may2000
    ----------------------------------------------------------------
    if (!form.rodcl.val.unset()) then
      !form.rodcl.val = 0
    endif

    if (!form.rodcl.val.real().nint() lt !min.nint()) then
      !!kformattext.text.val = !min

      !minval = true
      !frmrod = !form.rodcl.val.string(!!distancefmt)
      !minrod = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Rod Centre Lines entered ($!frmrod) is less than the minimum allowed. Setting Rod Centre Lines to minimum of $!minrod|)

      --        !!alert.error(|Rod Centre Lines entered ($!form.rodcl.val) is less than the minimum allowed. Setting Rod Centre Lines to minimum of $!!kformattext.text.val|)
      !form.rodcl.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min.real())
    endif

    if (!form.rodcl.val.real().nint() gt !max.nint()) then
      !!kformattext.text.val = !max

      !maxval = true
      !frmrod = !form.rodcl.val.string(!!distancefmt)
      !maxrod = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Rod Centre Lines entered ($!frmrod) is greater than the maximum allowed. Setting Rod Centre Lines to maximum of $!maxrod|)

      --        !!alert.error(|Rod Centre Lines entered ($!form.rodcl.val) is greater than the maximum allowed. Setting Rod Centre Lines to maximum of $!!kformattext.text.val|)
      !form.rodcl.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max.real())
    endif

    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!!ce,!dpnum,!form.rodcl.val.real())
    endif
    ----------------------------------------------------------------
    --< Modified - <wd> - may2000
    ----------------------------------------------------------------
  endif

  ----------------------------------------------------------------
  --mjb >>> 15.03.06 <mds12> (mdseditprop.pmlfrm contains similar change)

  --!expr = $!parvar[$!bore].altexpr
  --!altdespar = $!parvar[$!bore].altdespars

  !expr = !mdsattaobj.altexpr
  !altdespar = !mdsattaobj.altdespars

  if !expr.set() then

    --if !expr.match(',').eq(0) then

    --var !test ($!expr)
    --if (!test.boolean()) then
    -- Set The Alternate Despar Expressions
    --do !set values !altdespar
    --!!mdssetdespar(!!ce,!set.dpnum,!set.altval.real())
    --enddo
    --else
    -- Set The Despars here to RESET any Despars Previously set by Alternate Expressions
    --if (!minval) then
    --!!mdssetdespars(!!ce)
    --!!mdssetdespar(!!ce,!dpnum,!min.real())
    --elseif (!maxval) then
    --!!mdssetdespars(!!ce)
    --!!mdssetdespar(!!ce,!dpnum,!max.real())
    --else
    --!!mdssetdespars(!!ce)
    --!!mdssetdespar(!!ce,!dpnum,!heightgadget.val.real())
    --endif
    --endif

    --!dpnum = !!mdsgetdesp('LEN')
    --if (!lengthgadget.val.unset()) then
    --!lengthgadget.val = 0
    --endif
    --!!mdssetdespar(!!ce,!dpnum,!lengthgadget.val.real())

    --!dpnum = !!mdsgetdesp('HEI')
    --if (!heightgadget.val.unset()) then
    --!heightgadget.val = 0
    --endif
    --!!mdssetdespar(!!ce,!dpnum,!heightgadget.val.real())

    --!deslen = despar[!dpnum]
    --!desint = !deslen.nint()
    --desp num $!dpnum $!desint

    --else

    -- !expr = !parvar[$!bore].altexpr
    --!sexpr = !expr.split(',')
    !sexpr = !expr

    !exprcounter = 1

    !alreadySet = ARRAY()

    do !testForExpr values !sexpr
      !saltdespar = !altdespar

      if (!testForExpr.set()) then
        var !test ($!testForExpr)
        if (!test.boolean()) then
          --alt expression true so set alt despars
          --do over all alt despars for each alt expression
          do !xset values !saltdespar[!exprcounter]
            --alt expr TRUE setting alt despars to alt despar values
            --append des par number set to AlreadySet array
            !alreadySet.append(!xset.dpnum)
            --!!mdssetdespar(!!ce,!saltdespar[$!exprcounter][1].dpnum,!saltdespar[$!exprcounter][1].altval.real())
            !!mdssetdespar(!!ce,!xset.dpnum,!xset.altval.real())
            --!!mdssetdespar(!!ce,!saltdespar[$!exprcounter].dpnum,!saltdespar[$!exprcounter].altval.real())
          enddo
        else
          --set despar values from alt despars back to defaults if alt expr not true
          do !xset values !saltdespar[!exprcounter]
            --alt expr not TRUE setting alt despars to defaults if not set previously by an alt despar (so in AlreadySet array)
            if !alreadySet.find(!xset.dpnum).unset() then
              !aRealValue = !mdsattaobj.despars[$!xset.dpnum]
              !brealvalue = $!aRealValue
              !!mdssetdespar(!!ce,!xset.dpnum,!brealvalue)
            endif
          enddo
        endif
      endif
      !exprcounter = !exprcounter + 1
    enddo
    -------------------------------------------------------------------------
    --mjb Why is this section here? Why just LEN and HEI?
    !dpnum = !!mdsgetdesp('LEN')
    if (!lengthgadget.val.unset()) then
      !lengthgadget.val = 0
    endif
    !!mdssetdespar(!!ce,!dpnum,!lengthgadget.val.real())

    !dpnum = !!mdsgetdesp('HEI')
    if (!heightgadget.val.unset()) then
      !heightgadget.val = 0
    endif
    !!mdssetdespar(!!ce,!dpnum,!heightgadget.val.real())

    !deslen = despar[!dpnum]
    !desint = !deslen.nint()
    desp num $!dpnum $!desint
    ---------------------------------------------------------------------------
    --endif

    --mjb <<< 15.03.06 <mds12> end of mod
    ----------------------------------------------------------------

  endif
  ----------------------------------------------------------------
  ----------------------------------------------------------------

  --<dw>Nov2008 Dun1052 - To display change in temp range as a result of change in height
  if !suppType inset ('AT141','AT146','AT147','AT148','AT150') then
    !satta = !!ce
    !heidpnum  = !satta.prop.hei
    if (!heidpnum.real() ge 150) then
      desp n20 -130
    else
      desp n20 -46
    endif
    !mindpnum  = !satta.prop.mint
    !maxdpnum  = !satta.prop.maxt
    !form.notetemp.val    = 'Min. $!mindpnum  Max. $!maxdpnum'
  endif
  --<dw>Nov2008 Dun1052 - End of display change in temp range

  -------------------------------------------------------------------------------------------------------------------------------------------------
  -->>>-<wd>dec2002
  -- When a Shoe is associated to a Cradle/Reinforcing Pad
  if (!atta.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19')) then
    if (!atta.:mdssref.badref().not()) then
      -- Restore the Pad Thickness DESPAR Number and Current Value of the SHOE when it is Associated with a Cradle/Reinforcing Pad
      !!ce  = !atta
      !atta.desp[!pdpnum] = !pdpval
      -- When the SHOE Length has been Modified - The Associated PAD Atta Length is Modified as well within the Permissible Limits
      if (!passedtype.eq('LENGTH')) then
        !aldpnum = !!mdsgetdesp('LEN')
        !aldpval = !atta.desp[!aldpnum]
        !rpad    = !atta.:mdssref
        !!ce     = !rpad
        !rldpnum = !!mdsgetdesp('LEN')
        !unusedrldpval = !rpad.desp[!rldpnum]
        !oldpnum = !!mdsgetdesp('OLAP')
        !oldpval = !rpad.desp[!oldpnum]
        !rnewlen = (!aldpval + (2 * !oldpval))
        --!!mdssetdespar(!rpad,!rldpnum,!rnewlen)

        -- Check if New Length of PAD Atta is No Less than the MINIMUM
        if (!rnewlen.nint().lt(!min.nint())) then
          !!kformattext.text.val = !min
          !frmlen = !!rnewlen.string(!!distancefmt)
          !minlen = !!kformattext.text.val.string(!!distancefmt)
          !!alert.error(|Length entered ($!frmlen) is less than the minimum allowed. Setting length of PAD Atta to minimum of $!minlen|)
          !!mdssetdespar(!rpad,!rldpnum,!min.real())
        endif

        -- Check if New Length of PAD Atta is No More than the MAXIMUM
        if (!rnewlen.nint().gt(!max.nint())) then
          !!kformattext.text.val = !max
          !frmlen = !rnewlen.string(!!distancefmt)
          !maxlen = !!kformattext.text.val.string(!!distancefmt)
          !!alert.error(|Length entered ($!frmlen) is greater than the maximum allowed. Setting length of PAD Atta to maximum of $!maxlen|)
          !!mdssetdespar(!rpad,!rldpnum,!max.real())
        endif

        -- Set The Despar here if value is within the Permissible Min/Max SHOE LENGTH limits
        if  ( (!rnewlen.nint().geq(!min.nint())) and (!rnewlen.nint().leq(!max.nint())) ) then
          !!alert.warning(|SHOE Atta Length has been modified. Setting length of Associated PAD Atta to suit SHOE length|)
          !!mdssetdespar(!rpad,!rldpnum,!rnewlen)
        endif
      endif
    endif
    !!ce = !atta
  endif
  --<<<-<wd>dec2002
  -------------------------------------------------------------------------------------------------------------------------------------------------

  -- When the shoe has a guide attached to it we may have to update the guide
  -- design parameters
  !!mdsResetGuide()

  !!ce = !atta
  -- ditto for slip units
  if(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.catref.owner.:Mdstype.eq('SLIP')) then
    -- Create an array of supports that do not require the slip unit code to be run
    --<bc>Apr2004
    !suppArray = split('AT40 AT40B AT40C AT40D AT40E AT40F AT41A AT41B AT41C AT41D AT41E AT41F AT42 AT100A AT100B AT101A AT101B')
    if (!suppArray.findfirst(!atta.:MDSGuideRef.stype).set().not() ) then
      !slip = object FORM()
      !!mdsAlignSUnit(!slip)
      !!ce = !atta
    endif
    --<wd>feb2003
  elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.stype inset('SP01')) then
    !offset = !atta.despar[1] + !atta.param[2] / 2
    !!ce = !atta.:MDSGuideRef
    despar n 5 $!offset
    handle any
    endhandle
    !!ce = !atta
  elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.stype inset('SP01A')) then
    !offset = !atta.despar[1] + !atta.despar[2]
    !!ce = !atta.:MDSGuideRef
    despar n 5 $!offset
    handle any
    endhandle
    !!ce = !atta
  elseif(!atta.:mdsguideref.badref().not() and !atta.:mdsguideref.neq(Nulref) and !atta.:mdsguideref.stype inset('GT20')) then
    !dp1 = !atta.despar[1]
    !dp2 = !atta.despar[2]
    !!ce = !atta.:mdsguideref
    despar n 1 $!dp1
    handle any
    endhandle
    !!ce = !atta
  endif

  -- When the standards height is controlled via the insulation then reset the insulation
  if !insuDpNum.neq(0) then
    despar n$!insuDpNum $!insuval
  endif

  -- Update Aid Marker text for the Selected Atta
  !!ce = !atta
  !p9pos = ppos9 wrt /*
  if (!atta.name.match('.').eq(0)) then
    !attanum = 'Datum'
    !aidnum  = 210
  else
    !attanum = !atta.name.after('.')
    !aidnum  = 210 + !attanum.real()
  endif
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!aidnum $!attanum $<$!p9pos$>
  unenhance $!atta
  refresh
  enhance $!atta col $!!gphcolopt.highlight.code

  -- Reset units back
  !!kRestoreUnits(!currentunits)

  return

endfunction
