--
-- File: Mdsmodspring.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Andrew Kirkland
-- Created: Wed 20th May 1998
--
--
-- Description:
-- function to modify spring height
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Qualifer 'HEIGHT' 'CASEH' 'CASEDIA' 'SQUA' 'STEEL' + others
--     3     R        DBREF         Atta Dbref
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsModSpring(!form is FORM, !type is STRING,!atta is DBREF)

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !unusedsupport = !form.support
  !supptype = !form.support.type
  !unusedalias = !form.support.alias
  !pickedType = !type
  !!ce = !atta
  !special = FALSE

  -- If the support is an sp01 it may be under a shoe/reinforcing plate
  -- The :MDSGuideRef attribute should be set to the shoe/reinforcing plate
  -- We need to remember despar n5 (the offset form the pipe centreline)
  -- so we can put it back at the end

  if !atta.:MDSSuppType.eq('SP01') and !atta.:MDSGuideRef.unset().not() then
    !currentDPs = despar
    !offsetFromCl = !currentDPs[5]
    !resetOffset = true
  endif

  if(!atta.:MDSSuppType.eq('SP02') or !atta.stype inset ('SP03A','SP03B','SP03C','SP03D','SP03G')) then
    !infBeh = 'beh'
  else
    !infBeh = 'Inf'
  endif

  if (!pickedType eq 'STEEL') then

    prompt off
    prompt load escape 'Identify steelwork to support Spring unit from'
    --<wd>17jan2008 -- Defect No. P-4407
    --      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE @
    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE HSTIFF HPLATE @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
    !unusedsteel = !!ce.name

    if(!atta.stype inset('SP01A','SP02A','SP03E','SP03F','SP03EA','SP03FA')) then
      !pedestal = !atta.:MDSGuideRef
      pin 9 copy p3 of $!pedestal
      handle any
        pin 9 copy p9 of $!atta
      elsehandle NONE
        if(!atta.stype.eq('SP03E') or !atta.stype.eq('SP03F')) then
          !special = TRUE
        endif
      endhandle
    else
      !pedestal = !atta.:MDSGuideRef
      if(!pedestal.unset()) then
        if(!atta.:MDSSuppType.eq('SP02') ) then
          pin 9 copy p4 of $!atta
        else
          -- For SP03A/B/C/G
          pin 9 copy p9 of $!atta

        endif

      else
        pin 9 copy p3 of $!pedestal
        !special = TRUE
      endif
    endif
    pin 8 copy pin 9
    pin 8 dir d wrt /*
    pin 8 plane pin 8 clear 0 $!infBeh CE
    !dist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
    !pickedType = 'HEIGHT'

    -- Is pin 8 above p9, if it is the steel is above the shoe
    -- PML1 code DOES NOT WORK CORRECTLY
    --        var !pin8u pin 8 u wrt /*

    var !pin8pos pin 8 pos wrt /*
    !pin8p = !pin8pos.position()
    !pin8u = !pin8p.up

    !!ce = !atta
    var !p9 p3 u wrt /*
    same
    !!mdsResetPins(8,9)

    if(!atta.stype inset ('SP01','SP01A','SP03E','SP03F','SP03EA','SP03FA')) then
      if (!pin8u.real() gt !p9.real()) then
        !!alert.error('Identified steel is above the spring unit')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    else
      if (!pin8u.real() lt !p9.real()) then
        !!alert.error('Identified steel is below the spring unit')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
    !form.height.val = !dist
  endif

  !!ce = !atta
  !bore = pa bore

  --------------------
  --<wd>aug2006<mds12> -- Modify the CODE so it DOES NOT use the "!parvar" variable set below.
  if (!supptype.unset()) then
    !supptype = !!ce.styp
    if(!supptype.eq('SP01A') or !supptype.eq('SP02A')) then
      !supptype = !supptype.before('A')
    endif
    --!parvar = '!!mdspar' + !supptype
  elseif(!supptype.eq('SP03')) then
    !supptype = !atta.stype
    !supptype = !supptype.substring(1,5)
    --!parvar = '!!mdspar' + !supptype
  else
    --!parvar = '!!mdspar' + !supptype
  endif

  -- Set up the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
  !realbore    = !bore.real().value()
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedmdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)
  --<wd>aug2006<mds12>
  --------------------

  -- set desp 5 to height of pedestal
  if(!special) then
    !offset = !atta.:MDSGuideRef.desp[1] + !atta.para[3] / 2
    desp num 5 $!offset
  elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !special.not()) then
    if(!atta.stype.eq('SP02A')) then
      !trunDia = !atta.:MDSGuideRef.para[5]
      !offset = !atta.:MDSGuideRef.desp[1]
      desp num 6 $!offset
      desp num 7 $!trunDia
    elseif(!atta.stype.eq('SP03E') or !atta.stype.eq('SP03F')) then
      !offset = !atta.:MDSGuideRef.desp[1] + !atta.para[3] / 2
      desp num 5 $!offset
    else
      !offset = !atta.:MDSGuideRef.desp[1] + !atta.:MDSGuideRef.desp[2]
      desp num 5 $!offset
    endif
  endif

  -- sort out slope
  if(!atta.stype.eq('SP02')) then
    !attapldir = pl dir wrt world of $!atta
    handle (2,201) (2,252)
      !attapldir = ph dir wrt world of $!atta
    endhandle

    var !atline  const line $!attapldir thro pl of $!atta
    handle (2,252)
      var !atline const line $!attapldir thro ph
    endhandle
    var !nat const line project $!atline on plane u wrt /* thro e0n0u0 wrt /*
    var !angle const angle $!nat $!atline
    handle (47,62)
      -- Vertical line
      var !angle '90'
    endhandle
    -- desp 8 = angle
    despar n8 $!angle
    handle any
    endhandle

    -----------------------------
    -- set angle so rod is vertical

    var !p42dir P42 dir wrt /*
    if (!p42dir neq 'U' and !p42dir neq 'Z') then
      despar n8 -$!angle
    endif
    -----------------------------

  endif
  ----------------------------------------------------------------
  --> Modified - <wd> - may2000
  ----------------------------------------------------------------
  -- Set Min/Max Boolean variables
  !minval = false
  !maxval = false

  if (!pickedType.upcase() eq 'HEIGHT') then

    if (!form.height.val.unset()) then
      !form.height.val = 0
    endif

    !dpnum = !!mdsGetDesp('HEIG')

    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!expr = $!parvar[$!bore].altexpr
    --!altdespar = $!parvar[$!bore].altdespars
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !expr      = !mdsattaobj.altexpr
    !altdespar = !mdsattaobj.altdespars
    !min       = !mdsattaobj.userdps[$!dpnum].min
    !max       = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.height.val.real() lt !min) then
      !!kformattext.text.val = !min

      !minval = true
      !frmhei = !form.height.val.string(!!distancefmt)
      !minhei = !min.string(!!distancefmt)
      !!alert.error(|Height entered ($!frmhei) is less than the minimum allowed. Setting height to minimum of $!minhei|)

      --        !!alert.error(|Height entered ($!form.height.val) is less than the minimum allowed. Setting height to minimum of $!!kformattext.text.val|)
      !form.height.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.height.val.real() gt !max) then
      !!kformattext.text.val = !max

      !maxval = true
      !frmhei = !form.height.val.string(!!distancefmt)
      !maxhei = !!kformattext.text.val.string(!!distancefmt)
      !!alert.error(|Height entered ($!frmhei) is greater than the maximum allowed. Setting height to maximum of $!maxhei|)

      --        !!alert.error(|Height entered ($!form.height.val) is greater than the maximum allowed. Setting height to maximum of $!!kformattext.text.val|)
      !form.height.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif

    -- Only Set The Despars here if value is within the Min/Max limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!!ce,!dpnum,!form.height.val)
    endif

    if (!expr.set()) then
      var !test ($!expr)
      if (!test.boolean()) then
        do !set values !altdespar
          !!mdssetdespar(!!ce,!set.dpnum,!set.altval)
        enddo
      else
        -- Set The Despars here to RESET any Despars Previously set by Alternate Expressions
        if (!minval) then
          !!mdssetdespars(!!ce)
          !!mdssetdespar(!!ce,!dpnum,!min)
        elseif (!maxval) then
          !!mdssetdespars(!!ce)
          !!mdssetdespar(!!ce,!dpnum,!max)
        else
          !!mdssetdespars(!!ce)
          !!mdssetdespar(!!ce,!dpnum,!form.height.val)
        endif
      endif

      !dpnum = !!mdsGetDesp('LEN')
      if (!form.length.val.unset()) then
        !form.length.val = 0
      endif
      !!mdssetdespar(!!ce,!dpnum,!form.length.val)

    endif
    ----------------------------------------------------------------
    --< Modified - <wd> - may2000
    ----------------------------------------------------------------

  elseif (!pickedType eq 'CASEH') then

    !dpnum = !!mdsGetDesp('CHEI')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.case.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Case Height entered ($!form.case.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.case.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.case.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Case Height entered ($!form.case.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.case.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif

    !!mdssetdespar(!!ce,!dpnum,!form.case.val)

  elseif (!pickedType eq 'CASELEN') then

    !dpnum = !!mdsGetDesp('CLEN')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.caselen.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Case Length entered ($!form.caselen.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.caselen.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.caselen.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Case Length entered ($!form.caselen.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.caselen.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif

    !!mdssetdespar(!!ce,!dpnum,!form.caselen.val)

  elseif (!pickedType eq 'CASEDIA') then

    !dpnum = !!mdsGetDesp('CDIA')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.caseDia.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Case Diameter entered ($!form.caseDia.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.caseDia.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.caseDia.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Case Diameter entered ($!form.caseDia.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.caseDia.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.caseDia.val)

  elseif (!pickedType eq 'SQUA') then

    !dpnum = !!mdsGetDesp('SQUA')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.squa.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.squa.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.squa.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.squa.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.squa.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.squa.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.squa.val)

  elseif (!pickedType eq 'RODD') then

    !dpnum = !!mdsGetDesp('RODD')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.rod.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.rod.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.rod.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.rod.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.rod.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.rod.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.rod.val)

  elseif (!pickedType eq 'RODL') then

    !dpnum = !!mdsGetDesp('RODL')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.topROD.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.topROD.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.topROD.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.topROD.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.topROD.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.topROD.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.topROD.val)


  elseif (!pickedType eq 'CASELEN') then

    !dpnum = !!mdsGetDesp('CASELEN')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.caselen.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.caselen.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.caselen.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.caselen.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.caselen.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.caselen.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.caselen.val)


  elseif (!pickedType eq 'HWID') then

    !dpnum = !!mdsGetDesp('HWID')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.houWid.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.houWid.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.caselen.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.caselen.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.houWid.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.houWid.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.houWid.val)


  elseif (!pickedType eq 'HTHK') then

    !dpnum = !!mdsGetDesp('HTHK')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.houthk.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.houthk.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.houthk.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.houthk.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.houthk.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.houthk.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.houthk.val)


  elseif (!pickedType eq 'HDEP') then

    !dpnum = !!mdsGetDesp('HDEP')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.houDep.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.houDep.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.houDep.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.houDep.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.houDep.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.houDep.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.houDep.val)


  elseif (!pickedType eq 'HLEN') then

    !dpnum = !!mdsGetDesp('HLEN')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.houLen.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.houLen.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.houLen.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.houLen.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.houLen.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.houLen.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.houLen.val)


  elseif (!pickedType eq 'ARM') then

    !dpnum = !!mdsGetDesp('ARM')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.arm.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.arm.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.arm.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.arm.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.arm.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.arm.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.arm.val)


  elseif (!pickedType eq 'CENL') then

    !dpnum = !!mdsGetDesp('CENL')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.centreL.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Base Plate size entered ($!form.centreL.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.centreL.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.centreL.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Base Plate size entered ($!form.centreL.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.centreL.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.centreL.val)

  elseif (!pickedType eq 'ANG') then

    !dpnum = !!mdsGetDesp('ANG')
    --------------------
    --<wd>aug2006<mds12> -- Use the NEW MDS12 DEFAULTS OBJECT and DATA for !atta to replace the use of the "!parvar" variable
    --!min = $!parvar[$!bore].userdps[$!dpnum].min
    --!max = $!parvar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max
    --<wd>aug2006<mds12>
    --------------------

    if (!form.angle.val.real() lt !min) then
      !!kformattext.text.val = !min
      !!alert.error(|Rotation angle ($!form.angle.val) is less than the minimum allowed. Setting to minimum of $!!kformattext.text.val|)
      !form.angle.val = !min
      !!mdssetdespar(!!ce,!dpnum,!min)
    endif

    if (!form.angle.val.real() gt !max) then
      !!kformattext.text.val = !max
      !!alert.error(|Rotation angle ($!form.angle.val) is greater than the maximum allowed. Setting to maximum of $!!kformattext.text.val|)
      !form.angle.val = !max
      !!mdssetdespar(!!ce,!dpnum,!max)
    endif
    !!mdssetdespar(!!ce,!dpnum,!form.angle.val)
  endif

  if defined(!resetOffset) then
    despar n5 $!offsetFromCl
  endif

  --   !!mdsResetGuide()

  -- Reset units back

  !!kRestoreUnits(!currentUnits)

  return

endfunction
