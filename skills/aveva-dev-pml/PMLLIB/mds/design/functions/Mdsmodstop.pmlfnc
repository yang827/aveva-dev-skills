--
-- File: Mdsmodstop.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.Morris
-- Created: Wed Oct 29
--
--
-- Description:
-- function to modify a pipe shoe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Qualifier 'MODIFY' 'CREATE'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsModStop(!form is FORM,!type is STRING,!atta is DBREF,!steel is DBREF) is BOOLEAN

-- Find current units and set the distance unit to metric

    !currentunits = !!kGetSetUnits()

  -- Initialise Variables
    !unusedsupport = !form.support
    !passedtype = !type
    !unusedsupptype = !form.support.type
    !unusedalias = !form.support.alias
    !clearance  = !!mdsOptions.clear.val

-- Save type of standard and number for later use.

    !std = !!mdsGetStdNum(!form.support.type)

    !!ce = !atta
    !p9dir = p9 dir

    if (!passedtype eq 'MODIFY' or !passedtype eq 'CREATE') then
      if (!passedtype eq 'MODIFY') then
        prompt off
        prompt load escape 'Identify steelwork to guide from'
--<wd>17jan2008 -- Defect No. P-4407
--        ID SCTN @
        ID SCTN HSTIFF @
--<wd>17jan2008 -- Defect No. P-4407
          handle (61,528)
            prompt on
            !!kRestoreUnits(!currentunits)
        return false
          endhandle
        prompt on
        !idsteel = !!ce
      elseif (!passedtype eq 'CREATE') then
        !!ce = !steel
        !idsteel = !!ce
      endif
-- test if steel is above stop
      !testce = !!mdsRelToDatum(!atta, !idsteel, !p9dir, !clearance.real())
      if (!testce[1].upcase() neq 'BELOW') then
        !!alert.error('Identified steelwork is unsuitable for this guide')
        !!kRestoreUnits(!currentunits)
        return false
      endif

      !!ce = !atta

      if (!passedtype eq 'MODIFY') then

-- Check if identified steelwork is perp to pipe in the hori, if not issue a message for
-- user to adjust clearance.

       pin 9 at poss of $!idsteel
       pin 8 at pose of $!idsteel
       pin 9 dir u wrt /*
       pin 9 plane pin 9 thro pin 8
       pin 9 dir from pin 9 to pin 8
       pin 7 copy pin 9
       pin 7 plane pin 7 thro $!atta
       pin 6 copy pl
       pin 6 dist 100mm
       pin 9 dir u wrt /*
       pin 8 dir u wrt /*
       pin 7 dir u wrt /*
       pin 6 dir u wrt /*
       pin 8 plane pin 8 thro pin 9
       pin 7 plane pin 7 thro pin 9
       pin 6 plane pin 6 thro pin 9
       if !!kStrReal('const angle pin 9 to pin 7 to pin 6').neq(90) then
         !!mdsResetPins(6,9)
         !!alert.error('Identified steelwork is not perpendicular to pipe! ')
         return
       endif

       !centre = !!mdsBeamCentre(!idsteel)
       pin 9 at poss of $!idsteel
       pin 8 at pose of $!idsteel
       pin 9 dir u wrt /*
       pin 9 plane pin 9 thro pin 8
       pin 9 dir from pin 9 to pin 8
       pin 9 plane pin 9 thro pl of $!atta
       !!ce = !atta
--<wd>nov2000
       plane pl thro $!centre
--       plane pl thro pin 9
--<wd>nov2000
      endif
      pin 9 copy pl
      pin 8 copy pin 9
      pin 9 plane pin 9 clear 0 beh $!idsteel
      pin 8 plane pin 8 clear 0 inf $!idsteel
      !dist = !!kStrReal('const dist pin 9 to pin 8')
      if !atta.styp.eq('ST12') then
      !dpnum = !!mdsGetDesp('SBWD')
      elseif ((!std[1].eq('ST') and (!std[2].real().geq(570) and !std[2].real().leq(639)))) then
      !dpnum = !!mdsGetDesp('SBFW')
      else
      !dpnum = !!mdsGetDesp('LEN')
      endif
      if !dpnum.gt(0) then
        despar n$!dpnum  $!dist
      endif
--<wd>jan2004
    --<dw>mar2009 dun1119 Dun1052 ST43,ST44,ST57 & ST58 added
      if (!atta.styp inset ('ST20')) then
      !dpnum = !!mdsGetDesp('SBFW')
      elseif !atta.styp.eq('ST12') then
      !dpnum = !!mdsGetDesp('SBWD')
    elseif !atta.styp inset('ST43','ST44','ST57','ST58') then
      !dpnum = !!mdsGetDesp('WID')
    else
      !dpnum = !!mdsGetDesp('LEN')
      endif
      if !dpnum.gt(0) then
        despar num $!dpnum  $!dist
      endif
--<wd>jan2004

      !!mdsResetPins(6,9)

    elseif (!passedtype eq 'HEIGHT') then
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
      if (!form.height.val.unset()) then
        !form.height.val = 0
      endif
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------

      !!ce = !atta
      !styp = !!ce.styp
      !bore = pa bore

------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
    --!parVar = '!!mdspar' + !styp

      !realbore = !bore.real().value()
      !mdsattaobj  = object MDSREADPARSDATA()
      !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)

    --<dw>mar2009 dun1119 ST43,ST44,ST57,ST58 & GT85 added
    if !atta.styp inset('ST43','ST44','ST57','ST58','ST59','GT85') then
      !dpnum = !!mdsGetDesp('STLH')
    else
      !dpnum = !!mdsGetDesp('HEI')
    endif

    --!expr = $!parVar[$!bore].altexpr
    --!altdespar = $!parVar[$!bore].altdespars
    !expr = !mdsattaobj.altexpr
    !altdespar = !mdsattaobj.altdespars

    --!min = $!parVar[$!bore].userdps[$!dpnum].min
    --!max = $!parVar[$!bore].userdps[$!dpnum].max
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    --mjb <<< 11.04.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------------
    -- get format
    !!kFormatText.text.val = !form.height.val
    !fHeight = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !min
    !fmin = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

      if (!form.height.val lt !min) then
        !!alert.error('Height entered (' & !fHeight & ') is less than the minimum allowed. $
      Setting height to minimum of ' &  !fmin)
        !form.height.val = !min
      !!mdsSetDespar(!!ce,!dpnum,!min)
      endif

      if (!form.height.val gt !max) then
        !!alert.error('Height entered (' & !fHeight & ') is greater than the maximum allowed. $
      Setting height to maximum of ' & !fmax)
        !form.height.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
      endif

    !!mdsSetDespar(!!ce,!dpnum,!form.height.val)

      if (!expr.set()) then
        var !test ($!expr)
        if (!test.boolean()) then
          do !set values !altdespar
          !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
          enddo
        else
        !!mdsSetDespars(!!ce)
        !!mdsSetDespar(!!ce,!dpnum,!form.height.val)
        endif

      !dpnum = !!mdsGetDesp('HEI')
      !!mdsSetDespar(!!ce,!dpnum,!form.height.val)
      endif

    elseif (!passedtype eq 'OVERLAP') then

----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
     if (!form.overlap.val.unset()) then
        !form.overlap.val = 0
      endif
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------

      !!ce = !atta
      !styp = !!ce.styp
      !bore = pa bore
------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>

    --!parVar = '!!mdspar' + !styp

      !realbore = !bore.real().value()
      !mdsattaobj  = object MDSREADPARSDATA()
      !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)

    !dpnum = !!mdsGetDesp('OVER')

    --!expr = $!parVar[$!bore].altexpr
    --!altdespar = $!parVar[$!bore].altdespars
      !expr = !mdsattaobj.altexpr
      !altdespar = !mdsattaobj.altdespars

    --!min = $!parVar[$!bore].userdps[$!dpnum].min
    --!max = $!parVar[$!bore].userdps[$!dpnum].max
      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max

--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

     -- get format
    !!kFormatText.text.val = !form.overlap.val
    !fOverLap = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !min
    !fmin = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

      if (!form.overlap.val lt !min) then
        !!alert.error('Overlap entered (' & !fOverLap & ') is less than the minimum allowed. $
      Setting overlap to minimum of ' & !fmin)
        !form.overlap.val = !min
      !!mdsSetDespar(!!ce,!dpnum,!min)
      endif

      if (!form.overlap.val gt !max) then
        !!alert.error('Overlap entered (' & !fOverLap & ') is greater than the maximum allowed.$
      Setting overlap to maximum of ' & !fmax)
        !form.overlap.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
      endif

    !!mdsSetDespar(!!ce,!dpnum,!form.overlap.val)

      if (!expr.set()) then
        var !test ($!expr)
        if (!test.boolean()) then
          do !set values !altdespar
          !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
          enddo
        else
        !!mdsSetDespars(!!ce)
        !!mdsSetDespar(!!ce,!dpnum,!form.overlap.val)
        endif

      !dpnum = !!mdsGetDesp('OVER')
      !!mdsSetDespar(!!ce,!dpnum,!form.overlap.val)
      endif

    elseif (!passedtype eq 'CLEARANCE') then

----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
     if (!form.clearance.val.unset()) then
        !form.clearance.val = 0
      endif
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------

      !!ce = !atta
      !styp = !!ce.styp
      !bore = pa bore

------------------------------------------------------------------------------------------------
--mjb >>> 11.04.06 <mds12>
    --!parVar = '!!mdspar' + !styp

      !realbore = !bore.real().value()
      !mdsattaobj  = object MDSREADPARSDATA()
      !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!realbore)

    !dpnum = !!mdsGetDesp('CLR')

    --!expr = $!parVar[$!bore].altexpr
    --!altdespar = $!parVar[$!bore].altdespars
      !expr = !mdsattaobj.altexpr
      !altdespar = !mdsattaobj.altdespars

    --!min = $!parVar[$!bore].userdps[$!dpnum].min
    --!max = $!parVar[$!bore].userdps[$!dpnum].max
      !min = !mdsattaobj.userdps[$!dpnum].min
      !max = !mdsattaobj.userdps[$!dpnum].max

--mjb <<< 11.04.06 <mds12> end of mod
------------------------------------------------------------------------------------------------

     -- get format
    !!kFormatText.text.val = !form.clearance.val
    !fClearance = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !min
    !fmin = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

      if (!form.clearance.val lt !min) then
        !!alert.error('Clearance entered (' & !fClearance & ') is less than the minimum allowed.$
      Setting Clearance to minimum of ' & !fmin)
        !form.clearance.val = !min
      !!mdsSetDespar(!!ce,!dpnum,!min)
      endif

      if (!form.clearance.val gt !max) then
        !!alert.error('Clearance entered (' & !fClearance & ') is greater than the maximum allowed.$
      Setting Clearance to maximum of ' & !fmax)
        !form.clearance.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
      endif

    !!mdsSetDespar(!!ce,!dpnum,!form.clearance.val)

      if (!expr.set()) then
        var !test ($!expr)
        if (!test.boolean()) then
          do !set values !altdespar
          !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
          enddo
        else
        !!mdsSetDespars(!!ce)
        !!mdsSetDespar(!!ce,!dpnum,!form.clearance.val)
        endif

      !dpnum = !!mdsGetDesp('CLR')
      !!mdsSetDespar(!!ce,!dpnum,!form.clearance.val)
      endif

    --<dw>mar2009 dun1119 To allow shoe length to be reset on form mdsst43
  elseif (!passedtype eq 'BOLTEDLEN') then
    !!ce = !atta
    !styp = !!ce.styp
    !bore = pa bore
    --    !parVar = '!!mdsPar' + !styp
    !dpnum = !!mdsGetDesp('WID')
    --    !expr = $!parVar[$!bore].altexpr
    --    !altdespar = $!parVar[$!bore].altdespars
    --    !min = $!parVar[$!bore].userdps[$!dpnum].min
    --    !max = $!parVar[$!bore].userdps[$!dpnum].max
    !realbore = !bore.real().value()
    !mdsattaobj  = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!styp,!realbore)
    !expr = !mdsattaobj.altexpr
    !altdespar = !mdsattaobj.altdespars
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    -- get format
    !!kFormatText.text.val = !form.boltedlen.val
    !fBoltedLen = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !min
    !fmin = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

    if (!form.boltedlen.val lt !min) then
      !!alert.error('Bolted length entered (' & !fBoltedLen & ') is less than the minimum allowed.$
      Setting Bolted length to minimum of ' & !fmin)
      !form.boltedlen.val = !min
      !!mdsSetDespar(!!ce,!dpnum,!min)
    endif

    if (!form.boltedlen.val gt !max) then
      !!alert.error('Bolted length entered (' & !fBoltedLen & ') is greater than the maximum allowed.$
      Setting Bolted length to maximum of ' & !fmax)
      !form.boltedlen.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
    endif

    !!mdsSetDespar(!!ce,!dpnum,!form.boltedlen.val)

    if (!expr.set()) then
      var !test ($!expr)
      if (!test.boolean()) then
        do !set values !altdespar
          !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
        enddo
      else
        !!mdsSetDespars(!!ce)
        !!mdsSetDespar(!!ce,!dpnum,!form.boltedlen.val)
      endif

      !dpnum = !!mdsGetDesp('WID')
      !!mdsSetDespar(!!ce,!dpnum,!form.boltedlen.val)
    endif
    --<dw>mar2009 dun1119 End of reset shoe length

    --<dw>mar2009 dun1119 To allow for GT86/GT87 Offset to be adjusted on form mdsst43
  elseif (!passedtype eq 'OFFSET') then
    !!ce = !atta
    !styp = !!ce.styp
    !bore = pa bore
    --    !parVar = '!!mdsPar' + !styp
    !dpnum = !!mdsGetDesp('OFFS')
    --    !expr = $!parVar[$!bore].altexpr
    --    !altdespar = $!parVar[$!bore].altdespars
    --    !min = $!parVar[$!bore].userdps[$!dpnum].min
    --    !max = $!parVar[$!bore].userdps[$!dpnum].max
    !realbore = !bore.real().value()
    !mdsattaobj  = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!styp,!realbore)
    !expr = !mdsattaobj.altexpr
    !altdespar = !mdsattaobj.altdespars
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    -- get format
    !!kFormatText.text.val = !form.offset.val
    !foffset = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !min
    !fmin = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

    if (!form.offset.val lt !min) then
      !!alert.error('Offset entered (' & !foffset & ') is less than the minimum allowed.$
      Setting Offset to minimum of ' & !fmin)
      !form.offset.val = !min
      !!mdsSetDespar(!!ce,!dpnum,!min)
    endif

    if (!form.offset.val gt !max) then
      !!alert.error('Offset entered (' & !foffset & ') is greater than the maximum allowed.$
      Setting Offset to maximum of ' & !fmax)
      !form.offset.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
    endif

    !!mdsSetDespar(!!ce,!dpnum,!form.offset.val)

    if (!expr.set()) then
      var !test ($!expr)
      if (!test.boolean()) then
        do !set values !altdespar
          !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
        enddo
      else
        !!mdsSetDespars(!!ce)
        !!mdsSetDespar(!!ce,!dpnum,!form.offset.val)
      endif

      !dpnum = !!mdsGetDesp('OFFS')
      !!mdsSetDespar(!!ce,!dpnum,!form.offset.val)
    endif

  elseif (!passedtype eq 'SHOELENG') then
    goto :MDSGuideRef
    !styp = !!ce.styp
    !bore = pa bore
    --    !parVar = '!!mdsPar' + !styp
    !dpnum = !!mdsGetDesp('LEN')
    --    !expr = $!parVar[$!bore].altexpr
    --    !altdespar = $!parVar[$!bore].altdespars
    --    !min = $!parVar[$!bore].userdps[$!dpnum].min
    --    !max = $!parVar[$!bore].userdps[$!dpnum].max
    !realbore = !bore.real().value()
    !mdsattaobj  = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!styp,!realbore)
    !expr = !mdsattaobj.altexpr
    !altdespar = !mdsattaobj.altdespars
    !min = !mdsattaobj.userdps[$!dpnum].min
    !max = !mdsattaobj.userdps[$!dpnum].max

    -- get format
    !!kFormatText.text.val = !form.shoeadj.val
    !fShoeAdj = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !!kFormatText.text.val = !max
    !fmax = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)

    if (!form.shoeadj.val gt !max) then
      !!alert.error('Length entered (' & !fShoeAdj & ') is greater than the maximum allowed.$
      Setting length to maximum of ' & !fmax)
      !form.shoeadj.val = !max
      !!mdsSetDespar(!!ce,!dpnum,!max)
    endif
    !!mdsSetDespar(!!ce,!dpnum,!form.shoeadj.val)

    !expressionerror = FALSE
    if (!expr.set()) then
      var !test ($!expr)
      handle(47,15)
        !expressionerror = TRUE
      endhandle
      if !expressionerror eq FALSE then
        if (!test.boolean()) then
          do !set values !altdespar
            !!mdsSetDespar(!!ce,!set.dpnum,!set.altval)
          enddo
        else
          !!mdsSetDespars(!!ce)
          !!mdsSetDespar(!!ce,!dpnum,!form.shoeadj.val)
        endif
      endif

      !dpnum = !!mdsGetDesp('LEN')
      !!mdsSetDespar(!!ce,!dpnum,!form.shoeadj.val)
    endif
    same
    --<dw>mar2009 dun1119 End of adjust offset
    endif
    if defined(!idsteel) then
       if !atta.styp.eq('ST24B') or !atta.styp.eq('ST24D') or !atta.styp.eq('ST41') then
           !lpos = !atta.ppos[9].wrt(/* )
           !ddir = !atta.pdir[9].wrt(/* )
           pin 5 at $!lpos
           pin 5 dir $!ddir
           pin 5 plane $!ddir inf $!idsteel
           var !pdist const dist $!lpos to pin5
           !dist = !pdist.real()
      !dpnum = !!mdsGetDesp('SHEI')
           desp num $!dpnum  $!dist
           pin 5 off
       endif
    endif


----------------------------------------------------------------
--> Modified - <anand> - feb2005
----------------------------------------------------------------
--Code for ST32 to position the support below the clamped shoe and to position the shear lugs
--at clamp edges
      if !atta.styp.eq('ST32') then
        !ce = !!ce
        prompt off
        prompt load escape 'Identify clamped shoe to which support is to be welded'
        ID ATTA @
          handle (61,528)
            prompt on
            !!kRestoreUnits(!currentunits)
        return false
          endhandle
        prompt on
        !unusedclshoe = !!ce
        pin 6 at p12
        pin 7 at p9
        pin 8 copy pl
        pin 9 copy pa
        pin 8 dist 0 inf ce
        Pin 9 dist 0 inf ce
        !dista = !!kStrReal('const dist pin 6 to pin 7')
        !distb = !!kStrReal('const dist pin 8 to pin 9')
        $!ce
    !dpnuma = !!mdsGetDesp('HEI')
    !dpnumb = !!mdsGetDesp('CLEN')

        desp num $!dpnuma  $!dista
        desp num $!dpnumb  $!distb

        !!mdsResetPins(6,9)

      endif

    VAR !pos POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

-- Reset Units

   !!kRestoreUnits(!currentunits)

        return true

endfunction
