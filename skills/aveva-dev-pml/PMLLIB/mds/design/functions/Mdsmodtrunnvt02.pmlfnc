--
-- File:		Mdsmodtrunnvt02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 9th January 1998
--
--
-- Description:
-- Function to Modify a Trunnion atta component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsmodtrunnvt02(!form is FORM)

-- Initialise variables
    !stru      = !form.support.stru
    !name      = !stru.name
    !selection = !!Mdstrunnvt01.standard.selection('rtext')
    !datum     = !form.support.datum
    !cecomp    = !!ce

-- Reselect the Trunnion Component
    !!ce   = !datum
    !spref = spref
    sel spref with styp '$!selection' spec /MDS
      handle any
        spref $!spref
        !!alert.error('Support could not be selected. Check size is available at the type required')
        return
      endhandle

-- set the design parameters for the selected atta
    if (!!Mdssetdespars(!!ce).not()) then
      return
    endif

-- set Insulation spec...?
    !!MdsSetIspe()

--  *************************
--  Add stex for isometrics
--  *************************

    !SAtta = !!CE
    Call !!MdsTransport(!SAtta,!Name)

    !!MdsSelLstu(!!CE)

-- Return to Original Component
    !!ce = !cecomp

  endfunction
-- End function

-- End of file Mdsmodtrunnvt02.pml
