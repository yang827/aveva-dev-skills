--
-- File:       Mdsmovetosite.pmlfnc
-- Type:       Function Definition
-- Group:      Multi Discipline Supports Application
-- Keyword:    MDS
-- Module:     design
-- Replaces:   MSITE
--
-- Author:     I.Osborne
-- Created:    Mon Apr 25
--
--
-- Description:
-- Function to navigate to the correct element so the user can create his pipe support stru
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        Suffix of Zone where support is to be created
--                                  eg 'TRIM' or 'SUPP'
--
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN       True if user can navigate to correct area
--
--------------------------------------------------------------------------------

define function !!mdsMoveToSite(!unusedText is STRING) is BOOLEAN

  -- Initialise variables
  !site = !!mdsDefaultSite.site.selection('Dtext')
  if (!site eq '')then
    !!alert.error('Set default support site from options menu before creating supports.')
    return FALSE
  endif

  !siteName = '/' + !site

  !!ce = !siteName.dbref()
  handle (2,109)
    !!alert.error('Unable to find the selected MDS Default Zone. Aborting MDS Support Creation/Modification')
    return FALSE
  endhandle

  var !suppos coll all SUPPO for ce
  if (!suppos.size().neq(0)) then
    !!alert.error('Cannot create a support in a ZONE containing supports from E3D 2.1 or later. Please choose a different support ZONE.')
    return FALSE
  endif

  last member
  handle (41,66) (2,113) (2,113)
  endhandle

  return TRUE

endfunction
