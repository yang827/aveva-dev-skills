--
-- File:		Mdsnamegadget.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MBUTTON
--
-- Author:		I.Osborne
-- Created:		Mon Apr 28
--
--
-- Description:
-- Tests Text gadget contents
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         GADGET      Gadget name of text gadget
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!MdsNameGadget(!Form is FORM)

  !gadget = !form.name
  !ok     = !form.ok

  -- Check text gadget contents
  if(!Gadget.Val.upcase() neq |UNSET| and !Gadget.Val neq ||) then
    call !!KActivateGadget(!ok, True)
  else
    call !!KActivateGadget(!ok, False)
  endif

-- End function
endfunction

-- End of file Mdsnamegadget.pml
