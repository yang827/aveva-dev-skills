--
--
-- Description:
-- Setting callback on the 'OK' button for form 'MdsNAMESPL'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Value of passed option gadget'
--                                 'ATTA' or 'STRU'
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsNamesplok(!create is STRING)

  -- Set the Callback actions on the form '!!mdsNamespl.ok' - OK gadget
  if (!create.eq('ATTA')) then
    !!mdsNamespl.ok.callback = |!!mdsispecial('NEW','$$!!mdsNamespl.name','$$!!mdsNamespl.number')|
    --<sk> 12/06/2012 turn on preliminary support
    !!mdsNamespl.fromexisting.active = true
    --<sk> 12/06/2012
  elseif (!create.eq('STRU')) then
    !!mdsNamespl.ok.callback = |!!mdsisplframe('NEW','$$!!mdsNamespl.name','$$!!mdsNamespl.number')|
    --<sk> 12/06/2012 turn off preliminary support
    !!mdsNamespl.fromexisting.active = false
    -- Check if need to reset the name (preliminary support already given)
    !name = !!mdsNamespl.name.val
    if (!name.neq('unset')) then
      !unusedDatum = object DBREF(!name)
      handle NONE
        -- reset is needed because preliminary support already pointed
        !!mdsNamespl.name.val = 'unset'
      elsehandle ANY
      endhandle
    endif
    --<sk> 12/06/2012
  endif

endfunction
