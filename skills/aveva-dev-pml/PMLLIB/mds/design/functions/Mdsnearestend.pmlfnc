--
-- Author:		Andrew Kirkland
-- Created:		Thu 15th June 1998
--
--
-- Description:
-- Function to find Closest end of the sctn referenced by the joint for JOIE
-- JOIS purposes
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [SJOINT with cref]
--     2     R        DBREF        [Support vertical to find nearest end (if unset use CREF of joint)]
-- Return:
--    [Data Type]   [Description]
--     STRING       [String of sctn end nearest to joint (JOIE or JOIS)]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsNearestEnd(!Joint is dbref, !Upright is dbref) is String

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

    !Refe = !!Ce

    if(!Upright.unset()) then
       !Sctn = !Joint.cref

        if(!Sctn.Unset()) then
           !!alert.Error('No Sctn connected to the joint')
           return
        endif

    else
       !Sctn = !Upright
    endif

    !JointPos = pos of $!Joint wrt worl

    !!CE = !Sctn
    !Poss = poss wrt worl
    !Pose = pose wrt worl

    !DistEnd = !!KStrReal('Const dist $!Pose to $!JointPos')
    !DistSta = !!KStrReal('Const dist $!Poss to $!JointPos')

    if(!DistEnd.gt(!DistSta)) then
       !End = 'START'
    else
       !End = 'END'
    endif

-- Reset Units

   !!kRestoreUnits(!currentunits)

   !!CE = !Refe

    Return  !End

-- End function
endfunction

-- End of file MdsNearestEnd.pml
