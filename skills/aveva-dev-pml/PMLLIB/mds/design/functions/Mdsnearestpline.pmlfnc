--
-- File: Mdsnearestpline.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Thu 15th June 1998
--
--
-- Description:
-- Function to find nearest pline to stcn end
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Sctn to connect to]
--     2     R        DBREF        [Support vertical to connect]
--     3     R        String       [Null default sctn poss/pose, but set will
--                                  use the mid/centre of the attached sctn]
-- Return:
--    [Data Type]   [Description]
--      STRING      [Returns String of Pline calculated as the nearest pline]]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsNearestPline(!joint is DBREF, !sctnPos is POSITION, !mid is STRING) is STRING

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()
  !nearestPline = STRING()
  !refe = !!ce

  -- Initialise Variables
  !distChk = 0
  if(!mid.eq('')) then
    -- use !position asis
    !position = !sctnPos
  else
    -- use mid point of attached sctn
    !unusedattached = !joint.cref
    handle Any
      -- Use !position asis
      !position = !sctnPos
    elsehandle NONE
      -- find midpoint at sctn end/start
      !!ce = !joint.cref
      !midPoint = !!mdsBeamCentre(!!ce)
      !attPoss = Poss wrt worl
      !attPose = Pose wrt worl
      if(!!ce.jois.eq(!joint)) then
        var !attachedDir const dir $!attPose to $!attPoss
        var !endPlane const plane $!attachedDir thro $!attPoss
      else
        var !attachedDir const dir $!attPoss to $!attPose
        var !endPlane const plane $!attachedDir thro $!attPose
      endif
      var !midLine const line $!attachedDir thro $!midPoint
      var !position const pos inter $!midLine $!endPlane
    endhandle
  endif
  -- goto sctn
  !!ce = !joint.owner.owner
  -- get plines
  !plines = plnam
  -- construct line  of sctn
  !poss = poss wrt worl
  !pose = pose wrt worl
  var !sctnLine const line join $!poss to $!pose
  var !sctnDir const dir $!sctnLine
  var !plane const plane $!sctnDir thro $!position

  --loop thro ppline list and evaluate which is closest
  !i = 1
  do !pline indices !plines
    var !valid plco $!plines[$!pline]
    skip if(!valid.upcase().neq('ANY'))

    !poss = plstart $!plines[$!pline] wrt worl
    !pose = plend $!plines[$!pline] wrt worl
    var !line const line join $!poss to $!pose
    var !inter const pos inter $!line $!plane
    !dist = !!kstrReal('Const dist $!inter to $!position')
    if(!i.eq(1)) then
      !distChk = !dist
      !nearestPline = !plines[!pline]
    else
      if(!dist.lt(!distChk)) then
        !nearestPline = !plines[!pline]

        !distChk = !dist
      endif
    endif
    !i = !i + 1
  enddo


  -- Reset units

  !!kRestoreUnits(!currentUnits)

  !!ce = !refe

  if !nearestPline.unset() then
    --<dw>aug2008-Dun979-To account for joint on CHS
    -- !!alert.error('No Suitable Pline Found')
    !!alert.message('Nearest pline taken as NA')
    --<dw>aug2008-Dun979-end of accounting for CHS
    !nearestPline = 'NA'
  endif

  return !nearestPline
  -- End function
endfunction
