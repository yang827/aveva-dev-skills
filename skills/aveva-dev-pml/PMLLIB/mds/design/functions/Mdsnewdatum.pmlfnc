--
-- File:    Mdsnewdatum.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Monday 17th August 1998
--
--
-- Description:
-- Change DATUM atta on Framework type Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsnewdatum(!form is FORM)

  -- exit if unique naming is on - MDSSIE04
  if !!mdsoptions.mdsuniquenames then
  	!form.newdat.active = false
  	!!alert.error('Cannot change datum atta when unique support naming is On')
  	return
  endif

  !currentunits = !!kgetsetunits()

  -- Check if DATUM atta has been Created before proceeding.
  if (!form.support.datum.unset()) then
    !!alert.error('Datum Support Atta has NOT been Created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Can we write to the datum atta

  if !!mdsComClaimDac(!!ce,'DACMOD','POS').not() then
    !!alert.error('Unable to modify the datum atta as write access is not available')
    return
  endif

  -- Initialise variables
  !support   = !form.support
  !stru      = !form.support.stru
  !datum     = !form.support.datum
  !datumname = !form.support.datum.name

  -- Check if Support is a MDS framework or Ancillary Standard
  if (!form.support.stru.set()) then
    !xstr     = true
    !numb     = 3
    !struname = !form.support.stru.name
    !srefname = !struname & '/' & 'SREF'
    !sref     = !srefname.dbref()
  else
    !xstr     = false
    !numb     = 2
    !srefname = !datumname
  endif

  -- Get current ENHANCE Colour
  !enhancecol = !!gphColOpt.highlight().code

  -- Check if More than DATUM exists before continuing
  if (!support.atta.size().lt(!numb)) then
    !!alert.error('Unable to Change the DATUM Atta on the Current Support - ''$!struname'', as NO other Atta EXISTS.')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Identify NEW Datum Atta
  label /atta

  prompt off
  prompt load escape |Identify the NEW Datum Atta...|
  id atta @
  handle (61,528)
    prompt on
    if (!xstr) then
      !!ce = !stru
    else
      !!ce = !datum
    endif
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !newdatum = !!ce

  -- Check if Identified Support Atta is suitable to become the DATUM Atta
  if (!newdatum.name.eq(!datumname) or !newdatum.name.eq(!srefname)) then
    !!alert.error('The Identified Support Atta is the EXISTING Datum Atta, Identify ANOTHER Support Atta.')
    golabel /atta
  endif

  -- Check if the new datum is a rotated atta which cannot be used
  if (!xstr) then
    if !newdatum.:MDSRotated then
      !!alert.error('The Identified Support Atta cannot be used as the DATUM atta, as it has been rotated')
      golabel /atta
    endif
  endif

  -- Check if the Selected NEW DATUM Atta is a HVAC or CABLE TRAY Element on a MDS Pipe Support.
  -- ONLY REAL Pipes may be a DATUM Atta on a "true" Multi Discipline MDS support
  --<wd>-dec2003
  -- Added the check for a MDS Special type of support -- <wd>dec2003
  if (!support.stru.:mdssupptype.eq('SPECIAL')) then
    if ((!datum.owner.owner.owner.$!!<mdsidpatt>.eq(!!mdsidpval)) and (!newdatum.spref.name.match('/MDS/.HVAC-REST') eq(1))) then
      !!alert.error('The Datum Atta may ONLY be changed to another PIPE on a SPECIAL support where the EXISTING Datum Atta belongs to a PIPE')
      golabel /atta
    elseif ((!datum.owner.owner.owner.$!!<mdsidpatt>.eq(!!mdsidpval)) and (!newdatum.spref.name.match('/MDS/.RACK-REST') eq(1))) then
      !!alert.error('The Datum Atta may ONLY be changed to another PIPE on a SPECIAL support where the EXISTING Datum Atta belongs to a PIPE')
      golabel /atta
    endif
  else
    --<wd>-dec2003
    if ((!support.alias.match('DT') ne(1)) and (!newdatum.spref.name.match('/MDS/.HVAC-REST') eq(1))) then
      !!alert.error('The Datum Atta may ONLY be changed to another PIPE on this type of support')
      golabel /atta

    elseif (!support.alias.match('CT').neq(1) and !support.alias.match('FR').neq(1)) and !newdatum.spref.name.match('/MDS/.RACK-REST') eq(1)then
      !!alert.error('The Datum Atta may ONLY be changed to another PIPE on this type of support')
      golabel /atta
    endif
  endif


  -- Check to see if the identified atta is part of the Current Support
  if (!support.atta.findfirst(!newdatum).set().not())then
    !!alert.message('The Identified atta does NOT belong to the Current Support  - ''$!struname'', Identify ANOTHER Support Atta.')
    golabel /atta
  endif

  -- Can only modify the selected atta if we can write to it

  if !!mdsComClaimDac(!!ce,'DACMOD','POS').not() then
    !!alert.error('Unable to move the datum atta to the selected atta as write access is not available')
    return
  endif

  -- Check to see if the user wants to Change the DATUM Atta
  enhance $!newdatum col 2
  if (!xstr) then
    !extratext = STRING()
    if (!form.support.modify) then
      !extratext = ''
    else
      if (!support.stru.mcount.eq(0)) then
        !extratext = ''
      else
        !formname   = !form.name().lowcase()
        if !formname.upcase().neq('MDSSPECIAL') then
          !extratext = 'Utilising the EXISTING form DIMENSIONS may give UNEXPECTED Results'
        else
          !extratext = ''
        endif
      endif
    endif
  else
    !extratext = ''
  endif

  !check = !!alert.confirm('Are you sure you want to CHANGE the DATUM Atta to the Selected Atta? $!extratext',0.3 ,0.1)
  if (!check eq 'NO') then
    unenhance $!newdatum
    enhance $!newdatum col $!enhancecol
    !!kRestoreUnits(!currentunits)
    return
  endif

  if (!xstr) then
    ------------ *** Connexion Warnings *** -------------
    !havejoints = false
    !errormessage = STRING()
    if(!!mdscheckconns(!form, !errormessage).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!mdscheckconns(!form, !errormessage).eq('WARNING')) then
      !continue = !!alert.confirm(!errormessage)
      if(!continue.eq('NO')) then
        unenhance $!newdatum
        enhance $!newdatum col $!enhancecol
        !form.cancel.active = true
        !!kRestoreUnits(!currentunits)
        return
      else
        !havejoints = true
        !!mdsselectjoints(!form,'DISCONNECT','')
        !form.support.joints.clear()
        !form.cancel.active = false
      endif
    elseif(!!mdscheckconns(!form, !errormessage).eq('ERROR')) then
      !!alert.error(!errormessage)
      unenhance $!newdatum
      enhance $!newdatum col $!enhancecol
      !form.cancel.active = true
      !!kRestoreUnits(!currentunits)
      return
    else
      -- continue
      !!mdsselectjoints(!form,'DISCONNECT','')
      !havejoints = true
      !form.support.joints.clear()
      !form.cancel.active = false
    endif
    -----------------------------------------------------------------------------
    -- If the user Changes the DATUM atta,the Existing SREF Atta is deleted and a NEW SREF Atta is
    -- CREATED next to the NEW DATUM Atta on the support.
    -- Therefore we CANNOT RESTORE the framework BACK to it's ORIGINAL dimensions.
    -- Issue a warning to the user and DEACTIVATE the cancel gadget.
    -- This WARNING is only be issued if the support is in modify mode.
    if (!form.support.modify) then
      !formname   = !form.name().lowcase()
      if !formname.upcase().neq('MDSSPECIAL') then
        if (!havejoints) then
          !test = !!alert.warning('The FRAMEWORK Support Structure will be Recreated around the NEW DATUM Atta, Utilising the EXISTING form Dimensions. This MAY give UNEXPECTED Results and You will NOT be able to CANCEL the changes. The EXTERNAL connections have already been DELETED')
        else
          !test = !!alert.confirm('The FRAMEWORK Support Structure will be Recreated around the NEW DATUM Atta, Utilising the EXISTING form Dimensions. This MAY give UNEXPECTED Results and You will NOT be able to CANCEL the changes. Do you wish to continue?')
        endif
      else
        !test = 'YES'
      endif
      if (!test eq 'YES') then
        !form.cancel.active = false
      else
        unenhance $!newdatum
        enhance $!newdatum col $!enhancecol
        !!kRestoreUnits(!currentunits)
        !form.cancel.active = true
        return
      endif
    endif
  endif

  ---------------------------------------
  -- Proceed with CHANGING the Datum Atta
  ---------------------------------------

  -- Store Existing Data for Old DATUM and New DATUM Atta
  !oldnameatta   = !newdatum.name
  !oldnamedatum  = !datumname
  --<kp>july06
  --!oldadpdatum   = !datum.:mdsadp
  !oldconfig     = !datum.:MDSCp1

  -- Exchange Names of DATUM Atta and Identified Atta
  !!mdsDacControl(true)
  !!ce = !newdatum
  unname

  -- Old DATUM Atta - Reset Attributes ONLY relevant to a DATUM Atta
  !!ce = !datum
  name $!oldnameatta
  --<kp>july06
  --    :mdsadp unset
  :MDSCp1 unset

  -- New DATUM Atta
  !!ce = !newdatum
  name $!oldnamedatum

  --<kp>july06 - commented out
$(    -- Set Existing DATUM Atta attribute ':mdsadp' at the New DATUM Atta
  do !ref indices !oldadpdatum
    :mdsadp num $!ref $!oldadpdatum[$!ref]
    handle any
      skip
    endhandle
  enddo
$)

  -- Set Existing DATUM Atta attribute ':MDSCp1' at the New DATUM Atta
  :MDSCp1 '$!oldconfig'

  -- Reselect SREF Atta after the New DATUM Atta
  if (!xstr) then
    !!ce          = !sref
    !oldsrefdesp  = despar
    !oldsrefstyp  = !sref.styp
    unname
    !!ce = !newdatum
    new atta sel spref with styp '$!oldsrefstyp' spec /MDF
    handle any
      sel spref with styp '$!oldsrefstyp' spec /MDS
    endhandle
    SPKBRK TRUE
    !newsref = !!ce
    !!mdsSetIspe()
    !!mdssellstu(!!ce)
    !!mdsDacControl(true)
    name $!srefname
    -- Set Existing Despars at the New SREF Atta
    do !ind indices !oldsrefdesp
      despar num $!ind $!oldsrefdesp[$!ind]
      handle any
        skip
      endhandle
    enddo
    !!mdsMConn('ORI','ORI')
    handle any
      ori
    endhandle
    pos pa at $!newdatum

    -- Update Support Object and Delete the Existing SREF Atta
    !!ce = !sref
    !attanumber = !form.support.atta.findfirst(!sref)
    !form.support.atta.remove(!attanumber)
    delete atta
    -- Add New SREF Atta to the Support Object
    !form.support.atta.append(!newsref)
  endif

  -- Update Support Object relevant to the New DATUM Atta
  !form.support.datum  = !newdatum
  !!ce                 = !newdatum
  !form.support.padir  = pa dir wrt world
  !form.support.pldir  = pl dir wrt world
  !form.support.p9dir  = p9 dir wrt world
  !form.support.p10dir = p10 dir wrt world
  !form.support.p11dir = p11 dir wrt world

  -- Update Support Object Member '.packs' if New DATUM Atta had a Packing Piece-(NOT Allowed on a DATUM Atta)
  -- DELETE Packing Piece attached to the New DATUM Atta and UNSET attribute ':MDSPackRef' at the New DATUM Atta
  !!ce          = !newdatum
  if (!xstr) then
    if (!newdatum.:MDSPackRef.badref().not()) then
      !pack       = :MDSPackRef
      :MDSPackRef unset
      !!ce        = !pack
      delete sctn
      !packnumber = !form.support.packs.findfirst(!pack)
      !form.support.packs.remove(!packnumber)
      -- Move New DATUM Atta through Structure Origin
      !!ce = !newdatum
      plane $!form.support.pldir thro $!stru
    endif

    -- Update Support Object Member '.bars' if New DATUM Atta
    -- is on a Different Cross Bar to the Existing DATUM Atta
    do !findbar indices !form.support.bars
      !olddatumbar = !form.support.bars[!findbar].findfirst(!datum)
      if (!olddatumbar.unset().not()) then
        !oldbarnum = !findbar
        !oldbar    = !form.support.bars[!oldbarnum]
      endif
      !newdatumbar = !form.support.bars[!findbar].findfirst(!newdatum)
      if (!newdatumbar.unset().not()) then
        !newbarnum = !findbar
        !newbar    = !form.support.bars[!newbarnum]
      endif
    enddo

    !formname   = !form.name().lowcase()
    if !formname.upcase().neq('MDSSPECIAL') then
      -- Only Switch Support Object Member '.bars' indices if the Attas are on Different Cross Bars
      if (!oldbarnum neq !newbarnum) then
        !form.support.bars[!oldbarnum] = !newbar
        !form.support.bars[!newbarnum] = !oldbar
      endif
    endif
  endif

  -- Clear AID text from graphical view for this Support
  !!mdsClearTags()

  --  Now Re-Add AID text first to the New DATUM Atta and then All Other Attas on this Support
  !!mdsaidtext(!form)
  ----------------------------------------------
  -- Re Adjust the distance value for all the other ATTAS on the Support
  -- set in UDA :mdsnudgedist relevant to the NEW DATUM ATTA i.e (+ve or-ve)
  --
  -- Do this before regenerating the Structure if one exists, as the create
  -- functions adjust the Stru position by the value set against the uda
  -- :mdsnudgedist at the new DATUM ATTA
  !!ce = !newdatum
  !checknudge = object MDSCHECKDATUM()
  !checknudge.offset(!form.support)
  ----------------------------------------------

  -- ReGenerate Framework Structure Geometry using Existing
  -- Dimensions, around the NEW DATUM Atta Selected.
  !formname   = !form.name().lowcase()
  if (!xstr) then
    -- By pass if special
    if !formname.upcase().neq('MDSSPECIAL') then
      !formtype   = !!mdsaliaslist(!form.support.alias)
      !regenerate = 'call !!mdscreate' & !formtype.lowcase() & '(''DIMENSION'')'
      -- Only ReGenerate if Framework etc... has been Created
      if (!stru.mcount().neq(0)) then
        $!regenerate
      endif
    endif
  endif

  -- <tm> Aug 2003
  -- if the attas are associated with lugs then delete the existing lugs and rebuild them
  -- the only way that lugs are associated with an ancillary is by name
  !lugattas = ARRAY()
  do !a values !form.support.atta
    skip if !a.name.match('/SREF').gt(0)
    !!ce = !a
    var !olet coll all olet with match(name,'$!form.name') gt 0 for branch
    if !olet.size().gt(0) then
      !lugattas.append(!a)
      -- its possible to have two or more attas in the same branch within the same support
      do !b values !olet
        !!ce = !b.dbref()
        -- find out which atta the lug is attached to
        var !rule rule
        !refatta = !rule.after('OF').before(')').trim().dbref()
        handle ANY
        elsehandle NONE
          !lugattas.append(!refatta)
        endhandle
        delete olet
      enddo
    endif
  enddo

  -- remove duplicates
  !lugattas.unique()
  -- now loop round the attas and add the lugs
  do !a values !lugattas
    !!ce = !a
    !!mdsCreateLugs()
  enddo
  -- <tm> Aug 2003


  -- De-Activate and Activate Relevant buttons
  !form.datum.active  = false
  !form.newdat.active = true

  -- Reset Colours and Units
  unenhance $!newdatum
  enhance $!newdatum col $!enhancecol
  !!kRestoreUnits(!currentunits)
  !!mdsDacControl(false)
endfunction
-- End Function
