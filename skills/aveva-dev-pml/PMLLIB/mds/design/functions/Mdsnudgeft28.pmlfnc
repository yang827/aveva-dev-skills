--
-- File:  Mdsnudgeft28.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Thursday 13th November1997
--
--
-- Description:
--  Check Nudge Distance for Frame Type form 'FT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Framework Form
--     2     R         STRING      PLUS  - Along 'PL' Direction - Forwards
--                              or MINUS - Along 'PA' Direction - Backwards
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsnudgeft28(!form is FORM, !sign is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !support = !form.support
  !xdist   = !form.dist.val
  !desp3   = !form.desp3
  !nudge   = !form.nudge.val
  !sref    = !support.stru.name & '/SREF'

  ------------------------------------------------------------------------------
  ------------------------------------------------------------------------------

  -- Set if Plus or Minus Movement Direction
  if (!sign eq 'PLUS') then
    !oper = '+'
  elseif (!sign eq 'MINUS') then
    !oper = '-'
  endif

  -- Work out new distance from previous component
  !ndist  = !xdist $!oper !nudge

  ------------------------------------------------------------------------------
  ------------------------------------------------------------------------------

  -- Check if Framework 'Mirrored'
  if (!support.mirror) then
    if (!desp3.gt(0)) then
      !despx = !desp3 * -1
      !desp3 = !despx.real()
    endif
  else
    !desp3 = !desp3.real().abs()
  endif

  ------------------------------------------------------------------------------
  ------------------------------------------------------------------------------

  if ('$!sign' eq 'PLUS') then
    -- Update forms distance gadget and calculate desp3
    !form.dist.val = !ndist
    !dimension3    = !desp3 - !nudge
  elseif ('$!sign' eq 'MINUS') then
    -- Update forms distance gadget and calculate desp3
    !form.dist.val = !ndist
    !dimension3    = !desp3 + !nudge
  endif

  ------------------------------------------------------------------------------
  ------------------------------------------------------------------------------

  -- Run function to move support
  !!mdsposdist(!form)

  -- Update dimension Despar 3 for SREF atta (Stored in mm)
  !!ce = !sref.dbref()
  despar numb3 $!dimension3
  -- Update forms desp3 gadget
  !form.desp3    = !dimension3

  -- Navigate Back to Stru
  !!ce = !support.stru

  ------------------------------------------------------------------------------
  ------------------------------------------------------------------------------

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

endfunction
