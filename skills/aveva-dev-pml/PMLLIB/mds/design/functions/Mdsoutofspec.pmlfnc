--
-- File:                MdsOutOfSpec.pml
--   Type:              Process
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             20 Mar 1998
--
--
-- Description:
-- Function to load Mdstubesel with current piping spec available
-- for user to select trunnion tubing out of spec.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!MdsOutOfSpec(!Form is form, !Option is string)

--------------------------------------------------------------------------------
--
if (!form.name().lowcase() inset ('Mdsvt01','Mdsvt02')) then
  !AttaName    = '/' & !Form.Name.Val & '/DATUM'
else
  !AttaName    = '/' & !Form.Name.Val
endif

!Atta        = !AttaName.dbref()
--
--------------------------------------------------------------------------------

--!AttaName    = '/' & !Form.Name.Val

!origin = !!ce
!!ce    = !atta

--------------------------------------------------------------------------------

!BranSpc     = !Atta.Owner.Pspe
!!GlobalForm = !Form

if(!Option.eq('INSPEC')) then

  !!MdsSetTrnMatl(!Form,!Atta)

else

-- get all pipe specs

   !Worl  = object dbref()
   !Specs = !!kcollectAllFor('SPEC','purp eq |PIPE|',!Worl)

-- Remove the parent specification from the list

   !Specs.Remove(!Specs.FindFirst(!BranSpc))

   !Dtext = array()
   !Rtext = array()

-- Go to each spec and find the tube component

   !ce = !!ce

   do !FoundSpecs values !Specs

     !!ce = !FoundSpecs

     !mem = mcount
     do !count from 1 to !mem
       $!Count
       if !!CE.type.eq('SELE') then
         if !!CE.tans.eq('TUBE') then
-- Find all spcoms for the tube selector
           var !Spcoms coll all spcom for ce
-- Loop through spcoms and get the correct bore
           !Bore = pa bore of $!Atta
           do !GetBore values !Spcoms
             !!CE = !GetBore.dbref()
             !Params = para of catref
             if !Params[1].bore().eq(!Bore) then
                !Desc = rtext of detref
                !Matl = xtex of matxt
                !Dtext.append(!FoundSpecs.name & ' ' & !Desc & ' ' & !Matl)
             endif
           enddo
         endif
       endif
       spec
     enddo
   enddo

-- load the psecs into the form


       !!MdsTubeSel.Specs.clear()
       !!MdsTubeSel.Specs.clear()

       do !Ind indices !Specs
          -- !Dtext.append(!Specs[!Ind].Name)
          !Rtext.append(!Specs[!Ind].Name)
       enddo

       !!MdsTubeSel.Specs.Dtext = !Dtext
       !!MdsTubeSel.Specs.Rtext = !Rtext

-- set action for form

      !!MdsTubeSel.action.clear()
--xxx      !!MdsTubeSel.action[1] = |call !!MdsSetTrnMatl(!!GlobalForm,!!CE)|
      !!MdsTubeSel.action[1] = |call !!MdsSetTrnMatl(!!GlobalForm,$!atta)|
      !!MdsTubeSel.action[2] = ||

      !!KShowForm(!!MdsTubeSel)
endif

!!ce = !origin

endfunction

-- end function MdsOutOfSpec
