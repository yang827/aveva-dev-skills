if (|$1| eq |PROMPT| or |$1| eq ||) then
   $M/%PDMSUI%/CLIB/REP/RSELECT RUN $0  $<$!!<kmdbdir>/MDS-OAINDEX1-$!!<kdts>$> $<atta stru$> $<(match(name of spref,'/MDS') eq 1) or (SKEY eq 'BEDP')$> $< $> $<Off$> $<$> $<MDB$>
   return
endif
var !filename (trim(|$2|))
var !seltype (trim(|$3|))
var !selfilter (trim(|$4|))
var !selhierarchy (trim(|$5|))
var !selvolspec (trim(|$6|))
var !selvolume (trim(|$7|))
var !selfrom (trim(|$8|))
if(vtext(!seltype) eq ||) then
   var !criteria |ALL|
else
   var !criteria (|ALL (| + vtext(!seltype) + |)|)
endif
if(vtext(!selfilter) ne ||) then
   var !criteria (vtext(!criteria) + | WITH (| + vtext(!selfilter) + | )|)
endif
if(vtext(!selvolspec) eq |Completely Within...|) then
   var !criteria (vtext(!criteria) + | EXCL WITHIN | + vtext(!selvolume))
elseif(vtext(!selvolspec) eq |Partially Within...|) then
   var !criteria (vtext(!criteria) + | WITHIN | + vtext(!selvolume))
endif
if(vtext(!selhierarchy) ne ||) then
   var !criteria (vtext(!criteria) + | FOR | + vtext(!selhierarchy))
endif
if(vtext(!selfrom) eq |Drawlist|) then
   var !criteria (vtext(!criteria) + | FROM DRAWLIST|)
elseif(vtext(!selfrom) eq |Obstruction List|) then
   var !criteria (vtext(!criteria) + | FROM OBST|)
endif
!units = object COMUNITS(TRUE)
units mm bore units mm distance
var !date clock date
var !time clock time
if (vtext(!filename) ne ||) then
   openfile /$!filename write length 64 pagecount !pageno !output
   handle (41,324)
      confirm |OK to overwrite $!filename?|
      handle (61,115)
         !units.restoreSavedBoreDist()
         return error 1 'File $!filename exists. Use OVERWRITE mode to force write.'
      endhandle
      if(not $_CALERT_USERDATA) then
         !units.restoreSavedBoreDist()
         return
      endif
      openfile /$!filename overwrite length 64 pagecount !pageno !output
      handle any
         !units.restoreSavedBoreDist()
         return error 1 |Unable to open file $!filename|
      endhandle
   elsehandle any
      !units.restoreSavedBoreDist()
      return error 1 |Unable to open file $!filename|
   endhandle
   var !write |writefile $!output|
else
   var !isshown form _CADCBTH display
   handle any
   elsehandle none
      if(|$!isshown| eq |Off|) then
         show _CADCREQ
      endif
   endhandle
   var !write |write|
endif
onerror golabel /closefile
var !selection collect $!criteria
handle any
   if(vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error 1 |Selection is invalid
$!!ERROR.TEXT|
endhandle
var !selsize (arraysize(!selection))
onerror golabel /badeval
var !evalcol 1
var !col1 raw evaluate ((before(part(namn ,1,'/'),'/'))) for all from !selection count !selno$
 ignore any ||
var !evalcol 2
var !col2 raw evaluate ((after(namn of spref ,'MDS/'))) for all from !selection count !selno$
 ignore any ||
var !evalcol 3
---------------------------------
if (!!isImperialLength('BORE').not()) then
  var !col3 raw evaluate (string((p1 bore),'D0')) for all from !selection count !selno$
  ignore any |---|
else
  var !col3 raw evaluate (DIST (NOMBORE(false,p1 bore),false,true,true,8,true)) for all from !selection count !selno$
  ignore any |---|
endif
---------------------------------
var !evalcol 4
var !col4 raw evaluate ((replace(:MDSSuppDesc of detref,'!',' '))) for all from !selection count !selno$
 ignore any ||
var !evalcol 5
var !col5 raw evaluate (namn of owner of owner) for all from !selection count !selno$
 ignore any ||
var !evalcol 6
var !col6 raw evaluate (namn of pspe of owner of owner) for all from !selection count !selno$
 ignore any ||
var !evalcol 7
var !col7 raw evaluate (:MDSComment) for all from !selection count !selno$
 ignore any ||
onerror golabel /closefile
var !sortorder sort !col1 CIASCII ASCENDING $
 !col4 CIASCII ASCENDING $

var !maxwid[1] 0
var !maxwid[1] (max($!maxwid[1],(arraywidth(!col1))))
var !maxwid[2] 0
var !maxwid[2] (max($!maxwid[2],(arraywidth(!col2))))
var !maxwid[3] 0
var !maxwid[3] (max($!maxwid[3],(arraywidth(!col3))))
var !maxwid[4] 0
var !maxwid[4] (max($!maxwid[4],(arraywidth(!col4))))
var !maxwid[5] 0
var !maxwid[5] (max($!maxwid[5],(arraywidth(!col5))))
var !maxwid[6] 0
var !maxwid[6] (max($!maxwid[6],(arraywidth(!col6))))
var !maxwid[7] 0
var !maxwid[7] (max($!maxwid[7],(arraywidth(!col7))))
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------   Multi Discipline Support Overall Index   -----------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???-- Date & Time of Report : $!!<kdts> --')
$!write ('???----------------------------------------------------------')
$!write ('???----------------------------------------------------------')
var !maxwid[1] (max($!maxwid[1],4))
var !maxwid[2] (max($!maxwid[2],8))
var !maxwid[3] (max($!maxwid[3],9))
var !maxwid[4] (max($!maxwid[4],11))
var !maxwid[5] (max($!maxwid[5],11))
var !maxwid[6] (max($!maxwid[6],5))
var !maxwid[7] (max($!maxwid[7],7))
-- $P***********************************
-- q var !maxwid[1] (max($!maxwid[1],4))
-- q var !maxwid[2] (max($!maxwid[2],8))
-- q var !maxwid[3] (max($!maxwid[3],9))
-- q var !maxwid[4] (max($!maxwid[4],11))
-- q var !maxwid[5] (max($!maxwid[5],11))
-- q var !maxwid[6] (max($!maxwid[6],5))
-- q var !maxwid[7] (max($!maxwid[7],7))

!!kcol1 = 2
!!kcol2 = !!kcol1 + !maxwid[1].real() + 2
!!kcol3 = !!kcol2 + !maxwid[2].real() + 2
!!kcol4 = !!kcol3 + !maxwid[3].real() + 2
!!kcol5 = !!kcol4 + !maxwid[4].real() + 2
!!kcol6 = !!kcol5 + !maxwid[5].real() + 2
!!kcol7 = !!kcol6 + !maxwid[6].real() + 2

-- q var !!kcol1 !!kcol2 !!kcol3 !!kcol4 !!kcol5 !!kcol6 !!kcol7
-- $P***********************************
var !headings compose $
spa 2 |
Name
----| wid $!maxwid[1] L $
spa 2 |
Standard
--------| wid $!maxwid[2] L $
spa 2 |
Line Size
---------| wid $!maxwid[3] R $
spa 2 |
Description
-----------| wid $!maxwid[4] L $
spa 2 |
Line Number
-----------| wid $!maxwid[5] L $
spa 2 |
Spec.
-----| wid $!maxwid[6] L $
spa 2 |
Comment
-------| wid $!maxwid[7] L $

do !line values !headings
   $!write |$!line|
enddo
if (vtext(!filename) ne ||) then
   do !line values !headings
      fileheader $!output add |$!line|
   enddo
endif
do !i indexes !sortorder
   var !index $!sortorder[$!i]
   var !lines compose $
      spa 2 (vtext(!col1,$!index)) wid $!maxwid[1] L $
      spa 2 (vtext(!col2,$!index)) wid $!maxwid[2] L $
      spa 2 (vtext(!col3,$!index)) wid $!maxwid[3] R $
      spa 2 (vtext(!col4,$!index)) wid $!maxwid[4] L $
      spa 2 (vtext(!col5,$!index)) wid $!maxwid[5] L $
      spa 2 (vtext(!col6,$!index)) wid $!maxwid[6] L $
      spa 2 (vtext(!col7,$!index)) wid $!maxwid[7] L $

   do !line values !lines
      $!write |$!line|
   enddo
enddo
if (vtext(!filename) ne ||) then
   fileheader $!output clear
endif
$!write ('???')
$!write ('???-------------------')
$!write ('???-------------------')
$!write ('???-- End of Report --')
$!write ('???-------------------')
$!write ('???-------------------')
$!write ('???')
if (vtext(!filename) ne ||) then
   closefile $!output
endif
onerror golabel /restoreunits
!units.restoreSavedBoreDist()
return
label /badeval
handle any
   if(vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error 2 |Unable to evaluate expression for column $!evalcol
$!!ERROR.TEXT|
endhandle
label /closefile
handle any
   if (vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error
endhandle
label /restoreunits
handle any
   !units.restoreSavedBoreDist()
   return error
endhandle
