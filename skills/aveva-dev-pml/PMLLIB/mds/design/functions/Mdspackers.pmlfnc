--
-- File:		Mdspackers.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 27th November 1997
--
--
-- Description:
-- Store Packing Piece and Associated Atta data prior to modification
-- of Structural members deleted each time the framework is recreated
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R      MdsSUPPORT    Form Support Object
-- Return:
--    [Data Type]    [Description]
--     ARRAY          Stores Atta Names with Associated Packing Piece Names and
--                    Packing Piece Type (wdesp2) and Size (desp3)
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdspackers(!frame is MdsSUPPORT) is ARRAY

-- Initialise variables
    !support = !frame
    !atta    = !support.atta
    !name    = !support.stru.name
    !attapp  = array()

-- Set Attas with Packing Pieces into an ARRAY using PDMS Names ONLY
    do !data values !atta
      !!ce = !data

      if (!data.:MDSPackRef.badref().not()) then
        !attapp.append(!data.name)
        !attapp.append(!data.:MDSPackRef.name)
        !desp2 = !data.:MDSPackRef.wdesp[2]
        !desp3 = !data.:MDSPackRef.desp[3]
        !attapp.append(!desp2)
        !attapp.append(!desp3)

-- Get Correct Cross Bar for each Atta is Associated
-- with on the Current Framework

        if (!support.bars.size() leq 1)then
          !xbar = '$!name' & '-BAR-1'
          !attapp.append(!xbar)
        else
          do !index index !support.bars
            !xbar  = '$!name' & '-BAR-$!index'

            do !refe index !support.bars[!index]
              if (!support.bars[!index][!refe] eq !data) then
                !attapp.append(!xbar)
              endif
            enddo

          enddo
        endif

      endif
    enddo

-- Return ARRAY of data
    return !attapp

-- End function
  endfunction

-- End of file Mdspackers.pml
