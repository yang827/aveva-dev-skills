--
-- File:		Mdsparaobj.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Thu 9 Oct
--
--
-- Description:
-- gets name of object to be used to store parameter data for passed support type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type] [Description]
--     1     R        String      Support type to search for in !!MdsParaTab array
-- Return:
--    [Data Type]   [Description]
--     STRING        Name of object type to be used for this support type
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsParaObj(!SupType is STRING, !ObjectType is STRING, !ReadFunc is STRING, !SetFunc is STRING) is BOOLEAN

  -- Initialise Variables

  -- search for support type in !!MdsParaTab array
  -- defined in data file Mdsparatab.pmldat
  do !Element values !!MdsParaTab
    !Type     = !Element[1]
    !Object   = !Element[2]
    !RFunc    = !Element[3]
    !SFunc    = !Element[4]
    if (!Type eq !SupType) then
       !ObjectType = !Object
       !ReadFunc   = !RFunc
       !SetFunc    = !SFunc
      return TRUE
    endif
  enddo

  return FALSE

-- End function
endfunction

-- End of file Mdsparaobj.pml
