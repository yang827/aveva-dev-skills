--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--    [DBREF]       [Joint picked]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPickJoint() is dbref


-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

-- identify upright or joint

label /repick

      prompt off
      prompt load escape 'Identify Section End Connected or Connection Joint.'
      var !Pick PICK
        handle (61,528)
          prompt on
          return
        endhandle
      prompt on

     !PickedItem = !Pick[1].dbref()
     !PickLine   = !Pick[2]

if(!PickedItem.Type.neq('SCTN') and !PickedItem.Type.neq('SJOI')) then
      prompt off
      prompt load escape 'Invalid type picked.'
      handle any
       prompt on
       return
      endhandle

      golabel /repick
endif

-- Picked item is SCTN goto nearest end and the joint of that end

   if(!PickedItem.Type.eq('SCTN')) then
   -- calculate nearest end
        !Poss = poss of $!PickedItem wrt worl
        !Pose = pose of $!PickedItem wrt worl
        var !Sctnline const line join $!poss to $!pose
        var !inter const pos inter $!Sctnline $!Pick[2]
        !DistEnd = !!KstrReal('Const dist $!inter to $!Pose')
        !DistStt = !!KstrReal('Const dist $!inter to $!Poss')
         if(!DistEnd.lt(!DistStt)) then
          -- start is the pick goto the joint
             !Joint = !PickedItem.joie
               if(!Joint.unset()) then
                     prompt off
                     prompt load escape 'Section end selected is not connected.'
                        handle any
                          prompt on
                          return
                        endhandle

                     golabel /repick
               endif
         else
             !Joint = !PickedItem.jois
               if(!Joint.unset()) then
                     prompt off
                     prompt load escape 'Section end selected is not connected.'
                        handle any
                          prompt on
                          return
                        endhandle

                     golabel /repick
               endif
         endif
        !!MdsJointSpec.Jlist.Select('RTEXT',!Joint.string())
           handle any
                     prompt off
                     prompt load escape 'Joint selected is not part of the current support'
                        handle any
                          prompt on
                          return
                        endhandle

                     golabel /repick
           endhandle
        !!MdsIJointSpec(_Jlist)
        handle any
         -- dont do this when force connect uses this function
        endhandle
   elseif(!PickedItem.Type.eq('SJOI')) then
        !Joint = !PickedITem
        !!MdsJointSpec.Jlist.Select('RTEXT',!PickedItem.string())

           handle any
                     prompt off
                     prompt load escape 'Joint selected is not part of the current support'
                        handle any
                          prompt on
                          return
                        endhandle

                     golabel /repick
           endhandle
        !!MdsIJointSpec(_Jlist)
        handle any
         -- dont do this when force connect uses this function
        endhandle
   endif



-- Reset Units

   !!kRestoreUnits(!currentunits)

-- return joint for pline picking function in selectjoints.pml

   Return !Joint


-- End function
endfunction

-- End of file MdspickJoint.pml
