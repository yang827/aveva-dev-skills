--
-- File:		Mdsplusdonly.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Aug 07
--
--
-- Description:
-- facility to nudge pipe support forward along the path of the pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPlusDonly(!Form is FORM)

  -- Initialise variables
    !Support = !Form.Support
    !CurrentDist = !Form.Dist.val
    !NudgeDist   = !Form.Nudge.val

  -- Check that framework has been created
    if (!Support.Atta.Size() eq 0)then
      !!Alert.error('Create support before nudging.')
      return
    endif

  -- If value set to 0 return
    if (!NudgeDist eq 0) then
      return
    endif

  -- Work out new distance from previous component
    !Distance = !CurrentDist + !NudgeDist

  -- Update forms distance gadget
    !Form.Dist.val = !Distance

  -- Run function to move support
    !!MdsPosDonly(!Form)

-- End function
endfunction

-- End of file Mdsplusdonly.pml
