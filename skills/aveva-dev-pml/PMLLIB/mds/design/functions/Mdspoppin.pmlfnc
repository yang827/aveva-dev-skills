--
-- File:    Mdspoppin.pml
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.Boudjnah
-- Created:   Wed Mar 13 2002
--
--
-- Description:
-- RESTORES the ppoint position, direction and status(On/Off)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Real         PPoint number to be RESTORED
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdspoppin(!ppointNo is Real)
   if(not defined(!!pinsArray)) then
     -- No pins have been saved yet
     -- Do nothing
     return
   endif
   !pinStack = !!pinsArray[!ppointNo]
   !pinString = !pinStack.removelast()
   handle any
     -- stack is empty
     return
   endhandle
   !!pinsArray[!ppointNo] = !pinStack
   !pinData = !pinString.split('\')
   if(!pinData[1].neq('')) then
     pin$!ppointNo at $!pinData[1] wrt /*
   endif
   if(!pinData[2].neq('')) then
      pin$!ppointNo dir $!pinData[2] wrt /*
   endif
   -- turns pin ON/OFF
   if(!pinData[3].upcase() eq 'OFF') then
      pin$!ppointNo off
   endif
-- End function
endfunction

-- End of file Mdspoppin.pml
