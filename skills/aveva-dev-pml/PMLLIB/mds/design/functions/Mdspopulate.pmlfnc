--
-- File:  Mdspopulate.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Mon Dec 08
--
--
-- Description:
-- function to populate the list gadgets of the main form types
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form
--     2     R        STRING        Keyword for form
--                                  GENERAL = !!mdsGENERAL
--                                  HVAC    = !!mdsHVAC
--                                  FIXED HANGER  = !!mdsFHANGER
--                                  VARIABLE HANGER  = !!mdsVHANGER
--                                  SLIP    = !!mdsSLIP
--                                  TRIM    = !!mdsTRIM
--                                  TRUNN   = !!mdsTRUNN
--                                  FRAME   = !!mdsFRAME
--                                  CABLE   = !!mdsCABLE
--                                  ANCHOR  = !!mdsANCHOR
--                                  GUIDE   = !!mdsGUIDE
--                                  SLIDE   = !!mdsSLIDE
--                                  SPECIAL = !!mdsSPECIAL
--                                  SPRING  = !!mdsSPRING
--                                  VESS    = !!mdsVESS
--                                  BRANREIN = !!mdsBranRein
--                                  OPTIONS = !!mdsOPTIONS
--<dw>28feb2008dun858>
--                                  BRACING = !!mdsaddbracing
--<dw>28feb2008dun858>
--
--<wd>02nov2006mds12>
---------------------------------------------------------------------------------------------------
-- Load the MAIN MDS DESIGN Application FORMS with the MDS SUPPORT TYPES from the appropriate MDS
-- DEFAULTS CATALOGUES in found in the PARAGON database containing the MDS Defaults DATA elements
---------------------------------------------------------------------------------------------------
--<01> -- !!mdsALLANCILL  -- AN AT BT CA GT LT PIPE/RACK-REST ST SU -- loaded via !!mdsiallancill()
--<02> -- !!mdsANCHOR     -- AN -- loaded via !!mdsianchor() from !!mdspopulate(!form,!array)
--<03> -- !!mdsBranRein   -- BR -- loaded via !!mdsibranrein() from !!mdspopulate(!form,!array)
--<04> -- !!mdsCABLE      -- CT FR -- loaded via !!mdsicable() from !!mdspopulate(!form,!array)
--<05> -- !!mdsFHANGER    -- FH -- loaded via !!mdsifhanger() from !!mdspopulate(!form,!array)
--<06> -- !!mdsFRAME      -- FT -- loaded via !!mdsiframe() from !!mdspopulate(!form,!array)
--<07> -- !!mdsGENERAL    -- AT BT CA LT PIPE/RACK-REST -- loaded via !!mdsigeneral() from !!mdspopulate(!form,!array)
--<08> -- !!mdsGUIDE      -- GT ST -- loaded via !!mdsiguide() from !!mdspopulate(!form,!array)
--<09> -- !!mdsHVAC       -- DT -- loaded via !!mdsihvac() from !!mdspopulate(!form,!array)
--<10> -- !!mdsPRELIMSUPP -- PR -- loaded via !!mdsprelim.init() from !!mdspopulate(!form,!array)
--<11> -- !!mdsSLIP       -- SU -- loaded via !!mdsislip() from !!mdspopulate(!form,!array)
--<12> -- !!mdsSPRING     -- SP -- loaded via !!mdsispring() from !!mdspopulate(!form,!array)
--<13> -- !!mdsTRUNN      -- TT -- loaded via !!mdsitrunn() from !!mdspopulate(!form,!array)
--<14> -- !!mdsVESS       -- VT -- loaded via !!mdsivess() from !!mdspopulate(!form,!array)
--<15> -- !!mdsVHANGER    -- VH -- loaded via !!mdsivhanger() from !!mdspopulate(!form,!array)
--<dw>28feb2008dun858>
--<15> -- !!mdsaddbracing -- FB -- loaded via !!mdsaddbracing() from !!mdspopulate(!form,!array)
--<dw>28feb2008dun858>
---------------------------------------------------------------------------------------------------
--<wd>02nov2006mds12>
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdspopulate(!form is FORM,!keyword is STRING )

  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --  if !form.string().upcase().neq('MDSFHANGER') and !form.string().upcase().neq('MDSVHANGER') then
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK ---- If form already populated then return
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --    !testIfFilled = !form.standard.dtext[1]
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --    handle none
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --      return
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --    elsehandle any
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --    endhandle
  --<wd>apr2007 CODE REMOVED to allow MDS DEFAULTS RELOAD to WORK --  endif

  -- Populate Form
  !pref = ARRAY()
  if (!keyword eq 'GENERAL') then
    !pref.append('AT')
    !pref.append('BT')
    !pref.append('LT')
    !pref.append('PIPE-REST')
    !pref.append('RACK-REST')
    !pref.append('CA')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/ATTA/DEFAULTS

  elseif (!keyword eq 'HVAC') then
    !pref.append('DT')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/STRUCTURE/DEFAULTS

  elseif (!keyword eq 'FIXED HANGER') then
    !pref.append('FH')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/HANGER/DEFAULTS

  elseif (!keyword eq 'VARIABLE HANGER') then
    !pref.append('VH')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/HANGER/DEFAULTS

    --<wd>02nov2006<mds12>
    --   elseif (!keyword eq 'HANGER') then
    --     !pref.append('HT')
    --<wd>02nov2006<mds12>

  elseif (!keyword eq 'SLIP') then
    !pref.append('SU')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/ATTA/DEFAULTS

    --<wd>02nov2006<mds12>
    --   elseif (!keyword eq 'TRIM') then
    --     -- $p unsure of prefix for trim steel
    --<wd>02nov2006<mds12>

  elseif (!keyword eq 'TRUNN') then
    !pref.append('TT')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/TRUNNION/DEFAULTS

  elseif (!keyword eq 'FRAME') then
    !pref.append('FT')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/STRUCTURE/DEFAULTS

    --<dw28feb2008dun858>
  elseif (!keyword eq 'BRACING') then
    !pref.append('FB')
    --<dw>28feb2008dun858>
    --<wd>02nov2006mds12>
    !mdscata = /MDS/STRUCTURE/DEFAULTS

  elseif (!keyword eq 'CABLE') then
    !pref.append('CT')
    !pref.append('FR')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/STRUCTURE/DEFAULTS

  elseif (!keyword eq 'ANCHOR') then
    !pref.append('AN')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/ATTA/DEFAULTS

  elseif (!keyword eq 'GUIDE') then
    !pref.append('GT')
    !pref.append('ST')
    --<wd>02nov2006mds12>
    --     !mdscata = /MDS/ATTA/DEFAULTS
    !mdscata = ARRAY()
    !mdscata.append(/MDS/ATTA/DEFAULTS )
    !mdscata.append(/MDS/STRUCTURE/DEFAULTS )
    --q var !mdscata
    --<wd>02nov2006<mds12>
    --   elseif (!keyword eq 'SLIDE') then
    --     -- $p Unsure of prefix for slide
    --
    --   elseif (!keyword eq 'SPECIAL') then
    --    -- $p Unsure of prefix for special
    --<wd>02nov2006<mds12>

    --<wd>mar2006<mds12>
  elseif (!keyword eq 'SPRING') then
    !pref.append('SP')
    --<wd>mar2006<mds12>
    !mdscata = /MDS/ATTA/DEFAULTS

  elseif (!keyword eq 'VESS') then
    !pref.append('VT')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/STRUCTURE/DEFAULTS

  elseif (!keyword eq 'BRANREIN') then
    !pref.append('BR')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/ATTA/DEFAULTS

    --<wd>mar2006<mds12>
    -->   elseif (!keyword eq 'OPTIONS') then
    -->     !pref.append('MDS')
    --<wd>mar2006<mds12>

  elseif (!keyword eq 'PRELIMSUPP') then
    !pref.append('PR')
    --<wd>02nov2006mds12>
    !mdscata = /MDS/PRELIMINARY/DEFAULTS

  endif
  --q var !pref


  ---------------------------------------------------------------------------------------------------
  --<wd>02nov2006<mds12>
  -- Determine the MDS SUPPORT TYPES where :MDSACTIVE is TRUE for each SECTION element in the appropriate PARAGON MDS DEFAULTS Catalogues
  !mdsstds = ARRAY()
  do !valp values !pref
    !mdsty = !valp & '*'
    !ctype = |SECTION|
    !scope = !mdscata
    !filtr = object EXPRESSION(|:mdsactive eq TRUE and matchwild(description, '$!<mdsty>') | )

    -- Collect ALL of the SECTION Elements
    !sect  = object COLLECTION()
    !sect.filter(!filtr)
    !sect.scope(!scope)
    !sect.type(!ctype)
    -- SECTION Collection Results Array
    !sectresults = !sect.results()

    -- Determine the MDS Support types to LOAD into the FORM !form
    do !vald value !sectresults
      if (!vald.description.unset()) or (!vald.description.trim().eq('')) then
        skip
      else

        --<wd>jan2007<mds12>
        -- For MDS SPRINGS ('SP*'), ONLY LOAD the 'SP03' CONSTANT SPRING and Do NOT LOAD the suffix versions,
        -- i.e. 'SP03A' etc..., into the FORM !!mdsSPRING
        --         !mdsstds.append(!vald)
        if (!vald.description.upcase() inset ('SP03A', 'SP03B', 'SP03C', 'SP03D', 'SP03E', 'SP03F', 'SP03G')) then
          skip
        else

          --do not populate lists with any deprecated standards
          !name = !vald.flnm
          !ownerName = !vald.owner.flnm + '/'
          !standard = !name.after(!ownerName)
          if (!standard inset('FT20','FT26','FT27')) then
            skip
          elseif (!standard inset('GT20','GT21')) then
            skip
          elseif (!standard inset('ST20')) then
            skip
          else
            !mdsstds.append(!vald)
          endif
        endif
        --<wd>jan2007<mds12>

      endif
    enddo
  enddo
  -- Remove ANY Duplicate Entries in the ARRAY
  !mdsstds.unique()

  -- SORT ARRAY into ALPHABETICAL and NUMBER order
  !sindices = !mdsstds.sortedindices()
  !mdsstds.reindex(!sindices)

  -- Temporary Testing Variable ONLY
  !!wfdx = !mdsstds

  -- Load the form list gadget "!form.standard" with the ACTIVE MDS SUPPORT types
  -- ABORT MDS Application and FORM list gadget LOADING if the ARRAY !mdsstds is EMPTY
  if (!mdsstds.empty()) then
    -- ???ABORT MDS Loading??? - Default ERROR and Message set in loading of the FORM !form
    return
  else
    !!mdssupptypes = object MDSLOADSTDDEFS(!form, !mdsstds)
    if (!form.error) then
      -- ABORT MDS loading with Default ERROR and Message set in loading of the FORM !form
      return
    endif

  endif

endfunction
