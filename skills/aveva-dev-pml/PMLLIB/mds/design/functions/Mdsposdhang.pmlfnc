--
--
-- Description:
-- function to position hangnion on tube
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPosDhang(!Form is FORM)

-- Initialise variables
  !Datum = !Form.Support.Datum

  !Origin = !!CE

-- Check that Datum atta has been created
  if (!Datum.set().not())then
    !!Alert.message('Support atta has not been created')
    return
  endif

  !!CE = !Datum

-- Goto connected element

  bran
  goto href
  pin 9 copy pl of prev
  pin 9 dist $!Form.dist.val
  drag move thro pin 9
  !Pos = !!ce.position

-- $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

-- Reset Pins
  Call !!MdsResetPins(9,9)

  !!CE = !Origin

  $P xxxxx

-- End function
endfunction

-- End of file Mdsposdhang.pml
