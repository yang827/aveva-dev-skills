--
-- File:		Mdsposdonly.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- function to position support (atta only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPosDOnly(!Form is FORM)

  -- Initialise variables
    !Datum = !Form.Support.Datum

    !Origin = !!CE

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Support atta has not been created')
      return
    endif

    !!CE = !Datum

  -- Get plane direction to move
    !Pldir = PL DIR of $!Datum wrt world

  -- Plane direction is nearest value to 1
    !Up = (abs(!Pldir.up))
    !East = (abs(!Pldir.East))
    !North = (abs(!Pldir.North))
    !Max = max((abs(!Up)), (abs(!East)), (abs(!North)))
    if (!Max eq !Up)then
      !PlaneDir = U wrt world
    elseif (!Max eq !East)then
      !PlaneDir = E wrt world
    else
      !PlaneDir = N wrt world
    endif

  -- Set form data to say that the support has been positioned
    !Form.Support.Position = true

    PIN 9 AT CE
    VAR !PREPOS POS WRT WORLD

    !!MdsDacControl(true)

    Dist $!Form.Dist.Val from prev
      handle (2,113) $* List Exhausted ie. At Branch Head/Tail
        Dist $!Form.Dist.Val
      endhandle

--<wd>nov2000
    if (!datum.:MDSGuideRef.badref().not()) then
      if (!datum.:MDSGuideRef.unset().not()) then
        !!ce = !datum.:MDSGuideRef
        handle any
        endhandle
        plane $!pldir thro $!datum
        !!ce = !datum
      endif
    endif
--<wd>nov2000

    PIN 8 AT CE

-- Add Marker Text
    !!Mdsaidtext(!form)
--    VAR !POS POS WRT WORLD
--    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

  -- Reset Pins
    Call !!MdsResetPins(8,9)

    !!MdsDacControl(false)

    !!CE = !Origin

-- End function
endfunction

-- End of file Mdsposdonly.pml
