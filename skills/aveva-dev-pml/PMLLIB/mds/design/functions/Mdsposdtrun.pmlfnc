--
-- File:		Mdsposdtrun.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- function to position trunnion on tube
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPosDtrun(!Form is FORM)

  -- Initialise variables
    !Datum = !Form.Support.Datum

    !Origin = !!CE

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Support atta has not been created')
      return
    endif

    !!CE = !Datum

  -- Goto connected element
    bran
    goto href
    pin 9 copy pl of prev
      handle any
        pin 9 copy ph
      elsehandle none
        pin 9 through prev
      endhandle
    pin 9 dist $!Form.dist.val

  -- If it does not need moving don't
    var !pin9pos pin 9 pos wrt /*
    !Pos = !!ce.position
    if !pin9pos.position().eq(!Pos) then
      call !!MdsResetPins(9,9)
      return
    endif

--------------------------------------------------------------------------------------------------------
-->>>-<wd>nov2002

-- Get plane direction to move
    !cecomp = !!ce
    !Pldir  = PL DIR of $!!CE wrt /*

-- Plane direction is nearest value to 1
    !Up = (abs(!Pldir.up))
    !East = (abs(!Pldir.East))
    !North = (abs(!Pldir.North))
    !Max = max((abs(!Up)), (abs(!East)), (abs(!North)))
    if (!Max eq !Up)then
      !PlaneDir = U wrt /*
    elseif (!Max eq !East)then
      !PlaneDir = E wrt /*
    else
      !PlaneDir = N wrt /*
    endif

-- Position Pin 10 and Initialise variables for !!mdscheckthro function
    pin 10 copy pin 9
    pin 10 dir $!planedir
    var !pin10pos pin 10 pos wrt /*
    !pospin10 = !pin10pos.position()
    !idcomp = !pospin10
    !!ce    = !cecomp

-- Check to see if the element is to be moved within the current tube limits
    if (!!mdscheckthro(!form, !cecomp, !idcomp, !planedir).not()) then
      !!ce = !datum
      branch
      goto href
--<wd>apr2003
--      var !dist const dist p0 to pl of prev
--<wd>apr2003
      var !dist const dist p0 to p0 of prev
        handle (2,113)
          var !dist const dist p0 to ph
        endhandle
      !Form.dist.val = $!Dist
      !!mdsdaccontrol(false)
      return
    else
       pin 9 copy pin 10
    endif

$(
-- Check to see if the element is to be moved within the current tube limits
    if !!MdsCheckWithin(!Pin9Pos.position().not() then
      !!ce = !datum
      branch
      goto href
      var !dist const dist p0 to pl of prev
        handle (2,113)
          var !dist const dist p0 to ph
        endhandle
      !Form.dist.val = $!Dist
      return
    endif
$)
--<<<-<wd>nov2002
--------------------------------------------------------------------------------------------------------

    !!MdsDacControl(true)

    drag move thro pin 9
      handle (2,18)
        !!MdsResetPins(9,9)
        !!Alert.Error(!!Error.text)
        return
      elsehandle any
        !!MdsResetPins(9,9)
        !!Alert.Error('The NEW position of the trunnion cannot be completed as it may effect the pipe layout')
        return
      endhandle

    !!MdsDacControl(false)

    !Pos = !!ce.position
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!POS$>
--------------------------------------------------------------------------------
      !!ce = !datum
      !pos = !!ce.position.wrt(/* )
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>
-- Add marker text markers
      !!ce = !datum
      !name = !datum.name
      do !count from 212 to 259
        var !num ($!count - 211)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle any
          break
        endhandle
        !pos = !!ce.position.wrt(/* )
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

---------------------------------------------------------------------------------------



  -- Reset Pins
    call !!MdsResetPins(8,10)

    !!CE = !Origin

-- End function
endfunction

-- End of file Mdsposdtrun.pml
