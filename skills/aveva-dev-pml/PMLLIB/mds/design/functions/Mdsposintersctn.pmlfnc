--
-- Author:		Andrew Kirkland
-- Created:		Thu 11th June 1998
--
--
-- Description:
-- Function to find position of intersection of two Beams passed.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Sctn to connect to]
--     2     R        DBREF        [Support vertical to connect]
-- Return:
--    [Data Type]   [Description]
--      POSITION    [Returns position of intersection between the sctns passed]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPosInterSctn(!MainStl is dbref, !Upright is dbref) is position

-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

    !Refe = !!Ce

    !!CE = !MainStl

-- const line of sctn to calc pos intersection

    !poss = poss wrt worl
    !pose = pose wrt worl

    var !s1line const line join $!poss to $!pose

    !!CE = !Upright
    !poss = poss wrt worl
    !pose = pose wrt worl

    var !s2line const line join $!poss to $!pose

    var !s1pos const pos inter $!s1line $!s2line

-- Convert to position object

   !Pos = !s1pos.position().wrt(/* )

   !!CE = !Refe
-- Reset Units

   !!kRestoreUnits(!currentunits)

Return !pos

-- End function
endfunction

-- End of file MdsPosInterSctn.pml
