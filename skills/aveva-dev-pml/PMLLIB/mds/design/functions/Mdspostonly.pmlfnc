--
-- File:		Mdspostonly.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue 28 Oct
--
--
-- Description:
-- function to position support (atta only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsPosTOnly(!Form is FORM)

  -- Initialise variables
    !Selection = !Form.Select.Selection('Rtext')
    !Datum     = !Form.Support.Datum
    !Origin = !!CE

  -- Check that Datum atta has been created
    if (!Datum.set().not())then
      !!Alert.message('Support atta has not been created')
      return
    endif

    !!CE = !Datum

  -- Get plane direction to move
    !Pldir = PL DIR of $!Datum wrt world

  -- Plane direction is nearest value to 1
    !Up = (abs(!Pldir.up))
    !East = (abs(!Pldir.East))
    !North = (abs(!Pldir.North))
    !Max = max((abs(!Up)), (abs(!East)), (abs(!North)))
    if (!Max eq !Up)then
      !PlaneDir = U wrt world
    elseif (!Max eq !East)then
      !PlaneDir = E wrt world
    else
      !PlaneDir = N wrt world
    endif

    VAR !Mode MODE

    PIN 9 AT CE
    PIN 9 OFF

    !!MdsDacControl(true)

    if (!Selection eq |NAME|)then

       VAR !Nameoref (SUBSTRING(|$_CDNNAME_NAME|,1,1))
       if (!Nameoref eq |=|)then
         PLANE $!PlaneDir THRO $_CDNNAME_NAME
       else
         PLANE $!PlaneDir THRO $_CDNNAME_NAME
           handle (2,109)
             !!MdsDacControl(false)
             PLANE $!PlaneDir THRO /$_CDNNAME_NAME
           endhandle
       endif

    elseif (!Selection eq |COORD|)then

       PLANE $!PlaneDir THRO $!Form.P.Val

    elseif (!Selection eq |PIN|)then

       PLANE $!PlaneDir THRO PIN $!Form.P.Val

    elseif (!Selection eq |PLANE|)then
       if (!Form.p.val eq '')then
         !!MdsDacControl(false)
         !!Alert.error('Create Plane first')
         return
       endif
       if (Match(!Form.P.Val, 'CURSOR') gt 0)then
         !Direction = before(!Form.P.Val, ' THRO')
         PLANE $!Direction THRO @
       else
         PLANE $!Form.P.Val
       endif

    elseif (!Selection eq |CUR|)then

       PLANE $!PlaneDir THRO @
       handle (61,528)
         !!MdsDacControl(false)
          return
       endhandle

    elseif (!Selection eq |IDCUR|)then

       PLANE $!PlaneDir THRO ID@
       handle (61,528)
         !!MdsDacControl(false)
          return
       endhandle

    elseif (!Selection eq |IDP|)then

       PLANE $!PlaneDir THRO IDP@
       handle (61,528)
         !!MdsDacControl(false)
          return
       endhandle

    elseif (!Selection eq |NEXT|)then

       THRO NEXT
       handle (41,66) (2,113) (2,113)
          if (!Mode eq |Forwards|)then
             THRO PT
          else
             THRO PH
          endif
       endhandle

    elseif (!Selection eq |TAIL|)then

       THRO PT

    elseif (!Selection eq |PREV|)then

       THRO PREV
       handle (41,66) (2,113) (2,113)
          if (!Mode eq |Forwards|)then
             THRO PH
          else
             THRO PT
          endif
       endhandle

    elseif (!Selection eq |HEAD|)then

       THRO PH

    elseif (!Selection eq |CE|)then

       PLANE $!PlaneDir THRO $!Origin

    elseif (!Selection eq |PLINE START|)then

       PLANE $!PlaneDir THRO IDPLINE @ START
         handle (61,528)
           !!MdsDacControl(false)
           return
         endhandle

    elseif (!Selection eq |PLINE END|)then

       PLANE $!PlaneDir THRO IDPLINE @ END
         handle (61,528)
           !!MdsDacControl(false)
           return
         endhandle

    elseif (!Selection eq |BMA|)then

       var !Pick PICK PLINE WITH (PURP eq 'B')
         handle (61,528)
           !!MdsDacControl(false)
           return
         endhandle
       PLANE $!PlaneDir thro $!Pick[1] start

    endif

  -- Set form data to say that the support has been positioned
    !Form.Support.Position = true

    !!CE = !Datum

    PIN 8 AT CE


--<wd>nov2000
    if (!datum.:MDSGuideRef.badref().not()) then
      if (!datum.:MDSGuideRef.unset().not()) then
        !!ce = !datum.:MDSGuideRef
        handle any
        endhandle
        plane $!pldir thro $!datum
        !!ce = !datum
      endif
    endif
--<wd>nov2000

  -- Set distance gadget on form
    Call !!MdsDistance(!Form)

-- Add Marker Text to P9 of All Associated Attas
    !!Mdsaidtext(!form)

    !!CE = !Origin

    !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdspostonly.pml
