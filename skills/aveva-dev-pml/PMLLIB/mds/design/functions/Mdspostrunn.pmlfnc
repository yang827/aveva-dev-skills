--
-- File: Mdspostrunn.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Monday 16th February 1998
--
--
-- Description:
-- Function to Position a Trunnion atta component ONTO a Steel Section
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--     2     R         STRING       ONTOP - Position Trunnion ABOVE Identified Section
--                             or   UNDER - Position Trunnion BELOW Identified Section
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdspostrunn(!form is FORM, !mode is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !support   = !form.support
  !datum     = !support.datum
  !clear     = !form.clear.val

  -- Identify Steel Section
  label /section

  prompt dismiss
  prompt 'Identify Steel Section to move Trunnion onto...'
  --<wd>17jan2008 -- Defect No. P-4407
  --     id SCTN @
  ID SCTN HSTIFF @
  --<wd>17jan2008 -- Defect No. P-4407
  handle (61,528)
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  !sctn = !!ce

  !start = plstart NA wrt world
  !end   = plend NA wrt world
  !horiz = false
  -- Check Identified Section is Horizontal
  if (!start.up.nint() neq !end.up.nint()) then
    !horiz = false
  else
    !horiz = true
  endif

  -- Check Identified Sctn is 'Above' or 'Below' Trunnion and is Suitable for Trunnion
  !!ce  = !datum
  if (!support.padir eq U) then
    !ddir = !support.pldir
  elseif (!support.padir eq D) then
    !ddir = !support.padir
  endif

  !test = !!mdsreltodatum(!datum, !sctn, !ddir, 0)

  -- If 'ABOVE' or 'BELOW' is returned - it is OK to Proceed
  if (!test[1].upcase() eq 'BELOW') then
    if (!horiz.not()) then
      !!alert.error('Identified Structural Section is Unsuitable to Support from.')
      golabel /section
    endif
  elseif (!test[1].upcase() eq 'ABOVE') then
    if (!horiz.not()) then
      !!alert.error('Identified Structural Section is Unsuitable to Support from.')
      golabel /section
    endif
  else
    !horiz = false
    !!alert.error('Identified Structural Section is Unsuitable to Support from.')
    golabel /section
  endif

  --------------------------------------------------------------------------------
  -- Position Trunnion ONTOP or UNDER the Identified Steel Section
  !!ce  = !datum

  if (!support.pldir eq D) then
    if (!mode.upcase().eq('UNDER')) then
      pos p12 clear $!clear beh $!sctn
    elseif (!mode.upcase().eq('ONTOP')) then
      pos p9 clear $!clear inf $!sctn
    endif
  elseif (!support.pldir eq U) then
    if (!mode.upcase().eq('UNDER')) then
      pos p9 clear $!clear inf $!sctn
    elseif (!mode.upcase().eq('ONTOP')) then
      pos p12 clear $!clear beh $!sctn
    endif
  endif

  --------------------------------------------------------------------------------
  -- Set Despars to reflect the Values in the Form gadgets '.length', '.plate' and  '.clear'
  var !insu insulation
  !hPOD = pl od / 2
  !half = !hPOD + !insu.real()

  !desp4 = !form.length.val
  !desp1 = !desp4 + !half
  !desp2 = !form.plate.val
  !desp3 = !form.clear.val
  !desp5 = !half

  despar $!desp1 $!desp2 $!desp3 $!desp4 $!desp5

  prompt dismiss

  -- Move Marker Text
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
  -- Set distance gadget on form
  call !!mdsDistance(!form)

  -- Set the position member, this may the first time it been positioned

  !form.support.position = true

  -- Reset Project Units
  !!kRestoreUnits(!currentUnits)

endfunction
