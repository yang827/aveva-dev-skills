--
-- File: Mdspostruntt34.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Tony Martin
-- Created: Monday 10th March 2003
--
--
-- Description:
-- Function to Position a Trunnion atta component ONTO a Steel Section
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--     2     R         STRING       ONTOP - Position Trunnion ABOVE Identified Section
--                             or   UNDER - Position Trunnion BELOW Identified Section
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsPosTrunTT34(!form is FORM,!mode is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !support   = !form.support
  !datum     = !support.datum

  if !mode.eq('SECT') then
    label /section
    prompt off
    prompt load escape 'Identify steelwork to set trunnion to'
    --<wd>16jan2008 -- Defect No. P-4407
    --    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE @
    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE HSTIFF HPLATE@
    --<wd>16jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return FALSE
    endhandle
    prompt on
    !horiz = TRUE
    !sctn = !!ce
    if !!ce.type eq 'SCTN' then
      !start = plstart NA wrt world
      !end   = plend NA wrt world
      !horiz = FALSE
      -- Check Identified Section is Horizontal
      if (!start.up.nint() neq !end.up.nint()) then
        !horiz = FALSE
      else
        !horiz = TRUE
      endif
    endif
    -- Check Identified Sctn is 'Above' or 'Below' Trunnion and is Suitable for Trunnion
    !!ce  = !datum
    !ddir = d
    !test = !!mdsreltodatum(!datum, !sctn, !ddir, 0)

    -- If 'BELOW' is returned - it is OK to Proceed
    if (!test[1].upcase() eq 'BELOW') then
      if (!horiz.not()) then
        !!alert.error('Identified Structural Section is Unsuitable to Support from.')
        golabel /section
      endif
    elseif (!test[1].upcase() eq 'ABOVE') then
      if (!horiz.not()) then
        !!alert.error('Identified Structural Section is Unsuitable to Support from.')
        golabel /section
      else
        !!ce = !datum
        pin 6 at $!datum
        pin 5 at pl of bend 1
        pin 6 dir d
        if defined(!test[2]) then
          pin 6 $!test[2]
        else
          pin 6 clear 0 inf $!sctn
        endif
        var !u1 pin6 u
        var !u2 pin5 u
        if !u1.real() gt !u2.real() then
          !!alert.error('Identified Structural Section is too high to Support from.')
          return
        endif
      endif
    else
      !horiz = FALSE
      !!alert.error('Identified Structural Section is Unsuitable to Support from.')
      golabel /section
    endif

    --------------------------------------------------------------------------------
    -- Position Trunnion ONTOP or UNDER the Identified Steel Section
    !!ce  = !datum
    if defined(!test[2]) then
      pos pl $!test[2]
    else
      pos pl clear 0 inf $!sctn
    endif
    -- calculate the length and reset it
    !bend = prev bend
    !len = !!ce.position.distance(!bend.position)
    !bore     = !!ce.lbor
    !suppType = !!ce.stype

    -- Check if the selected MAIN PIPE Bore Size and TRUNNION TYPE etc... is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!parVar   = '!!mdsParTT34'
    --!max = $!parVar[$!bore].maximum
    --!min = $!parVar[$!bore].minimum
    --
    -- CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore Size, i.e the PH BORE of the TRUNNION
    !mBore  = !!ce.owner.phbore.real().value()
    !mdsStd = !support.type
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif
      !!kRestoreUnits(!currentUnits)
      !!alert.error(!errormessage)
      return

    else
      -- TRUNNION DATA is OK and ACTIVE in the PARAGON MDS DEFAULTS CATALOGUE
      !min = !mdsTrunObj.minlength
      !max = !mdsTrunObj.maxlength

    endif
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    if !len lt !min then
      !!alert.error('length is less than minimum allowed - Reset to minimum')
      pos pl dist $!min from prev bend
      !len = !min
    elseif !len gt !max then
      !!alert.error('length is greater than maximum allowed - Reset to maximum')
      pos pl dist $!max from prev bend
      !len = !max
    endif

    !form.tHeight.val = !len

    prompt dismiss

    bran conn pt to last mem

  else $* mode is not SECT so rebuild the trunnion to suit

    -- check the :MDSSREF to see if it needs repositioning
    !sref = !form.support.datum.name & '/SREF'
    !!ce = !sref.dbref()
    handle ANY
      !!alert.error('Cannot find SREF ATTA - Support incorrectly defined')
      return
    endhandle

    --!sleeve = !!ce.:MDSSREF

    if !mode eq 'DIST' then
      --!!ce = !sleeve
      goto href of owne
      dist $!form.dist
    elseif !mode eq 'THRO' then
      --!!ce = !sleeve
      goto href of owne
      !selection = !form.select.selection('Rtext')

      if (!selection eq |NAME|)then
        var !nameOfRef (SUBSTRING(|$_CDNNAME_NAME|,1,1))
        if (!nameOfRef eq |=|)then
          DRAG MOVE THRO $_CDNNAME_NAME
        else
          DRAG MOVE THRO $_CDNNAME_NAME
          handle (2,109)
            DRAG MOVE THRO /$_CDNNAME_NAME
          endhandle
        endif

      elseif (!selection eq |COORD|)then
        DRAG MOVE THRO $!form.p.val

      elseif (!selection eq |PIN|)then
        DRAG MOVE THRO PIN $!form.p.val

      elseif (!selection eq |PLANE|)then
        if (!form.p.val eq '')then
          !!alert.error('Create Plane first')
          return
        endif
        if (match(!form.p.val, 'CURSOR') gt 0)then
          --!direction = before(!form.p.val, ' THRO')
          DRAG MOVE THRO @
        else
          DRAG MOVE $!form.p.val
        endif

      elseif (!selection eq |CUR|)then
        DRAG MOVE THRO @
        handle (61,528)
          return
        endhandle

      elseif (!selection eq |IDCUR|)then
        DRAG MOVE THRO ID@
        handle (61,528)
          return
        endhandle

      elseif (!selection eq |IDP|)then
        DRAG MOVE THRO IDP@
        handle (61,528)
          return
        endhandle

      elseif (!selection eq |NEXT|)then
        DRAG MOVE THRO NEXT
        handle (41,66) (2,113) (2,113)
          if (!mode eq |Forwards|)then
            DRAG MOVE THRO PT
          else
            DRAG MOVE THRO PH
          endif
        endhandle

      elseif (!selection eq |TAIL|)then
        DRAG MOVE THRO PT

      elseif (!selection eq |PREV|)then
        DRAG MOVE THRO PREV
        handle (41,66) (2,113) (2,113)
          if (!mode eq |Forwards|)then
            DRAG MOVE THRO PH
          else
            DRAG MOVE THRO PT
          endif
        endhandle

      elseif (!selection eq |HEAD|)then
        DRAG MOVE THRO PH

      elseif (!selection eq |CE|)then
        !origin  = !!ce
        DRAG MOVE THRO $!origin

      elseif (!selection eq |PLINE START|)then
        DRAG MOVE THRO IDPLINE @ START
        handle (61,528)
          return
        endhandle

      elseif (!selection eq |PLINE END|)then
        DRAG MOVE THRO IDPLINE @ END
        handle (61,528)
          return
        endhandle

      elseif (!selection eq |BMA|)then
        var !pick PICK PLINE WITH (PURP eq 'B')
        handle (61,528)
          return
        endhandle
        DRAG MOVE thro $!pick[1] start
      endif
      -- Set form data to say that the support has been positioned
      !form.support.position = TRUE
    elseif !mode eq 'DIR' then
      --!!ce = !sleeve
    endif

    -- we have dealt with the repositioning of the main atta,
    -- so now we need to rebuild the trunnion
    !!ce = !form.support.datum
    bran
    goto href
    ori and p3 is $!form.direction
    goto cref
    conn ph to href
    /$!!mdsTT34.name.val/NOTE1
    conn

    /$!!mdsTT34.name.val$n.1
    conn
    ori p41 is u and p1 is $!form.direction
    !clamp = !!ce

    /$!!mdsTT34.name.val/MAKEUP

    !tOd = pl od
    !od = pa od

    -- Work out the adjustment needed for the exact length to be added to the iso
    -- and put in gadget
    !hyp = (!od / 2)
    !side1 = (!tOd / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

    despar $!!mdsTT34.bore $!offset  0mm
    -- spkbrk true
    connect and p3 is d
    -- atty CCNN

    -- now do the makeup piece
    /$!!mdsTT34.name.val/SREF
    connect
    shop TRUE

    !bore = pa bore
    handle ANY
      !bore = pa bore of prev
    endhandle

    --!stype = !!mdsParTT34[$!bore].stypes[!!mdsTT34.bore.val]
    --!splitStype = !stype.split(',')

    -- now do the bend
    --Check the clearance is not out of limits
    !bend = bend1

    !bore     = !!ce.lbor
    !suppType = !!ce.stype
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!parVar   = '!!mdsParTT34'
    --!dpNum    = !!mdsGetDesp('CLEA') $* this does not work ???
    --!minClear      = $!parVar[$!bore].userdps[4].min
    --!maxClear      = $!parVar[$!bore].userdps[4].max
    --
    -- CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore Size, i.e the PH BORE of the TRUNNION
    !mBore  = !!ce.owner.phbore.real().value()
    !mdsStd = !support.type
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif
      !!kRestoreUnits(!currentUnits)
      !!alert.error(!errormessage)
      return

    else
      -- TRUNNION DATA is OK and ACTIVE in the PARAGON MDS DEFAULTS CATALOGUE
      !min      = !mdsTrunObj.minlength
      !max      = !mdsTrunObj.maxlength
      !minClear = !mdsTrunObj.userdps[4].min
      !maxClear = !mdsTrunObj.userdps[4].max

    endif
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    if !form.clear.val lt !minClear then
      !!alert.error('Clearance is less than minimum allowed - Reset to minimum')
      !form.clear.val = !minClear
    elseif !form.clear.val gt !maxClear then
      !!alert.error('Clearance is greater than maximum allowed - Reset to maximum')
      !form.clear.val = !maxClear
    endif

    !!ce = !bend
    conn and pl is d
    --Calculate position from centre of clamp including the thickness of the pad
    !clear = !clamp.para[2] / 2 + !clamp.prop.pthk.real() + !form.clear.val
    clear $!clear from $!clamp

    -- now do the Plate
    !!ce = !form.support.datum
    conn
    !!mdsSetDesPars(!!ce)

    !!mdsDacControl(TRUE)
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    -- Now using the <mds12> !mdsTrunObj TRUNNION Object variable
    --!parVar   = '!!mdsParTT34'
    --if !!mdsTT34.tHeight.val lt $!parVar[$!bore].minimum then
    if (!!mdsTT34.tHeight.val lt !min ) then
      !!alert.error('length is less than minimum allowed - Reset to minimum')
      --!!mdsTT34.tHeight.val = $!parVar[$!bore].minimum
      !!mdsTT34.tHeight.val = $!min

      --elseif !!mdsTT34.tHeight.val gt $!parVar[$!bore].maximum then
    elseif (!!mdsTT34.tHeight.val gt !max ) then
      !!alert.error('length is greater than maximum allowed - Reset to maximum')
      --!!mdsTT34.tHeight.val = $!parVar[$!bore].maximum
      !!mdsTT34.tHeight.val = $!max

    endif
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !overallLength = !!mdsTT34.tHeight.val  + !!ce.prop.pthk.real()
    pos pl dist $!overallLength from prev bend
    bran
    conn pt to last mem
    TCON CLOS

    /$!!mdsTT34.name.val/NOTE2
    conn
    /$!!mdsTT34.name.val/NOTE3
    conn to nex

  endif
  ----------------

  !tbor = Tbor of bran
  /$!!mdsTT34.name.val/SREF
  !hBor = Hbor of bran
  despar $!hBor  $!tbor  $!!mdsTT34.tHeight.val $!!mdsTT34.clear.val

  -- Move Marker Text
  /$!!mdsTT34.name.val$n.1
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>

  !!ce=!datum
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>


  -- Set the position member, this may the first time it been positioned
  !form.support.position = TRUE

  -- Reset Project Units
  !!kRestoreUnits(!currentUnits)

endfunction
