--
-- File: Mdsposttrun.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue 28 Oct
--
--
-- Description:
-- function to position support (atta only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsPosTtrun(!form is FORM)

  -- Initialise variables
    !selection = !form.select.selection('Rtext')
    !datum     = !form.support.datum
    !origin = !!ce

  -- Check that Datum atta has been created
    if (!datum.set().not())then
      !!alert.message('Support atta has not been created')
      return
    endif

    !!ce = !datum
    bran
    goto href
    var !mode MODE
    PIN 9 AT CE
    PIN 9 OFF
    !!mdsDacControl(TRUE)

    if (!selection eq |NAME|)then
      var !nameOfRef (SUBSTRING(|$_CDNNAME_NAME|,1,1))
-- Check if position is within tube
-- Plane direction is nearest value to 1
      !ceComp = !!ce
      !idComp = $_CDNNAME_NAME
      !plDir  = PL DIR of $!!ce wrt /*
      !up = (abs(!plDir.up))
      !east = (abs(!plDir.east))
      !north = (abs(!plDir.north))
      !max = max((abs(!up)), (abs(!east)), (abs(!north)))
      if (!max eq !up)then
        !planeDir = U wrt /*
      elseif (!max eq !east)then
        !planeDir = E wrt /*
      else
        !planeDir = N wrt /*
      endif

      if (!!mdsCheckThro(!form, !ceComp, !idComp, !planeDir).not()) then
        !!ce = !datum
        branch
        goto href
        var !dist const dist p0 to p0 of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !form.dist.val = $!dist
        !!mdsDacControl(FALSE)
        return
      endif

      if (!nameOfRef eq |=|)then
        DRAG MOVE THRO $_CDNNAME_NAME
      else
        DRAG MOVE THRO $_CDNNAME_NAME
          handle (2,109)
            DRAG MOVE THRO /$_CDNNAME_NAME
          endhandle
      endif

      !!mdsResetPins(8,9)

    elseif (!selection eq |COORD|)then

      !!alert.error('Functionality not available for trunnion positioning')
      return

      DRAG MOVE THRO $!form.p.val

    elseif (!selection eq |PIN|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO PIN $!form.p.val

    elseif (!selection eq |PLANE|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       if (!form.p.val eq '')then
         !!mdsDacControl(FALSE)
         !!alert.error('Create Plane first')
         return
       endif
       if (match(!form.p.val, 'CURSOR') gt 0)then
         --!direction = before(!form.p.val, ' THRO')
         DRAG MOVE THRO @
       else
         DRAG MOVE $!form.p.val
       endif

    elseif (!selection eq |CUR|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO @
       handle (61,528)
          !!mdsDacControl(FALSE)
          return
       endhandle

    elseif (!selection eq |IDCUR|)then

-- Check if position is within tube
-- Plane direction is nearest value to 1
      !ceComp = !!ce
      id @
      !idComp = !!ce
      same
      !plDir  = PL DIR of $!!ce wrt /*
      !up = (abs(!plDir.up))
      !east = (abs(!plDir.east))
      !north = (abs(!plDir.north))
      !max = max((abs(!up)), (abs(!east)), (abs(!north)))
      if (!max eq !up)then
        !planeDir = U wrt /*
      elseif (!max eq !east)then
        !planeDir = E wrt /*
      else
        !planeDir = N wrt /*
      endif

      if (!!mdsCheckThro(!form, !ceComp, !idComp, !planeDir).not()) then
        !!ce = !datum
        branch
        goto href
        var !dist const dist p0 to p0 of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !form.dist.val = $!dist
        !!mdsDacControl(FALSE)
        return
      endif

      DRAG MOVE THRO $!idComp
        handle (61,528)
          !!mdsDacControl(FALSE)
          return
        endhandle

      !!mdsResetPins(8,9)

    elseif (!selection eq |IDP|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO IDP@
       handle (61,528)
          !!mdsDacControl(FALSE)
          return
       endhandle

    elseif (!selection eq |NEXT|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO NEXT
       handle (41,66) (2,113) (2,113)
          if (!mode eq |Forwards|)then
             DRAG MOVE THRO PT
          else
             DRAG MOVE THRO PH
          endif
       endhandle

    elseif (!selection eq |TAIL|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO PT

    elseif (!selection eq |PREV|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO PREV
       handle (41,66) (2,113) (2,113)
          if (!mode eq |Forwards|)then
             DRAG MOVE THRO PH
          else
             DRAG MOVE THRO PT
          endif
       endhandle

    elseif (!selection eq |HEAD|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO PH

    elseif (!selection eq |CE|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO $!origin

    elseif (!selection eq |PLINE START|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO IDPLINE @ START
         handle (61,528)
           !!mdsDacControl(FALSE)
           return
         endhandle

    elseif (!selection eq |PLINE END|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       DRAG MOVE THRO IDPLINE @ END
         handle (61,528)
           !!mdsDacControl(FALSE)
           return
         endhandle

    elseif (!selection eq |BMA|)then

       !!alert.error('Functionality not available for trunnion positioning')
       return

       var !pick PICK PLINE WITH (PURP eq 'B')
         handle (61,528)
           !!mdsDacControl(FALSE)
           return
         endhandle
       DRAG MOVE thro $!pick[1] start

    endif

  -- Set form data to say that the support has been positioned
    !form.support.position = true

    --var !pos POS WRT WORLD
    !ceOrig = !!ce
    !pos = !!ce.position.wrt(/* )
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
--------------------------------------------------------------------------------
      !!ce = !datum
      !pos = !!ce.position.wrt(/* )
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>
-- Add marker text markers
      !!ce = !datum
      !name = !datum.name
      do !count from 212 to 259
        var !num ($!count - 211)
        !attaname = !name & '.' & !num
        !!ce = !attaname.dbref()
        handle any
          break
        endhandle
        !pos = !!ce.position.wrt(/* )
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

      !!ce = !ceOrig
---------------------------------------------------------------------------------------

  -- Reset distance gadget
    !currentUnits = !!kGetSetUnits()
    units mm dist

    var !dist const dist p0 to p0 of prev
      handle any
        var !dist const dist p0 to ph
      endhandle

    !form.dist.val = !dist.real()
      handle any
      !form.dist.val = !dist.string(!!distanceFMT).real()
          handle any
        !form.dist.val = !dist
      endhandle
    endhandle

    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentunits)
    !!ce = !origin

endfunction
