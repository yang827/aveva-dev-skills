--
-- File:		Mdspushpin.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		A.Boudjnah
-- Created:		Wed Mar 13 2002
--
--
-- Description:
-- Saves the ppoint position, direction and status(On/Off)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Real         PPoint number to be saved
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdspushpin(!ppointNo is Real)
   if(not defined(!!pinsArray)) then
      !!pinsArray = ARRAY()
      do !I to 10
        !pinStack = ARRAY()
        !!pinsArray[!I] = !pinStack
      enddo
   endif
   var !pinPos pin$!ppointNo pos wrt /*
   var !pinDir pin$!ppointNo dir wrt /*
   !pinSave = '$!pinPos$n\$!pinDir'
   var !pin pin$!ppointNo
   if(!pin.upcase().match('ON') gt 0) then
      !pinSave = '$!pinSave$n\ON'
   else
      !pinSave = '$!pinSave$n\OFF'
   endif


   !pinStack = !!pinsArray[!ppointNo]
   !pinStack.append(!pinSave)
   !!pinsArray[!ppointNo] = !pinStack
-- End function
endfunction

-- End of file Mdspushpin.pml
