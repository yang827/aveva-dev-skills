--------------------------------------------------------------------------------
--
-- File:  Mdsrack.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MRACK
--
-- Author:  I.osborne
-- Created:  Tue May 06
--
--
-- Description:
-- Identify tube
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of form calling this function
--     2     R         STRING      Text to determine if the new atta being created
--                                 in this function is to be named e.g. 'NONAME'
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN     Return False if passed element is not of the correct type
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRack(!form is FORM, !text is STRING) is BOOLEAN

  !currentunits = !!kgetsetunits()

  -- Check to see if the type passed is the same as the purp of the spec
  -- of the item selected.
  --<wd>mar2003
  if !!ce.type.eq('CTRAY').or(!!ce.type.eq('CTSUPP')) then
    !trayType = 'CTRAY'
    !specPurp = 'TRAY'
  else
    !trayType = 'FTUB'
    !specPurp = purp of spec of spref
    handle any
      !specPurp = purp of spec of pspe of bran
    endhandle
  endif
  --<wd>mar2003

  if (!!ce.type.eq('ATTA')) then
    !specPurp = purp of spec of lstu
  endif

  if (!specPurp neq 'TRAY')then
    --!!alert.error('Support could not be selected as the element is not a RACK straight')
    !!alert.error('Support could not be selected as the element is not a RACK straight or does NOT belong to a RACK/TRAY specification')
    !!kRestoreUnits(!currentunits)
    return false
  endif

  ---------------------------------------------------------
  if (!!ce.type.eq('FTUB')) then

    !current = !!ce
    goto catref
    cata
    !cataName = !!ce.name
    !!ce = !current

    if !cataName.match('VANTRUNK').gt(0) or !cataName.match('OGLAEND').gt(0) then
      !rack = !!ce
      new atta /tempRackRest
      desp 0 0
      sel spref with styp 'RACK-REST' spec /MDS
      fconn
      pin 8 copy p10
      pin 9 copy p11
      /tempRackRest
      delete atta
      !!ce = !rack
      pin 9 clear 0 behind ce
      pin 8 clear 0 behind ce
      !width = !!kStrReal('Const dist pin 9 to pin 8')
      !height = 0
    else
      !paras = !!ce.catref.para
      !ppointlist = ppls
      if !ppointlist.find(83).size() gt 0 then
        !width = !!ce.ppos[83].distance(!!ce.ppos[84])
      else
        !width = !!ce.ppos[3].distance(!!ce.ppos[4])
        handle (2,201)
          --<RM> P-35784 04/03/2011 added this handle block to correctly set width if the tray has no P3 or p4 ppoint
          !width = '0'
        endhandle
        if (!width.real().lt(!paras[1])) then
          !width = !paras[1]
        endif
      endif
      --<wd>-12jul2002
      --    var !height const dist p2 to p31
      var !sheight const dist p2 to plane p31
      !height = !sheight.real()
      --<wd>-12jul2002
    endif
  endif
  ---------------------------------------------------------
  !currcomp = !!ce

  --<wd>oct2004
  -- Set these variables BEFORE the support ATTA is created
  if (!currcomp.type.neq('FTUB')) then
    if (!currcomp.type.eq('BRAN')) then
      head
      !hdir = hdir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
    endif
  endif
  --<wd>oct2004
  -- ge 25/01/04 fix for HPD0027825 raise access
  !!mdsDacControl(true)

  --create the cable tray atta
  !!mdsCreateAtta('RACK-REST',/MDS )
  SPKBRK true
  handle ANY
  endhandle

  if !!ce.typ.eq('CTSUPP') then
    !width = !!ce.own.own.trayw
    !height = 0
    despar n1 $!width
    despar n2 $!height
  else
    desp 20mm 10mm
  endif
  Stext '$!form.name'
  !xat = !!ce
  --<tm>09/07/2005 13:54
  if !trayType.eq('CTRAY') then
    connect p2 to p1 of owner
  else
    ori
  endif
  --<tm> fix to stop zero tube length messages when two attas are together

  !order = order
  if !trayType.eq('FTUB') then
    if (!order.eq(1)) then
      dist 10
    else
      dist 10 from pl of prev
    endif
  endif

  if (!currcomp.type.neq('FTUB') and (!trayType.eq('FTUB'))) then

    --<wd>oct2004
    if (!currcomp.type.eq('BRAN')) then
      head
      !!ce = !xat
      ori $!ori
      --<wd>oct2004

    else
      !!ce  = !currcomp
      !hdir = ldir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce = !xat
      ori $!ori
    endif
    !!ce = !currcomp
    !xce = !currcomp
    !height = 0
    !width  = !!mdstraywidth(!xat, !xce, !height)
  endif

  --<RM> P-36133 12/08/2011 set the atta despars. if these are not set then the create by clearance option will not work for cable trays - start
  DESPAR $!width $!height
  --<RM> P-36133 12/08/2011 set the atta despars. if these are not set then the create by clearance option will not work for cable trays - end

  if !trayType.eq('FTUB') then
    FCONN
    PLANE PL THRO /$!form.name
    handle any
      PLANE PL THRO $!form.name
    endhandle

    !order = order
    if (!order EQ 1) then
      BRAN
      !tube = !!ce.hstu
      SAME
    else
      PREV
      !tube = !!ce.lstu
      NEXT
    endif

    if (!tube.badref().not()) then
      LSTU $!tube
    else
      !!mdsSelLstu(!!ce)
    endif
  else
    move p2 PLANE p2 thro /$!form.name
    handle any
      move p2 PLANE p2 thro $!form.name
    endhandle
  endif

  !name = !form.name

  if (!text.upcase() neq |NONAME|) then
    do !count from 1
      NAME $!<name>.$!count
      handle (41,12)
        skip
      elsehandle (47,15)
        NAME /$!<name>.$!count
        handle (41,12)
          skip
        endhandle
      endhandle
      -- Add atta to Form Member atta
      !newAtta = !!ce
      !form.support.atta.append(!newAtta)
      break
    enddo

    -- Always add atta to datum cross bar
    if (!form.support.bars.empty())then
      !form.support.bars[1][1] = !newAtta
    else
      !form.support.bars[1].append(!newAtta)
    endif

  endif

  !!kRestoreUnits(!currentunits)
  return true

endfunction
