--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue 5 MAy
--
--
-- Description:
-- Reads Defaults file for MDS and populates a global variable with
-- the support description. This is used by Isorun to display the support
-- description in the material list.
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadAltd()

-- Read default file to load alternative support code descriptions

-- Open File and read defaults

  OPENFILE /$!!MDSFILES.ALTD READ !READ
  handle any
    !!Alert.error('File $!!MDSFILES.ALTD could not be found in the project defaults directory')
    return !ABORT
  endhandle

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    if (match(!Record,|#|) eq 1)then
      skip
    endif

    if (!Record eq ||)then
      skip
    endif

-- Create global variable for each support code

    !Records = split(!Record,'\')

-- Remove any hyphens from support code

    !StripOfHyphens = !Records[1].replace('-','')

    !AltdVar = '!!MdsALTD' + !StripOfHyphens

    $!<AltdVar> = !Records[2]

  enddo

-- End function

endfunction

-- End of file Mdsreadaltd.pml
