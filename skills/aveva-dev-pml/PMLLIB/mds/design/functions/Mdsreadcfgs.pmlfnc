--
-- File:		Mdsreadcfgs.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Tue 9th Dec
--
--
-- Description:
-- Reads hanger configuration defaults file for MDS and build array of objects for
-- each hanger type (HT01,HT02...)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadcfgs(!Prompt is STRING)

  !currentunits = !!kgetsetunits()

--xxx  PROMPT '$!Prompt'

  -- !!MdsCFGINDX contains array of all configs loaded and is
  -- used to search for required support type. The position in the
  -- index array of the selected support type corresponds to
  -- the index in the config array (!!MdsCFGS) containing the configuration
  -- details for each support type... hope this helps...!

  -- delete old globals
    var !!MdsCFGINDX delete
    handle (2,751)
    endhandle
    var !!MdsCFGS delete
    handle (2,751)
    endhandle

  -- Initialise variables
  !ConfigObj = object MdsConfig()
  !Records = ARRAY()
  !PrintError = True
  !!MdsCFGINDX = ARRAY()
  !!MdsCFGS = ARRAY()
  !BTrim = object BLOCK(|!Details[!Evalindex].Trim().Upcase().Replace('!STYPE',!Stype)|)

  -- Open File and read all lines for processing
  OPENFILE /$!!MDSFILES.CONFIG READ !READ
  handle any
    !!Alert.error('File $!!MDSFILES.CONFIG could not be found in the project defaults directory')
    !!kRestoreUnits(!currentunits)
    return !ABORT
  endhandle

  !LCount = 0
  do !LineNumber

    !LCount = !LCount + 1
    READFILE $!Read !Record
    handle (41,325)
      CLOSEFILE $!Read
      break
    elsehandle none
      !Records.Append(!Record)
    endhandle
  enddo

  !ProcChars = '__________________________________________________'
  !PaddChars = '                                                  '
  !Index = 0
  !LPComp = 0

  do !Record values !Records

    -- processing complete stats
    !Index = !Index + 1
    !AComp = nint(!Index / !LCount * 100)
    !PComp = nint(!Index / !LCount * 25)
    !PRem  = 25 - !PComp + 1
    if (!AComp lt 10) then
      !PRem = !Prem + 1
    endif
    !CBar  = subs(!ProcChars,1,!PComp)
    !UBar  = subs(!ProcChars,1,!PRem)

    --if (!LPComp neq !PComp) then
    --  Prompt '$!Prompt  0$!CBar$n$!AComp%$!UBar$n100'
    --  !LPComp = !PComp
    --endif

    if (match(!Record,|#|) eq 1)then
      skip
    endif

    if (!Record eq ||)then
      skip
    endif

    !Field   = !Record.split()

    if (!Field[1].trim().upcase() eq 'CONFIG') then

      -- restore print error flag
      !PrintError = True

      -- get Config description
      !Config = !Record.after('CONFIG').trim().before(' ')
      !Desc   = !Record.after(!Config).Trim()

    elseif (!Field[1].trim().upcase() eq 'NOTE') then

      -- get erection note text
      !Erection = !Record.after('NOTE').trim()

    else

      -- we must be at a config description record, check we've already read the CONFIG description record
      if (undefined(!Config) and !PrintError) then
        !!Alert.Error('Config Type "$!Config" not defined correctly in $!!MDSFILES.CONFIG - No CONFIG record found')
        !PrintError = False
        skip
      elseif (undefined(!Config) and !PrintError.Not()) then
        skip
      endif

      -- get Config details
      !Stype     = !Record.before('\').trim()
      !Suptype   = !Record.after('\').trim().Before('\').Trim()
      !Details   = !Record.after(!SupType).trim().After('\').Trim().Split('\')

      -- populate the config object and replace any occurrences of !STYPE with actual STYPE
      !ConfigObj.Description = !Desc.Replace('!STYPE',!Stype)
      !ConfigObj.Type = !SupType.Replace('!STYPE',!Stype)
      !ConfigObj.Ancill = !Details.Evaluate(!BTrim)
      !ConfigObj.Erection = !Erection.Replace('!STYPE',!Stype)

      -- append to the index and config arrays
      !!MdsCFGINDX.Append(!SType)
      !!MdsCFGS.Append(!ConfigObj)

    endif

  enddo

  !!kRestoreUnits(!currentunits)

Prompt Dismiss

-- End function
endfunction

-- End of file Mdsreadcfgs.pml
