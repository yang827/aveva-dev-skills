--
-- File:		Mdsreadcode.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 13th November 2001
--
--
-- Description:
-- Reads Defaults file for MDS and populates a global variable with
-- the  MDS STD support Clients CODE. This is used by DESIGN and Isorun to display
-- the support code.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadCode()

-- Read default file to load descriptions
-- Open File and read defaults

  OPENFILE /$!!MDSFILES.DESCRIPTION READ !READ
    handle any
      OPENFILE $!!MDSFILES.DESCRIPTION READ !READ
        handle any
          !!Alert.error('File $!!MDSFILES.DESCRIPTION could not be found in the project defaults directory')
          return !ABORT
        endhandle
    endhandle

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    if (match(!Record,|#|) eq 1)then
      skip
    endif

    if (!Record eq ||)then
      skip
    endif

-- Find all supports except for the application defaults starting with
-- MDS

    !Records = split(!Record,'\')

    if (match(!Records[1].upcase().Trim(),|MDS|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST-INLINE|) eq 1) then
      !!CODEPIPERESTINLINE = !records[2].trim()
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST|) eq 1) then
      !!CODEPIPEREST = !records[2].trim()
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST-INLINE|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|RACK-REST|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|HVAC-REST|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|SPECIAL|) eq 1) then
      skip
    else
      !desc = '!!CODE' + !Records[1].trim()
      $!Desc = !records[2].trim()
    endif

  enddo

-- End function
endfunction

-- End of file Mdsreadcode.pmlfnc
